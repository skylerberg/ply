import std.pkg (Workspace)

// Where this repository keeps each of its packages and each part of `ply`: what `ply bootstrap`
// builds from, and what `ply work` prints for scripts.
fn workspace() -> Workspace = {
  packages: [
    "packages/proof",
    "packages/sim",
    "packages/store",
    "packages/testing",
    "packages/registry",
  ],
  suites: [
    { dir: "examples", proved: true },
    { dir: "tests/lang", proved: false },
    { dir: "tests/programs", proved: false },
  ],
  fixtures: ["tests/fixtures", "crates/ply-compiled-tests/tests"],
  toolchain: Some({
    std: "packages/std",
    std_tests: "tests/std",
    compiler: "packages/compiler",
    cli: "packages/cli",
    entry: "ply.main",
    cli_tests: "tests/cli",
    runtime: "ply-runtime",
  }),
}
