import std.pkg (Workspace)

// Where this repository keeps each of its packages and each part of `ply`: what `ply bootstrap`
// builds from, and what `ply work` prints for scripts.
fn workspace() -> Workspace = {
  packages: [
    "crates/ply-prove/ply",
    "crates/ply-sim/ply",
    "crates/ply-store/ply",
    "crates/ply-test/ply",
    "crates/ply-registry/ply",
  ],
  suites: [{ dir: "examples", proved: true }, { dir: "tests/lang", proved: false }],
  fixtures: ["tests/fixtures", "crates/ply-codegen-tests/tests"],
  toolchain: Some({
    std: "crates/ply-std/ply",
    std_tests: "crates/ply-std-tests/ply",
    compiler: "crates/ply-compiler/ply",
    cli: "crates/ply-cli/ply",
    entry: "ply.main",
    cli_tests: "crates/ply-cli-tests/ply",
    runtime: "ply-native",
  }),
}
