# Unanchored, so it also catches a nested `target/`: a workspace outside the root
# is a separate cargo project outside the workspace, and an anchored `/target`
# put 387MB of its build output into the history in 2dd1d9b.
target/
/.claude/worktrees
.ply-cache/
# The corpus and its checks build against the checkout's own packages, so they keep no lock.
crates/ply-corpus/*/ply.lock

# Python bytecode from running the benches by hand.
__pycache__/
*.pyc
