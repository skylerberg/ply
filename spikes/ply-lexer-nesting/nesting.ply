// Does "build the growing container in the last sub-expression of its enclosing
// node" survive a call boundary?
//
// `spikes/ply-lexer/GAPS.md` §1 and `spikes/ply-lexer-rc/fieldorder.ply` both
// measure the rule inside one node — one record literal, one argument list. A
// recursive-descent parser is nothing but nesting, so the question that decides
// whether the rule is followable there is whether a callee written correctly
// stays fast when the *caller* puts the call in a non-final position.
//
// `node` below is the fast spelling by the stated rule: the `push` is the last
// sub-expression of its record literal. The three steps differ only in where the
// call to `node` sits in the caller.

type S = { pos: Int, toks: List<Int> }

fn empty() -> S = {pos: 0, toks: []}

fn node(s: S, i: Int) -> S = { pos: i, toks: push(s.toks, i) }

fn keep(a: S, b: Int) -> S = a

fn keep_snd(b: Int, a: S) -> S = a

// The call is the whole body; nothing follows it.
fn tail_step(s: S, i: Int) -> S = node(s, i)

// The same call, as argument 0 of 2, followed by a variable read.
fn first_step(s: S, i: Int) -> S = keep(node(s, i), i)

// The same call, as argument 0 of 2, followed by a constant. `carry` is
// `if remaining { env.clone() }` and does not ask what the remaining
// sub-expression reads, so this must behave like `first_step` and not like
// `tail_step`. Included because it is the sharpest falsifiable prediction the
// stated mechanism makes.
fn first_const_step(s: S, i: Int) -> S = keep(node(s, i), 0)

// The same call, as argument 1 of 2.
fn last_step(s: S, i: Int) -> S = keep_snd(i, node(s, i))

pub fn tail(n: Int) -> Int = len(fold(range(0, n), empty(), tail_step).toks)

pub fn first(n: Int) -> Int = len(fold(range(0, n), empty(), first_step).toks)

pub fn firstc(n: Int) -> Int = len(fold(range(0, n), empty(), first_const_step).toks)

pub fn last(n: Int) -> Int = len(fold(range(0, n), empty(), last_step).toks)

// --- What the shape costs, as a function of how the pushes are grouped -------
//
// The copy `push` falls back to is O(the list's current length), so `k` pushes
// into one list cost O(k^2) and `k` pushes spread over `k/m` lists of `m` cost
// O(k*m). A lexer accumulates ONE list of every token in the file; a parser
// accumulates many short ones — a block's statements, a call's arguments — plus
// whatever is module-wide. These two run the same number of pushes, all of them
// in the non-final position that cannot be written around, and differ only in
// how they are grouped.

fn keepl(a: List<Int>, b: Int) -> List<Int> = a

fn push_step(acc: List<Int>, i: Int) -> List<Int> = keepl(push(acc, i), i)

fn one_list(m: Int) -> Int = len(fold(range(0, m), [], push_step))

// `k` pushes into a single list.
pub fn grouped_one(k: Int) -> Int = one_list(k)

// `k` pushes, into lists of 10.
pub fn grouped_ten(k: Int) -> Int =
  fold(range(0, k / 10), 0, |a: Int, i: Int| a + one_list(10))

test "the two groupings run the same number of pushes" {
  assert_eq(grouped_one(1000), 1000);
  assert_eq(grouped_ten(1000), 1000)
}

test "all four nestings compute the same answer" {
  assert_eq(tail(400), 400);
  assert_eq(first(400), 400);
  assert_eq(firstc(400), 400);
  assert_eq(last(400), 400)
}
