import lexer (Token, lex)

// A line of real Ply, repeated. `bytes_concat_all` is one allocation over the
// whole list; folding `bytes_concat` would be quadratic in the size built.
fn line() -> Bytes = b"pub fn add(a: Int, b: Int) -> Int = a + b // sum\ntest \"x\" { assert_eq(add(1, 2), 3) }\n"

fn source(reps: Int) -> Bytes = bytes_concat_all(map(range(0, reps), |i: Int| line()))

// How many copies of `line()` to lex. `bench.sh` rewrites this one number in a
// temporary copy; the file as checked in compiles and runs as it stands.
fn reps() -> Int = 256

// Packed so one `ply run --json` reports both: bytes * 1e6 + tokens.
fn main() -> Int = {
  let src = source(reps());
  bytes_len(src) * 1000000 + len(lex(src))
}
