// A lexer for Ply, written in Ply. The vehicle for the self-hosting spike:
// what the language costs to write a front end in, measured rather than
// guessed. Every shape here that looks strange is load-bearing and the comment
// beside it says which language limit chose it.

// --- Tokens -----------------------------------------------------------------

pub type Kind =
  | Ident
  | Keyword
  | Number
  | Str
  | ByteStr
  | Punct
  | Comment
  | Unknown

// Half-open byte offsets into the source rather than the text itself. A token
// holding its own `Bytes` would copy the slice per token; offsets keep the
// whole lex at one allocation for the source and none per token.
pub type Token = { kind: Kind, start: Int, end: Int }

// --- Byte classes -----------------------------------------------------------
//
// Nullary and pure, so the machine memoizes each to a constant and the
// `bytes_of_string` behind `b"..."` runs once per program rather than once per
// token.

fn ws() -> Bytes = b" \t\r\n"

fn digits() -> Bytes = b"0123456789_"

fn ident_chars() -> Bytes =
  b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

fn ident_start() -> Bytes =
  b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"

fn punct1() -> Bytes = b"(){}[],;:.=<>+-*/%!|&?@"

fn string_stops() -> Bytes = b"\"\\"

fn newline() -> Bytes = b"\n"

// --- Bounds-safe primitives -------------------------------------------------
//
// Copied from `std.json`, which needed exactly these three for exactly this
// reason: `bytes_at` off the end is a runtime error, and a lexer runs off the
// end of every buffer it finishes.

fn at(src: Bytes, i: Int) -> Int =
  if i < 0 || i >= bytes_len(src) { -1 } else { bytes_at(src, i) }

fn scan(src: Bytes, i: Int, set: Bytes) -> Int =
  if i >= bytes_len(src) { bytes_len(src) } else { bytes_scan(src, i, set, bytes_len(src)) }

fn scan_until(src: Bytes, i: Int, set: Bytes) -> Int =
  if i >= bytes_len(src) { bytes_len(src) } else { bytes_scan_until(src, i, set, bytes_len(src)) }

fn in_class(set: Bytes, c: Int) -> Bool =
  match bytes_index_of_byte(set, c) { Some(_) -> true, None -> false }

// --- Keywords ---------------------------------------------------------------

fn keyword_list() -> List<String> = [
  "pub", "fn", "type", "let", "if", "else", "match", "test", "handle", "with",
  "import", "effect", "resume", "perform", "true", "false", "read", "write",
  "det", "nondet", "region", "simulate", "derive", "for", "spec", "assert",
]

fn keyword_entry(w: String) -> { key: String, value: Bool } = {key: w, value: true}

// A `Map` because Ply has no `Set`, so membership is a `Map<String, Bool>` and
// the `true` is noise every call site pays for.
fn keywords() -> Map<String, Bool> = map_of_entries(map(keyword_list(), keyword_entry))

fn is_keyword(w: Bytes) -> Bool = map_contains(keywords(), string_of_bytes_lossy(w))

// --- One token --------------------------------------------------------------

// `p` is the first byte of a token: the caller has already skipped trivia and
// checked that `p` is inside the buffer.
//
// The order of the tests is frequency order, as `std.json`'s `value` is: each
// comparison the dispatch skips is one the interpreter does not run per token.
fn token_at(src: Bytes, p: Int) -> Token = {
  let c = at(src, p);
  if c == 47 && at(src, p + 1) == 47 {
    {kind: Comment, start: p, end: scan_until(src, p, newline())}
  } else if c == 98 && at(src, p + 1) == 34 {
    {kind: ByteStr, start: p, end: string_end(src, p + 2)}
  } else if in_class(ident_start(), c) {
    ident_token(src, p)
  } else if c >= 48 && c <= 57 {
    {kind: Number, start: p, end: scan(src, p, digits())}
  } else if c == 34 {
    {kind: Str, start: p, end: string_end(src, p + 1)}
  } else {
    punct_token(src, p)
  }
}

fn ident_token(src: Bytes, p: Int) -> Token = {
  let e = scan(src, p, ident_chars());
  let k = if is_keyword(bytes_slice(src, p, e)) { Keyword } else { Ident };
  {kind: k, start: p, end: e}
}

// `i` is one past the opening quote. One native scan per escape rather than
// per byte, which is `std.json`'s `string_chunks` trick; the recursion runs
// once per backslash and so stays far under the nesting limit for any string a
// human writes.
fn string_end(src: Bytes, i: Int) -> Int = {
  let stop = scan_until(src, i, string_stops());
  if stop >= bytes_len(src) {
    bytes_len(src)
  } else if bytes_at(src, stop) == 34 {
    stop + 1
  } else {
    string_end(src, stop + 2)
  }
}

fn is_op2(b: Bytes) -> Bool =
  b == b"->" || b == b"=>" || b == b"==" || b == b"!=" || b == b"<=" ||
  b == b">=" || b == b"&&" || b == b"||" || b == b"++" || b == b"::" || b == b".."

fn punct_token(src: Bytes, p: Int) -> Token = {
  let two = if p + 2 <= bytes_len(src) { bytes_slice(src, p, p + 2) } else { b"" };
  if is_op2(two) {
    {kind: Punct, start: p, end: p + 2}
  } else if in_class(punct1(), at(src, p)) {
    {kind: Punct, start: p, end: p + 1}
  } else {
    {kind: Unknown, start: p, end: p + 1}
  }
}

// --- The loop ---------------------------------------------------------------
//
// Two language facts chose this shape.
//
// **1. Recursion cannot drive it.** The natural lexer is `go(src, pos, out)`
// calling itself until the buffer ends. Ply charges a tail call against the
// nesting budget deliberately (`cont.rs`: "eliding it for a tail call leaves a
// tail-recursive runaway unbounded"), so that loop is `E0502` after 10,000
// tokens and no CLI flag raises the cap. `fold` does not nest, so it is the
// only unbounded loop in the language; it visits a list, so the loop has to be
// driven by a `range` whose length is fixed before lexing starts. Every token
// consumes at least one byte, so `bytes_len(src)` steps always suffice. The
// steps that fall inside an already-scanned token cost 1.4us each and are 7%
// of the run — the price of having no `while`.
//
// **2. The output list must be the last field mentioning the state.** `fold`
// takes one accumulator and Ply has no tuples, so `pos` and the tokens travel
// in a record. `push(s.toks, t)` is rewritten in place only when that
// projection is the last use of `s`; otherwise the list is copied per step and
// the lexer is quadratic. See `../fieldorder.ply` for the measurement. This is
// why `emit` is written with `toks` last, and it is the only reason.
type Lex = { pos: Int, toks: List<Token> }

fn start() -> Lex = {pos: 0, toks: []}

fn step(src: Bytes, s: Lex, i: Int) -> Lex =
  if i < s.pos { s } else { advance(src, s) }

fn advance(src: Bytes, s: Lex) -> Lex = {
  let p = scan(src, s.pos, ws());
  if p >= bytes_len(src) {
    {pos: p, toks: s.toks}
  } else {
    emit(s, token_at(src, p))
  }
}

// `s.toks` last. Moving it before `pos` makes this function quadratic.
fn emit(s: Lex, t: Token) -> Lex = {pos: t.end, toks: push(s.toks, t)}

pub fn lex(src: Bytes) -> List<Token> =
  fold(range(0, bytes_len(src)), start(), |s: Lex, i: Int| step(src, s, i)).toks

pub fn lex_string(src: String) -> List<Token> = lex(bytes_of_string(src))

// --- Rendering, for tests ---------------------------------------------------

pub fn kind_name(k: Kind) -> String =
  match k {
    Ident -> "ident",
    Keyword -> "kw",
    Number -> "num",
    Str -> "str",
    ByteStr -> "bstr",
    Punct -> "punct",
    Comment -> "comment",
    Unknown -> "?",
  }

pub fn show(src: Bytes, t: Token) -> String =
  kind_name(t.kind) ++ "(" ++ string_of_bytes_lossy(bytes_slice(src, t.start, t.end)) ++ ")"

pub fn show_all(src: Bytes) -> List<String> = map(lex(src), |t: Token| show(src, t))

// --- Tests ------------------------------------------------------------------

test "a declaration lexes to keywords, identifiers and operators" {
  assert_eq(
    show_all(b"pub fn add(a: Int) -> Int = a"),
    ["kw(pub)", "kw(fn)", "ident(add)", "punct(()", "ident(a)", "punct(:)",
     "ident(Int)", "punct())", "punct(->)", "ident(Int)", "punct(=)", "ident(a)"],
  )
}

test "two-byte operators beat their one-byte prefixes" {
  assert_eq(
    show_all(b"a == b != c <= d >= e && f || g ++ h :: i .. j => k -> l"),
    ["ident(a)", "punct(==)", "ident(b)", "punct(!=)", "ident(c)", "punct(<=)",
     "ident(d)", "punct(>=)", "ident(e)", "punct(&&)", "ident(f)", "punct(||)",
     "ident(g)", "punct(++)", "ident(h)", "punct(::)", "ident(i)", "punct(..)",
     "ident(j)", "punct(=>)", "ident(k)", "punct(->)", "ident(l)"],
  )
}

test "a string literal keeps its escaped quotes and is one token" {
  assert_eq(show_all(b"\"a\\\"b\" x"), ["str(\"a\\\"b\")", "ident(x)"])
}

test "a byte literal is not the identifier `b` followed by a string" {
  assert_eq(show_all(b"b\"xy\" b c"), ["bstr(b\"xy\")", "ident(b)", "ident(c)"])
}

test "a comment runs to the end of its line and no further" {
  assert_eq(show_all(b"a // one\nb"), ["ident(a)", "comment(// one)", "ident(b)"])
}

test "a division is not the start of a comment" {
  assert_eq(show_all(b"a / b"), ["ident(a)", "punct(/)", "ident(b)"])
}

test "leading, trailing and interior whitespace produce no tokens" {
  assert_eq(show_all(b"  \n\t a \r\n  b  \n "), ["ident(a)", "ident(b)"])
}

test "an empty source lexes to no tokens" {
  assert_eq(show_all(b""), [])
}

test "a source that is only whitespace lexes to no tokens" {
  assert_eq(show_all(b"   \n\t  "), [])
}

test "an unterminated string ends at the buffer rather than running off it" {
  assert_eq(show_all(b"x \"abc"), ["ident(x)", "str(\"abc)"])
}

test "a byte that starts nothing is one Unknown token and the lex continues" {
  assert_eq(show_all(b"a ~ b"), ["ident(a)", "?(~)", "ident(b)"])
}

test "numbers and identifiers do not run together" {
  assert_eq(show_all(b"12 x1 1_000"), ["num(12)", "ident(x1)", "num(1_000)"])
}

// The property the `fold` driver rests on: every step consumes at least one
// byte, so `bytes_len(src)` steps always suffice and the last token's `end` is
// the length of the source it came from.
test "the token spans tile the source in order" {
  assert_eq(
    map(lex(b"fn f() = 1"), |t: Token| t.start),
    [0, 3, 4, 5, 7, 9],
  );
  assert_eq(
    map(lex(b"fn f() = 1"), |t: Token| t.end),
    [2, 4, 5, 6, 8, 10],
  )
}
