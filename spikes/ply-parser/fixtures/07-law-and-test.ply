// `law`, `law/host`, a guard, ground and bound forms, and `test/nondet`.
law "ground" { 1 == 1 }
law "bound" forall (a: Int, b: Int) { a + b == b + a }
law "guarded" forall (n: Int) where n > 0 { n * 2 > n }
law/host "worldly" forall (n: Int) { n == n }
test "plain" { 1 }
test/nondet "loose" { 2 }
