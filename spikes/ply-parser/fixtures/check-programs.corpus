Hand-written programs for the checker differential: the outcomes no program in the tree and no
input mined from the reference checker's tests reaches, each kept because a mutation in
`arm-infer.sh` is caught by it alone. Programs are separated by a line holding exactly `%%%`,
modules within one by a line holding exactly `%%`, and each module's first line is its dotted name.

%%%
m
effect log { write emit(Bytes) -> Unit }
fn quiet() -> Unit / {} = log.emit(b"x")
%%%
m
effect log { write emit(Bytes) -> Unit }
fn noisy(x: Int) -> Int / { log.write } = { log.emit(b"x"); x }
fn apply(f: (Int) -> Int) -> Int = f(1)
fn go() -> Int = apply(noisy)
%%%
m
fn f() -> Bool = { let g = |x| x + x; true }
%%%
m
effect log { write emit(Bytes) -> Unit }
fn say(b: Bytes) -> Unit / { log.write } = log.emit(b)
test "a test performs through a call" { say(b"x") }
test "a test performs directly" { log.emit(b"y") }
%%%
m
pub fn twice<a, b>(f: (a) -> b, x: a) -> b = f(x)
pub fn each<a | e>(f: (a) -> Unit / e, xs: List<a>) -> Unit / e = fold(xs, (), |acc: Unit, x: a| f(x))
%%%
m
pub fn show<a>(x: a) -> Int where derivable(eq, a) = 1
pub fn keyed<k, v>(m: Map<k, v>) -> Int where derivable(ord, k) = map_len(m)
fn used() -> Int = show(2) + keyed(map_new())
%%%
m
effect log { write emit(Bytes) -> Unit }
effect audit { write note(Bytes) -> Unit }
fn twice() -> Unit / { log.write, log.write } = log.emit(b"x")
fn both() -> Unit / { audit.write, log.write, audit.write } = { log.emit(b"x"); audit.note(b"y") }
