// Named arguments and default parameters (ADR 0029). Both are parse-time only
// in the reference too: `defaults::expand` runs inside `resolve`, two phases
// past anything this spike ports, so both sides carry them into the dump.
//
// The corpus mined from `crates/ply-syntax/src/tests.rs` contains zero of
// either — `GAPS.md` §11R.N measured that, and measured what it cost: with
// `App`'s keyword-argument list undumped, `g(1, b: 2)`, `g(1, c: 2)` and
// `g(1, b: h(2))` all produced byte-identical dumps. This file is what stops
// that being true again without anything going red.
fn greet(name: String, greeting: String = "hello", mark: String = "!") -> String =
  string_concat(greeting, string_concat(name, mark))

fn none_omitted() -> String = greet("ada", "hi", "!")
fn all_omitted() -> String = greet("ada")
fn by_name() -> String = greet("ada", greeting: "hey")
fn out_of_order() -> String = greet("ada", mark: "?", greeting: "yo")

// A `?` inside a string is not a token, which is why counting sugar by grep
// would have been wrong: the reference lexer finds no `Question` in the line
// above and one in `try_of(1)?` below.
fn try_of(n: Int) -> Result<Int, {msg: String}> = Ok(n)
fn both(n: Int) -> Result<String, {msg: String}> = Ok(greet("x", mark: "!"))

// A default is an expression, which is the whole reason `param` had to move
// out of `types.ply`: every one of these is a subtree under a `prm`.
fn arith(n: Int = 1 + 2, m: Int = -3) -> Int = n + m
fn a_list(xs: List<Int> = [1, 2, 3]) -> Int = 0
fn a_record(r: {a: Int} = {a: 1}) -> Int = r.a
fn a_lambda(k: (Int) -> Int = |x: Int| x) -> Int = k(1)
fn a_call(n: Int = arith(1)) -> Int = n
fn a_block(n: Int = { let y = 1; y + 1 }) -> Int = n
fn a_match(n: Int = match 1 { 0 -> 1, _ -> 2 }) -> Int = n
fn an_if(n: Int = if true { 1 } else { 2 }) -> Int = n

fn named_only() -> Int = arith(m: 9, n: 8)
fn in_a_list() -> List<String> = [greet("x"), greet("y", mark: ".")]
fn nested_named() -> String = greet("a", greeting: greet("b", mark: "!"))

test "a named argument inside a test body" {
  assert_eq(greet("z", mark: "!"), "helloz!")
}

law "a named argument inside a law" forall (n: Int) { arith(n: n) == arith(n) }
