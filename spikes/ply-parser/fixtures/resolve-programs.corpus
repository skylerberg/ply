Hand-written programs for the resolve differential: the error paths the real `.ply` files in the
tree never reach. Programs are separated by a line holding exactly `%%%`, modules within one by a
line holding exactly `%%`, and each module's first line is its dotted name.

%%%
base
pub fn one() -> Int = 1
pub type Shape = | Circle(Int) | Square(Int)
pub effect log { write emit(Bytes) -> Unit }
fn hidden() -> Int = 2
%%
app
import base
import base (one, Shape, log)
fn two() -> Int = one() + base::one()
fn s(x: Shape) -> Int = match x { Circle(r) -> r, Square(w) -> w }
%%%
app
import nowhere
import std.nowhere
fn f() -> Int = 1
%%%
lib
pub fn a() -> Int = 1
%%
app
import lib
import lib
import lib as lib
fn f() -> Int = lib::a()
%%%
lib
fn secret() -> Int = 1
pub fn shown() -> Int = 2
%%
app
import lib (secret, shown, absent)
fn f() -> Int = shown()
%%%
lib
pub fn place() -> Int = 1
pub type Order = { id: Int }
%%
app
import lib (place, Order)
fn place() -> Int = 2
type Order = { id: Bytes }
fn f() -> Int = place()
%%%
lib
pub fn a() -> Int = 1
%%
other
pub fn a() -> Int = 2
%%
app
import lib (a)
import other (a)
fn f() -> Int = a()
%%%
me
import me
fn f() -> Int = 1
