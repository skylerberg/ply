c
import a
pub fn fc() -> Int = 1
%%%
twin
pub fn x() -> Int = 1
%%
twin
pub fn y() -> Int = 2
%%%
lib
pub fn greet(name: Bytes = b"world", times: Int = 1) -> Bytes = name
pub fn scale(v: Int, by: Int = unit()) -> Int = v * by
pub fn unit() -> Int = 1
fn helper() -> Int = 3
pub fn leaky(n: Int = helper()) -> Int = n
%%
app
import lib (greet, scale)
fn a() -> Bytes = greet()
fn b() -> Bytes = greet(b"x")
fn c() -> Bytes = greet(times: 2)
fn d() -> Bytes = greet(b"x", times: 2, name: b"y")
fn e() -> Bytes = greet(nope: 1)
fn f() -> Int = scale(2)
fn g() -> Int = scale(by: 3)
fn h() -> Int = scale(2, 3, 4)
fn i() -> Bool = assert(true)
fn j() -> Int = { let greet = |x: Int| x; greet(x: 1) }
fn k() -> Int = Some(x: 1)
%%%
lib
pub fn f(n: Int = g(1)) -> Int = n
pub fn g(n: Int) -> Int = n
pub fn h(n: Int, m: Int = n) -> Int = m
%%
app
import lib (f, h)
fn a() -> Int = f()
fn b() -> Int = h(1)
