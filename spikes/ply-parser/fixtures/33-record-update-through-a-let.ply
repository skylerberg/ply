// A record update reads the shape off a written type: a parameter's, a `let`'s
// annotation, or a field path through either. An unannotated `let` is `E0116`.
type Inner = { x: Int, y: Int }
type Outer = { inner: Inner, tag: Bytes }

fn bump(o: Outer) -> Outer = {
  let i: Inner = o.inner;
  let moved = {..i, x: i.x + 1};
  let both: Inner = {..o.inner, y: 0, x: 1};
  let plain = {..moved, y: 2};
  {..o, inner: both, tag: b"bumped"}
}

fn widen(p: (Int, Int)) -> (Int, Int) = {..p, _1: 0}
