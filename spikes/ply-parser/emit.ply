// The C emitter, in Ply: what a code generator writes.
//
// `code.ply` builds the tree `crates/ply-codegen`'s emitter reads; this writes
// what it writes. The oracle is `reference_emit_dump` in `harness/src/lib.rs`,
// and the comparison is byte for byte over one body's C -- placeholders and all,
// because a body names the unit's tables by its own positions and is therefore a
// function of the body alone.
//
// **What is covered is written down and refused otherwise.** `emit_fn` answers
// `None` for a form this port has not reached, exactly as `code.ply`'s `lower`
// does, so the differential compares what was written rather than a guess.
//
// One coupling the emit oracle records and this file has to live with: the
// reference optimises before it lowers, so `1 + 2` reaches its emitter as `3`
// while this one sees the addition. The comparison is over programs where that
// makes no difference, and closing the gap is `fold_literals` -- a piece of
// `opt.rs`, not of this file.

import spine (num, Ident)
import code (hex, Code, Node, NLit, NVar, NBinary, NIf, NBlock, NList, NUnary, NField, NUpd, NApp, NRecord, NMatch, CPat, PxWild, PxVar, PxLit, PxCtor, PxRecord, PxList, CPatField, NPerform, NCell, NRegion, NLambda, NSim, NHandle, CStmt, CLet, CLetPat, CDo, pat_slots, CField, CArm, Cap, CClause, CRet, Own, Borrowed, Owned, OwnedField, lower_fn, qname_text)
import items (IEffect, OpDef, Module, Derived, Item, IFn, ITest, ILaw, IType, TypeDefBody, TDAlias, parse, ImportDecl, ImportKind, INames, IModule, IAlias, Binder, SpecClause, SRequires, SEnsures, FnDef)
import resolve (Mod, Source, Resolved_, Failed, resolve_modules, Resolved, Scope, Binding, ModBind)
import derive (expand_derives)
import infer (pure_definitions)
import exprs (Param, Expr, EHandle, ESimulate, EUnary, EBinary, ELambda, EApp, EIf, EMatch, EBlock, ERecord, ERecordUpdate, ETry, EField, EList, EPerform, EWithCell, EWithRegion, HandleClause, MatchArm, RecField, Stmt, SLet, SExpr)
import types (MWrite, TypeExpr, TVar, TCon, TRecord)
import rewrite (expand)
import patterns (Lit, LInt, LFixed, LBool, LStr, LBytes, LFloat, LDec, LUnit, LBad)

// The C type a value is held in, and what the emitter knows about it. `Boxed` is
// a `Word`; `Int` is the untagged sixty-four bits inside one.
pub type Kind = | KBoxed | KInt | KBool
  // A fixed width the C carries in a register of its own: the six below sixty-four bits.
  // A width is held in its own C type and cast where the signedness matters, because
  // signed overflow is undefined in C. The two sixty-four-bit widths stay words.
  | KNum(Width)

pub type Width = { bits: Int, signed: Bool }

pub fn ctype(k: Kind) -> Bytes =
  match k {
    KNum(w) -> if w.signed { if w.bits == 8 { b"int8_t" } else if w.bits == 16 { b"int16_t" } else { b"int32_t" } }
               else { utype(w) },
    _ -> b"int64_t",
  }

fn utype(w: Width) -> Bytes =
  if w.bits == 8 { b"uint8_t" } else if w.bits == 16 { b"uint16_t" } else { b"uint32_t" }

// The eight widths by name; `width_index` is the order the reference numbers them in.
fn width_named(name: Bytes) -> Option<Width> =
  if name == b"U8" { Some({ bits: 8, signed: false }) }
  else if name == b"U16" { Some({ bits: 16, signed: false }) }
  else if name == b"U32" { Some({ bits: 32, signed: false }) }
  else if name == b"U64" { Some({ bits: 64, signed: false }) }
  else if name == b"I8" { Some({ bits: 8, signed: true }) }
  else if name == b"I16" { Some({ bits: 16, signed: true }) }
  else if name == b"I32" { Some({ bits: 32, signed: true }) }
  else if name == b"I64" { Some({ bits: 64, signed: true }) }
  else { None }

fn width_index(w: Width) -> Int =
  (if w.signed { 4 } else { 0 })
    + (if w.bits == 8 { 0 } else if w.bits == 16 { 1 } else if w.bits == 32 { 2 } else { 3 })

fn carried(w: Width) -> Bool = w.bits < 64

fn pow2(n: Int) -> Int = if n <= 0 { 1 } else { 2 * pow2(n - 1) }

fn width_min(w: Width) -> Int = if w.signed { 0 - pow2(w.bits - 1) } else { 0 }

fn width_max(w: Width) -> Int = if w.signed { pow2(w.bits - 1) - 1 } else { pow2(w.bits) - 1 }

// A value as a width's own C type: the reference's `as_num`.
fn as_num(v: V, w: Width) -> Bytes =
  match v.k {
    KNum(h) -> if h == w { v.c } else { bytes_concat_all([b"(", ctype(KNum(w)), b")(", v.c, b")"]) },
    KBoxed -> bytes_concat_all([b"(", ctype(KNum(w)), b")ply_imm_value(", v.c, b")"]),
    _ -> bytes_concat_all([b"(", ctype(KNum(w)), b")(", v.c, b")"]),
  }

// One emitted value: the kind it is held at, and the C expression naming it.
pub type V = { k: Kind, c: Bytes, ty: Ty }

// What the emitter knows about a value's shape. Only records need more than the
// kind, and only so that a field name can become the index it is read at.
// `TyOpaque` is a `Float` or a `Decimal`: a value an operator cannot read as an `Int`, so an
// operator over one reaches the machine's own operator through the runtime instead.
pub type Ty = | TyOpen | TyRec(List<FieldTy>) | TyBytes | TyList | TyOpaque

// A record's fields, in the order they were written. The *kind* matters as much
// as the name: a scalar field is read into a register of its own kind and a
// field of any other type stays the word it is, and reading every field as an
// `Int` writes an unbox the reference does not.
pub type FieldTy = { name: Bytes, k: Kind, ty: Ty }

// The emitter's state: the lines written so far and the next temporary's number.
// The lines written so far, the next temporary's number, and the slots whose
// word has already been unboxed.
//
// The last is not a cache for its own sake: the reference binds a parameter's
// untagged value once and every later integer read of that slot names the same
// temporary, so `(a + b) * (a - b)` unboxes twice and not four times. An emitter
// that unboxed per read would answer the same and write different C.
// `reads` is every slot read anywhere in the body, once per read. The release
// rule counts over the whole body rather than over what has been emitted: the
// emitter does not visit reads in the order the lowering marked them.
pub type Em = { out: List<Bytes>, n: Int, conv: List<Conv>, ind: Int, reads: List<Int>,
                shapes: List<List<Bytes>>, built: List<Built>, module: Bytes,
                // Locals holding a count on something this body made and nothing
                // else can name. A callee that takes one of these is handed the
                // count rather than a duplicate of it.
                made: List<Made>,
                // The definitions of the module being emitted, with the kind each
                // answers. A bare name that is not one of them is a builtin or an
                // import, and this port resolves neither, so it refuses rather
                // than mangling a guess.
                here: List<Def>,
                imports: List<Imported>,
                // The literals this body has met, in the order it met them. A
                // body names the unit's tables by its own positions, so two
                // occurrences of one literal share an index and two bodies with
                // the same literal need not agree about where it sits.
                consts: List<Lit>,
                // Every constructor's program-wide name, in the order the tags
                // are assigned. Handed in: a tag is a position in a table over
                // the whole program, and this port sees one module.
                ctors: List<Bytes>,
                // The sub-functions this body has produced, and how many. A
                // lambda's own code goes here and is written after the function
                // that built the closure, which is where the reference puts it.
                extra: Bytes,
                // The symbols this body's code table names: each lambda's entry, and each pure
                // nullary definition's entry a constant is asked for.
                lambdas: List<Bytes>,
                // The name the sub-functions are numbered under, which is the
                // *named* function's, not an enclosing lambda's.
                owner: Bytes,
                // Every builtin's name, handed in, and the ones this body has
                // met. A bare name that is neither this module's nor one of its
                // imports is one of these, and there is no way to know which from
                // one module's text.
                builtins: List<Bytes>,
                met: List<Bytes>,
                // The field names this body has met, for the reads whose record
                // shape it cannot see.
                fields: List<Bytes>,
                // Whether nothing in this function is emitted after the node
                // being written. An update at the tail releases its base however
                // many times the body reads it, because the later read the
                // one-read guard protects against cannot be there.
                //
                // Preserved down a block's tail, into both arms of an `if` and
                // every arm of a `match` -- only one of those runs. Cleared into
                // a call's arguments, where a fused loop's body is emitted once
                // and runs once per iteration, so "nothing after it" is true of
                // the text and false of the execution.
                tail: Bool,
                // Every definition this body calls, by program-wide name, as the reference's cache
                // records it: a body kept between runs is checked against the set the fixpoint took.
                calls: List<Bytes>,
                // The first reason this body was refused, if it was. A refusal does not stop the
                // emission: it poisons the state and emission runs out, so every refusal carries
                // its reason to the top of the body and no signature had to change for it.
                refused: Option<Bytes>,
                // A flat record built from locals is held back until something asks for its
                // word, and the local it will land in is declared at the top of the body.
                deferred: List<Deferred>, rlocals: List<Bytes>,
                // The effects this body performs and handles, under their program-wide names;
                // the label a failing call inside a `handle` body jumps to, if it is inside one;
                // and the effect names in scope, each with its program-wide name.
                performs: List<Bytes>, handles: List<Bytes>, landing: Option<Bytes>, effects: List<EffectName>,
                // The slots already released. `Owned` marks a *use* as the last
                // one, and a body that hands a record to a call and then reads a
                // field of it for a later argument has two reads marked that way.
                // Releasing at both frees a record the first release gave back.
                released: List<Bytes>,
                // The reuse-token widths this body has *used*, collected as it
                // goes. The declarations are written afterwards and put in front,
                // which is what the reference does -- a pre-pass that predicted
                // them instead had to predict the release rule too, and the two
                // disagreed on every body where a shape reached the emitter that
                // the pass could not see.
                toks: List<Int>,
                // A rename is an alias, not a second object. `alias` follows a
                // local back to the one it renames, and `by_root` charges each
                // binding's reads to the object the local holds -- so an object
                // wearing three names, each read once, counts three and not one.
                //
                // Counting a single name there says "one read, safe to release"
                // about an object three other names still hold.
                alias: List<{ local: Bytes, root: Bytes }>,
                by_root: List<{ root: Bytes, n: Int }>,
                // Whether this body releases what it holds (ADR 0046). Off, every count is kept
                // until the entry ends, which is the reference's rule and the text the ratchet
                // compares. On, `made` is every local holding a count, `bound` the ones a slot
                // names -- moved only at a read the lowering marked `Owned` -- and `pinned` the
                // ones a fused loop's body may read but never move.
                release: Bool, pinned: List<Bytes>, bound: List<Bytes> }

// A definition of this module, with what a call of it answers. The *shape* as
// well as the kind: a call whose answer is a record of known fields is where a
// later field read gets its offset, and dropping it here is what sent those
// reads through the runtime.
// `pure` is the checker's word: an empty footprint and no constraint, which is what lets a
// nullary call be answered from the constant table.
pub type Def = { name: Bytes, ret: Option<Kind>, ret_ty: Ty, pure: Bool, arity: Int }

// A name another module exports and this one brought in by name. An imported
// name lowers to a bare global, indistinguishable from a builtin, so the module's
// own import list is the only thing that tells the two apart without resolving.
// `defs` is the imported module's definitions, so a call across modules opens its answer to
// the callee's declared type as a local call does; empty when the module was not in reach.
pub type Imported = { name: Bytes, module: Bytes, defs: List<Def> }

// One module's definitions, for the imports that name it.
pub type ModDefs = { module: Bytes, defs: List<Def>, aliases: List<Alias> }

// A `type` item that names a type: its parameters, and the type in its own module's scope.
pub type Alias = { name: Bytes, params: List<Bytes>, ty: TypeExpr }

// A type variable an alias's argument bound, resolved where the argument was written.
pub type Bound = { name: Bytes, k: Kind, ty: Ty }

// A record this body built, and the values its fields were built from. A later
// field read of it is that value: it is already in a register, and going to
// memory for it would be the store, the load and the tag that building the
// record in the first place is trying to avoid.
//
// Sound because the values are locals of this body, and a record that leaves the
// body leaves through a name this table has no entry for.
pub type Built = { local: Bytes, names: List<Bytes>, vals: List<V> }

pub type Deferred = { name: Bytes, shape: Int, n: Int, flags: Int, words: List<Bytes> }

// A C local holding one count, and the block depth it is declared at: released at that
// block's close unless spent first.
pub type Made = { name: Bytes, ind: Int }

pub type EffectName = { written: Bytes, global: Bytes, ops: List<OpMode> }

pub type OpMode = { name: Bytes, write: Bool }

pub type Conv = { slot: Int, k: Kind, c: Bytes, ty: Ty }

// A parameter, as the emitter needs it: the C word arrives boxed and the
// declared type says how to open it.
pub type P = { name: Bytes, k: Kind, ty: Ty }

pub type Out = { em: Em, v: V }

// A line is pushed, and a body's text joined once: appending to one string would copy the
// body so far for every line, which is quadratic in a heap that keeps what an entry lets go.
fn line(em: Em, text: Bytes) -> Em =
  { out: push(em.out, bytes_concat_all([pad(em.ind), text, b"\n"])), n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes, built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports, consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner, builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }

fn pad(ind: Int) -> Bytes = if ind <= 0 { b"  " } else { bytes_concat(b"  ", pad(ind - 1)) }

fn indent(em: Em) -> Em = { out: em.out, n: em.n, conv: em.conv, ind: em.ind + 1, reads: em.reads, shapes: em.shapes, built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports, consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner, builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }

fn outdent(em: Em) -> Em = { out: em.out, n: em.n, conv: em.conv, ind: em.ind - 1, reads: em.reads, shapes: em.shapes, built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports, consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner, builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }

// A branch leaves the enclosing scope with the temporaries it unboxed: they are
// declared inside the C block and are gone at the brace. `conv` goes back to
// what it was, or a later read names a dead variable.
// Everything below this node is emitted before whatever follows it.
// The arms of a `match` and the branches of an `if` are tails when the node is,
// and they are reached *through* the scrutinee or the condition -- which are not.
// Restoring the node's own answer is what makes an arm a tail again.
fn withtail(em: Em, t: Bool) -> Em =
  if em.tail == t { em } else {
    { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
      built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports,
      consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner,
      builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks,
      alias: em.alias, by_root: em.by_root, tail: t, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }
  }

fn notail(em: Em) -> Em =
  if !em.tail { em } else {
    { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
      built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports,
      consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner,
      builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks,
      alias: em.alias, by_root: em.by_root, tail: false, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }
  }

fn rescope(em: Em, conv: List<Conv>) -> Em = { out: em.out, n: em.n, conv: conv, ind: em.ind, reads: em.reads, shapes: em.shapes, built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports, consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner, builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }

fn fresh(em: Em) -> { em: Em, name: Bytes } =
  { em: { out: em.out, n: em.n + 1, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes, built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports, consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner, builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }, name: bytes_concat(b"t", num(em.n + 1)) }

// The last entry wins: a `let` may shadow a slot an enclosing scope filled.
fn conv_of(em: Em, slot: Int) -> Option<V> =
  fold(em.conv, None, |acc: Option<V>, c: Conv|
    if c.slot == slot { Some({ k: c.k, c: c.c, ty: c.ty }) } else { acc })

fn remember(em0: Em, slot: Int, v: V) -> Em = {
  let em = charge(em0, slot, v.c);
  let em1: Em = if v.k == KBoxed { note_bound(em, v.c) } else { em };
  { ..em1, conv: push(em1.conv, { slot: slot, k: v.k, c: v.c, ty: v.ty }) }
}

// A binding, which is what every intermediate value is: `<type> tN = <expr>;`.
fn bind(em: Em, k: Kind, expr: Bytes) -> Out = {
  let f = fresh(em);
  // A record held back is its local already: binding it is the name itself, and the number
  // is spent as the reference spends it.
  if fold(em.rlocals, false, |acc: Bool, r: Bytes| acc || r == expr) { { em: f.em, v: { k: k, c: expr, ty: TyOpen } } } else {
  let o = line(f.em, bytes_concat_all([ctype(k), b" ", f.name, b" = ", expr, b";"]));
  // A binding that is only a rename carries the fields the record was built from
  // with it. A block binds its tail, so without this the knowledge is lost at
  // the first one -- which is immediately, since every `if` arm is a block.
  let kept0 = match built_of(o, expr) {
    Some(b) -> remember_built(o, f.name, b.names, b.vals),
    None -> o,
  };
  let kept = if is_local(expr) { note_alias(kept0, f.name, root_of(kept0, expr)) } else { kept0 };
  let held = if k == KBoxed && answers_owned(kept, expr) { note_made(kept, f.name) }
             else if k == KBoxed && kept.release && spendable(kept, expr) {
               note_made(line(spend_made(kept, expr), bytes_concat_all([expr, b" = 0;"])), f.name)
             } else { kept };
  { em: held, v: { k: k, c: f.name, ty: TyOpen } }
  }
}

fn deferred_of(em: Em, name: Bytes) -> Option<Deferred> =
  fold(em.deferred, None, |acc: Option<Deferred>, d: Deferred| if d.name == name { Some(d) } else { acc })

// A record held back is built here, where its word is first asked for, and the guard keeps a
// second asking from building it twice.
fn materialise(em: Em, name: Bytes) -> Em =
  match deferred_of(em, name) {
    None -> em,
    Some(d) -> {
      let o1 = line(note_tok(em, d.n), bytes_concat_all([b"if (!", name, b") {"]));
      let o2 = line(indent(o1), bytes_concat_all([b"if (tok", num(d.n), b") {"]));
      let o3 = line(indent(o2), bytes_concat_all([name, b" = tok", num(d.n), b"; tok", num(d.n), b" = 0;"]));
      let o4 = line(o3, bytes_concat_all([b"ply_obj(", name, b")->rc = 1; ply_obj(", name, b")->flags = ", num(d.flags),
        b"; ply_obj(", name, b")->len = ", num(d.n), b"; ply_obj(", name, b")->layout = @@s", num(d.shape), b"@@;"]));
      let o5 = line(indent(line(outdent(o4), b"} else {")), bytes_concat_all([name, b" = rt_alloc_p(ctx, 3, ", num(d.n),
        b", @@s", num(d.shape), b"@@, ", num(d.flags), b");"]));
      let o6 = line(outdent(line(o5, b"if (ctx->failed) return 0;")), b"}");
      let o7 = fold(range(0, len(d.words)), o6, |acc: Em, at: Int|
        line(acc, bytes_concat_all([b"ply_words(", name, b")[", num(at), b"] = ",
          match list_at(d.words, at) { Some(w) -> w, None -> b"0" }, b";"])));
      line(outdent(o7), b"}")
    },
  }

// A value's word, with a record held back built first: the reference's `word`.
fn word_of(em: Em, v: V) -> { em: Em, c: Bytes } =
  match v.k {
    KBoxed -> { em: materialise(em, v.c), c: v.c },
    _ -> { em: em, c: as_word(v) },
  }

// The reads a body's counts are over: a lambda's body counts in its own window, its captures
// already charged from outside.
fn with_reads(em: Em, reads: List<Int>) -> Em =
  { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: reads, shapes: em.shapes,
    built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports,
    consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner,
    builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks,
    alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused,
    deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }

fn with_out(em: Em, out: List<Bytes>) -> Em =
  { out: out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
    built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports,
    consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner,
    builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks,
    alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused,
    deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }

fn with_landing(em: Em, landing: Option<Bytes>) -> Em =
  { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
    built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports,
    consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner,
    builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks,
    alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused,
    deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }

fn note_performs(em: Em, eff: Bytes) -> Em =
  { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
    built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports,
    consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner,
    builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks,
    alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused,
    deferred: em.deferred, rlocals: em.rlocals, performs: push(em.performs, eff), handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }

fn note_handles(em: Em, eff: Bytes) -> Em =
  { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
    built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports,
    consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner,
