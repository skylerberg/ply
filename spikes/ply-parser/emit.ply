fn note_deferred(em: Em, d: Deferred) -> Em = note_holder(note_deferred0(em, d), d.name)

fn note_deferred0(em: Em, d: Deferred) -> Em =
  { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
    built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports,
    consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner,
    builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks,
    alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused,
    deferred: push(em.deferred, d), rlocals: push(em.rlocals, d.name),
    performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }

// One record, from its sorted names, the words that fill it and the values those words came
// from: the reference's `emit_record`. A record whose every field is a width or a `Bool` is
// flat, and one built from locals is held back rather than built; any other is built now,
// from a reuse token of its width when the body has one.
fn build_record(em: Em, names: List<Bytes>, words: List<Bytes>, kinds: List<Kind>, vals: Option<List<V>>) -> Out = {
  let sh = shape_of(em, names);
  let n = len(names);
  let flat = n > 0 && fold(kinds, true, |acc: Bool, k: Kind| acc && match k { KNum(_) -> true, KBool -> true, _ -> false });
  let flags = if flat { 1 } else { 0 };
  let ty = TyRec(map(range(0, n), |i: Int|
    { name: match list_at(names, i) { Some(x) -> x, None -> b"" },
      k: match list_at(kinds, i) { Some(k) -> k, None -> KBoxed },
      ty: match vals { Some(vs) -> match list_at(vs, i) { Some(v) -> v.ty, None -> TyOpen }, None -> TyOpen } }));
  match vals {
    Some(vs) -> if flat {
      let f = fresh(sh.em);
      let held = line(note_deferred(f.em, { name: f.name, shape: sh.i, n: n, flags: flags, words: words }),
                      bytes_concat_all([f.name, b" = 0;"]));
      { em: remember_built(held, f.name, names, vs), v: { k: KBoxed, c: f.name, ty: ty } }
    } else { built_now(sh.em, names, words, sh.i, n, flags, ty, Some(vs)) },
    None -> built_now(sh.em, names, words, sh.i, n, flags, ty, None),
  }
}

fn built_now(em: Em, names: List<Bytes>, words: List<Bytes>, shape: Int, n: Int, flags: Int, ty: Ty, vals: Option<List<V>>) -> Out = {
  let rec = bind(note_tok(em, n), KBoxed, b"0");
  let opened = line(rec.em, bytes_concat_all([b"if (tok", num(n), b") {"]));
  let took = line(
    line(indent(opened), bytes_concat_all([rec.v.c, b" = tok", num(n), b"; tok", num(n), b" = 0;"])),
    bytes_concat_all([b"ply_obj(", rec.v.c, b")->rc = 1; ply_obj(", rec.v.c,
                      b")->flags = ", num(flags), b"; ply_obj(", rec.v.c, b")->len = ", num(n),
                      b"; ply_obj(", rec.v.c, b")->layout = @@s", num(shape), b"@@;"]));
  let made = line(
    line(indent(line(outdent(took), b"} else {")),
         bytes_concat_all([rec.v.c, b" = rt_alloc_p(ctx, 3, ", num(n), b", @@s", num(shape), b"@@, ", num(flags), b");"])),
    b"if (ctx->failed) return 0;");
  let closed = line(outdent(made), b"}");
  let stored = fold(range(0, n), closed, |acc: Em, at: Int|
    line(acc, bytes_concat_all([b"ply_words(", rec.v.c, b")[", num(at), b"] = ",
      match list_at(words, at) { Some(w) -> w, None -> b"0" }, b";"])));
  let kept = match vals { Some(vs) -> remember_built(stored, rec.v.c, names, vs), None -> stored };
  { em: note_made(kept, rec.v.c), v: { k: KBoxed, c: rec.v.c, ty: ty } }
}

// The same, keeping the shape the value already had. A rename that dropped it
// would lose a record's field list at the first block boundary, and every `if`
// arm is a block.
fn bind_keeping(em: Em, k: Kind, ty: Ty, expr: Bytes) -> Out = {
  let o = bind(em, k, expr);
  { em: o.em, v: { k: o.v.k, c: o.v.c, ty: ty } }
}

// A local name: `t12`, `p0`, `q1`. Anything else is an expression.
fn is_local(e: Bytes) -> Bool =
  bytes_len(e) > 1
    && (bytes_at(e, 0) == 116 || bytes_at(e, 0) == 112 || bytes_at(e, 0) == 113)
    && fold(range(1, bytes_len(e)), true, |acc: Bool, i: Int|
         acc && bytes_at(e, i) >= 48 && bytes_at(e, i) <= 57)

fn root_of(em: Em, local: Bytes) -> Bytes =
  fold(em.alias, local, |acc: Bytes, a: { local: Bytes, root: Bytes }|
    if a.local == local { a.root } else { acc })

fn note_alias(em: Em, local: Bytes, root: Bytes) -> Em =
  { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
    built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports,
    consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner,
    builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks,
    alias: push(em.alias, { local: local, root: root }), by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }

// Charge a slot's reads to the object the local holds, once per (object, slot).
fn charge(em: Em, slot: Int, local: Bytes) -> Em = {
  let r = root_of(em, local);
  let already = fold(em.by_root, false, |acc: Bool, e: { root: Bytes, n: Int }|
    acc || e.root == bytes_concat_all([r, b"#", num(slot)]));
  if already { em } else {
    { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
      built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports,
      consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner,
      builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks,
      alias: em.alias,
      by_root: push(push(em.by_root, { root: bytes_concat_all([r, b"#", num(slot)]), n: 0 }),
                    { root: r, n: count_of(em.reads, slot) }), tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }
  }
}

fn reads_of_root(em: Em, local: Bytes) -> Int = {
  let r = root_of(em, local);
  fold(em.by_root, 0, |acc: Int, e: { root: Bytes, n: Int }| if e.root == r { acc + e.n } else { acc })
}

fn built_of(em: Em, local: Bytes) -> Option<Built> =
  fold(em.built, None, |acc: Option<Built>, b: Built| if b.local == local { Some(b) } else { acc })

// A runtime helper hands back a word it owns. A *compiled* call does not count,
// and the distinction is the reference's: a call's result is duplicated before
// it is handed on, and only a helper's count is handed over.
fn answers_owned(em: Em, expr: Bytes) -> Bool =
  (bytes_len(expr) > 3 && bytes_slice(expr, 0, 3) == b"rt_")
  || (em.release
      && ((bytes_len(expr) > 4 && bytes_slice(expr, 0, 4) == b"ply_" && calls_with_ctx(expr))
          || (bytes_len(expr) > 13 && bytes_slice(expr, 0, 13) == b"(ply_fits_imm")))

// A compiled call: `ply_<name>(ctx, ...)`, told from a load or an immediate by what follows the
// first parenthesis.
fn calls_with_ctx(expr: Bytes) -> Bool = {
  let p = bytes_scan_until(expr, 0, b"(", bytes_len(expr));
  p + 4 <= bytes_len(expr) && bytes_slice(expr, p, p + 4) == b"(ctx"
}

fn note_made(em: Em, name: Bytes) -> Em =
  { ..em, made: push(em.made, { name: name, ind: em.ind }) }

// A refusal: the first reason is kept, and emission runs out on a placeholder value.
fn poison(em: Em, why: Bytes) -> Em =
  match em.refused {
    Some(_) -> em,
    None -> { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
      built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports, consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner, builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: Some(why), deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound },
  }

fn refused(em: Em, why: Bytes) -> Out =
  { em: poison(em, why), v: { k: KBoxed, c: b"0", ty: TyOpen } }

// The index a symbol takes in this body's code table, added on first use.
fn lambda_of(em: Em, sym: Bytes) -> { em: Em, i: Int } =
  match fold(range(0, len(em.lambdas)), None, |acc: Option<Int>, i: Int|
          match list_at(em.lambdas, i) { Some(x) -> if x == sym { Some(i) } else { acc }, None -> acc }) {
    Some(i) -> { em: em, i: i },
    None -> { em: { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
                    built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports, consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: push(em.lambdas, sym), owner: em.owner, builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound },
              i: len(em.lambdas) },
  }

fn note_call(em: Em, full: Bytes) -> Em =
  { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
    built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports, consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner, builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: push(em.calls, full), refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }

fn spend_made(em: Em, name: Bytes) -> Em =
  { ..em, made: fold(em.made, [], |acc: List<Made>, m: Made| if m.name == name { acc } else { push(acc, m) }) }

fn is_made(em: Em, name: Bytes) -> Bool =
  fold(em.made, false, |acc: Bool, m: Made| acc || m.name == name)

fn is_bound(em: Em, name: Bytes) -> Bool =
  fold(em.bound, false, |acc: Bool, b: Bytes| acc || b == name)

fn is_pinned(em: Em, name: Bytes) -> Bool =
  fold(em.pinned, false, |acc: Bool, p: Bytes| acc || p == name)

// A count a consumer may take in place: held by a local no slot names and no loop pins. A
// slot's local is spent only by a read marked `Owned`, which moves it out under a name of its
// own first.
fn spendable(em: Em, name: Bytes) -> Bool =
  is_made(em, name) && !is_bound(em, name) && !is_pinned(em, name)

// A holder, under release only: the reference's text keeps every count until the entry ends.
fn note_holder(em: Em, name: Bytes) -> Em =
  if em.release { note_made(em, name) } else { em }

fn note_bound(em: Em, name: Bytes) -> Em = { ..em, bound: push(em.bound, name) }

// Every holder in scope, pinned for a fused loop's body: the text is read once and runs as
// often as the loop does, so a mark that says "last use" is about the text.
fn pin_all(em: Em) -> Em =
  { ..em, pinned: fold(em.made, em.pinned, |acc: List<Bytes>, m: Made| push(acc, m.name)) }

fn with_pinned(em: Em, pinned: List<Bytes>) -> Em = { ..em, pinned: pinned }

fn with_made(em: Em, made: List<Made>) -> Em = { ..em, made: made }

// What may still be held after either of two paths: released at the scope's end, where the
// path that spent it left it null.
fn union_made(a: List<Made>, b: List<Made>) -> List<Made> =
  fold(b, a, |acc: List<Made>, m: Made|
    if fold(acc, false, |seen: Bool, x: Made| seen || x.name == m.name) { acc } else { push(acc, m) })

// Releases every holder declared at depth `from` or deeper and forgets the block's own. A
// `break` names the loop's depth and keeps the enclosing blocks' holders for the paths that
// stay.
fn release_at(em: Em, from: Int) -> Em =
  if !em.release { em } else {
    let out: Em = fold(em.made, em, |acc: Em, m: Made|
      if m.ind >= from { line(acc, bytes_concat_all([b"ply_dec(ctx, ", m.name, b");"])) } else { acc });
    { ..out, made: fold(em.made, [], |acc: List<Made>, m: Made| if m.ind >= em.ind { acc } else { push(acc, m) }) }
  }

// The close of a block that may have declared holders.
fn close(em: Em) -> Em = line(outdent(release_at(em, em.ind)), b"}")

// A slot's local at the read the lowering marked its last use: moved out under a name of its
// own, which a consumer then takes, and nulled so the scope's release passes it by. A pinned
// local stays, and a held-back record is built first.
fn move_read(em: Em, own: Own, v: V) -> Out =
  if !em.release || own != Owned || v.k != KBoxed || !is_made(em, v.c) || is_pinned(em, v.c) { { em: em, v: v } } else {
    let b = match deferred_of(em, v.c) {
      Some(_) -> bind_word_of(materialise(em, v.c), v.c),
      None -> bind_keeping(em, KBoxed, v.ty, v.c),
    };
    { em: note_made(line(spend_made(b.em, v.c), bytes_concat_all([v.c, b" = 0;"])), b.v.c),
      v: { k: KBoxed, c: b.v.c, ty: v.ty } }
  }

// A local a slot is about to name holds a count of its own: taken over from a temporary
// already, or added to what another name still holds.
fn ensure_owned(em: Em, v: V) -> Em =
  if !em.release || v.k != KBoxed || is_made(em, v.c) { em } else {
    note_made(line(em, bytes_concat_all([b"ply_inc(", v.c, b");"])), v.c)
  }

// `target = word;` where the target holds a count afterwards: a temporary's count moves, a
// name still held elsewhere is held once more, and an expression answers a count of its own.
fn assign_owned(em: Em, target: Bytes, c: Bytes) -> Em =
  if !em.release { em }
  else if spendable(em, c) { line(spend_made(em, c), bytes_concat_all([c, b" = 0;"])) }
  else if is_local(c) { line(em, bytes_concat_all([b"ply_inc(", target, b");"])) }
  else { em }

// A value nothing takes: a statement's, released where it is.
fn drop_value(em: Em, v: V) -> Em =
  if em.release && v.k == KBoxed && spendable(em, v.c) {
    line(spend_made(em, v.c), bytes_concat_all([b"ply_dec(ctx, ", v.c, b"); ", v.c, b" = 0;"]))
  } else { em }

// The word a function answers, owned by its caller: under release the count is taken or added
// first, and everything the body still holds is released before the return.
fn returned(em: Em, v: V) -> { em: Em, c: Bytes } =
  if !em.release { word_of(em, v) } else {
    let r = owned(em, v);
    { em: release_at(r.em, 0), c: r.v.c }
  }


// A value collected into an aggregate: boxed, and held in a local declared
// `Word` rather than by its kind's C type, because the array a list is built
// from is an array of words.
fn sets_bound(em: Em, xs: List<Code>, params: List<P>, i: Int, acc: List<V>)
    -> Option<{ em: Em, vals: List<V> }> =
  if i >= len(xs) { Some({ em: em, vals: acc }) } else {
    match list_at(xs, i) {
      None -> None,
      Some(x) -> match expr(notail(em), x, params) {
        None -> None,
        Some(o) -> {
          let b = bind_keeping(o.em, o.v.k, o.v.ty, o.v.c);
          let s = secure(b.em, b.v);
          sets_bound(s.em, xs, params, i + 1, push(acc, s.v))
        },
      },
    }
  }

fn concat_names(a: List<Bytes>, b: List<Bytes>) -> List<Bytes> =
  fold(b, a, |acc: List<Bytes>, x: Bytes| push(acc, x))

fn set_value(sets: List<CField>, vals: List<V>, name: Bytes) -> Option<V> =
  fold(range(0, len(sets)), None, |acc: Option<V>, i: Int|
    match list_at(sets, i) {
      Some(f) -> if f.name == name { list_at(vals, i) } else { acc },
      None -> acc,
    })

// A `Word` local holding an expression, without taking a count for it.
fn bind_word_of(em: Em, e: Bytes) -> Out = {
  let f = fresh(em);
  { em: line(f.em, bytes_concat_all([b"Word ", f.name, b" = ", e, b";"])),
    v: { k: KBoxed, c: f.name, ty: TyOpen } }
}

fn bind_word(em: Em, v: V) -> Out = {
  let w = word_of(em, v);
  let f = fresh(w.em);
  { em: line(f.em, bytes_concat_all([b"Word ", f.name, b" = ", w.c, b";"])),
    v: { k: KBoxed, c: f.name, ty: TyOpen } }
}

// A word a callee is about to take, held once more first: a callee that takes
// will release, and the duplicate is what puts the count back. A scalar is an
// immediate and holds no count, so there is nothing to take.
fn owned(em: Em, v: V) -> Out = {
  let spend = if em.release { spendable(em, v.c) } else { is_made(em, v.c) };
  let w = bind_word(if spend { spend_made(em, v.c) } else { em }, v);
  match v.k {
    KBoxed -> if spend { if em.release { { em: line(w.em, bytes_concat_all([v.c, b" = 0;"])), v: w.v } } else { w } }
              else if em.release && answers_owned(em, v.c) { w }
              else { { em: line(w.em, bytes_concat_all([b"ply_inc(", w.v.c, b");"])), v: w.v } },
    _ -> w,
  }
}

// The check after any helper that can raise: a body that failed answers nothing.
fn check(em: Em) -> Em =
  match em.landing {
    None -> line(em, b"if (ctx->failed) return 0;"),
    // Inside a `handle` body a failing call lands at the handle, which pops its frame, passes
    // an error on, and catches an unwind aimed at it.
    Some(l) -> line(em, bytes_concat_all([b"if (ctx->failed) goto ", l, b";"])),
  }

// A word as the sixty-four bits inside it, which is where integer arithmetic
// happens. Already-`Int` values are themselves.
fn as_int(v: V) -> Bytes =
  match v.k {
    KInt -> v.c,
    KBool -> v.c,
    KNum(_) -> bytes_concat_all([b"(int64_t)(", v.c, b")"]),
    KBoxed -> bytes_concat_all([b"(ply_is_imm(", v.c, b") ? ply_imm_value(", v.c,
                                b") : rt_unbox_int_p(ctx, ", v.c, b"))"]),
  }

// The other direction, for a value leaving the body.
// A field's index is its place among the record's names *sorted*, which is the
// order the checker settles on -- `{ z: Int, a: Int }` reads `.z` at 1. Nothing
// is sorted to answer that: the index is how many of the names sort below it.
// The one release this port makes: a record read to its last use gives its
// memory back through a reuse token of its width.
//
// The guards are the reference's, and each of them is there because leaving it
// out broke the self-hosted front end. The base must be a *bare variable* marked
// as its own last use, and the object must have exactly one name reading it --
// counted over the whole body, because the emitter does not visit reads in the
// order the lowering marked them, and a body that hands a record on and also
// reads a field of it would otherwise release at whichever read came second and
// read the freed record through the other.
fn release_base(em: Em, base: Code, b: V, params: List<P>) -> Option<Em> =
  release_from(em, base, b, params, false)

// `at_tail` is the reference's `Site::TailUpdate`: it skips the one-read guard,
// because nothing is emitted after the node and the later read that guard exists
// to protect against cannot be there.
fn release_from(em: Em, base: Code, b: V, params: List<P>, at_tail: Bool) -> Option<Em> =
  if em.release {
    if base_owned(base) && spendable(em, b.c) { Some(release_holder(spend_made(em, b.c), b)) } else { Some(em) }
  } else {
  match base.own {
    Owned -> match base.node {
      NVar(v) -> match v.slot {
        None -> Some(em),
        // At most once per binding -- keyed on the object the local holds, as the reference
        // keys it, so a name each arm of a `match` binds afresh releases in each -- and only
        // where the binding is read once.
        Some(_) -> if (!at_tail && reads_of_root(em, b.c) != 1)
                      || fold(em.released, false, |acc: Bool, r: Bytes| acc || r == root_of(em, b.c)) { Some(em) }
                   else {
          let em = note_released(em, root_of(em, b.c));
          // A record held back dies without ever having been built, and holds no counts; guarded
          // rather than skipped, because another path may have wanted the word and built it.
          match deferred_of(em, b.c) {
            Some(d) -> Some(line(note_tok(em, d.n), bytes_concat_all([
              b"if (", b.c, b") { if (tok", num(d.n), b" == 0) { tok", num(d.n), b" = ply_reset_flat(", b.c,
              b"); if (!tok", num(d.n), b") tok", num(d.n), b" = rt_reset_p(ctx, ", b.c, b"); } else { ply_dec(ctx, ",
              b.c, b"); } ", b.c, b" = 0; }"]))),
            None -> match width_of(b.ty) {
            None -> Some(line(em, bytes_concat_all([b"ply_dec(ctx, ", as_word(b), b");"]))),
            Some(n) -> { let em = note_tok(em, n);
                       Some(line(em, bytes_concat_all([
              b"if (tok", num(n), b" == 0) { tok", num(n), b" = ply_reset_flat(", as_word(b),
              b"); if (!tok", num(n), b") tok", num(n), b" = rt_reset_p(ctx, ", as_word(b),
              b"); } else { ply_dec(ctx, ", as_word(b), b"); }"]))) },
          } }
        },
      },
      _ -> Some(em),
    },
    _ -> Some(em),
  } }

// A base a slot names, at the read the lowering marked its last use.
fn base_owned(base: Code) -> Bool =
  match base.own {
    Owned -> match base.node { NVar(v) -> v.slot != None, _ -> false },
    _ -> false,
  }

// A holder's count let go, its cells kept as a reuse token where the shape is known, and the
// local nulled so the scope's release passes it by.
fn release_holder(em: Em, b: V) -> Em =
  match deferred_of(em, b.c) {
    Some(d) -> line(note_tok(em, d.n), bytes_concat_all([
      b"if (", b.c, b") { if (tok", num(d.n), b" == 0) { tok", num(d.n), b" = ply_reset_flat(", b.c,
      b"); if (!tok", num(d.n), b") tok", num(d.n), b" = rt_reset_p(ctx, ", b.c, b"); } else { ply_dec(ctx, ",
      b.c, b"); } ", b.c, b" = 0; }"])),
    None -> match width_of(b.ty) {
      None -> line(em, bytes_concat_all([b"ply_dec(ctx, ", b.c, b"); ", b.c, b" = 0;"])),
      Some(n) -> line(note_tok(em, n), bytes_concat_all([
        b"if (tok", num(n), b" == 0) { tok", num(n), b" = ply_reset_flat(", b.c,
        b"); if (!tok", num(n), b") tok", num(n), b" = rt_reset_p(ctx, ", b.c,
        b"); } else { ply_dec(ctx, ", b.c, b"); } ", b.c, b" = 0;"])),
    },
  }

// A field forwarded from the values a record was built of, when the record itself is about to
// be released: held once more first, as `rt_field` moves a field out before it lets the base go.
fn secure_field(em: Em, base: Code, b: V, v: V) -> Out =
  if !em.release || v.k != KBoxed || !base_owned(base) || !spendable(em, b.c) { { em: em, v: v } } else {
    let t = bind_word_of(em, v.c);
    { em: note_made(line(t.em, bytes_concat_all([b"ply_inc(", t.v.c, b");"])), t.v.c),
      v: { k: KBoxed, c: t.v.c, ty: v.ty } }
  }

fn through_caps(reads: List<Int>, caps: List<Cap>) -> List<Int> =
  fold(reads, [], |acc: List<Int>, s: Int|
    match fold(caps, None, |found: Option<Int>, c2: Cap| if c2.dst == s { Some(c2.src) } else { found }) {
      Some(src) -> push(acc, src),
      None -> acc,
    })

// Every slot read in the tree, once per read, lambdas and clause bodies
// included: a name a barrier copies in is still a read of the object.
fn slots_read(c: Code) -> List<Int> =
  match c.node {
    NVar(v) -> match v.slot { Some(s) -> [s], None -> [] },
    NLit(_) -> [],
    NUnary(u) -> slots_read(u.operand),
    NBinary(b) -> concat(slots_read(b.lhs), slots_read(b.rhs)),
    NField(f) -> slots_read(f.base),
    NApp(a) -> concat(slots_read(a.func), all_read(a.args)),
    NIf(i) -> concat(slots_read(i.cond),
                     concat(slots_read(i.then_branch), slots_read(i.else_branch))),
    NBlock(b) -> concat(
      fold(b.stmts, [], |acc: List<Int>, st: CStmt| concat(acc, match st {
        CLet(l) -> slots_read(l.value),
        CLetPat(l) -> slots_read(l.value),
        CDo(d) -> slots_read(d.code),
      })),
      match b.tail { Some(t) -> slots_read(t), None -> [] }),
    NList(l) -> all_read(l.items),
    NRecord(r) -> all_read(map(r.fields, |f: CField| f.value)),
    NMatch(m) -> concat(slots_read(m.scrutinee),
      fold(m.arms, [], |acc: List<Int>, a: CArm| concat(acc, concat(
        match a.guard { Some(g) -> slots_read(g), None -> [] }, slots_read(a.body))))),
    NUpd(u) -> concat(slots_read(u.base), all_read(map(u.sets, |f: CField| f.value))),
    NPerform(p) -> all_read(p.args),
    NCell(c2) -> concat(slots_read(c2.init), slots_read(c2.body)),
    NRegion(r) -> slots_read(r.body),
    // A lambda's body reads in a window of its own: a read of a capture there is a read of
    // the object it copies, in the enclosing window's numbering, and a read of the lambda's
    // own parameter is of nothing here. The copy itself is not a read.
    NLambda(l) -> through_caps(slots_read(l.body), l.caps),
    NSim(x) -> concat(map(x.caps, |c2: Cap| c2.src), slots_read(x.body)),
    NHandle(h) -> concat(slots_read(h.body), concat(
      fold(h.clauses, [], |acc: List<Int>, cl: CClause|
        concat(acc, through_caps(slots_read(cl.body), cl.caps))),
      match h.ret { Some(r) -> through_caps(slots_read(r.body), r.caps), None -> [] })),
  }

fn all_read(xs: List<Code>) -> List<Int> =
  fold(xs, [], |acc: List<Int>, x: Code| concat(acc, slots_read(x)))

fn concat(a: List<Int>, b: List<Int>) -> List<Int> =
  fold(b, a, |acc: List<Int>, x: Int| push(acc, x))

// The shape's index in this body's own table, added on first use. A body names
// the unit's tables by its own positions, which is what makes one body's text
// comparable at all.
fn opaque_from_table(em: Em, l: Lit) -> Out = {
  let o = from_table(em, l);
  { em: o.em, v: { k: KBoxed, c: o.v.c, ty: TyOpaque } }
}

fn from_table(em: Em, l: Lit) -> Out = {
  let c = const_of(em, l);
  let o = bind(c.em, KBoxed, bytes_concat_all([b"rt_lit_p(ctx, @@c", num(c.i), b"@@)"]));
  { em: check(o.em), v: o.v }
}

// Every occurrence takes the next index, and two occurrences of one literal do
// **not** share one. A shape is interned and a constant is not, which reads as an
// inconsistency and is what the reference does: `ledger.journal` writes the same
// literal twice and the two are `@@c2@@` and `@@c4@@`.
fn const_of(em: Em, l: Lit) -> { em: Em, i: Int } =
  { em: { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads,
          shapes: em.shapes, built: em.built, module: em.module, made: em.made,
          here: em.here, imports: em.imports, consts: push(em.consts, l), ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner, builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound },
    i: len(em.consts) }

// A capital first letter, after any module binder.
// The tag a constructor takes: its position in the table, found by the name the
// occurrence wrote. A bare name is this module's; a qualified one names another.
// A constructor's tag: the module's own, a qualified one, or one an import brought in bare.
fn tag_of(em: Em, name: Bytes) -> Option<Int> = {
  let want = match qualified(name) {
    Some(q) -> match from_import(em.imports, q.binder) {
      Some(imp) -> bytes_concat_all([imp.module, b".", q.name]),
      None -> bytes_concat_all([b"std.", q.binder, b".", q.name]),
    },
    None -> bytes_concat_all([em.module, b".", name]),
  };
  match ctor_index(em.ctors, want, name) {
    Some(t) -> Some(t),
    None -> fold(em.imports, None, |acc: Option<Int>, imp: Imported| match acc {
      Some(_) -> acc,
      None -> ctor_index(em.ctors, bytes_concat_all([imp.module, b".", name]), b""),
    }),
  }
}

fn ctor_index(ctors: List<Bytes>, want: Bytes, bare: Bytes) -> Option<Int> =
  fold(range(0, len(ctors)), None, |acc: Option<Int>, i: Int|
    match list_at(ctors, i) {
      Some(c) -> if c == want || (bare != b"" && c == bare) { Some(i) } else { acc },
      None -> acc,
    })

fn is_ctor_name(name: Bytes) -> Bool = {
  let bare = match qualified(name) { Some(q) -> q.name, None -> name };
  bytes_len(bare) > 0 && bytes_at(bare, 0) >= 65 && bytes_at(bare, 0) <= 90
}

fn last_segment(path: List<Ident>) -> Bytes =
  match list_at(path, len(path) - 1) { Some(i) -> i.name, None -> b"" }

// `binder::name` split at the first `::`, when there is one.
fn qualified(name: Bytes) -> Option<{ binder: Bytes, name: Bytes }> =
  fold(range(0, bytes_len(name) - 1), None, |acc: Option<{ binder: Bytes, name: Bytes }>, i: Int|
    match acc {
      Some(_) -> acc,
      None -> if bytes_at(name, i) == 58 && bytes_at(name, i + 1) == 58 {
        Some({ binder: bytes_slice(name, 0, i), name: bytes_slice(name, i + 2, bytes_len(name)) })
      } else { None },
    })

fn from_import(xs: List<Imported>, name: Bytes) -> Option<Imported> =
  fold(xs, None, |acc: Option<Imported>, i: Imported|
    if i.name == name { Some(i) } else { acc })

fn opened_to(em: Em, v: V, d: { k: Option<Kind>, ty: Ty }) -> Out =
  match d.k {
    Some(KInt) -> bind(em, KInt, as_int(v)),
    Some(KBool) -> bind(em, KBool, as_bool(v)),
    Some(KNum(w)) -> bind(em, KNum(w), as_num(v, w)),
    // A word, but not a shapeless one: the callee's declared type says what it
    // holds, and a field read of it can then be a load rather than a search.
    _ -> { em: em, v: { k: v.k, c: v.c, ty: d.ty } },
  }

fn ret_of(here: List<Def>, name: Bytes) -> { k: Option<Kind>, ty: Ty } =
  fold(here, { k: None, ty: TyOpen }, |acc: { k: Option<Kind>, ty: Ty }, d: Def|
    if d.name == name { { k: d.ret, ty: d.ret_ty } } else { acc })

// A nullary name the constant table answers: a definition of this module or of an imported one,
// published pure, whose declared return is a word. The program-wide name and the type it answers.
fn constant_of(em: Em, name: Bytes) -> Option<{ full: Bytes, ty: Ty }> =
  if fold(em.here, false, |acc: Bool, h: Def| acc || h.name == name) {
    if is_pure(em.here, name) && ret_of(em.here, name).k == Some(KBoxed)
    { Some({ full: bytes_concat_all([em.module, b".", name]), ty: ret_of(em.here, name).ty }) } else { None }
  } else {
    let callee = match qualified(name) { Some(q) -> q.name, None -> name };
    match match qualified(name) { Some(q) -> from_import(em.imports, q.binder), None -> from_import(em.imports, name) } {
      None -> None,
      Some(imp) -> if is_pure(imp.defs, callee) && ret_of(imp.defs, callee).k == Some(KBoxed)
        { Some({ full: bytes_concat_all([imp.module, b".", callee]), ty: ret_of(imp.defs, callee).ty }) } else { None },
    }
  }

fn is_pure(here: List<Def>, name: Bytes) -> Bool =
  fold(here, false, |acc: Bool, d: Def| if d.name == name { d.pure } else { acc })

// The builtins the reference does not simply call: four expanded in place around
// a load, and the joins, which it fuses over a list literal rather than building
// the list and joining it.
// `fold(xs, init, |a, x| ..)` with the callback written out: the reference runs
// the loop itself rather than handing the closure to `rt_fold`, so the closure is
// built, called once per element, and released at the end.
//
// The list is read through `rt_list_at_p` and its length through the *builtin*,
// not through the inline length beside it -- the fused loop asks the same
// question a different way, and matching means asking it the reference's way.
// A definition of arity two that `f` names directly, with the C function it became: a fold
// over one calls it straight, with no closure and no dispatch. The reference also asks
// whether the unit took the definition; a body naming one the unit does not hold is refused
// at the seam, so the answer here is the same.
fn nameable_step(em: Em, f: Code) -> Option<{ full: Bytes, c: Bytes }> =
  match f.node {
    NVar(fv) -> match fv.slot {
      Some(_) -> None,
      None -> match def_of(em, fv.name) {
        Some(d) -> if d.arity == 2 { Some({ full: d.full, c: d.c }) } else { None },
        None -> None,
      },
    },
    _ -> None,
  }

// The definition a bare or qualified name resolves to -- of this module, or brought in from
// another -- with its program-wide name, the C function it became, and its arity.
fn def_of(em: Em, name: Bytes) -> Option<{ full: Bytes, c: Bytes, arity: Int }> =
  if is_ctor_name(name) { None } else {
    let target = match qualified(name) {
      Some(q) -> match from_import(em.imports, q.binder) {
        Some(imp) -> Some({ module: imp.module, name: q.name, defs: imp.defs }),
        None -> None,
      },
      None -> if fold(em.here, false, |acc: Bool, h: Def| acc || h.name == name)
              { Some({ module: em.module, name: name, defs: em.here }) }
              else { match from_import(em.imports, name) {
                Some(imp) -> Some({ module: imp.module, name: name, defs: imp.defs }),
                None -> None,
              } },
    };
    match target {
      None -> None,
      Some(t) -> match fold(t.defs, None, |acc: Option<Def>, d: Def| if d.name == t.name { Some(d) } else { acc }) {
        Some(d) -> Some({ full: bytes_concat_all([t.module, b".", t.name]),
                          c: bytes_concat_all([b"ply_", mangle(t.module), b"_", t.name]), arity: d.arity }),
        None -> None,
      },
    }
  }

// `bytes_position(b, from, p)` is a loop over the bytes calling `p` until it answers `true`:
// through the runtime it suspends at the first call, which a native frame cannot resume, so
// under release the loop is emitted into the body. The reference calls the runtime, and the
// reference's text keeps that call.
fn position_call(em: Em, name: Bytes, args: List<Code>, params: List<P>) -> Option<Out> =
  if !em.release || name != b"bytes_position" || len(args) != 3 { None } else {
    match tag_of(em, b"Some") {
      None -> None,
      Some(some) -> match tag_of(em, b"None") {
        None -> None,
        Some(none) -> match list_at(args, 0) {
          None -> None,
          Some(b0) -> match list_at(args, 1) {
            None -> None,
            Some(f0) -> match list_at(args, 2) {
              None -> None,
              Some(p0) -> match expr(notail(em), b0, params) {
                None -> None,
                Some(bv) -> {
                  let bo = owned(bv.em, bv.v);
                  match expr(notail(bo.em), f0, params) {
                    None -> None,
                    Some(fv) -> {
                      let from = bind(fv.em, KInt, as_int(fv.v));
                      match expr(notail(from.em), p0, params) {
                        None -> None,
                        Some(pv) -> {
                          let po = owned(pv.em, pv.v);
                          let bi = builtin_of(po.em, b"bytes_position");
                          // A start past the end, or bytes that are not bytes: the runtime's own
                          // call raises the machine's diagnostic before it would suspend.
                          let guard = line(bi.em, bytes_concat_all([
                            b"if (ply_is_imm(", bo.v.c, b") || ply_obj(", bo.v.c, b")->kind != 10 || (uint64_t)", from.v.c,
                            b" > (uint64_t)ply_obj(", bo.v.c, b")->len) { Word a[3]; a[0] = ", bo.v.c, b"; a[1] = ply_imm(", from.v.c,
                            b"); a[2] = ", po.v.c, b"; rt_builtin_p(ctx, @@b", num(bi.i), b"@@, (Word)(intptr_t)a, 3); return 0; }"]));
                          let ans = fresh(guard);
                          let declared = line(ans.em, bytes_concat_all([b"Word ", ans.name, b" = rt_nullary_p(ctx, ", num(none), b");"]));
                          let i = bind(declared, KInt, from.v.c);
                          let head = indent(line(i.em, bytes_concat_all([
                            b"for (; ", i.v.c, b" < (int64_t)ply_obj(", bo.v.c, b")->len; ", i.v.c, b" += 1) {"])));
                          let arg = fresh(head);
                          let called = fresh(line(arg.em, bytes_concat_all([
                            b"Word ", arg.name, b"[] = { ply_imm((int64_t)((unsigned char *)ply_words(", bo.v.c, b"))[", i.v.c, b"]) }; ply_inc(", po.v.c, b");"])));
                          let asked = line(called.em, bytes_concat_all([
                            b"Word ", called.name, b" = rt_call_p(ctx, ", po.v.c, b", (Word)(intptr_t)", arg.name, b", 1);"]));
                          let hit = line(indent(line(check(asked), bytes_concat_all([b"if (rt_unbox_bool_p(ctx, ", called.name, b")) {"]))),
                            bytes_concat_all([b"Word w[] = { ply_imm(", i.v.c, b") }; ", ans.name, b" = rt_ctor_p(ctx, ", num(some), b", (Word)(intptr_t)w, 1);"]));
                          let stopped = line(outdent(line(check(hit), b"break;")), b"}");
                          let done = line(outdent(stopped), b"}");
                          let freed = line(line(done, bytes_concat_all([b"ply_dec(ctx, ", po.v.c, b");"])),
                                           bytes_concat_all([b"ply_dec(ctx, ", bo.v.c, b");"]));
                          Some({ em: note_holder(freed, ans.name), v: { k: KBoxed, c: ans.name, ty: TyOpen } })
                        },
                      }
                    },
                  }
                },
              },
            },
          },
        },
      },
    }
  }

// `iterate` over a one-parameter lambda is the loop the reference emits into the body, which
// this port has not read; over anything else it is the runtime's helper, as the reference
// calls it.
fn iterate_call(em: Em, name: Bytes, args: List<Code>, params: List<P>) -> Option<Out> =
  if name != b"iterate" || len(args) != 3 { None } else {
    match list_at(args, 2) {
      None -> None,
      Some(f) -> match f.node {
        NLambda(l) -> if l.params == 1 { fused_iterate(em, args, l, params) } else { helper_call(em, b"rt_iterate_p", args, params) },
        _ -> helper_call(em, b"rt_iterate_p", args, params),
      },
    }
  }

// `iterate` over a one-parameter lambda is the loop, emitted into the body rather than called
// through the runtime: `iterate` *is* the loop in this language, so a tier that sent it through
// a callback would be sending every loop through one. The lambda's body runs in a window of
// its own -- its parameter is the state, its captures are the values they copy -- and a body
// that answers `Stop` or `Continue` directly in every arm is written as the loop's own
// assignments; any other body is called and its answer's tag is tested.
fn fused_iterate(em: Em, args: List<Code>, l: { params: Int, size: Int, caps: List<Cap>, body: Code }, params: List<P>) -> Option<Out> =
  match tag_of(em, b"Stop") {
    None -> Some(refused(em, b"`iterate` with no `Stop` and `Continue` in the program")),
    Some(stop) -> match tag_of(em, b"Continue") {
      None -> Some(refused(em, b"`iterate` with no `Stop` and `Continue` in the program")),
      Some(go) -> match list_at(args, 0) {
        None -> None,
        Some(seed) -> match list_at(args, 1) {
          None -> None,
          Some(budget) -> match expr(notail(em), seed, params) {
            None -> None,
            Some(sv) -> {
              let sw = word_of(sv.em, sv.v);
              let state = fresh(sw.em);
              let s1 = assign_owned(line(state.em, bytes_concat_all([b"Word ", state.name, b" = ", sw.c, b";"])), state.name, sw.c);
              match expr(notail(s1), budget, params) {
                None -> None,
                Some(bv) -> {
                  let bud = as_int(bv.v);
                  let left = fresh(bv.em);
                  let s2 = line(left.em, bytes_concat_all([b"int64_t ", left.name, b" = ", bud, b";"]));
                  let answer = fresh(s2);
                  let s3 = line(answer.em, bytes_concat_all([b"Word ", answer.name, b" = 0;"]));
                  let opened = indent(line(s3, b"for (;;) {"));
                  let guarded = line(line(opened, bytes_concat_all([
                    b"if (", left.name, b" <= 0) { rt_iterate_bad_p(ctx, 0, ", bud, b"); return 0; }"])),
                    bytes_concat_all([left.name, b" -= 1;"]));
                  // The lambda's window: its captures as the values they copy, its parameter as
                  // the state, held under a name of its own.
                  match fold(l.caps, Some([]), |acc: Option<List<Conv>>, c: Cap| match acc {
                      None -> None,
                      Some(w) -> match conv_of(guarded, c.src) {
                        Some(v) -> Some(push(w, { slot: c.dst, k: v.k, c: v.c, ty: v.ty })),
                        None -> match list_at(params, c.src) {
                          Some(p) -> match p.k {
                            KBoxed -> Some(push(w, { slot: c.dst, k: KBoxed, c: bytes_concat(b"p", num(c.src)), ty: p.ty })),
                            _ -> None,
                          },
                          None -> None,
                        },
                      },
                    }) {
                    None -> Some(refused(em, b"a capture this port has not bound")),
                    Some(window) -> {
                      // The body's counts are the lambda's own: its parameter's reads are of the
                      // state, and a capture's were charged to its object outside.
                      // Everything held outside the loop is pinned: the body reads it as often as
                      // the loop runs. The state's rename is the iteration's own holder.
                      let held = bind_keeping(with_reads(rescope(pin_all(guarded), window), slots_read(l.body)), KBoxed, sv.v.ty, state.name);
                      let inner = remember(note_holder(held.em, held.v.c), 0, held.v);
                      let body = if fusable_step(inner, l.body) {
                        emit_step(inner, l.body, state.name, answer.name, stop, go, params, inner.ind)
                      } else {
                        match expr(inner, l.body, params) {
                          None -> None,
                          Some(r) -> {
                            let rw = word_of(r.em, r.v);
                            let sa = bind(rw.em, KBoxed, rw.c);
                            let k = fresh(sa.em);
                            let t1 = line(k.em, bytes_concat_all([
                              b"uint32_t ", k.name, b" = (!ply_is_imm(", sa.v.c, b") && ", sa.v.c, b" != 0 && ply_obj(", sa.v.c,
                              b")->kind == 4 && ply_obj(", sa.v.c, b")->len == 1) ? ply_obj(", sa.v.c, b")->layout : 0xFFFFFFFFu;"]));
                            let t2 = line(indent(line(t1, bytes_concat_all([b"if (", k.name, b" == ", num(stop), b"u) {"]))),
                              bytes_concat_all([answer.name, b" = ply_words(", sa.v.c, b")[0];"]));
                            let t3 = line(release_at(line(t2, bytes_concat_all([b"ply_inc(", answer.name, b");"])), inner.ind), b"break;");
                            let t4 = line(indent(line(outdent(t3), bytes_concat_all([b"} else if (", k.name, b" == ", num(go), b"u) {"]))),
                              bytes_concat_all([state.name, b" = ply_words(", sa.v.c, b")[0];"]));
                            let t5 = line(t4, bytes_concat_all([b"ply_inc(", state.name, b");"]));
                            let t6 = line(indent(line(outdent(t5), b"} else {")),
                              bytes_concat_all([b"rt_iterate_bad_p(ctx, 2, ", sa.v.c, b"); return 0;"]));
                            Some(line(outdent(t6), b"}"))
                          },
                        }
                      };
                      match body {
                        None -> None,
                        Some(done) -> Some({ em: note_holder(with_pinned(close(with_reads(rescope(done, guarded.conv), em.reads)), em.pinned), answer.name),
                                             v: { k: KBoxed, c: answer.name, ty: TyOpen } }),
                      }
                    },
                  }
                },
              }
            },
          },
        },
      },
    },
  }

// A step body that answers `Stop` or `Continue` directly in every arm.
fn fusable_step(em: Em, c: Code) -> Bool =
  match c.node {
    NApp(a) -> len(a.args) == 1 && match a.func.node {
      NVar(fv) -> match fv.slot {
        Some(_) -> false,
        None -> is_ctor_name(fv.name) && match tag_of(em, fv.name) {
          Some(t) -> Some(t) == tag_of(em, b"Stop") || Some(t) == tag_of(em, b"Continue"),
          None -> false,
        },
      },
      _ -> false,
    },
    NIf(i) -> fusable_step(em, i.then_branch) && fusable_step(em, i.else_branch),
    NBlock(b) -> match b.tail { Some(t) -> fusable_step(em, t), None -> false },
    _ -> false,
  }

// The loop's own assignments for a step that answers a constructor directly: `Stop(x)` sets the
// answer and breaks, `Continue(x)` sets the state.
fn emit_step(em: Em, c: Code, state: Bytes, answer: Bytes, stop: Int, go: Int, params: List<P>, depth: Int) -> Option<Em> =
  match c.node {
    NApp(a) -> match list_at(a.args, 0) {
      None -> None,
      Some(x) -> match expr(notail(em), x, params) {
        None -> None,
        Some(v) -> {
          let w = word_of(v.em, v.v);
          let which = match a.func.node { NVar(fv) -> tag_of(em, fv.name), _ -> None };
          if which == Some(stop) {
            // The loop's holders go before the `break` leaves their block.
            Some(line(release_at(assign_owned(line(w.em, bytes_concat_all([answer, b" = ", w.c, b";"])), answer, w.c), depth), b"break;"))
          } else {
            Some(assign_owned(line(w.em, bytes_concat_all([state, b" = ", w.c, b";"])), state, w.c))
          }
        },
      },
    },
    NIf(i) -> match expr(notail(em), i.cond, params) {
      None -> None,
      Some(cv) -> {
        let opened = indent(line(cv.em, bytes_concat_all([b"if (", as_bool(cv.v), b") {"])));
        match emit_step(opened, i.then_branch, state, answer, stop, go, params, depth) {
          None -> None,
          Some(t) -> {
            let t2 = release_at(t, t.ind);
            let els = with_made(indent(line(outdent(t2), b"} else {")), opened.made);
            match emit_step(els, i.else_branch, state, answer, stop, go, params, depth) {
              None -> None,
              Some(e) -> { let e2 = close(e); Some(with_made(e2, union_made(t2.made, e2.made))) },
            }
          },
        }
      },
    },
    NBlock(b) -> match b.tail {
      None -> None,
      Some(t) -> match stmts(em, b.stmts, params, 0) {
        None -> None,
        Some(after) -> emit_step(rescope(after, after.conv), t, state, answer, stop, go, params, depth),
      },
    },
    _ -> None,
  }

fn helper_call(em: Em, helper: Bytes, args: List<Code>, params: List<P>) -> Option<Out> =
  match args_one_pass(em, args, params, 0, []) {
    None -> None,
    Some(w) -> {
      let o = bind(w.em, KBoxed, bytes_concat_all([helper, b"(ctx",
        fold(w.names, b"", |acc: Bytes, nm: Bytes| bytes_concat_all([acc, b", ", nm])), b")"]));
      Some({ em: check(o.em), v: o.v })
    },
  }

fn fused_fold(em: Em, name: Bytes, args: List<Code>, params: List<P>) -> Option<Out> =
  if name != b"fold" || len(args) != 3 { None } else {
    match list_at(args, 2) {
      None -> None,
      Some(f) -> match list_at(args, 0) {
          None -> None,
          Some(xs) -> match list_at(args, 1) {
            None -> None,
            Some(init) -> match expr(notail(em), xs, params) {
              None -> None,
              Some(lv) -> {
                let lo = owned(lv.em, lv.v);
                let arr = fresh(lo.em);
                let cnt = line(arr.em, bytes_concat_all([
                  b"Word ", arr.name, b"[1] = {", lo.v.c, b"}; ply_inc(", arr.name, b"[0]);"]));
                let bi = builtin_of(cnt, b"len");
                let raw = bind(bi.em, KBoxed, bytes_concat_all([
                  b"rt_builtin_p(ctx, @@b", num(bi.i), b"@@, (Word)(intptr_t)", arr.name, b", 1)"]));
                let n = bind(check(raw.em), KInt, as_int(raw.v));
                // A function the unit compiled is called straight, per element. Anything else
                // is held as a value, evaluated once outside the loop rather than per element:
                // `rt_call` takes its callee, so each iteration hands it a count of its own and
                // the loop lets go of the last one at the end.
                let step = nameable_step(n.em, f);
                // The reference builds the closure before it evaluates the seed; the machine
                // evaluates the seed first, and under release the order is the machine's: a
                // capture the closure takes at its last use is null once the closure is built.
                let ordered = if n.em.release {
                  match expr(notail(n.em), init, params) {
                    None -> None,
                    Some(iv) -> {
                      let acc = owned(iv.em, iv.v);
                      match step {
                        Some(_) -> Some({ em: acc.em, co: { k: KBoxed, c: b"", ty: TyOpen }, acc: acc.v }),
                        None -> match expr(notail(acc.em), f, params) {
                          None -> None,
                          Some(cl) -> { let held = owned(cl.em, cl.v); Some({ em: held.em, co: held.v, acc: acc.v }) },
                        },
                      }
                    },
                  }
                } else {
                  let held = match step {
                    Some(_) -> Some({ em: n.em, v: { k: KBoxed, c: b"", ty: TyOpen } }),
                    None -> match expr(notail(n.em), f, params) {
                      None -> None,
                      Some(cl) -> Some(owned(cl.em, cl.v)),
                    },
                  };
                  match held {
                    None -> None,
                    Some(co) -> match expr(notail(co.em), init, params) {
                      None -> None,
                      // The accumulator's word, *not* held once more: the loop hands it to the
                      // closure and takes back what the closure answers, so the count it starts
                      // with is the one it ends with.
                      Some(iv) -> { let acc = bind_word(iv.em, iv.v); Some({ em: acc.em, co: co.v, acc: acc.v }) },
                    },
                  }
                };
                match ordered {
                  None -> None,
                  Some(ord) -> {
                    let co = { em: ord.em, v: ord.co };
                    let acc = { em: ord.em, v: ord.acc };
                    {
                      let i = bind(acc.em, KInt, b"0");
                      let head = line(i.em, bytes_concat_all([
                        b"for (; ", i.v.c, b" < ", n.v.c, b"; ", i.v.c, b" += 1) {"]));
                      let at = bind(indent(head), KBoxed, bytes_concat_all([
                        b"rt_list_at_p(ctx, ", lo.v.c, b", ", i.v.c, b")"]));
                      let call = match step {
                        Some(d) -> line(note_call(check(at.em), d.full), bytes_concat_all([
                          acc.v.c, b" = ", d.c, b"(ctx, ", acc.v.c, b", ", at.v.c, b");"])),
                        None -> {
                          let a2 = fresh(check(at.em));
                          line(
                            line(line(a2.em, bytes_concat_all([
                              b"Word ", a2.name, b"[] = {", acc.v.c, b", ", at.v.c, b"};"])),
                              bytes_concat_all([b"ply_inc(", co.v.c, b");"])),
                            bytes_concat_all([acc.v.c, b" = rt_call_p(ctx, ", co.v.c,
                                              b", (Word)(intptr_t)", a2.name, b", 2);"]))
                        },
                      };
                      // The call took the element.
                      let done = close(check(spend_made(call, at.v.c)));
                      let freed = match step {
                        Some(_) -> done,
                        None -> line(done, bytes_concat_all([b"ply_dec(ctx, ", co.v.c, b");"])),
                      };
                      Some({ em: note_holder(line(freed, bytes_concat_all([b"ply_dec(ctx, ", lo.v.c, b");"])), acc.v.c),
                             v: acc.v })
                    }
                  }
                }
              },
            },
          },
      },
    }
  }

// The builtins the reference expands in place where the declaration fixes the
// kind: with nothing to test, a length is the header's own field and a byte is a
// bounds test around a load, with the runtime call as the out-of-range arm.
//
// `bytes_u32_le` is the fourth of the family and is not here: it reads four bytes
// through a `memcpy` and answers a `U32`, which is a width this port has no kind
// for.
fn inline_len(em: Em, name: Bytes, args: List<Code>, params: List<P>) -> Option<Out> =
  if name == b"bytes_at" && len(args) == 2 { inline_at(em, args, params, false) }
  else if name == b"bytes_u32_le" && len(args) == 2 { inline_at(em, args, params, true) }
  else if name == b"bytes_concat_all" && len(args) == 1 { inline_join(em, args, params) }
  else if len(args) != 1 { None }
  else if name != b"len" && name != b"bytes_len" { None }
  else { match list_at(args, 0) {
    None -> None,
    Some(x) -> match expr(notail(em), x, params) {
      None -> None,
      Some(o) -> {
        let fits = match o.v.ty {
          TyList -> name == b"len",
          TyBytes -> name == b"bytes_len",
          _ -> false,
        };
        if !fits { Some(kind_tested(o.em, name, o.v, None)) } else {
          let t = bind(o.em, KBoxed, as_word(o.v));
          Some(bind(t.em, KInt, bytes_concat_all([b"(int64_t)ply_obj(", t.v.c, b")->len"])))
        }
      },
    },
  } }

fn is_wrap(name: Bytes) -> Bool =
  name == b"wrap_add" || name == b"wrap_sub" || name == b"wrap_mul" || name == b"rotr"

// `u8_of_int` and the seven beside it, by the width they convert into.
fn of_int_width(name: Bytes) -> Option<Width> =
  if name == b"u8_of_int" { width_named(b"U8") } else if name == b"u16_of_int" { width_named(b"U16") }
  else if name == b"u32_of_int" { width_named(b"U32") } else if name == b"u64_of_int" { width_named(b"U64") }
  else if name == b"i8_of_int" { width_named(b"I8") } else if name == b"i16_of_int" { width_named(b"I16") }
  else if name == b"i32_of_int" { width_named(b"I32") } else if name == b"i64_of_int" { width_named(b"I64") }
  else { None }

// `int_of_u8` and the seven beside it, by the width they convert from.
fn int_of_width(name: Bytes) -> Option<Width> =
  if name == b"int_of_u8" { width_named(b"U8") } else if name == b"int_of_u16" { width_named(b"U16") }
  else if name == b"int_of_u32" { width_named(b"U32") } else if name == b"int_of_u64" { width_named(b"U64") }
  else if name == b"int_of_i8" { width_named(b"I8") } else if name == b"int_of_i16" { width_named(b"I16") }
  else if name == b"int_of_i32" { width_named(b"I32") } else if name == b"int_of_i64" { width_named(b"I64") }
  else { None }

// The wrapping arithmetic and the conversions over a carried width, in place; over a
// sixty-four-bit width or an operand of no width, the runtime's call over the values already
// evaluated, as the reference falls back.
fn width_builtin(em: Em, name: Bytes, args: List<Code>, params: List<P>) -> Option<Out> =
  if !((is_wrap(name) && len(args) == 2) || ((of_int_width(name) != None || int_of_width(name) != None) && len(args) == 1)) { None } else {
    match args_evaled(em, args, params, 0, []) {
      None -> None,
      Some(e) -> match list_at(e.vals, 0) {
        None -> None,
        Some(v0) ->
          if is_wrap(name) {
            match v0.k {
              KNum(t) -> match list_at(e.vals, 1) {
                None -> None,
                Some(v1) -> {
                  let u = utype(t);
                  let a = as_num(v0, t);
                  if name == b"rotr" {
                    let n = as_int(v1);
                    let k = bind(e.em, KInt, bytes_concat_all([b"((", n, b") % ", num(t.bits), b" + ", num(t.bits), b") % ", num(t.bits)]));
                    Some(bind(k.em, KNum(t), bytes_concat_all([
                      b"(", u, b")(", k.v.c, b" == 0 ? (", u, b")(", a, b") : ((", u, b")(", a, b") >> ", k.v.c,
                      b") | ((", u, b")(", a, b") << (", num(t.bits), b" - ", k.v.c, b")))"])))
                  } else {
                    let n = as_num(v1, t);
                    let c = if name == b"wrap_add" { b"+" } else if name == b"wrap_sub" { b"-" } else { b"*" };
                    Some(bind(e.em, KNum(t), bytes_concat_all([b"(", u, b")((", u, b")(", a, b") ", c, b" (", u, b")(", n, b"))"])))
                  }
                },
              },
              _ -> Some(builtin_call(e.em, name, e.vals)),
            }
          } else { match of_int_width(name) {
            Some(t) -> if carried(t) {
              let held = bind(e.em, KInt, as_int(v0));
              let g = line(held.em, bytes_concat_all([b"if (", held.v.c, b" < ", int_lit(width_min(t)), b" || ",
                held.v.c, b" > ", int_lit(width_max(t)), b") { rt_not_that_width_p(ctx, ", num(width_index(t)), b", ",
                held.v.c, b"); return 0; }"]));
              Some(bind(g, KNum(t), bytes_concat_all([b"(", ctype(KNum(t)), b")", held.v.c])))
            } else { Some(builtin_call(e.em, name, e.vals)) },
            None -> match int_of_width(name) {
              Some(t) -> if carried(t) { Some(bind(e.em, KInt, as_int(v0))) } else { Some(builtin_call(e.em, name, e.vals)) },
              None -> None,
            },
          } },
      },
    }
  }

// `len`, `bytes_len` or `bytes_at` over a value whose kind the declaration does not fix: a
// kind test, with the header's own field (or the byte, under a bounds test) in the fast arm
// and the runtime's call in the slow one -- which is where a value of the wrong kind is
// caught, with the interpreter's own diagnostic.
fn kind_tested(em: Em, name: Bytes, v: V, index: Option<V>) -> Out = {
  let t = bind(em, KBoxed, as_word(v));
  let out = fresh(t.em);
  let o1 = line(out.em, bytes_concat_all([b"int64_t ", out.name, b" = 0;"]));
  let ok = fresh(o1);
  let kind = if name == b"len" { b"5" } else { b"10" };
  let o2 = line(ok.em, bytes_concat_all([b"int ", ok.name, b" = (!ply_is_imm(", t.v.c, b") && ",
    t.v.c, b" != 0 && ply_obj(", t.v.c, b")->kind == ", kind, b");"]));
  let body = match index {
    Some(iv) -> {
      let idx = bind(o2, KInt, as_int(iv));
      let opened = line(idx.em, bytes_concat_all([b"if (", ok.name, b" && (uint64_t)", idx.v.c,
        b" < (uint64_t)ply_obj(", t.v.c, b")->len) { ", out.name,
        b" = (int64_t)((unsigned char *)ply_words(", t.v.c, b"))[", idx.v.c, b"]; } else {"]));
      let bi = builtin_of(indent(opened), name);
      let a0 = fresh(bi.em);
      line(line(line(line(line(line(a0.em,
        bytes_concat_all([b"Word ", a0.name, b"[2];"])),
        bytes_concat_all([a0.name, b"[0] = ", t.v.c, b"; ply_inc(", a0.name, b"[0]);"])),
        bytes_concat_all([a0.name, b"[1] = (ply_fits_imm(", idx.v.c, b") ? ply_imm(", idx.v.c,
                          b") : rt_box_int_p(ctx, ", idx.v.c, b"));"])),
        bytes_concat_all([b"Word r = rt_builtin_p(ctx, @@b", num(bi.i), b"@@, (Word)(intptr_t)", a0.name, b", 2);"])),
        b"if (ctx->failed) return 0;"),
        bytes_concat_all([out.name, b" = ply_imm_value(r);"]))
    },
    None -> {
      let opened = line(o2, bytes_concat_all([b"if (", ok.name, b") { ", out.name,
        b" = (int64_t)ply_obj(", t.v.c, b")->len; } else {"]));
      let bi = builtin_of(indent(opened), name);
      let a0 = fresh(bi.em);
      line(line(line(line(line(a0.em,
        bytes_concat_all([b"Word ", a0.name, b"[1];"])),
        bytes_concat_all([a0.name, b"[0] = ", t.v.c, b"; ply_inc(", a0.name, b"[0]);"])),
        bytes_concat_all([b"Word r = rt_builtin_p(ctx, @@b", num(bi.i), b"@@, (Word)(intptr_t)", a0.name, b", 1);"])),
        b"if (ctx->failed) return 0;"),
        bytes_concat_all([out.name, b" = ply_imm_value(r);"]))
    },
  };
  { em: close(body), v: { k: KInt, c: out.name, ty: TyOpen } }
}

// `bytes_concat_all([a, b, ..])` joins the pieces without building the list; over anything
// else it is the runtime's call.
fn inline_join(em: Em, args: List<Code>, params: List<P>) -> Option<Out> =
  match list_at(args, 0) {
    None -> None,
    Some(x) -> match x.node {
      NList(l) -> match items(em, l.items, params, 0, []) {
        None -> None,
        Some(w) -> {
          let arr = fresh(w.em);
          let e = line(arr.em, bytes_concat_all([b"Word ", arr.name, b"[] = {",
            if len(w.names) == 0 { b"0" } else { bytes_join(w.names, b", ") }, b"};"]));
          let o = bind(e, KBoxed, bytes_concat_all([b"rt_bytes_join_p(ctx, (Word)(intptr_t)",
            arr.name, b", ", num(len(l.items)), b")"]));
          Some({ em: check(o.em), v: o.v })
        },
      },
      _ -> match expr(notail(em), x, params) {
        None -> None,
        Some(o) -> Some(builtin_call(o.em, b"bytes_concat_all", [o.v])),
      },
    },
  }

// `bytes_at` and `bytes_u32_le` share everything but their width: one byte read
// with a bounds test, or four read through a `memcpy` -- which is how a C
// compiler is told to emit an unaligned load, and lowers to one instruction
// rather than a call. Over bytes the declaration does not fix, the runtime's call.
fn inline_at(em: Em, args: List<Code>, params: List<P>, wide: Bool) -> Option<Out> =
  match list_at(args, 0) {
    None -> None,
    Some(b0) -> match list_at(args, 1) {
      None -> None,
      Some(i0) -> match expr(notail(em), b0, params) {
        None -> None,
        Some(bv) -> match expr(notail(bv.em), i0, params) {
          None -> None,
          // The kind-tested arm reads one byte; `bytes_u32_le` over bytes the declaration does
          // not fix is the runtime's call, which reads four.
          Some(iv) -> if bv.v.ty != TyBytes {
            if wide { Some(builtin_call(iv.em, b"bytes_u32_le", [bv.v, iv.v])) }
            else { Some(kind_tested(iv.em, b"bytes_at", bv.v, Some(iv.v))) }
          } else {
            let t = bind(iv.em, KBoxed, as_word(bv.v));
            let idx = bind(t.em, KInt, as_int(iv.v));
            let bi = builtin_of(idx.em, if wide { b"bytes_u32_le" } else { b"bytes_at" });
            let g = line(bi.em, bytes_concat_all([
              b"if ((uint64_t)", idx.v.c, if wide { b" + 4 > " } else { b" >= " },
              b"(uint64_t)ply_obj(", t.v.c,
              b")->len) { Word a[2]; a[0] = ", t.v.c, b"; ply_inc(a[0]); a[1] = ply_imm(",
              idx.v.c, b"); rt_builtin_p(ctx, @@b", num(bi.i),
              b"@@, (Word)(intptr_t)a, 2); return 0; }"]));
            if wide {
              let w = fresh(g);
              Some({ em: line(w.em, bytes_concat_all([
                       b"uint32_t ", w.name, b"; memcpy(&", w.name,
                       b", (unsigned char *)ply_words(", t.v.c, b") + ", idx.v.c, b", 4);"])),
                     v: { k: KNum({ bits: 32, signed: false }), c: bytes_concat_all([b"ply_le32(", w.name, b")"]), ty: TyOpen } })
            } else {
              Some(bind(g, KInt, bytes_concat_all([
                b"(int64_t)((unsigned char *)ply_words(", t.v.c, b"))[", idx.v.c, b"]"])))
            }
          },
        },
      },
    },
  }

fn is_inlined(name: Bytes) -> Bool =
  name == b"len" || name == b"bytes_len" || name == b"bytes_at" || name == b"bytes_u32_le"
    || name == b"bytes_concat_all"

// The ones the reference does not answer with a plain call to the runtime.
// `fold` is fused where its callback is written out, and `map_fold` and
// `iterate` are shapes this port has not read.
fn is_callback(name: Bytes) -> Bool =
  name == b"fold" || name == b"iterate"

// The index a builtin takes in this body's own table, added on first use. Two
// calls of one builtin share it, which is what the reference's table does and
// what a *constant* deliberately does not.
fn builtin_of(em: Em, name: Bytes) -> { em: Em, i: Int } =
  match fold(range(0, len(em.met)), None, |acc: Option<Int>, i: Int|
          match list_at(em.met, i) {
            Some(x) -> if x == name { Some(i) } else { acc },
            None -> acc,
          }) {
    Some(i) -> { em: em, i: i },
    None -> { em: { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads,
                    shapes: em.shapes, built: em.built, module: em.module, made: em.made,
                    here: em.here, imports: em.imports, consts: em.consts, ctors: em.ctors,
                    extra: em.extra, lambdas: em.lambdas, owner: em.owner,
                    builtins: em.builtins, met: push(em.met, name), fields: em.fields, released: em.released, toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound },
               i: len(em.met) },
  }

// The helper that answers a builtin directly, where one does. Transcribed from
// `c/emit.rs`'s table of the same name; a builtin with no entry here is refused
// rather than sent down the generic path, which needs the unit's builtin table.
fn direct_helper(name: Bytes, args: Int) -> Option<Bytes> =
  if name == b"push" && args == 2 { Some(b"rt_push_p") }
  else if name == b"map_insert" && args == 3 { Some(b"rt_map_insert_p") }
  else if name == b"map_contains" && args == 2 { Some(b"rt_map_contains_p") }
  else if name == b"map_get" && args == 2 { Some(b"rt_map_get_p") }
  else if name == b"compare" && args == 2 { Some(b"rt_compare_p") }
  else if name == b"byte_of_int" && args == 1 { Some(b"rt_byte_of_int_p") }
  else if name == b"bytes_concat" && args == 2 { Some(b"rt_bytes_concat_p") }
  else if name == b"bytes_slice" && args == 3 { Some(b"rt_bytes_slice_p") }
  else if name == b"bytes_scan" && args == 4 { Some(b"rt_bytes_scan_p") }
  else if name == b"bytes_scan_until" && args == 4 { Some(b"rt_bytes_scan_until_p") }
  else if name == b"list_at" && args == 2 { Some(b"rt_list_index_p") }
  // `map` and `filter` hand the closure to the runtime, which walks the list.
  // `fold` does **not**: it is fused into the body, and `fused_fold` is why it is
  // absent here.
  else if name == b"map" && args == 2 { Some(b"rt_map_p") }
  else if name == b"filter" && args == 2 { Some(b"rt_filter_p") }
  else if name == b"map_fold" && args == 3 { Some(b"rt_map_fold_p") }
  // `map`, `filter` and `fold` are deliberately absent, and it is not an
  // oversight in the table they were copied from. Handed a *literal* lambda the
  // reference does not call a helper at all: it fuses the loop into the body and
  // the closure is never built. Routing them to `rt_map_p` and the two beside it
  // emitted a call where the reference emitted a loop, over eighteen bodies.
  else { None }

// A **builtin's** arguments: every one evaluated first, and only then each held
// once more.
//
// Two passes rather than one, and the order is observable: interleaving them
// puts the duplicate of the first argument between the first argument's own
// evaluation and the second's, and the reference writes it after both. A
// *compiled* call is the other way round -- `args_one_pass` below -- and the
// corpus says so at `std.json.b64_three` and `std.db.in_failed_txn`, one of
// each.
// `opaque` says whether any argument is a `Float` or `Decimal`: a builtin's answer over one
// stays opaque, so an operator downstream reaches the runtime rather than reading it as an `Int`.
fn args_owned(em: Em, xs: List<Code>, params: List<P>, i: Int, acc: List<Bytes>)
    -> Option<{ em: Em, names: List<Bytes> }> =
  match args_owned_typed(em, xs, params, i, acc) {
    None -> None,
    Some(w) -> Some({ em: w.em, names: w.names }),
  }

// A builtin with no helper of its own goes through the runtime, under this body's own index
// for it: every value held once more, the array they are read out of, then the call. The
// answer is opaque when any argument was, which is what keeps `Float` arithmetic out of the
// inline operators.
fn builtin_call(em: Em, name: Bytes, vals: List<V>) -> Out = {
  let opaque = fold(vals, false, |acc: Bool, v: V| acc || v.ty == TyOpaque);
  let w = fold(vals, { em: em, names: [] }, |a: { em: Em, names: List<Bytes> }, v: V| {
    let o = owned(a.em, v);
    { em: o.em, names: push(a.names, o.v.c) }
  });
  let bi = builtin_of(w.em, name);
  let arr = fresh(bi.em);
  let e = line(arr.em, bytes_concat_all([b"Word ", arr.name, b"[] = {",
    if len(w.names) == 0 { b"0" } else { bytes_join(w.names, b", ") }, b"};"]));
  let o = bind_keeping(e, KBoxed, if opaque { TyOpaque } else { TyOpen }, bytes_concat_all([
    b"rt_builtin_p(ctx, @@b", num(bi.i), b"@@, (Word)(intptr_t)", arr.name, b", ",
    num(len(vals)), b")"]));
  { em: check(o.em), v: o.v }
}

fn args_owned_typed(em: Em, xs: List<Code>, params: List<P>, i: Int, acc: List<Bytes>)
    -> Option<{ em: Em, names: List<Bytes>, opaque: Bool }> =
  match args_evaled(em, xs, params, i, []) {
    None -> None,
    Some(e) -> {
      let opaque = fold(e.vals, false, |acc2: Bool, v: V| acc2 || v.ty == TyOpaque);
      Some(fold(e.vals, { em: e.em, names: acc, opaque: opaque },
        |a: { em: Em, names: List<Bytes>, opaque: Bool }, v: V| {
          let w = owned(a.em, v);
          { em: w.em, names: push(a.names, w.v.c), opaque: a.opaque }
        }))
    },
  }

// A call through the runtime of whatever the callee evaluates to: it may be a lambda of this
// unit, a compiled function used as a value, or something the machine made. The callee is
// held once more, then each argument as it is evaluated.
fn call_value(em: Em, func: Code, args: List<Code>, params: List<P>) -> Option<Out> =
  match expr(notail(em), func, params) {
    None -> None,
    Some(f) -> {
      let fo = owned(f.em, f.v);
      match args_one_pass(fo.em, args, params, 0, []) {
        None -> None,
        Some(w) -> {
          let arr = fresh(w.em);
          let e = line(arr.em, bytes_concat_all([b"Word ", arr.name, b"[] = {",
            if len(w.names) == 0 { b"0" } else { bytes_join(w.names, b", ") }, b"};"]));
          let o = bind(e, KBoxed, bytes_concat_all([b"rt_call_p(ctx, ", fo.v.c,
            b", (Word)(intptr_t)", arr.name, b", ", num(len(args)), b")"]));
          Some({ em: check(o.em), v: o.v })
        },
      }
    },
  }

// The slots a lambda copies in, each held once more for the closure. A parameter the
// prologue did not open is not in the window and is read as its own word, as a variable
// read of it is.
fn caps_owned(em: Em, cs: List<Cap>, params: List<P>, i: Int, acc: List<Bytes>)
    -> Option<{ em: Em, names: List<Bytes> }> =
  if i >= len(cs) { Some({ em: em, names: acc }) } else {
    match list_at(cs, i) {
      None -> None,
      Some(c) -> {
        let found = match conv_of(em, c.src) {
          Some(v) -> Some(v),
          None -> match list_at(params, c.src) {
            Some(p) -> match p.k {
              KBoxed -> Some({ k: KBoxed, c: bytes_concat(b"p", num(c.src)), ty: p.ty }),
              _ -> None,
            },
            None -> None,
          },
        };
        match found {
          None -> Some({ em: poison(em, b"a capture this port has not bound"), names: acc }),
          Some(v) -> {
            let mv = move_read(em, c.own, v);
            let w = owned(mv.em, mv.v);
            caps_owned(w.em, cs, params, i + 1, push(acc, w.v.c))
          },
        }
      },
    }
  }

// A lambda's own function. Its C parameters are the captures first and then its
// own, all words: it has no declared types, so nothing is opened at entry the
// way a named function's `Int` is.
// The tables are the *unit's*, not the body's, so what the lambda meets keeps
// counting from what the function that builds it met, and what it adds is
// carried back out. Emitting it against a copy numbered a second body's
// constants and builtins from zero.
fn emit_lambda(em: Em, name: Bytes, l: { params: Int, size: Int, caps: List<Cap>, body: Code })
    -> Option<{ text: Bytes, extra: Bytes, met: List<Bytes>, consts: List<Lit>, shapes: List<List<Bytes>>, fields: List<Bytes>, lambdas: List<Bytes>, calls: List<Bytes>, performs: List<Bytes>, handles: List<Bytes>, refused: Option<Bytes> }> = {
  let n = len(l.caps) + l.params;
  let window = fold(range(0, l.params),
    fold(range(0, len(l.caps)), [], |acc: List<Conv>, i: Int|
      match list_at(l.caps, i) {
        Some(c) -> push(acc, { slot: c.dst, k: KBoxed, c: bytes_concat(b"q", num(i)), ty: TyOpen }),
        None -> acc,
      }),
    |acc: List<Conv>, j: Int|
      push(acc, { slot: j, k: KBoxed, c: bytes_concat(b"q", num(len(l.caps) + j)), ty: TyOpen }));
  let reads = slots_read(l.body);
  // The tables are the body's, continued: a lambda's constant or shape takes the next index
  // after what the body met, and what the body met stays in the table the lambda hands back.
  // Nothing in a lambda's body is a tail: the reference marks a function's tails and does not
  // descend into a lambda, so an update at the end of one keeps the one-read guard.
  let start = { out: [], n: 0, conv: window, ind: 0, reads: reads, shapes: em.shapes, built: [],
                module: em.module, made: [], here: em.here, imports: em.imports, consts: em.consts,
                ctors: em.ctors, extra: b"", lambdas: em.lambdas, owner: em.owner, builtins: em.builtins, met: em.met, fields: em.fields, released: [], toks: [], alias: [], by_root: [], tail: false, calls: em.calls, refused: em.refused, deferred: [], rlocals: [], performs: em.performs, handles: em.handles, landing: None, effects: em.effects, release: em.release, pinned: [], bound: [] };
  let charged = fold(window, start, |acc: Em, w: Conv| note_bound(note_holder(charge(acc, w.slot, w.c), w.c), w.c));
  match expr(charged, l.body, []) {
    None -> None,
    Some(o0) -> {
      let w = returned(o0.em, o0.v);
      let o = { em: w.em, v: o0.v };
      Some({ met: o.em.met, consts: o.em.consts, shapes: o.em.shapes, fields: o.em.fields, lambdas: o.em.lambdas, calls: o.em.calls, performs: o.em.performs, handles: o.em.handles, refused: o.em.refused,
      extra: o.em.extra,
      text: bytes_concat_all([
      b"Word ply_", name, b"(PlyCtx *ctx",
      fold(range(0, n), b"", |acc: Bytes, i: Int| bytes_concat_all([acc, b", Word q", num(i)])),
      b") {\n", fuel_head(),
      // A lambda is a function of its own, with reuse tokens and held-back records of its own.
      fold(sorted_widths(o.em.toks), b"", |acc: Bytes, w: Int|
        bytes_concat_all([acc, b"  Word tok", num(w), b" = 0;\n"])),
      fold(o.em.rlocals, b"", |acc: Bytes, r: Bytes| bytes_concat_all([acc, b"  Word ", r, b" = 0;\n"])),
      bytes_join(o.em.out, b""),
      b"  ctx->fuel += 1;\n  return ", w.c, b";\n}\n",
      b"Word ply_", name, b"_entry(PlyCtx *ctx, const Word *args) {\n  return ply_", name,
      b"(ctx", fold(range(0, n), b"", |acc: Bytes, i: Int|
        bytes_concat_all([acc, b", args[", num(i), b"]"])), b");\n}\n"]) })
    },
  }
}

// A compiled call's arguments: each held once more as soon as it is evaluated.
fn args_one_pass(em: Em, xs: List<Code>, params: List<P>, i: Int, acc: List<Bytes>)
    -> Option<{ em: Em, names: List<Bytes> }> =
  if i >= len(xs) { Some({ em: em, names: acc }) } else {
    match list_at(xs, i) {
      None -> None,
      Some(x) -> match expr(notail(em), x, params) {
        None -> None,
        Some(o) -> {
          let w = owned(o.em, o.v);
          args_one_pass(w.em, xs, params, i + 1, push(acc, w.v.c))
        },
      },
    }
  }

fn args_evaled(em: Em, xs: List<Code>, params: List<P>, i: Int, acc: List<V>)
    -> Option<{ em: Em, vals: List<V> }> =
  if i >= len(xs) { Some({ em: em, vals: acc }) } else {
    match list_at(xs, i) {
      None -> None,
      Some(x) -> match expr(notail(em), x, params) {
        None -> None,
        Some(o) -> { let s = secure(o.em, o.v); args_evaled(s.em, xs, params, i + 1, push(acc, s.v)) },
      },
    }
  }

fn field_of(em: Em, name: Bytes) -> { em: Em, i: Int } =
  match fold(range(0, len(em.fields)), None, |acc: Option<Int>, i: Int|
          match list_at(em.fields, i) {
            Some(x) -> if x == name { Some(i) } else { acc },
            None -> acc,
          }) {
    Some(i) -> { em: em, i: i },
    None -> { em: { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads,
                    shapes: em.shapes, built: em.built, module: em.module, made: em.made,
                    here: em.here, imports: em.imports, consts: em.consts, ctors: em.ctors,
                    extra: em.extra, lambdas: em.lambdas, owner: em.owner,
                    builtins: em.builtins, met: em.met, fields: push(em.fields, name), released: em.released, toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound },
               i: len(em.fields) },
  }

fn built_field(em: Em, local: Bytes, name: Bytes) -> Option<V> =
  fold(em.built, None, |acc: Option<V>, b: Built|
    if b.local != local { acc } else {
      fold(range(0, len(b.names)), acc, |inner: Option<V>, i: Int|
        match list_at(b.names, i) {
          Some(n) -> if n == name { list_at(b.vals, i) } else { inner },
          None -> inner,
        })
    })

fn remember_built(em: Em, local: Bytes, names: List<Bytes>, vals: List<V>) -> Em =
  { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
    built: push(em.built, { local: local, names: names, vals: vals }), module: em.module, made: em.made, here: em.here, imports: em.imports, consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner, builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }

fn shape_of(em: Em, names: List<Bytes>) -> { em: Em, i: Int } =
  match fold(range(0, len(em.shapes)), None, |acc: Option<Int>, i: Int|
          match list_at(em.shapes, i) {
            Some(sh) -> if same_names(sh, names) { Some(i) } else { acc },
            None -> acc,
          }) {
    Some(i) -> { em: em, i: i },
    None -> { em: { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads,
                    shapes: push(em.shapes, names), built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports, consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner, builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound },
              i: len(em.shapes) },
  }

fn same_names(a: List<Bytes>, b: List<Bytes>) -> Bool =
  len(a) == len(b) && fold(a, true, |acc: Bool, x: Bytes|
    acc && fold(b, false, |seen: Bool, y: Bytes| seen || y == x))

// The word of the field whose name sorts at `at`, since the values were built in
// the order they were written and the record holds them in the shape's order.
fn word_at_rank(names: List<Bytes>, words: List<Bytes>, at: Int) -> Bytes =
  fold(range(0, len(names)), b"", |acc: Bytes, i: Int|
    match list_at(names, i) {
      None -> acc,
      Some(nm) -> if rank_of(names, nm) == at {
        match list_at(words, i) { Some(w) -> w, None -> acc }
      } else { acc },
    })

fn rank_of(names: List<Bytes>, name: Bytes) -> Int =
  fold(names, 0, |acc: Int, n: Bytes| if compare(n, name) == Less { acc + 1 } else { acc })

fn note_tok(em: Em, w: Int) -> Em =
  if fold(em.toks, false, |acc: Bool, x: Int| acc || x == w) { em } else {
    { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
      built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports,
      consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner,
      builtins: em.builtins, met: em.met, fields: em.fields, released: em.released,
      toks: push(em.toks, w), alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }
  }

fn note_released(em: Em, root: Bytes) -> Em =
  { out: em.out, n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
    built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports,
    consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner,
    builtins: em.builtins, met: em.met, fields: em.fields, released: push(em.released, root), toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }

fn count_of(reads: List<Int>, slot: Int) -> Int =
  fold(reads, 0, |acc: Int, s: Int| if s == slot { acc + 1 } else { acc })

fn width_of(ty: Ty) -> Option<Int> =
  match ty { TyRec(fs) -> Some(len(fs)), _ -> None }

fn field_at(ty: Ty, name: Bytes) -> Option<{ at: Int, k: Kind, ty: Ty }> =
  match ty {
    TyRec(fs) -> fold(fs, None, |acc: Option<{ at: Int, k: Kind, ty: Ty }>, f: FieldTy|
      if f.name == name { Some({ at: rank_of(names_of(fs), name), k: f.k, ty: f.ty }) } else { acc }),
    _ -> None,
  }

fn names_of(fs: List<FieldTy>) -> List<Bytes> = map(fs, |f: FieldTy| f.name)

fn as_bool(v: V) -> Bytes =
  match v.k {
    KBool -> v.c,
    KNum(_) -> bytes_concat_all([b"((", v.c, b") != 0)"]),
    KInt -> bytes_concat_all([b"((", v.c, b") != 0)"]),
    KBoxed -> bytes_concat_all([b"rt_unbox_bool_p(ctx, ", v.c, b")"]),
  }

fn as_word(v: V) -> Bytes =
  match v.k {
    KBoxed -> v.c,
    // Either way it widens to the word the immediate carries; the C type the
    // value is held in is what decides whether that is a sign or a zero extension.
    KNum(_) -> bytes_concat_all([b"ply_imm((int64_t)", v.c, b")"]),
    // A `Bool` leaves as one of the two immortal words the runtime holds for it.
    KBool -> bytes_concat_all([b"(", v.c, b" ? ply_true : ply_false)"]),
    KInt -> bytes_concat_all([b"(ply_fits_imm(", v.c, b") ? ply_imm(", v.c,
                              b") : rt_box_int_p(ctx, ", v.c, b"))"]),
  }

// `rt_arith`'s opcode: multiply, divide, and everything else.
fn arith_code(op: Bytes) -> Int =
  if op == b"mul" { 0 } else if op == b"div" { 1 } else { 2 }

// The runtime's numbering of the operators `rt_binary` takes, in the order the
// runtime's own table lists them.
fn binary_code(op: Bytes) -> Int =
  if op == b"add" { 0 } else if op == b"sub" { 1 } else if op == b"mul" { 2 }
  else if op == b"div" { 3 } else if op == b"rem" { 4 } else if op == b"eq" { 5 }
  else if op == b"ne" { 6 } else if op == b"lt" { 7 } else if op == b"le" { 8 }
  else if op == b"gt" { 9 } else { 10 }

fn is_add_or_sub(op: Bytes) -> Bool = op == b"add" || op == b"sub"

pub fn covers() -> List<Bytes> =
  [b"integer literals", b"parameters read as integers",
   b"add, sub, mul, div and rem on Int",
   b"lt, le, gt, ge, eq and ne on Int",
   b"if, with either branch's value joined in one temporary",
   b"a block, and the `let`s in it",
   b"a list of values",
   b"neg and not, and the Bool literals",
   b"a field of a record whose shape a parameter's type gives",
   b"a record literal, through this body's reuse token for its width",
   b"a direct call to a definition of the same module",
   b"the builtins with a runtime helper of their own",
   b"a match over wildcards, binders and Int literals",
   b"a call of a name another module exports by name",
   b"a Str or Bytes literal, from the unit's constant table",
   b"a constructor, tagged by its place in the unit's table",
   b"a constructor pattern whose arguments are names",
   b"a lambda, as the closure over the slots it copies in"]

fn expr(em: Em, c: Code, params: List<P>) -> Option<Out> =
  match c.node {
    NLit(l) -> match l {
      LInt(n) -> Some({ em: em, v: { k: KInt, c: int_lit(n), ty: TyOpen } }),
      // A `Bool` is C's own 1 and 0 until something asks for its word.
      LBool(b) -> Some({ em: em, v: { k: KBool, c: if b { b"1" } else { b"0" }, ty: TyOpen } }),
      // Anything the tag cannot hold is built once and read from the unit's
      // constant table. The helper can raise, so the check follows.
      LStr(_) -> Some(from_table(em, l)),
      LBytes(_) -> Some(from_table(em, l)),
      // Below sixty-four bits a literal is its C type's own; at sixty-four it is built once and
      // read from the constant table, which has no place for a value above the signed range.
      LFixed(name, bits) -> match width_named(name) {
        None -> Some(refused(em, b"a fixed-width literal of no known width")),
        Some(w) -> if carried(w) {
          Some({ em: em, v: { k: KNum(w), c: bytes_concat_all([b"((", ctype(KNum(w)), b")", num(bits), b")"]), ty: TyOpen } })
        } else { Some(from_table(em, l)) },
      },
      LUnit -> Some(from_table(em, l)),
      // A `Float` or `Decimal` is a constant the runtime holds, opaque here: every operator over
      // it is the machine's own, through the runtime. The reference has no path for these.
      LFloat(_) -> Some(opaque_from_table(em, l)),
      LDec(_) -> Some(opaque_from_table(em, l)),
      _ -> Some(refused(em, b"a literal this port does not pool")),
    },
    // A parameter is `pN`; anything else needs the window, which is the next
    // piece of this port.
    NVar(v) -> match v.slot {
      // A global. A nullary constructor is the one this port answers: it is a
      // singleton the runtime holds, not a call.
      None -> if is_ctor_name(v.name) {
        match tag_of(em, v.name) {
          None -> Some(refused(em, bytes_concat(b"a constructor not in the table: ", v.name))),
          Some(tag) -> {
            let o = bind(em, KBoxed, bytes_concat_all([b"rt_nullary_p(ctx, ", num(tag), b")"]));
            Some({ em: check(o.em), v: o.v })
          },
        }
      } else { match def_of(em, v.name) {
        // A definition used as a value: a nullary one is called, and any other is a closure over
        // its entry with nothing captured. The reference also asks whether the unit took it; a
        // body naming one the unit does not hold is refused at the seam.
        Some(d) -> if d.arity == 0 {
          let o = bind(note_call(em, d.full), KBoxed, bytes_concat_all([d.c, b"(ctx)"]));
          Some({ em: check(o.em), v: o.v })
        } else {
          let l = lambda_of(note_call(em, d.full), bytes_concat_all([d.c, b"_entry"]));
          let arr = fresh(l.em);
          let e = line(arr.em, bytes_concat_all([b"Word ", arr.name, b"[] = {0};"]));
          let o = bind(e, KBoxed, bytes_concat_all([b"rt_closure_p(ctx, @@l", num(l.i), b"@@, ", num(d.arity),
            b", (Word)(intptr_t)", arr.name, b", 0)"]));
          Some({ em: note_made(check(o.em), o.v.c), v: o.v })
        },
        None -> if fold(em.builtins, false, |acc: Bool, b2: Bytes| acc || b2 == v.name) {
          let bi = builtin_of(em, v.name);
          let o = bind(bi.em, KBoxed, bytes_concat_all([b"rt_builtin_value_p(ctx, @@b", num(bi.i), b"@@)"]));
          Some({ em: check(o.em), v: o.v })
        } else { Some(refused(em, bytes_concat(b"a global this port cannot resolve: ", v.name))) },
      } },
      Some(s) -> match conv_of(em, s) {
        Some(v) -> Some(move_read(em, c.own, v)),
        // Not in the window: a parameter the prologue did not open, which is a
        // record. It is read as its own word, here, each time.
        None -> match list_at(params, s) {
          None -> Some(refused(em, bytes_concat(b"a local this port has not bound: ", v.name))),
          Some(p) -> match p.k {
            KBoxed -> Some(move_read(em, c.own, { k: KBoxed, c: bytes_concat(b"p", num(s)), ty: p.ty })),
            _ -> Some(refused(em, bytes_concat(b"a scalar parameter read outside its window: ", v.name))),
          },
        },
      },
    },
    NBinary(b) ->
      // Two `Int` literals under an operator are one literal: the reference folds them before
      // it lowers, checked, so an overflow is left for the runtime to raise.
      match lit_int(c) {
        Some(n) -> Some({ em: em, v: { k: KInt, c: int_lit(n), ty: TyOpen } }),
        None ->
      // `&&` and `||` short-circuit, so the right operand is emitted inside the branch.
      if b.op == b"and" || b.op == b"or" {
        match expr(notail(em), b.lhs, params) {
          None -> None,
          Some(l) -> {
            let out = fresh(l.em);
            let opened = line(out.em, bytes_concat_all([b"int64_t ", out.name, b" = ", as_bool(l.v), b";"]));
            let branch = if b.op == b"and" { bytes_concat_all([b"if (", out.name, b") {"]) }
                         else { bytes_concat_all([b"if (!", out.name, b") {"]) };
            match expr(indent(line(opened, branch)), b.rhs, params) {
              None -> None,
              Some(r) -> {
                let assigned = line(r.em, bytes_concat_all([out.name, b" = ", as_bool(r.v), b";"]));
                // One path runs the branch: what it moved is still held on the other.
                let closed = close(assigned);
                Some({ em: with_made(closed, union_made(opened.made, closed.made)), v: { k: KBool, c: out.name, ty: TyOpen } })
              },
            }
          },
        }
      }
      // `++` joins two values the runtime knows how to join, and takes both.
      else if b.op == b"concat" {
        match secured(expr(notail(em), b.lhs, params)) {
          None -> None,
          Some(l) -> match expr(notail(l.em), b.rhs, params) {
            None -> None,
            Some(r) -> {
              let lo = owned(r.em, l.v);
              let ro = owned(lo.em, r.v);
              let o = bind(ro.em, KBoxed,
                bytes_concat_all([b"rt_concat_p(ctx, ", lo.v.c, b", ", ro.v.c, b")"]));
              Some({ em: check(o.em), v: o.v })
            },
          },
        }
      }
      else if !is_arith(b.op) && compare_op(b.op) == None && !is_bitop(b.op) && !is_shift(b.op) {
        Some(refused(em, bytes_concat(b"an operator this port does not emit: ", b.op)))
      } else {
        match secured(expr(notail(em), b.lhs, params)) {
          None -> None,
          Some(l) -> match expr(notail(l.em), b.rhs, params) {
            None -> None,
            Some(r) -> binary_rest(r.em, b.op, l.v, r.v),
          },
        }
      } },
    // Lowering wraps every `if` branch and every `{ }` body in one of these. A
    // block binds its tail even when it holds no statements, which is why an
    // `if` branch shows a rename the branch itself did not ask for.
    NBlock(bl) -> match bl.tail {
      // A block with no tail is its statements, and its value is the unit.
      None -> match stmts(em, bl.stmts, params, 0) {
        None -> None,
        Some(after) -> Some(bind(withtail(after, em.tail), KBoxed, b"ply_unit")),
      },
      Some(t) -> match stmts(em, bl.stmts, params, 0) {
        None -> None,
        // The statements are not tails and cleared the flag; the block's tail is one when the
        // block is.
        Some(after) -> match expr(withtail(after, em.tail), t, params) {
          None -> None,
          Some(o) -> Some(bind_keeping(o.em, o.v.k, o.v.ty, o.v.c)),
        },
      },
    },
    NUnary(u) -> match expr(notail(em), u.operand, params) {
      None -> None,
      Some(o) ->
        if u.op == b"not" {
          Some(bind(o.em, KBool, bytes_concat_all([b"!(", as_bool(o.v), b")"])))
        } else if u.op == b"neg" {
          match o.v.k {
            // A width negates wide and narrows back, under the same guard as a subtraction.
            KNum(w) -> narrow(bind(o.em, KInt, bytes_concat_all([b"-(int64_t)(", as_num(o.v, w), b")"])), w, 2),
            // A word of a type this port cannot see may be a `Float` or a `Decimal`: the
            // machine's own negation, through the runtime.
            KBoxed -> {
              let held = owned(o.em, o.v);
              let out = bind_keeping(held.em, KBoxed, o.v.ty, bytes_concat_all([b"rt_negate_p(ctx, ", held.v.c, b")"]));
              Some({ em: check(out.em), v: out.v })
            },
            _ -> {
              // Negation overflows at one input, and the guard runs before the value
              // exists rather than after: code 2, as `rt_arith_p`'s table numbers it.
              let a = as_int(o.v);
              let g = line(o.em, bytes_concat_all([b"if (", a,
                b" == INT64_MIN) { rt_overflow_p(ctx, 2); return 0; }"]));
              Some(bind(g, KInt, bytes_concat_all([b"-(", a, b")"])))
            },
          }
        } else if u.op == b"bitnot" {
          match o.v.k {
            KNum(w) -> Some(bind(o.em, KNum(w), bytes_concat_all([b"(", ctype(KNum(w)), b") ~(", as_num(o.v, w), b")"]))),
            _ -> Some(bind(o.em, KInt, bytes_concat_all([b"~(", as_int(o.v), b")"]))),
          }
        } else { None },
    },
    // A lambda is a closure over the slots it copies in, *and* a function of
    // its own written after the one that builds it. Emitting the closure without
    // the function would be a call to something nothing defines, so the two are
    // one node here.
    //
    // A lambda inside a lambda is one more of the owner's: numbered after the one it sits in,
    // its entry interned before its body as the reference reserves the slot, and its text
    // written after its owner's.
    NLambda(l) -> {
      match caps_owned(em, l.caps, params, 0, []) {
        None -> None,
        Some(w) -> {
          // Numbered among this body's lambdas; the code table holds constants' entries too.
          let prefix = bytes_concat_all([b"ply_", em.owner, b"_lambda"]);
          let idx = fold(w.em.lambdas, 0, |acc: Int, sym: Bytes|
            if bytes_len(sym) >= bytes_len(prefix) && bytes_slice(sym, 0, bytes_len(prefix)) == prefix { acc + 1 } else { acc });
          let sub = bytes_concat_all([em.owner, b"_lambda", num(idx)]);
          // The closure names its code by the entry's place in the body's table.
          let entry = lambda_of(w.em, bytes_concat_all([b"ply_", sub, b"_entry"]));
          match emit_lambda(entry.em, sub, l) {
            None -> None,
            Some(sub_out) -> {
              let arr = fresh(entry.em);
              let e = line(arr.em, bytes_concat_all([b"Word ", arr.name, b"[] = {",
                if len(w.names) == 0 { b"0" } else { bytes_join(w.names, b", ") }, b"};"]));
              let grown = { out: e.out, n: e.n, conv: e.conv, ind: e.ind, reads: e.reads,
                            shapes: sub_out.shapes, built: e.built, module: e.module, made: e.made,
                            here: e.here, imports: e.imports, consts: sub_out.consts, ctors: e.ctors,
                            extra: bytes_concat_all([e.extra, sub_out.text, sub_out.extra]), lambdas: sub_out.lambdas,
                            owner: e.owner, builtins: e.builtins, met: sub_out.met, fields: sub_out.fields, released: e.released, toks: e.toks, alias: e.alias, by_root: e.by_root, tail: e.tail, calls: sub_out.calls, refused: sub_out.refused, deferred: e.deferred, rlocals: e.rlocals, performs: sub_out.performs, handles: sub_out.handles, landing: e.landing, effects: e.effects, release: e.release, pinned: e.pinned, bound: e.bound };
              let o = bind(grown, KBoxed, bytes_concat_all([
                b"rt_closure_p(ctx, @@l", num(entry.i), b"@@, ", num(l.params),
                b", (Word)(intptr_t)", arr.name, b", ", num(len(l.caps)), b")"]));
              Some({ em: check(o.em), v: o.v })
            },
          }
        },
      }
    },
    // A list: every item boxed into a `Word` local, then the array they are
    // read out of, then the helper. The helper can raise, so the check follows.
    NList(l) -> match items(em, l.items, params, 0, []) {
      None -> None,
      Some(w) -> {
        let arr = fresh(w.em);
        // C has no empty initialiser, so an empty list still declares one word.
        let e = line(arr.em, bytes_concat_all([b"Word ", arr.name, b"[] = {",
          if len(w.names) == 0 { b"0" } else { bytes_join(w.names, b", ") }, b"};"]));
        let o = bind(e, KBoxed, bytes_concat_all([b"rt_list_p(ctx, (Word)(intptr_t)", arr.name,
          b", ", num(len(l.items)), b")"]));
        Some({ em: check(o.em), v: o.v })
      },
    },
    // `ply_words(base)[i]`, where the index is the field's place in the record's
    // sorted names. A base whose shape the port does not know is refused rather
    // than read at a guessed offset.
    NField(f) -> match expr(notail(em), f.base, params) {
      None -> None,
      Some(b) -> match built_field(b.em, b.v.c, f.field) {
        // Built in this body: the value is already in a register, and asking for
        // the word here is what would force a record into memory that nothing
        // else ever looks at.
        Some(v) -> {
          let kept = secure_field(b.em, f.base, b.v, v);
          match release_base(kept.em, f.base, b.v, params) {
            None -> None,
            Some(r) -> Some({ em: r, v: kept.v }),
          }
        },
        None -> {
          let held = bind(b.em, KBoxed, as_word(b.v));
          // Under release the rename is the holder: the temporary it renamed was nulled.
          let hv = if b.em.release { { k: KBoxed, c: held.v.c, ty: b.v.ty } } else { b.v };
          match field_at(b.v.ty, f.field) {
            // The shape is known, so the read is a load at the field's offset. A
            // scalar field then goes into a register of its own kind; anything
            // else stays the word it already is.
            Some(i) -> {
              let w = bind_keeping(held.em, KBoxed, i.ty,
                bytes_concat_all([b"ply_words(", held.v.c, b")[", num(i.at), b"]"]));
              match i.k {
                // A field whose own kind is a word does **not** release the base.
                // The reference returns before the release for exactly this case,
                // and the reason is recorded there: the in-place field take that
                // would make it safe is not in the tier.
                // Under release a base at its last use is let go here, the field held once more
                // first, which is what `rt_field` does with its `own` of 1.
                KBoxed -> if w.em.release && base_owned(f.base) && spendable(w.em, hv.c) {
                    let tf = note_made(line(w.em, bytes_concat_all([b"ply_inc(", w.v.c, b");"])), w.v.c);
                    match release_base(tf, f.base, hv, params) {
                      None -> None,
                      Some(r) -> Some({ em: r, v: w.v }),
                    }
                  } else { Some({ em: w.em, v: w.v }) },
                _ -> {
                  let out = bind(w.em, i.k, as_kind(w.v, i.k));
                  match release_base(out.em, f.base, hv, params) {
                    None -> None,
                    Some(r) -> Some({ em: r, v: out.v }),
                  }
                },
              }
            },
            // The shape is not known and neither is the offset: the runtime's read by name,
            // through this body's field table. It answers a word, and a field whose kind is a
            // word does not release its base.
            None -> {
              let idx = field_of(held.em, f.field);
              // The runtime takes a base at its last use, under release.
              let take = idx.em.release && base_owned(f.base) && spendable(idx.em, hv.c);
              let w = bind(idx.em, KBoxed, bytes_concat_all([b"rt_field_p(ctx, ", held.v.c, b", @@f", num(idx.i), b"@@, ",
                                                            if take { b"1" } else { b"0" }, b")"]));
              let spent = if take { line(spend_made(w.em, hv.c), bytes_concat_all([hv.c, b" = 0;"])) } else { w.em };
              Some({ em: check(spent), v: w.v })
            },
          }
        },
      },
    },
    // `{..b, f: e}`, which is a record built out of the base's own memory rather
    // than fresh: the base is released *before* the allocation, so its cells are
    // the token this build then takes.
    //
    // The written fields are evaluated first, then the base is read, then each
    // field in the shape's order -- a copy through the base, a set from what was
    // evaluated -- and the stores follow.
    NUpd(u) -> {
      let names = sorted_names(concat_names(u.copies, map(u.sets, |f: CField| f.name)));
      // Each written field is evaluated **and bound** before the base is read.
      // A literal set writes a line of its own here, which is the only sign the
      // binding happens at all.
      match sets_bound(em, map(u.sets, |f: CField| f.value), params, 0, []) {
        None -> None,
        Some(ev) -> match expr(notail(ev.em), u.base, params) {
          None -> None,
          Some(bv) -> {
            let held = bind(bv.em, KBoxed, as_word(bv.v));
            let hv = if bv.em.release { { k: KBoxed, c: held.v.c, ty: bv.v.ty } } else { bv.v };
            // Each field's word, its kind by the base's declared type, and the value it came
            // from where the value is still in a register: a copy the base itself remembered is
            // the value rather than a load, which is what carries the knowledge along a chain of
            // updates. A word read out of memory is what keeps the record from being held back.
            let filled = fold(range(0, len(names)), { em: held.em, ws: [], kinds: [], vals: [], known: true },
              |acc: { em: Em, ws: List<Bytes>, kinds: List<Kind>, vals: List<V>, known: Bool }, at: Int| {
                let nm = match list_at(names, at) { Some(x) -> x, None -> b"" };
                if fold(u.copies, false, |seen: Bool, c: Bytes| seen || c == nm) {
                  let fk = match field_at(bv.v.ty, nm) { Some(f) -> f.k, None -> KBoxed };
                  match built_field(acc.em, held.v.c, nm) {
                    Some(v) -> {
                      let o = owned(acc.em, v);
                      { em: o.em, ws: push(acc.ws, o.v.c), kinds: push(acc.kinds, fk), vals: push(acc.vals, taken_as(o.em, v, o.v)), known: acc.known }
                    },
                    None -> match field_at(bv.v.ty, nm) {
                      // Read at the field's place in the **base's** shape, which is the new
                      // record's only when the update writes no field the base lacks -- and a
                      // literal recognised as an update usually does.
                      Some(f) -> {
                        let w = bind_word_of(acc.em, bytes_concat_all([
                          b"ply_words(", held.v.c, b")[", num(f.at), b"]"]));
                        let inc = line(w.em, bytes_concat_all([b"ply_inc(", w.v.c, b");"]));
                        // A scalar copy is read into a register of its own kind, as any
                        // field read is -- and the register is then unused, because the
                        // *word* is what the store takes. A copy whose field is already
                        // a word converts nothing.
                        match f.k {
                          KBoxed -> { em: inc, ws: push(acc.ws, w.v.c), kinds: push(acc.kinds, fk), vals: acc.vals, known: false },
                          _ -> { let c = bind(inc, f.k, as_kind(w.v, f.k));
                                 { em: c.em, ws: push(acc.ws, w.v.c), kinds: push(acc.kinds, fk), vals: push(acc.vals, c.v), known: acc.known } },
                        }
                      },
                      None -> {
                        let idx = field_of(acc.em, nm);
                        let w = bind(idx.em, KBoxed, bytes_concat_all([
                          b"rt_field_p(ctx, ", held.v.c, b", @@f", num(idx.i), b"@@, 0)"]));
                        // The runtime answers the copy held once more, and the record takes it.
                        { em: spend_made(check(w.em), w.v.c), ws: push(acc.ws, w.v.c), kinds: push(acc.kinds, fk), vals: acc.vals, known: false }
                      },
                    },
                  }
                } else {
                  match set_value(u.sets, ev.vals, nm) {
                    None -> { em: acc.em, ws: push(acc.ws, b"0"), kinds: push(acc.kinds, KBoxed), vals: acc.vals, known: false },
                    // The written field's word is *held once more*: the record
                    // being built takes it, as a copy's read does.
                    Some(v) -> { let w = owned(acc.em, v);
                                 { em: w.em, ws: push(acc.ws, w.v.c), kinds: push(acc.kinds, v.k), vals: push(acc.vals, taken_as(w.em, v, w.v)), known: acc.known } },
                  }
                }
              });
            // The release here is the reference's `Site::TailUpdate` at the body's tail, which
            // skips the one-read guard: nothing is emitted after the update, so the later read the
            // guard protects cannot be there.
            match release_from(filled.em, u.base, hv, params, em.tail) {
              None -> None,
              Some(rel) -> Some(build_record(rel, names, filled.ws, filled.kinds,
                                             if filled.known { Some(filled.vals) } else { None })),
            }
          },
        },
      }
    },
    // A record: values in the order they are written, assembled in the order the
    // shape holds them, which is by name. The memory comes from a reuse token of
    // this width when the body has one and from the allocator when it does not.
    NRecord(r) -> {
      let names = map(r.fields, |f: CField| f.name);
      match items(em, map(r.fields, |f: CField| f.value), params, 0, []) {
        None -> None,
        Some(w) -> {
          let sorted = sorted_names(names);
          let vals = map(sorted, |nm: Bytes| match fold(range(0, len(names)), None, |acc: Option<V>, i: Int|
            match list_at(names, i) { Some(x) -> if x == nm { list_at(w.vals, i) } else { acc }, None -> acc })
            { Some(v) -> v, None -> { k: KBoxed, c: b"0", ty: TyOpen } });
          Some(build_record(w.em, sorted,
            map(range(0, len(sorted)), |at: Int| word_at_rank(names, w.names, at)),
            map(vals, |v: V| v.k), Some(vals)))
        },
      }
    },
    // A direct call to a definition of this module. A qualified name resolves
    // through an import and this port does not resolve, so it is refused rather
    // than mangled at a guess; so is a call of anything but a name, which is a
    // closure and needs the handle ABI.
    NApp(a) -> match a.func.node {
      // A constructor is applied like a function and is not one: the reference
      // builds a tagged object rather than calling anything. A leading capital
      // is what tells them apart without resolving, and this port has no
      // constructors, so one is refused.
      // A constructor is a tagged object rather than a call, and its tag is its
      // place in the unit's table.
      // A name bound in this body holds a closure, and calling one goes through
      // the runtime: it may be a lambda of this unit, a compiled function used as
      // a value, or something the machine made.
      NVar(fv) -> match fv.slot {
        Some(_) -> call_value(em, a.func, a.args, params),
        None -> if is_ctor_name(fv.name) {
        match tag_of(em, fv.name) {
          None -> Some(refused(em, bytes_concat(b"a constructor not in the table: ", fv.name))),
          Some(tag) -> match items(em, a.args, params, 0, []) {
            None -> None,
            Some(w) -> {
              let arr = fresh(w.em);
              let e = line(arr.em, bytes_concat_all([b"Word ", arr.name, b"[] = {",
                if len(w.names) == 0 { b"0" } else { bytes_join(w.names, b", ") }, b"};"]));
              let o = bind(e, KBoxed, bytes_concat_all([b"rt_ctor_p(ctx, ", num(tag),
                b", (Word)(intptr_t)", arr.name, b", ", num(len(a.args)), b")"]));
              Some({ em: check(o.em), v: o.v })
            },
          },
        }
      } else {
        // A nullary call is not a call on the other side: a pure one is answered
        // by the unit's constant table, which is a purity analysis this port does
        // not have. Refused rather than emitted as the call it lowered to.
        // A pure nullary definition whose answer is a word is asked of the runtime's constant
        // table rather than called: the unit remembers it, as the machine's memo does.
        if len(a.args) == 0 && constant_of(em, fv.name) != None {
          match constant_of(em, fv.name) {
            None -> None,
            Some(k) -> {
              let noted = note_call(em, k.full);
              let l = lambda_of(noted, bytes_concat_all([b"ply_", mangle(k.full), b"_entry"]));
              let held = bind(l.em, KBoxed, bytes_concat_all([b"rt_constant_p(ctx, @@l", num(l.i), b"@@)"]));
              Some({ em: check(held.em), v: { k: KBoxed, c: held.v.c, ty: k.ty } })
            },
          }
        }
                else if !fold(em.here, false, |acc: Bool, h: Def| acc || h.name == fv.name) {
                  // Not a definition of this module: a builtin, or an import this
                  // port cannot resolve. The ones with a helper of their own are
                  // a swap for the call and nothing about ownership changes.
                  match direct_helper(fv.name, len(a.args)) {
                    // Brought in by name from another module: the same direct
                    // call, mangled with the module it came from.
                    None -> match match qualified(fv.name) {
                      Some(q) -> from_import(em.imports, q.binder),
                      None -> from_import(em.imports, fv.name),
                    } {
                      // A builtin with no helper of its own goes through the
                      // runtime, which is the interpreter's own path, under this
                      // body's own index for it.
                      //
                      // Two families are refused instead. The **callback** family
                      // is fused: handed a literal lambda the reference emits the
                      // loop into the body and never builds the closure. The
                      // **inline** family -- `len`, `bytes_len`, `bytes_at`,
                      // `bytes_u32_le` -- is expanded in place, with a kind test
                      // and a bounds test around a load, and the runtime call is
                      // only its slow arm. Emitting a call for either is a wrong
                      // answer rather than a slow one.
                      // `len` and `bytes_len` over a value whose kind the
                      // declaration fixes: no test to make, and the answer is the
                      // header's own field.
                      None -> match fused_fold(em, fv.name, a.args, params) {
                        Some(o) -> Some(o),
                        None -> match iterate_call(em, fv.name, a.args, params) {
                        Some(o) -> Some(o),
                        None -> match position_call(em, fv.name, a.args, params) {
                        Some(o) -> Some(o),
                        None -> match width_builtin(em, fv.name, a.args, params) {
                        Some(o) -> Some(o),
                        None -> match inline_len(em, fv.name, a.args, params) {
                        Some(o) -> Some(o),
                        None -> if is_callback(fv.name) || is_inlined(fv.name) { Some(refused(em, bytes_concat(b"a callback or inline builtin outside its fused shape: ", fv.name))) }
                        else if !fold(em.builtins, false, |acc: Bool, b2: Bytes| acc || b2 == fv.name) { Some(refused(em, bytes_concat(b"a name this port cannot resolve: ", fv.name))) }
                        else { match args_evaled(em, a.args, params, 0, []) {
                          None -> None,
                          Some(e) -> Some(builtin_call(e.em, fv.name, e.vals)),
                        } } },
                      },
                      },
                      },
                      },
                      Some(imp) -> match args_one_pass(em, a.args, params, 0, []) {
                        None -> None,
                        Some(w) -> {
                          let m = imp.module;
                          let callee = match qualified(fv.name) { Some(q) -> q.name, None -> fv.name };
                          let o = bind(note_call(w.em, bytes_concat_all([m, b".", callee])), KBoxed, bytes_concat_all([
                            b"ply_", mangle(m), b"_", callee,
                            b"(ctx",
                            fold(w.names, b"", |acc: Bytes, nm: Bytes|
                              bytes_concat_all([acc, b", ", nm])), b")"]));
                          // Opened to the callee's declared type when its module was resolved
                          // alongside this one; a word otherwise.
                          Some(opened_to(check(o.em), o.v, ret_of(imp.defs, callee)))
                        },
                      },
                    },
                    // Two passes, except for the two that take a closure: those
                    // hold the list before the closure is built, where the rest
                    // evaluate everything and only then hold any of it.
                    Some(h) -> match (if fv.name == b"map" || fv.name == b"filter" {
                                        args_one_pass(em, a.args, params, 0, [])
                                      } else { args_owned(em, a.args, params, 0, []) }) {
                      None -> None,
                      Some(w) -> {
                        let o = bind(w.em, KBoxed, bytes_concat_all([
                          h, b"(ctx",
                          fold(w.names, b"", |acc: Bytes, nm: Bytes|
                            bytes_concat_all([acc, b", ", nm])), b")"]));
                        Some({ em: check(o.em), v: o.v })
                      },
                    },
                  }
                }
                else { match args_one_pass(em, a.args, params, 0, []) {
          None -> None,
          Some(w) -> {
            let o = bind(note_call(w.em, bytes_concat_all([em.module, b".", fv.name])), KBoxed, bytes_concat_all([
              b"ply_", mangle(em.module), b"_", fv.name, b"(ctx",
              fold(w.names, b"", |acc: Bytes, nm: Bytes| bytes_concat_all([acc, b", ", nm])),
              b")"]));
            // The answer is opened to the *callee's* declared type, here rather
            // than at the caller's return: a body whose own answer is already a
            // word hands it straight back.
            Some(opened_to(check(o.em), o.v, ret_of(em.here, fv.name)))
          },
        } } },
      },
      // Any other callee -- a field holding a function, a call's answer -- is a value too.
      _ -> call_value(em, a.func, a.args, params),
    },
    // A `match` is arms in order over one flag: each arm runs only if no earlier
    // one matched, and a body that falls off the end raises rather than answering.
    NMatch(m) -> match expr(notail(em), m.scrutinee, params) {
      None -> None,
      Some(sc) -> {
        let sw = word_of(sc.em, sc.v);
        let subj = bind_keeping(sw.em, KBoxed, sc.v.ty, sw.c);
        let ans = fresh(subj.em);
        let flag = fresh(line(ans.em, bytes_concat_all([b"Word ", ans.name, b" = 0;"])));
        let opened = line(flag.em, bytes_concat_all([b"int ", flag.name, b" = 0;"]));
        match arms(withtail(opened, em.tail), m.arms, params, 0, subj.v, ans.name, flag.name, opened.made, []) {
          None -> None,
          Some(after) -> Some({
            em: note_holder(line(after, bytes_concat_all([b"if (!", flag.name,
                                                          b") { rt_no_match_p(ctx); return 0; }"])), ans.name),
            v: { k: KBoxed, c: ans.name, ty: TyOpen } }),
        }
      },
    },
    NIf(i) -> match expr(notail(em), i.cond, params) {
      None -> None,
      Some(cnd) -> {
        // A condition is read as a *bool*: the two conversions agree on anything
        // already untagged and differ on a word, where this one is the runtime's
        // bool unbox rather than the integer's.
        let cv = { em: cnd.em, v: { k: KBool, c: as_bool(cnd.v), ty: TyOpen } };
        // The join is the kind both arms *answered*, or a word: the arms are emitted into
        // buffers first, and the join's local is declared before the `if` in the text but
        // after both arms in the numbering.
        {
          // The join's number is taken *before* either arm and its declaration is
          // written before the `if`, but the arms are emitted into buffers of
          // their own first: a record-valued join is not one local but one per
          // field, numbered after everything in both arms, and there is no way to
          // know that until both have been written.
          let j = fresh(cv.em);
          match arm(withtail(blank(j.em), em.tail), i.then_branch, params) {
            None -> None,
            Some(t) -> match arm(withtail(with_made(rescope(blank(t.em), cv.em.conv), j.em.made), em.tail),
                                 i.else_branch, params) {
              None -> None,
              Some(e) -> {
                // Asked with the *later* table, which holds what both arms built.
                let shape = shared_shape(e.em, t.v, e.v);
                match shape {
                  // Both arms answer a record this body built, of one shape: the
                  // join carries the *fields* rather than the word, one local
                  // each, and a third record is assembled from them afterwards.
                  // The number taken above is spent and never declared.
                  Some(names) -> {
                    let n = len(names);
                    // One local per field, in the field's own kind.
                    let js = fold(names, { em: rescope(blank(e.em), cv.em.conv), names: [] },
                      |acc: { em: Em, names: List<V> }, nm: Bytes| {
                        let k = match built_field(e.em, t.v.c, nm) { Some(fv) -> fv.k, None -> KInt };
                        let f = fresh(acc.em);
                        { em: line(f.em, bytes_concat_all([ctype(k), b" ", f.name, b" = 0;"])),
                          names: push(acc.names, { k: k, c: f.name, ty: TyOpen }) }
                      });
                    let tt = joined(e.em, t.em, t.text, t.v, names, js.names);
                    let ee = joined(e.em, e.em, e.text, e.v, names, js.names);
                    let body = bytes_concat_all([
                      bytes_join(j.em.out, b""), bytes_join(js.em.out, b""), pad(js.em.ind), b"if (", cv.v.c, b") {\n", tt.text,
                      pad(js.em.ind), b"} else {\n", ee.text, pad(js.em.ind), b"}\n"]);
                    rebuild({ out: [body], n: js.em.n, conv: cv.em.conv,
                              ind: js.em.ind, reads: js.em.reads, shapes: js.em.shapes,
                              built: js.em.built, module: js.em.module, made: union_made(tt.made, ee.made),
                              here: js.em.here, imports: js.em.imports, consts: js.em.consts,
                              ctors: js.em.ctors, extra: js.em.extra, lambdas: js.em.lambdas,
                              owner: js.em.owner, builtins: js.em.builtins, met: js.em.met, fields: js.em.fields, released: js.em.released, toks: js.em.toks, alias: js.em.alias, by_root: js.em.by_root, tail: js.em.tail, calls: js.em.calls, refused: js.em.refused, deferred: js.em.deferred, rlocals: js.em.rlocals, performs: js.em.performs, handles: js.em.handles, landing: js.em.landing, effects: js.em.effects, release: js.em.release, pinned: js.em.pinned, bound: js.em.bound },
                            names, js.names)
                  },
                  None -> {
                    let kt = join_kind(t.v.k, e.v.k);
                    let decl = line({ out: [], n: e.em.n, conv: cv.em.conv, ind: e.em.ind,
                                      reads: e.em.reads, shapes: e.em.shapes, built: e.em.built,
                                      module: e.em.module, made: e.em.made, here: e.em.here,
                                      imports: e.em.imports, consts: e.em.consts, ctors: e.em.ctors,
                                      extra: e.em.extra, lambdas: e.em.lambdas, owner: e.em.owner,
                                      builtins: e.em.builtins, met: e.em.met,
                                      fields: e.em.fields, released: e.em.released, toks: e.em.toks, alias: e.em.alias, by_root: e.em.by_root, tail: e.em.tail, calls: e.em.calls, refused: e.em.refused, deferred: e.em.deferred, rlocals: e.em.rlocals, performs: e.em.performs, handles: e.em.handles, landing: e.em.landing, effects: e.em.effects, release: e.em.release, pinned: e.em.pinned, bound: e.em.bound },
                                    bytes_concat_all([ctype(kt), b" ", j.name, b" = 0;"]));
                    let ta = assigned(decl, t.em, t.text, decl.ind, kt, t.v, j.name);
                    let ea = assigned(ta.em, e.em, e.text, decl.ind, kt, e.v, j.name);
                    let fin = ea.em;
                    let body = bytes_concat_all([
                      bytes_join(j.em.out, b""), bytes_join(decl.out, b""), pad(decl.ind), b"if (", cv.v.c, b") {\n",
                      ta.text,
                      pad(decl.ind), b"} else {\n",
                      ea.text,
                      pad(decl.ind), b"}\n"]);
                    let fin_em: Em = { out: [body], n: fin.n, conv: cv.em.conv,
                                 ind: fin.ind, reads: fin.reads, shapes: fin.shapes,
                                 built: fin.built, module: fin.module, made: union_made(ta.made, ea.made),
                                 here: fin.here, imports: fin.imports, consts: fin.consts,
                                 ctors: fin.ctors, extra: fin.extra, lambdas: fin.lambdas,
                                 owner: fin.owner, builtins: fin.builtins, met: fin.met, fields: fin.fields, released: fin.released, toks: fin.toks, alias: fin.alias, by_root: fin.by_root, tail: fin.tail, calls: fin.calls, refused: fin.refused, deferred: fin.deferred, rlocals: fin.rlocals, performs: fin.performs, handles: fin.handles, landing: fin.landing, effects: fin.effects, release: fin.release, pinned: fin.pinned, bound: fin.bound };
                    Some({ em: if kt == KBoxed { note_holder(fin_em, j.name) } else { fin_em },
                           v: { k: kt, c: j.name, ty: if t.v.ty == e.v.ty { t.v.ty } else { TyOpen } } })
                  },
                }
              },
            },
          }
        }
      },
    },
    // A `perform` is the runtime's search of the handler frames for the operation, over the
    // arguments each held once more; the effect is named program-wide (ADR 0043).
    NPerform(p) -> match effect_named(em, p.effect) {
      None -> Some(refused(em, bytes_concat(b"an effect this port cannot resolve: ", p.effect))),
      Some(en) -> match args_one_pass(em, p.args, params, 0, []) {
        None -> None,
        Some(w) -> {
          let global = en.global;
          let ef = field_of(w.em, global);
          let op = field_of(ef.em, p.op);
          let res = if p.resource == b"" { None } else { Some(field_of(op.em, p.resource)) };
          let after = match res { Some(r) -> r.em, None -> op.em };
          let arr = fresh(after);
          let e = line(arr.em, bytes_concat_all([b"Word ", arr.name, b"[] = {",
            if len(w.names) == 0 { b"0" } else { bytes_join(w.names, b", ") }, b"};"]));
          let o = bind(note_performs(e, bytes_concat_all([global, b"#", p.op])), KBoxed, bytes_concat_all([
            b"rt_perform_p(ctx, ", field_ref(ef.i), b", ", field_ref(op.i), b", ",
            match res { Some(r) -> field_ref(r.i), None -> b"-1" }, b", ",
            if op_writes(en, p.op) { b"1" } else { b"0" },
            b", (Word)(intptr_t)", arr.name, b", ", num(len(p.args)), b")"]));
          Some({ em: check(o.em), v: o.v })
        },
      },
    },
    NHandle(h) -> handle_site(em, h.body, h.clauses, h.ret, params),
    // `with cell`: a region opened as shared -- the arena's default, and the kind the
    // reference's analysis proves stronger where it can -- a cell in it holding the initial
    // value, the binder in scope for the body, and the region closed after it.
    NCell(c) -> match expr(notail(em), c.init, params) {
      None -> None,
      Some(iv) -> {
        // The runtime takes the initial value; the reference hands it a word it still holds.
        let init = if iv.em.release { owned(iv.em, iv.v) } else {
          let w0 = word_of(iv.em, iv.v);
          { em: w0.em, v: { k: KBoxed, c: w0.c, ty: TyOpen } }
        };
        let region = bind(init.em, KInt, b"rt_region_p(ctx, 0)");
        let made = bind(region.em, KBoxed, bytes_concat_all([b"rt_cell_p(ctx, ", init.v.c, b")"]));
        let cell = bind(made.em, KBoxed, made.v.c);
        let bound = match c.slot { Some(sl) -> remember(cell.em, sl, cell.v), None -> cell.em };
        match expr(bound, c.body, params) {
          None -> None,
          Some(b) -> {
            let held = bind_keeping(b.em, b.v.k, b.v.ty, b.v.c);
            Some({ em: line(held.em, bytes_concat_all([b"rt_region_close_p(ctx, ", region.v.c, b");"])), v: held.v })
          },
        }
      },
    },
    // `simulate { body }`: the body is a nullary closure the runtime runs as the root task of
    // a region whose scheduler it drives; the site handles every operation the region answers.
    NSim(x) -> {
      let lam = { own: Borrowed, node: NLambda({ params: 0, size: x.size, caps: x.caps, body: x.body }) };
      match expr(notail(em), lam, params) {
        None -> None,
        Some(cl) -> {
          let held = owned(cl.em, cl.v);
          let noted = fold(scheduled_ops(), held.em, |acc: Em, op: Bytes| note_handles(acc, op));
          let o = bind(noted, KBoxed, bytes_concat_all([b"rt_simulate_p(ctx, ", held.v.c, b")"]));
          Some({ em: check(o.em), v: o.v })
        },
      }
    },
    _ -> Some(refused(em, b"an effect construct or another node this port does not emit")),
  }

// The operations a `simulate` region answers, as the fixpoint names a handled operation.
fn scheduled_ops() -> List<Bytes> =
  [b"task#spawn", b"task#join", b"task#yield", b"clock#now", b"clock#sleep",
   b"random#next", b"random#below", b"sim#seed"]

// A name in this body's field table, written as the placeholder the unit resolves: the
// runtime reads effect, operation and resource names out of the unit's table.
fn field_ref(i: Int) -> Bytes = bytes_concat_all([b"@@f", num(i), b"@@"])

// The effect a `perform` or a clause names, under its program-wide name; `None` for a name
// the module's scope does not bind.
fn effect_global(em: Em, written: Bytes) -> Option<Bytes> =
  match effect_named(em, written) { Some(e) -> Some(e.global), None -> None }

fn effect_named(em: Em, written: Bytes) -> Option<EffectName> =
  match fold(em.effects, None, |acc: Option<EffectName>, e: EffectName| if e.written == written { Some(e) } else { acc }) {
    Some(e) -> Some(e),
    // The prelude's effects are declared nowhere and known program-wide by their bare names.
    None -> fold(prelude_effects_here(), None, |acc: Option<EffectName>, e: EffectName| if e.written == written { Some(e) } else { acc }),
  }

fn prelude_effects_here() -> List<EffectName> =
  [{ written: b"task", global: b"task", ops: [{ name: b"spawn", write: true }, { name: b"join", write: true }, { name: b"yield", write: true }] },
   { written: b"clock", global: b"clock", ops: [{ name: b"now", write: false }, { name: b"sleep", write: true }] },
   { written: b"random", global: b"random", ops: [{ name: b"next", write: true }, { name: b"below", write: true }] },
   { written: b"sim", global: b"sim", ops: [{ name: b"seed", write: false }] }]

// Whether an operation of an effect writes: the atom a `perform` records carries its mode.
fn op_writes(e: EffectName, op: Bytes) -> Bool =
  fold(e.ops, false, |acc: Bool, o: OpMode| if o.name == op { o.write } else { acc })

// Every effect name a module's scope binds, bare or through a module binder, with the name
// the program knows it by.
fn effects_in(r: Resolved, i: Int, mods: List<Mod>) -> List<EffectName> =
  match list_at(r.scopes, i) {
    None -> [],
    Some(scope) -> {
      let bare = map(scope.bound.effects, |b: Binding| { written: b.name, global: b.qualified, ops: ops_of(mods, b.owner, b.name) });
      fold(scope.modules, bare, |acc: List<EffectName>, mb: ModBind|
        match list_at(r.declared, mb.target) {
          None -> acc,
          Some(theirs) -> fold(theirs.effects, acc, |a: List<EffectName>, b: Binding|
            push(a, { written: bytes_concat_all([mb.binder, b"::", b.name]), global: b.qualified, ops: ops_of(mods, mb.target, b.name) })),
        })
    },
  }

// The operations an effect declares, with their modes, from the module that declares it.
fn ops_of(mods: List<Mod>, owner: Int, name: Bytes) -> List<OpMode> =
  match list_at(mods, owner) {
    None -> [],
    Some(m) -> fold(m.module.items, [], |acc: List<OpMode>, it: Item| match it {
      IEffect(e) -> if e.name.name == name {
        map(e.ops, |o: OpDef| { name: o.name.name, write: match o.mode { MWrite -> true, _ -> false } })
      } else { acc },
      _ -> acc,
    }),
  }

// A clause that binds `resume` may only call it in tail position, once along any path: that is
// the clause the tier carries as a plain call or an unwind. Every read of the binder must be
// such a call.
fn resume_in_tail_only(body: Code, k: Int) -> Bool =
  count_of(slots_read(body), k) == tail_calls_of(body, k)

fn tail_calls_of(c: Code, k: Int) -> Int =
  match c.node {
    NApp(a) -> match a.func.node {
      NVar(v) -> if v.slot == Some(k) && len(a.args) == 1 && count_of(all_read(a.args), k) == 0 { 1 } else { 0 },
      _ -> 0,
    },
    NIf(i) -> tail_calls_of(i.then_branch, k) + tail_calls_of(i.else_branch, k),
    NBlock(b) -> match b.tail { Some(t) -> tail_calls_of(t, k), None -> 0 },
    NMatch(m) -> fold(m.arms, 0, |acc: Int, a: CArm| acc + tail_calls_of(a.body, k)),
    _ -> 0,
  }

// A `handle` site: each clause body and the `return` body become closures as a lambda does;
// the frame is pushed, the body emitted inline with its failing calls landing here, and the
// landing pops the frame, applies the `return` clause to a body that completed, and catches an
// unwind aimed at this frame.
fn handle_site(em: Em, body: Code, clauses: List<CClause>, ret: Option<CRet>, params: List<P>) -> Option<Out> = {
  let named = fold(clauses, Some([]), |acc: Option<List<{ global: Bytes, c: CClause }>>, c: CClause|
    match acc {
      None -> None,
      Some(xs) -> match effect_global(em, c.effect) { Some(g) -> Some(push(xs, { global: g, c: c })), None -> None },
    });
  // A clause that binds `resume` and calls it off the tail detaches the body: it runs on a stack
  // of its own and the clause on the resumer's, so the body is a closure rather than inline.
  let detached = fold(clauses, false, |acc: Bool, c: CClause| acc || (c.resume && !resume_in_tail_only(c.body, c.params)));
  match named {
    None -> Some(refused(em, b"a `handle` this tier cannot carry: an effect it cannot resolve")),
    Some(cs) -> {
      let ans = fresh(em);
      let opened = line(ans.em, bytes_concat_all([b"Word ", ans.name, b" = 0;"]));
      match fold(cs, Some({ em: opened, entries: [] }), |acc: Option<{ em: Em, entries: List<Bytes> }>, x: { global: Bytes, c: CClause }|
        match acc {
          None -> None,
          Some(st) -> {
            let lam = { own: Borrowed, node: NLambda({ params: x.c.params + (if x.c.resume { 1 } else { 0 }),
                                                       size: x.c.size, caps: x.c.caps, body: x.c.body }) };
            match expr(notail(st.em), lam, params) {
              None -> None,
              Some(cl) -> {
                let held = owned(cl.em, cl.v);
                let ef = field_of(held.em, x.global);
                let res = if x.c.resource == b"" { None } else { Some(field_of(ef.em, x.c.resource)) };
                let op = field_of(match res { Some(r) -> r.em, None -> ef.em }, x.c.op);
                Some({ em: note_handles(op.em, bytes_concat_all([x.global, b"#", x.c.op])),
                       entries: push(st.entries, bytes_concat_all([field_ref(ef.i), b", ",
                         match res { Some(r) -> field_ref(r.i), None -> b"-1" }, b", ", field_ref(op.i), b", ",
                         held.v.c, b", ",
                         if !x.c.resume { b"0" } else if resume_in_tail_only(x.c.body, x.c.params) { b"1" } else { b"2" }])) })
              },
            }
          },
        }) {
        None -> None,
        Some(built) -> {
          let arr = fresh(built.em);
          let table = line(arr.em, bytes_concat_all([b"Word ", arr.name, b"[] = {", bytes_join(built.entries, b", "), b"};"]));
          let retc = match ret {
            None -> Some({ em: table, c: b"0" }),
            Some(r) -> {
              let lam = { own: Borrowed, node: NLambda({ params: 1, size: r.size, caps: r.caps, body: r.body }) };
              match expr(notail(table), lam, params) {
                None -> None,
                Some(cl) -> { let held = owned(cl.em, cl.v); Some({ em: held.em, c: held.v.c }) },
              }
            },
          };
          match retc {
            None -> None,
            Some(rc) -> if detached {
              // The body closes over every slot it reads, at the same slot numbers, so nothing in
              // it is renumbered; the runtime runs it on its own stack.
              let reads = filter(dedup(slots_read(body)), |r: Int|
                match conv_of(rc.em, r) { Some(_) -> true, None -> match list_at(params, r) { Some(_) -> true, None -> false } });
              let lam = { own: Borrowed, node: NLambda({ params: 0, size: fold(reads, 0, |m: Int, r: Int| if r + 1 > m { r + 1 } else { m }),
                                                         caps: map(reads, |r: Int| { src: r, dst: r, own: Borrowed }), body: body }) };
              match expr(notail(rc.em), lam, params) {
                None -> None,
                Some(cl) -> {
                  let held = owned(cl.em, cl.v);
                  let out = bind(held.em, KBoxed, bytes_concat_all([b"rt_handle_detached_p(ctx, (Word)(intptr_t)", arr.name, b", ", num(len(cs)), b", ", rc.c, b", ", held.v.c, b")"]));
                  Some({ em: check(out.em), v: out.v })
                },
              }
            } else {
              let depth = bind(rc.em, KInt, bytes_concat_all([b"rt_handle_push_p(ctx, (Word)(intptr_t)", arr.name, b", ", num(len(cs)), b", ", rc.c, b")"]));
              let mark = fresh(depth.em);
              let label = bytes_concat(b"land_", num(mark.em.n));
              // Under release the body is a block of its own: a failing call jumps to the label
              // past the declarations after it, so what the body holds is released at the block's
              // close and is out of scope at the label. What the body may have moved is released
              // at the enclosing scope's end on the path that did not run it.
              let opened = if mark.em.release { indent(line(mark.em, b"{")) } else { mark.em };
              match expr(notail(with_landing(opened, Some(label))), body, params) {
                None -> None,
                Some(b) -> {
                  let bw = owned(b.em, b.v);
                  let set = line(bw.em, bytes_concat_all([ans.name, b" = ", bw.v.c, b";"]));
                  let closed = if set.release { with_made(close(set), union_made(mark.em.made, release_at(set, set.ind).made)) } else { set };
                  let landed = line(with_landing(closed, em.landing), bytes_concat_all([label, b":;"]));
                  let out = bind(landed, KBoxed, bytes_concat_all([b"rt_handle_land_p(ctx, ", depth.v.c, b", ", ans.name, b")"]));
                  Some({ em: check(out.em), v: out.v })
                },
              }
            },
          }
        },
      }
    },
  }
}

fn dedup(xs: List<Int>) -> List<Int> =
  fold(xs, [], |acc: List<Int>, x: Int| if count_of(acc, x) > 0 { acc } else { push(acc, x) })

// The items of a list, left to right, each boxed into its own `Word` local.
// One pass, and **not** the two an argument list makes. An aggregate's item is
// held once more as soon as it is evaluated; a call's arguments are all
// evaluated and only then held. Both orders were tried against the corpus and
// each is wrong in the other's place.
fn items(em: Em, xs: List<Code>, params: List<P>, i: Int, acc: List<Bytes>)
    -> Option<{ em: Em, names: List<Bytes>, vals: List<V> }> =
  items_from(em, xs, params, i, acc, [])

fn items_from(em: Em, xs: List<Code>, params: List<P>, i: Int, acc: List<Bytes>, vs: List<V>)
    -> Option<{ em: Em, names: List<Bytes>, vals: List<V> }> =
  if i >= len(xs) { Some({ em: em, names: acc, vals: vs }) } else {
    match list_at(xs, i) {
      None -> None,
      Some(x) -> match expr(notail(em), x, params) {
        None -> None,
        Some(o) -> {
          let w = owned(o.em, o.v);
          items_from(w.em, xs, params, i + 1, push(acc, w.v.c), push(vs, taken_as(w.em, o.v, w.v)))
        },
      },
    }
  }

// The value a record remembers a field by, once the record has taken the word: under release
// the temporary it came from is null, so the word the record holds is remembered instead.
fn taken_as(em: Em, v: V, w: V) -> V =
  if em.release && v.k == KBoxed { { k: KBoxed, c: w.c, ty: v.ty } } else { v }

// A value read now and taken later, held once more now: the machine clones at the read, and a
// read in between may be the binding's last use and move it. Under release only; the reference
// holds everything after evaluating everything.
fn secure(em: Em, v: V) -> Out =
  if !em.release || v.k != KBoxed || spendable(em, v.c) { { em: em, v: v } } else {
    let w = owned(em, v);
    { em: note_made(w.em, w.v.c), v: { k: KBoxed, c: w.v.c, ty: v.ty } }
  }

fn secured(o: Option<Out>) -> Option<Out> =
  match o { None -> None, Some(x) -> Some(secure(x.em, x.v)) }

fn bytes_join(xs: List<Bytes>, sep: Bytes) -> Bytes =
  fold(range(0, len(xs)), b"", |acc: Bytes, i: Int|
    bytes_concat_all([acc, if i == 0 { b"" } else { sep },
                      match list_at(xs, i) { Some(x) -> x, None -> b"" }]))

// A block's statements, in order. A `let` binds its value under its own name --
// the reference writes the rename even when the value is already a temporary --
// and records it against the slot the body reads it back through.
fn stmts(em: Em, xs: List<CStmt>, params: List<P>, i: Int) -> Option<Em> =
  if i >= len(xs) { Some(em) } else {
    match list_at(xs, i) {
      None -> None,
      Some(st) -> match st {
        CLet(l) -> match expr(notail(em), l.value, params) {
          None -> None,
          Some(o) -> {
            // The type stays with the binding, as the reference keeps it.
            let b = bind_keeping(o.em, o.v.k, o.v.ty, o.v.c);
            stmts(remember(ensure_owned(b.em, b.v), l.slot, b.v), xs, params, i + 1)
          },
        },
        // The value is held as a word and the pattern's names are bound from it, as an arm's are.
        // A refutable `let` first tests the pattern and raises rather than reading a field that is
        // not there (a `let Circle(r) = s` on a `Tri`); an irrefutable one has nothing to test.
        CLetPat(l) -> match expr(notail(em), l.value, params) {
          None -> None,
          Some(o) -> {
            let w = word_of(o.em, o.v);
            let held = bind(w.em, KBoxed, w.c);
            let checked = if irrefutable(l.pat) { Some(held.em) } else {
              match pat_test(l.pat, held.v, held.em) {
                None -> None,
                Some(t) -> Some(line(t.em, bytes_concat_all([b"if (!(", t.c, b")) { rt_let_no_match_p(ctx); return 0; }"]))),
              }
            };
            match checked {
              None -> None,
              Some(gem) -> stmts(pat_bind(gem, l.pat, held.v), xs, params, i + 1),
            }
          },
        },
        CDo(d) -> match expr(notail(em), d.code, params) {
          None -> None,
          Some(o) -> stmts(drop_value(line(o.em, bytes_concat_all([b"(void)(", as_word(o.v), b");"])), o.v), xs, params, i + 1),
        },
      },
    }
  }

// The arms, in order. Each is guarded by the flag rather than by an `else`, so
// an arm's own test is written at one depth whatever the arm before it did.
fn arms(em: Em, xs: List<CArm>, params: List<P>, i: Int, subj: V, ans: Bytes, flag: Bytes,
        base: List<Made>, seen: List<Made>)
    -> Option<Em> =
  if i >= len(xs) { Some(with_made(em, if i == 0 { em.made } else { seen })) } else {
    match list_at(xs, i) {
      None -> None,
      // A guard is a second test after the pattern binds, and this port does not
      // reach one yet.
      Some(a) -> if a.guard != None { Some(poison(em, b"a match guard")) } else {
        match pat_test(a.pat, subj, indent(line(with_made(em, base), bytes_concat_all([b"if (!", flag, b") {"])))) {
          None -> Some(poison(em, b"a pattern this port cannot test")),
          Some(t) -> {
            let opened = line(t.em, bytes_concat_all([b"if (", t.c, b") {"]));
            let inner = indent(opened);
            let bound = pat_bind(inner, a.pat, subj);
            match expr(bound, a.body, params) {
              None -> None,
              Some(o) -> {
                let w = word_of(o.em, o.v);
                let done = line(assign_owned(line(w.em, bytes_concat_all([ans, b" = ", w.c, b";"])), ans, w.c),
                                bytes_concat_all([flag, b" = 1;"]));
                let closed = close(close(done));
                // The next arm is a tail when this one was: the body's own nodes cleared the flag.
                arms(withtail(rescope(closed, em.conv), em.tail), xs, params, i + 1, subj, ans, flag,
                     base, union_made(seen, closed.made))
              },
            }
          },
        }
      },
    }
  }

// The C condition an arm's pattern is. `1` where the pattern cannot fail.
// A pattern that cannot fail: the reference's `irrefutable_pat`. A nullary constructor
// wearing a variable's shape never arrives from the parser, which makes every upper-case bare
// name in pattern position a constructor, so a variable is irrefutable here.
fn irrefutable(p: CPat) -> Bool =
  match p { PxWild -> true, PxVar(_) -> true, _ -> false }

// The C condition an arm's pattern is, and the state after the reads the test itself
// needs: a nested pattern tests a field held in a local, guarded by the test built so far,
// because a read of a non-record raises rather than answering. `1` where the pattern cannot
// fail; `None` for a pattern the reference refuses too.
fn pat_test(p: CPat, subj: V, em: Em) -> Option<{ em: Em, c: Bytes }> =
  match p {
    PxWild -> Some({ em: em, c: b"1" }),
    PxVar(_) -> Some({ em: em, c: b"1" }),
    PxLit(l) -> match l {
      LInt(n) -> Some({ em: em, c: bytes_concat_all([b"(ply_is_imm(", subj.c, b") ? ply_imm_value(", subj.c,
                                        b") == ", int_lit(n), b" : 0)"]) }),
      LFixed(_, bits) -> Some({ em: em, c: bytes_concat_all([b"(ply_is_imm(", subj.c, b") ? ply_imm_value(", subj.c,
                                        b") == ", int_lit(bits), b" : 0)"]) }),
      LBool(b) -> Some({ em: em, c: bytes_concat_all([b"(", subj.c, b" == ", if b { b"ply_true" } else { b"ply_false" }, b")"]) }),
      _ -> None,
    },
    // A constructor is its tag and its width, over an object rather than an immediate. An
    // argument with a test of its own is read into a local first, under the test so far.
    PxCtor(c) -> match tag_of(em, c.name) {
      None -> None,
      Some(tag) -> {
        let head = bytes_concat_all([
          b"(!ply_is_imm(", subj.c, b") && ply_obj(", subj.c, b")->kind == 4 && ply_obj(",
          subj.c, b")->layout == ", num(tag), b" && ply_obj(", subj.c, b")->len == ",
          num(len(c.args)), b")"]);
        fold(range(0, len(c.args)), Some({ em: em, c: head }),
          |acc: Option<{ em: Em, c: Bytes }>, k: Int| match acc {
            None -> None,
            Some(t) -> match list_at(c.args, k) {
              None -> None,
              Some(sub) -> if irrefutable(sub) { Some(t) } else {
                let field = bind(t.em, KBoxed, bytes_concat_all([
                  b"(", t.c, b" ? ply_words(", subj.c, b")[", num(k), b"] : 0)"]));
                match pat_test(sub, field.v, field.em) {
                  None -> None,
                  Some(inner) -> Some({ em: inner.em, c: bytes_concat_all([b"(", t.c, b" && ", inner.c, b")"]) }),
                }
              },
            },
          })
      },
    },
    // Refutable despite the shape: on a value that is not a record, on the field count when
    // there is no `..`, and on a field the value does not have.
    PxRecord(r) -> {
      let head = bytes_concat_all([b"rt_record_fits_p(ctx, ", subj.c, b", ", num(len(r.fields)),
                                   b", ", if r.rest { b"0" } else { b"1" }, b")"]);
      fold(r.fields, Some({ em: em, c: head }),
        |acc: Option<{ em: Em, c: Bytes }>, f: CPatField| match acc {
          None -> None,
          Some(t) -> {
            let idx = field_of(t.em, f.name);
            let has = bytes_concat_all([b"(", t.c, b" && rt_record_has_p(ctx, ", subj.c, b", @@f", num(idx.i), b"@@))"]);
            if irrefutable(f.pat) { Some({ em: idx.em, c: has }) } else {
              let field = bind(idx.em, KBoxed, bytes_concat_all([
                b"(", has, b" ? rt_field_p(ctx, ", subj.c, b", @@f", num(idx.i), b"@@, 0) : 0)"]));
              match pat_test(f.pat, field.v, note_holder(check(field.em), field.v.c)) {
                None -> None,
                Some(inner) -> Some({ em: inner.em, c: bytes_concat_all([b"(", has, b" && ", inner.c, b")"]) }),
              }
            }
          },
        })
    },
    // A refutable `..rest` would need the tail built before it could be tested, which is a
    // list allocated inside a test that may fail; the reference draws the same line.
    PxList(l) ->
      if match l.rest { Some(r) -> !irrefutable(r), None -> false } { None } else {
        let head = bytes_concat_all([b"rt_list_fits_p(ctx, ", subj.c, b", ", num(len(l.items)),
                                     b", ", match l.rest { Some(_) -> b"0", None -> b"1" }, b")"]);
        fold(range(0, len(l.items)), Some({ em: em, c: head }),
          |acc: Option<{ em: Em, c: Bytes }>, i: Int| match acc {
            None -> None,
            Some(t) -> match list_at(l.items, i) {
              None -> None,
              Some(item) -> if irrefutable(item) { Some(t) } else {
                let at = bind(t.em, KBoxed, bytes_concat_all([
                  b"(", t.c, b" ? rt_list_at_p(ctx, ", subj.c, b", ", num(i), b") : 0)"]));
                match pat_test(item, at.v, note_holder(check(at.em), at.v.c)) {
                  None -> None,
                  Some(inner) -> Some({ em: inner.em, c: bytes_concat_all([b"(", t.c, b" && ", inner.c, b")"]) }),
                }
              },
            },
          })
      },
  }

// What the pattern names, bound to the subject. A constructor's argument is a
// word out of the object, held once more because the object still holds it.
fn pat_bind(em: Em, p: CPat, subj: V) -> Em =
  match p {
    // The binder is the subject under another name, and carries its shape: a
    // `match r { x -> x.f }` reads the field at an offset, not by name.
    PxVar(v) -> match v.slot {
      None -> em,
      Some(s) -> { let b = bind_keeping(em, KBoxed, subj.ty, subj.c); remember(ensure_owned(b.em, b.v), s, b.v) },
    },
    // **Every** argument is read out and held once more, whether or not the
    // pattern names it: the object still holds it, and the arm's scope is the
    // same shape either way. A named one is then renamed into scope, exactly as
    // a `let` renames its value.
    PxCtor(c) -> fold(range(0, len(c.args)), em, |acc: Em, i: Int| {
      let w = bind(acc, KBoxed,
        bytes_concat_all([b"ply_words(", subj.c, b")[", num(i), b"]"]));
      let inc = note_holder(line(w.em, bytes_concat_all([b"ply_inc(", w.v.c, b");"])), w.v.c);
      match list_at(c.args, i) { Some(sub) -> pat_bind(inc, sub, w.v), None -> inc }
    }),
    // The runtime's read by name answers the field held once more, so there is no
    // increment to add here.
    PxRecord(r) -> fold(r.fields, em, |acc: Em, f: CPatField| {
      let idx = field_of(acc, f.name);
      let field = bind(idx.em, KBoxed, bytes_concat_all([
        b"rt_field_p(ctx, ", subj.c, b", @@f", num(idx.i), b"@@, 0)"]));
      pat_bind(check(field.em), f.pat, field.v)
    }),
    PxList(l) -> {
      let items = fold(range(0, len(l.items)), em, |acc: Em, i: Int| {
        let at = bind(acc, KBoxed, bytes_concat_all([b"rt_list_at_p(ctx, ", subj.c, b", ", num(i), b")"]));
        match list_at(l.items, i) { Some(item) -> pat_bind(check(at.em), item, at.v), None -> check(at.em) }
      });
      match l.rest {
        None -> items,
        Some(r) -> {
          let tail = bind(items, KBoxed, bytes_concat_all([
            b"rt_list_rest_p(ctx, ", subj.c, b", ", num(len(l.items)), b")"]));
          pat_bind(check(tail.em), r, tail.v)
        },
      }
    },
    _ -> em,
  }

// One arm of an `if`, into a buffer of its own so that what follows it can still
// be numbered. The bind the reference writes here belongs to the block lowering
// wrapped the branch in, so nothing is added.
fn arm(em: Em, c: Code, params: List<P>) -> Option<{ em: Em, text: Bytes, v: V }> =
  match expr(indent(em), c, params) {
    None -> None,
    Some(o) -> Some({ em: outdent(o.em), text: bytes_join(o.em.out, b""), v: o.v }),
  }

// The same buffer with the join's assignment on the end.
fn assigned(em: Em, arm_em: Em, text: Bytes, ind: Int, k: Kind, v: V, join: Bytes) -> { em: Em, text: Bytes, made: List<Made> } = {
  let m0 = match k { KBoxed -> materialise(indent(with_out(em, [])), v.c), _ -> indent(with_out(em, [])) };
  let m1 = line(m0, bytes_concat_all([join, b" = ", as_kind(v, k), b";"]));
  // The join takes the arm's value, and the arm's own holders are released behind it.
  let m2 = if k == KBoxed { assign_owned(with_made(m1, arm_em.made), join, v.c) } else { with_made(m1, arm_em.made) };
  let m3 = release_at(m2, ind + 1);
  { em: outdent(with_out(with_made(m3, em.made), em.out)),
    text: bytes_concat_all([text, bytes_join(m3.out, b"")]), made: m3.made }
}

// A value as the kind a join holds it in: the reference's `as_kind`.
fn as_kind(v: V, k: Kind) -> Bytes =
  match k {
    KBoxed -> as_word(v),
    KInt -> as_int(v),
    KBool -> as_bool(v),
    KNum(w) -> as_num(v, w),
  }

// The same, for a record-valued join: one assignment per field, from the values
// the record was built out of rather than from the record.
fn joined(em: Em, arm_em: Em, text: Bytes, v: V, names: List<Bytes>, js: List<V>) -> { text: Bytes, made: List<Made> } = {
  let a0 = with_made(indent(with_out(em, [])), arm_em.made);
  let a1 = fold(range(0, len(names)), a0, |acc: Em, i: Int| {
    let target = match list_at(js, i) { Some(x) -> x.c, None -> b"" };
    let jk = match list_at(js, i) { Some(x) -> x.k, None -> KInt };
    let fv = match list_at(names, i) { Some(nm) -> built_field(em, v.c, nm), None -> None };
    let l = line(acc, bytes_concat_all([target, b" = ", match fv { Some(x) -> as_kind(x, jk), None -> b"0" }, b";"]));
    if jk == KBoxed { match fv { Some(x) -> assign_owned(l, target, x.c), None -> l } } else { l }
  });
  let a2 = release_at(a1, em.ind + 1);
  { text: bytes_concat_all([text, bytes_join(a2.out, b"")]), made: a2.made }
}

fn blank(em: Em) -> Em =
  { out: [], n: em.n, conv: em.conv, ind: em.ind, reads: em.reads, shapes: em.shapes,
    built: em.built, module: em.module, made: em.made, here: em.here, imports: em.imports,
    consts: em.consts, ctors: em.ctors, extra: em.extra, lambdas: em.lambdas, owner: em.owner,
    builtins: em.builtins, met: em.met, fields: em.fields, released: em.released, toks: em.toks, alias: em.alias, by_root: em.by_root, tail: em.tail, calls: em.calls, refused: em.refused, deferred: em.deferred, rlocals: em.rlocals, performs: em.performs, handles: em.handles, landing: em.landing, effects: em.effects, release: em.release, pinned: em.pinned, bound: em.bound }

fn strip(em: Em) -> Bytes = bytes_join(em.out, b"")

// The shape both arms answer, when both answer a record this body built and the
// two shapes are the same. `None` otherwise, and then the join is one local.
fn shared_shape(em: Em, a: V, b: V) -> Option<List<Bytes>> =
  match a.ty {
    TyRec(na) -> match b.ty {
      TyRec(nb) -> if same_names(names_of(na), names_of(nb))
                      && fold(sorted_names(names_of(na)), true, |acc: Bool, nm: Bytes| acc &&
                           match built_field(em, a.c, nm) {
                             None -> false,
                             Some(x) -> match built_field(em, b.c, nm) {
                               None -> false,
                               Some(y) -> x.k == y.k && x.k != KBoxed,
                             },
                           })
                   { Some(sorted_names(names_of(na))) }
                   else { None },
      _ -> None,
    },
    _ -> None,
  }

fn first_name(ns: List<Bytes>) -> Bytes = match list_at(ns, 0) { Some(n) -> n, None -> b"" }

// The record's names in the order the shape holds them, which is by name.
fn sorted_names(ns: List<Bytes>) -> List<Bytes> =
  fold(range(0, len(ns)), [], |acc: List<Bytes>, i: Int|
    fold(ns, acc, |a2: List<Bytes>, n: Bytes| if rank_of(ns, n) == i { push(a2, n) } else { a2 }))

// The record the join's fields are assembled back into, after the arms close.
fn rebuild(em: Em, names: List<Bytes>, js: List<V>) -> Option<Out> =
  Some(build_record(em, names, map(js, |x: V| as_word(x)), map(js, |x: V| x.k), Some(js)))

// The `Int` two literals fold to under an operator, or nothing: the reference's
// `fold_literals`, rule for rule. Addition, subtraction and multiplication only
// when they do not overflow; a shift only by a count the width holds.
// `INT64_C(-9223372036854775808)` is not a constant C can write -- the digits are an
// unsigned literal and the minus is applied to it, so `1 << 63 < 0` came out false -- and the
// least `Int` is named instead.
fn int_lit(n: Int) -> Bytes =
  if n == 0 - 9223372036854775807 - 1 { b"INT64_MIN" } else { bytes_concat_all([b"INT64_C(", num(n), b")"]) }

fn lit_int(c: Code) -> Option<Int> =
  match c.node {
    NLit(l) -> match l { LInt(n) -> Some(n), _ -> None },
    NBinary(b) -> match lit_int(b.lhs) {
      None -> None,
      Some(a) -> match lit_int(b.rhs) {
        None -> None,
        Some(x) ->
          if b.op == b"add" { checked_add(a, x) }
          else if b.op == b"sub" { checked_sub(a, x) }
          else if b.op == b"mul" { checked_mul(a, x) }
          else if b.op == b"bitand" { Some(a & x) }
          else if b.op == b"bitor" { Some(a | x) }
          else if b.op == b"bitxor" { Some(a ^ x) }
          else if b.op == b"shl" && x >= 0 && x < 64 { Some(a << x) }
          else if b.op == b"shr" && x >= 0 && x < 64 { Some(a >> x) }
          else if b.op == b"ushr" && x >= 0 && x < 64 { Some(a >>> x) }
          else { None },
      },
    },
    _ -> None,
  }

fn checked_add(a: Int, b: Int) -> Option<Int> = {
  let s = wrap_add(a, b);
  if (a >= 0) == (b >= 0) && (s >= 0) != (a >= 0) { None } else { Some(s) }
}

fn checked_sub(a: Int, b: Int) -> Option<Int> = {
  let s = wrap_sub(a, b);
  if (a >= 0) != (b >= 0) && (s >= 0) != (a >= 0) { None } else { Some(s) }
}

fn checked_mul(a: Int, b: Int) -> Option<Int> =
  if a == 0 || b == 0 { Some(0) }
  else if a == -1 { checked_sub(0, b) }
  else if b == -1 { checked_sub(0, a) }
  else {
    let p = wrap_mul(a, b);
    if p / a == b && p % a == 0 { Some(p) } else { None }
  }

// Whether a node answers a `Float` or `Decimal`, without emitting it: what the
// emission's typing says, read structurally, so a join can be known first.
fn opaque_of(em: Em, c: Code) -> Bool =
  match c.node {
    NVar(v) -> match v.slot {
      None -> false,
      Some(s) -> match conv_of(em, s) { Some(x) -> x.ty == TyOpaque, None -> false },
    },
    NBinary(b) -> is_arith(b.op) && (opaque_of(em, b.lhs) || opaque_of(em, b.rhs)),
    NBlock(b) -> match b.tail { Some(t) -> opaque_of(em, t), None -> false },
    NApp(a) -> match a.func.node {
      NVar(fv) -> match fv.slot {
        Some(_) -> false,
        // A definition of this module answers its declared type; a builtin answers
        // opaque over an opaque argument.
        None -> if fold(em.here, false, |acc: Bool, h: Def| acc || h.name == fv.name) {
                  ret_of(em.here, fv.name).ty == TyOpaque
                } else {
                  fold(a.args, false, |acc: Bool, x: Code| acc || opaque_of(em, x))
                },
      },
      _ -> false,
    },
    _ -> false,
  }

// Where two arms disagree the join is a word, and each is converted into it.
fn join_kind(a: Kind, b: Kind) -> Kind = if a == b { a } else { KBoxed }

fn coerce(em: Em, k: Kind, v: V) -> Out =
  match k {
    KBoxed -> { em: em, v: { k: KBoxed, c: as_word(v), ty: v.ty } },
    _ -> { em: em, v: { k: k, c: as_int(v), ty: TyOpen } },
  }

fn is_arith(op: Bytes) -> Bool =
  op == b"add" || op == b"sub" || op == b"mul" || op == b"div" || op == b"rem"

fn is_bitop(op: Bytes) -> Bool = op == b"bitand" || op == b"bitor" || op == b"bitxor"

fn is_shift(op: Bytes) -> Bool = op == b"shl" || op == b"shr" || op == b"ushr"

fn bitop_c(op: Bytes) -> Bytes = if op == b"bitand" { b"&" } else if op == b"bitor" { b"|" } else { b"^" }

// A wide result narrowed to a width, under the overflow guard: the reference's `narrow`.
// `code` is `rt_overflow_p`'s: 0 an addition, 1 a subtraction, 2 a negation.
fn narrow(wide: Out, w: Width, code: Int) -> Option<Out> = {
  let g = line(wide.em, bytes_concat_all([b"if (", wide.v.c, b" < ", int_lit(width_min(w)),
    b" || ", wide.v.c, b" > ", int_lit(width_max(w)), b") { rt_overflow_p(ctx, ",
    num(code), b"); return 0; }"]));
  Some(bind(g, KNum(w), bytes_concat_all([b"(", ctype(KNum(w)), b")", wide.v.c])))
}

// A shift: the count is tested against the width -- sixty-four for `Int` -- and the shift is
// done unsigned where C would otherwise leave it undefined.
fn shift(em: Em, op: Bytes, l: V, r: V, width: Option<Width>) -> Out = {
  let bound = match width { Some(t) -> t.bits, None -> 64 };
  let count = bind(em, KInt, as_int(r));
  let which = match width { Some(t) -> num(width_index(t)), None -> b"-1" };
  let g = line(count.em, bytes_concat_all([b"if ((uint64_t)", count.v.c, b" >= (uint64_t)", num(bound),
    b") { rt_shift_count_p(ctx, ", count.v.c, b", ", which, b"); return 0; }"]));
  match width {
    Some(t) -> {
      let a = as_num(l, t);
      let u = utype(t);
      bind(g, KNum(t),
        if op == b"shl" { bytes_concat_all([b"(", u, b")((", u, b")(", a, b") << ", count.v.c, b")"]) }
        else if op == b"shr" && t.signed { bytes_concat_all([b"(", a, b") >> ", count.v.c]) }
        else { bytes_concat_all([b"(", u, b")((", u, b")(", a, b") >> ", count.v.c, b")"]) })
    },
    None -> {
      let a = as_int(l);
      bind(g, KInt,
        if op == b"shl" { bytes_concat_all([b"(int64_t)((uint64_t)(", a, b") << ", count.v.c, b")"]) }
        else if op == b"shr" { bytes_concat_all([b"(", a, b") >> ", count.v.c]) }
        else { bytes_concat_all([b"(int64_t)((uint64_t)(", a, b") >> ", count.v.c, b")"]) })
    },
  }
}

// An operator over a width: both operands as the width's C type, arithmetic done wide and
// narrowed back under the overflow guard, the rest in the width itself.
fn width_binary(em: Em, op: Bytes, l: V, r: V, t: Width) -> Option<Out> = {
  let a = as_num(l, t);
  let bb = as_num(r, t);
  if is_arith(op) {
    let wide = if op == b"add" { bind(em, KInt, bytes_concat_all([b"(int64_t)(", a, b") + (int64_t)(", bb, b")"])) }
      else if op == b"sub" { bind(em, KInt, bytes_concat_all([b"(int64_t)(", a, b") - (int64_t)(", bb, b")"])) }
      else {
        let w = bind(em, KInt, bytes_concat_all([b"rt_arith_p(ctx, ", num(arith_code(op)), b", (int64_t)(", a, b"), (int64_t)(", bb, b"))"]));
        { em: check(w.em), v: w.v }
      };
    narrow(wide, t, if op == b"sub" { 1 } else { 0 })
  }
  else if is_bitop(op) { Some(bind(em, KNum(t), bytes_concat_all([b"(", a, b") ", bitop_c(op), b" (", bb, b")"]))) }
  else if is_shift(op) { Some(shift(em, op, l, r, Some(t))) }
  else if op == b"eq" { Some(bind(em, KBool, bytes_concat_all([b"(", a, b") == (", bb, b")"]))) }
  else if op == b"ne" { Some(bind(em, KBool, bytes_concat_all([b"!((", a, b") == (", bb, b"))"]))) }
  else { match compare_op(op) {
    Some(c) -> Some(bind(em, KBool, bytes_concat_all([b"(", a, b") ", c, b" (", bb, b")"]))),
    None -> None,
  } }
}

// Every operator but the two that short-circuit and `++`, over two evaluated operands. A width
// on either side decides the whole operator; otherwise `Int` is C's own, a `Bool` equality is
// too, and anything a word holds goes through the runtime.
fn binary_rest(em: Em, op: Bytes, l: V, r: V) -> Option<Out> = {
  let width = match l.k { KNum(t) -> Some(t), _ -> match r.k { KNum(t) -> Some(t), _ -> None } };
  match width {
    Some(t) -> width_binary(em, op, l, r, t),
    None -> {
      let native = (l.k == KInt && r.k == KInt) || (l.k == KBool && r.k == KBool);
      // Equality over anything that is not already an untagged scalar is
      // the runtime's, which walks the two values. The C operator would
      // compare two *words* -- two pointers, for a record or a
      // constructor -- and answer no for equal values.
      if (op == b"eq" || op == b"ne") && !native {
        // The helper reads both. Under release they are handed over as they are held, and a
        // temporary among them is released at its scope's end; the reference holds each once
        // more and never lets go.
        let lo = if em.release { let w = word_of(em, l); { em: w.em, v: { k: KBoxed, c: w.c, ty: l.ty } } } else { owned(em, l) };
        let ro = if lo.em.release { let w = word_of(lo.em, r); { em: w.em, v: { k: KBoxed, c: w.c, ty: r.ty } } } else { owned(lo.em, r) };
        let e = bind(ro.em, KBool, bytes_concat_all([
          b"rt_equal_p(ctx, ", lo.v.c, b", ", ro.v.c, b")"]));
        // The helper walks two values and can raise, so the check follows.
        // The answer is then bound under a name of its own -- and for `!=`
        // that binding *is* the negation rather than following one.
        Some(bind(check(e.em), KBool,
          if op == b"ne" { bytes_concat_all([b"!(", e.v.c, b")"]) } else { e.v.c }))
      } else if (is_bitop(op) || is_shift(op)) && (l.ty == TyOpaque || r.ty == TyOpaque) {
        Some(refused(em, b"a bitwise operator over a Float or Decimal"))
      } else if l.k == KBoxed && r.k == KBoxed && (is_arith(op) || compare_op(op) != None) {
        {
          // A `Float` or `Decimal` operand, or two words of a type this port cannot see -- which
          // may both be `Decimal`s: the machine's own operator, through the runtime, so the body
          // answers what the machine answers. One operand in a register is an `Int` the checker
          // vouched for on both sides.
          let lo = owned(em, l);
          let ro = owned(lo.em, r);
          // The answer's type is the reference's: a comparison answers a `Bool`, an operator
          // over an opaque left operand answers opaque, and otherwise it takes the right's.
          let o = bind_keeping(ro.em, KBoxed,
            if compare_op(op) != None { TyOpen } else if l.ty == TyOpaque { TyOpaque } else { r.ty },
            bytes_concat_all([b"rt_binary_p(ctx, ", num(binary_code(op)), b", ",
                              lo.v.c, b", ", ro.v.c, b")"]));
          Some({ em: check(o.em), v: o.v })
        }
      } else if is_shift(op) { Some(shift(em, op, l, r, None)) }
      else if is_bitop(op) {
        Some(bind(em, KInt, bytes_concat_all([b"(", as_int(l), b") ", bitop_c(op), b" (", as_int(r), b")"])))
      } else {
        let a = { k: KInt, c: as_int(l), ty: TyOpen };
        let bb = { k: KInt, c: as_int(r), ty: TyOpen };
        match compare_op(op) {
          // `!=` is written as the negation of `==`, which is what the
          // reference emits: one comparison in the C for the two spellings.
          Some(c) -> Some(bind(em, KBool,
            if op == b"ne" { bytes_concat_all([b"!((", a.c, b") == (", bb.c, b"))"]) }
            else { bytes_concat_all([b"(", a.c, b") ", c, b" (", bb.c, b")"]) })),
          None -> Some(arithmetic(em, op, a, bb)),
        }
      }
    },
  }
}

// The six orderings, which compile to C's own on the untagged integers rather
// than to a helper: an `Int` comparison cannot raise.
fn compare_op(op: Bytes) -> Option<Bytes> =
  if op == b"lt" { Some(b"<") }
  else if op == b"le" { Some(b"<=") }
  else if op == b"gt" { Some(b">") }
  else if op == b"ge" { Some(b">=") }
  else if op == b"eq" { Some(b"==") }
  else if op == b"ne" { Some(b"!=") }
  else { None }

// Addition and subtraction are checked in the emitted C, because a wrap is a
// wrong answer and the runtime's own overflow report is what the machine gives.
// The rest go through `rt_arith`, which raises for a zero divisor.
fn arithmetic(em: Em, op: Bytes, l: V, r: V) -> Out =
  if is_add_or_sub(op) {
    let f = fresh(em);
    let e1 = line(f.em, bytes_concat_all([b"int64_t ", f.name, b";"]));
    let e2 = line(e1, bytes_concat_all([b"if (ply_", op, b"_ov(", l.c, b", ", r.c, b", &", f.name,
                                        b")) { rt_overflow_p(ctx, ",
                                        if op == b"sub" { b"1" } else { b"0" },
                                        b"); return 0; }"]));
    { em: e2, v: { k: KInt, c: f.name, ty: TyOpen } }
  } else {
    let o = bind(em, KInt, bytes_concat_all([b"rt_arith_p(ctx, ", num(arith_code(op)), b", ",
                                             l.c, b", ", r.c, b")"]));
    { em: check(o.em), v: o.v }
  }

// One definition as the C that runs it: the signature, the fuel the machine
// bounds a compiled recursion by, the body, and the entry the seam calls it
// through.
// Every parameter is opened at entry, in declaration order, whether the body
// reads it or not -- an unused one still gets its temporary, and a `Bool` opens
// through a different helper than an `Int`. Opening lazily at the first read
// answers the same and writes the temporaries in a different order, which is
// what `a * b + c` showed.
fn prologue(em: Em, params: List<P>) -> Em =
  fold(range(0, len(params)), em, |acc: Em, i: Int|
    match list_at(params, i) {
      None -> acc,
      Some(p) -> { let acc = note_bound(note_holder(acc, bytes_concat(b"p", num(i))), bytes_concat(b"p", num(i))); match p.k {
        // A record arrives as its word and is never opened here: there is nothing
        // to untag, and each read of it binds the word where the read is. Its
        // reads are still charged to it, or the release rule sees an object
        // nothing reads and lets nothing go.
        KBoxed -> charge(acc, i, bytes_concat(b"p", num(i))),
        KBool -> {
          let o = bind(acc, KBool, bytes_concat_all([b"rt_unbox_bool_p(ctx, p", num(i), b")"]));
          remember(o.em, i, o.v)
        },
        KNum(w) -> {
          let o = bind(acc, KNum(w), as_num({ k: KBoxed, c: bytes_concat(b"p", num(i)), ty: TyOpen }, w));
          remember(o.em, i, o.v)
        },
        _ -> {
          let o = bind(acc, KInt,
            bytes_concat_all([b"(ply_is_imm(p", num(i), b") ? ply_imm_value(p", num(i),
                              b") : rt_unbox_int_p(ctx, p", num(i), b"))"]));
          remember(o.em, i, o.v)
        },
      } },
    })

// `Int` and `Bool` are the two the prologue knows how to open. Anything else --
// a record, a list, a type variable, a missing annotation -- refuses the whole
// function rather than guessing at a helper.
// A named type resolves to the record it stands for: an alias is transparent to
// the checker, so by the time the reference's emitter sees `v: Values` the type
// *is* the record and a field of one is read at an offset.
//
// It is on. Getting there took five rules about *releases*, each found by the
// corpus and each recorded where it is made: a release counts an object's reads
// and not one slot's, a field whose kind is a word does not release its base, an
// update emits its own build, an update at the tail releases anyway, and an arm
// reached through a scrutinee is still a tail. The disagreements went 38 to 8
// over them, and the port reaches 484 shipped bodies against 426.

// A module's type aliases, under the binder an import gives it in the module being emitted.
pub type ModAliases = { binder: Bytes, aliases: List<Alias> }

fn param_kind_in(aliases: List<Alias>, t: Option<TypeExpr>)
    -> Option<{ k: Kind, ty: Ty }> = param_kind_with(aliases, [], t)

// The same, with the imported modules' aliases in reach: `http::Response` resolves through
// `http`'s own aliases to the record it names, and a field of it is read at an offset.
fn param_kind_with(aliases: List<Alias>, others: List<ModAliases>, t: Option<TypeExpr>)
    -> Option<{ k: Kind, ty: Ty }> = written_kind(aliases, others, [], t)

// An alias's arguments are resolved where they are written, and its body in the alias's own
// module with its parameters bound to them: `Ran<http::Response>` reads `response.status` at
// an offset, through two modules' scopes.
fn bind_args(aliases: List<Alias>, others: List<ModAliases>, vars: List<Bound>,
             params: List<Bytes>, args: List<TypeExpr>) -> List<Bound> =
  map(range(0, len(params)), |i: Int| {
    let name = match list_at(params, i) { Some(n) -> n, None -> b"" };
    match list_at(args, i) {
      Some(arg) -> match written_kind(aliases, others, vars, Some(arg)) {
        Some(x) -> { name: name, k: x.k, ty: x.ty },
        None -> { name: name, k: KBoxed, ty: TyOpen },
      },
      None -> { name: name, k: KBoxed, ty: TyOpen },
    }
  })

fn alias_named(aliases: List<Alias>, name: Bytes) -> Option<Alias> =
  fold(aliases, None, |acc: Option<Alias>, a: Alias| if a.name == name { Some(a) } else { acc })

fn written_kind(aliases: List<Alias>, others: List<ModAliases>, vars: List<Bound>, t: Option<TypeExpr>)
    -> Option<{ k: Kind, ty: Ty }> =
  match t {
    Some(TVar(id)) ->
      match fold(vars, None, |acc: Option<Bound>, b: Bound| if b.name == id.name { Some(b) } else { acc }) {
        Some(b) -> Some({ k: b.k, ty: b.ty }),
        None -> param_kind(t),
      },
    Some(TCon(c)) ->
      match c.name.module {
        Some(binder) -> match fold(others, None, |acc: Option<List<Alias>>, o: ModAliases|
                                if o.binder == binder.name { Some(o.aliases) } else { acc }) {
          None -> param_kind(t),
          Some(theirs) -> match alias_named(theirs, c.name.name.name) {
            // Resolved in the other module's own scope: its aliases, and none of ours.
            Some(a) -> written_kind(theirs, [], bind_args(aliases, others, vars, a.params, c.args), Some(a.ty)),
            None -> param_kind(t),
          },
        },
        None -> match alias_named(aliases, c.name.name.name) {
          Some(a) -> written_kind(aliases, others, bind_args(aliases, others, vars, a.params, c.args), Some(a.ty)),
          None -> param_kind_record(aliases, others, vars, t),
        },
      },
    _ -> param_kind_record(aliases, others, vars, t),
  }

// A record's fields resolve in the same scope as the record: a field typed by an alias, or by
// another module's type, is a shape the port can then see.
fn param_kind_record(aliases: List<Alias>, others: List<ModAliases>, vars: List<Bound>, t: Option<TypeExpr>)
    -> Option<{ k: Kind, ty: Ty }> =
  match t {
    Some(TRecord(r)) ->
      if fold(r.fields, false, |acc: Bool, f: { name: Ident, ty: TypeExpr }|
                acc || written_kind(aliases, others, vars, Some(f.ty)) == None) { None }
      else { Some({ k: KBoxed, ty: TyRec(map(r.fields, |f: { name: Ident, ty: TypeExpr }|
               match written_kind(aliases, others, vars, Some(f.ty)) {
                 Some(x) -> { name: f.name.name, k: x.k, ty: x.ty },
                 None -> { name: f.name.name, k: KBoxed, ty: TyOpen },
               })) }) },
    _ -> param_kind(t),
  }

pub fn param_kind(t: Option<TypeExpr>) -> Option<{ k: Kind, ty: Ty }> =
  match t {
    // `Int` and `Bool` are the two the prologue opens. Everything else arrives
    // as its word and is read as one, which is what the prologue does with a
    // record and what it does with a list, a `Bytes` or a type of the program's
    // own.
    Some(TCon(c)) ->
      // A type of another module is a word whose shape this port cannot see; the reference
      // resolves it through the checker, and a field read of one is the next thing to reach.
      if c.name.module != None { Some({ k: KBoxed, ty: TyOpen }) }
      else if c.name.name.name == b"Int" && len(c.args) == 0 { Some({ k: KInt, ty: TyOpen }) }
      else if c.name.name.name == b"Bool" && len(c.args) == 0 { Some({ k: KBool, ty: TyOpen }) }
      // The two the inline builtins ask about: with the kind known there is no
      // test to make and the read is a load.
      else if c.name.name.name == b"Bytes" && len(c.args) == 0 { Some({ k: KBoxed, ty: TyBytes }) }
      else if c.name.name.name == b"List" && len(c.args) == 1 { Some({ k: KBoxed, ty: TyList }) }
      else if (c.name.name.name == b"Float" || c.name.name.name == b"Decimal") && len(c.args) == 0 {
        Some({ k: KBoxed, ty: TyOpaque }) }
      // A width below sixty-four bits is carried in a register; the two at sixty-four are words
      // the reference treats as opaque.
      else if len(c.args) == 0 && width_named(c.name.name.name) != None {
        match width_named(c.name.name.name) {
          Some(w) -> if carried(w) { Some({ k: KNum(w), ty: TyOpen }) } else { Some({ k: KBoxed, ty: TyOpaque }) },
          None -> Some({ k: KBoxed, ty: TyOpen }),
        } }
      else { Some({ k: KBoxed, ty: TyOpen }) },
    // The field *order* is the checker's, not the declaration's: a record written
    // `{ z: Int, a: Int }` reads `.z` at index 1. Sorting by name here is what
    // makes an offset agree.
    Some(TRecord(r)) ->
      if fold(r.fields, false, |acc: Bool, f: { name: Ident, ty: TypeExpr }|
                acc || param_kind(Some(f.ty)) == None) { None }
      else { Some({ k: KBoxed, ty: TyRec(map(r.fields, |f: { name: Ident, ty: TypeExpr }|
               match param_kind(Some(f.ty)) {
                 Some(x) -> { name: f.name.name, k: x.k, ty: x.ty },
                 None -> { name: f.name.name, k: KBoxed, ty: TyOpen },
               })) }) },
    // Any other written type -- a function, a variable, a unit -- is a word too.
    // What stays refused is a parameter with no annotation at all, where there is
    // nothing to read.
    Some(_) -> Some({ k: KBoxed, ty: TyOpen }),
    None -> None,
  }



pub fn emit_fn(module: Bytes, here: List<Def>, imports: List<Imported>, ctors: List<Bytes>, builtins: List<Bytes>, name: Bytes, params: List<P>, body: Code) -> Option<Bytes> =
  match emit_fn_full(module, here, imports, ctors, builtins, name, params, body, [], false) {
    None -> None,
    Some(f) -> Some(f.text),
  }

// The C of one definition, with the tables it names by its own positions, in the
// encoding `crates/ply-codegen/src/c/cache.rs` keeps a body in: what the C tier
// reads when this emitter is its producer.
pub fn emit_fn_full(module: Bytes, here: List<Def>, imports: List<Imported>, ctors: List<Bytes>, builtins: List<Bytes>, name: Bytes, params: List<P>, body: Code, effects: List<EffectName>, release: Bool) -> Option<{ text: Bytes, tables: Bytes }> = {
  let reads = slots_read(body);
  // The reuse tokens come before the prologue, and are named by width rather
  // than numbered, so finding them does not disturb the temporaries.
  let start = fold([], { out: [], n: 0, conv: [], ind: 0, reads: reads, shapes: [], built: [], module: module, made: [], here: here, imports: imports, consts: [], ctors: ctors, extra: b"", lambdas: [], owner: name, builtins: builtins, met: [], fields: [], released: [], toks: [], alias: [], by_root: [], tail: true, calls: [], refused: None, deferred: [], rlocals: [], performs: [], handles: [], landing: None, effects: effects, release: release, pinned: [], bound: [] },
    |acc: Em, w: Int| line(acc, bytes_concat_all([b"Word tok", num(w), b" = 0;"])));
  match expr(prologue(start, params), body, params) {
    None -> None,
    Some(o0) -> if o0.em.refused != None { None } else {
      let o = o0;
      let sig = bytes_concat_all([b"Word ply_", name, b"(PlyCtx *ctx",
        fold(range(0, len(params)), b"", |acc: Bytes, i: Int|
          bytes_concat_all([acc, b", Word p", num(i)])), b") {\n"]);
      let head = fuel_head();
      let w = returned(o.em, o.v);
      let o = { em: w.em, v: o.v };
      let epilogue = bytes_concat_all([b"  ctx->fuel += 1;\n  return ", w.c, b";\n}\n"]);
      let entry = bytes_concat_all([
        b"Word ply_", name, b"_entry(PlyCtx *ctx, const Word *args) {\n  return ply_", name,
        b"(ctx", fold(range(0, len(params)), b"", |acc: Bytes, i: Int|
          bytes_concat_all([acc, b", args[", num(i), b"]"])), b");\n}\n"]);
      // The declarations are written now that the body has said which it used,
      // and go in front of it. They take no temporary of their own, so nothing
      // the body wrote has to move.
      let toks = fold(sorted_widths(o.em.toks), b"", |acc: Bytes, w: Int|
        bytes_concat_all([acc, b"  Word tok", num(w), b" = 0;\n"]));
      let decls = fold(o.em.rlocals, b"", |acc: Bytes, r: Bytes| bytes_concat_all([acc, b"  Word ", r, b" = 0;\n"]));
      Some({ text: bytes_concat_all([sig, head, toks, decls, bytes_join(o.em.out, b""), epilogue, entry, o.em.extra]),
             tables: encode_tables(o.em, name) })
    },
  }
}

// Why a body was refused, or nothing when it was emitted: the same walk, read for its reason.
pub fn emit_fn_why(module: Bytes, here: List<Def>, imports: List<Imported>, ctors: List<Bytes>, builtins: List<Bytes>, name: Bytes, params: List<P>, body: Code, effects: List<EffectName>, release: Bool) -> Option<Bytes> = {
  let reads = slots_read(body);
  let start = fold([], { out: [], n: 0, conv: [], ind: 0, reads: reads, shapes: [], built: [], module: module, made: [], here: here, imports: imports, consts: [], ctors: ctors, extra: b"", lambdas: [], owner: name, builtins: builtins, met: [], fields: [], released: [], toks: [], alias: [], by_root: [], tail: true, calls: [], refused: None, deferred: [], rlocals: [], performs: [], handles: [], landing: None, effects: effects, release: release, pinned: [], bound: [] },
    |acc: Em, w: Int| line(acc, bytes_concat_all([b"Word tok", num(w), b" = 0;"])));
  match expr(prologue(start, params), body, params) {
    None -> Some(b"refused without a reason"),
    Some(o) -> o.em.refused,
  }
}

// One body's tables as the reference's cache encodes them: five tables, then the
// calls, each as a count and one entry per line. A constant is `s`/`b` and its
// bytes in hex; only strings and byte strings reach this port's pool.
fn encode_tables(em: Em, owner: Bytes) -> Bytes =
  bytes_concat_all([
    counted(b"consts", map(em.consts, |l: Lit| match l {
      LStr(x) -> bytes_concat(b"s ", hex(x)),
      LBytes(x) -> bytes_concat(b"b ", hex(x)),
      LFixed(name, bits) -> match width_named(name) {
        Some(w) -> bytes_concat_all([b"f ", num(width_index(w)), b" ", num(bits)]),
        None -> b"u",
      },
      // As written: the driver converts the text by the lexer's own rule.
      LFloat(x) -> bytes_concat(b"X ", x),
      LDec(x) -> bytes_concat(b"D ", x),
      _ -> b"u",
    })),
    counted(b"builtins", em.met),
    counted(b"fields", em.fields),
    // A shape's fields in the checker's order, which is what the unit interns a shape by.
    counted(b"shapes", map(em.shapes, |names: List<Bytes>| bytes_join(sorted_names(names), b" "))),
    counted(b"lambdas", em.lambdas),
    counted(b"calls", em.calls),
    counted(b"performs", em.performs),
    counted(b"handles", em.handles)])

fn counted(what: Bytes, xs: List<Bytes>) -> Bytes =
  fold(xs, bytes_concat_all([what, b" ", num(len(xs)), b"\n"]),
    |acc: Bytes, x: Bytes| bytes_concat_all([acc, x, b"\n"]))

// The record widths this body gives back, by the rule `release_base` applies:
// a bare variable read at its own last use, read exactly once in the body, whose
// type says how wide it is.
// A slot's shape, as the pre-pass can know it: seeded from the parameters and
// extended by every `let`. The emitter learns the same shapes as it goes; this
// walk has to learn them too, or a release it did not foresee names a reuse
// token that was never declared.
pub type Shaped = { slot: Int, ty: Ty }

fn shape_at(env: List<Shaped>, slot: Int) -> Ty =
  fold(env, TyOpen, |acc: Ty, e: Shaped| if e.slot == slot { e.ty } else { acc })

fn ty_of(env: List<Shaped>, here: List<Def>, c: Code) -> Ty =
  match c.node {
    NVar(v) -> match v.slot { Some(s) -> shape_at(env, s), None -> TyOpen },
    NBlock(b) -> match b.tail { Some(t) -> ty_of(env, here, t), None -> TyOpen },
    NRecord(r) -> TyRec(map(r.fields, |f: CField| { name: f.name, k: KBoxed, ty: TyOpen })),
    NApp(a) -> match a.func.node {
      NVar(fv) -> match fv.slot { Some(_) -> TyOpen, None -> ret_of(here, fv.name).ty },
      _ -> TyOpen,
    },
    NIf(i) -> {
      let t = ty_of(env, here, i.then_branch);
      if t == ty_of(env, here, i.else_branch) { t } else { TyOpen }
    },
    _ -> TyOpen,
  }

fn widths_released(c: Code, params: List<P>, here: List<Def>, reads: List<Int>) -> List<Int> = {
  let env = fold(range(0, len(params)), [], |acc: List<Shaped>, i: Int|
    match list_at(params, i) { Some(p) -> push(acc, { slot: i, ty: p.ty }), None -> acc });
  widths_in(c, env, here, reads)
}

fn widths_in(c: Code, env: List<Shaped>, here: List<Def>, reads: List<Int>) -> List<Int> =
  match c.node {
    NField(f) -> {
      let inner = widths_in(f.base, env, here, reads);
      match f.base.own {
        Owned -> match f.base.node {
          NVar(v) -> match v.slot {
            None -> inner,
            Some(sl) -> if count_of(reads, sl) != 1 { inner } else {
              match width_of(shape_at(env, sl)) {
                None -> inner,
                Some(w) -> if fold(inner, false, |acc: Bool, x: Int| acc || x == w) { inner }
                           else { push(inner, w) },
              }
            },
          },
          _ -> inner,
        },
        _ -> inner,
      }
    },
    NRecord(r) -> merge_widths([len(r.fields)],
      fold(r.fields, [], |acc: List<Int>, f: CField|
        merge_widths(acc, widths_in(f.value, env, here, reads)))),
    NUnary(u) -> widths_in(u.operand, env, here, reads),
    NBinary(b) -> merge_widths(widths_in(b.lhs, env, here, reads),
                               widths_in(b.rhs, env, here, reads)),
    NIf(i) -> merge_widths(widths_in(i.cond, env, here, reads),
                merge_widths(widths_in(i.then_branch, env, here, reads),
                             widths_in(i.else_branch, env, here, reads))),
    // A `let` puts its value's shape in scope for everything after it, which is
    // what lets a release of a bound record find its width.
    NBlock(b) -> {
      let walked = fold(b.stmts, { env: env, ws: [] },
        |acc: { env: List<Shaped>, ws: List<Int> }, st: CStmt| match st {
          CLet(l) -> { env: push(acc.env, { slot: l.slot, ty: ty_of(acc.env, here, l.value) }),
                       ws: merge_widths(acc.ws, widths_in(l.value, acc.env, here, reads)) },
          CLetPat(l) -> { env: fold(pat_slots(l.pat), acc.env, |e: List<Shaped>, sl: Int| push(e, { slot: sl, ty: TyOpen })),
                          ws: merge_widths(acc.ws, widths_in(l.value, acc.env, here, reads)) },
          CDo(d) -> { env: acc.env, ws: merge_widths(acc.ws, widths_in(d.code, acc.env, here, reads)) },
        });
      merge_widths(walked.ws,
        match b.tail { Some(t) -> widths_in(t, walked.env, here, reads), None -> [] })
    },
    NList(l) -> fold(l.items, [], |acc: List<Int>, x: Code|
      merge_widths(acc, widths_in(x, env, here, reads))),
    // The rest of the walk, so a record built inside a call's argument or a
    // match arm still declares its token. Leaving these out declared no token
    // for `std.http.endless`, which builds one two fields wide inside a call.
    NApp(a) -> fold(a.args, widths_in(a.func, env, here, reads), |acc: List<Int>, x: Code|
      merge_widths(acc, widths_in(x, env, here, reads))),
    NMatch(m) -> fold(m.arms, widths_in(m.scrutinee, env, here, reads),
      |acc: List<Int>, ar: CArm| merge_widths(acc, merge_widths(
        match ar.guard { Some(g) -> widths_in(g, env, here, reads), None -> [] },
        widths_in(ar.body, env, here, reads)))),
    NCell(c2) -> merge_widths(widths_in(c2.init, env, here, reads),
                              widths_in(c2.body, env, here, reads)),
    NRegion(r) -> widths_in(r.body, env, here, reads),
    // An update builds a record of the base's width, so it takes a token too.
    NUpd(u) -> merge_widths(widths_in(u.base, env, here, reads),
      fold(u.sets, [], |acc: List<Int>, f: CField|
        merge_widths(acc, widths_in(f.value, env, here, reads)))),
    NPerform(pf) -> fold(pf.args, [], |acc: List<Int>, x: Code|
      merge_widths(acc, widths_in(x, env, here, reads))),
    // A lambda's body is a function of its own and declares its own tokens.
    NLambda(_) -> [],
    NSim(_) -> [],
    NHandle(_) -> [],
    NVar(_) -> [],
    NLit(_) -> [],
  }

// Ascending, because the reference keeps its tokens in a sorted set and the
// declarations come out in that order rather than in the order the widths were
// found.
fn sorted_widths(xs: List<Int>) -> List<Int> =
  fold(range(0, len(xs)), [], |acc: List<Int>, _i: Int|
    match fold(xs, None, |best: Option<Int>, x: Int|
            if fold(acc, false, |seen: Bool, y: Int| seen || y == x) { best }
            else { match best { None -> Some(x), Some(b2) -> if x < b2 { Some(x) } else { best } } }) {
      Some(m) -> push(acc, m),
      None -> acc,
    })

fn merge_widths(a: List<Int>, b: List<Int>) -> List<Int> =
  fold(b, a, |acc: List<Int>, x: Int|
    if fold(acc, false, |seen: Bool, y: Int| seen || y == x) { acc } else { push(acc, x) })

// What every compiled function does before its body: spends fuel, and refuses when the native
// stack is nearly out, because a C frame is not a machine frame.
fn fuel_head() -> Bytes = bytes_concat_all([
  b"  if (ctx->fuel <= 0) { rt_no_fuel_p(ctx); return 0; }\n",
  b"  { char probe; if ((uintptr_t)&probe < ctx->stack_floor) { rt_no_stack_p(ctx); return 0; } }\n",
  b"  ctx->fuel -= 1;\n"])

test "a body that answers a literal" {
  assert_eq(string_of_bytes(match emit_fn(b"m", [], [], [], [], b"m_f", [], { own: Borrowed, node: NLit(LInt(7)) }) {
    Some(c) -> c, None -> b"" }),
    "Word ply_m_f(PlyCtx *ctx) {\n  if (ctx->fuel <= 0) { rt_no_fuel_p(ctx); return 0; }\n  { char probe; if ((uintptr_t)&probe < ctx->stack_floor) { rt_no_stack_p(ctx); return 0; } }\n  ctx->fuel -= 1;\n  ctx->fuel += 1;\n  return (ply_fits_imm(INT64_C(7)) ? ply_imm(INT64_C(7)) : rt_box_int_p(ctx, INT64_C(7)));\n}\nWord ply_m_f_entry(PlyCtx *ctx, const Word *args) {\n  return ply_m_f(ctx);\n}\n")
}

test "a form this port does not reach is refused" {
  // A `Float` literal: the fragment has no path for one at all, on either side.
  assert_eq(match emit_fn(b"m", [], [], [], [], b"m_f", [], { own: Borrowed, node: NLit(LBad) }) {
    Some(_) -> false, None -> true }, true)
}

// --- the emitter's entry ----------------------------------------------------
//
// Lower each function, hand it to `emit.ply`, and answer the C for the ones both
// stages reached. Framed as the emit oracle frames it: `C;n;` then `f:<name>;`
// and the body per definition.

// The module's own name, so a dump over many modules names each body the way the
// reference names it -- `std.hash.round`, not `m.round`.
// One module's bodies, as it was parsed and rewritten but with no defaults filled: what the
// per-module differential compares.
fn emit_all_in(module: Bytes, ctors: List<Bytes>, builtins: List<Bytes>, src: Bytes, release: Bool) -> List<Emitted> = {
  let r = parse(src);
  let x = expand(r.node, r.p.uses_sets, r.p.diags);
  emit_module(module, x.module, ctors, builtins, [], [], [], release)
}

// Every definition of a module, with its declared return as the emitter reads it.
fn aliases_in(m: Module) -> List<Alias> =
  fold(m.items, [], |acc: List<Alias>, it: Item|
    match it {
      IType(t) -> match t.body {
        TDAlias(u) -> push(acc, { name: t.name.name, params: map(t.params, |i: Ident| i.name), ty: u }),
        _ -> acc,
      },
      _ -> acc,
    })

// The imported modules' aliases, each under the binder this module gives it.
fn others_of(m: Module, program: List<ModDefs>) -> List<ModAliases> =
  fold(m.imports, [], |acc: List<ModAliases>, im: ImportDecl| {
    let path = bytes_join_dots(map(im.path, |i: Ident| i.name));
    let theirs = fold(program, [], |a: List<Alias>, md: ModDefs| if md.module == path { md.aliases } else { a });
    match im.kind {
      IModule -> push(acc, { binder: last_segment(im.path), aliases: theirs }),
      IAlias(a2) -> push(acc, { binder: a2.name, aliases: theirs }),
      INames(_) -> acc,
    }
  })

fn defs_in(module: Bytes, m: Module, pure: List<Bytes>, program: List<ModDefs>) -> List<Def> = {
  let aliases = aliases_in(m);
  let others = others_of(m, program);
  fold(m.items, [], |acc: List<Def>, it: Item|
    match it {
      IFn(d) -> push(acc, { name: d.name.name,
                            ret: match param_kind_with(aliases, others, d.ret) { Some(r) -> Some(r.k), None -> None },
                            ret_ty: match param_kind_with(aliases, others, d.ret) { Some(r) -> r.ty, None -> TyOpen },
                            pure: fold(pure, false, |acc: Bool, n: Bytes| acc || n == bytes_concat_all([module, b".", d.name.name])),
                            arity: len(d.params) }),
      _ -> acc,
    })
}

// Every module of a program, resolved together first -- so a call's default arguments are
// filled and every `derive` is expanded, which is what the reference's emitter sees -- and then
// emitted one module at a time. A program that does not resolve emits nothing: a body emitted
// against unfilled calls would be wrong rather than partial.
fn emit_all_program(sources: List<Source>, ctors: List<Bytes>, builtins: List<Bytes>, release: Bool) -> List<Emitted> = {
  let parsed = map(range(0, len(sources)), |i: Int| {
    let s = match list_at(sources, i) { Some(x) -> x, None -> { name: b"", src: b"" } };
    let r = parse(s.src);
    let x = expand(r.node, r.p.uses_sets, r.p.diags);
    let d = expand_derives(i, x.module);
    { name: s.name, module: d.module, derived: d.derived, bad: len(d.diags) > 0 }
  });
  if fold(parsed, false, |acc: Bool, p: { name: Bytes, module: Module, derived: List<Derived>, bad: Bool }| acc || p.bad) { [] } else {
    match resolve_modules(map(parsed, |p: { name: Bytes, module: Module, derived: List<Derived>, bad: Bool }|
                               { name: p.name, module: p.module, derived: p.derived })) {
      Failed(_) -> [],
      Resolved_(x) -> match pure_definitions(x.r, x.mods) {
        None -> [],
        Some(pure) -> {
          let with_aliases = map(x.mods, |m: Mod| { module: m.name, defs: [], aliases: aliases_in(m.module) });
          let program = map(x.mods, |m: Mod| { module: m.name, defs: defs_in(m.name, m.module, pure, with_aliases), aliases: aliases_in(m.module) });
          fold(range(0, len(x.mods)), [], |acc: List<Emitted>, i: Int|
            match list_at(x.mods, i) {
              None -> acc,
              Some(m) -> fold(emit_module(m.name, m.module, ctors, builtins, program, pure, effects_in(x.r, i, x.mods), release), acc, |a: List<Emitted>, e: Emitted| push(a, e)),
            })
        },
      },
    }
  }
}

fn emit_module(module: Bytes, x_module: Module, ctors: List<Bytes>, builtins: List<Bytes>, program: List<ModDefs>, pure: List<Bytes>, effects: List<EffectName>, release: Bool) -> List<Emitted> = {
  let x = { module: x_module };
  let defs_of = |path: Bytes| fold(program, [], |acc: List<Def>, md: ModDefs| if md.module == path { md.defs } else { acc });
  let others = others_of(x.module, program);
  let imports = fold(x.module.imports, [], |acc: List<Imported>, im: ImportDecl|
    match im.kind {
      INames(ns) -> {
        let path = bytes_join_dots(map(im.path, |i: Ident| i.name));
        fold(ns, acc, |a: List<Imported>, n: Ident| push(a, { name: n.name, module: path, defs: defs_of(path) }))
      },
      // A whole module binds under its last segment, or under its alias, and a
      // call through it is written `binder::name`. The binder is recorded under
      // the empty name so one table answers both spellings.
      IModule -> {
        let path = bytes_join_dots(map(im.path, |i: Ident| i.name));
        push(acc, { name: last_segment(im.path), module: path, defs: defs_of(path) })
      },
      IAlias(a2) -> {
        let path = bytes_join_dots(map(im.path, |i: Ident| i.name));
        push(acc, { name: a2.name, module: path, defs: defs_of(path) })
      },
    });
  let aliases = fold(x.module.items, [], |acc: List<Alias>, it: Item|
    match it {
      IType(t) -> match t.body {
        TDAlias(u) -> push(acc, { name: t.name.name, params: map(t.params, |i: Ident| i.name), ty: u }),
        _ -> acc,
      },
      _ -> acc,
    });
  let here = fold(x.module.items, [], |acc: List<Def>, it: Item|
    match it {
      IFn(d) -> push(acc, { name: d.name.name,
                            ret: match param_kind_with(aliases, others, d.ret) { Some(r) -> Some(r.k), None -> None },
                            ret_ty: match param_kind_with(aliases, others, d.ret) { Some(r) -> r.ty, None -> TyOpen },
                            pure: fold(pure, false, |acc: Bool, n: Bytes| acc || n == bytes_concat_all([module, b".", d.name.name])),
                            arity: len(d.params) }),
      _ -> acc,
    });
  let walked = fold(x.module.items, { out: [], tests: 0, laws: 0 }, |acc: Walk, it: Item|
    match it {
      IFn(d) -> {
        let names = map(d.params, |p: Param| p.name.name);
        let kinds = map(d.params, |p: Param| param_kind_with(aliases, others, p.ty));
        let known = fold(kinds, true, |acc: Bool, k: Option<{ k: Kind, ty: Ty }>| acc && k != None);
        let full = bytes_concat_all([module, b".", d.name.name]);
        let ps = map(range(0, len(names)), |i: Int|
                   { name: match list_at(names, i) { Some(n) -> n, None -> b"" },
                     k: match list_at(kinds, i) { Some(Some(p)) -> p.k, _ -> KInt },
                     ty: match list_at(kinds, i) { Some(Some(p)) -> p.ty, _ -> TyOpen } });
        let after = match if known { lower_fn(names, d.body) } else { None } {
          // What the body handles is read off the source, so the unit's fixpoint still drops
          // its performers when the lowering never reached the body.
          None -> { out: push(acc.out, { name: full, text: b"", tables: b"", handles: ast_handles(d.body, effects),
                                         why: Some(if known { b"a body the lowering does not reach" } else { b"a parameter with no written type" }) }),
                    tests: acc.tests, laws: acc.laws },
          Some(l) -> match emit_fn_full(module, here, imports, ctors, builtins, bytes_concat_all([mangle(module), b"_", d.name.name]), ps, l.code, effects, release) {
            None -> { out: push(acc.out, { name: full, text: b"", tables: b"", handles: walk_handles(l.code, effects),
                                           why: emit_fn_why(module, here, imports, ctors, builtins, bytes_concat_all([mangle(module), b"_", d.name.name]), ps, l.code, effects, release) }),
                      tests: acc.tests, laws: acc.laws },
            Some(c) -> { out: push(acc.out, { name: bytes_concat_all([module, b".", d.name.name]), text: c.text, tables: c.tables, why: None, handles: [] }), tests: acc.tests, laws: acc.laws },
          },
        };
        clause_roots(after, d, names, kinds, module, here, imports, ctors, builtins, effects, release, aliases, others)
      },
      // A test is a root the machine enters whole: a nullary body named by its place
      // among the module's tests, as the reference names it.
      ITest(t) -> {
        let root = bytes_concat_all([b"test_", num(acc.tests)]);
        let full = bytes_concat_all([module, b".test#", num(acc.tests)]);
        match lower_fn([], t.body) {
          None -> { out: push(acc.out, { name: full, text: b"", tables: b"", why: Some(b"a body the lowering does not reach"), handles: [] }), tests: acc.tests + 1, laws: acc.laws },
          Some(l) -> match emit_fn_full(module, here, imports, ctors, builtins, bytes_concat_all([mangle(module), b"_", root]), [], l.code, effects, release) {
            None -> { out: push(acc.out, { name: full, text: b"", tables: b"", handles: walk_handles(l.code, effects),
                                           why: emit_fn_why(module, here, imports, ctors, builtins, bytes_concat_all([mangle(module), b"_", root]), [], l.code, effects, release) }),
                      tests: acc.tests + 1, laws: acc.laws },
            Some(c) -> { out: push(acc.out, { name: full, text: c.text, tables: c.tables, why: None, handles: [] }), tests: acc.tests + 1, laws: acc.laws },
          },
        }
      },
      // A law's guard and body are roots the judge enters with the binders' values, named as
      // the reference names them (ADR 0045 §"The facade").
      ILaw(d) -> {
        let names = map(d.binders, |b: Binder| b.name.name);
        let kinds = map(d.binders, |b: Binder| param_kind_with(aliases, others, Some(b.ty)));
        let ps = params_of(names, kinds);
        let known = fold(kinds, true, |acc2: Bool, k: Option<{ k: Kind, ty: Ty }>| acc2 && k != None);
        let with_guard = match d.guard {
          None -> acc.out,
          Some(g) -> push(acc.out, root_emitted(module, here, imports, ctors, builtins, effects, release,
            bytes_concat_all([module, b".law#", num(acc.laws), b".guard"]),
            bytes_concat_all([b"law_", num(acc.laws), b"_guard"]), names, ps, known, g)),
        };
        { out: push(with_guard, root_emitted(module, here, imports, ctors, builtins, effects, release,
            bytes_concat_all([module, b".law#", num(acc.laws), b".body"]),
            bytes_concat_all([b"law_", num(acc.laws), b"_body"]), names, ps, known, d.body)),
          tests: acc.tests, laws: acc.laws + 1 }
      },
      _ -> acc,
    });
  walked.out
}

// One emitted definition: its program-wide name, its C, and its tables encoded.
// `why` is the refusal's reason, and then `text` and `tables` are empty.
pub type Emitted = { name: Bytes, text: Bytes, tables: Bytes, why: Option<Bytes>, handles: List<Bytes> }

type Walk = { out: List<Emitted>, tests: Int, laws: Int }

fn params_of(names: List<Bytes>, kinds: List<Option<{ k: Kind, ty: Ty }>>) -> List<P> =
  map(range(0, len(names)), |i: Int|
    { name: match list_at(names, i) { Some(n) -> n, None -> b"" },
      k: match list_at(kinds, i) { Some(Some(p)) -> p.k, _ -> KInt },
      ty: match list_at(kinds, i) { Some(Some(p)) -> p.ty, _ -> TyOpen } })

// A proposition as a root: the same emission a definition gets, refused with the same reasons.
fn root_emitted(module: Bytes, here: List<Def>, imports: List<Imported>, ctors: List<Bytes>, builtins: List<Bytes>,
                effects: List<EffectName>, release: Bool, full: Bytes, cname: Bytes,
                names: List<Bytes>, ps: List<P>, known: Bool, body: Expr) -> Emitted =
  match if known { lower_fn(names, body) } else { None } {
    None -> { name: full, text: b"", tables: b"", handles: ast_handles(body, effects),
              why: Some(if known { b"a body the lowering does not reach" } else { b"a parameter with no written type" }) },
    Some(l) -> match emit_fn_full(module, here, imports, ctors, builtins, bytes_concat_all([mangle(module), b"_", cname]), ps, l.code, effects, release) {
      None -> { name: full, text: b"", tables: b"", handles: walk_handles(l.code, effects),
                why: emit_fn_why(module, here, imports, ctors, builtins, bytes_concat_all([mangle(module), b"_", cname]), ps, l.code, effects, release) },
      Some(c) -> { name: full, text: c.text, tables: c.tables, why: None, handles: [] },
    },
  }

// A definition's `requires` clauses over its parameters and its `ensures` clauses over them and
// then `result`, each a root of its own: `<owner>#requires#<k>`, `<owner>#ensures#<k>`.
fn clause_roots(acc: Walk, d: FnDef, names: List<Bytes>, kinds: List<Option<{ k: Kind, ty: Ty }>>, module: Bytes,
                here: List<Def>, imports: List<Imported>, ctors: List<Bytes>, builtins: List<Bytes>,
                effects: List<EffectName>, release: Bool, aliases: List<Alias>, others: List<ModAliases>) -> Walk = {
  let known = fold(kinds, true, |acc2: Bool, k: Option<{ k: Kind, ty: Ty }>| acc2 && k != None);
  let walked = fold(d.spec, { out: acc.out, requires: 0, ensures: 0 },
    |s: { out: List<Emitted>, requires: Int, ensures: Int }, c: SpecClause|
      match c.kind {
        SRequires -> { out: push(s.out, root_emitted(module, here, imports, ctors, builtins, effects, release,
                         bytes_concat_all([module, b".", d.name.name, b"#requires#", num(s.requires)]),
                         bytes_concat_all([d.name.name, b"_requires_", num(s.requires)]), names, params_of(names, kinds), known, c.expr)),
                       requires: s.requires + 1, ensures: s.ensures },
        SEnsures -> match d.ret {
          None -> { out: s.out, requires: s.requires, ensures: s.ensures + 1 },
          Some(r) -> {
            let rnames = push(names, b"result");
            let rkinds = push(kinds, param_kind_with(aliases, others, Some(r)));
            let rknown = known && param_kind_with(aliases, others, Some(r)) != None;
            { out: push(s.out, root_emitted(module, here, imports, ctors, builtins, effects, release,
                bytes_concat_all([module, b".", d.name.name, b"#ensures#", num(s.ensures)]),
                bytes_concat_all([d.name.name, b"_ensures_", num(s.ensures)]), rnames, params_of(rnames, rkinds), rknown, c.expr)),
              requires: s.requires, ensures: s.ensures + 1 }
          },
        },
      });
  { out: walked.out, tests: acc.tests, laws: acc.laws }
}

fn concat_effects(a: List<EffectName>, b: List<EffectName>) -> List<EffectName> =
  fold(b, a, |acc: List<EffectName>, x: EffectName| push(acc, x))

// The operations a body's `handle` clauses answer, as `effect#op` under the program-wide
// effect name, read off the lowered tree: a refused body still says what it would have
// handled, so the unit can drop the performers with it.
// The operations a body handles, read off its source: `walk_handles` over the expression tree
// rather than the lowered one, for a body the lowering did not reach.
fn ast_handles(e: Expr, effects: List<EffectName>) -> List<Bytes> = {
  let here = |acc: List<Bytes>, x: Expr| concat_names(acc, ast_handles(x, effects));
  let all = |xs: List<Expr>| fold(xs, [], here);
  match e {
    EHandle(h) -> {
      let inner = fold(h.clauses, ast_handles(h.body, effects), |acc: List<Bytes>, cl: HandleClause|
        concat_names(match fold(concat_effects(effects, prelude_effects_here()), None,
                                |f: Option<Bytes>, en: EffectName| if en.written == qname_text(cl.eff) { Some(en.global) } else { f }) {
                       Some(g) -> push(acc, bytes_concat_all([g, b"#", cl.op.name])),
                       None -> acc,
                     }, ast_handles(cl.body, effects)));
      match h.ret { Some(r) -> here(inner, r.body), None -> inner }
    },
    ESimulate(x) -> concat_names(scheduled_ops(), ast_handles(x.body, effects)),
    EUnary(x) -> ast_handles(x.operand, effects),
    EBinary(x) -> all([x.lhs, x.rhs]),
    ELambda(x) -> ast_handles(x.body, effects),
    EApp(x) -> here(all(x.args), x.func),
    EIf(x) -> all([x.cond, x.then_branch, x.else_branch]),
    EMatch(x) -> fold(x.arms, ast_handles(x.scrutinee, effects), |acc: List<Bytes>, a: MatchArm|
      here(match a.guard { Some(g) -> here(acc, g), None -> acc }, a.body)),
    EBlock(x) -> {
      let stmts = fold(x.stmts, [], |acc: List<Bytes>, st: Stmt| match st {
        SLet(l) -> here(acc, l.value),
        SExpr(v) -> here(acc, v),
      });
      match x.tail { Some(t) -> here(stmts, t), None -> stmts }
    },
    ERecord(x) -> all(map(x.fields, |f: RecField| f.value)),
    ERecordUpdate(x) -> here(all(map(x.fields, |f: RecField| f.value)), x.base),
    ETry(x) -> ast_handles(x.operand, effects),
    EField(x) -> ast_handles(x.base, effects),
    EList(x) -> all(x.items),
    EPerform(x) -> all(x.args),
    EWithCell(x) -> all([x.init, x.body]),
    EWithRegion(x) -> ast_handles(x.body, effects),
    _ -> [],
  }
}

fn walk_handles(c: Code, effects: List<EffectName>) -> List<Bytes> = {
  let here = |acc: List<Bytes>, x: Code| concat_names(acc, walk_handles(x, effects));
  match c.node {
    NHandle(h) -> fold(h.clauses, walk_handles(h.body, effects), |acc: List<Bytes>, cl: CClause|
      concat_names(match fold(concat_effects(effects, prelude_effects_here()), None, |f: Option<Bytes>, e: EffectName| if e.written == cl.effect { Some(e.global) } else { f }) {
               Some(g) -> push(acc, bytes_concat_all([g, b"#", cl.op])),
               None -> acc,
             }, walk_handles(cl.body, effects))),
    NUnary(u) -> walk_handles(u.operand, effects),
    NBinary(b) -> here(walk_handles(b.lhs, effects), b.rhs),
    NField(f) -> walk_handles(f.base, effects),
    NApp(a) -> fold(a.args, walk_handles(a.func, effects), here),
    NIf(i) -> here(here(walk_handles(i.cond, effects), i.then_branch), i.else_branch),
    NBlock(b) -> {
      let stmts = fold(b.stmts, [], |acc: List<Bytes>, st: CStmt| match st {
        CLet(l) -> here(acc, l.value),
        CLetPat(l) -> here(acc, l.value),
        CDo(d) -> here(acc, d.code),
      });
      match b.tail { Some(t) -> here(stmts, t), None -> stmts }
    },
    NList(l) -> fold(l.items, [], here),
    NRecord(r) -> fold(r.fields, [], |acc: List<Bytes>, f: CField| here(acc, f.value)),
    NUpd(u) -> fold(u.sets, walk_handles(u.base, effects), |acc: List<Bytes>, f: CField| here(acc, f.value)),
    NMatch(m) -> fold(m.arms, walk_handles(m.scrutinee, effects), |acc: List<Bytes>, a: CArm| here(acc, a.body)),
    NPerform(p) -> fold(p.args, [], here),
    NCell(c2) -> here(walk_handles(c2.init, effects), c2.body),
    NRegion(r) -> walk_handles(r.body, effects),
    NLambda(l) -> walk_handles(l.body, effects),
    NSim(x) -> concat_names(scheduled_ops(), walk_handles(x.body, effects)),
    _ -> [],
  }
}

// The differential's rendering: `f:<name>;<text>;` per body.
pub fn emit_dump_in(module: Bytes, ctors: List<Bytes>, builtins: List<Bytes>, src: Bytes) -> String =
  string_of_bytes(fold(emit_all_in(module, ctors, builtins, src, false), b"C;1;", |acc: Bytes, e: Emitted|
    if e.why != None { acc } else { bytes_concat_all([acc, b"f:", e.name, b";", e.text, b";"]) }))

// The differential's rendering over a whole program, resolved together.
pub fn emit_dump_all(names: List<Bytes>, srcs: List<Bytes>, ctors: List<Bytes>, builtins: List<Bytes>) -> String =
  string_of_bytes(fold(emit_all_program(zip_sources(names, srcs), ctors, builtins, false), b"C;1;", |acc: Bytes, e: Emitted|
    if e.why != None { acc } else { bytes_concat_all([acc, b"f:", e.name, b";", e.text, b";"]) }))

// Every body the port refused over a program, one per line as `<name> :: <reason>`: the census
// of what keeps it out of the rest.
pub fn emit_refusals_all(names: List<Bytes>, srcs: List<Bytes>, ctors: List<Bytes>, builtins: List<Bytes>) -> String =
  string_of_bytes(fold(emit_all_program(zip_sources(names, srcs), ctors, builtins, true), b"", |acc: Bytes, e: Emitted|
    match e.why { None -> acc, Some(w) -> bytes_concat_all([acc, e.name, b" :: ", w, b"\n"]) }))

// The unit's rendering over a whole program: every body as the producer's frame, and every
// refusal as a frame of its own, so the driver that enters the chain whole can drop what the
// port refused as the reference's fixpoint drops what it refused.
// The frames are collected and joined once: appending each to the dump so far would copy the
// dump per body, quadratic in a heap that keeps what an entry lets go.
pub fn emit_unit_all(names: List<Bytes>, srcs: List<Bytes>, ctors: List<Bytes>, builtins: List<Bytes>) -> String =
  string_of_bytes(bytes_join(fold(emit_all_program(zip_sources(names, srcs), ctors, builtins, true), [], |acc: List<Bytes>, e: Emitted|
    match e.why {
      // A refusal still says which operations the body would have handled, so the fixpoint can
      // drop their performers with it.
      Some(w) -> {
        let frame = bytes_concat_all([w, b"\nhandles ", bytes_join(e.handles, b" ")]);
        push(acc, bytes_concat_all([b"refused ", e.name, b" ", num(bytes_len(frame)), b"\n", frame]))
      },
      None -> {
        let enc = bytes_concat_all([e.tables, b"text\n", e.text]);
        push(acc, bytes_concat_all([b"body ", e.name, b" ", num(bytes_len(enc)), b"\n", enc]))
      },
    }), b""))

// The producer's rendering over a whole program, resolved together.
pub fn emit_bodies_all(names: List<Bytes>, srcs: List<Bytes>, ctors: List<Bytes>, builtins: List<Bytes>) -> String =
  string_of_bytes(bytes_join(fold(emit_all_program(zip_sources(names, srcs), ctors, builtins, true), [], |acc: List<Bytes>, e: Emitted|
    if e.why != None { acc } else {
      let enc = bytes_concat_all([e.tables, b"text\n", e.text]);
      push(acc, bytes_concat_all([b"body ", e.name, b" ", num(bytes_len(enc)), b"\n", enc]))
    }), b""))

// The same under the reference's ownership, which keeps every count until the entry ends:
// the text `harness/tests/emit_diff.rs` compares against the reference's, body for body.
pub fn emit_bodies_reference(names: List<Bytes>, srcs: List<Bytes>, ctors: List<Bytes>, builtins: List<Bytes>) -> String =
  string_of_bytes(bytes_join(fold(emit_all_program(zip_sources(names, srcs), ctors, builtins, false), [], |acc: List<Bytes>, e: Emitted|
    if e.why != None { acc } else {
      let enc = bytes_concat_all([e.tables, b"text\n", e.text]);
      push(acc, bytes_concat_all([b"body ", e.name, b" ", num(bytes_len(enc)), b"\n", enc]))
    }), b""))

fn zip_sources(names: List<Bytes>, srcs: List<Bytes>) -> List<Source> =
  map(range(0, len(names)), |i: Int|
    { name: match list_at(names, i) { Some(n) -> n, None -> b"" },
      src: match list_at(srcs, i) { Some(t) -> t, None -> b"" } })

// The producer's rendering, framed by length so no byte of a body is a delimiter:
// `body <name> <n>\n` and then exactly `n` bytes -- the tables in the cache's
// encoding, `text\n`, and the C.
pub fn emit_bodies_in(module: Bytes, ctors: List<Bytes>, builtins: List<Bytes>, src: Bytes) -> String =
  string_of_bytes(fold(emit_all_in(module, ctors, builtins, src, true), b"", |acc: Bytes, e: Emitted|
    if e.why != None { acc } else {
      let enc = bytes_concat_all([e.tables, b"text\n", e.text]);
      bytes_concat_all([acc, b"body ", e.name, b" ", num(bytes_len(enc)), b"\n", enc])
    }))

// The C identifier a module name becomes: a dot is not one.
fn mangle(module: Bytes) -> Bytes =
  bytes_concat_all(map(range(0, bytes_len(module)), |i: Int|
    if bytes_at(module, i) == 46 { b"_" } else { bytes_slice(module, i, i + 1) }))

pub fn emit_dump(src: Bytes) -> String = emit_dump_in(b"m", [], [], src)

fn bytes_join_dots(xs: List<Bytes>) -> Bytes =
  fold(range(0, len(xs)), b"", |acc: Bytes, i: Int|
    bytes_concat_all([acc, if i == 0 { b"" } else { b"." },
                      match list_at(xs, i) { Some(x) -> x, None -> b"" }]))
