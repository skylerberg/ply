import std.pkg (Manifest)

// The interleaving search: which schedules of a `simulate` region a run tries, and what the runs it
// tried establish. `ply test` searches its simulated tests with it and `ply prove` its laws over
// regions; the runtime runs one interleaving per call and records it.
fn package() -> Manifest = {
  name: "sim",
  version: { major: 0, minor: 1, patch: 0 },
  prefix: None,
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [],
  entry: None,
}
