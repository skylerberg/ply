pub type Effect = {
  effect: String,
  resource: Option<String>,
  write: Bool,
  operation: Option<String>,
}

pub type Access =
  | EffectAccess(Effect)
  | VariableAccess({ handler: Int, index: Int, write: Bool })
  | ScopedAccess({ id: Int, write: Bool })

pub fn conflicts(a: Access, b: Access) -> Bool =
  match ((a, b)) {
    (EffectAccess(x), EffectAccess(y)) ->
      x.effect == y.effect && x.resource == y.resource && (x.write || y.write),
    (VariableAccess(x), VariableAccess(y)) ->
      x.handler == y.handler && x.index == y.index && (x.write || y.write),
    (ScopedAccess(x), ScopedAccess(y)) -> x.id == y.id && (x.write || y.write),
    _ -> false,
  }

pub fn effects_conflict(xs: List<Access>, ys: List<Access>) -> Bool =
  xs.fold(false, |found: Bool, x: Access|
    found || ys.fold(false, |f: Bool, y: Access| f || conflicts(x, y)))

pub fn conflicting_accesses(xs: List<Access>, ys: List<Access>) -> List<Access> =
  xs.filter(|x: Access| ys.fold(false, |f: Bool, y: Access| f || conflicts(x, y)))

pub fn access_text(a: Access) -> String =
  match a {
    EffectAccess(x) -> {
      let what = match x.operation {
        Some(operation) -> operation,
        None -> if x.write { "write" } else { "read" },
      };
      x.effect ++ "." ++ what ++ (match x.resource { Some(r) -> "[" ++ r ++ "]", None -> "" })
    },
    VariableAccess(v) ->
      "var." ++ (if v.write { "write" } else { "read" }) ++ "[" ++ v.handler.to_string() ++ "."
        ++ v.index.to_string()
        ++ "]",
    ScopedAccess(h) ->
      "scoped." ++ (if h.write { "write" } else { "read" }) ++ "[" ++ h.id.to_string() ++ "]",
  }

pub type Site = { definition: Option<String>, span: { module: Int, start: Int, end: Int } }

pub type Step = {
  scheduler: Int,
  task: Int,
  runnable: List<Int>,
  choice: Int,
  accesses: List<Access>,
  site: Site,
  vector_clock: List<Int>,
}

pub type Verdict<f> = | Passed | Failed(f)

pub type Interleaving<f> = { steps: List<Step>, verdict: Verdict<f>, virtual_time: Int }

pub fn happens_before(earlier: Step, later: Step) -> Bool =
  if earlier.vector_clock.len() == 0 || later.vector_clock.len() == 0 { false } else {
    let mine = match earlier.vector_clock.at(earlier.task) { Some(n) -> n, None -> 0 };
    let theirs = match later.vector_clock.at(earlier.task) { Some(n) -> n, None -> 0 };
    mine > 0 && theirs >= mine
  }

test "two accesses of one place conflict where either writes" {
  let var = |h: Int, i: Int, w: Bool| VariableAccess({ handler: h, index: i, write: w });
  assert(conflicts(var(1, 0, true), var(1, 0, false)));
  assert(!conflicts(var(1, 0, false), var(1, 0, false)));
  assert(!conflicts(var(1, 0, true), var(1, 1, true)));
  assert(!conflicts(var(1, 0, true), var(2, 0, true)));
  let hold = |id: Int, w: Bool| ScopedAccess({ id: id, write: w });
  assert(conflicts(hold(1, true), hold(1, false)));
  assert(!conflicts(hold(1, false), hold(1, false)));
  assert(!conflicts(hold(1, true), hold(2, true)));
  assert(!conflicts(hold(1, true), var(1, 1, true)));
  let entry = |r: String, w: Bool|
    EffectAccess({ effect: "random", resource: Some(r), write: w, operation: None });
  assert(conflicts(entry("a", true), entry("a", false)));
  assert(!conflicts(entry("a", true), entry("b", true)));
  assert_eq(conflicting_accesses([var(1, 0, true), var(1, 1, false)], [var(1, 0, false)]), [
    var(1, 0, true),
  ]);
  assert_eq(access_text(var(1, 3, true)), "var.write[1.3]");
  assert_eq(access_text(hold(2, false)), "scoped.read[2]")
}

test "a step happens before another when the other step's vector clock includes it" {
  let step = |task: Int, stamp: List<Int>|
    {
      scheduler: 0,
      task: task,
      runnable: [task],
      choice: 0,
      accesses: [],
      site: { definition: None, span: { module: 0, start: 0, end: 0 } },
      vector_clock: stamp,
    };
  assert(happens_before(step(0, [1, 0]), step(1, [1, 1])));
  assert(!happens_before(step(0, [2, 0]), step(1, [1, 1])));
  assert(!happens_before(step(0, []), step(1, [1, 1])))
}
