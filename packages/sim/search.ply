//! `search` — the interleavings a plan runs. `Once` and `Random` run one seed per root; `PartialOrderReduction` starts
//! each root from its own schedule and branches, at each scheduling point, to every task whose step
//! conflicts with a later one it did not already observe, so it runs one schedule per way the
//! conflicting steps can be ordered rather than one per interleaving.

import plan (Seed, Plan, Once, Random, PartialOrderReduction, normalized, seeds, seed_text)
import recording (Step, Interleaving, Verdict, Passed, Failed, effects_conflict,
                  conflicting_accesses, access_text, happens_before)
import std.list

/// Whether two steps of different tasks are ordered by what they touch, or always.
pub type Dependence = | Exact | EveryPair

/// What a search run beside the pruned one explored; `stopped_early` when a spent budget or a failure
/// stopped it short of its frontier, so the count is a lower bound.
pub type Cost = { explored: Int, stopped_early: Bool }

pub type RaceSite = {
  task: Int,
  definition: Option<String>,
  access: String,
  span: { module: Int, start: Int, end: Int },
}

/// Two steps whose reordering at scheduling point `at` turned a pass into a failure.
pub type Race = { left: RaceSite, right: RaceSite, scheduling_point: Int }

/// `exhaustive` when every interleaving ran, up to reordering steps that do not conflict;
/// `exhausted` when the budget was spent; `virtual_time` the last interleaving's.
pub type Exploration = {
  explored: Int,
  exhaustive: Bool,
  exhausted: Bool,
  naive: Option<Cost>,
  no_clocks: Option<Cost>,
  steps: Int,
  virtual_time: Int,
  failure: Option<Seed>,
  race: Option<Race>,
}

pub fn cacheable(e: Exploration) -> Bool = e.failure == None && !e.exhausted

/// What stopped a search at a seed: the run failed; the recording names no schedule, which is Ply's
/// defect; or a replay did not take the schedule the seed names.
pub type Cause<f> =
  | RunFailed(f)
  | InvalidRecording({ seed: Seed, span: { module: Int, start: Int, end: Int }, what: String })
  | Diverged({ seed: Seed, span: { module: Int, start: Int, end: Int }, what: String })

/// `notes` say why only a less pruned search reached the failure.
pub type Failure<f> = { cause: Cause<f>, notes: List<String> }

pub type SearchResult<f> = {
  exploration: Exploration,
  failure: Option<Failure<f>>,
  seeds: List<Seed>,
}

pub fn passed<f>(e: SearchResult<f>) -> Bool = e.exploration.failure == None

/// What the run a search stopped at failed with, when it was the run that failed rather than its
/// recording or its replay.
pub fn run_failure<f>(fl: Failure<f>) -> Option<f> =
  match fl.cause { RunFailed(f) -> Some(f), _ -> None }

/// Interleavings `measure_reduction` lets the searches beside the pruned one run.
pub fn naive_budget() -> Int = 4096

fn no_exploration() -> Exploration =
  {
    explored: 0,
    exhaustive: false,
    exhausted: false,
    naive: None,
    no_clocks: None,
    steps: 0,
    virtual_time: 0,
    failure: None,
    race: None,
  }

/// One interleaving a caller ran, and what it keeps across the runs of a search.
pub type RunResult<f, s> = { run: Interleaving<f>, state: s }

pub type StatefulResult<f, s> = { explored: SearchResult<f>, state: s }

pub fn explore<f | e>(
  plan: Plan,
  run: (Seed) -> Interleaving<f> / e,
) -> SearchResult<f> / {abort.raise | e} = explore_under(plan, Exact, run)

pub fn explore_under<f | e>(
  plan: Plan,
  dependence: Dependence,
  run: (Seed) -> Interleaving<f> / e,
) -> SearchResult<f> / {abort.raise | e} =
  explore_with_state(plan, dependence, (), |u: Unit, seed: Seed|
    { run: run(seed), state: u }).explored

/// `explore_under`, threading the caller's `state` through every run in the order they run.
pub fn explore_with_state<f, s | e>(
  plan: Plan,
  dependence: Dependence,
  state: s,
  run: (s, Seed) -> RunResult<f, s> / e,
) -> StatefulResult<f, s> / {abort.raise | e} = {
  let n = normalized(plan);
  match n.mode {
    PartialOrderReduction -> search_roots(n, dependence, state, run),
    _ -> sample_roots(n, state, run),
  }
}

/// The search again with every clock withheld and again with every pair dependent, filling `blind`
/// and `naive`. Each prunes less than the pruned search, so a failure only one of them reaches is
/// one the pruning skipped, and is the run's.
pub fn measure_reduction<f | e>(
  plan: Plan,
  run: (Seed) -> Interleaving<f> / e,
) -> SearchResult<f> / {abort.raise | e} =
  measure_with_state(plan, (), |u: Unit, seed: Seed| { run: run(seed), state: u }).explored

/// `measure_reduction`, threading the caller's `state` through the three searches in turn.
pub fn measure_with_state<f, s | e>(
  plan: Plan,
  state: s,
  run: (s, Seed) -> RunResult<f, s> / e,
) -> StatefulResult<f, s> / {abort.raise | e} = {
  let first = explore_with_state(plan, Exact, state, run);
  let explored = first.explored;
  if plan.mode != PartialOrderReduction || explored.exploration.failure != None { first } else {
    let measuring = { ..plan, budget: max(plan.budget, naive_budget()) };
    let blinded = explore_with_state(measuring, Exact, first.state, |st: s, seed: Seed| {
      let r = run(st, seed);
      { run: without_clocks(r.run), state: r.state }
    });
    let blind = blinded.explored;
    let naived = explore_with_state(measuring, EveryPair, blinded.state, run);
    let naive = naived.explored;
    let costed = {
      ..explored.exploration,
      no_clocks: Some(cost_of(blind)),
      naive: Some(cost_of(naive)),
    };
    let skipped = [
      {
        by: blind,
        reason: "this interleaving was reached only with every step's vector clock withheld, so the pruned search skipped it: a step's recorded clock claims it observed a step it did not",
      },
      {
        by: naive,
        reason: "this interleaving was reached only with the dependence relation forced to true, so the pruned search skipped it: a step's recorded effects are missing an access it made",
      },
    ];
    let out = match skipped.filter(|k: { by: SearchResult<f>, reason: String }| !passed(k.by)) {
      [missed, ..] ->
        {
          exploration: {
            ..costed,
            failure: missed.by.exploration.failure,
            race: missed.by.exploration.race,
            exhaustive: false,
          },
          failure: match missed.by.failure {
            Some(fl) -> Some({ ..fl, notes: fl.notes.push(missed.reason) }),
            None -> None,
          },
          seeds: explored.seeds,
        },
      [] -> { ..explored, exploration: costed },
    };
    { explored: out, state: naived.state }
  }
}

fn without_clocks<f>(i: Interleaving<f>) -> Interleaving<f> =
  { ..i, steps: i.steps.map(|s: Step| { ..s, vector_clock: [] }) }

fn cost_of<f>(m: SearchResult<f>) -> Cost =
  { explored: m.exploration.explored, stopped_early: m.exploration.exhausted || !passed(m) }

// --- One seed per root ------------------------------------------------------

type SearchProgress<f, s> = {
  exploration: Exploration,
  failure: Option<Failure<f>>,
  seeds: List<Seed>,
  done: Bool,
  state: s,
}

fn sample_roots<f, s | e>(
  plan: Plan,
  state: s,
  run: (s, Seed) -> RunResult<f, s> / e,
) -> StatefulResult<f, s> / e = {
  let out = seeds(plan).fold(
    { exploration: no_exploration(), failure: None, seeds: [], done: false, state: state },
    |acc: SearchProgress<f, s>, seed: Seed|
      if acc.done { acc } else {
        let ran = run(acc.state, seed);
        let r = ran.run;
        let e = {
          ..acc.exploration,
          explored: acc.exploration.explored + 1,
          steps: acc.exploration.steps + r.steps.len(),
          virtual_time: r.virtual_time,
        };
        let next = { ..acc, exploration: e, seeds: acc.seeds.push(seed), state: ran.state };
        match check_recording(seed, r.steps) {
          Some(cause) ->
            {
              ..next,
              exploration: { ..e, failure: Some(seed) },
              failure: Some({ cause: cause, notes: [] }),
              done: true,
            },
          None -> match r.verdict {
            Failed(f) ->
              {
                ..next,
                exploration: { ..e, failure: Some(seed) },
                failure: Some({ cause: RunFailed(f), notes: [] }),
                done: true,
              },
            Passed -> next,
          },
        }
      },
  );
  {
    explored: { exploration: out.exploration, failure: out.failure, seeds: out.seeds },
    state: out.state,
  }
}

// --- The search ---------------------------------------------------------------

fn search_roots<f, s | e>(
  plan: Plan,
  dependence: Dependence,
  state: s,
  run: (s, Seed) -> RunResult<f, s> / e,
) -> StatefulResult<f, s> / {abort.raise | e} = {
  let out = plan.roots.fold(
    {
      exploration: { ..no_exploration(), exhaustive: true },
      failure: None,
      seeds: [],
      done: false,
      state: state,
    },
    |acc: SearchProgress<f, s>, root: U64|
      if acc.done { acc } else {
        let reached = search_root(root, plan.budget, dependence, acc.state, run);
        let report = reached.report;
        let e = {
          ..acc.exploration,
          explored: acc.exploration.explored + report.explored,
          steps: acc.exploration.steps + report.steps,
          virtual_time: report.virtual_time,
          exhausted: acc.exploration.exhausted || report.exhausted,
          exhaustive: acc.exploration.exhaustive && !report.exhausted,
        };
        let seen = {
          ..acc,
          exploration: e,
          seeds: acc.seeds.concat(report.seeds),
          state: reached.state,
        };
        match report.failure {
          None -> seen,
          Some(fl) ->
            {
              ..seen,
              exploration: { ..e, failure: Some(fl.seed), race: fl.race, exhaustive: false },
              failure: Some({ cause: fl.cause, notes: [] }),
              done: true,
            },
        }
      },
  );
  {
    explored: { exploration: out.exploration, failure: out.failure, seeds: out.seeds },
    state: out.state,
  }
}

/// The run a queued interleaving branched off, the point where it diverges, the choice it takes
/// there, and the step it meant to reorder against the one at that point.
type Branch = { trace: List<Step>, at: Int, choice: Int, against: Option<Int> }

type Work = { path: List<Int>, branch: Option<Branch> }

/// Last in, first out, as the search takes its work.
type Stack<a> = | Empty | Pushed(a, Stack<a>)

type RootFailure<f> = { seed: Seed, cause: Cause<f>, race: Option<Race> }

type RootReport<f> = {
  explored: Int,
  steps: Int,
  virtual_time: Int,
  exhausted: Bool,
  failure: Option<RootFailure<f>>,
  seeds: List<Seed>,
}

/// Every (prefix, choice) the search has run or queued, by the prefix's bytes.
type Claimed = Map<Bytes, Map<Int, Bool>>

type SearchState<f, s> = {
  frontier: Stack<Work>,
  claimed: Claimed,
  report: RootReport<f>,
  state: s,
}

fn search_root<f, s | e>(
  root: U64,
  budget: Int,
  dependence: Dependence,
  state: s,
  run: (s, Seed) -> RunResult<f, s> / e,
) -> { report: RootReport<f>, state: s } / {abort.raise | e} = {
  let start = {
    frontier: Pushed({ path: [], branch: None }, Empty),
    claimed: Map::new(),
    report: { explored: 0, steps: 0, virtual_time: 0, exhausted: false, failure: None, seeds: [] },
    state: state,
  };
  // Each pass runs one interleaving, so the budget bounds the passes.
  iterate(start, budget + 2, |st: SearchState<f, s>|
    match st.frontier {
      Empty -> Stop({ report: st.report, state: st.state }),
      Pushed(work, rest) -> if st.report.explored >= budget {
        Stop({ report: { ..st.report, exhausted: true }, state: st.state })
      } else { Continue(search_step({ ..st, frontier: rest }, root, work, dependence, run)) },
    })
}

/// One pass: the work's interleaving runs, and what it reveals is queued or ends the root.
fn search_step<f, s | e>(
  st: SearchState<f, s>,
  root: U64,
  work: Work,
  dependence: Dependence,
  run: (s, Seed) -> RunResult<f, s> / e,
) -> SearchState<f, s> / e = {
  let seed = { root: root, path: work.path };
  let ran = run(st.state, seed);
  let r = ran.run;
  let report = {
    ..st.report,
    explored: st.report.explored + 1,
    steps: st.report.steps + r.steps.len(),
    virtual_time: r.virtual_time,
    seeds: st.report.seeds.push(seed),
  };
  let ended = |cause: Cause<f>, race: Option<Race>|
    {
      frontier: Empty,
      claimed: st.claimed,
      report: { ..report, failure: Some({ seed: seed, cause: cause, race: race }) },
      state: ran.state,
    };
  match check_recording(seed, r.steps) {
    Some(cause) -> ended(cause, None),
    None -> match match work.branch { Some(b) -> check_replay(seed, b, r.steps), None -> None } {
      Some(cause) -> ended(cause, None),
      None -> match r.verdict {
        Failed(f) -> ended(RunFailed(f), match work.branch { Some(b) -> race_of(b), None -> None }),
        Passed -> queue_backtracks({ ..st, report: report, state: ran.state }, r.steps, dependence),
      },
    },
  }
}

fn choices_of(steps: List<Step>) -> List<Int> = steps.map(|s: Step| s.choice)

fn key_of(prefix: List<Int>) -> Bytes =
  Bytes::concat_all(prefix.map(|c: Int| byte_of_int(c & 255).concat(byte_of_int(c >> 8 & 255))))

/// Claims `choice` after `key`, returning whether it was unclaimed.
fn claim(claimed: Claimed, key: Bytes, choice: Int) -> { claimed: Claimed, fresh: Bool } = {
  let taken = match claimed.get(key) { Some(t) -> t, None -> Map::new() };
  if taken.contains(choice) { { claimed: claimed, fresh: false } }
  else { { claimed: claimed.insert(key, taken.insert(choice, true)), fresh: true } }
}

/// Claims every choice the run took, then queues each backtrack nothing claimed yet.
fn queue_backtracks<f, s>(
  st: SearchState<f, s>,
  trace: List<Step>,
  dependence: Dependence,
) -> SearchState<f, s> = {
  let choices = choices_of(trace);
  let prefixes = range(0, trace.len()).fold(
    { claimed: st.claimed, key: b"" },
    |acc: { claimed: Claimed, key: Bytes }, i: Int|
      match trace.at(i) {
        None -> acc,
        Some(step) -> {
          let c = claim(acc.claimed, acc.key, step.choice).claimed;
          { claimed: c, key: acc.key.concat(key_of([step.choice])) }
        },
      },
  );
  backtracks(trace, dependence).fold(
    { ..st, claimed: prefixes.claimed },
    |acc: SearchState<f, s>, at: Int, tasks: Map<Int, Option<Int>>| {
      let prefix = choices.take(at);
      let key = key_of(prefix);
      let enabled = match trace.at(at) { Some(s) -> s.runnable, None -> [] };
      tasks.fold(acc, |inner: SearchState<f, s>, task: Int, against: Option<Int>|
        match enabled.index_of(task) {
          None -> inner,
          Some(choice) -> {
            let c = claim(inner.claimed, key, choice);
            if !c.fresh { { ..inner, claimed: c.claimed } } else {
              {
                ..inner,
                claimed: c.claimed,
                frontier: Pushed(
                  {
                    path: prefix.push(choice),
                    branch: Some({ trace: trace, at: at, choice: choice, against: against }),
                  },
                  inner.frontier,
                ),
              }
            }
          },
        })
    },
  )
}

/// Per scheduling point, the tasks worth resuming there instead, each beside the step it reorders
/// against when it was enabled at that point.
pub fn backtracks(steps: List<Step>, dependence: Dependence) -> Map<Int, Map<Int, Option<Int>>> = {
  let n = steps.len();
  range(1, n).fold(Map::new(), |out: Map<Int, Map<Int, Option<Int>>>, back: Int| {
    let i = n - back;
    match steps.at(i) {
      None -> out,
      Some(later) ->
        range(0, i).fold(out, |acc: Map<Int, Map<Int, Option<Int>>>, down: Int| {
          let j = i - 1 - down;
          match steps.at(j) {
            None -> acc,
            Some(earlier) ->              // Schedulers run one after another, and a task's steps are program order.
              if earlier.scheduler != later.scheduler || earlier.task == later.task { acc }
              else if !dependent(dependence, earlier, later) { acc }
              else if dependence == Exact && happens_before(earlier, later) { acc } else {
                let at = match acc.get(j) { Some(m) -> m, None -> Map::new() };
                let marked = if earlier.runnable.index_of(later.task) != None {
                  record_backtrack(at, later.task, Some(i))
                } else {
                  earlier.runnable.fold(at, |m: Map<Int, Option<Int>>, t: Int|
                    record_backtrack(m, t, None))
                };
                acc.insert(j, marked)
              },
          }
        }),
    }
  })
}

fn dependent(d: Dependence, a: Step, b: Step) -> Bool =
  match d { Exact -> effects_conflict(a.accesses, b.accesses), EveryPair -> true }

/// A concrete pair is never overwritten, so a conservative branch never erases a real race.
fn record_backtrack(
  at: Map<Int, Option<Int>>,
  task: Int,
  against: Option<Int>,
) -> Map<Int, Option<Int>> =
  match at.get(task) { Some(Some(_)) -> at, _ -> at.insert(task, against) }

fn race_of(b: Branch) -> Option<Race> =
  match b.against {
    None -> None,
    Some(against) -> match ((b.trace.at(b.at), b.trace.at(against))) {
      (Some(left), Some(right)) -> match ((race_site(left, right), race_site(right, left))) {
        (Some(l), Some(r)) -> Some({ left: l, right: r, scheduling_point: b.at }),
        _ -> None,
      },
      _ -> None,
    },
  }

fn race_site(step: Step, other: Step) -> Option<RaceSite> =
  match conflicting_accesses(step.accesses, other.accesses) {
    [first, ..] ->
      Some({
        task: step.task,
        definition: step.site.definition,
        access: access_text(first),
        span: step.site.span,
      }),
    [] -> None,
  }

// --- What a recording must be ---------------------------------------------------

fn task_text(t: Int) -> String = "@" ++ t.to_string()

fn tasks_text(ts: List<Int>) -> String =
  if ts.len() == 0 { "{}" } else {
    ts.fold("", |acc: String, t: Int|
      if acc == "" { task_text(t) } else { acc ++ ", " ++ task_text(t) })
  }

/// A recording that is not a schedule: everything concluded from it would rest on it.
fn check_recording<f>(seed: Seed, steps: List<Step>) -> Option<Cause<f>> =
  range(0, steps.len()).fold(None, |found: Option<Cause<f>>, i: Int|
    match found {
      Some(_) -> found,
      None -> match steps.at(i) {
        None -> None,
        Some(step) -> if step.runnable.len() > 65535 {
          Some(
            InvalidRecording({
              seed: seed,
              span: step.site.span,
              what: "scheduling point " ++ i.to_string() ++ " offered "
                ++ step.runnable.len().to_string()
                ++ " enabled tasks, and a seed's choice sequence cannot name more than 65535",
            }),
          )
        } else if step.runnable.at(step.choice) == Some(step.task) { None } else {
          Some(
            InvalidRecording({
              seed: seed,
              span: step.site.span,
              what: "scheduling point " ++ i.to_string() ++ " resumed " ++ task_text(step.task)
                ++ " as choice "
                ++ step.choice.to_string()
                ++ ", which its enabled set "
                ++ tasks_text(step.runnable)
                ++ " does not offer",
            }),
          )
        },
      },
    })

/// A replay of a prefix must offer the enabled set the recording did at every point it names.
fn check_replay<f>(seed: Seed, b: Branch, steps: List<Step>) -> Option<Cause<f>> =
  range(0, b.at + 1).fold(None, |found: Option<Cause<f>>, point: Int|
    match found {
      Some(_) -> found,
      None -> match b.trace.at(point) {
        None -> None,
        Some(expected) -> match steps.at(point) {
          None ->
            Some(
              Diverged({
                seed: seed,
                span: expected.site.span,
                what: "the run stopped after " ++ steps.len().to_string()
                  ++ " scheduling points, and this seed names a choice at point "
                  ++ point.to_string(),
              }),
            ),
          Some(actual) -> if actual.runnable != expected.runnable {
            Some(
              Diverged({
                seed: seed,
                span: expected.site.span,
                what: "at scheduling point " ++ point.to_string()
                  ++ " the recorded enabled set was "
                  ++ tasks_text(expected.runnable)
                  ++ " and the replay offered "
                  ++ tasks_text(actual.runnable),
              }),
            )
          } else {
            let wanted = if point == b.at { b.choice } else { expected.choice };
            if actual.choice == wanted { None } else {
              Some(
                Diverged({
                  seed: seed,
                  span: expected.site.span,
                  what: "at scheduling point " ++ point.to_string() ++ " this seed names choice "
                    ++ wanted.to_string()
                    ++ " and the replay took "
                    ++ actual.choice.to_string(),
                }),
              )
            }
          },
        },
      },
    })
