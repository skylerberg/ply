import plan (Seed, Plan, PartialOrderReduction, Once, Random, default_plan, once, root_seed, u64_le)
import recording (Step, Interleaving, Passed, Failed, Access, EffectAccess, VariableAccess)
import search (Exploration, SearchResult, Exact, EveryPair, Cost, explore, explore_under,
               measure_reduction, backtracks, passed, run_failure, InvalidRecording, Diverged)
import std.list
import std.map

type Operation =
  | Load(Int)
  | Store(Int)
  | Perform(String, Bool)
  | Spawn(String, List<Operation>)
  | Join(Int)
  | Yield
  | When(Int, Int, List<Operation>, List<Operation>)

type ModelTask = {
  name: String,
  operations: List<Operation>,
  program_counter: Int,
  register: Int,
  children: List<Int>,
  blocked: Option<Int>,
  clock: List<Int>,
}

type Model = { schedulers: List<List<Operation>>, expect: List<{ variable: Int, value: Int }> }

fn program(main: List<Operation>) -> Model = { schedulers: [main], expect: [] }

fn schedulers(mains: List<List<Operation>>) -> Model = { schedulers: mains, expect: [] }

fn expecting(model: Model, expected: List<{ variable: Int, value: Int }>) -> Model =
  { ..model, expect: expected }

fn max_steps() -> Int = 4096

fn finished(tasks: List<ModelTask>, t: Int) -> Bool / {abort.raise} =
  match range(0, tasks.len() + 1).fold(
      { task: t, result: None },
      |s: { task: Int, result: Option<Bool> }, _round: Int|
        match s.result {
          Some(_) -> s,
          None -> {
            let task = tasks.get(s.task);
            if task.program_counter != task.operations.len() { { ..s, result: Some(false) } } else {
              match task.blocked {
                None -> { ..s, result: Some(true) },
                Some(on) -> { ..s, task: on },
              }
            }
          },
        },
    ).result {
    Some(done) -> done,
    None -> false,
  }

fn enabled_tasks(tasks: List<ModelTask>) -> List<Int> / {abort.raise} =
  range(0, tasks.len()).filter(|t: Int| {
    let task = tasks.get(t);
    task.program_counter < task.operations.len()
      && (match task.blocked { None -> true, Some(on) -> finished(tasks, on) })
  })

fn widen_clock(clock: List<Int>, width: Int) -> List<Int> =
  range(clock.len(), width).fold(clock, |accumulator: List<Int>, _i: Int| accumulator.push(0))

fn tick_clock(tasks: List<ModelTask>, t: Int) -> List<ModelTask> / {abort.raise} = {
  let width = tasks.len();
  let wide = tasks.map(|task: ModelTask| { ..task, clock: widen_clock(task.clock, width) });
  let task = wide.get(t);
  wide.set(t, { ..task, clock: task.clock.set(t, task.clock.get(t) + 1) })
}

fn merge_clock(tasks: List<ModelTask>, into: Int, from: Int) -> List<ModelTask> / {abort.raise} = {
  let source = tasks.get(from).clock;
  let target = tasks.get(into);
  let wide = widen_clock(target.clock, source.len());
  let merged = range(0, wide.len()).map(|i: Int|
    max(wide.get(i), match source.at(i) { Some(s) -> s, None -> 0 }));
  tasks.set(into, { ..target, clock: merged })
}

fn random_u64(root: U64, counter: Int) -> U64 / {abort.raise} = {
  let b = Bytes::concat_all([
    Bytes::of_string("ply.sim.stream.1"),
    u64_le(root),
    byte_of_int(0),
    u64_le(U64::of_int(counter)),
  ]).blake3(
  );
  let low = U64::of_int(Int::of_u32(b.u32_le(0)));
  let high = U64::of_int(Int::of_u32(b.u32_le(4)));
  high * 4294967296u64 + low
}

fn random_below(root: U64, counter: Int, n: Int) -> { value: Int, counter: Int } / {abort.raise} = {
  let limit = 18446744073709551615u64 / U64::of_int(n) * U64::of_int(n);
  iterate(counter, 64, |c: Int| {
    let x = random_u64(root, c);
    if x < limit { Stop({ value: Int::of_u64(x % U64::of_int(n)), counter: c + 1 }) }
    else { Continue(c + 1) }
  })
}

type RunState = {
  tasks: List<ModelTask>,
  variables: Map<Int, Int>,
  counter: Int,
  steps: List<Step>,
  capped: Bool,
}

fn scheduler_ran(
  st: RunState,
  seed: Seed,
  scheduler: Int,
  main: List<Operation>,
) -> RunState / {abort.raise} = {
  let task = {
    name: "main",
    operations: main,
    program_counter: 0,
    register: 0,
    children: [],
    blocked: None,
    clock: [0],
  };
  iterate({ ..st, tasks: [task] }, max_steps() + 2, |s: RunState| {
    let enabled = enabled_tasks(s.tasks);
    if enabled.len() == 0 { Stop(s) }
    else if s.steps.len() >= max_steps() { Stop({ ..s, capped: true }) }
    else { Continue(take_step(s, seed, scheduler, enabled)) }
  })
}

fn stuck(tasks: List<ModelTask>) -> Bool / {abort.raise} =
  range(0, tasks.len()).fold(false, |b: Bool, t: Int| b || !finished(tasks, t))

fn run(model: Model, seed: Seed) -> Interleaving<String> / {abort.raise} = {
  let start = {
    ran: { tasks: [], variables: Map::new(), counter: 0, steps: [], capped: false },
    stuck: false,
  };
  let end = range(0, model.schedulers.len()).fold(
    start,
    |accumulator: { ran: RunState, stuck: Bool }, s: Int|
      if accumulator.stuck || accumulator.ran.capped { accumulator } else {
        let ran = scheduler_ran(accumulator.ran, seed, s, model.schedulers.get(s));
        { ran: ran, stuck: stuck(ran.tasks) }
      },
  ).ran;
  if end.capped {
    { steps: end.steps, verdict: Failed("the model ran out of steps"), virtual_time: 0 }
  } else if stuck(end.tasks) {
    { steps: end.steps, verdict: Failed("no task can make progress"), virtual_time: 0 }
  } else {
    let wrong = model.expect.filter(|e: { variable: Int, value: Int }|
      end.variables.get_or(e.variable, 0) != e.value);
    match wrong {
      [first, ..] ->
        {
          steps: end.steps,
          verdict: Failed(
            "expected " ++ first.value.to_string() ++ " in variable #" ++ first.variable.to_string()
              ++ ", found "
              ++ end.variables.get_or(first.variable, 0).to_string(),
          ),
          virtual_time: 0,
        },
      [] -> { steps: end.steps, verdict: Passed, virtual_time: 0 },
    }
  }
}

fn take_step(
  st: RunState,
  seed: Seed,
  scheduler: Int,
  enabled: List<Int>,
) -> RunState / {abort.raise} = {
  let point = st.steps.len();
  let drawn = match seed.path.at(point) {
    Some(fixed) -> { value: fixed, counter: st.counter },
    None -> random_below(seed.root, st.counter, enabled.len()),
  };
  let chosen = min(drawn.value, enabled.len() - 1);
  let t = enabled.get(chosen);
  let task = st.tasks.get(t);
  let operation = task.operations.get(task.program_counter);
  let moved = tick_clock(st.tasks.set(t, { ..task, program_counter: task.program_counter + 1 }), t);
  let did = match operation {
    Load(v) ->
      {
        tasks: moved.set(t, { ..moved.get(t), register: st.variables.get_or(v, 0) }),
        variables: st.variables,
        accesses: [VariableAccess({ handler: 0, index: v, write: false })],
      },
    Store(v) ->
      {
        tasks: moved,
        variables: st.variables.insert(v, moved.get(t).register + 1),
        accesses: [VariableAccess({ handler: 0, index: v, write: true })],
      },
    Perform(resource, write) ->
      {
        tasks: moved,
        variables: st.variables,
        accesses: [
          EffectAccess({ effect: "db", resource: Some(resource), write: write, operation: None }),
        ],
      },
    Spawn(name, operations) -> {
      let child = moved.len();
      let parent = moved.get(t);
      let born = {
        name: name,
        operations: operations,
        program_counter: 0,
        register: 0,
        children: [],
        blocked: None,
        clock: parent.clock,
      };
      {
        tasks: moved.set(t, { ..parent, children: parent.children.push(child) }).push(born),
        variables: st.variables,
        accesses: [],
      }
    },
    Join(nth) -> {
      let child = moved.get(t).children.get(nth);
      if finished(moved, child) {
        { tasks: merge_clock(moved, t, child), variables: st.variables, accesses: [] }
      } else {
        {
          tasks: moved.set(t, { ..moved.get(t), blocked: Some(child) }),
          variables: st.variables,
          accesses: [],
        }
      }
    },
    Yield -> { tasks: moved, variables: st.variables, accesses: [] },
    When(v, n, matching, otherwise) -> {
      let task = moved.get(t);
      let branch = if st.variables.get_or(v, 0) == n { matching } else { otherwise };
      {
        tasks: moved.set(t, {
          ..task,
          operations: task.operations.take(task.program_counter).concat(branch).concat(
            task.operations.drop(task.program_counter),
          ),
        }),
        variables: st.variables,
        accesses: [VariableAccess({ handler: 0, index: v, write: false })],
      }
    },
  };
  let woken = range(0, did.tasks.len()).fold(did.tasks, |ts: List<ModelTask>, i: Int|
    match ts.get(i).blocked {
      Some(on) -> if finished(ts, on) { merge_clock(ts, i, on) } else { ts },
      None -> ts,
    });
  {
    tasks: woken,
    variables: did.variables,
    counter: drawn.counter,
    steps: st.steps.push({
      scheduler: scheduler,
      task: t,
      runnable: enabled,
      choice: chosen,
      accesses: did.accesses,
      site: { definition: Some(woken.get(t).name), span: { module: 0, start: 0, end: 0 } },
      vector_clock: woken.get(t).clock,
    }),
    capped: false,
  }
}

fn dpor(budget: Int) -> Plan = { ..default_plan(), budget: budget }

fn explore_model(model: Model, plan: Plan) -> SearchResult<String> / {abort.raise} =
  explore(plan, |seed: Seed| run(model, seed))

fn read(r: String) -> Operation = Perform(r, false)

fn write(r: String) -> Operation = Perform(r, true)

fn both_orders(model: Model, seeds: List<Seed>, a: Int, b: Int) -> Bool / {abort.raise} = {
  let orders = seeds.map(|seed: Seed| {
    let tasks = run(model, seed).steps.map(|st: Step| st.task);
    { a: tasks.index_of(a), b: tasks.index_of(b) }
  });
  let seen = |before: Bool|
    orders.fold(false, |found: Bool, o: { a: Option<Int>, b: Option<Int> }|
      found || (match ((o.a, o.b)) { (Some(x), Some(y)) -> x < y == before, _ -> false }));
  seen(true) && seen(false)
}

fn independent_tasks() -> Model =
  program([Spawn("a", [Load(1), Store(1)]), Spawn("b", [Load(2), Store(2)]), Join(0), Join(1)])

fn racing() -> List<Operation> =
  [Spawn("a", [Load(1), Store(1)]), Spawn("b", [Load(1), Store(1)]), Join(0), Join(1)]

fn lost_update() -> Model = program(racing())

test "tasks that never conflict explore exactly one interleaving" {
  let e = explore_model(
    expecting(independent_tasks(), [{ variable: 1, value: 1 }, { variable: 2, value: 1 }]),
    dpor(64),
  );
  assert_eq(
    (e.exploration.explored, e.exploration.exhaustive, e.exploration.exhausted, passed(e)),
    (1, true, false, true),
  )
}

test "searching all interleavings of the same program runs more interleavings than the reduced search" {
  let m = expecting(independent_tasks(), [{ variable: 1, value: 1 }, { variable: 2, value: 1 }]);
  let e = measure_reduction(dpor(4096), |seed: Seed| run(m, seed));
  assert_eq(e.exploration.explored, 1);
  assert_eq(e.exploration.naive, Some({ explored: 71, stopped_early: false }))
}

test "a shared variable needs more interleavings, but the reduced search still runs fewer than the full search" {
  assert_eq(explore_model(lost_update(), dpor(4096)).exploration.explored, 9);
  assert_eq(
    explore_under(dpor(4096), EveryPair, |seed: Seed|
      run(lost_update(), seed)).exploration.explored,
    71,
  )
}

test "the full search's interleaving count matches the count worked out by hand for a small program" {
  let m = program([Spawn("a", [read("x")]), Spawn("b", [read("y")])]);
  let e = measure_reduction(dpor(64), |seed: Seed| run(m, seed));
  assert_eq(e.exploration.explored, 1);
  assert_eq(e.exploration.naive, Some({ explored: 3, stopped_early: false }));
  assert_eq(e.exploration.no_clocks, Some({ explored: 1, stopped_early: false }))
}

test "a full search that runs out of budget reports its count as stopped early" {
  let m = program([
    Spawn("a", [read("x"), read("x"), read("x"), read("x")]),
    Spawn("b", [read("y"), read("y"), read("y"), read("y")]),
    Spawn("c", [read("z"), read("z"), read("z"), read("z")]),
    Join(0),
    Join(1),
    Join(2),
  ]);
  let e = measure_reduction({ ..default_plan(), budget: 8 }, |seed: Seed| run(m, seed));
  assert_eq(e.exploration.naive, Some({ explored: 4096, stopped_early: true }))
}

test "a conflicting pair is explored in both orders, and a lost update is found and named" {
  let pair = expecting(
    program([Spawn("a", [Store(1)]), Spawn("b", [Store(1)]), Join(0), Join(1)]),
    [{ variable: 1, value: 1 }],
  );
  let e = explore_model(pair, dpor(64));
  assert(passed(e) && e.exploration.exhaustive && e.exploration.explored >= 2);
  assert(both_orders(pair, e.seeds, 1, 2));
  let race_model = expecting(
    program([
      Spawn("credit", [Load(1), Store(1)]),
      Spawn("debit", [Load(1), Store(1)]),
      Join(0),
      Join(1),
    ]),
    [{ variable: 1, value: 2 }],
  );
  let raced = explore_model(race_model, dpor(256));
  assert(!passed(raced));
  match ((raced.exploration.failure, raced.exploration.race)) {
    (Some(seed), Some(race)) -> {
      assert(race.left.task != race.right.task);
      assert(race.left.access.starts_with("var.") && race.right.access.starts_with("var."));
      assert(race.left.definition != None && race.right.definition != None);
      let again = explore_model(race_model, once(seed));
      assert_eq((passed(again), again.exploration.explored, again.exploration.race), (
        false,
        1,
        None,
      ))
    },
    _ -> panic("the lost update was not found"),
  }
}

test "effects conflict on one resource only, and readers commute" {
  let disjoint = program([
    Spawn("a", [read("x"), write("y")]),
    Spawn("b", [read("x"), write("z")]),
    Join(0),
    Join(1),
  ]);
  let read_only = explore_model(disjoint, dpor(64));
  assert_eq((read_only.exploration.explored, read_only.exploration.exhaustive), (1, true));
  let contended = program([
    Spawn("a", [write("x"), write("y")]),
    Spawn("b", [read("x"), write("z")]),
    Join(0),
    Join(1),
  ]);
  let contested = explore_model(contended, dpor(64));
  assert(contested.exploration.explored > 1 && contested.exploration.exhaustive);
  assert(both_orders(contended, contested.seeds, 1, 2));
  let readers = program([Spawn("a", [read("x")]), Spawn("b", [read("x")]), Join(0), Join(1)]);
  assert_eq(explore_model(readers, dpor(64)).exploration.explored, 1);
  let writer = program([Spawn("a", [read("x")]), Spawn("b", [write("x")]), Join(0), Join(1)]);
  let w = explore_model(writer, dpor(64));
  assert(w.exploration.explored >= 2 && w.exploration.explored <= 3 && w.exploration.exhaustive);
  assert(both_orders(writer, w.seeds, 1, 2))
}

test "a race involving a nested spawned task is found, and a nested task that touches nothing shared runs as one interleaving" {
  let nested = expecting(
    program([
      Spawn("outer", [Spawn("inner", [Load(1), Store(1)]), Join(0)]),
      Spawn("other", [Load(1), Store(1)]),
      Join(0),
      Join(1),
    ]),
    [{ variable: 1, value: 2 }],
  );
  let e = explore_model(nested, dpor(256));
  assert(!passed(e));
  match e.exploration.race {
    Some(race) -> assert(race.left.task == 3 || race.right.task == 3),
    None -> panic("no race"),
  };
  let quiet = expecting(
    program([
      Spawn("outer", [Spawn("inner", [Store(2)]), Join(0)]),
      Spawn("other", [Store(3)]),
      Join(0),
      Join(1),
    ]),
    [{ variable: 2, value: 1 }, { variable: 3, value: 1 }],
  );
  let q = explore_model(quiet, dpor(64));
  assert_eq((passed(q), q.exploration.explored, q.exploration.exhaustive), (true, 1, true))
}

test "a race with a task that was blocked at the backtrack point is still found" {
  let m = expecting(
    program([
      Spawn("late", [Spawn("barrier", [Yield]), Join(0), Load(1), Store(1)]),
      Load(1),
      Store(1),
      Join(0),
    ]),
    [{ variable: 1, value: 2 }],
  );
  range(0, 8).fold((), |_u: Unit, root: Int| {
    let e = explore_model(m, { ..default_plan(), roots: [U64::of_int(root)], budget: 512 });
    assert(!passed(e))
  })
}

test "`backtracks` adds no alternative at an earlier step for a conflicting later task that could not run at that step, and adds one when it could" {
  let var = |w: Bool| [VariableAccess({ handler: 0, index: 1, write: w })];
  let step = |task: Int, enabled: List<Int>, choice: Int, accesses: List<Access>|
    {
      scheduler: 0,
      task: task,
      runnable: enabled,
      choice: choice,
      accesses: accesses,
      site: { definition: None, span: { module: 0, start: 0, end: 0 } },
      vector_clock: [],
    };
  let blocked = backtracks(
    [step(0, [0, 1], 0, var(true)), step(1, [0, 1], 1, []), step(2, [0, 1, 2], 2, var(true))],
    Exact,
  );
  match blocked.get(0) {
    Some(at_zero) -> {
      assert_eq(at_zero.get(1), Some(None));
      assert(!at_zero.contains(2))
    },
    None -> panic("no backtrack point at 0"),
  };
  let direct = backtracks([step(0, [0, 1], 0, var(true)), step(1, [0, 1], 1, var(true))], Exact);
  assert_eq(match direct.get(0) { Some(m) -> m.get(1), None -> None }, Some(Some(1)))
}

test "a read that a join already orders after the writes adds no interleavings, but a search that ignores vector clocks explores six runs instead of one" {
  let m = expecting(
    program([
      Spawn("a", [Load(1), Store(1)]),
      Spawn("b", [Load(2), Store(2)]),
      Join(0),
      Join(1),
      Load(1),
      Load(2),
    ]),
    [{ variable: 1, value: 1 }, { variable: 2, value: 1 }],
  );
  let e = explore_model(m, dpor(4096));
  assert_eq((passed(e), e.exploration.explored, e.exploration.exhaustive), (true, 1, true));
  let measured = measure_reduction(dpor(2), |seed: Seed| run(m, seed));
  assert_eq((passed(measured), measured.exploration.explored), (true, 1));
  assert_eq(measured.exploration.no_clocks, Some({ explored: 6, stopped_early: false }))
}

test "a search that uses up its budget stops before covering every interleaving, and no interleaving is run twice" {
  let e = explore_model(lost_update(), dpor(3));
  assert_eq((e.exploration.explored, e.exploration.exhausted, e.exploration.exhaustive), (
    3,
    true,
    false,
  ));
  let all = explore_model(lost_update(), dpor(4096));
  let distinct = all.seeds.fold([], |accumulator: List<List<Int>>, seed: Seed| {
    let trace = run(lost_update(), seed).steps.map(|st: Step| st.task);
    if accumulator.fold(false, |b: Bool, t: List<Int>| b || t == trace) { accumulator }
    else { accumulator.push(trace) }
  });
  assert_eq(distinct.len(), all.seeds.len());
  assert_eq(explore_model(lost_update(), dpor(4096)).seeds, all.seeds)
}

test "`once` runs only the interleaving that its seed describes, and `Random` mode runs one interleaving for each starting number in `roots`" {
  let e = explore_model(lost_update(), once({ root: 3u64, path: [0, 1] }));
  assert_eq((e.exploration.explored, e.seeds), (1, [{ root: 3u64, path: [0, 1] }]));
  let r = explore_model(lost_update(), {
    mode: Random,
    roots: [0u64, 1u64, 2u64],
    budget: 1,
    steps: 100,
    path: [],
  });
  assert_eq(r.exploration.explored, 3)
}

test "a seed decides which interleaving runs" {
  let verdicts = range(0, 24).map(|root: Int|
    passed(
      explore_model(
        expecting(lost_update(), [{ variable: 1, value: 2 }]),
        once({ root: U64::of_int(root), path: [] }),
      ),
    ));
  assert(verdicts.contains(true) && verdicts.contains(false), Some("every root ran alike"))
}

test "a recorded step for a task that was not runnable is an internal error, and a replay that differs from its recording is a divergence" {
  let bad = |seed: Seed|
    {
      steps: [
        {
          scheduler: 0,
          task: 5,
          runnable: [0, 1],
          choice: 0,
          accesses: [],
          site: { definition: None, span: { module: 0, start: 0, end: 0 } },
          vector_clock: [],
        },
      ],
      verdict: Passed,
      virtual_time: 0,
    };
  match explore(dpor(4), bad).failure {
    Some(f) -> match f.cause {
      InvalidRecording(u) -> assert(u.what.contains("do not include that task at this choice")),
      _ -> panic("not unscheduled"),
    },
    None -> panic("a malformed recording was accepted"),
  };
  let drifting = |seed: Seed| {
    let base = run(lost_update(), seed);
    if seed.path.len() == 0 { base }
    else { { ..base, steps: base.steps.map(|st: Step| { ..st, runnable: st.runnable.push(99) }) } }
  };
  match explore(dpor(64), drifting).failure {
    Some(f) -> match f.cause {
      Diverged(d) -> assert(d.what.contains("enabled set")),
      _ -> panic("not a divergence"),
    },
    None -> panic("a divergence was accepted"),
  }
}

fn lost_from(e: SearchResult<String>, total: Int) -> Bool = {
  let lost = "expected " ++ total.to_string() ++ " in variable #1, found ";
  e.exploration.failure != None
    && (match e.failure {
      Some(f) -> match run_failure(f) {
        Some(message) -> message.starts_with(lost) && message != lost ++ total.to_string(),
        None -> false,
      },
      None -> false,
    })
}

test "a race in an entry's first scheduler is found, whatever scheduler follows it" {
  [
    { model: schedulers([racing(), [Yield]]), total: 2 },
    { model: schedulers([racing(), racing()]), total: 4 },
  ].fold((), |_u: Unit, c: { model: Model, total: Int }| {
    let m = expecting(c.model, [{ variable: 1, value: c.total }]);
    let sampled = {
      mode: Random,
      roots: range(0, 64).map(|r: Int| U64::of_int(r)),
      budget: 1,
      steps: 100,
      path: [],
    };
    assert(lost_from(explore_model(m, sampled), c.total));
    assert(lost_from(explore_model(m, dpor(1024)), c.total))
  })
}

fn shaped_by_a_race() -> Model = {
  let noting = Spawn("noting", [Load(1), Store(2)]);
  schedulers([racing(), [When(1, 2, [noting, noting, Join(0), Join(1)], [noting, Join(0)])]])
}

test "a replay is held to its recording up to its branch, past which a scheduler may take another shape" {
  let e = explore_model(shaped_by_a_race(), dpor(1024));
  assert(passed(e), Some("a program whose every interleaving passes was rejected"));
  let second = e.seeds.map(|seed: Seed|
    run(shaped_by_a_race(), seed).steps.filter(|st: Step| st.scheduler == 1).len());
  assert(
    second.any(|n: Int| n != second.get(0)),
    Some(
      "the search ran the second scheduler in one shape, so no replay strayed from its recording",
    ),
  )
}
