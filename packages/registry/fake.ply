//! The registry's world as values, for its tests: the store a `MemFs`, the configuration a table,
//! and an archive sealed the way `ply build` seals one.

import compiler.store.plyx (Header, digest_of, digest_text, encode_named, library_domain,
                            library_magic, offset_digest)
import std.config
import std.config (config)
import std.fs
import std.fs (fs, MemFs)

pub type InMemoryRun<a> = { value: a, tree: fs::MemFs }

/// `body` run over `start`: what it returned, and the tree it left.
pub fn run_in_memory<a | e>(
  start: MemFs,
  body: () -> a / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store] | e},
) -> InMemoryRun<a> / {abort.raise | e} =
  handle {
    body()
  } with {
    var tree = start,
    fs.read_file[store](p) -> fs::mem_read(tree, p),
    fs.write_file[store](p, b) -> {
      let w = fs::mem_write(tree, p, b);
      tree = w.fs;
      w.ok
    },
    fs.create_dir[store](p) -> {
      let w = fs::mem_create_dir(tree, p);
      tree = w.fs;
      w.ok
    },
    fs.rename[store](from, to) -> {
      let w = fs::mem_rename(tree, from, to);
      tree = w.fs;
      w.ok
    },
    fs.lock[store](p) -> {
      let w = fs::mem_lock(tree, p);
      tree = w.fs;
      w.ok
    },
    fs.unlock[store](p) -> {
      let w = fs::mem_unlock(tree, p);
      tree = w.fs;
      w.ok
    },
    return value -> { value: value, tree: tree },
  }

/// `body` run with `tokens()` as the configuration its writes are authorised against.
pub fn with_tokens<a | e>(
  body: () -> a / {config.secret[tokens], config.get[server] | e},
) -> a / e = with_config([], body)

/// `body` run with `tokens()` as its tokens and `plain` as the rest of its configuration.
pub fn with_config<a | e>(
  plain: List<{ key: String, value: String }>,
  body: () -> a / {config.secret[tokens], config.get[server] | e},
) -> a / e =
  handle {
    body()
  } with {
    config.secret[tokens](k) -> config::get_secret(tokens(), k),
    config.get[server](k) -> config::get_value(config::values(plain, []), k),
  }

/// The configuration a test's registry runs under: `orders` published with `t0k`.
pub fn tokens() -> config::Values =
  config::values([], [{ key: "token.orders", value: "t0k" }, { key: "token.money", value: "m0n" }])

/// A manifest as `ply new --lib` would write it, at `0.<minor>.0`.
pub fn manifest(name: String, minor: Int, rest: String) -> Bytes =
  Bytes::of_string(
    "import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"" ++ name
      ++ "\", version: {major: 0, minor: "
      ++ minor.to_string()
      ++ ", patch: 0}, prefix: None, runtime: {major: 0, minor: 16, patch: 0}, "
      ++ rest
      ++ "}",
  )

pub fn library(name: String, minor: Int) -> Bytes =
  manifest(name, minor, "dependencies: [], entry: None")

fn empty_header() -> Header = { frontend: b"", runtime: b"", entry: b"" }

/// An archive holding `manifest` and one module, sealed as `ply build` seals a library.
pub fn archive(manifest: Bytes) -> Bytes / {abort.raise} = {
  let container = encode_named(library_magic(), empty_header(), [
    { name: b"sources", count: 1, payload: b"module core 24\npub fn one() -> Int = 1\n" },
    { name: b"manifest", count: 1, payload: manifest },
    { name: b"unit", count: 0, payload: b"" },
  ]);
  match digest_of(library_domain(), container) {
    None -> panic("the fake archive container is too short to compute its digest"),
    Some(d) ->
      Bytes::concat_all([
        container.slice(0, offset_digest()),
        d,
        container.slice(offset_digest() + 32, container.len()),
      ]),
  }
}
