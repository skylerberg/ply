import compiler.front.interface (envelope_of, enveloped)
import std.bin
import std.pkg (Attestation, attestation_bin)
import std.signed (decode_signed, trusted_signer)
import compiler.front.pkg (check_manifest)
import compiler.store.plyx (SectionLocation, decode_library, digest_of, digest_text, library_domain,
                            archive_digest)
import std.bytes
import std.config
import std.config (config)
import std.http
import std.http (Headers, header)
import std.pkg (Dependency, Manifest, Registry, Release, Version, parse_version, render_version)
import fake
import std.option
import std.string

fn fail<a>(status: Int, reason: String) -> Result<a, http::Error> =
  Err({ status: status, reason: reason })

pub fn token_key(name: String) -> String = "token." ++ name

pub fn bearer_token(headers: Headers) -> Option<String> / {abort.raise} =
  match header(headers, "authorization") {
    None -> None,
    Some(v) -> if v.starts_with("Bearer ") {
      let t = v.slice(7, v.len()).ascii_trim();
      if t == "" { None } else { Some(t) }
    } else { None },
  }

pub fn authorize(
  name: String,
  headers: Headers,
) -> Result<Unit, http::Error> / {config.secret[tokens], abort.raise} =
  match bearer_token(headers) {
    None ->
      fail(
        401,
        "publishing or yanking (withdrawing) a version requires `Authorization: Bearer <token>`",
      ),
    Some(presented) -> match config.secret[tokens](token_key(name)) {
      None -> fail(403, "no token may change `" ++ name ++ "` on this registry"),
      Some(stored) -> if stored.verify(presented) { Ok(()) }
      else { fail(403, "this token may not change `" ++ name ++ "`") },
    },
  }

pub fn validate_archive(
  name: String,
  version: Version,
  claimed: Option<String>,
  body: Bytes,
) -> Result<Release, http::Error> / {abort.raise} =
  match claimed {
    None -> fail(400, "a publish carries `X-Ply-Digest: b3:<hex>`, the digest of its body"),
    Some(claimed_digest) -> match decode_library(body) {
      Err(r) ->
        fail(422, "the body is not a library archive: " ++ String::of_bytes_lossy(r.message)),
      Ok(x) -> match digest_of(library_domain, body) {
        None -> fail(422, "the body is too short to be a library archive"),
        Some(d) -> if digest_text(d) != claimed_digest {
          fail(
            422,
            "the body's digest is " ++ digest_text(d) ++ ", and `X-Ply-Digest` says "
              ++ claimed_digest,
          )
        } else if x.digest != d {
          fail(422, "the archive's own digest field is not the digest of its bytes")
        } else {
          match manifest_of(body, x.sections) {
            None -> fail(422, "the archive holds no manifest"),
            Some(text) -> validate_manifest(name, version, digest_text(d), text),
          }
        },
      },
    },
  }

fn manifest_of(body: Bytes, sections: List<SectionLocation>) -> Option<Bytes> =
  sections.fold(None, |found: Option<Bytes>, p: SectionLocation|
    match found {
      Some(_) -> found,
      None -> if p.name == b"manifest" { body.slice_at(p.at, p.len) } else { None },
    })

fn validate_manifest(
  name: String,
  version: Version,
  digest: String,
  text: Bytes,
) -> Result<Release, http::Error> / {abort.raise} = {
  let c = check_manifest(text);
  match c.manifest {
    None -> fail(422, "the archive's manifest does not check"),
    Some(m) -> if c.diagnostics.len() > 0 { fail(422, "the archive's manifest does not check") }
    else if m.name != name || m.version != version {
      fail(
        422,
        "the archive holds `" ++ m.name ++ "` " ++ render_version(m.version)
          ++ ", and was sent as `"
          ++ name
          ++ "` "
          ++ render_version(version),
      )
    } else if m.entry != None {
      fail(
        422,
        "`" ++ name ++ "` has an entry point in its manifest, but only libraries can be published",
      )
    } else {
      match non_registry_dependency(m) {
        Some(d) ->
          fail(
            422,
            "the dependency `" ++ d.name
              ++ "` is not from the registry, and a published package can depend only on registry packages",
          ),
        None -> Ok({ version: version, digest: digest, yanked: false, runtime: m.runtime }),
      }
    },
  }
}

pub fn is_semantics(s: String) -> Bool =
  s.len() > 0 && s.len() <= 64
    && s.chars().fold(true, |ok: Bool, c: Char|
      ok && ((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))

pub fn validate_interface(
  semantics: String,
  archive: String,
  body: Bytes,
) -> Result<Unit, http::Error> / {abort.raise} =
  match envelope_of(body) {
    None -> fail(422, "the body is not an interface"),
    Some(e) -> if e.semantics != Bytes::of_string(semantics) {
      fail(
        422,
        "the interface was generated for semantics " ++ String::of_bytes_lossy(e.semantics)
          ++ ", but the upload is for semantics "
          ++ semantics,
      )
    } else if e.archive != Bytes::of_string(archive) {
      fail(
        422,
        "the interface was generated from the archive " ++ String::of_bytes_lossy(e.archive)
          ++ ", but the version's archive is "
          ++ archive,
      )
    } else { Ok(()) },
  }

pub fn validate_attestation(
  name: String,
  version: Version,
  semantics: String,
  archive: String,
  attester: Bytes,
  body: Bytes,
) -> Result<Unit, http::Error> / {abort.raise} =
  match decode_signed(body) {
    None -> fail(422, "the body is not a signed document"),
    Some(doc) -> match bin::decode(doc.payload, attestation_bin()) {
      Err(_) -> fail(422, "what the body signs is not an attestation"),
      Ok(a) -> if a.name != name || a.version != version {
        fail(422, "the attestation is of `" ++ a.name ++ "` " ++ render_version(a.version))
      } else if a.archive != archive {
        fail(422, "the attestation is of " ++ a.archive ++ ", and the version is " ++ archive)
      } else if a.semantics != semantics {
        fail(
          422,
          "the attestation is under the semantics " ++ a.semantics ++ ", and was sent as "
            ++ semantics,
        )
      } else if trusted_signer(doc, [attester]) == None {
        fail(403, "the attestation is not signed by this registry's attester")
      } else { Ok(()) },
    },
  }

fn non_registry_dependency(m: Manifest) -> Option<Dependency> =
  m.dependencies.fold(None, |found: Option<Dependency>, d: Dependency|
    match found { Some(_) -> found, None -> match d.source { Registry -> None, _ -> Some(d) } })

fn status_of<a>(r: Result<a, http::Error>) -> Int = match r { Ok(_) -> 0, Err(e) -> e.status }

fn reason_of<a>(r: Result<a, http::Error>) -> String = match r { Ok(_) -> "", Err(e) -> e.reason }

fn with_auth(value: String) -> Headers =
  http::set_header(http::empty_headers, "authorization", value)

test "a bearer token is the word after `Bearer` in the authorization header, and any other header gives no token" {
  assert_eq(bearer_token(with_auth("Bearer t0k")), Some("t0k"));
  assert_eq(bearer_token(with_auth("Bearer  t0k\t")), Some("t0k"));
  assert_eq(bearer_token(with_auth("Bearer t0k\u{a0}")), Some("t0k\u{a0}"));
  assert_eq(bearer_token(with_auth("Basic dDBr")), None);
  assert_eq(bearer_token(with_auth("Bearer ")), None);
  assert_eq(bearer_token(http::empty_headers), None)
}

test "a token authorizes only the exact package names it is listed for, and no others" {
  let status_for = |name: String, headers: Headers|
    handle {
      status_of(authorize(name, headers))
    } with {
      config.secret[tokens](k) -> config::get_secret(fake::tokens, k),
    };
  assert_eq(status_for("orders", with_auth("Bearer t0k")), 0);
  assert_eq(status_for("orders", http::empty_headers), 401);
  assert_eq(status_for("orders", with_auth("Bearer m0n")), 403);
  assert_eq(status_for("orders.extra", with_auth("Bearer t0k")), 403);
  assert_eq(status_for("billing", with_auth("Bearer t0k")), 403)
}

test "`validate_archive` accepts an archive that contains the named library and matches its digest, and rejects a missing or wrong digest" {
  let body = fake::archive(fake::library("orders", 2));
  match validate_archive(
      "orders",
      parse_version("0.2.0").expect("a fixture's version"),
      Some(archive_digest(body)),
      body,
    ) {
    Err(e) -> panic(e.reason),
    Ok(r) -> {
      assert_eq(r.digest, archive_digest(body));
      assert_eq(r.yanked, false);
      assert_eq(r.runtime, parse_version("0.16.0").expect("a fixture's version"))
    },
  };
  assert_eq(
    status_of(
      validate_archive("orders", parse_version("0.2.0").expect("a fixture's version"), None, body),
    ),
    400,
  );
  let lied = validate_archive(
    "orders",
    parse_version("0.2.0").expect("a fixture's version"),
    Some("b3:00"),
    body,
  );
  assert_eq(status_of(lied), 422);
  assert(reason_of(lied).contains("`X-Ply-Digest` says b3:00"));
  assert_eq(
    status_of(
      validate_archive(
        "orders",
        parse_version("0.2.0").expect("a fixture's version"),
        Some("b3:00"),
        b"not an archive",
      ),
    ),
    422,
  )
}

test "an archive of another package, another version or a program is rejected" {
  let other = fake::archive(fake::library("billing", 2));
  let named = validate_archive(
    "orders",
    parse_version("0.2.0").expect("a fixture's version"),
    Some(archive_digest(other)),
    other,
  );
  assert_eq(status_of(named), 422);
  assert(reason_of(named).contains("holds `billing` 0.2.0"));
  let older = fake::archive(fake::library("orders", 1));
  assert_eq(
    status_of(
      validate_archive(
        "orders",
        parse_version("0.2.0").expect("a fixture's version"),
        Some(archive_digest(older)),
        older,
      ),
    ),
    422,
  );
  let program = fake::archive(
    fake::manifest("orders", 2, "dependencies: [], entry: Some(\"app.serve\")"),
  );
  let entry = validate_archive(
    "orders",
    parse_version("0.2.0").expect("a fixture's version"),
    Some(archive_digest(program)),
    program,
  );
  assert_eq(status_of(entry), 422);
  assert(reason_of(entry).contains("only libraries can be published"));
  let pathed = fake::archive(
    fake::manifest(
      "orders",
      2,
      "dependencies: [{name: \"lib\", prefix: None, min: {major: 0, minor: 1, patch: 0}, source: Path(\"../lib\")}], entry: None",
    ),
  );
  let dependency = validate_archive(
    "orders",
    parse_version("0.2.0").expect("a fixture's version"),
    Some(archive_digest(pathed)),
    pathed,
  );
  assert_eq(status_of(dependency), 422);
  assert(reason_of(dependency).contains("`lib` is not from the registry"))
}

test "`validate_interface` accepts an interface only when its wrapper names the language-rules hash from the request path and the version's archive digest" {
  let framed = |semantics: Bytes, archive: Bytes|
    enveloped({ semantics: semantics, archive: archive, payload: b"package" });
  assert_eq(status_of(validate_interface("ab12", "b3:77", framed(b"ab12", b"b3:77"))), 0);
  assert_eq(status_of(validate_interface("ab12", "b3:77", b"not framed")), 422);
  let other = validate_interface("ab12", "b3:77", framed(b"cd34", b"b3:77"));
  assert(reason_of(other).contains("generated for semantics cd34"));
  let non_registry_dependency = validate_interface("ab12", "b3:77", framed(b"ab12", b"b3:88"));
  assert(reason_of(non_registry_dependency).contains("generated from the archive b3:88"));
  assert(is_semantics("0123456789abcdef"));
  assert(!is_semantics(".."));
  assert(!is_semantics(""));
  assert(!is_semantics("ABCD"))
}

test "an archive whose own digest field lies is rejected though its bytes hash as claimed" {
  let body = fake::archive(fake::library("orders", 2));
  let at = 148;
  let forged = Bytes::concat_all([
    body.slice(0, at),
    byte_of_int((body.at(at) + 1) % 256),
    body.slice(at + 1, body.len()),
  ]);
  let r = validate_archive(
    "orders",
    parse_version("0.2.0").expect("a fixture's version"),
    Some(archive_digest(forged)),
    forged,
  );
  assert_eq(status_of(r), 422);
  assert(reason_of(r).contains("own digest field"))
}
