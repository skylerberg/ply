import compiler.front.interface (enveloped)
import std.bin
import std.bytes
import std.ed25519
import std.pkg (Attestation, attestation_bin, release_at)
import std.signed (countersigned, encode_signed)
import compiler.front.pkg (is_dotted_path)
import std.config (config)
import std.process (process, Discard, EnvironmentVariable)
import std.fs
import std.fs (fs)
import std.http
import std.http (Delete, Get, Limits, Post, Put, Request, Response, default_limits,
                 method_not_allowed, request_to, set_header, text_response)
import std.net (net)
import std.json (decode_bytes)
import std.pkg (Index, Release, Version, index_json, parse_version, render_version)
import std.router
import std.router (Found, Literal, MethodNotAllowed, NotFound, Param, Route, param)
import std.list
import store (Absent, Busy, Exists, Pending, StoreError, Unreadable, WriteFailed, archive_path,
              save_attestation, attestation_path, digest_path, read_index, index_path,
              interface_path, save_interface, mark_pending, pending, save_release, served_file,
              unmark_pending, yank)
import fake
import upload (authorize, is_semantics, validate_archive, validate_attestation, validate_interface)
import compiler.store.plyx (archive_digest)

type Endpoint =
  | GetIndex
  | GetArchive
  | GetDigest
  | GetInterface
  | GetAttestation
  | Publish
  | PutInterface
  | PutAttestation
  | Yank

const routes: List<Route<Endpoint>> =
  [
    { method: Get, path: [Param("name"), Literal("index.json")], endpoint: GetIndex },
    {
      method: Get,
      path: [Param("name"), Param("version"), Literal("package.plyz")],
      endpoint: GetArchive,
    },
    {
      method: Get,
      path: [Param("name"), Param("version"), Literal("package.plyz.b3")],
      endpoint: GetDigest,
    },
    {
      method: Get,
      path: [Param("name"), Param("version"), Literal("interface"), Param("semantics")],
      endpoint: GetInterface,
    },
    {
      method: Get,
      path: [Param("name"), Param("version"), Literal("attestation"), Param("semantics")],
      endpoint: GetAttestation,
    },
    {
      method: Put,
      path: [Param("name"), Param("version"), Literal("attestation"), Param("semantics")],
      endpoint: PutAttestation,
    },
    { method: Put, path: [Param("name"), Param("version")], endpoint: Publish },
    {
      method: Put,
      path: [Param("name"), Param("version"), Literal("interface"), Param("semantics")],
      endpoint: PutInterface,
    },
    { method: Post, path: [Param("name"), Param("version"), Literal("yank")], endpoint: Yank },
  ]

pub fn handle_request<| e>(
  request: Request,
) -> Response<| e> / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.secret[tokens], config.get[server], http::Reading} =
  match router::route(routes, request.method, request.path) {
    NotFound -> text_response(404, "no such resource\n"),
    MethodNotAllowed(ms) -> method_not_allowed(ms),
    Found(hit) -> {
      let name = match param(hit.params, "name") { Some(n) -> n, None -> "" };
      let version = match param(hit.params, "version") {
        Some(v) -> parse_version(v),
        None -> None,
      };
      let semantics = match param(hit.params, "semantics") { Some(x) -> x, None -> "" };
      if !is_dotted_path(name) { text_response(404, "`" ++ name ++ "` is not a package name\n") }
      else if (hit.endpoint == GetInterface || hit.endpoint == PutInterface)
          && !is_semantics(semantics) {
        text_response(404, "`" ++ semantics ++ "` is not a semantics version\n")
      } else {
        match hit.endpoint {
          GetIndex -> file_response(served_file(index_path(name)), "application/json"),
          GetArchive -> match version {
            None -> not_a_version(),
            Some(v) ->
              file_response(
                served_file(archive_path(name, render_version(v))),
                "application/octet-stream",
              ),
          },
          GetDigest -> match version {
            None -> not_a_version(),
            Some(v) ->
              file_response(
                served_file(digest_path(name, render_version(v))),
                "text/plain; charset=utf-8",
              ),
          },
          GetInterface -> match version {
            None -> not_a_version(),
            Some(v) ->
              file_response(
                served_file(interface_path(name, render_version(v), semantics)),
                "application/octet-stream",
              ),
          },
          GetAttestation -> match version {
            None -> not_a_version(),
            Some(v) ->
              file_response(
                served_file(attestation_path(name, render_version(v), semantics)),
                "application/octet-stream",
              ),
          },
          PutAttestation -> match version {
            None -> not_a_version(),
            Some(v) -> put_attestation(request, name, v, semantics),
          },
          Publish -> match version {
            None -> not_a_version(),
            Some(v) -> publish(request, name, v),
          },
          PutInterface -> match version {
            None -> not_a_version(),
            Some(v) -> put_interface(request, name, v, semantics),
          },
          Yank -> match version {
            None -> not_a_version(),
            Some(v) -> yank_version(request, name, v),
          },
        }
      }
    },
  }

fn not_a_version<| e>() -> Response<| e> =
  text_response(404, "that is not a version such as `0.1.0`\n")

fn file_response<| e>(body: Option<Bytes>, kind: String) -> Response<| e> =
  match body {
    None -> text_response(404, "no such resource\n"),
    Some(b) ->
      {
        status: 200,
        headers: set_header(http::empty_headers, "content-type", kind),
        body: http::Whole(b),
      },
  }

fn upload_error_response<| e>(r: http::Error) -> Response<| e> = {
  let base = http::error_response(r);
  if r.status == 401 { { ..base, headers: set_header(base.headers, "www-authenticate", "Bearer") } }
  else { base }
}

fn store_error_response<| e>(t: StoreError, name: String, version: Version) -> Response<| e> =
  match t {
    Busy -> text_response(503, "another write to `" ++ name ++ "` holds its lock; try again\n"),
    Unreadable(reason) -> text_response(500, reason ++ "\n"),
    WriteFailed(path) -> text_response(500, "`" ++ path ++ "` could not be written\n"),
    Exists ->
      text_response(
        409,
        "`" ++ name ++ "` " ++ render_version(version)
          ++ " is already published, and a published version never changes\n",
      ),
    Absent ->
      text_response(404, "`" ++ name ++ "` " ++ render_version(version) ++ " is not published\n"),
  }

fn publish<| e>(
  request: Request,
  name: String,
  version: Version,
) -> Response<| e> / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.secret[tokens], config.get[server], http::Reading} =
  match authorize(name, request.headers) {
    Err(r) -> upload_error_response(r),
    Ok(_) -> {
      let body = http::request_body(request, limits.max_body);
      match validate_archive(name, version, http::header(request.headers, "x-ply-digest"), body) {
        Err(r) -> upload_error_response(r),
        Ok(release) -> match save_release(name, release, body) {
          Err(t) -> store_error_response(t, name, version),
          Ok(saved) -> if saved.fresh {
            let _ = config.get[server]("attest.key") != None
              && mark_pending(name, render_version(version));
            text_response(
              201,
              "published `" ++ name ++ "` " ++ render_version(version) ++ " as " ++ release.digest
                ++ "\n",
            )
          } else {
            text_response(
              200,
              "`" ++ name ++ "` " ++ render_version(version) ++ " is already published as "
                ++ release.digest
                ++ "\n",
            )
          },
        },
      }
    },
  }

fn put_interface<| e>(
  request: Request,
  name: String,
  version: Version,
  semantics: String,
) -> Response<| e> / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.secret[tokens], http::Reading} =
  match authorize(name, request.headers) {
    Err(r) -> upload_error_response(r),
    Ok(_) -> match read_index(name) {
      Err(reason) -> text_response(500, reason ++ "\n"),
      Ok(None) -> store_error_response(Absent, name, version),
      Ok(Some(x)) -> match release_at(x, version) {
        None -> store_error_response(Absent, name, version),
        Some(r) -> {
          let body = http::request_body(request, limits.max_body);
          match validate_interface(semantics, r.digest, body) {
            Err(e) -> upload_error_response(e),
            Ok(_) -> match save_interface(name, version, semantics, body) {
              Err(Exists) ->
                text_response(
                  409,
                  "`" ++ name ++ "` " ++ render_version(version)
                    ++ " already has another interface under "
                    ++ semantics
                    ++ ", and an interface is what its archive and semantics make\n",
                ),
              Err(t) -> store_error_response(t, name, version),
              Ok(fresh) ->
                text_response(
                  if fresh { 201 } else { 200 },
                  "the interface of `" ++ name ++ "` " ++ render_version(version)
                    ++ " for semantics "
                    ++ semantics
                    ++ (if fresh { " is stored" } else { " is already stored" })
                    ++ "\n",
                ),
            },
          }
        },
      },
    },
  }

fn put_attestation<| e>(
  request: Request,
  name: String,
  version: Version,
  semantics: String,
) -> Response<| e> / {config.get[server], fs.read_file[store], fs.create_dir[store], fs.lock[store], fs.rename[store], fs.unlock[store], fs.write_file[store], http::Reading} =
  match config.get[server]("attester") {
    None -> text_response(403, "this registry keeps no attestations: it names no `attester`\n"),
    Some(hex) -> match read_index(name) {
      Err(reason) -> text_response(500, reason ++ "\n"),
      Ok(None) -> store_error_response(Absent, name, version),
      Ok(Some(x)) -> match release_at(x, version) {
        None -> store_error_response(Absent, name, version),
        Some(r) -> {
          let body = http::request_body(request, limits.max_body);
          match validate_attestation(name, version, semantics, r.digest, Bytes::of_hex(hex), body) {
            Err(e) -> upload_error_response(e),
            Ok(_) -> match save_attestation(name, version, semantics, body) {
              Err(t) -> store_error_response(t, name, version),
              Ok(_) ->
                text_response(
                  201,
                  "the attestation of `" ++ name ++ "` " ++ render_version(version) ++ " under "
                    ++ semantics
                    ++ " is kept\n",
                ),
            },
          }
        },
      },
    },
  }

fn yank_version<| e>(
  request: Request,
  name: String,
  version: Version,
) -> Response<| e> / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.secret[tokens], abort.raise} =
  match authorize(name, request.headers) {
    Err(r) -> upload_error_response(r),
    Ok(_) -> match yank(name, version) {
      Err(t) -> store_error_response(t, name, version),
      Ok(_) -> text_response(200, "yanked `" ++ name ++ "` " ++ render_version(version) ++ "\n"),
    },
  }

const limits: Limits = {
  let base = default_limits;
  { ..base, max_body: 67108864 }
}

fn port() -> Int / {config.get[server], abort.raise} =
  match config.get[server]("port") {
    None -> 8080,
    Some(text) -> match router::int_of_text(text) {
      Some(n) -> n,
      None -> panic("the registry will not start: `port` is `" ++ text ++ "`, which is not a port"),
    },
  }

fn serve(
  listener: Int,
  running: Option<Int>,
) -> Unit / {config.get[server], config.secret[tokens], fs.read_file[store], fs.create_dir[store], fs.lock[store], fs.rename[store], fs.unlock[store], fs.write_file[store], net.close[conn], net.peer_address[conn], net.peer_certificate[conn], net.recv[conn], net.send[conn], net.accept[listener], process.wait[attest], fs.list_dir[store], fs.remove[store], process.bound[attest], process.start[attest], config.get[env], abort.raise, diverges} = {
  let c = net.accept[listener](listener);
  if c == 0 { () } else {
    http::serve_connection[conn](c, limits, handle_request);
    serve(listener, poll_attester(running))
  }
}

const inherited_variables: List<String> = ["PATH", "HOME", "TMPDIR"]

fn attester_env(url: String) -> List<EnvironmentVariable> / {config.get[env]} =
  inherited_variables.fold(
    [{ name: "PLY_REGISTRY", value: url }],
    |accumulator: List<EnvironmentVariable>, name: String|
      match config.get[env](name) {
        Some(v) -> accumulator.push({ name: name, value: v }),
        None -> accumulator,
      },
  )

fn poll_attester(
  running: Option<Int>,
) -> Option<Int> / {config.get[server], process.wait[attest], fs.list_dir[store], fs.remove[store], process.bound[attest], process.start[attest], config.get[env]} =
  match running {
    Some(child) -> match process.wait[attest](child, 0) {
      None -> running,
      Some(_) -> start_attester(),
    },
    None -> start_attester(),
  }

fn start_attester() -> Option<Int> / {config.get[server], fs.list_dir[store], fs.remove[store], process.bound[attest], process.start[attest], config.get[env]} =
  match ((config.get[server]("attest.key"), config.get[server]("url"))) {
    (Some(key), Some(url)) -> if !process.bound[attest]() { None } else {
      match pending() {
        [] -> None,
        [p, ..] -> {
          unmark_pending(p);
          match process.start[attest](
              ["attest", p.name, p.version, "--sign", key, "--json"],
              "",
              attester_env(url),
              { input: false, out: Discard, err: Discard },
            ) {
            Ok(child) -> Some(child),
            Err(_) -> None,
          }
        },
      }
    },
    _ -> None,
  }

fn main() -> Unit / {config.get[server], config.secret[tokens], net.listen[listener], net.listen_tls[listener], net.accept[listener], net.close[listener], net.peer_address[conn], net.peer_certificate[conn], net.recv[conn], net.send[conn], net.close[conn], fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.get[env], fs.list_dir[store], fs.remove[store], process.bound[attest], process.start[attest], process.wait[attest], abort.raise, diverges} = {
  let listener = match config.get[server]("tls") {
    None -> net.listen[listener](port()),
    Some(credential) -> net.listen_tls[listener](port(), credential),
  };
  serve(listener, None);
  net.close[listener](listener)
}

fn get(target: String) -> Request / {abort.raise} = request_to(Get, "registry.test", target, b"")

fn write_request(
  method: http::Method,
  target: String,
  token: String,
  digest: String,
  body: Bytes,
) -> Request / {abort.raise} = {
  let request = request_to(method, "registry.test", target, body);
  let authed = if token == "" { request.headers }
  else { set_header(request.headers, "authorization", "Bearer " ++ token) };
  {
    ..request,
    headers: if digest == "" { authed } else { set_header(authed, "x-ply-digest", digest) },
  }
}

type WholeResponse = { status: Int, headers: http::Headers, body: Bytes }

fn whole_response(
  request: Request,
) -> WholeResponse / {fs.read_file[store], fs.write_file[store], fs.create_dir[store], fs.rename[store], fs.lock[store], fs.unlock[store], config.secret[tokens], config.get[server], abort.raise} =
  match http::read_whole(http::empty_headers, || handle_request(request)) {
    Ok(r) -> { status: r.status, headers: r.headers, body: http::whole_bytes(r.body) },
    Err(e) -> { status: e.status, headers: http::empty_headers, body: Bytes::of_string(e.reason) },
  }

fn statuses(rs: List<WholeResponse>) -> List<Int> = rs.map(|r: WholeResponse| r.status)

fn decode_index(r: WholeResponse) -> Index / {abort.raise} =
  match decode_bytes(r.body, index_json()) {
    Ok(x) -> x,
    Err(_) -> panic("the index cannot be decoded"),
  }

test "a published version appears in the package index and can be downloaded with its digest, and publishing the same bytes again succeeds" {
  let body = fake::archive(fake::library("orders", 2));
  let d = archive_digest(body);
  let run = fake::run_in_memory(fs::mem_empty(), ||
    fake::with_tokens(||
      [
        whole_response(write_request(Put, "/orders/0.2.0", "t0k", d, body)),
        whole_response(get("/orders/index.json")),
        whole_response(get("/orders/0.2.0/package.plyz")),
        whole_response(get("/orders/0.2.0/package.plyz.b3")),
        whole_response(write_request(Put, "/orders/0.2.0", "t0k", d, body)),
      ]));
  assert_eq(statuses(run.value), [201, 200, 200, 200, 200]);
  let listed = decode_index(run.value.get(1));
  assert_eq(listed.name, "orders");
  assert_eq(listed.versions.map(|release: Release| release.digest), [d]);
  assert_eq(run.value.get(2).body, body);
  assert_eq(run.value.get(3).body, Bytes::of_string(d ++ "\n"));
  assert_eq(http::header(run.value.get(1).headers, "content-type"), Some("application/json"))
}

test "the registry saves an interface for a published version under a hash of the language rules it was built with, and returns it on request" {
  let body = fake::archive(fake::library("orders", 2));
  let d = archive_digest(body);
  let framed = |payload: Bytes|
    enveloped({ semantics: b"ab12", archive: Bytes::of_string(d), payload: payload });
  let run = fake::run_in_memory(fs::mem_empty(), ||
    fake::with_tokens(||
      [
        whole_response(
          write_request(Put, "/orders/0.2.0/interface/ab12", "t0k", d, framed(b"one")),
        ),
        whole_response(write_request(Put, "/orders/0.2.0", "t0k", d, body)),
        whole_response(write_request(Put, "/orders/0.2.0/interface/ab12", "", d, framed(b"one"))),
        whole_response(
          write_request(Put, "/orders/0.2.0/interface/ab12", "t0k", d, framed(b"one")),
        ),
        whole_response(get("/orders/0.2.0/interface/ab12")),
        whole_response(
          write_request(Put, "/orders/0.2.0/interface/ab12", "t0k", d, framed(b"one")),
        ),
        whole_response(
          write_request(Put, "/orders/0.2.0/interface/ab12", "t0k", d, framed(b"two")),
        ),
        whole_response(
          write_request(Put, "/orders/0.2.0/interface/cd34", "t0k", d, framed(b"one")),
        ),
        whole_response(get("/orders/0.2.0/interface/..")),
        whole_response(get("/orders/0.2.0/interface/cd34")),
      ]));
  assert_eq(statuses(run.value), [404, 201, 401, 201, 200, 200, 409, 422, 404, 404]);
  assert_eq(run.value.get(4).body, framed(b"one"))
}

fn a_seed(n: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(range(0, 32).map(|i: Int| byte_of_int((i + n) % 256)))

fn an_attestation(digest: String) -> Attestation =
  {
    name: "orders",
    version: { major: 0, minor: 2, patch: 0 },
    archive: digest,
    semantics: "ab12",
    builder: "ply 0.0.0",
    checked: true,
    contracts_hold: true,
    tests: { passed: 1, failed: 0 },
    proofs: { proved: 0, refuted: 0, unproved: 0 },
  }

fn signed_attestation_bytes(seed: Bytes, a: Attestation) -> Bytes / {abort.raise} =
  encode_signed(
    countersigned(
      { payload: bin::encode(a, attestation_bin()), signatures: [] },
      Secret::of_bytes(seed),
    ),
  )

test "the registry stores an attestation signed by its configured attester, and a publish needs one" {
  let body = fake::archive(fake::library("orders", 2));
  let d = archive_digest(body);
  let attester = ed25519::public_key(Secret::of_bytes(a_seed(1))).hex_of();
  let run = fake::run_in_memory(fs::mem_empty(), ||
    fake::with_config(
      [{ key: "attester", value: attester }, { key: "attest.key", value: "attester.key" }],
      ||
        [
          whole_response(write_request(Put, "/orders/0.2.0", "t0k", d, body)),
          whole_response(
            write_request(
              Put,
              "/orders/0.2.0/attestation/ab12",
              "",
              d,
              signed_attestation_bytes(a_seed(2), an_attestation(d)),
            ),
          ),
          whole_response(
            write_request(
              Put,
              "/orders/0.2.0/attestation/ab12",
              "",
              d,
              signed_attestation_bytes(a_seed(1), an_attestation("b3:other")),
            ),
          ),
          whole_response(
            write_request(
              Put,
              "/orders/0.2.0/attestation/ab12",
              "",
              d,
              signed_attestation_bytes(a_seed(1), an_attestation(d)),
            ),
          ),
          whole_response(get("/orders/0.2.0/attestation/ab12")),
        ],
    ));
  assert_eq(statuses(run.value), [201, 403, 422, 201, 200]);
  assert_eq(run.value.get(4).body, signed_attestation_bytes(a_seed(1), an_attestation(d)));
  assert_eq(fs::mem_read(run.tree, ".attest/orders@0.2.0"), Some(b""));
  let bare = fake::run_in_memory(fs::mem_empty(), ||
    fake::with_tokens(||
      [
        whole_response(write_request(Put, "/orders/0.2.0", "t0k", d, body)),
        whole_response(
          write_request(
            Put,
            "/orders/0.2.0/attestation/ab12",
            "",
            d,
            signed_attestation_bytes(a_seed(1), an_attestation(d)),
          ),
        ),
      ]));
  assert_eq(statuses(bare.value), [201, 403]);
  assert_eq(fs::mem_read(bare.tree, ".attest/orders@0.2.0"), None)
}

test "a write with no token, another package's token, a wrong digest or a mismatched archive is rejected and stores nothing" {
  let body = fake::archive(fake::library("orders", 2));
  let d = archive_digest(body);
  let run = fake::run_in_memory(fs::mem_empty(), ||
    fake::with_tokens(||
      [
        whole_response(write_request(Put, "/orders/0.2.0", "", d, body)),
        whole_response(write_request(Put, "/orders/0.2.0", "m0n", d, body)),
        whole_response(write_request(Put, "/orders/0.2.0", "t0k", "b3:00", body)),
        whole_response(write_request(Put, "/orders/0.2.0", "t0k", "", body)),
        whole_response(write_request(Put, "/orders/0.3.0", "t0k", d, body)),
      ]));
  assert_eq(statuses(run.value), [401, 403, 422, 400, 422]);
  assert_eq(http::header(run.value.get(0).headers, "www-authenticate"), Some("Bearer"));
  assert_eq(fs::mem_read(run.tree, "orders/index.json"), None)
}

test "a yank with the package's token marks the version as yanked in the index, and its archive can still be downloaded" {
  let body = fake::archive(fake::library("orders", 2));
  let run = fake::run_in_memory(fs::mem_empty(), ||
    fake::with_tokens(||
      [
        whole_response(write_request(Put, "/orders/0.2.0", "t0k", archive_digest(body), body)),
        whole_response(write_request(Post, "/orders/0.2.0/yank", "m0n", "", b"")),
        whole_response(write_request(Post, "/orders/0.2.0/yank", "t0k", "", b"")),
        whole_response(write_request(Post, "/orders/0.9.0/yank", "t0k", "", b"")),
        whole_response(get("/orders/index.json")),
        whole_response(get("/orders/0.2.0/package.plyz")),
      ]));
  assert_eq(statuses(run.value), [201, 403, 200, 404, 200, 200]);
  assert_eq(decode_index(run.value.get(4)).versions.map(|release: Release| release.yanked), [true]);
  assert_eq(run.value.get(5).body, body)
}

test "a path the registry does not serve returns 404, and a method it does not support returns 405" {
  let run = fake::run_in_memory(fs::mem_empty(), ||
    fake::with_tokens(||
      [
        whole_response(get("/orders/index.json")),
        whole_response(get("/orders")),
        whole_response(get("/Orders/index.json")),
        whole_response(get("/orders/latest/package.plyz")),
        whole_response(write_request(Delete, "/orders/0.2.0", "t0k", "", b"")),
      ]));
  assert_eq(statuses(run.value), [404, 404, 404, 404, 405])
}
