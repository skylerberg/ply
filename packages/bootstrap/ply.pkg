import std.pkg (Manifest)

// Bootstrap: what builds a new `ply` from a checkout. It runs inside the running `ply`, on that
// `ply`'s runtime, so the checkout's compiler writes `ply`'s C for the checkout's runtime and no C of
// one version meets the Rust of another. `scripts/bootstrap-with.sh` is how it is started.
fn package() -> Manifest = {
  name: "bootstrap",
  version: { major: 0, minor: 1, patch: 0 },
  prefix: None,
  runtime: { major: 0, minor: 16, patch: 0 },
  dependencies: [],
  entry: Some("bootstrap.main"),
}
