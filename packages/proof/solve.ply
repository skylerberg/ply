//! `solve` — the decision procedure: case analysis over a saturating congruence closure, with linear
//! integer arithmetic at every leaf.

import linear_arithmetic (Inequality, Feasibility, Infeasible, Undecided, add_inequality,
                          add_equality, feasibility, nonzero)
import context (Context, Ctor, variants)
import domain (Sort, NamedSort, RecordSort, Decl, Variant)
import union_find (Classes, TermPair, UnionResult, classes, grow, find, union, equal, distinguish,
                   has_disequality, check_disequalities, groups, Shape, shape_of, conflict)
import lower (field_sorts)
import rules (RuleLog, Rule, record_rule, Propositional, CaseSplit, Congruence, Injectivity,
              LinearArithmetic)
import sort (is_named_sort, list_elem, field_names, int_sort)
import term (Terms, InternedTerm, Node, IntTerm, BoolTerm, LinearSumTerm, ApplicationTerm,
             ConstructorTerm, NilTerm, ConsTerm, RecordTerm, FieldTerm, NotTerm, AndTerm, OrTerm,
             CompareTerm, EqualTerm, EqualAtTerm, IfTerm, MatchTerm, OpaqueTerm, FloatTerm,
             DecimalTerm, LinearSum, Monomial, CmpOp, Lt, Le, Gt, Ge, Arm, ArmTest, Always,
             TestCtor, TestLit, TestList, Undecidable, true_id, false_id, size, node, sort_of,
             is_int, intern, sym, nil, cons, int_lit, add, app, cmp, float_nan, float_rank,
             decimal_normalized, op_float_nan, op_float_rank, op_decimal_normalized)

pub type Verdict = | Closed | Open | Exhausted

pub type Solver = { terms: Terms, rules: RuleLog, budget: Int, split_depth: Int, cx: Context }

/// One branch of the search: its classes, the `Int` orderings its disequality splits chose, and the
/// disequalities it has split on.
type Branch = { cs: Classes, int_less_than: List<TermPair>, split: Map<TermPair, Bool> }

type Split =
  | SplitBool(Int)
  | SplitCtor({ scrutinee: Int, type_name: String, ctors: List<{ name: String, fields: List<Option<Sort>> }> })
  | SplitLit(Int, Int)
  | SplitDisequality(Int, Int)
  | SplitList(Int)

/// A solver after a search, and what the search came to.
pub type SearchResult = { solver: Solver, result: Verdict }

fn charge_step(solver: Solver) -> Option<Solver> = charge_steps(solver, 1)

fn charge_steps(solver: Solver, steps: Int) -> Option<Solver> =
  if solver.budget >= steps { Some({ ..solver, budget: solver.budget - steps }) } else { None }

/// A round of saturation walks every term, so it costs a step for each thousand of them: a budget
/// bounds the work a claim takes, whatever its reading made.
fn round_cost(solver: Solver) -> Int = 1 + size(solver.terms) / 1000

fn exhaust_budget(solver: Solver) -> Solver = { ..solver, budget: 0 }

fn with_rule(solver: Solver, r: Rule) -> Solver = { ..solver, rules: record_rule(solver.rules, r) }

/// `Closed` iff the assertions contradict each other.
pub fn refute(
  solver: Solver,
  assertions: List<{ term: Int, polarity: Bool }>,
) -> SearchResult / {abort.raise} = {
  let start = assertions.fold(
    classes(size(solver.terms)),
    |cs: Classes, a: { term: Int, polarity: Bool }|
      union(cs, a.term, if a.polarity { true_id() } else { false_id() }).cs,
  );
  explore(solver, { cs: start, int_less_than: [], split: Map::new() }, solver.split_depth)
}

/// `room` is how many splits deeper the search may go.
fn explore(solver: Solver, branch: Branch, room: Int) -> SearchResult / {abort.raise} = {
  let sat = saturate(solver, branch, solver.budget + 1);
  match sat.result {
    Closed -> { solver: sat.solver, result: Closed },
    Exhausted -> { solver: sat.solver, result: Exhausted },
    Open -> match choose_split(sat.solver, sat.b) {
      None -> { solver: sat.solver, result: Open },
      Some(split) -> if room <= 0 { { solver: sat.solver, result: Exhausted } } else {
        match charge_step(sat.solver) {
          None -> { solver: exhaust_budget(sat.solver), result: Exhausted },
          Some(sv2) -> branch_on(sv2, split, sat.b, room - 1),
        }
      },
    },
  }
}

fn branch_on(
  solver: Solver,
  split: Split,
  branch: Branch,
  room: Int,
) -> SearchResult / {abort.raise} = {
  let join_new_term = children(solver, split, branch);
  let walked = join_new_term.children.fold(
    { solver: join_new_term.solver, exhausted: false, open: false },
    |st: { solver: Solver, exhausted: Bool, open: Bool }, child: Branch|
      if st.open { st } else {
        let r = explore(st.solver, child, room);
        match r.result {
          Open -> { solver: r.solver, exhausted: st.exhausted, open: true },
          Exhausted -> { solver: r.solver, exhausted: true, open: false },
          Closed -> { solver: r.solver, exhausted: st.exhausted, open: false },
        }
      },
  );
  {
    solver: walked.solver,
    result: if walked.open { Open } else if walked.exhausted { Exhausted } else { Closed },
  }
}

fn joined(branch: Branch, x: Int, y: Int) -> Branch = { ..branch, cs: union(branch.cs, x, y).cs }

fn children(
  solver: Solver,
  split: Split,
  branch: Branch,
) -> { solver: Solver, children: List<Branch> } / {abort.raise} =
  match split {
    SplitBool(t) ->
      {
        solver: with_rule(solver, Propositional),
        children: [joined(branch, t, true_id()), joined(branch, t, false_id())],
      },
    SplitCtor(c) -> {
      let sv1 = with_rule(solver, CaseSplit({ ty: c.type_name, arms: c.ctors.len() }));
      c.ctors.fold(
        { solver: sv1, children: [] },
        |acc: { solver: Solver, children: List<Branch> }, k: { name: String, fields: List<Option<Sort>> }| {
          let args = k.fields.fold(
            { terms: acc.solver.terms, ids: [] },
            |a: { terms: Terms, ids: List<Int> }, s: Option<Sort>| {
              let m = sym(a.terms, s);
              { terms: m.terms, ids: a.ids.push(m.id) }
            },
          );
          let applied = intern(
            args.terms,
            ConstructorTerm({ name: k.name, args: args.ids }),
            sort_of(args.terms, c.scrutinee),
          );
          let child = joined(
            { ..branch, cs: grow(branch.cs, size(applied.terms)) },
            c.scrutinee,
            applied.id,
          );
          { solver: { ..acc.solver, terms: applied.terms }, children: acc.children.push(child) }
        },
      )
    },
    SplitList(s) -> {
      let sv1 = with_rule(solver, CaseSplit({ ty: "List", arms: 2 }));
      let sort = sort_of(sv1.terms, s);
      let elem = match sort { Some(t) -> list_elem(t), None -> None };
      let empty = nil(sv1.terms, sort);
      let head = sym(empty.terms, elem);
      let tail = sym(head.terms, sort);
      let pair = cons(tail.terms, head.id, tail.id, sort);
      {
        solver: { ..sv1, terms: pair.terms },
        children: [empty.id, pair.id].map(|applied: Int|
          joined({ ..branch, cs: grow(branch.cs, size(pair.terms)) }, s, applied)),
      }
    },
    SplitLit(s, lit) ->
      {
        solver: with_rule(solver, Propositional),
        children: [joined(branch, s, lit), { ..branch, cs: distinguish(branch.cs, s, lit) }],
      },
    SplitDisequality(x, y) -> {
      let key = { a: if x < y { x } else { y }, b: if x < y { y } else { x } };
      {
        solver: with_rule(solver, LinearArithmetic),
        children: [{ a: x, b: y }, { a: y, b: x }].map(|lohi: TermPair|
          {
            ..branch,
            split: branch.split.insert(key, true),
            int_less_than: branch.int_less_than.push(lohi),
          }),
      }
    },
  }

type SaturationResult = { solver: Solver, b: Branch, result: Verdict }

/// Each round charges the budget, so it bounds the rounds: `left`.
fn saturate(solver: Solver, branch: Branch, left: Int) -> SaturationResult / {abort.raise} =
  if left <= 0 { { solver: exhaust_budget(solver), b: branch, result: Exhausted } } else {
    match charge_steps(solver, round_cost(solver)) {
      None -> { solver: exhaust_budget(solver), b: branch, result: Exhausted },
      Some(sv1) -> {
        let grown = { ..branch, cs: grow(branch.cs, size(sv1.terms)) };
        let c = congruence(sv1, grown);
        if c.b.cs.contradiction { { solver: c.solver, b: c.b, result: Closed } } else {
          let p = propagate(c.solver, c.b);
          let checked = { ..p.b, cs: check_disequalities(p.b.cs) };
          if checked.cs.contradiction {
            { solver: with_rule(p.solver, Congruence), b: checked, result: Closed }
          } else if c.changed || p.changed { saturate(p.solver, checked, left - 1) } else {
            let a = arithmetic(p.solver, checked);
            match a.result {
              Infeasible ->
                { solver: with_rule(a.solver, LinearArithmetic), b: checked, result: Closed },
              Undecided ->
                {
                  solver: a.solver,
                  b: checked,
                  result: if a.solver.budget == 0 { Exhausted } else { Open },
                },
            }
          }
        }
      },
    }
  }

type StepResult = { solver: Solver, b: Branch, changed: Bool }

/// Merges terms whose arguments are already equal, then applies the constructor rules.
fn congruence(solver: Solver, branch: Branch) -> StepResult / {abort.raise} = {
  let n = size(solver.terms);
  let walked = range(0, n).fold(
    { solver: solver, b: branch, changed: false, seen: Map::new() },
    |st: { solver: Solver, b: Branch, changed: Bool, seen: Map<Node, Int> }, t: Int|
      match canonical(st.solver.terms, st.b.cs, t) {
        None -> st,
        Some(sig) -> match st.seen.get(sig) {
          Some(other) -> {
            let j = union(st.b.cs, t, other);
            if j.changed {
              {
                solver: with_rule(st.solver, Congruence),
                b: { ..st.b, cs: j.cs },
                changed: true,
                seen: st.seen,
              }
            } else { st }
          },
          None -> { ..st, seen: st.seen.insert(sig, t) },
        },
      },
  );
  let s = structural(walked.solver, walked.b, n);
  { solver: s.solver, b: s.b, changed: walked.changed || s.changed }
}

fn canonical(terms: Terms, cs: Classes, t: Int) -> Option<Node> / {abort.raise} = {
  let f = |x: Int| find(cs, x);
  match node(terms, t) {
    LinearSumTerm(p) -> {
      let summed = p.monomials.fold(Some(Map::new()), |acc: Option<Map<Int, I128>>, m: Monomial|
        match acc {
          None -> None,
          Some(mm) -> match checked_add(
              match mm.get(f(m.term)) { Some(c) -> c, None -> 0i128 },
              m.coefficient,
            ) {
            Some(c) -> Some(mm.insert(f(m.term), c)),
            None -> None,
          },
        });
      match summed {
        None -> None,
        Some(mm) ->
          Some(
            LinearSumTerm({
              monomials: mm.entries().fold(
                [],
                |acc: List<Monomial>, e: { key: Int, value: I128 }|
                  if e.value == 0i128 { acc }
                  else { acc.push({ term: e.key, coefficient: e.value }) },
              ),
              constant: p.constant,
            }),
          ),
      }
    },
    ApplicationTerm(a) -> Some(ApplicationTerm({ head: f(a.head), args: a.args.map(f) })),
    ConstructorTerm(c) -> Some(ConstructorTerm({ name: c.name, args: c.args.map(f) })),
    ConsTerm(c) -> Some(ConsTerm({ head: f(c.head), tail: f(c.tail) })),
    RecordTerm(fields) ->
      Some(
        RecordTerm(
          fields.map(|x: { name: String, value: Int }| { name: x.name, value: f(x.value) }),
        ),
      ),
    FieldTerm(x) -> Some(FieldTerm({ base: f(x.base), field: x.field })),
    NotTerm(a) -> Some(NotTerm(f(a))),
    AndTerm(a, c) -> Some(AndTerm(f(a), f(c))),
    OrTerm(a, c) -> Some(OrTerm(f(a), f(c))),
    CompareTerm(c) -> Some(CompareTerm({ op: c.op, lhs: f(c.lhs), rhs: f(c.rhs) })),
    EqualTerm(e) -> {
      let x = f(e.lhs);
      let y = f(e.rhs);
      Some(EqualTerm({ lhs: if x < y { x } else { y }, rhs: if x < y { y } else { x } }))
    },
    EqualAtTerm(e) -> {
      let x = f(e.lhs);
      let y = f(e.rhs);
      Some(
        EqualAtTerm({
          lhs: if x < y { x } else { y },
          rhs: if x < y { y } else { x },
          reflexive: e.reflexive,
        }),
      )
    },
    IfTerm(i) ->
      Some(
        IfTerm({ cond: f(i.cond), then_branch: f(i.then_branch), else_branch: f(i.else_branch) }),
      ),
    MatchTerm(m) ->
      Some(
        MatchTerm({
          scrutinee: f(m.scrutinee),
          arms: m.arms.map(|arm: Arm|
            { test: arm.test, binds: arm.binds.map(f), body: f(arm.body) }),
        }),
      ),
    leaf -> Some(leaf),
  }
}

/// Injectivity and disjointness for constructors, list literals and record literals.
fn structural(solver: Solver, branch: Branch, n: Int) -> StepResult / {abort.raise} =
  groups(branch.cs, n).fold(
    { solver: solver, b: branch, changed: false },
    |st: StepResult, g: { representation: Int, members: List<Int> }|
      if st.b.cs.contradiction { st } else {
        g.members.fold(
          { st: st, witness: None },
          |acc: { st: StepResult, witness: Option<Int> }, t: Int|
            if acc.st.b.cs.contradiction { acc } else {
              match shape_of(acc.st.solver.terms, t) {
                None -> acc,
                Some(shape) -> match acc.witness {
                  None -> { st: acc.st, witness: Some(t) },
                  Some(previous) -> match shape_of(acc.st.solver.terms, previous) {
                    None -> acc,
                    Some(earlier) -> match conflict(earlier, shape) {
                      Some(true) ->
                        {
                          st: {
                            solver: with_rule(acc.st.solver, Injectivity),
                            b: { ..acc.st.b, cs: { ..acc.st.b.cs, contradiction: true } },
                            changed: true,
                          },
                          witness: acc.witness,
                        },
                      Some(false) -> {
                        let u = unify_arguments(acc.st.solver.terms, acc.st.b, previous, t);
                        // A `List::push` is a cell with no fields to read, so a cell that has them
                        // witnesses the class in its place.
                        let witness = if has_fields(acc.st.solver.terms, previous) { acc.witness }
                        else { Some(t) };
                        if u.changed {
                          {
                            st: {
                              solver: with_rule(acc.st.solver, Injectivity),
                              b: u.b,
                              changed: true,
                            },
                            witness: witness,
                          }
                        } else { { st: { ..acc.st, b: u.b }, witness: witness } }
                      },
                      None -> acc,
                    },
                  },
                },
              }
            },
        ).st
      },
  )

fn has_fields(terms: Terms, t: Int) -> Bool / {abort.raise} =
  match node(terms, t) { ApplicationTerm(_) -> false, _ -> true }

fn unify_arguments(
  terms: Terms,
  branch: Branch,
  x: Int,
  y: Int,
) -> { b: Branch, changed: Bool } / {abort.raise} = {
  let pairs = match node(terms, x) {
    ConstructorTerm(c) -> match node(terms, y) {
      ConstructorTerm(d) -> zipped(c.args, d.args),
      _ -> [],
    },
    ConsTerm(c) -> match node(terms, y) {
      ConsTerm(d) -> [{ a: c.head, b: d.head }, { a: c.tail, b: d.tail }],
      _ -> [],
    },
    RecordTerm(xs) -> match node(terms, y) {
      RecordTerm(ys) ->
        zipped(
          xs.map(|f: { name: String, value: Int }| f.value),
          ys.map(|f: { name: String, value: Int }| f.value),
        ),
      _ -> [],
    },
    _ -> [],
  };
  pairs.fold({ b: branch, changed: false }, |acc: { b: Branch, changed: Bool }, pair: TermPair| {
    let j = union(acc.b.cs, pair.a, pair.b);
    { b: { ..acc.b, cs: j.cs }, changed: acc.changed || j.changed }
  })
}

fn zipped(xs: List<Int>, ys: List<Int>) -> List<TermPair> =
  range(0, if xs.len() < ys.len() { xs.len() } else { ys.len() }).fold(
    [],
    |acc: List<TermPair>, i: Int|
      match xs.at(i) {
        Some(x) -> match ys.at(i) { Some(y) -> acc.push({ a: x, b: y }), None -> acc },
        None -> acc,
      },
  )

fn propagate(solver: Solver, branch: Branch) -> StepResult / {abort.raise} = {
  let walked = range(0, size(solver.terms)).fold(
    { solver: solver, b: branch, changed: false },
    |st: StepResult, t: Int| {
      let r = propagate_one(st.solver, st.b, t);
      { solver: r.solver, b: r.b, changed: st.changed || r.changed }
    },
  );
  let d = propagate_disequalities(walked.solver, walked.b);
  { solver: d.solver, b: d.b, changed: walked.changed || d.changed }
}

fn propagate_one(solver: Solver, branch: Branch, t: Int) -> StepResult / {abort.raise} =
  match node(solver.terms, t) {
    NotTerm(a) -> {
      let s1 = match truth(solver.terms, branch, a) {
        Some(v) -> set_truth(solver.terms, branch, t, !v),
        None -> { b: branch, changed: false },
      };
      let s2 = match truth(solver.terms, s1.b, t) {
        Some(v) -> set_truth(solver.terms, s1.b, a, !v),
        None -> { b: s1.b, changed: false },
      };
      let changed = s1.changed || s2.changed;
      {
        solver: if changed { with_rule(solver, Propositional) } else { solver },
        b: s2.b,
        changed: changed,
      }
    },
    AndTerm(x, y) -> junction(solver, branch, t, x, y, true),
    OrTerm(x, y) -> junction(solver, branch, t, x, y, false),
    EqualTerm(e) -> equality(solver, branch, t, e.lhs, e.rhs),
    // A value is `==` to itself only where the sort's `==` is reflexive; nothing else follows.
    EqualAtTerm(e) -> if e.reflexive && equal(branch.cs, e.lhs, e.rhs) {
      let s = set_truth(solver.terms, branch, t, true);
      {
        solver: if s.changed { with_rule(solver, Congruence) } else { solver },
        b: s.b,
        changed: s.changed,
      }
    } else { { solver: solver, b: branch, changed: false } },
    IfTerm(i) -> match truth(solver.terms, branch, i.cond) {
      Some(true) -> {
        let j = union(branch.cs, t, i.then_branch);
        { solver: with_rule(solver, Propositional), b: { ..branch, cs: j.cs }, changed: j.changed }
      },
      Some(false) -> {
        let j = union(branch.cs, t, i.else_branch);
        { solver: with_rule(solver, Propositional), b: { ..branch, cs: j.cs }, changed: j.changed }
      },
      None -> { solver: solver, b: branch, changed: false },
    },
    MatchTerm(m) -> {
      let r = reduce_match(solver.terms, branch, t, m.scrutinee, m.arms);
      { solver: solver, b: r.b, changed: r.changed }
    },
    FieldTerm(f) -> match record_field(solver.terms, branch, f.base, f.field) {
      Some(v) -> {
        let j = union(branch.cs, t, v);
        { solver: with_rule(solver, Congruence), b: { ..branch, cs: j.cs }, changed: j.changed }
      },
      None -> { solver: solver, b: branch, changed: false },
    },
    ApplicationTerm(a) -> match literal_value(solver.terms, branch, a.head, a.args) {
      Some(m) -> join_new_term(solver, branch, t, m),
      None -> over_spine(solver, branch, t, a.head, a.args),
    },
    _ -> { solver: solver, b: branch, changed: false },
  }

/// What a `Float`'s place in the order, its being `NaN`, or a `Decimal`'s normal form is, once the
/// search knows the value is a literal.
fn literal_value(
  terms: Terms,
  branch: Branch,
  head: Int,
  args: List<Int>,
) -> Option<InternedTerm> / {abort.raise} =
  match node(terms, head) {
    OpaqueTerm(name) -> match args {
      [x] -> if name != op_float_rank() && name != op_float_nan()
          && name != op_decimal_normalized() { None } else {
        match first_in_class(
            branch,
            x,
            range(0, size(terms)).filter(|c: Int|
              match node(terms, c) { FloatTerm(_) -> true, DecimalTerm(_) -> true, _ -> false }),
          ) {
          None -> None,
          Some(lit) -> if lit == x { None }
          else if name == op_float_rank() { Some(float_rank(terms, lit)) }
          else if name == op_float_nan() { Some(float_nan(terms, lit)) }
          else { Some(decimal_normalized(terms, lit)) },
        }
      },
      _ -> None,
    },
    _ -> None,
  }

/// `List::len` and `List::push` over a list whose class holds a spine cell, one cell at a time: what lowering
/// does for a spine in view, for one the search came to know.
fn over_spine(
  solver: Solver,
  branch: Branch,
  t: Int,
  head: Int,
  args: List<Int>,
) -> StepResult / {abort.raise} = {
  let unchanged = { solver: solver, b: branch, changed: false };
  match node(solver.terms, head) {
    OpaqueTerm(name) -> match args {
      [xs] -> if name != "List::len" { unchanged } else {
        match known_cell(solver.terms, branch, xs) {
          Some(NilTerm) -> join_new_term(solver, branch, t, int_lit(solver.terms, 0)),
          known -> {
            // What a push leaves is one longer than what it was pushed onto, whatever that is.
            let shorter = match known {
              Some(ConsTerm(c)) -> Some(c.tail),
              _ -> pushed_onto(solver.terms, branch, xs),
            };
            match shorter {
              None -> unchanged,
              Some(below) -> {
                let rest = app(solver.terms, head, [below], Some(int_sort()));
                let one = int_lit(rest.terms, 1);
                // A length the search makes is a length: not negative, as one the claim made is.
                let zero = int_lit(one.terms, 0);
                let counted = cmp(zero.terms, Ge, rest.id, zero.id);
                match add(counted.terms, one.id, rest.id) {
                  Some(sum) -> {
                    let m = join_new_term(solver, branch, t, sum);
                    let j = union(grow(m.b.cs, size(m.solver.terms)), counted.id, true_id());
                    { ..m, b: { ..m.b, cs: j.cs }, changed: m.changed || j.changed }
                  },
                  None -> unchanged,
                }
              },
            }
          },
        }
      },
      [xs, x] -> if name != "List::push" { unchanged } else {
        let sort = sort_of(solver.terms, t);
        match known_cell(solver.terms, branch, xs) {
          Some(NilTerm) -> {
            let empty = nil(solver.terms, sort);
            join_new_term(solver, branch, t, cons(empty.terms, x, empty.id, sort))
          },
          Some(ConsTerm(c)) -> {
            let rest = app(solver.terms, head, [c.tail, x], sort);
            join_new_term(solver, branch, t, cons(rest.terms, c.head, rest.id, sort))
          },
          _ -> unchanged,
        }
      },
      _ -> unchanged,
    },
    _ -> unchanged,
  }
}

/// The list a `List::push` in the class pushed onto.
fn pushed_onto(terms: Terms, branch: Branch, xs: Int) -> Option<Int> / {abort.raise} =
  range(0, size(terms)).fold(None, |found: Option<Int>, p: Int|
    match found {
      Some(_) -> found,
      None -> match node(terms, p) {
        ApplicationTerm(a) -> match a.args {
          [onto, _] -> if equal(branch.cs, p, xs) && is_named(terms, a.head, "List::push") {
            Some(onto)
          } else { None },
          _ -> None,
        },
        _ -> None,
      },
    })

fn is_named(terms: Terms, head: Int, name: String) -> Bool / {abort.raise} =
  match node(terms, head) { OpaqueTerm(n) -> n == name, _ -> false }

fn known_cell(terms: Terms, branch: Branch, xs: Int) -> Option<Node> / {abort.raise} =
  match known_list(terms, branch, xs) { Some(k) -> Some(node(terms, k)), None -> None }

/// `t` joined with a term made for it, the classes grown to hold it.
fn join_new_term(solver: Solver, branch: Branch, t: Int, m: InternedTerm) -> StepResult = {
  let j = union(grow(branch.cs, size(m.terms)), t, m.id);
  {
    solver: { ..with_rule(solver, Congruence), terms: m.terms },
    b: { ..branch, cs: j.cs },
    changed: j.changed,
  }
}

/// `a != b` at `Bool` decides one side from the other.
fn propagate_disequalities(solver: Solver, branch: Branch) -> StepResult = {
  let walked = branch.cs.disequalities.fold(
    { b: branch, changed: false },
    |acc: { b: Branch, changed: Bool }, d: TermPair|
      [{ a: d.a, b: d.b }, { a: d.b, b: d.a }].fold(
        acc,
        |inner: { b: Branch, changed: Bool }, xy: TermPair|
          if !is_bool(solver.terms, xy.b) { inner } else {
            match truth(solver.terms, inner.b, xy.a) {
              Some(v) -> {
                let s = set_truth(solver.terms, inner.b, xy.b, !v);
                { b: s.b, changed: inner.changed || s.changed }
              },
              None -> inner,
            }
          },
      ),
  );
  {
    solver: if walked.changed { with_rule(solver, Propositional) } else { solver },
    b: walked.b,
    changed: walked.changed,
  }
}

fn is_bool(terms: Terms, t: Int) -> Bool =
  match sort_of(terms, t) { Some(s) -> is_named_sort(s, "Bool"), None -> false }

/// `&&` when `conjunction` holds, `||` when it does not.
fn junction(
  solver: Solver,
  branch: Branch,
  t: Int,
  x: Int,
  y: Int,
  conjunction: Bool,
) -> StepResult = {
  let short = !conjunction;
  let left = truth(solver.terms, branch, x);
  let right = truth(solver.terms, branch, y);
  let s1 = if left == Some(short) || right == Some(short) {
    set_truth(solver.terms, branch, t, short)
  } else if left == Some(!short) && right == Some(!short) {
    set_truth(solver.terms, branch, t, !short)
  } else { { b: branch, changed: false } };
  let s2 = match truth(solver.terms, s1.b, t) {
    Some(v) -> if v != short {
      let a1 = set_truth(solver.terms, s1.b, x, !short);
      let a2 = set_truth(solver.terms, a1.b, y, !short);
      { b: a2.b, changed: a1.changed || a2.changed }
    } else {
      let a1 = if left == Some(!short) { set_truth(solver.terms, s1.b, y, short) }
      else { { b: s1.b, changed: false } };
      let a2 = if right == Some(!short) { set_truth(solver.terms, a1.b, x, short) }
      else { { b: a1.b, changed: false } };
      { b: a2.b, changed: a1.changed || a2.changed }
    },
    None -> { b: s1.b, changed: false },
  };
  let changed = s1.changed || s2.changed;
  {
    solver: if changed { with_rule(solver, Propositional) } else { solver },
    b: s2.b,
    changed: changed,
  }
}

fn equality(
  solver: Solver,
  branch: Branch,
  t: Int,
  lhs: Int,
  rhs: Int,
) -> StepResult / {abort.raise} = {
  // Extensionality holds whatever polarity the equality was asserted at.
  let ext = if !equal(branch.cs, lhs, rhs) && fields_all_equal(solver.terms, branch, lhs, rhs) {
    let j = union(branch.cs, lhs, rhs);
    { solver: with_rule(solver, Congruence), b: { ..branch, cs: j.cs }, changed: j.changed }
  } else { { solver: solver, b: branch, changed: false } };
  let d = decide_equality(ext.solver, ext.b, t, lhs, rhs);
  { solver: d.solver, b: d.b, changed: ext.changed || d.changed }
}

fn decide_equality(
  solver: Solver,
  branch: Branch,
  t: Int,
  lhs: Int,
  rhs: Int,
) -> StepResult / {abort.raise} =
  match truth(solver.terms, branch, t) {
    Some(true) -> {
      let j = union(branch.cs, lhs, rhs);
      { solver: solver, b: { ..branch, cs: j.cs }, changed: j.changed }
    },
    Some(false) -> if has_disequality(branch.cs, lhs, rhs) {
      { solver: solver, b: branch, changed: false }
    } else {
      { solver: solver, b: { ..branch, cs: distinguish(branch.cs, lhs, rhs) }, changed: true }
    },
    None -> if equal(branch.cs, lhs, rhs) {
      let s = set_truth(solver.terms, branch, t, true);
      { solver: with_rule(solver, Congruence), b: s.b, changed: s.changed }
    } else if distinct(solver.terms, branch, lhs, rhs) {
      let s = set_truth(solver.terms, branch, t, false);
      { solver: with_rule(solver, Injectivity), b: s.b, changed: s.changed }
    } else { { solver: solver, b: branch, changed: false } },
  }

type ArmSelection = | SelectedArm(Int) | NeedsCtor | NeedsList(Int) | NeedsLit(Int) | NoArm

type ListShape = | ShapeMatched | ShapeMismatched | ShapeUnknown(Int)

fn reduce_match(
  terms: Terms,
  branch: Branch,
  t: Int,
  scrutinee: Int,
  arms: List<Arm>,
) -> { b: Branch, changed: Bool } / {abort.raise} =
  match select_arm(terms, branch, scrutinee, arms) {
    SelectedArm(index) -> match arms.at(index) {
      None -> { b: branch, changed: false },
      Some(arm) -> {
        let j0 = union(branch.cs, t, arm.body);
        let b0 = { ..branch, cs: j0.cs };
        let fields = match known_constructor(terms, b0, scrutinee) {
          Some(applied) -> match node(terms, applied) {
            ConstructorTerm(c) ->
              zipped(arm.binds, c.args).fold(
                { b: b0, changed: j0.changed },
                |acc: { b: Branch, changed: Bool }, pair: TermPair| {
                  let j = union(acc.b.cs, pair.a, pair.b);
                  { b: { ..acc.b, cs: j.cs }, changed: acc.changed || j.changed }
                },
              ),
            _ -> { b: b0, changed: j0.changed },
          },
          None -> { b: b0, changed: j0.changed },
        };
        match arm.test {
          TestList(l) -> {
            let walked = range(0, l.fixed).fold(
              { b: fields.b, changed: fields.changed, at: scrutinee, next: 0, stop: false },
              |st: { b: Branch, changed: Bool, at: Int, next: Int, stop: Bool }, _: Int|
                if st.stop { st } else {
                  match known_list(terms, st.b, st.at) {
                    None -> { ..st, stop: true },
                    Some(known) -> match node(terms, known) {
                      ConsTerm(c) -> match arm.binds.at(st.next) {
                        Some(bind) -> {
                          let j = union(st.b.cs, bind, c.head);
                          {
                            b: { ..st.b, cs: j.cs },
                            changed: st.changed || j.changed,
                            at: c.tail,
                            next: st.next + 1,
                            stop: false,
                          }
                        },
                        None -> { ..st, at: c.tail },
                      },
                      _ -> { ..st, stop: true },
                    },
                  }
                },
            );
            if l.rest {
              match arm.binds.at(walked.next) {
                Some(bind) -> {
                  let j = union(walked.b.cs, bind, walked.at);
                  { b: { ..walked.b, cs: j.cs }, changed: walked.changed || j.changed }
                },
                None -> { b: walked.b, changed: walked.changed },
              }
            } else { { b: walked.b, changed: walked.changed } }
          },
          _ -> fields,
        }
      },
    },
    _ -> { b: branch, changed: false },
  }

fn select_arm(
  terms: Terms,
  branch: Branch,
  scrutinee: Int,
  arms: List<Arm>,
) -> ArmSelection / {abort.raise} =
  match range(0, arms.len()).fold(None, |acc: Option<ArmSelection>, index: Int|
      match acc {
        Some(_) -> acc,
        None -> match arms.at(index) {
          None -> acc,
          Some(arm) -> match arm.test {
            Always -> Some(SelectedArm(index)),
            TestCtor(wanted) -> match known_constructor(terms, branch, scrutinee) {
              Some(applied) -> match node(terms, applied) {
                ConstructorTerm(c) -> if c.name == wanted { Some(SelectedArm(index)) }
                else { None },
                _ -> None,
              },
              None -> Some(NeedsCtor),
            },
            TestLit(literal) -> if equal(branch.cs, scrutinee, literal) { Some(SelectedArm(index)) }
            else if distinct(terms, branch, scrutinee, literal) { None }
            else { Some(NeedsLit(literal)) },
            TestList(l) -> match list_shape(terms, branch, scrutinee, l.fixed, l.rest) {
              ShapeMatched -> Some(SelectedArm(index)),
              ShapeMismatched -> None,
              ShapeUnknown(at) -> Some(NeedsList(at)),
            },
            Undecidable -> Some(NoArm),
          },
        },
      }) {
    Some(taken) -> taken,
    None -> NoArm,
  }

/// Walks `fixed` conses down from the scrutinee, then asks for a rest or the end.
fn list_shape(
  terms: Terms,
  branch: Branch,
  scrutinee: Int,
  fixed: Int,
  rest: Bool,
) -> ListShape / {abort.raise} = {
  let walked = range(0, fixed).fold(
    { at: scrutinee, done: None },
    |st: { at: Int, done: Option<ListShape> }, _: Int|
      match st.done {
        Some(_) -> st,
        None -> match known_list(terms, branch, st.at) {
          Some(k) -> match node(terms, k) {
            ConsTerm(c) -> { at: c.tail, done: None },
            _ -> { at: st.at, done: Some(ShapeMismatched) },
          },
          None -> { at: st.at, done: Some(ShapeUnknown(st.at)) },
        },
      },
  );
  match walked.done {
    Some(s) -> s,
    None -> if rest { ShapeMatched } else {
      match known_list(terms, branch, walked.at) {
        Some(k) -> match node(terms, k) { NilTerm -> ShapeMatched, _ -> ShapeMismatched },
        None -> ShapeUnknown(walked.at),
      }
    },
  }
}

/// The least of `candidates` in `t`'s class.
fn first_in_class(branch: Branch, t: Int, candidates: List<Int>) -> Option<Int> = {
  let rep = find(branch.cs, t);
  candidates.fold(None, |acc: Option<Int>, x: Int|
    match acc { Some(_) -> acc, None -> if find(branch.cs, x) == rep { Some(x) } else { None } })
}

fn known_list(terms: Terms, branch: Branch, t: Int) -> Option<Int> =
  first_in_class(branch, t, terms.lists)

fn known_constructor(terms: Terms, branch: Branch, t: Int) -> Option<Int> =
  first_in_class(branch, t, terms.ctors)

fn fields_all_equal(terms: Terms, branch: Branch, x: Int, y: Int) -> Bool / {abort.raise} =
  match sort_of(terms, x) {
    Some(RecordSort(left)) -> match sort_of(terms, y) {
      Some(RecordSort(right)) ->
        left.len() > 0
          && left.map(|f: { name: String, ty: Sort }| f.name)
          == right.map(|f: { name: String, ty: Sort }| f.name)
          && left.fold(true, |ok: Bool, f: { name: String, ty: Sort }|
            ok
              && (match projection(terms, branch, x, f.name) {
                Some(p) -> match projection(terms, branch, y, f.name) {
                  Some(q) -> equal(branch.cs, p, q),
                  None -> false,
                },
                None -> false,
              })),
      _ -> false,
    },
    _ -> false,
  }

/// A record literal's field from `base`'s class, or an interned `FieldTerm` node.
fn projection(
  terms: Terms,
  branch: Branch,
  base: Int,
  name: String,
) -> Option<Int> / {abort.raise} =
  match record_field(terms, branch, base, name) {
    Some(found) -> Some(found),
    None -> {
      let rep = find(branch.cs, base);
      range(0, size(terms)).fold(None, |acc: Option<Int>, t: Int|
        match acc {
          Some(_) -> acc,
          None -> match node(terms, t) {
            FieldTerm(f) -> if f.field == name && find(branch.cs, f.base) == rep { Some(t) }
            else { None },
            _ -> None,
          },
        })
    },
  }

fn record_field(
  terms: Terms,
  branch: Branch,
  base: Int,
  name: String,
) -> Option<Int> / {abort.raise} = {
  let rep = find(branch.cs, base);
  terms.records.fold(None, |acc: Option<Int>, t: Int|
    match acc {
      Some(_) -> acc,
      None -> if find(branch.cs, t) != rep { None } else {
        match node(terms, t) {
          RecordTerm(fields) ->
            fields.fold(None, |found: Option<Int>, f: { name: String, value: Int }|
              match found {
                Some(_) -> found,
                None -> if f.name == name { Some(f.value) } else { None },
              }),
          _ -> None,
        }
      },
    })
}

fn truth(terms: Terms, branch: Branch, t: Int) -> Option<Bool> =
  if equal(branch.cs, t, true_id()) { Some(true) }
  else if equal(branch.cs, t, false_id()) { Some(false) }
  else { None }

fn set_truth(terms: Terms, branch: Branch, t: Int, value: Bool) -> { b: Branch, changed: Bool } = {
  let j = union(branch.cs, t, if value { true_id() } else { false_id() });
  { b: { ..branch, cs: j.cs }, changed: j.changed }
}

fn distinct(terms: Terms, branch: Branch, x: Int, y: Int) -> Bool / {abort.raise} = {
  let ra = find(branch.cs, x);
  let rb = find(branch.cs, y);
  if ra == rb { false } else {
    let left = range(0, size(terms)).filter(|t: Int| find(branch.cs, t) == ra);
    let right = range(0, size(terms)).filter(|t: Int| find(branch.cs, t) == rb);
    left.fold(false, |found: Bool, l: Int|
      found
        || (match shape_of(terms, l) {
          None -> false,
          Some(ls) ->
            right.fold(false, |f: Bool, r: Int|
              f
                || (match shape_of(terms, r) {
                  Some(rs) -> conflict(ls, rs) == Some(true),
                  None -> false,
                })),
        }))
  }
}

fn choose_split(solver: Solver, branch: Branch) -> Option<Split> / {abort.raise} = {
  let terms = solver.terms;
  // `if` and `match` first: reducing one exposes structure the other rules need.
  let structural_split = range(0, size(terms)).fold(None, |acc: Option<Split>, t: Int|
    match acc {
      Some(_) -> acc,
      None -> match node(terms, t) {
        IfTerm(i) -> if truth(terms, branch, i.cond) == None { Some(SplitBool(i.cond)) }
        else { None },
        MatchTerm(m) -> match select_arm(terms, branch, m.scrutinee, m.arms) {
          NeedsCtor -> constructor_split(solver, m.scrutinee),
          NeedsLit(literal) -> Some(SplitLit(m.scrutinee, literal)),
          NeedsList(at) -> Some(SplitList(at)),
          _ -> None,
        },
        _ -> None,
      },
    });
  match structural_split {
    Some(s) -> Some(s),
    None -> {
      let junction_split = range(0, size(terms)).fold(None, |acc: Option<Split>, t: Int|
        match acc {
          Some(_) -> acc,
          None -> {
            let parts = match node(terms, t) {
              AndTerm(x, y) -> Some({ a: x, b: y, wanted: false }),
              OrTerm(x, y) -> Some({ a: x, b: y, wanted: true }),
              _ -> None,
            };
            match parts {
              Some(p) -> if truth(terms, branch, t) == Some(p.wanted)
                  && truth(terms, branch, p.a) == None
                  && truth(terms, branch, p.b) == None { Some(SplitBool(p.a)) }
              else { None },
              None -> None,
            }
          },
        });
      match junction_split {
        Some(s) -> Some(s),
        None -> {
          // An `Int` disequality reaches the arithmetic only through this split.
          let diseq = branch.cs.disequalities.fold(None, |acc: Option<Split>, d: TermPair|
            match acc {
              Some(_) -> acc,
              None -> {
                let key = {
                  a: if d.a < d.b { d.a } else { d.b },
                  b: if d.a < d.b { d.b } else { d.a },
                };
                if branch.split.contains(key) { None }
                else if is_int(terms, d.a) && is_int(terms, d.b) {
                  Some(SplitDisequality(d.a, d.b))
                } else { None }
              },
            });
          match diseq {
            Some(s) -> Some(s),
            None -> match undecided_atom(terms, branch) {
              Some(t) -> Some(SplitBool(t)),
              None -> None,
            },
          }
        },
      }
    },
  }
}

/// An unsettled, non-connective `Bool` term reachable from what this branch constrains; the least.
fn undecided_atom(terms: Terms, branch: Branch) -> Option<Int> / {abort.raise} = {
  let known = range(0, size(terms)).filter(|t: Int| truth(terms, branch, t) != None);
  let roots = branch.cs.disequalities.fold(known, |acc: List<Int>, d: TermPair|
    acc.push(d.a).push(d.b));
  let walked = iterate(
    { stack: roots, seen: Map::new(), best: None },
    10000000,
    |st: { stack: List<Int>, seen: Map<Int, Bool>, best: Option<Int> }|
      match st.stack.at(st.stack.len() - 1) {
        None -> Stop(st),
        Some(t) -> {
          let rest = range(0, st.stack.len() - 1).fold([], |acc: List<Int>, i: Int|
            match st.stack.at(i) { Some(x) -> acc.push(x), None -> acc });
          if st.seen.contains(t) { Continue({ ..st, stack: rest }) } else {
            let seen = st.seen.insert(t, true);
            Continue(match node(terms, t) {
              NotTerm(a) -> { stack: rest.push(a), seen: seen, best: st.best },
              AndTerm(x, y) -> { stack: rest.push(x).push(y), seen: seen, best: st.best },
              OrTerm(x, y) -> { stack: rest.push(x).push(y), seen: seen, best: st.best },
              IfTerm(i) -> { stack: rest.push(i.cond), seen: seen, best: st.best },
              EqualTerm(e) -> if is_bool(terms, e.lhs) && is_bool(terms, e.rhs) {
                { stack: rest.push(e.lhs).push(e.rhs), seen: seen, best: st.best }
              } else { atom(terms, branch, t, rest, seen, st.best) },
              _ -> atom(terms, branch, t, rest, seen, st.best),
            })
          }
        },
      },
  );
  walked.best
}

fn atom(
  terms: Terms,
  branch: Branch,
  t: Int,
  rest: List<Int>,
  seen: Map<Int, Bool>,
  best: Option<Int>,
) -> { stack: List<Int>, seen: Map<Int, Bool>, best: Option<Int> } =
  if is_bool(terms, t) && truth(terms, branch, t) == None {
    {
      stack: rest,
      seen: seen,
      best: match best { Some(p) -> Some(if p < t { p } else { t }), None -> Some(t) },
    }
  } else { { stack: rest, seen: seen, best: best } }

fn constructor_split(solver: Solver, scrutinee: Int) -> Option<Split> =
  match sort_of(solver.terms, scrutinee) {
    Some(NamedSort(type_name, args)) -> match variants(solver.cx, type_name) {
      None -> None,
      Some(decl) ->
        Some(
          SplitCtor({
            scrutinee: scrutinee,
            type_name: decl.name,
            ctors: decl.variants.map(|variant: Variant|
              {
                name: variant.name,
                fields: field_sorts(
                  { decl: decl, variant: variant },
                  Some(NamedSort(type_name, args)),
                ),
              }),
          }),
        ),
    },
    _ -> None,
  }

fn arithmetic(
  solver: Solver,
  branch: Branch,
) -> { solver: Solver, result: Feasibility } / {abort.raise} = {
  let terms = solver.terms;
  let f = |t: Int| find(branch.cs, t);
  let from_cmps = range(0, size(terms)).fold(
    { rows: [], relevant: Map::new() },
    |acc: { rows: List<{ coefficients: Map<Int, I128>, constant: I128 }>, relevant: Map<Int, Bool> }, t: Int|
      match node(terms, t) {
        CompareTerm(c) -> match truth(terms, branch, t) {
          None -> acc,
          Some(holds) -> {
            let oriented = if (c.op == Lt && holds) || (c.op == Ge && !holds) {
              { a: c.lhs, b: c.rhs, slack: 1i128 }
            } else if (c.op == Le && holds) || (c.op == Gt && !holds) {
              { a: c.lhs, b: c.rhs, slack: 0i128 }
            } else if (c.op == Gt && holds) || (c.op == Le && !holds) {
              { a: c.rhs, b: c.lhs, slack: 1i128 }
            } else { { a: c.rhs, b: c.lhs, slack: 0i128 } };
            {
              rows: acc.rows.push({
                coefficients: difference(f(oriented.a), f(oriented.b)),
                constant: oriented.slack,
              }),
              relevant: acc.relevant.insert(f(oriented.a), true).insert(f(oriented.b), true),
            }
          },
        },
        _ -> acc,
      },
  );
  let comparisons = branch.int_less_than.fold(
    from_cmps,
    |acc: { rows: List<{ coefficients: Map<Int, I128>, constant: I128 }>, relevant: Map<Int, Bool> }, p: TermPair|
      {
        rows: acc.rows.push({ coefficients: difference(f(p.a), f(p.b)), constant: 1i128 }),
        relevant: acc.relevant.insert(f(p.a), true).insert(f(p.b), true),
      },
  );
  // Only definitions a comparison reaches, so unrelated literals don't blow up elimination.
  let definitions = range(0, size(terms)).fold(
    [],
    |acc: List<{ coefficients: Map<Int, I128>, constant: I128 }>, t: Int|
      match node(terms, t) {
        LinearSumTerm(p) -> {
          let own = Map::new().insert(f(t), 1i128);
          let summed = p.monomials.fold(Some(own), |m: Option<Map<Int, I128>>, x: Monomial|
            match m {
              None -> None,
              Some(mm) -> match checked_sub(
                  match mm.get(f(x.term)) { Some(c) -> c, None -> 0i128 },
                  x.coefficient,
                ) {
                Some(c) -> Some(mm.insert(f(x.term), c)),
                None -> None,
              },
            });
          match summed {
            None -> acc,
            Some(mm) -> match checked_neg(p.constant) {
              Some(k) -> acc.push({ coefficients: nonzero(mm), constant: k }),
              None -> acc,
            },
          }
        },
        IntTerm(k) ->
          acc.push({
            coefficients: Map::new().insert(f(t), 1i128),
            constant: match checked_neg(I128::of_int(k)) { Some(n) -> n, None -> 0i128 },
          }),
        _ -> acc,
      },
  );
  // A fully cancelled definition (`x == x + 1`) reaches nothing, so it is seeded as used.
  let used0 = definitions.map(|d: { coefficients: Map<Int, I128>, constant: I128 }|
    d.coefficients.len() == 0);
  let reached = iterate(
    { used: used0, relevant: comparisons.relevant },
    definitions.len() + 2,
    |st: { used: List<Bool>, relevant: Map<Int, Bool> }| {
      let next = range(0, definitions.len()).fold(
        { used: st.used, relevant: st.relevant, grew: false },
        |acc: { used: List<Bool>, relevant: Map<Int, Bool>, grew: Bool }, i: Int|
          if acc.used.at(i) == Some(true) { acc } else {
            match definitions.at(i) {
              Some(d) -> if d.coefficients.keys().fold(false, |f2: Bool, v: Int|
                  f2 || acc.relevant.contains(v)) {
                {
                  used: acc.used.set(i, true),
                  relevant: d.coefficients.keys().fold(acc.relevant, |r: Map<Int, Bool>, v: Int|
                    r.insert(v, true)),
                  grew: true,
                }
              } else { acc },
              None -> acc,
            }
          },
      );
      if next.grew { Continue({ used: next.used, relevant: next.relevant }) }
      else { Stop({ used: next.used, relevant: next.relevant }) }
    },
  );
  let with_defs = range(0, definitions.len()).fold([], |rows: List<Inequality>, i: Int|
    if reached.used.at(i) == Some(true) {
      match definitions.at(i) {
        Some(d) -> add_equality(rows, d.coefficients, d.constant),
        None -> rows,
      }
    } else { rows });
  let system = comparisons.rows.fold(
    with_defs,
    |rows: List<Inequality>, r: { coefficients: Map<Int, I128>, constant: I128 }|
      add_inequality(rows, r.coefficients, r.constant),
  );
  if system.len() == 0 { { solver: solver, result: Undecided } } else {
    let settled = feasibility(system, solver.budget);
    { solver: { ..solver, budget: settled.budget }, result: settled.result }
  }
}

fn difference(a: Int, b: Int) -> Map<Int, I128> =
  if a == b { Map::new() } else { Map::new().insert(a, 1i128).insert(b, -1i128) }
