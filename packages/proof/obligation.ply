import std.bin
import std.json (Array, Json, Null, Number, Object, Str)
import std.value (Value, filled)
import std.list
import rules (Rule, Unfold, Cited, Descent, Spine, induction_rule, rule_json, rule_bin)
import std.string
import std.map

pub type Kind = | Ensures(Int) | Cost(Int) | Law(Option<String>) | Space(Int) | Builds(String)

pub type Laws = { targets: Map<String, List<String>>, texts: Map<String, String> }

pub const no_laws: Laws = { targets: Map::new(), texts: Map::new() }

pub fn add_law(laws: Laws, key: String, text: String, targets: List<String>) -> Laws =
  {
    targets: laws.targets.insert(key, law_targets(laws, key).concat(targets)),
    texts: laws.texts.insert(key, text),
  }

pub fn law_targets(laws: Laws, law: String) -> List<String> =
  match laws.targets.get(law) { Some(terms) -> terms, None -> [] }

pub fn law_text(laws: Laws, law: String) -> Option<String> = laws.texts.get(law)

pub fn has_laws(laws: Laws) -> Bool = laws.texts.len() > 0

pub type WrittenLaw = { key: String, text: String, mentions: List<String> }

pub fn laws_of(definitions: List<String>, written: List<WrittenLaw>) -> Laws = {
  let known_definitions = Map::of_entries(
    definitions.map(|name: String| { key: name, value: true }),
  );
  written.fold(no_laws, |laws: Laws, w: WrittenLaw|
    add_law(
      laws,
      w.key,
      w.text,
      w.mentions.filter(|name: String| known_definitions.contains(name)),
    ))
}

pub fn laws_naming(laws: Laws, name: String) -> List<String> =
  laws.targets.keys().fold([], |accumulator: List<String>, law: String|
    if law_targets(laws, law).contains(name) {
      match law_text(laws, law) { Some(text) -> accumulator.push(text), None -> accumulator }
    } else { accumulator })

pub type ChangeState = | Unchanged | Changed | Never

pub fn change_state_word(m: ChangeState) -> String =
  match m { Unchanged -> "unchanged", Changed -> "changed", Never -> "never" }

pub type ClaimSnapshot = { definition_hash: String, specs: List<String> }

pub type Definition = { name: String, hash: Option<String>, specs: List<String> }

pub fn claim_snapshots(
  definitions: List<Definition>,
  laws: Laws,
) -> List<{ name: String, record: ClaimSnapshot }> / {abort.raise} = {
  let named = laws.targets.keys().fold(
    Map::new(),
    |accumulator: Map<String, List<String>>, law: String|
      match law_text(laws, law) {
        None -> accumulator,
        Some(text) ->
          law_targets(laws, law).fold(accumulator, |a: Map<String, List<String>>, name: String|
            a.insert(name, List::push(match a.get(name) { Some(ts) -> ts, None -> [] }, text))),
      },
  );
  definitions.fold(
    [],
    |accumulator: List<{ name: String, record: ClaimSnapshot }>, d: Definition|
      match d.hash {
        None -> accumulator,
        Some(h) ->
          accumulator.push({
            name: d.name,
            record: {
              definition_hash: h,
              specs: spec_set(
                d.specs.concat(match named.get(d.name) { Some(texts) -> texts, None -> [] }),
              ),
            },
          }),
      },
  )
}

fn spec_set(specs: List<String>) -> List<String> / {abort.raise} =
  specs.sort().fold([], |accumulator: List<String>, x: String|
    if accumulator.len() > 0 && accumulator.get(accumulator.len() - 1) == x { accumulator }
    else { accumulator.push(x) })

pub fn snapshot_map(
  rs: List<{ name: String, record: ClaimSnapshot }>,
) -> Map<String, ClaimSnapshot> =
  rs.fold(Map::new(), |m: Map<String, ClaimSnapshot>, r: { name: String, record: ClaimSnapshot }|
    m.insert(r.name, r.record))

pub fn spec_hashes(
  name: String,
  spec_texts: Map<String, List<String>>,
  laws: Laws,
) -> List<String> = own_specs(spec_texts, name).concat(laws_naming(laws, name))

fn own_specs(spec_texts: Map<String, List<String>>, name: String) -> List<String> =
  match spec_texts.get(name) { Some(xs) -> xs, None -> [] }

pub type CacheStatus = | Fresh | FromProof | Uncached | CacheRejected

pub fn is_cache_hit(r: CacheStatus) -> Bool = r == FromProof

pub fn cache_status_word(r: CacheStatus) -> String =
  match r {
    Fresh -> "new",
    FromProof -> "cached proof",
    Uncached -> "uncached",
    CacheRejected -> "cache rejected",
  }

pub type CacheLookup = { reason: CacheStatus, from: Option<String>, warning: Option<String> }

pub fn cache_miss(reason: CacheStatus) -> CacheLookup =
  { reason: reason, from: None, warning: None }

pub type CacheEntry = Option<String>

pub fn verdict_of(
  bare_key: String,
  run_key: String,
  bare: CacheEntry,
  ran: CacheEntry,
) -> CacheLookup / {abort.raise} =
  match bare {
    None -> match ran {
      None -> cache_miss(Fresh),
      Some(kind) -> if kind == "run" { { reason: FromProof, from: Some(run_key), warning: None } }
      else { cache_rejection(kind, false, bare_key) },
    },
    Some(kind) -> if kind == "proof" { { reason: FromProof, from: Some(bare_key), warning: None } }
    else { cache_rejection(kind, true, bare_key) },
  }

fn cache_rejection(kind: String, bare: Bool, key: String) -> CacheLookup / {abort.raise} = {
  let what = if kind == "run" { "a proof that depends on the code the claim executes" }
  else if kind == "proof" { "a proof that depends on the claim alone" }
  else { "an entry in a format Ply cannot read" };
  let where = if bare { "a cache key for a claim alone" }
  else { "a cache key for a claim and its executed code" };
  {
    reason: CacheRejected,
    from: None,
    warning: Some(
      "the proof cache contains " ++ what ++ ", stored under " ++ where ++ " `" ++ key.slice(0, 12)
        ++ "`; it was discarded",
    ),
  }
}

pub type Selection = {
  reasons: List<CacheStatus>,
  from: List<Option<String>>,
  to_discharge: List<Int>,
  warnings: List<String>,
}

pub fn cache_hit_count(s: Selection) -> Int = s.reasons.filter(is_cache_hit).len()

pub fn select(results: List<CacheLookup>, use_cache: Bool) -> Selection / {abort.raise} = {
  let decided = results.map(|a: CacheLookup| if use_cache { a } else { cache_miss(Uncached) });
  {
    reasons: decided.map(|a: CacheLookup| a.reason),
    from: decided.map(|a: CacheLookup| a.from),
    to_discharge: range(0, decided.len()).filter(|i: Int| decided.get(i).from == None),
    warnings: decided.fold([], |accumulator: List<String>, a: CacheLookup|
      match a.warning { Some(w) -> accumulator.push(w), None -> accumulator }),
  }
}

pub fn cache_writes(
  keys: List<{ bare: String, ran: String }>,
  proofs: List<Option<Bool>>,
  to_discharge: List<Int>,
  use_cache: Bool,
) -> List<{ at: Int, key: String }> / {abort.raise} =
  if !use_cache { [] } else {
    to_discharge.fold([], |accumulator: List<{ at: Int, key: String }>, position: Int|
      match proofs.get(position) {
        None -> accumulator,
        Some(ran) -> {
          let k = keys.get(position);
          accumulator.push({ at: position, key: if ran { k.ran } else { k.bare } })
        },
      })
  }

pub type Coverage = { definitions: Int, covered: Int, uncovered: List<String> }

pub type ClaimRow = { owner: String, kind: Kind, proved: Bool, discharged: Bool }

pub fn covered_by(claim: ClaimRow, laws: Laws) -> List<String> = owners(claim, laws)

pub fn coverage(definitions: List<String>, laws: Laws, results: List<ClaimRow>) -> Coverage = {
  let known_definitions = Map::of_entries(
    definitions.map(|name: String| { key: name, value: true }),
  );
  let covered = results.fold(Map::new(), |accumulator: Map<String, Bool>, r: ClaimRow|
    if !r.proved { accumulator } else {
      covered_by(r, laws).fold(accumulator, |m: Map<String, Bool>, name: String|
        if known_definitions.contains(name) { m.insert(name, true) } else { m })
    });
  {
    definitions: definitions.len(),
    covered: covered.len(),
    uncovered: definitions.filter(|name: String| !covered.contains(name)).sort(),
  }
}

pub type ClaimTarget = { owner: String, kind: Kind }

pub fn specified_count(definitions: List<String>, laws: Laws, claims: List<ClaimTarget>) -> Int = {
  let known_definitions = Map::of_entries(
    definitions.map(|name: String| { key: name, value: true }),
  );
  let named = claims.fold(Map::new(), |accumulator: Map<String, Bool>, c: ClaimTarget|
    owners_of(c.owner, c.kind, laws).fold(accumulator, |out: Map<String, Bool>, name: String|
      if known_definitions.contains(name) { out.insert(name, true) } else { out }));
  named.len()
}

pub type Change = {
  name: String,
  implementation: ChangeState,
  spec: ChangeState,
  obligations: List<Int>,
  proved_count: Int,
}

pub fn is_specified(change: Change) -> Bool = change.proved_count > 0

pub fn has_obligations(change: Change) -> Bool = change.obligations.len() > 0

pub fn changed(change: Change) -> Bool =
  change.implementation != Unchanged || change.spec != Unchanged

pub type Changes = { reviewed: Int, changed: List<Change>, broken: Int, undischarged: Int }

pub fn specified_change_count(c: Changes) -> Int = c.changed.filter(is_specified).len()

pub fn unspecified_changes(c: Changes) -> Int = c.changed.len() - specified_change_count(c)

pub fn review(
  definitions: List<String>,
  laws: Laws,
  current: Map<String, ClaimSnapshot>,
  baselines: Map<String, ClaimSnapshot>,
  results: List<ClaimRow>,
) -> Changes / {abort.raise} = {
  let obligations_by_owner = range(0, results.len()).fold(
    Map::new(),
    |accumulator: Map<String, List<Int>>, i: Int| {
      let r = results.get(i);
      owners(r, laws).fold(accumulator, |m: Map<String, List<Int>>, name: String|
        m.insert(name, m.get_or(name, []).push(i)))
    },
  );
  let walked = definitions.fold(
    { reviewed: 0, changed: [], broken: 0, undischarged: 0 },
    |accumulator: { reviewed: Int, changed: List<Change>, broken: Int, undischarged: Int }, name: String|
      match current.get(name) {
        None -> accumulator,
        Some(now) -> {
          let baseline = baselines.get(name);
          let checked = {
            ..accumulator,
            reviewed: accumulator.reviewed + (match baseline { Some(_) -> 1, None -> 0 }),
          };
          let entry = {
            name: name,
            implementation: match baseline {
              None -> Never,
              Some(was) -> change_state(was.definition_hash == now.definition_hash),
            },
            spec: match baseline {
              None -> Never,
              Some(was) -> change_state(spec_set(was.specs) == spec_set(now.specs)),
            },
            obligations: obligations_by_owner.get_or(name, []),
            proved_count: obligations_by_owner.get_or(name, []).filter(|i: Int|
              results.get(i).proved).len(
            ),
          };
          if changed(entry) {
            {
              ..checked,
              changed: checked.changed.push(entry),
              broken: checked.broken
                + entry.obligations.filter(|i: Int| !results.get(i).proved).len(),
              undischarged: checked.undischarged
                + entry.obligations.filter(|i: Int| !results.get(i).discharged).len(),
            }
          } else { checked }
        },
      },
  );
  {
    reviewed: walked.reviewed,
    changed: walked.changed,
    broken: walked.broken,
    undischarged: walked.undischarged,
  }
}

fn owners(r: ClaimRow, laws: Laws) -> List<String> = owners_of(r.owner, r.kind, laws)

fn owners_of(owner: String, kind: Kind, laws: Laws) -> List<String> =
  match kind { Law(_) -> law_targets(laws, owner), _ -> [owner] }

fn change_state(same: Bool) -> ChangeState = if same { Unchanged } else { Changed }

fn a_row(owner: String, kind: Kind, proved: Bool, discharged: Bool) -> ClaimRow =
  { owner: owner, kind: kind, proved: proved, discharged: discharged }

fn a_clause(owner: String, proved: Bool) -> ClaimRow = a_row(owner, Ensures(0), proved, proved)

fn a_law(owner: String, proved: Bool) -> ClaimRow = a_row(owner, Law(None), proved, proved)

pub type Certificate = {
  rules: List<Rule>,
  steps: Int,
  guard_satisfiable: Bool,
  sorts: List<String>,
  ran: Bool,
}

derive bin for Certificate

pub type Counterexample = { bindings: List<Binding>, seed: Option<String> }

pub type Judgement =
  | PointPassed
  | PointFailed
  | PointRejected
  | PointRaised({ message: String, values: List<Value> })
  | PointFaulted({ code: String, message: String, notes: List<String>, values: List<Value> })

pub fn is_proved(outcome: Outcome) -> Bool = match outcome { Proved(_) -> true, _ -> false }

pub type Outcome =
  | Proved(Certificate)
  | Refuted(Counterexample)
  | Vacuous({ guard: { module: Int, start: Int, end: Int } })
  | Unproved(Reason)
  | InternalError(Fault)

fn field(fields: Map<String, Json>, key: String) -> Json =
  match fields.get(key) { Some(v) -> v, None -> Null }

fn text_at(fields: Map<String, Json>, key: String) -> String =
  match field(fields, key) { Str(s) -> s, _ -> "" }

fn int_at(fields: Map<String, Json>, key: String) -> Int =
  match field(fields, key) {
    Number(d) -> match Int::of_decimal(d, Down) { Some(n) -> n, None -> 0 },
    _ -> 0,
  }

type Tagged = { tag: String, body: Map<String, Json> }

const no_fields: Map<String, Json> = Map::new()

fn tagged(m: Map<String, Json>) -> Tagged =
  m.fold({ tag: "", body: no_fields }, |accumulator: Tagged, k: String, v: Json|
    if accumulator.tag == "" { { tag: k, body: match v { Object(fs) -> fs, _ -> no_fields } } }
    else { accumulator })

fn tag_words(tag: String) -> String = String::join(tag.split("_"), " ")

fn rule_tag(r: Json) -> String = match r { Str(tag) -> tag, Object(m) -> tagged(m).tag, _ -> "" }

fn unfolds(r: Json) -> Bool = rule_tag(r) == "unfold"

fn rule_text(r: Json) -> String / {abort.raise} =
  match r {
    Str(tag) -> tag_words(tag),
    Object(m) -> {
      let t: Tagged = tagged(m);
      if t.tag == "exhaustive_enumeration" {
        let points = int_at(t.body, "points");
        "exhaustive over " ++ points.to_string() ++ " " ++ plural(points, "point") ++ " of "
          ++ text_at(t.body, "domain")
      } else if t.tag == "case_split" {
        "case analysis over " ++ text_at(t.body, "ty") ++ " (" ++ int_at(t.body, "arms").to_string()
          ++ " arms)"
      } else if t.tag == "induction" {
        (if text_at(t.body, "over") == "list" { "structural induction on " }
          else { "induction on " })
          ++ text_at(t.body, "binder")
          ++ ", unrolling "
          ++ text_at(t.body, "def")
      } else if t.tag == "lemma" { "lemma \"" ++ text_at(t.body, "label") ++ "\"" }
      else if t.tag == "contract" { "the contract of " ++ text_at(t.body, "def") }
      else if t.tag == "exhaustive_interleaving" {
        let n = int_at(t.body, "interleavings");
        "exhaustive over " ++ n.to_string() ++ " " ++ plural(n, "interleaving")
      } else { tag_words(t.tag) }
    },
    _ -> "",
  }

fn rules_of(c: Certificate) -> List<Json> = c.rules.map(rule_json)

fn named_once(parts: List<String>, part: String) -> List<String> =
  if parts.fold(false, |seen: Bool, p: String| seen || p == part) { parts }
  else { parts.push(part) }

pub fn certificate_summary(c: Certificate) -> String / {abort.raise} = {
  let rules = rules_of(c);
  let named = rules.fold([], |accumulator: List<String>, r: Json|
    if unfolds(r) { accumulator } else { named_once(accumulator, rule_text(r)) });
  let unfoldings = rules.filter(|r: Json| unfolds(r)).len();
  let counted = if unfoldings > 0 {
    named.push(unfoldings.to_string() ++ " " ++ plural(unfoldings, "unfolding"))
  } else { named };
  let sorted = if c.sorts.len() > 0 {
    counted.push("uninterpreted " ++ String::join(c.sorts, ", "))
  } else { counted };
  String::join(sorted.push(c.steps.to_string() ++ " steps"), " · ")
}

pub fn plural(n: Int, word: String) -> String / {abort.raise} =
  if n == 1 { word } else if word.ends_with("y") && !ends_in_vowel(word.slice(0, word.len() - 1)) {
    word.slice(0, word.len() - 1) ++ "ies"
  } else { word ++ "s" }

pub fn ends_in_vowel(stem: String) -> Bool =
  stem.ends_with("a") || stem.ends_with("e") || stem.ends_with("i") || stem.ends_with("o")
    || stem.ends_with("u")

test "`select` reuses each obligation's cached result and proves only the uncached ones, and with caching off it proves every obligation" {
  let results = [
    { reason: FromProof, from: Some("k0"), warning: None },
    { reason: Fresh, from: None, warning: None },
    { reason: FromProof, from: Some("r2"), warning: None },
  ];
  let s = select(results, true);
  assert_eq(s.reasons, [FromProof, Fresh, FromProof]);
  assert_eq(s.from, [Some("k0"), None, Some("r2")]);
  assert_eq(s.to_discharge, [1]);
  assert_eq(cache_hit_count(s), 2);
  assert_eq(s.warnings, []);
  let s = select(results, false);
  assert_eq(s.reasons, [Uncached, Uncached, Uncached]);
  assert_eq(s.from, [None, None, None]);
  assert_eq(s.to_discharge, [0, 1, 2]);
  assert_eq(cache_hit_count(s), 0);
  let cache_rejection = [
    {
      reason: CacheRejected,
      from: None,
      warning: Some("the proof cache contains something else for `ab`; it was discarded"),
    },
  ];
  let s = select(cache_rejection, true);
  assert_eq(s.reasons, [CacheRejected]);
  assert_eq(s.to_discharge, [0]);
  assert_eq(s.warnings, ["the proof cache contains something else for `ab`; it was discarded"])
}

fn bare() -> String = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn ran() -> String = "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"

fn verdict(b: CacheEntry, r: CacheEntry) -> CacheLookup / {abort.raise} =
  verdict_of(bare(), ran(), b, r)

test "`verdict` accepts a cached proof stored under either the claim-only key or the run key, and prefers the claim-only key when both exist" {
  assert_eq(verdict(None, None), { reason: Fresh, from: None, warning: None });
  assert_eq(verdict(Some("proof"), None), { reason: FromProof, from: Some(bare()), warning: None });
  assert_eq(verdict(None, Some("run")), { reason: FromProof, from: Some(ran()), warning: None });
  assert_eq(verdict(Some("proof"), Some("run")).from, Some(bare()));
  assert_eq(verdict(Some("proof"), Some("proof")).from, Some(bare()));
  assert_eq(verdict(Some("run"), Some("run")).reason, CacheRejected);
  assert_eq(verdict(Some("other"), Some("run")).reason, CacheRejected)
}

test "`verdict` rejects a cached proof stored under the key for the other kind of proof, and its warning names the key it was found under" {
  let bare_run = verdict(Some("run"), None);
  assert_eq(bare_run.reason, CacheRejected);
  assert_eq(bare_run.from, None);
  assert_eq(
    bare_run.warning,
    Some(
      "the proof cache contains a proof that depends on the code the claim executes, stored under a cache key for a claim alone `0123456789ab`; it was discarded",
    ),
  );
  let run_proof = verdict(None, Some("proof"));
  assert_eq(run_proof.reason, CacheRejected);
  assert_eq(
    run_proof.warning,
    Some(
      "the proof cache contains a proof that depends on the claim alone, stored under a cache key for a claim and its executed code `0123456789ab`; it was discarded",
    ),
  );
  assert_eq(
    verdict(Some("other"), None).warning,
    Some(
      "the proof cache contains an entry in a format Ply cannot read, stored under a cache key for a claim alone `0123456789ab`; it was discarded",
    ),
  );
  assert_eq(
    verdict(None, Some("other")).warning,
    Some(
      "the proof cache contains an entry in a format Ply cannot read, stored under a cache key for a claim and its executed code `0123456789ab`; it was discarded",
    ),
  );
  let s = select([run_proof, verdict(None, Some("run"))], true);
  assert_eq(s.to_discharge, [0]);
  assert_eq(s.warnings.len(), 1);
  assert_eq(cache_hit_count(s), 1)
}

test "`cache_writes` stores a proof under the claim-only key or the run key, whichever was used to make it, and stores nothing for a claim with no proof" {
  let keys = [{ bare: "b0", ran: "r0" }, { bare: "b1", ran: "r1" }, { bare: "b2", ran: "r2" }];
  let proofs = [Some(false), Some(true), None];
  assert_eq(cache_writes(keys, proofs, [0, 1, 2], true), [
    { at: 0, key: "b0" },
    { at: 1, key: "r1" },
  ]);
  assert_eq(cache_writes(keys, proofs, [1], true), [{ at: 1, key: "r1" }]);
  assert_eq(cache_writes(keys, proofs, [0, 1, 2], false), [])
}

test "a `law` records the definitions it mentions, and its source text counts as part of those definitions' specification" {
  let laws = add_law(
    add_law(no_laws, "m.sorted", "h-law", ["m.insert", "m.sort"]),
    "m.total",
    "h-other",
    ["m.sort"],
  );
  assert_eq(law_targets(laws, "m.sorted"), ["m.insert", "m.sort"]);
  assert_eq(law_targets(laws, "nothing"), []);
  assert_eq(has_laws(laws), true);
  assert_eq(has_laws(no_laws), false);
  assert_eq(laws_naming(laws, "m.sort"), ["h-law", "h-other"]);
  assert_eq(laws_naming(laws, "m.insert"), ["h-law"]);
  assert_eq(laws_naming(laws, "m.nothing"), []);
  let texts = Map::new().insert("m.insert", ["h-clause"]);
  assert_eq(spec_hashes("m.insert", texts, laws), ["h-clause", "h-law"]);
  assert_eq(spec_hashes("m.sort", texts, laws), ["h-law", "h-other"]);
  assert_eq(spec_hashes("m.nothing", texts, laws), [])
}

test "a definition is covered by a claim about it that was proved" {
  let laws = add_law(no_laws, "m.sorted", "h-law", ["m.sort"]);
  let definitions = ["m.sort", "m.insert", "m.other"];
  let results = [
    a_clause("m.sort", false),
    { ..a_clause("m.sort", true), kind: Cost(0) },
    a_clause("m.insert", true),
    a_law("m.sorted", false),
  ];
  let c = coverage(definitions, laws, results);
  assert_eq(c.definitions, 3);
  assert_eq(c.covered, 2);
  assert_eq(c.uncovered, ["m.other"]);
  let c = coverage(definitions, laws, [a_row("m.sort", Ensures(0), false, true)]);
  assert_eq(c.covered, 0);
  assert_eq(c.uncovered, ["m.insert", "m.other", "m.sort"])
}

test "a `law` counts as a specification for each definition it mentions, and a definition mentioned twice counts once" {
  let laws = add_law(no_laws, "m.sorted", "h-law", ["m.sort", "m.insert"]);
  let definitions = ["m.sort", "m.insert", "m.other"];
  let claims = [{ owner: "m.sorted", kind: Law(None) }, { owner: "m.sort", kind: Ensures(0) }];
  assert_eq(specified_count(definitions, laws, claims), 2);
  assert_eq(specified_count(definitions, laws, [{ owner: "m.gone", kind: Ensures(0) }]), 0);
  assert_eq(specified_count(definitions, laws, [{ owner: "m.sort", kind: Ensures(0) }]), 1);
  assert_eq(specified_count(definitions, laws, []), 0)
}

test "a `law` applies to the program's definitions that it mentions, and not to types or library functions that it mentions" {
  let laws = laws_of(["m.credited", "m.debited", "m.helper"], [
    {
      key: "m.cancel",
      text: "h9",
      mentions: ["m.credited", "m.debited", "std.list.len", "m.Coin"],
    },
  ]);
  assert_eq(law_targets(laws, "m.cancel"), ["m.credited", "m.debited"]);
  assert_eq(law_text(laws, "m.cancel"), Some("h9"));
  let c = coverage(["m.credited", "m.debited", "m.helper"], laws, [a_law("m.cancel", true)]);
  assert_eq(c.covered, 2);
  assert_eq(c.uncovered, ["m.helper"]);
  let refuted = coverage(["m.credited"], laws, [a_row("m.cancel", Law(None), false, true)]);
  assert_eq(refuted.covered, 0);
  assert_eq(refuted.uncovered, ["m.credited"])
}

test "`coverage` leaves a definition with no obligation uncovered, and counts each covered definition once" {
  let none = coverage(["m.f"], no_laws, []);
  assert_eq(none.covered, 0);
  assert_eq(none.uncovered, ["m.f"]);
  let c = coverage(["m.f", "m.g", "m.h", "m.i"], no_laws, [
    a_clause("m.f", true),
    a_row("m.g", Ensures(0), false, true),
    a_row("m.h", Ensures(0), false, false),
  ]);
  assert_eq(c.definitions, 4);
  assert_eq(c.covered, 1);
  assert_eq(c.uncovered, ["m.g", "m.h", "m.i"]);
  let both = coverage(["m.f", "m.g"], no_laws, [
    a_clause("m.f", true),
    { ..a_clause("m.f", true), kind: Ensures(1) },
    a_clause("m.g", true),
  ]);
  assert_eq(both.covered, 2)
}

test "`claim_snapshots` stores, for each definition, its hash, the text of its own clauses and the text of the `law`s that mention it" {
  let laws = add_law(no_laws, "m.cancel", "h-law", ["m.f"]);
  let rs = claim_snapshots(
    [
      { name: "m.f", hash: Some("h1"), specs: ["h7"] },
      { name: "m.g", hash: Some("h2"), specs: [] },
      { name: "m.unhashed", hash: None, specs: ["h8"] },
    ],
    laws,
  );
  assert_eq(rs, [
    { name: "m.f", record: { definition_hash: "h1", specs: ["h-law", "h7"] } },
    { name: "m.g", record: { definition_hash: "h2", specs: [] } },
  ]);
  assert_eq(snapshot_map(rs).get("m.g"), Some({ definition_hash: "h2", specs: [] }))
}

fn baselines_of(
  xs: List<{ name: String, definition_hash: String, specs: List<String> }>,
) -> Map<String, ClaimSnapshot> =
  xs.fold(
    Map::new(),
    |m: Map<String, ClaimSnapshot>, x: { name: String, definition_hash: String, specs: List<String> }|
      m.insert(x.name, { definition_hash: x.definition_hash, specs: x.specs }),
  )

test "`review` lists the definitions whose code or specification changed since the stored snapshot, and how many were reviewed" {
  let laws = no_laws;
  let definitions = ["m.moved", "m.spec_moved", "m.same", "m.fresh"];
  let current = baselines_of([
    { name: "m.moved", definition_hash: "h2", specs: ["s1"] },
    { name: "m.spec_moved", definition_hash: "h1", specs: ["s2"] },
    { name: "m.same", definition_hash: "h1", specs: ["s1"] },
    { name: "m.fresh", definition_hash: "h1", specs: ["s1"] },
  ]);
  let baselines = baselines_of([
    { name: "m.moved", definition_hash: "h1", specs: ["s1"] },
    { name: "m.spec_moved", definition_hash: "h1", specs: ["s1"] },
    { name: "m.same", definition_hash: "h1", specs: ["s1"] },
  ]);
  let results = [
    a_clause("m.moved", true),
    a_row("m.spec_moved", Ensures(0), false, true),
    a_row("m.fresh", Ensures(0), false, false),
    a_clause("m.same", true),
  ];
  let r = review(definitions, laws, current, baselines, results);
  assert_eq(r.reviewed, 3);
  assert_eq(r.changed.map(|change: Change| change.name), ["m.moved", "m.spec_moved", "m.fresh"]);
  assert_eq(r.changed.map(|change: Change| change_state_word(change.implementation)), [
    "changed",
    "unchanged",
    "never",
  ]);
  assert_eq(r.changed.map(|change: Change| change_state_word(change.spec)), [
    "unchanged",
    "changed",
    "never",
  ]);
  assert_eq(r.changed.map(|change: Change| change.proved_count), [1, 0, 0]);
  assert_eq(r.changed.map(|change: Change| has_obligations(change)), [true, true, true]);
  assert_eq(r.broken, 2);
  assert_eq(r.undischarged, 1);
  assert_eq(specified_change_count(r), 1);
  assert_eq(unspecified_changes(r), 2);
  assert_eq(r.changed.map(|change: Change| change.obligations), [[0], [1], [2]])
}

test "changing a `law` changes the specification of each definition it mentions, even if their own code is unchanged" {
  let laws = add_law(no_laws, "m.sorted", "h-law-2", ["m.sort"]);
  let definitions = ["m.sort"];
  let current = Map::new().insert("m.sort", {
    definition_hash: "h1",
    specs: spec_hashes("m.sort", Map::new(), laws),
  });
  let baselines = baselines_of([{ name: "m.sort", definition_hash: "h1", specs: ["h-law-1"] }]);
  let r = review(definitions, laws, current, baselines, []);
  assert_eq(r.changed.map(|change: Change| change.name), ["m.sort"]);
  assert_eq(change_state_word(r.changed.get(0).implementation), "unchanged");
  assert_eq(change_state_word(r.changed.get(0).spec), "changed");
  assert_eq(r.broken, 0);
  assert_eq(r.undischarged, 0)
}

fn reviewed_after(
  definitions: List<String>,
  before: List<Definition>,
  laws_before: Laws,
  after: List<Definition>,
  laws_after: Laws,
  results: List<ClaimRow>,
) -> Changes / {abort.raise} =
  review(
    definitions,
    laws_after,
    snapshot_map(claim_snapshots(after, laws_after)),
    snapshot_map(claim_snapshots(before, laws_before)),
    results,
  )

fn definition(name: String, hash: String, specs: List<String>) -> Definition =
  { name: name, hash: Some(hash), specs: specs }

test "`review` leaves unchanged definitions out of its changes, and lists a definition with no stored snapshot as never reviewed" {
  let same = reviewed_after(
    ["m.f"],
    [definition("m.f", "h1", ["h7"])],
    no_laws,
    [definition("m.f", "h1", ["h7"])],
    no_laws,
    [a_clause("m.f", true)],
  );
  assert_eq(same.changed, []);
  assert_eq(same.reviewed, 1);
  let fresh = reviewed_after(
    ["m.new"],
    [definition("m.old", "h1", [])],
    no_laws,
    [definition("m.new", "h1", [])],
    no_laws,
    [],
  );
  assert_eq(fresh.changed.map(|change: Change| change_state_word(change.implementation)), [
    "never",
  ]);
  assert_eq(fresh.reviewed, 0);
  let two = reviewed_after(
    ["m.f", "m.g"],
    [definition("m.f", "h1", ["h7"]), definition("m.g", "h3", [])],
    no_laws,
    [definition("m.f", "h2", ["h7"]), definition("m.g", "h4", [])],
    no_laws,
    [a_clause("m.f", true)],
  );
  assert_eq(two.changed.len(), 2);
  assert_eq(specified_change_count(two), 1);
  assert_eq(unspecified_changes(two), 1);
  assert_eq(two.broken, 0)
}

test "a changed definition with a disproved claim counts as broken, and with a claim that was never proved it counts as broken and unproved" {
  let before = [definition("m.f", "h1", ["h7"])];
  let after = [definition("m.f", "h2", ["h7"])];
  let refuted = reviewed_after(["m.f"], before, no_laws, after, no_laws, [
    a_row("m.f", Ensures(0), false, true),
  ]);
  assert_eq(refuted.broken, 1);
  assert_eq(refuted.undischarged, 0);
  let reason = reviewed_after(["m.f"], before, no_laws, after, no_laws, [
    a_row("m.f", Ensures(0), false, false),
  ]);
  assert_eq(reason.broken, 1);
  assert_eq(reason.undischarged, 1);
  let entry = reason.changed.get(0);
  assert_eq(change_state_word(entry.implementation), "changed");
  assert_eq(change_state_word(entry.spec), "unchanged");
  assert_eq(is_specified(entry), false);
  assert_eq(has_obligations(entry), true);
  assert_eq(specified_change_count(reason), 0)
}

test "`review` finds no change when a stored snapshot lists the same specification texts in a different order" {
  let laws = add_law(add_law(no_laws, "m.b", "h-b", ["m.f"]), "m.a", "h-a", ["m.f"]);
  let now = snapshot_map(claim_snapshots([definition("m.f", "h1", ["h9", "h1c"])], laws));
  let stored = baselines_of([
    { name: "m.f", definition_hash: "h1", specs: ["h9", "h-b", "h1c", "h-a", "h9"] },
  ]);
  let r = review(["m.f"], laws, now, stored, []);
  assert_eq(r.changed, []);
  assert_eq(r.reviewed, 1)
}

test "`review` treats a `law`'s text as the specification of the definitions it mentions, whichever module declares the `law`" {
  let f = [definition("m.f", "h1", [])];
  let moved_law = reviewed_after(
    ["m.f"],
    f,
    add_law(no_laws, "a.cancel", "h9", ["m.f"]),
    f,
    add_law(no_laws, "b.cancel", "h9", ["m.f"]),
    [a_law("b.cancel", true)],
  );
  assert_eq(moved_law.changed, []);
  let rewritten = reviewed_after(
    ["m.f"],
    f,
    add_law(no_laws, "m.cancel", "h9", ["m.f"]),
    f,
    add_law(no_laws, "m.cancel", "h10", ["m.f"]),
    [a_law("m.cancel", true)],
  );
  assert_eq(rewritten.changed.map(|change: Change| change_state_word(change.spec)), ["changed"]);
  assert_eq(rewritten.changed.map(|change: Change| change_state_word(change.implementation)), [
    "unchanged",
  ]);
  let deleted = reviewed_after(
    ["m.f"],
    f,
    add_law(no_laws, "m.cancel", "h9", ["m.f"]),
    f,
    no_laws,
    [],
  );
  assert_eq(deleted.changed.map(|change: Change| change_state_word(change.spec)), ["changed"])
}

test "`cache_status_word` and `change_state_word` return the words a report prints, and `is_cache_hit` is true only for `FromProof`" {
  assert_eq(cache_status_word(Fresh), "new");
  assert_eq(cache_status_word(FromProof), "cached proof");
  assert_eq(cache_status_word(Uncached), "uncached");
  assert_eq(cache_status_word(CacheRejected), "cache rejected");
  assert_eq(is_cache_hit(FromProof), true);
  assert_eq(is_cache_hit(Fresh), false);
  assert_eq(change_state_word(Never), "never")
}

pub type Binding = { name: String, ty: String, value: Value }

pub type Stopped = { kind: String, about: Option<String> }

pub type Reason =
  | Open({ spent: Bool, stopped: List<Stopped> })
  | UnhandledEffect(Option<String>)
  | Raised({ message: String, values: List<Value>, bindings: List<Binding> })
  | NoWitness
  | DomainTooLarge
  | Unsearched(Int)

pub fn reason_summary(g: Reason) -> String / {abort.raise} =
  match g {
    Open(o) -> if o.spent { "no proof within the prover's budget" } else { "no proof" },
    UnhandledEffect(row) -> match row {
      None -> "an effect is performed with no handler",
      Some(text) -> "performs " ++ text ++ ": no handler",
    },
    Raised(r) -> "raised: " ++ filled(r.message, r.values),
    NoWitness -> "the claim holds only because no value satisfies its condition",
    DomainTooLarge -> "the domain of the quantified variables is too large to enumerate in full",
    Unsearched(ran) ->
      "more interleavings than the search can explore, only " ++ ran.to_string() ++ " were tried",
  }

pub fn reason_word(g: Reason) -> String =
  match g {
    Open(_) -> "open",
    UnhandledEffect(_) -> "unhandled_effect",
    Raised(_) -> "raised",
    NoWitness -> "unwitnessed",
    DomainTooLarge -> "endless",
    Unsearched(_) -> "unsearched",
  }

pub fn stopped_summary(s: Stopped) -> String = {
  let stopped = |what: String|
    "the prover stopped at "
      ++ (match s.about { Some(a) -> what ++ " `" ++ a ++ "`", None -> what });
  if s.kind == "recursive_call" { stopped("a recursive call to") }
  else if s.kind == "effectful_call" { stopped("a call to an effectful function") }
  else if s.kind == "unfold_limit" {
    stopped("calls nested too deeply for the prover to expand, at")
  } else if s.kind == "opaque_call" {
    stopped("a call to a builtin or to a name defined outside the program,")
  } else if s.kind == "induction" || s.kind == "unbounded" {
    match s.about { Some(reason) -> reason, None -> stopped(s.kind) }
  } else { stopped(String::join(s.kind.split("_"), " ")) }
}

pub type Fault = {
  code: String,
  message: String,
  notes: List<String>,
  values: List<Value>,
  bindings: List<Binding>,
}

pub fn fault_message(f: Fault) -> String / {abort.raise} = filled(f.message, f.values)

pub fn fault_notes(f: Fault) -> List<String> / {abort.raise} =
  f.notes.map(|n: String| filled(n, f.values))

pub fn fault_summary(f: Fault) -> String / {abort.raise} =
  "this is a bug in Ply, not in your program: " ++ fault_message(f)

pub const vacuity_summary: String = "no value satisfies the law's condition"

test "`reason_summary` turns each reason a claim is unproved into a single line of text" {
  assert_eq(reason_summary(Open({ spent: false, stopped: [] })), "no proof");
  assert_eq(
    reason_summary(Open({ spent: true, stopped: [] })),
    "no proof within the prover's budget",
  );
  assert_eq(
    reason_summary(NoWitness),
    "the claim holds only because no value satisfies its condition",
  );
  assert_eq(
    reason_summary(DomainTooLarge),
    "the domain of the quantified variables is too large to enumerate in full",
  );
  assert_eq(
    reason_summary(Unsearched(4096)),
    "more interleavings than the search can explore, only 4096 were tried",
  )
}

test "`stopped_summary` names the construct where the prover stopped, and also names the definition when there is one" {
  assert_eq(stopped_summary({ kind: "lambda", about: None }), "the prover stopped at lambda");
  assert_eq(
    stopped_summary({ kind: "nonlinear_multiplication", about: None }),
    "the prover stopped at nonlinear multiplication",
  );
  assert_eq(
    stopped_summary({ kind: "recursive_call", about: Some("m.f") }),
    "the prover stopped at a recursive call to `m.f`",
  );
  assert_eq(
    stopped_summary({ kind: "unbounded", about: Some("its steps are not within the bound") }),
    "its steps are not within the bound",
  )
}

test "the summary of an error raised by the program does not mention Ply, and the summary of an internal compiler failure says that Ply failed" {
  let raised = reason_summary(Raised({ message: "division by zero", values: [], bindings: [] }));
  assert_eq(raised, "raised: division by zero");
  let declined: Fault = {
    code: "E0505",
    message: "the compiled program has no entry point `m.law`",
    notes: [],
    values: [],
    bindings: [],
  };
  assert_eq(
    fault_summary(declined),
    "this is a bug in Ply, not in your program: the compiled program has no entry point `m.law`",
  );
  assert(!raised.contains("Ply"))
}

test "`reason_word` gives each kind of unproved reason its own distinct word" {
  let every = [
    Open({ spent: false, stopped: [] }),
    UnhandledEffect(None),
    Raised({ message: "division by zero", values: [], bindings: [] }),
    NoWitness,
    DomainTooLarge,
    Unsearched(8),
  ];
  assert_eq(every.map(reason_word), [
    "open",
    "unhandled_effect",
    "raised",
    "unwitnessed",
    "endless",
    "unsearched",
  ]);
  assert_eq(
    reason_word(UnhandledEffect(Some("{db.read[rows]}"))),
    reason_word(UnhandledEffect(None)),
  )
}

pub type Frame = | NoWrites | Writes(List<String>)

pub fn frame_summary(f: Frame) -> String =
  match f { NoWrites -> "pure", Writes(named) -> "writes " ++ String::join(named, ", ") }

test "`frame_summary` turns the effects a claim may write into a single line of text" {
  assert_eq(frame_summary(NoWrites), "pure");
  assert_eq(frame_summary(Writes(["std.io.file", "clock"])), "writes std.io.file, clock")
}

test "`certificate_summary` turns a proof certificate into a single line of text" {
  assert_eq(
    certificate_summary({
      rules: [
        induction_rule("n", Descent(1), "m.f"),
        Unfold({ definition: "m.f", depth: 1 }),
        Unfold({ definition: "m.g", depth: 1 }),
      ],
      steps: 3,
      guard_satisfiable: true,
      sorts: ["T"],
      ran: false,
    }),
    "induction on n, unrolling m.f · 2 unfoldings · uninterpreted T · 3 steps",
  );
  assert_eq(
    certificate_summary({
      rules: [
        induction_rule("xs", Spine(1), "m.reverse"),
        Cited({ law: "m.a push reversed leads", label: "a push reversed leads" }),
      ],
      steps: 9,
      guard_satisfiable: true,
      sorts: [],
      ran: false,
    }),
    "structural induction on xs, unrolling m.reverse · lemma \"a push reversed leads\" · 9 steps",
  )
}
