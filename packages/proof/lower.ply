pub fn is_total_builtin(name: String) -> Bool =
  total_builtins().fold(false, |f: Bool, b: String| f || b == name)

pub type Blocker =
  | RecursiveCall(String)
  | EffectfulCall(String)
  | UnfoldLimit(String)
  | OpaqueCall(String)
  | Division
  | NonlinearMultiplication
  | CoefficientRange
  | Lambda
  | Concat
  | BitOperator
  | DecimalArithmetic
  | Effectful
  | UndecidableMatchArm
  | NotLowered
  | DestructuringLet
  | Induction(String)
  | BoundUnshown(String)
  | UnprovedCase
  | UnreadConstruction(String)
  | ResultAssumed

pub fn blocker_parts(b: Blocker) -> { kind: String, detail: Option<String> } =
  match b {
    RecursiveCall(d) -> { kind: "recursive_call", detail: Some(d) },
    EffectfulCall(d) -> { kind: "effectful_call", detail: Some(d) },
    UnfoldLimit(d) -> { kind: "unfold_limit", detail: Some(d) },
    OpaqueCall(d) -> { kind: "opaque_call", detail: Some(d) },
    Division -> { kind: "division", detail: None },
    NonlinearMultiplication -> { kind: "nonlinear_multiplication", detail: None },
    CoefficientRange -> { kind: "coefficient_range", detail: None },
    Lambda -> { kind: "lambda", detail: None },
    Concat -> { kind: "concat", detail: None },
    BitOperator -> { kind: "bit_operator", detail: None },
    DecimalArithmetic -> { kind: "decimal_arithmetic", detail: None },
    Effectful -> { kind: "effectful", detail: None },
    UndecidableMatchArm -> { kind: "undecidable_match_arm", detail: None },
    NotLowered -> { kind: "untaken", detail: None },
    DestructuringLet -> { kind: "destructuring_let", detail: None },
    Induction(reason) -> { kind: "induction", detail: Some(reason) },
    BoundUnshown(reason) -> { kind: "unbounded", detail: Some(reason) },
    UnprovedCase -> { kind: "unclosed", detail: None },
    UnreadConstruction(t) -> { kind: "unseen_build", detail: Some(t) },
    ResultAssumed -> { kind: "answer_assumed", detail: None },
  }

pub type Lowering = {
  terms: Terms,
  rules: RuleLog,
  unfold_limit: Int,
  depth: Int,
  window: List<Option<Int>>,
  blockers: List<Blocker>,
  requirements: List<Int>,
  path: List<Int>,
  identities: Map<Int, Bool>,
  total: Map<String, Bool>,
  unrolled: Map<String, Bool>,
  equations: List<Int>,
  defined: List<Int>,
  calls: List<Int>,
  list_tails: List<{ tail: Int, from: Int }>,
  lemmas: List<Lemma>,
  facts: List<Int>,
  closures: List<Closure>,
  contracts: Map<String, Bool>,
  induction_hypothesis: Option<{ name: String, clause: Int }>,
  building: Option<{ type_name: String, by: String }>,
  built: List<Int>,
  seen: List<Span>,
  constructed: List<String>,
  tainted: List<String>,
  in_law: Bool,
  binder_terms: List<Int>,
  must_return: Bool,
  unfolds_left: Int,
  impure: Bool,
}

pub type Closure = { lambda: Lambda, window: List<Option<Int>>, pure: Bool, total: Bool }

pub type LoweredTerm = { lowering: Lowering, id: Int }

pub fn lowering(rules: RuleLog, unfold_limit: Int) -> Lowering / {abort.raise} =
  {
    terms: new_terms(),
    rules: rules,
    unfold_limit: unfold_limit,
    depth: 0,
    window: [],
    blockers: [],
    requirements: [],
    path: [],
    identities: Map::new(),
    total: Map::new(),
    unrolled: Map::new(),
    equations: [],
    defined: [],
    calls: [],
    list_tails: [],
    lemmas: [],
    facts: [],
    closures: [],
    impure: false,
    contracts: Map::new(),
    induction_hypothesis: None,
    building: None,
    built: [],
    seen: [],
    constructed: [],
    tainted: [],
    in_law: false,
    binder_terms: [],
    must_return: true,
    unfolds_left: max_unfolds(),
  }

fn lift(lowering: Lowering, made: InternedTerm) -> LoweredTerm =
  { lowering: { ..lowering, terms: made.terms }, id: made.id }

pub fn with_terms(lowering: Lowering, terms: Terms) -> Lowering = { ..lowering, terms: terms }

fn add_blocker(lowering: Lowering, b: Blocker) -> Lowering =
  { ..lowering, blockers: lowering.blockers.push(b) }

pub fn assume(lowering: Lowering, cond: Int) -> Lowering =
  { ..lowering, path: lowering.path.push(cond) }

pub fn drop_assumptions(lowering: Lowering) -> Lowering = { ..lowering, path: [] }

fn pop_assumption(lowering: Lowering) -> Lowering =
  { ..lowering, path: lowering.path.take(lowering.path.len() - 1) }

pub fn under_path(lowering: Lowering, cond: Int) -> LoweredTerm / {abort.raise} =
  range(0, lowering.path.len()).fold(
    { lowering: lowering, id: cond },
    |accumulator: LoweredTerm, k: Int| {
      let i = lowering.path.len() - 1 - k;
      match lowering.path.at(i) {
        Some(p) -> {
          let negated = not(accumulator.lowering.terms, p);
          lift(accumulator.lowering, or(negated.terms, negated.id, accumulator.id))
        },
        None -> accumulator,
      }
    },
  )

fn require(lowering: Lowering, cond: Int) -> Lowering / {abort.raise} =
  if cond == true_id() { lowering } else {
    let out = under_path(lowering, cond);
    { ..out.lowering, requirements: out.lowering.requirements.push(out.id) }
  }

fn require_unreachable(lowering: Lowering) -> Lowering / {abort.raise} =
  if lowering.must_return { require(lowering, false_id()) }
  else { add_blocker(lowering, ResultAssumed) }

fn require_int_range(lowering: Lowering, t: Int) -> Lowering / {abort.raise} =
  match node(lowering.terms, t) {
    LinearSumTerm(_) -> {
      let min = int_literal(lowering.terms, 0 - 9223372036854775807 - 1);
      let max = int_literal(min.terms, 9223372036854775807);
      let low = comparison(max.terms, Ge, t, min.id);
      let high = comparison(low.terms, Le, t, max.id);
      let both = and(high.terms, low.id, high.id);
      require(with_terms(lowering, both.terms), both.id)
    },
    _ -> lowering,
  }

fn require_divisible(lowering: Lowering, left: Int, right: Int) -> Lowering / {abort.raise} =
  match node(lowering.terms, right) {
    IntTerm(k) -> if k == 0 { require_unreachable(lowering) } else if k == 0 - 1 {
      let min = int_literal(lowering.terms, 0 - 9223372036854775807 - 1);
      let is_min = eq(min.terms, left, min.id);
      let not_min = not(is_min.terms, is_min.id);
      require(with_terms(lowering, not_min.terms), not_min.id)
    } else { lowering },
    _ -> {
      let zero = int_literal(lowering.terms, 0);
      let is_zero = eq(zero.terms, right, zero.id);
      let nonzero = not(is_zero.terms, is_zero.id);
      let nonzero_lowering = require(with_terms(lowering, nonzero.terms), nonzero.id);
      let min = int_literal(nonzero_lowering.terms, 0 - 9223372036854775807 - 1);
      let minus_one = int_literal(min.terms, 0 - 1);
      let lhs_min = eq(minus_one.terms, left, min.id);
      let rhs_minus_one = eq(lhs_min.terms, right, minus_one.id);
      let overflows = and(rhs_minus_one.terms, lhs_min.id, rhs_minus_one.id);
      let safe = not(overflows.terms, overflows.id);
      require(with_terms(nonzero_lowering, safe.terms), safe.id)
    },
  }

fn require_shift_count(lowering: Lowering, count: Int) -> Lowering / {abort.raise} = {
  let zero = int_literal(lowering.terms, 0);
  let width = int_literal(zero.terms, 63);
  let low = comparison(width.terms, Ge, count, zero.id);
  let high = comparison(low.terms, Le, count, width.id);
  let both = and(high.terms, low.id, high.id);
  require(with_terms(lowering, both.terms), both.id)
}

pub fn bind_symbolic(lowering: Lowering, ty: Sort) -> LoweredTerm / {abort.raise} =
  lift(lowering, symbol(lowering.terms, Some(ty)))

pub fn lower_root(
  lowering: Lowering,
  context: Context,
  c: Option<Code>,
  binders: List<Int>,
) -> LoweredTerm / {abort.raise} = {
  let outer = lowering.window;
  let r = lower_optional(
    { ..lowering, window: binders.map(|t: Int| Some(t)) },
    context,
    c,
    call_depth_limit(),
  );
  { lowering: { ..r.lowering, window: outer }, id: r.id }
}

fn lower_optional(
  lowering: Lowering,
  context: Context,
  c: Option<Code>,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} =
  match c {
    Some(code) -> lower(lowering, context, code, unfolds),
    None -> lift(add_blocker(lowering, NotLowered), symbol(lowering.terms, None)),
  }

fn effectful_result(lowering: Lowering, sort: Option<Sort>) -> LoweredTerm / {abort.raise} = {
  let blocked_lowering = add_blocker(require_unreachable(lowering), Effectful);
  lift({ ..blocked_lowering, impure: true }, symbol(blocked_lowering.terms, sort))
}

fn opaque_symbol(lowering: Lowering, b: Blocker) -> LoweredTerm / {abort.raise} = {
  let blocked_lowering = { ..add_blocker(lowering, b), impure: lowering.impure || b == Effectful };
  lift(blocked_lowering, symbol(blocked_lowering.terms, None))
}

fn closure(
  lowering: Lowering,
  context: Context,
  l: Lambda,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} = {
  let captured = l.captures.fold(
    { lowering: lowering, window: range(0, l.params).map(|_k: Int| None) },
    |accumulator: { lowering: Lowering, window: List<Option<Int>> }, cap: Capture| {
      let r = local(accumulator.lowering, cap.source);
      { lowering: r.lowering, window: set_slot(accumulator.window, cap.destination, r.id) }
    },
  );
  let captured_lowering = captured.lowering;
  let found = range(0, captured_lowering.closures.len()).fold(
    None,
    |accumulator: Option<Int>, k: Int|
      match accumulator {
        Some(_) -> accumulator,
        None -> match captured_lowering.closures.at(k) {
          Some(c) -> if c.lambda == l && c.window == captured.window { Some(k) } else { None },
          None -> None,
        },
      },
  );
  match found {
    Some(k) -> lift(captured_lowering, intern(captured_lowering.terms, ClosureTerm(k), None)),
    None -> {
      let fresh = range(0, l.params).fold(
        { terms: captured_lowering.terms, window: captured.window },
        |accumulator: { terms: Terms, window: List<Option<Int>> }, i: Int| {
          let x = symbol(accumulator.terms, None);
          { terms: x.terms, window: set_slot(accumulator.window, i, x.id) }
        },
      );
      let read = lower(
        {
          ..captured_lowering,
          terms: fresh.terms,
          window: fresh.window,
          requirements: [],
          path: [],
          impure: false,
          induction_hypothesis: None,
          must_return: true,
        },
        context,
        l.body,
        unfolds,
      );
      let k = read.lowering.closures.len();
      let made = intern(read.lowering.terms, ClosureTerm(k), None);
      lift(
        {
          ..captured_lowering,
          terms: made.terms,
          rules: read.lowering.rules,
          built: read.lowering.built,
          seen: read.lowering.seen,
          constructed: read.lowering.constructed,
          unfolds_left: read.lowering.unfolds_left,
          closures: read.lowering.closures.push({
            lambda: l,
            window: captured.window,
            pure: !read.lowering.impure,
            total: !read.lowering.impure && read.lowering.requirements.len() == 0,
          }),
        },
        made,
      )
    },
  }
}

fn set_slot(window: List<Option<Int>>, slot: Int, t: Int) -> List<Option<Int>> / {abort.raise} = {
  let grown = if window.len() <= slot {
    range(window.len(), slot + 1).fold(window, |w: List<Option<Int>>, _k: Int| w.push(None))
  } else { window };
  grown.set(slot, Some(t))
}

fn applied_closure(
  lowering: Lowering,
  context: Context,
  k: Int,
  head: Int,
  args: List<Int>,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} =
  match lowering.closures.at(k) {
    None -> opaque_symbol(lowering, Lambda),
    Some(c) -> if unfolds <= 0 || c.lambda.params != args.len() {
      let call_lowering = if c.total { lowering } else { require_unreachable(lowering) };
      if c.pure { lift(call_lowering, app(call_lowering.terms, head, args, None)) }
      else { lift({ ..call_lowering, impure: true }, symbol(call_lowering.terms, None)) }
    } else {
      let window = range(0, args.len()).fold(c.window, |w: List<Option<Int>>, i: Int|
        match args.at(i) { Some(a) -> set_slot(w, i, a), None -> w });
      let r = lower(
        { ..lowering, window: window, induction_hypothesis: None },
        context,
        c.lambda.body,
        unfolds - 1,
      );
      {
        lowering: {
          ..r.lowering,
          window: lowering.window,
          induction_hypothesis: lowering.induction_hypothesis,
        },
        id: r.id,
      }
    },
  }

fn function_pure(lowering: Lowering, context: Context, t: Int) -> Bool / {abort.raise} =
  match node(lowering.terms, t) {
    ClosureTerm(k) -> match lowering.closures.at(k) { Some(c) -> c.pure, None -> false },
    OpaqueTerm(name) ->
      is_pure(context, name) || is_total_builtin(name) || constructor(context, name) != None,
    _ -> match sort_of(lowering.terms, t) { Some(FunctionSort(_, _, pure)) -> pure, _ -> false },
  }

fn function_always_returns(
  lowering: Lowering,
  context: Context,
  t: Int,
  sorts: List<Option<Sort>>,
) -> Bool / {abort.raise} =
  match node(lowering.terms, t) {
    ClosureTerm(k) -> match lowering.closures.at(k) { Some(c) -> c.total, None -> false },
    OpaqueTerm(name) -> builtin_returns(context, name, sorts) || constructor(context, name) != None,
    SymbolTerm(_) ->
      lowering.in_law && lowering.binder_terms.contains(t)
        && (match sort_of(lowering.terms, t) {
          Some(FunctionSort(_, _, total)) -> total,
          _ -> false,
        }),
    _ -> false,
  }

fn effect_parameters_pure(
  lowering: Lowering,
  context: Context,
  name: String,
  args: List<Int>,
) -> Bool / {abort.raise} =
  match signature(context, name) {
    Some(s) ->
      s.pure && s.through.len() > 0
        && s.through.all(|i: Int|
          match args.at(i) { Some(a) -> function_pure(lowering, context, a), None -> false }),
    None -> false,
  }

pub fn lower(
  lowering: Lowering,
  context: Context,
  c: Code,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} =
  match c.node {
    CodeLiteral(l) -> literal(lowering, l),
    CodeVariable(v) -> {
      let s = v.slot;
      local(lowering, s)
    },
    NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) -> {
      let name = String::of_bytes_lossy(fname);
      let g = global(lowering, context, name);
      match constructor(context, name) {
        Some(k) -> if arity(k) == 0 {
          at_site(built_value(g, context, k, unfolds), lowering, c.span)
        } else { { lowering: constructing(g.lowering, context, k), id: g.id } },
        None -> g,
      }
    },
    CodeBinary(b) ->
      binary_code(lowering, context, b.operation, b.left_operand, b.right_operand, unfolds),
    CodeUnary(u) -> unary(lowering, context, u.operation, u.operand, unfolds),
    CodeLambda(l) -> closure(lowering, context, l, unfolds),
    CodeApply(a) -> application(lowering, context, a.function, a.args, unfolds),
    CodeKnownLambda(k) -> local(lowering, k.slot),
    CodeIf(i) -> {
      let cond = lower(lowering, context, i.cond, unfolds);
      let then_branch = lower(assume(cond.lowering, cond.id), context, i.then_branch, unfolds);
      let otherwise = not(then_branch.lowering.terms, cond.id);
      let else_branch = lower(
        assume(pop_assumption(with_terms(then_branch.lowering, otherwise.terms)), otherwise.id),
        context,
        i.else_branch,
        unfolds,
      );
      let joined_lowering = pop_assumption(else_branch.lowering);
      let sort = more_specific_sort(
        sort_of(joined_lowering.terms, then_branch.id),
        sort_of(joined_lowering.terms, else_branch.id),
      );
      lift(
        joined_lowering,
        intern(
          joined_lowering.terms,
          IfTerm({ cond: cond.id, then_branch: then_branch.id, else_branch: else_branch.id }),
          sort,
        ),
      )
    },
    CodeMatch(m) -> match_expression(lowering, context, m.scrutinee, m.arms, unfolds),
    CodeBlock(b) -> block(lowering, context, b.statements, b.tail, unfolds),
    CodeRecord(r) -> record(lowering, context, [], r.fields, None, unfolds),
    CodeParallel(parallel_node) ->
      recorded(
        range(0, parallel_node.branches.len()).fold(
          { lowering: lowering, out: [] },
          |accumulator: LoweredFields, i: Int|
            match parallel_node.branches.at(i) {
              Some(b) -> {
                let r = application(accumulator.lowering, context, b, [], unfolds);
                {
                  lowering: r.lowering,
                  out: accumulator.out.push({ name: "_" ++ i.to_string(), value: r.id }),
                }
              },
              None -> accumulator,
            },
        ),
      ),
    CodeUpdate(u) -> record(lowering, context, u.copied_fields, u.sets, Some(u.base), unfolds),
    CodeFieldRead(f) -> {
      let base = lower(lowering, context, f.base, unfolds);
      lift(base.lowering, field(base.lowering.terms, base.id, String::of_bytes_lossy(f.field)))
    },
    CodeList(l) -> {
      let items = l.items.fold(
        { lowering: lowering, ids: [] },
        |accumulator: { lowering: Lowering, ids: List<Int> }, x: Code| {
          let r = lower(accumulator.lowering, context, x, unfolds);
          { lowering: r.lowering, ids: accumulator.ids.push(r.id) }
        },
      );
      let sort = match items.ids.at(0) {
        Some(t) -> match sort_of(items.lowering.terms, t) {
          Some(s) -> Some(list_sort(s)),
          None -> None,
        },
        None -> None,
      };
      let empty = nil(items.lowering.terms, sort);
      let built = range(0, items.ids.len()).fold(empty, |accumulator: InternedTerm, k: Int|
        match items.ids.at(items.ids.len() - 1 - k) {
          Some(item) -> cons(accumulator.terms, item, accumulator.id, sort),
          None -> accumulator,
        });
      lift(items.lowering, built)
    },
    CodePerform(p) -> effectful_result(lowering, operation_sort(context, p.effect, p.operation)),
    CodeSimulate(_) -> effectful_result(lowering, None),
    CodeHandle(_) -> effectful_result(lowering, None),
    CodeLabel(_) -> opaque_symbol(lowering, Effectful),
  }

type LoweredFields = { lowering: Lowering, out: List<{ name: String, value: Int }> }

fn record(
  lowering: Lowering,
  context: Context,
  copies: List<Bytes>,
  sets: List<CodeField>,
  base: Option<Code>,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} = {
  let copied = copies.fold(
    { lowering: lowering, out: [] },
    |accumulator: LoweredFields, n: Bytes|
      match base {
        Some(b) -> {
          let r = lower(accumulator.lowering, context, b, unfolds);
          let read = field(r.lowering.terms, r.id, String::of_bytes_lossy(n));
          {
            lowering: with_terms(r.lowering, read.terms),
            out: accumulator.out.push({ name: String::of_bytes_lossy(n), value: read.id }),
          }
        },
        None -> accumulator,
      },
  );
  recorded(
    sets.fold(copied, |accumulator: LoweredFields, f: CodeField| {
      let r = lower(accumulator.lowering, context, f.value, unfolds);
      {
        lowering: r.lowering,
        out: accumulator.out.push({ name: String::of_bytes_lossy(f.name), value: r.id }),
      }
    }),
  )
}

fn recorded(lowered: LoweredFields) -> LoweredTerm / {abort.raise} = {
  let sorted = sorted_fields(lowered.out);
  let sort = record_sort(lowered.lowering.terms, sorted);
  lift(lowered.lowering, intern(lowered.lowering.terms, RecordTerm(sorted), sort))
}

fn sorted_fields(fields: List<{ name: String, value: Int }>) -> List<{ name: String, value: Int }> =
  fields.fold(
    [],
    |accumulator: List<{ name: String, value: Int }>, f: { name: String, value: Int }| {
      let before = accumulator.filter(|g: { name: String, value: Int }|
        compare(g.name, f.name) != Greater);
      let after = accumulator.filter(|g: { name: String, value: Int }|
        compare(g.name, f.name) == Greater);
      after.fold(
        before.push(f),
        |a: List<{ name: String, value: Int }>, g: { name: String, value: Int }| a.push(g),
      )
    },
  )

fn record_sort(terms: Terms, fields: List<{ name: String, value: Int }>) -> Option<Sort> =
  match fields.fold(
      Some([]),
      |accumulator: Option<List<{ name: String, ty: Sort }>>, f: { name: String, value: Int }|
        match accumulator {
          None -> None,
          Some(xs) -> match sort_of(terms, f.value) {
            Some(s) -> Some(xs.push({ name: f.name, ty: s })),
            None -> None,
          },
        },
    ) {
    Some(xs) -> Some(record_of(xs)),
    None -> None,
  }

fn unary(
  lowering: Lowering,
  context: Context,
  operator: Bytes,
  operand: Code,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} = {
  let t = lower(lowering, context, operand, unfolds);
  let numeric = if operator == b"neg" { operand_type(context, t.lowering.terms, t.id, t.id) }
  else { None };
  if operator == b"not" { lift(t.lowering, not(t.lowering.terms, t.id)) }
  else if numeric == Some(FloatOperand) {
    match node(t.lowering.terms, t.id) {
      FloatTerm(bits) ->
        lift(t.lowering, float_literal(t.lowering.terms, bits ^ 0 - 9223372036854775807 - 1)),
      _ -> {
        let head = opaque(t.lowering.terms, operator_float("neg"), None);
        lift(t.lowering, app(head.terms, head.id, [t.id], Some(float_sort())))
      },
    }
  } else if numeric == Some(DecimalOperand) {
    let head = opaque(t.lowering.terms, "Decimal neg", None);
    lift(t.lowering, app(head.terms, head.id, [t.id], Some(decimal_sort())))
  } else if match numeric { Some(Stated(_)) -> true, _ -> false } {
    match numeric {
      Some(Stated(n)) -> match n.functions.at(3) {
        Some(f) -> if f == "" { opaque_symbol(t.lowering, OpaqueCall(n.type_name)) }
        else { call_named(t.lowering, context, f, [t.id], unfolds) },
        None -> opaque_symbol(t.lowering, OpaqueCall(n.type_name)),
      },
      _ -> opaque_symbol(t.lowering, OpaqueCall("")),
    }
  } else if operator == b"bitnot" {
    let blocked_lowering = add_blocker(
      with_terms(t.lowering, force_int(t.lowering.terms, t.id)),
      BitOperator,
    );
    let head = opaque(blocked_lowering.terms, operator_bit_not(), None);
    let term = app(head.terms, head.id, [t.id], Some(int_sort()));
    { lowering: with_terms(blocked_lowering, force_int(term.terms, term.id)), id: term.id }
  } else if !int_operands(t.lowering.terms, t.id, t.id) {
    unknown_operator(t.lowering, operator, t.id, t.id)
  } else {
    let integer_lowering = with_terms(t.lowering, force_int(t.lowering.terms, t.id));
    match neg(integer_lowering.terms, t.id) {
      Some(out) ->
        {
          lowering: require_int_range(with_terms(integer_lowering, out.terms), out.id),
          id: out.id,
        },
      None -> {
        let unreachable_lowering = require_unreachable(
          add_blocker(integer_lowering, CoefficientRange),
        );
        lift(unreachable_lowering, symbol(unreachable_lowering.terms, Some(int_sort())))
      },
    }
  }
}

fn literal(lowering: Lowering, l: SourceLiteral) -> LoweredTerm / {abort.raise} =
  match l {
    LiteralInt(k) -> lift(lowering, int_literal(lowering.terms, k)),
    LiteralBool(b) -> lift(lowering, boolean(lowering.terms, b)),
    LiteralString(s) -> lift(lowering, string(lowering.terms, String::of_bytes_lossy(s))),
    LiteralBytes(_) -> lift(lowering, symbol(lowering.terms, Some(bytes_sort()))),
    LiteralEmbedded(_, _) -> lift(lowering, symbol(lowering.terms, Some(bytes_sort()))),
    LiteralFloat(raw) -> lift(lowering, float_literal(lowering.terms, float_literal_bits(raw))),
    LiteralDecimal(raw) ->
      lift(lowering, decimal(lowering.terms, decimal_of_raw(String::of_bytes_lossy(raw)))),
    LiteralFixed(width, bits) ->
      lift(lowering, fixed(lowering.terms, String::of_bytes_lossy(width).ascii_upper(), 0, bits)),
    LiteralWide(width, high, low) ->
      lift(lowering, fixed(lowering.terms, String::of_bytes_lossy(width).ascii_upper(), high, low)),
    LiteralChar(v) -> lift(lowering, fixed(lowering.terms, "Char", 0, v)),
    LiteralUnit -> lift(lowering, unit(lowering.terms)),
    LiteralInvalid -> lift(lowering, unit(lowering.terms)),
  }

fn decimal_of_raw(raw: String) -> Decimal / {abort.raise} = {
  let b = Bytes::of_string(raw);
  let digits = |from: Int, to: Int|
    Bytes::concat_all(
      range(from, to).map(|i: Int| {
        let c = b.at(i);
        if c >= 48 && c <= 57 { b.slice(i, i + 1) } else { b"" }
      }),
    );
  let dot = match b.index_of(b".") { Some(i) -> i, None -> b.len() };
  let whole = digits(0, dot);
  let fraction = digits(dot, b.len());
  let sign = if b.starts_with(b"-") { b"-" } else { b"" };
  let spelled = Bytes::concat_all([
    sign,
    if whole.len() == 0 { b"0" } else { whole },
    if fraction.len() == 0 { b"" } else { b"." },
    fraction,
  ]);
  match Decimal::of_string(String::of_bytes(spelled)) { Some(d) -> d, None -> Decimal::of_int(0) }
}

fn local(lowering: Lowering, slot: Int) -> LoweredTerm / {abort.raise} =
  match lowering.window.at(slot) {
    Some(Some(t)) -> { lowering: lowering, id: t },
    _ -> lift(lowering, symbol(lowering.terms, None)),
  }

fn bind(lowering: Lowering, slot: Int, t: Int) -> Lowering / {abort.raise} = {
  let grown = if lowering.window.len() <= slot {
    range(lowering.window.len(), slot + 1).fold(lowering.window, |w: List<Option<Int>>, _: Int|
      w.push(None))
  } else { lowering.window };
  { ..lowering, window: grown.set(slot, Some(t)) }
}

fn global(lowering: Lowering, context: Context, name: String) -> LoweredTerm / {abort.raise} =
  match constructor(context, name) {
    Some(c) -> if arity(c) == 0 {
      lift(
        lowering,
        intern(
          lowering.terms,
          ConstructorTerm({ name: name, args: [] }),
          Some(shift_variables(constructor_sort(c))),
        ),
      )
    } else {
      lift(
        lowering,
        intern(lowering.terms, OpaqueTerm(name), Some(shift_variables(constructor_sort(c)))),
      )
    },
    None -> match signature(context, name) {
      Some(s) -> lift(lowering, intern(lowering.terms, OpaqueTerm(name), Some(s.ty))),
      None -> match builtin(context, name) {
        Some(b) -> if is_total_builtin(name) {
          lift(lowering, opaque(lowering.terms, name, Some(b.ty)))
        } else { lift(lowering, symbol(lowering.terms, Some(b.ty))) },
        None -> if is_total_builtin(name) { lift(lowering, opaque(lowering.terms, name, None)) }
        else { lift(lowering, symbol(lowering.terms, None)) },
      },
    },
  }

type Numeric =
  | FloatOperand
  | DecimalOperand
  | Stated({ type_name: String, functions: List<String> })

fn operand_type(context: Context, terms: Terms, left: Int, right: Int) -> Option<Numeric> =
  [left, right].fold(None, |accumulator: Option<Numeric>, side: Int|
    match accumulator {
      Some(_) -> accumulator,
      None -> match sort_of(terms, side) {
        Some(NamedSort(name, args)) -> if name == "Float" && args.len() == 0 { Some(FloatOperand) }
        else if name == "Decimal" && args.len() == 0 { Some(DecimalOperand) } else {
          match context.numerics.get(name) {
            Some(functions) -> Some(Stated({ type_name: name, functions: functions })),
            None -> None,
          }
        },
        _ -> None,
      },
    })

fn binary_code(
  lowering: Lowering,
  context: Context,
  operator: Bytes,
  left: Code,
  right: Code,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} =
  if operator == b"and" || operator == b"or" {
    let l = lower(lowering, context, left, unfolds);
    let right_assumption = if operator == b"and" { { lowering: l.lowering, id: l.id } }
    else { lift(l.lowering, not(l.lowering.terms, l.id)) };
    let r = lower(assume(right_assumption.lowering, right_assumption.id), context, right, unfolds);
    binary(pop_assumption(r.lowering), context, operator, l.id, r.id, unfolds)
  } else {
    let l = lower(lowering, context, left, unfolds);
    let r = lower(l.lowering, context, right, unfolds);
    binary(r.lowering, context, operator, l.id, r.id, unfolds)
  }

fn comparison_of(operator: Bytes) -> ComparisonOperator =
  if operator == b"lt" { Lt }
  else if operator == b"le" { Le }
  else if operator == b"gt" { Gt }
  else { Ge }

fn arith_symbol(operator: Bytes) -> String =
  if operator == b"add" { operator_add() }
  else if operator == b"sub" { operator_sub() }
  else if operator == b"mul" { op_mul() }
  else if operator == b"div" { operator_div() }
  else if operator == b"rem" { op_rem() }
  else if operator == b"lt" { op_lt() }
  else if operator == b"le" { op_le() }
  else if operator == b"gt" { op_gt() }
  else { operator_ge() }

fn non_int_operator(
  lowering: Lowering,
  context: Context,
  operator: Bytes,
  left: Int,
  right: Int,
  numeric: Numeric,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} =
  match numeric {
    FloatOperand -> if is_order_comparison(operator) {
      float_order(lowering, operator, left, right)
    } else { float_arithmetic(lowering, operator, left, right) },
    DecimalOperand -> {
      let comparison = is_order_comparison(operator);
      let b = add_blocker(lowering, DecimalArithmetic);
      let blocked_lowering = if comparison { b } else { require_unreachable(b) };
      let head = opaque(blocked_lowering.terms, arith_symbol(operator), None);
      lift(
        blocked_lowering,
        app(
          head.terms,
          head.id,
          [left, right],
          Some(if comparison { bool_sort() } else { decimal_sort() }),
        ),
      )
    },
    Stated(n) ->
      stated_operator(lowering, context, operator, left, right, n.type_name, n.functions, unfolds),
  }

fn float_order(lowering: Lowering, operator: Bytes, x: Int, y: Int) -> LoweredTerm / {abort.raise} = {
  let rx = float_rank(lowering.terms, x);
  let ry = float_rank(rx.terms, y);
  let below = comparison(ry.terms, comparison_of(operator), rx.id, ry.id);
  lift(lowering, both_not_nan(below.terms, x, y, below.id))
}

fn both_not_nan(terms: Terms, x: Int, y: Int, fact: Int) -> InternedTerm / {abort.raise} = {
  let nx = float_nan(terms, x);
  let ny = float_nan(nx.terms, y);
  let not_x = not(ny.terms, nx.id);
  let not_y = not(not_x.terms, ny.id);
  let inner = both(not_y.terms, not_y.id, fact);
  both(inner.terms, not_x.id, inner.id)
}

fn both(terms: Terms, a: Int, b: Int) -> InternedTerm / {abort.raise} =
  if a == true_id() { { terms: terms, id: b } }
  else if b == true_id() { { terms: terms, id: a } }
  else if a == false_id() || b == false_id() { boolean(terms, false) }
  else { and(terms, a, b) }

fn float_arithmetic(
  lowering: Lowering,
  operator: Bytes,
  x: Int,
  y: Int,
) -> LoweredTerm / {abort.raise} =
  match ((node(lowering.terms, x), node(lowering.terms, y))) {
    (FloatTerm(a), FloatTerm(b)) -> {
      let p = Float::of_bits(a);
      let q = Float::of_bits(b);
      let r = if operator == b"add" { p + q }
      else if operator == b"sub" { p - q }
      else if operator == b"mul" { p * q }
      else if operator == b"div" { p / q }
      else { p % q };
      lift(lowering, float_literal(lowering.terms, bits_of_float(r)))
    },
    _ -> {
      let head = opaque(lowering.terms, operator_float(String::of_bytes_lossy(operator)), None);
      lift(lowering, app(head.terms, head.id, [x, y], Some(float_sort())))
    },
  }

fn stated_operator(
  lowering: Lowering,
  context: Context,
  operator: Bytes,
  left: Int,
  right: Int,
  type_name: String,
  functions: List<String>,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} =
  if is_order_comparison(operator) {
    match context.keys.get(type_name) {
      Some(by) -> {
        let kx = call_named(lowering, context, by, [left], unfolds);
        let ky = call_named(kx.lowering, context, by, [right], unfolds);
        match sort_of(ky.lowering.terms, kx.id) {
          Some(k) -> if is_named_sort(k, "Int") {
            let integer_lowering = force_ints(ky.lowering, kx.id, ky.id);
            lift(
              integer_lowering,
              comparison(integer_lowering.terms, comparison_of(operator), kx.id, ky.id),
            )
          } else if is_named_sort(k, "Float") { float_order(ky.lowering, operator, kx.id, ky.id) }
          else { opaque_symbol(ky.lowering, OpaqueCall(by)) },
          None -> opaque_symbol(ky.lowering, OpaqueCall(by)),
        }
      },
      None -> opaque_symbol(lowering, OpaqueCall(type_name)),
    }
  } else {
    let index = if operator == b"add" { 0 } else if operator == b"sub" { 1 } else { 2 };
    match functions.at(index) {
      Some(f) -> if f == "" { opaque_symbol(lowering, OpaqueCall(type_name)) }
      else { call_named(lowering, context, f, [left, right], unfolds) },
      None -> opaque_symbol(lowering, OpaqueCall(type_name)),
    }
  }

fn equal(
  lowering: Lowering,
  context: Context,
  x: Int,
  y: Int,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} = equal_within(lowering, context, x, y, unfolds, max_terms())

fn equal_within(
  lowering: Lowering,
  context: Context,
  x: Int,
  y: Int,
  unfolds: Int,
  depth_left: Int,
) -> LoweredTerm / {abort.raise} = {
  let sort = compared_sort(lowering, context, x, y);
  let key_of = |t: Int|
    match node(lowering.terms, t) {
      ConstructorTerm(c) -> match constructor(context, c.name) {
        Some(k) -> context.keys.get(k.declaration.name),
        None -> None,
      },
      _ -> match sort_of(lowering.terms, t) {
        Some(NamedSort(name, _)) -> context.keys.get(name),
        _ -> None,
      },
    };
  let keyed = match key_of(x) { Some(by) -> Some(by), None -> key_of(y) };
  match keyed {
    Some(by) -> if depth_left <= 0 { related(lowering, context, sort, x, y) } else {
      let kx = call_named(lowering, context, by, [x], unfolds);
      let ky = call_named(kx.lowering, context, by, [y], unfolds);
      equal_within(ky.lowering, context, kx.id, ky.id, unfolds, depth_left - 1)
    },
    None -> if nullary(lowering.terms, x) || nullary(lowering.terms, y) {
      lift(lowering, eq(lowering.terms, x, y))
    } else {
      match sort {
        None -> equal_by_shape(lowering, context, x, y, unfolds, depth_left),
        Some(s) -> if is_identity(context, s, lowering.identities) {
          lift(lowering, eq(lowering.terms, x, y))
        } else if depth_left <= 0 { related(lowering, context, Some(s), x, y) }
        else if is_named_sort(s, "Float") {
          let rx = float_rank(lowering.terms, x);
          let ry = float_rank(rx.terms, y);
          let same = eq(ry.terms, rx.id, ry.id);
          lift(lowering, both_not_nan(same.terms, x, y, same.id))
        } else if is_named_sort(s, "Decimal") {
          let nx = decimal_normalized(lowering.terms, x);
          let ny = decimal_normalized(nx.terms, y);
          lift(lowering, eq(ny.terms, nx.id, ny.id))
        } else { equal_by_parts(lowering, context, Some(s), x, y, unfolds, depth_left - 1) },
      }
    },
  }
}

fn compared_sort(lowering: Lowering, context: Context, x: Int, y: Int) -> Option<Sort> =
  match ((sort_of(lowering.terms, x), sort_of(lowering.terms, y))) {
    (Some(a), Some(b)) -> if a == b || !is_identity(context, a, lowering.identities) { Some(a) }
    else { Some(b) },
    (Some(a), None) -> Some(a),
    (None, b) -> b,
  }

fn nullary(terms: Terms, t: Int) -> Bool / {abort.raise} =
  match node(terms, t) {
    NilTerm -> true,
    UnitTerm -> true,
    ConstructorTerm(c) -> c.args.len() == 0,
    _ -> false,
  }

fn equal_by_shape(
  lowering: Lowering,
  context: Context,
  x: Int,
  y: Int,
  unfolds: Int,
  depth_left: Int,
) -> LoweredTerm / {abort.raise} = {
  let plain = |t: Int|
    match node(lowering.terms, t) {
      IntTerm(_) -> true,
      BoolTerm(_) -> true,
      StringTerm(_) -> true,
      FixedTerm(_, _, _) -> true,
      _ -> false,
    };
  if plain(x) || plain(y) { lift(lowering, eq(lowering.terms, x, y)) }
  else if depth_left <= 0 { related(lowering, context, None, x, y) }
  else { equal_by_parts(lowering, context, None, x, y, unfolds, depth_left - 1) }
}

fn equal_by_parts(
  lowering: Lowering,
  context: Context,
  sort: Option<Sort>,
  x: Int,
  y: Int,
  unfolds: Int,
  depth_left: Int,
) -> LoweredTerm / {abort.raise} = {
  let all = |current_lowering: Lowering, pairs: List<{ a: Int, b: Int }>|
    pairs.fold(
      lift(current_lowering, boolean(current_lowering.terms, true)),
      |accumulator: LoweredTerm, p: { a: Int, b: Int }| {
        let e = equal_within(accumulator.lowering, context, p.a, p.b, unfolds, depth_left - 1);
        lift(e.lowering, both(e.lowering.terms, accumulator.id, e.id))
      },
    );
  match sort {
    Some(RecordSort(fields)) -> {
      let read = fields.fold(
        { lowering: lowering, pairs: [] },
        |accumulator: { lowering: Lowering, pairs: List<{ a: Int, b: Int }> }, f: { name: String, ty: Sort }| {
          let fx = field(accumulator.lowering.terms, x, f.name);
          let fy = field(fx.terms, y, f.name);
          {
            lowering: with_terms(accumulator.lowering, fy.terms),
            pairs: accumulator.pairs.push({ a: fx.id, b: fy.id }),
          }
        },
      );
      all(read.lowering, read.pairs)
    },
    _ -> match ((node(lowering.terms, x), node(lowering.terms, y))) {
      (ConstructorTerm(a), ConstructorTerm(b)) -> if a.name != b.name
          || a.args.len() != b.args.len() { lift(lowering, boolean(lowering.terms, false)) } else {
        all(
          lowering,
          range(0, a.args.len()).fold([], |accumulator: List<{ a: Int, b: Int }>, i: Int|
            match ((a.args.at(i), b.args.at(i))) {
              (Some(p), Some(q)) -> accumulator.push({ a: p, b: q }),
              _ -> accumulator,
            }),
        )
      },
      (NilTerm, NilTerm) -> lift(lowering, boolean(lowering.terms, true)),
      (NilTerm, ConsTerm(_)) -> lift(lowering, boolean(lowering.terms, false)),
      (ConsTerm(_), NilTerm) -> lift(lowering, boolean(lowering.terms, false)),
      (ConsTerm(a), ConsTerm(b)) ->
        all(lowering, [{ a: a.head, b: b.head }, { a: a.tail, b: b.tail }]),
      (RecordTerm(a), RecordTerm(b)) -> if a.map(|f: { name: String, value: Int }| f.name)
          != b.map(|f: { name: String, value: Int }| f.name) {
        related(lowering, context, sort, x, y)
      } else {
        all(
          lowering,
          range(0, a.len()).fold([], |accumulator: List<{ a: Int, b: Int }>, i: Int|
            match ((a.at(i), b.at(i))) {
              (Some(p), Some(q)) -> accumulator.push({ a: p.value, b: q.value }),
              _ -> accumulator,
            }),
        )
      },
      _ -> related(lowering, context, sort, x, y),
    },
  }
}

fn related(
  lowering: Lowering,
  context: Context,
  sort: Option<Sort>,
  x: Int,
  y: Int,
) -> LoweredTerm / {abort.raise} = {
  let sorts = [sort_of(lowering.terms, x), sort_of(lowering.terms, y)];
  let resolved = sorts.filter(|s: Option<Sort>|
    match s {
      Some(t) -> !sort_variables(t, []).any(|v: Int| v >= external_variable_base()),
      None -> false,
    });
  let keyed = match resolved.at(0) {
    Some(s) -> may_call_key(context, s),
    None -> sorts.any(|s: Option<Sort>| may_call_key(context, s)),
  };
  let blocked_lowering = if keyed { require_unreachable(add_blocker(lowering, OpaqueCall("=="))) }
  else { lowering };
  let reflexive = match sort {
    Some(t) -> is_reflexive(context, t, lowering.identities),
    None -> false,
  };
  lift(blocked_lowering, intern_equality(blocked_lowering.terms, x, y, reflexive))
}

fn more_specific_sort(a: Option<Sort>, b: Option<Sort>) -> Option<Sort> =
  match a {
    Some(s) -> if sort_variables(s, []).any(|v: Int| v >= external_variable_base()) && b != None {
      b
    } else { a },
    None -> b,
  }

fn int_operands(terms: Terms, left: Int, right: Int) -> Bool =
  [left, right].any(|t: Int|
    match sort_of(terms, t) { Some(s) -> sort_variables(s, []).len() == 0, None -> false })

fn unknown_operator(
  lowering: Lowering,
  operator: Bytes,
  left: Int,
  right: Int,
) -> LoweredTerm / {abort.raise} = {
  let blocked_lowering = require_unreachable(
    add_blocker(lowering, OpaqueCall(String::of_bytes_lossy(operator))),
  );
  let head = opaque(blocked_lowering.terms, "operator " ++ String::of_bytes_lossy(operator), None);
  lift(
    blocked_lowering,
    app(head.terms, head.id, [left, right], if is_order_comparison(operator) { Some(bool_sort()) }
    else { None }),
  )
}

fn force_ints(lowering: Lowering, a: Int, b: Int) -> Lowering / {abort.raise} =
  with_terms(lowering, force_int(force_int(lowering.terms, a), b))

fn binary(
  lowering: Lowering,
  context: Context,
  operator: Bytes,
  left: Int,
  right: Int,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} =
  match if is_arithmetic(operator) || is_order_comparison(operator) {
      operand_type(context, lowering.terms, left, right)
    } else { None } {
    Some(numeric) -> non_int_operator(lowering, context, operator, left, right, numeric, unfolds),
    None -> if (is_arithmetic(operator) || is_order_comparison(operator))
        && !int_operands(lowering.terms, left, right) {
      unknown_operator(lowering, operator, left, right)
    } else if is_arithmetic(operator) {
      let integer_lowering = force_ints(lowering, left, right);
      let folded = if operator == b"add" { add(integer_lowering.terms, left, right) }
      else if operator == b"sub" { sub(integer_lowering.terms, left, right) }
      else if operator == b"mul" { mul(integer_lowering.terms, left, right) }
      else { None };
      match folded {
        Some(t) ->
          { lowering: require_int_range(with_terms(integer_lowering, t.terms), t.id), id: t.id },
        None -> {
          let literal_factor = (match node(integer_lowering.terms, left) {
              IntTerm(_) -> true,
              _ -> false,
            })
            || (match node(integer_lowering.terms, right) { IntTerm(_) -> true, _ -> false });
          let divided = operator == b"div" || operator == b"rem";
          let blocked_lowering = add_blocker(integer_lowering, if divided { Division }
          else if operator == b"mul" && !literal_factor { NonlinearMultiplication }
          else { CoefficientRange });
          let obligation_lowering = if divided { require_divisible(blocked_lowering, left, right) }
          else { require_unreachable(blocked_lowering) };
          let head = opaque(obligation_lowering.terms, arith_symbol(operator), None);
          let term = app(head.terms, head.id, [left, right], Some(int_sort()));
          { lowering: with_terms(obligation_lowering, force_int(term.terms, term.id)), id: term.id }
        },
      }
    } else if is_order_comparison(operator) {
      let integer_lowering = force_ints(lowering, left, right);
      lift(
        integer_lowering,
        comparison(integer_lowering.terms, comparison_of(operator), left, right),
      )
    } else if operator == b"and" { lift(lowering, and(lowering.terms, left, right)) }
    else if operator == b"or" { lift(lowering, or(lowering.terms, left, right)) }
    else if operator == b"eq" { equal(lowering, context, left, right, unfolds) }
    else if operator == b"ne" {
      let e = equal(lowering, context, left, right, unfolds);
      lift(e.lowering, not(e.lowering.terms, e.id))
    } else if operator == b"concat" {
      let blocked_lowering = add_blocker(lowering, Concat);
      let head = opaque(blocked_lowering.terms, operator_concat(), None);
      let sort = match sort_of(head.terms, left) {
        Some(s) -> s,
        None -> match sort_of(head.terms, right) { Some(s) -> s, None -> string_sort() },
      };
      lift(blocked_lowering, app(head.terms, head.id, [left, right], Some(sort)))
    } else {
      let blocked_lowering = add_blocker(force_ints(lowering, left, right), BitOperator);
      let shift = operator == b"shl" || operator == b"shr" || operator == b"ushr";
      let shift_lowering = if shift { require_shift_count(blocked_lowering, right) }
      else { blocked_lowering };
      let symbol = if operator == b"bitand" { operator_bit_and() }
      else if operator == b"bitor" { operator_bit_or() }
      else if operator == b"bitxor" { op_bit_xor() }
      else if operator == b"shl" { op_shl() }
      else if operator == b"shr" { op_shr() }
      else { op_ushr() };
      let head = opaque(shift_lowering.terms, symbol, None);
      let term = app(head.terms, head.id, [left, right], Some(int_sort()));
      { lowering: with_terms(shift_lowering, force_int(term.terms, term.id)), id: term.id }
    },
  }

type Callee = | Local | Named(String) | Unresolved(String) | Other

fn callee(context: Context, function: Code) -> Callee =
  match function.node {
    CodeVariable(_) -> Local,
    NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) -> {
      let name = String::of_bytes_lossy(fname);
      if constructor(context, name) != None || signature(context, name) != None { Named(name) }
      else { Unresolved(name) }
    },
    _ -> Other,
  }

fn lowered_args(
  lowering: Lowering,
  context: Context,
  args: List<Code>,
  unfolds: Int,
) -> { lowering: Lowering, ids: List<Int> } / {abort.raise} =
  args.fold(
    { lowering: lowering, ids: [] },
    |accumulator: { lowering: Lowering, ids: List<Int> }, a: Code| {
      let r = lower(accumulator.lowering, context, a, unfolds);
      { lowering: r.lowering, ids: accumulator.ids.push(r.id) }
    },
  )

fn application(
  lowering: Lowering,
  context: Context,
  function: Code,
  args: List<Code>,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} = {
  let lowered = lowered_args(lowering, context, args, unfolds);
  match function.node {
    CodeLambda(l) -> if l.params == lowered.ids.len() {
      apply_lambda(lowered.lowering, context, lowered.ids, l.captures, l.body, unfolds)
    } else { call(lowered.lowering, context, function, lowered.ids, unfolds) },
    _ -> call(lowered.lowering, context, function, lowered.ids, unfolds),
  }
}

fn apply_lambda(
  lowering: Lowering,
  context: Context,
  args: List<Int>,
  caps: List<Capture>,
  body: Code,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} = {
  let captured = caps.fold(
    { lowering: lowering, window: args.map(|t: Int| Some(t)) },
    |accumulator: { lowering: Lowering, window: List<Option<Int>> }, cap: Capture| {
      let r = local(accumulator.lowering, cap.source);
      let grown = if accumulator.window.len() <= cap.destination {
        range(accumulator.window.len(), cap.destination + 1).fold(
          accumulator.window,
          |w: List<Option<Int>>, _: Int| w.push(None),
        )
      } else { accumulator.window };
      { lowering: r.lowering, window: grown.set(cap.destination, Some(r.id)) }
    },
  );
  let r = lower(
    { ..captured.lowering, window: captured.window, induction_hypothesis: None },
    context,
    body,
    unfolds,
  );
  {
    lowering: {
      ..r.lowering,
      window: captured.lowering.window,
      induction_hypothesis: lowering.induction_hypothesis,
    },
    id: r.id,
  }
}

fn call(
  lowering: Lowering,
  context: Context,
  function: Code,
  args: List<Int>,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} = {
  let who = callee(context, function);
  let head = lower(lowering, context, function, unfolds);
  let r = call_head(head, context, who, args, unfolds);
  let applied = match who { Named(name) -> constructor(context, name) != None, _ -> false };
  if applied { at_site(r, head.lowering, function.span) } else { r }
}

fn at_site(r: LoweredTerm, before: Lowering, at: Span) -> LoweredTerm =
  if r.lowering.built.len() > before.built.len() {
    { lowering: { ..r.lowering, seen: r.lowering.seen.push(at) }, id: r.id }
  } else { r }

fn call_named(
  lowering: Lowering,
  context: Context,
  name: String,
  args: List<Int>,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} = {
  let who = if constructor(context, name) != None || signature(context, name) != None {
    Named(name)
  } else { Unresolved(name) };
  call_head(global(lowering, context, name), context, who, args, unfolds)
}

fn call_head(
  head: LoweredTerm,
  context: Context,
  who: Callee,
  args: List<Int>,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} = {
  let arg_sorts = args.map(|a: Int| sort_of(head.lowering.terms, a));
  let head_sort = match sort_of(head.lowering.terms, head.id) {
    Some(FunctionSort(params, return_type, _)) -> call_result_sort(params, arg_sorts, return_type),
    _ -> None,
  };
  let total_builtin = match who {
    Unresolved(name) -> builtin_returns(context, name, arg_sorts),
    _ -> false,
  };
  let sort = match who {
    Unresolved(name) -> match builtin(context, name) {
      Some(b) -> match b.ty {
        FunctionSort(params, return_type, _) -> call_result_sort(params, arg_sorts, return_type),
        _ -> None,
      },
      None -> head_sort,
    },
    _ -> head_sort,
  };
  let pure0 = total_builtin || head_is_pure(head.lowering.terms, head.id)
    || (match who {
      Unresolved(name) -> match builtin(context, name) { Some(b) -> b.pure, None -> false },
      _ -> false,
    });
  let opened = match node(head.lowering.terms, head.id) {
    ClosureTerm(k) -> Resolved(applied_closure(head.lowering, context, k, head.id, args, unfolds)),
    OpaqueTerm(name) -> if total_builtin { LeaveCall(pure0, head.lowering, false) } else {
      match match constructor(context, name) {
          Some(_) -> None,
          None -> list_higher_order(head.lowering, context, name, head.id, args, sort, unfolds),
        } {
        Some(r) -> Resolved(r),
        None -> match constructor(context, name) {
          Some(c) -> if arity(c) == args.len() {
            Resolved(
              built_value(
                lift(
                  head.lowering,
                  intern(
                    head.lowering.terms,
                    ConstructorTerm({ name: name, args: args }),
                    constructor_result_sort(c, args, head.lowering.terms),
                  ),
                ),
                context,
                c,
                unfolds,
              ),
            )
          } else { LeaveCall(pure0, head.lowering, false) },
          None -> {
            let instances = lemma_instances(head.lowering, context, name, args, unfolds);
            if instances.destructures_arguments && is_recursive(context, name)
                && is_pure(context, name) {
              let made = lift(
                instances.lowering,
                app(instances.lowering.terms, head.id, args, sort),
              );
              Resolved({
                lowering: { ..made.lowering, defined: made.lowering.defined.push(made.id) },
                id: made.id,
              })
            } else {
              match try_unfold(instances.lowering, context, name, head.id, sort, args, unfolds) {
                Some(r) -> Resolved(r),
                None ->
                  LeaveCall(
                    is_pure(context, name)
                      || effect_parameters_pure(instances.lowering, context, name, args),
                    note_unfold_rejection(instances.lowering, context, name),
                    instances.matched,
                  ),
              }
            }
          },
        },
      }
    },
    _ -> LeaveCall(pure0, head.lowering, false),
  };
  match opened {
    Resolved(r) -> r,
    LeaveCall(pure, call_lowering, match_pattern) -> {
      let returned = call_not_unfolded(
        call_lowering,
        context,
        who,
        head,
        args,
        sort,
        pure,
        match_pattern,
        unfolds,
      );
      if returned.lowering.tainted.len() > 0 { returned } else {
        {
          ..returned,
          lowering: assume_invariants(returned.lowering, context, [returned.id], unfolds),
        }
      }
    },
  }
}

fn call_not_unfolded(
  call_lowering: Lowering,
  context: Context,
  who: Callee,
  head: LoweredTerm,
  args: List<Int>,
  sort: Option<Sort>,
  pure: Bool,
  match_pattern: Bool,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} = {
  let total = match_pattern || callee_is_total(call_lowering, context, who, head.id, args);
  match match who {
      Named(name) -> if total || !pure { None }
      else { call_by_contract(call_lowering, context, name, head.id, args, sort, unfolds) },
      _ -> None,
    } {
    Some(r) -> r,
    None -> {
      let reachable_lowering = if !total { require_unreachable(call_lowering) }
      else { call_lowering };
      match match who {
          Unresolved(name) -> match evaluate_builtin(reachable_lowering, name, args) {
            Some(r) -> Some(r),
            None -> list_builtin(reachable_lowering, name, head.id, args),
          },
          _ -> None,
        } {
        Some(r) -> r,
        None -> if !pure {
          lift({ ..reachable_lowering, impure: true }, symbol(reachable_lowering.terms, sort))
        } else {
          let made = lift(reachable_lowering, app(reachable_lowering.terms, head.id, args, sort));
          let total_named = match who {
            Named(name) -> reachable_lowering.total.contains(name),
            _ -> false,
          };
          if total_named {
            { lowering: { ..made.lowering, calls: made.lowering.calls.push(made.id) }, id: made.id }
          } else { made }
        },
      }
    },
  }
}

type CallHeadResult = | Resolved(LoweredTerm) | LeaveCall(Bool, Lowering, Bool)

fn built_value(
  made: LoweredTerm,
  context: Context,
  c: Constructor,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} = {
  let constructing_lowering = constructing(made.lowering, context, c);
  match constructing_lowering.building {
    Some(b) -> if b.type_name != c.declaration.name || unfolds <= 0 {
      { lowering: constructing_lowering, id: made.id }
    } else {
      let checked = call_named(
        { ..constructing_lowering, building: None },
        context,
        b.by,
        [made.id],
        unfolds - 1,
      );
      let on_path = under_path(checked.lowering, checked.id);
      {
        lowering: {
          ..on_path.lowering,
          building: Some(b),
          built: on_path.lowering.built.push(on_path.id),
        },
        id: made.id,
      }
    },
    None -> { lowering: constructing_lowering, id: made.id },
  }
}

fn constructing(lowering: Lowering, context: Context, c: Constructor) -> Lowering =
  if !context.invariants.contains(c.declaration.name)
      || lowering.constructed.contains(c.declaration.name) { lowering }
  else { { ..lowering, constructed: lowering.constructed.push(c.declaration.name) } }

pub fn assume_invariants(
  lowering: Lowering,
  context: Context,
  ts: List<Int>,
  unfolds: Int,
) -> Lowering / {abort.raise} =
  if unfolds <= 0 { lowering } else {
    ts.fold(lowering, |accumulated_lowering: Lowering, t: Int|
      match sort_of(accumulated_lowering.terms, t) {
        Some(NamedSort(name, _)) -> match context.invariants.get(name) {
          Some(by) -> {
            let r = call_named(
              { ..accumulated_lowering, path: [], building: None, induction_hypothesis: None },
              context,
              by,
              [t],
              unfolds - 1,
            );
            {
              ..facts_on_path(accumulated_lowering, { ..r.lowering, facts: r.lowering.facts.push(r.id) }),
              building: accumulated_lowering.building,
              induction_hypothesis: accumulated_lowering.induction_hypothesis,
              requirements: accumulated_lowering.requirements,
              blockers: accumulated_lowering.blockers,
            }
          },
          None -> accumulated_lowering,
        },
        _ -> accumulated_lowering,
      })
  }

fn law_covers_call(
  lowering: Lowering,
  context: Context,
  declared: List<Sort>,
  terms: List<Int>,
) -> Bool =
  !declared.any(|t: Sort| contains_function(context, t))
    && !keyed_at_variable(lowering, context, declared, terms)

fn keyed_at_variable(
  lowering: Lowering,
  context: Context,
  declared: List<Sort>,
  terms: List<Int>,
) -> Bool =
  context.compared_by_key.len() > 0
    && (match range(0, declared.len()).fold(
        Some(Map::new()),
        |accumulator: Option<Map<Int, Sort>>, i: Int|
          match ((accumulator, declared.at(i), terms.at(i))) {
            (Some(m), Some(d), Some(t)) -> if sort_variables(d, []).len() == 0 { accumulator }
            else {
              match sort_of(lowering.terms, t) { Some(s) -> match_strict(d, s, m), None -> None }
            },
            _ -> accumulator,
          },
      ) {
      None -> true,
      Some(resolved) -> resolved.values().any(|s: Sort| may_call_key(context, Some(s))),
    })

fn contains_function(context: Context, ty: Sort) -> Bool = function_within(context, ty, [], 64)

fn function_within(context: Context, ty: Sort, seen: List<String>, depth_left: Int) -> Bool =
  depth_left <= 0
    || (match ty {
      SortVariable(_) -> false,
      FunctionSort(_, _, _) -> true,
      RecordSort(fields) ->
        fields.any(|f: { name: String, ty: Sort }|
          function_within(context, f.ty, seen, depth_left - 1)),
      NamedSort(n, args) ->
        args.any(|a: Sort| function_within(context, a, seen, depth_left - 1))
          || (!seen.contains(n)
          && (match context.declarations.get(n) {
            Some(declaration) ->
              declaration.variants.any(|v: Variant|
                v.fields.any(|f: Sort| function_within(context, f, seen.push(n), depth_left - 1))),
            None -> false,
          })),
    })

fn mentions_any(context: Context, ty: Sort, names: List<String>) -> Bool =
  names.len() > 0 && contains_any_name(context, ty, names, [], 64)

fn contains_any_name(
  context: Context,
  ty: Sort,
  names: List<String>,
  seen: List<String>,
  depth_left: Int,
) -> Bool =
  depth_left <= 0
    || (match ty {
      SortVariable(_) -> false,
      NamedSort(n, args) ->
        names.contains(n)
          || args.any(|a: Sort| contains_any_name(context, a, names, seen, depth_left - 1))
          || (!seen.contains(n)
          && (match context.declarations.get(n) {
            Some(declaration) ->
              declaration.variants.any(|v: Variant|
                v.fields.any(|f: Sort|
                  contains_any_name(context, f, names, seen.push(n), depth_left - 1))),
            None -> false,
          })),
      FunctionSort(params, return_type, _) ->
        params.any(|p: Sort| contains_any_name(context, p, names, seen, depth_left - 1))
          || contains_any_name(context, return_type, names, seen, depth_left - 1),
      RecordSort(fields) ->
        fields.any(|f: { name: String, ty: Sort }|
          contains_any_name(context, f.ty, names, seen, depth_left - 1)),
    })

fn call_by_contract(
  lowering: Lowering,
  context: Context,
  name: String,
  head: Int,
  args: List<Int>,
  sort: Option<Sort>,
  unfolds: Int,
) -> Option<LoweredTerm> / {abort.raise} =
  if unfolds <= 0 || !contract_applies(lowering, context, name) { None } else {
    match context.claims.definitions.get(name) {
      None -> None,
      Some(d) -> {
        let ensures = d.spec.filter(|c: ClaimClause| c.kind == EnsuresClause);
        let requires = d.spec.filter(|c: ClaimClause| c.kind == RequiresClause);
        let proved = context.claims.trusted.contains(name) || lowering.contracts.contains(name);
        let usable = |i: Int|
          proved || lowering.induction_hypothesis == Some({ name: name, clause: i });
        if !range(0, ensures.len()).any(usable) { None } else {
          let made = app(lowering.terms, head, args, sort);
          let call = made.id;
          let params = match signature(context, name) {
            Some(s) -> match s.ty { FunctionSort(ps, _, _) -> ps, _ -> [] },
            None -> [],
          };
          if keyed_at_variable(lowering, context, params, args) { None } else {
            let scratch = {
              ..with_terms(lowering, made.terms),
              path: [],
              depth: lowering.depth + 1,
              induction_hypothesis: None,
            };
            let guard = requires.fold(
              { lowering: scratch, id: true_id() },
              |accumulator: LoweredTerm, c: ClaimClause| {
                let r = lower_optional(
                  { ..accumulator.lowering, window: args.map(|t: Int| Some(t)) },
                  context,
                  Some(c.clause.code),
                  unfolds - 1,
                );
                lift(r.lowering, both(r.lowering.terms, accumulator.id, r.id))
              },
            );
            let stated = range(0, ensures.len()).fold(
              guard.lowering,
              |accumulated_lowering: Lowering, i: Int|
                if !usable(i) { accumulated_lowering } else {
                  match ensures.at(i) {
                    None -> accumulated_lowering,
                    Some(c) -> {
                      let e = lower_optional(
                        { ..accumulated_lowering, window: args.push(call).map(|t: Int| Some(t)) },
                        context,
                        Some(c.clause.code),
                        unfolds - 1,
                      );
                      let unmet = not(e.lowering.terms, guard.id);
                      let stated = or(unmet.terms, unmet.id, e.id);
                      let fact = requirements_imply(
                        with_terms(e.lowering, stated.terms),
                        lowering,
                        stated.id,
                      );
                      { ..fact.lowering, facts: fact.lowering.facts.push(fact.id) }
                    },
                  }
                },
            );
            let back = {
              ..facts_on_path(lowering, stated),
              window: lowering.window,
              depth: lowering.depth,
              induction_hypothesis: lowering.induction_hypothesis,
              requirements: lowering.requirements,
              blockers: lowering.blockers,
              rules: record_rule(stated.rules, Contract({ definition: name })),
            };
            let returning = lowering.contracts.contains(name)
              || (match lowering.induction_hypothesis { Some(i) -> i.name == name, None -> false });
            let required = require(back, guard.id);
            Some({
              lowering: if returning { required } else { require_unreachable(required) },
              id: call,
            })
          }
        }
      },
    }
  }

fn contract_applies(lowering: Lowering, context: Context, name: String) -> Bool =
  (lowering.tainted.len() == 0
    && (match lowering.induction_hypothesis { Some(i) -> i.name == name, None -> false }))
    || (terminates(context, name)
    && (match signature(context, name) {
      Some(s) ->
        !s.raises
          && (match s.ty {
            FunctionSort(params, _, _) ->
              !params.any(|p: Sort| mentions_any(context, p, lowering.tainted)),
            _ -> true,
          }),
      None -> false,
    }))

type LemmaUse = { lowering: Lowering, destructures_arguments: Bool, matched: Bool }

fn lemma_instances(
  lowering: Lowering,
  context: Context,
  name: String,
  args: List<Int>,
  unfolds: Int,
) -> LemmaUse / {abort.raise} =
  lowering.lemmas.fold(
    { lowering: lowering, destructures_arguments: false, matched: false },
    |accumulator: LemmaUse, lemma: Lemma|
      if unfolds <= 0 || lemma.function != name || lemma.args.len() != args.len()
          || lemma.typed.any(|t: Sort| mentions_any(context, t, accumulator.lowering.tainted)) {
        accumulator
      } else {
        match fitted_all(
            accumulator.lowering,
            context,
            lemma.args,
            args,
            range(0, lemma.binders).map(|_k: Int| None),
          ) {
          None -> accumulator,
          Some(binds) -> match Option::all(binds) {
            None -> accumulator,
            Some(terms) -> if !fits_types(accumulator.lowering, context, lemma, terms) {
              accumulator
            } else {
              let results = law_covers_call(accumulator.lowering, context, lemma.typed, terms);
              {
                lowering: lemma_instance(accumulator.lowering, context, lemma, terms, unfolds - 1),
                destructures_arguments: accumulator.destructures_arguments
                  || (lemma.destructures_arguments && results),
                matched: accumulator.matched || results,
              }
            },
          },
        }
      },
  )

fn fits_types(lowering: Lowering, context: Context, lemma: Lemma, terms: List<Int>) -> Bool =
  match range(0, lemma.typed.len()).fold(
      Some(Map::new()),
      |accumulator: Option<Map<Int, Sort>>, i: Int|
        match accumulator {
          None -> None,
          Some(m) -> match ((lemma.typed.at(i), terms.at(i))) {
            (Some(declared), Some(t)) -> match sort_of(lowering.terms, t) {
              Some(actual) -> match_strict(declared, actual, m),
              None -> None,
            },
            _ -> None,
          },
        },
    ) {
    None -> false,
    Some(resolved) ->
      lemma.identity_variables.all(|v: Int|
        match resolved.get(v) {
          Some(s) -> is_identity(context, s, lowering.identities),
          None -> false,
        }),
  }

fn fitted_all(
  lowering: Lowering,
  context: Context,
  patterns: List<Code>,
  ts: List<Int>,
  binds: List<Option<Int>>,
) -> Option<List<Option<Int>>> / {abort.raise} =
  if patterns.len() != ts.len() { None } else {
    range(0, patterns.len()).fold(Some(binds), |accumulator: Option<List<Option<Int>>>, i: Int|
      match accumulator {
        None -> None,
        Some(bs) -> match ((patterns.at(i), ts.at(i))) {
          (Some(p), Some(t)) -> match_pattern(lowering, context, p, t, bs),
          _ -> None,
        },
      })
  }

fn match_pattern(
  lowering: Lowering,
  context: Context,
  pattern: Code,
  t: Int,
  binds: List<Option<Int>>,
) -> Option<List<Option<Int>>> / {abort.raise} =
  match pattern.node {
    CodeVariable(v) -> {
      let k = v.slot;
      match binds.at(k) {
        Some(Some(u)) -> if u == t { Some(binds) } else { None },
        Some(None) -> Some(binds.set(k, Some(t))),
        None -> None,
      }
    },
    NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) -> if global(
          lowering,
          context,
          String::of_bytes_lossy(fname),
        ).id
        == t { Some(binds) }
    else { None },
    CodeLiteral(l) -> if literal(lowering, l).id == t { Some(binds) } else { None },
    CodeApply(a) -> match read_name(a.function) {
      Some(f) -> {
        let name = String::of_bytes_lossy(f);
        match node(lowering.terms, t) {
          ApplicationTerm(called) -> match node(lowering.terms, called.head) {
            OpaqueTerm(h) -> if h == name {
              fitted_all(lowering, context, a.args, called.args, binds)
            } else { None },
            _ -> None,
          },
          ConstructorTerm(k) -> if k.name == name {
            fitted_all(lowering, context, a.args, k.args, binds)
          } else { None },
          _ -> None,
        }
      },
      None -> None,
    },
    CodeList(l) -> {
      let s = spine(lowering.terms, t);
      match node(lowering.terms, s.end) {
        NilTerm -> fitted_all(lowering, context, l.items, s.heads, binds),
        _ -> None,
      }
    },
    _ -> None,
  }

fn lemma_instance(
  lowering: Lowering,
  context: Context,
  lemma: Lemma,
  terms: List<Int>,
  unfolds: Int,
) -> Lowering / {abort.raise} = {
  let r = lower(
    {
      ..lowering,
      window: terms.map(|t: Int| Some(t)),
      path: [],
      depth: lowering.depth + 1,
      lemmas: [],
      induction_hypothesis: None,
    },
    context,
    lemma.body,
    unfolds,
  );
  let alike = law_covers_call(lowering, context, lemma.typed, terms);
  let fact = requirements_imply(r.lowering, if alike { lowering } else { r.lowering }, r.id);
  {
    ..facts_on_path(lowering, { ..fact.lowering, facts: fact.lowering.facts.push(fact.id) }),
    window: lowering.window,
    depth: lowering.depth,
    induction_hypothesis: lowering.induction_hypothesis,
    lemmas: lowering.lemmas,
    requirements: lowering.requirements,
    blockers: lowering.blockers,
    calls: lowering.calls,
    defined: if alike { r.lowering.defined.concat(r.lowering.calls.drop(lowering.calls.len())) }
    else { r.lowering.defined },
    rules: record_rule(fact.lowering.rules, Cited({ law: lemma.law, label: lemma.label })),
  }
}

fn facts_on_path(before: Lowering, after: Lowering) -> Lowering / {abort.raise} = {
  let stated = after.facts.drop(before.facts.len()).fold(
    { lowering: { ..after, path: before.path }, ids: [] },
    |accumulator: { lowering: Lowering, ids: List<Int> }, f: Int| {
      let u = under_path(accumulator.lowering, f);
      { lowering: u.lowering, ids: accumulator.ids.push(u.id) }
    },
  );
  { ..stated.lowering, facts: before.facts.concat(stated.ids) }
}

fn requirements_imply(
  lowering: Lowering,
  requirement_lowering: Lowering,
  fact: Int,
) -> LoweredTerm / {abort.raise} = {
  let requirements = requirement_lowering.requirements.fold(
    lift(lowering, boolean(lowering.terms, true)),
    |accumulator: LoweredTerm, r: Int|
      lift(accumulator.lowering, both(accumulator.lowering.terms, accumulator.id, r)),
  );
  let unmet = not(requirements.lowering.terms, requirements.id);
  lift(requirements.lowering, or(unmet.terms, unmet.id, fact))
}

fn evaluate_builtin(
  lowering: Lowering,
  name: String,
  args: List<Int>,
) -> Option<LoweredTerm> / {abort.raise} = {
  let float_at = |i: Int|
    match args.at(i) {
      Some(t) -> match node(lowering.terms, t) {
        FloatTerm(bits) -> Some(Float::of_bits(bits)),
        _ -> None,
      },
      None -> None,
    };
  let int_at = |i: Int|
    match args.at(i) {
      Some(t) -> match node(lowering.terms, t) { IntTerm(k) -> Some(k), _ -> None },
      None -> None,
    };
  let float = |f: Float| Some(lift(lowering, float_literal(lowering.terms, bits_of_float(f))));
  let one = |operation: (Float) -> Float|
    match float_at(0) { Some(x) -> float(operation(x)), None -> None };
  let two = |operation: (Float, Float) -> Float|
    match ((float_at(0), float_at(1))) { (Some(x), Some(y)) -> float(operation(x, y)), _ -> None };
  if name == "Float::sqrt" { one(Float::sqrt) }
  else if name == "Float::exp" { one(Float::exp) }
  else if name == "Float::ln" { one(Float::ln) }
  else if name == "Float::log2" { one(Float::log2) }
  else if name == "Float::log10" { one(Float::log10) }
  else if name == "Float::sin" { one(Float::sin) }
  else if name == "Float::cos" { one(Float::cos) }
  else if name == "Float::tan" { one(Float::tan) }
  else if name == "Float::asin" { one(Float::asin) }
  else if name == "Float::acos" { one(Float::acos) }
  else if name == "Float::atan" { one(Float::atan) }
  else if name == "Float::floor" { one(Float::floor) }
  else if name == "Float::ceil" { one(Float::ceil) }
  else if name == "Float::pow" { two(Float::pow) }
  else if name == "Float::atan2" { two(Float::atan2) }
  else if name == "Float::hypot" { two(Float::hypot) } else if name == "Float::of_int" {
    match int_at(0) { Some(k) -> float(Float::of_int(k)), None -> None }
  } else if name == "Float::of_bits" {
    match int_at(0) { Some(k) -> float(Float::of_bits(k)), None -> None }
  } else if name == "bits_of_float" {
    match float_at(0) {
      Some(x) -> Some(lift(lowering, int_literal(lowering.terms, bits_of_float(x)))),
      None -> None,
    }
  } else { None }
}

fn list_builtin(
  lowering: Lowering,
  name: String,
  head: Int,
  args: List<Int>,
) -> Option<LoweredTerm> / {abort.raise} =
  match args {
    [xs] -> if name == "List::len" { list_len(lowering, head, xs) } else { None },
    [xs, x] -> if name == "List::push" { list_push(lowering, head, xs, x) } else { None },
    _ -> None,
  }

fn list_higher_order(
  lowering: Lowering,
  context: Context,
  name: String,
  head: Int,
  args: List<Int>,
  sort: Option<Sort>,
  unfolds: Int,
) -> Option<LoweredTerm> / {abort.raise} =
  match args {
    [xs, f] -> if name == prelude_list("map") {
      mapped(lowering, context, name, head, xs, f, sort, unfolds)
    } else if name == prelude_list("filter") {
      filtered(lowering, context, name, head, xs, f, unfolds)
    } else { None },
    [xs, init, f] -> if name == prelude_list("fold") {
      folded(lowering, context, name, head, xs, init, f, sort, unfolds)
    } else { None },
    _ -> None,
  }

pub fn prelude_list(operation: String) -> String = "std.prelude.List::" ++ operation

fn apply_function(
  lowering: Lowering,
  context: Context,
  f: Int,
  args: List<Int>,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} =
  if unfolds <= 0 {
    let sorts = args.map(|a: Int| sort_of(lowering.terms, a));
    let checked_lowering = if function_always_returns(lowering, context, f, sorts) { lowering }
    else { require_unreachable(lowering) };
    if function_pure(lowering, context, f) {
      lift(checked_lowering, app(checked_lowering.terms, f, args, None))
    } else { lift({ ..checked_lowering, impure: true }, symbol(checked_lowering.terms, None)) }
  } else {
    match node(lowering.terms, f) {
      ClosureTerm(k) -> applied_closure(lowering, context, k, f, args, unfolds - 1),
      OpaqueTerm(name) -> call_named(lowering, context, name, args, unfolds - 1),
      _ -> call_head({ lowering: lowering, id: f }, context, Local, args, unfolds - 1),
    }
  }

fn remainder(
  lowering: Lowering,
  context: Context,
  name: String,
  head: Int,
  args: List<Int>,
  sort: Option<Sort>,
) -> LoweredTerm / {abort.raise} = {
  let f = match args.at(args.len() - 1) { Some(t) -> t, None -> 0 };
  let sorts = args.take(args.len() - 1).map(|a: Int| sort_of(lowering.terms, a));
  let checked_lowering = if function_always_returns(lowering, context, f, sorts) { lowering }
  else { require_unreachable(lowering) };
  if function_pure(lowering, context, f) {
    lift(checked_lowering, app(checked_lowering.terms, head, args, sort))
  } else { lift({ ..checked_lowering, impure: true }, symbol(checked_lowering.terms, sort)) }
}

fn mapped(
  lowering: Lowering,
  context: Context,
  name: String,
  head: Int,
  xs: Int,
  f: Int,
  sort: Option<Sort>,
  unfolds: Int,
) -> Option<LoweredTerm> / {abort.raise} = {
  let s = spine(lowering.terms, xs);
  let at_nil = match node(lowering.terms, s.end) { NilTerm -> true, _ -> false };
  if s.heads.len() == 0 && !at_nil { Some(remainder(lowering, context, name, head, [xs, f], sort)) }
  else {
    let applied = s.heads.fold(
      { lowering: lowering, ids: [] },
      |accumulator: { lowering: Lowering, ids: List<Int> }, h: Int| {
        let r = apply_function(accumulator.lowering, context, f, [h], unfolds);
        { lowering: r.lowering, ids: accumulator.ids.push(r.id) }
      },
    );
    let out = match sort {
      Some(t) -> Some(t),
      None -> match applied.ids.at(0) {
        Some(first) -> match sort_of(applied.lowering.terms, first) {
          Some(e) -> Some(list_sort(e)),
          None -> None,
        },
        None -> None,
      },
    };
    let tail = if at_nil { lift(applied.lowering, nil(applied.lowering.terms, out)) }
    else { remainder(applied.lowering, context, name, head, [s.end, f], out) };
    Some(consed(tail, applied.ids, out))
  }
}

fn consed(tail: LoweredTerm, items: List<Int>, sort: Option<Sort>) -> LoweredTerm / {abort.raise} =
  range(0, items.len()).fold(tail, |accumulator: LoweredTerm, k: Int|
    match items.at(items.len() - 1 - k) {
      Some(item) ->
        lift(accumulator.lowering, cons(accumulator.lowering.terms, item, accumulator.id, sort)),
      None -> accumulator,
    })

fn filtered(
  lowering: Lowering,
  context: Context,
  name: String,
  head: Int,
  xs: Int,
  f: Int,
  unfolds: Int,
) -> Option<LoweredTerm> / {abort.raise} = {
  let s = spine(lowering.terms, xs);
  let at_nil = match node(lowering.terms, s.end) { NilTerm -> true, _ -> false };
  let sort = sort_of(lowering.terms, xs);
  if s.heads.len() == 0 && !at_nil { Some(remainder(lowering, context, name, head, [xs, f], sort)) }
  else {
    let tested = s.heads.fold(
      { lowering: lowering, ids: [] },
      |accumulator: { lowering: Lowering, ids: List<Int> }, h: Int| {
        let r = apply_function(accumulator.lowering, context, f, [h], unfolds);
        { lowering: r.lowering, ids: accumulator.ids.push(r.id) }
      },
    );
    let tail = if at_nil { lift(tested.lowering, nil(tested.lowering.terms, sort)) }
    else { remainder(tested.lowering, context, name, head, [s.end, f], sort) };
    Some(
      range(0, s.heads.len()).fold(tail, |accumulator: LoweredTerm, k: Int| {
        let i = s.heads.len() - 1 - k;
        match ((s.heads.at(i), tested.ids.at(i))) {
          (Some(h), Some(c)) -> {
            let kept_cell = cons(accumulator.lowering.terms, h, accumulator.id, sort);
            lift(
              accumulator.lowering,
              intern(
                kept_cell.terms,
                IfTerm({ cond: c, then_branch: kept_cell.id, else_branch: accumulator.id }),
                sort,
              ),
            )
          },
          _ -> accumulator,
        }
      }),
    )
  }
}

fn folded(
  lowering: Lowering,
  context: Context,
  name: String,
  head: Int,
  xs: Int,
  init: Int,
  f: Int,
  sort: Option<Sort>,
  unfolds: Int,
) -> Option<LoweredTerm> / {abort.raise} = {
  let s = spine(lowering.terms, xs);
  let at_nil = match node(lowering.terms, s.end) { NilTerm -> true, _ -> false };
  if s.heads.len() == 0 && !at_nil {
    Some(remainder(lowering, context, name, head, [xs, init, f], sort))
  } else {
    let stepped = s.heads.fold(
      { lowering: lowering, id: init },
      |accumulator: LoweredTerm, h: Int|
        apply_function(accumulator.lowering, context, f, [accumulator.id, h], unfolds),
    );
    if at_nil { Some(stepped) } else {
      Some(
        remainder(stepped.lowering, context, name, head, [s.end, stepped.id, f], match sort {
          Some(t) -> Some(t),
          None -> sort_of(stepped.lowering.terms, stepped.id),
        }),
      )
    }
  }
}

fn spine(terms: Terms, xs: Int) -> { heads: List<Int>, end: Int } / {abort.raise} =
  iterate({ heads: [], end: xs }, size(terms) + 1, |s: { heads: List<Int>, end: Int }|
    match node(terms, s.end) {
      ConsTerm(c) -> Continue({ heads: s.heads.push(c.head), end: c.tail }),
      _ -> Stop(s),
    })

fn list_len(lowering: Lowering, head: Int, xs: Int) -> Option<LoweredTerm> / {abort.raise} = {
  let s = spine(lowering.terms, unmapped(lowering.terms, xs));
  let end = unmapped(lowering.terms, s.end);
  match node(lowering.terms, s.end) {
    NilTerm -> Some(lift(lowering, int_literal(lowering.terms, s.heads.len()))),
    _ -> if s.heads.len() == 0 && end == xs { None } else if s.heads.len() == 0 {
      let made = app(lowering.terms, head, [end], Some(int_sort()));
      Some({ lowering: with_terms(lowering, force_int(made.terms, made.id)), id: made.id })
    } else {
      let rest = app(lowering.terms, head, [end], Some(int_sort()));
      let k = int_literal(rest.terms, s.heads.len());
      match add(k.terms, k.id, rest.id) {
        Some(sum) ->
          Some({
            lowering: require_int_range(with_terms(lowering, sum.terms), sum.id),
            id: sum.id,
          }),
        None -> None,
      }
    },
  }
}

fn unmapped(terms: Terms, xs: Int) -> Int / {abort.raise} =
  match node(terms, xs) {
    ApplicationTerm(a) -> match ((node(terms, a.head), a.args)) {
      (OpaqueTerm(name), [inner, _]) -> if name == prelude_list("map") { inner } else { xs },
      _ -> xs,
    },
    _ -> xs,
  }

fn list_push(
  lowering: Lowering,
  head: Int,
  xs: Int,
  x: Int,
) -> Option<LoweredTerm> / {abort.raise} = {
  let sort = sort_of(lowering.terms, xs);
  let s = spine(lowering.terms, xs);
  let at_nil = match node(lowering.terms, s.end) { NilTerm -> true, _ -> false };
  if !at_nil && s.heads.len() == 0 { None } else {
    let last = if at_nil {
      let empty = nil(lowering.terms, sort);
      cons(empty.terms, x, empty.id, sort)
    } else { app(lowering.terms, head, [s.end, x], sort) };
    let built = range(0, s.heads.len()).fold(last, |accumulator: InternedTerm, k: Int|
      match s.heads.at(s.heads.len() - 1 - k) {
        Some(h) -> cons(accumulator.terms, h, accumulator.id, sort),
        None -> accumulator,
      });
    Some(lift(lowering, built))
  }
}

fn callee_is_total(
  lowering: Lowering,
  context: Context,
  who: Callee,
  head: Int,
  args: List<Int>,
) -> Bool / {abort.raise} =
  match who {
    Local ->
      function_always_returns(
        lowering,
        context,
        head,
        args.map(|a: Int| sort_of(lowering.terms, a)),
      ),
    Named(name) -> constructor(context, name) != None || lowering.total.contains(name),
    Unresolved(name) ->
      builtin_returns(context, name, args.map(|a: Int| sort_of(lowering.terms, a))),
    Other -> false,
  }

fn builtin_returns(context: Context, name: String, sorts: List<Option<Sort>>) -> Bool =
  is_total_builtin(name)
    && !((name == "min" || name == "max" || name.starts_with("Map::"))
      && sorts.any(|s: Option<Sort>| may_call_key(context, s)))

fn head_is_pure(terms: Terms, head: Int) -> Bool =
  match sort_of(terms, head) { Some(FunctionSort(_, _, pure)) -> pure, _ -> false }

fn note_unfold_rejection(lowering: Lowering, context: Context, name: String) -> Lowering =
  add_blocker(
    lowering,
    if lowering.depth >= lowering.unfold_limit || lowering.unfolds_left <= 0
        || size(lowering.terms) >= max_terms() { UnfoldLimit(name) }
    else if is_recursive(context, name) { RecursiveCall(name) }
    else if !is_pure(context, name) { EffectfulCall(name) }
    else { OpaqueCall(name) },
  )

pub fn smaller_than(lowering: Lowering, t: Int, root: Int) -> Bool =
  range(0, lowering.list_tails.len() + 1).fold(
      { at: t, found: None },
      |st: { at: Int, found: Option<Bool> }, _: Int|
        match st.found {
          Some(_) -> st,
          None -> match lowering.list_tails.fold(
              None,
              |accumulator: Option<Int>, s: { tail: Int, from: Int }|
                match accumulator {
                  Some(_) -> accumulator,
                  None -> if s.tail == st.at { Some(s.from) } else { None },
                },
            ) {
            None -> { at: st.at, found: Some(false) },
            Some(from) -> if from == root { { at: from, found: Some(true) } }
            else { { at: from, found: None } },
          },
        },
    ).found
    == Some(true)

fn try_unfold(
  lowering: Lowering,
  context: Context,
  name: String,
  head: Int,
  sort: Option<Sort>,
  args: List<Int>,
  unfolds: Int,
) -> Option<LoweredTerm> / {abort.raise} =
  if unfolds <= 0 || lowering.unfolds_left <= 0 || size(lowering.terms) >= max_terms() { None }
  else {
    let unrolling = lowering.unrolled.contains(name);
    let whole = args.fold(true, |all: Bool, a: Int| all && has_known_structure(lowering.terms, a));
    let over_view = !unrolling && is_recursive(context, name) && terminates(context, name)
      && args.any(|a: Int| has_known_structure(lowering.terms, a) && !is_literal(lowering.terms, a))
      && args.all(|a: Int|
        has_known_structure(lowering.terms, a) || scalar(context, sort_of(lowering.terms, a)));
    if !over_view && lowering.depth >= lowering.unfold_limit { None }
    else if unrolling && lowering.depth >= 1 && !whole { None } else {
      match match unfoldable(context, name) {
          Some(d) -> Some(d),
          None -> if unrolling { self_recursive(context, name) }
          else if over_view { recursive_body(context, name) }
          else { None },
        } {
        None -> None,
        Some(definition) -> if definition.params != args.len() { None } else {
          let deeper = if over_view { lowering.depth } else { lowering.depth + 1 };
          let deeper_lowering = {
            ..lowering,
            rules: record_unfold(lowering.rules, name, deeper),
            depth: deeper,
            unfolds_left: lowering.unfolds_left - 1,
          };
          let outer = deeper_lowering.window;
          let r = lower_optional(
            { ..deeper_lowering, window: args.map(|t: Int| Some(t)) },
            context,
            definition.body,
            unfolds - 1,
          );
          let typed = match sort {
            Some(t) -> if sort_of(r.lowering.terms, r.id) == None {
              intern(r.lowering.terms, node(r.lowering.terms, r.id), Some(t)).terms
            } else { r.lowering.terms },
            None -> r.lowering.terms,
          };
          let back = { ..r.lowering, terms: typed, window: outer, depth: lowering.depth };
          if unrolling {
            let c = app(back.terms, head, args, sort);
            let equation = eq(c.terms, c.id, r.id);
            Some({
              lowering: {
                ..with_terms(back, equation.terms),
                equations: back.equations.push(equation.id),
                defined: back.defined.push(c.id),
              },
              id: r.id,
            })
          } else { Some({ lowering: back, id: r.id }) }
        },
      }
    }
  }

fn scalar(context: Context, sort: Option<Sort>) -> Bool =
  match sort {
    Some(NamedSort(name, [])) -> !context.declarations.contains(name),
    Some(FunctionSort(_, _, _)) -> true,
    _ -> false,
  }

fn has_known_structure(terms: Terms, t: Int) -> Bool / {abort.raise} =
  seen_whole(terms, t, size(terms))

fn seen_whole(terms: Terms, t: Int, depth_left: Int) -> Bool / {abort.raise} =
  if depth_left <= 0 { false } else {
    match node(terms, t) {
      IntTerm(_) -> true,
      BoolTerm(_) -> true,
      StringTerm(_) -> true,
      DecimalTerm(_) -> true,
      FloatTerm(_) -> true,
      FixedTerm(_, _, _) -> true,
      UnitTerm -> true,
      ClosureTerm(_) -> true,
      NilTerm -> true,
      ConsTerm(c) -> seen_whole(terms, c.tail, depth_left - 1),
      ConstructorTerm(c) ->
        c.args.fold(true, |all: Bool, a: Int| all && seen_whole(terms, a, depth_left - 1)),
      _ -> false,
    }
  }

fn block(
  lowering: Lowering,
  context: Context,
  statements: List<CodeStatement>,
  tail: Option<Code>,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} = {
  let after = statements.fold(lowering, |accumulator: Lowering, st: CodeStatement|
    match st {
      CodeLet(l) -> {
        let r = lower(accumulator, context, l.value, unfolds);
        bind(r.lowering, l.slot, r.id)
      },
      CodeLetDestructure(l) -> match l.pattern {
        CodeWildcardPattern -> lower(accumulator, context, l.value, unfolds).lowering,
        CodeBindingPattern(v) -> {
          let r = lower(accumulator, context, l.value, unfolds);
          {
            let s = v.slot;
            bind(r.lowering, s, r.id)
          }
        },
        pattern -> {
          let r = lower(accumulator, context, l.value, unfolds);
          match destructured(r.lowering, pattern, r.id) {
            Some(bound) -> bound,
            None -> {
              bind_opaque(add_blocker(require_unreachable(r.lowering), DestructuringLet), pattern)
            },
          }
        },
      },
      CodeDo(d) -> lower(accumulator, context, d.code, unfolds).lowering,
    });
  match tail {
    Some(t) -> lower(after, context, t, unfolds),
    None -> lift(after, unit(after.terms)),
  }
}

fn destructured(
  lowering: Lowering,
  pattern: CodePattern,
  t: Int,
) -> Option<Lowering> / {abort.raise} =
  match pattern {
    CodeWildcardPattern -> Some(lowering),
    CodeBindingPattern(v) -> {
      let slot = v.slot;
      Some(bind(lowering, slot, t))
    },
    CodeRecordPattern(r) ->
      r.fields.fold(Some(lowering), |accumulator: Option<Lowering>, f: CodePatternField|
        match accumulator {
          None -> None,
          Some(current) -> {
            let read = field(current.terms, t, String::of_bytes_lossy(f.name));
            destructured(with_terms(current, read.terms), f.pattern, read.id)
          },
        }),
    _ -> None,
  }

fn bind_opaque(lowering: Lowering, pattern: CodePattern) -> Lowering / {abort.raise} =
  pattern_slots(pattern).fold(lowering, |accumulator: Lowering, slot: Int| {
    let t = symbol(accumulator.terms, None);
    bind(with_terms(accumulator, t.terms), slot, t.id)
  })

fn pattern_slots(p: CodePattern) -> List<Int> / {abort.raise} =
  iterate({ stack: [p], out: [] }, 1000000, |s: { stack: List<CodePattern>, out: List<Int> }|
    match s.stack.at(s.stack.len() - 1) {
      None -> Stop(s),
      Some(top) -> {
        let rest = s.stack.take(s.stack.len() - 1);
        Continue(match top {
          CodeBindingPattern(v) ->
            {
              stack: rest,
              out: {
                let slot = v.slot;
                s.out.push(slot)
              },
            },
          CodeConstructorPattern(c) ->
            {
              stack: c.args.fold(rest, |accumulator: List<CodePattern>, a: CodePattern|
                accumulator.push(a)),
              out: s.out,
            },
          CodeRecordPattern(r) ->
            {
              stack: r.fields.fold(rest, |accumulator: List<CodePattern>, f: CodePatternField|
                accumulator.push(f.pattern)),
              out: s.out,
            },
          CodeListPattern(l) -> {
            let items = l.items.fold(rest, |accumulator: List<CodePattern>, a: CodePattern|
              accumulator.push(a));
            { stack: match l.rest { Some(r) -> items.push(r), None -> items }, out: s.out }
          },
          _ -> { stack: rest, out: s.out },
        })
      },
    }).out

fn match_expression(
  lowering: Lowering,
  context: Context,
  scrutinee: Code,
  arms: List<CodeArm>,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} = {
  let s = lower(lowering, context, scrutinee, unfolds);
  let s_sort = sort_of(s.lowering.terms, s.id);
  match taken_in_view(s.lowering, context, s.id, arms) {
    Some(arm) -> {
      let entered = match arm.pattern {
        CodeRecordPattern(_) -> match destructured(s.lowering, arm.pattern, s.id) {
          Some(bound) -> bound,
          None -> s.lowering,
        },
        CodeConstructorPattern(c) -> match node(s.lowering.terms, s.id) {
          ConstructorTerm(k) ->
            range(0, c.args.len()).fold(s.lowering, |accumulator: Lowering, i: Int|
              match ((c.args.at(i), k.args.at(i))) {
                (Some(CodeBindingPattern(v)), Some(field)) -> {
                  let slot = v.slot;
                  bind(accumulator, slot, field)
                },
                _ -> accumulator,
              }),
          _ -> s.lowering,
        },
        _ -> match arm_shape(s.lowering, context, arm.pattern, s.id, s_sort) {
          Some(shaped) -> shaped.lowering,
          None -> s.lowering,
        },
      };
      lower(entered, context, arm.body, unfolds)
    },
    None -> arms_of(s, s_sort, context, arms, unfolds),
  }
}

fn taken_in_view(
  lowering: Lowering,
  context: Context,
  scrutinee: Int,
  arms: List<CodeArm>,
) -> Option<CodeArm> / {abort.raise} = {
  let found = arms.fold(
    { arm: None, open: false },
    |accumulator: { arm: Option<CodeArm>, open: Bool }, a: CodeArm|
      if accumulator.open || accumulator.arm != None { accumulator } else {
        match a.guard {
          Some(_) -> { arm: None, open: true },
          None -> match fits(lowering, context, a.pattern, scrutinee) {
            Some(true) -> { arm: Some(a), open: false },
            Some(false) -> accumulator,
            None -> { arm: None, open: true },
          },
        }
      },
  );
  found.arm
}

fn fits(
  lowering: Lowering,
  context: Context,
  p: CodePattern,
  t: Int,
) -> Option<Bool> / {abort.raise} =
  match p {
    CodeWildcardPattern -> Some(true),
    CodeBindingPattern(_) -> Some(true),
    CodeLiteralPattern(l) -> if !is_literal(lowering.terms, t) || !identity_literal(l) { None }
    else { Some(literal(lowering, l).id == t) },
    CodeRangePattern(_) -> None,
    CodeConstructorPattern(c) -> match node(lowering.terms, t) {
      ConstructorTerm(k) -> if k.name != String::of_bytes_lossy(c.name) { Some(false) }
      else if k.args.len() == c.args.len()
          && c.args.fold(true, |ok: Bool, a: CodePattern| ok && irrefutable(a)) { Some(true) }
      else { None },
      _ -> None,
    },
    CodeListPattern(l) -> if !l.items.fold(true, |ok: Bool, a: CodePattern| ok && irrefutable(a))
        || !(match l.rest { Some(r) -> irrefutable(r), None -> true }) { None } else {
      let s = spine(lowering.terms, t);
      let ended = match node(lowering.terms, s.end) { NilTerm -> true, _ -> false };
      if s.heads.len() < l.items.len() { if ended { Some(false) } else { None } }
      else if l.rest != None { Some(true) }
      else if s.heads.len() > l.items.len() { Some(false) }
      else if ended { Some(true) }
      else { None }
    },
    CodeRecordPattern(_) -> if irrefutable(p) { Some(true) } else { None },
  }

fn identity_literal(l: SourceLiteral) -> Bool =
  match l { LiteralFloat(_) -> false, LiteralDecimal(_) -> false, _ -> true }

fn is_literal(terms: Terms, t: Int) -> Bool / {abort.raise} =
  match node(terms, t) {
    IntTerm(_) -> true,
    BoolTerm(_) -> true,
    StringTerm(_) -> true,
    DecimalTerm(_) -> true,
    FloatTerm(_) -> true,
    FixedTerm(_, _, _) -> true,
    UnitTerm -> true,
    _ -> false,
  }

fn arms_of(
  s: LoweredTerm,
  s_sort: Option<Sort>,
  context: Context,
  arms: List<CodeArm>,
  unfolds: Int,
) -> LoweredTerm / {abort.raise} = {
  let walked = arms.fold(
    { lowering: s.lowering, arms: [], sort: None },
    |accumulator: { lowering: Lowering, arms: List<Arm>, sort: Option<Sort> }, a: CodeArm| {
      let shaped = match a.guard {
        Some(_) -> None,
        None -> arm_shape(accumulator.lowering, context, a.pattern, s.id, s_sort),
      };
      let tested = match shaped {
        Some(sh) -> sh,
        None ->
          {
            lowering: bind_opaque(
              add_blocker(accumulator.lowering, UndecidableMatchArm),
              a.pattern,
            ),
            test: Undecidable,
            binds: [],
          },
      };
      let guarded = match a.guard {
        Some(g) -> lower(tested.lowering, context, g, unfolds).lowering,
        None -> tested.lowering,
      };
      let taken = match tested.test {
        TestList(t) -> {
          let empty = nil(guarded.terms, s_sort);
          let at_nil = eq(empty.terms, s.id, empty.id);
          if t.fixed == 0 && !t.rest { Some(lift(guarded, at_nil)) }
          else { Some(lift(guarded, not(at_nil.terms, at_nil.id))) }
        },
        TestConstructor(name) -> {
          let at = match constructor(context, name) {
            Some(c) ->
              more_specific_sort(s_sort, constructor_result_sort(c, tested.binds, guarded.terms)),
            None -> s_sort,
          };
          let built = intern(
            guarded.terms,
            ConstructorTerm({ name: name, args: tested.binds }),
            at,
          );
          Some(lift(guarded, eq(built.terms, s.id, built.id)))
        },
        TestLiteral(literal) -> Some(lift(guarded, eq(guarded.terms, s.id, literal))),
        _ -> None,
      };
      let entered = match taken { Some(c) -> assume(c.lowering, c.id), None -> guarded };
      let body = lower(entered, context, a.body, unfolds);
      let left = match taken { Some(_) -> pop_assumption(body.lowering), None -> body.lowering };
      let sort = more_specific_sort(accumulator.sort, sort_of(left.terms, body.id));
      {
        lowering: left,
        arms: accumulator.arms.push({ test: tested.test, binds: tested.binds, body: body.id }),
        sort: sort,
      }
    },
  );
  lift(
    walked.lowering,
    intern(walked.lowering.terms, MatchTerm({ scrutinee: s.id, arms: walked.arms }), walked.sort),
  )
}

fn arm_shape(
  lowering: Lowering,
  context: Context,
  pattern: CodePattern,
  scrutinee: Int,
  s_sort: Option<Sort>,
) -> Option<{ lowering: Lowering, test: ArmTest, binds: List<Int> }> / {abort.raise} =
  match pattern {
    CodeWildcardPattern -> Some({ lowering: lowering, test: Always, binds: [] }),
    CodeBindingPattern(v) ->
      Some({
        lowering: {
          let slot = v.slot;
          bind(lowering, slot, scrutinee)
        },
        test: Always,
        binds: [],
      }),
    CodeLiteralPattern(l) -> if !identity_literal(l) { None } else {
      let t = literal(lowering, l);
      Some({ lowering: t.lowering, test: TestLiteral(t.id), binds: [] })
    },
    CodeRangePattern(_) -> None,
    CodeConstructorPattern(c) -> match constructor(context, String::of_bytes_lossy(c.name)) {
      None -> None,
      Some(k) -> if arity(k) != c.args.len()
          || !c.args.fold(true, |ok: Bool, a: CodePattern| ok && irrefutable(a)) { None } else {
        let sorts = field_sorts(k, s_sort);
        let bound = range(0, c.args.len()).fold(
          { lowering: lowering, binds: [] },
          |accumulator: { lowering: Lowering, binds: List<Int> }, i: Int| {
            let f = symbol(accumulator.lowering.terms, match sorts.at(i) {
              Some(s) -> s,
              None -> None,
            });
            let with_symbol = with_terms(accumulator.lowering, f.terms);
            let with_binding = match c.args.at(i) {
              Some(CodeBindingPattern(v)) -> {
                let slot = v.slot;
                bind(with_symbol, slot, f.id)
              },
              _ -> with_symbol,
            };
            { lowering: with_binding, binds: accumulator.binds.push(f.id) }
          },
        );
        Some({
          lowering: bound.lowering,
          test: TestConstructor(String::of_bytes_lossy(c.name)),
          binds: bound.binds,
        })
      },
    },
    CodeListPattern(l) -> {
      let simple = l.items.fold(true, |ok: Bool, a: CodePattern| ok && irrefutable(a))
        && (match l.rest { Some(r) -> irrefutable(r), None -> true });
      if !simple { None } else {
        let element_sort = match s_sort { Some(s) -> list_element(s), None -> None };
        let heads = l.items.fold(
          { lowering: lowering, at: Some(scrutinee), binds: [] },
          |accumulator: { lowering: Lowering, at: Option<Int>, binds: List<Int> }, item: CodePattern| {
            let stepped = match accumulator.at {
              Some(t) -> match node(accumulator.lowering.terms, t) {
                ConsTerm(c) -> { lowering: accumulator.lowering, at: Some(c.tail), field: c.head },
                _ -> {
                  let f = symbol(accumulator.lowering.terms, element_sort);
                  { lowering: with_terms(accumulator.lowering, f.terms), at: None, field: f.id }
                },
              },
              None -> {
                let f = symbol(accumulator.lowering.terms, element_sort);
                { lowering: with_terms(accumulator.lowering, f.terms), at: None, field: f.id }
              },
            };
            let with_binding = match item {
              CodeBindingPattern(v) -> {
                let slot = v.slot;
                bind(stepped.lowering, slot, stepped.field)
              },
              _ -> stepped.lowering,
            };
            { lowering: with_binding, at: stepped.at, binds: accumulator.binds.push(stepped.field) }
          },
        );
        let finished = match l.rest {
          None -> { lowering: heads.lowering, binds: heads.binds },
          Some(r) -> {
            let tail = match heads.at {
              Some(t) -> { lowering: heads.lowering, id: t },
              None -> lift(heads.lowering, symbol(heads.lowering.terms, s_sort)),
            };
            let with_tail = if tail.id != scrutinee {
              {
                ..tail.lowering,
                list_tails: tail.lowering.list_tails.push({ tail: tail.id, from: scrutinee }),
              }
            } else { tail.lowering };
            let with_binding = match r {
              CodeBindingPattern(v) -> {
                let slot = v.slot;
                bind(with_tail, slot, tail.id)
              },
              _ -> with_tail,
            };
            { lowering: with_binding, binds: heads.binds.push(tail.id) }
          },
        };
        Some({
          lowering: finished.lowering,
          test: TestList({ fixed: l.items.len(), rest: l.rest != None }),
          binds: finished.binds,
        })
      }
    },
    CodeRecordPattern(_) -> match destructured(lowering, pattern, scrutinee) {
      Some(bound) -> Some({ lowering: bound, test: Always, binds: [] }),
      None -> None,
    },
  }

pub fn field_sorts(c: Constructor, sort: Option<Sort>) -> List<Option<Sort>> = {
  let args = match sort {
    Some(NamedSort(name, xs)) -> if name == c.declaration.name && xs.len() == c.declaration.params {
      xs
    } else { range(0, c.declaration.params).map(|p: Int| shift_variables(SortVariable(p))) },
    _ -> range(0, c.declaration.params).map(|p: Int| shift_variables(SortVariable(p))),
  };
  c.variant.fields.map(|f: Sort| Some(substituted(f, args)))
}

fn constructor_result_sort(c: Constructor, args: List<Int>, terms: Terms) -> Option<Sort> = {
  let substitution = range(0, c.variant.fields.len()).fold(
    Map::new(),
    |accumulator: Map<Int, Sort>, i: Int|
      match c.variant.fields.at(i) {
        Some(f) -> match args.at(i) {
          Some(a) -> match sort_of(terms, a) {
            Some(actual) -> matched(f, actual, accumulator),
            None -> accumulator,
          },
          None -> accumulator,
        },
        None -> accumulator,
      },
  );
  Some(
    NamedSort(
      c.declaration.name,
      range(0, c.declaration.params).map(|p: Int|
        match substitution.get(p) { Some(s) -> s, None -> shift_variables(SortVariable(p)) }),
    ),
  )
}

pub fn requirements_since(lowering: Lowering, mark: Int) -> List<Int> =
  lowering.requirements.drop(mark)

pub fn requirements_between(lowering: Lowering, from: Int, to: Int) -> List<Int> =
  lowering.requirements.drop(from).take(to - from)
