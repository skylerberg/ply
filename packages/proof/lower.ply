//! `lower` — a claim's lowered code as prover terms, with what must hold for it to have a value.

import compiler.emit.code (Code, NLit, NVar, NUnary, NBinary, NApp, NKnown, NIf, NBlock, NList,
                           NRecord, NMatch, NPerform, NLabel, NLambda, NSimulate, NParallel,
                           NHandle, NField, NUpdate, CodeStmt, CLet, CLetPat, CDo, CodeField,
                           CodeArm, Capture, CodePattern, PxWild, PxVar, PxLit, PxRange, PxCtor,
                           PxRecord, PxList, CodePatternField, Lambda, irrefutable)
import compiler.syntax.patterns (Lit, LInt, LFixed, LWide, LBool, LStr, LBytes, LEmbedded, LFloat,
                                 LDec, LChar, LUnit, LBad)
import context (Context, Ctor, Def, ctor, arity, ctor_sort, signature, builtin, is_pure,
                is_recursive, unfoldable, self_recursive, is_identity, is_reflexive, ends,
                recursive_body, operation_sort, may_call_key)
import compiler.syntax.parsing (Span)
import domain (Ty, Var, Fn, Record, Con, Variant)
import lemma (Lemma)
import rules (RuleLog, Cited, Contract, note, unfolded)
import compiler.front.published (ClaimClause)
import compiler.syntax.items (SEnsures, SRequires)
import sort (bool_ty, bytes_ty, float_ty, int_ty, string_ty, decimal_ty, is_con, list_elem, list_ty,
             option_ty, record_of, substituted, field_ty, answered, matched, unified, foreign,
             foreign_base, vars)
import term (Terms, Made, Node, TInt, TBool, TStr, TDecimal, TFloat, TFixed, TUnit, TSym, TOpaque,
             TLin, TApp, TCtor, TNil, TCons, TRecord, TField, TNot, TAnd, TOr, TCmp, TEq, TEqualAt,
             TIf, TMatch, TClosure, CmpOp, Lt, Le, Gt, Ge, Arm, ArmTest, Always, TestCtor, TestLit,
             TestList, Undecidable, true_id, false_id, new_terms, size, node, sort_of, force_int,
             mk, int_lit, boolean, string, decimal, float_lit, fixed, unit, nil, cons, sym, opaque,
             add, sub, neg, mul, field, not, and, or, cmp, eq, equal_at, app, float_nan, float_rank,
             decimal_normalized, op_add, op_sub, op_mul, op_div, op_rem, op_concat, op_bit_and,
             op_bit_or, op_bit_xor, op_bit_not, op_shl, op_shr, op_ushr, op_lt, op_le, op_gt, op_ge,
             op_float)
import std.list
import std.option
import std.string
import compiler.syntax.exprs (is_arithmetic, is_ordered)
import compiler.emit.answer (literal_bits)

/// Past this many terms no definition is unfolded further.
pub fn max_terms() -> Int = 20000

/// How deep calls may be read inside one another from a root: a recursion over values in view, a
/// closure applied, a list call read over its spine. An unfolding inside another counts against the
/// unfold depth too.
pub fn unroll_budget() -> Int = 64

/// How many definitions one reading of a claim unfolds in all. An unrolling over a value in view counts
/// no depth, and a reading that repeats one makes no new terms, so neither bound counts its work.
pub fn unfold_room() -> Int = 512

/// Prelude functions that cannot raise or diverge, so a call needs no definedness requirement.
pub fn total_builtins() -> List<String> =
  [
    "List::len",
    "List::push",
    "List::at",
    "Int::to_string",
    "min",
    "max",
    "String::concat",
    "Bytes::len",
    "Bytes::concat",
    "Bytes::of_string",
    "Bytes::is_utf8",
    "Bytes::index_of",
    "Bytes::starts_with",
    "Bytes::ends_with",
    "String::of_bytes_lossy",
    "String::len",
    "String::trim",
    "String::starts_with",
    "String::ends_with",
    "String::contains",
    "Map::new",
    "Map::insert",
    "Map::get",
    "Map::contains",
    "Map::remove",
    "Map::len",
    "Map::keys",
    "Map::values",
    "Map::entries",
    "Map::of_entries",
    "Map::merge",
    "Map::first",
    "Map::last",
    "Map::floor",
    "Map::ceiling",
    "Map::below",
    "Map::above",
    "Map::pop_first",
    "Map::pop_last",
    "Map::range",
    "Map::split",
    "Decimal::of_int",
    "Decimal::to_string",
    "Decimal::of_string",
    "Float::of_decimal",
    "Decimal::of_float",
    "Int::of_decimal",
    "bits_of_float",
    "Float::of_bits",
    // IEEE arithmetic answers infinity or `NaN` where it leaves the range, and never ends the run.
    "Float::of_int",
    "Float::round",
    "Float::floor",
    "Float::ceil",
    "Float::sqrt",
    "Float::exp",
    "Float::ln",
    "Float::log2",
    "Float::log10",
    "Float::sin",
    "Float::cos",
    "Float::tan",
    "Float::asin",
    "Float::acos",
    "Float::atan",
    "Float::pow",
    "Float::atan2",
    "Float::hypot",
    // Total but still uninterpreted.
    "wrap_add",
    "wrap_sub",
    "wrap_mul",
    "saturating_add",
    "saturating_sub",
    "saturating_mul",
    "rotr32",
    "checked_add",
    "checked_sub",
    "checked_mul",
    "checked_neg",
    "I128::of_int",
    "U128::to_string",
    "I128::to_string",
    "U128::of_string",
    "I128::of_string",
  ]

pub fn is_total_builtin(name: String) -> Bool =
  total_builtins().fold(false, |f: Bool, b: String| f || b == name)

/// Where lowering left the decidable fragment.
pub type Blocker =
  | RecursiveCall(String)
  /// A call whose row is not known to be empty, so occurrences cannot share a term.
  | EffectfulCall(String)
  | UnfoldLimit(String)
  /// A builtin, or a name from outside the program.
  | OpaqueCall(String)
  | Division
  | NonlinearMultiplication
  | CoefficientRange
  | Lambda
  | Concat
  | BitOperator
  | DecimalArithmetic
  /// `perform`, `handle` or `simulate`.
  | Region
  | UndecidableMatchArm
  /// A body or clause the lowering did not take, which reads as unreached.
  | Untaken
  | DestructuringLet
  /// Why induction declined: which definition or case, in words.
  | Induction(String)
  /// Why a `cost` bound was not shown, in words.
  | Unbounded(String)
  /// Every part of the claim was read, and the search found a case it could not close: the claim may
  /// be false there, or need a lemma or a guard.
  | Unclosed
  /// A value of the type named, which states an invariant, built where the proof did not read it: in a
  /// constructor handed on as a function, or in code the lowering passed over.
  | Unseen(String)
  /// A clause shown of what its definition answers only by taking its body to answer: it shows
  /// nothing of whether the body answers.
  | AnswerAssumed

/// The kind a report prints, and the definition or reason it names, if any.
pub fn blocker_parts(b: Blocker) -> { kind: String, detail: Option<String> } =
  match b {
    RecursiveCall(d) -> { kind: "recursive_call", detail: Some(d) },
    EffectfulCall(d) -> { kind: "effectful_call", detail: Some(d) },
    UnfoldLimit(d) -> { kind: "unfold_limit", detail: Some(d) },
    OpaqueCall(d) -> { kind: "opaque_call", detail: Some(d) },
    Division -> { kind: "division", detail: None },
    NonlinearMultiplication -> { kind: "nonlinear_multiplication", detail: None },
    CoefficientRange -> { kind: "coefficient_range", detail: None },
    Lambda -> { kind: "lambda", detail: None },
    Concat -> { kind: "concat", detail: None },
    BitOperator -> { kind: "bit_operator", detail: None },
    DecimalArithmetic -> { kind: "decimal_arithmetic", detail: None },
    Region -> { kind: "region", detail: None },
    UndecidableMatchArm -> { kind: "undecidable_match_arm", detail: None },
    Untaken -> { kind: "untaken", detail: None },
    DestructuringLet -> { kind: "destructuring_let", detail: None },
    Induction(why) -> { kind: "induction", detail: Some(why) },
    Unbounded(why) -> { kind: "unbounded", detail: Some(why) },
    Unclosed -> { kind: "unclosed", detail: None },
    Unseen(t) -> { kind: "unseen_build", detail: Some(t) },
    AnswerAssumed -> { kind: "answer_assumed", detail: None },
  }

pub type Lowering = {
  terms: Terms,
  rules: RuleLog,
  unfold_limit: Int,
  depth: Int,
  window: List<Option<Int>>,
  blockers: List<Blocker>,
  /// What must hold for the lowered expressions not to raise or diverge.
  requirements: List<Int>,
  /// Conditions assumed on the way to the expression being lowered.
  path: List<Int>,
  /// The claim's type variables an `identity` constraint is on, where `==` is identity.
  identities: Map<Int, Bool>,
  /// Recursive definitions shown to terminate, so a call of one is a value.
  total: Map<String, Bool>,
  /// Recursive definitions inlined to the depth, each unrolling recorded as an equation.
  unrolled: Map<String, Bool>,
  /// `f(x̄) == body(x̄)` for each unrolling of a recursive definition, and the `f(x̄)` of each.
  equations: List<Int>,
  defined: List<Int>,
  /// Calls of a total definition left as terms.
  calls: List<Int>,
  /// Each rest binder of a list pattern, with the list it is the tail of.
  smaller: List<{ tail: Int, from: Int }>,
  /// The proved laws this claim may use, and each one's claim at a call that fit its trigger, which
  /// holds.
  lemmas: List<Lemma>,
  facts: List<Int>,
  /// The lambdas the claim made, each a `TClosure` by its index.
  closures: List<Closure>,
  /// The definitions of this package whose `ensures` a proof showed, which a call of one may stand
  /// on; another package's are its own run's to show.
  contracts: Map<String, Bool>,
  /// The `ensures` clause being proved of a definition that ends: at each call back into it, the
  /// clause holds of what the call answers, which is induction over the calls a run makes.
  inducting: Option<{ name: String, clause: Int }>,
  /// While a body is read for the values it builds of a type that states an invariant: the type and
  /// its function, and in `built`, that function at each value built, on the way to it.
  building: Option<{ type_name: String, by: String }>,
  built: List<Int>,
  /// Where each value counted in `built` was built.
  seen: List<Span>,
  /// The types stating an invariant whose constructors the lowering applied: a value of one made
  /// here may break it, so nothing that stands on it holds of such a value.
  constructed: List<String>,
  /// The types stating an invariant that nothing in this claim may stand on but its binders' values:
  /// what an earlier reading of the claim found it constructs.
  tainted: List<String>,
  /// Whether the claim is a law, whose binders' functions answer at every argument: the law is a
  /// claim about such functions. An `ensures` is handed functions by callers it cannot see.
  in_law: Bool,
  /// The claim's binders, as terms.
  binder_terms: List<Int>,
  /// Whether what may keep what is being read from answering is owed unreached: a raise, or a call
  /// not known to answer. It is in a law and in any claim's clause and guards; not in the body of a
  /// definition an `ensures` is about, which holds of what the definition answers.
  answer_owed: Bool,
  /// How many more definitions this reading may unfold.
  unfold_room: Int,
  /// Whether what was lowered performs anything, which a closure's body is read on fresh
  /// arguments to learn.
  impure: Bool,
}

/// A lambda as a value: its code, the terms it captured, by slot, and what reading its body on fresh
/// arguments showed: whether it performs nothing, and whether it always answers.
pub type Closure = { lambda: Lambda, window: List<Option<Int>>, pure: Bool, total: Bool }

/// A lowering after a step, and the term the step produced.
pub type L = { lowering: Lowering, id: Int }

pub fn lowering(rules: RuleLog, unfold_limit: Int) -> Lowering / {abort.raise} =
  {
    terms: new_terms(),
    rules: rules,
    unfold_limit: unfold_limit,
    depth: 0,
    window: [],
    blockers: [],
    requirements: [],
    path: [],
    identities: Map::new(),
    total: Map::new(),
    unrolled: Map::new(),
    equations: [],
    defined: [],
    calls: [],
    smaller: [],
    lemmas: [],
    facts: [],
    closures: [],
    impure: false,
    contracts: Map::new(),
    inducting: None,
    building: None,
    built: [],
    seen: [],
    constructed: [],
    tainted: [],
    in_law: false,
    binder_terms: [],
    answer_owed: true,
    unfold_room: unfold_room(),
  }

/// Lifts a term-store step into the lowering.
fn on(lowering: Lowering, made: Made) -> L =
  { lowering: { ..lowering, terms: made.terms }, id: made.id }

pub fn with_terms(lowering: Lowering, terms: Terms) -> Lowering = { ..lowering, terms: terms }

fn blocked(lowering: Lowering, b: Blocker) -> Lowering =
  { ..lowering, blockers: lowering.blockers.push(b) }

pub fn assume(lowering: Lowering, cond: Int) -> Lowering =
  { ..lowering, path: lowering.path.push(cond) }

/// Forgets the conditions assumed so far, before lowering a hypothesis instance.
pub fn drop_assumptions(lowering: Lowering) -> Lowering = { ..lowering, path: [] }

fn popped(lowering: Lowering) -> Lowering =
  { ..lowering, path: lowering.path.take(lowering.path.len() - 1) }

/// `p₁ ∧ … ∧ pₙ ⟹ cond` under the current path.
pub fn under_path(lowering: Lowering, cond: Int) -> L / {abort.raise} =
  range(0, lowering.path.len()).fold({ lowering: lowering, id: cond }, |acc: L, k: Int| {
    let i = lowering.path.len() - 1 - k;
    match lowering.path.at(i) {
      Some(p) -> {
        let negated = not(acc.lowering.terms, p);
        on(acc.lowering, or(negated.terms, negated.id, acc.id))
      },
      None -> acc,
    }
  })

fn require(lowering: Lowering, cond: Int) -> Lowering / {abort.raise} =
  if cond == true_id() { lowering } else {
    let out = under_path(lowering, cond);
    { ..out.lowering, requirements: out.lowering.requirements.push(out.id) }
  }

/// `lowering` owing that its run goes on past here, where that is owed; elsewhere a proof stands on
/// it, and says so.
fn undefined(lowering: Lowering) -> Lowering / {abort.raise} =
  if lowering.answer_owed { require(lowering, false_id()) }
  else { blocked(lowering, AnswerAssumed) }

fn require_int_range(lowering: Lowering, t: Int) -> Lowering / {abort.raise} =
  match node(lowering.terms, t) {
    TLin(_) -> {
      let min = int_lit(lowering.terms, 0 - 9223372036854775807 - 1);
      let max = int_lit(min.terms, 9223372036854775807);
      let low = cmp(max.terms, Ge, t, min.id);
      let high = cmp(low.terms, Le, t, max.id);
      let both = and(high.terms, low.id, high.id);
      require(with_terms(lowering, both.terms), both.id)
    },
    _ -> lowering,
  }

/// Zero divisors raise, and `Int`'s least value divided by `-1` overflows.
fn require_divisible(lowering: Lowering, lhs: Int, rhs: Int) -> Lowering / {abort.raise} =
  match node(lowering.terms, rhs) {
    TInt(k) -> if k == 0 { undefined(lowering) } else if k == 0 - 1 {
      let min = int_lit(lowering.terms, 0 - 9223372036854775807 - 1);
      let is_min = eq(min.terms, lhs, min.id);
      let not_min = not(is_min.terms, is_min.id);
      require(with_terms(lowering, not_min.terms), not_min.id)
    } else { lowering },
    _ -> {
      let zero = int_lit(lowering.terms, 0);
      let is_zero = eq(zero.terms, rhs, zero.id);
      let nonzero = not(is_zero.terms, is_zero.id);
      let lw2 = require(with_terms(lowering, nonzero.terms), nonzero.id);
      let min = int_lit(lw2.terms, 0 - 9223372036854775807 - 1);
      let minus_one = int_lit(min.terms, 0 - 1);
      let lhs_min = eq(minus_one.terms, lhs, min.id);
      let rhs_minus_one = eq(lhs_min.terms, rhs, minus_one.id);
      let overflows = and(rhs_minus_one.terms, lhs_min.id, rhs_minus_one.id);
      let safe = not(overflows.terms, overflows.id);
      require(with_terms(lw2, safe.terms), safe.id)
    },
  }

/// A shift raises unless its count is a bit position; nothing else makes it raise.
fn require_shift_count(lowering: Lowering, count: Int) -> Lowering / {abort.raise} = {
  let zero = int_lit(lowering.terms, 0);
  let width = int_lit(zero.terms, 63);
  let low = cmp(width.terms, Ge, count, zero.id);
  let high = cmp(low.terms, Le, count, width.id);
  let both = and(high.terms, low.id, high.id);
  require(with_terms(lowering, both.terms), both.id)
}

pub fn bind_symbolic(lowering: Lowering, ty: Ty) -> L / {abort.raise} =
  on(lowering, sym(lowering.terms, Some(ty)))

pub fn lower_root(
  lowering: Lowering,
  context: Context,
  c: Option<Code>,
  binders: List<Int>,
) -> L / {abort.raise} = {
  let outer = lowering.window;
  let r = lower_opt(
    { ..lowering, window: binders.map(|t: Int| Some(t)) },
    context,
    c,
    unroll_budget(),
  );
  { lowering: { ..r.lowering, window: outer }, id: r.id }
}

/// A body or clause the lowering did not take reads as unreached.
fn lower_opt(
  lowering: Lowering,
  context: Context,
  c: Option<Code>,
  unfolds: Int,
) -> L / {abort.raise} =
  match c {
    Some(code) -> lower(lowering, context, code, unfolds),
    None -> on(blocked(lowering, Untaken), sym(lowering.terms, None)),
  }

/// What a region answers, of `sort` where that is known, which is not read.
fn region(lowering: Lowering, sort: Option<Ty>) -> L / {abort.raise} = {
  let lw = blocked(undefined(lowering), Region);
  on({ ..lw, impure: true }, sym(lw.terms, sort))
}

fn opaque_sym(lowering: Lowering, b: Blocker) -> L / {abort.raise} = {
  let lw2 = { ..blocked(lowering, b), impure: lowering.impure || b == Region };
  on(lw2, sym(lw2.terms, None))
}

/// A lambda as the value it is: one term for one lambda over the same captures, wherever it is
/// written in the claim.
fn closure(lowering: Lowering, context: Context, l: Lambda, unfolds: Int) -> L / {abort.raise} = {
  let captured = l.captures.fold(
    { lowering: lowering, window: range(0, l.params).map(|_k: Int| None) },
    |acc: { lowering: Lowering, window: List<Option<Int>> }, cap: Capture| {
      let r = local(acc.lowering, cap.src);
      { lowering: r.lowering, window: placed(acc.window, cap.dst, r.id) }
    },
  );
  let lw = captured.lowering;
  let found = range(0, lw.closures.len()).fold(None, |acc: Option<Int>, k: Int|
    match acc {
      Some(_) -> acc,
      None -> match lw.closures.at(k) {
        Some(c) -> if c.lambda == l && c.window == captured.window { Some(k) } else { None },
        None -> None,
      },
    });
  match found {
    Some(k) -> on(lw, mk(lw.terms, TClosure(k), None)),
    None -> {
      let fresh = range(0, l.params).fold(
        { terms: lw.terms, window: captured.window },
        |acc: { terms: Terms, window: List<Option<Int>> }, i: Int| {
          let x = sym(acc.terms, None);
          { terms: x.terms, window: placed(acc.window, i, x.id) }
        },
      );
      // Read at arguments nothing constrains, so what it builds is owed at every argument. No call
      // in it is one the run of a definition being proved makes, as its termination counts them.
      let read = lower(
        {
          ..lw,
          terms: fresh.terms,
          window: fresh.window,
          requirements: [],
          path: [],
          impure: false,
          inducting: None,
          answer_owed: true,
        },
        context,
        l.body,
        unfolds,
      );
      let k = read.lowering.closures.len();
      let made = mk(read.lowering.terms, TClosure(k), None);
      on(
        {
          ..lw,
          terms: made.terms,
          rules: read.lowering.rules,
          built: read.lowering.built,
          seen: read.lowering.seen,
          constructed: read.lowering.constructed,
          unfold_room: read.lowering.unfold_room,
          closures: read.lowering.closures.push({
            lambda: l,
            window: captured.window,
            pure: !read.lowering.impure,
            total: !read.lowering.impure && read.lowering.requirements.len() == 0,
          }),
        },
        made,
      )
    },
  }
}

fn placed(window: List<Option<Int>>, slot: Int, t: Int) -> List<Option<Int>> / {abort.raise} = {
  let grown = if window.len() <= slot {
    range(window.len(), slot + 1).fold(window, |w: List<Option<Int>>, _k: Int| w.push(None))
  } else { window };
  grown.set(slot, Some(t))
}

/// A closure applied: its body read over the arguments and what it captured.
fn applied_closure(
  lowering: Lowering,
  context: Context,
  k: Int,
  head: Int,
  args: List<Int>,
  unfolds: Int,
) -> L / {abort.raise} =
  match lowering.closures.at(k) {
    None -> opaque_sym(lowering, Lambda),
    Some(c) -> if unfolds <= 0 || c.lambda.params != args.len() {
      let lw2 = if c.total { lowering } else { undefined(lowering) };
      if c.pure { on(lw2, app(lw2.terms, head, args, None)) }
      else { on({ ..lw2, impure: true }, sym(lw2.terms, None)) }
    } else {
      let window = range(0, args.len()).fold(c.window, |w: List<Option<Int>>, i: Int|
        match args.at(i) { Some(a) -> placed(w, i, a), None -> w });
      let r = lower(
        { ..lowering, window: window, inducting: None },
        context,
        c.lambda.body,
        unfolds - 1,
      );
      {
        lowering: { ..r.lowering, window: lowering.window, inducting: lowering.inducting },
        id: r.id,
      }
    },
  }

/// Whether a function value performs nothing, so equal calls of it answer equally.
fn function_pure(lowering: Lowering, context: Context, t: Int) -> Bool / {abort.raise} =
  match node(lowering.terms, t) {
    TClosure(k) -> match lowering.closures.at(k) { Some(c) -> c.pure, None -> false },
    TOpaque(name) ->
      is_pure(context, name) || is_total_builtin(name) || ctor(context, name) != None,
    _ -> match sort_of(lowering.terms, t) { Some(Fn(_, _, pure)) -> pure, _ -> false },
  }

/// Whether a call of a function value over values of `sorts` always answers: a closure that read so,
/// a builtin that answers there or a constructor, or in a law a binder whose type says it performs
/// nothing and never raises. Elsewhere a function's type cannot say so, since an overflow inside it
/// ends the run whatever its row is.
fn function_total(
  lowering: Lowering,
  context: Context,
  t: Int,
  sorts: List<Option<Ty>>,
) -> Bool / {abort.raise} =
  match node(lowering.terms, t) {
    TClosure(k) -> match lowering.closures.at(k) { Some(c) -> c.total, None -> false },
    TOpaque(name) -> builtin_answers(context, name, sorts) || ctor(context, name) != None,
    TSym(_) ->
      lowering.in_law && lowering.binder_terms.contains(t)
        && (match sort_of(lowering.terms, t) { Some(Fn(_, _, total)) -> total, _ -> false }),
    _ -> false,
  }

/// A definition whose row is a variable its function parameters are handed, and raises: a call
/// performs what the functions it is given do.
fn through_pure(
  lowering: Lowering,
  context: Context,
  name: String,
  args: List<Int>,
) -> Bool / {abort.raise} =
  match signature(context, name) {
    Some(s) ->
      s.pure && s.through.len() > 0
        && s.through.all(|i: Int|
          match args.at(i) { Some(a) -> function_pure(lowering, context, a), None -> false }),
    None -> false,
  }

pub fn lower(lowering: Lowering, context: Context, c: Code, unfolds: Int) -> L / {abort.raise} =
  match c.node {
    NLit(l) -> literal(lowering, l),
    NVar(v) -> match v.slot {
      Some(s) -> local(lowering, s),
      None -> {
        let name = String::of_bytes_lossy(v.name);
        let g = global(lowering, context, name);
        match ctor(context, name) {
          Some(k) -> if arity(k) == 0 {
            at_site(built_value(g, context, k, unfolds), lowering, c.span)
          } else { { lowering: constructing(g.lowering, context, k), id: g.id } },
          None -> g,
        }
      },
    },
    NBinary(b) -> binary_code(lowering, context, b.op, b.lhs, b.rhs, unfolds),
    NUnary(u) -> unary(lowering, context, u.op, u.operand, unfolds),
    NLambda(l) -> closure(lowering, context, l, unfolds),
    NApp(a) -> application(lowering, context, a.func, a.args, unfolds),
    NKnown(k) -> local(lowering, k.slot),
    NIf(i) -> {
      let cond = lower(lowering, context, i.cond, unfolds);
      let then_branch = lower(assume(cond.lowering, cond.id), context, i.then_branch, unfolds);
      let otherwise = not(then_branch.lowering.terms, cond.id);
      let else_branch = lower(
        assume(popped(with_terms(then_branch.lowering, otherwise.terms)), otherwise.id),
        context,
        i.else_branch,
        unfolds,
      );
      let lw2 = popped(else_branch.lowering);
      let sort = surer(sort_of(lw2.terms, then_branch.id), sort_of(lw2.terms, else_branch.id));
      on(
        lw2,
        mk(
          lw2.terms,
          TIf({ cond: cond.id, then_branch: then_branch.id, else_branch: else_branch.id }),
          sort,
        ),
      )
    },
    NMatch(m) -> match_expr(lowering, context, m.scrutinee, m.arms, unfolds),
    NBlock(b) -> block(lowering, context, b.stmts, b.tail, unfolds),
    NRecord(r) -> record(lowering, context, [], r.fields, None, unfolds),
    // Each branch applied where it stands: the block means the tuple of its branches' answers.
    NParallel(pr) ->
      recorded(
        range(0, pr.branches.len()).fold({ lowering: lowering, out: [] }, |acc: Lowered, i: Int|
          match pr.branches.at(i) {
            Some(b) -> {
              let r = application(acc.lowering, context, b, [], unfolds);
              {
                lowering: r.lowering,
                out: acc.out.push({ name: "_" ++ i.to_string(), value: r.id }),
              }
            },
            None -> acc,
          }),
      ),
    // The fields a record update copies read the base; the ones it sets follow them.
    NUpdate(u) -> record(lowering, context, u.copies, u.sets, Some(u.base), unfolds),
    NField(f) -> {
      let base = lower(lowering, context, f.base, unfolds);
      on(base.lowering, field(base.lowering.terms, base.id, String::of_bytes_lossy(f.field)))
    },
    NList(l) -> {
      let items = l.items.fold(
        { lowering: lowering, ids: [] },
        |acc: { lowering: Lowering, ids: List<Int> }, x: Code| {
          let r = lower(acc.lowering, context, x, unfolds);
          { lowering: r.lowering, ids: acc.ids.push(r.id) }
        },
      );
      let sort = match items.ids.at(0) {
        Some(t) -> match sort_of(items.lowering.terms, t) {
          Some(s) -> Some(list_ty(s)),
          None -> None,
        },
        None -> None,
      };
      let empty = nil(items.lowering.terms, sort);
      let built = range(0, items.ids.len()).fold(empty, |acc: Made, k: Int|
        match items.ids.at(items.ids.len() - 1 - k) {
          Some(item) -> cons(acc.terms, item, acc.id, sort),
          None -> acc,
        });
      on(items.lowering, built)
    },
    NPerform(p) -> region(lowering, operation_sort(context, p.effect, p.op)),
    NSimulate(_) -> region(lowering, None),
    NHandle(_) -> region(lowering, None),
    // A label argument is the field-table entry of a resource: opaque, like a perform.
    NLabel(_) -> opaque_sym(lowering, Region),
  }

type Lowered = { lowering: Lowering, out: List<{ name: String, value: Int }> }

/// A record literal, or an update: each copied field read off `base`, then each set one.
fn record(
  lowering: Lowering,
  context: Context,
  copies: List<Bytes>,
  sets: List<CodeField>,
  base: Option<Code>,
  unfolds: Int,
) -> L / {abort.raise} = {
  let copied = copies.fold({ lowering: lowering, out: [] }, |acc: Lowered, n: Bytes|
    match base {
      Some(b) -> {
        let r = lower(acc.lowering, context, b, unfolds);
        let read = field(r.lowering.terms, r.id, String::of_bytes_lossy(n));
        {
          lowering: with_terms(r.lowering, read.terms),
          out: acc.out.push({ name: String::of_bytes_lossy(n), value: read.id }),
        }
      },
      None -> acc,
    });
  recorded(
    sets.fold(copied, |acc: Lowered, f: CodeField| {
      let r = lower(acc.lowering, context, f.value, unfolds);
      {
        lowering: r.lowering,
        out: acc.out.push({ name: String::of_bytes_lossy(f.name), value: r.id }),
      }
    }),
  )
}

fn recorded(lowered: Lowered) -> L / {abort.raise} = {
  let sorted = sorted_fields(lowered.out);
  let sort = record_sort(lowered.lowering.terms, sorted);
  on(lowered.lowering, mk(lowered.lowering.terms, TRecord(sorted), sort))
}

/// Stable, by name.
fn sorted_fields(fields: List<{ name: String, value: Int }>) -> List<{ name: String, value: Int }> =
  fields.fold([], |acc: List<{ name: String, value: Int }>, f: { name: String, value: Int }| {
    let before = acc.filter(|g: { name: String, value: Int }| compare(g.name, f.name) != Greater);
    let after = acc.filter(|g: { name: String, value: Int }| compare(g.name, f.name) == Greater);
    after.fold(
      before.push(f),
      |a: List<{ name: String, value: Int }>, g: { name: String, value: Int }| a.push(g),
    )
  })

fn record_sort(terms: Terms, fields: List<{ name: String, value: Int }>) -> Option<Ty> =
  match fields.fold(
      Some([]),
      |acc: Option<List<{ name: String, ty: Ty }>>, f: { name: String, value: Int }|
        match acc {
          None -> None,
          Some(xs) -> match sort_of(terms, f.value) {
            Some(s) -> Some(xs.push({ name: f.name, ty: s })),
            None -> None,
          },
        },
    ) {
    Some(xs) -> Some(record_of(xs)),
    None -> None,
  }

fn unary(
  lowering: Lowering,
  context: Context,
  op: Bytes,
  operand: Code,
  unfolds: Int,
) -> L / {abort.raise} = {
  let t = lower(lowering, context, operand, unfolds);
  let numeric = if op == b"neg" { operand_type(context, t.lowering.terms, t.id, t.id) }
  else { None };
  if op == b"not" { on(t.lowering, not(t.lowering.terms, t.id)) }
  else if numeric == Some(FloatOperand) {
    match node(t.lowering.terms, t.id) {
      // The sign bit, which negation alone moves.
      TFloat(bits) ->
        on(t.lowering, float_lit(t.lowering.terms, bits ^ 0 - 9223372036854775807 - 1)),
      _ -> {
        let head = opaque(t.lowering.terms, op_float("neg"), None);
        on(t.lowering, app(head.terms, head.id, [t.id], Some(float_ty())))
      },
    }
  } else if numeric == Some(DecimalOperand) {
    let head = opaque(t.lowering.terms, "Decimal neg", None);
    on(t.lowering, app(head.terms, head.id, [t.id], Some(decimal_ty())))
  } else if match numeric { Some(Stated(_)) -> true, _ -> false } {
    match numeric {
      Some(Stated(n)) -> match n.fns.at(3) {
        Some(f) -> if f == "" { opaque_sym(t.lowering, OpaqueCall(n.type_name)) }
        else { call_named(t.lowering, context, f, [t.id], unfolds) },
        None -> opaque_sym(t.lowering, OpaqueCall(n.type_name)),
      },
      _ -> opaque_sym(t.lowering, OpaqueCall("")),
    }
  }
  // Not folded to `-x - 1`, which raises at `Int`'s least value where `~` does not.
  else if op == b"bitnot" {
    let lw2 = blocked(with_terms(t.lowering, force_int(t.lowering.terms, t.id)), BitOperator);
    let head = opaque(lw2.terms, op_bit_not(), None);
    let term = app(head.terms, head.id, [t.id], Some(int_ty()));
    { lowering: with_terms(lw2, force_int(term.terms, term.id)), id: term.id }
  } else if !int_operands(t.lowering.terms, t.id, t.id) {
    unknown_operator(t.lowering, op, t.id, t.id)
  } else {
    let lw2 = with_terms(t.lowering, force_int(t.lowering.terms, t.id));
    match neg(lw2.terms, t.id) {
      Some(out) -> { lowering: require_int_range(with_terms(lw2, out.terms), out.id), id: out.id },
      None -> {
        let lw3 = undefined(blocked(lw2, CoefficientRange));
        on(lw3, sym(lw3.terms, Some(int_ty())))
      },
    }
  }
}

fn literal(lowering: Lowering, l: Lit) -> L / {abort.raise} =
  match l {
    LInt(k) -> on(lowering, int_lit(lowering.terms, k)),
    LBool(b) -> on(lowering, boolean(lowering.terms, b)),
    LStr(s) -> on(lowering, string(lowering.terms, String::of_bytes_lossy(s))),
    // Not `TStr`: `b"ab"` and `"ab"` must not be congruent.
    LBytes(_) -> on(lowering, sym(lowering.terms, Some(bytes_ty()))),
    LEmbedded(_, _) -> on(lowering, sym(lowering.terms, Some(bytes_ty()))),
    LFloat(raw) -> on(lowering, float_lit(lowering.terms, literal_bits(raw))),
    LDec(raw) -> on(lowering, decimal(lowering.terms, decimal_of_raw(String::of_bytes_lossy(raw)))),
    LFixed(width, bits) ->
      on(lowering, fixed(lowering.terms, String::of_bytes_lossy(width).ascii_upper(), 0, bits)),
    LWide(width, high, low) ->
      on(lowering, fixed(lowering.terms, String::of_bytes_lossy(width).ascii_upper(), high, low)),
    // A value of its own sort, so `'a'` and `97` are not congruent.
    LChar(v) -> on(lowering, fixed(lowering.terms, "Char", 0, v)),
    LUnit -> on(lowering, unit(lowering.terms)),
    LBad -> on(lowering, unit(lowering.terms)),
  }

/// `1.50m` is `1.50`; a pattern's `-` is part of its source, and negates it.
fn decimal_of_raw(raw: String) -> Decimal / {abort.raise} = {
  let b = Bytes::of_string(raw);
  let digits = |from: Int, to: Int|
    Bytes::concat_all(
      range(from, to).map(|i: Int| {
        let c = b.at(i);
        if c >= 48 && c <= 57 { b.slice(i, i + 1) } else { b"" }
      }),
    );
  let dot = match b.index_of(b".") { Some(i) -> i, None -> b.len() };
  let whole = digits(0, dot);
  let fraction = digits(dot, b.len());
  let sign = if b.starts_with(b"-") { b"-" } else { b"" };
  let spelled = Bytes::concat_all([
    sign,
    if whole.len() == 0 { b"0" } else { whole },
    if fraction.len() == 0 { b"" } else { b"." },
    fraction,
  ]);
  match Decimal::of_string(String::of_bytes(spelled)) { Some(d) -> d, None -> Decimal::of_int(0) }
}

fn local(lowering: Lowering, slot: Int) -> L / {abort.raise} =
  match lowering.window.at(slot) {
    Some(Some(t)) -> { lowering: lowering, id: t },
    _ -> on(lowering, sym(lowering.terms, None)),
  }

fn bind(lowering: Lowering, slot: Int, t: Int) -> Lowering / {abort.raise} = {
  let grown = if lowering.window.len() <= slot {
    range(lowering.window.len(), slot + 1).fold(lowering.window, |w: List<Option<Int>>, _: Int|
      w.push(None))
  } else { lowering.window };
  { ..lowering, window: grown.set(slot, Some(t)) }
}

fn global(lowering: Lowering, context: Context, name: String) -> L / {abort.raise} =
  match ctor(context, name) {
    Some(c) -> if arity(c) == 0 {
      on(lowering, mk(lowering.terms, TCtor({ name: name, args: [] }), Some(foreign(ctor_sort(c)))))
    } else { on(lowering, mk(lowering.terms, TOpaque(name), Some(foreign(ctor_sort(c))))) },
    None -> match signature(context, name) {
      Some(s) -> on(lowering, mk(lowering.terms, TOpaque(name), Some(s.ty))),
      None -> match builtin(context, name) {
        Some(b) -> if is_total_builtin(name) {
          on(lowering, opaque(lowering.terms, name, Some(b.ty)))
        } else { on(lowering, sym(lowering.terms, Some(b.ty))) },
        None -> if is_total_builtin(name) { on(lowering, opaque(lowering.terms, name, None)) }
        else { on(lowering, sym(lowering.terms, None)) },
      },
    },
  }

/// An operand type whose operators are not `Int`'s: a type that states `numeric` names its own.
type Numeric = | FloatOperand | DecimalOperand | Stated({ type_name: String, fns: List<String> })

fn operand_type(context: Context, terms: Terms, lhs: Int, rhs: Int) -> Option<Numeric> =
  [lhs, rhs].fold(None, |acc: Option<Numeric>, side: Int|
    match acc {
      Some(_) -> acc,
      None -> match sort_of(terms, side) {
        Some(Con(name, args)) -> if name == "Float" && args.len() == 0 { Some(FloatOperand) }
        else if name == "Decimal" && args.len() == 0 { Some(DecimalOperand) } else {
          match context.numerics.get(name) {
            Some(fns) -> Some(Stated({ type_name: name, fns: fns })),
            None -> None,
          }
        },
        _ -> None,
      },
    })

/// Short-circuit: the right operand owes its requirements only under the left's answer.
fn binary_code(
  lowering: Lowering,
  context: Context,
  op: Bytes,
  lhs: Code,
  rhs: Code,
  unfolds: Int,
) -> L / {abort.raise} =
  if op == b"and" || op == b"or" {
    let l = lower(lowering, context, lhs, unfolds);
    let reached = if op == b"and" { { lowering: l.lowering, id: l.id } }
    else { on(l.lowering, not(l.lowering.terms, l.id)) };
    let r = lower(assume(reached.lowering, reached.id), context, rhs, unfolds);
    binary(popped(r.lowering), context, op, l.id, r.id, unfolds)
  } else {
    let l = lower(lowering, context, lhs, unfolds);
    let r = lower(l.lowering, context, rhs, unfolds);
    binary(r.lowering, context, op, l.id, r.id, unfolds)
  }

fn cmp_of(op: Bytes) -> CmpOp =
  if op == b"lt" { Lt } else if op == b"le" { Le } else if op == b"gt" { Gt } else { Ge }

fn arith_symbol(op: Bytes) -> String =
  if op == b"add" { op_add() }
  else if op == b"sub" { op_sub() }
  else if op == b"mul" { op_mul() }
  else if op == b"div" { op_div() }
  else if op == b"rem" { op_rem() }
  else if op == b"lt" { op_lt() }
  else if op == b"le" { op_le() }
  else if op == b"gt" { op_gt() }
  else { op_ge() }

fn non_int_operator(
  lowering: Lowering,
  context: Context,
  op: Bytes,
  lhs: Int,
  rhs: Int,
  numeric: Numeric,
  unfolds: Int,
) -> L / {abort.raise} =
  match numeric {
    FloatOperand -> if is_ordered(op) { float_order(lowering, op, lhs, rhs) }
    else { float_arithmetic(lowering, op, lhs, rhs) },
    DecimalOperand -> {
      let comparison = is_ordered(op);
      let b = blocked(lowering, DecimalArithmetic);
      let lw2 = if comparison { b } else { undefined(b) };
      let head = opaque(lw2.terms, arith_symbol(op), None);
      on(
        lw2,
        app(
          head.terms,
          head.id,
          [lhs, rhs],
          Some(if comparison { bool_ty() } else { decimal_ty() }),
        ),
      )
    },
    Stated(n) -> stated_operator(lowering, context, op, lhs, rhs, n.type_name, n.fns, unfolds),
  }

/// `x < y` at `Float`: neither is `NaN`, and `x` falls below `y` in the order.
fn float_order(lowering: Lowering, op: Bytes, x: Int, y: Int) -> L / {abort.raise} = {
  let rx = float_rank(lowering.terms, x);
  let ry = float_rank(rx.terms, y);
  let below = cmp(ry.terms, cmp_of(op), rx.id, ry.id);
  on(lowering, numbers_both(below.terms, x, y, below.id))
}

/// `holds` where neither `x` nor `y` is `NaN`, and false where one is.
fn numbers_both(terms: Terms, x: Int, y: Int, holds: Int) -> Made / {abort.raise} = {
  let nx = float_nan(terms, x);
  let ny = float_nan(nx.terms, y);
  let not_x = not(ny.terms, nx.id);
  let not_y = not(not_x.terms, ny.id);
  let inner = both(not_y.terms, not_y.id, holds);
  both(inner.terms, not_x.id, inner.id)
}

/// `a && b`, settled where either is a literal.
fn both(terms: Terms, a: Int, b: Int) -> Made / {abort.raise} =
  if a == true_id() { { terms: terms, id: b } }
  else if b == true_id() { { terms: terms, id: a } }
  else if a == false_id() || b == false_id() { boolean(terms, false) }
  else { and(terms, a, b) }

/// IEEE arithmetic, each operation rounded once: uninterpreted, but of two literals the bits a run
/// answers, which every machine agrees on.
fn float_arithmetic(lowering: Lowering, op: Bytes, x: Int, y: Int) -> L / {abort.raise} =
  match ((node(lowering.terms, x), node(lowering.terms, y))) {
    (TFloat(a), TFloat(b)) -> {
      let p = Float::of_bits(a);
      let q = Float::of_bits(b);
      let r = if op == b"add" { p + q }
      else if op == b"sub" { p - q }
      else if op == b"mul" { p * q }
      else if op == b"div" { p / q }
      else { p % q };
      on(lowering, float_lit(lowering.terms, bits_of_float(r)))
    },
    _ -> {
      let head = opaque(lowering.terms, op_float(String::of_bytes_lossy(op)), None);
      on(lowering, app(head.terms, head.id, [x, y], Some(float_ty())))
    },
  }

/// At a type that states `numeric`, an operator is the function it names; an ordering compares
/// the keys.
fn stated_operator(
  lowering: Lowering,
  context: Context,
  op: Bytes,
  lhs: Int,
  rhs: Int,
  type_name: String,
  fns: List<String>,
  unfolds: Int,
) -> L / {abort.raise} =
  if is_ordered(op) {
    match context.keys.get(type_name) {
      Some(by) -> {
        let kx = call_named(lowering, context, by, [lhs], unfolds);
        let ky = call_named(kx.lowering, context, by, [rhs], unfolds);
        match sort_of(ky.lowering.terms, kx.id) {
          Some(k) -> if is_con(k, "Int") {
            let lw2 = forced(ky.lowering, kx.id, ky.id);
            on(lw2, cmp(lw2.terms, cmp_of(op), kx.id, ky.id))
          } else if is_con(k, "Float") { float_order(ky.lowering, op, kx.id, ky.id) }
          else { opaque_sym(ky.lowering, OpaqueCall(by)) },
          None -> opaque_sym(ky.lowering, OpaqueCall(by)),
        }
      },
      None -> opaque_sym(lowering, OpaqueCall(type_name)),
    }
  } else {
    let index = if op == b"add" { 0 } else if op == b"sub" { 1 } else { 2 };
    match fns.at(index) {
      Some(f) -> if f == "" { opaque_sym(lowering, OpaqueCall(type_name)) }
      else { call_named(lowering, context, f, [lhs, rhs], unfolds) },
      None -> opaque_sym(lowering, OpaqueCall(type_name)),
    }
  }

/// The program's `==`, read as what the operands' sort says it is: identity where it is, so
/// congruence applies; at `Float`, IEEE's; at `Decimal`, of the values; at a type that states a
/// `key`, of the keys; and part by part where a value holds one of those.
fn equal(lowering: Lowering, context: Context, x: Int, y: Int, unfolds: Int) -> L / {abort.raise} =
  equal_within(lowering, context, x, y, unfolds, max_terms())

/// `room` bounds how deep a comparison reads through keys and parts; past it, the relation alone.
fn equal_within(
  lowering: Lowering,
  context: Context,
  x: Int,
  y: Int,
  unfolds: Int,
  room: Int,
) -> L / {abort.raise} = {
  let sort = compared_sort(lowering, context, x, y);
  // A constructor names its type whatever sort its node was first given.
  let key_of = |t: Int|
    match node(lowering.terms, t) {
      TCtor(c) -> match ctor(context, c.name) {
        Some(k) -> context.keys.get(k.decl.name),
        None -> None,
      },
      _ -> match sort_of(lowering.terms, t) {
        Some(Con(name, _)) -> context.keys.get(name),
        _ -> None,
      },
    };
  let keyed = match key_of(x) { Some(by) -> Some(by), None -> key_of(y) };
  match keyed {
    Some(by) -> if room <= 0 { related(lowering, context, sort, x, y) } else {
      let kx = call_named(lowering, context, by, [x], unfolds);
      let ky = call_named(kx.lowering, context, by, [y], unfolds);
      equal_within(ky.lowering, context, kx.id, ky.id, unfolds, room - 1)
    },
    // `==` with a value of no fields is identity, whatever else the sort holds: `xs == []`.
    None -> if nullary(lowering.terms, x) || nullary(lowering.terms, y) {
      on(lowering, eq(lowering.terms, x, y))
    } else {
      match sort {
        None -> by_shape(lowering, context, x, y, unfolds, room),
        Some(s) -> if is_identity(context, s, lowering.identities) {
          on(lowering, eq(lowering.terms, x, y))
        } else if room <= 0 { related(lowering, context, Some(s), x, y) }
        else if is_con(s, "Float") {
          let rx = float_rank(lowering.terms, x);
          let ry = float_rank(rx.terms, y);
          let same = eq(ry.terms, rx.id, ry.id);
          on(lowering, numbers_both(same.terms, x, y, same.id))
        } else if is_con(s, "Decimal") {
          let nx = decimal_normalized(lowering.terms, x);
          let ny = decimal_normalized(nx.terms, y);
          on(lowering, eq(ny.terms, nx.id, ny.id))
        } else { pointwise(lowering, context, Some(s), x, y, unfolds, room - 1) },
      }
    },
  }
}

/// The sort two operands are compared at: either's, and where both are known and differ (a node of
/// no fields is one term at every sort), the one whose `==` says least.
fn compared_sort(lowering: Lowering, context: Context, x: Int, y: Int) -> Option<Ty> =
  match ((sort_of(lowering.terms, x), sort_of(lowering.terms, y))) {
    (Some(a), Some(b)) -> if a == b || !is_identity(context, a, lowering.identities) { Some(a) }
    else { Some(b) },
    (Some(a), None) -> Some(a),
    (None, b) -> b,
  }

fn nullary(terms: Terms, t: Int) -> Bool / {abort.raise} =
  match node(terms, t) { TNil -> true, TUnit -> true, TCtor(c) -> c.args.len() == 0, _ -> false }

/// `==` of operands no sort is known of, by what their shapes say: a literal of a sort whose `==` is
/// identity, or constructors, cells and records taken apart.
fn by_shape(
  lowering: Lowering,
  context: Context,
  x: Int,
  y: Int,
  unfolds: Int,
  room: Int,
) -> L / {abort.raise} = {
  let plain = |t: Int|
    match node(lowering.terms, t) {
      TInt(_) -> true,
      TBool(_) -> true,
      TStr(_) -> true,
      TFixed(_, _, _) -> true,
      _ -> false,
    };
  if plain(x) || plain(y) { on(lowering, eq(lowering.terms, x, y)) }
  else if room <= 0 { related(lowering, context, None, x, y) }
  else { pointwise(lowering, context, None, x, y, unfolds, room - 1) }
}

/// `==` of two values of a sort holding a part whose `==` is not identity: by constructor, cell or
/// field where both shapes are in view, a record's fields always; otherwise the relation alone.
fn pointwise(
  lowering: Lowering,
  context: Context,
  sort: Option<Ty>,
  x: Int,
  y: Int,
  unfolds: Int,
  room: Int,
) -> L / {abort.raise} = {
  let all = |lw: Lowering, pairs: List<{ a: Int, b: Int }>|
    pairs.fold(on(lw, boolean(lw.terms, true)), |acc: L, p: { a: Int, b: Int }| {
      let e = equal_within(acc.lowering, context, p.a, p.b, unfolds, room - 1);
      on(e.lowering, both(e.lowering.terms, acc.id, e.id))
    });
  match sort {
    Some(Record(fields)) -> {
      let read = fields.fold(
        { lowering: lowering, pairs: [] },
        |acc: { lowering: Lowering, pairs: List<{ a: Int, b: Int }> }, f: { name: String, ty: Ty }| {
          let fx = field(acc.lowering.terms, x, f.name);
          let fy = field(fx.terms, y, f.name);
          {
            lowering: with_terms(acc.lowering, fy.terms),
            pairs: acc.pairs.push({ a: fx.id, b: fy.id }),
          }
        },
      );
      all(read.lowering, read.pairs)
    },
    _ -> match ((node(lowering.terms, x), node(lowering.terms, y))) {
      (TCtor(a), TCtor(b)) -> if a.name != b.name || a.args.len() != b.args.len() {
        on(lowering, boolean(lowering.terms, false))
      } else {
        all(
          lowering,
          range(0, a.args.len()).fold([], |acc: List<{ a: Int, b: Int }>, i: Int|
            match ((a.args.at(i), b.args.at(i))) {
              (Some(p), Some(q)) -> acc.push({ a: p, b: q }),
              _ -> acc,
            }),
        )
      },
      (TNil, TNil) -> on(lowering, boolean(lowering.terms, true)),
      (TNil, TCons(_)) -> on(lowering, boolean(lowering.terms, false)),
      (TCons(_), TNil) -> on(lowering, boolean(lowering.terms, false)),
      (TCons(a), TCons(b)) -> all(lowering, [{ a: a.head, b: b.head }, { a: a.tail, b: b.tail }]),
      (TRecord(a), TRecord(b)) -> if a.map(|f: { name: String, value: Int }| f.name)
          != b.map(|f: { name: String, value: Int }| f.name) {
        related(lowering, context, sort, x, y)
      } else {
        all(
          lowering,
          range(0, a.len()).fold([], |acc: List<{ a: Int, b: Int }>, i: Int|
            match ((a.at(i), b.at(i))) {
              (Some(p), Some(q)) -> acc.push({ a: p.value, b: q.value }),
              _ -> acc,
            }),
        )
      },
      _ -> related(lowering, context, sort, x, y),
    },
  }
}

/// `x == y` at `sort` as the relation alone. Where either value may hold a keyed one, `==` calls a
/// key no term here reads, which may end the run.
fn related(
  lowering: Lowering,
  context: Context,
  sort: Option<Ty>,
  x: Int,
  y: Int,
) -> L / {abort.raise} = {
  let sorts = [sort_of(lowering.terms, x), sort_of(lowering.terms, y)];
  // A sort that leaves nothing unsettled is both operands' type.
  let settled = sorts.filter(|s: Option<Ty>|
    match s { Some(t) -> !vars(t, []).any(|v: Int| v >= foreign_base()), None -> false });
  let keyed = match settled.at(0) {
    Some(s) -> may_call_key(context, s),
    None -> sorts.any(|s: Option<Ty>| may_call_key(context, s)),
  };
  let lw = if keyed { undefined(blocked(lowering, OpaqueCall("=="))) } else { lowering };
  let reflexive = match sort {
    Some(t) -> is_reflexive(context, t, lowering.identities),
    None -> false,
  };
  on(lw, equal_at(lw.terms, x, y, reflexive))
}

/// Of two sorts one value may have, the one that knows more: a sort whose type arguments are known
/// over one whose are not.
fn surer(a: Option<Ty>, b: Option<Ty>) -> Option<Ty> =
  match a {
    Some(s) -> if vars(s, []).any(|v: Int| v >= foreign_base()) && b != None { b } else { a },
    None -> b,
  }

/// Whether `Int`'s operators are the ones applied: either operand is of a sort no variable leaves
/// open. Of no sort or of a variable, both may be `Float`s or of a type stating its own.
fn int_operands(terms: Terms, lhs: Int, rhs: Int) -> Bool / {abort.raise} =
  [lhs, rhs].any(|t: Int|
    match sort_of(terms, t) { Some(s) -> vars(s, []).len() == 0, None -> false })

/// An operator over operands of no known type: a function of them, which may raise.
fn unknown_operator(lowering: Lowering, op: Bytes, lhs: Int, rhs: Int) -> L / {abort.raise} = {
  let lw2 = undefined(blocked(lowering, OpaqueCall(String::of_bytes_lossy(op))));
  let head = opaque(lw2.terms, "operator " ++ String::of_bytes_lossy(op), None);
  on(lw2, app(head.terms, head.id, [lhs, rhs], if is_ordered(op) { Some(bool_ty()) } else { None }))
}

fn forced(lowering: Lowering, a: Int, b: Int) -> Lowering / {abort.raise} =
  with_terms(lowering, force_int(force_int(lowering.terms, a), b))

fn binary(
  lowering: Lowering,
  context: Context,
  op: Bytes,
  lhs: Int,
  rhs: Int,
  unfolds: Int,
) -> L / {abort.raise} =
  match if is_arithmetic(op) || is_ordered(op) { operand_type(context, lowering.terms, lhs, rhs) }
    else { None } {
    Some(numeric) -> non_int_operator(lowering, context, op, lhs, rhs, numeric, unfolds),
    None -> if (is_arithmetic(op) || is_ordered(op)) && !int_operands(lowering.terms, lhs, rhs) {
      unknown_operator(lowering, op, lhs, rhs)
    } else if is_arithmetic(op) {
      let lw2 = forced(lowering, lhs, rhs);
      let folded = if op == b"add" { add(lw2.terms, lhs, rhs) }
      else if op == b"sub" { sub(lw2.terms, lhs, rhs) }
      else if op == b"mul" { mul(lw2.terms, lhs, rhs) }
      // Uninterpreted even by a literal, so `x / 2 * 2 == x` can never be proved.
      else { None };
      match folded {
        Some(t) -> { lowering: require_int_range(with_terms(lw2, t.terms), t.id), id: t.id },
        None -> {
          let literal_factor = (match node(lw2.terms, lhs) { TInt(_) -> true, _ -> false })
            || (match node(lw2.terms, rhs) { TInt(_) -> true, _ -> false });
          let divided = op == b"div" || op == b"rem";
          let lw3 = blocked(lw2, if divided { Division }
          else if op == b"mul" && !literal_factor { NonlinearMultiplication }
          else { CoefficientRange });
          // Uninterpreted as values, but their definedness is decidable; everything else left `Int`.
          let lw4 = if divided { require_divisible(lw3, lhs, rhs) } else { undefined(lw3) };
          let head = opaque(lw4.terms, arith_symbol(op), None);
          let term = app(head.terms, head.id, [lhs, rhs], Some(int_ty()));
          { lowering: with_terms(lw4, force_int(term.terms, term.id)), id: term.id }
        },
      }
    } else if is_ordered(op) {
      let lw2 = forced(lowering, lhs, rhs);
      on(lw2, cmp(lw2.terms, cmp_of(op), lhs, rhs))
    } else if op == b"and" { on(lowering, and(lowering.terms, lhs, rhs)) }
    else if op == b"or" { on(lowering, or(lowering.terms, lhs, rhs)) }
    // `==` on functions is a type error, so it needs no requirement here.
    else if op == b"eq" { equal(lowering, context, lhs, rhs, unfolds) } else if op == b"ne" {
      let e = equal(lowering, context, lhs, rhs, unfolds);
      on(e.lowering, not(e.lowering.terms, e.id))
    } else if op == b"concat" {
      let lw2 = blocked(lowering, Concat);
      let head = opaque(lw2.terms, op_concat(), None);
      // Both sides share one sort, so either side that has one gives the answer's.
      let sort = match sort_of(head.terms, lhs) {
        Some(s) -> s,
        None -> match sort_of(head.terms, rhs) { Some(s) -> s, None -> string_ty() },
      };
      on(lw2, app(head.terms, head.id, [lhs, rhs], Some(sort)))
    } else {
      // Uninterpreted. Folding `x << 1` into `2·x` is wrong: the evaluator refutes `x << 1 > x`
      // at `x = 2^62`.
      let lw2 = blocked(forced(lowering, lhs, rhs), BitOperator);
      let shift = op == b"shl" || op == b"shr" || op == b"ushr";
      let lw3 = if shift { require_shift_count(lw2, rhs) } else { lw2 };
      let symbol = if op == b"bitand" { op_bit_and() }
      else if op == b"bitor" { op_bit_or() }
      else if op == b"bitxor" { op_bit_xor() }
      else if op == b"shl" { op_shl() }
      else if op == b"shr" { op_shr() }
      else { op_ushr() };
      let head = opaque(lw3.terms, symbol, None);
      let term = app(head.terms, head.id, [lhs, rhs], Some(int_ty()));
      { lowering: with_terms(lw3, force_int(term.terms, term.id)), id: term.id }
    },
  }

type Callee = | Local | Named(String) | Unresolved(String) | Other

/// Decided from the code, not the head's term: a local and a same-named definition lower alike.
fn callee(context: Context, func: Code) -> Callee =
  match func.node {
    NVar(v) -> match v.slot {
      Some(_) -> Local,
      None -> {
        let name = String::of_bytes_lossy(v.name);
        if ctor(context, name) != None || signature(context, name) != None { Named(name) }
        else { Unresolved(name) }
      },
    },
    _ -> Other,
  }

fn lowered_args(
  lowering: Lowering,
  context: Context,
  args: List<Code>,
  unfolds: Int,
) -> { lowering: Lowering, ids: List<Int> } / {abort.raise} =
  args.fold(
    { lowering: lowering, ids: [] },
    |acc: { lowering: Lowering, ids: List<Int> }, a: Code| {
      let r = lower(acc.lowering, context, a, unfolds);
      { lowering: r.lowering, ids: acc.ids.push(r.id) }
    },
  )

fn application(
  lowering: Lowering,
  context: Context,
  func: Code,
  args: List<Code>,
  unfolds: Int,
) -> L / {abort.raise} = {
  let lowered = lowered_args(lowering, context, args, unfolds);
  match func.node {
    NLambda(l) -> if l.params == lowered.ids.len() {
      apply_lambda(lowered.lowering, context, lowered.ids, l.captures, l.body, unfolds)
    } else { call(lowered.lowering, context, func, lowered.ids, unfolds) },
    _ -> call(lowered.lowering, context, func, lowered.ids, unfolds),
  }
}

fn apply_lambda(
  lowering: Lowering,
  context: Context,
  args: List<Int>,
  caps: List<Capture>,
  body: Code,
  unfolds: Int,
) -> L / {abort.raise} = {
  let captured = caps.fold(
    { lowering: lowering, window: args.map(|t: Int| Some(t)) },
    |acc: { lowering: Lowering, window: List<Option<Int>> }, cap: Capture| {
      let r = local(acc.lowering, cap.src);
      let grown = if acc.window.len() <= cap.dst {
        range(acc.window.len(), cap.dst + 1).fold(acc.window, |w: List<Option<Int>>, _: Int|
          w.push(None))
      } else { acc.window };
      { lowering: r.lowering, window: grown.set(cap.dst, Some(r.id)) }
    },
  );
  let r = lower(
    { ..captured.lowering, window: captured.window, inducting: None },
    context,
    body,
    unfolds,
  );
  {
    lowering: { ..r.lowering, window: captured.lowering.window, inducting: lowering.inducting },
    id: r.id,
  }
}

fn call(
  lowering: Lowering,
  context: Context,
  func: Code,
  args: List<Int>,
  unfolds: Int,
) -> L / {abort.raise} = {
  let who = callee(context, func);
  let head = lower(lowering, context, func, unfolds);
  let r = call_head(head, context, who, args, unfolds);
  let applied = match who { Named(name) -> ctor(context, name) != None, _ -> false };
  if applied { at_site(r, head.lowering, func.span) } else { r }
}

/// `r`, which a step from `before` made, with `at` among the places a value it counted was built.
fn at_site(r: L, before: Lowering, at: Span) -> L =
  if r.lowering.built.len() > before.built.len() {
    { lowering: { ..r.lowering, seen: r.lowering.seen.push(at) }, id: r.id }
  } else { r }

/// A call of the definition, builtin or constructor `name` over terms already made.
fn call_named(
  lowering: Lowering,
  context: Context,
  name: String,
  args: List<Int>,
  unfolds: Int,
) -> L / {abort.raise} = {
  let who = if ctor(context, name) != None || signature(context, name) != None { Named(name) }
  else { Unresolved(name) };
  call_head(global(lowering, context, name), context, who, args, unfolds)
}

fn call_head(
  head: L,
  context: Context,
  who: Callee,
  args: List<Int>,
  unfolds: Int,
) -> L / {abort.raise} = {
  let arg_sorts = args.map(|a: Int| sort_of(head.lowering.terms, a));
  let head_sort = match sort_of(head.lowering.terms, head.id) {
    Some(Fn(params, ret, _)) -> answered(params, arg_sorts, ret),
    _ -> None,
  };
  // A total builtin is a function of its arguments, so two calls over one argument are one term.
  let total_builtin = match who {
    Unresolved(name) -> builtin_answers(context, name, arg_sorts),
    _ -> false,
  };
  let sort = match who {
    Unresolved(name) -> match builtin(context, name) {
      Some(b) -> match b.ty { Fn(params, ret, _) -> answered(params, arg_sorts, ret), _ -> None },
      None -> head_sort,
    },
    _ -> head_sort,
  };
  let pure0 = total_builtin || head_is_pure(head.lowering.terms, head.id)
    || (match who {
      Unresolved(name) -> match builtin(context, name) { Some(b) -> b.pure, None -> false },
      _ -> false,
    });
  let opened = match node(head.lowering.terms, head.id) {
    TClosure(k) -> Done(applied_closure(head.lowering, context, k, head.id, args, unfolds)),
    TOpaque(name) -> if total_builtin { Keep(pure0, head.lowering, false) } else {
      match match ctor(context, name) {
          Some(_) -> None,
          None -> list_higher(head.lowering, context, name, head.id, args, sort, unfolds),
        } {
        Some(r) -> Done(r),
        None -> match ctor(context, name) {
          Some(c) -> if arity(c) == args.len() {
            Done(
              built_value(
                on(
                  head.lowering,
                  mk(
                    head.lowering.terms,
                    TCtor({ name: name, args: args }),
                    ctor_result_sort(c, args, head.lowering.terms),
                  ),
                ),
                context,
                c,
                unfolds,
              ),
            )
          } else { Keep(pure0, head.lowering, false) },
          None -> {
            let told = instances(head.lowering, context, name, args, unfolds);
            // A recursive call a lemma takes apart is the value its facts describe, not one to unroll.
            if told.apart && is_recursive(context, name) && is_pure(context, name) {
              let made = on(told.lowering, app(told.lowering.terms, head.id, args, sort));
              Done({
                lowering: { ..made.lowering, defined: made.lowering.defined.push(made.id) },
                id: made.id,
              })
            } else {
              match try_unfold(told.lowering, context, name, head.id, sort, args, unfolds) {
                Some(r) -> Done(r),
                None ->
                  Keep(
                    is_pure(context, name) || through_pure(told.lowering, context, name, args),
                    note_unfold_refusal(told.lowering, context, name),
                    told.fitted,
                  ),
              }
            }
          },
        },
      }
    },
    _ -> Keep(pure0, head.lowering, false),
  };
  match opened {
    Done(r) -> r,
    Keep(pure, lw2, fitted) -> {
      let answered = kept_call(lw2, context, who, head, args, sort, pure, fitted, unfolds);
      // What a call answers holds its type's invariant unless the claim made a value of a type that
      // states one, which the call may have been handed.
      if answered.lowering.tainted.len() > 0 { answered } else {
        {
          ..answered,
          lowering: invariants_held(answered.lowering, context, [answered.id], unfolds),
        }
      }
    },
  }
}

/// A call not unfolded: by its contract where one is in hand, a value of its arguments where it is
/// a function of them, and a fresh value where it is not.
fn kept_call(
  lw2: Lowering,
  context: Context,
  who: Callee,
  head: L,
  args: List<Int>,
  sort: Option<Ty>,
  pure: Bool,
  fitted: Bool,
  unfolds: Int,
) -> L / {abort.raise} = {
  let total = fitted || callee_is_total(lw2, context, who, head.id, args);
  // A definition whose contract is in hand answers wherever its `requires` hold.
  match match who {
      Named(name) -> if total || !pure { None }
      else { contracted(lw2, context, name, head.id, args, sort, unfolds) },
      _ -> None,
    } {
    Some(r) -> r,
    None -> {
      let lw3 = if !total { undefined(lw2) } else { lw2 };
      match match who {
          Unresolved(name) -> match folded_builtin(lw3, name, args) {
            Some(r) -> Some(r),
            None -> list_builtin(lw3, name, head.id, args),
          },
          _ -> None,
        } {
        Some(r) -> r,
        None -> if !pure {
          // A call not known to be a function of its arguments gets a fresh symbol per occurrence.
          on({ ..lw3, impure: true }, sym(lw3.terms, sort))
        } else {
          let made = on(lw3, app(lw3.terms, head.id, args, sort));
          let total_named = match who { Named(name) -> lw3.total.contains(name), _ -> false };
          if total_named {
            { lowering: { ..made.lowering, calls: made.lowering.calls.push(made.id) }, id: made.id }
          } else { made }
        },
      }
    },
  }
}

/// `Keep(pure, lowering, answers)`: `answers` where a proved law fit the call, which a law's run
/// evaluates at every point, so the call answers wherever it fits.
type Opened = | Done(L) | Keep(Bool, Lowering, Bool)

/// A value a constructor built: where the body is read for the values it builds of that
/// constructor's type, the invariant at it is owed, on the way to it.
fn built_value(made: L, context: Context, c: Ctor, unfolds: Int) -> L / {abort.raise} = {
  let lw = constructing(made.lowering, context, c);
  match lw.building {
    Some(b) -> if b.type_name != c.decl.name || unfolds <= 0 { { lowering: lw, id: made.id } }
    else {
      let checked = call_named({ ..lw, building: None }, context, b.by, [made.id], unfolds - 1);
      let owed = under_path(checked.lowering, checked.id);
      {
        lowering: { ..owed.lowering, building: Some(b), built: owed.lowering.built.push(owed.id) },
        id: made.id,
      }
    },
    None -> { lowering: lw, id: made.id },
  }
}

/// `lowering` having applied a constructor of `c`'s type, where that type states an invariant.
fn constructing(lowering: Lowering, context: Context, c: Ctor) -> Lowering =
  if !context.invariants.contains(c.decl.name) || lowering.constructed.contains(c.decl.name) {
    lowering
  } else { { ..lowering, constructed: lowering.constructed.push(c.decl.name) } }

/// Each of `ts` that is a value of a type stating an invariant satisfies it: only the type's module
/// builds one, and each value it builds is shown to.
pub fn invariants_held(
  lowering: Lowering,
  context: Context,
  ts: List<Int>,
  unfolds: Int,
) -> Lowering / {abort.raise} =
  if unfolds <= 0 { lowering } else {
    ts.fold(lowering, |lw: Lowering, t: Int|
      match sort_of(lw.terms, t) {
        Some(Con(name, _)) -> match context.invariants.get(name) {
          Some(by) -> {
            let r = call_named(
              { ..lw, path: [], building: None, inducting: None },
              context,
              by,
              [t],
              unfolds - 1,
            );
            {
              ..facts_on_path(lw, { ..r.lowering, facts: r.lowering.facts.push(r.id) }),
              building: lw.building,
              inducting: lw.inducting,
              requirements: lw.requirements,
              blockers: lw.blockers,
            }
          },
          None -> lw,
        },
        _ -> lw,
      })
  }

/// Whether a law over `declared` binders, bound at `terms`, says the calls it fits answer: not where
/// a binder holds a function, whose answering the law stood on and no other function may; nor where
/// a binder's type variable is settled at a value a key is called on, which the law never met.
fn stands_alike(
  lowering: Lowering,
  context: Context,
  declared: List<Ty>,
  terms: List<Int>,
) -> Bool =
  !declared.any(|t: Ty| holds_function(context, t))
    && !keyed_at_variable(lowering, context, declared, terms)

/// Whether a variable of `declared`, settled by the sorts of `terms`, may be a type whose `==` calls
/// a key, or is settled by a term of no sort known: generic code was shown at no such type.
fn keyed_at_variable(
  lowering: Lowering,
  context: Context,
  declared: List<Ty>,
  terms: List<Int>,
) -> Bool =
  context.compared_by_key.len() > 0
    && (match range(0, declared.len()).fold(
        Some(Map::new()),
        |acc: Option<Map<Int, Ty>>, i: Int|
          match ((acc, declared.at(i), terms.at(i))) {
            (Some(m), Some(d), Some(t)) -> if vars(d, []).len() == 0 { acc }
            else { match sort_of(lowering.terms, t) { Some(s) -> unified(d, s, m), None -> None } },
            _ -> acc,
          },
      ) {
      None -> true,
      Some(settled) -> settled.values().any(|s: Ty| may_call_key(context, Some(s))),
    })

/// Whether a value of `ty` is or holds a function, through any declaration.
fn holds_function(context: Context, ty: Ty) -> Bool = function_within(context, ty, [], 64)

fn function_within(context: Context, ty: Ty, seen: List<String>, room: Int) -> Bool =
  room <= 0
    || (match ty {
      Var(_) -> false,
      Fn(_, _, _) -> true,
      Record(fields) ->
        fields.any(|f: { name: String, ty: Ty }| function_within(context, f.ty, seen, room - 1)),
      Con(n, args) ->
        args.any(|a: Ty| function_within(context, a, seen, room - 1))
          || (!seen.contains(n)
          && (match context.decls.get(n) {
            Some(decl) ->
              decl.variants.any(|v: Variant|
                v.fields.any(|f: Ty| function_within(context, f, seen.push(n), room - 1))),
            None -> false,
          })),
    })

/// Whether a value of `ty` can hold one of the types `names`, at any depth and through any
/// declaration. A type variable holds none: what stands on it was shown at every type.
fn mentions_any(context: Context, ty: Ty, names: List<String>) -> Bool =
  names.len() > 0 && holds_any(context, ty, names, [], 64)

fn holds_any(context: Context, ty: Ty, names: List<String>, seen: List<String>, room: Int) -> Bool =
  room <= 0
    || (match ty {
      Var(_) -> false,
      Con(n, args) ->
        names.contains(n) || args.any(|a: Ty| holds_any(context, a, names, seen, room - 1))
          || (!seen.contains(n)
          && (match context.decls.get(n) {
            Some(decl) ->
              decl.variants.any(|v: Variant|
                v.fields.any(|f: Ty| holds_any(context, f, names, seen.push(n), room - 1))),
            None -> false,
          })),
      Fn(params, ret, _) ->
        params.any(|p: Ty| holds_any(context, p, names, seen, room - 1))
          || holds_any(context, ret, names, seen, room - 1),
      Record(fields) ->
        fields.any(|f: { name: String, ty: Ty }| holds_any(context, f.ty, names, seen, room - 1)),
    })

/// A call of `name` read by its contract, where one is in hand: a proved `ensures` shows the body
/// answers wherever the `requires` hold, so the call owes them, and each clause holds of what it
/// answers there. A proved clause holds of the call where the call is reached; the clause being
/// proved holds of a call back into its definition only on the way to that call, which the
/// definition's run makes before it answers. What reading the clauses owes is owed by the run that
/// proves them. A generic callee was proved at no value whose comparison calls a key.
fn contracted(
  lowering: Lowering,
  context: Context,
  name: String,
  head: Int,
  args: List<Int>,
  sort: Option<Ty>,
  unfolds: Int,
) -> Option<L> / {abort.raise} =
  if unfolds <= 0 || !answers_by_contract(lowering, context, name) { None } else {
    match context.claims.defs.get(name) {
      None -> None,
      Some(d) -> {
        let ensures = d.spec.filter(|c: ClaimClause| c.kind == SEnsures);
        let requires = d.spec.filter(|c: ClaimClause| c.kind == SRequires);
        let proved = context.claims.trusted.contains(name) || lowering.contracts.contains(name);
        let usable = |i: Int| proved || lowering.inducting == Some({ name: name, clause: i });
        if !range(0, ensures.len()).any(usable) { None } else {
          let made = app(lowering.terms, head, args, sort);
          let call = made.id;
          let params = match signature(context, name) {
            Some(s) -> match s.ty { Fn(ps, _, _) -> ps, _ -> [] },
            None -> [],
          };
          if keyed_at_variable(lowering, context, params, args) { None } else {
            let scratch = {
              ..with_terms(lowering, made.terms),
              path: [],
              depth: lowering.depth + 1,
              inducting: None,
            };
            let guard = requires.fold(
              { lowering: scratch, id: true_id() },
              |acc: L, c: ClaimClause| {
                let r = lower_opt(
                  { ..acc.lowering, window: args.map(|t: Int| Some(t)) },
                  context,
                  c.clause.code,
                  unfolds - 1,
                );
                on(r.lowering, both(r.lowering.terms, acc.id, r.id))
              },
            );
            let stated = range(0, ensures.len()).fold(guard.lowering, |lw: Lowering, i: Int|
              if !usable(i) { lw } else {
                match ensures.at(i) {
                  None -> lw,
                  Some(c) -> {
                    let e = lower_opt(
                      { ..lw, window: args.push(call).map(|t: Int| Some(t)) },
                      context,
                      c.clause.code,
                      unfolds - 1,
                    );
                    let unmet = not(e.lowering.terms, guard.id);
                    let stated = or(unmet.terms, unmet.id, e.id);
                    let fact = where_owed(
                      with_terms(e.lowering, stated.terms),
                      lowering,
                      stated.id,
                    );
                    { ..fact.lowering, facts: fact.lowering.facts.push(fact.id) }
                  },
                }
              });
            let back = {
              ..facts_on_path(lowering, stated),
              window: lowering.window,
              depth: lowering.depth,
              inducting: lowering.inducting,
              requirements: lowering.requirements,
              blockers: lowering.blockers,
              rules: note(stated.rules, Contract({ def: name })),
            };
            // Another package's `ensures` claims only what its body answers; this package's contracts
            // were shown with every call answering, and a call back is the run being proved.
            let answering = lowering.contracts.contains(name)
              || (match lowering.inducting { Some(i) -> i.name == name, None -> false });
            let owed = require(back, guard.id);
            Some({ lowering: if answering { owed } else { undefined(owed) }, id: call })
          }
        }
      },
    }
  }

/// Whether a call of `name` may be read by its contract: the checker reads it as ending, its row
/// raises nothing, and none of its parameters is of a type whose invariant this claim may not stand
/// on, which its proof may have. A call back into the definition whose clause is being proved may,
/// whatever it raises: a raise there is one the definition's run makes, and that run answers nothing.
fn answers_by_contract(lowering: Lowering, context: Context, name: String) -> Bool =
  (lowering.tainted.len() == 0
    && (match lowering.inducting { Some(i) -> i.name == name, None -> false }))
    || (ends(context, name)
    && (match signature(context, name) {
      Some(s) ->
        !s.raises
          && (match s.ty {
            Fn(params, _, _) -> !params.any(|p: Ty| mentions_any(context, p, lowering.tainted)),
            _ -> true,
          }),
      None -> false,
    }))

type Told = { lowering: Lowering, apart: Bool, fitted: Bool }

/// Each lemma whose trigger the call `name(args)` fits puts its claim at what the trigger bound into
/// the proof, lowered on one unfolding less, as a definition's body is.
fn instances(
  lowering: Lowering,
  context: Context,
  name: String,
  args: List<Int>,
  unfolds: Int,
) -> Told / {abort.raise} =
  lowering.lemmas.fold(
    { lowering: lowering, apart: false, fitted: false },
    |acc: Told, lemma: Lemma|
      if unfolds <= 0 || lemma.func != name || lemma.args.len() != args.len()
          || lemma.typed.any(|t: Ty| mentions_any(context, t, acc.lowering.tainted)) { acc } else {
        match fitted_all(
            acc.lowering,
            context,
            lemma.args,
            args,
            range(0, lemma.binders).map(|_k: Int| None),
          ) {
          None -> acc,
          Some(binds) -> match Option::all(binds) {
            None -> acc,
            Some(terms) -> if !typed_fit(acc.lowering, context, lemma, terms) { acc } else {
              let answers = stands_alike(acc.lowering, context, lemma.typed, terms);
              {
                lowering: instance(acc.lowering, context, lemma, terms, unfolds - 1),
                apart: acc.apart || (lemma.apart && answers),
                fitted: acc.fitted || answers,
              }
            },
          },
        }
      },
  )

/// A law is a fact at the terms its trigger bound only where each is of its binder's type, the law's
/// variables settled alike throughout, and each variable an `identity` constraint is on settled at a
/// type whose `==` is identity.
fn typed_fit(lowering: Lowering, context: Context, lemma: Lemma, terms: List<Int>) -> Bool =
  match range(0, lemma.typed.len()).fold(Some(Map::new()), |acc: Option<Map<Int, Ty>>, i: Int|
      match acc {
        None -> None,
        Some(m) -> match ((lemma.typed.at(i), terms.at(i))) {
          (Some(declared), Some(t)) -> match sort_of(lowering.terms, t) {
            Some(actual) -> unified(declared, actual, m),
            None -> None,
          },
          _ -> None,
        },
      }) {
    None -> false,
    Some(settled) ->
      lemma.identities.all(|v: Int|
        match settled.get(v) {
          Some(s) -> is_identity(context, s, lowering.identities),
          None -> false,
        }),
  }

fn fitted_all(
  lowering: Lowering,
  context: Context,
  patterns: List<Code>,
  ts: List<Int>,
  binds: List<Option<Int>>,
) -> Option<List<Option<Int>>> / {abort.raise} =
  if patterns.len() != ts.len() { None } else {
    range(0, patterns.len()).fold(Some(binds), |acc: Option<List<Option<Int>>>, i: Int|
      match acc {
        None -> None,
        Some(bs) -> match ((patterns.at(i), ts.at(i))) {
          (Some(p), Some(t)) -> fitted(lowering, context, p, t, bs),
          _ -> None,
        },
      })
  }

/// What the trigger's pattern binds when the term `t` fits it: a binder binds the term, a global or a
/// literal is the term it lowers to, and a call or a list fits one of the same shape.
fn fitted(
  lowering: Lowering,
  context: Context,
  pattern: Code,
  t: Int,
  binds: List<Option<Int>>,
) -> Option<List<Option<Int>>> / {abort.raise} =
  match pattern.node {
    NVar(v) -> match v.slot {
      Some(k) -> match binds.at(k) {
        Some(Some(u)) -> if u == t { Some(binds) } else { None },
        Some(None) -> Some(binds.set(k, Some(t))),
        None -> None,
      },
      None -> if global(lowering, context, String::of_bytes_lossy(v.name)).id == t { Some(binds) }
      else { None },
    },
    NLit(l) -> if literal(lowering, l).id == t { Some(binds) } else { None },
    NApp(a) -> match a.func.node {
      NVar(f) -> if f.slot != None { None } else {
        let name = String::of_bytes_lossy(f.name);
        match node(lowering.terms, t) {
          TApp(called) -> match node(lowering.terms, called.head) {
            TOpaque(h) -> if h == name { fitted_all(lowering, context, a.args, called.args, binds) }
            else { None },
            _ -> None,
          },
          TCtor(k) -> if k.name == name { fitted_all(lowering, context, a.args, k.args, binds) }
          else { None },
          _ -> None,
        }
      },
      _ -> None,
    },
    NList(l) -> {
      let s = spine(lowering.terms, t);
      match node(lowering.terms, s.end) {
        TNil -> fitted_all(lowering, context, l.items, s.heads, binds),
        _ -> None,
      }
    },
    _ -> None,
  }

/// The law at `terms`, lowered where nothing has been assumed and no lemma fits, so a law's instance
/// never asks for another. A proved law holds and is defined at every value of its binders' types,
/// so what lowering it owes is not owed and the calls it makes are values; not where a binder holds
/// a function, or a keyed value at a type variable, which the law never met: there the fact holds
/// only where its reading answers.
fn instance(
  lowering: Lowering,
  context: Context,
  lemma: Lemma,
  terms: List<Int>,
  unfolds: Int,
) -> Lowering / {abort.raise} = {
  let r = lower(
    {
      ..lowering,
      window: terms.map(|t: Int| Some(t)),
      path: [],
      depth: lowering.depth + 1,
      lemmas: [],
      inducting: None,
    },
    context,
    lemma.body,
    unfolds,
  );
  let alike = stands_alike(lowering, context, lemma.typed, terms);
  let fact = where_owed(r.lowering, if alike { lowering } else { r.lowering }, r.id);
  {
    ..facts_on_path(lowering, { ..fact.lowering, facts: fact.lowering.facts.push(fact.id) }),
    window: lowering.window,
    depth: lowering.depth,
    inducting: lowering.inducting,
    lemmas: lowering.lemmas,
    requirements: lowering.requirements,
    blockers: lowering.blockers,
    calls: lowering.calls,
    defined: if alike { r.lowering.defined.concat(r.lowering.calls.drop(lowering.calls.len())) }
    else { r.lowering.defined },
    rules: note(fact.lowering.rules, Cited({ law: lemma.law, label: lemma.label })),
  }
}

/// `after`, a reading made off to the side of `before`, with each fact it added stated only where
/// `before`'s path holds: a fact made for a call speaks of nothing where the call is not reached.
fn facts_on_path(before: Lowering, after: Lowering) -> Lowering / {abort.raise} = {
  let stated = after.facts.drop(before.facts.len()).fold(
    { lowering: { ..after, path: before.path }, ids: [] },
    |acc: { lowering: Lowering, ids: List<Int> }, f: Int| {
      let u = under_path(acc.lowering, f);
      { lowering: u.lowering, ids: acc.ids.push(u.id) }
    },
  );
  { ..stated.lowering, facts: before.facts.concat(stated.ids) }
}

/// `fact`, about values `owing` was read to, stated where what that reading owes holds: a fact
/// about a call is no ground to take its arguments for values.
fn where_owed(lowering: Lowering, owing: Lowering, fact: Int) -> L / {abort.raise} = {
  let owed = owing.requirements.fold(
    on(lowering, boolean(lowering.terms, true)),
    |acc: L, r: Int| on(acc.lowering, both(acc.lowering.terms, acc.id, r)),
  );
  let unmet = not(owed.lowering.terms, owed.id);
  on(owed.lowering, or(unmet.terms, unmet.id, fact))
}

/// A `Float` builtin over literals: the bits a run answers, which every machine agrees on.
fn folded_builtin(lowering: Lowering, name: String, args: List<Int>) -> Option<L> / {abort.raise} = {
  let float_at = |i: Int|
    match args.at(i) {
      Some(t) -> match node(lowering.terms, t) {
        TFloat(bits) -> Some(Float::of_bits(bits)),
        _ -> None,
      },
      None -> None,
    };
  let int_at = |i: Int|
    match args.at(i) {
      Some(t) -> match node(lowering.terms, t) { TInt(k) -> Some(k), _ -> None },
      None -> None,
    };
  let float = |f: Float| Some(on(lowering, float_lit(lowering.terms, bits_of_float(f))));
  let one = |op: (Float) -> Float| match float_at(0) { Some(x) -> float(op(x)), None -> None };
  let two = |op: (Float, Float) -> Float|
    match ((float_at(0), float_at(1))) { (Some(x), Some(y)) -> float(op(x, y)), _ -> None };
  if name == "Float::sqrt" { one(Float::sqrt) }
  else if name == "Float::exp" { one(Float::exp) }
  else if name == "Float::ln" { one(Float::ln) }
  else if name == "Float::log2" { one(Float::log2) }
  else if name == "Float::log10" { one(Float::log10) }
  else if name == "Float::sin" { one(Float::sin) }
  else if name == "Float::cos" { one(Float::cos) }
  else if name == "Float::tan" { one(Float::tan) }
  else if name == "Float::asin" { one(Float::asin) }
  else if name == "Float::acos" { one(Float::acos) }
  else if name == "Float::atan" { one(Float::atan) }
  else if name == "Float::floor" { one(Float::floor) }
  else if name == "Float::ceil" { one(Float::ceil) }
  else if name == "Float::pow" { two(Float::pow) }
  else if name == "Float::atan2" { two(Float::atan2) }
  else if name == "Float::hypot" { two(Float::hypot) } else if name == "Float::of_int" {
    match int_at(0) { Some(k) -> float(Float::of_int(k)), None -> None }
  } else if name == "Float::of_bits" {
    match int_at(0) { Some(k) -> float(Float::of_bits(k)), None -> None }
  } else if name == "bits_of_float" {
    match float_at(0) {
      Some(x) -> Some(on(lowering, int_lit(lowering.terms, bits_of_float(x)))),
      None -> None,
    }
  } else { None }
}

/// `List::len` and `List::push` over a list whose spine is in view, structurally; where the spine ends in a
/// symbol the call stays, over that symbol.
fn list_builtin(
  lowering: Lowering,
  name: String,
  head: Int,
  args: List<Int>,
) -> Option<L> / {abort.raise} =
  match args {
    [xs] -> if name == "List::len" { list_len(lowering, head, xs) } else { None },
    [xs, x] -> if name == "List::push" { list_push(lowering, head, xs, x) } else { None },
    _ -> None,
  }

/// `map`, `filter` and `fold` over the heads of a spine in view, each function call read where it
/// stands; what is left of a spine that ends in a symbol stays a call over that symbol.
fn list_higher(
  lowering: Lowering,
  context: Context,
  name: String,
  head: Int,
  args: List<Int>,
  sort: Option<Ty>,
  unfolds: Int,
) -> Option<L> / {abort.raise} =
  match args {
    [xs, f] -> if name == prelude_list("map") {
      mapped(lowering, context, name, head, xs, f, sort, unfolds)
    } else if name == prelude_list("filter") { kept(lowering, context, name, head, xs, f, unfolds) }
    else { None },
    [xs, init, f] -> if name == prelude_list("fold") {
      folded(lowering, context, name, head, xs, init, f, sort, unfolds)
    } else { None },
    _ -> None,
  }

/// The name the prelude's own `List::` function goes by.
pub fn prelude_list(op: String) -> String = "std.prelude.List::" ++ op

/// A function value called over terms made already: a closure's body read, a definition called.
fn apply_function(
  lowering: Lowering,
  context: Context,
  f: Int,
  args: List<Int>,
  unfolds: Int,
) -> L / {abort.raise} =
  if unfolds <= 0 {
    let sorts = args.map(|a: Int| sort_of(lowering.terms, a));
    let lw = if function_total(lowering, context, f, sorts) { lowering }
    else { undefined(lowering) };
    if function_pure(lowering, context, f) { on(lw, app(lw.terms, f, args, None)) }
    else { on({ ..lw, impure: true }, sym(lw.terms, None)) }
  } else {
    match node(lowering.terms, f) {
      TClosure(k) -> applied_closure(lowering, context, k, f, args, unfolds - 1),
      TOpaque(name) -> call_named(lowering, context, name, args, unfolds - 1),
      _ -> call_head({ lowering: lowering, id: f }, context, Local, args, unfolds - 1),
    }
  }

/// What is left of a list call once its spine in view is read: one term over the rest, which answers
/// and is one value as the function it is handed does and is.
fn remainder(
  lowering: Lowering,
  context: Context,
  name: String,
  head: Int,
  args: List<Int>,
  sort: Option<Ty>,
) -> L / {abort.raise} = {
  let f = match args.at(args.len() - 1) { Some(t) -> t, None -> 0 };
  // `f` is handed the list's elements and what the other arguments start it at.
  let sorts = args.take(args.len() - 1).map(|a: Int| sort_of(lowering.terms, a));
  let lw = if function_total(lowering, context, f, sorts) { lowering } else { undefined(lowering) };
  if function_pure(lowering, context, f) { on(lw, app(lw.terms, head, args, sort)) }
  else { on({ ..lw, impure: true }, sym(lw.terms, sort)) }
}

fn mapped(
  lowering: Lowering,
  context: Context,
  name: String,
  head: Int,
  xs: Int,
  f: Int,
  sort: Option<Ty>,
  unfolds: Int,
) -> Option<L> / {abort.raise} = {
  let s = spine(lowering.terms, xs);
  let at_nil = match node(lowering.terms, s.end) { TNil -> true, _ -> false };
  if s.heads.len() == 0 && !at_nil { Some(remainder(lowering, context, name, head, [xs, f], sort)) }
  else {
    let applied = s.heads.fold(
      { lowering: lowering, ids: [] },
      |acc: { lowering: Lowering, ids: List<Int> }, h: Int| {
        let r = apply_function(acc.lowering, context, f, [h], unfolds);
        { lowering: r.lowering, ids: acc.ids.push(r.id) }
      },
    );
    let out = match sort {
      Some(t) -> Some(t),
      None -> match applied.ids.at(0) {
        Some(first) -> match sort_of(applied.lowering.terms, first) {
          Some(e) -> Some(list_ty(e)),
          None -> None,
        },
        None -> None,
      },
    };
    let tail = if at_nil { on(applied.lowering, nil(applied.lowering.terms, out)) }
    else { remainder(applied.lowering, context, name, head, [s.end, f], out) };
    Some(consed(tail, applied.ids, out))
  }
}

/// `items` in front of `tail`.
fn consed(tail: L, items: List<Int>, sort: Option<Ty>) -> L / {abort.raise} =
  range(0, items.len()).fold(tail, |acc: L, k: Int|
    match items.at(items.len() - 1 - k) {
      Some(item) -> on(acc.lowering, cons(acc.lowering.terms, item, acc.id, sort)),
      None -> acc,
    })

fn kept(
  lowering: Lowering,
  context: Context,
  name: String,
  head: Int,
  xs: Int,
  f: Int,
  unfolds: Int,
) -> Option<L> / {abort.raise} = {
  let s = spine(lowering.terms, xs);
  let at_nil = match node(lowering.terms, s.end) { TNil -> true, _ -> false };
  let sort = sort_of(lowering.terms, xs);
  if s.heads.len() == 0 && !at_nil { Some(remainder(lowering, context, name, head, [xs, f], sort)) }
  else {
    let tested = s.heads.fold(
      { lowering: lowering, ids: [] },
      |acc: { lowering: Lowering, ids: List<Int> }, h: Int| {
        let r = apply_function(acc.lowering, context, f, [h], unfolds);
        { lowering: r.lowering, ids: acc.ids.push(r.id) }
      },
    );
    let tail = if at_nil { on(tested.lowering, nil(tested.lowering.terms, sort)) }
    else { remainder(tested.lowering, context, name, head, [s.end, f], sort) };
    Some(
      range(0, s.heads.len()).fold(tail, |acc: L, k: Int| {
        let i = s.heads.len() - 1 - k;
        match ((s.heads.at(i), tested.ids.at(i))) {
          (Some(h), Some(c)) -> {
            let kept_cell = cons(acc.lowering.terms, h, acc.id, sort);
            on(
              acc.lowering,
              mk(
                kept_cell.terms,
                TIf({ cond: c, then_branch: kept_cell.id, else_branch: acc.id }),
                sort,
              ),
            )
          },
          _ -> acc,
        }
      }),
    )
  }
}

fn folded(
  lowering: Lowering,
  context: Context,
  name: String,
  head: Int,
  xs: Int,
  init: Int,
  f: Int,
  sort: Option<Ty>,
  unfolds: Int,
) -> Option<L> / {abort.raise} = {
  let s = spine(lowering.terms, xs);
  let at_nil = match node(lowering.terms, s.end) { TNil -> true, _ -> false };
  if s.heads.len() == 0 && !at_nil {
    Some(remainder(lowering, context, name, head, [xs, init, f], sort))
  } else {
    let stepped = s.heads.fold({ lowering: lowering, id: init }, |acc: L, h: Int|
      apply_function(acc.lowering, context, f, [acc.id, h], unfolds));
    if at_nil { Some(stepped) } else {
      Some(
        remainder(stepped.lowering, context, name, head, [s.end, stepped.id, f], match sort {
          Some(t) -> Some(t),
          None -> sort_of(stepped.lowering.terms, stepped.id),
        }),
      )
    }
  }
}

fn spine(terms: Terms, xs: Int) -> { heads: List<Int>, end: Int } / {abort.raise} =
  iterate({ heads: [], end: xs }, size(terms) + 1, |s: { heads: List<Int>, end: Int }|
    match node(terms, s.end) {
      TCons(c) -> Continue({ heads: s.heads.push(c.head), end: c.tail }),
      _ -> Stop(s),
    })

fn list_len(lowering: Lowering, head: Int, xs: Int) -> Option<L> / {abort.raise} = {
  let s = spine(lowering.terms, unmapped(lowering.terms, xs));
  let end = unmapped(lowering.terms, s.end);
  match node(lowering.terms, s.end) {
    TNil -> Some(on(lowering, int_lit(lowering.terms, s.heads.len()))),
    _ -> if s.heads.len() == 0 && end == xs { None } else if s.heads.len() == 0 {
      let made = app(lowering.terms, head, [end], Some(int_ty()));
      Some({ lowering: with_terms(lowering, force_int(made.terms, made.id)), id: made.id })
    } else {
      let rest = app(lowering.terms, head, [end], Some(int_ty()));
      let k = int_lit(rest.terms, s.heads.len());
      match add(k.terms, k.id, rest.id) {
        Some(sum) ->
          Some({
            lowering: require_int_range(with_terms(lowering, sum.terms), sum.id),
            id: sum.id,
          }),
        None -> None,
      }
    },
  }
}

/// A `map` is as long as what it maps, so its length reads through it.
fn unmapped(terms: Terms, xs: Int) -> Int / {abort.raise} =
  match node(terms, xs) {
    TApp(a) -> match ((node(terms, a.head), a.args)) {
      (TOpaque(name), [inner, _]) -> if name == prelude_list("map") { inner } else { xs },
      _ -> xs,
    },
    _ -> xs,
  }

fn list_push(lowering: Lowering, head: Int, xs: Int, x: Int) -> Option<L> / {abort.raise} = {
  let sort = sort_of(lowering.terms, xs);
  let s = spine(lowering.terms, xs);
  let at_nil = match node(lowering.terms, s.end) { TNil -> true, _ -> false };
  if !at_nil && s.heads.len() == 0 { None } else {
    let last = if at_nil {
      let empty = nil(lowering.terms, sort);
      cons(empty.terms, x, empty.id, sort)
    } else { app(lowering.terms, head, [s.end, x], sort) };
    let built = range(0, s.heads.len()).fold(last, |acc: Made, k: Int|
      match s.heads.at(s.heads.len() - 1 - k) {
        Some(h) -> cons(acc.terms, h, acc.id, sort),
        None -> acc,
      });
    Some(on(lowering, built))
  }
}

fn callee_is_total(
  lowering: Lowering,
  context: Context,
  who: Callee,
  head: Int,
  args: List<Int>,
) -> Bool / {abort.raise} =
  match who {
    Local -> function_total(lowering, context, head, args.map(|a: Int| sort_of(lowering.terms, a))),
    Named(name) -> ctor(context, name) != None || lowering.total.contains(name),
    Unresolved(name) ->
      builtin_answers(context, name, args.map(|a: Int| sort_of(lowering.terms, a))),
    Other -> false,
  }

/// Whether a call of the builtin `name` over arguments of `sorts` answers: one of the total ones, and
/// where it compares, over no value whose key's function could end the run.
fn builtin_answers(context: Context, name: String, sorts: List<Option<Ty>>) -> Bool =
  is_total_builtin(name)
    && !((name == "min" || name == "max" || name.starts_with("Map::"))
      && sorts.any(|s: Option<Ty>| may_call_key(context, s)))

fn head_is_pure(terms: Terms, head: Int) -> Bool =
  match sort_of(terms, head) { Some(Fn(_, _, pure)) -> pure, _ -> false }

/// Why `try_unfold` declined; kept in its decision order.
fn note_unfold_refusal(lowering: Lowering, context: Context, name: String) -> Lowering =
  blocked(
    lowering,
    if lowering.depth >= lowering.unfold_limit || lowering.unfold_room <= 0
        || size(lowering.terms) >= max_terms() { UnfoldLimit(name) }
    else if is_recursive(context, name) { RecursiveCall(name) }
    else if !is_pure(context, name) { EffectfulCall(name) }
    else { OpaqueCall(name) },
  )

/// Whether `t` is a tail of `root`, through the list patterns that took it apart.
pub fn smaller_than(lowering: Lowering, t: Int, root: Int) -> Bool =
  range(0, lowering.smaller.len() + 1).fold(
      { at: t, found: None },
      |st: { at: Int, found: Option<Bool> }, _: Int|
        match st.found {
          Some(_) -> st,
          None -> match lowering.smaller.fold(
              None,
              |acc: Option<Int>, s: { tail: Int, from: Int }|
                match acc {
                  Some(_) -> acc,
                  None -> if s.tail == st.at { Some(s.from) } else { None },
                },
            ) {
            None -> { at: st.at, found: Some(false) },
            Some(from) -> if from == root { { at: from, found: Some(true) } }
            else { { at: from, found: None } },
          },
        },
    ).found
    == Some(true)

/// `unfolds` is how many more definitions a path may unfold inside one another: the unfold depth
/// left, carried beside the lowering so it is read off the calls rather than off what they answer.
fn try_unfold(
  lowering: Lowering,
  context: Context,
  name: String,
  head: Int,
  sort: Option<Ty>,
  args: List<Int>,
  unfolds: Int,
) -> Option<L> / {abort.raise} =
  if unfolds <= 0 || lowering.unfold_room <= 0 || size(lowering.terms) >= max_terms() { None }
  else {
    let unrolling = lowering.unrolled.contains(name);
    let whole = args.fold(true, |all: Bool, a: Int| all && in_view(lowering.terms, a));
    // A recursion that ends, over a value in view, runs as a call of it does: as deep as `unfolds`
    // allows, apart from the depth an unfolding inside another counts.
    let over_view = !unrolling && is_recursive(context, name) && ends(context, name)
      && args.any(|a: Int| in_view(lowering.terms, a) && !is_literal(lowering.terms, a))
      && args.all(|a: Int|
        in_view(lowering.terms, a) || scalar(context, sort_of(lowering.terms, a)));
    if !over_view && lowering.depth >= lowering.unfold_limit { None }
    // One step of a recursive definition: the hypothesis speaks about the call that remains. A call
    // on values in view needs no hypothesis, and unrolls as far as the depth allows.
    else if unrolling && lowering.depth >= 1 && !whole { None } else {
      match match unfoldable(context, name) {
          Some(d) -> Some(d),
          None -> if unrolling { self_recursive(context, name) }
          else if over_view { recursive_body(context, name) }
          else { None },
        } {
        None -> None,
        Some(def) -> if def.params != args.len() { None } else {
          let deeper = if over_view { lowering.depth } else { lowering.depth + 1 };
          let lw2 = {
            ..lowering,
            rules: unfolded(lowering.rules, name, deeper),
            depth: deeper,
            unfold_room: lowering.unfold_room - 1,
          };
          let outer = lw2.window;
          let r = lower_opt(
            { ..lw2, window: args.map(|t: Int| Some(t)) },
            context,
            def.body,
            unfolds - 1,
          );
          // A body that answers a value of no sort answers the call's: `[]` is a `List<Int>` here.
          let typed = match sort {
            Some(t) -> if sort_of(r.lowering.terms, r.id) == None {
              mk(r.lowering.terms, node(r.lowering.terms, r.id), Some(t)).terms
            } else { r.lowering.terms },
            None -> r.lowering.terms,
          };
          let back = { ..r.lowering, terms: typed, window: outer, depth: lowering.depth };
          if unrolling {
            let c = app(back.terms, head, args, sort);
            let equation = eq(c.terms, c.id, r.id);
            Some({
              lowering: {
                ..with_terms(back, equation.terms),
                equations: back.equations.push(equation.id),
                defined: back.defined.push(c.id),
              },
              id: r.id,
            })
          } else { Some({ lowering: back, id: r.id }) }
        },
      }
    }
  }

/// Whether a value of `sort` is one no recursion takes apart: a builtin type of no parameters. A
/// recursion over a list or a sum not in view is not unrolled by an argument beside it that is.
fn scalar(context: Context, sort: Option<Ty>) -> Bool =
  match sort {
    Some(Con(name, [])) -> !context.decls.contains(name),
    Some(Fn(_, _, _)) -> true,
    _ -> false,
  }

/// A value the lowering sees all of that a recursion could take apart: a literal, a constructor of
/// them, or a list's whole spine, whatever its elements.
fn in_view(terms: Terms, t: Int) -> Bool / {abort.raise} = seen_whole(terms, t, size(terms))

/// A term's arguments are made before it, so no chain of them is longer than the store.
fn seen_whole(terms: Terms, t: Int, room: Int) -> Bool / {abort.raise} =
  if room <= 0 { false } else {
    match node(terms, t) {
      TInt(_) -> true,
      TBool(_) -> true,
      TStr(_) -> true,
      TDecimal(_) -> true,
      TFloat(_) -> true,
      TFixed(_, _, _) -> true,
      TUnit -> true,
      TClosure(_) -> true,
      TNil -> true,
      TCons(c) -> seen_whole(terms, c.tail, room - 1),
      TCtor(c) -> c.args.fold(true, |all: Bool, a: Int| all && seen_whole(terms, a, room - 1)),
      _ -> false,
    }
  }

fn block(
  lowering: Lowering,
  context: Context,
  stmts: List<CodeStmt>,
  tail: Option<Code>,
  unfolds: Int,
) -> L / {abort.raise} = {
  let after = stmts.fold(lowering, |acc: Lowering, st: CodeStmt|
    match st {
      CLet(l) -> {
        let r = lower(acc, context, l.value, unfolds);
        bind(r.lowering, l.slot, r.id)
      },
      CLetPat(l) -> match l.pat {
        PxWild -> lower(acc, context, l.value, unfolds).lowering,
        PxVar(v) -> {
          let r = lower(acc, context, l.value, unfolds);
          match v.slot { Some(s) -> bind(r.lowering, s, r.id), None -> r.lowering }
        },
        pat -> {
          let r = lower(acc, context, l.value, unfolds);
          match destructured(r.lowering, pat, r.id) {
            Some(bound) -> bound,
            None -> { bind_opaque(blocked(undefined(r.lowering), DestructuringLet), pat) },
          }
        },
      },
      // A statement run for its effect adds nothing a claim's value is made of, but owes what it owes.
      CDo(d) -> lower(acc, context, d.code, unfolds).lowering,
    });
  match tail { Some(t) -> lower(after, context, t, unfolds), None -> on(after, unit(after.terms)) }
}

/// A record pattern's names bound to the fields they read, at any depth; none for a pattern that can
/// miss.
fn destructured(lowering: Lowering, pat: CodePattern, t: Int) -> Option<Lowering> / {abort.raise} =
  match pat {
    PxWild -> Some(lowering),
    PxVar(v) -> match v.slot {
      Some(slot) -> Some(bind(lowering, slot, t)),
      None -> Some(lowering),
    },
    PxRecord(r) ->
      r.fields.fold(Some(lowering), |acc: Option<Lowering>, f: CodePatternField|
        match acc {
          None -> None,
          Some(lw) -> {
            let read = field(lw.terms, t, String::of_bytes_lossy(f.name));
            destructured(with_terms(lw, read.terms), f.pat, read.id)
          },
        }),
    _ -> None,
  }

fn bind_opaque(lowering: Lowering, pat: CodePattern) -> Lowering / {abort.raise} =
  pattern_slots(pat).fold(lowering, |acc: Lowering, slot: Int| {
    let t = sym(acc.terms, None);
    bind(with_terms(acc, t.terms), slot, t.id)
  })

/// Each slot a pattern binds, in the order the Rust walk's stack visits them.
fn pattern_slots(p: CodePattern) -> List<Int> / {abort.raise} =
  iterate({ stack: [p], out: [] }, 1000000, |s: { stack: List<CodePattern>, out: List<Int> }|
    match s.stack.at(s.stack.len() - 1) {
      None -> Stop(s),
      Some(top) -> {
        let rest = s.stack.take(s.stack.len() - 1);
        Continue(match top {
          PxVar(v) ->
            { stack: rest, out: match v.slot { Some(slot) -> s.out.push(slot), None -> s.out } },
          PxCtor(c) ->
            {
              stack: c.args.fold(rest, |acc: List<CodePattern>, a: CodePattern| acc.push(a)),
              out: s.out,
            },
          PxRecord(r) ->
            {
              stack: r.fields.fold(rest, |acc: List<CodePattern>, f: CodePatternField|
                acc.push(f.pat)),
              out: s.out,
            },
          PxList(l) -> {
            let items = l.items.fold(rest, |acc: List<CodePattern>, a: CodePattern| acc.push(a));
            { stack: match l.rest { Some(r) -> items.push(r), None -> items }, out: s.out }
          },
          _ -> { stack: rest, out: s.out },
        })
      },
    }).out

fn match_expr(
  lowering: Lowering,
  context: Context,
  scrutinee: Code,
  arms: List<CodeArm>,
  unfolds: Int,
) -> L / {abort.raise} = {
  let s = lower(lowering, context, scrutinee, unfolds);
  let s_sort = sort_of(s.lowering.terms, s.id);
  match taken_in_view(s.lowering, context, s.id, arms) {
    Some(arm) -> {
      let entered = match arm.pat {
        PxRecord(_) -> match destructured(s.lowering, arm.pat, s.id) {
          Some(bound) -> bound,
          None -> s.lowering,
        },
        PxCtor(c) -> match node(s.lowering.terms, s.id) {
          TCtor(k) ->
            range(0, c.args.len()).fold(s.lowering, |acc: Lowering, i: Int|
              match ((c.args.at(i), k.args.at(i))) {
                (Some(PxVar(v)), Some(field)) -> match v.slot {
                  Some(slot) -> bind(acc, slot, field),
                  None -> acc,
                },
                _ -> acc,
              }),
          _ -> s.lowering,
        },
        _ -> match arm_shape(s.lowering, context, arm.pat, s.id, s_sort) {
          Some(shaped) -> shaped.lowering,
          None -> s.lowering,
        },
      };
      lower(entered, context, arm.body, unfolds)
    },
    None -> arms_of(s, s_sort, context, arms, unfolds),
  }
}

/// The arm a scrutinee in view takes, decided as the solver decides it: the first whose pattern the
/// value fits, after arms it plainly does not; none where an arm before it has a guard, or a pattern
/// the value's shape does not settle.
fn taken_in_view(
  lowering: Lowering,
  context: Context,
  scrutinee: Int,
  arms: List<CodeArm>,
) -> Option<CodeArm> / {abort.raise} = {
  let found = arms.fold(
    { arm: None, open: false },
    |acc: { arm: Option<CodeArm>, open: Bool }, a: CodeArm|
      if acc.open || acc.arm != None { acc } else {
        match a.guard {
          Some(_) -> { arm: None, open: true },
          None -> match fits(lowering, context, a.pat, scrutinee) {
            Some(true) -> { arm: Some(a), open: false },
            Some(false) -> acc,
            None -> { arm: None, open: true },
          },
        }
      },
  );
  found.arm
}

/// Whether a value in view fits a pattern of one level: `None` when its shape does not say.
fn fits(
  lowering: Lowering,
  context: Context,
  p: CodePattern,
  t: Int,
) -> Option<Bool> / {abort.raise} =
  match p {
    PxWild -> Some(true),
    PxVar(_) -> Some(true),
    PxLit(l) -> if !is_literal(lowering.terms, t) || !identity_literal(l) { None }
    else { Some(literal(lowering, l).id == t) },
    PxRange(_) -> None,
    PxCtor(c) -> match node(lowering.terms, t) {
      TCtor(k) -> if k.name != String::of_bytes_lossy(c.name) { Some(false) }
      else if k.args.len() == c.args.len()
          && c.args.fold(true, |ok: Bool, a: CodePattern| ok && irrefutable(a)) { Some(true) }
      else { None },
      _ -> None,
    },
    PxList(l) -> if !l.items.fold(true, |ok: Bool, a: CodePattern| ok && irrefutable(a))
        || !(match l.rest { Some(r) -> irrefutable(r), None -> true }) { None } else {
      let s = spine(lowering.terms, t);
      let ended = match node(lowering.terms, s.end) { TNil -> true, _ -> false };
      if s.heads.len() < l.items.len() { if ended { Some(false) } else { None } }
      else if l.rest != None { Some(true) }
      else if s.heads.len() > l.items.len() { Some(false) }
      else if ended { Some(true) }
      else { None }
    },
    PxRecord(_) -> if irrefutable(p) { Some(true) } else { None },
  }

fn identity_literal(l: Lit) -> Bool = match l { LFloat(_) -> false, LDec(_) -> false, _ -> true }

fn is_literal(terms: Terms, t: Int) -> Bool / {abort.raise} =
  match node(terms, t) {
    TInt(_) -> true,
    TBool(_) -> true,
    TStr(_) -> true,
    TDecimal(_) -> true,
    TFloat(_) -> true,
    TFixed(_, _, _) -> true,
    TUnit -> true,
    _ -> false,
  }

fn arms_of(
  s: L,
  s_sort: Option<Ty>,
  context: Context,
  arms: List<CodeArm>,
  unfolds: Int,
) -> L / {abort.raise} = {
  let walked = arms.fold(
    { lowering: s.lowering, arms: [], sort: None },
    |acc: { lowering: Lowering, arms: List<Arm>, sort: Option<Ty> }, a: CodeArm| {
      // What a guard admits is not modelled, so a guarded arm is never known to be taken.
      let shaped = match a.guard {
        Some(_) -> None,
        None -> arm_shape(acc.lowering, context, a.pat, s.id, s_sort),
      };
      let tested = match shaped {
        Some(sh) -> sh,
        None ->
          {
            lowering: bind_opaque(blocked(acc.lowering, UndecidableMatchArm), a.pat),
            test: Undecidable,
            binds: [],
          },
      };
      let guarded = match a.guard {
        Some(g) -> lower(tested.lowering, context, g, unfolds).lowering,
        None -> tested.lowering,
      };
      // What an arm's body owes is owed only where the arm runs: at `[]` or off it, at the
      // constructor its pattern names, or at the literal.
      let taken = match tested.test {
        TestList(t) -> {
          let empty = nil(guarded.terms, s_sort);
          let at_nil = eq(empty.terms, s.id, empty.id);
          if t.fixed == 0 && !t.rest { Some(on(guarded, at_nil)) }
          else { Some(on(guarded, not(at_nil.terms, at_nil.id))) }
        },
        TestCtor(name) -> {
          let at = match ctor(context, name) {
            Some(c) -> surer(s_sort, ctor_result_sort(c, tested.binds, guarded.terms)),
            None -> s_sort,
          };
          let built = mk(guarded.terms, TCtor({ name: name, args: tested.binds }), at);
          Some(on(guarded, eq(built.terms, s.id, built.id)))
        },
        TestLit(literal) -> Some(on(guarded, eq(guarded.terms, s.id, literal))),
        _ -> None,
      };
      let entered = match taken { Some(c) -> assume(c.lowering, c.id), None -> guarded };
      let body = lower(entered, context, a.body, unfolds);
      let left = match taken { Some(_) -> popped(body.lowering), None -> body.lowering };
      let sort = surer(acc.sort, sort_of(left.terms, body.id));
      {
        lowering: left,
        arms: acc.arms.push({ test: tested.test, binds: tested.binds, body: body.id }),
        sort: sort,
      }
    },
  );
  on(
    walked.lowering,
    mk(walked.lowering.terms, TMatch({ scrutinee: s.id, arms: walked.arms }), walked.sort),
  )
}

fn arm_shape(
  lowering: Lowering,
  context: Context,
  pat: CodePattern,
  scrutinee: Int,
  s_sort: Option<Ty>,
) -> Option<{ lowering: Lowering, test: ArmTest, binds: List<Int> }> / {abort.raise} =
  match pat {
    PxWild -> Some({ lowering: lowering, test: Always, binds: [] }),
    PxVar(v) ->
      Some({
        lowering: match v.slot { Some(slot) -> bind(lowering, slot, scrutinee), None -> lowering },
        test: Always,
        binds: [],
      }),
    // A `Float` or `Decimal` pattern matches by `==`, which is no test of identity.
    PxLit(l) -> if !identity_literal(l) { None } else {
      let t = literal(lowering, l);
      Some({ lowering: t.lowering, test: TestLit(t.id), binds: [] })
    },
    PxRange(_) -> None,
    PxCtor(c) -> match ctor(context, String::of_bytes_lossy(c.name)) {
      None -> None,
      Some(k) -> if arity(k) != c.args.len()
          || !c.args.fold(true, |ok: Bool, a: CodePattern| ok && irrefutable(a)) { None } else {
        let sorts = field_sorts(k, s_sort);
        let bound = range(0, c.args.len()).fold(
          { lowering: lowering, binds: [] },
          |acc: { lowering: Lowering, binds: List<Int> }, i: Int| {
            let f = sym(acc.lowering.terms, match sorts.at(i) { Some(s) -> s, None -> None });
            let lw2 = with_terms(acc.lowering, f.terms);
            let lw3 = match c.args.at(i) {
              Some(PxVar(v)) -> match v.slot { Some(slot) -> bind(lw2, slot, f.id), None -> lw2 },
              _ -> lw2,
            };
            { lowering: lw3, binds: acc.binds.push(f.id) }
          },
        );
        Some({
          lowering: bound.lowering,
          test: TestCtor(String::of_bytes_lossy(c.name)),
          binds: bound.binds,
        })
      },
    },
    PxList(l) -> {
      let simple = l.items.fold(true, |ok: Bool, a: CodePattern| ok && irrefutable(a))
        && (match l.rest { Some(r) -> irrefutable(r), None -> true });
      if !simple { None } else {
        let elem = match s_sort { Some(s) -> list_elem(s), None -> None };
        // A spine in view binds its own heads and tail, so a call over the tail is the same term
        // wherever the tail is named; a symbol gets fresh fields.
        let heads = l.items.fold(
          { lowering: lowering, at: Some(scrutinee), binds: [] },
          |acc: { lowering: Lowering, at: Option<Int>, binds: List<Int> }, item: CodePattern| {
            let stepped = match acc.at {
              Some(t) -> match node(acc.lowering.terms, t) {
                TCons(c) -> { lowering: acc.lowering, at: Some(c.tail), field: c.head },
                _ -> {
                  let f = sym(acc.lowering.terms, elem);
                  { lowering: with_terms(acc.lowering, f.terms), at: None, field: f.id }
                },
              },
              None -> {
                let f = sym(acc.lowering.terms, elem);
                { lowering: with_terms(acc.lowering, f.terms), at: None, field: f.id }
              },
            };
            let lw2 = match item {
              PxVar(v) -> match v.slot {
                Some(slot) -> bind(stepped.lowering, slot, stepped.field),
                None -> stepped.lowering,
              },
              _ -> stepped.lowering,
            };
            { lowering: lw2, at: stepped.at, binds: acc.binds.push(stepped.field) }
          },
        );
        let finished = match l.rest {
          None -> { lowering: heads.lowering, binds: heads.binds },
          Some(r) -> {
            let tail = match heads.at {
              Some(t) -> { lowering: heads.lowering, id: t },
              None -> on(heads.lowering, sym(heads.lowering.terms, s_sort)),
            };
            let lw2 = if tail.id != scrutinee {
              {
                ..tail.lowering,
                smaller: tail.lowering.smaller.push({ tail: tail.id, from: scrutinee }),
              }
            } else { tail.lowering };
            let lw3 = match r {
              PxVar(v) -> match v.slot { Some(slot) -> bind(lw2, slot, tail.id), None -> lw2 },
              _ -> lw2,
            };
            { lowering: lw3, binds: heads.binds.push(tail.id) }
          },
        };
        Some({
          lowering: finished.lowering,
          test: TestList({ fixed: l.items.len(), rest: l.rest != None }),
          binds: finished.binds,
        })
      }
    },
    PxRecord(_) -> match destructured(lowering, pat, scrutinee) {
      Some(bound) -> Some({ lowering: bound, test: Always, binds: [] }),
      None -> None,
    },
  }

/// A constructor's fields, instantiated against the scrutinee's sort when it is known.
pub fn field_sorts(c: Ctor, sort: Option<Ty>) -> List<Option<Ty>> = {
  let args = match sort {
    Some(Con(name, xs)) -> if name == c.decl.name && xs.len() == c.decl.params { xs }
    else { range(0, c.decl.params).map(|p: Int| foreign(Var(p))) },
    _ -> range(0, c.decl.params).map(|p: Int| foreign(Var(p))),
  };
  c.variant.fields.map(|f: Ty| Some(substituted(f, args)))
}

fn ctor_result_sort(c: Ctor, args: List<Int>, terms: Terms) -> Option<Ty> = {
  let subst = range(0, c.variant.fields.len()).fold(Map::new(), |acc: Map<Int, Ty>, i: Int|
    match c.variant.fields.at(i) {
      Some(f) -> match args.at(i) {
        Some(a) -> match sort_of(terms, a) { Some(actual) -> matched(f, actual, acc), None -> acc },
        None -> acc,
      },
      None -> acc,
    });
  Some(
    Con(
      c.decl.name,
      range(0, c.decl.params).map(|p: Int|
        match subst.get(p) { Some(s) -> s, None -> foreign(Var(p)) }),
    ),
  )
}

/// The requirements recorded since `mark`.
pub fn requirements_since(lowering: Lowering, mark: Int) -> List<Int> =
  lowering.requirements.drop(mark)

pub fn requirements_between(lowering: Lowering, from: Int, to: Int) -> List<Int> =
  lowering.requirements.drop(from).take(to - from)
