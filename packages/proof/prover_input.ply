import compiler.front.diagnostics (parse_all)
import compiler.front.published (no_rows, analyse)
import compiler.front.facts (Analysis, claim_literals, literals_of, schema_definitions, Bounded,
                             bounds_of, guard_bounds)
import compiler.front.emitter_input (Analysed, Rejected)
import compiler.front (analyse_pulling_std_with)
import compiler.front.rows (module_imports)
import compiler.check.infer.checker (Builtin, ConstructorInfo, DefinitionInfo, LawBinder, LawInfo,
                                     SpecInfo, InstanceInfo, NumericInfo, EffectInfo, OperationInfo,
                                     builtins)
import compiler.syntax.items (Item, FunctionItem, TypeItem, LawItem, CostClause, EnsuresClause,
                              RequiresClause, SpaceClause, SpecClause, SpecKind, KeyInstance,
                              InvariantInstance)
import compiler.syntax.expressions (Expression, NameExpression, Param, expression_span,
                                    expression_nodes)
import compiler.store.hash.forms (HashOutput, NodeRef, ItemKeyed, references_in)
import compiler.store.hash.encoding (hex)
import std.hash (blake3)
import compiler.check.resolve.tables (Diagnostic, ParsedModule, error_at, qualify)
import compiler.syntax.parsing (Span, no_module)
import compiler.check.types (Effect, Field, Printer, Type, NamedType, FunctionType, RecordType,
                             VariableType, print_resource, print_effects, print_type,
                             printer_naming, printer_new, reserve_effects, is_pure,
                             is_pure_but_raise, run_needs, tuple_arity, type_letter, type_args,
                             without_raises, NominalType, is_diverges)
import compiler.syntax.type_syntax (WriteMode)
import domain (Cases, NamedSort, Declaration, Domain, Interval, FunctionSort, RecordSort, Scalar,
               Shape, Sort, SortVariable, Variant, finite_within, domain_name)
import obligation (Builds, Cost, Definition, Ensures, Frame, Kind, Law, NoWrites, Space, Writes,
                   WrittenLaw)
import std.list

pub type Signature = {
  name: String,
  ty: Sort,
  pure: Bool,
  effects_pure: Bool,
  raises: Bool,
  through: List<Int>,
}

pub type BuiltinSignature = { name: String, ty: Sort, pure: Bool }

pub type Binder = { name: String, ty: Sort, text: String, constructible: Bool }

pub type Strategy = | Interleave(Points) | Static(Fallback) | Bounded

pub type Fallback = | Unhandled(String) | Run(Points)

pub type Points = | Every(Domain, String) | NotEnumerable

pub type Obligation = {
  key: String,
  run_key: String,
  owner: String,
  kind: Kind,
  at: { module: Int, start: Int, end: Int },
  binders: List<Binder>,
  result: Option<Binder>,
  variables: List<String>,
  guards: List<{ module: Int, start: Int, end: Int }>,
  literals: List<Bytes>,
  effects: Option<String>,
  frame: Frame,
  strategy: Strategy,
  identities: List<Int>,
}

pub type Measure = {
  owner: String,
  at: { module: Int, start: Int, end: Int },
  binders: List<Binder>,
}

pub type ProverInput = {
  declarations: List<Declaration>,
  signatures: List<Signature>,
  builtins: List<BuiltinSignature>,
  obligations: List<Obligation>,
  measures: List<Measure>,
  keys: List<{ type_name: String, by: String }>,
  numerics: List<{ type_name: String, functions: List<String> }>,
  invariants: List<{ type_name: String, by: String }>,
  imports: List<List<Int>>,
  trusted_laws: List<TrustedLaw>,
  operations: List<Operation>,
}

pub type Operation = { effect: String, operation: String, results: Sort }

pub type TrustedLaw = {
  key: String,
  label: String,
  binders: List<Binder>,
  identities: List<Int>,
  module: Int,
}

pub type ProverInputResult = {
  world: ProverInput,
  definitions: List<Definition>,
  laws: List<WrittenLaw>,
  warnings: List<Diagnostic>,
}

pub fn prover_input_of(
  analysis: Analysis,
  owned: (Bytes) -> Bool,
) -> ProverInputResult / {abort.raise} = {
  let declarations = declarations_of(analysis.checked.constructors);
  let closing: OpaqueTypes = {
    closed: opaque_types_of(analysis.modules),
    constructors: analysis.checked.constructors,
    declarations: declarations,
  };
  let written = written_params(analysis.modules);
  let wheres = law_guards(analysis.modules);
  let requires = clauses_written(analysis.modules);
  let by_name = |xs: List<{ name: Bytes, hashes: List<Bytes> }>|
    xs.fold(
      Map::new(),
      |accumulator: Map<Bytes, List<Bytes>>, s: { name: Bytes, hashes: List<Bytes> }|
        accumulator.insert(s.name, s.hashes),
    );
  let keys = by_name(analysis.hashes.spec_checks);
  let runs = by_name(analysis.hashes.specs);
  let definitions = analysis.checked.definitions.filter(|d: DefinitionInfo| owned(d.module));
  let schemas = schema_definitions(analysis.modules);
  let laws = analysis.checked.laws.filter(|l: LawInfo| owned(l.module));
  let clauses = definitions.fold(
    { obligations: [], warnings: [] },
    |accumulator: CollectedObligations, d: DefinitionInfo|
      clauses_of(accumulator, d, written, requires, keys, runs, closing),
  );
  let stating = invariants_of(analysis.checked.instances);
  let values = if stating.len() == 0 { Map::new() } else { values_named(analysis.modules) };
  let built = definitions.fold(clauses, |accumulator: CollectedObligations, d: DefinitionInfo|
    builds_of(accumulator, d, written, stating, values, analysis.hashes, closing));
  let collected = laws.fold(built, |accumulator: CollectedObligations, l: LawInfo|
    law_of(accumulator, l, analysis.hashes.laws, wheres, closing));
  let imports = imports_of(analysis.modules);
  let trusted = analysis.checked.laws.filter(|l: LawInfo|
    !owned(l.module) && !l.has_guard && analysis.hashes.law_texts.contains(l.key));
  let imported_law_hashes = |o: Obligation|
    match o.kind {
      Cost(_) -> [],
      Space(_) -> [],
      _ -> match imports.at(o.at.module) {
        Some(reach) ->
          trusted.filter(|l: LawInfo| reach.contains(l.at.module)).fold(
            [],
            |accumulator: List<Bytes>, l: LawInfo|
              match analysis.hashes.laws.get(l.key) {
                Some(h) -> accumulator.push(h),
                None -> accumulator,
              },
          ),
        None -> [],
      },
    };
  {
    world: {
      declarations: declarations,
      signatures: analysis.checked.definitions.map(signature_of),
      builtins: builtin_signatures,
      obligations: collected.obligations.map(|o: Obligation|
        with_imported_laws(o, imported_law_hashes(o))),
      measures: measures_in(analysis, owned),
      keys: keys_of(analysis.checked.instances),
      numerics: numerics_of(analysis.checked.numeric_types),
      invariants: stating.map(|i: { type_name: Bytes, by: Bytes }|
        { type_name: String::of_bytes_lossy(i.type_name), by: String::of_bytes_lossy(i.by) }),
      imports: imports,
      trusted_laws: trusted.map(|l: LawInfo| trusted_law_from(l, closing)),
      operations: operations_of(analysis.checked.effects),
    },
    definitions: defined(
      definitions.filter(|d: DefinitionInfo| !schemas.contains(d.name)),
      analysis.hashes,
    ),
    laws: sentences_of(laws, analysis.hashes),
    warnings: collected.warnings,
  }
}

fn defined(ds: List<DefinitionInfo>, h: HashOutput) -> List<Definition> / {abort.raise} = {
  let hashed = h.definitions.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
      accumulator.insert(x.name, x.hash),
  );
  let clauses = h.spec_texts.fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
      accumulator.insert(x.name, x.hashes),
  );
  ds.map(|d: DefinitionInfo|
    {
      name: String::of_bytes_lossy(d.name),
      hash: match hashed.get(d.name) {
        Some(x) -> Some(String::of_bytes_lossy(hex(x))),
        None -> None,
      },
      specs: match clauses.get(d.name) { Some(xs) -> xs.map(hashed_text), None -> [] },
    })
}

fn hashed_text(b: Bytes) -> String / {abort.raise} = String::of_bytes_lossy(hex(b))

fn sentences_of(ls: List<LawInfo>, h: HashOutput) -> List<WrittenLaw> / {abort.raise} =
  ls.fold([], |accumulator: List<WrittenLaw>, l: LawInfo|
    match h.laws.get(l.key) {
      None -> accumulator,
      Some(hash) ->
        accumulator.push({
          key: String::of_bytes_lossy(l.key),
          text: hashed_text(match h.law_texts.get(l.key) { Some(t) -> t, None -> hash }),
          mentions: references_in(h, ItemKeyed(l.key)).fold(
            [],
            |ns: List<Bytes>, r: NodeRef| ns.push_unique(r.name),
          ).map(
            String::of_bytes_lossy,
          ),
        }),
    })

type OpaqueTypes = {
  closed: List<{ ty: Bytes, home: Bytes }>,
  constructors: List<ConstructorInfo>,
  declarations: List<Declaration>,
}

const no_opaque_types: OpaqueTypes = { closed: [], constructors: [], declarations: [] }

fn opaque_types_of(modules: List<ParsedModule>) -> List<{ ty: Bytes, home: Bytes }> =
  modules.fold([], |accumulator: List<{ ty: Bytes, home: Bytes }>, m: ParsedModule|
    m.module.items.fold(accumulator, |a: List<{ ty: Bytes, home: Bytes }>, item: Item|
      match item {
        TypeItem(t) -> if t.opaque == None { a }
        else { a.push({ ty: qualify(m.name, t.name.name), home: m.name }) },
        _ -> a,
      }))

fn makes_opaque_value(
  t: Type,
  d: OpaqueTypes,
  module: Bytes,
  seen: List<Bytes>,
  room: Int,
) -> Bool = {
  let any = |ts: List<Type>|
    ts.fold(false, |hit: Bool, x: Type| hit || makes_opaque_value(x, d, module, seen, room));
  let is_opaque_name = |name: Bytes|
    d.closed.fold(false, |hit: Bool, c: { ty: Bytes, home: Bytes }|
      hit || (c.ty == name && c.home != module));
  match t {
    VariableType(_) -> false,
    FunctionType(f) -> any(f.params) || makes_opaque_value(f.return_type, d, module, seen, room),
    RecordType(fs) -> any(fs.map(|f: Field| f.ty)),
    NominalType(n) ->
      any(type_args(n.args)) || is_opaque_name(n.name) || any(n.fields.map(|f: Field| f.ty)),
    NamedType(c) -> if any(type_args(c.args)) || is_opaque_name(c.name) { true }
    else if room <= 0 || seen.contains(c.name) { false } else {
      d.constructors.fold(false, |hit: Bool, k: ConstructorInfo|
        hit
          || (k.type_name == c.name
          && k.fields.fold(false, |inner: Bool, f: Type|
            inner || makes_opaque_value(f, d, module, seen.push(c.name), room - 1))))
    },
  }
}

fn points_of(binders: List<Binder>, bounds: List<Bounded>, d: OpaqueTypes) -> Points =
  if binders.fold(false, |any: Bool, b: Binder| any || !b.constructible) { NotEnumerable } else {
    let within = |b: Binder|
      bounds.fold(None, |found: Option<Interval>, h: Bounded|
        if String::of_bytes_lossy(h.name) == b.name && is_int(b.ty) {
          Some({ low: h.low, high: h.high })
        } else { found });
    match finite_within(binders.map(|b: Binder| { ty: b.ty, within: within(b) }), d.declarations) {
      Some(domain) ->
        Every(
          domain,
          domain_name(
            binders.map(|b: Binder|
              match within(b) {
                Some(ends) ->
                  b.text ++ " " ++ ends.low.to_string() ++ "..=" ++ ends.high.to_string(),
                None -> b.text,
              }),
          ),
        ),
      None -> NotEnumerable,
    }
  }

fn is_int(ty: Sort) -> Bool =
  match ty { NamedSort(name, args) -> name == "Int" && args.len() == 0, _ -> false }

fn clause_strategy(
  performs: Option<String>,
  binders: List<Binder>,
  bounds: List<Bounded>,
  d: OpaqueTypes,
) -> Strategy =
  match performs {
    Some(row) -> Static(Unhandled(row)),
    None -> Static(Run(points_of(binders, bounds, d))),
  }

pub fn fallback_of(s: Strategy) -> Option<Fallback> = match s { Static(u) -> Some(u), _ -> None }

fn law_strategy(
  effects: Option<String>,
  binders: List<Binder>,
  bounds: List<Bounded>,
  d: OpaqueTypes,
) -> Strategy =
  match effects {
    Some(_) -> Interleave(points_of(binders, bounds, d)),
    None -> Static(Run(points_of(binders, bounds, d))),
  }

fn in_print_order(fs: List<Field>) -> List<Field> =
  match tuple_arity(fs) {
    None -> fs,
    Some(n) ->
      range(0, n).fold([], |accumulator: List<Field>, i: Int| {
        let name = b"_".concat(Bytes::of_string(i.to_string()));
        fs.fold(accumulator, |found: List<Field>, f: Field|
          if f.name == name { found.push(f) } else { found })
      }),
  }

fn met(t: Type, seen: List<Int>) -> List<Int> =
  match t {
    VariableType(v) -> if seen.contains(v) { seen } else { seen.push(v) },
    NamedType(c) ->
      type_args(c.args).fold(seen, |accumulator: List<Int>, a: Type| met(a, accumulator)),
    FunctionType(f) ->
      met(
        f.return_type,
        f.params.fold(seen, |accumulator: List<Int>, p: Type| met(p, accumulator)),
      ),
    RecordType(fs) ->
      in_print_order(fs).fold(seen, |accumulator: List<Int>, f: Field| met(f.ty, accumulator)),
    NominalType(n) ->
      type_args(n.args).fold(seen, |accumulator: List<Int>, a: Type| met(a, accumulator)),
  }

fn number_of(variables: List<Int>, v: Int) -> Int / {abort.raise} =
  range(0, variables.len()).fold(variables.len(), |found: Int, i: Int|
    if found < variables.len() { found } else if variables.get(i) == v { i } else { found })

fn type_of(t: Type, variables: List<Int>) -> Sort / {abort.raise} =
  match t {
    VariableType(v) -> SortVariable(number_of(variables, v)),
    NamedType(c) ->
      NamedSort(
        String::of_bytes_lossy(c.name),
        type_args(c.args).map(|a: Type| type_of(a, variables)),
      ),
    FunctionType(f) ->
      FunctionSort(
        f.params.map(|p: Type| type_of(p, variables)),
        type_of(f.return_type, variables),
        is_pure(f.effects),
      ),
    RecordType(fs) -> record_of(fs, variables),
    NominalType(n) -> record_of(n.fields, variables),
  }

fn record_of(fs: List<Field>, variables: List<Int>) -> Sort / {abort.raise} =
  RecordSort(
    fs.map(|f: Field| { name: String::of_bytes_lossy(f.name), ty: type_of(f.ty, variables) }),
  )

fn numbered(variables: List<Int>) -> Printer / {abort.raise} =
  range(0, variables.len()).fold(printer_new, |p: Printer, i: Int|
    printer_naming(p, variables.get(i), type_letter(i)))

type Named = { name: Bytes, ty: Type }

type PrintedBinders = { binders: List<Binder>, variables: List<String> }

fn binders_of(named: List<Named>, d: OpaqueTypes, module: Bytes) -> PrintedBinders / {abort.raise} = {
  let type_variables = named.fold([], |accumulator: List<Int>, b: Named| met(b.ty, accumulator));
  let printed = named.fold(
    { p: numbered(type_variables), out: [] },
    |accumulator: { p: Printer, out: List<Binder> }, b: Named| {
      let o = print_type(accumulator.p, b.ty);
      {
        p: o.printer,
        out: accumulator.out.push({
          name: String::of_bytes_lossy(b.name),
          ty: type_of(b.ty, type_variables),
          text: String::of_bytes_lossy(o.text),
          constructible: d.closed.len() == 0
            || !makes_opaque_value(b.ty, d, module, [], d.constructors.len()),
        }),
      }
    },
  );
  {
    binders: printed.out,
    variables: range(0, type_variables.len()).map(|i: Int| String::of_bytes_lossy(type_letter(i))),
  }
}

fn signature_of(d: DefinitionInfo) -> Signature / {abort.raise} =
  {
    name: String::of_bytes_lossy(d.name),
    ty: type_of(d.scheme.ty, met(d.scheme.ty, [])),
    pure: without_raises(d.effects).len() == 0,
    effects_pure: only_raises(d.scheme.ty),
    raises: d.effects.len() > without_raises(d.effects).len()
      || d.effects.any(|entry: Effect| is_diverges(entry)),
    through: effect_parameters_of(d.scheme.ty),
  }

fn effect_parameters_of(t: Type) -> List<Int> =
  match t {
    FunctionType(f) -> match f.effects.variable {
      Some(v) -> if without_raises(f.effects.listed).len() > 0
          || mentions_effect_variable(f.return_type, v) { [] } else {
        let direct = range(0, f.params.len()).filter(|i: Int|
          match f.params.at(i) {
            Some(FunctionType(g)) ->
              g.effects.variable == Some(v)
                && !g.params.any(|p: Type| mentions_effect_variable(p, v))
                && !mentions_effect_variable(g.return_type, v),
            _ -> false,
          });
        let elsewhere = range(0, f.params.len()).any(|i: Int|
          !direct.contains(i)
            && (match f.params.at(i) { Some(p) -> mentions_effect_variable(p, v), None -> false }));
        if elsewhere || direct.len() == 0 { [] } else { direct }
      },
      None -> [],
    },
    _ -> [],
  }

fn mentions_effect_variable(t: Type, v: Int) -> Bool =
  match t {
    VariableType(_) -> false,
    NamedType(c) -> type_args(c.args).any(|a: Type| mentions_effect_variable(a, v)),
    FunctionType(f) ->
      f.effects.variable == Some(v) || f.params.any(|p: Type| mentions_effect_variable(p, v))
        || mentions_effect_variable(f.return_type, v),
    RecordType(fs) -> fs.any(|x: Field| mentions_effect_variable(x.ty, v)),
    NominalType(n) ->
      n.fields.any(|x: Field| mentions_effect_variable(x.ty, v))
        || type_args(n.args).any(|a: Type| mentions_effect_variable(a, v)),
  }

fn params_of(k: ConstructorInfo) -> List<Int> = {
  let result = match k.scheme.ty { FunctionType(f) -> f.return_type, other -> other };
  match result {
    NamedType(c) -> type_args(c.args).map(|a: Type| match a { VariableType(v) -> v, _ -> 0 - 1 }),
    _ -> [],
  }
}

fn variant_of(k: ConstructorInfo) -> Variant / {abort.raise} =
  { name: String::of_bytes_lossy(k.name), fields: k.fields.map(|f: Type| type_of(f, params_of(k))) }

fn by_index(ks: List<ConstructorInfo>) -> List<ConstructorInfo> =
  ks.fold([], |accumulator: List<ConstructorInfo>, k: ConstructorInfo| {
    let before = accumulator.filter(|x: ConstructorInfo| x.index <= k.index);
    accumulator.filter(|x: ConstructorInfo| x.index > k.index).fold(
      before.push(k),
      |out: List<ConstructorInfo>, x: ConstructorInfo| out.push(x),
    )
  })

fn declarations_of(constructors: List<ConstructorInfo>) -> List<Declaration> / {abort.raise} = {
  let grouped = constructors.fold(
    { names: [], by: Map::new() },
    |accumulator: { names: List<Bytes>, by: Map<Bytes, List<ConstructorInfo>> }, k: ConstructorInfo|
      match accumulator.by.get(k.type_name) {
        Some(ks) -> { ..accumulator, by: accumulator.by.insert(k.type_name, ks.push(k)) },
        None ->
          {
            names: accumulator.names.push(k.type_name),
            by: accumulator.by.insert(k.type_name, [k]),
          },
      },
  );
  grouped.names.map(|name: Bytes| {
    let own = by_index(match grouped.by.get(name) { Some(ks) -> ks, None -> [] });
    {
      name: String::of_bytes_lossy(name),
      params: match own.at(0) { Some(k) -> params_of(k).len(), None -> 0 },
      variants: own.map(variant_of),
    }
  })
}

type CollectedObligations = { obligations: List<Obligation>, warnings: List<Diagnostic> }

fn at_of(module: Int, s: Span) -> { module: Int, start: Int, end: Int } =
  {
    module: if s.start == 0 && s.end == 0 { no_module } else { module },
    start: s.start,
    end: s.end,
  }

fn written_params(modules: List<ParsedModule>) -> Map<Bytes, List<Bytes>> =
  modules.fold(Map::new(), |accumulator: Map<Bytes, List<Bytes>>, m: ParsedModule|
    m.module.items.fold(accumulator, |a: Map<Bytes, List<Bytes>>, it: Item|
      match it {
        FunctionItem(d) ->
          a.insert(qualify(m.name, d.name.name), d.params.map(|p: Param| p.name.name)),
        _ -> a,
      }))

fn clauses_written(modules: List<ParsedModule>) -> Map<Bytes, Clauses> =
  modules.fold(Map::new(), |accumulator: Map<Bytes, Clauses>, m: ParsedModule|
    m.module.items.fold(accumulator, |a: Map<Bytes, Clauses>, it: Item|
      match it {
        FunctionItem(d) -> {
          let of = |kind: SpecKind|
            d.spec.filter(|c: SpecClause| c.kind == kind).map(|c: SpecClause| c.expression);
          a.insert(qualify(m.name, d.name.name), {
            requires: of(RequiresClause),
            ensures: of(EnsuresClause),
          })
        },
        _ -> a,
      }))

type Clauses = { requires: List<Expression>, ensures: List<Expression> }

type LawGuardSummary = { guard: Option<Span>, literals: List<Bytes>, bounds: List<Bounded> }

fn law_guards(modules: List<ParsedModule>) -> Map<Bytes, LawGuardSummary> / {abort.raise} =
  modules.fold(Map::new(), |accumulator: Map<Bytes, LawGuardSummary>, m: ParsedModule|
    m.module.items.fold(accumulator, |a: Map<Bytes, LawGuardSummary>, it: Item|
      match it {
        LawItem(d) ->
          a.insert(qualify(m.name, d.name), {
            guard: match d.guard { Some(g) -> Some(expression_span(g)), None -> None },
            literals: claim_literals(modules, d),
            bounds: guard_bounds(modules, d),
          }),
        _ -> a,
      }))

fn frame_of(effects: List<Effect>) -> Frame / {abort.raise} = {
  let writes = effects.filter(|a: Effect| match a.mode { WriteMode -> true, _ -> false });
  if writes.len() == 0 { NoWrites } else {
    let named = writes.fold(
      { p: reserve_effects(printer_new, writes), texts: [] },
      |accumulator: { p: Printer, texts: List<String> }, a: Effect| {
        let r = print_resource(accumulator.p, a.resource);
        let written = String::of_bytes_lossy(a.effect.concat(r.text));
        {
          p: r.printer,
          texts: if accumulator.texts.fold(false, |seen: Bool, x: String| seen || x == written) {
            accumulator.texts
          } else { accumulator.texts.push(written) },
        }
      },
    );
    Writes(named.texts)
  }
}

fn effects_text(effects: List<Effect>) -> Option<String> / {abort.raise} =
  if effects.len() == 0 { None } else {
    Some(
      String::of_bytes_lossy(
        print_effects(reserve_effects(printer_new, effects), {
          listed: effects,
          variable: None,
        }).text,
      ),
    )
  }

fn unhashed(name: Bytes, module: Int, s: Span) -> Diagnostic = {
  let d: Diagnostic = error_at(
    b"W0602",
    module,
    s,
    Bytes::concat_all([b"no cache key was computed for `", name, b"`"]),
    b"this claim was not checked",
    [b"the claim is not known to hold"],
  );
  { ..d, severity: b"warning" }
}

fn clauses_of(
  accumulator: CollectedObligations,
  d: DefinitionInfo,
  written: Map<Bytes, List<Bytes>>,
  clauses: Map<Bytes, Clauses>,
  keys: Map<Bytes, List<Bytes>>,
  runs: Map<Bytes, List<Bytes>>,
  closing: OpaqueTypes,
) -> CollectedObligations / {abort.raise} = {
  let claimed = d.spec.filter(|s: SpecInfo| s.kind != RequiresClause);
  if claimed.len() == 0 { accumulator } else {
    let shape = match d.scheme.ty {
      FunctionType(f) -> { params: f.params, result_type: f.return_type },
      other -> { params: [], result_type: other },
    };
    let names = match written.get(d.name) { Some(ns) -> ns, None -> [] };
    let params = range(0, min(names.len(), shape.params.len())).map(|i: Int|
      { name: names.get(i), ty: shape.params.get(i) });
    let printed = binders_of(
      params.push({ name: b"result", ty: shape.result_type }),
      closing,
      d.module,
    );
    let binders = range(0, params.len()).map(|i: Int| printed.binders.get(i));
    let result = printed.binders.at(params.len());
    let stated = match clauses.get(d.name) { Some(c) -> c, None -> { requires: [], ensures: [] } };
    let propositions = stated.requires;
    let guards = propositions.map(|g: Expression| at_of(d.at.module, expression_span(g)));
    let frame = frame_of(d.effects);
    let strategy = clause_strategy(
      effects_text(run_needs(d.effects)),
      binders,
      bounds_of(propositions),
      closing,
    );
    let hashed = match keys.get(d.name) { Some(hs) -> hs, None -> [] };
    let ran = match runs.get(d.name) { Some(hs) -> hs, None -> [] };
    claimed.fold(
      { owed: accumulator, ensures: 0, costs: 0, spaces: 0 },
      |st: { owed: CollectedObligations, ensures: Int, costs: Int, spaces: Int }, clause: SpecInfo| {
        let bound = clause.kind != EnsuresClause;
        let next = match clause.kind {
          CostClause -> { ..st, costs: st.costs + 1 },
          SpaceClause -> { ..st, spaces: st.spaces + 1 },
          _ -> { ..st, ensures: st.ensures + 1 },
        };
        match hashed.at(clause.index) {
          None ->
            {
              ..next,
              owed: {
                ..st.owed,
                warnings: st.owed.warnings.push(unhashed(d.name, d.at.module, clause.span)),
              },
            },
          Some(key) ->
            {
              ..next,
              owed: {
                ..st.owed,
                obligations: st.owed.obligations.push({
                  key: String::of_bytes_lossy(hex(key)),
                  run_key: String::of_bytes_lossy(
                    hex(match ran.at(clause.index) { Some(r) -> r, None -> key }),
                  ),
                  owner: String::of_bytes_lossy(d.name),
                  kind: match clause.kind {
                    CostClause -> Cost(st.costs),
                    SpaceClause -> Space(st.spaces),
                    _ -> Ensures(st.ensures),
                  },
                  at: at_of(d.at.module, clause.span),
                  binders: binders,
                  result: if bound { None } else { result },
                  variables: printed.variables,
                  guards: if bound { [] } else { guards },
                  literals: if bound { [] } else {
                    literals_of(match stated.ensures.at(st.ensures) {
                      Some(e) -> propositions.push(e),
                      None -> propositions,
                    })
                  },
                  effects: effects_text(clause.effects),
                  frame: frame,
                  strategy: if bound { Bounded } else { strategy },
                  identities: [],
                }),
              },
            },
        }
      },
    ).owed
  }
}

fn law_of(
  accumulator: CollectedObligations,
  l: LawInfo,
  hashes: Map<Bytes, Bytes>,
  wheres: Map<Bytes, LawGuardSummary>,
  closing: OpaqueTypes,
) -> CollectedObligations / {abort.raise} =
  match hashes.get(l.key) {
    None ->
      {
        ..accumulator,
        warnings: accumulator.warnings.push(unhashed(l.key, l.at.module, l.at.span)),
      },
    Some(key) -> {
      let printed = binders_of(
        l.binders.map(|b: LawBinder| { name: b.name, ty: b.ty }),
        closing,
        l.module,
      );
      let type_variables = l.binders.fold([], |accumulator: List<Int>, b: LawBinder|
        met(b.ty, accumulator));
      let effects = effects_text(l.effects);
      {
        ..accumulator,
        obligations: accumulator.obligations.push({
          key: String::of_bytes_lossy(hex(key)),
          run_key: String::of_bytes_lossy(hex(key)),
          owner: String::of_bytes_lossy(l.key),
          kind: Law(Some(String::of_bytes_lossy(l.name))),
          at: at_of(l.at.module, l.at.span),
          binders: printed.binders,
          result: None,
          variables: printed.variables,
          guards: match wheres.get(l.key) {
            Some(s) -> match s.guard { Some(g) -> [at_of(l.at.module, g)], None -> [] },
            None -> [],
          },
          literals: match wheres.get(l.key) { Some(s) -> s.literals, None -> [] },
          effects: effects,
          frame: NoWrites,
          strategy: law_strategy(
            effects,
            printed.binders,
            match wheres.get(l.key) { Some(s) -> s.bounds, None -> [] },
            closing,
          ),
          identities: l.identities.map(|v: Int| number_of(type_variables, v)),
        }),
      }
    },
  }

pub fn measures_input(analysis: Analysis, measures: List<Measure>) -> ProverInput / {abort.raise} =
  {
    declarations: declarations_of(analysis.checked.constructors),
    signatures: analysis.checked.definitions.map(signature_of),
    builtins: builtin_signatures,
    obligations: [],
    measures: measures,
    keys: keys_of(analysis.checked.instances),
    numerics: numerics_of(analysis.checked.numeric_types),
    invariants: invariants_of(analysis.checked.instances).map(
      |i: { type_name: Bytes, by: Bytes }|
        { type_name: String::of_bytes_lossy(i.type_name), by: String::of_bytes_lossy(i.by) },
    ),
    imports: imports_of(analysis.modules),
    trusted_laws: [],
    operations: operations_of(analysis.checked.effects),
  }

fn with_imported_laws(o: Obligation, hashes: List<Bytes>) -> Obligation / {abort.raise} =
  if hashes.len() == 0 { o } else {
    {
      ..o,
      key: String::of_bytes_lossy(
        hex(blake3(Bytes::concat_all([Bytes::of_string(o.key)].concat(hashes)))),
      ),
    }
  }

fn trusted_law_from(l: LawInfo, closing: OpaqueTypes) -> TrustedLaw / {abort.raise} =
  {
    key: String::of_bytes_lossy(l.key),
    label: String::of_bytes_lossy(l.name),
    binders: binders_of(
      l.binders.map(|b: LawBinder| { name: b.name, ty: b.ty }),
      closing,
      l.module,
    ).binders,
    identities: {
      let type_variables = l.binders.fold([], |accumulator: List<Int>, b: LawBinder|
        met(b.ty, accumulator));
      l.identities.map(|v: Int| number_of(type_variables, v))
    },
    module: l.at.module,
  }

pub const empty_prover_input: ProverInput =
  {
    declarations: [],
    signatures: [],
    builtins: [],
    obligations: [],
    measures: [],
    keys: [],
    numerics: [],
    invariants: [],
    imports: [],
    trusted_laws: [],
    operations: [],
  }

fn operations_of(effects: List<EffectInfo>) -> List<Operation> / {abort.raise} =
  effects.fold([], |accumulator: List<Operation>, e: EffectInfo|
    e.operations.fold(accumulator, |out: List<Operation>, operation: OperationInfo|
      out.push({
        effect: String::of_bytes_lossy(e.name),
        operation: String::of_bytes_lossy(operation.name),
        results: type_of(operation.return_type, met(operation.return_type, [])),
      })))

pub fn imports_of(modules: List<ParsedModule>) -> List<List<Int>> / {abort.raise} = {
  let index = range(0, modules.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
    match modules.at(i) { Some(m) -> accumulator.insert(m.name, i), None -> accumulator });
  let direct = modules.map(|m: ParsedModule|
    module_imports(m).fold([], |accumulator: List<Int>, name: Bytes|
      match index.get(name) { Some(j) -> accumulator.push(j), None -> accumulator }));
  range(0, modules.len()).map(|i: Int| reachable_from(direct, i))
}

fn reachable_from(direct: List<List<Int>>, from: Int) -> List<Int> / {abort.raise} = {
  let start = match direct.at(from) { Some(xs) -> xs, None -> [] };
  let seen = iterate(
    { seen: start.fold(Map::new(), |m: Map<Int, Bool>, x: Int| m.insert(x, true)), stack: start },
    direct.len() * direct.len() + 2,
    |s: { seen: Map<Int, Bool>, stack: List<Int> }|
      match s.stack.at(s.stack.len() - 1) {
        None -> Stop(s.seen),
        Some(i) -> {
          let rest = s.stack.take(s.stack.len() - 1);
          let next = match direct.at(i) { Some(xs) -> xs, None -> [] };
          Continue(
            next.fold(
              { seen: s.seen, stack: rest },
              |accumulator: { seen: Map<Int, Bool>, stack: List<Int> }, j: Int|
                if accumulator.seen.contains(j) { accumulator } else {
                  { seen: accumulator.seen.insert(j, true), stack: accumulator.stack.push(j) }
                },
            ),
          )
        },
      },
  );
  seen.keys().filter(|j: Int| j != from)
}

fn invariants_of(instances: List<InstanceInfo>) -> List<{ type_name: Bytes, by: Bytes }> =
  instances.fold([], |accumulator: List<{ type_name: Bytes, by: Bytes }>, x: InstanceInfo|
    match x.kind {
      InvariantInstance -> accumulator.push({ type_name: x.type_name, by: x.by }),
      _ -> accumulator,
    })

fn values_named(modules: List<ParsedModule>) -> Map<Bytes, List<Bytes>> =
  modules.fold(Map::new(), |accumulator: Map<Bytes, List<Bytes>>, m: ParsedModule|
    m.module.items.fold(accumulator, |a: Map<Bytes, List<Bytes>>, it: Item|
      match it {
        FunctionItem(d) -> {
          let bounds = d.params.fold(expression_nodes(d.body), |out: List<Expression>, p: Param|
            match p.default { Some(e) -> out.concat(expression_nodes(e)), None -> out });
          a.insert(
            qualify(m.name, d.name.name),
            bounds.fold([], |names: List<Bytes>, e: Expression|
              match e { NameExpression(v) -> names.push(v.name.name.name), _ -> names }),
          )
        },
        _ -> a,
      }))

fn builds_of(
  accumulator: CollectedObligations,
  d: DefinitionInfo,
  written: Map<Bytes, List<Bytes>>,
  stating: List<{ type_name: Bytes, by: Bytes }>,
  values: Map<Bytes, List<Bytes>>,
  h: HashOutput,
  closing: OpaqueTypes,
) -> CollectedObligations / {abort.raise} = {
  let named = h.dependencies.fold(
    [],
    |found: List<Bytes>, x: { name: Bytes, names: List<Bytes> }|
      if x.name == d.name { x.names } else { found },
  );
  let owed_for = stating.filter(|i: { type_name: Bytes, by: Bytes }| {
    let made = closing.constructors.filter(|c: ConstructorInfo|
      c.type_name == i.type_name && c.module == d.module);
    made.len() > 0 && i.by != d.name && named.contains(i.type_name)
      && (match values.get(d.name) {
        Some(used) -> made.any(|c: ConstructorInfo| used.contains(c.simple_name)),
        None -> true,
      })
  });
  if owed_for.len() == 0 { accumulator } else {
    let shape = match d.scheme.ty {
      FunctionType(f) -> { params: f.params, result_type: f.return_type },
      other -> { params: [], result_type: other },
    };
    let names = match written.get(d.name) { Some(ns) -> ns, None -> [] };
    let params = range(0, min(names.len(), shape.params.len())).map(|i: Int|
      { name: names.get(i), ty: shape.params.get(i) });
    let printed = binders_of(
      params.push({ name: b"result", ty: shape.result_type }),
      closing,
      d.module,
    );
    let check = h.checks.fold(b"", |found: Bytes, x: { name: Bytes, hash: Bytes }|
      if x.name == d.name { x.hash } else { found });
    owed_for.fold(accumulator, |a: CollectedObligations, i: { type_name: Bytes, by: Bytes }| {
      let typed = h.declarations.fold(b"", |found: Bytes, x: { name: Bytes, hash: Bytes }|
        if x.name == i.type_name { x.hash } else { found });
      let key = String::of_bytes_lossy(
        hex(blake3(Bytes::concat_all([b"builds\x00", check, typed]))),
      );
      {
        ..a,
        obligations: a.obligations.push({
          key: key,
          run_key: key,
          owner: String::of_bytes_lossy(d.name),
          kind: Builds(String::of_bytes_lossy(i.type_name)),
          at: at_of(d.at.module, d.at.span),
          binders: range(0, params.len()).map(|k: Int| printed.binders.get(k)),
          result: printed.binders.at(params.len()),
          variables: printed.variables,
          guards: [],
          literals: [],
          effects: None,
          frame: NoWrites,
          strategy: Bounded,
          identities: [],
        }),
      }
    })
  }
}

fn keys_of(instances: List<InstanceInfo>) -> List<{ type_name: String, by: String }> =
  instances.fold([], |accumulator: List<{ type_name: String, by: String }>, x: InstanceInfo|
    match x.kind {
      KeyInstance ->
        accumulator.push({
          type_name: String::of_bytes_lossy(x.type_name),
          by: String::of_bytes_lossy(x.by),
        }),
      _ -> accumulator,
    })

fn numerics_of(numeric: List<NumericInfo>) -> List<{ type_name: String, functions: List<String> }> =
  numeric.map(|x: NumericInfo|
    {
      type_name: String::of_bytes_lossy(x.type_name),
      functions: x.functions.map(String::of_bytes_lossy),
    })

const builtin_signatures: List<BuiltinSignature> =
  builtins.map(|b: Builtin|
    {
      name: String::of_bytes_lossy(b.name),
      ty: type_of(b.scheme.ty, met(b.scheme.ty, [])),
      pure: only_raises(b.scheme.ty),
    })

fn only_raises(t: Type) -> Bool =
  match t { FunctionType(f) -> is_pure_but_raise(f.effects), _ -> true }

pub fn measures_in(analysis: Analysis, owned: (Bytes) -> Bool) -> List<Measure> / {abort.raise} = {
  let stated = measures_of(analysis.modules);
  let written = if stated.keys().len() == 0 { Map::new() }
  else { written_params(analysis.modules) };
  analysis.checked.definitions.fold([], |accumulator: List<Measure>, d: DefinitionInfo|
    if !owned(d.module) { accumulator } else {
      match stated.get(d.name) {
        None -> accumulator,
        Some(m) -> {
          let shape = match d.scheme.ty { FunctionType(f) -> f.params, _ -> [] };
          let names = match written.get(d.name) { Some(ns) -> ns, None -> [] };
          accumulator.push({
            owner: String::of_bytes_lossy(d.name),
            at: at_of(d.at.module, expression_span(m)),
            binders: binders_of(
              range(0, min(names.len(), shape.len())).map(|i: Int|
                { name: names.get(i), ty: shape.get(i) }),
              no_opaque_types,
              d.module,
            ).binders,
          })
        },
      }
    })
}

fn measures_of(modules: List<ParsedModule>) -> Map<Bytes, Expression> =
  modules.fold(Map::new(), |accumulator: Map<Bytes, Expression>, m: ParsedModule|
    m.module.items.fold(accumulator, |a: Map<Bytes, Expression>, item: Item|
      match item {
        FunctionItem(d) -> match d.decreases {
          Some(e) -> a.insert(qualify(m.name, d.name.name), e),
          None -> a,
        },
        _ -> a,
      }))

pub fn whole_of(source: Bytes) -> Analysis / {abort.raise} =
  match analyse(parse_all([{ name: b"m", source_text: source }])) {
    Rejected(_) -> panic("the fixture program was rejected by the checker"),
    Analysed(w) -> w,
  }

pub fn every(m: Bytes) -> Bool = true

fn prover_input(source: Bytes) -> ProverInputResult / {abort.raise} =
  prover_input_of(whole_of(source), every)

fn declaration_named(ds: List<Declaration>, name: String) -> Declaration / {abort.raise} =
  match ds.fold(None, |found: Option<Declaration>, d: Declaration|
      match found { Some(_) -> found, None -> if d.name == name { Some(d) } else { None } }) {
    Some(d) -> d,
    None -> panic("the fixture has no declaration with that name"),
  }

fn signature_named(ss: List<Signature>, name: String) -> Signature / {abort.raise} =
  match ss.fold(None, |found: Option<Signature>, s: Signature|
      match found { Some(_) -> found, None -> if s.name == name { Some(s) } else { None } }) {
    Some(s) -> s,
    None -> panic("the fixture has no signature with that name"),
  }

fn owned_by(os: List<Obligation>, owner: String) -> List<Obligation> =
  os.filter(|obligation: Obligation| obligation.owner == owner)

fn strategies(os: List<Obligation>, owner: String) -> List<Strategy> =
  owned_by(os, owner).map(|obligation: Obligation| obligation.strategy)

test "a declared type is its constructors in declaration order, written over its parameters" {
  let w = prover_input(
    b"type Pair<a> = | Both(a, a) | Neither\ntype Wrap = | Held(Pair<Bool>)\n",
  ).world;
  assert_eq(declaration_named(w.declarations, "m.Pair"), {
    name: "m.Pair",
    params: 1,
    variants: [
      { name: "m.Both", fields: [SortVariable(0), SortVariable(0)] },
      { name: "m.Neither", fields: [] },
    ],
  });
  assert_eq(declaration_named(w.declarations, "m.Wrap").variants, [
    { name: "m.Held", fields: [NamedSort("m.Pair", [NamedSort("Bool", [])])] },
  ]);
  assert_eq(declaration_named(w.declarations, "Option"), {
    name: "Option",
    params: 1,
    variants: [{ name: "None", fields: [] }, { name: "Some", fields: [SortVariable(0)] }],
  })
}

test "a signature numbers its variables by first appearance, and says whether its effects are empty" {
  let w = prover_input(
    b"effect log { write emit(Bytes) -> Unit }\nfn say(b: Bytes) -> Unit / {log.write} = log.emit(b)\nfn apply<x, y>(f: (y) -> x, v: y) -> x = f(v)\n",
  ).world;
  assert_eq(signature_named(w.signatures, "m.apply"), {
    name: "m.apply",
    ty: FunctionSort(
      [FunctionSort([SortVariable(0)], SortVariable(1), true), SortVariable(0)],
      SortVariable(1),
      true,
    ),
    pure: true,
    effects_pure: true,
    raises: false,
    through: [],
  });
  let say = signature_named(w.signatures, "m.say");
  assert_eq(say.pure, false);
  assert_eq(say.ty, FunctionSort([NamedSort("Bytes", [])], NamedSort("Unit", []), false))
}

test "a clause's variables are its definition's parameters as written, and `result` is the definition's return value" {
  let built = prover_input(
    b"fn pick<a, b>(first: a, second: b) -> a requires [second].len() == 1 ensures [result].len() == 1 ensures [first].len() == 1 = first\n",
  );
  assert_eq(built.warnings, []);
  let os = owned_by(built.world.obligations, "m.pick");
  assert_eq(os.map(|o: Obligation| o.kind), [Ensures(0), Ensures(1)]);
  let o = os.get(0);
  assert_eq(o.binders, [
    { name: "first", ty: SortVariable(0), text: "a", constructible: true },
    { name: "second", ty: SortVariable(1), text: "b", constructible: true },
  ]);
  assert_eq(
    o.result,
    Some({ name: "result", ty: SortVariable(0), text: "a", constructible: true }),
  );
  assert_eq(o.variables, ["a", "b"]);
  assert_eq(o.guards.map(|g: { module: Int, start: Int, end: Int }| g.start), [49]);
  assert_eq(o.frame, NoWrites);
  assert_eq(o.effects, None);
  assert_eq(o.key.len(), 64);
  assert(os.get(0).key != os.get(1).key)
}

test "the parameters of one `law` use one shared numbering of type variables, so two different type variables never get the same number" {
  let os = owned_by(
    prover_input(
      b"law \"apart\" forall (x: a, y: b, f: (a) -> List<b>) { f(x).len() >= 0 && [y].len() == 1 }\n",
    ).world.obligations,
    "m.apart",
  );
  assert_eq(os.len(), 1);
  let o = os.get(0);
  assert_eq(o.kind, Law(Some("apart")));
  assert_eq(o.binders.map(|binder: Binder| binder.ty), [
    SortVariable(0),
    SortVariable(1),
    FunctionSort([SortVariable(0)], NamedSort("List", [SortVariable(1)]), true),
  ]);
  assert_eq(o.binders.map(|binder: Binder| binder.text), ["a", "b", "(a) -> List<b>"]);
  assert_eq(o.variables, ["a", "b"]);
  assert_eq(o.result, None);
  assert_eq(o.guards, [])
}

test "a claim's variables are named as its binders print them, skipping effect variables' letters" {
  let os = owned_by(
    prover_input(
      b"law \"five\" forall (v: p, w: q, x: r, y: s, z: u) { [v].len() + [w].len() + [x].len() + [y].len() + [z].len() == 5 }\n",
    ).world.obligations,
    "m.five",
  );
  let o = os.get(0);
  assert_eq(o.variables, ["a", "b", "c", "d", "g"]);
  assert_eq(o.binders.map(|binder: Binder| binder.text), o.variables)
}

test "an `ensures` clause's frame comes from the effects its definition declares, and a read effect writes nothing" {
  let os = prover_input(
    b"effect store {\n  read get() -> Int\n  write put(n: Int) -> Unit\n}\nfn peek() -> Int / {store.read} ensures true = store.get()\nfn poke(n: Int) -> Unit / {store.read, store.write} ensures true = store.put(n)\n",
  ).world.obligations;
  assert_eq(owned_by(os, "m.peek").map(|obligation: Obligation| obligation.frame), [NoWrites]);
  assert_eq(owned_by(os, "m.poke").map(|obligation: Obligation| obligation.frame), [
    Writes(["m.store"]),
  ])
}

fn hex_len(o: Option<String>) -> Int = match o { Some(t) -> t.len(), None -> 0 }

test "`prover_input_of` includes the definitions and `law`s of the modules being proved, with hashes and texts matching what review stores" {
  let w = whole_of(
    b"fn f(x: Int) -> Int ensures result == x = x\nfn g() -> Int = 1\nlaw \"f is g\" forall (x: Int) { f(x) == x + g() - 1 }\n",
  );
  let built = prover_input_of(w, |m: Bytes| m == b"m");
  assert_eq(built.definitions.map(|d: Definition| d.name), ["m.f", "m.g"]);
  assert_eq(built.definitions.map(|d: Definition| hex_len(d.hash)), [64, 64]);
  assert_eq(built.definitions.map(|d: Definition| d.specs.map(String::len)), [[64], []]);
  assert_eq(built.laws.map(|l: WrittenLaw| (l.key, l.text.len())), [("m.f is g", 64)]);
  let mentions = built.laws.get(0).mentions;
  assert(mentions.contains("m.f") && mentions.contains("m.g"));
  let other = prover_input_of(w, |m: Bytes| m != b"m");
  assert_eq(other.definitions.filter(|d: Definition| d.name.starts_with("m.")), []);
  assert_eq(other.laws, [])
}

test "`prover_input_of` omits the claims of modules outside the proof run, but still includes their types" {
  let built = prover_input_of(
    whole_of(b"type Coin = | Heads | Tails\nlaw \"heads\" forall (c: Coin) { c == c || true }\n"),
    |m: Bytes| m != b"m",
  );
  assert_eq(built.world.obligations, []);
  assert_eq(declaration_named(built.world.declarations, "m.Coin").variants.len(), 2)
}

const coin_type_shape: Shape =
  Cases(2, [{ name: "m.Heads", size: 1, fields: [] }, { name: "m.Tails", size: 1, fields: [] }])

test "a claim over no effects is tried by the static prover, and also by running every value when its parameter types are finite" {
  let os = prover_input(
    b"type Coin = | Heads | Tails\nfn turn(c: Coin, twice: Bool) -> Coin ensures result == c || result != c = if twice { c } else { match c { Heads -> Tails, Tails -> Heads } }\nfn double(n: Int) -> Int ensures result == n + n = n + n\nlaw \"coins\" forall (c: Coin, b: Bool) { c == c || b }\nlaw \"ints\" forall (n: Int) { n == n }\nlaw \"ground\" { 1 == 1 }\n",
  ).world.obligations;
  let walked = Static(
    Run(Every({ shapes: [coin_type_shape, Scalar("Bool", 2)], points: 4 }, "m.Coin × Bool")),
  );
  assert_eq(strategies(os, "m.turn"), [walked]);
  assert_eq(strategies(os, "m.coins"), [walked]);
  assert_eq(strategies(os, "m.double"), [Static(Run(NotEnumerable))]);
  assert_eq(strategies(os, "m.ints"), [Static(Run(NotEnumerable))]);
  assert_eq(strategies(os, "m.ground"), [Static(Run(Every({ shapes: [], points: 1 }, "unit")))])
}

test "an `ensures` on a definition with effects stays unresolved when the static prover cannot handle those effects" {
  let os = prover_input(
    b"effect store {\n  read get() -> Int\n  write put(n: Int) -> Unit\n}\nfn peek() -> Int / {store.read} ensures true = store.get()\nfn poke(n: Int) -> Unit / {store.read, store.write} ensures true = store.put(n)\n",
  ).world.obligations;
  assert_eq(strategies(os, "m.peek"), [Static(Unhandled("{m.store.read}"))]);
  assert_eq(strategies(os, "m.poke"), [Static(Unhandled("{m.store.read, m.store.write}"))])
}

test "a claim over a function that can raise is not checked by running every value, because running it may raise" {
  let os = prover_input(
    b"fn share(total: Int, parts: Int) -> Int / {abort.raise} ensures true = total / parts\nlaw \"whole\" forall (n: Int) { share(n, 1) == n }\n",
  ).world.obligations;
  assert_eq(strategies(os, "m.share"), [Static(Run(NotEnumerable))]);
  assert_eq(strategies(os, "m.whole"), [Static(Run(NotEnumerable))])
}

fn simulated(binders: Bytes, first: Bytes) -> Bytes =
  Bytes::concat_all([
    b"effect chan {\n  write put[q](v: Int) -> Unit\n}\nfn worker(v: Int) -> Unit / {chan.write[q]} = chan.put[q](v)\nlaw \"two writers\" ",
    binders,
    b" {\n  handle {\n    simulate {\n      let a = task.spawn(|| worker(",
    first,
    b"));\n      let b = task.spawn(|| worker(2));\n      task.join(a);\n      task.join(b)\n    }\n  } with {\n    var got = [],\n    chan.put[q](v) -> {\n      got = got.push(v);\n    },\n    return u -> got.len() == 2,\n  }\n}\n",
  ])

fn simulated_strategies(binders: Bytes, first: Bytes) -> List<Strategy> / {abort.raise} =
  strategies(prover_input(simulated(binders, first)).world.obligations, "m.two writers")

test "a `law` over a simulation searches every interleaving, at every input when the inputs are finite" {
  assert_eq(simulated_strategies(b"forall (flip: Bool)", b"if flip { 1 } else { 3 }"), [
    Interleave(Every({ shapes: [Scalar("Bool", 2)], points: 2 }, "Bool")),
  ]);
  assert_eq(simulated_strategies(b"forall (n: Int)", b"n"), [Interleave(NotEnumerable)]);
  assert_eq(simulated_strategies(b"", b"1"), [Interleave(Every({ shapes: [], points: 1 }, "unit"))])
}

test "each `cost` or `space` bound is a separate claim, numbered by its position among the `cost` or `space` claims of the same definition" {
  let built = prover_input(
    b"fn total(xs: List<Int>) -> Int requires xs.len() >= 0 cost xs.len() ensures result == result space 0 cost xs.len() * xs.len() = xs.fold(0, |a: Int, x: Int| a + x)\n",
  );
  assert_eq(built.warnings, []);
  let os = owned_by(built.world.obligations, "m.total");
  assert_eq(os.map(|o: Obligation| o.kind), [Cost(0), Ensures(0), Space(0), Cost(1)]);
  assert_eq(os.map(|o: Obligation| o.strategy == Bounded), [true, false, true, true]);
  let bound = os.get(0);
  assert_eq(bound.binders.map(|b: Binder| b.name), ["xs"]);
  assert_eq(bound.result, None);
  assert_eq(bound.guards, []);
  assert(bound.key != os.get(2).key && os.get(2).key != os.get(3).key)
}

test "a `law`'s guard is its `where` condition, located at its position in the source" {
  let os = owned_by(
    prover_input(b"law \"bounded\" forall (x: Int) where x > 0 { x + 0 == x }\n").world.obligations,
    "m.bounded",
  );
  assert_eq(
    os.map(|obligation: Obligation|
      obligation.guards.map(|g: { module: Int, start: Int, end: Int }| (g.start, g.end))),
    [[(36, 41)]],
  )
}

test "a `decreases` measure belongs to its definition, is not an obligation, and uses the parameters as written" {
  let source = b"fn climb(a: Int, b: Int) -> Int decreases a + b = if a + b <= 0 { 0 } else { climb(a + 1, b - 2) }\nfn plain(n: Int) -> Int = n\n";
  let w = prover_input(source).world;
  assert_eq(w.measures.map(|m: Measure| m.owner), ["m.climb"]);
  assert_eq(w.measures.map(|m: Measure| m.binders.map(|b: Binder| b.name)), [["a", "b"]]);
  assert_eq(owned_by(w.obligations, "m.climb"), [])
}

test "outside the module that defines an opaque type, the prover never builds values of it from its fields, and claims about those values are not run" {
  let shipped = [
    {
      name: b"std.vault",
      source_text: b"pub opaque type Token = | Token(Int)\npub opaque type Stamp = new { at: Int }\npub opaque type Coin = | Heads | Tails\npub fn worth(t: Token) -> Int ensures result != 7 = match t { Token(n) -> n }\npub fn turned(c: Coin) -> Int ensures result != 7 = 1\n",
    },
  ];
  let user = [
    {
      name: b"m",
      source_text: b"import std.vault (Token, Stamp, Coin)\ntype Held = | Held(Token, Int)\nfn kept(t: Token) -> Int ensures result != 7 = 1\nfn stamps(ss: List<Stamp>) -> Int ensures result != 7 = ss.len()\nfn wrapped(h: Held) -> Int ensures result != 7 = 1\nfn flipped(c: Coin, n: Int) -> Int ensures result != 7 = n\n",
    },
  ];
  let built = match analyse_pulling_std_with(user, shipped, no_rows, cut_unused: false).out {
    Rejected(_) -> panic("the fixture program was rejected by the checker"),
    Analysed(w) -> prover_input_of(w, every),
  };
  let made = |owner: String|
    owned_by(built.world.obligations, owner).get(0).binders.map(|b: Binder| b.constructible);
  assert_eq(made("m.kept"), [false]);
  assert_eq(made("m.stamps"), [false]);
  assert_eq(made("m.wrapped"), [false]);
  assert_eq(made("m.flipped"), [false, true]);
  assert_eq(strategies(built.world.obligations, "m.flipped"), [Static(Run(NotEnumerable))]);
  assert_eq(made("std.vault.worth"), [true]);
  assert_eq(made("std.vault.turned"), [true]);
  assert_eq(strategies(built.world.obligations, "std.vault.turned"), [
    Static(
      Run(
        Every(
          {
            shapes: [
              Cases(2, [
                { name: "std.vault.Heads", size: 1, fields: [] },
                { name: "std.vault.Tails", size: 1, fields: [] },
              ]),
            ],
            points: 2,
          },
          "std.vault.Coin",
        ),
      ),
    ),
  ])
}

fn app_law_key(source: Bytes) -> String / {abort.raise} =
  match analyse(
      parse_all([
        { name: b"base", source_text: b"pub fn f(x: Int) -> Int = x\n".concat(source) },
        {
          name: b"app",
          source_text: b"import base\nlaw \"uses\" forall (x: Int) { base::f(x) == x }\n",
        },
      ]),
    ) {
    Rejected(_) -> panic("the fixture program was rejected by the checker"),
    Analysed(w) -> match prover_input_of(w, |m: Bytes| m == b"app").world.obligations.fold(
        None,
        |found: Option<String>, o: Obligation|
          if o.owner == "app.uses" { Some(o.key) } else { found },
      ) {
      Some(k) -> k,
      None -> panic("the fixture has no claim named `app.uses`"),
    },
  }

test "a claim's cache key changes when the `law`s of an imported package change, and when the definitions a `law` mentions change" {
  let none = app_law_key(b"");
  let one = app_law_key(b"law \"f is itself\" forall (x: Int) { f(x) == x }\n");
  let reworded = app_law_key(b"law \"f is itself\" forall (y: Int) { f(y) == y + 0 }\n");
  assert(none != one);
  assert(one != reworded);
  assert_eq(one, app_law_key(b"law \"f is itself\" forall (x: Int) { f(x) == x }\n"));
  let named = |g: Bytes|
    app_law_key(
      Bytes::concat_all([
        b"fn g(x: Int) -> Int = ",
        g,
        b"\nlaw \"f is g\" forall (x: Int) { f(x) == g(x) }\n",
      ]),
    );
  assert(named(b"x") != named(b"x + 0"))
}
