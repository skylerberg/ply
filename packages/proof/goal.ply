import compiler.emit.code (Code)
import context (Context, inhabited)
import domain (Sort)
import lemma (Lemma)
import rules (RuleLog, Rule)
import solve (Solver, Verdict, Closed, refute)
import sort (bool_sort, is_named_sort, sort_variables)
import term (Terms, InternedTerm, Node, IntTerm, BoolTerm, StringTerm, DecimalTerm, FixedTerm,
             UnitTerm, SymbolTerm, OpaqueTerm, LinearSumTerm, ApplicationTerm, ConstructorTerm,
             NilTerm, ConsTerm, RecordTerm, FieldTerm, NotTerm, AndTerm, OrTerm, CompareTerm,
             EqualTerm, EqualAtTerm, IfTerm, MatchTerm, Monomial, Arm, TestLiteral, Ge, Le, size,
             node, sort_of, int_literal, comparison, and, operator_add, operator_sub, op_mul,
             operator_div, op_rem, operator_concat, operator_bit_and, operator_bit_or, op_bit_xor,
             operator_bit_not, op_shl, op_shr, op_ushr)

pub type Binder = { name: String, ty: Sort }

pub type Goal = {
  binders: List<Binder>,
  guards: List<Option<Code>>,
  result: Option<Option<Code>>,
  body: Option<Code>,
  lemmas: List<Lemma>,
  assumed_terminating: List<String>,
  partial: Bool,
  identities: List<Int>,
  contracts: List<String>,
  induction_hypothesis: Option<{ name: String, clause: Int }>,
  builds: Option<{ type_name: String, by: String }>,
  tainted: List<String>,
}

pub type Limits = { steps: Int, unfold_depth: Int, split_depth: Int }

pub fn default_prove_budget() -> Int = 10000

pub fn default_unfold_depth() -> Int = 3

pub fn default_limits() -> Limits =
  { steps: default_prove_budget(), unfold_depth: default_unfold_depth(), split_depth: 48 }

pub type UnknownReason = | Open | BudgetSpent

pub type Proof = { rules: List<Rule>, steps: Int, sorts: List<Int>, guard_satisfiable: Bool }

pub type Assertion = { term: Int, polarity: Bool }

pub type RefutationResult = { terms: Terms, rules: RuleLog, result: Verdict, left: Int }

pub fn run_refutation(
  terms: Terms,
  context: Context,
  rules: RuleLog,
  budget: Int,
  limits: Limits,
  assertions: List<Assertion>,
) -> RefutationResult / {abort.raise} = {
  let r = refute(
    {
      terms: terms,
      rules: rules,
      budget: budget,
      split_depth: limits.split_depth,
      context: context,
    },
    assertions,
  );
  { terms: r.solver.terms, rules: r.solver.rules, result: r.result, left: r.solver.budget }
}

pub fn conjunction(
  terms: Terms,
  guards: List<Int>,
) -> { terms: Terms, id: Option<Int> } / {abort.raise} =
  guards.fold(
    { terms: terms, id: None },
    |accumulator: { terms: Terms, id: Option<Int> }, g: Int|
      match accumulator.id {
        None -> { terms: accumulator.terms, id: Some(g) },
        Some(previous) -> {
          let m = and(accumulator.terms, previous, g);
          { terms: m.terms, id: Some(m.id) }
        },
      },
  )

pub fn domain_inhabited(context: Context, binders: List<Binder>) -> Bool =
  binders.fold(true, |ok: Bool, binder: Binder| ok && inhabited(context, binder.ty))

pub fn uninterpreted_sorts(binders: List<Binder>) -> List<Int> = {
  let found = binders.fold([], |accumulator: List<Int>, binder: Binder|
    sort_variables(binder.ty, accumulator));
  found.fold([], |accumulator: List<Int>, v: Int| {
    let before = accumulator.filter(|x: Int| x < v);
    let after = accumulator.filter(|x: Int| x > v);
    after.fold(before.push(v), |a: List<Int>, x: Int| a.push(x))
  })
}

pub fn int_ranges(
  terms: Terms,
  computed: Option<Int>,
  skip: Map<Int, Bool>,
) -> { terms: Terms, out: List<Assertion> } / {abort.raise} = {
  let derived = terms_containing(terms, computed);
  let effects = range(0, size(terms)).filter(|t: Int|
    derived.at(t) != Some(true) && !skip.contains(t)
      && (match node(terms, t) {
        SymbolTerm(_) -> true,
        FieldTerm(_) -> true,
        ApplicationTerm(a) -> match node(terms, a.head) {
          OpaqueTerm(name) -> !is_operator_symbol(name),
          _ -> true,
        },
        _ -> false,
      })
      && (match sort_of(terms, t) { Some(s) -> is_named_sort(s, "Int"), None -> false }));
  ranges_of(terms, effects)
}

pub fn ranges_of(
  terms: Terms,
  candidates: List<Int>,
) -> { terms: Terms, out: List<Assertion> } / {abort.raise} = {
  let effects = candidates.filter(|a: Int|
    match sort_of(terms, a) { Some(s) -> is_named_sort(s, "Int"), None -> false });
  let min = int_literal(terms, 0 - 9223372036854775807 - 1);
  let max = int_literal(min.terms, 9223372036854775807);
  let zero = int_literal(max.terms, 0);
  let below_max = int_literal(zero.terms, 9223372036854775806);
  effects.fold(
    { terms: below_max.terms, out: [] },
    |accumulator: { terms: Terms, out: List<Assertion> }, a: Int| {
      let length = is_length(accumulator.terms, a);
      let low = comparison(accumulator.terms, Ge, a, if length { zero.id } else { min.id });
      let high = comparison(low.terms, Le, a, if length { below_max.id } else { max.id });
      {
        terms: high.terms,
        out: accumulator.out.push({ term: low.id, polarity: true }).push({
          term: high.id,
          polarity: true,
        }),
      }
    },
  )
}

fn is_length(terms: Terms, t: Int) -> Bool / {abort.raise} =
  match node(terms, t) {
    ApplicationTerm(a) -> match node(terms, a.head) {
      OpaqueTerm(name) -> name == "List::len",
      _ -> false,
    },
    _ -> false,
  }

pub fn terms_containing(terms: Terms, root: Option<Int>) -> List<Bool> / {abort.raise} =
  match root {
    None -> range(0, size(terms)).map(|_: Int| false),
    Some(r) ->
      range(0, size(terms)).fold(
        range(0, size(terms)).map(|t: Int| t == r),
        |out: List<Bool>, t: Int|
          if out.at(t) == Some(true) { out }
          else if children(node(terms, t)).fold(false, |f: Bool, c: Int|
              f || out.at(c) == Some(true)) { out.set(t, true) }
          else { out },
      ),
  }

pub fn children(n: Node) -> List<Int> =
  match n {
    LinearSumTerm(p) -> p.monomials.map(|m: Monomial| m.term),
    ApplicationTerm(a) ->
      a.args.fold([a.head], |accumulator: List<Int>, x: Int| accumulator.push(x)),
    ConstructorTerm(c) -> c.args,
    ConsTerm(c) -> [c.head, c.tail],
    RecordTerm(fields) -> fields.map(|f: { name: String, value: Int }| f.value),
    FieldTerm(f) -> [f.base],
    NotTerm(a) -> [a],
    AndTerm(a, b) -> [a, b],
    OrTerm(a, b) -> [a, b],
    CompareTerm(c) -> [c.left_operand, c.right_operand],
    EqualTerm(e) -> [e.left_operand, e.right_operand],
    EqualAtTerm(e) -> [e.left_operand, e.right_operand],
    IfTerm(i) -> [i.cond, i.then_branch, i.else_branch],
    MatchTerm(m) ->
      m.arms.fold([m.scrutinee], |accumulator: List<Int>, arm: Arm| {
        let with_body = arm.binds.fold(accumulator, |a: List<Int>, x: Int| a.push(x)).push(
          arm.body,
        );
        match arm.test { TestLiteral(literal) -> with_body.push(literal), _ -> with_body }
      }),
    _ -> [],
  }

fn is_operator_symbol(name: String) -> Bool =
  [
    operator_add(),
    operator_sub(),
    op_mul(),
    operator_div(),
    op_rem(),
    operator_concat(),
    operator_bit_and(),
    operator_bit_or(),
    op_bit_xor(),
    operator_bit_not(),
    op_shl(),
    op_shr(),
    op_ushr(),
  ].fold(false, |f: Bool, operator: String| f || operator == name)

pub fn true_assertions(ids: List<Int>) -> List<Assertion> =
  ids.map(|t: Int| { term: t, polarity: true })
