import compiler.emit.code (Code, CodeLiteral, CodeVariable, NDefinition, NConstructor, NBuiltin,
                           CodeUnary, CodeBinary, CodeApply, CodeKnownLambda, CodeIf, CodeBlock,
                           CodeList, CodeRecord, CodeMatch, CodePerform, CodeLabel, CodeLambda,
                           CodeSimulate, CodeParallel, CodeHandle, CodeFieldRead, CodeUpdate,
                           CodeStatement, CodeLet, CodeLetDestructure, CodeDo, CodeField, CodeArm,
                           CodeClause, Node, read_name, code_nodes_mapped)
import compiler.emit.moves (Moves, root_moves)
import compiler.emit.keys (Named)
import compiler.emit.lower.module_context (ModuleContext, ItemRoot, module_contexts_in)
import compiler.check.infer.definitions (Extern, parsed_natives)
import compiler.front.facts (Analysis)
import compiler.front.published (Claim, ClaimDefinition, ClaimSum, ClaimLaw, ClaimClause,
                                 LoweredClause, claims_in, rows_of, inferred_facts, prover_builtin,
                                 prover_modelled)
import compiler.syntax.items (FunctionItem)
import compiler.syntax.parsing (Span)
import domain (Sort, SortVariable, FunctionSort, RecordSort, NamedSort, Declaration, Variant,
               substituted)
import sort (canonical, shift_variables, external_variable_base)
import prover_input (BuiltinSignature, Operation, Signature, ProverInput)
import std.graph

pub type Definition = {
  params: Int,
  cost_parameters: List<Int>,
  space_parameters: List<Int>,
  body: Option<Code>,
  spec: List<ClaimClause>,
  measure: Option<Code>,
  refs: List<String>,
  terminates: Bool,
  stated: Bool,
}

pub type Law = { guard: Option<LoweredClause>, body: Code }

pub type Claims = {
  definitions: Map<String, Definition>,
  laws: Map<String, Law>,
  sums: Map<String, Int>,
  read: Option<{ analysis: Analysis, modules: List<Int> }>,
  trusted: Map<String, Bool>,
}

pub type BodyWithMoves = { body: Code, moves: Moves }

pub type Constructor = { declaration: Declaration, variant: Variant }

pub type Context = {
  claims: Claims,
  declarations: Map<String, Declaration>,
  constructors: Map<String, Constructor>,
  signatures: Map<String, Signature>,
  recursive: Map<String, Bool>,
  self_recursive: Map<String, Bool>,
  groups: Map<String, List<String>>,
  measured: Map<String, Bool>,
  sums: Map<String, Bool>,
  inhabited_sums: Map<String, Bool>,
  keyed_types: Map<String, Bool>,
  compared_by_key: Map<String, Bool>,
  keys: Map<String, String>,
  numerics: Map<String, List<String>>,
  builtins: Map<String, BuiltinSignature>,
  invariants: Map<String, String>,
  operations: Map<String, Option<Sort>>,
}

pub fn claims_of(cs: List<Claim>) -> Claims =
  cs.fold(
    {
      definitions: Map::new(),
      laws: Map::new(),
      sums: Map::new(),
      read: None,
      trusted: Map::new(),
    },
    |accumulator: Claims, c: Claim|
      match c {
        ClaimDefinition(d) ->
          {
            ..accumulator,
            definitions: accumulator.definitions.insert(String::of_bytes_lossy(d.name), {
              params: d.params,
              cost_parameters: d.cost_parameters,
              space_parameters: d.spaced,
              body: d.body,
              spec: d.spec,
              measure: d.measure,
              refs: match d.body { Some(b) -> refs_of(b, []), None -> [] },
              terminates: d.ends,
              stated: d.stated,
            }),
          },
        ClaimLaw(l) ->
          {
            ..accumulator,
            laws: accumulator.laws.insert(String::of_bytes_lossy(l.key), {
              guard: l.guard,
              body: l.body,
            }),
          },
        ClaimSum(s) ->
          {
            ..accumulator,
            sums: accumulator.sums.insert(String::of_bytes_lossy(s.name), s.variants),
          },
      },
  )

pub fn claims_from_analysis(
  analysis: Analysis,
  modules: List<Int>,
  owned: (Bytes) -> Bool,
) -> Claims / {abort.raise} = {
  let read = claims_of(claims_in(analysis, modules, owned));
  let elsewhere = |name: String| !owned(module_of(name));
  {
    ..read,
    read: Some({ analysis: analysis, modules: modules }),
    trusted: read.definitions.keys().fold(Map::new(), |m: Map<String, Bool>, n: String|
      if elsewhere(n) { m.insert(n, true) } else { m }),
  }
}

pub fn module_of(name: String) -> Bytes / {abort.raise} = {
  let b = Bytes::of_string(name);
  let cut = range(0, b.len()).fold(0 - 1, |last: Int, i: Int|
    if b.slice(i, i + 1) == b"." { i } else { last });
  if cut < 0 { b"" } else { b.slice(0, cut) }
}

pub fn moved_bodies(
  claims: Claims,
  names: List<String>,
) -> Map<String, Result<BodyWithMoves, String>> / {abort.raise} =
  match claims.read {
    None -> Map::new(),
    Some(r) -> {
      let wanted = names.fold(Map::new(), |accumulator: Map<String, Bool>, name: String|
        match claims.definitions.get(name) {
          Some(d) -> if d.body == None { accumulator } else { accumulator.insert(name, true) },
          None -> accumulator,
        });
      if wanted.len() == 0 { Map::new() } else { moved_bodies_in(r.analysis, r.modules, wanted) }
    },
  }

fn moved_bodies_in(
  analysis: Analysis,
  modules: List<Int>,
  wanted: Map<String, Bool>,
) -> Map<String, Result<BodyWithMoves, String>> / {abort.raise} = {
  let writes = |i: Int| {
    let prefix = analysis.modules.get(i).name.concat(b".");
    wanted.fold(false, |any: Bool, name: String, _: Bool| {
      let n = Bytes::of_string(name);
      any || (n.starts_with(prefix) && n.slice(prefix.len(), n.len()).index_of(b".") == None)
    })
  };
  let natives = parsed_natives(analysis.modules).map(|e: Extern| e.name);
  let modelled = prover_modelled;
  match module_contexts_in(
      analysis,
      rows_of(analysis),
      inferred_facts(analysis),
      analysis.modules,
      modules.filter(writes),
      |i: Int, setting: ModuleContext, roots: List<ItemRoot>| {
        let s = { ..setting, builtins: natives };
        roots.fold(
          [],
          |accumulator: List<{ name: String, moved: Result<BodyWithMoves, String> }>, r: ItemRoot|
            match ((r.item, r.root.key)) {
              (FunctionItem(_), Named(full)) -> {
                let name = String::of_bytes_lossy(full);
                if !wanted.contains(name) { accumulator } else {
                  accumulator.push({
                    name: name,
                    moved: Ok({
                      body: code_nodes_mapped(r.root.code, |c: Code|
                        match c.node {
                          NDefinition(d) -> match prover_builtin(modelled, d.full) {
                            Some(b) ->
                              {
                                ..c,
                                node: NBuiltin({
                                  name: b,
                                  args: d.args,
                                  effect_arguments: d.effect_arguments,
                                }),
                              },
                            None -> c,
                          },
                          _ -> c,
                        }),
                      moves: root_moves(s, r.root),
                    }),
                  })
                }
              },
              _ -> accumulator,
            },
        )
      },
    ) {
    Err(reason) ->
      wanted.fold(
        Map::new(),
        |accumulator: Map<String, Result<BodyWithMoves, String>>, name: String, _: Bool|
          accumulator.insert(
            name,
            Err(
              "the program's definitions could not be loaded: " ++ String::of_bytes_lossy(reason),
            ),
          ),
      ),
    Ok(found) ->
      found.fold(
        Map::new(),
        |accumulator: Map<String, Result<BodyWithMoves, String>>, rows: List<{ name: String, moved: Result<BodyWithMoves, String> }>|
          rows.fold(
            accumulator,
            |a: Map<String, Result<BodyWithMoves, String>>, row: { name: String, moved: Result<BodyWithMoves, String> }|
              a.insert(row.name, row.moved),
          ),
      ),
  }
}

pub fn refs_of(c: Code, accumulator: List<String>) -> List<String> =
  globals_of(c, []).fold(accumulator, |s: List<String>, g: Global| s.push(g.name))

pub type Global = { name: String, at: Span }

fn named_global(c: Code, accumulator: List<Global>) -> List<Global> =
  match read_name(c) {
    Some(n) -> accumulator.push({ name: String::of_bytes_lossy(n), at: c.span }),
    None -> accumulator,
  }

pub fn globals_of(c: Code, accumulator: List<Global>) -> List<Global> =
  match c.node {
    CodeVariable(_) -> accumulator,
    NDefinition(_) -> named_global(c, accumulator),
    NConstructor(_) -> named_global(c, accumulator),
    NBuiltin(_) -> named_global(c, accumulator),
    CodeLiteral(_) -> accumulator,
    CodeLabel(_) -> accumulator,
    CodeUnary(u) -> globals_of(u.operand, accumulator),
    CodeBinary(b) -> globals_of(b.right_operand, globals_of(b.left_operand, accumulator)),
    CodeApply(a) ->
      a.args.fold(globals_of(a.function, accumulator), |s: List<Global>, x: Code| globals_of(x, s)),
    CodeKnownLambda(_) -> accumulator,
    CodeIf(i) ->
      globals_of(i.else_branch, globals_of(i.then_branch, globals_of(i.cond, accumulator))),
    CodeBlock(b) -> {
      let statements = b.statements.fold(accumulator, |s: List<Global>, st: CodeStatement|
        match st {
          CodeLet(l) -> globals_of(l.value, s),
          CodeLetDestructure(l) -> globals_of(l.value, s),
          CodeDo(d) -> globals_of(d.code, s),
        });
      match b.tail { Some(t) -> globals_of(t, statements), None -> statements }
    },
    CodeList(l) -> l.items.fold(accumulator, |s: List<Global>, x: Code| globals_of(x, s)),
    CodeRecord(r) ->
      r.fields.fold(accumulator, |s: List<Global>, f: CodeField| globals_of(f.value, s)),
    CodeMatch(m) ->
      m.arms.fold(globals_of(m.scrutinee, accumulator), |s: List<Global>, a: CodeArm|
        globals_of(a.body, match a.guard { Some(g) -> globals_of(g, s), None -> s })),
    CodePerform(p) -> p.args.fold(accumulator, |s: List<Global>, x: Code| globals_of(x, s)),
    CodeLambda(l) -> globals_of(l.body, accumulator),
    CodeSimulate(s) -> globals_of(s.body, accumulator),
    CodeParallel(parallel_code) ->
      parallel_code.branches.fold(accumulator, |s: List<Global>, x: Code| globals_of(x, s)),
    CodeHandle(h) -> {
      let clauses = h.clauses.fold(
        globals_of(h.body, accumulator),
        |s: List<Global>, clause: CodeClause| globals_of(clause.body, s),
      );
      match h.return_clause { Some(r) -> globals_of(r.body, clauses), None -> clauses }
    },
    CodeFieldRead(f) -> globals_of(f.base, accumulator),
    CodeUpdate(u) ->
      u.sets.fold(globals_of(u.base, accumulator), |s: List<Global>, f: CodeField|
        globals_of(f.value, s)),
  }

pub fn set_of<a>(xs: List<a>) -> Map<a, Bool> =
  xs.fold(Map::new(), |m: Map<a, Bool>, x: a| m.insert(x, true))

fn canonical_declaration(declaration: Declaration) -> Declaration =
  {
    ..declaration,
    variants: declaration.variants.map(|variant: Variant|
      { ..variant, fields: variant.fields.map(canonical) }),
  }

pub fn context(claims: Claims, world: ProverInput) -> Context / {abort.raise} = {
  let declarations = world.declarations.map(canonical_declaration);
  let by_name = declarations.fold(
    Map::new(),
    |m: Map<String, Declaration>, declaration: Declaration| m.insert(declaration.name, declaration),
  );
  let constructors = declarations.fold(
    Map::new(),
    |m: Map<String, Constructor>, declaration: Declaration|
      declaration.variants.fold(m, |accumulator: Map<String, Constructor>, variant: Variant|
        accumulator.insert(variant.name, { declaration: declaration, variant: variant })),
  );
  let sums = set_of(
    declarations.filter(|declaration: Declaration|
      declaration.variants.len() > 0
        && (match claims.sums.get(declaration.name) {
          Some(n) -> n == declaration.variants.len(),
          None -> true,
        })).map(|declaration: Declaration| declaration.name),
  );
  let recursion = recursive_definitions(claims.definitions);
  let signatures = world.signatures.fold(Map::new(), |m: Map<String, Signature>, s: Signature|
    m.insert(s.name, { ..s, ty: shift_variables(canonical(s.ty)) }));
  let measures = measure_definitions(claims.definitions, signatures);
  {
    claims: { ..claims, definitions: claims.definitions.merge(measures.definitions) },
    declarations: by_name,
    constructors: constructors,
    signatures: signatures.merge(measures.signatures),
    recursive: recursion.recursive,
    self_recursive: recursion.self_recursive,
    groups: recursion.groups,
    measured: Map::new(),
    sums: sums,
    inhabited_sums: inhabited_sum_types(declarations, sums),
    keyed_types: {
      let stated = world.keys.map(|k: { type_name: String, by: String }| k.type_name).concat(
        world.numerics.map(|n: { type_name: String, functions: List<String> }| n.type_name),
      );
      if stated.len() == 0 { Map::new() } else { types_containing(declarations, set_of(stated)) }
    },
    compared_by_key: if world.keys.len() == 0 { Map::new() } else {
      types_containing(
        declarations,
        set_of(world.keys.map(|k: { type_name: String, by: String }| k.type_name)),
      )
    },
    keys: world.keys.fold(
      Map::new(),
      |m: Map<String, String>, k: { type_name: String, by: String }| m.insert(k.type_name, k.by),
    ),
    numerics: world.numerics.fold(
      Map::new(),
      |m: Map<String, List<String>>, n: { type_name: String, functions: List<String> }|
        m.insert(n.type_name, n.functions),
    ),
    builtins: world.builtins.fold(
      Map::new(),
      |m: Map<String, BuiltinSignature>, b: BuiltinSignature|
        m.insert(b.name, { ..b, ty: shift_variables(canonical(b.ty)) }),
    ),
    invariants: world.invariants.fold(
      Map::new(),
      |m: Map<String, String>, k: { type_name: String, by: String }| m.insert(k.type_name, k.by),
    ),
    operations: world.operations.fold(Map::new(), |m: Map<String, Option<Sort>>, o: Operation| {
      let key = o.effect ++ "." ++ o.operation;
      let results = shift_variables(canonical(o.results));
      match m.get(key) {
        None -> m.insert(key, Some(results)),
        Some(Some(t)) -> if t == results { m } else { m.insert(key, None) },
        Some(None) -> m,
      }
    }),
  }
}

pub fn operation_sort(context: Context, global: Bytes, operation: Bytes) -> Option<Sort> =
  match context.operations.get(
      String::of_bytes_lossy(global) ++ "." ++ String::of_bytes_lossy(operation),
    ) {
    Some(t) -> t,
    None -> None,
  }

pub fn contains_keyed_type(context: Context, ty: Sort) -> Bool =
  context.keyed_types.len() > 0 && contains_declared_type(ty, context.keyed_types, false)

pub fn may_call_key(context: Context, sort: Option<Sort>) -> Bool =
  context.compared_by_key.len() > 0
    && (match sort {
      Some(t) -> contains_declared_type(t, context.compared_by_key, true),
      None -> true,
    })

fn contains_declared_type(t: Sort, declared: Map<String, Bool>, open: Bool) -> Bool =
  match t {
    NamedSort(name, args) ->
      declared.contains(name) || args.any(|a: Sort| contains_declared_type(a, declared, open)),
    FunctionSort(params, return_type, _) ->
      params.any(|p: Sort| contains_declared_type(p, declared, open))
        || contains_declared_type(return_type, declared, open),
    RecordSort(fields) ->
      fields.any(|x: { name: String, ty: Sort }| contains_declared_type(x.ty, declared, open)),
    SortVariable(v) -> open && v >= external_variable_base,
  }

pub fn is_identity(context: Context, ty: Sort, identities: Map<Int, Bool>) -> Bool =
  supports_equality(context, ty, identities, false, [], 64)

pub fn is_reflexive(context: Context, ty: Sort, identities: Map<Int, Bool>) -> Bool =
  supports_equality(context, ty, identities, true, [], 64)

fn supports_equality(
  context: Context,
  ty: Sort,
  identities: Map<Int, Bool>,
  reflexive: Bool,
  seen: List<Sort>,
  depth_left: Int,
) -> Bool =
  if depth_left <= 0 { false } else {
    match ty {
      SortVariable(v) -> identities.contains(v),
      FunctionSort(_, _, _) -> false,
      RecordSort(fields) ->
        fields.fold(true, |ok: Bool, f: { name: String, ty: Sort }|
          ok && supports_equality(context, f.ty, identities, reflexive, seen, depth_left - 1)),
      NamedSort(name, args) -> if name == "Float" && args.len() == 0 { false }
      else if name == "Decimal" && args.len() == 0 { reflexive }
      else if seen.fold(false, |found: Bool, s: Sort| found || s == ty) { true } else {
        if context.keys.contains(name) { false } else {
          match context.declarations.get(name) {
            Some(declaration) ->
              declaration.variants.fold(true, |ok: Bool, variant: Variant|
                ok
                  && variant.fields.fold(true, |inner: Bool, f: Sort|
                    inner
                      && supports_equality(
                        context,
                        substituted(f, args),
                        identities,
                        reflexive,
                        seen.push(ty),
                        depth_left - 1,
                      ))),
            None ->
              args.fold(true, |ok: Bool, a: Sort|
                ok && supports_equality(context, a, identities, reflexive, seen, depth_left - 1)),
          }
        }
      },
    }
  }

pub fn constructor(context: Context, name: String) -> Option<Constructor> =
  context.constructors.get(name)

pub fn arity(c: Constructor) -> Int = c.variant.fields.len()

pub fn declaration_sort(declaration: Declaration) -> Sort =
  NamedSort(declaration.name, range(0, declaration.params).map(|p: Int| SortVariable(p)))

pub fn constructor_sort(c: Constructor) -> Sort =
  if c.variant.fields.len() == 0 { declaration_sort(c.declaration) }
  else { FunctionSort(c.variant.fields, declaration_sort(c.declaration), true) }

pub fn variants(context: Context, type_name: String) -> Option<Declaration> =
  if context.sums.contains(type_name) { context.declarations.get(type_name) } else { None }

pub fn signature(context: Context, name: String) -> Option<Signature> = context.signatures.get(name)

pub fn builtin(context: Context, name: String) -> Option<BuiltinSignature> =
  context.builtins.get(name)

pub fn inhabited(context: Context, ty: Sort) -> Bool =
  match ty {
    SortVariable(_) -> true,
    FunctionSort(_, return_type, _) -> inhabited(context, return_type),
    RecordSort(fields) ->
      fields.fold(true, |ok: Bool, f: { name: String, ty: Sort }| ok && inhabited(context, f.ty)),
    NamedSort(name, _) -> !context.sums.contains(name) || context.inhabited_sums.contains(name),
  }

pub fn is_pure(context: Context, name: String) -> Bool =
  match signature(context, name) { None -> false, Some(s) -> s.pure && s.effects_pure }

pub fn is_recursive(context: Context, name: String) -> Bool = context.recursive.contains(name)

pub fn unfoldable(context: Context, name: String) -> Option<Definition> =
  if context.recursive.contains(name) { None } else { pure_definition(context, name) }

pub fn recursive_body(context: Context, name: String) -> Option<Definition> =
  if context.recursive.contains(name) { pure_definition(context, name) } else { None }

pub fn self_recursive(context: Context, name: String) -> Option<Definition> =
  if context.self_recursive.contains(name) { pure_definition(context, name) } else { None }

fn pure_definition(context: Context, name: String) -> Option<Definition> =
  match signature(context, name) {
    None -> None,
    Some(s) -> if !s.pure { None } else {
      match context.claims.definitions.get(name) {
        Some(d) -> match d.body { Some(_) -> Some(d), None -> None },
        None -> None,
      }
    },
  }

fn types_containing(
  declarations: List<Declaration>,
  seeds: Map<String, Bool>,
) -> Map<String, Bool> / {abort.raise} =
  iterate(seeds, declarations.len() + 1, |found: Map<String, Bool>| {
    let grown = declarations.fold(
      found,
      |accumulator: Map<String, Bool>, declaration: Declaration|
        if accumulator.contains(declaration.name) { accumulator }
        else if declaration.variants.fold(false, |f: Bool, variant: Variant|
            f
              || variant.fields.fold(false, |g: Bool, ty: Sort|
                g || contains_declared_type(ty, found, false))) {
          accumulator.insert(declaration.name, true)
        } else { accumulator },
    );
    if grown.len() == found.len() { Stop(found) } else { Continue(grown) }
  })

fn inhabited_sum_types(
  declarations: List<Declaration>,
  sums: Map<String, Bool>,
) -> Map<String, Bool> / {abort.raise} =
  iterate(Map::new(), declarations.len() + 1, |found: Map<String, Bool>| {
    let grown = declarations.filter(|declaration: Declaration|
      sums.contains(declaration.name)).fold(
      found,
      |accumulator: Map<String, Bool>, declaration: Declaration|
        if accumulator.contains(declaration.name) { accumulator }
        else if declaration.variants.fold(false, |f: Bool, variant: Variant|
            f
              || variant.fields.fold(true, |ok: Bool, ty: Sort|
                ok && field_inhabited(ty, sums, found))) {
          accumulator.insert(declaration.name, true)
        } else { accumulator },
    );
    if grown.len() == found.len() { Stop(found) } else { Continue(grown) }
  })

fn field_inhabited(ty: Sort, sums: Map<String, Bool>, inhabited: Map<String, Bool>) -> Bool =
  match ty {
    SortVariable(_) -> true,
    FunctionSort(_, return_type, _) -> field_inhabited(return_type, sums, inhabited),
    RecordSort(fields) ->
      fields.fold(true, |ok: Bool, f: { name: String, ty: Sort }|
        ok && field_inhabited(f.ty, sums, inhabited)),
    NamedSort(name, _) -> if sums.contains(name) { inhabited.contains(name) } else { true },
  }

fn recursive_definitions(definitions: Map<String, Definition>) -> Recursion / {abort.raise} = {
  let names = definitions.keys();
  let index = range(0, names.len()).fold(Map::new(), |m: Map<String, Int>, i: Int|
    match names.at(i) { Some(n) -> m.insert(n, i), None -> m });
  let edges = names.map(|n: String|
    match definitions.get(n) {
      Some(d) ->
        d.refs.fold([], |accumulator: List<Int>, r: String|
          match index.get(r) {
            Some(i) -> if accumulator.fold(false, |f: Bool, x: Int| f || x == i) { accumulator }
            else { accumulator.push(i) },
            None -> accumulator,
          }),
      None -> [],
    });
  graph::components({ out: edges }).fold(
    { recursive: Map::new(), self_recursive: Map::new(), groups: Map::new() },
    |accumulator: Recursion, component: List<Int>| {
      let self_loop = match component {
        [v] -> match edges.at(v) {
          Some(es) -> es.fold(false, |f: Bool, w: Int| f || w == v),
          None -> false,
        },
        _ -> false,
      };
      let named = component.map(|v: Int| match names.at(v) { Some(n) -> n, None -> "" });
      let alone = if self_loop {
        named.fold(accumulator.self_recursive, |m: Map<String, Bool>, n: String| m.insert(n, true))
      } else { accumulator.self_recursive };
      let looping = component.len() > 1 || self_loop;
      let recursive = if looping {
        named.fold(accumulator.recursive, |m: Map<String, Bool>, n: String| m.insert(n, true))
      } else { accumulator.recursive };
      let groups = if looping {
        named.fold(accumulator.groups, |m: Map<String, List<String>>, n: String| m.insert(n, named))
      } else { accumulator.groups };
      { recursive: recursive, self_recursive: alone, groups: groups }
    },
  )
}

type Recursion = {
  recursive: Map<String, Bool>,
  self_recursive: Map<String, Bool>,
  groups: Map<String, List<String>>,
}

pub fn measure_name(definition: String) -> String = definition ++ " decreases"

fn measure_definitions(
  definitions: Map<String, Definition>,
  signatures: Map<String, Signature>,
) -> { definitions: Map<String, Definition>, signatures: Map<String, Signature> } =
  definitions.fold(
    { definitions: Map::new(), signatures: Map::new() },
    |accumulator: { definitions: Map<String, Definition>, signatures: Map<String, Signature> }, name: String, d: Definition|
      match d.measure {
        None -> accumulator,
        Some(m) -> match signatures.get(name) {
          Some(s) -> match s.ty {
            FunctionSort(params, _, _) ->
              {
                definitions: accumulator.definitions.insert(measure_name(name), {
                  params: d.params,
                  cost_parameters: [],
                  space_parameters: [],
                  body: Some(m),
                  spec: [],
                  measure: None,
                  refs: refs_of(m, []),
                  terminates: true,
                  stated: false,
                }),
                signatures: accumulator.signatures.insert(measure_name(name), {
                  name: measure_name(name),
                  ty: FunctionSort(params, NamedSort("Int", []), true),
                  pure: true,
                  effects_pure: true,
                  raises: false,
                  through: [],
                }),
              },
            _ -> accumulator,
          },
          None -> accumulator,
        },
      },
  )

pub fn group_of(context: Context, name: String) -> List<String> =
  match context.groups.get(name) { Some(g) -> g, None -> [name] }

pub fn terminates(context: Context, name: String) -> Bool =
  match context.claims.definitions.get(name) {
    Some(d) -> d.terminates || (d.stated && context.measured.contains(name)),
    None -> false,
  }
