//! `context` — the facts about a program the static prover reads, indexed once per run: each lowered
//! body and clause from `compiler.front.published.claims`, and the declared types and signatures of the world.

import compiler.emit.code (Code, CodeLiteral, CodeVar, NDef, NCtor, NBuiltin, CodeUnary, CodeBinary,
                           CodeApply, CodeKnownLambda, CodeIf, CodeBlock, CodeList, CodeRecord,
                           CodeMatch, CodePerform, CodeLabel, CodeLambda, CodeSimulate,
                           CodeParallel, CodeHandle, CodeFieldRead, CodeUpdate, CodeStmt, CodeLet,
                           CodeLetDestructure, CodeDo, CodeField, CodeArm, CodeClause, Node,
                           read_name, code_nodes_mapped)
import compiler.emit.moves (Moves, root_moves)
import compiler.emit.keys (Named)
import compiler.emit.lower.module_context (ModuleContext, ItemRoot, module_contexts_in)
import compiler.check.infer.definitions (Extern, parsed_natives)
import compiler.front.facts (Analysis)
import compiler.front.published (Claim, ClaimDef, ClaimSum, ClaimLaw, ClaimClause, LoweredClause,
                                 claims_in, rows_of, inferred_facts, prover_builtin,
                                 prover_modelled)
import compiler.syntax.items (FunctionItem)
import compiler.syntax.parsing (Span)
import domain (Sort, SortVariable, FunctionSort, RecordSort, NamedSort, Decl, Variant, substituted)
import sort (canonical, foreign, foreign_base)
import prover_input (BuiltinSignature, Operation, Signature, ProverInput)
import std.graph

/// A definition as the prover reads it: its body (`None` when the lowering did not take it), its
/// clauses, its `decreases` measure, and every global its body names, which is what its place in the
/// call graph is made of. `ends`: the checker saw every call it makes of its own group descend;
/// `stated`: it saw that only once the measures the group states are counted.
/// `cost_parameters`: the parameters with a cost name, in the order a `cost` clause binds those after the
/// parameters; `spaced`, those with a space name, as a `space` clause binds them.
pub type Def = {
  params: Int,
  cost_parameters: List<Int>,
  spaced: List<Int>,
  body: Option<Code>,
  spec: List<ClaimClause>,
  measure: Option<Code>,
  refs: List<String>,
  ends: Bool,
  stated: Bool,
}

pub type Law = { guard: Option<LoweredClause>, body: Code }

/// `read`: the program the claims were read from, where they were (`claims_read`).
pub type Claims = {
  defs: Map<String, Def>,
  laws: Map<String, Law>,
  sums: Map<String, Int>,
  read: Option<{ analysis: Analysis, mods: List<Int> }>,
  /// The definitions of modules the run does not answer for: another package's, whose own run
  /// proves their clauses.
  trusted: Map<String, Bool>,
}

/// A body as the build lowers it, each global it reads named program-wide, and which of its reads
/// hand their value on.
pub type BodyWithMoves = { body: Code, moves: Moves }

/// A constructor beside the type it builds.
pub type Ctor = { decl: Decl, variant: Variant }

pub type Context = {
  claims: Claims,
  decls: Map<String, Decl>,
  ctors: Map<String, Ctor>,
  signatures: Map<String, Signature>,
  recursive: Map<String, Bool>,
  /// A component of one definition calling itself: the shape induction unrolls.
  self_recursive: Map<String, Bool>,
  /// Each recursive definition's component.
  groups: Map<String, List<String>>,
  /// Definitions whose stated measures a proof showed descend, which end as surely as `ends` says.
  measured: Map<String, Bool>,
  /// The sum types a case split may range over.
  sums: Map<String, Bool>,
  inhabited: Map<String, Bool>,
  // Nominal types that state a `key` or a `numeric`, or whose declaration reaches one that does:
  // what a comparison or an operator calls unseen, which the cost reader reads.
  keyed_types: Map<String, Bool>,
  /// Nominal types that state a `key`, or whose declaration reaches one that does: those whose `==`
  /// calls a key.
  compared_by_key: Map<String, Bool>,
  /// Each type that states a `key`, by name, and the function its `==` reads through.
  keys: Map<String, String>,
  /// Each type that states a `numeric`, and its functions in `numeric_ops` order.
  numerics: Map<String, List<String>>,
  /// Each prelude `extern fn` by the name a call writes.
  builtins: Map<String, BuiltinSignature>,
  /// Each type that states an invariant, and its function: every value of the type satisfies it.
  invariants: Map<String, String>,
  /// By `<effect>.<operation>`, what a `perform` of it answers; none where two effects of that name
  /// answer apart.
  operations: Map<String, Option<Sort>>,
}

/// The claims `cs` indexed, no body read as the build lowers it.
pub fn claims_of(cs: List<Claim>) -> Claims =
  cs.fold(
    { defs: Map::new(), laws: Map::new(), sums: Map::new(), read: None, trusted: Map::new() },
    |acc: Claims, c: Claim|
      match c {
        ClaimDef(d) ->
          {
            ..acc,
            defs: acc.defs.insert(String::of_bytes_lossy(d.name), {
              params: d.params,
              cost_parameters: d.cost_parameters,
              spaced: d.spaced,
              body: d.body,
              spec: d.spec,
              measure: d.measure,
              refs: match d.body { Some(b) -> refs_of(b, []), None -> [] },
              ends: d.ends,
              stated: d.stated,
            }),
          },
        ClaimLaw(l) ->
          {
            ..acc,
            laws: acc.laws.insert(String::of_bytes_lossy(l.key), { guard: l.guard, body: l.body }),
          },
        ClaimSum(s) -> { ..acc, sums: acc.sums.insert(String::of_bytes_lossy(s.name), s.variants) },
      },
  )

/// The claims of the modules at `mods` of `analysis`, a module not `owned` opaque, read so that a
/// body's moves can be read off it as the build lowers it (`moved_bodies`).
pub fn claims_read(
  analysis: Analysis,
  mods: List<Int>,
  owned: (Bytes) -> Bool,
) -> Claims / {abort.raise} = {
  let read = claims_of(claims_in(analysis, mods, owned));
  let elsewhere = |name: String| !owned(module_of(name));
  {
    ..read,
    read: Some({ analysis: analysis, mods: mods }),
    trusted: read.defs.keys().fold(Map::new(), |m: Map<String, Bool>, n: String|
      if elsewhere(n) { m.insert(n, true) } else { m }),
  }
}

/// The module a definition or law's program-wide name is in: what comes before its last `.`.
pub fn module_of(name: String) -> Bytes / {abort.raise} = {
  let b = Bytes::of_string(name);
  let cut = range(0, b.len()).fold(0 - 1, |last: Int, i: Int|
    if b.slice(i, i + 1) == b"." { i } else { last });
  if cut < 0 { b"" } else { b.slice(0, cut) }
}

/// Each of `names` the claims hold a body of, as the build lowers it, or why the typed form does
/// not; none where the claims were not read off a program.
pub fn moved_bodies(
  claims: Claims,
  names: List<String>,
) -> Map<String, Result<BodyWithMoves, String>> / {abort.raise} =
  match claims.read {
    None -> Map::new(),
    Some(r) -> {
      let wanted = names.fold(Map::new(), |acc: Map<String, Bool>, name: String|
        match claims.defs.get(name) {
          Some(d) -> if d.body == None { acc } else { acc.insert(name, true) },
          None -> acc,
        });
      if wanted.len() == 0 { Map::new() } else { moved_bodies_in(r.analysis, r.mods, wanted) }
    },
  }

fn moved_bodies_in(
  analysis: Analysis,
  mods: List<Int>,
  wanted: Map<String, Bool>,
) -> Map<String, Result<BodyWithMoves, String>> / {abort.raise} = {
  let writes = |i: Int| {
    let prefix = analysis.mods.get(i).name.concat(b".");
    wanted.fold(false, |any: Bool, name: String, _: Bool| {
      let n = Bytes::of_string(name);
      any || (n.starts_with(prefix) && n.slice(prefix.len(), n.len()).index_of(b".") == None)
    })
  };
  let natives = parsed_natives(analysis.mods).map(|e: Extern| e.name);
  let modelled = prover_modelled();
  match module_contexts_in(
      analysis,
      rows_of(analysis),
      inferred_facts(analysis),
      analysis.mods,
      mods.filter(writes),
      |i: Int, setting: ModuleContext, roots: List<ItemRoot>| {
        let s = { ..setting, builtins: natives };
        roots.fold(
          [],
          |acc: List<{ name: String, moved: Result<BodyWithMoves, String> }>, r: ItemRoot|
            match ((r.item, r.root.key)) {
              (FunctionItem(_), Named(full)) -> {
                let name = String::of_bytes_lossy(full);
                if !wanted.contains(name) { acc } else {
                  acc.push({
                    name: name,
                    moved: Ok({
                      // The moves are the emitted code's; only the names of what it reads change.
                      body: code_nodes_mapped(r.root.code, |c: Code|
                        match c.node {
                          NDef(d) -> match prover_builtin(modelled, d.full) {
                            Some(b) ->
                              { ..c, node: NBuiltin({ name: b, args: d.args, rows: d.rows }) },
                            None -> c,
                          },
                          _ -> c,
                        }),
                      moves: root_moves(s, r.root),
                    }),
                  })
                }
              },
              _ -> acc,
            },
        )
      },
    ) {
    Err(why) ->
      wanted.fold(
        Map::new(),
        |acc: Map<String, Result<BodyWithMoves, String>>, name: String, _: Bool|
          acc.insert(
            name,
            Err("the program's facts are not read: " ++ String::of_bytes_lossy(why)),
          ),
      ),
    Ok(found) ->
      found.fold(
        Map::new(),
        |acc: Map<String, Result<BodyWithMoves, String>>, rows: List<{ name: String, moved: Result<BodyWithMoves, String> }>|
          rows.fold(
            acc,
            |a: Map<String, Result<BodyWithMoves, String>>, row: { name: String, moved: Result<BodyWithMoves, String> }|
              a.insert(row.name, row.moved),
          ),
      ),
  }
}

/// Every global a body names, even under an effect the prover treats as opaque.
pub fn refs_of(c: Code, acc: List<String>) -> List<String> =
  globals_of(c, []).fold(acc, |s: List<String>, g: Global| s.push(g.name))

/// A global a body names, and where.
pub type Global = { name: String, at: Span }

fn named_global(c: Code, acc: List<Global>) -> List<Global> =
  match read_name(c) {
    Some(n) -> acc.push({ name: String::of_bytes_lossy(n), at: c.span }),
    None -> acc,
  }

/// Every global a body names and where, in the order it is written, even under an effect the prover
/// treats as opaque.
pub fn globals_of(c: Code, acc: List<Global>) -> List<Global> =
  match c.node {
    CodeVar(_) -> acc,
    NDef(_) -> named_global(c, acc),
    NCtor(_) -> named_global(c, acc),
    NBuiltin(_) -> named_global(c, acc),
    CodeLiteral(_) -> acc,
    CodeLabel(_) -> acc,
    CodeUnary(u) -> globals_of(u.operand, acc),
    CodeBinary(b) -> globals_of(b.rhs, globals_of(b.lhs, acc)),
    CodeApply(a) ->
      a.args.fold(globals_of(a.func, acc), |s: List<Global>, x: Code| globals_of(x, s)),
    CodeKnownLambda(_) -> acc,
    CodeIf(i) -> globals_of(i.else_branch, globals_of(i.then_branch, globals_of(i.cond, acc))),
    CodeBlock(b) -> {
      let stmts = b.stmts.fold(acc, |s: List<Global>, st: CodeStmt|
        match st {
          CodeLet(l) -> globals_of(l.value, s),
          CodeLetDestructure(l) -> globals_of(l.value, s),
          CodeDo(d) -> globals_of(d.code, s),
        });
      match b.tail { Some(t) -> globals_of(t, stmts), None -> stmts }
    },
    CodeList(l) -> l.items.fold(acc, |s: List<Global>, x: Code| globals_of(x, s)),
    CodeRecord(r) -> r.fields.fold(acc, |s: List<Global>, f: CodeField| globals_of(f.value, s)),
    CodeMatch(m) ->
      m.arms.fold(globals_of(m.scrutinee, acc), |s: List<Global>, a: CodeArm|
        globals_of(a.body, match a.guard { Some(g) -> globals_of(g, s), None -> s })),
    CodePerform(p) -> p.args.fold(acc, |s: List<Global>, x: Code| globals_of(x, s)),
    CodeLambda(l) -> globals_of(l.body, acc),
    CodeSimulate(s) -> globals_of(s.body, acc),
    CodeParallel(pr) -> pr.branches.fold(acc, |s: List<Global>, x: Code| globals_of(x, s)),
    CodeHandle(h) -> {
      let clauses = h.clauses.fold(globals_of(h.body, acc), |s: List<Global>, cl: CodeClause|
        globals_of(cl.body, s));
      match h.ret { Some(r) -> globals_of(r.body, clauses), None -> clauses }
    },
    CodeFieldRead(f) -> globals_of(f.base, acc),
    CodeUpdate(u) ->
      u.sets.fold(globals_of(u.base, acc), |s: List<Global>, f: CodeField| globals_of(f.value, s)),
  }

pub fn set_of<a>(xs: List<a>) -> Map<a, Bool> =
  xs.fold(Map::new(), |m: Map<a, Bool>, x: a| m.insert(x, true))

fn canonical_decl(decl: Decl) -> Decl =
  {
    ..decl,
    variants: decl.variants.map(|variant: Variant|
      { ..variant, fields: variant.fields.map(canonical) }),
  }

pub fn context(claims: Claims, world: ProverInput) -> Context / {abort.raise} = {
  let decls = world.decls.map(canonical_decl);
  let by_name = decls.fold(Map::new(), |m: Map<String, Decl>, decl: Decl|
    m.insert(decl.name, decl));
  let ctors = decls.fold(Map::new(), |m: Map<String, Ctor>, decl: Decl|
    decl.variants.fold(m, |acc: Map<String, Ctor>, variant: Variant|
      acc.insert(variant.name, { decl: decl, variant: variant })));
  // A split over a partial list is unsound, so a type the lowered claims count otherwise is never
  // split on; aliases and builtins have no constructors, so they are not sums at all.
  let sums = set_of(
    decls.filter(|decl: Decl|
      decl.variants.len() > 0
        && (match claims.sums.get(decl.name) {
          Some(n) -> n == decl.variants.len(),
          None -> true,
        })).map(|decl: Decl| decl.name),
  );
  let rec = recursive_definitions(claims.defs);
  let signatures = world.signatures.fold(Map::new(), |m: Map<String, Signature>, s: Signature|
    m.insert(s.name, { ..s, ty: foreign(canonical(s.ty)) }));
  let measures = measure_defs(claims.defs, signatures);
  {
    claims: { ..claims, defs: claims.defs.merge(measures.defs) },
    decls: by_name,
    ctors: ctors,
    signatures: signatures.merge(measures.signatures),
    recursive: rec.recursive,
    self_recursive: rec.alone,
    groups: rec.groups,
    measured: Map::new(),
    sums: sums,
    inhabited: inhabited_sum_types(decls, sums),
    keyed_types: {
      let stated = world.keys.map(|k: { type_name: String, by: String }| k.type_name).concat(
        world.numerics.map(|n: { type_name: String, fns: List<String> }| n.type_name),
      );
      if stated.len() == 0 { Map::new() } else { reaching_types(decls, set_of(stated)) }
    },
    compared_by_key: if world.keys.len() == 0 { Map::new() } else {
      reaching_types(
        decls,
        set_of(world.keys.map(|k: { type_name: String, by: String }| k.type_name)),
      )
    },
    keys: world.keys.fold(
      Map::new(),
      |m: Map<String, String>, k: { type_name: String, by: String }| m.insert(k.type_name, k.by),
    ),
    numerics: world.numerics.fold(
      Map::new(),
      |m: Map<String, List<String>>, n: { type_name: String, fns: List<String> }|
        m.insert(n.type_name, n.fns),
    ),
    builtins: world.builtins.fold(
      Map::new(),
      |m: Map<String, BuiltinSignature>, b: BuiltinSignature|
        m.insert(b.name, { ..b, ty: foreign(canonical(b.ty)) }),
    ),
    invariants: world.invariants.fold(
      Map::new(),
      |m: Map<String, String>, k: { type_name: String, by: String }| m.insert(k.type_name, k.by),
    ),
    operations: world.operations.fold(Map::new(), |m: Map<String, Option<Sort>>, o: Operation| {
      let key = o.effect ++ "." ++ o.op;
      let answers = foreign(canonical(o.results));
      match m.get(key) {
        None -> m.insert(key, Some(answers)),
        Some(Some(t)) -> if t == answers { m } else { m.insert(key, None) },
        Some(None) -> m,
      }
    }),
  }
}

/// What a `perform` of `op` of the effect named `global` across the program answers, where that is
/// known.
pub fn operation_sort(cx: Context, global: Bytes, op: Bytes) -> Option<Sort> =
  match cx.operations.get(String::of_bytes_lossy(global) ++ "." ++ String::of_bytes_lossy(op)) {
    Some(t) -> t,
    None -> None,
  }

/// Whether a value of `ty` holds one of a type that states a `key` or a `numeric`, whose `==` or
/// whose operators call a function no body shows.
pub fn reaches_key(cx: Context, ty: Sort) -> Bool =
  cx.keyed_types.len() > 0 && reaches(ty, cx.keyed_types, false)

/// Whether `==` at `sort` may call a key, which may end the run: the sort holds a type that states
/// one, or a variable the prover never settled, or is not known, where any type states one.
pub fn may_call_key(cx: Context, sort: Option<Sort>) -> Bool =
  cx.compared_by_key.len() > 0
    && (match sort { Some(t) -> reaches(t, cx.compared_by_key, true), None -> true })

/// `open`: a variable numbered past `foreign_base()`, which the prover never settled, may be any type.
fn reaches(t: Sort, declared: Map<String, Bool>, open: Bool) -> Bool =
  match t {
    NamedSort(name, args) ->
      declared.contains(name) || args.any(|a: Sort| reaches(a, declared, open)),
    FunctionSort(params, ret, _) ->
      params.any(|p: Sort| reaches(p, declared, open)) || reaches(ret, declared, open),
    RecordSort(fields) -> fields.any(|x: { name: String, ty: Sort }| reaches(x.ty, declared, open)),
    SortVariable(v) -> open && v >= foreign_base(),
  }

/// Whether `==` at `ty` is identity: two values are `==` exactly when they are one value, which is
/// what congruence reads. Not at `Float` (`NaN`), `Decimal` (`1.5m == 1.50m`), a type that states a
/// `key`, a function, or a variable no `identity` constraint is on (`identities`); a recursive type
/// is identity where its other parts are.
pub fn is_identity(cx: Context, ty: Sort, identities: Map<Int, Bool>) -> Bool =
  equality_holds(cx, ty, identities, false, [], 64)

/// Whether a value is `==` to itself at `ty`, wherever it is compared: at no type that may hold a
/// `Float`, or a variable no `identity` constraint is on, and at no type that states a `key`, whose
/// function may end the run where it overflows.
pub fn is_reflexive(cx: Context, ty: Sort, identities: Map<Int, Bool>) -> Bool =
  equality_holds(cx, ty, identities, true, [], 64)

/// `reflexive`: the weaker question. `seen` holds the types being walked, which hold where the rest
/// does; a type nested past `depth_left` declarations is answered no.
fn equality_holds(
  cx: Context,
  ty: Sort,
  identities: Map<Int, Bool>,
  reflexive: Bool,
  seen: List<Sort>,
  depth_left: Int,
) -> Bool =
  if depth_left <= 0 { false } else {
    match ty {
      SortVariable(v) -> identities.contains(v),
      FunctionSort(_, _, _) -> false,
      RecordSort(fields) ->
        fields.fold(true, |ok: Bool, f: { name: String, ty: Sort }|
          ok && equality_holds(cx, f.ty, identities, reflexive, seen, depth_left - 1)),
      NamedSort(name, args) -> if name == "Float" && args.len() == 0 { false }
      else if name == "Decimal" && args.len() == 0 { reflexive }
      else if seen.fold(false, |found: Bool, s: Sort| found || s == ty) { true } else {
        if cx.keys.contains(name) { false } else {
          match cx.decls.get(name) {
            Some(decl) ->
              decl.variants.fold(true, |ok: Bool, variant: Variant|
                ok
                  && variant.fields.fold(true, |inner: Bool, f: Sort|
                    inner
                      && equality_holds(
                        cx,
                        substituted(f, args),
                        identities,
                        reflexive,
                        seen.push(ty),
                        depth_left - 1,
                      ))),
            None ->
              args.fold(true, |ok: Bool, a: Sort|
                ok && equality_holds(cx, a, identities, reflexive, seen, depth_left - 1)),
          }
        }
      },
    }
  }

pub fn ctor(cx: Context, name: String) -> Option<Ctor> = cx.ctors.get(name)

pub fn arity(c: Ctor) -> Int = c.variant.fields.len()

/// The type over its own parameters.
pub fn decl_sort(decl: Decl) -> Sort =
  NamedSort(decl.name, range(0, decl.params).map(|p: Int| SortVariable(p)))

/// As a value: the type it builds, or a pure function to it from its fields.
pub fn ctor_sort(c: Ctor) -> Sort =
  if c.variant.fields.len() == 0 { decl_sort(c.decl) }
  else { FunctionSort(c.variant.fields, decl_sort(c.decl), true) }

/// `None` unless every constructor is in hand: a split over a partial list is unsound.
pub fn variants(cx: Context, type_name: String) -> Option<Decl> =
  if cx.sums.contains(type_name) { cx.decls.get(type_name) } else { None }

pub fn signature(cx: Context, name: String) -> Option<Signature> = cx.signatures.get(name)

pub fn builtin(cx: Context, name: String) -> Option<BuiltinSignature> = cx.builtins.get(name)

pub fn inhabited(cx: Context, ty: Sort) -> Bool =
  match ty {
    SortVariable(_) -> true,
    FunctionSort(_, ret, _) -> inhabited(cx, ret),
    RecordSort(fields) ->
      fields.fold(true, |ok: Bool, f: { name: String, ty: Sort }| ok && inhabited(cx, f.ty)),
    NamedSort(name, _) -> !cx.sums.contains(name) || cx.inhabited.contains(name),
  }

/// Whether equal calls must answer equally, so they may share one term.
pub fn is_pure(cx: Context, name: String) -> Bool =
  match signature(cx, name) { None -> false, Some(s) -> s.pure && s.row_pure }

pub fn is_recursive(cx: Context, name: String) -> Bool = cx.recursive.contains(name)

/// Not in a recursive component, with an empty footprint, and with a body the lowering reached.
pub fn unfoldable(cx: Context, name: String) -> Option<Def> =
  if cx.recursive.contains(name) { None } else { reached_pure(cx, name) }

/// In a recursive component, with an empty footprint, and with a body the lowering reached: what a
/// call over values in view runs.
pub fn recursive_body(cx: Context, name: String) -> Option<Def> =
  if cx.recursive.contains(name) { reached_pure(cx, name) } else { None }

/// Calling only itself, with an empty footprint, and with a body the lowering reached: what induction
/// may unroll once it has shown the recursion decreases.
pub fn self_recursive(cx: Context, name: String) -> Option<Def> =
  if cx.self_recursive.contains(name) { reached_pure(cx, name) } else { None }

fn reached_pure(cx: Context, name: String) -> Option<Def> =
  match signature(cx, name) {
    None -> None,
    Some(s) -> if !s.pure { None } else {
      match cx.claims.defs.get(name) {
        Some(d) -> match d.body { Some(_) -> Some(d), None -> None },
        None -> None,
      }
    },
  }

/// The types that reach `seeds`, those included. A least fixed point, so chains of declarations and
/// recursive ones both settle.
fn reaching_types(
  decls: List<Decl>,
  seeds: Map<String, Bool>,
) -> Map<String, Bool> / {abort.raise} =
  iterate(seeds, decls.len() + 1, |found: Map<String, Bool>| {
    let grown = decls.fold(found, |acc: Map<String, Bool>, decl: Decl|
      if acc.contains(decl.name) { acc }
      else if decl.variants.fold(false, |f: Bool, variant: Variant|
          f || variant.fields.fold(false, |g: Bool, ty: Sort| g || reaches(ty, found, false))) {
        acc.insert(decl.name, true)
      } else { acc });
    if grown.len() == found.len() { Stop(found) } else { Continue(grown) }
  })

/// Least fixed point: a type is inhabited once every field of some constructor is.
fn inhabited_sum_types(
  decls: List<Decl>,
  sums: Map<String, Bool>,
) -> Map<String, Bool> / {abort.raise} =
  iterate(Map::new(), decls.len() + 1, |found: Map<String, Bool>| {
    let grown = decls.filter(|decl: Decl| sums.contains(decl.name)).fold(
      found,
      |acc: Map<String, Bool>, decl: Decl|
        if acc.contains(decl.name) { acc }
        else if decl.variants.fold(false, |f: Bool, variant: Variant|
            f
              || variant.fields.fold(true, |ok: Bool, ty: Sort|
                ok && field_inhabited(ty, sums, found))) { acc.insert(decl.name, true) }
        else { acc },
    );
    if grown.len() == found.len() { Stop(found) } else { Continue(grown) }
  })

fn field_inhabited(ty: Sort, sums: Map<String, Bool>, inhabited: Map<String, Bool>) -> Bool =
  match ty {
    SortVariable(_) -> true,
    FunctionSort(_, ret, _) -> field_inhabited(ret, sums, inhabited),
    RecordSort(fields) ->
      fields.fold(true, |ok: Bool, f: { name: String, ty: Sort }|
        ok && field_inhabited(f.ty, sums, inhabited)),
    NamedSort(name, _) -> if sums.contains(name) { inhabited.contains(name) } else { true },
  }

/// Definitions in a call-graph cycle, and among them the ones whose cycle is only themselves.
fn recursive_definitions(defs: Map<String, Def>) -> Recursion / {abort.raise} = {
  let names = defs.keys();
  let index = range(0, names.len()).fold(Map::new(), |m: Map<String, Int>, i: Int|
    match names.at(i) { Some(n) -> m.insert(n, i), None -> m });
  let edges = names.map(|n: String|
    match defs.get(n) {
      Some(d) ->
        d.refs.fold([], |acc: List<Int>, r: String|
          match index.get(r) {
            Some(i) -> if acc.fold(false, |f: Bool, x: Int| f || x == i) { acc }
            else { acc.push(i) },
            None -> acc,
          }),
      None -> [],
    });
  graph::components({ out: edges }).fold(
    { recursive: Map::new(), alone: Map::new(), groups: Map::new() },
    |acc: Recursion, component: List<Int>| {
      let self_loop = match component {
        [v] -> match edges.at(v) {
          Some(es) -> es.fold(false, |f: Bool, w: Int| f || w == v),
          None -> false,
        },
        _ -> false,
      };
      let named = component.map(|v: Int| match names.at(v) { Some(n) -> n, None -> "" });
      let alone = if self_loop {
        named.fold(acc.alone, |m: Map<String, Bool>, n: String| m.insert(n, true))
      } else { acc.alone };
      let looping = component.len() > 1 || self_loop;
      let recursive = if looping {
        named.fold(acc.recursive, |m: Map<String, Bool>, n: String| m.insert(n, true))
      } else { acc.recursive };
      let groups = if looping {
        named.fold(acc.groups, |m: Map<String, List<String>>, n: String| m.insert(n, named))
      } else { acc.groups };
      { recursive: recursive, alone: alone, groups: groups }
    },
  )
}

type Recursion = {
  recursive: Map<String, Bool>,
  alone: Map<String, Bool>,
  groups: Map<String, List<String>>,
}

/// The name a definition's measure goes by as a definition of its own parameters.
pub fn measure_name(def: String) -> String = def ++ " decreases"

/// Each measure as a definition the lowering unfolds, so a measure at a call's arguments is a call.
fn measure_defs(
  defs: Map<String, Def>,
  signatures: Map<String, Signature>,
) -> { defs: Map<String, Def>, signatures: Map<String, Signature> } =
  defs.fold(
    { defs: Map::new(), signatures: Map::new() },
    |acc: { defs: Map<String, Def>, signatures: Map<String, Signature> }, name: String, d: Def|
      match d.measure {
        None -> acc,
        Some(m) -> match signatures.get(name) {
          Some(s) -> match s.ty {
            FunctionSort(params, _, _) ->
              {
                defs: acc.defs.insert(measure_name(name), {
                  params: d.params,
                  cost_parameters: [],
                  spaced: [],
                  body: Some(m),
                  spec: [],
                  measure: None,
                  refs: refs_of(m, []),
                  ends: true,
                  stated: false,
                }),
                signatures: acc.signatures.insert(measure_name(name), {
                  name: measure_name(name),
                  ty: FunctionSort(params, NamedSort("Int", []), true),
                  pure: true,
                  row_pure: true,
                  raises: false,
                  through: [],
                }),
              },
            _ -> acc,
          },
          None -> acc,
        },
      },
  )

pub fn group_of(cx: Context, name: String) -> List<String> =
  match cx.groups.get(name) { Some(g) -> g, None -> [name] }

/// Whether a definition's calls are known to end: the checker saw them, or a proof showed the measures
/// it read them by descend.
pub fn terminates(cx: Context, name: String) -> Bool =
  match cx.claims.defs.get(name) {
    Some(d) -> d.ends || (d.stated && cx.measured.contains(name)),
    None -> false,
  }
