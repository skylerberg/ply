//! `context` — the facts about a program the static prover reads, indexed once per run: each lowered
//! body and clause from `compiler.front.published.claims`, and the declared types and signatures of the world.

import compiler.emit.code (Code, NLit, NVar, NUnary, NBinary, NApp, NKnown, NIf, NBlock, NList,
                           NRecord, NMatch, NPerform, NLabel, NLambda, NSimulate, NParallel,
                           NHandle, NField, NUpdate, CodeStmt, CLet, CLetPat, CDo, CodeField,
                           CodeArm, CodeClause)
import compiler.emit.moves (Moves, root_moves)
import compiler.emit.lower.setting (Setting, ItemRoot, settings_in)
import compiler.unit (parsed_natives)
import compiler.check.infer.definitions (Extern)
import compiler.front.facts (Analysis)
import compiler.front.published (Claim, ClaimDef, ClaimSum, ClaimLaw, ClaimClause, Lowered,
                                 claims_in, named, rows_of, walked_facts)
import compiler.syntax.items (IFn)
import domain (Ty, Var, Fn, Record, Con, Decl, Variant)
import sort (canonical, is_pure_fn)
import world (Signature, World)
import std.graph

/// A definition as the prover reads it: its body (`None` when the lowering did not take it), its
/// clauses, its `decreases` measure, and every global its body names, which is what its place in the
/// call graph is made of. `ends`: the checker saw every call it makes of its own group descend;
/// `stated`: it saw that only once the measures the group states are counted.
/// `costed`: the parameters with a cost name, in the order a `cost` clause binds those after the
/// parameters; `spaced`, those with a space name, as a `space` clause binds them.
pub type Def = {
  params: Int,
  costed: List<Int>,
  spaced: List<Int>,
  body: Option<Code>,
  spec: List<ClaimClause>,
  measure: Option<Code>,
  refs: List<String>,
  ends: Bool,
  stated: Bool,
}

pub type Law = { guard: Option<Lowered>, body: Option<Code> }

/// `read`: the program the claims were read from, where they were (`claims_read`).
pub type Claims = {
  defs: Map<String, Def>,
  laws: Map<String, Law>,
  sums: Map<String, Int>,
  read: Option<{ analysis: Analysis, mods: List<Int> }>,
}

/// A body as the build lowers it, each global it reads named program-wide, and which of its reads
/// hand their value on.
pub type Moved = { body: Code, moves: Moves }

/// A constructor beside the type it builds.
pub type Ctor = { decl: Decl, variant: Variant }

pub type Context = {
  claims: Claims,
  decls: Map<String, Decl>,
  ctors: Map<String, Ctor>,
  signatures: Map<String, Signature>,
  recursive: Map<String, Bool>,
  /// A component of one definition calling itself: the shape induction unrolls.
  self_recursive: Map<String, Bool>,
  /// Each recursive definition's component.
  groups: Map<String, List<String>>,
  /// Definitions whose stated measures a proof showed descend, which end as surely as `ends` says.
  measured: Map<String, Bool>,
  /// The sum types a case split may range over.
  sums: Map<String, Bool>,
  inhabited: Map<String, Bool>,
  /// Nominal types whose declaration reaches a `Float`.
  float_types: Map<String, Bool>,
  // Nominal types that state a `key`, or whose declaration reaches one that does.
  keyed_types: Map<String, Bool>,
}

/// The claims `cs` indexed, no body read as the build lowers it.
pub fn claims_of(cs: List<Claim>) -> Claims =
  cs.fold(
    { defs: Map::new(), laws: Map::new(), sums: Map::new(), read: None },
    |acc: Claims, c: Claim|
      match c {
        ClaimDef(d) ->
          {
            ..acc,
            defs: acc.defs.insert(String::of_bytes_lossy(d.name), {
              params: d.params,
              costed: d.costed,
              spaced: d.spaced,
              body: d.body,
              spec: d.spec,
              measure: d.measure,
              refs: match d.body { Some(b) -> refs_of(b, []), None -> [] },
              ends: d.ends,
              stated: d.stated,
            }),
          },
        ClaimLaw(l) ->
          {
            ..acc,
            laws: acc.laws.insert(String::of_bytes_lossy(l.key), { guard: l.guard, body: l.body }),
          },
        ClaimSum(s) -> { ..acc, sums: acc.sums.insert(String::of_bytes_lossy(s.name), s.variants) },
      },
  )

/// The claims of the modules at `mods` of `analysis`, a module not `owned` opaque, read so that a
/// body's moves can be read off it as the build lowers it (`moved_of`).
pub fn claims_read(
  analysis: Analysis,
  mods: List<Int>,
  owned: (Bytes) -> Bool,
) -> Claims / {abort.raise} =
  { ..claims_of(claims_in(analysis, mods, owned)), read: Some({ analysis: analysis, mods: mods }) }

/// Each of `names` the claims hold a body of, as the build lowers it, or why the typed form does
/// not; none where the claims were not read off a program.
pub fn moved_of(
  claims: Claims,
  names: List<String>,
) -> Map<String, Result<Moved, String>> / {abort.raise} =
  match claims.read {
    None -> Map::new(),
    Some(r) -> {
      let wanted = names.fold(Map::new(), |acc: Map<String, Bool>, name: String|
        match claims.defs.get(name) {
          Some(d) -> if d.body == None { acc } else { acc.insert(name, true) },
          None -> acc,
        });
      if wanted.len() == 0 { Map::new() } else { moved_in(r.analysis, r.mods, wanted) }
    },
  }

fn moved_in(
  analysis: Analysis,
  mods: List<Int>,
  wanted: Map<String, Bool>,
) -> Map<String, Result<Moved, String>> / {abort.raise} = {
  let writes = |i: Int| {
    let prefix = analysis.mods.get(i).name.concat(b".");
    wanted.fold(false, |any: Bool, name: String, _: Bool| {
      let n = Bytes::of_string(name);
      any || (n.starts_with(prefix) && n.slice(prefix.len(), n.len()).index_of(b".") == None)
    })
  };
  let natives = parsed_natives(analysis.mods).map(|e: Extern| e.name);
  match settings_in(
      analysis,
      rows_of(analysis),
      walked_facts(analysis),
      analysis.mods,
      mods.filter(writes),
      |i: Int, setting: Setting, roots: List<ItemRoot>| {
        let s = { ..setting, builtins: natives };
        roots.fold([], |acc: List<{ name: String, moved: Result<Moved, String> }>, r: ItemRoot|
          match r.item {
            IFn(_) -> {
              let name = String::of_bytes_lossy(r.root.full);
              if !wanted.contains(name) { acc } else {
                acc.push({
                  name: name,
                  moved: match r.root.code {
                    None -> Err("`" ++ name ++ "` has a body the build does not lower"),
                    Some(code) -> match root_moves(s, r.root, code) {
                      Ok(m) -> Ok({ body: named(analysis.r, i, code), moves: m }),
                      Err(no) ->
                        Err(
                          "`" ++ name ++ "` has a body the typed form does not lower: "
                            ++ String::of_bytes_lossy(no.why),
                        ),
                    },
                  },
                })
              }
            },
            _ -> acc,
          })
      },
    ) {
    Err(why) ->
      wanted.fold(Map::new(), |acc: Map<String, Result<Moved, String>>, name: String, _: Bool|
        acc.insert(name, Err("the program's facts are not read: " ++ String::of_bytes_lossy(why)))),
    Ok(found) ->
      found.fold(
        Map::new(),
        |acc: Map<String, Result<Moved, String>>, rows: List<{ name: String, moved: Result<Moved, String> }>|
          rows.fold(
            acc,
            |a: Map<String, Result<Moved, String>>, row: { name: String, moved: Result<Moved, String> }|
              a.insert(row.name, row.moved),
          ),
      ),
  }
}

/// Every global a body names, even under an effect the prover treats as opaque.
pub fn refs_of(c: Code, acc: List<String>) -> List<String> =
  match c.node {
    NVar(v) -> match v.slot { Some(_) -> acc, None -> acc.push(String::of_bytes_lossy(v.name)) },
    NLit(_) -> acc,
    NLabel(_) -> acc,
    NUnary(u) -> refs_of(u.operand, acc),
    NBinary(b) -> refs_of(b.rhs, refs_of(b.lhs, acc)),
    NApp(a) -> a.args.fold(refs_of(a.func, acc), |s: List<String>, x: Code| refs_of(x, s)),
    NKnown(_) -> acc,
    NIf(i) -> refs_of(i.else_branch, refs_of(i.then_branch, refs_of(i.cond, acc))),
    NBlock(b) -> {
      let stmts = b.stmts.fold(acc, |s: List<String>, st: CodeStmt|
        match st {
          CLet(l) -> refs_of(l.value, s),
          CLetPat(l) -> refs_of(l.value, s),
          CDo(d) -> refs_of(d.code, s),
        });
      match b.tail { Some(t) -> refs_of(t, stmts), None -> stmts }
    },
    NList(l) -> l.items.fold(acc, |s: List<String>, x: Code| refs_of(x, s)),
    NRecord(r) -> r.fields.fold(acc, |s: List<String>, f: CodeField| refs_of(f.value, s)),
    NMatch(m) ->
      m.arms.fold(refs_of(m.scrutinee, acc), |s: List<String>, a: CodeArm|
        refs_of(a.body, match a.guard { Some(g) -> refs_of(g, s), None -> s })),
    NPerform(p) -> p.args.fold(acc, |s: List<String>, x: Code| refs_of(x, s)),
    NLambda(l) -> refs_of(l.body, acc),
    NSimulate(s) -> refs_of(s.body, acc),
    NParallel(pr) -> pr.branches.fold(acc, |s: List<String>, x: Code| refs_of(x, s)),
    NHandle(h) -> {
      let clauses = h.clauses.fold(refs_of(h.body, acc), |s: List<String>, cl: CodeClause|
        refs_of(cl.body, s));
      match h.ret { Some(r) -> refs_of(r.body, clauses), None -> clauses }
    },
    NField(f) -> refs_of(f.base, acc),
    NUpdate(u) ->
      u.sets.fold(refs_of(u.base, acc), |s: List<String>, f: CodeField| refs_of(f.value, s)),
  }

pub fn set_of(names: List<String>) -> Map<String, Bool> =
  names.fold(Map::new(), |m: Map<String, Bool>, n: String| m.insert(n, true))

fn canonical_decl(decl: Decl) -> Decl =
  {
    ..decl,
    variants: decl.variants.map(|variant: Variant|
      { ..variant, fields: variant.fields.map(canonical) }),
  }

pub fn context(claims: Claims, world: World) -> Context / {abort.raise} = {
  let decls = world.decls.map(canonical_decl);
  let by_name = decls.fold(Map::new(), |m: Map<String, Decl>, decl: Decl|
    m.insert(decl.name, decl));
  let ctors = decls.fold(Map::new(), |m: Map<String, Ctor>, decl: Decl|
    decl.variants.fold(m, |acc: Map<String, Ctor>, variant: Variant|
      acc.insert(variant.name, { decl: decl, variant: variant })));
  // A split over a partial list is unsound, so a type the lowered claims count otherwise is never
  // split on; aliases and builtins have no constructors, so they are not sums at all.
  let sums = set_of(
    decls.filter(|decl: Decl|
      decl.variants.len() > 0
        && (match claims.sums.get(decl.name) {
          Some(n) -> n == decl.variants.len(),
          None -> true,
        })).map(|decl: Decl| decl.name),
  );
  let rec = recursive_definitions(claims.defs);
  let signatures = world.signatures.fold(Map::new(), |m: Map<String, Signature>, s: Signature|
    m.insert(s.name, { ..s, ty: canonical(s.ty) }));
  let measures = measure_defs(claims.defs, signatures);
  {
    claims: { ..claims, defs: claims.defs.merge(measures.defs) },
    decls: by_name,
    ctors: ctors,
    signatures: signatures.merge(measures.signatures),
    recursive: rec.recursive,
    self_recursive: rec.alone,
    groups: rec.groups,
    measured: Map::new(),
    sums: sums,
    inhabited: inhabited_sum_types(decls, sums),
    float_types: reaching_types(decls, Map::new(), true),
    keyed_types: if world.keyed.len() == 0 { Map::new() }
    else { reaching_types(decls, set_of(world.keyed), false) },
  }
}

/// Through its arguments, its fields, or its own declaration.
pub fn reaches_float(cx: Context, ty: Ty) -> Bool = reaches(ty, cx.float_types, true)

/// Whether a value of `ty` holds one of a type that states a `key` or a `numeric`, whose `==` or
/// whose operators are not what its constructors and fields say.
pub fn reaches_key(cx: Context, ty: Ty) -> Bool =
  cx.keyed_types.len() > 0 && reaches(ty, cx.keyed_types, false)

/// `float` counts `Float` itself as reached.
fn reaches(t: Ty, declared: Map<String, Bool>, float: Bool) -> Bool =
  match t {
    Con(name, args) ->
      (float && name == "Float" && args.len() == 0) || declared.contains(name)
        || args.fold(false, |f: Bool, a: Ty| f || reaches(a, declared, float)),
    Fn(params, ret, _) ->
      params.fold(false, |f: Bool, p: Ty| f || reaches(p, declared, float))
        || reaches(ret, declared, float),
    Record(fields) ->
      fields.fold(false, |f: Bool, x: { name: String, ty: Ty }|
        f || reaches(x.ty, declared, float)),
    Var(_) -> false,
  }

pub fn ctor(cx: Context, name: String) -> Option<Ctor> = cx.ctors.get(name)

pub fn arity(c: Ctor) -> Int = c.variant.fields.len()

/// The type over its own parameters.
pub fn decl_sort(decl: Decl) -> Ty = Con(decl.name, range(0, decl.params).map(|p: Int| Var(p)))

/// As a value: the type it builds, or a pure function to it from its fields.
pub fn ctor_sort(c: Ctor) -> Ty =
  if c.variant.fields.len() == 0 { decl_sort(c.decl) }
  else { Fn(c.variant.fields, decl_sort(c.decl), true) }

/// `None` unless every constructor is in hand: a split over a partial list is unsound.
pub fn variants(cx: Context, type_name: String) -> Option<Decl> =
  if cx.sums.contains(type_name) { cx.decls.get(type_name) } else { None }

pub fn signature(cx: Context, name: String) -> Option<Signature> = cx.signatures.get(name)

pub fn inhabited(cx: Context, ty: Ty) -> Bool =
  match ty {
    Var(_) -> true,
    Fn(_, ret, _) -> inhabited(cx, ret),
    Record(fields) ->
      fields.fold(true, |ok: Bool, f: { name: String, ty: Ty }| ok && inhabited(cx, f.ty)),
    Con(name, _) -> !cx.sums.contains(name) || cx.inhabited.contains(name),
  }

/// Whether equal calls must answer equally, so they may share one term.
pub fn is_pure(cx: Context, name: String) -> Bool =
  match signature(cx, name) {
    None -> false,
    Some(s) -> s.pure && (match s.ty { Fn(_, _, pure) -> pure, _ -> true }),
  }

pub fn is_recursive(cx: Context, name: String) -> Bool = cx.recursive.contains(name)

/// Not in a recursive component, with an empty footprint, and with a body the lowering reached.
pub fn unfoldable(cx: Context, name: String) -> Option<Def> =
  if cx.recursive.contains(name) { None } else { reached_pure(cx, name) }

/// Calling only itself, with an empty footprint, and with a body the lowering reached: what induction
/// may unroll once it has shown the recursion decreases.
pub fn self_recursive(cx: Context, name: String) -> Option<Def> =
  if cx.self_recursive.contains(name) { reached_pure(cx, name) } else { None }

fn reached_pure(cx: Context, name: String) -> Option<Def> =
  match signature(cx, name) {
    None -> None,
    Some(s) -> if !s.pure { None } else {
      match cx.claims.defs.get(name) {
        Some(d) -> match d.body { Some(_) -> Some(d), None -> None },
        None -> None,
      }
    },
  }

/// The types that reach `seeds`, those included, and `Float` when `float`. A least fixed point, so
/// chains of declarations and recursive ones both settle.
fn reaching_types(
  decls: List<Decl>,
  seeds: Map<String, Bool>,
  float: Bool,
) -> Map<String, Bool> / {abort.raise} =
  iterate(seeds, decls.len() + 1, |found: Map<String, Bool>| {
    let grown = decls.fold(found, |acc: Map<String, Bool>, decl: Decl|
      if acc.contains(decl.name) { acc }
      else if decl.variants.fold(false, |f: Bool, variant: Variant|
          f || variant.fields.fold(false, |g: Bool, ty: Ty| g || reaches(ty, found, float))) {
        acc.insert(decl.name, true)
      } else { acc });
    if grown.len() == found.len() { Stop(found) } else { Continue(grown) }
  })

/// Least fixed point: a type is inhabited once every field of some constructor is.
fn inhabited_sum_types(
  decls: List<Decl>,
  sums: Map<String, Bool>,
) -> Map<String, Bool> / {abort.raise} =
  iterate(Map::new(), decls.len() + 1, |found: Map<String, Bool>| {
    let grown = decls.filter(|decl: Decl| sums.contains(decl.name)).fold(
      found,
      |acc: Map<String, Bool>, decl: Decl|
        if acc.contains(decl.name) { acc }
        else if decl.variants.fold(false, |f: Bool, variant: Variant|
            f
              || variant.fields.fold(true, |ok: Bool, ty: Ty|
                ok && field_inhabited(ty, sums, found))) { acc.insert(decl.name, true) }
        else { acc },
    );
    if grown.len() == found.len() { Stop(found) } else { Continue(grown) }
  })

fn field_inhabited(ty: Ty, sums: Map<String, Bool>, inhabited: Map<String, Bool>) -> Bool =
  match ty {
    Var(_) -> true,
    Fn(_, ret, _) -> field_inhabited(ret, sums, inhabited),
    Record(fields) ->
      fields.fold(true, |ok: Bool, f: { name: String, ty: Ty }|
        ok && field_inhabited(f.ty, sums, inhabited)),
    Con(name, _) -> if sums.contains(name) { inhabited.contains(name) } else { true },
  }

/// Definitions in a call-graph cycle, and among them the ones whose cycle is only themselves.
fn recursive_definitions(defs: Map<String, Def>) -> Recursion / {abort.raise} = {
  let names = defs.keys();
  let index = range(0, names.len()).fold(Map::new(), |m: Map<String, Int>, i: Int|
    match names.at(i) { Some(n) -> m.insert(n, i), None -> m });
  let edges = names.map(|n: String|
    match defs.get(n) {
      Some(d) ->
        d.refs.fold([], |acc: List<Int>, r: String|
          match index.get(r) {
            Some(i) -> if acc.fold(false, |f: Bool, x: Int| f || x == i) { acc }
            else { acc.push(i) },
            None -> acc,
          }),
      None -> [],
    });
  graph::components({ out: edges }).fold(
    { recursive: Map::new(), alone: Map::new(), groups: Map::new() },
    |acc: Recursion, component: List<Int>| {
      let self_loop = match component {
        [v] -> match edges.at(v) {
          Some(es) -> es.fold(false, |f: Bool, w: Int| f || w == v),
          None -> false,
        },
        _ -> false,
      };
      let named = component.map(|v: Int| match names.at(v) { Some(n) -> n, None -> "" });
      let alone = if self_loop {
        named.fold(acc.alone, |m: Map<String, Bool>, n: String| m.insert(n, true))
      } else { acc.alone };
      let looping = component.len() > 1 || self_loop;
      let recursive = if looping {
        named.fold(acc.recursive, |m: Map<String, Bool>, n: String| m.insert(n, true))
      } else { acc.recursive };
      let groups = if looping {
        named.fold(acc.groups, |m: Map<String, List<String>>, n: String| m.insert(n, named))
      } else { acc.groups };
      { recursive: recursive, alone: alone, groups: groups }
    },
  )
}

type Recursion = {
  recursive: Map<String, Bool>,
  alone: Map<String, Bool>,
  groups: Map<String, List<String>>,
}

/// The name a definition's measure goes by as a definition of its own parameters.
pub fn measure_name(def: String) -> String = def ++ " decreases"

/// Each measure as a definition the lowering unfolds, so a measure at a call's arguments is a call.
fn measure_defs(
  defs: Map<String, Def>,
  signatures: Map<String, Signature>,
) -> { defs: Map<String, Def>, signatures: Map<String, Signature> } =
  defs.fold(
    { defs: Map::new(), signatures: Map::new() },
    |acc: { defs: Map<String, Def>, signatures: Map<String, Signature> }, name: String, d: Def|
      match d.measure {
        None -> acc,
        Some(m) -> match signatures.get(name) {
          Some(s) -> match s.ty {
            Fn(params, _, _) ->
              {
                defs: acc.defs.insert(measure_name(name), {
                  params: d.params,
                  costed: [],
                  spaced: [],
                  body: Some(m),
                  spec: [],
                  measure: None,
                  refs: refs_of(m, []),
                  ends: true,
                  stated: false,
                }),
                signatures: acc.signatures.insert(measure_name(name), {
                  name: measure_name(name),
                  ty: Fn(params, Con("Int", []), true),
                  pure: true,
                }),
              },
            _ -> acc,
          },
          None -> acc,
        },
      },
  )

pub fn group_of(cx: Context, name: String) -> List<String> =
  match cx.groups.get(name) { Some(g) -> g, None -> [name] }

/// Whether a definition's calls are known to end: the checker saw them, or a proof showed the measures
/// it read them by descend.
pub fn ends(cx: Context, name: String) -> Bool =
  match cx.claims.defs.get(name) {
    Some(d) -> d.ends || (d.stated && cx.measured.contains(name)),
    None -> false,
  }
