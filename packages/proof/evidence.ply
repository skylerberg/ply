//! `evidence` — a proof as the store files it, encoded with `bin`. An entry is believed only when its
//! proof established its guard.

import std.bin
import obligation (Certificate, certificate_bin)
import rules (Rule, CaseSplit, Cited, Congruence, Descent, ExhaustiveEnumeration,
              ExhaustiveInterleaving, GroundEvaluation, Induction, Injectivity, LinearArithmetic,
              Propositional, Spine, Unfold)

pub fn evidence_bytes(c: Certificate) -> Bytes / {abort.raise} = bin::encode(c, certificate_bin())

/// What a store entry says, when it is a proof a discharge could have filed.
pub fn evidence_of(b: Bytes) -> Result<Certificate, String> / {abort.raise} =
  match bin::decode(b, certificate_bin()) {
    Err(e) -> Err(bin::error_to_string(e)),
    Ok(c) -> if c.guard_satisfiable { Ok(c) }
    else { Err("a proof that did not establish its guard") },
  }

// --- Tests ------------------------------------------------------------------

fn a_certificate() -> Certificate =
  {
    rules: [
      GroundEvaluation,
      ExhaustiveEnumeration({ domain: "Bool", points: 2 }),
      CaseSplit({ ty: "m.Shape", arms: 3 }),
      Unfold({ definition: "m.f", depth: 2 }),
      Induction({ binder: "n", scheme: Descent(1), definition: "m.f" }),
      Induction({ binder: "xs", scheme: Spine(1), definition: "m.g" }),
      Cited({ law: "m.a law", label: "a law" }),
      ExhaustiveInterleaving(12),
      LinearArithmetic,
      Propositional,
      Congruence,
      Injectivity,
    ],
    steps: 41,
    guard_satisfiable: true,
    sorts: ["a"],
    ran: true,
  }

test "a proof reads back as it was filed, every rule included" {
  assert_eq(evidence_of(evidence_bytes(a_certificate())), Ok(a_certificate()));
  let read_off = { ..a_certificate(), ran: false };
  assert_eq(evidence_of(evidence_bytes(read_off)), Ok(read_off))
}

test "an entry is believed only where its proof established its guard" {
  let vacuous = evidence_bytes({ ..a_certificate(), guard_satisfiable: false });
  assert_eq(evidence_of(vacuous), Err("a proof that did not establish its guard"));
  assert(evidence_of(b"not evidence") != Ok(a_certificate()))
}
