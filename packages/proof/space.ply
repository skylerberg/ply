//! The memory a call holds beyond what it is handed, read off its body as monomials over its
//! parameters' sizes, each up to a constant factor: every object it makes, though it let some go
//! before it returns, and a frame for each call back into itself that is not a tail call. A number
//! is no object. A body is read with each argument held by nothing else, all the way down, as an
//! update in place needs: an update of a value something else holds copies it, and a constructor
//! built after a `match` let go of a subject held once takes the subject's cells, as compiled code
//! does.

import compiler.emit.code (Code, CodeLiteral, CodeVar, NDefinition, NConstructor, NBuiltin,
                           CodeUnary, CodeBinary, CodeApply, CodeKnownLambda, CodeIf, CodeBlock,
                           CodeList, CodeRecord, CodeMatch, CodePerform, CodeLabel, CodeLambda,
                           CodeSimulate, CodeParallel, CodeHandle, CodeFieldRead, CodeUpdate,
                           CodeStatement, CodeLet, CodeLetDestructure, CodeDo, CodeField, CodeArm,
                           CodePattern, CodeBindingPattern, CodeConstructorPattern,
                           CodeRecordPattern, CodeListPattern, CodePatternField, Capture)
import compiler.emit.moves (Moves, read_moved, capture_moved)
import compiler.front.published (ClaimClause)
import compiler.check.infer.checker (Builtin)
import compiler.syntax.items (SpaceClause)
import compiler.syntax.patterns (SourceLiteral, LiteralInt, LiteralString, LiteralBytes,
                                 LiteralEmbedded)
import compiler.check.types (Type, NamedType, FunctionType, RecordType)
import compiler.check.callbacks (CallbackUse, CallbackArgument, Accumulator, ExtractedFrom, Number,
                                 Mapped, Filtered, Folded, Updated, UnknownReturn)
import context (Context, Definition, BodyWithMoves, ctor, signature, is_recursive, moved_bodies)
import cost (Polynomial, ParameterRelation, Same, Part, Other, IndexBound, OnTail, OnIndex, zero,
             constant, size_of, plus, product, at_args, ceiling_of, callees, reachable,
             params_sized, arithmetic, holding_keyed, descent, descent_calls, growth_preserved,
             is_length, stated_cost, context_owning, index_bound_of, takes_some, toward, assumed,
             possible, literal_size, calls_made, iterating_of, by_entry, natives, name_key,
             dominated_space)
import domain (Sort, FunctionSort, NamedSort, RecordSort)
import std.list

/// Who else holds a value: `Unshared`, nothing, nor anything it holds; `UnsharedTop`, nothing, though what it
/// holds may be held elsewhere; `Shared`, something.
type Sharing = | Unshared | UnsharedTop | Shared

/// A local as `cost` reads one, the space one call of it takes where it is a function, who else
/// holds it, and whether it is a number, which nothing holds.
type Slot = {
  size: Option<Polynomial>,
  of: ParameterRelation,
  fun: Option<Polynomial>,
  holders: Sharing,
  number: Bool,
}

/// Where a path stands: each local, and the constructor a `match` let go of, whose cells the next
/// one built of it takes.
type State = { slots: List<Slot>, reusable_constructor: Option<Bytes> }

/// What walking an expression finds: the state after it; the space it holds on any path, and on
/// the paths that call back into the definition being read; what it is, as a local is; the local it
/// reads, where that local goes on holding it; how many calls back one path makes, and the
/// arguments of each; and for each parameter, numbers aside, that one of those hands a value held by
/// more than itself alone, the most a call back's value is held by.
type SpaceSummary = {
  state: State,
  space: Polynomial,
  looped: Polynomial,
  size: Option<Polynomial>,
  of: ParameterRelation,
  fun: Option<Polynomial>,
  holders: Sharing,
  number: Bool,
  read: Option<Int>,
  calls: Int,
  back: List<List<ParameterRelation>>,
  shared: Map<Int, Sharing>,
}

/// A definition's space and who else holds what it answers, read with each argument held alone and
/// with each held anywhere.
type KnownSpace = { alone: Result<SpaceUse, String>, anyhow: Result<SpaceUse, String> }

type SpaceUse = { space: Polynomial, holders: Sharing }

/// What a builtin answers: a number, an `Option` of one, or any other value.
type ResultKind = | NumberResult | OptionNumberResult | ValueResult

/// `own` is the definition being read, `moves` which of its body's reads hand their value on, and
/// `numbers` which of its parameters are numbers; `known`, what it calls; `answers`, what each builtin
/// answers; `lambda`, whether the walk is inside a function value, whose code is read letting no
/// subject go; `tail`, whether nothing in the frame follows the expression; `empty`, a list parameter
/// known empty; `found`, where `List::at` answered `Some` on the path; `missed`, where it answers
/// `None`.
type Env = {
  context: Context,
  own: String,
  moves: Moves,
  numbers: List<Bool>,
  known: Map<String, KnownSpace>,
  results: Map<String, ResultKind>,
  lambda: Bool,
  tail: Bool,
  empty: Option<Int>,
  found: List<IndexBound>,
  missed: Option<IndexBound>,
}

/// The bound a `space` clause states over `params` parameters and the space names of `spaced`'s,
/// read from below as a `cost` bound is, where `0` is no space that grows with what a call is given.
pub fn stated_space(bound: Code, params: Int, spaced: List<Int>) -> Option<Polynomial> =
  match bound.node {
    CodeLiteral(l) -> match l {
      LiteralInt(k) -> if k == 0 { Some(zero()) } else { stated_cost(bound, params, spaced) },
      _ -> None,
    },
    _ -> stated_cost(bound, params, spaced),
  }

/// The bound on the space a call of `definition` holds, over its parameters' sizes, with each argument held
/// alone; what it reaches is read first, as `steps` reads it.
pub fn space(context: Context, definition: String) -> Result<Polynomial, String> / {abort.raise} = {
  let answers = builtin_result_kinds();
  let reach = reachable(context, definition);
  let moved = moved_bodies(context.claims, reach);
  let known = iterate(Map::new(), reach.len() + 1, |known: Map<String, KnownSpace>| {
    let ready = reach.filter(|n: String|
      !known.contains(n)
        && callees(context, n).fold(true, |all: Bool, c: String|
          all && (c == n || known.contains(c))));
    if ready.len() == 0 { Stop(known) } else {
      Continue(
        ready.fold(known, |k: Map<String, KnownSpace>, n: String|
          k.insert(n, known_of(context, answers, moved, n, k))),
      )
    }
  });
  match holding_keyed(context, reach) {
    Some(n) ->
      Err(
        "`" ++ n
          ++ "` holds a value compared by its type's `key`, which a comparison calls and no body shows",
      ),
    None -> match known.get(definition) {
      Some(k) -> match space_use_for(k, true) { Ok(s) -> Ok(s.space), Err(why) -> Err(why) },
      None -> Err("`" ++ definition ++ "` reaches definitions that call each other"),
    },
  }
}

/// What a definition holds for arguments held alone, which what it holds for any also bounds.
fn space_use_for(k: KnownSpace, once: Bool) -> Result<SpaceUse, String> =
  if !once { k.anyhow } else {
    match k.alone {
      Ok(s) -> Ok(s),
      Err(why) -> match k.anyhow { Ok(s) -> Ok(s), Err(_) -> Err(why) },
    }
  }

/// What `definition` holds, its body read as the build lowers it where `moved` holds it, else by its
/// contract.
fn known_of(
  context: Context,
  answers: Map<String, ResultKind>,
  moved: Map<String, Result<BodyWithMoves, String>>,
  definition: String,
  known: Map<String, KnownSpace>,
) -> KnownSpace / {abort.raise} =
  match context.claims.definitions.get(definition) {
    None -> {
      let why = "`" ++ definition ++ "` has no body here to read";
      { alone: Err(why), anyhow: Err(why) }
    },
    Some(d) -> match moved.get(definition) {
      None ->
        {
          alone: promised(definition, d),
          anyhow: Err(
            "`" ++ definition
              ++ "` is handed a value something else holds, and its `space` bound is for arguments held alone",
          ),
        },
      Some(Err(why)) -> { alone: Err(why), anyhow: Err(why) },
      Some(Ok(m)) -> {
        let read = |many: List<Int>|
          body_space(
            context,
            answers,
            definition,
            d,
            m,
            known,
            many.fold(Map::new(), |m: Map<Int, Sharing>, i: Int| m.insert(i, Shared)),
          );
        { alone: read([]), anyhow: read(range(0, d.params)) }
      },
    },
  }

/// A definition read by its contract, as another package's is: its first `space` bound read from
/// above.
fn promised(definition: String, d: Definition) -> Result<SpaceUse, String> =
  match d.spec.filter(|c: ClaimClause| c.kind == SpaceClause).fold(
      None,
      |found: Option<Polynomial>, c: ClaimClause|
        match found { Some(_) -> found, None -> ceiling_of(c.clause.code, d.params, d.spaced) },
    ) {
    Some(p) -> Ok({ space: p, holders: Shared }),
    None ->
      Err(
        "`" ++ definition
          ++ "` has no body here to read, and no `space` bound to read as its space",
      ),
  }

/// The space a call of `definition` holds, each parameter held alone but those `entry` says are held by
/// more, a call of a function parameter with a space name holding what that name stands for. A
/// recursion whose paths that call back hold nothing more, and call back last, holds what the path
/// that ends does, with no parameter it grows with grown on the way; any other is read as `steps`
/// reads one.
fn body_space(
  context: Context,
  answers: Map<String, ResultKind>,
  definition: String,
  d: Definition,
  moved: BodyWithMoves,
  known: Map<String, KnownSpace>,
  entry: Map<Int, Sharing>,
) -> Result<SpaceUse, String> / {abort.raise} = {
  let body = moved.body;
  let params = d.params;
  let sized = params_sized(context, definition, params);
  let numbers = numbers_of(context, definition, params);
  let env = {
    context: context,
    own: definition,
    moves: moved.moves,
    numbers: numbers,
    known: known,
    results: answers,
    lambda: false,
    tail: true,
    empty: None,
    found: [],
    missed: None,
  };
  let entered = |shared: Map<Int, Sharing>|
    {
      slots: range(0, params).map(|i: Int| {
        let number = at_or(numbers, i);
        {
          size: if at_or(sized, i) { Some(size_of(i)) } else { None },
          of: Same(i),
          fun: if d.spaced.contains(i) { Some([Map::new().insert(name_key(i), 1)]) } else { None },
          holders: if number { Unshared }
          else { match shared.get(i) { Some(h) -> h, None -> Unshared } },
          number: number,
        }
      }),
      reusable_constructor: None,
    };
  // A parameter a call back hands a value held by more than itself alone is held so on the calls
  // after the first, so it is read so, until no call back hands one by more.
  let read = iterate(
    { shared: entry, walked: walk(env, entered(entry), body) },
    2 * params + 2,
    |r: { shared: Map<Int, Sharing>, walked: Result<SpaceSummary, String> }|
      match r.walked {
        Err(_) -> Stop(r),
        Ok(w) -> {
          let more = joined(r.shared, w.shared);
          if more == r.shared { Stop(r) }
          else { Continue({ shared: more, walked: walk(env, entered(more), body) }) }
        },
      },
  );
  let start = entered(read.shared);
  match read.walked {
    Err(why) -> Err(why),
    Ok(w) -> if !is_recursive(context, definition) { Ok({ space: w.space, holders: w.holders }) }
    else if !context.self_recursive.contains(definition) {
      Err("`" ++ definition ++ "` is in a group with others")
    } else if w.looped == zero() {
      if growth_preserved(w.space, w.back) { Ok({ space: w.space, holders: w.holders }) }
      else { Err("`" ++ definition ++ "` hands on a parameter its space grows with, changed") }
    } else {
      match descent(definition, w.calls, w.back, w.space, "space grows") {
        Err(why) -> Err(why),
        Ok(None) -> Ok({ space: w.space, holders: w.holders }),
        // As `steps` reads it: a call enters with no element of that list left at most once.
        Ok(Some(d)) -> match match d {
            OnTail(p) ->
              walk(
                { ..env, empty: Some(p) },
                { ..start, slots: start.slots.set(p, { ..slot_at(start, p), size: Some(zero()) }) },
                body,
              ),
            OnIndex(f) -> walk({ ..env, missed: Some(f) }, start, body),
          } {
          Err(why) -> Err(why),
          Ok(e) -> match product(descent_calls(d), w.space) {
            Ok(chain) ->
              Ok({ space: plus(chain, e.space), holders: more_shared(w.holders, e.holders) }),
            Err(why) -> Err(why),
          },
        },
      }
    },
  }
}

// --- Holders and states -------------------------------------------------------------------------

fn more_shared(a: Sharing, b: Sharing) -> Sharing =
  if a == Shared || b == Shared { Shared }
  else if a == UnsharedTop || b == UnsharedTop { UnsharedTop }
  else { Unshared }

/// A value made of `parts` is held alone where each part is, and else is held once at its top.
fn sharing_of_parts(parts: List<Sharing>) -> Sharing =
  if parts.fold(true, |all: Bool, h: Sharing| all && h == Unshared) { Unshared }
  else { UnsharedTop }

/// Who else holds what a walk found, a number being held by nothing.
fn sharing_of(w: SpaceSummary) -> Sharing = if w.number { Unshared } else { w.holders }

fn is_unshared(w: SpaceSummary) -> Bool = sharing_of(w) == Unshared

fn unknown_slot() -> Slot = { size: None, of: Other, fun: None, holders: Shared, number: false }

fn slot_at(st: State, k: Int) -> Slot =
  match st.slots.at(k) { Some(s) -> s, None -> unknown_slot() }

fn slot_of(w: SpaceSummary) -> Slot =
  { size: w.size, of: w.of, fun: w.fun, holders: w.holders, number: w.number }

fn bind(st: State, k: Int, s: Slot) -> State / {abort.raise} = {
  let grown = if st.slots.len() <= k {
    range(st.slots.len(), k + 1).fold(st.slots, |acc: List<Slot>, _i: Int| acc.push(unknown_slot()))
  } else { st.slots };
  { ..st, slots: grown.set(k, s) }
}

/// The state once the local a value was read from goes on holding it beside whatever took it as
/// `to` says: `Shared` where the value is held whole, `UnsharedTop` where only parts of it are.
fn retain(st: State, read: Option<Int>, to: Sharing) -> State =
  match read {
    None -> st,
    Some(k) -> match st.slots.at(k) {
      Some(s) -> if s.number { st }
      else { { ..st, slots: st.slots.set(k, { ..s, holders: more_shared(s.holders, to) }) } },
      None -> st,
    },
  }

/// Where two paths meet: each local held as the weaker path holds it, and a constructor's cells left
/// over only where both left them.
fn merged(a: State, b: State) -> State =
  {
    slots: range(0, max(a.slots.len(), b.slots.len())).map(|i: Int|
      match ((a.slots.at(i), b.slots.at(i))) {
        (Some(x), Some(y)) -> { ..x, holders: more_shared(x.holders, y.holders) },
        (Some(x), None) -> x,
        (None, Some(y)) -> y,
        _ -> unknown_slot(),
      }),
    reusable_constructor: if a.reusable_constructor == b.reusable_constructor {
      a.reusable_constructor
    } else { None },
  }

fn none(st: State) -> SpaceSummary =
  {
    state: st,
    space: zero(),
    looped: zero(),
    size: None,
    of: Other,
    fun: None,
    holders: Unshared,
    number: false,
    read: None,
    calls: 0,
    back: [],
    shared: Map::new(),
  }

/// Each parameter held by the most either holds it by.
fn joined(a: Map<Int, Sharing>, b: Map<Int, Sharing>) -> Map<Int, Sharing> =
  b.fold(a, |acc: Map<Int, Sharing>, i: Int, h: Sharing|
    acc.insert(i, match acc.get(i) { Some(g) -> more_shared(g, h), None -> h }))

/// `w`, then an object of `p` words made.
fn allocated(w: SpaceSummary, p: Polynomial) -> SpaceSummary =
  { ..w, space: plus(w.space, p), looped: if w.calls > 0 { plus(w.looped, p) } else { w.looped } }

/// `a`, then `b`: a path that calls back through either holds what the other holds too.
fn then(a: SpaceSummary, b: SpaceSummary) -> SpaceSummary =
  {
    state: b.state,
    space: plus(a.space, b.space),
    looped: plus(if a.calls > 0 { plus(a.looped, b.space) } else { zero() }, if b.calls > 0 {
      plus(a.space, b.looped)
    } else { zero() }),
    size: b.size,
    of: b.of,
    fun: b.fun,
    holders: b.holders,
    number: b.number,
    read: b.read,
    calls: a.calls + b.calls,
    back: a.back.concat(b.back),
    shared: joined(a.shared, b.shared),
  }

/// Either branch.
fn either(a: SpaceSummary, b: SpaceSummary) -> SpaceSummary =
  {
    state: merged(a.state, b.state),
    space: plus(a.space, b.space),
    looped: plus(a.looped, b.looped),
    size: match ((a.size, b.size)) { (Some(x), Some(y)) -> Some(plus(x, y)), _ -> None },
    of: Other,
    fun: match ((a.fun, b.fun)) { (Some(x), Some(y)) -> Some(plus(x, y)), _ -> None },
    holders: more_shared(sharing_of(a), sharing_of(b)),
    number: a.number && b.number,
    read: None,
    calls: max(a.calls, b.calls),
    back: a.back.concat(b.back),
    shared: joined(a.shared, b.shared),
  }

/// A value of `w`'s walk, with nothing of what it is beyond who holds it.
fn as_value(w: SpaceSummary, holders: Sharing, number: Bool) -> SpaceSummary =
  { ..w, size: None, of: Other, fun: None, holders: holders, number: number, read: None }

// --- The walk -----------------------------------------------------------------------------------

fn walk(env: Env, st: State, c: Code) -> Result<SpaceSummary, String> / {abort.raise} =
  match c.node {
    CodeLiteral(l) -> Ok(literal(st, l)),
    CodeVar(v) -> {
      let s = slot_at(st, v.slot);
      let moved = read_moved(env.moves, c.span) || s.number;
      Ok({
        ..none(st),
        size: s.size,
        of: s.of,
        fun: s.fun,
        number: s.number,
        holders: if moved { s.holders } else { Shared },
        read: if moved { None } else { Some(v.slot) },
      })
    },
    NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) ->
      Ok({ ..none(st), fun: fun_named(env, String::of_bytes_lossy(fname)), holders: Shared }),
    CodeLabel(_) -> Ok(none(st)),
    CodeUnary(u) -> match walk({ ..env, tail: false }, st, u.operand) {
      Err(why) -> Err(why),
      Ok(w) -> Ok({ ..w, of: Other, fun: None, holders: Unshared, number: true, read: None }),
    },
    CodeBinary(b) -> binary(env, st, b.op, b.lhs, b.rhs),
    CodeIf(i) -> match walk({ ..env, tail: false }, st, i.cond) {
      Err(why) -> Err(why),
      Ok(cond) -> {
        let slots = |k: Int| slot_at(st, k).of;
        let branch = |truth: Bool, c: Code| {
          let holds = assumed(slots, i.cond, truth);
          if possible(holds, env.missed) {
            Some(walk({ ..env, found: env.found.concat(holds) }, cond.state, c))
          } else { None }
        };
        match ((branch(true, i.then_branch), branch(false, i.else_branch))) {
          (Some(Err(why)), _) -> Err(why),
          (_, Some(Err(why))) -> Err(why),
          (Some(Ok(t)), Some(Ok(e))) -> Ok(then(cond, either(t, e))),
          (Some(Ok(t)), None) -> Ok(then(cond, t)),
          (None, Some(Ok(e))) -> Ok(then(cond, e)),
          (None, None) -> Ok(cond),
        }
      },
    },
    CodeBlock(b) -> block(env, st, b.statements, b.tail),
    CodeList(l) -> match walk_all(env, st, l.items, |_i: Int| Some(Shared)) {
      Err(why) -> Err(why),
      Ok(a) ->
        Ok({
          ..as_value(allocated(a.walked, constant()), sharing_of_parts(a.all.map(sharing_of)), false),
          size: Some(constant()),
        }),
    },
    CodeRecord(r) -> match walk_all(env, st, r.fields.map(|f: CodeField| f.value), |_i: Int|
        Some(Shared)) {
      Err(why) -> Err(why),
      Ok(a) ->
        Ok(
          as_value(allocated(a.walked, constant()), sharing_of_parts(a.all.map(sharing_of)), false),
        ),
    },
    CodeFieldRead(f) -> match walk({ ..env, tail: false }, st, f.base) {
      Err(why) -> Err(why),
      Ok(w) -> Ok(as_value({ ..w, state: retain(w.state, w.read, UnsharedTop) }, Shared, false)),
    },
    // The written fields are read before the base, as compiled code reads them.
    CodeUpdate(u) -> match walk_all(env, st, u.sets.map(|f: CodeField| f.value), |_i: Int|
        Some(Shared)) {
      Err(why) -> Err(why),
      Ok(a) -> match walk({ ..env, tail: false }, a.walked.state, u.base) {
        Err(why) -> Err(why),
        Ok(b) -> {
          let base = { ..b, state: retain(b.state, b.read, UnsharedTop) };
          Ok(
            as_value(
              allocated(then(a.walked, base), constant()),
              sharing_of_parts(a.all.map(sharing_of).push(sharing_of(b))),
              false,
            ),
          )
        },
      },
    },
    CodeMatch(m) -> match walk({ ..env, tail: false }, st, m.scrutinee) {
      Err(why) -> Err(why),
      Ok(s) -> {
        let subject = { ..s, state: retain(s.state, s.read, UnsharedTop) };
        let at = index_bound_of(|k: Int| slot_at(st, k).of, m.scrutinee);
        match arms(env, subject, m.scrutinee, at, m.arms) {
          Err(why) -> Err(why),
          Ok(a) -> Ok(then(subject, a)),
        }
      },
    },
    CodeApply(a) -> application(env, st, a.function, a.args),
    CodeKnownLambda(_) -> panic("only the emitter writes a read as a known lambda"),
    // A raise ends the call; any other operation runs a handler the bound does not read.
    CodePerform(p) -> if p.effect != b"abort" {
      Err("an operation whose handler the bound does not read")
    } else {
      match walk_all(env, st, p.args, |_i: Int| Some(Shared)) {
        Err(why) -> Err(why),
        Ok(a) -> Ok(as_value(allocated(a.walked, constant()), Shared, false)),
      }
    },
    CodeLambda(l) -> {
      let caught = l.captures.fold(st, |s: State, cap: Capture|
        if capture_moved(env.moves, l.at, cap.src) { s } else { retain(s, Some(cap.src), Shared) });
      let fun = match lambda_walk(
          env,
          st,
          l.params,
          l.captures,
          l.body,
          range(0, l.params).map(|_i: Int| unknown_slot()),
        ) {
        Ok(w) -> if w.calls > 0 { None } else { Some(w.space) },
        Err(_) -> None,
      };
      Ok({ ..allocated(none(caught), constant()), fun: fun, holders: UnsharedTop })
    },
    CodeSimulate(_) -> Err("a `simulate` region the bound does not read"),
    CodeParallel(_) -> Err("a `parallel` block the bound does not read"),
    CodeHandle(_) -> Err("a handler the bound does not read"),
  }

/// A literal is a constant, held by the program where it is text.
fn literal(st: State, l: SourceLiteral) -> SpaceSummary =
  match l {
    LiteralInt(n) -> { ..none(st), size: Some(literal_size(n)), number: true },
    LiteralString(_) -> { ..none(st), size: Some(constant()), holders: Shared },
    LiteralBytes(_) -> { ..none(st), size: Some(constant()), holders: Shared },
    LiteralEmbedded(_, _) -> { ..none(st), size: Some(constant()), holders: Shared },
    _ -> { ..none(st), number: true },
  }

/// Each of `cs` walked in turn, a local read and not moved held after as `keeps` says of its place:
/// once more by what takes it, or not at all.
fn walk_all(
  env: Env,
  st: State,
  cs: List<Code>,
  keeps: (Int) -> Option<Sharing>,
) -> Result<{ walked: SpaceSummary, all: List<SpaceSummary> }, String> / {abort.raise} =
  range(0, cs.len()).fold(
    Ok({ walked: none(st), all: [] }),
    |acc: Result<{ walked: SpaceSummary, all: List<SpaceSummary> }, String>, i: Int|
      match acc {
        Err(_) -> acc,
        Ok(sofar) -> match cs.at(i) {
          None -> acc,
          Some(c) -> match walk({ ..env, tail: false }, sofar.walked.state, c) {
            Err(why) -> Err(why),
            Ok(w) -> {
              let after = match keeps(i) { Some(h) -> retain(w.state, w.read, h), None -> w.state };
              Ok({ walked: then(sofar.walked, { ..w, state: after }), all: sofar.all.push(w) })
            },
          },
        },
      },
  )

fn binary(
  env: Env,
  st: State,
  op: Bytes,
  lhs: Code,
  rhs: Code,
) -> Result<SpaceSummary, String> / {abort.raise} =
  match walk({ ..env, tail: false }, st, lhs) {
    Err(why) -> Err(why),
    Ok(l) -> {
      let short = op == b"and" || op == b"or";
      match walk({ ..env, tail: env.tail && short }, l.state, rhs) {
        Err(why) -> Err(why),
        Ok(r) -> if op == b"concat" { appended(l, r) } else {
          Ok({
            ..as_value(then(l, r), Unshared, true),
            size: arithmetic(op, l.size, r.size),
            of: toward(env.found, op, l.of, rhs, r.of, lhs),
          })
        },
      }
    },
  }

/// `a ++ b`: in place, where `a` is held once, it grows by what `b` holds; else both are copied.
fn appended(a: SpaceSummary, b: SpaceSummary) -> Result<SpaceSummary, String> =
  match if a.holders != Shared { b.size }
    else { match ((a.size, b.size)) { (Some(x), Some(y)) -> Some(plus(x, y)), _ -> None } } {
    None -> Err("an append whose size is not read"),
    Some(p) ->
      Ok({
        ..as_value(allocated(then(a, { ..b, state: retain(b.state, b.read, UnsharedTop) }), p), if is_unshared(a) && is_unshared(b) { Unshared } else { UnsharedTop }, false),
        size: arithmetic(b"concat", a.size, b.size),
      }),
  }

fn block(
  env: Env,
  st: State,
  statements: List<CodeStatement>,
  tail: Option<Code>,
) -> Result<SpaceSummary, String> / {abort.raise} =
  match statements.fold(Ok(none(st)), |acc: Result<SpaceSummary, String>, s: CodeStatement|
      match acc {
        Err(_) -> acc,
        Ok(sofar) -> match statement({ ..env, tail: false }, sofar.state, s) {
          Err(why) -> Err(why),
          Ok(w) -> Ok(then(sofar, w)),
        },
      }) {
    Err(why) -> Err(why),
    Ok(ran) -> match tail {
      None -> Ok(as_value(ran, Unshared, true)),
      Some(t) -> match walk(env, ran.state, t) { Err(why) -> Err(why), Ok(w) -> Ok(then(ran, w)) },
    },
  }

fn statement(
  env: Env,
  st: State,
  s: CodeStatement,
) -> Result<SpaceSummary, String> / {abort.raise} =
  match s {
    CodeDo(d) -> walk(env, st, d.code),
    CodeLet(l) -> match walk(env, st, l.value) {
      Err(why) -> Err(why),
      Ok(w) -> Ok({ ..w, state: bind(retain(w.state, w.read, Shared), l.slot, slot_of(w)) }),
    },
    CodeLetDestructure(l) -> match walk(env, st, l.value) {
      Err(why) -> Err(why),
      Ok(w) -> {
        let go = let_go(env, l.value, w);
        let before = retain(w.state, w.read, UnsharedTop);
        let opened = {
          ..before,
          reusable_constructor: credit_after(go, before.reusable_constructor, l.pattern),
        };
        Ok(allocated({ ..w, state: patterned(env, opened, l.pattern, w, go) }, rests(l.pattern)))
      },
    },
  }

/// Whether compiled code lets a pattern's subject go once its binders hold its fields: where it is
/// a local's last read, held once, outside a function value.
fn let_go(env: Env, subject: Code, w: SpaceSummary) -> Bool =
  !env.lambda && read_moved(env.moves, subject.span) && !w.number && w.holders != Shared
    && (match subject.node { CodeVar(_) -> true, _ -> false })

/// The cells a let-go subject leaves for the next constructor of its kind to take, where no other
/// constructor's wait: a constructor with fields leaves them.
fn credit_after(go: Bool, credit: Option<Bytes>, pattern: CodePattern) -> Option<Bytes> =
  if !go || credit != None { credit } else {
    match pattern {
      CodeConstructorPattern(c) -> if c.args.len() > 0 { Some(c.name) } else { None },
      _ -> None,
    }
  }

/// The objects a pattern makes: a list's rest is one of its own.
fn rests(pattern: CodePattern) -> Polynomial =
  match pattern {
    CodeListPattern(l) ->
      l.items.fold(
        if l.rest == None { zero() } else { constant() },
        |acc: Polynomial, p: CodePattern| plus(acc, rests(p)),
      ),
    CodeConstructorPattern(c) ->
      c.args.fold(zero(), |acc: Polynomial, p: CodePattern| plus(acc, rests(p))),
    CodeRecordPattern(r) ->
      r.fields.fold(zero(), |acc: Polynomial, f: CodePatternField| plus(acc, rests(f.pattern))),
    _ -> zero(),
  }

/// The locals a pattern binds of `subject`: the subject itself where it binds it whole, and its
/// parts held alone only where the subject was, and was let go.
fn patterned(
  env: Env,
  st: State,
  pattern: CodePattern,
  subject: SpaceSummary,
  go: Bool,
) -> State / {abort.raise} =
  bound(
    env,
    st,
    pattern,
    { ..slot_of(subject), holders: if go || subject.number { subject.holders } else { Shared } },
    if go && subject.holders == Unshared { Unshared } else { Shared },
  )

fn bound(
  env: Env,
  st: State,
  pattern: CodePattern,
  whole: Slot,
  parts: Sharing,
) -> State / {abort.raise} =
  match pattern {
    CodeBindingPattern(v) -> bind(st, v.slot, whole),
    CodeListPattern(l) -> {
      let heads = l.items.fold(st, |s: State, p: CodePattern|
        bound(env, s, p, part(parts, false), parts));
      match l.rest {
        None -> heads,
        Some(r) ->
          bound(
            env,
            heads,
            r,
            {
              ..part(parts, false),
              size: whole.size,
              of: if l.items.len() == 0 { whole.of }
              else { match whole.of { Same(i) -> Part(i), Part(i) -> Part(i), _ -> Other } },
            },
            parts,
          ),
      }
    },
    CodeConstructorPattern(c) -> {
      let fields = match ctor(env.context, String::of_bytes_lossy(c.name)) {
        Some(k) -> k.variant.fields,
        None -> [],
      };
      range(0, c.args.len()).fold(st, |s: State, i: Int|
        match c.args.at(i) {
          Some(p) ->
            bound(
              env,
              s,
              p,
              part(parts, match fields.at(i) { Some(t) -> is_number(t), None -> false }),
              parts,
            ),
          None -> s,
        })
    },
    CodeRecordPattern(r) ->
      r.fields.fold(st, |s: State, f: CodePatternField|
        bound(env, s, f.pattern, part(parts, false), parts)),
    _ -> st,
  }

fn part(parts: Sharing, number: Bool) -> Slot =
  {
    size: None,
    of: Other,
    fun: None,
    holders: if number { Unshared } else { parts },
    number: number,
  }

/// An arm that takes a head off the list known to be empty is never taken.
fn needs_head(env: Env, subject: SpaceSummary, pattern: CodePattern) -> Bool =
  match ((env.empty, subject.of, pattern)) {
    (Some(p), Same(i), CodeListPattern(l)) -> p == i && l.items.len() > 0,
    _ -> false,
  }

/// The arm taken, after its guard and every guard before it. An arm with a guard keeps its subject
/// for the arms after, and one without lets it go. `at` is where the scrutinee is `List::at`: an
/// arm only `Some` matches has found an element, and is not taken where it misses.
fn arms(
  outer: Env,
  subject: SpaceSummary,
  scrutinee: Code,
  at: Option<IndexBound>,
  xs: List<CodeArm>,
) -> Result<SpaceSummary, String> / {abort.raise} =
  match xs.fold(
      Ok({ guards: none(subject.state), taken: None }),
      |acc: Result<{ guards: SpaceSummary, taken: Option<SpaceSummary> }, String>, arm: CodeArm|
        match acc {
          Err(_) -> acc,
          Ok(sofar) -> if needs_head(outer, subject, arm.pattern)
              || (at != None && at == outer.missed && takes_some(arm.pattern)) { acc } else {
            let env = match at {
              Some(f) -> if takes_some(arm.pattern) { { ..outer, found: outer.found.push(f) } }
              else { outer },
              None -> outer,
            };
            let go = arm.guard == None && let_go(env, scrutinee, subject);
            let here = sofar.guards.state;
            let start = patterned(
              env,
              {
                ..here,
                reusable_constructor: credit_after(go, here.reusable_constructor, arm.pattern),
              },
              arm.pattern,
              subject,
              go,
            );
            match match arm.guard {
                None -> Ok(allocated(none(start), rests(arm.pattern))),
                Some(g) -> match walk({ ..env, tail: false }, start, g) {
                  Err(why) -> Err(why),
                  Ok(w) -> Ok(allocated(w, rests(arm.pattern))),
                },
              } {
              Err(why) -> Err(why),
              Ok(g) -> match walk(env, g.state, arm.body) {
                Err(why) -> Err(why),
                Ok(b) -> {
                  let tried = then(sofar.guards, g);
                  let path = then(tried, b);
                  Ok({
                    guards: if arm.guard == None { sofar.guards } else { tried },
                    taken: Some(match sofar.taken { None -> path, Some(t) -> either(t, path) }),
                  })
                },
              },
            }
          },
        },
    ) {
    Err(why) -> Err(why),
    Ok(found) -> Ok(match found.taken { Some(w) -> w, None -> none(subject.state) }),
  }

// --- Calls --------------------------------------------------------------------------------------

fn application(
  env: Env,
  st: State,
  function: Code,
  args: List<Code>,
) -> Result<SpaceSummary, String> / {abort.raise} =
  match function.node {
    CodeVar(f) -> {
      let k = f.slot;
      match walk_all(env, st, args, |_i: Int| Some(Shared)) {
        Err(why) -> Err(why),
        Ok(a) -> match slot_at(a.walked.state, k).fun {
          Some(p) -> Ok(as_value(allocated(a.walked, p), Shared, false)),
          None -> Err("a call of a function value whose space is not read"),
        },
      }
    },
    NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) -> {
      let name = String::of_bytes_lossy(fname);
      if name == env.own { called_back(env, st, args) }
      else if ctor(env.context, name) != None { built(env, st, fname, args) }
      else if env.context.claims.definitions.contains(name)
          && !by_entry(env.context, name, SpaceClause) { called(env, st, name, args) } else {
        match iterating_of(fname) {
          Some(it) -> iterating(env, st, name, it, args),
          None -> builtin(env, st, name, args),
        }
      }
    },
    CodeLambda(l) -> match walk_all(env, st, args, |_i: Int| Some(Shared)) {
      Err(why) -> Err(why),
      Ok(a) -> match lambda_walk(
          env,
          a.walked.state,
          l.params,
          l.captures,
          l.body,
          a.all.map(|w: SpaceSummary| { ..slot_of(w), of: Other, holders: sharing_of(w) }),
        ) {
        Err(why) -> Err(why),
        Ok(w) -> if w.calls > 0 { Err("a call back inside a function value") } else {
          Ok(as_value(allocated(a.walked, plus(constant(), w.space)), sharing_of(w), w.number))
        },
      },
    },
    _ -> Err("a call of a computed function the bound does not read"),
  }

/// A call back into the definition being read: a frame of its own unless it is a tail call, which
/// compiled code makes a jump.
fn called_back(
  env: Env,
  st: State,
  args: List<Code>,
) -> Result<SpaceSummary, String> / {abort.raise} =
  if env.lambda { Err("a call back inside a function value") } else {
    match walk_all(env, st, args, |_i: Int| Some(Shared)) {
      Err(why) -> Err(why),
      Ok(a) -> {
        let frame = if env.tail { zero() } else { constant() };
        let shared = range(0, a.all.len()).fold(Map::new(), |m: Map<Int, Sharing>, i: Int|
          if at_or(env.numbers, i) { m } else {
            match a.all.at(i) {
              Some(w) -> if is_unshared(w) { m } else { m.insert(i, sharing_of(w)) },
              None -> m.insert(i, Shared),
            }
          });
        Ok(
          then(a.walked, {
            ..none(a.walked.state),
            space: frame,
            looped: frame,
            holders: Shared,
            calls: 1,
            back: [a.all.map(|w: SpaceSummary| w.of)],
            shared: shared,
          }),
        )
      },
    }
  }

/// A constructor with fields takes the cells a `match` left of one like it, or is a new object.
fn built(
  env: Env,
  st: State,
  name: Bytes,
  args: List<Code>,
) -> Result<SpaceSummary, String> / {abort.raise} =
  match walk_all(env, st, args, |_i: Int| Some(Shared)) {
    Err(why) -> Err(why),
    Ok(a) -> {
      let now = a.walked.state;
      let reused = args.len() > 0 && now.reusable_constructor == Some(name);
      Ok(
        as_value(
          allocated(
            { ..a.walked, state: if reused { { ..now, reusable_constructor: None } } else { now } },
            if args.len() == 0 || reused { zero() } else { constant() },
          ),
          sharing_of_parts(a.all.map(sharing_of)),
          false,
        ),
      )
    },
  }

/// A call of a definition holds its space at the sizes of its arguments: as read with them held
/// alone where each that is not a number or a function is, and else with them held anywhere.
fn called(
  env: Env,
  st: State,
  name: String,
  args: List<Code>,
) -> Result<SpaceSummary, String> / {abort.raise} = {
  let numbers = numbers_of(env.context, name, args.len());
  let functions = functions_of(env.context, name, args.len());
  let numeric = returns_number(env.context, name);
  match walk_all(env, st, args, |_i: Int| if numeric { None } else { Some(Shared) }) {
    Err(why) -> Err(why),
    Ok(a) -> {
      let alone_all = range(0, a.all.len()).fold(true, |ok: Bool, i: Int|
        ok
          && (at_or(numbers, i) || at_or(functions, i)
          || (match a.all.at(i) { Some(w) -> is_unshared(w), None -> false })));
      match env.known.get(name) {
        None -> Err("`" ++ name ++ "` reaches definitions that call each other"),
        Some(k) -> match space_use_for(k, alone_all) {
          Err(why) -> Err(why),
          Ok(s) -> match at_args(
              s.space,
              a.all.map(|w: SpaceSummary| w.size),
              a.all.map(|w: SpaceSummary| w.fun),
            ) {
            Err(why) -> Err(why),
            Ok(q) ->
              Ok(
                as_value(
                  allocated(a.walked, q),
                  if numeric { Unshared } else { s.holders },
                  numeric,
                ),
              ),
          },
        },
      }
    },
  }
}

/// The argument a function its entry describes threads through the function it is handed.
fn threaded(it: CallbackUse) -> Option<Int> =
  it.params.fold(None, |found: Option<Int>, h: CallbackArgument|
    match h { Accumulator(k) -> Some(k), _ -> found })

/// What the function an entry describes hands each parameter of the function it is handed, the
/// accumulator aside.
fn handed_slots(it: CallbackUse, all: List<SpaceSummary>, st: State) -> List<Slot> = {
  let arg = |i: Int| match all.at(i) { Some(w) -> w, None -> none(st) };
  it.params.map(|h: CallbackArgument|
    match h {
      Number -> number_slot(),
      ExtractedFrom(k) ->
        {
          ..unknown_slot(),
          holders: if !arg(k).number && arg(k).holders == Unshared { Unshared } else { Shared },
        },
      _ -> unknown_slot(),
    })
}

/// A function threaded with a seed: its first call handed the seed at `k`, and each after it what the
/// one before answered, which a more widely held answer widens until they agree.
fn threaded_calls(
  env: Env,
  st: State,
  all: List<SpaceSummary>,
  args: List<Code>,
  it: CallbackUse,
  slots: List<Slot>,
  k: Int,
) -> Result<{ first: { space: Polynomial, holders: Sharing, number: Bool }, rest: { space: Polynomial, holders: Sharing, number: Bool } }, String> / {abort.raise} = {
  let seed = match all.at(k) { Some(w) -> w, None -> none(st) };
  let handing = |acc: Slot|
    range(0, it.params.len()).map(|j: Int|
      match it.params.get(j) { Accumulator(_) -> acc, _ -> slots.get(j) });
  match callback(
      env,
      st,
      args,
      it.callback,
      handing({ ..slot_of(seed), of: Other, holders: sharing_of(seed) }),
    ) {
    Err(why) -> Err(why),
    Ok(first) -> match steadied(
        env,
        st,
        args,
        it.callback,
        handing,
        first.holders,
        seed.number && first.number,
        3,
      ) {
      Err(why) -> Err(why),
      Ok(rest) -> Ok({ first: first, rest: rest }),
    },
  }
}

/// The space one call of a definition or constructor named as a value holds, handed values held
/// anywhere, where it grows with nothing it is given.
fn fun_named(env: Env, name: String) -> Option<Polynomial> =
  if ctor(env.context, name) != None { Some(constant()) } else {
    match env.known.get(name) {
      Some(k) -> match k.anyhow {
        Ok(s) -> match at_args(s.space, [], []) { Ok(q) -> Some(q), Err(_) -> None },
        Err(_) -> None,
      },
      None -> None,
    }
  }

/// A function value's body, its parameters as `params` and what it captured held by it as well.
fn lambda_walk(
  env: Env,
  outer: State,
  params: Int,
  captures: List<Capture>,
  body: Code,
  slots: List<Slot>,
) -> Result<SpaceSummary, String> / {abort.raise} = {
  let start = range(0, params).fold(
    { slots: [], reusable_constructor: None },
    |s: State, i: Int| bind(s, i, match slots.at(i) { Some(x) -> x, None -> unknown_slot() }),
  );
  let captured = captures.fold(start, |s: State, cap: Capture| {
    let from = slot_at(outer, cap.src);
    bind(s, cap.destination, { ..from, holders: if from.number { Unshared } else { Shared } })
  });
  walk({ ..env, lambda: true, tail: false, empty: None, missed: None }, captured, body)
}

// --- Builtins -----------------------------------------------------------------------------------

/// What each native answers, by the name a call reaches it by.
fn builtin_result_kinds() -> Map<String, ResultKind> / {abort.raise} =
  natives().fold(Map::new(), |m: Map<String, ResultKind>, b: Builtin|
    m.insert(String::of_bytes_lossy(b.name), match b.scheme.ty {
      FunctionType(f) -> result_kind_of(f.ret),
      other -> result_kind_of(other),
    }))

fn result_kind_of(t: Type) -> ResultKind =
  match t {
    NamedType(c) -> if c.args.len() == 0 && is_number_name(String::of_bytes_lossy(c.name)) {
      NumberResult
    } else if c.name == b"Option" && c.args.len() == 1 {
      match c.args.at(0) {
        Some(x) -> if result_kind_of(x) == NumberResult { OptionNumberResult } else { ValueResult },
        None -> ValueResult,
      }
    } else { ValueResult },
    RecordType(fs) -> if fs.len() == 0 { NumberResult } else { ValueResult },
    _ -> ValueResult,
  }

fn is_number_name(n: String) -> Bool =
  [
    "Int",
    "Bool",
    "Float",
    "Char",
    "Decimal",
    "Unit",
    "Ordering",
    "U8",
    "U16",
    "U32",
    "U64",
    "U128",
    "I8",
    "I16",
    "I32",
    "I64",
    "I128",
  ].contains(
    n,
  )

fn is_number(t: Sort) -> Bool =
  match t {
    NamedSort(n, args) -> args.len() == 0 && is_number_name(n),
    RecordSort(fs) -> fs.len() == 0,
    _ -> false,
  }

/// Which of `definition`'s first `n` parameters are numbers, by its signature.
fn numbers_of(context: Context, definition: String, n: Int) -> List<Bool> =
  params_are(context, definition, n, is_number)

/// Which of `definition`'s first `n` parameters are functions, by its signature: no call takes a function
/// in place, so who else holds one changes nothing a call does with it.
fn functions_of(context: Context, definition: String, n: Int) -> List<Bool> =
  params_are(context, definition, n, |t: Sort|
    match t { FunctionSort(_, _, _) -> true, _ -> false })

/// Which of `definition`'s first `n` parameters `is` holds of, by its signature.
fn params_are(context: Context, definition: String, n: Int, is: (Sort) -> Bool) -> List<Bool> =
  match signature(context, definition) {
    Some(s) -> match s.ty {
      FunctionSort(ps, _, _) ->
        range(0, n).map(|i: Int| match ps.at(i) { Some(t) -> is(t), None -> false }),
      _ -> range(0, n).map(|_i: Int| false),
    },
    None -> range(0, n).map(|_i: Int| false),
  }

fn returns_number(context: Context, definition: String) -> Bool =
  match signature(context, definition) {
    Some(s) -> match s.ty { FunctionSort(_, ret, _) -> is_number(ret), other -> is_number(other) },
    None -> false,
  }

fn at_or(xs: List<Bool>, i: Int) -> Bool = match xs.at(i) { Some(x) -> x, None -> false }

/// The builtins that answer their first argument updated: in place where it is held once.
fn updates(name: String) -> Bool =
  name == "List::push" || name == "List::set" || name == "Array::set" || name == "Columns::set"
    || name == "Map::insert"
    || name == "Map::remove"
    || name == "Map::pop_first"
    || name == "Map::pop_last"
    || name == "Map::split"

/// The builtins whose answer shares what their first argument holds: an element of it, or all of
/// them in another collection or in a call of a function.
fn reads_parts(name: String) -> Bool =
  name == "List::at" || name == "Array::at" || name == "Array::get" || name == "Columns::at"
    || name == "Columns::get"
    || name == "Map::get"
    || name == "Map::first"
    || name == "Map::last"
    || name == "Map::floor"
    || name == "Map::ceiling"
    || name == "Map::below"
    || name == "Map::above"
    || name == "Map::range"
    || name == "Map::keys"
    || name == "Map::values"
    || name == "Map::entries"
    || name == "Array::of_list"
    || name == "Array::to_list"
    || name == "Columns::of_list"
    || name == "Columns::to_list"

/// How an argument a builtin reads without moving is held after the call: not at all where the
/// answer holds nothing of it, by parts where the answer shares them, and else whole.
fn kept_by(name: String, answer: ResultKind, i: Int) -> Option<Sharing> =
  if answer != ValueResult || name == "Bytes::concat" || name == "String::concat"
      || name == "Bytes::slice"
      || name == "String::slice" { None }
  else if i == 0 && updates(name) { None }
  else if i == 0 && reads_parts(name) { Some(UnsharedTop) }
  else { Some(Shared) }

fn builtin(
  env: Env,
  st: State,
  name: String,
  args: List<Code>,
) -> Result<SpaceSummary, String> / {abort.raise} =
  match env.results.get(name) {
    None -> Err("`" ++ name ++ "` has no body here to read"),
    Some(answer) -> match walk_all(env, st, args, |i: Int| kept_by(name, answer, i)) {
      Err(why) -> Err(why),
      Ok(a) -> match contained_by(name, answer, a.walked.state, a.all) {
        Err(why) -> Err(why),
        Ok(m) ->
          Ok({ ..as_value(allocated(a.walked, m.space), m.holders, m.number), size: m.size }),
      },
    },
  }

/// What a builtin's own call makes, who else holds its answer, and the answer's size.
type Allocation = { space: Polynomial, holders: Sharing, number: Bool, size: Option<Polynomial> }

fn object(
  space: Polynomial,
  holders: Sharing,
  size: Option<Polynomial>,
) -> Result<Allocation, String> = Ok({ space: space, holders: holders, number: false, size: size })

/// `s` and `extra`, where the size `s` is read.
fn over(name: String, s: Option<Polynomial>, extra: Polynomial) -> Result<Polynomial, String> =
  match s {
    Some(p) -> Ok(plus(p, extra)),
    None -> Err("`" ++ name ++ "` over a value whose size is not read"),
  }

/// An update of the first argument: in place, making `extra`, where it is held once; else a copy of
/// it too.
fn updated(
  name: String,
  first: SpaceSummary,
  extra: Polynomial,
  parts: Sharing,
  size: Option<Polynomial>,
) -> Result<Allocation, String> =
  if !first.number && first.holders != Shared {
    object(extra, sharing_of_parts([first.holders, parts]), size)
  } else {
    match over(name, first.size, extra) {
      Ok(p) -> object(p, UnsharedTop, size),
      Err(why) -> Err(why),
    }
  }

/// A new value as large as the first argument, and `extra` beside.
fn as_large(
  name: String,
  first: SpaceSummary,
  extra: Polynomial,
  holders: Sharing,
) -> Result<Allocation, String> =
  match over(name, first.size, extra) {
    Ok(p) -> object(p, holders, first.size),
    Err(why) -> Err(why),
  }

/// Each call of the function at `position`, `times` over.
fn iterated(
  env: Env,
  st: State,
  args: List<Code>,
  times: Option<Polynomial>,
  position: Int,
  params: List<Slot>,
) -> Result<Polynomial, String> / {abort.raise} =
  match times {
    None -> Err("an iteration over a value whose size is not read"),
    Some(n) -> match callback(env, st, args, position, params) {
      Err(why) -> Err(why),
      Ok(cb) -> product(n, cb.space),
    },
  }

fn number_slot() -> Slot = { ..unknown_slot(), holders: Unshared, number: true }

/// A call of a function its entry says calls the function it is handed: what the call makes once its
/// arguments are walked, that function called as many times as their sizes allow.
fn iterating(
  env: Env,
  st: State,
  name: String,
  it: CallbackUse,
  args: List<Code>,
) -> Result<SpaceSummary, String> / {abort.raise} = {
  let numeric = match env.results.get(name) {
    Some(a) -> a != ValueResult,
    None -> returns_number(env.context, name),
  };
  let holds = it.result == Mapped || it.result == Filtered || it.result == Folded;
  let keeps = |i: Int|
    if numeric || it.result == Updated(i) { None }
    else if holds && it.over.at(0) == Some(i) { Some(UnsharedTop) }
    else { Some(Shared) };
  match walk_all(env, st, args, keeps) {
    Err(why) -> Err(why),
    Ok(a) -> {
      let now = a.walked.state;
      let arg = |i: Int| match a.all.at(i) { Some(w) -> w, None -> none(now) };
      let slots = handed_slots(it, a.all, now);
      let m = match it.result {
        Folded -> folded(env, now, a.all, args, it, slots),
        answer -> match iterated(
            env,
            now,
            args,
            calls_made(it, a.all.map(|w: SpaceSummary| w.size)),
            it.callback,
            slots,
          ) {
          Err(why) -> Err(why),
          Ok(p) -> match answer {
            Updated(k) -> updated(name, arg(k), plus(constant(), p), UnsharedTop, arg(k).size),
            UnknownReturn -> if numeric {
              Ok({ space: p, holders: Unshared, number: true, size: None })
            } else { object(plus(constant(), p), Shared, None) },
            _ -> match it.over.at(0) {
              Some(k) -> as_large(name, arg(k), p, UnsharedTop),
              None -> Err("`" ++ name ++ "` walks nothing"),
            },
          },
        },
      };
      match m {
        Err(why) -> Err(why),
        Ok(x) ->
          Ok({ ..as_value(allocated(a.walked, x.space), x.holders, x.number), size: x.size }),
      }
    },
  }
}

/// A builtin over a container or answering a number: what it makes and how it holds its parts.
fn contained_by(
  name: String,
  answer: ResultKind,
  st: State,
  all: List<SpaceSummary>,
) -> Result<Allocation, String> = {
  let arg = |i: Int| match all.at(i) { Some(w) -> w, None -> none(st) };
  let grown = match arg(0).size { Some(s) -> Some(plus(s, constant())), None -> None };
  if answer == NumberResult {
    Ok({
      space: zero(),
      holders: Unshared,
      number: true,
      size: if is_length(name) { arg(0).size } else { None },
    })
  } else if answer == OptionNumberResult { object(constant(), Unshared, None) }
  else if name == "List::push" { updated(name, arg(0), constant(), sharing_of(arg(1)), grown) }
  else if name == "Map::insert" {
    updated(
      name,
      arg(0),
      constant(),
      sharing_of_parts([sharing_of(arg(1)), sharing_of(arg(2))]),
      grown,
    )
  } else if name == "List::set" || name == "Array::set" || name == "Columns::set" {
    updated(name, arg(0), zero(), sharing_of(arg(2)), arg(0).size)
  } else if name == "Map::remove" { updated(name, arg(0), constant(), Unshared, arg(0).size) }
  else if name == "Map::pop_first" || name == "Map::pop_last" {
    updated(name, arg(0), constant(), UnsharedTop, None)
  } else if name == "Map::split" { as_large(name, arg(0), constant(), UnsharedTop) }
  else if name == "Bytes::concat" || name == "String::concat" {
    match appended(arg(0), arg(1)) {
      Err(why) -> Err(why),
      Ok(w) -> Ok({ space: w.space, holders: w.holders, number: false, size: w.size }),
    }
  } else if name == "range" {
    match ((arg(0).size, arg(1).size)) {
      (Some(lo), Some(hi)) -> object(plus(lo, hi), Unshared, Some(plus(lo, hi))),
      _ -> Err("`range` over a value whose size is not read"),
    }
  } else if name == "Map::new" { object(constant(), Unshared, Some(constant())) }
  else if name == "Array::new" || name == "Columns::new" {
    as_large(name, arg(0), zero(), sharing_of_parts([sharing_of(arg(1))]))
  } else if name == "Array::of_list" || name == "Array::to_list" || name == "Columns::of_list"
      || name == "Columns::to_list"
      || name == "Map::keys"
      || name == "Map::values"
      || name == "Map::entries"
      || name == "Map::of_entries"
      || name == "Map::range" { as_large(name, arg(0), constant(), UnsharedTop) }
  else if name == "Map::merge" {
    match ((arg(0).size, arg(1).size)) {
      (Some(x), Some(y)) -> object(plus(plus(x, y), constant()), UnsharedTop, Some(plus(x, y))),
      _ -> Err("`Map::merge` over a value whose size is not read"),
    }
  } else if name == "List::at" || name == "Array::at" || name == "Columns::at" || name == "Map::get"
      || name == "Map::first"
      || name == "Map::last"
      || name == "Map::floor"
      || name == "Map::ceiling"
      || name == "Map::below"
      || name == "Map::above"
      || name == "checked_add"
      || name == "checked_sub"
      || name == "checked_mul"
      || name == "checked_neg"
      || name == "Columns::get" { object(constant(), UnsharedTop, None) }
  else if name == "Array::get" { object(zero(), Shared, None) }
  else { valued_by(name, st, all) }
}

/// A builtin over text, bytes or numbers: what it makes and how it holds its parts.
fn valued_by(name: String, st: State, all: List<SpaceSummary>) -> Result<Allocation, String> = {
  let arg = |i: Int| match all.at(i) { Some(w) -> w, None -> none(st) };
  if name == "String::chars" || name == "String::of_chars" || name == "String::trim"
      || name == "Bytes::of_string"
      || name == "String::of_bytes"
      || name == "String::of_bytes_lossy"
      || name == "String::slice" { as_large(name, arg(0), constant(), Unshared) }
  else if name == "String::split" || name == "Bytes::split" {
    match over(name, arg(0).size, constant()) {
      Ok(p) -> object(p, Unshared, Some(p)),
      Err(why) -> Err(why),
    }
  } else if name == "Bytes::slice" {
    // A view of what it slices, or a short copy; either is copied to grow.
    object(constant(), Shared, arg(0).size)
  } else if name == "Int::to_string" || name == "Float::to_string" || name == "Decimal::to_string"
      || name == "U128::to_string"
      || name == "I128::to_string"
      || name == "Bytes::blake3"
      || name == "digest" { object(constant(), Unshared, Some(constant())) }
  else if name == "byte_of_int" { object(zero(), Shared, Some(constant())) }
  else if name == "min" || name == "max" {
    Ok({
      space: zero(),
      holders: more_shared(sharing_of(arg(0)), sharing_of(arg(1))),
      number: arg(0).number && arg(1).number,
      size: None,
    })
  } else if name == "observe" {
    Ok({ space: zero(), holders: sharing_of(arg(0)), number: arg(0).number, size: arg(0).size })
  } else if name == "numeric_of_int" || name == "wrap_add" || name == "wrap_sub"
      || name == "wrap_mul"
      || name == "saturating_add"
      || name == "saturating_sub"
      || name == "saturating_mul"
      || name == "rotr"
      || name == "rotl" { Ok({ space: zero(), holders: Unshared, number: true, size: None }) }
  else if name == "panic" { object(constant(), Shared, None) }
  else { Err("`" ++ name ++ "` holds what the bound does not read") }
}

/// A fold: its first call is handed the seed, and each after it what the one before answered, so
/// only the first copies a seed something else holds. `slots` are what its entry's function is
/// handed besides the accumulator.
fn folded(
  env: Env,
  st: State,
  all: List<SpaceSummary>,
  args: List<Code>,
  it: CallbackUse,
  slots: List<Slot>,
) -> Result<Allocation, String> / {abort.raise} =
  match ((threaded(it), calls_made(it, all.map(|w: SpaceSummary| w.size)))) {
    (_, None) -> Err("an iteration over a value whose size is not read"),
    (None, _) -> Err("a fold threads nothing through the function it is handed"),
    (Some(k), Some(n)) -> {
      let seed = match all.at(k) { Some(w) -> w, None -> none(st) };
      match threaded_calls(env, st, all, args, it, slots, k) {
        Err(why) -> Err(why),
        Ok(t) -> match product(n, t.rest.space) {
          Err(why) -> Err(why),
          Ok(p) ->
            Ok({
              space: plus(t.first.space, p),
              holders: more_shared(sharing_of(seed), t.rest.holders),
              number: seed.number && t.first.number,
              size: None,
            }),
        },
      }
    },
  }

/// A fold's callback read with its accumulator held as what the callback answers is, which a more
/// widely held answer widens until they agree.
fn steadied(
  env: Env,
  st: State,
  args: List<Code>,
  position: Int,
  handing: (Slot) -> List<Slot> / {abort.raise},
  holders: Sharing,
  number: Bool,
  tries: Int,
) -> Result<{ space: Polynomial, holders: Sharing, number: Bool }, String> / {abort.raise} =
  match callback(
      env,
      st,
      args,
      position,
      handing({ ..unknown_slot(), holders: holders, number: number }),
    ) {
    Err(why) -> Err(why),
    Ok(cb) -> if more_shared(holders, cb.holders) == holders || tries <= 0 {
      Ok({ ..cb, holders: more_shared(holders, cb.holders) })
    } else {
      steadied(
        env,
        st,
        args,
        position,
        handing,
        more_shared(holders, cb.holders),
        number,
        tries - 1,
      )
    },
  }

/// What one call of a builtin's callback holds and answers, its parameters as `params`.
fn callback(
  env: Env,
  outer: State,
  args: List<Code>,
  position: Int,
  params: List<Slot>,
) -> Result<{ space: Polynomial, holders: Sharing, number: Bool }, String> / {abort.raise} =
  match args.at(position) {
    None -> Err("a builtin called without its callback"),
    Some(cb) -> match cb.node {
      CodeLambda(l) -> match lambda_walk(env, outer, l.params, l.captures, l.body, params) {
        Err(why) -> Err(why),
        Ok(w) -> if w.calls > 0 { Err("a call back inside an iteration") }
        else { Ok({ space: w.space, holders: sharing_of(w), number: w.number }) },
      },
      CodeVar(f) -> {
        let k = f.slot;
        match slot_at(outer, k).fun {
          Some(p) -> Ok({ space: p, holders: Shared, number: false }),
          None -> Err("a callback whose space is not read"),
        }
      },
      NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) -> {
        let name = String::of_bytes_lossy(fname);
        if ctor(env.context, name) != None {
          Ok({ space: constant(), holders: UnsharedTop, number: false })
        } else if name == env.own { Err("a call back inside an iteration") } else {
          match env.known.get(name) {
            None -> Err("a callback the bound does not read"),
            Some(k) -> match k.anyhow {
              Err(why) -> Err(why),
              Ok(s) -> match at_args(
                  s.space,
                  params.map(|_p: Slot| None),
                  params.map(|_p: Slot| None),
                ) {
                Err(why) -> Err(why),
                Ok(q) ->
                  Ok({ space: q, holders: s.holders, number: returns_number(env.context, name) }),
              },
            },
          }
        }
      },
      _ -> Err("a callback the bound does not read"),
    },
  }

// --- Tests ---------------------------------------------------------------------------------------

/// The space of `m.<definition>` against its first `space` clause: `Ok(true)` where the clause is shown.
fn shown(src: Bytes, definition: String) -> Result<Bool, String> / {abort.raise} =
  shown_in(context_owning([{ name: b"m", src: src }], |_m: Bytes| true), "m." ++ definition)

/// The space of `name` in `context` against its first `space` clause.
fn shown_in(context: Context, name: String) -> Result<Bool, String> / {abort.raise} =
  match context.claims.definitions.get(name) {
    None -> panic("a definition of the fixture"),
    Some(d) -> match d.spec.filter(|c: ClaimClause| c.kind == SpaceClause) {
      [c, ..] -> {
        let b = c.clause.code;
        match stated_space(b, d.params, d.spaced) {
          None -> Err("the bound is not read"),
          Some(bound) -> match space(context, name) {
            Err(why) -> Err(why),
            Ok(p) -> Ok(dominated_space(p, bound)),
          },
        }
      },
      [] -> panic("a `space` clause"),
    },
  }

test "a fold that makes nothing holds no space, and a map holds a list as long as the one it maps" {
  assert_eq(
    shown(b"fn f(xs: List<Int>) -> Int space 0 = xs.fold(0, |a: Int, x: Int| a + x)", "f"),
    Ok(true),
  );
  assert_eq(
    shown(b"fn f(xs: List<Int>) -> List<Int> space 0 = xs.map(|x: Int| x + 1)", "f"),
    Ok(false),
  );
  assert_eq(
    shown(b"fn f(xs: List<Int>) -> List<Int> space xs.len() = xs.map(|x: Int| x + 1)", "f"),
    Ok(true),
  )
}

test "a recursion that hands its function parameter on changed holds what no space name bounds" {
  let f = b"fn copier(y: Int) -> Int = [y, y, y].len()\nfn f(xs: List<Int>, i: Int, g: (Int) -> Int space s, acc: Int) -> Int space xs.len() * s = if i >= xs.len() { acc } else { f(xs, i + 1, copier, acc + g(i)) }\n";
  assert_eq(shown(f, "f"), Err("`m.f` hands on a parameter its space grows with, changed"));
  assert(
    shown(f.concat(b"fn h(xs: List<Int>) -> Int space 0 = f(xs, 0, |y: Int| y + 1, 0)\n"), "h")
      != Ok(true),
    None,
  )
}

test "a function parameter's space name stands for what each call of it holds" {
  let each = |bound: Bytes|
    shown(
      Bytes::concat_all([
        b"fn each(xs: List<Int>, g: (Int) -> List<Int> space s) -> List<List<Int>> space ",
        bound,
        b" = xs.map(g)",
      ]),
      "each",
    );
  assert_eq(each(b"xs.len() + xs.len() * s"), Ok(true));
  // A call of `g` may hold nothing, and the list `map` answers is held all the same.
  assert_eq(each(b"xs.len() * s"), Ok(false));
  assert_eq(each(b"xs.len()"), Ok(false));
  // Without the name a call of `g` holds what no bound reads.
  assert_eq(
    shown(
      b"fn each(xs: List<Int>, g: (Int) -> List<Int>) -> List<List<Int>> space xs.len() = xs.map(g)",
      "each",
    ),
    Err("a callback whose space is not read"),
  );
  // At a call the name stands for what the function given holds.
  let walk = b"fn walk(xs: List<Int>, i: Int, g: (Int) -> List<Int> space s, acc: List<List<Int>>) -> List<List<Int>> = if i >= xs.len() { acc } else { walk(xs, i + 1, g, acc.push(g(i))) }\n";
  let wrapped = |bound: Bytes|
    shown(
      Bytes::concat_all([
        walk,
        b"fn f(xs: List<Int>) -> List<List<Int>> space ",
        bound,
        b" = walk(xs, 0, |x: Int| [x], [])",
      ]),
      "f",
    );
  assert_eq(wrapped(b"xs.len()"), Ok(true));
  assert_eq(wrapped(b"1"), Ok(false))
}

test "a call of the prelude's `map` with a list something else holds holds what its bound states" {
  let context = |bound: Bytes|
    context_owning(
      [
        {
          name: b"m",
          src: Bytes::concat_all([
            b"fn f(xs: List<Int>) -> Int space ",
            bound,
            b" = xs.map(|x: Int| [x]).len() + xs.len()\n",
          ]),
        },
      ],
      |m: Bytes| m == b"m",
    );
  assert_eq(shown_in(context(b"xs.len()"), "m.f"), Ok(true));
  assert_eq(shown_in(context(b"1"), "m.f"), Ok(false))
}

fn chain() -> Bytes = b"type Chain = | Link(Int, Chain) | End\n"

test "a tail call back that builds what its match let go of holds nothing more" {
  assert_eq(
    shown(
      chain().concat(
        b"fn rev(xs: Chain, acc: Chain) -> Chain space 0 = match xs { End -> acc, Link(x, rest) -> rev(rest, Link(x, acc)) }",
      ),
      "rev",
    ),
    Ok(true),
  );
  // Two links built for one let go: the second is new on every call.
  assert_eq(
    shown(
      chain().concat(
        b"fn twice(xs: Chain, acc: Chain) -> Chain space 0 = match xs { End -> acc, Link(x, rest) -> twice(rest, Link(x, Link(x, acc))) }",
      ),
      "twice",
    ),
    Err(
      "`m.twice` does not call itself on a part of one list parameter, or on an index moved toward a limit it holds it short of, every time",
    ),
  );
  // A subject read again after its match is not let go.
  assert_eq(
    shown(
      chain().concat(
        b"fn other(a: Chain, b: Chain) -> Chain = a\nfn kept(xs: Chain, acc: Chain) -> Chain space 0 = match xs { End -> acc, Link(x, rest) -> kept(rest, Link(x, other(acc, xs))) }",
      ),
      "kept",
    ),
    Err(
      "`m.kept` does not call itself on a part of one list parameter, or on an index moved toward a limit it holds it short of, every time",
    ),
  )
}

test "an update of an array held alone is in place, and of one read after it a copy" {
  assert_eq(
    shown(
      b"fn fill(a: Array<Int>, i: Int, n: Int) -> Array<Int> / {abort.raise} space 0 = if i >= n { a } else { fill(a.set(i, 0), i + 1, n) }",
      "fill",
    ),
    Ok(true),
  );
  let copy = |bound: Bytes|
    shown(
      Bytes::concat_all([
        b"fn copy(a: Array<Int>) -> Int / {abort.raise} space ",
        bound,
        b" = { let b = a.set(0, 1); a.len() + b.len() }",
      ]),
      "copy",
    );
  assert_eq(copy(b"0"), Ok(false));
  assert_eq(copy(b"a.len()"), Ok(true))
}

test "a call back that is no tail call holds a frame for each" {
  let count = |bound: Bytes|
    shown(
      Bytes::concat_all([
        b"fn count(xs: List<Int>) -> Int space ",
        bound,
        b" = match xs { [] -> 0, [_, ..rest] -> 1 + count(rest) }",
      ]),
      "count",
    );
  assert_eq(count(b"0"), Ok(false));
  assert_eq(count(b"xs.len()"), Ok(true))
}

test "a call back past an index where `List::at` found an element holds a frame for each element" {
  let count = |bound: Bytes|
    shown(
      Bytes::concat_all([
        b"fn count(xs: List<Int>, i: Int) -> Int space ",
        bound,
        b" = match xs.at(i) { Some(_) -> 1 + count(xs, i + 1), None -> 0 }",
      ]),
      "count",
    );
  assert_eq(count(b"0"), Ok(false));
  assert_eq(count(b"xs.len()"), Ok(true))
}

test "a call back on an index moved toward a limit a guard holds it short of holds a frame for each" {
  let count = b"fn count(xs: List<Int>, i: Int) -> Int = if i >= xs.len() { 0 } else { 1 + count(xs, i + 1) }\n";
  let bound = |b: Bytes|
    shown(
      Bytes::concat_all([count, b"fn f(xs: List<Int>) -> Int space ", b, b" = count(xs, 0)"]),
      "f",
    );
  assert_eq(bound(b"0"), Ok(false));
  assert_eq(bound(b"xs.len()"), Ok(true))
}

test "a fold's first call alone copies a seed something else holds" {
  let grow = b"fn grow(xs: List<Int>, ys: List<Int>) -> List<Int> space ys.len() = ys.fold(xs, |a: List<Int>, y: Int| a.push(y))\n";
  assert_eq(shown(grow, "grow"), Ok(true));
  let shared = |bound: Bytes|
    shown(
      Bytes::concat_all([
        grow,
        b"fn shared(xs: List<Int>, ys: List<Int>) -> Int space ",
        bound,
        b" = grow(xs, ys).len() + xs.len()",
      ]),
      "shared",
    );
  assert_eq(shared(b"ys.len()"), Ok(false));
  assert_eq(shared(b"xs.len() + ys.len()"), Ok(true))
}

test "another package's definition holds what its `space` bound says, for arguments held alone" {
  let context = context_owning(
    [
      {
        name: b"base",
        src: b"pub fn ones(xs: List<Int>) -> List<Int> space xs.len() = xs.map(|_x: Int| 1)\n",
      },
      {
        name: b"app",
        src: b"import base\nfn f(xs: List<Int>) -> List<Int> = base::ones(xs)\nfn g(xs: List<Int>) -> Int = base::ones(xs).len() + xs.len()\n",
      },
    ],
    |m: Bytes| m == b"app",
  );
  assert_eq(space(context, "app.f"), Ok([Map::new().insert(0, 1)]));
  assert_eq(
    space(context, "app.g"),
    Err(
      "`base.ones` is handed a value something else holds, and its `space` bound is for arguments held alone",
    ),
  )
}
