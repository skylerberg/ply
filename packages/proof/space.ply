import compiler.emit.code (Code, CodeLiteral, CodeVariable, NDefinition, NConstructor, NBuiltin,
                           CodeUnary, CodeBinary, CodeApply, CodeKnownLambda, CodeIf, CodeBlock,
                           CodeList, CodeRecord, CodeMatch, CodePerform, CodeLabel, CodeLambda,
                           CodeSimulate, CodeParallel, CodeHandle, CodeFieldRead, CodeUpdate,
                           CodeStatement, CodeLet, CodeLetDestructure, CodeDo, CodeField, CodeArm,
                           CodePattern, CodeBindingPattern, CodeConstructorPattern,
                           CodeRecordPattern, CodeListPattern, CodePatternField, Capture)
import compiler.emit.moves (Moves, read_moved, capture_moved)
import compiler.front.published (ClaimClause)
import compiler.check.infer.checker (Builtin)
import compiler.syntax.items (SpaceClause)
import compiler.syntax.patterns (SourceLiteral, LiteralInt, LiteralString, LiteralBytes,
                                 LiteralEmbedded)
import compiler.check.types (Type, NamedType, FunctionType, RecordType)
import compiler.check.callbacks (CallbackUse, CallbackArgument, Accumulator, ExtractedFrom, Number,
                                 Mapped, Filtered, Folded, Updated, UnknownReturn)
import context (Context, Definition, BodyWithMoves, constructor, signature, is_recursive,
                moved_bodies)
import cost (Polynomial, ParameterRelation, Same, Part, Other, IndexBound, OnTail, OnIndex, zero,
             constant, size_of, plus, product, at_args, ceiling_of, callees, reachable,
             params_sized, arithmetic, definition_using_keyed_type, recursion_descent,
             descent_calls, growth_preserved, is_length, stated_cost, context_owning,
             index_bound_of, takes_some, operation_relation, assumed, possible, literal_size,
             callback_calls, iterating_of, by_entry, natives, dominated_space)
import domain (Sort, FunctionSort, NamedSort, RecordSort)
import std.list
import compiler.check.typed (binding_key)

type Sharing = | Unshared | OnlyPartsShared | Shared

type Slot = {
  size: Option<Polynomial>,
  relation: ParameterRelation,
  fun: Option<Polynomial>,
  holders: Sharing,
  is_number: Bool,
}

type State = { slots: List<Slot>, reusable_constructor: Option<Bytes> }

type SpaceSummary = {
  state: State,
  space: Polynomial,
  recursive_space: Polynomial,
  size: Option<Polynomial>,
  relation: ParameterRelation,
  call_space: Option<Polynomial>,
  holders: Sharing,
  is_number: Bool,
  read: Option<Int>,
  calls: Int,
  recursive_call_arguments: List<List<ParameterRelation>>,
  shared: Map<Int, Sharing>,
}

type KnownSpace = {
  unshared_arguments: Result<SpaceUse, String>,
  any_arguments: Result<SpaceUse, String>,
}

type SpaceUse = { space: Polynomial, holders: Sharing }

type ResultKind = | NumberResult | OptionNumberResult | ValueResult

type Env = {
  context: Context,
  definition: String,
  moves: Moves,
  numbers: List<Bool>,
  known: Map<String, KnownSpace>,
  results: Map<String, ResultKind>,
  lambda: Bool,
  tail: Bool,
  empty: Option<Int>,
  found: List<IndexBound>,
  missing_index: Option<IndexBound>,
}

pub fn space_clause_bound(
  bind_pattern: Code,
  params: Int,
  spaced: List<Int>,
) -> Option<Polynomial> =
  match bind_pattern.node {
    CodeLiteral(l) -> match l {
      LiteralInt(k) -> if k == 0 { Some(zero) } else { stated_cost(bind_pattern, params, spaced) },
      _ -> None,
    },
    _ -> stated_cost(bind_pattern, params, spaced),
  }

pub fn space_bound(
  context: Context,
  definition: String,
) -> Result<Polynomial, String> / {abort.raise} = {
  let results = builtin_result_kinds;
  let reach = reachable(context, definition);
  let moved = moved_bodies(context.claims, reach);
  let known = iterate(Map::new(), reach.len() + 1, |known: Map<String, KnownSpace>| {
    let ready = reach.filter(|n: String|
      !known.contains(n)
        && callees(context, n).fold(true, |all: Bool, c: String|
          all && (c == n || known.contains(c))));
    if ready.len() == 0 { Stop(known) } else {
      Continue(
        ready.fold(known, |k: Map<String, KnownSpace>, n: String|
          k.insert(n, known_of(context, results, moved, n, k))),
      )
    }
  });
  match definition_using_keyed_type(context, reach) {
    Some(n) ->
      Err(
        "`" ++ n
          ++ "` stores a value compared by its type's `key` function, and the `space` bound cannot see the code that calls `key`",
      ),
    None -> match known.get(definition) {
      Some(k) -> match space_use_for(k, true) { Ok(s) -> Ok(s.space), Err(reason) -> Err(reason) },
      None -> Err("`" ++ definition ++ "` is part of a cycle of definitions that call each other"),
    },
  }
}

fn space_use_for(k: KnownSpace, once: Bool) -> Result<SpaceUse, String> =
  if !once { k.any_arguments } else {
    match k.unshared_arguments {
      Ok(s) -> Ok(s),
      Err(reason) -> match k.any_arguments { Ok(s) -> Ok(s), Err(_) -> Err(reason) },
    }
  }

fn known_of(
  context: Context,
  results: Map<String, ResultKind>,
  moved: Map<String, Result<BodyWithMoves, String>>,
  definition: String,
  known: Map<String, KnownSpace>,
) -> KnownSpace / {abort.raise} =
  match context.claims.definitions.get(definition) {
    None -> {
      let reason = "`" ++ definition
        ++ "` has no body in the program, so its space cannot be analyzed";
      { unshared_arguments: Err(reason), any_arguments: Err(reason) }
    },
    Some(d) -> match moved.get(definition) {
      None ->
        {
          unshared_arguments: promised(definition, d),
          any_arguments: Err(
            "`" ++ definition
              ++ "` may be called with arguments shared with other values, and its `space` bound assumes arguments that are not shared",
          ),
        },
      Some(Err(reason)) -> { unshared_arguments: Err(reason), any_arguments: Err(reason) },
      Some(Ok(m)) -> {
        let read = |many: List<Int>|
          body_space(
            context,
            results,
            definition,
            d,
            m,
            known,
            many.fold(Map::new(), |m: Map<Int, Sharing>, i: Int| m.insert(i, Shared)),
          );
        { unshared_arguments: read([]), any_arguments: read(range(0, d.params)) }
      },
    },
  }

fn promised(definition: String, d: Definition) -> Result<SpaceUse, String> =
  match d.spec.filter(|c: ClaimClause| c.kind == SpaceClause).fold(
      None,
      |found: Option<Polynomial>, c: ClaimClause|
        match found {
          Some(_) -> found,
          None -> ceiling_of(c.clause.code, d.params, d.space_parameters),
        },
    ) {
    Some(p) -> Ok({ space: p, holders: Shared }),
    None ->
      Err(
        "`" ++ definition
          ++ "` has no body in the program to analyze, and no `space` bound to use instead",
      ),
  }

fn body_space(
  context: Context,
  results: Map<String, ResultKind>,
  definition: String,
  d: Definition,
  moved: BodyWithMoves,
  known: Map<String, KnownSpace>,
  entry: Map<Int, Sharing>,
) -> Result<SpaceUse, String> / {abort.raise} = {
  let body = moved.body;
  let params = d.params;
  let sized = params_sized(context, definition, params);
  let numbers = numbers_of(context, definition, params);
  let env = {
    context: context,
    definition: definition,
    moves: moved.moves,
    numbers: numbers,
    known: known,
    results: results,
    lambda: false,
    tail: true,
    empty: None,
    found: [],
    missing_index: None,
  };
  let entered = |shared: Map<Int, Sharing>|
    {
      slots: range(0, params).map(|i: Int| {
        let number = at_or(numbers, i);
        {
          size: if at_or(sized, i) { Some(size_of(i)) } else { None },
          relation: Same(i),
          fun: if d.space_parameters.contains(i) { Some([Map::new().insert(binding_key(i), 1)]) }
          else { None },
          holders: if number { Unshared }
          else { match shared.get(i) { Some(h) -> h, None -> Unshared } },
          is_number: number,
        }
      }),
      reusable_constructor: None,
    };
  let read = iterate(
    { shared: entry, walked: walk(env, entered(entry), body) },
    2 * params + 2,
    |r: { shared: Map<Int, Sharing>, walked: Result<SpaceSummary, String> }|
      match r.walked {
        Err(_) -> Stop(r),
        Ok(w) -> {
          let more = joined(r.shared, w.shared);
          if more == r.shared { Stop(r) }
          else { Continue({ shared: more, walked: walk(env, entered(more), body) }) }
        },
      },
  );
  let start = entered(read.shared);
  match read.walked {
    Err(reason) -> Err(reason),
    Ok(w) -> if !is_recursive(context, definition) { Ok({ space: w.space, holders: w.holders }) }
    else if !context.self_recursive.contains(definition) {
      Err("`" ++ definition ++ "` is part of a cycle of definitions that call each other")
    } else if w.recursive_space == zero {
      if growth_preserved(w.space, w.recursive_call_arguments) {
        Ok({ space: w.space, holders: w.holders })
      } else {
        Err(
          "`" ++ definition
            ++ "` calls itself with a changed value of a parameter, and its space grows with the size of that parameter",
        )
      }
    } else {
      match recursion_descent(
          definition,
          w.calls,
          w.recursive_call_arguments,
          w.space,
          "space grows",
        ) {
        Err(reason) -> Err(reason),
        Ok(None) -> Ok({ space: w.space, holders: w.holders }),
        Ok(Some(d)) -> match match d {
            OnTail(p) ->
              walk(
                { ..env, empty: Some(p) },
                { ..start, slots: start.slots.set(p, { ..slot_at(start, p), size: Some(zero) }) },
                body,
              ),
            OnIndex(f) -> walk({ ..env, missing_index: Some(f) }, start, body),
          } {
          Err(reason) -> Err(reason),
          Ok(e) -> match product(descent_calls(d), w.space) {
            Ok(chain_source) ->
              Ok({
                space: plus(chain_source, e.space),
                holders: more_shared(w.holders, e.holders),
              }),
            Err(reason) -> Err(reason),
          },
        },
      }
    },
  }
}

fn more_shared(a: Sharing, b: Sharing) -> Sharing =
  if a == Shared || b == Shared { Shared }
  else if a == OnlyPartsShared || b == OnlyPartsShared { OnlyPartsShared }
  else { Unshared }

fn sharing_of_parts(parts: List<Sharing>) -> Sharing =
  if parts.fold(true, |all: Bool, h: Sharing| all && h == Unshared) { Unshared }
  else { OnlyPartsShared }

fn sharing_of(w: SpaceSummary) -> Sharing = if w.is_number { Unshared } else { w.holders }

fn is_unshared(w: SpaceSummary) -> Bool = sharing_of(w) == Unshared

const unknown_slot: Slot =
  { size: None, relation: Other, fun: None, holders: Shared, is_number: false }

fn slot_at(st: State, k: Int) -> Slot = match st.slots.at(k) { Some(s) -> s, None -> unknown_slot }

fn slot_of(w: SpaceSummary) -> Slot =
  {
    size: w.size,
    relation: w.relation,
    fun: w.call_space,
    holders: w.holders,
    is_number: w.is_number,
  }

fn bind(st: State, k: Int, s: Slot) -> State / {abort.raise} = {
  let grown = if st.slots.len() <= k {
    range(st.slots.len(), k + 1).fold(st.slots, |accumulator: List<Slot>, _i: Int|
      accumulator.push(unknown_slot))
  } else { st.slots };
  { ..st, slots: grown.set(k, s) }
}

fn mark_shared(st: State, read: Option<Int>, to: Sharing) -> State =
  match read {
    None -> st,
    Some(k) -> match st.slots.at(k) {
      Some(s) -> if s.is_number { st }
      else { { ..st, slots: st.slots.set(k, { ..s, holders: more_shared(s.holders, to) }) } },
      None -> st,
    },
  }

fn merged(a: State, b: State) -> State =
  {
    slots: range(0, max(a.slots.len(), b.slots.len())).map(|i: Int|
      match ((a.slots.at(i), b.slots.at(i))) {
        (Some(x), Some(y)) -> { ..x, holders: more_shared(x.holders, y.holders) },
        (Some(x), None) -> x,
        (None, Some(y)) -> y,
        _ -> unknown_slot,
      }),
    reusable_constructor: if a.reusable_constructor == b.reusable_constructor {
      a.reusable_constructor
    } else { None },
  }

fn empty_summary(st: State) -> SpaceSummary =
  {
    state: st,
    space: zero,
    recursive_space: zero,
    size: None,
    relation: Other,
    call_space: None,
    holders: Unshared,
    is_number: false,
    read: None,
    calls: 0,
    recursive_call_arguments: [],
    shared: Map::new(),
  }

fn joined(a: Map<Int, Sharing>, b: Map<Int, Sharing>) -> Map<Int, Sharing> =
  b.fold(a, |accumulator: Map<Int, Sharing>, i: Int, h: Sharing|
    accumulator.insert(i, match accumulator.get(i) { Some(g) -> more_shared(g, h), None -> h }))

fn allocated(w: SpaceSummary, p: Polynomial) -> SpaceSummary =
  {
    ..w,
    space: plus(w.space, p),
    recursive_space: if w.calls > 0 { plus(w.recursive_space, p) } else { w.recursive_space },
  }

fn then(a: SpaceSummary, b: SpaceSummary) -> SpaceSummary =
  {
    state: b.state,
    space: plus(a.space, b.space),
    recursive_space: plus(
      if a.calls > 0 { plus(a.recursive_space, b.space) } else { zero },
      if b.calls > 0 { plus(a.space, b.recursive_space) } else { zero },
    ),
    size: b.size,
    relation: b.relation,
    call_space: b.call_space,
    holders: b.holders,
    is_number: b.is_number,
    read: b.read,
    calls: a.calls + b.calls,
    recursive_call_arguments: a.recursive_call_arguments.concat(b.recursive_call_arguments),
    shared: joined(a.shared, b.shared),
  }

fn either(a: SpaceSummary, b: SpaceSummary) -> SpaceSummary =
  {
    state: merged(a.state, b.state),
    space: plus(a.space, b.space),
    recursive_space: plus(a.recursive_space, b.recursive_space),
    size: match ((a.size, b.size)) { (Some(x), Some(y)) -> Some(plus(x, y)), _ -> None },
    relation: Other,
    call_space: match ((a.call_space, b.call_space)) {
      (Some(x), Some(y)) -> Some(plus(x, y)),
      _ -> None,
    },
    holders: more_shared(sharing_of(a), sharing_of(b)),
    is_number: a.is_number && b.is_number,
    read: None,
    calls: max(a.calls, b.calls),
    recursive_call_arguments: a.recursive_call_arguments.concat(b.recursive_call_arguments),
    shared: joined(a.shared, b.shared),
  }

fn as_value(w: SpaceSummary, holders: Sharing, number: Bool) -> SpaceSummary =
  {
    ..w,
    size: None,
    relation: Other,
    call_space: None,
    holders: holders,
    is_number: number,
    read: None,
  }

fn walk(env: Env, st: State, c: Code) -> Result<SpaceSummary, String> / {abort.raise} =
  match c.node {
    CodeLiteral(l) -> Ok(literal(st, l)),
    CodeVariable(v) -> {
      let s = slot_at(st, v.slot);
      let moved = read_moved(env.moves, c.span) || s.is_number;
      Ok({
        ..empty_summary(st),
        size: s.size,
        relation: s.relation,
        call_space: s.fun,
        is_number: s.is_number,
        holders: if moved { s.holders } else { Shared },
        read: if moved { None } else { Some(v.slot) },
      })
    },
    NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) ->
      Ok({
        ..empty_summary(st),
        call_space: fun_named(env, String::of_bytes_lossy(fname)),
        holders: Shared,
      }),
    CodeLabel(_) -> Ok(empty_summary(st)),
    CodeUnary(u) -> match walk({ ..env, tail: false }, st, u.operand) {
      Err(reason) -> Err(reason),
      Ok(w) ->
        Ok({
          ..w,
          relation: Other,
          call_space: None,
          holders: Unshared,
          is_number: true,
          read: None,
        }),
    },
    CodeBinary(b) -> binary(env, st, b.operation, b.left_operand, b.right_operand),
    CodeIf(i) -> match walk({ ..env, tail: false }, st, i.cond) {
      Err(reason) -> Err(reason),
      Ok(cond) -> {
        let slots = |k: Int| slot_at(st, k).relation;
        let branch = |truth: Bool, c: Code| {
          let assumptions = assumed(slots, i.cond, truth);
          if possible(assumptions, env.missing_index) {
            Some(walk({ ..env, found: env.found.concat(assumptions) }, cond.state, c))
          } else { None }
        };
        match ((branch(true, i.then_branch), branch(false, i.else_branch))) {
          (Some(Err(reason)), _) -> Err(reason),
          (_, Some(Err(reason))) -> Err(reason),
          (Some(Ok(t)), Some(Ok(e))) -> Ok(then(cond, either(t, e))),
          (Some(Ok(t)), None) -> Ok(then(cond, t)),
          (None, Some(Ok(e))) -> Ok(then(cond, e)),
          (None, None) -> Ok(cond),
        }
      },
    },
    CodeBlock(b) -> block(env, st, b.statements, b.tail),
    CodeList(l) -> match walk_all(env, st, l.items, |_i: Int| Some(Shared)) {
      Err(reason) -> Err(reason),
      Ok(a) ->
        Ok({
          ..as_value(allocated(a.walked, constant), sharing_of_parts(a.all.map(sharing_of)), false),
          size: Some(constant),
        }),
    },
    CodeRecord(r) -> match walk_all(env, st, r.fields.map(|f: CodeField| f.value), |_i: Int|
        Some(Shared)) {
      Err(reason) -> Err(reason),
      Ok(a) ->
        Ok(as_value(allocated(a.walked, constant), sharing_of_parts(a.all.map(sharing_of)), false)),
    },
    CodeFieldRead(f) -> match walk({ ..env, tail: false }, st, f.base) {
      Err(reason) -> Err(reason),
      Ok(w) ->
        Ok(as_value({ ..w, state: mark_shared(w.state, w.read, OnlyPartsShared) }, Shared, false)),
    },
    CodeUpdate(u) -> match walk_all(env, st, u.sets.map(|f: CodeField| f.value), |_i: Int|
        Some(Shared)) {
      Err(reason) -> Err(reason),
      Ok(a) -> match walk({ ..env, tail: false }, a.walked.state, u.base) {
        Err(reason) -> Err(reason),
        Ok(b) -> {
          let base = { ..b, state: mark_shared(b.state, b.read, OnlyPartsShared) };
          Ok(
            as_value(
              allocated(then(a.walked, base), constant),
              sharing_of_parts(a.all.map(sharing_of).push(sharing_of(b))),
              false,
            ),
          )
        },
      },
    },
    CodeMatch(m) -> match walk({ ..env, tail: false }, st, m.scrutinee) {
      Err(reason) -> Err(reason),
      Ok(s) -> {
        let subject = { ..s, state: mark_shared(s.state, s.read, OnlyPartsShared) };
        let at = index_bound_of(|k: Int| slot_at(st, k).relation, m.scrutinee);
        match arms(env, subject, m.scrutinee, at, m.arms) {
          Err(reason) -> Err(reason),
          Ok(a) -> Ok(then(subject, a)),
        }
      },
    },
    CodeApply(a) -> application(env, st, a.function, a.args),
    CodeKnownLambda(_) ->
      panic(
        "the compiler creates known lambdas after the space analysis runs, so the analysis never sees one",
      ),
    CodePerform(p) -> if p.effect != b"abort" {
      Err("an operation run by a handler, which the `space` bound leaves out")
    } else {
      match walk_all(env, st, p.args, |_i: Int| Some(Shared)) {
        Err(reason) -> Err(reason),
        Ok(a) -> Ok(as_value(allocated(a.walked, constant), Shared, false)),
      }
    },
    CodeLambda(l) -> {
      let caught = l.captures.fold(st, |s: State, cap: Capture|
        if capture_moved(env.moves, l.at, cap.source) { s }
        else { mark_shared(s, Some(cap.source), Shared) });
      let fun = match lambda_walk(
          env,
          st,
          l.params,
          l.captures,
          l.body,
          range(0, l.params).map(|_i: Int| unknown_slot),
        ) {
        Ok(w) -> if w.calls > 0 { None } else { Some(w.space) },
        Err(_) -> None,
      };
      Ok({
        ..allocated(empty_summary(caught), constant),
        call_space: fun,
        holders: OnlyPartsShared,
      })
    },
    CodeSimulate(_) -> Err("a simulation, which the `space` bound leaves out"),
    CodeParallel(_) -> Err("a `parallel` block, which the `space` bound leaves out"),
    CodeHandle(_) -> Err("a handler, which the `space` bound leaves out"),
  }

fn literal(st: State, l: SourceLiteral) -> SpaceSummary =
  match l {
    LiteralInt(n) -> { ..empty_summary(st), size: Some(literal_size(n)), is_number: true },
    LiteralString(_) -> { ..empty_summary(st), size: Some(constant), holders: Shared },
    LiteralBytes(_) -> { ..empty_summary(st), size: Some(constant), holders: Shared },
    LiteralEmbedded(_, _) -> { ..empty_summary(st), size: Some(constant), holders: Shared },
    _ -> { ..empty_summary(st), is_number: true },
  }

fn walk_all(
  env: Env,
  st: State,
  cs: List<Code>,
  argument_sharing: (Int) -> Option<Sharing>,
) -> Result<{ walked: SpaceSummary, all: List<SpaceSummary> }, String> / {abort.raise} =
  range(0, cs.len()).fold(
    Ok({ walked: empty_summary(st), all: [] }),
    |accumulator: Result<{ walked: SpaceSummary, all: List<SpaceSummary> }, String>, i: Int|
      match accumulator {
        Err(_) -> accumulator,
        Ok(sofar) -> match cs.at(i) {
          None -> accumulator,
          Some(c) -> match walk({ ..env, tail: false }, sofar.walked.state, c) {
            Err(reason) -> Err(reason),
            Ok(w) -> {
              let after = match argument_sharing(i) {
                Some(h) -> mark_shared(w.state, w.read, h),
                None -> w.state,
              };
              Ok({ walked: then(sofar.walked, { ..w, state: after }), all: sofar.all.push(w) })
            },
          },
        },
      },
  )

fn binary(
  env: Env,
  st: State,
  operator: Bytes,
  left: Code,
  right: Code,
) -> Result<SpaceSummary, String> / {abort.raise} =
  match walk({ ..env, tail: false }, st, left) {
    Err(reason) -> Err(reason),
    Ok(l) -> {
      let short = operator == b"and" || operator == b"or";
      match walk({ ..env, tail: env.tail && short }, l.state, right) {
        Err(reason) -> Err(reason),
        Ok(r) -> if operator == b"concat" { appended(l, r) } else {
          Ok({
            ..as_value(then(l, r), Unshared, true),
            size: arithmetic(operator, l.size, r.size),
            relation: operation_relation(env.found, operator, l.relation, right, r.relation, left),
          })
        },
      }
    },
  }

fn appended(a: SpaceSummary, b: SpaceSummary) -> Result<SpaceSummary, String> =
  match if a.holders != Shared { b.size }
    else { match ((a.size, b.size)) { (Some(x), Some(y)) -> Some(plus(x, y)), _ -> None } } {
    None -> Err("an append where the size of an operand is unknown"),
    Some(p) ->
      Ok({
        ..as_value(allocated(then(a, { ..b, state: mark_shared(b.state, b.read, OnlyPartsShared) }), p), if is_unshared(a) && is_unshared(b) { Unshared } else { OnlyPartsShared }, false),
        size: arithmetic(b"concat", a.size, b.size),
      }),
  }

fn block(
  env: Env,
  st: State,
  statements: List<CodeStatement>,
  tail: Option<Code>,
) -> Result<SpaceSummary, String> / {abort.raise} =
  match statements.fold(
      Ok(empty_summary(st)),
      |accumulator: Result<SpaceSummary, String>, s: CodeStatement|
        match accumulator {
          Err(_) -> accumulator,
          Ok(sofar) -> match statement({ ..env, tail: false }, sofar.state, s) {
            Err(reason) -> Err(reason),
            Ok(w) -> Ok(then(sofar, w)),
          },
        },
    ) {
    Err(reason) -> Err(reason),
    Ok(ran) -> match tail {
      None -> Ok(as_value(ran, Unshared, true)),
      Some(t) -> match walk(env, ran.state, t) {
        Err(reason) -> Err(reason),
        Ok(w) -> Ok(then(ran, w)),
      },
    },
  }

fn statement(
  env: Env,
  st: State,
  s: CodeStatement,
) -> Result<SpaceSummary, String> / {abort.raise} =
  match s {
    CodeDo(d) -> walk(env, st, d.code),
    CodeLet(l) -> match walk(env, st, l.value) {
      Err(reason) -> Err(reason),
      Ok(w) -> Ok({ ..w, state: bind(mark_shared(w.state, w.read, Shared), l.slot, slot_of(w)) }),
    },
    CodeLetDestructure(l) -> match walk(env, st, l.value) {
      Err(reason) -> Err(reason),
      Ok(w) -> {
        let go = subject_is_freed(env, l.value, w);
        let before = mark_shared(w.state, w.read, OnlyPartsShared);
        let opened = {
          ..before,
          reusable_constructor: reuse_after(go, before.reusable_constructor, l.pattern),
        };
        Ok(
          allocated(
            { ..w, state: patterned(env, opened, l.pattern, w, go) },
            pattern_allocations(l.pattern),
          ),
        )
      },
    },
  }

fn subject_is_freed(env: Env, subject: Code, w: SpaceSummary) -> Bool =
  !env.lambda && read_moved(env.moves, subject.span) && !w.is_number && w.holders != Shared
    && (match subject.node { CodeVariable(_) -> true, _ -> false })

fn reuse_after(go: Bool, credit: Option<Bytes>, pattern: CodePattern) -> Option<Bytes> =
  if !go || credit != None { credit } else {
    match pattern {
      CodeConstructorPattern(c) -> if c.args.len() > 0 { Some(c.name) } else { None },
      _ -> None,
    }
  }

fn pattern_allocations(pattern: CodePattern) -> Polynomial =
  match pattern {
    CodeListPattern(l) ->
      l.items.fold(
        if l.rest == None { zero } else { constant },
        |accumulator: Polynomial, p: CodePattern| plus(accumulator, pattern_allocations(p)),
      ),
    CodeConstructorPattern(c) ->
      c.args.fold(zero, |accumulator: Polynomial, p: CodePattern|
        plus(accumulator, pattern_allocations(p))),
    CodeRecordPattern(r) ->
      r.fields.fold(zero, |accumulator: Polynomial, f: CodePatternField|
        plus(accumulator, pattern_allocations(f.pattern))),
    _ -> zero,
  }

fn patterned(
  env: Env,
  st: State,
  pattern: CodePattern,
  subject: SpaceSummary,
  go: Bool,
) -> State / {abort.raise} =
  bind_pattern(
    env,
    st,
    pattern,
    { ..slot_of(subject), holders: if go || subject.is_number { subject.holders } else { Shared } },
    if go && subject.holders == Unshared { Unshared } else { Shared },
  )

fn bind_pattern(
  env: Env,
  st: State,
  pattern: CodePattern,
  whole: Slot,
  parts: Sharing,
) -> State / {abort.raise} =
  match pattern {
    CodeBindingPattern(v) -> bind(st, v.slot, whole),
    CodeListPattern(l) -> {
      let heads = l.items.fold(st, |s: State, p: CodePattern|
        bind_pattern(env, s, p, part_slot(parts, false), parts));
      match l.rest {
        None -> heads,
        Some(r) ->
          bind_pattern(
            env,
            heads,
            r,
            {
              ..part_slot(parts, false),
              size: whole.size,
              relation: if l.items.len() == 0 { whole.relation }
              else { match whole.relation { Same(i) -> Part(i), Part(i) -> Part(i), _ -> Other } },
            },
            parts,
          ),
      }
    },
    CodeConstructorPattern(c) -> {
      let fields = match constructor(env.context, String::of_bytes_lossy(c.name)) {
        Some(k) -> k.variant.fields,
        None -> [],
      };
      range(0, c.args.len()).fold(st, |s: State, i: Int|
        match c.args.at(i) {
          Some(p) ->
            bind_pattern(
              env,
              s,
              p,
              part_slot(parts, match fields.at(i) { Some(t) -> is_number(t), None -> false }),
              parts,
            ),
          None -> s,
        })
    },
    CodeRecordPattern(r) ->
      r.fields.fold(st, |s: State, f: CodePatternField|
        bind_pattern(env, s, f.pattern, part_slot(parts, false), parts)),
    _ -> st,
  }

fn part_slot(parts: Sharing, number: Bool) -> Slot =
  {
    size: None,
    relation: Other,
    fun: None,
    holders: if number { Unshared } else { parts },
    is_number: number,
  }

fn never_matches(env: Env, subject: SpaceSummary, pattern: CodePattern) -> Bool =
  match ((env.empty, subject.relation, pattern)) {
    (Some(p), Same(i), CodeListPattern(l)) -> p == i && l.items.len() > 0,
    _ -> false,
  }

fn arms(
  outer: Env,
  subject: SpaceSummary,
  scrutinee: Code,
  at: Option<IndexBound>,
  xs: List<CodeArm>,
) -> Result<SpaceSummary, String> / {abort.raise} =
  match xs.fold(
      Ok({ guards: empty_summary(subject.state), taken: None }),
      |accumulator: Result<{ guards: SpaceSummary, taken: Option<SpaceSummary> }, String>, arm: CodeArm|
        match accumulator {
          Err(_) -> accumulator,
          Ok(sofar) -> if never_matches(outer, subject, arm.pattern)
              || (at != None && at == outer.missing_index && takes_some(arm.pattern)) {
            accumulator
          } else {
            let env = match at {
              Some(f) -> if takes_some(arm.pattern) { { ..outer, found: outer.found.push(f) } }
              else { outer },
              None -> outer,
            };
            let go = arm.guard == None && subject_is_freed(env, scrutinee, subject);
            let here = sofar.guards.state;
            let start = patterned(
              env,
              {
                ..here,
                reusable_constructor: reuse_after(go, here.reusable_constructor, arm.pattern),
              },
              arm.pattern,
              subject,
              go,
            );
            match match arm.guard {
                None -> Ok(allocated(empty_summary(start), pattern_allocations(arm.pattern))),
                Some(g) -> match walk({ ..env, tail: false }, start, g) {
                  Err(reason) -> Err(reason),
                  Ok(w) -> Ok(allocated(w, pattern_allocations(arm.pattern))),
                },
              } {
              Err(reason) -> Err(reason),
              Ok(g) -> match walk(env, g.state, arm.body) {
                Err(reason) -> Err(reason),
                Ok(b) -> {
                  let tried = then(sofar.guards, g);
                  let path = then(tried, b);
                  Ok({
                    guards: if arm.guard == None { sofar.guards } else { tried },
                    taken: Some(match sofar.taken { None -> path, Some(t) -> either(t, path) }),
                  })
                },
              },
            }
          },
        },
    ) {
    Err(reason) -> Err(reason),
    Ok(found) -> Ok(match found.taken { Some(w) -> w, None -> empty_summary(subject.state) }),
  }

fn application(
  env: Env,
  st: State,
  function: Code,
  args: List<Code>,
) -> Result<SpaceSummary, String> / {abort.raise} =
  match function.node {
    CodeVariable(f) -> {
      let k = f.slot;
      match walk_all(env, st, args, |_i: Int| Some(Shared)) {
        Err(reason) -> Err(reason),
        Ok(a) -> match slot_at(a.walked.state, k).fun {
          Some(p) -> Ok(as_value(allocated(a.walked, p), Shared, false)),
          None -> Err("a call of a function value whose space is unknown"),
        },
      }
    },
    NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) -> {
      let name = String::of_bytes_lossy(fname);
      if name == env.definition { called_back(env, st, args) }
      else if constructor(env.context, name) != None { built(env, st, fname, args) }
      else if env.context.claims.definitions.contains(name)
          && !by_entry(env.context, name, SpaceClause) { called(env, st, name, args) } else {
        match iterating_of(fname) {
          Some(it) -> callback_call(env, st, name, it, args),
          None -> builtin(env, st, name, args),
        }
      }
    },
    CodeLambda(l) -> match walk_all(env, st, args, |_i: Int| Some(Shared)) {
      Err(reason) -> Err(reason),
      Ok(a) -> match lambda_walk(
          env,
          a.walked.state,
          l.params,
          l.captures,
          l.body,
          a.all.map(|w: SpaceSummary| { ..slot_of(w), relation: Other, holders: sharing_of(w) }),
        ) {
        Err(reason) -> Err(reason),
        Ok(w) -> if w.calls > 0 { Err("a recursive call inside a function value") } else {
          Ok(as_value(allocated(a.walked, plus(constant, w.space)), sharing_of(w), w.is_number))
        },
      },
    },
    _ -> Err("a call of a computed function, which the `space` bound leaves out"),
  }

fn called_back(
  env: Env,
  st: State,
  args: List<Code>,
) -> Result<SpaceSummary, String> / {abort.raise} =
  if env.lambda { Err("a recursive call inside a function value") } else {
    match walk_all(env, st, args, |_i: Int| Some(Shared)) {
      Err(reason) -> Err(reason),
      Ok(a) -> {
        let frame = if env.tail { zero } else { constant };
        let shared = range(0, a.all.len()).fold(Map::new(), |m: Map<Int, Sharing>, i: Int|
          if at_or(env.numbers, i) { m } else {
            match a.all.at(i) {
              Some(w) -> if is_unshared(w) { m } else { m.insert(i, sharing_of(w)) },
              None -> m.insert(i, Shared),
            }
          });
        Ok(
          then(a.walked, {
            ..empty_summary(a.walked.state),
            space: frame,
            recursive_space: frame,
            holders: Shared,
            calls: 1,
            recursive_call_arguments: [a.all.map(|w: SpaceSummary| w.relation)],
            shared: shared,
          }),
        )
      },
    }
  }

fn built(
  env: Env,
  st: State,
  name: Bytes,
  args: List<Code>,
) -> Result<SpaceSummary, String> / {abort.raise} =
  match walk_all(env, st, args, |_i: Int| Some(Shared)) {
    Err(reason) -> Err(reason),
    Ok(a) -> {
      let now = a.walked.state;
      let reused = args.len() > 0 && now.reusable_constructor == Some(name);
      Ok(
        as_value(
          allocated(
            { ..a.walked, state: if reused { { ..now, reusable_constructor: None } } else { now } },
            if args.len() == 0 || reused { zero } else { constant },
          ),
          sharing_of_parts(a.all.map(sharing_of)),
          false,
        ),
      )
    },
  }

fn called(
  env: Env,
  st: State,
  name: String,
  args: List<Code>,
) -> Result<SpaceSummary, String> / {abort.raise} = {
  let numbers = numbers_of(env.context, name, args.len());
  let functions = functions_of(env.context, name, args.len());
  let numeric = returns_number(env.context, name);
  match walk_all(env, st, args, |_i: Int| if numeric { None } else { Some(Shared) }) {
    Err(reason) -> Err(reason),
    Ok(a) -> {
      let alone_all = range(0, a.all.len()).fold(true, |ok: Bool, i: Int|
        ok
          && (at_or(numbers, i) || at_or(functions, i)
          || (match a.all.at(i) { Some(w) -> is_unshared(w), None -> false })));
      match env.known.get(name) {
        None -> Err("`" ++ name ++ "` is part of a cycle of definitions that call each other"),
        Some(k) -> match space_use_for(k, alone_all) {
          Err(reason) -> Err(reason),
          Ok(s) -> match at_args(
              s.space,
              a.all.map(|w: SpaceSummary| w.size),
              a.all.map(|w: SpaceSummary| w.call_space),
            ) {
            Err(reason) -> Err(reason),
            Ok(q) ->
              Ok(
                as_value(
                  allocated(a.walked, q),
                  if numeric { Unshared } else { s.holders },
                  numeric,
                ),
              ),
          },
        },
      }
    },
  }
}

fn threaded(it: CallbackUse) -> Option<Int> =
  it.params.fold(None, |found: Option<Int>, h: CallbackArgument|
    match h { Accumulator(k) -> Some(k), _ -> found })

fn callback_parameter_slots(it: CallbackUse, all: List<SpaceSummary>, st: State) -> List<Slot> = {
  let arg = |i: Int| match all.at(i) { Some(w) -> w, None -> empty_summary(st) };
  it.params.map(|h: CallbackArgument|
    match h {
      Number -> number_slot,
      ExtractedFrom(k) ->
        {
          ..unknown_slot,
          holders: if !arg(k).is_number && arg(k).holders == Unshared { Unshared } else { Shared },
        },
      _ -> unknown_slot,
    })
}

fn threaded_calls(
  env: Env,
  st: State,
  all: List<SpaceSummary>,
  args: List<Code>,
  it: CallbackUse,
  slots: List<Slot>,
  k: Int,
) -> Result<{ first: { space: Polynomial, holders: Sharing, number: Bool }, rest: { space: Polynomial, holders: Sharing, number: Bool } }, String> / {abort.raise} = {
  let seed = match all.at(k) { Some(w) -> w, None -> empty_summary(st) };
  let parameter_slots = |accumulator: Slot|
    range(0, it.params.len()).map(|j: Int|
      match it.params.get(j) { Accumulator(_) -> accumulator, _ -> slots.get(j) });
  match callback(
      env,
      st,
      args,
      it.callback,
      parameter_slots({ ..slot_of(seed), relation: Other, holders: sharing_of(seed) }),
    ) {
    Err(reason) -> Err(reason),
    Ok(first) -> match callback_fixpoint(
        env,
        st,
        args,
        it.callback,
        parameter_slots,
        first.holders,
        seed.is_number && first.number,
        3,
      ) {
      Err(reason) -> Err(reason),
      Ok(rest) -> Ok({ first: first, rest: rest }),
    },
  }
}

fn fun_named(env: Env, name: String) -> Option<Polynomial> =
  if constructor(env.context, name) != None { Some(constant) } else {
    match env.known.get(name) {
      Some(k) -> match k.any_arguments {
        Ok(s) -> match at_args(s.space, [], []) { Ok(q) -> Some(q), Err(_) -> None },
        Err(_) -> None,
      },
      None -> None,
    }
  }

fn lambda_walk(
  env: Env,
  outer: State,
  params: Int,
  captures: List<Capture>,
  body: Code,
  slots: List<Slot>,
) -> Result<SpaceSummary, String> / {abort.raise} = {
  let start = range(0, params).fold(
    { slots: [], reusable_constructor: None },
    |s: State, i: Int| bind(s, i, match slots.at(i) { Some(x) -> x, None -> unknown_slot }),
  );
  let captured = captures.fold(start, |s: State, cap: Capture| {
    let from = slot_at(outer, cap.source);
    bind(s, cap.destination, { ..from, holders: if from.is_number { Unshared } else { Shared } })
  });
  walk({ ..env, lambda: true, tail: false, empty: None, missing_index: None }, captured, body)
}

const builtin_result_kinds: Map<String, ResultKind> =
  natives.fold(Map::new(), |m: Map<String, ResultKind>, b: Builtin|
    m.insert(String::of_bytes_lossy(b.name), match b.scheme.ty {
      FunctionType(f) -> result_kind_of(f.return_type),
      other -> result_kind_of(other),
    }))

fn result_kind_of(t: Type) -> ResultKind =
  match t {
    NamedType(c) -> if c.args.len() == 0 && is_number_name(String::of_bytes_lossy(c.name)) {
      NumberResult
    } else if c.name == b"Option" && c.args.len() == 1 {
      match c.args.at(0) {
        Some(x) -> if result_kind_of(x) == NumberResult { OptionNumberResult } else { ValueResult },
        None -> ValueResult,
      }
    } else { ValueResult },
    RecordType(fs) -> if fs.len() == 0 { NumberResult } else { ValueResult },
    _ -> ValueResult,
  }

fn is_number_name(n: String) -> Bool =
  [
    "Int",
    "Bool",
    "Float",
    "Char",
    "Decimal",
    "Unit",
    "Ordering",
    "U8",
    "U16",
    "U32",
    "U64",
    "U128",
    "I8",
    "I16",
    "I32",
    "I64",
    "I128",
  ].contains(
    n,
  )

fn is_number(t: Sort) -> Bool =
  match t {
    NamedSort(n, args) -> args.len() == 0 && is_number_name(n),
    RecordSort(fs) -> fs.len() == 0,
    _ -> false,
  }

fn numbers_of(context: Context, definition: String, n: Int) -> List<Bool> =
  params_are(context, definition, n, is_number)

fn functions_of(context: Context, definition: String, n: Int) -> List<Bool> =
  params_are(context, definition, n, |t: Sort|
    match t { FunctionSort(_, _, _) -> true, _ -> false })

fn params_are(context: Context, definition: String, n: Int, is: (Sort) -> Bool) -> List<Bool> =
  match signature(context, definition) {
    Some(s) -> match s.ty {
      FunctionSort(ps, _, _) ->
        range(0, n).map(|i: Int| match ps.at(i) { Some(t) -> is(t), None -> false }),
      _ -> range(0, n).map(|_i: Int| false),
    },
    None -> range(0, n).map(|_i: Int| false),
  }

fn returns_number(context: Context, definition: String) -> Bool =
  match signature(context, definition) {
    Some(s) -> match s.ty { FunctionSort(_, ret, _) -> is_number(ret), other -> is_number(other) },
    None -> false,
  }

fn at_or(xs: List<Bool>, i: Int) -> Bool = match xs.at(i) { Some(x) -> x, None -> false }

fn updates_first_argument(name: String) -> Bool =
  name == "List::push" || name == "List::set" || name == "Array::set" || name == "Columns::set"
    || name == "Map::insert"
    || name == "Map::remove"
    || name == "Map::pop_first"
    || name == "Map::pop_last"
    || name == "Map::split"

fn result_shares_parts(name: String) -> Bool =
  name == "List::at" || name == "Array::at" || name == "Array::get" || name == "Columns::at"
    || name == "Columns::get"
    || name == "Map::get"
    || name == "Map::first"
    || name == "Map::last"
    || name == "Map::floor"
    || name == "Map::ceiling"
    || name == "Map::below"
    || name == "Map::above"
    || name == "Map::range"
    || name == "Map::keys"
    || name == "Map::values"
    || name == "Map::entries"
    || name == "Array::of_list"
    || name == "Array::to_list"
    || name == "Columns::of_list"
    || name == "Columns::to_list"

fn sharing_after_call(name: String, result: ResultKind, i: Int) -> Option<Sharing> =
  if result != ValueResult || name == "Bytes::concat" || name == "String::concat"
      || name == "Bytes::slice"
      || name == "String::slice" { None }
  else if i == 0 && updates_first_argument(name) { None }
  else if i == 0 && result_shares_parts(name) { Some(OnlyPartsShared) }
  else { Some(Shared) }

fn builtin(
  env: Env,
  st: State,
  name: String,
  args: List<Code>,
) -> Result<SpaceSummary, String> / {abort.raise} =
  match env.results.get(name) {
    None -> Err("`" ++ name ++ "` has no body in the program, so its space cannot be analyzed"),
    Some(result) -> match walk_all(env, st, args, |i: Int| sharing_after_call(name, result, i)) {
      Err(reason) -> Err(reason),
      Ok(a) -> match contained_by(name, result, a.walked.state, a.all) {
        Err(reason) -> Err(reason),
        Ok(m) ->
          Ok({ ..as_value(allocated(a.walked, m.space), m.holders, m.is_number), size: m.size }),
      },
    },
  }

type Allocation = { space: Polynomial, holders: Sharing, is_number: Bool, size: Option<Polynomial> }

fn object(
  space_bound: Polynomial,
  holders: Sharing,
  size: Option<Polynomial>,
) -> Result<Allocation, String> =
  Ok({ space: space_bound, holders: holders, is_number: false, size: size })

fn over(name: String, s: Option<Polynomial>, extra: Polynomial) -> Result<Polynomial, String> =
  match s {
    Some(p) -> Ok(plus(p, extra)),
    None -> Err("`" ++ name ++ "` over a value whose size is unknown"),
  }

fn updated(
  name: String,
  first: SpaceSummary,
  extra: Polynomial,
  parts: Sharing,
  size: Option<Polynomial>,
) -> Result<Allocation, String> =
  if !first.is_number && first.holders != Shared {
    object(extra, sharing_of_parts([first.holders, parts]), size)
  } else {
    match over(name, first.size, extra) {
      Ok(p) -> object(p, OnlyPartsShared, size),
      Err(reason) -> Err(reason),
    }
  }

fn as_large(
  name: String,
  first: SpaceSummary,
  extra: Polynomial,
  holders: Sharing,
) -> Result<Allocation, String> =
  match over(name, first.size, extra) {
    Ok(p) -> object(p, holders, first.size),
    Err(reason) -> Err(reason),
  }

fn iterated(
  env: Env,
  st: State,
  args: List<Code>,
  times: Option<Polynomial>,
  position: Int,
  params: List<Slot>,
) -> Result<Polynomial, String> / {abort.raise} =
  match times {
    None -> Err("an iteration over a value whose size is unknown"),
    Some(n) -> match callback(env, st, args, position, params) {
      Err(reason) -> Err(reason),
      Ok(cb) -> product(n, cb.space),
    },
  }

const number_slot: Slot = { ..unknown_slot, holders: Unshared, is_number: true }

fn callback_call(
  env: Env,
  st: State,
  name: String,
  it: CallbackUse,
  args: List<Code>,
) -> Result<SpaceSummary, String> / {abort.raise} = {
  let numeric = match env.results.get(name) {
    Some(a) -> a != ValueResult,
    None -> returns_number(env.context, name),
  };
  let shares_parts = it.result == Mapped || it.result == Filtered || it.result == Folded;
  let argument_sharing = |i: Int|
    if numeric || it.result == Updated(i) { None }
    else if shares_parts && it.iterated_parameters.at(0) == Some(i) { Some(OnlyPartsShared) }
    else { Some(Shared) };
  match walk_all(env, st, args, argument_sharing) {
    Err(reason) -> Err(reason),
    Ok(a) -> {
      let now = a.walked.state;
      let arg = |i: Int| match a.all.at(i) { Some(w) -> w, None -> empty_summary(now) };
      let slots = callback_parameter_slots(it, a.all, now);
      let m = match it.result {
        Folded -> folded(env, now, a.all, args, it, slots),
        result -> match iterated(
            env,
            now,
            args,
            callback_calls(it, a.all.map(|w: SpaceSummary| w.size)),
            it.callback,
            slots,
          ) {
          Err(reason) -> Err(reason),
          Ok(p) -> match result {
            Updated(k) -> updated(name, arg(k), plus(constant, p), OnlyPartsShared, arg(k).size),
            UnknownReturn -> if numeric {
              Ok({ space: p, holders: Unshared, is_number: true, size: None })
            } else { object(plus(constant, p), Shared, None) },
            _ -> match it.iterated_parameters.at(0) {
              Some(k) -> as_large(name, arg(k), p, OnlyPartsShared),
              None -> Err("`" ++ name ++ "` walks nothing"),
            },
          },
        },
      };
      match m {
        Err(reason) -> Err(reason),
        Ok(x) ->
          Ok({ ..as_value(allocated(a.walked, x.space), x.holders, x.is_number), size: x.size }),
      }
    },
  }
}

fn contained_by(
  name: String,
  result: ResultKind,
  st: State,
  all: List<SpaceSummary>,
) -> Result<Allocation, String> = {
  let arg = |i: Int| match all.at(i) { Some(w) -> w, None -> empty_summary(st) };
  let grown = match arg(0).size { Some(s) -> Some(plus(s, constant)), None -> None };
  if result == NumberResult {
    Ok({
      space: zero,
      holders: Unshared,
      is_number: true,
      size: if is_length(name) { arg(0).size } else { None },
    })
  } else if result == OptionNumberResult { object(constant, Unshared, None) }
  else if name == "List::push" { updated(name, arg(0), constant, sharing_of(arg(1)), grown) }
  else if name == "Map::insert" {
    updated(
      name,
      arg(0),
      constant,
      sharing_of_parts([sharing_of(arg(1)), sharing_of(arg(2))]),
      grown,
    )
  } else if name == "List::set" || name == "Array::set" || name == "Columns::set" {
    updated(name, arg(0), zero, sharing_of(arg(2)), arg(0).size)
  } else if name == "Map::remove" { updated(name, arg(0), constant, Unshared, arg(0).size) }
  else if name == "Map::pop_first" || name == "Map::pop_last" {
    updated(name, arg(0), constant, OnlyPartsShared, None)
  } else if name == "Map::split" { as_large(name, arg(0), constant, OnlyPartsShared) }
  else if name == "Bytes::concat" || name == "String::concat" {
    match appended(arg(0), arg(1)) {
      Err(reason) -> Err(reason),
      Ok(w) -> Ok({ space: w.space, holders: w.holders, is_number: false, size: w.size }),
    }
  } else if name == "range" {
    match ((arg(0).size, arg(1).size)) {
      (Some(lo), Some(hi)) -> object(plus(lo, hi), Unshared, Some(plus(lo, hi))),
      _ -> Err("`range` over a value whose size is unknown"),
    }
  } else if name == "Map::new" { object(constant, Unshared, Some(constant)) }
  else if name == "Array::new" || name == "Columns::new" {
    as_large(name, arg(0), zero, sharing_of_parts([sharing_of(arg(1))]))
  } else if name == "Array::of_list" || name == "Array::to_list" || name == "Columns::of_list"
      || name == "Columns::to_list"
      || name == "Map::keys"
      || name == "Map::values"
      || name == "Map::entries"
      || name == "Map::of_entries"
      || name == "Map::range" { as_large(name, arg(0), constant, OnlyPartsShared) }
  else if name == "Map::merge" {
    match ((arg(0).size, arg(1).size)) {
      (Some(x), Some(y)) -> object(plus(plus(x, y), constant), OnlyPartsShared, Some(plus(x, y))),
      _ -> Err("`Map::merge` over a value whose size is unknown"),
    }
  } else if name == "List::at" || name == "Array::at" || name == "Columns::at" || name == "Map::get"
      || name == "Map::first"
      || name == "Map::last"
      || name == "Map::floor"
      || name == "Map::ceiling"
      || name == "Map::below"
      || name == "Map::above"
      || name == "checked_add"
      || name == "checked_sub"
      || name == "checked_mul"
      || name == "checked_neg"
      || name == "Columns::get" { object(constant, OnlyPartsShared, None) }
  else if name == "Array::get" { object(zero, Shared, None) }
  else { valued_by(name, st, all) }
}

fn valued_by(name: String, st: State, all: List<SpaceSummary>) -> Result<Allocation, String> = {
  let arg = |i: Int| match all.at(i) { Some(w) -> w, None -> empty_summary(st) };
  if name == "String::chars" || name == "String::of_chars" || name == "String::trim"
      || name == "Bytes::of_string"
      || name == "String::of_bytes"
      || name == "String::of_bytes_lossy"
      || name == "String::slice" { as_large(name, arg(0), constant, Unshared) }
  else if name == "String::split" || name == "Bytes::split" {
    match over(name, arg(0).size, constant) {
      Ok(p) -> object(p, Unshared, Some(p)),
      Err(reason) -> Err(reason),
    }
  } else if name == "Bytes::slice" { object(constant, Shared, arg(0).size) }
  else if name == "Int::to_string" || name == "Float::to_string" || name == "Decimal::to_string"
      || name == "U128::to_string"
      || name == "I128::to_string"
      || name == "Bytes::blake3"
      || name == "digest" { object(constant, Unshared, Some(constant)) }
  else if name == "byte_of_int" { object(zero, Shared, Some(constant)) }
  else if name == "min" || name == "max" {
    Ok({
      space: zero,
      holders: more_shared(sharing_of(arg(0)), sharing_of(arg(1))),
      is_number: arg(0).is_number && arg(1).is_number,
      size: None,
    })
  } else if name == "observe" {
    Ok({ space: zero, holders: sharing_of(arg(0)), is_number: arg(0).is_number, size: arg(0).size })
  } else if name == "numeric_of_int" || name == "wrap_add" || name == "wrap_sub"
      || name == "wrap_mul"
      || name == "saturating_add"
      || name == "saturating_sub"
      || name == "saturating_mul"
      || name == "rotr"
      || name == "rotl" { Ok({ space: zero, holders: Unshared, is_number: true, size: None }) }
  else if name == "panic" { object(constant, Shared, None) }
  else { Err("`" ++ name ++ "` is a function that the `space` bound leaves out") }
}

fn folded(
  env: Env,
  st: State,
  all: List<SpaceSummary>,
  args: List<Code>,
  it: CallbackUse,
  slots: List<Slot>,
) -> Result<Allocation, String> / {abort.raise} =
  match ((threaded(it), callback_calls(it, all.map(|w: SpaceSummary| w.size)))) {
    (_, None) -> Err("an iteration over a value whose size is unknown"),
    (None, _) -> Err("a fold whose callback receives no accumulated value"),
    (Some(k), Some(n)) -> {
      let seed = match all.at(k) { Some(w) -> w, None -> empty_summary(st) };
      match threaded_calls(env, st, all, args, it, slots, k) {
        Err(reason) -> Err(reason),
        Ok(t) -> match product(n, t.rest.space) {
          Err(reason) -> Err(reason),
          Ok(p) ->
            Ok({
              space: plus(t.first.space, p),
              holders: more_shared(sharing_of(seed), t.rest.holders),
              is_number: seed.is_number && t.first.number,
              size: None,
            }),
        },
      }
    },
  }

fn callback_fixpoint(
  env: Env,
  st: State,
  args: List<Code>,
  position: Int,
  parameter_slots: (Slot) -> List<Slot> / {abort.raise},
  holders: Sharing,
  number: Bool,
  tries: Int,
) -> Result<{ space: Polynomial, holders: Sharing, number: Bool }, String> / {abort.raise} =
  match callback(
      env,
      st,
      args,
      position,
      parameter_slots({ ..unknown_slot, holders: holders, is_number: number }),
    ) {
    Err(reason) -> Err(reason),
    Ok(cb) -> if more_shared(holders, cb.holders) == holders || tries <= 0 {
      Ok({ ..cb, holders: more_shared(holders, cb.holders) })
    } else {
      callback_fixpoint(
        env,
        st,
        args,
        position,
        parameter_slots,
        more_shared(holders, cb.holders),
        number,
        tries - 1,
      )
    },
  }

fn callback(
  env: Env,
  outer: State,
  args: List<Code>,
  position: Int,
  params: List<Slot>,
) -> Result<{ space: Polynomial, holders: Sharing, number: Bool }, String> / {abort.raise} =
  match args.at(position) {
    None -> Err("a builtin called without its callback"),
    Some(cb) -> match cb.node {
      CodeLambda(l) -> match lambda_walk(env, outer, l.params, l.captures, l.body, params) {
        Err(reason) -> Err(reason),
        Ok(w) -> if w.calls > 0 { Err("a recursive call inside an iteration") }
        else { Ok({ space: w.space, holders: sharing_of(w), number: w.is_number }) },
      },
      CodeVariable(f) -> {
        let k = f.slot;
        match slot_at(outer, k).fun {
          Some(p) -> Ok({ space: p, holders: Shared, number: false }),
          None -> Err("a callback whose space is unknown"),
        }
      },
      NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) -> {
        let name = String::of_bytes_lossy(fname);
        if constructor(env.context, name) != None {
          Ok({ space: constant, holders: OnlyPartsShared, number: false })
        } else if name == env.definition { Err("a recursive call inside an iteration") } else {
          match env.known.get(name) {
            None -> Err("a callback, which the `space` bound leaves out"),
            Some(k) -> match k.any_arguments {
              Err(reason) -> Err(reason),
              Ok(s) -> match at_args(
                  s.space,
                  params.map(|_p: Slot| None),
                  params.map(|_p: Slot| None),
                ) {
                Err(reason) -> Err(reason),
                Ok(q) ->
                  Ok({ space: q, holders: s.holders, number: returns_number(env.context, name) }),
              },
            },
          }
        }
      },
      _ -> Err("a callback, which the `space` bound leaves out"),
    },
  }

fn shown(source: Bytes, definition: String) -> Result<Bool, String> / {abort.raise} =
  within_clause(
    context_owning([{ name: b"m", source_text: source }], |_m: Bytes| true),
    "m." ++ definition,
  )

fn within_clause(context: Context, name: String) -> Result<Bool, String> / {abort.raise} =
  match context.claims.definitions.get(name) {
    None -> panic("the fixture has no definition with that name"),
    Some(d) -> match d.spec.filter(|c: ClaimClause| c.kind == SpaceClause) {
      [c, ..] -> {
        let b = c.clause.code;
        match space_clause_bound(b, d.params, d.space_parameters) {
          None -> Err("the `space` clause is not in a form the analysis can use"),
          Some(bind_pattern) -> match space_bound(context, name) {
            Err(reason) -> Err(reason),
            Ok(p) -> Ok(dominated_space(p, bind_pattern)),
          },
        }
      },
      [] -> panic("a `space` clause"),
    },
  }

test "a fold that builds nothing needs no space, and a map needs space for a list as long as the list it maps" {
  assert_eq(
    shown(b"fn f(xs: List<Int>) -> Int space 0 = xs.fold(0, |a: Int, x: Int| a + x)", "f"),
    Ok(true),
  );
  assert_eq(
    shown(b"fn f(xs: List<Int>) -> List<Int> space 0 = xs.map(|x: Int| x + 1)", "f"),
    Ok(false),
  );
  assert_eq(
    shown(b"fn f(xs: List<Int>) -> List<Int> space xs.len() = xs.map(|x: Int| x + 1)", "f"),
    Ok(true),
  )
}

test "a recursive function that passes a changed function parameter to itself has space no `space` bound on that parameter accounts for" {
  let f = b"fn copier(y: Int) -> Int = [y, y, y].len()\nfn f(xs: List<Int>, i: Int, g: (Int) -> Int space s, acc: Int) -> Int space xs.len() * s = if i >= xs.len() { acc } else { f(xs, i + 1, copier, acc + g(i)) }\n";
  assert_eq(
    shown(f, "f"),
    Err("`m.f` changes a parameter when it calls itself, and its space grows with that parameter"),
  );
  assert(
    shown(f.concat(b"fn h(xs: List<Int>) -> Int space 0 = f(xs, 0, |y: Int| y + 1, 0)\n"), "h")
      != Ok(true),
    None,
  )
}

test "a function parameter's `space` name stands for the space that each call of that function uses" {
  let each = |bind_pattern: Bytes|
    shown(
      Bytes::concat_all([
        b"fn each(xs: List<Int>, g: (Int) -> List<Int> space s) -> List<List<Int>> space ",
        bind_pattern,
        b" = xs.map(g)",
      ]),
      "each",
    );
  assert_eq(each(b"xs.len() + xs.len() * s"), Ok(true));
  assert_eq(each(b"xs.len() * s"), Ok(false));
  assert_eq(each(b"xs.len()"), Ok(false));
  assert_eq(
    shown(
      b"fn each(xs: List<Int>, g: (Int) -> List<Int>) -> List<List<Int>> space xs.len() = xs.map(g)",
      "each",
    ),
    Err("a callback whose space is unknown"),
  );
  let walk = b"fn walk(xs: List<Int>, i: Int, g: (Int) -> List<Int> space s, acc: List<List<Int>>) -> List<List<Int>> = if i >= xs.len() { acc } else { walk(xs, i + 1, g, acc.push(g(i))) }\n";
  let wrapped = |bind_pattern: Bytes|
    shown(
      Bytes::concat_all([
        walk,
        b"fn f(xs: List<Int>) -> List<List<Int>> space ",
        bind_pattern,
        b" = walk(xs, 0, |x: Int| [x], [])",
      ]),
      "f",
    );
  assert_eq(wrapped(b"xs.len()"), Ok(true));
  assert_eq(wrapped(b"1"), Ok(false))
}

test "a call of the prelude's `map` on a list that another variable also uses needs the space its `space` bound states" {
  let context = |bind_pattern: Bytes|
    context_owning(
      [
        {
          name: b"m",
          source_text: Bytes::concat_all([
            b"fn f(xs: List<Int>) -> Int space ",
            bind_pattern,
            b" = xs.map(|x: Int| [x]).len() + xs.len()\n",
          ]),
        },
      ],
      |m: Bytes| m == b"m",
    );
  assert_eq(within_clause(context(b"xs.len()"), "m.f"), Ok(true));
  assert_eq(within_clause(context(b"1"), "m.f"), Ok(false))
}

fn chain_source() -> Bytes = b"type Chain = | Link(Int, Chain) | End\n"

test "a tail call that builds one new value for each value it matched needs no extra space, but a tail call that builds two new values needs more" {
  assert_eq(
    shown(
      chain_source().concat(
        b"fn rev(xs: Chain, acc: Chain) -> Chain space 0 = match xs { End -> acc, Link(x, rest) -> rev(rest, Link(x, acc)) }",
      ),
      "rev",
    ),
    Ok(true),
  );
  assert_eq(
    shown(
      chain_source().concat(
        b"fn twice(xs: Chain, acc: Chain) -> Chain space 0 = match xs { End -> acc, Link(x, rest) -> twice(rest, Link(x, Link(x, acc))) }",
      ),
      "twice",
    ),
    Err(
      "`m.twice` does not always call itself with the tail of one list parameter, or with an index that moves toward a fixed limit",
    ),
  );
  assert_eq(
    shown(
      chain_source().concat(
        b"fn other(a: Chain, b: Chain) -> Chain = a\nfn kept(xs: Chain, acc: Chain) -> Chain space 0 = match xs { End -> acc, Link(x, rest) -> kept(rest, Link(x, other(acc, xs))) }",
      ),
      "kept",
    ),
    Err(
      "`m.kept` does not always call itself with the tail of one list parameter, or with an index that moves toward a fixed limit",
    ),
  )
}

test "updating an array that nothing else uses is done in place, and updating one that is read afterward makes a copy" {
  assert_eq(
    shown(
      b"fn fill(a: Array<Int>, i: Int, n: Int) -> Array<Int> / {abort.raise} space 0 = if i >= n { a } else { fill(a.set(i, 0), i + 1, n) }",
      "fill",
    ),
    Ok(true),
  );
  let copy = |bind_pattern: Bytes|
    shown(
      Bytes::concat_all([
        b"fn copy(a: Array<Int>) -> Int / {abort.raise} space ",
        bind_pattern,
        b" = { let b = a.set(0, 1); a.len() + b.len() }",
      ]),
      "copy",
    );
  assert_eq(copy(b"0"), Ok(false));
  assert_eq(copy(b"a.len()"), Ok(true))
}

test "a recursive call that is not a tail call needs a stack frame for each call" {
  let count = |bind_pattern: Bytes|
    shown(
      Bytes::concat_all([
        b"fn count(xs: List<Int>) -> Int space ",
        bind_pattern,
        b" = match xs { [] -> 0, [_, ..rest] -> 1 + count(rest) }",
      ]),
      "count",
    );
  assert_eq(count(b"0"), Ok(false));
  assert_eq(count(b"xs.len()"), Ok(true))
}

test "a recursive call with an increasing index, made after `List::at` finds an element, needs one stack frame for each element" {
  let count = |bind_pattern: Bytes|
    shown(
      Bytes::concat_all([
        b"fn count(xs: List<Int>, i: Int) -> Int space ",
        bind_pattern,
        b" = match xs.at(i) { Some(_) -> 1 + count(xs, i + 1), None -> 0 }",
      ]),
      "count",
    );
  assert_eq(count(b"0"), Ok(false));
  assert_eq(count(b"xs.len()"), Ok(true))
}

test "a recursive call with an index that increases up to a limit needs a stack frame for each step" {
  let count = b"fn count(xs: List<Int>, i: Int) -> Int = if i >= xs.len() { 0 } else { 1 + count(xs, i + 1) }\n";
  let bind_pattern = |b: Bytes|
    shown(
      Bytes::concat_all([count, b"fn f(xs: List<Int>) -> Int space ", b, b" = count(xs, 0)"]),
      "f",
    );
  assert_eq(bind_pattern(b"0"), Ok(false));
  assert_eq(bind_pattern(b"xs.len()"), Ok(true))
}

test "a fold copies its starting list only on the first call, and only when another variable still uses that list" {
  let grow = b"fn grow(xs: List<Int>, ys: List<Int>) -> List<Int> space ys.len() = ys.fold(xs, |a: List<Int>, y: Int| a.push(y))\n";
  assert_eq(shown(grow, "grow"), Ok(true));
  let shared = |bind_pattern: Bytes|
    shown(
      Bytes::concat_all([
        grow,
        b"fn shared(xs: List<Int>, ys: List<Int>) -> Int space ",
        bind_pattern,
        b" = grow(xs, ys).len() + xs.len()",
      ]),
      "shared",
    );
  assert_eq(shared(b"ys.len()"), Ok(false));
  assert_eq(shared(b"xs.len() + ys.len()"), Ok(true))
}

test "a call to another package's definition uses the space its `space` bound states, when no other variable uses the arguments" {
  let context = context_owning(
    [
      {
        name: b"base",
        source_text: b"pub fn ones(xs: List<Int>) -> List<Int> space xs.len() = xs.map(|_x: Int| 1)\n",
      },
      {
        name: b"app",
        source_text: b"import base\nfn f(xs: List<Int>) -> List<Int> = base::ones(xs)\nfn g(xs: List<Int>) -> Int = base::ones(xs).len() + xs.len()\n",
      },
    ],
    |m: Bytes| m == b"app",
  );
  assert_eq(space_bound(context, "app.f"), Ok([Map::new().insert(0, 1)]));
  assert_eq(
    space_bound(context, "app.g"),
    Err(
      "`base.ones` may be called with arguments shared with other values, and its `space` bound assumes arguments that are not shared",
    ),
  )
}
