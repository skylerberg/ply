//! `sort` — what the prover reasons a value's type with: `domain.Sort`, with a record's fields in name
//! order so two spellings of one record type are one sort.

import domain (Sort, SortVariable, FunctionSort, RecordSort, NamedSort, named_sort)

pub fn int_sort() -> Sort = named_sort("Int")

pub fn bool_sort() -> Sort = named_sort("Bool")

pub fn string_sort() -> Sort = named_sort("String")

pub fn bytes_sort() -> Sort = named_sort("Bytes")

pub fn unit_sort() -> Sort = named_sort("Unit")

pub fn float_sort() -> Sort = named_sort("Float")

pub fn decimal_sort() -> Sort = named_sort("Decimal")

pub fn list_sort(elem: Sort) -> Sort = NamedSort("List", [elem])

pub fn option_sort(elem: Sort) -> Sort = NamedSort("Option", [elem])

/// A named type of no arguments called `name`.
pub fn is_named_sort(ty: Sort, name: String) -> Bool =
  match ty { NamedSort(n, args) -> n == name && args.len() == 0, _ -> false }

pub fn list_elem(ty: Sort) -> Option<Sort> =
  match ty {
    NamedSort(n, args) -> if n == "List" && args.len() == 1 { args.at(0) } else { None },
    _ -> None,
  }

pub fn field_sort(ty: Sort, name: String) -> Option<Sort> =
  match ty {
    RecordSort(fields) ->
      fields.fold(None, |acc: Option<Sort>, f: { name: String, ty: Sort }|
        match acc { Some(_) -> acc, None -> if f.name == name { Some(f.ty) } else { None } }),
    _ -> None,
  }

pub fn field_names(ty: Sort) -> Option<List<String>> =
  match ty {
    RecordSort(fields) -> Some(fields.map(|f: { name: String, ty: Sort }| f.name)),
    _ -> None,
  }

/// Every record's fields in name order, at every depth; a later field of a name replaces an earlier.
pub fn canonical(ty: Sort) -> Sort =
  match ty {
    SortVariable(v) -> SortVariable(v),
    NamedSort(n, args) -> NamedSort(n, args.map(canonical)),
    FunctionSort(params, ret, pure) -> FunctionSort(params.map(canonical), canonical(ret), pure),
    RecordSort(fields) ->
      record_of(fields.map(|f: { name: String, ty: Sort }| { name: f.name, ty: canonical(f.ty) })),
  }

/// Sorted by name, each name once.
pub fn record_of(fields: List<{ name: String, ty: Sort }>) -> Sort =
  RecordSort(
    fields.fold([], |acc: List<{ name: String, ty: Sort }>, f: { name: String, ty: Sort }|
      insert_by_name(acc, f)),
  )

fn insert_by_name(
  sorted: List<{ name: String, ty: Sort }>,
  f: { name: String, ty: Sort },
) -> List<{ name: String, ty: Sort }> = {
  let before = sorted.filter(|g: { name: String, ty: Sort }| compare(g.name, f.name) == Less);
  let after = sorted.filter(|g: { name: String, ty: Sort }| compare(g.name, f.name) == Greater);
  after.fold(
    before.push(f),
    |acc: List<{ name: String, ty: Sort }>, g: { name: String, ty: Sort }| acc.push(g),
  )
}

/// Each variable once, in the order they first appear.
pub fn vars(t: Sort, seen: List<Int>) -> List<Int> =
  match t {
    SortVariable(v) -> if seen.fold(false, |found: Bool, s: Int| found || s == v) { seen }
    else { seen.push(v) },
    NamedSort(_, args) -> args.fold(seen, |acc: List<Int>, a: Sort| vars(a, acc)),
    FunctionSort(params, ret, _) ->
      vars(ret, params.fold(seen, |acc: List<Int>, p: Sort| vars(p, acc))),
    RecordSort(fields) ->
      fields.fold(seen, |acc: List<Int>, f: { name: String, ty: Sort }| vars(f.ty, acc)),
  }

/// `args` in place of the variables they number; a variable past them stays.
pub fn substituted(t: Sort, args: List<Sort>) -> Sort =
  match t {
    SortVariable(v) -> match args.at(v) { Some(a) -> a, None -> SortVariable(v) },
    NamedSort(n, xs) -> NamedSort(n, xs.map(|x: Sort| substituted(x, args))),
    FunctionSort(params, ret, pure) ->
      FunctionSort(params.map(|p: Sort| substituted(p, args)), substituted(ret, args), pure),
    RecordSort(fields) ->
      RecordSort(
        fields.map(|f: { name: String, ty: Sort }| { name: f.name, ty: substituted(f.ty, args) }),
      ),
  }

pub fn is_pure_fn(ty: Sort) -> Bool = match ty { FunctionSort(_, _, pure) -> pure, _ -> false }

/// Where the variables of a declaration or of another definition's signature are numbered once one
/// is in a claim: past every variable a claim's binders number, so none reads as the claim's own.
pub fn foreign_base() -> Int = 1000000

/// `t` with each variable numbered past `foreign_base`.
pub fn foreign(t: Sort) -> Sort =
  match t {
    SortVariable(v) -> SortVariable(foreign_base() + v),
    NamedSort(n, xs) -> NamedSort(n, xs.map(foreign)),
    FunctionSort(params, ret, pure) -> FunctionSort(params.map(foreign), foreign(ret), pure),
    RecordSort(fields) ->
      RecordSort(fields.map(|f: { name: String, ty: Sort }| { name: f.name, ty: foreign(f.ty) })),
  }

/// What a function of `params` answering `ret` answers, given its arguments' sorts: `ret` with each
/// variable the parameters settle in place. A variable left is the function's own, which a foreign
/// signature numbers apart from the claim's.
pub fn call_result_sort(params: List<Sort>, args: List<Option<Sort>>, ret: Sort) -> Option<Sort> = {
  let bindings = range(0, params.len()).fold(Map::new(), |acc: Map<Int, Sort>, i: Int|
    match ((params.at(i), args.at(i))) {
      (Some(p), Some(Some(a))) -> matched(p, a, acc),
      _ -> acc,
    });
  Some(apply_bindings(ret, bindings))
}

fn apply_bindings(t: Sort, bindings: Map<Int, Sort>) -> Sort =
  match t {
    SortVariable(v) -> match bindings.get(v) { Some(a) -> a, None -> SortVariable(v) },
    NamedSort(n, xs) -> NamedSort(n, xs.map(|x: Sort| apply_bindings(x, bindings))),
    FunctionSort(params, ret, pure) ->
      FunctionSort(
        params.map(|p: Sort| apply_bindings(p, bindings)),
        apply_bindings(ret, bindings),
        pure,
      ),
    RecordSort(fields) ->
      RecordSort(
        fields.map(|f: { name: String, ty: Sort }|
          { name: f.name, ty: apply_bindings(f.ty, bindings) }),
      ),
  }

/// One-way matching of `pattern` against `actual` that fails where they disagree: a variable bound
/// once is bound alike everywhere, and a function that performs fits no pure one.
pub fn match_strict(pattern: Sort, actual: Sort, subst: Map<Int, Sort>) -> Option<Map<Int, Sort>> =
  match pattern {
    SortVariable(v) -> match subst.get(v) {
      Some(bound) -> if bound == actual { Some(subst) } else { None },
      None -> Some(subst.insert(v, actual)),
    },
    NamedSort(a, xs) -> match actual {
      NamedSort(b, ys) -> if a == b && xs.len() == ys.len() { match_strict_all(xs, ys, subst) }
      else { None },
      _ -> None,
    },
    FunctionSort(ps, r, pure) -> match actual {
      FunctionSort(qs, s, also) -> if ps.len() != qs.len() || (pure && !also) { None } else {
        match match_strict_all(ps, qs, subst) { Some(m) -> match_strict(r, s, m), None -> None }
      },
      _ -> None,
    },
    RecordSort(xs) -> match actual {
      RecordSort(ys) -> if xs.len() != ys.len() { None } else {
        xs.fold(Some(subst), |acc: Option<Map<Int, Sort>>, x: { name: String, ty: Sort }|
          match acc {
            None -> None,
            Some(m) -> match field_sort(actual, x.name) {
              Some(y) -> match_strict(x.ty, y, m),
              None -> None,
            },
          })
      },
      _ -> None,
    },
  }

fn match_strict_all(
  xs: List<Sort>,
  ys: List<Sort>,
  subst: Map<Int, Sort>,
) -> Option<Map<Int, Sort>> =
  range(0, xs.len()).fold(Some(subst), |acc: Option<Map<Int, Sort>>, i: Int|
    match acc {
      None -> None,
      Some(m) -> match ((xs.at(i), ys.at(i))) {
        (Some(x), Some(y)) -> match_strict(x, y, m),
        _ -> None,
      },
    })

/// One-way matching of `pattern` against `actual`; silently declines where they disagree.
pub fn matched(pattern: Sort, actual: Sort, subst: Map<Int, Sort>) -> Map<Int, Sort> =
  match pattern {
    SortVariable(v) -> if subst.contains(v) { subst } else { subst.insert(v, actual) },
    NamedSort(a, xs) -> match actual {
      NamedSort(b, ys) -> if a == b && xs.len() == ys.len() {
        range(0, xs.len()).fold(subst, |acc: Map<Int, Sort>, i: Int|
          match ((xs.at(i), ys.at(i))) { (Some(x), Some(y)) -> matched(x, y, acc), _ -> acc })
      } else { subst },
      _ -> subst,
    },
    FunctionSort(ps, r, _) -> match actual {
      FunctionSort(qs, s, _) -> if ps.len() == qs.len() {
        matched(
          r,
          s,
          range(0, ps.len()).fold(subst, |acc: Map<Int, Sort>, i: Int|
            match ((ps.at(i), qs.at(i))) { (Some(p), Some(q)) -> matched(p, q, acc), _ -> acc }),
        )
      } else { subst },
      _ -> subst,
    },
    RecordSort(xs) -> match actual {
      RecordSort(_) ->
        xs.fold(subst, |acc: Map<Int, Sort>, x: { name: String, ty: Sort }|
          match field_sort(actual, x.name) { Some(y) -> matched(x.ty, y, acc), None -> acc }),
      _ -> subst,
    },
  }

test "a record type is one sort whichever order its fields were written in" {
  let a = record_of([{ name: "b", ty: int_sort() }, { name: "a", ty: bool_sort() }]);
  let b = record_of([{ name: "a", ty: bool_sort() }, { name: "b", ty: int_sort() }]);
  assert_eq(a, b);
  assert_eq(field_names(a), Some(["a", "b"]));
  assert_eq(field_sort(a, "b"), Some(int_sort()))
}

test "a call answers its return at what its arguments settle, and its own variable where they leave one" {
  let at = list_sort(SortVariable(0));
  assert_eq(
    call_result_sort([at], [Some(list_sort(float_sort()))], option_sort(SortVariable(0))),
    Some(option_sort(float_sort())),
  );
  let unsettled = foreign(SortVariable(1));
  assert_eq(
    call_result_sort([foreign(at), unsettled], [Some(list_sort(int_sort())), None], unsettled),
    Some(unsettled),
  );
  assert_eq(call_result_sort([], [], int_sort()), Some(int_sort()))
}

test "a type fits a pattern only where each variable is settled alike and nothing disagrees" {
  let pair = FunctionSort([SortVariable(0), SortVariable(0)], bool_sort(), true);
  assert(
    match_strict(pair, FunctionSort([int_sort(), int_sort()], bool_sort(), true), Map::new())
      != None,
  );
  assert_eq(
    match_strict(pair, FunctionSort([int_sort(), float_sort()], bool_sort(), true), Map::new()),
    None,
  );
  assert_eq(match_strict(int_sort(), float_sort(), Map::new()), None);
  // A law over a pure function says nothing of one that performs.
  assert_eq(
    match_strict(
      FunctionSort([int_sort()], int_sort(), true),
      FunctionSort([int_sort()], int_sort(), false),
      Map::new(),
    ),
    None,
  )
}

test "substitution replaces the variables it numbers and keeps the rest" {
  let t = FunctionSort([SortVariable(0), list_sort(SortVariable(1))], SortVariable(2), true);
  assert_eq(
    substituted(t, [int_sort(), bool_sort()]),
    FunctionSort([int_sort(), list_sort(bool_sort())], SortVariable(2), true),
  );
  assert_eq(vars(t, []), [0, 1, 2])
}
