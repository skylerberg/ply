import domain (Sort, SortVariable, FunctionSort, RecordSort, NamedSort, named_sort, substituted)

pub const int_sort: Sort = named_sort("Int")

pub const bool_sort: Sort = named_sort("Bool")

pub const string_sort: Sort = named_sort("String")

pub const bytes_sort: Sort = named_sort("Bytes")

pub const unit_sort: Sort = named_sort("Unit")

pub const float_sort: Sort = named_sort("Float")

pub const decimal_sort: Sort = named_sort("Decimal")

pub fn list_sort(element: Sort) -> Sort = NamedSort("List", [element])

pub fn option_sort(element: Sort) -> Sort = NamedSort("Option", [element])

pub fn is_named_sort(ty: Sort, name: String) -> Bool =
  match ty { NamedSort(n, args) -> n == name && args.len() == 0, _ -> false }

pub fn list_element(ty: Sort) -> Option<Sort> =
  match ty {
    NamedSort(n, args) -> if n == "List" && args.len() == 1 { args.at(0) } else { None },
    _ -> None,
  }

pub fn field_sort(ty: Sort, name: String) -> Option<Sort> =
  match ty {
    RecordSort(fields) ->
      fields.fold(None, |accumulator: Option<Sort>, f: { name: String, ty: Sort }|
        match accumulator {
          Some(_) -> accumulator,
          None -> if f.name == name { Some(f.ty) } else { None },
        }),
    _ -> None,
  }

pub fn field_names(ty: Sort) -> Option<List<String>> =
  match ty {
    RecordSort(fields) -> Some(fields.map(|f: { name: String, ty: Sort }| f.name)),
    _ -> None,
  }

pub fn canonical(ty: Sort) -> Sort =
  match ty {
    SortVariable(v) -> SortVariable(v),
    NamedSort(n, args) -> NamedSort(n, args.map(canonical)),
    FunctionSort(params, return_sort, pure) ->
      FunctionSort(params.map(canonical), canonical(return_sort), pure),
    RecordSort(fields) ->
      record_of(fields.map(|f: { name: String, ty: Sort }| { name: f.name, ty: canonical(f.ty) })),
  }

pub fn record_of(fields: List<{ name: String, ty: Sort }>) -> Sort =
  RecordSort(
    fields.fold(
      [],
      |accumulator: List<{ name: String, ty: Sort }>, f: { name: String, ty: Sort }|
        insert_by_name(accumulator, f),
    ),
  )

fn insert_by_name(
  sorted: List<{ name: String, ty: Sort }>,
  f: { name: String, ty: Sort },
) -> List<{ name: String, ty: Sort }> = {
  let before = sorted.filter(|g: { name: String, ty: Sort }| compare(g.name, f.name) == Less);
  let after = sorted.filter(|g: { name: String, ty: Sort }| compare(g.name, f.name) == Greater);
  after.fold(
    before.push(f),
    |accumulator: List<{ name: String, ty: Sort }>, g: { name: String, ty: Sort }|
      accumulator.push(g),
  )
}

pub fn sort_variables(t: Sort, seen: List<Int>) -> List<Int> =
  match t {
    SortVariable(v) -> if seen.fold(false, |found: Bool, s: Int| found || s == v) { seen }
    else { seen.push(v) },
    NamedSort(_, args) ->
      args.fold(seen, |accumulator: List<Int>, a: Sort| sort_variables(a, accumulator)),
    FunctionSort(params, return_sort, _) ->
      sort_variables(
        return_sort,
        params.fold(seen, |accumulator: List<Int>, p: Sort| sort_variables(p, accumulator)),
      ),
    RecordSort(fields) ->
      fields.fold(seen, |accumulator: List<Int>, f: { name: String, ty: Sort }|
        sort_variables(f.ty, accumulator)),
  }

pub fn is_pure_function(ty: Sort) -> Bool =
  match ty { FunctionSort(_, _, pure) -> pure, _ -> false }

pub const external_variable_base: Int = 1000000

pub fn shift_variables(t: Sort) -> Sort =
  match t {
    SortVariable(v) -> SortVariable(external_variable_base + v),
    NamedSort(n, xs) -> NamedSort(n, xs.map(shift_variables)),
    FunctionSort(params, return_sort, pure) ->
      FunctionSort(params.map(shift_variables), shift_variables(return_sort), pure),
    RecordSort(fields) ->
      RecordSort(
        fields.map(|f: { name: String, ty: Sort }| { name: f.name, ty: shift_variables(f.ty) }),
      ),
  }

pub fn call_result_sort(
  params: List<Sort>,
  args: List<Option<Sort>>,
  return_sort: Sort,
) -> Option<Sort> = {
  let bindings = range(0, params.len()).fold(Map::new(), |accumulator: Map<Int, Sort>, i: Int|
    match ((params.at(i), args.at(i))) {
      (Some(p), Some(Some(a))) -> matched(p, a, accumulator),
      _ -> accumulator,
    });
  Some(apply_bindings(return_sort, bindings))
}

fn apply_bindings(t: Sort, bindings: Map<Int, Sort>) -> Sort =
  match t {
    SortVariable(v) -> match bindings.get(v) { Some(a) -> a, None -> SortVariable(v) },
    NamedSort(n, xs) -> NamedSort(n, xs.map(|x: Sort| apply_bindings(x, bindings))),
    FunctionSort(params, return_sort, pure) ->
      FunctionSort(
        params.map(|p: Sort| apply_bindings(p, bindings)),
        apply_bindings(return_sort, bindings),
        pure,
      ),
    RecordSort(fields) ->
      RecordSort(
        fields.map(|f: { name: String, ty: Sort }|
          { name: f.name, ty: apply_bindings(f.ty, bindings) }),
      ),
  }

pub fn match_strict(
  pattern: Sort,
  actual: Sort,
  substitution: Map<Int, Sort>,
) -> Option<Map<Int, Sort>> =
  match pattern {
    SortVariable(v) -> match substitution.get(v) {
      Some(bound) -> if bound == actual { Some(substitution) } else { None },
      None -> Some(substitution.insert(v, actual)),
    },
    NamedSort(a, xs) -> match actual {
      NamedSort(b, ys) -> if a == b && xs.len() == ys.len() {
        match_strict_all(xs, ys, substitution)
      } else { None },
      _ -> None,
    },
    FunctionSort(ps, r, pure) -> match actual {
      FunctionSort(qs, s, also) -> if ps.len() != qs.len() || (pure && !also) { None } else {
        match match_strict_all(ps, qs, substitution) {
          Some(m) -> match_strict(r, s, m),
          None -> None,
        }
      },
      _ -> None,
    },
    RecordSort(xs) -> match actual {
      RecordSort(ys) -> if xs.len() != ys.len() { None } else {
        xs.fold(
          Some(substitution),
          |accumulator: Option<Map<Int, Sort>>, x: { name: String, ty: Sort }|
            match accumulator {
              None -> None,
              Some(m) -> match field_sort(actual, x.name) {
                Some(y) -> match_strict(x.ty, y, m),
                None -> None,
              },
            },
        )
      },
      _ -> None,
    },
  }

fn match_strict_all(
  xs: List<Sort>,
  ys: List<Sort>,
  substitution: Map<Int, Sort>,
) -> Option<Map<Int, Sort>> =
  range(0, xs.len()).fold(Some(substitution), |accumulator: Option<Map<Int, Sort>>, i: Int|
    match accumulator {
      None -> None,
      Some(m) -> match ((xs.at(i), ys.at(i))) {
        (Some(x), Some(y)) -> match_strict(x, y, m),
        _ -> None,
      },
    })

pub fn matched(pattern: Sort, actual: Sort, substitution: Map<Int, Sort>) -> Map<Int, Sort> =
  match pattern {
    SortVariable(v) -> if substitution.contains(v) { substitution }
    else { substitution.insert(v, actual) },
    NamedSort(a, xs) -> match actual {
      NamedSort(b, ys) -> if a == b && xs.len() == ys.len() {
        range(0, xs.len()).fold(substitution, |accumulator: Map<Int, Sort>, i: Int|
          match ((xs.at(i), ys.at(i))) {
            (Some(x), Some(y)) -> matched(x, y, accumulator),
            _ -> accumulator,
          })
      } else { substitution },
      _ -> substitution,
    },
    FunctionSort(ps, r, _) -> match actual {
      FunctionSort(qs, s, _) -> if ps.len() == qs.len() {
        matched(
          r,
          s,
          range(0, ps.len()).fold(substitution, |accumulator: Map<Int, Sort>, i: Int|
            match ((ps.at(i), qs.at(i))) {
              (Some(p), Some(q)) -> matched(p, q, accumulator),
              _ -> accumulator,
            }),
        )
      } else { substitution },
      _ -> substitution,
    },
    RecordSort(xs) -> match actual {
      RecordSort(_) ->
        xs.fold(substitution, |accumulator: Map<Int, Sort>, x: { name: String, ty: Sort }|
          match field_sort(actual, x.name) {
            Some(y) -> matched(x.ty, y, accumulator),
            None -> accumulator,
          }),
      _ -> substitution,
    },
  }

test "two record types with the same fields are equal, whatever order the fields were written in" {
  let a = record_of([{ name: "b", ty: int_sort }, { name: "a", ty: bool_sort }]);
  let b = record_of([{ name: "a", ty: bool_sort }, { name: "b", ty: int_sort }]);
  assert_eq(a, b);
  assert_eq(field_names(a), Some(["a", "b"]));
  assert_eq(field_sort(a, "b"), Some(int_sort))
}

test "`call_result_sort` substitutes the argument types into the return type, and keeps the return type's own variable when an argument is unresolved" {
  let at = list_sort(SortVariable(0));
  assert_eq(
    call_result_sort([at], [Some(list_sort(float_sort))], option_sort(SortVariable(0))),
    Some(option_sort(float_sort)),
  );
  let unresolved = shift_variables(SortVariable(1));
  assert_eq(
    call_result_sort(
      [shift_variables(at), unresolved],
      [Some(list_sort(int_sort)), None],
      unresolved,
    ),
    Some(unresolved),
  );
  assert_eq(call_result_sort([], [], int_sort), Some(int_sort))
}

test "`match_strict` matches a type to a pattern only when each variable gets the same type everywhere and nothing conflicts" {
  let pair = FunctionSort([SortVariable(0), SortVariable(0)], bool_sort, true);
  assert(
    match_strict(pair, FunctionSort([int_sort, int_sort], bool_sort, true), Map::new()) != None,
  );
  assert_eq(
    match_strict(pair, FunctionSort([int_sort, float_sort], bool_sort, true), Map::new()),
    None,
  );
  assert_eq(match_strict(int_sort, float_sort, Map::new()), None);
  assert_eq(
    match_strict(
      FunctionSort([int_sort], int_sort, true),
      FunctionSort([int_sort], int_sort, false),
      Map::new(),
    ),
    None,
  )
}

test "`substituted` replaces the type variables that have a replacement and leaves the other type variables unchanged" {
  let t = FunctionSort([SortVariable(0), list_sort(SortVariable(1))], SortVariable(2), true);
  assert_eq(
    substituted(t, [int_sort, bool_sort]),
    FunctionSort([int_sort, list_sort(bool_sort)], SortVariable(2), true),
  );
  assert_eq(sort_variables(t, []), [0, 1, 2])
}
