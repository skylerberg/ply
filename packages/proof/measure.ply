//! `measure` — what a `decreases` owes. Along the way to each call its definition makes into a member
//! of its group that states a measure too, the callee's measure at the call's arguments lies below the
//! caller's, which is not negative. The group's calls on the way are values here: each one before it
//! was itself below the call it was made from, which is what the measure is proved by.

import compiler.emit.code (Code, Node, CodeLiteral, CodeVar, NDefinition, NConstructor, NBuiltin,
                           CodeUnary, CodeBinary, CodeApply, CodeIf, CodeBlock, CodeList,
                           CodeRecord, CodeMatch, CodePerform, CodeFieldRead, CodeUpdate,
                           CodeStatement, CodeLet, CodeLetDestructure, CodeDo, CodeField, CodeArm)
import compiler.check.types (Type, int_type, bool_type, fn_type, no_effects)
import compiler.emit.typing (unknown_type)
import compiler.syntax.parsing (Span)
import compiler.syntax.patterns (LiteralBool, LiteralInt)
import context (Context, measure_name, group_of, refs_of, set_of)

/// The definition the obligation is about, how many parameters it binds, its group, and which of the
/// group state measures.
type MeasureGroup = {
  current: String,
  params: Int,
  group: Map<String, Bool>,
  stating: Map<String, Bool>,
}

/// The claim `definition`'s measure owes, as a `Bool` over its parameters, or why there is none to state.
pub fn descent_of(context: Context, definition: String) -> Result<Code, String> =
  match context.claims.definitions.get(definition) {
    None -> Err("no claim of `" ++ definition ++ "` was lowered"),
    Some(d) -> match ((d.body, d.measure)) {
      (Some(body), Some(_)) -> {
        let members = group_of(context, definition);
        let stating = members.filter(|m: String|
          match context.claims.definitions.get(m) {
            Some(x) -> match x.measure { Some(_) -> true, None -> false },
            None -> false,
          });
        let o = {
          current: definition,
          params: d.params,
          group: set_of(members),
          stating: set_of(stating),
        };
        // A measure that calls back into its own group is no measure of it.
        let circular = stating.fold(false, |found: Bool, m: String|
          found
            || (match context.claims.definitions.get(m) {
              Some(x) -> match x.measure { Some(c) -> mentions(o, c), None -> false },
              None -> false,
            }));
        if circular { Err("a measure calls into its own group") } else { descends(o, body) }
      },
      (None, _) -> Err("its body was not lowered"),
      (_, None) -> Err("it states no measure"),
    },
  }

fn mentions(o: MeasureGroup, c: Code) -> Bool =
  refs_of(c, []).fold(false, |found: Bool, n: String| found || o.group.contains(n))

fn with_span(node: Node, span: Span, ty: Type) -> Code = { node: node, span: span, ty: ty }

fn true_literal(span: Span) -> Code = with_span(CodeLiteral(LiteralBool(true)), span, bool_type())

fn is_true_literal(c: Code) -> Bool = match c.node { CodeLiteral(LiteralBool(b)) -> b, _ -> false }

fn both(a: Code, b: Code) -> Code =
  if is_true_literal(a) { b }
  else if is_true_literal(b) { a }
  else { with_span(CodeBinary({ op: b"and", lhs: a, rhs: b }), a.span, bool_type()) }

fn global(name: String, arity: Int, span: Span) -> Code =
  with_span(
    NDefinition({ full: Bytes::of_string(name), args: [], rows: [], labels: [] }),
    span,
    fn_type(range(0, arity).map(|_: Int| int_type()), int_type(), no_effects()),
  )

/// `definition`'s measure at `args`.
fn measure_call(definition: String, args: List<Code>, span: Span) -> Code =
  with_span(
    CodeApply({
      function: global(measure_name(definition), args.len(), span),
      args: args,
      row: no_effects(),
    }),
    span,
    int_type(),
  )

/// At a call of `callee`, a member stating a measure: `0 <= m(x̄) && m'(ȳ) < m(x̄)`.
fn descent(o: MeasureGroup, callee: String, args: List<Code>, span: Span) -> Code = {
  let mine = measure_call(
    o.current,
    range(0, o.params).map(|k: Int|
      with_span(CodeVar({ name: b"", slot: k }), span, unknown_type())),
    span,
  );
  let floor = with_span(
    CodeBinary({
      op: b"le",
      lhs: with_span(CodeLiteral(LiteralInt(0)), span, int_type()),
      rhs: mine,
    }),
    span,
    bool_type(),
  );
  let below = with_span(
    CodeBinary({ op: b"lt", lhs: measure_call(callee, args, span), rhs: mine }),
    span,
    bool_type(),
  );
  with_span(CodeBinary({ op: b"and", lhs: floor, rhs: below }), span, bool_type())
}

fn all_descend(o: MeasureGroup, cs: List<Code>, span: Span) -> Result<Code, String> =
  cs.fold(Ok(true_literal(span)), |acc: Result<Code, String>, c: Code|
    match acc {
      Err(_) -> acc,
      Ok(sofar) -> match descends(o, c) { Ok(more) -> Ok(both(sofar, more)), Err(why) -> Err(why) },
    })

/// Whether every call into the group that `c` makes, in the order it makes them, descends.
fn descends(o: MeasureGroup, c: Code) -> Result<Code, String> =
  if !mentions(o, c) { Ok(true_literal(c.span)) } else {
    match c.node {
      CodeVar(v) -> Err("`" ++ String::of_bytes_lossy(v.name) ++ "` is handed on as a value"),
      NDefinition(d) -> Err("`" ++ String::of_bytes_lossy(d.full) ++ "` is handed on as a value"),
      CodeApply(a) -> {
        let args = all_descend(o, a.args, c.span)?;
        match a.function.node {
          NDefinition(f) -> {
            let name = String::of_bytes_lossy(f.full);
            if o.group.contains(name) {
              Ok(if o.stating.contains(name) { both(args, descent(o, name, a.args, c.span)) }
              else { args })
            } else { Ok(args) }
          },
          NConstructor(_) -> Ok(args),
          NBuiltin(_) -> Ok(args),
          _ -> Ok(both(args, descends(o, a.function)?)),
        }
      },
      CodeIf(i) -> {
        let cond = descends(o, i.cond)?;
        let then_branch = descends(o, i.then_branch)?;
        let else_branch = descends(o, i.else_branch)?;
        Ok(
          both(
            cond,
            with_span(
              CodeIf({ cond: i.cond, then_branch: then_branch, else_branch: else_branch }),
              c.span,
              bool_type(),
            ),
          ),
        )
      },
      CodeMatch(m) -> {
        let scrutinee = descends(o, m.scrutinee)?;
        if m.arms.fold(false, |found: Bool, arm: CodeArm|
            found || (match arm.guard { Some(g) -> mentions(o, g), None -> false })) {
          Err("a call into the group in a guard")
        } else {
          let arms = m.arms.fold(Ok([]), |acc: Result<List<CodeArm>, String>, arm: CodeArm|
            match acc {
              Err(_) -> acc,
              Ok(xs) -> match descends(o, arm.body) {
                Ok(b) -> Ok(xs.push({ ..arm, body: b })),
                Err(why) -> Err(why),
              },
            })?;
          Ok(
            both(
              scrutinee,
              with_span(CodeMatch({ scrutinee: m.scrutinee, arms: arms }), c.span, bool_type()),
            ),
          )
        }
      },
      CodeBlock(b) -> {
        let tail = (match b.tail { Some(t) -> descends(o, t), None -> Ok(true_literal(c.span)) })?;
        range(0, b.statements.len()).fold(Ok(tail), |acc: Result<Code, String>, k: Int|
          match acc {
            Err(_) -> acc,
            Ok(rest) -> match b.statements.at(b.statements.len() - 1 - k) {
              None -> acc,
              Some(st) -> match st {
                CodeDo(d) -> match descends(o, d.code) {
                  Ok(x) -> Ok(both(x, rest)),
                  Err(why) -> Err(why),
                },
                CodeLet(l) -> binding_descends(o, st, l.value, rest, c.span),
                CodeLetDestructure(l) -> binding_descends(o, st, l.value, rest, c.span),
              },
            },
          })
      },
      CodeBinary(b) -> {
        let lhs = descends(o, b.lhs)?;
        let rhs = descends(o, b.rhs)?;
        // The right of `&&` and `||` is evaluated only where the left lets it be.
        if b.op == b"and" {
          Ok(
            both(
              lhs,
              with_span(
                CodeIf({ cond: b.lhs, then_branch: rhs, else_branch: true_literal(c.span) }),
                c.span,
                bool_type(),
              ),
            ),
          )
        } else if b.op == b"or" {
          Ok(
            both(
              lhs,
              with_span(
                CodeIf({ cond: b.lhs, then_branch: true_literal(c.span), else_branch: rhs }),
                c.span,
                bool_type(),
              ),
            ),
          )
        } else { Ok(both(lhs, rhs)) }
      },
      CodeUnary(u) -> descends(o, u.operand),
      CodeList(l) -> all_descend(o, l.items, c.span),
      CodeRecord(r) -> all_descend(o, r.fields.map(|f: CodeField| f.value), c.span),
      CodeFieldRead(f) -> descends(o, f.base),
      CodeUpdate(u) -> all_descend(o, u.sets.map(|f: CodeField| f.value).push(u.base), c.span),
      CodePerform(p) -> all_descend(o, p.args, c.span),
      _ -> Err("a call into the group inside a lambda or a simulation"),
    }
  }

/// What the bound value owes, then the rest of the block with the binding in scope.
fn binding_descends(
  o: MeasureGroup,
  st: CodeStatement,
  value: Code,
  rest: Code,
  span: Span,
) -> Result<Code, String> =
  match descends(o, value) {
    Err(why) -> Err(why),
    Ok(v) ->
      Ok(
        both(v, if is_true_literal(rest) { rest }
        else { with_span(CodeBlock({ statements: [st], tail: Some(rest) }), span, bool_type()) }),
      ),
  }
