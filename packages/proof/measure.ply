import compiler.emit.code (Code, Node, CodeLiteral, CodeVariable, NDefinition, NConstructor,
                           NBuiltin, CodeUnary, CodeBinary, CodeApply, CodeIf, CodeBlock, CodeList,
                           CodeRecord, CodeMatch, CodePerform, CodeFieldRead, CodeUpdate,
                           CodeStatement, CodeLet, CodeLetDestructure, CodeDo, CodeField, CodeArm)
import compiler.check.types (Type, int_type, bool_type, function_type, no_effects)
import compiler.emit.typing (unknown_type)
import compiler.syntax.parsing (Span)
import compiler.syntax.patterns (LiteralBool, LiteralInt)
import context (Context, measure_name, group_of, refs_of, set_of)

type MeasureGroup = {
  current: String,
  params: Int,
  group: Map<String, Bool>,
  stating: Map<String, Bool>,
}

pub fn descent_of(context: Context, definition: String) -> Result<Code, String> =
  match context.claims.definitions.get(definition) {
    None ->
      Err(
        "the prover has no claim about `" ++ definition
          ++ "`, so it cannot check that the measure decreases",
      ),
    Some(d) -> match ((d.body, d.measure)) {
      (Some(body), Some(_)) -> {
        let members = group_of(context, definition);
        let stating = members.filter(|m: String|
          match context.claims.definitions.get(m) {
            Some(x) -> match x.measure { Some(_) -> true, None -> false },
            None -> false,
          });
        let o = {
          current: definition,
          params: d.params,
          group: set_of(members),
          stating: set_of(stating),
        };
        let circular = stating.fold(false, |found: Bool, m: String|
          found
            || (match context.claims.definitions.get(m) {
              Some(x) -> match x.measure { Some(c) -> mentions(o, c), None -> false },
              None -> false,
            }));
        if circular {
          Err("a measure calls a definition from its own group of mutually recursive definitions")
        } else { all_calls_decrease(o, body) }
      },
      (None, _) -> Err("the definition has no body for the prover to read"),
      (_, None) -> Err("the definition states no measure"),
    },
  }

fn mentions(o: MeasureGroup, c: Code) -> Bool =
  refs_of(c, []).fold(false, |found: Bool, n: String| found || o.group.contains(n))

fn with_span(node: Node, span: Span, ty: Type) -> Code = { node: node, span: span, ty: ty }

fn true_literal(span: Span) -> Code = with_span(CodeLiteral(LiteralBool(true)), span, bool_type)

fn is_true_literal(c: Code) -> Bool = match c.node { CodeLiteral(LiteralBool(b)) -> b, _ -> false }

fn both(a: Code, b: Code) -> Code =
  if is_true_literal(a) { b }
  else if is_true_literal(b) { a } else {
    with_span(
      CodeBinary({ operation: b"and", left_operand: a, right_operand: b }),
      a.span,
      bool_type,
    )
  }

fn global(name: String, arity: Int, span: Span) -> Code =
  with_span(
    NDefinition({ full: Bytes::of_string(name), args: [], effect_arguments: [], labels: [] }),
    span,
    function_type(range(0, arity).map(|_: Int| int_type), int_type, no_effects),
  )

fn measure_call(definition: String, args: List<Code>, span: Span) -> Code =
  with_span(
    CodeApply({
      function: global(measure_name(definition), args.len(), span),
      args: args,
      effects: no_effects,
    }),
    span,
    int_type,
  )

fn decrease_claim(o: MeasureGroup, callee: String, args: List<Code>, span: Span) -> Code = {
  let mine = measure_call(
    o.current,
    range(0, o.params).map(|k: Int|
      with_span(CodeVariable({ name: b"", slot: k }), span, unknown_type)),
    span,
  );
  let floor = with_span(
    CodeBinary({
      operation: b"le",
      left_operand: with_span(CodeLiteral(LiteralInt(0)), span, int_type),
      right_operand: mine,
    }),
    span,
    bool_type,
  );
  let below = with_span(
    CodeBinary({
      operation: b"lt",
      left_operand: measure_call(callee, args, span),
      right_operand: mine,
    }),
    span,
    bool_type,
  );
  with_span(
    CodeBinary({ operation: b"and", left_operand: floor, right_operand: below }),
    span,
    bool_type,
  )
}

fn all_descend(o: MeasureGroup, cs: List<Code>, span: Span) -> Result<Code, String> =
  cs.fold(Ok(true_literal(span)), |accumulator: Result<Code, String>, c: Code|
    match accumulator {
      Err(_) -> accumulator,
      Ok(sofar) -> match all_calls_decrease(o, c) {
        Ok(more) -> Ok(both(sofar, more)),
        Err(reason) -> Err(reason),
      },
    })

fn all_calls_decrease(o: MeasureGroup, c: Code) -> Result<Code, String> =
  if !mentions(o, c) { Ok(true_literal(c.span)) } else {
    match c.node {
      CodeVariable(v) ->
        Err(
          "`" ++ String::of_bytes_lossy(v.name) ++ "` is used as a value instead of being called",
        ),
      NDefinition(d) ->
        Err(
          "`" ++ String::of_bytes_lossy(d.full) ++ "` is used as a value instead of being called",
        ),
      CodeApply(a) -> {
        let args = all_descend(o, a.args, c.span)?;
        match a.function.node {
          NDefinition(f) -> {
            let name = String::of_bytes_lossy(f.full);
            if o.group.contains(name) {
              Ok(if o.stating.contains(name) { both(args, decrease_claim(o, name, a.args, c.span)) }
              else { args })
            } else { Ok(args) }
          },
          NConstructor(_) -> Ok(args),
          NBuiltin(_) -> Ok(args),
          _ -> Ok(both(args, all_calls_decrease(o, a.function)?)),
        }
      },
      CodeIf(i) -> {
        let cond = all_calls_decrease(o, i.cond)?;
        let then_branch = all_calls_decrease(o, i.then_branch)?;
        let else_branch = all_calls_decrease(o, i.else_branch)?;
        Ok(
          both(
            cond,
            with_span(
              CodeIf({ cond: i.cond, then_branch: then_branch, else_branch: else_branch }),
              c.span,
              bool_type,
            ),
          ),
        )
      },
      CodeMatch(m) -> {
        let scrutinee = all_calls_decrease(o, m.scrutinee)?;
        if m.arms.fold(false, |found: Bool, arm: CodeArm|
            found || (match arm.guard { Some(g) -> mentions(o, g), None -> false })) {
          Err(
            "a match guard calls a definition from the measure's own group of mutually recursive definitions",
          )
        } else {
          let arms = m.arms.fold(
            Ok([]),
            |accumulator: Result<List<CodeArm>, String>, arm: CodeArm|
              match accumulator {
                Err(_) -> accumulator,
                Ok(xs) -> match all_calls_decrease(o, arm.body) {
                  Ok(b) -> Ok(xs.push({ ..arm, body: b })),
                  Err(reason) -> Err(reason),
                },
              },
          )?;
          Ok(
            both(
              scrutinee,
              with_span(CodeMatch({ scrutinee: m.scrutinee, arms: arms }), c.span, bool_type),
            ),
          )
        }
      },
      CodeBlock(b) -> {
        let tail = (match b.tail {
          Some(t) -> all_calls_decrease(o, t),
          None -> Ok(true_literal(c.span)),
        })?;
        range(0, b.statements.len()).fold(Ok(tail), |accumulator: Result<Code, String>, k: Int|
          match accumulator {
            Err(_) -> accumulator,
            Ok(rest) -> match b.statements.at(b.statements.len() - 1 - k) {
              None -> accumulator,
              Some(st) -> match st {
                CodeDo(d) -> match all_calls_decrease(o, d.code) {
                  Ok(x) -> Ok(both(x, rest)),
                  Err(reason) -> Err(reason),
                },
                CodeLet(l) -> binding_descends(o, st, l.value, rest, c.span),
                CodeLetDestructure(l) -> binding_descends(o, st, l.value, rest, c.span),
              },
            },
          })
      },
      CodeBinary(b) -> {
        let left = all_calls_decrease(o, b.left_operand)?;
        let right = all_calls_decrease(o, b.right_operand)?;
        if b.operation == b"and" {
          Ok(
            both(
              left,
              with_span(
                CodeIf({
                  cond: b.left_operand,
                  then_branch: right,
                  else_branch: true_literal(c.span),
                }),
                c.span,
                bool_type,
              ),
            ),
          )
        } else if b.operation == b"or" {
          Ok(
            both(
              left,
              with_span(
                CodeIf({
                  cond: b.left_operand,
                  then_branch: true_literal(c.span),
                  else_branch: right,
                }),
                c.span,
                bool_type,
              ),
            ),
          )
        } else { Ok(both(left, right)) }
      },
      CodeUnary(u) -> all_calls_decrease(o, u.operand),
      CodeList(l) -> all_descend(o, l.items, c.span),
      CodeRecord(r) -> all_descend(o, r.fields.map(|f: CodeField| f.value), c.span),
      CodeFieldRead(f) -> all_calls_decrease(o, f.base),
      CodeUpdate(u) -> all_descend(o, u.sets.map(|f: CodeField| f.value).push(u.base), c.span),
      CodePerform(p) -> all_descend(o, p.args, c.span),
      _ -> Err("a call to a mutually recursive definition inside a lambda or a simulation"),
    }
  }

fn binding_descends(
  o: MeasureGroup,
  st: CodeStatement,
  value: Code,
  rest: Code,
  span: Span,
) -> Result<Code, String> =
  match all_calls_decrease(o, value) {
    Err(reason) -> Err(reason),
    Ok(v) ->
      Ok(
        both(v, if is_true_literal(rest) { rest }
        else { with_span(CodeBlock({ statements: [st], tail: Some(rest) }), span, bool_type) }),
      ),
  }
