//! `candidates` — the few small values a claim over a domain no run walks whole is tried at. Trying
//! them proves nothing of the claim: a point it fails at refutes it, and a point its guard admits
//! witnesses a proof made of the claim under that guard.

import std.bytes
import std.string
import std.value (Value, VUnit, VBool, VInt, VFloat, VDecimal, VFixed, VChar, VStr, VBytes, VList,
                  VArray, VRecord, VCtor, VMap, Field)
import domain (Ty, Var, Fn, Record, Con, Decl, Variant, find_decl, name_order)
import std.list

/// The most points one search tries, and the most values one binder offers.
fn most_points() -> Int = 4096

fn most_per_binder() -> Int = 12

/// The literals a claim and its guards are written with, by their kind.
type Literals = { ints: List<Int>, strings: List<String>, bytes: List<Bytes> }

/// `texts` read as the literals they spell, each `<int|str|bytes> <value>`.
fn literals_of(texts: List<Bytes>) -> Literals / {abort.raise} =
  texts.fold({ ints: [], strings: [], bytes: [] }, |acc: Literals, t: Bytes|
    if t.starts_with(b"int ") {
      match String::of_bytes(t.slice(4, t.len())).int_of_string() {
        Some(k) -> { ..acc, ints: acc.ints.push(k) },
        None -> acc,
      }
    } else if t.starts_with(b"str ") {
      { ..acc, strings: acc.strings.push(String::of_bytes(t.slice(4, t.len()))) }
    } else if t.starts_with(b"bytes ") {
      { ..acc, bytes: acc.bytes.push(Bytes::of_hex(String::of_bytes(t.slice(6, t.len())))) }
    } else { acc })

fn fixed_width(name: String) -> Bool =
  ["U8", "U16", "U32", "U64", "I8", "I16", "I32", "I64", "U128", "I128"].fold(
    false,
    |hit: Bool, n: String| hit || n == name,
  )

/// `fields` as a record's value holds them: in name order.
fn record_of(fields: List<Field>) -> Value =
  VRecord(
    name_order(fields.map(|f: Field| f.name)).fold([], |acc: List<Field>, i: Int|
      match fields.at(i) { Some(f) -> acc.push(f), None -> acc }),
  )

/// `t` with each of its type variables read from `args`, by its number.
pub fn substituted(t: Ty, args: List<Ty>) -> Ty =
  match t {
    Var(v) -> match args.at(v) { Some(a) -> a, None -> t },
    Con(name, xs) -> Con(name, xs.map(|x: Ty| substituted(x, args))),
    Fn(params, ret, pure) ->
      Fn(params.map(|p: Ty| substituted(p, args)), substituted(ret, args), pure),
    Record(fields) ->
      Record(
        fields.map(|f: { name: String, ty: Ty }| { name: f.name, ty: substituted(f.ty, args) }),
      ),
  }

/// The `Int`s tried: zero and its neighbours, then each literal with its own, since `x > 1000000`
/// is satisfied by `1000001`.
fn ints(lits: Literals) -> List<Value> =
  lits.ints.fold([0, 1, 0 - 1], |out: List<Int>, k: Int|
    [k, k +| 1, k -| 1].fold(out, |acc: List<Int>, c: Int|
      if acc.fold(false, |seen: Bool, x: Int| seen || x == c) { acc } else { acc.push(c) })).map(
    |k: Int| VInt(k),
  )

/// The first value each of `tys` is tried at, or nothing where one of them has none.
fn firsts(
  tys: List<Ty>,
  decls: List<Decl>,
  lits: Literals,
  room: Int,
) -> Option<List<Value>> / {abort.raise} =
  tys.fold(Some([]), |acc: Option<List<Value>>, t: Ty|
    match acc {
      None -> None,
      Some(vs) -> match tried(t, decls, lits, room).at(0) {
        Some(v) -> Some(vs.push(v)),
        None -> None,
      },
    })

/// The tuples the parts of one value are tried at: each of `tys` at its first value, and then each
/// in turn at its second beside the others' first. Nothing where one of them has no value.
fn tuples(
  tys: List<Ty>,
  decls: List<Decl>,
  lits: Literals,
  room: Int,
) -> List<List<Value>> / {abort.raise} =
  match firsts(tys, decls, lits, room) {
    None -> [],
    Some(base) ->
      range(0, tys.len()).fold([base], |out: List<List<Value>>, i: Int|
        match tys.at(i) {
          None -> out,
          Some(t) -> match tried(t, decls, lits, room).at(1) {
            Some(second) -> out.push(base.set(i, second)),
            None -> out,
          },
        }),
  }

/// The values a binder of type `ty` is tried at, smallest and most literal first: none for a type
/// nothing here makes a value of, as a function is. A type variable is tried as an `Int`, and
/// opening a declared type spends `room`. A text is tried at two values before any literal, and a
/// list at two items, so that a guard or a claim holding two of them apart has a point to tell.
fn tried(ty: Ty, decls: List<Decl>, lits: Literals, room: Int) -> List<Value> / {abort.raise} =
  match ty {
    Var(_) -> ints(lits),
    Fn(_, _, _) -> [],
    Record(fields) ->
      tuples(fields.map(|f: { name: String, ty: Ty }| f.ty), decls, lits, room).map(
        |values: List<Value>|
          record_of(
            range(0, fields.len()).map(|i: Int|
              {
                name: match fields.at(i) { Some(f) -> f.name, None -> "" },
                value: match values.at(i) { Some(v) -> v, None -> VUnit },
              }),
          ),
      ),
    Con(name, args) -> if name == "Bool" { [VBool(false), VBool(true)] }
    else if name == "Unit" { [VUnit] }
    else if name == "Int" { ints(lits) } else if name == "String" {
      lits.strings.fold([VStr(""), VStr("a")], |out: List<Value>, s: String| out.push(VStr(s)))
    } else if name == "Bytes" {
      lits.bytes.fold([VBytes(b""), VBytes(b"a")], |out: List<Value>, b: Bytes| out.push(VBytes(b)))
    }
    // `NaN` is where a claim about a `Float` most often fails, and `-0.0` where one that reads `==`
    // as identity does.
    else if name == "Float" { [VFloat(0.0), VFloat(1.0), VFloat(0.0 / 0.0), VFloat(-0.0)] }
    // One value at two scales, which are `==` and print apart.
    else if name == "Decimal" { [VDecimal(0m), VDecimal(1m), VDecimal(1.0m)] }
    else if name == "Char" { [VChar('a'), VChar('b')] }
    else if fixed_width(name) { [VFixed(name, 0u128), VFixed(name, 1u128)] }
    else if name == "List" || name == "Array" {
      let made = |items: List<Value>| if name == "List" { VList(items) } else { VArray(items) };
      let of = match args.at(0) { Some(a) -> tried(a, decls, lits, room), None -> [] };
      let short = of.take(2).fold([made([])], |out: List<Value>, v: Value| out.push(made([v])));
      match of.at(0) {
        None -> short,
        Some(a) -> match of.at(1) {
          None -> short.push(made([a, a])),
          Some(b) -> short.push(made([a, a])).push(made([a, b])),
        },
      }
    } else if name == "Map" {
      // Empty, and of the one entry its first key and first value make.
      let first = |i: Int|
        match args.at(i) { Some(a) -> tried(a, decls, lits, room).at(0), None -> None };
      match first(0) {
        None -> [VMap([])],
        Some(k) -> match first(1) {
          None -> [VMap([])],
          Some(v) -> [VMap([]), VMap([{ key: k, value: v }])],
        },
      }
    } else {
      match find_decl(decls, name) {
        None -> [],
        Some(decl) ->
          decl.variants.fold([], |out: List<Value>, v: Variant|
            if v.fields.len() == 0 { out.push(VCtor(v.name, [])) }
            else if room <= 0 { out } else {
              tuples(v.fields.map(|f: Ty| substituted(f, args)), decls, lits, room - 1).fold(
                out,
                |acc: List<Value>, values: List<Value>| acc.push(VCtor(v.name, values)),
              )
            }),
      }
    },
  }

/// How many values each of `n` binders may offer for every tuple of them to be tried.
fn per_binder(n: Int) -> Int =
  range(1, most_per_binder() + 1).fold(1, |best: Int, k: Int|
    if range(0, n).fold(1, |product: Int, _i: Int| min(product * k, most_points() + 1))
        <= most_points() { k }
    else { best })

/// Every tuple of the values `tys`, a claim's binders, are tried at, the first binder varying
/// fastest and each offering no more than keeps the tuples within the search's budget. `literals`
/// are what the claim and its guards are written with. Nothing where a binder has no value to try.
pub fn candidates(
  tys: List<Ty>,
  decls: List<Decl>,
  literals: List<Bytes>,
) -> List<List<Value>> / {abort.raise} = {
  let lits = literals_of(literals);
  let most = per_binder(tys.len());
  let columns = tys.map(|t: Ty| tried(t, decls, lits, 2).take(most));
  if columns.fold(false, |none: Bool, c: List<Value>| none || c.len() == 0) { [] } else {
    let points = columns.fold(1, |n: Int, c: List<Value>| n * c.len());
    range(0, points).map(|index: Int|
      columns.fold(
        { rest: index, values: [] },
        |acc: { rest: Int, values: List<Value> }, col: List<Value>|
          {
            rest: acc.rest / col.len(),
            values: acc.values.push(match col.at(acc.rest % col.len()) {
              Some(v) -> v,
              None -> VUnit,
            }),
          },
      ).values)
  }
}

// --- Tests ------------------------------------------------------------------

fn int() -> Ty = Con("Int", [])

fn shapes() -> List<Decl> =
  [
    {
      name: "m.Shape",
      params: 1,
      variants: [
        { name: "m.Dot", fields: [] },
        { name: "m.Box", fields: [Var(0), Con("Bool", [])] },
        { name: "m.Pile", fields: [Con("m.Shape", [Var(0)])] },
      ],
    },
  ]

test "an Int is tried at zero, its neighbours, and each literal of the guard with its own" {
  assert_eq(candidates([int()], [], []), [[VInt(0)], [VInt(1)], [VInt(0 - 1)]]);
  assert_eq(candidates([int()], [], [b"int 1000000", b"str x"]), [
    [VInt(0)],
    [VInt(1)],
    [VInt(0 - 1)],
    [VInt(1000000)],
    [VInt(1000001)],
    [VInt(999999)],
  ])
}

test "every tuple of the binders' values is tried, the first binder varying fastest" {
  assert_eq(candidates([Con("Bool", []), Con("String", [])], [], [b"str id"]), [
    [VBool(false), VStr("")],
    [VBool(true), VStr("")],
    [VBool(false), VStr("a")],
    [VBool(true), VStr("a")],
    [VBool(false), VStr("id")],
    [VBool(true), VStr("id")],
  ]);
  // A claim with no binder has one point, and it assigns nothing.
  assert_eq(candidates([], [], []), [[]])
}

test "a list is tried empty, at one of each of its first values, and at two of them" {
  assert_eq(candidates([Con("List", [Con("Bool", [])])], [], []), [
    [VList([])],
    [VList([VBool(false)])],
    [VList([VBool(true)])],
    [VList([VBool(false), VBool(false)])],
    [VList([VBool(false), VBool(true)])],
  ]);
  assert_eq(candidates([Con("List", [Con("Unit", [])])], [], []), [
    [VList([])],
    [VList([VUnit])],
    [VList([VUnit, VUnit])],
  ])
}

test "a map is tried empty and with the one entry its first key and value make" {
  assert_eq(candidates([Con("Map", [Con("String", []), int()])], [], []), [
    [VMap([])],
    [VMap([{ key: VStr(""), value: VInt(0) }])],
  ]);
  // A key or a value nothing here makes leaves the empty map.
  assert_eq(candidates([Con("Map", [int(), Fn([int()], int(), true)])], [], []), [[VMap([])]])
}

test "a record is tried with each field at its first value, then each in turn at its second" {
  let made = |a: Bool, b: Int|
    [VRecord([{ name: "a", value: VBool(a) }, { name: "b", value: VInt(b) }])];
  assert_eq(
    candidates([Record([{ name: "b", ty: int() }, { name: "a", ty: Con("Bool", []) }])], [], []),
    [made(false, 0), made(false, 1), made(true, 0)],
  )
}

test "a declared type is tried at each variant, its fields as a record's are, a few deep" {
  assert_eq(candidates([Con("m.Shape", [int()])], shapes(), []), [
    [VCtor("m.Dot", [])],
    [VCtor("m.Box", [VInt(0), VBool(false)])],
    [VCtor("m.Box", [VInt(1), VBool(false)])],
    [VCtor("m.Box", [VInt(0), VBool(true)])],
    [VCtor("m.Pile", [VCtor("m.Dot", [])])],
    [VCtor("m.Pile", [VCtor("m.Box", [VInt(0), VBool(false)])])],
  ]);
  // A type variable is tried as an `Int`.
  assert_eq(candidates([Var(0)], [], []), candidates([int()], [], []))
}

test "a binder nothing here makes a value of leaves nothing to try" {
  assert_eq(candidates([int(), Fn([int()], int(), true)], [], []), []);
  assert_eq(candidates([Con("m.Unknown", [])], [], []), [])
}

test "many binders each offer fewer values, so the tuples stay within the budget" {
  assert_eq(per_binder(1), 12);
  assert_eq(per_binder(3), 12);
  assert_eq(per_binder(4), 8);
  assert_eq(per_binder(12), 2);
  assert_eq(per_binder(13), 1);
  assert_eq(candidates(range(0, 13).map(|_i: Int| int()), [], []).len(), 1);
  assert_eq(candidates(range(0, 12).map(|_i: Int| int()), [], []).len(), 4096)
}
