import std.bytes
import std.string
import std.value (Value, VUnit, VBool, VInt, VFloat, VDecimal, VFixed, VChar, VStr, VBytes, VList,
                  VArray, VRecord, VCtor, VMap, Field)
import domain (Sort, SortVariable, FunctionSort, RecordSort, NamedSort, Declaration, Variant,
               find_declaration, name_order, substituted, max_enumerated_points)
import std.list

fn max_per_binder() -> Int = 12

type Literals = { ints: List<Int>, strings: List<String>, bytes: List<Bytes> }

fn literals_of(texts: List<Bytes>) -> Literals / {abort.raise} =
  texts.fold({ ints: [], strings: [], bytes: [] }, |accumulator: Literals, t: Bytes|
    if t.starts_with(b"int ") {
      match String::of_bytes(t.slice(4, t.len())).int_of_string() {
        Some(k) -> { ..accumulator, ints: accumulator.ints.push(k) },
        None -> accumulator,
      }
    } else if t.starts_with(b"str ") {
      { ..accumulator, strings: accumulator.strings.push(String::of_bytes(t.slice(4, t.len()))) }
    } else if t.starts_with(b"bytes ") {
      {
        ..accumulator,
        bytes: accumulator.bytes.push(Bytes::of_hex(String::of_bytes(t.slice(6, t.len())))),
      }
    } else { accumulator })

fn fixed_width(name: String) -> Bool =
  ["U8", "U16", "U32", "U64", "I8", "I16", "I32", "I64", "U128", "I128"].fold(
    false,
    |hit: Bool, n: String| hit || n == name,
  )

fn record_of(fields: List<Field>) -> Value =
  VRecord(
    name_order(fields.map(|f: Field| f.name)).fold([], |accumulator: List<Field>, i: Int|
      match fields.at(i) { Some(f) -> accumulator.push(f), None -> accumulator }),
  )

fn ints(lits: Literals) -> List<Value> =
  lits.ints.fold([0, 1, 0 - 1], |out: List<Int>, k: Int|
    [k, k +| 1, k -| 1].fold(out, |accumulator: List<Int>, c: Int|
      if accumulator.fold(false, |seen: Bool, x: Int| seen || x == c) { accumulator }
      else { accumulator.push(c) })).map(|k: Int| VInt(k))

fn first_values(
  types: List<Sort>,
  declarations: List<Declaration>,
  lits: Literals,
  depth_left: Int,
) -> Option<List<Value>> / {abort.raise} =
  types.fold(Some([]), |accumulator: Option<List<Value>>, t: Sort|
    match accumulator {
      None -> None,
      Some(vs) -> match values_to_try(t, declarations, lits, depth_left).at(0) {
        Some(v) -> Some(vs.push(v)),
        None -> None,
      },
    })

fn tuples(
  types: List<Sort>,
  declarations: List<Declaration>,
  lits: Literals,
  depth_left: Int,
) -> List<List<Value>> / {abort.raise} =
  match first_values(types, declarations, lits, depth_left) {
    None -> [],
    Some(base) ->
      range(0, types.len()).fold([base], |out: List<List<Value>>, i: Int|
        match types.at(i) {
          None -> out,
          Some(t) -> match values_to_try(t, declarations, lits, depth_left).at(1) {
            Some(second) -> out.push(base.set(i, second)),
            None -> out,
          },
        }),
  }

fn values_to_try(
  ty: Sort,
  declarations: List<Declaration>,
  lits: Literals,
  depth_left: Int,
) -> List<Value> / {abort.raise} =
  match ty {
    SortVariable(_) -> ints(lits),
    FunctionSort(_, _, _) -> [],
    RecordSort(fields) ->
      tuples(fields.map(|f: { name: String, ty: Sort }| f.ty), declarations, lits, depth_left).map(
        |values: List<Value>|
          record_of(
            range(0, fields.len()).map(|i: Int|
              {
                name: match fields.at(i) { Some(f) -> f.name, None -> "" },
                value: match values.at(i) { Some(v) -> v, None -> VUnit },
              }),
          ),
      ),
    NamedSort(name, args) -> if name == "Bool" { [VBool(false), VBool(true)] }
    else if name == "Unit" { [VUnit] }
    else if name == "Int" { ints(lits) } else if name == "String" {
      lits.strings.fold([VStr(""), VStr("a")], |out: List<Value>, s: String| out.push(VStr(s)))
    } else if name == "Bytes" {
      lits.bytes.fold([VBytes(b""), VBytes(b"a")], |out: List<Value>, b: Bytes| out.push(VBytes(b)))
    } else if name == "Float" { [VFloat(0.0), VFloat(1.0), VFloat(0.0 / 0.0), VFloat(-0.0)] }
    else if name == "Decimal" { [VDecimal(0m), VDecimal(1m), VDecimal(1.0m)] }
    else if name == "Char" { [VChar('a'), VChar('b')] }
    else if fixed_width(name) { [VFixed(name, 0u128), VFixed(name, 1u128)] }
    else if name == "List" || name == "Array" {
      let made = |items: List<Value>| if name == "List" { VList(items) } else { VArray(items) };
      let of = match args.at(0) {
        Some(a) -> values_to_try(a, declarations, lits, depth_left),
        None -> [],
      };
      let short = of.take(2).fold([made([])], |out: List<Value>, v: Value| out.push(made([v])));
      match of.at(0) {
        None -> short,
        Some(a) -> match of.at(1) {
          None -> short.push(made([a, a])),
          Some(b) -> short.push(made([a, a])).push(made([a, b])),
        },
      }
    } else if name == "Map" {
      let first = |i: Int|
        match args.at(i) {
          Some(a) -> values_to_try(a, declarations, lits, depth_left).at(0),
          None -> None,
        };
      match first(0) {
        None -> [VMap([])],
        Some(k) -> match first(1) {
          None -> [VMap([])],
          Some(v) -> [VMap([]), VMap([{ key: k, value: v }])],
        },
      }
    } else {
      match find_declaration(declarations, name) {
        None -> [],
        Some(declaration) ->
          declaration.variants.fold([], |out: List<Value>, v: Variant|
            if v.fields.len() == 0 { out.push(VCtor(v.name, [])) }
            else if depth_left <= 0 { out } else {
              tuples(
                v.fields.map(|f: Sort| substituted(f, args)),
                declarations,
                lits,
                depth_left - 1,
              ).fold(out, |accumulator: List<Value>, values: List<Value>|
                accumulator.push(VCtor(v.name, values)))
            }),
      }
    },
  }

fn values_per_binder(n: Int) -> Int =
  range(1, max_per_binder() + 1).fold(1, |best: Int, k: Int|
    if range(0, n).fold(1, |product: Int, _i: Int| min(product * k, max_enumerated_points() + 1))
        <= max_enumerated_points() { k }
    else { best })

pub fn candidates(
  types: List<Sort>,
  declarations: List<Declaration>,
  literals: List<Bytes>,
) -> List<List<Value>> / {abort.raise} = {
  let lits = literals_of(literals);
  let most = values_per_binder(types.len());
  let columns = types.map(|t: Sort| values_to_try(t, declarations, lits, 2).take(most));
  if columns.fold(false, |none: Bool, c: List<Value>| none || c.len() == 0) { [] } else {
    let points = columns.fold(1, |n: Int, c: List<Value>| n * c.len());
    range(0, points).map(|index: Int|
      columns.fold(
        { rest: index, values: [] },
        |accumulator: { rest: Int, values: List<Value> }, col: List<Value>|
          {
            rest: accumulator.rest / col.len(),
            values: accumulator.values.push(match col.at(accumulator.rest % col.len()) {
              Some(v) -> v,
              None -> VUnit,
            }),
          },
      ).values)
  }
}

fn int() -> Sort = NamedSort("Int", [])

fn shapes() -> List<Declaration> =
  [
    {
      name: "m.Shape",
      params: 1,
      variants: [
        { name: "m.Dot", fields: [] },
        { name: "m.Box", fields: [SortVariable(0), NamedSort("Bool", [])] },
        { name: "m.Pile", fields: [NamedSort("m.Shape", [SortVariable(0)])] },
      ],
    },
  ]

test "test inputs for an `Int` binder are 0 and the values 1 and -1 next to it, plus each integer literal in the guard with its two adjacent values" {
  assert_eq(candidates([int()], [], []), [[VInt(0)], [VInt(1)], [VInt(0 - 1)]]);
  assert_eq(candidates([int()], [], [b"int 1000000", b"str x"]), [
    [VInt(0)],
    [VInt(1)],
    [VInt(0 - 1)],
    [VInt(1000000)],
    [VInt(1000001)],
    [VInt(999999)],
  ])
}

test "every tuple of the binders' values is tried, the first binder varying fastest" {
  assert_eq(candidates([NamedSort("Bool", []), NamedSort("String", [])], [], [b"str id"]), [
    [VBool(false), VStr("")],
    [VBool(true), VStr("")],
    [VBool(false), VStr("a")],
    [VBool(true), VStr("a")],
    [VBool(false), VStr("id")],
    [VBool(true), VStr("id")],
  ]);
  assert_eq(candidates([], [], []), [[]])
}

test "test inputs for a list binder are the empty list, each one-element list of the element type's first two values, and two-element lists of them" {
  assert_eq(candidates([NamedSort("List", [NamedSort("Bool", [])])], [], []), [
    [VList([])],
    [VList([VBool(false)])],
    [VList([VBool(true)])],
    [VList([VBool(false), VBool(false)])],
    [VList([VBool(false), VBool(true)])],
  ]);
  assert_eq(candidates([NamedSort("List", [NamedSort("Unit", [])])], [], []), [
    [VList([])],
    [VList([VUnit])],
    [VList([VUnit, VUnit])],
  ])
}

test "test inputs for a map binder are the empty map and a map with one entry made from the key type's first value and the value type's first value" {
  assert_eq(candidates([NamedSort("Map", [NamedSort("String", []), int()])], [], []), [
    [VMap([])],
    [VMap([{ key: VStr(""), value: VInt(0) }])],
  ]);
  assert_eq(candidates([NamedSort("Map", [int(), FunctionSort([int()], int(), true)])], [], []), [
    [VMap([])],
  ])
}

test "a record is tried with each field at its first value, then each in turn at its second" {
  let made = |a: Bool, b: Int|
    [VRecord([{ name: "a", value: VBool(a) }, { name: "b", value: VInt(b) }])];
  assert_eq(
    candidates(
      [RecordSort([{ name: "b", ty: int() }, { name: "a", ty: NamedSort("Bool", []) }])],
      [],
      [],
    ),
    [made(false, 0), made(false, 1), made(true, 0)],
  )
}

test "test inputs for a declared type use each variant, fill its fields as for a record, and nest only a few levels deep" {
  assert_eq(candidates([NamedSort("m.Shape", [int()])], shapes(), []), [
    [VCtor("m.Dot", [])],
    [VCtor("m.Box", [VInt(0), VBool(false)])],
    [VCtor("m.Box", [VInt(1), VBool(false)])],
    [VCtor("m.Box", [VInt(0), VBool(true)])],
    [VCtor("m.Pile", [VCtor("m.Dot", [])])],
    [VCtor("m.Pile", [VCtor("m.Box", [VInt(0), VBool(false)])])],
  ]);
  assert_eq(candidates([SortVariable(0)], [], []), candidates([int()], [], []))
}

test "a Float is tried at NaN, so a claim false only there is refuted at it" {
  assert(
    candidates([NamedSort("Float", [])], [], []).any(|p: List<Value>|
      match p { [VFloat(x)] -> x != x, _ -> false }),
    Some("no point is NaN"),
  )
}

test "a bound variable whose type has no values to generate, such as a function or an unknown type, produces no test inputs" {
  assert_eq(candidates([int(), FunctionSort([int()], int(), true)], [], []), []);
  assert_eq(candidates([NamedSort("m.Unknown", [])], [], []), [])
}

test "many binders each offer fewer values, so the tuples stay within the budget" {
  assert_eq(values_per_binder(1), 12);
  assert_eq(values_per_binder(3), 12);
  assert_eq(values_per_binder(4), 8);
  assert_eq(values_per_binder(12), 2);
  assert_eq(values_per_binder(13), 1);
  assert_eq(candidates(range(0, 13).map(|_i: Int| int()), [], []).len(), 1);
  assert_eq(candidates(range(0, 12).map(|_i: Int| int()), [], []).len(), 4096)
}
