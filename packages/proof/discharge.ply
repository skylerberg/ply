import std.value (Value, VBool, VInt)
import candidates (candidates)
import decide (StaticResult, Certified, Unwitnessed, GuardRefuted, Undecided, StaticProof,
               FailedAttempt)
import domain (Domain, NamedSort, FunctionSort, finite, point_at)
import lower (Blocker, Lambda, BoundUnshown, blocker_parts)
import obligation (Outcome, Proved, Refuted, Vacuous, Unproved, InternalError, Reason, Open,
                   UnhandledEffect, Raised, NoWitness, DomainTooLarge, Unsearched, Certificate,
                   Binding, Judgement, PointPassed, PointFailed, PointRejected, PointRaised,
                   PointFaulted, Cost, Law, NoWrites, is_proved)
import rules (Rule, GroundEvaluation, ExhaustiveEnumeration, ExhaustiveInterleaving)
import prover_input (Obligation, ProverInput, empty_prover_input, Binder, Strategy, Interleave,
                     Static, Bounded, Unhandled, Run, Every, NotEnumerable, Points)
import sim.plan
import sim.plan (Seed, PartialOrderReduction, seed_text)
import sim.recording (Interleaving, Step, Passed, Failed, VariableAccess)
import sim.search (Exact, Cause, RunFailed, InvalidRecording, Diverged, explore_with_state)
import std.list
import compiler.check.resolve.tables (InSource, Place)

pub type ClaimToDischarge<a> = {
  claim: Int,
  obligation: Obligation,
  resolved: StaticResult,
  reported_as: a,
}

pub type Batch<t> = { claim_index: Int, points: List<List<Value>>, mode: JudgeMode, subject: t }

pub type JudgedBatch<t> = { batch: Batch<t>, judgements: List<Judgement> }

pub type JudgeMode = | WholeClaim | WitnessSearch | GuardFilter

pub type InterleavingRun = { claim_index: Int, point: List<Value>, seed: Seed, steps: Int }

pub type LawRun = { interleaving: Interleaving<Judgement>, observed: Bool }

pub type Runtime<t | e> = {
  judge: (List<Batch<t>>) -> List<JudgedBatch<t>> / e,
  interleave: (InterleavingRun) -> LawRun / e,
}

pub type Decided<a> = { claim: a, outcome: Outcome }

pub fn discharged<a | e>(
  claims: List<ClaimToDischarge<a>>,
  world: ProverInput,
  sim: plan::Plan,
  runtime: Runtime<PlannedClaim<a> | e>,
) -> List<Decided<a>> / {abort.raise | e} = {
  let planned = claims.fold(
    { finished: [], needing: [] },
    |found: { finished: List<Decided<a>>, needing: List<PlannedClaim<a>> }, c: ClaimToDischarge<a>|
      match plan_claim(c, world) {
        Finished(o) ->
          { ..found, finished: found.finished.push({ claim: c.reported_as, outcome: o }) },
        NeedsPoints(p) -> { ..found, needing: found.needing.push({ claim: c, plan: p }) },
      },
  );
  let needing = planned.needing;
  let batches = needing.map(|n: PlannedClaim<a>|
    {
      claim_index: n.claim.claim,
      points: n.plan.points,
      mode: match n.plan.kind {
        LawPoints -> GuardFilter,
        WitnessPoints(_) -> WitnessSearch,
        EveryPoint(_) -> WholeClaim,
        CounterexampleSearch(_) -> WholeClaim,
      },
      subject: n,
    });
  let judged_batches = if batches.len() == 0 { [] } else { (runtime.judge)(batches) };
  planned.finished.concat(
    judged_batches.map(|j: JudgedBatch<PlannedClaim<a>>| {
      let a = j.batch.subject.claim;
      let p = j.batch.subject.plan;
      let js = j.judgements;
      {
        claim: a.reported_as,
        outcome: match p.kind {
          LawPoints -> match admitted_points(a.obligation, p, js) {
            Err(o) -> o,
            Ok(points) -> search_interleavings(a, p, points, sim, runtime.interleave),
          },
          WitnessPoints(c) -> witness_outcome(a.obligation, p, js, c),
          EveryPoint(witness) -> enumeration_outcome(a.obligation, p, js, witness),
          CounterexampleSearch(stopped) -> search_outcome(a.obligation, p, js, stopped),
        },
      }
    }),
  )
}

pub type PlannedClaim<a> = { claim: ClaimToDischarge<a>, plan: PointPlan }

type PointPurpose =
  | EveryPoint(Option<Certificate>)
  | LawPoints
  | WitnessPoints(Certificate)
  | CounterexampleSearch(FailedAttempt)

type PointPlan = {
  kind: PointPurpose,
  points: List<List<Value>>,
  domain: Option<{ name: String, points: Int }>,
}

type ClaimWork = | Finished(Outcome) | NeedsPoints(PointPlan)

fn certificate_of(s: StaticProof, ran: Bool) -> Certificate =
  { rules: s.rules, steps: s.steps, guard_satisfiable: true, sorts: s.sorts, ran: ran }

pub fn guard_place(obligation: Obligation) -> Place =
  match obligation.guards.at(0) { Some(g) -> g, None -> obligation.at }

fn open_reason(s: FailedAttempt) -> Reason =
  Open({
    spent: s.budget_exhausted,
    stopped: s.blockers.map(|b: Blocker| {
      let parts = blocker_parts(b);
      { kind: parts.kind, about: parts.detail }
    }),
  })

fn every_point(domain: Domain) -> Option<List<List<Value>>> / {abort.raise} =
  range(0, domain.points).fold(Some([]), |accumulator: Option<List<List<Value>>>, i: Int|
    match accumulator {
      None -> None,
      Some(points) -> match point_at(domain, i) { Some(vs) -> Some(points.push(vs)), None -> None },
    })

fn plan_claim<a>(claim: ClaimToDischarge<a>, world: ProverInput) -> ClaimWork / {abort.raise} = {
  let o = claim.obligation;
  match o.strategy {
    Interleave(points) -> match points {
      NotEnumerable -> Finished(Unproved(DomainTooLarge)),
      Every(domain, name) -> match every_point(domain) {
        None -> Finished(Unproved(DomainTooLarge)),
        Some(ps) ->
          NeedsPoints({
            kind: LawPoints,
            points: ps,
            domain: Some({ name: name, points: domain.points }),
          }),
      },
    },
    Bounded -> match claim.resolved {
      Certified(s) -> Finished(Proved(certificate_of(s, false))),
      Unwitnessed(s) -> Finished(Proved(certificate_of(s, false))),
      GuardRefuted -> Finished(Vacuous),
      Undecided(stopped) -> Finished(Unproved(open_reason(stopped))),
    },
    Static(after) -> match claim.resolved {
      Certified(s) -> Finished(Proved(certificate_of(s, false))),
      GuardRefuted -> Finished(Vacuous),
      _ -> match after {
        Unhandled(row) -> Finished(Unproved(UnhandledEffect(Some(row)))),
        Run(Every(domain, name)) -> match every_point(domain) {
          None -> plan_search(claim, world),
          Some(ps) ->
            NeedsPoints({
              kind: EveryPoint(match claim.resolved {
                Unwitnessed(s) -> Some(certificate_of(s, true)),
                _ -> None,
              }),
              points: ps,
              domain: Some({ name: name, points: domain.points }),
            }),
        },
        Run(NotEnumerable) -> plan_search(claim, world),
      },
    },
  }
}

fn plan_search<a>(claim: ClaimToDischarge<a>, world: ProverInput) -> ClaimWork / {abort.raise} = {
  let o = claim.obligation;
  let points = if o.binders.fold(false, |any: Bool, b: Binder| any || !b.constructible) { [] }
  else { candidates(o.binders.map(|b: Binder| b.ty), world.declarations, o.literals) };
  match claim.resolved {
    Unwitnessed(s) -> if points.len() == 0 { Finished(Unproved(NoWitness)) } else {
      NeedsPoints({ kind: WitnessPoints(certificate_of(s, true)), points: points, domain: None })
    },
    Undecided(stopped) -> if points.len() == 0 { Finished(Unproved(open_reason(stopped))) }
    else { NeedsPoints({ kind: CounterexampleSearch(stopped), points: points, domain: None }) },
    Certified(s) -> Finished(Proved(certificate_of(s, false))),
    GuardRefuted -> Finished(Vacuous),
  }
}

pub fn bindings(obligation: Obligation, values: List<Value>) -> List<Binding> =
  range(0, min(obligation.binders.len(), values.len())).fold([], |out: List<Binding>, i: Int|
    match ((obligation.binders.at(i), values.at(i))) {
      (Some(b), Some(v)) -> out.push({ name: b.name, ty: b.text, value: v }),
      _ -> out,
    })

fn faulted(
  f: { code: String, message: String, notes: List<String>, values: List<Value> },
  bs: List<Binding>,
) -> Outcome =
  InternalError({
    code: f.code,
    message: f.message,
    notes: f.notes,
    values: f.values,
    bindings: bs,
  })

fn first_decisive(
  obligation: Obligation,
  p: PointPlan,
  js: List<Judgement>,
) -> { held: Int, stop: Option<Outcome> } =
  range(0, js.len()).fold(
    { held: 0, stop: None },
    |accumulator: { held: Int, stop: Option<Outcome> }, i: Int|
      match accumulator.stop {
        Some(_) -> accumulator,
        None -> match ((js.at(i), p.points.at(i))) {
          (Some(PointPassed), _) -> { ..accumulator, held: accumulator.held + 1 },
          (Some(PointFailed), Some(values)) ->
            {
              ..accumulator,
              stop: Some(Refuted({ bindings: bindings(obligation, values), seed: None })),
            },
          (Some(PointRaised(r)), Some(values)) ->
            {
              ..accumulator,
              stop: Some(
                Unproved(
                  Raised({
                    message: r.message,
                    values: r.values,
                    bindings: bindings(obligation, values),
                  }),
                ),
              ),
            },
          (Some(PointFaulted(f)), Some(values)) ->
            { ..accumulator, stop: Some(faulted(f, bindings(obligation, values))) },
          _ -> accumulator,
        },
      },
  )

fn enumeration_outcome(
  obligation: Obligation,
  p: PointPlan,
  js: List<Judgement>,
  witness: Option<Certificate>,
) -> Outcome = {
  let w = first_decisive(obligation, p, js);
  match w.stop {
    Some(o) -> o,
    None -> if w.held == 0 { Vacuous } else {
      match witness {
        Some(c) -> Proved(c),
        None -> {
          let d = match p.domain { Some(x) -> x, None -> { name: "", points: 0 } };
          Proved({
            rules: [
              if obligation.binders.len() == 0 { GroundEvaluation }
              else { ExhaustiveEnumeration({ domain: d.name, points: d.points }) },
            ],
            steps: d.points,
            guard_satisfiable: true,
            sorts: [],
            ran: true,
          })
        },
      }
    },
  }
}

fn witness_outcome(
  obligation: Obligation,
  p: PointPlan,
  js: List<Judgement>,
  c: Certificate,
) -> Outcome =
  range(0, js.len()).fold(Unproved(NoWitness), |found: Outcome, i: Int|
    match found {
      Unproved(_) -> match ((js.at(i), p.points.at(i))) {
        (Some(PointPassed), _) -> Proved(c),
        (Some(PointFaulted(f)), Some(values)) -> faulted(f, bindings(obligation, values)),
        _ -> found,
      },
      _ -> found,
    })

fn search_outcome(
  obligation: Obligation,
  p: PointPlan,
  js: List<Judgement>,
  stopped: FailedAttempt,
) -> Outcome =
  match first_decisive(obligation, p, js).stop {
    Some(o) -> o,
    None -> Unproved(open_reason(stopped)),
  }

fn admitted_points(
  obligation: Obligation,
  p: PointPlan,
  js: List<Judgement>,
) -> Result<List<List<Value>>, Outcome> =
  range(0, js.len()).fold(Ok([]), |accumulator: Result<List<List<Value>>, Outcome>, i: Int|
    match accumulator {
      Err(_) -> accumulator,
      Ok(points) -> match ((js.at(i), p.points.at(i))) {
        (Some(PointPassed), Some(values)) -> Ok(points.push(values)),
        (Some(PointRaised(r)), Some(values)) ->
          Err(
            Unproved(
              Raised({
                message: r.message,
                values: r.values,
                bindings: bindings(obligation, values),
              }),
            ),
          ),
        (Some(PointFaulted(f)), Some(values)) -> Err(faulted(f, bindings(obligation, values))),
        _ -> accumulator,
      },
    })

type Totals = {
  interleavings: Int,
  evaluations: Int,
  exhaustive: Bool,
  exhausted: Bool,
  observed: Bool,
}

type SimulationCount = { entered: Int, observed: Bool }

fn search_interleavings<a | e>(
  claim: ClaimToDischarge<a>,
  p: PointPlan,
  points: List<List<Value>>,
  plan_search: plan::Plan,
  interleave: (InterleavingRun) -> LawRun / e,
) -> Outcome / {abort.raise | e} = {
  let sim = plan::normalized(plan_search);
  let start = {
    totals: {
      interleavings: 0,
      evaluations: 0,
      exhaustive: true,
      exhausted: false,
      observed: true,
    },
    ended: None,
  };
  let ran = points.fold(
    start,
    |accumulator: { totals: Totals, ended: Option<Outcome> }, values: List<Value>|
      match accumulator.ended {
        Some(_) -> accumulator,
        None -> {
          let admitted_points = explore_with_state(
            sim,
            Exact,
            { entered: 0, observed: true },
            |w: SimulationCount, seed: Seed| {
              let r = interleave({
                claim_index: claim.claim,
                point: values,
                seed: seed,
                steps: sim.steps,
              });
              {
                run: r.interleaving,
                state: {
                  entered: if r.observed { w.entered + 1 } else { w.entered },
                  observed: w.observed && r.observed,
                },
              }
            },
          );
          let e = admitted_points.explored.exploration;
          let totals = {
            interleavings: accumulator.totals.interleavings + admitted_points.state.entered,
            evaluations: accumulator.totals.evaluations + e.explored,
            exhaustive: accumulator.totals.exhaustive && e.exhaustive,
            exhausted: accumulator.totals.exhausted || e.exhausted,
            observed: accumulator.totals.observed && admitted_points.state.observed,
          };
          match ((e.failure, admitted_points.explored.failure)) {
            (Some(seed), Some(fl)) ->
              {
                totals: totals,
                ended: Some(law_failed(claim.obligation, values, seed, fl.cause, fl.notes)),
              },
            _ -> { totals: totals, ended: None },
          }
        },
      },
  );
  match ran.ended {
    Some(o) -> o,
    None -> law_outcome(claim.obligation, p, points.len(), sim, ran.totals),
  }
}

fn law_failed(
  obligation: Obligation,
  values: List<Value>,
  seed: Seed,
  reason: Cause<Judgement>,
  notes: List<String>,
) -> Outcome / {abort.raise} = {
  let bs = bindings(obligation, values);
  let again = "reproduce with `--sim once --seed " ++ seed_text(seed)
    ++ "`, and report it with the test's source";
  match reason {
    RunFailed(PointFailed) -> Refuted({ bindings: bs, seed: Some(seed_text(seed)) }),
    RunFailed(PointRaised(r)) ->
      Unproved(Raised({ message: r.message, values: r.values, bindings: bs })),
    RunFailed(PointFaulted(f)) -> faulted({ ..f, notes: f.notes.concat(notes) }, bs),
    RunFailed(_) ->
      InternalError({
        code: "E0505",
        message: "the search over thread interleavings reported a failure for a run that did not fail",
        notes: notes,
        values: [],
        bindings: bs,
      }),
    InvalidRecording(u) ->
      InternalError({
        code: "E0505",
        message: "the scheduler recorded a step that does not match any choice it could make",
        notes: [u.what, again].concat(notes),
        values: [],
        bindings: bs,
      }),
    Diverged(d) ->
      InternalError({
        code: "E0415",
        message: "replaying seed " ++ seed_text(seed) ++ " did not reproduce the recorded schedule",
        notes: [
          d.what,
          "a simulated run must be a pure function of its definition set and its seed; this is an internal error in Ply rather than in the program under test",
          again,
        ].concat(
          notes,
        ),
        values: [],
        bindings: bs,
      }),
  }
}

fn law_outcome(
  obligation: Obligation,
  p: PointPlan,
  admitted_points: Int,
  sim: plan::Plan,
  t: Totals,
) -> Outcome =
  if admitted_points == 0 { Vacuous }
  else if !proves(sim, t) { Unproved(Unsearched(t.evaluations)) } else {
    let d = match p.domain { Some(x) -> x, None -> { name: "", points: 0 } };
    Proved({
      rules: List::push(
        if obligation.binders.len() > 0 {
          [ExhaustiveEnumeration({ domain: d.name, points: d.points })]
        } else { [] },
        ExhaustiveInterleaving(t.interleavings),
      ),
      steps: t.interleavings,
      guard_satisfiable: true,
      sorts: [],
      ran: true,
    })
  }

fn proves(sim: plan::Plan, t: Totals) -> Bool =
  sim.mode == PartialOrderReduction && t.exhaustive && !t.exhausted && t.observed
    && t.interleavings > 0

fn claim_of(binders: List<Binder>, strategy: Strategy) -> Obligation =
  {
    key: "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
    run_key: "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
    owner: "m.claim",
    kind: Law(Some("claim")),
    module: 0,
    at: InSource({ module: 0, start: 1, end: 2 }),
    binders: binders,
    result: None,
    variables: [],
    guards: [InSource({ module: 0, start: 3, end: 4 })],
    literals: [],
    effects: None,
    frame: NoWrites,
    strategy: strategy,
    identities: [],
  }

fn int_binder(name: String) -> Binder =
  { name: name, ty: NamedSort("Int", []), text: "Int", constructible: true }

fn bool_binder(name: String) -> Binder =
  { name: name, ty: NamedSort("Bool", []), text: "Bool", constructible: true }

fn open_claim(binders: List<Binder>) -> Obligation = claim_of(binders, Static(Run(NotEnumerable)))

const bool_claim: Obligation =
  match finite([NamedSort("Bool", [])], []) {
    Some(d) -> claim_of([bool_binder("b")], Static(Run(Every(d, "Bool")))),
    None -> panic("finite"),
  }

fn runtime_of<| e>(
  judge: keep (Batch<PlannedClaim<Int>>) -> List<Judgement> / e,
  interleave: keep (InterleavingRun) -> LawRun / e,
) -> Runtime<PlannedClaim<Int> | e> =
  {
    judge: |bs: List<Batch<PlannedClaim<Int>>>|
      bs.map(|b: Batch<PlannedClaim<Int>>| { batch: b, judgements: judge(b) }),
    interleave: interleave,
  }

fn runtime_from_rule<| e>(
  rule: keep (JudgeMode, List<Value>) -> Judgement / e,
) -> Runtime<PlannedClaim<Int> | e> =
  runtime_of(
    |b: Batch<PlannedClaim<Int>>| b.points.map(|p: List<Value>| rule(b.mode, p)),
    |run: InterleavingRun|
      { interleaving: { steps: [], verdict: Passed, virtual_time: 0 }, observed: false },
  )

fn no_runtime() -> Runtime<PlannedClaim<Int> | {abort.raise}> =
  runtime_of(
    |b: Batch<PlannedClaim<Int>>|
      panic("a claim that already has a result must not send a request to the runtime"),
    |run: InterleavingRun|
      panic("a claim that already has a result must not send a request to the runtime"),
  )

fn reported_outcomes<| e>(
  claims: List<ClaimToDischarge<Int>>,
  sim: plan::Plan,
  runtime: Runtime<PlannedClaim<Int> | e>,
) -> Map<Int, Outcome> / {abort.raise | e} =
  discharged(claims, empty_prover_input, sim, runtime).fold(
    Map::new(),
    |outcomes: Map<Int, Outcome>, d: Decided<Int>| outcomes.insert(d.claim, d.outcome),
  )

fn run_one<| e>(
  obligation: Obligation,
  resolved: StaticResult,
  sim: plan::Plan,
  runtime: Runtime<PlannedClaim<Int> | e>,
) -> Outcome / {abort.raise | e} =
  match reported_outcomes(
      [{ claim: 0, obligation: obligation, resolved: resolved, reported_as: 0 }],
      sim,
      runtime,
    ).get(
      0,
    ) {
    Some(x) -> x,
    None -> panic("checking one claim must report its outcome"),
  }

fn int_of(vs: List<Value>) -> Int / {abort.raise} =
  match vs.at(0) { Some(VInt(k)) -> k, _ -> panic("expected a list whose first value is an `Int`") }

fn binding_values(bs: List<Binding>) -> List<Value> = bs.map(|b: Binding| b.value)

const ground_static_proof: StaticProof = { rules: [GroundEvaluation], steps: 3, sorts: [] }

fn certificate(ran: Bool) -> Certificate =
  { rules: [GroundEvaluation], steps: 3, guard_satisfiable: true, sorts: [], ran: ran }

const undecided: StaticResult = Undecided({ budget_exhausted: false, blockers: [Lambda] })

const left_open: Outcome =
  Unproved(Open({ spent: false, stopped: [{ kind: "lambda", about: None }] }))

test "a claim proved by the static prover is accepted without calling the runtime, and a guard that is never true makes it vacuous" {
  let o = open_claim([int_binder("x")]);
  assert_eq(
    run_one(o, Certified(ground_static_proof), plan::default_plan, no_runtime()),
    Proved(certificate(false)),
  );
  assert_eq(run_one(o, GuardRefuted, plan::default_plan, no_runtime()), Vacuous)
}

test "a claim the prover cannot close is reported open, even when every tested point passes" {
  let passing_runtime = runtime_from_rule(|mode: JudgeMode, p: List<Value>| PointPassed);
  assert_eq(
    run_one(open_claim([int_binder("x")]), undecided, plan::default_plan, passing_runtime),
    left_open,
  );
  assert_eq(
    run_one(
      open_claim([int_binder("x")]),
      Undecided({ budget_exhausted: true, blockers: [] }),
      plan::default_plan,
      passing_runtime,
    ),
    Unproved(Open({ spent: true, stopped: [] })),
  )
}

test "a failing test input refutes a claim, a raised error leaves it unproved, and a Ply fault is an internal error" {
  let o = open_claim([int_binder("x")]);
  let failing = runtime_from_rule(|mode: JudgeMode, p: List<Value>|
    if int_of(p) < 0 { PointFailed } else { PointPassed });
  match run_one(o, undecided, plan::default_plan, failing) {
    Refuted(context) -> {
      assert_eq(binding_values(context.bindings), [VInt(0 - 1)]);
      assert_eq(context.seed, None)
    },
    _ -> panic("not refuted"),
  };
  let raising = runtime_from_rule(|mode: JudgeMode, p: List<Value>|
    if int_of(p) == 1 { PointRaised({ message: "division by zero", values: [] }) }
    else { PointPassed });
  match run_one(o, undecided, plan::default_plan, raising) {
    Unproved(Raised(r)) -> {
      assert_eq(r.message, "division by zero");
      assert_eq(binding_values(r.bindings), [VInt(1)])
    },
    _ -> panic("not a raise"),
  };
  let faulting = runtime_from_rule(|mode: JudgeMode, p: List<Value>|
    PointFaulted({ code: "E0505", message: "Ply failed making the judge", notes: [], values: [] }));
  match run_one(o, undecided, plan::default_plan, faulting) {
    InternalError(f) -> assert_eq((f.code, binding_values(f.bindings)), ("E0505", [VInt(0)])),
    _ -> panic("not an internal error"),
  }
}

test "a proof that depends on a guard is accepted once some point satisfies the guard, and is unproved if no point does" {
  let o = open_claim([int_binder("x")]);
  let admitting = runtime_from_rule(|mode: JudgeMode, p: List<Value>| {
    assert_eq(mode, WitnessSearch);
    if int_of(p) == 1 { PointPassed } else { PointRejected }
  });
  assert_eq(
    run_one(o, Unwitnessed(ground_static_proof), plan::default_plan, admitting),
    Proved(certificate(true)),
  );
  let rejecting = runtime_from_rule(|mode: JudgeMode, p: List<Value>| PointRejected);
  assert_eq(
    run_one(o, Unwitnessed(ground_static_proof), plan::default_plan, rejecting),
    Unproved(NoWitness),
  )
}

test "a claim over a value no program can construct is left open without trying any points" {
  let o = open_claim([{ ..int_binder("t"), constructible: false }]);
  assert_eq(run_one(o, undecided, plan::default_plan, no_runtime()), left_open);
  assert_eq(
    run_one(o, Unwitnessed(ground_static_proof), plan::default_plan, no_runtime()),
    Unproved(NoWitness),
  );
  let f = open_claim([
    {
      name: "f",
      ty: FunctionSort([NamedSort("Int", [])], NamedSort("Int", []), true),
      text: "(Int) -> Int",
      constructible: true,
    },
  ]);
  assert_eq(run_one(f, undecided, plan::default_plan, no_runtime()), left_open)
}

test "checking every value of a finite type proves a claim and records that, and a claim with no variables is proved by one run" {
  let whole_claim_runtime = runtime_from_rule(|mode: JudgeMode, p: List<Value>| {
    assert_eq(mode, WholeClaim);
    PointPassed
  });
  assert_eq(
    run_one(bool_claim, undecided, plan::default_plan, whole_claim_runtime),
    Proved({
      rules: [ExhaustiveEnumeration({ domain: "Bool", points: 2 })],
      steps: 2,
      guard_satisfiable: true,
      sorts: [],
      ran: true,
    }),
  );
  let ground = match finite([], []) {
    Some(d) -> claim_of([], Static(Run(Every(d, "unit")))),
    None -> panic("a ground domain"),
  };
  assert_eq(
    run_one(ground, undecided, plan::default_plan, whole_claim_runtime),
    Proved({ rules: [GroundEvaluation], steps: 1, guard_satisfiable: true, sorts: [], ran: true }),
  );
  assert_eq(
    run_one(bool_claim, Unwitnessed(ground_static_proof), plan::default_plan, whole_claim_runtime),
    Proved(certificate(true)),
  )
}

test "checking a domain stops at the first point where the claim fails, and is vacuous when the guard rejects every point" {
  let failing = runtime_from_rule(|mode: JudgeMode, p: List<Value>|
    if p == [VBool(true)] { PointFailed } else { PointPassed });
  match run_one(bool_claim, undecided, plan::default_plan, failing) {
    Refuted(context) -> assert_eq(binding_values(context.bindings), [VBool(true)]),
    _ -> panic("not refuted"),
  };
  let rejecting = runtime_from_rule(|mode: JudgeMode, p: List<Value>| PointRejected);
  assert_eq(run_one(bool_claim, undecided, plan::default_plan, rejecting), Vacuous);
  let raising = runtime_from_rule(|mode: JudgeMode, p: List<Value>|
    PointRaised({ message: "no", values: [] }));
  assert(match run_one(bool_claim, undecided, plan::default_plan, raising) {
    Unproved(Raised(_)) -> true,
    _ -> false,
  })
}

test "a claim whose function performs an effect with no handler is proved only by the static prover" {
  let o = claim_of([int_binder("x")], Static(Unhandled("{m.store.read}")));
  assert_eq(
    run_one(o, undecided, plan::default_plan, no_runtime()),
    Unproved(UnhandledEffect(Some("{m.store.read}"))),
  );
  assert_eq(
    run_one(o, Unwitnessed(ground_static_proof), plan::default_plan, no_runtime()),
    Unproved(UnhandledEffect(Some("{m.store.read}"))),
  );
  assert(is_proved(run_one(o, Certified(ground_static_proof), plan::default_plan, no_runtime())))
}

test "a cost bound is either proved statically or left open with the reason, and is never run" {
  let o = { ..claim_of([int_binder("n")], Bounded), kind: Cost(0), guards: [] };
  assert_eq(
    run_one(o, Certified(ground_static_proof), plan::default_plan, no_runtime()),
    Proved(certificate(false)),
  );
  assert_eq(
    run_one(
      o,
      Undecided({
        budget_exhausted: false,
        blockers: [BoundUnshown("its steps outgrow the bound")],
      }),
      plan::default_plan,
      no_runtime(),
    ),
    Unproved(
      Open({
        spent: false,
        stopped: [{ kind: "unbounded", about: Some("its steps outgrow the bound") }],
      }),
    ),
  )
}

test "one runtime request checks the inputs of all claims that need it, each claim in the mode its proof state calls for" {
  let runtime: Runtime<PlannedClaim<Int> | {abort.raise}> = {
    judge: |bs: List<Batch<PlannedClaim<Int>>>| {
      assert_eq(
        bs.map(|batch: Batch<PlannedClaim<Int>>|
          (batch.claim_index, batch.points.len(), batch.mode)),
        [(4, 3, WholeClaim), (7, 2, WholeClaim), (9, 3, WitnessSearch)],
      );
      bs.map(|batch: Batch<PlannedClaim<Int>>|
        { batch: batch, judgements: batch.points.map(|p: List<Value>| PointPassed) })
    },
    interleave: |run: InterleavingRun| panic("nothing to search"),
  };
  let outcomes = reported_outcomes(
    [
      { claim: 4, obligation: open_claim([int_binder("x")]), resolved: undecided, reported_as: 4 },
      {
        claim: 5,
        obligation: open_claim([int_binder("x")]),
        resolved: Certified(ground_static_proof),
        reported_as: 5,
      },
      { claim: 7, obligation: bool_claim, resolved: undecided, reported_as: 7 },
      {
        claim: 9,
        obligation: open_claim([int_binder("x")]),
        resolved: Unwitnessed(ground_static_proof),
        reported_as: 9,
      },
    ],
    plan::default_plan,
    runtime,
  );
  assert_eq(
    [4, 5, 7, 9].map(|claim: Int|
      match outcomes.get(claim) { Some(o) -> Some(is_proved(o)), None -> None }),
    [Some(false), Some(true), Some(true), Some(true)],
  )
}

test "each claim is decided once, and claims resolved statically come before those the runtime decides" {
  let passing = runtime_from_rule(|_mode: JudgeMode, _point: List<Value>| PointPassed);
  let decided = discharged(
    [
      { claim: 4, obligation: open_claim([int_binder("x")]), resolved: undecided, reported_as: 4 },
      {
        claim: 5,
        obligation: open_claim([int_binder("x")]),
        resolved: Certified(ground_static_proof),
        reported_as: 5,
      },
    ],
    empty_prover_input,
    plan::default_plan,
    passing,
  );
  assert_eq(decided.map(|d: Decided<Int>| d.claim), [5, 4])
}

fn lost_update_run(
  tasks: Int,
  valid_counter: (Int) -> Bool,
  seed: Seed,
) -> Interleaving<Judgement> / {abort.raise} = {
  let start = {
    program_counter: range(0, tasks).map(|_t: Int| 0),
    reg: range(0, tasks).map(|_t: Int| 0),
    counter: 0,
    steps: [],
  };
  let end = iterate(
    start,
    4 * tasks + 2,
    |st: { program_counter: List<Int>, reg: List<Int>, counter: Int, steps: List<Step> }| {
      let enabled = range(0, tasks).filter(|t: Int|
        match st.program_counter.at(t) { Some(p) -> p < 2, None -> false });
      if enabled.len() == 0 { Stop(st) } else {
        let choice = match seed.path.at(st.steps.len()) {
          Some(c) -> min(c, enabled.len() - 1),
          None -> 0,
        };
        let t = match enabled.at(choice) { Some(x) -> x, None -> 0 };
        let pc = match st.program_counter.at(t) { Some(p) -> p, None -> 0 };
        let reading = pc == 0;
        let reg = if reading { st.reg.set(t, st.counter) } else { st.reg };
        let counter = if reading { st.counter }
        else { match st.reg.at(t) { Some(r) -> r + 1, None -> 0 } };
        Continue({
          program_counter: st.program_counter.set(t, pc + 1),
          reg: reg,
          counter: counter,
          steps: st.steps.push({
            scheduler: 0,
            task: t,
            runnable: enabled,
            choice: choice,
            accesses: [VariableAccess({ handler: 0, index: 0, write: !reading })],
            site: { definition: Some("transfer"), span: None },
            vector_clock: [],
          }),
        })
      }
    },
  );
  {
    steps: end.steps,
    verdict: if valid_counter(end.counter) { Passed } else { Failed(PointFailed) },
    virtual_time: 0,
  }
}

fn law_runtime<| e>(
  run: keep (Seed) -> Interleaving<Judgement> / e,
  observed: Bool,
) -> Runtime<PlannedClaim<Int> | e> =
  runtime_of(
    |b: Batch<PlannedClaim<Int>>| b.points.map(|p: List<Value>| PointPassed),
    |subject: InterleavingRun| { interleaving: run(subject.seed), observed: observed },
  )

const ground_law: Obligation =
  match finite([], []) {
    Some(d) -> claim_of([], Interleave(Every(d, "Unit"))),
    None -> panic("a ground domain"),
  }

const bool_law: Obligation =
  match finite([NamedSort("Bool", [])], []) {
    Some(d) -> claim_of([bool_binder("b")], Interleave(Every(d, "Bool"))),
    None -> panic("finite"),
  }

fn dpor_plan(budget: Int) -> plan::Plan = { ..plan::default_plan, budget: budget }

test "a law that holds under every interleaving is proved, and its certificate records the exhaustive interleaving search" {
  match run_one(
      ground_law,
      undecided,
      dpor_plan(64),
      law_runtime(|seed: Seed| lost_update_run(2, |c: Int| c <= 2, seed), true),
    ) {
    Proved(c) -> {
      assert(c.steps > 1);
      assert(c.ran);
      assert_eq(c.rules, [ExhaustiveInterleaving(c.steps)])
    },
    _ -> panic("not proved"),
  };
  match run_one(
      bool_law,
      undecided,
      dpor_plan(64),
      law_runtime(|seed: Seed| lost_update_run(2, |c: Int| c <= 2, seed), true),
    ) {
    Proved(c) ->
      assert_eq(c.rules.at(0), Some(ExhaustiveEnumeration({ domain: "Bool", points: 2 }))),
    _ -> panic("not proved"),
  }
}

test "a law that fails under some thread schedule is refuted with a replayable seed, and running only that seed fails again" {
  let breaks = |s: Seed| lost_update_run(2, |c: Int| c == 2, s);
  match run_one(ground_law, undecided, dpor_plan(64), law_runtime(breaks, true)) {
    Refuted(context) -> match context.seed {
      Some(text) -> {
        assert(text.contains(":"));
        match plan::parse_seed(text) {
          Some(seed) ->
            assert(
              match run_one(ground_law, undecided, plan::once(seed), law_runtime(breaks, true)) {
                Refuted(_) -> true,
                _ -> false,
              },
            ),
          None -> panic("an unreadable seed"),
        }
      },
      None -> panic("no seed"),
    },
    _ -> panic("not refuted"),
  };
  assert_eq(
    run_one(ground_law, undecided, dpor_plan(64), law_runtime(breaks, true)),
    run_one(ground_law, undecided, dpor_plan(64), law_runtime(breaks, true)),
  )
}

test "a search that stops short of every interleaving proves nothing, and says how many it ran" {
  let lost_update_runtime = law_runtime(
    |seed: Seed| lost_update_run(3, |c: Int| c <= 3, seed),
    true,
  );
  assert_eq(
    run_one(ground_law, undecided, dpor_plan(30), lost_update_runtime),
    Unproved(Unsearched(30)),
  );
  let two = law_runtime(|seed: Seed| lost_update_run(2, |c: Int| c <= 2, seed), true);
  assert(match run_one(ground_law, undecided, plan::random(4), two) {
    Unproved(Unsearched(_)) -> true,
    _ -> false,
  });
  let nowhere = law_runtime(|seed: Seed| { steps: [], verdict: Passed, virtual_time: 0 }, false);
  assert(match run_one(ground_law, undecided, dpor_plan(64), nowhere) {
    Unproved(Unsearched(_)) -> true,
    _ -> false,
  })
}

test "a law over a domain too large to enumerate is unproved as too large, and no interleaving is run" {
  assert_eq(
    run_one(
      claim_of([int_binder("n")], Interleave(NotEnumerable)),
      undecided,
      dpor_plan(64),
      no_runtime(),
    ),
    Unproved(DomainTooLarge),
  )
}

test "a law whose body raises an error is left unproved, and a Ply fault while running it is an internal error" {
  let raising = law_runtime(
    |seed: Seed|
      {
        steps: [],
        verdict: Failed(PointRaised({ message: "divided by zero", values: [] })),
        virtual_time: 0,
      },
    false,
  );
  match run_one(bool_law, undecided, dpor_plan(64), raising) {
    Unproved(Raised(r)) -> assert_eq((r.message, r.bindings.len()), ("divided by zero", 1)),
    _ -> panic("not a raise"),
  };
  let faulting = law_runtime(
    |seed: Seed|
      {
        steps: [],
        verdict: Failed(
          PointFaulted({ code: "E0415", message: "diverged", notes: [], values: [] }),
        ),
        virtual_time: 0,
      },
    false,
  );
  match run_one(bool_law, undecided, dpor_plan(64), faulting) {
    InternalError(f) -> assert_eq((f.code, f.bindings.len()), ("E0415", 1)),
    _ -> panic("not an internal error"),
  }
}

test "a law whose guard rejects every point of its domain is vacuous" {
  let rejecting: Runtime<PlannedClaim<Int> | {abort.raise}> = {
    judge: |bs: List<Batch<PlannedClaim<Int>>>| {
      assert_eq(bs.map(|b: Batch<PlannedClaim<Int>>| b.mode), [GuardFilter]);
      bs.map(|b: Batch<PlannedClaim<Int>>|
        { batch: b, judgements: b.points.map(|p: List<Value>| PointRejected) })
    },
    interleave: |run: InterleavingRun| panic("nothing kept, so nothing to search"),
  };
  assert_eq(run_one(bool_law, undecided, dpor_plan(64), rejecting), Vacuous)
}
