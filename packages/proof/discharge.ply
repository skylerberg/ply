//! `discharge` — what a claim comes to once the static prover has run on it. A proof it made
//! stands. A claim it left open is proved only by running all of it: every point of a domain small
//! enough to walk, and for a law over a simulation every interleaving at each. A claim over
//! any other domain is run at a few small points, which prove nothing: the first its guard admits
//! witnesses a proof made of the claim under that guard, and one it fails at refutes it. The
//! runtime reports only what a point is worth, many claims' points at once.

import std.value (Value, VBool, VInt)
import candidates (candidates)
import decide (StaticResult, Certified, Unwitnessed, GuardRefuted, Undecided, StaticProof,
               FailedAttempt)
import domain (Domain, NamedSort, FunctionSort, finite, point_at)
import lower (Blocker, Lambda, BoundUnshown, blocker_parts)
import obligation (Outcome, Proved, Refuted, Vacuous, Unproved, InternalError, Reason, Open,
                   UnhandledEffect, Raised, NoWitness, DomainTooLarge, Unsearched, Certificate,
                   Binding, Judgement, PointHeld, PointFailed, PointRejected, PointRaised,
                   PointFaulted, Cost, Law, Pure, is_proved)
import rules (Rule, GroundEvaluation, ExhaustiveEnumeration, ExhaustiveInterleaving)
import prover_input (Obligation, ProverInput, empty_prover_input, Binder, Strategy, Interleave,
                     Static, Bounded, Unhandled, Run, Every, NotEnumerable, Points)
import sim.plan
import sim.plan (Seed, Dpor, seed_text)
import sim.recording (Interleaving, Step, Passed, Failed, VariableAccess)
import sim.search (Exact, Cause, RunFailed, InvalidRecording, Diverged, explore_with_state)
import std.list

/// One claim a run discharges: its place in the collection, the claim, and what the static prover
/// resolved for it.
pub type ClaimToDischarge = { claim: Int, obligation: Obligation, resolved: StaticResult }

/// Points the runtime judges for one claim, in order, and how.
pub type Batch = { claim: Int, points: List<List<Value>>, mode: JudgeMode }

/// The whole claim until a point settles it; the guard alone until it admits a point; or the guard
/// alone at every point until it raises.
pub type JudgeMode = | WholeClaim | WitnessSearch | GuardFilter

/// What a discharge asks the runtime, and how it responds: one conversation, because a function
/// names an effect once and a discharge needs both. A law over interleavings is run at one of its
/// points under one seed, within so many scheduling steps.
pub type RuntimeRequest = | JudgePoints(List<Batch>) | RunInterleaving(Int, List<Value>, Seed, Int)

pub type RuntimeReply = | Judgements(List<List<Judgement>>) | Interleaved(LawRun)

/// One run of a law: `observed` when it entered a simulation, without which there was no
/// schedule to vary.
pub type LawRun = { interleaving: Interleaving<Judgement>, observed: Bool }

// --- Discharging ---------------------------------------------------------------

/// Every claim asked, discharged. The runtime judges batches of points, each batch one claim's, and
/// `sim` is the search a law over interleavings runs at each point its guard keeps. `told` is given
/// each claim's outcome as soon as it is known, by the claim's place in the collection: one that
/// needs no run before the runtime is asked anything.
pub fn discharged<| e>(
  asked: List<ClaimToDischarge>,
  world: ProverInput,
  sim: plan::Plan,
  ask: (RuntimeRequest) -> RuntimeReply / e,
  told: (Int, Outcome) -> Unit / e,
) -> List<Outcome> / {abort.raise | e} = {
  let works = asked.map(|a: ClaimToDischarge| plan_claim(a, world));
  range(0, works.len()).fold((), |_: Unit, i: Int|
    match ((works.at(i), asked.at(i))) {
      (Some(Finished(o)), Some(a)) -> told(a.claim, o),
      _ -> (),
    });
  let batches = range(0, works.len()).fold([], |acc: List<Batch>, i: Int|
    match ((works.at(i), asked.at(i))) {
      (Some(NeedsPoints(p)), Some(a)) ->
        acc.push({
          claim: a.claim,
          points: p.points,
          mode: match p.kind {
            LawPoints -> GuardFilter,
            WitnessPoints(_) -> WitnessSearch,
            _ -> WholeClaim,
          },
        }),
      _ -> acc,
    });
  let results = if batches.len() == 0 { [] }
  else { match ask(JudgePoints(batches)) { Judgements(js) -> js, _ -> [] } };
  range(0, works.len()).fold(
    { outcomes: [], next: 0 },
    |acc: { outcomes: List<Outcome>, next: Int }, i: Int|
      match ((works.at(i), asked.at(i))) {
        (Some(Finished(o)), _) -> { ..acc, outcomes: acc.outcomes.push(o) },
        (Some(NeedsPoints(p)), Some(a)) -> {
          let js = match results.at(acc.next) { Some(x) -> x, None -> [] };
          let outcome = match p.kind {
            LawPoints -> match admitted_points(a.obligation, p, js) {
              Err(o) -> o,
              Ok(points) -> search_law(a, p, points, sim, ask),
            },
            WitnessPoints(c) -> witness_outcome(a.obligation, p, js, c),
            EveryPoint(witness) -> enumeration_outcome(a.obligation, p, js, witness),
            CounterexampleSearch(stopped) -> search_outcome(a.obligation, p, js, stopped),
          };
          told(a.claim, outcome);
          { outcomes: acc.outcomes.push(outcome), next: acc.next + 1 }
        },
        _ -> acc,
      },
  ).outcomes
}

/// What a claim's points are judged for: every point of its domain, with the certificate one its
/// guard admits would stand; a law's, whose guard keeps the ones to search; a few, for one its
/// guard admits, which the certificate then stands on; or a few, for one the claim fails at, the
/// static prover having stopped where it says.
type PointPurpose =
  | EveryPoint(Option<Certificate>)
  | LawPoints
  | WitnessPoints(Certificate)
  | CounterexampleSearch(FailedAttempt)

/// One claim's points, and the domain a walk of every point covers.
type PointPlan = {
  kind: PointPurpose,
  points: List<List<Value>>,
  domain: Option<{ name: String, points: Int }>,
}

type ClaimWork = | Finished(Outcome) | NeedsPoints(PointPlan)

fn certificate_of(s: StaticProof, ran: Bool) -> Certificate =
  { rules: s.rules, steps: s.steps, guard_satisfiable: true, sorts: s.sorts, ran: ran }

fn guard_span(obligation: Obligation) -> { module: Int, start: Int, end: Int } =
  match obligation.guards.at(0) { Some(g) -> g, None -> obligation.at }

/// Where the static prover stopped, as a gap says it.
fn open_reason(s: FailedAttempt) -> Reason =
  Open({
    spent: s.spent,
    stopped: s.blockers.map(|b: Blocker| {
      let parts = blocker_parts(b);
      { kind: parts.kind, about: parts.detail }
    }),
  })

/// Every point of `domain`, in order, or nothing where one of them is a value no run makes.
fn every_point(domain: Domain) -> Option<List<List<Value>>> / {abort.raise} =
  range(0, domain.points).fold(Some([]), |acc: Option<List<List<Value>>>, i: Int|
    match acc {
      None -> None,
      Some(points) -> match point_at(domain, i) { Some(vs) -> Some(points.push(vs)), None -> None },
    })

fn plan_claim(asked: ClaimToDischarge, world: ProverInput) -> ClaimWork / {abort.raise} = {
  let o = asked.obligation;
  match o.strategy {
    Interleave(points) -> match points {
      NotEnumerable -> Finished(Unproved(DomainTooLarge)),
      Every(domain, name) -> match every_point(domain) {
        None -> Finished(Unproved(DomainTooLarge)),
        Some(ps) ->
          NeedsPoints({
            kind: LawPoints,
            points: ps,
            domain: Some({ name: name, points: domain.points }),
          }),
      },
    },
    Bounded -> match asked.resolved {
      Certified(s) -> Finished(Proved(certificate_of(s, false))),
      Unwitnessed(s) -> Finished(Proved(certificate_of(s, false))),
      GuardRefuted -> Finished(Vacuous({ guard: guard_span(o) })),
      Undecided(stopped) -> Finished(Unproved(open_reason(stopped))),
    },
    Static(after) -> match asked.resolved {
      Certified(s) -> Finished(Proved(certificate_of(s, false))),
      GuardRefuted -> Finished(Vacuous({ guard: guard_span(o) })),
      _ -> match after {
        Unhandled(row) -> Finished(Unproved(UnhandledEffect(Some(row)))),
        Run(Every(domain, name)) -> match every_point(domain) {
          None -> plan_search(asked, world),
          Some(ps) ->
            NeedsPoints({
              kind: EveryPoint(match asked.resolved {
                Unwitnessed(s) -> Some(certificate_of(s, true)),
                _ -> None,
              }),
              points: ps,
              domain: Some({ name: name, points: domain.points }),
            }),
        },
        Run(NotEnumerable) -> plan_search(asked, world),
      },
    },
  }
}

/// A claim over a domain no run walks whole, tried at the few points its binders offer.
fn plan_search(asked: ClaimToDischarge, world: ProverInput) -> ClaimWork / {abort.raise} = {
  let o = asked.obligation;
  let points = if o.binders.fold(false, |any: Bool, b: Binder| any || !b.made) { [] }
  else { candidates(o.binders.map(|b: Binder| b.ty), world.declarations, o.literals) };
  match asked.resolved {
    Unwitnessed(s) -> if points.len() == 0 { Finished(Unproved(NoWitness)) } else {
      NeedsPoints({ kind: WitnessPoints(certificate_of(s, true)), points: points, domain: None })
    },
    Undecided(stopped) -> if points.len() == 0 { Finished(Unproved(open_reason(stopped))) }
    else { NeedsPoints({ kind: CounterexampleSearch(stopped), points: points, domain: None }) },
    Certified(s) -> Finished(Proved(certificate_of(s, false))),
    GuardRefuted -> Finished(Vacuous({ guard: guard_span(o) })),
  }
}

// --- What the judgements came to ------------------------------------------------

pub fn bindings(obligation: Obligation, values: List<Value>) -> List<Binding> =
  range(0, min(obligation.binders.len(), values.len())).fold([], |out: List<Binding>, i: Int|
    match ((obligation.binders.at(i), values.at(i))) {
      (Some(b), Some(v)) -> out.push({ name: b.name, ty: b.text, value: v }),
      _ -> out,
    })

fn faulted(
  f: { code: String, message: String, notes: List<String>, values: List<Value> },
  bs: List<Binding>,
) -> Outcome =
  InternalError({
    code: f.code,
    message: f.message,
    notes: f.notes,
    values: f.values,
    bindings: bs,
  })

/// The judgements of a whole claim in order: how many points its guard admitted and it held at, and
/// what the first point that settled it came to.
fn first_decisive(
  obligation: Obligation,
  p: PointPlan,
  js: List<Judgement>,
) -> { held: Int, stop: Option<Outcome> } =
  range(0, js.len()).fold(
    { held: 0, stop: None },
    |acc: { held: Int, stop: Option<Outcome> }, i: Int|
      match acc.stop {
        Some(_) -> acc,
        None -> match ((js.at(i), p.points.at(i))) {
          (Some(PointHeld), _) -> { ..acc, held: acc.held + 1 },
          (Some(PointFailed), Some(values)) ->
            { ..acc, stop: Some(Refuted({ bindings: bindings(obligation, values), seed: None })) },
          (Some(PointRaised(r)), Some(values)) ->
            {
              ..acc,
              stop: Some(
                Unproved(
                  Raised({
                    message: r.message,
                    values: r.values,
                    bindings: bindings(obligation, values),
                  }),
                ),
              ),
            },
          (Some(PointFaulted(f)), Some(values)) ->
            { ..acc, stop: Some(faulted(f, bindings(obligation, values))) },
          _ -> acc,
        },
      },
  )

/// Every point of a finite domain, judged: the claim is proved where it held at each its guard
/// admitted, and vacuous where the guard admitted none.
fn enumeration_outcome(
  obligation: Obligation,
  p: PointPlan,
  js: List<Judgement>,
  witness: Option<Certificate>,
) -> Outcome = {
  let w = first_decisive(obligation, p, js);
  match w.stop {
    Some(o) -> o,
    None -> if w.held == 0 { Vacuous({ guard: guard_span(obligation) }) } else {
      match witness {
        Some(c) -> Proved(c),
        None -> {
          let d = match p.domain { Some(x) -> x, None -> { name: "", points: 0 } };
          Proved({
            rules: [
              if obligation.binders.len() == 0 { GroundEvaluation }
              else { ExhaustiveEnumeration({ domain: d.name, points: d.points }) },
            ],
            steps: d.points,
            guard_satisfiable: true,
            sorts: [],
            ran: true,
          })
        },
      }
    },
  }
}

/// A few points judged for one the guard admits: the first stands the proof made of the claim under
/// its guard.
fn witness_outcome(
  obligation: Obligation,
  p: PointPlan,
  js: List<Judgement>,
  c: Certificate,
) -> Outcome =
  range(0, js.len()).fold(Unproved(NoWitness), |found: Outcome, i: Int|
    match found {
      Unproved(_) -> match ((js.at(i), p.points.at(i))) {
        (Some(PointHeld), _) -> Proved(c),
        (Some(PointFaulted(f)), Some(values)) -> faulted(f, bindings(obligation, values)),
        _ -> found,
      },
      _ -> found,
    })

/// A few points judged for one the claim fails at: none found leaves it as open as the static
/// prover left it, however many it held at.
fn search_outcome(
  obligation: Obligation,
  p: PointPlan,
  js: List<Judgement>,
  stopped: FailedAttempt,
) -> Outcome =
  match first_decisive(obligation, p, js).stop {
    Some(o) -> o,
    None -> Unproved(open_reason(stopped)),
  }

/// The points a law's guard admitted, judged one at a time: a raise is the law's own gap.
fn admitted_points(
  obligation: Obligation,
  p: PointPlan,
  js: List<Judgement>,
) -> Result<List<List<Value>>, Outcome> =
  range(0, js.len()).fold(Ok([]), |acc: Result<List<List<Value>>, Outcome>, i: Int|
    match acc {
      Err(_) -> acc,
      Ok(points) -> match ((js.at(i), p.points.at(i))) {
        (Some(PointHeld), Some(values)) -> Ok(points.push(values)),
        (Some(PointRaised(r)), Some(values)) ->
          Err(
            Unproved(
              Raised({
                message: r.message,
                values: r.values,
                bindings: bindings(obligation, values),
              }),
            ),
          ),
        (Some(PointFaulted(f)), Some(values)) -> Err(faulted(f, bindings(obligation, values))),
        _ -> acc,
      },
    })

// --- A law over interleavings -----------------------------------------------------

/// What a law's searches came to across the points they ran at.
type Totals = {
  interleavings: Int,
  evaluations: Int,
  exhaustive: Bool,
  exhausted: Bool,
  observed: Bool,
}

/// What one point's search keeps across its runs: how many entered a simulation, and if all did.
type SimulationCount = { entered: Int, observed: Bool }

/// Each kept point searched in turn; the first failure is the law's.
fn search_law<| e>(
  asked: ClaimToDischarge,
  p: PointPlan,
  points: List<List<Value>>,
  plan_search: plan::Plan,
  ask: (RuntimeRequest) -> RuntimeReply / e,
) -> Outcome / {abort.raise | e} = {
  let sim = plan::normalized(plan_search);
  let start = {
    totals: {
      interleavings: 0,
      evaluations: 0,
      exhaustive: true,
      exhausted: false,
      observed: true,
    },
    ended: None,
  };
  let ran = points.fold(
    start,
    |acc: { totals: Totals, ended: Option<Outcome> }, values: List<Value>|
      match acc.ended {
        Some(_) -> acc,
        None -> {
          let admitted_points = explore_with_state(
            sim,
            Exact,
            { entered: 0, observed: true },
            |w: SimulationCount, seed: Seed|
              match ask(RunInterleaving(asked.claim, values, seed, sim.steps)) {
                Interleaved(r) ->
                  {
                    run: r.interleaving,
                    state: {
                      entered: if r.observed { w.entered + 1 } else { w.entered },
                      observed: w.observed && r.observed,
                    },
                  },
                Judgements(_) -> { run: mismatched_reply(), state: w },
              },
          );
          let e = admitted_points.explored.exploration;
          let totals = {
            interleavings: acc.totals.interleavings + admitted_points.state.entered,
            evaluations: acc.totals.evaluations + e.explored,
            exhaustive: acc.totals.exhaustive && e.exhaustive,
            exhausted: acc.totals.exhausted || e.exhausted,
            observed: acc.totals.observed && admitted_points.state.observed,
          };
          match ((e.failure, admitted_points.explored.failure)) {
            (Some(seed), Some(fl)) ->
              {
                totals: totals,
                ended: Some(law_failed(asked.obligation, values, seed, fl.cause, fl.notes)),
              },
            _ -> { totals: totals, ended: None },
          }
        },
      },
  );
  match ran.ended {
    Some(o) -> o,
    None -> law_held(asked.obligation, p, points.len(), sim, ran.totals),
  }
}

fn mismatched_reply() -> Interleaving<Judgement> =
  {
    steps: [],
    verdict: Failed(
      PointFaulted({
        code: "E0505",
        message: "the runtime returned an interleaving with judgements",
        notes: [],
        values: [],
      }),
    ),
    virtual_time: 0,
  }

/// A body that came to `false` is a refutation, a raise is the program's gap, and a fault or a
/// search Ply cannot trust is Ply's defect. A race's counterexample is an interleaving, reported as
/// it ran.
fn law_failed(
  obligation: Obligation,
  values: List<Value>,
  seed: Seed,
  reason: Cause<Judgement>,
  notes: List<String>,
) -> Outcome / {abort.raise} = {
  let bs = bindings(obligation, values);
  let again = "reproduce with `--sim once --seed " ++ seed_text(seed)
    ++ "`, and report it with the test's source";
  match reason {
    RunFailed(PointFailed) -> Refuted({ bindings: bs, seed: Some(seed_text(seed)) }),
    RunFailed(PointRaised(r)) ->
      Unproved(Raised({ message: r.message, values: r.values, bindings: bs })),
    RunFailed(PointFaulted(f)) -> faulted({ ..f, notes: f.notes.concat(notes) }, bs),
    RunFailed(_) ->
      InternalError({
        code: "E0505",
        message: "an interleaving search failed a run that passed",
        notes: notes,
        values: [],
        bindings: bs,
      }),
    InvalidRecording(u) ->
      InternalError({
        code: "E0505",
        message: "the scheduler recorded a step that does not describe a schedule",
        notes: [u.what, again].concat(notes),
        values: [],
        bindings: bs,
      }),
    Diverged(d) ->
      InternalError({
        code: "E0415",
        message: "replaying seed " ++ seed_text(seed) ++ " did not reproduce the recorded schedule",
        notes: [
          d.what,
          "a simulated run must be a pure function of its definition set and its seed; this is an internal error in Ply rather than in the program under test",
          again,
        ].concat(
          notes,
        ),
        values: [],
        bindings: bs,
      }),
  }
}

/// No point kept is a vacuity, and every interleaving at every point is a proof. A search that
/// stopped short of all of them proves nothing, however many it ran.
fn law_held(
  obligation: Obligation,
  p: PointPlan,
  admitted_points: Int,
  sim: plan::Plan,
  t: Totals,
) -> Outcome =
  if admitted_points == 0 { Vacuous({ guard: guard_span(obligation) }) }
  else if !proves(sim, t) { Unproved(Unsearched(t.evaluations)) } else {
    let d = match p.domain { Some(x) -> x, None -> { name: "", points: 0 } };
    Proved({
      rules: List::push(
        if obligation.binders.len() > 0 {
          [ExhaustiveEnumeration({ domain: d.name, points: d.points })]
        } else { [] },
        ExhaustiveInterleaving(t.interleavings),
      ),
      steps: t.interleavings,
      guard_satisfiable: true,
      sorts: [],
      ran: true,
    })
  }

/// A search that entered no simulation emptied a frontier it never filled, so it proves nothing.
fn proves(sim: plan::Plan, t: Totals) -> Bool =
  sim.mode == Dpor && t.exhaustive && !t.exhausted && t.observed && t.interleavings > 0

// --- Tests ----------------------------------------------------------------------

fn claim_of(binders: List<Binder>, strategy: Strategy) -> Obligation =
  {
    key: "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
    run_key: "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
    owner: "m.claim",
    kind: Law(Some("claim")),
    at: { module: 0, start: 1, end: 2 },
    binders: binders,
    result: None,
    variables: [],
    guards: [{ module: 0, start: 3, end: 4 }],
    literals: [],
    effects: None,
    frame: Pure,
    strategy: strategy,
    identities: [],
  }

fn int_binder(name: String) -> Binder =
  { name: name, ty: NamedSort("Int", []), text: "Int", made: true }

fn bool_binder(name: String) -> Binder =
  { name: name, ty: NamedSort("Bool", []), text: "Bool", made: true }

fn open_claim(binders: List<Binder>) -> Obligation = claim_of(binders, Static(Run(NotEnumerable)))

fn bool_claim() -> Obligation / {abort.raise} =
  match finite([NamedSort("Bool", [])], []) {
    Some(d) -> claim_of([bool_binder("b")], Static(Run(Every(d, "Bool")))),
    None -> panic("finite"),
  }

/// A runtime that judges each point by `rule`, given how it is asked, and searches nothing.
fn judging<| e>(
  rule: keep (JudgeMode, List<Value>) -> Judgement / e,
) -> (RuntimeRequest) -> RuntimeReply / e =
  |ask: RuntimeRequest|
    match ask {
      JudgePoints(bs) ->
        Judgements(bs.map(|b: Batch| b.points.map(|p: List<Value>| rule(b.mode, p)))),
      RunInterleaving(_, _, _, _) ->
        Interleaved({
          interleaving: { steps: [], verdict: Passed, virtual_time: 0 },
          observed: false,
        }),
    }

fn never_asked() -> (RuntimeRequest) -> RuntimeReply / {abort.raise} =
  |ask: RuntimeRequest| panic("a resolved claim asks the runtime nothing")

fn run_one<| e>(
  obligation: Obligation,
  resolved: StaticResult,
  sim: plan::Plan,
  ask: (RuntimeRequest) -> RuntimeReply / e,
) -> Outcome / {abort.raise | e} =
  match discharged(
      [{ claim: 0, obligation: obligation, resolved: resolved }],
      empty_prover_input(),
      sim,
      ask,
      |_claim: Int, _outcome: Outcome| (),
    ).at(
      0,
    ) {
    Some(x) -> x,
    None -> panic("one outcome per claim"),
  }

fn int_of(vs: List<Value>) -> Int / {abort.raise} =
  match vs.at(0) { Some(VInt(k)) -> k, _ -> panic("an Int point") }

fn binding_values(bs: List<Binding>) -> List<Value> = bs.map(|b: Binding| b.value)

fn settlement() -> StaticProof = { rules: [GroundEvaluation], steps: 3, sorts: [] }

fn certificate(ran: Bool) -> Certificate =
  { rules: [GroundEvaluation], steps: 3, guard_satisfiable: true, sorts: [], ran: ran }

fn undecided() -> StaticResult = Undecided({ spent: false, blockers: [Lambda] })

fn left_open() -> Outcome =
  Unproved(Open({ spent: false, stopped: [{ kind: "lambda", about: None }] }))

test "a proof the static prover made stands, and the runtime is asked nothing" {
  let o = open_claim([int_binder("x")]);
  assert_eq(
    run_one(o, Certified(settlement()), plan::default_plan(), never_asked()),
    Proved(certificate(false)),
  );
  assert_eq(
    run_one(o, GuardRefuted, plan::default_plan(), never_asked()),
    Vacuous({ guard: { module: 0, start: 3, end: 4 } }),
  )
}

test "a claim no proof closed stays open, however many points it holds at" {
  let held = judging(|mode: JudgeMode, p: List<Value>| PointHeld);
  assert_eq(
    run_one(open_claim([int_binder("x")]), undecided(), plan::default_plan(), held),
    left_open(),
  );
  // A budget that ran out is said apart from a fragment the prover left.
  assert_eq(
    run_one(
      open_claim([int_binder("x")]),
      Undecided({ spent: true, blockers: [] }),
      plan::default_plan(),
      held,
    ),
    Unproved(Open({ spent: true, stopped: [] })),
  )
}

test "a point the claim fails at refutes it, and a raise at one is its gap" {
  let o = open_claim([int_binder("x")]);
  let failing = judging(|mode: JudgeMode, p: List<Value>|
    if int_of(p) < 0 { PointFailed } else { PointHeld });
  match run_one(o, undecided(), plan::default_plan(), failing) {
    Refuted(context) -> {
      assert_eq(binding_values(context.bindings), [VInt(0 - 1)]);
      assert_eq(context.seed, None)
    },
    _ -> panic("not refuted"),
  };
  let raising = judging(|mode: JudgeMode, p: List<Value>|
    if int_of(p) == 1 { PointRaised({ message: "division by zero", values: [] }) }
    else { PointHeld });
  match run_one(o, undecided(), plan::default_plan(), raising) {
    Unproved(Raised(r)) -> {
      assert_eq(r.message, "division by zero");
      assert_eq(binding_values(r.bindings), [VInt(1)])
    },
    _ -> panic("not a raise"),
  };
  let faulting = judging(|mode: JudgeMode, p: List<Value>|
    PointFaulted({ code: "E0505", message: "Ply failed making the judge", notes: [], values: [] }));
  match run_one(o, undecided(), plan::default_plan(), faulting) {
    InternalError(f) -> assert_eq((f.code, binding_values(f.bindings)), ("E0505", [VInt(0)])),
    _ -> panic("not an internal error"),
  }
}

test "a proof made under a guard stands on the first point the guard admits, and waits for one" {
  let o = open_claim([int_binder("x")]);
  let admitting = judging(|mode: JudgeMode, p: List<Value>| {
    assert_eq(mode, WitnessSearch);
    if int_of(p) == 1 { PointHeld } else { PointRejected }
  });
  assert_eq(
    run_one(o, Unwitnessed(settlement()), plan::default_plan(), admitting),
    Proved(certificate(true)),
  );
  let rejecting = judging(|mode: JudgeMode, p: List<Value>| PointRejected);
  assert_eq(
    run_one(o, Unwitnessed(settlement()), plan::default_plan(), rejecting),
    Unproved(NoWitness),
  )
}

test "a claim over a value no run makes is tried at no point" {
  let o = open_claim([{ ..int_binder("t"), made: false }]);
  assert_eq(run_one(o, undecided(), plan::default_plan(), never_asked()), left_open());
  assert_eq(
    run_one(o, Unwitnessed(settlement()), plan::default_plan(), never_asked()),
    Unproved(NoWitness),
  );
  let f = open_claim([
    {
      name: "f",
      ty: FunctionSort([NamedSort("Int", [])], NamedSort("Int", []), true),
      text: "(Int) -> Int",
      made: true,
    },
  ]);
  assert_eq(run_one(f, undecided(), plan::default_plan(), never_asked()), left_open())
}

test "a finite domain walked whole is a proof that names it, and one point is evaluating" {
  let held = judging(|mode: JudgeMode, p: List<Value>| {
    assert_eq(mode, WholeClaim);
    PointHeld
  });
  assert_eq(
    run_one(bool_claim(), undecided(), plan::default_plan(), held),
    Proved({
      rules: [ExhaustiveEnumeration({ domain: "Bool", points: 2 })],
      steps: 2,
      guard_satisfiable: true,
      sorts: [],
      ran: true,
    }),
  );
  let ground = match finite([], []) {
    Some(d) -> claim_of([], Static(Run(Every(d, "unit")))),
    None -> panic("a ground domain"),
  };
  assert_eq(
    run_one(ground, undecided(), plan::default_plan(), held),
    Proved({ rules: [GroundEvaluation], steps: 1, guard_satisfiable: true, sorts: [], ran: true }),
  );
  // A proof made under the guard stands on any point the walk kept.
  assert_eq(
    run_one(bool_claim(), Unwitnessed(settlement()), plan::default_plan(), held),
    Proved(certificate(true)),
  )
}

test "a walk ends at the point the claim fails at, and one the guard emptied is vacuous" {
  let failing = judging(|mode: JudgeMode, p: List<Value>|
    if p == [VBool(true)] { PointFailed } else { PointHeld });
  match run_one(bool_claim(), undecided(), plan::default_plan(), failing) {
    Refuted(context) -> assert_eq(binding_values(context.bindings), [VBool(true)]),
    _ -> panic("not refuted"),
  };
  let rejecting = judging(|mode: JudgeMode, p: List<Value>| PointRejected);
  assert_eq(
    run_one(bool_claim(), undecided(), plan::default_plan(), rejecting),
    Vacuous({ guard: { module: 0, start: 3, end: 4 } }),
  );
  let raising = judging(|mode: JudgeMode, p: List<Value>|
    PointRaised({ message: "no", values: [] }));
  assert(match run_one(bool_claim(), undecided(), plan::default_plan(), raising) {
    Unproved(Raised(_)) -> true,
    _ -> false,
  })
}

test "an ensures whose owner performs is one only the static prover closes" {
  let o = claim_of([int_binder("x")], Static(Unhandled("{m.store.read}")));
  assert_eq(
    run_one(o, undecided(), plan::default_plan(), never_asked()),
    Unproved(UnhandledEffect(Some("{m.store.read}"))),
  );
  assert_eq(
    run_one(o, Unwitnessed(settlement()), plan::default_plan(), never_asked()),
    Unproved(UnhandledEffect(Some("{m.store.read}"))),
  );
  assert(is_proved(run_one(o, Certified(settlement()), plan::default_plan(), never_asked())))
}

test "a cost bound is proved off its owner's body or stays open with why, and is never run" {
  let o = { ..claim_of([int_binder("n")], Bounded), kind: Cost(0), guards: [] };
  assert_eq(
    run_one(o, Certified(settlement()), plan::default_plan(), never_asked()),
    Proved(certificate(false)),
  );
  assert_eq(
    run_one(
      o,
      Undecided({ spent: false, blockers: [BoundUnshown("its steps outgrow the bound")] }),
      plan::default_plan(),
      never_asked(),
    ),
    Unproved(
      Open({
        spent: false,
        stopped: [{ kind: "unbounded", about: Some("its steps outgrow the bound") }],
      }),
    ),
  )
}

test "a run judges every claim's points in one batch, each as its kind asks" {
  let ask = |a: RuntimeRequest|
    match a {
      JudgePoints(bs) -> {
        assert_eq(bs.map(|batch: Batch| (batch.claim, batch.points.len(), batch.mode)), [
          (4, 3, WholeClaim),
          (7, 2, WholeClaim),
          (9, 3, WitnessSearch),
        ]);
        Judgements(bs.map(|batch: Batch| batch.points.map(|p: List<Value>| PointHeld)))
      },
      RunInterleaving(_, _, _, _) -> panic("nothing to search"),
    };
  let outcomes = discharged(
    [
      { claim: 4, obligation: open_claim([int_binder("x")]), resolved: undecided() },
      { claim: 5, obligation: open_claim([int_binder("x")]), resolved: Certified(settlement()) },
      { claim: 7, obligation: bool_claim(), resolved: undecided() },
      { claim: 9, obligation: open_claim([int_binder("x")]), resolved: Unwitnessed(settlement()) },
    ],
    empty_prover_input(),
    plan::default_plan(),
    ask,
    |_claim: Int, _outcome: Outcome| (),
  );
  assert_eq(outcomes.map(is_proved), [false, true, true, true])
}

/// What a test hears of a discharge, in order.
effect heard {
  write heard(what: String) -> Unit
}

test "each claim is told once as it is decided, a resolved one before the runtime is asked" {
  let order = handle {
    discharged(
      [
        { claim: 4, obligation: open_claim([int_binder("x")]), resolved: undecided() },
        { claim: 5, obligation: open_claim([int_binder("x")]), resolved: Certified(settlement()) },
      ],
      empty_prover_input(),
      plan::default_plan(),
      |a: RuntimeRequest| {
        heard.heard("asked");
        judging(|_mode: JudgeMode, _point: List<Value>| PointHeld)(a)
      },
      |claim: Int, _outcome: Outcome| heard.heard(claim.to_string()),
    )
  } with {
    var said: List<String> = [],
    heard.heard(what) -> {
      said = said.push(what);
    },
    return _outcomes -> said,
  };
  assert_eq(order, ["5", "asked", "4"])
}

/// `tasks` tasks each reading a shared counter and writing it back: the lost update. A choice past
/// the seed's path takes the first enabled task. No clocks, so every dependent pair is a candidate.
fn counter_run(
  tasks: Int,
  holds: (Int) -> Bool,
  seed: Seed,
) -> Interleaving<Judgement> / {abort.raise} = {
  let start = {
    program_counter: range(0, tasks).map(|_t: Int| 0),
    reg: range(0, tasks).map(|_t: Int| 0),
    counter: 0,
    steps: [],
  };
  let end = iterate(
    start,
    4 * tasks + 2,
    |st: { program_counter: List<Int>, reg: List<Int>, counter: Int, steps: List<Step> }| {
      let enabled = range(0, tasks).filter(|t: Int|
        match st.program_counter.at(t) { Some(p) -> p < 2, None -> false });
      if enabled.len() == 0 { Stop(st) } else {
        let choice = match seed.path.at(st.steps.len()) {
          Some(c) -> min(c, enabled.len() - 1),
          None -> 0,
        };
        let t = match enabled.at(choice) { Some(x) -> x, None -> 0 };
        let pc = match st.program_counter.at(t) { Some(p) -> p, None -> 0 };
        let reading = pc == 0;
        let reg = if reading { st.reg.set(t, st.counter) } else { st.reg };
        let counter = if reading { st.counter }
        else { match st.reg.at(t) { Some(r) -> r + 1, None -> 0 } };
        Continue({
          program_counter: st.program_counter.set(t, pc + 1),
          reg: reg,
          counter: counter,
          steps: st.steps.push({
            scheduler: 0,
            task: t,
            enabled: enabled,
            choice: choice,
            accesses: [VariableAccess({ handler: 0, index: 0, write: !reading })],
            site: { definition: Some("transfer"), span: { module: 0, start: 0, end: 0 } },
            stamp: [],
          }),
        })
      }
    },
  );
  {
    steps: end.steps,
    verdict: if holds(end.counter) { Passed } else { Failed(PointFailed) },
    virtual_time: 0,
  }
}

/// A runtime whose guard keeps every point and whose law body is `run` at each seed.
fn law_runtime<| e>(
  run: keep (Seed) -> Interleaving<Judgement> / e,
  observed: Bool,
) -> (RuntimeRequest) -> RuntimeReply / e =
  |ask: RuntimeRequest|
    match ask {
      JudgePoints(bs) -> Judgements(bs.map(|b: Batch| b.points.map(|p: List<Value>| PointHeld))),
      RunInterleaving(_, _, seed, _) ->
        Interleaved({ interleaving: run(seed), observed: observed }),
    }

fn ground_law() -> Obligation / {abort.raise} =
  match finite([], []) {
    Some(d) -> claim_of([], Interleave(Every(d, "Unit"))),
    None -> panic("a ground domain"),
  }

fn bool_law() -> Obligation / {abort.raise} =
  match finite([NamedSort("Bool", [])], []) {
    Some(d) -> claim_of([bool_binder("b")], Interleave(Every(d, "Bool"))),
    None -> panic("finite"),
  }

fn dpor_plan(budget: Int) -> plan::Plan = { ..plan::default_plan(), budget: budget }

test "a law that holds under every interleaving is proved, and its certificate names the search" {
  match run_one(
      ground_law(),
      undecided(),
      dpor_plan(64),
      law_runtime(|seed: Seed| counter_run(2, |c: Int| c <= 2, seed), true),
    ) {
    Proved(c) -> {
      assert(c.steps > 1);
      assert(c.ran);
      assert_eq(c.rules, [ExhaustiveInterleaving(c.steps)])
    },
    _ -> panic("not proved"),
  };
  // A finite value domain is named beside the search.
  match run_one(
      bool_law(),
      undecided(),
      dpor_plan(64),
      law_runtime(|seed: Seed| counter_run(2, |c: Int| c <= 2, seed), true),
    ) {
    Proved(c) ->
      assert_eq(c.rules.at(0), Some(ExhaustiveEnumeration({ domain: "Bool", points: 2 }))),
    _ -> panic("not proved"),
  }
}

test "a law that holds only sometimes is refuted at the interleaving that broke it, which replays" {
  let breaks = |s: Seed| counter_run(2, |c: Int| c == 2, s);
  match run_one(ground_law(), undecided(), dpor_plan(64), law_runtime(breaks, true)) {
    Refuted(context) -> match context.seed {
      Some(text) -> {
        assert(text.contains(":"));
        // The seed it names fails again, alone.
        match plan::parse_seed(text) {
          Some(seed) ->
            assert(
              match run_one(
                  ground_law(),
                  undecided(),
                  plan::once(seed),
                  law_runtime(breaks, true),
                ) {
                Refuted(_) -> true,
                _ -> false,
              },
            ),
          None -> panic("an unreadable seed"),
        }
      },
      None -> panic("no seed"),
    },
    _ -> panic("not refuted"),
  };
  // Two runs over one law agree.
  assert_eq(
    run_one(ground_law(), undecided(), dpor_plan(64), law_runtime(breaks, true)),
    run_one(ground_law(), undecided(), dpor_plan(64), law_runtime(breaks, true)),
  )
}

test "a search that stops short of every interleaving proves nothing, and says how many it ran" {
  let holds = law_runtime(|seed: Seed| counter_run(3, |c: Int| c <= 3, seed), true);
  assert_eq(run_one(ground_law(), undecided(), dpor_plan(30), holds), Unproved(Unsearched(30)));
  let two = law_runtime(|seed: Seed| counter_run(2, |c: Int| c <= 2, seed), true);
  assert(match run_one(ground_law(), undecided(), plan::random(4), two) {
    Unproved(Unsearched(_)) -> true,
    _ -> false,
  });
  // A search that reached no simulation schedules nothing.
  let nowhere = law_runtime(|seed: Seed| { steps: [], verdict: Passed, virtual_time: 0 }, false);
  assert(match run_one(ground_law(), undecided(), dpor_plan(64), nowhere) {
    Unproved(Unsearched(_)) -> true,
    _ -> false,
  })
}

test "a law over a domain no run walks whole is searched at no point" {
  assert_eq(
    run_one(
      claim_of([int_binder("n")], Interleave(NotEnumerable)),
      undecided(),
      dpor_plan(64),
      never_asked(),
    ),
    Unproved(DomainTooLarge),
  )
}

test "a law's body that raises is its gap, and one Ply failed to run is Ply's defect" {
  let raising = law_runtime(
    |seed: Seed|
      {
        steps: [],
        verdict: Failed(PointRaised({ message: "divided by zero", values: [] })),
        virtual_time: 0,
      },
    false,
  );
  match run_one(bool_law(), undecided(), dpor_plan(64), raising) {
    Unproved(Raised(r)) -> assert_eq((r.message, r.bindings.len()), ("divided by zero", 1)),
    _ -> panic("not a raise"),
  };
  let faulting = law_runtime(
    |seed: Seed|
      {
        steps: [],
        verdict: Failed(
          PointFaulted({ code: "E0415", message: "diverged", notes: [], values: [] }),
        ),
        virtual_time: 0,
      },
    false,
  );
  match run_one(bool_law(), undecided(), dpor_plan(64), faulting) {
    InternalError(f) -> assert_eq((f.code, f.bindings.len()), ("E0415", 1)),
    _ -> panic("not an internal error"),
  }
}

test "a law whose guard admits no point of its domain is vacuous" {
  let rejecting = |ask: RuntimeRequest|
    match ask {
      JudgePoints(bs) -> {
        assert_eq(bs.map(|b: Batch| b.mode), [GuardFilter]);
        Judgements(bs.map(|b: Batch| b.points.map(|p: List<Value>| PointRejected)))
      },
      RunInterleaving(_, _, _, _) -> panic("nothing kept, so nothing to search"),
    };
  assert_eq(
    run_one(bool_law(), undecided(), dpor_plan(64), rejecting),
    Vacuous({ guard: { module: 0, start: 3, end: 4 } }),
  )
}
