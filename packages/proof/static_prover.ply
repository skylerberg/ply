import compiler.front.diagnostics (parse_all)
import compiler.front.emitter_input (Analysed, Rejected)
import compiler.front.published (ClaimClause, analyse)
import compiler.front.facts (Analysis)
import compiler.front.rows (module_imports)
import compiler.syntax.items (CostClause, EnsuresClause, RequiresClause, SpaceClause)
import compiler.check.resolve.tables (ParsedModule)
import context (Context, Claims, claims_from_analysis, context, constructor, signature, group_of,
                is_recursive, terminates)
import decide (Certified, Diagnosis, StaticResult, Undecided, GuardRefuted, Unwitnessed, Proved,
               Unknown, decide_and_diagnose, to_static_result, not_attempted)
import goal (Goal, Binder, Limits, BudgetSpent, Open, default_limits, default_prove_budget)
import lemma (Lemma, lemma_of)
import cost (dominated, dominated_space, stated_cost, steps)
import space (space_bound, space_clause_bound)
import lower (ResultAssumed, Blocker, DestructuringLet, Effectful, BoundUnshown, UnprovedCase,
              NotLowered, blocker_parts)
import measure (descent_of)
import obligation (Builds, Cost, Ensures, Law, Space)
import rules (CostBound, SpaceBound, Rule, Cited)
import sort (canonical)
import prover_input (Bounded, NotEnumerable, Measure, Obligation, TrustedLaw, ProverInput,
                     Interleave, Run, Every, measures_in, measures_input, fallback_of,
                     prover_input_of)
import prover_input
import std.list

pub type LocatedLemma = { module: Int, start: Int, lemma: Lemma }

pub type Prover = {
  context: Context,
  claims: Claims,
  limits: Limits,
  proved: List<LocatedLemma>,
  decided: Map<String, Diagnosis>,
  contracts: List<String>,
  imports: List<List<Int>>,
}

pub fn prover_of(claims: Claims, w: ProverInput, budget: Int) -> Prover / {abort.raise} = {
  let context = context(claims, w);
  let limits = { ..default_limits(), steps: budget };
  let shown = w.measures.fold(Map::new(), |m: Map<String, Bool>, x: Measure|
    match check_measure(context, x, limits) { Ok([]) -> m.insert(x.owner, true), _ -> m });
  let measured = {
    context: {
      ..context,
      measured: shown.keys().fold(Map::new(), |m: Map<String, Bool>, name: String|
        if group_of(context, name).fold(true, |all: Bool, member: String|
            all && (shown.contains(member) || !has_measure(context, member))) {
          m.insert(name, true)
        } else { m }),
    },
    claims: claims,
    limits: limits,
    proved: [],
    decided: Map::new(),
    contracts: [],
    imports: w.imports,
  };
  let clauses = w.obligations.filter(|o: Obligation|
    match o.kind { Ensures(_) -> true, _ -> false });
  let contracted = callee_first(context, owners_of(clauses)).fold(
    measured,
    |p: Prover, owner: String| {
      let own = clauses.filter(|o: Obligation| o.owner == owner);
      let written = match p.claims.definitions.get(owner) {
        Some(d) -> d.spec.filter(|c: ClaimClause| c.kind == EnsuresClause).len(),
        None -> 0,
      };
      let decided = own.fold(
        { prover: p, all: own.len() > 0 && own.len() == written },
        |accumulator: { prover: Prover, all: Bool }, o: Obligation|
          match goal_of(accumulator.prover, o) {
            None -> { prover: accumulator.prover, all: false },
            Some(g) -> {
              let d = decide_and_diagnose(accumulator.prover.context, g, accumulator.prover.limits);
              match d.decision {
                Proved(_) ->
                  {
                    prover: {
                      ..accumulator.prover,
                      decided: accumulator.prover.decided.insert(o.key, d),
                    },
                    all: accumulator.all
                      && !d.blockers.any(|b: Blocker|
                        b == Effectful || b == NotLowered || b == DestructuringLet
                          || b == ResultAssumed),
                  },
                _ -> { prover: accumulator.prover, all: false },
              }
            },
          },
      );
      if decided.all { { ..decided.prover, contracts: decided.prover.contracts.push(owner) } }
      else { decided.prover }
    },
  );
  let trusted = w.trusted_laws.fold(contracted, |p: Prover, t: TrustedLaw|
    match p.claims.laws.get(t.key) {
      None -> p,
      Some(l) -> match lemma_of(
          t.key,
          t.label,
          t.binders.map(|b: prover_input::Binder| canonical(b.ty)),
          t.identities,
          Some(l.body),
          |name: String| signature(p.context, name) != None && constructor(p.context, name) == None,
        ) {
        Some(lemma) -> { ..p, proved: p.proved.push({ module: t.module, start: 0, lemma: lemma }) },
        None -> p,
      },
    });
  import_order(w.obligations.filter(lemma_candidate), w.imports).fold(
    trusted,
    |p: Prover, o: Obligation|
      match lemma_at(p, o) {
        None -> p,
        Some(l) -> match goal_of(p, o) {
          None -> p,
          Some(g) -> {
            let d = decide_and_diagnose(p.context, g, limits_for(p, o));
            let decided = { ..p, decided: p.decided.insert(o.key, d) };
            match d.decision {
              Proved(_) ->
                {
                  ..decided,
                  proved: p.proved.push({ module: o.at.module, start: o.at.start, lemma: l }),
                },
              _ -> decided,
            }
          },
        },
      },
  )
}

fn owners_of(os: List<Obligation>) -> List<String> =
  os.fold([], |accumulator: List<String>, o: Obligation|
    if accumulator.contains(o.owner) { accumulator } else { accumulator.push(o.owner) })

fn callee_first(context: Context, owners: List<String>) -> List<String> / {abort.raise} =
  iterate(
    { left: owners, out: [] },
    owners.len() + 1,
    |st: { left: List<String>, out: List<String> }|
      match st.left {
        [] -> Stop(st.out),
        [first, ..] -> {
          let ready = st.left.filter(|n: String|
            match context.claims.definitions.get(n) {
              Some(d) -> !d.refs.any(|r: String| r != n && st.left.contains(r)),
              None -> true,
            });
          let taken = if ready.len() == 0 { [first] } else { ready };
          Continue({
            left: st.left.filter(|n: String| !taken.contains(n)),
            out: st.out.concat(taken),
          })
        },
      },
  )

fn lemma_candidate(o: Obligation) -> Bool =
  match o.kind {
    Law(_) ->
      o.guards.len() == 0 && (match fallback_of(o.strategy) { Some(_) -> true, None -> false }),
    _ -> false,
  }

fn limits_for(p: Prover, o: Obligation) -> Limits =
  match o.kind {
    Law(_) -> match fallback_of(o.strategy) {
      Some(Run(Every(_, _))) -> { ..p.limits, steps: min(p.limits.steps, enumerated_law_budget()) },
      _ -> p.limits,
    },
    _ -> p.limits,
  }

fn enumerated_law_budget() -> Int = 256

fn lemma_at(p: Prover, o: Obligation) -> Option<Lemma> =
  match p.claims.laws.get(o.owner) {
    None -> None,
    Some(l) -> match l.guard {
      Some(_) -> None,
      None ->
        lemma_of(
          o.owner,
          match o.kind { Law(Some(label)) -> label, _ -> o.owner },
          o.binders.map(|b: prover_input::Binder| canonical(b.ty)),
          o.identities,
          Some(l.body),
          |name: String| signature(p.context, name) != None && constructor(p.context, name) == None,
        ),
    },
  }

fn import_order(os: List<Obligation>, imports: List<List<Int>>) -> List<Obligation> = {
  let depth = |m: Int| match imports.at(m) { Some(xs) -> xs.len(), None -> 0 };
  let ahead = |x: Obligation, o: Obligation|
    depth(x.at.module) < depth(o.at.module)
      || (depth(x.at.module) == depth(o.at.module)
      && (x.at.module < o.at.module || (x.at.module == o.at.module && x.at.start <= o.at.start)));
  os.fold([], |accumulator: List<Obligation>, o: Obligation|
    accumulator.filter(|x: Obligation| ahead(x, o)).push(o).concat(
      accumulator.filter(|x: Obligation| !ahead(x, o)),
    ))
}

fn lemmas_for(p: Prover, o: Obligation) -> List<Lemma> = {
  let imported = match p.imports.at(o.at.module) { Some(xs) -> xs, None -> [] };
  p.proved.filter(|x: LocatedLemma|
    (x.module == o.at.module && x.start < o.at.start) || imported.contains(x.module)).map(
    |x: LocatedLemma| x.lemma,
  )
}

pub type UnprovedMeasure = { measure: Measure, reason: List<String>, descends: Bool }

pub fn unproved_measures(
  analysis: Analysis,
  owned: (Bytes) -> Bool,
) -> List<UnprovedMeasure> / {abort.raise} = {
  let measures = measures_in(analysis, owned);
  if measures.len() == 0 { [] } else {
    let w = measures_input(analysis, measures);
    let modules = w.measures.fold([], |accumulator: List<Int>, m: Measure|
      if accumulator.fold(false, |seen: Bool, k: Int| seen || k == m.at.module) { accumulator }
      else { accumulator.push(m.at.module) });
    let context = context(claims_for(analysis, modules, owned), w);
    let limits = { ..default_limits(), steps: default_prove_budget() };
    w.measures.fold([], |accumulator: List<UnprovedMeasure>, m: Measure| {
      let ends = match context.claims.definitions.get(m.owner) {
        Some(d) -> d.terminates,
        None -> false,
      };
      match check_measure(context, m, limits) {
        Ok([]) -> accumulator,
        Ok(reason) -> accumulator.push({ measure: m, reason: reason, descends: ends }),
        Err(reason) ->
          accumulator.push({
            measure: m,
            reason: ["no proof can be stated: " ++ reason],
            descends: ends,
          }),
      }
    })
  }
}

fn check_measure(
  context: Context,
  m: Measure,
  limits: Limits,
) -> Result<List<String>, String> / {abort.raise} =
  match descent_of(context, m.owner) {
    Err(reason) -> Err(reason),
    Ok(body) -> {
      let d = decide_and_diagnose(
        context,
        {
          binders: m.binders.map(|b: prover_input::Binder| { name: b.name, ty: canonical(b.ty) }),
          guards: [],
          result: None,
          body: Some(body),
          lemmas: [],
          assumed_terminating: group_of(context, m.owner),
          partial: true,
          identities: [],
          contracts: [],
          induction_hypothesis: None,
          builds: None,
          tainted: [],
        },
        limits,
      );
      match d.decision {
        Proved(_) -> Ok([]),
        Unknown(u) -> if u.reason == BudgetSpent {
          Ok(["the proof ran out of its limit of " ++ limits.steps.to_string() ++ " steps"])
        } else if d.blockers.all(|b: Blocker| b == UnprovedCase) {
          Ok(["at some recursive call the termination measure is negative or does not decrease"])
        } else {
          Ok(
            d.blockers.map(|b: Blocker| {
              let parts = blocker_parts(b);
              "the proof stopped at " ++ parts.kind
                ++ (match parts.detail { Some(x) -> " `" ++ x ++ "`", None -> "" })
            }),
          )
        },
        _ -> Ok(["no proof was found"]),
      }
    },
  }

fn has_measure(context: Context, name: String) -> Bool =
  match context.claims.definitions.get(name) {
    Some(d) -> match d.measure { Some(_) -> true, None -> false },
    None -> false,
  }

pub fn claims_for(
  analysis: Analysis,
  wanted: List<Int>,
  owned: (Bytes) -> Bool = |m: Bytes| true,
) -> Claims / {abort.raise} =
  claims_from_analysis(analysis, import_closure(analysis.modules, wanted), owned)

pub fn modules_of(analysis: Analysis, os: List<Obligation>) -> List<Int> =
  os.fold([], |accumulator: List<Int>, obligation: Obligation|
    if obligation.at.module >= analysis.modules.len() { range(0, analysis.modules.len()) }
    else if accumulator.fold(false, |seen: Bool, m: Int| seen || m == obligation.at.module) {
      accumulator
    } else { accumulator.push(obligation.at.module) })

fn name_at(modules: List<ParsedModule>, i: Int) -> Bytes =
  match modules.at(i) { Some(m) -> m.name, None -> b"" }

fn import_closure(modules: List<ParsedModule>, from: List<Int>) -> List<Int> / {abort.raise} = {
  let index = range(0, modules.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
    accumulator.insert(name_at(modules, i), i));
  let seen = iterate(
    {
      seen: from.fold(Map::new(), |accumulator: Map<Int, Bool>, i: Int|
        accumulator.insert(i, true)),
      stack: from,
    },
    modules.len() + from.len() + 1,
    |s: { seen: Map<Int, Bool>, stack: List<Int> }|
      match s.stack.at(s.stack.len() - 1) {
        None -> Stop(s.seen),
        Some(i) -> {
          let rest = range(0, s.stack.len() - 1).fold([], |accumulator: List<Int>, k: Int|
            match s.stack.at(k) { Some(x) -> accumulator.push(x), None -> accumulator });
          let imported = match modules.at(i) { Some(m) -> module_imports(m), None -> [] };
          Continue(
            imported.fold(
              { seen: s.seen, stack: rest },
              |accumulator: { seen: Map<Int, Bool>, stack: List<Int> }, name: Bytes|
                match index.get(name) {
                  Some(j) -> if accumulator.seen.contains(j) { accumulator } else {
                    { seen: accumulator.seen.insert(j, true), stack: accumulator.stack.push(j) }
                  },
                  None -> accumulator,
                },
            ),
          )
        },
      },
  );
  range(0, modules.len()).filter(|i: Int| seen.contains(i))
}

pub fn goal_of(p: Prover, obligation: Obligation) -> Option<Goal> = {
  let binders = obligation.binders.concat(match obligation.result {
    Some(r) -> [r],
    None -> [],
  }).map(|binder: prover_input::Binder| { name: binder.name, ty: canonical(binder.ty) });
  match obligation.kind {
    Ensures(index) -> match p.claims.definitions.get(obligation.owner) {
      None -> None,
      Some(d) -> match d.spec.filter(|c: ClaimClause| c.kind == EnsuresClause).at(index) {
        None -> None,
        Some(clause) ->
          Some({
            binders: binders,
            guards: d.spec.filter(|c: ClaimClause| c.kind == RequiresClause).map(
              |c: ClaimClause| Some(c.clause.code),
            ),
            result: match obligation.result { Some(_) -> Some(d.body), None -> None },
            body: Some(clause.clause.code),
            lemmas: lemmas_for(p, obligation),
            assumed_terminating: [],
            partial: false,
            identities: obligation.identities,
            contracts: p.contracts.filter(|n: String| n != obligation.owner),
            induction_hypothesis: if is_recursive(p.context, obligation.owner)
                && terminates(p.context, obligation.owner) {
              Some({ name: obligation.owner, clause: index })
            } else { None },
            builds: None,
            tainted: [],
          }),
      },
    },
    Cost(_) -> None,
    Space(_) -> None,
    Builds(type_name) -> match ((
        p.claims.definitions.get(obligation.owner),
        p.context.invariants.get(type_name),
      )) {
      (Some(d), Some(by)) ->
        Some({
          binders: binders,
          guards: [],
          result: Some(d.body),
          body: None,
          lemmas: lemmas_for(p, obligation),
          assumed_terminating: [],
          partial: true,
          identities: obligation.identities,
          contracts: p.contracts,
          induction_hypothesis: None,
          builds: Some({ type_name: type_name, by: by }),
          tainted: [],
        }),
      _ -> None,
    },
    Law(_) -> match p.claims.laws.get(obligation.owner) {
      None -> None,
      Some(l) ->
        Some({
          binders: binders,
          guards: match l.guard { Some(g) -> [Some(g.code)], None -> [] },
          result: None,
          body: Some(l.body),
          lemmas: lemmas_for(p, obligation),
          assumed_terminating: [],
          partial: false,
          identities: obligation.identities,
          contracts: p.contracts,
          induction_hypothesis: None,
          builds: None,
          tainted: [],
        }),
    },
  }
}

pub fn diagnosis_of(p: Prover, obligation: Obligation) -> Option<Diagnosis> / {abort.raise} =
  match obligation.strategy {
    Interleave(_) -> None,
    Bounded -> match obligation.kind {
      Cost(index) -> Some(check_cost_bound(p.context, obligation.owner, index)),
      Space(index) -> Some(check_space_bound(p.context, obligation.owner, index)),
      Builds(_) -> match goal_of(p, obligation) {
        Some(g) -> Some(decide_and_diagnose(p.context, g, p.limits)),
        None -> None,
      },
      _ -> None,
    },
    _ -> match p.decided.get(obligation.key) {
      Some(d) -> Some(d),
      None -> match goal_of(p, obligation) {
        Some(g) -> Some(decide_and_diagnose(p.context, g, limits_for(p, obligation))),
        None -> None,
      },
    },
  }

pub fn static_result_for(obligation: Obligation, d: Option<Diagnosis>) -> StaticResult =
  match obligation.strategy {
    Interleave(_) -> not_attempted(),
    _ -> match d { Some(x) -> to_static_result(x, obligation.variables), None -> not_attempted() },
  }

pub fn static_result(p: Prover, obligation: Obligation) -> StaticResult / {abort.raise} =
  match obligation.strategy {
    Interleave(_) -> not_attempted(),
    _ -> static_result_for(obligation, diagnosis_of(p, obligation)),
  }

fn check_space_bound(
  context: Context,
  definition: String,
  index: Int,
) -> Diagnosis / {abort.raise} = {
  let open = |reason: String|
    { decision: Unknown({ reason: Open, steps: 0 }), blockers: [BoundUnshown(reason)] };
  match context.claims.definitions.get(definition) {
    None -> open("`" ++ definition ++ "` has no specification to check"),
    Some(d) -> match d.spec.filter(|c: ClaimClause| c.kind == SpaceClause).at(index) {
      None ->
        open("`" ++ definition ++ "` has no space bound at this position in its specification"),
      Some(clause) -> {
        let b = clause.clause.code;
        match space_clause_bound(b, d.params, d.space_parameters) {
          None ->
            open(
              "a space bound may use only the length of a parameter, a declared space name, zero, positive integer literals, and sums, products and `ilog2` of these",
            ),
          Some(bound) -> match space_bound(context, definition) {
            Err(reason) -> open(reason),
            Ok(proved_space) -> if dominated_space(proved_space, bound) {
              {
                decision: Proved({
                  rules: [SpaceBound({ definition: definition })],
                  steps: 1,
                  sorts: [],
                  guard_satisfiable: true,
                }),
                blockers: [],
              }
            } else {
              open(
                "the definition's space cannot be shown to be at most a constant times the bound for every input size, including size zero",
              )
            },
          },
        }
      },
    },
  }
}

fn check_cost_bound(context: Context, definition: String, index: Int) -> Diagnosis / {abort.raise} = {
  let open = |reason: String|
    { decision: Unknown({ reason: Open, steps: 0 }), blockers: [BoundUnshown(reason)] };
  match context.claims.definitions.get(definition) {
    None -> open("`" ++ definition ++ "` has no specification to check"),
    Some(d) -> match d.spec.filter(|c: ClaimClause| c.kind == CostClause).at(index) {
      None ->
        open("`" ++ definition ++ "` has no cost bound at this position in its specification"),
      Some(clause) -> {
        let b = clause.clause.code;
        match stated_cost(b, d.params, d.cost_parameters) {
          None ->
            open(
              "a cost bound may use only the length of a parameter, a declared cost name, positive integer literals, and sums, products and `ilog2` of these",
            ),
          Some(bound) -> match steps(context, definition) {
            Err(reason) -> open(reason),
            Ok(steps) -> if dominated(steps, bound) {
              {
                decision: Proved({
                  rules: [CostBound({ definition: definition })],
                  steps: 1,
                  sorts: [],
                  guard_satisfiable: true,
                }),
                blockers: [],
              }
            } else {
              open(
                "the definition's step count cannot be shown to be at most a constant times the bound for every input size, including size zero",
              )
            },
          },
        }
      },
    },
  }
}

fn analysis_of(sources: List<{ name: Bytes, source_text: Bytes }>) -> Analysis / {abort.raise} =
  match analyse(parse_all(sources)) {
    Rejected(_) -> panic("the fixture failed to check"),
    Analysed(w) -> w,
  }

fn index_of(analysis: Analysis, name: Bytes) -> Int =
  range(0, analysis.modules.len()).fold(-1, |found: Int, i: Int|
    if name_at(analysis.modules, i) == name { i } else { found })

fn claimed(cs: Claims) -> List<Bytes> = cs.definitions.keys().map(Bytes::of_string)

fn obligation_for(analysis: Analysis, owner: String) -> Obligation / {abort.raise} =
  match prover_input_of(analysis, prover_input::every).world.obligations.fold(
      None,
      |found: Option<Obligation>, o: Obligation| if o.owner == owner { Some(o) } else { found },
    ) {
    Some(o) -> o,
    None -> panic("the test program has no proof obligation for this definition"),
  }

test "the claims asked for are a module's and everything it imports, and nothing else" {
  let sources = [
    { name: b"base", source_text: b"pub fn one() -> Int = 1\n" },
    {
      name: b"app",
      source_text: b"import base\nfn two() -> Int ensures result == 2 = base::one() + base::one()\n",
    },
    { name: b"side", source_text: b"fn zero(x: Int) -> Int ensures result == 0 = x - x\n" },
  ];
  let w = analysis_of(sources);
  let names = claimed(claims_for(w, [index_of(w, b"app")]));
  assert(names.fold(false, |f: Bool, n: Bytes| f || n == b"base.one"));
  assert(names.fold(false, |f: Bool, n: Bytes| f || n == b"app.two"));
  assert(!names.fold(false, |f: Bool, n: Bytes| f || n == b"side.zero"))
}

test "an obligation is resolved by what the prover decides, and only when its strategy asks" {
  let sources = [
    {
      name: b"m",
      source_text: b"fn same(x: Int) -> Int ensures result == x = x\nfn bump(x: Int) -> Int requires x < 10 ensures result > x = x + 1\nfn never(x: Int) -> Int requires x > 0 && x < 0 ensures result == 0 = x\n",
    },
  ];
  let w = analysis_of(sources);
  let p = prover_of(claims_for(w, [0]), prover_input_of(w, prover_input::every).world, 10000);
  assert(match static_result(p, obligation_for(w, "m.same")) { Certified(_) -> true, _ -> false });
  let bump = obligation_for(w, "m.bump");
  assert(match static_result(p, bump) { Unwitnessed(_) -> true, _ -> false });
  assert(static_result(p, obligation_for(w, "m.never")) == GuardRefuted);
  assert(static_result(p, { ..bump, strategy: Interleave(NotEnumerable) }) == not_attempted());
  assert(diagnosis_of(p, { ..bump, strategy: Interleave(NotEnumerable) }) == None)
}

test "the static prover certifies a `cost` bound when the definition's body proves it, and otherwise reports the claim as undecided and says why" {
  let sources = [
    {
      name: b"m",
      source_text: b"fn total(xs: List<Int>) -> Int cost xs.len() = xs.fold(0, |a: Int, x: Int| a + x)\nfn wrong(xs: List<Int>) -> Int cost 1 = xs.fold(0, |a: Int, x: Int| a + x)\n",
    },
  ];
  let w = analysis_of(sources);
  let p = prover_of(claims_for(w, [0]), prover_input_of(w, prover_input::every).world, 10000);
  assert(match static_result(p, obligation_for(w, "m.total")) {
    Certified(s) -> s.rules == [CostBound({ definition: "m.total" })],
    _ -> false,
  });
  assert_eq(
    static_result(p, obligation_for(w, "m.wrong")),
    Undecided({
      budget_exhausted: false,
      blockers: [
        BoundUnshown(
          "the definition's step count cannot be shown to be at most a constant times the bound for every input size, including size zero",
        ),
      ],
    }),
  )
}

test "a `space` bound is proved when the function body shows it, and otherwise stays undecided with a reason" {
  let sources = [
    {
      name: b"m",
      source_text: b"fn total(xs: List<Int>) -> Int space 0 = xs.fold(0, |a: Int, x: Int| a + x)\nfn wrong(xs: List<Int>) -> List<Int> space 0 = xs.map(|x: Int| x)\n",
    },
  ];
  let w = analysis_of(sources);
  let p = prover_of(claims_for(w, [0]), prover_input_of(w, prover_input::every).world, 10000);
  assert(match static_result(p, obligation_for(w, "m.total")) {
    Certified(s) -> s.rules == [SpaceBound({ definition: "m.total" })],
    _ -> false,
  });
  assert_eq(
    static_result(p, obligation_for(w, "m.wrong")),
    Undecided({
      budget_exhausted: false,
      blockers: [
        BoundUnshown(
          "the definition's space cannot be shown to be at most a constant times the bound for every input size, including size zero",
        ),
      ],
    }),
  )
}

test "a claim about an imported module relies only on that module's contracts, but a `transparent` function is replaced by its body" {
  let sources = [
    {
      name: b"base",
      source_text: b"pub transparent fn same(x: Int) -> Int = x\npub fn kept(x: Int) -> Int = 0 + x\n",
    },
    {
      name: b"app",
      source_text: b"import base\nfn quad(x: Int) -> Int ensures result == x = base::same(x)\nfn also(x: Int) -> Int ensures result == x = base::kept(x)\n",
    },
  ];
  let w = analysis_of(sources);
  let mine = |m: Bytes| m == b"app";
  let p = prover_of(
    claims_for(w, [index_of(w, b"app")], mine),
    prover_input_of(w, mine).world,
    10000,
  );
  assert(match static_result(p, obligation_for(w, "app.quad")) {
    Certified(_) -> true,
    _ -> false,
  });
  assert(match static_result(p, obligation_for(w, "app.also")) { Certified(_) -> false, _ -> true })
}

test "a proved `law` can be cited as a lemma by claims in modules that import its module" {
  let sources = [
    {
      name: b"base",
      source_text: b"pub fn count(xs: List<Int>) -> Int = match xs { [] -> 0, [_, ..rest] -> 1 + count(rest) }\nlaw \"counting counts\" forall (xs: List<Int>) { count(xs) == xs.len() }\n",
    },
    {
      name: b"app",
      source_text: b"import base\nlaw \"a push counts one more\" forall (xs: List<Int>, x: Int) { base::count(xs.push(x)) == xs.len() + 1 }\n",
    },
  ];
  let w = analysis_of(sources);
  let p = prover_of(
    claims_for(w, range(0, w.modules.len())),
    prover_input_of(w, prover_input::every).world,
    10000,
  );
  assert(match static_result(p, obligation_for(w, "base.counting counts")) {
    Certified(_) -> true,
    _ -> false,
  });
  assert(match static_result(p, obligation_for(w, "app.a push counts one more")) {
    Certified(c) ->
      c.rules.fold(false, |f: Bool, r: Rule|
        f || r == Cited({ law: "base.counting counts", label: "counting counts" })),
    _ -> false,
  })
}

test "a `law` about an imported function that has an `ensures` clause fails to prove, but an `ensures` clause that calls that function proves" {
  let sources = [
    {
      name: b"base",
      source_text: b"fn cube(n: Int) -> Int = n * n * n\npub fn same(n: Int) -> Int ensures result == n = {\n  let _ = cube(n);\n  n\n}\n",
    },
    {
      name: b"app",
      source_text: b"import base\nlaw \"same answers\" forall (n: Int) { base::same(n) == n }\nfn again(n: Int) -> Int ensures result == n = base::same(n)\n",
    },
  ];
  let w = analysis_of(sources);
  let mine = |m: Bytes| m == b"app";
  let p = prover_of(
    claims_for(w, [index_of(w, b"app")], mine),
    prover_input_of(w, mine).world,
    10000,
  );
  assert(match static_result(p, obligation_for(w, "app.same answers")) {
    Certified(_) -> false,
    _ -> true,
  });
  assert(match static_result(p, obligation_for(w, "app.again")) {
    Certified(_) -> true,
    _ -> false,
  })
}

test "a `law` from an imported module can be cited as a lemma even when only the importing module is being proved" {
  let sources = [
    {
      name: b"base",
      source_text: b"pub fn count(xs: List<Int>) -> Int = match xs { [] -> 0, [_, ..rest] -> 1 + count(rest) }\nlaw \"counting counts\" forall (xs: List<Int>) { count(xs) == xs.len() }\n",
    },
    {
      name: b"app",
      source_text: b"import base\nlaw \"a push counts one more\" forall (xs: List<Int>, x: Int) { base::count(xs.push(x)) == xs.len() + 1 }\n",
    },
  ];
  let w = analysis_of(sources);
  let mine = |m: Bytes| m == b"app";
  let p = prover_of(
    claims_for(w, [index_of(w, b"app")], mine),
    prover_input_of(w, mine).world,
    10000,
  );
  assert(match static_result(p, obligation_for(w, "app.a push counts one more")) {
    Certified(_) -> true,
    _ -> false,
  })
}
