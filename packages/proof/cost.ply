//! The steps a call takes, read off its body as monomials over its parameters' sizes (a collection's
//! or text's length, an `Int`'s magnitude), each up to a constant factor. A builtin counts as a
//! step; what is not read leaves a `cost` clause to its fit.

import compiler.front.diagnostics (parse_all)
import compiler.front.emitter_input (Analysed, Rejected)
import compiler.front.published (ClaimClause, analyse)
import compiler.syntax.items (SpecKind, CostClause, SpaceClause, parse)
import compiler.syntax.expressions (prelude_module)
import compiler.check.resolve.tables (Diagnostic)
import compiler.emit.code (Code, Node, CodeLiteral, CodeVar, NDefinition, NConstructor, NBuiltin,
                           CodeUnary, CodeBinary, CodeApply, CodeKnownLambda, CodeIf, CodeBlock,
                           CodeList, CodeRecord, CodeMatch, CodePerform, CodeLabel, CodeLambda,
                           CodeSimulate, CodeParallel, CodeHandle, CodeFieldRead, CodeUpdate,
                           CodeStatement, CodeLet, CodeLetDestructure, CodeDo, CodeField, CodeArm,
                           CodePattern, CodeBindingPattern, CodeConstructorPattern,
                           CodeRecordPattern, CodeListPattern, CodePatternField, Capture, read_name)
import compiler.check.infer.checker (Builtin, builtins)
import compiler.check.infer.definitions (externs_of)
import compiler.syntax.parsing (dummy_span)
import compiler.check.callbacks (CallbackUse, Mapped, Filtered, Updated, callback_use,
                                 prelude_callback_use)
import compiler.syntax.patterns (LiteralInt)
import compiler.check.types (Type, VariableType, NamedType, FunctionType, RecordType, NominalType,
                             Field, int_type, no_effects)
import context (Context, Definition, claims_from_analysis, context, ctor, signature, is_recursive,
                contains_keyed_type)
import domain (FunctionSort, NamedSort)
import std.list
import compiler.prelude_source
import std.result
import prover_input (prover_input_of)

/// The power each parameter's size is raised to, by its index, and each cost name's, by
/// `cost_key`; no entry is power zero.
pub type Monomial = Map<Int, Int>

/// The sum of these, each times a constant, plus a constant.
pub type Polynomial = List<Monomial>

/// What walking an expression finds: its steps, its size where it is a list, map, string, bytes or
/// `Int` the walk can bound, the parameter it is or is a strict part of, the steps a call of it takes
/// where it is a function they are read of, how many calls back into the definition being bounded one
/// path through it makes, and the arguments of each.
type CostSummary = {
  cost: Polynomial,
  size: Option<Polynomial>,
  of: ParameterRelation,
  fun: Option<Polynomial>,
  calls: Int,
  back: List<List<ParameterRelation>>,
}

/// `Same(i)` is parameter `i` itself; `Part(i)`, a tail a list pattern took off it; `Toward`, an
/// `Int` parameter moved by a positive literal toward the limit the path holds it short of.
pub type ParameterRelation = | Same(Int) | Part(Int) | Toward(IndexBound) | Other

/// The `Int` parameter at `index` held short of a limit on a path: below it where `rising`, else
/// above it, and never at it where `strict`.
pub type IndexBound = { index: Int, limit: Limit, rising: Bool, strict: Bool }

/// What holds an index short: the list parameter at which `List::at` found an element there, so
/// the index is at least zero and below its length; the length of a parameter; or a literal.
pub type Limit = | InBounds(Int) | Length(Int) | Literal(Int)

/// How a recursion descends: on a tail of the list parameter a list pattern took a head off, or on
/// an index it moves toward a limit it hands on unchanged.
pub type Descent = | OnTail(Int) | OnIndex(IndexBound)

/// `own` is the definition whose calls back are counted rather than bounded; `known`, the steps of
/// what it calls; `first_order`, whether each builtin calls nothing back; `empty`, a list parameter
/// known empty; `found`, what holds an index short on the path; `missed`, a fact that fails.
type Env = {
  context: Context,
  slots: List<Slot>,
  own: String,
  known: Map<String, Result<Polynomial, String>>,
  first_order: Map<String, Bool>,
  empty: Option<Int>,
  found: List<IndexBound>,
  missed: Option<IndexBound>,
}

type Slot = { size: Option<Polynomial>, of: ParameterRelation, fun: Option<Polynomial> }

pub fn zero() -> Polynomial = []

pub fn constant() -> Polynomial = [Map::new()]

pub fn size_of(i: Int) -> Polynomial = [Map::new().insert(i, 1)]

/// The key of what one call of function parameter `i` takes: the steps, which a `cost` bound reads
/// as at least one, or the space it holds, which a `space` bound reads as possibly none.
pub fn name_key(i: Int) -> Int = 0 - i - 1

fn param_of_key(k: Int) -> Int = if k < 0 { 0 - k - 1 } else { k }

fn monomial_equal(a: Monomial, b: Monomial) -> Bool =
  a.keys().len() == b.keys().len()
    && a.fold(true, |ok: Bool, k: Int, v: Int|
      ok && (match b.get(k) { Some(w) -> w == v, None -> false }))

pub fn plus(a: Polynomial, b: Polynomial) -> Polynomial =
  b.fold(a, |acc: Polynomial, m: Monomial|
    if acc.fold(false, |seen: Bool, x: Monomial| seen || monomial_equal(x, m)) { acc }
    else { acc.push(m) })

fn monomial_times(a: Monomial, b: Monomial) -> Monomial =
  b.fold(a, |acc: Monomial, k: Int, v: Int|
    acc.insert(k, v + (match acc.get(k) { Some(w) -> w, None -> 0 })))

fn times(a: Polynomial, b: Polynomial) -> Polynomial =
  a.fold(zero(), |acc: Polynomial, x: Monomial|
    b.fold(acc, |inner: Polynomial, y: Monomial| plus(inner, [monomial_times(x, y)])))

fn degree(m: Monomial) -> Int = m.fold(0, |acc: Int, _k: Int, v: Int| acc + v)

fn top_degree(p: Polynomial) -> Int = p.fold(0, |acc: Int, m: Monomial| max(acc, degree(m)))

/// `times`, rejected past what a clause states, where reading further only costs.
pub fn product(a: Polynomial, b: Polynomial) -> Result<Polynomial, String> =
  if a.len() * b.len() > 256 || top_degree(a) + top_degree(b) > 8 {
    Err("steps past any bound a clause states")
  } else { Ok(times(a, b)) }

fn power(p: Polynomial, k: Int) -> Result<Polynomial, String> =
  range(0, k).fold(Ok(constant()), |acc: Result<Polynomial, String>, _i: Int|
    match acc { Ok(q) -> product(q, p), Err(_) -> acc })

/// `m` is at most a constant times `n` at every size, zero included: nothing is raised higher in it,
/// and every size in `n` is in it, so that one of them at zero takes `m` to zero with `n`; a name of
/// a function's steps is never zero, where `positive`.
fn below(m: Monomial, n: Monomial, positive: Bool) -> Bool =
  m.fold(true, |ok: Bool, k: Int, v: Int| ok && v <= (match n.get(k) { Some(w) -> w, None -> 0 }))
    && n.fold(true, |ok: Bool, k: Int, _v: Int| ok && ((k < 0 && positive) || m.contains(k)))

/// Every monomial of `steps` is below one of `bound`'s, each cost name being at least a step; a
/// constant is below anything.
pub fn dominated(steps: Polynomial, bound: Polynomial) -> Bool = dominated_with(steps, bound, true)

/// As `dominated`, where a space name may be none, as a function that makes nothing holds.
pub fn dominated_space(space: Polynomial, bound: Polynomial) -> Bool =
  dominated_with(space, bound, false)

fn dominated_with(p: Polynomial, bound: Polynomial, positive: Bool) -> Bool =
  p.fold(true, |ok: Bool, m: Monomial|
    ok
      && (m.keys().len() == 0
      || bound.fold(false, |found: Bool, n: Monomial| found || below(m, n, positive))))

/// `p`, a bound over a callee's parameters, at the sizes its arguments have and the steps of a call of
/// each function it is given.
pub fn at_args(
  p: Polynomial,
  args: List<Option<Polynomial>>,
  funs: List<Option<Polynomial>>,
) -> Result<Polynomial, String> =
  p.fold(Ok(zero()), |acc: Result<Polynomial, String>, m: Monomial|
    match acc {
      Err(_) -> acc,
      Ok(sofar) -> match m.fold(Ok(constant()), |r: Result<Polynomial, String>, k: Int, v: Int|
          match r {
            Err(_) -> r,
            Ok(q) -> match List::at(if k < 0 { funs } else { args }, param_of_key(k)) {
              Some(Some(s)) -> match power(s, v) {
                Ok(sv) -> product(q, sv),
                Err(reason) -> Err(reason),
              },
              _ ->
                Err(if k < 0 {
                  "a callee's steps grow with a function it is given whose steps are not read"
                } else { "a callee's steps grow with an argument whose size is not read" }),
            },
          }) {
        Ok(q) -> Ok(plus(sofar, q)),
        Err(reason) -> Err(reason),
      },
    })

// --- A bound's own reading ----------------------------------------------------------------------

/// The bound a clause states, read from below: a reading that is at most a constant times it, plus a
/// constant, at every size. It reads lengths, the names of `named`'s parameters, positive literals,
/// sums, products and `ilog2`. An `Int` parameter is no size here, since it may be negative.
pub fn stated_cost(bound: Code, params: Int, named: List<Int>) -> Option<Polynomial> =
  match reading(bound, { params: params, named: named }) { Some(r) -> Some(r.poly), None -> None }

/// What a bound's slots are: the parameters, then a cost or space name for each of `named`.
type Scope = { params: Int, named: List<Int> }

/// The name a slot holds, as the key of what one call of its parameter takes.
fn name_of(sc: Scope, c: Code) -> Option<Int> =
  match c.node {
    CodeVar(v) -> {
      let k = v.slot;
      if k < sc.params { None }
      else { match sc.named.at(k - sc.params) { Some(i) -> Some(name_key(i)), None -> None } }
    },
    NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) ->
      None,
    _ -> None,
  }

/// `exact` where the reading is at most a constant times the bound, with no constant beside it. Only
/// `ilog2` reads loosely: it is zero below 2, so it reads as 1 alone, or times sizes of the one
/// length it takes, which are at most 1 where it is zero.
type Reading = { poly: Polynomial, exact: Bool }

fn reading(bound: Code, sc: Scope) -> Option<Reading> =
  match bound.node {
    CodeVar(_) -> match name_of(sc, bound) {
      Some(k) -> Some({ poly: [Map::new().insert(k, 1)], exact: true }),
      None -> None,
    },
    CodeLiteral(l) -> match l {
      LiteralInt(k) -> if k > 0 { Some({ poly: constant(), exact: true }) } else { None },
      _ -> None,
    },
    CodeBinary(b) -> if b.op == b"add" {
      match ((reading(b.lhs, sc), reading(b.rhs, sc))) {
        (Some(x), Some(y)) -> Some({ poly: plus(x.poly, y.poly), exact: x.exact && y.exact }),
        _ -> None,
      }
    } else if b.op == b"mul" {
      match ((log_length_param(b.lhs, sc.params), log_length_param(b.rhs, sc.params))) {
        (Some(k), None) -> times_log(k, reading(b.rhs, sc)),
        (None, Some(k)) -> times_log(k, reading(b.lhs, sc)),
        (Some(_), Some(_)) -> Some({ poly: constant(), exact: false }),
        (None, None) -> match ((reading(b.lhs, sc), reading(b.rhs, sc))) {
          (Some(x), Some(y)) -> if x.exact && y.exact {
            match product(x.poly, y.poly) {
              Ok(p) -> Some({ poly: p, exact: true }),
              Err(_) -> None,
            }
          } else { None },
          _ -> None,
        },
      }
    } else { None },
    CodeApply(_) -> match log_length_param(bound, sc.params) {
      Some(_) -> Some({ poly: constant(), exact: false }),
      None -> match length_of(bound, sc.params) {
        Some(k) -> Some({ poly: size_of(k), exact: true }),
        None -> None,
      },
    },
    _ -> None,
  }

/// `ilog2(e)`: the parameter `e` is the length of, where it is one, else -1.
fn log_length_param(c: Code, params: Int) -> Option<Int> =
  match c.node {
    CodeApply(a) -> match ((read_name(a.function), a.args)) {
      (Some(f), [arg]) -> if f == b"std.math.ilog2" {
        Some(match length_of(arg, params) { Some(k) -> k, None -> 0 - 1 })
      } else { None },
      _ -> None,
    },
    _ -> None,
  }

/// `r` times `ilog2` of the length of parameter `k`: read as `r` where `r` is exact and grows with
/// that length alone, since below 2 it is then at most a constant.
fn times_log(k: Int, r: Option<Reading>) -> Option<Reading> =
  match r {
    Some(x) -> if k >= 0 && x.exact
        && x.poly.fold(true, |ok: Bool, m: Monomial|
          ok && m.fold(true, |o: Bool, j: Int, _v: Int| o && j == k)) {
      Some({ poly: x.poly, exact: false })
    } else { None },
    None -> None,
  }

/// The parameter `c` takes the length of, where it is `List::len` or the like of one.
fn length_of(c: Code, params: Int) -> Option<Int> =
  match c.node {
    CodeApply(a) -> match ((read_name(a.function), a.args)) {
      (Some(f), [arg]) -> if !is_length(String::of_bytes_lossy(f)) { None } else {
        match arg.node {
          CodeVar(v) -> if v.slot < params { Some(v.slot) } else { None },
          _ -> None,
        }
      },
      _ -> None,
    },
    _ -> None,
  }

pub fn is_length(name: String) -> Bool =
  name == "List::len" || name == "Map::len" || name == "String::len" || name == "Bytes::len"
    || name == "Array::len"
    || name == "Columns::len"

// --- The steps of a body ------------------------------------------------------------------------

/// The steps of `definition` and every definition it reaches, each read once, callees before callers. A
/// definition in a group with others is never ready, so neither is anything that calls it.
pub fn steps(context: Context, definition: String) -> Result<Polynomial, String> / {abort.raise} = {
  let first_order = first_order_builtins();
  let reach = reachable(context, definition);
  let known = iterate(
    Map::new(),
    reach.len() + 1,
    |known: Map<String, Result<Polynomial, String>>| {
      let ready = reach.filter(|n: String|
        !known.contains(n)
          && callees(context, n).fold(true, |all: Bool, c: String|
            all && (c == n || known.contains(c))));
      if ready.len() == 0 { Stop(known) } else {
        Continue(
          ready.fold(known, |k: Map<String, Result<Polynomial, String>>, n: String|
            k.insert(n, if by_entry(context, n, CostClause) {
              Err("`" ++ n ++ "` is read by its entry")
            } else { steps_of(context, first_order, n, k) })),
        )
      }
    },
  );
  match holding_keyed(context, reach) {
    Some(n) ->
      Err(
        "`" ++ n
          ++ "` holds a value compared by its type's `key`, which a comparison calls and no body shows",
      ),
    None -> match known.get(definition) {
      Some(r) -> r,
      None -> Err("`" ++ definition ++ "` reaches definitions that call each other"),
    },
  }
}

/// The first of `definitions` that takes, returns or builds a value of a type stating a `key` or a
/// `numeric`, or that holds one: comparing two, or an operator over them, is a call no body shows.
pub fn holding_keyed(context: Context, definitions: List<String>) -> Option<String> =
  if context.keyed_types.len() == 0 { None } else {
    definitions.fold(None, |found: Option<String>, n: String|
      match found {
        Some(_) -> found,
        None -> {
          let signed = match signature(context, n) {
            Some(s) -> contains_keyed_type(context, s.ty),
            None -> false,
          };
          let built = match context.claims.definitions.get(n) {
            Some(d) ->
              d.refs.fold(false, |any: Bool, r: String|
                any
                  || (match ctor(context, r) {
                    Some(c) -> context.keyed_types.contains(c.declaration.name),
                    None -> false,
                  })),
            None -> false,
          };
          if signed || built { Some(n) } else { None }
        },
      })
  }

/// Every native by the name a call reaches it by: the prelude's builtins, and the natives of the
/// types it declares, which the bodies it writes in Ply call by their program-wide names.
pub fn natives() -> List<Builtin> / {abort.raise} =
  builtins().concat(externs_of(prelude_module(), parse(prelude_source::text()).node))

/// Each native, and whether it calls nothing it is handed back.
pub fn first_order_builtins() -> Map<String, Bool> / {abort.raise} =
  natives().fold(Map::new(), |m: Map<String, Bool>, b: Builtin|
    m.insert(String::of_bytes_lossy(b.name), match b.scheme.ty {
      FunctionType(f) -> !f.params.fold(false, |any: Bool, t: Type| any || calls_back(t)),
      _ -> true,
    }))

/// Whether a value of `t` may be a function a builtin handed it calls.
fn calls_back(t: Type) -> Bool =
  match t {
    VariableType(_) -> false,
    FunctionType(_) -> true,
    NamedType(c) -> c.args.fold(false, |any: Bool, a: Type| any || calls_back(a)),
    RecordType(fs) -> fs.fold(false, |any: Bool, f: Field| any || calls_back(f.ty)),
    NominalType(n) -> n.fields.fold(false, |any: Bool, f: Field| any || calls_back(f.ty)),
  }

/// What `definition`'s body calls, unless no reader reads the body, the steps and the space of a call of it
/// read alike by its entry.
pub fn callees(context: Context, definition: String) -> List<String> =
  match context.claims.definitions.get(definition) {
    Some(d) -> if by_entry(context, definition, CostClause)
        && by_entry(context, definition, SpaceClause) { [] }
    else { d.refs.filter(|n: String| context.claims.definitions.contains(n)) },
    None -> [],
  }

pub fn reachable(context: Context, definition: String) -> List<String> / {abort.raise} =
  iterate(
    { seen: [definition], frontier: [definition] },
    context.claims.definitions.keys().len() + 1,
    |s: { seen: List<String>, frontier: List<String> }|
      if s.frontier.len() == 0 { Stop(s.seen) } else {
        let next = s.frontier.fold(
          { seen: s.seen, frontier: [] },
          |acc: { seen: List<String>, frontier: List<String> }, n: String|
            callees(context, n).fold(
              acc,
              |a: { seen: List<String>, frontier: List<String> }, c: String|
                if a.seen.fold(false, |hit: Bool, x: String| hit || x == c) { a }
                else { { seen: a.seen.push(c), frontier: a.frontier.push(c) } },
            ),
        );
        Continue(next)
      },
  )

/// The bound on the steps a call of `definition` takes, over its parameters' sizes, with its callees' in
/// `known`.
fn steps_of(
  context: Context,
  first_order: Map<String, Bool>,
  definition: String,
  known: Map<String, Result<Polynomial, String>>,
) -> Result<Polynomial, String> / {abort.raise} =
  match context.claims.definitions.get(definition) {
    None -> Err("`" ++ definition ++ "` has no body here to read"),
    Some(d) -> match d.body {
      None -> promised(definition, d),
      Some(body) -> {
        let sized = params_sized(context, definition, d.params);
        let env = {
          context: context,
          slots: range(0, d.params).map(|i: Int|
            {
              size: if at_or(sized, i, false) { Some(size_of(i)) } else { None },
              of: Same(i),
              fun: if d.cost_parameters.contains(i) { Some([Map::new().insert(name_key(i), 1)]) }
              else { None },
            }),
          own: definition,
          known: known,
          first_order: first_order,
          empty: None,
          found: [],
          missed: None,
        };
        match walk(env, body) {
          Err(reason) -> Err(reason),
          Ok(w) -> if !is_recursive(context, definition) { Ok(plus(constant(), w.cost)) }
          else if !context.self_recursive.contains(definition) {
            Err("`" ++ definition ++ "` is in a group with others")
          } else {
            match recursion_descent(definition, w.calls, w.back, w.cost, "steps grow") {
              Err(reason) -> Err(reason),
              Ok(None) -> Ok(plus(constant(), w.cost)),
              // At most as many calls as the descent bounds enter with an element left to take or
              // the index short of its limit, and at most one without, which takes no path that
              // needs one.
              Ok(Some(d)) -> {
                let last = match d {
                  OnTail(p) ->
                    {
                      ..env,
                      empty: Some(p),
                      slots: env.slots.set(p, { size: Some(zero()), of: Same(p), fun: None }),
                    },
                  OnIndex(f) -> { ..env, missed: Some(f) },
                };
                match walk(last, body) {
                  Err(reason) -> Err(reason),
                  Ok(e) -> match product(descent_calls(d), plus(constant(), w.cost)) {
                    Ok(chain) -> Ok(plus(chain, plus(constant(), e.cost))),
                    Err(reason) -> Err(reason),
                  },
                }
              },
            }
          },
        }
      },
    },
  }

/// A definition read by its contract, as another package's is: its first `cost` bound read from
/// above.
fn promised(definition: String, d: Definition) -> Result<Polynomial, String> =
  match d.spec.filter(|c: ClaimClause| c.kind == CostClause).fold(
      None,
      |found: Option<Polynomial>, c: ClaimClause|
        match found {
          Some(_) -> found,
          None -> ceiling(c.clause.code, { params: d.params, named: d.cost_parameters }),
        },
    ) {
    Some(p) -> Ok(plus(constant(), p)),
    None ->
      Err(
        "`" ++ definition ++ "` has no body here to read, and no `cost` bound to read as its steps",
      ),
  }

/// A bound over `params` parameters and the names of `named`'s, read from above as `ceiling` reads
/// one.
pub fn ceiling_of(c: Code, params: Int, named: List<Int>) -> Option<Polynomial> =
  ceiling(c, { params: params, named: named })

/// A bound read from above: what is at least it, up to a constant factor and a constant, at every
/// size. An `Int` parameter reads as its magnitude, a quotient or remainder as its left, `ilog2` as
/// what it is of, and a cost or space name as what a call of the function it is given takes.
fn ceiling(c: Code, sc: Scope) -> Option<Polynomial> =
  match c.node {
    CodeLiteral(l) -> match l { LiteralInt(_) -> Some(constant()), _ -> None },
    CodeVar(v) -> {
      let k = v.slot;
      if k < sc.params { Some(size_of(k)) }
      else { match name_of(sc, c) { Some(key) -> Some([Map::new().insert(key, 1)]), None -> None } }
    },
    NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) ->
      None,
    CodeUnary(u) -> if u.op == b"neg" { ceiling(u.operand, sc) } else { None },
    CodeBinary(b) -> match ((ceiling(b.lhs, sc), ceiling(b.rhs, sc))) {
      (Some(x), Some(y)) -> if b.op == b"add" || b.op == b"sub" { Some(plus(x, y)) }
      else if b.op == b"mul" { match product(x, y) { Ok(p) -> Some(p), Err(_) -> None } }
      else if b.op == b"div" || b.op == b"rem" { Some(x) }
      else { None },
      _ -> None,
    },
    CodeApply(_) -> match length_of(c, sc.params) {
      Some(k) -> Some(size_of(k)),
      None -> match c.node {
        CodeApply(a) -> match ((read_name(a.function), a.args)) {
          (Some(f), [arg]) -> if f == b"std.math.ilog2" { ceiling(arg, sc) } else { None },
          _ -> None,
        },
        _ -> None,
      },
    },
    _ -> None,
  }

fn at_or(xs: List<Bool>, i: Int, fallback: Bool) -> Bool =
  match xs.at(i) { Some(x) -> x, None -> fallback }

pub fn params_sized(context: Context, definition: String, params: Int) -> List<Bool> =
  match signature(context, definition) {
    Some(s) -> match s.ty {
      FunctionSort(ps, _, _) ->
        range(0, params).map(|i: Int|
          match ps.at(i) {
            Some(NamedSort(n, _)) ->
              n == "List" || n == "Map" || n == "String" || n == "Bytes" || n == "Int"
                || n == "Array"
                || n == "Columns",
            _ -> false,
          }),
      _ -> range(0, params).map(|_i: Int| false),
    },
    None -> range(0, params).map(|_i: Int| false),
  }

/// How a recursion descends, where it calls back at all: every call back takes a strict part of one
/// list parameter, or hands an `Int` parameter on moved toward a limit the path held it short of,
/// and any parameter that limit is of on unchanged; it calls back at most once on each path, and
/// hands every other parameter what `grows` grows with on unchanged or a part. A call that calls
/// back took a head off that list, or held its index short of the limit and moved it at least one
/// closer, so at most `descent_calls` of them do, each spending at most what one body does.
pub fn recursion_descent(
  definition: String,
  calls: Int,
  back: List<List<ParameterRelation>>,
  grows: Polynomial,
  what: String,
) -> Result<Option<Descent>, String> =
  if calls > 1 { Err("`" ++ definition ++ "` calls itself more than once on one path") }
  else if back.len() == 0 { Ok(None) } else {
    let first = match back.at(0) { Some(args) -> args, None -> [] };
    let tail = range(0, first.len()).fold(None, |found: Option<Descent>, i: Int|
      match found {
        Some(_) -> found,
        None -> if every_call(back, |args: List<ParameterRelation>|
            match args.at(i) { Some(Part(j)) -> j == i, _ -> false }) { Some(OnTail(i)) }
        else { None },
      });
    let index = match tail {
      Some(_) -> tail,
      None ->
        range(0, first.len()).fold(None, |found: Option<Descent>, i: Int|
          match ((found, first.at(i))) {
            (None, Some(Toward(f))) -> if f.index == i
                && every_call(back, |args: List<ParameterRelation>|
                  args.at(i) == Some(Toward(f)) && limit_preserved(f.limit, args)) {
              Some(OnIndex(f))
            } else { None },
            _ -> found,
          }),
    };
    match index {
      None ->
        Err(
          "`" ++ definition
            ++ "` does not call itself on a part of one list parameter, or on an index moved toward a limit it holds it short of, every time",
        ),
      Some(d) -> if !growth_preserved(grows, back) {
        Err("`" ++ definition ++ "` hands on a parameter its " ++ what ++ " with, changed")
      } else { Ok(Some(d)) },
    }
  }

fn every_call(back: List<List<ParameterRelation>>, at: (List<ParameterRelation>) -> Bool) -> Bool =
  back.fold(true, |all: Bool, args: List<ParameterRelation>| all && at(args))

/// A call hands on unchanged the parameter `l` is of.
fn limit_preserved(l: Limit, args: List<ParameterRelation>) -> Bool =
  match l {
    InBounds(p) -> args.at(p) == Some(Same(p)),
    Length(p) -> args.at(p) == Some(Same(p)),
    Literal(_) -> true,
  }

/// How many calls that call back a recursion descending as `d` makes, up to a constant: the length
/// of the list it takes heads off, or how far its index lies from its limit, which an index
/// `List::at` found an element at lies no farther than the list's length.
pub fn descent_calls(d: Descent) -> Polynomial =
  match d {
    OnTail(p) -> size_of(p),
    OnIndex(f) -> {
      let far = match f.limit {
        InBounds(p) -> size_of(p),
        Length(p) -> plus(size_of(p), size_of(f.index)),
        Literal(_) -> plus(constant(), size_of(f.index)),
      };
      if f.strict { far } else { plus(far, constant()) }
    },
  }

/// Every call back hands each parameter `p` grows with on unchanged or as a part of itself.
pub fn growth_preserved(p: Polynomial, back: List<List<ParameterRelation>>) -> Bool =
  p.fold([], |acc: List<Int>, m: Monomial| acc.concat(m.keys().map(param_of_key))).fold(
    true,
    |ok: Bool, q: Int|
      ok
        && back.fold(true, |all: Bool, args: List<ParameterRelation>|
          all
            && (match args.at(q) { Some(Same(j)) -> j == q, Some(Part(j)) -> j == q, _ -> false })),
  )

fn no_cost() -> CostSummary = { cost: zero(), size: None, of: Other, fun: None, calls: 0, back: [] }

fn sized(p: Polynomial) -> CostSummary = { ..no_cost(), size: Some(p) }

fn add(w: CostSummary, c: Polynomial) -> CostSummary = { ..w, cost: plus(w.cost, c) }

fn then(a: CostSummary, b: CostSummary) -> CostSummary =
  {
    cost: plus(a.cost, b.cost),
    size: b.size,
    of: b.of,
    fun: b.fun,
    calls: a.calls + b.calls,
    back: a.back.concat(b.back),
  }

/// Either branch: the steps of the larger, and a size that bounds both.
fn combine_branches(a: CostSummary, b: CostSummary) -> CostSummary =
  {
    cost: plus(a.cost, b.cost),
    size: match ((a.size, b.size)) { (Some(x), Some(y)) -> Some(plus(x, y)), _ -> None },
    of: Other,
    fun: match ((a.fun, b.fun)) { (Some(x), Some(y)) -> Some(plus(x, y)), _ -> None },
    calls: if a.calls > b.calls { a.calls } else { b.calls },
    back: a.back.concat(b.back),
  }

fn slot_at(env: Env, k: Int) -> Slot =
  match env.slots.at(k) { Some(s) -> s, None -> { size: None, of: Other, fun: None } }

fn bind(env: Env, k: Int, s: Slot) -> Env / {abort.raise} = {
  let grown = if env.slots.len() <= k {
    range(env.slots.len(), k + 1).fold(env.slots, |acc: List<Slot>, _i: Int|
      acc.push({ size: None, of: Other, fun: None }))
  } else { env.slots };
  { ..env, slots: grown.set(k, s) }
}

fn walk(env: Env, c: Code) -> Result<CostSummary, String> / {abort.raise} =
  match c.node {
    CodeLiteral(l) -> Ok(match l { LiteralInt(n) -> sized(literal_size(n)), _ -> no_cost() }),
    CodeVar(v) ->
      Ok({
        ..no_cost(),
        size: slot_at(env, v.slot).size,
        of: slot_at(env, v.slot).of,
        fun: slot_at(env, v.slot).fun,
      }),
    NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) ->
      Ok({ ..no_cost(), fun: fun_named(env, String::of_bytes_lossy(fname)) }),
    CodeLabel(_) -> Ok(no_cost()),
    CodeUnary(u) -> match walk(env, u.operand) {
      Err(reason) -> Err(reason),
      Ok(w) -> Ok({ ..w, of: Other, fun: None }),
    },
    CodeBinary(b) -> match walk(env, b.lhs) {
      Err(reason) -> Err(reason),
      Ok(l) -> match walk(env, b.rhs) {
        Err(reason) -> Err(reason),
        Ok(r) ->
          Ok({
            ..then(l, r),
            size: arithmetic(b.op, l.size, r.size),
            of: operation_relation(env.found, b.op, l.of, b.rhs, r.of, b.lhs),
            fun: None,
          }),
      },
    },
    CodeIf(i) -> match walk(env, i.cond) {
      Err(reason) -> Err(reason),
      Ok(cond) -> {
        let slots = |k: Int| slot_at(env, k).of;
        let branch = |truth: Bool, c: Code| {
          let holds = assumed(slots, i.cond, truth);
          if possible(holds, env.missed) {
            Some(walk({ ..env, found: env.found.concat(holds) }, c))
          } else { None }
        };
        match ((branch(true, i.then_branch), branch(false, i.else_branch))) {
          (Some(Err(reason)), _) -> Err(reason),
          (_, Some(Err(reason))) -> Err(reason),
          (Some(Ok(t)), Some(Ok(e))) -> Ok(then(cond, combine_branches(t, e))),
          (Some(Ok(t)), None) -> Ok(then(cond, t)),
          (None, Some(Ok(e))) -> Ok(then(cond, e)),
          (None, None) -> Ok(cond),
        }
      },
    },
    CodeBlock(b) -> block(env, b.statements, b.tail),
    CodeList(l) -> match all(env, l.items) {
      Err(reason) -> Err(reason),
      Ok(w) -> Ok({ ..w, size: Some(constant()), of: Other, fun: None }),
    },
    CodeRecord(r) -> match all(env, r.fields.map(|f: CodeField| f.value)) {
      Err(reason) -> Err(reason),
      Ok(w) -> Ok({ ..w, size: None, of: Other, fun: None }),
    },
    CodeFieldRead(f) -> match walk(env, f.base) {
      Err(reason) -> Err(reason),
      Ok(w) -> Ok({ ..w, size: None, of: Other, fun: None }),
    },
    CodeUpdate(u) -> match all(env, u.sets.map(|f: CodeField| f.value).push(u.base)) {
      Err(reason) -> Err(reason),
      Ok(w) -> Ok({ ..w, size: None, of: Other, fun: None }),
    },
    CodeMatch(m) -> match walk(env, m.scrutinee) {
      Err(reason) -> Err(reason),
      Ok(s) -> match arms(
          env,
          s,
          index_bound_of(|k: Int| slot_at(env, k).of, m.scrutinee),
          m.arms,
        ) {
        Err(reason) -> Err(reason),
        Ok(a) -> Ok(then(s, a)),
      },
    },
    CodeApply(a) -> application(env, a.function, a.args),
    CodeKnownLambda(_) -> panic("only the emitter writes a read as a known lambda"),
    // A raise ends the call; any other operation runs a handler the bound does not read.
    CodePerform(p) -> if p.effect != b"abort" {
      Err("an operation whose handler the bound does not read")
    } else {
      match all(env, p.args) {
        Err(reason) -> Err(reason),
        Ok(w) -> Ok({ ..add(w, constant()), size: None, of: Other, fun: None }),
      }
    },
    CodeLambda(l) ->
      Ok({
        ..no_cost(),
        fun: match lambda_steps(env, l.params, l.captures, l.body, []) {
          Ok(w) -> if w.calls > 0 { None } else { Some(plus(constant(), w.cost)) },
          Err(_) -> None,
        },
      }),
    CodeSimulate(_) -> Err("a simulation the bound does not read"),
    CodeParallel(_) -> Err("a `parallel` block the bound does not read"),
    CodeHandle(_) -> Err("a handler the bound does not read"),
  }

fn all(env: Env, cs: List<Code>) -> Result<CostSummary, String> / {abort.raise} =
  cs.fold(Ok(no_cost()), |acc: Result<CostSummary, String>, c: Code|
    match acc {
      Err(_) -> acc,
      Ok(sofar) -> match walk(env, c) { Ok(w) -> Ok(then(sofar, w)), Err(reason) -> Err(reason) },
    })

/// The size of an `Int` an operator returns: a sum or difference is bounded by both, a product by
/// their product, and a quotient or remainder by its left.
pub fn arithmetic(op: Bytes, l: Option<Polynomial>, r: Option<Polynomial>) -> Option<Polynomial> =
  match ((l, r)) {
    (Some(x), Some(y)) -> if op == b"add" || op == b"sub" || op == b"concat" { Some(plus(x, y)) }
    else if op == b"mul" { match product(x, y) { Ok(p) -> Some(p), Err(_) -> None } }
    else if op == b"div" || op == b"rem" { Some(x) }
    else { None },
    _ -> None,
  }

fn block(
  env: Env,
  statements: List<CodeStatement>,
  tail: Option<Code>,
) -> Result<CostSummary, String> / {abort.raise} = {
  let ran = statements.fold(
    Ok({ env: env, w: no_cost() }),
    |acc: Result<{ env: Env, w: CostSummary }, String>, st: CodeStatement|
      match acc {
        Err(_) -> acc,
        Ok(s) -> match st {
          CodeDo(d) -> match walk(s.env, d.code) {
            Ok(w) -> Ok({ env: s.env, w: then(s.w, w) }),
            Err(reason) -> Err(reason),
          },
          CodeLet(l) -> match walk(s.env, l.value) {
            Ok(w) ->
              Ok({
                env: bind(s.env, l.slot, { size: w.size, of: w.of, fun: w.fun }),
                w: then(s.w, w),
              }),
            Err(reason) -> Err(reason),
          },
          CodeLetDestructure(l) -> match walk(s.env, l.value) {
            Ok(w) ->
              Ok({
                env: bound(s.env, l.pattern, { size: w.size, of: w.of, fun: w.fun }),
                w: then(s.w, w),
              }),
            Err(reason) -> Err(reason),
          },
        },
      },
  );
  match ran {
    Err(reason) -> Err(reason),
    Ok(s) -> match tail {
      None -> Ok({ ..s.w, size: None, of: Other, fun: None }),
      Some(t) -> match walk(s.env, t) { Ok(w) -> Ok(then(s.w, w)), Err(reason) -> Err(reason) },
    },
  }
}

/// The slots a pattern binds of a value: the value itself where it binds it whole, a tail of a list
/// where it takes heads off, and nothing known of a head or a field.
fn bound(env: Env, pattern: CodePattern, of: Slot) -> Env / {abort.raise} =
  match pattern {
    CodeBindingPattern(v) -> {
      let k = v.slot;
      bind(env, k, of)
    },
    CodeListPattern(l) -> {
      let heads = l.items.fold(env, |e: Env, p: CodePattern|
        bound(e, p, { size: None, of: Other, fun: None }));
      match l.rest {
        None -> heads,
        Some(r) ->
          bound(heads, r, {
            size: of.size,
            fun: None,
            of: if l.items.len() == 0 { of.of }
            else { match of.of { Same(i) -> Part(i), Part(i) -> Part(i), _ -> Other } },
          }),
      }
    },
    CodeConstructorPattern(c) ->
      c.args.fold(env, |e: Env, p: CodePattern| bound(e, p, { size: None, of: Other, fun: None })),
    CodeRecordPattern(r) ->
      r.fields.fold(env, |e: Env, f: CodePatternField|
        bound(e, f.pattern, { size: None, of: Other, fun: None })),
    _ -> env,
  }

/// An arm that takes a head off the list known to be empty is never taken.
fn needs_head(env: Env, scrutinee: CostSummary, pattern: CodePattern) -> Bool =
  match ((env.empty, scrutinee.of, pattern)) {
    (Some(p), Same(i), CodeListPattern(l)) -> p == i && l.items.len() > 0,
    _ -> false,
  }

/// Where `c` is `List::at` of a list parameter at an `Int` one, both as they were handed in.
pub fn index_bound_of(slots: (Int) -> ParameterRelation, c: Code) -> Option<IndexBound> =
  match c.node {
    CodeApply(a) -> match ((read_name(a.function), a.args)) {
      (Some(f), [xs, i]) -> if f != b"List::at" { None } else {
        match ((xs.node, i.node)) {
          (CodeVar(x), CodeVar(n)) -> match ((slots(x.slot), slots(n.slot))) {
            (Same(l), Same(j)) ->
              Some({ index: j, limit: InBounds(l), rising: true, strict: true }),
            _ -> None,
          },
          _ -> None,
        }
      },
      _ -> None,
    },
    _ -> None,
  }

/// A pattern only a `Some` value matches.
pub fn takes_some(p: CodePattern) -> Bool =
  match p { CodeConstructorPattern(c) -> c.name == b"Some", _ -> false }

/// What `a op b` is, of `a` and `b`: an index held short of a limit, moved toward it by a positive
/// literal, is `Toward` it. Where several hold it, the one a list's elements give, then a length,
/// then a literal.
pub fn operation_relation(
  found: List<IndexBound>,
  op: Bytes,
  a: ParameterRelation,
  b: Code,
  b_of: ParameterRelation,
  a_code: Code,
) -> ParameterRelation = {
  let moved = |x: ParameterRelation, k: Code, rising: Bool|
    match ((x, k.node)) {
      (Same(j), CodeLiteral(LiteralInt(n))) -> if n <= 0 { None } else {
        found.fold(None, |best: Option<IndexBound>, f: IndexBound|
          if f.index != j || f.rising != rising { best } else {
            match best {
              Some(g) -> if rank(f.limit) < rank(g.limit) { Some(f) } else { best },
              None -> Some(f),
            }
          })
      },
      _ -> None,
    };
  let read = if op == b"add" {
    match moved(a, b, true) { Some(f) -> Some(f), None -> moved(b_of, a_code, true) }
  } else if op == b"sub" { moved(a, b, false) }
  else { None };
  match read { Some(f) -> Toward(f), None -> Other }
}

fn rank(l: Limit) -> Int = match l { InBounds(_) -> 0, Length(_) -> 1, Literal(_) -> 2 }

/// What holds an index short of a limit where `c` evaluated to `truth`: a comparison of an `Int`
/// parameter with a literal or a parameter's length, through `!`, a `&&` that held and an `||`
/// that did not.
pub fn assumed(slots: (Int) -> ParameterRelation, c: Code, truth: Bool) -> List<IndexBound> =
  match c.node {
    CodeUnary(u) -> if u.op == b"not" { assumed(slots, u.operand, !truth) } else { [] },
    CodeBinary(b) -> if b.op == b"and" {
      if truth { assumed(slots, b.lhs, true).concat(assumed(slots, b.rhs, true)) } else { [] }
    } else if b.op == b"or" {
      if truth { [] } else { assumed(slots, b.lhs, false).concat(assumed(slots, b.rhs, false)) }
    } else {
      // `!(a < b)` is `a >= b`, and `b > a` is `a < b`.
      let op = if truth { b.op } else { negated(b.op) };
      match compared(slots, b.lhs, op, b.rhs) {
        Some(f) -> [f],
        None -> match compared(slots, b.rhs, flipped(op), b.lhs) { Some(f) -> [f], None -> [] },
      }
    },
    _ -> [],
  }

fn negated(op: Bytes) -> Bytes =
  if op == b"lt" { b"ge" }
  else if op == b"le" { b"gt" }
  else if op == b"gt" { b"le" }
  else if op == b"ge" { b"lt" }
  else { b"" }

fn flipped(op: Bytes) -> Bytes =
  if op == b"lt" { b"gt" }
  else if op == b"le" { b"ge" }
  else if op == b"gt" { b"lt" }
  else if op == b"ge" { b"le" }
  else { b"" }

/// `index op limit`, an `Int` parameter below a literal or a length, or above a literal.
fn compared(
  slots: (Int) -> ParameterRelation,
  index: Code,
  op: Bytes,
  limit: Code,
) -> Option<IndexBound> =
  match index.node {
    CodeVar(v) -> {
      let k = v.slot;
      match ((slots(k), limit_of(slots, limit))) {
        (Same(j), Some(l)) -> if op == b"lt" || op == b"le" {
          Some({ index: j, limit: l, rising: true, strict: op == b"lt" })
        } else if (op == b"gt" || op == b"ge") && rank(l) == 2 {
          Some({ index: j, limit: l, rising: false, strict: op == b"gt" })
        } else { None },
        _ -> None,
      }
    },
    NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) ->
      None,
    _ -> None,
  }

/// A literal, or the length of a parameter as it was handed in.
fn limit_of(slots: (Int) -> ParameterRelation, c: Code) -> Option<Limit> =
  match c.node {
    CodeLiteral(l) -> match l { LiteralInt(n) -> Some(Literal(n)), _ -> None },
    CodeApply(_) -> match length_of(c, 1 << 62) {
      Some(k) -> match slots(k) { Same(p) -> Some(Length(p)), _ -> None },
      None -> None,
    },
    _ -> None,
  }

/// Whether a path holding `holds` may be taken where `missed` fails.
pub fn possible(holds: List<IndexBound>, missed: Option<IndexBound>) -> Bool =
  match missed { Some(m) -> !holds.contains(m), None -> true }

/// The size of an `Int` literal, its magnitude: none at zero.
pub fn literal_size(n: Int) -> Polynomial = if n == 0 { zero() } else { constant() }

/// The arm taken, after its guard and every guard before it. `at` is where the scrutinee is
/// `List::at`: an arm only `Some` matches has found an element, and is not taken where it misses.
fn arms(
  env: Env,
  scrutinee: CostSummary,
  at: Option<IndexBound>,
  xs: List<CodeArm>,
) -> Result<CostSummary, String> / {abort.raise} =
  match xs.fold(
      Ok({ guards: no_cost(), taken: None }),
      |acc: Result<{ guards: CostSummary, taken: Option<CostSummary> }, String>, arm: CodeArm|
        match acc {
          Err(_) -> acc,
          Ok(sofar) -> if needs_head(env, scrutinee, arm.pattern)
              || (at != None && at == env.missed && takes_some(arm.pattern)) { acc } else {
            let found = match at {
              Some(f) -> if takes_some(arm.pattern) { { ..env, found: env.found.push(f) } }
              else { env },
              None -> env,
            };
            let inside = bound(found, arm.pattern, {
              size: scrutinee.size,
              of: scrutinee.of,
              fun: scrutinee.fun,
            });
            match match arm.guard { None -> Ok(no_cost()), Some(g) -> walk(inside, g) } {
              Err(reason) -> Err(reason),
              Ok(g) -> match walk(inside, arm.body) {
                Err(reason) -> Err(reason),
                Ok(b) -> {
                  let guards = then(sofar.guards, g);
                  let path = then(guards, b);
                  Ok({
                    guards: guards,
                    taken: Some(match sofar.taken {
                      None -> path,
                      Some(t) -> combine_branches(t, path),
                    }),
                  })
                },
              },
            }
          },
        },
    ) {
    Err(reason) -> Err(reason),
    Ok(found) -> Ok(match found.taken { Some(w) -> w, None -> no_cost() }),
  }

fn application(
  env: Env,
  function: Code,
  args: List<Code>,
) -> Result<CostSummary, String> / {abort.raise} =
  match Result::traverse(args, |a: Code| walk(env, a)) {
    Err(reason) -> Err(reason),
    Ok(walked) -> {
      let given = { ..walked.fold(no_cost(), then), size: None, of: Other, fun: None };
      let sizes = walked.map(|w: CostSummary| w.size);
      let ofs = walked.map(|w: CostSummary| w.of);
      let funs = walked.map(|w: CostSummary| w.fun);
      match function.node {
        CodeVar(f) -> {
          let k = f.slot;
          match slot_at(env, k).fun {
            Some(p) -> Ok(add(given, p)),
            None -> Err("a call of a function value whose steps are not read"),
          }
        },
        NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) -> {
          let name = String::of_bytes_lossy(fname);
          if name == env.own {
            Ok({
              ..add(given, constant()),
              size: None,
              of: Other,
              calls: given.calls + 1,
              back: given.back.push(ofs),
            })
          } else if ctor(env.context, name) != None {
            Ok({ ..given, size: None, of: Other, fun: None })
          } else if env.context.claims.definitions.contains(name)
              && !by_entry(env.context, name, CostClause) {
            match read(env, name) {
              Err(reason) -> Err(reason),
              Ok(p) -> match at_args(p, sizes, funs) {
                Err(reason) -> Err(reason),
                Ok(q) ->
                  Ok({
                    ..add(given, plus(constant(), q)),
                    size: match callback_use(Bytes::of_string(name)) {
                      Some(it) -> result_size(it, sizes),
                      None -> None,
                    },
                  }),
              },
            }
          } else { builtin(env, name, args, given, sizes) }
        },
        CodeLambda(l) -> match lambda_steps(
            env,
            l.params,
            l.captures,
            l.body,
            sizes.map(|s: Option<Polynomial>| s),
          ) {
          Err(reason) -> Err(reason),
          Ok(w) -> Ok({ ..add(then(given, w), constant()), of: Other, fun: None }),
        },
        _ -> Err("a call of a computed function the bound does not read"),
      }
    },
  }

/// The steps of one call of a definition or constructor named as a value, where they grow with nothing
/// it is given.
fn fun_named(env: Env, name: String) -> Option<Polynomial> =
  if ctor(env.context, name) != None { Some(constant()) }
  else if !env.context.claims.definitions.contains(name) { None } else {
    match read(env, name) {
      Ok(p) -> match at_args(p, [], []) { Ok(q) -> Some(plus(constant(), q)), Err(_) -> None },
      Err(_) -> None,
    }
  }

fn read(env: Env, name: String) -> Result<Polynomial, String> =
  match env.known.get(name) {
    Some(r) -> r,
    None -> Err("`" ++ name ++ "` reaches definitions that call each other"),
  }

/// A literal lambda's body with its parameters at `sizes` and its captures as they are outside.
fn lambda_steps(
  env: Env,
  params: Int,
  captures: List<Capture>,
  body: Code,
  sizes: List<Option<Polynomial>>,
) -> Result<CostSummary, String> / {abort.raise} = {
  let start = range(0, params).fold({ ..env, slots: [] }, |e: Env, i: Int|
    bind(e, i, { size: match sizes.at(i) { Some(s) -> s, None -> None }, of: Other, fun: None }));
  let captured = captures.fold(start, |e: Env, cap: Capture|
    bind(e, cap.destination, slot_at(env, cap.src)));
  walk(captured, body)
}

/// A builtin is one step; one that calls back calls its callback as many times as its entry says
/// the sizes of its arguments allow, each a step of its own and the callback's body.
fn builtin(
  env: Env,
  name: String,
  args: List<Code>,
  given: CostSummary,
  sizes: List<Option<Polynomial>>,
) -> Result<CostSummary, String> / {abort.raise} = {
  let size_at = |i: Int| match sizes.at(i) { Some(s) -> s, None -> None };
  let one = { ..add(given, constant()), size: None, of: Other, fun: None };
  match iterating_of(Bytes::of_string(name)) {
    Some(it) -> match match args.at(it.callback) {
        None -> Err("a builtin called without its callback"),
        Some(cb) -> callback_steps(env, cb, it.params.len()),
      } {
      Err(reason) -> Err(reason),
      Ok(body) -> match callback_calls(it, sizes) {
        None -> Err("an iteration over a value whose size is not read"),
        Some(n) -> match product(n, plus(constant(), body)) {
          Ok(p) -> Ok({ ..add(one, p), size: result_size(it, sizes) }),
          Err(reason) -> Err(reason),
        },
      },
    },
    None -> first_order(env, name, one, size_at),
  }
}

/// The entry of what a call names: a definition by its program-wide name, a builtin by its own.
pub fn iterating_of(name: Bytes) -> Option<CallbackUse> =
  match callback_use(name) { Some(it) -> Some(it), None -> prelude_callback_use(name) }

/// Whether `definition` is a definition its entry describes and no bound of `kind` states, which a call
/// reads by the entry, as a native's, and not by its body: for `cost` a step, and beside it each call
/// of the function it is handed. How many times and with what it calls that function is no
/// assumption: `compiler.check.semantics` derives it from the body of each definition `std.prelude` writes
/// in Ply, and its tests fail where the entry says otherwise. The body's own steps are not read, so
/// a map fold's walk down to each next leaf goes unbilled.
pub fn by_entry(context: Context, definition: String, kind: SpecKind) -> Bool =
  callback_use(Bytes::of_string(definition)) != None
    && (match context.claims.definitions.get(definition) {
      Some(d) -> !d.spec.any(|c: ClaimClause| c.kind == kind),
      None -> false,
    })

/// How many calls of the function a call of `it`'s function makes, at the sizes of its arguments.
pub fn callback_calls(it: CallbackUse, sizes: List<Option<Polynomial>>) -> Option<Polynomial> =
  it.over.fold(
    Some(if it.over.len() == 0 { constant() } else { zero() }),
    |acc: Option<Polynomial>, k: Int|
      match ((acc, sizes.at(k))) { (Some(p), Some(Some(s))) -> Some(plus(p, s)), _ -> None },
  )

/// The size of what a call of `it`'s function returns, at the sizes of its arguments: a list as
/// long as what it walks at most, or the argument it updates.
pub fn result_size(it: CallbackUse, sizes: List<Option<Polynomial>>) -> Option<Polynomial> = {
  let at = |k: Int| match sizes.at(k) { Some(s) -> s, None -> None };
  match it.result {
    Mapped -> match it.over.at(0) { Some(k) -> at(k), None -> None },
    Filtered -> match it.over.at(0) { Some(k) -> at(k), None -> None },
    Updated(k) -> at(k),
    _ -> None,
  }
}

/// A builtin that calls nothing back, by name.
fn first_order(
  env: Env,
  name: String,
  one: CostSummary,
  size_at: (Int) -> Option<Polynomial>,
) -> Result<CostSummary, String> =
  if env.first_order.get(name) == None { Err("`" ++ name ++ "` has no body here to read") }
  else if env.first_order.get(name) == Some(false) {
    Err("`" ++ name ++ "` calls back in a way the bound does not read")
  } else if is_length(name) || name == "List::set" || name == "Map::remove"
      || name == "String::chars"
      || name == "String::of_chars" { Ok({ ..one, size: size_at(0) }) }
  else if name == "List::push" || name == "Map::insert" {
    Ok({ ..one, size: match size_at(0) { Some(s) -> Some(plus(s, constant())), None -> None } })
  } else if name == "range" {
    Ok({
      ..one,
      size: match ((size_at(0), size_at(1))) { (Some(a), Some(b)) -> Some(plus(a, b)), _ -> None },
    })
  } else if name == "Map::new" { Ok({ ..one, size: Some(constant()) }) }
  else { Ok(one) }

/// The steps of one call of a callback taking `arity` arguments, each of a size not read.
fn callback_steps(env: Env, cb: Code, arity: Int) -> Result<Polynomial, String> / {abort.raise} =
  match cb.node {
    CodeLambda(l) -> match lambda_steps(
        env,
        l.params,
        l.captures,
        l.body,
        range(0, arity).map(|_i: Int| None),
      ) {
      Err(reason) -> Err(reason),
      Ok(w) -> if w.calls > 0 { Err("a call back inside an iteration") } else { Ok(w.cost) },
    },
    CodeVar(f) -> match slot_at(env, f.slot).fun {
      Some(p) -> Ok(p),
      None -> Err("a callback whose steps are not read"),
    },
    NDefinition({ full: fname, .. }) | NConstructor({ name: fname, .. }) | NBuiltin({ name: fname, .. }) -> {
      let name = String::of_bytes_lossy(fname);
      if ctor(env.context, name) != None { Ok(zero()) }
      else if name == env.own { Err("a call back inside an iteration") }
      else if env.context.claims.definitions.contains(name) {
        match read(env, name) {
          Err(reason) -> Err(reason),
          Ok(p) ->
            at_args(p, range(0, arity).map(|_i: Int| None), range(0, arity).map(|_i: Int| None)),
        }
      } else { Err("a callback the bound does not read") }
    },
    _ -> Err("a callback the bound does not read"),
  }

// --- Tests ---------------------------------------------------------------------------------------

fn context_of(src: Bytes) -> Context / {abort.raise} =
  context_owning([{ name: b"m", src: src }], |_m: Bytes| true)

/// The context of `sources` as a run that owns the modules `owned` takes reads them.
pub fn context_owning(
  sources: List<{ name: Bytes, src: Bytes }>,
  owned: (Bytes) -> Bool,
) -> Context / {abort.raise} =
  match analyse(parse_all(sources)) {
    Rejected(ds) ->
      panic(
        "the fixture checks: "
          ++ String::of_bytes_lossy(
            Bytes::concat_all(
              ds.map(|d: Diagnostic| Bytes::concat_all([d.code, b" ", d.message, b"; "])),
            ),
          ),
      ),
    Analysed(w) ->
      context(
        claims_from_analysis(w, range(0, w.modules.len()), owned),
        prover_input_of(w, owned).world,
      ),
  }

/// The steps of `m.<definition>` against its first `cost` clause: `Ok(true)` where the clause is shown.
fn cost_clause_proved(src: Bytes, definition: String) -> Result<Bool, String> / {abort.raise} =
  shown_in(context_of(src), "m." ++ definition)

/// The steps of `name` in `context` against its first `cost` clause.
fn shown_in(context: Context, name: String) -> Result<Bool, String> / {abort.raise} =
  match context.claims.definitions.get(name) {
    None -> panic("a definition of the fixture"),
    Some(d) -> match d.spec.filter(|c: ClaimClause| c.kind == CostClause) {
      [c, ..] -> {
        let b = c.clause.code;
        match stated_cost(b, d.params, d.cost_parameters) {
          None -> Err("the bound is not read"),
          Some(bound) -> match steps(context, name) {
            Err(reason) -> Err(reason),
            Ok(p) -> Ok(dominated(p, bound)),
          },
        }
      },
      [] -> panic("a `cost` clause"),
    },
  }

fn fold_sum() -> Bytes = b"xs.fold(0, |a: Int, x: Int| a + x)"

test "a fold is one step per element, so a length bounds it and a constant does not" {
  assert_eq(
    cost_clause_proved(b"fn f(xs: List<Int>) -> Int cost xs.len() = ".concat(fold_sum()), "f"),
    Ok(true),
  );
  assert_eq(
    cost_clause_proved(b"fn f(xs: List<Int>) -> Int cost 1 = ".concat(fold_sum()), "f"),
    Ok(false),
  );
  assert_eq(
    cost_clause_proved(
      b"fn f(m: Map<Int, Int>) -> Int cost m.len() = m.fold(0, |a: Int, k: Int, v: Int| a + k + v)",
      "f",
    ),
    Ok(true),
  );
  assert_eq(
    cost_clause_proved(
      b"fn f(n: Int) -> Int cost 1 = range(0, n).fold(0, |a: Int, x: Int| a + x)",
      "f",
    ),
    Ok(false),
  )
}

test "a bound holds at every size, zero included, so a product of lengths does not bound one alone" {
  let nested = b"xs.fold(0, |a: Int, x: Int| ys.fold(a, |b: Int, y: Int| b + x * y))";
  let under = |bound: Bytes|
    cost_clause_proved(
      Bytes::concat_all([
        b"fn f(xs: List<Int>, ys: List<Int>) -> Int cost ",
        bound,
        b" = ",
        nested,
      ]),
      "f",
    );
  assert_eq(under(b"xs.len() * (ys.len() + 1)"), Ok(true));
  assert_eq(under(b"xs.len() + xs.len() * ys.len()"), Ok(true));
  assert_eq(under(b"xs.len() * ys.len()"), Ok(false));
  assert_eq(under(b"xs.len() + ys.len()"), Ok(false));
  assert(dominated([Map::new().insert(0, 1)], [Map::new().insert(0, 2)]));
  assert(dominated([Map::new()], []));
  assert(!dominated([Map::new().insert(0, 1)], [Map::new().insert(0, 1).insert(1, 1)]))
}

test "a callee's steps are read at the sizes of its arguments" {
  let src = Bytes::concat_all([
    b"fn total(xs: List<Int>) -> Int = ",
    fold_sum(),
    b"\n",
    b"fn twice(xs: List<Int>) -> Int cost xs.len() = total(xs.push(1)) + total(xs)\n",
    b"fn each(xs: List<Int>) -> Int cost xs.len() * xs.len() = xs.fold(0, |a: Int, _x: Int| a + total(xs))\n",
    b"fn each_wrong(xs: List<Int>) -> Int cost xs.len() = xs.fold(0, |a: Int, _x: Int| a + total(xs))\n",
  ]);
  assert_eq(cost_clause_proved(src, "twice"), Ok(true));
  assert_eq(cost_clause_proved(src, "each"), Ok(true));
  assert_eq(cost_clause_proved(src, "each_wrong"), Ok(false))
}

test "recursion on the tail a list pattern takes is one call per element" {
  let src = b"fn count(xs: List<Int>, k: Int) -> Int cost xs.len() = match xs { [] -> k, [_, ..rest] -> count(rest, k + 1) }";
  assert_eq(cost_clause_proved(src, "count"), Ok(true));
  let growth_preserved = b"fn total(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + x)\nfn f(xs: List<Int>, ys: List<Int>) -> Int cost xs.len() * (ys.len() + 1) = match xs { [] -> 0, [_, ..rest] -> total(ys) + f(rest, ys) }";
  assert_eq(cost_clause_proved(growth_preserved, "f"), Ok(true));
  // On an empty `xs` this reads all of `ys` before the pattern fails, so `ys.len()` alone is spent.
  let aborts = b"fn total(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + x)\nfn f(xs: List<Int>, ys: List<Int>, c: Bool) -> Int / {abort.raise} cost xs.len() * (ys.len() + 1) = if c { 0 } else { let t = total(ys); let [_, ..r] = xs; t + f(r, ys, c) }";
  assert_eq(cost_clause_proved(aborts, "f"), Ok(false))
}

test "a recursion that grows what its steps read, calls itself twice on a path, or does not descend is not read" {
  let grown = b"fn total(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + x)\nfn f(xs: List<Int>, acc: List<Int>) -> Int cost xs.len() + acc.len() = match xs { [] -> total(acc), [x, ..rest] -> f(rest, acc.push(x)) }";
  assert_eq(
    cost_clause_proved(grown, "f"),
    Err("`m.f` hands on a parameter its steps grow with, changed"),
  );
  let guarded = b"fn f(xs: List<Int>) -> Int cost xs.len() = match xs { [] -> 0, [x, ..rest] if f(rest) > x -> 1, [_, ..rest] -> f(rest) }";
  assert_eq(cost_clause_proved(guarded, "f"), Err("`m.f` calls itself more than once on one path"));
  let same = b"fn f(xs: List<Int>, n: Int) -> Int / {diverges} = if n <= 0 { 0 } else { f(xs, n) }";
  assert_eq(steps_in(same, "f"), Err(no_descent_error("m.f")))
}

fn no_descent_error(definition: String) -> String =
  "`" ++ definition
    ++ "` does not call itself on a part of one list parameter, or on an index moved toward a limit it holds it short of, every time"

test "recursion past an index where `List::at` found an element is one call per element" {
  let walk = |bound: Bytes, back: Bytes|
    cost_clause_proved(
      Bytes::concat_all([
        b"fn walk(xs: List<Int>, i: Int, acc: Int) -> Int cost ",
        bound,
        b" = match xs.at(i) { Some(x) -> ",
        back,
        b", None -> acc }",
      ]),
      "walk",
    );
  assert_eq(walk(b"xs.len()", b"walk(xs, i + 1, acc + x)"), Ok(true));
  assert_eq(walk(b"xs.len()", b"walk(xs, 2 + i, acc + x)"), Ok(true));
  assert_eq(walk(b"1", b"walk(xs, i + 1, acc + x)"), Ok(false));
  // An index that stays, steps back, or indexes a list the call changes bounds nothing.
  let unbounded = |back: Bytes|
    steps_in(
      Bytes::concat_all([
        b"fn walk(xs: List<Int>, i: Int, acc: Int) -> Int / {diverges} = match xs.at(i) { Some(x) -> ",
        back,
        b", None -> acc }",
      ]),
      "walk",
    );
  assert_eq(unbounded(b"walk(xs, i, acc + x)"), Err(no_descent_error("m.walk")));
  assert_eq(unbounded(b"walk(xs, i - 1, acc + x)"), Err(no_descent_error("m.walk")));
  assert_eq(unbounded(b"walk(xs.push(x), i + 1, acc)"), Err(no_descent_error("m.walk")));
}

test "a recursion that moves an index toward a limit a guard holds it short of takes as many calls" {
  let walk = b"fn walk(xs: List<Int>, i: Int) -> Int = if i >= xs.len() { 0 } else { 1 + walk(xs, i + 1) }\n";
  let from = |call: Bytes|
    cost_clause_proved(
      Bytes::concat_all([walk, b"fn f(xs: List<Int>, i: Int) -> Int cost xs.len() = ", call]),
      "f",
    );
  assert_eq(from(b"walk(xs, 0)"), Ok(true));
  // Started anywhere, the index may lie below zero, farther from the length than the list is long.
  assert_eq(from(b"walk(xs, i)"), Ok(false));
  // A literal limit, from below and from above.
  assert_eq(
    cost_clause_proved(
      b"fn up(i: Int) -> Int = if i >= 32 { 0 } else { up(i + 1) }\nfn f() -> Int cost 1 = up(0)",
      "f",
    ),
    Ok(true),
  );
  let down = b"fn down(n: Int) -> Int = if n <= 0 { 0 } else { down(n - 5) }\n";
  assert_eq(cost_clause_proved(down.concat(b"fn f() -> Int cost 1 = down(60)"), "f"), Ok(true));
  assert_eq(
    cost_clause_proved(
      down.concat(b"fn f(xs: List<Int>, n: Int) -> Int cost xs.len() = down(n)"),
      "f",
    ),
    Ok(false),
  );
  // An `||` that failed holds both: the length bounds the calls, and the last takes no step of `f`.
  let both = b"fn each(xs: List<Int>, i: Int, f: (Int) -> Int cost k, acc: Int) -> Int = if i >= 32 || i >= xs.len() { acc } else { each(xs, i + 1, f, acc + f(i)) }\n";
  assert_eq(
    cost_clause_proved(
      both.concat(
        b"fn g(xs: List<Int>, f: (Int) -> Int cost k) -> Int cost xs.len() * k = each(xs, 0, f, 0)",
      ),
      "g",
    ),
    Ok(true),
  )
}

fn prelude_folds() -> Bytes =
  b"fn f(xs: List<Int>) -> Int = xs.map(|x: Int| x + 1).filter(|x: Int| x > 1).fold(0, |a: Int, x: Int| a + x)\n"

test "the prelude's `map`, `filter` and `fold` take the steps their `cost` bounds state" {
  let context = context_of(prelude_folds());
  assert_eq(
    ["std.prelude.List::map", "std.prelude.List::filter", "std.prelude.List::fold"].map(
      |n: String| shown_in(context, n),
    ),
    [Ok(true), Ok(true), Ok(true)],
  )
}

test "a call of the prelude's `map` costs what its bound states, and returns a list no longer" {
  let costed = |bound: Bytes|
    context_owning(
      [
        {
          name: b"m",
          src: Bytes::concat_all([
            b"fn f(xs: List<Int>, g: (Int) -> Int cost k) -> Int cost ",
            bound,
            b" = xs.map(g).filter(|x: Int| x > 1).fold(0, |a: Int, x: Int| a + x)\n",
          ]),
        },
      ],
      |m: Bytes| m == b"m",
    );
  // The prelude is the toolchain's, so a call reads its bound and not its body.
  let context = costed(b"xs.len() * k");
  assert_eq(
    context.claims.definitions.get("std.prelude.List::map").map(|d: Definition| d.body == None),
    Some(true),
  );
  assert_eq(shown_in(context, "m.f"), Ok(true));
  assert_eq(shown_in(costed(b"xs.len()"), "m.f"), Ok(false))
}

fn coded(n: Node) -> Code = { node: n, span: dummy_span(), ty: int_type() }

fn called(f: Node, arg: Code) -> Code =
  coded(CodeApply({ function: coded(f), args: [arg], effects: no_effects() }))

fn length(k: Int) -> Code =
  called(
    NBuiltin({ name: b"List::len", args: [], effect_arguments: [] }),
    coded(CodeVar({ name: b"xs", slot: k })),
  )

fn logged_of(c: Code) -> Code =
  called(NDefinition({ full: b"std.math.ilog2", args: [], effect_arguments: [], labels: [] }), c)

fn op(name: Bytes, l: Code, r: Code) -> Code = coded(CodeBinary({ op: name, lhs: l, rhs: r }))

test "`ilog2` reads as one alone, or beside sizes of the one length it is of" {
  assert_eq(stated_cost(op(b"mul", length(0), logged_of(length(0))), 2, []), Some(size_of(0)));
  assert_eq(
    stated_cost(
      op(b"add", op(b"mul", logged_of(length(0)), length(0)), coded(CodeLiteral(LiteralInt(1)))),
      2,
      [],
    ),
    Some(plus(size_of(0), constant())),
  );
  assert_eq(stated_cost(logged_of(length(1)), 2, []), Some(constant()));
  // Where `ys` is short `ilog2` is zero, while `xs` may be long.
  assert_eq(stated_cost(op(b"mul", length(0), logged_of(length(1))), 2, []), None);
  assert_eq(
    stated_cost(op(b"mul", op(b"mul", length(0), length(1)), logged_of(length(0))), 2, []),
    None,
  );
  assert_eq(stated_cost(op(b"mul", length(0), coded(CodeLiteral(LiteralInt(0)))), 2, []), None);
  assert_eq(stated_cost(op(b"sub", length(0), length(1)), 2, []), None)
}

fn steps_in(src: Bytes, definition: String) -> Result<Polynomial, String> / {abort.raise} =
  steps(context_of(src), "m." ++ definition)

test "a raise is a step, while another operation, a function value or a group of definitions leaves the steps unread" {
  assert_eq(
    cost_clause_proved(
      b"fn f(xs: List<Int>) -> Int / {abort.raise} cost 1 = match xs { [x, ..] -> x, [] -> panic(\"empty\") }",
      "f",
    ),
    Ok(true),
  );
  assert_eq(
    steps_in(
      b"effect tally { write bump() -> Unit }\nfn f(xs: List<Int>) -> Unit / {tally.bump} = tally.bump()",
      "f",
    ),
    Err("an operation whose handler the bound does not read"),
  );
  assert_eq(
    cost_clause_proved(
      b"fn ap(g: (Int) -> Int, x: Int) -> Int = g(x)\nfn f(xs: List<Int>) -> Int cost xs.len() = ap(|y: Int| y, 1)",
      "f",
    ),
    Err("a call of a function value whose steps are not read"),
  );
  assert_eq(
    cost_clause_proved(
      b"fn even(xs: List<Int>) -> Bool = match xs { [] -> true, [_, ..r] -> odd(r) }\nfn odd(xs: List<Int>) -> Bool = match xs { [] -> false, [_, ..r] -> even(r) }\nfn f(xs: List<Int>) -> Int cost xs.len() = if even(xs) { 1 } else { 0 }",
      "f",
    ),
    Err("`m.f` reaches definitions that call each other"),
  )
}

test "another package's definition costs what its `cost` bound says, read from above" {
  let context = context_owning(
    [
      {
        name: b"base",
        src: b"pub fn total(xs: List<Int>) -> Int cost xs.len() + 1 = xs.fold(0, |a: Int, x: Int| a + x)\npub fn hidden(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + x)\n",
      },
      {
        name: b"app",
        src: b"import base\nfn f(xs: List<Int>) -> Int = base::total(xs) + base::total(xs.push(1))\nfn g(xs: List<Int>) -> Int = base::hidden(xs)\n",
      },
    ],
    |m: Bytes| m == b"app",
  );
  assert_eq(steps(context, "app.f"), Ok([Map::new(), Map::new().insert(0, 1)]));
  assert_eq(
    steps(context, "app.g"),
    Err("`base.hidden` has no body here to read, and no `cost` bound to read as its steps"),
  )
}

fn each_of() -> Bytes =
  b"fn each_of(xs: List<Int>, f: (Int) -> Int cost k) -> Int cost xs.len() * k = xs.fold(0, |a: Int, x: Int| a + f(x))\n"

test "a recursion that hands its function parameter on changed takes what no cost name bounds" {
  let f = b"fn copier(y: Int) -> Int = [y, y, y].len()\nfn f(xs: List<Int>, i: Int, g: (Int) -> Int cost k, acc: Int) -> Int cost xs.len() * k = if i >= xs.len() { acc } else { f(xs, i + 1, copier, acc + g(i)) }\n";
  assert_eq(
    cost_clause_proved(f, "f"),
    Err("`m.f` hands on a parameter its steps grow with, changed"),
  );
  assert(
    cost_clause_proved(
        f.concat(b"fn h(xs: List<Int>) -> Int cost 1 = f(xs, 0, |y: Int| y + 1, 0)\n"),
        "h",
      )
      != Ok(true),
  )
}

test "a function parameter's cost name stands for the steps of each call of it" {
  assert_eq(cost_clause_proved(each_of(), "each_of"), Ok(true));
  assert_eq(
    cost_clause_proved(
      b"fn f(xs: List<Int>, g: (Int) -> Int cost k) -> List<Int> cost xs.len() * k = xs.map(g)",
      "f",
    ),
    Ok(true),
  );
  // A call of `f` may take any number of steps, so they bound nothing without its cost name.
  assert_eq(
    cost_clause_proved(
      b"fn f(xs: List<Int>, g: (Int) -> Int cost k) -> List<Int> cost xs.len() = xs.map(g)",
      "f",
    ),
    Ok(false),
  );
  assert_eq(
    cost_clause_proved(
      b"fn f(xs: List<Int>, g: (Int) -> Int) -> List<Int> cost xs.len() = xs.map(g)",
      "f",
    ),
    Err("a callee's steps grow with a function it is given whose steps are not read"),
  )
}

test "at a call site a bound with a cost name composes with the steps of the function given" {
  let src = Bytes::concat_all([
    b"fn total(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + x)\n",
    b"fn double(x: Int) -> Int = 2 * x\n",
    each_of(),
    b"fn pairs(xs: List<Int>, ys: List<Int>) -> Int cost xs.len() * (ys.len() + 1) = each_of(xs, |_x: Int| total(ys))\n",
    b"fn wrong(xs: List<Int>, ys: List<Int>) -> Int cost xs.len() = each_of(xs, |_x: Int| total(ys))\n",
    b"fn named(xs: List<Int>) -> Int cost xs.len() = each_of(xs, double)\n",
    b"fn passed(xs: List<Int>, g: (Int) -> Int cost j) -> Int cost xs.len() * j = each_of(xs, g)\n",
    b"fn kept(xs: List<Int>, g: (Int) -> Int cost j) -> Int cost xs.len() * j = { let h = g; each_of(xs, h) }\n",
  ]);
  assert_eq(cost_clause_proved(src, "pairs"), Ok(true));
  assert_eq(cost_clause_proved(src, "wrong"), Ok(false));
  assert_eq(cost_clause_proved(src, "named"), Ok(true));
  assert_eq(cost_clause_proved(src, "passed"), Ok(true));
  assert_eq(cost_clause_proved(src, "kept"), Ok(true))
}

test "a function given whose steps grow with what it is given leaves the call unread" {
  let src = Bytes::concat_all([
    b"fn total(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + x)\n",
    b"fn each_list(xss: List<List<Int>>, f: (List<Int>) -> Int cost k) -> Int cost xss.len() * k = xss.fold(0, |a: Int, xs: List<Int>| a + f(xs))\n",
    b"fn f(xss: List<List<Int>>) -> Int cost xss.len() = each_list(xss, total)\n",
    b"fn g(xss: List<List<Int>>) -> Int cost xss.len() = each_list(xss, |xs: List<Int>| total(xs))\n",
  ]);
  assert_eq(cost_clause_proved(src, "each_list"), Ok(true));
  assert_eq(
    cost_clause_proved(src, "f"),
    Err("a callee's steps grow with a function it is given whose steps are not read"),
  );
  assert_eq(
    cost_clause_proved(src, "g"),
    Err("a callee's steps grow with a function it is given whose steps are not read"),
  )
}

test "another package's definition with a cost name composes by its `cost` bound" {
  let context = context_owning(
    [
      { name: b"base", src: b"pub ".concat(each_of()) },
      {
        name: b"app",
        src: b"import base\nfn total(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + x)\nfn f(xs: List<Int>, ys: List<Int>) -> Int = base::each_of(xs, |_x: Int| total(ys))\n",
      },
    ],
    |m: Bytes| m == b"app",
  );
  let xs = Map::new().insert(0, 1);
  assert_eq(steps(context, "app.f"), Ok([Map::new(), xs, xs.insert(1, 1)]))
}

// A comparison of two keyed values calls their type's `key`, which no body shows, so the steps of
// whatever holds one are left to be measured.
test "a definition that holds a value compared by a key leaves its steps unread" {
  let keyed = |rest: Bytes|
    b"type Bag = | Bag(List<Int>)\nkey for Bag by size\nfn size(b: Bag) -> Int = match b { Bag(xs) -> xs.len() }\n".concat(
      rest,
    );
  let unread = |r: Result<Bool, String>|
    match r { Err(reason) -> reason.contains("compared by its type's `key`"), Ok(_) -> false };
  assert(
    unread(
      cost_clause_proved(
        keyed(
          b"fn member(bags: List<Bag>, b: Bag) -> Bool cost bags.len() = bags.fold(false, |f: Bool, x: Bag| f || x == b)",
        ),
        "member",
      ),
    ),
  );
  // One that builds a keyed value, and one that calls it.
  assert(
    unread(
      cost_clause_proved(keyed(b"fn made(xs: List<Int>) -> Int cost 1 = size(Bag(xs))"), "made"),
    ),
  );
  assert(
    unread(
      cost_clause_proved(
        keyed(
          b"fn made(xs: List<Int>) -> Int = size(Bag(xs))\nfn outer(xs: List<Int>) -> Int cost 1 = made(xs)",
        ),
        "outer",
      ),
    ),
  );
  // A definition that holds none is read as before, in the same program.
  assert_eq(
    cost_clause_proved(
      keyed(b"fn total(xs: List<Int>) -> Int cost xs.len() = xs.fold(0, |a: Int, x: Int| a + x)"),
      "total",
    ),
    Ok(true),
  )
}
