import domain (Sort, NamedSort, RecordSort, SortVariable)
import sort (bool_sort, decimal_sort, field_sort, float_sort, int_sort, is_named_sort, string_sort,
             unit_sort, shift_variables)

pub const operator_add: String = "(+)"
pub const operator_sub: String = "(-)"
pub const op_mul: String = "(*)"
pub const operator_div: String = "(/)"
pub const op_rem: String = "(%)"
pub const operator_concat: String = "(++)"
pub const operator_bit_and: String = "(&)"
pub const operator_bit_or: String = "(|)"
pub const op_bit_xor: String = "(^)"
pub const operator_bit_not: String = "(~)"
pub const op_shl: String = "(<<)"
pub const op_shr: String = "(>>)"
pub const op_ushr: String = "(>>>)"
pub const op_lt: String = "(<)"
pub const op_le: String = "(<=)"
pub const op_gt: String = "(>)"
pub const operator_ge: String = "(>=)"

pub const operator_float_rank: String = "Float rank"

pub const operator_float_nan: String = "Float NaN"

pub const operator_decimal_normalized: String = "Decimal normalized"

pub fn operator_float(operator: String) -> String = "Float " ++ operator

pub type ComparisonOperator = | Lt | Le | Gt | Ge

pub type Monomial = { term: Int, coefficient: I128 }

pub type LinearSum = { monomials: List<Monomial>, constant: I128 }

pub type ArmTest =
  | Always
  | TestConstructor(String)
  | TestLiteral(Int)
  | TestList({ fixed: Int, rest: Bool })
  | Undecidable

pub type Arm = { test: ArmTest, binds: List<Int>, body: Int }

pub type Node =
  | IntTerm(Int)
  | BoolTerm(Bool)
  | StringTerm(String)
  | DecimalTerm(String)
  | FloatTerm(Int)
  | FixedTerm(String, Int, Int)
  | UnitTerm
  | SymbolTerm(Int)
  | OpaqueTerm(String)
  | ClosureTerm(Int)
  | LinearSumTerm(LinearSum)
  | ApplicationTerm({ head: Int, args: List<Int> })
  | ConstructorTerm({ name: String, args: List<Int> })
  | NilTerm
  | ConsTerm({ head: Int, tail: Int })
  | RecordTerm(List<{ name: String, value: Int }>)
  | FieldTerm({ base: Int, field: String })
  | NotTerm(Int)
  | AndTerm(Int, Int)
  | OrTerm(Int, Int)
  | CompareTerm({ operation: ComparisonOperator, left_operand: Int, right_operand: Int })
  | EqualTerm({ left_operand: Int, right_operand: Int })
  | EqualAtTerm({ left_operand: Int, right_operand: Int, reflexive: Bool })
  | IfTerm({ cond: Int, then_branch: Int, else_branch: Int })
  | MatchTerm({ scrutinee: Int, arms: List<Arm> })

pub type Terms = {
  nodes: List<Node>,
  sorts: List<Option<Sort>>,
  ints: List<Bool>,
  index: Map<Node, Int>,
  next_symbol: Int,
  constructors: List<Int>,
  lists: List<Int>,
  records: List<Int>,
}

pub type InternedTerm = { terms: Terms, id: Int }

pub const true_id: Int = 0

pub const false_id: Int = 1

pub const new_terms: Terms = {
  let empty: Terms = {
    nodes: [],
    sorts: [],
    ints: [],
    index: Map::new(),
    next_symbol: 0,
    constructors: [],
    lists: [],
    records: [],
  };
  intern(
    intern(empty, BoolTerm(true), Some(bool_sort)).terms,
    BoolTerm(false),
    Some(bool_sort),
  ).terms
}

pub fn size(terms: Terms) -> Int = terms.nodes.len()

pub fn node(terms: Terms, t: Int) -> Node / {abort.raise} =
  match terms.nodes.at(t) {
    Some(n) -> n,
    None -> panic("no term has this index in the term table"),
  }

pub fn sort_of(terms: Terms, t: Int) -> Option<Sort> =
  match terms.sorts.at(t) { Some(s) -> s, None -> None }

pub fn is_int(terms: Terms, t: Int) -> Bool = match terms.ints.at(t) { Some(b) -> b, None -> false }

pub fn force_int(terms: Terms, t: Int) -> Terms / {abort.raise} =
  { ..terms, ints: terms.ints.set(t, true) }

pub fn intern(terms: Terms, n: Node, given: Option<Sort>) -> InternedTerm / {abort.raise} = {
  let sort = if is_polymorphic_term(n, given) { unknown_arguments(given) } else { given };
  match terms.index.get(n) {
    Some(existing) -> {
      let ts2 = match sort_of(terms, existing) {
        None -> { ..terms, sorts: terms.sorts.set(existing, sort) },
        Some(_) -> terms,
      };
      { terms: ts2, id: existing }
    },
    None -> {
      let id = terms.nodes.len();
      let int = (match sort { Some(s) -> is_named_sort(s, "Int"), None -> false })
        || (match n { IntTerm(_) -> true, LinearSumTerm(_) -> true, _ -> false });
      {
        terms: {
          nodes: terms.nodes.push(n),
          sorts: terms.sorts.push(sort),
          ints: terms.ints.push(int),
          index: terms.index.insert(n, id),
          next_symbol: terms.next_symbol,
          constructors: match n {
            ConstructorTerm(_) -> terms.constructors.push(id),
            _ -> terms.constructors,
          },
          lists: match n {
            NilTerm -> terms.lists.push(id),
            ConsTerm(_) -> terms.lists.push(id),
            _ -> terms.lists,
          },
          records: match n { RecordTerm(_) -> terms.records.push(id), _ -> terms.records },
        },
        id: id,
      }
    },
  }
}

fn is_polymorphic_term(n: Node, sort: Option<Sort>) -> Bool =
  match n {
    NilTerm -> true,
    ConstructorTerm(c) -> c.args.len() == 0 && has_parameters(sort),
    ApplicationTerm(a) -> a.args.len() == 0 && has_parameters(sort),
    _ -> false,
  }

fn has_parameters(sort: Option<Sort>) -> Bool =
  match sort { Some(NamedSort(_, args)) -> args.len() > 0, Some(_) -> true, None -> false }

fn unknown_arguments(sort: Option<Sort>) -> Option<Sort> =
  match sort {
    Some(NamedSort(name, args)) ->
      Some(NamedSort(name, range(0, args.len()).map(|i: Int| shift_variables(SortVariable(i))))),
    _ -> None,
  }

pub fn int_literal(terms: Terms, k: Int) -> InternedTerm / {abort.raise} =
  intern(terms, IntTerm(k), Some(int_sort))

pub fn boolean(terms: Terms, b: Bool) -> InternedTerm / {abort.raise} =
  intern(terms, BoolTerm(b), Some(bool_sort))

pub fn string(terms: Terms, s: String) -> InternedTerm / {abort.raise} =
  intern(terms, StringTerm(s), Some(string_sort))

pub fn decimal(terms: Terms, d: Decimal) -> InternedTerm / {abort.raise} =
  intern(terms, DecimalTerm(d.to_string()), Some(decimal_sort))

pub fn float_literal(terms: Terms, bits: Int) -> InternedTerm / {abort.raise} =
  intern(terms, FloatTerm(bits), Some(float_sort))

pub fn is_nan_bits(bits: Int) -> Bool = bits & 0x7FFF_FFFF_FFFF_FFFF > 0x7FF0_0000_0000_0000

pub fn rank_of_bits(bits: Int) -> Int =
  if bits >= 0 { bits } else { 0 - (bits & 0x7FFF_FFFF_FFFF_FFFF) }

pub fn float_nan(terms: Terms, x: Int) -> InternedTerm / {abort.raise} =
  match node(terms, x) {
    FloatTerm(bits) -> boolean(terms, is_nan_bits(bits)),
    _ -> {
      let head = opaque(terms, operator_float_nan, None);
      app(head.terms, head.id, [x], Some(bool_sort))
    },
  }

pub fn float_rank(terms: Terms, x: Int) -> InternedTerm / {abort.raise} =
  match node(terms, x) {
    FloatTerm(bits) -> int_literal(terms, rank_of_bits(bits)),
    _ -> {
      let head = opaque(terms, operator_float_rank, None);
      let made = app(head.terms, head.id, [x], Some(int_sort));
      { terms: force_int(made.terms, made.id), id: made.id }
    },
  }

pub fn decimal_normalized(terms: Terms, x: Int) -> InternedTerm / {abort.raise} =
  match node(terms, x) {
    DecimalTerm(written) ->
      intern(terms, DecimalTerm(normalized_text(written)), Some(decimal_sort)),
    ApplicationTerm(a) -> match node(terms, a.head) {
      OpaqueTerm(name) -> if name == operator_decimal_normalized { { terms: terms, id: x } }
      else { opaque_normalized(terms, x) },
      _ -> opaque_normalized(terms, x),
    },
    _ -> opaque_normalized(terms, x),
  }

fn opaque_normalized(terms: Terms, x: Int) -> InternedTerm / {abort.raise} = {
  let head = opaque(terms, operator_decimal_normalized, None);
  app(head.terms, head.id, [x], Some(decimal_sort))
}

pub fn normalized_text(written: String) -> String / {abort.raise} = {
  let b = Bytes::of_string(written);
  let trimmed = if b.index_of(b".") == None { b } else {
    let significant_length = iterate(b.len(), b.len() + 1, |n: Int|
      if n > 0 && b.at(n - 1) == 48 { Continue(n - 1) } else { Stop(n) });
    let cut = b.slice(0, significant_length);
    if cut.ends_with(b".") { cut.slice(0, cut.len() - 1) } else { cut }
  };
  let text = String::of_bytes_lossy(trimmed);
  if text == "-0" { "0" } else { text }
}

pub fn fixed(terms: Terms, width: String, high: Int, low: Int) -> InternedTerm / {abort.raise} =
  intern(terms, FixedTerm(width, high, low), Some(NamedSort(width, [])))

pub fn unit(terms: Terms) -> InternedTerm / {abort.raise} = intern(terms, UnitTerm, Some(unit_sort))

pub fn nil(terms: Terms, sort: Option<Sort>) -> InternedTerm / {abort.raise} =
  intern(terms, NilTerm, sort)

pub fn cons(
  terms: Terms,
  head: Int,
  tail: Int,
  sort: Option<Sort>,
) -> InternedTerm / {abort.raise} = intern(terms, ConsTerm({ head: head, tail: tail }), sort)

pub fn symbol(terms: Terms, sort: Option<Sort>) -> InternedTerm / {abort.raise} = {
  let made = intern(terms, SymbolTerm(terms.next_symbol), sort);
  { terms: { ..made.terms, next_symbol: terms.next_symbol + 1 }, id: made.id }
}

pub fn opaque(terms: Terms, name: String, sort: Option<Sort>) -> InternedTerm / {abort.raise} =
  intern(terms, OpaqueTerm(name), sort)

pub fn constant(k: I128) -> LinearSum = { monomials: [], constant: k }

pub fn linear_sum_of(terms: Terms, t: Int) -> LinearSum / {abort.raise} =
  match node(terms, t) {
    IntTerm(k) -> constant(I128::of_int(k)),
    LinearSumTerm(p) -> p,
    _ -> { monomials: [{ term: t, coefficient: 1i128 }], constant: 0i128 },
  }

pub fn scaled(p: LinearSum, factor: I128) -> Option<LinearSum> =
  match checked_mul(p.constant, factor) {
    None -> None,
    Some(k) -> match p.monomials.fold(
        Some([]),
        |accumulator: Option<List<Monomial>>, m: Monomial|
          match accumulator {
            None -> None,
            Some(ms) -> match checked_mul(m.coefficient, factor) {
              None -> None,
              Some(c) -> if c == 0i128 { Some(ms) }
              else { Some(ms.push({ term: m.term, coefficient: c })) },
            },
          },
      ) {
      None -> None,
      Some(ms) -> Some({ monomials: ms, constant: k }),
    },
  }

pub fn plus(a: LinearSum, b: LinearSum) -> Option<LinearSum> =
  match checked_add(a.constant, b.constant) {
    None -> None,
    Some(k) -> match merged(a.monomials, b.monomials, 0, 0, []) {
      None -> None,
      Some(ms) -> Some({ monomials: ms, constant: k }),
    },
  }

fn merged(
  xs: List<Monomial>,
  ys: List<Monomial>,
  i: Int,
  j: Int,
  out: List<Monomial>,
) -> Option<List<Monomial>> =
  match xs.at(i) {
    None ->
      Some(
        range(j, ys.len()).fold(out, |accumulator: List<Monomial>, k: Int|
          match ys.at(k) { Some(m) -> accumulator.push(m), None -> accumulator }),
      ),
    Some(x) -> match ys.at(j) {
      None ->
        Some(
          range(i, xs.len()).fold(out, |accumulator: List<Monomial>, k: Int|
            match xs.at(k) { Some(m) -> accumulator.push(m), None -> accumulator }),
        ),
      Some(y) -> if x.term == y.term {
        match checked_add(x.coefficient, y.coefficient) {
          None -> None,
          Some(c) ->
            merged(xs, ys, i + 1, j + 1, if c == 0i128 { out }
            else { out.push({ term: x.term, coefficient: c }) }),
        }
      } else if x.term < y.term { merged(xs, ys, i + 1, j, out.push(x)) }
      else { merged(xs, ys, i, j + 1, out.push(y)) },
    },
  }

pub fn intern_linear_sum(terms: Terms, p: LinearSum) -> Option<InternedTerm> / {abort.raise} =
  match p.monomials {
    [] -> match checked_int(p.constant) { Some(k) -> Some(int_literal(terms, k)), None -> None },
    [m] -> if m.coefficient == 1i128 && p.constant == 0i128 { Some({ terms: terms, id: m.term }) }
    else { Some(intern_linear(terms, p)) },
    _ -> Some(intern_linear(terms, p)),
  }

fn intern_linear(terms: Terms, p: LinearSum) -> InternedTerm / {abort.raise} = {
  let made = intern(terms, LinearSumTerm(p), Some(int_sort));
  { terms: force_int(made.terms, made.id), id: made.id }
}

fn checked_int(k: I128) -> Option<Int> / {abort.raise} =
  if k < I128::of_int(0 - 9223372036854775807 - 1) || k > I128::of_int(9223372036854775807) { None }
  else { Some(Int::of_i128(k)) }

pub fn add(terms: Terms, a: Int, b: Int) -> Option<InternedTerm> / {abort.raise} =
  match plus(linear_sum_of(terms, a), linear_sum_of(terms, b)) {
    None -> None,
    Some(p) -> intern_linear_sum(terms, p),
  }

pub fn sub(terms: Terms, a: Int, b: Int) -> Option<InternedTerm> / {abort.raise} =
  match scaled(linear_sum_of(terms, b), -1i128) {
    None -> None,
    Some(negated) -> match plus(linear_sum_of(terms, a), negated) {
      None -> None,
      Some(p) -> intern_linear_sum(terms, p),
    },
  }

pub fn neg(terms: Terms, a: Int) -> Option<InternedTerm> / {abort.raise} =
  match scaled(linear_sum_of(terms, a), -1i128) {
    None -> None,
    Some(p) -> intern_linear_sum(terms, p),
  }

pub fn mul(terms: Terms, a: Int, b: Int) -> Option<InternedTerm> / {abort.raise} =
  match node(terms, a) {
    IntTerm(k) -> times(terms, linear_sum_of(terms, b), k),
    _ -> match node(terms, b) { IntTerm(k) -> times(terms, linear_sum_of(terms, a), k), _ -> None },
  }

fn times(terms: Terms, p: LinearSum, k: Int) -> Option<InternedTerm> / {abort.raise} =
  match scaled(p, I128::of_int(k)) { None -> None, Some(q) -> intern_linear_sum(terms, q) }

pub fn field(terms: Terms, base: Int, name: String) -> InternedTerm / {abort.raise} =
  match node(terms, base) {
    RecordTerm(fields) -> match fields.fold(
        None,
        |accumulator: Option<Int>, f: { name: String, value: Int }|
          match accumulator {
            Some(_) -> accumulator,
            None -> if f.name == name { Some(f.value) } else { None },
          },
      ) {
      Some(v) -> { terms: terms, id: v },
      None -> projected(terms, base, name),
    },
    _ -> projected(terms, base, name),
  }

fn projected(terms: Terms, base: Int, name: String) -> InternedTerm / {abort.raise} =
  intern(terms, FieldTerm({ base: base, field: name }), match sort_of(terms, base) {
    Some(s) -> field_sort(s, name),
    None -> None,
  })

pub fn not(terms: Terms, a: Int) -> InternedTerm / {abort.raise} =
  match node(terms, a) {
    BoolTerm(b) -> boolean(terms, !b),
    NotTerm(inner) -> { terms: terms, id: inner },
    _ -> intern(terms, NotTerm(a), Some(bool_sort)),
  }

pub fn and(terms: Terms, a: Int, b: Int) -> InternedTerm / {abort.raise} =
  intern(terms, AndTerm(a, b), Some(bool_sort))

pub fn or(terms: Terms, a: Int, b: Int) -> InternedTerm / {abort.raise} =
  intern(terms, OrTerm(a, b), Some(bool_sort))

pub fn comparison(
  terms: Terms,
  operator: ComparisonOperator,
  left: Int,
  right: Int,
) -> InternedTerm / {abort.raise} =
  intern(
    terms,
    CompareTerm({ operation: operator, left_operand: left, right_operand: right }),
    Some(bool_sort),
  )

pub fn eq(terms: Terms, left: Int, right: Int) -> InternedTerm / {abort.raise} = {
  let low = if left <= right { left } else { right };
  let high = if left <= right { right } else { left };
  intern(
    project_fields(terms, low, high),
    EqualTerm({ left_operand: low, right_operand: high }),
    Some(bool_sort),
  )
}

pub fn intern_equality(
  terms: Terms,
  left: Int,
  right: Int,
  reflexive: Bool,
) -> InternedTerm / {abort.raise} =
  if left == right && reflexive { boolean(terms, true) } else {
    let low = if left <= right { left } else { right };
    let high = if left <= right { right } else { left };
    intern(
      terms,
      EqualAtTerm({ left_operand: low, right_operand: high, reflexive: reflexive }),
      Some(bool_sort),
    )
  }

fn project_fields(terms: Terms, a: Int, b: Int) -> Terms / {abort.raise} =
  match sort_of(terms, a) { Some(shape) -> projecting(terms, a, b, shape), None -> terms }

fn projecting(terms: Terms, a: Int, b: Int, shape: Sort) -> Terms / {abort.raise} =
  match sort_of(terms, a) {
    Some(RecordSort(left)) -> match sort_of(terms, b) {
      Some(RecordSort(right)) -> if left.map(|f: { name: String, ty: Sort }| f.name)
          != right.map(|f: { name: String, ty: Sort }| f.name) { terms } else {
        left.fold(terms, |accumulator: Terms, f: { name: String, ty: Sort }| {
          let x = field(accumulator, a, f.name);
          let y = field(x.terms, b, f.name);
          if x.id == y.id { y.terms } else {
            match shape {
              RecordSort(shaped) -> match shaped.fold(
                  None,
                  |found: Option<Sort>, g: { name: String, ty: Sort }|
                    match found {
                      Some(_) -> found,
                      None -> if g.name == f.name { Some(g.ty) } else { None },
                    },
                ) {
                Some(inner) -> projecting(y.terms, x.id, y.id, inner),
                None -> y.terms,
              },
              _ -> y.terms,
            }
          }
        })
      },
      _ -> terms,
    },
    _ -> terms,
  }

pub fn app(
  terms: Terms,
  head: Int,
  args: List<Int>,
  sort: Option<Sort>,
) -> InternedTerm / {abort.raise} = intern(terms, ApplicationTerm({ head: head, args: args }), sort)

test "equal nodes share one term id, and a new term table already contains `true` and `false`" {
  let terms = new_terms;
  assert_eq(node(terms, true_id), BoolTerm(true));
  assert_eq(node(terms, false_id), BoolTerm(false));
  let a = int_literal(terms, 3);
  let b = int_literal(a.terms, 3);
  assert_eq(a.id, b.id);
  assert_eq(size(b.terms), 3)
}

test "a linear term folds its constants and cancels to a literal" {
  let x = symbol(new_terms, Some(int_sort));
  let one = int_literal(x.terms, 1);
  let up = match add(one.terms, x.id, one.id) { Some(m) -> m, None -> panic("in range") };
  let back = match sub(up.terms, up.id, one.id) { Some(m) -> m, None -> panic("in range") };
  assert_eq(back.id, x.id);
  let two = int_literal(back.terms, 2);
  let twice = match mul(two.terms, x.id, two.id) { Some(m) -> m, None -> panic("in range") };
  assert_eq(linear_sum_of(twice.terms, twice.id), {
    monomials: [{ term: x.id, coefficient: 2i128 }],
    constant: 0i128,
  })
}

test "a constant outside Int has no term" {
  let terms = new_terms;
  let big = int_literal(terms, 9223372036854775807);
  let one = int_literal(big.terms, 1);
  assert_eq(add(one.terms, big.id, one.id), None)
}

test "adding zero changes nothing, and adding the same terms in either order gives the same term" {
  let x = symbol(new_terms, Some(int_sort));
  let zero = int_literal(x.terms, 0);
  let plus_zero = match add(zero.terms, x.id, zero.id) { Some(m) -> m, None -> panic("in range") };
  assert_eq(plus_zero.id, x.id);
  let one = int_literal(plus_zero.terms, 1);
  let a = match add(one.terms, x.id, one.id) { Some(m) -> m, None -> panic("in range") };
  let b = match add(a.terms, one.id, x.id) { Some(m) -> m, None -> panic("in range") };
  assert_eq(a.id, b.id)
}

test "a coefficient that overflows produces no term" {
  let x = symbol(new_terms, Some(int_sort));
  let big = int_literal(x.terms, 9223372036854775807);
  let scaled = match mul(big.terms, x.id, big.id) { Some(m) -> m, None -> panic("in range") };
  let again = match mul(scaled.terms, scaled.id, big.id) {
    Some(m) -> m,
    None -> panic("in range"),
  };
  assert_eq(mul(again.terms, again.id, big.id), None)
}

test "`mul` of two symbolic terms returns `None` because the product is not linear" {
  let x = symbol(new_terms, Some(int_sort));
  let y = symbol(x.terms, Some(int_sort));
  assert_eq(mul(y.terms, x.id, y.id), None)
}

test "projection reduces over a record literal" {
  let v = int_literal(new_terms, 7);
  let record = intern(v.terms, RecordTerm([{ name: "balance", value: v.id }]), None);
  assert_eq(field(record.terms, record.id, "balance").id, v.id)
}

test "every fresh symbol is a distinct term" {
  let a = symbol(new_terms, None);
  let b = symbol(a.terms, None);
  assert(a.id != b.id)
}
