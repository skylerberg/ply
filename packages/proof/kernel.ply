//! `kernel` — what makes an induction a proof, checked from the claim alone. The record a certificate
//! keeps of an induction names one of the claim's own binders, takes it apart below each case it
//! proves, and unrolls only definitions the checker saw end; the cases it splits the claim into are
//! lowered and refuted here, whatever search proposed it.
//!
//! An unrolled definition is total, so its calls are values and its body may be unrolled with
//! `f(x̄) == body(x̄)` in hand. The claim is proved at the base case, and at the step from its own
//! instance below, whose recursive calls are left as they are so the unrolled conclusion meets them by
//! congruence.

import compiler.emit.code (Code)
import context (Context, self_recursive, terminates, set_of)
import goal (Goal, Binder, Limits, Proof, Assertion, RefutationResult, run_refutation, conjunction,
             domain_inhabited, uninterpreted_sorts, int_ranges, ranges_of, true_assertions)
import lower (Lowering, LoweredTerm, Blocker, Induction, lowering, bind_symbolic, lower_root,
              assume, assume_invariants, call_depth_limit, drop_assumptions, smaller_than,
              requirements_since, requirements_between)
import rules (RuleLog, Rule, Scheme, Descent, Spine, no_rules, rules_of, induction_rule)
import solve (Closed)
import sort (bool_sort, is_named_sort, list_element)
import term (Terms, ApplicationTerm, Le, Gt, node, int_literal, sub, nil, cons, symbol, not, and,
             or, cmp, eq)
import std.list

/// The binder at `slot`, named `binder`, taken apart by `scheme`, with `definitions` unrolled.
pub type InductionPlan = { binder: String, slot: Int, scheme: Scheme, definitions: List<String> }

pub type InductionResult = { proof: Option<Proof>, used: Int, blockers: List<Blocker> }

pub fn add_induction_blocker(blockers: List<Blocker>, reason: String) -> List<Blocker> =
  blockers.push(Induction(reason))

/// The reason a record proves nothing whatever its cases show, or `None` when its cases decide it.
pub fn rejection(context: Context, g: Goal, r: InductionPlan) -> Option<String> = {
  let result_slot = match g.result { Some(_) -> g.binders.len() - 1, None -> 0 - 1 };
  match g.binders.at(r.slot) {
    None -> Some("the claim has no binder at " ++ r.slot.to_string()),
    Some(b) -> if b.name != r.binder {
      Some("the claim's binder at " ++ r.slot.to_string() ++ " is `" ++ b.name ++ "`")
    } else if r.slot == result_slot { Some("`result` is the return value, not a binder") } else {
      let shape = match r.scheme {
        Descent(k) -> if !is_named_sort(b.ty, "Int") { Some("`" ++ b.name ++ "` is not an `Int`") }
        else if k < 1 { Some("the hypothesis is not below the case it proves") }
        else { None },
        Spine(k) -> if list_element(b.ty) == None { Some("`" ++ b.name ++ "` is not a list") }
        else if k < 1 { Some("the hypothesis is not below the case it proves") }
        else if k > 1 { Some("a spine is taken apart one head at a time") }
        else { None },
      };
      match shape { Some(reason) -> Some(reason), None -> unroll_rejection(context, r.definitions) }
    },
  }
}

fn unroll_rejection(context: Context, definitions: List<String>) -> Option<String> =
  if definitions.len() == 0 { Some("it unrolls no definition") } else {
    definitions.fold(None, |reason: Option<String>, name: String|
      match reason {
        Some(_) -> reason,
        None -> match self_recursive(context, name) {
          None -> Some("`" ++ name ++ "` is not a pure definition calling only itself"),
          Some(_) -> if terminates(context, name) { None } else {
            Some("the checker does not see every call `" ++ name ++ "` makes of itself descend")
          },
        },
      })
  }

/// The record checked, then its cases refuted on `budget`.
pub fn check_induction(
  context: Context,
  g: Goal,
  r: InductionPlan,
  limits: Limits,
  budget: Int,
  blockers: List<Blocker>,
) -> InductionResult / {abort.raise} =
  match rejection(context, g, r) {
    Some(reason) ->
      {
        proof: None,
        used: 0,
        blockers: add_induction_blocker(blockers, "on `" ++ r.binder ++ "`: " ++ reason),
      },
    None -> {
      let cases = match r.scheme {
        Descent(k) -> induct_int(context, g, limits, budget, r.definitions, r.slot, k, blockers),
        Spine(_) -> induct_list(context, g, limits, budget, r.definitions, r.slot, blockers),
      };
      match cases.proof {
        Some(p) ->
          {
            ..cases,
            proof: Some({
              ..p,
              rules: r.definitions.fold(p.rules, |acc: List<Rule>, definition: String|
                acc.push(induction_rule(r.binder, r.scheme, definition))),
            }),
          },
        None -> cases,
      }
    },
  }

/// A refutation on the shared budget; `contradictory` when the assertions contradict each other.
type CountedRefutation = {
  terms: Terms,
  rules: RuleLog,
  budget: Int,
  spent: Int,
  contradictory: Bool,
}

fn refute_counting(
  terms: Terms,
  context: Context,
  rules: RuleLog,
  limits: Limits,
  budget: Int,
  spent: Int,
  assertions: List<Assertion>,
) -> CountedRefutation / {abort.raise} = {
  let r = run_refutation(terms, context, rules, budget, limits, assertions);
  {
    terms: r.terms,
    rules: r.rules,
    budget: r.left,
    spent: spent + (budget - r.left),
    contradictory: r.result == Closed,
  }
}

fn budget_spent_note(budget: Int) -> String = if budget == 0 { ", the budget spent" } else { "" }

/// The goal's binders as symbols, each that is no `result` holding its type's invariant: what a
/// definition returns holds it only once its own `builds` claims are shown.
fn bind_binders(
  lowering: Lowering,
  context: Context,
  g: Goal,
) -> { lowering: Lowering, ids: List<Int> } / {abort.raise} = {
  let bound = g.binders.fold(
    { lowering: lowering, ids: [] },
    |acc: { lowering: Lowering, ids: List<Int> }, binder: Binder| {
      let r = bind_symbolic(acc.lowering, binder.ty);
      { lowering: r.lowering, ids: acc.ids.push(r.id) }
    },
  );
  let given = match g.result { Some(_) -> bound.ids.take(bound.ids.len() - 1), None -> bound.ids };
  {
    ..bound,
    lowering: assume_invariants(
      { ..bound.lowering, binder_terms: bound.ids },
      context,
      given,
      call_depth_limit(),
    ),
  }
}

/// A type stating an invariant that `lowering` built a value of and `g` stood on: a step that
/// unrolls a definition can make what the claim's own reading did not.
fn untainted_built_type(lowering: Lowering, g: Goal) -> Option<String> =
  lowering.constructed.find(|t: String| !g.tainted.contains(t))

/// `And(body, needs)` when anything is owed.
fn conjoin_needs(
  terms: Terms,
  body: Int,
  needs: List<Int>,
) -> { terms: Terms, id: Int } / {abort.raise} = {
  let c = conjunction(terms, needs);
  match c.id {
    Some(n) -> {
      let m = and(c.terms, body, n);
      { terms: m.terms, id: m.id }
    },
    None -> { terms: c.terms, id: body },
  }
}

/// `Or(!guard, conclusion)` when there is a guard.
fn guard_implies(
  terms: Terms,
  guards: List<Int>,
  conclusion: Int,
) -> { terms: Terms, id: Int } / {abort.raise} = {
  let c = conjunction(terms, guards);
  match c.id {
    Some(gd) -> {
      let unguarded = not(c.terms, gd);
      let m = or(unguarded.terms, unguarded.id, conclusion);
      { terms: m.terms, id: m.id }
    },
    None -> { terms: c.terms, id: conclusion },
  }
}

fn guard_satisfiable(
  terms: Terms,
  context: Context,
  limits: Limits,
  budget: Int,
  spent: Int,
  binders: List<Binder>,
  guards: List<Int>,
) -> { ok: Bool, spent: Int } / {abort.raise} =
  if !domain_inhabited(context, binders) { { ok: false, spent: spent } } else {
    let c = conjunction(terms, guards);
    match c.id {
      None -> { ok: true, spent: spent },
      Some(all) -> {
        let s = refute_counting(c.terms, context, no_rules(), limits, budget, spent, [
          { term: all, polarity: false },
        ]);
        { ok: s.contradictory, spent: s.spent }
      },
    }
  }

/// The claim at `n <= 0`, then at `n > 0` from its instance at `n - step`.
fn induct_int(
  context: Context,
  g: Goal,
  limits: Limits,
  budget: Int,
  recursive: List<String>,
  slot: Int,
  step: Int,
  blockers: List<Blocker>,
) -> InductionResult / {abort.raise} = {
  let binder = match g.binders.at(slot) { Some(b) -> b.name, None -> "" };
  let no = |reason: String, used: Int|
    {
      proof: None,
      used: used,
      blockers: add_induction_blocker(blockers, "on `" ++ binder ++ "`: " ++ reason),
    };
  let recursive_set = recursive.fold(Map::new(), |m: Map<String, Bool>, n: String|
    m.insert(n, true));
  let start = {
    ..lowering(no_rules(), limits.unfold_depth),
    total: g.assumed_terminating.fold(recursive_set, |m: Map<String, Bool>, n: String|
      m.insert(n, true)),
    unrolled: recursive_set,
    lemmas: g.lemmas,
    identities: set_of(g.identities),
    contracts: set_of(g.contracts),
    tainted: g.tainted,
    in_law: g.result == None,
  };
  let bound = bind_binders(start, context, g);
  let guarded_lw = g.guards.fold(
    { lowering: bound.lowering, ids: [] },
    |acc: { lowering: Lowering, ids: List<Int> }, guard: Option<Code>| {
      let r = lower_root(acc.lowering, context, guard, bound.ids);
      { lowering: assume(r.lowering, r.id), ids: acc.ids.push(r.id) }
    },
  );
  let guard_mark = guarded_lw.lowering.requirements.len();
  let defined_result = match g.result {
    Some(result_body) -> if bound.ids.len() == 0 {
      { lowering: guarded_lw.lowering, definition: None }
    } else {
      let r = lower_root(
        { ..guarded_lw.lowering, return_owed: false },
        context,
        result_body,
        bound.ids.take(bound.ids.len() - 1),
      );
      {
        lowering: { ..r.lowering, return_owed: true },
        definition: Some({
          symbol: match bound.ids.at(bound.ids.len() - 1) { Some(t) -> t, None -> 0 },
          value: r.id,
        }),
      }
    },
    None -> { lowering: guarded_lw.lowering, definition: None },
  };
  let body = lower_root(defined_result.lowering, context, g.body, bound.ids);
  let body_mark = body.lowering.requirements.len();
  let claim_calls = body.lowering.calls;
  // The hypothesis: the same claim `step` below, its recursive calls left unrolled.
  let down = { ..drop_assumptions(body.lowering), unrolled: Map::new() };
  let below = int_literal(down.terms, step);
  match sub(below.terms, match bound.ids.at(slot) { Some(t) -> t, None -> 0 }, below.id) {
    None -> no("no term for the step down", 0),
    Some(previous) -> {
      let lw0 = { ..down, terms: previous.terms };
      let prior0 = bound.ids.set(slot, previous.id);
      let prior_guards = g.guards.fold(
        { lowering: lw0, ids: [] },
        |acc: { lowering: Lowering, ids: List<Int> }, guard: Option<Code>| {
          let r = lower_root(acc.lowering, context, guard, prior0);
          { lowering: r.lowering, ids: acc.ids.push(r.id) }
        },
      );
      let with_result = match g.result {
        Some(result_body) -> if prior0.len() == 0 {
          { lowering: prior_guards.lowering, prior: prior0 }
        } else {
          let r = lower_root(
            { ..prior_guards.lowering, return_owed: false },
            context,
            result_body,
            prior0.take(prior0.len() - 1),
          );
          {
            lowering: { ..r.lowering, return_owed: true },
            prior: prior0.set(prior0.len() - 1, r.id),
          }
        },
        None -> { lowering: prior_guards.lowering, prior: prior0 },
      };
      let prior_body = lower_root(with_result.lowering, context, g.body, with_result.prior);
      let lw1 = prior_body.lowering;
      let hypothesis_needs = requirements_since(lw1, body_mark);
      let unstood = untainted_built_type(lw1, g);
      // The hypothesis makes values of the calls it reaches; a call it does not reach, and that no
      // equation defines, is one this induction cannot speak for.
      let covered = set_of(lw1.calls.drop(claim_calls.len())).keys();
      let defined = lw1.defined;
      if unstood != None {
        no("it builds a `" ++ unstood.unwrap_or("") ++ "`, whose invariant it stood on", 0)
      } else if claim_calls.fold(false, |f: Bool, c: Int|
          f || (!covered.contains(c) && !defined.contains(c))) {
        no("a remaining call is not one the hypothesis reaches", 0)
      } else {
        let requirements = lw1.requirements;
        let equations = lw1.equations;
        let definition = match defined_result.definition {
          Some(d) -> {
            let m = eq(lw1.terms, d.symbol, d.value);
            { terms: m.terms, eq: Some(m.id), symbol: Some(d.symbol) }
          },
          None -> { terms: lw1.terms, eq: None, symbol: None },
        };
        let in_question = set_of(covered.concat(defined));
        let ranges = int_ranges(definition.terms, definition.symbol, in_question);
        let guard_needs = requirements.take(guard_mark);
        let body_needs = requirements.drop(guard_mark).take(body_mark - guard_mark);
        let needed = conjunction(ranges.terms, guard_needs);
        let guard_check = match needed.id {
          None ->
            {
              terms: needed.terms,
              rules: lw1.rules,
              budget: budget,
              spent: 0,
              contradictory: true,
            },
          Some(conjoined) ->
            refute_counting(
              needed.terms,
              context,
              lw1.rules,
              limits,
              budget,
              0,
              ranges.out.push({ term: conjoined, polarity: false }),
            ),
        };
        if !guard_check.contradictory { no("the guard can raise", guard_check.spent) } else {
          let claim = conjoin_needs(guard_check.terms, body.id, body_needs);
          let conclusion = conjoin_needs(claim.terms, prior_body.id, hypothesis_needs);
          let hypothesis = guard_implies(conclusion.terms, prior_guards.ids, conclusion.id);
          let zero = int_literal(hypothesis.terms, 0);
          let n = match bound.ids.at(slot) { Some(t) -> t, None -> 0 };
          let base = cmp(zero.terms, Le, n, zero.id);
          let step = cmp(base.terms, Gt, n, zero.id);
          let common = ranges.out.concat(true_assertions(guarded_lw.ids)).concat(
            true_assertions(equations),
          ).concat(
            true_assertions(lw1.facts),
          ).concat(match definition.eq { Some(d) -> [{ term: d, polarity: true }], None -> [] });
          let base_case = refute_counting(
            step.terms,
            context,
            guard_check.rules,
            limits,
            guard_check.budget,
            guard_check.spent,
            common.concat([{ term: base.id, polarity: true }, { term: claim.id, polarity: false }]),
          );
          if !base_case.contradictory {
            no("the base case is open" ++ budget_spent_note(base_case.budget), base_case.spent)
          } else {
            let covered_ranges = ranges_of(base_case.terms, covered);
            let step_case = refute_counting(
              covered_ranges.terms,
              context,
              base_case.rules,
              limits,
              base_case.budget,
              base_case.spent,
              common.concat([
                { term: step.id, polarity: true },
                { term: hypothesis.id, polarity: true },
              ]).concat(
                covered_ranges.out,
              ).push({ term: claim.id, polarity: false }),
            );
            if !step_case.contradictory {
              no("the step is open" ++ budget_spent_note(step_case.budget), step_case.spent)
            } else {
              let sat = guard_satisfiable(
                step_case.terms,
                context,
                limits,
                step_case.budget,
                step_case.spent,
                g.binders,
                guarded_lw.ids,
              );
              {
                proof: Some({
                  rules: rules_of(step_case.rules),
                  steps: sat.spent,
                  sorts: uninterpreted_sorts(g.binders),
                  guard_satisfiable: sat.ok,
                }),
                used: sat.spent,
                blockers: blockers.concat(lw1.blockers),
              }
            }
          }
        }
      }
    },
  }
}

/// The claim lowered with the binder at `at`: its guards, what they owe, its body and what it owes.
type Instance = { guards: List<Int>, guard_needs: List<Int>, body: Int, needs: List<Int> }

fn instance(
  lowering: Lowering,
  context: Context,
  g: Goal,
  bound: List<Int>,
  slot: Int,
  at: Int,
) -> { lowering: Lowering, inst: Instance } / {abort.raise} = {
  let placed = bound.set(slot, at);
  let start = drop_assumptions(lowering);
  let before = start.requirements.len();
  let guards = g.guards.fold(
    { lowering: start, ids: [] },
    |acc: { lowering: Lowering, ids: List<Int> }, guard: Option<Code>| {
      let r = lower_root(acc.lowering, context, guard, placed);
      { lowering: assume(r.lowering, r.id), ids: acc.ids.push(r.id) }
    },
  );
  let guard_mark = guards.lowering.requirements.len();
  let body = lower_root(guards.lowering, context, g.body, placed);
  let after = body.lowering.requirements.len();
  {
    lowering: body.lowering,
    inst: {
      guards: guards.ids,
      guard_needs: requirements_between(body.lowering, before, guard_mark),
      body: body.id,
      needs: requirements_between(body.lowering, guard_mark, after),
    },
  }
}

/// The claim at `[]`, then at `[h, ..t]` from its instance at `t`. Each instance is its own
/// lowering, so `List::len` and the matches in reach reduce over the spine they are given.
fn induct_list(
  context: Context,
  g: Goal,
  limits: Limits,
  budget: Int,
  recursive: List<String>,
  slot: Int,
  blockers: List<Blocker>,
) -> InductionResult / {abort.raise} = {
  let binder = match g.binders.at(slot) { Some(b) -> b, None -> { name: "", ty: bool_sort() } };
  let no = |reason: String, used: Int|
    {
      proof: None,
      used: used,
      blockers: add_induction_blocker(blockers, "on `" ++ binder.name ++ "`: " ++ reason),
    };
  match g.result {
    Some(_) -> no("a clause with a `result` is not inducted over a list", 0),
    None -> {
      let recursive_set = recursive.fold(Map::new(), |m: Map<String, Bool>, n: String|
        m.insert(n, true));
      let start = {
        ..lowering(no_rules(), limits.unfold_depth),
        total: g.assumed_terminating.fold(recursive_set, |m: Map<String, Bool>, n: String|
          m.insert(n, true)),
        unrolled: recursive_set,
        lemmas: g.lemmas,
        identities: set_of(g.identities),
        contracts: set_of(g.contracts),
        tainted: g.tainted,
        in_law: true,
      };
      let bound = bind_binders(start, context, g);
      let sort = binder.ty;
      let elem = list_element(sort);
      let empty = nil(bound.lowering.terms, Some(sort));
      let head = symbol(empty.terms, elem);
      let tail = symbol(head.terms, Some(sort));
      let pair = cons(tail.terms, head.id, tail.id, Some(sort));
      let lw0 = { ..bound.lowering, terms: pair.terms };
      let base = instance(lw0, context, g, bound.ids, slot, empty.id);
      let step = instance(base.lowering, context, g, bound.ids, slot, pair.id);
      let claim_calls = step.lowering.calls;
      // A remaining call over a tail the patterns took off the instance is one the hypothesis speaks for.
      let structural = claim_calls.filter(|c: Int|
        match node(step.lowering.terms, c) {
          ApplicationTerm(a) ->
            a.args.fold(false, |f: Bool, x: Int|
              f || smaller_than(step.lowering, x, pair.id)
                || smaller_than(step.lowering, x, empty.id)),
          _ -> false,
        });
      let hyp = instance(
        { ..step.lowering, unrolled: Map::new() },
        context,
        g,
        bound.ids,
        slot,
        tail.id,
      );
      let lw1 = hyp.lowering;
      let covered = set_of(lw1.calls.drop(claim_calls.len())).keys();
      let defined = lw1.defined;
      let unstood = untainted_built_type(lw1, g);
      if unstood != None {
        no("it builds a `" ++ unstood.unwrap_or("") ++ "`, whose invariant it stood on", 0)
      } else if claim_calls.fold(false, |f: Bool, c: Int|
          f || (!covered.contains(c) && !defined.contains(c) && !structural.contains(c))) {
        no("a remaining call is not one the hypothesis reaches", 0)
      } else {
        let equations = lw1.equations;
        let in_question = set_of(covered.concat(defined).concat(structural));
        let ranges = int_ranges(lw1.terms, None, in_question);
        let guards_checked = [base.inst, step.inst].fold(
          {
            st: {
              terms: ranges.terms,
              rules: lw1.rules,
              budget: budget,
              spent: 0,
              contradictory: true,
            },
            failed: false,
          },
          |acc: { st: CountedRefutation, failed: Bool }, case: Instance|
            if acc.failed { acc } else {
              let c = conjunction(acc.st.terms, case.guard_needs);
              match c.id {
                None -> { st: { ..acc.st, terms: c.terms }, failed: false },
                Some(conjoined) -> {
                  let s = refute_counting(
                    c.terms,
                    context,
                    acc.st.rules,
                    limits,
                    acc.st.budget,
                    acc.st.spent,
                    ranges.out.push({ term: conjoined, polarity: false }),
                  );
                  { st: s, failed: !s.contradictory }
                },
              }
            },
        );
        if guards_checked.failed { no("the guard can raise", guards_checked.st.spent) } else {
          let gs = guards_checked.st;
          let base_claim = conjoin_needs(gs.terms, base.inst.body, base.inst.needs);
          let step_claim = conjoin_needs(base_claim.terms, step.inst.body, step.inst.needs);
          let conclusion = conjoin_needs(step_claim.terms, hyp.inst.body, hyp.inst.needs);
          let hypothesis = guard_implies(conclusion.terms, hyp.inst.guards, conclusion.id);
          let common = ranges.out.concat(true_assertions(equations)).concat(
            true_assertions(lw1.facts),
          );
          let base_case = refute_counting(
            hypothesis.terms,
            context,
            gs.rules,
            limits,
            gs.budget,
            gs.spent,
            common.concat(true_assertions(base.inst.guards)).push({
              term: base_claim.id,
              polarity: false,
            }),
          );
          if !base_case.contradictory {
            no("the base case is open" ++ budget_spent_note(base_case.budget), base_case.spent)
          } else {
            let covered_ranges = ranges_of(base_case.terms, covered);
            let step_case = refute_counting(
              covered_ranges.terms,
              context,
              base_case.rules,
              limits,
              base_case.budget,
              base_case.spent,
              common.concat(true_assertions(step.inst.guards)).push({
                term: hypothesis.id,
                polarity: true,
              }).concat(
                covered_ranges.out,
              ).push({ term: step_claim.id, polarity: false }),
            );
            if !step_case.contradictory {
              no("the step is open" ++ budget_spent_note(step_case.budget), step_case.spent)
            } else {
              let sat = guard_satisfiable(
                step_case.terms,
                context,
                limits,
                step_case.budget,
                step_case.spent,
                g.binders,
                step.inst.guards,
              );
              {
                proof: Some({
                  rules: rules_of(step_case.rules),
                  steps: sat.spent,
                  sorts: uninterpreted_sorts(g.binders),
                  guard_satisfiable: sat.ok,
                }),
                used: sat.spent,
                blockers: blockers.concat(lw1.blockers),
              }
            }
          }
        }
      }
    },
  }
}
