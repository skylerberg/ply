pub type Inequality = { coefficients: Map<Int, I128>, constant: I128 }

pub type Feasibility = | Infeasible | Undecided

pub type EliminationResult = { result: Feasibility, budget: Int }

fn max_rows() -> Int = 512

pub fn add_inequality(
  rows: List<Inequality>,
  coeffs: Map<Int, I128>,
  konst: I128,
) -> List<Inequality> = rows.push({ coefficients: coeffs, constant: konst })

pub fn add_equality(
  rows: List<Inequality>,
  coeffs: Map<Int, I128>,
  konst: I128,
) -> List<Inequality> = {
  let negated = coeffs.entries().fold(
    Some(Map::new()),
    |accumulator: Option<Map<Int, I128>>, e: { key: Int, value: I128 }|
      match accumulator {
        None -> None,
        Some(m) -> match checked_neg(e.value) { Some(c) -> Some(m.insert(e.key, c)), None -> None },
      },
  );
  let first = match negated {
    Some(m) -> match checked_neg(konst) { Some(k) -> add_inequality(rows, m, k), None -> rows },
    None -> rows,
  };
  add_inequality(first, coeffs, konst)
}

fn charge_step(budget: Int) -> Option<Int> = if budget >= 1 { Some(budget - 1) } else { None }

pub fn feasibility(rows: List<Inequality>, budget: Int) -> EliminationResult / {abort.raise} = {
  let tightened = rows.map(tighten);
  if any_contradiction(tightened) { { result: Infeasible, budget: budget } } else {
    let variables = tightened.fold(Map::new(), |seen: Map<Int, Bool>, r: Inequality|
      r.coefficients.keys().fold(seen, |m: Map<Int, Bool>, v: Int| m.insert(v, true)));
    eliminate(tightened, budget, variables.len())
  }
}

fn eliminate(
  rows: List<Inequality>,
  budget: Int,
  rounds: Int,
) -> EliminationResult / {abort.raise} =
  match next_variable(rows) {
    None ->
      { result: if any_contradiction(rows) { Infeasible } else { Undecided }, budget: budget },
    Some(v) -> if rounds <= 0 { { result: Undecided, budget: budget } } else {
      match charge_step(budget) {
        None -> { result: Undecided, budget: 0 },
        Some(left) -> {
          let positive = rows.filter(|r: Inequality|
            match r.coefficients.get(v) { Some(c) -> c > 0i128, None -> false });
          let negative = rows.filter(|r: Inequality|
            match r.coefficients.get(v) { Some(c) -> c < 0i128, None -> false });
          let independent_rows = rows.filter(|r: Inequality| !r.coefficients.contains(v));
          if positive.len() * negative.len() + independent_rows.len() > max_rows() {
            { result: Undecided, budget: left }
          } else { combined_all(positive, negative, v, independent_rows, left, rounds - 1) }
        },
      }
    },
  }

fn combined_all(
  positive: List<Inequality>,
  negative: List<Inequality>,
  v: Int,
  independent_rows: List<Inequality>,
  budget: Int,
  rounds: Int,
) -> EliminationResult / {abort.raise} = {
  let pairs = positive.fold(
    [],
    |accumulator: List<{ p: Inequality, n: Inequality }>, p: Inequality|
      negative.fold(accumulator, |a: List<{ p: Inequality, n: Inequality }>, n: Inequality|
        a.push({ p: p, n: n })),
  );
  let walked = pairs.fold(
    { rows: independent_rows, budget: budget, stop: None },
    |st: { rows: List<Inequality>, budget: Int, stop: Option<Feasibility> }, pair: { p: Inequality, n: Inequality }|
      match st.stop {
        Some(_) -> st,
        None -> match charge_step(st.budget) {
          None -> { rows: st.rows, budget: 0, stop: Some(Undecided) },
          Some(left) -> match combine(pair.p, pair.n, v) {
            None -> { rows: st.rows, budget: left, stop: None },
            Some(c) -> {
              let row = tighten(c);
              if is_contradiction(row) { { rows: st.rows, budget: left, stop: Some(Infeasible) } }
              else if row.coefficients.len() == 0 { { rows: st.rows, budget: left, stop: None } }
              else { { rows: st.rows.push(row), budget: left, stop: None } }
            },
          },
        },
      },
  );
  match walked.stop {
    Some(result) -> { result: result, budget: walked.budget },
    None -> eliminate(walked.rows, walked.budget, rounds),
  }
}

fn next_variable(rows: List<Inequality>) -> Option<Int> = {
  let counts = rows.fold(Map::new(), |accumulator: Map<Int, { p: Int, n: Int }>, r: Inequality|
    r.coefficients.entries().fold(
      accumulator,
      |m: Map<Int, { p: Int, n: Int }>, e: { key: Int, value: I128 }| {
        let current_counts = match m.get(e.key) { Some(c) -> c, None -> { p: 0, n: 0 } };
        m.insert(e.key, if e.value > 0i128 { { p: current_counts.p + 1, n: current_counts.n } }
        else { { p: current_counts.p, n: current_counts.n + 1 } })
      },
    ));
  let best = counts.entries().fold(
    None,
    |accumulator: Option<{ v: Int, cost: Int }>, e: { key: Int, value: { p: Int, n: Int } }| {
      let cost = e.value.p * e.value.n;
      match accumulator {
        Some(b) -> if cost < b.cost { Some({ v: e.key, cost: cost }) } else { accumulator },
        None -> Some({ v: e.key, cost: cost }),
      }
    },
  );
  match best { Some(b) -> Some(b.v), None -> None }
}

fn combine(positive: Inequality, negative: Inequality, v: Int) -> Option<Inequality> =
  match positive.coefficients.get(v) {
    None -> None,
    Some(a) -> match negative.coefficients.get(v) {
      None -> None,
      Some(nb) -> match checked_neg(nb) {
        None -> None,
        Some(b) -> {
          let from_p = positive.coefficients.entries().fold(
            Some(Map::new()),
            |accumulator: Option<Map<Int, I128>>, e: { key: Int, value: I128 }|
              match accumulator {
                None -> None,
                Some(m) -> if e.key == v { Some(m) } else {
                  match checked_mul(e.value, b) {
                    Some(c) -> Some(m.insert(e.key, c)),
                    None -> None,
                  }
                },
              },
          );
          let both = negative.coefficients.entries().fold(
            from_p,
            |accumulator: Option<Map<Int, I128>>, e: { key: Int, value: I128 }|
              match accumulator {
                None -> None,
                Some(m) -> if e.key == v { Some(m) } else {
                  match checked_mul(e.value, a) {
                    None -> None,
                    Some(scaled) -> match checked_add(
                        match m.get(e.key) { Some(c) -> c, None -> 0i128 },
                        scaled,
                      ) {
                      Some(c) -> Some(m.insert(e.key, c)),
                      None -> None,
                    },
                  }
                },
              },
          );
          match both {
            None -> None,
            Some(m) -> match checked_mul(positive.constant, b) {
              None -> None,
              Some(kp) -> match checked_mul(negative.constant, a) {
                None -> None,
                Some(kn) -> match checked_add(kp, kn) {
                  Some(k) -> Some({ coefficients: nonzero(m), constant: k }),
                  None -> None,
                },
              },
            },
          }
        },
      },
    },
  }

pub fn nonzero(m: Map<Int, I128>) -> Map<Int, I128> =
  m.entries().fold(Map::new(), |accumulator: Map<Int, I128>, e: { key: Int, value: I128 }|
    if e.value == 0i128 { accumulator } else { accumulator.insert(e.key, e.value) })

fn tighten(row: Inequality) -> Inequality / {abort.raise} = {
  let coeffs = nonzero(row.coefficients);
  let g = coeffs.values().fold(0i128, |accumulator: I128, c: I128| gcd(accumulator, magnitude(c)));
  if g <= 1i128 { { coefficients: coeffs, constant: row.constant } } else {
    {
      coefficients: coeffs.entries().fold(
        Map::new(),
        |accumulator: Map<Int, I128>, e: { key: Int, value: I128 }|
          accumulator.insert(e.key, e.value / g),
      ),
      constant: ceil_div(row.constant, g),
    }
  }
}

fn magnitude(c: I128) -> I128 =
  if c < 0i128 { match checked_neg(c) { Some(m) -> m, None -> c } } else { c }

fn is_contradiction(row: Inequality) -> Bool = row.coefficients.len() == 0 && row.constant > 0i128

fn any_contradiction(rows: List<Inequality>) -> Bool =
  rows.fold(false, |found: Bool, r: Inequality| found || is_contradiction(r))

fn gcd(a: I128, b: I128) -> I128 / {abort.raise} =
  iterate({ a: a, b: b }, 260, |pair: { a: I128, b: I128 }|
    if pair.b == 0i128 { Stop(magnitude(pair.a)) }
    else { Continue({ a: pair.b, b: pair.a % pair.b }) })

pub fn ceil_div(a: I128, b: I128) -> I128 / {abort.raise} =
  if a % b > 0i128 { a / b + 1i128 } else { a / b }

fn row(pairs: List<{ v: Int, c: I128 }>, konst: I128) -> Inequality =
  {
    coefficients: pairs.fold(Map::new(), |m: Map<Int, I128>, p: { v: Int, c: I128 }|
      m.insert(p.v, p.c)),
    constant: konst,
  }

test "x > 0 and x < 1 have no integer between them" {
  let rows = [row([{ v: 0, c: -1i128 }], 1i128), row([{ v: 0, c: 1i128 }], 0i128)];
  assert_eq(feasibility(rows, 100).result, Infeasible)
}

test "`feasibility` returns `Undecided` for constraints x >= 1 and x <= -1 when its work limit is 100" {
  let rows = [row([{ v: 0, c: -1i128 }], 1i128), row([{ v: 0, c: 1i128 }], -1i128)];
  assert_eq(feasibility(rows, 100).result, Undecided)
}

test "tightening rounds the constant up over the integers" {
  let rows = [row([{ v: 0, c: 2i128 }], 1i128), row([{ v: 0, c: -1i128 }], 0i128)];
  assert_eq(feasibility(rows, 100).result, Infeasible);
  assert_eq(ceil_div(-7i128, 2i128), -3i128);
  assert_eq(ceil_div(7i128, 2i128), 4i128)
}

test "an exhausted budget gives an undecided result and a remaining budget of zero" {
  let rows = [
    row([{ v: 0, c: 1i128 }, { v: 1, c: -1i128 }], 0i128),
    row([{ v: 1, c: 1i128 }, { v: 0, c: -1i128 }], 1i128),
  ];
  assert_eq(feasibility(rows, 0), { result: Undecided, budget: 0 })
}

fn decided(rows: List<Inequality>) -> Feasibility / {abort.raise} = feasibility(rows, 10000).result

test "the constraints x <= -1 and x >= 1 on one variable are infeasible, because no integer satisfies both" {
  assert_eq(
    decided([row([{ v: 0, c: 1i128 }], 1i128), row([{ v: 0, c: -1i128 }], 1i128)]),
    Infeasible,
  )
}

test "a satisfiable system is not infeasible" {
  assert_eq(
    decided([row([{ v: 0, c: -1i128 }], 1i128), row([{ v: 0, c: 1i128 }], -10i128)]),
    Undecided,
  )
}

test "an equation no integer satisfies is infeasible" {
  assert_eq(
    decided(add_equality([], row([{ v: 0, c: 2i128 }], 0i128).coefficients, -1i128)),
    Infeasible,
  )
}

test "a cycle of strict inequalities x < y, y < z, z < x is infeasible" {
  assert_eq(
    decided(
      [{ a: 0, b: 1 }, { a: 1, b: 2 }, { a: 2, b: 0 }].map(|p: { a: Int, b: Int }|
        row([{ v: p.a, c: 1i128 }, { v: p.b, c: -1i128 }], 1i128)),
    ),
    Infeasible,
  )
}

test "a chain of strict inequalities x < y, y < z with no cycle is not infeasible" {
  assert_eq(
    decided(
      [{ a: 0, b: 1 }, { a: 1, b: 2 }].map(|p: { a: Int, b: Int }|
        row([{ v: p.a, c: 1i128 }, { v: p.b, c: -1i128 }], 1i128)),
    ),
    Undecided,
  )
}

test "constraints whose combined coefficients exceed the 128-bit integer range give an undecided result instead of a wrong one" {
  let half = 170141183460469231731687303715884105727i128 / 2i128;
  let third = 170141183460469231731687303715884105727i128 / 3i128;
  assert_eq(
    decided([
      row([{ v: 0, c: half }, { v: 1, c: 1i128 }], 0i128),
      row([{ v: 0, c: -half }, { v: 2, c: 1i128 }], 1i128),
      row([{ v: 1, c: third }], third),
    ]),
    Undecided,
  )
}

test "a spent budget is undecided and never infeasible" {
  let chain = range(0, 8).map(|v: Int|
    row([{ v: v, c: 1i128 }, { v: v + 1, c: -1i128 }], 1i128)).push(
    row([{ v: 8, c: 1i128 }, { v: 0, c: -1i128 }], 1i128),
  );
  assert_eq(feasibility(chain, 1).result, Undecided)
}

test "ceil_div rounds toward positive infinity" {
  assert_eq(ceil_div(3i128, 2i128), 2i128);
  assert_eq(ceil_div(4i128, 2i128), 2i128);
  assert_eq(ceil_div(-3i128, 2i128), -1i128);
  assert_eq(ceil_div(-4i128, 2i128), -2i128);
  assert_eq(ceil_div(0i128, 5i128), 0i128)
}
