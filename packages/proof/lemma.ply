//! `lemma` — a law a later proof may use. Its trigger is the first call of a definition its body
//! always makes, outermost first, whose arguments name every binder; a call a proof lowers that fits
//! the trigger puts the law, at what the trigger bound, into that proof as a fact. A proved law's
//! body evaluates its trigger at every point, so the call is a value wherever the trigger fits.

import domain (Sort)
import compiler.emit.code (Code, CodeVar, NDefinition, NConstructor, NBuiltin, CodeApply,
                           CodeLiteral, CodeList, CodeBlock, CodeBinary, CodeUnary, CodeIf,
                           CodeMatch, CodeRecord, CodeFieldRead, CodeUpdate, CodePerform,
                           CodeStatement, CodeLet, CodeLetDestructure, CodeDo, CodeField, read_name)

/// `binders` is how many slots the law binds, `function` and `args` its trigger, and `body` the claim.
/// `destructures_arguments`: the trigger takes an argument apart, so it speaks for the calls it fits in place of their
/// bodies; one of bare binders fits every call of `function`, and only adds what it says.
pub type Lemma = {
  law: String,
  label: String,
  binders: Int,
  /// Each binder's type, and the variables of them an `identity` constraint is on: the law is a
  /// fact only where each of those is resolved to a type whose `==` is identity.
  typed: List<Sort>,
  identity_variables: List<Int>,
  function: String,
  args: List<Code>,
  destructures_arguments: Bool,
  body: Code,
}

pub type Trigger = { function: String, args: List<Code> }

/// The lemma a law with `binders` binders and no guard states, when its body calls a definition
/// (`defined`) with arguments that name them all.
pub fn lemma_of(
  law: String,
  label: String,
  typed: List<Sort>,
  identities: List<Int>,
  body: Option<Code>,
  defined: (String) -> Bool,
) -> Option<Lemma> = {
  let binders = typed.len();
  if binders == 0 { None } else {
    match body {
      None -> None,
      Some(b) -> match trigger(b, binders, defined) {
        Some(t) ->
          Some({
            law: law,
            label: label,
            binders: binders,
            typed: typed,
            identity_variables: identities,
            function: t.function,
            args: t.args,
            destructures_arguments: t.args.fold(false, |any: Bool, x: Code|
              any || (match x.node { CodeVar(_) -> false, _ -> true })),
            body: b,
          }),
        None -> None,
      },
    }
  }
}

/// Only where the body always goes: not a branch, an arm or the right of `&&` or `||`, and never
/// inside a lambda, a `handle` or a `simulate`, whose slots are another frame's.
fn trigger(c: Code, binders: Int, defined: (String) -> Bool) -> Option<Trigger> =
  match c.node {
    CodeApply(a) -> {
      let own = match read_name(a.function) {
        Some(n) -> {
          let name = String::of_bytes_lossy(n);
          if defined(name) && a.args.fold(true, |ok: Bool, x: Code| ok && is_pattern(x, binders))
              && covers(a.args, binders) { Some({ function: name, args: a.args }) }
          else { None }
        },
        None -> None,
      };
      match own { Some(t) -> Some(t), None -> first_trigger(a.args, binders, defined) }
    },
    CodeBinary(b) -> if b.op == b"and" || b.op == b"or" { trigger(b.lhs, binders, defined) }
    else { first_trigger([b.lhs, b.rhs], binders, defined) },
    CodeUnary(u) -> trigger(u.operand, binders, defined),
    CodeIf(i) -> trigger(i.cond, binders, defined),
    CodeMatch(m) -> trigger(m.scrutinee, binders, defined),
    CodeBlock(b) -> {
      let statements = b.statements.fold([], |acc: List<Code>, s: CodeStatement|
        match s {
          CodeLet(l) -> acc.push(l.value),
          CodeLetDestructure(l) -> acc.push(l.value),
          CodeDo(d) -> acc.push(d.code),
        });
      first_trigger(
        match b.tail { Some(t) -> statements.push(t), None -> statements },
        binders,
        defined,
      )
    },
    CodeList(l) -> first_trigger(l.items, binders, defined),
    CodeRecord(r) -> first_trigger(r.fields.map(|f: CodeField| f.value), binders, defined),
    CodeFieldRead(f) -> trigger(f.base, binders, defined),
    CodeUpdate(u) ->
      first_trigger(u.sets.map(|f: CodeField| f.value).push(u.base), binders, defined),
    CodePerform(p) -> first_trigger(p.args, binders, defined),
    _ -> None,
  }

fn first_trigger(cs: List<Code>, binders: Int, defined: (String) -> Bool) -> Option<Trigger> =
  cs.fold(None, |found: Option<Trigger>, c: Code|
    match found { Some(_) -> found, None -> trigger(c, binders, defined) })

/// What a call can be matched against: binders, globals, literals, and calls and lists of them.
fn is_pattern(c: Code, binders: Int) -> Bool =
  match c.node {
    CodeVar(v) -> v.slot < binders,
    NDefinition(_) -> true,
    NConstructor(_) -> true,
    NBuiltin(_) -> true,
    CodeLiteral(_) -> true,
    CodeApply(a) ->
      read_name(a.function) != None
        && a.args.fold(true, |ok: Bool, x: Code| ok && is_pattern(x, binders)),
    CodeList(l) -> l.items.fold(true, |ok: Bool, x: Code| ok && is_pattern(x, binders)),
    _ -> false,
  }

fn covers(args: List<Code>, binders: Int) -> Bool = {
  let named = args.fold([], slots_in);
  range(0, binders).fold(true, |ok: Bool, k: Int|
    ok && named.fold(false, |f: Bool, s: Int| f || s == k))
}

fn slots_in(acc: List<Int>, c: Code) -> List<Int> =
  match c.node {
    CodeVar(v) -> acc.push(v.slot),
    CodeApply(a) -> a.args.fold(acc, slots_in),
    CodeList(l) -> l.items.fold(acc, slots_in),
    _ -> acc,
  }
