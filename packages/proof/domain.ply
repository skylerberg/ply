import std.value (Value, VUnit, VBool, VInt, VFixed, VRecord, VCtor, Field)
import std.list
import std.string
import std.math (pow)

pub type Sort =
  | SortVariable(Int)
  | FunctionSort(List<Sort>, Sort, Bool)
  | RecordSort(List<{ name: String, ty: Sort }>)
  | NamedSort(String, List<Sort>)

pub type Variant = { name: String, fields: List<Sort> }

pub type Declaration = { name: String, params: Int, variants: List<Variant> }

pub type Shape =
  | Scalar(String, Int)
  | Ints(Int, Int)
  | Cases(Int, List<{ name: String, size: Int, fields: List<Shape> }>)
  | Fields(Int, List<{ name: String, shape: Shape }>)

pub fn shape_size(s: Shape) -> Int =
  match s { Scalar(_, n) -> n, Ints(_, n) -> n, Cases(n, _) -> n, Fields(n, _) -> n }

pub fn point_at(d: Domain, index: Int) -> Option<List<Value>> / {abort.raise} =
  match point_indices(d, index) { Some(ixs) -> values_of(d.shapes, ixs), None -> None }

fn values_at(shapes: List<Shape>, index: Int) -> Option<List<Value>> / {abort.raise} = {
  let sizes = shapes.map(shape_size);
  if sizes.fold(false, |empty: Bool, n: Int| empty || n == 0) { None }
  else { values_of(shapes, tuple_at(sizes, sizes.len() - 1, index)) }
}

fn values_of(shapes: List<Shape>, ixs: List<Int>) -> Option<List<Value>> / {abort.raise} =
  range(0, shapes.len()).fold(Some([]), |accumulator: Option<List<Value>>, k: Int|
    match accumulator {
      None -> None,
      Some(vs) -> match ((shapes.at(k), ixs.at(k))) {
        (Some(shape), Some(ix)) -> match value_at(shape, ix) {
          Some(v) -> Some(vs.push(v)),
          None -> None,
        },
        _ -> None,
      },
    })

fn value_at(s: Shape, index: Int) -> Option<Value> / {abort.raise} =
  match s {
    Scalar(name, _) -> if name == "Unit" { Some(VUnit) }
    else if name == "Bool" { Some(VBool(index == 1)) }
    else { fixed_at(name, index) },
    Ints(low, _) -> Some(VInt(low + index)),
    Cases(_, cases) ->
      cases.fold(
        { rest: index, found: None, done: false },
        |accumulator: { rest: Int, found: Option<Value>, done: Bool }, c: { name: String, size: Int, fields: List<Shape> }|
          if accumulator.done { accumulator } else if accumulator.rest < c.size {
            {
              rest: accumulator.rest,
              found: match values_at(c.fields, accumulator.rest) {
                Some(args) -> Some(VCtor(c.name, args)),
                None -> None,
              },
              done: true,
            }
          } else { { rest: accumulator.rest - c.size, found: None, done: false } },
      ).found,
    Fields(_, fields) -> match values_at(
        fields.map(|f: { name: String, shape: Shape }| f.shape),
        index,
      ) {
      None -> None,
      Some(values) ->
        Some(
          VRecord(
            by_name(
              range(0, fields.len()).map(|i: Int|
                {
                  name: match fields.at(i) { Some(f) -> f.name, None -> "" },
                  value: match values.at(i) { Some(v) -> v, None -> VUnit },
                }),
            ),
          ),
        ),
    },
  }

pub fn name_order(names: List<String>) -> List<Int> =
  range(0, names.len()).fold([], |accumulator: List<Int>, i: Int| {
    let name = match names.at(i) { Some(n) -> n, None -> "" };
    let before = |j: Int| match names.at(j) { Some(m) -> compare(name, m) == Less, None -> false };
    let at = range(0, accumulator.len()).fold(accumulator.len(), |found: Int, k: Int|
      if found < accumulator.len() { found } else {
        match accumulator.at(k) { Some(j) -> if before(j) { k } else { found }, None -> found }
      });
    if at == accumulator.len() { accumulator.push(i) } else {
      range(0, accumulator.len()).fold([], |out: List<Int>, k: Int|
        match accumulator.at(k) {
          Some(j) -> if k == at { out.push(i).push(j) } else { out.push(j) },
          None -> out,
        })
    }
  })

fn by_name(fields: List<Field>) -> List<Field> =
  name_order(fields.map(|f: Field| f.name)).fold([], |accumulator: List<Field>, i: Int|
    match fields.at(i) { Some(f) -> accumulator.push(f), None -> accumulator })

fn fixed_at(name: String, index: Int) -> Option<Value> / {abort.raise} = {
  let w = if name == "U8" || name == "I8" { 8 }
  else if name == "U16" || name == "I16" { 16 }
  else if name == "U32" || name == "I32" { 32 }
  else if name == "U64" || name == "I64" { 64 }
  else { 128 };
  let mask = if w == 128 { ~0u128 } else { (1u128 << w) - 1u128 };
  if name.starts_with("I") { Some(VFixed(name, U128::of_int(index) +% (1u128 << w - 1) & mask)) }
  else if name.starts_with("U") { Some(VFixed(name, U128::of_int(index) & mask)) }
  else { None }
}

pub type Domain = { shapes: List<Shape>, points: Int }

pub fn sizes_of(domain: Domain) -> List<Int> = domain.shapes.map(shape_size)

pub const max_enumerated_points: Int = 4096

pub fn shape_of(ty: Sort, declarations: List<Declaration>) -> Option<Shape> =
  expand_shape(ty, declarations, [], [], 2 * declarations.len() + 2)

pub fn size(ty: Sort, declarations: List<Declaration>) -> Option<Int> =
  match shape_of(ty, declarations) { Some(s) -> Some(shape_size(s)), None -> None }

pub type Interval = { low: Int, high: Int }

pub fn finite(binders: List<Sort>, declarations: List<Declaration>) -> Option<Domain> =
  finite_within(binders.map(|ty: Sort| { ty: ty, within: None }), declarations)

pub fn finite_within(
  binders: List<{ ty: Sort, within: Option<Interval> }>,
  declarations: List<Declaration>,
) -> Option<Domain> =
  binders.fold(
    Some({ shapes: [], points: 1 }),
    |accumulator: Option<Domain>, b: { ty: Sort, within: Option<Interval> }|
      match accumulator {
        None -> None,
        Some(seen) -> match shape_within(b.ty, b.within, declarations) {
          None -> None,
          Some(shape) -> {
            let n = shape_size(shape);
            let points = seen.points * n;
            if n == 0 || points > max_enumerated_points { None }
            else { Some({ shapes: seen.shapes.push(shape), points: points }) }
          },
        },
      },
  )

fn shape_within(
  ty: Sort,
  within: Option<Interval>,
  declarations: List<Declaration>,
) -> Option<Shape> =
  match within {
    None -> shape_of(ty, declarations),
    Some(ends) -> match ty {
      NamedSort(name, _) -> if name != "Int" { shape_of(ty, declarations) }
      else if ends.high < ends.low || ends.high - ends.low >= max_enumerated_points { None }
      else { Some(Ints(ends.low, ends.high - ends.low + 1)) },
      _ -> shape_of(ty, declarations),
    },
  }

pub fn domain_name(texts: List<String>) -> String =
  if texts.len() == 0 { "unit" } else { String::join(texts, " × ") }

pub fn point_indices(domain: Domain, index: Int) -> Option<List<Int>> / {abort.raise} = {
  let sizes = sizes_of(domain);
  if index < 0 || index >= domain.points { None }
  else { Some(tuple_at(sizes, sizes.len() - 1, index)) }
}

fn tuple_at(sizes: List<Int>, at: Int, rest: Int) -> List<Int> / {abort.raise} =
  if at < 0 { [] } else {
    match sizes.at(at) {
      None -> [],
      Some(step) -> tuple_at(sizes, at - 1, rest / step).push(rest % step),
    }
  }

fn expand_shape(
  ty: Sort,
  declarations: List<Declaration>,
  expanding: List<String>,
  substitution: List<Sort>,
  depth_left: Int,
) -> Option<Shape> =
  if depth_left <= 0 { None } else {
    match ty {
      SortVariable(index) -> match substitution.at(index) {
        Some(argument) -> expand_shape(argument, declarations, expanding, [], depth_left - 1),
        None -> None,
      },
      FunctionSort(_, _, _) -> None,
      RecordSort(fields) -> match fields_of(
          fields,
          declarations,
          expanding,
          substitution,
          depth_left,
        ) {
        None -> None,
        Some(fs) -> Some(Fields(fs.size, fs.fields)),
      },
      NamedSort(name, args) -> {
        if name == "Unit" { Some(Scalar(name, 1)) }
        else if name == "Bool" { Some(Scalar(name, 2)) }
        else if is_unbounded(name) { None }
        else if width_of(name) != 0 { Some(Scalar(name, pow(2, width_of(name)))) }
        else if expanding.contains(name) { None } else {
          match find_declaration(declarations, name) {
            None -> None,
            Some(declaration) ->
              cases_of(
                declaration,
                declarations,
                expanding.push(name),
                args.map(|a: Sort| substituted(a, substitution)),
                depth_left - 1,
              ),
          }
        }
      },
    }
  }

fn is_unbounded(name: String) -> Bool =
  name == "Int" || name == "String" || name == "Bytes" || name == "List" || name == "Array"
    || name == "Float"
    || name == "Decimal"
    || name == "Map"
    || name == "I64"
    || name == "U64"
    || name == "I128"
    || name == "U128"

fn width_of(name: String) -> Int =
  if name == "U8" || name == "I8" { 8 }
  else if name == "U16" || name == "I16" { 16 }
  else if name == "U32" || name == "I32" { 32 }
  else { 0 }

fn cases_of(
  declaration: Declaration,
  declarations: List<Declaration>,
  expanding: List<String>,
  args: List<Sort>,
  depth_left: Int,
) -> Option<Shape> =
  match declaration.variants.fold(
      Some({ total: 0, cases: [] }),
      |accumulator: Option<{ total: Int, cases: List<{ name: String, size: Int, fields: List<Shape> }> }>, variant: Variant|
        match accumulator {
          None -> None,
          Some(seen) -> match product_of(
              variant.fields,
              declarations,
              expanding,
              args,
              depth_left,
            ) {
            None -> None,
            Some(p) -> {
              let total = seen.total + p.size;
              if total > max_enumerated_points { None } else {
                Some({
                  total: total,
                  cases: seen.cases.push({ name: variant.name, size: p.size, fields: p.shapes }),
                })
              }
            },
          },
        },
    ) {
    None -> None,
    Some(all) -> Some(Cases(all.total, all.cases)),
  }

fn product_of(
  types: List<Sort>,
  declarations: List<Declaration>,
  expanding: List<String>,
  substitution: List<Sort>,
  depth_left: Int,
) -> Option<{ size: Int, shapes: List<Shape> }> =
  types.fold(
    Some({ size: 1, shapes: [] }),
    |accumulator: Option<{ size: Int, shapes: List<Shape> }>, ty: Sort|
      match accumulator {
        None -> None,
        Some(seen) -> match expand_shape(ty, declarations, expanding, substitution, depth_left) {
          None -> None,
          Some(shape) -> {
            let next = seen.size * shape_size(shape);
            if next > max_enumerated_points { None }
            else { Some({ size: next, shapes: seen.shapes.push(shape) }) }
          },
        },
      },
  )

fn fields_of(
  fields: List<{ name: String, ty: Sort }>,
  declarations: List<Declaration>,
  expanding: List<String>,
  substitution: List<Sort>,
  depth_left: Int,
) -> Option<{ size: Int, fields: List<{ name: String, shape: Shape }> }> =
  match product_of(
      fields.map(|f: { name: String, ty: Sort }| f.ty),
      declarations,
      expanding,
      substitution,
      depth_left,
    ) {
    None -> None,
    Some(p) ->
      Some({
        size: p.size,
        fields: range(0, fields.len()).map(|i: Int|
          {
            name: match fields.at(i) { Some(f) -> f.name, None -> "" },
            shape: match p.shapes.at(i) { Some(sh) -> sh, None -> Scalar("Unit", 1) },
          }),
      }),
  }

pub fn substituted(ty: Sort, substitution: List<Sort>) -> Sort =
  match ty {
    SortVariable(index) -> match substitution.at(index) { Some(argument) -> argument, None -> ty },
    FunctionSort(params, return_sort, pure) ->
      FunctionSort(
        params.map(|p: Sort| substituted(p, substitution)),
        substituted(return_sort, substitution),
        pure,
      ),
    RecordSort(fields) ->
      RecordSort(
        fields.map(|f: { name: String, ty: Sort }|
          { name: f.name, ty: substituted(f.ty, substitution) }),
      ),
    NamedSort(name, args) -> NamedSort(name, args.map(|a: Sort| substituted(a, substitution))),
  }

pub fn find_declaration(declarations: List<Declaration>, name: String) -> Option<Declaration> =
  declarations.fold(None, |found: Option<Declaration>, declaration: Declaration|
    match found {
      Some(_) -> found,
      None -> if declaration.name == name { Some(declaration) } else { None },
    })

const kinds: List<Declaration> =
  [
    {
      name: "Kind",
      params: 0,
      variants: [
        { name: "Asset", fields: [] },
        { name: "Liability", fields: [] },
        { name: "Equity", fields: [] },
      ],
    },
  ]

const nat: List<Declaration> =
  [
    {
      name: "Nat",
      params: 0,
      variants: [{ name: "Zero", fields: [] }, { name: "Succ", fields: [NamedSort("Nat", [])] }],
    },
  ]

pub fn named_sort(name: String) -> Sort = NamedSort(name, [])

test "a nullary enum and Bool are finite and everything unbounded is not" {
  let declarations = kinds;
  assert_eq(size(named_sort("Bool"), declarations), Some(2));
  assert_eq(size(named_sort("Unit"), declarations), Some(1));
  assert_eq(size(named_sort("Kind"), declarations), Some(3));
  assert_eq(size(named_sort("Int"), declarations), None);
  assert_eq(size(named_sort("String"), declarations), None);
  assert_eq(size(named_sort("Bytes"), declarations), None);
  assert_eq(size(named_sort("Float"), declarations), None);
  assert_eq(size(named_sort("List"), declarations), None);
  assert_eq(size(named_sort("U64"), declarations), None);
  assert_eq(size(named_sort("U8"), declarations), Some(256));
  assert_eq(size(named_sort("I32"), declarations), Some(4294967296))
}

test "a type variable and a function are never finite" {
  assert_eq(size(SortVariable(0), kinds), None);
  assert_eq(size(FunctionSort([named_sort("Bool")], named_sort("Bool"), true), kinds), None)
}

test "a recursive type is infinite even with a nullary base case" {
  assert_eq(size(named_sort("Nat"), nat), None)
}

test "a record's size is the product of its fields'" {
  let declarations = kinds;
  assert_eq(
    size(
      RecordSort([{ name: "k", ty: named_sort("Kind") }, { name: "b", ty: named_sort("Bool") }]),
      declarations,
    ),
    Some(6),
  );
  assert_eq(
    size(
      RecordSort([{ name: "k", ty: named_sort("Kind") }, { name: "n", ty: named_sort("Int") }]),
      declarations,
    ),
    None,
  )
}

test "a case with fields multiplies them into its type's size" {
  let declared = kinds.concat([
    {
      name: "Wrap",
      params: 0,
      variants: [
        { name: "Nothing", fields: [] },
        { name: "Held", fields: [NamedSort("Kind", []), NamedSort("Bool", [])] },
      ],
    },
  ]);
  assert_eq(size(named_sort("Wrap"), declared), Some(7))
}

const kind_cases: Shape =
  Cases(3, [
    { name: "Asset", size: 1, fields: [] },
    { name: "Liability", size: 1, fields: [] },
    { name: "Equity", size: 1, fields: [] },
  ])

test "`shape_of` records the number of values for each case and field, so reading the nth value needs no counting" {
  let declared = kinds.concat([
    {
      name: "Wrap",
      params: 0,
      variants: [
        { name: "Nothing", fields: [] },
        { name: "Held", fields: [NamedSort("Kind", []), NamedSort("Bool", [])] },
      ],
    },
  ]);
  assert_eq(
    shape_of(named_sort("Wrap"), declared),
    Some(
      Cases(7, [
        { name: "Nothing", size: 1, fields: [] },
        { name: "Held", size: 6, fields: [kind_cases, Scalar("Bool", 2)] },
      ]),
    ),
  );
  assert_eq(
    shape_of(
      RecordSort([{ name: "k", ty: named_sort("Kind") }, { name: "b", ty: named_sort("Bool") }]),
      declared,
    ),
    Some(Fields(6, [{ name: "k", shape: kind_cases }, { name: "b", shape: Scalar("Bool", 2) }])),
  );
  assert_eq(shape_of(named_sort("U8"), declared), Some(Scalar("U8", 256)));
  assert_eq(shape_of(named_sort("Unit"), declared), Some(Scalar("Unit", 1)));
  let pair = kinds.concat([
    {
      name: "Pair",
      params: 1,
      variants: [{ name: "Both", fields: [SortVariable(0), SortVariable(0)] }],
    },
  ]);
  assert_eq(
    shape_of(NamedSort("Pair", [named_sort("Bool")]), pair),
    Some(Cases(4, [{ name: "Both", size: 4, fields: [Scalar("Bool", 2), Scalar("Bool", 2)] }])),
  );
  assert_eq(shape_of(named_sort("Int"), declared), None)
}

test "a domain is the binders' shapes and the product of their sizes" {
  match finite([named_sort("Bool"), named_sort("Kind")], kinds) {
    None -> assert_eq(false, true),
    Some(domain) -> {
      assert_eq(domain.shapes, [Scalar("Bool", 2), kind_cases]);
      assert_eq(sizes_of(domain), [2, 3]);
      assert_eq(domain.points, 6)
    },
  }
}

test "an `Int` is finite between the bounds its guards give, and its points are enumerated from the lowest bound" {
  let finite_between = |low: Int, high: Int|
    finite_within([{ ty: named_sort("Int"), within: Some({ low: low, high: high }) }], []);
  assert_eq(finite_between(1, 100), Some({ shapes: [Ints(1, 100)], points: 100 }));
  assert_eq(finite_between(-2, -2), Some({ shapes: [Ints(-2, 1)], points: 1 }));
  assert_eq(finite_between(6, 2), None);
  assert_eq(finite_between(0, max_enumerated_points), None);
  assert_eq(
    finite_between(0, max_enumerated_points - 1),
    Some({ shapes: [Ints(0, max_enumerated_points)], points: max_enumerated_points }),
  );
  assert_eq(
    finite_within([{ ty: named_sort("Bool"), within: Some({ low: 0, high: 9 }) }], []),
    finite([named_sort("Bool")], []),
  );
  assert_eq(finite_within([{ ty: named_sort("Int"), within: None }], []), None);
  match finite_within(
      [
        { ty: named_sort("Bool"), within: None },
        { ty: named_sort("Int"), within: Some({ low: 3, high: 4 }) },
      ],
      [],
    ) {
    Some(domain) ->
      assert_eq(range(0, 4).map(|i: Int| point_at(domain, i)), [
        Some([VBool(false), VInt(3)]),
        Some([VBool(false), VInt(4)]),
        Some([VBool(true), VInt(3)]),
        Some([VBool(true), VInt(4)]),
      ]),
    None -> assert(false),
  }
}

test "a domain with more points than the maximum is rejected instead of enumerated" {
  let declarations = kinds;
  assert_eq(finite(range(0, 16).map(|_i: Int| named_sort("Kind")), declarations), None);
  match finite(range(0, 4).map(|_i: Int| named_sort("Kind")), declarations) {
    None -> assert_eq(false, true),
    Some(domain) -> assert_eq(domain.points, 81),
  }
}

test "a domain with a binder whose type has no values is not finite" {
  let declared = [{ name: "Empty", params: 0, variants: [] }];
  assert_eq(finite([named_sort("Empty")], declared), None)
}

test "a domain is named by joining its binders' types, and a domain with no binders is named `unit`" {
  assert_eq(domain_name([]), "unit");
  assert_eq(domain_name(["Bool"]), "Bool");
  assert_eq(domain_name(["Bool", "Kind"]), "Bool × Kind")
}

test "a ground claim has exactly one point" {
  match finite([], kinds) {
    None -> assert_eq(false, true),
    Some(domain) -> {
      assert_eq(domain.points, 1);
      assert_eq(point_indices(domain, 0), Some([]));
    },
  }
}

test "enumeration covers the domain once each in a fixed order" {
  let declarations = kinds;
  match finite([named_sort("Bool"), named_sort("Kind")], declarations) {
    None -> assert_eq(false, true),
    Some(domain) -> {
      assert_eq(domain.points, 6);
      assert_eq(point_indices(domain, 0), Some([0, 0]));
      assert_eq(point_indices(domain, 3), Some([1, 0]));
      assert_eq(point_indices(domain, 5), Some([1, 2]));
      assert_eq(point_indices(domain, 6), None);
      let seen = range(0, domain.points).map(|i: Int| point_indices(domain, i));
      let tuples = seen.fold([], |accumulator: List<List<Int>>, t: Option<List<Int>>|
        match t { Some(xs) -> accumulator.push(xs), None -> accumulator });
      assert_eq(tuples.len(), domain.points)
    },
  }
}

test "a parameter is the argument the type was applied to" {
  let declared = kinds.concat([
    {
      name: "Pair",
      params: 1,
      variants: [{ name: "Both", fields: [SortVariable(0), SortVariable(0)] }],
    },
  ]);
  assert_eq(size(NamedSort("Pair", [named_sort("Bool")]), declared), Some(4));
  assert_eq(size(NamedSort("Pair", [named_sort("Kind")]), declared), Some(9));
  assert_eq(size(NamedSort("Pair", [named_sort("Int")]), declared), None);
  assert_eq(size(NamedSort("Pair", [NamedSort("Pair", [named_sort("Bool")])]), declared), None);
  assert_eq(size(NamedSort("Pair", []), declared), None)
}

test "a recursive type stays infinite under an argument, not only on its own" {
  let declared = [
    {
      name: "Nest",
      params: 1,
      variants: [
        { name: "Leaf", fields: [SortVariable(0)] },
        { name: "More", fields: [NamedSort("Nest", [SortVariable(0)])] },
      ],
    },
  ];
  assert_eq(size(NamedSort("Nest", [named_sort("Bool")]), declared), None)
}

test "a claim's type variable has no finite size, even when a declared type's parameter has the same index" {
  let declared = kinds.concat([
    {
      name: "Pair",
      params: 1,
      variants: [{ name: "Both", fields: [SortVariable(0), SortVariable(0)] }],
    },
  ]);
  assert_eq(size(NamedSort("Pair", [SortVariable(0)]), declared), None);
  assert_eq(finite([NamedSort("Pair", [SortVariable(0)]), named_sort("Bool")], declared), None)
}

test "a type parameter passed to another declaration takes the argument the outer declaration was applied to" {
  let declared = kinds.concat([
    { name: "Box", params: 1, variants: [{ name: "Boxed", fields: [SortVariable(0)] }] },
    {
      name: "Two",
      params: 1,
      variants: [{ name: "Two", fields: [NamedSort("Box", [SortVariable(0)]), SortVariable(0)] }],
    },
  ]);
  assert_eq(size(NamedSort("Two", [named_sort("Kind")]), declared), Some(9));
  assert_eq(size(NamedSort("Two", [SortVariable(0)]), declared), None)
}

test "a point is every binder's value, the last varying fastest" {
  match finite([NamedSort("Bool", []), NamedSort("Unit", []), NamedSort("Bool", [])], []) {
    None -> panic("a finite domain"),
    Some(d) -> {
      assert_eq(point_at(d, 0), Some([VBool(false), VUnit, VBool(false)]));
      assert_eq(point_at(d, 1), Some([VBool(false), VUnit, VBool(true)]));
      assert_eq(point_at(d, 2), Some([VBool(true), VUnit, VBool(false)]));
      assert_eq(point_at(d, 4), None)
    },
  }
}

test "`point_at` numbers values case by case, lists signed integers from their lowest value, and gives one empty point for no variables" {
  let declarations = [
    {
      name: "m.Kind",
      params: 0,
      variants: [{ name: "m.Off", fields: [] }, { name: "m.On", fields: [NamedSort("Bool", [])] }],
    },
  ];
  match finite([NamedSort("m.Kind", [])], declarations) {
    None -> panic("a finite domain"),
    Some(d) ->
      assert_eq(range(0, d.points).map(|i: Int| point_at(d, i)), [
        Some([VCtor("m.Off", [])]),
        Some([VCtor("m.On", [VBool(false)])]),
        Some([VCtor("m.On", [VBool(true)])]),
      ]),
  };
  match finite([NamedSort("I8", [])], []) {
    None -> panic("a finite domain"),
    Some(d) -> {
      assert_eq(point_at(d, 0), Some([VFixed("I8", 128u128)]));
      assert_eq(point_at(d, 128), Some([VFixed("I8", 0u128)]))
    },
  };
  match finite([], []) {
    None -> panic("a ground domain"),
    Some(d) -> assert_eq(point_at(d, 0), Some([])),
  }
}
