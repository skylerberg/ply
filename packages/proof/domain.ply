//! `domain` — how many points a law's binders have, and whether that is a domain at all.
//!
//! A finite domain is the one thing a law can be *proved* over rather than sampled: if every binder
//! is inhabited by finitely many values and the product is small enough to walk, then visiting every
//! point is a proof and missing one is not. Everything here is therefore a rule about coverage, not
//! a search: how many values a type holds, whether a product is still walkable, and what order the
//! points are visited in so that two runs agree.
//!
//! Which points exist, how many there are, and whether asking for all of them is a proof or an
//! enumeration nobody can afford, are decided here, and so is each point's value.

import std.value (Value, VUnit, VBool, VInt, VFixed, VRecord, VCtor, Field)
import std.list
import std.string
import std.math (pow)

/// A type as the prover reads one: a variable, numbered by first appearance in the item it belongs
/// to; a function, with its parameters, its answer and whether its row is empty; a record; or a
/// named type with its arguments. The builtins arrive as names — `Unit`, `Bool`, `U8` — so this
/// module never needs to know which of them the compiler keeps in a table and which it spells out.
pub type Sort =
  | SortVariable(Int)
  | FunctionSort(List<Sort>, Sort, Bool)
  | RecordSort(List<{ name: String, ty: Sort }>)
  | NamedSort(String, List<Sort>)

/// One case of a declared type: its name and its fields, in declaration order.
pub type Variant = { name: String, fields: List<Sort> }

/// A declared type: how many parameters it takes and the variants its constructors belong to. Its
/// fields are written in terms of those parameters, `SortVariable(i)` being the `i`th, so `NamedSort(name, args)`
/// means the fields with `args` substituted for them by position — a `Pair<Bool>` is four values, and
/// the same declaration under `Pair<Int>` is not finite at all.
pub type Decl = { name: String, params: Int, variants: List<Variant> }

/// What a finite type came to, as the runtime builds its values from an index: a builtin by name,
/// the `Int`s from a least one on, a declared type's cases in declaration order, or a record's
/// fields in the order the type lists them. Every node carries how many values it holds, so
/// decoding a point counts nothing: the sizes are decided here, once.
pub type Shape =
  | Scalar(String, Int)
  | Ints(Int, Int)
  | Cases(Int, List<{ name: String, size: Int, fields: List<Shape> }>)
  | Fields(Int, List<{ name: String, shape: Shape }>)

pub fn shape_size(s: Shape) -> Int =
  match s { Scalar(_, n) -> n, Ints(_, n) -> n, Cases(n, _) -> n, Fields(n, _) -> n }

/// The `index`-th point, the first binder varying slowest; `None` past the last, where decoding
/// would wrap round to a point already named.
pub fn point_at(d: Domain, index: Int) -> Option<List<Value>> / {abort.raise} =
  match point_indices(d, index) { Some(ixs) -> values_of(d.shapes, ixs), None -> None }

/// The values of a tuple of shapes at one index, the last varying fastest.
fn values_at(shapes: List<Shape>, index: Int) -> Option<List<Value>> / {abort.raise} = {
  let sizes = shapes.map(shape_size);
  if sizes.fold(false, |empty: Bool, n: Int| empty || n == 0) { None }
  else { values_of(shapes, tuple_at(sizes, sizes.len() - 1, index)) }
}

fn values_of(shapes: List<Shape>, ixs: List<Int>) -> Option<List<Value>> / {abort.raise} =
  range(0, shapes.len()).fold(Some([]), |acc: Option<List<Value>>, k: Int|
    match acc {
      None -> None,
      Some(vs) -> match ((shapes.at(k), ixs.at(k))) {
        (Some(shape), Some(ix)) -> match value_at(shape, ix) {
          Some(v) -> Some(vs.push(v)),
          None -> None,
        },
        _ -> None,
      },
    })

/// The `index`-th value of a shape: constructors in declaration order, then fields left to right with
/// the last varying fastest; a record keeps its fields by name.
fn value_at(s: Shape, index: Int) -> Option<Value> / {abort.raise} =
  match s {
    Scalar(name, _) -> if name == "Unit" { Some(VUnit) }
    else if name == "Bool" { Some(VBool(index == 1)) }
    else { fixed_at(name, index) },
    Ints(low, _) -> Some(VInt(low + index)),
    Cases(_, cases) ->
      cases.fold(
        { rest: index, found: None, done: false },
        |acc: { rest: Int, found: Option<Value>, done: Bool }, c: { name: String, size: Int, fields: List<Shape> }|
          if acc.done { acc } else if acc.rest < c.size {
            {
              rest: acc.rest,
              found: match values_at(c.fields, acc.rest) {
                Some(args) -> Some(VCtor(c.name, args)),
                None -> None,
              },
              done: true,
            }
          } else { { rest: acc.rest - c.size, found: None, done: false } },
      ).found,
    Fields(_, fields) -> match values_at(
        fields.map(|f: { name: String, shape: Shape }| f.shape),
        index,
      ) {
      None -> None,
      Some(values) ->
        Some(
          VRecord(
            by_name(
              range(0, fields.len()).map(|i: Int|
                {
                  name: match fields.at(i) { Some(f) -> f.name, None -> "" },
                  value: match values.at(i) { Some(v) -> v, None -> VUnit },
                }),
            ),
          ),
        ),
    },
  }

/// The places of `names` in ascending order, equal names in the order they came.
pub fn name_order(names: List<String>) -> List<Int> =
  range(0, names.len()).fold([], |acc: List<Int>, i: Int| {
    let name = match names.at(i) { Some(n) -> n, None -> "" };
    let before = |j: Int| match names.at(j) { Some(m) -> compare(name, m) == Less, None -> false };
    let at = range(0, acc.len()).fold(acc.len(), |found: Int, k: Int|
      if found < acc.len() { found }
      else { match acc.at(k) { Some(j) -> if before(j) { k } else { found }, None -> found } });
    if at == acc.len() { acc.push(i) } else {
      range(0, acc.len()).fold([], |out: List<Int>, k: Int|
        match acc.at(k) {
          Some(j) -> if k == at { out.push(i).push(j) } else { out.push(j) },
          None -> out,
        })
    }
  })

fn by_name(fields: List<Field>) -> List<Field> =
  name_order(fields.map(|f: Field| f.name)).fold([], |acc: List<Field>, i: Int|
    match fields.at(i) { Some(f) -> acc.push(f), None -> acc })

/// A width's least value plus `index`, as the pattern it is.
fn fixed_at(name: String, index: Int) -> Option<Value> / {abort.raise} = {
  let w = if name == "U8" || name == "I8" { 8 }
  else if name == "U16" || name == "I16" { 16 }
  else if name == "U32" || name == "I32" { 32 }
  else if name == "U64" || name == "I64" { 64 }
  else { 128 };
  let mask = if w == 128 { ~0u128 } else { (1u128 << w) - 1u128 };
  if name.starts_with("I") { Some(VFixed(name, U128::of_int(index) +% (1u128 << w - 1) & mask)) }
  else if name.starts_with("U") { Some(VFixed(name, U128::of_int(index) & mask)) }
  else { None }
}

/// What a finite domain came to: each binder's shape, and the product of their sizes. A point is
/// named by index, and only the sizes say what an index means.
pub type Domain = { shapes: List<Shape>, points: Int }

pub fn sizes_of(domain: Domain) -> List<Int> = domain.shapes.map(shape_size)

/// The largest number of points a proof may walk. Past it the domain is not a proof anyone can pay
/// for, and sampling is the honest answer rather than a long silence.
pub fn max_enumerated_points() -> Int = 4096

/// What a type came to, or `None` when it is infinite, unknown, or past [`max_enumerated_points`].
pub fn shape_of(ty: Sort, decls: List<Decl>) -> Option<Shape> =
  expand_shape(ty, decls, [], [], 2 * decls.len() + 2)

/// How many values inhabit a type, or `None` when it is infinite, unknown, or past [`max_enumerated_points`].
pub fn size(ty: Sort, decls: List<Decl>) -> Option<Int> =
  match shape_of(ty, decls) { Some(s) -> Some(shape_size(s)), None -> None }

/// The `Int`s a claim's guards admit a binder at, both ends included.
pub type Interval = { low: Int, high: Int }

/// The binders' domain, when every one of them is finite and the product is within [`max_enumerated_points`].
pub fn finite(binders: List<Sort>, decls: List<Decl>) -> Option<Domain> =
  finite_within(binders.map(|ty: Sort| { ty: ty, within: None }), decls)

/// [`finite`], an `Int` binder being finite between the ends its claim's guards hold it to.
pub fn finite_within(
  binders: List<{ ty: Sort, within: Option<Interval> }>,
  decls: List<Decl>,
) -> Option<Domain> =
  binders.fold(
    Some({ shapes: [], points: 1 }),
    |acc: Option<Domain>, b: { ty: Sort, within: Option<Interval> }|
      match acc {
        None -> None,
        Some(seen) -> match shape_within(b.ty, b.within, decls) {
          None -> None,
          Some(shape) -> {
            let n = shape_size(shape);
            let points = seen.points * n;
            // A domain of no points is a vacuity, not a proof.
            if n == 0 || points > max_enumerated_points() { None }
            else { Some({ shapes: seen.shapes.push(shape), points: points }) }
          },
        },
      },
  )

fn shape_within(ty: Sort, within: Option<Interval>, decls: List<Decl>) -> Option<Shape> =
  match within {
    None -> shape_of(ty, decls),
    Some(ends) -> match ty {
      NamedSort(name, _) -> if name != "Int" { shape_of(ty, decls) }
      // Past the bound before it is measured, so the count never overflows.
      else if ends.high < ends.low || ends.high - ends.low >= max_enumerated_points() { None }
      else { Some(Ints(ends.low, ends.high - ends.low + 1)) },
      _ -> shape_of(ty, decls),
    },
  }

/// What a domain is called in an artifact: the name of a product with no binders is `unit`, since a
/// ground claim still has exactly one point. The texts are the compiler's own printing of each
/// binder's type, so a domain is named as its claim's binders read.
pub fn domain_name(texts: List<String>) -> String =
  if texts.len() == 0 { "unit" } else { String::join(texts, " × ") }

/// The point an index names, one value index per binder: the last binder varies fastest, so the
/// sequence of points is a function of the domain and nothing else.
pub fn point_indices(domain: Domain, index: Int) -> Option<List<Int>> / {abort.raise} = {
  let sizes = sizes_of(domain);
  if index < 0 || index >= domain.points { None }
  else { Some(tuple_at(sizes, sizes.len() - 1, index)) }
}

/// `sizes` right to left, each dividing what is left: the tuple an index names, left to right.
fn tuple_at(sizes: List<Int>, at: Int, rest: Int) -> List<Int> / {abort.raise} =
  if at < 0 { [] } else {
    match sizes.at(at) {
      None -> [],
      Some(step) -> tuple_at(sizes, at - 1, rest / step).push(rest % step),
    }
  }

/// What a type came to, with the names whose variants are already being walked: a type that mentions
/// itself has no finite size even when it has a nullary case. `depth_left` is spent opening a declared type,
/// which a path does once for each, and reading an argument, which a path does once between two.
fn expand_shape(
  ty: Sort,
  decls: List<Decl>,
  expanding: List<String>,
  subst: List<Sort>,
  depth_left: Int,
) -> Option<Shape> =
  if depth_left <= 0 { None } else {
    match ty {
      // Arguments arrive already substituted into the scope that wrote them, so one read settles a
      // parameter; reading it against `subst` again would let `SortVariable(0)` name itself forever.
      SortVariable(index) -> match subst.at(index) {
        Some(argument) -> expand_shape(argument, decls, expanding, [], depth_left - 1),
        None -> None,
      },
      FunctionSort(_, _, _) -> None,
      RecordSort(fields) -> match fields_of(fields, decls, expanding, subst, depth_left) {
        None -> None,
        Some(fs) -> Some(Fields(fs.size, fs.fields)),
      },
      NamedSort(name, args) -> {
        if name == "Unit" { Some(Scalar(name, 1)) }
        else if name == "Bool" { Some(Scalar(name, 2)) }
        // `Float` and `Decimal` are finite but far too large to enumerate, and a 64-bit width does not
        // fit the arithmetic here.
        else if is_unbounded(name) { None }
        else if width_of(name) != 0 { Some(Scalar(name, pow(2, width_of(name)))) }
        else if expanding.contains(name) { None } else {
          match find_decl(decls, name) {
            None -> None,
            Some(decl) ->
              cases_of(
                decl,
                decls,
                expanding.push(name),
                args.map(|a: Sort| substituted(a, subst)),
                depth_left - 1,
              ),
          }
        }
      },
    }
  }

/// A type whose values are too many to walk, or that is not finite at all.
fn is_unbounded(name: String) -> Bool =
  name == "Int" || name == "String" || name == "Bytes" || name == "List" || name == "Array"
    || name == "Float"
    || name == "Decimal"
    || name == "Map"
    || name == "I64"
    || name == "U64"
    || name == "I128"
    || name == "U128"

/// The bit width of a fixed-width integer type, or 0 when the name is not one.
fn width_of(name: String) -> Int =
  if name == "U8" || name == "I8" { 8 }
  else if name == "U16" || name == "I16" { 16 }
  else if name == "U32" || name == "I32" { 32 }
  else { 0 }

/// Every case of one declared type, summed: a type with no variants has no values at all.
fn cases_of(
  decl: Decl,
  decls: List<Decl>,
  expanding: List<String>,
  args: List<Sort>,
  depth_left: Int,
) -> Option<Shape> =
  match decl.variants.fold(
      Some({ total: 0, cases: [] }),
      |acc: Option<{ total: Int, cases: List<{ name: String, size: Int, fields: List<Shape> }> }>, variant: Variant|
        match acc {
          None -> None,
          Some(seen) -> match product_of(variant.fields, decls, expanding, args, depth_left) {
            None -> None,
            Some(p) -> {
              let total = seen.total + p.size;
              if total > max_enumerated_points() { None } else {
                Some({
                  total: total,
                  cases: seen.cases.push({ name: variant.name, size: p.size, fields: p.shapes }),
                })
              }
            },
          },
        },
    ) {
    None -> None,
    Some(all) -> Some(Cases(all.total, all.cases)),
  }

/// A tuple's shapes and the product of their sizes, refused as soon as it is past the bound.
fn product_of(
  types: List<Sort>,
  decls: List<Decl>,
  expanding: List<String>,
  subst: List<Sort>,
  depth_left: Int,
) -> Option<{ size: Int, shapes: List<Shape> }> =
  types.fold(
    Some({ size: 1, shapes: [] }),
    |acc: Option<{ size: Int, shapes: List<Shape> }>, ty: Sort|
      match acc {
        None -> None,
        Some(seen) -> match expand_shape(ty, decls, expanding, subst, depth_left) {
          None -> None,
          Some(shape) -> {
            let next = seen.size * shape_size(shape);
            if next > max_enumerated_points() { None }
            else { Some({ size: next, shapes: seen.shapes.push(shape) }) }
          },
        },
      },
  )

/// A record's fields in the order the type lists them, with the product of their sizes.
fn fields_of(
  fields: List<{ name: String, ty: Sort }>,
  decls: List<Decl>,
  expanding: List<String>,
  subst: List<Sort>,
  depth_left: Int,
) -> Option<{ size: Int, fields: List<{ name: String, shape: Shape }> }> =
  match product_of(
      fields.map(|f: { name: String, ty: Sort }| f.ty),
      decls,
      expanding,
      subst,
      depth_left,
    ) {
    None -> None,
    Some(p) ->
      Some({
        size: p.size,
        fields: range(0, fields.len()).map(|i: Int|
          {
            name: match fields.at(i) { Some(f) -> f.name, None -> "" },
            shape: match p.shapes.at(i) { Some(sh) -> sh, None -> Scalar("Unit", 1) },
          }),
      }),
  }

/// A type written inside a declaration, with the arguments it was applied to in place of its
/// parameters. An argument is put in as it is, so a variable in it is never read as a parameter.
pub fn substituted(ty: Sort, subst: List<Sort>) -> Sort =
  match ty {
    SortVariable(index) -> match subst.at(index) { Some(argument) -> argument, None -> ty },
    FunctionSort(params, ret, pure) ->
      FunctionSort(params.map(|p: Sort| substituted(p, subst)), substituted(ret, subst), pure),
    RecordSort(fields) ->
      RecordSort(
        fields.map(|f: { name: String, ty: Sort }| { name: f.name, ty: substituted(f.ty, subst) }),
      ),
    NamedSort(name, args) -> NamedSort(name, args.map(|a: Sort| substituted(a, subst))),
  }

/// The declaration of the type `name`, when it is a declared one.
pub fn find_decl(decls: List<Decl>, name: String) -> Option<Decl> =
  decls.fold(None, |found: Option<Decl>, decl: Decl|
    match found { Some(_) -> found, None -> if decl.name == name { Some(decl) } else { None } })

// --- Tests ------------------------------------------------------------------

fn kinds() -> List<Decl> =
  [
    {
      name: "Kind",
      params: 0,
      variants: [
        { name: "Asset", fields: [] },
        { name: "Liability", fields: [] },
        { name: "Equity", fields: [] },
      ],
    },
  ]

fn nat() -> List<Decl> =
  [
    {
      name: "Nat",
      params: 0,
      variants: [{ name: "Zero", fields: [] }, { name: "Succ", fields: [NamedSort("Nat", [])] }],
    },
  ]

pub fn named_sort(name: String) -> Sort = NamedSort(name, [])

test "a nullary enum and Bool are finite and everything unbounded is not" {
  let decls = kinds();
  assert_eq(size(named_sort("Bool"), decls), Some(2));
  assert_eq(size(named_sort("Unit"), decls), Some(1));
  assert_eq(size(named_sort("Kind"), decls), Some(3));
  assert_eq(size(named_sort("Int"), decls), None);
  assert_eq(size(named_sort("String"), decls), None);
  assert_eq(size(named_sort("Bytes"), decls), None);
  assert_eq(size(named_sort("Float"), decls), None);
  assert_eq(size(named_sort("List"), decls), None);
  // A 64-bit width does not fit the arithmetic here, but a narrower one is a count like any other.
  assert_eq(size(named_sort("U64"), decls), None);
  assert_eq(size(named_sort("U8"), decls), Some(256));
  assert_eq(size(named_sort("I32"), decls), Some(4294967296))
}

test "a type variable and a function are never finite" {
  assert_eq(size(SortVariable(0), kinds()), None);
  assert_eq(size(FunctionSort([named_sort("Bool")], named_sort("Bool"), true), kinds()), None)
}

test "a recursive type is infinite even with a nullary base case" {
  assert_eq(size(named_sort("Nat"), nat()), None)
}

test "a record's size is the product of its fields'" {
  let decls = kinds();
  assert_eq(
    size(
      RecordSort([{ name: "k", ty: named_sort("Kind") }, { name: "b", ty: named_sort("Bool") }]),
      decls,
    ),
    Some(6),
  );
  assert_eq(
    size(
      RecordSort([{ name: "k", ty: named_sort("Kind") }, { name: "n", ty: named_sort("Int") }]),
      decls,
    ),
    None,
  )
}

test "a case with fields multiplies them into its type's size" {
  let declared = kinds().concat([
    {
      name: "Wrap",
      params: 0,
      variants: [
        { name: "Nothing", fields: [] },
        { name: "Held", fields: [NamedSort("Kind", []), NamedSort("Bool", [])] },
      ],
    },
  ]);
  assert_eq(size(named_sort("Wrap"), declared), Some(7))
}

fn kind_cases() -> Shape =
  Cases(3, [
    { name: "Asset", size: 1, fields: [] },
    { name: "Liability", size: 1, fields: [] },
    { name: "Equity", size: 1, fields: [] },
  ])

// The runtime decodes a point through the shape alone, so every node says how many values it holds
// and a case its own share of its type's.
test "a shape carries each node's size, so decoding a point counts nothing" {
  let declared = kinds().concat([
    {
      name: "Wrap",
      params: 0,
      variants: [
        { name: "Nothing", fields: [] },
        { name: "Held", fields: [NamedSort("Kind", []), NamedSort("Bool", [])] },
      ],
    },
  ]);
  assert_eq(
    shape_of(named_sort("Wrap"), declared),
    Some(
      Cases(7, [
        { name: "Nothing", size: 1, fields: [] },
        { name: "Held", size: 6, fields: [kind_cases(), Scalar("Bool", 2)] },
      ]),
    ),
  );
  // A record's fields in the order the type lists them, and their product.
  assert_eq(
    shape_of(
      RecordSort([{ name: "k", ty: named_sort("Kind") }, { name: "b", ty: named_sort("Bool") }]),
      declared,
    ),
    Some(Fields(6, [{ name: "k", shape: kind_cases() }, { name: "b", shape: Scalar("Bool", 2) }])),
  );
  assert_eq(shape_of(named_sort("U8"), declared), Some(Scalar("U8", 256)));
  assert_eq(shape_of(named_sort("Unit"), declared), Some(Scalar("Unit", 1)));
  // A parameter is the argument's own shape.
  let pair = kinds().concat([
    {
      name: "Pair",
      params: 1,
      variants: [{ name: "Both", fields: [SortVariable(0), SortVariable(0)] }],
    },
  ]);
  assert_eq(
    shape_of(NamedSort("Pair", [named_sort("Bool")]), pair),
    Some(Cases(4, [{ name: "Both", size: 4, fields: [Scalar("Bool", 2), Scalar("Bool", 2)] }])),
  );
  // What is not finite has no shape at all.
  assert_eq(shape_of(named_sort("Int"), declared), None)
}

test "a domain is the binders' shapes and the product of their sizes" {
  match finite([named_sort("Bool"), named_sort("Kind")], kinds()) {
    None -> assert_eq(false, true),
    Some(domain) -> {
      assert_eq(domain.shapes, [Scalar("Bool", 2), kind_cases()]);
      assert_eq(sizes_of(domain), [2, 3]);
      assert_eq(domain.points, 6)
    },
  }
}

test "an Int is finite between the ends its guards hold it to, and walked from the least" {
  let held = |low: Int, high: Int|
    finite_within([{ ty: named_sort("Int"), within: Some({ low: low, high: high }) }], []);
  assert_eq(held(1, 100), Some({ shapes: [Ints(1, 100)], points: 100 }));
  assert_eq(held(-2, -2), Some({ shapes: [Ints(-2, 1)], points: 1 }));
  // Ends that hold nothing, or more than a walk pays for, are no domain.
  assert_eq(held(6, 2), None);
  assert_eq(held(0, max_enumerated_points()), None);
  assert_eq(
    held(0, max_enumerated_points() - 1),
    Some({ shapes: [Ints(0, max_enumerated_points())], points: max_enumerated_points() }),
  );
  // Ends say nothing of a binder of another type, and an `Int` they do not hold is not finite.
  assert_eq(
    finite_within([{ ty: named_sort("Bool"), within: Some({ low: 0, high: 9 }) }], []),
    finite([named_sort("Bool")], []),
  );
  assert_eq(finite_within([{ ty: named_sort("Int"), within: None }], []), None);
  match finite_within(
      [
        { ty: named_sort("Bool"), within: None },
        { ty: named_sort("Int"), within: Some({ low: 3, high: 4 }) },
      ],
      [],
    ) {
    Some(domain) ->
      assert_eq(range(0, 4).map(|i: Int| point_at(domain, i)), [
        Some([VBool(false), VInt(3)]),
        Some([VBool(false), VInt(4)]),
        Some([VBool(true), VInt(3)]),
        Some([VBool(true), VInt(4)]),
      ]),
    None -> assert(false),
  }
}

test "a product beyond the bound is refused rather than walked" {
  let decls = kinds();
  assert_eq(finite(range(0, 16).map(|_i: Int| named_sort("Kind")), decls), None);
  match finite(range(0, 4).map(|_i: Int| named_sort("Kind")), decls) {
    None -> assert_eq(false, true),
    Some(domain) -> assert_eq(domain.points, 81),
  }
}

test "a domain with a binder no value inhabits is a vacuity, not a proof" {
  let declared = [{ name: "Empty", params: 0, variants: [] }];
  assert_eq(finite([named_sort("Empty")], declared), None)
}

test "a domain is named by its binders, and a product of none is unit" {
  assert_eq(domain_name([]), "unit");
  assert_eq(domain_name(["Bool"]), "Bool");
  assert_eq(domain_name(["Bool", "Kind"]), "Bool × Kind")
}

test "a ground claim has exactly one point" {
  match finite([], kinds()) {
    None -> assert_eq(false, true),
    Some(domain) -> {
      assert_eq(domain.points, 1);
      assert_eq(point_indices(domain, 0), Some([]));
    },
  }
}

test "enumeration covers the domain once each in a fixed order" {
  let decls = kinds();
  match finite([named_sort("Bool"), named_sort("Kind")], decls) {
    None -> assert_eq(false, true),
    Some(domain) -> {
      assert_eq(domain.points, 6);
      assert_eq(point_indices(domain, 0), Some([0, 0]));
      assert_eq(point_indices(domain, 3), Some([1, 0]));
      assert_eq(point_indices(domain, 5), Some([1, 2]));
      assert_eq(point_indices(domain, 6), None);
      // Every point is named once: a repeated tuple would be a domain walked short.
      let seen = range(0, domain.points).map(|i: Int| point_indices(domain, i));
      let tuples = seen.fold([], |acc: List<List<Int>>, t: Option<List<Int>>|
        match t { Some(xs) -> acc.push(xs), None -> acc });
      assert_eq(tuples.len(), domain.points)
    },
  }
}

test "a parameter is the argument the type was applied to" {
  let declared = kinds().concat([
    {
      name: "Pair",
      params: 1,
      variants: [{ name: "Both", fields: [SortVariable(0), SortVariable(0)] }],
    },
  ]);
  assert_eq(size(NamedSort("Pair", [named_sort("Bool")]), declared), Some(4));
  assert_eq(size(NamedSort("Pair", [named_sort("Kind")]), declared), Some(9));
  // The same declaration under a type with no finite size is not a finite type.
  assert_eq(size(NamedSort("Pair", [named_sort("Int")]), declared), None);
  // A type already being walked is refused whether it nests or recurses: `Pair<Pair<Bool>>` is
  // finite, and reading it as unbounded is the conservative answer the reference gives too.
  assert_eq(size(NamedSort("Pair", [NamedSort("Pair", [named_sort("Bool")])]), declared), None);
  // An argument the declaration never binds is unknown rather than dropped.
  assert_eq(size(NamedSort("Pair", []), declared), None)
}

test "a recursive type stays infinite under an argument, not only on its own" {
  let declared = [
    {
      name: "Nest",
      params: 1,
      variants: [
        { name: "Leaf", fields: [SortVariable(0)] },
        { name: "More", fields: [NamedSort("Nest", [SortVariable(0)])] },
      ],
    },
  ];
  assert_eq(size(NamedSort("Nest", [named_sort("Bool")]), declared), None)
}

// A claim's variables and a declaration's parameters are both numbered from zero, each in its own
// item, so reading one as the other would size `Pair<a>` by itself forever.
test "a claim's own variable has no size, even where it fills a parameter numbered the same" {
  let declared = kinds().concat([
    {
      name: "Pair",
      params: 1,
      variants: [{ name: "Both", fields: [SortVariable(0), SortVariable(0)] }],
    },
  ]);
  assert_eq(size(NamedSort("Pair", [SortVariable(0)]), declared), None);
  assert_eq(finite([NamedSort("Pair", [SortVariable(0)]), named_sort("Bool")], declared), None)
}

test "a parameter handed on to another declaration is what the outer one was applied to" {
  let declared = kinds().concat([
    { name: "Box", params: 1, variants: [{ name: "Boxed", fields: [SortVariable(0)] }] },
    {
      name: "Two",
      params: 1,
      variants: [{ name: "Two", fields: [NamedSort("Box", [SortVariable(0)]), SortVariable(0)] }],
    },
  ]);
  assert_eq(size(NamedSort("Two", [named_sort("Kind")]), declared), Some(9));
  assert_eq(size(NamedSort("Two", [SortVariable(0)]), declared), None)
}

test "a point is every binder's value, the last varying fastest" {
  match finite([NamedSort("Bool", []), NamedSort("Unit", []), NamedSort("Bool", [])], []) {
    None -> panic("a finite domain"),
    Some(d) -> {
      assert_eq(point_at(d, 0), Some([VBool(false), VUnit, VBool(false)]));
      assert_eq(point_at(d, 1), Some([VBool(false), VUnit, VBool(true)]));
      assert_eq(point_at(d, 2), Some([VBool(true), VUnit, VBool(false)]));
      assert_eq(point_at(d, 4), None)
    },
  }
}

test "a case takes its share of its type, a width starts at its least value, and a ground claim has one point" {
  let decls = [
    {
      name: "m.Kind",
      params: 0,
      variants: [{ name: "m.Off", fields: [] }, { name: "m.On", fields: [NamedSort("Bool", [])] }],
    },
  ];
  match finite([NamedSort("m.Kind", [])], decls) {
    None -> panic("a finite domain"),
    Some(d) ->
      assert_eq(range(0, d.points).map(|i: Int| point_at(d, i)), [
        Some([VCtor("m.Off", [])]),
        Some([VCtor("m.On", [VBool(false)])]),
        Some([VCtor("m.On", [VBool(true)])]),
      ]),
  };
  match finite([NamedSort("I8", [])], []) {
    None -> panic("a finite domain"),
    Some(d) -> {
      assert_eq(point_at(d, 0), Some([VFixed("I8", 128u128)]));
      assert_eq(point_at(d, 128), Some([VFixed("I8", 0u128)]))
    },
  };
  match finite([], []) {
    None -> panic("a ground domain"),
    Some(d) -> assert_eq(point_at(d, 0), Some([])),
  }
}
