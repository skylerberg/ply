type Fixture = { context: Context, built: ProverInputResult, claims: Claims }

fn fixture(source: String) -> Fixture / {abort.raise} = {
  let sources = [{ name: b"m", source_text: Bytes::of_string(source) }];
  match analyse(parse_all(sources)) {
    Rejected(_) -> panic("the fixture checks"),
    Analysed(w) -> {
      let built = prover_input_of(w, prover_input::every);
      let cs = claims_of(claims(sources));
      { context: context(cs, built.world), built: built, claims: cs }
    },
  }
}

fn owner(label: String) -> String = "m." ++ label

fn law_goal(f: Fixture, label: String) -> Goal / {abort.raise} =
  match f.claims.laws.get(owner(label)) {
    None -> panic("no law labelled " ++ label),
    Some(l) ->
      {
        binders: law_binders(f, label),
        guards: match l.guard { Some(g) -> [Some(g.code)], None -> [] },
        result: None,
        body: Some(l.body),
        lemmas: [],
        assumed_terminating: [],
        partial: false,
        identities: law_identities(f, label),
        contracts: [],
        induction_hypothesis: None,
        builds: None,
        tainted: [],
      },
  }

fn law_identities(f: Fixture, label: String) -> List<Int> =
  match f.built.world.obligations.fold(None, |accumulator: Option<Obligation>, o: Obligation|
      match accumulator {
        Some(_) -> accumulator,
        None -> if o.owner == owner(label) { Some(o) } else { None },
      }) {
    Some(o) -> o.identities,
    None -> [],
  }

fn law_binders(f: Fixture, label: String) -> List<Binder> =
  match f.built.world.obligations.fold(None, |accumulator: Option<Obligation>, o: Obligation|
      match accumulator {
        Some(_) -> accumulator,
        None -> if o.owner == owner(label) { Some(o) } else { None },
      }) {
    Some(o) ->
      o.binders.map(|binder: prover_input::Binder| { name: binder.name, ty: canonical(binder.ty) }),
    None -> [],
  }

fn attempt(f: Fixture, label: String) -> Decision / {abort.raise} =
  decide(f.context, law_goal(f, label), default_limits())

fn attempt_with(f: Fixture, label: String, limits: Limits) -> Decision / {abort.raise} =
  decide(f.context, law_goal(f, label), limits)

fn diagnosed(f: Fixture, label: String) -> Diagnosis / {abort.raise} =
  decide_and_diagnose(f.context, law_goal(f, label), default_limits())

fn proof(f: Fixture, label: String) -> Proof / {abort.raise} =
  match diagnosed(f, label) {
    { decision: Proved(p), blockers: _ } -> p,
    _ -> panic("`" ++ label ++ "` was expected to be proved"),
  }

fn not_proved(f: Fixture, label: String) -> Bool / {abort.raise} =
  match attempt(f, label) { Proved(_) -> false, _ -> true }

fn is_proved(f: Fixture, label: String) -> Bool / {abort.raise} =
  match attempt(f, label) { Proved(_) -> true, _ -> false }

fn vacuous(d: Decision) -> Bool = match d { GuardUnsatisfiable(_) -> true, _ -> false }

fn uses(p: Proof, r: Rule) -> Bool = p.rules.fold(false, |f: Bool, x: Rule| f || x == r)

test "linear arithmetic proves the true claims and does not prove the false ones" {
  let f = fixture(arithmetic());
  assert(uses(proof(f, "bounded positives sum past one"), LinearArithmetic));
  assert(not_proved(f, "bounded positives sum past two"));
  assert(is_proved(f, "bounded doubling is adding"));
  assert(is_proved(f, "bounded subtraction inverts"));
  assert(is_proved(f, "ordering is transitive"));
  assert(not_proved(f, "ordering skips two"))
}

test "an int is bounded by its own width" {
  assert(is_proved(fixture(arithmetic()), "an int is not below the smallest"))
}

test "arithmetic that can overflow `Int` is not proved, but the same claims with bounded inputs are" {
  let f = fixture(arithmetic());
  let pairs = [
    { unbounded: "a successor is larger", bounded: "a bounded successor is larger" },
    { unbounded: "positives sum past one", bounded: "bounded positives sum past one" },
    { unbounded: "doubling is adding", bounded: "bounded doubling is adding" },
    { unbounded: "subtraction inverts", bounded: "bounded subtraction inverts" },
  ];
  assert(
    pairs.fold(true, |ok: Bool, p: { unbounded: String, bounded: String }|
      ok && not_proved(f, p.unbounded) && is_proved(f, p.bounded)),
  )
}

test "a quotient is a value only where its divisor is not zero" {
  let f = fixture(arithmetic());
  assert(not_proved(f, "a symbolic quotient is a function"));
  assert(is_proved(f, "a nonzero quotient is a function"));
  assert(not_proved(f, "remainder by zero is a function"));
  assert(not_proved(f, "dividing by minus one is a function"));
  assert(is_proved(f, "dividing a bounded value by minus one"))
}

test "strict inequalities are tightened to the integers" {
  let f = fixture(arithmetic());
  assert(is_proved(f, "a strict bound is a tight bound"));
  assert(not_proved(f, "a strict bound is tighter still"));
  assert(is_proved(f, "ordering skips one"))
}

test "multiplying two variables is not linear arithmetic, so commutativity of multiplication is not proved" {
  assert(not_proved(fixture(arithmetic()), "multiplication commutes"))
}

test "division is not interpreted as arithmetic, so claims that depend on its value are not proved" {
  let f = fixture(arithmetic());
  assert(not_proved(f, "halves are wholes"));
  assert(not_proved(f, "dividing by one"));
  assert(is_proved(f, "division is a function"));
  assert(is_proved(f, "remainder is a function"))
}

test "an unsatisfiable guard is vacuous and never proved" {
  assert(vacuous(attempt(fixture(arithmetic()), "an integer between")))
}

test "a satisfiable guard is never vacuous however narrow" {
  let f = fixture(arithmetic());
  assert(!vacuous(attempt(f, "a domain of one point")));
  assert(!vacuous(attempt(f, "a domain of one wrong point")));
  assert(is_proved(f, "a domain of one point"));
  assert(not_proved(f, "a domain of one wrong point"))
}

test "two overflowing operations are not proved equal, and an overflowing sum is not proved equal to itself" {
  let f = fixture(boundaries());
  assert(not_proved(f, "an overflowing sum is an overflowing product"));
  assert(not_proved(f, "an overflowing difference is an overflowing product"));
  assert(not_proved(f, "an overflowing sum is itself"))
}

test "arithmetic is proved only where the result is an Int" {
  let f = fixture(boundaries());
  assert(not_proved(f, "adding one grows"));
  assert(not_proved(f, "a round trip past the boundary"));
  assert(is_proved(f, "a bounded round trip"))
}

fn arithmetic() -> String =
  String::unlines([
    "law \"a successor is larger\" forall (x: Int) { x + 1 > x }",
    "law \"a bounded successor is larger\" forall (x: Int) where x < 100 { x + 1 > x }",
    "law \"a successor is smaller\" forall (x: Int) { x + 1 > x + 2 }",
    "law \"positives sum past one\" forall (x: Int, y: Int) where x > 0 && y > 0 { x + y > 1 }",
    "law \"bounded positives sum past one\" forall (x: Int, y: Int)",
    "  where x > 0 && y > 0 && x < 1000 && y < 1000 { x + y > 1 }",
    "law \"positives sum past two\" forall (x: Int, y: Int) where x > 0 && y > 0 { x + y > 2 }",
    "law \"bounded positives sum past two\" forall (x: Int, y: Int)",
    "  where x > 0 && y > 0 && x < 1000 && y < 1000 { x + y > 2 }",
    "law \"doubling is adding\" forall (x: Int) { 2 * x == x + x }",
    "law \"bounded doubling is adding\" forall (x: Int) where x > -1000 && x < 1000",
    "  { 2 * x == x + x }",
    "law \"multiplication commutes\" forall (x: Int, y: Int) { x * y == y * x }",
    "law \"subtraction inverts\" forall (x: Int, y: Int) { x + y - y == x }",
    "law \"bounded subtraction inverts\" forall (x: Int, y: Int)",
    "  where x > -1000 && x < 1000 && y > -1000 && y < 1000 { x + y - y == x }",
    "law \"ordering is transitive\" forall (x: Int, y: Int, z: Int) where x < y && y < z { x < z }",
    "law \"ordering skips one\" forall (x: Int, y: Int, z: Int) where x < y && y < z { x < z - 1 }",
    "law \"ordering skips two\" forall (x: Int, y: Int, z: Int) where x < y && y < z { x < z - 2 }",
    "law \"a strict bound is a tight bound\" forall (x: Int, y: Int) where x < y { x + 1 <= y }",
    "law \"a strict bound is tighter still\" forall (x: Int, y: Int) where x < y { x + 2 <= y }",
    "law \"an integer between\" forall (x: Int) where x > 0 && x < 1 { x == 100 }",
    "law \"a domain of one point\" forall (x: Int) where x > 0 && x < 2 { x == 1 }",
    "law \"a domain of one wrong point\" forall (x: Int) where x > 0 && x < 2 { x == 2 }",
    "law \"halves are wholes\" forall (x: Int) { x / 2 * 2 == x }",
    "law \"dividing by one\" forall (x: Int) { x / 1 == x }",
    "law \"division is a function\" forall (x: Int) { x / 2 == x / 2 }",
    "law \"remainder is a function\" forall (x: Int, y: Int) where x == y { x % 3 == y % 3 }",
    "law \"a symbolic quotient is a function\" forall (x: Int, y: Int) { x / y == x / y }",
    "law \"a nonzero quotient is a function\" forall (x: Int, y: Int) where y > 0",
    "  { x / y == x / y }",
    "law \"an int is not below the smallest\" forall (x: Int)",
    "  { x >= -9223372036854775807 - 1 }",
    "law \"dividing by minus one is a function\" forall (x: Int) { x / -1 == x / -1 }",
    "law \"dividing a bounded value by minus one\" forall (x: Int) where x > -100",
    "  { x / -1 == x / -1 }",
    "law \"remainder by zero is a function\" forall (x: Int) { x % 0 == x % 0 }",
  ])

fn boundaries() -> String =
  String::unlines([
    "law \"adding one grows\" forall (x: Int) { x + 1 > x }",
    "law \"the largest int\" { 9223372036854775807 + 1 > 9223372036854775807 }",
    "law \"a round trip past the boundary\" forall (x: Int)",
    "  { x + 9223372036854775807 - 9223372036854775807 == x }",
    "law \"a bounded round trip\" forall (x: Int) where x > -1000 && x < 1000",
    "  { x + 1000 - 1000 == x }",
    "law \"scaling past the boundary\" forall (x: Int)",
    "  { x * 9223372036854775807 * 9223372036854775807 * 9223372036854775807 * 3 ==",
    "    x * 9223372036854775807 * 9223372036854775807 * 9223372036854775807 * 3 }",
    "law \"the smallest int is smallest\" forall (x: Int) { x >= -9223372036854775807 }",
    "law \"an overflowing sum is an overflowing product\"",
    "  { 9223372036854775807 + 9223372036854775807 ==",
    "    9223372036854775807 * 9223372036854775807 }",
    "law \"an overflowing difference is an overflowing product\"",
    "  { -9223372036854775807 - 9223372036854775807 ==",
    "    -9223372036854775807 * 9223372036854775807 }",
    "law \"an overflowing sum is itself\" forall (x: Int)",
    "  where x == 9223372036854775807 + 9223372036854775807",
    "  { x == 9223372036854775807 + 9223372036854775807 }",
  ])

fn propositional() -> String =
  String::unlines([
    "law \"excluded middle\" forall (b: Bool) { b || !b }",
    "law \"a bare disjunction\" forall (b: Bool, c: Bool) { b || c }",
    "law \"disjunction commutes\" forall (b: Bool, c: Bool) where b || c { c || b }",
    "law \"de morgan\" forall (b: Bool, c: Bool) { !(b && c) == (!b || !c) }",
    "law \"de morgan mangled\" forall (b: Bool, c: Bool) { !(b && c) == (!b && !c) }",
    "law \"a conditional picks a branch\" forall (b: Bool, x: Int)",
    "  { if b { x } else { x } == x }",
    "law \"a conditional is not constant\" forall (b: Bool, x: Int, y: Int)",
    "  { if b { x } else { y } == x }",
  ])

fn congruence_source() -> String =
  String::unlines([
    "law \"a function is a function\" forall (f: (Int) -> Int, x: Int) { f(x) == f(x) }",
    "law \"equal arguments agree\" forall (f: (Int) -> Int, x: Int, y: Int) where x == y",
    "  { f(x) == f(y) }",
    "law \"any two arguments agree\" forall (f: (Int) -> Int, x: Int, y: Int)",
    "  { f(x) == f(y) }",
    "law \"congruence is polymorphic\" forall (g: (a) -> List<b>, u: a) { g(u).len() == g(u).len() }",
    "law \"equal values at a variable are taken alike\" forall (g: (a) -> b, u: a, v: a) where u == v",
    "  { g(u) == g(v) }",
    "law \"a record is its fields\" forall (n: Int) { { balance: n }.balance == n }",
    "law \"records with equal fields are equal\" forall (n: Int, m: Int) where n == m",
    "  { { balance: n } == { balance: m } }",
    "law \"records with any fields are equal\" forall (n: Int, m: Int)",
    "  { { balance: n } == { balance: m } }",
    "",
    "fn moved(account: { name: String, balance: Int }, amount: Int)",
    "  -> { name: String, balance: Int }",
    "= { name: account.name, balance: account.balance + amount }",
    "",
    "law \"a record rebuilt from its own fields is the record\"",
    "  forall (a: { name: String, balance: Int }) {",
    "    { name: a.name, balance: a.balance } == a",
    "  }",
    "law \"moving an account and moving it back is the account\"",
    "  forall (a: { name: String, balance: Int }, n: Int)",
    "  where n > -1000 && n < 1000 && a.balance > -1000 && a.balance < 1000 {",
    "    moved(moved(a, n), 0 - n) == a",
    "  }",
    "law \"moving an unbounded account and back is the account\"",
    "  forall (a: { name: String, balance: Int }, n: Int) {",
    "    moved(moved(a, n), 0 - n) == a",
    "  }",
    "law \"moving an account leaves it where it was\"",
    "  forall (a: { name: String, balance: Int }, n: Int) {",
    "    moved(a, n) == a",
    "  }",
    "law \"one matching field is enough\"",
    "  forall (a: { name: String, balance: Int }, b: { name: String, balance: Int })",
    "  where a.name == b.name {",
    "    a == b",
    "  }",
  ])

fn shapes_source() -> String =
  String::unlines([
    "type Shape = Circle(Int) | Square(Int)",
    "",
    "law \"constructors are injective\" forall (a: Int, b: Int) where Circle(a) == Circle(b)",
    "  { a == b }",
    "law \"injective by one\" forall (a: Int, b: Int) where Circle(a) == Circle(b)",
    "  { a == b + 1 }",
    "law \"constructors are distinct\" forall (a: Int, b: Int) where Circle(a) == Square(b)",
    "  { a == b + 1 }",
    "law \"a rebuilt value is the same\" forall (a: Int) { Circle(a) == Circle(a) }",
    "law \"two constructors are not\" forall (a: Int) { Circle(a) == Square(a) }",
  ])

fn rainbow_source() -> String =
  String::unlines([
    "type Colour = Red | Orange | Yellow | Green | Blue | Indigo | Violet | Black",
    "",
    "fn rank(c: Colour) -> Int = match c {",
    "  Red -> 0,",
    "  Orange -> 1,",
    "  Yellow -> 2,",
    "  Green -> 3,",
    "  Blue -> 4,",
    "  Indigo -> 5,",
    "  Violet -> 6,",
    "  Black -> 7,",
    "}",
    "",
    "law \"every rank is in range\" forall (c: Colour) { rank(c) >= 0 && rank(c) <= 7 }",
    "law \"every rank is small\" forall (c: Colour) { rank(c) <= 6 }",
    "law \"no rank is seven\" forall (c: Colour) { rank(c) != 7 }",
  ])

fn chain() -> String =
  String::unlines([
    "fn one(x: Int) -> Int = x + 1",
    "fn two(x: Int) -> Int = one(x) + 1",
    "fn three(x: Int) -> Int = two(x) + 1",
    "fn four(x: Int) -> Int = three(x) + 1",
    "",
    "fn countdown(n: Int) -> Int = if n <= 0 { 0 } else { countdown(n - 1) + 1 }",
    "fn doubled(n: Int) -> Int = if n <= 0 { 0 } else { doubled(n - 1) + 2 }",
    "fn forever(n: Int) -> Int / {diverges} = forever(n)",
    "fn twice_down(n: Int) -> Int = if n <= 0 { 0 } else { twice_down(n - 2) + 2 }",
    "fn topped(n: Int) -> Int = if n <= 0 { 9223372036854775807 } else { topped(n - 1) + 1 }",
    "fn ping(n: Int) -> Int = if n <= 0 { 0 } else { pong(n - 1) + 1 }",
    "fn pong(n: Int) -> Int = if n <= 0 { 0 } else { ping(n - 1) + 1 }",
    "fn halved(n: Int) -> Int decreases n = if n <= 0 { 0 } else { halved(n / 2) + 1 }",
    "fn climb(a: Int, b: Int) -> Int decreases a + b = if a + b <= 0 { 0 } else { climb(a + 1, b - 2) }",
    "fn stall(n: Int) -> Int decreases n = if n <= 0 { 0 } else { stall(n) }",
    "fn is_small(n: Int) -> Bool = n <= 0",
    "fn lowered(n: Int) -> Int decreases n = if is_small(n) { 0 } else { lowered(n - 1) + 1 }",
    "fn up(a: Int, b: Int) -> Int decreases a + b = if a + b <= 0 { 0 } else { across(a + 1, b - 2) }",
    "fn across(a: Int, b: Int) -> Int decreases a + b = if a + b <= 0 { 0 } else { up(a - 2, b + 1) }",
    "fn tick(a: Int, b: Int) -> Int decreases a + b = if a + b <= 0 { 0 } else { tock(a + 1, b) }",
    "fn tock(a: Int, b: Int) -> Int decreases a + b = if a + b <= 0 { 0 } else { tick(a - 2, b) }",
    "",
    "law \"three unfoldings suffice\" forall (x: Int) where x > 0 && x < 1000",
    "  { three(x) == x + 3 }",
    "law \"four unfoldings do not\" forall (x: Int) where x > 0 && x < 1000",
    "  { four(x) == x + 4 }",
    "law \"a recursive call is a function\" forall (n: Int) { countdown(n) == countdown(n) }",
    "law \"a recursive definition steps\" forall (n: Int) where n > 0",
    "  { countdown(n) == countdown(n - 1) + 1 }",
    "law \"counting down counts\" forall (n: Int) where n >= 0 { countdown(n) == n }",
    "law \"doubling by recursion\" forall (n: Int) where n >= 0 && n < 1000000 { doubled(n) == 2 * n }",
    "law \"counting down is not the identity\" forall (n: Int) { countdown(n) == n }",
    "law \"counting down is never negative\" forall (n: Int) { countdown(n) >= 0 }",
    "law \"a step off the top overflows\" forall (n: Int) where n >= 0 { topped(n + 1) == topped(n) + 1 }",
    "law \"a definition that never returns is not a function\" forall (n: Int) { forever(n) == forever(n) }",
    "law \"stepping by two counts\" forall (n: Int) where n >= 0 { twice_down(n) == n }",
    "law \"a mutual recursion is not unrolled\" forall (n: Int) where n >= 0 { ping(n) == n }",
    "law \"every int is at most zero\" forall (n: Int) { n <= 0 }",
    "law \"a measured recursion counts\" forall (n: Int) where n >= 0 { lowered(n) == n }",
  ])

fn spines_source() -> String =
  String::unlines([
    "fn count<a>(xs: List<a>) -> Int = match xs { [] -> 0, [_, ..rest] -> 1 + count(rest) }",
    "fn total(xs: List<Int>) -> Int = match xs { [] -> 0, [x, ..rest] -> x + total(rest) }",
    "fn spin(xs: List<Int>) -> Int / {diverges} = match xs { [] -> 0, [_, ..rest] -> spin(xs) }",
    "fn count_from<a>(xs: List<a>, k: Int) -> Int = match xs { [] -> k, [_, ..rest] -> count_from(rest, k + 1) }",
    "",
    "law \"counting counts\" forall (xs: List<Int>) { count(xs) == xs.len() }",
    "law \"a total is a total\" forall (xs: List<Int>) { total(xs) == total(xs) }",
    "law \"a total of ints is non-negative\" forall (xs: List<Int>) { total(xs) >= 0 }",
    "law \"a definition that keeps its list is not a function\" forall (xs: List<Int>) { spin(xs) == spin(xs) }",
    "law \"counting from an accumulator counts\" forall (xs: List<Int>, k: Int) where k >= 0 && k < 1000 { count_from(xs, k) == xs.len() + k }",
    "law \"a list pattern takes the head of a literal\" forall (x: Int) { match [x, 2] { [a, ..] -> a == x, [] -> false } }",
    "law \"a list pattern does not confuse the tail\" forall (x: Int) { match [1, x] { [_, b] -> b == 1, _ -> false } }",
    "law \"a pushed literal ends in what was pushed\" forall (x: Int) { match [1].push(x) { [_, b] -> b == x, _ -> false } }",
    "fn reverse(xs: List<Int>) -> List<Int> = match xs { [] -> [], [x, ..rest] -> reverse(rest).push(x) }",
    "law \"reversing twice, before its lemma\" forall (xs: List<Int>) { xs == reverse(reverse(xs)) }",
    "law \"reversing keeps the length\" forall (xs: List<Int>) { reverse(xs).len() == xs.len() }",
    "law \"a push reversed leads\" forall (ys: List<Int>, x: Int) { match reverse(ys.push(x)) { [h, ..t] -> h == x && t == reverse(ys), [] -> false } }",
    "law \"reverse twice is identity\" forall (xs: List<Int>) { reverse(reverse(xs)) == xs }",
  ])

fn effectful_source() -> String =
  String::unlines([
    "effect log { write note(n: Int) -> Unit }",
    "effect counter { write next() -> Int }",
    "",
    "fn shout(n: Int) -> Int / {log.note} = { log.note(n); n }",
    "fn bump() -> Int / {counter.next} = counter.next()",
    "fn difference() -> Int / {counter.next} ensures result == 0 = bump() - bump()",
    "fn once() -> Int / {counter.next} ensures result == 0 = { let n = counter.next(); n - n }",
  ])

fn matching() -> String =
  String::unlines([
    "fn flip(b: Bool) -> Bool = match b { true -> false, false -> true }",
    "fn absolute(x: Int) -> Int = if x < 0 { 0 - x } else { x }",
    "",
    "type Pair = Pair(Int, Int)",
    "fn left(p: Pair) -> Int = match p { Pair(a, _) -> a }",
    "fn swap(p: Pair) -> Pair = match p { Pair(a, b) -> Pair(b, a) }",
    "",
    "law \"flipping twice is identity\" forall (b: Bool) { flip(flip(b)) == b }",
    "law \"flipping once is identity\" forall (b: Bool) { flip(b) == b }",
    "law \"absolute is non negative\" forall (x: Int) { absolute(x) >= 0 }",
    "law \"a bounded absolute is non negative\" forall (x: Int) where x > -1000",
    "  { absolute(x) >= 0 }",
    "law \"absolute is positive\" forall (x: Int) { absolute(x) > 0 }",
    "law \"swapping twice is identity\" forall (p: Pair) { swap(swap(p)) == p }",
    "law \"swapping once is identity\" forall (p: Pair) { swap(p) == p }",
    "law \"left of a swap\" forall (p: Pair) { left(swap(swap(p))) == left(p) }",
  ])

fn ledger_source() -> String =
  String::unlines([
    "type Account = Account(Int, Int)",
    "",
    "fn identifier(a: Account) -> Int = match a { Account(i, _) -> i }",
    "fn balance(a: Account) -> Int = match a { Account(_, b) -> b }",
    "",
    "fn withdraw(acct: Account, amount: Int) -> Account",
    "  requires amount > 0",
    "  ensures balance(result) == balance(acct) - amount",
    "  ensures identifier(result) == identifier(acct)",
    "  ensures balance(result) == balance(acct) + amount",
    "  = Account(identifier(acct), balance(acct) - amount)",
  ])

fn hard() -> String =
  String::unlines([
    "type Bit = Zero | One",
    "fn value(b: Bit) -> Int = match b { Zero -> 0, One -> 1 }",
    "",
    "law \"four bits are bounded\" forall (a: Bit, b: Bit, c: Bit, d: Bit)",
    "  { value(a) + value(b) + value(c) + value(d) <= 4 }",
    "",
    "law \"five bits are bounded\" forall (a: Bit, b: Bit, c: Bit, d: Bit, e: Bit)",
    "  { value(a) + value(b) + value(c) + value(d) + value(e) <= 5 }",
  ])

fn guarded() -> String =
  String::unlines([
    "law \"a guard nothing establishes\" forall (x: Int, y: Int) where x < y { x != y }",
    "law \"an unguarded claim\" forall (x: Int) { x == x }",
  ])

fn uninhabited_source() -> String =
  String::unlines([
    "type Bottom = Wrap(Bottom)",
    "",
    "law \"anything about nothing\" forall (b: Bottom) { b == b }",
  ])

fn lists() -> String =
  String::unlines([
    "law \"list literals are injective\" forall (a: Int, b: Int) where [a] == [b] { a == b }",
    "law \"list literals are injective by one\" forall (a: Int, b: Int) where [a] == [b]",
    "  { a == b + 1 }",
    "law \"lists of different lengths differ\" forall (a: Int, b: Int) where [a] == [b, b]",
    "  { a == b + 1 }",
  ])

fn opaque_source() -> String =
  String::unlines([
    "type Tree = Leaf | Node(Tree, Tree)",
    "",
    "fn depth_one(t: Tree) -> Int = match t {",
    "  Node(Leaf, _) -> 1,",
    "  _ -> 0,",
    "}",
    "",
    "law \"a nested pattern is not decided\" forall (t: Tree) { depth_one(t) >= 0 }",
    "law \"a nested pattern is still a function\" forall (t: Tree) { depth_one(t) == depth_one(t) }",
  ])

fn audit_program() -> String =
  String::unlines([
    "type Shade = Pale | Mid | Deep",
    "",
    "fn weight(s: Shade) -> Int = match s { Pale -> 1, Mid -> 2, Deep -> 3 }",
    "fn twice(x: Int) -> Int = x + x",
    "fn quadruple(x: Int) -> Int = twice(x) + twice(x)",
    "",
    "law \"identity of addition\" forall (x: Int) { x + 0 == x }",
    "law \"addition commutes\" forall (x: Int, y: Int) { x + y == y + x }",
    "law \"bounded addition commutes\" forall (x: Int, y: Int)",
    "  where x > -1000 && x < 1000 && y > -1000 && y < 1000 { x + y == y + x }",
    "law \"addition associates\" forall (x: Int, y: Int, z: Int)",
    "  { (x + y) + z == x + (y + z) }",
    "law \"bounded addition associates\" forall (x: Int, y: Int, z: Int)",
    "  where x > -1000 && x < 1000 && y > -1000 && y < 1000 && z > -1000 && z < 1000",
    "  { (x + y) + z == x + (y + z) }",
    "law \"self subtraction is zero\" forall (x: Int) { x - x == 0 }",
    "law \"negation is subtraction\" forall (x: Int) { 0 - x == -x }",
    "law \"bounded negation is subtraction\" forall (x: Int) where x > -1000 && x < 1000",
    "  { 0 - x == -x }",
    "law \"doubling scales\" forall (x: Int) { twice(x) == 2 * x }",
    "law \"bounded doubling scales\" forall (x: Int) where x > -1000 && x < 1000",
    "  { twice(x) == 2 * x }",
    "law \"quadrupling scales\" forall (x: Int) { quadruple(x) == 4 * x }",
    "law \"bounded quadrupling scales\" forall (x: Int) where x > -1000 && x < 1000",
    "  { quadruple(x) == 4 * x }",
    "law \"a positive is at least one\" forall (x: Int) where x > 0 { x >= 1 }",
    "law \"at least one is positive\" forall (x: Int) where x >= 1 { x > 0 }",
    "law \"antisymmetry\" forall (x: Int, y: Int) where x <= y && y <= x { x == y }",
    "law \"strictness is asymmetric\" forall (x: Int, y: Int) where x < y { y > x }",
    "law \"multiplication commutes\" forall (x: Int, y: Int) { x * y == y * x }",
    "law \"a square is not negative\" forall (x: Int) { x * x >= 0 }",
    "law \"de morgan for conjunction\" forall (b: Bool, c: Bool)",
    "  { !(b && c) == (!b || !c) }",
    "law \"de morgan for disjunction\" forall (b: Bool, c: Bool)",
    "  { !(b || c) == (!b && !c) }",
    "law \"double negation\" forall (b: Bool) { !!b == b }",
    "law \"a disjunct is implied\" forall (b: Bool, c: Bool) where b { b || c }",
    "law \"a branch is one of two\" forall (b: Bool, x: Int, y: Int)",
    "  { if b { x } else { y } == x || if b { x } else { y } == y }",
    "law \"a function is a function\" forall (f: (Int) -> Int, x: Int) { f(x) == f(x) }",
    "law \"equal arguments agree\" forall (f: (Int) -> Int, x: Int, y: Int) where x == y",
    "  { f(x) == f(y) }",
    "law \"a field is what was put in it\" forall (x: Int) { { amount: x }.amount == x }",
    "law \"every weight is positive\" forall (s: Shade) { weight(s) >= 1 }",
    "law \"no weight is four\" forall (s: Shade) { weight(s) != 4 }",
    "",
    "law \"successor is identity\" forall (x: Int) { x + 1 == x }",
    "law \"everything is ordered one way\" forall (x: Int, y: Int) { x > y }",
    "law \"a positive is at least two\" forall (x: Int) where x > 0 { x > 1 }",
    "law \"doubling is squaring\" forall (x: Int) { twice(x) == x * x }",
    "law \"quadrupling is tripling\" forall (x: Int) { quadruple(x) == 3 * x }",
    "law \"de morgan mangled\" forall (b: Bool, c: Bool) { !(b && c) == (!b && !c) }",
    "law \"a disjunction always holds\" forall (b: Bool, c: Bool) { b || c }",
    "law \"a branch is always the first\" forall (b: Bool, x: Int, y: Int)",
    "  { if b { x } else { y } == x }",
    "law \"any two arguments agree\" forall (f: (Int) -> Int, x: Int, y: Int)",
    "  { f(x) == f(y) }",
    "law \"a field is one more\" forall (x: Int) { { amount: x }.amount == x + 1 }",
    "law \"every weight is one\" forall (s: Shade) { weight(s) == 1 }",
    "law \"weights stop at two\" forall (s: Shade) { weight(s) <= 2 }",
    "law \"ordering skips two\" forall (x: Int, y: Int, z: Int) where x < y && y < z",
    "  { x < z - 2 }",
    "law \"halving round trips\" forall (x: Int) { x / 2 * 2 == x }",
    "",
    "law \"between zero and one\" forall (x: Int) where x > 0 && x < 1 { x == x }",
    "law \"its own successor\" forall (x: Int) where x == x + 1 { x != x }",
    "law \"its own bounded successor\" forall (x: Int) where x < 100 && x == x + 1",
    "  { x != x }",
    "law \"true and false at once\" forall (b: Bool) where b && !b { !b }",
    "law \"one is two\" forall (x: Int) where 1 == 2 { x != x }",
    "law \"two weights at once\" forall (s: Shade) where weight(s) == 1 && weight(s) == 3",
    "  { s == s }",
    "",
    "// `==` at `Float`, at `Decimal` and at a type variable is not identity: false at",
    "// `NaN`, `1.5m == 1.50m` though they print apart, and a variable may be either.",
    "law \"a float equals itself\" forall (x: Float) { x == x }",
    "law \"a float from bits equals itself\" forall (n: Int) { Float::of_bits(n) == Float::of_bits(n) }",
    "law \"any value equals itself\" forall (x: a) { x == x }",
    "fn same<a>(x: a) -> Bool = x == x",
    "law \"a float is itself through a generic call\" forall (n: Int) { same(Float::of_bits(n)) }",
    "law \"equal values are shown alike\" forall (f: (a) -> String, x: a, y: a) { !(x == y) || f(x) == f(y) }",
    "law \"equal decimals print alike\" forall (x: Decimal, y: Decimal)",
    "  { !(x == y) || Decimal::to_string(x) == Decimal::to_string(y) }",
    "law \"a float that equals itself does\" forall (x: Float) where x == x { x == x }",
    "law \"a float from bits is itself or NaN\" forall (n: Int)",
    "  { Float::of_bits(n) == Float::of_bits(n) || Float::of_bits(n) != Float::of_bits(n) }",
    "law \"a float sum commutes\" forall (x: Float, y: Float) { x + y == y + x }",
    "law \"a float is at least itself\" forall (x: Float) { x >= x }",
    "law \"a decimal equals itself\" forall (x: Decimal) { x == x }",
    "law \"two decimal scales are one value\" forall (x: Int) { 1.5m == 1.50m }",
    "law \"two decimals are two values\" forall (x: Int) { 1.5m != 1.6m }",
    "law \"a decimal zero is additive\" forall (x: Decimal) { x + 0m == x }",
  ])

fn clause_binders(f: Fixture, name: String) -> List<Binder> / {abort.raise} =
  match f.built.world.signatures.fold(None, |accumulator: Option<Signature>, s: Signature|
      match accumulator {
        Some(_) -> accumulator,
        None -> if s.name == owner(name) { Some(s) } else { None },
      }) {
    Some(s) -> match canonical(s.ty) {
      FunctionSort(params, return_sort, _) ->
        range(0, params.len() + 1).map(|i: Int|
          {
            name: "_" ++ i.to_string(),
            ty: match params.at(i) { Some(p) -> p, None -> return_sort },
          }),
      _ -> panic("`" ++ name ++ "` is not a function"),
    },
    None -> panic("no signature for " ++ name),
  }

fn definition_of(f: Fixture, name: String) -> Definition / {abort.raise} =
  match f.claims.definitions.get(owner(name)) {
    Some(d) -> d,
    None -> panic("no definition " ++ name),
  }

fn clauses(d: Definition, ensures: Bool) -> List<Option<Code>> =
  d.spec.filter(|c: ClaimClause|
    match c.kind { EnsuresClause -> ensures, RequiresClause -> !ensures, _ -> false }).map(
    |c: ClaimClause| Some(c.clause.code),
  )

fn returns_zero(f: Fixture, name: String) -> Decision / {abort.raise} = {
  let d = definition_of(f, name);
  decide(
    f.context,
    {
      binders: [{ name: "result", ty: int_sort() }],
      guards: [],
      result: Some(d.body),
      body: clauses(d, true).get(0),
      lemmas: [],
      assumed_terminating: [],
      partial: false,
      identities: [],
      contracts: [],
      induction_hypothesis: None,
      builds: None,
      tainted: [],
    },
    default_limits(),
  )
}

fn decide_withdraw_ensures(index: Int) -> Decision / {abort.raise} = {
  let f = fixture(ledger_source());
  let d = definition_of(f, "withdraw");
  decide(
    f.context,
    {
      binders: clause_binders(f, "withdraw"),
      guards: clauses(d, false),
      result: Some(d.body),
      body: clauses(d, true).get(index),
      lemmas: [],
      assumed_terminating: [],
      partial: false,
      identities: [],
      contracts: [],
      induction_hypothesis: None,
      builds: None,
      tainted: [],
    },
    default_limits(),
  )
}

fn spends_its_budget(f: Fixture, label: String, limits: Limits) -> Bool / {abort.raise} =
  match attempt_with(f, label, limits) { Unknown(u) -> u.reason == BudgetSpent, _ -> false }

fn uses_induction_on(p: Proof, binder: String, definition: String) -> Bool =
  p.rules.fold(false, |found: Bool, r: Rule|
    found
      || (match r { Induction(i) -> i.binder == binder && i.definition == definition, _ -> false }))

fn cites(p: Proof, label: String) -> Bool =
  p.rules.fold(false, |found: Bool, r: Rule|
    found || (match r { Cited(c) -> c.label == label, _ -> false }))

fn deepest_unfold(p: Proof) -> Int =
  p.rules.fold(0, |accumulator: Int, r: Rule|
    match r {
      Unfold(u) -> if u.depth > accumulator { u.depth } else { accumulator },
      _ -> accumulator,
    })

test "a constant outside the `Int` range is not proved about, rather than wrapped around" {
  let f = fixture(boundaries());
  assert(not_proved(f, "the largest int"));
  assert(not_proved(f, "the smallest int is smallest"))
}

test "a claim whose coefficient overflows `Int` is not proved" {
  assert(not_proved(fixture(boundaries()), "scaling past the boundary"))
}

test "propositional claims are proved when true and not proved when false" {
  let f = fixture(propositional());
  assert(uses(proof(f, "excluded middle"), Propositional));
  assert(not_proved(f, "a bare disjunction"));
  assert(is_proved(f, "disjunction commutes"));
  assert(is_proved(f, "de morgan"));
  assert(not_proved(f, "de morgan mangled"));
  assert(is_proved(f, "a conditional picks a branch"));
  assert(not_proved(f, "a conditional is not constant"))
}

test "congruence over an uninterpreted function proves true claims and does not prove false ones" {
  let f = fixture(congruence_source());
  assert(uses(proof(f, "a function is a function"), Congruence));
  assert(is_proved(f, "equal arguments agree"));
  assert(not_proved(f, "any two arguments agree"))
}

test "`==` on a variable with no constraints does not prove that equal values behave alike" {
  assert(not_proved(fixture(congruence_source()), "equal values at a variable are taken alike"))
}

test "a proof of a claim about generic types records its type variables, and the result names them `a` and `b`" {
  let p = proof(fixture(congruence_source()), "congruence is polymorphic");
  assert_eq(p.sorts, [0, 1]);
  match to_static_result({ decision: Proved(p), blockers: [] }, ["a", "b"]) {
    Certified(c) -> assert_eq(c.sorts, ["a", "b"]),
    Unwitnessed(c) -> assert_eq(c.sorts, ["a", "b"]),
    _ -> panic("a proof resolves the claim"),
  }
}

test "a record's fields can be read back, and two records are equal when all their fields are equal, but not when only some are" {
  let f = fixture(congruence_source());
  assert(is_proved(f, "a record is its fields"));
  assert(is_proved(f, "records with equal fields are equal"));
  assert(not_proved(f, "records with any fields are equal"))
}

test "a record equals the record rebuilt from all of its fields, but not one rebuilt from only some" {
  let f = fixture(congruence_source());
  assert(uses(proof(f, "a record rebuilt from its own fields is the record"), Congruence));
  assert(is_proved(f, "moving an account and moving it back is the account"));
  assert(not_proved(f, "moving an account leaves it where it was"));
  assert(not_proved(f, "one matching field is enough"));
  assert(not_proved(f, "moving an unbounded account and back is the account"))
}

test "constructor injectivity is proved when true and not proved when false" {
  let f = fixture(shapes_source());
  assert(uses(proof(f, "constructors are injective"), Injectivity));
  assert(not_proved(f, "injective by one"));
  assert(is_proved(f, "a rebuilt value is the same"));
  assert(not_proved(f, "two constructors are not"))
}

test "distinct constructors make a guard vacuous" {
  assert(vacuous(attempt(fixture(shapes_source()), "constructors are distinct")))
}

test "a case split over many constructors proves true claims and does not prove false ones" {
  let f = fixture(rainbow_source());
  assert(uses(proof(f, "every rank is in range"), CaseSplit({ ty: "m.Colour", arms: 8 })));
  assert(not_proved(f, "every rank is small"));
  assert(not_proved(f, "no rank is seven"))
}

test "a non-recursive definition unfolds to the stated depth" {
  let f = fixture(chain());
  assert(deepest_unfold(proof(f, "three unfoldings suffice")) <= default_unfold_depth());
  assert(not_proved(f, "four unfoldings do not"))
}

test "a recursive definition is unfolded only by induction" {
  let f = fixture(chain());
  assert(unfoldable(f.context, "m.countdown") == None);
  assert(unfoldable(f.context, "m.three") != None);
  assert(uses_induction_on(proof(f, "counting down counts"), "n", "m.countdown"));
  assert(uses_induction_on(proof(f, "doubling by recursion"), "n", "m.doubled"));
  assert(not_proved(f, "counting down is not the identity"));
  assert(not_proved(f, "a recursive call is a function"));
  assert(not_proved(f, "a recursive definition steps"));
  assert(not_proved(f, "counting down is never negative"));
  assert(not_proved(f, "a step off the top overflows"))
}

test "a recursive definition over a list is proved by induction on its spine" {
  let f = fixture(spines_source());
  assert(uses_induction_on(proof(f, "counting counts"), "xs", "m.count"));
  assert(not_proved(f, "a total is a total"));
  assert(not_proved(f, "a total of ints is non-negative"));
  assert(not_proved(f, "a definition that keeps its list is not a function"));
  assert(not_proved(f, "counting from an accumulator counts"))
}

test "list patterns over list literals are proved without induction" {
  let f = fixture(spines_source());
  assert(is_proved(f, "a list pattern takes the head of a literal"));
  assert(is_proved(f, "a pushed literal ends in what was pushed"));
  assert(not_proved(f, "a list pattern does not confuse the tail"))
}

test "the prover unrolls only recursion it sees terminate, and accepts a declared measure once a proof shows it decreases" {
  let f = fixture(chain());
  let p = proving(chain());
  let ends_in = |context: Context, name: String|
    match self_recursive(context, name) {
      Some(_) -> terminates(context, name),
      None -> panic("a pure definition calling only itself"),
    };
  assert(ends_in(f.context, "m.countdown"));
  assert(!terminates(f.context, "m.forever"));
  assert(ends_in(f.context, "m.halved"));
  assert(!ends_in(f.context, "m.climb"));
  assert(!ends_in(f.context, "m.lowered"));
  assert(ends_in(p.prover.context, "m.climb"));
  assert(ends_in(p.prover.context, "m.lowered"));
  assert(!ends_in(p.prover.context, "m.stall"));
  assert(not_proved(f, "a measured recursion counts"));
  assert(match decided_by(p, "m.a measured recursion counts") {
    Some(proof) -> uses_induction_on(proof, "n", "m.lowered"),
    None -> false,
  })
}

test "the kernel rejects an induction whose hypothesis is not smaller than the case it proves, even if every case is proved" {
  let f = fixture(chain());
  let counts = law_goal(f, "counting down counts");
  let record = { binder: "n", slot: 0, scheme: Descent(1), definitions: ["m.countdown"] };
  assert(rejection(f.context, counts, record) == None);
  assert(
    match check_induction(
        f.context,
        counts,
        record,
        default_limits(),
        default_prove_budget(),
        [],
      ).proof {
      Some(proof) -> uses_induction_on(proof, "n", "m.countdown"),
      None -> false,
    },
  );
  let false_law = law_goal(f, "every int is at most zero");
  let circular = { ..record, scheme: Descent(0) };
  assert_eq(
    rejection(f.context, false_law, circular),
    Some("the hypothesis must apply to a smaller case than the one it proves"),
  );
  assert(
    check_induction(
        f.context,
        false_law,
        circular,
        default_limits(),
        default_prove_budget(),
        [],
      ).proof
      == None,
  );
  assert_eq(
    rejection(f.context, counts, { ..record, scheme: Spine(1) }),
    Some("`n` is not a list"),
  );
  assert_eq(
    rejection(f.context, counts, { ..record, binder: "k" }),
    Some("the claim's binder at 0 is `n`"),
  );
  assert_eq(
    rejection(f.context, counts, { ..record, slot: 3 }),
    Some("the claim has no binder at 3"),
  );
  assert_eq(
    rejection(f.context, counts, { ..record, definitions: ["m.stall"] }),
    Some("the checker cannot show that every recursive call in `m.stall` has a smaller argument"),
  );
  assert_eq(
    rejection(f.context, counts, { ..record, definitions: ["m.forever"] }),
    Some("`m.forever` has side effects or calls other functions, so induction cannot unfold it"),
  );
  assert_eq(
    rejection(f.context, counts, { ..record, definitions: ["m.ping"] }),
    Some("`m.ping` has side effects or calls other functions, so induction cannot unfold it"),
  );
  assert_eq(
    rejection(f.context, counts, { ..record, definitions: [] }),
    Some("the induction names no recursive definition to unfold"),
  )
}

test "a proof uses each proved `law` declared before it in its module, and no `law` declared after it" {
  let p = proving(spines_source());
  assert(match decided_by(p, "m.a push reversed leads") {
    Some(proof) -> uses_induction_on(proof, "ys", "m.reverse"),
    None -> false,
  });
  assert(match decided_by(p, "m.reverse twice is identity") {
    Some(proof) ->
      uses_induction_on(proof, "xs", "m.reverse") && cites(proof, "a push reversed leads"),
    None -> false,
  });
  assert(decided_by(p, "m.reversing twice, before its lemma") == None);
  assert(match decided_by(p, "m.reversing keeps the length") {
    Some(proof) -> !cites(proof, "a push reversed leads"),
    None -> true,
  })
}

fn over_reverse(law: String) -> String =
  String::unlines([
    "fn reverse(xs: List<Int>) -> List<Int> = match xs { [] -> [], [x, ..rest] -> reverse(rest).push(x) }",
    "law schema involution<a>(f: (a) -> a) forall (xs: a) { f(f(xs)) == xs }",
    "law \"a push reversed leads\" forall (ys: List<Int>, x: Int) { match reverse(ys.push(x)) { [h, ..t] -> h == x && t == reverse(ys), [] -> false } }",
    law,
  ])

test "a `law` made from a `law schema` is proved with the same induction and lemmas as the same `law` written out in full" {
  let made = decided_by(proving(over_reverse("law \"twice\" = involution(reverse)")), "m.twice");
  let written = decided_by(
    proving(over_reverse("law \"twice\" forall (xs: List<Int>) { reverse(reverse(xs)) == xs }")),
    "m.twice",
  );
  assert(match made {
    Some(proof) ->
      uses_induction_on(proof, "xs", "m.reverse") && cites(proof, "a push reversed leads"),
    None -> false,
  });
  assert_eq(made, written)
}

test "a `law` made from a `law schema` is used as a lemma by later claims that contain the schema's body" {
  let p = proving(
    String::unlines([
      "fn reverse(xs: List<Int>) -> List<Int> = match xs { [] -> [], [x, ..rest] -> reverse(rest).push(x) }",
      "law schema leading(f: (List<Int>) -> List<Int>) forall (ys: List<Int>, x: Int) { match f(ys.push(x)) { [h, ..t] -> h == x && t == f(ys), [] -> false } }",
      "law \"a push reversed leads\" = leading(reverse)",
      "law \"reverse twice is identity\" forall (xs: List<Int>) { reverse(reverse(xs)) == xs }",
    ]),
  );
  assert(match decided_by(p, "m.reverse twice is identity") {
    Some(proof) -> cites(proof, "a push reversed leads"),
    None -> false,
  })
}

fn near_misses_source() -> String =
  String::unlines([
    "fn reverse(xs: List<Int>) -> List<Int> = match xs { [] -> [], [x, ..rest] -> reverse(rest).push(x) }",
    "law \"a push reversed leads\" forall (ys: List<Int>, x: Int) { match reverse(ys.push(x)) { [h, ..t] -> h == x && t == reverse(ys), [] -> false } }",
    "law \"reversing changes nothing\" forall (xs: List<Int>) { reverse(xs) == xs }",
    "law \"a push reversed leads with zero\" forall (ys: List<Int>, x: Int) { match reverse(ys.push(x)) { [h, ..t] -> h == 0, [] -> false } }",
    "law \"reverse twice drops a push\" forall (xs: List<Int>) { reverse(reverse(xs.push(1))) == xs }",
    "law \"a one-element list matches two\" forall (x: Int) { match [x] { [] -> true, [a, b] -> true, _ -> x == 0 } }",
    "law \"a known constructor takes its own arm\" forall (x: Int) { match Some(x) { None -> true, Some(y) -> y == 0 } }",
    "law \"a push keeps the length\" forall (xs: List<Int>, x: Int) { xs.push(x).len() == xs.len() }",
  ])

test "the prover never proves a false claim that resembles a lemma, a list pattern match or a known constructor match" {
  let p = proving(near_misses_source());
  assert(decided_by(p, "m.a push reversed leads") != None);
  assert(decided_by(p, "m.reversing changes nothing") == None);
  assert(decided_by(p, "m.a push reversed leads with zero") == None);
  assert(decided_by(p, "m.reverse twice drops a push") == None);
  assert(decided_by(p, "m.a one-element list matches two") == None);
  assert(decided_by(p, "m.a known constructor takes its own arm") == None);
  assert(decided_by(p, "m.a push keeps the length") == None)
}

test "a measure is proved only when every call back into its recursive group decreases" {
  let p = proving(chain());
  let missing = unproved_measures(p.analysis, prover_input::every);
  assert_eq(missing.map(|u: UnprovedMeasure| u.measure.owner), ["m.halved", "m.stall", "m.tick"]);
  assert_eq(missing.map(|u: UnprovedMeasure| u.descends), [true, false, false]);
  assert(terminates(p.prover.context, "m.up") && terminates(p.prover.context, "m.across"));
  assert(match p.prover.context.claims.definitions.get("m.tock") {
    Some(d) -> d.stated,
    None -> false,
  });
  assert(!terminates(p.prover.context, "m.tock"))
}

type Proving = { prover: Prover, built: ProverInputResult, analysis: Analysis }

fn proving(source: String) -> Proving / {abort.raise} =
  proving_all([{ name: b"m", source_text: Bytes::of_string(source) }])

fn proving_all(sources: List<{ name: Bytes, source_text: Bytes }>) -> Proving / {abort.raise} =
  match analyse(parse_all(sources)) {
    Rejected(_) -> panic("the test source was rejected by the checker"),
    Analysed(w) -> {
      let built = prover_input_of(w, prover_input::every);
      {
        prover: prover_of(claims_of(claims(sources)), built.world, default_prove_budget()),
        built: built,
        analysis: w,
      }
    },
  }

fn proof_of(p: Proving, pick: (Obligation) -> Bool) -> Option<Proof> / {abort.raise} =
  match p.built.world.obligations.fold(None, |found: Option<Obligation>, o: Obligation|
      match found { Some(_) -> found, None -> if pick(o) { Some(o) } else { None } }) {
    None -> panic("no such obligation"),
    Some(o) -> match static_prover::diagnosis_of(p.prover, o) {
      Some(d) -> match d.decision { Proved(pr) -> Some(pr), _ -> None },
      None -> None,
    },
  }

fn decided_by(p: Proving, owner: String) -> Option<Proof> / {abort.raise} =
  proof_of(p, |o: Obligation| o.owner == owner)

test "induction needs a self call whose argument decreases by exactly one" {
  let f = fixture(chain());
  assert(not_proved(f, "a definition that never returns is not a function"));
  assert(not_proved(f, "a mutual recursion is not unrolled"));
  assert(not_proved(f, "stepping by two counts"))
}

test "two calls to an effectful definition are not proved to return the same value" {
  let f = fixture(effectful_source());
  assert(match returns_zero(f, "difference") { Proved(_) -> false, _ -> true });
  assert(match returns_zero(f, "once") { Proved(_) -> true, _ -> false })
}

test "an effectful definition is never unfolded" {
  assert(unfoldable(fixture(effectful_source()).context, "m.shout") == None)
}

test "a match on literals proves true claims and does not prove false ones" {
  let f = fixture(matching());
  assert(is_proved(f, "flipping twice is identity"));
  assert(not_proved(f, "flipping once is identity"))
}

test "an `if` expression proves true claims and does not prove false ones" {
  let f = fixture(matching());
  assert(is_proved(f, "a bounded absolute is non negative"));
  assert(not_proved(f, "absolute is non negative"));
  assert(not_proved(f, "absolute is positive"))
}

test "a match on constructors proves true claims and does not prove false ones" {
  let f = fixture(matching());
  assert(is_proved(f, "swapping twice is identity"));
  assert(not_proved(f, "swapping once is identity"));
  assert(is_proved(f, "left of a swap"))
}

test "a postcondition over a definition is proved when it holds and not proved when it fails" {
  assert(match decide_withdraw_ensures(0) { Proved(_) -> true, _ -> false });
  assert(match decide_withdraw_ensures(1) { Proved(_) -> true, _ -> false });
  assert(match decide_withdraw_ensures(2) { Proved(_) -> false, _ -> true })
}

test "a postcondition without the definition is unknown" {
  let f = fixture(ledger_source());
  let d = definition_of(f, "withdraw");
  let decision = decide(
    f.context,
    {
      binders: clause_binders(f, "withdraw"),
      guards: [],
      result: None,
      body: clauses(d, true).get(0),
      lemmas: [],
      assumed_terminating: [],
      partial: false,
      identities: [],
      contracts: [],
      induction_hypothesis: None,
      builds: None,
      tainted: [],
    },
    default_limits(),
  );
  assert(match decision { Proved(_) -> false, _ -> true })
}

test "a spent budget is unknown and never proved" {
  let f = fixture(hard());
  assert(spends_its_budget(f, "four bits are bounded", { ..default_limits(), steps: 20 }));
  assert(is_proved(f, "four bits are bounded"))
}

test "an obligation larger than the default budget is unknown" {
  let f = fixture(hard());
  assert(spends_its_budget(f, "five bits are bounded", default_limits()));
  assert(match attempt_with(f, "five bits are bounded", { ..default_limits(), steps: 100000 }) {
    Proved(_) -> true,
    _ -> false,
  })
}

test "a decision is a function of the obligation" {
  let f = fixture(rainbow_source());
  assert_eq(attempt(f, "every rank is in range"), attempt(f, "every rank is in range"))
}

test "a proof is certified only if at least one value satisfies the claim's `where` guard, so the claim is not vacuous" {
  let f = fixture(guarded());
  let g = proof(f, "a guard nothing establishes");
  assert(!g.guard_satisfiable);
  assert(match to_static_result({ decision: Proved(g), blockers: [] }, []) {
    Unwitnessed(_) -> true,
    _ -> false,
  });
  let u = proof(f, "an unguarded claim");
  assert(u.guard_satisfiable);
  assert(match to_static_result({ decision: Proved(u), blockers: [] }, []) {
    Certified(_) -> true,
    _ -> false,
  })
}

test "an uninhabited domain does not establish satisfiability" {
  let p = proof(fixture(uninhabited_source()), "anything about nothing");
  assert(!p.guard_satisfiable);
  assert(match to_static_result({ decision: Proved(p), blockers: [] }, []) {
    Unwitnessed(_) -> true,
    _ -> false,
  })
}

test "list literals are injective, and lists of different lengths are never equal" {
  let f = fixture(lists());
  assert(is_proved(f, "list literals are injective"));
  assert(not_proved(f, "list literals are injective by one"));
  assert(vacuous(attempt(f, "lists of different lengths differ")))
}

test "a nested pattern leaves the match uninterpreted" {
  let f = fixture(opaque_source());
  assert(not_proved(f, "a nested pattern is not decided"));
  assert(is_proved(f, "a nested pattern is still a function"))
}

type Truth = | Valid | Partial | Refutable | Vacuous

fn audit() -> List<{ label: String, truth: Truth }> = {
  let valid = [
    "identity of addition",
    "bounded addition commutes",
    "bounded addition associates",
    "self subtraction is zero",
    "bounded negation is subtraction",
    "bounded doubling scales",
    "bounded quadrupling scales",
    "a positive is at least one",
    "at least one is positive",
    "antisymmetry",
    "strictness is asymmetric",
    "multiplication commutes",
    "a square is not negative",
    "de morgan for conjunction",
    "de morgan for disjunction",
    "double negation",
    "a disjunct is implied",
    "a branch is one of two",
    "a function is a function",
    "equal arguments agree",
    "a field is what was put in it",
    "every weight is positive",
    "no weight is four",
    "a decimal equals itself",
    "two decimal scales are one value",
    "two decimals are two values",
    "a decimal zero is additive",
    "a float that equals itself does",
    "a float from bits is itself or NaN",
  ];
  let partial = [
    "addition commutes",
    "addition associates",
    "negation is subtraction",
    "doubling scales",
    "quadrupling scales",
    "its own successor",
  ];
  let refutable = [
    "successor is identity",
    "everything is ordered one way",
    "a positive is at least two",
    "doubling is squaring",
    "quadrupling is tripling",
    "de morgan mangled",
    "a disjunction always holds",
    "a branch is always the first",
    "any two arguments agree",
    "a field is one more",
    "every weight is one",
    "weights stop at two",
    "ordering skips two",
    "halving round trips",
    "a float equals itself",
    "a float sum commutes",
    "a float is at least itself",
    "a float from bits equals itself",
    "any value equals itself",
    "a float is itself through a generic call",
    "equal values are shown alike",
    "equal decimals print alike",
  ];
  let vacuous_ones = [
    "between zero and one",
    "its own bounded successor",
    "true and false at once",
    "one is two",
    "two weights at once",
  ];
  let tagged = |labels: List<String>, t: Truth| labels.map(|l: String| { label: l, truth: t });
  tagged(valid, Valid).concat(tagged(partial, Partial)).concat(tagged(refutable, Refutable)).concat(
    tagged(vacuous_ones, Vacuous),
  )
}

test "no false claim is proved, and no valid claim is reported as vacuous" {
  let f = fixture(audit_program());
  let wrong = audit().filter(|e: { label: String, truth: Truth }| {
    let d = attempt(f, e.label);
    match e.truth {
      Valid -> vacuous(d),
      Partial -> match d { Unknown(_) -> false, _ -> true },
      Refutable -> match d { Unknown(_) -> false, _ -> true },
      Vacuous -> match d { Proved(_) -> true, _ -> false },
    }
  });
  assert_eq(wrong.map(|e: { label: String, truth: Truth }| e.label), [])
}

test "the prover proves the audit's valid claims except multiplication commutes, a square is not negative and decimal zero, and detects every vacuous claim" {
  let f = fixture(audit_program());
  let undecided = audit().filter(|e: { label: String, truth: Truth }|
    e.truth == Valid && (match attempt(f, e.label) { Proved(_) -> false, _ -> true }));
  assert_eq(undecided.map(|e: { label: String, truth: Truth }| e.label), [
    "multiplication commutes",
    "a square is not negative",
    "a decimal zero is additive",
  ]);
  let missed = audit().filter(|e: { label: String, truth: Truth }|
    e.truth == Vacuous && !vacuous(attempt(f, e.label)));
  assert_eq(missed.map(|e: { label: String, truth: Truth }| e.label), [])
}

fn bits() -> String =
  String::unlines([
    "law \"a mask is a function\" forall (x: Int, y: Int) { x & y == x & y }",
    "law \"a complement is a function\" forall (x: Int) { ~x == ~x }",
    "law \"a masked value is a value\" forall (x: Int, y: Int) where x & y > 0 { x & y > 0 }",
    "",
    "law \"a mask is its left operand\" forall (x: Int, y: Int) { x & y == x }",
    "law \"a mask is no larger than what it masks\" forall (x: Int, y: Int) { x & y <= x }",
    "law \"a left shift is a doubling\" forall (x: Int) where x > 0 { x << 1 > x }",
    "law \"a complement is a bounded negation\" forall (x: Int) where x > 0 && x < 100",
    "  { ~x == 0 - x }",
    "",
    "law \"and is or\" forall (x: Int, y: Int) { x & y == x | y }",
    "law \"xor is and\" forall (x: Int, y: Int) { x ^ y == x & y }",
    "law \"the right shifts agree\" forall (x: Int, n: Int) where n >= 0 && n <= 63",
    "  { x >> n == x >>> n }",
    "",
    "law \"a shift is a function\" forall (x: Int, n: Int) { x << n == x << n }",
    "law \"a bounded shift is a function\" forall (x: Int, n: Int) where n >= 0 && n <= 63",
    "  { x << n == x << n }",
    "law \"a shift by the last bit is a function\" forall (x: Int) { x >>> 63 == x >>> 63 }",
    "law \"a shift past the last bit is a function\" forall (x: Int) { x >>> 64 == x >>> 64 }",
    "law \"a shift by a negative is a function\" forall (x: Int) { x >> -1 == x >> -1 }",
    "",
    "law \"masking commutes\" forall (x: Int, y: Int) { x & y == y & x }",
    "law \"a complement is an involution\" forall (x: Int) { ~(~x) == x }",
  ])

fn floats() -> String =
  String::unlines([
    "law \"a float equals itself\" forall (x: Float) { x == x }",
    "law \"a float sum commutes\" forall (x: Float, y: Float) { x + y == y + x }",
    "law \"a float is at least itself\" forall (x: Float) { x >= x }",
    "law \"a float zero is additive\" forall (x: Float) { x + 0.0 == x }",
    "law \"a float in a record\" forall (r: {rate: Float}) { r == r }",
    "law \"a float below another is not above it\" forall (x: Float, y: Float) where x < y { x > y }",
    "",
    "law \"one point five is one point five\" forall (n: Int) { 1.5 == 1.5 }",
    "law \"a float in a list\" forall (xs: List<Float>) { xs.len() >= 0 }",
    "fn half() -> Float = 0.5",
    "law \"a float from a call\" forall (n: Int) { half() == half() }",
    "law \"a float equals itself or is NaN\" forall (x: Float) { x == x || x != x }",
    "law \"a float that equals itself is at least itself\" forall (x: Float) where x == x { x >= x }",
    "law \"no float is below itself\" forall (x: Float) { !(x < x) }",
    "law \"the zeros are equal\" forall (n: Int) { -0.0 == 0.0 }",
    "law \"a sum of literals is its rounding\" forall (n: Int) { 0.1 + 0.2 == 0.30000000000000004 }",
    "law \"the order is transitive\" forall (x: Float, y: Float, z: Float) where x < y && y < z { x < z }",
    "fn clamped(x: Float) -> Float = if x >= 0.0 { if x <= 1.0 { x } else { 1.0 } } else { 0.0 }",
    "fn clamped_naively(x: Float) -> Float = if x < 0.0 { 0.0 } else if x > 1.0 { 1.0 } else { x }",
    "law \"a clamp lands in its range\" forall (x: Float) { clamped(x) >= 0.0 && clamped(x) <= 1.0 }",
    "law \"a naive clamp lands in its range\" forall (x: Float) { clamped_naively(x) >= 0.0 }",
    "type Node = | Node({ visits: Int, reward: Float })",
    "fn leaf() -> Node = Node({ visits: 0, reward: 0.0 })",
    "fn visits(n: Node) -> Int = match n { Node(d) -> d.visits }",
    "fn credited(n: Node, r: Float) -> Node = match n { Node(d) -> Node({ visits: d.visits + 1, reward: d.reward + r }) }",
    "law \"a leaf has no visits\" forall (n: Int) { visits(leaf()) == 0 }",
    "law \"crediting a leaf visits it once\" forall (r: Float) { visits(credited(leaf(), r)) == 1 }",
    "fn scale(x: Float, k: Float) -> Float = x * k",
    "law \"scaling by one changes nothing\" forall (x: Float) { scale(x, 1.0) == x }",
    "law \"nothing is both above and below itself\" forall (x: Float) { !(x < x && x > x) }",
    "law \"two floats are ordered one way\" forall (x: Float, y: Float) where x < y { !(y < x) }",
  ])

fn decimals() -> String =
  String::unlines([
    "fn scaled(d: Decimal) -> Decimal = d",
    "fn wrap(d: Decimal) -> { amount: Decimal } = { amount: d }",
    "",
    "law \"a decimal equals itself\" forall (x: Decimal) { x == x }",
    "law \"congruence over a decimal\" forall (x: Decimal) { scaled(x) == scaled(x) }",
    "law \"a decimal inside a record\" forall (x: Decimal) { wrap(x) == wrap(x) }",
    "law \"a decimal literal is itself\" forall (n: Int) { 1.5m == 1.5m }",
    "law \"two scales are one value\" forall (n: Int) { 1.5m == 1.50m }",
    "law \"two values are two values\" forall (n: Int) { 1.5m == 1.6m }",
    "",
    "law \"a decimal zero is additive\" forall (x: Decimal) { x + 0m == x }",
    "law \"a decimal sum commutes\" forall (x: Decimal, y: Decimal) { x + y == y + x }",
    "law \"a decimal is at least itself\" forall (x: Decimal) { x >= x }",
  ])

fn unused_float_program() -> String =
  String::unlines([
    "law \"an int is itself, beside a float\" forall (x: Int, unused: Float) { x == x }",
  ])

fn an_int_is_itself() -> String =
  String::unlines(["law \"an int is itself\" forall (x: Int) { x == x }"])

fn int_zero() -> String =
  String::unlines([
    "law \"an int zero is additive\" forall (x: Int) where x > 0 && x < 100 { x + 0 == x }",
  ])

fn decimal_zero() -> String =
  String::unlines(["law \"a decimal zero is additive\" forall (x: Decimal) { x + 0m == x }"])

fn prelude_adts() -> String =
  String::unlines([
    "fn or_else(o: Option<Int>, d: Int) -> Int = match o { None -> d, Some(v) -> v }",
    "fn direction(o: Ordering) -> Int = match o { Less -> -1, Equal -> 0, Greater -> 1 }",
    "law \"or_else is a function\" forall (o: Option<Int>, d: Int)",
    "  { or_else(o, d) == or_else(o, d) }",
    "law \"a direction is one of three\" forall (o: Ordering)",
    "  { direction(o) == -1 || direction(o) == 0 || direction(o) == 1 }",
  ])

fn destructured() -> String =
  String::unlines([
    "fn rates() -> { a: Float, b: Float } = { a: 1.0, b: 2.0 }",
    "fn ints() -> { a: Int, b: Int } = { a: 1, b: 2 }",
    "",
    "law \"a destructured float sum commutes\" forall (n: Int) {",
    "  let { a: x, b: y } = rates();",
    "  x + y == y + x",
    "}",
    "law \"a destructured int sum commutes\" forall (n: Int) {",
    "  let { a: x, b: y } = ints();",
    "  x + y == y + x",
    "}",
    "law \"a matched float sum commutes\" forall (n: Int) {",
    "  match rates() { { a: x, b: y } -> x + y == y + x }",
    "}",
  ])

fn blocked_by(f: Fixture, label: String, b: Blocker) -> Bool / {abort.raise} =
  diagnosed(f, label).blockers.fold(false, |found: Bool, x: Blocker| found || x == b)

test "no bit operator is treated as integer arithmetic" {
  let f = fixture(bits());
  assert(
    [
      "a mask is its left operand",
      "a mask is no larger than what it masks",
      "a left shift is a doubling",
      "a complement is a bounded negation",
    ].fold(true, |ok: Bool, l: String| ok && not_proved(f, l)),
  )
}

test "the seven bit operators are separate functions and are not proved equal to each other" {
  let f = fixture(bits());
  assert(not_proved(f, "and is or"));
  assert(not_proved(f, "xor is and"));
  assert(not_proved(f, "the right shifts agree"))
}

test "a bit operator is a function of its operands" {
  let f = fixture(bits());
  assert(is_proved(f, "a mask is a function"));
  assert(is_proved(f, "a complement is a function"));
  assert(is_proved(f, "a masked value is a value"))
}

test "a shift is proved well-defined only when its shift amount is between zero and the last bit position" {
  let f = fixture(bits());
  assert(not_proved(f, "a shift is a function"));
  assert(is_proved(f, "a bounded shift is a function"));
  assert(is_proved(f, "a shift by the last bit is a function"));
  assert(not_proved(f, "a shift past the last bit is a function"));
  assert(not_proved(f, "a shift by a negative is a function"))
}

test "true claims about bitwise masking and complement are not proved, and the blocker reported is the bit operator" {
  let f = fixture(bits());
  assert(
    ["masking commutes", "a complement is an involution"].fold(true, |ok: Bool, l: String|
      ok && (match diagnosed(f, l).decision { Proved(_) -> false, _ -> true })
        && blocked_by(f, l, BitOperator)),
  )
}

test "a claim about floats is proved only when it holds for every float, including NaN" {
  let f = fixture(floats());
  assert(
    [
      "a float equals itself",
      "a float sum commutes",
      "a float is at least itself",
      "a float zero is additive",
      "a float in a record",
      "a float below another is not above it",
      "a naive clamp lands in its range",
      "scaling by one changes nothing",
    ].fold(true, |ok: Bool, l: String| ok && not_proved(f, l)),
  );
  assert_eq(
    [
      "nothing is both above and below itself",
      "two floats are ordered one way",
      "one point five is one point five",
      "a float in a list",
      "a float from a call",
      "a float equals itself or is NaN",
      "a float that equals itself is at least itself",
      "no float is below itself",
      "the zeros are equal",
      "a sum of literals is its rounding",
      "the order is transitive",
      "a clamp lands in its range",
    ].filter(|l: String| !is_proved(f, l)),
    [],
  )
}

test "a value containing a float is proved about like any other value" {
  let f = fixture(floats());
  assert(is_proved(f, "a leaf has no visits"));
  assert(is_proved(f, "crediting a leaf visits it once"))
}

test "an unused float variable next to a claim does not stop the claim from being proved" {
  assert(is_proved(fixture(unused_float_program()), "an int is itself, beside a float"))
}

test "the same claim without a float is still proved" {
  assert(is_proved(fixture(an_int_is_itself()), "an int is itself"))
}

test "a decimal is provable as an uninterpreted term" {
  let f = fixture(decimals());
  assert(is_proved(f, "a decimal equals itself"));
  assert(is_proved(f, "congruence over a decimal"));
  assert(is_proved(f, "a decimal inside a record"));
  assert(is_proved(f, "a decimal literal is itself"))
}

test "decimals written with different scales are equal, but decimals with different values are not" {
  let f = fixture(decimals());
  assert(is_proved(f, "two scales are one value"));
  assert(not_proved(f, "two values are two values"))
}

test "equal decimals are not proved to convert to the same string" {
  let f = fixture(
    String::unlines([
      "law \"equal decimals print alike\" forall (x: Decimal, y: Decimal) {",
      "  !(x == y) || Decimal::to_string(x) == Decimal::to_string(y)",
      "}",
      "law \"literals of one value print alike\" forall (n: Int) {",
      "  Decimal::to_string(1.5m) == Decimal::to_string(1.50m)",
      "}",
      "law \"a decimal prints as itself\" forall (x: Decimal) { Decimal::to_string(x) == Decimal::to_string(x) }",
    ]),
  );
  assert(not_proved(f, "equal decimals print alike"));
  assert(not_proved(f, "literals of one value print alike"));
  assert(is_proved(f, "a decimal prints as itself"))
}

test "claims about decimal arithmetic and ordering are not proved" {
  let f = fixture(decimals());
  assert(not_proved(f, "a decimal zero is additive"));
  assert(not_proved(f, "a decimal sum commutes"));
  assert(not_proved(f, "a decimal is at least itself"))
}

test "decimal arithmetic is reported as the reason a decimal claim is not proved" {
  let f = fixture(decimals());
  assert(blocked_by(f, "a decimal zero is additive", DecimalArithmetic));
  assert(!blocked_by(f, "a decimal equals itself", DecimalArithmetic))
}

test "the prover proves that adding an `Int` zero changes nothing, but does not prove it for a decimal zero" {
  assert(is_proved(fixture(int_zero()), "an int zero is additive"));
  assert(not_proved(fixture(decimal_zero()), "a decimal zero is additive"))
}

test "a prelude sum type is a case analysis like any other" {
  let f = fixture(prelude_adts());
  assert(is_proved(f, "or_else is a function"));
  assert(is_proved(f, "a direction is one of three"))
}

test "a destructuring reads the fields it names" {
  let f = fixture(destructured());
  assert(is_proved(f, "a destructured float sum commutes"));
  assert(is_proved(f, "a matched float sum commutes"));
  assert(is_proved(f, "a destructured int sum commutes"))
}

fn keyed_source() -> String =
  String::unlines([
    "type Length = | Metres(Int) | Millimetres(Int)",
    "key for Length by millimetres",
    "fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }",
    "fn in_metres(l: Length) -> Bool = match l { Metres(_) -> true, Millimetres(_) -> false }",
    "type Held = | Held(Length)",
    "type Plain = | Plain(Int)",
    "fn number(p: Plain) -> Int = match p { Plain(n) -> n }",
    "",
    "law \"constructors that differ are unequal\" forall (n: Int) { Metres(n) != Millimetres(n) }",
    "law \"equal `Length` values give the same `in_metres` result\" forall (a: Length, b: Length) { !(a == b) || in_metres(a) == in_metres(b) }",
    "law \"a length equals itself\" forall (a: Length) { a == a }",
    "law \"a held length equals itself\" forall (h: Held) { h == h }",
    "law \"a list of lengths has a length\" forall (xs: List<Length>) { xs.len() >= 0 }",
    "law \"equal plains hold one number\" forall (a: Plain, b: Plain) { !(a == b) || number(a) == number(b) }",
    "",
    "type Tag = | Tag(Int, String)",
    "key for Tag by number_of",
    "fn number_of(t: Tag) -> Int = match t { Tag(n, _) -> n }",
    "fn label(t: Tag) -> String = match t { Tag(_, s) -> s }",
    "law \"a tag equals itself\" forall (t: Tag) { t == t }",
    "law \"tags of one number are equal\" forall (n: Int, a: String, b: String) { Tag(n, a) == Tag(n, b) }",
    "law \"equal tags are labelled alike\" forall (x: Tag, y: Tag) { !(x == y) || label(x) == label(y) }",
    "",
    "fn whole(l: Length) -> Length = Millimetres(millimetres(l))",
    "law schema settles<a>(f: (a) -> a) forall (x: a) { f(f(x)) == f(x) }",
    "law \"a whole length is whole, written out\" forall (x: Length) { whole(whole(x)) == whole(x) }",
    "law \"a whole length is whole, by its schema\" = settles(whole)",
    "law \"a plain is itself, by its schema\" = settles(|p: Plain| p)",
  ])

test "values compared by a key are proved equal only through the equality of their keys" {
  let f = fixture(keyed_source());
  assert(not_proved(f, "constructors that differ are unequal"));
  assert(not_proved(f, "equal `Length` values give the same `in_metres` result"));
  assert(not_proved(f, "a length equals itself"));
  assert(not_proved(f, "a held length equals itself"));
  assert(not_proved(f, "equal tags are labelled alike"));
  assert_eq(
    [
      "a tag equals itself",
      "tags of one number are equal",
      "a list of lengths has a length",
      "equal plains hold one number",
    ].filter(|l: String| !is_proved(f, l)),
    [],
  )
}

test "`+` and `-` on a type with a custom `numeric` implementation use that implementation, not integer arithmetic" {
  let f = fixture(
    String::unlines([
      "type W = | W(Int)",
      "numeric for W by { add: first, sub: first, mul: first, neg: same, of_int: of }",
      "fn first(a: W, b: W) -> W = a",
      "fn same(a: W) -> W = a",
      "fn of(n: Int) -> W = W(n)",
      "law \"adding commutes\" forall (a: W, b: W) { a + b == b + a }",
      "law \"a difference of itself is itself\" forall (a: W) { a - a == a }",
      "law \"the integers' adding commutes\" forall (a: Int, b: Int) where a > 0 && a < 9 && b > 0 && b < 9 { a + b == b + a }",
    ]),
  );
  assert(not_proved(f, "adding commutes"));
  assert(is_proved(f, "a difference of itself is itself"));
  assert(is_proved(f, "the integers' adding commutes"))
}

test "a generic law applied to a type with a key is proved exactly when the same law written out for it is proved, with the same failure reasons" {
  let f = fixture(keyed_source());
  let written = diagnosed(f, "a whole length is whole, written out");
  let made = diagnosed(f, "a whole length is whole, by its schema");
  assert_eq(
    is_proved(f, "a whole length is whole, by its schema"),
    is_proved(f, "a whole length is whole, written out"),
  );
  assert_eq(made.blockers, written.blockers);
  assert(is_proved(f, "a plain is itself, by its schema"))
}

fn higher() -> String =
  String::unlines([
    "fn twice(f: (Int) -> Int, x: Int) -> Int = f(f(x))",
    "fn has(xs: List<Int>, k: Int) -> Bool = match xs { [] -> false, [x, ..rest] -> x == k || has(rest, k) }",
    "",
    "law \"a lambda applied\" forall (x: Int) where x > -100 && x < 100 { (|y: Int| y + 1)(x) == x + 1 }",
    "law \"a lambda handed on and applied twice\" forall (x: Int) where x > -100 && x < 100 {",
    "  twice(|y: Int| y + 1, x) == x + 2",
    "}",
    "law \"a captured value is read where the lambda runs\" forall (x: Int, k: Int) where x > -100 && x < 100 && k > -100 && k < 100 {",
    "  twice(|y: Int| y + k, x) == x + k + k",
    "}",
    "law \"a mapped literal keeps its length\" forall (p: Int) where p > -100 && p < 100 {",
    "  [1, 2, 3].map(|x: Int| x + p).len() == 3",
    "}",
    "law \"a map reads each element\" forall (p: Int) where p > -100 && p < 100 {",
    "  [1, 2].map(|x: Int| x + p) == [1 + p, 2 + p]",
    "}",
    "law \"a fold over a literal\" forall (p: Int) where p > -100 && p < 100 {",
    "  [1, 2, 3].fold(p, |a: Int, x: Int| a + x) == p + 6",
    "}",
    "law \"a filter keeps what it is asked to\" forall (p: Int) where p > 0 && p < 100 {",
    "  [p, 0 - p].filter(|x: Int| x > 0) == [p]",
    "}",
    "law \"a map keeps its length\" forall (xs: List<Int>) { xs.map(|x: Int| x).len() == xs.len() }",
    "law \"a recursion over a literal runs\" forall (k: Int) where k == 2 || k == 3 { has([1, 2, 3], k) }",
    "",
    "law \"a map does not read as its function's identity\" forall (p: Int) where p > -100 && p < 100 {",
    "  [1, 2].map(|x: Int| x + p) == [1, 2]",
    "}",
    "law \"a fold that may overflow\" forall (p: Int) { [1, 2, 3].fold(p, |a: Int, x: Int| a + x) == p + 6 }",
    "law \"a recursion over a literal returns what it does\" forall (k: Int) where k == 4 { has([1, 2, 3], k) }",
  ])

test "a lambda is proved by applying it where it is called, and list functions are proved over a literal list" {
  let f = fixture(higher());
  assert_eq(
    [
      "a lambda applied",
      "a lambda handed on and applied twice",
      "a captured value is read where the lambda runs",
      "a mapped literal keeps its length",
      "a map reads each element",
      "a fold over a literal",
      "a filter keeps what it is asked to",
      "a map keeps its length",
      "a recursion over a literal runs",
    ].filter(|l: String| !is_proved(f, l)),
    [],
  );
  assert(not_proved(f, "a map does not read as its function's identity"));
  assert(not_proved(f, "a fold that may overflow"));
  assert(not_proved(f, "a recursion over a literal returns what it does"))
}

fn first_or_zero() -> String =
  String::unlines([
    "fn first_or_zero(xs: List<Int>) -> Int ensures result >= 0 || xs.len() > 0 = match xs { [] -> 0, [x, ..] -> x }",
    "law \"a cell is no empty list\" forall (xs: List<Int>) { match xs { [] -> true, [_, ..] -> xs.len() > 0 } }",
  ])

test "a list matched as a head and a tail is proved to have a length of at least one" {
  let f = fixture(first_or_zero());
  assert(is_proved(f, "a cell is no empty list"))
}

fn counted_source() -> String =
  String::unlines([
    "fn steps(n: Int) -> Int requires n >= 0 && n < 1000 ensures result >= 0 && result <= n =",
    "  if n <= 0 { 0 } else { 1 + steps(n - 1) }",
    "fn both(n: Int) -> Int requires n >= 0 && n < 1000 ensures result >= 0 = steps(n) + steps(n)",
    "fn unbounded(n: Int) -> Int requires n >= 0 && n < 1000 ensures result >= 0 = steps(n + 1000)",
    "fn wrong(n: Int) -> Int requires n >= 0 && n < 1000 ensures result >= 1 =",
    "  if n <= 0 { 0 } else { 1 + wrong(n - 1) }",
    "fn uncounted(n: Int) -> Int = if n <= 0 { 0 } else { 1 + uncounted(n - 1) }",
    "fn leaning(n: Int) -> Int requires n >= 0 && n < 1000 ensures result >= 0 = uncounted(n)",
  ])

test "a proof uses a callee's contract only when that contract is itself proved" {
  let p = proving(counted_source());
  assert(decided_by(p, "m.steps") != None);
  assert(decided_by(p, "m.both") != None);
  assert(decided_by(p, "m.unbounded") == None);
  assert(decided_by(p, "m.wrong") == None);
  assert(decided_by(p, "m.leaning") == None)
}

fn identities() -> String =
  String::unlines([
    "law \"a value is itself, at identity\" forall (x: a) where identity(a) { x == x }",
    "law \"a value is itself\" forall (x: a) { x == x }",
    "law \"equal values are taken alike, at identity\" forall (g: (a) -> b, u: a, v: a) where identity(a), identity(b), u == v {",
    "  g(u) == g(v)",
    "}",
  ])

test "an `identity` constraint on a type variable makes `==` on it reflexive, and without the constraint it is not" {
  let f = fixture(identities());
  assert(is_proved(f, "a value is itself, at identity"));
  assert(is_proved(f, "equal values are taken alike, at identity"));
  assert(not_proved(f, "a value is itself"))
}

test "a law over a type variable constrained by `identity` is not used as a lemma for `Float`" {
  let p = proving(
    String::unlines([
      "fn keep<a>(x: a, n: Int) -> a = if n <= 0 { x } else { keep(x, n - 1) }",
      "law \"keeping is itself\" forall (x: a, n: Int) where identity(a) { keep(x, n) == x }",
      "law \"at an int\" forall (k: Int, n: Int) { keep(k, n) == k }",
      "law \"at a float\" forall (r: Float, n: Int) { keep(r, n) == r }",
    ]),
  );
  assert(match decided_by(p, "m.at an int") {
    Some(proof) -> cites(proof, "keeping is itself"),
    None -> false,
  });
  assert(decided_by(p, "m.at a float") == None)
}

fn balances_source() -> String =
  String::unlines([
    "pub opaque type Balance = | Balance(Int)",
    "invariant for Balance by solvent",
    "fn solvent(b: Balance) -> Bool = match b { Balance(n) -> n >= 0 }",
    "pub fn opened() -> Balance = Balance(0)",
    "pub fn deposited(b: Balance, n: Int) -> Balance =",
    "  match b { Balance(m) -> if n >= 0 && n < 1000 && m < 1000000 { Balance(m + n) } else { b } }",
    "pub fn overdrawn(b: Balance) -> Balance = match b { Balance(m) -> if m > 0 { Balance(m - 1) } else { Balance(0 - 1) } }",
    "pub fn amount(b: Balance) -> Int = match b { Balance(n) -> n }",
    "law \"a balance is never negative\" forall (b: Balance) { amount(b) >= 0 }",
  ])

test "a value that a module constructs with an invariant type needs a proof of the invariant, and a value it only matches on needs none" {
  let p = proving(balances_source());
  assert(proof_of(p, builds("m.opened")) != None);
  assert(proof_of(p, builds("m.deposited")) != None);
  assert(proof_of(p, builds("m.overdrawn")) == None);
  assert(!p.built.world.obligations.any(builds("m.amount")));
  assert(decided_by(p, "m.a balance is never negative") != None)
}

fn builds(owner: String) -> (Obligation) -> Bool =
  |o: Obligation| o.owner == owner && (match o.kind { Builds(_) -> true, _ -> false })

test "a law about one type is not used as a lemma for another type" {
  let p = proving(
    String::unlines([
      "fn same<a>(x: a) -> Bool = x == x",
      "law \"an int is itself\" forall (n: Int) { same(n) }",
      "law \"a float is itself\" forall (f: Float) { same(f) }",
    ]),
  );
  assert(decided_by(p, "m.an int is itself") != None);
  assert(decided_by(p, "m.a float is itself") == None)
}

fn solvent_balances(rest: List<String>) -> String =
  String::unlines(
    [
      "pub opaque type Balance = | Balance(Int)",
      "invariant for Balance by solvent",
      "fn solvent(b: Balance) -> Bool = match b { Balance(n) -> n >= 0 }",
      "pub fn amount(b: Balance) -> Int = match b { Balance(n) -> n }",
      "law \"a balance is never negative\" forall (b: Balance) { amount(b) >= 0 }",
    ].concat(
      rest,
    ),
  )

test "a built value must be proved to satisfy its invariant even when its builder has a `requires` clause that would guarantee it" {
  let p = proving(solvent_balances(["pub fn of(n: Int) -> Balance requires n >= 0 = Balance(n)"]));
  assert(proof_of(p, builds("m.of")) == None)
}

test "a built value is not proved to satisfy its invariant by facts that themselves depend on that invariant" {
  let p = proving(
    solvent_balances([
      "pub fn forged(n: Int) -> Balance = { let b = Balance(n); if amount(b) >= 0 { b } else { b } }",
      "pub fn ensured(n: Int) -> Balance ensures amount(result) >= 0 = Balance(n)",
      "fn kept(b: Balance, k: Int) -> Balance = if k <= 0 { b } else { kept(b, k - 1) }",
      "law \"made\" forall (n: Int, k: Int) { solvent(kept(Balance(n), k)) }",
      "law \"a deposit keeps it\" forall (b: Balance, n: Int) where n >= 0 && n < 1000 {",
      "  amount(match b { Balance(m) -> if m < 1000000 { Balance(m + n) } else { b } }) >= 0",
      "}",
    ]),
  );
  assert(proof_of(p, builds("m.forged")) == None);
  assert(decided_by(p, "m.ensured") == None);
  assert(decided_by(p, "m.made") == None);
  assert(decided_by(p, "m.a deposit keeps it") != None)
}

test "a value built inside a function passed to `map` or inside a returned lambda still needs its invariant proved" {
  let p = proving(
    solvent_balances([
      "pub fn all_of(xs: List<Int>) -> List<Balance> = xs.map(Balance)",
      "pub fn maker(b: Balance) -> (Int) -> Balance = |n: Int| Balance(n)",
      "pub fn opened() -> List<Balance> = [0, 1].map(|n: Int| Balance(n * n))",
    ]),
  );
  assert(proof_of(p, builds("m.all_of")) == None);
  assert(proof_of(p, builds("m.maker")) == None);
  assert(proof_of(p, builds("m.opened")) == None)
}

test "an `ensures` about a returned value is proved only when every value the definition builds is proved to satisfy the invariant" {
  let p = proving(
    solvent_balances([
      "fn make(n: Int) -> Balance ensures amount(result) >= 0 =",
      "  if n <= 0 { Balance(n) } else { make(n - 1) }",
    ]),
  );
  assert(decided_by(p, "m.make") == None)
}

test "the clause being proved is assumed only at the definition's own recursive calls, never through a lemma" {
  let p = proving(
    String::unlines([
      "law \"f is zero\" forall (xs: List<Int>) { f(xs) == 0 }",
      "fn f(xs: List<Int>) -> Int ensures result > 0 = match xs { [] -> 0, [_, ..rest] -> f(rest) }",
    ]),
  );
  assert(decided_by(p, "m.f") == None)
}

test "a keyed value of no fields compares by its key" {
  let p = proving(
    String::unlines([
      "type Length = | Zero | Metres(Int)",
      "key for Length by mm",
      "fn mm(l: Length) -> Int = match l { Zero -> 0, Metres(n) -> n }",
      "law \"no zero metres\" forall (n: Int) { Metres(n) != Zero }",
    ]),
  );
  assert(decided_by(p, "m.no zero metres") == None)
}

test "an order or a sum over values of an unknown type is not treated as an `Int` order or sum" {
  let p = proving(
    String::unlines([
      "law \"mapped floats are ordered\" forall (xs: List<Float>) {",
      "  match xs.map(|x: Float| x) { [a, b, ..] -> a <= b || b <= a, _ -> true }",
      "}",
    ]),
  );
  assert(decided_by(p, "m.mapped floats are ordered") == None)
}

test "the type variable of a generic constructor such as `None` is not counted as a type variable of the law" {
  let p = proving(
    "law \"float options are themselves\" forall (x: a, f: Float) where identity(a) { [None, Some(f)] == [None, Some(f)] }\n",
  );
  assert(decided_by(p, "m.float options are themselves") == None)
}

test "two lambdas written alike in two modules are two functions" {
  let p = proving_all([
    {
      name: b"a",
      source_text: b"// a.ply\npub fn up(xs: List<Int>) -> List<Int> = xs.map(|x: Int| x + 1)\n",
    },
    {
      name: b"b",
      source_text: b"import a\npub fn dn(xs: List<Int>) -> List<Int> = xs.map(|x: Int| x - 1)\nlaw \"down is up\" forall (k: Int) where k > 0 && k < 100 { dn([k]) == a::up([k]) }\n",
    },
  ]);
  assert(decided_by(p, "b.down is up") == None)
}

test "a law is proved only when every `raise` it can reach is shown not to happen, so it cannot rely on a definition that may raise" {
  let p = proving(
    String::unlines([
      "fn walk(n: Int) -> Int / {abort.raise} ensures result >= 0 || n < 0 =",
      "  if n < 0 { abort.raise(\"negative\") } else if n == 0 { 0 } else { walk(n - 1) }",
      "law \"a walk answers\" forall (n: Int) { walk(n) >= 0 || n < 0 }",
      "fn guard(n: Int) -> Int / {abort.raise} = if n < 0 { abort.raise(\"negative\") } else { n }",
      "law \"a guard answers\" forall (n: Int) { guard(n) >= 0 || n < 0 }",
    ]),
  );
  assert(decided_by(p, "m.walk") != None);
  assert(decided_by(p, "m.a walk answers") == None);
  assert(decided_by(p, "m.a guard answers") == None)
}

test "a law that applies a function argument is not proved, because the function's type does not show it returns normally" {
  let p = proving(
    String::unlines([
      "fn walk(n: Int) -> Int / {abort.raise} = if n < 0 { abort.raise(\"negative\") } else if n == 0 { 0 } else { walk(n - 1) }",
      "fn app(f: (Int) -> Int / {abort.raise}, n: Int) -> Int / {abort.raise} = f(n)",
      "law \"applied alike\" forall (n: Int) { app(walk, n) == app(walk, n) }",
    ]),
  );
  assert(decided_by(p, "m.applied alike") == None)
}

test "a statement whose value the claim never uses must still be shown not to raise" {
  let p = proving(
    String::unlines([
      "fn guard(n: Int) -> Int / {abort.raise} = if n < 0 { abort.raise(\"negative\") } else { n }",
      "law \"a guard is passed\" forall (n: Int) { let _ = guard(n); true }",
    ]),
  );
  assert(decided_by(p, "m.a guard is passed") == None)
}

test "a claim that builds a value does not use a law about a type that contains a field of that value's type" {
  let p = proving(
    solvent_balances([
      "type Wrapper = | W(Balance)",
      "fn inner(w: Wrapper, k: Int) -> Balance = if k <= 0 { match w { W(b) -> b } } else { inner(w, k - 1) }",
      "law \"held\" forall (w: Wrapper, k: Int) { amount(inner(w, k)) >= 0 }",
      "law \"forged\" forall (k: Int) { amount(inner(W(Balance(0 - 5)), k)) >= 0 }",
    ]),
  );
  assert(decided_by(p, "m.forged") == None)
}

test "a keyed value compares by its key against a value of a type the proof does not know" {
  let p = proving(
    String::unlines([
      "type Length = | Zero | Metres(Int)",
      "key for Length by mm",
      "fn mm(l: Length) -> Int = match l { Zero -> 0, Metres(n) -> n }",
      "fn is_zero(l: Length) -> Bool = match l { Zero -> true, Metres(_) -> false }",
      "law \"mapped lengths\" forall (xs: List<Int>) {",
      "  match xs.map(|n: Int| Metres(n)) { [x, ..] -> x != Zero || is_zero(x), _ -> true }",
      "}",
    ]),
  );
  assert(decided_by(p, "m.mapped lengths") == None)
}

test "an empty list literal has no single element type, so a law that uses it as a list of floats or ints is not proved" {
  let p = proving(
    String::unlines([
      "law \"ordered floats\" forall (xs: List<Int>, fs: List<Float>, c: Bool) {",
      "  match xs { [] -> true, _ -> true }",
      "    && match (if c { [] } else { fs }) { [a, b, ..] -> a <= b || b <= a, _ -> true }",
      "}",
    ]),
  );
  assert(decided_by(p, "m.ordered floats") == None)
}

test "a contract is not relied on for calls of a function argument, because that function may abort" {
  let p = proving(
    String::unlines([
      "fn all_hold(xs: List<Int>, p: (Int) -> Bool) -> Bool ensures result || xs.len() > 0 =",
      "  match xs { [] -> true, [x, ..rest] -> p(x) && all_hold(rest, p) }",
      "fn above(x: Int) -> Bool = x + 1 > 0",
      "law \"passes or has an element\" forall (xs: List<Int>) { all_hold(xs, above) || xs.len() > 0 }",
    ]),
  );
  assert(decided_by(p, "m.passes or has an element") == None)
}

test "a keyed value of no fields still compares by its key when its type has type parameters" {
  let p = proving(
    String::unlines([
      "type Level<a> = | Low | High | Exact(a)",
      "key for Level by rank",
      "fn rank<a>(l: Level<a>) -> Int = match l { Low -> 0, High -> 0, Exact(_) -> 1 }",
      "fn low() -> Level<Int> = Low",
      "fn high() -> Level<Int> = High",
      "law \"low is not high\" forall (n: Int) { low() != high() }",
    ]),
  );
  assert(decided_by(p, "m.low is not high") == None)
}

test "a claim that builds a value does not assume that a function's result satisfies an invariant" {
  let p = proving(
    solvent_balances([
      "pub opaque type Report = | Report(Int)",
      "invariant for Report by nonneg",
      "fn nonneg(r: Report) -> Bool = match r { Report(n) -> n >= 0 }",
      "pub fn report(b: Balance) -> Report = Report(amount(b))",
      "fn through(b: Balance, k: Int) -> Report = if k <= 0 { report(b) } else { through(b, k - 1) }",
      "law \"forged\" forall (k: Int) { nonneg(through(Balance(0 - 5), k)) }",
    ]),
  );
  assert(decided_by(p, "m.forged") == None)
}

test "a refutable `let` raises when its pattern does not match, so a law using one is not proved" {
  let p = proving(
    "law \"an option is something\" forall (o: Option<Int>) { let Some(_) = o; true }\n",
  );
  assert(decided_by(p, "m.an option is something") == None)
}

test "a definition's own clause is not assumed at a recursive call whose argument is a value the claim built" {
  let p = proving(
    solvent_balances([
      "fn drained(b: Balance, k: Int) -> Int ensures result >= 0 =",
      "  if k <= 0 { amount(b) } else { drained(if k > 5 { Balance(0 - 1) } else { b }, k - 1) }",
    ]),
  );
  assert(decided_by(p, "m.drained") == None)
}

test "a definition whose effects are a type variable is expanded where it is called with a lambda" {
  let p = proving(
    String::unlines([
      "fn twice<| e>(f: (Int) -> Int / e, x: Int) -> Int / e = f(f(x))",
      "law \"twice the identity is the identity\" forall (x: Int) { twice(|y: Int| y, x) == x }",
    ]),
  );
  assert(decided_by(p, "m.twice the identity is the identity") != None)
}

test "a contract's fact about a call is not applied to an argument that could overflow" {
  let p = proving(
    String::unlines([
      "fn copy(n: Int) -> Int ensures result == n = if n <= 0 { n } else { copy(n - 1) + 1 }",
      "law \"a successor's copy is larger\" forall (n: Int) { copy(n + 1) > n }",
    ]),
  );
  assert(decided_by(p, "m.a successor's copy is larger") == None)
}

test "only a law's own function variables are assumed to return normally, not functions taken from a list" {
  let p = proving(
    String::unlines([
      "fn inc(x: Int) -> Int = x + 1",
      "law \"a listed function answers\" forall (n: Int) {",
      "  match [inc].at(0) { Some(f) -> f(n) == f(n), None -> true }",
      "}",
    ]),
  );
  assert(decided_by(p, "m.a listed function answers") == None)
}

test "a law is proved for calls of `run_h` on its own `Handler` variable, but not on a `Handler` that the law builds from a function" {
  let p = proving(
    String::unlines([
      "type Handler = | H((Int) -> Int)",
      "fn run_h(h: Handler, n: Int) -> Int = if n <= 0 { match h { H(f) -> f(n) } } else { run_h(h, n - 1) }",
      "law \"run_h answers\" forall (h: Handler, n: Int) { let _ = run_h(h, n); true }",
      "fn dec(x: Int) -> Int = x - 1",
      "law \"a handed handler answers\" forall (n: Int) {",
      "  match [H(dec)].at(0) { Some(h) -> { let _ = run_h(h, n); true }, None -> true }",
      "}",
    ]),
  );
  assert(decided_by(p, "m.a handed handler answers") == None)
}

test "a builtin that compares keyed values calls their key, which may abort" {
  let p = proving(
    String::unlines([
      "type Big = | Big(Int)",
      "key for Big by doubled",
      "fn doubled(b: Big) -> Int = match b { Big(n) -> n * 2 }",
      "law \"the least is found\" forall (n: Int) { let _ = min(Big(n), Big(0)); true }",
    ]),
  );
  assert(decided_by(p, "m.the least is found") == None)
}

test "the value of a `match` branch is encoded with the solver sort of its type" {
  let p = proving(
    String::unlines([
      "fn first(xs: List<Int>) -> Option<Int> = match xs { [] -> None, [x, ..] -> Some(x) }",
      "law \"a first is itself\" forall (xs: List<Int>) { first(xs) == first(xs) }",
    ]),
  );
  assert(decided_by(p, "m.a first is itself") != None)
}

test "a recursion over a literal list is unrolled even when a function argument is passed to it" {
  let p = proving(
    String::unlines([
      "fn count_if(xs: List<Int>, p: (Int) -> Bool) -> Int =",
      "  match xs { [] -> 0, [x, ..rest] -> (if p(x) { 1 } else { 0 }) + count_if(rest, p) }",
      "fn positive(x: Int) -> Bool = x > 0",
      "law \"both count\" forall (k: Int) where k > 0 && k < 1000000 { count_if([k, k], positive) == 2 }",
    ]),
  );
  assert(decided_by(p, "m.both count") != None)
}

test "a fact a contract states about a call applies only on the paths where the call runs" {
  let p = proving(
    String::unlines([
      "fn copy(n: Int) -> Int ensures result == n = if n <= 0 { n } else { copy(n - 1) + 1 }",
      "law \"the largest is never reached\" forall (n: Int) {",
      "  let _ = if n < 0 { copy(n + 1) } else { 0 };",
      "  n < 9223372036854775807",
      "}",
    ]),
  );
  assert(decided_by(p, "m.the largest is never reached") == None)
}

test "a fact a lemma states about a call applies only on the paths where the call runs" {
  let p = proving(
    String::unlines([
      "fn copy(n: Int) -> Int = if n <= 0 { n } else { copy(n - 1) + 1 }",
      "law \"copy copies\" forall (n: Int) { copy(n) == n }",
      "law \"the largest is never reached\" forall (n: Int) {",
      "  let _ = if n < 0 { copy(n + 1) } else { 0 };",
      "  n < 9223372036854775807",
      "}",
    ]),
  );
  assert(decided_by(p, "m.the largest is never reached") == None)
}

test "a lemma over any function does not prove that calls of `run` with one specific function return" {
  let p = proving(
    String::unlines([
      "fn run(f: (Int) -> Int, xs: List<Int>) -> Int = match xs { [] -> 0, [y, ..rest] -> { let _ = f(y); run(f, rest) } }",
      "law \"a run answers nothing\" forall (f: (Int) -> Int, x: Int) { run(f, [x]) == 0 }",
      "fn bump(y: Int) -> Int = y + 1",
      "law \"a bumped run answers\" forall (x: Int) { let _ = run(bump, [x]); true }",
    ]),
  );
  assert(decided_by(p, "m.a bumped run answers") == None)
}

test "a lemma's fact is used only when evaluating it at the claim's values returns normally" {
  let p = proving(
    String::unlines([
      "fn first_of(f: (Int) -> Int, x: Int) -> Int = x",
      "law \"an answer fits\" forall (f: (Int) -> Int, x: Int) { first_of(f, x) == x && f(x) <= 9223372036854775807 }",
      "fn bump(y: Int) -> Int = y + 1",
      "law \"the largest is never reached\" forall (n: Int) { first_of(bump, n) == n && n < 9223372036854775807 }",
    ]),
  );
  assert(decided_by(p, "m.an answer fits") != None);
  assert(decided_by(p, "m.the largest is never reached") == None)
}

fn big_key_source(rest: List<String>) -> String =
  String::unlines(
    [
      "type Big = | Big(Int)",
      "key for Big by doubled",
      "fn doubled(b: Big) -> Int = match b { Big(n) -> n * 2 }",
      "type Held = | Held(Big)",
    ].concat(
      rest,
    ),
  )

test "an equality that calls a key must be shown to return normally, wherever the keyed value is nested" {
  let p = proving(
    big_key_source([
      "law \"held bigs compare\" forall (a: Held, b: Held) { a == b || a != b }",
      "law \"lists of bigs compare\" forall (xs: List<Big>, ys: List<Big>) { xs == ys || xs != ys }",
      "law \"lists of numbers compare\" forall (xs: List<Int>, ys: List<Int>) { xs == ys || xs != ys }",
    ]),
  );
  assert(decided_by(p, "m.held bigs compare") == None);
  assert(decided_by(p, "m.lists of bigs compare") == None);
  assert(decided_by(p, "m.lists of numbers compare") != None)
}

test "a generic contract or lemma does not prove that calls return when it is instantiated at a keyed value" {
  let p = proving(
    big_key_source([
      "fn same<a>(x: a, y: a, k: Int) -> Bool ensures true = if k <= 0 { x == y } else { same(x, y, k - 1) }",
      "law \"bigs are compared\" forall (n: Int, k: Int) { let _ = same(Big(n), Big(0), k); true }",
      "fn alike<a>(x: a, y: a, k: Int) -> Bool = if k <= 0 { x == y } else { alike(x, y, k - 1) }",
      "law \"alike answers\" forall (x: a, y: a, k: Int) { let _ = alike(x, y, k); true }",
      "law \"bigs are alike\" forall (n: Int, k: Int) { let _ = alike(Big(n), Big(0), k); true }",
    ]),
  );
  assert(decided_by(p, "m.bigs are compared") == None);
  assert(decided_by(p, "m.bigs are alike") == None)
}

test "a builtin that compares, passed as a function argument, calls the key of the values it compares" {
  let p = proving(
    big_key_source([
      "fn pick(f: (Big, Big) -> Big, a: Big, b: Big) -> Big = f(a, b)",
      "law \"the least is picked\" forall (n: Int) { let _ = pick(min, Big(n), Big(0)); true }",
      "law \"the least is folded\" forall (xs: List<Big>) { let _ = xs.fold(Big(0), min); true }",
    ]),
  );
  assert(decided_by(p, "m.the least is picked") == None);
  assert(decided_by(p, "m.the least is folded") == None)
}

test "a lambda is checked for raises separately at each place it appears, even when the code is the same" {
  let p = proving(
    String::unlines([
      "fn firsts(xs: List<Option<Int>>) -> List<Int> / {abort.raise} = xs.map(|o: Option<Int>| { let Some(y) = o; y })",
      "fn sized(xs: List<Option<Int>>, zs: List<Option<Int>>) -> Int / {abort.raise}",
      "  ensures firsts(zs).len() == zs.len() = firsts(xs).len()",
    ]),
  );
  assert(decided_by(p, "m.sized") == None)
}

test "an equality at a type the prover never resolved may call a key" {
  let p = proving(
    big_key_source([
      "law \"mapped bigs compare\" forall (xs: List<Big>, zs: List<Big>) {",
      "  let ys = xs.map(|b: Big| b);",
      "  ys == zs || ys != zs",
      "}",
      "fn same<a>(x: List<a>, y: List<a>, k: Int) -> Bool ensures true = if k <= 0 { x == y } else { same(x, y, k - 1) }",
      "law \"mapped bigs are compared\" forall (xs: List<Big>, zs: List<Big>, k: Int) {",
      "  let _ = same(xs.map(|b: Big| b), zs.map(|b: Big| b), k);",
      "  true",
      "}",
    ]),
  );
  assert(decided_by(p, "m.mapped bigs compare") == None);
  assert(decided_by(p, "m.mapped bigs are compared") == None)
}

test "generic code is proved when its type variables are resolved to types whose `==` calls no key" {
  let p = proving(
    big_key_source([
      "type Bag<a> = | Bag(List<a>)",
      "key for Bag by items",
      "fn items<a>(b: Bag<a>) -> List<a> = match b { Bag(xs) -> xs }",
      "fn count<a>(b: Bag<a>, k: Int) -> Int ensures result >= 0 = if k <= 0 { 0 } else { count(b, k - 1) }",
      "law \"counts of numbers are not negative\" forall (b: Bag<Int>, k: Int) { count(b, k) >= 0 }",
      "law \"a fold of maxima answers\" forall (xs: List<Int>) { let _ = xs.fold(0, max); true }",
    ]),
  );
  assert(decided_by(p, "m.counts of numbers are not negative") != None);
  assert(decided_by(p, "m.a fold of maxima answers") != None)
}

test "an equality of keyed constructors may call the key where the proof never resolved the type" {
  let p = proving(
    big_key_source([
      "law \"rebuilt bigs are compared\" forall (xs: List<Big>) {",
      "  let _ = match xs.map(|b: Big| b) {",
      "    [v, w, ..rest] -> match v { Big(n) -> match w { Big(m) -> Big(n) == Big(m) } },",
      "    _ -> true,",
      "  };",
      "  true",
      "}",
      "law \"mapped float lists compare\" forall (xss: List<List<Float>>, fs: List<Float>) {",
      "  let _ = xss.map(|ys: List<Float>| ys == fs);",
      "  true",
      "}",
    ]),
  );
  assert(decided_by(p, "m.rebuilt bigs are compared") == None);
  assert(decided_by(p, "m.mapped float lists compare") != None)
}

test "an `ensures` is proved about the value the body returns, but does not show that a call of a function argument returns" {
  let p = proving(
    String::unlines([
      "fn skip(f: (Int) -> Int, n: Int, k: Int) -> Int ensures result == n =",
      "  if k <= 0 { let _ = f(n); n } else { skip(f, n, k - 1) }",
      "law \"a skip past a bump answers\" forall (n: Int, k: Int) { skip(|x: Int| x + 1, n, k) == n }",
    ]),
  );
  assert(decided_by(p, "m.skip") != None);
  assert(decided_by(p, "m.a skip past a bump answers") == None)
}

fn decision_of(p: Proving, owner: String) -> Option<Decision> / {abort.raise} =
  match p.built.world.obligations.filter(|o: Obligation| o.owner == owner) {
    [o, ..] -> match static_prover::diagnosis_of(p.prover, o) {
      Some(d) -> Some(d.decision),
      None -> None,
    },
    [] -> panic("no obligation of " ++ owner),
  }

fn settled_among(p: Proving, labels: List<String>) -> List<String> / {abort.raise} =
  labels.filter(|l: String|
    match decision_of(p, owner(l)) {
      Some(Proved(_)) -> true,
      Some(GuardUnsatisfiable(_)) -> true,
      _ -> false,
    })

fn proved_among(p: Proving, labels: List<String>) -> List<String> / {abort.raise} =
  labels.filter(|l: String| decided_by(p, owner(l)) != None)

test "no false claim is proved or taken for vacuous, whatever its terms" {
  let p = proving(
    String::unlines([
      "type Color = Red | Green | Blue",
      "type Wrap = W(Color)",
      "fn score(c: Color) -> Int = match c { Red -> 1, Green -> 2, Blue -> 3 }",
      "fn unwrapped(w: Wrap) -> Int = match w { W(Red) -> 1, _ -> 2 }",
      "fn is_red(c: Color) -> Bool = match c { Red -> true, _ -> false }",
      "law \"halving\" forall (x: Int) { x / 2 * 2 == x }",
      "law \"by one\" forall (x: Int) { x / 1 == x }",
      "law \"modulo\" forall (x: Int) { x % 1 == 0 }",
      "law \"square\" forall (x: Int) { x * x >= x }",
      "law \"two functions\" forall (f: (Int) -> Int, g: (Int) -> Int, x: Int) { f(x) == g(x) }",
      "law \"under three\" forall (c: Color) { score(c) < 3 }",
      "law \"always two\" forall (w: Wrap) { unwrapped(w) == 2 }",
      "law \"concat commutes\" forall (s: String, t: String) { s ++ t == t ++ s }",
      "law \"one element\" forall (x: Int, y: Int) { [x] == [y] }",
      "law \"half a record\" forall (x: Int, y: Int) { { a: x, b: 0 } == { a: x, b: y } }",
      "law \"always red\" forall (c: Color) { is_red(c) }",
    ]),
  );
  assert_eq(
    settled_among(p, [
      "halving",
      "by one",
      "modulo",
      "square",
      "two functions",
      "under three",
      "always two",
      "concat commutes",
      "one element",
      "half a record",
      "always red",
    ]),
    [],
  )
}

test "a guard that requires one term to have two values admits nothing" {
  let p = proving(
    String::unlines([
      "fn recorded_on(days: List<Int>, day: Int) -> Bool =",
      "  match days { [d, ..rest] -> if d == day { true } else { recorded_on(rest, day) }, _ -> false }",
      "law \"impossible\" forall (x: Int) where x > 0 && x < 0 { x == 5 }",
      "law \"impossible by parity\" forall (x: Int) where x % 2 == 0 && x % 2 == 1 { x == 5 }",
      "law \"between and outside\" forall (paid: Int, asked: Int) where asked > paid && asked <= paid { paid == asked }",
      "law \"on a day the empty book records\" forall (day: Int) where day >= 1 && day <= 31 && recorded_on([], day) {",
      "  recorded_on([].push(day), day)",
      "}",
    ]),
  );
  assert_eq(
    [
      "impossible",
      "impossible by parity",
      "between and outside",
      "on a day the empty book records",
    ].filter(|l: String|
      match decision_of(p, owner(l)) { Some(GuardUnsatisfiable(_)) -> false, _ -> true }),
    [],
  )
}

test "no claim that compares a value which can hold a Float as itself is proved" {
  let p = proving(
    String::unlines([
      "type Rate = Float",
      "type Box<a> = B(a)",
      "pub type Money = Cents(Float)",
      "type Row = R({rate: Float})",
      "law \"visible binder\" forall (x: Float) { x == x }",
      "law \"visible container\" forall (xs: List<Float>) { xs == xs }",
      "law \"visible map\" forall (m: Map<String, Float>) { m == m }",
      "law \"visible alias\" forall (r: Rate) { r == r }",
      "law \"visible parameter\" forall (b: Box<Float>) { b == b }",
      "law \"hidden in a variant\" forall (m: Money) { m == m }",
      "law \"hidden in a record type\" forall (r: Row) { r == r }",
      "law \"hidden behind a list\" forall (xs: List<Money>) { xs == xs }",
      "law \"hidden behind an option\" forall (o: Option<Money>) { o == o }",
      "law \"destructured\" forall (m: Money) { match m { Cents(x) -> x == x } }",
      "pub fn keep(m: Money) -> Money",
      "  ensures result == m",
      "= m",
    ]),
  );
  assert_eq(
    proved_among(p, [
      "visible binder",
      "visible container",
      "visible map",
      "visible alias",
      "visible parameter",
      "hidden in a variant",
      "hidden in a record type",
      "hidden behind a list",
      "hidden behind an option",
      "destructured",
    ]),
    [],
  );
  assert(decided_by(p, "m.keep") == None)
}

test "a map and the byte builtins are opaque, so only congruence decides a claim over them" {
  let p = proving(
    String::unlines([
      "law \"reflexive\" forall (m: Map<String, Int>) { m == m }",
      "law \"get after insert\" forall (m: Map<String, Int>, k: String, v: Int) { m.insert(k, v).get(k) == Some(v) }",
      "law \"insert grows\" forall (m: Map<String, Int>, k: String, v: Int) { m.insert(k, v).len() == m.len() + 1 }",
      "law \"keys match len\" forall (m: Map<String, Int>) { m.keys().len() == m.len() }",
      "law \"index of self\" forall (b: Bytes) { b.index_of(b) == Some(0) }",
      "law \"empty needle\" forall (b: Bytes) { b.index_of(b\"\") == Some(0) }",
      "law \"starts with itself\" forall (b: Bytes) { b.starts_with(b) }",
      "law \"scan is bounded\" forall (b: Bytes, f: Int, s: Bytes, m: Int) { b.scan(f, s, m) <= f + m }",
      "law \"split rejoins\" forall (b: Bytes) { b.split(b\",\").len() >= 1 }",
      "law \"two literals\" forall (n: Int) { b\"ab\" == b\"ab\" }",
    ]),
  );
  assert_eq(proved_among(p, ["reflexive"]), ["reflexive"]);
  assert_eq(
    proved_among(p, [
      "get after insert",
      "insert grows",
      "keys match len",
      "index of self",
      "empty needle",
      "starts with itself",
      "scan is bounded",
      "split rejoins",
      "two literals",
    ]),
    [],
  )
}

test "a claim through a record of functions is proved only where its fields hold" {
  let p = proving(
    String::unlines([
      "pub type Point = P(Int)",
      "fn point_eq() -> {eq: (Point, Point) -> Bool} = {eq: |a: Point, b: Point| a == b}",
      "law \"eq is reflexive\" forall (p: Point) { (point_eq().eq)(p, p) }",
      "law \"eq is never true\" forall (p: Point) { !(point_eq().eq)(p, p) }",
    ]),
  );
  assert_eq(proved_among(p, ["eq is reflexive", "eq is never true"]), ["eq is reflexive"])
}

test "an index that returns an option is a value at every index, and one that raises is not" {
  let p = proving(
    String::unlines([
      "fn peek(xs: List<Int>, i: Int) -> Int = match xs.at(i) { Some(v) -> v, None -> 0 }",
      "fn bpeek(b: Bytes, i: Int) -> Int / {abort.raise} = b.at(i)",
      "law \"a total index\" forall (xs: List<Int>, i: Int) { peek(xs, i) == peek(xs, i) }",
      "law \"a raising index\" forall (b: Bytes, i: Int) { bpeek(b, i) == bpeek(b, i) }",
    ]),
  );
  assert_eq(proved_among(p, ["a total index", "a raising index"]), ["a total index"])
}
