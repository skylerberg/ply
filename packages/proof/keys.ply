import std.bytes
import std.hash (blake3)

const key_tag: Bytes = b"ply.prove.key.4"

pub fn claim_key(claim: Bytes) -> Bytes =
  blake3(Bytes::concat_all([key_tag, b"\x00claim\x00", claim]))

pub fn run_key(executes: Bytes) -> Bytes =
  blake3(Bytes::concat_all([key_tag, b"\x00run\x00", executes]))

const a_hash: Bytes =
  Bytes::of_hex("1111111111111111111111111111111111111111111111111111111111111111")

const sevens: Bytes =
  Bytes::of_hex("0707070707070707070707070707070707070707070707070707070707070707")

test "`claim_key` and `run_key` return the same fixed hex digest for a given claim hash, as a hash of a format version tag, the proof inputs and the claim hash" {
  assert_eq(
    claim_key(a_hash).hex_of(),
    "02f1b3a0b2bae16bc8b97407ee517ed00032db0ed4e248c119c290920ff7797d",
  );
  assert_eq(
    run_key(a_hash).hex_of(),
    "aa0fcc675e9a4dcfb8a69def64a4d3ec5588c8de46733635a2e36710be2f3cc5",
  )
}

test "a claim's two keys differ from each other, from its hash and from the keys of other claims" {
  assert(claim_key(a_hash) != run_key(a_hash));
  assert(claim_key(a_hash) != a_hash);
  assert(run_key(a_hash) != a_hash);
  assert(claim_key(a_hash) != claim_key(sevens));
  assert(run_key(a_hash) != run_key(sevens))
}
