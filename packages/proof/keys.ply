//! `keys` — what an obligation's proof is stored under.
//!
//! A proof read off the claim alone is a fact about the claim, and one a run helped make is a fact
//! about every definition the claim executes, so each is stored under a key made from the hash that
//! covers what it rests on. That is why an entry can be read back at all: the reader recomputes the
//! key, and an entry under the other one is a rejection rather than a mistake.
//!
//! This is the only encoding of them: the runtime reads and writes evidence under the keys the program
//! hands it.

import std.bytes
import std.hash (blake3)

/// The tag each key starts from, so an entry an earlier layout wrote is never read as one of these.
fn key_tag() -> Bytes = b"ply.prove.key.4"

/// The key a proof read off the claim that hashes to `claim` is stored under.
pub fn claim_key(claim: Bytes) -> Bytes =
  blake3(Bytes::concat_all([key_tag(), b"\x00claim\x00", claim]))

/// The key a proof a run helped make is stored under, for a claim that executes what hashes to
/// `executes`.
pub fn run_key(executes: Bytes) -> Bytes =
  blake3(Bytes::concat_all([key_tag(), b"\x00run\x00", executes]))

// --- Tests ------------------------------------------------------------------
//
// A key is the only thing standing between two eras of a proof, so it is pinned whole: the bytes
// every obligation cache already written holds.

fn a_hash() -> Bytes / {abort.raise} =
  Bytes::of_hex("1111111111111111111111111111111111111111111111111111111111111111")

fn sevens() -> Bytes / {abort.raise} =
  Bytes::of_hex("0707070707070707070707070707070707070707070707070707070707070707")

test "`claim_key` and `run_key` return the same fixed hex digest for a given claim hash, as a hash of a format version tag, the proof inputs and the claim hash" {
  assert_eq(
    claim_key(a_hash()).hex_of(),
    "02f1b3a0b2bae16bc8b97407ee517ed00032db0ed4e248c119c290920ff7797d",
  );
  assert_eq(
    run_key(a_hash()).hex_of(),
    "aa0fcc675e9a4dcfb8a69def64a4d3ec5588c8de46733635a2e36710be2f3cc5",
  )
}

test "a claim's two keys differ from each other, from its hash and from the keys of other claims" {
  assert(claim_key(a_hash()) != run_key(a_hash()));
  assert(claim_key(a_hash()) != a_hash());
  assert(run_key(a_hash()) != a_hash());
  assert(claim_key(a_hash()) != claim_key(sevens()));
  assert(run_key(a_hash()) != run_key(sevens()))
}
