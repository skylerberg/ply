import std.bin
import std.json (Json, Str, Number, Array, object, int)

pub type Scheme = | Descent(Int) | Spine(Int)

pub type Rule =
  | GroundEvaluation
  | ExhaustiveEnumeration({ domain: String, points: Int })
  | LinearArithmetic
  | Propositional
  | CaseSplit({ ty: String, arms: Int })
  | Congruence
  | Injectivity
  | Unfold({ definition: String, depth: Int })
  | Induction({ binder: String, scheme: Scheme, definition: String })
  | ExhaustiveInterleaving(Int)
  | Cited({ law: String, label: String })
  | CostBound({ definition: String })
  | SpaceBound({ definition: String })
  | Contract({ definition: String })

derive bin for Scheme
derive bin for Rule

pub type RuleLog = { rules: List<Rule>, unfolds: List<{ definition: String, depth: Int }> }

pub const no_rules: RuleLog = { rules: [], unfolds: [] }

pub fn induction_rule(binder: String, scheme: Scheme, definition: String) -> Rule =
  Induction({ binder: binder, scheme: scheme, definition: definition })

pub fn record_rule(log: RuleLog, r: Rule) -> RuleLog =
  if log.rules.fold(false, |seen: Bool, x: Rule| seen || x == r) { log }
  else { { ..log, rules: log.rules.push(r) } }

pub fn record_unfold(log: RuleLog, definition: String, depth: Int) -> RuleLog =
  if log.unfolds.fold(false, |seen: Bool, u: { definition: String, depth: Int }|
      seen || u.definition == definition) {
    {
      ..log,
      unfolds: log.unfolds.map(|u: { definition: String, depth: Int }|
        if u.definition == definition && depth > u.depth {
          { definition: definition, depth: depth }
        } else { u }),
    }
  } else { { ..log, unfolds: log.unfolds.push({ definition: definition, depth: depth }) } }

pub fn rules_of(log: RuleLog) -> List<Rule> =
  log.unfolds.fold(log.rules, |accumulator: List<Rule>, u: { definition: String, depth: Int }|
    accumulator.push(Unfold({ definition: u.definition, depth: u.depth })))

fn tagged(tag: String, fields: List<{ key: String, value: Json }>) -> Json =
  object([{ key: tag, value: object(fields) }])

pub fn rule_json(r: Rule) -> Json =
  match r {
    GroundEvaluation -> Str("ground_evaluation"),
    ExhaustiveEnumeration(e) ->
      tagged("exhaustive_enumeration", [
        { key: "domain", value: Str(e.domain) },
        { key: "points", value: int(e.points) },
      ]),
    LinearArithmetic -> Str("linear_arithmetic"),
    Propositional -> Str("propositional"),
    CaseSplit(c) ->
      tagged("case_split", [{ key: "ty", value: Str(c.ty) }, { key: "arms", value: int(c.arms) }]),
    Congruence -> Str("congruence"),
    Injectivity -> Str("injectivity"),
    Unfold(u) ->
      tagged("unfold", [
        { key: "def", value: Str(u.definition) },
        { key: "depth", value: int(u.depth) },
      ]),
    Induction(i) ->
      tagged("induction", [
        { key: "binder", value: Str(i.binder) },
        { key: "def", value: Str(i.definition) },
        { key: "over", value: Str(match i.scheme { Descent(_) -> "int", Spine(_) -> "list" }) },
        { key: "step", value: int(match i.scheme { Descent(k) -> k, Spine(k) -> k }) },
      ]),
    ExhaustiveInterleaving(n) ->
      tagged("exhaustive_interleaving", [{ key: "interleavings", value: int(n) }]),
    Cited(c) ->
      tagged("lemma", [{ key: "law", value: Str(c.law) }, { key: "label", value: Str(c.label) }]),
    CostBound(c) -> tagged("cost_bound", [{ key: "def", value: Str(c.definition) }]),
    SpaceBound(c) -> tagged("space_bound", [{ key: "def", value: Str(c.definition) }]),
    Contract(c) -> tagged("contract", [{ key: "def", value: Str(c.definition) }]),
  }

pub fn rules_json(rs: List<Rule>) -> Json = Array(rs.map(rule_json))

test "a rule used several times is listed once, and a rule for unfolding a definition is listed last, with only the greatest depth it was unfolded to" {
  let log = record_unfold(
    record_unfold(
      record_rule(record_rule(record_rule(no_rules, Congruence), LinearArithmetic), Congruence),
      "m.f",
      1,
    ),
    "m.f",
    3,
  );
  assert_eq(rules_of(log), [Congruence, LinearArithmetic, Unfold({ definition: "m.f", depth: 3 })])
}
