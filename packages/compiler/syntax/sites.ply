//! Which node of its item each node is. Resolution numbers every node of a definition, a test or a
//! law in one walk of it, so a check files what it found of a node under the item and the number,
//! which an edit to another item, a cut of the module or a check of part of it never moves.

import compiler.syntax.parsing (Span, Ident, QName, site_digit, minted, minted_too_deep,
                                role_try_return, role_detached, role_update_copy,
                                role_member_default)
import compiler.syntax.items (Module, Item, IFn, ITest, ILaw, ISchema, IExtern, IType, IEffect,
                              IDerive, FnDef, Binder, SpecClause, ReturnsParam, TDAlias, TDSum,
                              TDNominal, VariantDef, OpDef, parse)
import compiler.syntax.type_syntax (TypeExpr, TCon, TFn, TRecord, RowExpr, AtomExpr)
import compiler.expand.rewrite.shared (picked_in)
import compiler.syntax.exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock,
                              ERecord, ERecordUpdate, ETry, EField, EList, EPerform, EHandle,
                              EWithHold, ESimulate, EParallel, ETagged, EBad, EHole, ETryBlock,
                              Stmt, SLet, SLetElse, SExpr, SAssign, Param, NamedArg, MatchArm,
                              HandleClause, ReturnClause, HandlerVar, RecField, Hole, expr_span)
import compiler.syntax.patterns (Pattern, PWild, PVar, PLit, PRange, PCtor, PRecord, PList, POr,
                                 PBad)

/// `m` with each of its items numbered.
pub fn numbered_module(m: Module) -> Module / {abort.raise} = { ..m, items: m.items.map(numbered) }

/// `item` with each node of it numbered from 1 in a walk of it: every expression, pattern,
/// statement, arm, clause, spec clause, `return` clause and handler variable, every name that
/// binds a local or names a local, a declaration or a module, a law's binders, the texts of a
/// tagged literal, and the two words a test over cases writes. The name a variable, a perform, an
/// assignment, a pattern variable or a binder writes shares its node's number. A definition's name
/// comes first, then its parameters, its body, its clauses, its measure and what it `returns`; a
/// test's cases, then its body; a law's binders, then its guard and its body. A field's name, a
/// label, a type variable and the item keep no number.
/// Raises on an item of more nodes than a minted site leaves room for.
pub fn numbered(item: Item) -> Item / {abort.raise} = {
  let out: { item: Item, n: Int } = match item {
    IFn(d) -> {
      let f = numbered_fn(d, 1);
      { item: IFn(f.d), n: f.n }
    },
    IType(d) -> {
      let body = match d.body {
        TDAlias(t) -> {
          let o = num_type(t, 2);
          { b: TDAlias(o.t), n: o.n }
        },
        TDNominal(t) -> {
          let o = num_type(t, 2);
          { b: TDNominal(o.t), n: o.n }
        },
        TDSum(vs) -> {
          let o = vs.fold(
            { vs: [], n: 2 },
            |acc: { vs: List<VariantDef>, n: Int }, v: VariantDef| {
              let fs = num_types(v.fields, acc.n + 1);
              { vs: acc.vs.push({ ..v, name: named(v.name, acc.n), fields: fs.ts }), n: fs.n }
            },
          );
          { b: TDSum(o.vs), n: o.n }
        },
        other -> { b: other, n: 2 },
      };
      { item: IType({ ..d, name: named(d.name, 1), body: body.b }), n: body.n }
    },
    IEffect(d) -> {
      let ops = d.ops.fold({ ops: [], n: 2 }, |acc: { ops: List<OpDef>, n: Int }, op: OpDef| {
        let ps = num_types(op.params, acc.n + 1);
        let r = num_type(op.ret, ps.n);
        {
          ops: acc.ops.push({ ..op, name: named(op.name, acc.n), params: ps.ts, ret: r.t }),
          n: r.n,
        }
      });
      { item: IEffect({ ..d, name: named(d.name, 1), ops: ops.ops }), n: ops.n }
    },
    IDerive(d) -> { item: IDerive({ ..d, target: named(d.target, 1) }), n: 2 },
    ITest(d) -> match d.cases {
      None -> {
        let b: Num = num_expr(d.body, 1);
        { item: ITest({ ..d, body: b.e }), n: b.n }
      },
      Some(c) -> {
        let ty = num_type(c.ty, 4);
        let table: Num = num_expr(c.table, ty.n);
        let label: Num = num_expr(c.label, table.n);
        let b: Num = num_expr(d.body, label.n);
        {
          item: ITest({
            ..d,
            cases: Some({
              ..c,
              for_span: at(c.for_span, 1),
              in_span: at(c.in_span, 2),
              binder: named(c.binder, 3),
              ty: ty.t,
              table: table.e,
              label: label.e,
            }),
            body: b.e,
          }),
          n: b.n,
        }
      },
    },
    ILaw(d) -> {
      let bs = binders(d.binders, 1);
      let g: { e: Option<Expr>, n: Int } = maybe(d.guard, bs.n);
      let b: Num = num_expr(d.body, g.n);
      { item: ILaw({ ..d, binders: bs.bs, guard: g.e, body: b.e }), n: b.n }
    },
    ISchema(d) -> {
      let ps = binders(d.params, 1);
      let bs = binders(d.binders, ps.n);
      let g: { e: Option<Expr>, n: Int } = maybe(d.guard, bs.n);
      let b: Num = num_expr(d.body, g.n);
      { item: ISchema({ ..d, params: ps.bs, binders: bs.bs, guard: g.e, body: b.e }), n: b.n }
    },
    IExtern(d) -> {
      let ps: Params = params(d.params, 2);
      let r = num_type(d.ret, ps.n);
      let e = num_maybe_row(d.effects, r.n);
      let sp = clauses(d.spec, e.n);
      {
        item: IExtern({
          ..d,
          name: named(d.name, 1),
          params: ps.ps,
          ret: r.t,
          effects: e.r,
          spec: sp.cs,
        }),
        n: sp.n,
      }
    },
    _ -> { item: item, n: 1 },
  };
  if out.n >= site_digit() { panic("an item of more nodes than its sites can number") }
  else { out.item }
}

type Num = { e: Expr, n: Int }

type Nums = { es: List<Expr>, n: Int }

type NumPat = { p: Pattern, n: Int }

type Params = { ps: List<Param>, n: Int }

fn at(s: Span, n: Int) -> Span = { ..s, site: n }

fn numbered_fn(d: FnDef, n: Int) -> { d: FnDef, n: Int } / {abort.raise} = {
  let ps: Params = params(d.params, n + 1);
  let r = num_maybe_type(d.ret, ps.n);
  let e = num_maybe_row(d.effects, r.n);
  let b: Num = num_expr(d.body, e.n);
  let sp = clauses(d.spec, b.n);
  let m: { e: Option<Expr>, n: Int } = maybe(d.decreases, sp.n);
  let returns = match d.returns {
    Some(ReturnsParam(p)) -> Some(ReturnsParam(named(p, m.n))),
    r -> r,
  };
  {
    d: {
      ..d,
      name: named(d.name, n),
      params: ps.ps,
      ret: r.t,
      effects: e.r,
      body: b.e,
      spec: sp.cs,
      decreases: m.e,
      returns: returns,
    },
    n: m.n + 1,
  }
}

fn params(ps: List<Param>, n: Int) -> Params / {abort.raise} =
  ps.fold({ ps: [], n: n }, |acc: Params, p: Param| {
    let ty = num_maybe_type(p.ty, acc.n + 1);
    let cost = maybe_named(p.cost, ty.n);
    let space = maybe_named(p.space, cost.n);
    let d: { e: Option<Expr>, n: Int } = maybe(p.default, space.n);
    {
      ps: acc.ps.push({
        ..p,
        name: named(p.name, acc.n),
        ty: ty.t,
        cost: cost.name,
        space: space.name,
        default: d.e,
      }),
      n: d.n,
    }
  })

fn named(name: Ident, n: Int) -> Ident = { ..name, span: at(name.span, n) }

fn idents(names: List<Ident>, n: Int) -> { names: List<Ident>, n: Int } =
  names.fold({ names: [], n: n }, |acc: { names: List<Ident>, n: Int }, name: Ident|
    { names: acc.names.push(named(name, acc.n)), n: acc.n + 1 })

fn maybe_named(name: Option<Ident>, n: Int) -> { name: Option<Ident>, n: Int } =
  match name { Some(x) -> { name: Some(named(x, n)), n: n + 1 }, None -> { name: None, n: n } }

fn clauses(cs: List<SpecClause>, n: Int) -> { cs: List<SpecClause>, n: Int } / {abort.raise} =
  cs.fold({ cs: [], n: n }, |acc: { cs: List<SpecClause>, n: Int }, c: SpecClause| {
    let o: Num = num_expr(c.expr, acc.n + 1);
    { cs: acc.cs.push({ ..c, span: at(c.span, acc.n), expr: o.e }), n: o.n }
  })

fn binders(bs: List<Binder>, n: Int) -> { bs: List<Binder>, n: Int } / {abort.raise} =
  bs.fold({ bs: [], n: n }, |acc: { bs: List<Binder>, n: Int }, b: Binder| {
    let t = num_type(b.ty, acc.n + 1);
    {
      bs: acc.bs.push({ ..b, span: at(b.span, acc.n), name: named(b.name, acc.n), ty: t.t }),
      n: t.n,
    }
  })

/// `q`'s module's name, then its own, numbered from `n` on.
fn num_qname(q: QName, n: Int) -> { q: QName, n: Int } =
  match q.module {
    Some(m) -> { q: { ..q, module: Some(named(m, n)), name: named(q.name, n + 1) }, n: n + 2 },
    None -> { q: { ..q, name: named(q.name, n) }, n: n + 1 },
  }

fn num_type(t: TypeExpr, n: Int) -> { t: TypeExpr, n: Int } / {abort.raise} =
  match t {
    TCon(c) -> {
      let q = num_qname(c.name, n);
      let args = num_types(c.args, q.n);
      let rows = c.rows.fold(
        { rs: [], n: args.n },
        |acc: { rs: List<RowExpr>, n: Int }, r: RowExpr| {
          let o = num_row(r, acc.n);
          { rs: acc.rs.push(o.r), n: o.n }
        },
      );
      { t: TCon({ ..c, name: q.q, args: args.ts, rows: rows.rs }), n: rows.n }
    },
    TFn(f) -> {
      let ps = num_types(f.params, n);
      let r = num_type(f.ret, ps.n);
      let e = num_maybe_row(f.effects, r.n);
      { t: TFn({ ..f, params: ps.ts, ret: r.t, effects: e.r }), n: e.n }
    },
    TRecord(r) -> {
      let fs = r.fields.fold(
        { fs: [], n: n },
        |acc: { fs: List<{ name: Ident, ty: TypeExpr }>, n: Int }, f: { name: Ident, ty: TypeExpr }| {
          let o = num_type(f.ty, acc.n);
          { fs: acc.fs.push({ name: f.name, ty: o.t }), n: o.n }
        },
      );
      { t: TRecord({ ..r, fields: fs.fs }), n: fs.n }
    },
    other -> { t: other, n: n },
  }

fn num_types(ts: List<TypeExpr>, n: Int) -> { ts: List<TypeExpr>, n: Int } / {abort.raise} =
  ts.fold({ ts: [], n: n }, |acc: { ts: List<TypeExpr>, n: Int }, t: TypeExpr| {
    let o = num_type(t, acc.n);
    { ts: acc.ts.push(o.t), n: o.n }
  })

fn num_maybe_type(t: Option<TypeExpr>, n: Int) -> { t: Option<TypeExpr>, n: Int } / {abort.raise} =
  match t {
    Some(x) -> {
      let o = num_type(x, n);
      { t: Some(o.t), n: o.n }
    },
    None -> { t: None, n: n },
  }

fn num_row(r: RowExpr, n: Int) -> { r: RowExpr, n: Int } / {abort.raise} = {
  let atoms = r.atoms.fold({ xs: [], n: n }, |acc: { xs: List<AtomExpr>, n: Int }, a: AtomExpr| {
    let e = num_qname(a.eff, acc.n);
    let op = maybe_named(a.op, e.n);
    { xs: acc.xs.push({ ..a, eff: e.q, op: op.name }), n: op.n }
  });
  let aliases = r.aliases.fold(
    { qs: [], n: atoms.n },
    |acc: { qs: List<QName>, n: Int }, q: QName| {
      let o = num_qname(q, acc.n);
      { qs: acc.qs.push(o.q), n: o.n }
    },
  );
  { r: { ..r, atoms: atoms.xs, aliases: aliases.qs }, n: aliases.n }
}

fn num_maybe_row(r: Option<RowExpr>, n: Int) -> { r: Option<RowExpr>, n: Int } / {abort.raise} =
  match r {
    Some(x) -> {
      let o = num_row(x, n);
      { r: Some(o.r), n: o.n }
    },
    None -> { r: None, n: n },
  }

fn maybe(x: Option<Expr>, n: Int) -> { e: Option<Expr>, n: Int } / {abort.raise} =
  match x {
    Some(y) -> {
      let o: Num = num_expr(y, n);
      { e: Some(o.e), n: o.n }
    },
    None -> { e: None, n: n },
  }

/// `e` numbered from `n` on, and the number after its last node.
fn num_expr(e: Expr, n: Int) -> Num / {abort.raise} = {
  let each = |xs: List<Expr>, from: Int|
    xs.fold({ es: [], n: from }, |acc: Nums, x: Expr| {
      let o: Num = num_expr(x, acc.n);
      { es: acc.es.push(o.e), n: o.n }
    });
  let opt = |x: Option<Expr>, from: Int|
    match x {
      Some(y) -> {
        let o: Num = num_expr(y, from);
        { e: Some(o.e), n: o.n }
      },
      None -> { e: None, n: from },
    };
  let fields = |fs: List<RecField>, from: Int|
    fs.fold({ fs: [], n: from }, |acc: { fs: List<RecField>, n: Int }, f: RecField| {
      let v: Num = num_expr(f.value, acc.n);
      { fs: acc.fs.push({ ..f, value: v.e }), n: v.n }
    });
  match e {
    ELit(l) -> { e: ELit({ ..l, span: at(l.span, n) }), n: n + 1 },
    EVar(v) -> {
      let m = maybe_named(v.name.module, n + 1);
      {
        e: EVar({
          span: at(v.span, n),
          name: { ..v.name, module: m.name, name: named(v.name.name, n) },
        }),
        n: m.n,
      }
    },
    EBad(b) -> { e: EBad({ span: at(b.span, n) }), n: n + 1 },
    EHole(h) -> { e: EHole({ ..h, span: at(h.span, n) }), n: n + 1 },
    EBinary(b) -> {
      let l: Num = num_expr(b.lhs, n + 1);
      let r: Num = num_expr(b.rhs, l.n);
      { e: EBinary({ ..b, span: at(b.span, n), lhs: l.e, rhs: r.e }), n: r.n }
    },
    EUnary(u) -> {
      let o: Num = num_expr(u.operand, n + 1);
      { e: EUnary({ ..u, span: at(u.span, n), operand: o.e }), n: o.n }
    },
    ELambda(l) -> {
      let ps: Params = params(l.params, n + 1);
      let r = num_maybe_type(l.ret, ps.n);
      let b: Num = num_expr(l.body, r.n);
      { e: ELambda({ span: at(l.span, n), params: ps.ps, ret: r.t, body: b.e }), n: b.n }
    },
    EApp(a) -> {
      let f: Num = num_expr(a.func, n + 1);
      let xs: Nums = each(a.args, f.n);
      let ns = a.named.fold(
        { ns: [], n: xs.n },
        |acc: { ns: List<NamedArg>, n: Int }, arg: NamedArg| {
          let o: Num = num_expr(arg.value, acc.n);
          { ns: acc.ns.push({ ..arg, value: o.e }), n: o.n }
        },
      );
      { e: EApp({ ..a, span: at(a.span, n), func: f.e, args: xs.es, named: ns.ns }), n: ns.n }
    },
    EIf(i) -> {
      let c: Num = num_expr(i.cond, n + 1);
      let t: Num = num_expr(i.then_branch, c.n);
      let el: Num = num_expr(i.else_branch, t.n);
      { e: EIf({ span: at(i.span, n), cond: c.e, then_branch: t.e, else_branch: el.e }), n: el.n }
    },
    EMatch(m) -> {
      let sc: Num = num_expr(m.scrutinee, n + 1);
      let arms = m.arms.fold(
        { arms: [], n: sc.n },
        |acc: { arms: List<MatchArm>, n: Int }, arm: MatchArm| {
          let pt: NumPat = num_pat(arm.pat, acc.n + 1);
          let g: { e: Option<Expr>, n: Int } = opt(arm.guard, pt.n);
          let b: Num = num_expr(arm.body, g.n);
          {
            arms: acc.arms.push({ pat: pt.p, guard: g.e, body: b.e, span: at(arm.span, acc.n) }),
            n: b.n,
          }
        },
      );
      { e: EMatch({ span: at(m.span, n), scrutinee: sc.e, arms: arms.arms }), n: arms.n }
    },
    EBlock(b) -> {
      let st = b.stmts.fold(
        { stmts: [], n: n + 1 },
        |acc: { stmts: List<Stmt>, n: Int }, stmt: Stmt|
          match stmt {
            SLet(l) -> {
              let pt: NumPat = num_pat(l.pat, acc.n + 1);
              let ty = num_maybe_type(l.ty, pt.n);
              let v: Num = num_expr(l.value, ty.n);
              {
                stmts: acc.stmts.push(
                  SLet({ ..l, span: at(l.span, acc.n), pat: pt.p, ty: ty.t, value: v.e }),
                ),
                n: v.n,
              }
            },
            SLetElse(l) -> {
              let pt: NumPat = num_pat(l.pat, acc.n + 1);
              let ty = num_maybe_type(l.ty, pt.n);
              let v: Num = num_expr(l.value, ty.n);
              let fb: Num = num_expr(l.fallback, v.n);
              {
                stmts: acc.stmts.push(
                  SLetElse({
                    ..l,
                    span: at(l.span, acc.n),
                    pat: pt.p,
                    ty: ty.t,
                    value: v.e,
                    fallback: fb.e,
                  }),
                ),
                n: fb.n,
              }
            },
            SExpr(x) -> {
              let o: Num = num_expr(x, acc.n);
              { stmts: acc.stmts.push(SExpr(o.e)), n: o.n }
            },
            SAssign(x) -> {
              let v: Num = num_expr(x.value, acc.n + 1);
              {
                stmts: acc.stmts.push(
                  SAssign({ span: at(x.span, acc.n), name: named(x.name, acc.n), value: v.e }),
                ),
                n: v.n,
              }
            },
          },
      );
      let t: { e: Option<Expr>, n: Int } = opt(b.tail, st.n);
      { e: EBlock({ span: at(b.span, n), tail: t.e, stmts: st.stmts }), n: t.n }
    },
    ERecord(r) -> {
      let fs: { fs: List<RecField>, n: Int } = fields(r.fields, n + 1);
      { e: ERecord({ span: at(r.span, n), fields: fs.fs }), n: fs.n }
    },
    ERecordUpdate(r) -> {
      let base: Num = num_expr(r.base, n + 1);
      let fs: { fs: List<RecField>, n: Int } = fields(r.fields, base.n);
      { e: ERecordUpdate({ span: at(r.span, n), base: base.e, fields: fs.fs }), n: fs.n }
    },
    ETry(t) -> {
      let o: Num = num_expr(t.operand, n + 1);
      { e: ETry({ span: at(t.span, n), operand: o.e }), n: o.n }
    },
    EField(f) -> {
      let base: Num = num_expr(f.base, n + 1);
      { e: EField({ ..f, span: at(f.span, n), base: base.e }), n: base.n }
    },
    EList(l) -> {
      let xs: Nums = each(l.items, n + 1);
      { e: EList({ span: at(l.span, n), items: xs.es }), n: xs.n }
    },
    EPerform(p) -> {
      let m = maybe_named(p.eff.module, n + 1);
      let xs: Nums = each(p.args, m.n + 1);
      {
        e: EPerform({
          ..p,
          span: at(p.span, n),
          eff: { ..p.eff, module: m.name, name: named(p.eff.name, n) },
          op: named(p.op, m.n),
          args: xs.es,
        }),
        n: xs.n,
      }
    },
    EHandle(h) -> {
      let vs = h.vars.fold(
        { vs: [], n: n + 1 },
        |acc: { vs: List<HandlerVar>, n: Int }, v: HandlerVar| {
          let ty = num_maybe_type(v.ty, acc.n + 2);
          let o: Num = num_expr(v.init, ty.n);
          {
            vs: acc.vs.push({
              span: at(v.span, acc.n),
              name: named(v.name, acc.n + 1),
              ty: ty.t,
              init: o.e,
            }),
            n: o.n,
          }
        },
      );
      let body: Num = num_expr(h.body, vs.n);
      let cs = h.clauses.fold(
        { cs: [], n: body.n },
        |acc: { cs: List<HandleClause>, n: Int }, c: HandleClause| {
          let eff = num_qname(c.eff, acc.n + 1);
          let ps = idents(c.params, eff.n + 1);
          let label = maybe_named(c.label_binder, ps.n);
          let resume = maybe_named(c.resume, label.n);
          let o: Num = num_expr(c.body, resume.n);
          {
            cs: acc.cs.push({
              ..c,
              span: at(c.span, acc.n),
              eff: eff.q,
              op: named(c.op, eff.n),
              params: ps.names,
              label_binder: label.name,
              resume: resume.name,
              body: o.e,
            }),
            n: o.n,
          }
        },
      );
      let ret: { r: Option<ReturnClause>, n: Int } = match h.ret {
        Some(r) -> {
          let o: Num = num_expr(r.body, cs.n + 2);
          {
            r: Some({ ..r, span: at(r.span, cs.n), binder: named(r.binder, cs.n + 1), body: o.e }),
            n: o.n,
          }
        },
        None -> { r: None, n: cs.n },
      };
      {
        e: EHandle({ span: at(h.span, n), body: body.e, ret: ret.r, clauses: cs.cs, vars: vs.vs }),
        n: ret.n,
      }
    },
    EWithHold(w) -> {
      let a: Num = num_expr(w.acquire, n + 1);
      let r: Num = num_expr(w.release, a.n);
      let b: Num = num_expr(w.body, r.n + 1);
      {
        e: EWithHold({
          ..w,
          span: at(w.span, n),
          acquire: a.e,
          release: r.e,
          binder: named(w.binder, r.n),
          body: b.e,
        }),
        n: b.n,
      }
    },
    ESimulate(x) -> {
      let b: Num = num_expr(x.body, n + 1);
      { e: ESimulate({ span: at(x.span, n), body: b.e }), n: b.n }
    },
    EParallel(x) -> {
      let xs: Nums = each(x.branches, n + 1);
      { e: EParallel({ span: at(x.span, n), branches: xs.es }), n: xs.n }
    },
    ETryBlock(t) -> {
      let raised = match t.raise {
        Some(r) -> {
          let eff = num_qname(r.eff, n + 1);
          { r: Some({ eff: eff.q, op: named(r.op, eff.n) }), n: eff.n + 1 }
        },
        None -> { r: None, n: n + 1 },
      };
      let b: Num = num_expr(t.body, raised.n);
      { e: ETryBlock({ span: at(t.span, n), raise: raised.r, body: b.e }), n: b.n }
    },
    // Each text a tagged literal writes is a node its call is written with.
    ETagged(t) -> {
      let hs = t.holes.fold({ hs: [], n: n + 3 }, |acc: { hs: List<Hole>, n: Int }, h: Hole| {
        let o: Num = num_expr(h.value, acc.n + 1);
        { hs: acc.hs.push({ ..h, quoted: at(h.quoted, acc.n), value: o.e }), n: o.n }
      });
      {
        e: ETagged({
          ..t,
          span: at(t.span, n),
          quoted: at(t.quoted, n + 1),
          tag: named(t.tag, n + 2),
          holes: hs.hs,
        }),
        n: hs.n,
      }
    },
  }
}

// --- Tests ------------------------------------------------------------------

/// The site of each expression of the item named `name` of `src`, numbered, in a walk of it.
fn sites_of(src: Bytes, name: Bytes) -> List<Int> / {abort.raise} = {
  let m = numbered_module(parse(src).node);
  picked_in({ ..m, items: m.items.filter(|item: Item| item_named(item, name)) }, |_: Expr|
    true).map(|e: Expr| expr_span(e).site)
}

fn item_named(item: Item, name: Bytes) -> Bool =
  match item { IFn(d) -> d.name.name == name, ITest(t) -> t.name == name, _ -> false }

test "an item's sites are its own: an edit to another item, or a cut of its module, moves none" {
  let g = b"fn g(y: Int) -> Int = if y > 0 { y } else { 0 - y }\n";
  let before = sites_of(Bytes::concat_all([b"fn f(x: Int) -> Int = x + 1\n", g]), b"g");
  assert(before.len() > 4);
  assert_eq(before.filter(|s: Int| s == 0), []);
  assert_eq(before.unique().len(), before.len());
  let edited = b"/// Doubled.\nfn f(x: Int) -> Int = { let z = x * 2; z + 1 }\ntest \"t\" { () }\n";
  assert_eq(sites_of(edited.concat(g), b"g"), before);
  assert_eq(sites_of(g, b"g"), before)
}

test "a minted site is no numbered one, nor one another node or role mints" {
  let src = b"fn f(xs: List<Int>, d: Int = 3) -> Int = match xs { [x, ..] -> try { x + d }, [] -> d }\n";
  let m = numbered_module(parse(src).node);
  let spans = picked_in(m, |_: Expr| true).map(expr_span);
  let numbered = spans.map(|s: Span| s.site);
  let roles = [role_try_return(), role_detached(), role_update_copy(3), role_member_default(2) + 5];
  let made = spans.flat_map(|s: Span| roles.map(|k: Int| minted(s, k).site));
  assert_eq(made.filter(|s: Int| numbered.contains(s)), []);
  assert_eq(made.unique().len(), made.len());
  assert_eq(made.filter(minted_too_deep), [])
}

/// `p` numbered from `n` on, and the number after its last node.
fn num_pat(p: Pattern, n: Int) -> NumPat = {
  let each = |ps: List<Pattern>, from: Int|
    ps.fold({ ps: [], n: from }, |acc: { ps: List<Pattern>, n: Int }, x: Pattern| {
      let o: NumPat = num_pat(x, acc.n);
      { ps: acc.ps.push(o.p), n: o.n }
    });
  match p {
    PWild(w) -> { p: PWild({ span: at(w.span, n) }), n: n + 1 },
    PVar(v) -> { p: PVar({ span: at(v.span, n), name: named(v.name, n) }), n: n + 1 },
    PLit(l) -> { p: PLit({ ..l, span: at(l.span, n) }), n: n + 1 },
    PRange(r) -> { p: PRange({ ..r, span: at(r.span, n) }), n: n + 1 },
    PCtor(c) -> {
      let q = num_qname(c.name, n + 1);
      let xs: { ps: List<Pattern>, n: Int } = each(c.args, q.n);
      { p: PCtor({ span: at(c.span, n), name: q.q, args: xs.ps }), n: xs.n }
    },
    PRecord(r) -> {
      let fs = r.fields.fold(
        { fs: [], n: n + 1 },
        |acc: { fs: List<{ name: Ident, pat: Pattern }>, n: Int }, f: { name: Ident, pat: Pattern }| {
          let o: NumPat = num_pat(f.pat, acc.n);
          { fs: acc.fs.push({ name: f.name, pat: o.p }), n: o.n }
        },
      );
      { p: PRecord({ ..r, span: at(r.span, n), fields: fs.fs }), n: fs.n }
    },
    PList(l) -> {
      let xs: { ps: List<Pattern>, n: Int } = each(l.items, n + 1);
      let rest: { p: Option<Pattern>, n: Int } = match l.rest {
        Some(x) -> {
          let o: NumPat = num_pat(x, xs.n);
          { p: Some(o.p), n: o.n }
        },
        None -> { p: None, n: xs.n },
      };
      { p: PList({ span: at(l.span, n), rest: rest.p, items: xs.ps }), n: rest.n }
    },
    POr(o) -> {
      let xs: { ps: List<Pattern>, n: Int } = each(o.alts, n + 1);
      { p: POr({ span: at(o.span, n), alts: xs.ps }), n: xs.n }
    },
    PBad(b) -> { p: PBad({ span: at(b.span, n) }), n: n + 1 },
  }
}
