//! Which node of its item each node is. Resolution numbers every node of a definition, a test or a
//! law in one walk of it, so a check files what it found of a node under the item and the number,
//! which an edit to another item, a cut of the module or a check of part of it never moves.

import compiler.syntax.parsing (Span, Ident, QName, site_digit, minted, minted_too_deep,
                                role_try_return, role_detached, role_try_arg,
                                role_member_default)
import compiler.syntax.items (Module, Item, IFn, ITest, ILaw, ISchema, IExtern, IType, IEffect,
                              IDerive, IInstance, INumeric, IEffectSet, FnDef, Binder, SpecClause,
                              ReturnsParam, TDAlias, TDSum, TDNominal, VariantDef, OpDef, NumericOp,
                              parse)
import compiler.syntax.type_syntax (TypeExpr, TCon, TFn, TRecord, RowExpr, AtomExpr)
import compiler.expand.rewrite.shared (picked_in)
import compiler.syntax.exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock,
                              ERecord, ERecordUpdate, ETry, EField, EList, EPerform, EHandle,
                              EWithHold, ESimulate, EParallel, ETagged, EBad, EHole, ETryBlock,
                              Stmt, SLet, SLetElse, SExpr, SAssign, Param, NamedArg, MatchArm,
                              HandleClause, ReturnClause, HandlerVar, RecField, Hole, expr_span)
import compiler.syntax.patterns (Pattern, PWild, PVar, PLit, PRange, PCtor, PRecord, PList, POr,
                                 PBad)

/// `m` with each of its items numbered.
pub fn numbered_module(m: Module) -> Module / {abort.raise} = { ..m, items: m.items.map(numbered) }

/// `item` with each node of it numbered from 1 in a walk of it: every expression, pattern,
/// statement, arm, clause, spec clause, `return` clause and handler variable, every name that
/// binds a local or names a local, a declaration or a module, a law's binders, the texts of a
/// tagged literal, and the two words a test over cases writes. The name a variable, a perform, an
/// assignment, a pattern variable or a binder writes shares its node's number. A definition's name
/// comes first, then its parameters, its body, its clauses, its measure and what it `returns`; a
/// test's cases, then its body; a law's binders, then its guard and its body. A field's name, a
/// label, a type variable and the item keep no number.
/// Raises on an item of more nodes than a minted site leaves room for.
pub fn numbered(item: Item) -> Item / {abort.raise} =
  within(numbering(|s: Span, k: Int| { ..s, site: k }, item, 1))

/// `item` with each node a maker made numbered past every number the item holds. A made node is one
/// with no number; every other node keeps its number, so what the item was written with keeps its
/// sites.
pub fn numbered_made(item: Item) -> Item / {abort.raise} =
  within(
    numbering(
      |s: Span, k: Int| if s.site == 0 { { ..s, site: k } } else { s },
      item,
      last_site(item) + 1,
    ),
  )

effect seen {
  write site(at: Int) -> Unit
}

/// The highest number a node of `item` holds, a minted one aside.
fn last_site(item: Item) -> Int / {abort.raise} =
  handle {
    numbering(
      |s: Span, k: Int| {
        seen.site(s.site);
        s
      },
      item,
      1,
    ).n
  } with {
    var top: Int = 0,
    seen.site(at) -> if at < site_digit() && at > top {
      top = at;
    } else { () },
    return walked -> top,
  }

fn within(out: { item: Item, n: Int }) -> Item / {abort.raise} =
  if out.n >= site_digit() { panic("an item of more nodes than its sites can number") }
  else { out.item }

/// `item` with each node marked by `mark` with its number, counting from `n`, and the next number.
fn numbering<| e>(
  mark: (Span, Int) -> Span / e,
  item: Item,
  n: Int,
) -> { item: Item, n: Int } / {abort.raise | e} =
  match item {
    IFn(d) -> {
      let f = numbered_fn(mark, d, n);
      { item: IFn(f.d), n: f.n }
    },
    IType(d) -> {
      let body = match d.body {
        TDAlias(t) -> {
          let o = num_type(mark, t, n + 1);
          { b: TDAlias(o.t), n: o.n }
        },
        TDNominal(t) -> {
          let o = num_type(mark, t, n + 1);
          { b: TDNominal(o.t), n: o.n }
        },
        TDSum(vs) -> {
          let o = vs.fold(
            { vs: [], n: n + 1 },
            |acc: { vs: List<VariantDef>, n: Int }, v: VariantDef| {
              let fs = num_types(mark, v.fields, acc.n + 1);
              { vs: acc.vs.push({ ..v, name: named(mark, v.name, acc.n), fields: fs.ts }), n: fs.n }
            },
          );
          { b: TDSum(o.vs), n: o.n }
        },
        other -> { b: other, n: n + 1 },
      };
      { item: IType({ ..d, name: named(mark, d.name, n), body: body.b }), n: body.n }
    },
    IEffect(d) -> {
      let ops = d.ops.fold({ ops: [], n: n + 1 }, |acc: { ops: List<OpDef>, n: Int }, op: OpDef| {
        let ps = num_types(mark, op.params, acc.n + 1);
        let r = num_type(mark, op.ret, ps.n);
        let documented = idents(mark, op.param_names, r.n);
        {
          ops: acc.ops.push({
            ..op,
            name: named(mark, op.name, acc.n),
            params: ps.ts,
            ret: r.t,
            param_names: documented.names,
          }),
          n: documented.n,
        }
      });
      { item: IEffect({ ..d, name: named(mark, d.name, n), ops: ops.ops }), n: ops.n }
    },
    IDerive(d) -> { item: IDerive({ ..d, target: named(mark, d.target, n) }), n: n + 1 },
    IInstance(d) ->
      {
        item: IInstance({ ..d, target: named(mark, d.target, n), by: named(mark, d.by, n + 1) }),
        n: n + 2,
      },
    INumeric(d) -> {
      let ops = idents(mark, d.ops.map(|x: NumericOp| x.by), n + 1);
      {
        item: INumeric({
          ..d,
          target: named(mark, d.target, n),
          ops: range(0, d.ops.len()).map(|i: Int| { ..d.ops.get(i), by: ops.names.get(i) }),
        }),
        n: ops.n,
      }
    },
    IEffectSet(d) -> {
      let atoms = num_atoms(mark, d.atoms, n + 1);
      let includes = num_qnames(mark, d.includes, atoms.n);
      {
        item: IEffectSet({
          ..d,
          name: named(mark, d.name, n),
          atoms: atoms.xs,
          includes: includes.qs,
        }),
        n: includes.n,
      }
    },
    ITest(d) -> match d.cases {
      None -> {
        let b: Num = num_expr(mark, d.body, n);
        { item: ITest({ ..d, body: b.e }), n: b.n }
      },
      Some(c) -> {
        let ty = num_type(mark, c.ty, n + 3);
        let table: Num = num_expr(mark, c.table, ty.n);
        let label: Num = num_expr(mark, c.label, table.n);
        let b: Num = num_expr(mark, d.body, label.n);
        {
          item: ITest({
            ..d,
            cases: Some({
              ..c,
              for_span: mark(c.for_span, n),
              in_span: mark(c.in_span, n + 1),
              binder: named(mark, c.binder, n + 2),
              ty: ty.t,
              table: table.e,
              label: label.e,
            }),
            body: b.e,
          }),
          n: b.n,
        }
      },
    },
    ILaw(d) -> {
      let bs = binders(mark, d.binders, n);
      let g: { e: Option<Expr>, n: Int } = maybe(mark, d.guard, bs.n);
      let b: Num = num_expr(mark, d.body, g.n);
      { item: ILaw({ ..d, binders: bs.bs, guard: g.e, body: b.e }), n: b.n }
    },
    ISchema(d) -> {
      let ps = binders(mark, d.params, n);
      let bs = binders(mark, d.binders, ps.n);
      let g: { e: Option<Expr>, n: Int } = maybe(mark, d.guard, bs.n);
      let b: Num = num_expr(mark, d.body, g.n);
      { item: ISchema({ ..d, params: ps.bs, binders: bs.bs, guard: g.e, body: b.e }), n: b.n }
    },
    IExtern(d) -> {
      let ps: Params = params(mark, d.params, n + 1);
      let r = num_type(mark, d.ret, ps.n);
      let e = num_maybe_row(mark, d.effects, r.n);
      let sp = clauses(mark, d.spec, e.n);
      {
        item: IExtern({
          ..d,
          name: named(mark, d.name, n),
          params: ps.ps,
          ret: r.t,
          effects: e.r,
          spec: sp.cs,
        }),
        n: sp.n,
      }
    },
  }

/// `copied`, the default the call at `at` takes for its parameter `slot`, with every node and name
/// in it at `at`: what a check files of one call's copy is that call's own, and formatting the
/// default moves none of it. Each takes a site minted from the call, by the parameter and its place
/// in a walk of the default.
pub fn placed(copied: Expr, at: Span, slot: Int) -> Expr =
  num_expr(|_: Span, n: Int| minted(at, role_member_default(slot) + n), copied, 0).e

type Num = { e: Expr, n: Int }

type Nums = { es: List<Expr>, n: Int }

type NumPat = { p: Pattern, n: Int }

type Params = { ps: List<Param>, n: Int }

fn numbered_fn<| e>(mark: (Span, Int) -> Span / e, d: FnDef, n: Int) -> { d: FnDef, n: Int } / e = {
  let ps: Params = params(mark, d.params, n + 1);
  let r = num_maybe_type(mark, d.ret, ps.n);
  let e = num_maybe_row(mark, d.effects, r.n);
  let b: Num = num_expr(mark, d.body, e.n);
  let sp = clauses(mark, d.spec, b.n);
  let m: { e: Option<Expr>, n: Int } = maybe(mark, d.decreases, sp.n);
  let returns = match d.returns {
    Some(ReturnsParam(p)) -> Some(ReturnsParam(named(mark, p, m.n))),
    r -> r,
  };
  {
    d: {
      ..d,
      name: named(mark, d.name, n),
      params: ps.ps,
      ret: r.t,
      effects: e.r,
      body: b.e,
      spec: sp.cs,
      decreases: m.e,
      returns: returns,
    },
    n: m.n + 1,
  }
}

fn params<| e>(mark: (Span, Int) -> Span / e, ps: List<Param>, n: Int) -> Params / e =
  ps.fold({ ps: [], n: n }, |acc: Params, p: Param| {
    let ty = num_maybe_type(mark, p.ty, acc.n + 1);
    let cost = maybe_named(mark, p.cost, ty.n);
    let space = maybe_named(mark, p.space, cost.n);
    let d: { e: Option<Expr>, n: Int } = maybe(mark, p.default, space.n);
    {
      ps: acc.ps.push({
        ..p,
        name: named(mark, p.name, acc.n),
        span: mark(p.span, acc.n),
        ty: ty.t,
        cost: cost.name,
        space: space.name,
        default: d.e,
      }),
      n: d.n,
    }
  })

fn named<| e>(mark: (Span, Int) -> Span / e, name: Ident, n: Int) -> Ident / e =
  { ..name, span: mark(name.span, n) }

fn idents<| e>(
  mark: (Span, Int) -> Span / e,
  names: List<Ident>,
  n: Int,
) -> { names: List<Ident>, n: Int } / e =
  names.fold({ names: [], n: n }, |acc: { names: List<Ident>, n: Int }, name: Ident|
    { names: acc.names.push(named(mark, name, acc.n)), n: acc.n + 1 })

fn maybe_named<| e>(
  mark: (Span, Int) -> Span / e,
  name: Option<Ident>,
  n: Int,
) -> { name: Option<Ident>, n: Int } / e =
  match name {
    Some(x) -> { name: Some(named(mark, x, n)), n: n + 1 },
    None -> { name: None, n: n },
  }

fn clauses<| e>(
  mark: (Span, Int) -> Span / e,
  cs: List<SpecClause>,
  n: Int,
) -> { cs: List<SpecClause>, n: Int } / e =
  cs.fold({ cs: [], n: n }, |acc: { cs: List<SpecClause>, n: Int }, c: SpecClause| {
    let o: Num = num_expr(mark, c.expr, acc.n + 1);
    { cs: acc.cs.push({ ..c, span: mark(c.span, acc.n), expr: o.e }), n: o.n }
  })

fn binders<| e>(
  mark: (Span, Int) -> Span / e,
  bs: List<Binder>,
  n: Int,
) -> { bs: List<Binder>, n: Int } / e =
  bs.fold({ bs: [], n: n }, |acc: { bs: List<Binder>, n: Int }, b: Binder| {
    let t = num_type(mark, b.ty, acc.n + 1);
    {
      bs: acc.bs.push({
        ..b,
        span: mark(b.span, acc.n),
        name: named(mark, b.name, acc.n),
        ty: t.t,
      }),
      n: t.n,
    }
  })

/// `q`'s module's name, then its own, numbered from `n` on.
fn num_qname<| e>(mark: (Span, Int) -> Span / e, q: QName, n: Int) -> { q: QName, n: Int } / e =
  match q.module {
    Some(m) ->
      { q: { ..q, module: Some(named(mark, m, n)), name: named(mark, q.name, n + 1) }, n: n + 2 },
    None -> { q: { ..q, name: named(mark, q.name, n) }, n: n + 1 },
  }

fn num_type<| e>(
  mark: (Span, Int) -> Span / e,
  t: TypeExpr,
  n: Int,
) -> { t: TypeExpr, n: Int } / e =
  match t {
    TCon(c) -> {
      let q = num_qname(mark, c.name, n);
      let args = num_types(mark, c.args, q.n);
      let rows = c.rows.fold(
        { rs: [], n: args.n },
        |acc: { rs: List<RowExpr>, n: Int }, r: RowExpr| {
          let o = num_row(mark, r, acc.n);
          { rs: acc.rs.push(o.r), n: o.n }
        },
      );
      { t: TCon({ ..c, name: q.q, args: args.ts, rows: rows.rs }), n: rows.n }
    },
    TFn(f) -> {
      let ps = num_types(mark, f.params, n);
      let r = num_type(mark, f.ret, ps.n);
      let e = num_maybe_row(mark, f.effects, r.n);
      { t: TFn({ ..f, params: ps.ts, ret: r.t, effects: e.r }), n: e.n }
    },
    TRecord(r) -> {
      let fs = r.fields.fold(
        { fs: [], n: n },
        |acc: { fs: List<{ name: Ident, ty: TypeExpr }>, n: Int }, f: { name: Ident, ty: TypeExpr }| {
          let o = num_type(mark, f.ty, acc.n);
          { fs: acc.fs.push({ name: f.name, ty: o.t }), n: o.n }
        },
      );
      { t: TRecord({ ..r, fields: fs.fs }), n: fs.n }
    },
    other -> { t: other, n: n },
  }

fn num_types<| e>(
  mark: (Span, Int) -> Span / e,
  ts: List<TypeExpr>,
  n: Int,
) -> { ts: List<TypeExpr>, n: Int } / e =
  ts.fold({ ts: [], n: n }, |acc: { ts: List<TypeExpr>, n: Int }, t: TypeExpr| {
    let o = num_type(mark, t, acc.n);
    { ts: acc.ts.push(o.t), n: o.n }
  })

fn num_maybe_type<| e>(
  mark: (Span, Int) -> Span / e,
  t: Option<TypeExpr>,
  n: Int,
) -> { t: Option<TypeExpr>, n: Int } / e =
  match t {
    Some(x) -> {
      let o = num_type(mark, x, n);
      { t: Some(o.t), n: o.n }
    },
    None -> { t: None, n: n },
  }

fn num_atoms<| e>(
  mark: (Span, Int) -> Span / e,
  atoms: List<AtomExpr>,
  n: Int,
) -> { xs: List<AtomExpr>, n: Int } / e =
  atoms.fold({ xs: [], n: n }, |acc: { xs: List<AtomExpr>, n: Int }, a: AtomExpr| {
    let e = num_qname(mark, a.eff, acc.n);
    let op = maybe_named(mark, a.op, e.n);
    { xs: acc.xs.push({ ..a, eff: e.q, op: op.name }), n: op.n }
  })

fn num_qnames<| e>(
  mark: (Span, Int) -> Span / e,
  qs: List<QName>,
  n: Int,
) -> { qs: List<QName>, n: Int } / e =
  qs.fold({ qs: [], n: n }, |acc: { qs: List<QName>, n: Int }, q: QName| {
    let o = num_qname(mark, q, acc.n);
    { qs: acc.qs.push(o.q), n: o.n }
  })

fn num_row<| e>(mark: (Span, Int) -> Span / e, r: RowExpr, n: Int) -> { r: RowExpr, n: Int } / e = {
  let atoms = num_atoms(mark, r.atoms, n);
  let aliases = num_qnames(mark, r.aliases, atoms.n);
  { r: { ..r, atoms: atoms.xs, aliases: aliases.qs }, n: aliases.n }
}

fn num_maybe_row<| e>(
  mark: (Span, Int) -> Span / e,
  r: Option<RowExpr>,
  n: Int,
) -> { r: Option<RowExpr>, n: Int } / e =
  match r {
    Some(x) -> {
      let o = num_row(mark, x, n);
      { r: Some(o.r), n: o.n }
    },
    None -> { r: None, n: n },
  }

fn maybe<| e>(
  mark: (Span, Int) -> Span / e,
  x: Option<Expr>,
  n: Int,
) -> { e: Option<Expr>, n: Int } / e =
  match x {
    Some(y) -> {
      let o: Num = num_expr(mark, y, n);
      { e: Some(o.e), n: o.n }
    },
    None -> { e: None, n: n },
  }

/// `e` numbered from `n` on, and the number after its last node.
fn num_expr<| e>(mark: (Span, Int) -> Span / e, e: Expr, n: Int) -> Num / e = {
  let each = |xs: List<Expr>, from: Int|
    xs.fold({ es: [], n: from }, |acc: Nums, x: Expr| {
      let o: Num = num_expr(mark, x, acc.n);
      { es: acc.es.push(o.e), n: o.n }
    });
  let opt = |x: Option<Expr>, from: Int|
    match x {
      Some(y) -> {
        let o: Num = num_expr(mark, y, from);
        { e: Some(o.e), n: o.n }
      },
      None -> { e: None, n: from },
    };
  let fields = |fs: List<RecField>, from: Int|
    fs.fold({ fs: [], n: from }, |acc: { fs: List<RecField>, n: Int }, f: RecField| {
      let v: Num = num_expr(mark, f.value, acc.n);
      { fs: acc.fs.push({ ..f, value: v.e }), n: v.n }
    });
  match e {
    ELit(l) -> { e: ELit({ ..l, span: mark(l.span, n) }), n: n + 1 },
    EVar(v) -> {
      let m = maybe_named(mark, v.name.module, n + 1);
      {
        e: EVar({
          span: mark(v.span, n),
          name: { ..v.name, module: m.name, name: named(mark, v.name.name, n) },
        }),
        n: m.n,
      }
    },
    EBad(b) -> { e: EBad({ span: mark(b.span, n) }), n: n + 1 },
    EHole(h) -> { e: EHole({ ..h, span: mark(h.span, n) }), n: n + 1 },
    EBinary(b) -> {
      let l: Num = num_expr(mark, b.lhs, n + 1);
      let r: Num = num_expr(mark, b.rhs, l.n);
      { e: EBinary({ ..b, span: mark(b.span, n), lhs: l.e, rhs: r.e }), n: r.n }
    },
    EUnary(u) -> {
      let o: Num = num_expr(mark, u.operand, n + 1);
      { e: EUnary({ ..u, span: mark(u.span, n), operand: o.e }), n: o.n }
    },
    ELambda(l) -> {
      let ps: Params = params(mark, l.params, n + 1);
      let r = num_maybe_type(mark, l.ret, ps.n);
      let b: Num = num_expr(mark, l.body, r.n);
      { e: ELambda({ span: mark(l.span, n), params: ps.ps, ret: r.t, body: b.e }), n: b.n }
    },
    EApp(a) -> {
      let f: Num = num_expr(mark, a.func, n + 1);
      let xs: Nums = each(a.args, f.n);
      let ns = a.named.fold(
        { ns: [], n: xs.n },
        |acc: { ns: List<NamedArg>, n: Int }, arg: NamedArg| {
          let o: Num = num_expr(mark, arg.value, acc.n);
          { ns: acc.ns.push({ ..arg, value: o.e }), n: o.n }
        },
      );
      { e: EApp({ ..a, span: mark(a.span, n), func: f.e, args: xs.es, named: ns.ns }), n: ns.n }
    },
    EIf(i) -> {
      let c: Num = num_expr(mark, i.cond, n + 1);
      let t: Num = num_expr(mark, i.then_branch, c.n);
      let el: Num = num_expr(mark, i.else_branch, t.n);
      { e: EIf({ span: mark(i.span, n), cond: c.e, then_branch: t.e, else_branch: el.e }), n: el.n }
    },
    EMatch(m) -> {
      let sc: Num = num_expr(mark, m.scrutinee, n + 1);
      let arms = m.arms.fold(
        { arms: [], n: sc.n },
        |acc: { arms: List<MatchArm>, n: Int }, arm: MatchArm| {
          let pt: NumPat = num_pat(mark, arm.pat, acc.n + 1);
          let g: { e: Option<Expr>, n: Int } = opt(arm.guard, pt.n);
          let b: Num = num_expr(mark, arm.body, g.n);
          {
            arms: acc.arms.push({ pat: pt.p, guard: g.e, body: b.e, span: mark(arm.span, acc.n) }),
            n: b.n,
          }
        },
      );
      { e: EMatch({ span: mark(m.span, n), scrutinee: sc.e, arms: arms.arms }), n: arms.n }
    },
    EBlock(b) -> {
      let st = b.stmts.fold(
        { stmts: [], n: n + 1 },
        |acc: { stmts: List<Stmt>, n: Int }, stmt: Stmt|
          match stmt {
            SLet(l) -> {
              let pt: NumPat = num_pat(mark, l.pat, acc.n + 1);
              let ty = num_maybe_type(mark, l.ty, pt.n);
              let v: Num = num_expr(mark, l.value, ty.n);
              {
                stmts: acc.stmts.push(
                  SLet({ ..l, span: mark(l.span, acc.n), pat: pt.p, ty: ty.t, value: v.e }),
                ),
                n: v.n,
              }
            },
            SLetElse(l) -> {
              let pt: NumPat = num_pat(mark, l.pat, acc.n + 1);
              let ty = num_maybe_type(mark, l.ty, pt.n);
              let v: Num = num_expr(mark, l.value, ty.n);
              let fb: Num = num_expr(mark, l.fallback, v.n);
              {
                stmts: acc.stmts.push(
                  SLetElse({
                    ..l,
                    span: mark(l.span, acc.n),
                    pat: pt.p,
                    ty: ty.t,
                    value: v.e,
                    fallback: fb.e,
                  }),
                ),
                n: fb.n,
              }
            },
            SExpr(x) -> {
              let o: Num = num_expr(mark, x, acc.n);
              { stmts: acc.stmts.push(SExpr(o.e)), n: o.n }
            },
            SAssign(x) -> {
              let v: Num = num_expr(mark, x.value, acc.n + 1);
              {
                stmts: acc.stmts.push(
                  SAssign({
                    span: mark(x.span, acc.n),
                    name: named(mark, x.name, acc.n),
                    value: v.e,
                  }),
                ),
                n: v.n,
              }
            },
          },
      );
      let t: { e: Option<Expr>, n: Int } = opt(b.tail, st.n);
      { e: EBlock({ span: mark(b.span, n), tail: t.e, stmts: st.stmts }), n: t.n }
    },
    ERecord(r) -> {
      let fs: { fs: List<RecField>, n: Int } = fields(r.fields, n + 1);
      { e: ERecord({ span: mark(r.span, n), fields: fs.fs }), n: fs.n }
    },
    ERecordUpdate(r) -> {
      let base: Num = num_expr(mark, r.base, n + 1);
      let fs: { fs: List<RecField>, n: Int } = fields(r.fields, base.n);
      { e: ERecordUpdate({ span: mark(r.span, n), base: base.e, fields: fs.fs }), n: fs.n }
    },
    ETry(t) -> {
      let o: Num = num_expr(mark, t.operand, n + 1);
      { e: ETry({ span: mark(t.span, n), operand: o.e }), n: o.n }
    },
    EField(f) -> {
      let base: Num = num_expr(mark, f.base, n + 1);
      { e: EField({ ..f, span: mark(f.span, n), base: base.e }), n: base.n }
    },
    EList(l) -> {
      let xs: Nums = each(l.items, n + 1);
      { e: EList({ span: mark(l.span, n), items: xs.es }), n: xs.n }
    },
    EPerform(p) -> {
      let m = maybe_named(mark, p.eff.module, n + 1);
      let xs: Nums = each(p.args, m.n + 1);
      {
        e: EPerform({
          ..p,
          span: mark(p.span, n),
          eff: { ..p.eff, module: m.name, name: named(mark, p.eff.name, n) },
          op: named(mark, p.op, m.n),
          args: xs.es,
        }),
        n: xs.n,
      }
    },
    EHandle(h) -> {
      let vs = h.vars.fold(
        { vs: [], n: n + 1 },
        |acc: { vs: List<HandlerVar>, n: Int }, v: HandlerVar| {
          let ty = num_maybe_type(mark, v.ty, acc.n + 2);
          let o: Num = num_expr(mark, v.init, ty.n);
          {
            vs: acc.vs.push({
              span: mark(v.span, acc.n),
              name: named(mark, v.name, acc.n + 1),
              ty: ty.t,
              init: o.e,
            }),
            n: o.n,
          }
        },
      );
      let body: Num = num_expr(mark, h.body, vs.n);
      let cs = h.clauses.fold(
        { cs: [], n: body.n },
        |acc: { cs: List<HandleClause>, n: Int }, c: HandleClause| {
          let eff = num_qname(mark, c.eff, acc.n + 1);
          let ps = idents(mark, c.params, eff.n + 1);
          let label = maybe_named(mark, c.label_binder, ps.n);
          let resume = maybe_named(mark, c.resume, label.n);
          let o: Num = num_expr(mark, c.body, resume.n);
          {
            cs: acc.cs.push({
              ..c,
              span: mark(c.span, acc.n),
              eff: eff.q,
              op: named(mark, c.op, eff.n),
              params: ps.names,
              label_binder: label.name,
              resume: resume.name,
              body: o.e,
            }),
            n: o.n,
          }
        },
      );
      let ret: { r: Option<ReturnClause>, n: Int } = match h.ret {
        Some(r) -> {
          let o: Num = num_expr(mark, r.body, cs.n + 2);
          {
            r: Some({
              ..r,
              span: mark(r.span, cs.n),
              binder: named(mark, r.binder, cs.n + 1),
              body: o.e,
            }),
            n: o.n,
          }
        },
        None -> { r: None, n: cs.n },
      };
      {
        e: EHandle({
          span: mark(h.span, n),
          body: body.e,
          ret: ret.r,
          clauses: cs.cs,
          vars: vs.vs,
        }),
        n: ret.n,
      }
    },
    EWithHold(w) -> {
      let a: Num = num_expr(mark, w.acquire, n + 1);
      let r: Num = num_expr(mark, w.release, a.n);
      let b: Num = num_expr(mark, w.body, r.n + 1);
      {
        e: EWithHold({
          ..w,
          span: mark(w.span, n),
          acquire: a.e,
          release: r.e,
          binder: named(mark, w.binder, r.n),
          body: b.e,
        }),
        n: b.n,
      }
    },
    ESimulate(x) -> {
      let b: Num = num_expr(mark, x.body, n + 1);
      { e: ESimulate({ span: mark(x.span, n), body: b.e }), n: b.n }
    },
    EParallel(x) -> {
      let xs: Nums = each(x.branches, n + 1);
      { e: EParallel({ span: mark(x.span, n), branches: xs.es }), n: xs.n }
    },
    ETryBlock(t) -> {
      let raised = match t.raise {
        Some(r) -> {
          let eff = num_qname(mark, r.eff, n + 1);
          { r: Some({ eff: eff.q, op: named(mark, r.op, eff.n) }), n: eff.n + 1 }
        },
        None -> { r: None, n: n + 1 },
      };
      let b: Num = num_expr(mark, t.body, raised.n);
      { e: ETryBlock({ span: mark(t.span, n), raise: raised.r, body: b.e }), n: b.n }
    },
    // Each text a tagged literal writes is a node its call is written with.
    ETagged(t) -> {
      let hs = t.holes.fold({ hs: [], n: n + 3 }, |acc: { hs: List<Hole>, n: Int }, h: Hole| {
        let o: Num = num_expr(mark, h.value, acc.n + 1);
        { hs: acc.hs.push({ ..h, quoted: mark(h.quoted, acc.n), value: o.e }), n: o.n }
      });
      {
        e: ETagged({
          ..t,
          span: mark(t.span, n),
          quoted: mark(t.quoted, n + 1),
          tag: named(mark, t.tag, n + 2),
          holes: hs.hs,
        }),
        n: hs.n,
      }
    },
  }
}

// --- Tests ------------------------------------------------------------------

/// The site of each expression of the item named `name` of `src`, numbered, in a walk of it.
fn sites_of(src: Bytes, name: Bytes) -> List<Int> / {abort.raise} = {
  let m = numbered_module(parse(src).node);
  picked_in({ ..m, items: m.items.filter(|item: Item| item_named(item, name)) }, |_: Expr|
    true).map(|e: Expr| expr_span(e).site)
}

fn item_named(item: Item, name: Bytes) -> Bool =
  match item { IFn(d) -> d.name.name == name, ITest(t) -> t.name == name, _ -> false }

test "an item's sites are its own: an edit to another item, or a cut of its module, moves none" {
  let g = b"fn g(y: Int) -> Int = if y > 0 { y } else { 0 - y }\n";
  let before = sites_of(Bytes::concat_all([b"fn f(x: Int) -> Int = x + 1\n", g]), b"g");
  assert(before.len() > 4);
  assert_eq(before.filter(|s: Int| s == 0), []);
  assert_eq(before.unique().len(), before.len());
  let edited = b"/// Doubled.\nfn f(x: Int) -> Int = { let z = x * 2; z + 1 }\ntest \"t\" { () }\n";
  assert_eq(sites_of(edited.concat(g), b"g"), before);
  assert_eq(sites_of(g, b"g"), before)
}

test "a minted site is no numbered one, nor one another node or role mints" {
  let src = b"fn f(xs: List<Int>, d: Int = 3) -> Int = match xs { [x, ..] -> try { x + d }, [] -> d }\n";
  let m = numbered_module(parse(src).node);
  let spans = picked_in(m, |_: Expr| true).map(expr_span);
  let numbered = spans.map(|s: Span| s.site);
  let roles = [role_try_return(), role_detached(), role_try_arg(3), role_member_default(2) + 5];
  let made = spans.flat_map(|s: Span| roles.map(|k: Int| minted(s, k).site));
  assert_eq(made.filter(|s: Int| numbered.contains(s)), []);
  assert_eq(made.unique().len(), made.len());
  assert_eq(made.filter(minted_too_deep), [])
}

/// `p` numbered from `n` on, and the number after its last node.
fn num_pat<| e>(mark: (Span, Int) -> Span / e, p: Pattern, n: Int) -> NumPat / e = {
  let each = |ps: List<Pattern>, from: Int|
    ps.fold({ ps: [], n: from }, |acc: { ps: List<Pattern>, n: Int }, x: Pattern| {
      let o: NumPat = num_pat(mark, x, acc.n);
      { ps: acc.ps.push(o.p), n: o.n }
    });
  match p {
    PWild(w) -> { p: PWild({ span: mark(w.span, n) }), n: n + 1 },
    PVar(v) -> { p: PVar({ span: mark(v.span, n), name: named(mark, v.name, n) }), n: n + 1 },
    PLit(l) -> { p: PLit({ ..l, span: mark(l.span, n) }), n: n + 1 },
    PRange(r) -> { p: PRange({ ..r, span: mark(r.span, n) }), n: n + 1 },
    PCtor(c) -> {
      let q = num_qname(mark, c.name, n + 1);
      let xs: { ps: List<Pattern>, n: Int } = each(c.args, q.n);
      { p: PCtor({ span: mark(c.span, n), name: q.q, args: xs.ps }), n: xs.n }
    },
    PRecord(r) -> {
      let fs = r.fields.fold(
        { fs: [], n: n + 1 },
        |acc: { fs: List<{ name: Ident, pat: Pattern }>, n: Int }, f: { name: Ident, pat: Pattern }| {
          let o: NumPat = num_pat(mark, f.pat, acc.n);
          { fs: acc.fs.push({ name: f.name, pat: o.p }), n: o.n }
        },
      );
      { p: PRecord({ ..r, span: mark(r.span, n), fields: fs.fs }), n: fs.n }
    },
    PList(l) -> {
      let xs: { ps: List<Pattern>, n: Int } = each(l.items, n + 1);
      let rest: { p: Option<Pattern>, n: Int } = match l.rest {
        Some(x) -> {
          let o: NumPat = num_pat(mark, x, xs.n);
          { p: Some(o.p), n: o.n }
        },
        None -> { p: None, n: xs.n },
      };
      { p: PList({ span: mark(l.span, n), rest: rest.p, items: xs.ps }), n: rest.n }
    },
    POr(o) -> {
      let xs: { ps: List<Pattern>, n: Int } = each(o.alts, n + 1);
      { p: POr({ span: mark(o.span, n), alts: xs.ps }), n: xs.n }
    },
    PBad(b) -> { p: PBad({ span: mark(b.span, n) }), n: n + 1 },
  }
}
