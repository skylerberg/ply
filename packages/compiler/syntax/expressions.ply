import std.derive.children
import compiler.syntax.parsing (tuple_field_name, Span, Identifier, QName, Input, Parser,
                                ParseOutput, PartialList, ParseDiagnostic, span_to, dummy_span,
                                no_identifier, bare, unexpected, error_at, error_at_and,
                                push_diagnostic, error_here, unclosed, parsed_or, failed,
                                default_not_allowed, argument_order, token_kind, token_kind_at,
                                current_span, at_token, at_eof, at_identifier_text, advance, eat,
                                expect, expect_close, expect_identifier, expect_binder,
                                expect_field_name, report_duplicate_fields, keyword_pun_error,
                                with_no_brace, too_deep, start, qualified_name, starts_upper,
                                comma_list, token_lparen, token_rparen, token_lbrace, token_rbrace,
                                token_lbracket, token_rbracket, token_comma, token_semi,
                                token_colon, token_coloncolon, token_dot, token_dotdot, token_arrow,
                                token_eq, token_pipe, token_pipepipe, token_question, token_star,
                                keyword_let, keyword_if, keyword_else, keyword_with, dump_node,
                                dump_word, dump_list, dump_opt, dump_identifier,
                                dump_qualified_name, dump_diagnostics, with_no_pipe, advance_n,
                                token_at, token_gt, token_lt, max_depth, span_bin, span_between,
                                synthetic_span, synthetic_span_at, role_detached, role_simulated,
                                role_try_return, role_try_clause, role_try_ok, role_try_err,
                                role_try_arguments_record, role_tag_parser, role_tag_filler,
                                role_tag_parse, role_tag_fill, role_tag_texts, role_tag_holes,
                                role_case_block, role_case_table_let, role_case_table_binder,
                                role_case_call, role_case_callee, role_case_table_read,
                                role_case_label_lambda, role_case_callee_module,
                                role_case_table_module, role_case_table_name, role_case_label_param,
                                role_case_let, role_case_binder, role_case_index_read,
                                role_case_identity_read)
import compiler.syntax.lexer (TokenKind, Identifier, IntLiteral, FixedLiteral, WideLiteral,
                              FloatLiteral, DecimalLiteral, StringLiteral, LineString, BytesLiteral,
                              InterpolatedHead, InterpolatedMiddle, InterpolatedTail, CharLiteral,
                              Keyword, Punctuation)
import std.bin
import std.bytes (ascii_of_int)
import std.list (prepend)
import compiler.syntax.type_syntax (TypeExpression, NamedTypeExpression, FunctionTypeExpression, ty,
                                    type_span, dump_type, label_name, starts_type)
import compiler.syntax.patterns (Pattern, PatternVariable, SourceLiteral, LiteralInt, LiteralFixed,
                                 LiteralWide, LiteralBool, LiteralString, LiteralBytes,
                                 LiteralFloat, LiteralDecimal, LiteralChar, LiteralUnit, pattern,
                                 pattern_span, dump_pattern, dump_literal, source_text)

pub type Expression =
  | LiteralExpression({ span: Span, literal: SourceLiteral })
  | NameExpression({ span: Span, name: QName })
  | BinaryExpression({ span: Span, operation: Bytes, left_operand: Expression, right_operand: Expression })
  | UnaryExpression({ span: Span, operation: Bytes, operand: Expression })
  | LambdaExpression({ span: Span, params: List<Param>, return_clause: Option<TypeExpression>, body: Expression })
  | CallExpression({ span: Span, function: Expression, labels: List<Identifier>, args: List<Expression>, named: List<NamedArg> })
  | IfExpression({ span: Span, cond: Expression, then_branch: Expression, else_branch: Expression })
  | MatchExpression({ span: Span, scrutinee: Expression, arms: List<MatchArm> })
  | BlockExpression({ span: Span, statements: List<Statement>, tail: Option<Expression> })
  | RecordExpression({ span: Span, fields: List<RecordLiteralField> })
  | RecordUpdateExpression({ span: Span, base: Expression, fields: List<RecordLiteralField> })
  | PropagateExpression({ span: Span, operand: Expression })
  | FieldExpression({ span: Span, base: Expression, field: Identifier })
  | ListExpression({ span: Span, items: List<Expression> })
  | PerformExpression({ span: Span, effect_name: QName, operation: Identifier, resource: Option<Identifier>, args: List<Expression> })
  | HandleExpression({ span: Span, handler_variables: List<HandlerStateVariable>, body: Expression, clauses: List<HandleClause>, return_clause: Option<ReturnClause> })
  | WithScopeExpression({ span: Span, resource: Identifier, acquire: Expression, release: Expression, binder: Identifier, body: Expression })
  | SimulateExpression({ span: Span, body: Expression })
  | ParallelExpression({ span: Span, branches: List<Expression> })
  | TaggedLiteralExpression(TaggedLiteral)
  | HoleExpression({ span: Span, text: Bytes })
  | InvalidExpression({ span: Span })
  | TryBlockExpression({ span: Span, raise: Option<RaiseName>, body: Expression })

derive children for Expression

pub type RaiseName = { effect_name: QName, operation: Identifier }

pub type TaggedLiteral = {
  span: Span,
  tag: Identifier,
  text: Bytes,
  quoted: Span,
  holes: List<Hole>,
}

pub type Hole = { value: Expression, text: Bytes, quoted: Span }

pub type RecordLiteralField = { name: Identifier, value: Expression }

pub type NamedArg = { name: Identifier, value: Expression, span: Span }

type Arg = | ArgumentByPosition(Expression) | ArgumentByName(NamedArg)

pub type Param = {
  name: Identifier,
  keep: Bool,
  ty: Option<TypeExpression>,
  cost: Option<Identifier>,
  space: Option<Identifier>,
  default: Option<Expression>,
  span: Span,
}

pub type Statement =
  | LetStatement({ span: Span, pattern: Pattern, ty: Option<TypeExpression>, value: Expression })
  | LetElseStatement({ span: Span, pattern: Pattern, ty: Option<TypeExpression>, value: Expression, fallback: Expression })
  | ExpressionStatement(Expression)
  | AssignmentStatement({ span: Span, name: Identifier, value: Expression })

pub type MatchArm = { pattern: Pattern, guard: Option<Expression>, body: Expression, span: Span }

pub type HandleClause = {
  effect_name: QName,
  operation: Identifier,
  resource: Option<Identifier>,
  wildcard_label: Bool,
  label_binder: Option<Identifier>,
  resume: Option<Identifier>,
  body: Expression,
  span: Span,
  params: List<Identifier>,
}

pub type ReturnClause = { binder: Identifier, body: Expression, span: Span }

pub type HandlerStateVariable = {
  name: Identifier,
  ty: Option<TypeExpression>,
  init: Expression,
  span: Span,
}

pub fn no_expression() -> Expression = InvalidExpression({ span: dummy_span() })

pub fn expression_span(expression: Expression) -> Span =
  match expression {
    LiteralExpression(v) -> v.span,
    NameExpression(v) -> v.span,
    BinaryExpression(v) -> v.span,
    UnaryExpression(v) -> v.span,
    LambdaExpression(v) -> v.span,
    CallExpression(v) -> v.span,
    IfExpression(v) -> v.span,
    MatchExpression(v) -> v.span,
    BlockExpression(v) -> v.span,
    RecordExpression(v) -> v.span,
    RecordUpdateExpression(v) -> v.span,
    PropagateExpression(v) -> v.span,
    FieldExpression(v) -> v.span,
    ListExpression(v) -> v.span,
    PerformExpression(v) -> v.span,
    HandleExpression(v) -> v.span,
    WithScopeExpression(v) -> v.span,
    SimulateExpression(v) -> v.span,
    ParallelExpression(v) -> v.span,
    TaggedLiteralExpression(v) -> v.span,
    HoleExpression(v) -> v.span,
    InvalidExpression(v) -> v.span,
    TryBlockExpression(v) -> v.span,
  }

pub fn simulate_closure_span(at: Span) -> Span = synthetic_span(at, role_simulated())

pub fn detached_closure_span(at: Span) -> Span = synthetic_span(at, role_detached())

pub fn exit_effect(at: Int, n: Int) -> Bytes =
  Bytes::concat_all([b"exit?", ascii_of_int(at), b"?", ascii_of_int(n)])

pub fn is_exit_effect(name: Bytes) -> Bool = name.starts_with(b"exit?")

pub fn exit_operation_name() -> Bytes = b"leave"

pub type TrySpans = {
  early_return: Span,
  clause: Span,
  ok: Span,
  err: Span,
  arguments_record: Span,
}

pub fn try_spans(at: Span) -> TrySpans =
  {
    early_return: synthetic_span(at, role_try_return()),
    clause: synthetic_span(at, role_try_clause()),
    ok: synthetic_span(at, role_try_ok()),
    err: synthetic_span(at, role_try_err()),
    arguments_record: synthetic_span(at, role_try_arguments_record()),
  }

fn tag_function(t: TaggedLiteral, name: Bytes, role: Int) -> QName = {
  let at = { ..t.tag.span, site: synthetic_span(t.span, role).site };
  { module: Some(t.tag), name: { name: name, span: at }, span: at }
}

pub fn tagged_parser(t: TaggedLiteral) -> QName =
  tag_function(t, if t.holes.len() == 0 { b"literal" } else { b"compile" }, role_tag_parser())

pub fn tagged_filler(t: TaggedLiteral) -> QName = tag_function(t, b"fill", role_tag_filler())

pub type TaggedPart = { text: Bytes, quoted: Span }

derive bin for TaggedPart

pub fn tagged_parts(t: TaggedLiteral) -> List<TaggedPart> =
  t.holes.fold([{ text: t.text, quoted: t.quoted }], |parts: List<TaggedPart>, h: Hole|
    parts.push({ text: h.text, quoted: h.quoted }))

pub fn hole_values(t: TaggedLiteral) -> List<Expression> = t.holes.map(|h: Hole| h.value)

pub fn with_hole_values(
  t: TaggedLiteral,
  values: List<Expression>,
) -> TaggedLiteral / {abort.raise} =
  { ..t, holes: range(0, t.holes.len()).map(|i: Int| { ..t.holes.get(i), value: values.get(i) }) }

fn tag_call(t: TaggedLiteral, role: Int, callee: QName, args: List<Expression>) -> Expression =
  CallExpression({
    span: synthetic_span(t.span, role),
    function: NameExpression({ span: callee.span, name: callee }),
    named: [],
    args: args,
    labels: [],
  })

pub fn tagged_call(t: TaggedLiteral) -> Expression = {
  let texts = tagged_parts(t).map(|part: TaggedPart|
    LiteralExpression({ span: part.quoted, literal: LiteralString(part.text) }));
  tag_call(t, role_tag_parse(), tagged_parser(t), if t.holes.len() == 0 { texts }
  else { [ListExpression({ span: synthetic_span(t.span, role_tag_texts()), items: texts })] })
}

pub fn tagged_fill(t: TaggedLiteral, compiled: Expression) -> Expression =
  tag_call(t, role_tag_fill(), tagged_filler(t), [
    compiled,
    ListExpression({ span: synthetic_span(t.span, role_tag_holes()), items: hole_values(t) }),
  ])

fn set_span(expression: Expression, span: Span) -> Expression =
  match expression {
    LiteralExpression(v) -> LiteralExpression({ span: span, literal: v.literal }),
    NameExpression(v) -> NameExpression({ span: span, name: v.name }),
    BinaryExpression(v) ->
      BinaryExpression({
        span: span,
        operation: v.operation,
        left_operand: v.left_operand,
        right_operand: v.right_operand,
      }),
    UnaryExpression(v) ->
      UnaryExpression({ span: span, operation: v.operation, operand: v.operand }),
    LambdaExpression(v) ->
      LambdaExpression({
        span: span,
        body: v.body,
        params: v.params,
        return_clause: v.return_clause,
      }),
    CallExpression(v) ->
      CallExpression({
        span: span,
        function: v.function,
        named: v.named,
        args: v.args,
        labels: v.labels,
      }),
    IfExpression(v) ->
      IfExpression({
        span: span,
        cond: v.cond,
        then_branch: v.then_branch,
        else_branch: v.else_branch,
      }),
    MatchExpression(v) -> MatchExpression({ span: span, scrutinee: v.scrutinee, arms: v.arms }),
    BlockExpression(v) -> BlockExpression({ span: span, tail: v.tail, statements: v.statements }),
    RecordExpression(v) -> RecordExpression({ span: span, fields: v.fields }),
    RecordUpdateExpression(v) ->
      RecordUpdateExpression({ span: span, base: v.base, fields: v.fields }),
    PropagateExpression(v) -> PropagateExpression({ span: span, operand: v.operand }),
    FieldExpression(v) -> FieldExpression({ span: span, base: v.base, field: v.field }),
    ListExpression(v) -> ListExpression({ span: span, items: v.items }),
    PerformExpression(v) ->
      PerformExpression({
        span: span,
        effect_name: v.effect_name,
        operation: v.operation,
        resource: v.resource,
        args: v.args,
      }),
    HandleExpression(v) -> HandleExpression({ ..v, span: span }),
    WithScopeExpression(v) -> WithScopeExpression({ ..v, span: span }),
    SimulateExpression(v) -> SimulateExpression({ span: span, body: v.body }),
    ParallelExpression(v) -> ParallelExpression({ span: span, branches: v.branches }),
    TaggedLiteralExpression(v) -> TaggedLiteralExpression({ ..v, span: span }),
    HoleExpression(v) -> HoleExpression({ span: span, text: v.text }),
    InvalidExpression(v) -> InvalidExpression({ span: span }),
    TryBlockExpression(v) -> TryBlockExpression({ ..v, span: span }),
  }

pub fn is_block_like(expression: Expression) -> Bool =
  match expression {
    BlockExpression(v) -> true,
    IfExpression(v) -> true,
    MatchExpression(v) -> true,
    HandleExpression(v) -> true,
    WithScopeExpression(v) -> true,
    SimulateExpression(v) -> true,
    ParallelExpression(v) -> true,
    TryBlockExpression(v) -> true,
    _ -> false,
  }

type BinaryOperator = { operator: Bytes, binding_power: Int, width: Int }

fn binary_operator(kind: TokenKind) -> Option<BinaryOperator> =
  match kind {
    Punctuation(s) -> if s == b"pipepipe" { Some({ operator: b"or", binding_power: 1, width: 1 }) }
    else if s == b"ampamp" { Some({ operator: b"and", binding_power: 2, width: 1 }) }
    else if s == b"eqeq" { Some({ operator: b"eq", binding_power: 3, width: 1 }) }
    else if s == b"bangeq" { Some({ operator: b"ne", binding_power: 3, width: 1 }) }
    else if s == b"lt" { Some({ operator: b"lt", binding_power: 3, width: 1 }) }
    else if s == b"le" { Some({ operator: b"le", binding_power: 3, width: 1 }) }
    else if s == b"gt" { Some({ operator: b"gt", binding_power: 3, width: 1 }) }
    else if s == b"ge" { Some({ operator: b"ge", binding_power: 3, width: 1 }) }
    else if s == b"pipe" { Some({ operator: b"bitor", binding_power: 4, width: 1 }) }
    else if s == b"caret" { Some({ operator: b"bitxor", binding_power: 5, width: 1 }) }
    else if s == b"amp" { Some({ operator: b"bitand", binding_power: 6, width: 1 }) }
    else if s == b"plusplus" { Some({ operator: b"concat", binding_power: 8, width: 1 }) }
    else if s == b"plus" { Some({ operator: b"add", binding_power: 9, width: 1 }) }
    else if s == b"minus" { Some({ operator: b"sub", binding_power: 9, width: 1 }) }
    else if s == b"star" { Some({ operator: b"mul", binding_power: 10, width: 1 }) }
    else if s == b"slash" { Some({ operator: b"div", binding_power: 10, width: 1 }) }
    else if s == b"percent" { Some({ operator: b"rem", binding_power: 10, width: 1 }) } else {
      call_operators().fold(None, |accumulator: Option<BinaryOperator>, o: CallOperator|
        if o.token == s { Some({ operator: o.name, binding_power: o.binding_power, width: 1 }) }
        else { accumulator })
    },
    _ -> None,
  }

pub type CallOperator = { name: Bytes, token: Bytes, text: Bytes, binding_power: Int }

pub fn call_operators() -> List<CallOperator> =
  [
    { name: b"wrap_add", token: b"pluspercent", text: b"+%", binding_power: 9 },
    { name: b"wrap_sub", token: b"minuspercent", text: b"-%", binding_power: 9 },
    { name: b"wrap_mul", token: b"starpercent", text: b"*%", binding_power: 10 },
    { name: b"saturating_add", token: b"pluspipe", text: b"+|", binding_power: 9 },
    { name: b"saturating_sub", token: b"minuspipe", text: b"-|", binding_power: 9 },
    { name: b"saturating_mul", token: b"starpipe", text: b"*|", binding_power: 10 },
  ]

pub fn call_operator(name: Bytes) -> Option<CallOperator> =
  call_operators().fold(None, |accumulator: Option<CallOperator>, o: CallOperator|
    if o.name == name { Some(o) } else { accumulator })

pub fn written_operator(function: Expression, args: List<Expression>) -> Option<CallOperator> =
  match ((function, args)) {
    (NameExpression(v), [first, _]) -> if v.name.module != None
        || v.span.start < expression_span(first).end { None }
    else { call_operator(v.name.name.name) },
    _ -> None,
  }

fn binary_node(o: BinaryOperator, at: Span, left: Expression, right: Expression) -> Expression = {
  let span = span_to(expression_span(left), expression_span(right));
  match call_operator(o.operator) {
    Some(_) ->
      CallExpression({
        span: span,
        function: NameExpression({ span: at, name: bare({ name: o.operator, span: at }) }),
        named: [],
        args: [left, right],
        labels: [],
      }),
    None ->
      BinaryExpression({
        span: span,
        operation: o.operator,
        left_operand: left,
        right_operand: right,
      }),
  }
}

fn adjacent_same_token(input: Input, parser: Parser, i: Int) -> Bool =
  token_kind_at(input, parser, i) == token_kind(input, parser)
    && token_at(input, parser, i).start == token_at(input, parser, i - 1).end

fn adjacent_same_tokens(input: Input, parser: Parser, n: Int) -> Bool =
  if n == 1 { adjacent_same_token(input, parser, 1) }
  else { adjacent_same_token(input, parser, 1) && adjacent_same_token(input, parser, 2) }

fn peek_binary_operator(input: Input, parser: Parser) -> Option<BinaryOperator> =
  if parser.no_pipe && at_token(input, parser, token_pipe()) { None }
  else if at_token(input, parser, token_gt()) && adjacent_same_tokens(input, parser, 2) {
    Some({ operator: b"ushr", binding_power: 7, width: 3 })
  } else if at_token(input, parser, token_gt()) && adjacent_same_tokens(input, parser, 1) {
    Some({ operator: b"shr", binding_power: 7, width: 2 })
  } else if at_token(input, parser, token_lt()) && adjacent_same_tokens(input, parser, 1) {
    Some({ operator: b"shl", binding_power: 7, width: 2 })
  } else { binary_operator(token_kind(input, parser)) }

pub fn expression(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} =
  binary_expression(input, parser, 1, binding_powers())

pub fn scrutinee(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match expression(input, with_no_brace(parser, !at_token(input, parser, token_lbrace()))) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

fn binding_powers() -> Int = 10

fn binary_expression(
  input: Input,
  parser: Parser,
  min_binding_power: Int,
  powers: Int,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let left = unary_expression(input, parser)?;
  iterate(left, input.token_count - left.parser.position + 1, |s: ParseOutput<Expression>|
    match peek_binary_operator(input, s.parser) {
      None -> Stop(Ok(s)),
      Some(o) -> if o.binding_power < min_binding_power { Stop(Ok(s)) }
      else if powers <= 0 { Stop(Err(too_deep(input, s.parser))) } else {
        let a = advance_n(input, s.parser, o.width);
        match binary_expression(input, a, o.binding_power + 1, powers - 1) {
          Err(q) -> Stop(Err(q)),
          Ok(right) ->
            Continue({
              parser: right.parser,
              node: binary_node(o, current_span(input, s.parser), s.node, right.node),
            }),
        }
      },
    })
}

fn unary_expression(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} =
  if input.room <= 0 { Err(too_deep(input, parser)) }
  else { unary_body({ ..input, room: input.room - 1 }, parser) }

fn unary_body(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let operator = match token_kind(input, parser) {
    Punctuation(s) -> if s == b"minus" { b"neg" }
    else if s == b"bang" { b"not" }
    else if s == b"tilde" { b"bitnot" }
    else { b"" },
    _ -> b"",
  };
  if operator == b"" { postfix_expression(input, parser) } else {
    let st = advance(input, parser);
    let { parser, node: operand } = unary_expression(input, st.parser)?;
    Ok({
      parser: parser,
      node: UnaryExpression({
        span: span_to(st.node, expression_span(operand)),
        operation: operator,
        operand: operand,
      }),
    })
  }
}

fn postfix_expression(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let first = primary_expression(input, parser)?;
  iterate(first, input.token_count - first.parser.position + 1, |s: ParseOutput<Expression>|
    if at_token(input, s.parser, token_lparen()) {
      match call_args(input, s.parser) {
        Err(q) -> Stop(Err(q)),
        Ok(a) ->
          Continue({
            parser: a.parser,
            node: CallExpression({
              span: span_to(expression_span(s.node), a.close),
              function: s.node,
              named: a.named,
              args: a.args,
              labels: [],
            }),
          }),
      }
    } else if at_label_arguments(input, s) {
      match label_call(input, s) { Err(q) -> Stop(Err(q)), Ok(r) -> Continue(r) }
    } else if at_token(input, s.parser, token_dot()) {
      match postfix_dot(input, s) { Err(q) -> Stop(Err(q)), Ok(r) -> Continue(r) }
    } else if at_token(input, s.parser, token_question()) {
      let q = advance(input, s.parser);
      Continue({
        parser: q.parser,
        node: PropagateExpression({
          span: span_to(expression_span(s.node), q.node),
          operand: s.node,
        }),
      })
    } else { Stop(Ok(s)) })
}

fn typed_name(
  input: Input,
  parser: Parser,
  g: Identifier,
) -> Result<ParseOutput<Identifier>, Parser> / {abort.raise} =
  if !starts_upper(g.name) || !at_token(input, parser, token_coloncolon()) {
    Ok({ parser: parser, node: g })
  } else {
    let { parser, node: h } = expect_identifier(
      input,
      advance(input, parser).parser,
      b"a function's name after `::`",
    )?;
    Ok({
      parser: parser,
      node: { name: Bytes::concat_all([g.name, b"::", h.name]), span: span_to(g.span, h.span) },
    })
  }

fn dotted_name(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Identifier>, Parser> / {abort.raise} = {
  let { parser, node: f } = expect_field_name(input, parser, b"a field name after `.`")?;
  if f.keyword || !at_token(input, parser, token_coloncolon()) {
    Ok({ parser: parser, node: f.name })
  } else {
    let through = advance(input, parser);
    let { parser, node: g } = expect_identifier(
      input,
      through.parser,
      b"a function's name after `::`",
    )?;
    let { parser, node: named } = typed_name(input, parser, g)?;
    if !opens_arguments(token_kind(input, parser)) {
      Err(
        error_here(
          input,
          parser,
          b"expected `(` after `m::f`, because `value.m::f(..)` calls `m::f` with `value` as the first argument",
        ),
      )
    } else {
      Ok({
        parser: parser,
        node: {
          name: Bytes::concat_all([f.name.name, b"::", named.name]),
          span: span_to(f.name.span, named.span),
        },
      })
    }
  }
}

fn postfix_dot(
  input: Input,
  s: ParseOutput<Expression>,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let is_perform = match s.node {
    NameExpression(v) -> match token_kind_at(input, s.parser, 1) {
      Identifier(n) ->
        at_token(input, s.parser, token_dot())
          && opens_arguments(token_kind_at(input, s.parser, 2)),
      _ -> false,
    },
    _ -> false,
  };
  let dot = advance(input, s.parser);
  if !is_perform {
    let { parser, node: f } = dotted_name(input, dot.parser)?;
    Ok({
      parser: parser,
      node: FieldExpression({
        span: span_to(expression_span(s.node), f.span),
        base: s.node,
        field: f,
      }),
    })
  } else {
    let eff = match s.node { NameExpression(v) -> v.name, _ -> bare(no_identifier()) };
    let { parser, node: operation } = expect_identifier(input, dot.parser, b"an operation name")?;
    let { parser, node: resource } = optional_resource(input, parser)?;
    let a = call_args(input, parser)?;
    let span = span_to(expression_span(s.node), a.close);
    Ok({
      parser: a.parser,
      node: if a.named.len() == 0 {
        PerformExpression({
          span: span,
          effect_name: eff,
          operation: operation,
          resource: resource,
          args: a.args,
        })
      } else {
        CallExpression({
          span: span,
          function: FieldExpression({
            span: span_to(expression_span(s.node), operation.span),
            base: s.node,
            field: operation,
          }),
          named: a.named,
          args: a.args,
          labels: match resource { Some(r) -> [r], None -> [] },
        })
      },
    })
  }
}

fn opens_arguments(kind: TokenKind) -> Bool = kind == token_lbracket() || kind == token_lparen()

fn at_label_arguments(input: Input, s: ParseOutput<Expression>) -> Bool / {abort.raise} =
  match s.node {
    NameExpression(v) ->
      at_token(input, s.parser, token_lbracket()) && label_args_ahead(input, s.parser),
    FieldExpression(_) ->
      at_token(input, s.parser, token_lbracket()) && label_args_ahead(input, s.parser),
    _ -> false,
  }

fn label_args_ahead(input: Input, parser: Parser) -> Bool / {abort.raise} =
  iterate(1, input.token_count - parser.position + 1, |i: Int|
    match token_kind_at(input, parser, i) {
      Identifier(n) -> if token_kind_at(input, parser, i + 1) == token_comma() { Continue(i + 2) }
      else {
        Stop(
          token_kind_at(input, parser, i + 1) == token_rbracket()
            && token_kind_at(input, parser, i + 2) == token_lparen(),
        )
      },
      _ -> Stop(false),
    })

fn label_call(
  input: Input,
  s: ParseOutput<Expression>,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let o = advance(input, s.parser);
  let { parser, node: ls } = comma_list(input, o.parser, token_rbracket(), label_name)?;
  let { parser, .. } = expect_close(input, parser, token_rbracket(), o.node, b"`]`")?;
  let a = call_args(input, parser)?;
  Ok({
    parser: a.parser,
    node: CallExpression({
      span: span_to(expression_span(s.node), a.close),
      function: s.node,
      named: a.named,
      args: a.args,
      labels: ls,
    }),
  })
}

fn optional_resource(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Option<Identifier>>, Parser> / {abort.raise} =
  if !at_token(input, parser, token_lbracket()) { Ok({ parser: parser, node: None }) } else {
    let o = advance(input, parser);
    let { parser, node: r } = expect_identifier(input, o.parser, b"a resource name inside `[..]`")?;
    let { parser, .. } = expect_close(input, parser, token_rbracket(), o.node, b"`]`")?;
    Ok({ parser: parser, node: Some(r) })
  }

type ClauseResource = { every: Bool, name: Option<Identifier>, binder: Option<Identifier> }

fn clause_resource(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<ClauseResource>, Parser> / {abort.raise} =
  if !at_token(input, parser, token_lbracket()) {
    Ok({ parser: parser, node: { every: false, name: None, binder: None } })
  } else {
    let o = advance(input, parser);
    if at_token(input, o.parser, token_star()) {
      let st = advance(input, o.parser);
      let binder = match token_kind(input, st.parser) {
        Identifier(n) -> {
          let b = advance(input, st.parser);
          Some({ parser: b.parser, node: { name: n, span: b.node } })
        },
        _ -> None,
      };
      let at_after = match binder { Some(b) -> b.parser, None -> st.parser };
      let { parser, .. } = expect_close(input, at_after, token_rbracket(), o.node, b"`]`")?;
      Ok({
        parser: parser,
        node: {
          every: true,
          name: None,
          binder: match binder { Some(b) -> Some(b.node), None -> None },
        },
      })
    } else {
      let { parser, node: r } = expect_identifier(
        input,
        o.parser,
        b"a resource name or `*` inside `[..]`",
      )?;
      let { parser, .. } = expect_close(input, parser, token_rbracket(), o.node, b"`]`")?;
      Ok({ parser: parser, node: { every: false, name: Some(r), binder: None } })
    }
  }

type CallArguments = { parser: Parser, close: Span, named: List<NamedArg>, args: List<Expression> }

fn call_args(input: Input, parser: Parser) -> Result<CallArguments, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match call_args_inner(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(a) ->
      Ok({ parser: with_no_brace(a.parser, saved), close: a.close, named: a.named, args: a.args }),
  }
}

fn call_args_inner(input: Input, parser: Parser) -> Result<CallArguments, Parser> / {abort.raise} = {
  let { parser, node: o } = expect(
    input,
    parser,
    token_lparen(),
    b"`(` to start the argument list",
  )?;
  let { parser, node: parsed } = comma_list(input, parser, token_rparen(), call_arg)?;
  let { parser, node: close_paren } = expect_close(
    input,
    parser,
    token_rparen(),
    o,
    b"`)` to close the arguments",
  )?;
  let split_arguments = split_args(parser, parsed);
  Ok({
    parser: split_arguments.parser,
    close: close_paren,
    named: split_arguments.named,
    args: split_arguments.args,
  })
}

fn call_arg(input: Input, parser: Parser) -> Result<ParseOutput<Arg>, Parser> / {abort.raise} =
  match token_kind(input, parser) {
    Identifier(n) -> if token_kind_at(input, parser, 1) == token_colon() {
      named_arg(input, parser, n)
    } else { positional_arg(input, parser) },
    _ -> positional_arg(input, parser),
  }

fn positional_arg(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Arg>, Parser> / {abort.raise} = {
  let { parser, node: e } = expression(input, parser)?;
  Ok({ parser: parser, node: ArgumentByPosition(e) })
}

fn named_arg(
  input: Input,
  parser: Parser,
  text: Bytes,
) -> Result<ParseOutput<Arg>, Parser> / {abort.raise} = {
  let name = { name: text, span: current_span(input, parser) };
  let a = advance(input, parser);
  let b = advance(input, a.parser);
  let { parser, node: v } = expression(input, b.parser)?;
  Ok({
    parser: parser,
    node: ArgumentByName({ name: name, value: v, span: span_to(name.span, expression_span(v)) }),
  })
}

type Split = { parser: Parser, first: Option<Span>, named: List<NamedArg>, args: List<Expression> }

fn split_args(parser: Parser, parsed: List<Arg>) -> Split =
  parsed.fold({ parser: parser, first: None, named: [], args: [] }, |s: Split, a: Arg|
    match a {
      ArgumentByPosition(e) ->
        {
          first: s.first,
          named: s.named,
          parser: match s.first {
            None -> s.parser,
            Some(f) ->
              push_diagnostic(
                s.parser,
                error_at_and(
                  argument_order(),
                  expression_span(e),
                  b"a positional argument cannot follow a named one",
                  b"positional",
                  f,
                  b"the first named argument is here",
                  [
                    b"positional arguments fill parameters left to right, which a name in front of them would make ambiguous",
                  ],
                ),
              ),
          },
          args: s.args.push(e),
        },
      ArgumentByName(n) ->
        {
          parser: s.parser,
          args: s.args,
          first: match s.first { None -> Some(n.span), Some(f) -> Some(f) },
          named: s.named.push(n),
        },
    })

fn literal_expression(
  input: Input,
  parser: Parser,
  literal: SourceLiteral,
) -> Result<ParseOutput<Expression>, Parser> = {
  let a = advance(input, parser);
  Ok({ parser: a.parser, node: LiteralExpression({ span: a.node, literal: literal }) })
}

fn hole_expression(
  input: Input,
  parser: Parser,
  text: Bytes,
) -> Result<ParseOutput<Expression>, Parser> = {
  let a = advance(input, parser);
  Ok({ parser: a.parser, node: HoleExpression({ span: a.node, text: text }) })
}

fn primary_expression(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let st = current_span(input, parser);
  match token_kind(input, parser) {
    IntLiteral(v) -> literal_expression(input, parser, LiteralInt(v)),
    FixedLiteral(ty, v) -> literal_expression(input, parser, LiteralFixed(ty, v)),
    WideLiteral(ty, high, low) -> literal_expression(input, parser, LiteralWide(ty, high, low)),
    FloatLiteral(f) -> literal_expression(input, parser, LiteralFloat(source_text(input, st))),
    DecimalLiteral(m, scale) ->
      literal_expression(input, parser, LiteralDecimal(source_text(input, st))),
    StringLiteral(s) -> literal_expression(input, parser, LiteralString(s)),
    LineString(s) -> literal_expression(input, parser, LiteralString(s)),
    BytesLiteral(b) -> literal_expression(input, parser, LiteralBytes(b)),
    InterpolatedHead(t) -> interpolated_string(input, parser, t),
    CharLiteral(v) -> literal_expression(input, parser, LiteralChar(v)),
    Keyword(k) -> if k == b"true" { literal_expression(input, parser, LiteralBool(true)) }
    else if k == b"false" { literal_expression(input, parser, LiteralBool(false)) }
    else if k == b"if" { if_expression(input, parser) }
    else if k == b"match" { match_expression(input, parser) }
    else if k == b"handle" { handle_expression(input, parser) }
    else { Err(error_here(input, parser, b"an expression")) },
    Identifier(n) -> primary_identifier(input, parser, n),
    Punctuation(s) -> if s == b"lparen" { primary_paren(input, parser) }
    else if s == b"lbracket" { primary_list(input, parser) }
    else if s == b"hashbrace" { map_literal(input, parser, false) }
    else if s == b"hashbracket" { map_literal(input, parser, true) }
    else if s == b"lbrace" && !parser.no_brace {
      if at_record_literal(input, parser) { record_expression(input, parser) }
      else { block_expression(input, parser) }
    } else if s == b"pipe" || s == b"pipepipe" { lambda_expression(input, parser) }
    else if s == b"hole" { hole_expression(input, parser, b"???") }
    else if s == b"dotdot" { hole_expression(input, parser, b"..") }
    else { Err(error_here(input, parser, b"an expression")) },
    _ -> Err(error_here(input, parser, b"an expression")),
  }
}

fn primary_identifier(
  input: Input,
  parser: Parser,
  name: Bytes,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} =
  if name == b"with_scope" && token_kind_at(input, parser, 1) == token_lbracket() {
    with_scope_expression(input, parser)
  } else if name == b"simulate" && !parser.no_brace
      && token_kind_at(input, parser, 1) == token_lbrace() { simulate_expression(input, parser) }
  else if name == b"parallel" && !parser.no_brace
      && token_kind_at(input, parser, 1) == token_lbrace() { parallel_expression(input, parser) }
  else if name == b"try" && opens_try(input, parser) { try_expression(input, parser) } else {
    match tagged_text(input, parser) {
      Some(head) -> tagged_literal(input, parser, name, head),
      None -> {
        let { parser, node: q } = qualified_name(input, parser, b"an expression")?;
        Ok({ parser: parser, node: NameExpression({ span: q.span, name: q }) })
      },
    }
  }

type TaggedHead = { text: Bytes, has_holes: Bool }

fn tagged_text(input: Input, parser: Parser) -> Option<TaggedHead> =
  if token_at(input, parser, 1).start != token_at(input, parser, 0).end { None } else {
    match token_kind_at(input, parser, 1) {
      StringLiteral(text) -> Some({ text: text, has_holes: false }),
      InterpolatedHead(text) -> Some({ text: text, has_holes: true }),
      _ -> None,
    }
  }

fn tagged_literal(
  input: Input,
  parser: Parser,
  name: Bytes,
  head: TaggedHead,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let tag = current_span(input, parser);
  let named = advance(input, parser).parser;
  let quoted = current_span(input, named);
  let { parser, node: hs } = (if head.has_holes { holes(input, named) }
  else { Ok({ parser: advance(input, named).parser, node: [] }) })?;
  let last = match hs.at(hs.len() - 1) { Some(h) -> h.quoted, None -> quoted };
  Ok({
    parser: parser,
    node: TaggedLiteralExpression({
      span: span_to(tag, last),
      tag: { name: name, span: tag },
      text: head.text,
      quoted: quoted,
      holes: hs,
    }),
  })
}

fn primary_paren(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match primary_paren_inner(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

fn primary_paren_inner(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  if at_token(input, o.parser, token_rparen()) {
    let close_paren = advance(input, o.parser);
    Ok({
      parser: close_paren.parser,
      node: LiteralExpression({ span: span_to(o.node, close_paren.node), literal: LiteralUnit }),
    })
  } else {
    let inner = expression(input, o.parser)?;
    if at_token(input, inner.parser, token_comma()) {
      let rest = comma_list(
        input,
        advance(input, inner.parser).parser,
        token_rparen(),
        expression,
      )?;
      let close_paren = expect_close(
        input,
        rest.parser,
        token_rparen(),
        o.node,
        b"`)` to close the tuple",
      )?;
      let items = prepend(inner.node, rest.node);
      if items.len() == 1 {
        Ok({
          parser: close_paren.parser,
          node: set_span(inner.node, span_to(o.node, close_paren.node)),
        })
      } else {
        Ok({
          parser: close_paren.parser,
          node: RecordExpression({
            span: span_to(o.node, close_paren.node),
            fields: range(0, items.len()).map(|i: Int| -> RecordLiteralField {
              match items.at(i) {
                Some(e) -> { name: tuple_field_name(i, expression_span(e)), value: e },
                None -> { name: tuple_field_name(i, o.node), value: no_expression() },
              }
            }),
          }),
        })
      }
    } else {
      let close = expect_close(
        input,
        inner.parser,
        token_rparen(),
        o.node,
        b"`)` to close the group",
      )?;
      Ok({ parser: close.parser, node: set_span(inner.node, span_to(o.node, close.node)) })
    }
  }
}

fn primary_list(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match primary_list_inner(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

fn primary_list_inner(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  let { parser, node: items } = comma_list(input, o.parser, token_rbracket(), expression)?;
  let { parser, node: close_bracket } = expect_close(
    input,
    parser,
    token_rbracket(),
    o.node,
    b"`]` to close the list",
  )?;
  Ok({
    parser: parser,
    node: ListExpression({ span: span_to(o.node, close_bracket), items: items }),
  })
}

fn map_literal(
  input: Input,
  parser: Parser,
  set: Bool,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match map_literal_inner(input, with_no_brace(parser, false), set) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

fn map_literal_inner(
  input: Input,
  parser: Parser,
  set: Bool,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  let closer = if set { token_rbracket() } else { token_rbrace() };
  let { parser, node: entries } = comma_list(input, o.parser, closer, if set { expression }
  else { map_entry })?;
  let { parser, node: close_span } = expect_close(input, parser, closer, o.node, if set {
    b"`]` to close the set"
  } else { b"`}` to close the map" })?;
  let span = span_to(o.node, close_span);
  Ok({
    parser: parser,
    node: CallExpression({
      span: span,
      function: NameExpression({
        span: o.node,
        name: {
          module: Some({
            name: if set { set_binder() } else { map_literal_call().binder },
            span: o.node,
          }),
          name: {
            name: if set { set_literal_callee() } else { map_literal_call().name },
            span: o.node,
          },
          span: o.node,
        },
      }),
      named: [],
      args: [ListExpression({ span: span, items: entries })],
      labels: [],
    }),
  })
}

pub fn set_binder() -> Bytes = b"?set"

pub fn set_literal_callee() -> Bytes = b"Set::of_list"

pub fn map_literal_call() -> { binder: Bytes, name: Bytes } =
  { binder: b"Map", name: b"of_entries" }

pub fn show_binder() -> Bytes = b"?show"

fn interpolated_string(
  input: Input,
  parser: Parser,
  head: Bytes,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let first = current_span(input, parser);
  let { parser, node: hs } = holes(input, parser)?;
  let last = match hs.at(hs.len() - 1) { Some(h) -> h.quoted, None -> first };
  let parts = hs.fold(
    [LiteralExpression({ span: first, literal: LiteralString(head) })],
    |accumulator: List<Expression>, h: Hole|
      accumulator.push(display_call(h.value)).push(
        LiteralExpression({ span: h.quoted, literal: LiteralString(h.text) }),
      ),
  );
  Ok({ parser: parser, node: concatenated(span_to(first, last), parts) })
}

fn holes(input: Input, parser: Parser) -> Result<ParseOutput<List<Hole>>, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match holes_on(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

fn holes_on(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<List<Hole>>, Parser> / {abort.raise} =
  iterate(
    { parser: parser, out: [] },
    input.token_count - parser.position + 1,
    |s: PartialList<Hole>| {
      let opened = advance(input, s.parser);
      match expression(input, opened.parser) {
        Err(q) -> Stop(Err(q)),
        Ok(r) -> {
          let hole_span = current_span(input, r.parser);
          match token_kind(input, r.parser) {
            InterpolatedMiddle(t) ->
              Continue({
                parser: r.parser,
                out: s.out.push({ value: r.node, text: t, quoted: hole_span }),
              }),
            InterpolatedTail(t) ->
              Stop(
                Ok({
                  parser: advance(input, r.parser).parser,
                  node: s.out.push({ value: r.node, text: t, quoted: hole_span }),
                }),
              ),
            _ -> Stop(Err(error_here(input, r.parser, b"`}` to close the interpolated value"))),
          }
        },
      }
    },
  )

fn display_call(expression: Expression) -> Expression = {
  let span = expression_span(expression);
  CallExpression({
    span: span,
    function: NameExpression({
      span: span,
      name: {
        module: Some({ name: show_binder(), span: span }),
        name: { name: b"display", span: span },
        span: span,
      },
    }),
    named: [],
    args: [expression],
    labels: [],
  })
}

pub fn cases_binder() -> Bytes = b"?cases"

pub fn is_hidden_binder(name: Bytes) -> Bool =
  name == show_binder() || name == cases_binder() || name == set_binder()
    || name.starts_with(implicit_import_prefix())

fn implicit_import_prefix() -> Bytes = b"?free."

pub fn implicitly_imported_names() -> List<{ module: Bytes, names: List<Bytes> }> =
  [
    { module: b"console", names: [b"print", b"eprint", b"read_line", b"Console"] },
    { module: b"set", names: [b"Set"] },
    { module: b"math", names: [b"abs"] },
  ]

pub fn home_modules() -> List<Bytes> =
  [
    b"std.list",
    b"std.string",
    b"std.map",
    b"std.option",
    b"std.result",
    b"std.char",
    b"std.bytes",
    b"std.float",
  ]

pub fn prelude_module() -> Bytes = b"std.prelude"

pub fn prelude_own(full: Bytes) -> Option<Bytes> = {
  let prefix = prelude_module().concat(b".");
  if full.starts_with(prefix) { full.slice_at(prefix.len(), full.len() - prefix.len()) }
  else { None }
}

pub fn scheduler_module() -> Bytes = b"std.internal.schedule"

pub fn is_marshalling_function(definition: Bytes) -> Bool =
  definition.starts_with(scheduler_module().concat(b".crossing_"))

pub fn scheduler_dependencies() -> List<Bytes> =
  [
    scheduler_module(),
    b"std.bin",
    b"std.bytes",
    b"std.cases",
    b"std.derive",
    b"std.derive.codec",
    b"std.gen",
    b"std.internal.native",
    b"std.internal.trail",
    b"std.laws",
    b"std.list",
    b"std.math",
    b"std.radix",
    b"std.show",
    b"std.string",
    b"std.text",
    b"std.value",
  ]

pub fn prelude_hosts() -> List<{ effect: Bytes, module: Bytes, by: Bytes }> =
  [
    { effect: b"clock", module: scheduler_module(), by: b"clocked" },
    { effect: b"task", module: scheduler_module(), by: b"scheduled" },
  ]

pub fn task_operations() -> List<Bytes> = marshalling_operations().push(b"yield")

pub fn marshalling_operations() -> List<Bytes> =
  [b"spawn", b"join", b"cancel", b"await", b"channel", b"send", b"recv", b"close", b"select"]

pub fn home_module_dependencies() -> List<Bytes> =
  home_modules().concat([
    prelude_module(),
    b"std.cases",
    b"std.gen",
    b"std.laws",
    b"std.math",
    b"std.radix",
    b"std.show",
    b"std.ucd",
    b"std.value",
  ])

pub fn sees_homes(name: Bytes) -> Bool = !home_module_dependencies().contains(name)

pub fn implicit_import_binder(module: Bytes) -> Bytes = implicit_import_prefix().concat(module)

pub fn implicitly_imported_by(binder: Bytes) -> List<Bytes> =
  implicitly_imported_names().fold(
    [],
    |accumulator: List<Bytes>, f: { module: Bytes, names: List<Bytes> }|
      if implicit_import_binder(f.module) == binder { f.names } else { accumulator },
  )

pub fn case_index_binder() -> Bytes = b"?at"

pub fn case_identity() -> Bytes = b"?identity"

fn cases_name(name: Bytes, module_at: Span, name_at: Span) -> QName =
  {
    module: Some({ name: cases_binder(), span: module_at }),
    name: { name: name, span: name_at },
    span: name_at,
  }

fn cases_call(
  span: Span,
  from: Span,
  ty: TypeExpression,
  name: Bytes,
  args: List<Expression>,
) -> Expression = {
  let callee = synthetic_span_at(type_span(ty), from, role_case_callee());
  CallExpression({
    span: span,
    function: NameExpression({
      span: callee,
      name: cases_name(
        name,
        synthetic_span_at(type_span(ty), from, role_case_callee_module()),
        callee,
      ),
    }),
    named: [],
    args: args,
    labels: [],
  })
}

pub fn local(name: Bytes, at: Span) -> Expression =
  NameExpression({ span: at, name: bare({ name: name, span: at }) })

fn table_binder() -> Bytes = b"?table"

fn table_let(ty: TypeExpression, table: Expression, from: Span) -> Statement = {
  let at = expression_span(table);
  let typed = { ..at, site: 0 };
  let binder = synthetic_span_at(at, from, role_case_table_binder());
  let named = cases_name(
    b"Table",
    synthetic_span_at(at, from, role_case_table_module()),
    synthetic_span_at(at, from, role_case_table_name()),
  );
  LetStatement({
    span: synthetic_span_at(at, from, role_case_table_let()),
    pattern: PatternVariable({ span: binder, name: { name: table_binder(), span: binder } }),
    ty: Some(
      NamedTypeExpression({
        span: typed,
        name: named,
        args: [ty],
        labels: [],
        effect_arguments: [],
      }),
    ),
    value: table,
  })
}

pub fn listing(
  binder: Identifier,
  ty: TypeExpression,
  table: Expression,
  label: Expression,
  for_span: Span,
) -> Expression =
  BlockExpression({
    span: synthetic_span_at(span_to(for_span, expression_span(table)), for_span, role_case_block()),
    tail: Some(
      cases_call(
        synthetic_span_at(
          span_to(expression_span(label), expression_span(table)),
          for_span,
          role_case_call(),
        ),
        for_span,
        ty,
        b"listed",
        [
          local(table_binder(), synthetic_span_at(for_span, for_span, role_case_table_read())),
          LambdaExpression({
            span: synthetic_span_at(
              span_to(expression_span(label), binder.span),
              for_span,
              role_case_label_lambda(),
            ),
            body: label,
            params: [
              {
                name: binder,
                keep: false,
                ty: Some(ty),
                cost: None,
                space: None,
                default: None,
                span: synthetic_span_at(binder.span, for_span, role_case_label_param()),
              },
            ],
            return_clause: None,
          }),
        ],
      ),
    ),
    statements: [table_let(ty, table, for_span)],
  })

pub fn case_body(
  binder: Identifier,
  ty: TypeExpression,
  table: Expression,
  in_span: Span,
  body: Expression,
) -> Expression =
  BlockExpression({
    span: synthetic_span_at(
      span_to(binder.span, expression_span(body)),
      in_span,
      role_case_block(),
    ),
    tail: Some(body),
    statements: [
      table_let(ty, table, in_span),
      LetStatement({
        span: synthetic_span_at(
          span_to(binder.span, expression_span(table)),
          in_span,
          role_case_let(),
        ),
        pattern: PatternVariable({
          span: synthetic_span_at(binder.span, in_span, role_case_binder()),
          name: binder,
        }),
        ty: Some(ty),
        value: cases_call(
          synthetic_span_at(span_to(in_span, expression_span(table)), in_span, role_case_call()),
          in_span,
          ty,
          b"chosen",
          [
            local(table_binder(), synthetic_span_at(in_span, in_span, role_case_table_read())),
            local(
              case_index_binder(),
              synthetic_span_at(
                span_between(in_span.start, in_span.start + 1),
                in_span,
                role_case_index_read(),
              ),
            ),
            local(
              case_identity(),
              synthetic_span_at(
                span_between(in_span.start + 1, in_span.end),
                in_span,
                role_case_identity_read(),
              ),
            ),
          ],
        ),
      }),
    ],
  })

fn concatenated(span: Span, parts: List<Expression>) -> Expression = {
  let nonempty_parts = parts.filter(|expression: Expression|
    match expression { LiteralExpression(l) -> l.literal != LiteralString(b""), _ -> true });
  let chained = range(1, nonempty_parts.len()).fold(
    at_expression(nonempty_parts, 0),
    |accumulator: Expression, i: Int| {
      let x = at_expression(nonempty_parts, i);
      BinaryExpression({
        span: span_to(expression_span(accumulator), expression_span(x)),
        operation: b"concat",
        left_operand: accumulator,
        right_operand: x,
      })
    },
  );
  set_span(chained, span)
}

fn at_expression(xs: List<Expression>, i: Int) -> Expression =
  match xs.at(i) {
    Some(x) -> x,
    None -> LiteralExpression({ span: dummy_span(), literal: LiteralString(b"") }),
  }

fn map_entry(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let { parser, node: key } = expression(input, parser)?;
  let { parser, .. } = expect(input, parser, token_colon(), b"`:` between a key and its value")?;
  let { parser, node: value } = expression(input, parser)?;
  Ok({ parser: parser, node: entry_record(key, value) })
}

fn entry_record(key: Expression, value: Expression) -> Expression = {
  let ks = expression_span(key);
  let vs = expression_span(value);
  RecordExpression({
    span: span_to(ks, vs),
    fields: [
      { name: { name: b"key", span: ks }, value: key },
      { name: { name: b"value", span: vs }, value: value },
    ],
  })
}

fn at_record_literal(input: Input, parser: Parser) -> Bool =
  if token_kind_at(input, parser, 1) == token_dotdot() { true } else {
    match token_kind_at(input, parser, 1) {
      Identifier(n) ->
        token_kind_at(input, parser, 2) == token_colon()
          || token_kind_at(input, parser, 2) == token_comma(),
      Keyword(k) ->
        token_kind_at(input, parser, 2) == token_colon()
          || token_kind_at(input, parser, 2) == token_comma(),
      _ -> false,
    }
  }

fn record_expression(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match record_expression_inner(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

fn record_expression_inner(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  let { parser, node: base } = record_base(input, o.parser)?;
  let { parser, node: fields } = comma_list(input, parser, token_rbrace(), record_field)?;
  let { parser, node: close_brace } = expect_close(
    input,
    parser,
    token_rbrace(),
    o.node,
    b"`}` to close the record",
  )?;
  let span = span_to(o.node, close_brace);
  Ok({
    parser: report_duplicate_fields(parser, fields.map(|f: RecordLiteralField| f.name)),
    node: match base {
      None -> RecordExpression({ span: span, fields: fields }),
      Some(b) -> RecordUpdateExpression({ span: span, base: b, fields: fields }),
    },
  })
}

fn record_base(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Option<Expression>>, Parser> / {abort.raise} =
  if !at_token(input, parser, token_dotdot()) { Ok({ parser: parser, node: None }) } else {
    let { parser, node: b } = record_update_base(input, parser)?;
    if at_token(input, parser, token_rbrace()) { Ok({ parser: parser, node: Some(b) }) } else {
      let { parser, .. } = expect(
        input,
        parser,
        token_comma(),
        b"`,` after the record being updated",
      )?;
      Ok({ parser: parser, node: Some(b) })
    }
  }

fn record_update_base(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let dots = advance(input, parser);
  if at_token(input, dots.parser, token_dot()) {
    Err(
      push_diagnostic(
        dots.parser,
        error_at(
          unexpected(),
          span_to(dots.node, current_span(input, dots.parser)),
          b"a record update is spelled `..`, not `...`",
          b"one dot too many",
          [b"`..` is the same token the record *pattern* `{a, ..}` uses"],
        ),
      ),
    )
  } else {
    let { parser, node: name } = qualified_name(input, dots.parser, b"the record being updated")?;
    let path = iterate(
      { parser: parser, node: NameExpression({ span: name.span, name: name }) },
      input.token_count - parser.position + 1,
      |s: ParseOutput<Expression>|
        if !at_token(input, s.parser, token_dot()) { Stop(Ok(s)) } else {
          let d = advance(input, s.parser);
          match expect_field_name(input, d.parser, b"a field name") {
            Err(q) -> Stop(Err(q)),
            Ok(f) ->
              Continue({
                parser: f.parser,
                node: FieldExpression({
                  span: span_to(expression_span(s.node), f.node.name.span),
                  base: s.node,
                  field: f.node.name,
                }),
              }),
          }
        },
    )?;
    let op_of: Option<{ effect_name: QName, operation: Identifier }> = match path.node {
      FieldExpression(f) -> match f.base {
        NameExpression(v) -> Some({ effect_name: v.name, operation: f.field }),
        _ -> None,
      },
      _ -> None,
    };
    let opens = at_token(input, path.parser, token_lparen());
    match op_of {
      Some(p) -> if !opens && !at_token(input, path.parser, token_lbracket()) { Ok(path) } else {
        let { parser, node: resource } = optional_resource(input, path.parser)?;
        let a = call_args(input, parser)?;
        let span = span_to(expression_span(path.node), a.close);
        Ok({
          parser: a.parser,
          node: if a.named.len() == 0 {
            PerformExpression({
              span: span,
              effect_name: p.effect_name,
              operation: p.operation,
              resource: resource,
              args: a.args,
            })
          } else {
            CallExpression({
              span: span,
              function: path.node,
              named: a.named,
              args: a.args,
              labels: match resource { Some(r) -> [r], None -> [] },
            })
          },
        })
      },
      None -> if !opens { Ok(path) } else {
        let a = call_args(input, path.parser)?;
        Ok({
          parser: a.parser,
          node: CallExpression({
            span: span_to(expression_span(path.node), a.close),
            function: path.node,
            named: a.named,
            args: a.args,
            labels: [],
          }),
        })
      },
    }
  }
}

fn record_field(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<RecordLiteralField>, Parser> / {abort.raise} =
  if at_token(input, parser, token_dotdot()) {
    Err(
      push_diagnostic(
        parser,
        error_at(
          unexpected(),
          current_span(input, parser),
          b"a record update has one base, written first",
          b"a second `..` here",
          [b"write `{..b, x: 1, y: 2}`; two bases have no defined order of fields"],
        ),
      ),
    )
  } else { record_field_named(input, parser) }

fn record_field_named(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<RecordLiteralField>, Parser> / {abort.raise} = {
  let { parser, node: f } = expect_field_name(input, parser, b"a field name")?;
  let name = f.name;
  let colon = eat(input, parser, token_colon());
  if colon.ok {
    let { parser, node: v } = expression(input, colon.parser)?;
    Ok({ parser: parser, node: { name: name, value: v } })
  } else if f.keyword { Err(keyword_pun_error(colon.parser, name)) } else {
    Ok({
      parser: colon.parser,
      node: { name: name, value: NameExpression({ span: name.span, name: bare(name) }) },
    })
  }
}

pub fn block_expression(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match block_inner(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

type BlockAccumulator = { parser: Parser, tail: Option<Expression>, statements: List<Statement> }

fn block_inner(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let { parser, node: o } = expect(input, parser, token_lbrace(), b"`{` to start a block")?;
  let body = iterate(
    { parser: parser, tail: None, statements: [] },
    input.token_count - parser.position + 1,
    |s: BlockAccumulator|
      if at_token(input, s.parser, token_rbrace()) { Stop(Ok(s)) } else if at_eof(input, s.parser) {
        Stop(Err(unclosed(input, s.parser, o, b"`}` to close the block")))
      } else if at_token(input, s.parser, keyword_let()) {
        match let_statement(input, s.parser) {
          Err(q) -> Stop(Err(q)),
          Ok(st) ->
            Continue({ parser: st.parser, tail: s.tail, statements: s.statements.push(st.node) }),
        }
      } else if is_identifier_at(input, s.parser, 0)
          && token_kind_at(input, s.parser, 1) == token_eq() {
        match assign_statement(input, s.parser) {
          Err(q) -> Stop(Err(q)),
          Ok(st) ->
            Continue({ parser: st.parser, tail: s.tail, statements: s.statements.push(st.node) }),
        }
      } else { block_step(input, s, o) },
  )?;
  let { parser, node: closing_brace } = expect_close(
    input,
    body.parser,
    token_rbrace(),
    o,
    b"`}` to close the block",
  )?;
  Ok({
    parser: parser,
    node: BlockExpression({
      span: span_to(o, closing_brace),
      tail: body.tail,
      statements: body.statements,
    }),
  })
}

fn block_step(
  input: Input,
  s: BlockAccumulator,
  open: Span,
) -> Iter<BlockAccumulator, Result<BlockAccumulator, Parser>> / {abort.raise} =
  match expression(input, s.parser) {
    Err(q) -> Stop(Err(q)),
    Ok(e) -> {
      let semi = eat(input, e.parser, token_semi());
      if semi.ok {
        Continue({
          parser: semi.parser,
          tail: s.tail,
          statements: s.statements.push(ExpressionStatement(e.node)),
        })
      } else if at_token(input, semi.parser, token_rbrace()) {
        Continue({ parser: semi.parser, tail: Some(e.node), statements: s.statements })
      } else if is_block_like(e.node) {
        Continue({
          parser: semi.parser,
          tail: s.tail,
          statements: s.statements.push(ExpressionStatement(e.node)),
        })
      } else if at_eof(input, semi.parser) {
        Stop(Err(unclosed(input, semi.parser, open, b"`}` to close the block")))
      } else {
        Stop(
          Err(error_here(input, semi.parser, b"`;` to end the statement, or `}` to end the block")),
        )
      }
    },
  }

fn let_type(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Option<TypeExpression>>, Parser> / {abort.raise} = {
  let colon = eat(input, parser, token_colon());
  if !colon.ok { Ok({ parser: colon.parser, node: None }) } else {
    let { parser, node: x } = ty(input, colon.parser)?;
    Ok({ parser: parser, node: Some(x) })
  }
}

fn let_statement(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Statement>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let { parser, node: pattern } = pattern(input, st.parser)?;
  let { parser, node: t } = let_type(input, parser)?;
  let { parser, .. } = expect(input, parser, token_eq(), b"`=` and an initializer")?;
  let { parser, node: value } = expression(input, parser)?;
  let els = eat(input, parser, keyword_else());
  if els.ok { let_else(input, els.parser, st.node, pattern, t, value) }
  else { let_end(input, parser, st.node, pattern, t, value) }
}

fn let_end(
  input: Input,
  parser: Parser,
  span: Span,
  pattern: Pattern,
  ty: Option<TypeExpression>,
  value: Expression,
) -> Result<ParseOutput<Statement>, Parser> / {abort.raise} = {
  let { parser, node: semi } = expect(input, parser, token_semi(), b"`;` to end the `let`")?;
  Ok({
    parser: parser,
    node: LetStatement({ span: span_to(span, semi), pattern: pattern, ty: ty, value: value }),
  })
}

fn let_else(
  input: Input,
  parser: Parser,
  span: Span,
  pattern: Pattern,
  ty: Option<TypeExpression>,
  value: Expression,
) -> Result<ParseOutput<Statement>, Parser> / {abort.raise} = {
  let { parser, node: fallback } = else_block(input, parser)?;
  let { parser, node: semi } = expect(
    input,
    parser,
    token_semi(),
    b"`;` to end the `let ... else`",
  )?;
  Ok({
    parser: parser,
    node: LetElseStatement({
      span: span_to(span, semi),
      pattern: pattern,
      ty: ty,
      value: value,
      fallback: fallback,
    }),
  })
}

fn assign_statement(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Statement>, Parser> / {abort.raise} = {
  let { parser, node: name } = expect_identifier(
    input,
    parser,
    b"the name of the variable to assign",
  )?;
  let eq = advance(input, parser);
  let { parser, node: value } = expression(input, eq.parser)?;
  let semi = eat(input, parser, token_semi());
  if semi.ok || at_token(input, semi.parser, token_rbrace()) {
    Ok({
      parser: semi.parser,
      node: AssignmentStatement({
        span: span_to(name.span, expression_span(value)),
        name: name,
        value: value,
      }),
    })
  } else {
    Err(error_here(input, semi.parser, b"`;` to end the assignment, or `}` to end the block"))
  }
}

fn else_block(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} =
  if !at_token(input, parser, token_lbrace()) {
    Err(error_here(input, parser, b"`{` to open the `else` block of a `let ... else`"))
  } else if input.room <= 0 { Err(too_deep(input, parser)) }
  else { block_expression({ ..input, room: input.room - 1 }, parser) }

pub fn function_parameter(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Param>, Parser> / {abort.raise} = param_inner(input, parser, true)

pub fn lambda_parameter(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Param>, Parser> / {abort.raise} = param_inner(input, parser, false)

pub fn declared_param(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Param>, Parser> / {abort.raise} = param_inner(input, parser, false)

fn param_inner(
  input: Input,
  parser: Parser,
  allow_default: Bool,
) -> Result<ParseOutput<Param>, Parser> / {abort.raise} = {
  let { parser, node: n } = expect_binder(input, parser, b"a parameter name")?;
  let { parser, node: typed } = param_type(input, parser)?;
  let t = typed.ty;
  let { parser, node: c } = cost_or_space_name(
    input,
    parser,
    allow_default,
    t,
    b"cost",
    b"the number of steps that a call of this parameter takes",
  )?;
  let { parser, node: s } = cost_or_space_name(
    input,
    parser,
    allow_default,
    t,
    b"space",
    b"the amount of memory that a call of this parameter uses",
  )?;
  let { parser, node: d } = param_default(input, parser, allow_default)?;
  let end = match d {
    Some(e) -> expression_span(e),
    None -> match ((s, c)) {
      (Some(k), _) -> k.span,
      (None, Some(k)) -> k.span,
      _ -> match t { Some(x) -> type_span(x), None -> n.span },
    },
  };
  Ok({
    parser: parser,
    node: {
      name: n,
      keep: typed.keep,
      ty: t,
      cost: c,
      space: s,
      default: d,
      span: span_to(n.span, end),
    },
  })
}

fn cost_or_space_name(
  input: Input,
  parser: Parser,
  allowed: Bool,
  t: Option<TypeExpression>,
  word: Bytes,
  what: Bytes,
) -> Result<ParseOutput<Option<Identifier>>, Parser> / {abort.raise} =
  if !allowed || !at_identifier_text(input, parser, word) { Ok({ parser: parser, node: None }) }
  else {
    match t {
      Some(FunctionTypeExpression(_)) -> {
        let { parser, node: k } = expect_binder(
          input,
          advance(input, parser).parser,
          Bytes::concat_all([b"a name for the ", what]),
        )?;
        Ok({ parser: parser, node: Some(k) })
      },
      _ ->
        Err(
          error_here(
            input,
            parser,
            Bytes::concat_all([b"a function type before `", word, b"`, which names the ", what]),
          ),
        ),
    }
  }

fn param_type(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<{ keep: Bool, ty: Option<TypeExpression> }>, Parser> / {abort.raise} = {
  let co = eat(input, parser, token_colon());
  if !co.ok { Ok({ parser: co.parser, node: { keep: false, ty: None } }) } else {
    let keep = at_identifier_text(input, co.parser, b"keep") && starts_type(input, co.parser, 1);
    let from = if keep { advance(input, co.parser).parser } else { co.parser };
    let { parser, node: t } = ty(input, from)?;
    Ok({ parser: parser, node: { keep: keep, ty: Some(t) } })
  }
}

fn param_default(
  input: Input,
  parser: Parser,
  allow: Bool,
) -> Result<ParseOutput<Option<Expression>>, Parser> / {abort.raise} =
  if !at_token(input, parser, token_eq()) { Ok({ parser: parser, node: None }) } else {
    let eq = advance(input, parser);
    let { parser, node: e } = expression(input, eq.parser)?;
    if allow { Ok({ parser: parser, node: Some(e) }) } else {
      Ok({
        parser: push_diagnostic(
          parser,
          error_at(
            default_not_allowed(),
            span_to(eq.node, expression_span(e)),
            b"a lambda parameter cannot have a default",
            b"no call can omit this argument",
            [
              b"a default is filled in by matching a call against a signature, and a lambda is called through a value rather than by name",
            ],
          ),
        ),
        node: None,
      })
    }
  }

pub fn no_param() -> Param =
  {
    name: no_identifier(),
    keep: false,
    ty: None,
    cost: None,
    space: None,
    default: None,
    span: dummy_span(),
  }

fn lambda_params(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<List<Param>>, Parser> / {abort.raise} = {
  let empty = eat(input, parser, token_pipepipe());
  if empty.ok { Ok({ parser: empty.parser, node: [] }) } else {
    let bar = advance(input, empty.parser);
    let saved = bar.parser.no_pipe;
    let { parser, node: ps } = (match comma_list(
        input,
        with_no_pipe(bar.parser, true),
        token_pipe(),
        lambda_parameter,
      ) {
      Err(q) -> Err(with_no_pipe(q, saved)),
      Ok(r) -> Ok({ parser: with_no_pipe(r.parser, saved), node: r.node }),
    })?;
    let { parser, .. } = expect(
      input,
      parser,
      token_pipe(),
      b"`|` to close the lambda parameters",
    )?;
    Ok({ parser: parser, node: ps })
  }
}

fn lambda_expression(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let st = current_span(input, parser);
  let { parser, node: params } = lambda_params(input, parser)?;
  let arrow = eat(input, parser, token_arrow());
  if arrow.ok {
    let { parser, node: return_type } = ty(input, arrow.parser)?;
    if !at_token(input, parser, token_lbrace()) {
      Err(error_here(input, parser, b"`{` to open the body of a lambda with a written return type"))
    } else {
      let { parser, node: body } = lambda_body(input, parser, true)?;
      Ok({
        parser: parser,
        node: LambdaExpression({
          span: span_to(st, expression_span(body)),
          body: body,
          params: params,
          return_clause: Some(return_type),
        }),
      })
    }
  } else {
    let { parser, node: body } = lambda_body(input, parser, false)?;
    Ok({
      parser: parser,
      node: LambdaExpression({
        span: span_to(st, expression_span(body)),
        body: body,
        params: params,
        return_clause: None,
      }),
    })
  }
}

fn lambda_body(
  input: Input,
  parser: Parser,
  braced: Bool,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let saved = parser.no_pipe;
  let inner = with_no_pipe(parser, false);
  match if braced { block_expression(input, inner) } else { expression(input, inner) } {
    Err(q) -> Err(with_no_pipe(q, saved)),
    Ok(r) -> Ok({ parser: with_no_pipe(r.parser, saved), node: r.node }),
  }
}

fn else_branch(
  input: Input,
  parser: Parser,
  then_branch: Expression,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let els = eat(input, parser, keyword_else());
  if !els.ok {
    let end = expression_span(then_branch).end;
    Ok({
      parser: els.parser,
      node: LiteralExpression({ span: span_between(end, end), literal: LiteralUnit }),
    })
  } else { block_expression(input, els.parser) }
}

type IfArm = { start: Span, cond: Expression, then_branch: Expression }

fn if_expression(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let chain = iterate(
    { parser: parser, out: [] },
    input.token_count - parser.position + 1,
    |s: PartialList<IfArm>| {
      let st = advance(input, s.parser);
      match scrutinee(input, st.parser) {
        Err(q) -> Stop(Err(q)),
        Ok(c) -> match block_expression(input, c.parser) {
          Err(q) -> Stop(Err(q)),
          Ok(t) -> {
            let out = s.out.push({ start: st.node, cond: c.node, then_branch: t.node });
            let els = eat(input, t.parser, keyword_else());
            if els.ok && at_token(input, els.parser, keyword_if()) {
              Continue({ parser: els.parser, out: out })
            } else { Stop(Ok({ parser: t.parser, out: out })) }
          },
        },
      }
    },
  )?;
  let last = chain.out.get(chain.out.len() - 1);
  let { parser, node: else_b } = else_branch(input, chain.parser, last.then_branch)?;
  Ok({
    parser: parser,
    node: range(0, chain.out.len()).fold(else_b, |inner: Expression, i: Int| {
      let arm = chain.out.get(chain.out.len() - 1 - i);
      IfExpression({
        span: span_to(arm.start, expression_span(inner)),
        cond: arm.cond,
        then_branch: arm.then_branch,
        else_branch: inner,
      })
    }),
  })
}

fn match_expression(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let { parser, node: scrut } = scrutinee(input, st.parser)?;
  let saved = parser.no_brace;
  match match_arms(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(arms) ->
      Ok({
        parser: with_no_brace(arms.parser, saved),
        node: MatchExpression({
          span: span_to(st.node, arms.close),
          scrutinee: scrut,
          arms: arms.arms,
        }),
      }),
  }
}

type MatchArms = { parser: Parser, close: Span, arms: List<MatchArm> }

fn match_arms(input: Input, parser: Parser) -> Result<MatchArms, Parser> / {abort.raise} = {
  let { parser, node: o } = expect(input, parser, token_lbrace(), b"`{` to start the match arms")?;
  let body = iterate(
    { parser: parser, out: [] },
    input.token_count - parser.position + 1,
    |s: PartialList<MatchArm>|
      if at_token(input, s.parser, token_rbrace()) { Stop(Ok(s)) } else if at_eof(input, s.parser) {
        Stop(Err(unclosed(input, s.parser, o, b"`}` to close the match arms")))
      } else { match_arm_step(input, s, o) },
  )?;
  let { parser, node: closing_brace } = expect_close(
    input,
    body.parser,
    token_rbrace(),
    o,
    b"`}` to close the match arms",
  )?;
  Ok({ parser: parser, close: closing_brace, arms: body.out })
}

fn arm_guard(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Option<Expression>>, Parser> / {abort.raise} = {
  let gif = eat(input, parser, keyword_if());
  if !gif.ok { Ok({ parser: gif.parser, node: None }) } else {
    let { parser, node: g } = expression(input, gif.parser)?;
    Ok({ parser: parser, node: Some(g) })
  }
}

fn match_arm_step(
  input: Input,
  s: PartialList<MatchArm>,
  open: Span,
) -> Iter<PartialList<MatchArm>, Result<PartialList<MatchArm>, Parser>> / {abort.raise} =
  match pattern(input, s.parser) {
    Err(q) -> Stop(Err(q)),
    Ok(pattern) -> match arm_guard(input, pattern.parser) {
      Err(q) -> Stop(Err(q)),
      Ok(guard) -> match expect(input, guard.parser, token_arrow(), b"`->` and the arm body") {
        Err(q) -> Stop(Err(q)),
        Ok(arrow) -> match expression(input, arrow.parser) {
          Err(q) -> Stop(Err(q)),
          Ok(body) -> {
            let arm = {
              pattern: pattern.node,
              guard: guard.node,
              body: body.node,
              span: span_to(pattern_span(pattern.node), expression_span(body.node)),
            };
            let comma = eat(input, body.parser, token_comma());
            if comma.ok || at_token(input, comma.parser, token_rbrace()) {
              Continue({ parser: comma.parser, out: s.out.push(arm) })
            } else if at_eof(input, comma.parser) {
              Stop(Err(unclosed(input, comma.parser, open, b"`}` to close the match arms")))
            } else if !is_block_like(arm.body) {
              Stop(
                Err(
                  error_here(
                    input,
                    comma.parser,
                    b"`,` between match arms, or `}` to end the match",
                  ),
                ),
              )
            } else { Continue({ parser: comma.parser, out: s.out.push(arm) }) }
          },
        },
      },
    },
  }

fn handle_expression(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let saved = st.parser.no_brace;
  match handle_rest(input, with_no_brace(st.parser, false), st.node) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

type HandlerClauses = {
  parser: Parser,
  return_clause: Option<ReturnClause>,
  clauses: List<HandleClause>,
  handler_variables: List<HandlerStateVariable>,
}

fn handle_rest(
  input: Input,
  parser: Parser,
  span: Span,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let { parser, node: body } = expression(input, parser)?;
  let { parser, .. } = expect(
    input,
    parser,
    keyword_with(),
    b"`with` and then the handler clauses",
  )?;
  let { parser, node: o } = expect(
    input,
    parser,
    token_lbrace(),
    b"`{` to start the handler clauses",
  )?;
  let accumulator = iterate(
    { parser: parser, return_clause: None, clauses: [], handler_variables: [] },
    input.token_count - parser.position + 1,
    |s: HandlerClauses|
      if at_token(input, s.parser, token_rbrace()) { Stop(Ok(s)) } else if at_eof(input, s.parser) {
        Stop(Err(unclosed(input, s.parser, o, b"`}` to close the handler")))
      } else { handle_step(input, s) },
  )?;
  let { parser, node: closing_brace } = expect_close(
    input,
    accumulator.parser,
    token_rbrace(),
    o,
    b"`}` to close the handler",
  )?;
  Ok({
    parser: parser,
    node: HandleExpression({
      span: span_to(span, closing_brace),
      body: body,
      return_clause: accumulator.return_clause,
      clauses: accumulator.clauses,
      handler_variables: accumulator.handler_variables,
    }),
  })
}

fn handle_step(
  input: Input,
  s: HandlerClauses,
) -> Iter<HandlerClauses, Result<HandlerClauses, Parser>> / {abort.raise} =
  if at_identifier_text(input, s.parser, b"return") && is_identifier_at(input, s.parser, 1) {
    match return_clause(input, s.parser) {
      Err(q) -> Stop(Err(q)),
      Ok(parsed_return) -> {
        let next = match s.return_clause {
          None -> { ..s, parser: parsed_return.parser, return_clause: Some(parsed_return.node) },
          Some(first_return) ->
            {
              ..s,
              parser: push_diagnostic(
                parsed_return.parser,
                error_at_and(
                  unexpected(),
                  parsed_return.node.span,
                  b"a handler may have only one `return` clause",
                  b"duplicate `return` clause",
                  first_return.span,
                  b"first one is here",
                  [],
                ),
              ),
            },
        };
        let comma = eat(input, next.parser, token_comma());
        Continue({ ..next, parser: comma.parser })
      },
    }
  } else if at_identifier_text(input, s.parser, b"var") && is_identifier_at(input, s.parser, 1) {
    match handler_variable(input, s.parser) {
      Err(q) -> Stop(Err(q)),
      Ok(v) -> {
        let first = s.clauses.len() == 0
          && (match s.return_clause { None -> true, Some(_) -> false });
        let placed = if first { v.parser } else {
          push_diagnostic(
            v.parser,
            error_at(
              unexpected(),
              v.node.span,
              b"a handler's `var`s come before its clauses",
              b"move this `var` above the first clause",
              [],
            ),
          )
        };
        let comma = eat(input, placed, token_comma());
        Continue({ ..s, parser: comma.parser, handler_variables: s.handler_variables.push(v.node) })
      },
    }
  } else {
    match handle_clause(input, s.parser) {
      Err(q) -> Stop(Err(q)),
      Ok(parsed_clause) -> {
        let comma = eat(input, parsed_clause.parser, token_comma());
        Continue({ ..s, parser: comma.parser, clauses: s.clauses.push(parsed_clause.node) })
      },
    }
  }

fn handler_variable(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<HandlerStateVariable>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let { parser, node: name } = expect_identifier(
    input,
    st.parser,
    b"the variable's name after `var`",
  )?;
  let { parser, node: t } = let_type(input, parser)?;
  let { parser, .. } = expect(input, parser, token_eq(), b"`=` and the variable's first value")?;
  let { parser, node: init } = expression(input, parser)?;
  Ok({
    parser: parser,
    node: { name: name, ty: t, init: init, span: span_to(st.node, expression_span(init)) },
  })
}

fn is_identifier_at(input: Input, parser: Parser, n: Int) -> Bool =
  match token_kind_at(input, parser, n) { Identifier(x) -> true, _ -> false }

fn clause_resume(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Option<Identifier>>, Parser> / {abort.raise} =
  if !at_identifier_text(input, parser, b"resume") { Ok({ parser: parser, node: None }) } else {
    let a = advance(input, parser);
    let { parser, node: n } = expect_identifier(
      input,
      a.parser,
      b"a name to bind the continuation to",
    )?;
    Ok({ parser: parser, node: Some(n) })
  }

fn handle_clause(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<HandleClause>, Parser> / {abort.raise} = {
  let { parser, node: eff } = qualified_name(input, parser, b"an effect name, or `return`")?;
  let { parser, .. } = expect(input, parser, token_dot(), b"`.` and the operation name")?;
  let { parser, node: operation } = expect_identifier(input, parser, b"an operation name")?;
  let { parser, node: resource_clause } = clause_resource(input, parser)?;
  let { parser, node: o } = expect(
    input,
    parser,
    token_lparen(),
    b"`(` to start the clause parameters",
  )?;
  let { parser, node: params } = comma_list(input, parser, token_rparen(), clause_param)?;
  let { parser, .. } = expect_close(
    input,
    parser,
    token_rparen(),
    o,
    b"`)` to close the clause parameters",
  )?;
  let { parser, node: resume } = clause_resume(input, parser)?;
  let { parser, .. } = expect(input, parser, token_arrow(), b"`->` and the clause body")?;
  let { parser, node: body } = expression(input, parser)?;
  Ok({
    parser: parser,
    node: {
      effect_name: eff,
      operation: operation,
      resource: resource_clause.name,
      wildcard_label: resource_clause.every,
      label_binder: resource_clause.binder,
      resume: resume,
      body: body,
      span: span_to(eff.span, expression_span(body)),
      params: params,
    },
  })
}

fn clause_param(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Identifier>, Parser> / {abort.raise} =
  expect_binder(input, parser, b"a clause parameter name")

fn return_clause(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<ReturnClause>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let { parser, node: binder } = expect_identifier(input, st.parser, b"a binder after `return`")?;
  let { parser, .. } = expect(input, parser, token_arrow(), b"`->` and the `return` body")?;
  let { parser, node: body } = expression(input, parser)?;
  Ok({
    parser: parser,
    node: { binder: binder, body: body, span: span_to(st.node, expression_span(body)) },
  })
}

fn with_scope_expression(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let { parser, node: br } = expect(input, st.parser, token_lbracket(), b"`[` and a scope name")?;
  let { parser, node: resource } = expect_identifier(input, parser, b"a scope name inside `[..]`")?;
  let { parser, .. } = expect_close(input, parser, token_rbracket(), br, b"`]`")?;
  let saved = parser.no_brace;
  match with_scope_rest(input, with_no_brace(parser, false), st.node, resource) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

fn with_scope_rest(
  input: Input,
  parser: Parser,
  span: Span,
  resource: Identifier,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let { parser, node: paren } = expect(
    input,
    parser,
    token_lparen(),
    b"`(` and the expression that acquires the resource",
  )?;
  let { parser, node: acquire } = expression(input, parser)?;
  let { parser, .. } = expect(
    input,
    parser,
    token_comma(),
    b"`,` and the function that releases what was acquired",
  )?;
  let { parser, node: release } = expression(input, parser)?;
  let { parser, .. } = eat(input, parser, token_comma());
  let { parser, .. } = expect_close(
    input,
    parser,
    token_rparen(),
    paren,
    b"`)` after the release function",
  )?;
  let { parser, node: brace } = expect(input, parser, token_lbrace(), b"`{` to start the scope")?;
  let { parser, node: binder } = expect_identifier(
    input,
    parser,
    b"a name to bind the scoped value to",
  )?;
  let { parser, .. } = expect(input, parser, token_arrow(), b"`->` and the scope's body")?;
  let { parser, node: body } = expression(input, parser)?;
  let { parser, node: closing_brace } = expect_close(
    input,
    parser,
    token_rbrace(),
    brace,
    b"`}` to close the scope",
  )?;
  Ok({
    parser: parser,
    node: WithScopeExpression({
      span: span_to(span, closing_brace),
      resource: resource,
      acquire: acquire,
      release: release,
      binder: binder,
      body: body,
    }),
  })
}

fn simulate_expression(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let { parser, node: body } = block_expression(input, st.parser)?;
  Ok({
    parser: parser,
    node: SimulateExpression({ span: span_to(st.node, expression_span(body)), body: body }),
  })
}

fn opens_try(input: Input, parser: Parser) -> Bool =
  token_kind_at(input, parser, 1) == token_lbrace()
    || (token_kind_at(input, parser, 1) == token_lbracket()
    && (match token_kind_at(input, parser, 2) { Identifier(_) -> true, _ -> false })
    && (token_kind_at(input, parser, 3) == token_dot()
    || token_kind_at(input, parser, 3) == token_coloncolon()))

fn try_expression(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let saved = st.parser.no_brace;
  match try_rest(input, with_no_brace(st.parser, false), st.node) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

fn try_rest(
  input: Input,
  parser: Parser,
  start: Span,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let { parser, node: raise } = try_raise(input, parser)?;
  let { parser, node: body } = block_expression(input, parser)?;
  Ok({
    parser: parser,
    node: TryBlockExpression({
      span: span_to(start, expression_span(body)),
      raise: raise,
      body: body,
    }),
  })
}

fn try_raise(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Option<RaiseName>>, Parser> / {abort.raise} =
  if !at_token(input, parser, token_lbracket()) { Ok({ parser: parser, node: None }) } else {
    let o = advance(input, parser);
    let { parser, node: eff } = qualified_name(input, o.parser, b"an effect name")?;
    let { parser, .. } = expect(input, parser, token_dot(), b"`.` and the operation name")?;
    let { parser, node: operation } = expect_identifier(input, parser, b"an operation name")?;
    let { parser, .. } = expect_close(input, parser, token_rbracket(), o.node, b"`]`")?;
    Ok({ parser: parser, node: Some({ effect_name: eff, operation: operation }) })
  }

fn parallel_expression(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Expression>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let saved = st.parser.no_brace;
  let { parser, node: brace } = expect(
    input,
    with_no_brace(st.parser, false),
    token_lbrace(),
    b"`{` to start the branches",
  )?;
  let { parser, node: branches } = comma_list(input, parser, token_rbrace(), expression)?;
  if branches.len() < 2 { Err(error_here(input, parser, b"`,` and a second branch")) } else {
    let { parser, node: closing_brace } = expect_close(
      input,
      parser,
      token_rbrace(),
      brace,
      b"`}` to close the branches",
    )?;
    Ok({
      parser: with_no_brace(parser, saved),
      node: ParallelExpression({ span: span_to(st.node, closing_brace), branches: branches }),
    })
  }
}

pub fn dump_expression(expression: Expression) -> Bytes / {abort.raise} =
  match expression {
    LiteralExpression(v) -> dump_node(v.span, b"elit").concat(dump_literal(v.literal)),
    NameExpression(v) -> dump_node(v.span, b"evar").concat(dump_qualified_name(v.name)),
    BinaryExpression(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"ebin"),
        dump_word(v.operation),
        dump_expression(v.left_operand),
        dump_expression(v.right_operand),
      ]),
    UnaryExpression(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"eun"),
        dump_word(v.operation),
        dump_expression(v.operand),
      ]),
    LambdaExpression(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"elam"),
        dump_list(v.params, dump_param),
        dump_opt(v.return_clause, dump_type),
        dump_expression(v.body),
      ]),
    CallExpression(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"eapp"),
        dump_expression(v.function),
        dump_list(v.args, dump_expression),
        dump_list(v.named, dump_named),
        dump_list(v.labels, dump_identifier),
      ]),
    IfExpression(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"eif"),
        dump_expression(v.cond),
        dump_expression(v.then_branch),
        dump_expression(v.else_branch),
      ]),
    MatchExpression(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"emat"),
        dump_expression(v.scrutinee),
        dump_list(v.arms, dump_arm),
      ]),
    BlockExpression(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"eblk"),
        dump_list(v.statements, dump_statement),
        dump_opt(v.tail, dump_expression),
      ]),
    RecordExpression(v) -> dump_node(v.span, b"erec").concat(dump_list(v.fields, dump_field)),
    RecordUpdateExpression(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"erup"),
        dump_expression(v.base),
        dump_list(v.fields, dump_field),
      ]),
    PropagateExpression(v) -> dump_node(v.span, b"etry").concat(dump_expression(v.operand)),
    FieldExpression(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"efld"),
        dump_expression(v.base),
        dump_identifier(v.field),
      ]),
    ListExpression(v) -> dump_node(v.span, b"elst").concat(dump_list(v.items, dump_expression)),
    PerformExpression(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"eprf"),
        dump_qualified_name(v.effect_name),
        dump_identifier(v.operation),
        dump_opt(v.resource, dump_identifier),
        dump_list(v.args, dump_expression),
      ]),
    HandleExpression(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"ehnd"),
        dump_expression(v.body),
        dump_list(v.clauses, dump_clause),
        dump_opt(v.return_clause, dump_return),
        if v.handler_variables.len() == 0 { b"" }
        else { dump_word(b"vars").concat(dump_list(v.handler_variables, dump_handler_variable)) },
      ]),
    WithScopeExpression(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"ehld"),
        dump_identifier(v.resource),
        dump_expression(v.acquire),
        dump_expression(v.release),
        dump_identifier(v.binder),
        dump_expression(v.body),
      ]),
    SimulateExpression(v) -> dump_node(v.span, b"esim").concat(dump_expression(v.body)),
    ParallelExpression(v) ->
      dump_node(v.span, b"epar").concat(dump_list(v.branches, dump_expression)),
    TaggedLiteralExpression(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"etag"),
        dump_identifier(v.tag),
        dump_literal(LiteralString(v.text)),
        dump_list(v.holes, |h: Hole|
          dump_expression(h.value).concat(dump_literal(LiteralString(h.text)))),
      ]),
    HoleExpression(v) -> dump_node(v.span, b"ehole").concat(dump_literal(LiteralString(v.text))),
    InvalidExpression(v) -> dump_node(v.span, b"ebad"),
    TryBlockExpression(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"etrb"),
        dump_opt(v.raise, |r: RaiseName|
          dump_qualified_name(r.effect_name).concat(dump_identifier(r.operation))),
        dump_expression(v.body),
      ]),
  }

fn dump_field(field: RecordLiteralField) -> Bytes / {abort.raise} =
  dump_identifier(field.name).concat(dump_expression(field.value))

fn dump_named(arg: NamedArg) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_node(arg.span, b"narg"),
    dump_identifier(arg.name),
    dump_expression(arg.value),
  ])

pub fn dump_param(lambda_parameter: Param) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_node(lambda_parameter.span, b"prm"),
    dump_identifier(lambda_parameter.name),
    if lambda_parameter.keep { dump_word(b"keep") } else { b"" },
    dump_opt(lambda_parameter.ty, dump_type),
    match lambda_parameter.cost {
      Some(k) -> dump_word(b"cost").concat(dump_identifier(k)),
      None -> b"",
    },
    match lambda_parameter.space {
      Some(s) -> dump_word(b"space").concat(dump_identifier(s)),
      None -> b"",
    },
    dump_opt(lambda_parameter.default, dump_expression),
  ])

pub fn dump_statement(statement: Statement) -> Bytes / {abort.raise} =
  match statement {
    LetStatement(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"slet"),
        dump_pattern(v.pattern),
        dump_opt(v.ty, dump_type),
        dump_expression(v.value),
      ]),
    LetElseStatement(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"slete"),
        dump_pattern(v.pattern),
        dump_opt(v.ty, dump_type),
        dump_expression(v.value),
        dump_expression(v.fallback),
      ]),
    ExpressionStatement(e) -> dump_node(expression_span(e), b"sexp").concat(dump_expression(e)),
    AssignmentStatement(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"sasg"),
        dump_identifier(v.name),
        dump_expression(v.value),
      ]),
  }

pub fn dump_arm(arm: MatchArm) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_node(arm.span, b"arm"),
    dump_pattern(arm.pattern),
    dump_opt(arm.guard, dump_expression),
    dump_expression(arm.body),
  ])

pub fn dump_clause(clause: HandleClause) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_node(clause.span, b"hcl"),
    dump_qualified_name(clause.effect_name),
    dump_identifier(clause.operation),
    dump_opt(clause.resource, dump_identifier),
    dump_opt(clause.label_binder, dump_identifier),
    dump_list(clause.params, dump_identifier),
    dump_opt(clause.resume, dump_identifier),
    dump_expression(clause.body),
  ])

pub fn dump_handler_variable(v: HandlerStateVariable) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_node(v.span, b"hvar"),
    dump_identifier(v.name),
    dump_opt(v.ty, dump_type),
    dump_expression(v.init),
  ])

pub fn dump_return(clause: ReturnClause) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_node(clause.span, b"rcl"),
    dump_identifier(clause.binder),
    dump_expression(clause.body),
  ])

pub fn dump_expression_of(source: Bytes) -> String / {abort.raise} = {
  let s = start(source);
  let r = expression(s.input, s.parser);
  let v = parsed_or(r, no_expression());
  let bad = failed(r);
  let fin = if bad || at_eof(s.input, v.parser) { v.parser }
  else { error_here(s.input, v.parser, b"end of input after the expression") };
  let tree = if bad || !at_eof(s.input, v.parser) { b"" } else { dump_expression(v.node) };
  String::of_bytes(tree.concat(dump_diagnostics(fin.diagnostics)))
}

pub fn dump_param_of(source: Bytes) -> String / {abort.raise} = {
  let s = start(source);
  let r = parsed_or(lambda_parameter(s.input, s.parser), no_param());
  String::of_bytes(dump_param(r.node).concat(dump_diagnostics(r.parser.diagnostics)))
}

pub fn dump_function_parameter_of(source: Bytes) -> String / {abort.raise} = {
  let s = start(source);
  let r = parsed_or(function_parameter(s.input, s.parser), no_param());
  String::of_bytes(dump_param(r.node).concat(dump_diagnostics(r.parser.diagnostics)))
}

pub fn node_count(expression: Expression) -> Int =
  match expression {
    LiteralExpression(v) -> 1,
    NameExpression(v) -> 1,
    BinaryExpression(v) -> 1 + node_count(v.left_operand) + node_count(v.right_operand),
    UnaryExpression(v) -> 1 + node_count(v.operand),
    LambdaExpression(v) -> 1 + count_params(v.params) + node_count(v.body),
    CallExpression(v) ->
      1 + node_count(v.function) + count_all(v.args)
        + v.named.fold(0, |n: Int, arg: NamedArg| n + 1 + node_count(arg.value)),
    IfExpression(v) ->
      1 + node_count(v.cond) + node_count(v.then_branch) + node_count(v.else_branch),
    MatchExpression(v) ->
      1 + node_count(v.scrutinee)
        + v.arms.fold(0, |n: Int, arm: MatchArm|
          n + 1 + count_opt(arm.guard) + node_count(arm.body)),
    BlockExpression(v) ->
      1 + v.statements.fold(0, |n: Int, statement: Statement| n + count_statement(statement))
        + count_opt(v.tail),
    RecordExpression(v) ->
      1 + v.fields.fold(0, |n: Int, field: RecordLiteralField| n + 1 + node_count(field.value)),
    RecordUpdateExpression(v) ->
      1 + node_count(v.base)
        + v.fields.fold(0, |n: Int, field: RecordLiteralField| n + 1 + node_count(field.value)),
    PropagateExpression(v) -> 1 + node_count(v.operand),
    FieldExpression(v) -> 1 + node_count(v.base),
    ListExpression(v) -> 1 + count_all(v.items),
    PerformExpression(v) -> 1 + count_all(v.args),
    HandleExpression(v) ->
      1 + node_count(v.body)
        + v.clauses.fold(0, |n: Int, clause: HandleClause|
          n + 1 + clause.params.len() + node_count(clause.body))
        + (match v.return_clause { None -> 0, Some(r) -> 1 + node_count(r.body) })
        + v.handler_variables.fold(0, |n: Int, hv: HandlerStateVariable|
          n + 1 + node_count(hv.init)),
    WithScopeExpression(v) ->
      1 + node_count(v.acquire) + node_count(v.release) + node_count(v.body),
    SimulateExpression(v) -> 1 + node_count(v.body),
    ParallelExpression(v) -> 1 + count_all(v.branches),
    TaggedLiteralExpression(v) -> 1 + v.holes.fold(0, |n: Int, h: Hole| n + node_count(h.value)),
    HoleExpression(_) -> 1,
    InvalidExpression(v) -> 1,
    TryBlockExpression(v) -> 1 + node_count(v.body),
  }

fn count_all(expressions: List<Expression>) -> Int =
  expressions.fold(0, |n: Int, expression: Expression| n + node_count(expression))

pub fn count_params(params: List<Param>) -> Int =
  params.fold(0, |n: Int, lambda_parameter: Param| n + 1 + count_opt(lambda_parameter.default))

fn count_opt(expression: Option<Expression>) -> Int =
  match expression { None -> 0, Some(x) -> node_count(x) }

fn count_statement(statement: Statement) -> Int =
  match statement {
    LetStatement(v) -> 1 + node_count(v.value),
    LetElseStatement(v) -> 1 + node_count(v.value) + node_count(v.fallback),
    ExpressionStatement(e) -> 1 + node_count(e),
    AssignmentStatement(v) -> 1 + node_count(v.value),
  }

pub fn parse_count(source: Bytes) -> Int / {abort.raise} = {
  let s = start(source);
  node_count(parsed_or(expression(s.input, s.parser), no_expression()).node)
}

pub fn is_arithmetic(operation: Bytes) -> Bool =
  operation == b"add" || operation == b"sub" || operation == b"mul" || operation == b"div"
    || operation == b"rem"

pub fn is_order_comparison(operation: Bytes) -> Bool =
  operation == b"lt" || operation == b"le" || operation == b"gt" || operation == b"ge"

test "the bit operators sit between the comparisons and the concatenation, loosest first" {
  assert_eq(
    dump_expression_of(b"a | b ^ c & d"),
    "0:13:ebin;%bitor;0:1:evar;0:1:qname;?0;0:1:ident;@61;4:13:ebin;%bitxor;4"
      ++ ":5:evar;4:5:qname;?0;4:5:ident;@62;8:13:ebin;%bitand;8:9:evar;8:9:qname;"
      ++ "?0;8:9:ident;@63;12:13:evar;12:13:qname;?0;12:13:ident;@64;#0;",
  )
}

test "a shift is written with adjacent `<` or `>` characters, and `>>>` is read before `>>`" {
  assert_eq(
    dump_expression_of(b"a << b >> c >>> d"),
    "0:17:ebin;%ushr;0:11:ebin;%shr;0:6:ebin;%shl;0:1:evar;0:1:qname;?0;0:1:i"
      ++ "dent;@61;5:6:evar;5:6:qname;?0;5:6:ident;@62;10:11:evar;10:11:qname;?0;1"
      ++ "0:11:ident;@63;16:17:evar;16:17:qname;?0;16:17:ident;@64;#0;",
  )
}

test "`~` is a unary operator, tighter than any binary" {
  assert_eq(
    dump_expression_of(b"~a + b"),
    "0:6:ebin;%add;0:2:eun;%bitnot;1:2:evar;1:2:qname;?0;1:2:ident;@61;5:6:ev"
      ++ "ar;5:6:qname;?0;5:6:ident;@62;#0;",
  )
}

test "inside a lambda's parameter list a `|` closes the list; in its body it is bit-or again" {
  assert_eq(
    dump_expression_of(b"|x = 1| x | 2"),
    "0:13:elam;#1;1:2:prm;1:2:ident;@78;?0;?0;?0;8:13:ebin;%bitor;8:9:evar;8:"
      ++ "9:qname;?0;8:9:ident;@78;12:13:elit;%int;@32;#1;!E0120:3:6:1:1;=3:6:1;",
  )
}

test "a keyword names a field in a literal and after `.`" {
  assert_eq(
    dump_expression_of(b"{effect: 1, type: 2}.type"),
    "0:25:efld;0:20:erec;#2;1:7:ident;@656666656374;9:10:elit;%int;@31;12:16:"
      ++ "ident;@74797065;18:19:elit;%int;@32;21:25:ident;@74797065;#0;",
  )
}

test "the try operator is a node of its own and takes the `?` into its span" {
  assert_eq(dump_expression_of(b"x?"), "0:2:etry;0:1:evar;0:1:qname;?0;0:1:ident;@78;#0;");
  assert_eq(
    dump_expression_of(b"x??"),
    "0:3:etry;0:2:etry;0:1:evar;0:1:qname;?0;0:1:ident;@78;#0;",
  );
}

test "`???` and `..` each parse as one hole expression, and `x???` is a syntax error" {
  assert_eq(dump_expression_of(b"???"), "0:3:ehole;%str;@3f3f3f;#0;");
  assert_eq(dump_expression_of(b".."), "0:2:ehole;%str;@2e2e;#0;");
  assert_eq(
    dump_expression_of(b"f(???)"),
    "0:6:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;2:5:ehole;%str;@3f3f3f;#0;#0;#0;",
  );
  assert_eq(dump_expression_of(b"x???"), "#1;!E0001:1:4:1:0;=1:4:1;");
  assert_eq(
    dump_expression_of(b"{ ..r, x: 1 }"),
    "0:13:erup;4:5:evar;4:5:qname;?0;4:5:ident;@72;#1;7:8:ident;@78;10:11:elit;%int;@31;#0;",
  )
}

test "the try operator binds tighter than a unary and than any binary" {
  assert_eq(
    dump_expression_of(b"-x?"),
    "0:3:eun;%neg;1:3:etry;1:2:evar;1:2:qname;?0;1:2:ident;@78;#0;",
  );
  assert_eq(
    dump_expression_of(b"x? + y"),
    "0:6:ebin;%add;0:2:etry;0:1:evar;0:1:qname;?0;0:1:ident;@78;"
      ++ "5:6:evar;5:6:qname;?0;5:6:ident;@79;#0;",
  )
}

test "the parser reads the expression after `..` in a record update as the base, and `{..b}` needs no comma" {
  assert_eq(
    dump_expression_of(b"{..b, x: 1}"),
    "0:11:erup;3:4:evar;3:4:qname;?0;3:4:ident;@62;#1;6:7:ident;@78;" ++ "9:10:elit;%int;@31;#0;",
  );
  assert_eq(dump_expression_of(b"{..b}"), "0:5:erup;3:4:evar;3:4:qname;?0;3:4:ident;@62;#0;#0;")
}

test "the base of a record update is a path and not an expression" {
  assert_eq(
    dump_expression_of(b"{..s.i, x: 1}"),
    "0:13:erup;3:6:efld;3:4:evar;3:4:qname;?0;3:4:ident;@73;5:6:ident;@69;"
      ++ "#1;8:9:ident;@78;11:12:elit;%int;@31;#0;",
  );
  assert_eq(dump_expression_of(b"{...b}"), "#1;!E0001:1:4:1:1;=1:4:1;");
  assert_eq(dump_expression_of(b"{..a, ..b}"), "#1;!E0001:6:8:1:1;=6:8:1;")
}

test "the base of a record update may be a qualified name, or a call of one" {
  assert(dump_expression_of(b"{..m::b, x: 1}").starts_with("0:14:erup;3:7:evar;3:7:qname;?1;"));
  let call = dump_expression_of(b"{..m::f(x)}");
  assert(call.starts_with("0:11:erup;3:10:eapp;"));
  assert(call.contains("3:7:qname;?1;"));
  assert(dump_expression_of(b"{..store.held(), x: 1}").starts_with("0:22:erup;3:15:eprf;"));
  assert(dump_expression_of(b"{..store.held[db]()}").starts_with("0:20:erup;3:19:eprf;"))
}

test "a named argument is a node with its own span, its name and its value" {
  assert_eq(
    dump_expression_of(b"f(1, b: 2)"),
    "0:10:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;2:3:elit;%int;@31;"
      ++ "#1;5:9:narg;5:6:ident;@62;8:9:elit;%int;@32;#0;#0;",
  );
  assert_eq(
    dump_expression_of(b"f(x)"),
    "0:4:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;2:3:evar;2:3:qname;?0;"
      ++ "2:3:ident;@78;#0;#0;#0;",
  )
}

test "each positional argument after a named argument produces its own diagnostic" {
  assert_eq(
    dump_expression_of(b"f(a: 1, 2)"),
    "0:10:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;8:9:elit;%int;@32;"
      ++ "#1;2:6:narg;2:3:ident;@61;5:6:elit;%int;@31;#0;"
      ++ "#1;!E0124:8:9:2:1;=8:9:1;=2:6:0;",
  );
  assert_eq(
    dump_expression_of(b"f(a: 1, 2, 3)"),
    "0:13:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#2;8:9:elit;%int;@32;"
      ++ "11:12:elit;%int;@33;#1;2:6:narg;2:3:ident;@61;5:6:elit;%int;@31;#0;"
      ++ "#2;!E0124:8:9:2:1;=8:9:1;=2:6:0;!E0124:11:12:2:1;=11:12:1;=2:6:0;",
  )
}

test "a parameter's type and its default are both optional" {
  assert_eq(dump_param_of(b"x"), "0:1:prm;0:1:ident;@78;?0;?0;#0;");
  assert_eq(
    dump_param_of(b"x: Int"),
    "0:6:prm;0:1:ident;@78;?1;3:6:tcon;3:6:qname;?0;3:6:ident;@496e74;#0;?0;#0;",
  );
  assert_eq(
    dump_param_of(b"x: (Int) -> Bool"),
    "0:16:prm;0:1:ident;@78;?1;3:16:tfn;#1;4:7:tcon;4:7:qname;?0;4:7:ident;@496e74;#0;12:16:tcon;12:16:qname;?0;12:16:ident;@426f6f6c;#0;?0;?0;#0;",
  );
  assert_eq(dump_param_of(b"x:"), "0:0:prm;0:0:ident;@;?0;?0;#1;!E0001:2:2:1:0;=2:2:1;")
}

test "a fn parameter may carry a default and a lambda parameter may not" {
  assert_eq(
    dump_function_parameter_of(b"x: Int = 1"),
    "0:10:prm;0:1:ident;@78;?1;3:6:tcon;3:6:qname;?0;3:6:ident;@496e74;#0;"
      ++ "?1;9:10:elit;%int;@31;#0;",
  );
  assert_eq(
    dump_function_parameter_of(b"x = 1"),
    "0:5:prm;0:1:ident;@78;?0;?1;4:5:elit;%int;@31;#0;",
  );
  assert_eq(
    dump_param_of(b"x: Int = 1"),
    "0:6:prm;0:1:ident;@78;?1;3:6:tcon;3:6:qname;?0;3:6:ident;@496e74;#0;"
      ++ "?0;#1;!E0120:7:10:1:1;=7:10:1;",
  )
}

test "a parameter of function type may have a `cost` clause naming a variable, and other parameters cannot" {
  let named = dump_function_parameter_of(b"g: (Int) -> Int cost k");
  assert(named.contains("%cost;"), Some(named));
  assert(named.ends_with(";@6b;?0;#0;"), Some(named));
  assert(dump_function_parameter_of(b"n: Int cost k").contains("!E0001"));
  assert(!dump_param_of(b"g: (Int) -> Int cost k").contains("%cost;"))
}

test "a parameter of function type may have a `space` clause after its `cost` clause, and other parameters cannot" {
  let named = dump_function_parameter_of(b"g: (Int) -> Int space s");
  assert(named.contains("%space;") && !named.contains("%cost;"), Some(named));
  assert(named.ends_with(";@73;?0;#0;"), Some(named));
  let both = dump_function_parameter_of(b"g: (Int) -> Int cost k space s");
  assert(both.contains("%cost;") && both.ends_with(";@73;?0;#0;"), Some(both));
  assert(dump_function_parameter_of(b"n: Int space s").contains("!E0001"));
  assert(!dump_function_parameter_of(b"g: (Int) -> Int space s cost k").contains("%cost;"));
  assert(!dump_param_of(b"g: (Int) -> Int space s").contains("%space;"))
}

test "`keep` before a parameter's type is parsed as a flag on the parameter, but `keep` alone is a type variable name" {
  let keep_dump = dump_function_parameter_of(b"g: keep (Int) -> Int");
  assert(keep_dump.contains("%keep;"), Some(keep_dump));
  assert(!dump_function_parameter_of(b"g: (Int) -> Int").contains("%keep;"));
  let resource = dump_function_parameter_of(b"c: keep Conn");
  assert(resource.contains("%keep;") && !resource.contains("!E0001"), Some(resource));
  let named = dump_function_parameter_of(b"n: keep");
  assert(
    named.contains(":tvar;") && !named.contains("%keep;") && !named.contains("!E0001"),
    Some(named),
  );
  assert(dump_param_of(b"c: keep Conn").contains("%keep;"))
}

test "a parameter may be named `_`, with or without a type" {
  assert_eq(dump_param_of(b"_"), "0:1:prm;0:1:ident;@5f;?0;?0;#0;");
  assert_eq(
    dump_function_parameter_of(b"_: Int"),
    "0:6:prm;0:1:ident;@5f;?1;3:6:tcon;3:6:qname;?0;3:6:ident;@496e74;#0;?0;#0;",
  )
}

test "a literal expression records its own source span and its decoded value" {
  assert_eq(dump_expression_of(b"1"), "0:1:elit;%int;@31;#0;");
  assert_eq(dump_expression_of(b"true"), "0:4:elit;%bool;@31;#0;");
  assert_eq(dump_expression_of(b"()"), "0:2:elit;%unit;#0;");
  assert_eq(dump_expression_of(b"\"a\\n\""), "0:5:elit;%str;@610a;#0;");
}

test "a name directly followed by a string is a tagged literal that accepts postfixes like `.n`, and a space between them is an error" {
  assert_eq(dump_expression_of(b"hex\"a\\n\""), "0:8:etag;0:3:ident;@686578;%str;@610a;#0;#0;");
  assert_eq(
    dump_expression_of(b"hex\"\".n"),
    "0:7:efld;0:5:etag;0:3:ident;@686578;%str;@;#0;6:7:ident;@6e;#0;",
  );
  assert_eq(dump_expression_of(b"hex \"a\""), "#1;!E0001:4:7:1:0;=4:7:1;")
}

test "a tagged string literal parses each `{...}` as an embedded expression between its text parts, and `{{` and `}}` give literal braces" {
  assert_eq(
    dump_expression_of(b"sh\"a {x} {{b}}\""),
    "0:15:etag;0:2:ident;@7368;%str;@6120;#1;6:7:evar;6:7:qname;?0;6:7:ident;@78;%str;@207b627d;#0;",
  );
  assert_eq(
    dump_expression_of(b"sh\"{ {n: 1}.n }{sh\"{y}\"}\""),
    "0:25:etag;0:2:ident;@7368;%str;@;#2;5:13:efld;5:11:erec;#1;6:7:ident;@6e;9:10:elit;%int;@31;12:13:ident;@6e;%str;@;16:23:etag;16:18:ident;@7368;%str;@;#1;20:21:evar;20:21:qname;?0;20:21:ident;@79;%str;@;%str;@;#0;",
  );
  assert(dump_expression_of(b"sh\"{x y}\"").starts_with("#1;!E0001"))
}

test "a float and a decimal are the source text, and no value is ever built" {
  assert_eq(dump_expression_of(b"1.5e-3"), "0:6:elit;%float;@312e35652d33;#0;");
  assert_eq(dump_expression_of(b"1.50m"), "0:5:elit;%dec;@312e35306d;#0;");
}

test "precedence binds the tighter operator first and stays left-associative" {
  assert_eq(
    dump_expression_of(b"1 + 2 * 3"),
    "0:9:ebin;%add;0:1:elit;%int;@31;4:9:ebin;%mul;4:5:elit;%int;@32;8:9:elit;%int;@33;#0;",
  );
  assert_eq(
    dump_expression_of(b"1 - 2 - 3"),
    "0:9:ebin;%sub;0:5:ebin;%sub;0:1:elit;%int;@31;4:5:elit;%int;@32;8:9:elit;%int;@33;#0;",
  );
}

test "a long chain of left-associative `+` parses without diagnostics into one node per operand and operator" {
  let whole = Bytes::concat_all(range(0, 400).map(|i: Int| b"1 + ")).concat(b"1");
  let s = start(whole);
  let rr = expression(s.input, s.parser);
  assert(!failed(rr));
  let r = parsed_or(rr, no_expression());
  assert_eq(r.parser.diagnostics.len(), 0);
  assert_eq(node_count(r.node), 801);
}

test "a long `else if` chain and an expression using every binary operator precedence level both parse without diagnostics" {
  let arms = Bytes::concat_all(range(0, 2 * max_depth()).map(|i: Int| b"if x { 1 } else "));
  let chained = start(arms.concat(b"{ 2 }"));
  let read = expression(chained.input, chained.parser);
  assert(!failed(read));
  assert_eq(parsed_or(read, no_expression()).parser.diagnostics.len(), 0);
  let climbing = start(b"a || b && c == d | e ^ f & g << h ++ i + j * k");
  let climbed = expression(climbing.input, climbing.parser);
  assert(!failed(climbed));
  assert_eq(parsed_or(climbed, no_expression()).parser.diagnostics.len(), 0)
}

test "parentheses nested one level below the maximum depth parse, and the maximum depth fails with a nesting diagnostic" {
  let nested = |n: Int|
    Bytes::concat_all([
      Bytes::concat_all(range(0, n).map(|i: Int| b"(")),
      b"1",
      Bytes::concat_all(range(0, n).map(|i: Int| b")")),
    ]);
  let deepest = start(nested(max_depth() - 1));
  let fits = expression(deepest.input, deepest.parser);
  assert(!failed(fits));
  assert_eq(parsed_or(fits, no_expression()).parser.diagnostics.len(), 0);
  let past = start(nested(max_depth()));
  match expression(past.input, past.parser) {
    Ok(_) -> assert(false),
    Err(q) ->
      assert_eq(q.diagnostics.map(|d: ParseDiagnostic| d.message), [
        b"input is nested too deeply to parse",
      ]),
  }
}

test "`-` and `!` parse as unary operators, including `-` directly before a literal" {
  assert_eq(dump_expression_of(b"-1"), "0:2:eun;%neg;1:2:elit;%int;@31;#0;");
  assert_eq(dump_expression_of(b"!x"), "0:2:eun;%not;1:2:evar;1:2:qname;?0;1:2:ident;@78;#0;");
}

test "application and field access chain left to right" {
  assert_eq(
    dump_expression_of(b"f(1)(2)"),
    "0:7:eapp;0:4:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;2:3:elit;%int;@31;#0;#0;#1;5:6:elit;%int;@32;#0;#0;#0;",
  );
  assert_eq(
    dump_expression_of(b"r.a.b"),
    "0:5:efld;0:3:efld;0:1:evar;0:1:qname;?0;0:1:ident;@72;2:3:ident;@61;4:5:ident;@62;#0;",
  );
}

test "a `.` before a name and an argument list parses as an effect operation call, not a field read" {
  assert_eq(
    dump_expression_of(b"db.get[users](k)"),
    "0:16:eprf;0:2:qname;?0;0:2:ident;@6462;3:6:ident;@676574;?1;7:12:ident;@7573657273;#1;14:15:evar;14:15:qname;?0;14:15:ident;@6b;#0;",
  );
  assert_eq(
    dump_expression_of(b"db.get(k)"),
    "0:9:eprf;0:2:qname;?0;0:2:ident;@6462;3:6:ident;@676574;?0;#1;7:8:evar;7:8:qname;?0;7:8:ident;@6b;#0;",
  );
  assert_eq(
    dump_expression_of(b"db.get"),
    "0:6:efld;0:2:evar;0:2:qname;?0;0:2:ident;@6462;3:6:ident;@676574;#0;",
  );
}

test "a call may list effect or type arguments in brackets before its arguments, and brackets with no arguments are a syntax error" {
  assert_eq(
    dump_expression_of(b"relay[conn](c)"),
    "0:14:eapp;0:5:evar;0:5:qname;?0;0:5:ident;@72656c6179;#1;12:13:evar;"
      ++ "12:13:qname;?0;12:13:ident;@63;#0;#1;6:10:ident;@636f6e6e;#0;",
  );
  assert_eq(
    dump_expression_of(b"f[a, b](x)"),
    "0:10:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;8:9:evar;8:9:qname;?0;"
      ++ "8:9:ident;@78;#0;#2;2:3:ident;@61;5:6:ident;@62;#0;",
  );
  assert(dump_expression_of(b"f[a]").contains("!E0001:1:2:"))
}

test "a block-like expression may be a scrutinee or a condition" {
  let handled = dump_expression_of(
    b"match handle { g() } with { e.op(x) resume k -> 0 } { y -> y }",
  );
  assert(!handled.contains("!E"));
  assert(handled.contains(":emat;"));
  assert(handled.contains(":ehnd;"));
  let branched = dump_expression_of(b"match if c { 1 } else { 2 } { y -> y }");
  assert(!branched.contains("!E"));
  assert(branched.contains(":eif;"));
  let nested = dump_expression_of(b"match match x { _ -> 1 } { y -> y }");
  assert(!nested.contains("!E"));
  let blocked = dump_expression_of(b"match { x } { y -> y }");
  assert(!blocked.contains("!E"));
  assert(blocked.contains(":eblk;"));
  assert(!dump_expression_of(b"if { x } { 1 }").contains("!E"))
}

test "a brace after an `if` scrutinee opens the block, never a record" {
  assert_eq(
    dump_expression_of(b"if x { 1 } else { 2 }"),
    "0:21:eif;3:4:evar;3:4:qname;?0;3:4:ident;@78;5:10:eblk;#0;?1;7:8:elit;%int;@31;16:21:eblk;#0;?1;18:19:elit;%int;@32;#0;",
  );
}

test "an `if` with no `else` gets a unit whose span is empty and at the end" {
  assert_eq(
    dump_expression_of(b"if x { 1 }"),
    "0:10:eif;3:4:evar;3:4:qname;?0;3:4:ident;@78;5:10:eblk;#0;?1;7:8:elit;%int;@31;10:10:elit;%unit;#0;",
  );
}

test "`else if` chains rather than nesting a block" {
  assert_eq(
    dump_expression_of(b"if a { 1 } else if b { 2 }"),
    "0:26:eif;3:4:evar;3:4:qname;?0;3:4:ident;@61;5:10:eblk;#0;?1;7:8:elit;%int;@31;16:26:eif;19:20:evar;19:20:qname;?0;19:20:ident;@62;21:26:eblk;#0;?1;23:24:elit;%int;@32;26:26:elit;%unit;#0;",
  );
}

test "`{x: e}` and `{x, y}` are records and `{x}` is a block" {
  assert_eq(dump_expression_of(b"{a: 1}"), "0:6:erec;#1;1:2:ident;@61;4:5:elit;%int;@31;#0;");
  assert_eq(
    dump_expression_of(b"{a, b}"),
    "0:6:erec;#2;1:2:ident;@61;1:2:evar;1:2:qname;?0;1:2:ident;@61;4:5:ident;@62;4:5:evar;4:5:qname;?0;4:5:ident;@62;#0;",
  );
  assert_eq(dump_expression_of(b"{a}"), "0:3:eblk;#0;?1;1:2:evar;1:2:qname;?0;1:2:ident;@61;#0;");
}

test "a block separates its statements from its tail" {
  assert_eq(
    dump_expression_of(b"{ let x = 1; x }"),
    "0:16:eblk;#1;2:12:slet;6:7:pvar;6:7:ident;@78;?0;10:11:elit;%int;@31;?1;13:14:evar;13:14:qname;?0;13:14:ident;@78;#0;",
  );
  assert_eq(dump_expression_of(b"{ 1; }"), "0:6:eblk;#1;2:3:sexp;2:3:elit;%int;@31;?0;#0;");
}

test "`let ... else` is its own statement, its `else` block after the initializer" {
  assert_eq(
    dump_expression_of(b"{ let Some(x) = o else { 0 }; x }"),
    "0:33:eblk;#1;2:29:slete;6:13:pctr;6:10:qname;?0;6:10:ident;@536f6d65;#1;11:12:pvar;11:12:ident;@78;?0;16:17:evar;16:17:qname;?0;16:17:ident;@6f;23:28:eblk;#0;?1;25:26:elit;%int;@30;?1;30:31:evar;30:31:qname;?0;30:31:ident;@78;#0;",
  );
  assert_eq(
    dump_expression_of(b"{ let 1 = if a { 1 } else { 2 } else { 3 }; 4 }"),
    "0:47:eblk;#1;2:43:slete;6:7:plit;%int;@31;?0;10:31:eif;13:14:evar;13:14:qname;?0;13:14:ident;@61;15:20:eblk;#0;?1;17:18:elit;%int;@31;26:31:eblk;#0;?1;28:29:elit;%int;@32;37:42:eblk;#0;?1;39:40:elit;%int;@33;?1;44:45:elit;%int;@34;#0;",
  )
}

test "the `else` of a `let ... else` is a block" {
  assert_eq(dump_expression_of(b"{ let Some(x) = o else 0; x }"), "#1;!E0001:23:24:1:0;=23:24:1;")
}

test "a block-like statement needs no semicolon and anything else does" {
  assert_eq(
    dump_expression_of(b"{ if a { 1 } 2 }"),
    "0:16:eblk;#1;2:12:sexp;2:12:eif;5:6:evar;5:6:qname;?0;5:6:ident;@61;7:12:eblk;#0;?1;9:10:elit;%int;@31;12:12:elit;%unit;?1;13:14:elit;%int;@32;#0;",
  );
  assert_eq(dump_expression_of(b"{ 1 2 }"), "#1;!E0001:4:5:1:0;=4:5:1;");
}

test "a lambda takes typed or untyped parameters, and `||` takes none" {
  assert_eq(
    dump_expression_of(b"|x| x"),
    "0:5:elam;#1;1:2:prm;1:2:ident;@78;?0;?0;?0;4:5:evar;4:5:qname;?0;4:5:ident;@78;#0;",
  );
  assert_eq(dump_expression_of(b"|| 1"), "0:4:elam;#0;?0;3:4:elit;%int;@31;#0;");
  assert_eq(
    dump_expression_of(b"|x: Int| x"),
    "0:10:elam;#1;1:7:prm;1:2:ident;@78;?1;4:7:tcon;4:7:qname;?0;4:7:ident;@496e74;#0;?0;?0;9:10:evar;9:10:qname;?0;9:10:ident;@78;#0;",
  );
}

test "a match arm takes a guard and needs a comma unless its body is block-like" {
  assert_eq(
    dump_expression_of(b"match x { 1 -> 2, _ -> 3 }"),
    "0:26:emat;6:7:evar;6:7:qname;?0;6:7:ident;@78;#2;10:16:arm;10:11:plit;%int;@31;?0;15:16:elit;%int;@32;18:24:arm;18:19:pwld;?0;23:24:elit;%int;@33;#0;",
  );
  assert_eq(
    dump_expression_of(b"match x { y if y -> 1 }"),
    "0:23:emat;6:7:evar;6:7:qname;?0;6:7:ident;@78;#1;10:21:arm;10:11:pvar;10:11:ident;@79;?1;15:16:evar;15:16:qname;?0;15:16:ident;@79;20:21:elit;%int;@31;#0;",
  );
  assert_eq(dump_expression_of(b"match x { 1 -> 2 _ -> 3 }"), "#1;!E0001:17:18:1:0;=17:18:1;");
}

test "a handler parses operation clauses, `resume` clauses that name the continuation, and a `return` clause" {
  assert_eq(
    dump_expression_of(b"handle f() with { e.op(a) resume k -> k(a), return v -> v }"),
    "0:59:ehnd;7:10:eapp;7:8:evar;7:8:qname;?0;7:8:ident;@66;#0;#0;#0;#1;18:42:hcl;18:19:qname;?0;18:19:ident;@65;20:22:ident;@6f70;?0;?0;#1;23:24:ident;@61;?1;33:34:ident;@6b;38:42:eapp;38:39:evar;38:39:qname;?0;38:39:ident;@6b;#1;40:41:evar;40:41:qname;?0;40:41:ident;@61;#0;#0;?1;44:57:rcl;51:52:ident;@76;56:57:evar;56:57:qname;?0;56:57:ident;@76;#0;",
  );
  assert_eq(
    dump_expression_of(b"handle f() with { e.op[*t](a) -> t }"),
    "0:36:ehnd;7:10:eapp;7:8:evar;7:8:qname;?0;7:8:ident;@66;#0;#0;#0;#1;18:34:hcl;18:19:qname;?0;18:19:ident;@65;20:22:ident;@6f70;?0;?1;24:25:ident;@74;#1;27:28:ident;@61;?0;33:34:evar;33:34:qname;?0;33:34:ident;@74;?0;#0;",
  );
  assert_eq(
    dump_expression_of(b"handle f() with { e.op[a](x) -> x }"),
    "0:35:ehnd;7:10:eapp;7:8:evar;7:8:qname;?0;7:8:ident;@66;#0;#0;#0;#1;18:33:hcl;18:19:qname;?0;18:19:ident;@65;20:22:ident;@6f70;?1;23:24:ident;@61;?0;#1;26:27:ident;@78;?0;32:33:evar;32:33:qname;?0;32:33:ident;@78;?0;#0;",
  );
  let two = dump_expression_of(b"handle f() with { return a -> a, return b -> b }");
  assert(two.contains("!E0001:33:46:2:0;=33:46:1;=18:31:0;"));
}

test "a handler's `var`s come before its clauses" {
  assert(!dump_expression_of(b"handle f() with { var s = 0, e.op(a) -> () }").contains("!E0"));
  assert(dump_expression_of(b"handle f() with { e.op(a) -> (), var s = 0 }").contains("!E0001:"))
}

test "`simulate` followed by a block parses as a simulate expression, and alone it is an ordinary variable" {
  assert_eq(
    dump_expression_of(b"simulate { 1 }"),
    "0:14:esim;9:14:eblk;#0;?1;11:12:elit;%int;@31;#0;",
  );
  assert_eq(
    dump_expression_of(b"simulate"),
    "0:8:evar;0:8:qname;?0;0:8:ident;@73696d756c617465;#0;",
  )
}

test "`with_scope` with a scope, an acquire argument, a release argument and a body parses as a scope expression, and alone it is a variable" {
  let dump = dump_expression_of(b"with_scope[f](a, r) { h -> h }");
  assert(dump.starts_with("0:30:ehld;11:12:ident;@66;14:15:evar;"));
  assert_eq(
    dump_expression_of(b"with_scope[f](a, r,) { h -> h }"),
    dump_expression_of(b"with_scope[f](a, r ) { h -> h }"),
  );
  assert_eq(
    dump_expression_of(b"with_scope"),
    "0:10:evar;0:10:qname;?0;0:10:ident;@776974685f73636f7065;#0;",
  );
  assert(dump_expression_of(b"with_scope[f](a) { h -> h }").contains("!E0001:"))
}

test "in a scrutinee a `{` is the arm block, so `simulate` is a name there" {
  assert_eq(
    dump_expression_of(b"if simulate { 1 }"),
    "0:17:eif;3:11:evar;3:11:qname;?0;3:11:ident;@73696d756c617465;12:17:eblk;#0;?1;14:15:elit;%int;@31;17:17:elit;%unit;#0;",
  );
}

test "a record literal in call arguments parses inside an `if` condition, where an unparenthesized record literal is not allowed" {
  assert_eq(
    dump_expression_of(b"if f({a: 1}) { 2 }"),
    "0:18:eif;3:12:eapp;3:4:evar;3:4:qname;?0;3:4:ident;@66;#1;5:11:erec;#1;6:7:ident;@61;9:10:elit;%int;@31;#0;#0;13:18:eblk;#0;?1;15:16:elit;%int;@32;18:18:elit;%unit;#0;",
  );
}

test "list expressions, including the empty list, and calls through a qualified name `m::f` parse" {
  assert_eq(dump_expression_of(b"[1, 2]"), "0:6:elst;#2;1:2:elit;%int;@31;4:5:elit;%int;@32;#0;");
  assert_eq(dump_expression_of(b"[]"), "0:2:elst;#0;#0;");
  assert_eq(
    dump_expression_of(b"m::f(1)"),
    "0:7:eapp;0:4:evar;0:4:qname;?1;0:1:ident;@6d;3:4:ident;@66;#1;5:6:elit;%int;@31;#0;#0;#0;",
  );
}

test "a parenthesized expression takes the parentheses into its span" {
  assert_eq(
    dump_expression_of(b"(1 + 2)"),
    "0:7:ebin;%add;1:2:elit;%int;@31;5:6:elit;%int;@32;#0;",
  );
}

test "an unclosed group reports against the opener as a secondary label" {
  assert_eq(dump_expression_of(b"(1"), "#1;!E0001:2:2:2:0;=2:2:1;=0:1:0;");
}

test "one offset raises one diagnostic, which is `Parser::push`'s dedup rule" {
  let s = start(b"*");
  let r = expression(s.input, s.parser);
  assert(failed(r));
  assert_eq(parsed_or(r, no_expression()).parser.diagnostics.len(), 1);
}

test "the node count walks every node of a small tree" {
  assert_eq(parse_count(b"1 + 2 * 3"), 5);
  assert_eq(parse_count(b"{ let x = 1; [x, x] }"), 6);
}

test "past MAX_DEPTH the parser reports rather than overflowing" {
  let n = 200;
  let deep = Bytes::concat_all(range(0, n).map(|i: Int| b"(")).concat(
    b"1".concat(Bytes::concat_all(range(0, n).map(|i: Int| b")"))),
  );
  let s = start(deep);
  let r = expression(s.input, s.parser);
  assert(failed(r));
  assert_eq(parsed_or(r, no_expression()).parser.diagnostics.len(), 1);
}

test "parentheses nested 60 deep, below `MAX_DEPTH`, parse without diagnostics" {
  let n = 60;
  let deep = Bytes::concat_all(range(0, n).map(|i: Int| b"(")).concat(
    b"1".concat(Bytes::concat_all(range(0, n).map(|i: Int| b")"))),
  );
  let s = start(deep);
  let r = expression(s.input, s.parser);
  assert(!failed(r));
  assert_eq(parsed_or(r, no_expression()).parser.diagnostics.len(), 0);
}

test "`parallel` followed by a block of two or more branches parses as a parallel expression, which can nest, and alone it is a variable" {
  assert_eq(
    dump_expression_of(b"parallel { 1, f() }"),
    "0:19:epar;#2;11:12:elit;%int;@31;14:17:eapp;14:15:evar;14:15:qname;?0;14:15:ident;@66;#0;#0;#0;#0;",
  );
  assert(dump_expression_of(b"parallel { 1, parallel { 2, 3 }, }").contains("14:31:epar;#2;"));
  assert_eq(
    dump_expression_of(b"parallel"),
    "0:8:evar;0:8:qname;?0;0:8:ident;@706172616c6c656c;#0;",
  );
  assert(dump_expression_of(b"if parallel { 1 }").contains("3:11:evar;"));
  assert(dump_expression_of(b"parallel { 1 }").contains("!E0001:"))
}

test "`try` followed by `{` opens a try block that may name an error in brackets, and otherwise `try` is an ordinary variable" {
  assert(dump_expression_of(b"try { 1 }").contains("0:9:etrb;?0;"));
  assert(dump_expression_of(b"try[m::p.bad] { 1 }").contains("0:19:etrb;?1;"));
  assert(dump_expression_of(b"match try { 1 } { _ -> 2 }").contains("6:15:etrb;?0;"));
  assert_eq(dump_expression_of(b"try"), "0:3:evar;0:3:qname;?0;0:3:ident;@747279;#0;");
  assert(dump_expression_of(b"try[conn](1)").contains("0:3:evar;"));
  assert(dump_expression_of(b"try[p.bad] 1").contains("!E0001:"))
}
