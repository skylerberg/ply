//! The lexer: source bytes to tokens and diagnostics.

import std.bytes (is_digit, ascii_of_int, hex_value)
import std.bytes
import std.math (pow)
import std.list
import std.string

// --- Tokens -----------------------------------------------------------------

pub type Punct =
  | Lparen
  | Rparen
  | Lbrace
  | Rbrace
  | Lbracket
  | Rbracket
  | Comma
  | Semi
  | Colon
  | Coloncolon
  | Dot
  | Dotdot
  | Dotdoteq
  | Underscore
  | Arrow
  | Eq
  | Eqeq
  | Bang
  | Bangeq
  | Lt
  | Le
  | Gt
  | Ge
  | Shl
  | Shr
  | Plus
  | Plusplus
  | Pluspercent
  | Pluspipe
  | Minus
  | Minuspercent
  | Minuspipe
  | Star
  | Starpercent
  | Starpipe
  | Slash
  | Percent
  | Amp
  | Ampamp
  | Caret
  | Pipe
  | Pipepipe
  | Tilde
  | Hashbrace
  | Hashbracket
  | Question
  | Hole

fn puncts() -> List<{ of: Punct, text: Bytes }> =
  [
    { of: Lparen, text: b"(" },
    { of: Rparen, text: b")" },
    { of: Lbrace, text: b"{" },
    { of: Rbrace, text: b"}" },
    { of: Lbracket, text: b"[" },
    { of: Rbracket, text: b"]" },
    { of: Comma, text: b"," },
    { of: Semi, text: b";" },
    { of: Colon, text: b":" },
    { of: Coloncolon, text: b"::" },
    { of: Dot, text: b"." },
    { of: Dotdot, text: b".." },
    { of: Dotdoteq, text: b"..=" },
    { of: Underscore, text: b"_" },
    { of: Arrow, text: b"->" },
    { of: Eq, text: b"=" },
    { of: Eqeq, text: b"==" },
    { of: Bang, text: b"!" },
    { of: Bangeq, text: b"!=" },
    { of: Lt, text: b"<" },
    { of: Le, text: b"<=" },
    { of: Gt, text: b">" },
    { of: Ge, text: b">=" },
    { of: Shl, text: b"<<" },
    { of: Shr, text: b">>" },
    { of: Plus, text: b"+" },
    { of: Plusplus, text: b"++" },
    { of: Pluspercent, text: b"+%" },
    { of: Pluspipe, text: b"+|" },
    { of: Minus, text: b"-" },
    { of: Minuspercent, text: b"-%" },
    { of: Minuspipe, text: b"-|" },
    { of: Star, text: b"*" },
    { of: Starpercent, text: b"*%" },
    { of: Starpipe, text: b"*|" },
    { of: Slash, text: b"/" },
    { of: Percent, text: b"%" },
    { of: Amp, text: b"&" },
    { of: Ampamp, text: b"&&" },
    { of: Caret, text: b"^" },
    { of: Pipe, text: b"|" },
    { of: Pipepipe, text: b"||" },
    { of: Tilde, text: b"~" },
    { of: Hashbrace, text: b"#{" },
    { of: Hashbracket, text: b"#[" },
    { of: Question, text: b"?" },
    { of: Hole, text: b"???" },
  ]

pub fn punct_text(punct: Punct) -> Bytes =
  puncts().fold(b"", |found: Bytes, row: { of: Punct, text: Bytes }|
    if row.of == punct { row.text } else { found })

pub type Keyword =
  | Fn
  | If
  | Pub
  | Let
  | Type
  | Test
  | Else
  | With
  | True
  | Match
  | False
  | Import
  | Effect
  | Nondet
  | Handle

pub fn keyword_name(keyword: Keyword) -> Bytes =
  match keyword {
    Fn -> b"fn",
    If -> b"if",
    Pub -> b"pub",
    Let -> b"let",
    Type -> b"type",
    Test -> b"test",
    Else -> b"else",
    With -> b"with",
    True -> b"true",
    Match -> b"match",
    False -> b"false",
    Import -> b"import",
    Effect -> b"effect",
    Nondet -> b"nondet",
    Handle -> b"handle",
  }

/// A word is an identifier until it spells a keyword, so this runs once per identifier: it reads
/// `text` by its length and builds nothing.
pub fn keyword_of(text: Bytes) -> Option<Keyword> = {
  let len = text.len();
  if len == 2 { if text == b"fn" { Some(Fn) } else if text == b"if" { Some(If) } else { None } }
  else if len == 3 {
    if text == b"pub" { Some(Pub) } else if text == b"let" { Some(Let) } else { None }
  } else if len == 4 {
    if text == b"type" { Some(Type) }
    else if text == b"test" { Some(Test) }
    else if text == b"else" { Some(Else) }
    else if text == b"with" { Some(With) }
    else if text == b"true" { Some(True) }
    else { None }
  } else if len == 5 {
    if text == b"match" { Some(Match) } else if text == b"false" { Some(False) } else { None }
  } else if len == 6 {
    if text == b"import" { Some(Import) }
    else if text == b"effect" { Some(Effect) }
    else if text == b"nondet" { Some(Nondet) }
    else if text == b"handle" { Some(Handle) }
    else { None }
  } else { None }
}

/// A literal carries the value its spelling names, checked against its type. `Float` is left to the
/// float parser: `FloatLiteral` carries the text.
pub type TokenKind =
  | Identifier(Bytes)
  | IntLiteral(Int)
  /// The width's name and the value normalized to that width.
  | FixedLiteral(Bytes, Int)
  /// A 128-bit literal: the width's name, then its high and low 64 bits as `Int` patterns.
  | WideLiteral(Bytes, Int, Int)
  /// The text, normalized: `1E9` is `1e9`.
  | FloatLiteral(Bytes)
  /// The mantissa's digits, and the scale that keeps `1.50m` written with two places.
  | DecimalLiteral(Bytes, Int)
  | StringLiteral(Bytes)
  /// A line string's lines, joined: a value like a `StringLiteral`'s, which only an expression may be.
  | LineString(Bytes)
  | BytesLiteral(Bytes)
  /// An interpolated string's text: up to its first hole, between two holes, and after its last.
  | InterpolatedHead(Bytes)
  | InterpolatedMiddle(Bytes)
  | InterpolatedTail(Bytes)
  | CharLiteral(Int)
  | Keyword(Keyword)
  | Punctuation(Punct)
  | EndOfInput

pub type Token = { start: Int, end: Int, kind: TokenKind }

pub type Diag = { start: Int, end: Int, code: Bytes, message: Bytes, label: Bytes }

pub type Comment = { start: Int, end: Int }

pub type DocMark = | ItemDoc | ModuleDoc

pub type Lexed = { tokens: List<Token>, diags: List<Diag>, comments: List<Comment> }

/// `tokens` must stay the last field in every literal: anywhere earlier, `List::push` copies the list,
/// which is quadratic. `holes` is, per string open around the scan, the braces open inside its hole.
type Scanner = { pos: Int, diags: List<Diag>, holes: List<Int>, tokens: List<Token> }

fn push_token(scanner: Scanner, start: Int, end: Int, kind: TokenKind) -> Scanner =
  {
    pos: end,
    diags: scanner.diags,
    holes: scanner.holes,
    tokens: scanner.tokens.push({ start: start, end: end, kind: kind }),
  }

fn push_error(
  scanner: Scanner,
  start: Int,
  end: Int,
  code: Bytes,
  message: Bytes,
  label: Bytes,
) -> Scanner =
  {
    pos: scanner.pos,
    holes: scanner.holes,
    tokens: scanner.tokens,
    diags: scanner.diags.push({
      start: start,
      end: end,
      code: code,
      message: message,
      label: label,
    }),
  }

fn with_holes(scanner: Scanner, holes: List<Int>) -> Scanner =
  { pos: scanner.pos, diags: scanner.diags, holes: holes, tokens: scanner.tokens }

fn bad_suffix(scanner: Scanner, start: Int, end: Int, suffix: Bytes) -> Scanner =
  push_error(
    scanner,
    start,
    end,
    unexpected(),
    Bytes::concat_all([b"invalid suffix `", suffix, b"` on a numeric literal"]),
    b"the suffixes are `m` for a `Decimal` and a width \xe2\x80\x94 `u8`, `i32` and the six others; separate a name with a space",
  )

fn seek(scanner: Scanner, at: Int) -> Scanner =
  { pos: at, diags: scanner.diags, holes: scanner.holes, tokens: scanner.tokens }

fn unexpected() -> Bytes = b"E0001"

fn out_of_range() -> Bytes = b"E0211"

fn unterminated() -> Bytes = b"E0002"

fn non_ascii() -> Bytes = b"X0001"

// --- Character classes ------------------------------------------------------

fn whitespace() -> Bytes = b" \t\n\r\x0b\x0c"

fn ident_chars() -> Bytes = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

fn digit_chars() -> Bytes = b"0123456789_"

pub fn is_ident_start(byte: Int) -> Bool =
  (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || byte == 95

pub fn is_ident_continue(byte: Int) -> Bool = is_ident_start(byte) || is_digit(byte)

/// The UTF-8 length at a lead byte, so one refused character is one diagnostic spanning all of it.
pub fn utf8_len(byte: Int) -> Int =
  if byte < 128 { 1 } else if byte < 224 { 2 } else if byte < 240 { 3 } else { 4 }

// --- Trivia -----------------------------------------------------------------

/// Whitespace, a leading byte-order mark, a leading `#!` line, and comments.
fn skip_trivia(src: Bytes, from: Int) -> Int / {abort.raise} =
  iterate(from, src.len() - from + 2, |at: Int| {
    let j = skip_blanks(src, at);
    match comment_end(src, j) { Some(end) -> Continue(end), None -> Stop(j) }
  })

// --- The names a token stream binds -----------------------------------------

/// Each name a binding of which can stand where `tokens` write it: not after a dot or a `::`, and not
/// before a dot. A call on a name written nowhere so is a perform, not a call on a value.
pub fn bound_names(tokens: List<Token>) -> Map<Bytes, Bool> = {
  let punct = |i: Int, punct: Punct|
    i >= 0
      && (match tokens.at(i) { Some(token) -> token.kind == Punctuation(punct), None -> false });
  range(0, tokens.len()).fold(Map::new(), |acc: Map<Bytes, Bool>, i: Int|
    match tokens.at(i) {
      Some(token) -> match token.kind {
        Identifier(name) -> if punct(i - 1, Dot) || punct(i - 1, Coloncolon) || punct(i + 1, Dot) {
          acc
        } else { acc.insert(name, true) },
        _ -> acc,
      },
      None -> acc,
    })
}

// --- The loop ---------------------------------------------------------------

/// The tokens, comments and diagnostics of a source: tokens in order and apart, each keyword's or
/// punctuation's text the bytes it spans, and `EndOfInput` last. A source that is not UTF-8 is read up
/// to the first byte that is no part of a character, which is refused as `X0001`.
pub fn lex(src: Bytes) -> Lexed / {abort.raise} =
  if src.is_utf8() { lex_text(src) } else {
    let cut = utf8_prefix(src);
    let read = lex_text(src.slice(0, cut));
    {
      tokens: read.tokens,
      diags: read.diags.push({
        start: cut,
        end: cut + 1,
        code: non_ascii(),
        message: b"the source is not UTF-8 from this byte on",
        label: b"nothing from here on is read",
      }),
      comments: read.comments,
    }
  }

fn utf8_prefix(src: Bytes) -> Int / {abort.raise} = {
  let len = src.len();
  iterate(0, len + 1, |i: Int|
    if i >= len { Stop(i) } else {
      let width = utf8_len(src.at(i));
      if i + width <= len && src.slice(i, i + width).is_utf8() { Continue(i + width) }
      else { Stop(i) }
    })
}

fn lex_text(src: Bytes) -> Lexed / {abort.raise} = {
  let len = src.len();
  let start = { pos: 0, diags: [], holes: [], tokens: [] };
  // Every step that has work left consumes at least one byte, so `len + 1` steps suffice; the scan
  // stops at the end rather than stepping once a byte.
  let done = iterate(start, len + 1, |scanner: Scanner|
    if scanner.pos >= len { Stop(scanner) } else { Continue(next_token(src, scanner)) });
  let closed = if done.holes.len() == 0 { done } else {
    push_error(
      done,
      len,
      len,
      unterminated(),
      b"an interpolated string's `{` is never closed",
      b"close the hole with `}` and the string with `\"`",
    )
  };
  let with_eof = push_token(closed, len, len, EndOfInput);
  { diags: with_eof.diags, tokens: with_eof.tokens, comments: comments(src, with_eof.tokens) }
}

/// Only trivia lies between two tokens, so the comments are read off the gaps.
fn comments(src: Bytes, toks: List<Token>) -> List<Comment> / {abort.raise} = {
  let walked = toks.fold(
    { from: 0, out: [] },
    |state: { from: Int, out: List<Comment> }, token: Token|
      { from: token.end, out: gap_comments(src, state.from, token.start, state.out) },
  );
  walked.out
}

fn gap_comments(
  src: Bytes,
  from: Int,
  stop: Int,
  out: List<Comment>,
) -> List<Comment> / {abort.raise} =
  iterate({ at: from, out: out }, src.len() - from + 2, |state: { at: Int, out: List<Comment> }| {
    let at = skip_blanks(src, state.at);
    match if at < stop { comment_end(src, at) } else { None } {
      Some(end) -> Continue({ at: end, out: state.out.push({ start: at, end: end }) }),
      None -> Stop(state.out),
    }
  })

/// `//` to the end of its line; `#!` so only where the code starts, a script's first line.
fn comment_end(src: Bytes, at: Int) -> Option<Int> / {abort.raise} =
  if src.peek(at) == 47 && src.peek(at + 1) == 47 { Some(src.skip_until(at, b"\n")) }
  else if at == bom_len(src) && src.starts_at(at, shebang()) { Some(src.skip_until(at, b"\n")) }
  else { None }

fn skip_blanks(src: Bytes, from: Int) -> Int / {abort.raise} =
  src.skip(if from == 0 { bom_len(src) } else { from }, whitespace())

/// The byte-order mark an editor writes ahead of the text it saves is no part of it.
fn bom_len(src: Bytes) -> Int / {abort.raise} =
  if src.starts_at(0, b"\xef\xbb\xbf") { 3 } else { 0 }

fn shebang() -> Bytes = b"#!"

/// `///` documents the declaration below it and `//!` the module it opens; anything else is a plain
/// comment.
pub fn doc_mark(src: Bytes, comment: Comment) -> Option<DocMark> =
  if src.peek(comment.start) != 47 || src.peek(comment.start + 1) != 47 { None } else {
    let third = src.peek(comment.start + 2);
    if third == 47 && src.peek(comment.start + 3) != 47 { Some(ItemDoc) }
    else if third == 33 { Some(ModuleDoc) }
    else { None }
  }

/// Past the marker and one space, without the blanks that end the line.
pub fn doc_line(src: Bytes, comment: Comment) -> Bytes / {abort.raise} = {
  let from = if src.peek(comment.start + 3) == 32 { comment.start + 4 } else { comment.start + 3 };
  let to = iterate(comment.end, comment.end - from + 1, |i: Int|
    if i > from && (src.at(i - 1) == 32 || src.at(i - 1) == 9 || src.at(i - 1) == 13) {
      Continue(i - 1)
    } else { Stop(i) });
  src.slice(from, to)
}

/// `-1` at the end of the input: an `Int`, so a token costs no record.
fn next_start(src: Bytes, scanner: Scanner) -> Int / {abort.raise} = {
  let len = src.len();
  if scanner.pos >= len { -1 } else {
    let at = skip_trivia(src, scanner.pos);
    if at >= len { -1 } else { at }
  }
}

fn next_token(src: Bytes, scanner: Scanner) -> Scanner / {abort.raise} = {
  let at = next_start(src, scanner);
  if at < 0 { seek(scanner, src.len()) } else { token_at(src, scanner, at) }
}

/// [`next_token`] with every `"` read as a string: a probe by `next_token` would ask the question it
/// is answering.
fn next_atom(src: Bytes, scanner: Scanner) -> Scanner / {abort.raise} = {
  let at = next_start(src, scanner);
  if at < 0 { seek(scanner, src.len()) } else { atom_at(src, scanner, at) }
}

fn token_at(src: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} =
  if src.at(start) == 34 && at_test_label(scanner.tokens) { label(src, scanner, start) }
  else { atom_at(src, scanner, start) }

fn atom_at(src: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let c = src.at(start);
  if is_digit(c) { number(src, scanner, start) }
  else if c == 98 && src.peek(start + 1) == 34 { bytes_lit(src, scanner, start) }
  else if c == 98 && src.peek(start + 1) == 39 { byte_lit(src, scanner, start) }
  else if c == 102 && src.peek(start + 1) == 34 {
    interpolated_piece(src, scanner, start, start + 2, true)
  } else if is_ident_start(c) { ident(src, scanner, start) }
  else if c == 34 && touches_name(scanner.tokens, start) {
    interpolated_piece(src, scanner, start, start + 1, true)
  } else if c == 34 { string_lit(src, scanner, start) }
  else if c == 92 && src.peek(start + 1) == 92 { line_string(src, scanner, start) }
  else if c == 39 { char_lit(src, scanner, start) } else if c >= 128 {
    // With no Unicode table, any non-ASCII character outside a literal is refused as `X0001`.
    push_error(
      seek(scanner, start + utf8_len(c)),
      start,
      start + utf8_len(c),
      non_ascii(),
      Bytes::concat_all([b"unexpected character `", src.slice(start, start + utf8_len(c)), b"`"]),
      b"this character has no meaning in Ply source",
    )
  } else { punct(src, scanner, start, c) }
}

// --- Identifiers and keywords -----------------------------------------------

fn ident(src: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let end = src.skip(start, ident_chars());
  let text = src.slice(start, end);
  if text == b"_" { push_token(scanner, start, end, Punctuation(Underscore)) } else {
    match keyword_of(text) {
      Some(k) -> push_token(scanner, start, end, Keyword(k)),
      None -> push_token(scanner, start, end, Identifier(text)),
    }
  }
}

// --- Numbers ----------------------------------------------------------------

type NumberParts = {
  start: Int,
  whole: Bytes,
  fraction: Bytes,
  has_fraction: Bool,
  exp: Bytes,
  has_exponent: Bool,
  cursor: Int,
}

fn strip_underscores(b: Bytes) -> Bytes = Bytes::concat_all(b.split(b"_"))

/// Whether each `_` stands between two digits: `1_000`, and not `1_`, `1__0` or `0x_FF`.
fn separators_ok(digits: Bytes, hexadecimal: Bool) -> Bool = {
  let digit = |c: Int| if hexadecimal { hex_value(c) >= 0 } else { is_digit(c) };
  range(0, digits.len()).fold(true, |ok: Bool, i: Int|
    ok
      && (digits.at(i) != 95
      || (i > 0 && i + 1 < digits.len() && digit(digits.at(i - 1)) && digit(digits.at(i + 1)))))
}

fn misplaced_separator(scanner: Scanner, start: Int, end: Int) -> Scanner =
  push_error(
    scanner,
    start,
    end,
    unexpected(),
    b"a `_` in a number separates two digits",
    b"write `1_000`, with a digit on each side of the `_`",
  )

fn number(src: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} =
  if src.peek(start) == 48 && (src.peek(start + 1) == 120 || src.peek(start + 1) == 88) {
    hex_literal(src, scanner, start)
  } else { decimal_number(src, scanner, start) }

fn hex_literal(src: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let end = src.skip(start + 2, b"0123456789abcdefABCDEF_");
  let raw = src.slice(start + 2, end);
  let digits = strip_underscores(raw);
  let s0 = if separators_ok(raw, true) { scanner }
  else { misplaced_separator(scanner, start, end) };
  if digits.len() == 0 {
    push_token(
      push_error(
        s0,
        start,
        end,
        unexpected(),
        b"hex literal with no digits",
        b"write at least one digit after `0x`, as in `0xFF`",
      ),
      start,
      end,
      IntLiteral(0),
    )
  } else {
    let sufe = if is_ident_start(src.peek(end)) { src.skip(end, ident_chars()) } else { end };
    let suffix = src.slice(end, sufe);
    match width_named(suffix) {
      // A hex literal is a bit pattern, so the width bounds it rather than the type's range.
      Some(width) -> hex_fixed(s0, start, sufe, digits, width),
      None -> {
        let s1 = if sufe > end { bad_suffix(s0, start, sufe, suffix) } else { s0 };
        let digits = strip_zeros(digits);
        if digits.len() > 16 {
          push_token(
            push_error(
              s1,
              start,
              end,
              unexpected(),
              Bytes::concat_all([b"hex literal `0x", digits, b"` does not fit in `Int`"]),
              b"`Int` is 64 bits, so a hex literal has at most 16 digits",
            ),
            start,
            end,
            IntLiteral(0),
          )
        } else { push_token(s1, start, end, IntLiteral(hex_of_digits(digits))) }
      },
    }
  }
}

fn hex_fixed(
  scanner: Scanner,
  start: Int,
  end: Int,
  digits: Bytes,
  width: Width,
) -> Scanner / {abort.raise} =
  if width.bits == 128 { hex_wide(scanner, start, end, digits, width) }
  else { hex_narrow(scanner, start, end, digits, width) }

fn hex_narrow(
  scanner: Scanner,
  start: Int,
  end: Int,
  digits: Bytes,
  width: Width,
) -> Scanner / {abort.raise} = {
  let digits = strip_zeros(digits);
  if digits.len() > 16
      || (width.bits < 64 && digits.len() * 4 > width.bits && hex_over(digits, width)) {
    push_token(
      push_error(
        scanner,
        start,
        end,
        out_of_range(),
        Bytes::concat_all([b"`0x", digits, b"` does not fit in `", width_upper(width), b"`"]),
        Bytes::concat_all([
          b"a `",
          width_upper(width),
          b"` is ",
          ascii_of_int(width.bits),
          b" bits",
        ]),
      ),
      start,
      end,
      FixedLiteral(width_upper(width), 0),
    )
  } else {
    push_token(
      scanner,
      start,
      end,
      FixedLiteral(width_upper(width), width_normalize(width, hex_of_digits(digits))),
    )
  }
}

/// Thirty-two digits at most, the high sixteen and the low sixteen each one `Int` pattern.
fn hex_wide(
  scanner: Scanner,
  start: Int,
  end: Int,
  digits: Bytes,
  width: Width,
) -> Scanner / {abort.raise} = {
  let digits = strip_zeros(digits);
  let len = digits.len();
  if len > 32 {
    push_token(
      push_error(
        scanner,
        start,
        end,
        out_of_range(),
        Bytes::concat_all([b"`0x", digits, b"` does not fit in `", width_upper(width), b"`"]),
        Bytes::concat_all([b"a `", width_upper(width), b"` is 128 bits"]),
      ),
      start,
      end,
      WideLiteral(width_upper(width), 0, 0),
    )
  } else {
    let split = if len > 16 { len - 16 } else { 0 };
    push_token(
      scanner,
      start,
      end,
      WideLiteral(
        width_upper(width),
        hex_of_digits(digits.slice(0, split)),
        hex_of_digits(digits.slice(split, len)),
      ),
    )
  }
}

/// An `L`-digit hex literal needs more than `bits` bits exactly when its smallest value does.
fn hex_over(digits: Bytes, width: Width) -> Bool = (digits.len() - 1) * 4 >= width.bits

fn hex_of_digits(digits: Bytes) -> Int =
  range(0, digits.len()).fold(0, |a: Int, i: Int|
    wrap_add(wrap_mul(a, 16), hex_value(digits.at(i))))

fn decimal_number(src: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let we = src.skip(start, digit_chars());
  // `..` is the range separator, so a fraction is a dot followed by a digit.
  let hasf = src.peek(we) == 46 && is_digit(src.peek(we + 1));
  let fe = if hasf { src.skip(we + 1, digit_chars()) } else { we };
  let es = exponent_start(src, fe);
  let ee = if es < 0 { fe } else { src.skip(es, digit_chars()) };
  let seps = [{ from: start, to: we }, { from: we + 1, to: fe }, { from: es, to: ee }].fold(
    scanner,
    |s: Scanner, r: { from: Int, to: Int }|
      if r.from >= 0 && r.to > r.from && !separators_ok(src.slice(r.from, r.to), false) {
        misplaced_separator(s, r.from, r.to)
      } else { s },
  );
  number_tail(src, seps, {
    start: start,
    whole: strip_underscores(src.slice(start, we)),
    fraction: if hasf { strip_underscores(src.slice(we + 1, fe)) } else { b"" },
    has_fraction: hasf,
    exp: if es < 0 { b"" } else { exponent_text(src, fe, es, ee) },
    has_exponent: es >= 0,
    cursor: ee,
  })
}

/// -1 where no digits follow, so the `e` is left to whatever reads next.
fn exponent_start(src: Bytes, at: Int) -> Int = {
  let c = src.peek(at);
  if c != 101 && c != 69 { -1 } else {
    let digits = src.peek(at + 1);
    let digits = if digits == 43 || digits == 45 { at + 2 } else { at + 1 };
    if is_digit(src.peek(digits)) { digits } else { -1 }
  }
}

fn exponent_text(src: Bytes, marker: Int, from: Int, to: Int) -> Bytes / {abort.raise} =
  src.slice(marker + 1, from).concat(strip_underscores(src.slice(from, to)))

fn number_tail(src: Bytes, scanner: Scanner, parts: NumberParts) -> Scanner / {abort.raise} =
  if src.peek(parts.cursor) == 109 && !is_ident_continue(src.peek(parts.cursor + 1)) {
    decimal(scanner, parts, parts.cursor + 1)
  } else if is_ident_start(src.peek(parts.cursor)) {
    let end = src.skip(parts.cursor, ident_chars());
    // A width suffix applies only to an integer; `1.5u8` is refused as a bad suffix.
    match if parts.has_fraction || parts.has_exponent { None }
      else { width_named(src.slice(parts.cursor, end)) } {
      Some(width) -> fixed_value(scanner, parts, end, width),
      None ->
        number_value(
          bad_suffix(scanner, parts.start, end, src.slice(parts.cursor, end)),
          parts,
          end,
        ),
    }
  } else { number_value(scanner, parts, parts.cursor) }

/// A decimal spelling is a value, so its bound is the type's range.
fn fixed_value(
  scanner: Scanner,
  parts: NumberParts,
  end: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  if width.bits == 128 { wide_value(scanner, parts, end, width) }
  else { narrow_value(scanner, parts, end, width) }

fn narrow_value(
  scanner: Scanner,
  parts: NumberParts,
  end: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  if width.bits == 64 && !width.signed { u64_value(scanner, parts, end, width) } else {
    match width_value(strip_zeros(parts.whole), width) {
      Some(v) -> push_token(scanner, parts.start, end, FixedLiteral(width_upper(width), v)),
      None -> narrow_out_of_range(scanner, parts, end, width),
    }
  }

/// Past `Int`'s range a `U64` is the pattern its 64 bits make, as a hex spelling of it is.
fn u64_value(
  scanner: Scanner,
  parts: NumberParts,
  end: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  match limbs_of_digits(strip_zeros(parts.whole)) {
    Some(limbs) -> if limbs.at_or(3, 0) != 0 || limbs.at_or(2, 0) != 0 {
      narrow_out_of_range(scanner, parts, end, width)
    } else {
      push_token(
        scanner,
        parts.start,
        end,
        FixedLiteral(width_upper(width), limbs.at_or(1, 0) << 32 | limbs.at_or(0, 0)),
      )
    },
    None -> narrow_out_of_range(scanner, parts, end, width),
  }

fn narrow_out_of_range(
  scanner: Scanner,
  parts: NumberParts,
  end: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  push_token(
    push_error(
      scanner,
      parts.start,
      end,
      out_of_range(),
      Bytes::concat_all([b"`", parts.whole, b"` is not a value of `", width_upper(width), b"`"]),
      Bytes::concat_all([b"`", width_upper(width), b"` holds ", width_range(width)]),
    ),
    parts.start,
    end,
    FixedLiteral(width_upper(width), 0),
  )

/// Read into four 32-bit limbs, so no `Int` overflows on the way; a signed width keeps its top bit clear.
fn wide_value(
  scanner: Scanner,
  parts: NumberParts,
  end: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  match limbs_of_digits(strip_zeros(parts.whole)) {
    Some(limbs) -> if width.signed && limbs.at_or(3, 0) >= pow(2, 31) {
      wide_out_of_range(scanner, parts, end, width)
    } else {
      push_token(
        scanner,
        parts.start,
        end,
        WideLiteral(
          width_upper(width),
          limbs.at_or(3, 0) << 32 | limbs.at_or(2, 0),
          limbs.at_or(1, 0) << 32 | limbs.at_or(0, 0),
        ),
      )
    },
    None -> wide_out_of_range(scanner, parts, end, width),
  }

fn wide_out_of_range(
  scanner: Scanner,
  parts: NumberParts,
  end: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  push_token(
    push_error(
      scanner,
      parts.start,
      end,
      out_of_range(),
      Bytes::concat_all([b"`", parts.whole, b"` is not a value of `", width_upper(width), b"`"]),
      Bytes::concat_all([b"`", width_upper(width), b"` holds ", width_range(width)]),
    ),
    parts.start,
    end,
    WideLiteral(width_upper(width), 0, 0),
  )

/// Least significant first; `None` once the value passes 128 bits.
fn limbs_of_digits(digits: Bytes) -> Option<List<Int>> =
  range(0, digits.len()).fold(Some([0, 0, 0, 0]), |acc: Option<List<Int>>, i: Int|
    match acc { None -> None, Some(limbs) -> times_ten_plus(limbs, digits.at(i) - 48) })

fn times_ten_plus(limbs: List<Int>, digit: Int) -> Option<List<Int>> = {
  let step = limbs.fold(
    { carry: digit, out: [] },
    |acc: { carry: Int, out: List<Int> }, limb: Int| {
      let v = limb * 10 + acc.carry;
      { carry: v >>> 32, out: acc.out.push(v & 0xFFFF_FFFF) }
    },
  );
  if step.carry == 0 { Some(step.out) } else { None }
}

/// The decimal spelling of a 128-bit value given as its high and low 64-bit patterns.
pub fn wide_decimal(signed: Bool, high: Int, low: Int) -> Bytes =
  if signed && high < 0 {
    b"-".concat(
      limbs_decimal(high_first(if low == 0 { wrap_sub(0, high) } else { ~high }, wrap_sub(0, low))),
    )
  } else { limbs_decimal(high_first(high, low)) }

fn high_first(high: Int, low: Int) -> List<Int> =
  [high >>> 32, high & 0xFFFF_FFFF, low >>> 32, low & 0xFFFF_FFFF]

/// A digit a round while the quotient is not zero: 128 bits make at most 39.
fn limbs_decimal(limbs: List<Int>) -> Bytes = {
  let done = range(0, 39).fold(
    { limbs: limbs, digits: b"", zero: false },
    |s: { limbs: List<Int>, digits: Bytes, zero: Bool }, i: Int|
      if s.zero { s } else {
        let step = s.limbs.fold(
          { rem: 0, out: [] },
          |a: { rem: Int, out: List<Int> }, limb: Int| {
            let cur = a.rem << 32 | limb;
            { rem: cur % 10, out: a.out.push(cur / 10) }
          },
        );
        {
          limbs: step.out,
          digits: ascii_of_int(step.rem).concat(s.digits),
          zero: step.out.fold(true, |z: Bool, limb: Int| z && limb == 0),
        }
      },
  );
  done.digits
}

fn width_value(digits: Bytes, width: Width) -> Option<Int> =
  match int_of_digits_in(digits) {
    None -> None,
    // A 64-bit width holds what `Int` does, which the digits met already.
    Some(v) -> if width.bits >= 64 { Some(width_normalize(width, v)) } else {
      let bound = if width.signed { pow(2, width.bits - 1) - 1 } else { pow(2, width.bits) - 1 };
      if v > bound { None } else { Some(width_normalize(width, v)) }
    },
  }

fn width_range(width: Width) -> Bytes =
  if width.bits == 128 {
    if width.signed {
      b"-170141183460469231731687303715884105728 to 170141183460469231731687303715884105727"
    } else { b"0 to 340282366920938463463374607431768211455" }
  } else if width.bits == 64 {
    if width.signed { b"-9223372036854775808 to 9223372036854775807" }
    else { b"0 to 18446744073709551615" }
  } else if width.signed {
    Bytes::concat_all([
      b"-",
      ascii_of_int(pow(2, width.bits - 1)),
      b" to ",
      ascii_of_int(pow(2, width.bits - 1) - 1),
    ])
  } else { Bytes::concat_all([b"0 to ", ascii_of_int(pow(2, width.bits) - 1)]) }

fn number_value(scanner: Scanner, parts: NumberParts, end: Int) -> Scanner / {abort.raise} =
  if !parts.has_fraction && !parts.has_exponent { int_value(scanner, parts, end) }
  else { push_token(scanner, parts.start, end, FloatLiteral(float_text(parts))) }

fn float_text(parts: NumberParts) -> Bytes =
  Bytes::concat_all([
    parts.whole,
    if parts.has_fraction { b"." } else { b"" },
    if parts.has_fraction { parts.fraction } else { b"" },
    if parts.has_exponent { b"e" } else { b"" },
    if parts.has_exponent { parts.exp } else { b"" },
  ])

// --- Integers ---------------------------------------------------------------

/// `Int` arithmetic is checked, so a literal's bound is decided on its digits before accumulating.
fn int_max() -> Bytes = b"9223372036854775807"

fn strip_zeros(b: Bytes) -> Bytes / {abort.raise} = {
  let k = b.skip(0, b"0");
  if k >= b.len() { b"0" } else { b.slice(k, b.len()) }
}

fn int_value(scanner: Scanner, parts: NumberParts, end: Int) -> Scanner / {abort.raise} =
  match int_of_digits_in(strip_zeros(parts.whole)) {
    Some(v) -> push_token(scanner, parts.start, end, IntLiteral(v)),
    None ->
      push_token(
        push_error(
          scanner,
          parts.start,
          end,
          unexpected(),
          Bytes::concat_all([b"integer literal `", parts.whole, b"` does not fit in `Int`"]),
          b"`Int` is a 64-bit signed integer; use a smaller value",
        ),
        parts.start,
        end,
        IntLiteral(0),
      ),
  }

/// Decided on the digits, so the fold inside never overflows on the way.
fn int_of_digits_in(digits: Bytes) -> Option<Int> =
  if digits.len() > 19 || (digits.len() == 19 && compare(digits, int_max()) == Greater) { None }
  else { Some(int_of_digits(digits)) }

pub fn int_of_digits(digits: Bytes) -> Int =
  range(0, digits.len()).fold(0, |a: Int, i: Int| a * 10 + (digits.at(i) - 48))

// --- Widths -----------------------------------------------------------------

pub type Width = { name: Bytes, bits: Int, signed: Bool }

pub fn widths() -> List<Width> =
  [
    { name: b"u8", bits: 8, signed: false },
    { name: b"u16", bits: 16, signed: false },
    { name: b"u32", bits: 32, signed: false },
    { name: b"u64", bits: 64, signed: false },
    { name: b"i8", bits: 8, signed: true },
    { name: b"i16", bits: 16, signed: true },
    { name: b"i32", bits: 32, signed: true },
    { name: b"i64", bits: 64, signed: true },
    // Last, so every narrower width keeps the number a hash and the runtime know it by.
    { name: b"u128", bits: 128, signed: false },
    { name: b"i128", bits: 128, signed: true },
  ]

pub fn width_named(suffix: Bytes) -> Option<Width> =
  widths().fold(None, |found: Option<Width>, width: Width|
    match found { Some(_) -> found, None -> if width.name == suffix { Some(width) } else { None } })

fn width_upper(width: Width) -> Bytes / {abort.raise} =
  Bytes::of_string(String::of_bytes(width.name).ascii_upper())

/// The low `bits` kept, sign-extended when the width is signed.
pub fn width_normalize(width: Width, value: Int) -> Int =
  if width.bits >= 64 { value } else {
    let low = value & pow(2, width.bits) - 1;
    if width.signed && low >>> width.bits - 1 == 1 { low | 0 - pow(2, width.bits) } else { low }
  }

// --- Decimals ---------------------------------------------------------------

/// A `Decimal` mantissa is 96 bits and its scale 0..=28; neither fits an `Int` check, so both use the digits.
fn decimal_max() -> Bytes = b"79228162514264337593543950335"

fn zero_decimal() -> TokenKind = DecimalLiteral(b"0", 0)

fn decimal(scanner: Scanner, parts: NumberParts, end: Int) -> Scanner / {abort.raise} =
  if parts.has_exponent {
    push_token(
      push_error(
        scanner,
        parts.start,
        end,
        unexpected(),
        b"a `Decimal` literal has no exponent",
        b"write the digits out, or drop the `m` for a `Float`",
      ),
      parts.start,
      end,
      zero_decimal(),
    )
  } else if parts.fraction.len() > 28 {
    push_token(
      push_error(
        scanner,
        parts.start,
        end,
        unexpected(),
        Bytes::concat_all([
          b"a `Decimal` literal has at most 28 decimal places, not ",
          ascii_of_int(parts.fraction.len()),
        ]),
        b"round the literal, or use `Float`",
      ),
      parts.start,
      end,
      zero_decimal(),
    )
  } else {
    let digits = strip_zeros(parts.whole.concat(parts.fraction));
    let k = digits.len();
    if k > 29 || (k == 29 && compare(digits, decimal_max()) == Greater) {
      push_token(
        push_error(
          scanner,
          parts.start,
          end,
          unexpected(),
          b"a `Decimal` literal has at most 96 bits of mantissa",
          b"the largest is 79228162514264337593543950335",
        ),
        parts.start,
        end,
        zero_decimal(),
      )
    } else { push_token(scanner, parts.start, end, DecimalLiteral(digits, parts.fraction.len())) }
  }

// --- String literals --------------------------------------------------------

type TextRead = { scanner: Scanner, from: Int, runs: List<Bytes> }

fn string_stops() -> Bytes = b"\"\\\n"

fn string_lit(src: Bytes, scanner: Scanner, open: Int) -> Scanner / {abort.raise} =
  iterate({ scanner: scanner, from: open + 1, runs: [] }, src.len() - open + 2, |read: TextRead|
    string_run(src, open, read))

fn string_run(src: Bytes, open: Int, read: TextRead) -> Iter<TextRead, Scanner> / {abort.raise} = {
  let stop = src.skip_until(read.from, string_stops());
  let runs = read.runs.push(src.slice(read.from, stop));
  let c = src.peek(stop);
  if c < 0 || c == 10 {
    Stop(
      push_token(
        push_error(
          read.scanner,
          open,
          stop,
          unterminated(),
          b"unterminated string literal",
          b"add a closing `\"`; a string may not span a line break",
        ),
        open,
        stop,
        StringLiteral(Bytes::concat_all(runs)),
      ),
    )
  } else if c == 34 {
    Stop(push_token(read.scanner, open, stop + 1, StringLiteral(Bytes::concat_all(runs))))
  } else { string_escape(src, read.scanner, open, stop, runs) }
}

fn unknown_escape(
  src: Bytes,
  scanner: Scanner,
  stop: Int,
  width: Int,
  valid: Bytes,
) -> Scanner / {abort.raise} =
  push_error(
    scanner,
    stop,
    stop + 1 + width,
    unexpected(),
    Bytes::concat_all([
      b"unknown escape sequence `\\",
      src.slice(stop + 1, stop + 1 + width),
      b"`",
    ]),
    valid,
  )

fn string_escape(
  src: Bytes,
  scanner: Scanner,
  open: Int,
  stop: Int,
  runs: List<Bytes>,
) -> Iter<TextRead, Scanner> / {abort.raise} = {
  let len = src.len();
  if src.peek(stop + 1) < 0 {
    Stop(
      push_token(
        push_error(
          scanner,
          open,
          len,
          unterminated(),
          b"unterminated string literal",
          b"add a closing `\"`",
        ),
        open,
        len,
        StringLiteral(Bytes::concat_all(runs)),
      ),
    )
  } else {
    let escape = text_escape(src, scanner, stop);
    Continue({ scanner: escape.scanner, from: escape.after, runs: runs.push(escape.text) })
  }
}

/// The escape at the backslash `stop` of a string's text, which is not the last byte: the bytes it
/// stands for and where the text goes on. An unknown escape is reported and its character kept.
fn text_escape(
  src: Bytes,
  scanner: Scanner,
  stop: Int,
) -> { scanner: Scanner, text: Bytes, after: Int } / {abort.raise} = {
  let c = src.peek(stop + 1);
  if c == 110 { { scanner: scanner, text: b"\n", after: stop + 2 } }
  else if c == 116 { { scanner: scanner, text: b"\t", after: stop + 2 } }
  else if c == 114 { { scanner: scanner, text: b"\r", after: stop + 2 } }
  else if c == 48 { { scanner: scanner, text: b"\x00", after: stop + 2 } }
  else if c == 92 { { scanner: scanner, text: b"\\", after: stop + 2 } }
  else if c == 34 { { scanner: scanner, text: b"\"", after: stop + 2 } }
  else if c == 39 { { scanner: scanner, text: b"'", after: stop + 2 } } else if c == 117 {
    let u = unicode_escape(src, stop);
    if u.value < 0 { { scanner: refuse_escape(scanner, stop, u), text: b"", after: u.end } }
    else { { scanner: scanner, text: utf8_of(u.value), after: u.end } }
  } else {
    let width = utf8_len(c);
    {
      scanner: unknown_escape(src, scanner, stop, width, valid_escapes()),
      text: src.slice(stop + 1, stop + 1 + width),
      after: stop + 1 + width,
    }
  }
}

// --- Interpolated strings ---------------------------------------------------

fn interpolated_stops() -> Bytes = b"\"\\\n{}"

/// `f"a {x} b"` is `InterpolatedHead("a ")`, the tokens of `x`, then `InterpolatedTail(" b")`, and the
/// text between two holes an `InterpolatedMiddle`; `{{` and `}}` are braces of the text. `open` is where
/// the piece's token starts: the `f` of a head, otherwise the `}` closing a hole.
fn interpolated_piece(
  src: Bytes,
  scanner: Scanner,
  open: Int,
  from: Int,
  is_head: Bool,
) -> Scanner / {abort.raise} =
  iterate({ scanner: scanner, from: from, runs: [] }, src.len() - from + 2, |read: TextRead|
    interpolated_run(src, open, is_head, read))

fn interpolated_run(
  src: Bytes,
  open: Int,
  is_head: Bool,
  read: TextRead,
) -> Iter<TextRead, Scanner> / {abort.raise} = {
  let len = src.len();
  let stop = src.skip_until(read.from, interpolated_stops());
  let runs = read.runs.push(src.slice(read.from, stop));
  let joined = || Bytes::concat_all(runs);
  let c = src.peek(stop);
  if c < 0 || c == 10 || (c == 92 && src.peek(stop + 1) < 0) {
    Stop(
      push_token(
        push_error(
          read.scanner,
          open,
          if c == 92 { len } else { stop },
          unterminated(),
          b"unterminated string literal",
          b"add a closing `\"`; a string may not span a line break",
        ),
        open,
        if c == 92 { len } else { stop },
        if is_head { StringLiteral(joined()) } else { InterpolatedTail(joined()) },
      ),
    )
  } else if c == 34 {
    Stop(
      push_token(read.scanner, open, stop + 1, if is_head { StringLiteral(joined()) }
      else { InterpolatedTail(joined()) }),
    )
  } else if c == 92 {
    let escape = text_escape(src, read.scanner, stop);
    Continue({ scanner: escape.scanner, from: escape.after, runs: runs.push(escape.text) })
  } else if src.peek(stop + 1) == c {
    Continue({ scanner: read.scanner, from: stop + 2, runs: runs.push(src.slice(stop, stop + 1)) })
  } else if c == 123 {
    let kind = if is_head { InterpolatedHead(joined()) } else { InterpolatedMiddle(joined()) };
    Stop(push_token(with_holes(read.scanner, read.scanner.holes.push(0)), open, stop + 1, kind))
  } else {
    Continue({
      scanner: push_error(
        read.scanner,
        stop,
        stop + 1,
        unexpected(),
        b"a lone `}` in an interpolated string",
        b"write `}}` for a brace in the text",
      ),
      from: stop + 1,
      runs: runs,
    })
  }
}

// --- A test's label ---------------------------------------------------------

fn keyword_back(tokens: List<Token>, back: Int, word: Keyword) -> Bool =
  match tokens.at(tokens.len() - back) {
    Some(token) -> match token.kind { Keyword(keyword) -> keyword == word, _ -> false },
    None -> false,
  }

/// Whether the next token is a test's label: `test` or `test/nondet` came just before it.
fn at_test_label(tokens: List<Token>) -> Bool =
  keyword_back(tokens, 1, Test)
    || (keyword_back(tokens, 1, Nondet) && keyword_back(tokens, 3, Test)
    && (match tokens.at(tokens.len() - 2) {
      Some(token) -> token.kind == Punctuation(Slash),
      None -> false,
    }))

/// A string a name touches is a tagged literal: its text is an interpolated string's, holes and all.
fn touches_name(tokens: List<Token>, start: Int) -> Bool =
  name_touches(tokens.at(tokens.len() - 1), start)

/// [`touches_name`] of the token at `at`, for a pass that reads off tokens where the lexer read off the
/// one it took last.
pub fn tagged_at(tokens: List<Token>, at: Int) -> Bool =
  match tokens.at(at) { Some(token) -> name_touches(tokens.at(at - 1), token.start), None -> false }

fn name_touches(before: Option<Token>, start: Int) -> Bool =
  match before {
    Some(token) -> token.end == start && (match token.kind { Identifier(_) -> true, _ -> false }),
    None -> false,
  }

fn follows_for(src: Bytes, at: Int) -> Bool / {abort.raise} = {
  let word = skip_trivia(src, at);
  src.starts_at(word, b"for") && !is_ident_continue(src.peek(word + 3))
}

/// A label before `for` is a template, its holes an interpolated string's; any other is a string.
/// Nothing tells them apart until the text after it is read, so it is read as a template first and that
/// read is kept when that is what it was.
fn label(src: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} =
  match template_probe(src, scanner, start) {
    Some(read) -> if follows_for(src, read.pos) { read } else { string_lit(src, scanner, start) },
    None -> string_lit(src, scanner, start),
  }

/// The label read as a template, from the scanner it started in: `None` where no closing quote follows.
fn template_probe(src: Bytes, scanner: Scanner, start: Int) -> Option<Scanner> / {abort.raise} = {
  let open = scanner.holes.len();
  iterate(
    interpolated_piece(src, scanner, start, start + 1, true),
    src.len() - start + 2,
    |read: Scanner|
      if read.pos > start && read.holes.len() == open { Stop(Some(read)) }
      else if read.pos >= src.len() { Stop(None) }
      else { Continue(next_atom(src, read)) },
  )
}

/// A brace opened or closed inside the innermost hole; outside every hole there is nothing to count.
fn nest_hole(scanner: Scanner, delta: Int) -> Scanner =
  match scanner.holes.at(scanner.holes.len() - 1) {
    None -> scanner,
    Some(depth) -> with_holes(scanner, scanner.holes.drop_last(1).push(depth + delta)),
  }

/// A `}` with no brace of its own open inside the innermost hole ends that hole.
fn closes_hole(scanner: Scanner) -> Bool =
  match scanner.holes.at(scanner.holes.len() - 1) { Some(depth) -> depth == 0, None -> false }

fn valid_escapes() -> Bytes = b"valid escapes are \\n \\t \\r \\0 \\\\ \\\" \\' and \\u{...}"

// --- Escapes shared by strings and characters --------------------------------

/// `-1` with the refusal in `code` and `message` where it names no character.
type Escape = { value: Int, end: Int, code: Bytes, message: Bytes, label: Bytes }

fn escape_at(value: Int, end: Int) -> Escape =
  { value: value, end: end, code: b"", message: b"", label: b"" }

fn bad_escape(end: Int, code: Bytes, message: Bytes, label: Bytes) -> Escape =
  { value: -1, end: end, code: code, message: message, label: label }

fn refuse_escape(scanner: Scanner, at_backslash: Int, escape: Escape) -> Scanner =
  push_error(scanner, at_backslash, escape.end, escape.code, escape.message, escape.label)

fn hex_chars() -> Bytes = b"0123456789abcdefABCDEF"

/// One to six hex digits in braces, naming a scalar value. Only what is present is consumed, so a
/// closing quote survives a malformed one.
fn unicode_escape(src: Bytes, i: Int) -> Escape / {abort.raise} =
  if src.peek(i + 2) != 123 {
    bad_escape(
      i + 2,
      unexpected(),
      b"`\\u` takes its character's hex digits in braces",
      b"write it as `\\u{1F600}`",
    )
  } else {
    let first = i + 3;
    let stop = src.skip(first, hex_chars());
    let closed = src.peek(stop) == 125;
    if stop == first || stop - first > 6 || !closed {
      bad_escape(
        if closed { stop + 1 } else { stop },
        unexpected(),
        b"`\\u{...}` holds one to six hex digits and a closing `}`",
        b"as in `\\u{e9}` or `\\u{1F600}`",
      )
    } else {
      let v = range(first, stop).fold(0, |acc: Int, k: Int| acc * 16 + hex_value(src.peek(k)));
      if v > 1114111 || (v >= 55296 && v <= 57343) {
        bad_escape(
          stop + 1,
          out_of_range(),
          b"`\\u{...}` names no character",
          b"a surrogate, `D800` to `DFFF`, or a value past `10FFFF` is not a Unicode scalar value",
        )
      } else { escape_at(v, stop + 1) }
    }
  }

/// `-1` for any letter that names nothing.
fn letter_escape(byte: Int) -> Int =
  if byte == 110 { 10 }
  else if byte == 116 { 9 }
  else if byte == 114 { 13 }
  else if byte == 48 { 0 }
  else if byte == 92 || byte == 39 || byte == 34 { byte }
  else { 0 - 1 }

fn char_escape(src: Bytes, i: Int) -> Escape / {abort.raise} = {
  let c = src.peek(i + 1);
  if letter_escape(c) >= 0 { escape_at(letter_escape(c), i + 2) }
  else if c == 117 { unicode_escape(src, i) } else if c < 0 || c == 10 {
    bad_escape(i + 1, unterminated(), b"unterminated character literal", b"add a closing `'`")
  } else {
    let width = utf8_len(c);
    bad_escape(
      i + 1 + width,
      unexpected(),
      Bytes::concat_all([b"unknown escape sequence `\\", src.slice(i + 1, i + 1 + width), b"`"]),
      valid_escapes(),
    )
  }
}

pub fn utf8_of(v: Int) -> Bytes / {abort.raise} =
  if v < 128 { byte_of_int(v) }
  else if v < 2048 { byte_of_int(192 | v >> 6).concat(byte_of_int(128 | v & 63)) }
  else if v < 65536 {
    Bytes::concat_all([
      byte_of_int(224 | v >> 12),
      byte_of_int(128 | v >> 6 & 63),
      byte_of_int(128 | v & 63),
    ])
  } else {
    Bytes::concat_all([
      byte_of_int(240 | v >> 18),
      byte_of_int(128 | v >> 12 & 63),
      byte_of_int(128 | v >> 6 & 63),
      byte_of_int(128 | v & 63),
    ])
  }

/// The scalar value of the `width`-byte UTF-8 sequence at `i`; the source is UTF-8 by the time it is lexed.
fn utf8_point(src: Bytes, at: Int, width: Int) -> Int =
  if width == 1 { src.peek(at) }
  else if width == 2 { (src.peek(at) & 31) << 6 | src.peek(at + 1) & 63 } else if width == 3 {
    (src.peek(at) & 15) << 12 | (src.peek(at + 1) & 63) << 6 | src.peek(at + 2) & 63
  } else {
    (src.peek(at) & 7) << 18 | (src.peek(at + 1) & 63) << 12 | (src.peek(at + 2) & 63) << 6
      | src.peek(at + 3) & 63
  }

// --- Character literals -----------------------------------------------------

/// `'a'`, `'\n'` or `'\u{1F600}'`: exactly one character between single quotes.
fn char_lit(src: Bytes, scanner: Scanner, open: Int) -> Scanner / {abort.raise} = {
  let c = src.peek(open + 1);
  if c < 0 || c == 10 { unterminated_char(scanner, open, open + 1, CharLiteral(0)) }
  else if c == 39 {
    push_token(
      push_error(
        scanner,
        open,
        open + 2,
        unexpected(),
        b"an empty character literal",
        b"a character literal holds exactly one character",
      ),
      open,
      open + 2,
      CharLiteral(0),
    )
  } else if c == 92 {
    let escape = char_escape(src, open + 1);
    if escape.value < 0 {
      char_close(src, refuse_escape(scanner, open + 1, escape), open, escape.end, CharLiteral(0))
    } else { char_close(src, scanner, open, escape.end, CharLiteral(escape.value)) }
  } else {
    let width = utf8_len(c);
    char_close(src, scanner, open, open + 1 + width, CharLiteral(utf8_point(src, open + 1, width)))
  }
}

fn quoted_unit(kind: TokenKind) -> Bytes =
  match kind { CharLiteral(_) -> b"character", _ -> b"byte" }

fn char_close(
  src: Bytes,
  scanner: Scanner,
  start: Int,
  i: Int,
  kind: TokenKind,
) -> Scanner / {abort.raise} =
  if src.peek(i) == 39 { push_token(scanner, start, i + 1, kind) } else {
    let close = src.skip_until(i, b"'\n");
    if src.peek(close) == 39 {
      push_token(
        push_error(
          scanner,
          start,
          close + 1,
          unexpected(),
          Bytes::concat_all([b"a ", quoted_unit(kind), b" literal holds one ", quoted_unit(kind)]),
          match kind {
            CharLiteral(_) -> b"write a string, `\"...\"`, for more than one",
            _ -> b"write a byte string, `b\"...\"`, for more than one",
          },
        ),
        start,
        close + 1,
        kind,
      )
    } else { unterminated_char(scanner, start, close, kind) }
  }

fn unterminated_char(scanner: Scanner, start: Int, stop: Int, kind: TokenKind) -> Scanner =
  push_token(
    push_error(
      scanner,
      start,
      stop,
      unterminated(),
      Bytes::concat_all([b"unterminated ", quoted_unit(kind), b" literal"]),
      b"add a closing `'`",
    ),
    start,
    stop,
    kind,
  )

// --- Byte literals ----------------------------------------------------------

/// `b'a'`, `b'\n'` or `b'\x1f'`: one ASCII character or one escape, lexed as the `Int` that byte is.
fn byte_lit(src: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let at = start + 2;
  let c = src.peek(at);
  if c < 0 || c == 10 { unterminated_char(scanner, start, at, IntLiteral(0)) } else if c == 39 {
    push_token(
      push_error(
        scanner,
        start,
        at + 1,
        unexpected(),
        b"an empty byte literal",
        b"a byte literal holds exactly one byte",
      ),
      start,
      at + 1,
      IntLiteral(0),
    )
  } else if c == 92 {
    let escape = byte_escape(src, at);
    if escape.value < 0 {
      char_close(src, refuse_escape(scanner, at, escape), start, escape.end, IntLiteral(0))
    } else { char_close(src, scanner, start, escape.end, IntLiteral(escape.value)) }
  } else if c >= 128 {
    let width = utf8_len(c);
    char_close(
      src,
      push_error(
        scanner,
        at,
        at + width,
        unexpected(),
        Bytes::concat_all([
          b"`",
          src.slice(at, at + width),
          b"` is not an ASCII character, so it has no place in `b'...'`",
        ]),
        b"a byte literal holds one byte: write it as `\\xNN`",
      ),
      start,
      at + width,
      IntLiteral(0),
    )
  } else { char_close(src, scanner, start, at + 1, IntLiteral(c)) }
}

fn byte_escape(src: Bytes, i: Int) -> Escape / {abort.raise} = {
  let c = src.peek(i + 1);
  if letter_escape(c) >= 0 { escape_at(letter_escape(c), i + 2) } else if c == 120 {
    let hi = hex_value(src.peek(i + 2));
    let lo = hex_value(src.peek(i + 3));
    if hi >= 0 && lo >= 0 { escape_at(hi * 16 + lo, i + 4) } else {
      bad_escape(
        if hi >= 0 { i + 3 } else { i + 2 },
        unexpected(),
        b"`\\x` needs exactly two hex digits",
        b"write two hex digits, as in `\\x0d`",
      )
    }
  } else if c == 117 {
    bad_escape(
      unicode_escape(src, i).end,
      unexpected(),
      b"`\\u{...}` names a character, and a byte literal holds a byte",
      b"write one of the character's UTF-8 bytes as `\\xNN`",
    )
  } else if c < 0 || c == 10 {
    bad_escape(i + 1, unterminated(), b"unterminated byte literal", b"add a closing `'`")
  } else {
    let width = utf8_len(c);
    bad_escape(
      i + 1 + width,
      unexpected(),
      Bytes::concat_all([b"unknown escape sequence `\\", src.slice(i + 1, i + 1 + width), b"`"]),
      b"valid escapes are \\n \\t \\r \\0 \\\\ \\' \\\" and \\xNN",
    )
  }
}

// --- Line strings -----------------------------------------------------------

fn line_string(src: Bytes, scanner: Scanner, open: Int) -> Scanner / {abort.raise} =
  iterate(
    { scanner: scanner, next_line: open, lines: [] },
    src.len() - open + 2,
    |read: LineRead| string_line(src, open, read),
  )

/// Where a line string's next line starts, at its `\\`, and the lines read so far.
type LineRead = { scanner: Scanner, next_line: Int, lines: List<Bytes> }

/// A `\r` before a line's `\n` ends the line rather than being content.
fn string_line(src: Bytes, open: Int, read: LineRead) -> Iter<LineRead, Scanner> / {abort.raise} = {
  let scanner = read.scanner;
  let from = read.next_line + 2;
  let eol = src.skip_until(from, b"\n");
  let end = if eol > from && src.peek(eol - 1) == 13 { eol - 1 } else { eol };
  let blank = scan_back(src, from, end);
  let checked = if blank == end { scanner } else {
    push_error(
      scanner,
      blank,
      end,
      unexpected(),
      b"a line of a line string ends in whitespace",
      b"whitespace at the end of a line is invisible, so it is not content; end the line before it, or write the line as a `\"...\"` string with the spaces in it",
    )
  };
  let lines = read.lines.push(src.slice(from, end));
  let next = continued_at(src, eol);
  if next < 0 { Stop(push_token(checked, open, end, LineString(joined_lines(lines)))) }
  else { Continue({ scanner: checked, next_line: next, lines: lines }) }
}

fn scan_back(src: Bytes, from: Int, end: Int) -> Int / {abort.raise} =
  iterate(end, end - from + 1, |i: Int|
    if i > from && (src.peek(i - 1) == 32 || src.peek(i - 1) == 9) { Continue(i - 1) }
    else { Stop(i) })

fn continued_at(src: Bytes, eol: Int) -> Int / {abort.raise} =
  if src.peek(eol) != 10 { -1 } else {
    let k = src.skip(eol + 1, b" \t");
    if src.peek(k) == 92 && src.peek(k + 1) == 92 { k } else { -1 }
  }

fn joined_lines(lines: List<Bytes>) -> Bytes =
  Bytes::concat_all(
    range(0, lines.len()).fold([], |acc: List<Bytes>, i: Int|
      match lines.at(i) {
        Some(l) -> if i == 0 { acc.push(l) } else { acc.push(b"\n").push(l) },
        None -> acc,
      }),
  )

// --- Byte-string literals ---------------------------------------------------

/// Every ASCII byte but the quote, the backslash and the newline: a byte above `~` stops rather than
/// being encoded, so no literal depends on the file's encoding.
fn bytes_text() -> Bytes =
  b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f !#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~\x7f"

fn bytes_lit(src: Bytes, scanner: Scanner, open: Int) -> Scanner / {abort.raise} =
  iterate({ scanner: scanner, from: open + 2, runs: [] }, src.len() - open + 2, |read: TextRead|
    bytes_body(src, open, read))

fn bytes_body(src: Bytes, open: Int, read: TextRead) -> Iter<TextRead, Scanner> / {abort.raise} = {
  let stop = src.skip(read.from, bytes_text());
  let runs = read.runs.push(src.slice(read.from, stop));
  let c = src.peek(stop);
  if c < 0 || c == 10 {
    Stop(
      push_token(
        push_error(
          read.scanner,
          open,
          stop,
          unterminated(),
          b"unterminated byte-string literal",
          b"add a closing `\"`; a literal may not span a line break",
        ),
        open,
        stop,
        BytesLiteral(Bytes::concat_all(runs)),
      ),
    )
  } else if c == 34 {
    Stop(push_token(read.scanner, open, stop + 1, BytesLiteral(Bytes::concat_all(runs))))
  } else if c == 92 { bytes_escape(src, read.scanner, open, stop, runs) } else {
    let width = utf8_len(c);
    let ch = src.slice(stop, stop + width);
    let encoded = Bytes::concat_all(
      range(0, width).map(|i: Int| b"\\x".concat(Bytes::of_string(ch.slice(i, i + 1).hex_of()))),
    );
    Continue({
      scanner: push_error(
        read.scanner,
        stop,
        stop + width,
        unexpected(),
        Bytes::concat_all([
          b"`",
          ch,
          b"` is not an ASCII character, so it has no place in `b\"...\"`",
        ]),
        Bytes::concat_all([b"write `", encoded, b"` instead"]),
      ),
      from: stop + width,
      runs: runs,
    })
  }
}

fn bytes_escape(
  src: Bytes,
  scanner: Scanner,
  open: Int,
  stop: Int,
  runs: List<Bytes>,
) -> Iter<TextRead, Scanner> / {abort.raise} = {
  let len = src.len();
  let c = src.peek(stop + 1);
  let past = |text: Bytes| Continue({ scanner: scanner, from: stop + 2, runs: runs.push(text) });
  if c < 0 {
    Stop(
      push_token(
        push_error(
          scanner,
          open,
          len,
          unterminated(),
          b"unterminated byte-string literal",
          b"add a closing `\"`",
        ),
        open,
        len,
        BytesLiteral(Bytes::concat_all(runs)),
      ),
    )
  } else if c == 110 { past(b"\n") }
  else if c == 116 { past(b"\t") }
  else if c == 114 { past(b"\r") }
  else if c == 48 { past(b"\x00") }
  else if c == 92 { past(b"\\") }
  else if c == 34 { past(b"\"") }
  else if c == 120 { hex_escape(src, scanner, stop, runs) } else if c == 117 {
    // Consumed whole, so what follows reads as the literal's next bytes.
    let u = unicode_escape(src, stop);
    Continue({
      scanner: push_error(
        scanner,
        stop,
        u.end,
        unexpected(),
        b"`\\u{...}` names a character, and a byte string holds bytes",
        b"write the character's UTF-8 bytes as `\\xNN` escapes",
      ),
      from: u.end,
      runs: runs,
    })
  } else {
    // Unlike a string's unknown escape, this one contributes no byte.
    let width = utf8_len(c);
    Continue({
      scanner: unknown_escape(
        src,
        scanner,
        stop,
        width,
        b"valid escapes are \\n \\t \\r \\0 \\\\ \\\" and \\xNN",
      ),
      from: stop + 1 + width,
      runs: runs,
    })
  }
}

/// A malformed escape yields a zero byte and consumes only the hex digits present, so the closing quote survives.
fn hex_escape(
  src: Bytes,
  scanner: Scanner,
  stop: Int,
  runs: List<Bytes>,
) -> Iter<TextRead, Scanner> / {abort.raise} = {
  let hi = hex_value(src.peek(stop + 2));
  let lo = hex_value(src.peek(stop + 3));
  if hi >= 0 && lo >= 0 {
    Continue({ scanner: scanner, from: stop + 4, runs: runs.push(byte_of_int(hi * 16 + lo)) })
  } else {
    let taken = if hi >= 0 { stop + 3 } else { stop + 2 };
    Continue({
      scanner: push_error(
        scanner,
        stop,
        taken,
        unexpected(),
        b"`\\x` needs exactly two hex digits",
        b"write two hex digits, as in `\\x0d`",
      ),
      from: taken,
      runs: runs.push(b"\x00"),
    })
  }
}

// --- Punctuation ------------------------------------------------------------

/// Maximal munch.
fn punct(src: Bytes, scanner: Scanner, start: Int, byte: Int) -> Scanner / {abort.raise} =
  if byte == 40 { push_token(scanner, start, start + 1, Punctuation(Lparen)) }
  else if byte == 41 { push_token(scanner, start, start + 1, Punctuation(Rparen)) }
  else if byte == 123 { push_token(nest_hole(scanner, 1), start, start + 1, Punctuation(Lbrace)) }
  else if byte == 125 && closes_hole(scanner) {
    interpolated_piece(
      src,
      with_holes(scanner, scanner.holes.drop_last(1)),
      start,
      start + 1,
      false,
    )
  } else if byte == 125 {
    push_token(nest_hole(scanner, -1), start, start + 1, Punctuation(Rbrace))
  } else if byte == 91 { push_token(scanner, start, start + 1, Punctuation(Lbracket)) }
  else if byte == 93 { push_token(scanner, start, start + 1, Punctuation(Rbracket)) }
  else if byte == 44 { push_token(scanner, start, start + 1, Punctuation(Comma)) }
  else if byte == 59 { push_token(scanner, start, start + 1, Punctuation(Semi)) }
  else { operator(src, scanner, start, byte) }

fn operator(src: Bytes, scanner: Scanner, start: Int, byte: Int) -> Scanner / {abort.raise} =
  if byte == 58 { punct_pair(scanner, src, start, 58, Coloncolon, Colon) }
  else if byte == 46 && src.peek(start + 1) == 46 && src.peek(start + 2) == 61 {
    push_token(scanner, start, start + 3, Punctuation(Dotdoteq))
  } else if byte == 46 { punct_pair(scanner, src, start, 46, Dotdot, Dot) }
  else if byte == 61 { punct_pair(scanner, src, start, 61, Eqeq, Eq) }
  else if byte == 33 { punct_pair(scanner, src, start, 61, Bangeq, Bang) } else if byte == 60 {
    if src.peek(start + 1) == 60 { push_token(scanner, start, start + 2, Punctuation(Shl)) }
    else { punct_pair(scanner, src, start, 61, Le, Lt) }
  } else if byte == 62 {
    if src.peek(start + 1) == 62 { push_token(scanner, start, start + 2, Punctuation(Shr)) }
    else { punct_pair(scanner, src, start, 61, Ge, Gt) }
  } else if byte == 43 && src.peek(start + 1) != 43 {
    arithmetic(scanner, src, start, Plus, Pluspercent, Pluspipe)
  } else if byte == 43 { push_token(scanner, start, start + 2, Punctuation(Plusplus)) }
  else if byte == 45 && src.peek(start + 1) != 62 {
    arithmetic(scanner, src, start, Minus, Minuspercent, Minuspipe)
  } else if byte == 45 { push_token(scanner, start, start + 2, Punctuation(Arrow)) }
  else if byte == 42 { arithmetic(scanner, src, start, Star, Starpercent, Starpipe) }
  else if byte == 47 { push_token(scanner, start, start + 1, Punctuation(Slash)) }
  else if byte == 37 { push_token(scanner, start, start + 1, Punctuation(Percent)) }
  else if byte == 63 && src.peek(start + 1) == 63 && src.peek(start + 2) == 63 {
    push_token(scanner, start, start + 3, Punctuation(Hole))
  } else if byte == 63 { push_token(scanner, start, start + 1, Punctuation(Question)) }
  else if byte == 124 { punct_pair(scanner, src, start, 124, Pipepipe, Pipe) }
  else if byte == 38 { punct_pair(scanner, src, start, 38, Ampamp, Amp) }
  else if byte == 94 { push_token(scanner, start, start + 1, Punctuation(Caret)) }
  else if byte == 126 { push_token(scanner, start, start + 1, Punctuation(Tilde)) }
  else if byte == 35 && src.peek(start + 1) == 123 {
    push_token(nest_hole(scanner, 1), start, start + 2, Punctuation(Hashbrace))
  } else if byte == 35 && src.peek(start + 1) == 91 {
    push_token(scanner, start, start + 2, Punctuation(Hashbracket))
  } else if byte == 35 {
    push_error(
      seek(scanner, start + 1),
      start,
      start + 1,
      unexpected(),
      b"unexpected character `#`",
      b"`#` opens a map literal, `#{k: v}`, or a set literal, `#[a, b]`, and nothing else",
    )
  } else {
    push_error(
      seek(scanner, start + 1),
      start,
      start + 1,
      unexpected(),
      Bytes::concat_all([b"unexpected character `", src.slice(start, start + 1), b"`"]),
      b"this character has no meaning in Ply source",
    )
  }

/// `+`, `-` or `*`, and with a `%` or a `|` touching it the operator that wraps or saturates.
fn arithmetic(
  scanner: Scanner,
  src: Bytes,
  start: Int,
  single: Punct,
  percent: Punct,
  pipe: Punct,
) -> Scanner = {
  let next = src.peek(start + 1);
  if next == 37 { push_token(scanner, start, start + 2, Punctuation(percent)) }
  else if next == 124 { push_token(scanner, start, start + 2, Punctuation(pipe)) }
  else { push_token(scanner, start, start + 1, Punctuation(single)) }
}

fn punct_pair(
  scanner: Scanner,
  src: Bytes,
  start: Int,
  second: Int,
  both: Punct,
  single: Punct,
) -> Scanner =
  if src.peek(start + 1) == second { push_token(scanner, start, start + 2, Punctuation(both)) }
  else { push_token(scanner, start, start + 1, Punctuation(single)) }

// --- The dump ---------------------------------------------------------------

/// `start:end:kind[:payload];` per token, then `start:end:!:code;` per diagnostic.
pub fn dump(src: Bytes) -> String / {abort.raise} = {
  let lx = lex(src);
  String::of_bytes(
    Bytes::concat_all(lx.tokens.map(render_token)).concat(
      Bytes::concat_all(lx.diags.map(render_diag)),
    ),
  )
}

fn render_token(token: Token) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    ascii_of_int(token.start),
    b":",
    ascii_of_int(token.end),
    b":",
    token_body(token.kind),
    b";",
  ])

fn render_diag(diag: Diag) -> Bytes =
  Bytes::concat_all([
    ascii_of_int(diag.start),
    b":",
    ascii_of_int(diag.end),
    b":!:",
    diag.code,
    b";",
  ])

fn token_body(kind: TokenKind) -> Bytes / {abort.raise} =
  match kind {
    Identifier(b) -> b"i:".concat(b),
    IntLiteral(v) -> b"n:".concat(ascii_of_int(v)),
    FixedLiteral(ty, v) -> Bytes::concat_all([b"w:", ty, b":", ascii_of_int(v)]),
    WideLiteral(ty, high, low) ->
      Bytes::concat_all([b"W:", ty, b":", ascii_of_int(high), b":", ascii_of_int(low)]),
    FloatLiteral(txt) -> b"f:".concat(txt),
    DecimalLiteral(m, sc) -> Bytes::concat_all([b"d:", m, b":", ascii_of_int(sc)]),
    StringLiteral(b) -> b"s:".concat(Bytes::of_string(b.hex_of())),
    LineString(b) -> b"l:".concat(Bytes::of_string(b.hex_of())),
    BytesLiteral(b) -> b"b:".concat(Bytes::of_string(b.hex_of())),
    InterpolatedHead(b) -> b"F:".concat(Bytes::of_string(b.hex_of())),
    InterpolatedMiddle(b) -> b"M:".concat(Bytes::of_string(b.hex_of())),
    InterpolatedTail(b) -> b"T:".concat(Bytes::of_string(b.hex_of())),
    CharLiteral(value) -> b"c:".concat(ascii_of_int(value)),
    Keyword(keyword) -> b"k:".concat(keyword_name(keyword)),
    Punctuation(punct) -> b"p:".concat(punct_text(punct)),
    EndOfInput -> b"e",
  }

// --- Tests ------------------------------------------------------------------

test "a keyword and an identifier that starts with one are different tokens" {
  assert_eq(dump(b"fn fnord"), "0:2:k:fn;3:8:i:fnord;8:8:e;")
}

test "an underscore alone is a wildcard but prefixes an identifier" {
  assert_eq(dump(b"_ _x"), "0:1:p:_;2:4:i:_x;4:4:e;")
}

test "an integer literal may be written with underscore separators" {
  assert_eq(dump(b"1_000_000"), "0:9:n:1000000;9:9:e;")
}

test "an integer that does not fit in Int is a diagnostic and a zero" {
  assert_eq(dump(b"99999999999999999999"), "0:20:n:0;20:20:e;0:20:!:E0001;")
}

test "a fraction or an exponent is what makes a literal a Float" {
  assert_eq(
    dump(b"1 1.5 1e9 1_000.5 1.5e-3"),
    "0:1:n:1;2:5:f:1.5;6:9:f:1e9;10:17:f:1000.5;18:24:f:1.5e-3;24:24:e;",
  )
}

test "a Decimal keeps the trailing zero its scale stands for" {
  assert_eq(dump(b"1.50m"), "0:5:d:150:2;5:5:e;")
}

test "a Decimal literal has no exponent" {
  assert_eq(dump(b"1e3m"), "0:4:d:0:0;4:4:e;0:4:!:E0001;")
}

test "the escapes a string literal decodes" {
  assert_eq(dump(b"\"a\\nb\\t\\\\\\\"\\r\\0\""), "0:16:s:610a62095c220d00;16:16:e;")
}

test "an unterminated string reports from its opening quote" {
  assert_eq(
    dump(b"let s = \"oops\nlet t = 1"),
    "0:3:k:let;4:5:i:s;6:7:p:=;8:13:s:6f6f7073;14:17:k:let;18:19:i:t;20:21:p:=;22:23:n:1;23:23:e;8:13:!:E0002;",
  )
}

test "a line string runs from its backslashes to the end of the line, verbatim" {
  // `a"\n` and two backslashes, as written: nothing in a line string is an escape.
  assert_eq(dump(b"\\\\a\"\\n\\\\\nx"), "0:8:l:61225c6e5c5c;9:10:i:x;10:10:e;")
}

test "the lines of a line string join with a newline, and the last one ends the value" {
  assert_eq(dump(b"\\\\one\n  \\\\two\n\t\\\\\n1"), "0:17:l:6f6e650a74776f0a;18:19:n:1;19:19:e;")
}

test "a line string ends at the first line that does not continue it" {
  assert_eq(dump(b"\\\\one\n\n\\\\two"), "0:5:l:6f6e65;7:12:l:74776f;12:12:e;");
  assert_eq(dump(b"\\\\one\n// two\n\\\\three"), "0:5:l:6f6e65;13:20:l:7468726565;20:20:e;")
}

test "a carriage return before a newline ends a line rather than being content" {
  assert_eq(dump(b"\\\\a\r\n\\\\b\r\n"), "0:8:l:610a62;10:10:e;")
}

test "a line of a line string that ends in whitespace is refused where the whitespace starts" {
  assert_eq(dump(b"\\\\a  \n\\\\b"), "0:9:l:6120200a62;9:9:e;3:5:!:E0001;")
}

test "one backslash is no token" { assert_eq(dump(b"\\a"), "1:2:i:a;2:2:e;0:1:!:E0001;") }

test "a byte literal takes the string escapes plus hex" {
  assert_eq(dump(b"b\"GET \\r\\n\\x00\\xff\\\"\\\\\""), "0:23:b:474554200d0a00ff225c;23:23:e;")
}

test "a short hex escape is reported without swallowing the literal" {
  assert_eq(dump(b"b\"\\xg1\" 7"), "0:7:b:006731;8:9:n:7;9:9:e;2:4:!:E0001;")
}

test "operators use maximal munch" {
  assert_eq(
    dump(b"-> - ++ + == = != ! <= < >= > && || | .. ."),
    "0:2:p:->;3:4:p:-;5:7:p:++;8:9:p:+;10:12:p:==;13:14:p:=;"
      ++ "15:17:p:!=;18:19:p:!;20:22:p:<=;23:24:p:<;25:27:p:>=;28:29:p:>;"
      ++ "30:32:p:&&;33:35:p:||;36:37:p:|;38:40:p:..;41:42:p:.;42:42:e;",
  )
}

test "the try operator is one token of its own" {
  assert_eq(dump(b"f(x)?"), "0:1:i:f;1:2:p:(;2:3:i:x;3:4:p:);4:5:p:?;5:5:e;")
}

test "three question marks are one hole token, by maximal munch" {
  assert_eq(dump(b"??? ?? ?"), "0:3:p:???;4:5:p:?;5:6:p:?;7:8:p:?;8:8:e;");
  assert_eq(dump(b"x???"), "0:1:i:x;1:4:p:???;4:4:e;")
}

test "the bit operators are tokens, and a byte nothing claims is reported and skipped" {
  assert_eq(dump(b"a & b"), "0:1:i:a;2:3:p:&;4:5:i:b;5:5:e;");
  assert_eq(dump(b"a ^ ~b"), "0:1:i:a;2:3:p:^;4:5:p:~;5:6:i:b;6:6:e;");
  assert_eq(dump(b"a $ b"), "0:1:i:a;4:5:i:b;5:5:e;2:3:!:E0001;")
}

test "a hex literal is an Int bounded as a 64-bit pattern" {
  assert_eq(dump(b"0x10 0xff"), "0:4:n:16;5:9:n:255;9:9:e;");
  assert_eq(dump(b"0xFFFF_FFFF_FFFF_FFFF"), "0:21:n:-1;21:21:e;")
}

test "a U64 literal spans all 64 bits, carried as its pattern" {
  assert_eq(dump(b"9223372036854775808u64"), "0:22:w:U64:-9223372036854775808;22:22:e;");
  assert_eq(dump(b"18446744073709551615u64"), "0:23:w:U64:-1;23:23:e;");
  assert_eq(dump(b"18446744073709551616u64"), "0:23:w:U64:0;23:23:e;0:23:!:E0211;")
}

test "a 128-bit literal is carried as its high and low 64-bit patterns" {
  assert_eq(dump(b"1u128"), "0:5:W:U128:0:1;5:5:e;");
  assert_eq(dump(b"18446744073709551616u128"), "0:24:W:U128:1:0;24:24:e;");
  assert_eq(dump(b"340282366920938463463374607431768211455u128"), "0:43:W:U128:-1:-1;43:43:e;");
  assert_eq(
    dump(b"170141183460469231731687303715884105727i128"),
    "0:43:W:I128:9223372036854775807:-1;43:43:e;",
  );
  assert_eq(dump(b"0x1_0000_0000_0000_0000u128"), "0:27:W:U128:1:0;27:27:e;");
  assert_eq(dump(b"0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFi128"), "0:38:W:I128:-1:-1;38:38:e;")
}

test "a 128-bit value spells in decimal from its two halves" {
  assert_eq(wide_decimal(false, 0, 0), b"0");
  assert_eq(wide_decimal(false, 1, 0), b"18446744073709551616");
  assert_eq(wide_decimal(false, -1, -1), b"340282366920938463463374607431768211455");
  assert_eq(wide_decimal(true, -1, -1), b"-1");
  assert_eq(
    wide_decimal(true, 0 - 9223372036854775807 - 1, 0),
    b"-170141183460469231731687303715884105728",
  );
  assert_eq(wide_decimal(true, 9223372036854775807, -1), b"170141183460469231731687303715884105727")
}

test "a 128-bit literal past its width is a diagnostic and a zero" {
  assert_eq(
    dump(b"340282366920938463463374607431768211456u128"),
    "0:43:W:U128:0:0;43:43:e;0:43:!:E0211;",
  );
  assert_eq(
    dump(b"170141183460469231731687303715884105728i128"),
    "0:43:W:I128:0:0;43:43:e;0:43:!:E0211;",
  );
  assert_eq(
    dump(b"0x1FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFu128"),
    "0:39:W:U128:0:0;39:39:e;0:39:!:E0211;",
  )
}

test "a comment runs to the end of its line" {
  assert_eq(dump(b"1 // two\n3"), "0:1:n:1;9:10:n:3;10:10:e;")
}

test "the end-of-file token sits at the end of the input" {
  assert_eq(dump(b"abc"), "0:3:i:abc;3:3:e;")
}

test "a comment is recorded from its slashes to the end of its line, and none is a token" {
  let lx = lex(b"1 // two\n3 // x");
  assert_eq(lx.tokens.len(), 3);
  assert_eq(lx.comments, [{ start: 2, end: 8 }, { start: 11, end: 15 }]);
  assert_eq(lex(b"\"//\"").comments, [])
}

test "a character literal is its one character's scalar value" {
  assert_eq(dump(b"'a'"), "0:3:c:97;3:3:e;");
  assert_eq(dump(b"'\xc3\xa9'"), "0:4:c:233;4:4:e;");
  assert_eq(
    dump(b"'\\n' '\\'' '\\\"' '\\u{1F600}'"),
    "0:4:c:10;5:9:c:39;10:14:c:34;15:26:c:128512;26:26:e;",
  )
}

test "a character literal holds exactly one character" {
  assert_eq(dump(b"''"), "0:2:c:0;2:2:e;0:2:!:E0001;");
  assert_eq(dump(b"'ab'"), "0:4:c:97;4:4:e;0:4:!:E0001;");
  assert_eq(dump(b"'a"), "0:2:c:97;2:2:e;0:2:!:E0002;")
}

test "a byte literal is the Int its one byte is, with a byte string's escapes" {
  assert_eq(dump(b"b'a'"), "0:4:n:97;4:4:e;");
  assert_eq(dump(b"b'{' b'\"' b' '"), "0:4:n:123;5:9:n:34;10:14:n:32;14:14:e;");
  assert_eq(
    dump(b"b'\\n' b'\\'' b'\\\"' b'\\\\' b'\\0' b'\\x1f' b'\\xFF'"),
    "0:5:n:10;6:11:n:39;12:17:n:34;18:23:n:92;24:29:n:0;30:37:n:31;38:45:n:255;45:45:e;",
  )
}

test "a name that ends in b before a quote is a name and a character" {
  assert_eq(dump(b"ab 'c'"), "0:2:i:ab;3:6:c:99;6:6:e;");
  assert_eq(dump(b"b 'c'"), "0:1:i:b;2:5:c:99;5:5:e;")
}

test "a byte literal holds exactly one ASCII byte" {
  assert_eq(dump(b"b''"), "0:3:n:0;3:3:e;0:3:!:E0001;");
  assert_eq(dump(b"b'ab'"), "0:5:n:97;5:5:e;0:5:!:E0001;");
  assert_eq(dump(b"b'a"), "0:3:n:97;3:3:e;0:3:!:E0002;");
  assert_eq(dump(b"b'\xc3\xa9'"), "0:5:n:0;5:5:e;2:4:!:E0001;");
  assert_eq(dump(b"b'\\u{e9}'"), "0:9:n:0;9:9:e;2:8:!:E0001;");
  assert_eq(dump(b"b'\\x1'"), "0:6:n:0;6:6:e;2:5:!:E0001;");
  assert_eq(dump(b"b'\\q'"), "0:5:n:0;5:5:e;2:4:!:E0001;")
}

test "an arithmetic operator with a `%` or a `|` touching it is one token" {
  assert_eq(
    dump(b"a +% b -% c *% d"),
    "0:1:i:a;2:4:p:+%;5:6:i:b;7:9:p:-%;10:11:i:c;12:14:p:*%;15:16:i:d;16:16:e;",
  );
  assert_eq(
    dump(b"a +| b -| c *| d"),
    "0:1:i:a;2:4:p:+|;5:6:i:b;7:9:p:-|;10:11:i:c;12:14:p:*|;15:16:i:d;16:16:e;",
  );
  assert_eq(dump(b"a ++ b"), "0:1:i:a;2:4:p:++;5:6:i:b;6:6:e;");
  assert_eq(dump(b"a -> b"), "0:1:i:a;2:4:p:->;5:6:i:b;6:6:e;")
}

test "a `|` or a `%` apart from the operator before it is its own token" {
  assert_eq(dump(b"a + |x| x"), "0:1:i:a;2:3:p:+;4:5:p:|;5:6:i:x;6:7:p:|;8:9:i:x;9:9:e;");
  assert_eq(dump(b"-1 | -2"), "0:1:p:-;1:2:n:1;3:4:p:|;5:6:p:-;6:7:n:2;7:7:e;");
  assert_eq(dump(b"-1|-2"), "0:1:p:-;1:2:n:1;2:3:p:|;3:4:p:-;4:5:n:2;5:5:e;");
  assert_eq(dump(b"a * b % c"), "0:1:i:a;2:3:p:*;4:5:i:b;6:7:p:%;8:9:i:c;9:9:e;");
  assert_eq(dump(b"<a | e>"), "0:1:p:<;1:2:i:a;3:4:p:|;5:6:i:e;6:7:p:>;7:7:e;")
}

test "`..=` is one token, and `..` before anything else is its own" {
  assert_eq(dump(b"0..=9"), "0:1:n:0;1:4:p:..=;4:5:n:9;5:5:e;");
  assert_eq(dump(b"[a, ..]"), "0:1:p:[;1:2:i:a;2:3:p:,;4:6:p:..;6:7:p:];7:7:e;")
}

test "an interpolated string is its text pieces around the tokens of each hole" {
  assert_eq(dump(b"f\"a {x} b\""), "0:5:F:6120;5:6:i:x;6:10:T:2062;10:10:e;");
  assert_eq(dump(b"f\"{a}-{b}\""), "0:3:F:;3:4:i:a;4:7:M:2d;7:8:i:b;8:10:T:;10:10:e;");
  assert_eq(dump(b"f\"\\n{x}\""), "0:5:F:0a;5:6:i:x;6:8:T:;8:8:e;")
}

test "an interpolated string with no hole is a string, its doubled braces single" {
  assert_eq(dump(b"f\"plain {{x}}\""), "0:14:s:706c61696e207b787d;14:14:e;")
}

test "a brace inside a hole nests, and only the one that balances the hole closes it" {
  assert_eq(dump(b"f\"{ {1} }\""), "0:3:F:;4:5:p:{;5:6:n:1;6:7:p:};8:10:T:;10:10:e;");
  assert_eq(dump(b"f\"{f\"{x}\"}\""), "0:3:F:;3:6:F:;6:7:i:x;7:9:T:;9:11:T:;11:11:e;");
  assert_eq(dump(b"f\"{#{}}\""), "0:3:F:;3:5:p:#{;5:6:p:};6:8:T:;8:8:e;")
}

test "a string touching a name has holes, and one a space apart or after a keyword has none" {
  assert_eq(dump(b"sh\"a {x} b\""), "0:2:i:sh;2:6:F:6120;6:7:i:x;7:11:T:2062;11:11:e;");
  assert_eq(dump(b"sh\"a {{x}}\""), "0:2:i:sh;2:11:s:61207b787d;11:11:e;");
  assert_eq(dump(b"sh \"a {x}\""), "0:2:i:sh;3:10:s:61207b787d;10:10:e;");
  assert_eq(dump(b"if\"a {x}\""), "0:2:k:if;2:9:s:61207b787d;9:9:e;");
  assert_eq(dump(b"1\"{x}\""), "0:1:n:1;1:6:s:7b787d;6:6:e;")
}

test "a label's hole holds a tagged literal's holes and the strings inside them" {
  assert_eq(
    dump(b"test \"{sh\"{f(\"}\")}\"}\" for"),
    "0:4:k:test;5:7:F:;7:9:i:sh;9:11:F:;11:12:i:f;12:13:p:(;13:16:s:7d;16:17:p:);17:19:T:;19:21:T:;22:25:i:for;25:25:e;",
  )
}

test "a lone closing brace and a hole never closed are reported" {
  assert_eq(dump(b"f\"a}b\""), "0:6:s:6162;6:6:e;3:4:!:E0001;");
  assert_eq(dump(b"f\"{x"), "0:3:F:;3:4:i:x;4:4:e;4:4:!:E0002;")
}

test "a test's label is a template before `for`, and a string before anything else" {
  assert_eq(
    dump(b"test \"a {x}\" for"),
    "0:4:k:test;5:9:F:6120;9:10:i:x;10:12:T:;13:16:i:for;16:16:e;",
  );
  assert_eq(dump(b"test \"a {x}\" {"), "0:4:k:test;5:12:s:61207b787d;13:14:p:{;14:14:e;");
  // A name that only begins with `for` ranges over nothing.
  assert_eq(dump(b"test \"a {x}\" form"), "0:4:k:test;5:12:s:61207b787d;13:17:i:form;17:17:e;");
  // Any other string keeps its braces, whatever follows it.
  assert_eq(
    dump(b"f(\"a {x}\") for"),
    "0:1:i:f;1:2:p:(;2:9:s:61207b787d;9:10:p:);11:14:i:for;14:14:e;",
  )
}

test "a template's doubled braces are single, and a hole holds strings and braces of its own" {
  assert_eq(dump(b"test \"a {{b}}\" for"), "0:4:k:test;5:14:s:61207b627d;15:18:i:for;18:18:e;");
  assert_eq(dump(b"test \"a {{b}}\" {"), "0:4:k:test;5:14:s:61207b7b627d7d;15:16:p:{;16:16:e;");
  assert_eq(
    dump(b"test/nondet \"{f(\"}\")}\" for"),
    "0:4:k:test;4:5:p:/;5:11:k:nondet;12:14:F:;14:15:i:f;15:16:p:(;16:19:s:7d;19:20:p:);20:22:T:;23:26:i:for;26:26:e;",
  )
}

test "a string's \\u escape writes its character as UTF-8" {
  assert_eq(dump(b"\"\\u{e9}\\u{1F600}\""), "0:17:s:c3a9f09f9880;17:17:e;");
  assert_eq(dump(b"\"\\'\""), "0:4:s:27;4:4:e;")
}

test "a \\u escape that names no character is refused" {
  assert_eq(dump(b"\"\\u{D800}\""), "0:10:s:;10:10:e;1:9:!:E0211;");
  assert_eq(dump(b"\"\\u{110000}\""), "0:12:s:;12:12:e;1:11:!:E0211;");
  assert_eq(dump(b"\"\\u{}\""), "0:6:s:;6:6:e;1:5:!:E0001;");
  assert_eq(dump(b"\"\\u41\""), "0:6:s:3431;6:6:e;1:3:!:E0001;")
}

test "a byte string refuses a \\u escape and keeps what follows it" {
  assert_eq(dump(b"b\"\\u{41}z\""), "0:10:b:7a;10:10:e;2:8:!:E0001;")
}

test "a map and a set literal open with their own two-character tokens" {
  assert_eq(dump(b"#{#[#"), "0:2:p:#{;2:4:p:#[;5:5:e;4:5:!:E0001;")
}

test "an identifier is ASCII: a letter outside it is refused, not lexed" {
  assert_eq(
    dump(Bytes::of_string("let \u{e9} = 1\n")),
    "0:3:k:let;7:8:p:=;9:10:n:1;11:11:e;4:6:!:X0001;",
  )
}

test "a space outside ASCII is refused" {
  assert_eq(dump(Bytes::of_string("a\u{a0}b\n")), "0:1:i:a;3:4:i:b;5:5:e;1:3:!:X0001;")
}

test "a symbol outside ASCII is refused with no token" {
  assert_eq(dump(Bytes::of_string("a \u{20ac} b\n")), "0:1:i:a;6:7:i:b;8:8:e;2:5:!:X0001;");
  assert_eq(dump(Bytes::of_string("a \u{2014} b\n")), "0:1:i:a;6:7:i:b;8:8:e;2:5:!:X0001;")
}

test "a source that is not UTF-8 is read up to where it stops being, and refused there" {
  assert_eq(dump(b"a \xe2\x82"), "0:1:i:a;2:2:e;2:3:!:X0001;");
  assert_eq(dump(b"\x91"), "0:0:e;0:1:!:X0001;");
  assert_eq(dump(b"x = '\xf0\x9f' y"), "0:1:i:x;2:3:p:=;4:5:c:0;5:5:e;4:5:!:E0002;5:6:!:X0001;")
}

test "a backslash before a character outside ASCII is a bad escape" {
  assert_eq(dump(Bytes::of_string("\"a\\\u{e9}b\"\n")), "0:7:s:61c3a962;8:8:e;2:5:!:E0001;")
}

test "a character outside ASCII inside a byte literal is refused" {
  assert_eq(dump(Bytes::of_string("b\"a\u{e9}b\"\n")), "0:7:b:6162;8:8:e;3:5:!:E0001;")
}

test "a character outside ASCII inside a string is its contents" {
  assert_eq(dump(Bytes::of_string("\"caf\u{e9}\"\n")), "0:7:s:636166c3a9;8:8:e;")
}

test "a character outside ASCII inside a comment is trivia" {
  assert_eq(dump(Bytes::of_string("// caf\u{e9}\n1\n")), "9:10:n:1;11:11:e;")
}

test "`///` marks a declaration's doc and `//!` its module's, and `////` and `//` are plain" {
  let src = b"/// a\n//! b\n//// c\n// d\n///e  \n";
  let cs = lex(src).comments;
  assert_eq(cs.map(|c: Comment| doc_mark(src, c)), [
    Some(ItemDoc),
    Some(ModuleDoc),
    None,
    None,
    Some(ItemDoc),
  ]);
  assert_eq([0, 1, 4].map(|i: Int| doc_line(src, cs.at_or(i, { start: 0, end: 0 }))), [
    b"a",
    b"b",
    b"e",
  ])
}

test "every punctuation, and every keyword, lexes back to itself" {
  let wrong = puncts().filter(|row: { of: Punct, text: Bytes }|
    match lex(row.text).tokens { [token, _] -> token.kind != Punctuation(row.of), _ -> true });
  assert_eq(wrong.map(|row: { of: Punct, text: Bytes }| row.text), []);
  let every_keyword = [
    Fn,
    If,
    Pub,
    Let,
    Type,
    Test,
    Else,
    With,
    True,
    Match,
    False,
    Import,
    Effect,
    Nondet,
    Handle,
  ];
  let wrong_word = every_keyword.filter(|keyword: Keyword|
    keyword_of(keyword_name(keyword)) != Some(keyword)
      || (match lex(keyword_name(keyword)).tokens {
        [token, _] -> token.kind != Keyword(keyword),
        _ -> true,
      }));
  assert_eq(wrong_word.map(|keyword: Keyword| keyword_name(keyword)), [])
}

fn covers(src: Bytes) -> Bool / {abort.raise} = {
  let tokens = lex(src).tokens;
  let len = src.len();
  let spelled = |token: Token|
    match token.kind {
      Keyword(keyword) -> keyword_name(keyword) == src.slice(token.start, token.end),
      Punctuation(punct) -> punct_text(punct) == src.slice(token.start, token.end),
      EndOfInput -> token.start == token.end,
      _ -> token.start < token.end,
    };
  let in_order = tokens.fold(true, |ok: Bool, token: Token|
    ok && 0 <= token.start && token.end <= len && spelled(token));
  let apart = range(1, tokens.len()).fold(true, |ok: Bool, i: Int|
    match tokens.at(i - 1) {
      Some(before) ->
        ok && (match tokens.at(i) { Some(token) -> before.end <= token.start, None -> true }),
      None -> true,
    });
  let ended = match tokens.at(tokens.len() - 1) {
    Some(last) ->
      last.kind == EndOfInput && last.start == last.end
        && (

          // A source that is not UTF-8 is read up to where it stops being, and the mark sits there.
          !src.is_utf8()
        || last.start == len),
    None -> false,
  };
  apart && in_order && ended
}

test "a lex of each of a corpus of sources covers it" {
  let srcs = [
    b"",
    b"\n\n  \t",
    b"fn f<a, b>(x: Map<a, List<b>>) -> Int = 0",
    b"a << b >> c >>> d",
    b"test \"a {x} b\" for {\n  assert_eq(1, 1)\n}",
    b"f\"{x + 1} and {y}\"",
    b"1.50m 0xFFu8 1_000 1e-3 0..=9",
    b"b\"a\\xff\" b'\\n' '\\u{1F600}' \\\\line\n",
    b"// c\n/// d\nfn g() -> Int = 1",
    b"x.f(y)[0]?.z #{} #[1, 2] a +% b -| c",
  ];
  assert_eq(range(0, srcs.len()).filter(|i: Int| !covers(srcs.at_or(i, b""))), [])
}

test "every byte alone lexes to tokens that cover it" {
  let lone = range(0, 256).filter(|i: Int| !covers(byte_of_int(i)));
  assert_eq(lone, [])
}

test "a byte-order mark and a script's first line are skipped, and the script's line is a comment" {
  assert_eq(dump(b"\xef\xbb\xbffn"), "3:5:k:fn;5:5:e;");
  assert_eq(dump(b"#!/usr/bin/env ply\nfn"), "19:21:k:fn;21:21:e;");
  let src = b"#!/usr/bin/env ply\nfn f() -> Int = 1";
  assert_eq(lex(src).comments, [{ start: 0, end: 18 }]);
  // A byte the language cannot spell is refused wherever else it stands.
  assert_eq(dump(b"a\xef\xbb\xbfb"), "0:1:i:a;4:5:i:b;5:5:e;1:4:!:X0001;")
}

test "a `_` in a number separates two digits" {
  assert_eq(dump(b"1_000"), "0:5:n:1000;5:5:e;");
  assert_eq(dump(b"1_"), "0:2:n:1;2:2:e;0:2:!:E0001;");
  assert_eq(dump(b"1__0"), "0:4:n:10;4:4:e;0:4:!:E0001;");
  assert_eq(dump(b"0x_FF"), "0:5:n:255;5:5:e;0:5:!:E0001;");
  assert_eq(dump(b"1_0.5"), "0:5:f:10.5;5:5:e;");
  assert_eq(dump(b"1e1_0"), "0:5:f:1e10;5:5:e;")
}

test "`<<`, `>>` and `>>>` are tokens, the last as `>>` and a `>`" {
  assert_eq(
    dump(b"a << b >> c >>> d"),
    "0:1:i:a;2:4:p:<<;5:6:i:b;7:9:p:>>;10:11:i:c;12:14:p:>>;14:15:p:>;16:17:i:d;17:17:e;",
  )
}

test "a label's template may hold a comment, so it may span lines" {
  assert_eq(
    dump(b"test \"a {x // }\n} b\" for { }"),
    "0:4:k:test;5:9:F:6120;9:10:i:x;16:20:T:2062;21:24:i:for;25:26:p:{;27:28:p:};28:28:e;",
  )
}
