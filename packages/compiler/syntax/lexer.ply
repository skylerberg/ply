import std.bytes (is_digit, ascii_of_int, hex_value)
import std.bytes
import std.math (pow)
import std.list
import std.string

fn all_bytes() -> Bytes =
  b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"

fn high_bytes() -> Bytes / {abort.raise} = all_bytes().slice(128, 256)

pub type TokenKind =
  | Identifier(Bytes)
  | IntLiteral(Int)
  | FixedLiteral(Bytes, Int)
  | WideLiteral(Bytes, Int, Int)
  | FloatLiteral(Bytes)
  | DecimalLiteral(Bytes, Int)
  | StringLiteral(Bytes)
  | LineString(Bytes)
  | BytesLiteral(Bytes)
  | InterpolatedHead(Bytes)
  | InterpolatedMiddle(Bytes)
  | InterpolatedTail(Bytes)
  | CharLiteral(Int)
  | Keyword(Bytes)
  | Punctuation(Bytes)
  | EndOfInput

pub type Token = { start: Int, end: Int, kind: TokenKind }

pub type Diagnostic = { start: Int, end: Int, code: Bytes, message: Bytes, label: Bytes }

pub type Comment = { start: Int, end: Int }

pub type DocMark = | ItemDoc | ModuleDoc

pub type LexResult = { tokens: List<Token>, diagnostics: List<Diagnostic>, comments: List<Comment> }

type Scanner = {
  position: Int,
  diagnostics: List<Diagnostic>,
  holes: List<Int>,
  tokens: List<Token>,
}

fn push_token(scanner: Scanner, start: Int, token_end: Int, kind: TokenKind) -> Scanner =
  {
    position: token_end,
    diagnostics: scanner.diagnostics,
    holes: scanner.holes,
    tokens: scanner.tokens.push({ start: start, end: token_end, kind: kind }),
  }

fn push_error(
  scanner: Scanner,
  start: Int,
  token_end: Int,
  code: Bytes,
  message: Bytes,
  lex_test_label: Bytes,
) -> Scanner =
  {
    position: scanner.position,
    holes: scanner.holes,
    tokens: scanner.tokens,
    diagnostics: scanner.diagnostics.push({
      start: start,
      end: token_end,
      code: code,
      message: message,
      label: lex_test_label,
    }),
  }

fn with_holes(scanner: Scanner, holes: List<Int>) -> Scanner =
  {
    position: scanner.position,
    diagnostics: scanner.diagnostics,
    holes: holes,
    tokens: scanner.tokens,
  }

fn bad_suffix(scanner: Scanner, start: Int, token_end: Int, suffix: Bytes) -> Scanner =
  push_error(
    scanner,
    start,
    token_end,
    unexpected(),
    Bytes::concat_all([b"invalid suffix `", suffix, b"` on a numeric literal"]),
    b"the suffixes are `m` for a `Decimal` and a width \xe2\x80\x94 `u8`, `i32` and the six others; separate a name with a space",
  )

fn seek(scanner: Scanner, p: Int) -> Scanner =
  { position: p, diagnostics: scanner.diagnostics, holes: scanner.holes, tokens: scanner.tokens }

fn unexpected() -> Bytes = b"E0001"

fn out_of_range() -> Bytes = b"E0211"

fn unterminated() -> Bytes = b"E0002"

fn non_ascii() -> Bytes = b"X0001"

fn whitespace() -> Bytes = b" \t\n\r\x0b\x0c"

fn identifier_chars() -> Bytes = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

fn digit_chars() -> Bytes = b"0123456789_"

pub fn is_identifier_start(c: Int) -> Bool =
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95

pub fn is_identifier_continue(c: Int) -> Bool = is_identifier_start(c) || is_digit(c)

pub fn utf8_len(c: Int) -> Int =
  if c < 128 { 1 } else if c < 224 { 2 } else if c < 240 { 3 } else { 4 }

fn skip_trivia(source: Bytes, i: Int) -> Int / {abort.raise} =
  iterate(i, source.len() - i + 2, |at: Int| {
    let j = source.skip(at, whitespace());
    if source.peek(j) == 47 && source.peek(j + 1) == 47 { Continue(source.skip_until(j, b"\n")) }
    else { Stop(j) }
  })

pub fn bound_names(tokens: List<Token>) -> Map<Bytes, Bool> = {
  let punctuation = |i: Int, p: Bytes|
    i >= 0 && (match tokens.at(i) { Some(t) -> t.kind == Punctuation(p), None -> false });
  range(0, tokens.len()).fold(Map::new(), |accumulator: Map<Bytes, Bool>, i: Int|
    match tokens.at(i) {
      Some(t) -> match t.kind {
        Identifier(n) -> if punctuation(i - 1, b"dot") || punctuation(i - 1, b"coloncolon")
            || punctuation(i + 1, b"dot") { accumulator }
        else { accumulator.insert(n, true) },
        _ -> accumulator,
      },
      None -> accumulator,
    })
}

pub fn lex(source: Bytes) -> LexResult / {abort.raise} =
  if source.is_utf8() { lex_text(source) } else {
    let cut = utf8_prefix(source);
    let read = lex_text(source.slice(0, cut));
    {
      tokens: read.tokens,
      diagnostics: read.diagnostics.push({
        start: cut,
        end: cut + 1,
        code: non_ascii(),
        message: b"the source is not UTF-8 from this byte on",
        label: b"nothing from here on is read",
      }),
      comments: read.comments,
    }
  }

fn utf8_prefix(source: Bytes) -> Int / {abort.raise} = {
  let n = source.len();
  iterate(0, n + 1, |i: Int|
    if i >= n { Stop(i) } else {
      let w = utf8_len(source.at(i));
      if i + w <= n && source.slice(i, i + w).is_utf8() { Continue(i + w) } else { Stop(i) }
    })
}

fn lex_text(source: Bytes) -> LexResult / {abort.raise} = {
  let n = source.len();
  let start = { position: 0, diagnostics: [], holes: [], tokens: [] };
  let done = iterate(start, n + 1, |scanner: Scanner|
    if scanner.position >= n { Stop(scanner) } else { Continue(next_token(source, scanner)) });
  let closed = if done.holes.len() == 0 { done } else {
    push_error(
      done,
      n,
      n,
      unterminated(),
      b"an interpolated string's `{` is never closed",
      b"close the interpolation with `}` and the string with `\"`",
    )
  };
  let with_eof = push_token(closed, n, n, EndOfInput);
  {
    diagnostics: with_eof.diagnostics,
    tokens: with_eof.tokens,
    comments: comments(source, with_eof.tokens),
  }
}

fn comments(source: Bytes, tokens: List<Token>) -> List<Comment> / {abort.raise} = {
  let walked = tokens.fold(
    { from: 0, out: [] },
    |s: { from: Int, out: List<Comment> }, token: Token|
      { from: token.end, out: read_line_comments(source, s.from, token.start, s.out) },
  );
  walked.out
}

fn read_line_comments(
  source: Bytes,
  i: Int,
  stop: Int,
  out: List<Comment>,
) -> List<Comment> / {abort.raise} =
  iterate({ at: i, out: out }, source.len() - i + 2, |s: { at: Int, out: List<Comment> }| {
    let j = source.skip(s.at, whitespace());
    if j < stop && source.peek(j) == 47 && source.peek(j + 1) == 47 {
      let token_end = source.skip_until(j, b"\n");
      Continue({ at: token_end, out: s.out.push({ start: j, end: token_end }) })
    } else { Stop(s.out) }
  })

pub fn doc_mark(source: Bytes, c: Comment) -> Option<DocMark> = {
  let third = source.peek(c.start + 2);
  if third == 47 && source.peek(c.start + 3) != 47 { Some(ItemDoc) }
  else if third == 33 { Some(ModuleDoc) }
  else { None }
}

pub fn doc_line(source: Bytes, c: Comment) -> Bytes / {abort.raise} = {
  let from = if source.peek(c.start + 3) == 32 { c.start + 4 } else { c.start + 3 };
  let to = iterate(c.end, c.end - from + 1, |i: Int|
    if i > from && (source.at(i - 1) == 32 || source.at(i - 1) == 9 || source.at(i - 1) == 13) {
      Continue(i - 1)
    } else { Stop(i) });
  source.slice(from, to)
}

fn next_token(source: Bytes, scanner: Scanner) -> Scanner / {abort.raise} = {
  let n = source.len();
  if scanner.position >= n { scanner } else {
    let start = skip_trivia(source, scanner.position);
    if start >= n { seek(scanner, n) } else { token_at(source, scanner, start) }
  }
}

fn token_at(source: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let c = source.at(start);
  if is_digit(c) { number(source, scanner, start) }
  else if c == 98 && source.peek(start + 1) == 34 { bytes_literal(source, scanner, start) }
  else if c == 98 && source.peek(start + 1) == 39 { byte_literal(source, scanner, start) }
  else if c == 102 && source.peek(start + 1) == 34 {
    interpolated_piece(source, scanner, start, start + 2, true)
  } else if is_identifier_start(c) { identifier(source, scanner, start) }
  else if c == 34 && expects_test_label(scanner.tokens) { lex_test_label(source, scanner, start) }
  else if c == 34 && touches_name(scanner.tokens, start) {
    interpolated_piece(source, scanner, start, start + 1, true)
  } else if c == 34 { string_literal(source, scanner, start) }
  else if c == 92 && source.peek(start + 1) == 92 { line_string(source, scanner, start) }
  else if c == 39 { char_literal(source, scanner, start) } else if c >= 128 {
    push_error(
      seek(scanner, start + utf8_len(c)),
      start,
      start + utf8_len(c),
      non_ascii(),
      Bytes::concat_all([
        b"unexpected character `",
        source.slice(start, start + utf8_len(c)),
        b"`",
      ]),
      b"this character has no meaning in Ply source",
    )
  } else { punctuation(source, scanner, start, c) }
}

fn identifier(source: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let token_end = source.skip(start, identifier_chars());
  let text = source.slice(start, token_end);
  if text == b"_" { push_token(scanner, start, token_end, Punctuation(b"underscore")) }
  else if is_keyword(text) { push_token(scanner, start, token_end, Keyword(text)) }
  else { push_token(scanner, start, token_end, Identifier(text)) }
}

fn is_keyword(t: Bytes) -> Bool = {
  let k = t.len();
  if k == 2 { t == b"fn" || t == b"if" }
  else if k == 3 { t == b"pub" || t == b"let" }
  else if k == 4 { t == b"type" || t == b"test" || t == b"else" || t == b"with" || t == b"true" }
  else if k == 5 { t == b"match" || t == b"false" }
  else if k == 6 { t == b"import" || t == b"effect" || t == b"nondet" || t == b"handle" }
  else { false }
}

type NumberParts = {
  start: Int,
  whole: Bytes,
  fraction: Bytes,
  has_fraction: Bool,
  exp: Bytes,
  has_exponent: Bool,
  cursor: Int,
}

fn strip_underscores(b: Bytes) -> Bytes = Bytes::concat_all(b.split(b"_"))

fn number(source: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} =
  if source.peek(start) == 48 && (source.peek(start + 1) == 120 || source.peek(start + 1) == 88) {
    hex_literal(source, scanner, start)
  } else { decimal_number(source, scanner, start) }

fn hex_literal(source: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let token_end = source.skip(start + 2, b"0123456789abcdefABCDEF_");
  let digits = strip_underscores(source.slice(start + 2, token_end));
  if digits.len() == 0 {
    push_token(
      push_error(
        scanner,
        start,
        token_end,
        unexpected(),
        b"hex literal with no digits",
        b"write at least one digit after `0x`, as in `0xFF`",
      ),
      start,
      token_end,
      IntLiteral(0),
    )
  } else {
    let sufe = if is_identifier_start(source.peek(token_end)) {
      source.skip(token_end, identifier_chars())
    } else { token_end };
    let suffix = source.slice(token_end, sufe);
    match width_named(suffix) {
      Some(w) -> hex_fixed(scanner, start, sufe, digits, w),
      None -> {
        let s1 = if sufe > token_end { bad_suffix(scanner, start, sufe, suffix) } else { scanner };
        let d = strip_zeros(digits);
        if d.len() > 16 {
          push_token(
            push_error(
              s1,
              start,
              token_end,
              unexpected(),
              Bytes::concat_all([b"hex literal `0x", digits, b"` does not fit in `Int`"]),
              b"`Int` is 64 bits, so a hex literal has at most 16 digits",
            ),
            start,
            token_end,
            IntLiteral(0),
          )
        } else { push_token(s1, start, token_end, IntLiteral(hex_of_digits(d))) }
      },
    }
  }
}

fn hex_fixed(
  scanner: Scanner,
  start: Int,
  token_end: Int,
  digits: Bytes,
  width: Width,
) -> Scanner / {abort.raise} =
  if width.bits == 128 { hex_wide(scanner, start, token_end, digits, width) }
  else { hex_64_bit(scanner, start, token_end, digits, width) }

fn hex_64_bit(
  scanner: Scanner,
  start: Int,
  token_end: Int,
  digits: Bytes,
  width: Width,
) -> Scanner / {abort.raise} = {
  let d = strip_zeros(digits);
  if d.len() > 16 || (width.bits < 64 && d.len() * 4 > width.bits && hex_overflows(d, width)) {
    push_token(
      push_error(
        scanner,
        start,
        token_end,
        out_of_range(),
        Bytes::concat_all([b"`0x", digits, b"` does not fit in `", width_type_name(width), b"`"]),
        Bytes::concat_all([
          b"a `",
          width_type_name(width),
          b"` is ",
          ascii_of_int(width.bits),
          b" bits",
        ]),
      ),
      start,
      token_end,
      FixedLiteral(width_type_name(width), 0),
    )
  } else {
    push_token(
      scanner,
      start,
      token_end,
      FixedLiteral(width_type_name(width), width_normalize(width, hex_of_digits(d))),
    )
  }
}

fn hex_wide(
  scanner: Scanner,
  start: Int,
  token_end: Int,
  digits: Bytes,
  width: Width,
) -> Scanner / {abort.raise} = {
  let d = strip_zeros(digits);
  let n = d.len();
  if n > 32 {
    push_token(
      push_error(
        scanner,
        start,
        token_end,
        out_of_range(),
        Bytes::concat_all([b"`0x", digits, b"` does not fit in `", width_type_name(width), b"`"]),
        Bytes::concat_all([b"a `", width_type_name(width), b"` is 128 bits"]),
      ),
      start,
      token_end,
      WideLiteral(width_type_name(width), 0, 0),
    )
  } else {
    let split = if n > 16 { n - 16 } else { 0 };
    push_token(
      scanner,
      start,
      token_end,
      WideLiteral(
        width_type_name(width),
        hex_of_digits(d.slice(0, split)),
        hex_of_digits(d.slice(split, n)),
      ),
    )
  }
}

fn hex_overflows(d: Bytes, width: Width) -> Bool / {abort.raise} =
  strip_zeros(d).len() * 4 > width.bits + 3 && (strip_zeros(d).len() - 1) * 4 >= width.bits

fn hex_of_digits(d: Bytes) -> Int =
  range(0, d.len()).fold(0, |a: Int, i: Int| wrap_add(wrap_mul(a, 16), hex_value(d.at(i))))

fn decimal_number(source: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let we = source.skip(start, digit_chars());
  let whole = strip_underscores(source.slice(start, we));
  let hasf = source.peek(we) == 46 && is_digit(source.peek(we + 1));
  let fe = if hasf { source.skip(we + 1, digit_chars()) } else { we };
  let frac = if hasf { strip_underscores(source.slice(we + 1, fe)) } else { b"" };
  let es = exponent_start(source, fe);
  let ee = if es < 0 { fe } else { source.skip(es, digit_chars()) };
  number_tail(source, scanner, {
    start: start,
    whole: whole,
    fraction: frac,
    has_fraction: hasf,
    exp: if es < 0 { b"" } else { exponent_text(source, fe, es, ee) },
    has_exponent: es >= 0,
    cursor: ee,
  })
}

fn exponent_start(source: Bytes, i: Int) -> Int = {
  let c = source.peek(i);
  if c != 101 && c != 69 { -1 } else {
    let d = source.peek(i + 1);
    let j = if d == 43 || d == 45 { i + 2 } else { i + 1 };
    if is_digit(source.peek(j)) { j } else { -1 }
  }
}

fn exponent_text(source: Bytes, e: Int, es: Int, ee: Int) -> Bytes / {abort.raise} =
  source.slice(e + 1, es).concat(strip_underscores(source.slice(es, ee)))

fn number_tail(source: Bytes, scanner: Scanner, parts: NumberParts) -> Scanner / {abort.raise} =
  if source.peek(parts.cursor) == 109 && !is_identifier_continue(source.peek(parts.cursor + 1)) {
    decimal(scanner, parts, parts.cursor + 1)
  } else if is_identifier_start(source.peek(parts.cursor)) {
    let token_end = source.skip(parts.cursor, identifier_chars());
    match if parts.has_fraction || parts.has_exponent { None }
      else { width_named(source.slice(parts.cursor, token_end)) } {
      Some(w) -> fixed_value(scanner, parts, token_end, w),
      None ->
        number_value(
          bad_suffix(scanner, parts.start, token_end, source.slice(parts.cursor, token_end)),
          parts,
          token_end,
        ),
    }
  } else { number_value(scanner, parts, parts.cursor) }

fn fixed_value(
  scanner: Scanner,
  parts: NumberParts,
  token_end: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  if width.bits == 128 { decimal_128_bits(scanner, parts, token_end, width) }
  else { narrow_value(scanner, parts, token_end, width) }

fn narrow_value(
  scanner: Scanner,
  parts: NumberParts,
  token_end: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  if width.bits == 64 && !width.signed { u64_value(scanner, parts, token_end, width) } else {
    let d = strip_zeros(parts.whole);
    let k = d.len();
    let too_long = k > 19 || (k == 19 && compare(d, int_max()) == Greater);
    if too_long || exceeds_width(d, width) {
      push_token(
        push_error(
          scanner,
          parts.start,
          token_end,
          out_of_range(),
          Bytes::concat_all([
            b"`",
            parts.whole,
            b"` is not a value of `",
            width_type_name(width),
            b"`",
          ]),
          Bytes::concat_all([b"`", width_type_name(width), b"` holds ", width_range(width)]),
        ),
        parts.start,
        token_end,
        FixedLiteral(width_type_name(width), 0),
      )
    } else {
      push_token(
        scanner,
        parts.start,
        token_end,
        FixedLiteral(width_type_name(width), width_normalize(width, int_of_digits(d))),
      )
    }
  }

fn u64_value(
  scanner: Scanner,
  parts: NumberParts,
  token_end: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  match limbs_of_digits(strip_zeros(parts.whole)) {
    Some(ls) -> if ls.at_or(3, 0) != 0 || ls.at_or(2, 0) != 0 {
      narrow_out_of_range(scanner, parts, token_end, width)
    } else {
      push_token(
        scanner,
        parts.start,
        token_end,
        FixedLiteral(width_type_name(width), ls.at_or(1, 0) << 32 | ls.at_or(0, 0)),
      )
    },
    None -> narrow_out_of_range(scanner, parts, token_end, width),
  }

fn narrow_out_of_range(
  scanner: Scanner,
  parts: NumberParts,
  token_end: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  push_token(
    push_error(
      scanner,
      parts.start,
      token_end,
      out_of_range(),
      Bytes::concat_all([
        b"`",
        parts.whole,
        b"` is not a value of `",
        width_type_name(width),
        b"`",
      ]),
      Bytes::concat_all([b"`", width_type_name(width), b"` holds ", width_range(width)]),
    ),
    parts.start,
    token_end,
    FixedLiteral(width_type_name(width), 0),
  )

fn decimal_128_bits(
  scanner: Scanner,
  parts: NumberParts,
  token_end: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  match limbs_of_digits(strip_zeros(parts.whole)) {
    Some(ls) -> if width.signed && ls.at_or(3, 0) >= pow(2, 31) {
      wide_out_of_range(scanner, parts, token_end, width)
    } else {
      push_token(
        scanner,
        parts.start,
        token_end,
        WideLiteral(
          width_type_name(width),
          ls.at_or(3, 0) << 32 | ls.at_or(2, 0),
          ls.at_or(1, 0) << 32 | ls.at_or(0, 0),
        ),
      )
    },
    None -> wide_out_of_range(scanner, parts, token_end, width),
  }

fn wide_out_of_range(
  scanner: Scanner,
  parts: NumberParts,
  token_end: Int,
  width: Width,
) -> Scanner / {abort.raise} =
  push_token(
    push_error(
      scanner,
      parts.start,
      token_end,
      out_of_range(),
      Bytes::concat_all([
        b"`",
        parts.whole,
        b"` is not a value of `",
        width_type_name(width),
        b"`",
      ]),
      Bytes::concat_all([b"`", width_type_name(width), b"` holds ", width_range(width)]),
    ),
    parts.start,
    token_end,
    WideLiteral(width_type_name(width), 0, 0),
  )

fn limbs_of_digits(d: Bytes) -> Option<List<Int>> =
  range(0, d.len()).fold(Some([0, 0, 0, 0]), |accumulator: Option<List<Int>>, i: Int|
    match accumulator { None -> None, Some(ls) -> times_ten_plus(ls, d.at(i) - 48) })

fn times_ten_plus(ls: List<Int>, digit: Int) -> Option<List<Int>> = {
  let step = ls.fold(
    { widths: digit, out: [] },
    |accumulator: { widths: Int, out: List<Int> }, l: Int| {
      let v = l * 10 + accumulator.widths;
      { widths: v >>> 32, out: accumulator.out.push(v & 0xFFFF_FFFF) }
    },
  );
  if step.widths == 0 { Some(step.out) } else { None }
}

pub fn wide_decimal(signed: Bool, high: Int, low: Int) -> Bytes =
  if signed && high < 0 {
    b"-".concat(
      limbs_decimal(high_first(if low == 0 { wrap_sub(0, high) } else { ~high }, wrap_sub(0, low))),
    )
  } else { limbs_decimal(high_first(high, low)) }

fn high_first(high: Int, low: Int) -> List<Int> =
  [high >>> 32, high & 0xFFFF_FFFF, low >>> 32, low & 0xFFFF_FFFF]

fn limbs_decimal(ls: List<Int>) -> Bytes = {
  let done = range(0, 39).fold(
    { limbs: ls, digits: b"", zero: false },
    |s: { limbs: List<Int>, digits: Bytes, zero: Bool }, i: Int|
      if s.zero { s } else {
        let step = s.limbs.fold({ rem: 0, out: [] }, |a: { rem: Int, out: List<Int> }, l: Int| {
          let dividend = a.rem << 32 | l;
          { rem: dividend % 10, out: a.out.push(dividend / 10) }
        });
        {
          limbs: step.out,
          digits: ascii_of_int(step.rem).concat(s.digits),
          zero: step.out.fold(true, |z: Bool, l: Int| z && l == 0),
        }
      },
  );
  done.digits
}

fn exceeds_width(d: Bytes, width: Width) -> Bool =
  if width.bits == 64 { false } else { int_of_digits(d) > width_max(width) }

fn width_range(width: Width) -> Bytes =
  if width.bits == 128 {
    if width.signed {
      b"-170141183460469231731687303715884105728 to 170141183460469231731687303715884105727"
    } else { b"0 to 340282366920938463463374607431768211455" }
  } else if width.bits == 64 {
    if width.signed { b"-9223372036854775808 to 9223372036854775807" }
    else { b"0 to 18446744073709551615" }
  } else if width.signed {
    Bytes::concat_all([
      b"-",
      ascii_of_int(pow(2, width.bits - 1)),
      b" to ",
      ascii_of_int(width_max(width)),
    ])
  } else { Bytes::concat_all([b"0 to ", ascii_of_int(width_max(width))]) }

fn number_value(scanner: Scanner, parts: NumberParts, token_end: Int) -> Scanner / {abort.raise} =
  if !parts.has_fraction && !parts.has_exponent { int_value(scanner, parts, token_end) }
  else { push_token(scanner, parts.start, token_end, FloatLiteral(float_text(parts))) }

fn float_text(parts: NumberParts) -> Bytes =
  Bytes::concat_all([
    parts.whole,
    if parts.has_fraction { b"." } else { b"" },
    if parts.has_fraction { parts.fraction } else { b"" },
    if parts.has_exponent { b"e" } else { b"" },
    if parts.has_exponent { parts.exp } else { b"" },
  ])

fn int_max() -> Bytes = b"9223372036854775807"

fn strip_zeros(b: Bytes) -> Bytes / {abort.raise} = {
  let k = b.skip(0, b"0");
  if k >= b.len() { b"0" } else { b.slice(k, b.len()) }
}

fn int_value(scanner: Scanner, parts: NumberParts, token_end: Int) -> Scanner / {abort.raise} = {
  let d = strip_zeros(parts.whole);
  let k = d.len();
  if k > 19 || (k == 19 && compare(d, int_max()) == Greater) {
    push_token(
      push_error(
        scanner,
        parts.start,
        token_end,
        unexpected(),
        Bytes::concat_all([b"integer literal `", parts.whole, b"` does not fit in `Int`"]),
        b"`Int` is a 64-bit signed integer; use a smaller value",
      ),
      parts.start,
      token_end,
      IntLiteral(0),
    )
  } else { push_token(scanner, parts.start, token_end, IntLiteral(int_of_digits(d))) }
}

pub fn int_of_digits(d: Bytes) -> Int =
  range(0, d.len()).fold(0, |a: Int, i: Int| a * 10 + (d.at(i) - 48))

pub type Width = { name: Bytes, bits: Int, signed: Bool }

pub fn widths() -> List<Width> =
  [
    { name: b"u8", bits: 8, signed: false },
    { name: b"u16", bits: 16, signed: false },
    { name: b"u32", bits: 32, signed: false },
    { name: b"u64", bits: 64, signed: false },
    { name: b"i8", bits: 8, signed: true },
    { name: b"i16", bits: 16, signed: true },
    { name: b"i32", bits: 32, signed: true },
    { name: b"i64", bits: 64, signed: true },
    { name: b"u128", bits: 128, signed: false },
    { name: b"i128", bits: 128, signed: true },
  ]

pub fn width_named(suffix: Bytes) -> Option<Width> =
  widths().fold(None, |found: Option<Width>, width: Width|
    match found { Some(_) -> found, None -> if width.name == suffix { Some(width) } else { None } })

fn width_type_name(width: Width) -> Bytes / {abort.raise} =
  Bytes::of_string(String::of_bytes(width.name).ascii_upper())

fn width_max(width: Width) -> Int =
  if width.signed { pow(2, width.bits - 1) - 1 } else { pow(2, width.bits) - 1 }

pub fn width_normalize(width: Width, v: Int) -> Int =
  if width.bits >= 64 { v } else {
    let low = v & pow(2, width.bits) - 1;
    if width.signed && low >>> width.bits - 1 == 1 { low | 0 - pow(2, width.bits) } else { low }
  }

fn decimal_max() -> Bytes = b"79228162514264337593543950335"

fn zero_decimal() -> TokenKind = DecimalLiteral(b"0", 0)

fn decimal(scanner: Scanner, parts: NumberParts, token_end: Int) -> Scanner / {abort.raise} =
  if parts.has_exponent {
    push_token(
      push_error(
        scanner,
        parts.start,
        token_end,
        unexpected(),
        b"a `Decimal` literal has no exponent",
        b"write the digits out, or drop the `m` for a `Float`",
      ),
      parts.start,
      token_end,
      zero_decimal(),
    )
  } else if parts.fraction.len() > 28 {
    push_token(
      push_error(
        scanner,
        parts.start,
        token_end,
        unexpected(),
        Bytes::concat_all([
          b"a `Decimal` literal has at most 28 decimal places, not ",
          ascii_of_int(parts.fraction.len()),
        ]),
        b"round the literal, or use `Float`",
      ),
      parts.start,
      token_end,
      zero_decimal(),
    )
  } else {
    let d = strip_zeros(parts.whole.concat(parts.fraction));
    let k = d.len();
    if k > 29 || (k == 29 && compare(d, decimal_max()) == Greater) {
      push_token(
        push_error(
          scanner,
          parts.start,
          token_end,
          unexpected(),
          b"a `Decimal` literal must fit in 96 bits",
          b"the largest is 79228162514264337593543950335",
        ),
        parts.start,
        token_end,
        zero_decimal(),
      )
    } else { push_token(scanner, parts.start, token_end, DecimalLiteral(d, parts.fraction.len())) }
  }

fn string_stops() -> Bytes = b"\"\\\n"

fn string_literal(source: Bytes, scanner: Scanner, open: Int) -> Scanner / {abort.raise} =
  iterate(
    { scanner: scanner, i: open + 1, accumulator: b"" },
    source.len() - open + 2,
    |at: TextScan| string_run(source, open, at),
  )

fn string_run(source: Bytes, open: Int, at: TextScan) -> Iter<TextScan, Scanner> / {abort.raise} = {
  let stop = source.skip_until(at.i, string_stops());
  let so_far = at.accumulator.concat(source.slice(at.i, stop));
  let c = source.peek(stop);
  if c < 0 || c == 10 {
    Stop(
      push_token(
        push_error(
          at.scanner,
          open,
          stop,
          unterminated(),
          b"unterminated string literal",
          b"add a closing `\"`; a string may not span a line break",
        ),
        open,
        stop,
        StringLiteral(so_far),
      ),
    )
  } else if c == 34 { Stop(push_token(at.scanner, open, stop + 1, StringLiteral(so_far))) }
  else { string_escape(source, at.scanner, open, stop, so_far) }
}

fn unknown_escape(
  source: Bytes,
  scanner: Scanner,
  stop: Int,
  w: Int,
  valid: Bytes,
) -> Scanner / {abort.raise} =
  push_error(
    scanner,
    stop,
    stop + 1 + w,
    unexpected(),
    Bytes::concat_all([b"unknown escape sequence `\\", source.slice(stop + 1, stop + 1 + w), b"`"]),
    valid,
  )

fn string_escape(
  source: Bytes,
  scanner: Scanner,
  open: Int,
  stop: Int,
  so_far: Bytes,
) -> Iter<TextScan, Scanner> / {abort.raise} = {
  let n = source.len();
  if source.peek(stop + 1) < 0 {
    Stop(
      push_token(
        push_error(
          scanner,
          open,
          n,
          unterminated(),
          b"unterminated string literal",
          b"add a closing `\"`",
        ),
        open,
        n,
        StringLiteral(so_far),
      ),
    )
  } else {
    let e = text_escape(source, scanner, stop);
    Continue({ scanner: e.s, i: e.next, accumulator: so_far.concat(e.text) })
  }
}

fn text_escape(
  source: Bytes,
  scanner: Scanner,
  stop: Int,
) -> { s: Scanner, text: Bytes, next: Int } / {abort.raise} = {
  let c = source.peek(stop + 1);
  if c == 110 { { s: scanner, text: b"\n", next: stop + 2 } }
  else if c == 116 { { s: scanner, text: b"\t", next: stop + 2 } }
  else if c == 114 { { s: scanner, text: b"\r", next: stop + 2 } }
  else if c == 48 { { s: scanner, text: b"\x00", next: stop + 2 } }
  else if c == 92 { { s: scanner, text: b"\\", next: stop + 2 } }
  else if c == 34 { { s: scanner, text: b"\"", next: stop + 2 } }
  else if c == 39 { { s: scanner, text: b"'", next: stop + 2 } } else if c == 117 {
    let u = unicode_escape(source, stop);
    if u.point < 0 { { s: push_escape_error(scanner, stop, u), text: b"", next: u.end } }
    else { { s: scanner, text: utf8_of(u.point), next: u.end } }
  } else {
    let w = utf8_len(c);
    {
      s: unknown_escape(source, scanner, stop, w, valid_escapes()),
      text: source.slice(stop + 1, stop + 1 + w),
      next: stop + 1 + w,
    }
  }
}

fn interpolated_stops() -> Bytes = b"\"\\\n{}"

fn interpolated_piece(
  source: Bytes,
  scanner: Scanner,
  open: Int,
  i: Int,
  head: Bool,
) -> Scanner / {abort.raise} =
  iterate({ scanner: scanner, i: i, accumulator: b"" }, source.len() - i + 2, |at: TextScan|
    interpolated_run(source, open, head, at))

fn interpolated_run(
  source: Bytes,
  open: Int,
  head: Bool,
  at: TextScan,
) -> Iter<TextScan, Scanner> / {abort.raise} = {
  let n = source.len();
  let stop = source.skip_until(at.i, interpolated_stops());
  let so_far = at.accumulator.concat(source.slice(at.i, stop));
  let c = source.peek(stop);
  let last = if head { StringLiteral(so_far) } else { InterpolatedTail(so_far) };
  if c < 0 || c == 10 || (c == 92 && source.peek(stop + 1) < 0) {
    Stop(
      push_token(
        push_error(
          at.scanner,
          open,
          if c == 92 { n } else { stop },
          unterminated(),
          b"unterminated string literal",
          b"add a closing `\"`; a string may not span a line break",
        ),
        open,
        if c == 92 { n } else { stop },
        last,
      ),
    )
  } else if c == 34 { Stop(push_token(at.scanner, open, stop + 1, last)) } else if c == 92 {
    let e = text_escape(source, at.scanner, stop);
    Continue({ scanner: e.s, i: e.next, accumulator: so_far.concat(e.text) })
  } else if source.peek(stop + 1) == c {
    Continue({
      scanner: at.scanner,
      i: stop + 2,
      accumulator: so_far.concat(source.slice(stop, stop + 1)),
    })
  } else if c == 123 {
    let t = if head { InterpolatedHead(so_far) } else { InterpolatedMiddle(so_far) };
    Stop(push_token(with_holes(at.scanner, at.scanner.holes.push(0)), open, stop + 1, t))
  } else {
    Continue({
      scanner: push_error(
        at.scanner,
        stop,
        stop + 1,
        unexpected(),
        b"a lone `}` in an interpolated string",
        b"write `}}` for a brace in the text",
      ),
      i: stop + 1,
      accumulator: so_far,
    })
  }
}

fn keyword_back(tokens: List<Token>, back: Int, word: Bytes) -> Bool =
  match tokens.at(tokens.len() - back) {
    Some(t) -> match t.kind { Keyword(k) -> k == word, _ -> false },
    None -> false,
  }

fn expects_test_label(tokens: List<Token>) -> Bool =
  keyword_back(tokens, 1, b"test")
    || (keyword_back(tokens, 1, b"nondet") && keyword_back(tokens, 3, b"test")
    && (match tokens.at(tokens.len() - 2) {
      Some(t) -> t.kind == Punctuation(b"slash"),
      None -> false,
    }))

fn touches_name(tokens: List<Token>, start: Int) -> Bool =
  match tokens.at(tokens.len() - 1) {
    Some(t) -> t.end == start && (match t.kind { Identifier(_) -> true, _ -> false }),
    None -> false,
  }

pub fn follows_name(source: Bytes, i: Int) -> Bool / {abort.raise} = {
  let from = iterate(i, i + 1, |j: Int|
    if is_identifier_continue(source.peek(j - 1)) { Continue(j - 1) } else { Stop(j) });
  let word = source.slice(from, i);
  from < i && is_identifier_start(source.at(from)) && word != b"b" && word != b"_"
    && !is_keyword(word)
}

fn followed_by_for(source: Bytes, i: Int) -> Bool / {abort.raise} = {
  let j = skip_trivia(source, i);
  source.peek(j) == 102 && source.peek(j + 1) == 111 && source.peek(j + 2) == 114
    && !is_identifier_continue(source.peek(j + 3))
}

type TemplateScan = { i: Int, open: List<Int> }

fn char_end(source: Bytes, i: Int) -> Int / {abort.raise} =
  source.skip_until(if source.peek(i + 1) == 92 { i + 3 } else { i + 2 }, b"'\n") + 1

fn template_end(source: Bytes, start: Int) -> Option<Int> / {abort.raise} = {
  let line = source.skip_until(start, b"\n");
  iterate({ i: start + 1, open: [-1] }, line - start + 2, |s: TemplateScan| {
    let c = source.peek(s.i);
    let top = match s.open.at(s.open.len() - 1) { Some(k) -> k, None -> -1 };
    let rest = s.open.drop_last(1);
    if s.i >= line { Stop(None) } else if top < 0 {
      if c == 92 { Continue({ i: s.i + 2, open: s.open }) } else if c == 34 {
        if rest.len() == 0 { Stop(Some(s.i + 1)) } else { Continue({ i: s.i + 1, open: rest }) }
      } else if top == -1 && c == 123 && source.peek(s.i + 1) == 123 {
        Continue({ i: s.i + 2, open: s.open })
      } else if top == -1 && c == 123 { Continue({ i: s.i + 1, open: s.open.push(0) }) }
      else { Continue({ i: s.i + 1, open: s.open }) }
    } else if c == 34 {
      Continue({ i: s.i + 1, open: s.open.push(if follows_name(source, s.i) { -1 } else { -2 }) })
    } else if c == 102 && source.peek(s.i + 1) == 34
        && !is_identifier_continue(source.peek(s.i - 1)) {
      Continue({ i: s.i + 2, open: s.open.push(-1) })
    } else if c == 39 { Continue({ i: char_end(source, s.i), open: s.open }) }
    else if c == 123 { Continue({ i: s.i + 1, open: rest.push(top + 1) }) } else if c == 125 {
      Continue({ i: s.i + 1, open: if top == 0 { rest } else { rest.push(top - 1) } })
    } else { Continue({ i: s.i + 1, open: s.open }) }
  })
}

fn lex_test_label(source: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let templated = match template_end(source, start) {
    Some(token_end) -> followed_by_for(source, token_end),
    None -> false,
  };
  if templated { interpolated_piece(source, scanner, start, start + 1, true) }
  else { string_literal(source, scanner, start) }
}

fn adjust_hole_braces(scanner: Scanner, d: Int) -> Scanner =
  match scanner.holes.at(scanner.holes.len() - 1) {
    None -> scanner,
    Some(k) -> with_holes(scanner, scanner.holes.drop_last(1).push(k + d)),
  }

fn closes_interpolation(scanner: Scanner) -> Bool =
  match scanner.holes.at(scanner.holes.len() - 1) { Some(k) -> k == 0, None -> false }

fn valid_escapes() -> Bytes = b"valid escapes are \\n \\t \\r \\0 \\\\ \\\" \\' and \\u{...}"

type Escape = { point: Int, end: Int, code: Bytes, message: Bytes, label: Bytes }

fn valid_escape(point: Int, end: Int) -> Escape =
  { point: point, end: end, code: b"", message: b"", label: b"" }

fn bad_escape(end: Int, code: Bytes, message: Bytes, lex_test_label: Bytes) -> Escape =
  { point: -1, end: end, code: code, message: message, label: lex_test_label }

fn push_escape_error(scanner: Scanner, at_backslash: Int, escape: Escape) -> Scanner =
  push_error(scanner, at_backslash, escape.end, escape.code, escape.message, escape.label)

fn hex_chars() -> Bytes = b"0123456789abcdefABCDEF"

fn unicode_escape(source: Bytes, i: Int) -> Escape / {abort.raise} =
  if source.peek(i + 2) != 123 {
    bad_escape(
      i + 2,
      unexpected(),
      b"`\\u` takes its character's hex digits in braces",
      b"write it as `\\u{1F600}`",
    )
  } else {
    let first = i + 3;
    let stop = source.skip(first, hex_chars());
    let closed = source.peek(stop) == 125;
    if stop == first || stop - first > 6 || !closed {
      bad_escape(
        if closed { stop + 1 } else { stop },
        unexpected(),
        b"`\\u{...}` holds one to six hex digits and a closing `}`",
        b"as in `\\u{e9}` or `\\u{1F600}`",
      )
    } else {
      let v = range(first, stop).fold(0, |accumulator: Int, k: Int|
        accumulator * 16 + hex_value(source.peek(k)));
      if v > 1114111 || (v >= 55296 && v <= 57343) {
        bad_escape(
          stop + 1,
          out_of_range(),
          b"`\\u{...}` names no character",
          b"a surrogate, `D800` to `DFFF`, or a value past `10FFFF` is not a Unicode scalar value",
        )
      } else { valid_escape(v, stop + 1) }
    }
  }

fn letter_escape(c: Int) -> Int =
  if c == 110 { 10 }
  else if c == 116 { 9 }
  else if c == 114 { 13 }
  else if c == 48 { 0 }
  else if c == 92 || c == 39 || c == 34 { c }
  else { 0 - 1 }

fn char_escape(source: Bytes, i: Int) -> Escape / {abort.raise} = {
  let c = source.peek(i + 1);
  if letter_escape(c) >= 0 { valid_escape(letter_escape(c), i + 2) }
  else if c == 117 { unicode_escape(source, i) } else if c < 0 || c == 10 {
    bad_escape(i + 1, unterminated(), b"unterminated character literal", b"add a closing `'`")
  } else {
    let w = utf8_len(c);
    bad_escape(
      i + 1 + w,
      unexpected(),
      Bytes::concat_all([b"unknown escape sequence `\\", source.slice(i + 1, i + 1 + w), b"`"]),
      valid_escapes(),
    )
  }
}

pub fn utf8_of(v: Int) -> Bytes / {abort.raise} =
  if v < 128 { byte_of_int(v) }
  else if v < 2048 { byte_of_int(192 | v >> 6).concat(byte_of_int(128 | v & 63)) }
  else if v < 65536 {
    Bytes::concat_all([
      byte_of_int(224 | v >> 12),
      byte_of_int(128 | v >> 6 & 63),
      byte_of_int(128 | v & 63),
    ])
  } else {
    Bytes::concat_all([
      byte_of_int(240 | v >> 18),
      byte_of_int(128 | v >> 12 & 63),
      byte_of_int(128 | v >> 6 & 63),
      byte_of_int(128 | v & 63),
    ])
  }

fn utf8_code_point(source: Bytes, i: Int, w: Int) -> Int =
  if w == 1 { source.peek(i) }
  else if w == 2 { (source.peek(i) & 31) << 6 | source.peek(i + 1) & 63 } else if w == 3 {
    (source.peek(i) & 15) << 12 | (source.peek(i + 1) & 63) << 6 | source.peek(i + 2) & 63
  } else {
    (source.peek(i) & 7) << 18 | (source.peek(i + 1) & 63) << 12 | (source.peek(i + 2) & 63) << 6
      | source.peek(i + 3) & 63
  }

fn char_literal(source: Bytes, scanner: Scanner, open: Int) -> Scanner / {abort.raise} = {
  let c = source.peek(open + 1);
  if c < 0 || c == 10 { unterminated_char(scanner, open, open + 1, CharLiteral(0)) }
  else if c == 39 {
    push_token(
      push_error(
        scanner,
        open,
        open + 2,
        unexpected(),
        b"an empty character literal",
        b"a character literal with no character, several characters or no closing quote is reported as an error",
      ),
      open,
      open + 2,
      CharLiteral(0),
    )
  } else if c == 92 {
    let e = char_escape(source, open + 1);
    if e.point < 0 {
      char_close(source, push_escape_error(scanner, open + 1, e), open, e.end, CharLiteral(0))
    } else { char_close(source, scanner, open, e.end, CharLiteral(e.point)) }
  } else {
    let w = utf8_len(c);
    char_close(
      source,
      scanner,
      open,
      open + 1 + w,
      CharLiteral(utf8_code_point(source, open + 1, w)),
    )
  }
}

fn quoted_unit(kind: TokenKind) -> Bytes =
  match kind { CharLiteral(_) -> b"character", _ -> b"byte" }

fn char_close(
  source: Bytes,
  scanner: Scanner,
  start: Int,
  i: Int,
  kind: TokenKind,
) -> Scanner / {abort.raise} =
  if source.peek(i) == 39 { push_token(scanner, start, i + 1, kind) } else {
    let close = source.skip_until(i, b"'\n");
    if source.peek(close) == 39 {
      push_token(
        push_error(
          scanner,
          start,
          close + 1,
          unexpected(),
          Bytes::concat_all([b"a ", quoted_unit(kind), b" literal holds one ", quoted_unit(kind)]),
          match kind {
            CharLiteral(_) -> b"write a string, `\"...\"`, for more than one",
            _ -> b"write a byte string, `b\"...\"`, for more than one",
          },
        ),
        start,
        close + 1,
        kind,
      )
    } else { unterminated_char(scanner, start, close, kind) }
  }

fn unterminated_char(scanner: Scanner, start: Int, stop: Int, kind: TokenKind) -> Scanner =
  push_token(
    push_error(
      scanner,
      start,
      stop,
      unterminated(),
      Bytes::concat_all([b"unterminated ", quoted_unit(kind), b" literal"]),
      b"add a closing `'`",
    ),
    start,
    stop,
    kind,
  )

fn byte_literal(source: Bytes, scanner: Scanner, start: Int) -> Scanner / {abort.raise} = {
  let at = start + 2;
  let c = source.peek(at);
  if c < 0 || c == 10 { unterminated_char(scanner, start, at, IntLiteral(0)) } else if c == 39 {
    push_token(
      push_error(
        scanner,
        start,
        at + 1,
        unexpected(),
        b"an empty byte literal",
        b"a byte literal holds exactly one byte",
      ),
      start,
      at + 1,
      IntLiteral(0),
    )
  } else if c == 92 {
    let e = byte_escape(source, at);
    if e.point < 0 {
      char_close(source, push_escape_error(scanner, at, e), start, e.end, IntLiteral(0))
    } else { char_close(source, scanner, start, e.end, IntLiteral(e.point)) }
  } else if c >= 128 {
    let w = utf8_len(c);
    char_close(
      source,
      push_error(
        scanner,
        at,
        at + w,
        unexpected(),
        Bytes::concat_all([
          b"`",
          source.slice(at, at + w),
          b"` is not an ASCII character, so it has no place in `b'...'`",
        ]),
        b"a byte literal holds one byte: write it as `\\xNN`",
      ),
      start,
      at + w,
      IntLiteral(0),
    )
  } else { char_close(source, scanner, start, at + 1, IntLiteral(c)) }
}

fn byte_escape(source: Bytes, i: Int) -> Escape / {abort.raise} = {
  let c = source.peek(i + 1);
  if letter_escape(c) >= 0 { valid_escape(letter_escape(c), i + 2) } else if c == 120 {
    let hi = hex_value(source.peek(i + 2));
    let lo = hex_value(source.peek(i + 3));
    if hi >= 0 && lo >= 0 { valid_escape(hi * 16 + lo, i + 4) } else {
      bad_escape(
        if hi >= 0 { i + 3 } else { i + 2 },
        unexpected(),
        b"`\\x` needs exactly two hex digits",
        b"write two hex digits, as in `\\x0d`",
      )
    }
  } else if c == 117 {
    bad_escape(
      unicode_escape(source, i).end,
      unexpected(),
      b"`\\u{...}` is a character escape, but a byte literal contains a single byte",
      b"write one of the character's UTF-8 bytes as `\\xNN`",
    )
  } else if c < 0 || c == 10 {
    bad_escape(i + 1, unterminated(), b"unterminated byte literal", b"add a closing `'`")
  } else {
    let w = utf8_len(c);
    bad_escape(
      i + 1 + w,
      unexpected(),
      Bytes::concat_all([b"unknown escape sequence `\\", source.slice(i + 1, i + 1 + w), b"`"]),
      b"valid escapes are \\n \\t \\r \\0 \\\\ \\' \\\" and \\xNN",
    )
  }
}

fn line_string(source: Bytes, scanner: Scanner, open: Int) -> Scanner / {abort.raise} =
  iterate(
    { scanner: scanner, line: open, done: [] },
    source.len() - open + 2,
    |at: LineStringScan| string_line(source, open, at),
  )

type LineStringScan = { scanner: Scanner, line: Int, done: List<Bytes> }

fn string_line(
  source: Bytes,
  open: Int,
  at: LineStringScan,
) -> Iter<LineStringScan, Scanner> / {abort.raise} = {
  let scanner = at.scanner;
  let from = at.line + 2;
  let eol = source.skip_until(from, b"\n");
  let token_end = if eol > from && source.peek(eol - 1) == 13 { eol - 1 } else { eol };
  let blank = trailing_space_start(source, from, token_end);
  let checked = if blank == token_end { scanner } else {
    push_error(
      scanner,
      blank,
      token_end,
      unexpected(),
      b"a line of a line string ends in whitespace",
      b"whitespace at the end of a line is invisible, so it is not content; end the line before it, or write the line as a `\"...\"` string with the spaces in it",
    )
  };
  let lines = at.done.push(source.slice(from, token_end));
  let next = continued_at(source, eol);
  if next < 0 { Stop(push_token(checked, open, token_end, LineString(joined_lines(lines)))) }
  else { Continue({ scanner: checked, line: next, done: lines }) }
}

fn trailing_space_start(source: Bytes, from: Int, token_end: Int) -> Int / {abort.raise} =
  iterate(token_end, token_end - from + 1, |i: Int|
    if i > from && (source.peek(i - 1) == 32 || source.peek(i - 1) == 9) { Continue(i - 1) }
    else { Stop(i) })

fn continued_at(source: Bytes, eol: Int) -> Int / {abort.raise} =
  if source.peek(eol) != 10 { -1 } else {
    let k = source.skip(eol + 1, b" \t");
    if source.peek(k) == 92 && source.peek(k + 1) == 92 { k } else { -1 }
  }

fn joined_lines(lines: List<Bytes>) -> Bytes =
  Bytes::concat_all(
    range(0, lines.len()).fold([], |accumulator: List<Bytes>, i: Int|
      match lines.at(i) {
        Some(l) -> if i == 0 { accumulator.push(l) } else { accumulator.push(b"\n").push(l) },
        None -> accumulator,
      }),
  )

fn bytes_stops() -> Bytes / {abort.raise} = b"\"\\\n".concat(high_bytes())

fn bytes_literal(source: Bytes, scanner: Scanner, open: Int) -> Scanner / {abort.raise} =
  iterate(
    { scanner: scanner, i: open + 2, accumulator: b"" },
    source.len() - open + 2,
    |at: TextScan| bytes_body(source, open, at),
  )

type TextScan = { scanner: Scanner, i: Int, accumulator: Bytes }

fn bytes_body(source: Bytes, open: Int, at: TextScan) -> Iter<TextScan, Scanner> / {abort.raise} = {
  let stop = source.skip_until(at.i, bytes_stops());
  let so_far = at.accumulator.concat(source.slice(at.i, stop));
  let c = source.peek(stop);
  if c < 0 || c == 10 {
    Stop(
      push_token(
        push_error(
          at.scanner,
          open,
          stop,
          unterminated(),
          b"unterminated byte-string literal",
          b"add a closing `\"`; a literal may not span a line break",
        ),
        open,
        stop,
        BytesLiteral(so_far),
      ),
    )
  } else if c == 34 { Stop(push_token(at.scanner, open, stop + 1, BytesLiteral(so_far))) }
  else if c == 92 { bytes_escape(source, at.scanner, open, stop, so_far) } else {
    let w = utf8_len(c);
    let ch = source.slice(stop, stop + w);
    let encoded = Bytes::concat_all(
      range(0, w).map(|i: Int| b"\\x".concat(Bytes::of_string(ch.slice(i, i + 1).hex_of()))),
    );
    Continue({
      scanner: push_error(
        at.scanner,
        stop,
        stop + w,
        unexpected(),
        Bytes::concat_all([
          b"`",
          ch,
          b"` is not an ASCII character, so it has no place in `b\"...\"`",
        ]),
        Bytes::concat_all([b"write `", encoded, b"` instead"]),
      ),
      i: stop + w,
      accumulator: so_far,
    })
  }
}

fn bytes_escape(
  source: Bytes,
  scanner: Scanner,
  open: Int,
  stop: Int,
  so_far: Bytes,
) -> Iter<TextScan, Scanner> / {abort.raise} = {
  let n = source.len();
  let c = source.peek(stop + 1);
  let past = |text: Bytes|
    Continue({ scanner: scanner, i: stop + 2, accumulator: so_far.concat(text) });
  if c < 0 {
    Stop(
      push_token(
        push_error(
          scanner,
          open,
          n,
          unterminated(),
          b"unterminated byte-string literal",
          b"add a closing `\"`",
        ),
        open,
        n,
        BytesLiteral(so_far),
      ),
    )
  } else if c == 110 { past(b"\n") }
  else if c == 116 { past(b"\t") }
  else if c == 114 { past(b"\r") }
  else if c == 48 { past(b"\x00") }
  else if c == 92 { past(b"\\") }
  else if c == 34 { past(b"\"") }
  else if c == 120 { hex_escape(source, scanner, stop, so_far) } else if c == 117 {
    let u = unicode_escape(source, stop);
    Continue({
      scanner: push_error(
        scanner,
        stop,
        u.end,
        unexpected(),
        b"`\\u{...}` is a character escape, but a byte string contains bytes, not characters",
        b"write the character's UTF-8 bytes as `\\xNN` escapes",
      ),
      i: u.end,
      accumulator: so_far,
    })
  } else {
    let w = utf8_len(c);
    Continue({
      scanner: unknown_escape(
        source,
        scanner,
        stop,
        w,
        b"valid escapes are \\n \\t \\r \\0 \\\\ \\\" and \\xNN",
      ),
      i: stop + 1 + w,
      accumulator: so_far,
    })
  }
}

fn hex_escape(
  source: Bytes,
  scanner: Scanner,
  stop: Int,
  so_far: Bytes,
) -> Iter<TextScan, Scanner> / {abort.raise} = {
  let hi = hex_value(source.peek(stop + 2));
  let lo = hex_value(source.peek(stop + 3));
  if hi >= 0 && lo >= 0 {
    Continue({
      scanner: scanner,
      i: stop + 4,
      accumulator: so_far.concat(byte_of_int(hi * 16 + lo)),
    })
  } else {
    let taken = if hi >= 0 { stop + 3 } else { stop + 2 };
    Continue({
      scanner: push_error(
        scanner,
        stop,
        taken,
        unexpected(),
        b"`\\x` needs exactly two hex digits",
        b"write two hex digits, as in `\\x0d`",
      ),
      i: taken,
      accumulator: so_far.concat(b"\x00"),
    })
  }
}

fn punctuation(source: Bytes, scanner: Scanner, start: Int, c: Int) -> Scanner / {abort.raise} =
  if c == 40 { push_token(scanner, start, start + 1, Punctuation(b"lparen")) }
  else if c == 41 { push_token(scanner, start, start + 1, Punctuation(b"rparen")) }
  else if c == 123 {
    push_token(adjust_hole_braces(scanner, 1), start, start + 1, Punctuation(b"lbrace"))
  } else if c == 125 && closes_interpolation(scanner) {
    interpolated_piece(
      source,
      with_holes(scanner, scanner.holes.drop_last(1)),
      start,
      start + 1,
      false,
    )
  } else if c == 125 {
    push_token(adjust_hole_braces(scanner, -1), start, start + 1, Punctuation(b"rbrace"))
  } else if c == 91 { push_token(scanner, start, start + 1, Punctuation(b"lbracket")) }
  else if c == 93 { push_token(scanner, start, start + 1, Punctuation(b"rbracket")) }
  else if c == 44 { push_token(scanner, start, start + 1, Punctuation(b"comma")) }
  else if c == 59 { push_token(scanner, start, start + 1, Punctuation(b"semi")) }
  else { operator(source, scanner, start, c) }

fn operator(source: Bytes, scanner: Scanner, start: Int, c: Int) -> Scanner / {abort.raise} =
  if c == 58 { punctuation_pair(scanner, source, start, 58, b"coloncolon", b"colon") }
  else if c == 46 && source.peek(start + 1) == 46 && source.peek(start + 2) == 61 {
    push_token(scanner, start, start + 3, Punctuation(b"dotdoteq"))
  } else if c == 46 { punctuation_pair(scanner, source, start, 46, b"dotdot", b"dot") }
  else if c == 61 { punctuation_pair(scanner, source, start, 61, b"eqeq", b"eq") }
  else if c == 33 { punctuation_pair(scanner, source, start, 61, b"bangeq", b"bang") }
  else if c == 60 { punctuation_pair(scanner, source, start, 61, b"le", b"lt") }
  else if c == 62 { punctuation_pair(scanner, source, start, 61, b"ge", b"gt") }
  else if c == 43 && source.peek(start + 1) != 43 { arithmetic(scanner, source, start, b"plus") }
  else if c == 43 { push_token(scanner, start, start + 2, Punctuation(b"plusplus")) }
  else if c == 45 && source.peek(start + 1) != 62 { arithmetic(scanner, source, start, b"minus") }
  else if c == 45 { push_token(scanner, start, start + 2, Punctuation(b"arrow")) }
  else if c == 42 { arithmetic(scanner, source, start, b"star") }
  else if c == 47 { push_token(scanner, start, start + 1, Punctuation(b"slash")) }
  else if c == 37 { push_token(scanner, start, start + 1, Punctuation(b"percent")) }
  else if c == 63 && source.peek(start + 1) == 63 && source.peek(start + 2) == 63 {
    push_token(scanner, start, start + 3, Punctuation(b"hole"))
  } else if c == 63 { push_token(scanner, start, start + 1, Punctuation(b"question")) }
  else if c == 124 { punctuation_pair(scanner, source, start, 124, b"pipepipe", b"pipe") }
  else if c == 38 { punctuation_pair(scanner, source, start, 38, b"ampamp", b"amp") }
  else if c == 94 { push_token(scanner, start, start + 1, Punctuation(b"caret")) }
  else if c == 126 { push_token(scanner, start, start + 1, Punctuation(b"tilde")) }
  else if c == 35 && source.peek(start + 1) == 123 {
    push_token(adjust_hole_braces(scanner, 1), start, start + 2, Punctuation(b"hashbrace"))
  } else if c == 35 && source.peek(start + 1) == 91 {
    push_token(scanner, start, start + 2, Punctuation(b"hashbracket"))
  } else if c == 35 {
    push_error(
      seek(scanner, start + 1),
      start,
      start + 1,
      unexpected(),
      b"unexpected character `#`",
      b"`#` opens a map literal, `#{k: v}`, or a set literal, `#[a, b]`, and nothing else",
    )
  } else {
    push_error(
      seek(scanner, start + 1),
      start,
      start + 1,
      unexpected(),
      Bytes::concat_all([b"unexpected character `", source.slice(start, start + 1), b"`"]),
      b"this character has no meaning in Ply source",
    )
  }

fn arithmetic(scanner: Scanner, source: Bytes, start: Int, single: Bytes) -> Scanner = {
  let next = source.peek(start + 1);
  if next == 37 { push_token(scanner, start, start + 2, Punctuation(single.concat(b"percent"))) }
  else if next == 124 { push_token(scanner, start, start + 2, Punctuation(single.concat(b"pipe"))) }
  else { push_token(scanner, start, start + 1, Punctuation(single)) }
}

fn punctuation_pair(
  scanner: Scanner,
  source: Bytes,
  start: Int,
  second: Int,
  both: Bytes,
  single: Bytes,
) -> Scanner =
  if source.peek(start + 1) == second { push_token(scanner, start, start + 2, Punctuation(both)) }
  else { push_token(scanner, start, start + 1, Punctuation(single)) }

pub fn dump(source: Bytes) -> String / {abort.raise} = {
  let lx = lex(source);
  String::of_bytes(
    Bytes::concat_all(lx.tokens.map(render_token)).concat(
      Bytes::concat_all(lx.diagnostics.map(render_diagnostic)),
    ),
  )
}

fn render_token(token: Token) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    ascii_of_int(token.start),
    b":",
    ascii_of_int(token.end),
    b":",
    token_body(token.kind),
    b";",
  ])

fn render_diagnostic(diagnostic: Diagnostic) -> Bytes =
  Bytes::concat_all([
    ascii_of_int(diagnostic.start),
    b":",
    ascii_of_int(diagnostic.end),
    b":!:",
    diagnostic.code,
    b";",
  ])

fn token_body(kind: TokenKind) -> Bytes / {abort.raise} =
  match kind {
    Identifier(b) -> b"i:".concat(b),
    IntLiteral(v) -> b"n:".concat(ascii_of_int(v)),
    FixedLiteral(ty, v) -> Bytes::concat_all([b"w:", ty, b":", ascii_of_int(v)]),
    WideLiteral(ty, high, low) ->
      Bytes::concat_all([b"W:", ty, b":", ascii_of_int(high), b":", ascii_of_int(low)]),
    FloatLiteral(txt) -> b"f:".concat(txt),
    DecimalLiteral(m, scale) -> Bytes::concat_all([b"d:", m, b":", ascii_of_int(scale)]),
    StringLiteral(b) -> b"s:".concat(Bytes::of_string(b.hex_of())),
    LineString(b) -> b"l:".concat(Bytes::of_string(b.hex_of())),
    BytesLiteral(b) -> b"b:".concat(Bytes::of_string(b.hex_of())),
    InterpolatedHead(b) -> b"F:".concat(Bytes::of_string(b.hex_of())),
    InterpolatedMiddle(b) -> b"M:".concat(Bytes::of_string(b.hex_of())),
    InterpolatedTail(b) -> b"T:".concat(Bytes::of_string(b.hex_of())),
    CharLiteral(v) -> b"c:".concat(ascii_of_int(v)),
    Keyword(b) -> b"k:".concat(b),
    Punctuation(b) -> b"p:".concat(b),
    EndOfInput -> b"e",
  }

test "a keyword and an identifier that starts with one are different tokens" {
  assert_eq(dump(b"fn fnord"), "0:2:k:fn;3:8:i:fnord;8:8:e;")
}

test "an underscore alone is a wildcard but prefixes an identifier" {
  assert_eq(dump(b"_ _x"), "0:1:p:underscore;2:4:i:_x;4:4:e;")
}

test "an integer literal may be written with underscore separators" {
  assert_eq(dump(b"1_000_000"), "0:9:n:1000000;9:9:e;")
}

test "an integer too large for Int is reported as an error and its value becomes zero" {
  assert_eq(dump(b"99999999999999999999"), "0:20:n:0;20:20:e;0:20:!:E0001;")
}

test "a fraction or an exponent is what makes a literal a Float" {
  assert_eq(
    dump(b"1 1.5 1e9 1_000.5 1.5e-3"),
    "0:1:n:1;2:5:f:1.5;6:9:f:1e9;10:17:f:1000.5;18:24:f:1.5e-3;24:24:e;",
  )
}

test "a Decimal literal like `1.50m` preserves the trailing zero, since its scale is 2" {
  assert_eq(dump(b"1.50m"), "0:5:d:150:2;5:5:e;")
}

test "a Decimal literal has no exponent" {
  assert_eq(dump(b"1e3m"), "0:4:d:0:0;4:4:e;0:4:!:E0001;")
}

test "a string literal decodes its backslash escapes into the bytes they stand for" {
  assert_eq(dump(b"\"a\\nb\\t\\\\\\\"\\r\\0\""), "0:16:s:610a62095c220d00;16:16:e;")
}

test "an unterminated string is reported as an error starting at its opening quote, and lexing continues on the next line" {
  assert_eq(
    dump(b"let s = \"oops\nlet t = 1"),
    "0:3:k:let;4:5:i:s;6:7:p:eq;8:13:s:6f6f7073;14:17:k:let;18:19:i:t;20:21:p:eq;22:23:n:1;23:23:e;8:13:!:E0002;",
  )
}

test "a line string runs from its backslashes to the end of the line, verbatim" {
  assert_eq(dump(b"\\\\a\"\\n\\\\\nx"), "0:8:l:61225c6e5c5c;9:10:i:x;10:10:e;")
}

test "a string written as consecutive lines starting with `\\` joins the lines with newlines and adds none after the last line" {
  assert_eq(dump(b"\\\\one\n  \\\\two\n\t\\\\\n1"), "0:17:l:6f6e650a74776f0a;18:19:n:1;19:19:e;")
}

test "a line string ends at the first line that does not continue it" {
  assert_eq(dump(b"\\\\one\n\n\\\\two"), "0:5:l:6f6e65;7:12:l:74776f;12:12:e;");
  assert_eq(dump(b"\\\\one\n// two\n\\\\three"), "0:5:l:6f6e65;13:20:l:7468726565;20:20:e;")
}

test "a carriage return before a newline ends a line rather than being content" {
  assert_eq(dump(b"\\\\a\r\n\\\\b\r\n"), "0:8:l:610a62;10:10:e;")
}

test "a line of a line string that ends in whitespace is rejected where the whitespace starts" {
  assert_eq(dump(b"\\\\a  \n\\\\b"), "0:9:l:6120200a62;9:9:e;3:5:!:E0001;")
}

test "a single backslash is reported as an error and produces no token" {
  assert_eq(dump(b"\\a"), "1:2:i:a;2:2:e;0:1:!:E0001;")
}

test "a byte literal takes the string escapes plus hex" {
  assert_eq(dump(b"b\"GET \\r\\n\\x00\\xff\\\"\\\\\""), "0:23:b:474554200d0a00ff225c;23:23:e;")
}

test "a byte literal with a too-short hex escape reports an error, and the rest of the literal is still lexed" {
  assert_eq(dump(b"b\"\\xg1\" 7"), "0:7:b:006731;8:9:n:7;9:9:e;2:4:!:E0001;")
}

test "operators use maximal munch" {
  assert_eq(
    dump(b"-> - ++ + == = != ! <= < >= > && || | .. ."),
    "0:2:p:arrow;3:4:p:minus;5:7:p:plusplus;8:9:p:plus;10:12:p:eqeq;13:14:p:eq;"
      ++ "15:17:p:bangeq;18:19:p:bang;20:22:p:le;23:24:p:lt;25:27:p:ge;28:29:p:gt;"
      ++ "30:32:p:ampamp;33:35:p:pipepipe;36:37:p:pipe;38:40:p:dotdot;41:42:p:dot;42:42:e;",
  )
}

test "the try operator is one token of its own" {
  assert_eq(dump(b"f(x)?"), "0:1:i:f;1:2:p:lparen;2:3:i:x;3:4:p:rparen;4:5:p:question;5:5:e;")
}

test "three question marks are one hole token, by maximal munch" {
  assert_eq(dump(b"??? ?? ?"), "0:3:p:hole;4:5:p:question;5:6:p:question;7:8:p:question;8:8:e;");
  assert_eq(dump(b"x???"), "0:1:i:x;1:4:p:hole;4:4:e;")
}

test "the bit operators `&`, `^` and `~` lex as tokens, and an unrecognized byte is reported as an error and skipped" {
  assert_eq(dump(b"a & b"), "0:1:i:a;2:3:p:amp;4:5:i:b;5:5:e;");
  assert_eq(dump(b"a ^ ~b"), "0:1:i:a;2:3:p:caret;4:5:p:tilde;5:6:i:b;6:6:e;");
  assert_eq(dump(b"a $ b"), "0:1:i:a;4:5:i:b;5:5:e;2:3:!:E0001;")
}

test "a hex literal is an Int of up to 64 bits, and a value with the top bit set is negative" {
  assert_eq(dump(b"0x10 0xff"), "0:4:n:16;5:9:n:255;9:9:e;");
  assert_eq(dump(b"0xFFFF_FFFF_FFFF_FFFF"), "0:21:n:-1;21:21:e;")
}

test "a U64 literal accepts values up to 2^64 - 1 stored as the same 64 bits, and larger values are errors" {
  assert_eq(dump(b"9223372036854775808u64"), "0:22:w:U64:-9223372036854775808;22:22:e;");
  assert_eq(dump(b"18446744073709551615u64"), "0:23:w:U64:-1;23:23:e;");
  assert_eq(dump(b"18446744073709551616u64"), "0:23:w:U64:0;23:23:e;0:23:!:E0211;")
}

test "a 128-bit literal is carried as its high and low 64-bit patterns" {
  assert_eq(dump(b"1u128"), "0:5:W:U128:0:1;5:5:e;");
  assert_eq(dump(b"18446744073709551616u128"), "0:24:W:U128:1:0;24:24:e;");
  assert_eq(dump(b"340282366920938463463374607431768211455u128"), "0:43:W:U128:-1:-1;43:43:e;");
  assert_eq(
    dump(b"170141183460469231731687303715884105727i128"),
    "0:43:W:I128:9223372036854775807:-1;43:43:e;",
  );
  assert_eq(dump(b"0x1_0000_0000_0000_0000u128"), "0:27:W:U128:1:0;27:27:e;");
  assert_eq(dump(b"0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFi128"), "0:38:W:I128:-1:-1;38:38:e;")
}

test "`wide_decimal` converts a 128-bit value, given as two 64-bit halves, to decimal text" {
  assert_eq(wide_decimal(false, 0, 0), b"0");
  assert_eq(wide_decimal(false, 1, 0), b"18446744073709551616");
  assert_eq(wide_decimal(false, -1, -1), b"340282366920938463463374607431768211455");
  assert_eq(wide_decimal(true, -1, -1), b"-1");
  assert_eq(
    wide_decimal(true, 0 - 9223372036854775807 - 1, 0),
    b"-170141183460469231731687303715884105728",
  );
  assert_eq(wide_decimal(true, 9223372036854775807, -1), b"170141183460469231731687303715884105727")
}

test "a 128-bit literal too large for its type is reported as an error and its value becomes zero" {
  assert_eq(
    dump(b"340282366920938463463374607431768211456u128"),
    "0:43:W:U128:0:0;43:43:e;0:43:!:E0211;",
  );
  assert_eq(
    dump(b"170141183460469231731687303715884105728i128"),
    "0:43:W:I128:0:0;43:43:e;0:43:!:E0211;",
  );
  assert_eq(
    dump(b"0x1FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFu128"),
    "0:39:W:U128:0:0;39:39:e;0:39:!:E0211;",
  )
}

test "a comment runs to the end of its line" {
  assert_eq(dump(b"1 // two\n3"), "0:1:n:1;9:10:n:3;10:10:e;")
}

test "the end-of-file token sits at the end of the input" {
  assert_eq(dump(b"abc"), "0:3:i:abc;3:3:e;")
}

test "a comment is recorded from its slashes to the end of its line, and none is a token" {
  let lx = lex(b"1 // two\n3 // x");
  assert_eq(lx.tokens.len(), 3);
  assert_eq(lx.comments, [{ start: 2, end: 8 }, { start: 11, end: 15 }]);
  assert_eq(lex(b"\"//\"").comments, [])
}

test "a character literal is its one character's scalar value" {
  assert_eq(dump(b"'a'"), "0:3:c:97;3:3:e;");
  assert_eq(dump(b"'\xc3\xa9'"), "0:4:c:233;4:4:e;");
  assert_eq(
    dump(b"'\\n' '\\'' '\\\"' '\\u{1F600}'"),
    "0:4:c:10;5:9:c:39;10:14:c:34;15:26:c:128512;26:26:e;",
  )
}

test "a character literal with no character, several characters or no closing quote is reported as an error" {
  assert_eq(dump(b"''"), "0:2:c:0;2:2:e;0:2:!:E0001;");
  assert_eq(dump(b"'ab'"), "0:4:c:97;4:4:e;0:4:!:E0001;");
  assert_eq(dump(b"'a"), "0:2:c:97;2:2:e;0:2:!:E0002;")
}

test "a byte literal like `b'a'` lexes as an Int equal to that byte, and accepts the same escapes as a byte string" {
  assert_eq(dump(b"b'a'"), "0:4:n:97;4:4:e;");
  assert_eq(dump(b"b'{' b'\"' b' '"), "0:4:n:123;5:9:n:34;10:14:n:32;14:14:e;");
  assert_eq(
    dump(b"b'\\n' b'\\'' b'\\\"' b'\\\\' b'\\0' b'\\x1f' b'\\xFF'"),
    "0:5:n:10;6:11:n:39;12:17:n:34;18:23:n:92;24:29:n:0;30:37:n:31;38:45:n:255;45:45:e;",
  )
}

test "a name ending in `b` followed by a quote lexes as a name and then a character literal" {
  assert_eq(dump(b"ab 'c'"), "0:2:i:ab;3:6:c:99;6:6:e;");
  assert_eq(dump(b"b 'c'"), "0:1:i:b;2:5:c:99;5:5:e;")
}

test "a byte literal with no byte, several bytes, a non-ASCII character or an invalid escape is reported as an error" {
  assert_eq(dump(b"b''"), "0:3:n:0;3:3:e;0:3:!:E0001;");
  assert_eq(dump(b"b'ab'"), "0:5:n:97;5:5:e;0:5:!:E0001;");
  assert_eq(dump(b"b'a"), "0:3:n:97;3:3:e;0:3:!:E0002;");
  assert_eq(dump(b"b'\xc3\xa9'"), "0:5:n:0;5:5:e;2:4:!:E0001;");
  assert_eq(dump(b"b'\\u{e9}'"), "0:9:n:0;9:9:e;2:8:!:E0001;");
  assert_eq(dump(b"b'\\x1'"), "0:6:n:0;6:6:e;2:5:!:E0001;");
  assert_eq(dump(b"b'\\q'"), "0:5:n:0;5:5:e;2:4:!:E0001;")
}

test "an arithmetic operator with a `%` or a `|` touching it is one token" {
  assert_eq(
    dump(b"a +% b -% c *% d"),
    "0:1:i:a;2:4:p:pluspercent;5:6:i:b;7:9:p:minuspercent;10:11:i:c;12:14:p:starpercent;15:16:i:d;16:16:e;",
  );
  assert_eq(
    dump(b"a +| b -| c *| d"),
    "0:1:i:a;2:4:p:pluspipe;5:6:i:b;7:9:p:minuspipe;10:11:i:c;12:14:p:starpipe;15:16:i:d;16:16:e;",
  );
  assert_eq(dump(b"a ++ b"), "0:1:i:a;2:4:p:plusplus;5:6:i:b;6:6:e;");
  assert_eq(dump(b"a -> b"), "0:1:i:a;2:4:p:arrow;5:6:i:b;6:6:e;")
}

test "`|` and `%` always lex as separate tokens, even right after another operator or a number" {
  assert_eq(dump(b"a + |x| x"), "0:1:i:a;2:3:p:plus;4:5:p:pipe;5:6:i:x;6:7:p:pipe;8:9:i:x;9:9:e;");
  assert_eq(dump(b"-1 | -2"), "0:1:p:minus;1:2:n:1;3:4:p:pipe;5:6:p:minus;6:7:n:2;7:7:e;");
  assert_eq(dump(b"-1|-2"), "0:1:p:minus;1:2:n:1;2:3:p:pipe;3:4:p:minus;4:5:n:2;5:5:e;");
  assert_eq(dump(b"a * b % c"), "0:1:i:a;2:3:p:star;4:5:i:b;6:7:p:percent;8:9:i:c;9:9:e;");
  assert_eq(dump(b"<a | e>"), "0:1:p:lt;1:2:i:a;3:4:p:pipe;5:6:i:e;6:7:p:gt;7:7:e;")
}

test "`..=` lexes as one token, and `..` lexes as a separate token when no `=` follows" {
  assert_eq(dump(b"0..=9"), "0:1:n:0;1:4:p:dotdoteq;4:5:n:9;5:5:e;");
  assert_eq(
    dump(b"[a, ..]"),
    "0:1:p:lbracket;1:2:i:a;2:3:p:comma;4:6:p:dotdot;6:7:p:rbracket;7:7:e;",
  )
}

test "an interpolated string is its text pieces around the tokens of each hole" {
  assert_eq(dump(b"f\"a {x} b\""), "0:5:F:6120;5:6:i:x;6:10:T:2062;10:10:e;");
  assert_eq(dump(b"f\"{a}-{b}\""), "0:3:F:;3:4:i:a;4:7:M:2d;7:8:i:b;8:10:T:;10:10:e;");
  assert_eq(dump(b"f\"\\n{x}\""), "0:5:F:0a;5:6:i:x;6:8:T:;8:8:e;")
}

test "an interpolated string with no `{...}` interpolation lexes as a plain string, and doubled braces become single braces" {
  assert_eq(dump(b"f\"plain {{x}}\""), "0:14:s:706c61696e207b787d;14:14:e;")
}

test "a brace inside an interpolation nests, and only the matching closing brace ends the interpolation" {
  assert_eq(dump(b"f\"{ {1} }\""), "0:3:F:;4:5:p:lbrace;5:6:n:1;6:7:p:rbrace;8:10:T:;10:10:e;");
  assert_eq(dump(b"f\"{f\"{x}\"}\""), "0:3:F:;3:6:F:;6:7:i:x;7:9:T:;9:11:T:;11:11:e;");
  assert_eq(dump(b"f\"{#{}}\""), "0:3:F:;3:5:p:hashbrace;5:6:p:rbrace;6:8:T:;8:8:e;")
}

test "a string directly after a name has interpolations, but a string after a space, keyword or number is plain" {
  assert_eq(dump(b"sh\"a {x} b\""), "0:2:i:sh;2:6:F:6120;6:7:i:x;7:11:T:2062;11:11:e;");
  assert_eq(dump(b"sh\"a {{x}}\""), "0:2:i:sh;2:11:s:61207b787d;11:11:e;");
  assert_eq(dump(b"sh \"a {x}\""), "0:2:i:sh;3:10:s:61207b787d;10:10:e;");
  assert_eq(dump(b"if\"a {x}\""), "0:2:k:if;2:9:s:61207b787d;9:9:e;");
  assert_eq(dump(b"1\"{x}\""), "0:1:n:1;1:6:s:7b787d;6:6:e;")
}

test "a label's hole holds a tagged literal's holes and the strings inside them" {
  assert_eq(
    dump(b"test \"{sh\"{f(\"}\")}\"}\" for"),
    "0:4:k:test;5:7:F:;7:9:i:sh;9:11:F:;11:12:i:f;12:13:p:lparen;13:16:s:7d;16:17:p:rparen;17:19:T:;19:21:T:;22:25:i:for;25:25:e;",
  )
}

test "a lone closing brace and a hole never closed are reported" {
  assert_eq(dump(b"f\"a}b\""), "0:6:s:6162;6:6:e;3:4:!:E0001;");
  assert_eq(dump(b"f\"{x"), "0:3:F:;3:4:i:x;4:4:e;4:4:!:E0002;")
}

test "a test name lexes with interpolations when `for` follows it, and as a plain string otherwise" {
  assert_eq(
    dump(b"test \"a {x}\" for"),
    "0:4:k:test;5:9:F:6120;9:10:i:x;10:12:T:;13:16:i:for;16:16:e;",
  );
  assert_eq(dump(b"test \"a {x}\" {"), "0:4:k:test;5:12:s:61207b787d;13:14:p:lbrace;14:14:e;");
  assert_eq(dump(b"test \"a {x}\" form"), "0:4:k:test;5:12:s:61207b787d;13:17:i:form;17:17:e;");
  assert_eq(
    dump(b"f(\"a {x}\") for"),
    "0:1:i:f;1:2:p:lparen;2:9:s:61207b787d;9:10:p:rparen;11:14:i:for;14:14:e;",
  )
}

test "a test name reads doubled braces as single literal braces, and an interpolation in it can contain a string with a brace inside" {
  assert_eq(dump(b"test \"a {{b}}\" for"), "0:4:k:test;5:14:s:61207b627d;15:18:i:for;18:18:e;");
  assert_eq(
    dump(b"test \"a {{b}}\" {"),
    "0:4:k:test;5:14:s:61207b7b627d7d;15:16:p:lbrace;16:16:e;",
  );
  assert_eq(
    dump(b"test/nondet \"{f(\"}\")}\" for"),
    "0:4:k:test;4:5:p:slash;5:11:k:nondet;12:14:F:;14:15:i:f;15:16:p:lparen;16:19:s:7d;19:20:p:rparen;20:22:T:;23:26:i:for;26:26:e;",
  )
}

test "a string's \\u escape writes its character as UTF-8" {
  assert_eq(dump(b"\"\\u{e9}\\u{1F600}\""), "0:17:s:c3a9f09f9880;17:17:e;");
  assert_eq(dump(b"\"\\'\""), "0:4:s:27;4:4:e;")
}

test "a \\u escape that names no character is rejected" {
  assert_eq(dump(b"\"\\u{D800}\""), "0:10:s:;10:10:e;1:9:!:E0211;");
  assert_eq(dump(b"\"\\u{110000}\""), "0:12:s:;12:12:e;1:11:!:E0211;");
  assert_eq(dump(b"\"\\u{}\""), "0:6:s:;6:6:e;1:5:!:E0001;");
  assert_eq(dump(b"\"\\u41\""), "0:6:s:3431;6:6:e;1:3:!:E0001;")
}

test "a byte string rejects a `\\u` escape with an error and still lexes the characters after it" {
  assert_eq(dump(b"b\"\\u{41}z\""), "0:10:b:7a;10:10:e;2:8:!:E0001;")
}

test "a map and a set literal open with their own two-character tokens" {
  assert_eq(dump(b"#{#[#"), "0:2:p:hashbrace;2:4:p:hashbracket;5:5:e;4:5:!:E0001;")
}

test "an identifier is ASCII: a letter outside it is rejected, not lexed" {
  assert_eq(
    dump(Bytes::of_string("let \u{e9} = 1\n")),
    "0:3:k:let;7:8:p:eq;9:10:n:1;11:11:e;4:6:!:X0001;",
  )
}

test "a space outside ASCII is rejected" {
  assert_eq(dump(Bytes::of_string("a\u{a0}b\n")), "0:1:i:a;3:4:i:b;5:5:e;1:3:!:X0001;")
}

test "a non-ASCII punctuation character such as `€` or `—` is reported as an error and produces no token" {
  assert_eq(dump(Bytes::of_string("a \u{20ac} b\n")), "0:1:i:a;6:7:i:b;8:8:e;2:5:!:X0001;");
  assert_eq(dump(Bytes::of_string("a \u{2014} b\n")), "0:1:i:a;6:7:i:b;8:8:e;2:5:!:X0001;")
}

test "source that is not valid UTF-8 is lexed up to the invalid bytes, and an error is reported at them" {
  assert_eq(dump(b"a \xe2\x82"), "0:1:i:a;2:2:e;2:3:!:X0001;");
  assert_eq(dump(b"\x91"), "0:0:e;0:1:!:X0001;");
  assert_eq(dump(b"x = '\xf0\x9f' y"), "0:1:i:x;2:3:p:eq;4:5:c:0;5:5:e;4:5:!:E0002;5:6:!:X0001;")
}

test "a backslash before a character outside ASCII is a bad escape" {
  assert_eq(dump(Bytes::of_string("\"a\\\u{e9}b\"\n")), "0:7:s:61c3a962;8:8:e;2:5:!:E0001;")
}

test "a character outside ASCII inside a byte literal is rejected" {
  assert_eq(dump(Bytes::of_string("b\"a\u{e9}b\"\n")), "0:7:b:6162;8:8:e;3:5:!:E0001;")
}

test "a non-ASCII character inside a string literal becomes part of the string's contents" {
  assert_eq(dump(Bytes::of_string("\"caf\u{e9}\"\n")), "0:7:s:636166c3a9;8:8:e;")
}

test "a non-ASCII character inside a comment is skipped, and lexing continues with the next token" {
  assert_eq(dump(Bytes::of_string("// caf\u{e9}\n1\n")), "9:10:n:1;11:11:e;")
}

test "`///` starts a declaration doc comment and `//!` a module doc comment, while `////` and `//` start ordinary comments" {
  let source = b"/// a\n//! b\n//// c\n// d\n///e  \n";
  let cs = lex(source).comments;
  assert_eq(cs.map(|c: Comment| doc_mark(source, c)), [
    Some(ItemDoc),
    Some(ModuleDoc),
    None,
    None,
    Some(ItemDoc),
  ]);
  assert_eq([0, 1, 4].map(|i: Int| doc_line(source, cs.at_or(i, { start: 0, end: 0 }))), [
    b"a",
    b"b",
    b"e",
  ])
}
