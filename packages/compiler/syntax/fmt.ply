//! `ply fmt`: the module printed back from its tree, with comments re-attached by position and
//! literals re-sliced from the source. A tree no source holds, as a decoder builds one, prints by
//! the same rules, each literal spelled from its value and each form only a source would show read
//! off the tree. Layout is decided from the tree and the column alone, so printing the output again
//! changes nothing.

import syntax.parsing (Span, Ident, QName, ParseDiag, Doc, primary_span_of, qname_text,
                       span_between, starts_upper, dummy_span)
import syntax.lexer (Comment, Token, InterpolatedHead, InterpolatedTail, ItemDoc, lex, doc_mark)
import syntax.items (Module, Item, IFn, IType, IEffect, ITest, ILaw, ISchema, IDerive, IEffectSet,
                     IExtern, ImportDecl, IModule, IAlias, INames, FnDef, ExternDef, TypeDef,
                     TDAlias, TDSum, VariantDef, EffectDef, OpDef, TestDef, LawDef, SchemaDef,
                     Binder, Deriver, deriver_text, Constraint, SpecClause, SpecKind, SRequires,
                     SEnsures, SCost, ReturnsFresh, ReturnsParam, Vis, VPub, VPriv, item_span,
                     item_doc, parse, dump_module, is_written, constraint_written, is_pub,
                     spec_kind_text, TDNominal, TDExtern, IInstance, instance_text, INumeric,
                     NumericOp, TypeDefBody, Opaque, FieldDoc, Cases, OfSchema, Returns)
import syntax.type_syntax (TypeExpr, TVar, TCon, TFn, TRecord, TUnit, TBad, RowExpr, AtomExpr, Mode,
                           MRead, MWrite, MBad, Generics, ty_span, mode_text, is_raise, angled,
                           generics_text, ident_names)
import syntax.exprs (Expr, ELit, EVar, EBinary, EUnary, ELambda, EApp, EIf, EMatch, EBlock, ERecord,
                     ERecordUpdate, ETry, EField, EList, EPerform, EHandle, EWithHold, ESimulate,
                     EParallel, EBad, EHole, ETryBlock, RaiseName, RecField, NamedArg, Param, Stmt,
                     SLet, SLetElse, SExpr, SAssign, MatchArm, HandleClause, ReturnClause,
                     HandlerVar, expr_span, is_block_like, ETagged, Tagged, Hole, written_operator,
                     call_operator, set_binder, map_literal_call, shown_binder)
import expand.rewrite.shared (map_expr, map_item)
import syntax.patterns (Pattern, PWild, PVar, PLit, PRange, PCtor, PRecord, PList, POr, PBad, Lit,
                        LInt, LFixed, LWide, LBool, LStr, LBytes, LEmbedded, LFloat, LDec, LChar,
                        LUnit, LBad, pat_span)
import syntax.spelling (literal_text, pattern_literal_text, str_lit, template_text)
import std.list
import std.option
import std.bytes (is_digit, ascii_of_int)

// --- The entry point --------------------------------------------------------

pub fn fmt_source(src: Bytes) -> Result<Bytes, Bytes> / {abort.raise} = {
  let r = parse(src);
  match r.parser.diags.at(0) {
    Some(d) -> Err(render_diag(src, d)),
    None -> {
      let out = module({ source: src, comments: lex(src).comments }, {
        ..r.node,
        items: r.node.items.map(with_operators),
      });
      let again = parse(out);
      match again.parser.diags.at(0) {
        Some(d) ->
          Err(b"formatter bug: the formatted text does not parse: ".concat(render_diag(out, d))),
        None -> if erase_spans(dump_module(again.node)) != erase_spans(dump_module(r.node)) {
          Err(b"formatter bug: the formatted text parses to a different tree")
        } else { Ok(out) },
      }
    },
  }
}

/// A call the parser wrote for an operator, as that operator over its operands, so it prints as
/// any binary operator does; its `op` is the builtin's name. An operator writes no label and no
/// named argument, which a call whose spans say nothing may hold.
fn as_operator(e: Expr) -> Expr =
  match e {
    EApp(a) -> match ((written_operator(a.func, a.args), a.args)) {
      (Some(o), [lhs, rhs]) -> if a.labels.len() > 0 || a.named.len() > 0 { e }
      else { EBinary({ span: a.span, op: o.name, lhs: lhs, rhs: rhs }) },
      _ -> e,
    },
    _ -> e,
  }

/// An item with every operator the parser wrote as a call read back as the operator.
fn with_operators(item: Item) -> Item = {
  let go = |x: Expr| map_expr(x, as_operator);
  let opt = |x: Option<Expr>| match x { Some(y) -> Some(go(y)), None -> None };
  match map_item(item, as_operator) {
    IFn(d) -> IFn({ ..d, decreases: opt(d.decreases) }),
    ISchema(d) -> ISchema({ ..d, guard: opt(d.guard), body: go(d.body) }),
    other -> other,
  }
}

fn render_diag(src: Bytes, diag: ParseDiag) -> Bytes / {abort.raise} = {
  let s = primary_span_of(diag);
  let lines = src.slice(0, s.start).split(b"\n");
  let col = lines.get(lines.len() - 1).len() + 1;
  Bytes::concat_all([
    ascii_of_int(lines.len()),
    b":",
    ascii_of_int(col),
    b": ",
    diag.code,
    b": ",
    diag.message,
  ])
}

/// The dump with every `start:end:` prefix removed, so two parses compare as trees.
pub fn erase_spans(dump: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    dump.split(b";").map(|u: Bytes|
      if u.len() > 0 && is_digit(u.at(0)) {
        match u.index_of(b":") {
          Some(i) -> match u.index_of_from(b":", i + 1) {
            Some(j) -> u.slice(j + 1, u.len()).concat(b";"),
            None -> u.concat(b";"),
          },
          None -> u.concat(b";"),
        }
      } else { u.concat(b";") }),
  )

// --- The state --------------------------------------------------------------

type PrintInput = { source: Bytes, comments: List<Comment> }

/// Whether the source holds the text `span` covers. A tree built rather than parsed has dummy
/// spans, and what its source would say is read off the tree instead.
fn sourced(input: PrintInput, span: Span) -> Bool =
  span.start < span.end && span.end <= input.source.len()

/// `ci` is the next comment not yet placed; `pending` holds the ones the current line will end
/// with; `prev_end` is where the last placed node or comment ended, for the blank-line rule.
/// `closed` is the indent the next text breaks to after a line string, whose line runs to its end,
/// and -1 otherwise. `parts` is last: it is the list that grows.
type Printer = {
  next_comment: Int,
  column: Int,
  previous_end: Int,
  pending: List<Bytes>,
  closed: Int,
  parts: List<Bytes>,
}

fn width() -> Int = 100

fn is_blank(c: Int) -> Bool = c == 32 || c == 9 || c == 13

fn spaces(n: Int) -> Bytes = Bytes::concat_all(range(0, n).map(|i: Int| b" "))

fn trim_end(b: Bytes) -> Bytes / {abort.raise} = {
  let k = iterate(b.len(), b.len() + 1, |i: Int|
    if i > 0 && is_blank(b.at(i - 1)) { Continue(i - 1) } else { Stop(i) });
  b.slice(0, k)
}

fn trim(b: Bytes) -> Bytes / {abort.raise} = {
  let t = trim_end(b);
  let k = iterate(0, t.len() + 1, |i: Int|
    if i < t.len() && is_blank(t.at(i)) { Continue(i + 1) } else { Stop(i) });
  t.slice(k, t.len())
}

fn trim_last(parts: List<Bytes>) -> List<Bytes> / {abort.raise} = {
  let n = parts.len();
  if n == 0 { parts } else { parts.set(n - 1, trim_end(parts.get(n - 1))) }
}

/// What follows a closed line starts the next one, which `nl` opens and no longer has it closed.
fn emit(printer: Printer, b: Bytes) -> Printer / {abort.raise} =
  if printer.closed >= 0 && trim(b).len() > 0 {
    appended(nl(printer, printer.closed, false), trim(b))
  } else { appended(printer, b) }

fn appended(printer: Printer, b: Bytes) -> Printer =
  {
    next_comment: printer.next_comment,
    previous_end: printer.previous_end,
    pending: printer.pending,
    column: printer.column + b.len(),
    closed: printer.closed,
    parts: printer.parts.push(b),
  }

fn set_prev(printer: Printer, e: Int) -> Printer = { ..printer, previous_end: e }

fn with_trailing(
  parts: List<Bytes>,
  pending: List<Bytes>,
  indent: Int,
) -> List<Bytes> / {abort.raise} =
  range(0, pending.len()).fold(trim_last(parts), |ps: List<Bytes>, i: Int|
    ps.push(
      Bytes::concat(if i == 0 { b"  " } else { b"\n".concat(spaces(indent)) }, pending.get(i)),
    ))

/// Ends the line: the trailing comments it collected, a newline (two for a blank line), the indent.
/// A line holding nothing yet is reused rather than left empty.
fn nl(printer: Printer, indent: Int, blank: Bool) -> Printer / {abort.raise} = {
  let pending = printer.pending;
  let n = printer.parts.len();
  let fresh = n > 0 && pending.len() == 0 && !blank
    && trim_end(printer.parts.get(n - 1)).len() == 0;
  if fresh {
    {
      next_comment: printer.next_comment,
      previous_end: printer.previous_end,
      pending: [],
      column: indent,
      closed: -1,
      parts: printer.parts.set(n - 1, spaces(indent)),
    }
  } else {
    let trailed = with_trailing(printer.parts, pending, indent);
    let lead = if trailed.len() == 0 { b"" } else if blank { b"\n\n" } else { b"\n" };
    {
      next_comment: printer.next_comment,
      previous_end: printer.previous_end,
      pending: [],
      column: indent,
      closed: -1,
      parts: trailed.push(lead.concat(spaces(indent))),
    }
  }
}

/// Nothing printed on the current line yet but its indent.
fn line_empty(printer: Printer) -> Bool =
  match printer.parts.at(printer.parts.len() - 1) {
    None -> true,
    Some(last) ->
      range(0, last.len()).fold(true, |all: Bool, i: Int|
        all && (last.at(i) == 10 || is_blank(last.at(i)))),
  }

fn finish(printer: Printer) -> Bytes / {abort.raise} = {
  let trailed = with_trailing(printer.parts, printer.pending, 0);
  if trailed.len() == 0 { b"" } else { Bytes::concat_all(trailed).concat(b"\n") }
}

fn fits(printer: Printer, text: Bytes, after: Int) -> Bool =
  printer.column + text.len() + after <= width()

// --- Comments ---------------------------------------------------------------

fn next_comment(input: PrintInput, printer: Printer) -> Option<Comment> =
  input.comments.at(printer.next_comment)

fn comment_before(p: PrintInput, printer: Printer, pos: Int) -> Bool =
  match next_comment(p, printer) { Some(c) -> c.start < pos, None -> false }

fn comment_text(input: PrintInput, c: Comment) -> Bytes / {abort.raise} =
  trim_end(input.source.slice(c.start, c.end))

fn same_line(input: PrintInput, a: Int, b: Int) -> Bool / {abort.raise} =
  a <= b && (match input.source.slice(a, b).index_of(b"\n") { Some(_) -> false, None -> true })

/// Two or more line breaks between `a` and `b` in the source: a blank line the output keeps.
fn gap(input: PrintInput, a: Int, b: Int) -> Bool / {abort.raise} =
  a <= b && input.source.slice(a, b).split(b"\n").len() >= 3

fn take_comment(printer: Printer, c: Comment) -> Printer =
  { ..printer, next_comment: printer.next_comment + 1, previous_end: c.end }

/// A blank line in the source before `at` that the output keeps: never after a `///` line, which
/// holds to what follows it.
fn kept_blank(input: PrintInput, printer: Printer, at: Int) -> Bool / {abort.raise} =
  gap(input, printer.previous_end, at)
    && !(match input.comments.at(printer.next_comment - 1) {
      Some(c) -> c.end == printer.previous_end && doc_mark(input.source, c) == Some(ItemDoc),
      None -> false,
    })

/// Every comment before `before`, each on a line of its own at `indent`.
fn flush_comments(
  input: PrintInput,
  printer: Printer,
  before: Int,
  indent: Int,
  blanks: Bool,
) -> Printer / {abort.raise} =
  match input.comments.at(printer.next_comment) {
    Some(c) -> if c.start < before {
      let s = nl(printer, indent, blanks && kept_blank(input, printer, c.start));
      flush_comments(
        input,
        take_comment(emit(s, comment_text(input, c)), c),
        before,
        indent,
        blanks,
      )
    } else { printer },
    None -> printer,
  }

/// The leading comments of a node, then a fresh line at `indent` for the node itself.
fn open_line(
  input: PrintInput,
  printer: Printer,
  start: Int,
  indent: Int,
  blanks: Bool,
) -> Printer / {abort.raise} = {
  let s = flush_comments(input, printer, start, indent, blanks);
  nl(s, indent, blanks && kept_blank(input, s, start))
}

/// Before a node that is not the first thing on its line: its leading comments, if any, force a break.
fn lead(input: PrintInput, printer: Printer, start: Int, indent: Int) -> Printer / {abort.raise} =
  if comment_before(input, printer, start) { open_line(input, printer, start, indent, false) }
  else { printer }

/// A comment on the same source line as the node that just ended goes on the same output line.
fn trail(input: PrintInput, printer: Printer, end: Int) -> Printer / {abort.raise} =
  match next_comment(input, printer) {
    Some(c) -> if c.start >= end && same_line(input, end, c.start) {
      take_comment(
        {
          next_comment: printer.next_comment,
          column: printer.column,
          previous_end: printer.previous_end,
          closed: printer.closed,
          parts: printer.parts,
          pending: printer.pending.push(comment_text(input, c)),
        },
        c,
      )
    } else { printer },
    None -> printer,
  }

/// Comments a printed node left behind inside its span end its line rather than being lost.
fn absorb(input: PrintInput, printer: Printer, end: Int) -> Printer / {abort.raise} =
  match input.comments.at(printer.next_comment) {
    Some(c) -> if c.start < end {
      absorb(
        input,
        take_comment(
          {
            next_comment: printer.next_comment,
            column: printer.column,
            previous_end: printer.previous_end,
            closed: printer.closed,
            parts: printer.parts,
            pending: printer.pending.push(comment_text(input, c)),
          },
          c,
        ),
        end,
      )
    } else { printer },
    None -> printer,
  }

/// Comments before the closer, then the closer on a line of its own.
fn close(
  input: PrintInput,
  printer: Printer,
  end: Int,
  indent: Int,
  closer: Bytes,
) -> Printer / {abort.raise} =
  emit(nl(flush_comments(input, printer, end, indent + 2, false), indent, false), closer)

/// The one-line form, when the node has one, holds no comment, and fits.
fn try_flat(
  input: PrintInput,
  printer: Printer,
  flat: Option<Bytes>,
  end: Int,
  after: Int,
) -> Option<Bytes> =
  match flat {
    Some(f) -> if !comment_before(input, printer, end) && fits(printer, f, after) { Some(f) }
    else { None },
    None -> None,
  }

// --- One-line text ----------------------------------------------------------

fn cat(xs: List<Option<Bytes>>) -> Option<Bytes> =
  xs.fold(Some(b""), |acc: Option<Bytes>, x: Option<Bytes>|
    match acc { None -> None, Some(a) -> match x { None -> None, Some(b) -> Some(a.concat(b)) } })

fn sep(xs: List<Option<Bytes>>, s: Bytes) -> Option<Bytes> / {abort.raise} =
  range(0, xs.len()).fold(Some(b""), |acc: Option<Bytes>, i: Int|
    match acc {
      None -> None,
      Some(a) -> match xs.get(i) {
        None -> None,
        Some(b) -> Some(if i == 0 { b } else { Bytes::concat_all([a, s, b]) }),
      },
    })

fn resource_text(r: Option<Ident>) -> Bytes =
  match r { Some(i) -> Bytes::concat_all([b"[", i.name, b"]"]), None -> b"" }

/// One bracket holds every label a call fills: `relay[conn](c)`, `f[a, b](x)`.
fn call_labels(idents: List<Ident>) -> Bytes =
  if idents.len() == 0 { b"" } else {
    Bytes::concat_all([b"[", Bytes::join(idents.map(|ident: Ident| ident.name), b", "), b"]"])
  }

fn atom_text(atom: AtomExpr) -> Bytes =
  Bytes::concat_all([
    qname_text(atom.eff),
    b".",
    match atom.op { Some(o) -> o.name, None -> mode_text(atom.mode) },
    atom_label_text(atom),
    if atom.bounded { b" bounded" } else { b"" },
  ])

/// `[*]` is a label, so it is written where a label goes rather than dropped.
fn atom_label_text(atom: AtomExpr) -> Bytes =
  if atom.every { b"[*]" } else { resource_text(atom.resource) }

/// Atoms and set names as the source ordered them: the parser keeps them in two lists.
fn members(atoms: List<AtomExpr>, names: List<QName>) -> List<Bytes> / {abort.raise} = {
  let xs = atoms.map(|atom: AtomExpr| { start: atom.span.start, text: atom_text(atom) });
  let ys = names.map(|qname: QName| { start: qname.span.start, text: qname_text(qname) });
  let merged = iterate(
    { i: 0, j: 0, out: [] },
    xs.len() + ys.len() + 1,
    |s: { i: Int, j: Int, out: List<Bytes> }|
      if s.i >= xs.len() && s.j >= ys.len() { Stop(s.out) }
      else if s.j >= ys.len() || (s.i < xs.len() && xs.get(s.i).start < ys.get(s.j).start) {
        Continue({ i: s.i + 1, j: s.j, out: s.out.push(xs.get(s.i).text) })
      } else { Continue({ i: s.i, j: s.j + 1, out: s.out.push(ys.get(s.j).text) }) },
  );
  merged
}

fn row_text(input: PrintInput, row: RowExpr) -> Bytes / {abort.raise} = {
  let ms = Bytes::join(members(row.atoms, row.aliases), b", ");
  // `{| e}` and `e` are one tree, so only a source says which a row variable alone was.
  let braced = if sourced(input, row.span) { input.source.at(row.span.start) == 123 }
  else { ms.len() > 0 };
  match row.tail {
    Some(t) -> {
      let v = if row.tail_bounded { t.name.concat(b" bounded") } else { t.name };
      if !braced { v }
      else if ms.len() == 0 { Bytes::concat_all([b"{| ", v, b"}"]) }
      else { Bytes::concat_all([b"{", ms, b" | ", v, b"}"]) }
    },
    None -> Bytes::concat_all([b"{", ms, b"}"]),
  }
}

fn row_suffix(input: PrintInput, r: Option<RowExpr>) -> Bytes / {abort.raise} =
  match r { Some(x) -> b" / ".concat(row_text(input, x)), None -> b"" }

fn positional_name(i: Int) -> Bytes = b"_".concat(ascii_of_int(i))

/// Whether a record type's fields are a tuple's, `(A, B)`, which the parser reads as a record.
pub fn is_ty_tuple(fields: List<{ name: Ident, ty: TypeExpr }>) -> Bool / {abort.raise} =
  fields.len() >= 2
    && range(0, fields.len()).fold(true, |ok: Bool, i: Int| {
      let f = fields.get(i);
      ok && f.name.name == positional_name(i) && f.name.span == ty_span(f.ty)
    })

fn type_text(input: PrintInput, t: TypeExpr) -> Bytes / {abort.raise} =
  match t {
    TVar(i) -> i.name,
    TCon(x) -> {
      let args = angled(
        x.args.map(|a: TypeExpr| type_text(input, a)),
        ident_names(x.labels),
        x.rows.map(|r: RowExpr| row_text(input, r)),
      );
      // A bare lowercase name alone reads back as a type variable.
      let lone = args.len() == 0 && x.name.module == None && !starts_upper(x.name.name.name);
      qname_text(x.name).concat(if lone { b"<>" } else { args })
    },
    TFn(x) ->
      Bytes::concat_all([
        b"(",
        Bytes::join(x.params.map(|a: TypeExpr| type_text(input, a)), b", "),
        b") -> ",
        type_text(input, x.ret),
        row_suffix(input, x.effects),
      ]),
    TRecord(x) -> if is_ty_tuple(x.fields) {
      Bytes::concat_all([
        b"(",
        Bytes::join(x.fields.map(|f: { name: Ident, ty: TypeExpr }| type_text(input, f.ty)), b", "),
        b")",
      ])
    } else if x.fields.len() == 0 { b"{}" } else {
      Bytes::concat_all([
        b"{ ",
        Bytes::join(
          x.fields.map(|f: { name: Ident, ty: TypeExpr }| ty_field_text(input, f)),
          b", ",
        ),
        b" }",
      ])
    },
    TUnit(_) -> b"()",
    TBad(_) -> b"()",
  }

fn ty_field_text(input: PrintInput, f: { name: Ident, ty: TypeExpr }) -> Bytes / {abort.raise} =
  Bytes::concat_all([f.name.name, b": ", type_text(input, f.ty)])

/// The source over a literal, with the parentheses a grouping widened its span by removed.
fn unparen(input: PrintInput, span: Span) -> Bytes / {abort.raise} =
  unparen_text(trim(input.source.slice(span.start, span.end)))

/// A pair of parentheses a round, each round two bytes shorter.
fn unparen_text(t: Bytes) -> Bytes / {abort.raise} =
  iterate(t, t.len() / 2 + 1, |cur: Bytes| {
    let n = cur.len();
    if n >= 2 && cur.at(0) == 40 && cur.at(n - 1) == 41 {
      let inner = trim(cur.slice(1, n - 1));
      if inner.len() == 0 { Stop(cur) } else { Continue(inner) }
    } else { Stop(cur) }
  })

/// A number without the blanks after its sign, and a range without those around its dots; a
/// quoted byte keeps its own.
fn strip_blanks(t: Bytes) -> Bytes =
  range(0, t.len()).fold(
    { out: b"", quoted: false, escaped: false },
    |s: { out: Bytes, quoted: Bool, escaped: Bool }, i: Int| {
      let c = t.at(i);
      {
        out: if s.quoted || (c != 32 && c != 9) { s.out.concat(t.slice(i, i + 1)) } else { s.out },
        quoted: if c == 39 && !s.escaped { !s.quoted } else { s.quoted },
        escaped: s.quoted && c == 92 && !s.escaped,
      }
    },
  ).out

/// A literal written as a line string: the AST holds only its value, so the source says which.
fn is_lines(input: PrintInput, expr: Expr) -> Bool / {abort.raise} =
  match expr {
    ELit(v) -> if !sourced(input, v.span) { false } else {
      let t = unparen(input, v.span);
      t.len() >= 2 && t.at(0) == 92 && t.at(1) == 92
    },
    _ -> false,
  }

/// One line per line of the value, every one at the first's indent, and nothing after the last on
/// its line: what follows breaks to `indent`.
fn line_string(printer: Printer, value: Bytes, indent: Int, cont: Int) -> Printer / {abort.raise} = {
  let empty = line_empty(printer);
  let col = if empty { printer.column } else { cont };
  let lines = value.split(b"\n");
  let printed = range(0, lines.len()).fold(
    if empty { printer } else { nl(printer, cont, false) },
    |s: Printer, i: Int|
      emit(if i == 0 { s } else { nl(s, col, false) }, b"\\\\".concat(lines.get(i))),
  );
  { ..printed, closed: indent }
}

/// A hole between its braces, set off by a space where it begins with a brace of its own, which
/// beside the hole's would read as a brace of the text.
fn hole_text(flat: Bytes) -> Bytes =
  if flat.starts_with(b"{") { Bytes::concat_all([b"{ ", flat, b" }"]) }
  else { Bytes::concat_all([b"{", flat, b"}"]) }

/// A text of a tagged literal as written, or spelled from its value where no source covers it.
fn tag_text(input: PrintInput, quoted: Span, value: Bytes) -> Bytes / {abort.raise} =
  if sourced(input, quoted) { input.source.slice(quoted.start + 1, quoted.end - 1) }
  else { template_text(value) }

/// The hole `h` as written, `from` past the text before it, where it has no flat form.
fn hole_written(input: PrintInput, h: Hole, from: Int) -> Option<Bytes> / {abort.raise} =
  if sourced(input, h.quoted) { Some(input.source.slice(from - 1, h.quoted.start + 1)) }
  else { None }

/// A tagged literal as written: its tag touching its string, each text kept and each hole printed
/// flat, or kept too where it has no flat form; with no source to keep, such a hole leaves it no
/// one-line form.
fn tagged_flat(input: PrintInput, t: Tagged) -> Option<Bytes> / {abort.raise} = {
  let filled = t.holes.fold(
    { out: Some(tag_text(input, t.quoted, t.text)), from: t.quoted.end },
    |acc: { out: Option<Bytes>, from: Int }, h: Hole|
      {
        out: cat([
          acc.out,
          match flat_expr(input, h.value) {
            Some(flat) -> Some(hole_text(flat)),
            None -> hole_written(input, h, acc.from),
          },
          Some(tag_text(input, h.quoted, h.text)),
        ]),
        from: h.quoted.end,
      },
  );
  cat([Some(t.tag.name.concat(b"\"")), filled.out, Some(b"\"")])
}

/// A tagged literal with a hole no line holds, that hole laid out between its braces.
fn tagged_laid(
  input: PrintInput,
  printer: Printer,
  t: Tagged,
  indent: Int,
) -> Printer / {abort.raise} = {
  let opened = emit(
    printer,
    Bytes::concat_all([t.tag.name, b"\"", tag_text(input, t.quoted, t.text)]),
  );
  let filled = t.holes.fold(
    { printer: opened, from: t.quoted.end },
    |acc: { printer: Printer, from: Int }, h: Hole|
      {
        printer: emit(
          match flat_expr(input, h.value) {
            Some(flat) -> emit(acc.printer, hole_text(flat)),
            None -> match hole_written(input, h, acc.from) {
              Some(written) -> emit(acc.printer, written),
              None -> hole_laid(input, acc.printer, h.value, indent),
            },
          },
          tag_text(input, h.quoted, h.text),
        ),
        from: h.quoted.end,
      },
  );
  emit(filled.printer, b"\"")
}

/// A hole's value laid out between braces, set off by a space from what it may open with.
fn hole_laid(
  input: PrintInput,
  printer: Printer,
  value: Expr,
  indent: Int,
) -> Printer / {abort.raise} = emit(expr(input, emit(printer, b"{ "), value, indent, 2), b" }")

/// A literal as the source spells it, or spelled from its value where no source covers it.
fn lit_text(input: PrintInput, span: Span, literal: Lit) -> Bytes / {abort.raise} =
  if !sourced(input, span) { literal_text(literal) } else {
    match literal {
      LInt(_) -> strip_blanks(unparen(input, span)),
      LFixed(_, _) -> strip_blanks(unparen(input, span)),
      LWide(_, _, _) -> strip_blanks(unparen(input, span)),
      LStr(_) -> unparen(input, span),
      LBytes(_) -> unparen(input, span),
      // Written out of an `embed` call after a parse, so never in text being formatted.
      LEmbedded(_, _) -> unparen(input, span),
      LChar(_) -> unparen(input, span),
      _ -> literal_text(literal),
    }
  }

fn pat_punned(f: { name: Ident, pat: Pattern }) -> Bool =
  match f.pat { PVar(v) -> v.name.name == f.name.name && v.span == f.name.span, _ -> false }

/// Whether a record pattern's fields are a tuple's, `(a, b)`, which the parser reads as a record.
pub fn is_pat_tuple(fields: List<{ name: Ident, pat: Pattern }>) -> Bool / {abort.raise} =
  fields.len() >= 2
    && range(0, fields.len()).fold(true, |ok: Bool, i: Int| {
      let f = fields.get(i);
      ok && f.name.name == positional_name(i) && f.name.span == pat_span(f.pat)
    })

fn pattern_text(input: PrintInput, x: Pattern) -> Bytes / {abort.raise} =
  match x {
    PWild(_) -> b"_",
    PVar(v) -> v.name.name,
    PLit(v) -> if sourced(input, v.span) { lit_text(input, v.span, v.lit) }
    else { pattern_literal_text(v.lit) },
    PRange(v) -> if sourced(input, v.span) { strip_blanks(unparen(input, v.span)) }
    else { Bytes::concat_all([pattern_literal_text(v.lo), b"..=", pattern_literal_text(v.hi)]) },
    PCtor(v) -> if v.args.len() == 0 { qname_text(v.name) } else {
      Bytes::concat_all([
        qname_text(v.name),
        b"(",
        Bytes::join(v.args.map(|a: Pattern| pattern_text(input, a)), b", "),
        b")",
      ])
    },
    PRecord(v) -> if is_pat_tuple(v.fields) && !v.rest {
      Bytes::concat_all([
        b"(",
        Bytes::join(
          v.fields.map(|f: { name: Ident, pat: Pattern }| pattern_text(input, f.pat)),
          b", ",
        ),
        b")",
      ])
    } else {
      let fs = v.fields.map(|f: { name: Ident, pat: Pattern }|
        if pat_punned(f) { f.name.name }
        else { Bytes::concat_all([f.name.name, b": ", pattern_text(input, f.pat)]) });
      let all = if v.rest { fs.push(b"..") } else { fs };
      Bytes::concat_all([b"{ ", Bytes::join(all, b", "), b" }"])
    },
    PList(v) -> {
      let items = v.items.map(|a: Pattern| pattern_text(input, a));
      let all = match v.rest {
        Some(PVar(r)) -> items.push(b"..".concat(r.name.name)),
        Some(_) -> items.push(b".."),
        None -> items,
      };
      Bytes::concat_all([b"[", Bytes::join(all, b", "), b"]"])
    },
    // An alternative that is itself a choice was parenthesised, and stays so.
    POr(v) ->
      Bytes::join(
        v.alts.map(|a: Pattern|
          match a {
            POr(_) -> Bytes::concat_all([b"(", pattern_text(input, a), b")"]),
            _ -> pattern_text(input, a),
          }),
        b" | ",
      ),
    PBad(_) -> b"_",
  }

// --- Operators and parentheses ----------------------------------------------

fn bp(op: Bytes) -> Int =
  if op == b"or" { 1 }
  else if op == b"and" { 2 }
  else if op == b"eq" || op == b"ne" || op == b"lt" || op == b"le" || op == b"gt" || op == b"ge" {
    3
  } else if op == b"bitor" { 4 }
  else if op == b"bitxor" { 5 }
  else if op == b"bitand" { 6 }
  else if op == b"shl" || op == b"shr" || op == b"ushr" { 7 }
  else if op == b"concat" { 8 }
  else if op == b"add" || op == b"sub" { 9 }
  else { match call_operator(op) { Some(o) -> o.bp, None -> 10 } }

/// A binary operator as it is written, by the name the tree holds it under.
pub fn op_text(op: Bytes) -> Bytes = {
  let table = [
    { n: b"or", t: b"||" },
    { n: b"and", t: b"&&" },
    { n: b"eq", t: b"==" },
    { n: b"ne", t: b"!=" },
    { n: b"lt", t: b"<" },
    { n: b"le", t: b"<=" },
    { n: b"gt", t: b">" },
    { n: b"ge", t: b">=" },
    { n: b"bitor", t: b"|" },
    { n: b"bitxor", t: b"^" },
    { n: b"bitand", t: b"&" },
    { n: b"shl", t: b"<<" },
    { n: b"shr", t: b">>" },
    { n: b"ushr", t: b">>>" },
    { n: b"concat", t: b"++" },
    { n: b"add", t: b"+" },
    { n: b"sub", t: b"-" },
    { n: b"mul", t: b"*" },
    { n: b"div", t: b"/" },
    { n: b"rem", t: b"%" },
  ];
  match call_operator(op) {
    Some(o) -> o.text,
    None ->
      table.fold(b"", |acc: Bytes, e: { n: Bytes, t: Bytes }| if e.n == op { e.t } else { acc }),
  }
}

/// A unary operator as it is written, by the name the tree holds it under.
pub fn unary_text(op: Bytes) -> Bytes =
  if op == b"neg" { b"-" } else if op == b"not" { b"!" } else { b"~" }

/// A form with no closer of its own to read: where it ends is worked out rather than seen.
fn runs_on(expr: Expr) -> Bool =
  match expr {
    ELambda(_) -> true,
    EIf(_) -> true,
    EMatch(_) -> true,
    EHandle(_) -> true,
    EWithHold(_) -> true,
    ESimulate(_) -> true,
    ETryBlock(_) -> true,
    _ -> false,
  }

/// A binary operand: a looser operator, the same one on the right, `&&` under `||`, or a form that
/// runs on. The brackets `&&` binding tighter than `||` makes redundant are still written, so what
/// an edit to one of them would mean is read rather than recalled.
fn parens_operand(expr: Expr, parent: Bytes, rhs: Bool) -> Bool =
  match expr {
    EBinary(v) ->
      bp(v.op) < bp(parent) || (bp(v.op) == bp(parent) && rhs)
        || (v.op == b"and" && parent == b"or"),
    _ -> runs_on(expr),
  }

fn parens_unary(expr: Expr) -> Bool =
  match expr { EBinary(_) -> true, EUnary(_) -> true, _ -> runs_on(expr) }

/// What a call, a field read or `?` may follow without parentheses.
fn parens_postfix(expr: Expr) -> Bool =
  match expr {
    ELit(_) -> false,
    ETagged(_) -> false,
    EVar(_) -> false,
    EApp(_) -> false,
    EField(_) -> false,
    ETry(_) -> false,
    EPerform(_) -> false,
    EList(_) -> false,
    ERecord(_) -> false,
    ERecordUpdate(_) -> false,
    EBlock(_) -> false,
    _ -> true,
  }

/// `v.f(x)` would read as a perform, so a field of a variable is parenthesised before a call,
/// but for one that names an argument (`named`) or its function in full, which no perform does.
fn parens_callee(expr: Expr, named: Bool) -> Bool =
  match expr {
    EField(v) -> match v.base {
      EVar(_) -> !named && v.field.name.index_of(b"::") == None,
      _ -> parens_postfix(expr),
    },
    _ -> parens_postfix(expr),
  }

/// In a scrutinee a `{` opens the arms, so an expression that begins with one is grouped.
fn starts_with_brace(expr: Expr) -> Bool =
  match expr {
    ERecord(_) -> true,
    ERecordUpdate(_) -> true,
    EBlock(_) -> true,
    ESimulate(_) -> true,
    EParallel(_) -> true,
    EBinary(v) -> starts_with_brace(v.lhs),
    EApp(v) -> starts_with_brace(v.func),
    EField(v) -> starts_with_brace(v.base),
    ETry(v) -> starts_with_brace(v.operand),
    _ -> false,
  }

/// Whether an operand past an expression's first opens with a `{` of its own, which a scrutinee
/// would read as the block after it.
fn holds_brace(expr: Expr) -> Bool / {abort.raise} =
  match expr {
    EBinary(v) -> holds_brace(v.lhs) || opens_brace(v.rhs) || holds_brace(v.rhs),
    EUnary(v) -> opens_brace(v.operand) || holds_brace(v.operand),
    EApp(v) -> holds_brace(v.func),
    EField(v) -> holds_brace(v.base),
    ETry(v) -> holds_brace(v.operand),
    _ -> false,
  }

/// Whether `expr` prints a `{` first: a tuple, though a record in the tree, prints `(`.
fn opens_brace(expr: Expr) -> Bool / {abort.raise} =
  match expr {
    ERecord(v) -> !is_tuple(v.fields),
    ERecordUpdate(_) -> true,
    EBlock(_) -> true,
    ESimulate(_) -> true,
    EParallel(_) -> true,
    EBinary(v) -> opens_brace(v.lhs),
    EApp(v) -> opens_brace(v.func),
    EField(v) -> opens_brace(v.base),
    ETry(v) -> opens_brace(v.operand),
    _ -> false,
  }

/// A scrutinee is bracketed where a `{` in it would be read as the block that follows it.
fn parens_scrutinee(expr: Expr) -> Bool / {abort.raise} =
  starts_with_brace(expr) || holds_brace(expr)

fn wrap(o: Option<Bytes>, parens: Bool) -> Option<Bytes> =
  if parens { cat([Some(b"("), o, Some(b")")]) } else { o }

// --- Expressions, on one line -----------------------------------------------

fn punned(field: RecField) -> Bool =
  match field.value {
    EVar(v) -> match v.name.module {
      None -> v.name.name.name == field.name.name && v.span == field.name.span,
      Some(_) -> false,
    },
    _ -> false,
  }

/// Whether a record's fields are a tuple's, `(a, b)`, which the parser reads as a record.
pub fn is_tuple(fields: List<RecField>) -> Bool / {abort.raise} =
  fields.len() >= 2
    && range(0, fields.len()).fold(true, |ok: Bool, i: Int| {
      let f = fields.get(i);
      ok && f.name.name == positional_name(i) && f.name.span == expr_span(f.value)
    })

fn lambda_head(
  input: PrintInput,
  params: List<Param>,
  ret: Option<TypeExpr>,
) -> Bytes / {abort.raise} = {
  let ps = if params.len() == 0 { b"||" } else {
    Bytes::concat_all([
      b"|",
      Bytes::join(params.map(|param: Param| param_head(input, param)), b", "),
      b"|",
    ])
  };
  match ret { Some(t) -> Bytes::concat_all([ps, b" -> ", type_text(input, t)]), None -> ps }
}

fn param_head(input: PrintInput, param: Param) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    match param.ty {
      Some(t) ->
        Bytes::concat_all([
          param.name.name,
          b": ",
          if param.keep { b"keep " } else { b"" },
          type_text(input, t),
        ]),
      None -> param.name.name,
    },
    match param.cost { Some(k) -> b" cost ".concat(k.name), None -> b"" },
    match param.space { Some(s) -> b" space ".concat(s.name), None -> b"" },
  ])

fn perform_head(eff: QName, ident: Ident, r: Option<Ident>) -> Bytes =
  Bytes::concat_all([qname_text(eff), b".", ident.name, resource_text(r)])

fn try_head(raise: Option<RaiseName>) -> Bytes =
  match raise {
    None -> b"try ",
    Some(r) -> Bytes::concat_all([b"try[", qname_text(r.eff), b".", r.op.name, b"] "]),
  }

fn clause_head(clause: HandleClause) -> Bytes =
  Bytes::concat_all([
    // `[*]` is a label the clause answers on every resource, so it is not one to print as a name.
    // `[*t]` is the same coverage with the label bound, which is the only way to read it.
    match clause.every_label {
      true ->
        Bytes::concat_all([
          qname_text(clause.eff),
          b".",
          clause.op.name,
          b"[*",
          match clause.label_binder { Some(t) -> t.name, None -> b"" },
          b"]",
        ]),
      false -> perform_head(clause.eff, clause.op, clause.resource),
    },
    b"(",
    Bytes::join(clause.params.map(|ident: Ident| ident.name), b", "),
    b")",
    match clause.resume { Some(k) -> b" resume ".concat(k.name), None -> b"" },
  ])

/// `{ x }` alone reads as a block, so a lone punned field is written out.
fn flat_field(input: PrintInput, field: RecField, pun_ok: Bool) -> Option<Bytes> / {abort.raise} =
  if punned(field) && pun_ok { Some(field.name.name) }
  else { cat([Some(field.name.name.concat(b": ")), flat_expr(input, field.value)]) }

fn flat_scrutinee(input: PrintInput, expr: Expr) -> Option<Bytes> / {abort.raise} =
  wrap(flat_expr(input, expr), parens_scrutinee(expr))

fn flat_args(
  input: PrintInput,
  args: List<Expr>,
  named: List<NamedArg>,
) -> Option<Bytes> / {abort.raise} =
  sep(
    named.fold(
      args.map(|expr: Expr| flat_expr(input, expr)),
      |acc: List<Option<Bytes>>, arg: NamedArg|
        acc.push(cat([Some(arg.name.name.concat(b": ")), flat_expr(input, arg.value)])),
    ),
    b", ",
  )

fn flat_else(input: PrintInput, expr: Expr) -> Option<Bytes> / {abort.raise} =
  match expr { ELit(_) -> Some(b""), _ -> cat([Some(b" else "), flat_expr(input, expr)]) }

fn flat_arm(input: PrintInput, arm: MatchArm) -> Option<Bytes> / {abort.raise} =
  cat([
    Some(pattern_text(input, arm.pat)),
    match arm.guard { Some(g) -> cat([Some(b" if "), flat_expr(input, g)]), None -> Some(b"") },
    Some(b" -> "),
    flat_expr(input, arm.body),
  ])

fn flat_clauses(
  input: PrintInput,
  clauses: List<HandleClause>,
  ret: Option<ReturnClause>,
) -> Option<Bytes> / {abort.raise} = {
  let cs = clauses.map(|c: HandleClause|
    cat([Some(clause_head(c)), Some(b" -> "), flat_expr(input, c.body)]));
  let all = match ret {
    Some(r) ->
      cs.push(
        cat([
          Some(Bytes::concat_all([b"return ", r.binder.name, b" -> "])),
          flat_expr(input, r.body),
        ]),
      ),
    None -> cs,
  };
  if all.len() == 0 { Some(b"{}") } else { cat([Some(b"{ "), sep(all, b", "), Some(b" }")]) }
}

/// The parser expands an interpolated string into a concatenation spanning it, which the source
/// still opens with `f"`: its text is kept as written and each hole printed flat.
fn interpolated(input: PrintInput, e: Expr) -> Option<Bytes> / {abort.raise} =
  if !one_string(input, e) { None } else { cat([Some(b"f\""), pieces(input, e), Some(b"\"")]) }

/// Whether `e` is one interpolated string: as its source opens, or where no source covers it, as
/// the parser builds one.
fn one_string(input: PrintInput, e: Expr) -> Bool / {abort.raise} =
  match e {
    ELit(_) -> false,
    _ -> if sourced(input, expr_span(e)) { one_interpolation(input, expr_span(e)) }
    else { interpolation_shape(e) },
  }

/// The parser's concatenation of one interpolated string: texts and `display` calls chained to the
/// left, a call among them, no text empty and no two texts side by side.
fn interpolation_shape(e: Expr) -> Bool / {abort.raise} = {
  let parts = chained(e);
  let text = |x: Expr|
    match x { ELit(v) -> match v.lit { LStr(s) -> s.len() > 0, _ -> false }, _ -> false };
  parts.fold(false, |any: Bool, x: Expr| any || is_display(x))
    && range(0, parts.len()).fold(true, |ok: Bool, i: Int| {
      let x = parts.get(i);
      ok && (is_display(x) || (text(x) && (i == 0 || !text(parts.get(i - 1)))))
    })
}

/// A concatenation's operands, its left operands unfolded.
fn chained(e: Expr) -> List<Expr> =
  match e {
    EBinary(v) -> if v.op == b"concat" { chained(v.lhs).push(v.rhs) } else { [e] },
    _ -> [e],
  }

/// The call of `std.show`'s `display` an interpolated string's hole is.
fn is_display(e: Expr) -> Bool =
  match e {
    EApp(a) ->
      a.args.len() == 1 && a.named.len() == 0 && a.labels.len() == 0
        && (match a.func {
          EVar(f) ->
            f.name.name.name == b"display"
              && (match f.name.module { Some(m) -> m.name == shown_binder(), None -> false }),
          _ -> false,
        }),
    _ -> false,
  }

/// A span without the parentheses a grouping widened it by, a pair a round.
fn ungrouped(input: PrintInput, span: Span) -> Span / {abort.raise} =
  iterate(span, (span.end - span.start) / 2 + 1, |cur: Span|
    if cur.end - cur.start >= 2 && input.source.at(cur.start) == 40
        && input.source.at(cur.end - 1) == 41 {
      let inner = span_between(skip_ws(input, cur.start + 1), back_ws(input, cur.end - 1));
      if inner.start >= inner.end { Stop(cur) } else { Continue(inner) }
    } else { Stop(cur) })

/// A concatenation the program wrote may open with an interpolated string too, so the span must be
/// exactly one: the `"` closing its first `f"` is the span's last token.
fn one_interpolation(input: PrintInput, grouped: Span) -> Bool / {abort.raise} = {
  let span = ungrouped(input, grouped);
  if span.end - span.start < 2 || input.source.slice(span.start, span.start + 2) != b"f\"" { false }
  else {
    let toks = lex(input.source.slice(span.start, span.end)).tokens;
    let walked = toks.fold(
      { open: 0, closed: -1, i: 0 },
      |acc: { open: Int, closed: Int, i: Int }, token: Token| {
        let open = match token.kind {
          InterpolatedHead(_) -> acc.open + 1,
          InterpolatedTail(_) -> acc.open - 1,
          _ -> acc.open,
        };
        {
          open: open,
          closed: if acc.closed < 0 && acc.open > 0 && open == 0 { acc.i } else { acc.closed },
          i: acc.i + 1,
        }
      },
    );
    walked.closed == toks.len() - 2
  }
}

/// Each piece of the concatenation printed, left to right.
fn pieces(input: PrintInput, expr: Expr) -> Option<Bytes> / {abort.raise} =
  match expr {
    EBinary(v) -> if v.op == b"concat" { cat([pieces(input, v.lhs), pieces(input, v.rhs)]) }
    else { piece(input, expr) },
    _ -> piece(input, expr),
  }

/// A text piece's token runs from the `f"` or `}` before it to the `{` or `"` after it.
fn piece(input: PrintInput, expr: Expr) -> Option<Bytes> / {abort.raise} =
  match expr {
    ELit(v) -> if sourced(input, v.span) {
      let lead = if input.source.slice(v.span.start, v.span.start + 2) == b"f\"" { 2 } else { 1 };
      Some(input.source.slice(v.span.start + lead, v.span.end - 1))
    } else { match v.lit { LStr(s) -> Some(template_text(s)), _ -> None } },
    EApp(v) -> match v.args {
      [x] -> match flat_expr(input, x) { Some(flat) -> Some(hole_text(flat)), None -> None },
      _ -> None,
    },
    _ -> None,
  }

/// An interpolated string a hole of which no line holds, each such hole laid out in its braces.
fn pieces_laid(
  input: PrintInput,
  printer: Printer,
  expr: Expr,
  indent: Int,
) -> Printer / {abort.raise} =
  match expr {
    EBinary(v) -> if v.op == b"concat" {
      pieces_laid(input, pieces_laid(input, printer, v.lhs, indent), v.rhs, indent)
    } else { piece_laid(input, printer, expr, indent) },
    _ -> piece_laid(input, printer, expr, indent),
  }

fn piece_laid(
  input: PrintInput,
  printer: Printer,
  expr: Expr,
  indent: Int,
) -> Printer / {abort.raise} =
  match expr {
    EApp(v) -> match v.args {
      [x] -> match flat_expr(input, x) {
        Some(flat) -> emit(printer, hole_text(flat)),
        None -> hole_laid(input, printer, x, indent),
      },
      _ -> printer,
    },
    _ -> match piece(input, expr) { Some(text) -> emit(printer, text), None -> printer },
  }

fn flat_expr(p: PrintInput, expr: Expr) -> Option<Bytes> / {abort.raise} =
  match interpolated(p, expr) { Some(text) -> Some(text), None -> flat_node(p, expr) }

/// A record update's base as its grammar reads one: a path, or one call of it, which takes no
/// parentheses round the path.
fn flat_base(input: PrintInput, base: Expr) -> Option<Bytes> / {abort.raise} =
  match base {
    EApp(v) ->
      cat([flat_expr(input, v.func), Some(b"("), flat_args(input, v.args, v.named), Some(b")")]),
    _ -> flat_expr(input, base),
  }

fn flat_node(input: PrintInput, e: Expr) -> Option<Bytes> / {abort.raise} =
  match e {
    ELit(v) -> if is_lines(input, e) { None } else { Some(lit_text(input, v.span, v.lit)) },
    EHole(v) -> Some(v.text),
    ETagged(v) -> tagged_flat(input, v),
    EVar(v) -> Some(qname_text(v.name)),
    EBinary(v) ->
      cat([
        wrap(flat_expr(input, v.lhs), parens_operand(v.lhs, v.op, false)),
        Some(Bytes::concat_all([b" ", op_text(v.op), b" "])),
        wrap(flat_expr(input, v.rhs), parens_operand(v.rhs, v.op, true)),
      ]),
    EUnary(v) ->
      cat([Some(unary_text(v.op)), wrap(flat_expr(input, v.operand), parens_unary(v.operand))]),
    ELambda(v) ->
      cat([Some(lambda_head(input, v.params, v.ret)), Some(b" "), flat_expr(input, v.body)]),
    EApp(v) -> match literal_of(input, e) {
      Some(m) -> flat_literal(input, m),
      None ->
        cat([
          wrap(flat_expr(input, v.func), parens_callee(v.func, v.named.len() > 0)),
          Some(call_labels(v.labels)),
          Some(b"("),
          flat_args(input, v.args, v.named),
          Some(b")"),
        ]),
    },
    EIf(v) ->
      cat([
        Some(b"if "),
        flat_scrutinee(input, v.cond),
        Some(b" "),
        flat_expr(input, v.then_branch),
        flat_else(input, v.else_branch),
      ]),
    EMatch(v) ->
      cat([
        Some(b"match "),
        flat_scrutinee(input, v.scrutinee),
        if v.arms.len() == 0 { Some(b" {}") } else {
          cat([
            Some(b" { "),
            sep(v.arms.map(|arm: MatchArm| flat_arm(input, arm)), b", "),
            Some(b" }"),
          ])
        },
      ]),
    EBlock(v) -> if v.stmts.len() > 0 { None } else {
      match v.tail {
        None -> Some(b"{}"),
        Some(t) -> cat([Some(b"{ "), flat_expr(input, t), Some(b" }")]),
      }
    },
    ERecord(v) -> if is_tuple(v.fields) {
      cat([
        Some(b"("),
        sep(v.fields.map(|field: RecField| flat_expr(input, field.value)), b", "),
        Some(b")"),
      ])
    } else {
      cat([
        Some(b"{ "),
        sep(v.fields.map(|field: RecField| flat_field(input, field, v.fields.len() > 1)), b", "),
        Some(b" }"),
      ])
    },
    ERecordUpdate(v) ->
      cat([
        Some(b"{ .."),
        flat_base(input, v.base),
        Some(if v.fields.len() == 0 { b"" } else { b", " }),
        sep(v.fields.map(|field: RecField| flat_field(input, field, true)), b", "),
        Some(b" }"),
      ]),
    ETry(v) -> cat([wrap(flat_expr(input, v.operand), parens_postfix(v.operand)), Some(b"?")]),
    EField(v) ->
      cat([
        wrap(flat_expr(input, v.base), parens_postfix(v.base)),
        Some(b".".concat(v.field.name)),
      ]),
    EList(v) -> if v.items.len() == 0 { Some(b"[]") }
    else { cat([Some(b"["), sep(v.items.map(|x: Expr| flat_expr(input, x)), b", "), Some(b"]")]) },
    EPerform(v) ->
      cat([
        Some(perform_head(v.eff, v.op, v.resource)),
        Some(b"("),
        sep(v.args.map(|x: Expr| flat_expr(input, x)), b", "),
        Some(b")"),
      ]),
    EHandle(v) -> if v.vars.len() > 0 { None } else {
      cat([
        Some(b"handle "),
        flat_expr(input, v.body),
        Some(b" with "),
        flat_clauses(input, v.clauses, v.ret),
      ])
    },
    EWithHold(v) ->
      cat([
        Some(Bytes::concat_all([b"with_hold[", v.resource.name, b"]("])),
        flat_expr(input, v.acquire),
        Some(b", "),
        flat_expr(input, v.release),
        Some(Bytes::concat_all([b") { ", v.binder.name, b" -> "])),
        flat_expr(input, v.body),
        Some(b" }"),
      ]),
    ESimulate(v) -> cat([Some(b"simulate "), flat_expr(input, v.body)]),
    ETryBlock(v) -> cat([Some(try_head(v.raise)), flat_expr(input, v.body)]),
    EParallel(v) ->
      cat([
        Some(b"parallel { "),
        sep(v.branches.map(|x: Expr| flat_expr(input, x)), b", "),
        Some(b" }"),
      ]),
    EBad(_) -> Some(b"()"),
  }

fn flat_len(p: PrintInput, expr: Expr) -> Int / {abort.raise} =
  match flat_expr(p, expr) { Some(f) -> f.len(), None -> 0 }

// --- Expressions, broken across lines --------------------------------------

/// `indent` is where this node's continuation lines go; `after` is what follows it on its last line.
fn expr(
  input: PrintInput,
  printer: Printer,
  e: Expr,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = laid(input, printer, e, indent, indent + 2, after)

/// `cont` is where a broken operator chain puts its lines: one level in from where the chain began,
/// and that level however its operators nest, so a wrapped chain does not step rightwards.
/// A node that starts mid-line with comments before it moves to a line of its own, one level in,
/// which is where a second pass finds it again.
fn laid(
  input: PrintInput,
  printer: Printer,
  e: Expr,
  indent: Int,
  cont: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let sp = expr_span(e);
  // On its own line the node starts at the indent, so it is laid out there.
  if printer.column > indent && comment_before(input, printer, sp.start) {
    laid_here(input, nl(printer, indent + 2, false), e, indent + 2, indent + 4, after)
  } else { laid_here(input, printer, e, indent, cont, after) }
}

fn laid_here(
  input: PrintInput,
  printer: Printer,
  e: Expr,
  indent: Int,
  cont: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let sp = expr_span(e);
  let s0 = lead(input, printer, sp.start, indent);
  let s1 = match try_flat(input, s0, flat_expr(input, e), sp.end, after) {
    Some(f) -> emit(s0, f),
    None -> broken(input, s0, e, indent, cont, after),
  };
  absorb(input, s1, sp.end)
}

fn operand(
  input: PrintInput,
  printer: Printer,
  e: Expr,
  parens: Bool,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} =
  if parens { emit(expr(input, emit(printer, b"("), e, indent, after + 1), b")") }
  else { expr(input, printer, e, indent, after) }

fn scrutinee(
  input: PrintInput,
  printer: Printer,
  expr: Expr,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = operand(input, printer, expr, parens_scrutinee(expr), indent, after)

/// The operator opens every line of a broken chain after the first, and each of them sits at `cont`,
/// whether what nests there is a tighter operator or a bracketed group.
fn chain(
  input: PrintInput,
  printer: Printer,
  lhs: Expr,
  op: Bytes,
  rhs: Expr,
  cont: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let s1 = chain_operand(input, printer, lhs, parens_operand(lhs, op, false), cont, 0);
  let s2 = emit(nl(s1, cont, false), op_text(op).concat(b" "));
  chain_operand(input, s2, rhs, parens_operand(rhs, op, true), cont, after)
}

fn chain_operand(
  input: PrintInput,
  printer: Printer,
  expr: Expr,
  parens: Bool,
  cont: Int,
  after: Int,
) -> Printer / {abort.raise} =
  if parens { emit(laid(input, emit(printer, b"("), expr, cont, cont, after + 1), b")") }
  else { laid(input, printer, expr, cont, cont, after) }

fn broken(
  input: PrintInput,
  printer: Printer,
  expr: Expr,
  indent: Int,
  cont: Int,
  after: Int,
) -> Printer / {abort.raise} =
  match interpolated(input, expr) {
    Some(text) -> emit(printer, text),
    None -> if one_string(input, expr) {
      emit(pieces_laid(input, emit(printer, b"f\""), expr, indent), b"\"")
    } else { broken_node(input, printer, expr, indent, cont, after) },
  }

fn broken_node(
  input: PrintInput,
  printer: Printer,
  expr: Expr,
  indent: Int,
  cont: Int,
  after: Int,
) -> Printer / {abort.raise} =
  match expr {
    ELit(v) -> match v.lit {
      LStr(value) -> if is_lines(input, expr) { line_string(printer, value, indent, cont) }
      else { emit(printer, lit_text(input, v.span, v.lit)) },
      _ -> emit(printer, lit_text(input, v.span, v.lit)),
    },
    ETagged(v) -> match tagged_flat(input, v) {
      Some(text) -> emit(printer, text),
      None -> tagged_laid(input, printer, v, indent),
    },
    EHole(v) -> emit(printer, v.text),
    EVar(v) -> emit(printer, qname_text(v.name)),
    EBinary(v) -> chain(input, printer, v.lhs, v.op, v.rhs, cont, after),
    EUnary(v) ->
      operand(
        input,
        emit(printer, unary_text(v.op)),
        v.operand,
        parens_unary(v.operand),
        indent,
        after,
      ),
    ELambda(v) -> lambda(input, printer, v.params, v.ret, v.body, indent, after),
    EApp(v) -> match literal_of(input, expr) {
      Some(m) -> literal(input, printer, m, indent),
      None -> {
        let ls = call_labels(v.labels);
        let s1 = operand(
          input,
          printer,
          v.func,
          parens_callee(v.func, v.named.len() > 0),
          indent,
          1 + ls.len(),
        );
        call(input, emit(s1, ls), v.args, v.named, v.span, indent, after)
      },
    },
    EIf(v) -> if_chain(input, printer, v, indent, after),
    EMatch(v) -> match_expr(input, printer, v.scrutinee, v.arms, v.span, indent),
    EBlock(v) -> block_of(input, printer, v, indent),
    ERecord(v) -> if is_tuple(v.fields) {
      elements(
        input,
        printer,
        b"(",
        v.fields.map(|field: RecField| field.value),
        b")",
        v.span,
        indent,
      )
    } else { record(input, printer, None, v.fields, v.span, indent) },
    ERecordUpdate(v) -> record(input, printer, Some(v.base), v.fields, v.span, indent),
    ETry(v) ->
      emit(operand(input, printer, v.operand, parens_postfix(v.operand), indent, after + 1), b"?"),
    EField(v) ->
      emit(
        operand(
          input,
          printer,
          v.base,
          parens_postfix(v.base),
          indent,
          after + 1 + v.field.name.len(),
        ),
        b".".concat(v.field.name),
      ),
    EList(v) -> elements(input, printer, b"[", v.items, b"]", v.span, indent),
    EPerform(v) ->
      call(
        input,
        emit(printer, perform_head(v.eff, v.op, v.resource)),
        v.args,
        [],
        v.span,
        indent,
        after,
      ),
    EHandle(v) -> handle_expr(input, printer, v, indent),
    EWithHold(v) -> {
      let head = emit(printer, Bytes::concat_all([b"with_hold[", v.resource.name, b"]"]));
      let opened = emit(
        call(
          input,
          head,
          [v.acquire, v.release],
          [],
          { ..v.span, end: expr_span(v.release).end },
          indent,
          v.binder.name.len() + 7,
        ),
        Bytes::concat_all([b" { ", v.binder.name, b" ->"]),
      );
      region_body(input, opened, v.body, v.span, indent)
    },
    ESimulate(v) -> block(input, emit(printer, b"simulate "), v.body, indent),
    ETryBlock(v) -> block(input, emit(printer, try_head(v.raise)), v.body, indent),
    // Trailing comments are read from the end of the keyword, where the braces' own span would start.
    EParallel(v) ->
      elements(
        input,
        emit(printer, b"parallel "),
        b"{",
        v.branches,
        b"}",
        { ..v.span, start: v.span.start + 7 },
        indent,
      ),
    EBad(_) -> emit(printer, b"()"),
  }

/// A block always breaks: `{`, its statements and tail one per line, `}` back at `indent`.
fn block(input: PrintInput, printer: Printer, e: Expr, indent: Int) -> Printer / {abort.raise} =
  match e {
    EBlock(v) -> block_of(input, printer, v, indent),
    _ -> expr(input, printer, e, indent, 0),
  }

fn block_of(
  input: PrintInput,
  printer: Printer,
  v: { span: Span, tail: Option<Expr>, stmts: List<Stmt> },
  indent: Int,
) -> Printer / {abort.raise} = {
  let has_tail = match v.tail { Some(_) -> true, None -> false };
  if v.stmts.len() == 0 && !has_tail && !comment_before(input, printer, v.span.end) {
    emit(printer, b"{}")
  } else {
    let s1 = set_prev(trail(input, emit(printer, b"{"), v.span.start + 1), v.span.start + 1);
    let s2 = v.stmts.fold(s1, |s: Printer, x: Stmt| stmt(input, s, x, indent + 2));
    let s3 = match v.tail {
      Some(t) -> {
        let tsp = expr_span(t);
        let s = expr(input, open_line(input, s2, tsp.start, indent + 2, true), t, indent + 2, 0);
        trail(input, set_prev(s, tsp.end), tsp.end)
      },
      None -> s2,
    };
    close(input, s3, v.span.end, indent, b"}")
  }
}

fn stmt(input: PrintInput, printer: Printer, x: Stmt, indent: Int) -> Printer / {abort.raise} =
  match x {
    SLet(v) -> {
      let s1 = open_line(input, printer, v.span.start, indent, true);
      let ty = match v.ty { Some(t) -> b": ".concat(type_text(input, t)), None -> b"" };
      let s2 = emit(s1, Bytes::concat_all([b"let ", pattern_text(input, v.pat), ty, b" = "]));
      let s4 = emit(expr(input, s2, v.value, indent, 1), b";");
      trail(input, set_prev(s4, v.span.end), v.span.end)
    },
    SLetElse(v) -> {
      let s1 = open_line(input, printer, v.span.start, indent, true);
      let ty = match v.ty { Some(t) -> b": ".concat(type_text(input, t)), None -> b"" };
      let s2 = emit(s1, Bytes::concat_all([b"let ", pattern_text(input, v.pat), ty, b" = "]));
      let s3 = emit(expr(input, s2, v.value, indent, 7), b" else ");
      // A short `else` stays on the line, as an `if` branch does.
      let s4 = emit(branch(input, s3, v.fallback, indent, 1).printer, b";");
      trail(input, set_prev(s4, v.span.end), v.span.end)
    },
    SExpr(e) -> {
      let sp = expr_span(e);
      let s1 = open_line(input, printer, sp.start, indent, true);
      let s2 = emit(expr(input, s1, e, indent, 1), b";");
      trail(input, set_prev(s2, sp.end), sp.end)
    },
    SAssign(v) -> {
      let s1 = open_line(input, printer, v.span.start, indent, true);
      let s2 = emit(s1, v.name.name.concat(b" = "));
      let s3 = emit(expr(input, s2, v.value, indent, 1), b";");
      trail(input, set_prev(s3, v.span.end), v.span.end)
    },
  }

fn lambda(
  input: PrintInput,
  printer: Printer,
  params: List<Param>,
  ret: Option<TypeExpr>,
  body: Expr,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let s1 = emit(printer, lambda_head(input, params, ret));
  let sp = expr_span(body);
  match body {
    EBlock(v) -> block_of(input, emit(s1, b" "), v, indent),
    _ -> match try_flat(input, s1, flat_expr(input, body), sp.end, after + 1) {
      Some(f) -> emit(emit(s1, b" "), f),
      None -> expr(input, nl(s1, indent + 2, false), body, indent + 2, after),
    },
  }
}

/// One that starts short and ends with its own closer, so it may hug the call's parentheses.
fn huggable(expr: Expr) -> Bool =
  match expr {
    ELambda(_) -> true,
    ERecord(_) -> true,
    ERecordUpdate(_) -> true,
    EList(_) -> true,
    _ -> is_block_like(expr),
  }

fn head_width(input: PrintInput, expr: Expr) -> Int / {abort.raise} =
  match expr {
    ELambda(v) -> lambda_head(input, v.params, v.ret).len() + 2,
    EMatch(v) -> 8 + flat_len(input, v.scrutinee),
    EIf(v) -> 5 + flat_len(input, v.cond),
    EHandle(_) -> 8,
    EWithHold(v) ->
      18 + v.resource.name.len() + flat_len(input, v.acquire) + flat_len(input, v.release)
        + v.binder.name.len(),
    _ -> 1,
  }

/// After the callee: the last argument hugs the parentheses when it can, else one argument per line.
fn call(
  input: PrintInput,
  printer: Printer,
  args: List<Expr>,
  named: List<NamedArg>,
  span: Span,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let n = args.len();
  let hugged = match args.at(n - 1) {
    Some(last) -> if named.len() == 0 && huggable(last)
        && !comment_before(input, printer, expr_span(last).start) {
      let prefix = sep(range(0, n - 1).map(|i: Int| flat_expr(input, args.get(i))), b", ");
      match prefix {
        Some(pre) -> {
          let text = b"(".concat(if n > 1 { pre.concat(b", ") } else { pre });
          if fits(printer, text, head_width(input, last) + after + 1) { Some(text) } else { None }
        },
        None -> None,
      }
    } else { None },
    None -> None,
  };
  match hugged {
    Some(text) -> emit(expr(input, emit(printer, text), args.get(n - 1), indent, after + 1), b")"),
    None -> {
      let s1 = emit(printer, b"(");
      let s2 = range(0, n).fold(s1, |s: Printer, i: Int|
        element(input, s, args.get(i), indent + 2, i == n - 1 && named.len() == 0));
      let s3 = range(0, named.len()).fold(s2, |s: Printer, i: Int| {
        let a = named.get(i);
        let o = emit(
          open_line(input, s, a.span.start, indent + 2, false),
          a.name.name.concat(b": "),
        );
        let v = separated(
          input,
          expr(input, o, a.value, indent + 2, 1),
          a.value,
          i == named.len() - 1,
        );
        trail(input, set_prev(v, a.span.end), a.span.end)
      });
      close(input, s3, span.end, indent, b")")
    },
  }
}

fn element(
  input: PrintInput,
  printer: Printer,
  e: Expr,
  indent: Int,
  last: Bool,
) -> Printer / {abort.raise} = {
  let sp = expr_span(e);
  let s = separated(
    input,
    expr(input, open_line(input, printer, sp.start, indent, false), e, indent, 1),
    e,
    last,
  );
  trail(input, set_prev(s, sp.end), sp.end)
}

/// A list's separator, except after a last line string, where it would need a line to itself.
fn separated(
  input: PrintInput,
  printer: Printer,
  expr: Expr,
  last: Bool,
) -> Printer / {abort.raise} =
  if last && is_lines(input, expr) { printer } else { emit(printer, b",") }

fn elements(
  input: PrintInput,
  printer: Printer,
  open: Bytes,
  items: List<Expr>,
  closer: Bytes,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = set_prev(trail(input, emit(printer, open), span.start + 1), span.start + 1);
  let s2 = range(0, items.len()).fold(s1, |s: Printer, i: Int|
    element(input, s, items.get(i), indent + 2, i == items.len() - 1));
  close(input, s2, span.end, indent, closer)
}

/// A map literal the parser built a `Map::of_entries` call of, which the source still opens with
/// `#{` where a call spelled out never does, or a set literal, whose call no source can spell.
type Literal = { set: Bool, items: List<Expr>, span: Span }

fn literal_of(input: PrintInput, e: Expr) -> Option<Literal> / {abort.raise} =
  match e {
    EApp(a) -> match ((a.func, a.args)) {
      (EVar(f), [EList(l)]) -> match f.name.module {
        Some(m) -> if m.name == set_binder() { Some({ set: true, items: l.items, span: a.span }) }
        else if m.name == map_literal_call().binder && f.name.name.name == map_literal_call().name
            && opens_map(input, a.span, l.items) {
          Some({ set: false, items: l.items, span: a.span })
        } else { None },
        None -> None,
      },
      _ -> None,
    },
    _ -> None,
  }

/// Whether a `Map::of_entries` call was a map literal: its source opens with `#{`, or, where no
/// source covers it, each of its entries is the record of a key and a value one is written as.
fn opens_map(input: PrintInput, span: Span, items: List<Expr>) -> Bool / {abort.raise} =
  if sourced(input, span) { input.source.slice(span.start, span.start + 2) == b"#{" } else {
    items.fold(true, |ok: Bool, x: Expr|
      ok
        && (match x {
          ERecord(r) -> match r.fields {
            [k, v] -> k.name.name == b"key" && v.name.name == b"value",
            _ -> false,
          },
          _ -> false,
        }))
  }

/// The parser writes each entry of a literal as a record of its key and value; an item it did not
/// write so is its own key and value.
fn entry_parts(x: Expr) -> Option<{ key: Expr, value: Expr }> =
  match x {
    ERecord(r) -> match field_of(r.fields, b"key") {
      Some(k) -> match field_of(r.fields, b"value") {
        Some(v) -> Some({ key: k, value: v }),
        None -> None,
      },
      None -> None,
    },
    _ -> None,
  }

fn field_of(fields: List<RecField>, name: Bytes) -> Option<Expr> =
  fields.fold(None, |acc: Option<Expr>, field: RecField|
    if field.name.name == name { Some(field.value) } else { acc })

/// How an expression the parser built of other nodes was written, which only its source says.
pub type Spelling =
  | AsParsed
  /// `f"a {x} b"`: the values in its holes, in order.
  | Interpolated(List<Expr>)
  /// `#{k: v, ..}`: its entries, in order.
  | MapLiteral(List<{ key: Expr, value: Expr }>)
  /// `#[a, ..]`: its items, in order.
  | SetLiteral(List<Expr>)

/// How `e` is written in `source`, the text it was parsed from; where `source` does not cover `e`'s
/// span, how a tree of its shape is printed.
pub fn spelling(source: Bytes, e: Expr) -> Spelling / {abort.raise} = {
  let input: PrintInput = { source: source, comments: [] };
  match literal_of(input, e) {
    Some(m) -> {
      let entries = m.items.map(|x: Expr|
        match entry_parts(x) { Some(parts) -> parts, None -> { key: x, value: x } });
      if m.set { SetLiteral(entries.map(|entry: { key: Expr, value: Expr }| entry.key)) }
      else { MapLiteral(entries) }
    },
    None -> if one_string(input, e) { Interpolated(holes_of(e)) } else { AsParsed },
  }
}

/// The values in the holes of an interpolated string, as the parser's concatenation holds them.
pub fn holes_of(e: Expr) -> List<Expr> = holes_onto(e, [])

fn holes_onto(e: Expr, found: List<Expr>) -> List<Expr> =
  match e {
    EBinary(v) -> if v.op == b"concat" { holes_onto(v.rhs, holes_onto(v.lhs, found)) }
    else { found },
    EApp(v) -> match v.args { [x] -> found.push(x), _ -> found },
    _ -> found,
  }

fn flat_literal(input: PrintInput, m: Literal) -> Option<Bytes> / {abort.raise} =
  if m.set {
    cat([Some(b"#["), sep(m.items.map(|x: Expr| flat_expr(input, x)), b", "), Some(b"]")])
  } else {
    let entry = |key: Expr, value: Expr|
      cat([flat_expr(input, key), Some(b": "), flat_expr(input, value)]);
    cat([
      Some(b"#{"),
      sep(
        m.items.map(|x: Expr|
          match entry_parts(x) { Some(en) -> entry(en.key, en.value), None -> entry(x, x) }),
        b", ",
      ),
      Some(b"}"),
    ])
  }

/// One entry a line, as a record's fields are; a key stays on its line, flat.
fn literal(p: PrintInput, printer: Printer, m: Literal, indent: Int) -> Printer / {abort.raise} = {
  let open = if m.set { b"#[" } else { b"#{" };
  let s1 = set_prev(trail(p, emit(printer, open), m.span.start + 2), m.span.start + 2);
  let n = m.items.len();
  let s2 = range(0, n).fold(s1, |s: Printer, i: Int| {
    let entry = |key: Expr, value: Expr| {
      let ks = expr_span(key);
      let o = open_line(p, s, ks.start, indent + 2, false);
      if m.set {
        let v = separated(p, expr(p, o, key, indent + 2, 1), key, i == n - 1);
        trail(p, set_prev(v, ks.end), ks.end)
      } else {
        let vs = expr_span(value);
        let k = match flat_expr(p, key) { Some(f) -> f, None -> b"()" };
        let v = separated(
          p,
          expr(p, emit(o, k.concat(b": ")), value, indent + 2, 1),
          value,
          i == n - 1,
        );
        trail(p, set_prev(v, vs.end), vs.end)
      }
    };
    match m.items.at(i) {
      None -> s,
      Some(x) -> if m.set { entry(x, x) }
      else { match entry_parts(x) { Some(en) -> entry(en.key, en.value), None -> entry(x, x) } },
    }
  });
  close(p, s2, m.span.end, indent, if m.set { b"]" } else { b"}" })
}

fn record(
  p: PrintInput,
  printer: Printer,
  base: Option<Expr>,
  fields: List<RecField>,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = set_prev(trail(p, emit(printer, b"{"), span.start + 1), span.start + 1);
  let s2 = match base {
    Some(base_expr) -> {
      let bsp = expr_span(base_expr);
      let text = match flat_base(p, base_expr) { Some(f) -> f, None -> b"()" };
      let s = emit(
        open_line(p, s1, bsp.start, indent + 2, false),
        Bytes::concat_all([b"..", text, b","]),
      );
      trail(p, set_prev(s, bsp.end), bsp.end)
    },
    None -> s1,
  };
  let s3 = range(0, fields.len()).fold(s2, |s: Printer, i: Int| {
    let f = fields.get(i);
    let vsp = expr_span(f.value);
    let o = open_line(p, s, f.name.span.start, indent + 2, false);
    let v = if punned(f) { emit(o, f.name.name.concat(b",")) } else {
      let named = emit(o, f.name.name.concat(b": "));
      separated(p, expr(p, named, f.value, indent + 2, 1), f.value, i == fields.len() - 1)
    };
    trail(p, set_prev(v, vsp.end), vsp.end)
  });
  close(p, s3, span.end, indent, b"}")
}

/// A printed branch and whether its body had to open a block rather than stay on the branch's line.
type Branch = { opened: Bool, printer: Printer }

fn branch(
  input: PrintInput,
  printer: Printer,
  expr: Expr,
  indent: Int,
  after: Int,
) -> Branch / {abort.raise} = {
  let sp = expr_span(expr);
  match try_flat(input, printer, flat_expr(input, expr), sp.end, after) {
    Some(f) -> { opened: false, printer: emit(printer, f) },
    None -> { opened: true, printer: block(input, printer, expr, indent) },
  }
}

/// What follows a branch on its line: the chain's follower once no `else` comes after it.
fn ending(expr: Expr, after: Int) -> Int = match expr { ELit(_) -> after, _ -> 0 }

fn fits_alone(input: PrintInput, expr: Expr, indent: Int, after: Int) -> Bool / {abort.raise} = {
  let head = match expr {
    EIf(v) ->
      cat([
        Some(b"if "),
        flat_scrutinee(input, v.cond),
        Some(b" "),
        flat_expr(input, v.then_branch),
      ]),
    _ -> flat_expr(input, expr),
  };
  let tail = match expr { EIf(v) -> ending(v.else_branch, after), _ -> after };
  match head { Some(f) -> indent + 5 + f.len() + tail <= width(), None -> false }
}

fn fits_opening(input: PrintInput, printer: Printer, expr: Expr) -> Bool / {abort.raise} = {
  let opening = match expr {
    EIf(v) -> cat([Some(b" else if "), flat_scrutinee(input, v.cond), Some(b" {")]),
    _ -> Some(b" else {"),
  };
  match opening { Some(o) -> fits(printer, o, 0), None -> false }
}

/// Before a block, `else` joins the line only where the opening fits: no condition breaks for it.
fn otherwise(
  input: PrintInput,
  b: Branch,
  expr: Expr,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let start = expr_span(expr).start;
  if comment_before(input, b.printer, start) {
    emit(open_line(input, b.printer, start, indent, false), b"else ")
  } else if b.opened
      || (!fits_alone(input, expr, indent, after) && fits_opening(input, b.printer, expr)) {
    emit(b.printer, b" else ")
  } else { emit(nl(b.printer, indent, false), b"else ") }
}

/// A chain the width forced open, one branch to a line.
fn if_chain(
  input: PrintInput,
  printer: Printer,
  v: { span: Span, cond: Expr, then_branch: Expr, else_branch: Expr },
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let s1 = scrutinee(input, emit(printer, b"if "), v.cond, indent + 2, 2);
  let o = v.else_branch;
  let b = branch(input, emit(s1, b" "), v.then_branch, indent, ending(o, after));
  match o {
    ELit(_) -> b.printer,
    EIf(w) -> if_chain(input, otherwise(input, b, o, indent, after), w, indent, after),
    _ -> branch(input, otherwise(input, b, o, indent, after), o, indent, after).printer,
  }
}

fn match_expr(
  input: PrintInput,
  printer: Printer,
  scrut: Expr,
  arms: List<MatchArm>,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = emit(scrutinee(input, emit(printer, b"match "), scrut, indent + 2, 2), b" {");
  let s2 = range(0, arms.len()).fold(s1, |s: Printer, i: Int|
    arm(input, s, arms.get(i), indent + 2, i == arms.len() - 1));
  close(input, s2, span.end, indent, b"}")
}

fn arm(
  input: PrintInput,
  printer: Printer,
  a: MatchArm,
  indent: Int,
  last: Bool,
) -> Printer / {abort.raise} = {
  let s1 = emit(open_line(input, printer, a.span.start, indent, false), pattern_text(input, a.pat));
  let s2 = match a.guard {
    Some(g) -> expr(input, emit(s1, b" if "), g, indent + 2, 3),
    None -> s1,
  };
  let s4 = separated(input, arm_body(input, emit(s2, b" ->"), a.body, indent), a.body, last);
  trail(input, set_prev(s4, a.span.end), a.span.end)
}

/// After `->`: the body on the same line when it fits or opens a block, else on the next.
fn arm_body(
  input: PrintInput,
  printer: Printer,
  body: Expr,
  indent: Int,
) -> Printer / {abort.raise} = {
  let sp = expr_span(body);
  match try_flat(input, printer, flat_expr(input, body), sp.end, 2) {
    Some(f) -> emit(emit(printer, b" "), f),
    None -> if is_block_like(body) || (match body { ELambda(_) -> true, _ -> false }) {
      expr(input, emit(printer, b" "), body, indent, 1)
    } else { expr(input, nl(printer, indent + 2, false), body, indent + 2, 1) },
  }
}

fn handle_expr(
  input: PrintInput,
  printer: Printer,
  h: { span: Span, body: Expr, ret: Option<ReturnClause>, clauses: List<HandleClause>, vars: List<HandlerVar> },
  indent: Int,
) -> Printer / {abort.raise} = {
  let clauses = h.clauses;
  let ret = h.ret;
  let s1 = emit(printer, b"handle ");
  let s2 = match h.body {
    EBlock(v) -> block_of(input, s1, v, indent),
    _ -> expr(input, s1, h.body, indent + 2, 7),
  };
  let s3v = emit(s2, b" with {");
  let s3 = range(0, h.vars.len()).fold(s3v, |s: Printer, i: Int| {
    let v = h.vars.get(i);
    let ty = match v.ty { Some(t) -> b": ".concat(type_text(input, t)), None -> b"" };
    let o = emit(
      open_line(input, s, v.span.start, indent + 2, false),
      Bytes::concat_all([b"var ", v.name.name, ty, b" = "]),
    );
    let last = i == h.vars.len() - 1 && clauses.len() == 0
      && (match ret { Some(_) -> false, None -> true });
    let bd = separated(input, expr(input, o, v.init, indent + 2, 1), v.init, last);
    trail(input, set_prev(bd, v.span.end), v.span.end)
  });
  let s4 = range(0, clauses.len()).fold(s3, |s: Printer, i: Int| {
    let c = clauses.get(i);
    let o = emit(
      open_line(input, s, c.span.start, indent + 2, false),
      clause_head(c).concat(b" ->"),
    );
    let last = i == clauses.len() - 1 && (match ret { Some(_) -> false, None -> true });
    let bd = separated(input, arm_body(input, o, c.body, indent + 2), c.body, last);
    trail(input, set_prev(bd, c.span.end), c.span.end)
  });
  let s5 = match ret {
    Some(r) -> {
      let o = emit(
        open_line(input, s4, r.span.start, indent + 2, false),
        Bytes::concat_all([b"return ", r.binder.name, b" ->"]),
      );
      let bd = separated(input, arm_body(input, o, r.body, indent + 2), r.body, true);
      trail(input, set_prev(bd, r.span.end), r.span.end)
    },
    None -> s4,
  };
  close(input, s5, h.span.end, indent, b"}")
}

/// A region's body after its `binder ->`, through the `}` that closes the region.
fn region_body(
  input: PrintInput,
  printer: Printer,
  body: Expr,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let bsp = expr_span(body);
  match body {
    EBlock(_) -> emit(block(input, emit(printer, b" "), body, indent), b" }"),
    _ -> match try_flat(input, printer, flat_expr(input, body), bsp.end, 3) {
      Some(f) -> emit(printer, Bytes::concat_all([b" ", f, b" }"])),
      None -> {
        let s3 = expr(input, nl(printer, indent + 2, false), body, indent + 2, 0);
        emit(nl(flush_comments(input, s3, span.end, indent + 2, false), indent, false), b"}")
      },
    },
  }
}

// --- Items ------------------------------------------------------------------

/// `imports` and `items`, read out of `source`, printed as a module of their own: no comment is kept,
/// so the text is a function of the items alone and not of where `source` holds them.
pub fn printed_alone(
  source: Bytes,
  imports: List<ImportDecl>,
  items: List<Item>,
) -> Bytes / {abort.raise} =
  module({ source: source, comments: [] }, {
    doc: None,
    imports: imports,
    items: items.map(with_operators),
  })

/// `m` printed with no source, as a tree built rather than parsed is: its spans may all be dummy
/// ones, every literal is spelled from its value, and a blank line parts its items. The text parses
/// back to `m`, spans aside, where `m` is a tree a parse can make and holds no doc, which only a
/// source's comments print.
pub fn module_text(m: Module) -> Bytes / {abort.raise} = printed_alone(b"", m.imports, m.items)

fn module(input: PrintInput, m: Module) -> Bytes / {abort.raise} = {
  let st0 = { next_comment: 0, column: 0, previous_end: 0, pending: [], closed: -1, parts: [] };
  let s1 = m.imports.filter(is_written).fold(st0, |printer: Printer, decl: ImportDecl|
    import_decl(input, printer, decl));
  let s2 = m.items.fold(s1, |printer: Printer, it: Item| item(input, printer, it));
  finish(flush_comments(input, s2, input.source.len() + 1, 0, true))
}

fn import_decl(input: PrintInput, printer: Printer, decl: ImportDecl) -> Printer / {abort.raise} = {
  let s1 = open_line(input, printer, decl.span.start, 0, true);
  let base = b"import ".concat(Bytes::join(decl.path.map(|ident: Ident| ident.name), b"."));
  let s2 = match decl.kind {
    IModule -> emit(s1, base),
    IAlias(a) -> emit(s1, Bytes::concat_all([base, b" as ", a.name])),
    INames(ns) -> fill(emit(s1, base.concat(b" (")), ns.map(|ident: Ident| ident.name)),
  };
  trail(input, set_prev(absorb(input, s2, decl.span.end), decl.span.end), decl.span.end)
}

/// Names packed onto lines, continuation lines aligned under the first.
fn fill(printer: Printer, names: List<Bytes>) -> Printer / {abort.raise} = {
  let col0 = printer.column;
  let n = names.len();
  range(0, n).fold(printer, |s: Printer, i: Int| {
    let piece = names.get(i).concat(if i == n - 1 { b")" } else { b"," });
    if i == 0 { emit(s, piece) }
    else if fits(s, piece, 1) { emit(s, b" ".concat(piece)) }
    else { emit(nl(s, col0, false), piece) }
  })
}

fn vis_text(v: Vis) -> Bytes = match v { VPub -> b"pub ", VPriv -> b"" }

fn constraint_text(c: Constraint) -> Bytes = constraint_written(c.deriver, c.param.name)

fn item(input: PrintInput, printer: Printer, it: Item) -> Printer / {abort.raise} = {
  let sp = item_span(it);
  let s1 = if sourced(input, sp) { open_line(input, printer, sp.start, 0, true) }
  else { nl(printer, 0, true) };
  let s2 = match it {
    IFn(d) -> fn_def(input, s1, d),
    IType(d) -> type_def(input, s1, d),
    IEffect(d) -> effect_def(input, s1, d),
    ITest(d) -> test_def(input, s1, d),
    ILaw(d) -> law_def(input, s1, d),
    ISchema(d) -> schema_def(input, s1, d),
    IDerive(d) ->
      emit(s1, Bytes::concat_all([b"derive ", deriver_text(d.deriver), b" for ", d.target.name])),
    IEffectSet(d) ->
      emit(
        s1,
        Bytes::concat_all([
          vis_text(d.vis),
          b"effect set ",
          d.name.name,
          b" = {",
          Bytes::join(members(d.atoms, d.includes), b", "),
          b"}",
        ]),
      ),
    IExtern(d) -> extern_def(input, s1, d),
    IInstance(d) ->
      emit(
        s1,
        Bytes::concat_all([instance_text(d.kind), b" for ", d.target.name, b" by ", d.by.name]),
      ),
    INumeric(d) ->
      emit(
        s1,
        Bytes::concat_all([
          b"numeric for ",
          d.target.name,
          b" by { ",
          Bytes::join(
            d.ops.map(|x: NumericOp| Bytes::concat_all([x.op.name, b": ", x.by.name])),
            b", ",
          ),
          b" }",
        ]),
      ),
  };
  trail(input, set_prev(absorb(input, s2, sp.end), sp.end), sp.end)
}

/// A body after `= `: on the line when it fits, hugging when it is a block, else on the next.
fn def_body(input: PrintInput, printer: Printer, e: Expr, indent: Int) -> Printer / {abort.raise} = {
  let sp = expr_span(e);
  if comment_before(input, printer, sp.start) {
    expr(input, nl(printer, indent + 2, false), e, indent + 2, 0)
  } else {
    match try_flat(input, printer, flat_expr(input, e), sp.end, 0) {
      Some(f) -> emit(printer, f),
      None -> match e {
        EBlock(v) -> block_of(input, printer, v, indent),
        _ -> expr(input, nl(printer, indent + 2, false), e, indent + 2, 0),
      },
    }
  }
}

fn flat_param(input: PrintInput, param: Param) -> Option<Bytes> / {abort.raise} =
  match param.default {
    Some(e) -> cat([Some(param_head(input, param).concat(b" = ")), flat_expr(input, e)]),
    None -> Some(param_head(input, param)),
  }

fn param(input: PrintInput, printer: Printer, x: Param, indent: Int) -> Printer / {abort.raise} = {
  let s1 = emit(open_line(input, printer, x.span.start, indent, false), param_head(input, x));
  let s2 = match x.default {
    Some(e) -> expr(input, absorb(input, emit(s1, b" = "), expr_span(e).start), e, indent, 1),
    None -> absorb(input, s1, x.span.end),
  };
  trail(input, set_prev(emit(s2, b","), x.span.end), x.span.end)
}

fn fn_def(input: PrintInput, printer: Printer, def: FnDef) -> Printer / {abort.raise} = {
  let reuse_kw = match def.reuse { Some(_) -> b"reuse ", None -> b"" };
  let transparent_kw = match def.transparent { Some(_) -> b"transparent ", None -> b"" };
  let const_kw = match def.baked { Some(_) -> b"const ", None -> b"" };
  let head = Bytes::concat_all([
    vis_text(def.vis),
    transparent_kw,
    reuse_kw,
    const_kw,
    b"fn ",
    def.name.name,
    generics_text(def.generics),
  ]);
  let ret = match def.ret { Some(t) -> b" -> ".concat(type_text(input, t)), None -> b"" };
  let tail = ret.concat(row_suffix(input, def.effects));
  let clauses = def.constraints.len() > 0 || def.spec.len() > 0 || def.returns != None
    || (match def.decreases { Some(_) -> true, None -> false });
  let params_end = match def.params.at(def.params.len() - 1) {
    Some(x) -> x.span.end,
    None -> def.name.span.end,
  };
  let s1 = emit(printer, head);
  let flat = cat([
    Some(b"("),
    sep(def.params.map(|x: Param| flat_param(input, x)), b", "),
    Some(b")"),
    Some(tail),
  ]);
  let fit = if def.params.len() == 0 { flat }
  else { try_flat(input, s1, flat, params_end, if clauses { 0 } else { 2 }) };
  let s2 = match fit {
    Some(f) -> emit(s1, f),
    None -> {
      let ps = def.params.fold(emit(s1, b"("), |s: Printer, x: Param| param(input, s, x, 2));
      emit(close(input, ps, params_end, 0, b")"), tail)
    },
  };
  let s3 = if def.constraints.len() == 0 { s2 } else {
    emit(
      nl(s2, 2, false),
      b"where ".concat(Bytes::join(def.constraints.map(constraint_text), b", ")),
    )
  };
  let s35 = match def.returns {
    None -> s3,
    Some(ReturnsFresh(_)) -> emit(nl(s3, 2, false), b"returns fresh"),
    Some(ReturnsParam(x)) -> emit(nl(s3, 2, false), b"returns ".concat(x.name)),
  };
  let s4 = def.spec.fold(s35, |s: Printer, clause: SpecClause| spec_clause(input, s, clause));
  let s45 = match def.decreases {
    None -> s4,
    Some(m) -> {
      let span = expr_span(m);
      let o = emit(open_line(input, s4, span.start, 2, false), b"decreases ");
      trail(input, set_prev(expr(input, o, m, 2, 0), span.end), span.end)
    },
  };
  let s5 = if clauses { emit(nl(s45, 0, false), b"= ") } else { emit(s45, b" = ") };
  def_body(input, s5, def.body, 0)
}

fn spec_clause(input: PrintInput, printer: Printer, clause: SpecClause) -> Printer / {abort.raise} = {
  let o = emit(
    open_line(input, printer, clause.span.start, 2, false),
    spec_kind_text(clause.kind).concat(b" "),
  );
  let e = expr(input, o, clause.expr, 2, 0);
  trail(input, set_prev(e, clause.span.end), clause.span.end)
}

fn extern_def(input: PrintInput, printer: Printer, def: ExternDef) -> Printer / {abort.raise} = {
  let head = Bytes::concat_all([
    vis_text(def.vis),
    b"extern fn ",
    def.name.name,
    generics_text(def.generics),
  ]);
  let tail = Bytes::concat_all([
    b" -> ",
    type_text(input, def.ret),
    row_suffix(input, def.effects),
  ]);
  let params_end = match def.params.at(def.params.len() - 1) {
    Some(x) -> x.span.end,
    None -> def.name.span.end,
  };
  let s1 = emit(printer, head);
  let flat = cat([
    Some(b"("),
    sep(def.params.map(|x: Param| flat_param(input, x)), b", "),
    Some(b")"),
    Some(tail),
  ]);
  let fit = if def.params.len() == 0 { flat } else { try_flat(input, s1, flat, params_end, 0) };
  let s2 = match fit {
    Some(f) -> emit(s1, f),
    None -> {
      let ps = def.params.fold(emit(s1, b"("), |s: Printer, x: Param| param(input, s, x, 2));
      emit(close(input, ps, params_end, 0, b")"), tail)
    },
  };
  let s3 = if def.constraints.len() == 0 { s2 } else {
    emit(
      nl(s2, 2, false),
      b"where ".concat(Bytes::join(def.constraints.map(constraint_text), b", ")),
    )
  };
  def.spec.fold(s3, |s: Printer, clause: SpecClause| spec_clause(input, s, clause))
}

fn variant_text(input: PrintInput, variant: VariantDef) -> Bytes / {abort.raise} =
  if variant.fields.len() == 0 { variant.name.name } else {
    Bytes::concat_all([
      variant.name.name,
      b"(",
      Bytes::join(variant.fields.map(|ty: TypeExpr| type_text(input, ty)), b", "),
      b")",
    ])
  }

fn record_type(
  input: PrintInput,
  printer: Printer,
  fields: List<{ name: Ident, ty: TypeExpr }>,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = set_prev(trail(input, emit(printer, b"{"), span.start + 1), span.start + 1);
  let s2 = fields.fold(s1, |s: Printer, f: { name: Ident, ty: TypeExpr }| {
    let tsp = ty_span(f.ty);
    let o = emit(
      open_line(input, s, f.name.span.start, indent + 2, false),
      ty_field_text(input, f).concat(b","),
    );
    trail(input, set_prev(absorb(input, o, tsp.end), tsp.end), tsp.end)
  });
  close(input, s2, span.end, indent, b"}")
}

/// The type a declaration writes after its `=`: a record that does not fit goes one field to a line.
fn written_type(input: PrintInput, printer: Printer, t: TypeExpr) -> Printer / {abort.raise} =
  match t {
    TRecord(r) -> if is_ty_tuple(r.fields) { emit(printer, type_text(input, t)) } else {
      match try_flat(input, printer, Some(type_text(input, t)), r.span.end, 0) {
        Some(f) -> emit(printer, f),
        None -> record_type(input, printer, r.fields, r.span, 0),
      }
    },
    _ -> emit(printer, type_text(input, t)),
  }

fn type_def(input: PrintInput, printer: Printer, d: TypeDef) -> Printer / {abort.raise} =
  match d.body {
    TDExtern ->
      emit(
        printer,
        Bytes::concat_all([
          vis_text(d.vis),
          b"extern type ",
          d.name.name,
          generics_text(d.generics),
          where_text(d.constraints),
        ]),
      ),
    _ -> declared_type(input, printer, d),
  }

/// A type's `where`, where it writes one.
fn where_text(constraints: List<Constraint>) -> Bytes =
  if constraints.len() == 0 { b"" }
  else { b" where ".concat(Bytes::join(constraints.map(constraint_text), b", ")) }

/// A `type` with a body after its `=`.
fn declared_type(input: PrintInput, printer: Printer, d: TypeDef) -> Printer / {abort.raise} = {
  let params = generics_text(d.generics);
  let s1 = emit(
    printer,
    Bytes::concat_all([
      vis_text(d.vis),
      match d.opaque { Some(_) -> b"opaque ", None -> b"" },
      b"type ",
      d.name.name,
      params,
      where_text(d.constraints),
      b" = ",
    ]),
  );
  match d.body {
    TDAlias(t) -> written_type(input, s1, t),
    TDNominal(t) -> written_type(input, emit(s1, b"new "), t),
    TDExtern -> s1,
    TDSum(vs) -> {
      let flat = b"| ".concat(
        Bytes::join(vs.map(|variant: VariantDef| variant_text(input, variant)), b" | "),
      );
      match try_flat(input, s1, Some(flat), d.span.end, 0) {
        Some(f) -> emit(s1, f),
        None ->
          vs.fold(s1, |s: Printer, variant: VariantDef| {
            let o = emit(
              open_line(input, s, variant.span.start, 2, false),
              b"| ".concat(variant_text(input, variant)),
            );
            trail(
              input,
              set_prev(absorb(input, o, variant.span.end), variant.span.end),
              variant.span.end,
            )
          }),
      }
    },
  }
}

fn ident_chars() -> Bytes = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

fn is_ident_byte(c: Int) -> Bool =
  is_digit(c) || (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95

fn skip_ws(input: PrintInput, i: Int) -> Int / {abort.raise} =
  input.source.scan(i, b" \t\r\n", input.source.len() - i)

fn back_ws(input: PrintInput, i: Int) -> Int / {abort.raise} = back_blank(input.source, i)

fn back_blank(src: Bytes, i: Int) -> Int / {abort.raise} =
  iterate(i, i + 1, |k: Int|
    if k > 0 && (is_blank(src.at(k - 1)) || src.at(k - 1) == 10) { Continue(k - 1) }
    else { Stop(k) })

/// The resource name of an operation, which the tree keeps only as a flag.
fn ident_after_bracket(input: PrintInput, i: Int) -> Bytes / {abort.raise} = {
  let j = skip_ws(input, i);
  if j < input.source.len() && input.source.at(j) == 91 {
    let k = skip_ws(input, j + 1);
    input.source.slice(k, input.source.scan(k, ident_chars(), input.source.len() - k))
  } else { b"" }
}

/// The documentation name an operation parameter may carry before its type; the tree drops it.
fn name_before(input: PrintInput, i: Int) -> Option<Bytes> / {abort.raise} = {
  let j = back_ws(input, i);
  if j > 0 && input.source.at(j - 1) == 58 {
    let e = back_ws(input, j - 1);
    let s = iterate(e, e + 1, |k: Int|
      if k > 0 && is_ident_byte(input.source.at(k - 1)) { Continue(k - 1) } else { Stop(k) });
    if s < e { Some(input.source.slice(s, e)) } else { None }
  } else { None }
}

/// Where no source covers an operation, its resource gets a name of the printer's choosing and its
/// parameters none, which the tree drops either way.
fn op_decl_text(input: PrintInput, op: OpDef) -> Bytes / {abort.raise} = {
  let res = if !op.resource_param { b"" } else if sourced(input, op.name.span) {
    Bytes::concat_all([b"[", ident_after_bracket(input, op.name.span.end), b"]"])
  } else { b"[r]" };
  let ps = op.params.map(|t: TypeExpr| {
    let ty = type_text(input, t);
    let named = if sourced(input, ty_span(t)) { name_before(input, ty_span(t).start) }
    else { None };
    match named { Some(n) -> Bytes::concat_all([n, b": ", ty]), None -> ty }
  });
  Bytes::concat_all([
    mode_text(op.mode),
    b" ",
    op.name.name,
    res,
    generics_text({ types: op.ty_params, effects: [], labels: [] }),
    b"(",
    Bytes::join(ps, b", "),
    b")",
    if is_raise(op.mode) { b"" } else { b" -> ".concat(type_text(input, op.ret)) },
  ])
}

fn effect_def(input: PrintInput, printer: Printer, d: EffectDef) -> Printer / {abort.raise} = {
  let nd = if d.is_nondet { b"nondet " } else { b"" };
  let s1 = emit(printer, Bytes::concat_all([vis_text(d.vis), nd, b"effect ", d.name.name, b" {"]));
  if d.ops.len() == 0 && !comment_before(input, s1, d.span.end) { emit(s1, b"}") } else {
    let s2 = d.ops.fold(s1, |s: Printer, op: OpDef| {
      let e = emit(open_line(input, s, op.span.start, 2, false), op_decl_text(input, op));
      trail(input, set_prev(absorb(input, e, op.span.end), op.span.end), op.span.end)
    });
    close(input, s2, d.span.end, 0, b"}")
  }
}

/// A label is kept as written, holes and all: over cases it is the test's name.
fn test_def(input: PrintInput, printer: Printer, d: TestDef) -> Printer / {abort.raise} = {
  let kw = if d.is_nondet { b"test/nondet " } else { b"test " };
  let head = emit(printer, Bytes::concat_all([kw, test_label(input, d), b" "]));
  match d.cases {
    None -> def_body(input, head, d.body, 0),
    Some(c) -> {
      let ranged = emit(
        head,
        Bytes::concat_all([b"for ", c.binder.name, b": ", type_text(input, c.ty), b" in "]),
      );
      let table = match try_flat(
          input,
          ranged,
          flat_scrutinee(input, c.table),
          expr_span(c.table).end,
          2,
        ) {
        Some(f) -> emit(ranged, f),
        None -> scrutinee(input, ranged, c.table, 2, 2),
      };
      def_body(input, emit(table, b" "), d.body, 0)
    },
  }
}

/// Before `for` a label is a template, whose braces open holes: one without a hole is its value
/// with each brace doubled, and the name of one with holes is its text as written.
fn test_label(input: PrintInput, d: TestDef) -> Bytes / {abort.raise} =
  if sourced(input, d.name_span) { input.source.slice(d.name_span.start, d.name_span.end) } else {
    match d.cases {
      None -> str_lit(d.name),
      Some(c) -> match c.label {
        ELit(_) -> Bytes::concat_all([b"\"", template_text(d.name), b"\""]),
        _ -> Bytes::concat_all([b"\"", d.name, b"\""]),
      },
    }
  }

fn binder_text(input: PrintInput, binder: Binder) -> Bytes / {abort.raise} =
  Bytes::concat_all([binder.name.name, b": ", type_text(input, binder.ty)])

fn binders_text(input: PrintInput, binders: List<Binder>) -> Bytes / {abort.raise} =
  if binders.len() == 0 { b"" } else {
    Bytes::concat_all([
      b"forall (",
      Bytes::join(binders.map(|binder: Binder| binder_text(input, binder)), b", "),
      b")",
    ])
  }

fn guard_flat(input: PrintInput, guard: Option<Expr>) -> Option<Bytes> / {abort.raise} =
  match guard { Some(g) -> cat([Some(b" where "), flat_scrutinee(input, g)]), None -> Some(b"") }

/// A claim on its head's line: the binders, the guard and the body.
fn claim_flat(
  input: PrintInput,
  binders: List<Binder>,
  guard: Option<Expr>,
  body: Expr,
) -> Option<Bytes> / {abort.raise} = {
  let quantified = binders_text(input, binders);
  cat([
    Some(if quantified.len() == 0 { b"" } else { b" ".concat(quantified) }),
    guard_flat(input, guard),
    Some(b" "),
    flat_expr(input, body),
  ])
}

/// The same where one line does not hold it: the binders under the head, the guard beside them
/// if it fits.
fn claim_lines(
  input: PrintInput,
  s1: Printer,
  binders: List<Binder>,
  guard: Option<Expr>,
  body: Expr,
) -> Printer / {abort.raise} = {
  let written = binders_text(input, binders);
  let quantified = written.len() > 0 || guard != None;
  let s2 = if written.len() == 0 { s1 } else { emit(nl(s1, 2, false), written) };
  let s3 = match guard {
    Some(g) -> match try_flat(input, s2, guard_flat(input, guard), expr_span(g).end, 2) {
      Some(f) -> emit(s2, f),
      None -> scrutinee(input, emit(nl(s2, 2, false), b"where "), g, 2, 2),
    },
    None -> s2,
  };
  block(input, emit(s3, b" "), body, if quantified { 2 } else { 0 })
}

fn law_def(input: PrintInput, printer: Printer, d: LawDef) -> Printer / {abort.raise} = {
  let head = b"law ".concat(if sourced(input, d.name_span) {
    input.source.slice(d.name_span.start, d.name_span.end)
  } else { str_lit(d.name) });
  match d.of {
    Some(_) -> def_body(input, emit(printer, head.concat(b" = ")), d.body, 0),
    None -> {
      let flat = cat([Some(head), claim_flat(input, d.binders, d.guard, d.body)]);
      match try_flat(input, printer, flat, d.span.end, 0) {
        Some(f) -> emit(printer, f),
        None -> claim_lines(input, emit(printer, head), d.binders, d.guard, d.body),
      }
    },
  }
}

fn schema_param(
  input: PrintInput,
  printer: Printer,
  x: Binder,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = emit(open_line(input, printer, x.span.start, indent, false), binder_text(input, x));
  trail(input, set_prev(emit(absorb(input, s1, x.span.end), b","), x.span.end), x.span.end)
}

fn schema_def(input: PrintInput, printer: Printer, d: SchemaDef) -> Printer / {abort.raise} = {
  let head = Bytes::concat_all([
    vis_text(d.vis),
    b"law schema ",
    d.name.name,
    generics_text(d.generics),
  ]);
  let params = Bytes::concat_all([
    b"(",
    Bytes::join(d.params.map(|x: Binder| binder_text(input, x)), b", "),
    b")",
  ]);
  let flat = cat([Some(head), Some(params), claim_flat(input, d.binders, d.guard, d.body)]);
  match try_flat(input, printer, flat, d.span.end, 0) {
    Some(f) -> emit(printer, f),
    None -> {
      let s1 = emit(printer, head);
      let params_end = match d.params.at(d.params.len() - 1) {
        Some(x) -> x.span.end,
        None -> d.name.span.end,
      };
      let fit = if d.params.len() == 0 { Some(params) }
      else { try_flat(input, s1, Some(params), params_end, 0) };
      let s2 = match fit {
        Some(f) -> emit(s1, f),
        None -> {
          let ps = d.params.fold(emit(s1, b"("), |s: Printer, x: Binder|
            schema_param(input, s, x, 2));
          close(input, ps, params_end, 0, b")")
        },
      };
      claim_lines(input, s2, d.binders, d.guard, d.body)
    },
  }
}

// --- One item ---------------------------------------------------------------

type Located = { start: Int, end: Int, item: Item }

fn item_kind(item: Item) -> Bytes =
  match item {
    IFn(_) -> b"fn",
    IType(_) -> b"type",
    IEffect(_) -> b"effect",
    ITest(_) -> b"test",
    ILaw(_) -> b"law",
    ISchema(_) -> b"law schema",
    IDerive(_) -> b"derive",
    IEffectSet(_) -> b"effect set",
    IExtern(_) -> b"extern fn",
    IInstance(d) -> instance_text(d.kind),
    INumeric(_) -> b"numeric",
  }

/// A test, a law or a derive has no identifier to be found by.
fn item_name(item: Item) -> Option<Bytes> =
  match item {
    IFn(d) -> Some(d.name.name),
    IType(d) -> Some(d.name.name),
    IEffect(d) -> Some(d.name.name),
    ISchema(d) -> Some(d.name.name),
    IEffectSet(d) -> Some(d.name.name),
    IExtern(d) -> Some(d.name.name),
    _ -> None,
  }

fn item_desc(item: Item) -> Bytes =
  match item_name(item) {
    Some(n) -> Bytes::concat_all([b"`", item_kind(item), b"` `", n, b"`"]),
    None -> Bytes::concat_all([b"a `", item_kind(item), b"`"]),
  }

fn line_start(src: Bytes, i: Int) -> Int / {abort.raise} =
  iterate(i, i + 1, |k: Int| if k > 0 && src.at(k - 1) != 10 { Continue(k - 1) } else { Stop(k) })

/// Past the newline ending the line that holds `i`, or the end of the text.
pub fn line_end(src: Bytes, i: Int) -> Int / {abort.raise} =
  match src.index_of_from(b"\n", i) { Some(j) -> j + 1, None -> src.len() }

/// Where the item's own text starts: at its `pub`, `transparent`, `reuse` or `const` when it has one,
/// else its keyword.
fn head_start(src: Bytes, item: Item) -> Int / {abort.raise} = {
  let kw = match item {
    IFn(d) -> match d.transparent {
      Some(t) -> t.start,
      None -> match d.reuse {
        Some(s) -> s.start,
        None -> match d.baked { Some(s) -> s.start, None -> d.span.start },
      },
    },
    _ -> item_span(item).start,
  };
  let published = match item {
    IFn(d) -> is_pub(d.vis),
    IType(d) -> is_pub(d.vis),
    IEffect(d) -> is_pub(d.vis),
    _ -> false,
  };
  let j = back_blank(src, kw);
  if published && j >= 3 && src.slice(j - 3, j) == b"pub"
      && (j == 3 || !is_ident_byte(src.at(j - 4))) { j - 3 }
  else { kw }
}

/// The end of the last item or import that ends at or before `pos`.
fn floor_before(module: Module, pos: Int) -> Int = {
  let imported = module.imports.filter(is_written).fold(0, |acc: Int, decl: ImportDecl|
    if decl.span.end <= pos && decl.span.end > acc { decl.span.end } else { acc });
  module.items.fold(imported, |acc: Int, item: Item| {
    let e = item_span(item).end;
    if e <= pos && e > acc { e } else { acc }
  })
}

/// The start of the first item or import that starts at or after `pos`, else the end of the text.
fn ceiling_after(src: Bytes, module: Module, pos: Int) -> Int / {abort.raise} = {
  let imported = module.imports.filter(is_written).fold(src.len(), |acc: Int, decl: ImportDecl|
    if decl.span.start >= pos && decl.span.start < acc { decl.span.start } else { acc });
  module.items.fold(imported, |acc: Int, item: Item| {
    let s = head_start(src, item);
    if s >= pos && s < acc { s } else { acc }
  })
}

/// The start of the `//` lines directly above `head` with no blank line between, none before `floor`.
fn doc_start(src: Bytes, head: Int, floor: Int) -> Int / {abort.raise} = {
  let first = line_start(src, head);
  if first < floor { floor } else {
    iterate(first, head + 1, |ls: Int|
      if ls <= floor { Stop(ls) } else {
        let prev = line_start(src, ls - 1);
        if prev >= floor && trim(src.slice(prev, ls - 1)).starts_with(b"//") { Continue(prev) }
        else { Stop(ls) }
      })
  }
}

fn locate(src: Bytes, name: Bytes) -> Result<Located, Bytes> / {abort.raise} = {
  let r = parse(src);
  match r.parser.diags.at(0) {
    Some(d) -> Err(render_diag(src, d)),
    None -> {
      let m = r.node;
      let found = m.items.filter(|it: Item|
        match item_name(it) { Some(n) -> n == name, None -> false });
      if found.len() == 0 {
        Err(Bytes::concat_all([b"no `fn`, `type` or `effect` is named `", name, b"`"]))
      } else if found.len() > 1 {
        Err(Bytes::concat_all([b"`", name, b"` names ", ascii_of_int(found.len()), b" items"]))
      } else {
        let it = found.get(0);
        let head = head_start(src, it);
        let last = item_span(it).end;
        let above = match item_doc(it) { Some(d) -> d.span.start, None -> head };
        let start = doc_start(src, above, floor_before(m, above));
        let end = min(line_end(src, last), ceiling_after(src, m, last));
        Ok({ start: start, end: end, item: it })
      }
    },
  }
}

/// The bytes of the item named `name`: its comment lines, `pub`, `reuse` and body through the end of
/// its last line, so a comment ending that line comes along. Refused when the name is absent, names
/// two items, or the text does not parse.
pub fn item_range(
  src: Bytes,
  name: Bytes,
) -> Result<{ start: Int, end: Int }, Bytes> / {abort.raise} =
  match locate(src, name) { Ok(l) -> Ok({ start: l.start, end: l.end }), Err(e) -> Err(e) }

/// `src` with the item named `name` replaced by `item` formatted; every byte outside its range is kept.
pub fn replace_item(src: Bytes, name: Bytes, item: Bytes) -> Result<Bytes, Bytes> / {abort.raise} = {
  let old = locate(src, name)?;
  let r = parse(item);
  match r.parser.diags.at(0) {
    Some(d) -> Err(b"the replacement does not parse: ".concat(render_diag(item, d))),
    None -> {
      let m = r.node;
      if m.imports.filter(is_written).len() > 0 {
        Err(b"the replacement holds an import; it must be one item")
      } else if m.items.len() != 1 {
        Err(
          Bytes::concat_all([
            b"the replacement holds ",
            ascii_of_int(m.items.len()),
            b" items; it must be one",
          ]),
        )
      } else {
        let fresh = m.items.get(0);
        let same = item_kind(fresh) == item_kind(old.item)
          && (match item_name(fresh) { Some(n) -> n == name, None -> false });
        if !same {
          Err(
            Bytes::concat_all([
              b"the replacement defines ",
              item_desc(fresh),
              b"; expected ",
              item_desc(old.item),
            ]),
          )
        } else {
          let formatted = fmt_source(item)?;
          let lead = if old.start > 0 && src.at(old.start - 1) != 10 { b"\n" } else { b"" };
          Ok(
            Bytes::concat_all([
              src.slice(0, old.start),
              lead,
              formatted,
              src.slice(old.end, src.len()),
            ]),
          )
        }
      }
    },
  }
}

// --- Tests ------------------------------------------------------------------

fn formatted(src: Bytes) -> Bytes / {abort.raise} =
  match fmt_source(src) { Ok(o) -> o, Err(e) -> panic(String::of_bytes(e)) }

fn stable(src: Bytes) -> Bool / {abort.raise} = {
  let out = formatted(src);
  fmt_source(out) == Ok(out)
}

fn tree_of(src: Bytes) -> Bytes / {abort.raise} = erase_spans(dump_module(parse(src).node))

/// `src` prints as `out`, which prints as itself and parses to the tree `src` does.
fn lays_out(src: Bytes, out: Bytes) -> Unit / {abort.raise} = {
  assert_eq(formatted(src), out);
  assert_eq(formatted(out), out);
  assert_eq(tree_of(out), tree_of(src))
}

test "a program is printed back with its comments, and printing it again changes nothing" {
  let src = b"// top\nfn   f(a: Int,b: Int)->Int = a+b // add\n\n\nfn g() -> List<Int> = [1_000, 0xFF]\n";
  let out = formatted(src);
  assert_eq(
    out,
    b"// top\nfn f(a: Int, b: Int) -> Int = a + b  // add\n\nfn g() -> List<Int> = [1_000, 0xFF]\n",
  );
  assert(stable(src))
}

test "a type's where clause prints after its generic list" {
  lays_out(
    b"pub type Game<s, a, c | e>   where derivable(eq, a),derivable(hash, a) = { f: (a, a) -> Bool }\n",
    b"pub type Game<s, a, c | e> where derivable(eq, a), derivable(hash, a) = { f: (a, a) -> Bool }\n",
  );
  lays_out(
    b"extern type H<a> where derivable(hash, a)\n",
    b"extern type H<a> where derivable(hash, a)\n",
  )
}

test "a call on a value prints as it is written, a named argument and a function named in full among them" {
  let src = b"fn f(s: Stack) -> Int = s.grown(2, twice: true).size() + s.lib::depth(1) + (s.held)(1)\n";
  assert_eq(formatted(src), src);
  let update = b"fn f(xs: List<P>, i: Int) -> P = { ..xs.get(i), a: 1 }\n";
  assert_eq(formatted(update), update)
}

test "a map or a set literal prints as the literal it was, and a spelled-out call as a call" {
  lays_out(
    b"fn f() -> Map<String, Int> = #{ \"a\" : 1,\"b\":2 }\n",
    b"fn f() -> Map<String, Int> = #{\"a\": 1, \"b\": 2}\n",
  );
  lays_out(b"fn f() -> Set<Int> = #[ 3,1 ]\n", b"fn f() -> Set<Int> = #[3, 1]\n");
  lays_out(
    b"fn f() -> Set<{ key: Int, value: Int }> = #[{key: 1, value: 2}]\n",
    b"fn f() -> Set<{ key: Int, value: Int }> = #[{ key: 1, value: 2 }]\n",
  );
  lays_out(b"fn f() -> Map<Int, Int> = #{}\n", b"fn f() -> Map<Int, Int> = #{}\n");
  lays_out(
    b"fn f() -> Map<Int, Int> = Map::of_entries([{key: 1, value: 2}])\n",
    b"fn f() -> Map<Int, Int> = Map::of_entries([{ key: 1, value: 2 }])\n",
  )
}

test "a map literal too long for its line breaks one entry a line" {
  let src = b"fn f() -> Map<String, Int> = #{\"alpha\": 1, \"beta\": 2, \"gamma\": 3, \"delta\": 4, \"epsilon\": 5, \"zeta\": 6, \"eta\": 7, \"theta\": 8, \"iota\": 9}\n";
  let out = formatted(src);
  assert(out.index_of(b"#{\n") != None);
  assert(out.index_of(b"\"zeta\": 6,\n") != None);
  assert(stable(src));
  assert_eq(tree_of(out), tree_of(src))
}

test "an or-pattern parts its alternatives with ` | `, keeping a parenthesised choice" {
  lays_out(
    b"fn f(n: Int) -> Int = match n { 1|2 -> 0, (3 | (4|5)) -> 1, _ -> 2 }\n",
    b"fn f(n: Int) -> Int = match n { 1 | 2 -> 0, 3 | (4 | 5) -> 1, _ -> 2 }\n",
  )
}

test "a byte literal keeps its spelling, a blank included, and a range closes up around its dots" {
  lays_out(
    b"fn f(c: Int) -> Int = match c { b' ' -> 0, b'0' ..= b'9' -> 1, - 5 ..= -1 -> 2, _ -> 3 }\n",
    b"fn f(c: Int) -> Int = match c { b' ' -> 0, b'0'..=b'9' -> 1, -5..=-1 -> 2, _ -> 3 }\n",
  );
  lays_out(
    b"fn f() -> List<Int> = [ b' ',b'\\'' , b'\\\\' ,b'\\x20' ]\n",
    b"fn f() -> List<Int> = [b' ', b'\\'', b'\\\\', b'\\x20']\n",
  );
  lays_out(
    b"fn f(b: U8) -> Int = match b { (0u8..=9u8) | 20u8 ..=29u8 -> 1, _ -> 0 }\n",
    b"fn f(b: U8) -> Int = match b { 0u8..=9u8 | 20u8..=29u8 -> 1, _ -> 0 }\n",
  )
}

test "a wrapping or saturating operator prints as it was written, and its call as a call" {
  lays_out(
    b"fn f(a: U32, b: U32) -> U32 = a+%b *% a -% b\n",
    b"fn f(a: U32, b: U32) -> U32 = a +% b *% a -% b\n",
  );
  lays_out(
    b"fn f(a: U8, b: U8) -> U8 = (a +| b) *| (a -| b)\n",
    b"fn f(a: U8, b: U8) -> U8 = (a +| b) *| (a -| b)\n",
  );
  lays_out(
    b"fn f(a: Int, b: Int) -> Int = wrap_add(a,b) +% saturating_mul(a, b)\n",
    b"fn f(a: Int, b: Int) -> Int = wrap_add(a, b) +% saturating_mul(a, b)\n",
  );
  lays_out(
    b"fn f(a: Int, b: Int) -> Int = (a +% b) -% (a -% b) + (a *% b)\n",
    b"fn f(a: Int, b: Int) -> Int = a +% b -% (a -% b) + a *% b\n",
  )
}

test "a wrapping operator binds as the arithmetic operator beside it, and is its builtin's call" {
  let body = |text: Bytes|
    tree_of(Bytes::concat_all([b"fn f(a: Int, b: Int, c: Int) -> Int = ", text]));
  let same = |written: Bytes, call: Bytes| body(written) == body(call);
  assert(same(b"a +% b *% c", b"wrap_add(a, wrap_mul(b, c))"));
  assert(same(b"a *| b +| c", b"saturating_add(saturating_mul(a, b), c)"));
  assert(same(b"a -% b -% c", b"wrap_sub(wrap_sub(a, b), c)"));
  assert(same(b"a +% b * c", b"wrap_add(a, b * c)"));
  assert(same(b"a * b -| c", b"saturating_sub(a * b, c)"));
  assert(same(b"a & b +% c << 1", b"a & wrap_add(b, c) << 1"));
  assert(same(b"-a *% b", b"wrap_mul(-a, b)"))
}

test "a short `let ... else` keeps its `else` on the line, and a longer one opens a block" {
  lays_out(
    b"fn f(o: Option<Int>) -> Int = { let Some(v) = o else {0}; v }\n",
    b"fn f(o: Option<Int>) -> Int = {\n  let Some(v) = o else { 0 };\n  v\n}\n",
  );
  lays_out(
    b"fn f(o: Option<Int>) -> Int = { let Some(v) = o else { let w = 1; w }; v }\n",
    b"fn f(o: Option<Int>) -> Int = {\n  let Some(v) = o else {\n    let w = 1;\n    w\n  };\n  v\n}\n",
  )
}

test "a block breaks one statement per line and keeps one blank line between statements" {
  let src = b"fn f() -> Int = { let x = 1;\n\n\n  let y = 2; x + y }\n";
  assert_eq(formatted(src), b"fn f() -> Int = {\n  let x = 1;\n\n  let y = 2;\n  x + y\n}\n");
  assert(stable(src))
}

test "comments between match arms and at the end of the file keep their place" {
  let src = b"fn f(x: Option<Int>) -> Int =\n  match x {\n    // none\n    None -> 0,\n    Some(n) -> n, // some\n  }\n// end\n";
  assert_eq(
    formatted(src),
    b"fn f(x: Option<Int>) -> Int =\n  match x {\n    // none\n    None -> 0,\n    Some(n) -> n,  // some\n  }\n// end\n",
  );
  assert(stable(src))
}

test "a call past the width breaks one argument per line, and a lambda hugs the parentheses" {
  let long = b"fn f() -> Int = some_function(first_argument_value, second_argument_value, third_argument_value, fourth, fifth_argument_value)\n";
  assert_eq(
    formatted(long),
    b"fn f() -> Int =\n  some_function(\n    first_argument_value,\n    second_argument_value,\n    third_argument_value,\n    fourth,\n    fifth_argument_value,\n  )\n",
  );
  let hug = b"fn g(xs: List<Int>) -> Int = xs.fold(0, |acc: Int, x: Int| if x > acc { acc + x * x * x * x * x * x * x * x * x * x } else { acc - x })\n";
  assert_eq(
    formatted(hug),
    b"fn g(xs: List<Int>) -> Int =\n  xs.fold(0, |acc: Int, x: Int|\n    if x > acc { acc + x * x * x * x * x * x * x * x * x * x } else { acc - x })\n",
  );
  assert(stable(long));
  assert(stable(hug))
}

test "a chain past the width keeps every line it opens at one level, however its operators nest" {
  let src = b"fn ordered(a: Int, b: Int, c: Int) -> Bool =\n  first_reading(a, b) || ".concat(
    b"(second_reading(a, b) && (third_reading(b, c) || (fourth_reading(b, c) && fifth_reading(a, c))))\n",
  );
  assert_eq(
    formatted(src),
    b"fn ordered(a: Int, b: Int, c: Int) -> Bool =\n  first_reading(a, b)\n    || (second_reading(a, b)\n".concat(
      b"    && (third_reading(b, c) || (fourth_reading(b, c) && fifth_reading(a, c))))\n",
    ),
  );
  assert(stable(src))
}

test "`&&` under `||`, and a form that runs on, are bracketed wherever an operator bounds them" {
  let src = b"fn holds(x: Option<Int>, n: Int) -> Bool =\n".concat(
    b"  n > 0 || n < 0 && match x { Some(k) -> k > n, None -> false }\n",
  );
  assert_eq(
    formatted(src),
    b"fn holds(x: Option<Int>, n: Int) -> Bool =\n".concat(
      b"  n > 0 || (n < 0 && (match x { Some(k) -> k > n, None -> false }))\n",
    ),
  );
  assert_eq(
    formatted(b"fn kept(n: Int) -> Bool = !(n > 0) && n + 1 > 0 || n == 0\n"),
    b"fn kept(n: Int) -> Bool = (!(n > 0) && n + 1 > 0) || n == 0\n",
  );
  assert(stable(src))
}

test "an `if` chain past the width takes one branch to a line, its body on that line while it fits" {
  let src = b"fn pick(n: Int) -> Bytes =\n  if n == 0 { b\"zero\" } else if n == 1 { b\"one\" } ".concat(
    b"else if n == 2 { b\"two\" } else if n == 3 { b\"three\" } else { b\"many\" }\n",
  );
  assert_eq(
    formatted(src),
    b"fn pick(n: Int) -> Bytes =\n  if n == 0 { b\"zero\" }\n  else if n == 1 { b\"one\" }\n".concat(
      b"  else if n == 2 { b\"two\" }\n  else if n == 3 { b\"three\" }\n  else { b\"many\" }\n",
    ),
  );
  assert(stable(src));
  // A branch that has to open a block takes the `else` on either side of it onto its brace's line.
  let wide = b"fn pick(n: Int, xs: List<Int>) -> Bytes =\n  if n == 0 { b\"zero\" } else if n == 1 { b\"one\" } ".concat(
    b"else if n == 2 { let m = xs.fold(0, |acc: Int, x: Int| acc + x); b\"two\" } else { b\"many\" }\n",
  );
  assert_eq(
    formatted(wide),
    Bytes::concat_all([
      b"fn pick(n: Int, xs: List<Int>) -> Bytes =\n  if n == 0 { b\"zero\" }\n",
      b"  else if n == 1 { b\"one\" } else if n == 2 {\n",
      b"    let m = xs.fold(0, |acc: Int, x: Int| acc + x);\n    b\"two\"\n",
      b"  } else { b\"many\" }\n",
    ]),
  );
  assert(stable(wide))
}

// Absorbed into the branch that followed it, the comment came back above a different `else` on the
// next pass, so formatting twice was not formatting once.
test "a comment written above an `else` keeps its line above it" {
  let src = b"fn pick(n: Int) -> Bytes =\n  if n == 0 { b\"zero\" }\n  else if n == 1 { b\"one\" }\n".concat(
    b"  // the rest are the same\n  else { b\"many\" }\n",
  );
  assert_eq(formatted(src), src);
  assert(stable(src))
}

test "an `if` chain past the width breaks into branches before any condition in it breaks" {
  lays_out(
    Bytes::concat_all([
      b"fn request_line(line: Bytes) -> Parsed = {\n",
      b"  let len = Bytes::len(line);\n",
      b"  let sp1 = index_of(line, b\" \", 0);\n",
      b"  if sp1 >= len { Malformed(\"a request line is `METHOD TARGET VERSION`\") } else {\n",
      b"    let sp2 = index_of(line, b\" \", sp1 + 1);\n",
      b"    if sp2 >= len { Malformed(\"a request line is `METHOD TARGET VERSION`\") } else if index_of(\n",
      b"          line,\n",
      b"          b\" \",\n",
      b"          sp2 + 1,\n",
      b"        )\n",
      b"        < len { Malformed(\"a request line holds exactly two spaces\") } else {\n",
      b"      parts(\n",
      b"        Bytes::slice(line, 0, sp1),\n",
      b"        Bytes::slice(line, sp1 + 1, sp2),\n",
      b"        Bytes::slice(line, sp2 + 1, len),\n",
      b"      )\n",
      b"    }\n",
      b"  }\n",
      b"}\n",
    ]),
    Bytes::concat_all([
      b"fn request_line(line: Bytes) -> Parsed = {\n",
      b"  let len = Bytes::len(line);\n",
      b"  let sp1 = index_of(line, b\" \", 0);\n",
      b"  if sp1 >= len { Malformed(\"a request line is `METHOD TARGET VERSION`\") } else {\n",
      b"    let sp2 = index_of(line, b\" \", sp1 + 1);\n",
      b"    if sp2 >= len { Malformed(\"a request line is `METHOD TARGET VERSION`\") }\n",
      b"    else if index_of(line, b\" \", sp2 + 1) < len {\n",
      b"      Malformed(\"a request line holds exactly two spaces\")\n",
      b"    } else {\n",
      b"      parts(\n",
      b"        Bytes::slice(line, 0, sp1),\n",
      b"        Bytes::slice(line, sp1 + 1, sp2),\n",
      b"        Bytes::slice(line, sp2 + 1, len),\n",
      b"      )\n",
      b"    }\n",
      b"  }\n",
      b"}\n",
    ]),
  )
}

test "a condition in a chain breaks, one level in, only when its branch's opening overflows its own line" {
  lays_out(
    b"fn f(a: Int, b: Int) -> Int = if a == 0 { 1 } else if some_long_condition_name(a, b) ".concat(
      b"&& another_long_condition_name(a, b) && third_condition_name(a, b) && fourth_condition(a) { 2 } else { 3 }\n",
    ),
    Bytes::concat_all([
      b"fn f(a: Int, b: Int) -> Int =\n",
      b"  if a == 0 { 1 }\n",
      b"  else if some_long_condition_name(a, b) && another_long_condition_name(a, b)\n",
      b"      && third_condition_name(a, b)\n",
      b"      && fourth_condition(a) { 2 }\n",
      b"  else { 3 }\n",
    ]),
  )
}

test "an `if` with a long condition and no `else if` keeps its body on the condition's last line" {
  lays_out(
    b"fn f(a: Int, b: Int) -> Int = if some_long_condition_name(a, b) ".concat(
      b"&& another_long_condition_name(a, b) && third_one(a) { 1 } else { 2 }\n",
    ),
    Bytes::concat_all([
      b"fn f(a: Int, b: Int) -> Int =\n",
      b"  if some_long_condition_name(a, b) && another_long_condition_name(a, b) && third_one(a) { 1 }\n",
      b"  else { 2 }\n",
    ]),
  );
  lays_out(
    b"fn g(a: Int, b: Int) -> Int = if some_long_condition_name(a, b) ".concat(
      b"&& another_long_condition_name(a, b) && third_condition_name(a, b) && fourth(a) { 1 } else { 2 }\n",
    ),
    Bytes::concat_all([
      b"fn g(a: Int, b: Int) -> Int =\n",
      b"  if some_long_condition_name(a, b) && another_long_condition_name(a, b)\n",
      b"      && third_condition_name(a, b)\n",
      b"      && fourth(a) { 1 }\n",
      b"  else { 2 }\n",
    ]),
  )
}

test "a chain in a `let`, a match arm or a call argument puts each `else` where the chain's line began" {
  let chain = b"if a == 0 { first(a, b) } else if some_long_condition_name(a, b) ".concat(
    b"&& another_long_condition_name(a, b) { second_value_with_a_longer_name(a, b) } else { third(a, b) }",
  );
  lays_out(
    Bytes::concat_all([b"fn f(a: Int, b: Int) -> Int = { let x = ", chain, b"; x }\n"]),
    Bytes::concat_all([
      b"fn f(a: Int, b: Int) -> Int = {\n",
      b"  let x = if a == 0 { first(a, b) }\n",
      b"  else if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"    second_value_with_a_longer_name(a, b)\n",
      b"  } else { third(a, b) };\n",
      b"  x\n",
      b"}\n",
    ]),
  );
  lays_out(
    Bytes::concat_all([
      b"fn g(o: Option<Int>, b: Int) -> Int = match o { Some(a) -> ",
      chain,
      b", None -> 0 }\n",
    ]),
    Bytes::concat_all([
      b"fn g(o: Option<Int>, b: Int) -> Int =\n",
      b"  match o {\n",
      b"    Some(a) -> if a == 0 { first(a, b) }\n",
      b"    else if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"      second_value_with_a_longer_name(a, b)\n",
      b"    } else { third(a, b) },\n",
      b"    None -> 0,\n",
      b"  }\n",
    ]),
  );
  lays_out(
    Bytes::concat_all([b"fn h(a: Int, b: Int) -> Int = combine(a, ", chain, b")\n"]),
    Bytes::concat_all([
      b"fn h(a: Int, b: Int) -> Int =\n",
      b"  combine(a, if a == 0 { first(a, b) }\n",
      b"  else if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"    second_value_with_a_longer_name(a, b)\n",
      b"  } else { third(a, b) })\n",
    ]),
  );
  lays_out(
    Bytes::concat_all([b"fn k(a: Int, b: Int) -> Int = combine(", chain, b", a)\n"]),
    Bytes::concat_all([
      b"fn k(a: Int, b: Int) -> Int =\n",
      b"  combine(\n",
      b"    if a == 0 { first(a, b) }\n",
      b"    else if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"      second_value_with_a_longer_name(a, b)\n",
      b"    } else { third(a, b) },\n",
      b"    a,\n",
      b"  )\n",
    ]),
  )
}

test "an `else` with no room before the block it opens takes a line of its own" {
  lays_out(
    b"fn pick(n: Int) -> Bytes = if n == 0 { b\"a body long enough that the else and its brace ".concat(
      b"no longer fit on its one line\" } else { let m = n * 2; num(m) }\n",
    ),
    Bytes::concat_all([
      b"fn pick(n: Int) -> Bytes =\n",
      b"  if n == 0 { b\"a body long enough that the else and its brace no longer fit on its one line\" }\n",
      b"  else {\n",
      b"    let m = n * 2;\n",
      b"    num(m)\n",
      b"  }\n",
    ]),
  )
}

test "the branch that ends a chain leaves room on its line for what follows the chain" {
  lays_out(
    b"fn f(a: Int, b: Int) -> Unit = { if some_long_condition_name(a, b) ".concat(
      b"&& another_long_condition_name(a, b) { note(a, b, 12345678901) }; done(a) }\n",
    ),
    Bytes::concat_all([
      b"fn f(a: Int, b: Int) -> Unit = {\n",
      b"  if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"    note(a, b, 12345678901)\n",
      b"  };\n",
      b"  done(a)\n",
      b"}\n",
    ]),
  );
  lays_out(
    b"fn g(a: Int, b: Int) -> Int = { let x = if a > b { a } else { combine(first_argument_name, ".concat(
      b"second_argument_name, third_argument_name, fourth_arguments) }; x }\n",
    ),
    Bytes::concat_all([
      b"fn g(a: Int, b: Int) -> Int = {\n",
      b"  let x = if a > b { a } else {\n",
      b"    combine(first_argument_name, second_argument_name, third_argument_name, fourth_arguments)\n",
      b"  };\n",
      b"  x\n",
      b"}\n",
    ]),
  )
}

test "a line string starts a line of its own, and what follows it starts the next" {
  lays_out(
    b"fn f() -> String = { let s = \\\\one\n      \\\\two\n; s }\n",
    b"fn f() -> String = {\n  let s =\n    \\\\one\n    \\\\two\n  ;\n  s\n}\n",
  );
  lays_out(
    b"fn f() -> String = \\\\say \"hi\" \\\\here\n\nfn g() -> String = \"a\\nb\"\n",
    b"fn f() -> String =\n  \\\\say \"hi\" \\\\here\n\nfn g() -> String = \"a\\nb\"\n",
  )
}

test "a line string that ends a list, a call or a record takes no comma, and one before an item does" {
  lays_out(
    b"fn f() -> Unit = assert_eq(g(), \\\\a\n  \\\\b\n)\n",
    b"fn f() -> Unit =\n  assert_eq(\n    g(),\n    \\\\a\n    \\\\b\n  )\n",
  );
  lays_out(
    b"fn f() -> { path: String, text: String } = { path: \"m.ply\", text: \\\\one\n}\n",
    b"fn f() -> { path: String, text: String } =\n  {\n    path: \"m.ply\",\n    text:\n      \\\\one\n  }\n",
  );
  lays_out(
    b"fn f() -> List<String> = [\\\\a\n, \\\\b\n]\n",
    b"fn f() -> List<String> =\n  [\n    \\\\a\n    ,\n    \\\\b\n  ]\n",
  )
}

fn every_item_kind() -> Bytes =
  Bytes::concat_all([
    b"import std.json\nimport a.b as c\nimport spine (Span, Ident)\n",
    b"pub type Shape = | Circle(Int) | Rect(Int, Int) | Point\n",
    b"type P = { x: Int, y: Int }\n",
    b"pub effect db {\n  read get[r](key: Int) -> Option<Int>\n  write put(Int, Int) -> Unit\n}\n",
    b"nondet effect clock { read now() -> Int }\n",
    b"effect set Persist = {db.read[users], Other, db.write[users]}\n",
    b"pub reuse fn f<a | e>(x: a, g: (a) -> a / e, n: Int = 1) -> a / {db.read[users] | e} where derivable(json, a) requires n > 0 ensures true = g(x)\n",
    b"fn h(t: (Int, Bool)) -> (Bool, Int) = match t { (n, b) -> (b, n) }\n",
    b"pub transparent fn k(x: Int) -> Int = x\n",
    b"transparent reuse fn q(xs: List<Int>) -> List<Int> = xs\n",
    b"pub const fn table() -> List<Int> = [1, 2]\n",
    b"fn r(xs: List<Int>, n: Int) -> List<Int>\n  returns xs\n  requires n > 0\n= xs\n",
    b"fn s() -> List<Int>\n  returns fresh\n= []\n",
    b"derive json for P\n",
    b"test/nondet \"t\" { assert(true) }\n",
    b"law \"l\" forall (n: Int) where n > 0 { n == n }\n",
    b"law \"m\" { true }\n",
  ])

test "every item kind prints back to the same tree" {
  let src = every_item_kind();
  assert(stable(src));
  assert(String::of_bytes(formatted(src)).contains("read get[r](key: Int) -> Option<Int>"))
}

test "a `new` record prints `new` before its fields, one to a line where they do not fit" {
  lays_out(
    b"pub   type Date=new{year:Int,month:Int}\n",
    b"pub type Date = new { year: Int, month: Int }\n",
  );
  lays_out(
    b"type Pair<a> = new { the_first_of_the_two_values_it_holds: a, the_second_of_the_two_values_it_holds: a }\n",
    b"type Pair<a> = new {\n  the_first_of_the_two_values_it_holds: a,\n  the_second_of_the_two_values_it_holds: a,\n}\n",
  )
}

test "a schema prints as a law does after its parameters, and an instantiation as a definition's body" {
  lays_out(
    b"pub  law schema  s<a>(f: (a)->a)   forall (x: a) where x==x { f(x)==x }\n",
    b"pub law schema s<a>(f: (a) -> a) forall (x: a) where x == x { f(x) == x }\n",
  );
  lays_out(b"law schema g(f: ()->Bool) { f() }\n", b"law schema g(f: () -> Bool) { f() }\n");
  lays_out(
    b"law schema h<a|e>(f: (a)->a/e) forall (x: a) { f(f(x))==f(x) }\n",
    b"law schema h<a | e>(f: (a) -> a / e) forall (x: a) { f(f(x)) == f(x) }\n",
  );
  lays_out(
    b"law schema round_trip<a, b>(encode: (a) -> b / {abort.raise}, decode: (b) -> Option<a> / {abort.raise}) forall (x: a) { decode(encode(x)) == Some(x) }\n",
    b"law schema round_trip<a, b>(\n  encode: (a) -> b / {abort.raise},\n  decode: (b) -> Option<a> / {abort.raise},\n)\n  forall (x: a) {\n    decode(encode(x)) == Some(x)\n  }\n",
  );
  lays_out(b"law \"l\"   =  m::s( f,1 )\n", b"law \"l\" = m::s(f, 1)\n");
  lays_out(
    b"law \"a query string parses back to the pairs it was built of, in the order it names them\" = round_trip(query_build, query_parse)\n",
    b"law \"a query string parses back to the pairs it was built of, in the order it names them\" =\n  round_trip(query_build, query_parse)\n",
  )
}

test "a kept function parameter prints `keep` before its type" {
  lays_out(
    b"fn hold(f:  keep (Int) -> Int) -> Int = 0\n",
    b"fn hold(f: keep (Int) -> Int) -> Int = 0\n",
  )
}

test "a function parameter's cost name prints after its type" {
  lays_out(
    b"fn f<| e>(xs: List<Int>,  g: (Int) -> Int / e cost  k) -> Int / e cost xs.len()*k = 0\n",
    b"fn f<| e>(xs: List<Int>, g: (Int) -> Int / e cost k) -> Int / e\n  cost xs.len() * k\n= 0\n",
  )
}

test "a function parameter's space name prints after its type and cost name" {
  lays_out(
    b"fn f<| e>(xs: List<Int>,  g: (Int) -> List<Int> / e cost  k space  s) -> List<List<Int>> / e space xs.len()+xs.len()*s = []\n",
    b"fn f<| e>(xs: List<Int>, g: (Int) -> List<Int> / e cost k space s) -> List<List<Int>> / e\n  space xs.len() + xs.len() * s\n= []\n",
  );
  let alone = b"fn f(g: (Int) -> Int space s) -> Int\n  space s\n= 0\n";
  assert_eq(formatted(alone), alone)
}

test "a `cost` clause prints on its own line among the spec clauses, in the order written" {
  lays_out(
    b"fn f(xs: List<Int>,  ys: List<Int>) -> Int requires xs.len() > 0 cost xs.len()*(ys.len()+1) = xs.len()\n",
    b"fn f(xs: List<Int>, ys: List<Int>) -> Int\n  requires xs.len() > 0\n  cost xs.len() * (ys.len() + 1)\n= xs.len()\n",
  )
}

test "an operation's type parameters print between its resource and its parameters" {
  let src = b"effect box {\n  read take[k]<a>() -> a\n  write put<a, b>(x: a, y: b) -> Unit\n}\n";
  assert_eq(formatted(src), src)
}

test "a `raise` operation prints its name and parameters, and no result" {
  lays_out(
    b"effect toml {\n  raise   syntax(e: SyntaxError)\n  raise eof( )\n  read peek() -> Int\n}\n",
    b"effect toml {\n  raise syntax(e: SyntaxError)\n  raise eof()\n  read peek() -> Int\n}\n",
  )
}

test "a `try` prints the raise it names, stands as a scrutinee, and is bracketed as an operand" {
  lays_out(
    b"fn f(b: Int) -> Result<Int, Int> = try   { digit(b) }\n",
    b"fn f(b: Int) -> Result<Int, Int> = try { digit(b) }\n",
  );
  lays_out(
    b"fn f(b: Int) -> Result<Int, Int> = try[ m::toml.syntax ]\n  { digit(b) }\n",
    b"fn f(b: Int) -> Result<Int, Int> = try[m::toml.syntax] { digit(b) }\n",
  );
  let scrutinee = b"fn f(b: Int) -> Int = match try { digit(b) } { Ok(v) -> v, Err(e) -> e }\n";
  assert_eq(formatted(scrutinee), scrutinee);
  let operand = b"fn f(b: Int) -> Bool = (try { digit(b) }) == Ok(1)\n";
  assert_eq(formatted(operand), operand);
  let long = Bytes::concat_all([
    b"fn f(b: Int) -> Result<Int, Int> = try[toml.syntax] { let first = digit(b); ",
    b"let second = digit(b + 1); let third = digit(b + 2); first + second + third }\n",
  ]);
  assert(stable(long));
  assert(String::of_bytes(formatted(long)).contains("\n  try[toml.syntax] {\n"))
}

test "a row naming operations prints them back, and a `let` bound to a `handle` keeps its shape" {
  let src = Bytes::concat_all([
    b"effect db {\n  read get[r](key: Int) -> Int\n  write begin() -> Unit\n}\n",
    b"effect set Tx = {db.begin, db.get[users]}\n",
    b"fn f(k: Int) -> Int / {db.get[users], db.begin, db.write} = { db.begin(); db.get[users](k) }\n",
    b"fn g(k: Int) -> Int = {\n  let tried = handle {\n    f(k)\n  } with {\n    db.get[users](n) -> n,\n  };\n  match tried {\n    0 -> 1,\n    n -> n,\n  }\n}\n",
  ]);
  assert(stable(src));
  assert(String::of_bytes(formatted(src)).contains("/ {db.get[users], db.begin, db.write}"));
  assert(String::of_bytes(formatted(src)).contains("{db.begin, db.get[users]}"))
}

test "a label binder prints bracketed among the type parameters, and a call prints its labels" {
  let src = Bytes::concat_all([
    b"fn relay<[l]>(c: Int) -> Unit / {net.send[l]} = ()\n",
    b"fn g<a, [l], [k] | e>(x: a) -> a / e = x\n",
    b"fn h(c: Int) -> Unit / {net.send[conn]} = relay[conn](c)\n",
    b"fn k(c: Int) -> Unit = pair[a, b](c)\n",
  ]);
  assert_eq(formatted(src), src)
}

test "a type prints its label and row binders as a `fn` does, and a use its arguments in their places" {
  let src = Bytes::concat_all([
    b"type Step<a | e> = () -> Option<{ value: a, next: Seq<a | e> }> / e\n\n",
    b"type Seq<a | e> = | Seq(Step<a | e>)\n\n",
    b"pub type Sink<a, [l], [k] | e, f> = | Sink((a) -> Unit / {net.send[l] | e}) | Quiet\n\n",
    b"fn held(s: Sink<Int, [conn], [peer] | {}, {log.write | e}>) -> m::Seq<Int | {| e}> = s\n",
  ]);
  assert_eq(formatted(src), src);
  lays_out(
    b"type T< [l,k] ,a|e > = U<[ l ],a , [k]|e,{ }>\n",
    b"type T<a, [l], [k] | e> = U<a, [l], [k] | e, {}>\n",
  )
}

test "a `handle`, a `match` or an `if` may stand as a scrutinee" {
  let held = b"fn f(k: Int) -> Int = match handle { g(k) } with { db.get(n) -> n } { 0 -> 1, n -> n }\n";
  assert_eq(formatted(held), held);
  let nested = b"fn f(x: Int) -> Int = if match x { 0 -> true, _ -> false } { 1 } else { 2 }\n";
  assert_eq(formatted(nested), nested);
  let broken_up = Bytes::concat_all([
    b"fn f(k: Int) -> Int = match handle { some_call(k) } with ",
    b"{ db.get[users](n) resume q -> q(n), db.put[users](n) -> n + 1 } { 0 -> 1, n -> n }\n",
  ]);
  assert(stable(broken_up));
  assert(String::of_bytes(formatted(broken_up)).contains("match handle {"))
}

fn every_expression_kind() -> Bytes =
  Bytes::concat_all([
    b"fn f(r: {a: Int, b: Int}) -> Int = {\n",
    b"  let {a, b} = r;\n",
    b"  let s = {..r, a: 2};\n",
    b"  let t = (a, b);\n",
    b"  let u = if a > 0 && !(b < 0) { -a } else if a == 0 { ~b } else { (a - b) - (a + b) * 2 };\n",
    b"  let v = [1, 2.5, 1.50m, \"s\\n\", b\"\\x00\", true, ()];\n",
    b"  let w = |x, y: Int| -> Int { x + y };\n",
    b"  let z = (r.a)(1)? + m::g(1, k: 2);\n",
    b"  let c = handle { db.get[users](1) } with { db.get[users](k) resume q -> q(Some(k)), return x -> x };\n",
    b"  let g = handle { db.get[users](1) } with { var n = 0, var seen: List<Int> = [], db.get[users](k) -> { if k > n { n = k } else { seen = seen.push(k) }; n }, return x -> x + n };\n",
    b"  let o = with_hold[file](opened(a), |x: Int| closed(x)) { h -> { used(h); h.get() } };\n",
    b"  simulate { a };\n",
    b"  let e = parallel { a + 1, b };\n",
    b"  match [a, b] { [x, ..rest] if x > 0 -> x, [..] -> 0 }\n",
    b"}\n",
  ])

test "every expression kind prints back to the same tree" {
  assert(stable(every_expression_kind()))
}

test "literal spelling survives, and a grouped literal loses only its parentheses" {
  let src = b"fn f() -> Int = 0xFF_FF + 1_000 + (7)\nfn g() -> Float = 1.50e-3\nfn h() -> Bytes = b\"a\\x0d\"\n";
  assert_eq(
    formatted(src),
    b"fn f() -> Int = 0xFF_FF + 1_000 + 7\nfn g() -> Float = 1.50e-3\nfn h() -> Bytes = b\"a\\x0d\"\n",
  );
  assert(stable(src))
}

test "an interpolated string keeps its text as written and prints each hole flat" {
  let src = b"fn h(x: Int) -> String =   f\"x = {x   +   1} {{y}} \\n {f\"in {x}\"}\"\nfn k(a: Int, b: Int) -> String = f\"{a}\" ++ f\"{b}\"\n";
  assert_eq(
    formatted(src),
    b"fn h(x: Int) -> String = f\"x = {x + 1} {{y}} \\n {f\"in {x}\"}\"\nfn k(a: Int, b: Int) -> String = f\"{a}\" ++ f\"{b}\"\n",
  );
  assert(stable(src))
}

test "an interpolated string inside parentheses is still one, and loses only the parentheses" {
  lays_out(
    b"fn h(x: Int) -> String = (f\"a {x + 1}\")\n",
    b"fn h(x: Int) -> String = f\"a {x + 1}\"\n",
  );
  lays_out(
    b"fn h(x: Int) -> String = (f\"b {x}\") ++ ( ( f\"{x}\" ) )\n",
    b"fn h(x: Int) -> String = f\"b {x}\" ++ f\"{x}\"\n",
  )
}

test "a scrutinee that holds a record past its first operand is bracketed, as one that opens with it is" {
  lays_out(
    b"fn f(x: Int) -> Int = if (x + { a: x }.a) > 0 { 1 } else { 2 }\n",
    b"fn f(x: Int) -> Int = if (x + { a: x }.a > 0) { 1 } else { 2 }\n",
  );
  lays_out(
    b"fn f(x: Int) -> Int = match -({ a: x }.a) { 0 -> 1, _ -> 2 }\n",
    b"fn f(x: Int) -> Int = match (-{ a: x }.a) { 0 -> 1, _ -> 2 }\n",
  );
  lays_out(
    b"fn f(x: Int) -> Bool = if x == (1, 2)._0 { true } else { false }\n",
    b"fn f(x: Int) -> Bool = if x == (1, 2)._0 { true } else { false }\n",
  )
}

test "a source that ends at a one-byte body with no line break is printed" {
  lays_out(b"fn f(x: Int) -> Int = x", b"fn f(x: Int) -> Int = x\n")
}

test "a tagged literal is kept as written, its tag touching its string" {
  let src = b"fn f() -> Int =   List::len((hex\"de\\u{61}d\").nibbles)   +   [ uuid\"\" ].len()\n";
  assert_eq(
    formatted(src),
    b"fn f() -> Int = List::len(hex\"de\\u{61}d\".nibbles) + [uuid\"\"].len()\n",
  );
  assert(stable(src))
}

test "a tagged literal's texts are kept as written and its holes printed flat" {
  let src = b"fn f(x: Int) -> Int =   sh\"a {{b}} \\n {x   +   1}{ sh\"in {x}\" } z\"\n";
  assert_eq(formatted(src), b"fn f(x: Int) -> Int = sh\"a {{b}} \\n {x + 1}{sh\"in {x}\"} z\"\n");
  assert(stable(src));
  // A hole that opens with a brace of its own keeps a space beside the hole's.
  let braced = b"fn g() -> Int = sh\"{ {n: 1}.n }{  {n: 2}  }\" + List::len(f\"{ {n: 3}.n } { {n: 4} }\")\n";
  assert_eq(
    formatted(braced),
    b"fn g() -> Int = sh\"{ { n: 1 }.n }{ { n: 2 } }\" + List::len(f\"{ { n: 3 }.n } { { n: 4 } }\")\n",
  );
  assert(stable(braced))
}

test "a file that does not parse is refused with the first diagnostic, and never rewritten" {
  match fmt_source(b"fn f( = 1\n") {
    Ok(_) -> assert(false),
    Err(e) -> assert(e.starts_with(b"1:")),
  }
}

// Absorbing such a comment into the line's end put it after the body's opening brace, where the
// next pass read it as a leading comment of the first arm.
test "a comment between `=` or `->` and a block-like body keeps a line of its own" {
  let src = b"fn f(x: Int) -> Int = {\n  let y =\n    // why\n    match x { 1 -> 2, _ -> 3 };\n".concat(
    b"  match y {\n    2 ->\n      // because\n      if y > 1 { 1 } else { 0 },\n    _ -> 0,\n  }\n}\n",
  );
  let out = formatted(src);
  assert(out.index_of(b"// why") != None);
  assert(out.index_of(b"// because") != None);
  assert(stable(src));
  let header = b"fn g() -> Int // c\n  = { let z = 1; z }\n";
  assert(formatted(header).index_of(b"// c") != None);
  assert(stable(header))
}

test "specification clauses go on their own lines before the body" {
  let src = b"fn f(n: Int) -> Int requires n > 0 ensures result > n = n + 1\n";
  assert_eq(
    formatted(src),
    b"fn f(n: Int) -> Int\n  requires n > 0\n  ensures result > n\n= n + 1\n",
  );
  assert(stable(src));
  let measured = b"fn g(n: Int) -> Int decreases n = if n <= 1 { 0 } else { g(n / 2) }\n";
  assert_eq(
    formatted(measured),
    b"fn g(n: Int) -> Int\n  decreases n\n= if n <= 1 { 0 } else { g(n / 2) }\n",
  );
  assert(stable(measured));
  let held = b"fn h(p: P) -> Int requires (p == { a: 1 }) decreases (1 + { a: 1 }.a) = p.a\n";
  assert_eq(
    formatted(held),
    b"fn h(p: P) -> Int\n  requires p == { a: 1 }\n  decreases 1 + { a: 1 }.a\n= p.a\n",
  );
  assert(stable(held))
}

test "a guard or a table that holds a `{` keeps its parentheses before the block that follows" {
  let guarded = b"law \"l\" forall (p: P) where (p == { a: 1 }) { same(p) }\n";
  lays_out(guarded, guarded);
  let schema = b"law schema s(f: (P) -> Bool) forall (p: P) where (p == { a: 1 }) { f(p) }\n";
  lays_out(schema, schema);
  let wide = b"law \"l\" forall (p: P) where (p == { a: 1111111111 } || p == { a: 2222222222 } || p == { a: 3333333333 } || p == { a: 4444444444 }) { same(p) }\n";
  assert(stable(wide));
  let table = b"test \"t\" for c: Int in (the_first_table_of_cases_under_a_long_name ++ { rows: [1111111111, 2222222222, 3333333333, 4444444444] }.rows) { assert(c > 0) }\n";
  assert(stable(table))
}

fn range_of(src: Bytes, name: Bytes) -> Bytes / {abort.raise} =
  match item_range(src, name) {
    Ok(r) -> src.slice(r.start, r.end),
    Err(e) -> panic(String::of_bytes(e)),
  }

test "an item's range holds its `pub`, its `reuse`, the comment lines above it and a comment ending its last line" {
  let src = Bytes::concat_all([
    b"import spine (Span)\n\n// first\npub fn a() -> Int = 1  // one\n\n",
    b"// doc for b\n// on two lines\npub reuse fn b(x: Int) -> Int = x\n",
    b"type T = { x: Int }\n\n// stray\n\neffect clock { read now() -> Int }\n",
  ]);
  assert_eq(range_of(src, b"a"), b"// first\npub fn a() -> Int = 1  // one\n");
  assert_eq(
    range_of(src, b"b"),
    b"// doc for b\n// on two lines\npub reuse fn b(x: Int) -> Int = x\n",
  );
  assert_eq(range_of(src, b"T"), b"type T = { x: Int }\n");
  assert_eq(range_of(src, b"clock"), b"effect clock { read now() -> Int }\n");
  let bare = b"fn a() -> Int = 1\nfn b() -> Int = 2";
  assert_eq(range_of(bare, b"a"), b"fn a() -> Int = 1\n");
  assert_eq(range_of(bare, b"b"), b"fn b() -> Int = 2")
}

test "an item's range starts at its doc, across a blank line the formatter would close" {
  let src = b"fn a() -> Int = 1\n\n/// Two.\n\npub fn b() -> Int = 2\n";
  assert_eq(range_of(src, b"b"), b"/// Two.\n\npub fn b() -> Int = 2\n")
}

test "a doc holds to what it documents: no blank line is kept after a `///` line" {
  lays_out(
    b"/// The answer.\n\nfn f() -> Int = 42\n\n// --- next ---\n\n/// Another.\n///\n/// More.\nfn g() -> Int = 1\n",
    b"/// The answer.\nfn f() -> Int = 42\n\n// --- next ---\n\n/// Another.\n///\n/// More.\nfn g() -> Int = 1\n",
  );
  lays_out(b"//! The module.\n\nimport a\n", b"//! The module.\n\nimport a\n")
}

test "the docs of variants, fields and operations stay on the declarations they document" {
  let srcs = [
    b"pub type T =\n  /// The first.\n  | A\n  /// The second.\n  | B(Int)\n",
    b"type R = {\n  /// Its size.\n  size: Int,\n\n  /// Its name.\n  name: String,\n}\n",
    b"effect log {\n  /// Writes a line.\n  write line(s: String) -> Unit\n\n  /// Counts.\n  read count() -> Int\n}\n",
  ];
  srcs.fold((), |u: Unit, src: Bytes| {
    assert(stable(src));
    assert_eq(tree_of(formatted(src)), tree_of(src))
  })
}

test "an item that is absent, named twice, or in a text that does not parse is refused" {
  assert_eq(
    item_range(b"fn a() -> Int = 1\n", b"b"),
    Err(b"no `fn`, `type` or `effect` is named `b`"),
  );
  assert_eq(item_range(b"fn a() -> Int = 1\nfn a() -> Int = 2\n", b"a"), Err(b"`a` names 2 items"));
  match item_range(b"fn a( = 1\n", b"a") {
    Ok(_) -> assert(false),
    Err(e) -> assert(e.starts_with(b"1:")),
  }
}

test "a replacement rewrites the named item alone, formatted, and keeps every other byte" {
  let src = b"// head\nfn a() -> Int = 1\n\n// doc\npub fn b(x: Int) -> Int = x   // keep\n\nfn c() -> Int = 3  // tail\n";
  assert_eq(
    replace_item(src, b"b", b"// new doc\npub fn   b(x: Int)->Int = x+1\n"),
    Ok(
      b"// head\nfn a() -> Int = 1\n\n// new doc\npub fn b(x: Int) -> Int = x + 1\n\nfn c() -> Int = 3  // tail\n",
    ),
  );
  assert_eq(
    replace_item(src, b"c", b"fn c() -> Int = 4"),
    Ok(
      b"// head\nfn a() -> Int = 1\n\n// doc\npub fn b(x: Int) -> Int = x   // keep\n\nfn c() -> Int = 4\n",
    ),
  )
}

test "a replacement of another kind or name, or holding more than one item, is refused" {
  let src = b"fn a() -> Int = 1\ntype T = Int\n";
  assert_eq(
    replace_item(src, b"a", b"fn c() -> Int = 1\n"),
    Err(b"the replacement defines `fn` `c`; expected `fn` `a`"),
  );
  assert_eq(
    replace_item(src, b"T", b"fn a() -> Int = 1\n"),
    Err(b"the replacement defines `fn` `a`; expected `type` `T`"),
  );
  assert_eq(
    replace_item(src, b"a", b"test \"t\" { assert(true) }\n"),
    Err(b"the replacement defines a `test`; expected `fn` `a`"),
  );
  assert_eq(
    replace_item(src, b"a", b"fn a() -> Int = 1\nfn b() -> Int = 2\n"),
    Err(b"the replacement holds 2 items; it must be one"),
  );
  assert_eq(
    replace_item(src, b"a", b"import std.json\nfn a() -> Int = 1\n"),
    Err(b"the replacement holds an import; it must be one item"),
  );
  match replace_item(src, b"a", b"fn a( = 1\n") {
    Ok(_) -> assert(false),
    Err(e) -> assert(e.starts_with(b"the replacement does not parse: 1:")),
  }
}

test "a short `parallel` stays on its line, and a long one puts each branch on its own" {
  assert_eq(
    formatted(b"fn f() -> (Int, Int) = parallel {1,2}\n"),
    b"fn f() -> (Int, Int) = parallel { 1, 2 }\n",
  );
  let long = b"fn f() -> (Int, Int) = parallel { a_rather_long_function_name(1, 2, 3, 4, 5), another_rather_long_function_name(6, 7, 8, 9, 10) }\n";
  assert_eq(
    formatted(long),
    b"fn f() -> (Int, Int) =\n  parallel {\n    a_rather_long_function_name(1, 2, 3, 4, 5),\n    another_rather_long_function_name(6, 7, 8, 9, 10),\n  }\n",
  );
  assert(stable(long));
  assert_eq(
    formatted(b"fn g() -> Int = match (parallel { 1, 2 }) { _ -> 0 }\n"),
    b"fn g() -> Int = match (parallel { 1, 2 }) { _ -> 0 }\n",
  )
}

test "an `extern fn` prints as its declaration, a `where` on a line of its own" {
  lays_out(
    b"// kept\nextern   fn len<a>(xs:List<a>)->Int\n\nextern fn compare<a>(x: a, y: a) -> Ordering where derivable(ord, a)\n",
    b"// kept\nextern fn len<a>(xs: List<a>) -> Int\n\nextern fn compare<a>(x: a, y: a) -> Ordering\n  where derivable(ord, a)\n",
  )
}

test "an `extern fn` prints each clause it states on a line of its own" {
  lays_out(
    b"extern fn Bytes::at(b: Bytes, i: Int) -> Int / {abort.raise} requires 0<=i && i<Bytes::len(b) ensures 0 <= result\n",
    b"extern fn Bytes::at(b: Bytes, i: Int) -> Int / {abort.raise}\n  requires 0 <= i && i < Bytes::len(b)\n  ensures 0 <= result\n",
  )
}

test "an `extern type` prints as its name and parameters, `pub` where it is" {
  lays_out(
    b"/// A node.\npub   extern type  Node< a,b >\nextern type Hidden\n",
    b"/// A node.\npub extern type Node<a, b>\nextern type Hidden\n",
  )
}

test "a `numeric` prints on one line, its operations in the order written" {
  lays_out(
    b"type T = | T(Int)\nnumeric   for T by {of_int:g,\n  add : f ,}\n",
    b"type T = | T(Int)\nnumeric for T by { of_int: g, add: f }\n",
  )
}

test "a `key` and a `show` print on a line each, as written" {
  lays_out(
    b"type T = | T(Int)\n// read through\nkey   for T   by f\nshow for T by\n  g\n",
    b"type T = | T(Int)\n// read through\nkey for T by f\nshow for T by g\n",
  )
}

test "a hole prints as written, `???` or `..`" {
  lays_out(b"fn f(x: Int) -> Int = ???\n", b"fn f(x: Int) -> Int = ???\n");
  lays_out(b"fn f(x: Int) -> Int = ..\n", b"fn f(x: Int) -> Int = ..\n")
}

test "a bare lowercase type with no arguments keeps its `<>`, which tells it from a type variable" {
  lays_out(
    b"fn f(x: thing< >) -> List<thing<>> = [x]\n",
    b"fn f(x: thing<>) -> List<thing<>> = [x]\n",
  )
}

test "a string's hole with no one-line form is laid out in its braces" {
  let src = b"fn f() -> String = f\"a { { let y = 1; y } } b\" ++ sh\"{ { let z = 2; z } }\"\n";
  assert(stable(src));
  assert_eq(tree_of(formatted(src)), tree_of(src))
}

fn every_literal_and_form() -> Bytes =
  Bytes::concat_all([
    b"pub opaque type Box<a> where derivable(eq, a) = | Box(List<a>)\n",
    b"pub extern type Node<a, b>\n",
    b"extern fn len<a>(xs: List<a>) -> Int / {abort.raise} requires true ensures result >= 0\n",
    b"pub type Date = new { year: Int, month: Int }\n",
    b"pub type Sink<a, [l], [k] | e, f> = | Sink((a) -> Unit / {net.send[l] | e}) | Quiet\n",
    b"type T = | T(Int)\n",
    b"key for T by f\nshow for T by g\nnumeric for T by { of_int: g, add: f }\n",
    b"effect toml {\n  raise syntax(e: SyntaxError)\n  read peek[r]<a>(Int, at: a) -> a\n}\n",
    b"law schema s<a | e>(f: (a) -> a / e) forall (x: a) where x == x { f(x) == x }\n",
    b"law \"of {s} \\\"q\\\"\" = m::s(f, 1)\n",
    b"test \"each {c} \\\"q\\\" {{}}\" for c: Int in [1, 2] { assert(c > 0) }\n",
    b"test \"plain {{c}} \\\\\" for c: Int in [1] { assert(c > 0) }\n",
    b"test/nondet \"braced {c} alone\" { assert(true) }\n",
    b"fn held(x: thing<>, s: Sink<Int, [conn], [peer] | {}, {log.write | e}>) -> m::Seq<Int | {| e}> = s\n",
    b"fn relay<[l]>(c: Int) -> Unit / {net.send[l], db.read[*], db.write bounded | e bounded} = relay[l](c)\n",
    b"fn f<| e>(xs: List<Int>, g: keep (Int) -> Int / e cost k space s) -> Int / e\n",
    b"  cost xs.len() * k\n  space s\n  decreases xs.len()\n= 0\n",
    b"fn ints() -> List<Int> = [0, 7, 0x7FFF_FFFF_FFFF_FFFF, 0xFFFF_FFFF_FFFF_FFFF, 0x8000_0000_0000_0000, b'x', -3]\n",
    b"fn widths() -> List<Int> = [0u8, 255u8, 127i8, 0x80i8, 0xFFFF_FFFF_FFFF_FFFFu64, ",
    b"0x8000_0000_0000_0000i64, 65535u16, 0x8000i16, 4294967295u32, 0x8000_0000i32, ",
    b"340282366920938463463374607431768211455u128, 0x8000_0000_0000_0000_0000_0000_0000_0000i128, ",
    b"170141183460469231731687303715884105727i128, 5u128]\n",
    b"fn reals() -> List<Float> = [0.1, 1e300, 5e-324, 1_000.5, 1.50m, 0.00m, 79228162514264337593543950335m]\n",
    b"fn texts() -> List<String> = [\"tab\\there \\\"q\\\" \\\\ \\u{1F600} {x} \\u{7}\", b\"\\x00\\xff\\\"\", ",
    b"'a', '\\'', '\\n', '\\u{e9}', true, false, (), \\\\a line\n  \\\\and another\n]\n",
    b"fn strings(a: Int, b: Int, s: String) -> String = {\n",
    b"  let h = f\"x = {a} and {{braces}} {f\"in {b}\"} {\"s\"} \\n\";\n",
    b"  let i = f\"{a}\" ++ f\"{b}\" ++ \"tail\";\n",
    b"  let j = sh\"text {a} {{b}} \\n {sh\"in {b}\"} z\";\n",
    b"  let k = hex\"de\\u{61}d\";\n",
    b"  let l = f\"{ { let y = 1; y } }\" ++ sh\"{ { let z = 2; z } }\";\n",
    b"  let n = s ++ f\"{a}b\" ++ (\"c\" ++ \"d\");\n",
    b"  h\n",
    b"}\n",
    b"fn forms(a: Int, o: Option<Int>) -> Int = {\n",
    b"  let l = #{\"a\": 1, \"b\": 2};\n",
    b"  let m = #[3, 1];\n",
    b"  let n = Map::of_entries([{ key: 1, value: 2, extra: 3 }]);\n",
    b"  let e = #{};\n",
    b"  let w = wrap_add(a, 1) +% a *| 2 + wrap_mul[l](a, 3) + wrap_sub(a, 4, by: 5);\n",
    b"  let Some(v) = o else { 0 };\n",
    b"  let t = try[m::toml.syntax] { digit(a) };\n",
    b"  let u = try { digit(a) };\n",
    b"  let h = handle { g(a) } with { db.get[*](k) -> k, db.put[*t](k, x) -> x };\n",
    b"  let p = { x: x, y: 1 };\n",
    b"  match a {\n",
    b"    0 | 1 -> 0,\n",
    b"    -5..=-1 -> 1,\n",
    b"    0x10..=0x20 -> 2,\n",
    b"    b'a'..=b'z' -> 3,\n",
    b"    'a' -> 4,\n",
    b"    -1.5 -> 5,\n",
    b"    -2i8 -> 6,\n",
    b"    -0x7FFF_FFFF_FFFF_FFFF -> 7,\n",
    b"    0x80i8 | 0x8000_0000_0000_0000 | -5i128 | 0x8000_0000_0000_0000_0000_0000_0000_0000i128 -> 7,\n",
    b"    \"s\" -> 8,\n",
    b"    b\"b\" -> 9,\n",
    b"    1.50m -> 10,\n",
    b"    { key: k, value: x } -> k,\n",
    b"    _ -> ???,\n",
    b"  }\n",
    b"}\n",
    b"fn todo() -> Int = ..\n",
  ])

test "every form prints back to the same tree from its source" {
  assert(stable(every_literal_and_form()))
}

// --- A tree no source holds -------------------------------------------------

fn bare_id(i: Ident) -> Ident = { name: i.name, span: dummy_span() }

fn bare_ids(xs: List<Ident>) -> List<Ident> = xs.map(bare_id)

fn bare_q(q: QName) -> QName =
  { module: q.module.map(bare_id), name: bare_id(q.name), span: dummy_span() }

fn bare_at(at: Option<Span>) -> Option<Span> = at.map(|s: Span| dummy_span())

fn bare_doc(d: Doc) -> Doc = { lines: d.lines, span: dummy_span() }

fn bare_ty(t: TypeExpr) -> TypeExpr =
  match t {
    TVar(i) -> TVar(bare_id(i)),
    TCon(x) ->
      TCon({
        span: dummy_span(),
        name: bare_q(x.name),
        args: x.args.map(bare_ty),
        labels: bare_ids(x.labels),
        rows: x.rows.map(bare_row),
      }),
    TFn(x) ->
      TFn({
        span: dummy_span(),
        params: x.params.map(bare_ty),
        ret: bare_ty(x.ret),
        effects: x.effects.map(bare_row),
      }),
    TRecord(x) ->
      TRecord({
        span: dummy_span(),
        fields: x.fields.map(|f: { name: Ident, ty: TypeExpr }|
          { name: bare_id(f.name), ty: bare_ty(f.ty) }),
      }),
    TUnit(_) -> TUnit({ span: dummy_span() }),
    TBad(_) -> TBad({ span: dummy_span() }),
  }

fn bare_atom(a: AtomExpr) -> AtomExpr =
  {
    eff: bare_q(a.eff),
    mode: a.mode,
    op: a.op.map(bare_id),
    resource: a.resource.map(bare_id),
    every: a.every,
    bounded: a.bounded,
    span: dummy_span(),
  }

fn bare_row(r: RowExpr) -> RowExpr =
  {
    atoms: r.atoms.map(bare_atom),
    aliases: r.aliases.map(bare_q),
    tail: r.tail.map(bare_id),
    tail_bounded: r.tail_bounded,
    span: dummy_span(),
  }

fn bare_pat(p: Pattern) -> Pattern =
  match p {
    PWild(_) -> PWild({ span: dummy_span() }),
    PVar(v) -> PVar({ span: dummy_span(), name: bare_id(v.name) }),
    PLit(v) -> PLit({ span: dummy_span(), lit: v.lit }),
    PRange(v) -> PRange({ span: dummy_span(), lo: v.lo, hi: v.hi }),
    PCtor(v) -> PCtor({ span: dummy_span(), name: bare_q(v.name), args: v.args.map(bare_pat) }),
    PRecord(v) ->
      PRecord({
        span: dummy_span(),
        rest: v.rest,
        fields: v.fields.map(|f: { name: Ident, pat: Pattern }|
          { name: bare_id(f.name), pat: bare_pat(f.pat) }),
      }),
    PList(v) ->
      PList({ span: dummy_span(), rest: v.rest.map(bare_pat), items: v.items.map(bare_pat) }),
    POr(v) -> POr({ span: dummy_span(), alts: v.alts.map(bare_pat) }),
    PBad(_) -> PBad({ span: dummy_span() }),
  }

fn bare_param(p: Param) -> Param =
  {
    name: bare_id(p.name),
    keep: p.keep,
    ty: p.ty.map(bare_ty),
    cost: p.cost.map(bare_id),
    space: p.space.map(bare_id),
    default: p.default.map(bare_expr),
    span: dummy_span(),
  }

fn bare_field(f: RecField) -> RecField = { name: bare_id(f.name), value: bare_expr(f.value) }

fn bare_stmt(s: Stmt) -> Stmt =
  match s {
    SLet(v) ->
      SLet({
        span: dummy_span(),
        pat: bare_pat(v.pat),
        ty: v.ty.map(bare_ty),
        value: bare_expr(v.value),
      }),
    SLetElse(v) ->
      SLetElse({
        span: dummy_span(),
        pat: bare_pat(v.pat),
        ty: v.ty.map(bare_ty),
        value: bare_expr(v.value),
        fallback: bare_expr(v.fallback),
      }),
    SExpr(x) -> SExpr(bare_expr(x)),
    SAssign(v) -> SAssign({ span: dummy_span(), name: bare_id(v.name), value: bare_expr(v.value) }),
  }

fn bare_clause(c: HandleClause) -> HandleClause =
  {
    eff: bare_q(c.eff),
    op: bare_id(c.op),
    resource: c.resource.map(bare_id),
    every_label: c.every_label,
    label_binder: c.label_binder.map(bare_id),
    resume: c.resume.map(bare_id),
    body: bare_expr(c.body),
    span: dummy_span(),
    params: bare_ids(c.params),
  }

fn bare_expr(e: Expr) -> Expr =
  match e {
    ELit(v) -> ELit({ span: dummy_span(), lit: v.lit }),
    EVar(v) -> EVar({ span: dummy_span(), name: bare_q(v.name) }),
    EBinary(v) ->
      EBinary({ span: dummy_span(), op: v.op, lhs: bare_expr(v.lhs), rhs: bare_expr(v.rhs) }),
    EUnary(v) -> EUnary({ span: dummy_span(), op: v.op, operand: bare_expr(v.operand) }),
    ELambda(v) ->
      ELambda({
        span: dummy_span(),
        body: bare_expr(v.body),
        params: v.params.map(bare_param),
        ret: v.ret.map(bare_ty),
      }),
    EApp(v) ->
      EApp({
        span: dummy_span(),
        func: bare_expr(v.func),
        named: v.named.map(|a: NamedArg|
          { name: bare_id(a.name), value: bare_expr(a.value), span: dummy_span() }),
        args: v.args.map(bare_expr),
        labels: bare_ids(v.labels),
      }),
    EIf(v) ->
      EIf({
        span: dummy_span(),
        cond: bare_expr(v.cond),
        then_branch: bare_expr(v.then_branch),
        else_branch: bare_expr(v.else_branch),
      }),
    EMatch(v) ->
      EMatch({
        span: dummy_span(),
        scrutinee: bare_expr(v.scrutinee),
        arms: v.arms.map(|a: MatchArm|
          {
            pat: bare_pat(a.pat),
            guard: a.guard.map(bare_expr),
            body: bare_expr(a.body),
            span: dummy_span(),
          }),
      }),
    EBlock(v) ->
      EBlock({ span: dummy_span(), tail: v.tail.map(bare_expr), stmts: v.stmts.map(bare_stmt) }),
    ERecord(v) -> ERecord({ span: dummy_span(), fields: v.fields.map(bare_field) }),
    ERecordUpdate(v) ->
      ERecordUpdate({
        span: dummy_span(),
        base: bare_expr(v.base),
        fields: v.fields.map(bare_field),
      }),
    ETry(v) -> ETry({ span: dummy_span(), operand: bare_expr(v.operand) }),
    EField(v) -> EField({ span: dummy_span(), base: bare_expr(v.base), field: bare_id(v.field) }),
    EList(v) -> EList({ span: dummy_span(), items: v.items.map(bare_expr) }),
    EPerform(v) ->
      EPerform({
        span: dummy_span(),
        eff: bare_q(v.eff),
        op: bare_id(v.op),
        resource: v.resource.map(bare_id),
        args: v.args.map(bare_expr),
      }),
    EHandle(v) ->
      EHandle({
        span: dummy_span(),
        body: bare_expr(v.body),
        ret: v.ret.map(|r: ReturnClause|
          { binder: bare_id(r.binder), body: bare_expr(r.body), span: dummy_span() }),
        clauses: v.clauses.map(bare_clause),
        vars: v.vars.map(|x: HandlerVar|
          {
            name: bare_id(x.name),
            ty: x.ty.map(bare_ty),
            init: bare_expr(x.init),
            span: dummy_span(),
          }),
      }),
    EWithHold(v) ->
      EWithHold({
        span: dummy_span(),
        resource: bare_id(v.resource),
        acquire: bare_expr(v.acquire),
        release: bare_expr(v.release),
        binder: bare_id(v.binder),
        body: bare_expr(v.body),
      }),
    ESimulate(v) -> ESimulate({ span: dummy_span(), body: bare_expr(v.body) }),
    EParallel(v) -> EParallel({ span: dummy_span(), branches: v.branches.map(bare_expr) }),
    ETagged(v) ->
      ETagged({
        span: dummy_span(),
        tag: bare_id(v.tag),
        text: v.text,
        quoted: dummy_span(),
        holes: v.holes.map(|h: Hole|
          { value: bare_expr(h.value), text: h.text, quoted: dummy_span() }),
      }),
    EHole(v) -> EHole({ span: dummy_span(), text: v.text }),
    EBad(_) -> EBad({ span: dummy_span() }),
    ETryBlock(v) ->
      ETryBlock({
        span: dummy_span(),
        raise: v.raise.map(|r: RaiseName| { eff: bare_q(r.eff), op: bare_id(r.op) }),
        body: bare_expr(v.body),
      }),
  }

fn bare_generics(g: Generics) -> Generics =
  { types: bare_ids(g.types), effects: bare_ids(g.effects), labels: bare_ids(g.labels) }

fn bare_constraint(c: Constraint) -> Constraint =
  { deriver: c.deriver, deriver_span: dummy_span(), param: bare_id(c.param), span: dummy_span() }

fn bare_spec(c: SpecClause) -> SpecClause =
  { kind: c.kind, expr: bare_expr(c.expr), span: dummy_span() }

fn bare_binder(b: Binder) -> Binder =
  { name: bare_id(b.name), ty: bare_ty(b.ty), span: dummy_span() }

fn bare_returns(r: Returns) -> Returns =
  match r {
    ReturnsFresh(_) -> ReturnsFresh(dummy_span()),
    ReturnsParam(i) -> ReturnsParam(bare_id(i)),
  }

fn bare_body(b: TypeDefBody) -> TypeDefBody =
  match b {
    TDAlias(t) -> TDAlias(bare_ty(t)),
    TDSum(vs) ->
      TDSum(
        vs.map(|v: VariantDef|
          {
            name: bare_id(v.name),
            fields: v.fields.map(bare_ty),
            doc: v.doc.map(bare_doc),
            span: dummy_span(),
          }),
      ),
    TDNominal(t) -> TDNominal(bare_ty(t)),
    TDExtern -> TDExtern,
  }

fn bare_item(it: Item) -> Item =
  match it {
    IFn(d) ->
      IFn({
        vis: d.vis,
        name: bare_id(d.name),
        generics: bare_generics(d.generics),
        params: d.params.map(bare_param),
        ret: d.ret.map(bare_ty),
        effects: d.effects.map(bare_row),
        constraints: d.constraints.map(bare_constraint),
        spec: d.spec.map(bare_spec),
        returns: d.returns.map(bare_returns),
        reuse: bare_at(d.reuse),
        transparent: bare_at(d.transparent),
        baked: bare_at(d.baked),
        decreases: d.decreases.map(bare_expr),
        body: bare_expr(d.body),
        doc: d.doc.map(bare_doc),
        span: dummy_span(),
      }),
    IType(d) ->
      IType({
        vis: d.vis,
        opaque: d.opaque.map(|o: Opaque| { span: dummy_span(), answer: o.answer, take: o.take }),
        name: bare_id(d.name),
        generics: bare_generics(d.generics),
        constraints: d.constraints.map(bare_constraint),
        body: bare_body(d.body),
        doc: d.doc.map(bare_doc),
        field_docs: d.field_docs.map(|f: FieldDoc| { name: f.name, doc: bare_doc(f.doc) }),
        span: dummy_span(),
      }),
    IEffect(d) ->
      IEffect({
        vis: d.vis,
        name: bare_id(d.name),
        is_nondet: d.is_nondet,
        ops: d.ops.map(|op: OpDef|
          {
            name: bare_id(op.name),
            mode: op.mode,
            resource_param: op.resource_param,
            ty_params: bare_ids(op.ty_params),
            params: op.params.map(bare_ty),
            ret: bare_ty(op.ret),
            doc: op.doc.map(bare_doc),
            span: dummy_span(),
          }),
        doc: d.doc.map(bare_doc),
        span: dummy_span(),
      }),
    ITest(d) ->
      ITest({
        name: d.name,
        name_span: dummy_span(),
        is_nondet: d.is_nondet,
        cases: d.cases.map(|c: Cases|
          {
            binder: bare_id(c.binder),
            ty: bare_ty(c.ty),
            table: bare_expr(c.table),
            label: bare_expr(c.label),
            for_span: dummy_span(),
            in_span: dummy_span(),
          }),
        body: bare_expr(d.body),
        span: dummy_span(),
      }),
    ILaw(d) ->
      ILaw({
        name: d.name,
        name_span: dummy_span(),
        binders: d.binders.map(bare_binder),
        guard: d.guard.map(bare_expr),
        of: d.of.map(|o: OfSchema|
          { schema: bare_q(o.schema), home: o.home, shown: o.shown, span: dummy_span() }),
        body: bare_expr(d.body),
        span: dummy_span(),
      }),
    ISchema(d) ->
      ISchema({
        vis: d.vis,
        name: bare_id(d.name),
        generics: bare_generics(d.generics),
        params: d.params.map(bare_binder),
        binders: d.binders.map(bare_binder),
        guard: d.guard.map(bare_expr),
        body: bare_expr(d.body),
        doc: d.doc.map(bare_doc),
        span: dummy_span(),
      }),
    IDerive(d) ->
      IDerive({
        deriver: d.deriver,
        deriver_span: dummy_span(),
        target: bare_id(d.target),
        span: dummy_span(),
      }),
    IEffectSet(d) ->
      IEffectSet({
        name: bare_id(d.name),
        vis: d.vis,
        atoms: d.atoms.map(bare_atom),
        includes: d.includes.map(bare_q),
        expansion: d.expansion.map(bare_atom),
        doc: d.doc.map(bare_doc),
        span: dummy_span(),
      }),
    IExtern(d) ->
      IExtern({
        vis: d.vis,
        name: bare_id(d.name),
        generics: bare_generics(d.generics),
        params: d.params.map(bare_param),
        ret: bare_ty(d.ret),
        effects: d.effects.map(bare_row),
        constraints: d.constraints.map(bare_constraint),
        spec: d.spec.map(bare_spec),
        doc: d.doc.map(bare_doc),
        span: dummy_span(),
        written: b"",
      }),
    IInstance(d) ->
      IInstance({ kind: d.kind, target: bare_id(d.target), by: bare_id(d.by), span: dummy_span() }),
    INumeric(d) ->
      INumeric({
        target: bare_id(d.target),
        ops: d.ops.map(|x: NumericOp| { op: bare_id(x.op), by: bare_id(x.by) }),
        span: dummy_span(),
      }),
  }

fn bare_import(decl: ImportDecl) -> ImportDecl =
  {
    path: bare_ids(decl.path),
    kind: match decl.kind {
      IModule -> IModule,
      IAlias(a) -> IAlias(bare_id(a)),
      INames(ns) -> INames(bare_ids(ns)),
    },
    span: dummy_span(),
  }

/// `src`'s tree with every span the dummy one, printed with no source, parses back to that tree.
fn prints_bare(src: Bytes) -> Unit / {abort.raise} = {
  let tree = parse(src).node;
  let bare = {
    doc: None,
    imports: tree.imports.map(bare_import),
    items: tree.items.map(bare_item),
  };
  let out = module_text(bare);
  let again = parse(out);
  match again.parser.diags.at(0) {
    Some(d) -> panic(String::of_bytes(Bytes::concat_all([render_diag(out, d), b" in\n", out]))),
    None -> assert_eq(erase_spans(dump_module(again.node)), erase_spans(dump_module(bare))),
  }
}

test "a tree no source holds prints back to itself, every item, expression, literal and form among it" {
  prints_bare(every_item_kind());
  prints_bare(every_expression_kind());
  prints_bare(every_literal_and_form())
}
