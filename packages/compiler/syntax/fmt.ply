import std.bytes (is_digit, ascii_of_int)

pub fn fmt_source(source: Bytes) -> Result<Bytes, Bytes> / {abort.raise} = {
  let r = parse(source);
  match r.parser.diagnostics.at(0) {
    Some(d) -> Err(render_diagnostic(source, d)),
    None -> {
      let out = module({ source: source, comments: lex(source).comments }, {
        ..r.node,
        items: r.node.items.map(with_operators),
      });
      let again = parse(out);
      match again.parser.diagnostics.at(0) {
        Some(d) ->
          Err(
            b"formatter bug: the formatted text does not parse: ".concat(render_diagnostic(out, d)),
          ),
        None -> if erase_spans(dump_module(again.node)) != erase_spans(dump_module(r.node)) {
          Err(b"formatter bug: the formatted text parses to a different tree")
        } else { Ok(out) },
      }
    },
  }
}

fn as_operator(e: Expression) -> Expression =
  match e {
    CallExpression(a) -> match ((written_operator(a.function, a.args), a.args)) {
      (Some(o), [left, right]) -> if a.labels.len() > 0 || a.named.len() > 0 { e } else {
        BinaryExpression({
          span: a.span,
          operation: o.name,
          left_operand: left,
          right_operand: right,
        })
      },
      _ -> e,
    },
    _ -> e,
  }

fn with_operators(item: Item) -> Item = {
  let go = |x: Expression| expression_nodes_mapped(x, as_operator);
  let opt = |x: Option<Expression>| match x { Some(y) -> Some(go(y)), None -> None };
  match map_item(item, as_operator) {
    FunctionItem(d) -> FunctionItem({ ..d, decreases: opt(d.decreases) }),
    SchemaItem(d) -> SchemaItem({ ..d, guard: opt(d.guard), body: go(d.body) }),
    other -> other,
  }
}

fn render_diagnostic(source: Bytes, diagnostic: ParseDiagnostic) -> Bytes / {abort.raise} = {
  let s = primary_span_of(diagnostic);
  let lines = source.slice(0, s.start).split(b"\n");
  let col = lines.get(lines.len() - 1).len() + 1;
  Bytes::concat_all([
    ascii_of_int(lines.len()),
    b":",
    ascii_of_int(col),
    b": ",
    diagnostic.code,
    b": ",
    diagnostic.message,
  ])
}

type PrintInput = { source: Bytes, comments: List<Comment> }

fn in_source(input: PrintInput, span: Span) -> Bool =
  span.start < span.end && span.end <= input.source.len()

type Printer = {
  next_comment: Int,
  column: Int,
  previous_end: Int,
  pending: List<Bytes>,
  closed: Int,
  parts: List<Bytes>,
}

fn width() -> Int = 100

fn is_blank(c: Int) -> Bool = c == 32 || c == 9 || c == 13

fn spaces(n: Int) -> Bytes = Bytes::concat_all(range(0, n).map(|i: Int| b" "))

fn trim_end(b: Bytes) -> Bytes / {abort.raise} = {
  let k = iterate(b.len(), b.len() + 1, |i: Int|
    if i > 0 && is_blank(b.at(i - 1)) { Continue(i - 1) } else { Stop(i) });
  b.slice(0, k)
}

fn trim(b: Bytes) -> Bytes / {abort.raise} = {
  let t = trim_end(b);
  let k = iterate(0, t.len() + 1, |i: Int|
    if i < t.len() && is_blank(t.at(i)) { Continue(i + 1) } else { Stop(i) });
  t.slice(k, t.len())
}

fn trim_last(parts: List<Bytes>) -> List<Bytes> / {abort.raise} = {
  let n = parts.len();
  if n == 0 { parts } else { parts.set(n - 1, trim_end(parts.get(n - 1))) }
}

fn emit(printer: Printer, b: Bytes) -> Printer / {abort.raise} =
  if printer.closed >= 0 && trim(b).len() > 0 {
    append_text(newline(printer, printer.closed, false), trim(b))
  } else { append_text(printer, b) }

fn append_text(printer: Printer, b: Bytes) -> Printer =
  {
    next_comment: printer.next_comment,
    previous_end: printer.previous_end,
    pending: printer.pending,
    column: printer.column + b.len(),
    closed: printer.closed,
    parts: printer.parts.push(b),
  }

fn set_previous(printer: Printer, e: Int) -> Printer = { ..printer, previous_end: e }

fn with_trailing(
  parts: List<Bytes>,
  pending: List<Bytes>,
  indent: Int,
) -> List<Bytes> / {abort.raise} =
  range(0, pending.len()).fold(trim_last(parts), |ps: List<Bytes>, i: Int|
    ps.push(
      Bytes::concat(if i == 0 { b"  " } else { b"\n".concat(spaces(indent)) }, pending.get(i)),
    ))

fn newline(printer: Printer, indent: Int, blank: Bool) -> Printer / {abort.raise} = {
  let pending = printer.pending;
  let n = printer.parts.len();
  let fresh = n > 0 && pending.len() == 0 && !blank
    && trim_end(printer.parts.get(n - 1)).len() == 0;
  if fresh {
    {
      next_comment: printer.next_comment,
      previous_end: printer.previous_end,
      pending: [],
      column: indent,
      closed: -1,
      parts: printer.parts.set(n - 1, spaces(indent)),
    }
  } else {
    let trailed = with_trailing(printer.parts, pending, indent);
    let leading_comments = if trailed.len() == 0 { b"" } else if blank { b"\n\n" } else { b"\n" };
    {
      next_comment: printer.next_comment,
      previous_end: printer.previous_end,
      pending: [],
      column: indent,
      closed: -1,
      parts: trailed.push(leading_comments.concat(spaces(indent))),
    }
  }
}

fn line_empty(printer: Printer) -> Bool =
  match printer.parts.at(printer.parts.len() - 1) {
    None -> true,
    Some(last) ->
      range(0, last.len()).fold(true, |all: Bool, i: Int|
        all && (last.at(i) == 10 || is_blank(last.at(i)))),
  }

fn finish(printer: Printer) -> Bytes / {abort.raise} = {
  let trailed = with_trailing(printer.parts, printer.pending, 0);
  if trailed.len() == 0 { b"" } else { Bytes::concat_all(trailed).concat(b"\n") }
}

fn fits(printer: Printer, text: Bytes, after: Int) -> Bool =
  printer.column + text.len() + after <= width()

fn next_comment(input: PrintInput, printer: Printer) -> Option<Comment> =
  input.comments.at(printer.next_comment)

fn comment_before(p: PrintInput, printer: Printer, position: Int) -> Bool =
  match next_comment(p, printer) { Some(c) -> c.start < position, None -> false }

fn comment_text(input: PrintInput, c: Comment) -> Bytes / {abort.raise} =
  trim_end(input.source.slice(c.start, c.end))

fn same_line(input: PrintInput, a: Int, b: Int) -> Bool / {abort.raise} =
  a <= b && (match input.source.slice(a, b).index_of(b"\n") { Some(_) -> false, None -> true })

fn has_blank_line_between(input: PrintInput, a: Int, b: Int) -> Bool / {abort.raise} =
  a <= b && input.source.slice(a, b).split(b"\n").len() >= 3

fn take_comment(printer: Printer, c: Comment) -> Printer =
  { ..printer, next_comment: printer.next_comment + 1, previous_end: c.end }

fn preserves_blank_line(input: PrintInput, printer: Printer, at: Int) -> Bool / {abort.raise} =
  has_blank_line_between(input, printer.previous_end, at)
    && !(match input.comments.at(printer.next_comment - 1) {
      Some(c) -> c.end == printer.previous_end && doc_mark(input.source, c) == Some(ItemDoc),
      None -> false,
    })

fn flush_comments(
  input: PrintInput,
  printer: Printer,
  before: Int,
  indent: Int,
  blanks: Bool,
) -> Printer / {abort.raise} =
  match input.comments.at(printer.next_comment) {
    Some(c) -> if c.start < before {
      let s = newline(printer, indent, blanks && preserves_blank_line(input, printer, c.start));
      flush_comments(
        input,
        take_comment(emit(s, comment_text(input, c)), c),
        before,
        indent,
        blanks,
      )
    } else { printer },
    None -> printer,
  }

fn newline_after_comments(
  input: PrintInput,
  printer: Printer,
  start: Int,
  indent: Int,
  blanks: Bool,
) -> Printer / {abort.raise} = {
  let s = flush_comments(input, printer, start, indent, blanks);
  newline(s, indent, blanks && preserves_blank_line(input, s, start))
}

fn leading_comments(
  input: PrintInput,
  printer: Printer,
  start: Int,
  indent: Int,
) -> Printer / {abort.raise} =
  if comment_before(input, printer, start) {
    newline_after_comments(input, printer, start, indent, false)
  } else { printer }

fn trailing_comment(input: PrintInput, printer: Printer, end: Int) -> Printer / {abort.raise} =
  match next_comment(input, printer) {
    Some(c) -> if c.start >= end && same_line(input, end, c.start) {
      take_comment(
        {
          next_comment: printer.next_comment,
          column: printer.column,
          previous_end: printer.previous_end,
          closed: printer.closed,
          parts: printer.parts,
          pending: printer.pending.push(comment_text(input, c)),
        },
        c,
      )
    } else { printer },
    None -> printer,
  }

fn absorb(input: PrintInput, printer: Printer, end: Int) -> Printer / {abort.raise} =
  match input.comments.at(printer.next_comment) {
    Some(c) -> if c.start < end {
      absorb(
        input,
        take_comment(
          {
            next_comment: printer.next_comment,
            column: printer.column,
            previous_end: printer.previous_end,
            closed: printer.closed,
            parts: printer.parts,
            pending: printer.pending.push(comment_text(input, c)),
          },
          c,
        ),
        end,
      )
    } else { printer },
    None -> printer,
  }

fn close(
  input: PrintInput,
  printer: Printer,
  end: Int,
  indent: Int,
  closer: Bytes,
) -> Printer / {abort.raise} =
  emit(newline(flush_comments(input, printer, end, indent + 2, false), indent, false), closer)

fn try_flat(
  input: PrintInput,
  printer: Printer,
  flat: Option<Bytes>,
  end: Int,
  after: Int,
) -> Option<Bytes> =
  match flat {
    Some(f) -> if !comment_before(input, printer, end) && fits(printer, f, after) { Some(f) }
    else { None },
    None -> None,
  }

fn concat_options(xs: List<Option<Bytes>>) -> Option<Bytes> =
  xs.fold(Some(b""), |accumulator: Option<Bytes>, x: Option<Bytes>|
    match accumulator {
      None -> None,
      Some(a) -> match x { None -> None, Some(b) -> Some(a.concat(b)) },
    })

fn join_options(xs: List<Option<Bytes>>, s: Bytes) -> Option<Bytes> / {abort.raise} =
  range(0, xs.len()).fold(Some(b""), |accumulator: Option<Bytes>, i: Int|
    match accumulator {
      None -> None,
      Some(a) -> match xs.get(i) {
        None -> None,
        Some(b) -> Some(if i == 0 { b } else { Bytes::concat_all([a, s, b]) }),
      },
    })

fn resource_text(r: Option<Identifier>) -> Bytes =
  match r { Some(i) -> Bytes::concat_all([b"[", i.name, b"]"]), None -> b"" }

fn call_labels(idents: List<Identifier>) -> Bytes =
  if idents.len() == 0 { b"" } else {
    Bytes::concat_all([
      b"[",
      Bytes::join(idents.map(|identifier: Identifier| identifier.name), b", "),
      b"]",
    ])
  }

fn effect_text(entry: EffectExpression) -> Bytes =
  Bytes::concat_all([
    qualified_name_text(entry.effect_name),
    b".",
    match entry.operation { Some(o) -> o.name, None -> mode_text(entry.mode) },
    effect_label_text(entry),
    if entry.bounded { b" bounded" } else { b"" },
  ])

fn effect_label_text(entry: EffectExpression) -> Bytes =
  if entry.resource_wildcard { b"[*]" } else { resource_text(entry.resource) }

fn members(effects: List<EffectExpression>, names: List<QName>) -> List<Bytes> / {abort.raise} = {
  let xs = effects.map(|entry: EffectExpression|
    { start: entry.span.start, text: effect_text(entry) });
  let ys = names.map(|qualified_name: QName|
    { start: qualified_name.span.start, text: qualified_name_text(qualified_name) });
  let merged = iterate(
    { i: 0, j: 0, out: [] },
    xs.len() + ys.len() + 1,
    |s: { i: Int, j: Int, out: List<Bytes> }|
      if s.i >= xs.len() && s.j >= ys.len() { Stop(s.out) }
      else if s.j >= ys.len() || (s.i < xs.len() && xs.get(s.i).start < ys.get(s.j).start) {
        Continue({ i: s.i + 1, j: s.j, out: s.out.push(xs.get(s.i).text) })
      } else { Continue({ i: s.i, j: s.j + 1, out: s.out.push(ys.get(s.j).text) }) },
  );
  merged
}

fn effects_text(input: PrintInput, effects: EffectsExpression) -> Bytes / {abort.raise} = {
  let ms = Bytes::join(members(effects.listed, effects.aliases), b", ");
  let braced = if in_source(input, effects.span) { input.source.at(effects.span.start) == 123 }
  else { ms.len() > 0 };
  match effects.variable {
    Some(t) -> {
      let v = if effects.variable_bounded { t.name.concat(b" bounded") } else { t.name };
      if !braced { v }
      else if ms.len() == 0 { Bytes::concat_all([b"{| ", v, b"}"]) }
      else { Bytes::concat_all([b"{", ms, b" | ", v, b"}"]) }
    },
    None -> Bytes::concat_all([b"{", ms, b"}"]),
  }
}

fn effects_suffix(input: PrintInput, r: Option<EffectsExpression>) -> Bytes / {abort.raise} =
  match r { Some(x) -> b" / ".concat(effects_text(input, x)), None -> b"" }

fn positional_name(i: Int) -> Bytes = b"_".concat(ascii_of_int(i))

pub fn is_type_tuple(
  fields: List<{ name: Identifier, ty: TypeExpression }>,
) -> Bool / {abort.raise} =
  fields.len() >= 2
    && range(0, fields.len()).fold(true, |ok: Bool, i: Int| {
      let f = fields.get(i);
      ok && f.name.name == positional_name(i) && f.name.span == type_span(f.ty)
    })

fn type_text(input: PrintInput, t: TypeExpression) -> Bytes / {abort.raise} =
  match t {
    VariableTypeExpression(i) -> i.name,
    NamedTypeExpression(x) -> {
      let args = angled(
        x.args.map(|a: TypeExpression| type_text(input, a)),
        identifier_names(x.labels),
        x.effect_arguments.map(|r: EffectsExpression| effects_text(input, r)),
      );
      let lone = args.len() == 0 && x.name.module == None && !starts_upper(x.name.name.name);
      qualified_name_text(x.name).concat(if lone { b"<>" } else { args })
    },
    FunctionTypeExpression(x) ->
      Bytes::concat_all([
        if x.once { b"once (" } else { b"(" },
        Bytes::join(
          range(0, x.params.len()).map(|i: Int|
            (if x.keep_indices.contains(i) { b"keep " } else { b"" }).concat(
              type_text(input, x.params.get(i)),
            )),
          b", ",
        ),
        b") -> ",
        result_text(input, x.return_type, x.effects),
      ]),
    RecordTypeExpression(x) -> if is_type_tuple(x.fields) {
      Bytes::concat_all([
        b"(",
        Bytes::join(
          x.fields.map(|f: { name: Identifier, ty: TypeExpression }| type_text(input, f.ty)),
          b", ",
        ),
        b")",
      ])
    } else if x.fields.len() == 0 { b"{}" } else {
      Bytes::concat_all([
        b"{ ",
        Bytes::join(
          x.fields.map(|f: { name: Identifier, ty: TypeExpression }| type_field_text(input, f)),
          b", ",
        ),
        b" }",
      ])
    },
    UnitTypeExpression(_) -> b"()",
    InvalidTypeExpression(_) -> b"()",
  }

fn result_text(
  input: PrintInput,
  ret: TypeExpression,
  effects: Option<EffectsExpression>,
) -> Bytes / {abort.raise} =
  match ((ret, effects)) {
    (FunctionTypeExpression(_), Some(_)) ->
      Bytes::concat_all([b"(", type_text(input, ret), b")", effects_suffix(input, effects)]),
    _ -> type_text(input, ret).concat(effects_suffix(input, effects)),
  }

fn type_field_text(
  input: PrintInput,
  f: { name: Identifier, ty: TypeExpression },
) -> Bytes / {abort.raise} = Bytes::concat_all([f.name.name, b": ", type_text(input, f.ty)])

fn unparen(input: PrintInput, span: Span) -> Bytes / {abort.raise} =
  unparen_text(trim(input.source.slice(span.start, span.end)))

fn unparen_text(t: Bytes) -> Bytes / {abort.raise} =
  iterate(t, t.len() / 2 + 1, |current_text: Bytes| {
    let n = current_text.len();
    if n >= 2 && current_text.at(0) == 40 && current_text.at(n - 1) == 41 {
      let inner = trim(current_text.slice(1, n - 1));
      if inner.len() == 0 { Stop(current_text) } else { Continue(inner) }
    } else { Stop(current_text) }
  })

fn strip_blanks(t: Bytes) -> Bytes =
  range(0, t.len()).fold(
    { out: b"", quoted: false, escaped: false },
    |s: { out: Bytes, quoted: Bool, escaped: Bool }, i: Int| {
      let c = t.at(i);
      {
        out: if s.quoted || (c != 32 && c != 9) { s.out.concat(t.slice(i, i + 1)) } else { s.out },
        quoted: if c == 39 && !s.escaped { !s.quoted } else { s.quoted },
        escaped: s.quoted && c == 92 && !s.escaped,
      }
    },
  ).out

fn is_line_string(input: PrintInput, expression: Expression) -> Bool / {abort.raise} =
  match expression {
    LiteralExpression(v) -> if !in_source(input, v.span) { false } else {
      let t = unparen(input, v.span);
      t.len() >= 2 && t.at(0) == 92 && t.at(1) == 92
    },
    _ -> false,
  }

fn line_string(
  printer: Printer,
  value: Bytes,
  indent: Int,
  continuation_indent: Int,
) -> Printer / {abort.raise} = {
  let empty = line_empty(printer);
  let col = if empty { printer.column } else { continuation_indent };
  let lines = value.split(b"\n");
  let printed = range(0, lines.len()).fold(
    if empty { printer } else { newline(printer, continuation_indent, false) },
    |s: Printer, i: Int|
      emit(if i == 0 { s } else { newline(s, col, false) }, b"\\\\".concat(lines.get(i))),
  );
  { ..printed, closed: indent }
}

fn hole_text(flat: Bytes) -> Bytes =
  if flat.starts_with(b"{") { Bytes::concat_all([b"{ ", flat, b" }"]) }
  else { Bytes::concat_all([b"{", flat, b"}"]) }

fn tag_text(input: PrintInput, quoted: Span, value: Bytes) -> Bytes / {abort.raise} =
  if in_source(input, quoted) { input.source.slice(quoted.start + 1, quoted.end - 1) }
  else { template_text(value) }

fn hole_written(input: PrintInput, h: Hole, from: Int) -> Option<Bytes> / {abort.raise} =
  if in_source(input, h.quoted) { Some(input.source.slice(from - 1, h.quoted.start + 1)) }
  else { None }

fn tagged_flat(input: PrintInput, t: TaggedLiteral) -> Option<Bytes> / {abort.raise} = {
  let filled = t.holes.fold(
    { out: Some(tag_text(input, t.quoted, t.text)), from: t.quoted.end },
    |accumulator: { out: Option<Bytes>, from: Int }, h: Hole|
      {
        out: concat_options([
          accumulator.out,
          match flat_expression(input, h.value) {
            Some(flat) -> Some(hole_text(flat)),
            None -> hole_written(input, h, accumulator.from),
          },
          Some(tag_text(input, h.quoted, h.text)),
        ]),
        from: h.quoted.end,
      },
  );
  concat_options([Some(t.tag.name.concat(b"\"")), filled.out, Some(b"\"")])
}

fn tagged_layout(
  input: PrintInput,
  printer: Printer,
  t: TaggedLiteral,
  indent: Int,
) -> Printer / {abort.raise} = {
  let opened = emit(
    printer,
    Bytes::concat_all([t.tag.name, b"\"", tag_text(input, t.quoted, t.text)]),
  );
  let filled = t.holes.fold(
    { printer: opened, from: t.quoted.end },
    |accumulator: { printer: Printer, from: Int }, h: Hole|
      {
        printer: emit(
          match flat_expression(input, h.value) {
            Some(flat) -> emit(accumulator.printer, hole_text(flat)),
            None -> match hole_written(input, h, accumulator.from) {
              Some(written) -> emit(accumulator.printer, written),
              None -> hole_layout(input, accumulator.printer, h.value, indent),
            },
          },
          tag_text(input, h.quoted, h.text),
        ),
        from: h.quoted.end,
      },
  );
  emit(filled.printer, b"\"")
}

fn hole_layout(
  input: PrintInput,
  printer: Printer,
  value: Expression,
  indent: Int,
) -> Printer / {abort.raise} =
  emit(expression(input, emit(printer, b"{ "), value, indent, 2), b" }")

fn source_literal_text(
  input: PrintInput,
  span: Span,
  collection_literal: SourceLiteral,
) -> Bytes / {abort.raise} =
  if !in_source(input, span) { literal_text(collection_literal) } else {
    match collection_literal {
      LiteralInt(_) -> strip_blanks(unparen(input, span)),
      LiteralFixed(_, _) -> strip_blanks(unparen(input, span)),
      LiteralWide(_, _, _) -> strip_blanks(unparen(input, span)),
      LiteralString(_) -> unparen(input, span),
      LiteralBytes(_) -> unparen(input, span),
      LiteralEmbedded(_, _) -> unparen(input, span),
      LiteralChar(_) -> unparen(input, span),
      _ -> literal_text(collection_literal),
    }
  }

fn pattern_punned(f: { name: Identifier, pattern: Pattern }) -> Bool =
  match f.pattern {
    PatternVariable(v) -> v.name.name == f.name.name && v.span == f.name.span,
    _ -> false,
  }

pub fn is_pattern_tuple(
  fields: List<{ name: Identifier, pattern: Pattern }>,
) -> Bool / {abort.raise} =
  fields.len() >= 2
    && range(0, fields.len()).fold(true, |ok: Bool, i: Int| {
      let f = fields.get(i);
      ok && f.name.name == positional_name(i) && f.name.span == pattern_span(f.pattern)
    })

fn pattern_text(input: PrintInput, x: Pattern) -> Bytes / {abort.raise} =
  match x {
    PatternWildcard(_) -> b"_",
    PatternVariable(v) -> v.name.name,
    PatternLiteral(v) -> if in_source(input, v.span) {
      source_literal_text(input, v.span, v.literal)
    } else { pattern_literal_text(v.literal) },
    PatternRange(v) -> if in_source(input, v.span) { strip_blanks(unparen(input, v.span)) }
    else { Bytes::concat_all([pattern_literal_text(v.lo), b"..=", pattern_literal_text(v.hi)]) },
    PatternConstructor(v) -> if v.args.len() == 0 { qualified_name_text(v.name) } else {
      Bytes::concat_all([
        qualified_name_text(v.name),
        b"(",
        Bytes::join(v.args.map(|a: Pattern| pattern_text(input, a)), b", "),
        b")",
      ])
    },
    PatternRecord(v) -> if is_pattern_tuple(v.fields) && !v.rest {
      Bytes::concat_all([
        b"(",
        Bytes::join(
          v.fields.map(|f: { name: Identifier, pattern: Pattern }| pattern_text(input, f.pattern)),
          b", ",
        ),
        b")",
      ])
    } else {
      let fs = v.fields.map(|f: { name: Identifier, pattern: Pattern }|
        if pattern_punned(f) { f.name.name }
        else { Bytes::concat_all([f.name.name, b": ", pattern_text(input, f.pattern)]) });
      let all = if v.rest { fs.push(b"..") } else { fs };
      Bytes::concat_all([b"{ ", Bytes::join(all, b", "), b" }"])
    },
    PatternList(v) -> {
      let items = v.items.map(|a: Pattern| pattern_text(input, a));
      let all = match v.rest {
        Some(PatternVariable(r)) -> items.push(b"..".concat(r.name.name)),
        Some(_) -> items.push(b".."),
        None -> items,
      };
      Bytes::concat_all([b"[", Bytes::join(all, b", "), b"]"])
    },
    PatternOr(v) ->
      Bytes::join(
        v.alternatives.map(|a: Pattern|
          match a {
            PatternOr(_) -> Bytes::concat_all([b"(", pattern_text(input, a), b")"]),
            _ -> pattern_text(input, a),
          }),
        b" | ",
      ),
    PatternInvalid(_) -> b"_",
  }

fn binding_power(operation: Bytes) -> Int =
  if operation == b"or" { 1 }
  else if operation == b"and" { 2 }
  else if operation == b"eq" || operation == b"ne" || operation == b"lt" || operation == b"le"
      || operation == b"gt"
      || operation == b"ge" { 3 }
  else if operation == b"bitor" { 4 }
  else if operation == b"bitxor" { 5 }
  else if operation == b"bitand" { 6 }
  else if operation == b"shl" || operation == b"shr" || operation == b"ushr" { 7 }
  else if operation == b"concat" { 8 }
  else if operation == b"add" || operation == b"sub" { 9 }
  else { match call_operator(operation) { Some(o) -> o.binding_power, None -> 10 } }

pub fn operation_text(operation: Bytes) -> Bytes = {
  let table = [
    { n: b"or", t: b"||" },
    { n: b"and", t: b"&&" },
    { n: b"eq", t: b"==" },
    { n: b"ne", t: b"!=" },
    { n: b"lt", t: b"<" },
    { n: b"le", t: b"<=" },
    { n: b"gt", t: b">" },
    { n: b"ge", t: b">=" },
    { n: b"bitor", t: b"|" },
    { n: b"bitxor", t: b"^" },
    { n: b"bitand", t: b"&" },
    { n: b"shl", t: b"<<" },
    { n: b"shr", t: b">>" },
    { n: b"ushr", t: b">>>" },
    { n: b"concat", t: b"++" },
    { n: b"add", t: b"+" },
    { n: b"sub", t: b"-" },
    { n: b"mul", t: b"*" },
    { n: b"div", t: b"/" },
    { n: b"rem", t: b"%" },
  ];
  match call_operator(operation) {
    Some(o) -> o.text,
    None ->
      table.fold(b"", |accumulator: Bytes, e: { n: Bytes, t: Bytes }|
        if e.n == operation { e.t } else { accumulator }),
  }
}

pub fn unary_text(operation: Bytes) -> Bytes =
  if operation == b"neg" { b"-" } else if operation == b"not" { b"!" } else { b"~" }

fn is_open_ended(expression: Expression) -> Bool =
  match expression {
    LambdaExpression(_) -> true,
    IfExpression(_) -> true,
    MatchExpression(_) -> true,
    HandleExpression(_) -> true,
    WithScopeExpression(_) -> true,
    SimulateExpression(_) -> true,
    TryBlockExpression(_) -> true,
    _ -> false,
  }

fn parens_operand(expression: Expression, parent: Bytes, is_right_operand: Bool) -> Bool =
  match expression {
    BinaryExpression(v) ->
      binding_power(v.operation) < binding_power(parent)
        || (binding_power(v.operation) == binding_power(parent) && is_right_operand)
        || (v.operation == b"and" && parent == b"or"),
    _ -> is_open_ended(expression),
  }

fn parens_unary(expression: Expression) -> Bool =
  match expression {
    BinaryExpression(_) -> true,
    UnaryExpression(_) -> true,
    _ -> is_open_ended(expression),
  }

fn parens_postfix(expression: Expression) -> Bool =
  match expression {
    LiteralExpression(_) -> false,
    TaggedLiteralExpression(_) -> false,
    NameExpression(_) -> false,
    CallExpression(_) -> false,
    FieldExpression(_) -> false,
    PropagateExpression(_) -> false,
    PerformExpression(_) -> false,
    ListExpression(_) -> false,
    RecordExpression(_) -> false,
    RecordUpdateExpression(_) -> false,
    BlockExpression(_) -> false,
    _ -> true,
  }

fn parens_callee(expression: Expression, named: Bool) -> Bool =
  match expression {
    FieldExpression(v) -> match v.base {
      NameExpression(_) -> !named && v.field.name.index_of(b"::") == None,
      _ -> parens_postfix(expression),
    },
    _ -> parens_postfix(expression),
  }

fn starts_with_brace(expression: Expression) -> Bool =
  match expression {
    RecordExpression(_) -> true,
    RecordUpdateExpression(_) -> true,
    BlockExpression(_) -> true,
    SimulateExpression(_) -> true,
    ParallelExpression(_) -> true,
    BinaryExpression(v) -> starts_with_brace(v.left_operand),
    CallExpression(v) -> starts_with_brace(v.function),
    FieldExpression(v) -> starts_with_brace(v.base),
    PropagateExpression(v) -> starts_with_brace(v.operand),
    _ -> false,
  }

fn contains_brace(expression: Expression) -> Bool / {abort.raise} =
  match expression {
    BinaryExpression(v) ->
      contains_brace(v.left_operand) || opens_brace(v.right_operand)
        || contains_brace(v.right_operand),
    UnaryExpression(v) -> opens_brace(v.operand) || contains_brace(v.operand),
    CallExpression(v) -> contains_brace(v.function),
    FieldExpression(v) -> contains_brace(v.base),
    PropagateExpression(v) -> contains_brace(v.operand),
    _ -> false,
  }

fn opens_brace(expression: Expression) -> Bool / {abort.raise} =
  match expression {
    RecordExpression(v) -> !is_tuple(v.fields),
    RecordUpdateExpression(_) -> true,
    BlockExpression(_) -> true,
    SimulateExpression(_) -> true,
    ParallelExpression(_) -> true,
    BinaryExpression(v) -> opens_brace(v.left_operand),
    CallExpression(v) -> opens_brace(v.function),
    FieldExpression(v) -> opens_brace(v.base),
    PropagateExpression(v) -> opens_brace(v.operand),
    _ -> false,
  }

fn parens_scrutinee(expression: Expression) -> Bool / {abort.raise} =
  starts_with_brace(expression) || contains_brace(expression)

fn wrap(o: Option<Bytes>, parens: Bool) -> Option<Bytes> =
  if parens { concat_options([Some(b"("), o, Some(b")")]) } else { o }

fn punned(field: RecordLiteralField) -> Bool =
  match field.value {
    NameExpression(v) -> match v.name.module {
      None -> v.name.name.name == field.name.name && v.span == field.name.span,
      Some(_) -> false,
    },
    _ -> false,
  }

pub fn is_tuple(fields: List<RecordLiteralField>) -> Bool / {abort.raise} =
  fields.len() >= 2
    && range(0, fields.len()).fold(true, |ok: Bool, i: Int| {
      let f = fields.get(i);
      ok && f.name.name == positional_name(i) && f.name.span == expression_span(f.value)
    })

fn lambda_head(
  input: PrintInput,
  params: List<Param>,
  return_type: Option<TypeExpression>,
) -> Bytes / {abort.raise} = {
  let ps = if params.len() == 0 { b"||" } else {
    Bytes::concat_all([
      b"|",
      Bytes::join(params.map(|param: Param| param_head(input, param)), b", "),
      b"|",
    ])
  };
  match return_type { Some(t) -> Bytes::concat_all([ps, b" -> ", type_text(input, t)]), None -> ps }
}

fn param_head(input: PrintInput, param: Param) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    match param.ty {
      Some(t) ->
        Bytes::concat_all([
          param.name.name,
          b": ",
          if param.keep { b"keep " } else { b"" },
          type_text(input, t),
        ]),
      None -> param.name.name,
    },
    match param.cost { Some(k) -> b" cost ".concat(k.name), None -> b"" },
    match param.space { Some(s) -> b" space ".concat(s.name), None -> b"" },
  ])

fn perform_head(eff: QName, operation: Identifier, r: Option<Identifier>) -> Bytes =
  Bytes::concat_all([qualified_name_text(eff), b".", operation.name, resource_text(r)])

fn try_head(raise: Option<RaiseName>) -> Bytes =
  match raise {
    None -> b"try ",
    Some(r) ->
      Bytes::concat_all([
        b"try[",
        qualified_name_text(r.effect_name),
        b".",
        r.operation.name,
        b"] ",
      ]),
  }

fn clause_head(clause: HandleClause) -> Bytes =
  Bytes::concat_all([
    match clause.wildcard_label {
      true ->
        Bytes::concat_all([
          qualified_name_text(clause.effect_name),
          b".",
          clause.operation.name,
          b"[*",
          match clause.label_binder { Some(t) -> t.name, None -> b"" },
          b"]",
        ]),
      false -> perform_head(clause.effect_name, clause.operation, clause.resource),
    },
    b"(",
    Bytes::join(clause.params.map(|parameter: Identifier| parameter.name), b", "),
    b")",
    match clause.resume { Some(k) -> b" resume ".concat(k.name), None -> b"" },
  ])

fn flat_field(
  input: PrintInput,
  field: RecordLiteralField,
  pun_ok: Bool,
) -> Option<Bytes> / {abort.raise} =
  if punned(field) && pun_ok { Some(field.name.name) } else {
    concat_options([Some(field.name.name.concat(b": ")), flat_expression(input, field.value)])
  }

fn flat_scrutinee(input: PrintInput, expression: Expression) -> Option<Bytes> / {abort.raise} =
  wrap(flat_expression(input, expression), parens_scrutinee(expression))

fn flat_args(
  input: PrintInput,
  args: List<Expression>,
  named: List<NamedArg>,
) -> Option<Bytes> / {abort.raise} =
  join_options(
    named.fold(
      args.map(|expression: Expression| flat_expression(input, expression)),
      |accumulator: List<Option<Bytes>>, arg: NamedArg|
        accumulator.push(
          concat_options([Some(arg.name.name.concat(b": ")), flat_expression(input, arg.value)]),
        ),
    ),
    b", ",
  )

fn flat_else(input: PrintInput, expression: Expression) -> Option<Bytes> / {abort.raise} =
  match expression {
    LiteralExpression(_) -> Some(b""),
    _ -> concat_options([Some(b" else "), flat_expression(input, expression)]),
  }

fn flat_arm(input: PrintInput, arm: MatchArm) -> Option<Bytes> / {abort.raise} =
  concat_options([
    Some(pattern_text(input, arm.pattern)),
    match arm.guard {
      Some(g) -> concat_options([Some(b" if "), flat_expression(input, g)]),
      None -> Some(b""),
    },
    Some(b" -> "),
    flat_expression(input, arm.body),
  ])

fn flat_clauses(
  input: PrintInput,
  clauses: List<HandleClause>,
  return_clause: Option<ReturnClause>,
) -> Option<Bytes> / {abort.raise} = {
  let cs = clauses.map(|c: HandleClause|
    concat_options([Some(clause_head(c)), Some(b" -> "), flat_expression(input, c.body)]));
  let all = match return_clause {
    Some(r) ->
      cs.push(
        concat_options([
          Some(Bytes::concat_all([b"return ", r.binder.name, b" -> "])),
          flat_expression(input, r.body),
        ]),
      ),
    None -> cs,
  };
  if all.len() == 0 { Some(b"{}") }
  else { concat_options([Some(b"{ "), join_options(all, b", "), Some(b" }")]) }
}

fn interpolated(input: PrintInput, e: Expression) -> Option<Bytes> / {abort.raise} =
  if !one_string(input, e) { None }
  else { concat_options([Some(b"f\""), pieces(input, e), Some(b"\"")]) }

fn one_string(input: PrintInput, e: Expression) -> Bool / {abort.raise} =
  match e {
    LiteralExpression(_) -> false,
    _ -> in_source(input, expression_span(e)) && one_interpolation(input, expression_span(e)),
  }

fn ungrouped(input: PrintInput, span: Span) -> Span / {abort.raise} =
  iterate(span, (span.end - span.start) / 2 + 1, |current_span: Span|
    if current_span.end - current_span.start >= 2 && input.source.at(current_span.start) == 40
        && input.source.at(current_span.end - 1) == 41 {
      let inner = span_between(
        skip_whitespace(input, current_span.start + 1),
        skip_whitespace_back(input, current_span.end - 1),
      );
      if inner.start >= inner.end { Stop(current_span) } else { Continue(inner) }
    } else { Stop(current_span) })

fn one_interpolation(input: PrintInput, grouped: Span) -> Bool / {abort.raise} = {
  let span = ungrouped(input, grouped);
  if span.end - span.start < 2 || input.source.slice(span.start, span.start + 2) != b"f\"" { false }
  else {
    let tokens = lex(input.source.slice(span.start, span.end)).tokens;
    let walked = tokens.fold(
      { open: 0, closed: -1, i: 0 },
      |accumulator: { open: Int, closed: Int, i: Int }, token: Token| {
        let open = match token.kind {
          InterpolatedHead(_) -> accumulator.open + 1,
          InterpolatedTail(_) -> accumulator.open - 1,
          _ -> accumulator.open,
        };
        {
          open: open,
          closed: if accumulator.closed < 0 && accumulator.open > 0 && open == 0 { accumulator.i }
          else { accumulator.closed },
          i: accumulator.i + 1,
        }
      },
    );
    walked.closed == tokens.len() - 2
  }
}

fn pieces(input: PrintInput, expression: Expression) -> Option<Bytes> / {abort.raise} =
  match expression {
    BinaryExpression(v) -> if v.operation == b"concat" {
      concat_options([pieces(input, v.left_operand), pieces(input, v.right_operand)])
    } else { piece(input, expression) },
    _ -> piece(input, expression),
  }

fn piece(input: PrintInput, expression: Expression) -> Option<Bytes> / {abort.raise} =
  match expression {
    LiteralExpression(v) -> {
      let leading_comments = if input.source.slice(v.span.start, v.span.start + 2) == b"f\"" { 2 }
      else { 1 };
      Some(input.source.slice(v.span.start + leading_comments, v.span.end - 1))
    },
    CallExpression(v) -> match v.args {
      [x] -> match flat_expression(input, x) { Some(flat) -> Some(hole_text(flat)), None -> None },
      _ -> None,
    },
    _ -> None,
  }

fn pieces_layout(
  input: PrintInput,
  printer: Printer,
  expression: Expression,
  indent: Int,
) -> Printer / {abort.raise} =
  match expression {
    BinaryExpression(v) -> if v.operation == b"concat" {
      pieces_layout(
        input,
        pieces_layout(input, printer, v.left_operand, indent),
        v.right_operand,
        indent,
      )
    } else { piece_layout(input, printer, expression, indent) },
    _ -> piece_layout(input, printer, expression, indent),
  }

fn piece_layout(
  input: PrintInput,
  printer: Printer,
  expression: Expression,
  indent: Int,
) -> Printer / {abort.raise} =
  match expression {
    CallExpression(v) -> match v.args {
      [x] -> match flat_expression(input, x) {
        Some(flat) -> emit(printer, hole_text(flat)),
        None -> hole_layout(input, printer, x, indent),
      },
      _ -> printer,
    },
    _ -> match piece(input, expression) { Some(text) -> emit(printer, text), None -> printer },
  }

fn flat_expression(p: PrintInput, expression: Expression) -> Option<Bytes> / {abort.raise} =
  match interpolated(p, expression) { Some(text) -> Some(text), None -> flat_node(p, expression) }

fn flat_base(input: PrintInput, base: Expression) -> Option<Bytes> / {abort.raise} =
  match base {
    CallExpression(v) ->
      concat_options([
        flat_expression(input, v.function),
        Some(b"("),
        flat_args(input, v.args, v.named),
        Some(b")"),
      ]),
    _ -> flat_expression(input, base),
  }

fn flat_node(input: PrintInput, e: Expression) -> Option<Bytes> / {abort.raise} =
  match e {
    LiteralExpression(v) -> if is_line_string(input, e) { None }
    else { Some(source_literal_text(input, v.span, v.literal)) },
    HoleExpression(v) -> Some(v.text),
    TaggedLiteralExpression(v) -> tagged_flat(input, v),
    NameExpression(v) -> Some(qualified_name_text(v.name)),
    BinaryExpression(v) ->
      concat_options([
        wrap(
          flat_expression(input, v.left_operand),
          parens_operand(v.left_operand, v.operation, false),
        ),
        Some(Bytes::concat_all([b" ", operation_text(v.operation), b" "])),
        wrap(
          flat_expression(input, v.right_operand),
          parens_operand(v.right_operand, v.operation, true),
        ),
      ]),
    UnaryExpression(v) ->
      concat_options([
        Some(unary_text(v.operation)),
        wrap(flat_expression(input, v.operand), parens_unary(v.operand)),
      ]),
    LambdaExpression(v) ->
      concat_options([
        Some(lambda_head(input, v.params, v.return_clause)),
        Some(b" "),
        flat_expression(input, v.body),
      ]),
    CallExpression(v) -> match collection_literal_of(input, e) {
      Some(m) -> flat_collection_literal(input, m),
      None ->
        concat_options([
          wrap(flat_expression(input, v.function), parens_callee(v.function, v.named.len() > 0)),
          Some(call_labels(v.labels)),
          Some(b"("),
          flat_args(input, v.args, v.named),
          Some(b")"),
        ]),
    },
    IfExpression(v) ->
      concat_options([
        Some(b"if "),
        flat_scrutinee(input, v.cond),
        Some(b" "),
        flat_expression(input, v.then_branch),
        flat_else(input, v.else_branch),
      ]),
    MatchExpression(v) ->
      concat_options([
        Some(b"match "),
        flat_scrutinee(input, v.scrutinee),
        if v.arms.len() == 0 { Some(b" {}") } else {
          concat_options([
            Some(b" { "),
            join_options(v.arms.map(|arm: MatchArm| flat_arm(input, arm)), b", "),
            Some(b" }"),
          ])
        },
      ]),
    BlockExpression(v) -> if v.statements.len() > 0 { None } else {
      match v.tail {
        None -> Some(b"{}"),
        Some(t) -> concat_options([Some(b"{ "), flat_expression(input, t), Some(b" }")]),
      }
    },
    RecordExpression(v) -> if is_tuple(v.fields) {
      concat_options([
        Some(b"("),
        join_options(
          v.fields.map(|field: RecordLiteralField| flat_expression(input, field.value)),
          b", ",
        ),
        Some(b")"),
      ])
    } else {
      concat_options([
        Some(b"{ "),
        join_options(
          v.fields.map(|field: RecordLiteralField| flat_field(input, field, v.fields.len() > 1)),
          b", ",
        ),
        Some(b" }"),
      ])
    },
    RecordUpdateExpression(v) ->
      concat_options([
        Some(b"{ .."),
        flat_base(input, v.base),
        Some(if v.fields.len() == 0 { b"" } else { b", " }),
        join_options(
          v.fields.map(|field: RecordLiteralField| flat_field(input, field, true)),
          b", ",
        ),
        Some(b" }"),
      ]),
    PropagateExpression(v) ->
      concat_options([
        wrap(flat_expression(input, v.operand), parens_postfix(v.operand)),
        Some(b"?"),
      ]),
    FieldExpression(v) ->
      concat_options([
        wrap(flat_expression(input, v.base), parens_postfix(v.base)),
        Some(b".".concat(v.field.name)),
      ]),
    ListExpression(v) -> if v.items.len() == 0 { Some(b"[]") } else {
      concat_options([
        Some(b"["),
        join_options(v.items.map(|x: Expression| flat_expression(input, x)), b", "),
        Some(b"]"),
      ])
    },
    PerformExpression(v) ->
      concat_options([
        Some(perform_head(v.effect_name, v.operation, v.resource)),
        Some(b"("),
        join_options(v.args.map(|x: Expression| flat_expression(input, x)), b", "),
        Some(b")"),
      ]),
    HandleExpression(v) -> if v.handler_variables.len() > 0 { None } else {
      concat_options([
        Some(b"handle "),
        flat_expression(input, v.body),
        Some(b" with "),
        flat_clauses(input, v.clauses, v.return_clause),
      ])
    },
    WithScopeExpression(v) ->
      concat_options([
        Some(Bytes::concat_all([b"with_scope[", v.resource.name, b"]("])),
        flat_expression(input, v.acquire),
        Some(b", "),
        flat_expression(input, v.release),
        Some(Bytes::concat_all([b") { ", v.binder.name, b" -> "])),
        flat_expression(input, v.body),
        Some(b" }"),
      ]),
    SimulateExpression(v) -> concat_options([Some(b"simulate "), flat_expression(input, v.body)]),
    TryBlockExpression(v) ->
      concat_options([Some(try_head(v.raise)), flat_expression(input, v.body)]),
    ParallelExpression(v) ->
      concat_options([
        Some(b"parallel { "),
        join_options(v.branches.map(|x: Expression| flat_expression(input, x)), b", "),
        Some(b" }"),
      ]),
    InvalidExpression(_) -> Some(b"()"),
  }

fn flat_len(p: PrintInput, expression: Expression) -> Int / {abort.raise} =
  match flat_expression(p, expression) { Some(f) -> f.len(), None -> 0 }

fn expression(
  input: PrintInput,
  printer: Printer,
  e: Expression,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = layout(input, printer, e, indent, indent + 2, after)

fn layout(
  input: PrintInput,
  printer: Printer,
  e: Expression,
  indent: Int,
  continuation_indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let span = expression_span(e);
  if printer.column > indent && comment_before(input, printer, span.start) {
    layout_here(input, newline(printer, indent + 2, false), e, indent + 2, indent + 4, after)
  } else { layout_here(input, printer, e, indent, continuation_indent, after) }
}

fn layout_here(
  input: PrintInput,
  printer: Printer,
  e: Expression,
  indent: Int,
  continuation_indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let span = expression_span(e);
  let s0 = leading_comments(input, printer, span.start, indent);
  let s1 = match try_flat(input, s0, flat_expression(input, e), span.end, after) {
    Some(f) -> emit(s0, f),
    None -> broken(input, s0, e, indent, continuation_indent, after),
  };
  absorb(input, s1, span.end)
}

fn operand(
  input: PrintInput,
  printer: Printer,
  e: Expression,
  parens: Bool,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} =
  if parens { emit(expression(input, emit(printer, b"("), e, indent, after + 1), b")") }
  else { expression(input, printer, e, indent, after) }

fn scrutinee(
  input: PrintInput,
  printer: Printer,
  expression: Expression,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} =
  operand(input, printer, expression, parens_scrutinee(expression), indent, after)

fn chain(
  input: PrintInput,
  printer: Printer,
  left: Expression,
  operation: Bytes,
  right: Expression,
  continuation_indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let s1 = chain_operand(
    input,
    printer,
    left,
    parens_operand(left, operation, false),
    continuation_indent,
    0,
  );
  let s2 = emit(newline(s1, continuation_indent, false), operation_text(operation).concat(b" "));
  chain_operand(
    input,
    s2,
    right,
    parens_operand(right, operation, true),
    continuation_indent,
    after,
  )
}

fn chain_operand(
  input: PrintInput,
  printer: Printer,
  expression: Expression,
  parens: Bool,
  continuation_indent: Int,
  after: Int,
) -> Printer / {abort.raise} =
  if parens {
    emit(
      layout(
        input,
        emit(printer, b"("),
        expression,
        continuation_indent,
        continuation_indent,
        after + 1,
      ),
      b")",
    )
  } else { layout(input, printer, expression, continuation_indent, continuation_indent, after) }

fn broken(
  input: PrintInput,
  printer: Printer,
  expression: Expression,
  indent: Int,
  continuation_indent: Int,
  after: Int,
) -> Printer / {abort.raise} =
  match interpolated(input, expression) {
    Some(text) -> emit(printer, text),
    None -> if one_string(input, expression) {
      emit(pieces_layout(input, emit(printer, b"f\""), expression, indent), b"\"")
    } else { broken_node(input, printer, expression, indent, continuation_indent, after) },
  }

fn broken_node(
  input: PrintInput,
  printer: Printer,
  expression: Expression,
  indent: Int,
  continuation_indent: Int,
  after: Int,
) -> Printer / {abort.raise} =
  match expression {
    LiteralExpression(v) -> match v.literal {
      LiteralString(value) -> if is_line_string(input, expression) {
        line_string(printer, value, indent, continuation_indent)
      } else { emit(printer, source_literal_text(input, v.span, v.literal)) },
      _ -> emit(printer, source_literal_text(input, v.span, v.literal)),
    },
    TaggedLiteralExpression(v) -> match tagged_flat(input, v) {
      Some(text) -> emit(printer, text),
      None -> tagged_layout(input, printer, v, indent),
    },
    HoleExpression(v) -> emit(printer, v.text),
    NameExpression(v) -> emit(printer, qualified_name_text(v.name)),
    BinaryExpression(v) ->
      chain(
        input,
        printer,
        v.left_operand,
        v.operation,
        v.right_operand,
        continuation_indent,
        after,
      ),
    UnaryExpression(v) ->
      operand(
        input,
        emit(printer, unary_text(v.operation)),
        v.operand,
        parens_unary(v.operand),
        indent,
        after,
      ),
    LambdaExpression(v) -> lambda(input, printer, v.params, v.return_clause, v.body, indent, after),
    CallExpression(v) -> match collection_literal_of(input, expression) {
      Some(m) -> collection_literal(input, printer, m, indent),
      None -> {
        let ls = call_labels(v.labels);
        let s1 = operand(
          input,
          printer,
          v.function,
          parens_callee(v.function, v.named.len() > 0),
          indent,
          1 + ls.len(),
        );
        call(input, emit(s1, ls), v.args, v.named, v.span, indent, after)
      },
    },
    IfExpression(v) -> if_chain(input, printer, v, indent, after),
    MatchExpression(v) -> match_expression(input, printer, v.scrutinee, v.arms, v.span, indent),
    BlockExpression(v) -> block_of(input, printer, v, indent),
    RecordExpression(v) -> if is_tuple(v.fields) {
      elements(
        input,
        printer,
        b"(",
        v.fields.map(|field: RecordLiteralField| field.value),
        b")",
        v.span,
        indent,
      )
    } else { record(input, printer, None, v.fields, v.span, indent) },
    RecordUpdateExpression(v) -> record(input, printer, Some(v.base), v.fields, v.span, indent),
    PropagateExpression(v) ->
      emit(operand(input, printer, v.operand, parens_postfix(v.operand), indent, after + 1), b"?"),
    FieldExpression(v) ->
      emit(
        operand(
          input,
          printer,
          v.base,
          parens_postfix(v.base),
          indent,
          after + 1 + v.field.name.len(),
        ),
        b".".concat(v.field.name),
      ),
    ListExpression(v) -> elements(input, printer, b"[", v.items, b"]", v.span, indent),
    PerformExpression(v) ->
      call(
        input,
        emit(printer, perform_head(v.effect_name, v.operation, v.resource)),
        v.args,
        [],
        v.span,
        indent,
        after,
      ),
    HandleExpression(v) -> handle_expression(input, printer, v, indent),
    WithScopeExpression(v) -> {
      let head = emit(printer, Bytes::concat_all([b"with_scope[", v.resource.name, b"]"]));
      let opened = emit(
        call(
          input,
          head,
          [v.acquire, v.release],
          [],
          { ..v.span, end: expression_span(v.release).end },
          indent,
          v.binder.name.len() + 7,
        ),
        Bytes::concat_all([b" { ", v.binder.name, b" ->"]),
      );
      scope_body(input, opened, v.body, v.span, indent)
    },
    SimulateExpression(v) -> block(input, emit(printer, b"simulate "), v.body, indent),
    TryBlockExpression(v) -> block(input, emit(printer, try_head(v.raise)), v.body, indent),
    ParallelExpression(v) ->
      elements(
        input,
        emit(printer, b"parallel "),
        b"{",
        v.branches,
        b"}",
        { ..v.span, start: v.span.start + 7 },
        indent,
      ),
    InvalidExpression(_) -> emit(printer, b"()"),
  }

fn block(
  input: PrintInput,
  printer: Printer,
  e: Expression,
  indent: Int,
) -> Printer / {abort.raise} =
  match e {
    BlockExpression(v) -> block_of(input, printer, v, indent),
    _ -> expression(input, printer, e, indent, 0),
  }

fn block_of(
  input: PrintInput,
  printer: Printer,
  v: { span: Span, tail: Option<Expression>, statements: List<Statement> },
  indent: Int,
) -> Printer / {abort.raise} = {
  let has_tail = match v.tail { Some(_) -> true, None -> false };
  if v.statements.len() == 0 && !has_tail && !comment_before(input, printer, v.span.end) {
    emit(printer, b"{}")
  } else {
    let s1 = set_previous(
      trailing_comment(input, emit(printer, b"{"), v.span.start + 1),
      v.span.start + 1,
    );
    let s2 = v.statements.fold(s1, |s: Printer, x: Statement| statement(input, s, x, indent + 2));
    let s3 = match v.tail {
      Some(t) -> {
        let tsp = expression_span(t);
        let s = expression(
          input,
          newline_after_comments(input, s2, tsp.start, indent + 2, true),
          t,
          indent + 2,
          0,
        );
        trailing_comment(input, set_previous(s, tsp.end), tsp.end)
      },
      None -> s2,
    };
    close(input, s3, v.span.end, indent, b"}")
  }
}

fn statement(
  input: PrintInput,
  printer: Printer,
  x: Statement,
  indent: Int,
) -> Printer / {abort.raise} =
  match x {
    LetStatement(v) -> {
      let s1 = newline_after_comments(input, printer, v.span.start, indent, true);
      let ty = match v.ty { Some(t) -> b": ".concat(type_text(input, t)), None -> b"" };
      let s2 = emit(s1, Bytes::concat_all([b"let ", pattern_text(input, v.pattern), ty, b" = "]));
      let s4 = emit(expression(input, s2, v.value, indent, 1), b";");
      trailing_comment(input, set_previous(s4, v.span.end), v.span.end)
    },
    LetElseStatement(v) -> {
      let s1 = newline_after_comments(input, printer, v.span.start, indent, true);
      let ty = match v.ty { Some(t) -> b": ".concat(type_text(input, t)), None -> b"" };
      let s2 = emit(s1, Bytes::concat_all([b"let ", pattern_text(input, v.pattern), ty, b" = "]));
      let s3 = emit(expression(input, s2, v.value, indent, 7), b" else ");
      let s4 = emit(branch(input, s3, v.fallback, indent, 1).printer, b";");
      trailing_comment(input, set_previous(s4, v.span.end), v.span.end)
    },
    ExpressionStatement(e) -> {
      let span = expression_span(e);
      let s1 = newline_after_comments(input, printer, span.start, indent, true);
      let s2 = emit(expression(input, s1, e, indent, 1), b";");
      trailing_comment(input, set_previous(s2, span.end), span.end)
    },
    AssignmentStatement(v) -> {
      let s1 = newline_after_comments(input, printer, v.span.start, indent, true);
      let s2 = emit(s1, v.name.name.concat(b" = "));
      let s3 = emit(expression(input, s2, v.value, indent, 1), b";");
      trailing_comment(input, set_previous(s3, v.span.end), v.span.end)
    },
  }

fn lambda(
  input: PrintInput,
  printer: Printer,
  params: List<Param>,
  return_type: Option<TypeExpression>,
  body: Expression,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let s1 = emit(printer, lambda_head(input, params, return_type));
  let body_span = expression_span(body);
  match body {
    BlockExpression(v) -> block_of(input, emit(s1, b" "), v, indent),
    _ -> match try_flat(input, s1, flat_expression(input, body), body_span.end, after + 1) {
      Some(f) -> emit(emit(s1, b" "), f),
      None -> expression(input, newline(s1, indent + 2, false), body, indent + 2, after),
    },
  }
}

fn huggable(expression: Expression) -> Bool =
  match expression {
    LambdaExpression(_) -> true,
    RecordExpression(_) -> true,
    RecordUpdateExpression(_) -> true,
    ListExpression(_) -> true,
    _ -> is_block_like(expression),
  }

fn head_width(input: PrintInput, expression: Expression) -> Int / {abort.raise} =
  match expression {
    LambdaExpression(v) -> lambda_head(input, v.params, v.return_clause).len() + 2,
    MatchExpression(v) -> 8 + flat_len(input, v.scrutinee),
    IfExpression(v) -> 5 + flat_len(input, v.cond),
    HandleExpression(_) -> 8,
    WithScopeExpression(v) ->
      18 + v.resource.name.len() + flat_len(input, v.acquire) + flat_len(input, v.release)
        + v.binder.name.len(),
    _ -> 1,
  }

fn call(
  input: PrintInput,
  printer: Printer,
  args: List<Expression>,
  named: List<NamedArg>,
  span: Span,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let n = args.len();
  let hugged = match args.at(n - 1) {
    Some(last) -> if named.len() == 0 && huggable(last)
        && !comment_before(input, printer, expression_span(last).start) {
      let prefix = join_options(
        range(0, n - 1).map(|i: Int| flat_expression(input, args.get(i))),
        b", ",
      );
      match prefix {
        Some(pre) -> {
          let text = b"(".concat(if n > 1 { pre.concat(b", ") } else { pre });
          if fits(printer, text, head_width(input, last) + after + 1) { Some(text) } else { None }
        },
        None -> None,
      }
    } else { None },
    None -> None,
  };
  match hugged {
    Some(text) ->
      emit(expression(input, emit(printer, text), args.get(n - 1), indent, after + 1), b")"),
    None -> {
      let s1 = emit(printer, b"(");
      let s2 = range(0, n).fold(s1, |s: Printer, i: Int|
        element(input, s, args.get(i), indent + 2, i == n - 1 && named.len() == 0));
      let s3 = range(0, named.len()).fold(s2, |s: Printer, i: Int| {
        let a = named.get(i);
        let o = emit(
          newline_after_comments(input, s, a.span.start, indent + 2, false),
          a.name.name.concat(b": "),
        );
        let v = separated(
          input,
          expression(input, o, a.value, indent + 2, 1),
          a.value,
          i == named.len() - 1,
        );
        trailing_comment(input, set_previous(v, a.span.end), a.span.end)
      });
      close(input, s3, span.end, indent, b")")
    },
  }
}

fn element(
  input: PrintInput,
  printer: Printer,
  e: Expression,
  indent: Int,
  last: Bool,
) -> Printer / {abort.raise} = {
  let span = expression_span(e);
  let s = separated(
    input,
    expression(
      input,
      newline_after_comments(input, printer, span.start, indent, false),
      e,
      indent,
      1,
    ),
    e,
    last,
  );
  trailing_comment(input, set_previous(s, span.end), span.end)
}

fn separated(
  input: PrintInput,
  printer: Printer,
  expression: Expression,
  last: Bool,
) -> Printer / {abort.raise} =
  if last && is_line_string(input, expression) { printer } else { emit(printer, b",") }

fn elements(
  input: PrintInput,
  printer: Printer,
  open: Bytes,
  items: List<Expression>,
  closer: Bytes,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = set_previous(
    trailing_comment(input, emit(printer, open), span.start + 1),
    span.start + 1,
  );
  let s2 = range(0, items.len()).fold(s1, |s: Printer, i: Int|
    element(input, s, items.get(i), indent + 2, i == items.len() - 1));
  close(input, s2, span.end, indent, closer)
}

type CollectionLiteral = { set: Bool, items: List<Expression>, span: Span }

fn collection_literal_of(
  input: PrintInput,
  e: Expression,
) -> Option<CollectionLiteral> / {abort.raise} =
  match e {
    CallExpression(a) -> match ((a.function, a.args)) {
      (NameExpression(f), [ListExpression(l)]) -> match f.name.module {
        Some(m) -> if m.name == set_binder() { Some({ set: true, items: l.items, span: a.span }) }
        else if m.name == map_literal_call().binder && f.name.name.name == map_literal_call().name
            && in_source(input, a.span)
            && input.source.slice(a.span.start, a.span.start + 2) == b"#{" {
          Some({ set: false, items: l.items, span: a.span })
        } else { None },
        None -> None,
      },
      _ -> None,
    },
    _ -> None,
  }

fn entry_parts(x: Expression) -> Option<{ key: Expression, value: Expression }> =
  match x {
    RecordExpression(r) -> match field_of(r.fields, b"key") {
      Some(k) -> match field_of(r.fields, b"value") {
        Some(v) -> Some({ key: k, value: v }),
        None -> None,
      },
      None -> None,
    },
    _ -> None,
  }

fn field_of(fields: List<RecordLiteralField>, name: Bytes) -> Option<Expression> =
  fields.fold(None, |accumulator: Option<Expression>, field: RecordLiteralField|
    if field.name.name == name { Some(field.value) } else { accumulator })

pub type SurfaceSyntax =
  | AsParsed
  | Interpolated(List<Expression>)
  | MapLiteral(List<{ key: Expression, value: Expression }>)
  | SetLiteral(List<Expression>)

pub fn surface_syntax(source: Bytes, e: Expression) -> SurfaceSyntax / {abort.raise} = {
  let input: PrintInput = { source: source, comments: [] };
  match collection_literal_of(input, e) {
    Some(m) -> {
      let entries = m.items.map(|x: Expression|
        match entry_parts(x) { Some(parts) -> parts, None -> { key: x, value: x } });
      if m.set {
        SetLiteral(entries.map(|entry: { key: Expression, value: Expression }| entry.key))
      } else { MapLiteral(entries) }
    },
    None -> if one_string(input, e) { Interpolated(holes_of(e)) } else { AsParsed },
  }
}

pub fn holes_of(e: Expression) -> List<Expression> = append_interpolations(e, [])

fn append_interpolations(e: Expression, found: List<Expression>) -> List<Expression> =
  match e {
    BinaryExpression(v) -> if v.operation == b"concat" {
      append_interpolations(v.right_operand, append_interpolations(v.left_operand, found))
    } else { found },
    CallExpression(v) -> match v.args { [x] -> found.push(x), _ -> found },
    _ -> found,
  }

fn flat_collection_literal(
  input: PrintInput,
  m: CollectionLiteral,
) -> Option<Bytes> / {abort.raise} =
  if m.set {
    concat_options([
      Some(b"#["),
      join_options(m.items.map(|x: Expression| flat_expression(input, x)), b", "),
      Some(b"]"),
    ])
  } else {
    let entry = |key: Expression, value: Expression|
      concat_options([flat_expression(input, key), Some(b": "), flat_expression(input, value)]);
    concat_options([
      Some(b"#{"),
      join_options(
        m.items.map(|x: Expression|
          match entry_parts(x) { Some(en) -> entry(en.key, en.value), None -> entry(x, x) }),
        b", ",
      ),
      Some(b"}"),
    ])
  }

fn collection_literal(
  p: PrintInput,
  printer: Printer,
  m: CollectionLiteral,
  indent: Int,
) -> Printer / {abort.raise} = {
  let open = if m.set { b"#[" } else { b"#{" };
  let s1 = set_previous(
    trailing_comment(p, emit(printer, open), m.span.start + 2),
    m.span.start + 2,
  );
  let n = m.items.len();
  let s2 = range(0, n).fold(s1, |s: Printer, i: Int| {
    let entry = |key: Expression, value: Expression| {
      let ks = expression_span(key);
      let o = newline_after_comments(p, s, ks.start, indent + 2, false);
      if m.set {
        let v = separated(p, expression(p, o, key, indent + 2, 1), key, i == n - 1);
        trailing_comment(p, set_previous(v, ks.end), ks.end)
      } else {
        let vs = expression_span(value);
        let k = match flat_expression(p, key) { Some(f) -> f, None -> b"()" };
        let v = separated(
          p,
          expression(p, emit(o, k.concat(b": ")), value, indent + 2, 1),
          value,
          i == n - 1,
        );
        trailing_comment(p, set_previous(v, vs.end), vs.end)
      }
    };
    match m.items.at(i) {
      None -> s,
      Some(x) -> if m.set { entry(x, x) }
      else { match entry_parts(x) { Some(en) -> entry(en.key, en.value), None -> entry(x, x) } },
    }
  });
  close(p, s2, m.span.end, indent, if m.set { b"]" } else { b"}" })
}

fn record(
  p: PrintInput,
  printer: Printer,
  base: Option<Expression>,
  fields: List<RecordLiteralField>,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = set_previous(trailing_comment(p, emit(printer, b"{"), span.start + 1), span.start + 1);
  let s2 = match base {
    Some(base_expression) -> {
      let bsp = expression_span(base_expression);
      let text = match flat_base(p, base_expression) { Some(f) -> f, None -> b"()" };
      let s = emit(
        newline_after_comments(p, s1, bsp.start, indent + 2, false),
        Bytes::concat_all([b"..", text, b","]),
      );
      trailing_comment(p, set_previous(s, bsp.end), bsp.end)
    },
    None -> s1,
  };
  let s3 = range(0, fields.len()).fold(s2, |s: Printer, i: Int| {
    let f = fields.get(i);
    let vsp = expression_span(f.value);
    let o = newline_after_comments(p, s, f.name.span.start, indent + 2, false);
    let v = if punned(f) { emit(o, f.name.name.concat(b",")) } else {
      let named = emit(o, f.name.name.concat(b": "));
      separated(p, expression(p, named, f.value, indent + 2, 1), f.value, i == fields.len() - 1)
    };
    trailing_comment(p, set_previous(v, vsp.end), vsp.end)
  });
  close(p, s3, span.end, indent, b"}")
}

type Branch = { opened: Bool, printer: Printer }

fn branch(
  input: PrintInput,
  printer: Printer,
  expression: Expression,
  indent: Int,
  after: Int,
) -> Branch / {abort.raise} = {
  let span = expression_span(expression);
  match try_flat(input, printer, flat_expression(input, expression), span.end, after) {
    Some(f) -> { opened: false, printer: emit(printer, f) },
    None -> { opened: true, printer: block(input, printer, expression, indent) },
  }
}

fn ending(expression: Expression, after: Int) -> Int =
  match expression { LiteralExpression(_) -> after, _ -> 0 }

fn fits_alone(
  input: PrintInput,
  expression: Expression,
  indent: Int,
  after: Int,
) -> Bool / {abort.raise} = {
  let head = match expression {
    IfExpression(v) ->
      concat_options([
        Some(b"if "),
        flat_scrutinee(input, v.cond),
        Some(b" "),
        flat_expression(input, v.then_branch),
      ]),
    _ -> flat_expression(input, expression),
  };
  let tail = match expression { IfExpression(v) -> ending(v.else_branch, after), _ -> after };
  match head { Some(f) -> indent + 5 + f.len() + tail <= width(), None -> false }
}

fn fits_opening(
  input: PrintInput,
  printer: Printer,
  expression: Expression,
) -> Bool / {abort.raise} = {
  let opening = match expression {
    IfExpression(v) ->
      concat_options([Some(b" else if "), flat_scrutinee(input, v.cond), Some(b" {")]),
    _ -> Some(b" else {"),
  };
  match opening { Some(o) -> fits(printer, o, 0), None -> false }
}

fn emit_else(
  input: PrintInput,
  b: Branch,
  expression: Expression,
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let start = expression_span(expression).start;
  if comment_before(input, b.printer, start) {
    emit(newline_after_comments(input, b.printer, start, indent, false), b"else ")
  } else if b.opened
      || (!fits_alone(input, expression, indent, after)
      && fits_opening(input, b.printer, expression)) { emit(b.printer, b" else ") }
  else { emit(newline(b.printer, indent, false), b"else ") }
}

fn if_chain(
  input: PrintInput,
  printer: Printer,
  v: { span: Span, cond: Expression, then_branch: Expression, else_branch: Expression },
  indent: Int,
  after: Int,
) -> Printer / {abort.raise} = {
  let s1 = scrutinee(input, emit(printer, b"if "), v.cond, indent + 2, 2);
  let o = v.else_branch;
  let b = branch(input, emit(s1, b" "), v.then_branch, indent, ending(o, after));
  match o {
    LiteralExpression(_) -> b.printer,
    IfExpression(w) -> if_chain(input, emit_else(input, b, o, indent, after), w, indent, after),
    _ -> branch(input, emit_else(input, b, o, indent, after), o, indent, after).printer,
  }
}

fn match_expression(
  input: PrintInput,
  printer: Printer,
  scrut: Expression,
  arms: List<MatchArm>,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = emit(scrutinee(input, emit(printer, b"match "), scrut, indent + 2, 2), b" {");
  let s2 = range(0, arms.len()).fold(s1, |s: Printer, i: Int|
    arm(input, s, arms.get(i), indent + 2, i == arms.len() - 1));
  close(input, s2, span.end, indent, b"}")
}

fn arm(
  input: PrintInput,
  printer: Printer,
  a: MatchArm,
  indent: Int,
  last: Bool,
) -> Printer / {abort.raise} = {
  let s1 = emit(
    newline_after_comments(input, printer, a.span.start, indent, false),
    pattern_text(input, a.pattern),
  );
  let s2 = match a.guard {
    Some(g) -> expression(input, emit(s1, b" if "), g, indent + 2, 3),
    None -> s1,
  };
  let s4 = separated(input, arm_body(input, emit(s2, b" ->"), a.body, indent), a.body, last);
  trailing_comment(input, set_previous(s4, a.span.end), a.span.end)
}

fn arm_body(
  input: PrintInput,
  printer: Printer,
  body: Expression,
  indent: Int,
) -> Printer / {abort.raise} = {
  let body_span = expression_span(body);
  match try_flat(input, printer, flat_expression(input, body), body_span.end, 2) {
    Some(f) -> emit(emit(printer, b" "), f),
    None -> if is_block_like(body) || (match body { LambdaExpression(_) -> true, _ -> false }) {
      expression(input, emit(printer, b" "), body, indent, 1)
    } else { expression(input, newline(printer, indent + 2, false), body, indent + 2, 1) },
  }
}

fn handle_expression(
  input: PrintInput,
  printer: Printer,
  h: { span: Span, body: Expression, return_clause: Option<ReturnClause>, clauses: List<HandleClause>, handler_variables: List<HandlerStateVariable> },
  indent: Int,
) -> Printer / {abort.raise} = {
  let clauses = h.clauses;
  let return_clause = h.return_clause;
  let s1 = emit(printer, b"handle ");
  let s2 = match h.body {
    BlockExpression(v) -> block_of(input, s1, v, indent),
    _ -> expression(input, s1, h.body, indent + 2, 7),
  };
  let s3v = emit(s2, b" with {");
  let s3 = range(0, h.handler_variables.len()).fold(s3v, |s: Printer, i: Int| {
    let v = h.handler_variables.get(i);
    let ty = match v.ty { Some(t) -> b": ".concat(type_text(input, t)), None -> b"" };
    let o = emit(
      newline_after_comments(input, s, v.span.start, indent + 2, false),
      Bytes::concat_all([b"var ", v.name.name, ty, b" = "]),
    );
    let last = i == h.handler_variables.len() - 1 && clauses.len() == 0
      && (match return_clause { Some(_) -> false, None -> true });
    let bd = separated(input, expression(input, o, v.init, indent + 2, 1), v.init, last);
    trailing_comment(input, set_previous(bd, v.span.end), v.span.end)
  });
  let s4 = range(0, clauses.len()).fold(s3, |s: Printer, i: Int| {
    let c = clauses.get(i);
    let o = emit(
      newline_after_comments(input, s, c.span.start, indent + 2, false),
      clause_head(c).concat(b" ->"),
    );
    let last = i == clauses.len() - 1 && (match return_clause { Some(_) -> false, None -> true });
    let bd = separated(input, arm_body(input, o, c.body, indent + 2), c.body, last);
    trailing_comment(input, set_previous(bd, c.span.end), c.span.end)
  });
  let s5 = match return_clause {
    Some(r) -> {
      let o = emit(
        newline_after_comments(input, s4, r.span.start, indent + 2, false),
        Bytes::concat_all([b"return ", r.binder.name, b" ->"]),
      );
      let bd = separated(input, arm_body(input, o, r.body, indent + 2), r.body, true);
      trailing_comment(input, set_previous(bd, r.span.end), r.span.end)
    },
    None -> s4,
  };
  close(input, s5, h.span.end, indent, b"}")
}

fn scope_body(
  input: PrintInput,
  printer: Printer,
  body: Expression,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let bsp = expression_span(body);
  match body {
    BlockExpression(_) -> emit(block(input, emit(printer, b" "), body, indent), b" }"),
    _ -> match try_flat(input, printer, flat_expression(input, body), bsp.end, 3) {
      Some(f) -> emit(printer, Bytes::concat_all([b" ", f, b" }"])),
      None -> {
        let s3 = expression(input, newline(printer, indent + 2, false), body, indent + 2, 0);
        emit(newline(flush_comments(input, s3, span.end, indent + 2, false), indent, false), b"}")
      },
    },
  }
}

pub fn print_standalone(
  source: Bytes,
  imports: List<ImportDeclaration>,
  items: List<Item>,
) -> Bytes / {abort.raise} =
  module({ source: source, comments: [] }, {
    doc: None,
    imports: imports,
    items: items.map(with_operators),
  })

pub fn module_text(m: Module) -> Bytes / {abort.raise} = print_standalone(b"", m.imports, m.items)

fn module(input: PrintInput, m: Module) -> Bytes / {abort.raise} = {
  let st0 = { next_comment: 0, column: 0, previous_end: 0, pending: [], closed: -1, parts: [] };
  let s1 = m.imports.filter(is_explicit_import).fold(
    st0,
    |printer: Printer, declaration: ImportDeclaration|
      import_declaration(input, printer, declaration),
  );
  let s2 = m.items.fold(s1, |printer: Printer, it: Item| item(input, printer, it));
  finish(flush_comments(input, s2, input.source.len() + 1, 0, true))
}

fn import_declaration(
  input: PrintInput,
  printer: Printer,
  declaration: ImportDeclaration,
) -> Printer / {abort.raise} = {
  let s1 = newline_after_comments(input, printer, declaration.span.start, 0, true);
  let base = b"import ".concat(
    Bytes::join(declaration.path.map(|identifier: Identifier| identifier.name), b"."),
  );
  let s2 = match declaration.kind {
    WholeModule -> emit(s1, base),
    ModuleAlias(a) -> emit(s1, Bytes::concat_all([base, b" as ", a.name])),
    SelectedNames(ns) ->
      fill(emit(s1, base.concat(b" (")), ns.map(|identifier: Identifier| identifier.name)),
  };
  trailing_comment(
    input,
    set_previous(absorb(input, s2, declaration.span.end), declaration.span.end),
    declaration.span.end,
  )
}

fn fill(printer: Printer, names: List<Bytes>) -> Printer / {abort.raise} = {
  let col0 = printer.column;
  let n = names.len();
  range(0, n).fold(printer, |s: Printer, i: Int| {
    let piece = names.get(i).concat(if i == n - 1 { b")" } else { b"," });
    if i == 0 { emit(s, piece) }
    else if fits(s, piece, 1) { emit(s, b" ".concat(piece)) }
    else { emit(newline(s, col0, false), piece) }
  })
}

fn visibility_text(v: Visibility) -> Bytes = match v { Public -> b"pub ", Private -> b"" }

fn constraint_text(c: Constraint) -> Bytes = constraint_written(c.deriver, c.param.name)

fn item(input: PrintInput, printer: Printer, it: Item) -> Printer / {abort.raise} = {
  let span = item_span(it);
  let s1 = if in_source(input, span) { newline_after_comments(input, printer, span.start, 0, true) }
  else { newline(printer, 0, true) };
  let s2 = match it {
    FunctionItem(d) -> fn_definition(input, s1, d),
    TypeItem(d) -> type_definition(input, s1, d),
    EffectItem(d) -> effect_definition(input, s1, d),
    TestItem(d) -> test_definition(input, s1, d),
    LawItem(d) -> law_definition(input, s1, d),
    SchemaItem(d) -> schema_definition(input, s1, d),
    DeriveItem(d) -> emit(s1, Bytes::concat_all([b"derive ", d.deriver, b" for ", d.target.name])),
    EffectSetItem(d) ->
      emit(
        s1,
        Bytes::concat_all([
          visibility_text(d.visibility),
          b"effect set ",
          d.name.name,
          b" = {",
          Bytes::join(members(d.listed, d.includes), b", "),
          b"}",
        ]),
      ),
    ExternItem(d) -> extern_definition(input, s1, d),
    InstanceItem(d) ->
      emit(
        s1,
        Bytes::concat_all([
          instance_text(d.kind),
          b" for ",
          d.target.name,
          b" by ",
          d.function.name,
        ]),
      ),
    NumericItem(d) ->
      emit(
        s1,
        Bytes::concat_all([
          b"numeric for ",
          d.target.name,
          b" by { ",
          Bytes::join(
            d.operations.map(|x: NumericOperation|
              Bytes::concat_all([x.operation.name, b": ", x.by.name])),
            b", ",
          ),
          b" }",
        ]),
      ),
  };
  trailing_comment(input, set_previous(absorb(input, s2, span.end), span.end), span.end)
}

fn definition_body(
  input: PrintInput,
  printer: Printer,
  e: Expression,
  indent: Int,
) -> Printer / {abort.raise} = {
  let span = expression_span(e);
  if comment_before(input, printer, span.start) {
    expression(input, newline(printer, indent + 2, false), e, indent + 2, 0)
  } else {
    match try_flat(input, printer, flat_expression(input, e), span.end, 0) {
      Some(f) -> emit(printer, f),
      None -> match e {
        BlockExpression(v) -> block_of(input, printer, v, indent),
        _ -> expression(input, newline(printer, indent + 2, false), e, indent + 2, 0),
      },
    }
  }
}

fn flat_param(input: PrintInput, param: Param) -> Option<Bytes> / {abort.raise} =
  match param.default {
    Some(e) ->
      concat_options([Some(param_head(input, param).concat(b" = ")), flat_expression(input, e)]),
    None -> Some(param_head(input, param)),
  }

fn param(input: PrintInput, printer: Printer, x: Param, indent: Int) -> Printer / {abort.raise} = {
  let s1 = emit(
    newline_after_comments(input, printer, x.span.start, indent, false),
    param_head(input, x),
  );
  let s2 = match x.default {
    Some(e) ->
      expression(input, absorb(input, emit(s1, b" = "), expression_span(e).start), e, indent, 1),
    None -> absorb(input, s1, x.span.end),
  };
  trailing_comment(input, set_previous(emit(s2, b","), x.span.end), x.span.end)
}

fn fn_definition(
  input: PrintInput,
  printer: Printer,
  definition: FnDefinition,
) -> Printer / {abort.raise} =
  match ((definition.constant, definition.return_type)) {
    (Some({ read_by_name: true, .. }), Some(t)) -> {
      let head = Bytes::concat_all([
        visibility_text(definition.visibility),
        b"const ",
        definition.name.name,
        b": ",
        type_text(input, t),
        b" = ",
      ]);
      definition_body(input, emit(printer, head), definition.body, 0)
    },
    _ -> function_definition(input, printer, definition),
  }

fn function_definition(
  input: PrintInput,
  printer: Printer,
  definition: FnDefinition,
) -> Printer / {abort.raise} = {
  let reuse_kw = match definition.reuse { Some(_) -> b"reuse ", None -> b"" };
  let transparent_kw = match definition.transparent { Some(_) -> b"transparent ", None -> b"" };
  let const_kw = match definition.constant { Some(_) -> b"const ", None -> b"" };
  let head = Bytes::concat_all([
    visibility_text(definition.visibility),
    transparent_kw,
    reuse_kw,
    const_kw,
    b"fn ",
    definition.name.name,
    generics_text(definition.generics),
  ]);
  let tail = match definition.return_type {
    Some(t) -> b" -> ".concat(result_text(input, t, definition.effects)),
    None -> effects_suffix(input, definition.effects),
  };
  let clauses = definition.constraints.len() > 0 || definition.spec.len() > 0
    || definition.returns != None
    || (match definition.decreases { Some(_) -> true, None -> false });
  let params_end = match definition.params.at(definition.params.len() - 1) {
    Some(x) -> x.span.end,
    None -> definition.name.span.end,
  };
  let s1 = emit(printer, head);
  let flat = concat_options([
    Some(b"("),
    join_options(definition.params.map(|x: Param| flat_param(input, x)), b", "),
    Some(b")"),
    Some(tail),
  ]);
  let fit = if definition.params.len() == 0 { flat }
  else { try_flat(input, s1, flat, params_end, if clauses { 0 } else { 2 }) };
  let s2 = match fit {
    Some(f) -> emit(s1, f),
    None -> {
      let ps = definition.params.fold(emit(s1, b"("), |s: Printer, x: Param| param(input, s, x, 2));
      emit(close(input, ps, params_end, 0, b")"), tail)
    },
  };
  let s3 = if definition.constraints.len() == 0 { s2 } else {
    emit(
      newline(s2, 2, false),
      b"where ".concat(Bytes::join(definition.constraints.map(constraint_text), b", ")),
    )
  };
  let s35 = match definition.returns {
    None -> s3,
    Some(ReturnsFresh(_)) -> emit(newline(s3, 2, false), b"returns fresh"),
    Some(ReturnsParam(x)) -> emit(newline(s3, 2, false), b"returns ".concat(x.name)),
  };
  let s4 = definition.spec.fold(s35, |s: Printer, clause: SpecClause|
    spec_clause(input, s, clause));
  let s45 = match definition.decreases {
    None -> s4,
    Some(m) -> {
      let span = expression_span(m);
      let o = emit(newline_after_comments(input, s4, span.start, 2, false), b"decreases ");
      trailing_comment(input, set_previous(expression(input, o, m, 2, 0), span.end), span.end)
    },
  };
  let s5 = if clauses { emit(newline(s45, 0, false), b"= ") } else { emit(s45, b" = ") };
  definition_body(input, s5, definition.body, 0)
}

fn spec_clause(input: PrintInput, printer: Printer, clause: SpecClause) -> Printer / {abort.raise} = {
  let o = emit(
    newline_after_comments(input, printer, clause.span.start, 2, false),
    spec_kind_text(clause.kind).concat(b" "),
  );
  let e = expression(input, o, clause.expression, 2, 0);
  trailing_comment(input, set_previous(e, clause.span.end), clause.span.end)
}

fn extern_definition(
  input: PrintInput,
  printer: Printer,
  definition: ExternDefinition,
) -> Printer / {abort.raise} = {
  let head = Bytes::concat_all([
    visibility_text(definition.visibility),
    b"extern fn ",
    definition.name.name,
    generics_text(definition.generics),
  ]);
  let tail = b" -> ".concat(result_text(input, definition.return_type, definition.effects));
  let params_end = match definition.params.at(definition.params.len() - 1) {
    Some(x) -> x.span.end,
    None -> definition.name.span.end,
  };
  let s1 = emit(printer, head);
  let flat = concat_options([
    Some(b"("),
    join_options(definition.params.map(|x: Param| flat_param(input, x)), b", "),
    Some(b")"),
    Some(tail),
  ]);
  let fit = if definition.params.len() == 0 { flat }
  else { try_flat(input, s1, flat, params_end, 0) };
  let s2 = match fit {
    Some(f) -> emit(s1, f),
    None -> {
      let ps = definition.params.fold(emit(s1, b"("), |s: Printer, x: Param| param(input, s, x, 2));
      emit(close(input, ps, params_end, 0, b")"), tail)
    },
  };
  let s3 = if definition.constraints.len() == 0 { s2 } else {
    emit(
      newline(s2, 2, false),
      b"where ".concat(Bytes::join(definition.constraints.map(constraint_text), b", ")),
    )
  };
  definition.spec.fold(s3, |s: Printer, clause: SpecClause| spec_clause(input, s, clause))
}

fn variant_text(input: PrintInput, variant: VariantDefinition) -> Bytes / {abort.raise} =
  if variant.fields.len() == 0 { variant.name.name } else {
    Bytes::concat_all([
      variant.name.name,
      b"(",
      Bytes::join(variant.fields.map(|ty: TypeExpression| type_text(input, ty)), b", "),
      b")",
    ])
  }

fn record_type(
  input: PrintInput,
  printer: Printer,
  fields: List<{ name: Identifier, ty: TypeExpression }>,
  span: Span,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = set_previous(
    trailing_comment(input, emit(printer, b"{"), span.start + 1),
    span.start + 1,
  );
  let s2 = fields.fold(s1, |s: Printer, f: { name: Identifier, ty: TypeExpression }| {
    let tsp = type_span(f.ty);
    let o = emit(
      newline_after_comments(input, s, f.name.span.start, indent + 2, false),
      type_field_text(input, f).concat(b","),
    );
    trailing_comment(input, set_previous(absorb(input, o, tsp.end), tsp.end), tsp.end)
  });
  close(input, s2, span.end, indent, b"}")
}

fn type_layout(input: PrintInput, printer: Printer, t: TypeExpression) -> Printer / {abort.raise} =
  match t {
    RecordTypeExpression(r) -> if is_type_tuple(r.fields) { emit(printer, type_text(input, t)) }
    else {
      match try_flat(input, printer, Some(type_text(input, t)), r.span.end, 0) {
        Some(f) -> emit(printer, f),
        None -> record_type(input, printer, r.fields, r.span, 0),
      }
    },
    _ -> emit(printer, type_text(input, t)),
  }

fn type_definition(
  input: PrintInput,
  printer: Printer,
  d: TypeDefinition,
) -> Printer / {abort.raise} =
  match d.body {
    ExternBody ->
      emit(
        printer,
        Bytes::concat_all([
          visibility_text(d.visibility),
          b"extern type ",
          d.name.name,
          generics_text(d.generics),
          where_text(d.constraints),
        ]),
      ),
    _ -> declared_type(input, printer, d),
  }

fn where_text(constraints: List<Constraint>) -> Bytes =
  if constraints.len() == 0 { b"" }
  else { b" where ".concat(Bytes::join(constraints.map(constraint_text), b", ")) }

fn declared_type(
  input: PrintInput,
  printer: Printer,
  d: TypeDefinition,
) -> Printer / {abort.raise} = {
  let params = generics_text(d.generics);
  let s1 = emit(
    printer,
    Bytes::concat_all([
      visibility_text(d.visibility),
      match d.opaque { Some(_) -> b"opaque ", None -> b"" },
      b"type ",
      d.name.name,
      params,
      where_text(d.constraints),
      b" = ",
    ]),
  );
  match d.body {
    AliasBody(t) -> type_layout(input, s1, t),
    NominalBody(t) -> type_layout(input, emit(s1, b"new "), t),
    ExternBody -> s1,
    SumBody(vs) -> {
      let flat = b"| ".concat(
        Bytes::join(vs.map(|variant: VariantDefinition| variant_text(input, variant)), b" | "),
      );
      match try_flat(input, s1, Some(flat), d.span.end, 0) {
        Some(f) -> emit(s1, f),
        None ->
          vs.fold(s1, |s: Printer, variant: VariantDefinition| {
            let o = emit(
              newline_after_comments(input, s, variant.span.start, 2, false),
              b"| ".concat(variant_text(input, variant)),
            );
            trailing_comment(
              input,
              set_previous(absorb(input, o, variant.span.end), variant.span.end),
              variant.span.end,
            )
          }),
      }
    },
  }
}

fn identifier_chars() -> Bytes = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

fn is_identifier_byte(c: Int) -> Bool =
  is_digit(c) || (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95

fn skip_whitespace(input: PrintInput, i: Int) -> Int / {abort.raise} =
  input.source.scan(i, b" \t\r\n", input.source.len() - i)

fn skip_whitespace_back(input: PrintInput, i: Int) -> Int / {abort.raise} =
  skip_blank_back(input.source, i)

fn skip_blank_back(source: Bytes, i: Int) -> Int / {abort.raise} =
  iterate(i, i + 1, |k: Int|
    if k > 0 && (is_blank(source.at(k - 1)) || source.at(k - 1) == 10) { Continue(k - 1) }
    else { Stop(k) })

fn identifier_after_bracket(input: PrintInput, i: Int) -> Bytes / {abort.raise} = {
  let j = skip_whitespace(input, i);
  if j < input.source.len() && input.source.at(j) == 91 {
    let k = skip_whitespace(input, j + 1);
    input.source.slice(k, input.source.scan(k, identifier_chars(), input.source.len() - k))
  } else { b"" }
}

fn name_before(input: PrintInput, i: Int) -> Option<Bytes> / {abort.raise} = {
  let j = skip_whitespace_back(input, i);
  if j > 0 && input.source.at(j - 1) == 58 {
    let e = skip_whitespace_back(input, j - 1);
    let s = iterate(e, e + 1, |k: Int|
      if k > 0 && is_identifier_byte(input.source.at(k - 1)) { Continue(k - 1) } else { Stop(k) });
    if s < e { Some(input.source.slice(s, e)) } else { None }
  } else { None }
}

fn past_keep(input: PrintInput, i: Int, has_keep: Bool) -> Int / {abort.raise} =
  if !has_keep { i } else {
    let j = skip_whitespace_back(input, i);
    if j >= 4 && input.source.slice(j - 4, j) == b"keep" { j - 4 } else { i }
  }

fn operation_declaration_text(
  input: PrintInput,
  operation: OperationDefinition,
) -> Bytes / {abort.raise} = {
  let resource = if !operation.resource_param { b"" }
  else if in_source(input, operation.name.span) {
    Bytes::concat_all([b"[", identifier_after_bracket(input, operation.name.span.end), b"]"])
  } else { b"[r]" };
  let ps = range(0, operation.params.len()).map(|i: Int| {
    let t = operation.params.get(i);
    let ty = (if operation.keep_indices.contains(i) { b"keep " } else { b"" }).concat(
      type_text(input, t),
    );
    let named = if in_source(input, type_span(t)) {
      name_before(input, past_keep(input, type_span(t).start, operation.keep_indices.contains(i)))
    } else { None };
    match named { Some(n) -> Bytes::concat_all([n, b": ", ty]), None -> ty }
  });
  Bytes::concat_all([
    mode_text(operation.mode),
    b" ",
    operation.name.name,
    resource,
    generics_text({ ..no_generics(), types: operation.type_params }),
    b"(",
    Bytes::join(ps, b", "),
    b")",
    if is_raise(operation.mode) { b"" }
    else { b" -> ".concat(type_text(input, operation.return_type)) },
  ])
}

fn effect_definition(
  input: PrintInput,
  printer: Printer,
  d: EffectDefinition,
) -> Printer / {abort.raise} = {
  let nd = if d.is_nondet { b"nondet " } else { b"" };
  let s1 = emit(
    printer,
    Bytes::concat_all([visibility_text(d.visibility), nd, b"effect ", d.name.name, b" {"]),
  );
  if d.operations.len() == 0 && !comment_before(input, s1, d.span.end) { emit(s1, b"}") } else {
    let s2 = d.operations.fold(s1, |s: Printer, operation: OperationDefinition| {
      let e = emit(
        newline_after_comments(input, s, operation.span.start, 2, false),
        operation_declaration_text(input, operation),
      );
      trailing_comment(
        input,
        set_previous(absorb(input, e, operation.span.end), operation.span.end),
        operation.span.end,
      )
    });
    close(input, s2, d.span.end, 0, b"}")
  }
}

fn test_definition(
  input: PrintInput,
  printer: Printer,
  d: TestDefinition,
) -> Printer / {abort.raise} = {
  let kw = if d.is_nondet { b"test/nondet " } else { b"test " };
  let head = emit(printer, Bytes::concat_all([kw, label_text(input, d.label_span, d.label), b" "]));
  match d.cases {
    None -> definition_body(input, head, d.body, 0),
    Some(c) -> {
      let ranged = emit(
        head,
        Bytes::concat_all([b"for ", c.binder.name, b": ", type_text(input, c.ty), b" in "]),
      );
      let table = match try_flat(
          input,
          ranged,
          flat_scrutinee(input, c.table),
          expression_span(c.table).end,
          2,
        ) {
        Some(f) -> emit(ranged, f),
        None -> scrutinee(input, ranged, c.table, 2, 2),
      };
      definition_body(input, emit(table, b" "), d.body, 0)
    },
  }
}

fn label_text(input: PrintInput, span: Span, name: Bytes) -> Bytes / {abort.raise} =
  if in_source(input, span) { input.source.slice(span.start, span.end) }
  else { string_literal(name) }

fn binder_text(input: PrintInput, binder: Binder) -> Bytes / {abort.raise} =
  Bytes::concat_all([binder.name.name, b": ", type_text(input, binder.ty)])

fn binders_text(input: PrintInput, binders: List<Binder>) -> Bytes / {abort.raise} =
  if binders.len() == 0 { b"" } else {
    Bytes::concat_all([
      b"forall (",
      Bytes::join(binders.map(|binder: Binder| binder_text(input, binder)), b", "),
      b")",
    ])
  }

fn identities_text(identities: List<Identifier>, guarded: Bool) -> Bytes =
  if identities.len() == 0 { b"" } else {
    Bytes::concat_all([
      Bytes::join(
        identities.map(|i: Identifier| Bytes::concat_all([b"identity(", i.name, b")"])),
        b", ",
      ),
      if guarded { b", " } else { b"" },
    ])
  }

type ClaimWhere = { identities: List<Identifier>, guard: Option<Expression> }

fn where_flat(input: PrintInput, w: ClaimWhere) -> Option<Bytes> / {abort.raise} =
  if w.identities.len() == 0 && w.guard == None { Some(b"") } else {
    concat_options([
      Some(b" where ".concat(identities_text(w.identities, w.guard != None))),
      match w.guard { Some(g) -> flat_scrutinee(input, g), None -> Some(b"") },
    ])
  }

fn claim_flat(
  input: PrintInput,
  binders: List<Binder>,
  w: ClaimWhere,
  body: Expression,
) -> Option<Bytes> / {abort.raise} = {
  let quantified = binders_text(input, binders);
  concat_options([
    Some(if quantified.len() == 0 { b"" } else { b" ".concat(quantified) }),
    where_flat(input, w),
    Some(b" "),
    flat_expression(input, body),
  ])
}

fn claim_lines(
  input: PrintInput,
  s1: Printer,
  binders: List<Binder>,
  w: ClaimWhere,
  body: Expression,
) -> Printer / {abort.raise} = {
  let written = binders_text(input, binders);
  let quantified = written.len() > 0 || w.guard != None || w.identities.len() > 0;
  let s2 = if written.len() == 0 { s1 } else { emit(newline(s1, 2, false), written) };
  let s3 = match w.guard {
    Some(g) -> match try_flat(input, s2, where_flat(input, w), expression_span(g).end, 2) {
      Some(f) -> emit(s2, f),
      None ->
        scrutinee(
          input,
          emit(newline(s2, 2, false), b"where ".concat(identities_text(w.identities, true))),
          g,
          2,
          2,
        ),
    },
    None -> match where_flat(input, w) { Some(f) -> emit(s2, f), None -> s2 },
  };
  block(input, emit(s3, b" "), body, if quantified { 2 } else { 0 })
}

fn law_definition(
  input: PrintInput,
  printer: Printer,
  d: LawDefinition,
) -> Printer / {abort.raise} = {
  let head = b"law ".concat(label_text(input, d.name_span, d.name));
  let w = { identities: d.identities, guard: d.guard };
  match d.of {
    Some(_) -> definition_body(input, emit(printer, head.concat(b" = ")), d.body, 0),
    None -> {
      let flat = concat_options([Some(head), claim_flat(input, d.binders, w, d.body)]);
      match try_flat(input, printer, flat, d.span.end, 0) {
        Some(f) -> emit(printer, f),
        None -> claim_lines(input, emit(printer, head), d.binders, w, d.body),
      }
    },
  }
}

fn schema_param(
  input: PrintInput,
  printer: Printer,
  x: Binder,
  indent: Int,
) -> Printer / {abort.raise} = {
  let s1 = emit(
    newline_after_comments(input, printer, x.span.start, indent, false),
    binder_text(input, x),
  );
  trailing_comment(
    input,
    set_previous(emit(absorb(input, s1, x.span.end), b","), x.span.end),
    x.span.end,
  )
}

fn schema_definition(
  input: PrintInput,
  printer: Printer,
  d: SchemaDefinition,
) -> Printer / {abort.raise} = {
  let head = Bytes::concat_all([
    visibility_text(d.visibility),
    b"law schema ",
    d.name.name,
    generics_text(d.generics),
  ]);
  let params = Bytes::concat_all([
    b"(",
    Bytes::join(d.params.map(|x: Binder| binder_text(input, x)), b", "),
    b")",
  ]);
  let w = { identities: d.identities, guard: d.guard };
  let flat = concat_options([Some(head), Some(params), claim_flat(input, d.binders, w, d.body)]);
  match try_flat(input, printer, flat, d.span.end, 0) {
    Some(f) -> emit(printer, f),
    None -> {
      let s1 = emit(printer, head);
      let params_end = match d.params.at(d.params.len() - 1) {
        Some(x) -> x.span.end,
        None -> d.name.span.end,
      };
      let fit = if d.params.len() == 0 { Some(params) }
      else { try_flat(input, s1, Some(params), params_end, 0) };
      let s2 = match fit {
        Some(f) -> emit(s1, f),
        None -> {
          let ps = d.params.fold(emit(s1, b"("), |s: Printer, x: Binder|
            schema_param(input, s, x, 2));
          close(input, ps, params_end, 0, b")")
        },
      };
      claim_lines(input, s2, d.binders, w, d.body)
    },
  }
}

type LocatedItem = { start: Int, end: Int, item: Item }

fn item_kind(item: Item) -> Bytes =
  match item {
    FunctionItem(_) -> b"fn",
    TypeItem(_) -> b"type",
    EffectItem(_) -> b"effect",
    TestItem(_) -> b"test",
    LawItem(_) -> b"law",
    SchemaItem(_) -> b"law schema",
    DeriveItem(_) -> b"derive",
    EffectSetItem(_) -> b"effect set",
    ExternItem(_) -> b"extern fn",
    InstanceItem(d) -> instance_text(d.kind),
    NumericItem(_) -> b"numeric",
  }

fn item_name(item: Item) -> Option<Bytes> =
  match item {
    FunctionItem(d) -> Some(d.name.name),
    TypeItem(d) -> Some(d.name.name),
    EffectItem(d) -> Some(d.name.name),
    SchemaItem(d) -> Some(d.name.name),
    EffectSetItem(d) -> Some(d.name.name),
    ExternItem(d) -> Some(d.name.name),
    _ -> None,
  }

fn item_description(item: Item) -> Bytes =
  match item_name(item) {
    Some(n) -> Bytes::concat_all([b"`", item_kind(item), b"` `", n, b"`"]),
    None -> Bytes::concat_all([b"a `", item_kind(item), b"`"]),
  }

pub fn line_start(source: Bytes, i: Int) -> Int / {abort.raise} =
  iterate(i, i + 1, |k: Int|
    if k > 0 && source.at(k - 1) != 10 { Continue(k - 1) } else { Stop(k) })

pub fn line_end(source: Bytes, i: Int) -> Int / {abort.raise} =
  match source.index_of_from(b"\n", i) { Some(j) -> j + 1, None -> source.len() }

fn head_start(source: Bytes, item: Item) -> Int / {abort.raise} = {
  let kw = match item {
    FunctionItem(d) -> match d.transparent {
      Some(t) -> t.start,
      None -> match d.reuse {
        Some(s) -> s.start,
        None -> match d.constant { Some(c) -> c.span.start, None -> d.span.start },
      },
    },
    _ -> item_span(item).start,
  };
  let published = match item {
    FunctionItem(d) -> is_pub(d.visibility),
    TypeItem(d) -> is_pub(d.visibility),
    EffectItem(d) -> is_pub(d.visibility),
    _ -> false,
  };
  let j = skip_blank_back(source, kw);
  if published && j >= 3 && source.slice(j - 3, j) == b"pub"
      && (j == 3 || !is_identifier_byte(source.at(j - 4))) { j - 3 }
  else { kw }
}

fn floor_before(module: Module, position: Int) -> Int = {
  let imported = module.imports.filter(is_explicit_import).fold(
    0,
    |accumulator: Int, declaration: ImportDeclaration|
      if declaration.span.end <= position && declaration.span.end > accumulator {
        declaration.span.end
      } else { accumulator },
  );
  module.items.fold(imported, |accumulator: Int, item: Item| {
    let e = item_span(item).end;
    if e <= position && e > accumulator { e } else { accumulator }
  })
}

fn next_item_start(source: Bytes, module: Module, position: Int) -> Int / {abort.raise} = {
  let imported = module.imports.filter(is_explicit_import).fold(
    source.len(),
    |accumulator: Int, declaration: ImportDeclaration|
      if declaration.span.start >= position && declaration.span.start < accumulator {
        declaration.span.start
      } else { accumulator },
  );
  module.items.fold(imported, |accumulator: Int, item: Item| {
    let s = head_start(source, item);
    if s >= position && s < accumulator { s } else { accumulator }
  })
}

fn doc_start(source: Bytes, head: Int, floor: Int) -> Int / {abort.raise} = {
  let first = line_start(source, head);
  if first < floor { floor } else {
    iterate(first, head + 1, |ls: Int|
      if ls <= floor { Stop(ls) } else {
        let previous_line_start = line_start(source, ls - 1);
        if previous_line_start >= floor
            && trim(source.slice(previous_line_start, ls - 1)).starts_with(b"//") {
          Continue(previous_line_start)
        } else { Stop(ls) }
      })
  }
}

fn locate(source: Bytes, name: Bytes) -> Result<LocatedItem, Bytes> / {abort.raise} = {
  let r = parse(source);
  match r.parser.diagnostics.at(0) {
    Some(d) -> Err(render_diagnostic(source, d)),
    None -> {
      let m = r.node;
      let found = m.items.filter(|it: Item|
        match item_name(it) { Some(n) -> n == name, None -> false });
      if found.len() == 0 {
        Err(Bytes::concat_all([b"no `fn`, `type` or `effect` is named `", name, b"`"]))
      } else if found.len() > 1 {
        Err(Bytes::concat_all([b"`", name, b"` names ", ascii_of_int(found.len()), b" items"]))
      } else {
        let it = found.get(0);
        let head = head_start(source, it);
        let last = item_span(it).end;
        let above = match item_doc(it) { Some(d) -> d.span.start, None -> head };
        let start = doc_start(source, above, floor_before(m, above));
        let end = min(line_end(source, last), next_item_start(source, m, last));
        Ok({ start: start, end: end, item: it })
      }
    },
  }
}

pub fn item_range(
  source: Bytes,
  name: Bytes,
) -> Result<{ start: Int, end: Int }, Bytes> / {abort.raise} =
  match locate(source, name) { Ok(l) -> Ok({ start: l.start, end: l.end }), Err(e) -> Err(e) }

pub fn replace_item(
  source: Bytes,
  name: Bytes,
  item: Bytes,
) -> Result<Bytes, Bytes> / {abort.raise} = {
  let old = locate(source, name)?;
  let r = parse(item);
  match r.parser.diagnostics.at(0) {
    Some(d) -> Err(b"the replacement does not parse: ".concat(render_diagnostic(item, d))),
    None -> {
      let m = r.node;
      if m.imports.filter(is_explicit_import).len() > 0 {
        Err(b"the replacement contains an import; it must be one item")
      } else if m.items.len() != 1 {
        Err(
          Bytes::concat_all([
            b"the replacement contains ",
            ascii_of_int(m.items.len()),
            b" items; it must be one",
          ]),
        )
      } else {
        let fresh = m.items.get(0);
        let same = item_kind(fresh) == item_kind(old.item)
          && (match item_name(fresh) { Some(n) -> n == name, None -> false });
        if !same {
          Err(
            Bytes::concat_all([
              b"the replacement defines ",
              item_description(fresh),
              b"; expected ",
              item_description(old.item),
            ]),
          )
        } else {
          let formatted = fmt_source(item)?;
          let leading_comments = if old.start > 0 && source.at(old.start - 1) != 10 { b"\n" }
          else { b"" };
          Ok(
            Bytes::concat_all([
              source.slice(0, old.start),
              leading_comments,
              formatted,
              source.slice(old.end, source.len()),
            ]),
          )
        }
      }
    },
  }
}

fn formatted(source: Bytes) -> Bytes / {abort.raise} =
  match fmt_source(source) { Ok(o) -> o, Err(e) -> panic(String::of_bytes(e)) }

fn stable(source: Bytes) -> Bool / {abort.raise} = {
  let out = formatted(source);
  fmt_source(out) == Ok(out)
}

fn tree_of(source: Bytes) -> Bytes / {abort.raise} = erase_spans(dump_module(parse(source).node))

fn lays_out(source: Bytes, out: Bytes) -> Unit / {abort.raise} = {
  assert_eq(formatted(source), out);
  assert_eq(formatted(out), out);
  assert_eq(tree_of(out), tree_of(source))
}

test "a program is printed back with its comments, and printing it again changes nothing" {
  let source = b"// top\nfn   f(a: Int,b: Int)->Int = a+b // add\n\n\nfn g() -> List<Int> = [1_000, 0xFF]\n";
  let out = formatted(source);
  assert_eq(
    out,
    b"// top\nfn f(a: Int, b: Int) -> Int = a + b  // add\n\nfn g() -> List<Int> = [1_000, 0xFF]\n",
  );
  assert(stable(source))
}

test "a `const fn` prints as it is written" {
  lays_out(
    b"/// The answer.\npub   const   fn answer( ) -> Int = 42\n",
    b"/// The answer.\npub const fn answer() -> Int = 42\n",
  )
}

test "a type's where clause prints after its generic list" {
  lays_out(
    b"pub type Game<s, a, c | e>   where derivable(eq, a),derivable(hash, a) = { f: (a, a) -> Bool }\n",
    b"pub type Game<s, a, c | e> where derivable(eq, a), derivable(hash, a) = { f: (a, a) -> Bool }\n",
  );
  lays_out(
    b"extern type H<a> where derivable(hash, a)\n",
    b"extern type H<a> where derivable(hash, a)\n",
  )
}

test "the formatter leaves already formatted method calls unchanged, including named arguments, qualified function names and record updates" {
  let source = b"fn f(s: Stack) -> Int = s.grown(2, twice: true).size() + s.lib::depth(1) + (s.held)(1)\n";
  assert_eq(formatted(source), source);
  let update = b"fn f(xs: List<P>, i: Int) -> P = { ..xs.get(i), a: 1 }\n";
  assert_eq(formatted(update), update)
}

test "the formatter normalizes spacing in map and set literals, and leaves calls like `Map::of_entries` as calls" {
  lays_out(
    b"fn f() -> Map<String, Int> = #{ \"a\" : 1,\"b\":2 }\n",
    b"fn f() -> Map<String, Int> = #{\"a\": 1, \"b\": 2}\n",
  );
  lays_out(b"fn f() -> Set<Int> = #[ 3,1 ]\n", b"fn f() -> Set<Int> = #[3, 1]\n");
  lays_out(
    b"fn f() -> Set<{ key: Int, value: Int }> = #[{key: 1, value: 2}]\n",
    b"fn f() -> Set<{ key: Int, value: Int }> = #[{ key: 1, value: 2 }]\n",
  );
  lays_out(b"fn f() -> Map<Int, Int> = #{}\n", b"fn f() -> Map<Int, Int> = #{}\n");
  lays_out(
    b"fn f() -> Map<Int, Int> = Map::of_entries([{key: 1, value: 2}])\n",
    b"fn f() -> Map<Int, Int> = Map::of_entries([{ key: 1, value: 2 }])\n",
  )
}

test "a map literal too long for its line breaks one entry a line" {
  let source = b"fn f() -> Map<String, Int> = #{\"alpha\": 1, \"beta\": 2, \"gamma\": 3, \"delta\": 4, \"epsilon\": 5, \"zeta\": 6, \"eta\": 7, \"theta\": 8, \"iota\": 9}\n";
  let out = formatted(source);
  assert(out.index_of(b"#{\n") != None);
  assert(out.index_of(b"\"zeta\": 6,\n") != None);
  assert(stable(source));
  assert_eq(tree_of(out), tree_of(source))
}

test "the formatter separates or-pattern alternatives with ` | ` and keeps parentheses around a nested choice" {
  lays_out(
    b"fn f(n: Int) -> Int = match n { 1|2 -> 0, (3 | (4|5)) -> 1, _ -> 2 }\n",
    b"fn f(n: Int) -> Int = match n { 1 | 2 -> 0, 3 | (4 | 5) -> 1, _ -> 2 }\n",
  )
}

test "the formatter leaves byte literals such as `b' '` unchanged and removes the spaces around `..=` in ranges" {
  lays_out(
    b"fn f(c: Int) -> Int = match c { b' ' -> 0, b'0' ..= b'9' -> 1, - 5 ..= -1 -> 2, _ -> 3 }\n",
    b"fn f(c: Int) -> Int = match c { b' ' -> 0, b'0'..=b'9' -> 1, -5..=-1 -> 2, _ -> 3 }\n",
  );
  lays_out(
    b"fn f() -> List<Int> = [ b' ',b'\\'' , b'\\\\' ,b'\\x20' ]\n",
    b"fn f() -> List<Int> = [b' ', b'\\'', b'\\\\', b'\\x20']\n",
  );
  lays_out(
    b"fn f(b: U8) -> Int = match b { (0u8..=9u8) | 20u8 ..=29u8 -> 1, _ -> 0 }\n",
    b"fn f(b: U8) -> Int = match b { 0u8..=9u8 | 20u8..=29u8 -> 1, _ -> 0 }\n",
  )
}

test "the formatter prints wrapping and saturating operators as written, and calls like `wrap_add(a, b)` as calls" {
  lays_out(
    b"fn f(a: U32, b: U32) -> U32 = a+%b *% a -% b\n",
    b"fn f(a: U32, b: U32) -> U32 = a +% b *% a -% b\n",
  );
  lays_out(
    b"fn f(a: U8, b: U8) -> U8 = (a +| b) *| (a -| b)\n",
    b"fn f(a: U8, b: U8) -> U8 = (a +| b) *| (a -| b)\n",
  );
  lays_out(
    b"fn f(a: Int, b: Int) -> Int = wrap_add(a,b) +% saturating_mul(a, b)\n",
    b"fn f(a: Int, b: Int) -> Int = wrap_add(a, b) +% saturating_mul(a, b)\n",
  );
  lays_out(
    b"fn f(a: Int, b: Int) -> Int = (a +% b) -% (a -% b) + (a *% b)\n",
    b"fn f(a: Int, b: Int) -> Int = a +% b -% (a -% b) + a *% b\n",
  )
}

test "a wrapping operator parses with the same precedence as `+` or `*`, giving the same tree as a call to `wrap_add`" {
  let body = |text: Bytes|
    tree_of(Bytes::concat_all([b"fn f(a: Int, b: Int, c: Int) -> Int = ", text]));
  let same = |written: Bytes, call: Bytes| body(written) == body(call);
  assert(same(b"a +% b *% c", b"wrap_add(a, wrap_mul(b, c))"));
  assert(same(b"a *| b +| c", b"saturating_add(saturating_mul(a, b), c)"));
  assert(same(b"a -% b -% c", b"wrap_sub(wrap_sub(a, b), c)"));
  assert(same(b"a +% b * c", b"wrap_add(a, b * c)"));
  assert(same(b"a * b -| c", b"saturating_sub(a * b, c)"));
  assert(same(b"a & b +% c << 1", b"a & wrap_add(b, c) << 1"));
  assert(same(b"-a *% b", b"wrap_mul(-a, b)"))
}

test "a short `let ... else` stays on one line, and a longer one puts the `else` body in a block" {
  lays_out(
    b"fn f(o: Option<Int>) -> Int = { let Some(v) = o else {0}; v }\n",
    b"fn f(o: Option<Int>) -> Int = {\n  let Some(v) = o else { 0 };\n  v\n}\n",
  );
  lays_out(
    b"fn f(o: Option<Int>) -> Int = { let Some(v) = o else { let w = 1; w }; v }\n",
    b"fn f(o: Option<Int>) -> Int = {\n  let Some(v) = o else {\n    let w = 1;\n    w\n  };\n  v\n}\n",
  )
}

test "a block puts each statement on its own line and collapses several blank lines between statements to one" {
  let source = b"fn f() -> Int = { let x = 1;\n\n\n  let y = 2; x + y }\n";
  assert_eq(formatted(source), b"fn f() -> Int = {\n  let x = 1;\n\n  let y = 2;\n  x + y\n}\n");
  assert(stable(source))
}

test "comments between match arms and at the end of the file keep their place" {
  let source = b"fn f(x: Option<Int>) -> Int =\n  match x {\n    // none\n    None -> 0,\n    Some(n) -> n, // some\n  }\n// end\n";
  assert_eq(
    formatted(source),
    b"fn f(x: Option<Int>) -> Int =\n  match x {\n    // none\n    None -> 0,\n    Some(n) -> n,  // some\n  }\n// end\n",
  );
  assert(stable(source))
}

test "a call past the width breaks one argument per line, and a lambda hugs the parentheses" {
  let long = b"fn f() -> Int = some_function(first_argument_value, second_argument_value, third_argument_value, fourth, fifth_argument_value)\n";
  assert_eq(
    formatted(long),
    b"fn f() -> Int =\n  some_function(\n    first_argument_value,\n    second_argument_value,\n    third_argument_value,\n    fourth,\n    fifth_argument_value,\n  )\n",
  );
  let hug = b"fn g(xs: List<Int>) -> Int = xs.fold(0, |acc: Int, x: Int| if x > acc { acc + x * x * x * x * x * x * x * x * x * x } else { acc - x })\n";
  assert_eq(
    formatted(hug),
    b"fn g(xs: List<Int>) -> Int =\n  xs.fold(0, |acc: Int, x: Int|\n    if x > acc { acc + x * x * x * x * x * x * x * x * x * x } else { acc - x })\n",
  );
  assert(stable(long));
  assert(stable(hug))
}

test "a nested `||` and `&&` chain too wide for the line puts each broken-off line at the same indentation" {
  let source = b"fn ordered(a: Int, b: Int, c: Int) -> Bool =\n  first_reading(a, b) || ".concat(
    b"(second_reading(a, b) && (third_reading(b, c) || (fourth_reading(b, c) && fifth_reading(a, c))))\n",
  );
  assert_eq(
    formatted(source),
    b"fn ordered(a: Int, b: Int, c: Int) -> Bool =\n  first_reading(a, b)\n    || (second_reading(a, b)\n".concat(
      b"    && (third_reading(b, c) || (fourth_reading(b, c) && fifth_reading(a, c))))\n",
    ),
  );
  assert(stable(source))
}

test "the formatter adds parentheses around `&&` inside `||`, and around a `match` operand, wherever an operator is beside them" {
  let source = b"fn holds(x: Option<Int>, n: Int) -> Bool =\n".concat(
    b"  n > 0 || n < 0 && match x { Some(k) -> k > n, None -> false }\n",
  );
  assert_eq(
    formatted(source),
    b"fn holds(x: Option<Int>, n: Int) -> Bool =\n".concat(
      b"  n > 0 || (n < 0 && (match x { Some(k) -> k > n, None -> false }))\n",
    ),
  );
  assert_eq(
    formatted(b"fn kept(n: Int) -> Bool = !(n > 0) && n + 1 > 0 || n == 0\n"),
    b"fn kept(n: Int) -> Bool = (!(n > 0) && n + 1 > 0) || n == 0\n",
  );
  assert(stable(source))
}

test "an `if` chain wider than the line puts each branch on its own line, with the body on that line if it fits" {
  let source = b"fn pick(n: Int) -> Bytes =\n  if n == 0 { b\"zero\" } else if n == 1 { b\"one\" } ".concat(
    b"else if n == 2 { b\"two\" } else if n == 3 { b\"three\" } else { b\"many\" }\n",
  );
  assert_eq(
    formatted(source),
    b"fn pick(n: Int) -> Bytes =\n  if n == 0 { b\"zero\" }\n  else if n == 1 { b\"one\" }\n".concat(
      b"  else if n == 2 { b\"two\" }\n  else if n == 3 { b\"three\" }\n  else { b\"many\" }\n",
    ),
  );
  assert(stable(source));
  let wide = b"fn pick(n: Int, xs: List<Int>) -> Bytes =\n  if n == 0 { b\"zero\" } else if n == 1 { b\"one\" } ".concat(
    b"else if n == 2 { let m = xs.fold(0, |acc: Int, x: Int| acc + x); b\"two\" } else { b\"many\" }\n",
  );
  assert_eq(
    formatted(wide),
    Bytes::concat_all([
      b"fn pick(n: Int, xs: List<Int>) -> Bytes =\n  if n == 0 { b\"zero\" }\n",
      b"  else if n == 1 { b\"one\" } else if n == 2 {\n",
      b"    let m = xs.fold(0, |acc: Int, x: Int| acc + x);\n    b\"two\"\n",
      b"  } else { b\"many\" }\n",
    ]),
  );
  assert(stable(wide))
}

test "a comment written above an `else` stays on its own line above it" {
  let source = b"fn pick(n: Int) -> Bytes =\n  if n == 0 { b\"zero\" }\n  else if n == 1 { b\"one\" }\n".concat(
    b"  // the rest are the same\n  else { b\"many\" }\n",
  );
  assert_eq(formatted(source), source);
  assert(stable(source))
}

test "an `if` chain past the width breaks into branches before any condition in it breaks" {
  lays_out(
    Bytes::concat_all([
      b"fn request_line(line: Bytes) -> Parsed = {\n",
      b"  let len = Bytes::len(line);\n",
      b"  let sp1 = index_of(line, b\" \", 0);\n",
      b"  if sp1 >= len { Malformed(\"a request line is `METHOD TARGET VERSION`\") } else {\n",
      b"    let sp2 = index_of(line, b\" \", sp1 + 1);\n",
      b"    if sp2 >= len { Malformed(\"a request line is `METHOD TARGET VERSION`\") } else if index_of(\n",
      b"          line,\n",
      b"          b\" \",\n",
      b"          sp2 + 1,\n",
      b"        )\n",
      b"        < len { Malformed(\"a request line may contain no more than two spaces\") } else {\n",
      b"      parts(\n",
      b"        Bytes::slice(line, 0, sp1),\n",
      b"        Bytes::slice(line, sp1 + 1, sp2),\n",
      b"        Bytes::slice(line, sp2 + 1, len),\n",
      b"      )\n",
      b"    }\n",
      b"  }\n",
      b"}\n",
    ]),
    Bytes::concat_all([
      b"fn request_line(line: Bytes) -> Parsed = {\n",
      b"  let len = Bytes::len(line);\n",
      b"  let sp1 = index_of(line, b\" \", 0);\n",
      b"  if sp1 >= len { Malformed(\"a request line is `METHOD TARGET VERSION`\") } else {\n",
      b"    let sp2 = index_of(line, b\" \", sp1 + 1);\n",
      b"    if sp2 >= len { Malformed(\"a request line is `METHOD TARGET VERSION`\") }\n",
      b"    else if index_of(line, b\" \", sp2 + 1) < len {\n",
      b"      Malformed(\"a request line may contain no more than two spaces\")\n",
      b"    } else {\n",
      b"      parts(\n",
      b"        Bytes::slice(line, 0, sp1),\n",
      b"        Bytes::slice(line, sp1 + 1, sp2),\n",
      b"        Bytes::slice(line, sp2 + 1, len),\n",
      b"      )\n",
      b"    }\n",
      b"  }\n",
      b"}\n",
    ]),
  )
}

test "a long `else if` condition breaks into indented lines only when the condition does not fit on the `else if` line" {
  lays_out(
    b"fn f(a: Int, b: Int) -> Int = if a == 0 { 1 } else if some_long_condition_name(a, b) ".concat(
      b"&& another_long_condition_name(a, b) && third_condition_name(a, b) && fourth_condition(a) { 2 } else { 3 }\n",
    ),
    Bytes::concat_all([
      b"fn f(a: Int, b: Int) -> Int =\n",
      b"  if a == 0 { 1 }\n",
      b"  else if some_long_condition_name(a, b) && another_long_condition_name(a, b)\n",
      b"      && third_condition_name(a, b)\n",
      b"      && fourth_condition(a) { 2 }\n",
      b"  else { 3 }\n",
    ]),
  )
}

test "an `if` with a long condition and no `else if` puts its body on the last line of the condition" {
  lays_out(
    b"fn f(a: Int, b: Int) -> Int = if some_long_condition_name(a, b) ".concat(
      b"&& another_long_condition_name(a, b) && third_one(a) { 1 } else { 2 }\n",
    ),
    Bytes::concat_all([
      b"fn f(a: Int, b: Int) -> Int =\n",
      b"  if some_long_condition_name(a, b) && another_long_condition_name(a, b) && third_one(a) { 1 }\n",
      b"  else { 2 }\n",
    ]),
  );
  lays_out(
    b"fn g(a: Int, b: Int) -> Int = if some_long_condition_name(a, b) ".concat(
      b"&& another_long_condition_name(a, b) && third_condition_name(a, b) && fourth(a) { 1 } else { 2 }\n",
    ),
    Bytes::concat_all([
      b"fn g(a: Int, b: Int) -> Int =\n",
      b"  if some_long_condition_name(a, b) && another_long_condition_name(a, b)\n",
      b"      && third_condition_name(a, b)\n",
      b"      && fourth(a) { 1 }\n",
      b"  else { 2 }\n",
    ]),
  )
}

test "a chain in a `let`, a match arm or a call argument puts each `else` where the chain's line began" {
  let chain = b"if a == 0 { first(a, b) } else if some_long_condition_name(a, b) ".concat(
    b"&& another_long_condition_name(a, b) { second_value_with_a_longer_name(a, b) } else { third(a, b) }",
  );
  lays_out(
    Bytes::concat_all([b"fn f(a: Int, b: Int) -> Int = { let x = ", chain, b"; x }\n"]),
    Bytes::concat_all([
      b"fn f(a: Int, b: Int) -> Int = {\n",
      b"  let x = if a == 0 { first(a, b) }\n",
      b"  else if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"    second_value_with_a_longer_name(a, b)\n",
      b"  } else { third(a, b) };\n",
      b"  x\n",
      b"}\n",
    ]),
  );
  lays_out(
    Bytes::concat_all([
      b"fn g(o: Option<Int>, b: Int) -> Int = match o { Some(a) -> ",
      chain,
      b", None -> 0 }\n",
    ]),
    Bytes::concat_all([
      b"fn g(o: Option<Int>, b: Int) -> Int =\n",
      b"  match o {\n",
      b"    Some(a) -> if a == 0 { first(a, b) }\n",
      b"    else if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"      second_value_with_a_longer_name(a, b)\n",
      b"    } else { third(a, b) },\n",
      b"    None -> 0,\n",
      b"  }\n",
    ]),
  );
  lays_out(
    Bytes::concat_all([b"fn h(a: Int, b: Int) -> Int = combine(a, ", chain, b")\n"]),
    Bytes::concat_all([
      b"fn h(a: Int, b: Int) -> Int =\n",
      b"  combine(a, if a == 0 { first(a, b) }\n",
      b"  else if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"    second_value_with_a_longer_name(a, b)\n",
      b"  } else { third(a, b) })\n",
    ]),
  );
  lays_out(
    Bytes::concat_all([b"fn k(a: Int, b: Int) -> Int = combine(", chain, b", a)\n"]),
    Bytes::concat_all([
      b"fn k(a: Int, b: Int) -> Int =\n",
      b"  combine(\n",
      b"    if a == 0 { first(a, b) }\n",
      b"    else if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"      second_value_with_a_longer_name(a, b)\n",
      b"    } else { third(a, b) },\n",
      b"    a,\n",
      b"  )\n",
    ]),
  )
}

test "an `else` with no room before the block it opens takes a line of its own" {
  lays_out(
    b"fn pick(n: Int) -> Bytes = if n == 0 { b\"a body long enough that the else and its brace ".concat(
      b"no longer fit on its one line\" } else { let m = n * 2; num(m) }\n",
    ),
    Bytes::concat_all([
      b"fn pick(n: Int) -> Bytes =\n",
      b"  if n == 0 { b\"a body long enough that the else and its brace no longer fit on its one line\" }\n",
      b"  else {\n",
      b"    let m = n * 2;\n",
      b"    num(m)\n",
      b"  }\n",
    ]),
  )
}

test "an `if` chain's last branch stays on the `if` line only when the code after the chain also fits on that line" {
  lays_out(
    b"fn f(a: Int, b: Int) -> Unit = { if some_long_condition_name(a, b) ".concat(
      b"&& another_long_condition_name(a, b) { note(a, b, 12345678901) }; done(a) }\n",
    ),
    Bytes::concat_all([
      b"fn f(a: Int, b: Int) -> Unit = {\n",
      b"  if some_long_condition_name(a, b) && another_long_condition_name(a, b) {\n",
      b"    note(a, b, 12345678901)\n",
      b"  };\n",
      b"  done(a)\n",
      b"}\n",
    ]),
  );
  lays_out(
    b"fn g(a: Int, b: Int) -> Int = { let x = if a > b { a } else { combine(first_argument_name, ".concat(
      b"second_argument_name, third_argument_name, fourth_arguments) }; x }\n",
    ),
    Bytes::concat_all([
      b"fn g(a: Int, b: Int) -> Int = {\n",
      b"  let x = if a > b { a } else {\n",
      b"    combine(first_argument_name, second_argument_name, third_argument_name, fourth_arguments)\n",
      b"  };\n",
      b"  x\n",
      b"}\n",
    ]),
  )
}

test "a multi-line `\\` string starts on its own line, and the code after it starts on the following line" {
  lays_out(
    b"fn f() -> String = { let s = \\\\one\n      \\\\two\n; s }\n",
    b"fn f() -> String = {\n  let s =\n    \\\\one\n    \\\\two\n  ;\n  s\n}\n",
  );
  lays_out(
    b"fn f() -> String = \\\\say \"hi\" \\\\here\n\nfn g() -> String = \"a\\nb\"\n",
    b"fn f() -> String =\n  \\\\say \"hi\" \\\\here\n\nfn g() -> String = \"a\\nb\"\n",
  )
}

test "a multi-line `\\` string that is the last item of a list, call or record gets no trailing comma, but a comma follows one that is not last" {
  lays_out(
    b"fn f() -> Unit = assert_eq(g(), \\\\a\n  \\\\b\n)\n",
    b"fn f() -> Unit =\n  assert_eq(\n    g(),\n    \\\\a\n    \\\\b\n  )\n",
  );
  lays_out(
    b"fn f() -> { path: String, text: String } = { path: \"m.ply\", text: \\\\one\n}\n",
    b"fn f() -> { path: String, text: String } =\n  {\n    path: \"m.ply\",\n    text:\n      \\\\one\n  }\n",
  );
  lays_out(
    b"fn f() -> List<String> = [\\\\a\n, \\\\b\n]\n",
    b"fn f() -> List<String> =\n  [\n    \\\\a\n    ,\n    \\\\b\n  ]\n",
  )
}

test "a `const` lays out as a name, a type and a value" {
  lays_out(b"const   limit :Int=40\n", b"const limit: Int = 40\n");
  lays_out(b"pub const limit: Int = 40\n", b"pub const limit: Int = 40\n");
  lays_out(
    b"/// The most.\nconst limit: Int = { 40 }\n",
    b"/// The most.\nconst limit: Int = { 40 }\n",
  )
}

test "every item kind prints back to the same tree" {
  let source = Bytes::concat_all([
    b"import std.json\nimport a.b as c\nimport spine (Span, Ident)\n",
    b"pub const limit: Int = 40\n",
    b"pub type Shape = | Circle(Int) | Rect(Int, Int) | Point\n",
    b"type P = { x: Int, y: Int }\n",
    b"pub effect db {\n  read get[r](key: Int) -> Option<Int>\n  write put(Int, Int) -> Unit\n}\n",
    b"nondet effect clock { read now() -> Int }\n",
    b"effect set Persist = {db.read[users], Other, db.write[users]}\n",
    b"pub reuse fn f<a | e>(x: a, g: (a) -> a / e, n: Int = 1) -> a / {db.read[users] | e} where derivable(hash, a) requires n > 0 ensures true = g(x)\n",
    b"fn h(t: (Int, Bool)) -> (Bool, Int) = match t { (n, b) -> (b, n) }\n",
    b"pub transparent fn k(x: Int) -> Int = x\n",
    b"transparent reuse fn q(xs: List<Int>) -> List<Int> = xs\n",
    b"pub const fn table() -> List<Int> = [1, 2]\n",
    b"fn r(xs: List<Int>, n: Int) -> List<Int>\n  returns xs\n  requires n > 0\n= xs\n",
    b"fn s() -> List<Int>\n  returns fresh\n= []\n",
    b"derive json for P\n",
    b"test/nondet \"t\" { assert(true) }\n",
    b"law \"l\" forall (n: Int) where n > 0 { n == n }\n",
    b"law \"m\" { true }\n",
  ]);
  assert(stable(source));
  assert(String::of_bytes(formatted(source)).contains("read get[r](key: Int) -> Option<Int>"))
}

test "a `new` record prints `new` before its fields, one to a line where they do not fit" {
  lays_out(
    b"pub   type Date=new{year:Int,month:Int}\n",
    b"pub type Date = new { year: Int, month: Int }\n",
  );
  lays_out(
    b"type Pair<a> = new { the_first_of_the_two_values_it_holds: a, the_second_of_the_two_values_it_holds: a }\n",
    b"type Pair<a> = new {\n  the_first_of_the_two_values_it_holds: a,\n  the_second_of_the_two_values_it_holds: a,\n}\n",
  )
}

test "a `where` prints the type variables it constrains before its guard" {
  lays_out(
    b"law \"l\" forall (xs: List<a>)   where identity( a ) {reverse(reverse(xs))==xs}\n",
    b"law \"l\" forall (xs: List<a>) where identity(a) { reverse(reverse(xs)) == xs }\n",
  );
  lays_out(
    b"law \"l\" forall (xs: List<a>, n: Int) where identity(a),n>0 { xs.len() + n > 0 }\n",
    b"law \"l\" forall (xs: List<a>, n: Int) where identity(a), n > 0 { xs.len() + n > 0 }\n",
  );
  lays_out(
    b"law schema s<a,b>(f: (a)->b) forall (x: a) where identity(a),identity(b) { f(x)==f(x) }\n",
    b"law schema s<a, b>(f: (a) -> b) forall (x: a) where identity(a), identity(b) { f(x) == f(x) }\n",
  );
  let long = b"pub law schema round_trip<a, b | e>(encode: (a) -> b / e, decode: (b) -> Option<a> / e) forall (x: a) where identity(a), x == x && decode(encode(x)) != None { decode(encode(x)) == Some(x) }\n";
  assert(stable(long));
  assert(formatted(long).contains(b"where identity(a), x == x"));
  let unguarded = b"pub law schema round_trip<a, b | e>(encode: (a) -> b / e, decode: (b) -> Option<a> / e) forall (x: a) where identity(a) { decode(encode(x)) == Some(x) }\n";
  assert(stable(unguarded));
  assert(formatted(unguarded).contains(b"forall (x: a) where identity(a) {"))
}

test "a `law schema` formats its parameter list like a `fn`, and a `law` that calls a schema moves the call to its own indented line when too wide" {
  lays_out(
    b"pub  law schema  s<a>(f: (a)->a)   forall (x: a) where x==x { f(x)==x }\n",
    b"pub law schema s<a>(f: (a) -> a) forall (x: a) where x == x { f(x) == x }\n",
  );
  lays_out(b"law schema g(f: ()->Bool) { f() }\n", b"law schema g(f: () -> Bool) { f() }\n");
  lays_out(
    b"law schema h<a|e>(f: (a)->a/e) forall (x: a) { f(f(x))==f(x) }\n",
    b"law schema h<a | e>(f: (a) -> a / e) forall (x: a) { f(f(x)) == f(x) }\n",
  );
  lays_out(
    b"law schema round_trip<a, b>(encode: (a) -> b / {abort.raise}, decode: (b) -> Option<a> / {abort.raise}) forall (x: a) { decode(encode(x)) == Some(x) }\n",
    b"law schema round_trip<a, b>(\n  encode: (a) -> b / {abort.raise},\n  decode: (b) -> Option<a> / {abort.raise},\n)\n  forall (x: a) {\n    decode(encode(x)) == Some(x)\n  }\n",
  );
  lays_out(b"law \"l\"   =  m::s( f,1 )\n", b"law \"l\" = m::s(f, 1)\n");
  lays_out(
    b"law \"`query_parse` of `query_build` of a list of pairs returns the same pairs, in the order it names them\" = round_trip(query_build, query_parse)\n",
    b"law \"`query_parse` of `query_build` of a list of pairs returns the same pairs, in the order it names them\" =\n  round_trip(query_build, query_parse)\n",
  )
}

test "a function parameter marked `keep` prints `keep` before its type" {
  lays_out(
    b"fn hold(f:  keep (Int) -> Int) -> Int = 0\n",
    b"fn hold(f: keep (Int) -> Int) -> Int = 0\n",
  )
}

test "a function parameter's cost name prints after its type" {
  lays_out(
    b"fn f<| e>(xs: List<Int>,  g: (Int) -> Int / e cost  k) -> Int / e cost xs.len()*k = 0\n",
    b"fn f<| e>(xs: List<Int>, g: (Int) -> Int / e cost k) -> Int / e\n  cost xs.len() * k\n= 0\n",
  )
}

test "a function parameter's space name prints after its type and cost name" {
  lays_out(
    b"fn f<| e>(xs: List<Int>,  g: (Int) -> List<Int> / e cost  k space  s) -> List<List<Int>> / e space xs.len()+xs.len()*s = []\n",
    b"fn f<| e>(xs: List<Int>, g: (Int) -> List<Int> / e cost k space s) -> List<List<Int>> / e\n  space xs.len() + xs.len() * s\n= []\n",
  );
  let alone = b"fn f(g: (Int) -> Int space s) -> Int\n  space s\n= 0\n";
  assert_eq(formatted(alone), alone)
}

test "a `cost` clause prints on its own line among the spec clauses, in the order written" {
  lays_out(
    b"fn f(xs: List<Int>,  ys: List<Int>) -> Int requires xs.len() > 0 cost xs.len()*(ys.len()+1) = xs.len()\n",
    b"fn f(xs: List<Int>, ys: List<Int>) -> Int\n  requires xs.len() > 0\n  cost xs.len() * (ys.len() + 1)\n= xs.len()\n",
  )
}

test "an operation's type parameters print between its resource and its parameters" {
  let source = b"effect box {\n  read take[k]<a>() -> a\n  write put<a, b>(x: a, y: b) -> Unit\n}\n";
  assert_eq(formatted(source), source)
}

test "a `raise` operation prints its name and parameters, and no result" {
  lays_out(
    b"effect toml {\n  raise   syntax(e: SyntaxError)\n  raise eof( )\n  read peek() -> Int\n}\n",
    b"effect toml {\n  raise syntax(e: SyntaxError)\n  raise eof()\n  read peek() -> Int\n}\n",
  )
}

test "a `try` keeps its optional `[...]` effect name, needs no parentheses after `match`, and gets parentheses as an operand of `==`" {
  lays_out(
    b"fn f(b: Int) -> Result<Int, Int> = try   { digit(b) }\n",
    b"fn f(b: Int) -> Result<Int, Int> = try { digit(b) }\n",
  );
  lays_out(
    b"fn f(b: Int) -> Result<Int, Int> = try[ m::toml.syntax ]\n  { digit(b) }\n",
    b"fn f(b: Int) -> Result<Int, Int> = try[m::toml.syntax] { digit(b) }\n",
  );
  let scrutinee = b"fn f(b: Int) -> Int = match try { digit(b) } { Ok(v) -> v, Err(e) -> e }\n";
  assert_eq(formatted(scrutinee), scrutinee);
  let operand = b"fn f(b: Int) -> Bool = (try { digit(b) }) == Ok(1)\n";
  assert_eq(formatted(operand), operand);
  let long = Bytes::concat_all([
    b"fn f(b: Int) -> Result<Int, Int> = try[toml.syntax] { let first = digit(b); ",
    b"let second = digit(b + 1); let third = digit(b + 2); first + second + third }\n",
  ]);
  assert(stable(long));
  assert(String::of_bytes(formatted(long)).contains("\n  try[toml.syntax] {\n"))
}

test "the formatter keeps operation names in effect lists such as `db.get[users]`, and formats `let x = handle {...} with {...}` without changes" {
  let source = Bytes::concat_all([
    b"effect db {\n  read get[r](key: Int) -> Int\n  write begin() -> Unit\n}\n",
    b"effect set Tx = {db.begin, db.get[users]}\n",
    b"fn f(k: Int) -> Int / {db.get[users], db.begin, db.write} = { db.begin(); db.get[users](k) }\n",
    b"fn g(k: Int) -> Int = {\n  let tried = handle {\n    f(k)\n  } with {\n    db.get[users](n) -> n,\n  };\n  match tried {\n    0 -> 1,\n    n -> n,\n  }\n}\n",
  ]);
  assert(stable(source));
  assert(String::of_bytes(formatted(source)).contains("/ {db.get[users], db.begin, db.write}"));
  assert(String::of_bytes(formatted(source)).contains("{db.begin, db.get[users]}"))
}

test "a label parameter prints as `[l]` among a `fn`'s type parameters, and a call prints its label arguments as `[conn]` after the name" {
  let source = Bytes::concat_all([
    b"fn relay<[l]>(c: Int) -> Unit / {net.send[l]} = ()\n",
    b"fn g<a, [l], [k] | e>(x: a) -> a / e = x\n",
    b"fn h(c: Int) -> Unit / {net.send[conn]} = relay[conn](c)\n",
    b"fn k(c: Int) -> Unit = pair[a, b](c)\n",
  ]);
  assert_eq(formatted(source), source)
}

test "a `type` prints label parameters `[l]` and an effect variable `| e` like a `fn` does, and uses of the type print arguments in the declared order" {
  let source = Bytes::concat_all([
    b"type Step<a | e> = () -> Option<{ value: a, next: Seq<a | e> }> / e\n\n",
    b"type Seq<a | e> = | Seq(Step<a | e>)\n\n",
    b"pub type Sink<a, [l], [k] | e, f> = | Sink((a) -> Unit / {net.send[l] | e}) | Quiet\n\n",
    b"fn held(s: Sink<Int, [conn], [peer] | {}, {log.write | e}>) -> m::Seq<Int | {| e}> = s\n",
  ]);
  assert_eq(formatted(source), source);
  lays_out(
    b"type T< [l,k] ,a|e > = U<[ l ],a , [k]|e,{ }>\n",
    b"type T<a, [l], [k] | e> = U<a, [l], [k] | e, {}>\n",
  )
}

test "a `handle`, a `match` or an `if` may stand as a scrutinee" {
  let handle_scrutinee = b"fn f(k: Int) -> Int = match handle { g(k) } with { db.get(n) -> n } { 0 -> 1, n -> n }\n";
  assert_eq(formatted(handle_scrutinee), handle_scrutinee);
  let nested = b"fn f(x: Int) -> Int = if match x { 0 -> true, _ -> false } { 1 } else { 2 }\n";
  assert_eq(formatted(nested), nested);
  let broken_up = Bytes::concat_all([
    b"fn f(k: Int) -> Int = match handle { some_call(k) } with ",
    b"{ db.get[users](n) resume q -> q(n), db.put[users](n) -> n + 1 } { 0 -> 1, n -> n }\n",
  ]);
  assert(stable(broken_up));
  assert(String::of_bytes(formatted(broken_up)).contains("match handle {"))
}

test "every expression kind prints back to the same tree" {
  let source = Bytes::concat_all([
    b"fn f(r: {a: Int, b: Int}) -> Int = {\n",
    b"  let {a, b} = r;\n",
    b"  let s = {..r, a: 2};\n",
    b"  let t = (a, b);\n",
    b"  let u = if a > 0 && !(b < 0) { -a } else if a == 0 { ~b } else { (a - b) - (a + b) * 2 };\n",
    b"  let v = [1, 2.5, 1.50m, \"s\\n\", b\"\\x00\", true, ()];\n",
    b"  let w = |x, y: Int| -> Int { x + y };\n",
    b"  let z = (r.a)(1)? + m::g(1, k: 2);\n",
    b"  let c = handle { db.get[users](1) } with { db.get[users](k) resume q -> q(Some(k)), return x -> x };\n",
    b"  let g = handle { db.get[users](1) } with { var n = 0, var seen: List<Int> = [], db.get[users](k) -> { if k > n { n = k } else { seen = seen.push(k) }; n }, return x -> x + n };\n",
    b"  let o = with_scope[file](opened(a), |x: Int| closed(x)) { h -> { used(h); h.get() } };\n",
    b"  simulate { a };\n",
    b"  let e = parallel { a + 1, b };\n",
    b"  match [a, b] { [x, ..rest] if x > 0 -> x, [..] -> 0 }\n",
    b"}\n",
  ]);
  assert(stable(source))
}

test "number and byte literals print as written, and a literal in parentheses prints without them" {
  let source = b"fn f() -> Int = 0xFF_FF + 1_000 + (7)\nfn g() -> Float = 1.50e-3\nfn h() -> Bytes = b\"a\\x0d\"\n";
  assert_eq(
    formatted(source),
    b"fn f() -> Int = 0xFF_FF + 1_000 + 7\nfn g() -> Float = 1.50e-3\nfn h() -> Bytes = b\"a\\x0d\"\n",
  );
  assert(stable(source))
}

test "an interpolated string prints its text as written and each `{...}` expression on one line" {
  let source = b"fn h(x: Int) -> String =   f\"x = {x   +   1} {{y}} \\n {f\"in {x}\"}\"\nfn k(a: Int, b: Int) -> String = f\"{a}\" ++ f\"{b}\"\n";
  assert_eq(
    formatted(source),
    b"fn h(x: Int) -> String = f\"x = {x + 1} {{y}} \\n {f\"in {x}\"}\"\nfn k(a: Int, b: Int) -> String = f\"{a}\" ++ f\"{b}\"\n",
  );
  assert(stable(source))
}

test "an interpolated string inside parentheses is still one, and loses only the parentheses" {
  lays_out(
    b"fn h(x: Int) -> String = (f\"a {x + 1}\")\n",
    b"fn h(x: Int) -> String = f\"a {x + 1}\"\n",
  );
  lays_out(
    b"fn h(x: Int) -> String = (f\"b {x}\") ++ ( ( f\"{x}\" ) )\n",
    b"fn h(x: Int) -> String = f\"b {x}\" ++ f\"{x}\"\n",
  )
}

test "the formatter adds parentheses around an `if` or `match` condition that has a record literal after its first operand, as it does when the record comes first" {
  lays_out(
    b"fn f(x: Int) -> Int = if (x + { a: x }.a) > 0 { 1 } else { 2 }\n",
    b"fn f(x: Int) -> Int = if (x + { a: x }.a > 0) { 1 } else { 2 }\n",
  );
  lays_out(
    b"fn f(x: Int) -> Int = match -({ a: x }.a) { 0 -> 1, _ -> 2 }\n",
    b"fn f(x: Int) -> Int = match (-{ a: x }.a) { 0 -> 1, _ -> 2 }\n",
  );
  lays_out(
    b"fn f(x: Int) -> Bool = if x == (1, 2)._0 { true } else { false }\n",
    b"fn f(x: Int) -> Bool = if x == (1, 2)._0 { true } else { false }\n",
  )
}

test "a source file whose last line has no final line break prints with one" {
  lays_out(b"fn f(x: Int) -> Int = x", b"fn f(x: Int) -> Int = x\n")
}

test "a tagged literal prints as written, with its tag directly before the opening quote" {
  let source = b"fn f() -> Int =   List::len((hex\"de\\u{61}d\").nibbles)   +   [ uuid\"\" ].len()\n";
  assert_eq(
    formatted(source),
    b"fn f() -> Int = List::len(hex\"de\\u{61}d\".nibbles) + [uuid\"\"].len()\n",
  );
  assert(stable(source))
}

test "a tagged literal prints its text as written and each `{...}` expression on one line" {
  let source = b"fn f(x: Int) -> Int =   sh\"a {{b}} \\n {x   +   1}{ sh\"in {x}\" } z\"\n";
  assert_eq(
    formatted(source),
    b"fn f(x: Int) -> Int = sh\"a {{b}} \\n {x + 1}{sh\"in {x}\"} z\"\n",
  );
  assert(stable(source));
  let braced = b"fn g() -> Int = sh\"{ {n: 1}.n }{  {n: 2}  }\" + List::len(f\"{ {n: 3}.n } { {n: 4} }\")\n";
  assert_eq(
    formatted(braced),
    b"fn g() -> Int = sh\"{ { n: 1 }.n }{ { n: 2 } }\" + List::len(f\"{ { n: 3 }.n } { { n: 4 } }\")\n",
  );
  assert(stable(braced))
}

test "a file that does not parse is rejected with the first diagnostic, and never rewritten" {
  match fmt_source(b"fn f( = 1\n") {
    Ok(_) -> assert(false),
    Err(e) -> assert(e.starts_with(b"1:")),
  }
}

test "a comment between `=` or `->` and a `match`, `if` or block body stays on its own line" {
  let source = b"fn f(x: Int) -> Int = {\n  let y =\n    // why\n    match x { 1 -> 2, _ -> 3 };\n".concat(
    b"  match y {\n    2 ->\n      // because\n      if y > 1 { 1 } else { 0 },\n    _ -> 0,\n  }\n}\n",
  );
  let out = formatted(source);
  assert(out.index_of(b"// why") != None);
  assert(out.index_of(b"// because") != None);
  assert(stable(source));
  let header = b"fn g() -> Int // c\n  = { let z = 1; z }\n";
  assert(formatted(header).index_of(b"// c") != None);
  assert(stable(header))
}

test "specification clauses go on their own lines before the body" {
  let source = b"fn f(n: Int) -> Int requires n > 0 ensures result > n = n + 1\n";
  assert_eq(
    formatted(source),
    b"fn f(n: Int) -> Int\n  requires n > 0\n  ensures result > n\n= n + 1\n",
  );
  assert(stable(source));
  let measured = b"fn g(n: Int) -> Int decreases n = if n <= 1 { 0 } else { g(n / 2) }\n";
  assert_eq(
    formatted(measured),
    b"fn g(n: Int) -> Int\n  decreases n\n= if n <= 1 { 0 } else { g(n / 2) }\n",
  );
  assert(stable(measured));
  let parenthesized_clauses = b"fn h(p: P) -> Int requires (p == { a: 1 }) decreases (1 + { a: 1 }.a) = p.a\n";
  assert_eq(
    formatted(parenthesized_clauses),
    b"fn h(p: P) -> Int\n  requires p == { a: 1 }\n  decreases 1 + { a: 1 }.a\n= p.a\n",
  );
  assert(stable(parenthesized_clauses))
}

test "the formatter keeps parentheses around a `where` guard or a `test ... for` case list that contains a `{` record, so the following block is not misread" {
  let guarded = b"law \"l\" forall (p: P) where (p == { a: 1 }) { same(p) }\n";
  lays_out(guarded, guarded);
  let schema = b"law schema s(f: (P) -> Bool) forall (p: P) where (p == { a: 1 }) { f(p) }\n";
  lays_out(schema, schema);
  let wide = b"law \"l\" forall (p: P) where (p == { a: 1111111111 } || p == { a: 2222222222 } || p == { a: 3333333333 } || p == { a: 4444444444 }) { same(p) }\n";
  assert(stable(wide));
  let table = b"test \"t\" for c: Int in (the_first_table_of_cases_under_a_long_name ++ { rows: [1111111111, 2222222222, 3333333333, 4444444444] }.rows) { assert(c > 0) }\n";
  assert(stable(table))
}

fn range_of(source: Bytes, name: Bytes) -> Bytes / {abort.raise} =
  match item_range(source, name) {
    Ok(r) -> source.slice(r.start, r.end),
    Err(e) -> panic(String::of_bytes(e)),
  }

test "the source range of an item includes its `pub`, its `reuse`, the comment lines above it and a comment at the end of its last line" {
  let source = Bytes::concat_all([
    b"import spine (Span)\n\n// first\npub fn a() -> Int = 1  // one\n\n",
    b"// doc for b\n// on two lines\npub reuse fn b(x: Int) -> Int = x\n",
    b"type T = { x: Int }\n\n// stray\n\neffect clock { read now() -> Int }\n",
  ]);
  assert_eq(range_of(source, b"a"), b"// first\npub fn a() -> Int = 1  // one\n");
  assert_eq(
    range_of(source, b"b"),
    b"// doc for b\n// on two lines\npub reuse fn b(x: Int) -> Int = x\n",
  );
  assert_eq(range_of(source, b"T"), b"type T = { x: Int }\n");
  assert_eq(range_of(source, b"clock"), b"effect clock { read now() -> Int }\n");
  let bare = b"fn a() -> Int = 1\nfn b() -> Int = 2";
  assert_eq(range_of(bare, b"a"), b"fn a() -> Int = 1\n");
  assert_eq(range_of(bare, b"b"), b"fn b() -> Int = 2")
}

test "the source range of an item starts at its `///` doc comment even when a blank line separates them in the input" {
  let source = b"fn a() -> Int = 1\n\n/// Two.\n\npub fn b() -> Int = 2\n";
  assert_eq(range_of(source, b"b"), b"/// Two.\n\npub fn b() -> Int = 2\n")
}

test "the formatter removes a blank line after a `///` doc comment so the doc sits directly above the item" {
  lays_out(
    b"/// The answer.\n\nfn f() -> Int = 42\n\n// --- next ---\n\n/// Another.\n///\n/// More.\nfn g() -> Int = 1\n",
    b"/// The answer.\nfn f() -> Int = 42\n\n// --- next ---\n\n/// Another.\n///\n/// More.\nfn g() -> Int = 1\n",
  );
  lays_out(b"//! The module.\n\nimport a\n", b"//! The module.\n\nimport a\n")
}

test "the docs of variants, fields and operations stay on the declarations they document" {
  let sources = [
    b"pub type T =\n  /// The first.\n  | A\n  /// The second.\n  | B(Int)\n",
    b"type R = {\n  /// Its size.\n  size: Int,\n\n  /// Its name.\n  name: String,\n}\n",
    b"effect log {\n  /// Writes a line.\n  write line(s: String) -> Unit\n\n  /// Counts.\n  read count() -> Int\n}\n",
  ];
  sources.fold((), |u: Unit, source: Bytes| {
    assert(stable(source));
    assert_eq(tree_of(formatted(source)), tree_of(source))
  })
}

test "an item that is absent, named twice, or in a text that does not parse is rejected" {
  assert_eq(
    item_range(b"fn a() -> Int = 1\n", b"b"),
    Err(b"no `fn`, `type` or `effect` is named `b`"),
  );
  assert_eq(item_range(b"fn a() -> Int = 1\nfn a() -> Int = 2\n", b"a"), Err(b"`a` names 2 items"));
  match item_range(b"fn a( = 1\n", b"a") {
    Ok(_) -> assert(false),
    Err(e) -> assert(e.starts_with(b"1:")),
  }
}

test "replacing an item rewrites only that item, formatted, and leaves every other byte of the file unchanged" {
  let source = b"// head\nfn a() -> Int = 1\n\n// doc\npub fn b(x: Int) -> Int = x   // keep\n\nfn c() -> Int = 3  // tail\n";
  assert_eq(
    replace_item(source, b"b", b"// new doc\npub fn   b(x: Int)->Int = x+1\n"),
    Ok(
      b"// head\nfn a() -> Int = 1\n\n// new doc\npub fn b(x: Int) -> Int = x + 1\n\nfn c() -> Int = 3  // tail\n",
    ),
  );
  assert_eq(
    replace_item(source, b"c", b"fn c() -> Int = 4"),
    Ok(
      b"// head\nfn a() -> Int = 1\n\n// doc\npub fn b(x: Int) -> Int = x   // keep\n\nfn c() -> Int = 4\n",
    ),
  )
}

test "replacing an item fails when the new text has another kind or name, contains more than one item, or does not parse" {
  let source = b"fn a() -> Int = 1\ntype T = Int\n";
  assert_eq(
    replace_item(source, b"a", b"fn c() -> Int = 1\n"),
    Err(b"the replacement defines `fn` `c`; expected `fn` `a`"),
  );
  assert_eq(
    replace_item(source, b"T", b"fn a() -> Int = 1\n"),
    Err(b"the replacement defines `fn` `a`; expected `type` `T`"),
  );
  assert_eq(
    replace_item(source, b"a", b"test \"t\" { assert(true) }\n"),
    Err(b"the replacement defines a `test`; expected `fn` `a`"),
  );
  assert_eq(
    replace_item(source, b"a", b"fn a() -> Int = 1\nfn b() -> Int = 2\n"),
    Err(b"the replacement contains 2 items; it must be one"),
  );
  assert_eq(
    replace_item(source, b"a", b"import std.json\nfn a() -> Int = 1\n"),
    Err(b"the replacement contains an import; it must be one item"),
  );
  match replace_item(source, b"a", b"fn a( = 1\n") {
    Ok(_) -> assert(false),
    Err(e) -> assert(e.starts_with(b"the replacement does not parse: 1:")),
  }
}

test "a short `parallel` stays on its line, and a long one puts each branch on its own" {
  assert_eq(
    formatted(b"fn f() -> (Int, Int) = parallel {1,2}\n"),
    b"fn f() -> (Int, Int) = parallel { 1, 2 }\n",
  );
  let long = b"fn f() -> (Int, Int) = parallel { a_rather_long_function_name(1, 2, 3, 4, 5), another_rather_long_function_name(6, 7, 8, 9, 10) }\n";
  assert_eq(
    formatted(long),
    b"fn f() -> (Int, Int) =\n  parallel {\n    a_rather_long_function_name(1, 2, 3, 4, 5),\n    another_rather_long_function_name(6, 7, 8, 9, 10),\n  }\n",
  );
  assert(stable(long));
  assert_eq(
    formatted(b"fn g() -> Int = match (parallel { 1, 2 }) { _ -> 0 }\n"),
    b"fn g() -> Int = match (parallel { 1, 2 }) { _ -> 0 }\n",
  )
}

test "an `extern fn` prints as its declaration, a `where` on a line of its own" {
  lays_out(
    b"// kept\nextern   fn len<a>(xs:List<a>)->Int\n\nextern fn compare<a>(x: a, y: a) -> Ordering where derivable(ord, a)\n",
    b"// kept\nextern fn len<a>(xs: List<a>) -> Int\n\nextern fn compare<a>(x: a, y: a) -> Ordering\n  where derivable(ord, a)\n",
  )
}

test "an `extern fn` prints each clause it states on a line of its own" {
  lays_out(
    b"extern fn Bytes::at(b: Bytes, i: Int) -> Int / {abort.raise} requires 0<=i && i<Bytes::len(b) ensures 0 <= result\n",
    b"extern fn Bytes::at(b: Bytes, i: Int) -> Int / {abort.raise}\n  requires 0 <= i && i < Bytes::len(b)\n  ensures 0 <= result\n",
  )
}

test "an `extern type` prints as its name and parameters, `pub` where it is" {
  lays_out(
    b"/// A node.\npub   extern type  Node< a,b >\nextern type Hidden\n",
    b"/// A node.\npub extern type Node<a, b>\nextern type Hidden\n",
  )
}

test "a `numeric` prints on one line, its operations in the order written" {
  lays_out(
    b"type T = | T(Int)\nnumeric   for T by {of_int:g,\n  add : f ,}\n",
    b"type T = | T(Int)\nnumeric for T by { of_int: g, add: f }\n",
  )
}

test "a `key`, a `show` and an `invariant` print on a line each, as written" {
  lays_out(
    b"type T = | T(Int)\n// read through\nkey   for T   by f\nshow for T by\n  g\ninvariant  for T by   h\n",
    b"type T = | T(Int)\n// read through\nkey for T by f\nshow for T by g\ninvariant for T by h\n",
  )
}

test "a `host` prints on a line of its own, as written" {
  lays_out(
    b"effect e {\n  read get() -> Int\n}\n\nhost  for e by\n  served\n",
    b"effect e {\n  read get() -> Int\n}\n\nhost for e by served\n",
  )
}

test "a hole prints as written, `???` or `..`" {
  lays_out(b"fn f(x: Int) -> Int = ???\n", b"fn f(x: Int) -> Int = ???\n");
  lays_out(b"fn f(x: Int) -> Int = ..\n", b"fn f(x: Int) -> Int = ..\n")
}

test "a function's result that is a function keeps its parentheses before the function's effects" {
  lays_out(
    b"fn f(n: Int) -> ((Int) -> Int) / {abort.raise} = g\n",
    b"fn f(n: Int) -> ((Int) -> Int) / {abort.raise} = g\n",
  );
  lays_out(
    b"fn f(g: (Int) -> ((Int) -> Int) / {abort.raise}) -> Int = 1\n",
    b"fn f(g: (Int) -> ((Int) -> Int) / {abort.raise}) -> Int = 1\n",
  );
  lays_out(
    b"fn f() -> (Int) -> Int / {abort.raise} = g\n",
    b"fn f() -> (Int) -> Int / {abort.raise} = g\n",
  )
}

test "the formatter leaves the `<>` on a lowercase type with no arguments, so it is not read as a type variable" {
  lays_out(
    b"fn f(x: thing< >) -> List<thing<>> = [x]\n",
    b"fn f(x: thing<>) -> List<thing<>> = [x]\n",
  )
}

test "the formatter lays out a block inside a string interpolation `{ }` when the block cannot fit on one line" {
  let source = b"fn f() -> String = f\"a { { let y = 1; y } } b\" ++ sh\"{ { let z = 2; z } }\"\n";
  assert(stable(source));
  assert_eq(tree_of(formatted(source)), tree_of(source))
}
