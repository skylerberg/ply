import compiler.syntax.parsing (tuple_field_name, Span, Identifier, QName, Input, Parser,
                                ParseOutput, EatResult, PartialList, ParseDiagnostic, span_to,
                                dummy_span, no_identifier, no_qualified_name, unexpected, error_at,
                                push_diagnostic, error_here, unclosed, token_kind, token_kind_at,
                                current_span, span_at, previous_span, at_token, at_eof,
                                starts_upper, advance, bump, eat, token_bytes, token_at, expect,
                                expect_close, expect_identifier, expect_field_name,
                                report_duplicate_fields, keyword_pun_error, too_deep,
                                qualified_name, comma_list, parsed_or, failed, token_lparen,
                                token_rparen, token_lbrace, token_rbrace, token_lbracket,
                                token_rbracket, token_comma, token_colon, token_dotdot,
                                token_dotdoteq, token_minus, token_pipe, token_underscore,
                                keyword_true, keyword_false, dump_node, dump_count, dump_presence,
                                dump_payload, dump_word, dump_list, dump_opt, dump_identifier,
                                dump_qualified_name, dump_diagnostics, start, is_bare)
import compiler.syntax.lexer (TokenKind, Token, Identifier, IntLiteral, FixedLiteral, WideLiteral,
                              FloatLiteral, DecimalLiteral, StringLiteral, BytesLiteral,
                              CharLiteral, Keyword, Punctuation, EndOfInput, Width, width_named,
                              width_normalize)
import std.bin
import std.bytes (ascii_of_int)
import std.list (prepend)
import std.string

pub type SourceLiteral =
  | LiteralInt(Int)
  | LiteralFixed(Bytes, Int)
  | LiteralWide(Bytes, Int, Int)
  | LiteralBool(Bool)
  | LiteralString(Bytes)
  | LiteralBytes(Bytes)
  | LiteralEmbedded(Bytes, Int)
  | LiteralFloat(Bytes)
  | LiteralDecimal(Bytes)
  | LiteralChar(Int)
  | LiteralUnit
  | LiteralInvalid

derive bin for SourceLiteral

pub fn dump_literal(literal: SourceLiteral) -> Bytes / {abort.raise} =
  match literal {
    LiteralInt(v) -> dump_word(b"int").concat(dump_payload(ascii_of_int(v))),
    LiteralFixed(ty, v) ->
      dump_word(b"fixed").concat(dump_payload(Bytes::concat_all([ty, b":", ascii_of_int(v)]))),
    LiteralWide(ty, high, low) ->
      dump_word(b"wide").concat(
        dump_payload(Bytes::concat_all([ty, b":", ascii_of_int(high), b":", ascii_of_int(low)])),
      ),
    LiteralBool(b) -> dump_word(b"bool").concat(dump_payload(if b { b"1" } else { b"0" })),
    LiteralString(s) -> dump_word(b"str").concat(dump_payload(s)),
    LiteralBytes(b) -> dump_word(b"bytes").concat(dump_payload(b)),
    LiteralEmbedded(digest, size) ->
      dump_word(b"embedded").concat(
        dump_payload(Bytes::concat_all([digest, b":", ascii_of_int(size)])),
      ),
    LiteralFloat(r) -> dump_word(b"float").concat(dump_payload(r)),
    LiteralDecimal(r) -> dump_word(b"dec").concat(dump_payload(r)),
    LiteralChar(v) -> dump_word(b"char").concat(dump_payload(ascii_of_int(v))),
    LiteralUnit -> dump_word(b"unit"),
    LiteralInvalid -> dump_word(b"badlit"),
  }

pub type Pattern =
  | PatternWildcard({ span: Span })
  | PatternVariable({ span: Span, name: Identifier })
  | PatternLiteral({ span: Span, literal: SourceLiteral })
  | PatternRange({ span: Span, lo: SourceLiteral, hi: SourceLiteral })
  | PatternConstructor({ span: Span, name: QName, args: List<Pattern> })
  | PatternRecord({ span: Span, rest: Bool, fields: List<{ name: Identifier, pattern: Pattern }> })
  | PatternList({ span: Span, rest: Option<Pattern>, items: List<Pattern> })
  | PatternOr({ span: Span, alternatives: List<Pattern> })
  | PatternInvalid({ span: Span })

pub fn binder_names(p: Pattern) -> List<Identifier> =
  match p {
    PatternVariable(v) -> [v.name],
    PatternConstructor(c) ->
      c.args.fold([], |accumulator: List<Identifier>, x: Pattern|
        accumulator.concat(binder_names(x))),
    PatternRecord(r) ->
      r.fields.fold(
        [],
        |accumulator: List<Identifier>, f: { name: Identifier, pattern: Pattern }|
          accumulator.concat(binder_names(f.pattern)),
      ),
    PatternList(l) -> {
      let items = l.items.fold([], |accumulator: List<Identifier>, x: Pattern|
        accumulator.concat(binder_names(x)));
      match l.rest { Some(r) -> items.concat(binder_names(r)), None -> items }
    },
    PatternOr(o) -> match o.alternatives { [first, ..] -> binder_names(first), [] -> [] },
    _ -> [],
  }

pub fn pattern_span(pattern: Pattern) -> Span =
  match pattern {
    PatternWildcard(v) -> v.span,
    PatternVariable(v) -> v.span,
    PatternLiteral(v) -> v.span,
    PatternRange(v) -> v.span,
    PatternConstructor(v) -> v.span,
    PatternRecord(v) -> v.span,
    PatternList(v) -> v.span,
    PatternOr(v) -> v.span,
    PatternInvalid(v) -> v.span,
  }

fn set_pattern_span(pattern: Pattern, span: Span) -> Pattern =
  match pattern {
    PatternWildcard(v) -> PatternWildcard({ span: span }),
    PatternVariable(v) -> PatternVariable({ span: span, name: v.name }),
    PatternLiteral(v) -> PatternLiteral({ span: span, literal: v.literal }),
    PatternRange(v) -> PatternRange({ ..v, span: span }),
    PatternConstructor(v) -> PatternConstructor({ span: span, name: v.name, args: v.args }),
    PatternRecord(v) -> PatternRecord({ span: span, rest: v.rest, fields: v.fields }),
    PatternList(v) -> PatternList({ span: span, rest: v.rest, items: v.items }),
    PatternOr(v) -> PatternOr({ span: span, alternatives: v.alternatives }),
    PatternInvalid(v) -> PatternInvalid({ span: span }),
  }

pub fn no_pattern() -> Pattern = PatternInvalid({ span: dummy_span() })

pub fn has_or(x: Pattern) -> Bool =
  match x {
    PatternOr(_) -> true,
    PatternConstructor(v) -> v.args.fold(false, |b: Bool, a: Pattern| b || has_or(a)),
    PatternRecord(v) ->
      v.fields.fold(false, |b: Bool, f: { name: Identifier, pattern: Pattern }|
        b || has_or(f.pattern)),
    PatternList(v) ->
      v.items.fold(false, |b: Bool, a: Pattern| b || has_or(a))
        || (match v.rest { Some(r) -> has_or(r), None -> false }),
    PatternWildcard(_) -> false,
    PatternVariable(_) -> false,
    PatternLiteral(_) -> false,
    PatternRange(_) -> false,
    PatternInvalid(_) -> false,
  }

pub fn alternatives_of(x: Pattern) -> List<Pattern> =
  match x {
    PatternOr(v) ->
      v.alternatives.fold([], |accumulator: List<Pattern>, a: Pattern|
        append_pats(accumulator, alternatives_of(a))),
    PatternConstructor(v) ->
      product(v.args.map(alternatives_of)).map(|args: List<Pattern>|
        PatternConstructor({ span: v.span, name: v.name, args: args })),
    PatternRecord(v) ->
      product(
        v.fields.map(|f: { name: Identifier, pattern: Pattern }| alternatives_of(f.pattern)),
      ).map(|ps: List<Pattern>|
        PatternRecord({
          span: v.span,
          rest: v.rest,
          fields: range(0, ps.len()).map(|i: Int| {
            let f = match v.fields.at(i) {
              Some(f) -> f,
              None -> { name: no_identifier(), pattern: no_pattern() },
            };
            { name: f.name, pattern: match ps.at(i) { Some(q) -> q, None -> f.pattern } }
          }),
        })),
    PatternList(v) -> {
      let rests = match v.rest {
        Some(r) -> alternatives_of(r).map(|q: Pattern| Some(q)),
        None -> [None],
      };
      product(v.items.map(alternatives_of)).fold(
        [],
        |accumulator: List<Pattern>, items: List<Pattern>|
          append_pats(
            accumulator,
            rests.map(|r: Option<Pattern>| PatternList({ span: v.span, rest: r, items: items })),
          ),
      )
    },
    _ -> [x],
  }

fn product(xss: List<List<Pattern>>) -> List<List<Pattern>> =
  xss.fold([[]], |accumulator: List<List<Pattern>>, patterns: List<Pattern>|
    accumulator.fold([], |out: List<List<Pattern>>, prefix: List<Pattern>|
      append_lists(out, patterns.map(|pattern: Pattern| prefix.push(pattern)))))

fn append_pats(a: List<Pattern>, b: List<Pattern>) -> List<Pattern> =
  b.fold(a, |accumulator: List<Pattern>, pattern: Pattern| accumulator.push(pattern))

fn append_lists(a: List<List<Pattern>>, b: List<List<Pattern>>) -> List<List<Pattern>> =
  b.fold(a, |accumulator: List<List<Pattern>>, patterns: List<Pattern>| accumulator.push(patterns))

pub fn pattern(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Pattern>, Parser> / {abort.raise} =
  if input.room <= 0 { Err(too_deep(input, parser)) }
  else { alternatives({ ..input, room: input.room - 1 }, parser) }

fn alternatives(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Pattern>, Parser> / {abort.raise} = {
  let first = pattern_body(input, parser)?;
  if !at_token(input, first.parser, token_pipe()) { Ok(first) } else {
    let more = iterate(
      { parser: first.parser, out: [first.node] },
      input.token_count - first.parser.position + 1,
      |s: PartialList<Pattern>|
        if !at_token(input, s.parser, token_pipe()) { Stop(Ok(s)) } else {
          match pattern_body(input, advance(input, s.parser).parser) {
            Err(q) -> Stop(Err(q)),
            Ok(r) -> Continue({ parser: r.parser, out: s.out.push(r.node) }),
          }
        },
    )?;
    let last = match more.out.at(more.out.len() - 1) {
      Some(x) -> pattern_span(x),
      None -> pattern_span(first.node),
    };
    Ok({
      parser: more.parser,
      node: PatternOr({ span: span_to(pattern_span(first.node), last), alternatives: more.out }),
    })
  }
}

fn literal_pattern(
  input: Input,
  parser: Parser,
  literal: SourceLiteral,
) -> Result<ParseOutput<Pattern>, Parser> = {
  let a = advance(input, parser);
  Ok({ parser: a.parser, node: PatternLiteral({ span: a.node, literal: literal }) })
}

pub fn source_text(input: Input, span: Span) -> Bytes / {abort.raise} =
  input.source.slice(span.start, span.end)

fn is_number_token(kind: TokenKind) -> Bool =
  match kind {
    IntLiteral(v) -> true,
    FixedLiteral(ty, v) -> true,
    WideLiteral(ty, high, low) -> true,
    FloatLiteral(f) -> true,
    DecimalLiteral(m, scale) -> true,
    _ -> false,
  }

fn pattern_body(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Pattern>, Parser> / {abort.raise} = {
  let first = pattern_atom(input, parser)?;
  if !at_token(input, first.parser, token_dotdoteq()) { Ok(first) } else {
    let dots = advance(input, first.parser);
    let last = pattern_atom(input, dots.parser)?;
    let span = span_to(pattern_span(first.node), pattern_span(last.node));
    let bound = |p: Pattern|
      match p {
        PatternLiteral(l) -> if input.source.at(l.span.start) == 40 { None }
        else { Some(l.literal) },
        _ -> None,
      };
    match ((bound(first.node), bound(last.node))) {
      (Some(lo), Some(hi)) ->
        Ok({ parser: last.parser, node: PatternRange({ span: span, lo: lo, hi: hi }) }),
      _ ->
        Ok({
          parser: push_diagnostic(
            last.parser,
            error_at(
              non_literal_range_bound(),
              span,
              b"a range pattern's bounds are integer literals",
              b"one of these is not a literal",
              [b"a range is written `lo..=hi`, as in `0..=9` or `b'a'..=b'z'`, and binds nothing"],
            ),
          ),
          node: PatternWildcard({ span: span }),
        }),
    }
  }
}

pub fn non_literal_range_bound() -> Bytes = b"E0222"

fn pattern_atom(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Pattern>, Parser> / {abort.raise} = {
  let st = current_span(input, parser);
  match token_kind(input, parser) {
    IntLiteral(v) -> literal_pattern(input, parser, LiteralInt(v)),
    FixedLiteral(ty, v) -> literal_pattern(input, parser, LiteralFixed(ty, v)),
    WideLiteral(ty, high, low) -> literal_pattern(input, parser, LiteralWide(ty, high, low)),
    FloatLiteral(f) -> literal_pattern(input, parser, LiteralFloat(source_text(input, st))),
    DecimalLiteral(m, scale) ->
      literal_pattern(input, parser, LiteralDecimal(source_text(input, st))),
    StringLiteral(s) -> literal_pattern(input, parser, LiteralString(s)),
    BytesLiteral(b) -> literal_pattern(input, parser, LiteralBytes(b)),
    CharLiteral(v) -> literal_pattern(input, parser, LiteralChar(v)),
    Keyword(k) -> if k == b"true" { literal_pattern(input, parser, LiteralBool(true)) }
    else if k == b"false" { literal_pattern(input, parser, LiteralBool(false)) }
    else { Err(error_here(input, parser, b"a pattern")) },
    Identifier(n) -> pattern_named(input, parser, st),
    Punctuation(s) -> if s == b"underscore" {
      let a = advance(input, parser);
      Ok({ parser: a.parser, node: PatternWildcard({ span: a.node }) })
    } else if s == b"minus" && is_number_token(token_kind_at(input, parser, 1)) {
      negative_literal(input, parser, st)
    } else if s == b"lparen" { pattern_paren(input, parser) }
    else if s == b"lbracket" { list_pattern(input, parser) }
    else if s == b"lbrace" { record_pattern(input, parser) }
    else { Err(error_here(input, parser, b"a pattern")) },
    _ -> Err(error_here(input, parser, b"a pattern")),
  }
}

fn negate_at_width(ty: Bytes, v: Int) -> Int / {abort.raise} =
  match width_named(Bytes::of_string(String::of_bytes(ty).ascii_lower())) {
    Some(w) -> width_normalize(w, wrap_sub(0, v)),
    None -> 0 - v,
  }

fn negate_wide(ty: Bytes, high: Int, low: Int) -> SourceLiteral =
  LiteralWide(ty, if low == 0 { wrap_sub(0, high) } else { ~high }, wrap_sub(0, low))

fn negative_literal(
  input: Input,
  parser: Parser,
  span: Span,
) -> Result<ParseOutput<Pattern>, Parser> / {abort.raise} = {
  let m = advance(input, parser);
  let a = advance(input, m.parser);
  let s = span_to(span, a.node);
  match token_kind(input, m.parser) {
    IntLiteral(v) ->
      Ok({ parser: a.parser, node: PatternLiteral({ span: s, literal: LiteralInt(0 - v) }) }),
    FixedLiteral(ty, v) ->
      Ok({
        parser: a.parser,
        node: PatternLiteral({ span: s, literal: LiteralFixed(ty, negate_at_width(ty, v)) }),
      }),
    WideLiteral(ty, high, low) ->
      Ok({
        parser: a.parser,
        node: PatternLiteral({ span: s, literal: negate_wide(ty, high, low) }),
      }),
    FloatLiteral(f) ->
      Ok({
        parser: a.parser,
        node: PatternLiteral({ span: s, literal: LiteralFloat(source_text(input, s)) }),
      }),
    DecimalLiteral(mm, scale) ->
      Ok({
        parser: a.parser,
        node: PatternLiteral({ span: s, literal: LiteralDecimal(source_text(input, s)) }),
      }),
    _ -> Ok({ parser: a.parser, node: PatternLiteral({ span: s, literal: LiteralInvalid }) }),
  }
}

fn pattern_paren(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Pattern>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  if at_token(input, o.parser, token_rparen()) {
    let closing_paren = advance(input, o.parser);
    Ok({
      parser: closing_paren.parser,
      node: PatternLiteral({ span: span_to(o.node, closing_paren.node), literal: LiteralUnit }),
    })
  } else {
    let inner = pattern(input, o.parser)?;
    if at_token(input, inner.parser, token_comma()) {
      let rest = comma_list(input, advance(input, inner.parser).parser, token_rparen(), pattern)?;
      let closing_paren = expect_close(
        input,
        rest.parser,
        token_rparen(),
        o.node,
        b"`)` to close the tuple",
      )?;
      let items = prepend(inner.node, rest.node);
      if items.len() == 1 {
        Ok({
          parser: closing_paren.parser,
          node: set_pattern_span(inner.node, span_to(o.node, closing_paren.node)),
        })
      } else {
        Ok({
          parser: closing_paren.parser,
          node: PatternRecord({
            span: span_to(o.node, closing_paren.node),
            rest: false,
            fields: range(0, items.len()).map(|i: Int| -> { name: Identifier, pattern: Pattern } {
              match items.at(i) {
                Some(q) -> { name: tuple_field_name(i, pattern_span(q)), pattern: q },
                None ->
                  { name: tuple_field_name(i, o.node), pattern: PatternWildcard({ span: o.node }) },
              }
            }),
          }),
        })
      }
    } else {
      let close = expect_close(input, inner.parser, token_rparen(), o.node, b"`)`")?;
      Ok({ parser: close.parser, node: set_pattern_span(inner.node, span_to(o.node, close.node)) })
    }
  }
}

fn pattern_named(
  input: Input,
  parser: Parser,
  span: Span,
) -> Result<ParseOutput<Pattern>, Parser> / {abort.raise} = {
  let q = qualified_name(input, parser, b"a pattern")?;
  if is_bare(q.node) && !starts_upper(q.node.name.name) {
    Ok({ parser: q.parser, node: PatternVariable({ span: span, name: q.node.name }) })
  } else if at_token(input, q.parser, token_lparen()) {
    let o = advance(input, q.parser);
    let args = comma_list(input, o.parser, token_rparen(), pattern)?;
    let closing_paren = expect_close(
      input,
      args.parser,
      token_rparen(),
      o.node,
      b"`)` to close the constructor arguments",
    )?;
    Ok({
      parser: closing_paren.parser,
      node: PatternConstructor({
        span: span_to(span, closing_paren.node),
        name: q.node,
        args: args.node,
      }),
    })
  } else {
    Ok({
      parser: q.parser,
      node: PatternConstructor({ span: span_to(span, q.node.span), name: q.node, args: [] }),
    })
  }
}

type ListAccumulator = { parser: Parser, rest: Option<Pattern>, items: List<Pattern> }

type ListOut = { rest: Option<Pattern>, items: List<Pattern> }

fn list_pattern(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Pattern>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  let { parser, node: b } = list_items(input, o.parser, o.node)?;
  let { parser, node: closing_bracket } = expect_close(
    input,
    parser,
    token_rbracket(),
    o.node,
    b"`]` to close the list pattern",
  )?;
  Ok({
    parser: parser,
    node: PatternList({ span: span_to(o.node, closing_bracket), rest: b.rest, items: b.items }),
  })
}

fn list_items(
  input: Input,
  parser: Parser,
  open: Span,
) -> Result<ParseOutput<ListOut>, Parser> / {abort.raise} =
  iterate(
    { parser: parser, rest: None, items: [] },
    input.token_count - parser.position + 1,
    |s: ListAccumulator|
      if at_token(input, s.parser, token_rbracket()) {
        Stop(Ok({ parser: s.parser, node: { rest: s.rest, items: s.items } }))
      } else if at_eof(input, s.parser) {
        Stop(Err(unclosed(input, s.parser, open, b"`]` to close the list pattern")))
      } else if at_token(input, s.parser, token_dotdot()) {
        let d = advance(input, s.parser);
        let bound = match token_kind(input, d.parser) {
          Identifier(n) -> match expect_identifier(input, d.parser, b"a name after `..`") {
            Err(q) -> Err(q),
            Ok(i) ->
              Ok({ parser: i.parser, node: PatternVariable({ span: i.node.span, name: i.node }) }),
          },
          _ -> Ok({ parser: d.parser, node: PatternWildcard({ span: d.node }) }),
        };
        match bound {
          Err(q) -> Stop(Err(q)),
          Ok(b) ->
            Stop(
              Ok({
                parser: eat(input, b.parser, token_comma()).parser,
                node: { items: s.items, rest: Some(b.node) },
              }),
            ),
        }
      } else {
        match pattern(input, s.parser) {
          Err(q) -> Stop(Err(q)),
          Ok(it) -> {
            let e = eat(input, it.parser, token_comma());
            if e.ok { Continue({ parser: e.parser, rest: s.rest, items: s.items.push(it.node) }) }
            else {
              Stop(Ok({ parser: e.parser, node: { rest: s.rest, items: s.items.push(it.node) } }))
            }
          },
        }
      },
  )

type PartialRecordPattern = {
  parser: Parser,
  rest: Bool,
  fields: List<{ name: Identifier, pattern: Pattern }>,
}

type RecordPatternFields = { rest: Bool, fields: List<{ name: Identifier, pattern: Pattern }> }

fn record_pattern(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Pattern>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  let { parser, node: b } = record_fields(input, o.parser, o.node)?;
  let { parser, node: closing_brace } = expect_close(
    input,
    parser,
    token_rbrace(),
    o.node,
    b"`}` to close the record pattern",
  )?;
  Ok({
    parser: report_duplicate_fields(
      parser,
      b.fields.map(|f: { name: Identifier, pattern: Pattern }| f.name),
    ),
    node: PatternRecord({ span: span_to(o.node, closing_brace), rest: b.rest, fields: b.fields }),
  })
}

fn record_fields(
  input: Input,
  parser: Parser,
  open: Span,
) -> Result<ParseOutput<RecordPatternFields>, Parser> / {abort.raise} =
  iterate(
    { parser: parser, rest: false, fields: [] },
    input.token_count - parser.position + 1,
    |s: PartialRecordPattern|
      if at_token(input, s.parser, token_rbrace()) {
        Stop(Ok({ parser: s.parser, node: { rest: s.rest, fields: s.fields } }))
      } else if at_eof(input, s.parser) {
        Stop(Err(unclosed(input, s.parser, open, b"`}` to close the record pattern")))
      } else {
        let dd = eat(input, s.parser, token_dotdot());
        if dd.ok {
          Stop(
            Ok({
              parser: eat(input, dd.parser, token_comma()).parser,
              node: { fields: s.fields, rest: true },
            }),
          )
        } else {
          match expect_field_name(input, s.parser, b"a field name") {
            Err(q) -> Stop(Err(q)),
            Ok(fname) -> {
              let n = { parser: fname.parser, node: fname.node.name };
              let co = eat(input, n.parser, token_colon());
              let f = if co.ok { pattern(input, co.parser) }
              else if fname.node.keyword { Err(keyword_pun_error(co.parser, n.node)) } else {
                Ok({
                  parser: co.parser,
                  node: PatternVariable({ span: n.node.span, name: n.node }),
                })
              };
              match f {
                Err(q) -> Stop(Err(q)),
                Ok(fv) -> {
                  let e = eat(input, fv.parser, token_comma());
                  if e.ok {
                    Continue({
                      parser: e.parser,
                      rest: s.rest,
                      fields: s.fields.push({ name: n.node, pattern: fv.node }),
                    })
                  } else {
                    Stop(
                      Ok({
                        parser: e.parser,
                        node: {
                          rest: s.rest,
                          fields: s.fields.push({ name: n.node, pattern: fv.node }),
                        },
                      }),
                    )
                  }
                },
              }
            },
          }
        }
      },
  )

pub fn dump_pattern(pattern: Pattern) -> Bytes / {abort.raise} =
  match pattern {
    PatternWildcard(v) -> dump_node(v.span, b"pwld"),
    PatternVariable(v) -> dump_node(v.span, b"pvar").concat(dump_identifier(v.name)),
    PatternLiteral(v) -> dump_node(v.span, b"plit").concat(dump_literal(v.literal)),
    PatternRange(v) ->
      Bytes::concat_all([dump_node(v.span, b"prng"), dump_literal(v.lo), dump_literal(v.hi)]),
    PatternConstructor(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"pctr"),
        dump_qualified_name(v.name),
        dump_list(v.args, dump_pattern),
      ]),
    PatternRecord(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"prec"),
        dump_presence(v.rest),
        dump_list(v.fields, dump_pattern_field),
      ]),
    PatternList(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"plst"),
        dump_list(v.items, dump_pattern),
        dump_opt(v.rest, dump_pattern),
      ]),
    PatternOr(v) -> dump_node(v.span, b"por").concat(dump_list(v.alternatives, dump_pattern)),
    PatternInvalid(v) -> dump_node(v.span, b"pbad"),
  }

fn dump_pattern_field(f: { name: Identifier, pattern: Pattern }) -> Bytes / {abort.raise} =
  dump_identifier(f.name).concat(dump_pattern(f.pattern))

pub fn dump_pattern_of(source: Bytes) -> String / {abort.raise} = {
  let s = start(source);
  let r = parsed_or(pattern(s.input, s.parser), no_pattern());
  String::of_bytes(dump_pattern(r.node).concat(dump_diagnostics(r.parser.diagnostics)))
}

test "wildcards, variables and constructors" {
  assert_eq(dump_pattern_of(b"_"), "0:1:pwld;#0;");
  assert_eq(dump_pattern_of(b"x"), "0:1:pvar;0:1:ident;@78;#0;");
  assert_eq(dump_pattern_of(b"None"), "0:4:pctr;0:4:qname;?0;0:4:ident;@4e6f6e65;#0;#0;");
  assert_eq(
    dump_pattern_of(b"Some(x)"),
    "0:7:pctr;0:4:qname;?0;0:4:ident;@536f6d65;#1;5:6:pvar;5:6:ident;@78;#0;",
  );
  assert_eq(
    dump_pattern_of(b"m::Ok(a, b)"),
    "0:11:pctr;0:5:qname;?1;0:1:ident;@6d;3:5:ident;@4f6b;#2;6:7:pvar;6:7:ident;@61;9:10:pvar;9:10:ident;@62;#0;",
  )
}

test "a parenthesised pattern is the inner node with the parens' span" {
  assert_eq(dump_pattern_of(b"(x)"), "0:3:pvar;1:2:ident;@78;#0;");
  assert_eq(dump_pattern_of(b"()"), "0:2:plit;%unit;#0;")
}

test "literal patterns" {
  assert_eq(dump_pattern_of(b"42"), "0:2:plit;%int;@3432;#0;");
  assert_eq(dump_pattern_of(b"1_000"), "0:5:plit;%int;@31303030;#0;");
  assert_eq(dump_pattern_of(b"true"), "0:4:plit;%bool;@31;#0;");
  assert_eq(dump_pattern_of(b"false"), "0:5:plit;%bool;@30;#0;");
  assert_eq(dump_pattern_of(b"\"hi\""), "0:4:plit;%str;@6869;#0;");
  assert_eq(dump_pattern_of(b"b\"GET \""), "0:7:plit;%bytes;@47455420;#0;")
}

test "a range pattern has a literal at each end, and a byte literal bound becomes the integer it stands for" {
  assert_eq(dump_pattern_of(b"0..=9"), "0:5:prng;%int;@30;%int;@39;#0;");
  assert_eq(dump_pattern_of(b"b'a'..=b'z'"), "0:11:prng;%int;@3937;%int;@313232;#0;");
  assert_eq(dump_pattern_of(b"-5..=-1"), "0:7:prng;%int;@2d35;%int;@2d31;#0;");
  assert_eq(dump_pattern_of(b"1u8..=9u8"), "0:9:prng;%fixed;@55383a31;%fixed;@55383a39;#0;");
  assert_eq(
    dump_pattern_of(b"b'-' | b'0'..=b'9'"),
    "0:18:por;#2;0:4:plit;%int;@3435;7:18:prng;%int;@3438;%int;@3537;#0;",
  )
}

test "a range pattern with a name or a parenthesised literal as its bound reports one diagnostic, and `(0..=9)` parses as a range" {
  assert_eq(dump_pattern_of(b"x..=9"), "0:5:pwld;#1;!E0222:0:5:1:1;=0:5:1;");
  assert_eq(dump_pattern_of(b"(0)..=9"), "0:7:pwld;#1;!E0222:0:7:1:1;=0:7:1;");
  assert_eq(dump_pattern_of(b"(0..=9)"), "0:7:prng;%int;@30;%int;@39;#0;")
}

test "a float or decimal literal pattern stores its exact source text" {
  assert_eq(dump_pattern_of(b"1.5"), "0:3:plit;%float;@312e35;#0;");
  assert_eq(dump_pattern_of(b"1.50m"), "0:5:plit;%dec;@312e35306d;#0;")
}

test "a negative literal pattern is one literal and the minus is in its span" {
  assert_eq(dump_pattern_of(b"-42"), "0:3:plit;%int;@2d3432;#0;");
  assert_eq(dump_pattern_of(b"-1.5"), "0:4:plit;%float;@2d312e35;#0;");
  assert_eq(dump_pattern_of(b"-1.50m"), "0:6:plit;%dec;@2d312e35306d;#0;");
  assert_eq(dump_pattern_of(b"- 1.5"), "0:5:plit;%float;@2d20312e35;#0;")
}

test "a negative `i128` literal pattern is stored as two 64-bit halves, and the high half is one lower only when the low half is nonzero" {
  assert_eq(dump_pattern_of(b"-1i128"), "0:6:plit;%wide;@493132383a2d313a2d31;#0;");
  assert_eq(
    dump_pattern_of(b"-18446744073709551616i128"),
    "0:25:plit;%wide;@493132383a2d313a30;#0;",
  )
}

test "list patterns, with and without a rest binding" {
  assert_eq(dump_pattern_of(b"[]"), "0:2:plst;#0;?0;#0;");
  assert_eq(
    dump_pattern_of(b"[a, b]"),
    "0:6:plst;#2;1:2:pvar;1:2:ident;@61;4:5:pvar;4:5:ident;@62;?0;#0;",
  );
  assert_eq(
    dump_pattern_of(b"[a, ..rest]"),
    "0:11:plst;#1;1:2:pvar;1:2:ident;@61;?1;6:10:pvar;6:10:ident;@72657374;#0;",
  );
  assert_eq(dump_pattern_of(b"[..]"), "0:4:plst;#0;?1;1:3:pwld;#0;");
  assert_eq(dump_pattern_of(b"[a, ..]"), "0:7:plst;#1;1:2:pvar;1:2:ident;@61;?1;4:6:pwld;#0;")
}

test "record patterns, the shorthand, and the rest marker" {
  assert_eq(
    dump_pattern_of(b"{x, y: z}"),
    "0:9:prec;?0;#2;1:2:ident;@78;1:2:pvar;1:2:ident;@78;4:5:ident;@79;7:8:pvar;7:8:ident;@7a;#0;",
  );
  assert_eq(dump_pattern_of(b"{..}"), "0:4:prec;?1;#0;#0;");
  assert_eq(dump_pattern_of(b"{x, ..}"), "0:7:prec;?1;#1;1:2:ident;@78;1:2:pvar;1:2:ident;@78;#0;")
}

test "`|` joins alternatives into one pattern, and in `Some(1 | 2)` it applies inside the argument, not to `Some`" {
  assert_eq(
    dump_pattern_of(b"A | B"),
    "0:5:por;#2;0:1:pctr;0:1:qname;?0;0:1:ident;@41;#0;4:5:pctr;4:5:qname;?0;4:5:ident;@42;#0;#0;",
  );
  assert_eq(
    dump_pattern_of(b"Some(1 | 2)"),
    "0:11:pctr;0:4:qname;?0;0:4:ident;@536f6d65;#1;5:10:por;#2;5:6:plit;%int;@31;9:10:plit;%int;@32;#0;",
  );
  assert_eq(
    dump_pattern_of(b"(x, 0) | (0, x)"),
    "0:15:por;#2;0:6:prec;?0;#2;1:2:ident;@5f30;1:2:pvar;1:2:ident;@78;4:5:ident;@5f31;4:5:plit;%int;@30;9:15:prec;?0;#2;10:11:ident;@5f30;10:11:plit;%int;@30;13:14:ident;@5f31;13:14:pvar;13:14:ident;@78;#0;",
  )
}

test "a parenthesised alternative nests rather than flattening" {
  assert_eq(
    dump_pattern_of(b"1 | (2 | 3)"),
    "0:11:por;#2;0:1:plit;%int;@31;4:11:por;#2;5:6:plit;%int;@32;9:10:plit;%int;@33;#0;",
  )
}

fn shape(pattern: Pattern) -> Bytes =
  match pattern {
    PatternWildcard(_) -> b"_",
    PatternVariable(v) -> v.name.name,
    PatternLiteral(_) -> b"#",
    PatternRange(_) -> b"#..=#",
    PatternConstructor(v) -> if v.args.len() == 0 { v.name.name.name }
    else { Bytes::concat_all([v.name.name.name, b"(", join_shapes(v.args), b")"]) },
    PatternRecord(v) ->
      Bytes::concat_all([
        b"(",
        join_shapes(v.fields.map(|f: { name: Identifier, pattern: Pattern }| f.pattern)),
        b")",
      ]),
    PatternList(v) -> Bytes::concat_all([b"[", join_shapes(v.items), b"]"]),
    PatternOr(v) -> Bytes::concat_all([b"{", join_shapes(v.alternatives), b"}"]),
    PatternInvalid(_) -> b"!",
  }

fn join_shapes(patterns: List<Pattern>) -> Bytes =
  patterns.fold(b"", |accumulator: Bytes, pattern: Pattern|
    if accumulator.len() == 0 { shape(pattern) }
    else { Bytes::concat_all([accumulator, b", ", shape(pattern)]) })

fn expanded(source: Bytes) -> List<Bytes> / {abort.raise} = {
  let s = start(source);
  alternatives_of(parsed_or(pattern(s.input, s.parser), no_pattern()).node).map(shape)
}

test "expanding nested alternatives lists every combination in order, with the leftmost choice changing least often" {
  assert_eq(expanded(b"(A | B, C | D)"), [b"(A, C)", b"(A, D)", b"(B, C)", b"(B, D)"]);
  assert_eq(expanded(b"Some(1 | 2) | None"), [b"Some(#)", b"Some(#)", b"None"]);
  assert_eq(expanded(b"[x, A | B]"), [b"[x, A]", b"[x, B]"]);
  assert_eq(expanded(b"x"), [b"x"])
}

test "an alternative missing after `|` is one diagnostic" {
  assert_eq(dump_pattern_of(b"A |"), "0:0:pbad;#1;!E0001:3:3:1:0;=3:3:1;")
}

test "an unclosed list pattern labels its opening bracket" {
  assert_eq(dump_pattern_of(b"[a"), "0:0:pbad;#1;!E0001:2:2:2:0;=2:2:1;=0:1:0;")
}

test "a field with no pattern after its colon is one diagnostic" {
  assert_eq(dump_pattern_of(b"{x: }"), "0:0:pbad;#1;!E0001:4:5:1:0;=4:5:1;")
}

test "a lexical error and the syntactic one it causes are both reported" {
  assert_eq(dump_pattern_of(b"@"), "0:0:pbad;#2;!E0001:0:1:1:0;=0:1:1;!E0001:1:1:1:0;=1:1:1;")
}
