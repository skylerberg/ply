pub fn role_case_identity_param() -> Int = 89
pub fn role_case_at_type() -> Int = 90
pub fn role_case_identity_type() -> Int = 91

pub fn role_case_table_module() -> Int = 92
pub fn role_case_table_name() -> Int = 93
pub fn role_case_callee_module() -> Int = 94

pub fn role_member_default(slot: Int) -> Int = 4096 + slot * 4096

pub fn no_identifier() -> Identifier = { name: b"", span: dummy_span() }

pub fn no_qualified_name() -> QName = { module: None, name: no_identifier(), span: dummy_span() }

pub fn bare(ident: Identifier) -> QName = { module: None, name: ident, span: ident.span }

pub fn qualified(m: Identifier, n: Identifier) -> QName =
  { module: Some(m), name: n, span: span_to(m.span, n.span) }

pub type Label = { start: Int, end: Int, primary: Bool, text: Bytes }

pub type ParseDiagnostic = {
  code: Bytes,
  notes: Int,
  labels: List<Label>,
  message: Bytes,
  notes_text: List<Bytes>,
  severity: Bytes,
}

derive bin for Label
derive bin for ParseDiagnostic

pub fn unexpected() -> Bytes = b"E0001"
pub fn unterminated() -> Bytes = b"E0002"
pub fn duplicate_definition() -> Bytes = b"E0105"
pub fn unknown_effect_set() -> Bytes = b"E0114"
pub fn effect_set_cycle() -> Bytes = b"E0115"
pub fn unknown_deriver() -> Bytes = b"E0207"
pub fn default_not_allowed() -> Bytes = b"E0120"
pub fn unknown_argument_name() -> Bytes = b"E0123"
pub fn argument_order() -> Bytes = b"E0124"

pub fn parse_label(span: Span, primary: Bool, text: Bytes) -> Label =
  { start: span.start, end: span.end, primary: primary, text: text }

pub fn parse_diagnostic(
  code: Bytes,
  message: Bytes,
  labels: List<Label>,
  notes: List<Bytes>,
) -> ParseDiagnostic =
  {
    code: code,
    notes: notes.len(),
    labels: labels,
    message: message,
    notes_text: notes,
    severity: b"error",
  }

pub fn error_at(
  code: Bytes,
  span: Span,
  message: Bytes,
  label: Bytes,
  notes: List<Bytes>,
) -> ParseDiagnostic = parse_diagnostic(code, message, [parse_label(span, true, label)], notes)

pub fn error_at_and(
  code: Bytes,
  span: Span,
  message: Bytes,
  label: Bytes,
  also: Span,
  also_text: Bytes,
  notes: List<Bytes>,
) -> ParseDiagnostic =
  parse_diagnostic(
    code,
    message,
    [parse_label(span, true, label), parse_label(also, false, also_text)],
    notes,
  )

pub fn primary_span_of(diagnostic: ParseDiagnostic) -> Span = {
  let first = diagnostic.labels.fold(
    { seen: false, s: dummy_span() },
    |a: { seen: Bool, s: Span }, label: Label|
      if a.seen { a } else { { seen: true, s: span_between(label.start, label.end) } },
  );
  let prim = diagnostic.labels.fold(
    { seen: false, s: dummy_span() },
    |a: { seen: Bool, s: Span }, label: Label|
      if a.seen || !label.primary { a }
      else { { seen: true, s: span_between(label.start, label.end) } },
  );
  if prim.seen { prim.s } else { first.s }
}

pub type Input = {
  token_count: Int,
  source: Bytes,
  tokens: List<lexer::Token>,
  comments: List<lexer::Comment>,
  room: Int,
}

pub type Parser = {
  pos: Int,
  no_brace: Bool,
  no_pipe: Bool,
  gt_split: Int,
  diagnostics: List<ParseDiagnostic>,
}

pub type ParseOutput<a> = { parser: Parser, node: a }

pub type EatResult = { parser: Parser, ok: Bool }

pub type PartialList<a> = { parser: Parser, out: List<a> }

pub type ParseStart = { input: Input, parser: Parser }

pub fn start(src: Bytes) -> ParseStart / {abort.raise} = {
  let lx = lexer::lex(src);
  let d = lx.diagnostics.map(|diagnostic: lexer::Diagnostic|
    error_at(
      diagnostic.code,
      span_between(diagnostic.start, diagnostic.end),
      diagnostic.message,
      diagnostic.label,
      [],
    ));
  {
    input: {
      token_count: lx.tokens.len(),
      source: src,
      tokens: lx.tokens,
      comments: lx.comments,
      room: max_depth(),
    },
    parser: { pos: 0, no_brace: false, no_pipe: false, gt_split: -1, diagnostics: d },
  }
}

pub fn start_from_tokens(src: Bytes, tokens: List<lexer::Token>) -> ParseStart =
  {
    input: {
      token_count: tokens.len(),
      source: src,
      tokens: tokens,
      comments: [],
      room: max_depth(),
    },
    parser: { pos: 0, no_brace: false, no_pipe: false, gt_split: -1, diagnostics: [] },
  }

pub fn at_pos(parser: Parser, pos: Int) -> Parser =
  {
    no_brace: parser.no_brace,
    no_pipe: parser.no_pipe,
    gt_split: parser.gt_split,
    pos: pos,
    diagnostics: parser.diagnostics,
  }

pub fn with_no_brace(parser: Parser, b: Bool) -> Parser =
  {
    pos: parser.pos,
    no_pipe: parser.no_pipe,
    gt_split: parser.gt_split,
    no_brace: b,
    diagnostics: parser.diagnostics,
  }

pub fn with_no_pipe(parser: Parser, b: Bool) -> Parser =
  {
    pos: parser.pos,
    no_brace: parser.no_brace,
    gt_split: parser.gt_split,
    no_pipe: b,
    diagnostics: parser.diagnostics,
  }

pub fn with_gt_split(parser: Parser, i: Int) -> Parser =
  {
    pos: parser.pos,
    no_brace: parser.no_brace,
    no_pipe: parser.no_pipe,
    gt_split: i,
    diagnostics: parser.diagnostics,
  }

pub fn fresh_item(parser: Parser) -> Parser =
  {
    pos: parser.pos,
    no_pipe: parser.no_pipe,
    gt_split: parser.gt_split,
    no_brace: false,
    diagnostics: parser.diagnostics,
  }

pub fn advance_n(input: Input, parser: Parser, n: Int) -> Parser =
  if n <= 0 { parser } else { advance_n(input, advance(input, parser).parser, n - 1) }

pub fn push_diagnostic(parser: Parser, diagnostic: ParseDiagnostic) -> Parser = {
  let s = primary_span_of(diagnostic);
  let dup = match parser.diagnostics.at(parser.diagnostics.len() - 1) {
    Some(l) -> {
      let ls = primary_span_of(l);
      l.code == diagnostic.code && ls.start == s.start && ls.end == s.end
    },
    None -> false,
  };
  if dup { parser } else {
    {
      pos: parser.pos,
      no_brace: parser.no_brace,
      no_pipe: parser.no_pipe,
      gt_split: parser.gt_split,
      diagnostics: parser.diagnostics.push(diagnostic),
    }
  }
}

pub fn parsed_or<a>(r: Result<ParseOutput<a>, Parser>, d: a) -> ParseOutput<a> =
  match r { Ok(x) -> x, Err(q) -> { parser: q, node: d } }

pub fn failed<a>(r: Result<ParseOutput<a>, Parser>) -> Bool =
  match r { Ok(x) -> false, Err(q) -> true }

fn eof_token() -> lexer::Token = { start: 0, end: 0, kind: lexer::EndOfInput }

pub fn token_at_index(input: Input, parser: Parser, i: Int) -> lexer::Token = {
  let j = if i < 0 { 0 } else if i > input.token_count - 1 { input.token_count - 1 } else { i };
  let t = match input.tokens.at(j) { Some(x) -> x, None -> eof_token() };
  if j == parser.gt_split { { start: t.start + 1, end: t.end, kind: lexer::Punctuation(b"eq") } }
  else { t }
}

pub fn token_at(input: Input, parser: Parser, n: Int) -> lexer::Token =
  token_at_index(input, parser, parser.pos + n)

pub fn token_kind(input: Input, parser: Parser) -> lexer::TokenKind =
  token_at(input, parser, 0).kind

pub fn token_kind_at(input: Input, parser: Parser, n: Int) -> lexer::TokenKind =
  token_at(input, parser, n).kind

pub fn span_at(input: Input, parser: Parser, n: Int) -> Span = {
  let t = token_at(input, parser, n);
  span_between(t.start, t.end)
}

pub fn current_span(input: Input, parser: Parser) -> Span = span_at(input, parser, 0)

pub fn previous_span(input: Input, parser: Parser) -> Span = {
  let t = token_at_index(input, parser, parser.pos - 1);
  span_between(t.start, t.end)
}

pub fn token_bytes(input: Input, token: lexer::Token) -> Bytes / {abort.raise} =
  input.source.slice(token.start, token.end)

fn lower_bound(n: Int, at: Int, start_of: (Int) -> Int) -> Int / {abort.raise} =
  iterate({ lo: 0, hi: n }, 64, |s: { lo: Int, hi: Int }|
    if s.lo >= s.hi { Stop(s.lo) } else {
      let mid = (s.lo + s.hi) / 2;
      if start_of(mid) < at { Continue({ lo: mid + 1, hi: s.hi }) }
      else { Continue({ lo: s.lo, hi: mid }) }
    })

fn token_start(input: Input, i: Int) -> Int =
  match input.tokens.at(i) { Some(t) -> t.start, None -> 0 }

fn comment_start(input: Input, i: Int) -> Int =
  match input.comments.at(i) { Some(c) -> c.start, None -> 0 }

fn docs_between(
  input: Input,
  from: Int,
  to: Int,
  mark: lexer::DocMark,
) -> Option<Doc> / {abort.raise} = {
  let first = lower_bound(input.comments.len(), from, |i: Int| comment_start(input, i));
  let found = iterate(
    { i: first, out: [] },
    input.comments.len() - first + 1,
    |s: { i: Int, out: List<lexer::Comment> }|
      match input.comments.at(s.i) {
        Some(c) -> if c.start >= to { Stop(s.out) } else {
          let taken = lexer::doc_mark(input.source, c) == Some(mark);
          Continue({ i: s.i + 1, out: if taken { s.out.push(c) } else { s.out } })
        },
        None -> Stop(s.out),
      },
  );
  match found.at(0) {
    None -> None,
    Some(head) -> {
      let last = match found.at(found.len() - 1) { Some(c) -> c, None -> head };
      Some({
        lines: found.map(|c: lexer::Comment| lexer::doc_line(input.source, c)),
        span: span_between(head.start, last.end),
      })
    },
  }
}

pub fn doc_at(input: Input, at: Int) -> Option<Doc> / {abort.raise} = {
  let i = lower_bound(input.token_count, at, |k: Int| token_start(input, k));
  let from = if i == 0 { 0 } else { match input.tokens.at(i - 1) { Some(t) -> t.end, None -> 0 } };
  docs_between(input, from, at, lexer::ItemDoc)
}

pub fn module_doc(input: Input) -> Option<Doc> / {abort.raise} =
  docs_between(input, 0, token_start(input, 0), lexer::ModuleDoc)

pub fn token_between(input: Input, from: Int, to: Int) -> Bool / {abort.raise} = {
  let i = lower_bound(input.token_count, from, |k: Int| token_start(input, k));
  i < input.token_count && token_start(input, i) < to
}

pub fn advance(input: Input, parser: Parser) -> ParseOutput<Span> =
  {
    parser: if parser.pos + 1 < input.token_count { at_pos(parser, parser.pos + 1) }
    else { parser },
    node: current_span(input, parser),
  }

pub fn at_token(input: Input, parser: Parser, kind: lexer::TokenKind) -> Bool =
  token_kind(input, parser) == kind

pub fn at_eof(input: Input, parser: Parser) -> Bool = token_kind(input, parser) == lexer::EndOfInput

pub fn at_identifier_text(input: Input, parser: Parser, text: Bytes) -> Bool =
  token_kind(input, parser) == lexer::Identifier(text)

pub fn prelude_binder() -> Bytes = b"?prelude"

pub fn starts_upper(name: Bytes) -> Bool =
  name.len() > 0 && name.at(0) >= 65 && name.at(0) <= 90 && name.index_of(b"::") == None

pub fn is_string(input: Input, parser: Parser) -> Bool =
  match token_kind(input, parser) { lexer::StringLiteral(v) -> true, _ -> false }

pub fn bump(input: Input, parser: Parser) -> Parser = advance(input, parser).parser

pub fn dump_bool(b: Bool) -> Bytes = if b { dump_word(b"true") } else { dump_word(b"false") }

pub fn is_identifier(input: Input, parser: Parser) -> Bool =
  match token_kind(input, parser) { lexer::Identifier(n) -> true, _ -> false }

pub fn eat(input: Input, parser: Parser, kind: lexer::TokenKind) -> EatResult =
  if at_token(input, parser, kind) { { parser: advance(input, parser).parser, ok: true } }
  else { { parser: parser, ok: false } }

pub fn describe(kind: lexer::TokenKind) -> Bytes / {abort.raise} =
  match kind {
    lexer::Identifier(n) -> Bytes::concat_all([b"identifier `", n, b"`"]),
    lexer::IntLiteral(v) -> Bytes::concat_all([b"integer `", ascii_of_int(v), b"`"]),
    lexer::FixedLiteral(ty, v) ->
      Bytes::concat_all([b"`", ty, b"` literal `", ascii_of_int(v), b"`"]),
    lexer::WideLiteral(ty, high, low) ->
      Bytes::concat_all([
        b"`",
        ty,
        b"` literal `",
        lexer::wide_decimal(ty == b"I128", high, low),
        b"`",
      ]),
    lexer::FloatLiteral(txt) -> Bytes::concat_all([b"float `", float_display(txt), b"`"]),
    lexer::DecimalLiteral(m, sc) -> Bytes::concat_all([b"decimal `", render_decimal(m, sc), b"`"]),
    lexer::StringLiteral(_) -> b"string literal",
    lexer::LineString(_) -> b"line string",
    lexer::BytesLiteral(_) -> b"byte-string literal",
    lexer::InterpolatedHead(_) -> b"interpolated string",
    lexer::InterpolatedMiddle(_) -> b"`}` closing an interpolated value",
    lexer::InterpolatedTail(_) -> b"`}` closing an interpolated value",
    lexer::CharLiteral(_) -> b"character literal",
    lexer::Keyword(k) -> Bytes::concat_all([b"keyword `", k, b"`"]),
    lexer::EndOfInput -> b"end of file",
    lexer::Punctuation(name) -> Bytes::concat_all([b"`", punctuation_text(name), b"`"]),
  }

fn punctuation_text(name: Bytes) -> Bytes = {
  let table = [
    { n: b"lparen", t: b"(" },
    { n: b"rparen", t: b")" },
    { n: b"lbrace", t: b"{" },
    { n: b"rbrace", t: b"}" },
    { n: b"lbracket", t: b"[" },
    { n: b"rbracket", t: b"]" },
    { n: b"comma", t: b"," },
    { n: b"semi", t: b";" },
    { n: b"colon", t: b":" },
    { n: b"coloncolon", t: b"::" },
    { n: b"dot", t: b"." },
    { n: b"dotdot", t: b".." },
    { n: b"dotdoteq", t: b"..=" },
    { n: b"underscore", t: b"_" },
    { n: b"arrow", t: b"->" },
    { n: b"eq", t: b"=" },
    { n: b"eqeq", t: b"==" },
    { n: b"bang", t: b"!" },
    { n: b"bangeq", t: b"!=" },
    { n: b"lt", t: b"<" },
    { n: b"le", t: b"<=" },
    { n: b"gt", t: b">" },
    { n: b"ge", t: b">=" },
    { n: b"plus", t: b"+" },
    { n: b"plusplus", t: b"++" },
    { n: b"pluspercent", t: b"+%" },
    { n: b"minuspercent", t: b"-%" },
    { n: b"starpercent", t: b"*%" },
    { n: b"pluspipe", t: b"+|" },
    { n: b"minuspipe", t: b"-|" },
    { n: b"starpipe", t: b"*|" },
    { n: b"minus", t: b"-" },
    { n: b"star", t: b"*" },
    { n: b"slash", t: b"/" },
    { n: b"percent", t: b"%" },
    { n: b"amp", t: b"&" },
    { n: b"ampamp", t: b"&&" },
    { n: b"caret", t: b"^" },
    { n: b"pipe", t: b"|" },
    { n: b"pipepipe", t: b"||" },
    { n: b"tilde", t: b"~" },
    { n: b"hashbrace", t: b"#{" },
    { n: b"hashbracket", t: b"#[" },
    { n: b"question", t: b"?" },
    { n: b"hole", t: b"???" },
  ];
  table.fold(b"", |acc: Bytes, e: { n: Bytes, t: Bytes }| if e.n == name { e.t } else { acc })
}

pub fn render_decimal(digits: Bytes, scale: Int) -> Bytes / {abort.raise} =
  if scale == 0 { digits } else {
    let padded = if digits.len() <= scale {
      Bytes::concat_all(range(0, scale - digits.len() + 1).map(|_: Int| b"0")).concat(digits)
    } else { digits };
    let point = padded.len() - scale;
    Bytes::concat_all([padded.slice(0, point), b".", padded.slice(point, padded.len())])
  }

pub fn float_display(txt: Bytes) -> Bytes / {abort.raise} = {
  let n = txt.len();
  let e_at = match txt.index_of(b"e") { Some(i) -> i, None -> n };
  let mantissa = txt.slice(0, e_at);
  let exp = if e_at == n { 0 } else { parse_signed_int(txt.slice(e_at + 1, n)) };
  let dot = match mantissa.index_of(b".") { Some(i) -> i, None -> mantissa.len() };
  let whole = mantissa.slice(0, dot);
  let frac = if dot == mantissa.len() { b"" } else { mantissa.slice(dot + 1, mantissa.len()) };
  let digits = whole.concat(frac);
  let point = whole.len() + exp;
  let lead = digits.scan(0, b"0", digits.len());
  let trail = trailing_zeros(digits);
  if lead == digits.len() { b"0" } else {
    let sig = digits.slice(lead, digits.len() - trail);
    let parser = point - lead;
    if parser <= 0 {
      Bytes::concat_all([b"0.", Bytes::concat_all(range(0, 0 - parser).map(|_: Int| b"0")), sig])
    } else if parser >= sig.len() {
      sig.concat(Bytes::concat_all(range(0, parser - sig.len()).map(|_: Int| b"0")))
    } else { Bytes::concat_all([sig.slice(0, parser), b".", sig.slice(parser, sig.len())]) }
  }
}

fn trailing_zeros(b: Bytes) -> Int =
  range(0, b.len()).fold(0, |acc: Int, i: Int|
    if b.at(b.len() - 1 - i) == 48 && acc == i { acc + 1 } else { acc })

fn parse_signed_int(b: Bytes) -> Int =
  if b.len() == 0 { 0 }
  else if b.at(0) == 45 { 0 - int_of_digits(b.slice(1, b.len())) }
  else if b.at(0) == 43 { int_of_digits(b.slice(1, b.len())) }
  else { int_of_digits(b) }

pub fn error_here(input: Input, parser: Parser, what: Bytes) -> Parser / {abort.raise} =
  push_diagnostic(
    parser,
    error_at(
      unexpected(),
      current_span(input, parser),
      Bytes::concat_all([b"expected ", what, b", found ", describe(token_kind(input, parser))]),
      b"expected ".concat(what),
      [],
    ),
  )

pub fn unclosed(input: Input, parser: Parser, open: Span, what: Bytes) -> Parser / {abort.raise} =
  push_diagnostic(
    parser,
    error_at_and(
      unexpected(),
      current_span(input, parser),
      Bytes::concat_all([b"expected ", what, b", found ", describe(token_kind(input, parser))]),
      b"expected ".concat(what),
      open,
      b"unclosed delimiter opened here",
      [],
    ),
  )

pub fn expect(
  input: Input,
  parser: Parser,
  kind: lexer::TokenKind,
  what: Bytes,
) -> Result<ParseOutput<Span>, Parser> / {abort.raise} =
  if at_token(input, parser, kind) { Ok(advance(input, parser)) }
  else { Err(error_here(input, parser, what)) }

pub fn expect_close(
  input: Input,
  parser: Parser,
  kind: lexer::TokenKind,
  open: Span,
  what: Bytes,
) -> Result<ParseOutput<Span>, Parser> / {abort.raise} =
  if at_token(input, parser, kind) { Ok(advance(input, parser)) }
  else { Err(unclosed(input, parser, open, what)) }

pub fn expect_identifier(
  input: Input,
  parser: Parser,
  what: Bytes,
) -> Result<ParseOutput<Identifier>, Parser> / {abort.raise} =
  match token_kind(input, parser) {
    lexer::Identifier(n) -> {
      let a = advance(input, parser);
      Ok({ parser: a.parser, node: { name: n, span: a.node } })
    },
    _ -> Err(error_here(input, parser, what)),
  }

pub fn expect_binder(
  input: Input,
  parser: Parser,
  what: Bytes,
) -> Result<ParseOutput<Identifier>, Parser> / {abort.raise} =
  match token_kind(input, parser) {
    lexer::Identifier(n) -> {
      let a = advance(input, parser);
      Ok({ parser: a.parser, node: { name: n, span: a.node } })
    },
    lexer::Punctuation(s) -> if s == b"underscore" {
      let a = advance(input, parser);
      Ok({ parser: a.parser, node: { name: b"_", span: a.node } })
    } else { Err(error_here(input, parser, what)) },
    _ -> Err(error_here(input, parser, what)),
  }

pub fn expect_field_name(
  input: Input,
  parser: Parser,
  what: Bytes,
) -> Result<ParseOutput<{ name: Identifier, keyword: Bool }>, Parser> / {abort.raise} =
  match token_kind(input, parser) {
    lexer::Identifier(n) -> {
      let a = advance(input, parser);
      Ok({ parser: a.parser, node: { name: { name: n, span: a.node }, keyword: false } })
    },
    lexer::Keyword(k) -> {
      let a = advance(input, parser);
      Ok({ parser: a.parser, node: { name: { name: k, span: a.node }, keyword: true } })
    },
    _ -> Err(error_here(input, parser, what)),
  }

pub fn keyword_pun_error(parser: Parser, name: Identifier) -> Parser =
  push_diagnostic(
    parser,
    error_at(
      unexpected(),
      name.span,
      Bytes::concat_all([
        b"`",
        name.name,
        b"` names a field here, and a bare field also names a variable",
      ]),
      b"a keyword cannot name a variable",
      [
        Bytes::concat_all([
          b"write `",
          name.name,
          b": ",
          name.name,
          b"_` with a name of your own on the right",
        ]),
      ],
    ),
  )

pub fn report_duplicate_fields(parser: Parser, names: List<Identifier>) -> Parser =
  names.fold(
    { parser: parser, first: Map::new() },
    |acc: { parser: Parser, first: Map<Bytes, Span> }, name: Identifier|
      match acc.first.get(name.name) {
        Some(first) ->
          {
            parser: push_diagnostic(
              acc.parser,
              error_at_and(
                b"E0004",
                name.span,
                Bytes::concat_all([b"the field `", name.name, b"` is named twice"]),
                b"named again here",
                first,
                b"first named here",
                [b"a record names each field once"],
              ),
            ),
            first: acc.first,
          },
        None -> { parser: acc.parser, first: acc.first.insert(name.name, name.span) },
      },
  ).parser

pub fn expect_gt(
  input: Input,
  parser: Parser,
  what: Bytes,
) -> Result<ParseOutput<Span>, Parser> / {abort.raise} =
  if at_token(input, parser, token_gt()) { Ok(advance(input, parser)) }
  else if at_token(input, parser, token_ge()) {
    let s = current_span(input, parser);
    Ok({ parser: with_gt_split(parser, parser.pos), node: span_between(s.start, s.start + 1) })
  } else { Err(error_here(input, parser, what)) }

pub fn max_depth() -> Int = 128

pub fn too_deep(input: Input, parser: Parser) -> Parser =
  push_diagnostic(
    parser,
    error_at(
      unexpected(),
      current_span(input, parser),
      b"input is nested too deeply to parse",
      Bytes::concat_all([b"more than ", ascii_of_int(max_depth()), b" levels of nesting"]),
      [b"split this into smaller definitions"],
    ),
  )

pub fn comma_list<a | e>(
  input: Input,
  parser: Parser,
  close: lexer::TokenKind,
  item: (Input, Parser) -> Result<ParseOutput<a>, Parser> / e,
) -> Result<ParseOutput<List<a>>, Parser> / {abort.raise | e} =
  iterate({ parser: parser, out: [] }, input.token_count - parser.pos + 1, |s: PartialList<a>|
    if at_token(input, s.parser, close) || at_eof(input, s.parser) {
      Stop(Ok({ parser: s.parser, node: s.out }))
    } else {
      match item(input, s.parser) {
        Err(q) -> Stop(Err(q)),
        Ok(r) -> {
          let e = eat(input, r.parser, token_comma());
          if e.ok { Continue({ parser: e.parser, out: s.out.push(r.node) }) }
          else { Stop(Ok({ parser: e.parser, node: s.out.push(r.node) })) }
        },
      }
    })

pub fn qname(
  input: Input,
  parser: Parser,
  what: Bytes,
) -> Result<ParseOutput<QName>, Parser> / {abort.raise} = {
  let { parser, node: first } = expect_identifier(input, parser, what)?;
  let cc = eat(input, parser, token_coloncolon());
  if !cc.ok { Ok({ parser: cc.parser, node: bare(first) }) } else {
    let { parser, node: second } = expect_identifier(input, cc.parser, b"a name after `::`")?;
    if !at_token(input, parser, token_coloncolon()) {
      Ok({ parser: parser, node: qualified(first, second) })
    } else if starts_upper(second.name) && token_kind_at(input, parser, 2) != token_coloncolon() {
      let { parser, node: third } = expect_identifier(
        input,
        advance(input, parser).parser,
        b"a function's name after `::`",
      )?;
      Ok({
        parser: parser,
        node: qualified(first, {
          name: Bytes::concat_all([second.name, b"::", third.name]),
          span: span_to(second.span, third.span),
        }),
      })
    } else {
      Err(
        push_diagnostic(
          parser,
          error_at(
            unexpected(),
            current_span(input, parser),
            b"a qualified name has at most one `::` after its module",
            b"unexpected `::`",
            [
              b"a module binder is a single name: `import store.orders` binds `orders`, so write `orders::place`, or `orders::Order::total` for a function of a type it declares",
            ],
          ),
        ),
      )
    }
  }
}

pub fn token_lparen() -> lexer::TokenKind = lexer::Punctuation(b"lparen")
pub fn token_rparen() -> lexer::TokenKind = lexer::Punctuation(b"rparen")
pub fn token_lbrace() -> lexer::TokenKind = lexer::Punctuation(b"lbrace")
pub fn token_rbrace() -> lexer::TokenKind = lexer::Punctuation(b"rbrace")
pub fn token_lbracket() -> lexer::TokenKind = lexer::Punctuation(b"lbracket")
pub fn token_rbracket() -> lexer::TokenKind = lexer::Punctuation(b"rbracket")
pub fn token_comma() -> lexer::TokenKind = lexer::Punctuation(b"comma")
pub fn token_semi() -> lexer::TokenKind = lexer::Punctuation(b"semi")
pub fn token_colon() -> lexer::TokenKind = lexer::Punctuation(b"colon")
pub fn token_coloncolon() -> lexer::TokenKind = lexer::Punctuation(b"coloncolon")
pub fn token_dot() -> lexer::TokenKind = lexer::Punctuation(b"dot")
pub fn token_dotdot() -> lexer::TokenKind = lexer::Punctuation(b"dotdot")
pub fn token_dotdoteq() -> lexer::TokenKind = lexer::Punctuation(b"dotdoteq")
pub fn token_underscore() -> lexer::TokenKind = lexer::Punctuation(b"underscore")
pub fn token_arrow() -> lexer::TokenKind = lexer::Punctuation(b"arrow")
pub fn token_eq() -> lexer::TokenKind = lexer::Punctuation(b"eq")
pub fn token_lt() -> lexer::TokenKind = lexer::Punctuation(b"lt")
pub fn token_hashbracket() -> lexer::TokenKind = lexer::Punctuation(b"hashbracket")
pub fn token_gt() -> lexer::TokenKind = lexer::Punctuation(b"gt")
pub fn token_ge() -> lexer::TokenKind = lexer::Punctuation(b"ge")
pub fn token_minus() -> lexer::TokenKind = lexer::Punctuation(b"minus")
pub fn token_star() -> lexer::TokenKind = lexer::Punctuation(b"star")
pub fn token_slash() -> lexer::TokenKind = lexer::Punctuation(b"slash")
pub fn token_question() -> lexer::TokenKind = lexer::Punctuation(b"question")
pub fn token_hole() -> lexer::TokenKind = lexer::Punctuation(b"hole")
pub fn token_pipe() -> lexer::TokenKind = lexer::Punctuation(b"pipe")
pub fn token_pipepipe() -> lexer::TokenKind = lexer::Punctuation(b"pipepipe")

pub fn keyword_pub() -> lexer::TokenKind = lexer::Keyword(b"pub")
pub fn keyword_import() -> lexer::TokenKind = lexer::Keyword(b"import")
pub fn keyword_fn() -> lexer::TokenKind = lexer::Keyword(b"fn")
pub fn keyword_type() -> lexer::TokenKind = lexer::Keyword(b"type")
pub fn keyword_effect() -> lexer::TokenKind = lexer::Keyword(b"effect")
pub fn keyword_nondet() -> lexer::TokenKind = lexer::Keyword(b"nondet")
pub fn keyword_test() -> lexer::TokenKind = lexer::Keyword(b"test")
pub fn keyword_let() -> lexer::TokenKind = lexer::Keyword(b"let")
pub fn keyword_if() -> lexer::TokenKind = lexer::Keyword(b"if")
pub fn keyword_else() -> lexer::TokenKind = lexer::Keyword(b"else")
pub fn keyword_with() -> lexer::TokenKind = lexer::Keyword(b"with")
pub fn keyword_true() -> lexer::TokenKind = lexer::Keyword(b"true")
pub fn keyword_false() -> lexer::TokenKind = lexer::Keyword(b"false")

pub fn dump_node(span: Span, tag: Bytes) -> Bytes =
  Bytes::concat_all([ascii_of_int(span.start), b":", ascii_of_int(span.end), b":", tag, b";"])

pub fn erase_spans(dump: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    dump.split(b";").map(|u: Bytes|
      if u.len() > 0 && is_digit(u.at(0)) {
        match u.index_of(b":") {
          Some(i) -> match u.index_of_from(b":", i + 1) {
            Some(j) -> u.slice(j + 1, u.len()).concat(b";"),
            None -> u.concat(b";"),
          },
          None -> u.concat(b";"),
        }
      } else { u.concat(b";") }),
  )

pub fn dump_count(k: Int) -> Bytes = Bytes::concat_all([b"#", ascii_of_int(k), b";"])

pub fn dump_presence(present: Bool) -> Bytes = if present { b"?1;" } else { b"?0;" }

pub fn dump_word(w: Bytes) -> Bytes = Bytes::concat_all([b"%", w, b";"])

pub fn dump_payload(b: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([b"@", Bytes::of_string(b.hex_of()), b";"])

pub fn dump_list<a | e>(xs: List<a>, f: (a) -> Bytes / e) -> Bytes / e =
  dump_count(xs.len()).concat(Bytes::concat_all(xs.map(f)))

pub fn dump_opt<a | e>(o: Option<a>, f: (a) -> Bytes / e) -> Bytes / e =
  match o { None -> dump_presence(false), Some(x) -> dump_presence(true).concat(f(x)) }

pub fn dump_doc(doc: Doc) -> Bytes / {abort.raise} =
  dump_node(doc.span, b"doc").concat(dump_list(doc.lines, dump_payload))

pub fn dump_identifier(ident: Identifier) -> Bytes / {abort.raise} =
  dump_node(ident.span, b"ident").concat(dump_payload(ident.name))

pub fn dump_qualified_name(qname: QName) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_node(qname.span, b"qname"),
    dump_opt(qname.module, dump_identifier),
    dump_identifier(qname.name),
  ])

pub fn dump_label(label: Label) -> Bytes =
  Bytes::concat_all([
    b"=",
    ascii_of_int(label.start),
    b":",
    ascii_of_int(label.end),
    b":",
    if label.primary { b"1" } else { b"0" },
    b";",
  ])

pub fn dump_diagnostic(diagnostic: ParseDiagnostic) -> Bytes = {
  let s = primary_span_of(diagnostic);
  Bytes::concat_all([
    b"!",
    diagnostic.code,
    b":",
    ascii_of_int(s.start),
    b":",
    ascii_of_int(s.end),
    b":",
    ascii_of_int(diagnostic.labels.len()),
    b":",
    ascii_of_int(diagnostic.notes),
    b";",
  ]).concat(
    Bytes::concat_all(diagnostic.labels.map(dump_label)),
  )
}

pub fn dump_diagnostics(diagnostics: List<ParseDiagnostic>) -> Bytes =
  dump_count(diagnostics.len()).concat(Bytes::concat_all(diagnostics.map(dump_diagnostic)))

fn probe(src: Bytes) -> ParseStart / {abort.raise} = start(src)

pub fn qualified_name_text(qname: QName) -> Bytes =
  match qname.module {
    Some(m) -> Bytes::concat_all([m.name, b"::", qname.name.name]),
    None -> qname.name.name,
  }

pub fn is_bare(qname: QName) -> Bool = match qname.module { None -> true, Some(_) -> false }

pub fn no_module() -> Int = 4294967295

test "the token buffer is indexed from zero and ends with the EOF token" {
  let s = probe(b"fn f");
  assert_eq(s.input.token_count, 3);
  assert_eq(token_kind_at(s.input, s.parser, 0), lexer::Keyword(b"fn"));
  assert_eq(token_kind_at(s.input, s.parser, 1), lexer::Identifier(b"f"));
  assert_eq(token_kind_at(s.input, s.parser, 2), lexer::EndOfInput);
}

test "lookahead past the end clamps to the last token rather than failing" {
  let s = probe(b"fn");
  assert_eq(token_kind_at(s.input, s.parser, 7), lexer::EndOfInput);
  assert_eq(span_at(s.input, s.parser, 7).start, 2);
}

test "advance stops at the last token, so a parser at EOF cannot run away" {
  let s = probe(b"fn");
  let a = advance(s.input, advance(s.input, advance(s.input, s.parser).parser).parser);
  assert_eq(a.parser.pos, 1);
  assert_eq(at_eof(s.input, a.parser), true);
}

test "prev_span at position zero is the first token, as saturating_sub says" {
  let s = probe(b"fn f");
  assert_eq(previous_span(s.input, s.parser).start, 0);
  assert_eq(previous_span(s.input, advance(s.input, s.parser).parser).end, 2);
}

test "a float literal is carried as the raw source over its span" {
  let s = probe(b"1.50");
  assert_eq(token_bytes(s.input, token_at(s.input, s.parser, 0)), b"1.50");
}

test "expect_gt splits a `>=` into `>` and leaves an `=` where it stood" {
  let s = probe(b">= x");
  let g = parsed_or(expect_gt(s.input, s.parser, b"`>`"), dummy_span());
  assert_eq(g.node.start, 0);
  assert_eq(g.node.end, 1);
  assert_eq(g.parser.pos, 0);
  assert_eq(token_kind(s.input, g.parser), token_eq());
  assert_eq(current_span(s.input, g.parser).start, 1);
  assert_eq(current_span(s.input, g.parser).end, 2);
  let a = advance(s.input, g.parser);
  assert_eq(previous_span(s.input, a.parser).start, 1);
  assert_eq(token_kind(s.input, a.parser), lexer::Identifier(b"x"));
}

test "two diagnostics with the same code and primary span collapse to one" {
  let s = probe(b"fn f");
  let a = error_here(s.input, s.parser, b"one");
  let b = push_diagnostic(a, error_at(unexpected(), current_span(s.input, s.parser), b"", b"", []));
  assert_eq(b.diagnostics.len(), 1);
  let c2 = push_diagnostic(a, error_at(unexpected(), span_between(9, 9), b"", b"", []));
  assert_eq(c2.diagnostics.len(), 2);
  let d = push_diagnostic(
    a,
    error_at(unterminated(), current_span(s.input, s.parser), b"", b"", []),
  );
  assert_eq(d.diagnostics.len(), 2);
}

test "the dedup rule sees the last lexer diagnostic, not only parser ones" {
  let s = probe(b"$");
  assert_eq(s.parser.diagnostics.len(), 1);
  let last = match s.parser.diagnostics.at(s.parser.diagnostics.len() - 1) {
    Some(l) -> l,
    None -> error_at(b"", dummy_span(), b"", b"", []),
  };
  assert_eq(last.code, b"E0001");
  assert_eq(primary_span_of(last).start, 0);
  let q = push_diagnostic(s.parser, error_at(unexpected(), span_between(0, 1), b"", b"", []));
  assert_eq(q.diagnostics.len(), 1);
}

test "an unclosed delimiter carries a secondary label at the opener" {
  let s = probe(b"( ]");
  let u = unclosed(s.input, at_pos(s.parser, 1), span_between(0, 1), b"`)`");
  assert_eq(u.diagnostics.len(), 1);
  assert_eq(dump_diagnostics(u.diagnostics), b"#1;!E0001:2:3:2:0;=2:3:1;=0:1:0;");
}

test "nesting too deep is rejected where it would go deeper, and the diagnostic carries its note" {
  let s = probe(b"fn");
  assert_eq(s.input.room, max_depth());
  assert_eq(dump_diagnostics(too_deep(s.input, s.parser).diagnostics), b"#1;!E0001:0:2:1:1;=0:2:1;")
}

fn a_name(input: Input, parser: Parser) -> Result<ParseOutput<Identifier>, Parser> / {abort.raise} =
  expect_identifier(input, parser, b"a name")

fn idents(r: Result<ParseOutput<List<Identifier>>, Parser>) -> ParseOutput<List<Identifier>> =
  parsed_or(r, [])

test "comma_list reads a comma-separated run and stops at its closer" {
  let s = probe(b"a, b, c)");
  let r = idents(comma_list(s.input, s.parser, token_rparen(), a_name));
  assert_eq(r.node.len(), 3);
  assert_eq(at_token(s.input, r.parser, token_rparen()), true);
  assert_eq(failed(comma_list(s.input, s.parser, token_rparen(), a_name)), false);
}

test "comma_list accepts an empty run and a trailing comma" {
  let s = probe(b")");
  assert_eq(idents(comma_list(s.input, s.parser, token_rparen(), a_name)).node.len(), 0);
  let t = probe(b"a, )");
  let r = idents(comma_list(t.input, t.parser, token_rparen(), a_name));
  assert_eq(r.node.len(), 1);
  assert_eq(at_token(t.input, r.parser, token_rparen()), true);
}

test "comma_list stops at end of input rather than running off the buffer" {
  let s = probe(b"a, b,");
  let r = idents(comma_list(s.input, s.parser, token_rparen(), a_name));
  assert_eq(r.node.len(), 2);
  assert_eq(at_eof(s.input, r.parser), true);
  assert_eq(failed(comma_list(s.input, s.parser, token_rparen(), a_name)), false);
  assert_eq(r.parser.diagnostics.len(), 0);
}

test "two elements with no comma between them are one element and a stop" {
  let s = probe(b"a b)");
  let r = idents(comma_list(s.input, s.parser, token_rparen(), a_name));
  assert_eq(r.node.len(), 1);
  assert_eq(token_kind(s.input, r.parser), lexer::Identifier(b"b"));
  assert_eq(failed(comma_list(s.input, s.parser, token_rparen(), a_name)), false);
}

test "an element that fails abandons the list and propagates the failure" {
  let s = probe(b"a, 1, c)");
  let r = comma_list(s.input, s.parser, token_rparen(), a_name);
  assert_eq(failed(r), true);
  assert_eq(parsed_or(r, []).parser.diagnostics.len(), 1);
  assert_eq(parsed_or(r, []).node.len(), 0);
}

test "a list emits its length, so a dropped element shifts what follows" {
  let xs = [{ name: b"a", span: span_between(0, 1) }, { name: b"b", span: span_between(2, 3) }];
  assert_eq(dump_list(xs, dump_identifier), b"#2;0:1:ident;@61;2:3:ident;@62;");
  assert_eq(dump_list([], dump_identifier), b"#0;");
}

test "span_to covers both spans whichever order they arrive in" {
  assert_eq(span_to(span_between(5, 10), span_between(20, 25)), span_between(5, 25));
  assert_eq(span_to(span_between(20, 25), span_between(5, 10)), span_between(5, 25));
}

test "the primary span is the first primary label, not the first label" {
  let two = parse_diagnostic(
    unexpected(),
    b"",
    [parse_label(span_between(7, 8), false, b""), parse_label(span_between(1, 2), true, b"")],
    [],
  );
  assert_eq(primary_span_of(two), span_between(1, 2));
  let none = parse_diagnostic(unexpected(), b"", [parse_label(span_between(7, 8), false, b"")], []);
  assert_eq(primary_span_of(none), span_between(7, 8));
}

test "a diagnostic names the token it found the way the reference does" {
  let s = probe(b"fn 1.50 255u8 1.5m \"s\" b\"b\" ) x");
  assert_eq(describe(token_kind_at(s.input, s.parser, 0)), b"keyword `fn`");
  assert_eq(describe(token_kind_at(s.input, s.parser, 1)), b"float `1.5`");
  assert_eq(describe(token_kind_at(s.input, s.parser, 2)), b"`U8` literal `255`");
  assert_eq(describe(token_kind_at(s.input, s.parser, 3)), b"decimal `1.5`");
  assert_eq(describe(token_kind_at(s.input, s.parser, 4)), b"string literal");
  assert_eq(describe(token_kind_at(s.input, s.parser, 5)), b"byte-string literal");
  assert_eq(describe(token_kind_at(s.input, s.parser, 6)), b"`)`");
  assert_eq(describe(token_kind_at(s.input, s.parser, 7)), b"identifier `x`");
  assert_eq(describe(token_kind_at(s.input, s.parser, 8)), b"end of file");
  assert_eq(float_display(b"1e9"), b"1000000000");
  assert_eq(float_display(b"2.5e-3"), b"0.0025");
  assert_eq(float_display(b"007.50"), b"7.5");
  assert_eq(float_display(b"0.0"), b"0");
  assert_eq(render_decimal(b"5", 3), b"0.005");
  assert_eq(render_decimal(b"150", 2), b"1.50");
  let e = error_here(s.input, s.parser, b"a type");
  let d = match e.diagnostics.at(0) { Some(x) -> x, None -> parse_diagnostic(b"", b"", [], []) };
  assert_eq(d.message, b"expected a type, found keyword `fn`");
  assert_eq(match d.labels.at(0) { Some(l) -> l.text, None -> b"" }, b"expected a type");
}

test "at_ident_text matches an identifier and never a keyword" {
  let s = probe(b"law type");
  assert_eq(at_identifier_text(s.input, s.parser, b"law"), true);
  assert_eq(at_identifier_text(s.input, s.parser, b"lav"), false);
  assert_eq(is_identifier(s.input, s.parser), true);
  let n = advance(s.input, s.parser).parser;
  assert_eq(at_identifier_text(s.input, n, b"type"), false);
  assert_eq(is_identifier(s.input, n), false);
  assert_eq(at_token(s.input, n, keyword_type()), true);
}

test "starts_upper is the constructor-versus-binder decision, on ASCII" {
  assert_eq(starts_upper(b"Some"), true);
  assert_eq(starts_upper(b"Z"), true);
  assert_eq(starts_upper(b"A"), true);
  assert_eq(starts_upper(b"some"), false);
  assert_eq(starts_upper(b"_x"), false);
  assert_eq(starts_upper(b"["), false);
  assert_eq(starts_upper(b"a"), false);
  assert_eq(starts_upper(b""), false);
}

test "is_str is a string literal and not a byte string" {
  let s = probe(b"\"a\" b\"a\" x");
  assert_eq(is_string(s.input, s.parser), true);
  assert_eq(is_string(s.input, bump(s.input, s.parser)), false);
  assert_eq(is_string(s.input, bump(s.input, bump(s.input, s.parser))), false);
}

test "bump moves one token and dump_bool tells the two booleans apart" {
  let s = probe(b"a b");
  assert_eq(token_kind(s.input, bump(s.input, s.parser)), lexer::Identifier(b"b"));
  assert_eq(dump_bool(true), b"%true;");
  assert_eq(dump_bool(false), b"%false;");
}

test "the dump encoder emits printable ASCII with no quote and no backslash" {
  let d = Bytes::concat_all([
    dump_node(span_between(3, 9), b"efoo"),
    dump_count(2),
    dump_presence(true),
    dump_presence(false),
    dump_word(b"pub"),
    dump_payload(b"a\"b\\c\n"),
    dump_identifier({ name: b"x", span: span_between(0, 1) }),
  ]);
  assert_eq(d, b"3:9:efoo;#2;?1;?0;%pub;@6122625c630a;0:1:ident;@78;");
}

test "a qualified name and a bare one differ in the option, not only the span" {
  let s = probe(b"orders::place");
  let q = parsed_or(qname(s.input, s.parser, b"a name"), no_qualified_name());
  assert_eq(
    dump_qualified_name(q.node),
    b"0:13:qname;?1;0:6:ident;@6f7264657273;8:13:ident;@706c616365;",
  );
  let t = probe(b"place");
  let b = parsed_or(qname(t.input, t.parser, b"a name"), no_qualified_name());
  assert_eq(dump_qualified_name(b.node), b"0:5:qname;?0;0:5:ident;@706c616365;");
}

test "a name with two `::` is a diagnostic with a note, and fails" {
  let s = probe(b"a::b::c");
  let q = qname(s.input, s.parser, b"a name");
  assert_eq(failed(q), true);
  assert_eq(
    dump_diagnostics(parsed_or(q, no_qualified_name()).parser.diagnostics),
    b"#1;!E0001:4:6:1:1;=4:6:1;",
  );
}

pub fn tuple_field_name(i: Int, span: Span) -> Identifier =
  { name: b"_".concat(Bytes::of_string(i.to_string())), span: span }
