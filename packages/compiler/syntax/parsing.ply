import compiler.syntax.lexer
import std.bin
import std.bytes (hex_digit, ascii_of_int, is_digit)
import compiler.syntax.lexer (int_of_digits)

pub type Span = { start: Int, end: Int, site: Int }

derive bin for Span
derive bin for Identifier
derive bin for QName

pub type Identifier = { name: Bytes, span: Span }

pub type QName = { module: Option<Identifier>, name: Identifier, span: Span }

pub type Doc = { lines: List<Bytes>, span: Span }

pub fn dummy_span() -> Span = { start: 0, end: 0, site: 0 }

pub fn moved_by(s: Span, by: Int) -> Span =
  if s == dummy_span() { s } else { { ..s, start: s.start + by, end: s.end + by } }

pub fn span_between(s: Int, e: Int) -> Span = { start: s, end: e, site: 0 }

pub fn span_to(a: Span, b: Span) -> Span =
  {
    start: if a.start < b.start { a.start } else { b.start },
    end: if a.end > b.end { a.end } else { b.end },
    site: 0,
  }

pub fn span_key(span: Span) -> Bytes =
  if span.site == 0 { Bytes::concat_all([ascii_of_int(span.start), b":", ascii_of_int(span.end)]) }
  else {
    Bytes::concat_all([
      ascii_of_int(span.start),
      b":",
      ascii_of_int(span.end),
      b":",
      ascii_of_int(span.site),
    ])
  }

pub fn node_id_base() -> Int = 1048576

pub fn synthetic_span(at: Span, k: Int) -> Span = { ..at, site: at.site * node_id_base() + k }

pub fn is_synthetic_site(site: Int) -> Bool = site >= node_id_base()

pub fn synthetic_span_at(at: Span, from: Span, k: Int) -> Span =
  { ..at, site: synthetic_span(from, k).site }

pub fn synthetic_too_deep(site: Int) -> Bool =
  site < 0 || site >= node_id_base() * node_id_base() * node_id_base()

pub fn role_case_block() -> Int = 1
pub fn role_case_table_let() -> Int = 2
pub fn role_case_table_binder() -> Int = 3
pub fn role_case_call() -> Int = 4
pub fn role_case_callee() -> Int = 5
pub fn role_case_table_read() -> Int = 6
pub fn role_case_label_lambda() -> Int = 7
pub fn role_case_label_param() -> Int = 8
pub fn role_case_let() -> Int = 9
pub fn role_case_binder() -> Int = 10
pub fn role_case_index_read() -> Int = 11
pub fn role_case_identity_read() -> Int = 12

pub fn role_tag_let() -> Int = 13
pub fn role_tag_binder() -> Int = 15
pub fn role_tag_parse() -> Int = 16
pub fn role_tag_parser() -> Int = 17
pub fn role_tag_texts() -> Int = 18
pub fn role_tag_read() -> Int = 19
pub fn role_tag_fill() -> Int = 20
pub fn role_tag_filler() -> Int = 21
pub fn role_tag_holes() -> Int = 22

pub fn role_member_receiver() -> Int = 23
pub fn role_member_callee() -> Int = 24
pub fn role_member_field() -> Int = 25

pub fn role_try_return() -> Int = 30
pub fn role_try_clause() -> Int = 31
pub fn role_try_ok() -> Int = 32
pub fn role_try_err() -> Int = 33
pub fn role_try_arguments_record() -> Int = 34
pub fn role_try_ok_call() -> Int = 35
pub fn role_try_err_call() -> Int = 36
pub fn role_try_value() -> Int = 37
pub fn role_try_unit() -> Int = 38
pub fn role_try_arg(i: Int) -> Int = 512 + i

pub fn role_try_value_binder() -> Int = 95
pub fn role_try_raised(i: Int) -> Int = 768 + i

pub fn role_constant_read() -> Int = 96

pub fn role_scope_acquire_let() -> Int = 39
pub fn role_scope_acquire_binder() -> Int = 40
pub fn role_scope_acquire() -> Int = 41
pub fn role_scope_release_let() -> Int = 42
pub fn role_scope_release_binder() -> Int = 43
pub fn role_scope_release() -> Int = 44
pub fn role_scope_release_param() -> Int = 45
pub fn role_scope_release_call() -> Int = 46
pub fn role_scope_release_scoped_read() -> Int = 47
pub fn role_scope_bracket() -> Int = 48
pub fn role_scope_bracket_callee() -> Int = 49
pub fn role_scope_open() -> Int = 50
pub fn role_scope_new() -> Int = 51
pub fn role_scope_new_callee() -> Int = 52
pub fn role_scope_acquired() -> Int = 53
pub fn role_scope_acquire_read() -> Int = 54
pub fn role_scope_close() -> Int = 55
pub fn role_scope_close_param() -> Int = 56
pub fn role_scope_close_call() -> Int = 57
pub fn role_scope_release_read() -> Int = 58
pub fn role_scope_take() -> Int = 59
pub fn role_scope_take_callee() -> Int = 60
pub fn role_scope_take_scoped_read() -> Int = 61
