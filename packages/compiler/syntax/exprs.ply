// --- The tree ---------------------------------------------------------------

pub type Expr =
  | ELit({ span: Span, lit: Lit })
  | EVar({ span: Span, name: QName })
  | EBinary({ span: Span, op: Bytes, lhs: Expr, rhs: Expr })
  | EUnary({ span: Span, op: Bytes, operand: Expr })
  | ELambda({ span: Span, body: Expr, params: List<Param>, ret: Option<TypeExpr> })
  /// `labels` are the resource labels written at the call: `relay[conn](c)`.
  | EApp({ span: Span, func: Expr, named: List<NamedArg>, args: List<Expr>, labels: List<Ident> })
  | EIf({ span: Span, cond: Expr, then_branch: Expr, else_branch: Expr })
  | EMatch({ span: Span, scrutinee: Expr, arms: List<MatchArm> })
  | EBlock({ span: Span, tail: Option<Expr>, stmts: List<Stmt> })
  | ERecord({ span: Span, fields: List<RecField> })
  | ERecordUpdate({ span: Span, base: Expr, fields: List<RecField> })
  | ETry({ span: Span, operand: Expr })
  | EField({ span: Span, base: Expr, field: Ident })
  | EList({ span: Span, items: List<Expr> })
  | EPerform({ span: Span, eff: QName, op: Ident, resource: Option<Ident>, args: List<Expr> })
  | EHandle({ span: Span, body: Expr, ret: Option<ReturnClause>, clauses: List<HandleClause>, vars: List<HandlerVar> })
  /// `with_hold[r](acquire, release) { h -> body }`: `body` with `h` a hold on what `acquire`
  /// answered, and `release` run on it however `body` ends.
  | EWithHold({ span: Span, resource: Ident, acquire: Expr, release: Expr, binder: Ident, body: Expr })
  | ESimulate({ span: Span, body: Expr })
  /// `parallel { a, b }`: the branches' answers as a tuple, which means evaluating them left to right.
  | EParallel({ span: Span, branches: List<Expr> })
  /// `tag"text"`: the call `tag::literal("text")` a check ran, read as the value it answered. With
  /// holes, the call of `tag::fill` on what `tag::compile` answered a check for the texts, and on
  /// the holes.
  | ETagged(Tagged)
  /// `???`, or `..` where a definition's body is not written yet: an unfilled hole, which checks
  /// as any type, reports what it must be, and raises `abort.raise` if a run reaches it. `text`
  /// is the spelling written.
  | EHole({ span: Span, text: Bytes })
  | EBad({ span: Span })
  /// `try { body }`: `Ok` of what the body answers, or `Err` of what one raise in it carried. With
  /// no `raise` written, the checker reads which one off the body's row.
  | ETryBlock({ span: Span, raise: Option<RaiseName>, body: Expr })

pub type RaiseName = { eff: QName, op: Ident }

/// A tagged literal as it is written: `text` is what its string reads as up to its first hole, and
/// `quoted` that much of the string, from its opening quote through the `{` or the `"` that ends
/// the text, which `span` outgrows inside parentheses.
pub type Tagged = { span: Span, tag: Ident, text: Bytes, quoted: Span, holes: List<Hole> }

/// A hole of a tagged literal and the text after it: `quoted` runs from the `}` that closes the
/// hole through the `{` or the `"` that ends the text.
pub type Hole = { value: Expr, text: Bytes, quoted: Span }

pub type RecField = { name: Ident, value: Expr }

pub type NamedArg = { name: Ident, value: Expr, span: Span }

type Arg = | APos(Expr) | ANamed(NamedArg)

/// Why a named argument fills nothing: it names no parameter, or one an argument before it filled.
pub type Unplaced = | NoSuchParameter | FilledByPosition | GivenByName

/// What a call passes a parameter: its positional argument or its named argument at a place, or
/// the parameter's default.
pub type Slot = | FromArg(Int) | FromName(Int) | FromDefault(Expr)

/// A call's arguments put where its callee's parameters are: `slots` one per parameter in order
/// where `missing` names none, the named arguments that fill nothing, and the parameters left
/// with neither an argument nor a default.
pub type Slotted = {
  slots: List<Slot>,
  unplaced: List<{ arg: NamedArg, why: Unplaced }>,
  missing: List<Bytes>,
}

/// `args` and then `named` put where a callee's parameters are, `names` each parameter's name and
/// `defaults` what a call that leaves it out passes. A default the call at `at` takes stands at a
/// place of its own there (`placed_default`).
pub fn slotted(
  names: List<Bytes>,
  defaults: List<Option<Expr>>,
  args: List<Expr>,
  named: List<NamedArg>,
  at: Span,
) -> Slotted = {
  let index = |name: Bytes|
    range(0, names.len()).fold(None, |found: Option<Int>, i: Int|
      match found {
        Some(_) -> found,
        None -> if names.at(i) == Some(name) { Some(i) } else { None },
      });
  let placed = range(0, named.len()).fold(
    { taken: [], unplaced: [] },
    |acc: { taken: List<{ at: Int, from: Int }>, unplaced: List<{ arg: NamedArg, why: Unplaced }> }, j: Int|
      match named.at(j) {
        None -> acc,
        Some(arg) -> {
          let refused = |why: Unplaced|
            { ..acc, unplaced: acc.unplaced.push({ arg: arg, why: why }) };
          match index(arg.name.name) {
            None -> refused(NoSuchParameter),
            Some(i) -> if i < args.len() { refused(FilledByPosition) }
            else if acc.taken.fold(false, |b: Bool, t: { at: Int, from: Int }| b || t.at == i) {
              refused(GivenByName)
            } else { { ..acc, taken: acc.taken.push({ at: i, from: j }) } },
          }
        },
      },
  );
  range(0, names.len()).fold(
    { slots: [], unplaced: placed.unplaced, missing: [] },
    |acc: Slotted, i: Int| {
      let by_name = placed.taken.fold(None, |found: Option<Int>, t: { at: Int, from: Int }|
        if t.at == i { Some(t.from) } else { found });
      if i < args.len() { { ..acc, slots: acc.slots.push(FromArg(i)) } } else {
        match ((by_name, defaults.at(i))) {
          (Some(j), _) -> { ..acc, slots: acc.slots.push(FromName(j)) },
          (None, Some(Some(d))) ->
            { ..acc, slots: acc.slots.push(FromDefault(placed_default(d, at, i))) },
          _ ->
            { ..acc, missing: acc.missing.push(match names.at(i) { Some(n) -> n, None -> b"" }) },
        }
      }
    },
  )
}

/// The arguments `slots` pass, out of a call's `args` and `named`.
pub fn slot_args(slots: List<Slot>, args: List<Expr>, named: List<NamedArg>) -> List<Expr> =
  slots.fold([], |acc: List<Expr>, slot: Slot|
    match slot {
      FromArg(i) -> match args.at(i) { Some(x) -> acc.push(x), None -> acc },
      FromName(j) -> match named.at(j) { Some(n) -> acc.push(n.value), None -> acc },
      FromDefault(d) -> acc.push(d),
    })

/// `copied`, the default the call at `at` takes for its parameter `slot`, with every place in it at
/// `at`: what a check files of one call's copy is that call's own, and formatting the default moves
/// none of it. Copied before its call's item is numbered, it is numbered with the item; after, each
/// of its nodes is minted from the call, by the parameter and the node's place in a walk of it.
fn placed_default(copied: Expr, at: Span, slot: Int) -> Expr =
  placed_expr({ at: at, base: role_member_default(slot) }, copied, 0).e

type Placing = { at: Span, base: Int }

type PlacedExpr = { e: Expr, n: Int }

type PlacedExprs = { es: List<Expr>, n: Int }

type PlacedPat = { p: Pattern, n: Int }

type PlacedPats = { ps: List<Pattern>, n: Int }

fn place(pl: Placing, n: Int) -> Span =
  if pl.at.site == 0 { pl.at } else { minted(pl.at, pl.base + n) }

fn ident_placed(i: Ident, s: Span) -> Ident = { name: i.name, span: { ..s, site: 0 } }

fn qname_placed(q: QName, s: Span) -> QName =
  {
    module: match q.module { Some(m) -> Some(ident_placed(m, s)), None -> None },
    name: ident_placed(q.name, s),
    span: s,
  }

/// `e` placed as `placed_default` places a default, its walk starting at `n`; how far it got.
fn placed_expr(pl: Placing, e: Expr, n: Int) -> PlacedExpr = {
  let s = place(pl, n);
  let each = |xs: List<Expr>, from: Int|
    xs.fold({ es: [], n: from }, |acc: PlacedExprs, x: Expr| {
      let o: PlacedExpr = placed_expr(pl, x, acc.n);
      { es: acc.es.push(o.e), n: o.n }
    });
  let fields = |fs: List<RecField>, from: Int|
    fs.fold({ fs: [], n: from }, |acc: { fs: List<RecField>, n: Int }, f: RecField| {
      let v: PlacedExpr = placed_expr(pl, f.value, acc.n + 1);
      { fs: acc.fs.push({ name: ident_placed(f.name, place(pl, acc.n)), value: v.e }), n: v.n }
    });
  let maybe = |x: Option<Expr>, from: Int|
    match x {
      Some(y) -> {
        let o: PlacedExpr = placed_expr(pl, y, from);
        { e: Some(o.e), n: o.n }
      },
      None -> { e: None, n: from },
    };
  match e {
    ELit(l) -> { e: ELit({ span: s, lit: l.lit }), n: n + 1 },
    EVar(v) -> { e: EVar({ span: s, name: qname_placed(v.name, s) }), n: n + 1 },
    EBinary(b) -> {
      let l: PlacedExpr = placed_expr(pl, b.lhs, n + 1);
      let r: PlacedExpr = placed_expr(pl, b.rhs, l.n);
      { e: EBinary({ span: s, op: b.op, lhs: l.e, rhs: r.e }), n: r.n }
    },
    EUnary(u) -> {
      let o: PlacedExpr = placed_expr(pl, u.operand, n + 1);
      { e: EUnary({ span: s, op: u.op, operand: o.e }), n: o.n }
    },
    ELambda(l) -> {
      let ps = l.params.fold({ ps: [], n: n + 1 }, |acc: { ps: List<Param>, n: Int }, q: Param| {
        let at = place(pl, acc.n);
        { ps: acc.ps.push({ ..q, name: ident_placed(q.name, at), span: at }), n: acc.n + 1 }
      });
      let body: PlacedExpr = placed_expr(pl, l.body, ps.n);
      { e: ELambda({ span: s, body: body.e, params: ps.ps, ret: l.ret }), n: body.n }
    },
    EApp(a) -> {
      let f: PlacedExpr = placed_expr(pl, a.func, n + 1);
      let xs: PlacedExprs = each(a.args, f.n);
      let ns = a.named.fold(
        { ns: [], n: xs.n },
        |acc: { ns: List<NamedArg>, n: Int }, arg: NamedArg| {
          let o: PlacedExpr = placed_expr(pl, arg.value, acc.n);
          { ns: acc.ns.push({ name: ident_placed(arg.name, s), value: o.e, span: s }), n: o.n }
        },
      );
      {
        e: EApp({
          span: s,
          func: f.e,
          named: ns.ns,
          args: xs.es,
          labels: a.labels.map(|i: Ident| ident_placed(i, s)),
        }),
        n: ns.n,
      }
    },
    EIf(i) -> {
      let c: PlacedExpr = placed_expr(pl, i.cond, n + 1);
      let t: PlacedExpr = placed_expr(pl, i.then_branch, c.n);
      let el: PlacedExpr = placed_expr(pl, i.else_branch, t.n);
      { e: EIf({ span: s, cond: c.e, then_branch: t.e, else_branch: el.e }), n: el.n }
    },
    EMatch(m) -> {
      let sc: PlacedExpr = placed_expr(pl, m.scrutinee, n + 1);
      let arms = m.arms.fold(
        { arms: [], n: sc.n },
        |acc: { arms: List<MatchArm>, n: Int }, arm: MatchArm| {
          let pt: PlacedPat = placed_pat(pl, arm.pat, acc.n + 1);
          let g: { e: Option<Expr>, n: Int } = maybe(arm.guard, pt.n);
          let b: PlacedExpr = placed_expr(pl, arm.body, g.n);
          {
            arms: acc.arms.push({ pat: pt.p, guard: g.e, body: b.e, span: place(pl, acc.n) }),
            n: b.n,
          }
        },
      );
      { e: EMatch({ span: s, scrutinee: sc.e, arms: arms.arms }), n: arms.n }
    },
    EBlock(b) -> {
      let st = b.stmts.fold(
        { stmts: [], n: n + 1 },
        |acc: { stmts: List<Stmt>, n: Int }, stmt: Stmt|
          match stmt {
            SLet(l) -> {
              let pt: PlacedPat = placed_pat(pl, l.pat, acc.n + 1);
              let v: PlacedExpr = placed_expr(pl, l.value, pt.n);
              {
                stmts: acc.stmts.push(
                  SLet({ span: place(pl, acc.n), pat: pt.p, ty: l.ty, value: v.e }),
                ),
                n: v.n,
              }
            },
            SLetElse(l) -> {
              let pt: PlacedPat = placed_pat(pl, l.pat, acc.n + 1);
              let v: PlacedExpr = placed_expr(pl, l.value, pt.n);
              let fb: PlacedExpr = placed_expr(pl, l.fallback, v.n);
              {
                stmts: acc.stmts.push(
                  SLetElse({
                    span: place(pl, acc.n),
                    pat: pt.p,
                    ty: l.ty,
                    value: v.e,
                    fallback: fb.e,
                  }),
                ),
                n: fb.n,
              }
            },
            SExpr(x) -> {
              let o: PlacedExpr = placed_expr(pl, x, acc.n);
              { stmts: acc.stmts.push(SExpr(o.e)), n: o.n }
            },
            SAssign(x) -> {
              let at = place(pl, acc.n);
              let v: PlacedExpr = placed_expr(pl, x.value, acc.n + 1);
              {
                stmts: acc.stmts.push(
                  SAssign({ span: at, name: ident_placed(x.name, at), value: v.e }),
                ),
                n: v.n,
              }
            },
          },
      );
      let t: { e: Option<Expr>, n: Int } = maybe(b.tail, st.n);
      { e: EBlock({ span: s, tail: t.e, stmts: st.stmts }), n: t.n }
    },
    ERecord(r) -> {
      let fs: { fs: List<RecField>, n: Int } = fields(r.fields, n + 1);
      { e: ERecord({ span: s, fields: fs.fs }), n: fs.n }
    },
    ERecordUpdate(r) -> {
      let base: PlacedExpr = placed_expr(pl, r.base, n + 1);
      let fs: { fs: List<RecField>, n: Int } = fields(r.fields, base.n);
      { e: ERecordUpdate({ span: s, base: base.e, fields: fs.fs }), n: fs.n }
    },
    ETry(t) -> {
      let o: PlacedExpr = placed_expr(pl, t.operand, n + 1);
      { e: ETry({ span: s, operand: o.e }), n: o.n }
    },
    EField(f) -> {
      let base: PlacedExpr = placed_expr(pl, f.base, n + 1);
      {
        e: EField({ span: s, base: base.e, field: ident_placed(f.field, place(pl, base.n)) }),
        n: base.n + 1,
      }
    },
    EList(l) -> {
      let xs: PlacedExprs = each(l.items, n + 1);
      { e: EList({ span: s, items: xs.es }), n: xs.n }
    },
    EBad(_) -> { e: EBad({ span: s }), n: n + 1 },
    EHole(h) -> { e: EHole({ span: s, text: h.text }), n: n + 1 },
    // No default holds a perform, a handle, a hold, a region, a tagged literal or a `try` block.
    _ -> { e: e, n: n + 1 },
  }
}

/// `p` placed as `placed_expr` places the expression it stands in.
fn placed_pat(pl: Placing, p: Pattern, n: Int) -> PlacedPat = {
  let s = place(pl, n);
  let each = |ps: List<Pattern>, from: Int|
    ps.fold({ ps: [], n: from }, |acc: PlacedPats, x: Pattern| {
      let o: PlacedPat = placed_pat(pl, x, acc.n);
      { ps: acc.ps.push(o.p), n: o.n }
    });
  match p {
    PWild(_) -> { p: PWild({ span: s }), n: n + 1 },
    PVar(v) -> { p: PVar({ span: s, name: ident_placed(v.name, s) }), n: n + 1 },
    PLit(l) -> { p: PLit({ span: s, lit: l.lit }), n: n + 1 },
    PRange(r) -> { p: PRange({ ..r, span: s }), n: n + 1 },
    PCtor(c) -> {
      let xs: PlacedPats = each(c.args, n + 1);
      { p: PCtor({ span: s, name: qname_placed(c.name, s), args: xs.ps }), n: xs.n }
    },
    PRecord(r) -> {
      let fs = r.fields.fold(
        { fs: [], n: n + 1 },
        |acc: { fs: List<{ name: Ident, pat: Pattern }>, n: Int }, f: { name: Ident, pat: Pattern }| {
          let o: PlacedPat = placed_pat(pl, f.pat, acc.n + 1);
          { fs: acc.fs.push({ name: ident_placed(f.name, place(pl, acc.n)), pat: o.p }), n: o.n }
        },
      );
      { p: PRecord({ span: s, rest: r.rest, fields: fs.fs }), n: fs.n }
    },
    PList(l) -> {
      let xs: PlacedPats = each(l.items, n + 1);
      let rest: { p: Option<Pattern>, n: Int } = match l.rest {
        Some(x) -> {
          let o: PlacedPat = placed_pat(pl, x, xs.n);
          { p: Some(o.p), n: o.n }
        },
        None -> { p: None, n: xs.n },
      };
      { p: PList({ span: s, rest: rest.p, items: xs.ps }), n: rest.n }
    },
    POr(o) -> {
      let xs: PlacedPats = each(o.alts, n + 1);
      { p: POr({ span: s, alts: xs.ps }), n: xs.n }
    },
    PBad(_) -> { p: PBad({ span: s }), n: n + 1 },
  }
}

/// A parameter; only a `fn` parameter may carry a `default`, or name with `cost` the steps a call of
/// it takes and with `space` the memory a call of it holds, which only that definition's `cost` and
/// `space` clauses read.
pub type Param = {
  name: Ident,
  /// Written `keep`: the callee takes what it is handed, holding a function past the call or
  /// consuming a resource, where a parameter of either is otherwise lent to the call.
  keep: Bool,
  ty: Option<TypeExpr>,
  cost: Option<Ident>,
  space: Option<Ident>,
  default: Option<Expr>,
  span: Span,
}

pub type Stmt =
  | SLet({ span: Span, pat: Pattern, ty: Option<TypeExpr>, value: Expr })
  /// `let p = v else { .. };`: where `parser` does not match, the `else` block is the enclosing block's
  /// value and the statements after this one do not run.
  | SLetElse({ span: Span, pat: Pattern, ty: Option<TypeExpr>, value: Expr, fallback: Expr })
  | SExpr(Expr)
  /// `name = value;`: a clause giving its handler's variable a new value.
  | SAssign({ span: Span, name: Ident, value: Expr })

pub type MatchArm = { pat: Pattern, guard: Option<Expr>, body: Expr, span: Span }

pub type HandleClause = {
  eff: QName,
  op: Ident,
  resource: Option<Ident>,
  /// `[*]`: the clause answers the operation on every label, so there is no label to name and
  /// `resource` stays `None`. This is what distinguishes it from a clause on a singleton.
  every_label: Bool,
  /// `[*t]`: the same coverage, with the label the call site named bound to `t` in the body. A
  /// clause that answers every label can otherwise answer one it should have refused.
  label_binder: Option<Ident>,
  resume: Option<Ident>,
  body: Expr,
  span: Span,
  params: List<Ident>,
}

pub type ReturnClause = { binder: Ident, body: Expr, span: Span }

/// `var name: T = init` in a `with` block: a variable the handler holds, made when its `handle`
/// starts, which its clauses assign and its `return` reads.
pub type HandlerVar = { name: Ident, ty: Option<TypeExpr>, init: Expr, span: Span }

/// A variant of its own rather than `()`, so a placeholder that reaches the dump is visible.
pub fn no_expr() -> Expr = EBad({ span: dummy_span() })

pub fn expr_span(expr: Expr) -> Span =
  match expr {
    ELit(v) -> v.span,
    EVar(v) -> v.span,
    EBinary(v) -> v.span,
    EUnary(v) -> v.span,
    ELambda(v) -> v.span,
    EApp(v) -> v.span,
    EIf(v) -> v.span,
    EMatch(v) -> v.span,
    EBlock(v) -> v.span,
    ERecord(v) -> v.span,
    ERecordUpdate(v) -> v.span,
    ETry(v) -> v.span,
    EField(v) -> v.span,
    EList(v) -> v.span,
    EPerform(v) -> v.span,
    EHandle(v) -> v.span,
    EWithHold(v) -> v.span,
    ESimulate(v) -> v.span,
    EParallel(v) -> v.span,
    ETagged(v) -> v.span,
    EHole(v) -> v.span,
    EBad(v) -> v.span,
    ETryBlock(v) -> v.span,
  }

/// The place of the closure a `simulate` written at `at` runs its body in.
pub fn simulated_at(at: Span) -> Span = minted(at, role_simulated())

/// The place of the closure a `handle` written at `at` runs its body in, where the body runs
/// detached.
pub fn detached_at(at: Span) -> Span = minted(at, role_detached())

/// The effect the `?`s of the `n`th function or typed lambda of the item written at `at` raise to
/// leave the `handle`s they stand in, which the `handle` around the outermost of those answers. No
/// source can name it.
pub fn exit_effect(at: Int, n: Int) -> Bytes =
  Bytes::concat_all([b"exit?", ascii_of_int(at), b"?", ascii_of_int(n)])

/// Whether `name` is an effect `exit_effect` names.
pub fn is_exit_effect(name: Bytes) -> Bool = name.starts_with(b"exit?")

/// The one operation of an exit effect, a raise of what the `?` exits with.
pub fn exit_op() -> Bytes = b"leave"

/// Where the parts of the `handle` a `try` written at `at` stands for are, which its check types:
/// the return clause, the raise's clause, the `Ok` and the `Err` it calls, and the record of the
/// raise's arguments the `Err` holds where it takes several.
pub type TryPlaces = { ret: Span, clause: Span, ok: Span, err: Span, carried: Span }

pub fn try_places(at: Span) -> TryPlaces =
  {
    ret: minted(at, role_try_return()),
    clause: minted(at, role_try_clause()),
    ok: minted(at, role_try_ok()),
    err: minted(at, role_try_err()),
    carried: minted(at, role_try_carried()),
  }

fn tag_fn(t: Tagged, name: Bytes, role: Int) -> QName =
  {
    module: Some(t.tag),
    name: { name: name, span: t.tag.span },
    span: { ..t.tag.span, site: minted(t.span, role).site },
  }

/// The function a tagged literal's check runs, as the literal's module names it: `literal` over
/// the text of one with no hole, and `compile` over the texts around the holes of one with any. Its
/// span is the callee's its call is written with.
pub fn tagged_parser(t: Tagged) -> QName =
  tag_fn(t, if t.holes.len() == 0 { b"literal" } else { b"compile" }, role_tag_parser())

/// The function a tagged literal's holes are handed to, with what its check answered.
pub fn tagged_filler(t: Tagged) -> QName = tag_fn(t, b"fill", role_tag_filler())

/// A text of a tagged literal and where it is written.
pub type TaggedPart = { text: Bytes, quoted: Span }

derive bin for TaggedPart

/// A tagged literal's texts in order: one more than it has holes.
pub fn tagged_parts(t: Tagged) -> List<TaggedPart> =
  t.holes.fold([{ text: t.text, quoted: t.quoted }], |parts: List<TaggedPart>, h: Hole|
    parts.push({ text: h.text, quoted: h.quoted }))

pub fn hole_values(t: Tagged) -> List<Expr> = t.holes.map(|h: Hole| h.value)

/// The literal with `values` in its holes, in order.
pub fn with_hole_values(t: Tagged, values: List<Expr>) -> Tagged / {abort.raise} =
  { ..t, holes: range(0, t.holes.len()).map(|i: Int| { ..t.holes.get(i), value: values.get(i) }) }

fn tag_call(t: Tagged, role: Int, callee: QName, args: List<Expr>) -> Expr =
  EApp({
    span: minted(t.span, role),
    func: EVar({ span: callee.span, name: callee }),
    named: [],
    args: args,
    labels: [],
  })

/// The call a tagged literal's check runs.
pub fn tagged_call(t: Tagged) -> Expr = {
  let texts = tagged_parts(t).map(|part: TaggedPart|
    ELit({ span: part.quoted, lit: LStr(part.text) }));
  tag_call(t, role_tag_parse(), tagged_parser(t), if t.holes.len() == 0 { texts }
  else { [EList({ span: minted(t.span, role_tag_texts()), items: texts })] })
}

/// The call that hands a tagged literal's holes to its tag, with what the check's call answered.
pub fn tagged_fill(t: Tagged, compiled: Expr) -> Expr =
  tag_call(t, role_tag_fill(), tagged_filler(t), [
    compiled,
    EList({ span: minted(t.span, role_tag_holes()), items: hole_values(t) }),
  ])

fn set_span(expr: Expr, span: Span) -> Expr =
  match expr {
    ELit(v) -> ELit({ span: span, lit: v.lit }),
    EVar(v) -> EVar({ span: span, name: v.name }),
    EBinary(v) -> EBinary({ span: span, op: v.op, lhs: v.lhs, rhs: v.rhs }),
    EUnary(v) -> EUnary({ span: span, op: v.op, operand: v.operand }),
    ELambda(v) -> ELambda({ span: span, body: v.body, params: v.params, ret: v.ret }),
    EApp(v) -> EApp({ span: span, func: v.func, named: v.named, args: v.args, labels: v.labels }),
    EIf(v) ->
      EIf({ span: span, cond: v.cond, then_branch: v.then_branch, else_branch: v.else_branch }),
    EMatch(v) -> EMatch({ span: span, scrutinee: v.scrutinee, arms: v.arms }),
    EBlock(v) -> EBlock({ span: span, tail: v.tail, stmts: v.stmts }),
    ERecord(v) -> ERecord({ span: span, fields: v.fields }),
    ERecordUpdate(v) -> ERecordUpdate({ span: span, base: v.base, fields: v.fields }),
    ETry(v) -> ETry({ span: span, operand: v.operand }),
    EField(v) -> EField({ span: span, base: v.base, field: v.field }),
    EList(v) -> EList({ span: span, items: v.items }),
    EPerform(v) ->
      EPerform({ span: span, eff: v.eff, op: v.op, resource: v.resource, args: v.args }),
    EHandle(v) -> EHandle({ ..v, span: span }),
    EWithHold(v) -> EWithHold({ ..v, span: span }),
    ESimulate(v) -> ESimulate({ span: span, body: v.body }),
    EParallel(v) -> EParallel({ span: span, branches: v.branches }),
    ETagged(v) -> ETagged({ ..v, span: span }),
    EHole(v) -> EHole({ span: span, text: v.text }),
    EBad(v) -> EBad({ span: span }),
    ETryBlock(v) -> ETryBlock({ ..v, span: span }),
  }

/// Ends in `}`, so it may stand as a statement without `;` and as a match arm without `,`.
pub fn is_block_like(expr: Expr) -> Bool =
  match expr {
    EBlock(v) -> true,
    EIf(v) -> true,
    EMatch(v) -> true,
    EHandle(v) -> true,
    EWithHold(v) -> true,
    ESimulate(v) -> true,
    EParallel(v) -> true,
    ETryBlock(v) -> true,
    _ -> false,
  }

// --- The precedence table ---------------------------------------------------

/// `width` is how many tokens the operator spans: a shift is touching `<`s or `>`s, as `>>` is not lexed.
type Op = { op: Bytes, bp: Int, width: Int }

fn bin_op(kind: TokenKind) -> Option<Op> =
  match kind {
    Punctuation(s) -> if s == b"pipepipe" { Some({ op: b"or", bp: 1, width: 1 }) }
    else if s == b"ampamp" { Some({ op: b"and", bp: 2, width: 1 }) }
    else if s == b"eqeq" { Some({ op: b"eq", bp: 3, width: 1 }) }
    else if s == b"bangeq" { Some({ op: b"ne", bp: 3, width: 1 }) }
    else if s == b"lt" { Some({ op: b"lt", bp: 3, width: 1 }) }
    else if s == b"le" { Some({ op: b"le", bp: 3, width: 1 }) }
    else if s == b"gt" { Some({ op: b"gt", bp: 3, width: 1 }) }
    else if s == b"ge" { Some({ op: b"ge", bp: 3, width: 1 }) }
    else if s == b"pipe" { Some({ op: b"bitor", bp: 4, width: 1 }) }
    else if s == b"caret" { Some({ op: b"bitxor", bp: 5, width: 1 }) }
    else if s == b"amp" { Some({ op: b"bitand", bp: 6, width: 1 }) }
    else if s == b"plusplus" { Some({ op: b"concat", bp: 8, width: 1 }) }
    else if s == b"plus" { Some({ op: b"add", bp: 9, width: 1 }) }
    else if s == b"minus" { Some({ op: b"sub", bp: 9, width: 1 }) }
    else if s == b"star" { Some({ op: b"mul", bp: 10, width: 1 }) }
    else if s == b"slash" { Some({ op: b"div", bp: 10, width: 1 }) }
    else if s == b"percent" { Some({ op: b"rem", bp: 10, width: 1 }) } else {
      call_operators().fold(None, |acc: Option<Op>, o: CallOperator|
        if o.token == s { Some({ op: o.name, bp: o.bp, width: 1 }) } else { acc })
    },
    _ -> None,
  }

/// An operator that is the call of a builtin: the builtin's name, the operator's token and text,
/// and the binding power of the arithmetic operator it is beside.
pub type CallOperator = { name: Bytes, token: Bytes, text: Bytes, bp: Int }

/// `+%`, `-%` and `*%` wrap at the operand type's width; `+|`, `-|` and `*|` saturate at it.
pub fn call_operators() -> List<CallOperator> =
  [
    { name: b"wrap_add", token: b"pluspercent", text: b"+%", bp: 9 },
    { name: b"wrap_sub", token: b"minuspercent", text: b"-%", bp: 9 },
    { name: b"wrap_mul", token: b"starpercent", text: b"*%", bp: 10 },
    { name: b"saturating_add", token: b"pluspipe", text: b"+|", bp: 9 },
    { name: b"saturating_sub", token: b"minuspipe", text: b"-|", bp: 9 },
    { name: b"saturating_mul", token: b"starpipe", text: b"*|", bp: 10 },
  ]

pub fn call_operator(name: Bytes) -> Option<CallOperator> =
  call_operators().fold(None, |acc: Option<CallOperator>, o: CallOperator|
    if o.name == name { Some(o) } else { acc })

/// The operator a call was written as, when the parser wrote the call for one: its callee stands
/// after its first operand, where a call spelled out has it before.
pub fn written_operator(func: Expr, args: List<Expr>) -> Option<CallOperator> =
  match ((func, args)) {
    (EVar(v), [first, _]) -> if v.name.module != None || v.span.start < expr_span(first).end {
      None
    } else { call_operator(v.name.name.name) },
    _ -> None,
  }

/// `a +% b` is `wrap_add(a, b)`, built at the parse so the operator and the call are one definition
/// and one hash; `ply fmt` reads which spelling it was back from where the callee stands.
fn binary_node(o: Op, at: Span, lhs: Expr, rhs: Expr) -> Expr = {
  let span = span_to(expr_span(lhs), expr_span(rhs));
  match call_operator(o.op) {
    Some(_) ->
      EApp({
        span: span,
        func: EVar({ span: at, name: bare({ name: o.op, span: at }) }),
        named: [],
        args: [lhs, rhs],
        labels: [],
      }),
    None -> EBinary({ span: span, op: o.op, lhs: lhs, rhs: rhs }),
  }
}

fn touching(input: Input, parser: Parser, i: Int) -> Bool =
  token_kind_at(input, parser, i) == token_kind(input, parser)
    && token_at(input, parser, i).start == token_at(input, parser, i - 1).end

fn joined(input: Input, parser: Parser, n: Int) -> Bool =
  if n == 1 { touching(input, parser, 1) }
  else { touching(input, parser, 1) && touching(input, parser, 2) }

/// `>>>` must be tried before `>>`.
fn peek_bin_op(input: Input, parser: Parser) -> Option<Op> =
  if parser.no_pipe && at_token(input, parser, token_pipe()) { None }
  else if at_token(input, parser, token_gt()) && joined(input, parser, 2) {
    Some({ op: b"ushr", bp: 7, width: 3 })
  } else if at_token(input, parser, token_gt()) && joined(input, parser, 1) {
    Some({ op: b"shr", bp: 7, width: 2 })
  } else if at_token(input, parser, token_lt()) && joined(input, parser, 1) {
    Some({ op: b"shl", bp: 7, width: 2 })
  } else { bin_op(token_kind(input, parser)) }

// --- The grammar ------------------------------------------------------------

pub fn expr(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} =
  bin_expr(input, parser, 1, binding_powers())

/// In a scrutinee a `{` opens the arm block, never a record or a block expression — except at the
/// very start, where nothing else can stand and the arms are the `{` after it.
pub fn scrutinee(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match expr(input, with_no_brace(parser, !at_token(input, parser, token_lbrace()))) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

/// How many binding powers there are, so how many times a right operand can recurse at a higher one.
fn binding_powers() -> Int = 10

/// The left spine is one `iterate`; the right operand recurses at `bp + 1`, spending one of `powers`,
/// so depth is bounded by the number of binding powers rather than by the input's length.
fn bin_expr(
  input: Input,
  parser: Parser,
  min_bp: Int,
  powers: Int,
) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let lhs = unary_expr(input, parser)?;
  iterate(lhs, input.token_count - lhs.parser.pos + 1, |s: Parsed<Expr>|
    match peek_bin_op(input, s.parser) {
      None -> Stop(Ok(s)),
      Some(o) -> if o.bp < min_bp { Stop(Ok(s)) }
      else if powers <= 0 { Stop(Err(too_deep(input, s.parser))) } else {
        let a = advance_n(input, s.parser, o.width);
        match bin_expr(input, a, o.bp + 1, powers - 1) {
          Err(q) -> Stop(Err(q)),
          Ok(rhs) ->
            Continue({
              parser: rhs.parser,
              node: binary_node(o, current_span(input, s.parser), s.node, rhs.node),
            }),
        }
      },
    })
}

fn unary_expr(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} =
  if input.room <= 0 { Err(too_deep(input, parser)) }
  else { unary_body({ ..input, room: input.room - 1 }, parser) }

fn unary_body(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let op = match token_kind(input, parser) {
    Punctuation(s) -> if s == b"minus" { b"neg" }
    else if s == b"bang" { b"not" }
    else if s == b"tilde" { b"bitnot" }
    else { b"" },
    _ -> b"",
  };
  if op == b"" { postfix_expr(input, parser) } else {
    let st = advance(input, parser);
    let { parser, node: operand } = unary_expr(input, st.parser)?;
    Ok({
      parser: parser,
      node: EUnary({ span: span_to(st.node, expr_span(operand)), op: op, operand: operand }),
    })
  }
}

fn postfix_expr(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let first = primary_expr(input, parser)?;
  iterate(first, input.token_count - first.parser.pos + 1, |s: Parsed<Expr>|
    if at_token(input, s.parser, token_lparen()) {
      match call_args(input, s.parser) {
        Err(q) -> Stop(Err(q)),
        Ok(a) ->
          Continue({
            parser: a.parser,
            node: EApp({
              span: span_to(expr_span(s.node), a.close),
              func: s.node,
              named: a.named,
              args: a.args,
              labels: [],
            }),
          }),
      }
    } else if at_label_args(input, s) {
      match label_call(input, s) { Err(q) -> Stop(Err(q)), Ok(r) -> Continue(r) }
    } else if at_token(input, s.parser, token_dot()) {
      match postfix_dot(input, s) { Err(q) -> Stop(Err(q)), Ok(r) -> Continue(r) }
    } else if at_token(input, s.parser, token_question()) {
      // `?` binds tightest, with calls and fields: `f(x)?.g` is `(f(x)?).g` and `-x?` is `-(x?)`.
      let q = advance(input, s.parser);
      Continue({
        parser: q.parser,
        node: ETry({ span: span_to(expr_span(s.node), q.node), operand: s.node }),
      })
    } else { Stop(Ok(s)) })
}

/// `g`, a name after `m::`, or where it is a type's and `::` follows, the function of the type named
/// after it: `value.m::T::f(..)` calls a function of a type the module `m` declares.
fn typed_name(
  input: Input,
  parser: Parser,
  g: Ident,
) -> Result<Parsed<Ident>, Parser> / {abort.raise} =
  if !starts_upper(g.name) || !at_token(input, parser, token_coloncolon()) {
    Ok({ parser: parser, node: g })
  } else {
    let { parser, node: h } = expect_ident(
      input,
      advance(input, parser).parser,
      b"a function's name after `::`",
    )?;
    Ok({
      parser: parser,
      node: { name: Bytes::concat_all([g.name, b"::", h.name]), span: span_to(g.span, h.span) },
    })
  }

/// What a dot is followed by: a field's name, or `m::f` and a call's arguments, the call of `m::f`
/// with the value first, which is kept as a field of that name.
fn dotted_name(input: Input, parser: Parser) -> Result<Parsed<Ident>, Parser> / {abort.raise} = {
  let { parser, node: f } = expect_field_name(input, parser, b"a field name after `.`")?;
  if f.keyword || !at_token(input, parser, token_coloncolon()) {
    Ok({ parser: parser, node: f.name })
  } else {
    let through = advance(input, parser);
    let { parser, node: g } = expect_ident(input, through.parser, b"a function's name after `::`")?;
    let { parser, node: named } = typed_name(input, parser, g)?;
    if !follows_op(token_kind(input, parser)) {
      Err(error_here(input, parser, b"`(`: `value.m::f(..)` calls `m::f` with the value first"))
    } else {
      Ok({
        parser: parser,
        node: {
          name: Bytes::concat_all([f.name.name, b"::", named.name]),
          span: span_to(f.name.span, named.span),
        },
      })
    }
  }
}

/// A name, `.`, a name, then `[` or `(` is a perform, or a call on the value a binding of that name
/// holds; anything else is a field read. An operation takes no named argument, so a call that
/// writes one is kept as the call on a value.
fn postfix_dot(input: Input, s: Parsed<Expr>) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let is_perform = match s.node {
    EVar(v) -> match token_kind_at(input, s.parser, 1) {
      Identifier(n) ->
        at_token(input, s.parser, token_dot()) && follows_op(token_kind_at(input, s.parser, 2)),
      _ -> false,
    },
    _ -> false,
  };
  let dot = advance(input, s.parser);
  if !is_perform {
    let { parser, node: f } = dotted_name(input, dot.parser)?;
    Ok({
      parser: parser,
      node: EField({ span: span_to(expr_span(s.node), f.span), base: s.node, field: f }),
    })
  } else {
    let eff = match s.node { EVar(v) -> v.name, _ -> bare(no_ident()) };
    let { parser, node: op } = expect_ident(input, dot.parser, b"an operation name")?;
    let { parser, node: res } = opt_resource(input, parser)?;
    let a = call_args(input, parser)?;
    let span = span_to(expr_span(s.node), a.close);
    Ok({
      parser: a.parser,
      node: if a.named.len() == 0 {
        EPerform({ span: span, eff: eff, op: op, resource: res, args: a.args })
      } else {
        EApp({
          span: span,
          func: EField({ span: span_to(expr_span(s.node), op.span), base: s.node, field: op }),
          named: a.named,
          args: a.args,
          labels: match res { Some(r) -> [r], None -> [] },
        })
      },
    })
  }
}

fn follows_op(kind: TokenKind) -> Bool = kind == token_lbracket() || kind == token_lparen()

/// `relay[conn](c)`: a `[` after a name, holding names, then `(`, fills the callee's label
/// parameters; after a field's name, those of the function called on the value.
fn at_label_args(input: Input, s: Parsed<Expr>) -> Bool / {abort.raise} =
  match s.node {
    EVar(v) -> at_token(input, s.parser, token_lbracket()) && label_args_ahead(input, s.parser),
    EField(_) -> at_token(input, s.parser, token_lbracket()) && label_args_ahead(input, s.parser),
    _ -> false,
  }

fn label_args_ahead(input: Input, parser: Parser) -> Bool / {abort.raise} =
  iterate(1, input.token_count - parser.pos + 1, |i: Int|
    match token_kind_at(input, parser, i) {
      Identifier(n) -> if token_kind_at(input, parser, i + 1) == token_comma() { Continue(i + 2) }
      else {
        Stop(
          token_kind_at(input, parser, i + 1) == token_rbracket()
            && token_kind_at(input, parser, i + 2) == token_lparen(),
        )
      },
      _ -> Stop(false),
    })

fn label_call(input: Input, s: Parsed<Expr>) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let o = advance(input, s.parser);
  let { parser, node: ls } = comma_list(input, o.parser, token_rbracket(), label_name)?;
  let { parser, .. } = expect_close(input, parser, token_rbracket(), o.node, b"`]`")?;
  let a = call_args(input, parser)?;
  Ok({
    parser: a.parser,
    node: EApp({
      span: span_to(expr_span(s.node), a.close),
      func: s.node,
      named: a.named,
      args: a.args,
      labels: ls,
    }),
  })
}

fn opt_resource(
  input: Input,
  parser: Parser,
) -> Result<Parsed<Option<Ident>>, Parser> / {abort.raise} =
  if !at_token(input, parser, token_lbracket()) { Ok({ parser: parser, node: None }) } else {
    let o = advance(input, parser);
    let { parser, node: r } = expect_ident(input, o.parser, b"a resource name inside `[..]`")?;
    let { parser, .. } = expect_close(input, parser, token_rbracket(), o.node, b"`]`")?;
    Ok({ parser: parser, node: Some(r) })
  }

/// A clause's resource: `[name]`, `[*]` for every label, `[*t]` for every label with the one the
/// call site named bound to `t`, or nothing when the operation takes none. A perform names a label,
/// so only a clause gets the `*` forms.
type ClauseResource = { every: Bool, name: Option<Ident>, binder: Option<Ident> }

fn clause_resource(
  input: Input,
  parser: Parser,
) -> Result<Parsed<ClauseResource>, Parser> / {abort.raise} =
  if !at_token(input, parser, token_lbracket()) {
    Ok({ parser: parser, node: { every: false, name: None, binder: None } })
  } else {
    let o = advance(input, parser);
    if at_token(input, o.parser, token_star()) {
      let st = advance(input, o.parser);
      // `[*t]` binds the label: the clause answers every label, and reads the one it answered.
      let binder = match token_kind(input, st.parser) {
        Identifier(n) -> {
          let b = advance(input, st.parser);
          Some({ parser: b.parser, node: { name: n, span: b.node } })
        },
        _ -> None,
      };
      let at_after = match binder { Some(b) -> b.parser, None -> st.parser };
      let { parser, .. } = expect_close(input, at_after, token_rbracket(), o.node, b"`]`")?;
      Ok({
        parser: parser,
        node: {
          every: true,
          name: None,
          binder: match binder { Some(b) -> Some(b.node), None -> None },
        },
      })
    } else {
      let { parser, node: r } = expect_ident(
        input,
        o.parser,
        b"a resource name or `*` inside `[..]`",
      )?;
      let { parser, .. } = expect_close(input, parser, token_rbracket(), o.node, b"`]`")?;
      Ok({ parser: parser, node: { every: false, name: Some(r), binder: None } })
    }
  }

type ParsedArgs = { parser: Parser, close: Span, named: List<NamedArg>, args: List<Expr> }

fn call_args(input: Input, parser: Parser) -> Result<ParsedArgs, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match call_args_inner(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(a) ->
      Ok({ parser: with_no_brace(a.parser, saved), close: a.close, named: a.named, args: a.args }),
  }
}

fn call_args_inner(input: Input, parser: Parser) -> Result<ParsedArgs, Parser> / {abort.raise} = {
  let { parser, node: o } = expect(
    input,
    parser,
    token_lparen(),
    b"`(` to start the argument list",
  )?;
  let { parser, node: parsed } = comma_list(input, parser, token_rparen(), call_arg)?;
  let { parser, node: cl } = expect_close(
    input,
    parser,
    token_rparen(),
    o,
    b"`)` to close the arguments",
  )?;
  let sp = split_args(parser, parsed);
  Ok({ parser: sp.parser, close: cl, named: sp.named, args: sp.args })
}

fn call_arg(input: Input, parser: Parser) -> Result<Parsed<Arg>, Parser> / {abort.raise} =
  match token_kind(input, parser) {
    Identifier(n) -> if token_kind_at(input, parser, 1) == token_colon() {
      named_arg(input, parser, n)
    } else { positional_arg(input, parser) },
    _ -> positional_arg(input, parser),
  }

fn positional_arg(input: Input, parser: Parser) -> Result<Parsed<Arg>, Parser> / {abort.raise} = {
  let { parser, node: e } = expr(input, parser)?;
  Ok({ parser: parser, node: APos(e) })
}

fn named_arg(
  input: Input,
  parser: Parser,
  text: Bytes,
) -> Result<Parsed<Arg>, Parser> / {abort.raise} = {
  let name = { name: text, span: current_span(input, parser) };
  let a = advance(input, parser);
  let b = advance(input, a.parser);
  let { parser, node: v } = expr(input, b.parser)?;
  Ok({
    parser: parser,
    node: ANamed({ name: name, value: v, span: span_to(name.span, expr_span(v)) }),
  })
}

/// The parser's only rule about names is ordering; `first` is the first named argument's span, for the label.
type Split = { parser: Parser, first: Option<Span>, named: List<NamedArg>, args: List<Expr> }

fn split_args(parser: Parser, parsed: List<Arg>) -> Split =
  parsed.fold({ parser: parser, first: None, named: [], args: [] }, |s: Split, a: Arg|
    match a {
      APos(e) ->
        {
          first: s.first,
          named: s.named,
          parser: match s.first {
            None -> s.parser,
            Some(f) ->
              push_diag(
                s.parser,
                error_at_and(
                  argument_order(),
                  expr_span(e),
                  b"a positional argument cannot follow a named one",
                  b"positional",
                  f,
                  b"the first named argument is here",
                  [
                    b"positional arguments fill parameters left to right, which a name in front of them would make ambiguous",
                  ],
                ),
              ),
          },
          args: s.args.push(e),
        },
      ANamed(n) ->
        {
          parser: s.parser,
          args: s.args,
          first: match s.first { None -> Some(n.span), Some(f) -> Some(f) },
          named: s.named.push(n),
        },
    })

fn lit_expr(input: Input, parser: Parser, literal: Lit) -> Result<Parsed<Expr>, Parser> = {
  let a = advance(input, parser);
  Ok({ parser: a.parser, node: ELit({ span: a.node, lit: literal }) })
}

/// `???` or `..`: an unfilled hole the checker reports and a run raises on.
fn hole_expr(input: Input, parser: Parser, text: Bytes) -> Result<Parsed<Expr>, Parser> = {
  let a = advance(input, parser);
  Ok({ parser: a.parser, node: EHole({ span: a.node, text: text }) })
}

fn primary_expr(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let st = current_span(input, parser);
  match token_kind(input, parser) {
    IntLiteral(v) -> lit_expr(input, parser, LInt(v)),
    FixedLiteral(ty, v) -> lit_expr(input, parser, LFixed(ty, v)),
    WideLiteral(ty, high, low) -> lit_expr(input, parser, LWide(ty, high, low)),
    // Float and decimal literals keep their source text.
    FloatLiteral(f) -> lit_expr(input, parser, LFloat(src_over(input, st))),
    DecimalLiteral(m, sc) -> lit_expr(input, parser, LDec(src_over(input, st))),
    StringLiteral(s) -> lit_expr(input, parser, LStr(s)),
    LineString(s) -> lit_expr(input, parser, LStr(s)),
    BytesLiteral(b) -> lit_expr(input, parser, LBytes(b)),
    InterpolatedHead(t) -> interpolated(input, parser, t),
    CharLiteral(v) -> lit_expr(input, parser, LChar(v)),
    Keyword(k) -> if k == b"true" { lit_expr(input, parser, LBool(true)) }
    else if k == b"false" { lit_expr(input, parser, LBool(false)) }
    else if k == b"if" { if_expr(input, parser) }
    else if k == b"match" { match_expr(input, parser) }
    else if k == b"handle" { handle_expr(input, parser) }
    else { Err(error_here(input, parser, b"an expression")) },
    Identifier(n) -> primary_ident(input, parser, n),
    Punctuation(s) -> if s == b"lparen" { primary_paren(input, parser) }
    else if s == b"lbracket" { primary_list(input, parser) }
    else if s == b"hashbrace" { map_literal(input, parser, false) }
    else if s == b"hashbracket" { map_literal(input, parser, true) }
    else if s == b"lbrace" && !parser.no_brace {
      if at_record_literal(input, parser) { record_expr(input, parser) }
      else { block_expr(input, parser) }
    } else if s == b"pipe" || s == b"pipepipe" { lambda_expr(input, parser) }
    else if s == b"hole" { hole_expr(input, parser, b"???") }
    else if s == b"dotdot" { hole_expr(input, parser, b"..") }
    else { Err(error_here(input, parser, b"an expression")) },
    _ -> Err(error_here(input, parser, b"an expression")),
  }
}

/// Contextual, not reserved. `simulate` and `parallel` defer to `no_brace`, so `if simulate { .. }`
/// is a name and a block.
fn primary_ident(
  input: Input,
  parser: Parser,
  name: Bytes,
) -> Result<Parsed<Expr>, Parser> / {abort.raise} =
  if name == b"with_hold" && token_kind_at(input, parser, 1) == token_lbracket() {
    with_hold_expr(input, parser)
  } else if name == b"simulate" && !parser.no_brace
      && token_kind_at(input, parser, 1) == token_lbrace() { simulate_expr(input, parser) }
  else if name == b"parallel" && !parser.no_brace
      && token_kind_at(input, parser, 1) == token_lbrace() { parallel_expr(input, parser) }
  else if name == b"try" && opens_try(input, parser) { try_expr(input, parser) } else {
    match tagged_text(input, parser) {
      Some(head) -> tagged(input, parser, name, head),
      None -> {
        let { parser, node: q } = qname(input, parser, b"an expression")?;
        Ok({ parser: parser, node: EVar({ span: q.span, name: q }) })
      },
    }
  }

/// How the string of a tagged literal opens: its text up to its first hole, if it has one.
type TaggedHead = { text: Bytes, holed: Bool }

/// The string that touches the name the parser is at, which makes the two a tagged literal:
/// `uuid"..."` is one, and `uuid "..."` a name and then a string.
fn tagged_text(input: Input, parser: Parser) -> Option<TaggedHead> =
  if token_at(input, parser, 1).start != token_at(input, parser, 0).end { None } else {
    match token_kind_at(input, parser, 1) {
      StringLiteral(text) -> Some({ text: text, holed: false }),
      InterpolatedHead(text) -> Some({ text: text, holed: true }),
      _ -> None,
    }
  }

fn tagged(
  input: Input,
  parser: Parser,
  name: Bytes,
  head: TaggedHead,
) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let tag = current_span(input, parser);
  let named = advance(input, parser).parser;
  let quoted = current_span(input, named);
  let { parser, node: hs } = (if head.holed { holes(input, named) }
  else { Ok({ parser: advance(input, named).parser, node: [] }) })?;
  let last = match hs.at(hs.len() - 1) { Some(h) -> h.quoted, None -> quoted };
  Ok({
    parser: parser,
    node: ETagged({
      span: span_to(tag, last),
      tag: { name: name, span: tag },
      text: head.text,
      quoted: quoted,
      holes: hs,
    }),
  })
}

fn primary_paren(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match primary_paren_inner(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

fn primary_paren_inner(
  input: Input,
  parser: Parser,
) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  if at_token(input, o.parser, token_rparen()) {
    let cl = advance(input, o.parser);
    Ok({ parser: cl.parser, node: ELit({ span: span_to(o.node, cl.node), lit: LUnit }) })
  } else {
    let inner = expr(input, o.parser)?;
    if at_token(input, inner.parser, token_comma()) {
      // A comma makes a tuple: the record `{_0: a, _1: b}`.
      let rest = comma_list(input, advance(input, inner.parser).parser, token_rparen(), expr)?;
      let cl = expect_close(input, rest.parser, token_rparen(), o.node, b"`)` to close the tuple")?;
      let items = prepend(inner.node, rest.node);
      if items.len() == 1 {
        Ok({ parser: cl.parser, node: set_span(inner.node, span_to(o.node, cl.node)) })
      } else {
        Ok({
          parser: cl.parser,
          node: ERecord({
            span: span_to(o.node, cl.node),
            fields: range(0, items.len()).map(|i: Int| -> RecField {
              match items.at(i) {
                Some(e) -> { name: positional(i, expr_span(e)), value: e },
                None -> { name: positional(i, o.node), value: no_expr() },
              }
            }),
          }),
        })
      }
    } else {
      let close = expect_close(
        input,
        inner.parser,
        token_rparen(),
        o.node,
        b"`)` to close the group",
      )?;
      Ok({ parser: close.parser, node: set_span(inner.node, span_to(o.node, close.node)) })
    }
  }
}

fn primary_list(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match primary_list_inner(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

fn primary_list_inner(
  input: Input,
  parser: Parser,
) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  let { parser, node: items } = comma_list(input, o.parser, token_rbracket(), expr)?;
  let { parser, node: cl } = expect_close(
    input,
    parser,
    token_rbracket(),
    o.node,
    b"`]` to close the list",
  )?;
  Ok({ parser: parser, node: EList({ span: span_to(o.node, cl), items: items }) })
}

/// `#{k: v, ..}` is `Map::of_entries([{key: k, value: v}, ..])`, named as a call names it, and
/// `#[a, ..]` is `std.set`'s `Set::of_list([a, ..])`, built at the parse so the literal and the call
/// are one definition and one hash. `ply fmt` reads which spelling a map was back from the source.
fn map_literal(
  input: Input,
  parser: Parser,
  set: Bool,
) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match map_literal_inner(input, with_no_brace(parser, false), set) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

fn map_literal_inner(
  input: Input,
  parser: Parser,
  set: Bool,
) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  let closer = if set { token_rbracket() } else { token_rbrace() };
  let { parser, node: entries } = comma_list(input, o.parser, closer, if set { expr }
  else { map_entry })?;
  let { parser, node: cl } = expect_close(input, parser, closer, o.node, if set {
    b"`]` to close the set"
  } else { b"`}` to close the map" })?;
  let sp = span_to(o.node, cl);
  Ok({
    parser: parser,
    node: EApp({
      span: sp,
      func: EVar({
        span: o.node,
        name: {
          module: Some({
            name: if set { set_binder() } else { map_literal_call().binder },
            span: o.node,
          }),
          name: { name: if set { set_literal() } else { map_literal_call().name }, span: o.node },
          span: o.node,
        },
      }),
      named: [],
      args: [EList({ span: sp, items: entries })],
      labels: [],
    }),
  })
}

/// The binder under which a module that writes a set literal imports `std.set`; no source can
/// spell it.
pub fn set_binder() -> Bytes = b"?set"

/// What a set literal calls in `std.set`.
pub fn set_literal() -> Bytes = b"Set::of_list"

/// The call a map literal is, spelt as a call names it.
pub fn map_literal_call() -> { binder: Bytes, name: Bytes } =
  { binder: b"Map", name: b"of_entries" }

// --- Interpolated strings ---------------------------------------------------

/// The binder under which a module that interpolates imports `std.show`; no source can spell it.
pub fn shown_binder() -> Bytes = b"?show"

/// `f"a {x} b"` is `"a " ++ display(x) ++ " b"`, `display` being `std.show`'s.
fn interpolated(
  input: Input,
  parser: Parser,
  head: Bytes,
) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let first = current_span(input, parser);
  let { parser, node: hs } = holes(input, parser)?;
  let last = match hs.at(hs.len() - 1) { Some(h) -> h.quoted, None -> first };
  let parts = hs.fold([ELit({ span: first, lit: LStr(head) })], |acc: List<Expr>, h: Hole|
    acc.push(displayed(h.value)).push(ELit({ span: h.quoted, lit: LStr(h.text) })));
  Ok({ parser: parser, node: concatenated(span_to(first, last), parts) })
}

/// At an `InterpolatedHead`: every hole of its string and the text after each, a brace inside a
/// hole read as an expression's.
fn holes(input: Input, parser: Parser) -> Result<Parsed<List<Hole>>, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match holes_on(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

/// At an `InterpolatedHead` or an `InterpolatedMiddle`: the hole after it and the text that closes
/// the hole, a round each, every round passing at least the token that opens its hole.
fn holes_on(input: Input, parser: Parser) -> Result<Parsed<List<Hole>>, Parser> / {abort.raise} =
  iterate({ parser: parser, out: [] }, input.token_count - parser.pos + 1, |s: SoFar<Hole>| {
    let opened = advance(input, s.parser);
    match expr(input, opened.parser) {
      Err(q) -> Stop(Err(q)),
      Ok(r) -> {
        let sp = current_span(input, r.parser);
        match token_kind(input, r.parser) {
          InterpolatedMiddle(t) ->
            Continue({ parser: r.parser, out: s.out.push({ value: r.node, text: t, quoted: sp }) }),
          InterpolatedTail(t) ->
            Stop(
              Ok({
                parser: advance(input, r.parser).parser,
                node: s.out.push({ value: r.node, text: t, quoted: sp }),
              }),
            ),
          _ -> Stop(Err(error_here(input, r.parser, b"`}` to close the interpolated value"))),
        }
      },
    }
  })

fn displayed(expr: Expr) -> Expr = {
  let sp = expr_span(expr);
  EApp({
    span: sp,
    func: EVar({
      span: sp,
      name: {
        module: Some({ name: shown_binder(), span: sp }),
        name: { name: b"display", span: sp },
        span: sp,
      },
    }),
    named: [],
    args: [expr],
    labels: [],
  })
}

// --- A test over cases -------------------------------------------------------

/// The binder under which a module with a test over cases imports `std.cases`; no source can spell it.
pub fn cases_binder() -> Bytes = b"?cases"

/// Whether an import under `name` is the parser's, never the source's.
pub fn hidden_binder(name: Bytes) -> Bool =
  name == shown_binder() || name == cases_binder() || name == set_binder()
    || name.starts_with(free_prefix())

fn free_prefix() -> Bytes = b"?free."

/// The names a module reads with no import where it declares and imports none of them, each under
/// the module of the library that declares it, `std.` left off.
pub fn free_names() -> List<{ module: Bytes, names: List<Bytes> }> =
  [
    { module: b"console", names: [b"print", b"eprint", b"read_line", b"Console"] },
    { module: b"set", names: [b"Set"] },
    { module: b"math", names: [b"abs"] },
  ]

/// The modules that declare what Ply writes of the language's own types, each type's functions a
/// module calls with no import where [`sees_homes`] says it does.
pub fn home_modules() -> List<Bytes> =
  [
    b"std.list",
    b"std.string",
    b"std.map",
    b"std.option",
    b"std.result",
    b"std.char",
    b"std.bytes",
    b"std.float",
  ]

/// The module of the language's own functions, which every other module imports under
/// `prelude_binder` past the imports its text writes, and which imports nothing.
pub fn prelude_module() -> Bytes = b"std.prelude"

/// The name the prelude's own definition `full` has in the prelude; none for another module's.
pub fn prelude_own(full: Bytes) -> Option<Bytes> = {
  let prefix = prelude_module().concat(b".");
  if full.starts_with(prefix) { full.slice_at(prefix.len(), full.len() - prefix.len()) }
  else { None }
}

/// The module of the toolchain's scheduler, whose functions a `simulate` and a perform of one of
/// `crossing_operations` are calls of.
pub fn scheduler_module() -> Bytes = b"std.internal.schedule"

/// Whether `definition` is one of the scheduler's `crossing_<op>`, which a perform of a prelude
/// operation at types not all `Kept` calls in its place: it stands at that perform.
pub fn crossing_perform(definition: Bytes) -> Bool =
  definition.starts_with(scheduler_module().concat(b".crossing_"))

/// The scheduler and every module it imports, directly or through others: none of them reads the
/// scheduler with no import, so that what a module sees stays acyclic.
pub fn beneath_scheduler() -> List<Bytes> =
  [
    scheduler_module(),
    b"std.bin",
    b"std.bytes",
    b"std.cases",
    b"std.derive",
    b"std.derive.codec",
    b"std.gen",
    b"std.internal.native",
    b"std.internal.trail",
    b"std.laws",
    b"std.list",
    b"std.math",
    b"std.radix",
    b"std.show",
    b"std.string",
    b"std.text",
    b"std.value",
  ]

/// The real handler of each of the prelude's effects that has one, which the prelude has no module
/// to declare with `host for`: the effect, the handler's module and its name there. `task`'s is the
/// run's region, and `clock`'s the run's clock, whose sleeps wait in that region.
pub fn prelude_hosts() -> List<{ effect: Bytes, module: Bytes, by: Bytes }> =
  [
    { effect: b"clock", module: scheduler_module(), by: b"clocked" },
    { effect: b"task", module: scheduler_module(), by: b"scheduled" },
  ]

/// The operations of the prelude's `task` effect.
pub fn task_operations() -> List<Bytes> = crossing_operations().push(b"yield")

/// The operations of the prelude's `task` effect generic in their own types, each of which crosses
/// through the scheduler.
pub fn crossing_operations() -> List<Bytes> =
  [b"spawn", b"join", b"cancel", b"await", b"channel", b"send", b"recv", b"close", b"select"]

/// The prelude, the home modules and every module they import, directly or through others, hidden
/// imports and those of tests among them.
pub fn beneath_homes() -> List<Bytes> =
  home_modules().concat([
    prelude_module(),
    b"std.cases",
    b"std.gen",
    b"std.laws",
    b"std.math",
    b"std.radix",
    b"std.show",
    b"std.ucd",
    b"std.value",
  ])

/// Whether the module `name` sees the home modules with no import: every module but those
/// [`beneath_homes`], which see what they import, so that what a module sees stays acyclic. Where
/// a module lies is no part of it: a copy of one of the library's elsewhere sees what it did.
pub fn sees_homes(name: Bytes) -> Bool = !beneath_homes().contains(name)

/// The binder under which a module imports one of [`free_names`]'s modules for the names it reads
/// of it; no source can spell it.
pub fn free_binder(module: Bytes) -> Bytes = free_prefix().concat(module)

/// The names [`free_names`] gives the module a hidden import under `binder` reads, none where the
/// binder is another.
pub fn freed_by(binder: Bytes) -> List<Bytes> =
  free_names().fold([], |acc: List<Bytes>, f: { module: Bytes, names: List<Bytes> }|
    if free_binder(f.module) == binder { f.names } else { acc })

/// The name a case's test is entered with its place in the table under; no source can spell it.
pub fn case_at() -> Bytes = b"?at"

/// The name a case's test is entered with its identity under; no source can spell it.
pub fn case_identity() -> Bytes = b"?identity"

fn cases_name(name: Bytes, at: Span) -> QName = {
  let named = { ..at, site: 0 };
  {
    module: Some({ name: cases_binder(), span: named }),
    name: { name: name, span: named },
    span: named,
  }
}

/// A call into `std.cases`, made for the case's word at `from`. Both calls' callees stand at the
/// case's type, where what they require of it is reported once.
fn cases_call(span: Span, from: Span, ty: TypeExpr, name: Bytes, args: List<Expr>) -> Expr =
  EApp({
    span: span,
    func: EVar({
      span: made_at(ty_span(ty), from, role_case_callee()),
      name: cases_name(name, ty_span(ty)),
    }),
    named: [],
    args: args,
    labels: [],
  })

fn local(name: Bytes, at: Span) -> Expr =
  EVar({ span: at, name: bare({ name: name, span: { ..at, site: 0 } }) })

fn table_binder() -> Bytes = b"?table"

/// `let ?table: std.cases.Table<T> = table;`: the table held to the case's type where it is
/// written, made for the case's word at `from`.
fn table_bound(ty: TypeExpr, table: Expr, from: Span) -> Stmt = {
  let at = expr_span(table);
  let typed = { ..at, site: 0 };
  SLet({
    span: made_at(at, from, role_case_table_let()),
    pat: PVar({
      span: made_at(at, from, role_case_table_binder()),
      name: { name: table_binder(), span: typed },
    }),
    ty: Some(
      TCon({ span: typed, name: cases_name(b"Table", at), args: [ty], labels: [], rows: [] }),
    ),
    value: table,
  })
}

/// `{ let ?table = ..; std.cases.listed(?table, |c: T| label) }`: each case's label and
/// identity. What it adds is made for the `for` written at `for_span`; the table and the label keep
/// their sites, which a case's run shares.
pub fn listing(binder: Ident, ty: TypeExpr, table: Expr, label: Expr, for_span: Span) -> Expr =
  EBlock({
    span: made_at(span_to(for_span, expr_span(table)), for_span, role_case_block()),
    tail: Some(
      cases_call(
        made_at(span_to(expr_span(label), expr_span(table)), for_span, role_case_call()),
        for_span,
        ty,
        b"listed",
        [
          local(table_binder(), made_at(for_span, for_span, role_case_table_read())),
          ELambda({
            span: made_at(
              span_to(expr_span(label), binder.span),
              for_span,
              role_case_label_lambda(),
            ),
            body: label,
            params: [
              {
                name: binder,
                keep: false,
                ty: Some(ty),
                cost: None,
                space: None,
                default: None,
                span: made_at(binder.span, for_span, role_case_label_param()),
              },
            ],
            ret: None,
          }),
        ],
      ),
    ),
    stmts: [table_bound(ty, table, for_span)],
  })

/// `{ let ?table = ..; let c: T = std.cases.chosen(?table, ?at, ?identity); body }`: the body
/// over the case it is entered for. What it adds is made for the `in` written at `in_span`.
pub fn case_body(binder: Ident, ty: TypeExpr, table: Expr, in_span: Span, body: Expr) -> Expr =
  EBlock({
    span: made_at(span_to(binder.span, expr_span(body)), in_span, role_case_block()),
    tail: Some(body),
    stmts: [
      table_bound(ty, table, in_span),
      SLet({
        span: made_at(span_to(binder.span, expr_span(table)), in_span, role_case_let()),
        pat: PVar({ span: made_at(binder.span, in_span, role_case_binder()), name: binder }),
        ty: Some(ty),
        value: cases_call(
          made_at(span_to(in_span, expr_span(table)), in_span, role_case_call()),
          in_span,
          ty,
          b"chosen",
          [
            local(table_binder(), made_at(in_span, in_span, role_case_table_read())),
            local(
              case_at(),
              made_at(span_between(in_span.start, in_span.start + 1), in_span, role_case_at_read()),
            ),
            local(
              case_identity(),
              made_at(
                span_between(in_span.start + 1, in_span.end),
                in_span,
                role_case_identity_read(),
              ),
            ),
          ],
        ),
      }),
    ],
  })

/// The pieces concatenated, empty text dropped; the outermost node spans the whole literal.
fn concatenated(span: Span, parts: List<Expr>) -> Expr = {
  let kept = parts.filter(|expr: Expr| match expr { ELit(l) -> l.lit != LStr(b""), _ -> true });
  let chained = range(1, kept.len()).fold(at_expr(kept, 0), |acc: Expr, i: Int| {
    let x = at_expr(kept, i);
    EBinary({ span: span_to(expr_span(acc), expr_span(x)), op: b"concat", lhs: acc, rhs: x })
  });
  set_span(chained, span)
}

fn at_expr(xs: List<Expr>, i: Int) -> Expr =
  match xs.at(i) { Some(x) -> x, None -> ELit({ span: dummy_span(), lit: LStr(b"") }) }

fn map_entry(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let { parser, node: key } = expr(input, parser)?;
  let { parser, .. } = expect(input, parser, token_colon(), b"`:` between a key and its value")?;
  let { parser, node: value } = expr(input, parser)?;
  Ok({ parser: parser, node: entry_record(key, value) })
}

fn entry_record(key: Expr, value: Expr) -> Expr = {
  let ks = expr_span(key);
  let vs = expr_span(value);
  ERecord({
    span: span_to(ks, vs),
    fields: [
      { name: { name: b"key", span: ks }, value: key },
      { name: { name: b"value", span: vs }, value: value },
    ],
  })
}

/// `{x: e}`, `{x, y}` and `{..b}` are records; `{x}` is a block whose value is `x`.
fn at_record_literal(input: Input, parser: Parser) -> Bool =
  if token_kind_at(input, parser, 1) == token_dotdot() { true } else {
    match token_kind_at(input, parser, 1) {
      Identifier(n) ->
        token_kind_at(input, parser, 2) == token_colon()
          || token_kind_at(input, parser, 2) == token_comma(),
      Keyword(k) ->
        token_kind_at(input, parser, 2) == token_colon()
          || token_kind_at(input, parser, 2) == token_comma(),
      _ -> false,
    }
  }

fn record_expr(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match record_expr_inner(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

fn record_expr_inner(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  let { parser, node: base } = record_base(input, o.parser)?;
  let { parser, node: fields } = comma_list(input, parser, token_rbrace(), record_field)?;
  let { parser, node: cl } = expect_close(
    input,
    parser,
    token_rbrace(),
    o.node,
    b"`}` to close the record",
  )?;
  let sp = span_to(o.node, cl);
  Ok({
    parser: fields_once(parser, fields.map(|f: RecField| f.name)),
    node: match base {
      None -> ERecord({ span: sp, fields: fields }),
      Some(b) -> ERecordUpdate({ span: sp, base: b, fields: fields }),
    },
  })
}

fn record_base(
  input: Input,
  parser: Parser,
) -> Result<Parsed<Option<Expr>>, Parser> / {abort.raise} =
  if !at_token(input, parser, token_dotdot()) { Ok({ parser: parser, node: None }) } else {
    let { parser, node: b } = record_update_base(input, parser)?;
    if at_token(input, parser, token_rbrace()) { Ok({ parser: parser, node: Some(b) }) } else {
      let { parser, .. } = expect(
        input,
        parser,
        token_comma(),
        b"`,` after the record being updated",
      )?;
      Ok({ parser: parser, node: Some(b) })
    }
  }

/// A path, or one call of it: the expansion writes `base.f` once per field it copies, and binds a
/// call first so it runs once.
fn record_update_base(
  input: Input,
  parser: Parser,
) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let dots = advance(input, parser);
  if at_token(input, dots.parser, token_dot()) {
    Err(
      push_diag(
        dots.parser,
        error_at(
          unexpected(),
          span_to(dots.node, current_span(input, dots.parser)),
          b"a record update is spelled `..`, not `...`",
          b"one dot too many",
          [b"`..` is the same token the record *pattern* `{a, ..}` uses"],
        ),
      ),
    )
  } else {
    let { parser, node: name } = qname(input, dots.parser, b"the record being updated")?;
    let path = iterate(
      { parser: parser, node: EVar({ span: name.span, name: name }) },
      input.token_count - parser.pos + 1,
      |s: Parsed<Expr>|
        if !at_token(input, s.parser, token_dot()) { Stop(Ok(s)) } else {
          let d = advance(input, s.parser);
          match expect_field_name(input, d.parser, b"a field name") {
            Err(q) -> Stop(Err(q)),
            Ok(f) ->
              Continue({
                parser: f.parser,
                node: EField({
                  span: span_to(expr_span(s.node), f.node.name.span),
                  base: s.node,
                  field: f.node.name,
                }),
              }),
          }
        },
    )?;
    let op_of: Option<{ eff: QName, op: Ident }> = match path.node {
      EField(f) -> match f.base { EVar(v) -> Some({ eff: v.name, op: f.field }), _ -> None },
      _ -> None,
    };
    let opens = at_token(input, path.parser, token_lparen());
    match op_of {
      // `name.op(..)` performs here as it does anywhere else.
      Some(p) -> if !opens && !at_token(input, path.parser, token_lbracket()) { Ok(path) } else {
        let { parser, node: res } = opt_resource(input, path.parser)?;
        let a = call_args(input, parser)?;
        let span = span_to(expr_span(path.node), a.close);
        Ok({
          parser: a.parser,
          node: if a.named.len() == 0 {
            EPerform({ span: span, eff: p.eff, op: p.op, resource: res, args: a.args })
          } else {
            EApp({
              span: span,
              func: path.node,
              named: a.named,
              args: a.args,
              labels: match res { Some(r) -> [r], None -> [] },
            })
          },
        })
      },
      None -> if !opens { Ok(path) } else {
        let a = call_args(input, path.parser)?;
        Ok({
          parser: a.parser,
          node: EApp({
            span: span_to(expr_span(path.node), a.close),
            func: path.node,
            named: a.named,
            args: a.args,
            labels: [],
          }),
        })
      },
    }
  }
}

fn record_field(input: Input, parser: Parser) -> Result<Parsed<RecField>, Parser> / {abort.raise} =
  if at_token(input, parser, token_dotdot()) {
    Err(
      push_diag(
        parser,
        error_at(
          unexpected(),
          current_span(input, parser),
          b"a record update has one base, written first",
          b"a second `..` here",
          [b"write `{..b, x: 1, y: 2}`; two bases have no defined order of fields"],
        ),
      ),
    )
  } else { record_field_named(input, parser) }

fn record_field_named(
  input: Input,
  parser: Parser,
) -> Result<Parsed<RecField>, Parser> / {abort.raise} = {
  let { parser, node: f } = expect_field_name(input, parser, b"a field name")?;
  let name = f.name;
  let colon = eat(input, parser, token_colon());
  if colon.ok {
    let { parser, node: v } = expr(input, colon.parser)?;
    Ok({ parser: parser, node: { name: name, value: v } })
  } else if f.keyword { Err(keyword_pun_refusal(colon.parser, name)) } else {
    Ok({
      parser: colon.parser,
      node: { name: name, value: EVar({ span: name.span, name: bare(name) }) },
    })
  }
}

pub fn block_expr(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let saved = parser.no_brace;
  match block_inner(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

type BlockAcc = { parser: Parser, tail: Option<Expr>, stmts: List<Stmt> }

fn block_inner(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let { parser, node: o } = expect(input, parser, token_lbrace(), b"`{` to start a block")?;
  let body = iterate(
    { parser: parser, tail: None, stmts: [] },
    input.token_count - parser.pos + 1,
    |s: BlockAcc|
      if at_token(input, s.parser, token_rbrace()) { Stop(Ok(s)) } else if at_eof(input, s.parser) {
        Stop(Err(unclosed(input, s.parser, o, b"`}` to close the block")))
      } else if at_token(input, s.parser, keyword_let()) {
        match let_stmt(input, s.parser) {
          Err(q) -> Stop(Err(q)),
          Ok(st) -> Continue({ parser: st.parser, tail: s.tail, stmts: s.stmts.push(st.node) }),
        }
      } else if is_ident_at(input, s.parser, 0) && token_kind_at(input, s.parser, 1) == token_eq() {
        match assign_stmt(input, s.parser) {
          Err(q) -> Stop(Err(q)),
          Ok(st) -> Continue({ parser: st.parser, tail: s.tail, stmts: s.stmts.push(st.node) }),
        }
      } else { block_step(input, s, o) },
  )?;
  let { parser, node: cl } = expect_close(
    input,
    body.parser,
    token_rbrace(),
    o,
    b"`}` to close the block",
  )?;
  Ok({ parser: parser, node: EBlock({ span: span_to(o, cl), tail: body.tail, stmts: body.stmts }) })
}

fn block_step(
  input: Input,
  s: BlockAcc,
  open: Span,
) -> Iter<BlockAcc, Result<BlockAcc, Parser>> / {abort.raise} =
  match expr(input, s.parser) {
    Err(q) -> Stop(Err(q)),
    Ok(e) -> {
      let semi = eat(input, e.parser, token_semi());
      if semi.ok {
        Continue({ parser: semi.parser, tail: s.tail, stmts: s.stmts.push(SExpr(e.node)) })
      } else if at_token(input, semi.parser, token_rbrace()) {
        Continue({ parser: semi.parser, tail: Some(e.node), stmts: s.stmts })
      } else if is_block_like(e.node) {
        Continue({ parser: semi.parser, tail: s.tail, stmts: s.stmts.push(SExpr(e.node)) })
      } else if at_eof(input, semi.parser) {
        Stop(Err(unclosed(input, semi.parser, open, b"`}` to close the block")))
      } else {
        Stop(
          Err(error_here(input, semi.parser, b"`;` to end the statement, or `}` to end the block")),
        )
      }
    },
  }

/// Its own function so `?` sits in return position: `?` in an `if` branch bound by `let` is `E0119`.
fn let_ty(
  input: Input,
  parser: Parser,
) -> Result<Parsed<Option<TypeExpr>>, Parser> / {abort.raise} = {
  let colon = eat(input, parser, token_colon());
  if !colon.ok { Ok({ parser: colon.parser, node: None }) } else {
    let { parser, node: x } = ty(input, colon.parser)?;
    Ok({ parser: parser, node: Some(x) })
  }
}

fn let_stmt(input: Input, parser: Parser) -> Result<Parsed<Stmt>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let { parser, node: pat } = pattern(input, st.parser)?;
  let { parser, node: t } = let_ty(input, parser)?;
  let { parser, .. } = expect(input, parser, token_eq(), b"`=` and an initializer")?;
  let { parser, node: value } = expr(input, parser)?;
  let els = eat(input, parser, keyword_else());
  if els.ok { let_else(input, els.parser, st.node, pat, t, value) }
  else { let_end(input, parser, st.node, pat, t, value) }
}

fn let_end(
  input: Input,
  parser: Parser,
  span: Span,
  pat: Pattern,
  ty: Option<TypeExpr>,
  value: Expr,
) -> Result<Parsed<Stmt>, Parser> / {abort.raise} = {
  let { parser, node: semi } = expect(input, parser, token_semi(), b"`;` to end the `let`")?;
  Ok({ parser: parser, node: SLet({ span: span_to(span, semi), pat: pat, ty: ty, value: value }) })
}

fn let_else(
  input: Input,
  parser: Parser,
  span: Span,
  pat: Pattern,
  ty: Option<TypeExpr>,
  value: Expr,
) -> Result<Parsed<Stmt>, Parser> / {abort.raise} = {
  let { parser, node: fallback } = else_block(input, parser)?;
  let { parser, node: semi } = expect(
    input,
    parser,
    token_semi(),
    b"`;` to end the `let ... else`",
  )?;
  Ok({
    parser: parser,
    node: SLetElse({
      span: span_to(span, semi),
      pat: pat,
      ty: ty,
      value: value,
      fallback: fallback,
    }),
  })
}

/// `name = value;`, whose `;` may be left off before the block's `}`.
fn assign_stmt(input: Input, parser: Parser) -> Result<Parsed<Stmt>, Parser> / {abort.raise} = {
  let { parser, node: name } = expect_ident(input, parser, b"the name of the variable to assign")?;
  let eq = advance(input, parser);
  let { parser, node: value } = expr(input, eq.parser)?;
  let semi = eat(input, parser, token_semi());
  if semi.ok || at_token(input, semi.parser, token_rbrace()) {
    Ok({
      parser: semi.parser,
      node: SAssign({ span: span_to(name.span, expr_span(value)), name: name, value: value }),
    })
  } else {
    Err(error_here(input, semi.parser, b"`;` to end the assignment, or `}` to end the block"))
  }
}

/// The block nests in the statement.
fn else_block(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} =
  if !at_token(input, parser, token_lbrace()) {
    Err(error_here(input, parser, b"`{` to open the `else` block of a `let ... else`"))
  } else if input.room <= 0 { Err(too_deep(input, parser)) }
  else { block_expr({ ..input, room: input.room - 1 }, parser) }

pub fn fn_param(input: Input, parser: Parser) -> Result<Parsed<Param>, Parser> / {abort.raise} =
  param_inner(input, parser, true)

/// A lambda parameter, which may not carry a default.
pub fn param(input: Input, parser: Parser) -> Result<Parsed<Param>, Parser> / {abort.raise} =
  param_inner(input, parser, false)

/// An `extern fn`'s parameter, which carries no default.
pub fn declared_param(
  input: Input,
  parser: Parser,
) -> Result<Parsed<Param>, Parser> / {abort.raise} = param_inner(input, parser, false)

fn param_inner(
  input: Input,
  parser: Parser,
  allow_default: Bool,
) -> Result<Parsed<Param>, Parser> / {abort.raise} = {
  let { parser, node: n } = expect_binder(input, parser, b"a parameter name")?;
  let { parser, node: typed } = param_ty(input, parser)?;
  let t = typed.ty;
  let { parser, node: c } = param_named(
    input,
    parser,
    allow_default,
    t,
    b"cost",
    b"steps a call of it takes",
  )?;
  let { parser, node: s } = param_named(
    input,
    parser,
    allow_default,
    t,
    b"space",
    b"memory a call of it holds",
  )?;
  let { parser, node: d } = param_default(input, parser, allow_default)?;
  // A refused default is `None`, so the span stops before the `= 1` that was read.
  let end = match d {
    Some(e) -> expr_span(e),
    None -> match ((s, c)) {
      (Some(k), _) -> k.span,
      (None, Some(k)) -> k.span,
      _ -> match t { Some(x) -> ty_span(x), None -> n.span },
    },
  };
  Ok({
    parser: parser,
    node: {
      name: n,
      keep: typed.keep,
      ty: t,
      cost: c,
      space: s,
      default: d,
      span: span_to(n.span, end),
    },
  })
}

/// `cost k` or `space s` after a `fn` parameter's function type, the `word` naming what one call of
/// the function takes.
fn param_named(
  input: Input,
  parser: Parser,
  allowed: Bool,
  t: Option<TypeExpr>,
  word: Bytes,
  what: Bytes,
) -> Result<Parsed<Option<Ident>>, Parser> / {abort.raise} =
  if !allowed || !at_ident_text(input, parser, word) { Ok({ parser: parser, node: None }) } else {
    match t {
      Some(TFn(_)) -> {
        let { parser, node: k } = expect_binder(
          input,
          advance(input, parser).parser,
          Bytes::concat_all([b"a name for the ", what]),
        )?;
        Ok({ parser: parser, node: Some(k) })
      },
      _ ->
        Err(
          error_here(
            input,
            parser,
            Bytes::concat_all([b"a function type before `", word, b"`, which names the ", what]),
          ),
        ),
    }
  }

/// A parameter's type, and whether it is written `keep`: the callee takes what it is handed. The
/// checker decides which types may be.
fn param_ty(
  input: Input,
  parser: Parser,
) -> Result<Parsed<{ keep: Bool, ty: Option<TypeExpr> }>, Parser> / {abort.raise} = {
  let co = eat(input, parser, token_colon());
  if !co.ok { Ok({ parser: co.parser, node: { keep: false, ty: None } }) } else {
    let keep = at_ident_text(input, co.parser, b"keep") && starts_type(input, co.parser, 1);
    let from = if keep { advance(input, co.parser).parser } else { co.parser };
    let { parser, node: t } = ty(input, from)?;
    Ok({ parser: parser, node: { keep: keep, ty: Some(t) } })
  }
}

/// Parsed either way, so a default on a lambda is refused with the reason rather than a syntax error.
fn param_default(
  input: Input,
  parser: Parser,
  allow: Bool,
) -> Result<Parsed<Option<Expr>>, Parser> / {abort.raise} =
  if !at_token(input, parser, token_eq()) { Ok({ parser: parser, node: None }) } else {
    let eq = advance(input, parser);
    let { parser, node: e } = expr(input, eq.parser)?;
    if allow { Ok({ parser: parser, node: Some(e) }) } else {
      Ok({
        parser: push_diag(
          parser,
          error_at(
            default_not_allowed(),
            span_to(eq.node, expr_span(e)),
            b"a lambda parameter cannot have a default",
            b"no call can omit this argument",
            [
              b"a default is filled in by matching a call against a signature, and a lambda is called through a value rather than by name",
            ],
          ),
        ),
        node: None,
      })
    }
  }

pub fn no_param() -> Param =
  {
    name: no_ident(),
    keep: false,
    ty: None,
    cost: None,
    space: None,
    default: None,
    span: dummy_span(),
  }

/// `||` is one token: the empty parameter list.
fn lambda_params(
  input: Input,
  parser: Parser,
) -> Result<Parsed<List<Param>>, Parser> / {abort.raise} = {
  let empty = eat(input, parser, token_pipepipe());
  if empty.ok { Ok({ parser: empty.parser, node: [] }) } else {
    let bar = advance(input, empty.parser);
    // Inside the list a `|` closes it and is never bit-or; restored on both paths.
    let saved = bar.parser.no_pipe;
    let { parser, node: ps } = (match comma_list(
        input,
        with_no_pipe(bar.parser, true),
        token_pipe(),
        param,
      ) {
      Err(q) -> Err(with_no_pipe(q, saved)),
      Ok(r) -> Ok({ parser: with_no_pipe(r.parser, saved), node: r.node }),
    })?;
    let { parser, .. } = expect(
      input,
      parser,
      token_pipe(),
      b"`|` to close the lambda parameters",
    )?;
    Ok({ parser: parser, node: ps })
  }
}

/// A written return type requires a block body.
fn lambda_expr(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let st = current_span(input, parser);
  let { parser, node: params } = lambda_params(input, parser)?;
  let arrow = eat(input, parser, token_arrow());
  if arrow.ok {
    let { parser, node: ret } = ty(input, arrow.parser)?;
    if !at_token(input, parser, token_lbrace()) {
      Err(error_here(input, parser, b"`{` to open the body of a lambda with a written return type"))
    } else {
      let { parser, node: body } = lambda_body(input, parser, true)?;
      Ok({
        parser: parser,
        node: ELambda({
          span: span_to(st, expr_span(body)),
          body: body,
          params: params,
          ret: Some(ret),
        }),
      })
    }
  } else {
    let { parser, node: body } = lambda_body(input, parser, false)?;
    Ok({
      parser: parser,
      node: ELambda({ span: span_to(st, expr_span(body)), body: body, params: params, ret: None }),
    })
  }
}

/// The body reads `|` as bit-or again whatever list encloses the lambda; restored on both paths.
fn lambda_body(
  input: Input,
  parser: Parser,
  braced: Bool,
) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let saved = parser.no_pipe;
  let inner = with_no_pipe(parser, false);
  match if braced { block_expr(input, inner) } else { expr(input, inner) } {
    Err(q) -> Err(with_no_pipe(q, saved)),
    Ok(r) -> Ok({ parser: with_no_pipe(r.parser, saved), node: r.node }),
  }
}

fn else_branch(
  input: Input,
  parser: Parser,
  then_branch: Expr,
) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let els = eat(input, parser, keyword_else());
  if !els.ok {
    // No `else`: a `()` over the empty span at the end of the `then` block.
    let end = expr_span(then_branch).end;
    Ok({ parser: els.parser, node: ELit({ span: span_between(end, end), lit: LUnit }) })
  } else { block_expr(input, els.parser) }
}

type IfArm = { start: Span, cond: Expr, then_branch: Expr }

/// An `else if` chain is read as one loop, an arm a round, and nested from its end: a chain nests no
/// deeper for being long.
fn if_expr(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let chain = iterate(
    { parser: parser, out: [] },
    input.token_count - parser.pos + 1,
    |s: SoFar<IfArm>| {
      let st = advance(input, s.parser);
      match scrutinee(input, st.parser) {
        Err(q) -> Stop(Err(q)),
        Ok(c) -> match block_expr(input, c.parser) {
          Err(q) -> Stop(Err(q)),
          Ok(t) -> {
            let out = s.out.push({ start: st.node, cond: c.node, then_branch: t.node });
            let els = eat(input, t.parser, keyword_else());
            if els.ok && at_token(input, els.parser, keyword_if()) {
              Continue({ parser: els.parser, out: out })
            } else { Stop(Ok({ parser: t.parser, out: out })) }
          },
        },
      }
    },
  )?;
  let last = chain.out.get(chain.out.len() - 1);
  let { parser, node: else_b } = else_branch(input, chain.parser, last.then_branch)?;
  Ok({
    parser: parser,
    node: range(0, chain.out.len()).fold(else_b, |inner: Expr, i: Int| {
      let arm = chain.out.get(chain.out.len() - 1 - i);
      EIf({
        span: span_to(arm.start, expr_span(inner)),
        cond: arm.cond,
        then_branch: arm.then_branch,
        else_branch: inner,
      })
    }),
  })
}

fn match_expr(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let { parser, node: scrut } = scrutinee(input, st.parser)?;
  let saved = parser.no_brace;
  match match_arms(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(arms) ->
      Ok({
        parser: with_no_brace(arms.parser, saved),
        node: EMatch({ span: span_to(st.node, arms.close), scrutinee: scrut, arms: arms.arms }),
      }),
  }
}

type ParsedArms = { parser: Parser, close: Span, arms: List<MatchArm> }

fn match_arms(input: Input, parser: Parser) -> Result<ParsedArms, Parser> / {abort.raise} = {
  let { parser, node: o } = expect(input, parser, token_lbrace(), b"`{` to start the match arms")?;
  let body = iterate(
    { parser: parser, out: [] },
    input.token_count - parser.pos + 1,
    |s: SoFar<MatchArm>|
      if at_token(input, s.parser, token_rbrace()) { Stop(Ok(s)) } else if at_eof(input, s.parser) {
        Stop(Err(unclosed(input, s.parser, o, b"`}` to close the match arms")))
      } else { match_arm_step(input, s, o) },
  )?;
  let { parser, node: cl } = expect_close(
    input,
    body.parser,
    token_rbrace(),
    o,
    b"`}` to close the match arms",
  )?;
  Ok({ parser: parser, close: cl, arms: body.out })
}

fn arm_guard(input: Input, parser: Parser) -> Result<Parsed<Option<Expr>>, Parser> / {abort.raise} = {
  let gif = eat(input, parser, keyword_if());
  if !gif.ok { Ok({ parser: gif.parser, node: None }) } else {
    let { parser, node: g } = expr(input, gif.parser)?;
    Ok({ parser: parser, node: Some(g) })
  }
}

fn match_arm_step(
  input: Input,
  s: SoFar<MatchArm>,
  open: Span,
) -> Iter<SoFar<MatchArm>, Result<SoFar<MatchArm>, Parser>> / {abort.raise} =
  match pattern(input, s.parser) {
    Err(q) -> Stop(Err(q)),
    Ok(pat) -> match arm_guard(input, pat.parser) {
      Err(q) -> Stop(Err(q)),
      Ok(guard) -> match expect(input, guard.parser, token_arrow(), b"`->` and the arm body") {
        Err(q) -> Stop(Err(q)),
        Ok(arrow) -> match expr(input, arrow.parser) {
          Err(q) -> Stop(Err(q)),
          Ok(body) -> {
            let arm = {
              pat: pat.node,
              guard: guard.node,
              body: body.node,
              span: span_to(pat_span(pat.node), expr_span(body.node)),
            };
            // The comma is eaten before the `}` test, whichever way the test goes.
            let comma = eat(input, body.parser, token_comma());
            if comma.ok || at_token(input, comma.parser, token_rbrace()) {
              Continue({ parser: comma.parser, out: s.out.push(arm) })
            } else if at_eof(input, comma.parser) {
              Stop(Err(unclosed(input, comma.parser, open, b"`}` to close the match arms")))
            } else if !is_block_like(arm.body) {
              Stop(
                Err(
                  error_here(
                    input,
                    comma.parser,
                    b"`,` between match arms, or `}` to end the match",
                  ),
                ),
              )
            } else { Continue({ parser: comma.parser, out: s.out.push(arm) }) }
          },
        },
      },
    },
  }

fn handle_expr(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let saved = st.parser.no_brace;
  match handle_rest(input, with_no_brace(st.parser, false), st.node) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

type ParsedClauses = {
  parser: Parser,
  ret: Option<ReturnClause>,
  clauses: List<HandleClause>,
  vars: List<HandlerVar>,
}

fn handle_rest(
  input: Input,
  parser: Parser,
  span: Span,
) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let { parser, node: body } = expr(input, parser)?;
  let { parser, .. } = expect(
    input,
    parser,
    keyword_with(),
    b"`with` and then the handler clauses",
  )?;
  let { parser, node: o } = expect(
    input,
    parser,
    token_lbrace(),
    b"`{` to start the handler clauses",
  )?;
  let acc = iterate(
    { parser: parser, ret: None, clauses: [], vars: [] },
    input.token_count - parser.pos + 1,
    |s: ParsedClauses|
      if at_token(input, s.parser, token_rbrace()) { Stop(Ok(s)) } else if at_eof(input, s.parser) {
        Stop(Err(unclosed(input, s.parser, o, b"`}` to close the handler")))
      } else { handle_step(input, s) },
  )?;
  let { parser, node: cl } = expect_close(
    input,
    acc.parser,
    token_rbrace(),
    o,
    b"`}` to close the handler",
  )?;
  Ok({
    parser: parser,
    node: EHandle({
      span: span_to(span, cl),
      body: body,
      ret: acc.ret,
      clauses: acc.clauses,
      vars: acc.vars,
    }),
  })
}

/// `return` and `var` are contextual here too: each starts an item only when a name follows it.
fn handle_step(
  input: Input,
  s: ParsedClauses,
) -> Iter<ParsedClauses, Result<ParsedClauses, Parser>> / {abort.raise} =
  if at_ident_text(input, s.parser, b"return") && is_ident_at(input, s.parser, 1) {
    match return_clause(input, s.parser) {
      Err(q) -> Stop(Err(q)),
      Ok(rc) -> {
        let next = match s.ret {
          None -> { ..s, parser: rc.parser, ret: Some(rc.node) },
          // A duplicate `return` is reported and dropped; the parse carries on.
          Some(prev) ->
            {
              ..s,
              parser: push_diag(
                rc.parser,
                error_at_and(
                  unexpected(),
                  rc.node.span,
                  b"a handler may have only one `return` clause",
                  b"duplicate `return` clause",
                  prev.span,
                  b"first one is here",
                  [],
                ),
              ),
            },
        };
        let comma = eat(input, next.parser, token_comma());
        Continue({ ..next, parser: comma.parser })
      },
    }
  } else if at_ident_text(input, s.parser, b"var") && is_ident_at(input, s.parser, 1) {
    match handler_var(input, s.parser) {
      Err(q) -> Stop(Err(q)),
      Ok(v) -> {
        // A variable written after a clause is reported and kept; the parse carries on.
        let first = s.clauses.len() == 0 && (match s.ret { None -> true, Some(_) -> false });
        let placed = if first { v.parser } else {
          push_diag(
            v.parser,
            error_at(
              unexpected(),
              v.node.span,
              b"a handler's `var`s come before its clauses",
              b"move this `var` above the first clause",
              [],
            ),
          )
        };
        let comma = eat(input, placed, token_comma());
        Continue({ ..s, parser: comma.parser, vars: s.vars.push(v.node) })
      },
    }
  } else {
    match handle_clause(input, s.parser) {
      Err(q) -> Stop(Err(q)),
      Ok(cl) -> {
        let comma = eat(input, cl.parser, token_comma());
        Continue({ ..s, parser: comma.parser, clauses: s.clauses.push(cl.node) })
      },
    }
  }

/// `var name: T = init`, the type optional.
fn handler_var(input: Input, parser: Parser) -> Result<Parsed<HandlerVar>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let { parser, node: name } = expect_ident(input, st.parser, b"the variable's name after `var`")?;
  let { parser, node: t } = let_ty(input, parser)?;
  let { parser, .. } = expect(input, parser, token_eq(), b"`=` and the variable's first value")?;
  let { parser, node: init } = expr(input, parser)?;
  Ok({
    parser: parser,
    node: { name: name, ty: t, init: init, span: span_to(st.node, expr_span(init)) },
  })
}

fn is_ident_at(input: Input, parser: Parser, n: Int) -> Bool =
  match token_kind_at(input, parser, n) { Identifier(x) -> true, _ -> false }

/// `resume` is a keyword only between a clause's `)` and its `->`.
fn clause_resume(
  input: Input,
  parser: Parser,
) -> Result<Parsed<Option<Ident>>, Parser> / {abort.raise} =
  if !at_ident_text(input, parser, b"resume") { Ok({ parser: parser, node: None }) } else {
    let a = advance(input, parser);
    let { parser, node: n } = expect_ident(input, a.parser, b"a name to bind the continuation to")?;
    Ok({ parser: parser, node: Some(n) })
  }

fn handle_clause(
  input: Input,
  parser: Parser,
) -> Result<Parsed<HandleClause>, Parser> / {abort.raise} = {
  let { parser, node: eff } = qname(input, parser, b"an effect name, or `return`")?;
  let { parser, .. } = expect(input, parser, token_dot(), b"`.` and the operation name")?;
  let { parser, node: op } = expect_ident(input, parser, b"an operation name")?;
  let { parser, node: res } = clause_resource(input, parser)?;
  let { parser, node: o } = expect(
    input,
    parser,
    token_lparen(),
    b"`(` to start the clause parameters",
  )?;
  let { parser, node: params } = comma_list(input, parser, token_rparen(), clause_param)?;
  let { parser, .. } = expect_close(
    input,
    parser,
    token_rparen(),
    o,
    b"`)` to close the clause parameters",
  )?;
  let { parser, node: resume } = clause_resume(input, parser)?;
  let { parser, .. } = expect(input, parser, token_arrow(), b"`->` and the clause body")?;
  let { parser, node: body } = expr(input, parser)?;
  Ok({
    parser: parser,
    node: {
      eff: eff,
      op: op,
      resource: res.name,
      every_label: res.every,
      label_binder: res.binder,
      resume: resume,
      body: body,
      span: span_to(eff.span, expr_span(body)),
      params: params,
    },
  })
}

fn clause_param(input: Input, parser: Parser) -> Result<Parsed<Ident>, Parser> / {abort.raise} =
  expect_binder(input, parser, b"a clause parameter name")

fn return_clause(
  input: Input,
  parser: Parser,
) -> Result<Parsed<ReturnClause>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let { parser, node: binder } = expect_ident(input, st.parser, b"a binder after `return`")?;
  let { parser, .. } = expect(input, parser, token_arrow(), b"`->` and the `return` body")?;
  let { parser, node: body } = expr(input, parser)?;
  Ok({
    parser: parser,
    node: { binder: binder, body: body, span: span_to(st.node, expr_span(body)) },
  })
}

fn with_hold_expr(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let { parser, node: br } = expect(input, st.parser, token_lbracket(), b"`[` and a region name")?;
  let { parser, node: resource } = expect_ident(input, parser, b"a region name inside `[..]`")?;
  let { parser, .. } = expect_close(input, parser, token_rbracket(), br, b"`]`")?;
  let saved = parser.no_brace;
  match with_hold_rest(input, with_no_brace(parser, false), st.node, resource) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

fn with_hold_rest(
  input: Input,
  parser: Parser,
  span: Span,
  resource: Ident,
) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let { parser, node: paren } = expect(
    input,
    parser,
    token_lparen(),
    b"`(` and what the hold acquires",
  )?;
  let { parser, node: acquire } = expr(input, parser)?;
  let { parser, .. } = expect(
    input,
    parser,
    token_comma(),
    b"`,` and the function that releases what was acquired",
  )?;
  let { parser, node: release } = expr(input, parser)?;
  let { parser, .. } = eat(input, parser, token_comma());
  let { parser, .. } = expect_close(
    input,
    parser,
    token_rparen(),
    paren,
    b"`)` after the release function",
  )?;
  let { parser, node: brace } = expect(
    input,
    parser,
    token_lbrace(),
    b"`{` to start the hold's region",
  )?;
  let { parser, node: binder } = expect_ident(input, parser, b"a name to bind the hold to")?;
  let { parser, .. } = expect(input, parser, token_arrow(), b"`->` and the region body")?;
  let { parser, node: body } = expr(input, parser)?;
  let { parser, node: cl } = expect_close(
    input,
    parser,
    token_rbrace(),
    brace,
    b"`}` to close the hold's region",
  )?;
  Ok({
    parser: parser,
    node: EWithHold({
      span: span_to(span, cl),
      resource: resource,
      acquire: acquire,
      release: release,
      binder: binder,
      body: body,
    }),
  })
}

fn simulate_expr(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let { parser, node: body } = block_expr(input, st.parser)?;
  Ok({ parser: parser, node: ESimulate({ span: span_to(st.node, expr_span(body)), body: body }) })
}

/// `try` is the block's wherever a `{` follows it, a scrutinee included, so `match try { .. } { .. }`
/// reads; before `[` it is one only when the bracket names an operation, which no label does.
fn opens_try(input: Input, parser: Parser) -> Bool =
  token_kind_at(input, parser, 1) == token_lbrace()
    || (token_kind_at(input, parser, 1) == token_lbracket()
    && (match token_kind_at(input, parser, 2) { Identifier(_) -> true, _ -> false })
    && (token_kind_at(input, parser, 3) == token_dot()
    || token_kind_at(input, parser, 3) == token_coloncolon()))

fn try_expr(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let saved = st.parser.no_brace;
  match try_rest(input, with_no_brace(st.parser, false), st.node) {
    Err(q) -> Err(with_no_brace(q, saved)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, saved), node: r.node }),
  }
}

fn try_rest(
  input: Input,
  parser: Parser,
  start: Span,
) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let { parser, node: raise } = try_raise(input, parser)?;
  let { parser, node: body } = block_expr(input, parser)?;
  Ok({
    parser: parser,
    node: ETryBlock({ span: span_to(start, expr_span(body)), raise: raise, body: body }),
  })
}

fn try_raise(
  input: Input,
  parser: Parser,
) -> Result<Parsed<Option<RaiseName>>, Parser> / {abort.raise} =
  if !at_token(input, parser, token_lbracket()) { Ok({ parser: parser, node: None }) } else {
    let o = advance(input, parser);
    let { parser, node: eff } = qname(input, o.parser, b"an effect name")?;
    let { parser, .. } = expect(input, parser, token_dot(), b"`.` and the operation name")?;
    let { parser, node: op } = expect_ident(input, parser, b"an operation name")?;
    let { parser, .. } = expect_close(input, parser, token_rbracket(), o.node, b"`]`")?;
    Ok({ parser: parser, node: Some({ eff: eff, op: op }) })
  }

fn parallel_expr(input: Input, parser: Parser) -> Result<Parsed<Expr>, Parser> / {abort.raise} = {
  let st = advance(input, parser);
  let saved = st.parser.no_brace;
  let { parser, node: brace } = expect(
    input,
    with_no_brace(st.parser, false),
    token_lbrace(),
    b"`{` to start the branches",
  )?;
  let { parser, node: branches } = comma_list(input, parser, token_rbrace(), expr)?;
  // One branch would be a tuple of one, which Ply has none of.
  if branches.len() < 2 { Err(error_here(input, parser, b"`,` and a second branch")) } else {
    let { parser, node: cl } = expect_close(
      input,
      parser,
      token_rbrace(),
      brace,
      b"`}` to close the branches",
    )?;
    Ok({
      parser: with_no_brace(parser, saved),
      node: EParallel({ span: span_to(st.node, cl), branches: branches }),
    })
  }
}

// --- The dump ---------------------------------------------------------------

pub fn dump_expr(expr: Expr) -> Bytes / {abort.raise} =
  match expr {
    ELit(v) -> dump_node(v.span, b"elit").concat(dump_lit(v.lit)),
    EVar(v) -> dump_node(v.span, b"evar").concat(dump_qname(v.name)),
    EBinary(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"ebin"),
        dump_word(v.op),
        dump_expr(v.lhs),
        dump_expr(v.rhs),
      ]),
    EUnary(v) ->
      Bytes::concat_all([dump_node(v.span, b"eun"), dump_word(v.op), dump_expr(v.operand)]),
    ELambda(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"elam"),
        dump_list(v.params, dump_param),
        dump_opt(v.ret, dump_ty),
        dump_expr(v.body),
      ]),
    EApp(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"eapp"),
        dump_expr(v.func),
        dump_list(v.args, dump_expr),
        dump_list(v.named, dump_named),
        dump_list(v.labels, dump_ident),
      ]),
    EIf(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"eif"),
        dump_expr(v.cond),
        dump_expr(v.then_branch),
        dump_expr(v.else_branch),
      ]),
    EMatch(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"emat"),
        dump_expr(v.scrutinee),
        dump_list(v.arms, dump_arm),
      ]),
    EBlock(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"eblk"),
        dump_list(v.stmts, dump_stmt),
        dump_opt(v.tail, dump_expr),
      ]),
    ERecord(v) -> dump_node(v.span, b"erec").concat(dump_list(v.fields, dump_field)),
    ERecordUpdate(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"erup"),
        dump_expr(v.base),
        dump_list(v.fields, dump_field),
      ]),
    ETry(v) -> dump_node(v.span, b"etry").concat(dump_expr(v.operand)),
    EField(v) ->
      Bytes::concat_all([dump_node(v.span, b"efld"), dump_expr(v.base), dump_ident(v.field)]),
    EList(v) -> dump_node(v.span, b"elst").concat(dump_list(v.items, dump_expr)),
    EPerform(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"eprf"),
        dump_qname(v.eff),
        dump_ident(v.op),
        dump_opt(v.resource, dump_ident),
        dump_list(v.args, dump_expr),
      ]),
    EHandle(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"ehnd"),
        dump_expr(v.body),
        dump_list(v.clauses, dump_clause),
        dump_opt(v.ret, dump_return),
        // Written only where there are any, so a handle without variables dumps as it always has.
        if v.vars.len() == 0 { b"" }
        else { dump_word(b"vars").concat(dump_list(v.vars, dump_var)) },
      ]),
    EWithHold(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"ehld"),
        dump_ident(v.resource),
        dump_expr(v.acquire),
        dump_expr(v.release),
        dump_ident(v.binder),
        dump_expr(v.body),
      ]),
    ESimulate(v) -> dump_node(v.span, b"esim").concat(dump_expr(v.body)),
    EParallel(v) -> dump_node(v.span, b"epar").concat(dump_list(v.branches, dump_expr)),
    ETagged(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"etag"),
        dump_ident(v.tag),
        dump_lit(LStr(v.text)),
        dump_list(v.holes, |h: Hole| dump_expr(h.value).concat(dump_lit(LStr(h.text)))),
      ]),
    EHole(v) -> dump_node(v.span, b"ehole").concat(dump_lit(LStr(v.text))),
    EBad(v) -> dump_node(v.span, b"ebad"),
    ETryBlock(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"etrb"),
        dump_opt(v.raise, |r: RaiseName| dump_qname(r.eff).concat(dump_ident(r.op))),
        dump_expr(v.body),
      ]),
  }

fn dump_field(field: RecField) -> Bytes / {abort.raise} =
  dump_ident(field.name).concat(dump_expr(field.value))

fn dump_named(arg: NamedArg) -> Bytes / {abort.raise} =
  Bytes::concat_all([dump_node(arg.span, b"narg"), dump_ident(arg.name), dump_expr(arg.value)])

/// A cost or space name is written only where one is, so a parameter without one dumps as it always
/// has.
pub fn dump_param(param: Param) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_node(param.span, b"prm"),
    dump_ident(param.name),
    if param.keep { dump_word(b"keep") } else { b"" },
    dump_opt(param.ty, dump_ty),
    match param.cost { Some(k) -> dump_word(b"cost").concat(dump_ident(k)), None -> b"" },
    match param.space { Some(s) -> dump_word(b"space").concat(dump_ident(s)), None -> b"" },
    dump_opt(param.default, dump_expr),
  ])

pub fn dump_stmt(stmt: Stmt) -> Bytes / {abort.raise} =
  match stmt {
    SLet(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"slet"),
        dump_pattern(v.pat),
        dump_opt(v.ty, dump_ty),
        dump_expr(v.value),
      ]),
    SLetElse(v) ->
      Bytes::concat_all([
        dump_node(v.span, b"slete"),
        dump_pattern(v.pat),
        dump_opt(v.ty, dump_ty),
        dump_expr(v.value),
        dump_expr(v.fallback),
      ]),
    SExpr(e) -> dump_node(expr_span(e), b"sexp").concat(dump_expr(e)),
    SAssign(v) ->
      Bytes::concat_all([dump_node(v.span, b"sasg"), dump_ident(v.name), dump_expr(v.value)]),
  }

pub fn dump_arm(arm: MatchArm) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_node(arm.span, b"arm"),
    dump_pattern(arm.pat),
    dump_opt(arm.guard, dump_expr),
    dump_expr(arm.body),
  ])

pub fn dump_clause(clause: HandleClause) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_node(clause.span, b"hcl"),
    dump_qname(clause.eff),
    dump_ident(clause.op),
    dump_opt(clause.resource, dump_ident),
    dump_opt(clause.label_binder, dump_ident),
    dump_list(clause.params, dump_ident),
    dump_opt(clause.resume, dump_ident),
    dump_expr(clause.body),
  ])

pub fn dump_var(v: HandlerVar) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_node(v.span, b"hvar"),
    dump_ident(v.name),
    dump_opt(v.ty, dump_ty),
    dump_expr(v.init),
  ])

pub fn dump_return(clause: ReturnClause) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_node(clause.span, b"rcl"),
    dump_ident(clause.binder),
    dump_expr(clause.body),
  ])

// --- The area's own entry point ---------------------------------------------

/// One expression, then end of input; on failure the dump is the diagnostics alone.
pub fn dump_expr_of(src: Bytes) -> String / {abort.raise} = {
  let s = start(src);
  let r = expr(s.input, s.parser);
  let v = parsed_or(r, no_expr());
  let bad = failed(r);
  let fin = if bad || at_eof(s.input, v.parser) { v.parser }
  else { error_here(s.input, v.parser, b"end of input after the expression") };
  let tree = if bad || !at_eof(s.input, v.parser) { b"" } else { dump_expr(v.node) };
  String::of_bytes(tree.concat(dump_diags(fin.diags)))
}

pub fn dump_param_of(src: Bytes) -> String / {abort.raise} = {
  let s = start(src);
  let r = parsed_or(param(s.input, s.parser), no_param());
  String::of_bytes(dump_param(r.node).concat(dump_diags(r.parser.diags)))
}

pub fn dump_fn_param_of(src: Bytes) -> String / {abort.raise} = {
  let s = start(src);
  let r = parsed_or(fn_param(s.input, s.parser), no_param());
  String::of_bytes(dump_param(r.node).concat(dump_diags(r.parser.diags)))
}

/// Total on purpose: a probe uses it to touch the whole tree.
pub fn node_count(expr: Expr) -> Int =
  match expr {
    ELit(v) -> 1,
    EVar(v) -> 1,
    EBinary(v) -> 1 + node_count(v.lhs) + node_count(v.rhs),
    EUnary(v) -> 1 + node_count(v.operand),
    ELambda(v) -> 1 + count_params(v.params) + node_count(v.body),
    EApp(v) ->
      1 + node_count(v.func) + count_all(v.args)
        + v.named.fold(0, |n: Int, arg: NamedArg| n + 1 + node_count(arg.value)),
    EIf(v) -> 1 + node_count(v.cond) + node_count(v.then_branch) + node_count(v.else_branch),
    EMatch(v) ->
      1 + node_count(v.scrutinee)
        + v.arms.fold(0, |n: Int, arm: MatchArm|
          n + 1 + count_opt(arm.guard) + node_count(arm.body)),
    EBlock(v) -> 1 + v.stmts.fold(0, |n: Int, stmt: Stmt| n + count_stmt(stmt)) + count_opt(v.tail),
    ERecord(v) -> 1 + v.fields.fold(0, |n: Int, field: RecField| n + 1 + node_count(field.value)),
    ERecordUpdate(v) ->
      1 + node_count(v.base)
        + v.fields.fold(0, |n: Int, field: RecField| n + 1 + node_count(field.value)),
    ETry(v) -> 1 + node_count(v.operand),
    EField(v) -> 1 + node_count(v.base),
    EList(v) -> 1 + count_all(v.items),
    EPerform(v) -> 1 + count_all(v.args),
    EHandle(v) ->
      1 + node_count(v.body)
        + v.clauses.fold(0, |n: Int, clause: HandleClause|
          n + 1 + clause.params.len() + node_count(clause.body))
        + (match v.ret { None -> 0, Some(r) -> 1 + node_count(r.body) })
        + v.vars.fold(0, |n: Int, hv: HandlerVar| n + 1 + node_count(hv.init)),
    EWithHold(v) -> 1 + node_count(v.acquire) + node_count(v.release) + node_count(v.body),
    ESimulate(v) -> 1 + node_count(v.body),
    EParallel(v) -> 1 + count_all(v.branches),
    ETagged(v) -> 1 + v.holes.fold(0, |n: Int, h: Hole| n + node_count(h.value)),
    EHole(_) -> 1,
    EBad(v) -> 1,
    ETryBlock(v) -> 1 + node_count(v.body),
  }

fn count_all(exprs: List<Expr>) -> Int = exprs.fold(0, |n: Int, expr: Expr| n + node_count(expr))

pub fn count_params(params: List<Param>) -> Int =
  params.fold(0, |n: Int, param: Param| n + 1 + count_opt(param.default))

fn count_opt(expr: Option<Expr>) -> Int = match expr { None -> 0, Some(x) -> node_count(x) }

fn count_stmt(stmt: Stmt) -> Int =
  match stmt {
    SLet(v) -> 1 + node_count(v.value),
    SLetElse(v) -> 1 + node_count(v.value) + node_count(v.fallback),
    SExpr(e) -> 1 + node_count(e),
    SAssign(v) -> 1 + node_count(v.value),
  }

pub fn parse_count(src: Bytes) -> Int / {abort.raise} = {
  let s = start(src);
  node_count(parsed_or(expr(s.input, s.parser), no_expr()).node)
}

pub fn is_arithmetic(op: Bytes) -> Bool =
  op == b"add" || op == b"sub" || op == b"mul" || op == b"div" || op == b"rem"

pub fn is_ordered(op: Bytes) -> Bool = op == b"lt" || op == b"le" || op == b"gt" || op == b"ge"

// --- Tests ------------------------------------------------------------------

test "the bit operators sit between the comparisons and the concatenation, loosest first" {
  assert_eq(
    dump_expr_of(b"a | b ^ c & d"),
    "0:13:ebin;%bitor;0:1:evar;0:1:qname;?0;0:1:ident;@61;4:13:ebin;%bitxor;4"
      ++ ":5:evar;4:5:qname;?0;4:5:ident;@62;8:13:ebin;%bitand;8:9:evar;8:9:qname;"
      ++ "?0;8:9:ident;@63;12:13:evar;12:13:qname;?0;12:13:ident;@64;#0;",
  )
}

test "a shift is touching `<`s or `>`s, and `>>>` is read before `>>`" {
  assert_eq(
    dump_expr_of(b"a << b >> c >>> d"),
    "0:17:ebin;%ushr;0:11:ebin;%shr;0:6:ebin;%shl;0:1:evar;0:1:qname;?0;0:1:i"
      ++ "dent;@61;5:6:evar;5:6:qname;?0;5:6:ident;@62;10:11:evar;10:11:qname;?0;1"
      ++ "0:11:ident;@63;16:17:evar;16:17:qname;?0;16:17:ident;@64;#0;",
  )
}

test "`~` is a unary operator, tighter than any binary" {
  assert_eq(
    dump_expr_of(b"~a + b"),
    "0:6:ebin;%add;0:2:eun;%bitnot;1:2:evar;1:2:qname;?0;1:2:ident;@61;5:6:ev"
      ++ "ar;5:6:qname;?0;5:6:ident;@62;#0;",
  )
}

test "inside a lambda's parameter list a `|` closes the list; in its body it is bit-or again" {
  // `x = 1` is a default, refused as `E0120`.
  assert_eq(
    dump_expr_of(b"|x = 1| x | 2"),
    "0:13:elam;#1;1:2:prm;1:2:ident;@78;?0;?0;?0;8:13:ebin;%bitor;8:9:evar;8:"
      ++ "9:qname;?0;8:9:ident;@78;12:13:elit;%int;@32;#1;!E0120:3:6:1:1;=3:6:1;",
  )
}

test "a keyword names a field in a literal and after `.`" {
  assert_eq(
    dump_expr_of(b"{effect: 1, type: 2}.type"),
    "0:25:efld;0:20:erec;#2;1:7:ident;@656666656374;9:10:elit;%int;@31;12:16:"
      ++ "ident;@74797065;18:19:elit;%int;@32;21:25:ident;@74797065;#0;",
  )
}

test "the try operator is a node of its own and takes the `?` into its span" {
  assert_eq(dump_expr_of(b"x?"), "0:2:etry;0:1:evar;0:1:qname;?0;0:1:ident;@78;#0;");
  // `x??` nests left.
  assert_eq(dump_expr_of(b"x??"), "0:3:etry;0:2:etry;0:1:evar;0:1:qname;?0;0:1:ident;@78;#0;");
}

test "a hole is an expression, `???` or `..`, and three question marks are one, not three tries" {
  assert_eq(dump_expr_of(b"???"), "0:3:ehole;%str;@3f3f3f;#0;");
  assert_eq(dump_expr_of(b".."), "0:2:ehole;%str;@2e2e;#0;");
  assert_eq(
    dump_expr_of(b"f(???)"),
    "0:6:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;2:5:ehole;%str;@3f3f3f;#0;#0;#0;",
  );
  // Maximal munch: `x???` is `x` then a hole, not `(x?)?` then `?`.
  assert_eq(dump_expr_of(b"x???"), "#1;!E0001:1:4:1:0;=1:4:1;");
  // `..` after `{` still opens a record update.
  assert_eq(
    dump_expr_of(b"{ ..r, x: 1 }"),
    "0:13:erup;4:5:evar;4:5:qname;?0;4:5:ident;@72;#1;7:8:ident;@78;10:11:elit;%int;@31;#0;",
  )
}

test "the try operator binds tighter than a unary and than any binary" {
  // `-x?` is `-(x?)`: the `eun` is outside.
  assert_eq(dump_expr_of(b"-x?"), "0:3:eun;%neg;1:3:etry;1:2:evar;1:2:qname;?0;1:2:ident;@78;#0;");
  // `x? + y` is `(x?) + y`.
  assert_eq(
    dump_expr_of(b"x? + y"),
    "0:6:ebin;%add;0:2:etry;0:1:evar;0:1:qname;?0;0:1:ident;@78;"
      ++ "5:6:evar;5:6:qname;?0;5:6:ident;@79;#0;",
  )
}

test "a record update carries its base, and `{..b}` needs no comma" {
  assert_eq(
    dump_expr_of(b"{..b, x: 1}"),
    "0:11:erup;3:4:evar;3:4:qname;?0;3:4:ident;@62;#1;6:7:ident;@78;" ++ "9:10:elit;%int;@31;#0;",
  );
  assert_eq(dump_expr_of(b"{..b}"), "0:5:erup;3:4:evar;3:4:qname;?0;3:4:ident;@62;#0;#0;")
}

test "the base of a record update is a path and not an expression" {
  assert_eq(
    dump_expr_of(b"{..s.i, x: 1}"),
    "0:13:erup;3:6:efld;3:4:evar;3:4:qname;?0;3:4:ident;@73;5:6:ident;@69;"
      ++ "#1;8:9:ident;@78;11:12:elit;%int;@31;#0;",
  );
  // `...b` is one dot too many.
  assert_eq(dump_expr_of(b"{...b}"), "#1;!E0001:1:4:1:1;=1:4:1;");
  // A second `..` has no defined order of fields.
  assert_eq(dump_expr_of(b"{..a, ..b}"), "#1;!E0001:6:8:1:1;=6:8:1;")
}

// The printer qualifies an imported name, so a base it writes as `m::f(x)` must read back.
test "the base of a record update may be a qualified name, or a call of one" {
  assert(dump_expr_of(b"{..m::b, x: 1}").starts_with("0:14:erup;3:7:evar;3:7:qname;?1;"));
  let call = dump_expr_of(b"{..m::f(x)}");
  assert(call.starts_with("0:11:erup;3:10:eapp;"));
  assert(call.contains("3:7:qname;?1;"));
  // An operation is performed there as anywhere else, on a label too.
  assert(dump_expr_of(b"{..store.held(), x: 1}").starts_with("0:22:erup;3:15:eprf;"));
  assert(dump_expr_of(b"{..store.held[db]()}").starts_with("0:20:erup;3:19:eprf;"))
}

test "a named argument is a node with its own span, its name and its value" {
  assert_eq(
    dump_expr_of(b"f(1, b: 2)"),
    "0:10:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;2:3:elit;%int;@31;"
      ++ "#1;5:9:narg;5:6:ident;@62;8:9:elit;%int;@32;#0;#0;",
  );
  // The two-token lookahead: `f(x)` is positional and `f(x: 1)` is not.
  assert_eq(
    dump_expr_of(b"f(x)"),
    "0:4:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;2:3:evar;2:3:qname;?0;"
      ++ "2:3:ident;@78;#0;#0;#0;",
  )
}

// Neither `E0124` nor `E0123` fails the parse, so the call is still built and dumped.
test "a positional argument after a named one is refused, once each" {
  // Each offending positional points back at the first named argument.
  assert_eq(
    dump_expr_of(b"f(a: 1, 2)"),
    "0:10:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;8:9:elit;%int;@32;"
      ++ "#1;2:6:narg;2:3:ident;@61;5:6:elit;%int;@31;#0;"
      ++ "#1;!E0124:8:9:2:1;=8:9:1;=2:6:0;",
  );
  assert_eq(
    dump_expr_of(b"f(a: 1, 2, 3)"),
    "0:13:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#2;8:9:elit;%int;@32;"
      ++ "11:12:elit;%int;@33;#1;2:6:narg;2:3:ident;@61;5:6:elit;%int;@31;#0;"
      ++ "#2;!E0124:8:9:2:1;=8:9:1;=2:6:0;!E0124:11:12:2:1;=11:12:1;=2:6:0;",
  )
}

test "a parameter's type and its default are both optional" {
  assert_eq(dump_param_of(b"x"), "0:1:prm;0:1:ident;@78;?0;?0;#0;");
  assert_eq(
    dump_param_of(b"x: Int"),
    "0:6:prm;0:1:ident;@78;?1;3:6:tcon;3:6:qname;?0;3:6:ident;@496e74;#0;?0;#0;",
  );
  assert_eq(
    dump_param_of(b"x: (Int) -> Bool"),
    "0:16:prm;0:1:ident;@78;?1;3:16:tfn;#1;4:7:tcon;4:7:qname;?0;4:7:ident;@496e74;#0;12:16:tcon;12:16:qname;?0;12:16:ident;@426f6f6c;#0;?0;?0;#0;",
  );
  assert_eq(dump_param_of(b"x:"), "0:0:prm;0:0:ident;@;?0;?0;#1;!E0001:2:2:1:0;=2:2:1;")
}

test "a fn parameter may carry a default and a lambda parameter may not" {
  assert_eq(
    dump_fn_param_of(b"x: Int = 1"),
    "0:10:prm;0:1:ident;@78;?1;3:6:tcon;3:6:qname;?0;3:6:ident;@496e74;#0;"
      ++ "?1;9:10:elit;%int;@31;#0;",
  );
  assert_eq(dump_fn_param_of(b"x = 1"), "0:5:prm;0:1:ident;@78;?0;?1;4:5:elit;%int;@31;#0;");
  // Refused, so `default` is `None` and the span ends at the type.
  assert_eq(
    dump_param_of(b"x: Int = 1"),
    "0:6:prm;0:1:ident;@78;?1;3:6:tcon;3:6:qname;?0;3:6:ident;@496e74;#0;"
      ++ "?0;#1;!E0120:7:10:1:1;=7:10:1;",
  )
}

test "a fn parameter of a function type may name its cost, and no other parameter may" {
  let named = dump_fn_param_of(b"g: (Int) -> Int cost k");
  assert(named.contains("%cost;"), Some(named));
  assert(named.ends_with(";@6b;?0;#0;"), Some(named));
  assert(dump_fn_param_of(b"n: Int cost k").contains("!E0001"));
  // A lambda's parameter is called where it is written, so it names no cost.
  assert(!dump_param_of(b"g: (Int) -> Int cost k").contains("%cost;"))
}

test "a fn parameter of a function type may name its space after its cost, and no other parameter may" {
  let named = dump_fn_param_of(b"g: (Int) -> Int space s");
  assert(named.contains("%space;") && !named.contains("%cost;"), Some(named));
  assert(named.ends_with(";@73;?0;#0;"), Some(named));
  let both = dump_fn_param_of(b"g: (Int) -> Int cost k space s");
  assert(both.contains("%cost;") && both.ends_with(";@73;?0;#0;"), Some(both));
  assert(dump_fn_param_of(b"n: Int space s").contains("!E0001"));
  // Written after the space name, `cost` is no name of the parameter's.
  assert(!dump_fn_param_of(b"g: (Int) -> Int space s cost k").contains("%cost;"));
  assert(!dump_param_of(b"g: (Int) -> Int space s").contains("%space;"))
}

test "a parameter may be written `keep` before its type, and `keep` alone is a type variable's name" {
  let kept = dump_fn_param_of(b"g: keep (Int) -> Int");
  assert(kept.contains("%keep;"), Some(kept));
  assert(!dump_fn_param_of(b"g: (Int) -> Int").contains("%keep;"));
  // The checker judges what `keep` stands before.
  let resource = dump_fn_param_of(b"c: keep Conn");
  assert(resource.contains("%keep;") && !resource.contains("!E0001"), Some(resource));
  let named = dump_fn_param_of(b"n: keep");
  assert(
    named.contains(":tvar;") && !named.contains("%keep;") && !named.contains("!E0001"),
    Some(named),
  );
  assert(dump_param_of(b"c: keep Conn").contains("%keep;"))
}

test "a parameter may be written `_`, binding a name the body cannot write" {
  assert_eq(dump_param_of(b"_"), "0:1:prm;0:1:ident;@5f;?0;?0;#0;");
  assert_eq(
    dump_fn_param_of(b"_: Int"),
    "0:6:prm;0:1:ident;@5f;?1;3:6:tcon;3:6:qname;?0;3:6:ident;@496e74;#0;?0;#0;",
  )
}

test "a literal keeps its own span and its decoded value" {
  assert_eq(dump_expr_of(b"1"), "0:1:elit;%int;@31;#0;");
  assert_eq(dump_expr_of(b"true"), "0:4:elit;%bool;@31;#0;");
  assert_eq(dump_expr_of(b"()"), "0:2:elit;%unit;#0;");
  assert_eq(dump_expr_of(b"\"a\\n\""), "0:5:elit;%str;@610a;#0;");
}

test "a name touching a string is a tagged literal, and a postfix follows it as it follows any" {
  assert_eq(dump_expr_of(b"hex\"a\\n\""), "0:8:etag;0:3:ident;@686578;%str;@610a;#0;#0;");
  assert_eq(
    dump_expr_of(b"hex\"\".n"),
    "0:7:efld;0:5:etag;0:3:ident;@686578;%str;@;#0;6:7:ident;@6e;#0;",
  );
  // A space apart they are a name and then a string, which is no one expression.
  assert_eq(dump_expr_of(b"hex \"a\""), "#1;!E0001:4:7:1:0;=4:7:1;")
}

test "a tagged literal's holes are expressions between its texts, braces of their own included" {
  assert_eq(
    dump_expr_of(b"sh\"a {x} {{b}}\""),
    "0:15:etag;0:2:ident;@7368;%str;@6120;#1;6:7:evar;6:7:qname;?0;6:7:ident;@78;%str;@207b627d;#0;",
  );
  assert_eq(
    dump_expr_of(b"sh\"{ {n: 1}.n }{sh\"{y}\"}\""),
    "0:25:etag;0:2:ident;@7368;%str;@;#2;5:13:efld;5:11:erec;#1;6:7:ident;@6e;9:10:elit;%int;@31;12:13:ident;@6e;%str;@;16:23:etag;16:18:ident;@7368;%str;@;#1;20:21:evar;20:21:qname;?0;20:21:ident;@79;%str;@;%str;@;#0;",
  );
  // A hole that does not close is the interpolated string's diagnostic.
  assert(dump_expr_of(b"sh\"{x y}\"").starts_with("#1;!E0001"))
}

test "a float and a decimal are the source text, and no value is ever built" {
  assert_eq(dump_expr_of(b"1.5e-3"), "0:6:elit;%float;@312e35652d33;#0;");
  assert_eq(dump_expr_of(b"1.50m"), "0:5:elit;%dec;@312e35306d;#0;");
}

test "precedence binds the tighter operator first and stays left-associative" {
  assert_eq(
    dump_expr_of(b"1 + 2 * 3"),
    "0:9:ebin;%add;0:1:elit;%int;@31;4:9:ebin;%mul;4:5:elit;%int;@32;8:9:elit;%int;@33;#0;",
  );
  assert_eq(
    dump_expr_of(b"1 - 2 - 3"),
    "0:9:ebin;%sub;0:5:ebin;%sub;0:1:elit;%int;@31;4:5:elit;%int;@32;8:9:elit;%int;@33;#0;",
  );
}

test "a long left-associative chain is one iterate and adds no frames" {
  let whole = Bytes::concat_all(range(0, 400).map(|i: Int| b"1 + ")).concat(b"1");
  let s = start(whole);
  let rr = expr(s.input, s.parser);
  assert(!failed(rr));
  let r = parsed_or(rr, no_expr());
  assert_eq(r.parser.diags.len(), 0);
  assert_eq(node_count(r.node), 801);
}

test "an `else if` chain nests no deeper for being long, and every binding power can climb at once" {
  let arms = Bytes::concat_all(range(0, 2 * max_depth()).map(|i: Int| b"if x { 1 } else "));
  let chained = start(arms.concat(b"{ 2 }"));
  let read = expr(chained.input, chained.parser);
  assert(!failed(read));
  assert_eq(parsed_or(read, no_expr()).parser.diags.len(), 0);
  // Each operator binds tighter than the one before it, so each right operand is read a power up.
  let climbing = start(b"a || b && c == d | e ^ f & g << h ++ i + j * k");
  let climbed = expr(climbing.input, climbing.parser);
  assert(!failed(climbed));
  assert_eq(parsed_or(climbed, no_expr()).parser.diags.len(), 0)
}

test "each level of nesting spends one of the input's room, and one past it is refused there" {
  let nested = |n: Int|
    Bytes::concat_all([
      Bytes::concat_all(range(0, n).map(|i: Int| b"(")),
      b"1",
      Bytes::concat_all(range(0, n).map(|i: Int| b")")),
    ]);
  // The expression itself is one level, and each pair of parentheses another.
  let deepest = start(nested(max_depth() - 1));
  let fits = expr(deepest.input, deepest.parser);
  assert(!failed(fits));
  assert_eq(parsed_or(fits, no_expr()).parser.diags.len(), 0);
  let past = start(nested(max_depth()));
  match expr(past.input, past.parser) {
    Ok(_) -> assert(false),
    Err(q) ->
      assert_eq(q.diags.map(|d: ParseDiag| d.message), [b"input is nested too deeply to parse"]),
  }
}

test "a unary operator nests, and a `-` before a literal is an operator here" {
  assert_eq(dump_expr_of(b"-1"), "0:2:eun;%neg;1:2:elit;%int;@31;#0;");
  assert_eq(dump_expr_of(b"!x"), "0:2:eun;%not;1:2:evar;1:2:qname;?0;1:2:ident;@78;#0;");
}

test "application and field access chain left to right" {
  assert_eq(
    dump_expr_of(b"f(1)(2)"),
    "0:7:eapp;0:4:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;2:3:elit;%int;@31;#0;#0;#1;5:6:elit;%int;@32;#0;#0;#0;",
  );
  assert_eq(
    dump_expr_of(b"r.a.b"),
    "0:5:efld;0:3:efld;0:1:evar;0:1:qname;?0;0:1:ident;@72;2:3:ident;@61;4:5:ident;@62;#0;",
  );
}

test "a `.` before a name and an argument list is a perform, not a field read" {
  assert_eq(
    dump_expr_of(b"db.get[users](k)"),
    "0:16:eprf;0:2:qname;?0;0:2:ident;@6462;3:6:ident;@676574;?1;7:12:ident;@7573657273;#1;14:15:evar;14:15:qname;?0;14:15:ident;@6b;#0;",
  );
  assert_eq(
    dump_expr_of(b"db.get(k)"),
    "0:9:eprf;0:2:qname;?0;0:2:ident;@6462;3:6:ident;@676574;?0;#1;7:8:evar;7:8:qname;?0;7:8:ident;@6b;#0;",
  );
  assert_eq(
    dump_expr_of(b"db.get"),
    "0:6:efld;0:2:evar;0:2:qname;?0;0:2:ident;@6462;3:6:ident;@676574;#0;",
  );
}

test "a call may name the labels it fills" {
  assert_eq(
    dump_expr_of(b"relay[conn](c)"),
    "0:14:eapp;0:5:evar;0:5:qname;?0;0:5:ident;@72656c6179;#1;12:13:evar;"
      ++ "12:13:qname;?0;12:13:ident;@63;#0;#1;6:10:ident;@636f6e6e;#0;",
  );
  assert_eq(
    dump_expr_of(b"f[a, b](x)"),
    "0:10:eapp;0:1:evar;0:1:qname;?0;0:1:ident;@66;#1;8:9:evar;8:9:qname;?0;"
      ++ "8:9:ident;@78;#0;#2;2:3:ident;@61;5:6:ident;@62;#0;",
  );
  // With no call after it the bracket is not a label list, and the expression ends at the name.
  assert(dump_expr_of(b"f[a]").contains("!E0001:1:2:"))
}

// `simulate` stays a name in a scrutinee, which the test below this one holds.
test "a block-like expression may be a scrutinee or a condition" {
  let handled = dump_expr_of(b"match handle { g() } with { e.op(x) resume k -> 0 } { y -> y }");
  assert(!handled.contains("!E"));
  assert(handled.contains(":emat;"));
  assert(handled.contains(":ehnd;"));
  let branched = dump_expr_of(b"match if c { 1 } else { 2 } { y -> y }");
  assert(!branched.contains("!E"));
  assert(branched.contains(":eif;"));
  let nested = dump_expr_of(b"match match x { _ -> 1 } { y -> y }");
  assert(!nested.contains("!E"));
  let blocked = dump_expr_of(b"match { x } { y -> y }");
  assert(!blocked.contains("!E"));
  assert(blocked.contains(":eblk;"));
  assert(!dump_expr_of(b"if { x } { 1 }").contains("!E"))
}

test "a brace after an `if` scrutinee opens the block, never a record" {
  assert_eq(
    dump_expr_of(b"if x { 1 } else { 2 }"),
    "0:21:eif;3:4:evar;3:4:qname;?0;3:4:ident;@78;5:10:eblk;#0;?1;7:8:elit;%int;@31;16:21:eblk;#0;?1;18:19:elit;%int;@32;#0;",
  );
}

test "an `if` with no `else` gets a unit whose span is empty and at the end" {
  assert_eq(
    dump_expr_of(b"if x { 1 }"),
    "0:10:eif;3:4:evar;3:4:qname;?0;3:4:ident;@78;5:10:eblk;#0;?1;7:8:elit;%int;@31;10:10:elit;%unit;#0;",
  );
}

test "`else if` chains rather than nesting a block" {
  assert_eq(
    dump_expr_of(b"if a { 1 } else if b { 2 }"),
    "0:26:eif;3:4:evar;3:4:qname;?0;3:4:ident;@61;5:10:eblk;#0;?1;7:8:elit;%int;@31;16:26:eif;19:20:evar;19:20:qname;?0;19:20:ident;@62;21:26:eblk;#0;?1;23:24:elit;%int;@32;26:26:elit;%unit;#0;",
  );
}

test "`{x: e}` and `{x, y}` are records and `{x}` is a block" {
  assert_eq(dump_expr_of(b"{a: 1}"), "0:6:erec;#1;1:2:ident;@61;4:5:elit;%int;@31;#0;");
  assert_eq(
    dump_expr_of(b"{a, b}"),
    "0:6:erec;#2;1:2:ident;@61;1:2:evar;1:2:qname;?0;1:2:ident;@61;4:5:ident;@62;4:5:evar;4:5:qname;?0;4:5:ident;@62;#0;",
  );
  assert_eq(dump_expr_of(b"{a}"), "0:3:eblk;#0;?1;1:2:evar;1:2:qname;?0;1:2:ident;@61;#0;");
}

test "a block separates its statements from its tail" {
  assert_eq(
    dump_expr_of(b"{ let x = 1; x }"),
    "0:16:eblk;#1;2:12:slet;6:7:pvar;6:7:ident;@78;?0;10:11:elit;%int;@31;?1;13:14:evar;13:14:qname;?0;13:14:ident;@78;#0;",
  );
  assert_eq(dump_expr_of(b"{ 1; }"), "0:6:eblk;#1;2:3:sexp;2:3:elit;%int;@31;?0;#0;");
}

test "`let ... else` is its own statement, its `else` block after the initializer" {
  assert_eq(
    dump_expr_of(b"{ let Some(x) = o else { 0 }; x }"),
    "0:33:eblk;#1;2:29:slete;6:13:pctr;6:10:qname;?0;6:10:ident;@536f6d65;#1;11:12:pvar;11:12:ident;@78;?0;16:17:evar;16:17:qname;?0;16:17:ident;@6f;23:28:eblk;#0;?1;25:26:elit;%int;@30;?1;30:31:evar;30:31:qname;?0;30:31:ident;@78;#0;",
  );
  // The initializer's own `else` is taken first, so this one is the statement's.
  assert_eq(
    dump_expr_of(b"{ let 1 = if a { 1 } else { 2 } else { 3 }; 4 }"),
    "0:47:eblk;#1;2:43:slete;6:7:plit;%int;@31;?0;10:31:eif;13:14:evar;13:14:qname;?0;13:14:ident;@61;15:20:eblk;#0;?1;17:18:elit;%int;@31;26:31:eblk;#0;?1;28:29:elit;%int;@32;37:42:eblk;#0;?1;39:40:elit;%int;@33;?1;44:45:elit;%int;@34;#0;",
  )
}

test "the `else` of a `let ... else` is a block" {
  assert_eq(dump_expr_of(b"{ let Some(x) = o else 0; x }"), "#1;!E0001:23:24:1:0;=23:24:1;")
}

test "a block-like statement needs no semicolon and anything else does" {
  assert_eq(
    dump_expr_of(b"{ if a { 1 } 2 }"),
    "0:16:eblk;#1;2:12:sexp;2:12:eif;5:6:evar;5:6:qname;?0;5:6:ident;@61;7:12:eblk;#0;?1;9:10:elit;%int;@31;12:12:elit;%unit;?1;13:14:elit;%int;@32;#0;",
  );
  assert_eq(dump_expr_of(b"{ 1 2 }"), "#1;!E0001:4:5:1:0;=4:5:1;");
}

test "a lambda takes typed or untyped parameters, and `||` takes none" {
  assert_eq(
    dump_expr_of(b"|x| x"),
    "0:5:elam;#1;1:2:prm;1:2:ident;@78;?0;?0;?0;4:5:evar;4:5:qname;?0;4:5:ident;@78;#0;",
  );
  assert_eq(dump_expr_of(b"|| 1"), "0:4:elam;#0;?0;3:4:elit;%int;@31;#0;");
  assert_eq(
    dump_expr_of(b"|x: Int| x"),
    "0:10:elam;#1;1:7:prm;1:2:ident;@78;?1;4:7:tcon;4:7:qname;?0;4:7:ident;@496e74;#0;?0;?0;9:10:evar;9:10:qname;?0;9:10:ident;@78;#0;",
  );
}

test "a match arm takes a guard and needs a comma unless its body is block-like" {
  assert_eq(
    dump_expr_of(b"match x { 1 -> 2, _ -> 3 }"),
    "0:26:emat;6:7:evar;6:7:qname;?0;6:7:ident;@78;#2;10:16:arm;10:11:plit;%int;@31;?0;15:16:elit;%int;@32;18:24:arm;18:19:pwld;?0;23:24:elit;%int;@33;#0;",
  );
  assert_eq(
    dump_expr_of(b"match x { y if y -> 1 }"),
    "0:23:emat;6:7:evar;6:7:qname;?0;6:7:ident;@78;#1;10:21:arm;10:11:pvar;10:11:ident;@79;?1;15:16:evar;15:16:qname;?0;15:16:ident;@79;20:21:elit;%int;@31;#0;",
  );
  assert_eq(dump_expr_of(b"match x { 1 -> 2 _ -> 3 }"), "#1;!E0001:17:18:1:0;=17:18:1;");
}

test "a handler takes clauses, a resume binder and at most one `return`" {
  assert_eq(
    dump_expr_of(b"handle f() with { e.op(a) resume k -> k(a), return v -> v }"),
    "0:59:ehnd;7:10:eapp;7:8:evar;7:8:qname;?0;7:8:ident;@66;#0;#0;#0;#1;18:42:hcl;18:19:qname;?0;18:19:ident;@65;20:22:ident;@6f70;?0;?0;#1;23:24:ident;@61;?1;33:34:ident;@6b;38:42:eapp;38:39:evar;38:39:qname;?0;38:39:ident;@6b;#1;40:41:evar;40:41:qname;?0;40:41:ident;@61;#0;#0;?1;44:57:rcl;51:52:ident;@76;56:57:evar;56:57:qname;?0;56:57:ident;@76;#0;",
  );
  // `[*t]` is `[*]` with the label bound: the clause still names no resource, and it reads one.
  assert_eq(
    dump_expr_of(b"handle f() with { e.op[*t](a) -> t }"),
    "0:36:ehnd;7:10:eapp;7:8:evar;7:8:qname;?0;7:8:ident;@66;#0;#0;#0;#1;18:34:hcl;18:19:qname;?0;18:19:ident;@65;20:22:ident;@6f70;?0;?1;24:25:ident;@74;#1;27:28:ident;@61;?0;33:34:evar;33:34:qname;?0;33:34:ident;@74;?0;#0;",
  );
  assert_eq(
    dump_expr_of(b"handle f() with { e.op[a](x) -> x }"),
    "0:35:ehnd;7:10:eapp;7:8:evar;7:8:qname;?0;7:8:ident;@66;#0;#0;#0;#1;18:33:hcl;18:19:qname;?0;18:19:ident;@65;20:22:ident;@6f70;?1;23:24:ident;@61;?0;#1;26:27:ident;@78;?0;32:33:evar;32:33:qname;?0;32:33:ident;@78;?0;#0;",
  );
  let two = dump_expr_of(b"handle f() with { return a -> a, return b -> b }");
  assert(two.contains("!E0001:33:46:2:0;=33:46:1;=18:31:0;"));
}

test "a handler's `var`s come before its clauses" {
  assert(!dump_expr_of(b"handle f() with { var s = 0, e.op(a) -> () }").contains("!E0"));
  assert(dump_expr_of(b"handle f() with { e.op(a) -> (), var s = 0 }").contains("!E0001:"))
}

test "`simulate` is contextual" {
  assert_eq(dump_expr_of(b"simulate { 1 }"), "0:14:esim;9:14:eblk;#0;?1;11:12:elit;%int;@31;#0;");
  // It is an ordinary name wherever the shape does not hold.
  assert_eq(dump_expr_of(b"simulate"), "0:8:evar;0:8:qname;?0;0:8:ident;@73696d756c617465;#0;")
}

test "`with_hold` is contextual: a region, what it acquires, what releases that, and a body" {
  let dump = dump_expr_of(b"with_hold[f](a, r) { h -> h }");
  assert(dump.starts_with("0:29:ehld;10:11:ident;@66;13:14:evar;"));
  assert_eq(
    dump_expr_of(b"with_hold[f](a, r,) { h -> h }"),
    dump_expr_of(b"with_hold[f](a, r ) { h -> h }"),
  );
  assert_eq(dump_expr_of(b"with_hold"), "0:9:evar;0:9:qname;?0;0:9:ident;@776974685f686f6c64;#0;");
  assert(dump_expr_of(b"with_hold[f](a) { h -> h }").contains("!E0001:"))
}

test "in a scrutinee a `{` is the arm block, so `simulate` is a name there" {
  assert_eq(
    dump_expr_of(b"if simulate { 1 }"),
    "0:17:eif;3:11:evar;3:11:qname;?0;3:11:ident;@73696d756c617465;12:17:eblk;#0;?1;14:15:elit;%int;@31;17:17:elit;%unit;#0;",
  );
}

test "an argument list clears no_brace so a record may be written inside one" {
  assert_eq(
    dump_expr_of(b"if f({a: 1}) { 2 }"),
    "0:18:eif;3:12:eapp;3:4:evar;3:4:qname;?0;3:4:ident;@66;#1;5:11:erec;#1;6:7:ident;@61;9:10:elit;%int;@31;#0;#0;13:18:eblk;#0;?1;15:16:elit;%int;@32;18:18:elit;%unit;#0;",
  );
}

test "a list expression, an empty one, and a qualified name" {
  assert_eq(dump_expr_of(b"[1, 2]"), "0:6:elst;#2;1:2:elit;%int;@31;4:5:elit;%int;@32;#0;");
  assert_eq(dump_expr_of(b"[]"), "0:2:elst;#0;#0;");
  assert_eq(
    dump_expr_of(b"m::f(1)"),
    "0:7:eapp;0:4:evar;0:4:qname;?1;0:1:ident;@6d;3:4:ident;@66;#1;5:6:elit;%int;@31;#0;#0;#0;",
  );
}

test "a parenthesized expression takes the parentheses into its span" {
  assert_eq(dump_expr_of(b"(1 + 2)"), "0:7:ebin;%add;1:2:elit;%int;@31;5:6:elit;%int;@32;#0;");
}

test "an unclosed group reports against the opener as a secondary label" {
  assert_eq(dump_expr_of(b"(1"), "#1;!E0001:2:2:2:0;=2:2:1;=0:1:0;");
}

test "one offset raises one diagnostic, which is `Parser::push`'s dedup rule" {
  let s = start(b"*");
  let r = expr(s.input, s.parser);
  assert(failed(r));
  assert_eq(parsed_or(r, no_expr()).parser.diags.len(), 1);
}

test "the node count walks every node of a small tree" {
  assert_eq(parse_count(b"1 + 2 * 3"), 5);
  assert_eq(parse_count(b"{ let x = 1; [x, x] }"), 6);
}

test "past MAX_DEPTH the parser reports rather than overflowing" {
  let n = 200;
  let deep = Bytes::concat_all(range(0, n).map(|i: Int| b"(")).concat(
    b"1".concat(Bytes::concat_all(range(0, n).map(|i: Int| b")"))),
  );
  let s = start(deep);
  let r = expr(s.input, s.parser);
  assert(failed(r));
  assert_eq(parsed_or(r, no_expr()).parser.diags.len(), 1);
}

test "just under MAX_DEPTH it does not" {
  let n = 60;
  let deep = Bytes::concat_all(range(0, n).map(|i: Int| b"(")).concat(
    b"1".concat(Bytes::concat_all(range(0, n).map(|i: Int| b")"))),
  );
  let s = start(deep);
  let r = expr(s.input, s.parser);
  assert(!failed(r));
  assert_eq(parsed_or(r, no_expr()).parser.diags.len(), 0);
}

test "`parallel` is contextual, takes two or more branches, and nests" {
  assert_eq(
    dump_expr_of(b"parallel { 1, f() }"),
    "0:19:epar;#2;11:12:elit;%int;@31;14:17:eapp;14:15:evar;14:15:qname;?0;14:15:ident;@66;#0;#0;#0;#0;",
  );
  assert(dump_expr_of(b"parallel { 1, parallel { 2, 3 }, }").contains("14:31:epar;#2;"));
  assert_eq(dump_expr_of(b"parallel"), "0:8:evar;0:8:qname;?0;0:8:ident;@706172616c6c656c;#0;");
  assert(dump_expr_of(b"if parallel { 1 }").contains("3:11:evar;"));
  assert(dump_expr_of(b"parallel { 1 }").contains("!E0001:"))
}

test "`try` opens a block wherever a `{` follows it, and names a raise in brackets" {
  assert(dump_expr_of(b"try { 1 }").contains("0:9:etrb;?0;"));
  assert(dump_expr_of(b"try[m::p.bad] { 1 }").contains("0:19:etrb;?1;"));
  // A scrutinee may be one: no name is followed by a block there.
  assert(dump_expr_of(b"match try { 1 } { _ -> 2 }").contains("6:15:etrb;?0;"));
  // A name wherever neither shape holds: alone, and before a label.
  assert_eq(dump_expr_of(b"try"), "0:3:evar;0:3:qname;?0;0:3:ident;@747279;#0;");
  assert(dump_expr_of(b"try[conn](1)").contains("0:3:evar;"));
  assert(dump_expr_of(b"try[p.bad] 1").contains("!E0001:"))
}
