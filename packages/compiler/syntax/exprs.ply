                                starts_upper, comma_list, token_lparen, token_rparen, token_lbrace,
                                token_rbrace, token_lbracket, token_rbracket, token_comma,
                                token_semi, token_colon, token_coloncolon, token_dot, token_dotdot,
                                token_arrow, token_eq, token_pipe, token_pipepipe, token_question,
                                token_star, keyword_let, keyword_if, keyword_else, keyword_with,
                                dump_node, dump_count, dump_presence, dump_word, dump_list,
                                dump_opt, dump_ident, dump_qname, dump_diags, with_no_pipe,
                                advance_n, token_at, token_gt, token_lt, max_depth, span_bin,
                                span_between, minted, made_at, role_member_default, role_detached,
                                role_simulated, role_try_return, role_try_clause, role_try_ok,
                                role_try_err, role_try_carried, role_tag_parser, role_tag_filler,
                                role_tag_parse, role_tag_fill, role_tag_texts, role_tag_holes,
                                role_case_block, role_case_table_let, role_case_table_binder,
                                role_case_call, role_case_callee, role_case_table_read,
                                role_case_label_lambda, role_case_label_param, role_case_let,
                                role_case_binder, role_case_at_read, role_case_identity_read)
