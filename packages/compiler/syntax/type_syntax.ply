import compiler.syntax.parsing (tuple_field_name, Span, Identifier, QName, Input, Parser,
                                ParseOutput, EatResult, PartialList, ParseDiagnostic, span_bin,
                                identifier_bin, q_name_bin, span_to, dummy_span, no_identifier,
                                no_qualified_name, unexpected, error_at, push_diagnostic,
                                error_here, unclosed, token_kind, token_kind_at, current_span,
                                span_at, previous_span, at_token, at_eof, at_identifier_text,
                                starts_upper, advance, bump, eat, expect, expect_close,
                                expect_identifier, expect_field_name, report_duplicate_fields,
                                expect_gt, with_no_brace, too_deep, qualified_name, comma_list,
                                parsed_or, failed, token_lparen, token_rparen, token_lbrace,
                                token_rbrace, token_lbracket, token_rbracket, token_comma,
                                token_colon, token_dot, token_arrow, token_lt, token_gt, token_ge,
                                token_pipe, token_slash, token_star, dump_node, dump_count,
                                dump_presence, dump_payload, dump_word, dump_list, dump_opt,
                                dump_identifier, dump_qualified_name, dump_diagnostics, start,
                                is_bare)
import compiler.syntax.lexer (TokenKind, Identifier, Punctuation)
import std.bytes
import std.bin

pub type TypeExpression =
  | VariableTypeExpression(Identifier)
  | NamedTypeExpression({ span: Span, name: QName, args: List<TypeExpression>, labels: List<Identifier>, effect_arguments: List<EffectsExpression> })
  | FunctionTypeExpression({ span: Span, params: List<TypeExpression>, keep_indices: List<Int>, once: Bool, return_type: TypeExpression, effects: Option<EffectsExpression> })
  | RecordTypeExpression({ span: Span, fields: List<{ name: Identifier, ty: TypeExpression }> })
  | UnitTypeExpression({ span: Span })
  | InvalidTypeExpression({ span: Span })

pub type Mode = | ReadMode | WriteMode | InvalidMode | RaiseMode

derive bin for Mode
derive bin for EffectExpression
derive bin for EffectsExpression
derive bin for TypeExpression

pub type EffectExpression = {
  effect_name: QName,
  mode: Mode,
  operation: Option<Identifier>,
  resource: Option<Identifier>,
  resource_wildcard: Bool,
  bounded: Bool,
  span: Span,
}

pub type EffectsExpression = {
  listed: List<EffectExpression>,
  aliases: List<QName>,
  variable: Option<Identifier>,
  variable_bounded: Bool,
  span: Span,
}

pub type EffectsMember = | EffectMember(EffectExpression) | EffectSetMember(QName)

pub type Generics = {
  types: List<Identifier>,
  effects: List<Identifier>,
  labels: List<Identifier>,
  retained_types: List<Identifier>,
}

pub fn type_span(ty: TypeExpression) -> Span =
  match ty {
    VariableTypeExpression(i) -> i.span,
    NamedTypeExpression(x) -> x.span,
    FunctionTypeExpression(x) -> x.span,
    RecordTypeExpression(x) -> x.span,
    UnitTypeExpression(x) -> x.span,
    InvalidTypeExpression(x) -> x.span,
  }

pub fn no_type() -> TypeExpression = InvalidTypeExpression({ span: dummy_span() })

pub fn no_effects_expression() -> EffectsExpression =
  { listed: [], aliases: [], variable: None, variable_bounded: false, span: dummy_span() }

pub fn no_effect_expression() -> EffectExpression =
  {
    effect_name: no_qualified_name(),
    mode: InvalidMode,
    operation: None,
    resource: None,
    resource_wildcard: false,
    bounded: false,
    span: dummy_span(),
  }

pub fn no_generics() -> Generics = { types: [], effects: [], labels: [], retained_types: [] }

pub fn is_generic(generics: Generics) -> Bool =
  generics.types.len() > 0 || generics.effects.len() > 0 || generics.labels.len() > 0

pub fn angled(types: List<Bytes>, labels: List<Bytes>, rows: List<Bytes>) -> Bytes =
  if types.len() == 0 && labels.len() == 0 && rows.len() == 0 { b"" } else {
    let ts = Bytes::join(
      labels.fold(types, |accumulator: List<Bytes>, label: Bytes|
        accumulator.push(Bytes::concat_all([b"[", label, b"]"]))),
      b", ",
    );
    let rs = Bytes::join(rows, b", ");
    if rows.len() == 0 { Bytes::concat_all([b"<", ts, b">"]) }
    else if ts.len() == 0 { Bytes::concat_all([b"<| ", rs, b">"]) }
    else { Bytes::concat_all([b"<", ts, b" | ", rs, b">"]) }
  }

pub fn generics_text(generics: Generics) -> Bytes =
  angled(
    prefix_marked(generics.types, generics.retained_types, b"keep "),
    identifier_names(generics.labels),
    identifier_names(generics.effects),
  )

fn prefix_marked(
  idents: List<Identifier>,
  prefix_marked: List<Identifier>,
  word: Bytes,
) -> List<Bytes> = {
  let names = identifier_names(prefix_marked);
  idents.map(|identifier: Identifier|
    if names.contains(identifier.name) { word.concat(identifier.name) } else { identifier.name })
}

pub fn identifier_names(idents: List<Identifier>) -> List<Bytes> =
  idents.map(|identifier: Identifier| identifier.name)

pub fn mode(input: Input, parser: Parser) -> Result<ParseOutput<Mode>, Parser> / {abort.raise} =
  if at_identifier_text(input, parser, b"read") {
    Ok({ parser: bump(input, parser), node: ReadMode })
  } else if at_identifier_text(input, parser, b"write") {
    Ok({ parser: bump(input, parser), node: WriteMode })
  } else { Err(error_here(input, parser, b"`read`, `write` or `raise` to start an operation")) }

pub fn is_raise(mode: Mode) -> Bool = match mode { RaiseMode -> true, _ -> false }

pub fn ty(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<TypeExpression>, Parser> / {abort.raise} =
  match type_inner(input, with_no_brace(parser, false)) {
    Err(q) -> Err(with_no_brace(q, parser.no_brace)),
    Ok(r) -> Ok({ parser: with_no_brace(r.parser, parser.no_brace), node: r.node }),
  }

fn type_inner(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<TypeExpression>, Parser> / {abort.raise} =
  if input.room <= 0 { Err(too_deep(input, parser)) }
  else { type_body({ ..input, room: input.room - 1 }, parser) }

fn type_body(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<TypeExpression>, Parser> / {abort.raise} = {
  let st = current_span(input, parser);
  match token_kind(input, parser) {
    Punctuation(s) -> if s == b"lparen" { type_paren(input, parser, st) }
    else if s == b"lbrace" { type_record(input, parser) }
    else { Err(error_here(input, parser, b"a type")) },
    Identifier(n) -> if n == b"once" && token_kind_at(input, parser, 1) == token_lparen() {
      type_once(input, parser, st)
    } else { type_named(input, parser, st) },
    _ -> Err(error_here(input, parser, b"a type")),
  }
}

fn type_once(
  input: Input,
  parser: Parser,
  span: Span,
) -> Result<ParseOutput<TypeExpression>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  let { parser, node: t } = type_paren(input, o.parser, span)?;
  match t {
    FunctionTypeExpression(f) ->
      Ok({ parser: parser, node: FunctionTypeExpression({ ..f, once: true }) }),
    _ -> Err(expected_at(parser, type_span(t), b"a function type after `once`")),
  }
}

fn expected_at(parser: Parser, span: Span, what: Bytes) -> Parser =
  push_diagnostic(
    parser,
    error_at(unexpected(), span, b"expected ".concat(what), b"expected ".concat(what), []),
  )

fn paren_item(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<{ keep: Bool, ty: TypeExpression }>, Parser> / {abort.raise} = {
  let keep = at_identifier_text(input, parser, b"keep") && starts_type(input, parser, 1);
  let from = if keep { advance(input, parser).parser } else { parser };
  let { parser, node: t } = ty(input, from)?;
  Ok({ parser: parser, node: { keep: keep, ty: t } })
}

pub fn starts_type(input: Input, parser: Parser, ahead: Int) -> Bool =
  match token_kind_at(input, parser, ahead) {
    Identifier(_) -> true,
    Punctuation(s) -> s == b"lparen" || s == b"lbrace",
    _ -> false,
  }

fn type_paren(
  input: Input,
  parser: Parser,
  span: Span,
) -> Result<ParseOutput<TypeExpression>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  if at_token(input, o.parser, token_rparen()) {
    let closing_paren = advance(input, o.parser);
    let ar = eat(input, closing_paren.parser, token_arrow());
    if ar.ok { function_type(input, ar.parser, [], [], span) } else {
      Ok({
        parser: ar.parser,
        node: UnitTypeExpression({ span: span_to(o.node, closing_paren.node) }),
      })
    }
  } else {
    let items = comma_list(input, o.parser, token_rparen(), paren_item)?;
    let ps = {
      parser: items.parser,
      node: items.node.map(|i: { keep: Bool, ty: TypeExpression }| i.ty),
    };
    let keep_indices = range(0, items.node.len()).filter(|i: Int| items.node.get(i).keep);
    let closing_paren = expect_close(input, ps.parser, token_rparen(), o.node, b"`)`")?;
    let ar = eat(input, closing_paren.parser, token_arrow());
    if ar.ok { function_type(input, ar.parser, ps.node, keep_indices, span) }
    else if keep_indices.len() > 0 {
      Err(
        expected_at(
          ar.parser,
          type_span(ps.node.get(keep_indices.get(0))),
          b"`->` cannot follow a list containing `keep` items; only the parameters of a function type can be marked `keep`",
        ),
      )
    } else {
      match ps.node {
        [only] -> Ok({ parser: ar.parser, node: only }),
        items ->
          Ok({
            parser: ar.parser,
            node: RecordTypeExpression({
              span: span_to(o.node, closing_paren.node),
              fields: range(0, items.len()).map(
                |i: Int| -> { name: Identifier, ty: TypeExpression } {
                  match items.at(i) {
                    Some(t) -> { name: tuple_field_name(i, type_span(t)), ty: t },
                    None ->
                      {
                        name: tuple_field_name(i, o.node),
                        ty: UnitTypeExpression({ span: o.node }),
                      },
                  }
                },
              ),
            }),
          }),
      }
    }
  }
}

fn type_record(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<TypeExpression>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  let { parser, node: fs } = comma_list(input, o.parser, token_rbrace(), type_field)?;
  let { parser, node: closing_brace } = expect_close(
    input,
    parser,
    token_rbrace(),
    o.node,
    b"`}`",
  )?;
  Ok({
    parser: report_duplicate_fields(
      parser,
      fs.map(|f: { name: Identifier, ty: TypeExpression }| f.name),
    ),
    node: RecordTypeExpression({ span: span_to(o.node, closing_brace), fields: fs }),
  })
}

fn type_named(
  input: Input,
  parser: Parser,
  span: Span,
) -> Result<ParseOutput<TypeExpression>, Parser> / {abort.raise} = {
  let q = qualified_name(input, parser, b"a type")?;
  if at_token(input, q.parser, token_lt()) {
    let o = advance(input, q.parser);
    let { parser, node: args } = type_args(input, o.parser)?;
    let pi = eat(input, parser, token_pipe());
    let parsed_effects = if pi.ok { effects_arguments(input, pi.parser) }
    else { Ok({ parser: pi.parser, node: [] }) };
    let { parser, node: rows } = parsed_effects?;
    let closing_angle = expect_gt(input, parser, b"`>` to close the type arguments")?;
    Ok({
      parser: closing_angle.parser,
      node: NamedTypeExpression({
        span: span_to(span, closing_angle.node),
        name: q.node,
        args: args.types,
        labels: args.labels,
        effect_arguments: rows,
      }),
    })
  } else if is_bare(q.node) && !starts_upper(q.node.name.name) {
    Ok({ parser: q.parser, node: VariableTypeExpression(q.node.name) })
  } else { Ok({ parser: q.parser, node: nullary(q.node) }) }
}

pub fn nullary(name: QName) -> TypeExpression =
  NamedTypeExpression({ span: name.span, name: name, args: [], labels: [], effect_arguments: [] })

type ArgAccumulator = { parser: Parser, types: List<TypeExpression>, labels: List<Identifier> }

type ArgOut = { types: List<TypeExpression>, labels: List<Identifier> }

fn type_args(input: Input, parser: Parser) -> Result<ParseOutput<ArgOut>, Parser> / {abort.raise} =
  iterate(
    { parser: parser, types: [], labels: [] },
    input.token_count - parser.position + 1,
    |s: ArgAccumulator|
      if at_token(input, s.parser, token_gt()) || at_token(input, s.parser, token_ge())
          || at_token(input, s.parser, token_pipe())
          || at_eof(input, s.parser) {
        Stop(Ok({ parser: s.parser, node: { types: s.types, labels: s.labels } }))
      } else if at_token(input, s.parser, token_lbracket()) {
        match label_params(input, s.parser) {
          Err(q) -> Stop(Err(q)),
          Ok(n) -> {
            let e = eat(input, n.parser, token_comma());
            let ls = n.node.fold(
              s.labels,
              |accumulator: List<Identifier>, identifier: Identifier| accumulator.push(identifier),
            );
            if e.ok { Continue({ parser: e.parser, types: s.types, labels: ls }) }
            else { Stop(Ok({ parser: e.parser, node: { types: s.types, labels: ls } })) }
          },
        }
      } else {
        match ty(input, s.parser) {
          Err(q) -> Stop(Err(q)),
          Ok(t) -> {
            let e = eat(input, t.parser, token_comma());
            if e.ok {
              Continue({ parser: e.parser, types: s.types.push(t.node), labels: s.labels })
            } else {
              Stop(
                Ok({ parser: e.parser, node: { types: s.types.push(t.node), labels: s.labels } }),
              )
            }
          },
        }
      },
  )

type EffectsListAccumulator = { parser: Parser, out: List<EffectsExpression> }

fn effects_arguments(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<List<EffectsExpression>>, Parser> / {abort.raise} =
  iterate(
    { parser: parser, out: [] },
    input.token_count - parser.position + 1,
    |s: EffectsListAccumulator|
      if at_token(input, s.parser, token_gt()) || at_token(input, s.parser, token_ge())
          || at_eof(input, s.parser) { Stop(Ok({ parser: s.parser, node: s.out })) } else {
        match effects(input, s.parser) {
          Err(q) -> Stop(Err(q)),
          Ok(r) -> {
            let e = eat(input, r.parser, token_comma());
            if e.ok { Continue({ parser: e.parser, out: s.out.push(r.node) }) }
            else { Stop(Ok({ parser: e.parser, node: s.out.push(r.node) })) }
          },
        }
      },
  )

fn function_type(
  input: Input,
  parser: Parser,
  params: List<TypeExpression>,
  keep_indices: List<Int>,
  span: Span,
) -> Result<ParseOutput<TypeExpression>, Parser> / {abort.raise} = {
  let { parser, node: r } = ty(input, parser)?;
  let sl = eat(input, parser, token_slash());
  if !sl.ok {
    Ok({
      parser: sl.parser,
      node: FunctionTypeExpression({
        span: span_to(span, type_span(r)),
        params: params,
        keep_indices: keep_indices,
        once: false,
        return_type: r,
        effects: None,
      }),
    })
  } else {
    let { parser, node: e } = effects(input, sl.parser)?;
    Ok({
      parser: parser,
      node: FunctionTypeExpression({
        span: span_to(span, e.span),
        params: params,
        keep_indices: keep_indices,
        once: false,
        return_type: r,
        effects: Some(e),
      }),
    })
  }
}

fn type_field(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<{ name: Identifier, ty: TypeExpression }>, Parser> / {abort.raise} = {
  let { parser, node: f } = expect_field_name(input, parser, b"a field name")?;
  let n = f.name;
  let { parser, .. } = expect(input, parser, token_colon(), b"`:` after the field name")?;
  let { parser, node: t } = ty(input, parser)?;
  Ok({ parser: parser, node: { name: n, ty: t } })
}

type EffectsAccumulator = { parser: Parser, aliases: List<QName>, listed: List<EffectExpression> }

type EffectsOut = { aliases: List<QName>, listed: List<EffectExpression> }

pub fn effects(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<EffectsExpression>, Parser> / {abort.raise} = {
  let st = current_span(input, parser);
  if at_token(input, parser, token_lbrace()) { effects_braced(input, parser, st) } else {
    let { parser, node: t } = expect_identifier(
      input,
      parser,
      b"effects: `{..}` or an effect variable",
    )?;
    let b = bounded_word(input, parser);
    let span = if b.node { span_to(t.span, previous_span(input, b.parser)) } else { t.span };
    Ok({
      parser: b.parser,
      node: { listed: [], aliases: [], variable: Some(t), variable_bounded: b.node, span: span },
    })
  }
}

fn effects_braced(
  input: Input,
  parser: Parser,
  span: Span,
) -> Result<ParseOutput<EffectsExpression>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  let { parser, node: ms } = effects_members(input, o.parser, o.node)?;
  let pi = eat(input, parser, token_pipe());
  let parsed_variable = if pi.ok {
    expect_identifier(input, pi.parser, b"an effect variable after `|`")
  } else { Ok({ parser: pi.parser, node: no_identifier() }) };
  let { parser, node: effect_variable } = parsed_variable?;
  let b = if pi.ok { bounded_word(input, parser) } else { { parser: parser, node: false } };
  let { parser, node: close_span } = expect_close(
    input,
    b.parser,
    token_rbrace(),
    o.node,
    b"`}` to close the effects",
  )?;
  Ok({
    parser: parser,
    node: {
      listed: ms.listed,
      aliases: ms.aliases,
      variable: if pi.ok { Some(effect_variable) } else { None },
      variable_bounded: b.node,
      span: span_to(span, close_span),
    },
  })
}

fn bounded_word(input: Input, parser: Parser) -> ParseOutput<Bool> =
  if at_identifier_text(input, parser, b"bounded") {
    { parser: advance(input, parser).parser, node: true }
  } else { { parser: parser, node: false } }

fn effects_members(
  input: Input,
  parser: Parser,
  open: Span,
) -> Result<ParseOutput<EffectsOut>, Parser> / {abort.raise} =
  iterate(
    { parser: parser, aliases: [], listed: [] },
    input.token_count - parser.position + 1,
    |s: EffectsAccumulator|
      if at_token(input, s.parser, token_rbrace()) || at_token(input, s.parser, token_pipe()) {
        Stop(Ok({ parser: s.parser, node: { aliases: s.aliases, listed: s.listed } }))
      } else if at_eof(input, s.parser) {
        Stop(Err(unclosed(input, s.parser, open, b"`}` to close the effects")))
      } else {
        match effects_member(input, s.parser) {
          Err(q) -> Stop(Err(q)),
          Ok(m) -> {
            let e = eat(input, m.parser, token_comma());
            match m.node {
              EffectMember(a) -> if e.ok {
                Continue({ parser: e.parser, aliases: s.aliases, listed: s.listed.push(a) })
              } else {
                Stop(
                  Ok({ parser: e.parser, node: { aliases: s.aliases, listed: s.listed.push(a) } }),
                )
              },
              EffectSetMember(q) -> if e.ok {
                Continue({ parser: e.parser, listed: s.listed, aliases: s.aliases.push(q) })
              } else {
                Stop(
                  Ok({ parser: e.parser, node: { listed: s.listed, aliases: s.aliases.push(q) } }),
                )
              },
            }
          },
        }
      },
  )

pub fn effects_member(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<EffectsMember>, Parser> / {abort.raise} = {
  let { parser, node: q } = qualified_name(
    input,
    parser,
    b"an effect, or the name of an `effect set`",
  )?;
  if !at_token(input, parser, token_dot()) { Ok({ parser: parser, node: EffectSetMember(q) }) }
  else {
    let { parser, node: a } = effect_rest(input, bump(input, parser), q)?;
    Ok({ parser: parser, node: EffectMember(a) })
  }
}

pub fn effect_rest(
  input: Input,
  parser: Parser,
  qualified_name: QName,
) -> Result<ParseOutput<EffectExpression>, Parser> / {abort.raise} = {
  let { parser, node: a } = effect_access(input, parser)?;
  let { parser, node: r } = effect_resource(input, parser)?;
  let span = span_to(qualified_name.span, previous_span(input, parser));
  let b = bounded_word(input, parser);
  Ok({
    parser: b.parser,
    node: {
      effect_name: qualified_name,
      mode: a.mode,
      operation: a.operation,
      resource: r.name,
      resource_wildcard: r.resource_wildcard,
      bounded: b.node,
      span: span,
    },
  })
}

type Access = { mode: Mode, operation: Option<Identifier> }

fn effect_access(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Access>, Parser> / {abort.raise} =
  match token_kind(input, parser) {
    Identifier(name) -> if name != b"read" && name != b"write" {
      let a = advance(input, parser);
      Ok({
        parser: a.parser,
        node: { mode: WriteMode, operation: Some({ name: name, span: a.node }) },
      })
    } else { mode_access(input, parser) },
    _ -> mode_access(input, parser),
  }

fn mode_access(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Access>, Parser> / {abort.raise} =
  match mode(input, parser) {
    Err(q) -> Err(q),
    Ok(m) -> Ok({ parser: m.parser, node: { mode: m.node, operation: None } }),
  }

type EffectResource = { resource_wildcard: Bool, name: Option<Identifier> }

fn effect_resource(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<EffectResource>, Parser> / {abort.raise} =
  if !at_token(input, parser, token_lbracket()) {
    Ok({ parser: parser, node: { resource_wildcard: false, name: None } })
  } else {
    let o = advance(input, parser);
    if at_token(input, o.parser, token_star()) {
      let st = advance(input, o.parser);
      let { parser, .. } = expect_close(input, st.parser, token_rbracket(), o.node, b"`]`")?;
      Ok({ parser: parser, node: { resource_wildcard: true, name: None } })
    } else {
      let { parser, node: n } = expect_identifier(
        input,
        o.parser,
        b"a resource name or `*` inside `[..]`",
      )?;
      let { parser, .. } = expect_close(input, parser, token_rbracket(), o.node, b"`]`")?;
      Ok({ parser: parser, node: { resource_wildcard: false, name: Some(n) } })
    }
  }

type PartialGenericParams = {
  parser: Parser,
  types: List<Identifier>,
  labels: List<Identifier>,
  retained: List<Identifier>,
}

type GenericParams = {
  types: List<Identifier>,
  labels: List<Identifier>,
  retained: List<Identifier>,
}

type EffectParamsAccumulator = { parser: Parser, names: List<Identifier> }

pub fn generics(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Generics>, Parser> / {abort.raise} = {
  let { parser, .. } = expect(input, parser, token_lt(), b"`<`")?;
  let { parser, node: ts } = generic_params(input, parser)?;
  let pi = eat(input, parser, token_pipe());
  let opt_es = if pi.ok { effect_params(input, pi.parser) }
  else { Ok({ parser: pi.parser, node: [] }) };
  let { parser, node: es } = opt_es?;
  let { parser, .. } = expect_gt(input, parser, b"`>` to close the type parameter list")?;
  Ok({
    parser: parser,
    node: { types: ts.types, effects: es, labels: ts.labels, retained_types: ts.retained },
  })
}

fn parse_marker(input: Input, parser: Parser, word: Bytes) -> ParseOutput<Bool> =
  if at_identifier_text(input, parser, word)
      && (match token_kind_at(input, parser, 1) { Identifier(_) -> true, _ -> false }) {
    { parser: advance(input, parser).parser, node: true }
  } else { { parser: parser, node: false } }

fn generic_params(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<GenericParams>, Parser> / {abort.raise} =
  iterate(
    { parser: parser, types: [], labels: [], retained: [] },
    input.token_count - parser.position + 1,
    |s: PartialGenericParams|
      if at_token(input, s.parser, token_gt()) || at_token(input, s.parser, token_ge())
          || at_token(input, s.parser, token_pipe()) {
        Stop(
          Ok({
            parser: s.parser,
            node: { types: s.types, labels: s.labels, retained: s.retained },
          }),
        )
      } else if at_eof(input, s.parser) {
        Stop(Err(error_here(input, s.parser, b"`>` to close the type parameter list")))
      } else if at_token(input, s.parser, token_lbracket()) {
        match label_params(input, s.parser) {
          Err(q) -> Stop(Err(q)),
          Ok(n) -> {
            let e = eat(input, n.parser, token_comma());
            let ls = n.node.fold(
              s.labels,
              |accumulator: List<Identifier>, identifier: Identifier| accumulator.push(identifier),
            );
            let next = { ..s, parser: e.parser, labels: ls };
            if e.ok { Continue(next) } else {
              Stop(
                Ok({
                  parser: e.parser,
                  node: { types: s.types, labels: ls, retained: s.retained },
                }),
              )
            }
          },
        }
      } else {
        let k = parse_marker(input, s.parser, b"keep");
        match expect_identifier(input, k.parser, b"a type parameter name, or `[l]` for a label") {
          Err(q) -> Stop(Err(q)),
          Ok(n) -> {
            let e = eat(input, n.parser, token_comma());
            let retained = if k.node { s.retained.push(n.node) } else { s.retained };
            let types = s.types.push(n.node);
            if e.ok {
              Continue({ parser: e.parser, types: types, labels: s.labels, retained: retained })
            } else {
              Stop(
                Ok({
                  parser: e.parser,
                  node: { types: types, labels: s.labels, retained: retained },
                }),
              )
            }
          },
        }
      },
  )

fn label_params(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<List<Identifier>>, Parser> / {abort.raise} = {
  let o = advance(input, parser);
  let { parser, node: ns } = comma_list(input, o.parser, token_rbracket(), label_name)?;
  let { parser, .. } = expect_close(input, parser, token_rbracket(), o.node, b"`]`")?;
  Ok({ parser: parser, node: ns })
}

pub fn label_name(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<Identifier>, Parser> / {abort.raise} =
  expect_identifier(input, parser, b"a label name inside `[..]`")

fn effect_params(
  input: Input,
  parser: Parser,
) -> Result<ParseOutput<List<Identifier>>, Parser> / {abort.raise} =
  iterate(
    { parser: parser, names: [] },
    input.token_count - parser.position + 1,
    |s: EffectParamsAccumulator|
      if at_token(input, s.parser, token_gt()) || at_token(input, s.parser, token_ge()) {
        Stop(Ok({ parser: s.parser, node: s.names }))
      } else if at_eof(input, s.parser) {
        Stop(Err(error_here(input, s.parser, b"`>` to close the type parameter list")))
      } else {
        match expect_identifier(input, s.parser, b"an effect parameter name") {
          Err(q) -> Stop(Err(q)),
          Ok(n) -> {
            let e = eat(input, n.parser, token_comma());
            let names = s.names.push(n.node);
            if e.ok { Continue({ parser: e.parser, names: names }) }
            else { Stop(Ok({ parser: e.parser, node: names })) }
          },
        }
      },
  )

pub fn dump_type(ty: TypeExpression) -> Bytes / {abort.raise} =
  match ty {
    VariableTypeExpression(i) -> dump_node(i.span, b"tvar").concat(dump_identifier(i)),
    NamedTypeExpression(x) ->
      Bytes::concat_all([
        dump_node(x.span, b"tcon"),
        dump_qualified_name(x.name),
        dump_list(x.args, dump_type),
        if x.labels.len() == 0 && x.effect_arguments.len() == 0 { b"" } else {
          Bytes::concat_all([
            dump_word(b"over"),
            dump_list(x.labels, dump_identifier),
            dump_list(x.effect_arguments, dump_effects_expression),
          ])
        },
      ]),
    FunctionTypeExpression(x) ->
      Bytes::concat_all([
        dump_node(x.span, b"tfn"),
        if x.once { dump_word(b"once") } else { b"" },
        dump_list(x.params, dump_type),
        if x.keep_indices.len() == 0 { b"" }
        else { dump_word(b"keep").concat(dump_list(x.keep_indices, dump_count)) },
        dump_type(x.return_type),
        dump_opt(x.effects, dump_effects_expression),
      ]),
    RecordTypeExpression(x) ->
      dump_node(x.span, b"trec").concat(dump_list(x.fields, dump_type_field)),
    UnitTypeExpression(x) -> dump_node(x.span, b"tuni"),
    InvalidTypeExpression(x) -> dump_node(x.span, b"tbad"),
  }

fn dump_type_field(f: { name: Identifier, ty: TypeExpression }) -> Bytes / {abort.raise} =
  dump_identifier(f.name).concat(dump_type(f.ty))

pub fn dump_effects_expression(effects: EffectsExpression) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_node(effects.span, b"row"),
    dump_list(effects.listed, dump_effect_expression),
    dump_list(effects.aliases, dump_qualified_name),
    dump_opt(effects.variable, dump_identifier),
    if effects.variable_bounded { dump_word(b"bounded") } else { b"" },
  ])

pub fn dump_effect_expression(entry: EffectExpression) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_node(entry.span, b"atm"),
    dump_qualified_name(entry.effect_name),
    dump_mode(entry.mode),
    match entry.operation { Some(operation) -> dump_identifier(operation), None -> b"" },
    dump_opt(entry.resource, dump_identifier),
    if entry.bounded { dump_word(b"bounded") } else { b"" },
  ])

pub fn dump_mode(mode: Mode) -> Bytes =
  match mode {
    ReadMode -> dump_word(b"read"),
    WriteMode -> dump_word(b"write"),
    InvalidMode -> dump_word(b"badmode"),
    RaiseMode -> dump_word(b"raise"),
  }

pub fn dump_generics(generics: Generics) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    dump_word(b"gen"),
    dump_list(generics.types, dump_identifier),
    dump_list(generics.effects, dump_identifier),
    dump_list(generics.labels, dump_identifier),
    if generics.retained_types.len() == 0 { b"" }
    else { dump_word(b"keep").concat(dump_list(generics.retained_types, dump_identifier)) },
  ])

pub fn dump_type_of(source: Bytes) -> String / {abort.raise} = {
  let s = start(source);
  let r = parsed_or(ty(s.input, s.parser), no_type());
  String::of_bytes(dump_type(r.node).concat(dump_diagnostics(r.parser.diagnostics)))
}

pub fn dump_generics_of(source: Bytes) -> String / {abort.raise} = {
  let s = start(source);
  let r = parsed_or(generics(s.input, s.parser), no_generics());
  String::of_bytes(dump_generics(r.node).concat(dump_diagnostics(r.parser.diagnostics)))
}

pub fn mode_text(mode: Mode) -> Bytes =
  match mode {
    ReadMode -> b"read",
    WriteMode -> b"write",
    InvalidMode -> b"",
    RaiseMode -> b"raise",
  }

test "a bare uppercase name is a nullary constructor, a lowercase one a variable" {
  assert_eq(dump_type_of(b"Int"), "0:3:tcon;0:3:qname;?0;0:3:ident;@496e74;#0;#0;");
  assert_eq(dump_type_of(b"a"), "0:1:tvar;0:1:ident;@61;#0;")
}

test "unit, records and type arguments" {
  assert_eq(dump_type_of(b"()"), "0:2:tuni;#0;");
  assert_eq(dump_type_of(b"{}"), "0:2:trec;#0;#0;");
  assert_eq(
    dump_type_of(b"List<a>"),
    "0:7:tcon;0:4:qname;?0;0:4:ident;@4c697374;#1;5:6:tvar;5:6:ident;@61;#0;",
  );
  assert_eq(
    dump_type_of(b"{x: Int, y: a}"),
    "0:14:trec;#2;1:2:ident;@78;4:7:tcon;4:7:qname;?0;4:7:ident;@496e74;#0;9:10:ident;@79;12:13:tvar;12:13:ident;@61;#0;",
  )
}

test "nested type arguments close on two `>` tokens" {
  assert_eq(
    dump_type_of(b"Map<K, List<V>>"),
    "0:15:tcon;0:3:qname;?0;0:3:ident;@4d6170;#2;4:5:tcon;4:5:qname;?0;4:5:ident;@4b;#0;7:14:tcon;7:11:qname;?0;7:11:ident;@4c697374;#1;12:13:tcon;12:13:qname;?0;12:13:ident;@56;#0;#0;",
  )
}

test "a `>=` closing a type argument list is split into `>` and `=`" {
  assert_eq(
    dump_type_of(b"Pair<a>="),
    "0:7:tcon;0:4:qname;?0;0:4:ident;@50616972;#1;5:6:tvar;5:6:ident;@61;#0;",
  )
}

test "a type's `<...>` arguments may include label arguments in square brackets, and its effects come after `|`" {
  assert_eq(
    dump_type_of(b"T<a | e>"),
    "0:8:tcon;0:1:qname;?0;0:1:ident;@54;#1;2:3:tvar;2:3:ident;@61;%over;#0;#1;6:7:row;#0;#0;?1;6:7:ident;@65;#0;",
  );
  assert_eq(
    dump_type_of(b"T<a, [l], b, [k, m] | e, {}>"),
    "0:28:tcon;0:1:qname;?0;0:1:ident;@54;#2;2:3:tvar;2:3:ident;@61;10:11:tvar;10:11:ident;@62;"
      ++ "%over;#3;6:7:ident;@6c;14:15:ident;@6b;17:18:ident;@6d;"
      ++ "#2;22:23:row;#0;#0;?1;22:23:ident;@65;25:27:row;#0;#0;?0;#0;",
  );
  assert_eq(
    dump_type_of(b"T<[l]>"),
    "0:6:tcon;0:1:qname;?0;0:1:ident;@54;#0;%over;#1;3:4:ident;@6c;#0;#0;",
  );
  assert_eq(
    dump_type_of(b"T<| {db.read[users] | e}>"),
    "0:25:tcon;0:1:qname;?0;0:1:ident;@54;#0;%over;#0;#1;4:24:row;#1;5:19:atm;5:7:qname;?0;5:7:ident;@6462;%read;?1;13:18:ident;@7573657273;#0;?1;22:23:ident;@65;#0;",
  );
  assert_eq(
    dump_type_of(b"T<a |>"),
    "0:6:tcon;0:1:qname;?0;0:1:ident;@54;#1;2:3:tvar;2:3:ident;@61;#0;",
  )
}

test "a type's effects argument ends at its closing `>`, including inside a nested type, and `T<a | e>=` parses like `T<a | e>`" {
  assert_eq(
    dump_type_of(b"Map<K, T<a | e>>"),
    "0:16:tcon;0:3:qname;?0;0:3:ident;@4d6170;#2;4:5:tcon;4:5:qname;?0;4:5:ident;@4b;#0;"
      ++ "7:15:tcon;7:8:qname;?0;7:8:ident;@54;#1;9:10:tvar;9:10:ident;@61;%over;#0;#1;13:14:row;#0;#0;?1;13:14:ident;@65;#0;",
  );
  assert_eq(dump_type_of(b"T<a | e>="), dump_type_of(b"T<a | e>"))
}

test "an invalid effect, an invalid label argument, or a missing closing `>` reports one diagnostic" {
  assert_eq(dump_type_of(b"T<a | 3>"), "0:0:tbad;#1;!E0001:6:7:1:0;=6:7:1;");
  assert_eq(dump_type_of(b"T<[*]>"), "0:0:tbad;#1;!E0001:3:4:1:0;=3:4:1;");
  assert_eq(dump_type_of(b"T<a | e"), "0:0:tbad;#1;!E0001:7:7:1:0;=7:7:1;")
}

test "a parenthesised type has the span of the inner type, without the parentheses" {
  assert_eq(dump_type_of(b"(a)"), "1:2:tvar;1:2:ident;@61;#0;")
}

test "function types, with and without effects" {
  assert_eq(
    dump_type_of(b"(Int) -> Bool"),
    "0:13:tfn;#1;1:4:tcon;1:4:qname;?0;1:4:ident;@496e74;#0;9:13:tcon;9:13:qname;?0;9:13:ident;@426f6f6c;#0;?0;#0;",
  );
  assert_eq(
    dump_type_of(b"() -> Int / e"),
    "0:13:tfn;#0;6:9:tcon;6:9:qname;?0;6:9:ident;@496e74;#0;?1;12:13:row;#0;#0;?1;12:13:ident;@65;#0;",
  )
}

test "an effect carries its mode and its resource, and the effects carry their effect variable" {
  assert_eq(
    dump_type_of(b"() -> Int / {db.read[users] | e}"),
    "0:32:tfn;#0;6:9:tcon;6:9:qname;?0;6:9:ident;@496e74;#0;?1;12:32:row;#1;13:27:atm;13:15:qname;?0;13:15:ident;@6462;%read;?1;21:26:ident;@7573657273;#0;?1;30:31:ident;@65;#0;",
  )
}

test "an effect may name an operation instead of a mode" {
  assert_eq(
    dump_type_of(b"() -> Int / {net.send[conn]}"),
    "0:28:tfn;#0;6:9:tcon;6:9:qname;?0;6:9:ident;@496e74;#0;?1;12:28:row;#1;13:27:atm;13:16:qname;?0;13:16:ident;@6e6574;%write;17:21:ident;@73656e64;?1;22:26:ident;@636f6e6e;#0;?0;#0;",
  )
}

test "an effect list separates the sets it names from the effects it writes" {
  assert_eq(
    dump_type_of(b"(Int) -> Bool / {Web, io.write}"),
    "0:31:tfn;#1;1:4:tcon;1:4:qname;?0;1:4:ident;@496e74;#0;9:13:tcon;9:13:qname;?0;9:13:ident;@426f6f6c;#0;?1;16:31:row;#1;22:30:atm;22:24:qname;?0;22:24:ident;@696f;%write;?0;#1;17:20:qname;?0;17:20:ident;@576562;?0;#0;",
  )
}

test "a module-qualified type such as `m::T` parses into both its module name and its type name" {
  assert_eq(dump_type_of(b"m::T"), "0:4:tcon;0:4:qname;?1;0:1:ident;@6d;3:4:ident;@54;#0;#0;")
}

test "a parenthesised list that is not a parameter list is a tuple type" {
  assert_eq(
    dump_type_of(b"(Int, Bool)"),
    "0:11:trec;#2;1:4:ident;@5f30;1:4:tcon;1:4:qname;?0;1:4:ident;@496e74;#0;6:10:ident;@5f31;6:10:tcon;6:10:qname;?0;6:10:ident;@426f6f6c;#0;#0;",
  )
}

test "an unclosed `(` in a type reports one error that points at both the unexpected token and the `(`" {
  assert_eq(dump_type_of(b"("), "0:0:tbad;#1;!E0001:1:1:2:0;=1:1:1;=0:1:0;")
}

test "a token that cannot start a type, such as `<` or `}`, reports exactly one error" {
  assert_eq(dump_type_of(b"<"), "0:0:tbad;#1;!E0001:0:1:1:0;=0:1:1;");
  assert_eq(dump_type_of(b"{x: }"), "0:0:tbad;#1;!E0001:4:5:1:0;=4:5:1;")
}

test "a type parameter list, with and without effect parameters" {
  assert_eq(dump_generics_of(b"<a>"), "%gen;#1;1:2:ident;@61;#0;#0;#0;");
  assert_eq(dump_generics_of(b"<a, b>"), "%gen;#2;1:2:ident;@61;4:5:ident;@62;#0;#0;#0;");
  assert_eq(dump_generics_of(b"<a | e>"), "%gen;#1;1:2:ident;@61;#1;5:6:ident;@65;#0;#0;");
  assert_eq(
    dump_generics_of(b"<a, b | e, f>"),
    "%gen;#2;1:2:ident;@61;4:5:ident;@62;#2;8:9:ident;@65;11:12:ident;@66;#0;#0;",
  )
}

test "a bracketed name such as `[l]` in a type parameter list is parsed as a label name, separate from type and effect names" {
  assert_eq(dump_generics_of(b"<[l]>"), "%gen;#0;#0;#1;2:3:ident;@6c;#0;");
  assert_eq(
    dump_generics_of(b"<a, [l] | e>"),
    "%gen;#1;1:2:ident;@61;#1;10:11:ident;@65;#1;5:6:ident;@6c;#0;",
  );
  assert_eq(dump_generics_of(b"<[l, k]>"), "%gen;#0;#0;#2;2:3:ident;@6c;5:6:ident;@6b;#0;");
  assert_eq(dump_generics_of(b"<[l], [k]>"), "%gen;#0;#0;#2;2:3:ident;@6c;7:8:ident;@6b;#0;")
}

test "a type parameter list may leave out its type names or its effect names, and one missing its `>` is an error" {
  assert_eq(dump_generics_of(b"<|e>"), "%gen;#0;#1;2:3:ident;@65;#0;#0;");
  assert_eq(dump_generics_of(b"<>"), "%gen;#0;#0;#0;#0;");
  assert_eq(dump_generics_of(b"<a"), "%gen;#0;#0;#0;#1;!E0001:2:2:1:0;=2:2:1;")
}

test "an unclosed `{` in a record type reports an error at the `{` too, but an unclosed `<` reports only the error at the end" {
  assert_eq(dump_type_of(b"{x: Int"), "0:0:tbad;#1;!E0001:7:7:2:0;=7:7:1;=0:1:0;");
  assert_eq(dump_type_of(b"List<a"), "0:0:tbad;#1;!E0001:6:6:1:0;=6:6:1;")
}

test "a trailing comma in a record type is allowed" {
  assert_eq(
    dump_type_of(b"{x: Int, }"),
    "0:10:trec;#1;1:2:ident;@78;4:7:tcon;4:7:qname;?0;4:7:ident;@496e74;#0;#0;",
  )
}
