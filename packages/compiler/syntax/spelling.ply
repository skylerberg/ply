//! A literal's value spelled as source that lexes back to that value: the lexer's inverse, for text
//! printed from a tree no source holds.

import compiler.syntax.lexer (widths, wide_decimal, utf8_of)
import compiler.syntax.patterns (Lit, LInt, LFixed, LWide, LBool, LStr, LBytes, LEmbedded, LFloat,
                                 LDec, LChar, LUnit, LBad)
import std.bytes (ascii_of_int)
import std.list
import std.option
import std.string

/// `literal` spelled from its value. `LFloat` and `LDec` print the text they carry; `LEmbedded`
/// prints the `embed` call of its digest's hex, which a parse reads as that call rather than as
/// the literal; `LBad` prints `()`. Raises where a fixed-width literal names none of
/// `lexer::widths()`.
pub fn literal_text(literal: Lit) -> Bytes / {abort.raise} =
  match literal {
    LInt(value) -> int_text(value),
    LFixed(suffix, bits) -> fixed_text(width_index(suffix), bits),
    LWide(suffix, high, low) -> wide_text(width_index(suffix), high, low),
    LBool(value) -> if value { b"true" } else { b"false" },
    LStr(text) -> string_literal(text),
    LBytes(content) -> bytes_literal(content),
    LEmbedded(digest, _) ->
      Bytes::concat_all([b"embed(\"", Bytes::of_string(digest.hex_of()), b"\")"]),
    LFloat(text) -> text,
    LDec(text) -> text,
    LChar(value) -> char_literal(value),
    LUnit -> b"()",
    LBad -> b"()",
  }

/// `literal` as a pattern spells it: as `literal_text` does, but a negative integer as its `-` and
/// magnitude, which a pattern reads as one literal. A signed width's least value has no magnitude
/// the width holds, so it keeps its bit pattern.
pub fn pattern_literal_text(literal: Lit) -> Bytes / {abort.raise} =
  match literal {
    LInt(value) -> if value < 0 && value != least(64) { ascii_of_int(value) }
    else { int_text(value) },
    LFixed(suffix, bits) -> {
      let width = widths().get(width_index(suffix));
      if width.signed && bits < 0 && bits != least(width.bits) {
        ascii_of_int(bits).concat(width.name)
      } else { literal_text(literal) }
    },
    LWide(suffix, high, low) -> {
      let width = widths().get(width_index(suffix));
      if width.signed && high < 0 && (high != least(64) || low != 0) {
        wide_decimal(true, high, low).concat(width.name)
      } else { literal_text(literal) }
    },
    _ -> literal_text(literal),
  }

/// The least value of a signed width of `bits` bits, at most 64.
fn least(bits: Int) -> Int =
  if bits == 64 { 0 - 9223372036854775807 - 1 } else { 0 - (1 << bits - 1) }

/// The place in `lexer::widths()` of the width a fixed-width literal's suffix names, in either case.
fn width_index(suffix: Bytes) -> Int / {abort.raise} = {
  let wanted = Bytes::of_string(String::of_bytes(suffix).ascii_lower());
  let all = widths();
  match range(0, all.len()).fold(None, |found: Option<Int>, i: Int|
      if all.get(i).name == wanted { Some(i) } else { found }) {
    Some(i) -> i,
    None -> panic("a width no literal names"),
  }
}

fn hex_digit(value: Int) -> Bytes / {abort.raise} = b"0123456789abcdef".slice(value, value + 1)

/// The low `count` hex digits of `value`, without the leading zeros but the last.
fn hex_digits(value: Int, count: Int) -> Bytes / {abort.raise} = {
  let digits = range(0, count).map(|i: Int| value >>> 4 * (count - 1 - i) & 15);
  let lead = range(0, count).fold(count - 1, |acc: Int, i: Int|
    if digits.get(i) != 0 && i < acc { i } else { acc });
  Bytes::concat_all(range(lead, count).map(|i: Int| hex_digit(digits.get(i))))
}

fn hex_int(value: Int, bits: Int) -> Bytes / {abort.raise} =
  b"0x".concat(hex_digits(value, bits / 4))

fn zeros(count: Int) -> Bytes = Bytes::concat_all(range(0, count).map(|i: Int| b"0"))

/// An `Int` literal: its digits, or for a negative one its 64-bit pattern in hex, since `-5` reads
/// back as a negation in an expression and the least `Int` has no positive to negate.
pub fn int_text(value: Int) -> Bytes / {abort.raise} =
  if value >= 0 { ascii_of_int(value) } else { hex_int(value, 64) }

/// A literal of a width narrower than 128 bits, its suffix included: `width` is the width's place in
/// `lexer::widths()` and `bits` the value's `Int` pattern as the width reads it. A negative pattern
/// is written in hex, as `int_text` writes one. Raises where `width` is no such width's place.
pub fn fixed_text(width: Int, bits: Int) -> Bytes / {abort.raise} =
  match widths().at(width) {
    Some(found) -> if found.bits == 128 { panic("a 128-bit width, which `wide_text` spells") }
    else {
      Bytes::concat(
        if bits >= 0 { ascii_of_int(bits) } else { hex_int(bits, found.bits) },
        found.name,
      )
    },
    None -> panic("a width no literal names"),
  }

/// A 128-bit literal, its suffix included, from its high and low 64-bit patterns: `width` is the
/// width's place in `lexer::widths()`. A negative signed value is written in hex, every other in
/// decimal. Raises where `width` is no 128-bit width's place.
pub fn wide_text(width: Int, high: Int, low: Int) -> Bytes / {abort.raise} =
  match widths().at(width) {
    Some(found) -> if found.bits != 128 { panic("a narrow width, which `fixed_text` spells") }
    else {
      Bytes::concat(
        if found.signed && high < 0 {
          Bytes::concat_all([
            b"0x",
            hex_digits(high, 16),
            Bytes::concat_all(range(0, 16).map(|i: Int| hex_digit(low >>> 4 * (15 - i) & 15))),
          ])
        } else { wide_decimal(false, high, low) },
        found.name,
      )
    },
    None -> panic("a width no literal names"),
  }

/// A number as base-10^9 limbs, least significant first.
type Limbs = List<Int>

/// `number * factor + add`.
fn limbs_times(number: Limbs, factor: Int, add: Int) -> Limbs / {abort.raise} = {
  let multiplied = number.fold(
    { limbs: [], carry: add },
    |acc: { limbs: Limbs, carry: Int }, limb: Int| {
      let product = limb * factor + acc.carry;
      { limbs: acc.limbs.push(product % 1000000000), carry: product / 1000000000 }
    },
  );
  iterate(multiplied, 4, |acc: { limbs: Limbs, carry: Int }|
    if acc.carry == 0 { Stop(acc) } else {
      Continue({ limbs: acc.limbs.push(acc.carry % 1000000000), carry: acc.carry / 1000000000 })
    }).limbs
}

fn power(base: Int, exponent: Int) -> Int =
  range(0, exponent).fold(1, |acc: Int, i: Int| acc * base)

/// `number * base^exponent`, a chunk of powers a round so no limb product overflows.
fn limbs_times_power(number: Limbs, base: Int, exponent: Int) -> Limbs / {abort.raise} = {
  let chunk = if base == 5 { 13 } else { 30 };
  limbs_times(
    range(0, exponent / chunk).fold(number, |acc: Limbs, i: Int|
      limbs_times(acc, power(base, chunk), 0)),
    power(base, exponent % chunk),
    0,
  )
}

fn limbs_digits(number: Limbs) -> Bytes / {abort.raise} = {
  let top = range(0, number.len()).fold(0, |acc: Int, i: Int|
    if number.get(i) != 0 { i } else { acc });
  Bytes::concat_all(
    range(0, top + 1).map(|i: Int| {
      let digits = ascii_of_int(number.get(top - i));
      if i == 0 { digits } else { zeros(9 - digits.len()).concat(digits) }
    }),
  )
}

/// A `Decimal` literal, its `m` included: `mantissa` is the unsigned 96-bit mantissa as 16
/// little-endian bytes, the top four zero, and `scale` how many of its digits follow the point, 0 to
/// 28. Every zero the scale counts is written, so `1.50m` stays two places. Raises on a mantissa or
/// a scale no `Decimal` has.
pub fn decimal_text(mantissa: Bytes, scale: Int) -> Bytes / {abort.raise} =
  if scale < 0 || scale > 28 || mantissa.len() != 16
      || range(12, 16).fold(false, |acc: Bool, i: Int| acc || mantissa.at(i) != 0) {
    panic("a mantissa and scale that are not a `Decimal`")
  } else {
    let digits = limbs_digits(
      range(0, 12).fold([0], |acc: Limbs, i: Int| limbs_times(acc, 256, mantissa.at(11 - i))),
    );
    let padded = if digits.len() <= scale { zeros(scale - digits.len() + 1).concat(digits) }
    else { digits };
    let point = padded.len() - scale;
    Bytes::concat(
      if scale == 0 { digits }
      else { Bytes::concat_all([padded.slice(0, point), b".", padded.slice(point, padded.len())]) },
      b"m",
    )
  }

/// Significant digits, the power of ten of the first, and how many digits were asked for.
type Rounded = { digits: Bytes, exponent: Int, asked: Int }

fn trim_zeros(digits: Bytes) -> Bytes / {abort.raise} =
  digits.slice(
    0,
    range(0, digits.len()).fold(1, |acc: Int, i: Int| if digits.at(i) != 48 { i + 1 } else { acc }),
  )

fn scientific(digits: Bytes, exponent: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    digits.slice(0, 1),
    if digits.len() > 1 { b".".concat(digits.slice(1, digits.len())) } else { b"" },
    b"e",
    ascii_of_int(exponent),
  ])

/// The exact digits `digits` rounded half up to `asked` of them.
fn round_to(digits: Bytes, exponent: Int, asked: Int) -> Rounded / {abort.raise} = {
  let head = digits.slice(0, asked);
  if asked >= digits.len() || digits.at(asked) < 53 {
    { digits: trim_zeros(head), exponent: exponent, asked: asked }
  } else {
    let last = range(0, asked).fold(0 - 1, |acc: Int, i: Int|
      if head.at(i) != 57 { i } else { acc });
    if last < 0 { { digits: b"1", exponent: exponent + 1, asked: asked } } else {
      {
        digits: head.slice(0, last).concat(byte_of_int(head.at(last) + 1)),
        exponent: exponent,
        asked: asked,
      }
    }
  }
}

fn reads_back(rounded: Rounded, magnitude: Int) -> Bool / {abort.raise} =
  match Float::of_string(String::of_bytes(scientific(rounded.digits, rounded.exponent))) {
    Some(read) -> bits_of_float(read) == magnitude,
    None -> false,
  }

/// The fewest digits of the exact expansion `digits` that read back to the pattern `magnitude`;
/// seventeen always do, and the whole expansion where rounding missed.
fn shortest(digits: Bytes, exponent: Int, magnitude: Int) -> Rounded / {abort.raise} =
  iterate({ digits: digits, exponent: exponent, asked: 1 }, 19, |tried: Rounded|
    if tried.asked > 17 || tried.asked > digits.len() {
      Stop({ digits: trim_zeros(digits), exponent: exponent, asked: tried.asked })
    } else {
      let rounded = round_to(digits, exponent, tried.asked);
      if reads_back(rounded, magnitude) { Stop(rounded) }
      else { Continue({ ..tried, asked: tried.asked + 1 }) }
    })

/// The shorter of the positional and the exponential form, with a `.` or an `e` so it lexes as a
/// float.
fn float_spelling(rounded: Rounded) -> Bytes / {abort.raise} = {
  let digits = rounded.digits;
  let count = digits.len();
  let exponent = rounded.exponent;
  let positional = if exponent >= count - 1 { digits.concat(zeros(exponent - count + 1)) }
  else if exponent >= 0 {
    Bytes::concat_all([digits.slice(0, exponent + 1), b".", digits.slice(exponent + 1, count)])
  } else { Bytes::concat_all([b"0.", zeros(0 - exponent - 1), digits]) };
  let exponential = scientific(digits, exponent);
  let text = if exponential.len() < positional.len() { exponential } else { positional };
  match text.index_of(b".") {
    Some(_) -> text,
    None -> match text.index_of(b"e") { Some(_) -> text, None -> text.concat(b".0") },
  }
}

/// A `Float` literal from its IEEE 754 bit pattern, in the fewest significant digits that read back
/// to it: a `-` before a negative one, and an infinity as `1e400`, which overflows to it. Raises on
/// a NaN, which no literal spells.
pub fn float_text(bits: Int) -> Bytes / {abort.raise} = {
  let magnitude = bits & 0x7FFFFFFFFFFFFFFF;
  let sign = if bits < 0 { b"-" } else { b"" };
  let biased = magnitude >>> 52;
  let fraction = magnitude & 0xFFFFFFFFFFFFF;
  if biased == 2047 && fraction != 0 { panic("a NaN, which no literal spells") }
  else if biased == 2047 { sign.concat(b"1e400") }
  else if magnitude == 0 { sign.concat(b"0.0") } else {
    let significand = if biased == 0 { fraction } else { fraction | 0x10000000000000 };
    let binary_exponent = if biased == 0 { 0 - 1074 } else { biased - 1075 };
    let start = [significand % 1000000000, significand / 1000000000];
    let digits = limbs_digits(if binary_exponent >= 0 {
      limbs_times_power(start, 2, binary_exponent)
    } else { limbs_times_power(start, 5, 0 - binary_exponent) });
    let exponent = digits.len() - 1 + (if binary_exponent >= 0 { 0 } else { binary_exponent });
    sign.concat(float_spelling(shortest(digits, exponent, magnitude)))
  }
}

/// A byte of text every quoted literal escapes alike, or `None` for one each writes its own way.
fn common_escape(byte: Int) -> Option<Bytes> =
  if byte == 92 { Some(b"\\\\") }
  else if byte == 10 { Some(b"\\n") }
  else if byte == 9 { Some(b"\\t") }
  else if byte == 13 { Some(b"\\r") }
  else if byte == 0 { Some(b"\\0") }
  else { None }

/// A byte of a string's text: a control character as its `\u{..}`, any byte past ASCII as it is,
/// since a string's text is the UTF-8 it holds.
fn text_byte(byte: Int) -> Bytes / {abort.raise} =
  match common_escape(byte) {
    Some(escaped) -> escaped,
    None -> if byte == 34 { b"\\\"" }
    else if byte < 32 || byte == 127 { Bytes::concat_all([b"\\u{", hex_digits(byte, 2), b"}"]) }
    else { byte_of_int(byte) },
  }

/// A string literal that reads back as `text`.
pub fn string_literal(text: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\"",
    Bytes::concat_all(range(0, text.len()).map(|i: Int| text_byte(text.at(i)))),
    b"\"",
  ])

/// The text of an interpolated string or a tagged literal between its quotes and holes, without the
/// quotes, that reads back as `text`: escaped as a string's, with each brace doubled, since a single
/// one opens or closes a hole.
pub fn template_text(text: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, text.len()).map(|i: Int| {
      let byte = text.at(i);
      if byte == 123 { b"{{" } else if byte == 125 { b"}}" } else { text_byte(byte) }
    }),
  )

/// A byte-string literal that reads back as `content`: printable ASCII as it is, every other byte
/// as its `\xNN`.
pub fn bytes_literal(content: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"b\"",
    Bytes::concat_all(
      range(0, content.len()).map(|i: Int| {
        let byte = content.at(i);
        match common_escape(byte) {
          Some(escaped) -> escaped,
          None -> if byte == 34 { b"\\\"" }
          else if byte >= 32 && byte <= 126 { byte_of_int(byte) }
          else { Bytes::concat_all([b"\\x", hex_digit(byte >>> 4), hex_digit(byte & 15)]) },
        }
      }),
    ),
    b"\"",
  ])

/// A character literal that reads back as the Unicode scalar value `value`: past ASCII as its own
/// UTF-8.
pub fn char_literal(value: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"'",
    if value == 39 { b"\\'" } else if value < 128 { text_byte(value) } else { utf8_of(value) },
    b"'",
  ])
