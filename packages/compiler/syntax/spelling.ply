//! A literal's value spelled as source that lexes back to that value: the lexer's inverse, for text
//! printed from a tree no source holds.

import syntax.lexer (widths, wide_decimal, utf8_of, lex, int_of_digits, Token, TokenKind,
                     IntLiteral, FixedLiteral, WideLiteral, FloatLiteral, DecimalLiteral,
                     StringLiteral, BytesLiteral, CharLiteral, InterpolatedHead, InterpolatedTail,
                     Identifier, Punctuation, EndOfInput)
import syntax.patterns (Lit, LInt, LFixed, LWide, LBool, LStr, LBytes, LEmbedded, LFloat, LDec,
                        LChar, LUnit, LBad)
import std.bytes (ascii_of_int)
import std.list
import std.option
import std.string

/// `literal` spelled from its value. `LFloat` and `LDec` print the text they carry; `LEmbedded`
/// prints the `embed` call of its digest's hex, which a parse reads as that call rather than as
/// the literal; `LBad` prints `()`. Raises where a fixed-width literal names none of
/// `lexer::widths()`.
pub fn literal_text(literal: Lit) -> Bytes / {abort.raise} =
  match literal {
    LInt(v) -> int_text(v),
    LFixed(ty, v) -> fixed_text(width_index(ty), v),
    LWide(ty, high, low) -> wide_text(width_index(ty), high, low),
    LBool(b) -> if b { b"true" } else { b"false" },
    LStr(s) -> str_lit(s),
    LBytes(b) -> bytes_lit(b),
    LEmbedded(digest, _) ->
      Bytes::concat_all([b"embed(\"", Bytes::of_string(digest.hex_of()), b"\")"]),
    LFloat(text) -> text,
    LDec(text) -> text,
    LChar(v) -> char_lit(v),
    LUnit -> b"()",
    LBad -> b"()",
  }

/// `literal` as a pattern spells it: as `literal_text` does, but a negative integer as its `-` and
/// magnitude, which a pattern reads as one literal. A signed width's least value has no magnitude
/// the width holds, so it keeps its bit pattern.
pub fn pattern_literal_text(literal: Lit) -> Bytes / {abort.raise} =
  match literal {
    LInt(v) -> if v < 0 && v != least(64) { ascii_of_int(v) } else { int_text(v) },
    LFixed(ty, v) -> {
      let w = widths().get(width_index(ty));
      if w.signed && v < 0 && v != least(w.bits) { ascii_of_int(v).concat(w.name) }
      else { literal_text(literal) }
    },
    LWide(ty, high, low) -> {
      let w = widths().get(width_index(ty));
      if w.signed && high < 0 && (high != least(64) || low != 0) {
        wide_decimal(true, high, low).concat(w.name)
      } else { literal_text(literal) }
    },
    _ -> literal_text(literal),
  }

/// The least value of a signed width of `bits` bits, at most 64.
fn least(bits: Int) -> Int =
  if bits == 64 { 0 - 9223372036854775807 - 1 } else { 0 - (1 << bits - 1) }

/// The place in `lexer::widths()` of the width a fixed-width literal names, in either case.
fn width_index(name: Bytes) -> Int / {abort.raise} = {
  let want = Bytes::of_string(String::of_bytes(name).ascii_lower());
  let ws = widths();
  match range(0, ws.len()).fold(None, |at: Option<Int>, i: Int|
      if ws.get(i).name == want { Some(i) } else { at }) {
    Some(i) -> i,
    None -> panic("a width no literal names"),
  }
}

fn hex_digit(v: Int) -> Bytes / {abort.raise} = b"0123456789abcdef".slice(v, v + 1)

/// The low `n` hex digits of `v`, without the leading zeros but the last.
fn hex_digits(v: Int, n: Int) -> Bytes / {abort.raise} = {
  let ds = range(0, n).map(|i: Int| v >>> 4 * (n - 1 - i) & 15);
  let lead = range(0, n).fold(n - 1, |acc: Int, j: Int|
    if ds.get(j) != 0 && j < acc { j } else { acc });
  Bytes::concat_all(range(lead, n).map(|j: Int| hex_digit(ds.get(j))))
}

fn hex_int(v: Int, bits: Int) -> Bytes / {abort.raise} = b"0x".concat(hex_digits(v, bits / 4))

fn zeros(k: Int) -> Bytes = Bytes::concat_all(range(0, k).map(|i: Int| b"0"))

/// An `Int` literal: its digits, or for a negative one its 64-bit pattern in hex, since `-5` reads
/// back as a negation in an expression and the least `Int` has no positive to negate.
pub fn int_text(v: Int) -> Bytes / {abort.raise} =
  if v >= 0 { ascii_of_int(v) } else { hex_int(v, 64) }

/// A literal of a width narrower than 128 bits, its suffix included: `width` is the width's place in
/// `lexer::widths()` and `bits` the value's `Int` pattern as the width reads it. A negative pattern
/// is written in hex, as `int_text` writes one. Raises where `width` is no such width's place.
pub fn fixed_text(width: Int, bits: Int) -> Bytes / {abort.raise} =
  match widths().at(width) {
    Some(w) -> if w.bits == 128 { panic("a 128-bit width, which `wide_text` spells") } else {
      Bytes::concat(if bits >= 0 { ascii_of_int(bits) } else { hex_int(bits, w.bits) }, w.name)
    },
    None -> panic("a width no literal names"),
  }

/// A 128-bit literal, its suffix included, from its high and low 64-bit patterns: `width` is the
/// width's place in `lexer::widths()`. A negative signed value is written in hex, every other in
/// decimal. Raises where `width` is no 128-bit width's place.
pub fn wide_text(width: Int, high: Int, low: Int) -> Bytes / {abort.raise} =
  match widths().at(width) {
    Some(w) -> if w.bits != 128 { panic("a narrow width, which `fixed_text` spells") } else {
      Bytes::concat(
        if w.signed && high < 0 {
          Bytes::concat_all([
            b"0x",
            hex_digits(high, 16),
            Bytes::concat_all(range(0, 16).map(|i: Int| hex_digit(low >>> 4 * (15 - i) & 15))),
          ])
        } else { wide_decimal(false, high, low) },
        w.name,
      )
    },
    None -> panic("a width no literal names"),
  }

/// `n * f + add` over base-10^9 limbs, least significant first.
fn big_mul(n: List<Int>, f: Int, add: Int) -> List<Int> / {abort.raise} = {
  let r = n.fold({ limbs: [], carry: add }, |s: { limbs: List<Int>, carry: Int }, limb: Int| {
    let v = limb * f + s.carry;
    { limbs: s.limbs.push(v % 1000000000), carry: v / 1000000000 }
  });
  iterate(r, 4, |s: { limbs: List<Int>, carry: Int }|
    if s.carry == 0 { Stop(s) } else {
      Continue({ limbs: s.limbs.push(s.carry % 1000000000), carry: s.carry / 1000000000 })
    }).limbs
}

fn pow_int(b: Int, k: Int) -> Int = range(0, k).fold(1, |a: Int, i: Int| a * b)

/// `n * base^e`, a chunk of powers a round so no limb product overflows.
fn big_pow(n: List<Int>, base: Int, e: Int) -> List<Int> / {abort.raise} = {
  let chunk = if base == 5 { 13 } else { 30 };
  big_mul(
    range(0, e / chunk).fold(n, |acc: List<Int>, i: Int| big_mul(acc, pow_int(base, chunk), 0)),
    pow_int(base, e % chunk),
    0,
  )
}

fn big_digits(n: List<Int>) -> Bytes / {abort.raise} = {
  let top = range(0, n.len()).fold(0, |t: Int, i: Int| if n.get(i) != 0 { i } else { t });
  Bytes::concat_all(
    range(0, top + 1).map(|j: Int| {
      let d = ascii_of_int(n.get(top - j));
      if j == 0 { d } else { zeros(9 - d.len()).concat(d) }
    }),
  )
}

/// A `Decimal` literal, its `m` included: `mantissa` is the unsigned 96-bit mantissa as 16
/// little-endian bytes, the top four zero, and `scale` how many of its digits follow the point, 0 to
/// 28. Every zero the scale counts is written, so `1.50m` stays two places. Raises on a mantissa or
/// a scale no `Decimal` has.
pub fn decimal_text(mantissa: Bytes, scale: Int) -> Bytes / {abort.raise} =
  if scale < 0 || scale > 28 || mantissa.len() != 16
      || range(12, 16).fold(false, |b: Bool, i: Int| b || mantissa.at(i) != 0) {
    panic("a mantissa and scale that are not a `Decimal`")
  } else {
    let ds = big_digits(
      range(0, 12).fold([0], |acc: List<Int>, i: Int| big_mul(acc, 256, mantissa.at(11 - i))),
    );
    let padded = if ds.len() <= scale { zeros(scale - ds.len() + 1).concat(ds) } else { ds };
    let point = padded.len() - scale;
    Bytes::concat(
      if scale == 0 { ds }
      else { Bytes::concat_all([padded.slice(0, point), b".", padded.slice(point, padded.len())]) },
      b"m",
    )
  }

/// Significant digits, the power of ten of the first, and how many digits were asked for.
type Rounded = { digits: Bytes, exp: Int, p: Int }

fn trim_zeros(s: Bytes) -> Bytes / {abort.raise} =
  s.slice(0, range(0, s.len()).fold(1, |acc: Int, i: Int| if s.at(i) != 48 { i + 1 } else { acc }))

fn scientific(s: Bytes, x: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    s.slice(0, 1),
    if s.len() > 1 { b".".concat(s.slice(1, s.len())) } else { b"" },
    b"e",
    ascii_of_int(x),
  ])

/// The exact digits `ds` rounded half up to `p` of them.
fn round_to(ds: Bytes, x0: Int, p: Int) -> Rounded / {abort.raise} = {
  let head = ds.slice(0, p);
  if p >= ds.len() || ds.at(p) < 53 { { digits: trim_zeros(head), exp: x0, p: p } } else {
    let k = range(0, p).fold(0 - 1, |acc: Int, i: Int| if head.at(i) != 57 { i } else { acc });
    if k < 0 { { digits: b"1", exp: x0 + 1, p: p } }
    else { { digits: head.slice(0, k).concat(byte_of_int(head.at(k) + 1)), exp: x0, p: p } }
  }
}

fn reads_back(r: Rounded, mag: Int) -> Bool / {abort.raise} =
  match Float::of_string(String::of_bytes(scientific(r.digits, r.exp))) {
    Some(f) -> bits_of_float(f) == mag,
    None -> false,
  }

/// The fewest digits of the exact expansion `ds` that read back to the pattern `mag`; seventeen
/// always do, and the whole expansion where rounding missed.
fn shortest(ds: Bytes, x0: Int, mag: Int) -> Rounded / {abort.raise} =
  iterate({ digits: ds, exp: x0, p: 1 }, 19, |s: Rounded|
    if s.p > 17 || s.p > ds.len() { Stop({ digits: trim_zeros(ds), exp: x0, p: s.p }) } else {
      let r = round_to(ds, x0, s.p);
      if reads_back(r, mag) { Stop(r) } else { Continue({ ..s, p: s.p + 1 }) }
    })

/// The shorter of the positional and the exponential form, with a `.` or an `e` so it lexes as a
/// float.
fn float_spelling(r: Rounded) -> Bytes / {abort.raise} = {
  let s = r.digits;
  let n = s.len();
  let positional = if r.exp >= n - 1 { s.concat(zeros(r.exp - n + 1)) }
  else if r.exp >= 0 { Bytes::concat_all([s.slice(0, r.exp + 1), b".", s.slice(r.exp + 1, n)]) }
  else { Bytes::concat_all([b"0.", zeros(0 - r.exp - 1), s]) };
  let exponential = scientific(s, r.exp);
  let text = if exponential.len() < positional.len() { exponential } else { positional };
  match text.index_of(b".") {
    Some(_) -> text,
    None -> match text.index_of(b"e") { Some(_) -> text, None -> text.concat(b".0") },
  }
}

/// A `Float` literal from its IEEE 754 bit pattern, in the fewest significant digits that read back
/// to it: a `-` before a negative one, and an infinity as `1e400`, which overflows to it. Raises on
/// a NaN, which no literal spells.
pub fn float_text(bits: Int) -> Bytes / {abort.raise} = {
  let mag = bits & 0x7FFFFFFFFFFFFFFF;
  let sign = if bits < 0 { b"-" } else { b"" };
  let ex = mag >>> 52;
  let fr = mag & 0xFFFFFFFFFFFFF;
  if ex == 2047 && fr != 0 { panic("a NaN, which no literal spells") }
  else if ex == 2047 { sign.concat(b"1e400") }
  else if mag == 0 { sign.concat(b"0.0") } else {
    let m = if ex == 0 { fr } else { fr | 0x10000000000000 };
    let e2 = if ex == 0 { 0 - 1074 } else { ex - 1075 };
    let start = [m % 1000000000, m / 1000000000];
    let ds = big_digits(if e2 >= 0 { big_pow(start, 2, e2) } else { big_pow(start, 5, 0 - e2) });
    let x0 = ds.len() - 1 + (if e2 >= 0 { 0 } else { e2 });
    sign.concat(float_spelling(shortest(ds, x0, mag)))
  }
}

/// A byte of text every quoted literal escapes alike, or `None` for one each writes its own way.
fn common_escape(c: Int) -> Option<Bytes> =
  if c == 92 { Some(b"\\\\") }
  else if c == 10 { Some(b"\\n") }
  else if c == 9 { Some(b"\\t") }
  else if c == 13 { Some(b"\\r") }
  else if c == 0 { Some(b"\\0") }
  else { None }

/// A byte of a string's text: a control character as its `\u{..}`, any byte past ASCII as it is,
/// since a string's text is the UTF-8 it holds.
fn text_byte(c: Int) -> Bytes / {abort.raise} =
  match common_escape(c) {
    Some(e) -> e,
    None -> if c == 34 { b"\\\"" }
    else if c < 32 || c == 127 { Bytes::concat_all([b"\\u{", hex_digits(c, 2), b"}"]) }
    else { byte_of_int(c) },
  }

/// A string literal that reads back as `s`.
pub fn str_lit(s: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\"",
    Bytes::concat_all(range(0, s.len()).map(|i: Int| text_byte(s.at(i)))),
    b"\"",
  ])

/// The text of an interpolated string or a tagged literal between its quotes and holes, without the
/// quotes, that reads back as `s`: escaped as a string's, with each brace doubled, since a single
/// one opens or closes a hole.
pub fn template_text(s: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, s.len()).map(|i: Int| {
      let c = s.at(i);
      if c == 123 { b"{{" } else if c == 125 { b"}}" } else { text_byte(c) }
    }),
  )

/// A byte-string literal that reads back as `b`: printable ASCII as it is, every other byte as its
/// `\xNN`.
pub fn bytes_lit(b: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"b\"",
    Bytes::concat_all(
      range(0, b.len()).map(|i: Int| {
        let c = b.at(i);
        match common_escape(c) {
          Some(e) -> e,
          None -> if c == 34 { b"\\\"" }
          else if c >= 32 && c <= 126 { byte_of_int(c) }
          else { Bytes::concat_all([b"\\x", hex_digit(c >>> 4), hex_digit(c & 15)]) },
        }
      }),
    ),
    b"\"",
  ])

/// A character literal that reads back as the Unicode scalar value `v`: past ASCII as its own UTF-8.
pub fn char_lit(v: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"'",
    if v == 39 { b"\\'" } else if v < 128 { text_byte(v) } else { utf8_of(v) },
    b"'",
  ])

// --- Tests ------------------------------------------------------------------

/// The tokens `src` lexes to, which it must lex without a diagnostic.
fn tokens_of(src: Bytes) -> List<TokenKind> / {abort.raise} = {
  let lexed = lex(src);
  assert_eq(lexed.diags.len(), 0);
  lexed.tokens.filter(|t: Token| t.kind != EndOfInput).map(|t: Token| t.kind)
}

fn int_max() -> Int = 9223372036854775807

fn int_min() -> Int = 0 - int_max() - 1

fn upper(name: Bytes) -> Bytes / {abort.raise} =
  Bytes::of_string(String::of_bytes(name).ascii_upper())

test "an `Int` lexes back to itself, the least and the negative ones through their bit patterns" {
  [0, 7, int_max(), -1, -5, int_min()].fold((), |u: Unit, v: Int|
    assert_eq(tokens_of(int_text(v)), [IntLiteral(v)]))
}

test "every narrow width's least and greatest value lexes back to itself" {
  range(0, widths().len()).fold((), |u: Unit, i: Int| {
    let w = widths().get(i);
    let values = if w.bits == 128 { [] }
    else if w.signed && w.bits == 64 { [int_min(), -1, 0, int_max()] }
    else if w.signed { [0 - (1 << w.bits - 1), -1, 0, (1 << w.bits - 1) - 1] }
    else if w.bits == 64 { [0, 1, int_max(), -1] }
    else { [0, 1, (1 << w.bits) - 1] };
    values.fold(u, |v2: Unit, v: Int|
      assert_eq(tokens_of(fixed_text(i, v)), [FixedLiteral(upper(w.name), v)]))
  })
}

test "a negative integer in a pattern lexes as its sign and magnitude, but a width's least value as its pattern" {
  let negated = |literal: Lit, magnitude: TokenKind|
    assert_eq(tokens_of(pattern_literal_text(literal)), [Punctuation(b"minus"), magnitude]);
  negated(LInt(-5), IntLiteral(5));
  negated(LInt(0 - int_max()), IntLiteral(int_max()));
  negated(LFixed(b"I8", -127), FixedLiteral(b"I8", 127));
  negated(LFixed(b"I64", -3), FixedLiteral(b"I64", 3));
  negated(LWide(b"I128", -1, -5), WideLiteral(b"I128", 0, 5));
  negated(LWide(b"I128", -1, 1), WideLiteral(b"I128", 0, -1));
  negated(LWide(b"I128", -1, 0), WideLiteral(b"I128", 1, 0));
  assert_eq(tokens_of(pattern_literal_text(LInt(int_min()))), [IntLiteral(int_min())]);
  assert_eq(tokens_of(pattern_literal_text(LFixed(b"I8", -128))), [FixedLiteral(b"I8", -128)]);
  assert_eq(tokens_of(pattern_literal_text(LWide(b"I128", int_min(), 0))), [
    WideLiteral(b"I128", int_min(), 0),
  ]);
  assert_eq(tokens_of(pattern_literal_text(LFixed(b"U8", 200))), [FixedLiteral(b"U8", 200)])
}

test "a 128-bit value lexes back to its two halves, the extremes of both widths among them" {
  let unsigned = width_index(b"u128");
  let signed = width_index(b"i128");
  [
    { w: unsigned, high: 0, low: 0 },
    { w: unsigned, high: 0, low: -1 },
    { w: unsigned, high: 1, low: 0 },
    { w: unsigned, high: -1, low: -1 },
    { w: signed, high: int_min(), low: 0 },
    { w: signed, high: int_max(), low: -1 },
    { w: signed, high: -1, low: -1 },
    { w: signed, high: -1, low: 0 },
    { w: signed, high: 0, low: 5 },
  ].fold((), |u: Unit, c: { w: Int, high: Int, low: Int }|
    assert_eq(tokens_of(wide_text(c.w, c.high, c.low)), [
      WideLiteral(upper(widths().get(c.w).name), c.high, c.low),
    ]))
}

test "a float's bit pattern lexes back to itself, in the fewest digits that hold it" {
  let reads = |bits: Int| {
    let text = float_text(bits);
    assert_eq(Float::of_string(String::of_bytes(text)).map(bits_of_float), Some(bits));
    text
  };
  [
    bits_of_float(0.1),
    bits_of_float(1e300),
    bits_of_float(1.0),
    bits_of_float(123456789.0),
    bits_of_float(1e22),
    bits_of_float(1e23),
    bits_of_float(2.5e-8),
    1,
    0x000FFFFFFFFFFFFF,
    0x0010000000000000,
    0x7FEFFFFFFFFFFFFF,
    0x7FF0000000000000,
    0,
  ].fold((), |u: Unit, bits: Int| {
    let text = reads(bits);
    assert_eq(tokens_of(text), [FloatLiteral(text)])
  });
  [bits_of_float(-2.5), bits_of_float(-1e-300), int_min()].fold((), |u: Unit, bits: Int| {
    let text = reads(bits);
    assert_eq(tokens_of(text), [Punctuation(b"minus"), FloatLiteral(text.slice(1, text.len()))])
  });
  assert_eq(float_text(bits_of_float(0.1)), b"0.1")
}

/// The 16 little-endian bytes of a mantissa no wider than an `Int`.
fn mantissa_of(v: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, 16).map(|i: Int| byte_of_int(if i < 8 { v >>> 8 * i & 255 } else { 0 })),
  )

test "a decimal's mantissa and scale lex back to themselves, trailing zeros and the widest among them" {
  [
    { m: 0, s: 0 },
    { m: 0, s: 2 },
    { m: 150, s: 2 },
    { m: 1, s: 28 },
    { m: 5, s: 0 },
    { m: int_max(), s: 10 },
  ].fold((), |u: Unit, c: { m: Int, s: Int }|
    match tokens_of(decimal_text(mantissa_of(c.m), c.s)) {
      [DecimalLiteral(digits, scale)] -> {
        assert_eq(int_of_digits(digits), c.m);
        assert_eq(scale, c.s)
      },
      _ -> assert(false),
    });
  let widest = Bytes::concat_all(
    range(0, 16).map(|i: Int| byte_of_int(if i < 12 { 255 } else { 0 })),
  );
  [0, 28].fold((), |u: Unit, s: Int|
    assert_eq(tokens_of(decimal_text(widest, s)), [
      DecimalLiteral(b"79228162514264337593543950335", s),
    ]))
}

test "a string, a byte string and a character lex back to their values, every escape among them" {
  let ascii = Bytes::concat_all(range(0, 128).map(|c: Int| byte_of_int(c)));
  let text = ascii.concat(b"\xc3\xa9\xf0\x9f\x98\x80");
  assert_eq(tokens_of(str_lit(text)), [StringLiteral(text)]);
  let every = Bytes::concat_all(range(0, 256).map(|c: Int| byte_of_int(c)));
  assert_eq(tokens_of(bytes_lit(every)), [BytesLiteral(every)]);
  [0, 1, 9, 10, 13, 34, 39, 65, 92, 123, 127, 233, 128512, 1114111].fold((), |u: Unit, v: Int|
    assert_eq(tokens_of(char_lit(v)), [CharLiteral(v)]))
}

test "a template's text lexes back to itself in an interpolated string, a tagged literal and around a hole" {
  let text = b"{x} }{ \"q\" \\ \n\t\x01 \xc3\xa9 end";
  let quoted = |open: Bytes, middle: Bytes| Bytes::concat_all([open, middle, b"\""]);
  assert_eq(tokens_of(quoted(b"f\"", template_text(text))), [StringLiteral(text)]);
  assert_eq(tokens_of(quoted(b"tag\"", template_text(text))), [
    Identifier(b"tag"),
    StringLiteral(text),
  ]);
  assert_eq(
    tokens_of(
      quoted(b"f\"", Bytes::concat_all([template_text(text), b"{x}", template_text(text)])),
    ),
    [InterpolatedHead(text), Identifier(b"x"), InterpolatedTail(text)],
  )
}
