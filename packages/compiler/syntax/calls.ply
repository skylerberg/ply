//! A call's arguments put where its callee's parameters are: each by position or by name, or the
//! parameter's default, copied to the call.

import compiler.syntax.parsing (Span)
import compiler.syntax.exprs (Expr, NamedArg)
import compiler.syntax.sites (placed)

/// Why a named argument fills nothing: it names no parameter, or one an argument before it filled.
pub type Unplaced = | NoSuchParameter | FilledByPosition | GivenByName

/// What a call passes a parameter: its positional argument or its named argument at a place, or
/// the parameter's default.
pub type Slot = | FromArg(Int) | FromName(Int) | FromDefault(Expr)

/// A call's arguments put where its callee's parameters are: `slots` one per parameter in order
/// where `missing` names none, the named arguments that fill nothing, and the parameters left
/// with neither an argument nor a default.
pub type Slotted = {
  slots: List<Slot>,
  unplaced: List<{ arg: NamedArg, why: Unplaced }>,
  missing: List<Bytes>,
}

/// `args` and then `named` put where a callee's parameters are, `names` each parameter's name and
/// `defaults` what a call that leaves it out passes. A default the call at `at` takes stands at a
/// place of its own there (`placed`).
pub fn slotted(
  names: List<Bytes>,
  defaults: List<Option<Expr>>,
  args: List<Expr>,
  named: List<NamedArg>,
  at: Span,
) -> Slotted = {
  let index = |name: Bytes|
    range(0, names.len()).fold(None, |found: Option<Int>, i: Int|
      match found {
        Some(_) -> found,
        None -> if names.at(i) == Some(name) { Some(i) } else { None },
      });
  let matched = range(0, named.len()).fold(
    { taken: [], unplaced: [] },
    |acc: { taken: List<{ at: Int, from: Int }>, unplaced: List<{ arg: NamedArg, why: Unplaced }> }, j: Int|
      match named.at(j) {
        None -> acc,
        Some(arg) -> {
          let refused = |why: Unplaced|
            { ..acc, unplaced: acc.unplaced.push({ arg: arg, why: why }) };
          match index(arg.name.name) {
            None -> refused(NoSuchParameter),
            Some(i) -> if i < args.len() { refused(FilledByPosition) }
            else if acc.taken.fold(false, |b: Bool, t: { at: Int, from: Int }| b || t.at == i) {
              refused(GivenByName)
            } else { { ..acc, taken: acc.taken.push({ at: i, from: j }) } },
          }
        },
      },
  );
  range(0, names.len()).fold(
    { slots: [], unplaced: matched.unplaced, missing: [] },
    |acc: Slotted, i: Int| {
      let by_name = matched.taken.fold(None, |found: Option<Int>, t: { at: Int, from: Int }|
        if t.at == i { Some(t.from) } else { found });
      if i < args.len() { { ..acc, slots: acc.slots.push(FromArg(i)) } } else {
        match ((by_name, defaults.at(i))) {
          (Some(j), _) -> { ..acc, slots: acc.slots.push(FromName(j)) },
          (None, Some(Some(d))) -> { ..acc, slots: acc.slots.push(FromDefault(placed(d, at, i))) },
          _ ->
            { ..acc, missing: acc.missing.push(match names.at(i) { Some(n) -> n, None -> b"" }) },
        }
      }
    },
  )
}

/// The arguments `slots` pass, out of a call's `args` and `named`.
pub fn slot_args(slots: List<Slot>, args: List<Expr>, named: List<NamedArg>) -> List<Expr> =
  slots.fold([], |acc: List<Expr>, slot: Slot|
    match slot {
      FromArg(i) -> match args.at(i) { Some(x) -> acc.push(x), None -> acc },
      FromName(j) -> match named.at(j) { Some(n) -> acc.push(n.value), None -> acc },
      FromDefault(d) -> acc.push(d),
    })
