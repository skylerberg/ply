import compiler.syntax.parsing (Span)
import compiler.syntax.expressions (Expression, NamedArg)
import compiler.syntax.node_ids (placed)

pub type UnmatchedReason = | NoSuchParameter | FilledByPosition | GivenByName

pub type Slot = | FromArg(Int) | FromName(Int) | FromDefault(Expression)

pub type ArgumentSlots = {
  slots: List<Slot>,
  unplaced: List<{ arg: NamedArg, reason: UnmatchedReason }>,
  missing: List<Bytes>,
}

pub fn slotted(
  names: List<Bytes>,
  defaults: List<Option<Expression>>,
  args: List<Expression>,
  named: List<NamedArg>,
  at: Span,
) -> ArgumentSlots = {
  let index = |name: Bytes|
    range(0, names.len()).fold(None, |found: Option<Int>, i: Int|
      match found {
        Some(_) -> found,
        None -> if names.at(i) == Some(name) { Some(i) } else { None },
      });
  let matched = range(0, named.len()).fold(
    { taken: [], unplaced: [] },
    |acc: { taken: List<{ at: Int, from: Int }>, unplaced: List<{ arg: NamedArg, reason: UnmatchedReason }> }, j: Int|
      match named.at(j) {
        None -> acc,
        Some(arg) -> {
          let rejected = |reason: UnmatchedReason|
            { ..acc, unplaced: acc.unplaced.push({ arg: arg, reason: reason }) };
          match index(arg.name.name) {
            None -> rejected(NoSuchParameter),
            Some(i) -> if i < args.len() { rejected(FilledByPosition) }
            else if acc.taken.fold(false, |b: Bool, t: { at: Int, from: Int }| b || t.at == i) {
              rejected(GivenByName)
            } else { { ..acc, taken: acc.taken.push({ at: i, from: j }) } },
          }
        },
      },
  );
  range(0, names.len()).fold(
    { slots: [], unplaced: matched.unplaced, missing: [] },
    |acc: ArgumentSlots, i: Int| {
      let by_name = matched.taken.fold(None, |found: Option<Int>, t: { at: Int, from: Int }|
        if t.at == i { Some(t.from) } else { found });
      if i < args.len() { { ..acc, slots: acc.slots.push(FromArg(i)) } } else {
        match ((by_name, defaults.at(i))) {
          (Some(j), _) -> { ..acc, slots: acc.slots.push(FromName(j)) },
          (None, Some(Some(d))) -> { ..acc, slots: acc.slots.push(FromDefault(placed(d, at, i))) },
          _ ->
            { ..acc, missing: acc.missing.push(match names.at(i) { Some(n) -> n, None -> b"" }) },
        }
      }
    },
  )
}

pub fn ordered_arguments(
  slots: List<Slot>,
  args: List<Expression>,
  named: List<NamedArg>,
) -> List<Expression> =
  slots.fold([], |acc: List<Expression>, slot: Slot|
    match slot {
      FromArg(i) -> match args.at(i) { Some(x) -> acc.push(x), None -> acc },
      FromName(j) -> match named.at(j) { Some(n) -> acc.push(n.value), None -> acc },
      FromDefault(d) -> acc.push(d),
    })
