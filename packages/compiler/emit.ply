pub fn diagnostics_text(diagnostics: List<Diagnostic>) -> Bytes =
  bytes_join(
    diagnostics.map(|diagnostic: Diagnostic|
      Bytes::concat_all([diagnostic.code, b": ", diagnostic.message])),
    b"; ",
  )

fn parse_diagnostics_text(diagnostics: List<ParseDiagnostic>) -> Bytes =
  bytes_join(
    diagnostics.map(|diagnostic: ParseDiagnostic|
      Bytes::concat_all([diagnostic.code, b": ", diagnostic.message])),
    b"; ",
  )

fn wanted_names(wanted: List<RootKey>) -> Map<RootName, Bool> =
  wanted.fold(Map::new(), |m: Map<RootName, Bool>, k: RootKey| m.insert(root_name(k), true))

fn wants_root(wanted: Map<RootName, Bool>, k: RootKey) -> Bool = wanted.contains(root_name(k))

fn written_wanted(
  wanted: List<RootKey>,
) -> List<{ key: RootKey, operation: TypeOperation, ty: Type, module: Bytes }> =
  wanted.fold(
    Map::new(),
    |m: Map<RootName, { key: RootKey, operation: TypeOperation, ty: Type, module: Bytes }>, k: RootKey|
      match k {
        Generated(w, _) ->
          m.insert(root_name(k), {
            key: k,
            operation: w.operation,
            ty: w.ty,
            module: module_of(k),
          }),
        _ -> m,
      },
  ).values(
  )

pub type LoweredProgram = {
  roots: List<Function>,
  stated: Map<Bytes, List<Bytes>>,
  constructors: Constructors,
  borrowed: Map<RootName, List<Int>>,
  ownership_signatures: Map<RootName, OwnershipSignature>,
}

pub fn emit_program(
  given: List<Source>,
  constructors: Constructors,
  release: Bool,
  roots: List<RootKey>,
  packages: List<PackageDependencies>,
  placed: List<Int>,
  embeds: List<ModuleEmbed>,
  rows: Rows,
  effects: List<EffectRow>,
  walked: Bytes,
  published: List<PublishedSignature> = [],
) -> List<EmittedRoot> / {abort.raise} =
  emitted_program(
    lowered_program(
      given,
      constructors,
      release,
      roots,
      packages,
      placed,
      embeds,
      rows,
      effects,
      walked,
      published,
    ),
  )

pub fn emitted_program(w: LoweredProgram) -> List<EmittedRoot> / {abort.raise} = {
  let resolved = infer_signatures(
    inference_targets_of(w.borrowed, w.roots),
    w.ownership_signatures,
    w.borrowed,
  );
  roots_emitted(w.roots, resolved, w.stated, w.constructors, 0, w.roots.len(), 64)
}

fn roots_emitted(
  roots: List<Function>,
  resolved: InferenceResult,
  stated: Map<Bytes, List<Bytes>>,
  constructors: Constructors,
  lo: Int,
  hi: Int,
  depth_left: Int,
) -> List<EmittedRoot> / {abort.raise} =
  if hi - lo <= 1 {
    match roots.at(lo) { Some(r) -> [root_emitted(r, resolved, stated, constructors)], None -> [] }
  } else if depth_left <= 0 {
    panic(
      "internal compiler error: dividing the list of roots in two for parallel work recursed too deep",
    )
  } else {
    let mid = lo + (hi - lo) / 2;
    let both = parallel {
      roots_emitted(roots, resolved, stated, constructors, lo, mid, depth_left - 1),
      roots_emitted(roots, resolved, stated, constructors, mid, hi, depth_left - 1),
    };
    both._0.concat(both._1)
  }

fn root_emitted(
  f: Function,
  resolved: InferenceResult,
  stated: Map<Bytes, List<Bytes>>,
  constructors: Constructors,
) -> EmittedRoot / {abort.raise} = {
  let l = inferred_function(f, resolved);
  let e = with_instance_calls(stated, tags_in(l.form), emitted_of(l.form, constructors));
  { ..e, tables: { ..e.tables, handings: l.own_signatures, assumed: l.assumed, group: l.group } }
}

fn lowered_program(
  given: List<Source>,
  constructors: Constructors,
  release: Bool,
  roots: List<RootKey>,
  packages: List<PackageDependencies>,
  placed: List<Int>,
  embeds: List<ModuleEmbed>,
  rows: Rows,
  effects: List<EffectRow>,
  walked: Bytes,
  published: List<PublishedSignature>,
) -> LoweredProgram / {abort.raise} =
  lowered_in(
    scope_of(given, constructors, release, roots, packages, placed, embeds, rows, effects, walked),
    roots,
    signatures_from(published),
  )

pub type Scope = {
  modules: List<ParsedModule>,
  places: Map<Bytes, Int>,
  module_scopes: List<ModuleScope>,
  resolved: Resolution,
  schemes: Map<Bytes, Scheme>,
  owned: Map<Bytes, BodyFacts>,
  reading: Map<Bytes, Bool>,
  declared_operations: Map<Bytes, List<Bytes>>,
  constructors: Constructors,
  builtins: List<Bytes>,
  machine: Map<Bytes, MachineCall>,
  release_build: Bool,
  declared: Map<Bytes, Scheme>,
  borrowed: Map<RootName, List<Int>>,
  hosts: Map<Bytes, HostHandler>,
  test_effects: Map<Bytes, List<Effect>>,
}

pub type HostHandler = { call: Bytes, import: Imported }

pub type ModuleScope = {
  here: List<Definition>,
  imports: List<Imported>,
  effects: List<EffectName>,
}

pub fn root_outputs(
  s: Scope,
  roots: List<RootKey>,
  ownership_signatures: Map<RootName, OwnershipSignature>,
) -> List<RootOutput> / {abort.raise} = results_of(lowered_in(s, roots, ownership_signatures))

pub fn scope_of(
  given: List<Source>,
  constructors: Constructors,
  release: Bool,
  roots: List<RootKey>,
  packages: List<PackageDependencies>,
  placed: List<Int>,
  embeds: List<ModuleEmbed>,
  rows: Rows,
  effects: List<EffectRow>,
  walked: Bytes,
  derived: List<ModuleDerivations> = [],
) -> Scope / {abort.raise} = {
  let sources = with_prelude_source(given);
  let module_packages = if sources.len() == given.len() || packages.len() == 0 { placed }
  else { placed.push(packages.len()) };
  let tables = embed_tables(embeds);
  let parsed = range(0, sources.len()).map(|i: Int| {
    let s = match sources.at(i) { Some(x) -> x, None -> { name: b"", source_text: b"" } };
    let taken = match derived.find(|m: ModuleDerivations| m.module == s.name) {
      Some(m) -> m.derivations,
      None -> [],
    };
    let p = parse_from(i, s, parse(s.source_text), derivations: taken);
    let e = inline_embeds_by_name(tables, s.name, p.module.module);
    if p.diagnostics.len() > 0 { unread(diagnostics_text(p.diagnostics)) }
    else if e.diagnostics.len() > 0 { unread(parse_diagnostics_text(e.diagnostics)) }
    else { { ..p.module, module: e.module } }
  });
  let packaged = if packages.len() == 0 { no_packages(parsed) } else {
    {
      packages: packages,
      module_packages: module_packages,
      std: packages.len() - 2,
      compiler: packages.len() - 1,
      other_shipped_package: packages.len(),
    }
  };
  let x = match resolve_packaged(
      parsed,
      packaged.packages,
      packaged.module_packages,
      packaged.std,
      packaged.compiler,
      packaged.other_shipped_package,
    ) {
    ResolveFailed(diagnostics) -> unread(diagnostics_text(diagnostics)),
    ResolveSucceeded(x) -> x,
  };
  let schemes = rows.definitions.fold(
    Map::new(),
    |accumulator: Map<Bytes, Scheme>, row: KnownDefinitionRow|
      accumulator.insert(row.name, row.scheme),
  );
  let w = match decode_inferred_facts(walked) {
    Some(w) -> w,
    None ->
      unread(
        b"the check result could not be decoded, so the inferred types and effects are missing",
      ),
  };
  let pure = w.pure.fold(Map::new(), |accumulator: Map<Bytes, Bool>, n: Bytes|
    accumulator.insert(n, true));
  let reading = owners_to_read(rows, roots);
  let every = x.modules.fold(Map::new(), |accumulator: Map<Bytes, Bool>, m: ParsedModule|
    accumulator.insert(m.name, true));
  let facts = match facts_read(rows, w, Some({ roots: reading, modules: every }), x.modules) {
    Ok(f) -> f,
    Err(reason) -> unread(reason),
  };
  let modules = x.modules;
  let values = constant_values(rows);
  let program = modules.fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Definition>>, m: ParsedModule|
      accumulator.insert(m.name, definitions_in(m.name, m.module, pure, schemes, values)),
  );
  let definitions_of = |path: Bytes| match program.get(path) { Some(ds) -> ds, None -> [] };
  let members = facts.members.fold(
    Map::new(),
    |accumulator: Map<Int, List<MemberSite>>, s: MemberSite|
      accumulator.insert(
        s.module,
        List::push(match accumulator.get(s.module) { Some(xs) -> xs, None -> [] }, s),
      ),
  );
  let natives = parsed_natives(modules);
  let declared = declared_effects(x.resolution, published_operations(effects));
  {
    modules: modules,
    places: range(0, modules.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
      accumulator.insert(modules.get(i).name, i)),
    module_scopes: range(0, modules.len()).map(|i: Int| {
      let m = modules.get(i);
      {
        here: definitions_of(m.name),
        imports: resolved_imports(
          x.resolution,
          i,
          modules,
          m.module,
          definitions_of,
          match members.get(i) { Some(xs) -> xs, None -> [] },
        ).concat(
          scheduler_imported(definitions_of),
        ),
        effects: declared,
      }
    }),
    resolved: x.resolution,
    schemes: schemes,
    owned: facts_by_owner(facts),
    reading: reading,
    declared_operations: stated_by_tag(modules),
    constructors: {
      ..constructors,
      keyed: keyed_tags(modules).fold(constructors.keyed, |accumulator: List<Bytes>, k: Bytes|
        if accumulator.contains(k) { accumulator } else { accumulator.push(k) }),
    },
    builtins: natives.map(|e: Extern| e.name),
    machine: machine_calls(natives),
    release_build: release,
    declared: declared_schemes(),
    borrowed: program.fold(
      Map::new(),
      |m: Map<RootName, List<Int>>, module: Bytes, definitions: List<Definition>|
        declared_borrows(m, module, definitions),
    ),
    hosts: with_prelude_handlers(host_handlers(modules, definitions_of), definitions_of),
    test_effects: rows.tests.fold(Map::new(), |m: Map<Bytes, List<Effect>>, r: KnownTestRow|
      match read_effects(r.effects) { Some(xs) -> m.insert(r.key, xs), None -> m }),
  }
}

fn unread<a>(reason: Bytes) -> a / {abort.raise} =
  panic(
    String::of_bytes_lossy(
      b"the emitter cannot read the program the front end checked: ".concat(reason),
    ),
  )

fn host_handlers(
  modules: List<ParsedModule>,
  definitions_of: (Bytes) -> List<Definition>,
) -> Map<Bytes, HostHandler> / {abort.raise} =
  modules.fold(Map::new(), |accumulator: Map<Bytes, HostHandler>, m: ParsedModule|
    m.module.items.fold(accumulator, |handlers: Map<Bytes, HostHandler>, item: Item|
      match item {
        InstanceItem(d) -> if d.kind != HostInstance { handlers } else {
          let served = qualify(m.name, d.target.name);
          match definitions_of(m.name).find(|definition: Definition|
              definition.name == d.function.name) {
            None ->
              unread(
                Bytes::concat_all([
                  b"the host handler `",
                  d.function.name,
                  b"` of `",
                  served,
                  b"` is no definition",
                ]),
              ),
            Some(definition) ->
              handlers.insert(served, {
                call: qualify(m.name, d.function.name),
                import: { name: served, module: m.name, definitions: [definition], whole: true },
              }),
          }
        },
        _ -> handlers,
      }))

fn with_prelude_handlers(
  hosts: Map<Bytes, HostHandler>,
  definitions_of: (Bytes) -> List<Definition>,
) -> Map<Bytes, HostHandler> =
  prelude_hosts().fold(
    hosts,
    |accumulator: Map<Bytes, HostHandler>, h: { effect: Bytes, module: Bytes, by: Bytes }|
      match definitions_of(h.module).find(|d: Definition| d.name == h.by) {
        None -> accumulator,
        Some(definition) ->
          accumulator.insert(h.effect, {
            call: qualify(h.module, h.by),
            import: {
              name: qualify(h.module, h.effect),
              module: h.module,
              definitions: [definition],
              whole: true,
            },
          }),
      },
  )

fn handlers_for(
  hosts: Map<Bytes, HostHandler>,
  effects: List<Bytes>,
) -> List<{ effect: Bytes, hosting: HostHandler }> =
  effects.fold([], |accumulator: List<Bytes>, e: Bytes|
    if accumulator.contains(e) || !hosts.contains(e) { accumulator }
    else { accumulator.push(e) }).sort_by(|a: Bytes, b: Bytes|
    match compare_values(a, b) { Greater -> false, _ -> true }).fold(
    [],
    |accumulator: List<{ effect: Bytes, hosting: HostHandler }>, e: Bytes|
      match hosts.get(e) {
        Some(h) -> accumulator.push({ effect: e, hosting: h }),
        None -> accumulator,
      },
  )

pub fn lowered_in(
  s: Scope,
  roots: List<RootKey>,
  ownership_signatures: Map<RootName, OwnershipSignature>,
) -> LoweredProgram / {abort.raise} = {
  let wanted = wanted_names(roots);
  let touched = roots.fold(Map::new(), |accumulator: Map<Bytes, Bool>, k: RootKey|
    match definition_root(k) { Some(d) -> accumulator.insert(d, true), None -> accumulator });
  let lowered = modules_lowered(roots);
  let specialised = specialisations_wanted(roots);
  let borrowed_by = specialised.fold(
    Map::new(),
    |accumulator: Map<RootName, Option<BoundLambda>>, _: Bytes, sps: List<RootKey>|
      sps.fold(
        accumulator,
        |borrowed_lambdas: Map<RootName, Option<BoundLambda>>, specialisation: RootKey|
          inlined_lambdas(specialisation).fold(
            borrowed_lambdas,
            |h: Map<RootName, Option<BoundLambda>>, f: InlinedLambda| {
              let name = root_name(f.owner);
              if h.contains(name) { h } else { h.insert(name, owner_lambdas(s, f.owner)) }
            },
          ),
      ),
  );
  let forming = {
    scope: s,
    wanted: wanted,
    touched: touched,
    specialised: specialised,
    written: written_wanted(roots),
    borrowed_by: borrowed_by,
  };
  let lowering = range(0, s.modules.len()).filter(|i: Int|
    match s.modules.at(i) { Some(m) -> lowered.contains(m.name), None -> false });
  {
    roots: modules_formed(forming, lowering, 0, lowering.len(), 64),
    stated: s.declared_operations,
    constructors: s.constructors,
    borrowed: s.borrowed,
    ownership_signatures: ownership_signatures,
  }
}

type FormInputs = {
  scope: Scope,
  wanted: Map<RootName, Bool>,
  touched: Map<Bytes, Bool>,
  specialised: Map<Bytes, List<RootKey>>,
  written: List<{ key: RootKey, operation: TypeOperation, ty: Type, module: Bytes }>,
  borrowed_by: Map<RootName, Option<BoundLambda>>,
}

fn modules_formed(
  f: FormInputs,
  lowering: List<Int>,
  lo: Int,
  hi: Int,
  depth_left: Int,
) -> List<Function> / {abort.raise} =
  if hi - lo <= 1 { match lowering.at(lo) { Some(i) -> module_at_formed(f, i), None -> [] } }
  else if depth_left <= 0 {
    panic(
      "internal compiler error: dividing the list of modules in two for parallel work recursed too deep",
    )
  } else {
    let mid = lo + (hi - lo) / 2;
    let both = parallel {
      modules_formed(f, lowering, lo, mid, depth_left - 1),
      modules_formed(f, lowering, mid, hi, depth_left - 1),
    };
    both._0.concat(both._1)
  }

fn module_at_formed(f: FormInputs, i: Int) -> List<Function> / {abort.raise} =
  match f.scope.modules.at(i) {
    None -> [],
    Some(m) -> {
      let tab = module_scope(f.scope, i);
      module_formed(
        m.module,
        {
          module: m.name,
          definitions: tab.here,
          imports: tab.imports,
          constructors: f.scope.constructors,
          builtins: f.scope.builtins,
          declared: f.scope.declared,
          machine: f.scope.machine,
          effects: tab.effects,
          release_build: f.scope.release_build,
        },
        f,
        f.written.filter(
          |w: { key: RootKey, operation: TypeOperation, ty: Type, module: Bytes }|
            w.module == m.name,
        ).map(|w: { key: RootKey, operation: TypeOperation, ty: Type, module: Bytes }|
          { key: w.key, operation: w.operation, ty: w.ty }),
      )
    },
  }

fn module_scope(s: Scope, i: Int) -> ModuleScope =
  match s.module_scopes.at(i) { Some(t) -> t, None -> { here: [], imports: [], effects: [] } }

fn lambda_in(
  s: Scope,
  borrowed_by: Map<RootName, Option<BoundLambda>>,
  owner: RootKey,
  nth: Int,
) -> Option<BoundLambda> / {abort.raise} =
  match match borrowed_by.get(root_name(owner)) { Some(o) -> o, None -> owner_lambdas(s, owner) } {
    None -> None,
    Some(o) -> match o.written.at(nth) {
      None -> None,
      Some(code) -> Some({ ..o, nth: nth, code: code }),
    },
  }

fn owner_lambdas(s: Scope, owner: RootKey) -> Option<BoundLambda> / {abort.raise} = {
  let modules = s.modules;
  let schemes = s.schemes;
  let module_at = |i: Int| module_scope(s, i);
  let recorded_of = |o: Bytes| recorded_annotations(s.owned, o);
  let of = match owner {
    Specialisation(a, _) ->
      { base: a.definition, args: key_types(owner), allows_lambda_inlining: a.borrowed.len() == 0 },
    _ -> { base: site_owner_text(owner), args: [], allows_lambda_inlining: true },
  };
  let module = module_of(owner);
  let short = default_binder(of.base);
  let borrowed = |i: Int, m: ParsedModule, code: Code, base: Int| {
    let tab = module_at(i);
    let emitted = known_body(root_text(root_name(owner)), [], code);
    let written = lambdas_of(emitted).concat(named_in(m.name, tab.here, tab.imports, emitted));
    match written.at(0) {
      Some(first) ->
        Some({
          owner: owner,
          nth: 0,
          code: first,
          module: m.name,
          module_definitions: tab.here,
          imports: tab.imports,
          effects: tab.effects,
          base: base,
          written: written,
        }),
      None -> None,
    }
  };
  match s.places.get(module) {
    None -> None,
    Some(i) -> {
      let m = modules.get(i);
      match m.module.items.fold(None, |accumulator: Option<FnDefinition>, item: Item|
          match item {
            FunctionItem(d) -> if d.name.name == short && of.allows_lambda_inlining { Some(d) }
            else { accumulator },
            _ -> accumulator,
          }) {
        None -> match m.module.items.fold(
            None,
            |accumulator: Option<TestDefinition>, item: Item|
              match item {
                TestItem(t) -> if test_key(m.name, t.name) == owner { Some(t) }
                else { accumulator },
                _ -> accumulator,
              },
          ) {
          None -> None,
          Some(t) -> {
            let recorded = recorded_of(site_owner_text(owner));
            borrowed(i, m, root_body(recorded, TestRun, t.span.start, [], []).code, t.span.start)
          },
        },
        Some(d) -> {
          let recorded = recorded_of(of.base);
          borrowed(
            i,
            m,
            root_body(recorded, WholeBody, d.span.start, labels_of(d), of.args).code,
            d.span.start,
          )
        },
      }
    },
  }
}

fn owners_to_read(rows: Rows, roots: List<RootKey>) -> Map<Bytes, Bool> =
  roots.fold(
    rows.definitions.fold(Map::new(), |accumulator: Map<Bytes, Bool>, row: KnownDefinitionRow|
      if row.facts.len() == 0 { accumulator } else { accumulator.insert(row.name, true) }),
    |accumulator: Map<Bytes, Bool>, k: RootKey|
      inlined_lambdas(k).fold(
        accumulator.insert(site_owner_text(k), true).insert(site_owner_text(parent_root(k)), true),
        |r: Map<Bytes, Bool>, f: InlinedLambda| r.insert(site_owner_text(f.owner), true),
      ),
  )

fn parent_root(k: RootKey) -> RootKey =
  match k { Clause(c) -> c.definition, TestCases(t) -> t, _ -> k }

fn definition_root(k: RootKey) -> Option<Bytes> =
  match k {
    Named(n) -> Some(n),
    Specialisation(a, _) -> Some(a.definition),
    EntryPoint(e) -> definition_root(e),
    Clause(c) -> definition_root(c.definition),
    _ -> None,
  }

fn keyed_tags(modules: List<ParsedModule>) -> List<Bytes> =
  modules.fold([], |accumulator: List<Bytes>, m: ParsedModule|
    m.module.items.fold(accumulator, |a: List<Bytes>, item: Item|
      match item {
        InstanceItem(d) -> if d.kind != KeyInstance { a }
        else { a.concat(with_stated(m, Map::new(), d.target.name, [d.function.name]).keys()) },
        _ -> a,
      }))

fn stated_by_tag(modules: List<ParsedModule>) -> Map<Bytes, List<Bytes>> =
  modules.fold(Map::new(), |accumulator: Map<Bytes, List<Bytes>>, m: ParsedModule|
    m.module.items.fold(accumulator, |a: Map<Bytes, List<Bytes>>, item: Item|
      match item {
        InstanceItem(d) -> if d.kind == InvariantInstance || d.kind == HostInstance { a }
        else { with_stated(m, a, d.target.name, [d.function.name]) },
        NumericItem(d) ->
          with_stated(m, a, d.target.name, d.operations.map(|x: NumericOperation| x.by.name)),
        _ -> a,
      }))

fn with_stated(
  m: ParsedModule,
  stated: Map<Bytes, List<Bytes>>,
  target: Bytes,
  functions: List<Bytes>,
) -> Map<Bytes, List<Bytes>> =
  m.module.items.fold(stated, |b: Map<Bytes, List<Bytes>>, other: Item|
    match other {
      TypeItem(t) -> if t.name.name != target { b } else {
        match t.body {
          SumBody(variants) ->
            variants.fold(b, |c: Map<Bytes, List<Bytes>>, v: VariantDefinition| {
              let tag = qualify(m.name, v.name.name);
              c.insert(
                tag,
                functions.fold(
                  match c.get(tag) { Some(fs) -> fs, None -> [] },
                  |fs: List<Bytes>, f: Bytes| fs.push(qualify(m.name, f)),
                ),
              )
            }),
          _ -> b,
        }
      },
      _ -> b,
    })

fn tags_in(f: Function) -> List<Bytes> =
  f.lambdas.fold(block_tags([], f.body), |accumulator: List<Bytes>, l: typed_ir::Lambda|
    match l {
      typed_ir::Closure(c) ->
        tags_in(c.body).fold(accumulator, |a: List<Bytes>, t: Bytes|
          if a.contains(t) { a } else { a.push(t) }),
    })

fn block_tags(accumulator: List<Bytes>, b: typed_ir::Block) -> List<Bytes> =
  b.fold(accumulator, |a: List<Bytes>, i: typed_ir::Instruction|
    match i {
      typed_ir::Let(l) -> match l.value {
        typed_ir::Tag(name) -> if a.contains(name) { a } else { a.push(name) },
        _ -> a,
      },
      typed_ir::If(x) -> block_tags(block_tags(a, x.then), x.otherwise),
      typed_ir::Case(c) ->
        c.arms.fold(
          block_tags(a, c.rest),
          |n: List<Bytes>, arm: { when: Int, body: typed_ir::Block }| block_tags(n, arm.body),
        ),
      typed_ir::Match(m) -> m.arms.fold(block_tags(a, m.rest), block_tags),
      typed_ir::Loop(l) -> block_tags(a, l.body),
      typed_ir::Handle(h) -> block_tags(a, h.body),
      _ -> a,
    })

fn with_instance_calls(
  stated: Map<Bytes, List<Bytes>>,
  tags: List<Bytes>,
  e: EmittedRoot,
) -> EmittedRoot =
  if stated.len() == 0 { e } else {
    {
      ..e,
      tables: {
        ..e.tables,
        calls: tags.fold(e.tables.calls, |accumulator: List<RootKey>, tag: Bytes|
          match stated.get(tag) {
            None -> accumulator,
            Some(fs) ->
              fs.fold(accumulator, |calls: List<RootKey>, f: Bytes|
                if calls.contains(Named(f)) { calls } else { calls.push(Named(f)) }),
          }),
      },
    }
  }

fn module_formed(
  module_tree: Module,
  s: ModuleContext,
  f: FormInputs,
  written_roots: List<{ key: RootKey, operation: TypeOperation, ty: Type }>,
) -> List<Function> / {abort.raise} = {
  let module = s.module;
  let here = s.definitions;
  let definitions = module_tree.items.fold(Map::new(), |m: Map<Bytes, FnDefinition>, item: Item|
    match item { FunctionItem(d) -> m.insert(qualify(module, d.name.name), d), _ -> m });
  let order = module_tree.items.fold(Map::new(), |m: Map<Bytes, Int>, item: Item|
    match item { FunctionItem(d) -> m.insert(qualify(module, d.name.name), m.len()), _ -> m });
  let walked = distinct_forms(
    items_formed(
      {
        module_tree: module_tree,
        s: s,
        f: f,
        definitions: definitions,
        order: order,
        written_roots: written_roots,
      },
      0,
      module_tree.items.len(),
      64,
    ),
  );
  walked.concat(
    written_at_once(
      { module_context: s, items: module_tree.items },
      written_roots,
      0,
      written_roots.len(),
      64,
    ),
  )
}

type WrittenFormInputs = { module_context: ModuleContext, items: List<Item> }

fn written_at_once(
  x: WrittenFormInputs,
  roots: List<{ key: RootKey, operation: TypeOperation, ty: Type }>,
  lo: Int,
  hi: Int,
  depth_left: Int,
) -> List<Function> / {abort.raise} =
  if hi - lo <= 1 { match roots.at(lo) { Some(w) -> written_formed(x, w), None -> [] } }
  else if depth_left <= 0 {
    panic(
      "internal compiler error: dividing the list of written roots in two for parallel work recursed too deep",
    )
  } else {
    let mid = lo + (hi - lo) / 2;
    let both = parallel {
      written_at_once(x, roots, lo, mid, depth_left - 1),
      written_at_once(x, roots, mid, hi, depth_left - 1),
    };
    both._0.concat(both._1)
  }

fn written_formed(
  x: WrittenFormInputs,
  w: { key: RootKey, operation: TypeOperation, ty: Type },
) -> List<Function> / {abort.raise} =
  naming(root_text(root_name(w.key)), || {
    let s = x.module_context;
    let module = s.module;
    let here = s.definitions;
    let module_tree = { items: x.items };
    let check_calls_loaded = || {
      let unreached = emitted_code().calls.filter(|n: Bytes|
        match definition_in(module, here, s.imports, n) { Some(_) -> false, None -> true });
      if unreached.len() > 0 {
        panic(
          String::of_bytes_lossy(
            b"generated code for a container calls `std.prelude` definitions that were not loaded: ".concat(
              Bytes::join(unreached, b", "),
            ),
          ),
        )
      }
    };
    let written_root = |key: RootKey, e: GeneratedRoot|
      root_from_code(
        { ..s, definitions: here.concat(e.definitions) },
        0,
        key,
        e.params,
        e.code,
        e.performs,
      );
    let r = { key: w.key, operation: operation_name(w.operation), ty: w.ty };
    let reflective = match w.operation {
      Reflect -> true,
      Show -> true,
      Digest -> true,
      _ -> false,
    };
    let contained = match w.operation {
      ContainerWalk(c) -> container_operation_generated(c),
      _ -> reflective && (is_walked_container(r.ty) || is_columns_type(r.ty)),
    };
    if is_plain_written(w.operation) {
      [
        match w.operation {
          keys::OnWordForm(_) -> serialization_function(s.constructors, w.key),
          _ -> generated(s.constructors, w.key),
        },
      ]
    } else if is_marshal_operation(w.operation) {
      if is_walked_container(r.ty) { check_calls_loaded() };
      [written_root(r.key, marshal_root(module, s.constructors, r.key))]
    } else if contained {
      check_calls_loaded();
      [written_root(r.key, container_code(module, s.constructors, r.operation, r.ty))]
    } else if w.operation == keys::ReleaseResource {
      [written_root(r.key, release_resource_code(module, s.constructors, here, r.key, r.ty))]
    } else if w.operation == ContainerWalk(b"let_go_items") {
      [written_root(r.key, release_items_code(module, s.constructors, r.key, r.ty))]
    } else if w.operation == keys::Equal || w.operation == Order {
      let representation = kind_of(w.ty);
      let param = |n: Bytes|
        { name: n, kind: representation.kind, ty: representation.ty, of: Some(w.ty), lambda: None };
      let formed = |code: Code| [root_from_code(s, 0, w.key, [param(b"a"), param(b"b")], code)];
      match built_in_cases(s.constructors, w.ty) {
        None -> if is_sum(s.constructors, w.ty) { [] } else {
          formed(if w.operation == keys::Equal { compared_code(w.ty) } else { ordered_code(w.ty) })
        },
        Some(cs) ->
          formed(if w.operation == keys::Equal { equality_code(w.ty, cs) }
          else { ordering_code(w.ty, cs) }),
      }
    } else if !reflective { [] } else {
      let code = if r.operation == b"digest" {
        digest_code(module, s.constructors, here, module_tree.items, r.ty)
      } else {
        reflection_code(
          module,
          s.constructors,
          here,
          module_tree.items,
          r.operation == b"shown",
          r.ty,
        )
      };
      let representation = kind_of(r.ty);
      [
        root_from_code(
          s,
          0,
          r.key,
          [
            {
              name: b"a",
              kind: representation.kind,
              ty: representation.ty,
              of: Some(r.ty),
              lambda: None,
            },
          ],
          code,
        ),
      ]
    }
  })

fn is_sum(constructors: Constructors, ty: Type) -> Bool =
  match ty { NamedType(c) -> constructors.sums.get(c.name) != None, _ -> false }

fn built_in_cases(constructors: Constructors, ty: Type) -> Option<List<SumConstructor>> =
  match ty {
    NamedType(c) -> if c.name.index_of(b".") != None { None } else {
      match constructors.sums.get(c.name) {
        Some(declared) ->
          Some(if c.args.len() == 0 { declared } else {
            declared.map(|k: SumConstructor|
              { ..k, fields: k.fields.map(|f: Type| at_args(f, k.params, c.args)) })
          }),
        None -> None,
      }
    },
    _ -> None,
  }

fn is_plain_written(operation: TypeOperation) -> Bool =
  match operation {
    keys::Drop -> true,
    keys::Dup -> true,
    keys::Release -> true,
    keys::Copy -> true,
    keys::Share -> true,
    keys::Keep -> true,
    keys::OnCase(_) -> true,
    keys::OnWordForm(_) -> true,
    keys::Unboxed(_) -> true,
    _ -> false,
  }

type RootForms = { out: List<Function> }

type ItemFormInputs = {
  module_tree: Module,
  s: ModuleContext,
  f: FormInputs,
  definitions: Map<Bytes, FnDefinition>,
  order: Map<Bytes, Int>,
  written_roots: List<{ key: RootKey, operation: TypeOperation, ty: Type }>,
}

fn distinct_forms(forms: List<Function>) -> List<Function> =
  forms.fold(
    { seen: Map::new(), out: [] },
    |accumulator: { seen: Map<RootName, Bool>, out: List<Function> }, r: Function|
      if accumulator.seen.contains(root_name(r.key)) { accumulator } else {
        { seen: accumulator.seen.insert(root_name(r.key), true), out: accumulator.out.push(r) }
      },
  ).out

fn items_formed(
  x: ItemFormInputs,
  lo: Int,
  hi: Int,
  depth_left: Int,
) -> List<Function> / {abort.raise} =
  if hi - lo <= 4 {
    range(lo, hi).fold({ out: [] }, |accumulator: RootForms, i: Int|
      match x.module_tree.items.at(i) {
        Some(item) -> item_formed(x, accumulator, item),
        None -> accumulator,
      }).out
  } else if depth_left <= 0 {
    panic(
      "internal compiler error: dividing the list of items in two for parallel work recursed too deep",
    )
  } else {
    let mid = lo + (hi - lo) / 2;
    let both = parallel {
      items_formed(x, lo, mid, depth_left - 1),
      items_formed(x, mid, hi, depth_left - 1),
    };
    both._0.concat(both._1)
  }

fn item_formed(x: ItemFormInputs, accumulator: RootForms, item: Item) -> RootForms / {abort.raise} =
  naming(item_owner(x.s.module, item), || add_item_forms(x, accumulator, item))

fn add_item_forms(
  x: ItemFormInputs,
  accumulator: RootForms,
  item: Item,
) -> RootForms / {abort.raise} = {
  let s = x.s;
  let f = x.f;
  let module = s.module;
  let schemes = f.scope.schemes;
  let wanted = f.wanted;
  let touched = f.touched;
  let specialised = f.specialised;
  let reading = f.scope.reading;
  let definitions = x.definitions;
  let order = x.order;
  let here = s.definitions;
  let module_tree = x.module_tree;
  let written_roots = x.written_roots;
  let recorded_of = |owner: Bytes| recorded_annotations(f.scope.owned, owner);
  let lambda_at = |owner: RootKey, nth: Int| lambda_in(f.scope, f.borrowed_by, owner, nth);
  let read_of = |full: Bytes|
    match if reading.contains(full) { definitions.get(full) } else { None } {
      None -> None,
      Some(d) -> {
        let recorded = recorded_of(full);
        Some({
          code: root_body(recorded, WholeBody, d.span.start, labels_of(d), []).code,
          recorded: recorded,
        })
      },
    };
  let looped = |out: List<Function>, key: RootKey| {
    let keys = tail_loop_of(s, order, read_of, key);
    if keys.len() < 2 { None }
    else if out.any(|r: Function| root_name(r.key) == root_name(keys.get(0))) { Some(out) }
    else { Some(out.concat(tail_loop_lowered(s, schemes, definitions, read_of, keys))) }
  };
  match item {
    FunctionItem(d) -> if !touched.contains(qualify(module, d.name.name)) { accumulator } else {
      let full = qualify(module, d.name.name);
      let p = { full: full, base: d.span.start, recorded: recorded_of(full) };
      let specialisations = (match specialised.get(p.full) { Some(l) -> l, None -> [] }).fold(
        accumulator.out,
        |a: List<Function>, specialisation: RootKey|
          match if inlined_lambdas(specialisation).len() > 0 { None }
            else { looped(a, specialisation) } {
            Some(out) -> out,
            None -> a.push(specialised_lowered(s, d, specialisation, lambda_at, p.recorded)),
          },
      );
      let out = if !wants_root(wanted, Named(p.full)) { specialisations } else {
        match looped(specialisations, Named(p.full)) {
          Some(o) -> o,
          None -> {
            let b = root_body(p.recorded, WholeBody, p.base, labels_of(d), []);
            specialisations.push(root_from_code(s, p.base, Named(p.full), b.params, b.code))
          },
        }
      };
      clause_roots(
        { out: with_entry(s, wanted, f.scope.hosts, Named(p.full), schemes.get(p.full), out) },
        d,
        s,
        wanted,
        p.recorded,
        schemes,
      )
    },
    TestItem(t) -> {
      let tested = test_key(module, t.name);
      let recorded = || recorded_of(site_owner_text(tested));
      let ps = if t.cases == None { [] } else {
        [
          {
            name: case_index_binder(),
            kind: IntKind,
            ty: OpenShape([]),
            of: Some(int_type()),
            lambda: None,
          },
          {
            name: case_identity(),
            kind: BoxedKind,
            ty: BytesShape,
            of: Some(bytes_type()),
            lambda: None,
          },
        ]
      };
      let rooted = |within: ModuleContext, key: RootKey, part: BodyPart| {
        let f = recorded();
        let b = root_body(f, part, t.span.start, [], []);
        root_from_code(within, t.span.start, key, b.params, b.code)
      };
      let performs = {
        listed: match f.scope.test_effects.get(qualify(module, t.name)) {
          Some(xs) -> xs,
          None -> [],
        },
        variable: None,
      };
      let ran = {
        ..s,
        definitions: s.definitions.push(
          called_definition(module, tested, ps.map(param_type), unit_type(), performs, false),
        ),
      };
      let run = with_entry(
        s,
        wanted,
        f.scope.hosts,
        tested,
        Some(monomorphic(function_type(ps.map(param_type), unit_type(), performs))),
        if !wants_root(wanted, tested) { accumulator.out }
        else { accumulator.out.push(rooted(ran, tested, TestRun)) },
      );
      let listing = TestCases(tested);
      let out = match t.cases {
        None -> run,
        Some(c) -> {
          with_entry(
            s,
            wanted,
            f.scope.hosts,
            listing,
            Some(monomorphic(function_type([], listing_type(), no_effects()))),
            if !wants_root(wanted, listing) { run }
            else { run.push(rooted(s, listing, CaseListing)) },
          )
        },
      };
      { out: out }
    },
    LawItem(d) -> {
      let part = |which: LawPart| law_key(module, d.name, which);
      let is_wanted = |which: LawPart|
        wants_root(wanted, part(which)) || wants_root(wanted, EntryPoint(part(which)));
      if !is_wanted(LawGuard) && !is_wanted(LawBody) { accumulator } else {
        let recorded = recorded_of(law_owner(module, d.name));
        let rooted = |out: List<Function>, which: LawPart, body: BodyPart| {
          let b = resolved_at(recorded, body, d.span.start, []);
          let ps = root_params(b, []);
          with_claim_entry(s, wanted, part(which), ps, [], if !wants_root(wanted, part(which)) {
            out
          } else {
            out.push(root_from_code(s, d.span.start, part(which), ps, body_code(b, [], recorded)))
          })
        };
        let with_guard = match d.guard {
          None -> accumulator.out,
          Some(_) -> rooted(accumulator.out, LawGuard, typed::LawGuard),
        };
        { out: rooted(with_guard, LawBody, typed::LawBody) }
      }
    },
    TypeItem(t) -> {
      let named = qualify(module, t.name.name);
      let type_forms = written_roots.fold(
        [],
        |accumulator2: List<{ key: RootKey, operation: TypeOperation, args: List<Type> }>, w: { key: RootKey, operation: TypeOperation, ty: Type }|
          match w.ty {
            NamedType(c) -> if c.name != named { accumulator2 } else {
              match w.operation {
                keys::Equal ->
                  accumulator2.push({ key: w.key, operation: w.operation, args: c.args }),
                Order -> accumulator2.push({ key: w.key, operation: w.operation, args: c.args }),
                NumericFunction(_) ->
                  accumulator2.push({ key: w.key, operation: w.operation, args: c.args }),
                _ -> accumulator2,
              }
            },
            _ -> accumulator2,
          },
      );
      match s.constructors.sums.get(named) {
        None -> accumulator,
        Some(declared) ->
          type_forms.fold(
            accumulator,
            |a2: RootForms, d: { key: RootKey, operation: TypeOperation, args: List<Type> }| {
              let cs = if d.args.len() == 0 { declared } else {
                declared.map(|c: SumConstructor|
                  { ..c, fields: c.fields.map(|f: Type| at_args(f, c.params, d.args)) })
              };
              let compared = NamedType({
                name: named,
                args: if d.args.len() > 0 { d.args } else {
                  match declared.at(0) {
                    Some(c) -> c.params.map(|v: Int| VariableType(v)),
                    None -> [],
                  }
                },
              });
              let param = |n: Bytes, ty: Type| {
                let representation = kind_of(ty);
                {
                  name: n,
                  kind: representation.kind,
                  ty: representation.ty,
                  of: Some(ty),
                  lambda: None,
                }
              };
              let formed = |ps: List<EmitParam>, code: Code|
                root_from_code(s, t.span.start, d.key, ps, code);
              let made = match d.operation {
                NumericFunction(function_name) -> {
                  let ps = if function_name == b"of_int" { [param(b"a", int_type())] }
                  else if function_name == b"neg" { [param(b"a", compared)] }
                  else { [param(b"a", compared), param(b"b", compared)] };
                  formed(
                    ps,
                    match numeric_instance(
                        module,
                        here,
                        module_tree.items,
                        compared,
                        function_name,
                      ) {
                      Some(f) -> instance_code(f, ps.map(param_type)),
                      None ->
                        panic(
                          String::of_bytes_lossy(b"no function stated for ".concat(function_name)),
                        ),
                    },
                  )
                },
                _ -> {
                  let eq = d.operation == keys::Equal;
                  formed(
                    [param(b"a", compared), param(b"b", compared)],
                    match key_instance(module, here, module_tree.items, compared) {
                      Some(k) -> key_comparison_code(k, eq, compared),
                      None -> if eq { equality_code(compared, cs) }
                      else { ordering_code(compared, cs) },
                    },
                  )
                },
              };
              { ..a2, out: a2.out.push(made) }
            },
          ),
      }
    },
    _ -> accumulator,
  }
}

pub fn enterable(c: MarshalledSums, scheme: Scheme) -> Bool =
  scheme.label_variables.len() == 0
    && (match int_instance_type(scheme) {
      FunctionType(f) ->
        f.params.all(|t: Type| is_marshallable(c, t, true))
          && is_marshallable(c, f.return_type, false),
      _ -> false,
    })

pub fn judgeable(c: MarshalledSums, scheme: Scheme) -> Bool =
  scheme.label_variables.len() == 0
    && (match int_instance_type(scheme) {
      FunctionType(f) -> f.params.push(f.return_type).all(|t: Type| liftable(c, t)),
      _ -> false,
    })

pub fn liftable(c: MarshalledSums, t: Type) -> Bool = is_marshallable(c, t, true)

fn int_instance_type(scheme: Scheme) -> Type =
  substituted(scheme.ty, int_arguments(scheme.type_variables))

fn int_arguments(type_variables: List<Int>) -> List<Type> =
  range(0, type_variables.fold(0, |w: Int, v: Int| max(w, v + 1))).map(|_: Int| int_type())

fn with_entry(
  s: ModuleContext,
  wanted: Map<RootName, Bool>,
  hosts: Map<Bytes, HostHandler>,
  root: RootKey,
  scheme: Option<Scheme>,
  out: List<Function>,
) -> List<Function> / {abort.raise} = {
  let key = EntryPoint(root);
  if !wants_root(wanted, key) { out } else {
    match scheme {
      Some(scheme) -> match scheme.ty {
        FunctionType(f) -> {
          let ints = int_arguments(scheme.type_variables);
          let called = match root {
            Named(_) ->
              {
                callee: root,
                at: scheme.type_variables.map(|_: Int| int_type()),
                rows: scheme.effect_variables.map(|_: Int| no_effects()),
              },
            _ ->
              { callee: instantiated_callee(root, scheme.type_variables.len()), at: [], rows: [] },
          };
          let hosted = handlers_for(hosts, f.effects.listed.map(|a: Effect| a.effect));
          let e = runtime_entry_code(
            s.module,
            root,
            called.callee,
            called.at,
            called.rows,
            f.params.map(|t: Type| substituted(t, ints)),
            substituted(f.return_type, ints),
            f.effects,
            hosted.map(|h: { effect: Bytes, hosting: HostHandler }|
              { call: h.hosting.call, effect: h.effect, adds: added_by(h.hosting) }),
            pure: s.definitions.any(|d: Definition| d.root == called.callee && d.pure),
          );
          out.push(
            root_from_code(
              {
                ..s,
                definitions: s.definitions.concat(e.definitions),
                imports: s.imports.concat(
                  hosted.map(|h: { effect: Bytes, hosting: HostHandler }| h.hosting.import),
                ),
              },
              0,
              key,
              e.params,
              e.code,
              e.performs,
            ),
          )
        },
        _ -> panic("internal compiler error: the program entry is not a function"),
      },
      None -> panic("internal compiler error: the program entry has no inferred type"),
    }
  }
}

fn added_by(h: HostHandler) -> List<Effect> =
  h.import.definitions.fold([], |accumulator: List<Effect>, d: Definition|
    match d.scheme {
      Some(scheme) -> match scheme.ty {
        FunctionType(f) -> accumulator.concat(f.effects.listed),
        _ -> accumulator,
      },
      None -> accumulator,
    })

fn instantiated_callee(root: RootKey, type_variable_count: Int) -> RootKey =
  if type_variable_count == 0 { root } else {
    match root {
      Clause(c) -> match c.definition {
        Named(d) -> Clause({ ..c, definition: claims_key(d, type_variable_count) }),
        _ -> root,
      },
      _ -> root,
    }
  }

fn with_claim_entry(
  s: ModuleContext,
  wanted: Map<RootName, Bool>,
  root: RootKey,
  params: List<EmitParam>,
  type_variables: List<Int>,
  out: List<Function>,
) -> List<Function> / {abort.raise} =
  with_entry(
    s,
    wanted,
    Map::new(),
    root,
    Some({
      ..monomorphic(function_type(params.map(param_type), bool_type(), no_effects())),
      type_variables: type_variables,
    }),
    out,
  )

fn labels_of(d: FnDefinition) -> List<Bytes> = d.generics.labels.map(|i: Identifier| i.name)

fn clause_roots(
  accumulator: RootForms,
  definition: FnDefinition,
  s: ModuleContext,
  wanted: Map<RootName, Bool>,
  recorded: SiteAnnotations,
  schemes: Map<Bytes, Scheme>,
) -> RootForms / {abort.raise} = {
  let full = qualify(s.module, definition.name.name);
  let type_variables = match schemes.get(full) {
    Some(scheme) -> scheme.type_variables,
    None -> [],
  };
  let ints = int_arguments(type_variables);
  let base = definition.span.start;
  let clause = |kind: ClauseKind, k: Int| Clause({ definition: Named(full), kind: kind, n: k });
  let rooted = |out: List<Function>, key: RootKey, at: Int| {
    let b = resolved_at(recorded, ClauseBody(at), base, []);
    let ps = root_params(b, []);
    let own = if !wants_root(wanted, key) { out }
    else { out.push(root_from_code(s, base, key, ps, body_code(b, [], recorded))) };
    let callee = instantiated_callee(key, type_variables.len());
    let specialised = if callee == key || !wants_root(wanted, callee) { own } else {
      let specialisation = root_body(recorded, ClauseBody(at), base, [], ints);
      own.push(root_from_code(s, base, callee, specialisation.params, specialisation.code))
    };
    with_claim_entry(s, wanted, key, ps, type_variables, specialised)
  };
  let walked = definition.spec.fold(
    { out: accumulator.out, requires: 0, ensures: 0, at: 0 },
    |w: { out: List<Function>, requires: Int, ensures: Int, at: Int }, c: SpecClause| {
      let next = { ..w, at: w.at + 1 };
      match c.kind {
        RequiresClause ->
          {
            ..next,
            out: rooted(w.out, clause(Requires, w.requires), w.at),
            requires: w.requires + 1,
          },
        EnsuresClause -> match definition.return_type {
          None -> { ..next, ensures: w.ensures + 1 },
          Some(_) ->
            {
              ..next,
              out: rooted(w.out, clause(Ensures, w.ensures), w.at),
              ensures: w.ensures + 1,
            },
        },
        CostClause -> next,
        SpaceClause -> next,
      }
    },
  );
  { out: walked.out }
}

pub fn emit_root_results(
  names: List<Bytes>,
  sources: List<Bytes>,
  constructors: Constructors,
  wanted: List<RootKey>,
  packages: List<PackageDependencies>,
  module_packages: List<Int>,
  embeds: List<ModuleEmbed>,
  rows: Rows,
  effects: List<EffectRow>,
  walked: Bytes,
  published: List<PublishedSignature> = [],
) -> List<RootOutput> / {abort.raise} =
  results_of(
    lowered_roots(
      names,
      sources,
      constructors,
      wanted,
      packages,
      module_packages,
      embeds,
      rows,
      effects,
      walked,
      published,
    ),
  )

pub fn lowered_roots(
  names: List<Bytes>,
  sources: List<Bytes>,
  constructors: Constructors,
  wanted: List<RootKey>,
  packages: List<PackageDependencies>,
  module_packages: List<Int>,
  embeds: List<ModuleEmbed>,
  rows: Rows,
  effects: List<EffectRow>,
  walked: Bytes,
  published: List<PublishedSignature> = [],
) -> LoweredProgram / {abort.raise} =
  lowered_program(
    zip_sources(names, sources),
    constructors,
    true,
    wanted,
    packages,
    module_packages,
    embeds,
    rows,
    effects,
    walked,
    published,
  )

pub fn results_of(w: LoweredProgram) -> List<RootOutput> / {abort.raise} =
  emitted_program(w).map(result_of)

fn result_of(e: EmittedRoot) -> RootOutput =
  { name: e.name, result: { text: e.text, tables: e.tables } }

pub fn zip_sources(names: List<Bytes>, sources: List<Bytes>) -> List<Source> =
  range(0, names.len()).map(|i: Int|
    {
      name: match names.at(i) { Some(n) -> n, None -> b"" },
      source_text: match sources.at(i) { Some(t) -> t, None -> b"" },
    })

test "`host_handlers` aborts with a diagnostic when an effect's host handler function is not defined" {
  let fact = {
    name: b"std.fact",
    module: parse(b"pub effect fact {\n  read get() -> Int\n}\nhost for fact by served\n").node,
    derived: [],
  };
  let diagnostics_text = handle {
    host_handlers([fact], |_: Bytes| []);
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert(
    diagnostics_text.contains(b"the host handler `served` of `std.fact.fact` is no definition"),
    None,
  )
}
