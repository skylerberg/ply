/// The checker's own words for `diags`, one per diagnostic, which a panic over a program the front
/// end checked and the emitter cannot resolve carries.
pub fn diagnostics_text(diags: List<Diag>) -> Bytes =
  bytes_join(diags.map(|diag: Diag| Bytes::concat_all([diag.code, b": ", diag.message])), b"; ")

/// The same for the parser's diagnostics, which are a different record.
fn parse_diagnostics_text(diags: List<ParseDiag>) -> Bytes =
  bytes_join(
    diags.map(|diag: ParseDiag| Bytes::concat_all([diag.code, b": ", diag.message])),
    b"; ",
  )

/// The names the roots `wanted` print as, each once.
fn wanted_names(wanted: List<RootKey>) -> Map<RootName, Bool> =
  wanted.fold(Map::new(), |m: Map<RootName, Bool>, k: RootKey| m.insert(root_name(k), true))

/// Whether `wanted` names root `k`.
fn wants_root(wanted: Map<RootName, Bool>, k: RootKey) -> Bool = wanted.contains(root_name(k))

/// The roots written for a type that `wanted` holds, each once and in the order of their names, with
/// the module each is written in.
fn written_wanted(
  wanted: List<RootKey>,
) -> List<{ key: RootKey, op: TypeOp, ty: Type, module: Bytes }> / {abort.raise} =
  wanted.fold(
    Map::new(),
    |m: Map<RootName, { key: RootKey, op: TypeOp, ty: Type, module: Bytes }>, k: RootKey|
      match k {
        Generated(w, _) ->
          m.insert(root_name(k), { key: k, op: w.op, ty: w.ty, module: module_of(k) }),
        _ -> m,
      },
  ).values(
  )

/// What a program walk lowered, in its order: each root's form, each constructor's stated
/// functions, which a body making the constructor's tag calls, the program's constructor table,
/// which the printers read, the parameters each definition lends by declaration (E0475), by its
/// root's name, and the handing of each definition lowered elsewhere, by its root's name.
pub type LoweredProgram = {
  roots: List<Fn>,
  stated: Map<Bytes, List<Bytes>>,
  ctors: Ctors,
  borrowed: Map<RootName, List<Int>>,
  handed: Map<RootName, OwnershipSignature>,
}

/// The roots `roots` keys of the program `given` emitted: `lowered_program`'s forms, each counted,
/// checked and printed.
pub fn emit_program(
  given: List<Source>,
  ctors: Ctors,
  release: Bool,
  roots: List<RootKey>,
  pkgs: List<PackageDeps>,
  placed: List<Int>,
  embeds: List<ModuleEmbed>,
  rows: Rows,
  effects: List<EffectRow>,
  walked: Bytes,
  published: List<PublishedSignature> = [],
) -> List<EmittedRoot> / {abort.raise} =
  emitted_program(
    lowered_program(
      given,
      ctors,
      release,
      roots,
      pkgs,
      placed,
      embeds,
      rows,
      effects,
      walked,
      published,
    ),
  )

/// Each root `w` holds written against the handings the lending inference settles for the
/// definitions it lowered (`w.handed` standing for the rest), its counts placed, checked and
/// printed, and its tables holding what lending settled of it.
pub fn emitted_program(w: LoweredProgram) -> List<EmittedRoot> / {abort.raise} = {
  let settled = infer_signatures(inference_targets_of(w.borrowed, w.roots), w.handed, w.borrowed);
  roots_emitted(w.roots, settled, w.stated, w.ctors, 0, w.roots.len(), 64)
}

/// Each of `roots` from `lo` up to `hi` counted, checked and printed against the handings `settled`,
/// on its own, so the halves of the list at once. Only values cross into the halves: a closure's
/// captures are not shared across threads. `depth_left` is the halvings left, and 64 take any length to
/// one.
fn roots_emitted(
  roots: List<Fn>,
  settled: InferenceResult,
  stated: Map<Bytes, List<Bytes>>,
  ctors: Ctors,
  lo: Int,
  hi: Int,
  depth_left: Int,
) -> List<EmittedRoot> / {abort.raise} =
  if hi - lo <= 1 {
    match roots.at(lo) { Some(r) -> [root_emitted(r, settled, stated, ctors)], None -> [] }
  } else if depth_left <= 0 { panic("more halvings than a length has") } else {
    let mid = lo + (hi - lo) / 2;
    let both = parallel {
      roots_emitted(roots, settled, stated, ctors, lo, mid, depth_left - 1),
      roots_emitted(roots, settled, stated, ctors, mid, hi, depth_left - 1),
    };
    both._0.concat(both._1)
  }

fn root_emitted(
  f: Fn,
  settled: InferenceResult,
  stated: Map<Bytes, List<Bytes>>,
  ctors: Ctors,
) -> EmittedRoot / {abort.raise} = {
  let l = inferred_fn(f, settled);
  let e = with_instance_calls(stated, tags_in(l.form), emitted_of(l.form, ctors));
  { ..e, tables: { ..e.tables, handings: l.handings, assumed: l.assumed, group: l.group } }
}

/// The roots `roots` keys of the program `given`, lowered as `scope_of` reads the program and each
/// written against the handings `published` holds.
fn lowered_program(
  given: List<Source>,
  ctors: Ctors,
  release: Bool,
  roots: List<RootKey>,
  pkgs: List<PackageDeps>,
  placed: List<Int>,
  embeds: List<ModuleEmbed>,
  rows: Rows,
  effects: List<EffectRow>,
  walked: Bytes,
  published: List<PublishedSignature>,
) -> LoweredProgram / {abort.raise} =
  lowered_in(
    scope_of(given, ctors, release, roots, pkgs, placed, embeds, rows, effects, walked),
    roots,
    signatures_from(published),
  )

/// A program as the emitter reads it, resolved once and lowered from for as many roots as are asked
/// of it: its modules written out as its check elaborated them, each by its place among them; each
/// module's definitions, imports, effects and the operations its check witnessed; what the check
/// filed of each body it read, and the owners of those bodies; the constructors' stated functions,
/// the program's constructor table, the builtins, whether it is lowered for a release's runtime,
/// the builtins' schemes, and the parameters each definition lends by declaration.
pub type Scope = {
  mods: List<ParsedModule>,
  places: Map<Bytes, Int>,
  modules: List<ModuleScope>,
  resolved: Resolution,
  schemes: Map<Bytes, Scheme>,
  owned: Map<Bytes, BodyFacts>,
  reading: Map<Bytes, Bool>,
  stated: Map<Bytes, List<Bytes>>,
  ctors: Ctors,
  builtins: List<Bytes>,
  /// How a call of each native of a shipped module called over machine words crosses.
  machine: Map<Bytes, MachineCall>,
  release: Bool,
  declared: Map<Bytes, Scheme>,
  borrowed: Map<RootName, List<Int>>,
  /// Each effect whose module declares its real handler, by program-wide name.
  hosts: Map<Bytes, RealHandler>,
  /// The atoms each test performs once it has handled what it handles, by its key.
  test_footprints: Map<Bytes, List<Atom>>,
}

/// An effect's real handler as an entry calls it: by `call`, its name across the program, which
/// `import` holds.
pub type RealHandler = { call: Bytes, import: Imported }

/// A module of a scope as the roots in it are lowered: the definitions it writes and those it
/// imports, and the effects it names.
pub type ModuleScope = { here: List<Def>, imports: List<Imported>, effects: List<EffectName> }

/// The answer of each root `roots` keys, lowered in `s`, each written against `handed` where it
/// calls a definition lowered apart.
pub fn answered(
  s: Scope,
  roots: List<RootKey>,
  handed: Map<RootName, OwnershipSignature>,
) -> List<RootOutput> / {abort.raise} = results_of(lowered_in(s, roots, handed))

/// The program `given` resolved together, so defaults are filled and derives expanded, with what its
/// check filed of every body its rows hold facts of and of the owners `roots` read. `pkgs` and
/// `placed` are the program's package tables, empty for one without packages: resolution then
/// treats every module as one package's, which is what no packages means. A library derivation
/// expands to what `derived` says its load's deriver wrote. Each effect's operations are read as
/// `effects` publishes them.
pub fn scope_of(
  given: List<Source>,
  ctors: Ctors,
  release: Bool,
  roots: List<RootKey>,
  pkgs: List<PackageDeps>,
  placed: List<Int>,
  embeds: List<ModuleEmbed>,
  rows: Rows,
  effects: List<EffectRow>,
  walked: Bytes,
  derived: List<ModuleDerivations> = [],
) -> Scope / {abort.raise} = {
  // Every module imports `std.prelude`, which a caller may leave out; it is a shipped module.
  let sources = with_prelude_source(given);
  let module_packages = if sources.len() == given.len() || pkgs.len() == 0 { placed }
  else { placed.push(pkgs.len()) };
  let tables = embed_tables(embeds);
  let parsed = range(0, sources.len()).map(|i: Int| {
    let s = match sources.at(i) { Some(x) -> x, None -> { name: b"", src: b"" } };
    let taken = match derived.find(|m: ModuleDerivations| m.module == s.name) {
      Some(m) -> m.derivations,
      None -> [],
    };
    let p = parse_from(i, s, parse(s.src), derivations: taken);
    let e = inline_embeds_by_name(tables, s.name, p.module.module);
    if p.diags.len() > 0 { unread(diagnostics_text(p.diags)) }
    else if e.diags.len() > 0 { unread(parse_diagnostics_text(e.diags)) }
    else { { ..p.module, module: e.module } }
  });
  // The published table ends with the built-in packages; the shipped modules sit one past them.
  let packaged = if pkgs.len() == 0 { no_packages(parsed) } else {
    {
      pkgs: pkgs,
      module_packages: module_packages,
      std: pkgs.len() - 2,
      compiler: pkgs.len() - 1,
      shipped: pkgs.len(),
    }
  };
  let x = match resolve_packaged(
      parsed,
      packaged.pkgs,
      packaged.module_packages,
      packaged.std,
      packaged.compiler,
      packaged.shipped,
    ) {
    ResolveFailed(diags) -> unread(diagnostics_text(diags)),
    ResolveSucceeded(x) -> x,
  };
  let schemes = rows.defs.fold(Map::new(), |acc: Map<Bytes, Scheme>, row: KnownDefRow|
    acc.insert(row.name, row.scheme));
  let w = match walked_read(walked) {
    Some(w) -> w,
    None -> unread(b"its answer carries nothing its check read"),
  };
  let pure = w.pure.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Bytes| acc.insert(n, true));
  let reading = owners_to_read(rows, roots);
  let every = x.mods.fold(Map::new(), |acc: Map<Bytes, Bool>, m: ParsedModule|
    acc.insert(m.name, true));
  let facts = match facts_read(rows, w, Some({ roots: reading, modules: every }), x.mods) {
    Ok(f) -> f,
    Err(why) -> unread(why),
  };
  let mods = x.mods;
  let program = mods.fold(Map::new(), |acc: Map<Bytes, List<Def>>, m: ParsedModule|
    acc.insert(m.name, defs_in(m.name, m.module, pure, schemes)));
  let defs_of = |path: Bytes| match program.get(path) { Some(ds) -> ds, None -> [] };
  let members = facts.members.fold(Map::new(), |acc: Map<Int, List<MemberSite>>, s: MemberSite|
    acc.insert(s.module, List::push(match acc.get(s.module) { Some(xs) -> xs, None -> [] }, s)));
  let natives = parsed_natives(mods);
  let declared = declared_effects(x.r, published_operations(effects));
  {
    mods: mods,
    places: range(0, mods.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int|
      acc.insert(mods.get(i).name, i)),
    modules: range(0, mods.len()).map(|i: Int| {
      let m = mods.get(i);
      {
        here: defs_of(m.name),
        imports: resolved_imports(x.r, i, mods, m.module, defs_of, match members.get(i) {
          Some(xs) -> xs,
          None -> [],
        }).concat(
          scheduler_imported(defs_of),
        ),
        effects: declared,
      }
    }),
    resolved: x.r,
    schemes: schemes,
    // What the check filed of each item's nodes, which its roots and the lambdas it lends are read
    // under.
    owned: facts_by_owner(facts),
    reading: reading,
    stated: stated_by_tag(mods),
    ctors: {
      ..ctors,
      keyed: keyed_tags(mods).fold(ctors.keyed, |acc: List<Bytes>, k: Bytes|
        if acc.contains(k) { acc } else { acc.push(k) }),
    },
    builtins: natives.map(|e: Extern| e.name),
    machine: machine_calls(natives),
    release: release,
    declared: declared_schemes(),
    borrowed: program.fold(
      Map::new(),
      |m: Map<RootName, List<Int>>, module: Bytes, defs: List<Def>|
        declared_borrows(m, module, defs),
    ),
    hosts: with_prelude_handlers(real_handlers(mods, defs_of), defs_of),
    test_footprints: rows.tests.fold(Map::new(), |m: Map<Bytes, List<Atom>>, r: KnownTestRow|
      match read_atoms(r.footprint) { Some(xs) -> m.insert(r.key, xs), None -> m }),
  }
}

/// Panics: the emitter cannot read the program the front end checked, as `why` says.
fn unread<a>(why: Bytes) -> a / {abort.raise} =
  panic(
    String::of_bytes_lossy(
      b"the emitter cannot read the program the front end checked: ".concat(why),
    ),
  )

/// Each effect of `mods` whose module declares its real handler, and how an entry calls it: through
/// a binder named for the effect, which no source can write, over the handler's definition as its
/// module holds it (`defs_of`), which the checker holds every handler a module names to.
fn real_handlers(
  mods: List<ParsedModule>,
  defs_of: (Bytes) -> List<Def>,
) -> Map<Bytes, RealHandler> / {abort.raise} =
  mods.fold(Map::new(), |acc: Map<Bytes, RealHandler>, m: ParsedModule|
    m.module.items.fold(acc, |held: Map<Bytes, RealHandler>, item: Item|
      match item {
        InstanceItem(d) -> if d.kind != HostInstance { held } else {
          let served = qualify(m.name, d.target.name);
          match defs_of(m.name).find(|def: Def| def.name == d.by.name) {
            None ->
              unread(
                Bytes::concat_all([
                  b"the real handler `",
                  d.by.name,
                  b"` of `",
                  served,
                  b"` is no definition",
                ]),
              ),
            Some(def) ->
              held.insert(served, {
                call: qualify(m.name, d.by.name),
                import: { name: served, module: m.name, defs: [def], whole: true },
              }),
          }
        },
        _ -> held,
      }))

/// `hosts` and the real handler of each of the prelude's effects that has one (`prelude_hosts`),
/// where the load holds its module, each imported under a name of its effect's own, so two of one
/// module that an entry nests both resolve.
fn with_prelude_handlers(
  hosts: Map<Bytes, RealHandler>,
  defs_of: (Bytes) -> List<Def>,
) -> Map<Bytes, RealHandler> / {abort.raise} =
  prelude_hosts().fold(
    hosts,
    |acc: Map<Bytes, RealHandler>, h: { effect: Bytes, module: Bytes, by: Bytes }|
      match defs_of(h.module).find(|d: Def| d.name == h.by) {
        None -> acc,
        Some(def) ->
          acc.insert(h.effect, {
            call: qualify(h.module, h.by),
            import: {
              name: qualify(h.module, h.effect),
              module: h.module,
              defs: [def],
              whole: true,
            },
          }),
      },
  )

/// The real handlers a root performing `effects` runs under, in the order an entry nests them: one
/// for each of them whose module declares one, by program-wide name, beside that effect.
fn handlers_for(
  hosts: Map<Bytes, RealHandler>,
  effects: List<Bytes>,
) -> List<{ effect: Bytes, hosting: RealHandler }> / {abort.raise} =
  effects.fold([], |acc: List<Bytes>, e: Bytes|
    if acc.contains(e) || !hosts.contains(e) { acc } else { acc.push(e) }).sort_by(
    |a: Bytes, b: Bytes| match compare_values(a, b) { Greater -> false, _ -> true },
  ).fold([], |acc: List<{ effect: Bytes, hosting: RealHandler }>, e: Bytes|
    match hosts.get(e) { Some(h) -> acc.push({ effect: e, hosting: h }), None -> acc })

/// The roots `roots` keys lowered in `s`, in its modules' order, each written against `handed` where
/// it calls a definition lowered apart.
pub fn lowered_in(
  s: Scope,
  roots: List<RootKey>,
  handed: Map<RootName, OwnershipSignature>,
) -> LoweredProgram / {abort.raise} = {
  let wanted = wanted_names(roots);
  let touched = roots.fold(Map::new(), |acc: Map<Bytes, Bool>, k: RootKey|
    match definition_root(k) { Some(d) -> acc.insert(d, true), None -> acc });
  let lowered = modules_lowered(roots);
  let specialised = specialisations_wanted(roots);
  // Each owner a wanted specialisation runs a lambda of is read once, for all of them.
  let lent_by = specialised.fold(
    Map::new(),
    |acc: Map<RootName, Option<BoundLambda>>, _: Bytes, sps: List<RootKey>|
      sps.fold(acc, |held: Map<RootName, Option<BoundLambda>>, sp: RootKey|
        inlined_lambdas(sp).fold(
          held,
          |h: Map<RootName, Option<BoundLambda>>, f: InlinedLambda| {
            let name = root_name(f.owner);
            if h.contains(name) { h } else { h.insert(name, owner_lambdas(s, f.owner)) }
          },
        )),
  );
  let forming = {
    scope: s,
    wanted: wanted,
    touched: touched,
    specialised: specialised,
    written: written_wanted(roots),
    lent_by: lent_by,
  };
  let lowering = range(0, s.mods.len()).filter(|i: Int|
    match s.mods.at(i) { Some(m) -> lowered.contains(m.name), None -> false });
  {
    roots: modules_formed(forming, lowering, 0, lowering.len(), 64),
    stated: s.stated,
    ctors: s.ctors,
    borrowed: s.borrowed,
    handed: handed,
  }
}

/// What a scope forms its roots from, all values, so a piece's modules are formed at once.
type FormInputs = {
  scope: Scope,
  wanted: Map<RootName, Bool>,
  touched: Map<Bytes, Bool>,
  specialised: Map<Bytes, List<RootKey>>,
  written: List<{ key: RootKey, op: TypeOp, ty: Type, module: Bytes }>,
  lent_by: Map<RootName, Option<BoundLambda>>,
}

/// The roots of the modules at places `lowering` from `lo` up to `hi` formed, the halves at once;
/// `depth_left` is the halvings left, and 64 take any length to one.
fn modules_formed(
  f: FormInputs,
  lowering: List<Int>,
  lo: Int,
  hi: Int,
  depth_left: Int,
) -> List<Fn> / {abort.raise} =
  if hi - lo <= 1 { match lowering.at(lo) { Some(i) -> module_at_formed(f, i), None -> [] } }
  else if depth_left <= 0 { panic("more halvings than a length has") } else {
    let mid = lo + (hi - lo) / 2;
    let both = parallel {
      modules_formed(f, lowering, lo, mid, depth_left - 1),
      modules_formed(f, lowering, mid, hi, depth_left - 1),
    };
    both._0.concat(both._1)
  }

/// The roots the module at place `i` writes formed.
fn module_at_formed(f: FormInputs, i: Int) -> List<Fn> / {abort.raise} =
  match f.scope.mods.at(i) {
    None -> [],
    Some(m) -> {
      let tab = module_scope(f.scope, i);
      module_formed(
        m.module,
        {
          module: m.name,
          here: tab.here,
          imports: tab.imports,
          ctors: f.scope.ctors,
          builtins: f.scope.builtins,
          declared: f.scope.declared,
          machine: f.scope.machine,
          effects: tab.effects,
          release: f.scope.release,
        },
        f,
        f.written.filter(|w: { key: RootKey, op: TypeOp, ty: Type, module: Bytes }|
          w.module == m.name).map(|w: { key: RootKey, op: TypeOp, ty: Type, module: Bytes }|
          { key: w.key, op: w.op, ty: w.ty }),
      )
    },
  }

/// The tables of the module at place `i` of `s`.
fn module_scope(s: Scope, i: Int) -> ModuleScope =
  match s.modules.at(i) { Some(t) -> t, None -> { here: [], imports: [], effects: [] } }

/// Lambda `nth` that `owner` lends, read once for every owner `lent_by` holds and else here.
fn lambda_in(
  s: Scope,
  lent_by: Map<RootName, Option<BoundLambda>>,
  owner: RootKey,
  nth: Int,
) -> Option<BoundLambda> / {abort.raise} =
  match match lent_by.get(root_name(owner)) { Some(o) -> o, None -> owner_lambdas(s, owner) } {
    None -> None,
    Some(o) -> match o.written.at(nth) {
      None -> None,
      Some(code) -> Some({ ..o, nth: nth, code: code }),
    },
  }

/// What an owner lends, as its first lambda: its lambdas, read where it lowers them, a definition as
/// it stands or at the type arguments the owner's key gives, then the definitions it names as values.
fn owner_lambdas(s: Scope, owner: RootKey) -> Option<BoundLambda> / {abort.raise} = {
  let mods = s.mods;
  let schemes = s.schemes;
  let module_at = |i: Int| module_scope(s, i);
  let filed_of = |o: Bytes| filings_of(s.owned, o);
  let of = match owner {
    Specialisation(a, _) ->
      { base: a.def, args: key_types(owner), allows_lambda_inlining: a.borrowed.len() == 0 },
    _ -> { base: site_owner_text(owner), args: [], allows_lambda_inlining: true },
  };
  let module = module_of(owner);
  let short = default_binder(of.base);
  // The lambdas `code`, the owner's body in module `i`, writes.
  let lent = |i: Int, m: ParsedModule, code: Code, base: Int| {
    let tab = module_at(i);
    let emitted = known_body(root_text(root_name(owner)), [], code);
    let written = lambdas_of(emitted).concat(named_in(m.name, tab.here, tab.imports, emitted));
    match written.at(0) {
      Some(first) ->
        Some({
          owner: owner,
          nth: 0,
          code: first,
          module: m.name,
          here: tab.here,
          imports: tab.imports,
          effects: tab.effects,
          base: base,
          written: written,
        }),
      None -> None,
    }
  };
  match s.places.get(module) {
    None -> None,
    Some(i) -> {
      let m = mods.get(i);
      match m.module.items.fold(None, |acc: Option<FnDef>, item: Item|
          match item {
            FunctionItem(d) -> if d.name.name == short && of.allows_lambda_inlining { Some(d) }
            else { acc },
            _ -> acc,
          }) {
        // A test's lambdas, as its root lowers its run.
        None -> match m.module.items.fold(None, |acc: Option<TestDef>, item: Item|
            match item {
              TestItem(t) -> if test_key(m.name, t.name) == owner { Some(t) } else { acc },
              _ -> acc,
            }) {
          None -> None,
          Some(t) -> {
            let filed = filed_of(site_owner_text(owner));
            lent(i, m, root_body(filed, TestRun, t.span.start, [], []).code, t.span.start)
          },
        },
        Some(d) -> {
          let filed = filed_of(of.base);
          lent(
            i,
            m,
            root_body(filed, WholeBody, d.span.start, labels_of(d), of.args).code,
            d.span.start,
          )
        },
      }
    },
  }
}

/// The owners whose facts a scope reads: every definition whose row holds facts, which a root may
/// reach, and for each of `roots` the owner it is filed under, that of the root its body is read
/// with, and that of each owner of a lambda it runs in place.
fn owners_to_read(rows: Rows, roots: List<RootKey>) -> Map<Bytes, Bool> =
  roots.fold(
    rows.defs.fold(Map::new(), |acc: Map<Bytes, Bool>, row: KnownDefRow|
      if row.facts.len() == 0 { acc } else { acc.insert(row.name, true) }),
    |acc: Map<Bytes, Bool>, k: RootKey|
      inlined_lambdas(k).fold(
        acc.insert(site_owner_text(k), true).insert(site_owner_text(facts_root(k)), true),
        |r: Map<Bytes, Bool>, f: InlinedLambda| r.insert(site_owner_text(f.owner), true),
      ),
  )

/// The root whose facts root `k`'s body is read with: a clause's definition, a listing's test, and
/// any other root itself.
fn facts_root(k: RootKey) -> RootKey = match k { Clause(c) -> c.def, TestCases(t) -> t, _ -> k }

/// The definition whose item root `k` is formed from: its own, the one it specialises, and the one
/// it enters or states a clause of; none for a root of no definition.
fn definition_root(k: RootKey) -> Option<Bytes> =
  match k {
    Named(n) -> Some(n),
    Specialisation(a, _) -> Some(a.def),
    EntryPoint(e) -> definition_root(e),
    Clause(c) -> definition_root(c.def),
    _ -> None,
  }

/// Each constructor whose type's module states a `key`, which its values are compared by.
fn keyed_tags(mods: List<ParsedModule>) -> List<Bytes> =
  mods.fold([], |acc: List<Bytes>, m: ParsedModule|
    m.module.items.fold(acc, |a: List<Bytes>, item: Item|
      match item {
        InstanceItem(d) -> if d.kind != KeyInstance { a }
        else { a.concat(with_stated(m, Map::new(), d.target.name, [d.by.name]).keys()) },
        _ -> a,
      }))

/// Each constructor whose type's module states a `key` or a `show`, with those functions under
/// their program-wide names. An invariant is read by the prover alone, never at run time.
fn stated_by_tag(mods: List<ParsedModule>) -> Map<Bytes, List<Bytes>> =
  mods.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, m: ParsedModule|
    m.module.items.fold(acc, |a: Map<Bytes, List<Bytes>>, item: Item|
      match item {
        InstanceItem(d) -> if d.kind == InvariantInstance || d.kind == HostInstance { a }
        else { with_stated(m, a, d.target.name, [d.by.name]) },
        NumericItem(d) ->
          with_stated(m, a, d.target.name, d.operations.map(|x: NumericOp| x.by.name)),
        _ -> a,
      }))

/// `stated` with `fns` of module `m` under each constructor of its type `target`.
fn with_stated(
  m: ParsedModule,
  stated: Map<Bytes, List<Bytes>>,
  target: Bytes,
  fns: List<Bytes>,
) -> Map<Bytes, List<Bytes>> =
  m.module.items.fold(stated, |b: Map<Bytes, List<Bytes>>, other: Item|
    match other {
      TypeItem(t) -> if t.name.name != target { b } else {
        match t.body {
          SumBody(variants) ->
            variants.fold(b, |c: Map<Bytes, List<Bytes>>, v: VariantDef| {
              let tag = qualify(m.name, v.name.name);
              c.insert(
                tag,
                fns.fold(
                  match c.get(tag) { Some(fs) -> fs, None -> [] },
                  |fs: List<Bytes>, f: Bytes| fs.push(qualify(m.name, f)),
                ),
              )
            }),
          _ -> b,
        }
      },
      _ -> b,
    })

/// The constructors whose tags `f`, a form, and the closures it makes bind, each once, in the order
/// they are first bound.
fn tags_in(f: Fn) -> List<Bytes> =
  f.lambdas.fold(block_tags([], f.body), |acc: List<Bytes>, l: typed_ir::Lambda|
    match l {
      typed_ir::Closure(c) ->
        tags_in(c.body).fold(acc, |a: List<Bytes>, t: Bytes|
          if a.contains(t) { a } else { a.push(t) }),
    })

/// `acc` and each constructor whose tag `b` and the blocks it holds bind that `acc` lacks.
fn block_tags(acc: List<Bytes>, b: typed_ir::Block) -> List<Bytes> =
  b.fold(acc, |a: List<Bytes>, i: typed_ir::Inst|
    match i {
      typed_ir::Let(l) -> match l.val {
        typed_ir::Tag(name) -> if a.contains(name) { a } else { a.push(name) },
        _ -> a,
      },
      typed_ir::If(x) -> block_tags(block_tags(a, x.then), x.otherwise),
      typed_ir::Case(c) ->
        c.arms.fold(
          block_tags(a, c.rest),
          |n: List<Bytes>, arm: { when: Int, body: typed_ir::Block }| block_tags(n, arm.body),
        ),
      typed_ir::Match(m) -> m.arms.fold(block_tags(a, m.rest), block_tags),
      typed_ir::Loop(l) -> block_tags(a, l.body),
      typed_ir::Handle(h) -> block_tags(a, h.body),
      _ -> a,
    })

/// A body that makes a constructor's tag, one of `tags`, holds values the runtime reads through what
/// the type's module states of it, wherever they are compared or shown: so it calls those functions,
/// which the unit then takes with it and a kept answer is checked against.
fn with_instance_calls(
  stated: Map<Bytes, List<Bytes>>,
  tags: List<Bytes>,
  e: EmittedRoot,
) -> EmittedRoot =
  if stated.len() == 0 { e } else {
    {
      ..e,
      tables: {
        ..e.tables,
        calls: tags.fold(e.tables.calls, |acc: List<RootKey>, tag: Bytes|
          match stated.get(tag) {
            None -> acc,
            Some(fs) ->
              fs.fold(acc, |calls: List<RootKey>, f: Bytes|
                if calls.contains(Named(f)) { calls } else { calls.push(Named(f)) }),
          }),
      },
    }
  }

/// The roots `f.wanted` names of the module `s` reads, formed in its order: its definitions, each
/// definition's specialisations and clauses, its tests and laws, and the roots written for its types
/// that `written_roots` keys. `f.touched` names each definition a wanted root is of
/// (`definition_root`), the only ones read; what the checker filed of each item's nodes is read off
/// the scope, by the item's owner, for the owners it reads.
fn module_formed(
  module_tree: Module,
  s: ModuleContext,
  f: FormInputs,
  written_roots: List<{ key: RootKey, op: TypeOp, ty: Type }>,
) -> List<Fn> / {abort.raise} = {
  let module = s.module;
  let here = s.here;
  let defs = module_tree.items.fold(Map::new(), |m: Map<Bytes, FnDef>, item: Item|
    match item { FunctionItem(d) -> m.insert(qualify(module, d.name.name), d), _ -> m });
  let order = module_tree.items.fold(Map::new(), |m: Map<Bytes, Int>, item: Item|
    match item { FunctionItem(d) -> m.insert(qualify(module, d.name.name), m.len()), _ -> m });
  let walked = distinct_forms(
    items_formed(
      {
        module_tree: module_tree,
        s: s,
        f: f,
        defs: defs,
        order: order,
        written_roots: written_roots,
      },
      0,
      module_tree.items.len(),
      64,
    ),
  );
  // A type some body reflects, digests, walks as a container or hands the runtime is written for by
  // a root, each formed on its own.
  walked.concat(
    written_at_once({ s: s, items: module_tree.items }, written_roots, 0, written_roots.len(), 64),
  )
}

/// What a module's roots written for types are formed from, all values: its setting and its items.
type WrittenFormInputs = { s: ModuleContext, items: List<Item> }

/// The roots `roots` from `lo` up to `hi` key formed, the halves at once; `depth_left` is the halvings
/// left, and 64 take any length to one.
fn written_at_once(
  x: WrittenFormInputs,
  roots: List<{ key: RootKey, op: TypeOp, ty: Type }>,
  lo: Int,
  hi: Int,
  depth_left: Int,
) -> List<Fn> / {abort.raise} =
  if hi - lo <= 1 { match roots.at(lo) { Some(w) -> written_formed(x, w), None -> [] } }
  else if depth_left <= 0 { panic("more halvings than a length has") } else {
    let mid = lo + (hi - lo) / 2;
    let both = parallel {
      written_at_once(x, roots, lo, mid, depth_left - 1),
      written_at_once(x, roots, mid, hi, depth_left - 1),
    };
    both._0.concat(both._1)
  }

/// The root written for type `w.ty` that `w` keys, as its module `x` writes it: none where it is
/// written elsewhere.
fn written_formed(
  x: WrittenFormInputs,
  w: { key: RootKey, op: TypeOp, ty: Type },
) -> List<Fn> / {abort.raise} =
  naming(root_text(root_name(w.key)), || {
    let s = x.s;
    let module = s.module;
    let here = s.here;
    let module_tree = { items: x.items };
    // What a container's roots call of `std.prelude` the load reaches wherever a body writes one.
    let reached = || {
      let unreached = emitted_code().calls.filter(|n: Bytes|
        match def_in(module, here, s.imports, n) { Some(_) -> false, None -> true });
      if unreached.len() > 0 {
        panic(
          String::of_bytes_lossy(
            b"a container's root calls what the load did not reach of `std.prelude`: ".concat(
              Bytes::join(unreached, b", "),
            ),
          ),
        )
      }
    };
    let written_root = |key: RootKey, e: GeneratedRoot|
      root_from_code({ ..s, here: here.concat(e.here) }, 0, key, e.params, e.code, e.performs);
    let r = { key: w.key, op: op_name(w.op), ty: w.ty };
    let reflective = match w.op { Reflect -> true, Show -> true, Digest -> true, _ -> false };
    let contained = match w.op {
      ContainerWalk(c) -> container_op_generated(c),
      _ -> reflective && (is_walked_container(r.ty) || is_walked_columns(r.ty)),
    };
    if is_plain_written(w.op) {
      [
        match w.op {
          keys::OnWordForm(_) -> word_form_entry(s.ctors, w.key),
          _ -> generated(s.ctors, w.key),
        },
      ]
    } else if is_marshal_op(w.op) {
      if is_walked_container(r.ty) { reached() };
      [written_root(r.key, marshal_root(module, s.ctors, r.key))]
    } else if contained {
      reached();
      [written_root(r.key, container_code(module, s.ctors, r.op, r.ty))]
    } else if w.op == keys::ReleaseResource {
      [written_root(r.key, let_go_code(module, s.ctors, here, r.key, r.ty))]
    } else if w.op == ContainerWalk(b"let_go_items") {
      [written_root(r.key, let_go_items_code(module, s.ctors, r.key, r.ty))]
    } else if w.op == keys::Equal || w.op == Order {
      // A declared sum's comparisons are written where it is declared, above; a built-in sum's,
      // which no module declares, wherever one is asked for, from its constructors; any other
      // type's, which a kept value's descriptor asks for, are `==` and `compare` of its two values.
      let held = kind_of(w.ty);
      let param = |n: Bytes|
        { name: n, kind: held.kind, ty: held.ty, of: Some(w.ty), lambda: None };
      let formed = |code: Code| [root_from_code(s, 0, w.key, [param(b"a"), param(b"b")], code)];
      match built_in_cases(s.ctors, w.ty) {
        None -> if is_sum(s.ctors, w.ty) { [] }
        else { formed(if w.op == keys::Equal { compared_code(w.ty) } else { ordered_code(w.ty) }) },
        Some(cs) ->
          formed(if w.op == keys::Equal { equality_code(w.ty, cs) }
          else { ordering_code(w.ty, cs) }),
      }
    } else if !reflective { [] } else {
      let code = if r.op == b"digest" {
        digest_code(module, s.ctors, here, module_tree.items, r.ty)
      } else { reflection_code(module, s.ctors, here, module_tree.items, r.op == b"shown", r.ty) };
      let held = kind_of(r.ty);
      [
        root_from_code(
          s,
          0,
          r.key,
          [{ name: b"a", kind: held.kind, ty: held.ty, of: Some(r.ty), lambda: None }],
          code,
        ),
      ]
    }
  })

/// Whether `ty` is a sum, a module's or the language's, whose comparisons its constructors write.
fn is_sum(ctors: Ctors, ty: Type) -> Bool =
  match ty { NamedType(c) -> ctors.sums.get(c.name) != None, _ -> false }

/// The constructors of `ty` where it is a sum no module declares, the prelude's `Instant` and
/// `Duration` among them, at its arguments; none for any other type.
fn built_in_cases(ctors: Ctors, ty: Type) -> Option<List<SumCtor>> =
  match ty {
    NamedType(c) -> if c.name.index_of(b".") != None { None } else {
      match ctors.sums.get(c.name) {
        Some(declared) ->
          Some(if c.args.len() == 0 { declared } else {
            declared.map(|k: SumCtor|
              { ..k, fields: k.fields.map(|f: Type| at_args(f, k.params, c.args)) })
          }),
        None -> None,
      }
    },
    _ -> None,
  }

/// Whether a root written for a type is a plain one, generated straight to the form: a drop, dup,
/// release, copy, share or keep, of the type or of one of its sum's boxed cases, from the type's
/// layout; an entry its descriptor names over its word form; or a count over the value as a body
/// holds it.
fn is_plain_written(op: TypeOp) -> Bool =
  match op {
    keys::Drop -> true,
    keys::Dup -> true,
    keys::Release -> true,
    keys::Copy -> true,
    keys::Share -> true,
    keys::Keep -> true,
    keys::OnCase(_) -> true,
    keys::OnWordForm(_) -> true,
    keys::Unboxed(_) -> true,
    _ -> false,
  }

type RootForms = { out: List<Fn> }

/// What a module's items are formed from, all values: its items, its setting, what the scope forms
/// from, and its definitions with their order.
type ItemFormInputs = {
  module_tree: Module,
  s: ModuleContext,
  f: FormInputs,
  defs: Map<Bytes, FnDef>,
  order: Map<Bytes, Int>,
  written_roots: List<{ key: RootKey, op: TypeOp, ty: Type }>,
}

/// `forms` with each root once, where it is first formed.
fn distinct_forms(forms: List<Fn>) -> List<Fn> =
  forms.fold(
    { seen: Map::new(), out: [] },
    |acc: { seen: Map<RootName, Bool>, out: List<Fn> }, r: Fn|
      if acc.seen.contains(root_name(r.key)) { acc }
      else { { seen: acc.seen.insert(root_name(r.key), true), out: acc.out.push(r) } },
  ).out

/// The roots the items of `x` from `lo` up to `hi` form, a few at a time and the halves at once: a
/// loop two items meet is formed alike by each, and kept once (`distinct_forms`). `depth_left` is the
/// halvings left, and 64 take any length to one.
fn items_formed(x: ItemFormInputs, lo: Int, hi: Int, depth_left: Int) -> List<Fn> / {abort.raise} =
  if hi - lo <= 4 {
    range(lo, hi).fold({ out: [] }, |acc: RootForms, i: Int|
      match x.module_tree.items.at(i) { Some(item) -> item_formed(x, acc, item), None -> acc }).out
  } else if depth_left <= 0 { panic("more halvings than a length has") } else {
    let mid = lo + (hi - lo) / 2;
    let both = parallel {
      items_formed(x, lo, mid, depth_left - 1),
      items_formed(x, mid, hi, depth_left - 1),
    };
    both._0.concat(both._1)
  }

/// `acc` with the roots `item`, of the module `x` forms, forms: a definition's, its specialisations'
/// and its clauses', a test's, a law's, or those of a type's comparisons a body asked for.
fn item_formed(x: ItemFormInputs, acc: RootForms, item: Item) -> RootForms / {abort.raise} =
  naming(item_owner(x.s.module, item), || item_walked(x, acc, item))

fn item_walked(x: ItemFormInputs, acc: RootForms, item: Item) -> RootForms / {abort.raise} = {
  let s = x.s;
  let f = x.f;
  let module = s.module;
  let schemes = f.scope.schemes;
  let wanted = f.wanted;
  let touched = f.touched;
  let specialised = f.specialised;
  let reading = f.scope.reading;
  let defs = x.defs;
  let order = x.order;
  let here = s.here;
  let module_tree = x.module_tree;
  let written_roots = x.written_roots;
  let filed_of = |owner: Bytes| filings_of(f.scope.owned, owner);
  let lambda_at = |owner: RootKey, nth: Int| lambda_in(f.scope, f.lent_by, owner, nth);
  // A definition a walk of tail calls reaches, its body lowered as written. One whose facts were not
  // read is no part of a loop formed here.
  let read_of = |full: Bytes|
    match if reading.contains(full) { defs.get(full) } else { None } {
      None -> None,
      Some(d) -> {
        let filed = filed_of(full);
        Some({
          code: root_body(filed, WholeBody, d.span.start, labels_of(d), []).code,
          filed: filed,
        })
      },
    };
  let looped = |out: List<Fn>, key: RootKey| {
    let keys = tail_loop_of(s, order, read_of, key);
    if keys.len() < 2 { None }
    else if out.any(|r: Fn| root_name(r.key) == root_name(keys.get(0))) { Some(out) }
    else { Some(out.concat(tail_loop_lowered(s, schemes, defs, read_of, keys))) }
  };
  match item {
    FunctionItem(d) -> if !touched.contains(qualify(module, d.name.name)) { acc } else {
      let full = qualify(module, d.name.name);
      let p = { full: full, base: d.span.start, filed: filed_of(full) };
      let specialisations = (match specialised.get(p.full) { Some(l) -> l, None -> [] }).fold(
        acc.out,
        |a: List<Fn>, sp: RootKey|

          // One running lambdas in place leaves the loop: its calls hand them on as values.
          match if inlined_lambdas(sp).len() > 0 { None } else { looped(a, sp) } {
            Some(out) -> out,
            None -> a.push(specialised_lowered(s, d, sp, lambda_at, p.filed)),
          },
      );
      let out = if !wants_root(wanted, Named(p.full)) { specialisations } else {
        match looped(specialisations, Named(p.full)) {
          Some(o) -> o,
          None -> {
            let b = root_body(p.filed, WholeBody, p.base, labels_of(d), []);
            specialisations.push(root_from_code(s, p.base, Named(p.full), b.params, b.code))
          },
        }
      };
      clause_roots(
        { out: with_entry(s, wanted, f.scope.hosts, Named(p.full), schemes.get(p.full), out) },
        d,
        s,
        wanted,
        p.filed,
        schemes,
      )
    },
    // A test is a root named by its label: nullary, or over cases entered with a case's place
    // and identity beside a nullary root that lists them.
    TestItem(t) -> {
      let tested = test_key(module, t.name);
      let filed = || filed_of(site_owner_text(tested));
      let ps = if t.cases == None { [] } else {
        [
          {
            name: case_index_binder(),
            kind: IntKind,
            ty: OpenShape([]),
            of: Some(int_type()),
            lambda: None,
          },
          {
            name: case_identity(),
            kind: BoxedKind,
            ty: BytesShape,
            of: Some(bytes_type()),
            lambda: None,
          },
        ]
      };
      let rooted = |within: ModuleContext, key: RootKey, part: BodyPart| {
        let f = filed();
        let b = root_body(f, part, t.span.start, [], []);
        root_from_code(within, t.span.start, key, b.params, b.code)
      };
      // A test's entry is typed by what it performs once it has handled what it handles, and its
      // run takes the words of that row its entry hands it.
      let performs = {
        atoms: match f.scope.test_footprints.get(qualify(module, t.name)) {
          Some(xs) -> xs,
          None -> [],
        },
        tail: None,
      };
      let ran = {
        ..s,
        here: s.here.push(
          called_def(module, tested, ps.map(param_type), unit_type(), performs, false),
        ),
      };
      let run = with_entry(
        s,
        wanted,
        f.scope.hosts,
        tested,
        Some(monomorphic(fn_type(ps.map(param_type), unit_type(), performs))),
        if !wants_root(wanted, tested) { acc.out }
        else { acc.out.push(rooted(ran, tested, TestRun)) },
      );
      let listing = TestCases(tested);
      let out = match t.cases {
        None -> run,
        Some(c) -> {
          with_entry(
            s,
            wanted,
            f.scope.hosts,
            listing,
            Some(monomorphic(fn_type([], listing_ty(), row_empty()))),
            if !wants_root(wanted, listing) { run }
            else { run.push(rooted(s, listing, CaseListing)) },
          )
        },
      };
      { out: out }
    },
    // A law's guard and body are roots the judge enters with the binders' values.
    LawItem(d) -> {
      let part = |which: LawPart| law_key(module, d.name, which);
      let asked = |which: LawPart|
        wants_root(wanted, part(which)) || wants_root(wanted, EntryPoint(part(which)));
      if !asked(LawGuard) && !asked(LawBody) { acc } else {
        let filed = filed_of(law_owner(module, d.name));
        // Each part, then the entry a judge enters it through.
        let rooted = |out: List<Fn>, which: LawPart, body: BodyPart| {
          let b = settled_at(filed, body, d.span.start, []);
          let ps = root_params(b, []);
          with_claim_entry(s, wanted, part(which), ps, [], if !wants_root(wanted, part(which)) {
            out
          } else {
            out.push(root_from_code(s, d.span.start, part(which), ps, body_code(b, [], filed)))
          })
        };
        let with_guard = match d.guard {
          None -> acc.out,
          Some(_) -> rooted(acc.out, LawGuard, typed::LawGuard),
        };
        { out: rooted(with_guard, LawBody, typed::LawBody) }
      }
    },
    // A sum some body compares or orders is compared through a root written from its
    // constructors, written only where a body's call asks for it, not with every root a whole
    // emission takes.
    TypeItem(t) -> {
      let named = qualify(module, t.name.name);
      // At its own name, or at the arguments a body asked for one at.
      let asked = written_roots.fold(
        [],
        |acc2: List<{ key: RootKey, op: TypeOp, args: List<Type> }>, w: { key: RootKey, op: TypeOp, ty: Type }|
          match w.ty {
            NamedType(c) -> if c.name != named { acc2 } else {
              match w.op {
                keys::Equal -> acc2.push({ key: w.key, op: w.op, args: c.args }),
                Order -> acc2.push({ key: w.key, op: w.op, args: c.args }),
                NumericFunction(_) -> acc2.push({ key: w.key, op: w.op, args: c.args }),
                _ -> acc2,
              }
            },
            _ -> acc2,
          },
      );
      match s.ctors.sums.get(named) {
        None -> acc,
        Some(declared) ->
          asked.fold(acc, |a2: RootForms, d: { key: RootKey, op: TypeOp, args: List<Type> }| {
            let cs = if d.args.len() == 0 { declared } else {
              declared.map(|c: SumCtor|
                { ..c, fields: c.fields.map(|f: Type| at_args(f, c.params, d.args)) })
            };
            // At its own name a generic sum is at its own variables.
            let compared = NamedType({
              name: named,
              args: if d.args.len() > 0 { d.args } else {
                match declared.at(0) {
                  Some(c) -> c.params.map(|v: Int| VariableType(v)),
                  None -> [],
                }
              },
            });
            let param = |n: Bytes, ty: Type| {
              let held = kind_of(ty);
              { name: n, kind: held.kind, ty: held.ty, of: Some(ty), lambda: None }
            };
            let formed = |ps: List<EmitParam>, code: Code|
              root_from_code(s, t.span.start, d.key, ps, code);
            let made = match d.op {
              // The checker types an operator over the type only where its module states one.
              NumericFunction(op) -> {
                let ps = if op == b"of_int" { [param(b"a", int_type())] }
                else if op == b"neg" { [param(b"a", compared)] }
                else { [param(b"a", compared), param(b"b", compared)] };
                formed(ps, match numeric_instance(module, here, module_tree.items, compared, op) {
                  Some(f) -> instance_code(f, ps.map(param_type)),
                  None -> panic(String::of_bytes_lossy(b"no function stated for ".concat(op))),
                })
              },
              _ -> {
                let eq = d.op == keys::Equal;
                formed(
                  [param(b"a", compared), param(b"b", compared)],
                  match key_instance(module, here, module_tree.items, compared) {
                    Some(k) -> keyed_code(k, eq, compared),
                    None -> if eq { equality_code(compared, cs) }
                    else { ordering_code(compared, cs) },
                  },
                )
              },
            };
            { ..a2, out: a2.out.push(made) }
          }),
      }
    },
    _ -> acc,
  }
}

/// Whether a root typed by `sc` can be entered: a function over no label variable, each of whose
/// parameters a lifting reads and whose answer a lowering writes at the types it is judged at.
pub fn enterable(c: MarshalledSums, sc: Scheme) -> Bool =
  sc.label_vars.len() == 0
    && (match judged_type(sc) {
      FunctionType(f) -> f.params.all(|t: Type| marshals(c, t, true)) && marshals(c, f.ret, false),
      _ -> false,
    })

/// Whether a claim over the parameters and answer of a root typed by `sc` can be entered: a lifting
/// reads each of them at the types it is judged at, so none is a function or a runtime object, which
/// cross only out.
pub fn judgeable(c: MarshalledSums, sc: Scheme) -> Bool =
  sc.label_vars.len() == 0
    && (match judged_type(sc) {
      FunctionType(f) -> f.params.push(f.ret).all(|t: Type| liftable(c, t)),
      _ -> false,
    })

/// Whether a lifting reads a value of `t` into an entry: never a function, a runtime object, nor
/// a type variable.
pub fn liftable(c: MarshalledSums, t: Type) -> Bool = marshals(c, t, true)

/// `sc`'s type with each type variable an `Int`, as the runtime enters a generic root.
fn judged_type(sc: Scheme) -> Type = substituted(sc.ty, judged_args(sc.ty_vars))

/// An `Int` for each of `vars`, by its number, as `keys.claims_key` names them.
fn judged_args(vars: List<Int>) -> List<Type> =
  range(0, vars.fold(0, |w: Int, v: Int| max(w, v + 1))).map(|_: Int| int_type())

/// `out` and, where `wanted` holds it, the entry the runtime enters root `root` through, `root`
/// typed by `scheme`, each type variable an `Int` and each row variable the empty row: a definition
/// called by name at those, as any caller calls it, and a claim root as it is judged. The call runs
/// under the real handler of each effect `scheme`'s row names that `hosts` holds.
fn with_entry(
  s: ModuleContext,
  wanted: Map<RootName, Bool>,
  hosts: Map<Bytes, RealHandler>,
  root: RootKey,
  scheme: Option<Scheme>,
  out: List<Fn>,
) -> List<Fn> / {abort.raise} = {
  let key = EntryPoint(root);
  if !wants_root(wanted, key) { out } else {
    match scheme {
      Some(sc) -> match sc.ty {
        FunctionType(f) -> {
          let ints = judged_args(sc.ty_vars);
          let called = match root {
            Named(_) ->
              {
                callee: root,
                at: sc.ty_vars.map(|_: Int| int_type()),
                rows: sc.row_vars.map(|_: Int| row_empty()),
              },
            _ -> { callee: judged_callee(root, sc.ty_vars.len()), at: [], rows: [] },
          };
          let hosted = handlers_for(hosts, f.effects.atoms.map(|a: Atom| a.effect));
          let e = runtime_entry_code(
            s.module,
            root,
            called.callee,
            called.at,
            called.rows,
            f.params.map(|t: Type| substituted(t, ints)),
            substituted(f.ret, ints),
            f.effects,
            hosted.map(|h: { effect: Bytes, hosting: RealHandler }|
              { call: h.hosting.call, effect: h.effect, adds: added_by(h.hosting) }),
            pure: s.here.any(|d: Def| d.root == called.callee && d.pure),
          );
          out.push(
            root_from_code(
              {
                ..s,
                here: s.here.concat(e.here),
                imports: s.imports.concat(
                  hosted.map(|h: { effect: Bytes, hosting: RealHandler }| h.hosting.import),
                ),
              },
              0,
              key,
              e.params,
              e.code,
              e.performs,
            ),
          )
        },
        _ -> panic("an entry of no function"),
      },
      None -> panic("an entry of a root no scheme types"),
    }
  }
}

/// The atoms real handler `h`'s own row adds to what it answers, as its definition's scheme
/// writes them.
fn added_by(h: RealHandler) -> List<Atom> =
  h.import.defs.fold([], |acc: List<Atom>, d: Def|
    match d.scheme {
      Some(sc) -> match sc.ty { FunctionType(f) -> acc.concat(f.effects.atoms), _ -> acc },
      None -> acc,
    })

/// What the entry of claim root `root`, over `vars` type variables, calls: `root` itself where it
/// has none, else a clause at the specialisation its definition is judged at (`claims_key`).
fn judged_callee(root: RootKey, vars: Int) -> RootKey =
  if vars == 0 { root } else {
    match root {
      Clause(c) -> match c.def { Named(d) -> Clause({ ..c, def: claims_key(d, vars) }), _ -> root },
      _ -> root,
    }
  }

/// `out` and, where `wanted` holds it, the entry of the claim root `root` taking `params`, over the
/// type variables `vars` of the definition a clause states of: a judge enters a law's guard or body
/// with its binders' values, and a clause with the values it states over.
fn with_claim_entry(
  s: ModuleContext,
  wanted: Map<RootName, Bool>,
  root: RootKey,
  params: List<EmitParam>,
  vars: List<Int>,
  out: List<Fn>,
) -> List<Fn> / {abort.raise} =

  // A claim performs nothing, so it runs under no real handler.
  with_entry(
    s,
    wanted,
    Map::new(),
    root,
    Some({
      ..monomorphic(fn_type(params.map(param_type), bool_type(), row_empty())),
      ty_vars: vars,
    }),
    out,
  )

/// The label parameters `d` takes after its own, each a hidden trailing `Int`: the caller passes the
/// resource's field-table entry.
fn labels_of(d: FnDef) -> List<Bytes> = d.generics.labels.map(|i: Ident| i.name)

/// `requires` and `ensures` clauses as roots, each over the definition's parameters, and an
/// `ensures` over `result` too.
fn clause_roots(
  acc: RootForms,
  def: FnDef,
  s: ModuleContext,
  wanted: Map<RootName, Bool>,
  filed: SiteAnnotations,
  schemes: Map<Bytes, Scheme>,
) -> RootForms / {abort.raise} = {
  let full = qualify(s.module, def.name.name);
  let vars = match schemes.get(full) { Some(sc) -> sc.ty_vars, None -> [] };
  let ints = judged_args(vars);
  let base = def.span.start;
  let clause = |kind: ClauseKind, k: Int| Clause({ def: Named(full), kind: kind, n: k });
  // A clause, a generic definition's also at the specialisation its entry calls, and its entry.
  let rooted = |out: List<Fn>, key: RootKey, at: Int| {
    let b = settled_at(filed, ClauseBody(at), base, []);
    let ps = root_params(b, []);
    let own = if !wants_root(wanted, key) { out }
    else { out.push(root_from_code(s, base, key, ps, body_code(b, [], filed))) };
    let callee = judged_callee(key, vars.len());
    let specialised = if callee == key || !wants_root(wanted, callee) { own } else {
      let sp = root_body(filed, ClauseBody(at), base, [], ints);
      own.push(root_from_code(s, base, callee, sp.params, sp.code))
    };
    with_claim_entry(s, wanted, key, ps, vars, specialised)
  };
  let walked = def.spec.fold(
    { out: acc.out, requires: 0, ensures: 0, at: 0 },
    |w: { out: List<Fn>, requires: Int, ensures: Int, at: Int }, c: SpecClause| {
      let next = { ..w, at: w.at + 1 };
      match c.kind {
        RequiresClause ->
          {
            ..next,
            out: rooted(w.out, clause(Requires, w.requires), w.at),
            requires: w.requires + 1,
          },
        EnsuresClause -> match def.ret {
          None -> { ..next, ensures: w.ensures + 1 },
          Some(_) ->
            {
              ..next,
              out: rooted(w.out, clause(Ensures, w.ensures), w.at),
              ensures: w.ensures + 1,
            },
        },
        // A bound is read off the body, and never run.
        CostClause -> next,
        SpaceClause -> next,
      }
    },
  );
  { out: walked.out }
}

/// The roots `wanted` keys, resolved against the whole program: one entry per root, in its order.
/// `embeds` is what the front end's
/// answer says it embedded, `rows` what it published for every definition and test, which spare a
/// walk of every module no wanted root is in, `effects` what it published of every effect,
/// `walked` what its check read of the modules it walked whole, which spares a walk of those too,
/// and `published` the handings of the definitions other answers hold, which the calls of these are
/// written against.
pub fn emit_root_results(
  names: List<Bytes>,
  srcs: List<Bytes>,
  ctors: Ctors,
  wanted: List<RootKey>,
  pkgs: List<PackageDeps>,
  module_packages: List<Int>,
  embeds: List<ModuleEmbed>,
  rows: Rows,
  effects: List<EffectRow>,
  walked: Bytes,
  published: List<PublishedSignature> = [],
) -> List<RootOutput> / {abort.raise} =
  results_of(
    lowered_roots(
      names,
      srcs,
      ctors,
      wanted,
      pkgs,
      module_packages,
      embeds,
      rows,
      effects,
      walked,
      published,
    ),
  )

/// The roots `wanted` keys lowered as `emit_root_results` asks, before their counts are placed.
pub fn lowered_roots(
  names: List<Bytes>,
  srcs: List<Bytes>,
  ctors: Ctors,
  wanted: List<RootKey>,
  pkgs: List<PackageDeps>,
  module_packages: List<Int>,
  embeds: List<ModuleEmbed>,
  rows: Rows,
  effects: List<EffectRow>,
  walked: Bytes,
  published: List<PublishedSignature> = [],
) -> LoweredProgram / {abort.raise} =
  lowered_program(
    zip_sources(names, srcs),
    ctors,
    true,
    wanted,
    pkgs,
    module_packages,
    embeds,
    rows,
    effects,
    walked,
    published,
  )

/// The answer of each root `w` holds, emitted as `emitted_program` emits it.
pub fn results_of(w: LoweredProgram) -> List<RootOutput> / {abort.raise} =
  emitted_program(w).map(result_of)

fn result_of(e: EmittedRoot) -> RootOutput =
  { name: e.name, result: { text: e.text, tables: e.tables } }

pub fn zip_sources(names: List<Bytes>, srcs: List<Bytes>) -> List<Source> =
  range(0, names.len()).map(|i: Int|
    {
      name: match names.at(i) { Some(n) -> n, None -> b"" },
      src: match srcs.at(i) { Some(t) -> t, None -> b"" },
    })

test "an effect whose real handler the emitter holds no definition of stops the emitter, not left unhosted" {
  let fact = {
    name: b"std.fact",
    module: parse(b"pub effect fact {\n  read get() -> Int\n}\nhost for fact by served\n").node,
    derived: [],
  };
  let diagnostics_text = handle {
    real_handlers([fact], |_: Bytes| []);
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert(
    diagnostics_text.contains(b"the real handler `served` of `std.fact.fact` is no definition"),
    None,
  )
}
