/// What an arm that refuses a program before lowering anything can say: the checker's own words, one
/// per diagnostic. There is no renderer for a diagnostic on this side -- the driver's `explain` has
/// the prose -- so the code and the message are what a refusal carries.
pub fn said(diags: List<Diag>) -> Bytes =
  match diags {
    [] -> b"a program the emitter will not lower, and no diagnostic explains it",
    _ ->
      bytes_join(
        diags.map(|diag: Diag| Bytes::concat_all([diag.code, b": ", diag.message])),
        b"; ",
      ),
  }

/// The same for the parser's diagnostics, which are a different record: a module that does not parse
/// has not reached the point where the other kind exist.
fn said_p(diags: List<ParseDiag>) -> Bytes =
  match diags {
    [] -> b"a module the emitter cannot parse, and no diagnostic explains it",
    _ ->
      bytes_join(
        diags.map(|diag: ParseDiag| Bytes::concat_all([diag.code, b": ", diag.message])),
        b"; ",
      ),
  }

/// Every root the caller wanted, refused for the same reason. An arm that refuses a whole program has
/// no body to hang the reason on, and the answer's reader keys a refusal by root name, so the refusal
/// has to ride on the roots it was asked for.
pub fn refused_rather_than_emitted(wanted: List<RootKey>, why: Bytes) -> List<RootForm> =
  wanted_names(wanted).keys().map(|n: RootName| Unformed({ name: n, why: why }))

/// The names the roots `wanted` print as, each once.
fn wanted_names(wanted: List<RootKey>) -> Map<RootName, Bool> =
  wanted.fold(Map::new(), |m: Map<RootName, Bool>, k: RootKey| m.insert(root_name(k), true))

/// Whether `wanted` names root `k`.
fn wants_root(wanted: Map<RootName, Bool>, k: RootKey) -> Bool = wanted.contains(root_name(k))

/// The roots written for a type that `wanted` holds, each once and in the order of their names, with
/// the module each is written in.
fn written_wanted(
  wanted: List<RootKey>,
) -> List<{ key: RootKey, op: TypeOp, ty: Type, module: Bytes }> / {abort.raise} =
  wanted.fold(
    Map::new(),
    |m: Map<RootName, { key: RootKey, op: TypeOp, ty: Type, module: Bytes }>, k: RootKey|
      match k {
        Written(w) -> m.insert(root_name(k), { key: k, op: w.op, ty: w.ty, module: module_of(k) }),
        _ -> m,
      },
  ).values(
  )

/// What a program walk lowered, in its order: each root's form or refusal, each constructor's
/// stated functions, which a body naming the constructor's tag calls once it is printed, the
/// program's constructor table, which the printers read, the parameters each definition lends by
/// declaration (E0475), by its root's name, and the handings the definitions lowered elsewhere
/// publish.
pub type Walked = {
  roots: List<RootForm>,
  stated: Map<Bytes, List<Bytes>>,
  ctors: Ctors,
  lent: Map<RootName, List<Int>>,
  published: List<Published>,
}

/// The roots `roots` keys of the program `given` emitted: `lowered_program`'s forms, each counted,
/// checked and printed.
pub fn emit_program(
  given: List<Source>,
  ctors: Ctors,
  builtins: List<Bytes>,
  release: Bool,
  roots: List<RootKey>,
  pkgs: List<PackageDeps>,
  placed: List<Int>,
  embeds: List<EmbedAt>,
  rows: Rows,
  walked: Bytes,
  published: List<Published> = [],
) -> List<Emitted> / {abort.raise} =
  emitted_program(
    lowered_program(
      given,
      ctors,
      builtins,
      release,
      roots,
      pkgs,
      placed,
      embeds,
      rows,
      walked,
      published,
    ),
  )

/// Each root `w` holds written against the handings the lending inference settles for the
/// definitions it lowered (`w.published` standing for the rest), its counts placed, checked and
/// printed, and its tables holding what lending settled of it; or its refusal. A form the typed form
/// declined, or one that fails its check or does not print, stops the build there.
pub fn emitted_program(w: Walked) -> List<Emitted> / {abort.raise} = {
  let forms = w.roots.fold([], |acc: List<Fn>, r: RootForm|
    match r { Formed(f) -> match f.form { Ok(x) -> acc.push(x), Err(_) -> acc }, _ -> acc });
  let settled = handings_of(lendings_of(w.lent, forms), handed_from(w.published));
  w.roots.map(|r: RootForm|
    match r {
      Formed(f) -> match f.form {
        Ok(x) -> {
          let l = lent_form(x, settled);
          let e = calling_instances(
            w.stated,
            emitted_of(Formed({ ..f, form: Ok(l.form) }), w.ctors),
          );
          { ..e, tables: { ..e.tables, handings: l.handings, assumed: l.assumed, group: l.group } }
        },
        Err(_) -> calling_instances(w.stated, emitted_of(r, w.ctors)),
      },
      _ -> calling_instances(w.stated, emitted_of(r, w.ctors)),
    })
}

/// Resolved together first, so defaults are filled and derives expanded; a program that does not resolve lowers nothing.
/// Every root is resolved against, but only the roots `roots` keys are lowered. `pkgs` and `placed`
/// are the program's package tables, empty for one without packages: resolution then treats every
/// module as one package's, which is what no packages means.
pub fn lowered_program(
  given: List<Source>,
  ctors: Ctors,
  builtins: List<Bytes>,
  release: Bool,
  roots: List<RootKey>,
  pkgs: List<PackageDeps>,
  placed: List<Int>,
  embeds: List<EmbedAt>,
  rows: Rows,
  walked: Bytes,
  published: List<Published> = [],
) -> Walked / {abort.raise} = {
  let wanted = wanted_names(roots);
  // Every module imports `std.prelude`, which a caller may leave out; it is a shipped module.
  let sources = with_prelude_source(given);
  let refused = |why: Bytes|
    {
      roots: refused_rather_than_emitted(roots, why),
      stated: Map::new(),
      ctors: ctors,
      lent: Map::new(),
      published: published,
    };
  let module_packages = if sources.len() == given.len() || pkgs.len() == 0 { placed }
  else { placed.push(pkgs.len()) };
  let tables = embed_tables(embeds);
  let parsed = range(0, sources.len()).map(|i: Int| {
    let s = match sources.at(i) { Some(x) -> x, None -> { name: b"", src: b"" } };
    let r = parse(s.src);
    let x = expand(with_prelude(s.name, r.node), r.parser.diags);
    let d = expand_derives(i, s.name, x.module);
    let e = rewritten(tables, s.name, d.module);
    {
      name: s.name,
      module: e.module,
      derived: d.derived,
      bad: r.parser.diags.len() > 0 || d.diags.len() > 0 || e.diags.len() > 0,
      // A module that does not parse is not also reported against what its recovery expanded to.
      why: if r.parser.diags.len() > 0 { said_p(r.parser.diags) }
      else if d.diags.len() > 0 { said(d.diags) }
      else { said_p(e.diags) },
    }
  });
  match parsed.fold(
      None,
      |acc: Option<Bytes>, p: { name: Bytes, module: Module, derived: List<Derived>, bad: Bool, why: Bytes }|
        match acc { Some(_) -> acc, None -> if p.bad { Some(p.why) } else { None } },
    ) {
    Some(why) -> refused(why),
    None -> {
      let mods0: List<ParsedModule> = parsed.map(
        |p: { name: Bytes, module: Module, derived: List<Derived>, bad: Bool, why: Bytes }|
          { name: p.name, module: p.module, derived: p.derived },
      );
      // The published table ends with the built-in packages; the shipped modules sit one past them.
      let packaged = if pkgs.len() == 0 { no_packages(mods0) } else {
        {
          pkgs: pkgs,
          module_packages: module_packages,
          std: pkgs.len() - 2,
          compiler: pkgs.len() - 1,
          shipped: pkgs.len(),
        }
      };
      match resolve_packaged(
          mods0,
          packaged.pkgs,
          packaged.module_packages,
          packaged.std,
          packaged.compiler,
          packaged.shipped,
        ) {
        ResolveFailed(diags) -> refused(said(diags)),
        ResolveSucceeded(x) -> {
          let schemes = rows.defs.fold(Map::new(), |acc: Map<Bytes, Scheme>, row: KnownDefRow|
            acc.insert(row.name, row.scheme));
          match walked_read(walked) {
            None ->
              refused(
                b"the front end's answer carries nothing its check read, so nothing is lowered from it",
              ),
            Some(w) -> {
              let pure = w.pure.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Bytes|
                acc.insert(n, true));
              // A root's module is read from its key: a written root's name does not spell it.
              let reading = reading_of(rows, w, x.mods, x.r.signatures, pure, schemes, roots);
              let lowered = modules_lowered(roots);
              match facts_read(rows, w, Some({ roots: reading, modules: lowered }), x.mods) {
                Err(why) -> refused(why),
                Ok(facts) -> {
                  // The checker has the shape of every update, so the literals they stand for are written in here.
                  let mods: List<ParsedModule> = expanded_mods(
                    x.mods,
                    facts.elaboration,
                    x.r.signatures,
                  );
                  let program = mods.map(|m: ParsedModule|
                    { module: m.name, defs: defs_in(m.name, m.module, pure, schemes) });
                  let stated = stated_by_tag(mods);
                  let ctors = {
                    ..ctors,
                    keyed: keyed_tags(mods).fold(ctors.keyed, |acc: List<Bytes>, k: Bytes|
                      if acc.contains(k) { acc } else { acc.push(k) }),
                  };
                  let defs_of = |path: Bytes|
                    program.fold([], |acc: List<Def>, md: ModuleDefs|
                      if md.module == path { md.defs } else { acc });
                  // What the check filed of each item's nodes, which its roots and the lambdas it lends
                  // are read under.
                  let owned = facts_by_item(facts);
                  let filed_of = |owner: Bytes| filings_of(owned, owner);
                  // Each lowered module's definitions and imports.
                  let tables_of = |i: Int, m: ParsedModule|
                    {
                      here: defs_in(m.name, m.module, pure, schemes),
                      imports: resolved_imports(
                        x.r,
                        i,
                        mods,
                        m.module,
                        defs_of,
                        facts.elaboration.members.filter(|s: MemberSite| s.module == i),
                      ),
                    };
                  let tables = range(0, mods.len()).map(|i: Int|
                    match mods.at(i) {
                      Some(m) -> if lowered.contains(m.name) { Some(tables_of(i, m)) }
                      else { None },
                      None -> None,
                    });
                  let tables_at = |i: Int, m: ParsedModule|
                    match tables.at(i) { Some(Some(t)) -> t, _ -> tables_of(i, m) };
                  let specialised = specialisations_wanted(roots);
                  let written_roots = written_wanted(roots);
                  // What an owner lends: its lambdas, read where it lowers them, a definition as it stands
                  // or at the type arguments the owner's key gives; past the first `lambdas` it writes are
                  // the definitions it names as values.
                  let owner_read = |owner: RootKey| {
                    let of = match owner {
                      At(a) -> { base: a.def, args: key_types(owner), lends: a.lent.len() == 0 },
                      _ -> { base: filed_as(owner), args: [], lends: true },
                    };
                    let module = module_of(owner);
                    let short = default_binder(of.base);
                    // The lambdas `code`, the owner's body in module `i`, writes, read under `filed`.
                    let lent = |i: Int, m: ParsedModule, code: Code, filed: Result<Filings, Bytes>, base: Int| {
                      let tab = tables_at(i, m);
                      let emitted = known_body(root_text(root_name(owner)), [], code);
                      let lambdas = lambdas_of(emitted);
                      let written = lambdas.concat(
                        named_in(m.name, tab.here, tab.imports, emitted),
                      );
                      match ((written.at(0), filed)) {
                        (Some(first), Ok(f)) ->
                          Some({
                            lambdas: lambdas.len(),
                            bound: {
                              owner: owner,
                              nth: 0,
                              code: first,
                              named: false,
                              module: m.name,
                              here: tab.here,
                              imports: tab.imports,
                              effects: effects_in(x.r, i, mods),
                              filed: f,
                              base: base,
                              written: written,
                            },
                          }),
                        _ -> None,
                      }
                    };
                    match range(0, mods.len()).fold(None, |acc: Option<Int>, k: Int|
                        match acc {
                          Some(_) -> acc,
                          None -> if mods.get(k).name == module { Some(k) } else { None },
                        }) {
                      None -> None,
                      Some(i) -> {
                        let m = mods.get(i);
                        match m.module.items.fold(None, |acc: Option<FnDef>, item: Item|
                            match item {
                              IFn(d) -> if d.name.name == short && of.lends { Some(d) }
                              else { acc },
                              _ -> acc,
                            }) {
                          // A test's lambdas, as its root lowers its run.
                          None -> match m.module.items.fold(
                              None,
                              |acc: Option<TestDef>, item: Item|
                                match item {
                                  ITest(t) -> if test_key(m.name, t.name) == owner { Some(t) }
                                  else { acc },
                                  _ -> acc,
                                },
                            ) {
                            None -> None,
                            Some(t) -> {
                              let filed = filed_of(filed_as(owner));
                              match lower_fn(
                                  if t.cases != None { [case_at(), case_identity()] } else { [] },
                                  [],
                                  labels_of(filed),
                                  test_run(t),
                                  of_binder(m.name),
                                ) {
                                Err(_) -> None,
                                Ok(l) -> lent(i, m, l.code, filed, t.span.start),
                              }
                            },
                          },
                          Some(d) -> {
                            let source = definition_at(
                              of.base,
                              d,
                              of.args,
                              schemes,
                              facts.elaboration.ops.filter(|o: WitnessOp| o.module == i),
                            );
                            let filed = filed_of(of.base);
                            match lower_fn(
                                d.params.map(|param: Param| param.name.name),
                                d.generics.labels.map(|ident: Ident| ident.name),
                                labels_of(filed),
                                source.body,
                                of_binder(m.name),
                              ) {
                              Err(_) -> None,
                              Ok(l) ->
                                lent(
                                  i,
                                  m,
                                  l.code,
                                  match filed {
                                    Ok(f) ->
                                      Ok(if of.args.len() == 0 { f }
                                      else { filings_at(f, of.args) }),
                                    Err(why) -> Err(why),
                                  },
                                  d.span.start,
                                ),
                            }
                          },
                        }
                      },
                    }
                  };
                  // Each owner a wanted specialisation runs a lambda of is read once, for all of them.
                  let lent_by = specialised.fold(
                    Map::new(),
                    |acc: Map<RootName, Option<OwnerLambdas>>, _: Bytes, sps: List<RootKey>|
                      sps.fold(acc, |held: Map<RootName, Option<OwnerLambdas>>, sp: RootKey|
                        key_lent(sp).fold(
                          held,
                          |h: Map<RootName, Option<OwnerLambdas>>, f: FnArg| {
                            let name = root_name(f.owner);
                            if h.contains(name) { h } else { h.insert(name, owner_read(f.owner)) }
                          },
                        )),
                  );
                  let lambda_at = |owner: RootKey, nth: Int|
                    match match lent_by.get(root_name(owner)) {
                        Some(o) -> o,
                        None -> owner_read(owner),
                      } {
                      None -> None,
                      Some(o) -> match o.bound.written.at(nth) {
                        None -> None,
                        Some(code) ->
                          Some({ ..o.bound, nth: nth, code: code, named: nth >= o.lambdas }),
                      },
                    };
                  let declared = declared_schemes();
                  {
                    roots: range(0, mods.len()).fold([], |acc: List<RootForm>, i: Int|
                      match mods.at(i) {
                        None -> acc,
                        Some(m) -> if !lowered.contains(m.name) { acc } else {
                          let tab = tables_at(i, m);
                          acc.concat(
                            module_formed(
                              m.module,
                              {
                                module: m.name,
                                here: tab.here,
                                imports: tab.imports,
                                ctors: ctors,
                                builtins: builtins,
                                declared: declared,
                                effects: effects_in(x.r, i, mods),
                                release: release,
                              },
                              schemes,
                              wanted,
                              written_roots.filter(
                                |w: { key: RootKey, op: TypeOp, ty: Type, module: Bytes }|
                                  w.module == m.name,
                              ).map(|w: { key: RootKey, op: TypeOp, ty: Type, module: Bytes }|
                                { key: w.key, op: w.op, ty: w.ty }),
                              specialised,
                              filed_of,
                              reading,
                              facts.elaboration.ops.filter(|o: WitnessOp| o.module == i),
                              lambda_at,
                            ),
                          )
                        },
                      }),
                    stated: stated,
                    ctors: ctors,
                    lent: program.fold(Map::new(), |m: Map<RootName, List<Int>>, md: ModuleDefs|
                      declared_lent(m, md.module, md.defs)),
                    published: published,
                  }
                },
              }
            },
          }
        },
      }
    },
  }
}

/// The owners whose facts a walk for roots `ks` of `mods` reads: the owner each root is filed under,
/// that of the root its body is read with, and that of each owner of a lambda it runs in place, and
/// for a specialisation each other definition that runs in one tail loop with its own, which the
/// specialisation's loop takes in.
fn reading_of(
  rows: Rows,
  w: WalkedFacts,
  mods: List<ParsedModule>,
  signatures: Map<Bytes, Parameters>,
  pure: Map<Bytes, Bool>,
  schemes: Map<Bytes, Scheme>,
  ks: List<RootKey>,
) -> Map<Bytes, Bool> / {abort.raise} = {
  let sited = ks.fold(Map::new(), |acc: Map<Bytes, Bool>, k: RootKey|
    key_lent(k).fold(
      acc.insert(filed_as(k), true).insert(filed_as(read_with(k)), true),
      |r: Map<Bytes, Bool>, f: FnArg| r.insert(filed_as(f.owner), true),
    ));
  let specialised = ks.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, k: RootKey|
    match k {
      At(a) -> {
        let m = module_of(k);
        let had = match acc.get(m) { Some(ds) -> ds, None -> [] };
        if had.contains(a.def) { acc } else { acc.insert(m, had.push(a.def)) }
      },
      _ -> acc,
    });
  range(0, mods.len()).fold(sited, |acc: Map<Bytes, Bool>, i: Int|
    match specialised.get(mods.get(i).name) {
      None -> acc,
      Some(owners) ->
        loop_mates(rows, w, mods, signatures, pure, schemes, i, owners).fold(
          acc,
          |r: Map<Bytes, Bool>, n: Bytes| r.insert(n, true),
        ),
    })
}

/// The root whose facts root `k`'s body is read with: a clause's definition, a listing's test, and
/// any other root itself.
fn read_with(k: RootKey) -> RootKey = match k { Clause(c) -> c.def, Cases(t) -> t, _ -> k }

/// The definitions of module `i` of `mods` that run in one tail loop with one of `owners`. Each body
/// is read written out with what the check filed of it, so a call written on a value is among its
/// tail calls: the facts of each definition the owners' tail calls reach are read, until those calls
/// reach no definition more.
fn loop_mates(
  rows: Rows,
  w: WalkedFacts,
  mods: List<ParsedModule>,
  signatures: Map<Bytes, Parameters>,
  pure: Map<Bytes, Bool>,
  schemes: Map<Bytes, Scheme>,
  i: Int,
  owners: List<Bytes>,
) -> List<Bytes> / {abort.raise} = {
  let name = mods.get(i).name;
  let walk = |read: Map<Bytes, Bool>|
    match facts_read(rows, w, Some({ roots: read, modules: Map::new().insert(name, true) }), mods) {
      Err(_) -> None,
      Ok(facts) -> {
        let m = expanded_mod(mods, i, facts.elaboration, signatures);
        let here = defs_in(name, m.module, pure, schemes);
        let owned = facts_by_item(facts);
        let defs = m.module.items.fold(Map::new(), |d: Map<Bytes, FnDef>, item: Item|
          match item { IFn(f) -> d.insert(qualify(name, f.name.name), f), _ -> d });
        let read_of = |full: Bytes|
          match defs.get(full) {
            None -> None,
            Some(f) -> {
              let filed = filings_of(owned, full);
              Some({ code: written_code_of(name, f, filed), filed: filed })
            },
          };
        Some({
          reached: owners.fold(Map::new(), |r: Map<Bytes, Bool>, o: Bytes|
            tail_reached_defs(name, here, read_of, o).fold(
              r,
              |s: Map<Bytes, Bool>, n: Bytes, _: Bool| s.insert(n, true),
            )),
          mates: owners.fold([], |ms: List<Bytes>, o: Bytes|
            ms.concat(tail_mates(name, here, read_of, o))),
        })
      },
    };
  iterate(
    { read: owners.fold(Map::new(), |r: Map<Bytes, Bool>, o: Bytes| r.insert(o, true)), mates: [] },
    schemes.len() + 1,
    |s: { read: Map<Bytes, Bool>, mates: List<Bytes> }|
      match walk(s.read) {
        None -> Stop(s),
        Some(r) -> {
          // A definition the check has no facts of, an extern's, has no body to reach further.
          let more = r.reached.keys().filter(|n: Bytes| !s.read.contains(n) && schemes.contains(n));
          if more.len() == 0 { Stop({ ..s, mates: r.mates }) } else {
            Continue({
              ..s,
              read: more.fold(s.read, |m: Map<Bytes, Bool>, n: Bytes| m.insert(n, true)),
            })
          }
        },
      },
  ).mates
}

/// Each constructor whose type's module states a `key`, which its values are compared by.
fn keyed_tags(mods: List<ParsedModule>) -> List<Bytes> =
  mods.fold([], |acc: List<Bytes>, m: ParsedModule|
    m.module.items.fold(acc, |a: List<Bytes>, item: Item|
      match item {
        IInstance(d) -> if d.kind != NKey { a }
        else { a.concat(stating(m, Map::new(), d.target.name, [d.by.name]).keys()) },
        _ -> a,
      }))

/// Each constructor whose type's module states a `key` or a `show`, with those functions under
/// their program-wide names.
fn stated_by_tag(mods: List<ParsedModule>) -> Map<Bytes, List<Bytes>> =
  mods.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, m: ParsedModule|
    m.module.items.fold(acc, |a: Map<Bytes, List<Bytes>>, item: Item|
      match item {
        IInstance(d) -> stating(m, a, d.target.name, [d.by.name]),
        INumeric(d) -> stating(m, a, d.target.name, d.ops.map(|x: NumericOp| x.by.name)),
        _ -> a,
      }))

/// `stated` with `fns` of module `m` under each constructor of its type `target`.
fn stating(
  m: ParsedModule,
  stated: Map<Bytes, List<Bytes>>,
  target: Bytes,
  fns: List<Bytes>,
) -> Map<Bytes, List<Bytes>> =
  m.module.items.fold(stated, |b: Map<Bytes, List<Bytes>>, other: Item|
    match other {
      IType(t) -> if t.name.name != target { b } else {
        match t.body {
          TDSum(variants) ->
            variants.fold(b, |c: Map<Bytes, List<Bytes>>, v: VariantDef| {
              let tag = qualify(m.name, v.name.name);
              c.insert(
                tag,
                fns.fold(
                  match c.get(tag) { Some(fs) -> fs, None -> [] },
                  |fs: List<Bytes>, f: Bytes| fs.push(qualify(m.name, f)),
                ),
              )
            }),
          _ -> b,
        }
      },
      _ -> b,
    })

/// The constructors a body's C names a tag of, as its placeholders spell them.
fn tags_named(text: Bytes) -> List<Bytes> / {abort.raise} =
  iterate({ from: 0, out: [] }, text.len() + 1, |s: { from: Int, out: List<Bytes> }|
    match text.index_of_from(b"@@", s.from) {
      None -> Stop(s.out),
      Some(open) -> match text.index_of_from(b"@@", open + 2) {
        None -> Stop(s.out),
        Some(close) ->
          Continue({
            from: close + 2,
            out: if text.at(open + 2) == 84 { s.out.push(text.slice(open + 3, close)) }
            else { s.out },
          }),
      },
    })

/// A body that names a constructor's tag holds values the runtime reads through what the type's
/// module states of it, wherever they are compared or shown: so it calls those functions, which the
/// unit then takes with it and a kept answer is checked against.
fn calling_instances(stated: Map<Bytes, List<Bytes>>, e: Emitted) -> Emitted / {abort.raise} =
  if stated.len() == 0 { e } else {
    match e.why {
      Some(_) -> e,
      None ->
        {
          ..e,
          tables: {
            ..e.tables,
            calls: tags_named(e.text).fold(e.tables.calls, |acc: List<RootKey>, tag: Bytes|
              match stated.get(tag) {
                None -> acc,
                Some(fs) ->
                  fs.fold(acc, |calls: List<RootKey>, f: Bytes|
                    if calls.contains(Named(f)) { calls } else { calls.push(Named(f)) }),
              }),
          },
        },
    }
  }

/// The roots `wanted` names of the module `s` reads, formed in its order: its definitions, each
/// definition's specialisations and clauses, its tests and laws, and the roots written for its types
/// that `written_roots` keys. `filed_of` is what the checker filed of each item's nodes, by the
/// item's owner, read for the owners `reading` names.
fn module_formed(
  x_module: Module,
  s: Setting,
  schemes: Map<Bytes, Scheme>,
  wanted: Map<RootName, Bool>,
  written_roots: List<{ key: RootKey, op: TypeOp, ty: Type }>,
  specialised: Map<Bytes, List<RootKey>>,
  filed_of: (Bytes) -> Result<Filings, Bytes> / {abort.raise},
  reading: Map<Bytes, Bool>,
  ops: List<WitnessOp>,
  lambda_at: (RootKey, Int) -> Option<BoundLambda> / {abort.raise},
) -> List<RootForm> / {abort.raise} = {
  let module = s.module;
  let here = s.here;
  let fns = x_module.items.fold([], |acc: List<Prepared>, item: Item|
    match item { IFn(d) -> acc.push(prepare(module, schemes, wanted, filed_of, d)), _ -> acc });
  let prepared = fns.fold(Map::new(), |m: Map<Bytes, Prepared>, p: Prepared| m.insert(p.full, p));
  let defs = x_module.items.fold(Map::new(), |m: Map<Bytes, FnDef>, item: Item|
    match item { IFn(d) -> m.insert(qualify(module, d.name.name), d), _ -> m });
  let order = x_module.items.fold(Map::new(), |m: Map<Bytes, Int>, item: Item|
    match item { IFn(d) -> m.insert(qualify(module, d.name.name), m.len()), _ -> m });
  // A definition a walk of tail calls reaches, its body lowered as written: once already where a
  // root of it is wanted. One whose facts were not read is no part of a loop formed here.
  let read_of = |full: Bytes|
    match if reading.contains(full) { defs.get(full) } else { None } {
      None -> None,
      Some(d) -> {
        let filed = match prepared.get(full) { Some(p) -> p.filed, None -> filed_of(full) };
        Some({
          code: match prepared.get(full) {
            Some(p) -> match p.code { Ok(c) -> Ok(c), Err(_) -> written_code_of(module, d, filed) },
            None -> written_code_of(module, d, filed),
          },
          filed: filed,
        })
      },
    };
  // `out` with the loop root `key` runs in, formed once under its first member; none where `key`
  // loops with no other root.
  let looped = |out: List<RootForm>, key: RootKey|
    match instance_group(s, order, read_of, key) {
      Err(why) -> Some(out.push(Unformed({ name: root_name(key), why: why }))),
      Ok(keys) -> if keys.len() < 2 { None }
      else if out.any(|r: RootForm| form_name(r) == root_name(keys.get(0))) { Some(out) }
      else { Some(out.concat(instances_formed(s, schemes, ops, defs, read_of, keys))) },
    };
  let walked = x_module.items.fold({ out: [], fns: 0 }, |acc: Walk, item: Item|
    match item {
      IFn(d) -> {
        let p = match fns.at(acc.fns) {
          Some(q) -> q,
          None -> prepare(module, schemes, wanted, filed_of, d),
        };
        let specialisations = (match specialised.get(p.full) { Some(l) -> l, None -> [] }).fold(
          acc.out,
          |a: List<RootForm>, sp: RootKey|

            // One running lambdas in place leaves the loop: its calls hand them on as values.
            match if key_lent(sp).len() > 0 { None } else { looped(a, sp) } {
              Some(out) -> out,
              None -> a.push(specialised_formed(s, d, sp, lambda_at, schemes, ops, p.filed)),
            },
        );
        let out = if !wants_root(wanted, Named(p.full)) { specialisations } else {
          match looped(specialisations, Named(p.full)) {
            Some(o) -> o,
            None ->
              specialisations.push(
                witnessed_needs(
                  formed_from(s, p.base, Named(p.full), p.ps, p.known, p.code, p.filed),
                  d,
                  schemes.get(p.full),
                  ops,
                ),
              ),
          }
        };
        clause_roots(
          {
            out: {
              let entered = entering(s, wanted, Named(p.full), schemes.get(p.full), out);
              // Only a `const` definition has a stored root, which a build enters.
              if d.baked == None { entered } else {
                entering(
                  s,
                  wanted,
                  Stored(Named(p.full)),
                  Some(monomorphic(fn_type([], bytes_type(), row_empty()))),
                  storing(s, wanted, p.full, schemes.get(p.full), entered),
                )
              }
            },
            fns: acc.fns + 1,
          },
          d,
          p.names,
          p.kinds,
          s,
          sig_of(schemes, qualify(module, d.name.name)),
          wanted,
          p.filed,
        )
      },
      // A test is a root named by its label: nullary, or over cases entered with a case's place
      // and identity beside a nullary root that lists them.
      ITest(t) -> {
        let tested = test_key(module, t.name);
        let filed = filed_of(filed_as(tested));
        let ps = if t.cases == None { [] } else {
          [
            { name: case_at(), kind: KInt, ty: TyOpen([]), of: Some(int_type()), lambda: None },
            {
              name: case_identity(),
              kind: KBoxed,
              ty: TyBytes,
              of: Some(bytes_type()),
              lambda: None,
            },
          ]
        };
        let rooted = |key: RootKey, taken: List<EmitParam>, body: Expr|
          root_formed(
            s,
            t.span.start,
            key,
            taken.map(|p: EmitParam| p.name),
            taken,
            true,
            filed,
            body,
          );
        let run = entering(
          s,
          wanted,
          tested,
          Some(monomorphic(fn_type(ps.map(param_type), unit_type(), row_empty()))),
          if !wants_root(wanted, tested) { acc.out }
          else { acc.out.push(rooted(tested, ps, test_run(t))) },
        );
        let listing = Cases(tested);
        let out = match t.cases {
          None -> run,
          Some(c) -> {
            entering(
              s,
              wanted,
              listing,
              Some(monomorphic(fn_type([], listing_ty(), row_empty()))),
              if !wants_root(wanted, listing) { run }
              else { run.push(rooted(listing, [], test_listing(c))) },
            )
          },
        };
        { out: out, fns: acc.fns }
      },
      // A law's guard and body are roots the judge enters with the binders' values.
      ILaw(d) -> {
        let filed = filed_of(law_owner(module, d.name));
        let typed = match filed { Ok(f) -> f.typed, Err(_) -> Map::new() };
        let names = d.binders.map(|binder: Binder| binder.name.name);
        let kinds = d.binders.map(|binder: Binder| Some(typed_kind(typed, binder.span)));
        let known = kinds.fold(true, |acc2: Bool, k: Option<{ kind: Kind, ty: Ty }>|
          acc2 && k != None);
        let part = |which: LawPart| law_key(module, d.name, which);
        let rooted = |which: LawPart, body: Expr|
          match law_params(law_owner(module, d.name), filed, d.binders) {
            Err(why) -> formed_from(s, d.span.start, part(which), [], true, Err(why), filed),
            Ok(ps) -> root_formed(s, d.span.start, part(which), names, ps, known, filed, body),
          };
        let with_guard = match d.guard {
          None -> acc.out,
          Some(g) -> if !wants_root(wanted, part(LawGuard)) { acc.out }
          else { acc.out.push(rooted(LawGuard, g)) },
        };
        {
          out: if !wants_root(wanted, part(LawBody)) { with_guard }
          else { with_guard.push(rooted(LawBody, d.body)) },
          fns: acc.fns,
        }
      },
      // A sum some body compares or orders is compared through a root written from its
      // constructors, written only where a body's call asks for it, not with every root a whole
      // emission takes.
      IType(t) -> {
        let named = qualify(module, t.name.name);
        // At its own name, or at the arguments a body asked for one at.
        let asked = written_roots.fold(
          [],
          |acc2: List<{ key: RootKey, eq: Bool, args: List<Type> }>, w: { key: RootKey, op: TypeOp, ty: Type }|
            match w.ty {
              TyCon(c) -> if c.name != named { acc2 } else {
                match w.op {
                  keys::Equal -> acc2.push({ key: w.key, eq: true, args: c.args }),
                  Order -> acc2.push({ key: w.key, eq: false, args: c.args }),
                  _ -> acc2,
                }
              },
              _ -> acc2,
            },
        );
        match s.ctors.sums.get(named) {
          None -> acc,
          Some(declared) ->
            asked.fold(acc, |a2: Walk, d: { key: RootKey, eq: Bool, args: List<Type> }| {
              let cs = if d.args.len() == 0 { declared } else {
                declared.map(|c: SumCtor|
                  { ..c, fields: c.fields.map(|f: Type| at_args(f, c.params, d.args)) })
              };
              let e = if d.eq { equality_code(cs) } else { ordering_code(cs) };
              // At its own name a generic sum is at its own variables.
              let compared = TyCon({
                name: named,
                args: if d.args.len() > 0 { d.args } else {
                  match declared.at(0) { Some(c) -> c.params.map(|v: Int| TyVar(v)), None -> [] }
                },
              });
              let word = |n: Bytes|
                { name: n, kind: KBoxed, ty: TyOpen([]), of: Some(compared), lambda: None };
              {
                ..a2,
                out: a2.out.push(
                  formed_from(
                    s,
                    t.span.start,
                    d.key,
                    [word(b"a"), word(b"b")],
                    true,
                    Ok(e.code),
                    Ok({ ..no_filings(), typed: e.typed }),
                  ),
                ),
              }
            }),
        }
      },
      _ -> acc,
    });
  // What a container's roots call of `std.prelude` the load reaches wherever a body writes one.
  let unreached = written_code().calls.filter(|n: Bytes|
    match def_in(module, here, s.imports, n) { Some(_) -> false, None -> true });
  let unreachable = |key: RootKey|
    Unformed({
      name: root_name(key),
      why: b"a container's root calls what the load did not reach of `std.prelude`: ".concat(
        Bytes::join(unreached, b", "),
      ),
    });
  let written_formed = |key: RootKey, e: WrittenRoot|
    formed_from(
      { ..s, here: here.concat(e.here) },
      0,
      key,
      e.params,
      true,
      e.code,
      Ok({ ..no_filings(), typed: e.typed }),
    );
  // A type some body reflects, digests, walks as a container or hands the runtime is written for by
  // a root.
  written_roots.fold(walked.out, |out: List<RootForm>, w: { key: RootKey, op: TypeOp, ty: Type }| {
    let r = { key: w.key, op: op_name(w.op), ty: w.ty };
    let reflective = match w.op { Reflect -> true, Shown -> true, Digest -> true, _ -> false };
    let contained = match w.op {
      Contained(c) -> contained_formed(c),
      _ -> reflective && walked_container(r.ty),
    };
    if plain_written(w.op) {
      out.push(
        Formed({
          name: root_name(w.key),
          form: match w.op {
            keys::Worded(_) -> worded(s.ctors, w.key),
            _ -> generated(s.ctors, w.key),
          },
        }),
      )
    } else if crossing_op(w.op) {
      out.push(if walked_container(r.ty) && unreached.len() > 0 { unreachable(r.key) }
      else { written_formed(r.key, crossing_root(module, s.ctors, r.key)) })
    } else if contained {
      out.push(if unreached.len() > 0 { unreachable(r.key) }
      else { written_formed(r.key, container_code(module, s.ctors, r.op, r.ty)) })
    }
    // A sum's comparisons are written where it is declared, above.
    else if !reflective { out } else {
      let e = if r.op == b"digest" { digest_code(module, s.ctors, here, x_module.items, r.ty) }
      else { reflection_code(module, s.ctors, here, x_module.items, r.op == b"shown", r.ty) };
      let held = kind_of(r.ty);
      out.push(
        formed_from(
          s,
          0,
          r.key,
          [{ name: b"a", kind: held.kind, ty: held.ty, of: Some(r.ty), lambda: None }],
          true,
          Ok(e.code),
          Ok({ ..no_filings(), typed: e.typed }),
        ),
      )
    }
  })
}

/// Whether a root written for a type is a plain one, generated straight to the form: a drop, dup,
/// release, copy, share or keep, of the type or of one of its sum's boxed cases, from the type's
/// layout; or an entry its descriptor names over its word form.
fn plain_written(op: TypeOp) -> Bool =
  match op {
    keys::Drop -> true,
    keys::Dup -> true,
    keys::Release -> true,
    keys::Copy -> true,
    keys::Share -> true,
    keys::Keep -> true,
    keys::Cased(_) -> true,
    keys::Worded(_) -> true,
    _ -> false,
  }

type Walk = { out: List<RootForm>, fns: Int }

/// Whether a root typed by `sc` can be entered: a function over no type or label variable, each of
/// whose parameters a lifting reads and whose answer a lowering writes.
pub fn enterable(c: CrossedSums, sc: Scheme) -> Bool =
  sc.ty_vars.len() == 0 && sc.label_vars.len() == 0
    && (match sc.ty {
      TyFn(f) -> f.params.all(|t: Type| crosses(c, t, true)) && crosses(c, f.ret, false),
      _ -> false,
    })

/// `out` and, where `wanted` holds it, the entry the runtime enters root `root` through, `root`
/// typed by `scheme`: one over a monomorphic function's parameters and answer, and refused for any
/// other.
fn entering(
  s: Setting,
  wanted: Map<RootName, Bool>,
  root: RootKey,
  scheme: Option<Scheme>,
  out: List<RootForm>,
) -> List<RootForm> / {abort.raise} = {
  let key = Entered(root);
  if !wants_root(wanted, key) { out } else {
    match scheme {
      // An entry over a type variable declines where its crossing reaches the variable.
      Some(sc) -> match sc.ty {
        TyFn(f) -> {
          let e = entered_code(s.module, root, f.params, f.ret);
          out.push(
            formed_from(
              { ..s, here: s.here.concat(e.here) },
              0,
              key,
              e.params,
              true,
              e.code,
              Ok({ ..no_filings(), typed: e.typed }),
            ),
          )
        },
        _ -> out.push(Unformed({ name: root_name(key), why: b"an entry of no function" })),
      },
      None ->
        out.push(Unformed({ name: root_name(key), why: b"an entry of a root no scheme types" })),
    }
  }
}

/// `out` and, where `wanted` holds it, the root a build keeps the value of the `const` definition
/// `full`, typed by `scheme`, by: the encoding of what its body answers. Refused for a definition
/// that takes a parameter.
fn storing(
  s: Setting,
  wanted: Map<RootName, Bool>,
  full: Bytes,
  scheme: Option<Scheme>,
  out: List<RootForm>,
) -> List<RootForm> / {abort.raise} = {
  let stored = Stored(Named(full));
  let refused = |why: Bytes| out.push(Unformed({ name: root_name(stored), why: why }));
  if !wants_root(wanted, stored) { out } else {
    match scheme {
      Some(sc) -> match sc.ty {
        TyFn(f) -> if f.params.len() > 0 { refused(b"a stored root of a definition of parameters") }
        else {
          let e = stored_code(s.module, Named(full), f.ret);
          out.push(
            formed_from(
              { ..s, here: s.here.concat(e.here) },
              0,
              stored,
              e.params,
              true,
              e.code,
              Ok({ ..no_filings(), typed: e.typed }),
            ),
          )
        },
        _ -> refused(b"a stored root of no function"),
      },
      None -> refused(b"a stored root of a definition no scheme types"),
    }
  }
}

/// A label parameter is a hidden trailing `Int`: the caller passes the resource's field-table entry.
fn prepare(
  module: Bytes,
  schemes: Map<Bytes, Scheme>,
  wanted: Map<RootName, Bool>,
  filed_of: (Bytes) -> Result<Filings, Bytes> / {abort.raise},
  def: FnDef,
) -> Prepared / {abort.raise} = {
  let names = def.params.map(|param: Param| param.name.name);
  let kinds = param_kinds(def, sig_of(schemes, qualify(module, def.name.name))).map(
    |k: { kind: Kind, ty: Ty }| Some(k),
  );
  let labels = def.generics.labels.map(|ident: Ident| ident.name);
  let all_names = labels.fold(names, |acc: List<Bytes>, n: Bytes| acc.push(n));
  let all_kinds = labels.fold(kinds, |acc: List<Option<{ kind: Kind, ty: Ty }>>, n: Bytes|
    acc.push(Some({ kind: KInt, ty: TyOpen([]) })));
  let known = kinds.fold(true, |acc: Bool, k: Option<{ kind: Kind, ty: Ty }>| acc && k != None);
  let full = qualify(module, def.name.name);
  let filed = filed_of(full);
  {
    full: full,
    base: def.span.start,
    names: names,
    kinds: kinds,
    ps: params_carried(all_names, all_kinds, param_types(def, sig_of(schemes, full))),
    known: known,
    code: if !known { Err(b"a parameter with no written type") }
    else if !wants_root(wanted, Named(full)) { Err(b"a definition no root here wants") } else {
      match lower_fn(names, labels, labels_of(filed), def.body, of_binder(module)) {
        Ok(l) -> Ok(l.code),
        Err(why) -> Err(why),
      }
    },
    filed: filed,
  }
}

/// The code the body of `def`, of `module`, lowers to as written, of whose nodes the checker filed
/// `filed`.
fn written_code_of(
  module: Bytes,
  def: FnDef,
  filed: Result<Filings, Bytes>,
) -> Result<Code, Bytes> / {abort.raise} =
  match lower_fn(
      def.params.map(|param: Param| param.name.name),
      def.generics.labels.map(|ident: Ident| ident.name),
      labels_of(filed),
      def.body,
      of_binder(module),
    ) {
    Ok(l) -> Ok(l.code),
    Err(why) -> Err(why),
  }

fn form_name(r: RootForm) -> RootName = match r { Formed(f) -> f.name, Unformed(u) -> u.name }

/// `requires` and `ensures` clauses as roots, each over the definition's parameters at the types its
/// scheme gives them, and an `ensures` over `result` too, at the type the definition answers.
fn clause_roots(
  acc: Walk,
  def: FnDef,
  names: List<Bytes>,
  kinds: List<Option<{ kind: Kind, ty: Ty }>>,
  s: Setting,
  sig: Option<Sig>,
  wanted: Map<RootName, Bool>,
  filed: Result<Filings, Bytes>,
) -> Walk / {abort.raise} = {
  let known = kinds.fold(true, |acc2: Bool, k: Option<{ kind: Kind, ty: Ty }>| acc2 && k != None);
  let types = param_types(def, sig);
  let clause = |kind: ClauseKind, k: Int|
    Clause({ def: Named(qualify(s.module, def.name.name)), kind: kind, n: k });
  let walked = def.spec.fold(
    { out: acc.out, requires: 0, ensures: 0 },
    |w: { out: List<RootForm>, requires: Int, ensures: Int }, c: SpecClause|
      match c.kind {
        SRequires -> {
          let key = clause(Requires, w.requires);
          {
            out: if !wants_root(wanted, key) { w.out } else {
              w.out.push(
                root_formed(
                  s,
                  def.span.start,
                  key,
                  names,
                  params_carried(names, kinds, types),
                  known,
                  filed,
                  c.expr,
                ),
              )
            },
            requires: w.requires + 1,
            ensures: w.ensures,
          }
        },
        SEnsures -> match def.ret {
          None -> { out: w.out, requires: w.requires, ensures: w.ensures + 1 },
          Some(r) -> {
            let key = clause(Ensures, w.ensures);
            let rnames = names.push(b"result");
            let rkinds = kinds.push(Some(match sig { Some(g) -> kind_of(g.ret), None -> boxed() }));
            let rtypes = types.push(match sig { Some(g) -> Some(g.ret), None -> None });
            {
              out: if !wants_root(wanted, key) { w.out } else {
                w.out.push(
                  root_formed(
                    s,
                    def.span.start,
                    key,
                    rnames,
                    params_carried(rnames, rkinds, rtypes),
                    known,
                    filed,
                    c.expr,
                  ),
                )
              },
              requires: w.requires,
              ensures: w.ensures + 1,
            }
          },
        },
        // A bound is read off the body, and never run.
        SCost -> w,
        SSpace -> w,
      },
  );
  { out: walked.out, fns: acc.fns }
}

/// The roots `wanted` keys, resolved against the whole program: one entry per root emitted or
/// refused, in its order, so the driver can drop what was refused. `embeds` is what the front end's
/// answer says it embedded, `rows` what it published for every definition and test, which spare a
/// walk of every module no wanted root is in, `walked` what its check read of the modules it walked
/// whole, which spares a walk of those too, and `published` the handings of the definitions other
/// answers hold, which the calls of these are written against.
pub fn emit_roots_answer(
  names: List<Bytes>,
  srcs: List<Bytes>,
  ctors: Ctors,
  builtins: List<Bytes>,
  wanted: List<RootKey>,
  pkgs: List<PackageDeps>,
  module_packages: List<Int>,
  embeds: List<EmbedAt>,
  rows: Rows,
  walked: Bytes,
  published: List<Published> = [],
) -> List<RootAnswer> / {abort.raise} =
  roots_answered(
    lowered_roots(
      names,
      srcs,
      ctors,
      builtins,
      wanted,
      pkgs,
      module_packages,
      embeds,
      rows,
      walked,
      published,
    ),
  )

/// The roots `wanted` keys lowered as `emit_roots_answer` asks, before their counts are placed.
pub fn lowered_roots(
  names: List<Bytes>,
  srcs: List<Bytes>,
  ctors: Ctors,
  builtins: List<Bytes>,
  wanted: List<RootKey>,
  pkgs: List<PackageDeps>,
  module_packages: List<Int>,
  embeds: List<EmbedAt>,
  rows: Rows,
  walked: Bytes,
  published: List<Published> = [],
) -> Walked / {abort.raise} =
  lowered_program(
    zip_sources(names, srcs),
    ctors,
    builtins,
    true,
    wanted,
    pkgs,
    module_packages,
    embeds,
    rows,
    walked,
    published,
  )

/// The answer of each root `w` holds, emitted as `emitted_program` emits it.
pub fn roots_answered(w: Walked) -> List<RootAnswer> / {abort.raise} =
  emitted_program(w).map(answer_of)

fn answer_of(e: Emitted) -> RootAnswer =
  {
    name: e.name,
    answer: match e.why {
      Some(w) -> Refused({ why: w }),
      None -> Body({ text: e.text, tables: e.tables }),
    },
  }

pub fn zip_sources(names: List<Bytes>, srcs: List<Bytes>) -> List<Source> =
  range(0, names.len()).map(|i: Int|
    {
      name: match names.at(i) { Some(n) -> n, None -> b"" },
      src: match srcs.at(i) { Some(t) -> t, None -> b"" },
    })
