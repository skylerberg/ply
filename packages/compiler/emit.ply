//! The C emitter: writes the C for one lowered body, or `None` for a form it does not cover.
//! Output is diffed byte for byte against the Rust back end, so emission order and temporary numbering are load-bearing.

import syntax.parsing (Ident, dummy_span, span_key, ParseDiag)
import emit.code (Code, NVar, NBinary, NIf, NBlock, NApp, NMatch, CodeArm, lower_to_emit)
import syntax.items (Module, Derived, Item, IFn, ITest, ILaw, IType, parse, with_prelude, INames,
                     IModule, IAlias, Binder, SpecClause, SRequires, SEnsures, SCost, SSpace, FnDef,
                     test_run, test_listing, IInstance, VariantDef, TDSum, INumeric, NumericOp,
                     NKey, TestDef)
import check.resolve.tables (ParsedModule, Source, Diag, Resolved, ModuleBinding, qualify, lookup,
                             ValueSpace)
import check.resolve (ResolveSucceeded, ResolveFailed, resolve_packaged)
import check.resolve.scopes (PackageDeps, no_packages, of_module, of_binder)
import expand.derive (expand_derives)
import check.infer.checker (LabelSite, OperandSite, TypedSite, MemberSite, WitnessOp, test_owner,
                            law_root, cases_root)
import check.infer (expanded_mods, EmitFacts)
import check.types (Type, TyCon, Scheme, type_at, int_type, bytes_type, type_spelled)
import emit.lower.setting (declared_schemes)
import emit.typing (Typed, node_types, unknown_type, filed_as)
import front.rows (Rows, KnownDefRow)
import front.seam (WalkedFacts, walked_facts_bin)
import front.published (facts_read, lowered_modules, lowers, wants)
import std.bin
import std.list
import std.graph
import front.diagnostics (with_prelude_source)
import store.hash.forms (written_code)
import syntax.exprs (freed_by, Param, Expr, case_at, case_identity, ELit)
import expand.rewrite (expand)
import expand.embed (EmbedAt, embed_tables, rewritten)
import syntax.patterns (LBool)
import std.bytes (ascii_of_int)
import emit.c (KBoxed, KInt, Kind, position_of, bytes_join, unsettled, bytes_join_dots)
import emit.roots (container_ops, equality_root, ordering_root, written_root_of, specialisation_of,
                   own_definition, FnArg)
import emit.answer (no_tables, sorted_widths, Emitted, Body, Refused, RootAnswer)
import emit.reps (Ctors, SumCtor, Ty, TyBytes, TyOpen, Def, Imported, ModuleDefs, Whole, kind_of,
                  boxed, Sig, sig_of, param_kinds, param_types, typed_kind, typed_at, def_entry,
                  carriers_of)
