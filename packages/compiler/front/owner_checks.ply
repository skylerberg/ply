//! A module checked an owner at a time. An owner is the items one name owns: a function, a type with
//! what its module states of it, an effect, a schema, a set, an extern, or a test or a law under its
//! own name. A check of one owner reads its own items and the entries of what they mention, so what
//! it answers says nothing of where the owner stands in its module: every place it holds is counted
//! from where the owner's text starts. A module's answer is its owners' answers, each placed where
//! its items stand.

import std.bin
import std.list
import std.bytes
import compiler.front.published (no_rows, rows_of)
import compiler.front.facts (Analysis, ModuleFacts, read_outline, module_tables_bin,
                             tagged_site_bin, statement_site_bin, typed_const_bin, ModuleShape,
                             ModuleTables, TaggedSite, StatementSite, TypedConst, module_facts,
                             no_module_tables)
import compiler.front.seam (AnalysisOutcome, Analysed, Refused, types_of_rows)
import compiler.front.rows (EffectSetRow, OutlineItem, OutlinedLaw, OutlinedTest, LawOutline,
                            rows_bin, effect_set_row_bin, law_outline_bin, Rows, KnownDefRow,
                            is_declared_in)
import compiler.front (analyse_pulling_std_with, faceted, may_call_embed)
import compiler.front.exports (OwnerInterface, Exports, ItemAt, OwnerText, Mention, InRoot,
                               ShippedModule, exports_of, owner_interface_bin, owner_interfaces_in,
                               import_targets, owner_source, checked_owner, owner_texts,
                               module_scope, owner_mentions, owner_groups, group_source,
                               unplaced_imports, visible_modules, group_imports, item_layout,
                               owner_tokens)
import compiler.syntax.items (Item, Module, parse, parse_started, item_owner)
import compiler.check.infer.checker (DefInfo, TestInfo, LawInfo, LawBinder, EffectInfo, OpInfo,
                                     CtorInfo, InstanceInfo, NumericInfo, Location, SpecInfo,
                                     WitnessOrder, MemberSite, CachedFacts, CheckedBody, ReusedBody,
                                     relocated_body, checked_body_bin, cached_facts_bin,
                                     spec_info_bin, BodyChecking, ReuseBodies, OwnCall)
import compiler.emit.keys (test_owner, law_owner)
import compiler.check.infer.definitions (checked_functions, check_order)
import compiler.check.infer (EmitFacts, types_named, types_joined, emit_facts_bin, facts_moved)
import compiler.check.typed (TypedBody, part_key)
import compiler.check.resolve.tables (Diag, Label, Edit, Fix, Source, diag_bin)
import compiler.syntax.parsing (Span, span_between, start)
import compiler.check.types (InternedType, TypeInterner, Type, TypeTable, type_table_bin,
                             interned_subset, interned_type_bin, empty_interner, intern_types,
                             intern_more_types, types_of, unit_type)
import compiler.syntax.exprs (TaggedPart)
import compiler.expand.embed (ModuleEmbed, EmbedRequest, module_embed_bin, embed_file, embed_key,
                              embed_requests)
import compiler.store.hash.forms (HashInput, module_selection, selection_forms, hash_input_bin)
import compiler.store.hash.template (called_at)
import compiler.store.hash (UseNode, use_node_bin, unreached)
import compiler.store.hash.graph (LawNode, TestNode)

/// What a check of a group of owners answered of one of them, every place module 0's and counted from
/// where the group's own text starts.
pub type OwnerResult = {
  tables: ModuleTables,
  rows: Rows,
  refused: List<Diag>,
  warnings: List<Diag>,
  tagged: List<TaggedSite>,
  statements: List<StatementSite>,
  consts: List<TypedConst>,
  /// Each effect set it declares, resolved, and each law it is with the literals its guard reads.
  sets: List<EffectSetRow>,
  laws: List<LawOutline>,
  /// What the walk for what nothing uses meets of its nodes, tests and laws, which only the walk over
  /// its whole module can tell reached or not.
  uses: List<UseNode>,
}

// --- Moving places ---------------------------------------------------------------------------

/// How places move: those in module `from` to module `to`, each position through `by`.
type Relocation = { from: Int, to: Int, by: (Int) -> Int }

fn moved_at(s: Span, m: Relocation) -> Span = { ..s, start: (m.by)(s.start), end: (m.by)(s.end) }

fn moved_location(l: Location, m: Relocation) -> Location =
  if l.module == m.from { { module: m.to, span: moved_at(l.span, m) } } else { l }

fn moved_index(module: Int, m: Relocation) -> Int = if module == m.from { m.to } else { module }

fn moved_spanned(module: Int, s: Span, m: Relocation) -> Span =
  if module == m.from { moved_at(s, m) } else { s }

/// A definition's raises are counted from where it starts, so they move with it.
fn moved_def(d: DefInfo, m: Relocation) -> DefInfo =
  {
    ..d,
    at: moved_location(d.at, m),
    spec: d.spec.map(|x: SpecInfo| { ..x, span: moved_spanned(d.at.module, x.span, m) }),
  }

fn moved_tables(t: ModuleTables, m: Relocation) -> ModuleTables =
  {
    ..t,
    defs: t.defs.map(|d: DefInfo| moved_def(d, m)),
    tests: t.tests.map(|x: TestInfo| { ..x, at: moved_location(x.at, m) }),
    laws: t.laws.map(|l: LawInfo|
      {
        ..l,
        at: moved_location(l.at, m),
        binders: l.binders.map(|b: LawBinder| { ..b, span: moved_spanned(l.at.module, b.span, m) }),
      }),
    effects: t.effects.map(|x: EffectInfo|
      {
        ..x,
        at: moved_location(x.at, m),
        operations: x.operations.map(|op: OpInfo| { ..op, at: moved_location(op.at, m) }),
      }),
    ctors: t.ctors.map(|c: CtorInfo| { ..c, at: moved_location(c.at, m) }),
    instances: t.instances.map(|x: InstanceInfo| { ..x, at: moved_location(x.at, m) }),
    numeric: t.numeric.map(|x: NumericInfo| { ..x, at: moved_location(x.at, m) }),
    // A body's places are its item's, so only its module moves.
    facts: facts_moved(t.facts, |i: Int| moved_index(i, m)),
  }

fn moved_diag(d: Diag, m: Relocation) -> Diag =
  {
    ..d,
    labels: d.labels.map(|l: Label|
      if l.module == m.from { { ..l, module: m.to, start: (m.by)(l.start), end: (m.by)(l.end) } }
      else { l }),
    fixes: d.fixes.map(|f: Fix|
      {
        ..f,
        edits: f.edits.map(|x: Edit|
          if x.module == m.from {
            { ..x, module: m.to, start: (m.by)(x.start), end: (m.by)(x.end) }
          } else { x }),
      }),
  }

fn moved_tagged(x: TaggedSite, m: Relocation) -> TaggedSite =
  {
    ..x,
    span: moved_at(x.span, m),
    parts: x.parts.map(|p: TaggedPart| { ..p, quoted: moved_at(p.quoted, m) }),
  }

// --- One owner's answer ----------------------------------------------------------------------

/// Where one of an owner's items stands in the module a check read: from `at`, `len` bytes long,
/// and counted from where its group's own text starts, `rel`.
pub type ItemRange = { at: Int, len: Int, rel: Int }

/// Whether `s`, in module `module`, lies in module `at` within one of `spots`.
fn within(module: Int, s: Span, at: Int, spots: List<ItemRange>) -> Bool =
  module == at
    && spots.fold(false, |b: Bool, x: ItemRange| b || (s.start >= x.at && s.end <= x.at + x.len))

/// A position of the module a check read, counted from where its group's own text starts.
fn group_offset(spots: List<ItemRange>, p: Int) -> Int =
  spots.fold(p, |acc: Int, x: ItemRange|
    if p >= x.at && p <= x.at + x.len { x.rel + (p - x.at) } else { acc })

/// What `said`, a check that read a group of owners as its module at its slot, answered of one of
/// them, whose share of it is `share` and whose items stand where `spots` says: each place counted
/// from where the group's text starts, module 0's.
fn owner_result(
  said: ModuleCheck,
  share: Share,
  spots: List<ItemRange>,
) -> OwnerResult / {abort.raise} = {
  let slot = said.slot;
  let t = said.facts.tables;
  let kept = {
    ..t,
    defs: share.defs,
    tests: share.tests,
    laws: share.laws,
    effects: share.effects,
    ctors: share.ctors,
    instances: share.instances,
    numeric: share.numeric,
    facts: share.facts,
    kept: share.kept,
  };
  let back = { from: 0, to: 0, by: |p: Int| group_offset(spots, p) };
  let placed = |l: Label| within(l.module, span_between(l.start, l.end), slot, spots);
  let own_labels = |d: Diag|
    { ..d, labels: d.labels.filter(placed).map(|l: Label| { ..l, module: 0 }) };
  let lowest = |xs: List<Int>|
    xs.fold(0 - 1, |acc: Int, k: Int| if acc < 0 || k < acc { k } else { acc });
  let first_test = lowest(share.tests.map(|x: TestInfo| x.index));
  let first_law = lowest(share.laws.map(|l: LawInfo| l.index));
  // Its tests and laws numbered from its first, as a check of it alone numbers them.
  numbered(
    {
      tables: moved_tables(kept, back),
      // A row is counted from where its definition starts, so no row moves.
      rows: {
        defs: share.rows.map(|r: KnownDefRow| { ..r, hash: b"" }),
        tests: [],
        types: types_of_rows(said.rows.types, share.rows, []),
      },
      refused: [],
      warnings: share.warnings.map(|d: Diag| moved_diag(own_labels(d), back)),
      tagged: share.tagged.map(|x: TaggedSite| moved_tagged(x, back)),
      statements: share.statements.map(|x: StatementSite| { ..x, span: moved_at(x.span, back) }),
      consts: share.consts,
      sets: share.sets,
      laws: share.outlined,
      uses: share.uses.map(|r: UseNode|
        {
          ..r,
          module: 0,
          span: moved_at(r.span, back),
          unused: match r.unused { Some(d) -> Some(moved_diag(own_labels(d), back)), None -> None },
        }),
    },
    if first_test < 0 { 0 } else { 0 - first_test },
    if first_law < 0 { 0 } else { 0 - first_law },
  )
}

/// What of a check of a module one owner's answer is made of: what of each table stands within one
/// of its items, or that it names, each in the order the check holds it.
type Share = {
  defs: List<DefInfo>,
  tests: List<TestInfo>,
  laws: List<LawInfo>,
  effects: List<EffectInfo>,
  ctors: List<CtorInfo>,
  instances: List<InstanceInfo>,
  numeric: List<NumericInfo>,
  facts: EmitFacts,
  kept: List<CachedFacts>,
  rows: List<KnownDefRow>,
  warnings: List<Diag>,
  tagged: List<TaggedSite>,
  statements: List<StatementSite>,
  consts: List<TypedConst>,
  sets: List<EffectSetRow>,
  outlined: List<LawOutline>,
  uses: List<UseNode>,
}

/// `a`, one owner's answer, its places moved to where its group's items stand in its module, `items`.
pub fn relocated_result(a: OwnerResult, items: List<ItemAt>) -> OwnerResult = {
  let by = |p: Int|
    items.fold(p, |acc: Int, x: ItemAt|
      if p >= x.from && p <= x.from + x.len { x.to + (p - x.from) } else { acc });
  let m = { from: 0, to: 0, by: by };
  {
    tables: moved_tables(a.tables, m),
    rows: a.rows,
    refused: a.refused.map(|d: Diag| moved_diag(d, m)),
    warnings: a.warnings.map(|d: Diag| moved_diag(d, m)),
    tagged: a.tagged.map(|x: TaggedSite| moved_tagged(x, m)),
    statements: a.statements.map(|x: StatementSite| { ..x, span: moved_at(x.span, m) }),
    consts: a.consts,
    sets: a.sets,
    laws: a.laws,
    uses: a.uses.map(|r: UseNode|
      {
        ..r,
        span: moved_at(r.span, m),
        unused: match r.unused { Some(d) -> Some(moved_diag(d, m)), None -> None },
      }),
  }
}

/// What a check of a group of owners answered of one of them, and the entry it shows what reads it:
/// none for a test or a law.
pub type MemberResult = { owner: Bytes, result: OwnerResult, entry: Option<OwnerInterface> }

derive bin for OwnerResult
derive bin for MemberResult
derive bin for GroupResult

/// What a check of a group of owners answered: each member's answer, the errors that refused the
/// group, the forms hashing reads of the members, each place counted from where the group's own
/// text starts, and what their module embeds as the check read it.
pub type GroupResult = {
  members: List<MemberResult>,
  refused: List<Diag>,
  forms: HashInput,
  embeds: List<ModuleEmbed>,
}

/// What a group answers that its module no longer checks together.
pub fn no_group() -> GroupResult =
  { members: [], refused: [], forms: { nodes: [], order: [], tests: [], laws: [] }, embeds: [] }

/// A member's entry as its group's record keeps it: encoded, and empty for a member that shows none.
pub type EncodedInterface = { owner: Bytes, entry: Bytes }

/// A group's answer as its record keeps it: each member's entry before the rest, which holds none,
/// so what reads an entry decodes no member's tables; and each definition's type among `types`,
/// held once, where `at` gives it in the order [`typed`] walks them, and left out of `rest`. Its
/// encoding starts with the entries.
pub type EncodedGroup = {
  shown: List<EncodedInterface>,
  types: List<InternedType>,
  at: List<Int>,
  rest: GroupResult,
}

derive bin for EncodedInterface
derive bin for EncodedGroup

/// The type of each definition `a`'s members hold, in their tables and then their rows, member by
/// member.
fn definition_types(a: GroupResult) -> List<Type> =
  a.members.fold([], |acc: List<Type>, m: MemberResult|
    acc.concat(m.result.tables.defs.map(|d: DefInfo| d.scheme.ty)).concat(
      m.result.rows.defs.map(|r: KnownDefRow| r.scheme.ty),
    ))

/// `a` with each of those types read as `ty` gives the one at its place among them.
fn with_definition_types(
  a: GroupResult,
  ty: (Int) -> Type / {abort.raise},
) -> GroupResult / {abort.raise} =
  {
    ..a,
    members: a.members.fold(
      { out: [], next: 0 },
      |acc: { out: List<MemberResult>, next: Int }, m: MemberResult| {
        let defs = m.result.tables.defs;
        let rows = m.result.rows.defs;
        let from = acc.next + defs.len();
        {
          out: acc.out.push({
            ..m,
            result: {
              ..m.result,
              tables: {
                ..m.result.tables,
                defs: range(0, defs.len()).map(|i: Int| {
                  let d = defs.get(i);
                  { ..d, scheme: { ..d.scheme, ty: ty(acc.next + i) } }
                }),
              },
              rows: {
                ..m.result.rows,
                defs: range(0, rows.len()).map(|i: Int| {
                  let r = rows.get(i);
                  { ..r, scheme: { ..r.scheme, ty: ty(from + i) } }
                }),
              },
            },
          }),
          next: from + rows.len(),
        }
      },
    ).out,
  }

/// `a` as its record keeps it, its definitions' types the ones `held` holds once, at `at`.
fn encode_group_with_types(
  a: GroupResult,
  held: List<InternedType>,
  at: List<Int>,
) -> Bytes / {abort.raise} =
  bin::encode(
    {
      shown: a.members.map(|m: MemberResult|
        {
          owner: m.owner,
          entry: match m.entry { Some(e) -> bin::encode(e, owner_interface_bin()), None -> b"" },
        }),
      types: held,
      at: at,
      rest: with_definition_types(
        { ..a, members: a.members.map(|m: MemberResult| { ..m, entry: None }) },
        |_: Int| unit_type(),
      ),
    },
    encoded_group_bin(),
  )

/// `a` as its record keeps it.
pub fn encode_group(a: GroupResult) -> Bytes / {abort.raise} = {
  let h = intern_types(definition_types(a));
  encode_group_with_types(a, h.held, h.at)
}

/// Each of `answers` as [`encode_group`] keeps it, byte for byte: their types are held together while
/// they are laid out, so a type many groups of a module mention is walked once for all of them.
pub fn encode_groups(answers: List<GroupResult>) -> List<Bytes> / {abort.raise} =
  answers.fold(
    { h: empty_interner(), out: [] },
    |acc: { h: TypeInterner, out: List<Bytes> }, a: GroupResult| {
      let p = intern_more_types(acc.h, definition_types(a));
      let part = interned_subset(p.h, p.at);
      { h: p.h, out: acc.out.push(encode_group_with_types(a, part.held, part.at)) }
    },
  ).out

/// The answer `k` keeps, each member with its entry again.
pub fn decode_group(k: EncodedGroup) -> GroupResult / {abort.raise} = {
  let entries = k.shown.fold(Map::new(), |acc: Map<Bytes, OwnerInterface>, s: EncodedInterface|
    if s.entry.len() == 0 { acc } else {
      match bin::decode(s.entry, owner_interface_bin()) {
        Ok(e) -> acc.insert(s.owner, e),
        Err(_) -> panic("a group's record keeps an entry that does not decode"),
      }
    });
  let tys = types_of(k.types);
  with_definition_types(
    {
      ..k.rest,
      members: k.rest.members.map(|m: MemberResult| { ..m, entry: entries.get(m.owner) }),
    },
    |i: Int| tys.get(k.at.get(i)),
  )
}

/// Each member's entry of the answer `b` keeps, by owner, read without the rest of it.
pub fn group_interfaces(b: Bytes) -> Map<Bytes, Bytes> / {abort.raise} =
  match bin::list_bin(encoded_interface_bin()).take(b, 0) {
    Ok(t) ->
      t.value.fold(Map::new(), |acc: Map<Bytes, Bytes>, s: EncodedInterface|
        acc.insert(s.owner, s.entry)),
    Err(_) -> panic("a group's record keeps no entries"),
  }

/// Where `owner`'s items of `items`, a group's items as [`group_source`] lays them, stand in the
/// module a check read, each where `at` says.
pub fn item_ranges(
  items: List<ItemAt>,
  owner: Bytes,
  at: (ItemAt) -> Int / {abort.raise},
) -> List<ItemRange> / {abort.raise} =
  items.filter(|x: ItemAt| x.owner == owner).map(|x: ItemAt| { at: at(x), len: x.len, rel: x.from })

/// What a check that read a group of owners of `module` as its module at `slot`, written as `text`,
/// answered of them: `members` are the owners, `items` where their items stand as [`group_source`]
/// lays them, and `at` where each item stands in the module the check read.
pub fn group_result(
  out: AnalysisOutcome,
  slot: Int,
  text: Bytes,
  module: Bytes,
  members: List<OwnerText>,
  items: List<ItemAt>,
  at: (ItemAt) -> Int / {abort.raise},
) -> GroupResult / {abort.raise} = {
  let spots = items.map(|x: ItemAt| { at: at(x), len: x.len, rel: x.from });
  let back = { from: 0, to: 0, by: |p: Int| group_offset(spots, p) };
  match out {
    Refused(ds) ->
      {
        members: [],
        refused: ds.map(|d: Diag|
          moved_diag(
            {
              ..d,
              labels: d.labels.filter(|l: Label|
                within(l.module, span_between(l.start, l.end), slot, spots)).map(|l: Label|
                { ..l, module: 0 }),
            },
            back,
          )),
        forms: { nodes: [], order: [], tests: [], laws: [] },
        embeds: [],
      },
    Analysed(w) ->
      group_results(
        module_check_of(w, slot, text),
        module,
        [{ members: members, items: items }],
        at,
      ).at_or(
        0,
        no_group(),
      ),
  }
}

// --- An owner walked apart from its group -----------------------------------------------------
// Owners whose texts mention one another round a cycle are each walked alone: its own text against
// what the other owners' signatures say. What a walk leaves is kept an owner at a time, and each
// group of them, those whose bodies call one another, is settled from its members' walks with no
// body walked again.

/// The clauses of the definition `name` as they were checked.
pub type Clauses = { name: Bytes, spec: List<SpecInfo> }

/// What a walk of one owner's functions answered, before its group is settled: what only a walk
/// makes of it (the sites the emitter reads, each clause checked, what the emitter reads of each
/// body as a row files it and the types those name), and each body as its group's settling reads
/// it. Every place is module 0's and counted from where the owner's text starts.
pub type InferenceResult = {
  facts: EmitFacts,
  kept: List<CachedFacts>,
  clauses: List<Clauses>,
  filed: List<CachedFacts>,
  types: TypeTable,
  bodies: List<CheckedBody>,
  refused: List<Diag>,
}

derive bin for Clauses
derive bin for InferenceResult

/// What an owner that is walked with its group answers of a walk of its own.
pub fn no_inference_result() -> InferenceResult = inference_result_from(no_owner_result(), [])

fn inference_result_from(answer: OwnerResult, bodies: List<CheckedBody>) -> InferenceResult =
  {
    facts: answer.tables.facts,
    kept: answer.tables.kept,
    clauses: answer.tables.defs.map(|d: DefInfo| { name: d.name, spec: d.spec }),
    filed: answer.rows.defs.map(|r: KnownDefRow| { name: r.name, facts: r.facts }),
    types: answer.rows.types,
    bodies: bodies,
    refused: [],
  }

/// What a check that walked `member` alone, an owner of `module` read as its module at `slot` and
/// written as `text`, answered of it: `items` is where its items stand as [`group_source`] lays
/// them, and `at` where each stands in the module the check read.
pub fn inference_result(
  out: AnalysisOutcome,
  slot: Int,
  text: Bytes,
  module: Bytes,
  member: OwnerText,
  items: List<ItemAt>,
  at: (ItemAt) -> Int / {abort.raise},
) -> InferenceResult / {abort.raise} = {
  let cut = group_result(out, slot, text, module, [member], items, at);
  match ((out, cut.members)) {
    (Analysed(w), [m, ..]) -> {
      let spots = item_ranges(items, member.owner, at);
      inference_result_from(
        m.result,
        w.bodies.map(|b: CheckedBody| relocated_body(b, 0, |p: Int| group_offset(spots, p))),
      )
    },
    _ -> { ..inference_result_from(no_owner_result(), []), refused: cut.refused },
  }
}

/// What a check that `said` what it did of the whole of `module` answers of each of `members`
/// walked alone, as [`inference_result`] answers one: `stands` is where an item stands in the module
/// the check read.
pub fn inference_results(
  said: ModuleCheck,
  module: Bytes,
  members: List<OwnerText>,
  stands: (ItemAt) -> Int / {abort.raise},
) -> List<InferenceResult> / {abort.raise} = {
  let alone = members.map(|o: OwnerText| { members: [o], items: item_layout([o]) });
  let cut = group_results(said, module, alone, stands);
  range(0, members.len()).map(|i: Int| {
    let o = members.get(i);
    let answer = match cut.get(i).members { [m, ..] -> m.result, [] -> no_owner_result() };
    let spots = item_ranges(alone.get(i).items, o.owner, stands);
    let own = answer.tables.defs.map(|d: DefInfo| d.name);
    inference_result_from(
      answer,
      said.w.bodies.filter(|b: CheckedBody| own.contains(b.name)).map(|b: CheckedBody|
        relocated_body(b, 0, |p: Int| group_offset(spots, p))),
    )
  })
}

fn no_owner_result() -> OwnerResult =
  {
    tables: no_module_tables(),
    rows: no_rows(),
    refused: [],
    warnings: [],
    tagged: [],
    statements: [],
    consts: [],
    sets: [],
    laws: [],
    uses: [],
  }

/// Each name of `module` the bodies `typed` walked call, hand on as a value, or reach through an
/// operator a type states, as the module declares it.
pub fn called_names(
  module: Bytes,
  definition_types: InferenceResult,
) -> List<Bytes> / {abort.raise} = {
  let prefix = module.concat(b".");
  definition_types.bodies.fold([], |acc: List<Bytes>, b: CheckedBody|
    b.refs.concat(b.calls.concat(b.stated).map(|c: OwnCall| c.callee)).fold(
      acc,
      |a: List<Bytes>, n: Bytes|
        if !n.starts_with(prefix) { a } else {
          let simple = n.slice(prefix.len(), n.len());
          if a.contains(simple) { a } else { a.push(simple) }
        },
    ))
}

/// What signing a unit answered: each member's entry less the rows its settling answers, encoded
/// as a group's record keeps one, before the errors that refused the unit. Its encoding starts
/// with the entries, so [`group_interfaces`] reads them.
pub type SignatureCheck = { shown: List<EncodedInterface>, refused: List<Diag> }

derive bin for SignatureCheck

/// What `answer`, a check of a unit that signed its functions and walked none, says of what each
/// member shows.
pub fn signature_check_of(answer: GroupResult) -> SignatureCheck / {abort.raise} =
  {
    shown: answer.members.map(|m: MemberResult|
      {
        owner: m.owner,
        entry: match m.entry {
          Some(e) -> bin::encode({ ..e, rows: [] }, owner_interface_bin()),
          None -> b"",
        },
      }),
    refused: answer.refused,
  }

/// What `said`, a check of a whole module, shows of each of `owners` less its rows: what a signing
/// of them answers.
pub fn signature_check_from(
  said: ModuleCheck,
  owners: List<Bytes>,
) -> SignatureCheck / {abort.raise} =
  {
    shown: owners.map(|o: Bytes|
      {
        owner: o,
        entry: match said.shown.entries.get(o) {
          Some(e) -> bin::encode({ ..e, rows: [] }, owner_interface_bin()),
          None -> b"",
        },
      }),
    refused: [],
  }

/// The errors that refused the walks of `members`, each moved to where its owner's items stand in
/// their group's own text, which `items` lays.
pub fn inference_errors(members: List<OwnerInference>, items: List<ItemAt>) -> List<Diag> =
  members.fold([], |acc: List<Diag>, w: OwnerInference| {
    let base = base_of(items, w.owner);
    acc.concat(
      w.typed.refused.map(|d: Diag| moved_diag(d, { from: 0, to: 0, by: |p: Int| base + p })),
    )
  })

/// Where `owner`'s text starts in a group's own text whose items `items` lays.
fn base_of(items: List<ItemAt>, owner: Bytes) -> Int =
  items.fold(0 - 1, |found: Int, x: ItemAt|
    if x.owner == owner && (found < 0 || x.from < found) { x.from } else { found })

/// One owner of a group beside what its walk answered.
pub type OwnerInference = { owner: Bytes, typed: InferenceResult }

/// What a check that settles a group is handed of its bodies, given the place `slot` its module
/// has among those the check reads: each member's bodies and what their calls on values call, moved
/// to where the member stands in the check's text, which holds the group's own text from `offset`
/// with its items where `items` lays them.
pub fn supplied_bodies(
  members: List<OwnerInference>,
  items: List<ItemAt>,
  offset: Int,
) -> (Int) -> BodyChecking / {abort.raise} =
  |slot: Int| {
    let handed = members.fold(
      { bodies: Map::new(), sites: [] },
      |acc: { bodies: Map<Bytes, ReusedBody>, sites: List<MemberSite> }, m: OwnerInference| {
        let base = offset + base_of(items, m.owner);
        let filed = m.typed.filed.fold(Map::new(), |held: Map<Bytes, Bytes>, k: CachedFacts|
          held.insert(k.name, k.facts));
        {
          bodies: m.typed.bodies.fold(acc.bodies, |held: Map<Bytes, ReusedBody>, b: CheckedBody|
            held.insert(b.name, {
              body: relocated_body(b, slot, |p: Int| base + p),
              facts: match filed.get(b.name) { Some(f) -> f, None -> b"" },
            })),
          sites: acc.sites.concat(m.typed.facts.members.map(|x: MemberSite| { ..x, module: slot })),
        }
      },
    );
    ReuseBodies(handed.bodies, handed.sites)
  }

/// A group's answer: `settled`, what a check that walked none of its bodies answered of it, with
/// what only a walk makes of each member laid in from `members`, each moved to where the member's
/// items stand in the group's own text, which `items` lays.
pub fn finalized_result(
  settled: GroupResult,
  members: List<OwnerInference>,
  items: List<ItemAt>,
) -> GroupResult =
  {
    ..settled,
    members: settled.members.map(|m: MemberResult|
      match members.find(|w: OwnerInference| w.owner == m.owner) {
        None -> m,
        Some(w) -> {
          let base = base_of(items, m.owner);
          let to = { from: 0, to: 0, by: |p: Int| base + p };
          let clauses = w.typed.clauses.fold(
            Map::new(),
            |held: Map<Bytes, List<SpecInfo>>, c: Clauses| held.insert(c.name, c.spec),
          );
          {
            ..m,
            result: {
              ..m.result,
              tables: {
                ..m.result.tables,
                defs: m.result.tables.defs.map(|d: DefInfo|
                  {
                    ..d,
                    spec: match clauses.get(d.name) {
                      Some(spec) -> spec.map(|x: SpecInfo| { ..x, span: moved_at(x.span, to) }),
                      None -> d.spec,
                    },
                  }),
                facts: {
                  ..facts_moved(w.typed.facts, |i: Int| moved_index(i, to)),
                  pure: m.result.tables.facts.pure,
                },
                kept: w.typed.kept,
              },
              rows: { ..m.result.rows, types: types_joined(m.result.rows.types, w.typed.types) },
            },
          }
        },
      }),
  }

/// What a check of a module said that each owner's answer reads a part of: the check, the module's
/// place in it, what it said of the module, every definition's row and what the module shows.
pub type ModuleCheck = { w: Analysis, slot: Int, facts: ModuleFacts, rows: Rows, shown: Exports }

/// What `w` said of its module at `slot`, written as `text`, read once for every owner of it.
pub fn module_check_of(
  w: Analysis,
  slot: Int,
  text: Bytes,
  // What `parse` made of `text`, where a caller has it.
  read: Option<Module> = None,
) -> ModuleCheck / {abort.raise} = {
  let rows = rows_of(w);
  {
    w: w,
    slot: slot,
    facts: module_facts(w, slot),
    rows: rows,
    shown: exports_of(w, slot, text, read: read, published: Some(rows)),
  }
}

/// Owners that check together, and where their items stand once a group's own text lays them.
pub type GroupLayout = { members: List<OwnerText>, items: List<ItemAt> }

/// What a check that `said` what it did of `module` answered of each of `groups`, owners of it whose
/// items stand where `items` lays them, each item where `stands` says in the module the check read. Each table
/// is walked once for all of them, so the answers cost what the module does, not that times its
/// groups.
pub fn group_results(
  said: ModuleCheck,
  module: Bytes,
  groups: List<GroupLayout>,
  stands: (ItemAt) -> Int / {abort.raise},
) -> List<GroupResult> / {abort.raise} = {
  let w = said.w;
  let slot = said.slot;
  let prefix = module.concat(b".");
  let t = said.facts.tables;
  let shape = said.facts.shape;
  let members = groups.fold(
    [],
    |acc: List<OwnerText>, g: { members: List<OwnerText>, items: List<ItemAt> }|
      acc.concat(g.members),
  );
  // Whose each name a member declares is: its own names, and a test or law by its label. A name
  // two owners declare, in two namespaces, is each one's.
  let declared = members.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, o: OwnerText|
    o.names.push(o.owner).fold(acc, |a: Map<Bytes, List<Bytes>>, n: Bytes|
      a.insert(n, share_in(a, n).push_unique(o.owner))));
  let whose = |name: Bytes| share_in(declared, name);
  // `xs` under each owner `names_of` names, in their order.
  let shared_by = |xs: List<EffectSetRow>, names_of: (EffectSetRow) -> List<Bytes>|
    xs.fold(Map::new(), |acc: Map<Bytes, List<EffectSetRow>>, x: EffectSetRow|
      names_of(x).fold(acc, |a: Map<Bytes, List<EffectSetRow>>, o: Bytes|
        a.insert(o, share_in(a, o).push(x))));
  let starts = groups.fold(
    [],
    |acc: List<ItemAt>, g: { members: List<OwnerText>, items: List<ItemAt> }| acc.concat(g.items),
  ).fold(Map::new(), |acc: Map<Int, { end: Int, owner: Bytes }>, x: ItemAt| {
    let p = stands(x);
    acc.insert(p, { end: p + x.len, owner: x.owner })
  });
  // The owner whose item `s`, in module `m` of the check, stands within, where it is module `here`.
  let owning = |m: Int, here: Int, s: Span|
    if m != here { b"" } else {
      match starts.floor(s.start) {
        Some(f) -> if s.end <= f.value.end { f.value.owner } else { b"" },
        None -> b"",
      }
    };
  let placed = |m: Int, s: Span| owning(m, 0, s);
  let defs = List::group_by(t.defs, |d: DefInfo| placed(d.at.module, d.at.span));
  let def_owner = defs.fold(Map::new(), |acc: Map<Bytes, Bytes>, o: Bytes, ds: List<DefInfo>|
    ds.fold(acc, |a: Map<Bytes, Bytes>, d: DefInfo| a.insert(d.name, o)));
  let def_named = |name: Bytes| match def_owner.get(name) { Some(o) -> o, None -> b"" };
  let tests = List::group_by(t.tests, |x: TestInfo| placed(x.at.module, x.at.span));
  let test_owned = tests.fold(Map::new(), |acc: Map<Bytes, Bytes>, o: Bytes, ts: List<TestInfo>|
    ts.fold(acc, |a: Map<Bytes, Bytes>, x: TestInfo| a.insert(test_owner(x.module, x.name), o)));
  let laws = List::group_by(t.laws, |l: LawInfo| placed(l.at.module, l.at.span));
  let law_owned = laws.fold(Map::new(), |acc: Map<Bytes, Bytes>, o: Bytes, ls: List<LawInfo>|
    ls.fold(acc, |a: Map<Bytes, Bytes>, l: LawInfo| a.insert(law_owner(l.module, l.name), o)));
  // Whose a body is, by the name its sites are filed under.
  let kept_owner = |name: Bytes|
    match test_owned.get(name) {
      Some(o) -> o,
      None -> match law_owned.get(name) { Some(o) -> o, None -> def_named(name) },
    };
  let effects = List::group_by(t.effects, |x: EffectInfo| placed(x.at.module, x.at.span));
  let ctors = List::group_by(t.ctors, |c: CtorInfo| placed(c.at.module, c.at.span));
  let instances = List::group_by(t.instances, |x: InstanceInfo| placed(x.at.module, x.at.span));
  let numeric = List::group_by(t.numeric, |x: NumericInfo| placed(x.at.module, x.at.span));
  let pure = List::group_by(t.facts.pure, def_named);
  let owned = |m: Int, owner: Bytes| if m != 0 { b"" } else { kept_owner(owner) };
  let bodies = List::group_by(t.facts.bodies, |x: TypedBody<Bytes>| owned(x.module, x.owner));
  let orders = List::group_by(t.facts.orders, |x: WitnessOrder|
    def_named(Bytes::concat_all([module, b".", x.name])));
  let member_sites = List::group_by(t.facts.members, |x: MemberSite| owned(x.module, x.owner));
  let kept = List::group_by(t.kept, |k: CachedFacts| kept_owner(k.name));
  let rows = List::group_by(said.rows.defs, |r: KnownDefRow| def_named(r.name));
  // A warning is each owner's in which one of its primary labels stands.
  let warnings = w.warnings.filter(|d: Diag| d.code != b"W0611").fold(
    Map::new(),
    |acc: Map<Bytes, List<Diag>>, d: Diag|
      d.labels.fold([], |os: List<Bytes>, l: Label|
        if !l.primary { os } else {
          let o = owning(l.module, slot, span_between(l.start, l.end));
          if o.len() == 0 || os.contains(o) { os } else { os.push(o) }
        }).fold(acc, |a: Map<Bytes, List<Diag>>, o: Bytes|
        a.insert(o, List::push(match a.get(o) { Some(ds) -> ds, None -> [] }, d))),
  );
  let tagged = List::group_by(shape.tagged, |x: TaggedSite| placed(x.module, x.span));
  let statements = List::group_by(shape.statements, |x: StatementSite| placed(x.module, x.span));
  let consts = List::group_by(shape.consts, |x: TypedConst| def_named(x.name));
  let sets = shared_by(shape.outline.sets, |x: EffectSetRow| whose(x.name));
  let outlined = shape.outline.items.fold(
    Map::new(),
    |acc: Map<Bytes, List<LawOutline>>, x: OutlineItem|
      match x {
        OutlinedLaw(l) ->
          whose(b"law ".concat(l.name)).fold(acc, |a: Map<Bytes, List<LawOutline>>, o: Bytes|
            a.insert(o, share_in(a, o).push(l))),
        _ -> acc,
      },
  );
  let uses = List::group_by(w.uses, |r: UseNode| owning(r.module, slot, r.span));
  let share_of = |o: Bytes|
    {
      defs: share_in(defs, o),
      tests: share_in(tests, o),
      laws: share_in(laws, o),
      effects: share_in(effects, o),
      ctors: share_in(ctors, o),
      instances: share_in(instances, o),
      numeric: share_in(numeric, o),
      facts: {
        pure: share_in(pure, o),
        orders: share_in(orders, o),
        members: share_in(member_sites, o),
        types: types_named(t.facts.types, share_in(bodies, o)),
        bodies: share_in(bodies, o),
      },
      kept: share_in(kept, o),
      rows: share_in(rows, o),
      warnings: share_in(warnings, o),
      tagged: share_in(tagged, o),
      statements: share_in(statements, o),
      consts: share_in(consts, o),
      sets: share_in(sets, o),
      outlined: share_in(outlined, o),
      uses: share_in(uses, o),
    };
  // The module's facts number it 0; its forms, like the check's own sites, number it `slot`.
  let chosen = {
    ..module_selection(w.index, slot),
    called: Some(called_at(w.checked.facts.members)),
  };
  groups.map(|g: { members: List<OwnerText>, items: List<ItemAt> }| {
    {
      members: g.members.map(|o: OwnerText|
        {
          owner: o.owner,
          result: owner_result(said, share_of(o.owner), item_ranges(g.items, o.owner, stands)),
          entry: said.shown.entries.get(o.owner),
        }),
      refused: [],
      forms: {
        let set = |pick: (OwnerText) -> List<Bytes> / {abort.raise}|
          g.members.fold(Map::new(), |acc: Map<Bytes, Bool>, o: OwnerText|
            pick(o).fold(acc, |a: Map<Bytes, Bool>, n: Bytes| a.insert(n, true)));
        let labelled = |kind: Bytes, o: OwnerText|
          if o.owner.starts_with(kind) { [o.owner.slice(kind.len(), o.owner.len())] } else { [] };
        let among = |m: Map<Bytes, Bool>|
          |name: Bytes|
            name.starts_with(prefix) && m.contains(name.slice(prefix.len(), name.len()));
        let node_kept = among(set(|o: OwnerText| o.names));
        let test_kept = among(set(|o: OwnerText| labelled(b"test ", o)));
        let law_kept = among(set(|o: OwnerText| labelled(b"law ", o)));
        selection_forms(w.index, w.module_packages, {
          own: chosen.own.filter(|v: Int| node_kept(w.index.nodes.get(v).name)),
          tests: chosen.tests.filter(|x: TestNode| test_kept(x.key)),
          laws: chosen.laws.filter(|x: LawNode| law_kept(x.key)),
          called: chosen.called,
        })
      },
      // Only what its own items embed, as they are written: another group's files are that group's.
      embeds: {
        let text = Bytes::join(
          g.members.fold([], |acc: List<Bytes>, o: OwnerText| acc.concat(o.texts)),
          b"\n\n",
        );
        let wanted = if !may_call_embed(text) { Map::new() } else {
          embed_requests(parse(text).node).fold(
            Map::new(),
            |acc: Map<Bytes, Bool>, want: EmbedRequest| acc.insert(embed_key(want), true),
          )
        };
        w.embeds.filter(|x: ModuleEmbed| x.module == module && wanted.contains(x.key))
      },
    }
  })
}

/// What `m` holds under `o`, or nothing.
fn share_in<a>(m: Map<Bytes, List<a>>, o: Bytes) -> List<a> =
  match m.get(o) { Some(xs) -> xs, None -> [] }

/// `a`, an owner whose tests and laws follow `tests` tests and `laws` laws of its module: each
/// numbered by its place among the module's.
pub fn numbered(a: OwnerResult, tests: Int, laws: Int) -> OwnerResult =
  {
    ..a,
    tables: {
      ..a.tables,
      tests: a.tables.tests.map(|x: TestInfo| { ..x, index: x.index + tests }),
      laws: a.tables.laws.map(|x: LawInfo| { ..x, index: x.index + laws }),
    },
  }

// --- A module put together from its groups -----------------------------------------------------

/// What a module answers as its groups answered: what its check says of it, what its definitions
/// and tests published, its warnings, the errors that refuse it, how many definitions and tests it
/// checked, and each owner's entry.
pub type AssembledModule = {
  facts: ModuleFacts,
  rows: Rows,
  warnings: List<Diag>,
  refused: List<Diag>,
  defs: Int,
  tests: Int,
  entries: Map<Bytes, OwnerInterface>,
}

/// One group's answer beside where its items stand as [`group_source`] lays them.
pub type PositionedGroup = { items: List<ItemAt>, result: GroupResult }

/// `xs` in the order `rank` says, those of one rank in the order they came.
fn ranked<a>(xs: List<a>, rank: (a) -> Int / {abort.raise}) -> List<a> / {abort.raise} =
  range(0, xs.len()).map(|i: Int| { rank: rank(xs.get(i)), at: i }).sort_by(
    |a: { rank: Int, at: Int }, b: { rank: Int, at: Int }|
      a.rank < b.rank || (a.rank == b.rank && a.at <= b.at),
  ).map(|x: { rank: Int, at: Int }| xs.get(x.at))

/// What `pick` holds of each of `owners`, one after another.
fn gathered<a>(owners: List<OwnerResult>, pick: (OwnerResult) -> List<a>) -> List<a> =
  owners.fold([], |acc: List<a>, a: OwnerResult| acc.concat(pick(a)))

/// Where a diagnostic's first primary label starts.
fn diag_start(d: Diag) -> Int =
  d.labels.fold(0 - 1, |acc: Int, l: Label| if acc < 0 && l.primary { l.start } else { acc })

/// What `module` answers as its groups answered, `groups` each placed: `shape` is what its text
/// alone says of its shape, `order` its functions in the order a check of it files them, `filed`
/// in the order it walks their bodies, which files the sites it finds in them, and `unused` whether
/// it warns of what nothing in it uses, as a module of the load's own root does, and a shipped one
/// read with its tests.
pub fn assembled(
  module: Bytes,
  shape: ModuleShape,
  order: List<Bytes>,
  filed: List<Bytes>,
  groups: List<PositionedGroup>,
  unused: Bool,
) -> AssembledModule / {abort.raise} = {
  let at = |names: List<Bytes>|
    range(0, names.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int|
      acc.insert(names.get(i), i));
  let place = at(order);
  let walked = |name: Bytes| match place.get(name) { Some(k) -> k, None -> order.len() };
  let walk = at(filed);
  // Each member's answer placed where its items stand, in the order its first item does.
  let placed = ranked(
    groups.fold(
      [],
      |acc: List<{ first: Int, member: MemberResult, result: OwnerResult }>, g: PositionedGroup|
        g.result.members.fold(
          acc,
          |a: List<{ first: Int, member: MemberResult, result: OwnerResult }>, m: MemberResult|
            a.push({
              first: g.items.fold(0 - 1, |f: Int, x: ItemAt|
                if x.owner == m.owner && (f < 0 || x.to < f) { x.to } else { f }),
              member: m,
              result: relocated_result(m.result, g.items),
            }),
        ),
    ),
    |x: { first: Int, member: MemberResult, result: OwnerResult }| x.first,
  );
  let numbered_all = placed.fold(
    { tests: 0, laws: 0, out: [] },
    |acc: { tests: Int, laws: Int, out: List<OwnerResult> }, x: { first: Int, member: MemberResult, result: OwnerResult }| {
      let a = numbered(x.result, acc.tests, acc.laws);
      {
        tests: acc.tests + a.tables.tests.len(),
        laws: acc.laws + a.tables.laws.len(),
        out: acc.out.push(a),
      }
    },
  );
  let owners = numbered_all.out;
  let test_at = shape.outline.items.fold(
    { next: 0, at: Map::new() },
    |acc: { next: Int, at: Map<Bytes, Int> }, x: OutlineItem|
      match x {
        OutlinedTest(t) ->
          { next: acc.next + 1, at: acc.at.insert(test_owner(module, t.name), acc.next) },
        _ -> acc,
      },
  ).at;
  let law_at = shape.outline.items.fold(
    { next: 0, at: Map::new() },
    |acc: { next: Int, at: Map<Bytes, Int> }, x: OutlineItem|
      match x {
        OutlinedLaw(l) -> { next: acc.next + 1, at: acc.at.insert(l.name, acc.next) },
        _ -> acc,
      },
  ).at;
  let outlined_at = |x: LawInfo| match law_at.get(x.name) { Some(k) -> k, None -> x.index };
  let law_rank = gathered(owners, |a: OwnerResult| a.tables.laws).fold(
    Map::new(),
    |acc: Map<Bytes, Int>, x: LawInfo| acc.insert(law_owner(x.module, x.name), outlined_at(x)),
  );
  // A check files the sites of the functions, then the tests', then the laws', each owner's
  // together and in the order its walks recorded them in, so each ranks by its owner.
  let site_rank = |owner: Bytes|
    match walk.get(owner) {
      Some(k) -> k,
      None -> match test_at.get(owner) {
        Some(k) -> 2000000000 + k,
        None -> 3000000000 + (match law_rank.get(owner) { Some(k) -> k, None -> 999999999 }),
      },
    };
  let tables = {
    defs: ranked(gathered(owners, |a: OwnerResult| a.tables.defs), |d: DefInfo| walked(d.name)),
    tests: gathered(owners, |a: OwnerResult| a.tables.tests),
    // Laws are numbered as the module's outline lists them, the laws `cost` clauses make last, as a
    // check of the whole module numbers them, not by the function each belongs to.
    laws: ranked(gathered(owners, |a: OwnerResult| a.tables.laws), outlined_at).map(|x: LawInfo|
      { ..x, index: outlined_at(x) }),
    effects: ranked(gathered(owners, |a: OwnerResult| a.tables.effects), |x: EffectInfo|
      x.at.span.start),
    ctors: ranked(gathered(owners, |a: OwnerResult| a.tables.ctors), |x: CtorInfo| x.at.span.start),
    instances: ranked(gathered(owners, |a: OwnerResult| a.tables.instances), |x: InstanceInfo|
      x.at.span.start),
    numeric: ranked(gathered(owners, |a: OwnerResult| a.tables.numeric), |x: NumericInfo|
      x.at.span.start),
    facts: {
      pure: ranked(gathered(owners, |a: OwnerResult| a.tables.facts.pure), walked),
      orders: ranked(gathered(owners, |a: OwnerResult| a.tables.facts.orders), |x: WitnessOrder|
        walked(Bytes::concat_all([module, b".", x.name]))),
      members: ranked(gathered(owners, |a: OwnerResult| a.tables.facts.members), |x: MemberSite|
        site_rank(x.owner)),
      types: owners.fold(Map::new(), |acc: TypeTable, a: OwnerResult|
        types_joined(acc, a.tables.facts.types)),
      bodies: ranked(
        gathered(owners, |a: OwnerResult| a.tables.facts.bodies),
        |x: TypedBody<Bytes>| site_rank(x.owner),
      ),
    },
    kept: ranked(gathered(owners, |a: OwnerResult| a.tables.kept), |k: CachedFacts|
      site_rank(k.name)),
  };
  let laws = owners.fold(Map::new(), |acc: Map<Bytes, LawOutline>, a: OwnerResult|
    a.laws.fold(acc, |m: Map<Bytes, LawOutline>, l: LawOutline| m.insert(l.name, l)));
  let outline = shape.outline;
  {
    facts: {
      shape: {
        ..shape,
        outline: {
          ..outline,
          items: outline.items.map(|x: OutlineItem|
            match x {
              OutlinedLaw(l) -> match laws.get(l.name) { Some(k) -> OutlinedLaw(k), None -> x },
              _ -> x,
            }),
          sets: gathered(owners, |a: OwnerResult| a.sets),
        },
        embeds: groups.fold(
          Map::new(),
          |acc: Map<Bytes, ModuleEmbed>, g: PositionedGroup|
            g.result.embeds.fold(acc, |m: Map<Bytes, ModuleEmbed>, e: ModuleEmbed|
              m.insert(e.key, e)),
        ).values(
        ).sort_by(|a: ModuleEmbed, b: ModuleEmbed|
          match compare_values(a.key, b.key) { Greater -> false, _ -> true }),
        tagged: ranked(gathered(owners, |a: OwnerResult| a.tagged), |x: TaggedSite| x.span.start),
        statements: ranked(gathered(owners, |a: OwnerResult| a.statements), |x: StatementSite|
          x.span.start),
        consts: ranked(gathered(owners, |a: OwnerResult| a.consts), |x: TypedConst| walked(x.name)),
      },
      tables: tables,
    },
    rows: {
      defs: ranked(gathered(owners, |a: OwnerResult| a.rows.defs), |r: KnownDefRow| walked(r.name)),
      tests: gathered(owners, |a: OwnerResult| a.rows.tests),
      types: owners.fold(Map::new(), |acc: TypeTable, a: OwnerResult|
        types_joined(acc, a.rows.types)),
    },
    warnings: ranked(
      gathered(owners, |a: OwnerResult| a.warnings).concat(if unused {
        unreached(gathered(owners, |a: OwnerResult| a.uses))
      } else { [] }),
      diag_start,
    ),
    refused: ranked(
      groups.fold([], |acc: List<Diag>, g: PositionedGroup|
        acc.concat(
          g.result.refused.map(|d: Diag|
            moved_diag(d, {
              from: 0,
              to: 0,
              by: |p: Int|
                g.items.fold(p, |q: Int, x: ItemAt|
                  if p >= x.from && p <= x.from + x.len { x.to + (p - x.from) } else { q }),
            })),
        )),
      diag_start,
    ),
    defs: tables.defs.len(),
    tests: tables.tests.len(),
    entries: placed.fold(
      Map::new(),
      |acc: Map<Bytes, OwnerInterface>, x: { first: Int, member: MemberResult, result: OwnerResult }|
        match x.member.entry { Some(e) -> acc.insert(x.member.owner, e), None -> acc },
    ),
  }
}

// --- Tests ----------------------------------------------------------------------------------

/// What a module's own check said of it: its facts, its definitions' rows and its warnings.
type Whole = {
  module: Bytes,
  whole: ModuleFacts,
  rows: List<KnownDefRow>,
  warnings: List<Diag>,
  owners: List<OwnerResult>,
}

/// Each owner of each module of `sources`, checked alone and placed where its items stand, beside
/// `whole`'s answer of its module.
fn owned_apart(whole: Analysis, sources: List<Source>) -> List<Whole> / {abort.raise} = {
  let texts = sources.fold(Map::new(), |acc: Map<Bytes, Bytes>, s: Source|
    acc.insert(s.name, s.src));
  let text_at = |i: Int| match texts.get(whole.mods.get(i).name) { Some(t) -> t, None -> b"" };
  let exports = range(0, whole.mods.len()).fold(Map::new(), |acc: Map<Bytes, Exports>, i: Int|
    acc.insert(whole.mods.get(i).name, exports_of(whole, i, text_at(i))));
  let reading = {
    pkgs: { root: b"", manifest: None, supplied: [] },
    tested: true,
    whole: [],
    data: [],
    embeds: [],
    given: [],
    judged: None,
    unread: [],
  };
  let placing = |m: Bytes| if texts.contains(m) { InRoot } else { ShippedModule };
  range(0, whole.mods.len()).fold([], |acc: List<Whole>, i: Int| {
    let parsed = whole.mods.get(i);
    if !texts.contains(parsed.name) { acc } else {
      let raw = parse(text_at(i)).node;
      let owners = raw.items.fold([], |os: List<Bytes>, item: Item| {
        let o = item_owner(item);
        if os.contains(o) { os } else { os.push(o) }
      });
      acc.push({
        module: parsed.name,
        whole: module_facts(whole, i),
        rows: rows_of(whole).defs.filter(|r: KnownDefRow| is_declared_in(parsed.name, r.name)),
        warnings: whole.warnings.filter(|d: Diag|
          d.labels.fold(false, |b: Bool, l: Label| b || (l.primary && l.module == i))).map(
          |d: Diag| { ..d, labels: d.labels.map(|l: Label| { ..l, module: 0 }) },
        ),
        owners: owners.map(|o: Bytes| {
          let source = owner_source(
            parsed,
            raw,
            text_at(i),
            import_targets(whole, i),
            o,
            |module: Bytes, n: Bytes| owner_interfaces_in(exports, module, n),
            |_: Bytes| visible_modules(whole, i),
          );
          let checked = checked_owner(source, InRoot, placing, reading);
          let g = group_result(
            checked.pulled.out,
            checked.at,
            source.source.src,
            parsed.name,
            owner_texts(parsed, raw, text_at(i)).filter(|r: OwnerText| r.owner == o),
            source.items,
            |x: ItemAt| source.offset + x.from,
          );
          match g.members {
            [m] -> relocated_result(m.result, source.items),
            _ -> panic("owner `" ++ String::of_bytes_lossy(o) ++ "` checks alone"),
          }
        }),
      })
    }
  })
}

fn sorted_by<a>(xs: List<a>, key: (a) -> Bytes / {abort.raise}) -> List<a> / {abort.raise} =
  xs.sort_by(|x: a, y: a| match compare_values(key(x), key(y)) { Greater -> false, _ -> true })

fn span_text(s: Span) -> Bytes =
  Bytes::concat_all([
    Bytes::of_string(s.start.to_string()),
    b":",
    Bytes::of_string(s.end.to_string()),
  ])

fn site_text(owner: Bytes, site: Int) -> Bytes =
  Bytes::concat_all([owner, b"#", Bytes::of_string(site.to_string())])

/// What a module's check said of it, each list in an order no check's order decides: what a module
/// assembled from its owners' answers is held to.
fn normalized_tables(t: ModuleTables) -> ModuleTables / {abort.raise} =
  {
    defs: sorted_by(t.defs, |d: DefInfo| d.name),
    tests: sorted_by(t.tests, |x: TestInfo| x.key),
    laws: sorted_by(t.laws, |x: LawInfo| x.key),
    effects: sorted_by(t.effects, |x: EffectInfo| x.name),
    ctors: sorted_by(t.ctors, |x: CtorInfo| x.name),
    instances: sorted_by(t.instances, |x: InstanceInfo| span_text(x.at.span)),
    numeric: sorted_by(t.numeric, |x: NumericInfo| span_text(x.at.span)),
    facts: {
      pure: sorted_by(t.facts.pure, |n: Bytes| n),
      orders: sorted_by(t.facts.orders, |x: WitnessOrder| x.name),
      members: sorted_by(t.facts.members, |x: MemberSite| site_text(x.owner, x.site)),
      types: t.facts.types,
      bodies: sorted_by(t.facts.bodies, |x: TypedBody<Bytes>|
        Bytes::concat_all([x.owner, b"#", part_key(x.part)])),
    },
    kept: sorted_by(t.kept, |x: CachedFacts| x.name),
  }

/// The tables of `owners`, the answers of the owners of a module in the order it writes them, put
/// together.
fn joined_tables(owners: List<OwnerResult>) -> ModuleTables =
  owners.fold(no_module_tables(), |acc: ModuleTables, a: OwnerResult| {
    let t = numbered(a, acc.tests.len(), acc.laws.len()).tables;
    {
      defs: acc.defs.concat(t.defs),
      tests: acc.tests.concat(t.tests),
      laws: acc.laws.concat(t.laws),
      effects: acc.effects.concat(t.effects),
      ctors: acc.ctors.concat(t.ctors),
      instances: acc.instances.concat(t.instances),
      numeric: acc.numeric.concat(t.numeric),
      facts: {
        pure: acc.facts.pure.concat(t.facts.pure),
        orders: acc.facts.orders.concat(t.facts.orders),
        members: acc.facts.members.concat(t.facts.members),
        types: types_joined(acc.facts.types, t.facts.types),
        bodies: acc.facts.bodies.concat(t.facts.bodies),
      },
      kept: acc.kept.concat(t.kept),
    }
  })

fn agrees(sources: List<Source>) -> Unit / {abort.raise} = {
  let whole = match analyse_pulling_std_with(sources, [], no_rows()).out {
    Analysed(w) -> w,
    Refused(_) -> panic("the fixture checks"),
  };
  owned_apart(whole, sources).fold((), |u: Unit, m: Whole| {
    let apart = normalized_tables(joined_tables(m.owners));
    let checked = normalized_tables(m.whole.tables);
    assert_eq(apart.defs.map(|d: DefInfo| d.name), checked.defs.map(|d: DefInfo| d.name));
    assert_eq(apart.defs, checked.defs);
    assert_eq(apart.tests, checked.tests);
    assert_eq(apart.laws, checked.laws);
    assert_eq(apart.effects, checked.effects);
    assert_eq(apart.ctors, checked.ctors);
    assert_eq(apart.instances, checked.instances);
    assert_eq(apart.numeric, checked.numeric);
    assert_eq(apart.facts, checked.facts);
    assert_eq(apart.kept, checked.kept);
    let rows = sorted_by(m.owners.map(|a: OwnerResult| a.rows.defs).flatten(), |r: KnownDefRow|
      r.name);
    assert_eq(
      rows,
      sorted_by(m.rows.map(|r: KnownDefRow| { ..r, hash: b"" }), |r: KnownDefRow| r.name),
    );
    assert_eq(
      sorted_by(m.owners.map(|a: OwnerResult| a.tagged).flatten(), |x: TaggedSite|
        span_text(x.span)),
      sorted_by(m.whole.shape.tagged, |x: TaggedSite| span_text(x.span)),
    );
    assert_eq(
      sorted_by(m.owners.map(|a: OwnerResult| a.statements).flatten(), |x: StatementSite|
        span_text(x.span)),
      sorted_by(m.whole.shape.statements, |x: StatementSite| span_text(x.span)),
    );
    assert_eq(
      sorted_by(m.owners.map(|a: OwnerResult| a.consts).flatten(), |x: TypedConst| x.name),
      sorted_by(m.whole.shape.consts, |x: TypedConst| x.name),
    );
    assert_eq(
      m.owners.map(|a: OwnerResult| a.warnings).flatten().map(|d: Diag| d.message),
      m.warnings.filter(|d: Diag| d.code != b"W0611").map(|d: Diag| d.message),
    )
  })
}

test "each owner checked alone and placed where it stands answers what its module's check does" {
  agrees([{ name: b"core", src: core_fixture() }, { name: b"shop", src: shop_fixture() }]);
  agrees(faceted())
}

/// Each module of `sources` put together from its groups' answers, each group checked against the
/// entries it reads, beside `whole`'s answer of it.
fn assembled_apart(
  whole: Analysis,
  sources: List<Source>,
) -> List<{ module: Bytes, whole: ModuleFacts, rows: List<KnownDefRow>, warned: List<Bytes>, apart: AssembledModule }> / {abort.raise} = {
  let texts = sources.fold(Map::new(), |acc: Map<Bytes, Bytes>, s: Source|
    acc.insert(s.name, s.src));
  let text_at = |i: Int| match texts.get(whole.mods.get(i).name) { Some(t) -> t, None -> b"" };
  let exports = range(0, whole.mods.len()).fold(Map::new(), |acc: Map<Bytes, Exports>, i: Int|
    acc.insert(whole.mods.get(i).name, exports_of(whole, i, text_at(i))));
  let reading = {
    pkgs: { root: b"", manifest: None, supplied: [] },
    tested: true,
    whole: [],
    data: [],
    embeds: [],
    given: [],
    judged: None,
    unread: [],
  };
  let placing = |m: Bytes| if texts.contains(m) { InRoot } else { ShippedModule };
  range(0, whole.mods.len()).fold(
    [],
    |acc: List<{ module: Bytes, whole: ModuleFacts, rows: List<KnownDefRow>, warned: List<Bytes>, apart: AssembledModule }>, i: Int| {
      let parsed = whole.mods.get(i);
      if !texts.contains(parsed.name) { acc } else {
        let text = text_at(i);
        let lexed = start(text);
        let raw = parse_started(lexed).node;
        let targets = import_targets(whole, i);
        let scope = module_scope(parsed, raw, targets);
        let reads = owner_texts(parsed, raw, text);
        let mentions = reads.fold(Map::new(), |m: Map<Bytes, List<Mention>>, o: OwnerText|
          m.insert(
            o.owner,
            owner_mentions(parsed.name, scope, o, text, owner_tokens(lexed.input.tokens, o)),
          ));
        let groups = owner_groups(parsed.name, scope, reads.map(|o: OwnerText| o.owner), mentions);
        let facts = module_facts(whole, i);
        let base = {
          ..facts.shape,
          outline: read_outline(parsed),
          tagged: [],
          statements: [],
          consts: [],
        };
        let placed = groups.map(|g: List<Bytes>| {
          let members = reads.filter(|o: OwnerText| g.contains(o.owner));
          let named = g.fold([], |ms: List<Mention>, o: Bytes|
            ms.concat(match mentions.get(o) { Some(xs) -> xs, None -> [] }));
          let source = group_source(
            parsed.name,
            members,
            named,
            group_imports(parsed.name, members, named, unplaced_imports(raw), targets),
            |module: Bytes, n: Bytes| owner_interfaces_in(exports, module, n),
            |_: Bytes| visible_modules(whole, i),
          );
          let checked = checked_owner(source, InRoot, placing, reading);
          {
            items: source.items,
            result: read_back(
              group_result(
                checked.pulled.out,
                checked.at,
                source.source.src,
                parsed.name,
                members,
                source.items,
                |x: ItemAt| source.offset + x.from,
              ),
            ),
          }
        });
        let answers = placed.map(|x: { items: List<ItemAt>, result: GroupResult }| x.result);
        assert_eq(encode_groups(answers), answers.map(encode_group));
        acc.push({
          module: parsed.name,
          whole: facts,
          rows: rows_of(whole).defs.filter(|r: KnownDefRow| is_declared_in(parsed.name, r.name)),
          warned: diag_summaries(
            whole.warnings.filter(|d: Diag|
              d.labels.fold(false, |b: Bool, l: Label| b || (l.primary && l.module == i))),
          ),
          apart: assembled(
            parsed.name,
            base,
            checked_functions(parsed),
            check_order(parsed),
            placed,
            true,
          ),
        })
      }
    },
  )
}

/// `a` read back from what its record keeps, which shows each member's entry as `a` holds it.
fn read_back(a: GroupResult) -> GroupResult / {abort.raise} = {
  let kept = encode_group(a);
  let shown = group_interfaces(kept);
  a.members.fold((), |_: Unit, m: MemberResult|
    assert_eq(
      shown.get(m.owner),
      Some(match m.entry { Some(e) -> bin::encode(e, owner_interface_bin()), None -> b"" }),
    ));
  match bin::decode(kept, encoded_group_bin()) {
    Ok(k) -> {
      let back = decode_group(k);
      assert_eq(back, a);
      back
    },
    Err(_) -> panic("a group's record reads back"),
  }
}

/// Each of `ds` as its code and message say it, in order.
pub fn diag_summaries(ds: List<Diag>) -> List<Bytes> =
  ds.map(|d: Diag| Bytes::concat_all([d.code, b": ", d.message])).sort_by(|a: Bytes, b: Bytes|
    match compare_values(a, b) { Greater -> false, _ -> true })

fn assembles(sources: List<Source>) -> Unit / {abort.raise} = {
  let whole = match analyse_pulling_std_with(sources, [], no_rows()).out {
    Analysed(w) -> w,
    Refused(_) -> panic("the fixture checks"),
  };
  assembled_apart(whole, sources).fold(
    (),
    |u: Unit, m: { module: Bytes, whole: ModuleFacts, rows: List<KnownDefRow>, warned: List<Bytes>, apart: AssembledModule }| {
      let a = m.apart.facts;
      let w = m.whole;
      assert_eq(a.tables.defs.map(|d: DefInfo| d.name), w.tables.defs.map(|d: DefInfo| d.name));
      assert_eq(a.tables.defs, w.tables.defs);
      assert_eq(a.tables.tests, w.tables.tests);
      assert_eq(a.tables.laws, w.tables.laws);
      assert_eq(a.tables.effects, w.tables.effects);
      assert_eq(a.tables.ctors, w.tables.ctors);
      assert_eq(a.tables.instances, w.tables.instances);
      assert_eq(a.tables.numeric, w.tables.numeric);
      assert_eq(a.tables.facts.pure, w.tables.facts.pure);
      assert_eq(a.tables.facts.orders, w.tables.facts.orders);
      assert_eq(a.tables.facts.members, w.tables.facts.members);
      assert_eq(a.tables.facts.bodies, w.tables.facts.bodies);
      assert_eq(a.tables.facts.types, w.tables.facts.types);
      assert_eq(a.tables.kept, w.tables.kept);
      assert_eq(a.shape.outline, w.shape.outline);
      assert_eq(a.shape, w.shape);
      assert_eq(m.apart.rows.defs, m.rows.map(|r: KnownDefRow| { ..r, hash: b"" }));
      assert_eq(diag_summaries(m.apart.warnings), m.warned)
    },
  )
}

test "a module put together from its groups' answers is what its check answers" {
  assembles([{ name: b"core", src: core_fixture() }, { name: b"shop", src: shop_fixture() }]);
  assembles(faceted());
  // The laws `cost` clauses make come after a law written below their functions.
  assembles([
    {
      name: b"m",
      src: b"pub fn enc(data: Bytes) -> String / {abort.raise}\n  cost data.len()\n= String::of_bytes(data)\n\npub fn plain(text: String) -> String = text\n\nlaw \"plain is idempotent\" forall (t: String) { plain(plain(t)) == plain(t) }\n",
    },
  ]);
  // A function is walked after one written below it that it calls, so the sites a check finds in
  // the one below come first.
  assembles([
    {
      name: b"m",
      src: b"pub fn total(xs: List<Int>) -> Int = counted(xs) + xs.len()\n\nfn counted(xs: List<Int>) -> Int = xs.fold(0, |n: Int, x: Int| n + x)\n",
    },
  ])
}

test "a group holds the files its own items embed, and no other group's" {
  let src = b"pub fn a() -> Bytes = embed(\"x.txt\")\n\npub fn b() -> Bytes = embed(\"y.txt\")\n\npub fn c() -> Int = 1\n";
  let file = |path: Bytes|
    {
      root: b"",
      module: b"m",
      want: { path: path, dir: false },
      read: Ok([embed_file(b"", path)]),
    };
  let w = match analyse_pulling_std_with(
      [{ name: b"m", src: src }],
      [],
      no_rows(),
      embeds: [file(b"x.txt"), file(b"y.txt")],
    ).out {
    Analysed(w) -> w,
    Refused(_) -> panic("the fixture checks"),
  };
  let said = module_check_of(w, 0, src);
  let reads = owner_texts(w.mods.get(0), parse(src).node, src);
  let held = |owner: Bytes| {
    let members = reads.filter(|o: OwnerText| o.owner == owner);
    group_results(
      said,
      b"m",
      [{ members: members, items: item_layout(members) }],
      |x: ItemAt| x.to,
    ).get(
      0,
    ).embeds.map(|e: ModuleEmbed| e.key)
  };
  assert_eq(held(b"a"), [b"file:x.txt"]);
  assert_eq(held(b"b"), [b"file:y.txt"]);
  assert_eq(held(b"c"), [])
}

fn core_fixture() -> Bytes =
  b"pub type Money = Int\npub type Item =\n  | Book(String, Money)\n  | Note(String)\npub effect db {\n  read get[r](key: Int) -> Int\n  write put[r](key: Int, value: Int) -> Int\n}\n/// The price.\npub fn price(i: Item) -> Money =\n  match i {\n    Book(_, p) -> p,\n    Note(_) -> 0,\n  }\npub fn twice<a>(x: a, f: (a) -> a) -> a = f(f(x))\nfn helper() -> Int = 7\npub fn clipped(b: Bytes, n: Int) -> Bytes / {abort.raise} = {\n  // At most `n` bytes.\n  let k = if n > b.len() { b.len() } else { n };\n  b.slice(0, k)\n}\ntest \"a note is free\" {\n  assert_eq(price(Note(\"n\")), 0)\n}\n"

fn shop_fixture() -> Bytes =
  b"import core\nfn total(items: List<core::Item>) -> Int =\n  items.fold(0, |acc, i: core::Item| acc + core::price(i))\nfn doubled(n: Int) -> Int = core::twice(n, |x: Int| x + x)\nfn stored(k: Int) -> Int / {core::db.read[cart]} = core::db.get[cart](k)\ntest \"it adds up\" {\n  assert_eq(total([core::Book(\"b\", 3), core::Note(\"n\")]), 3)\n}\n"
