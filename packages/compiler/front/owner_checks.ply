pub type OwnerResult = {
  tables: ModuleTables,
  rows: Rows,
  warnings: List<Diagnostic>,
  tagged: List<TaggedSite>,
  statements: List<StatementSite<Bytes>>,
  consts: List<TypedConst>,
  sets: List<EffectSetRow>,
  laws: List<LawOutline>,
  uses: List<UseNode>,
}

pub type Relocation = { from: Int, to: Int, by: (Int) -> Int }

fn moved_at(s: Span, m: Relocation) -> Span = mapped_span(s, m.by)

fn moved_place(place: Place, m: Relocation) -> Place =
  if place_module(place) == Some(m.from) { mapped_place(place, m.to, m.by) } else { place }

fn moved_location(l: Location, m: Relocation) -> Location =
  if l.module == m.from { { module: m.to, span: moved_at(l.span, m) } } else { l }

fn moved_index(module: Int, m: Relocation) -> Int = if module == m.from { m.to } else { module }

fn moved_spanned(module: Int, s: Span, m: Relocation) -> Span =
  if module == m.from { moved_at(s, m) } else { s }

fn moved_definition(d: DefinitionInfo, m: Relocation) -> DefinitionInfo =
  {
    ..d,
    at: moved_location(d.at, m),
    spec: d.spec.map(|x: SpecInfo| { ..x, span: moved_spanned(d.at.module, x.span, m) }),
  }

fn moved_tables(t: ModuleTables, m: Relocation) -> ModuleTables =
  {
    ..t,
    definitions: t.definitions.map(|d: DefinitionInfo| moved_definition(d, m)),
    tests: t.tests.map(|x: TestInfo|
      { ..x, at: moved_location(x.at, m), label: moved_location(x.label, m) }),
    laws: t.laws.map(|l: LawInfo|
      {
        ..l,
        at: moved_location(l.at, m),
        binders: l.binders.map(|b: LawBinder| { ..b, span: moved_spanned(l.at.module, b.span, m) }),
      }),
    effects: t.effects.map(|x: EffectInfo|
      {
        ..x,
        at: moved_location(x.at, m),
        operations: x.operations.map(|operation: OperationInfo|
          { ..operation, at: moved_location(operation.at, m) }),
      }),
    constructors: t.constructors.map(|c: ConstructorInfo| { ..c, at: moved_location(c.at, m) }),
    instances: t.instances.map(|x: InstanceInfo| { ..x, at: moved_location(x.at, m) }),
    numeric: t.numeric.map(|x: NumericInfo| { ..x, at: moved_location(x.at, m) }),
    facts: remap_fact_modules(t.facts, |i: Int| moved_index(i, m)),
  }

fn moved_diagnostic(d: Diagnostic, m: Relocation) -> Diagnostic =
  {
    ..d,
    labels: d.labels.map(|l: Label| { ..l, place: moved_place(l.place, m) }),
    fixes: fixes_moved(d.fixes, |x: Edit|
      if x.module == m.from { { ..x, module: m.to, start: (m.by)(x.start), end: (m.by)(x.end) } }
      else { x }),
  }

fn moved_tagged(x: TaggedSite, m: Relocation) -> TaggedSite =
  {
    ..x,
    span: moved_at(x.span, m),
    parts: x.parts.map(|p: TaggedPart| { ..p, quoted: moved_at(p.quoted, m) }),
  }

pub type ItemRange = { at: Int, len: Int, rel: Int }

fn in_own_slot(d: Diagnostic, slot: Int, spots: List<ItemRange>) -> Diagnostic = {
  let placed = |module: Int, start: Int, end: Int|
    within(module, span_between(start, end), slot, spots);
  {
    ..d,
    labels: somes(
      d.labels.map(|l: Label|
        match l.place {
          InSource(s) -> if placed(s.module, s.start, s.end) {
            Some({ ..l, place: InSource({ ..s, module: 0 }) })
          } else { None },
          _ -> None,
        }),
    ),
    fixes: fixes_moved(
      fixes_kept(d.fixes, |e: Edit| placed(e.module, e.start, e.end)),
      |e: Edit| { ..e, module: 0 },
    ),
  }
}

fn within(module: Int, s: Span, at: Int, spots: List<ItemRange>) -> Bool =
  module == at
    && spots.fold(false, |b: Bool, x: ItemRange| b || (s.start >= x.at && s.end <= x.at + x.len))

fn group_offset(spots: List<ItemRange>, p: Int) -> Int =
  spots.fold(p, |accumulator: Int, x: ItemRange|
    if p >= x.at && p <= x.at + x.len { x.rel + (p - x.at) } else { accumulator })

fn owner_result(
  module_check: ModuleCheck,
  share: OwnerPart,
  uses: List<UseNode>,
  spots: List<ItemRange>,
) -> OwnerResult / {abort.raise} = {
  let t = module_check.facts.tables;
  let owner_tables = {
    ..t,
    definitions: share.definitions,
    tests: share.tests,
    laws: share.laws,
    effects: share.effects,
    constructors: share.constructors,
    instances: share.instances,
    numeric: share.numeric,
    facts: share.facts,
    cached: share.cached,
  };
  let back = { from: 0, to: 0, by: |p: Int| group_offset(spots, p) };
  let own_labels = |d: Diagnostic| in_own_slot(d, 0, spots);
  let lowest = |xs: List<Int>|
    xs.fold(0 - 1, |accumulator: Int, k: Int|
      if accumulator < 0 || k < accumulator { k } else { accumulator });
  let first_test = lowest(share.tests.map(|x: TestInfo| x.index));
  let first_law = lowest(share.laws.map(|l: LawInfo| l.index));
  let owned_laws = share.laws.map(|l: LawInfo| law_owner(l.module, l.name));
  let law_rows = module_check.rows.laws.filter(|r: KnownLawRow| owned_laws.contains(r.owner));
  offset_indexes(
    {
      tables: moved_tables(owner_tables, back),
      rows: {
        definitions: share.rows,
        tests: [],
        laws: law_rows,
        types: types_of_rows(
          module_check.rows.types,
          share.rows,
          law_rows.map(|r: KnownLawRow| r.body_facts),
        ),
      },
      warnings: share.warnings.map(|d: Diagnostic| moved_diagnostic(own_labels(d), back)),
      tagged: share.tagged.map(|x: TaggedSite| moved_tagged(x, back)),
      statements: share.statements.map(|x: StatementSite<Bytes>|
        { ..x, span: moved_at(x.span, back) }),
      consts: share.consts,
      sets: share.sets,
      laws: share.law_outlines,
      uses: uses,
    },
    if first_test < 0 { 0 } else { 0 - first_test },
    if first_law < 0 { 0 } else { 0 - first_law },
  )
}

type OwnerPart = {
  definitions: List<DefinitionInfo>,
  tests: List<TestInfo>,
  laws: List<LawInfo>,
  effects: List<EffectInfo>,
  constructors: List<ConstructorInfo>,
  instances: List<InstanceInfo>,
  numeric: List<NumericInfo>,
  facts: EmitFacts,
  cached: List<CachedFacts>,
  rows: List<KnownDefinitionRow>,
  warnings: List<Diagnostic>,
  tagged: List<TaggedSite>,
  statements: List<StatementSite<Bytes>>,
  consts: List<TypedConst>,
  sets: List<EffectSetRow>,
  law_outlines: List<LawOutline>,
}

pub opaque type InGroup<a> = | InGroup(a)

derive bin for InGroup

fn item_relocation(source: List<ItemAt>, destination: List<ItemAt>) -> Relocation / {abort.raise} = {
  let pairs = paired_items(source, destination);
  { from: 0, to: 0, by: |p: Int| placed_position(pairs, p) }
}

fn relocated<a, b>(
  x: InGroup<a>,
  source: List<ItemAt>,
  destination: List<ItemAt>,
  move: (a, Relocation) -> b / {abort.raise},
) -> b / {abort.raise} = match x { InGroup(v) -> move(v, item_relocation(source, destination)) }

fn within_group<a, b>(x: InGroup<a>, f: (a) -> b / {abort.raise}) -> InGroup<b> / {abort.raise} =
  match x { InGroup(v) -> InGroup(f(v)) }

fn position_free<a, b>(x: InGroup<a>, read: (a) -> b / {abort.raise}) -> b / {abort.raise} =
  match x { InGroup(v) -> read(v) }

fn relocated_diagnostics(ds: List<Diagnostic>, m: Relocation) -> List<Diagnostic> =
  ds.map(|d: Diagnostic| moved_diagnostic(d, m))

pub fn rejected_in(
  ds: InGroup<List<Diagnostic>>,
  source: List<ItemAt>,
  destination: List<ItemAt>,
) -> List<Diagnostic> / {abort.raise} = relocated(ds, source, destination, relocated_diagnostics)

pub fn tables_in(
  m: MemberResult,
  source: List<ItemAt>,
  destination: List<ItemAt>,
) -> ModuleTables / {abort.raise} =
  relocated(m.result, source, destination, |r: OwnerResult, to: Relocation|
    moved_tables(r.tables, to))

pub fn member_rows(m: MemberResult) -> Rows / {abort.raise} =
  position_free(m.result, |r: OwnerResult| r.rows)

pub fn member_facts(
  m: MemberResult,
) -> { facts: EmitFacts, cached: List<CachedFacts> } / {abort.raise} =
  position_free(m.result, |r: OwnerResult| { facts: r.tables.facts, cached: r.tables.cached })

pub fn is_rejected(ds: InGroup<List<Diagnostic>>) -> Bool / {abort.raise} =
  position_free(ds, |xs: List<Diagnostic>| xs.len() > 0)

pub fn member_laws(m: MemberResult) -> List<LawOutline> / {abort.raise} =
  position_free(m.result, |r: OwnerResult| r.laws)

pub type GroupFlags = { rejected: Bool, warned: Bool, later: Bool, uses: List<UseLink> }

derive bin for GroupFlags

pub fn group_flags(g: GroupResult) -> GroupFlags / {abort.raise} =
  g.members.fold(
    { rejected: is_rejected(g.rejected), warned: false, later: false, uses: [] },
    |found: GroupFlags, m: MemberResult|
      position_free(m.result, |r: OwnerResult|
        {
          rejected: found.rejected,
          warned: found.warned || r.warnings.len() > 0,
          later: found.later || r.tagged.len() + r.statements.len() > 0,
          uses: found.uses.concat(r.uses.map(link_of)),
        }),
  )

fn relocated_result(a: OwnerResult, m: Relocation) -> OwnerResult =
  {
    tables: moved_tables(a.tables, m),
    rows: a.rows,
    warnings: a.warnings.map(|d: Diagnostic| moved_diagnostic(d, m)),
    tagged: a.tagged.map(|x: TaggedSite| moved_tagged(x, m)),
    statements: a.statements.map(|x: StatementSite<Bytes>| { ..x, span: moved_at(x.span, m) }),
    consts: a.consts,
    sets: a.sets,
    laws: a.laws,
    uses: a.uses.map(|r: UseNode|
      {
        ..r,
        span: moved_at(r.span, m),
        unused: match r.unused { Some(d) -> Some(moved_diagnostic(d, m)), None -> None },
      }),
  }

pub type MemberResult = { owner: Bytes, result: InGroup<OwnerResult> }

derive bin for OwnerResult
derive bin for MemberResult
derive bin for GroupResult

pub type GroupResult = {
  members: List<MemberResult>,
  rejected: InGroup<List<Diagnostic>>,
  forms: HashInput,
  embeds: List<ModuleEmbed>,
  declared: StoredDeclarations,
}

pub const no_group: GroupResult =
  {
    members: [],
    rejected: InGroup([]),
    forms: { names: [], definitions: [], tests: [], laws: [] },
    embeds: [],
    declared: no_stored_declarations,
  }

pub fn listed_group(a: GroupResult) -> GroupResult / {abort.raise} =
  {
    ..a,
    forms: no_group.forms,
    declared: no_group.declared,
    members: a.members.map(|m: MemberResult|
      {
        owner: m.owner,
        result: within_group(m.result, |r: OwnerResult|
          {
            ..r,
            tables: { ..r.tables, facts: no_module_tables.facts, cached: [] },
            rows: no_rows,
          }),
      }),
  }

pub fn facts_of_group(a: GroupResult) -> GroupResult / {abort.raise} =
  {
    ..no_group,
    members: a.members.map(|m: MemberResult|
      {
        owner: m.owner,
        result: within_group(m.result, |r: OwnerResult|
          {
            ..no_owner_result,
            tables: { ..no_module_tables, facts: r.tables.facts, cached: r.tables.cached },
          }),
      }),
  }

pub fn joined_group(
  listing: GroupResult,
  facts: GroupResult,
  forms: HashInput,
  rows: List<Rows>,
) -> GroupResult / {abort.raise} =
  {
    ..listing,
    forms: forms,
    members: range(0, listing.members.len()).map(|i: Int| {
      let m = listing.members.get(i);
      let read = member_facts(facts.members.get(i));
      {
        owner: m.owner,
        result: within_group(m.result, |r: OwnerResult|
          {
            ..r,
            tables: { ..r.tables, facts: read.facts, cached: read.cached },
            rows: rows.get(i),
          }),
      }
    }),
  }

pub type EncodedGroup = { types: List<InternedType>, at: List<Int>, rest: GroupResult }

derive bin for EncodedGroup

fn definition_types(a: GroupResult) -> List<Type> / {abort.raise} =
  a.members.fold([], |accumulator: List<Type>, m: MemberResult|
    position_free(m.result, |r: OwnerResult|
      accumulator.concat(r.tables.definitions.map(|d: DefinitionInfo| d.scheme.ty)).concat(
        r.rows.definitions.map(|x: KnownDefinitionRow| x.scheme.ty),
      )))

fn with_definition_types(
  a: GroupResult,
  ty: (Int) -> Type / {abort.raise},
) -> GroupResult / {abort.raise} =
  {
    ..a,
    members: a.members.fold(
      { out: [], next: 0 },
      |accumulator: { out: List<MemberResult>, next: Int }, m: MemberResult| {
        let counts = position_free(m.result, |r: OwnerResult|
          { definitions: r.tables.definitions.len(), rows: r.rows.definitions.len() });
        let from = accumulator.next + counts.definitions;
        {
          out: accumulator.out.push({
            ..m,
            result: within_group(m.result, |r: OwnerResult|
              {
                ..r,
                tables: {
                  ..r.tables,
                  definitions: range(0, counts.definitions).map(|i: Int| {
                    let d = r.tables.definitions.get(i);
                    { ..d, scheme: { ..d.scheme, ty: ty(accumulator.next + i) } }
                  }),
                },
                rows: {
                  ..r.rows,
                  definitions: range(0, counts.rows).map(|i: Int| {
                    let x = r.rows.definitions.get(i);
                    { ..x, scheme: { ..x.scheme, ty: ty(from + i) } }
                  }),
                },
              }),
          }),
          next: from + counts.rows,
        }
      },
    ).out,
  }

pub fn encoded_group(a: GroupResult) -> EncodedGroup / {abort.raise} = {
  let h = intern_types(definition_types(a));
  { types: h.labels, at: h.at, rest: with_definition_types(a, |_: Int| unit_type) }
}

pub fn decode_group(k: EncodedGroup) -> GroupResult / {abort.raise} = {
  let types = types_of(k.types);
  with_definition_types(k.rest, |i: Int| types.get(k.at.get(i)))
}

pub fn item_ranges(
  items: List<ItemAt>,
  owner: Bytes,
  at: (ItemAt) -> Int / {abort.raise},
) -> List<ItemRange> / {abort.raise} =
  items.filter(|x: ItemAt| x.owner == owner).map(|x: ItemAt| { at: at(x), len: x.len, rel: x.from })

pub fn group_result(
  check: GroupCheck,
  module: Bytes,
  members: List<OwnerText>,
  items: List<ItemAt>,
  item_position: (ItemAt) -> Int / {abort.raise},
) -> GroupResult / {abort.raise} = {
  let spots = items.map(|x: ItemAt| { at: item_position(x), len: x.len, rel: x.from });
  let back = { from: 0, to: 0, by: |p: Int| group_offset(spots, p) };
  let placed = placement(items, item_position);
  let uses = List::group_by(check.resolved.uses, |r: UseNode|
    owner_placed(placed, r.module, r.span));
  let resolved = {
    members: members.map(|o: OwnerText|
      {
        owner: o.owner,
        result: InGroup({
          ..no_owner_result,
          uses: relocated_uses(share_in(uses, o.owner), item_ranges(items, o.owner, item_position)),
        }),
      }),
    rejected: InGroup(
      check.diagnostics.map(|d: Diagnostic| moved_diagnostic(in_own_slot(d, 0, spots), back)),
    ),
    forms: no_group.forms,
    embeds: embeds_wanted(check.resolved.embeds, module, members),
    declared: check.declared,
  };
  match check.checked {
    None -> resolved,
    Some(w) ->
      {
        ..resolved,
        members: checked_members(
          module_check_of(w),
          module,
          resolved.members,
          members,
          items,
          item_position,
          placed,
        ),
        forms: checked_forms(w, module, members),
      },
  }
}

fn embeds_wanted(
  embeds: List<ModuleEmbed>,
  module: Bytes,
  members: List<OwnerText>,
) -> List<ModuleEmbed> / {abort.raise} = {
  let text = Bytes::join(
    members.fold([], |accumulator: List<Bytes>, o: OwnerText| accumulator.concat(o.texts)),
    b"\n\n",
  );
  let wanted = if !may_call_embed(text) { Set::empty() } else {
    embed_requests(parse(text).node).fold(
      Set::empty(),
      |accumulator: Set<Bytes>, want: EmbedRequest| accumulator.insert(embed_key(want)),
    )
  };
  embeds.filter(|x: ModuleEmbed| x.module == module && wanted.contains(x.key))
}

fn relocated_uses(uses: List<UseNode>, spots: List<ItemRange>) -> List<UseNode> = {
  let back = { from: 0, to: 0, by: |p: Int| group_offset(spots, p) };
  uses.map(|r: UseNode|
    {
      ..r,
      module: 0,
      span: moved_at(r.span, back),
      unused: match r.unused {
        Some(d) -> Some(moved_diagnostic(in_own_slot(d, 0, spots), back)),
        None -> None,
      },
    })
}

type Placement = Map<Int, { end: Int, owner: Bytes }>

fn placement(
  items: List<ItemAt>,
  item_position: (ItemAt) -> Int / {abort.raise},
) -> Placement / {abort.raise} =
  items.fold(Map::new(), |accumulator: Placement, x: ItemAt| {
    let p = item_position(x);
    accumulator.insert(p, { end: p + x.len, owner: x.owner })
  })

fn owner_placed(placed: Placement, module: Int, s: Span) -> Bytes =
  if module != 0 { b"" } else {
    match placed.floor(s.start) {
      Some(f) -> if s.end <= f.value.end { f.value.owner } else { b"" },
      None -> b"",
    }
  }

pub type Clauses = { name: Bytes, spec: List<SpecInfo> }

type Inference = {
  facts: EmitFacts,
  cached: List<CachedFacts>,
  clauses: List<Clauses>,
  recorded: List<CachedFacts>,
  types: TypeTable,
  bodies: List<CheckedBody>,
  rejected: List<Diagnostic>,
}

pub type InferenceResult = { inferred: InGroup<Inference> }

derive bin for Clauses
derive bin for Inference
derive bin for InferenceResult

const no_inference: Inference = inference_from(no_owner_result, [])

pub const no_inference_result: InferenceResult = { inferred: InGroup(no_inference) }

pub fn inference_rejected(t: InferenceResult) -> Bool / {abort.raise} =
  position_free(t.inferred, |x: Inference| x.rejected.len() > 0)

fn inference_from(result: OwnerResult, bodies: List<CheckedBody>) -> Inference =
  {
    facts: result.tables.facts,
    cached: result.tables.cached,
    clauses: result.tables.definitions.map(|d: DefinitionInfo| { name: d.name, spec: d.spec }),
    recorded: result.rows.definitions.map(|r: KnownDefinitionRow| { name: r.name, facts: r.facts }),
    types: result.rows.types,
    bodies: bodies,
    rejected: [],
  }

pub fn inference_result(
  check: GroupCheck,
  module: Bytes,
  member: OwnerText,
  items: List<ItemAt>,
  at: (ItemAt) -> Int / {abort.raise},
) -> InferenceResult / {abort.raise} = {
  let cut = group_result(check, module, [member], items, at);
  {
    inferred: match check.checked {
      None -> within_group(cut.rejected, |ds: List<Diagnostic>| { ..no_inference, rejected: ds }),
      Some(w) -> {
        let spots = item_ranges(items, member.owner, at);
        within_group(cut.members.get(0).result, |r: OwnerResult|
          inference_from(
            r,
            w.bodies.map(|b: CheckedBody| relocated_body(b, 0, |p: Int| group_offset(spots, p))),
          ))
      },
    },
  }
}

const no_owner_result: OwnerResult =
  {
    tables: no_module_tables,
    rows: no_rows,
    warnings: [],
    tagged: [],
    statements: [],
    consts: [],
    sets: [],
    laws: [],
    uses: [],
  }

pub fn called_names(module: Bytes, typed: InferenceResult) -> List<Bytes> / {abort.raise} = {
  let prefix = module.concat(b".");
  position_free(typed.inferred, |x: Inference| x.bodies).fold(
    [],
    |accumulator: List<Bytes>, b: CheckedBody|
      b.refs.concat(b.calls.concat(b.stated).map(|c: OwnCall| c.callee)).fold(
        accumulator,
        |a: List<Bytes>, n: Bytes|
          if !n.starts_with(prefix) { a } else {
            let simple = n.slice(prefix.len(), n.len());
            if a.contains(simple) { a } else { a.push(simple) }
          },
      ),
  )
}

pub type SignatureCheck = { rejected: InGroup<List<Diagnostic>>, declared: StoredDeclarations }

derive bin for SignatureCheck

pub fn signature_check_of(result: GroupResult) -> SignatureCheck =
  { rejected: result.rejected, declared: result.declared }

pub fn inference_errors(
  members: List<OwnerInference>,
  items: List<ItemAt>,
  offset: Int,
) -> List<Diagnostic> / {abort.raise} =
  members.fold([], |accumulator: List<Diagnostic>, w: OwnerInference|
    accumulator.concat(
      relocated(
        w.typed.inferred,
        w.layout,
        laid_out(items, offset),
        |x: Inference, to: Relocation| relocated_diagnostics(x.rejected, to),
      ),
    ))

pub type OwnerInference = { owner: Bytes, typed: InferenceResult, layout: List<ItemAt> }

pub fn supplied_bodies(
  members: List<OwnerInference>,
  items: List<ItemAt>,
  offset: Int,
) -> (Int) -> BodyPlan / {abort.raise} =
  |slot: Int| {
    let combined = members.fold(
      { bodies: Map::new(), sites: [] },
      |accumulator: { bodies: Map<Bytes, ReusedBody>, sites: List<MemberSite> }, m: OwnerInference|
        relocated(
          m.typed.inferred,
          m.layout,
          laid_out(items, offset),
          |x: Inference, placed: Relocation| {
            let recorded = x.recorded.fold(
              Map::new(),
              |recorded_facts: Map<Bytes, BodyRecord>, k: CachedFacts|
                recorded_facts.insert(k.name, k.facts),
            );
            {
              bodies: x.bodies.fold(
                accumulator.bodies,
                |reused_bodies: Map<Bytes, ReusedBody>, b: CheckedBody|
                  reused_bodies.insert(b.name, {
                    body: relocated_body(b, slot, placed.by),
                    facts: match recorded.get(b.name) { Some(f) -> f, None -> CheckedElsewhere },
                  }),
              ),
              sites: accumulator.sites.concat(
                x.facts.members.map(|site: MemberSite| { ..site, module: slot }),
              ),
            }
          },
        ),
    );
    ReuseBodies(combined.bodies, combined.sites)
  }

pub fn finalized_result(
  resolved: GroupResult,
  members: List<OwnerInference>,
  items: List<ItemAt>,
) -> GroupResult / {abort.raise} =
  {
    ..resolved,
    members: resolved.members.map(|m: MemberResult|
      match members.find(|w: OwnerInference| w.owner == m.owner) {
        None -> m,
        Some(w) -> {
          let typed = relocated(
            w.typed.inferred,
            w.layout,
            laid_out(items, 0),
            |x: Inference, to: Relocation|
              {
                clauses: x.clauses.fold(
                  Map::new(),
                  |accumulator: Map<Bytes, List<SpecInfo>>, c: Clauses|
                    accumulator.insert(
                      c.name,
                      c.spec.map(|spec: SpecInfo| { ..spec, span: moved_at(spec.span, to) }),
                    ),
                ),
                facts: remap_fact_modules(x.facts, |i: Int| moved_index(i, to)),
                cached: x.cached,
                types: x.types,
              },
          );
          {
            ..m,
            result: within_group(m.result, |r: OwnerResult|
              {
                ..r,
                tables: {
                  ..r.tables,
                  definitions: r.tables.definitions.map(|d: DefinitionInfo|
                    {
                      ..d,
                      spec: match typed.clauses.get(d.name) { Some(spec) -> spec, None -> d.spec },
                    }),
                  facts: { ..typed.facts, pure: r.tables.facts.pure },
                  cached: typed.cached,
                },
                rows: { ..r.rows, types: types_joined(r.rows.types, typed.types) },
              }),
          }
        },
      }),
  }

pub type ModuleCheck = { analysis: GroupAnalysis, facts: ModuleFacts, rows: Rows }

pub fn module_check_of(w: GroupAnalysis) -> ModuleCheck / {abort.raise} =
  { analysis: w, facts: module_facts(w, 0), rows: group_rows(w.checked) }

fn checked_members(
  module_check: ModuleCheck,
  module: Bytes,
  resolved: List<MemberResult>,
  members: List<OwnerText>,
  items: List<ItemAt>,
  item_position: (ItemAt) -> Int / {abort.raise},
  placed: Placement,
) -> List<MemberResult> / {abort.raise} = {
  let w = module_check.analysis;
  let t = module_check.facts.tables;
  let shape = module_check.facts.shape;
  let declared = members.fold(Map::new(), |accumulator: Map<Bytes, List<Bytes>>, o: OwnerText|
    o.names.push(o.owner).fold(accumulator, |a: Map<Bytes, List<Bytes>>, n: Bytes|
      a.insert(n, share_in(a, n).push_unique(o.owner))));
  let whose = |name: Bytes| share_in(declared, name);
  let shared_by = |xs: List<EffectSetRow>, names_of: (EffectSetRow) -> List<Bytes>|
    xs.fold(Map::new(), |accumulator: Map<Bytes, List<EffectSetRow>>, x: EffectSetRow|
      names_of(x).fold(accumulator, |a: Map<Bytes, List<EffectSetRow>>, o: Bytes|
        a.insert(o, share_in(a, o).push(x))));
  let at = |m: Int, s: Span| owner_placed(placed, m, s);
  let definitions = List::group_by(t.definitions, |d: DefinitionInfo| at(d.at.module, d.at.span));
  let definition_owner = definitions.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, o: Bytes, ds: List<DefinitionInfo>|
      ds.fold(accumulator, |a: Map<Bytes, Bytes>, d: DefinitionInfo| a.insert(d.name, o)),
  );
  let definition_named = |name: Bytes|
    match definition_owner.get(name) { Some(o) -> o, None -> b"" };
  let tests = List::group_by(t.tests, |x: TestInfo| at(x.at.module, x.at.span));
  let test_owned = tests.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, o: Bytes, ts: List<TestInfo>|
      ts.fold(accumulator, |a: Map<Bytes, Bytes>, x: TestInfo|
        a.insert(test_owner(x.module, x.name), o)),
  );
  let laws = List::group_by(t.laws, |l: LawInfo| at(l.at.module, l.at.span));
  let law_owned = laws.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, o: Bytes, ls: List<LawInfo>|
      ls.fold(accumulator, |a: Map<Bytes, Bytes>, l: LawInfo|
        a.insert(law_owner(l.module, l.name), o)),
  );
  let owner_of_cached = |name: Bytes|
    match test_owned.get(name) {
      Some(o) -> o,
      None -> match law_owned.get(name) { Some(o) -> o, None -> definition_named(name) },
    };
  let effects = List::group_by(t.effects, |x: EffectInfo| at(x.at.module, x.at.span));
  let constructors = List::group_by(t.constructors, |c: ConstructorInfo|
    at(c.at.module, c.at.span));
  let instances = List::group_by(t.instances, |x: InstanceInfo| at(x.at.module, x.at.span));
  let numeric = List::group_by(t.numeric, |x: NumericInfo| at(x.at.module, x.at.span));
  let pure = List::group_by(t.facts.pure, definition_named);
  let owned = |m: Int, owner: Bytes| if m != 0 { b"" } else { owner_of_cached(owner) };
  let bodies = List::group_by(t.facts.bodies, |x: TypedBody<Bytes>| owned(x.module, x.owner));
  let orders = List::group_by(t.facts.orders, |x: WitnessOrder|
    definition_named(Bytes::concat_all([module, b".", x.name])));
  let member_sites = List::group_by(t.facts.members, |x: MemberSite| owned(x.module, x.owner));
  let cached = List::group_by(t.cached, |k: CachedFacts| owner_of_cached(k.name));
  let rows = List::group_by(module_check.rows.definitions, |r: KnownDefinitionRow|
    definition_named(r.name));
  let warnings = w.warnings.filter(|d: Diagnostic| d.code != never_used_code).fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Diagnostic>>, d: Diagnostic|
      d.labels.fold([], |os: List<Bytes>, l: Label|
        match if l.primary { source_span(l) } else { None } {
          None -> os,
          Some(s) -> {
            let o = at(s.module, span_between(s.start, s.end));
            if o.len() == 0 || os.contains(o) { os } else { os.push(o) }
          },
        }).fold(accumulator, |a: Map<Bytes, List<Diagnostic>>, o: Bytes|
        a.insert(o, List::push(match a.get(o) { Some(ds) -> ds, None -> [] }, d))),
  );
  let tagged = List::group_by(shape.tagged, |x: TaggedSite| at(x.module, x.span));
  let statements = List::group_by(shape.statements, |x: StatementSite<Bytes>| at(x.module, x.span));
  let consts = List::group_by(shape.consts, |x: TypedConst| definition_named(x.name));
  let sets = shared_by(shape.outline.sets, |x: EffectSetRow| whose(x.name));
  let outlined = shape.outline.items.fold(
    Map::new(),
    |accumulator: Map<Bytes, List<LawOutline>>, x: OutlineItem|
      match x {
        OutlinedLaw(l) ->
          whose(b"law ".concat(l.name)).fold(
            accumulator,
            |a: Map<Bytes, List<LawOutline>>, o: Bytes| a.insert(o, share_in(a, o).push(l)),
          ),
        _ -> accumulator,
      },
  );
  resolved.map(|m: MemberResult| {
    let o = m.owner;
    {
      owner: o,
      result: within_group(m.result, |r: OwnerResult|
        owner_result(
          module_check,
          {
            definitions: share_in(definitions, o),
            tests: share_in(tests, o),
            laws: share_in(laws, o),
            effects: share_in(effects, o),
            constructors: share_in(constructors, o),
            instances: share_in(instances, o),
            numeric: share_in(numeric, o),
            facts: {
              pure: share_in(pure, o),
              orders: share_in(orders, o),
              members: share_in(member_sites, o),
              types: types_named(t.facts.types, share_in(bodies, o)),
              bodies: share_in(bodies, o),
            },
            cached: share_in(cached, o),
            rows: share_in(rows, o),
            warnings: share_in(warnings, o),
            tagged: share_in(tagged, o),
            statements: share_in(statements, o),
            consts: share_in(consts, o),
            sets: share_in(sets, o),
            law_outlines: share_in(outlined, o),
          },
          r.uses,
          item_ranges(items, o, item_position),
        )),
    }
  })
}

fn checked_forms(
  w: GroupAnalysis,
  module: Bytes,
  members: List<OwnerText>,
) -> HashInput / {abort.raise} = {
  let prefix = module.concat(b".");
  let chosen = { ..module_selection(w.index, 0), called: Some(called_at(w.checked.facts.members)) };
  let set = |pick: (OwnerText) -> List<Bytes> / {abort.raise}|
    members.fold(Set::empty(), |accumulator: Set<Bytes>, o: OwnerText|
      pick(o).fold(accumulator, |a: Set<Bytes>, n: Bytes| a.insert(n)));
  let labelled = |kind: Bytes, o: OwnerText|
    if o.owner.starts_with(kind) { [o.owner.slice(kind.len(), o.owner.len())] } else { [] };
  let among = |m: Set<Bytes>|
    |name: Bytes| name.starts_with(prefix) && m.contains(name.slice(prefix.len(), name.len()));
  let node_wanted = among(set(|o: OwnerText| o.names));
  let test_wanted = among(set(|o: OwnerText| labelled(b"test ", o)));
  let law_wanted = among(set(|o: OwnerText| labelled(b"law ", o)));
  selection_forms(w.index, {
    own: chosen.own.filter(|v: Int| node_wanted(w.index.nodes.get(v).name)),
    tests: chosen.tests.filter(|x: TestNode| test_wanted(x.key)),
    laws: chosen.laws.filter(|x: LawNode| law_wanted(x.key)),
    called: chosen.called,
  })
}

fn share_in<a>(m: Map<Bytes, List<a>>, o: Bytes) -> List<a> =
  match m.get(o) { Some(xs) -> xs, None -> [] }

pub fn diagnostic_summaries(ds: List<Diagnostic>) -> List<Bytes> =
  ds.map(|d: Diagnostic| Bytes::concat_all([d.code, b": ", d.message])).sort_by(
    |a: Bytes, b: Bytes| match compare_values(a, b) { Greater -> false, _ -> true },
  )

pub fn offset_indexes(a: OwnerResult, tests: Int, laws: Int) -> OwnerResult =
  {
    ..a,
    tables: {
      ..a.tables,
      tests: a.tables.tests.map(|x: TestInfo| { ..x, index: x.index + tests }),
      laws: a.tables.laws.map(|x: LawInfo| { ..x, index: x.index + laws }),
    },
  }

pub type AssembledModule = {
  facts: ModuleFacts,
  rows: Rows,
  warnings: List<Diagnostic>,
  rejected: List<Diagnostic>,
  definitions: Int,
  tests: Int,
}

pub type PositionedGroup = { items: List<ItemAt>, result: GroupResult }

fn ranked<a>(xs: List<a>, rank: (a) -> Int / {abort.raise}) -> List<a> / {abort.raise} =
  range(0, xs.len()).map(|i: Int| { rank: rank(xs.get(i)), at: i }).sort_by(
    |a: { rank: Int, at: Int }, b: { rank: Int, at: Int }|
      a.rank < b.rank || (a.rank == b.rank && a.at <= b.at),
  ).map(|x: { rank: Int, at: Int }| xs.get(x.at))

fn gathered<a>(owners: List<OwnerResult>, pick: (OwnerResult) -> List<a>) -> List<a> =
  owners.fold([], |accumulator: List<a>, a: OwnerResult| accumulator.concat(pick(a)))

fn diagnostic_start(d: Diagnostic) -> Int =
  d.labels.fold(0 - 1, |accumulator: Int, l: Label|
    match if accumulator < 0 && l.primary { source_span(l) } else { None } {
      Some(s) -> s.start,
      None -> accumulator,
    })

pub fn assembled(
  module: Bytes,
  shape: ModuleShape,
  order: List<Bytes>,
  recorded: List<Bytes>,
  groups: List<PositionedGroup>,
  unused: Bool,
) -> AssembledModule / {abort.raise} = {
  let at = |names: List<Bytes>|
    range(0, names.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
      accumulator.insert(names.get(i), i));
  let place = at(order);
  let walked = |name: Bytes| match place.get(name) { Some(k) -> k, None -> order.len() };
  let walk = at(recorded);
  let placed = ranked(
    groups.fold(
      [],
      |accumulator: List<{ first: Int, member: MemberResult, result: OwnerResult }>, g: PositionedGroup| {
        g.result.members.fold(
          accumulator,
          |a: List<{ first: Int, member: MemberResult, result: OwnerResult }>, m: MemberResult|
            a.push({
              first: g.items.fold(0 - 1, |f: Int, x: ItemAt|
                if x.owner == m.owner && (f < 0 || x.to < f) { x.to } else { f }),
              member: m,
              result: relocated(m.result, g.items, g.items, relocated_result),
            }),
        )
      },
    ),
    |x: { first: Int, member: MemberResult, result: OwnerResult }| x.first,
  );
  let numbered_all = placed.fold(
    { tests: 0, laws: 0, out: [] },
    |accumulator: { tests: Int, laws: Int, out: List<OwnerResult> }, x: { first: Int, member: MemberResult, result: OwnerResult }| {
      let a = offset_indexes(x.result, accumulator.tests, accumulator.laws);
      {
        tests: accumulator.tests + a.tables.tests.len(),
        laws: accumulator.laws + a.tables.laws.len(),
        out: accumulator.out.push(a),
      }
    },
  );
  let owners = numbered_all.out;
  let test_at = shape.outline.items.fold(
    { next: 0, at: Map::new() },
    |accumulator: { next: Int, at: Map<Bytes, Int> }, x: OutlineItem|
      match x {
        OutlinedTest(t) ->
          {
            next: accumulator.next + 1,
            at: accumulator.at.insert(test_owner(module, t.name), accumulator.next),
          },
        _ -> accumulator,
      },
  ).at;
  let law_at = shape.outline.items.fold(
    { next: 0, at: Map::new() },
    |accumulator: { next: Int, at: Map<Bytes, Int> }, x: OutlineItem|
      match x {
        OutlinedLaw(l) ->
          { next: accumulator.next + 1, at: accumulator.at.insert(l.name, accumulator.next) },
        _ -> accumulator,
      },
  ).at;
  let outlined_at = |x: LawInfo| match law_at.get(x.name) { Some(k) -> k, None -> x.index };
  let law_rank = gathered(owners, |a: OwnerResult| a.tables.laws).fold(
    Map::new(),
    |accumulator: Map<Bytes, Int>, x: LawInfo|
      accumulator.insert(law_owner(x.module, x.name), outlined_at(x)),
  );
  let site_rank = |owner: Bytes|
    match walk.get(owner) {
      Some(k) -> k,
      None -> match test_at.get(owner) {
        Some(k) -> 2000000000 + k,
        None -> 3000000000 + (match law_rank.get(owner) { Some(k) -> k, None -> 999999999 }),
      },
    };
  let tables = {
    definitions: ranked(
      gathered(owners, |a: OwnerResult| a.tables.definitions),
      |d: DefinitionInfo| walked(d.name),
    ),
    tests: gathered(owners, |a: OwnerResult| a.tables.tests),
    laws: ranked(gathered(owners, |a: OwnerResult| a.tables.laws), outlined_at).map(|x: LawInfo|
      { ..x, index: outlined_at(x) }),
    effects: ranked(gathered(owners, |a: OwnerResult| a.tables.effects), |x: EffectInfo|
      x.at.span.start),
    constructors: ranked(
      gathered(owners, |a: OwnerResult| a.tables.constructors),
      |x: ConstructorInfo| x.at.span.start,
    ),
    instances: ranked(gathered(owners, |a: OwnerResult| a.tables.instances), |x: InstanceInfo|
      x.at.span.start),
    numeric: ranked(gathered(owners, |a: OwnerResult| a.tables.numeric), |x: NumericInfo|
      x.at.span.start),
    facts: {
      pure: ranked(gathered(owners, |a: OwnerResult| a.tables.facts.pure), walked),
      orders: ranked(gathered(owners, |a: OwnerResult| a.tables.facts.orders), |x: WitnessOrder|
        walked(Bytes::concat_all([module, b".", x.name]))),
      members: ranked(gathered(owners, |a: OwnerResult| a.tables.facts.members), |x: MemberSite|
        site_rank(x.owner)),
      types: owners.fold(Map::new(), |accumulator: TypeTable, a: OwnerResult|
        types_joined(accumulator, a.tables.facts.types)),
      bodies: ranked(
        gathered(owners, |a: OwnerResult| a.tables.facts.bodies),
        |x: TypedBody<Bytes>| site_rank(x.owner),
      ),
    },
    cached: ranked(gathered(owners, |a: OwnerResult| a.tables.cached), |k: CachedFacts|
      site_rank(k.name)),
  };
  let laws = owners.fold(Map::new(), |accumulator: Map<Bytes, LawOutline>, a: OwnerResult|
    a.laws.fold(accumulator, |m: Map<Bytes, LawOutline>, l: LawOutline| m.insert(l.name, l)));
  let outline = shape.outline;
  {
    facts: {
      shape: {
        ..shape,
        outline: {
          ..outline,
          items: outline.items.map(|x: OutlineItem|
            match x {
              OutlinedLaw(l) -> match laws.get(l.name) { Some(k) -> OutlinedLaw(k), None -> x },
              _ -> x,
            }),
          sets: gathered(owners, |a: OwnerResult| a.sets),
        },
        embeds: groups.fold(
          Map::new(),
          |accumulator: Map<Bytes, ModuleEmbed>, g: PositionedGroup|
            g.result.embeds.fold(accumulator, |m: Map<Bytes, ModuleEmbed>, e: ModuleEmbed|
              m.insert(e.key, e)),
        ).values(
        ).sort_by(|a: ModuleEmbed, b: ModuleEmbed|
          match compare_values(a.key, b.key) { Greater -> false, _ -> true }),
        tagged: ranked(gathered(owners, |a: OwnerResult| a.tagged), |x: TaggedSite| x.span.start),
        statements: ranked(
          gathered(owners, |a: OwnerResult| a.statements),
          |x: StatementSite<Bytes>| x.span.start,
        ),
        consts: ranked(gathered(owners, |a: OwnerResult| a.consts), |x: TypedConst| walked(x.name)),
      },
      tables: tables,
    },
    rows: {
      definitions: ranked(
        gathered(owners, |a: OwnerResult| a.rows.definitions),
        |r: KnownDefinitionRow| walked(r.name),
      ),
      tests: gathered(owners, |a: OwnerResult| a.rows.tests),
      laws: gathered(owners, |a: OwnerResult| a.rows.laws),
      types: owners.fold(Map::new(), |accumulator: TypeTable, a: OwnerResult|
        types_joined(accumulator, a.rows.types)),
    },
    warnings: ranked(
      gathered(owners, |a: OwnerResult| a.warnings).concat(if unused {
        unreached(gathered(owners, |a: OwnerResult| a.uses))
      } else { [] }),
      diagnostic_start,
    ),
    rejected: ranked(
      groups.fold([], |accumulator: List<Diagnostic>, g: PositionedGroup|
        accumulator.concat(rejected_in(g.result.rejected, g.items, g.items))).unique(
      ),
      diagnostic_start,
    ),
    definitions: tables.definitions.len(),
    tests: tables.tests.len(),
  }
}

test "a position in a stored group result moves to the place of the member item that holds it" {
  let stored = [
    { owner: b"even", from: 0, to: 0, len: 10 },
    { owner: b"odd", from: 12, to: 0, len: 8 },
    { owner: b"even", from: 22, to: 0, len: 5 },
  ];
  let placed = [
    { owner: b"odd", from: 0, to: 100, len: 8 },
    { owner: b"even", from: 0, to: 300, len: 10 },
    { owner: b"even", from: 0, to: 400, len: 5 },
  ];
  let m = item_relocation(stored, placed);
  assert_eq([(m.by)(3), (m.by)(15), (m.by)(24)], [303, 103, 402])
}
