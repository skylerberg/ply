pub type Mention = { module: Bytes, name: Bytes }

pub fn any_module_name(name: Bytes) -> Bytes = b"::".concat(name)

pub fn called_of(modules: List<Bytes>, names: List<Bytes>) -> List<Mention> =
  modules.fold([], |accumulator: List<Mention>, m: Bytes|
    names.fold(accumulator, |a: List<Mention>, n: Bytes|
      a.push({ module: m, name: any_module_name(n) })))

pub type OwnerInterface = {
  transitive_digest: Bytes,
  owner: Bytes,
  mentions: List<Mention>,
  text: Bytes,
  imports: List<ImportDeclaration>,
  rows: List<KnownDefinitionRow>,
  fixed: List<CachedNode>,
  derived: List<Derivation>,
}

pub type InterfaceHeader = { transitive_digest: Bytes, owner: Bytes, mentions: List<Mention> }

derive bin for InterfaceHeader

pub fn interface_header(b: Bytes) -> InterfaceHeader / {abort.raise} =
  match interface_header_bin().take(b, 0) {
    Ok(t) -> t.value,
    Err(_) -> panic("the stored interface entry has no header"),
  }

pub fn with_reach_digest(b: Bytes, reach: Bytes) -> Bytes / {abort.raise} =
  match bin::take_bytes(b, 0) {
    Ok(t) -> bin::encode(reach, bin::bytes_bin()).concat(b.slice(t.at, b.len())),
    Err(_) -> panic("the stored interface entry has no header"),
  }

pub fn interface_header_of(e: OwnerInterface) -> InterfaceHeader =
  { transitive_digest: e.transitive_digest, owner: e.owner, mentions: e.mentions }

pub type Exports = {
  module: Bytes,
  owners: Map<Bytes, List<Bytes>>,
  entries: Map<Bytes, OwnerInterface>,
}

pub type HashEntry = { owner: Bytes, cached_nodes: List<CachedNode>, mentions: List<Mention> }

pub type Hashes = { module: Bytes, entries: Map<Bytes, HashEntry> }

derive bin for Mention
derive bin for OwnerInterface
derive bin for Exports
derive bin for HashEntry
derive bin for Hashes
derive bin for Scope
derive bin for ModuleScope
derive bin for OwnerText
derive bin for ItemAt

fn undocumented_variant(v: VariantDefinition) -> VariantDefinition = { ..v, doc: None }

fn undocumented_operation(o: OperationDefinition) -> OperationDefinition = { ..o, doc: None }

fn interface_item(item: Item) -> Item =
  match item {
    FunctionItem(d) ->
      FunctionItem({
        ..d,
        doc: None,
        body: if d.transparent != None { d.body }
        else { BlockExpression({ span: expression_span(d.body), tail: None, statements: [] }) },
      }),
    TypeItem(d) ->
      TypeItem({
        ..d,
        doc: None,
        field_docs: [],
        body: match d.body { SumBody(vs) -> SumBody(vs.map(undocumented_variant)), other -> other },
      }),
    EffectItem(d) ->
      EffectItem({ ..d, doc: None, operations: d.operations.map(undocumented_operation) }),
    SchemaItem(d) -> SchemaItem({ ..d, doc: None }),
    EffectSetItem(d) -> EffectSetItem({ ..d, doc: None }),
    ExternItem(d) -> ExternItem({ ..d, doc: None }),
    other -> other,
  }

fn binder_of(d: ImportDeclaration) -> Option<Bytes> =
  match d.kind {
    WholeModule -> match d.path.at(d.path.len() - 1) { Some(i) -> Some(i.name), None -> None },
    ModuleAlias(a) -> Some(a.name),
    SelectedNames(_) -> None,
  }

pub type Scope = {
  module: Bytes,
  binders: Map<Bytes, Bytes>,
  selected: Map<Bytes, List<Bytes>>,
  owners: Map<Bytes, List<Bytes>>,
}

fn scope_of(
  module: Bytes,
  imports: List<ImportDeclaration>,
  targets: List<Bytes>,
  owners: Map<Bytes, List<Bytes>>,
) -> Scope / {abort.raise} =
  range(0, min(imports.len(), targets.len())).fold(
    { module: module, binders: Map::new(), selected: Map::new(), owners: owners },
    |s: Scope, i: Int| {
      let d = imports.get(i);
      let target = targets.get(i);
      match d.kind {
        SelectedNames(ns) ->
          {
            ..s,
            selected: ns.fold(s.selected, |accumulator: Map<Bytes, List<Bytes>>, n: Identifier|
              listed_under(accumulator, n.name, target)),
          },
        _ -> match binder_of(d) {
          Some(b) ->
            {
              ..s,
              binders: s.binders.insert(b, target),
              selected: implicitly_imported_by(b).fold(
                s.selected,
                |accumulator: Map<Bytes, List<Bytes>>, n: Bytes|
                  if s.owners.contains(n) || accumulator.contains(n) { accumulator }
                  else { listed_under(accumulator, n, target) },
              ),
            },
          None -> s,
        },
      }
    },
  )

pub fn mention_key(m: Mention) -> Bytes = Bytes::concat_all([m.module, b"\x00", m.name])

fn distinct(ms: List<Mention>) -> List<Mention> =
  ms.fold(Map::new(), |accumulator: Map<Bytes, Mention>, m: Mention|
    accumulator.insert(mention_key(m), m)).fold(
    [],
    |accumulator: List<Mention>, _: Bytes, m: Mention| accumulator.push(m),
  )

fn identifier_at(tokens: List<Token>, i: Int) -> Option<Bytes> =
  if i < 0 { None } else {
    match tokens.at(i) {
      Some(t) -> match t.kind { Identifier(n) -> Some(n), _ -> None },
      None -> None,
    }
  }

fn punct_at(tokens: List<Token>, i: Int, p: Bytes) -> Bool =
  if i < 0 { false }
  else { match tokens.at(i) { Some(t) -> t.kind == Punctuation(p), None -> false } }

fn tags(tokens: List<Token>, i: Int) -> Bool =
  match ((tokens.at(i), tokens.at(i + 1))) {
    (Some(name), Some(next)) ->
      name.end == next.start
        && (match next.kind {
          StringLiteral(_) -> true,
          InterpolatedHead(_) -> true,
          LineString(_) -> true,
          _ -> false,
        }),
    _ -> false,
  }

fn called_on_value(tokens: List<Token>, bound: Map<Bytes, Bool>, i: Int) -> Bool / {abort.raise} = {
  let after = iterate(i + 1, tokens.len() + 1, |j: Int|
    if punct_at(tokens, j, b"rparen") { Continue(j + 1) } else { Stop(j) });
  (punct_at(tokens, after, b"lparen") || punct_at(tokens, after, b"lbracket"))
    && (after > i + 1
    || (match identifier_at(tokens, i - 2) {
      None -> true,
      Some(base) ->
        punct_at(tokens, i - 3, b"dot")
          || (!punct_at(tokens, i - 3, b"coloncolon") && bound.contains(base)),
    }))
}

fn on_value(scope: Scope, name: Bytes) -> List<Mention> =
  [{ module: b"", name: name }].concat(if scope.owners.contains(any_module_name(name)) {
    [{ module: scope.module, name: any_module_name(name) }]
  } else { [] })

fn of_type(scope: Scope, of: Bytes, name: Bytes) -> List<Mention> = {
  let selected = match scope.selected.get(of) { Some(ms) -> ms, None -> [] };
  let homes = List::concat(if scope.owners.contains(of) { [scope.module] } else { [] }, selected);
  let declared = homes.fold([], |accumulator: List<Mention>, m: Bytes|
    accumulator.push({ module: m, name: of }).push({ module: m, name: member_name(of, name) }));
  if selected.len() == 0 && starts_upper(of) { declared.concat(on_value(scope, name)) }
  else { declared }
}

fn binder_mentions(scope: Scope, binder: Bytes, name: Bytes) -> List<Mention> =
  match scope.binders.get(binder) {
    Some(m) -> [{ module: m, name: name }],
    None -> of_type(scope, binder, name),
  }

fn mentioned(scope: Scope, text: Bytes) -> List<Mention> / {abort.raise} =
  mentioned_in(scope, lex(text).tokens)

fn mentioned_in(scope: Scope, tokens: List<Token>) -> List<Mention> / {abort.raise} = {
  let bound = bound_names(tokens);
  range(0, tokens.len()).fold([], |was: List<Mention>, i: Int| {
    let accumulator = was.concat(written_mentions(scope.module, tokens, i));
    match identifier_at(tokens, i) {
      None -> if punct_at(tokens, i, b"hashbrace") {
        accumulator.concat(
          binder_mentions(scope, map_literal_call().binder, map_literal_call().name),
        )
      } else { accumulator },
      Some(n) -> if punct_at(tokens, i - 1, b"coloncolon") {
        match identifier_at(tokens, i - 2) {
          Some(b) -> accumulator.concat(binder_mentions(scope, b, n)),
          None -> accumulator,
        }
      } else if punct_at(tokens, i - 1, b"dot") {
        if !called_on_value(tokens, bound, i) { accumulator }
        else { accumulator.concat(on_value(scope, n)) }
      } else if punct_at(tokens, i + 1, b"coloncolon") { accumulator } else if tags(tokens, i) {
        match scope.binders.get(n) {
          Some(m) ->
            accumulator.concat(
              [b"literal", b"compile", b"fill"].map(|f: Bytes| { module: m, name: f }),
            ),
          None -> accumulator,
        }
      } else {
        let own = if scope.owners.contains(n) {
          accumulator.push({ module: scope.module, name: n })
        } else { accumulator };
        match scope.selected.get(n) {
          Some(ms) -> own.concat(ms.map(|m: Bytes| { module: m, name: n })),
          None -> own,
        }
      },
    }
  })
}

fn written_mentions(module: Bytes, tokens: List<Token>, i: Int) -> List<Mention> = {
  let called = match tokens.at(i) {
    Some(t) -> match t.kind {
      Punctuation(p) -> if emitted_code().tokens.contains(p) { emitted_code().calls }
      else if opens_own_types(tokens, i) { marshalling_calls(module) }
      else { [] },
      Identifier(n) -> emitted_calls_for(n).concat(marshalling_calls_for(module, n)),
      _ -> [],
    },
    None -> [],
  };
  called.map(|n: Bytes| { module: prelude_module(), name: n })
}

fn opens_own_types(tokens: List<Token>, i: Int) -> Bool = {
  let moded = |j: Int|
    match identifier_at(tokens, j) {
      Some(m) -> m == b"read" || m == b"write" || m == b"raise",
      None -> false,
    };
  let named = |j: Int| identifier_at(tokens, j) != None;
  punct_at(tokens, i, b"lt")
    && ((named(i - 1) && moded(i - 2))
    || (punct_at(tokens, i - 1, b"rbracket") && named(i - 2) && punct_at(tokens, i - 3, b"lbracket")
    && named(i - 4)
    && moded(i - 5)))
}

fn hidden_import_mentions(text: Bytes) -> List<Mention> / {abort.raise} =
  hidden_of(match header(text) { Some(m) -> m, None -> parse(text).node })

fn implicit_mentions(
  source: Bytes,
  tokens: List<Token>,
  text: () -> Bytes / {abort.raise},
) -> List<Mention> / {abort.raise} = {
  let s = start_from_tokens(source, tokens);
  hidden_of(match header_of(s.input, s.parser) { Some(m) -> m, None -> parse(text()).node })
}

fn hidden_of(raw: Module) -> List<Mention> =
  raw.imports.fold([], |accumulator: List<Mention>, d: ImportDeclaration|
    if is_explicit_import(d) || imports_implicit_names(d) { accumulator }
    else { accumulator.push({ module: import_path(d), name: b"" }) })

fn imports_implicit_names(d: ImportDeclaration) -> Bool =
  match d.kind { ModuleAlias(a) -> implicitly_imported_by(a.name) != [], _ -> false }

fn is_generated_derive(raw: Module, item: Item) -> Bool =
  match item { DeriveItem(d) -> deriver_module(raw, d.deriver) != Some(b"std.sql"), _ -> false }

fn derivations_of(parsed: ParsedModule, items: List<Item>) -> List<Derivation> =
  items.fold([], |accumulator: List<Derivation>, item: Item|
    match item {
      DeriveItem(d) -> match parsed.derived.find(|x: DeriveOrigin| x.span == d.span) {
        Some(x) -> accumulator.push(derivation_of(x)),
        None -> accumulator,
      },
      _ -> accumulator,
    })

fn deriver_modules_of(raw: Module, items: List<Item>) -> List<Bytes> =
  items.fold([], |accumulator: List<Bytes>, item: Item|
    match item {
      DeriveItem(d) -> if is_generated_derive(raw, item) { accumulator } else {
        match deriver_module(raw, d.deriver) {
          Some(m) -> if accumulator.contains(m) { accumulator } else { accumulator.push(m) },
          None -> accumulator,
        }
      },
      _ -> accumulator,
    })

fn imports_for(
  imports: List<ImportDeclaration>,
  targets: List<Bytes>,
  mentions: List<Mention>,
  runtimes: List<Bytes>,
) -> List<ImportDeclaration> / {abort.raise} =
  imports_read(imports, targets, mentions, runtimes).map(|x: Imported| x.declaration)

pub type Imported = { declaration: ImportDeclaration, target: Bytes }

derive bin for Imported

pub fn imports_read(
  imports: List<ImportDeclaration>,
  targets: List<Bytes>,
  mentions: List<Mention>,
  runtimes: List<Bytes>,
) -> List<Imported> / {abort.raise} = {
  let named = mentions.fold(Map::new(), |accumulator: Map<Bytes, Bool>, m: Mention|
    accumulator.insert(mention_key(m), true));
  let modules = mentions.fold(Map::new(), |accumulator: Map<Bytes, Bool>, m: Mention|
    accumulator.insert(m.module, true));
  range(0, min(imports.len(), targets.len())).fold([], |accumulator: List<Imported>, i: Int| {
    let d = imports.get(i);
    let target = targets.get(i);
    if !is_explicit_import(d) { accumulator }
    else if runtimes.contains(target) { accumulator.push({ declaration: d, target: target }) }
    else {
      match d.kind {
        SelectedNames(ns) -> {
          let mentioned_names = ns.filter(|n: Identifier|
            named.contains(mention_key({ module: target, name: n.name })));
          if mentioned_names.len() == 0 { accumulator } else {
            accumulator.push({
              declaration: { ..d, kind: SelectedNames(mentioned_names) },
              target: target,
            })
          }
        },
        _ -> if modules.contains(target) { accumulator.push({ declaration: d, target: target }) }
        else { accumulator },
      }
    }
  })
}

pub fn group_imports(
  module: Bytes,
  members: List<OwnerText>,
  mentions: List<Mention>,
  imports: List<ImportDeclaration>,
  targets: List<Bytes>,
) -> List<Imported> / {abort.raise} = {
  let names = members.map(|o: OwnerText| o.owner);
  imports_read(
    imports,
    targets,
    mentions.filter(|m: Mention| !(m.module == module && names.contains(m.name))),
    members.fold([], |accumulator: List<Bytes>, o: OwnerText| accumulator.concat(o.runtimes)),
  )
}

fn span_key(s: Span) -> Bytes = Bytes::concat_all([u64_le(s.start), u64_le(s.end)])

fn listed_under(m: Map<Bytes, List<Bytes>>, k: Bytes, v: Bytes) -> Map<Bytes, List<Bytes>> = {
  let had = match m.get(k) { Some(xs) -> xs, None -> [] };
  if had.contains(v) { m } else { m.insert(k, had.push(v)) }
}

fn function_owners(raw: Module, parsed: ParsedModule) -> Map<Bytes, Bytes> = {
  let stated = raw.items.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, item: Item|
    match owner_of(item) {
      Some(o) -> accumulator.insert(span_key(item_span(item)), o),
      None -> accumulator,
    });
  let written = raw.items.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, item: Item|
    match item {
      FunctionItem(f) -> accumulator.insert(f.name.name, f.name.name),
      _ -> accumulator,
    });
  parsed.module.items.fold(written, |accumulator: Map<Bytes, Bytes>, item: Item|
    match item {
      FunctionItem(f) -> if accumulator.contains(f.name.name) { accumulator } else {
        match stated.get(span_key(f.span)) {
          Some(o) -> accumulator.insert(f.name.name, o),
          None -> accumulator,
        }
      },
      _ -> accumulator,
    })
}

fn declares_builtin(raw: Module, parsed: ParsedModule, item: Item) -> Bool =
  match item { ExternItem(d) -> is_builtin(parsed.name, raw, d), _ -> false }

fn owners_in(raw: Module, parsed: ParsedModule) -> Map<Bytes, List<Bytes>> = {
  let own = raw.items.fold(Map::new(), |accumulator: Map<Bytes, List<Bytes>>, item: Item|
    match if declares_builtin(raw, parsed, item) { None } else { owner_of(item) } {
      None -> accumulator,
      Some(o) -> {
        let named = listed_under(accumulator, o, o);
        match item {
          TypeItem(d) -> match d.body {
            SumBody(vs) ->
              vs.fold(named, |a: Map<Bytes, List<Bytes>>, v: VariantDefinition|
                listed_under(a, v.name.name, o)),
            _ -> named,
          },
          _ -> named,
        }
      },
    });
  function_owners(raw, parsed).fold(
    own,
    |accumulator: Map<Bytes, List<Bytes>>, f: Bytes, o: Bytes| listed_under(accumulator, f, o),
  )
}

fn named_in(raw: Module, parsed: ParsedModule) -> Map<Bytes, List<Bytes>> / {abort.raise} =
  function_owners(raw, parsed).fold(
    owners_in(raw, parsed),
    |accumulator: Map<Bytes, List<Bytes>>, f: Bytes, o: Bytes|
      match member_of(f) {
        Some(m) -> listed_under(accumulator, any_module_name(m.member), o),
        None -> accumulator,
      },
  )

fn generated_by_owner(
  raw: Module,
  parsed: ParsedModule,
  owners: Map<Bytes, Bytes>,
) -> Map<Bytes, List<Item>> = {
  let written = raw.items.fold(Map::new(), |accumulator: Map<Bytes, Bool>, item: Item|
    match item { FunctionItem(f) -> accumulator.insert(f.name.name, true), _ -> accumulator });
  parsed.module.items.fold(Map::new(), |accumulator: Map<Bytes, List<Item>>, item: Item|
    match item {
      FunctionItem(f) -> if written.contains(f.name.name) { accumulator } else {
        match owners.get(f.name.name) {
          Some(o) ->
            accumulator.insert(
              o,
              List::push(match accumulator.get(o) { Some(xs) -> xs, None -> [] }, item),
            ),
          None -> accumulator,
        }
      },
      _ -> accumulator,
    })
}

pub fn named_node(name: Bytes) -> Mention / {abort.raise} = {
  let k = range(0, name.len()).fold(0 - 1, |accumulator: Int, i: Int|
    if name.at(i) == 46 { i } else { accumulator });
  if k < 0 { { module: b"", name: name } }
  else { { module: name.slice(0, k), name: name.slice(k + 1, name.len()) } }
}

fn simple_of(module: Bytes, name: Bytes) -> Bytes / {abort.raise} = {
  let prefix = module.concat(b".");
  if name.starts_with(prefix) { name.slice(prefix.len(), name.len()) } else { name }
}

fn grouped<a>(
  xs: List<a>,
  key: (a) -> Bytes / {abort.raise},
) -> Map<Bytes, List<a>> / {abort.raise} =
  xs.fold(Map::new(), |accumulator: Map<Bytes, List<a>>, x: a| {
    let k = key(x);
    accumulator.insert(k, List::push(match accumulator.get(k) { Some(ys) -> ys, None -> [] }, x))
  })

fn alone(text: Bytes, items: List<Item>) -> Bytes / {abort.raise} =
  Bytes::join(items.map(|item: Item| print_standalone(text, [], [item])), b"")

pub fn visible_modules(analysis: Analysis, i: Int) -> List<Bytes> / {abort.raise} =
  iterate({ seen: [], work: [i] }, 1000000, |s: { seen: List<Int>, work: List<Int> }|
    match s.work {
      [] -> Stop(s.seen),
      [k, ..rest] ->
        Continue(
          List::fold(
            match analysis.r.imports.at(k) { Some(ts) -> ts, None -> [] },
            { seen: s.seen, work: rest },
            |accumulator: { seen: List<Int>, work: List<Int> }, t: Int|
              if t == i || accumulator.seen.contains(t) { accumulator }
              else { { seen: accumulator.seen.push(t), work: accumulator.work.push(t) } },
          ),
        ),
    }).map(|k: Int| analysis.modules.get(k).name)

pub fn import_targets(analysis: Analysis, i: Int) -> List<Bytes> / {abort.raise} =
  match analysis.r.imports.at(i) {
    Some(ts) -> ts.map(|t: Int| analysis.modules.get(t).name),
    None -> [],
  }

fn scopes(
  parsed: ParsedModule,
  raw: Module,
  targets: List<Bytes>,
) -> { written: Scope, expanded: Scope } / {abort.raise} = {
  let owners = named_in(raw, parsed);
  let added = parsed.module.imports.drop(raw.imports.len()).map(import_path);
  {
    written: scope_of(parsed.name, raw.imports, targets, owners),
    expanded: scope_of(parsed.name, parsed.module.imports, targets.concat(added), owners),
  }
}

fn checked_fixed(f: CachedNode) -> CachedNode =
  {
    ..f,
    hash: if f.declaration { f.hash } else { f.contract },
    own: None,
    specs: [],
    spec_texts: [],
    spec_checks: [],
    check: if f.declaration { f.hash } else { f.contract },
    body: b"",
    edges: [],
    effects: [],
  }

fn unplaced_raise(r: Raise) -> Raise = { ..r, span: dummy_span() }

pub fn exports_of(
  analysis: Analysis,
  i: Int,
  text: Bytes,
  read: Option<Module> = None,
  published: Option<Rows> = None,
) -> Exports / {abort.raise} = {
  let parsed = analysis.modules.get(i);
  let module = parsed.name;
  let raw = match read { Some(r) -> r, None -> parse(text).node };
  let owners = named_in(raw, parsed);
  let functions = function_owners(raw, parsed);
  let targets = import_targets(analysis, i);
  let mention_scopes = scopes(parsed, raw, targets);
  let fn_owner = |name: Bytes|
    match functions.get(simple_of(module, name)) { Some(o) -> o, None -> b"" };
  let contracts = analysis.hashes.contracts.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
      accumulator.insert(x.name, x.hash),
  );
  let rows = grouped(
    List::filter(
      (match published { Some(rows) -> rows, None -> rows_of(analysis) }).definitions,
      |r: KnownDefinitionRow| is_declared_in(module, r.name),
    ).map(|r: KnownDefinitionRow|
      {
        ..r,
        hash: match contracts.get(r.name) { Some(h) -> h, None -> r.hash },
        raises: r.raises.map(unplaced_raise),
        facts: b"",
        value: None,
      }),
    |r: KnownDefinitionRow| fn_owner(r.name),
  );
  let fixed = grouped(
    cached_nodes(analysis.index, analysis.hashes, Map::new().insert(module, true)).map(
      checked_fixed,
    ),
    |f: CachedNode| if f.declaration { simple_of(module, f.name) } else { fn_owner(f.name) },
  );
  let items = grouped(raw.items.filter(|item: Item| owner_of(item) != None), |item: Item|
    match owner_of(item) { Some(o) -> o, None -> b"" });
  let generated = generated_by_owner(raw, parsed, functions);
  {
    module: module,
    owners: owners,
    entries: items.fold(
      Map::new(),
      |accumulator: Map<Bytes, OwnerInterface>, o: Bytes, its: List<Item>| {
        let stated = alone(
          text,
          its.filter(|item: Item| !is_generated_derive(raw, item)).map(interface_item),
        );
        let fs = match generated.get(o) { Some(fs) -> fs, None -> [] };
        let derives = its.fold(Map::new(), |spans: Map<Bytes, Bool>, item: Item|
          if is_generated_derive(raw, item) { spans.insert(span_key(item_span(item)), true) }
          else { spans });
        let printed = stated.concat(
          alone(
            text,
            fs.filter(|f: Item| derives.contains(span_key(item_span(f)))).map(interface_item),
          ),
        );
        let expansion = if fs.len() == 0 { [] }
        else { mentioned(mention_scopes.expanded, alone(text, fs)) };
        let mentions = distinct(
          mentioned(mention_scopes.written, stated).concat(expansion).concat(
            hidden_import_mentions(printed),
          ),
        ).filter(|m: Mention| !(m.module == module && m.name == o));
        let runtimes = deriver_modules_of(raw, its);
        accumulator.insert(o, {
          transitive_digest: b"",
          owner: o,
          text: printed,
          imports: imports_for(raw.imports, targets, mentions, runtimes).map(without_spans),
          mentions: mentions,
          rows: match rows.get(o) { Some(xs) -> xs, None -> [] },
          fixed: match fixed.get(o) { Some(xs) -> xs, None -> [] },
          derived: derivations_of(parsed, its.filter(|item: Item| !is_generated_derive(raw, item))),
        })
      },
    ),
  }
}

pub fn hashes_of(index: Index, hashes: HashOutput, i: Int, text: Bytes) -> Hashes / {abort.raise} = {
  let parsed = index.modules.get(i);
  hashes_by_owner(
    parsed.name,
    cached_nodes(index, hashes, Map::new().insert(parsed.name, true)),
    function_owners(parse(text).node, parsed),
  )
}

pub fn hashes_by_owner(
  module: Bytes,
  fixed: List<CachedNode>,
  functions: Map<Bytes, Bytes>,
) -> Hashes / {abort.raise} = {
  let fn_owner = |name: Bytes|
    match functions.get(simple_of(module, name)) { Some(o) -> o, None -> b"" };
  let owned = grouped(fixed.map(|f: CachedNode| { ..f, body: b"" }), |f: CachedNode|
    if f.declaration { simple_of(module, f.name) } else { fn_owner(f.name) });
  {
    module: module,
    entries: owned.fold(
      Map::new(),
      |accumulator: Map<Bytes, HashEntry>, o: Bytes, fs: List<CachedNode>|
        accumulator.insert(o, {
          owner: o,
          cached_nodes: fs,
          mentions: distinct(
            fs.fold([], |ms: List<Mention>, f: CachedNode|
              ms.concat(f.effects.map(|r: NodeRef| named_node(r.name)))),
          ).filter(|m: Mention| !(m.module == module && m.name == o)),
        }),
    ),
  }
}

pub fn hash_owners(
  raw: Module,
  parsed: ParsedModule,
) -> { functions: Map<Bytes, Bytes>, owners: Map<Bytes, List<Bytes>> } =
  { functions: function_owners(raw, parsed), owners: owners_in(raw, parsed) }

pub fn imported_mentions_in(
  parsed: ParsedModule,
  raw: Module,
  text: Bytes,
  tokens: List<Token>,
  targets: List<Bytes>,
) -> List<Mention> / {abort.raise} = {
  let mention_scopes = scopes(parsed, raw, targets);
  let expansion = generated_by_owner(raw, parsed, function_owners(raw, parsed)).fold(
    [],
    |accumulator: List<Mention>, _: Bytes, fs: List<Item>|
      accumulator.concat(mentioned(mention_scopes.expanded, alone(text, fs))),
  );
  let selected = mention_scopes.written.selected.fold(
    [],
    |accumulator: List<Mention>, n: Bytes, ms: List<Bytes>|
      accumulator.concat(ms.map(|m: Bytes| { module: m, name: n })),
  );
  let runtimes = deriver_modules_of(raw, raw.items).map(|m: Bytes| { module: m, name: b"" });
  distinct(
    mentioned_in(mention_scopes.written, tokens).concat(expansion).concat(selected).concat(
      runtimes.concat(hidden_of(raw)),
    ),
  ).filter(|m: Mention| m.module != parsed.name)
}

pub fn imported_mentions_of(
  analysis: Analysis,
  i: Int,
  text: Bytes,
) -> List<Mention> / {abort.raise} = {
  let s = start(text);
  imported_mentions_in(
    analysis.modules.get(i),
    parse_started(s).node,
    text,
    s.input.tokens,
    import_targets(analysis, i),
  )
}

pub fn needed_by<| e>(
  entries: (Bytes, Bytes) -> List<OwnerInterface> / {abort.raise | e},
  wanted: List<Mention>,
  imported: List<Bytes>,
  returning: (Bytes) -> List<Bytes> / {abort.raise | e},
) -> Map<Bytes, Map<Bytes, OwnerInterface>> / {abort.raise | e} =
  needed_entries(entries, interface_header_of, wanted, imported, |_: Bytes, _: Bytes| [], returning)

pub fn needed_entries<x | e>(
  entries: (Bytes, Bytes) -> List<x> / {abort.raise | e},
  head: (x) -> InterfaceHeader,
  wanted: List<Mention>,
  imported: List<Bytes>,
  publishing: (Bytes, Bytes) -> List<Mention> / {abort.raise | e},
  returning: (Bytes) -> List<Bytes> / {abort.raise | e},
) -> Map<Bytes, Map<Bytes, x>> / {abort.raise | e} =
  iterate(
    {
      out: imported.fold(Map::new(), |accumulator: Map<Bytes, Map<Bytes, x>>, m: Bytes|
        accumulator.insert(m, Map::new())),
      requested: Map::new(),
      work: wanted,
    },
    1000000,
    |s: { out: Map<Bytes, Map<Bytes, x>>, requested: Map<Bytes, Bool>, work: List<Mention> }|
      match s.work {
        [] -> Stop(s.out),
        [m, ..rest] -> if s.requested.contains(mention_key(m)) { Continue({ ..s, work: rest }) }
        else if m.module == b"" {
          Continue({
            ..s,
            requested: s.requested.insert(mention_key(m), true),
            work: rest.concat(called_of(returning(m.name), [m.name])),
          })
        } else {
          let have = match s.out.get(m.module) { Some(h) -> h, None -> Map::new() };
          let fresh = entries(m.module, m.name).fold(
            [],
            |accumulator: List<{ head: InterfaceHeader, x: x }>, e: x| {
              let h = head(e);
              if have.contains(h.owner) { accumulator } else { accumulator.push({ head: h, x: e }) }
            },
          );
          let visited_mentions = s.requested.insert(mention_key(m), true);
          if fresh.len() == 0 {
            Continue({
              out: if s.out.contains(m.module) || m.name.starts_with(b"::")
                  || entries(m.module, b"").len() == 0 { s.out }
              else { s.out.insert(m.module, have) },
              requested: visited_mentions,
              work: rest,
            })
          } else {
            Continue({
              out: s.out.insert(
                m.module,
                fresh.fold(have, |h: Map<Bytes, x>, f: { head: InterfaceHeader, x: x }|
                  h.insert(f.head.owner, f.x)),
              ),
              requested: visited_mentions,
              work: fresh.fold(rest, |w: List<Mention>, f: { head: InterfaceHeader, x: x }|
                w.concat(f.head.mentions.concat(publishing(m.module, f.head.owner)))),
            })
          }
        },
      },
  )

pub fn owner_interfaces_under(x: Exports, name: Bytes) -> List<OwnerInterface> =
  if name == b"" {
    x.entries.fold([], |accumulator: List<OwnerInterface>, _: Bytes, e: OwnerInterface|
      accumulator.push(e))
  } else {
    match x.owners.get(name) {
      None -> [],
      Some(os) ->
        os.fold([], |accumulator: List<OwnerInterface>, o: Bytes|
          match x.entries.get(o) { Some(e) -> accumulator.push(e), None -> accumulator }),
    }
  }

pub fn owner_interfaces_in(
  exports: Map<Bytes, Exports>,
  module: Bytes,
  name: Bytes,
) -> List<OwnerInterface> =
  match exports.get(module) { None -> [], Some(x) -> owner_interfaces_under(x, name) }

fn nowhere(i: Identifier) -> Identifier = { ..i, span: dummy_span() }

fn without_spans(d: ImportDeclaration) -> ImportDeclaration =
  {
    path: d.path.map(nowhere),
    kind: match d.kind {
      WholeModule -> WholeModule,
      ModuleAlias(a) -> ModuleAlias(nowhere(a)),
      SelectedNames(ns) -> SelectedNames(ns.map(nowhere)),
    },
    span: dummy_span(),
  }

fn import_key(d: ImportDeclaration) -> Bytes =
  Bytes::concat_all([
    import_path(d),
    match d.kind {
      WholeModule -> b"",
      ModuleAlias(a) -> b" as ".concat(a.name),
      SelectedNames(_) -> b" ()",
    },
  ])

fn merged_imports(entries: List<OwnerInterface>) -> List<ImportDeclaration> / {abort.raise} = {
  let merged = entries.fold(
    { order: [], held: Map::new() },
    |accumulator: { order: List<Bytes>, held: Map<Bytes, ImportDeclaration> }, e: OwnerInterface|
      e.imports.fold(
        accumulator,
        |a: { order: List<Bytes>, held: Map<Bytes, ImportDeclaration> }, d: ImportDeclaration| {
          let k = import_key(d);
          match a.held.get(k) {
            None -> { order: a.order.push(k), held: a.held.insert(k, d) },
            Some(had) -> match ((had.kind, d.kind)) {
              (SelectedNames(xs), SelectedNames(ys)) -> {
                let names = ys.fold(xs, |ns: List<Identifier>, y: Identifier|
                  if ns.fold(false, |b: Bool, n: Identifier| b || n.name == y.name) { ns }
                  else { ns.push(y) });
                { ..a, held: a.held.insert(k, { ..had, kind: SelectedNames(names) }) }
              },
              _ -> a,
            },
          }
        },
      ),
  );
  merged.order.map(|k: Bytes|
    match merged.held.get(k) {
      Some(d) -> d,
      None -> panic("internal error: an import was merged but its merged result is missing"),
    })
}

pub fn interface_source(
  module: Bytes,
  entries: Map<Bytes, OwnerInterface>,
) -> Source / {abort.raise} = {
  let es = entries.fold([], |accumulator: List<OwnerInterface>, _: Bytes, e: OwnerInterface|
    accumulator.push(e));
  {
    name: module,
    source_text: print_standalone(b"", merged_imports(es), []).concat(
      Bytes::join(es.map(|e: OwnerInterface| e.text), b"\n"),
    ),
  }
}

pub type ModuleOrigin = | InRoot | InPackage(Int, Bytes) | ShippedModule

derive bin for ModuleOrigin

pub type CheckInputs = {
  packages: PackageSources,
  tested: Bool,
  checked_packages: Option<ValidatedPackages>,
  unread: List<Bytes>,
  all_sources: List<Source>,
  data: List<EmbedFile>,
  embeds: List<EmbedRecord>,
  given: List<ParsedSource>,
}

fn staged_with_interfaces(
  source: Source,
  placed: ModuleOrigin,
  dependencies: Map<Bytes, Map<Bytes, OwnerInterface>>,
  fixed: List<CachedNode>,
  placing: (Bytes) -> ModuleOrigin / {abort.raise},
  reading: CheckInputs,
) -> { staged: StagedLoad, at: Int } / {abort.raise} = {
  let dependency_sources = dependencies.fold(
    [],
    |accumulator: List<{ placed: ModuleOrigin, source: Source }>, m: Bytes, es: Map<Bytes, OwnerInterface>|
      accumulator.push({ placed: placing(m), source: interface_source(m, es) }),
  );
  let rooted = dependency_sources.fold(
    [],
    |accumulator: List<Source>, x: { placed: ModuleOrigin, source: Source }|
      match x.placed { InRoot -> accumulator.push(x.source), _ -> accumulator },
  );
  let standing_in = dependency_sources.fold(
    [],
    |accumulator: List<Source>, x: { placed: ModuleOrigin, source: Source }|
      match x.placed { ShippedModule -> accumulator.push(x.source), _ -> accumulator },
  );
  let shipped = if source.name == prelude_module()
      || standing_in.concat(reading.all_sources).any(|s: Source| s.name == prelude_module()) {
    standing_in
  } else { standing_in.push(interface_source(prelude_module(), Map::new())) };
  let supplied = range(0, reading.packages.supplied.len()).map(|i: Int| {
    let package_sources = dependency_sources.fold(
      [],
      |accumulator: List<Source>, x: { placed: ModuleOrigin, source: Source }|
        match x.placed {
          InPackage(k, rel) -> if k == i + 1 {
            accumulator.push({ name: rel, source_text: x.source.source_text })
          } else { accumulator },
          _ -> accumulator,
        },
    );
    {
      ..reading.packages.supplied.get(i),
      modules: match placed {
        InPackage(k, rel) -> if k == i + 1 {
          package_sources.push({ name: rel, source_text: source.source_text })
        } else { package_sources },
        _ -> package_sources,
      },
    }
  });
  let own = placed != ShippedModule;
  let at = match placed {
    InRoot -> rooted.len(),
    InPackage(k, _) ->
      rooted.len()
        + range(0, k).fold(0, |n: Int, i: Int|
          match supplied.at(i) { Some(p) -> n + p.modules.len(), None -> n })
        - 1,
    ShippedModule ->
      rooted.len() + supplied.fold(0, |n: Int, p: SuppliedPackage| n + p.modules.len()),
  };
  let staged = load_with_shipped(
    match placed { InRoot -> rooted.push(source), _ -> rooted },
    shipped.concat(reading.all_sources).concat(if own { [] } else { [source] }),
    { ..reading.packages, supplied: supplied },
    { nodes: fixed, tests: [], laws: [] },
    reading.embeds,
    tested: reading.tested,
    cut_unused: false,
    data: reading.data,
    unread: {
      let staged = shipped.concat(reading.all_sources).fold(
        Map::new(),
        |accumulator: Map<Bytes, Bool>, s: Source| accumulator.insert(s.name, true),
      );
      reading.unread.filter(|n: Bytes| !staged.contains(n))
    },
    required: shipped.map(|s: Source| s.name).concat(if own { [] } else { [source.name] }),
    apart: placed == InRoot && is_shipped(source.name),
    given: reading.given,
    derived: dependencies.fold(
      [],
      |accumulator: List<ModuleDerivations>, m: Bytes, es: Map<Bytes, OwnerInterface>|
        accumulator.push({
          module: m,
          derivations: es.fold([], |ds: List<Derivation>, _: Bytes, e: OwnerInterface|
            ds.concat(e.derived)),
        }),
    ),
    package_verdicts: reading.checked_packages,
    checked: Some(source.name),
  );
  {
    staged: staged,
    at: if own { at } else {
      range(0, staged.pulled.len()).fold(at, |found: Int, i: Int|
        if staged.pulled.at(i) == Some(source.name) { at + i } else { found })
    },
  }
}

pub fn checked_against(
  source: Source,
  placed: ModuleOrigin,
  dependencies: Map<Bytes, Map<Bytes, OwnerInterface>>,
  placing: (Bytes) -> ModuleOrigin / {abort.raise},
  reading: CheckInputs,
) -> { pulled: PulledAnalysis, at: Int } / {abort.raise} = {
  let rows = dependencies.fold(
    [],
    |accumulator: List<KnownDefinitionRow>, _: Bytes, es: Map<Bytes, OwnerInterface>|
      es.fold(accumulator, |a: List<KnownDefinitionRow>, _: Bytes, e: OwnerInterface|
        a.concat(e.rows)),
  );
  let fixed = dependencies.fold(
    [],
    |accumulator: List<CachedNode>, _: Bytes, es: Map<Bytes, OwnerInterface>|
      es.fold(accumulator, |a: List<CachedNode>, _: Bytes, e: OwnerInterface| a.concat(e.fixed)),
  );
  let s = staged_with_interfaces(source, placed, dependencies, fixed, placing, reading);
  {
    pulled: checked_staged(s.staged, { definitions: rows, tests: [], types: Map::new() }),
    at: s.at,
  }
}

pub fn owner_items(raw: Module, owner: Bytes) -> List<Item> =
  raw.items.filter(|item: Item| item_owner(item) == owner)

pub type ModuleScope = { written: Scope, expanded: Scope }

pub type OwnerText = {
  owner: Bytes,
  texts: List<Bytes>,
  starts: List<Int>,
  generated: Bytes,
  runtimes: List<Bytes>,
  derived: List<Derivation>,
  names: List<Bytes>,
}

pub fn module_scope(
  parsed: ParsedModule,
  raw: Module,
  targets: List<Bytes>,
) -> ModuleScope / {abort.raise} = {
  let s = scopes(parsed, raw, targets);
  { written: s.written, expanded: s.expanded }
}

pub fn owner_texts(
  parsed: ParsedModule,
  raw: Module,
  text: Bytes,
) -> List<OwnerText> / {abort.raise} = {
  let generated = generated_by_owner(raw, parsed, function_owners(raw, parsed));
  let declared = owners_in(raw, parsed).fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Bytes>>, n: Bytes, os: List<Bytes>|
      os.fold(accumulator, |a: Map<Bytes, List<Bytes>>, o: Bytes| listed_under(a, o, n)),
  );
  let owners = raw.items.fold([], |os: List<Bytes>, item: Item| {
    let o = item_owner(item);
    if os.contains(o) || declares_builtin(raw, parsed, item) { os } else { os.push(o) }
  });
  owners.map(|o: Bytes| {
    let its = owner_items(raw, o);
    {
      owner: o,
      texts: its.map(|item: Item| text.slice(written_start(text, item), item_span(item).end)),
      starts: its.map(|item: Item| written_start(text, item)),
      generated: match generated.get(o) { Some(fs) -> alone(text, fs), None -> b"" },
      runtimes: deriver_modules_of(raw, its),
      derived: derivations_of(parsed, its),
      names: match declared.get(o) { Some(ns) -> ns, None -> [] },
    }
  })
}

pub fn signature_text(raw: Module, o: OwnerText) -> OwnerText / {abort.raise} = {
  let cuts = signature_ends(raw, o);
  {
    ..o,
    texts: range(0, o.texts.len()).map(|k: Int| {
      let written = o.texts.get(k);
      match cuts.get(k) {
        Some(c) -> written.slice(0, c - o.starts.get(k)).concat(b"{}"),
        None -> written,
      }
    }),
  }
}

fn signature_ends(raw: Module, o: OwnerText) -> List<Option<Int>> =
  owner_items(raw, o.owner).map(|item: Item|
    match item {
      FunctionItem(d) -> if d.transparent != None { None }
      else { Some(expression_span(d.body).start) },
      _ -> None,
    })

pub fn owner_tokens(tokens: List<Token>, o: OwnerText) -> List<Token> / {abort.raise} =
  read_tokens(tokens, o, o.texts.map(|_: Bytes| None))

pub fn signature_tokens(
  raw: Module,
  tokens: List<Token>,
  o: OwnerText,
) -> List<Token> / {abort.raise} = read_tokens(tokens, o, signature_ends(raw, o))

fn read_tokens(
  tokens: List<Token>,
  o: OwnerText,
  cuts: List<Option<Int>>,
) -> List<Token> / {abort.raise} = {
  let laid = range(0, o.texts.len()).fold(
    { tokens: [], end: 0 },
    |accumulator: { tokens: List<Token>, end: Int }, k: Int| {
      let from = o.starts.get(k);
      let cut = cuts.get(k);
      let to = match cut { Some(c) -> c, None -> from + o.texts.get(k).len() };
      let first = tokens.partition_point(|t: Token| t.start < from);
      let past = tokens.partition_point(|t: Token| t.start < to);
      let written = range(first, past).fold(accumulator.tokens, |ts: List<Token>, i: Int|
        ts.push(tokens.get(i)));
      match cut {
        Some(c) ->
          {
            tokens: written.push({ start: c, end: c + 1, kind: Punctuation(b"lbrace") }).push({
              start: c + 1,
              end: c + 2,
              kind: Punctuation(b"rbrace"),
            }),
            end: c + 2,
          },
        None -> { tokens: written, end: to },
      }
    },
  );
  laid.tokens.push({ start: laid.end, end: laid.end, kind: EndOfInput })
}

fn written_start(text: Bytes, item: Item) -> Int / {abort.raise} =
  iterate(item_span(item).start, 64, |s: Int| {
    let end = iterate(s, s + 1, |i: Int|
      if i > 0 && [9, 10, 13, 32].contains(text.at(i - 1)) { Continue(i - 1) } else { Stop(i) });
    let begin = iterate(end, end + 1, |i: Int|
      if i > 0 && is_identifier_start(text.at(i - 1)) { Continue(i - 1) } else { Stop(i) });
    let line = iterate(begin, begin + 1, |i: Int|
      if i > 0 && text.at(i - 1) != 10 { Continue(i - 1) } else { Stop(i) });
    if begin < end
        && [b"pub", b"const", b"transparent", b"reuse", b"opaque", b"nondet"].contains(
          text.slice(begin, end),
        )
        && text.slice(line, begin).index_of(b"//") == None { Continue(begin) }
    else { Stop(s) }
  })

pub fn owner_mentions(
  module: Bytes,
  scope: ModuleScope,
  o: OwnerText,
  source: Bytes,
  tokens: List<Token>,
) -> List<Mention> / {abort.raise} = {
  let expansion = if o.generated.len() == 0 { [] } else { mentioned(scope.expanded, o.generated) };
  let hidden = implicit_mentions(source, tokens, || Bytes::join(o.texts, b"\n\n"));
  distinct(mentioned_in(scope.written, tokens).concat(expansion).concat(hidden)).filter(
    |m: Mention| !(m.module == module && m.name == o.owner),
  )
}

pub fn owner_groups(
  module: Bytes,
  scope: ModuleScope,
  owners: List<Bytes>,
  mentions: Map<Bytes, List<Mention>>,
) -> List<List<Bytes>> / {abort.raise} = {
  let slot = range(0, owners.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
    accumulator.insert(owners.get(i), i));
  let out = owners.map(|o: Bytes|
    List::fold(
      match mentions.get(o) { Some(ms) -> ms, None -> [] },
      [],
      |accumulator: List<Int>, m: Mention|
        if m.module != module { accumulator } else {
          List::fold(
            match scope.written.owners.get(m.name) { Some(os) -> os, None -> [] },
            accumulator,
            |a: List<Int>, p: Bytes|
              match slot.get(p) { Some(k) -> if a.contains(k) { a } else { a.push(k) }, None -> a },
          )
        },
    ));
  graph::components({ out: out }).map(|comp: List<Int>|
    comp.map(|i: Int| owners.get(i)).sort_by(|a: Bytes, b: Bytes|
      match compare_values(a, b) { Greater -> false, _ -> true }))
}

pub fn call_cycles(
  owners: List<Bytes>,
  called: List<List<Bytes>>,
) -> List<List<Bytes>> / {abort.raise} = {
  let slot = range(0, owners.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
    accumulator.insert(owners.get(i), i));
  let out = called.map(|cs: List<Bytes>|
    cs.fold([], |accumulator: List<Int>, c: Bytes|
      match slot.get(c) {
        Some(k) -> if accumulator.contains(k) { accumulator } else { accumulator.push(k) },
        None -> accumulator,
      }));
  graph::components({ out: out }).map(|comp: List<Int>|
    comp.map(|i: Int| owners.get(i)).sort_by(|a: Bytes, b: Bytes|
      match compare_values(a, b) { Greater -> false, _ -> true }))
}

pub type ItemAt = { owner: Bytes, from: Int, to: Int, len: Int }

pub fn item_layout(members: List<OwnerText>) -> List<ItemAt> / {abort.raise} =
  members.fold(
    { at: 0, items: [] },
    |accumulator: { at: Int, items: List<ItemAt> }, o: OwnerText|
      range(0, o.texts.len()).fold(accumulator, |a: { at: Int, items: List<ItemAt> }, k: Int| {
        let t = o.texts.get(k);
        {
          at: a.at + t.len() + 2,
          items: a.items.push({ owner: o.owner, from: a.at, to: o.starts.get(k), len: t.len() }),
        }
      }),
  ).items

pub type OwnerSource = {
  source: Source,
  offset: Int,
  items: List<ItemAt>,
  derived: List<Derivation>,
  dependencies: Map<Bytes, Map<Bytes, OwnerInterface>>,
  rows: List<KnownDefinitionRow>,
  fixed: List<CachedNode>,
}

pub fn group_source<| e>(
  module: Bytes,
  members: List<OwnerText>,
  mentions: List<Mention>,
  imported: List<Imported>,
  entries: (Bytes, Bytes) -> List<OwnerInterface> / {abort.raise | e},
  returning: (Bytes) -> List<Bytes> / {abort.raise | e},
) -> OwnerSource / {abort.raise | e} =
  group_source_from(
    module,
    members,
    imported,
    group_needs(
      module,
      members,
      mentions,
      imported,
      entries,
      interface_header_of,
      |_: Bytes, _: Bytes| [],
      returning,
    ),
  )

pub fn group_needs<x | e>(
  module: Bytes,
  members: List<OwnerText>,
  mentions: List<Mention>,
  imported: List<Imported>,
  entries: (Bytes, Bytes) -> List<x> / {abort.raise | e},
  head: (x) -> InterfaceHeader,
  publishing: (Bytes, Bytes) -> List<Mention> / {abort.raise | e},
  returning: (Bytes) -> List<Bytes> / {abort.raise | e},
) -> Map<Bytes, Map<Bytes, x>> / {abort.raise | e} = {
  let names = members.map(|o: OwnerText| o.owner);
  let selected = imported.fold([], |accumulator: List<Mention>, x: Imported|
    match x.declaration.kind {
      SelectedNames(ns) ->
        accumulator.concat(ns.map(|n: Identifier| { module: x.target, name: n.name })),
      _ -> accumulator,
    });
  needed_entries(
    entries,
    head,
    mentions.filter(|m: Mention| !(m.module == module && names.contains(m.name))).concat(selected),
    imported.map(|x: Imported| x.target).push(module),
    publishing,
    returning,
  )
}

pub fn group_source_from(
  module: Bytes,
  members: List<OwnerText>,
  imported: List<Imported>,
  needed: Map<Bytes, Map<Bytes, OwnerInterface>>,
) -> OwnerSource / {abort.raise} = {
  let names = members.map(|o: OwnerText| o.owner);
  let own = Bytes::join(
    members.fold([], |accumulator: List<Bytes>, o: OwnerText| accumulator.concat(o.texts)),
    b"\n\n",
  );
  let siblings = match needed.get(module) {
    Some(es) ->
      names.fold(es, |accumulator: Map<Bytes, OwnerInterface>, n: Bytes| accumulator.remove(n)),
    None -> Map::new(),
  };
  let dependencies = needed.remove(module);
  let sibling_interfaces = siblings.fold(
    [],
    |accumulator: List<OwnerInterface>, _: Bytes, e: OwnerInterface| accumulator.push(e),
  );
  let written = print_standalone(
    b"",
    merged_imports(
      sibling_interfaces.push({
        transitive_digest: b"",
        owner: b"",
        text: own,
        imports: imported.map(|x: Imported| x.declaration),
        mentions: [],
        rows: [],
        fixed: [],
        derived: [],
      }),
    ),
    [],
  );
  let all = dependencies.fold(
    [],
    |accumulator: List<Map<Bytes, OwnerInterface>>, _: Bytes, es: Map<Bytes, OwnerInterface>|
      accumulator.push(es),
  ).push(
    siblings,
  );
  {
    source: {
      name: module,
      source_text: Bytes::concat_all([
        written,
        own,
        b"\n\n",
        Bytes::join(sibling_interfaces.map(|e: OwnerInterface| e.text), b"\n"),
      ]),
    },
    offset: written.len(),
    items: item_layout(members),
    derived: members.fold(
      sibling_interfaces.fold([], |accumulator: List<Derivation>, e: OwnerInterface|
        accumulator.concat(e.derived)),
      |accumulator: List<Derivation>, o: OwnerText| accumulator.concat(o.derived),
    ),
    dependencies: dependencies,
    rows: all.fold([], |accumulator: List<KnownDefinitionRow>, es: Map<Bytes, OwnerInterface>|
      es.fold(accumulator, |a: List<KnownDefinitionRow>, _: Bytes, e: OwnerInterface|
        a.concat(e.rows))),
    fixed: all.fold([], |accumulator: List<CachedNode>, es: Map<Bytes, OwnerInterface>|
      es.fold(accumulator, |a: List<CachedNode>, _: Bytes, e: OwnerInterface| a.concat(e.fixed))),
  }
}

pub fn unplaced_imports(raw: Module) -> List<ImportDeclaration> = raw.imports.map(without_spans)

pub fn owner_source<| e>(
  parsed: ParsedModule,
  raw: Module,
  text: Bytes,
  targets: List<Bytes>,
  owner: Bytes,
  entries: (Bytes, Bytes) -> List<OwnerInterface> / {abort.raise | e},
  returning: (Bytes) -> List<Bytes> / {abort.raise | e},
) -> OwnerSource / {abort.raise | e} = {
  let scope = module_scope(parsed, raw, targets);
  let members = owner_texts(parsed, raw, text).filter(|o: OwnerText| o.owner == owner);
  let tokens = lex(text).tokens;
  let mentions = members.fold([], |accumulator: List<Mention>, o: OwnerText|
    accumulator.concat(owner_mentions(parsed.name, scope, o, text, owner_tokens(tokens, o))));
  group_source(
    parsed.name,
    members,
    mentions,
    group_imports(parsed.name, members, mentions, unplaced_imports(raw), targets),
    entries,
    returning,
  )
}

fn named_as_owned(m: Module, o: OwnerSource) -> Module / {abort.raise} =
  {
    ..m,
    items: m.items.map(|item: Item|
      match item {
        TestItem(d) -> {
          let start = d.span.start - o.offset;
          match o.items.find(|x: ItemAt| x.from <= start && start < x.from + x.len) {
            Some(x) -> match test_of_owner(x.owner) {
              Some(name) -> TestItem({ ..d, name: name }),
              None -> item,
            },
            None -> item,
          }
        },
        _ -> item,
      }),
  }

pub fn checked_owner(
  o: OwnerSource,
  placed: ModuleOrigin,
  placing: (Bytes) -> ModuleOrigin / {abort.raise},
  reading: CheckInputs,
  walks: Option<(Int) -> BodyChecking / {abort.raise}> = None,
) -> { pulled: PulledAnalysis, at: Int } / {abort.raise} = {
  let raw = parse(o.source.source_text);
  let parsed = parse_from(
    0,
    o.source,
    { ..raw, node: named_as_owned(raw.node, o) },
    derivations: o.derived,
  );
  let s = staged_with_interfaces(o.source, placed, o.dependencies, o.fixed, placing, {
    ..reading,
    given: reading.given.push(parsed),
  });
  {
    pulled: checked_staged(
      s.staged,
      { definitions: o.rows, tests: [], types: Map::new() },
      match walks { Some(at) -> at(s.at), None -> CheckEvery },
    ),
    at: s.at,
  }
}

fn outcome(p: PulledAnalysis) -> Analysis / {abort.raise} =
  match p.out {
    Rejected(ds) ->
      panic(
        "the program failed to check: "
          ++ String::of_bytes_lossy(
            Bytes::concat_all(
              ds.map(|d: Diagnostic| Bytes::concat_all([d.code, b" ", d.message, b"; "])),
            ),
          ),
      ),
    Analysed(w) -> w,
  }

type Agreed = {
  schemes: List<{ name: Bytes, scheme: Scheme }>,
  rows: List<KnownDefinitionRow>,
  warnings: List<Bytes>,
}

fn module_check_result(w: Analysis, module: Bytes) -> Agreed / {abort.raise} = {
  let mine = |name: Bytes| is_declared_in(module, name);
  let at_module = range(0, w.modules.len()).fold(0, |accumulator: Int, i: Int|
    if w.modules.get(i).name == module { i } else { accumulator });
  {
    schemes: w.checked.definitions.filter(|d: DefinitionInfo| mine(d.name)).map(
      |d: DefinitionInfo| { name: d.name, scheme: canonical_scheme(d.scheme) },
    ),
    rows: rows_of(w).definitions.filter(|r: KnownDefinitionRow| mine(r.name)).map(
      |r: KnownDefinitionRow| { ..r, hash: b"" },
    ),
    warnings: w.warnings.filter(|d: Diagnostic|
      d.labels.fold(false, |b: Bool, l: Label| b || (l.primary && l.module == at_module))).map(
      |d: Diagnostic| d.message,
    ),
  }
}

fn per_module(
  whole: Analysis,
  sources: List<Source>,
) -> List<{ module: Bytes, whole: Agreed, apart: Agreed, hashed: CachedHashes, rehashed: CachedHashes }> / {abort.raise} = {
  let texts = sources.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, s: Source|
    accumulator.insert(s.name, s.source_text));
  let read = with_prelude_source(sources).fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, s: Source| accumulator.insert(s.name, s.source_text),
  );
  let text_at = |i: Int| match read.get(whole.modules.get(i).name) { Some(t) -> t, None -> b"" };
  let exports = range(0, whole.modules.len()).fold(
    Map::new(),
    |accumulator: Map<Bytes, Exports>, i: Int|
      accumulator.insert(whole.modules.get(i).name, exports_of(whole, i, text_at(i))),
  );
  let fixed_of = |keep: (Bytes) -> Bool|
    cached_hashes_of(
      whole.index,
      whole.hashes,
      whole.modules.fold(Map::new(), |accumulator: Map<Bytes, Bool>, m: ParsedModule|
        if keep(m.name) { accumulator.insert(m.name, true) } else { accumulator }),
    );
  let reading = {
    packages: { root: b"", manifest: None, supplied: [] },
    tested: true,
    all_sources: [],
    data: [],
    embeds: [],
    given: [],
    checked_packages: None,
    unread: [],
  };
  let placing = |m: Bytes| if texts.contains(m) { InRoot } else { ShippedModule };
  range(0, whole.modules.len()).fold(
    [],
    |accumulator: List<{ module: Bytes, whole: Agreed, apart: Agreed, hashed: CachedHashes, rehashed: CachedHashes }>, i: Int| {
      let name = whole.modules.get(i).name;
      if !texts.contains(name) { accumulator } else {
        let dependencies = needed_by(
          |module: Bytes, n: Bytes| owner_interfaces_in(exports, module, n),
          imported_mentions_of(whole, i, text_at(i)),
          import_targets(whole, i),
          |_: Bytes| visible_modules(whole, i),
        );
        let source = { name: name, source_text: text_at(i) };
        let parsed = parse_from(
          0,
          source,
          parse(source.source_text),
          derivations: whole.modules.get(i).derived.map(derivation_of),
        );
        let apart = match checked_against(source, InRoot, dependencies, placing, {
            ..reading,
            given: [parsed],
          }).pulled.out {
          Rejected(ds) -> rejected_alone(name, "checks", ds),
          Analysed(w) -> w,
        };
        let at_apart = range(0, apart.modules.len()).fold(0, |k: Int, j: Int|
          if apart.modules.get(j).name == name { j } else { k });
        accumulator.push({
          module: name,
          whole: module_check_result(whole, name),
          apart: module_check_result(apart, name),
          hashed: fixed_of(|m: Bytes| m == name),
          rehashed: hash_forms(
            selection_forms(apart.index, apart.module_packages, {
              ..module_selection(apart.index, at_apart),
              called: Some(called_at(apart.checked.facts.members)),
            }),
            fixed_of(|m: Bytes| m != name).nodes,
          ),
        })
      }
    },
  )
}

fn agreed_owner(
  w: Analysis,
  module: Bytes,
  owned: (Bytes) -> Bool / {abort.raise},
) -> Agreed / {abort.raise} = {
  let a = module_check_result(w, module);
  {
    schemes: a.schemes.filter(|s: { name: Bytes, scheme: Scheme }| owned(s.name)),
    rows: a.rows.filter(|r: KnownDefinitionRow| owned(r.name)),
    warnings: [],
  }
}

fn checked_alone(
  whole: Analysis,
  sources: List<Source>,
  i: Int,
  o: Bytes,
  shipped: List<Source> = [],
) -> Analysis / {abort.raise} = {
  let texts = sources.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, s: Source|
    accumulator.insert(s.name, s.source_text));
  let read = with_prelude_source(sources.concat(shipped)).fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, s: Source| accumulator.insert(s.name, s.source_text),
  );
  let text_at = |k: Int| match read.get(whole.modules.get(k).name) { Some(t) -> t, None -> b"" };
  let exports = range(0, whole.modules.len()).fold(
    Map::new(),
    |accumulator: Map<Bytes, Exports>, k: Int|
      accumulator.insert(whole.modules.get(k).name, exports_of(whole, k, text_at(k))),
  );
  let reading = {
    packages: { root: b"", manifest: None, supplied: [] },
    tested: true,
    all_sources: shipped,
    data: [],
    embeds: [],
    given: [],
    checked_packages: None,
    unread: [],
  };
  let placing = |m: Bytes| if texts.contains(m) { InRoot } else { ShippedModule };
  let parsed = whole.modules.get(i);
  let source = owner_source(
    parsed,
    parse(text_at(i)).node,
    text_at(i),
    import_targets(whole, i),
    o,
    |module: Bytes, n: Bytes| owner_interfaces_in(exports, module, n),
    |_: Bytes| visible_modules(whole, i),
  );
  match checked_owner(source, InRoot, placing, reading).pulled.out {
    Rejected(ds) -> rejected_alone(Bytes::concat_all([parsed.name, b".", o]), "checks", ds),
    Analysed(w) -> w,
  }
}

fn per_owner(
  whole: Analysis,
  sources: List<Source>,
  shipped: List<Source> = [],
) -> List<{ owner: Bytes, whole: Agreed, apart: Agreed }> / {abort.raise} = {
  let texts = sources.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, s: Source|
    accumulator.insert(s.name, s.source_text));
  range(0, whole.modules.len()).fold(
    [],
    |accumulator: List<{ owner: Bytes, whole: Agreed, apart: Agreed }>, i: Int| {
      let parsed = whole.modules.get(i);
      let name = parsed.name;
      match texts.get(name) {
        None -> accumulator,
        Some(text) -> {
          let raw = parse(text).node;
          let functions = function_owners(raw, parsed);
          let owned_by = |o: Bytes, n: Bytes| functions.get(simple_of(name, n)) == Some(o);
          let owners = raw.items.fold(Map::new(), |m: Map<Bytes, Bytes>, item: Item|
            match item { FunctionItem(d) -> m.insert(d.name.name, d.name.name), _ -> m }).values(
          );
          owners.fold(
            accumulator,
            |a: List<{ owner: Bytes, whole: Agreed, apart: Agreed }>, o: Bytes| {
              let apart = checked_alone(whole, sources, i, o, shipped: shipped);
              a.push({
                owner: Bytes::concat_all([name, b".", o]),
                whole: agreed_owner(whole, name, |n: Bytes| owned_by(o, n)),
                apart: agreed_owner(apart, name, |n: Bytes| owned_by(o, n)),
              })
            },
          )
        },
      }
    },
  )
}

test "a test checked alone gets the same name as in its module, even when an earlier test has the same label" {
  let source = b"test \"holds {n}\" for n: Int in [1] { assert(n > 0) }\n\n// the second\ntest \"holds {n}\" for n: Int in [2] { assert(n > 0) }\n";
  let sources = [{ name: b"m", source_text: source }];
  let shipped = [
    {
      name: b"std.cases",
      source_text: b"pub type Table<a> = List<a>\npub fn listed<a | e>(t: List<a>, l: (a) -> String / e) -> List<{ label: String, identity: Bytes }> / e where derivable(hash, a) = t.map(|c: a| { label: l(c), identity: b\"\" })\npub fn chosen<a>(t: List<a>, at: Int, d: Bytes) -> a / {abort.raise} where derivable(hash, a) = panic(\"\")\n",
    },
    { name: b"std.show", source_text: b"pub fn display<a>(x: a) -> String = \"\"\n" },
  ];
  let whole = outcome(analyse_pulling_std_with(sources, shipped, no_rows()));
  let m = range(0, whole.modules.len()).fold(0, |k: Int, j: Int|
    if whole.modules.get(j).name == b"m" { j } else { k });
  let keys = |w: Analysis|
    w.checked.tests.filter(|t: TestInfo| t.module == b"m").map(|t: TestInfo| t.key);
  assert_eq(keys(whole), [b"m.holds {n}", b"m.holds {n} (2)"]);
  assert_eq(
    [b"test holds {n}", b"test holds {n} (2)"].map(|o: Bytes|
      keys(checked_alone(whole, sources, m, o, shipped: shipped))),
    [[b"m.holds {n}"], [b"m.holds {n} (2)"]],
  )
}

test "each function checked alone against the interfaces of what it uses returns the same result as checking its whole module" {
  let sources = [
    { name: b"core", source_text: core_source() },
    { name: b"shop", source_text: shop_source() },
  ];
  let found = per_owner(outcome(analyse_pulling_std_with(sources, [], no_rows())), sources);
  assert_eq(found.map(|f: { owner: Bytes, whole: Agreed, apart: Agreed }| f.owner), [
    b"core.helper",
    b"core.price",
    b"core.twice",
    b"shop.doubled",
    b"shop.stored",
    b"shop.total",
  ]);
  for_all(found, |f: { owner: Bytes, whole: Agreed, apart: Agreed }| {
    assert_eq(f.owner, f.owner);
    assert_eq(f.apart, f.whole)
  })
}

fn rejected_alone<a>(name: Bytes, what: String, ds: List<Diagnostic>) -> a / {abort.raise} =
  panic(
    "module `" ++ String::of_bytes_lossy(name) ++ "` " ++ what ++ " apart: "
      ++ String::of_bytes_lossy(
        Bytes::concat_all(
          ds.map(|d: Diagnostic| Bytes::concat_all([d.code, b" ", d.message, b"; "])),
        ),
      ),
  )

fn core_source() -> Bytes =
  b"pub type Money = Int\npub type Item =\n  | Book(String, Money)\n  | Note(String)\npub effect db {\n  read get[r](key: Int) -> Int\n  write put[r](key: Int, value: Int) -> Int\n}\n/// The price.\npub fn price(i: Item) -> Money =\n  match i {\n    Book(_, p) -> p,\n    Note(_) -> 0,\n  }\npub fn twice<a>(x: a, f: (a) -> a) -> a = f(f(x))\nfn helper() -> Int = 7\ntest \"a note is free\" {\n  assert_eq(price(Note(\"n\")), 0)\n}\n"

fn shop_source() -> Bytes =
  b"import core\nfn total(items: List<core::Item>) -> Int =\n  items.fold(0, |acc, i: core::Item| acc + core::price(i))\nfn doubled(n: Int) -> Int = core::twice(n, |x: Int| x + x)\nfn stored(k: Int) -> Int / {core::db.read[cart]} = core::db.get[cart](k)\ntest \"it adds up\" {\n  assert_eq(total([core::Book(\"b\", 3), core::Note(\"n\")]), 3)\n}\n"

fn likeness_source() -> Bytes = b"pub fn derive(declaration: Bytes) -> Bytes = declaration\n"

fn kinds_source() -> Bytes =
  b"import likeness\npub type Shape =\n  | Dot\n  | Line(Int)\npub type Pair = { left: Shape, right: Shape }\nderive likeness for Shape\nderive likeness for Pair\npub fn same(a: Pair, b: Pair) -> Bool = pair_alike(a, b)\n"

fn kinds_derived() -> List<ModuleDerivations> =
  [
    {
      module: b"kinds",
      derivations: [
        {
          deriver: b"likeness",
          target: b"Shape",
          written: [
            b"pub fn shape_alike(a: Shape, b: Shape) -> Bool = a == b",
            b"pub fn shape_order(a: Shape, b: Shape) -> Ordering = compare(a, b)",
          ],
        },
        {
          deriver: b"likeness",
          target: b"Pair",
          written: [b"pub fn pair_alike(a: Pair, b: Pair) -> Bool = a == b"],
        },
      ],
    },
  ]

fn sorter_source() -> Bytes =
  b"import kinds\nfn alike(a: kinds::Shape, b: kinds::Shape) -> Bool = kinds::shape_alike(a, b)\nfn order(a: kinds::Shape, b: kinds::Shape) -> Ordering = kinds::shape_order(a, b)\nfn paired(a: kinds::Shape) -> Bool = kinds::same({ left: a, right: a }, { left: a, right: a })\n"

test "an interface lists a `derive` as the signatures of the functions it generates, without bodies, and checks against it give the same result as checking the whole program" {
  let sources = [
    { name: b"likeness", source_text: likeness_source() },
    { name: b"kinds", source_text: kinds_source() },
    { name: b"sorter", source_text: sorter_source() },
  ];
  let whole = outcome(analyse_pulling_std_with(sources, [], no_rows(), derived: kinds_derived()));
  let kinds = range(0, whole.modules.len()).fold(0, |k: Int, i: Int|
    if whole.modules.get(i).name == b"kinds" { i } else { k });
  let shape = match exports_of(whole, kinds, kinds_source()).entries.get(b"Shape") {
    Some(e) -> e.text,
    None -> b"",
  };
  assert(shape.index_of(b"pub type Shape") != None);
  assert(shape.index_of(b"fn shape_alike(") != None);
  assert(shape.index_of(b"fn shape_order(") != None);
  assert_eq(shape.index_of(b"derive"), None);
  assert_eq(shape.index_of(b"=="), None);
  for_all(
    per_module(whole, sources),
    |f: { module: Bytes, whole: Agreed, apart: Agreed, hashed: CachedHashes, rehashed: CachedHashes }| {
      assert_eq(f.apart, f.whole);
      assert_eq(f.rehashed, f.hashed)
    },
  );
  let apart = per_owner(whole, sources);
  assert_eq(apart.map(|f: { owner: Bytes, whole: Agreed, apart: Agreed }| f.owner), [
    b"likeness.derive",
    b"kinds.same",
    b"sorter.alike",
    b"sorter.order",
    b"sorter.paired",
  ]);
  for_all(apart, |f: { owner: Bytes, whole: Agreed, apart: Agreed }| assert_eq(f.apart, f.whole))
}

fn rows_source() -> Bytes =
  b"import std.sql\npub type Line = { sku: String, count: Int }\nderive sql for Line\npub fn columns() -> Int = line_width()\n"

fn report_source() -> Bytes =
  b"import rows\nfn width() -> Int = rows::line_width() + rows::columns()\n"

fn rows_derived() -> List<ModuleDerivations> =
  [
    {
      module: b"rows",
      derivations: [
        { deriver: b"sql", target: b"Line", written: [b"pub fn line_width() -> Int = 2"] },
      ],
    },
  ]

test "a type's interface includes its `derive sql` line, so a definition checked alone matches the whole program" {
  let sources = [
    { name: b"rows", source_text: rows_source() },
    { name: b"report", source_text: report_source() },
  ];
  let shipped = [{ name: b"std.sql", source_text: likeness_source() }];
  let whole = outcome(
    analyse_pulling_std_with(sources, shipped, no_rows(), derived: rows_derived()),
  );
  let rows = range(0, whole.modules.len()).fold(0, |k: Int, i: Int|
    if whole.modules.get(i).name == b"rows" { i } else { k });
  match exports_of(whole, rows, rows_source()).entries.get(b"Line") {
    Some(e) -> {
      assert(e.text.index_of(b"derive sql for Line") != None, Some(String::of_bytes_lossy(e.text)));
      assert_eq(e.derived, rows_derived().get(0).derivations)
    },
    None -> panic("`rows` exports no interface for `Line`"),
  };
  let apart = per_owner(whole, sources, shipped: shipped);
  assert_eq(apart.map(|f: { owner: Bytes, whole: Agreed, apart: Agreed }| f.owner).sort(), [
    b"report.width",
    b"rows.columns",
  ]);
  for_all(apart, |f: { owner: Bytes, whole: Agreed, apart: Agreed }| assert_eq(f.apart, f.whole))
}

test "each module checked and hashed against the interfaces of its imports gives the same results as the whole program" {
  let sources = [
    { name: b"core", source_text: core_source() },
    { name: b"shop", source_text: shop_source() },
  ];
  let found = per_module(outcome(analyse_pulling_std_with(sources, [], no_rows())), sources);
  assert_eq(
    found.map(
      |f: { module: Bytes, whole: Agreed, apart: Agreed, hashed: CachedHashes, rehashed: CachedHashes }|
        f.module,
    ),
    [b"core", b"shop"],
  );
  for_all(
    found,
    |f: { module: Bytes, whole: Agreed, apart: Agreed, hashed: CachedHashes, rehashed: CachedHashes }| {
      assert_eq(f.apart, f.whole);
      assert_eq(f.rehashed, f.hashed)
    },
  )
}

test "an interface's header can be read from its encoded bytes alone, and the bytes include its dependency digest" {
  let sources = [
    { name: b"core", source_text: core_source() },
    { name: b"shop", source_text: shop_source() },
  ];
  let whole = outcome(analyse_pulling_std_with(sources, [], no_rows()));
  let entries = range(0, whole.modules.len()).fold(
    [],
    |accumulator: List<OwnerInterface>, i: Int|
      sources.fold(accumulator, |a: List<OwnerInterface>, s: Source|
        if whole.modules.get(i).name != s.name { a } else {
          exports_of(whole, i, s.source_text).entries.fold(
            a,
            |b: List<OwnerInterface>, _: Bytes, e: OwnerInterface| b.push(e),
          )
        }),
  );
  assert(entries.len() > 4);
  for_all(entries, |e: OwnerInterface| {
    let b = bin::encode(e, owner_interface_bin());
    assert_eq(interface_header(b), interface_header_of(e));
    assert_eq(
      with_reach_digest(b, b"reached"),
      bin::encode({ ..e, transitive_digest: b"reached" }, owner_interface_bin()),
    )
  })
}

fn for_all<a>(xs: List<a>, f: (a) -> Unit / {abort.raise}) -> Unit / {abort.raise} =
  xs.fold((), |_: Unit, x: a| f(x))

fn mentions_in(text: Bytes) -> List<Bytes> / {abort.raise} =
  distinct(
    mentioned(
      {
        module: b"here",
        binders: Map::new().insert(b"lib", b"deep.lib"),
        selected: Map::new().insert(b"Shape", [b"shapes"]),
        owners: [b"Stack", b"::push", b"depth"].fold(
          Map::new(),
          |accumulator: Map<Bytes, List<Bytes>>, n: Bytes| accumulator.insert(n, [n]),
        ),
      },
      text,
    ),
  ).map(|m: Mention| Bytes::concat_all([m.module, b" ", m.name]))

test "a method call records only the method name, a call to a type's function records the type too, and an effect operation call records nothing" {
  assert_eq(
    mentions_in(
      b"fn f(xs: Stack) -> Int / {abort.raise} = { abort.raise(1); xs.push(2).depth() + lib::made().area() }",
    ),
    [b" area", b" depth", b" push", b"deep.lib made", b"here ::push", b"here Stack"],
  );
  assert_eq(mentions_in(b"fn g() -> Int = Shape::unit().area() + Stack::depth(Stack::new())"), [
    b" area",
    b" depth",
    b" new",
    b"here Stack",
    b"here Stack::depth",
    b"here Stack::new",
    b"shapes Shape",
    b"shapes Shape::unit",
  ]);
  assert_eq(mentions_in(b"fn h(b: Bytes) -> Bytes = Bytes::push(Bytes::trimmed(b), 0)"), [
    b" push",
    b" trimmed",
    b"here ::push",
  ])
}

test "`==`, `digest` and `assert_eq` depend on the functions generated for containers, but `<` and `observe` do not" {
  let written = emitted_code().calls.map(|n: Bytes| Bytes::concat_all([prelude_module(), b" ", n]));
  assert_eq(mentions_in(b"fn f(a: Int, b: Int) -> Bool = a == b"), written);
  assert_eq(mentions_in(b"fn f(a: Int, b: Int) -> Bool = a != b"), written);
  assert_eq(mentions_in(b"fn f(a: Int) -> Bytes = digest(a)"), written);
  assert_eq(mentions_in(b"fn f(a: Int, b: Int) -> Bool = a < b"), []);
  assert_eq(mentions_in(b"fn f(a: Int) -> Unit / {abort.raise} = assert_eq(a, 1)"), written);
  assert_eq(mentions_in(b"fn f(a: Int) -> Int = observe(a)"), []);
  assert_eq(mentions_in(b"const fn f() -> Int = 1"), [])
}

test "a map literal depends on the same functions as a call to `Map::of_entries`" {
  assert_eq(
    mentions_in(b"fn f() -> Map<Int, Int> = #{1: 2}"),
    mentions_in(b"fn f() -> Map<Int, Int> = Map::of_entries([{ key: 1, value: 2 }])"),
  );
  let marshalling = emitted_code().calls.concat(emitted_code().insert_calls).map(|n: Bytes|
    Bytes::concat_all([prelude_module(), b" ", n]));
  assert_eq(mentions_in(b"fn f() -> Map<Int, Int> = #{}"), [b" of_entries"].concat(marshalling));
  assert(mentions_in(b"fn f() -> String = f\"{#{1: 2}}\"").contains(b" of_entries"), None)
}

test "a container type name depends on the container conversion functions, except inside the prelude" {
  let marshalling = emitted_code().calls.concat(emitted_code().insert_calls).map(|n: Bytes|
    Bytes::concat_all([prelude_module(), b" ", n]));
  assert_eq(mentions_in(b"fn f(xs: List<Int>) -> Int = 0"), marshalling);
  assert_eq(mentions_in(b"fn f(n: Int) -> Int = n"), []);
  assert_eq(written_mentions(prelude_module(), lex(b"List<Int>").tokens, 0), [])
}

test "an effect operation's type parameters depend on the container conversion functions, since they may be instantiated with a container" {
  let marshalling = emitted_code().calls.concat(emitted_code().insert_calls).map(|n: Bytes|
    Bytes::concat_all([prelude_module(), b" ", n]));
  assert_eq(mentions_in(b"effect box {\n  write put<a>(x: a) -> Unit\n}\n"), marshalling);
  assert_eq(mentions_in(b"effect box {\n  read take[k]<a>() -> a\n}\n"), marshalling);
  assert_eq(
    mentions_in(b"effect box {\n  write swap<a, b>(x: a, y: b) -> (b, a)\n}\n"),
    marshalling,
  );
  assert_eq(mentions_in(b"effect box {\n  write put(x: Int) -> Unit\n}\n"), []);
  assert_eq(mentions_in(b"fn f(read: Int, x: Int) -> Bool = read < x"), [])
}

test "a call on a locally bound name depends only on the called function's name, however the name is bound" {
  for_all(
    [
      b"fn f(x: T) -> Int = x.go()",
      b"fn f() -> Int = { let x = make(); x.go() }",
      b"fn f(xs: List<T>) -> List<Int> = each(xs, |x| x.go())",
      b"fn f(o: Option<T>) -> Int = match o { Some(x) -> x.go(), None -> 0 }",
      b"fn f(p: P) -> Int = { let { x } = p; x.go() }",
      b"fn f(l: List<T>) -> Int = match l { [x, ..rest] -> x.go[r](), [] -> 0 }",
    ],
    |text: Bytes|
      assert_eq(mentions_in(text).filter(|m: Bytes| !m.starts_with(prelude_module())), [b" go"]),
  );
  assert_eq(mentions_in(b"fn f() -> Int / {x.go} = x.go() + lib::x.go()"), [b"deep.lib x"]);
  assert_eq(mentions_in(b"fn f() -> Int = (limits.go)() + size(limits.most)"), [b" go"])
}

test "a definition's tokens, with or without its signature, equal the tokens from lexing its source texts joined, and give the same mentions" {
  let source = b"import std.list\npub type Shape =\n  | Dot\n  | Line(Int)\npub fn size(s: Shape) -> Int =\n  match s {\n    Dot -> 0,\n    Line(n) -> abs(n),\n  }\npub transparent fn twice(n: Int) -> Int = n + n\nfn named(s: Shape) -> String = \"shape of {size(s)}\"\nfn listed(xs: List<Int>) -> Int = {\n  let ys = List::rotate(xs, 1);\n  ys.len() + twice(1)\n}\nfn small() -> Set<Int> = #[1, 2]\ntest \"the size of a line of {n}\" for n: Int in [1, 2] {\n  assert_eq(size(Line(n)), n)\n}\n";
  let parsed = parse_at(0, { name: b"m", source_text: source }).module;
  let raw = parse(source).node;
  let tokens = lex(source).tokens;
  let scope = module_scope(parsed, raw, raw.imports.map(import_path));
  let kinds = |ts: List<Token>| ts.map(|t: Token| t.kind);
  let reads = owner_texts(parsed, raw, source);
  assert_eq(reads.len(), 7);
  for_all(reads, |o: OwnerText|
    for_all(
      [
        { read: o, lexed: owner_tokens(tokens, o) },
        { read: signature_text(raw, o), lexed: signature_tokens(raw, tokens, o) },
      ],
      |r: { read: OwnerText, lexed: List<Token> }| {
        let joined = Bytes::join(r.read.texts, b"\n\n");
        let alone = lex(joined).tokens;
        assert_eq(kinds(r.lexed), kinds(alone));
        assert_eq(
          owner_mentions(b"m", scope, r.read, source, r.lexed),
          owner_mentions(b"m", scope, r.read, joined, alone),
        )
      },
    ))
}
