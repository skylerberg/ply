pub type Mention = { module: Bytes, name: Bytes }

pub fn any_module_name(name: Bytes) -> Bytes = b"::".concat(name)

pub fn called_of(modules: List<Bytes>, names: List<Bytes>) -> List<Mention> =
  modules.fold([], |accumulator: List<Mention>, m: Bytes|
    names.fold(accumulator, |a: List<Mention>, n: Bytes|
      a.push({ module: m, name: any_module_name(n) })))

pub type OwnerInterface = {
  owner: Bytes,
  mentions: List<Mention>,
  text: Bytes,
  imports: List<ImportDeclaration>,
  rows: List<KnownDefinitionRow>,
  derived: List<Derivation>,
}

pub type Exports = {
  module: Bytes,
  owners: Map<Bytes, List<Bytes>>,
  entries: Map<Bytes, OwnerInterface>,
}

derive bin for Mention
derive bin for OwnerInterface
derive bin for Exports
derive bin for Scope
derive bin for ModuleScope
derive bin for OwnerText
derive bin for ItemAt

fn undocumented_variant(v: VariantDefinition) -> VariantDefinition = { ..v, doc: None }

fn undocumented_operation(o: OperationDefinition) -> OperationDefinition = { ..o, doc: None }

fn interface_item(item: Item) -> Item =
  match item {
    FunctionItem(d) ->
      FunctionItem({
        ..d,
        doc: None,
        body: if d.transparent != None { d.body }
        else { BlockExpression({ span: expression_span(d.body), tail: None, statements: [] }) },
      }),
    TypeItem(d) ->
      TypeItem({
        ..d,
        doc: None,
        field_docs: [],
        body: match d.body { SumBody(vs) -> SumBody(vs.map(undocumented_variant)), other -> other },
      }),
    EffectItem(d) ->
      EffectItem({ ..d, doc: None, operations: d.operations.map(undocumented_operation) }),
    SchemaItem(d) -> SchemaItem({ ..d, doc: None }),
    EffectSetItem(d) -> EffectSetItem({ ..d, doc: None }),
    ExternItem(d) -> ExternItem({ ..d, doc: None }),
    other -> other,
  }

fn binder_of(d: ImportDeclaration) -> Option<Bytes> =
  match d.kind {
    WholeModule -> match d.path.at(d.path.len() - 1) { Some(i) -> Some(i.name), None -> None },
    ModuleAlias(a) -> Some(a.name),
    SelectedNames(_) -> None,
  }

pub type Scope = {
  module: Bytes,
  binders: Map<Bytes, Bytes>,
  selected: Map<Bytes, List<Bytes>>,
  owners: Map<Bytes, List<Bytes>>,
}

fn scope_of(
  module: Bytes,
  imports: List<ImportDeclaration>,
  targets: List<Bytes>,
  owners: Map<Bytes, List<Bytes>>,
) -> Scope / {abort.raise} =
  range(0, min(imports.len(), targets.len())).fold(
    { module: module, binders: Map::new(), selected: Map::new(), owners: owners },
    |s: Scope, i: Int| {
      let d = imports.get(i);
      let target = targets.get(i);
      match d.kind {
        SelectedNames(ns) ->
          {
            ..s,
            selected: ns.fold(s.selected, |accumulator: Map<Bytes, List<Bytes>>, n: Identifier|
              listed_under(accumulator, n.name, target)),
          },
        _ -> match binder_of(d) {
          Some(b) ->
            {
              ..s,
              binders: s.binders.insert(b, target),
              selected: implicitly_imported_by(b).fold(
                s.selected,
                |accumulator: Map<Bytes, List<Bytes>>, n: Bytes|
                  if s.owners.contains(n) || accumulator.contains(n) { accumulator }
                  else { listed_under(accumulator, n, target) },
              ),
            },
          None -> s,
        },
      }
    },
  )

pub fn mention_key(m: Mention) -> Bytes = Bytes::concat_all([m.module, b"\x00", m.name])

fn distinct(ms: List<Mention>) -> List<Mention> =
  ms.fold(Map::new(), |accumulator: Map<Bytes, Mention>, m: Mention|
    accumulator.insert(mention_key(m), m)).fold(
    [],
    |accumulator: List<Mention>, _: Bytes, m: Mention| accumulator.push(m),
  )

fn identifier_at(tokens: List<Token>, i: Int) -> Option<Bytes> =
  if i < 0 { None } else {
    match tokens.at(i) {
      Some(t) -> match t.kind { Identifier(n) -> Some(n), _ -> None },
      None -> None,
    }
  }

fn punct_at(tokens: List<Token>, i: Int, p: Bytes) -> Bool =
  if i < 0 { false }
  else { match tokens.at(i) { Some(t) -> t.kind == Punctuation(p), None -> false } }

fn tags(tokens: List<Token>, i: Int) -> Bool =
  match ((tokens.at(i), tokens.at(i + 1))) {
    (Some(name), Some(next)) ->
      name.end == next.start
        && (match next.kind {
          StringLiteral(_) -> true,
          InterpolatedHead(_) -> true,
          LineString(_) -> true,
          _ -> false,
        }),
    _ -> false,
  }

fn called_on_value(
  scope: Scope,
  tokens: List<Token>,
  bound: Set<Bytes>,
  i: Int,
) -> Bool / {abort.raise} = {
  let after = iterate(i + 1, tokens.len() + 1, |j: Int|
    if punct_at(tokens, j, b"rparen") { Continue(j + 1) } else { Stop(j) });
  (punct_at(tokens, after, b"lparen") || punct_at(tokens, after, b"lbracket"))
    && (after > i + 1
    || (match identifier_at(tokens, i - 2) {
      None -> true,
      Some(base) ->
        punct_at(tokens, i - 3, b"dot") || punct_at(tokens, i - 3, b"coloncolon")
          || bound.contains(base)
          || scope.owners.contains(base)
          || scope.selected.contains(base),
    }))
}

fn on_value(scope: Scope, name: Bytes) -> List<Mention> =
  [{ module: b"", name: name }].concat(if scope.owners.contains(any_module_name(name)) {
    [{ module: scope.module, name: any_module_name(name) }]
  } else { [] })

fn of_type(scope: Scope, of: Bytes, name: Bytes) -> List<Mention> = {
  let selected = match scope.selected.get(of) { Some(ms) -> ms, None -> [] };
  let homes = List::concat(if scope.owners.contains(of) { [scope.module] } else { [] }, selected);
  let declared = homes.fold([], |accumulator: List<Mention>, m: Bytes|
    accumulator.push({ module: m, name: of }).push({ module: m, name: member_name(of, name) }));
  if selected.len() == 0 && starts_upper(of) { declared.concat(on_value(scope, name)) }
  else { declared }
}

fn binder_mentions(scope: Scope, binder: Bytes, name: Bytes) -> List<Mention> =
  match scope.binders.get(binder) {
    Some(m) -> [{ module: m, name: name }],
    None -> of_type(scope, binder, name),
  }

fn schema_parts(tokens: List<Token>, at: Int, name: Bytes) -> List<Bytes> =
  if punct_at(tokens, at - 1, b"eq") && word_at(tokens, at - 3, b"law") {
    [name, schema_guard_name(name)]
  } else { [name] }

fn word_at(tokens: List<Token>, i: Int, word: Bytes) -> Bool =
  if i < 0 { false } else {
    match tokens.at(i) {
      Some(t) -> t.kind == Identifier(word) || t.kind == Keyword(word),
      None -> false,
    }
  }

fn mentioned(scope: Scope, text: Bytes) -> List<Mention> / {abort.raise} =
  mentioned_in(scope, lex(text).tokens)

fn mentioned_in(scope: Scope, tokens: List<Token>) -> List<Mention> / {abort.raise} = {
  let bound = bound_names(tokens);
  range(0, tokens.len()).fold([], |was: List<Mention>, i: Int| {
    let accumulator = was.concat(written_mentions(scope.module, tokens, i));
    match identifier_at(tokens, i) {
      None -> if punct_at(tokens, i, b"hashbrace") {
        accumulator.concat(binder_mentions(scope, map_literal_call.binder, map_literal_call.name))
      } else { accumulator },
      Some(n) -> if punct_at(tokens, i - 1, b"coloncolon") {
        match identifier_at(tokens, i - 2) {
          Some(b) ->
            accumulator.concat(
              schema_parts(tokens, i - 2, n).flat_map(|p: Bytes| binder_mentions(scope, b, p)),
            ),
          None -> accumulator,
        }
      } else if punct_at(tokens, i - 1, b"dot") {
        if !called_on_value(scope, tokens, bound, i) { accumulator }
        else { accumulator.concat(on_value(scope, n)) }
      } else if punct_at(tokens, i + 1, b"coloncolon") { accumulator } else if tags(tokens, i) {
        match scope.binders.get(n) {
          Some(m) ->
            accumulator.concat(
              [b"literal", b"compile", b"fill"].map(|f: Bytes| { module: m, name: f }),
            ),
          None -> accumulator,
        }
      } else {
        schema_parts(tokens, i, n).fold(accumulator, |found: List<Mention>, p: Bytes| {
          let own = if scope.owners.contains(p) { found.push({ module: scope.module, name: p }) }
          else { found };
          match scope.selected.get(n) {
            Some(ms) -> own.concat(ms.map(|m: Bytes| { module: m, name: p })),
            None -> own,
          }
        })
      },
    }
  })
}

fn written_mentions(module: Bytes, tokens: List<Token>, i: Int) -> List<Mention> = {
  let called = match tokens.at(i) {
    Some(t) -> match t.kind {
      Punctuation(p) -> if emitted_code.tokens.contains(p) { emitted_code.calls }
      else if opens_own_types(tokens, i) { marshalling_calls(module) }
      else { [] },
      Identifier(n) ->
        emitted_calls_for(n).concat(marshalling_calls_for(module, n)).concat(lowered_calls_for(n)),
      _ -> [],
    },
    None -> [],
  };
  let scheduled = match identifier_at(tokens, i) {
    Some(n) -> if n == b"simulate" { [{ module: scheduler_module, name: b"simulated" }] }
    else if marshalling_operations.contains(n) && punct_at(tokens, i - 1, b"dot")
        && identifier_at(tokens, i - 2) == Some(b"task") {
      [{ module: scheduler_module, name: crossing_function(n) }]
    } else { [] },
    None -> [],
  };
  called.map(|n: Bytes| { module: prelude_module, name: n }).concat(scheduled)
}

fn opens_own_types(tokens: List<Token>, i: Int) -> Bool = {
  let moded = |j: Int|
    match identifier_at(tokens, j) {
      Some(m) -> m == b"read" || m == b"write" || m == b"raise",
      None -> false,
    };
  let named = |j: Int| identifier_at(tokens, j) != None;
  punct_at(tokens, i, b"lt")
    && ((named(i - 1) && moded(i - 2))
    || (punct_at(tokens, i - 1, b"rbracket") && named(i - 2) && punct_at(tokens, i - 3, b"lbracket")
    && named(i - 4)
    && moded(i - 5)))
}

fn hidden_import_mentions(text: Bytes) -> List<Mention> / {abort.raise} =
  hidden_of(match header(text) { Some(m) -> m, None -> parse(text).node })

fn implicit_mentions(
  source: Bytes,
  tokens: List<Token>,
  text: () -> Bytes / {abort.raise},
) -> List<Mention> / {abort.raise} = {
  let s = start_from_tokens(source, tokens);
  hidden_of(match header_of(s.input, s.parser) { Some(m) -> m, None -> parse(text()).node })
}

fn hidden_of(raw: Module) -> List<Mention> =
  raw.imports.fold([], |accumulator: List<Mention>, d: ImportDeclaration|
    if is_explicit_import(d) || imports_implicit_names(d) { accumulator } else {
      let module = import_path(d);
      hidden_callees(binder_of(d).unwrap_or(b"")).fold(
        accumulator.push({ module: module, name: b"" }),
        |found: List<Mention>, name: Bytes| found.push({ module: module, name: name }),
      )
    })

fn imports_implicit_names(d: ImportDeclaration) -> Bool =
  match d.kind { ModuleAlias(a) -> implicitly_imported_by(a.name) != [], _ -> false }

fn is_generated_derive(raw: Module, item: Item) -> Bool =
  match item { DeriveItem(d) -> deriver_module(raw, d.deriver) != Some(b"std.sql"), _ -> false }

fn derivations_of(parsed: ParsedModule, items: List<Item>) -> List<Derivation> =
  items.fold([], |accumulator: List<Derivation>, item: Item|
    match item {
      DeriveItem(d) -> match parsed.derived.find(|x: DeriveOrigin| x.span == d.span) {
        Some(x) -> accumulator.push(derivation_of(x)),
        None -> accumulator,
      },
      _ -> accumulator,
    })

fn deriver_modules_of(raw: Module, items: List<Item>) -> List<Bytes> =
  items.fold([], |accumulator: List<Bytes>, item: Item|
    match item {
      DeriveItem(d) -> if is_generated_derive(raw, item) { accumulator } else {
        match deriver_module(raw, d.deriver) {
          Some(m) -> if accumulator.contains(m) { accumulator } else { accumulator.push(m) },
          None -> accumulator,
        }
      },
      _ -> accumulator,
    })

fn unpositioned(name: Identifier) -> Identifier = { ..name, span: generated_span }

fn import_order_key(d: ImportDeclaration) -> Bytes = {
  let names = |ns: List<Identifier>| Bytes::join(ns.map(|n: Identifier| n.name), b",");
  Bytes::concat_all([
    names(d.path),
    match d.kind {
      WholeModule -> b"",
      ModuleAlias(name) -> b" as ".concat(name.name),
      SelectedNames(ns) -> b" names ".concat(names(ns)),
    },
  ])
}

fn canonical_imports(imports: List<ImportDeclaration>) -> List<ImportDeclaration> =
  imports.fold(Map::new(), |found: Map<Bytes, ImportDeclaration>, d: ImportDeclaration|
    found.insert(import_order_key(d), {
      path: d.path.map(unpositioned),
      kind: match d.kind {
        WholeModule -> WholeModule,
        ModuleAlias(name) -> ModuleAlias(unpositioned(name)),
        SelectedNames(names) -> SelectedNames(names.map(unpositioned)),
      },
      span: generated_span,
    })).values(
  )

fn imports_for(
  imports: List<ImportDeclaration>,
  targets: List<Bytes>,
  mentions: List<Mention>,
  runtimes: List<Bytes>,
) -> List<ImportDeclaration> / {abort.raise} =
  imports_read(imports, targets, mentions, runtimes).map(|x: Imported| x.declaration)

pub type Imported = { declaration: ImportDeclaration, target: Bytes }

derive bin for Imported

pub fn imports_read(
  imports: List<ImportDeclaration>,
  targets: List<Bytes>,
  mentions: List<Mention>,
  runtimes: List<Bytes>,
) -> List<Imported> / {abort.raise} = {
  let named = mentions.fold(Set::empty(), |accumulator: Set<Bytes>, m: Mention|
    accumulator.insert(mention_key(m)));
  let modules = mentions.fold(Set::empty(), |accumulator: Set<Bytes>, m: Mention|
    accumulator.insert(m.module));
  range(0, min(imports.len(), targets.len())).fold([], |accumulator: List<Imported>, i: Int| {
    let d = imports.get(i);
    let target = targets.get(i);
    if !is_explicit_import(d) { accumulator }
    else if runtimes.contains(target) { accumulator.push({ declaration: d, target: target }) }
    else {
      match d.kind {
        SelectedNames(ns) -> {
          let mentioned_names = ns.filter(|n: Identifier|
            named.contains(mention_key({ module: target, name: n.name })));
          if mentioned_names.len() == 0 { accumulator } else {
            accumulator.push({
              declaration: { ..d, kind: SelectedNames(mentioned_names) },
              target: target,
            })
          }
        },
        _ -> if modules.contains(target) { accumulator.push({ declaration: d, target: target }) }
        else { accumulator },
      }
    }
  })
}

pub fn group_imports(
  module: Bytes,
  members: List<OwnerText>,
  mentions: List<Mention>,
  imports: List<ImportDeclaration>,
  targets: List<Bytes>,
) -> List<Imported> / {abort.raise} = {
  let names = members.map(|o: OwnerText| o.owner);
  imports_read(
    imports,
    targets,
    mentions.filter(|m: Mention| !(m.module == module && names.contains(m.name))),
    members.fold([], |accumulator: List<Bytes>, o: OwnerText| accumulator.concat(o.runtimes)),
  )
}

fn span_key(s: Span) -> Bytes = Bytes::concat_all([u64_le(s.start), u64_le(s.end)])

fn listed_under(m: Map<Bytes, List<Bytes>>, k: Bytes, v: Bytes) -> Map<Bytes, List<Bytes>> = {
  let had = match m.get(k) { Some(xs) -> xs, None -> [] };
  if had.contains(v) { m } else { m.insert(k, had.push(v)) }
}

pub fn function_owners(raw: Module, parsed: ParsedModule) -> Map<Bytes, Bytes> = {
  let stated = raw.items.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, item: Item|
    match owner_of(item) {
      Some(o) -> accumulator.insert(span_key(item_span(item)), o),
      None -> accumulator,
    });
  let written = raw.items.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, item: Item|
    match item {
      FunctionItem(f) -> accumulator.insert(f.name.name, f.name.name),
      _ -> accumulator,
    });
  parsed.module.items.fold(written, |accumulator: Map<Bytes, Bytes>, item: Item|
    match item {
      FunctionItem(f) -> if accumulator.contains(f.name.name) { accumulator } else {
        match stated.get(span_key(f.span)) {
          Some(o) -> accumulator.insert(f.name.name, o),
          None -> accumulator,
        }
      },
      _ -> accumulator,
    })
}

fn declares_builtin(raw: Module, parsed: ParsedModule, item: Item) -> Bool =
  match item { ExternItem(d) -> is_builtin(parsed.name, raw, d), _ -> false }

fn owners_in(raw: Module, parsed: ParsedModule) -> Map<Bytes, List<Bytes>> =
  owners_listed(raw, parsed, |_: Item| true)

pub fn value_owners(raw: Module, parsed: ParsedModule) -> Map<Bytes, List<Bytes>> =
  owners_listed(raw, parsed, |item: Item|
    match item { FunctionItem(_) -> true, ExternItem(_) -> true, _ -> false })

fn owners_listed(
  raw: Module,
  parsed: ParsedModule,
  names_a_value: (Item) -> Bool,
) -> Map<Bytes, List<Bytes>> = {
  let own = raw.items.fold(Map::new(), |accumulator: Map<Bytes, List<Bytes>>, item: Item|
    match if declares_builtin(raw, parsed, item) { None } else { owner_of(item) } {
      None -> accumulator,
      Some(o) -> {
        let named = if names_a_value(item) { listed_under(accumulator, o, o) } else { accumulator };
        match item {
          TypeItem(d) -> match d.body {
            SumBody(vs) ->
              vs.fold(named, |a: Map<Bytes, List<Bytes>>, v: VariantDefinition|
                listed_under(a, v.name.name, o)),
            _ -> named,
          },
          _ -> named,
        }
      },
    });
  function_owners(raw, parsed).fold(
    own,
    |accumulator: Map<Bytes, List<Bytes>>, f: Bytes, o: Bytes| listed_under(accumulator, f, o),
  )
}

fn named_in(raw: Module, parsed: ParsedModule) -> Map<Bytes, List<Bytes>> / {abort.raise} =
  function_owners(raw, parsed).fold(
    owners_in(raw, parsed),
    |accumulator: Map<Bytes, List<Bytes>>, f: Bytes, o: Bytes|
      match member_of(f) {
        Some(m) -> listed_under(accumulator, any_module_name(m.member), o),
        None -> accumulator,
      },
  )

fn generated_by_owner(
  raw: Module,
  parsed: ParsedModule,
  owners: Map<Bytes, Bytes>,
) -> Map<Bytes, List<Item>> = {
  let written = raw.items.fold(Set::empty(), |accumulator: Set<Bytes>, item: Item|
    match item { FunctionItem(f) -> accumulator.insert(f.name.name), _ -> accumulator });
  parsed.module.items.fold(Map::new(), |accumulator: Map<Bytes, List<Item>>, item: Item|
    match item {
      FunctionItem(f) -> if written.contains(f.name.name) { accumulator } else {
        match owners.get(f.name.name) {
          Some(o) ->
            accumulator.insert(
              o,
              List::push(match accumulator.get(o) { Some(xs) -> xs, None -> [] }, item),
            ),
          None -> accumulator,
        }
      },
      _ -> accumulator,
    })
}

pub fn named_node(name: Bytes) -> Mention / {abort.raise} = {
  let k = range(0, name.len()).fold(0 - 1, |accumulator: Int, i: Int|
    if name.at(i) == 46 { i } else { accumulator });
  if k < 0 { { module: b"", name: name } }
  else { { module: name.slice(0, k), name: name.slice(k + 1, name.len()) } }
}

fn simple_of(module: Bytes, name: Bytes) -> Bytes / {abort.raise} = {
  let prefix = module.concat(b".");
  if name.starts_with(prefix) { name.slice(prefix.len(), name.len()) } else { name }
}

fn grouped<a>(
  xs: List<a>,
  key: (a) -> Bytes / {abort.raise},
) -> Map<Bytes, List<a>> / {abort.raise} =
  xs.fold(Map::new(), |accumulator: Map<Bytes, List<a>>, x: a| {
    let k = key(x);
    accumulator.insert(k, List::push(match accumulator.get(k) { Some(ys) -> ys, None -> [] }, x))
  })

fn alone(text: Bytes, items: List<Item>) -> Bytes / {abort.raise} =
  Bytes::join(items.map(|item: Item| print_standalone(text, [], [item])), b"")

pub fn visible_modules(analysis: Analysis, i: Int) -> List<Bytes> / {abort.raise} =
  graph::breadth_first({ out: analysis.r.imports }, [i]).drop(1).map(|k: Int|
    analysis.modules.get(k).name)

pub fn import_targets(analysis: Analysis, i: Int) -> List<Bytes> / {abort.raise} =
  match analysis.r.imports.at(i) {
    Some(ts) -> ts.map(|t: Int| analysis.modules.get(t).name),
    None -> [],
  }

fn scopes(
  parsed: ParsedModule,
  raw: Module,
  targets: List<Bytes>,
) -> { written: Scope, expanded: Scope } / {abort.raise} = {
  let owners = named_in(raw, parsed);
  let added = parsed.module.imports.drop(raw.imports.len()).map(import_path);
  {
    written: scope_of(parsed.name, raw.imports, targets, owners),
    expanded: scope_of(parsed.name, parsed.module.imports, targets.concat(added), owners),
  }
}

fn unplaced_raise(r: Raise) -> Raise = { ..r, span: generated_span }

pub fn exports_of(analysis: Analysis, i: Int, text: Bytes) -> Exports / {abort.raise} = {
  let parsed = analysis.modules.get(i);
  exports_from(
    parsed,
    parse(text).node,
    text,
    import_targets(analysis, i),
    rows_of(analysis).definitions,
  )
}

pub fn exports_from(
  parsed: ParsedModule,
  raw: Module,
  text: Bytes,
  targets: List<Bytes>,
  definition_rows: List<KnownDefinitionRow>,
) -> Exports / {abort.raise} = {
  let module = parsed.name;
  let owners = named_in(raw, parsed);
  let functions = function_owners(raw, parsed);
  let mention_scopes = scopes(parsed, raw, targets);
  let fn_owner = |name: Bytes|
    match functions.get(simple_of(module, name)) { Some(o) -> o, None -> b"" };
  let rows = grouped(
    definition_rows.filter(|r: KnownDefinitionRow| is_declared_in(module, r.name)).map(
      |r: KnownDefinitionRow|
        { ..r, raises: r.raises.map(unplaced_raise), facts: CheckedElsewhere, value: None },
    ),
    |r: KnownDefinitionRow| fn_owner(r.name),
  );
  let items = grouped(raw.items.filter(|item: Item| owner_of(item) != None), |item: Item|
    match owner_of(item) { Some(o) -> o, None -> b"" });
  let generated = generated_by_owner(raw, parsed, functions);
  {
    module: module,
    owners: owners,
    entries: items.fold(
      Map::new(),
      |accumulator: Map<Bytes, OwnerInterface>, o: Bytes, its: List<Item>| {
        let stated = alone(
          text,
          its.filter(|item: Item| !is_generated_derive(raw, item)).map(interface_item),
        );
        let fs = match generated.get(o) { Some(fs) -> fs, None -> [] };
        let derives = its.fold(Set::empty(), |spans: Set<Bytes>, item: Item|
          if is_generated_derive(raw, item) { spans.insert(span_key(item_span(item))) }
          else { spans });
        let printed = stated.concat(
          alone(
            text,
            fs.filter(|f: Item| derives.contains(span_key(item_span(f)))).map(interface_item),
          ),
        );
        let expansion = if fs.len() == 0 { [] }
        else { mentioned(mention_scopes.expanded, alone(text, fs)) };
        let mentions = distinct(
          mentioned(mention_scopes.written, stated).concat(expansion).concat(
            hidden_import_mentions(printed),
          ),
        ).filter(|m: Mention| !(m.module == module && m.name == o));
        let runtimes = deriver_modules_of(raw, its);
        accumulator.insert(o, {
          owner: o,
          text: printed,
          imports: canonical_imports(
            imports_for(raw.imports, targets, mentions, runtimes).map(without_spans),
          ),
          mentions: mentions,
          rows: match rows.get(o) { Some(xs) -> xs, None -> [] },
          derived: derivations_of(parsed, its.filter(|item: Item| !is_generated_derive(raw, item))),
        })
      },
    ),
  }
}

pub fn imported_mentions_in(
  parsed: ParsedModule,
  raw: Module,
  text: Bytes,
  tokens: List<Token>,
  targets: List<Bytes>,
) -> List<Mention> / {abort.raise} = {
  let mention_scopes = scopes(parsed, raw, targets);
  let expansion = generated_by_owner(raw, parsed, function_owners(raw, parsed)).fold(
    [],
    |accumulator: List<Mention>, _: Bytes, fs: List<Item>|
      accumulator.concat(mentioned(mention_scopes.expanded, alone(text, fs))),
  );
  let selected = mention_scopes.written.selected.fold(
    [],
    |accumulator: List<Mention>, n: Bytes, ms: List<Bytes>|
      accumulator.concat(ms.map(|m: Bytes| { module: m, name: n })),
  );
  let runtimes = deriver_modules_of(raw, raw.items).map(|m: Bytes| { module: m, name: b"" });
  distinct(
    mentioned_in(mention_scopes.written, tokens).concat(expansion).concat(selected).concat(
      runtimes.concat(hidden_of(raw)),
    ),
  ).filter(|m: Mention| m.module != parsed.name)
}

pub fn imported_mentions_of(
  analysis: Analysis,
  i: Int,
  text: Bytes,
) -> List<Mention> / {abort.raise} = {
  let s = start(text);
  imported_mentions_in(
    analysis.modules.get(i),
    parse_started(s).node,
    text,
    s.input.tokens,
    import_targets(analysis, i),
  )
}

fn nowhere(i: Identifier) -> Identifier = { ..i, span: generated_span }

fn without_spans(d: ImportDeclaration) -> ImportDeclaration =
  {
    path: d.path.map(nowhere),
    kind: match d.kind {
      WholeModule -> WholeModule,
      ModuleAlias(a) -> ModuleAlias(nowhere(a)),
      SelectedNames(ns) -> SelectedNames(ns.map(nowhere)),
    },
    span: generated_span,
  }

fn import_key(d: ImportDeclaration) -> Bytes =
  Bytes::concat_all([
    import_path(d),
    match d.kind {
      WholeModule -> b"",
      ModuleAlias(a) -> b" as ".concat(a.name),
      SelectedNames(_) -> b" ()",
    },
  ])

fn merged_imports(imports: List<ImportDeclaration>) -> List<ImportDeclaration> / {abort.raise} = {
  let merged = imports.fold(
    { order: [], held: Map::new() },
    |a: { order: List<Bytes>, held: Map<Bytes, ImportDeclaration> }, d: ImportDeclaration| {
      let k = import_key(d);
      match a.held.get(k) {
        None -> { order: a.order.push(k), held: a.held.insert(k, d) },
        Some(had) -> match ((had.kind, d.kind)) {
          (SelectedNames(xs), SelectedNames(ys)) -> {
            let names = ys.fold(xs, |ns: List<Identifier>, y: Identifier|
              if ns.fold(false, |b: Bool, n: Identifier| b || n.name == y.name) { ns }
              else { ns.push(y) });
            { ..a, held: a.held.insert(k, { ..had, kind: SelectedNames(names) }) }
          },
          _ -> a,
        },
      }
    },
  );
  merged.order.map(|k: Bytes|
    match merged.held.get(k) {
      Some(d) -> d,
      None -> panic("internal error: an import was merged but its merged result is missing"),
    })
}

pub type ModuleOrigin = | InRoot | InPackage(Int, Bytes) | ShippedModule

derive bin for ModuleOrigin

pub type CheckInputs = {
  packages: PackageSources,
  tested: Bool,
  checked_packages: Option<ValidatedPackages>,
  unread: List<Bytes>,
  all_sources: List<Source>,
  data: List<EmbedFile>,
  embeds: List<EmbedRecord>,
  given: List<ParsedSource>,
}

pub fn owner_items(raw: Module, owner: Bytes) -> List<Item> =
  raw.items.filter(|item: Item| item_owner(item) == owner)

pub type ModuleScope = { written: Scope, expanded: Scope }

pub type OwnerText = {
  owner: Bytes,
  texts: List<Bytes>,
  starts: List<Int>,
  generated: Bytes,
  runtimes: List<Bytes>,
  derived: List<Derivation>,
  names: List<Bytes>,
}

pub fn module_scope(
  parsed: ParsedModule,
  raw: Module,
  targets: List<Bytes>,
) -> ModuleScope / {abort.raise} = {
  let s = scopes(parsed, raw, targets);
  { written: s.written, expanded: s.expanded }
}

pub fn owner_texts(
  parsed: ParsedModule,
  raw: Module,
  text: Bytes,
) -> List<OwnerText> / {abort.raise} = {
  let generated = generated_by_owner(raw, parsed, function_owners(raw, parsed));
  let declared = owners_in(raw, parsed).fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Bytes>>, n: Bytes, os: List<Bytes>|
      os.fold(accumulator, |a: Map<Bytes, List<Bytes>>, o: Bytes| listed_under(a, o, n)),
  );
  let owners = raw.items.fold([], |os: List<Bytes>, item: Item| {
    let o = item_owner(item);
    if os.contains(o) || declares_builtin(raw, parsed, item) { os } else { os.push(o) }
  });
  owners.map(|o: Bytes| {
    let its = owner_items(raw, o);
    {
      owner: o,
      texts: its.map(|item: Item| text.slice(written_start(text, item), item_span(item).end)),
      starts: its.map(|item: Item| written_start(text, item)),
      generated: match generated.get(o) { Some(fs) -> alone(text, fs), None -> b"" },
      runtimes: deriver_modules_of(raw, its),
      derived: derivations_of(parsed, its),
      names: match declared.get(o) { Some(ns) -> ns, None -> [] },
    }
  })
}

pub fn signature_text(raw: Module, o: OwnerText) -> OwnerText / {abort.raise} = {
  let cuts = signature_ends(raw, o);
  {
    ..o,
    texts: range(0, o.texts.len()).map(|k: Int| {
      let written = o.texts.get(k);
      match cuts.get(k) {
        Some(c) -> written.slice(0, c - o.starts.get(k)).concat(b"{}"),
        None -> written,
      }
    }),
  }
}

fn signature_ends(raw: Module, o: OwnerText) -> List<Option<Int>> =
  owner_items(raw, o.owner).map(|item: Item|
    match item {
      FunctionItem(d) -> if d.transparent != None { None }
      else { Some(expression_span(d.body).start) },
      _ -> None,
    })

pub fn owner_tokens(tokens: List<Token>, o: OwnerText) -> List<Token> / {abort.raise} =
  read_tokens(tokens, o, o.texts.map(|_: Bytes| None))

pub fn signature_tokens(
  raw: Module,
  tokens: List<Token>,
  o: OwnerText,
) -> List<Token> / {abort.raise} = read_tokens(tokens, o, signature_ends(raw, o))

fn read_tokens(
  tokens: List<Token>,
  o: OwnerText,
  cuts: List<Option<Int>>,
) -> List<Token> / {abort.raise} = {
  let laid = range(0, o.texts.len()).fold(
    { tokens: [], end: 0 },
    |accumulator: { tokens: List<Token>, end: Int }, k: Int| {
      let from = o.starts.get(k);
      let cut = cuts.get(k);
      let to = match cut { Some(c) -> c, None -> from + o.texts.get(k).len() };
      let first = tokens.partition_point(|t: Token| t.start < from);
      let past = tokens.partition_point(|t: Token| t.start < to);
      let written = range(first, past).fold(accumulator.tokens, |ts: List<Token>, i: Int|
        ts.push(tokens.get(i)));
      match cut {
        Some(c) ->
          {
            tokens: written.push({ start: c, end: c + 1, kind: Punctuation(b"lbrace") }).push({
              start: c + 1,
              end: c + 2,
              kind: Punctuation(b"rbrace"),
            }),
            end: c + 2,
          },
        None -> { tokens: written, end: to },
      }
    },
  );
  laid.tokens.push({ start: laid.end, end: laid.end, kind: EndOfInput })
}

fn written_start(text: Bytes, item: Item) -> Int / {abort.raise} =
  iterate(item_span(item).start, 64, |s: Int| {
    let end = iterate(s, s + 1, |i: Int|
      if i > 0 && [9, 10, 13, 32].contains(text.at(i - 1)) { Continue(i - 1) } else { Stop(i) });
    let begin = iterate(end, end + 1, |i: Int|
      if i > 0 && is_identifier_start(text.at(i - 1)) { Continue(i - 1) } else { Stop(i) });
    let line = iterate(begin, begin + 1, |i: Int|
      if i > 0 && text.at(i - 1) != 10 { Continue(i - 1) } else { Stop(i) });
    if begin < end
        && [b"pub", b"const", b"transparent", b"reuse", b"opaque", b"nondet"].contains(
          text.slice(begin, end),
        )
        && text.slice(line, begin).index_of(b"//") == None { Continue(begin) }
    else { Stop(s) }
  })

pub fn owner_mentions(
  module: Bytes,
  scope: ModuleScope,
  o: OwnerText,
  source: Bytes,
  tokens: List<Token>,
) -> List<Mention> / {abort.raise} = {
  let expansion = if o.generated.len() == 0 { [] } else { mentioned(scope.expanded, o.generated) };
  let hidden = implicit_mentions(source, tokens, || Bytes::join(o.texts, b"\n\n"));
  distinct(mentioned_in(scope.written, tokens).concat(expansion).concat(hidden)).filter(
    |m: Mention| !(m.module == module && m.name == o.owner),
  )
}

pub fn owner_groups(
  module: Bytes,
  scope: ModuleScope,
  owners: List<Bytes>,
  mentions: Map<Bytes, List<Mention>>,
) -> List<List<Bytes>> / {abort.raise} = {
  let slot = range(0, owners.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
    accumulator.insert(owners.get(i), i));
  let out = owners.map(|o: Bytes|
    List::fold(
      match mentions.get(o) { Some(ms) -> ms, None -> [] },
      [],
      |accumulator: List<Int>, m: Mention|
        if m.module != module { accumulator } else {
          List::fold(
            match scope.written.owners.get(m.name) { Some(os) -> os, None -> [] },
            accumulator,
            |a: List<Int>, p: Bytes|
              match slot.get(p) { Some(k) -> if a.contains(k) { a } else { a.push(k) }, None -> a },
          )
        },
    ));
  graph::components({ out: out }).map(|comp: List<Int>|
    comp.map(|i: Int| owners.get(i)).sort_by(|a: Bytes, b: Bytes|
      match compare_values(a, b) { Greater -> false, _ -> true }))
}

pub fn call_cycles(
  owners: List<Bytes>,
  called: List<List<Bytes>>,
) -> List<List<Bytes>> / {abort.raise} = {
  let slot = range(0, owners.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
    accumulator.insert(owners.get(i), i));
  let out = called.map(|cs: List<Bytes>|
    cs.fold([], |accumulator: List<Int>, c: Bytes|
      match slot.get(c) {
        Some(k) -> if accumulator.contains(k) { accumulator } else { accumulator.push(k) },
        None -> accumulator,
      }));
  graph::components({ out: out }).map(|comp: List<Int>|
    comp.map(|i: Int| owners.get(i)).sort_by(|a: Bytes, b: Bytes|
      match compare_values(a, b) { Greater -> false, _ -> true }))
}

pub type ItemAt = { owner: Bytes, from: Int, to: Int, len: Int }

pub fn placed_position(items: List<ItemAt>, position: Int) -> Int =
  match items.find(|x: ItemAt| x.from <= position && position <= x.from + x.len) {
    Some(x) -> x.to + position - x.from,
    None -> position,
  }

fn items_by_owner(items: List<ItemAt>) -> Map<Bytes, List<ItemAt>> =
  items.fold(Map::new(), |found: Map<Bytes, List<ItemAt>>, x: ItemAt|
    found.insert(x.owner, match found.get(x.owner) { Some(xs) -> xs.push(x), None -> [x] }))

pub fn paired_items(
  source: List<ItemAt>,
  destination: List<ItemAt>,
) -> List<ItemAt> / {abort.raise} = {
  let placed = items_by_owner(destination);
  items_by_owner(source).fold([], |found: List<ItemAt>, owner: Bytes, xs: List<ItemAt>|
    match placed.get(owner) {
      None -> found,
      Some(ys) -> if ys.len() != xs.len() {
        panic(
          "the two layouts of `" ++ String::of_bytes_lossy(owner) ++ "` hold "
            ++ xs.len().to_string()
            ++ " and "
            ++ ys.len().to_string()
            ++ " items",
        )
      } else { found.concat(range(0, xs.len()).map(|k: Int| { ..xs.get(k), to: ys.get(k).to })) },
    })
}

pub fn laid_out(items: List<ItemAt>, offset: Int) -> List<ItemAt> =
  items.map(|x: ItemAt| { ..x, to: offset + x.from })

pub fn item_layout(members: List<OwnerText>) -> List<ItemAt> / {abort.raise} =
  members.fold(
    { at: 0, items: [] },
    |accumulator: { at: Int, items: List<ItemAt> }, o: OwnerText|
      range(0, o.texts.len()).fold(accumulator, |a: { at: Int, items: List<ItemAt> }, k: Int| {
        let t = o.texts.get(k);
        {
          at: a.at + t.len() + 2,
          items: a.items.push({ owner: o.owner, from: a.at, to: o.starts.get(k), len: t.len() }),
        }
      }),
  ).items

pub type OwnerSource = {
  source: Source,
  offset: Int,
  items: List<ItemAt>,
  derived: List<Derivation>,
}

pub fn group_source_from(
  module: Bytes,
  members: List<OwnerText>,
  imported: List<Imported>,
) -> OwnerSource / {abort.raise} = {
  let own = Bytes::join(
    members.fold([], |accumulator: List<Bytes>, o: OwnerText| accumulator.concat(o.texts)),
    b"\n\n",
  );
  let written = print_standalone(b"", merged_imports(imported.map(|x: Imported| x.declaration)), [
  ]);
  {
    source: { name: module, source_text: Bytes::concat_all([written, own, b"\n\n"]) },
    offset: written.len(),
    items: item_layout(members),
    derived: members.fold([], |accumulator: List<Derivation>, o: OwnerText|
      accumulator.concat(o.derived)),
  }
}

pub fn unplaced_imports(raw: Module) -> List<ImportDeclaration> = raw.imports.map(without_spans)

pub fn named_as_owned(m: Module, o: OwnerSource) -> Module / {abort.raise} =
  {
    ..m,
    items: m.items.map(|item: Item|
      match item {
        TestItem(d) -> {
          let start = d.span.start - o.offset;
          match o.items.find(|x: ItemAt| x.from <= start && start < x.from + x.len) {
            Some(x) -> match test_of_owner(x.owner) {
              Some(name) -> TestItem({ ..d, name: name }),
              None -> item,
            },
            None -> item,
          }
        },
        _ -> item,
      }),
  }

fn for_all<a>(xs: List<a>, f: (a) -> Unit / {abort.raise}) -> Unit / {abort.raise} =
  xs.fold((), |_: Unit, x: a| f(x))

fn mentions_in(text: Bytes) -> List<Bytes> / {abort.raise} =
  distinct(
    mentioned(
      {
        module: b"here",
        binders: Map::new().insert(b"lib", b"deep.lib"),
        selected: Map::new().insert(b"Shape", [b"shapes"]),
        owners: [b"Stack", b"::push", b"depth"].fold(
          Map::new(),
          |accumulator: Map<Bytes, List<Bytes>>, n: Bytes| accumulator.insert(n, [n]),
        ),
      },
      text,
    ),
  ).map(|m: Mention| Bytes::concat_all([m.module, b" ", m.name]))

test "a method called on a constant is mentioned as one called on a local is" {
  assert_eq(mentions_in(b"fn f() -> Int = depth.area()"), [b" area", b"here depth"]);
  assert_eq(mentions_in(b"fn f() -> Int = Shape.area()"), [b" area", b"shapes Shape"]);
  assert_eq(mentions_in(b"fn f() -> Int = lib::table.area()"), [b" area", b"deep.lib table"])
}

test "a method call records only the method name, a call to a type's function records the type too, and an effect operation call records nothing" {
  assert_eq(
    mentions_in(
      b"fn f(xs: Stack) -> Int / {abort.raise} = { abort.raise(1); xs.push(2).depth() + lib::made().area() }",
    ),
    [b" area", b" depth", b" push", b"deep.lib made", b"here ::push", b"here Stack"],
  );
  assert_eq(mentions_in(b"fn g() -> Int = Shape::unit().area() + Stack::depth(Stack::new())"), [
    b" area",
    b" depth",
    b" new",
    b"here Stack",
    b"here Stack::depth",
    b"here Stack::new",
    b"shapes Shape",
    b"shapes Shape::unit",
  ]);
  assert_eq(mentions_in(b"fn h(b: Bytes) -> Bytes = Bytes::push(Bytes::trimmed(b), 0)"), [
    b" push",
    b" trimmed",
    b"here ::push",
  ])
}

test "`==`, `digest` and `assert_eq` depend on the functions generated for containers, but `<` and `observe` do not" {
  let written = emitted_code.calls.map(|n: Bytes| Bytes::concat_all([prelude_module, b" ", n]));
  assert_eq(mentions_in(b"fn f(a: Int, b: Int) -> Bool = a == b"), written);
  assert_eq(mentions_in(b"fn f(a: Int, b: Int) -> Bool = a != b"), written);
  assert_eq(mentions_in(b"fn f(a: Int) -> Bytes = digest(a)"), written);
  assert_eq(mentions_in(b"fn f(a: Int, b: Int) -> Bool = a < b"), []);
  assert_eq(mentions_in(b"fn f(a: Int) -> Unit / {abort.raise} = assert_eq(a, 1)"), written);
  assert_eq(mentions_in(b"fn f(a: Int) -> Int = observe(a)"), []);
  assert_eq(mentions_in(b"const f: Int = 1"), [])
}

test "a map literal depends on the same functions as a call to `Map::of_entries`" {
  assert_eq(
    mentions_in(b"fn f() -> Map<Int, Int> = #{1: 2}"),
    mentions_in(b"fn f() -> Map<Int, Int> = Map::of_entries([{ key: 1, value: 2 }])"),
  );
  let marshalling = emitted_code.calls.concat(emitted_code.insert_calls).map(|n: Bytes|
    Bytes::concat_all([prelude_module, b" ", n]));
  assert_eq(mentions_in(b"fn f() -> Map<Int, Int> = #{}"), [b" of_entries"].concat(marshalling));
  assert(mentions_in(b"fn f() -> String = f\"{#{1: 2}}\"").contains(b" of_entries"), None)
}

test "a container type name depends on the container conversion functions, except inside the prelude" {
  let marshalling = emitted_code.calls.concat(emitted_code.insert_calls).map(|n: Bytes|
    Bytes::concat_all([prelude_module, b" ", n]));
  assert_eq(mentions_in(b"fn f(xs: List<Int>) -> Int = 0"), marshalling);
  assert_eq(mentions_in(b"fn f(n: Int) -> Int = n"), []);
  assert_eq(written_mentions(prelude_module, lex(b"List<Int>").tokens, 0), [])
}

test "an effect operation's type parameters depend on the container conversion functions, since they may be instantiated with a container" {
  let marshalling = emitted_code.calls.concat(emitted_code.insert_calls).map(|n: Bytes|
    Bytes::concat_all([prelude_module, b" ", n]));
  assert_eq(mentions_in(b"effect box {\n  write put<a>(x: a) -> Unit\n}\n"), marshalling);
  assert_eq(mentions_in(b"effect box {\n  read take[k]<a>() -> a\n}\n"), marshalling);
  assert_eq(
    mentions_in(b"effect box {\n  write swap<a, b>(x: a, y: b) -> (b, a)\n}\n"),
    marshalling,
  );
  assert_eq(mentions_in(b"effect box {\n  write put(x: Int) -> Unit\n}\n"), []);
  assert_eq(mentions_in(b"fn f(read: Int, x: Int) -> Bool = read < x"), [])
}

test "a call on a locally bound name depends only on the called function's name, however the name is bound" {
  for_all(
    [
      b"fn f(x: T) -> Int = x.go()",
      b"fn f() -> Int = { let x = make(); x.go() }",
      b"fn f(xs: List<T>) -> List<Int> = each(xs, |x| x.go())",
      b"fn f(o: Option<T>) -> Int = match o { Some(x) -> x.go(), None -> 0 }",
      b"fn f(p: P) -> Int = { let { x } = p; x.go() }",
      b"fn f(l: List<T>) -> Int = match l { [x, ..rest] -> x.go[r](), [] -> 0 }",
    ],
    |text: Bytes|
      assert_eq(mentions_in(text).filter(|m: Bytes| !m.starts_with(prelude_module)), [b" go"]),
  );
  assert_eq(mentions_in(b"fn f() -> Int / {x.go} = x.go() + lib::x.go()"), [b" go", b"deep.lib x"]);
  assert_eq(mentions_in(b"fn f() -> Int = (limits.go)() + size(limits.most)"), [b" go"])
}

test "a definition's tokens, with or without its signature, equal the tokens from lexing its source texts joined, and give the same mentions" {
  let source = b"import std.list\npub type Shape =\n  | Dot\n  | Line(Int)\npub fn size(s: Shape) -> Int =\n  match s {\n    Dot -> 0,\n    Line(n) -> abs(n),\n  }\npub transparent fn twice(n: Int) -> Int = n + n\nfn named(s: Shape) -> String = \"shape of {size(s)}\"\nfn listed(xs: List<Int>) -> Int = {\n  let ys = List::rotate(xs, 1);\n  ys.len() + twice(1)\n}\nfn small() -> Set<Int> = #[1, 2]\ntest \"the size of a line of {n}\" for n: Int in [1, 2] {\n  assert_eq(size(Line(n)), n)\n}\n";
  let parsed = parse_at(0, { name: b"m", source_text: source }).module;
  let raw = parse(source).node;
  let tokens = lex(source).tokens;
  let scope = module_scope(parsed, raw, raw.imports.map(import_path));
  let kinds = |ts: List<Token>| ts.map(|t: Token| t.kind);
  let reads = owner_texts(parsed, raw, source);
  assert_eq(reads.len(), 7);
  for_all(reads, |o: OwnerText|
    for_all(
      [
        { read: o, lexed: owner_tokens(tokens, o) },
        { read: signature_text(raw, o), lexed: signature_tokens(raw, tokens, o) },
      ],
      |r: { read: OwnerText, lexed: List<Token> }| {
        let joined = Bytes::join(r.read.texts, b"\n\n");
        let alone = lex(joined).tokens;
        assert_eq(kinds(r.lexed), kinds(alone));
        assert_eq(
          owner_mentions(b"m", scope, r.read, source, r.lexed),
          owner_mentions(b"m", scope, r.read, joined, alone),
        )
      },
    ))
}
