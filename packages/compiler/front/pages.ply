import compiler.front.diagnostics (parse_all)
import compiler.front.published (analyse)
import compiler.front.seam (Analysed, Refused)
import compiler.store.hash.encoding (hex)
import compiler.check.infer.checker (DefinitionInfo, Builtin)
import compiler.check.infer.definitions (externs_of)
import compiler.check.borrowing (ParameterMode, parameter_mode)
import compiler.syntax.items (Item, FunctionItem, TypeItem, EffectItem, EffectSetItem, ExternItem,
                              ExternDefinition, FnDefinition, TypeDefinition, AliasBody, SumBody,
                              NominalBody, ExternBody, VariantDefinition, EffectDefinition,
                              OpDefinition, EffectSetDefinition, FieldDoc, SpecClause, ReturnsFresh,
                              ReturnsParam, Visibility, Public, Private, SchemaDefinition,
                              schema_of, member_of)
import compiler.syntax.parsing (Doc, Identifier, Span)
import compiler.check.resolve.tables (ParsedModule, qualify)
import compiler.syntax.type_syntax (TypeExpression, RecordTypeExpression, type_span, generics_text)
import compiler.check.types (Printer, Scheme, Type, FunctionType, printer_new, print_scheme,
                             print_type, print_effects, scheme_text, print_effect_list)
import std.bin
import std.list
import std.string

pub type TypedParameter = { name: String, ty: String }

pub type Member = { kind: String, name: String, signature: String, doc: List<String> }

pub type Page = {
  kind: String,
  name: String,
  simple: String,
  signature: String,
  ty: String,
  params: List<TypedParameter>,
  doc: List<String>,
  clauses: List<String>,
  members: List<Member>,
  at: Int,
  hash: Option<String>,
  effects: Option<List<String>>,
  laws: List<String>,
}

pub type Pages = { pages: List<Page> }

derive bin for TypedParameter
derive bin for Member
derive bin for Page
derive bin for Pages

pub type PageInputs = {
  definitions: List<DefinitionInfo>,
  hashes: Map<Bytes, Bytes>,
  laws: Map<Bytes, List<Bytes>>,
}

pub fn bare_page(kind: String, name: String, signature: String) -> Page =
  {
    kind: kind,
    name: name,
    simple: "",
    signature: signature,
    ty: "",
    params: [],
    doc: [],
    clauses: [],
    members: [],
    at: 0,
    hash: None,
    effects: None,
    laws: [],
  }

type Printing = { printer: Printer, pairs: List<TypedParameter> }

pub type PrintedSignature = { text: String, params: List<TypedParameter> }

fn printed_params(
  printer: Printer,
  ts: List<Type>,
  params: List<ParameterMode>,
) -> Printing / {abort.raise} =
  range(0, ts.len()).fold({ printer: printer, pairs: [] }, |acc: Printing, i: Int|
    match ts.at(i) {
      None -> acc,
      Some(t) -> {
        let out = print_type(acc.printer, t);
        let written = match params.at(i) {
          Some(p) -> String::of_bytes_lossy(p.name),
          None -> "_" ++ i.to_string(),
        };
        let kept = match params.at(i) { Some(p) -> p.keep, None -> false };
        {
          printer: out.printer,
          pairs: acc.pairs.push({
            name: written,
            ty: (if kept { "keep " } else { "" }) ++ String::of_bytes_lossy(out.text),
          }),
        }
      },
    })

fn generics_of(full: Bytes) -> String / {abort.raise} =
  match full.index_of(b"(") { Some(i) -> String::of_bytes_lossy(full.slice(0, i)), None -> "" }

pub fn signature(
  prefix: String,
  name: String,
  scheme: Scheme,
  params: List<ParameterMode>,
) -> PrintedSignature / {abort.raise} = {
  let full = print_scheme(printer_new(), scheme);
  match scheme.ty {
    FunctionType(f) -> {
      let ps: Printing = printed_params(full.printer, f.params, params);
      let row = print_effects(ps.printer, f.effects);
      let effects = if row.text == b"{}" { "" } else { " / " ++ String::of_bytes_lossy(row.text) };
      let ret = print_type(row.printer, f.ret);
      {
        text: prefix ++ name ++ generics_of(full.text) ++ "("
          ++ String::join(
            ps.pairs.map(|named: TypedParameter| named.name ++ ": " ++ named.ty),
            ", ",
          )
          ++ ") -> "
          ++ String::of_bytes_lossy(ret.text)
          ++ effects,
        params: ps.pairs,
      }
    },
    _ -> { text: prefix ++ name ++ ": " ++ String::of_bytes_lossy(full.text), params: [] },
  }
}

pub fn lines_of(doc: Option<Doc>) -> List<String> =
  match doc { Some(d) -> d.lines.map(|l: Bytes| String::of_bytes_lossy(l)), None -> [] }

pub fn one_line(text: String) -> String = {
  let kept = text.split("\n").map(|l: String| l.ascii_trim()).filter(|l: String|
    l != "" && !l.starts_with("//"));
  let joined = String::join(kept, " ");
  let closed = joined.replace(", )", ")").replace(", ]", "]").replace(", }", " }");
  closed.replace("( ", "(").replace("[ ", "[").replace(" )", ")")
}

type PageSource = {
  parsed: ParsedModule,
  text: Bytes,
  definitions: Map<Bytes, DefinitionInfo>,
  decided: PageInputs,
}

fn sliced(reading: PageSource, span: Span) -> String / {abort.raise} =
  if span.start > span.end || span.end > reading.text.len() { "" }
  else { one_line(String::of_bytes_lossy(reading.text.slice(span.start, span.end))) }

fn visibility(v: Visibility) -> String = match v { Public -> "pub ", Private -> "" }

fn fn_named(parsed: ParsedModule, name: Bytes) -> Option<FnDefinition> =
  parsed.module.items.fold(None, |acc: Option<FnDefinition>, it: Item|
    match acc {
      Some(_) -> acc,
      None -> match it {
        FunctionItem(d) -> if qualify(parsed.name, d.name.name) == name { Some(d) } else { None },
        _ -> None,
      },
    })

fn fn_signature(
  definition_info: DefinitionInfo,
  found: Option<FnDefinition>,
) -> PrintedSignature / {abort.raise} = {
  let prefix = match found {
    None -> "fn ",
    Some(d) ->
      visibility(d.visibility) ++ (if d.reuse == None { "" } else { "reuse " })
        ++ (if d.constant == None { "" } else { "const " })
        ++ "fn ",
  };
  signature(
    prefix,
    String::of_bytes_lossy(definition_info.simple_name),
    definition_info.scheme,
    match found { Some(d) -> d.params.map(parameter_mode), None -> [] },
  )
}

fn clauses_of(reading: PageSource, d: FnDefinition) -> List<String> / {abort.raise} = {
  let returns = match d.returns {
    Some(ReturnsFresh(_)) -> ["returns fresh"],
    Some(ReturnsParam(p)) -> ["returns " ++ String::of_bytes_lossy(p.name)],
    None -> [],
  };
  d.spec.fold(returns, |acc: List<String>, c: SpecClause| acc.push(sliced(reading, c.span)))
}

fn schema_signature(reading: PageSource, d: SchemaDefinition) -> String / {abort.raise} =
  visibility(d.visibility) ++ sliced(reading, d.span)

fn definition_page(reading: PageSource, definition_info: DefinitionInfo) -> Page / {abort.raise} = {
  let found = fn_named(reading.parsed, definition_info.name);
  let schema = match found { Some(d) -> schema_of(reading.parsed.module, d), None -> None };
  let signed: PrintedSignature = fn_signature(definition_info, found);
  {
    kind: match schema { Some(_) -> "law schema", None -> "definition" },
    name: String::of_bytes_lossy(definition_info.name),
    simple: String::of_bytes_lossy(definition_info.simple_name),
    signature: match schema { Some(d) -> schema_signature(reading, d), None -> signed.text },
    ty: String::of_bytes_lossy(scheme_text(definition_info.scheme)),
    params: signed.params,
    doc: match found { Some(d) -> lines_of(d.doc), None -> [] },
    clauses: match found { Some(d) -> clauses_of(reading, d), None -> [] },
    members: [],
    at: definition_info.at.span.start,
    hash: match reading.decided.hashes.get(definition_info.name) {
      Some(h) -> Some(String::of_bytes_lossy(hex(h))),
      None -> None,
    },
    effects: Some(
      print_effect_list(printer_new(), definition_info.effects).texts.map(String::of_bytes_lossy),
    ),
    laws: match reading.decided.laws.get(definition_info.name) {
      Some(laws) -> laws.map(|l: Bytes| String::of_bytes_lossy(l)),
      None -> [],
    },
  }
}

fn type_head(d: TypeDefinition) -> String =
  visibility(d.visibility) ++ (if d.opaque == None { "" } else { "opaque " })
    ++ (match d.body { ExternBody -> "extern ", _ -> "" })
    ++ "type "
    ++ String::of_bytes_lossy(d.name.name)
    ++ String::of_bytes_lossy(generics_text(d.generics))

fn field_doc(docs: List<FieldDoc>, name: Bytes) -> List<String> =
  match docs.find(|f: FieldDoc| f.name == name) { Some(f) -> lines_of(Some(f.doc)), None -> [] }

fn type_signature(reading: PageSource, d: TypeDefinition) -> String / {abort.raise} =
  match d.body {
    AliasBody(t) -> match t {
      RecordTypeExpression(_) -> type_head(d),
      _ -> type_head(d) ++ " = " ++ sliced(reading, type_span(t)),
    },
    NominalBody(_) -> type_head(d) ++ " = new { .. }",
    SumBody(_) -> type_head(d),
    ExternBody -> type_head(d),
  }

fn field_members(
  reading: PageSource,
  d: TypeDefinition,
  t: TypeExpression,
) -> List<Member> / {abort.raise} =
  match t {
    RecordTypeExpression(r) ->
      r.fields.map(|f: { name: Identifier, ty: TypeExpression }|
        {
          kind: "field",
          name: String::of_bytes_lossy(f.name.name),
          signature: String::of_bytes_lossy(f.name.name) ++ ": "
            ++ sliced(reading, type_span(f.ty)),
          doc: field_doc(d.field_docs, f.name.name),
        }),
    _ -> [],
  }

fn type_members(reading: PageSource, d: TypeDefinition) -> List<Member> / {abort.raise} =
  match d.body {
    SumBody(vs) -> if d.opaque != None { [] } else {
      vs.map(|v: VariantDefinition|
        {
          kind: "variant",
          name: String::of_bytes_lossy(v.name.name),
          signature: sliced(reading, v.span),
          doc: lines_of(v.doc),
        })
    },
    AliasBody(t) -> field_members(reading, d, t),
    NominalBody(t) -> field_members(reading, d, t),
    ExternBody -> [],
  }

fn effect_head(d: EffectDefinition) -> String =
  visibility(d.visibility) ++ (if d.is_nondet { "nondet " } else { "" }) ++ "effect "
    ++ String::of_bytes_lossy(d.name.name)

fn op_member(reading: PageSource, op: OpDefinition) -> Member / {abort.raise} =
  {
    kind: "operation",
    name: String::of_bytes_lossy(op.name.name),
    signature: sliced(reading, op.span),
    doc: lines_of(op.doc),
  }

fn set_signature(reading: PageSource, d: EffectSetDefinition) -> String / {abort.raise} =
  visibility(d.visibility) ++ sliced(reading, d.span)

fn type_functions(reading: PageSource, d: TypeDefinition) -> List<Member> / {abort.raise} = {
  let parsed = reading.parsed;
  parsed.module.items.fold([], |acc: List<Member>, it: Item|
    match it {
      FunctionItem(f) -> match member_of(f.name.name) {
        None -> acc,
        Some(m) -> {
          let kept = match ((d.visibility, f.visibility)) { (Public, Private) -> true, _ -> false };
          if m.of != d.name.name || kept { acc } else {
            match reading.definitions.get(qualify(parsed.name, f.name.name)) {
              None -> acc,
              Some(definition_info) ->
                acc.push({
                  kind: "function",
                  name: String::of_bytes_lossy(m.member),
                  signature: fn_signature(definition_info, Some(f)).text,
                  doc: lines_of(f.doc),
                }),
            }
          }
        },
      },
      _ -> acc,
    })
}

fn declaration_page(reading: PageSource, kind: String, own: Bytes, span: Span) -> Page =
  {
    ..bare_page(kind, String::of_bytes_lossy(qualify(reading.parsed.name, own)), ""),
    simple: String::of_bytes_lossy(own),
    at: span.start,
  }

fn item_pages(reading: PageSource, it: Item) -> List<Page> / {abort.raise} =
  match it {
    ExternItem(d) -> match native_of(reading, d) {
      Some(n) ->
        [
          {
            ..declaration_page(reading, "builtin", d.name.name, d.span),
            signature: n.signed.text,
            ty: String::of_bytes_lossy(scheme_text(n.builtin.scheme)),
            params: n.signed.params,
            doc: n.builtin.doc.map(|l: Bytes| String::of_bytes_lossy(l)),
            clauses: n.builtin.clauses.map(|c: Bytes| String::of_bytes_lossy(c)),
          },
        ],
      None -> [],
    },
    TypeItem(d) ->
      [
        {
          ..declaration_page(reading, "type", d.name.name, d.span),
          signature: type_signature(reading, d),
          doc: lines_of(d.doc),
          members: type_members(reading, d).concat(type_functions(reading, d)),
        },
      ],
    EffectItem(d) ->
      d.operations.fold(
        [
          {
            ..declaration_page(reading, "effect", d.name.name, d.span),
            signature: effect_head(d),
            doc: lines_of(d.doc),
            members: d.operations.map(|op: OpDefinition| op_member(reading, op)),
          },
        ],
        |acc: List<Page>, op: OpDefinition|
          acc.push({
            ..declaration_page(reading, "operation", Bytes::concat_all([d.name.name, b".", op.name.name]), op.span),
            signature: sliced(reading, op.span),
            doc: lines_of(op.doc),
          }),
      ),
    EffectSetItem(d) ->
      [
        {
          ..declaration_page(reading, "effect set", d.name.name, d.span),
          signature: set_signature(reading, d),
          doc: lines_of(d.doc),
        },
      ],
    _ -> [],
  }

type Native = { builtin: Builtin, signed: PrintedSignature }

fn native_of(reading: PageSource, d: ExternDefinition) -> Option<Native> / {abort.raise} = {
  let name = qualify(reading.parsed.name, d.name.name);
  match externs_of(reading.parsed.name, reading.parsed.module).find(|b: Builtin| b.name == name) {
    Some(b) ->
      Some({
        builtin: b,
        signed: signature("", String::of_bytes_lossy(d.name.name), b.scheme, b.params),
      }),
    None -> None,
  }
}

fn module_members(reading: PageSource) -> List<Member> / {abort.raise} = {
  let parsed = reading.parsed;
  parsed.module.items.fold([], |acc: List<Member>, it: Item|
    match it {
      ExternItem(d) -> match d.visibility {
        Private -> acc,
        Public -> match native_of(reading, d) {
          Some(n) ->
            acc.push({
              kind: "builtin",
              name: String::of_bytes_lossy(d.name.name),
              signature: n.signed.text,
              doc: n.builtin.doc.map(|l: Bytes| String::of_bytes_lossy(l)),
            }),
          None -> acc,
        },
      },
      FunctionItem(d) -> match d.visibility {
        Private -> acc,
        Public -> match ((
            reading.definitions.get(qualify(parsed.name, d.name.name)),
            schema_of(parsed.module, d),
          )) {
          (None, _) -> acc,
          (Some(definition_info), None) ->
            acc.push({
              kind: "definition",
              name: String::of_bytes_lossy(d.name.name),
              signature: fn_signature(definition_info, Some(d)).text,
              doc: lines_of(d.doc),
            }),
          (Some(_), Some(schema)) -> if schema.name.name != d.name.name { acc } else {
            acc.push({
              kind: "law schema",
              name: String::of_bytes_lossy(d.name.name),
              signature: schema_signature(reading, schema),
              doc: lines_of(d.doc),
            })
          },
        },
      },
      TypeItem(d) -> match d.visibility {
        Private -> acc,
        Public ->
          acc.push({
            kind: "type",
            name: String::of_bytes_lossy(d.name.name),
            signature: type_signature(reading, d),
            doc: lines_of(d.doc),
          }),
      },
      EffectItem(d) -> match d.visibility {
        Private -> acc,
        Public ->
          acc.push({
            kind: "effect",
            name: String::of_bytes_lossy(d.name.name),
            signature: effect_head(d),
            doc: lines_of(d.doc),
          }),
      },
      EffectSetItem(d) -> match d.visibility {
        Private -> acc,
        Public ->
          acc.push({
            kind: "effect set",
            name: String::of_bytes_lossy(d.name.name),
            signature: set_signature(reading, d),
            doc: lines_of(d.doc),
          }),
      },
      _ -> acc,
    })
}

pub fn module_pages(
  parsed: ParsedModule,
  text: Bytes,
  decided: PageInputs,
) -> Pages / {abort.raise} = {
  let reading: PageSource = {
    parsed: parsed,
    text: text,
    definitions: decided.definitions.fold(
      Map::new(),
      |acc: Map<Bytes, DefinitionInfo>, d: DefinitionInfo| acc.insert(d.name, d),
    ),
    decided: decided,
  };
  let name = String::of_bytes_lossy(parsed.name);
  let own = {
    ..bare_page("module", name, name),
    doc: lines_of(parsed.module.doc),
    members: module_members(reading),
  };
  let defined = decided.definitions.fold([own], |acc: List<Page>, d: DefinitionInfo|
    acc.push(definition_page(reading, d)));
  {
    pages: parsed.module.items.fold(defined, |acc: List<Page>, it: Item|
      item_pages(reading, it).fold(acc, |a: List<Page>, page: Page| a.push(page))),
  }
}

test "written text reads on one line, without a comment or a closing comma" {
  assert_eq(
    one_line("read walk[r](\n    path: String,\n  ) -> Option<List<Entry>>"),
    "read walk[r](path: String) -> Option<List<Entry>>",
  );
  assert_eq(
    one_line("{\n  // the label\n  name: String,\n  size: Int,\n}"),
    "{ name: String, size: Int }",
  )
}

fn pages_of(src: Bytes, named: Bytes, law: Bytes) -> List<Page> / {abort.raise} =
  match parse_all([{ name: b"m", src: src }]) {
    [p] -> match analyse([p]) {
      Refused(_) -> panic("the fixture checks"),
      Analysed(w) ->
        module_pages(p.module, src, {
          definitions: w.checked.definitions,
          hashes: w.hashes.definitions.fold(
            Map::new(),
            |acc: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }| acc.insert(x.name, x.hash),
          ),
          laws: Map::new().insert(named, [law]),
        }).pages,
    },
    _ -> panic("one module parses to one"),
  }

test "a module documents itself, each definition its check published and each name it declares" {
  let src = b"//! Counting.\n\n/// One more.\npub fn more(x: Int) -> Int\n  ensures result > x\n= x + 1\n\n/// A shape.\npub type Shape = | Dot | Line(Int)\n\npub effect ledger {\n  /// Writes it down.\n  write record(n: Int) -> Unit\n}\n";
  let pages = pages_of(src, b"m.more", b"more grows");
  assert_eq(pages.map(|p: Page| p.kind ++ " " ++ p.name ++ " as " ++ p.simple), [
    "module m as ",
    "definition m.more as more",
    "type m.Shape as Shape",
    "effect m.ledger as ledger",
    "operation m.ledger.record as ledger.record",
  ]);
  let page = |name: String|
    match pages.find(|p: Page| p.name == name) {
      Some(p) -> p,
      None -> panic("`" ++ name ++ "` has a page"),
    };
  assert_eq(page("m").doc, ["Counting."]);
  assert_eq(page("m").members.map(|m: Member| m.kind ++ " " ++ m.signature), [
    "definition pub fn more(x: Int) -> Int",
    "type pub type Shape",
    "effect pub effect ledger",
  ]);
  let more = page("m.more");
  assert_eq(more.signature, "pub fn more(x: Int) -> Int");
  assert_eq(more.params, [{ name: "x", ty: "Int" }]);
  assert_eq(more.doc, ["One more."]);
  assert_eq(more.clauses, ["ensures result > x"]);
  assert_eq(more.effects, Some([]));
  assert_eq(more.laws, ["more grows"]);
  assert(more.hash != None);
  assert_eq(src.slice(more.at, more.at + 7), b"fn more");
  assert_eq(page("m.Shape").members.map(|m: Member| m.signature), ["Dot", "Line(Int)"]);
  assert_eq(page("m.Shape").laws, []);
  assert_eq(page("m.ledger").members, [
    {
      kind: "operation",
      name: "record",
      signature: "write record(n: Int) -> Unit",
      doc: ["Writes it down."],
    },
  ]);
  assert_eq(page("m.ledger.record").signature, "write record(n: Int) -> Unit")
}

test "a shipped module's extern is a builtin of its module, listed among its members where it is `pub`" {
  let src = b"//! Natives.\n\n/// Twice the number.\npub extern fn doubled(x: Int) -> Int\n\n/// Kept inside.\nextern fn hidden(x: Int) -> Int\n";
  match parse_all([{ name: b"std.native", src: src }]) {
    [p] -> {
      let pages = module_pages(p.module, src, {
        definitions: [],
        hashes: Map::new(),
        laws: Map::new(),
      }).pages;
      assert_eq(pages.map(|page: Page| page.kind ++ " " ++ page.name), [
        "module std.native",
        "builtin std.native.doubled",
        "builtin std.native.hidden",
      ]);
      assert_eq(pages.get(0).members.map(|m: Member| m.name ++ ": " ++ m.signature), [
        "doubled: doubled(x: Int) -> Int",
      ]);
      assert_eq(pages.get(1).doc, ["Twice the number."])
    },
    _ -> panic("one module"),
  }
}

test "a type's page lists its functions after what it is made of, those it publishes where it is published" {
  let src = b"pub type Shape = | Dot | Line(Int)\n\n/// How long.\npub fn Shape::length(s: Shape) -> Int = match s { Dot -> 0, Line(n) -> n }\n\nfn Shape::kept(s: Shape) -> Int = 0\n\ntype Inner = | Inner\n\nfn Inner::made() -> Inner = Inner\n";
  let pages = pages_of(src, b"none", b"none");
  let members = |name: String|
    match pages.find(|p: Page| p.name == name) {
      Some(p) -> p.members.map(|m: Member| m.kind ++ " " ++ m.name ++ ": " ++ m.signature),
      None -> panic("`" ++ name ++ "` has a page"),
    };
  assert_eq(members("m.Shape"), [
    "variant Dot: Dot",
    "variant Line: Line(Int)",
    "function length: pub fn Shape::length(s: m.Shape) -> Int",
  ]);
  assert_eq(members("m.Inner"), [
    "variant Inner: Inner",
    "function made: fn Inner::made() -> m.Inner",
  ])
}
