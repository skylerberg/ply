pub type PackageFile = { module: Bytes, text: Bytes }

pub type OwnPackage = { root: Bytes, manifest: Option<Bytes>, files: List<PackageFile> }

pub type LoadInputs = {
  layout: Bytes,
  places: Map<Bytes, Bytes>,
  texts: Map<Bytes, Bytes>,
  own: List<Bytes>,
  dependencies: List<Bytes>,
}

fn embedding_of(read: EmbedBytesResult) -> Embedding =
  match read {
    Ok(files) -> { files: files.map(|f: EmbedBytes| embed_file(f.name, f.bytes)), rejected: None },
    Err(reason) -> { files: [], rejected: Some(reason) },
  }

pub fn load_inputs_of(
  root: OwnPackage,
  dependencies: List<OwnPackage>,
) -> LoadInputs / {abort.raise} = {
  let j = read_packages(
    {
      root: root.root,
      manifest: root.manifest,
      supplied: dependencies.map(|p: OwnPackage|
        { root: p.root, manifest: p.manifest, modules: [] }),
    },
    root.files.map(|f: PackageFile| f.module),
  );
  let placed = range(0, dependencies.len() + 1).fold(
    [],
    |accumulator: List<{ name: Bytes, placing: PackageLocation, text: Bytes }>, k: Int| {
      let p = if k == 0 { root } else { dependencies.get(k - 1) };
      let prefix = prefix_in(j, k);
      p.files.fold(
        accumulator,
        |a: List<{ name: Bytes, placing: PackageLocation, text: Bytes }>, f: PackageFile|
          a.push({
            name: if prefix.len() == 0 { f.module }
            else { Bytes::concat_all([prefix, b".", f.module]) },
            placing: { package: k, relative: f.module },
            text: f.text,
          }),
      )
    },
  );
  {
    layout: bin::encode(without_locations(j), validated_packages_bin()),
    places: placed.fold(
      Map::new(),
      |accumulator: Map<Bytes, Bytes>, x: { name: Bytes, placing: PackageLocation, text: Bytes }|
        accumulator.insert(x.name, bin::encode(x.placing, package_location_bin())),
    ),
    texts: placed.fold(
      Map::new(),
      |accumulator: Map<Bytes, Bytes>, x: { name: Bytes, placing: PackageLocation, text: Bytes }|
        accumulator.insert(x.name, x.text),
    ),
    own: placed.map(|x: { name: Bytes, placing: PackageLocation, text: Bytes }| x.name),
    dependencies: range(1, dependencies.len() + 1).map(|k: Int| prefix_in(j, k)),
  }
}

pub fn package_location_in(
  w: LoadInputs,
  module: Bytes,
) -> Option<PackageLocation> / {abort.raise} =
  match w.places.get(module) {
    Some(b) -> Some(decoded(b, package_location_bin(), "a module's place")),
    None -> None,
  }

fn embedded_at<| e>(
  w: LoadInputs,
  reader: (Int, Bytes, EmbedRequest) -> EmbedBytesResult / {abort.raise | e},
  at: Bytes,
) -> Option<Bytes> / {abort.raise | e} = {
  let parts = at.split(b"\x00");
  match ((parts.at(1), parts.at(2))) {
    (Some(module), Some(key)) -> match package_location_in(w, module) {
      None -> None,
      Some(p) -> {
        Some(
          bin::encode(
            embedding_of(reader(p.package, p.relative, request_of_key(key))),
            embedding_bin(),
          ),
        )
      },
    },
    _ -> None,
  }
}

pub fn lookup_input<| e>(
  w: LoadInputs,
  shipped: (Bytes) -> Option<Bytes> / {abort.raise | e},
  data: (Bytes) -> Option<Bytes> / {abort.raise | e},
  names: () -> List<Bytes> / {abort.raise | e},
  reader: (Int, Bytes, EmbedRequest) -> EmbedBytesResult / {abort.raise | e},
  derived: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  kind: Bytes,
  at: Bytes,
) -> Option<Bytes> / {abort.raise | e} =
  if kind == layout_kind { Some(w.layout) }
  else if kind == shipped_names_kind { Some(bin::encode(names(), bin::list_bin(bin::bytes_bin()))) }
  else if kind == module_kind { w.places.get(at) }
  else if kind == text_kind { w.texts.get(at) }
  else if kind == shipped_kind { shipped(at) }
  else if kind == shipped_exists_kind { match shipped(at) { Some(_) -> Some(b""), None -> None } }
  else if kind == data_kind { data(at) }
  else if kind == embedded_file_kind { embedded_at(w, reader, at) }
  else if kind == derived_kind || kind == deriver_kind { derived(kind, at) }
  else if kind == own_modules_kind { Some(bin::encode(w.own, bin::list_bin(bin::bytes_bin()))) }
  else { None }

pub fn evaluator_of(stamps: Bytes) -> Bytes / {abort.raise} =
  stamps.split(b"\n").fold(b"", |accumulator: Bytes, line: Bytes|
    if line.starts_with(b"evaluator ") { line.slice(10, line.len()) } else { accumulator })

pub type QueryDefinition = {
  name: Bytes,
  definition: Bytes,
  body: (Bytes) -> Bytes / {QueryEffects, abort.raise},
}

pub fn every_query() -> List<QueryDefinition> =
  queries().concat(promise_queries()).concat(code_queries()).concat(interface_queries())

pub const placeholder_definitions: Bytes =
  Bytes::concat_all(
    every_query().map(|q: QueryDefinition|
      Bytes::concat_all([q.definition, b" ", hex(blake3(q.definition)), b"\n"])),
  )

pub fn registry(
  definitions: Bytes,
  evaluator: Bytes,
  more: List<QueryDefinition> = [],
) -> CheckQueries / {abort.raise} =
  check_queries(
    every_query().concat(more).fold(
      Map::new(),
      |accumulator: Map<Bytes, CheckQuery>, q: QueryDefinition|
        accumulator.insert(q.name, {
          name: q.name,
          hash: match definition_hash(definitions, q.definition) {
            Some(h) -> blake3(Bytes::concat_all([h, b"\x00", evaluator])),
            None ->
              panic(
                "the program contains no definition `" ++ String::of_bytes_lossy(q.definition)
                  ++ "`",
              ),
          },
          body: q.body,
          persistent: !digest_only_queries.contains(q.name),
          product: product_of(q.name),
        }),
    ),
  )

pub fn fresh_registry(more: List<QueryDefinition> = []) -> CheckQueries =
  check_queries(
    every_query().concat(more).fold(
      Map::new(),
      |accumulator: Map<Bytes, CheckQuery>, q: QueryDefinition|
        accumulator.insert(q.name, {
          name: q.name,
          hash: q.name,
          body: q.body,
          persistent: true,
          product: product_of(q.name),
        }),
    ),
  )

pub type CheckedModule = { module: Bytes, result: ModuleResult }

pub fn rows_of_result(a: ModuleResult) -> Rows / {abort.raise} = decode_rows(a.rows)

pub fn facts_of_result(a: ModuleResult) -> ModuleFacts / {abort.raise} =
  { shape: a.shape, tables: tables_of_result(a) }

pub fn checked_program_from_results(
  frame: Frame,
  reads: TableReads,
  results: Map<Bytes, ModuleResult>,
) -> CheckedProgram / {abort.raise} =
  checked_program_over(
    frame,
    reads,
    frame.outlines.map(|o: Outline|
      match results.get(o.name) { Some(a) -> tables_of_result(a), None -> no_module_tables }),
  )

pub type LoadResults = { results: List<CheckedModule>, pulled: List<Bytes> }

pub fn listed_module(named: ModuleKey) -> CheckedModule / {memo.read, abort.raise} =
  if module_rejected(named) { module_of(named) }
  else { { module: named.module, result: listed_result(named) } }

pub fn module_of(named: ModuleKey) -> CheckedModule / {memo.read, abort.raise} =
  {
    module: named.module,
    result: decoded(
      memo.fetch(module_query, bin::encode(named, module_key_bin())),
      module_result_bin(),
      "a module's result",
    ),
  }

pub fn query_load(
  own: List<Bytes>,
  required_modules: List<Bytes>,
  tested: Bool,
  read: (ModuleKey) -> CheckedModule / {memo.read, abort.raise},
) -> LoadResults / {memo.read, abort.raise} = {
  let cycles = cycles_among(own);
  if cycles.len() > 0 { { results: cycles, pulled: [] } } else {
    let ordered = dependencies_first(
      own.map(|n: Bytes| { module: n, shipped: false, tested: false }),
    );
    let asked_own = ordered.order.fold(
      { returned: Map::new(), written: Map::new() },
      |accumulator: { returned: Map<Bytes, CheckedModule>, written: Map<Bytes, List<Bytes>> }, n: ModuleKey| {
        let a = read(n);
        {
          returned: accumulator.returned.insert(n.module, a),
          written: accumulator.written.insert(n.module, a.result.shape.written),
        }
      },
    );
    let first = {
      results: own.map(|n: Bytes|
        match asked_own.returned.get(n) {
          Some(a) -> a,
          None -> panic("no check result exists for a module of the program"),
        }),
      written: asked_own.written,
    };
    let listed = shipped_names_listed().fold(
      Map::new(),
      |accumulator: Map<Bytes, Bool>, n: Bytes| accumulator.insert(n, true),
    );
    let pulled = iterate(
      { results: first.results, written: first.written, read: own, pulled: [] },
      listed.len() + 2,
      |x: { results: List<CheckedModule>, written: Map<Bytes, List<Bytes>>, read: List<Bytes>, pulled: List<Bytes> }| {
        let fresh = pulled_next(x.read, x.written, listed, required_modules);
        if fresh.len() == 0 { Stop(x) } else {
          Continue(
            fresh.fold(
              { ..x, read: x.read.concat(fresh), pulled: x.pulled.concat(fresh) },
              |accumulator: { results: List<CheckedModule>, written: Map<Bytes, List<Bytes>>, read: List<Bytes>, pulled: List<Bytes> }, n: Bytes| {
                let a = read({ module: n, shipped: true, tested: tested });
                {
                  ..accumulator,
                  results: accumulator.results.push(a),
                  written: accumulator.written.insert(n, a.result.shape.written),
                }
              },
            ),
          )
        }
      },
    );
    { results: pulled.results, pulled: pulled.pulled }
  }
}

pub const shipped_queries: List<Bytes> =
  [
    owners_query,
    module_summary_query,
    module_listing_query,
    module_rollup_query,
    owner_query,
    shape_query,
    unit_of_query,
    signature_unit_query,
    setting_query,
    context_query,
    names_query,
    declared_query,
    signatures_query,
    typed_query,
    calls_query,
    cycles_query,
    group_query,
    group_hash_query,
    module_query,
    header_query,
    header_text_query,
    hashes_query,
    hash_summary_query,
    wanted_files_query,
    documented_query,
    declaring_query,
    name_declaration_query,
  ]

const listing_queries: List<Bytes> =
  [module_query, group_listing_query, module_listing_query, module_rollup_query]

fn product_of(name: Bytes) -> Option<Product> =
  if [documented_query, declaring_query].contains(name) {
    Some({ kind: b"docs", after: [b"hashes", b"listings"] })
  } else if listing_queries.contains(name) { Some({ kind: b"listings", after: [] }) }
  else if cost_queries.contains(name) { Some({ kind: b"costs", after: [] }) }
  else if measure_queries.contains(name) { Some({ kind: b"measures", after: [b"hashes"] }) }
  else if code_product_queries.contains(name) { Some({ kind: b"code", after: [b"listings"] }) }
  else if product_queries.contains(name) { Some({ kind: b"hashes", after: [] }) }
  else { None }

const cost_queries: List<Bytes> =
  [
    cost_walk_query,
    cost_return_query,
    cost_demands_query,
    cost_parameters_query,
    module_parameters_query,
    module_costs_query,
  ]

const measure_queries: List<Bytes> = [measure_query, measures_query]

pub const product_queries: List<Bytes> =
  [
    group_forms_query,
    group_hash_query,
    owner_hash_query,
    hashes_query,
    hash_summary_query,
    documented_query,
    declaring_query,
  ].concat(
    code_product_queries,
  ).concat(
    listing_queries,
  )

pub const digest_only_queries: List<Bytes> =
  [visible_modules_query, group_imports_query, owner_imports_query, signature_imports_query]

pub fn check_shipped_modules(
  shipped: List<Bytes>,
) -> List<CheckedModule> / {memo.read, abort.raise} = {
  let rejected = dependency_levels(
    shipped.map(|m: Bytes| { module: m, shipped: true, tested: false }),
  ).levels.fold([], |accumulator: List<CheckedModule>, level: List<ModuleKey>| {
    let inputs = level.map(|named: ModuleKey| bin::encode(named, module_key_bin()));
    [hashes_query, wanted_files_query, module_listing_query].fold((), |_: Unit, query: Bytes| {
      memo.fetch_all(query, inputs);
      ()
    });
    level.fold(accumulator, |found: List<CheckedModule>, named: ModuleKey|
      if module_rejected(named) { found.push(module_of(named)) } else { found })
  });
  declaring_in(b"std");
  rejected
}

pub fn wanted_all(
  pulled: List<Bytes>,
  tested: Bool,
) -> Map<Bytes, ShippedWants> / {memo.read, abort.raise} =
  pulled.fold(Map::new(), |accumulator: Map<Bytes, ShippedWants>, m: Bytes|
    accumulator.insert(
      m,
      decoded(
        memo.fetch(
          wanted_files_query,
          bin::encode({ module: m, shipped: true, tested: tested }, module_key_bin()),
        ),
        shipped_wants_bin(),
        "a module's wants",
      ),
    ))

pub fn documented_all(modules: List<ModuleKey>) -> List<Pages> / {memo.read, abort.raise} =
  modules.map(|named: ModuleKey|
    decoded(
      memo.fetch(documented_query, bin::encode(named, module_key_bin())),
      pages_bin(),
      "a module's pages",
    ))

pub fn declaring_in(package: Bytes) -> Map<Bytes, List<Bytes>> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(declaring_query, package),
    declaring_bin(),
    "the modules that declare each name",
  )

fn imports_of_key(named: ModuleKey) -> List<ImportOf> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(imports_query, bin::encode(named, module_key_bin())),
    imports_of_bin(),
    "a module's imports",
  ).imports

fn dependencies_first(
  modules: List<ModuleKey>,
) -> { order: List<ModuleKey>, edges: Map<Bytes, List<Bytes>> } / {memo.read, abort.raise} = {
  let levelled = dependency_levels(modules);
  { order: levelled.levels.flat_map(|level: List<ModuleKey>| level), edges: levelled.edges }
}

fn dependency_levels(
  modules: List<ModuleKey>,
) -> { levels: List<List<ModuleKey>>, edges: Map<Bytes, List<Bytes>> } / {memo.read, abort.raise} = {
  let edges = modules.fold(Map::new(), |accumulator: Map<Bytes, List<Bytes>>, n: ModuleKey|
    accumulator.insert(n.module, imports_of_key(n).map(|i: ImportOf| i.named.module)));
  let among = modules.fold(Map::new(), |accumulator: Map<Bytes, Bool>, n: ModuleKey|
    accumulator.insert(n.module, true));
  let levels = iterate(
    { placed: Map::new(), left: modules, out: [] },
    modules.len() + 2,
    |x: { placed: Map<Bytes, Bool>, left: List<ModuleKey>, out: List<List<ModuleKey>> }| {
      let ready = x.left.filter(|n: ModuleKey|
        List::fold(
          match edges.get(n.module) { Some(es) -> es, None -> [] },
          true,
          |b: Bool, m: Bytes| b && (m == n.module || !among.contains(m) || x.placed.contains(m)),
        ));
      if ready.len() == 0 { Stop(if x.left.len() == 0 { x.out } else { x.out.push(x.left) }) }
      else {
        let placed = ready.fold(x.placed, |accumulator: Map<Bytes, Bool>, n: ModuleKey|
          accumulator.insert(n.module, true));
        let left = x.left.filter(|n: ModuleKey| !placed.contains(n.module));
        if left.len() == 0 { Stop(x.out.push(ready)) }
        else { Continue({ placed: placed, left: left, out: x.out.push(ready) }) }
      }
    },
  );
  { levels: levels, edges: edges }
}

pub fn packages_rejected(
  packages: PackageSources,
  root_modules: List<Bytes>,
  modules: Int,
  listed: List<Bytes>,
) -> List<Diagnostic> / {abort.raise} =
  reserved_prefix_diagnostics(root_modules, listed).map(
    |sd: { slot: Int, diagnostic: ParseDiagnostic }|
      diagnostic_in_module(0 - sd.slot - 1, sd.diagnostic),
  ).concat(
    read_packages(packages, root_modules).diagnostics.map(
      |sd: { slot: Int, diagnostic: ParseDiagnostic }|
        diagnostic_in_module(modules + sd.slot, sd.diagnostic),
    ),
  )

pub fn hashed_all(
  own: List<Bytes>,
  shipped: List<Bytes>,
  tested: Bool,
) -> List<ModuleHashes> / {memo.read, abort.raise} =
  own.map(|n: Bytes| { module: n, shipped: false, tested: false }).concat(
    shipped.map(|n: Bytes| { module: n, shipped: true, tested: tested }),
  ).map(
    module_hashes,
  )

pub fn module_hashes(named: ModuleKey) -> ModuleHashes / {memo.read, abort.raise} = {
  let h = decoded(
    memo.fetch(hashes_query, bin::encode(named, module_key_bin())),
    hash_result_bin(),
    "a module's hashing",
  );
  { record: h.record, cached: h.fixing }
}

pub fn cycles_among(own: List<Bytes>) -> List<CheckedModule> / {memo.read, abort.raise} = {
  let edges = own.fold(Map::new(), |accumulator: Map<Bytes, List<ImportOf>>, m: Bytes|
    accumulator.insert(
      m,
      imports_of_key({ module: m, shipped: false, tested: false }).filter(|i: ImportOf|
        !i.named.shipped),
    ));
  let next = |m: Bytes|
    List::map(match edges.get(m) { Some(es) -> es, None -> [] }, |i: ImportOf| i.named.module);
  let paths = |from: Bytes|
    iterate(
      { seen: Map::new(), frontier: next(from).map(|n: Bytes| { at: n, path: [from] }) },
      own.len() + 2,
      |x: { seen: Map<Bytes, List<Bytes>>, frontier: List<{ at: Bytes, path: List<Bytes> }> }|
        if x.frontier.len() == 0 { Stop(x.seen) } else {
          Continue(
            x.frontier.fold(
              { seen: x.seen, frontier: [] },
              |y: { seen: Map<Bytes, List<Bytes>>, frontier: List<{ at: Bytes, path: List<Bytes> }> }, f: { at: Bytes, path: List<Bytes> }|
                if y.seen.contains(f.at) { y } else {
                  {
                    seen: y.seen.insert(f.at, f.path),
                    frontier: y.frontier.concat(
                      next(f.at).map(|n: Bytes| { at: n, path: f.path.push(f.at) }),
                    ),
                  }
                },
            ),
          )
        },
    );
  own.sort_by(|a: Bytes, b: Bytes| match compare_values(a, b) { Greater -> false, _ -> true }).fold(
    { done: Map::new(), out: [] },
    |accumulator: { done: Map<Bytes, Bool>, out: List<CheckedModule> }, m: Bytes|
      if accumulator.done.contains(m) { accumulator } else {
        match paths(m).get(m) {
          None -> accumulator,
          Some(path) -> {
            let closing = path.get(path.len() - 1);
            let span = List::fold(
              match edges.get(closing) { Some(es) -> es, None -> [] },
              dummy_span,
              |s: Span, i: ImportOf| if i.named.module == m { i.span } else { s },
            );
            let diagnostic = if path.len() == 1 {
              error_at(
                b"E0109",
                0,
                span,
                Bytes::concat_all([b"module `", m, b"` imports itself"]),
                b"a module cannot import itself",
                [b"every name a module declares is already in scope in its own file"],
              )
            } else {
              error_at(
                b"E0109",
                0,
                span,
                Bytes::concat_all([
                  b"module cycle: ",
                  backticked(path, b" -> "),
                  b" -> `",
                  m,
                  b"`",
                ]),
                b"this import closes the cycle",
                [
                  b"each of these has to be checked before the next, and the last before the first, so there is no order to check them in",
                  b"move what they share into a module that all of them import",
                ],
              )
            };
            {
              done: path.fold(accumulator.done, |d: Map<Bytes, Bool>, p: Bytes| d.insert(p, true)),
              out: accumulator.out.push({
                module: closing,
                result: { ..absent(closing), rejected: [diagnostic] },
              }),
            }
          },
        }
      },
  ).out
}

pub fn entry_hash(module: Bytes, name: Bytes) -> Option<Bytes> / {memo.read, abort.raise} =
  if module.len() == 0 { None } else {
    module_hashes({ module: module, shipped: false, tested: false }).cached.nodes.fold(
      None,
      |accumulator: Option<Bytes>, f: CachedNode|
        if !f.declaration && f.name == name { Some(f.hash) } else { accumulator },
    )
  }

pub fn root_warnings(results: List<CheckedModule>, root: Int) -> List<Diagnostic> =
  range(0, root).fold([], |accumulator: List<Diagnostic>, i: Int|
    match results.at(i) {
      None -> accumulator,
      Some(a) -> accumulator.concat(a.result.warnings.map(|d: Diagnostic| placed_in(d, i))),
    })

pub fn rejected_first(results: List<CheckedModule>) -> List<CheckedModule> = {
  let rejected = results.fold(Map::new(), |accumulator: Map<Bytes, Bool>, a: CheckedModule|
    if a.result.rejected.len() > 0 { accumulator.insert(a.module, true) } else { accumulator });
  results.filter(|a: CheckedModule|
    a.result.rejected.len() > 0
      && !a.result.imports.fold(false, |b: Bool, m: Bytes| b || rejected.contains(m)))
}

pub type OutcomeSummary = | RejectionSummary(List<Bytes>) | PublicationSummary(Published)

pub fn outcome_summary(outcome: AnalysisOutcome) -> OutcomeSummary / {abort.raise} =
  match outcome {
    Rejected(ds) ->
      RejectionSummary(
        ds.map(|d: Diagnostic| Bytes::concat_all([d.code, b": ", d.message])).sort_by(
          |a: Bytes, b: Bytes| match compare_values(a, b) { Greater -> false, _ -> true },
        ),
      ),
    Analysed(_) -> PublicationSummary(published(outcome)),
  }

pub fn reject_embed(package: Int, module: Bytes, want: EmbedRequest) -> EmbedBytesResult =
  Err(b"no file is there")

pub fn nothing_derived(kind: Bytes, at: Bytes) -> Option<Bytes> = None

pub fn over_decoding<a | e>(
  store: MemoryStore,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {RunEffects, abort.raise},
) -> { store: MemoryStore, value: a } / {abort.raise | e} =
  with_memory_store(store, read, world, look, || with_decode_cache(work))

pub fn queried_over(
  store: MemoryStore,
  sources: List<Source>,
) -> { store: MemoryStore, run: Run, outcome: AnalysisOutcome, fixing: CachedHashes, results: List<CheckedModule> } / {abort.raise} =
  queried_under(fresh_registry(), store, sources)

pub fn queried_results(
  qs: CheckQueries,
  store: MemoryStore,
  sources: List<Source>,
) -> { store: MemoryStore, run: Run, fixing: CachedHashes, results: List<CheckedModule> } / {abort.raise} = {
  let w = inputs_alone(sources);
  let done = over_decoding(
    store,
    prelude_frames,
    prelude_files,
    |kind: Bytes, at: Bytes| lookup_input_alone(w, kind, at),
    || query_alone(qs, w),
  );
  { store: done.store, run: done.value.run, fixing: done.value.fixing, results: done.value.results }
}

pub fn queried_under(
  qs: CheckQueries,
  store: MemoryStore,
  sources: List<Source>,
) -> { store: MemoryStore, run: Run, outcome: AnalysisOutcome, fixing: CachedHashes, results: List<CheckedModule> } / {abort.raise} = {
  let done = queried_results(qs, store, sources);
  {
    store: done.store,
    run: done.run,
    fixing: done.fixing,
    results: done.results,
    outcome: outcome_of(sources, done.results),
  }
}

pub const prelude_files: Bytes = b"the shipped files"

pub const prelude_pack: Option<packs::PackFiles> = pack_of(shipped_store([]))

pub fn prelude_frames(path: String, offset: Int, len: Int) -> Option<Bytes> / {abort.raise} =
  packs::frame_in(prelude_pack, path, offset, len)

pub fn read_over<a>(
  sources: List<Source>,
  work: () -> a / {SessionReads, abort.raise},
) -> a / {abort.raise} = {
  let w = inputs_alone(sources);
  let qs = fresh_registry();
  over_decoding(
    empty_memory_store,
    prelude_frames,
    prelude_files,
    |kind: Bytes, at: Bytes| lookup_input_alone(w, kind, at),
    || in_session(qs, |run: Run| reading(qs, run, work)),
  ).value
}

pub fn inputs_alone(sources: List<Source>) -> LoadInputs / {abort.raise} =
  load_inputs_of(
    {
      root: b"",
      manifest: None,
      files: sources.map(|s: Source| { module: s.name, text: s.source_text }),
    },
    [],
  )

pub fn lookup_input_alone(w: LoadInputs, kind: Bytes, at: Bytes) -> Option<Bytes> / {abort.raise} =
  lookup_input_shipping(w, [], kind, at)

pub fn lookup_input_shipping(
  w: LoadInputs,
  shipped: List<Source>,
  kind: Bytes,
  at: Bytes,
  derived: (Bytes, Bytes) -> Option<Bytes> / {abort.raise} = nothing_derived,
) -> Option<Bytes> / {abort.raise} = {
  let all = with_prelude_source(shipped);
  let source_text = |name: Bytes|
    match all.find(|s: Source| s.name == name) { Some(s) -> Some(s.source_text), None -> None };
  lookup_input(
    w,
    source_text,
    source_text,
    || all.map(|s: Source| s.name),
    reject_embed,
    derived,
    kind,
    at,
  )
}

fn hashed_load(
  own: List<Bytes>,
) -> { results: List<CheckedModule>, fixing: CachedHashes } / {memo.read, abort.raise} = {
  let all = query_load(own, [], false, module_of);
  {
    results: all.results,
    fixing: if all.results.any(|a: CheckedModule| a.result.rejected.len() > 0) { no_cached_hashes }
    else { joined_cached_hashes(hashed_all(own, all.pulled, false)) },
  }
}

fn query_alone(
  qs: CheckQueries,
  w: LoadInputs,
) -> { run: Run, results: List<CheckedModule>, fixing: CachedHashes } / {RunEffects, abort.raise} =
  in_session(qs, |run: Run| {
    let done = reading(qs, run, || hashed_load(w.own));
    {
      run: done.run,
      value: { run: done.run, results: done.value.results, fixing: done.value.fixing },
    }
  })

pub fn outcome_of(
  sources: List<Source>,
  results: List<CheckedModule>,
) -> AnalysisOutcome / {abort.raise} =
  match rejected_first(results) {
    [] ->
      analyse_with(
        parse_all(sources),
        results.fold(no_rows, |accumulator: Rows, a: CheckedModule| {
          let r = rows_of_result(a.result);
          {
            definitions: accumulator.definitions.concat(r.definitions),
            tests: accumulator.tests.concat(r.tests),
            laws: accumulator.laws.concat(r.laws),
            types: tables_joined(accumulator.types, r.types),
          }
        }),
      ),
    first ->
      Rejected(
        first.fold([], |accumulator: List<Diagnostic>, a: CheckedModule|
          accumulator.concat(a.result.rejected)),
      ),
  }

pub type StoreSharing = | Alone | Concurrent | Turns

fn queried_in(
  tree: fs::MemFs,
  sources: List<Source>,
  company: StoreSharing,
  nth: Int,
) -> { tree: fs::MemFs, run: Run, outcome: AnalysisOutcome, fixing: CachedHashes } / {abort.raise} = {
  let w = inputs_alone(sources);
  let fresh = fresh_registry();
  let qs = if company != Turns { fresh } else {
    {
      ..fresh,
      named: fresh.named.insert(b"spare", {
        name: b"spare",
        hash: if nth % 2 == 1 { b"odd" } else { b"even" },
        body: |input: Bytes| input,
        persistent: true,
        product: None,
      }),
    }
  };
  let done = fs::on_mem[abs](tree, ||
    handle {
      memo_files::with_memo_store[abs](
        "s",
        prelude_frames,
        prelude_files,
        |kind: Bytes, at: Bytes| {
          if raced.is_first_lookup() {
            memo_files::with_memo_store[abs](
              "s",
              prelude_frames,
              prelude_files,
              |k: Bytes, a: Bytes| lookup_input_alone(w, k, a),
              || with_decode_cache(|| query_alone(qs, w).run),
            );
            ()
          };
          lookup_input_alone(w, kind, at)
        },
        || with_decode_cache(|| query_alone(qs, w)),
      ).value
    } with {
      var begun = company != Concurrent,
      raced.is_first_lookup() -> {
        let first = !begun;
        begun = true;
        first
      },
    });
  {
    tree: done.tree,
    run: done.value.run,
    fixing: done.value.fixing,
    outcome: outcome_of(sources, done.value.results),
  }
}

effect raced {
  write is_first_lookup() -> Bool
}

pub fn files_differing(steps: List<Step>, company: StoreSharing) -> List<Bytes> / {abort.raise} =
  range(0, steps.len()).fold(
    { tree: fs::mem_of([]), store: empty_memory_store, off: [] },
    |s: { tree: fs::MemFs, store: MemoryStore, off: List<Bytes> }, i: Int| {
      let step = steps.get(i);
      let recorded = queried_in(s.tree, step.sources, company, i);
      let queried = queried_over(s.store, step.sources);
      let agrees = outcome_summary(recorded.outcome) == outcome_summary(queried.outcome)
        && recorded.fixing == queried.fixing;
      {
        tree: recorded.tree,
        store: queried.store,
        off: if agrees { s.off } else { s.off.push(step.what) },
      }
    },
  ).off

pub type Step = { what: Bytes, sources: List<Source> }

test "every query whose results the toolchain ships caches its results" {
  assert_eq(shipped_queries.filter(|n: Bytes| digest_only_queries.contains(n)), [])
}

fn stored_results(name: Bytes) -> List<Bytes> / {abort.raise} = {
  let store = check_sources(
    empty_memory_store,
    layered(b"pub fn step(n: Int) -> Int = n + 1\n"),
    [],
  ).store;
  memo::fact_records(store).fold([], |accumulator: List<Bytes>, _key: Bytes, r: memo::FactRecord|
    if r.query != name { accumulator } else {
      match store.outputs.get(r.output) { Some(out) -> accumulator.push(out), None -> accumulator }
    })
}

fn results_round_trip<a>(results: List<Bytes>, codec: bin::BinCodec<a>) -> Bool / {abort.raise} =
  results.len() > 0
    && results.fold(true, |ok: Bool, b: Bytes| {
      let value = decoded(b, codec, "a cached result");
      ok && bin::encode(value, codec) == b && bin::round_trips(value, codec)
    })

test "a module's result reads back as it was recorded" {
  assert(results_round_trip(stored_results(module_query), module_result_bin()))
}

test "a module's definition list decodes to the same value that was stored" {
  assert(results_round_trip(stored_results(owners_query), owners_result_bin()))
}

test "a group's hashes decode to the same value that was stored" {
  assert(results_round_trip(stored_results(group_hash_query), group_hashes_bin()))
}

test "a module's imports read back as they were recorded" {
  assert(results_round_trip(stored_results(imports_query), imports_of_bin()))
}

test "a module's hashes read back as they were recorded" {
  assert(results_round_trip(stored_results(hashes_query), hash_result_bin()))
}

fn embedding_queried(
  source_text: Bytes,
  files: Map<Bytes, Bytes>,
) -> { store: MemoryStore, results: List<CheckedModule>, fixing: CachedHashes } / {abort.raise} = {
  let w = inputs_alone([{ name: b"m", source_text: source_text }]);
  let none = |name: Bytes| None;
  let read = |package: Int, module: Bytes, want: EmbedRequest|
    match files.get(want.path) {
      Some(bytes) -> Ok([{ name: b"", bytes: bytes }]),
      None -> Err(b"no file is there"),
    };
  let done = over_decoding(
    empty_memory_store,
    packs::no_pack,
    b"",
    |kind: Bytes, at: Bytes| lookup_input(w, none, none, || [], read, nothing_derived, kind, at),
    || query_alone(fresh_registry(), w),
  );
  { store: done.store, results: done.value.results, fixing: done.value.fixing }
}

fn fixed_hash(fixing: CachedHashes, name: Bytes) -> Option<Bytes> =
  fixing.nodes.fold(None, |accumulator: Option<Bytes>, f: CachedNode|
    if f.name == name { Some(f.hash) } else { accumulator })

const two_embeds: Bytes =
  b"pub fn a() -> Bytes = embed(\"a.bin\")\npub fn b() -> Bytes = embed(\"b.bin\")\n"

test "a module's stored results refer to an embedded file by its digest and never contain the file's bytes" {
  let line = Bytes::concat_all(range(0, 10).map(|_: Int| b"0123456789"));
  let big = Bytes::concat_all(
    range(0, 1000).map(|i: Int| Bytes::concat_all([Bytes::of_string(i.to_string()), b":", line])),
  );
  let source_text = b"pub fn data() -> Bytes = embed(\"big.bin\")\npub fn size() -> Int = data().len()\ntest \"sized\" { assert(size() > 0) }\n";
  let done = embedding_queried(source_text, Map::new().insert(b"big.bin", big));
  assert_eq(rejected_first(done.results), []);
  assert(fixed_hash(done.fixing, b"m.data") != None);
  assert_eq(
    done.results.map(|a: CheckedModule| a.result.shape.embeds.map(|e: ModuleEmbed| e.read)),
    [[Ok([embed_file(b"", big)])]],
  );
  let largest = done.store.outputs.fold(0, |most: Int, _: Bytes, result: Bytes|
    if result.len() > most { result.len() } else { most });
  assert(
    largest < big.len() / 10,
    Some(
      "a result of " ++ largest.to_string() ++ " bytes, beside a file of " ++ big.len().to_string(),
    ),
  )
}

test "changing an embedded file's bytes changes the hash of the definition that embeds it and of no other definition" {
  let over = |a: Bytes, b: Bytes|
    embedding_queried(two_embeds, Map::new().insert(b"a.bin", a).insert(b"b.bin", b)).fixing;
  let first = over(b"one", b"two");
  let moved = over(b"one", b"three");
  assert(fixed_hash(first, b"m.a") != None);
  assert_eq(fixed_hash(moved, b"m.a"), fixed_hash(first, b"m.a"));
  assert(fixed_hash(moved, b"m.b") != fixed_hash(first, b"m.b"));
  let same = over(b"one", b"one");
  assert_eq(fixed_hash(same, b"m.a"), fixed_hash(same, b"m.b"))
}

fn embed_from_files<[r]>(
  want: EmbedRequest,
) -> EmbedBytesResult / {fs.read[r], embed_snapshot.read, embed_snapshot.write} =
  snapshot_embed(want.path, ||
    match fs.read_file[r](String::of_bytes_lossy(want.path)) {
      Some(bytes) -> Ok([{ name: b"", bytes: bytes }]),
      None -> Err(b"no file is there"),
    })

fn session_over_embeds<[r]>(
  checks: Bool,
) -> Option<Bytes> / {fs.read[r], fs.write[r], embed_snapshot.read, embed_snapshot.write, abort.raise} = {
  let w = inputs_alone([{ name: b"m", source_text: two_embeds }]);
  let none = |name: Bytes| None;
  let read = |package: Int, module: Bytes, want: EmbedRequest| embed_from_files[r](want);
  let qs = fresh_registry();
  memo_files::with_memo_store[r](
    "s",
    packs::no_pack,
    b"",
    |kind: Bytes, at: Bytes| lookup_input(w, none, none, || [], read, nothing_derived, kind, at),
    ||
      with_decode_cache(||
        if checks { fixed_hash(query_alone(qs, w).fixing, b"m.a") }
        else { in_session(qs, |run: Run| { run: run, value: None }) }),
  ).value
}

test "a third session in a command reads the embedded file the second session read first, and the next command reads the saved file" {
  let files = fs::mem_of([{ path: "a.bin", body: b"one" }, { path: "b.bin", body: b"two" }]);
  let command = fs::on_mem[abs](files, ||
    with_embed_snapshot(|| {
      let first = session_over_embeds[abs](false);
      let second = session_over_embeds[abs](true);
      fs.write_file[abs]("a.bin", b"saved");
      { first: first, second: second, third: session_over_embeds[abs](true) }
    }));
  let next = fs::on_mem[abs](command.tree, ||
    with_embed_snapshot(|| session_over_embeds[abs](true)));
  assert_eq(command.value.first, None);
  assert(command.value.second != None);
  assert_eq(command.value.third, command.value.second);
  assert(next.value != command.value.second)
}

type CheckedSources = {
  store: MemoryStore,
  run: Run,
  results: List<CheckedModule>,
  cached_hashes: CachedHashes,
  warnings: List<Diagnostic>,
  fetched: List<Bytes>,
}

pub fn check_sources(
  store: MemoryStore,
  sources: List<Source>,
  shipped: List<Source>,
  derived: (Bytes, Bytes) -> Option<Bytes> / {abort.raise} = nothing_derived,
) -> CheckedSources / {abort.raise} =
  check_with_pack(store, prelude_pack, sources, shipped, derived: derived)

pub fn check_with_pack(
  store: MemoryStore,
  packed: Option<packs::PackFiles>,
  sources: List<Source>,
  shipped: List<Source>,
  derived: (Bytes, Bytes) -> Option<Bytes> / {abort.raise} = nothing_derived,
) -> CheckedSources / {abort.raise} =
  check_under(fresh_registry(), store, packed, sources, shipped, derived)

pub fn check_under(
  qs: CheckQueries,
  store: MemoryStore,
  packed: Option<packs::PackFiles>,
  sources: List<Source>,
  shipped: List<Source>,
  derived: (Bytes, Bytes) -> Option<Bytes> / {abort.raise},
) -> CheckedSources / {abort.raise} = {
  let w = load_inputs_of(
    {
      root: b"",
      manifest: None,
      files: sources.map(|s: Source| { module: s.name, text: s.source_text }),
    },
    [],
  );
  handle {
    let done = over_decoding(
      store,
      |path: String, offset: Int, len: Int| {
        let found = packs::frame_in(packed, path, offset, len);
        match found { Some(b) -> fetching.fetched(b), None -> () };
        found
      },
      prelude_files,
      |kind: Bytes, at: Bytes| lookup_input_shipping(w, shipped, kind, at, derived: derived),
      || {
        in_session(qs, |run: Run| {
          let done = reading(qs, run, || {
            let all = query_load(w.own, [], false, module_of);
            {
              results: all.results,
              fixing: joined_cached_hashes(hashed_all(w.own, all.pulled, false)),
            }
          });
          {
            run: done.run,
            value: {
              run: done.run,
              results: done.value.results,
              fixing: done.value.fixing,
              warnings: root_warnings(done.value.results, sources.len()),
            },
          }
        })
      },
    );
    {
      store: done.store,
      run: done.value.run,
      results: done.value.results,
      fixing: done.value.fixing,
      warnings: done.value.warnings,
    }
  } with {
    var fetched: List<Bytes> = [],
    fetching.fetched(b) -> {
      fetched = fetched.push(b);
    },
    return d ->
      {
        store: d.store,
        run: d.run,
        results: d.results,
        cached_hashes: d.fixing,
        warnings: d.warnings,
        fetched: fetched,
      },
  }
}

effect fetching {
  write fetched(b: Bytes) -> Unit
}

pub fn layered(lib: Bytes) -> List<Source> =
  [
    { name: b"lib", source_text: lib },
    { name: b"app", source_text: b"import lib\npub fn go(n: Int) -> Int = lib::step(n) + 1\n" },
    { name: b"aside", source_text: b"pub fn alone() -> Int = 7\n" },
  ]

test "a program whose imported module has a broken signature reports that module's error and no other" {
  let sources = [
    { name: b"lib", source_text: b"pub fn broken(n: Missing) -> Int = 1\n" },
    { name: b"app", source_text: b"import lib\npub fn go(n: Int) -> Int = lib::broken(n)\n" },
  ];
  assert_eq(
    outcome_summary(queried_over(empty_memory_store, sources).outcome),
    outcome_summary(analyse(parse_all(sources))),
  )
}

test "a comparison looks inside a type that another module declares" {
  let sources = [
    { name: b"lib", source_text: b"pub type Held = { run: () -> Int }\n" },
    {
      name: b"app",
      source_text: b"import lib\npub fn same(a: lib::Held, b: lib::Held) -> Bool = a == b\n",
    },
  ];
  assert_eq(
    outcome_summary(queried_over(empty_memory_store, sources).outcome),
    outcome_summary(analyse(parse_all(sources))),
  )
}

test "arithmetic works on a numeric type that another group declares" {
  let sources = [
    {
      name: b"m",
      source_text: Bytes::concat_all([
        b"pub type Length = | Metres(Int)\n",
        b"key for Length by metres\n",
        b"numeric for Length by { add: plus, sub: minus, mul: times, neg: negated, of_int: length }\n",
        b"fn length(n: Int) -> Length = Metres(n)\n",
        b"fn metres(l: Length) -> Int = match l { Metres(n) -> n }\n",
        b"fn plus(a: Length, b: Length) -> Length = Metres(metres(a) + metres(b))\n",
        b"fn minus(a: Length, b: Length) -> Length = Metres(metres(a) - metres(b))\n",
        b"fn times(a: Length, b: Length) -> Length = Metres(metres(a) * metres(b))\n",
        b"fn negated(a: Length) -> Length = Metres(0 - metres(a))\n",
        b"pub fn doubled(l: Length) -> Length = l + l\n",
      ]),
    },
  ];
  assert_eq(
    outcome_summary(queried_over(empty_memory_store, sources).outcome),
    outcome_summary(analyse(parse_all(sources))),
  )
}

test "a group that calls a group with a type error is checked against its written signature, and the module reports the same errors as a whole-module check" {
  let source = |body: Bytes|
    [
      {
        name: b"lib",
        source_text: Bytes::concat_all([
          b"pub fn base(n: Int) -> Int = ",
          body,
          b"\n\npub fn over(n: Int) -> Int = base(n) + 1\n\npub fn top(n: Int) -> Int = over(n) * 2\n\n",
          b"pub fn apart(n: Int) -> Int = n - 1\n",
        ]),
      },
    ];
  let cold = queried_over(empty_memory_store, source(b"n + 1"));
  let broken = queried_over(cold.store, source(b"n + true"));
  assert_eq(
    outcome_summary(broken.outcome),
    outcome_summary(analyse(parse_all(source(b"n + true")))),
  )
}

pub fn shipped_store(shipped: List<Source>) -> MemoryStore / {abort.raise} =
  shipped_store_results(shipped).store

fn shipped_store_results(
  shipped: List<Source>,
) -> { store: MemoryStore, value: List<CheckedModule> } / {abort.raise} = {
  let nowhere = load_inputs_of({ root: b"", manifest: None, files: [] }, []);
  over_decoding(
    empty_memory_store,
    packs::no_pack,
    b"",
    |kind: Bytes, at: Bytes| lookup_input_shipping(nowhere, shipped, kind, at),
    || {
      let qs = fresh_registry();
      in_session(qs, |run: Run|
        reading(qs, run, ||
          check_shipped_modules(with_prelude_source(shipped).map(|s: Source| s.name))))
    },
  )
}

test "computing the shipped modules' results names each one that fails" {
  let rejected = shipped_store_results([
    { name: b"std.a", source_text: b"pub fn a() -> Int = 1\n" },
    { name: b"std.b", source_text: b"import std.a (a)\n\npub fn b() -> Int = a(2)\n" },
  ]).value;
  assert_eq(rejected.map(|x: CheckedModule| x.module), [b"std.b"]);
  assert_eq(rejected.map(|x: CheckedModule| x.result.rejected.map(|d: Diagnostic| d.code)), [
    [b"E0202"],
  ])
}

test "a compiler module imports another below the compiler's root by its full name" {
  let shipped = [
    { name: b"compiler.syntax.base", source_text: b"pub fn one() -> Int = 1\n" },
    {
      name: b"compiler.check.user",
      source_text: b"import compiler.syntax.base (one)\n\npub fn two() -> Int = one() + one()\n",
    },
  ];
  let rejected = shipped_store_results(shipped).value;
  assert_eq(rejected.map(|x: CheckedModule| x.result.rejected.map(|d: Diagnostic| d.code)), []);
  let user = [
    {
      name: b"main",
      source_text: b"import compiler.check.user (two)\npub fn main() -> Int = two()\n",
    },
  ];
  let f = check_sources(empty_memory_store, user, shipped);
  assert_eq(
    f.results.fold([], |accumulator: List<Diagnostic>, a: CheckedModule|
      accumulator.concat(a.result.rejected)),
    [],
  )
}

pub fn pack_of(store: MemoryStore) -> Option<packs::PackFiles> / {abort.raise} = {
  let records = memo::fact_records(store);
  let wanted = shipped_queries.fold(Map::new(), |found: Map<Bytes, Bool>, name: Bytes|
    found.insert(name, true));
  Some(
    memo::pack_memory_store(
      {
        ..store,
        facts: records.fold(
          Map::new(),
          |accumulator: Map<Bytes, memo::StoredFact>, k: Bytes, r: memo::FactRecord|
            match store.facts.get(k) {
              Some(f) -> {
                let writer = match records.get(f.written_by) {
                  Some(w) -> Some(w.query),
                  None -> None,
                };
                if memo::packs_fact(wanted, r.query, writer) { accumulator.insert(k, f) }
                else { accumulator }
              },
              None -> accumulator,
            },
        ),
      },
      fresh_registry(),
      prelude_files,
    ),
  )
}

test "a module whose text fails to parse outside its items is rejected with the parse error" {
  let checked = check_sources(
    empty_memory_store,
    [{ name: b"m", source_text: b"fn f() -> Int = 1\n\n/// below nothing\n" }],
    [],
  );
  assert_eq(
    checked.results.flat_map(|a: CheckedModule| a.result.rejected.map(|d: Diagnostic| d.code)),
    [b"E0003"],
  )
}

test "a cycle whose signatures are rejected reports each error once" {
  let codes = |text: String|
    check_sources(
      empty_memory_store,
      [{ name: b"m", source_text: Bytes::of_string(text) }],
      [],
    ).results.flat_map(|a: CheckedModule| a.result.rejected.map(|d: Diagnostic| d.code));
  assert_eq(
    codes(
      \\type Box = | Box(Int, Int)
      \\fn area(b: Box) -> Int = match b { Box(w, h) -> w * h }
      \\fn width(b: Box) -> Int = match b { Box(w, _) -> w }
      \\key for Box by area
      \\key for Box by width
      \\
    ),
    [b"E0105"],
  );
  assert_eq(
    codes(
      \\effect set Web = {Storage, abort.raise}
      \\effect set Storage = {Web}
      \\fn report() -> Int / {Web} = 1
      \\
    ),
    [b"E0115"],
  )
}

test "an effect set cycle and a type error in a function that uses the set are both reported" {
  let codes = check_sources(
    empty_memory_store,
    [
      {
        name: b"m",
        source_text: b"effect set Web = {Storage, abort.raise}\neffect set Storage = {Web}\nfn report() -> Int / {Web} = true\n",
      },
    ],
    [],
  ).results.flat_map(|a: CheckedModule| a.result.rejected.map(|d: Diagnostic| d.code)).sort(
  );
  assert_eq(codes, [b"E0115", b"E0201"])
}

test "a failed import is reported once, uses of its names are not, and other errors still are" {
  let codes = check_sources(
    empty_memory_store,
    [
      {
        name: b"m",
        source_text: b"import nowhere (f)\nimport elsewhere\nfn g() -> Int = f() + elsewhere::h()\nfn k() -> Int = true\n",
      },
    ],
    [],
  ).results.flat_map(|a: CheckedModule| a.result.rejected.map(|d: Diagnostic| d.code)).sort(
  );
  assert_eq(codes, [b"E0106", b"E0106", b"E0201"])
}

test "a `const` that reads itself, holds a function or performs an effect is rejected with one E0156" {
  let codes = |text: Bytes|
    check_sources(empty_memory_store, [{ name: b"m", source_text: text }], []).results.flat_map(
      |a: CheckedModule| a.result.rejected.map(|d: Diagnostic| d.code),
    );
  assert_eq(codes(b"const f: Int = f + 1\n"), [b"E0156"]);
  assert_eq(codes(b"const f: (Int) -> Int = |x: Int| x\n"), [b"E0156"]);
  assert_eq(codes(b"effect ticks { read now() -> Int }\n\nconst f: Int = ticks.now()\n"), [
    b"E0156",
  ]);
  assert_eq(
    codes(
      b"const f: Int = 1\n\nfn const(const: Int) -> Int = const + f\n\nfn main() -> Int = const(2)\n",
    ),
    [],
  )
}

test "an opaque record from another module cannot be built from a literal, and the error names its maker" {
  let lib = {
    name: b"lib",
    source_text: b"pub opaque type Id = new { octets: Bytes }\npub fn id_of(octets: Bytes) -> Option<Id> = Some({ octets: octets })\npub fn shown(u: Id) -> Int = u.octets.len()\n",
  };
  let rejected = |use_site: Bytes|
    check_sources(
      empty_memory_store,
      [
        lib,
        {
          name: b"app",
          source_text: Bytes::concat_all([
            b"import lib (Id, shown)\npub fn f(b: Bytes) -> Int = {\n  let u",
            use_site,
            b" = { octets: b };\n  shown(u)\n}\n",
          ]),
        },
      ],
      [],
    ).results.flat_map(|a: CheckedModule| a.result.rejected);
  let closed = rejected(b": Id");
  assert_eq(closed.map(|d: Diagnostic| d.code), [b"E0220"]);
  assert(
    closed.any(|d: Diagnostic| d.notes_text.any(|n: Bytes| n.index_of(b"id_of") != None)),
    Some(
      String::of_bytes_lossy(Bytes::join(closed.flat_map(|d: Diagnostic| d.notes_text), b" | ")),
    ),
  );
  let mismatched = rejected(b"");
  assert_eq(mismatched.map(|d: Diagnostic| d.code), [b"E0201"])
}

test "a module with an error in one group still reports the warnings of its other groups" {
  let codes = |text: String|
    check_sources(
      empty_memory_store,
      [{ name: b"m", source_text: Bytes::of_string(text) }],
      [],
    ).results.flat_map(|a: CheckedModule|
      a.result.rejected.concat(a.result.warnings).map(|d: Diagnostic| d.code)).sort(
    );
  let handled =
    \\effect io {
    \\  read get(n: Int) -> Int
    \\}
    \\pub fn touch(c: Int) -> Int / {io.get} = io.get(c)
    \\test "one operation, twice" {
    \\  handle { assert_eq(touch(3), 0) } with {
    \\    io.get(n) -> 0,
    \\    io.get(n) -> 1,
    \\  }
    \\}
    \\
  ;
  assert_eq([codes(handled), codes(handled ++ "pub fn boom() -> Int = nope(1)\n")], [
    [b"E0105"],
    [b"E0101", b"E0105"],
  ])
}

test "a function whose type parameter is named like a rejected function is checked and callable" {
  let rejected = check_sources(
    empty_memory_store,
    [
      { name: b"n", source_text: b"pub type Wrapper = W(Float)\n" },
      {
        name: b"m",
        source_text: b"import n\nfn a() -> Map<n::Wrapper, Int> = Map::new()\nfn needs<a>(x: a) -> Int = 1\nfn i() -> Int = needs(1)\n",
      },
    ],
    [],
  ).results.flat_map(|c: CheckedModule| c.result.rejected.map(|d: Diagnostic| d.code));
  assert_eq(rejected, [b"E0206"])
}

test "a group that reads a rejected unit of its module still reports its own error" {
  let text = "type Count = Int\n\ntype Span = new { from: Int, to: Int }\n\nfn more(a: Count, b: Count) -> Count = a\n\nnumeric for Count by { add: more, sub: more, mul: more, neg: more, of_int: more }\n\nnumeric for Span by { add: more, sub: more, mul: more, neg: more, of_int: more }\n";
  let rejected = check_sources(
    empty_memory_store,
    [{ name: b"m", source_text: Bytes::of_string(text) }],
    [],
  ).results.flat_map(|a: CheckedModule| a.result.rejected.map(|d: Diagnostic| d.message));
  assert_eq(rejected, [
    b"`Count` is not a sum, and a `numeric` must be a sum",
    b"`Span` is a `new` record, which cannot state a `numeric` yet",
  ])
}

test "a group's fix edits the module's file where its warning points" {
  let text =
    \\import lib
    \\
    \\effect io {
    \\  read get(n: Int) -> Int
    \\}
    \\pub fn quiet() -> Int / {io.get} = lib::first()
    \\
  ;
  let source = Bytes::of_string(text);
  let warned = check_sources(
    empty_memory_store,
    [
      { name: b"lib", source_text: b"pub fn first() -> Int = 1\n" },
      { name: b"m", source_text: source },
    ],
    [],
  ).results.filter(|a: CheckedModule| a.module == b"m").flat_map(|a: CheckedModule|
    a.result.warnings).filter(|d: Diagnostic| d.code == b"W0614");
  assert(warned.len() == 1);
  let edits = warned.get(0).fixes.flat_map(|f: Fix| f.edits);
  assert(edits.len() > 0);
  assert(edits.all(|e: Edit| e.module == warned.get(0).labels.get(0).module));
  assert_eq(edits.map(|e: Edit| source.slice(e.start, e.end)), [b" / {io.get}"])
}

test "a program checked over a prebuilt store of shipped results gives the result of a check from scratch" {
  let shipped = [
    {
      name: b"std.pair",
      source_text: b"pub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n\npub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n\npub fn both(n: Int) -> Bool = even(n) || odd(n)\n",
    },
  ];
  let user = [
    { name: b"main", source_text: b"import std.pair (both)\npub fn main() -> Bool = both(3)\n" },
  ];
  let load = check_with_pack(empty_memory_store, pack_of(shipped_store(shipped)), user, shipped);
  assert_eq(load.results, check_sources(empty_memory_store, user, shipped).results)
}

test "a shipped module's imports are checked as an importing module sees them, ignoring imports used only by its tests" {
  let user = [
    { name: b"main", source_text: b"import std.a (two)\npub fn main() -> Int = two()\n" },
  ];
  let shipped = [
    {
      name: b"std.a",
      source_text: b"import std.b (one)\nimport std.c (spare)\n\npub fn two() -> Int = one() + one()\ntest \"spared\" { assert_eq(spare(), 3) }\n",
    },
    { name: b"std.b", source_text: b"pub fn one() -> Int = 1\n" },
    { name: b"std.c", source_text: b"pub fn spare() -> Int = 3\n" },
  ];
  let f = check_sources(empty_memory_store, user, shipped);
  assert_eq(
    f.results.fold([], |accumulator: List<Diagnostic>, a: CheckedModule|
      accumulator.concat(a.result.rejected)),
    [],
  )
}

test "a module reports the errors of a definition with an error, and none from the definitions that call it" {
  let sources = [
    {
      name: b"app",
      source_text: b"fn pick() -> Int = missing()\n\nfn read() -> Int = 1\n\nfn main() -> Int = pick() + read()\n",
    },
  ];
  let f = check_sources(empty_memory_store, sources, []);
  assert_eq(
    f.results.fold([], |accumulator: List<Bytes>, a: CheckedModule|
      accumulator.concat(a.result.rejected.map(|d: Diagnostic| d.message))),
    [b"unknown name `missing`"],
  )
}

test "an import of a module that does not exist fails the importing module even when nothing uses the import" {
  let sources = [{ name: b"app", source_text: b"import nonesuch\npub fn f() -> Int = 1\n" }];
  let f = check_sources(empty_memory_store, sources, []);
