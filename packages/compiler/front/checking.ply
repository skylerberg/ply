pub type PackageFile = { module: Bytes, text: Bytes }

pub type OwnPackage = { root: Bytes, manifest: Option<Bytes>, files: List<PackageFile> }

pub type LoadInputs = {
  layout: Bytes,
  places: Map<Bytes, Bytes>,
  texts: Map<Bytes, Bytes>,
  own: List<Bytes>,
  dependencies: List<Bytes>,
}

fn embedding_of(read: EmbedBytesResult) -> Embedding =
  match read {
    Ok(files) -> { files: files.map(|f: EmbedBytes| embed_file(f.name, f.bytes)), rejected: None },
    Err(reason) -> { files: [], rejected: Some(reason) },
  }

pub fn load_inputs_of(
  root: OwnPackage,
  dependencies: List<OwnPackage>,
) -> LoadInputs / {abort.raise} = {
  let j = read_packages(
    {
      root: root.root,
      manifest: root.manifest,
      supplied: dependencies.map(|p: OwnPackage|
        { root: p.root, manifest: p.manifest, modules: [] }),
    },
    root.files.map(|f: PackageFile| f.module),
  );
  let placed = range(0, dependencies.len() + 1).fold(
    [],
    |accumulator: List<{ name: Bytes, placing: PackageLocation, text: Bytes }>, k: Int| {
      let p = if k == 0 { root } else { dependencies.get(k - 1) };
      let prefix = prefix_in(j, k);
      p.files.fold(
        accumulator,
        |a: List<{ name: Bytes, placing: PackageLocation, text: Bytes }>, f: PackageFile|
          a.push({
            name: if prefix.len() == 0 { f.module }
            else { Bytes::concat_all([prefix, b".", f.module]) },
            placing: { package: k, relative: f.module },
            text: f.text,
          }),
      )
    },
  );
  {
    layout: bin::encode(without_locations(j), validated_packages_bin()),
    places: placed.fold(
      Map::new(),
      |accumulator: Map<Bytes, Bytes>, x: { name: Bytes, placing: PackageLocation, text: Bytes }|
        accumulator.insert(x.name, bin::encode(x.placing, package_location_bin())),
    ),
    texts: placed.fold(
      Map::new(),
      |accumulator: Map<Bytes, Bytes>, x: { name: Bytes, placing: PackageLocation, text: Bytes }|
        accumulator.insert(x.name, x.text),
    ),
    own: placed.map(|x: { name: Bytes, placing: PackageLocation, text: Bytes }| x.name),
    dependencies: range(1, dependencies.len() + 1).map(|k: Int| prefix_in(j, k)),
  }
}

pub fn package_location_in(
  w: LoadInputs,
  module: Bytes,
) -> Option<PackageLocation> / {abort.raise} =
  match w.places.get(module) {
    Some(b) -> Some(decoded(b, package_location_bin(), "a module's place")),
    None -> None,
  }

fn embedded_at<| e>(
  w: LoadInputs,
  reader: (Int, Bytes, EmbedRequest) -> EmbedBytesResult / {abort.raise | e},
  at: Bytes,
) -> Option<Bytes> / {abort.raise | e} = {
  let parts = at.split(b"\x00");
  match ((parts.at(1), parts.at(2))) {
    (Some(module), Some(key)) -> match package_location_in(w, module) {
      None -> None,
      Some(p) -> {
        Some(
          bin::encode(
            embedding_of(reader(p.package, p.relative, request_of_key(key))),
            embedding_bin(),
          ),
        )
      },
    },
    _ -> None,
  }
}

pub fn lookup_input<| e>(
  w: LoadInputs,
  shipped: (Bytes) -> Option<Bytes> / {abort.raise | e},
  data: (Bytes) -> Option<Bytes> / {abort.raise | e},
  names: () -> List<Bytes> / {abort.raise | e},
  reader: (Int, Bytes, EmbedRequest) -> EmbedBytesResult / {abort.raise | e},
  derived: (Bytes) -> Option<Bytes> / {abort.raise | e},
  kind: Bytes,
  at: Bytes,
) -> Option<Bytes> / {abort.raise | e} =
  if kind == layout_kind() { Some(w.layout) } else if kind == shipped_names_kind() {
    Some(bin::encode(names(), bin::list_bin(bin::bytes_bin())))
  } else if kind == module_kind() { w.places.get(at) }
  else if kind == text_kind() { w.texts.get(at) }
  else if kind == shipped_kind() { shipped(at) }
  else if kind == shipped_exists_kind() { match shipped(at) { Some(_) -> Some(b""), None -> None } }
  else if kind == data_kind() { data(at) }
  else if kind == embedded_file_kind() { embedded_at(w, reader, at) }
  else if kind == derived_kind() { derived(at) }
  else { None }

pub fn evaluator_of(stamps: Bytes) -> Bytes / {abort.raise} =
  stamps.split(b"\n").fold(b"", |accumulator: Bytes, line: Bytes|
    if line.starts_with(b"evaluator ") { line.slice(10, line.len()) } else { accumulator })

pub fn registry(definitions: Bytes, evaluator: Bytes) -> Map<Bytes, CheckQuery> / {abort.raise} =
  queries().fold(
    Map::new(),
    |accumulator: Map<Bytes, CheckQuery>, q: { name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {QueryEffects, abort.raise} }|
      accumulator.insert(q.name, {
        name: q.name,
        hash: match definition_hash(definitions, q.definition) {
          Some(h) -> blake3(Bytes::concat_all([h, b"\x00", evaluator])),
          None ->
            panic(
              "the program contains no definition `" ++ String::of_bytes_lossy(q.definition) ++ "`",
            ),
        },
        body: q.body,
        persistent: !digest_only_queries().contains(q.name),
        summarized: summarized_queries().contains(q.name),
      }),
  )

pub fn fresh_registry() -> Map<Bytes, CheckQuery> =
  queries().fold(
    Map::new(),
    |accumulator: Map<Bytes, CheckQuery>, q: { name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {QueryEffects, abort.raise} }|
      accumulator.insert(q.name, {
        name: q.name,
        hash: q.name,
        body: q.body,
        persistent: true,
        summarized: summarized_queries().contains(q.name),
      }),
  )

pub type CheckedModule = { module: Bytes, result: ModuleResult }

pub fn rows_of_result(a: ModuleResult) -> Rows / {abort.raise} = decode_rows(a.rows)

pub fn facts_of_result(a: ModuleResult) -> ModuleFacts / {abort.raise} =
  { shape: a.shape, tables: tables_of_result(a) }

pub fn checked_program_from_results(
  frame: Frame,
  reads: TableReads,
  results: Map<Bytes, ModuleResult>,
) -> CheckedProgram / {abort.raise} =
  checked_program_over(
    frame,
    reads,
    frame.outlines.map(|o: Outline|
      match results.get(o.name) { Some(a) -> tables_of_result(a), None -> no_module_tables() }),
  )

pub type LoadResults = { results: List<CheckedModule>, pulled: List<Bytes> }

pub fn query_load(
  qs: Map<Bytes, CheckQuery>,
  own: List<Bytes>,
  required_modules: List<Bytes>,
  tested: Bool,
  run: Run,
) -> { run: Run, value: LoadResults } / {RunEffects, abort.raise} = {
  let cycles = cycles_among(qs, run, own);
  if cycles.rejected.len() > 0 {
    { run: cycles.run, value: { results: cycles.rejected, pulled: [] } }
  } else {
    let ask = |r: Run, named: ModuleKey| {
      let a = query_output(qs, r, module_query(), bin::encode(named, module_key_bin()));
      {
        run: a.run,
        returned: {
          module: named.module,
          result: decoded(a.output, module_result_bin(), "a module's result"),
        },
      }
    };
    let ordered = dependencies_first(
      qs,
      cycles.run,
      own.map(|n: Bytes| { module: n, shipped: false, tested: false }),
    );
    let asked_own = ordered.order.fold(
      { run: ordered.run, returned: Map::new(), written: Map::new(), stopped: Map::new() },
      |accumulator: { run: Run, returned: Map<Bytes, CheckedModule>, written: Map<Bytes, List<Bytes>>, stopped: Map<Bytes, Bool> }, n: ModuleKey| {
        let imports = match ordered.edges.get(n.module) { Some(ms) -> ms, None -> [] };
        if imports.fold(false, |b: Bool, m: Bytes| b || accumulator.stopped.contains(m)) {
          {
            ..accumulator,
            returned: accumulator.returned.insert(n.module, {
              module: n.module,
              result: { ..absent(n.module), imports: imports },
            }),
            stopped: accumulator.stopped.insert(n.module, true),
          }
        } else {
          let a = ask(accumulator.run, n);
          {
            run: a.run,
            returned: accumulator.returned.insert(n.module, a.returned),
            written: accumulator.written.insert(n.module, a.returned.result.shape.written),
            stopped: if a.returned.result.rejected.len() == 0 { accumulator.stopped }
            else { accumulator.stopped.insert(n.module, true) },
          }
        }
      },
    );
    let first = {
      run: asked_own.run,
      results: own.map(|n: Bytes|
        match asked_own.returned.get(n) {
          Some(a) -> a,
          None -> panic("no check result exists for a module of the program"),
        }),
      written: asked_own.written,
    };
    let listed = shipped_listed().fold(Map::new(), |accumulator: Map<Bytes, Bool>, n: Bytes|
      accumulator.insert(n, true));
    let pulled = iterate(
      { run: first.run, results: first.results, written: first.written, read: own, pulled: [] },
      listed.len() + 2,
      |x: { run: Run, results: List<CheckedModule>, written: Map<Bytes, List<Bytes>>, read: List<Bytes>, pulled: List<Bytes> }| {
        let fresh = pulled_next(x.read, x.written, listed, required_modules);
        if fresh.len() == 0 { Stop(x) } else {
          Continue(
            fresh.fold(
              { ..x, read: x.read.concat(fresh), pulled: x.pulled.concat(fresh) },
              |accumulator: { run: Run, results: List<CheckedModule>, written: Map<Bytes, List<Bytes>>, read: List<Bytes>, pulled: List<Bytes> }, n: Bytes| {
                let a = ask(accumulator.run, { module: n, shipped: true, tested: tested });
                {
                  ..accumulator,
                  run: a.run,
                  results: accumulator.results.push(a.returned),
                  written: accumulator.written.insert(n, a.returned.result.shape.written),
                }
              },
            ),
          )
        }
      },
    );
    { run: pulled.run, value: { results: pulled.results, pulled: pulled.pulled } }
  }
}

fn shipped_listed() -> List<Bytes> / {memo_store.read, abort.raise} =
  match memo_store.external(shipped_names_kind(), b"") {
    Some(b) -> decoded(b, bin::list_bin(bin::bytes_bin()), "the shipped modules' names"),
    None -> [],
  }

pub fn shipped_queries() -> List<Bytes> =
  [
    owners_query(),
    whole_query(),
    signatures_query(),
    typed_query(),
    calls_query(),
    cycles_query(),
    group_query(),
    group_hash_query(),
    module_query(),
    header_query(),
    header_text_query(),
    hashes_query(),
    wanted_files_query(),
    documented_query(),
    declaring_query(),
  ]

pub fn digest_only_queries() -> List<Bytes> =
  [
    owner_query(),
    shape_query(),
    signature_unit_query(),
    context_query(),
    setting_query(),
    visible_modules_query(),
    group_imports_query(),
    names_query(),
    signature_query(),
    group_interface_query(),
    owner_interface_query(),
    shown_query(),
    exported_query(),
  ]

pub fn summarized_queries() -> List<Bytes> =
  [
    owners_query(),
    context_query(),
    setting_query(),
    whole_query(),
    visible_modules_query(),
    names_query(),
    module_query(),
    imports_query(),
    header_text_query(),
    header_query(),
    hashes_query(),
    documented_query(),
    declaring_query(),
    value_call_modules_query(),
    declared_query(),
    owner_interfaces_query(),
    exported_query(),
    owner_hash_query(),
  ]

pub fn check_shipped_modules(
  qs: Map<Bytes, CheckQuery>,
  shipped: List<Bytes>,
  run: Run,
) -> { run: Run, rejected: List<CheckedModule> } / {RunEffects, abort.raise} = {
  let ordered = dependencies_first(
    qs,
    run,
    shipped.map(|m: Bytes| { module: m, shipped: true, tested: false }),
  );
  let checked = ordered.order.fold(
    { run: ordered.run, rejected: [] },
    |accumulator: { run: Run, rejected: List<CheckedModule> }, named: ModuleKey| {
      let at = bin::encode(named, module_key_bin());
      let m = query_output(qs, accumulator.run, module_query(), at);
      let a = decoded(m.output, module_result_bin(), "a module's result");
      {
        run: [hashes_query(), wanted_files_query()].fold(m.run, |r: Run, query: Bytes|
          query_output(qs, r, query, at).run),
        rejected: if a.rejected.len() == 0 { accumulator.rejected }
        else { accumulator.rejected.push({ module: named.module, result: a }) },
      }
    },
  );
  { run: declaring_in(qs, b"std", checked.run).run, rejected: checked.rejected }
}

pub fn wanted_all(
  qs: Map<Bytes, CheckQuery>,
  pulled: List<Bytes>,
  tested: Bool,
  run: Run,
) -> { run: Run, value: Map<Bytes, ShippedWants> } / {RunEffects, abort.raise} =
  pulled.fold(
    { run: run, value: Map::new() },
    |accumulator: { run: Run, value: Map<Bytes, ShippedWants> }, m: Bytes| {
      let a = query_output(
        qs,
        accumulator.run,
        wanted_files_query(),
        bin::encode({ module: m, shipped: true, tested: tested }, module_key_bin()),
      );
      {
        run: a.run,
        value: accumulator.value.insert(
          m,
          decoded(a.output, shipped_wants_bin(), "a module's wants"),
        ),
      }
    },
  )

pub fn documented_all(
  qs: Map<Bytes, CheckQuery>,
  modules: List<ModuleKey>,
  run: Run,
) -> { run: Run, value: List<Pages> } / {RunEffects, abort.raise} =
  modules.fold(
    { run: run, value: [] },
    |accumulator: { run: Run, value: List<Pages> }, named: ModuleKey| {
      let a = query_output(
        qs,
        accumulator.run,
        documented_query(),
        bin::encode(named, module_key_bin()),
      );
      {
        run: a.run,
        value: accumulator.value.push(decoded(a.output, pages_bin(), "a module's pages")),
      }
    },
  )

pub fn declaring_in(
  qs: Map<Bytes, CheckQuery>,
  package: Bytes,
  run: Run,
) -> { run: Run, value: Map<Bytes, List<Bytes>> } / {RunEffects, abort.raise} = {
  let a = query_output(qs, run, declaring_query(), package);
  { run: a.run, value: decoded(a.output, declaring_bin(), "the modules that declare each name") }
}

fn dependencies_first(
  qs: Map<Bytes, CheckQuery>,
  run: Run,
  modules: List<ModuleKey>,
) -> { run: Run, order: List<ModuleKey>, edges: Map<Bytes, List<Bytes>> } / {RunEffects, abort.raise} = {
  let read = modules.fold(
    { run: run, edges: Map::new() },
    |accumulator: { run: Run, edges: Map<Bytes, List<Bytes>> }, n: ModuleKey| {
      let a = query_output(qs, accumulator.run, imports_query(), bin::encode(n, module_key_bin()));
      {
        run: a.run,
        edges: accumulator.edges.insert(
          n.module,
          decoded(a.output, imports_of_bin(), "a module's imports").imports.map(|i: ImportOf|
            i.named.module),
        ),
      }
    },
  );
  let among = modules.fold(Map::new(), |accumulator: Map<Bytes, Bool>, n: ModuleKey|
    accumulator.insert(n.module, true));
  let order = iterate(
    { placed: Map::new(), left: modules, out: [] },
    modules.len() + 2,
    |x: { placed: Map<Bytes, Bool>, left: List<ModuleKey>, out: List<ModuleKey> }| {
      let ready = x.left.filter(|n: ModuleKey|
        List::fold(
          match read.edges.get(n.module) { Some(es) -> es, None -> [] },
          true,
          |b: Bool, m: Bytes| b && (m == n.module || !among.contains(m) || x.placed.contains(m)),
        ));
      if ready.len() == 0 { Stop(x.out.concat(x.left)) } else {
        let placed = ready.fold(x.placed, |accumulator: Map<Bytes, Bool>, n: ModuleKey|
          accumulator.insert(n.module, true));
        let left = x.left.filter(|n: ModuleKey| !placed.contains(n.module));
        if left.len() == 0 { Stop(x.out.concat(ready)) }
        else { Continue({ placed: placed, left: left, out: x.out.concat(ready) }) }
      }
    },
  );
  { run: read.run, order: order, edges: read.edges }
}

pub fn packages_rejected(
  packages: PackageSources,
  root_modules: List<Bytes>,
  modules: Int,
  listed: List<Bytes>,
) -> List<Diagnostic> / {abort.raise} =
  reserved_prefix_diagnostics(root_modules, listed).map(
    |sd: { slot: Int, diagnostic: ParseDiagnostic }|
      diagnostic_in_module(0 - sd.slot - 1, sd.diagnostic),
  ).concat(
    read_packages(packages, root_modules).diagnostics.map(
      |sd: { slot: Int, diagnostic: ParseDiagnostic }|
        diagnostic_in_module(modules + sd.slot, sd.diagnostic),
    ),
  )

pub fn hashed_all(
  qs: Map<Bytes, CheckQuery>,
  own: List<Bytes>,
  shipped: List<Bytes>,
  tested: Bool,
  run: Run,
) -> { run: Run, value: List<ModuleHashes> } / {RunEffects, abort.raise} =
  own.map(|n: Bytes| { module: n, shipped: false, tested: false }).concat(
    shipped.map(|n: Bytes| { module: n, shipped: true, tested: tested }),
  ).fold(
    { run: run, value: [] },
    |accumulator: { run: Run, value: List<ModuleHashes> }, named: ModuleKey| {
      let a = query_output(
        qs,
        accumulator.run,
        hashes_query(),
        bin::encode(named, module_key_bin()),
      );
      let h = decoded(a.output, hash_result_bin(), "a module's hashing");
      { run: a.run, value: accumulator.value.push({ record: h.record, cached: h.fixing }) }
    },
  )

pub fn cycles_among(
  qs: Map<Bytes, CheckQuery>,
  run: Run,
  own: List<Bytes>,
) -> { run: Run, rejected: List<CheckedModule> } / {RunEffects, abort.raise} = {
  let read = own.fold(
    { run: run, edges: Map::new() },
    |accumulator: { run: Run, edges: Map<Bytes, List<ImportOf>> }, m: Bytes| {
      let a = query_output(
        qs,
        accumulator.run,
        imports_query(),
        bin::encode({ module: m, shipped: false, tested: false }, module_key_bin()),
      );
      {
        run: a.run,
        edges: accumulator.edges.insert(
          m,
          decoded(a.output, imports_of_bin(), "a module's imports").imports.filter(|i: ImportOf|
            !i.named.shipped),
        ),
      }
    },
  );
  let edges = read.edges;
  let next = |m: Bytes|
    List::map(match edges.get(m) { Some(es) -> es, None -> [] }, |i: ImportOf| i.named.module);
  let paths = |from: Bytes|
    iterate(
      { seen: Map::new(), frontier: next(from).map(|n: Bytes| { at: n, path: [from] }) },
      own.len() + 2,
      |x: { seen: Map<Bytes, List<Bytes>>, frontier: List<{ at: Bytes, path: List<Bytes> }> }|
        if x.frontier.len() == 0 { Stop(x.seen) } else {
          Continue(
            x.frontier.fold(
              { seen: x.seen, frontier: [] },
              |y: { seen: Map<Bytes, List<Bytes>>, frontier: List<{ at: Bytes, path: List<Bytes> }> }, f: { at: Bytes, path: List<Bytes> }|
                if y.seen.contains(f.at) { y } else {
                  {
                    seen: y.seen.insert(f.at, f.path),
                    frontier: y.frontier.concat(
                      next(f.at).map(|n: Bytes| { at: n, path: f.path.push(f.at) }),
                    ),
                  }
                },
            ),
          )
        },
    );
  let rejected = own.sort_by(|a: Bytes, b: Bytes|
    match compare_values(a, b) { Greater -> false, _ -> true }).fold(
    { done: Map::new(), out: [] },
    |accumulator: { done: Map<Bytes, Bool>, out: List<CheckedModule> }, m: Bytes|
      if accumulator.done.contains(m) { accumulator } else {
        match paths(m).get(m) {
          None -> accumulator,
          Some(path) -> {
            let closing = path.get(path.len() - 1);
            let span = List::fold(
              match edges.get(closing) { Some(es) -> es, None -> [] },
              dummy_span(),
              |s: Span, i: ImportOf| if i.named.module == m { i.span } else { s },
            );
            let diagnostic = if path.len() == 1 {
              error_at(
                b"E0109",
                0,
                span,
                Bytes::concat_all([b"module `", m, b"` imports itself"]),
                b"a module cannot import itself",
                [b"every name a module declares is already in scope in its own file"],
              )
            } else {
              error_at(
                b"E0109",
                0,
                span,
                Bytes::concat_all([
                  b"module cycle: ",
                  backticked(path, b" -> "),
                  b" -> `",
                  m,
                  b"`",
                ]),
                b"this import closes the cycle",
                [
                  b"each of these has to be checked before the next, and the last before the first, so there is no order to check them in",
                  b"move what they share into a module that all of them import",
                ],
              )
            };
            {
              done: path.fold(accumulator.done, |d: Map<Bytes, Bool>, p: Bytes| d.insert(p, true)),
              out: accumulator.out.push({
                module: closing,
                result: { ..absent(closing), rejected: [diagnostic] },
              }),
            }
          },
        }
      },
  ).out;
  { run: read.run, rejected: rejected }
}

pub fn entry_hash(
  qs: Map<Bytes, CheckQuery>,
  run: Run,
  module: Bytes,
  name: Bytes,
) -> { run: Run, hash: Option<Bytes> } / {RunEffects, abort.raise} =
  if module.len() == 0 { { run: run, hash: None } } else {
    let a = query_output(
      qs,
      run,
      hashes_query(),
      bin::encode({ module: module, shipped: false, tested: false }, module_key_bin()),
    );
    let hashed = decoded(a.output, hash_result_bin(), "a module's hashing");
    {
      run: a.run,
      hash: hashed.fixing.nodes.fold(None, |accumulator: Option<Bytes>, f: CachedNode|
        if !f.declaration && f.name == name { Some(f.hash) } else { accumulator }),
    }
  }

pub fn root_warnings(results: List<CheckedModule>, root: Int) -> List<Diagnostic> =
  range(0, root).fold([], |accumulator: List<Diagnostic>, i: Int|
    match results.at(i) {
      None -> accumulator,
      Some(a) ->
        accumulator.concat(
          a.result.warnings.map(|d: Diagnostic|
            { ..d, labels: d.labels.map(|l: Label| { ..l, module: i }) }),
        ),
    })

pub fn rejected_first(results: List<CheckedModule>) -> List<CheckedModule> = {
  let rejected = results.fold(Map::new(), |accumulator: Map<Bytes, Bool>, a: CheckedModule|
    if a.result.rejected.len() > 0 { accumulator.insert(a.module, true) } else { accumulator });
  results.filter(|a: CheckedModule|
    a.result.rejected.len() > 0
      && !a.result.imports.fold(false, |b: Bool, m: Bytes| b || rejected.contains(m)))
}

pub type OutcomeSummary = | RejectionSummary(List<Bytes>) | PublicationSummary(Published)

pub fn outcome_summary(outcome: AnalysisOutcome) -> OutcomeSummary / {abort.raise} =
  match outcome {
    Rejected(ds) ->
      RejectionSummary(
        ds.map(|d: Diagnostic| Bytes::concat_all([d.code, b": ", d.message])).sort_by(
          |a: Bytes, b: Bytes| match compare_values(a, b) { Greater -> false, _ -> true },
        ),
      ),
    Analysed(_) -> PublicationSummary(published(outcome)),
  }

pub fn reject_embed(package: Int, module: Bytes, want: EmbedRequest) -> EmbedBytesResult =
  Err(b"no file is there")

pub fn nothing_derived(ask: Bytes) -> Option<Bytes> / {abort.raise} = None

pub fn over_decoding<a | e>(
  store: MemoryStore,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {RunEffects, abort.raise},
) -> { store: MemoryStore, value: a } / {abort.raise | e} =
  with_memory_store(store, read, world, look, || with_decode_cache(work))

pub fn queried_over(
  store: MemoryStore,
  sources: List<Source>,
) -> { store: MemoryStore, run: Run, outcome: AnalysisOutcome, fixing: CachedHashes, results: List<CheckedModule> } / {abort.raise} =
  queried_under(fresh_registry(), store, sources)

pub fn queried_results(
  qs: Map<Bytes, CheckQuery>,
  store: MemoryStore,
  sources: List<Source>,
) -> { store: MemoryStore, run: Run, fixing: CachedHashes, results: List<CheckedModule> } / {abort.raise} = {
  let w = inputs_alone(sources);
  let done = over_decoding(
    store,
    prelude_frames,
    prelude_files(),
    |kind: Bytes, at: Bytes| lookup_input_alone(w, kind, at),
    || query_alone(qs, w),
  );
  { store: done.store, run: done.value.run, fixing: done.value.fixing, results: done.value.results }
}

pub fn queried_under(
  qs: Map<Bytes, CheckQuery>,
  store: MemoryStore,
  sources: List<Source>,
) -> { store: MemoryStore, run: Run, outcome: AnalysisOutcome, fixing: CachedHashes, results: List<CheckedModule> } / {abort.raise} = {
  let done = queried_results(qs, store, sources);
  {
    store: done.store,
    run: done.run,
    fixing: done.fixing,
    results: done.results,
    outcome: outcome_of(sources, done.results),
  }
}

pub fn prelude_files() -> Bytes = b"the shipped files"

fn prelude_pack() -> Option<packs::PackFiles> / {abort.raise} = pack_of(shipped_store([]))

pub fn prelude_frames(path: String, offset: Int, len: Int) -> Option<Bytes> / {abort.raise} =
  packs::frame_in(prelude_pack(), path, offset, len)

pub fn queried_packages(
  store: MemoryStore,
  root: OwnPackage,
  dependencies: List<OwnPackage>,
) -> { store: MemoryStore, run: Run, results: List<CheckedModule> } / {abort.raise} = {
  let w = load_inputs_of(root, dependencies);
  let done = over_decoding(
    store,
    prelude_frames,
    prelude_files(),
    |kind: Bytes, at: Bytes| lookup_input_alone(w, kind, at),
    || query_alone(fresh_registry(), w),
  );
  { store: done.store, run: done.value.run, results: done.value.results }
}

fn inputs_alone(sources: List<Source>) -> LoadInputs / {abort.raise} =
  load_inputs_of(
    {
      root: b"",
      manifest: None,
      files: sources.map(|s: Source| { module: s.name, text: s.source_text }),
    },
    [],
  )

pub fn lookup_input_alone(w: LoadInputs, kind: Bytes, at: Bytes) -> Option<Bytes> / {abort.raise} =
  lookup_input_shipping(w, [], kind, at)

fn lookup_input_shipping(
  w: LoadInputs,
  shipped: List<Source>,
  kind: Bytes,
  at: Bytes,
  derived: (Bytes) -> Option<Bytes> / {abort.raise} = nothing_derived,
) -> Option<Bytes> / {abort.raise} = {
  let all = with_prelude_source(shipped);
  let source_text = |name: Bytes|
    match all.find(|s: Source| s.name == name) { Some(s) -> Some(s.source_text), None -> None };
  lookup_input(
    w,
    source_text,
    source_text,
    || all.map(|s: Source| s.name),
    reject_embed,
    derived,
    kind,
    at,
  )
}

fn query_alone(
  qs: Map<Bytes, CheckQuery>,
  w: LoadInputs,
) -> { run: Run, results: List<CheckedModule>, fixing: CachedHashes } / {RunEffects, abort.raise} = {
  let all = query_load(qs, w.own, [], false, start_run(qs));
  if rejected_first(all.value.results).len() > 0 {
    { run: all.run, results: all.value.results, fixing: no_cached_hashes() }
  } else {
    let fixed = hashed_all(qs, w.own, all.value.pulled, false, all.run);
    { run: fixed.run, results: all.value.results, fixing: joined_cached_hashes(fixed.value) }
  }
}

pub fn outcome_of(
  sources: List<Source>,
  results: List<CheckedModule>,
) -> AnalysisOutcome / {abort.raise} =
  match rejected_first(results) {
    [] ->
      analyse_with(
        parse_all(sources),
        results.fold(no_rows(), |accumulator: Rows, a: CheckedModule| {
          let r = rows_of_result(a.result);
          {
            definitions: accumulator.definitions.concat(r.definitions),
            tests: accumulator.tests.concat(r.tests),
            types: tables_joined(accumulator.types, r.types),
          }
        }),
      ),
    first ->
      Rejected(
        first.fold([], |accumulator: List<Diagnostic>, a: CheckedModule|
          accumulator.concat(a.result.rejected)),
      ),
  }

pub type StoreSharing = | Alone | Concurrent | Turns

fn queried_in(
  tree: fs::MemFs,
  sources: List<Source>,
  company: StoreSharing,
  nth: Int,
) -> { tree: fs::MemFs, run: Run, outcome: AnalysisOutcome, fixing: CachedHashes } / {abort.raise} = {
  let w = inputs_alone(sources);
  let qs = if company != Turns { fresh_registry() } else {
    fresh_registry().insert(b"spare", {
      name: b"spare",
      hash: if nth % 2 == 1 { b"odd" } else { b"even" },
      body: |input: Bytes| input,
      persistent: true,
      summarized: false,
    })
  };
  let done = fs::on_mem[abs](tree, ||
    handle {
      memo_files::with_memo_store[abs](
        "s",
        prelude_frames,
        prelude_files(),
        |kind: Bytes, at: Bytes| {
          if raced.is_first_lookup() {
            memo_files::with_memo_store[abs](
              "s",
              prelude_frames,
              prelude_files(),
              |k: Bytes, a: Bytes| lookup_input_alone(w, k, a),
              || with_decode_cache(|| query_alone(qs, w).run),
            );
            ()
          };
          lookup_input_alone(w, kind, at)
        },
        || with_decode_cache(|| query_alone(qs, w)),
      )
    } with {
      var begun = company != Concurrent,
      raced.is_first_lookup() -> {
        let first = !begun;
        begun = true;
        first
      },
    });
  {
    tree: done.tree,
    run: done.value.run,
    fixing: done.value.fixing,
    outcome: outcome_of(sources, done.value.results),
  }
}

effect raced {
  write is_first_lookup() -> Bool
}

pub fn files_differing(steps: List<Step>, company: StoreSharing) -> List<Bytes> / {abort.raise} =
  range(0, steps.len()).fold(
    { tree: fs::mem_of([]), store: empty_memory_store(), off: [] },
    |s: { tree: fs::MemFs, store: MemoryStore, off: List<Bytes> }, i: Int| {
      let step = steps.get(i);
      let recorded = queried_in(s.tree, step.sources, company, i);
      let queried = queried_over(s.store, step.sources);
      let agrees = outcome_summary(recorded.outcome) == outcome_summary(queried.outcome)
        && recorded.fixing == queried.fixing
        && (company != Alone || executed_count(recorded.run) == executed_count(queried.run));
      {
        tree: recorded.tree,
        store: queried.store,
        off: if agrees { s.off } else { s.off.push(step.what) },
      }
    },
  ).off

pub type Step = { what: Bytes, sources: List<Source> }

test "every query whose results the toolchain ships caches its results" {
  assert_eq(shipped_queries().filter(|n: Bytes| digest_only_queries().contains(n)), [])
}

fn stored_results(name: Bytes) -> List<Bytes> / {abort.raise} = {
  let store = check_sources(
    empty_memory_store(),
    layered(b"pub fn step(n: Int) -> Int = n + 1\n"),
    [],
  ).store;
  memo::current_records(store).fold([], |accumulator: List<Bytes>, _key: Bytes, r: Record|
    if r.query != name { accumulator } else {
      match store.outputs.get(r.output) { Some(out) -> accumulator.push(out), None -> accumulator }
    })
}

fn results_round_trip<a>(results: List<Bytes>, codec: bin::BinCodec<a>) -> Bool / {abort.raise} =
  results.len() > 0
    && results.fold(true, |ok: Bool, b: Bytes| {
      let value = decoded(b, codec, "a cached result");
      ok && bin::encode(value, codec) == b && bin::round_trips(value, codec)
    })

test "a module's result reads back as it was recorded" {
  assert(results_round_trip(stored_results(module_query()), module_result_bin()))
}

test "a module's definition list decodes to the same value that was stored" {
  assert(results_round_trip(stored_results(owners_query()), owners_result_bin()))
}

test "a group's hashes decode to the same value that was stored" {
  assert(results_round_trip(stored_results(group_hash_query()), group_hashes_bin()))
}

test "a module's imports read back as they were recorded" {
  assert(results_round_trip(stored_results(imports_query()), imports_of_bin()))
}

test "a module's hashes read back as they were recorded" {
  assert(results_round_trip(stored_results(hashes_query()), hash_result_bin()))
}

fn embedding_queried(
  source_text: Bytes,
  files: Map<Bytes, Bytes>,
) -> { store: MemoryStore, results: List<CheckedModule>, fixing: CachedHashes } / {abort.raise} =
  embedding_queried_over(empty_memory_store(), source_text, files, [])

fn embedding_queried_over(
  store: MemoryStore,
  source_text: Bytes,
  files: Map<Bytes, Bytes>,
  others: List<Source>,
) -> { store: MemoryStore, results: List<CheckedModule>, fixing: CachedHashes } / {abort.raise} = {
  let w = inputs_alone([{ name: b"m", source_text: source_text }].concat(others));
  let none = |name: Bytes| None;
  let read = |package: Int, module: Bytes, want: EmbedRequest|
    match files.get(want.path) {
      Some(bytes) -> Ok([{ name: b"", bytes: bytes }]),
      None -> Err(b"no file is there"),
    };
  let done = over_decoding(
    store,
    packs::no_pack,
    b"",
    |kind: Bytes, at: Bytes| lookup_input(w, none, none, || [], read, nothing_derived, kind, at),
    || query_alone(fresh_registry(), w),
  );
  { store: done.store, results: done.value.results, fixing: done.value.fixing }
}

fn fixed_hash(fixing: CachedHashes, name: Bytes) -> Option<Bytes> =
  fixing.nodes.fold(None, |accumulator: Option<Bytes>, f: CachedNode|
    if f.name == name { Some(f.hash) } else { accumulator })

fn two_embeds() -> Bytes =
  b"pub fn a() -> Bytes = embed(\"a.bin\")\npub fn b() -> Bytes = embed(\"b.bin\")\n"

test "a module's stored results refer to an embedded file by its digest and never contain the file's bytes" {
  let line = Bytes::concat_all(range(0, 10).map(|_: Int| b"0123456789"));
  let big = Bytes::concat_all(
    range(0, 1000).map(|i: Int| Bytes::concat_all([Bytes::of_string(i.to_string()), b":", line])),
  );
  let source_text = b"pub fn data() -> Bytes = embed(\"big.bin\")\npub fn size() -> Int = data().len()\ntest \"sized\" { assert(size() > 0) }\n";
  let done = embedding_queried(source_text, Map::new().insert(b"big.bin", big));
  assert_eq(rejected_first(done.results), []);
  assert(fixed_hash(done.fixing, b"m.data") != None);
  assert_eq(
    done.results.map(|a: CheckedModule| a.result.shape.embeds.map(|e: ModuleEmbed| e.read)),
    [[Ok([embed_file(b"", big)])]],
  );
  let largest = done.store.outputs.fold(0, |most: Int, _: Bytes, result: Bytes|
    if result.len() > most { result.len() } else { most });
  assert(
    largest < big.len() / 10,
    Some(
      "a result of " ++ largest.to_string() ++ " bytes, beside a file of " ++ big.len().to_string(),
    ),
  )
}

test "changing an embedded file's bytes changes the hash of the definition that embeds it and of no other definition" {
  let over = |a: Bytes, b: Bytes|
    embedding_queried(two_embeds(), Map::new().insert(b"a.bin", a).insert(b"b.bin", b)).fixing;
  let first = over(b"one", b"two");
  let moved = over(b"one", b"three");
  assert(fixed_hash(first, b"m.a") != None);
  assert_eq(fixed_hash(moved, b"m.a"), fixed_hash(first, b"m.a"));
  assert(fixed_hash(moved, b"m.b") != fixed_hash(first, b"m.b"));
  let same = over(b"one", b"one");
  assert_eq(fixed_hash(same, b"m.a"), fixed_hash(same, b"m.b"))
}

test "a check detects that a file a module embeds was deleted, even though no module source changed" {
  let source_text = b"pub fn words() -> Bytes = embed(\"words.txt\")\n";
  let others = [
    { name: b"count", source_text: b"import m\npub fn count() -> Int = m::words().len()\n" },
  ];
  let present = embedding_queried_over(
    empty_memory_store(),
    source_text,
    Map::new().insert(b"words.txt", b"one two\n"),
    others,
  );
  assert_eq(rejected_first(present.results), []);
  let gone = embedding_queried_over(present.store, source_text, Map::new(), others);
  assert_eq(
    gone.results,
    embedding_queried_over(empty_memory_store(), source_text, Map::new(), others).results,
  );
  assert_eq(
    rejected_first(gone.results).fold([], |accumulator: List<Bytes>, a: CheckedModule|
      accumulator.concat(a.result.rejected.map(|d: Diagnostic| d.code))),
    [b"E0146"],
  )
}

type CheckedSources = {
  store: MemoryStore,
  run: Run,
  results: List<CheckedModule>,
  cached_hashes: CachedHashes,
  warnings: List<Diagnostic>,
  fetched: List<Bytes>,
}

pub fn check_sources(
  store: MemoryStore,
  sources: List<Source>,
  shipped: List<Source>,
  derived: (Bytes) -> Option<Bytes> / {abort.raise} = nothing_derived,
) -> CheckedSources / {abort.raise} =
  check_with_pack(store, prelude_pack(), sources, shipped, derived: derived)

pub fn check_with_pack(
  store: MemoryStore,
  packed: Option<packs::PackFiles>,
  sources: List<Source>,
  shipped: List<Source>,
  derived: (Bytes) -> Option<Bytes> / {abort.raise} = nothing_derived,
) -> CheckedSources / {abort.raise} = {
  let w = load_inputs_of(
    {
      root: b"",
      manifest: None,
      files: sources.map(|s: Source| { module: s.name, text: s.source_text }),
    },
    [],
  );
  handle {
    let done = over_decoding(
      store,
      |path: String, offset: Int, len: Int| {
        let found = packs::frame_in(packed, path, offset, len);
        match found { Some(b) -> fetching.fetched(b), None -> () };
        found
      },
      b"",
      |kind: Bytes, at: Bytes| lookup_input_shipping(w, shipped, kind, at, derived: derived),
      || {
        let qs = fresh_registry();
        let all = query_load(qs, w.own, [], false, start_run(qs));
        let fixed = hashed_all(qs, w.own, all.value.pulled, false, all.run);
        {
          run: fixed.run,
          results: all.value.results,
          fixing: joined_cached_hashes(fixed.value),
          warnings: root_warnings(all.value.results, sources.len()),
        }
      },
    );
    {
      store: done.store,
      run: done.value.run,
      results: done.value.results,
      fixing: done.value.fixing,
      warnings: done.value.warnings,
    }
  } with {
    var fetched: List<Bytes> = [],
    fetching.fetched(b) -> {
      fetched = fetched.push(b);
    },
    return d ->
      {
        store: d.store,
        run: d.run,
        results: d.results,
        cached_hashes: d.fixing,
        warnings: d.warnings,
        fetched: fetched,
      },
  }
}

effect fetching {
  write fetched(b: Bytes) -> Unit
}

pub fn layered(lib: Bytes) -> List<Source> =
  [
    { name: b"lib", source_text: lib },
    { name: b"app", source_text: b"import lib\npub fn go(n: Int) -> Int = lib::step(n) + 1\n" },
    { name: b"aside", source_text: b"pub fn alone() -> Int = 7\n" },
  ]

test "a definition group that calls a group with a type error is skipped, and the module reports the same errors as a whole-module check" {
  let source = |body: Bytes|
    [
      {
        name: b"lib",
        source_text: Bytes::concat_all([
          b"pub fn base(n: Int) -> Int = ",
          body,
          b"\n\npub fn over(n: Int) -> Int = base(n) + 1\n\npub fn top(n: Int) -> Int = over(n) * 2\n\n",
          b"pub fn apart(n: Int) -> Int = n - 1\n",
        ]),
      },
    ];
  let cold = queried_over(empty_memory_store(), source(b"n + 1"));
  let broken = queried_over(cold.store, source(b"n + true"));
  assert_eq(
    outcome_summary(broken.outcome),
    outcome_summary(analyse(parse_all(source(b"n + true")))),
  );
  let waiting = memo::current_records(broken.store).fold(
    [],
    |accumulator: List<Bytes>, _key: Bytes, r: Record|
      if r.query != group_query() { accumulator } else {
        match broken.store.outputs.get(r.output) {
          None -> accumulator,
          Some(out) -> {
            let a = owner_checks::decode_group(
              decoded(out, owner_checks::encoded_group_bin(), "a group's result"),
            );
            if a.rejected.any(|d: Diagnostic| d.message.index_of(b" waits on ") != None) {
              accumulator.concat(decoded(r.input, group_key_bin(), "a group's names").owners)
            } else { accumulator }
          },
        }
      },
  );
  let checked = executed_for(broken.run, group_query()).fold(
    [],
    |accumulator: List<Bytes>, b: Bytes|
      accumulator.concat(decoded(b, group_key_bin(), "a group's names").owners),
  ).filter(|o: Bytes| o != b"base");
  assert(checked.contains(b"over"));
  assert_eq(waiting.sort(), checked.sort())
}

pub fn shipped_store(shipped: List<Source>) -> MemoryStore / {abort.raise} =
  shipped_store_results(shipped).store

fn shipped_store_results(
  shipped: List<Source>,
) -> { store: MemoryStore, value: List<CheckedModule> } / {abort.raise} = {
  let nowhere = load_inputs_of({ root: b"", manifest: None, files: [] }, []);
  over_decoding(
    empty_memory_store(),
    packs::no_pack,
    b"",
    |kind: Bytes, at: Bytes| lookup_input_shipping(nowhere, shipped, kind, at),
    || {
      let qs = fresh_registry();
      check_shipped_modules(
        qs,
        with_prelude_source(shipped).map(|s: Source| s.name),
        start_run(qs),
      ).rejected
    },
  )
}

test "computing the shipped modules' results names each one that fails" {
  let rejected = shipped_store_results([
    { name: b"std.a", source_text: b"pub fn a() -> Int = 1\n" },
    { name: b"std.b", source_text: b"import std.a (a)\n\npub fn b() -> Int = a(2)\n" },
  ]).value;
  assert_eq(rejected.map(|x: CheckedModule| x.module), [b"std.b"]);
  assert_eq(rejected.map(|x: CheckedModule| x.result.rejected.map(|d: Diagnostic| d.code)), [
    [b"E0202"],
  ])
}

test "a compiler module imports another below the compiler's root by its full name" {
  let shipped = [
    { name: b"compiler.syntax.base", source_text: b"pub fn one() -> Int = 1\n" },
    {
      name: b"compiler.check.user",
      source_text: b"import compiler.syntax.base (one)\n\npub fn two() -> Int = one() + one()\n",
    },
  ];
  let rejected = shipped_store_results(shipped).value;
  assert_eq(rejected.map(|x: CheckedModule| x.result.rejected.map(|d: Diagnostic| d.code)), []);
  let user = [
    {
      name: b"main",
      source_text: b"import compiler.check.user (two)\npub fn main() -> Int = two()\n",
    },
  ];
  let f = check_sources(empty_memory_store(), user, shipped);
  assert_eq(
    f.results.fold([], |accumulator: List<Diagnostic>, a: CheckedModule|
      accumulator.concat(a.result.rejected)),
    [],
  )
}

pub fn pack_of(store: MemoryStore) -> Option<packs::PackFiles> / {abort.raise} =
  Some(
    memo::pack_memory_store(
      {
        ..store,
        records: memo::current_records(store).fold(
          Map::new(),
          |accumulator: Map<Bytes, Record>, k: Bytes, r: Record|
            if shipped_queries().contains(r.query) { accumulator.insert(k, r) }
            else { accumulator },
        ),
      },
      fresh_registry(),
      prelude_files(),
    ),
  )

test "loading from a prebuilt store of shipped results fetches a module's definition list fewer times than the module has definitions" {
  let owners = 24;
  let shipped = [
    {
      name: b"std.many",
      source_text: Bytes::concat_all(
        range(0, owners).map(|i: Int|
          Bytes::of_string(f"pub fn f{i.to_string()}() -> Int = {i.to_string()} + 1\n\n")),
      ),
    },
  ];
  let store = shipped_store(shipped);
  let read = memo::current_records(store).fold(b"", |found: Bytes, _: Bytes, r: Record|
    if r.query == owners_query() { r.output } else { found });
  let read_bytes = match store.outputs.get(read) { Some(o) -> o, None -> b"" };
  let user = [
    { name: b"main", source_text: b"import std.many (f0)\npub fn main() -> Int = f0()\n" },
  ];
  let load = check_with_pack(empty_memory_store(), pack_of(store), user, shipped);
  let fetches = load.fetched.filter(|b: Bytes| b == read_bytes).len();
  assert(fetches > 0, Some("the read is short enough to be kept inside its record"));
  assert(fetches < owners, Some(f"the read was fetched {fetches.to_string()} times"))
}

test "loading from a prebuilt store of shipped results type-checks no definition of a shipped module" {
  let shipped = [
    {
      name: b"std.pair",
      source_text: b"pub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n\npub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n\npub fn both(n: Int) -> Bool = even(n) || odd(n)\n",
    },
  ];
  let user = [
    { name: b"main", source_text: b"import std.pair (both)\npub fn main() -> Bool = both(3)\n" },
  ];
  let load = check_with_pack(empty_memory_store(), pack_of(shipped_store(shipped)), user, shipped);
  assert_eq(executed_for(load.run, typed_query()), []);
  assert_eq(load.results, check_sources(empty_memory_store(), user, shipped).results)
}

test "a shipped module's imports are checked as an importing module sees them, ignoring imports used only by its tests" {
  let user = [
    { name: b"main", source_text: b"import std.a (two)\npub fn main() -> Int = two()\n" },
  ];
  let shipped = [
    {
      name: b"std.a",
      source_text: b"import std.b (one)\nimport std.c (spare)\n\npub fn two() -> Int = one() + one()\ntest \"spared\" { assert_eq(spare(), 3) }\n",
    },
    { name: b"std.b", source_text: b"pub fn one() -> Int = 1\n" },
    { name: b"std.c", source_text: b"pub fn spare() -> Int = 3\n" },
  ];
  let f = check_sources(empty_memory_store(), user, shipped);
  assert_eq(
    f.results.fold([], |accumulator: List<Diagnostic>, a: CheckedModule|
      accumulator.concat(a.result.rejected)),
    [],
  )
}

test "a module reports the errors of a definition with an error, and none from the definitions that call it" {
  let sources = [
    {
      name: b"app",
      source_text: b"fn pick() -> Int = missing()\n\nfn read() -> Int = 1\n\nfn main() -> Int = pick() + read()\n",
    },
  ];
  let f = check_sources(empty_memory_store(), sources, []);
  assert_eq(
    f.results.fold([], |accumulator: List<Bytes>, a: CheckedModule|
      accumulator.concat(a.result.rejected.map(|d: Diagnostic| d.message))),
    [b"unknown name `missing`"],
  )
}

test "an import of a module that does not exist fails the importing module even when nothing uses the import" {
  let sources = [{ name: b"app", source_text: b"import nonesuch\npub fn f() -> Int = 1\n" }];
  let f = check_sources(empty_memory_store(), sources, []);
  assert_eq(
    f.results.fold([], |accumulator: List<Bytes>, a: CheckedModule|
      accumulator.concat(a.result.rejected.map(|d: Diagnostic| d.code))),
    [b"E0106"],
  )
}

test "an import of a module that does not ship lists the ones that do, and points at the import" {
  let f = check_sources(
    empty_memory_store(),
    [{ name: b"app", source_text: b"import std.nonesuch\nfn f() -> Int = 1\n" }],
    [{ name: b"std.net", source_text: b"pub fn drain() -> Int = 1\n" }],
  );
  match f.results.fold([], |accumulator: List<Diagnostic>, a: CheckedModule|
      accumulator.concat(a.result.rejected)) {
    [d] -> {
      assert_eq(d.code, b"E0106");
      assert(d.labels != []);
      assert(d.notes_text.any(|note: Bytes| note.index_of(b"std.net") != None))
    },
    _ -> panic("one import is rejected"),
  }
}

test "two imports that give the same module name fail their module even when neither is used" {
  let sources = [
    { name: b"net", source_text: b"pub fn x() -> Int = 1\n" },
    { name: b"lib.net", source_text: b"pub fn y() -> Int = 2\n" },
    { name: b"app", source_text: b"import net\nimport lib.net\npub fn f() -> Int = 1\n" },
  ];
  let f = check_sources(empty_memory_store(), sources, []);
  assert_eq(
    f.results.fold([], |accumulator: List<Bytes>, a: CheckedModule|
      accumulator.concat(a.result.rejected.map(|d: Diagnostic| d.code))),
    [b"E0110"],
  )
}

test "a name two imports select fails their module, though its module exports it" {
  let sources = [
    { name: b"base", source_text: b"pub type T = | A | B\npub fn f() -> T = A\n" },
    {
      name: b"app",
      source_text: b"import base (T)\nimport base (T, f)\npub fn g() -> Bool = f() == f()\n",
    },
  ];
  let f = check_sources(empty_memory_store(), sources, []);
  assert_eq(
    f.results.fold([], |accumulator: List<Bytes>, a: CheckedModule|
      accumulator.concat(a.result.rejected.map(|d: Diagnostic| d.code))),
    [b"E0110"],
  )
}

test "a name a module selects that its module does not declare fails the module" {
  let sources = [
    { name: b"lib", source_text: b"pub fn used() -> Int = 1\n" },
    { name: b"app", source_text: b"import lib (used, gone)\nfn go() -> Int = used()\n" },
  ];
  let f = check_sources(empty_memory_store(), sources, []);
  assert_eq(
    f.results.fold([], |accumulator: List<Bytes>, a: CheckedModule|
      accumulator.concat(a.result.rejected.map(|d: Diagnostic| d.code))),
    [b"E0101"],
  )
}
