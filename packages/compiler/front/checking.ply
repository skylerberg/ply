    { name: b"base", source_text: b"pub type T = | A | B\npub fn f() -> T = A\n" },
    {
      name: b"app",
      source_text: b"import base (T)\nimport base (T, f)\npub fn g() -> Bool = f() == f()\n",
    },
  ];
  let f = check_sources(empty_memory_store, sources, []);
  assert_eq(
    f.results.fold([], |accumulator: List<Bytes>, a: CheckedModule|
      accumulator.concat(a.result.rejected.map(|d: Diagnostic| d.code))),
    [b"E0110"],
  )
}

test "a name a module selects that its module does not declare fails the module" {
  let sources = [
    { name: b"lib", source_text: b"pub fn used() -> Int = 1\n" },
    { name: b"app", source_text: b"import lib (used, gone)\nfn go() -> Int = used()\n" },
  ];
  let f = check_sources(empty_memory_store, sources, []);
  assert_eq(
    f.results.fold([], |accumulator: List<Bytes>, a: CheckedModule|
      accumulator.concat(a.result.rejected.map(|d: Diagnostic| d.code))),
    [b"E0101"],
  )
}

test "a type and another type's constructor may share a name" {
  let sources = [
    {
      name: b"m",
      source_text: Bytes::concat_all([
        b"type Queued<v> = { value: v, stamp: List<Int> }\n",
        b"type Route = | Closed | Queued\n",
        b"pub fn held(q: Queued<Int>) -> Int = q.value\n",
        b"pub fn routed(full: Bool) -> Bool = match if full { Closed } else { Queued } { Closed -> false, Queued -> true }\n",
      ]),
    },
  ];
  assert_eq(
    outcome_summary(queried_over(empty_memory_store, sources).outcome),
    outcome_summary(analyse(parse_all(sources))),
  )
}

test "a signature may use an effect set whose effects live in a module it does not import" {
  let sources = [
    { name: b"eff", source_text: b"pub effect counter {\n  read count() -> Int\n}\n" },
    {
      name: b"sets",
      source_text: b"import eff (counter)\npub effect set Counting = {counter.count}\npub fn counted() -> Int / {Counting} = counter.count()\n",
    },
    {
      name: b"app",
      source_text: b"import sets (Counting, counted)\npub fn twice() -> Int / {Counting} = counted() + counted()\n",
    },
  ];
  assert_eq(
    outcome_summary(queried_over(empty_memory_store, sources).outcome),
    outcome_summary(analyse(parse_all(sources))),
  )
}

test "a signature that names a type keyed by its parameter implies that the parameter is ordered" {
  let sources = [
    {
      name: b"m",
      source_text: b"pub opaque type Bag<a> = | Bag(Map<a, Unit>)\npub fn empty_bag<a>() -> Bag<a> = Bag(Map::new())\npub fn held<a>(b: Bag<a>, x: a) -> Bool = match b { Bag(m) -> m.contains(x) }\n",
    },
  ];
  assert_eq(
    outcome_summary(queried_over(empty_memory_store, sources).outcome),
    outcome_summary(analyse(parse_all(sources))),
  )
}

test "a module's stored interface and contracts equal those of a whole check" {
  let sources = [
    {
      name: b"lib",
      source_text: b"pub type Pair = { a: Int, b: Int }\npub effect log { write emit(Bytes) -> Unit }\nfn helper(x: Int) -> Int = x * 2\npub fn two(x: Int) -> Int requires x >= 0 ensures result > x = helper(x) + 1\npub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\npub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\npub fn mk(x: Int) -> Pair = { a: x, b: two(x) }\npub fn say(b: Bytes) -> Unit / {log.write} = log.emit(b)\n",
    },
  ];
  let stored = read_over(sources, ||
    published_module({ module: b"lib", shipped: false, tested: false }));
  let whole = match analyse(parse_all(sources)) {
    Analysed(a) -> a,
    Rejected(_) -> panic("the sample program was rejected"),
  };
  match stored {
    None -> panic("the stored interface is missing"),
    Some(p) -> {
      assert_eq(p.interface, module_interface_of(whole, sources, b"lib"));
      assert_eq(
        contract_lines(p.contracts),
        contract_lines(public_contracts(whole.index, whole.hashes, |m: Bytes| m == b"lib")),
      )
    },
  }
}

fn contract_lines(contracts: List<Contract>) -> List<Bytes> =
  contracts.map(|c: Contract|
    Bytes::concat_all([c.name, if c.declaration { b" type " } else { b" " }, c.hash])).sort(
  )
