fn outline_of(
  parsed: ParsedModule,
  sets: List<EffectSetRow>,
  cuts: List<Cut>,
  modules: List<ParsedModule>,
) -> Outline / {abort.raise} =
  {
    name: parsed.name,
    items: parsed.module.items.fold([], |accumulator: List<OutlineItem>, item: Item|
      match item {
        FunctionItem(d) ->
          accumulator.push(
            OutlinedFunction({
              name: d.name.name,
              public: is_pub(d.visibility),
              generated: parsed.derived.any(|origin: DeriveOrigin| origin.span == d.span),
              reuse: match d.reuse { Some(_) -> true, None -> false },
              returns: d.returns != None,
              measured: d.decreases != None,
              params: d.params.map(|param: Param| { name: param.name.name, span: param.span }),
              literals: d.spec.fold([], |found: List<Bytes>, clause: SpecClause|
                match clause.kind {
                  RequiresClause -> lits(found, clause.expression),
                  EnsuresClause -> found,
                  CostClause -> found,
                  SpaceClause -> found,
                }),
              spec: d.spec.map(|clause: SpecClause| clause.kind),
              constant: d.constant != None,
              name_span: d.name.span,
              span: d.span,
            }),
          ),
        TestItem(d) ->
          accumulator.push(
            OutlinedTest({ name: d.name, label_span: d.label_span, cases: d.cases != None }),
          ),
        LawItem(d) ->
          accumulator.push(OutlinedLaw({ name: d.name, literals: claim_literals(modules, d) })),
        TypeItem(d) ->
          accumulator.push(
            OutlinedType({
              name: d.name.name,
              public: is_pub(d.visibility),
              arity: d.generics.types.len(),
              span: d.span,
            }),
          ),
        EffectItem(d) ->
          accumulator.push(
            OutlinedEffect({
              name: d.name.name,
              public: is_pub(d.visibility),
              host: host_handler_of(parsed.module, d.name.name),
              span: d.name.span,
            }),
          ),
        _ -> accumulator,
      }),
    declared: module_items(parsed),
    imports: imported_names(parsed.module.imports.filter(is_explicit_import)),
    schemas: schemas_declared(parsed),
    sets: sets,
    cuts: cuts,
    stated: parsed.module.items.fold([], |accumulator: List<Bytes>, item: Item|
      match target_type(item) {
        Some(t) -> accumulator.push(qualify(parsed.name, t.name)),
        None -> accumulator,
      }),
    set_texts: parsed.module.items.fold([], |accumulator: List<Bytes>, item: Item|
      match item { EffectSetItem(_) -> accumulator.push(dump_item(item)), _ -> accumulator }),
    derived: parsed.derived.map(derivation_of),
  }

pub fn read_outline(parsed: ParsedModule) -> Outline / {abort.raise} =
  outline_of(
    { ..parsed, module: { ..parsed.module, items: parsed.module.items.map(numbered_missing) } },
    [],
    cuts_of(parsed),
    [parsed],
  )

pub fn outlines_of(w: Analysis) -> List<Outline> / {abort.raise} =
  range(0, w.modules.len()).map(|i: Int| {
    let parsed = w.modules.get(i);
    outline_of(
      parsed,
      effect_sets_of(w.r, w.checked.effects, i, parsed),
      match w.stub_cuts.get(parsed.name) { Some(c) -> c, None -> cuts_of(parsed) },
      w.modules,
    )
  })

pub fn effect_visibility(outlines: List<Outline>) -> Map<Bytes, Bool> =
  outlines.fold(Map::new(), |accumulator: Map<Bytes, Bool>, o: Outline|
    o.items.fold(accumulator, |a: Map<Bytes, Bool>, item: OutlineItem|
      match item { OutlinedEffect(e) -> a.insert(qualify(o.name, e.name), e.public), _ -> a }))

pub fn effect_hosts(outlines: List<Outline>) -> Map<Bytes, Bytes> =
  outlines.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, o: Outline| {
    let declared = o.items.fold(accumulator, |a: Map<Bytes, Bytes>, item: OutlineItem|
      match item {
        OutlinedEffect(e) -> match e.host {
          Some(by) -> a.insert(qualify(o.name, e.name), qualify(o.name, by)),
          None -> a,
        },
        _ -> a,
      });
    prelude_hosts().fold(
      declared,
      |a: Map<Bytes, Bytes>, h: { effect: Bytes, module: Bytes, by: Bytes }|
        if h.module == o.name
            && o.items.any(|item: OutlineItem|
              match item { OutlinedFunction(f) -> f.name == h.by, _ -> false }) {
          a.insert(h.effect, qualify(o.name, h.by))
        } else { a },
    )
  })

pub fn effect_public_of(m: Map<Bytes, Bool>, effect_info: EffectInfo) -> Bool =
  match m.get(effect_info.name) { Some(b) -> b, None -> true }

pub fn type_rows(outlines: List<Outline>) -> List<TypeRow> / {abort.raise} =
  range(0, outlines.len()).fold([], |accumulator: List<TypeRow>, i: Int| {
    let o = outlines.get(i);
    o.items.fold(accumulator, |a: List<TypeRow>, item: OutlineItem|
      match item {
        OutlinedType(t) ->
          a.push({
            name: qualify(o.name, t.name),
            module: o.name,
            simple_name: t.name,
            public: t.public,
            arity: t.arity,
            at: span_at(i, t.span),
          }),
        _ -> a,
      })
  })

pub fn test_label_spans(outlines: List<Outline>) -> List<Location> / {abort.raise} =
  range(0, outlines.len()).fold([], |accumulator: List<Location>, i: Int|
    outlines.get(i).items.fold(accumulator, |a: List<Location>, item: OutlineItem|
      match item { OutlinedTest(t) -> a.push({ module: i, span: t.label_span }), _ -> a }))

fn int_literal(k: Int) -> Bytes = b"int ".concat(ascii_of_int(k))

fn literal_text(accumulator: List<Bytes>, literal: SourceLiteral) -> List<Bytes> / {abort.raise} =
  match literal {
    LiteralInt(k) -> accumulator.push_unique(int_literal(k)),
    LiteralString(s) -> accumulator.push_unique(b"str ".concat(s)),
    LiteralBytes(b) -> accumulator.push_unique(b"bytes ".concat(hex(b))),
    _ -> accumulator,
  }

fn neg_literal(accumulator: List<Bytes>, expression: Expression) -> List<Bytes> =
  match expression {
    LiteralExpression(v) -> match v.literal {
      LiteralInt(k) -> accumulator.push_unique(int_literal(0 - k)),
      _ -> accumulator,
    },
    _ -> accumulator,
  }

fn lits(accumulator: List<Bytes>, expression: Expression) -> List<Bytes> / {abort.raise} = {
  let backwards = |a: List<Bytes>, xs: List<Expression>|
    range(0, xs.len()).fold(a, |b: List<Bytes>, k: Int|
      match xs.at(xs.len() - 1 - k) { Some(x) -> lits(b, x), None -> b });
  match expression {
    LiteralExpression(v) -> literal_text(accumulator, v.literal),
    NameExpression(_) -> accumulator,
    TaggedLiteralExpression(v) -> backwards(accumulator, v.holes.map(|h: Hole| h.value)),
    HoleExpression(_) -> accumulator,
    InvalidExpression(_) -> accumulator,
    BinaryExpression(v) -> lits(lits(accumulator, v.right_operand), v.left_operand),
    UnaryExpression(v) ->
      lits(
        if v.operation == b"neg" { neg_literal(accumulator, v.operand) } else { accumulator },
        v.operand,
      ),
    LambdaExpression(v) -> lits(accumulator, v.body),
    CallExpression(v) -> lits(backwards(accumulator, v.args), v.function),
    IfExpression(v) -> lits(lits(lits(accumulator, v.else_branch), v.then_branch), v.cond),
    MatchExpression(v) -> {
      let n = v.arms.len();
      let armed = range(0, n).fold(accumulator, |a: List<Bytes>, k: Int|
        match v.arms.at(n - 1 - k) {
          Some(arm) -> match arm.guard {
            Some(g) -> lits(lits(a, arm.body), g),
            None -> lits(a, arm.body),
          },
          None -> a,
        });
      lits(armed, v.scrutinee)
    },
    BlockExpression(v) -> {
      let tailed = match v.tail { Some(t) -> lits(accumulator, t), None -> accumulator };
      let n = v.statements.len();
      range(0, n).fold(tailed, |a: List<Bytes>, k: Int|
        match v.statements.at(n - 1 - k) {
          Some(LetStatement(x)) -> lits(a, x.value),
          Some(LetElseStatement(x)) -> lits(lits(a, x.fallback), x.value),
          Some(ExpressionStatement(x)) -> lits(a, x),
          Some(AssignmentStatement(x)) -> lits(a, x.value),
          None -> a,
        })
    },
    RecordExpression(v) ->
      backwards(accumulator, v.fields.map(|field: RecordLiteralField| field.value)),
    RecordUpdateExpression(v) ->
      lits(backwards(accumulator, v.fields.map(|field: RecordLiteralField| field.value)), v.base),
    FieldExpression(v) -> lits(accumulator, v.base),
    PropagateExpression(v) -> lits(accumulator, v.operand),
    ListExpression(v) -> backwards(accumulator, v.items),
    PerformExpression(v) -> backwards(accumulator, v.args),
    HandleExpression(v) ->
      backwards(
        lits(accumulator, v.body),
        v.handler_variables.map(|x: HandlerStateVariable| x.init),
      ),
    WithScopeExpression(v) -> lits(lits(lits(accumulator, v.body), v.release), v.acquire),
    SimulateExpression(v) -> lits(accumulator, v.body),
    ParallelExpression(v) -> backwards(accumulator, v.branches),
    TryBlockExpression(v) -> lits(accumulator, v.body),
  }
}

pub fn literals_of(written: List<Expression>) -> List<Bytes> / {abort.raise} =
  written.fold([], |accumulator: List<Bytes>, expression: Expression| lits(accumulator, expression))

pub fn schema_definitions(modules: List<ParsedModule>) -> Map<Bytes, Bool> =
  modules.fold(Map::new(), |accumulator: Map<Bytes, Bool>, parsed: ParsedModule|
    schemas_declared(parsed).fold(accumulator, |a: Map<Bytes, Bool>, n: Bytes| a.insert(n, true)))

fn schemas_declared(parsed: ParsedModule) -> List<Bytes> =
  parsed.module.items.fold([], |accumulator: List<Bytes>, item: Item|
    match item {
      SchemaItem(d) -> {
        let named = accumulator.push(qualify(parsed.name, d.name.name));
        match d.guard {
          Some(_) -> named.push(qualify(parsed.name, schema_guard_name(d.name.name))),
          None -> named,
        }
      },
      _ -> accumulator,
    })

pub fn schemas_instantiated(modules: List<ParsedModule>) -> Map<Bytes, Bytes> =
  modules.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, parsed: ParsedModule|
    parsed.module.items.fold(accumulator, |a: Map<Bytes, Bytes>, item: Item|
      match item {
        LawItem(d) -> match d.of {
          Some(of) -> match of.module {
            Some(home) ->
              a.insert(qualify(parsed.name, d.name), qualify(home, of.schema.name.name)),
            None -> a,
          },
          None -> a,
        },
        _ -> a,
      }))

fn schema_stated(
  modules: List<ParsedModule>,
  law_definition: LawDefinition,
) -> Option<{ guard: Option<Expression>, body: Expression }> / {abort.raise} =
  match law_definition.of {
    None -> None,
    Some(of) -> match home_of(modules, of) {
      None -> None,
      Some(home) -> match schema_named(modules.get(home).module, of.schema.name.name) {
        Some(s) -> Some({ guard: s.guard, body: s.body }),
        None -> None,
      },
    },
  }

fn guard_of(
  modules: List<ParsedModule>,
  law_definition: LawDefinition,
) -> Option<Expression> / {abort.raise} =
  match schema_stated(modules, law_definition) { Some(s) -> s.guard, None -> law_definition.guard }

pub fn claim_literals(
  modules: List<ParsedModule>,
  law_definition: LawDefinition,
) -> List<Bytes> / {abort.raise} = {
  let guarded = match guard_of(modules, law_definition) { Some(g) -> lits([], g), None -> [] };
  let stated = match schema_stated(modules, law_definition) {
    Some(s) -> lits(guarded, s.body),
    None -> guarded,
  };
  lits(stated, law_definition.body)
}

pub fn guard_bounds(
  modules: List<ParsedModule>,
  law_definition: LawDefinition,
) -> List<Bounded> / {abort.raise} =
  match guard_of(modules, law_definition) { Some(g) -> bounds_of([g]), None -> [] }

pub type Bounded = { name: Bytes, low: Int, high: Int }

type Limit = { name: Bytes, lower: Bool, at: Int }

fn farthest_end() -> Int = 1000000000000

fn int_of(e: Expression) -> Option<Int> =
  match e {
    LiteralExpression(v) -> match v.literal { LiteralInt(k) -> Some(k), _ -> None },
    UnaryExpression(v) -> if v.operation != b"neg" { None } else {
      match v.operand {
        LiteralExpression(x) -> match x.literal { LiteralInt(k) -> Some(0 - k), _ -> None },
        _ -> None,
      }
    },
    _ -> None,
  }

fn bare_name(e: Expression) -> Option<Bytes> =
  match e {
    NameExpression(v) -> if is_bare(v.name) { Some(v.name.name.name) } else { None },
    _ -> None,
  }

fn end_of(accumulator: List<Limit>, name: Bytes, comparison: Bytes, k: Int) -> List<Limit> =
  if k > farthest_end() || k < 0 - farthest_end() { accumulator }
  else if comparison == b"gt" { accumulator.push({ name: name, lower: true, at: k + 1 }) }
  else if comparison == b"ge" { accumulator.push({ name: name, lower: true, at: k }) }
  else if comparison == b"lt" { accumulator.push({ name: name, lower: false, at: k - 1 }) }
  else if comparison == b"le" { accumulator.push({ name: name, lower: false, at: k }) }
  else if comparison == b"eq" {
    accumulator.push({ name: name, lower: true, at: k }).push({ name: name, lower: false, at: k })
  } else { accumulator }

fn flipped_comparison(comparison: Bytes) -> Bytes =
  if comparison == b"gt" { b"lt" }
  else if comparison == b"ge" { b"le" }
  else if comparison == b"lt" { b"gt" }
  else if comparison == b"le" { b"ge" }
  else { comparison }

fn add_limits(accumulator: List<Limit>, guard: Expression) -> List<Limit> =
  match guard {
    BinaryExpression(v) -> if v.operation == b"and" {
      add_limits(add_limits(accumulator, v.left_operand), v.right_operand)
    } else {
      match bare_name(v.left_operand) {
        Some(name) -> match int_of(v.right_operand) {
          Some(k) -> end_of(accumulator, name, v.operation, k),
          None -> accumulator,
        },
        None -> match bare_name(v.right_operand) {
          Some(name) -> match int_of(v.left_operand) {
            Some(k) -> end_of(accumulator, name, flipped_comparison(v.operation), k),
            None -> accumulator,
          },
          None -> accumulator,
        },
      }
    },
    _ -> accumulator,
  }

pub fn bounds_of(guards: List<Expression>) -> List<Bounded> = {
  let ends = guards.fold([], add_limits);
  ends.fold([], |accumulator: List<Bounded>, e: Limit|
    if accumulator.fold(false, |seen: Bool, b: Bounded| seen || b.name == e.name) { accumulator }
    else {
      let own = ends.filter(|x: Limit| x.name == e.name);
      let lows = own.filter(|x: Limit| x.lower);
      let highs = own.filter(|x: Limit| !x.lower);
      if lows.len() == 0 || highs.len() == 0 { accumulator } else {
        accumulator.push({
          name: e.name,
          low: lows.fold(0 - farthest_end() - 1, |m: Int, x: Limit| max(m, x.at)),
          high: highs.fold(farthest_end() + 1, |m: Int, x: Limit| min(m, x.at)),
        })
      }
    })
}

pub fn law_literals(outlines: List<Outline>) -> List<List<Bytes>> =
  outlines.fold([], |accumulator: List<List<Bytes>>, o: Outline|
    o.items.fold(accumulator, |a: List<List<Bytes>>, item: OutlineItem|
      match item { OutlinedLaw(l) -> a.push(l.literals), _ -> a }))

pub type ModuleShape = {
  outline: Outline,
  imports: List<Bytes>,
  unimported: List<Bytes>,
  named: List<Bytes>,
  written: List<Bytes>,
  embeds: List<ModuleEmbed>,
  embed_items: List<ItemEmbeds>,
  tagged: List<TaggedSite>,
  statements: List<StatementSite>,
  consts: List<TypedConst>,
}

pub type ModuleTables = {
  definitions: List<DefinitionInfo>,
  tests: List<TestInfo>,
  laws: List<LawInfo>,
  effects: List<EffectInfo>,
  constructors: List<ConstructorInfo>,
  instances: List<InstanceInfo>,
  numeric: List<NumericInfo>,
  facts: EmitFacts,
  cached: List<CachedFacts>,
}

pub type ModuleFacts = { shape: ModuleShape, tables: ModuleTables }

derive bin for ModuleShape

derive bin for ModuleTables

pub fn no_shape(module: Bytes) -> ModuleShape =
  {
    outline: {
      name: module,
      items: [],
      declared: [],
      imports: [],
      schemas: [],
      sets: [],
      cuts: [],
      stated: [],
      set_texts: [],
      derived: [],
    },
    imports: [],
    unimported: [],
    named: [],
    written: [],
    embeds: [],
    embed_items: [],
    tagged: [],
    statements: [],
    consts: [],
  }

pub type EncodedTables = { types: List<InternedType>, at: List<Int>, tables: ModuleTables }

derive bin for EncodedTables

fn untyped(d: DefinitionInfo) -> DefinitionInfo = { ..d, scheme: { ..d.scheme, ty: unit_type() } }

pub fn encode_tables(t: ModuleTables) -> Bytes / {abort.raise} = {
  let h = intern_types(t.definitions.map(|d: DefinitionInfo| d.scheme.ty));
  bin::encode(
    { types: h.labels, at: h.at, tables: { ..t, definitions: t.definitions.map(untyped) } },
    encoded_tables_bin(),
  )
}

pub fn decode_tables(b: Bytes) -> ModuleTables / {abort.raise} =
  match bin::decode(b, encoded_tables_bin()) {
    Err(e) -> panic("cannot decode the stored facts about a module: " ++ e.message),
    Ok(k) -> {
      let types = types_of(k.types);
      {
        ..k.tables,
        definitions: range(0, k.tables.definitions.len()).map(|i: Int| {
          let d = k.tables.definitions.get(i);
          { ..d, scheme: { ..d.scheme, ty: types.get(k.at.get(i)) } }
        }),
      }
    },
  }

pub fn no_module_tables() -> ModuleTables =
  {
    definitions: [],
    tests: [],
    laws: [],
    effects: [],
    constructors: [],
    instances: [],
    numeric: [],
    facts: { pure: [], orders: [], members: [], types: Map::new(), bodies: [] },
    cached: [],
  }

fn moved_location(l: Location, from: Int, to: Int) -> Location =
  if l.module == from { { ..l, module: to } } else { l }

fn moved_shape(s: ModuleShape, from: Int, to: Int) -> ModuleShape =
  {
    ..s,
    tagged: s.tagged.map(|x: TaggedSite| { ..x, module: moved_module(x.module, from, to) }),
    statements: s.statements.map(|x: StatementSite|
      { ..x, module: moved_module(x.module, from, to) }),
    consts: s.consts.map(|x: TypedConst| { ..x, module: moved_module(x.module, from, to) }),
  }

fn moved_module(module: Int, from: Int, to: Int) -> Int = if module == from { to } else { module }

fn moved_tables(t: ModuleTables, from: Int, to: Int, tests: Int, laws: Int) -> ModuleTables = {
  let at = |l: Location| moved_location(l, from, to);
  {
    ..t,
    definitions: t.definitions.map(|d: DefinitionInfo| { ..d, at: at(d.at) }),
    tests: t.tests.map(|x: TestInfo| { ..x, at: at(x.at), index: x.index + tests }),
    laws: t.laws.map(|l: LawInfo| { ..l, at: at(l.at), index: l.index + laws }),
    effects: t.effects.map(|x: EffectInfo|
      {
        ..x,
        at: at(x.at),
        operations: x.operations.map(|operation: OperationInfo|
          { ..operation, at: at(operation.at) }),
      }),
    constructors: t.constructors.map(|c: ConstructorInfo| { ..c, at: at(c.at) }),
    instances: t.instances.map(|x: InstanceInfo| { ..x, at: at(x.at) }),
    numeric: t.numeric.map(|x: NumericInfo| { ..x, at: at(x.at) }),
    facts: remap_fact_modules(t.facts, |module: Int| moved_module(module, from, to)),
  }
}

pub fn module_facts(w: Analysis, i: Int) -> ModuleFacts / {abort.raise} = {
  let name = w.modules.get(i).name;
  let parsed = w.modules.get(i);
  let mine = |module: Int| module == i;
  let c = w.checked;
  let tests = c.tests.filter(|t: TestInfo| t.module == name);
  let laws = c.laws.filter(|l: LawInfo| l.module == name);
  let owned = |owner: Bytes| is_declared_in(name, owner);
  {
    shape: moved_shape(
      {
        outline: outline_of(
          parsed,
          effect_sets_of(w.r, c.effects, i, parsed),
          match w.stub_cuts.get(name) { Some(cuts) -> cuts, None -> cuts_of(parsed) },
          w.modules,
        ),
        imports: w.r.imports.get(i).map(|t: Int| w.modules.get(t).name),
        unimported: w.unimported.get(i),
        named: named_imports(parsed, w.r.imports.get(i).map(|t: Int| w.modules.get(t).name)),
        written: parsed.module.imports.map(import_module_name),
        embeds: w.embeds.filter(|x: ModuleEmbed| x.module == name),
        embed_items: {
          let items = requests_by_item(parsed.module);
          if items.fold(false, |b: Bool, x: ItemEmbeds| b || x.wants.len() > 0) { items }
          else { [] }
        },
        tagged: tagged_of(w, i),
        statements: statements_of(w, i),
        consts: typed_consts_of(w, i),
      },
      i,
      0,
    ),
    tables: moved_tables(
      {
        definitions: c.definitions.filter(|d: DefinitionInfo| d.module == name),
        tests: tests,
        laws: laws,
        effects: c.effects.filter(|x: EffectInfo| x.module == name),
        constructors: c.constructors.filter(|x: ConstructorInfo| x.module == name),
        instances: c.instances.filter(|x: InstanceInfo| mine(x.at.module)),
        numeric: c.numeric_types.filter(|x: NumericInfo| mine(x.at.module)),
        facts: {
          ..facts_filtered(c.facts, |module: Int, owner: Bytes| mine(module)),
          pure: c.facts.pure.filter(|n: Bytes| is_declared_in(name, n)),
          orders: c.facts.orders.filter(|x: WitnessOrder| mine(x.module)),
        },
        cached: c.cached.filter(|k: CachedFacts| owned(k.name)),
      },
      i,
      0,
      0 - first_index(tests.map(|t: TestInfo| t.index)),
      0 - first_index(laws.map(|l: LawInfo| l.index)),
    ),
  }
}

pub fn named_imports(parsed: ParsedModule, targets: List<Bytes>) -> List<Bytes> / {abort.raise} =
  range(0, parsed.module.imports.len()).fold([], |accumulator: List<Bytes>, k: Int|
    match parsed.module.imports.get(k).kind {
      SelectedNames(names) -> match targets.at(k) {
        Some(module) ->
          names.fold(accumulator, |a: List<Bytes>, n: Identifier| a.push(qualify(module, n.name))),
        None -> accumulator,
      },
      _ -> accumulator,
    })

fn first_index(xs: List<Int>) -> Int = match xs { [x, ..] -> x, [] -> 0 }

fn reachable_shipped_functions(
  shapes: List<ModuleShape>,
  hashes: HashOutput,
  shipped: Map<Bytes, Bool>,
) -> Map<Bytes, Bool> / {abort.raise} = {
  let roots = shapes.fold([], |accumulator: List<Subject>, s: ModuleShape| {
    let o = s.outline;
    if shipped.contains(o.name) {
      o.items.fold(
        accumulator.concat(o.stated.map(|t: Bytes| DeclarationNamed(t))),
        |a: List<Subject>, item: OutlineItem|
          match item {
            OutlinedType(x) -> a.push(DeclarationNamed(qualify(o.name, x.name))),
            OutlinedEffect(x) -> a.push(DeclarationNamed(qualify(o.name, x.name))),
            _ -> a,
          },
      )
    } else {
      let own = o.items.fold(accumulator, |a: List<Subject>, item: OutlineItem|
        match item {
          OutlinedFunction(x) -> a.push(FunctionNamed(qualify(o.name, x.name))),
          OutlinedType(x) -> a.push(DeclarationNamed(qualify(o.name, x.name))),
          OutlinedEffect(x) -> a.push(DeclarationNamed(qualify(o.name, x.name))),
          OutlinedTest(x) -> a.push(ItemKeyed(qualify(o.name, x.name))),
          OutlinedLaw(x) -> a.push(ItemKeyed(qualify(o.name, x.name))),
        });
      s.named.fold(own, |a: List<Subject>, n: Bytes|
        if hashes.refs.declared.contains(n) { a } else { a.push(FunctionNamed(n)) })
    }
  });
  reachable_functions(hashes, roots)
}

fn survives_cut(o: Outline, reachable: Map<Bytes, Bool>, item: OutlineItem) -> Bool =
  match item {
    OutlinedFunction(x) -> reachable.contains(qualify(o.name, x.name)),
    OutlinedTest(_) -> false,
    OutlinedLaw(_) -> false,
    _ -> true,
  }

fn cut_shape(s: ModuleShape, reachable: Map<Bytes, Bool>) -> ModuleShape = {
  let o = s.outline;
  let gone = o.items.fold(Map::new(), |accumulator: Map<Bytes, Int>, item: OutlineItem|
    match item {
      OutlinedFunction(x) -> if survives_cut(o, reachable, item) { accumulator } else {
        let name = qualify(o.name, x.name);
        accumulator.insert(name, match accumulator.get(name) { Some(n) -> n + 1, None -> 1 })
      },
      _ -> accumulator,
    });
  {
    ..s,
    outline: {
      ..o,
      items: o.items.filter(|item: OutlineItem| survives_cut(o, reachable, item)),
      declared: o.declared.fold(
        { left: gone, names: [] },
        |accumulator: { left: Map<Bytes, Int>, names: List<Bytes> }, n: Bytes|
          match accumulator.left.get(n) {
            Some(k) -> if k > 0 { { ..accumulator, left: accumulator.left.insert(n, k - 1) } }
            else { { ..accumulator, names: accumulator.names.push(n) } },
            None -> { ..accumulator, names: accumulator.names.push(n) },
          },
      ).names,
      cuts: o.cuts.filter(|c: Cut| c.braced && !gone.contains(c.name)),
    },
  }
}

fn cut_tables(
  t: ModuleTables,
  o: Outline,
  reachable: Map<Bytes, Bool>,
) -> ModuleTables / {abort.raise} = {
  {
    ..t,
    definitions: t.definitions.filter(|d: DefinitionInfo| reachable.contains(d.name)),
    tests: [],
    laws: [],
    facts: {
      ..facts_filtered(t.facts, |module: Int, owner: Bytes| reachable.contains(owner)),
      pure: t.facts.pure.filter(|n: Bytes| reachable.contains(n)),
      orders: t.facts.orders.filter(|x: WitnessOrder| reachable.contains(qualify(o.name, x.name))),
    },
    cached: t.cached.filter(|k: CachedFacts| reachable.contains(k.name)),
  }
}

fn test_and_law_owners(outlines: List<Outline>) -> Map<Bytes, Bool> / {abort.raise} =
  outlines.fold(Map::new(), |accumulator: Map<Bytes, Bool>, o: Outline|
    o.items.fold(accumulator, |m: Map<Bytes, Bool>, item: OutlineItem|
      match item {
        OutlinedTest(t) -> m.insert(test_owner(o.name, t.name), true),
        OutlinedLaw(l) -> m.insert(law_owner(o.name, l.name), true),
        _ -> m,
      }))

fn in_check_order<a>(
  checked: List<ModuleTables>,
  placed: List<ModuleTables>,
  pick: (ModuleTables) -> List<a>,
  first: (a) -> Bool / {abort.raise},
) -> List<a> / {abort.raise} =
  placed.fold(
    checked.fold([], |accumulator: List<a>, t: ModuleTables|
      accumulator.concat(pick(t).filter(first))),
    |accumulator: List<a>, t: ModuleTables| accumulator.concat(pick(t).filter(|x: a| !first(x))),
  )

fn function_spans_of(o: Outline) -> List<Span> =
  o.items.fold([], |accumulator: List<Span>, item: OutlineItem|
    match item { OutlinedFunction(x) -> accumulator.push(x.span), _ -> accumulator })

fn within_any(spans: List<Span>, span: Span) -> Bool =
  spans.fold(false, |b: Bool, at: Span| b || (span.start >= at.start && span.end <= at.end))

fn untested_shape(s: ModuleShape) -> ModuleShape = {
  let spans = function_spans_of(s.outline);
  {
    ..s,
    outline: {
      ..s.outline,
      items: s.outline.items.filter(|item: OutlineItem|
        match item { OutlinedTest(_) -> false, OutlinedLaw(_) -> false, _ -> true }),
    },
    tagged: s.tagged.filter(|x: TaggedSite| within_any(spans, x.span)),
    statements: s.statements.filter(|x: StatementSite| within_any(spans, x.span)),
  }
}

fn untested_tables(t: ModuleTables, o: Outline) -> ModuleTables / {abort.raise} = {
  let apart = test_and_law_owners([o]);
  let of_definitions = |owner: Bytes| !apart.contains(owner);
  {
    ..t,
    tests: [],
    laws: [],
    facts: facts_filtered(t.facts, |module: Int, owner: Bytes| of_definitions(owner)),
    cached: t.cached.filter(|k: CachedFacts| of_definitions(k.name)),
  }
}

fn views_read(
  shapes: List<ModuleShape>,
  hashes: HashOutput,
  read: Map<Bytes, Bool>,
  texts: Map<Bytes, Bytes>,
) -> List<ShippedModuleSummary> / {abort.raise} = {
  let definitions = by_name(hashes.definitions);
  let declarations = by_name(hashes.declarations);
  let hash_of = |table: Map<Bytes, Bytes>, name: Bytes|
    match table.get(name) { Some(hash) -> hash, None -> b"" };
  shapes.fold([], |accumulator: List<ShippedModuleSummary>, s: ModuleShape| {
    let o = s.outline;
    match texts.get(o.name) {
      None -> accumulator,
      Some(text) -> {
        let declared = o.items.fold([], |a: List<Bytes>, item: OutlineItem| {
          let line = |name: Bytes|
            a.push(
              Bytes::concat_all([
                b"declared ",
                qualify(o.name, name),
                b" ",
                hash_of(declarations, qualify(o.name, name)),
              ]),
            );
          match item { OutlinedType(x) -> line(x.name), OutlinedEffect(x) -> line(x.name), _ -> a }
        });
        let shape = declared.concat(s.imports.map(|m: Bytes| b"imports ".concat(m))).concat(
          o.set_texts.map(|t: Bytes| b"set ".concat(t)),
        );
        accumulator.push({
          module: o.name,
          text: hex(blake3(text)),
          form: hex(blake3(Bytes::join(shape, b"\n"))),
          definitions: o.items.fold(
            [],
            |a: List<{ name: Bytes, hash: Bytes }>, item: OutlineItem|
              match item {
                OutlinedFunction(x) -> {
                  let name = qualify(o.name, x.name);
                  if read.contains(name) {
                    a.push({ name: name, hash: hex(hash_of(definitions, name)) })
                  } else { a }
                },
                _ -> a,
              },
          ),
        })
      },
    }
  })
}

pub type Frame = {
  outlines: List<Outline>,
  order: List<Bytes>,
  imports: List<List<Bytes>>,
  unimported: List<List<Bytes>>,
  hashes: HashOutput,
  warnings: List<Diagnostic>,
  manifest: Option<Manifest>,
  packages: List<PackageDependencies>,
  pins: List<LockedPackage>,
  module_packages: List<Int>,
  embeds: List<ModuleEmbed>,
  embed_items: Map<Bytes, List<ItemEmbeds>>,
  tagged: List<TaggedSite>,
  statements: List<StatementSite>,
  consts: List<TypedConst>,
}

pub type CheckedProgram = { frame: Frame, checked: CheckOutput }

pub type TableReads = { reads: List<TablesRead>, reachable: Map<Bytes, Bool> }

pub type TablesRead = { outline: Outline, untested: Bool, trimmed: Bool }

pub fn no_reads() -> TableReads = { reads: [], reachable: Map::new() }

pub fn functions_of(frame: Frame) -> Int =
  frame.outlines.fold(0, |n: Int, o: Outline|
    o.items.fold(n, |k: Int, item: OutlineItem|
      match item { OutlinedFunction(_) -> k + 1, _ -> k }))

pub fn written_functions_of(frame: Frame) -> Int =
  functions_of({
    ..frame,
    outlines: frame.outlines.filter(|o: Outline| o.name != prelude_module()),
  })

pub fn tests_of(frame: Frame, own: Int) -> Int =
  frame.outlines.take(own).fold(0, |n: Int, o: Outline|
    o.items.fold(n, |k: Int, item: OutlineItem| match item { OutlinedTest(_) -> k + 1, _ -> k }))

pub fn framed_program(
  shapes: List<ModuleShape>,
  fixing: CachedHashes,
  shipped: Map<Bytes, Bytes>,
  tested: Bool,
  prune_unreachable: Bool,
  warnings: List<Diagnostic>,
  manifest: Option<Manifest>,
  packages: List<PackageDependencies>,
  pins: List<LockedPackage>,
  module_packages: List<Int>,
  embeds: List<ModuleEmbed>,
) -> { frame: Frame, reads: TableReads, views: List<ShippedModuleSummary> } / {abort.raise} = {
  let untested = |s: ModuleShape| !tested && !shipped.contains(s.outline.name);
  let read = shapes.map(|s: ModuleShape| if untested(s) { untested_shape(s) } else { s });
  let cutting = prune_unreachable
    && read.fold(false, |b: Bool, s: ModuleShape| b || shipped.contains(s.outline.name));
  let whole = hashes_from_cache(skeleton_of_outlines(read.map(|s: ModuleShape| s.outline)), fixing);
  let reach = if cutting {
    reachable_shipped_functions(
      read,
      whole,
      shipped.fold(Map::new(), |m: Map<Bytes, Bool>, n: Bytes, _: Bytes| m.insert(n, true)),
    )
  } else { Map::new() };
  let cut = |s: ModuleShape| cutting && shipped.contains(s.outline.name);
  let merged = merged_shapes(
    read.map(|s: ModuleShape| if cut(s) { cut_shape(s, reach) } else { s }),
  );
  let hashes = hashes_from_cache(skeleton_of_outlines(merged.outlines), fixing);
  {
    frame: {
      outlines: merged.outlines,
      order: merged.order,
      imports: merged.imports,
      unimported: merged.unimported,
      hashes: hashes,
      warnings: warnings,
      manifest: manifest,
      packages: packages,
      pins: pins,
      module_packages: module_packages,
      embeds: embeds,
      embed_items: read.fold(
        Map::new(),
        |accumulator: Map<Bytes, List<ItemEmbeds>>, s: ModuleShape|
          if s.embed_items.len() == 0 { accumulator }
          else { accumulator.insert(s.outline.name, s.embed_items) },
      ),
      tagged: root_tagged(module_packages, hashes, merged.tagged),
      statements: root_statements(module_packages, hashes, merged.statements),
      consts: root_consts(module_packages, merged.consts),
    },
    reads: {
      reads: shapes.map(|s: ModuleShape|
        { outline: s.outline, untested: untested(s), trimmed: cut(s) }),
      reachable: reach,
    },
    views: if cutting { views_read(read, whole, reach, shipped) } else { [] },
  }
}

pub fn checked_program_over(
  frame: Frame,
  reads: TableReads,
  tables: List<ModuleTables>,
) -> CheckedProgram / {abort.raise} = {
  let placed = range(0, tables.len()).fold(
    { out: [], tests: 0, laws: 0 },
    |accumulator: { out: List<ModuleTables>, tests: Int, laws: Int }, k: Int| {
      let r = reads.reads.get(k);
      let plain = if r.untested { untested_tables(tables.get(k), r.outline) }
      else { tables.get(k) };
      let t = if r.trimmed { cut_tables(plain, r.outline, reads.reachable) } else { plain };
      {
        out: accumulator.out.push(moved_tables(t, 0, k, accumulator.tests, accumulator.laws)),
        tests: accumulator.tests + t.tests.len(),
        laws: accumulator.laws + t.laws.len(),
      }
    },
  ).out;
  { frame: frame, checked: merged_tables(prelude_tables(), frame.outlines, frame.order, placed) }
}

pub fn assembled_program(
  facts: List<ModuleFacts>,
  fixing: CachedHashes,
  shipped: Map<Bytes, Bytes>,
  tested: Bool,
  prune_unreachable: Bool,
  warnings: List<Diagnostic>,
  manifest: Option<Manifest>,
  packages: List<PackageDependencies>,
  pins: List<LockedPackage>,
  module_packages: List<Int>,
  embeds: List<ModuleEmbed>,
) -> { view: CheckedProgram, views: List<ShippedModuleSummary> } / {abort.raise} = {
  let f = framed_program(
    facts.map(|x: ModuleFacts| x.shape),
    fixing,
    shipped,
    tested,
    prune_unreachable,
    warnings,
    manifest,
    packages,
    pins,
    module_packages,
    embeds,
  );
  {
    view: checked_program_over(f.frame, f.reads, facts.map(|x: ModuleFacts| x.tables)),
    views: f.views,
  }
}

pub fn pulled_next(
  read: List<Bytes>,
  written: Map<Bytes, List<Bytes>>,
  listed: Map<Bytes, Bool>,
  requested_modules: List<Bytes>,
) -> List<Bytes> = {
  let present = read.fold(Map::new(), |accumulator: Map<Bytes, Bool>, n: Bytes|
    accumulator.insert(n, true));
  let wants = |accumulator: Map<Bytes, Bool>, w: Bytes|
    if is_shipped(w) && !present.contains(w) && listed.contains(w) { accumulator.insert(w, true) }
    else { accumulator };
  read.fold(
    requested_modules.fold(Map::new(), wants),
    |accumulator: Map<Bytes, Bool>, n: Bytes|
      List::fold(match written.get(n) { Some(ws) -> ws, None -> [] }, accumulator, wants),
  ).keys(
  )
}

pub type AssembledLoad = {
  frame: Frame,
  reads: TableReads,
  views: List<ShippedModuleSummary>,
  pulled: List<Bytes>,
}

pub fn assembled_load(
  own: List<Bytes>,
  packages: PackageSources,
  shapes: Map<Bytes, ModuleShape>,
  fixing: CachedHashes,
  pulled: List<Bytes>,
  listed: List<Bytes>,
  texts: Map<Bytes, Bytes>,
  tested: Bool,
  prune_unreachable: Bool,
  warnings: List<Diagnostic>,
) -> AssembledLoad / {abort.raise} = {
  let clo = closure(packages, own);
  let users = own.concat(clo.modules.map(|m: { pkg: Int, source: Source }| m.source.name));
  let names = users.concat(pulled);
  let read = names.map(|n: Bytes| match shapes.get(n) { Some(s) -> s, None -> no_shape(n) });
  let embeds = read.fold([], |accumulator: List<ModuleEmbed>, s: ModuleShape|
    accumulator.concat(s.embeds));
  let tables = package_tables(names, own.len(), clo, toolchain_tree(own, listed));
  let program = framed_program(
    read,
    fixing,
    pulled.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, n: Bytes|
      match texts.get(n) { Some(t) -> accumulator.insert(n, t), None -> accumulator }),
    tested,
    prune_unreachable,
    warnings,
    clo.packages.get(0).manifest,
    tables.packages,
    pins_of(clo, embeds),
    tables.module_packages,
    embeds,
  );
  { frame: program.frame, reads: program.reads, views: program.views, pulled: pulled }
}

fn order_of(names: List<Bytes>, imports: List<List<Bytes>>) -> List<Bytes> / {abort.raise} = {
  let at_name = range(0, names.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
    accumulator.insert(names.get(i), i));
  let edges = imports.map(|xs: List<Bytes>|
    xs.fold([], |accumulator: List<Int>, x: Bytes|
      match at_name.get(x) { Some(t) -> accumulator.push(t), None -> accumulator }));
  post_order(edges).map(|i: Int| names.get(i))
}

fn merged_shapes(
  shapes: List<ModuleShape>,
) -> { outlines: List<Outline>, order: List<Bytes>, imports: List<List<Bytes>>, unimported: List<List<Bytes>>, tagged: List<TaggedSite>, statements: List<StatementSite>, consts: List<TypedConst> } / {abort.raise} = {
  let placed = range(0, shapes.len()).map(|k: Int| moved_shape(shapes.get(k), 0, k));
  let imports = placed.map(|s: ModuleShape| s.imports);
  {
    outlines: placed.map(|s: ModuleShape| s.outline),
    order: order_of(placed.map(|s: ModuleShape| s.outline.name), imports),
    imports: imports.map(|xs: List<Bytes>|
      xs.fold([], |accumulator: List<Bytes>, x: Bytes|
        if accumulator.contains(x) { accumulator } else { accumulator.push(x) })),
    unimported: placed.map(|s: ModuleShape| s.unimported),
    tagged: placed.fold([], |accumulator: List<TaggedSite>, s: ModuleShape|
      accumulator.concat(s.tagged)),
    statements: placed.fold([], |accumulator: List<StatementSite>, s: ModuleShape|
      accumulator.concat(s.statements)),
    consts: placed.fold([], |accumulator: List<TypedConst>, s: ModuleShape|
      accumulator.concat(s.consts)),
  }
}

fn merged_tables(
  prelude: { effects: List<EffectInfo>, constructors: List<ConstructorInfo> },
  outlines: List<Outline>,
  order: List<Bytes>,
  placed: List<ModuleTables>,
) -> CheckOutput / {abort.raise} = {
  let at_name = range(0, outlines.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, k: Int|
    accumulator.insert(outlines.get(k).name, k));
  let checked_order = order.fold([], |accumulator: List<ModuleTables>, n: Bytes|
    match at_name.get(n) { Some(k) -> accumulator.push(placed.get(k)), None -> accumulator });
  let apart = test_and_law_owners(outlines);
  let of_definitions = |owner: Bytes| !apart.contains(owner);
  {
    ok: true,
    diagnostics: [],
    warnings: [],
    definitions: checked_order.fold([], |accumulator: List<DefinitionInfo>, t: ModuleTables|
      accumulator.concat(t.definitions)),
    tests: placed.fold([], |accumulator: List<TestInfo>, t: ModuleTables|
      accumulator.concat(t.tests)),
    laws: placed.fold([], |accumulator: List<LawInfo>, t: ModuleTables| accumulator.concat(t.laws)),
    effects: checked_order.fold(
      prelude.effects,
      |accumulator: List<EffectInfo>, t: ModuleTables| accumulator.concat(t.effects),
    ),
    constructors: checked_order.fold(
      prelude.constructors,
      |accumulator: List<ConstructorInfo>, t: ModuleTables| accumulator.concat(t.constructors),
    ),
    seeded: [],
    cached_tests: [],
    facts: {
      pure: checked_order.fold([], |accumulator: List<Bytes>, t: ModuleTables|
        accumulator.concat(t.facts.pure)),
      orders: checked_order.fold([], |accumulator: List<WitnessOrder>, t: ModuleTables|
        accumulator.concat(t.facts.orders)),
      members: in_check_order(
        checked_order,
        placed,
        |t: ModuleTables| t.facts.members,
        |x: MemberSite| of_definitions(x.owner),
      ),
      bodies: in_check_order(
        checked_order,
        placed,
        |t: ModuleTables| t.facts.bodies,
        |x: TypedBody<Bytes>| of_definitions(x.owner),
      ),
      types: checked_order.fold(Map::new(), |accumulator: TypeTable, t: ModuleTables|
        types_joined(accumulator, t.facts.types)),
    },
    cached: checked_order.fold([], |accumulator: List<CachedFacts>, t: ModuleTables|
      accumulator.concat(t.cached)),
    instances: checked_order.fold([], |accumulator: List<InstanceInfo>, t: ModuleTables|
      accumulator.concat(t.instances)),
    numeric_types: checked_order.fold([], |accumulator: List<NumericInfo>, t: ModuleTables|
      accumulator.concat(t.numeric)),
  }
}

fn exposes_body(definition: FnDefinition) -> Bool =
  definition.generics.labels.len() > 0
    || (match definition.transparent { Some(_) -> true, None -> false })

pub fn cuts_of(parsed: ParsedModule) -> List<Cut> = {
  let generated = parsed.derived.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bool>, d: DeriveOrigin| accumulator.insert(span_key(d.span), true),
  );
  parsed.module.items.fold([], |accumulator: List<Cut>, item: Item|
    match item {
      FunctionItem(d) -> if generated.contains(span_key(d.span)) || exposes_body(d) { accumulator }
      else {
        let b = expression_span(d.body);
        if b.end - b.start < 2 { accumulator } else {
          accumulator.push({
            start: b.start,
            end: b.end,
            braced: true,
            name: qualify(parsed.name, d.name.name),
            test: false,
          })
        }
      },
      TestItem(d) ->
        accumulator.push({
          start: d.span.start,
          end: d.span.end,
          braced: false,
          name: b"",
          test: false,
        }),
      LawItem(d) ->
        accumulator.push({
          start: d.span.start,
          end: d.span.end,
          braced: false,
          name: b"",
          test: false,
        }),
      _ -> accumulator,
    })
}

pub type Analysis = {
  modules: List<ParsedModule>,
  r: Resolution,
  unimported: List<List<Bytes>>,
  checked: CheckOutput,
  index: Index,
  hashes: HashOutput,
  warnings: List<Diagnostic>,
  uses: List<UseNode>,
  manifest: Option<Manifest>,
  packages: List<PackageDependencies>,
  locked_packages: List<LockedPackage>,
  module_packages: List<Int>,
  stub_cuts: Map<Bytes, List<Cut>>,
  embeds: List<ModuleEmbed>,
  embed_items: Map<Bytes, List<ItemEmbeds>>,
  bodies: List<CheckedBody>,
}

pub type TaggedSite = {
  module: Int,
  span: Span,
  tag: Bytes,
  parts: List<TaggedPart>,
  callee: Bytes,
  hash: Bytes,
}

derive bin for TaggedSite

pub fn tagged_of(w: Analysis, i: Int) -> List<TaggedSite> / {abort.raise} =
  tagged_in(w.modules.get(i).module).fold([], |sites: List<TaggedSite>, t: TaggedLiteral|
    match tagged_target(w.index, i, t) {
      None -> sites,
      Some(callee) ->
        sites.push({
          module: i,
          span: t.span,
          tag: t.tag.name,
          parts: tagged_parts(t),
          callee: callee,
          hash: b"",
        }),
    })

pub fn root_tagged(
  module_packages: List<Int>,
  hashes: HashOutput,
  sites: List<TaggedSite>,
) -> List<TaggedSite> = {
  let hashed = by_name(hashes.definitions);
  sites.fold([], |accumulator: List<TaggedSite>, t: TaggedSite|
    if module_packages.at(t.module) != Some(0) { accumulator } else {
      accumulator.push({ ..t, hash: match hashed.get(t.callee) { Some(h) -> h, None -> b"" } })
    })
}

pub type TypedConst = { module: Int, name: Bytes, type_name: Bytes }

derive bin for TypedConst

pub fn typed_consts_of(w: Analysis, i: Int) -> List<TypedConst> / {abort.raise} =
  w.modules.get(i).module.items.fold([], |accumulator: List<TypedConst>, item: Item|
    match item {
      FunctionItem(d) -> match ((d.constant, d.return_type)) {
        (Some(_), Some(NamedTypeExpression(c))) -> match qualified_type_name(w.index, i, c.name) {
          Some(type_name) ->
            accumulator.push({
              module: i,
              name: qualify(w.modules.get(i).name, d.name.name),
              type_name: type_name,
            }),
          None -> accumulator,
        },
        _ -> accumulator,
      },
      _ -> accumulator,
    })

pub fn root_consts(module_packages: List<Int>, consts: List<TypedConst>) -> List<TypedConst> =
  consts.filter(|c: TypedConst| module_packages.at(c.module) == Some(0))

pub type Argument =
  | TextArgument(Bytes)
  | CallArgument({ callee: Bytes, hash: Bytes, args: List<Argument> })
  | RowArgument(List<RowField>)
  | TaggedArgument({ callee: Bytes, hash: Bytes, parts: List<Bytes>, holes: List<Argument> })
  | ListArgument(List<Argument>)
  | ConstructorArgument({ type_name: Bytes, name: Bytes })
  | OtherArgument

derive bin for Argument

pub type StatementSite = {
  module: Int,
  span: Span,
  callee: Bytes,
  label: Bytes,
  args: List<Argument>,
}

derive bin for StatementSite

pub fn statement_modules() -> List<Bytes> = [b"std.db", b"std.sqlite"]

fn of_statement_module(callee: Bytes) -> Bool =
  statement_modules().fold(false, |b: Bool, m: Bytes| b || callee.starts_with(m.concat(b".")))

type ArgumentScope = { index: Index, hashes: Map<Bytes, Bytes>, rows: Map<Bytes, List<RowField>> }

pub type RowRead =
  | ScalarRead(Bytes)
  | OptionalRead(RowRead)
  | ArrayRead(Bytes)
  | DocumentRead
  | JsonRead

pub type RowField = { name: Bytes, read: RowRead }

derive bin for RowRead
derive bin for RowField

fn derived_rows(modules: List<ParsedModule>) -> Map<Bytes, List<RowField>> / {abort.raise} =
  modules.fold(Map::new(), |accumulator: Map<Bytes, List<RowField>>, parsed: ParsedModule|
    parsed.module.items.fold(accumulator, |rows: Map<Bytes, List<RowField>>, item: Item|
      match item {
        DeriveItem(d) -> if deriver_module(parsed.module, d.deriver) != Some(b"std.sql") { rows }
        else {
          match codec::row_columns(
              declaration_of(parsed.name, parsed.module, d.target.name, d.deriver),
            ) {
            Some(columns) ->
              rows.insert(
                qualify(
                  parsed.name,
                  Bytes::of_string(codec::row_function(String::of_bytes(d.target.name))),
                ),
                columns.map(|c: codec::RowColumn|
                  { name: Bytes::of_string(c.name), read: row_read_of(c.read) }),
              ),
            None -> rows,
          }
        },
        _ -> rows,
      }))

fn row_read_of(read: codec::ColumnRead) -> RowRead =
  match read {
    codec::Scalar(reader) -> ScalarRead(Bytes::of_string(reader)),
    codec::Optional(inner) -> OptionalRead(row_read_of(inner)),
    codec::Array(reader) -> ArrayRead(Bytes::of_string(reader)),
    codec::Document -> DocumentRead,
    codec::ByJson(_) -> JsonRead,
  }

pub fn statements_of(w: Analysis, i: Int) -> List<StatementSite> / {abort.raise} = {
  let name = w.modules.get(i).name;
  let imported = w.r.imports.get(i).map(|t: Int| w.modules.get(t).name);
  if statement_modules().contains(name)
      || !statement_modules().fold(false, |b: Bool, m: Bytes| b || imported.contains(m)) { [] }
  else { sites_in(w, i, of_statement_module, Map::new()) }
}

pub fn sites_in(
  w: Analysis,
  i: Int,
  picked: (Bytes) -> Bool,
  hashes: Map<Bytes, Bytes>,
) -> List<StatementSite> / {abort.raise} = {
  let reading = { index: w.index, hashes: hashes, rows: derived_rows(w.modules) };
  let calls = expressions_matching(w.modules.get(i).module, |e: Expression|
    match e { PerformExpression(_) -> true, CallExpression(a) -> a.labels.len() > 0, _ -> false });
  calls.fold([], |sites: List<StatementSite>, e: Expression|
    match statement_site(reading, i, e) {
      Some(site) -> if picked(site.callee) { sites.push(site) } else { sites },
      None -> sites,
    })
}

pub fn root_statements(
  module_packages: List<Int>,
  hashes: HashOutput,
  sites: List<StatementSite>,
) -> List<StatementSite> / {abort.raise} = {
  let hashed = by_name(hashes.definitions);
  sites.fold([], |accumulator: List<StatementSite>, x: StatementSite|
    if module_packages.at(x.module) != Some(0) { accumulator }
    else { accumulator.push({ ..x, args: x.args.map(|a: Argument| hashed_argument(hashed, a)) }) })
}

fn hashed_argument(hashed: Map<Bytes, Bytes>, a: Argument) -> Argument / {abort.raise} = {
  let hash_of = |name: Bytes| match hashed.get(name) { Some(h) -> h, None -> b"" };
  match a {
    CallArgument(c) ->
      CallArgument({
        ..c,
        hash: hash_of(c.callee),
        args: c.args.map(|x: Argument| hashed_argument(hashed, x)),
      }),
    TaggedArgument(t) ->
      TaggedArgument({
        ..t,
        hash: hash_of(t.callee),
        holes: t.holes.map(|x: Argument| hashed_argument(hashed, x)),
      }),
    ListArgument(xs) -> ListArgument(xs.map(|x: Argument| hashed_argument(hashed, x))),
    other -> other,
  }
}

fn statement_site(
  reading: ArgumentScope,
  module: Int,
  e: Expression,
) -> Option<StatementSite> / {abort.raise} = {
  let args = |xs: List<Expression>| xs.map(|x: Expression| argument(reading, module, x));
  match e {
    PerformExpression(p) -> match ((
        qualified_effect_name(reading.index, module, p.effect_name),
        p.resource,
      )) {
      (Some(named), Some(label)) ->
        Some({
          module: module,
          span: p.span,
          callee: Bytes::concat_all([named, b".", p.operation.name]),
          label: label.name,
          args: args(p.args),
        }),
      _ -> None,
    },
    CallExpression(a) -> match ((a.function, a.labels.at(0))) {
      (NameExpression(v), Some(label)) -> match denotation(reading.index, module, v.name) {
        DenotesFunction(callee) ->
          Some({
            module: module,
            span: a.span,
            callee: callee,
            label: label.name,
            args: args(a.args),
          }),
        _ -> None,
      },
      _ -> None,
    },
    _ -> None,
  }
}

fn argument(reading: ArgumentScope, module: Int, e: Expression) -> Argument / {abort.raise} = {
  let hash_of = |name: Bytes| match reading.hashes.get(name) { Some(h) -> h, None -> b"" };
  match e {
    LiteralExpression(l) -> match l.literal {
      LiteralString(s) -> TextArgument(s),
      _ -> OtherArgument,
    },
    BinaryExpression(b) -> if b.operation != b"++" { OtherArgument } else {
      match ((
          argument(reading, module, b.left_operand),
          argument(reading, module, b.right_operand),
        )) {
        (TextArgument(x), TextArgument(y)) -> TextArgument(x.concat(y)),
        _ -> OtherArgument,
      }
    },
    NameExpression(v) -> match denotation(reading.index, module, v.name) {
      DenotesConstructor(c) -> ConstructorArgument(c),
      _ -> OtherArgument,
    },
    CallExpression(a) -> if a.labels.len() > 0 || a.named.len() > 0 { OtherArgument } else {
      match a.function {
        NameExpression(v) -> match denotation(reading.index, module, v.name) {
          DenotesFunction(callee) -> match reading.rows.get(callee) {
            Some(fields) -> if a.args.len() == 0 { RowArgument(fields) } else { OtherArgument },
            None ->
              CallArgument({
                callee: callee,
                hash: hash_of(callee),
                args: a.args.map(|x: Expression| argument(reading, module, x)),
              }),
          },
          DenotesConstructor(c) -> ConstructorArgument(c),
          DenotesNothing -> OtherArgument,
        },
        _ -> OtherArgument,
      }
    },
    ListExpression(l) -> ListArgument(l.items.map(|x: Expression| argument(reading, module, x))),
    TaggedLiteralExpression(t) -> match tagged_target(reading.index, module, t) {
      Some(callee) ->
        TaggedArgument({
          callee: callee,
          hash: hash_of(callee),
          parts: tagged_parts(t).map(|part: TaggedPart| part.text),
          holes: t.holes.map(|h: Hole| argument(reading, module, h.value)),
        }),
      None -> OtherArgument,
    },
    _ -> OtherArgument,
  }
}

pub fn std_package() -> PackageDependencies = { prefix: b"std", dependencies: [] }

pub fn compiler_package() -> PackageDependencies = { prefix: b"compiler", dependencies: [b"std"] }

pub type PackageTables = {
  packages: List<PackageDependencies>,
  module_packages: List<Int>,
  std: Int,
  compiler: Int,
  other_shipped_package: Int,
}

pub fn package_tables(
  names: List<Bytes>,
  root_count: Int,
  clo: Closure,
  tree: ToolchainTree,
) -> PackageTables / {abort.raise} = {
  let own = clo.packages.map(|package: Package|
    { prefix: package.prefix, dependencies: package.dependencies });
  let std = if tree == StdTree { own.len() - 1 } else { own.len() };
  let compiler = std + 1;
  {
    packages: List::push(
      if tree == StdTree { own } else { own.push(std_package()) },
      compiler_package(),
    ),
    module_packages: range(0, names.len()).map(|i: Int|
      if i < root_count { 0 }
      else if i < root_count + clo.modules.len() { clo.modules.get(i - root_count).pkg }
      else if is_compiler(names.get(i)) { compiler }
      else { compiler + 1 }),
    std: std,
    compiler: compiler,
    other_shipped_package: compiler + 1,
  }
}

pub fn is_shipped_module(
  packages: List<PackageDependencies>,
  module_packages: List<Int>,
  i: Int,
) -> Bool =
  match module_packages.at(i) {
    Some(k) -> match packages.at(k) { Some(p) -> is_shipped(p.prefix), None -> true },
    None -> false,
  }

pub type ToolchainTree = | NoTree | StdTree | CompilerTree

pub fn toolchain_tree(own: List<Bytes>, listed: List<Bytes>) -> ToolchainTree = {
  let whole = |under: (Bytes) -> Bool|
    named_under(own, under) && listed.any(under)
      && listed.fold(true, |b: Bool, n: Bytes| b && (!under(n) || own.contains(n)));
  if whole(is_std) { StdTree } else if whole(is_compiler) { CompilerTree } else { NoTree }
}

pub fn tree_named(own: List<Bytes>) -> ToolchainTree =
  if named_under(own, is_std) { StdTree }
  else if named_under(own, is_compiler) { CompilerTree }
  else { NoTree }

fn named_under(own: List<Bytes>, under: (Bytes) -> Bool) -> Bool =
  own.len() > 0 && own.fold(true, |b: Bool, n: Bytes| b && under(n))

pub fn home_of(modules: List<ParsedModule>, of: SchemaInstance) -> Option<Int> =
  match of.module {
    None -> None,
    Some(name) ->
      range(0, modules.len()).fold(None, |found: Option<Int>, i: Int|
        match found {
          Some(_) -> found,
          None -> match modules.at(i) {
            Some(m) -> if m.name == name { Some(i) } else { None },
            None -> None,
          },
        }),
  }

pub type ShippedModuleSummary = {
  module: Bytes,
  text: Bytes,
  form: Bytes,
  definitions: List<{ name: Bytes, hash: Bytes }>,
}
