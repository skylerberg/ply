// --- Cuts -------------------------------------------------------------------

/// Two runs of cuts, each in source order, as one.
pub fn merge_cuts(a: List<Cut>, b: List<Cut>) -> List<Cut> / {abort.raise} =
  iterate(
    { out: [], i: 0, j: 0 },
    a.len() + b.len() + 1,
    |x: { out: List<Cut>, i: Int, j: Int }|
      match ((a.at(x.i), b.at(x.j))) {
        (None, None) -> Stop(x),
        (Some(c), None) -> Continue({ ..x, out: x.out.push(c), i: x.i + 1 }),
        (None, Some(c)) -> Continue({ ..x, out: x.out.push(c), j: x.j + 1 }),
        (Some(c), Some(d)) -> if c.start <= d.start {
          Continue({ ..x, out: x.out.push(c), i: x.i + 1 })
        } else { Continue({ ..x, out: x.out.push(d), j: x.j + 1 }) },
      },
  ).out

fn def_row(def_info: DefInfo, w: WrittenFunction) -> DefRow / {abort.raise} =
  {
    name: def_info.name,
    module: def_info.module,
    simple_name: def_info.simple_name,
    public: w.public,
    reuse: w.reuse,
    footprint: canonical_atoms(def_info.footprint),
    performed: canonical_atoms(def_info.performed),
    constraints: def_info.constraints,
    row_aliases: def_info.row_aliases,
    params: w.params.map(|param: SpannedName|
      { name: param.name, at: span_at(def_info.at.module, param.span) }),
    spec: def_info.spec.map(|spec: SpecInfo|
      {
        kind: spec_kind_text(spec.kind),
        index: spec.index,
        footprint: canonical_atoms(spec.footprint),
        at: span_at(def_info.at.module, spec.span),
      }),
    at: location_span(def_info.at),
    literals: w.literals,
  }

fn test_row(test_info: TestInfo, name_at: Location) -> TestRow / {abort.raise} =
  {
    key: test_info.key,
    name: test_info.name,
    module: test_info.module,
    index: test_info.index,
    nondet: test_info.nondet,
    footprint: canonical_atoms(test_info.footprint),
    at: location_span(test_info.at),
    name_at: location_span(name_at),
  }

fn law_row(law_info: LawInfo, lits: List<Bytes>) -> LawRow / {abort.raise} =
  {
    key: law_info.key,
    name: law_info.name,
    module: law_info.module,
    index: law_info.index,
    binders: law_info.binders.map(|b: LawBinder|
      { name: b.name, at: span_at(law_info.at.module, b.span), ty: canonical_type(b.ty) }),
    has_guard: law_info.has_guard,
    footprint: canonical_atoms(law_info.footprint),
    at: location_span(law_info.at),
    literals: lits,
  }

fn op_row(module: Int, op_info: OpInfo, width_sums: WidthSums) -> OpRow / {abort.raise} =
  {
    name: op_info.name,
    mode: mode_text(op_info.mode),
    resource_param: op_info.resource_param,
    kept: op_info.kept,
    params: op_info.params.map(canonical_type),
    ret: canonical_type(op_info.ret),
    scheme: match op_info.scheme { Some(sc) -> Some(canonical_scheme(sc)), None -> None },
    at: span_at(module, op_info.at.span),
    carries: widths_of_all(width_sums, [], op_info.params).map(grounded),
  }

fn effect_row(
  effect_info: EffectInfo,
  public: Bool,
  hosts: Map<Bytes, Bytes>,
  read: AllBodyFacts,
  width_sums: WidthSums,
) -> EffectRow / {abort.raise} = {
  let host = hosts.get(effect_info.name);
  {
    name: effect_info.name,
    module: effect_info.module,
    simple_name: effect_info.simple_name,
    public: public,
    nondet: effect_info.nondet,
    operations: effect_info.operations.map(|op_info: OpInfo|
      op_row(effect_info.at.module, op_info, width_sums)),
    at: location_span(effect_info.at),
    host: host,
    waits: match host { Some(handler) -> waited(read, handler, effect_info.name), None -> [] },
  }
}

/// The operations of `served` its real handler `handler` answers by a ticket's wait: each whose
/// clause, as the check inferred it, performs what `std.internal.native.job_wait` alone performs.
fn waited(read: AllBodyFacts, handler: Bytes, served: Bytes) -> List<Bytes> / {abort.raise} =
  match decode_facts(encoded_facts(read, handler), 0, handler) {
    None -> [],
    Some(f) ->
      f.bodies.flat_map(|b: TypedBody<Bytes>| typed_expr_nodes(b.body)).fold(
        [],
        |acc: List<Bytes>, e: TypedExpr<Bytes>|
          match e.node {
            TypedHandle(h) ->
              h.clauses.fold(acc, |ops: List<Bytes>, c: TypedClause<Bytes>|
                if c.effect == served
                    && c.row.atoms.any(|a: Atom| a.effect == b"std.internal.native.wait") {
                  ops.push(c.op)
                } else { ops }),
            _ -> acc,
          },
      ),
  }

fn ctor_row(ctor_info: CtorInfo) -> CtorRow / {abort.raise} =
  {
    name: ctor_info.name,
    module: ctor_info.module,
    simple_name: ctor_info.simple_name,
    type_name: ctor_info.type_name,
    index: ctor_info.index,
    arity: ctor_info.arity,
    fields: ctor_info.fields.map(canonical_type),
    scheme: canonical_scheme(ctor_info.scheme),
    at: location_span(ctor_info.at),
  }

// --- The hashes ---------------------------------------------------------------

// A name declared twice (a `fn` and an `effect` alike) is one row, as the maps merged it.

fn by_name_many(xs: List<{ name: Bytes, hashes: List<Bytes> }>) -> Map<Bytes, List<Bytes>> =
  xs.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, hashes: List<Bytes> }|
    acc.insert(x.name, x.hashes))

pub fn by_name_names(xs: List<{ name: Bytes, names: List<Bytes> }>) -> Map<Bytes, List<Bytes>> =
  xs.fold(Map::new(), |acc: Map<Bytes, List<Bytes>>, x: { name: Bytes, names: List<Bytes> }|
    acc.insert(x.name, x.names))

type HashTables = {
  defs: Map<Bytes, Bytes>,
  own: Map<Bytes, Bytes>,
  decls: Map<Bytes, Bytes>,
  specs: Map<Bytes, List<Bytes>>,
  spec_texts: Map<Bytes, List<Bytes>>,
  deps: Map<Bytes, List<Bytes>>,
}

fn hash_tables(hashes: HashOutput) -> HashTables =
  {
    defs: by_name(hashes.defs),
    own: by_name(hashes.own),
    decls: by_name(hashes.decls),
    specs: by_name_many(hashes.specs),
    spec_texts: by_name_many(hashes.spec_texts),
    deps: by_name_names(hashes.deps),
  }

fn hex_one(m: Map<Bytes, Bytes>, name: Bytes) -> Option<Bytes> / {abort.raise} =
  match m.get(name) { Some(h) -> Some(hex(h)), None -> None }

fn hex_many(m: Map<Bytes, List<Bytes>>, name: Bytes) -> List<Bytes> / {abort.raise} =
  match m.get(name) { Some(hs) -> hs.map(hex), None -> [] }

fn names_of(m: Map<Bytes, List<Bytes>>, name: Bytes) -> List<Bytes> =
  match m.get(name) { Some(ns) -> ns, None -> [] }

fn def_hash_row(tables: HashTables, name: Bytes) -> HashRow / {abort.raise} =
  {
    name: name,
    def: hex_one(tables.defs, name),
    own: hex_one(tables.own, name),
    decl: hex_one(tables.decls, name),
    specs: hex_many(tables.specs, name),
    spec_texts: hex_many(tables.spec_texts, name),
    deps: names_of(tables.deps, name),
  }

fn hash_rows(outlines: List<Outline>, hashes: HashOutput) -> List<HashTableRow> / {abort.raise} = {
  let t = hash_tables(hashes);
  let def = |acc: { seen: Map<Bytes, Bool>, frames: List<HashTableRow> }, name: Bytes|
    match acc.seen.get(name) {
      Some(_) -> acc,
      None ->
        {
          ..acc,
          seen: acc.seen.insert(name, true),
          frames: acc.frames.push(DefinitionHashRow(def_hash_row(t, name))),
        },
    };
  outlines.fold(
    { seen: Map::new(), frames: [] },
    |acc: { seen: Map<Bytes, Bool>, frames: List<HashTableRow> }, o: Outline|
      o.items.fold(
        acc,
        |a: { seen: Map<Bytes, Bool>, frames: List<HashTableRow> }, item: OutlineItem|
          match item {
            OutlinedFunction(f) -> def(a, qualify(o.name, f.name)),
            OutlinedType(x) -> def(a, qualify(o.name, x.name)),
            OutlinedEffect(x) -> def(a, qualify(o.name, x.name)),
            OutlinedTest(x) -> {
              let key = qualify(o.name, x.name);
              {
                ..a,
                frames: a.frames.push(
                  TestHashRow({
                    key: key,
                    hash: hex(of_key(hashes.tests, key)),
                    text: b"",
                    deps: names_of(t.deps, key),
                  }),
                ),
              }
            },
            OutlinedLaw(x) -> {
              let key = qualify(o.name, x.name);
              {
                ..a,
                frames: a.frames.push(
                  LawHashRow({
                    key: key,
                    hash: hex(of_key(hashes.laws, key)),
                    text: hex(of_key(hashes.law_texts, key)),
                    deps: names_of(t.deps, key),
                  }),
                ),
              }
            },
          },
      ),
  ).frames
}

// A `fn` also names its clauses' kinds in order, so each clause's root can be keyed.

// --- The emitter's root keys -------------------------------------------------

/// What emitting a definition or a call of it reads of it: its parameter and answer types printed
/// with one printer, the atoms of its row, sorted, which a call hands words for and an entry is typed
/// by, and whether it is pure, so a nullary call can come from the constant table.
fn emitted_signature_text(def_info: DefInfo) -> Bytes / {abort.raise} = {
  let (params, ret, atoms) = match def_info.scheme.ty {
    FunctionType(f) -> (f.params, f.ret, f.effects.atoms),
    other -> ([], other, []),
  };
  let printed = params.fold(
    { p: printer_new(), texts: [] },
    |acc: { p: Printer, texts: List<Bytes> }, ty: Type| {
      let out = print_ty(acc.p, ty);
      { p: out.printer, texts: acc.texts.push(out.text) }
    },
  );
  let pure = if is_pure_definition(def_info) { b"true" } else { b"false" };
  Bytes::concat_all([
    b"(",
    Bytes::join(printed.texts, b", "),
    b") -> ",
    print_ty(printed.p, ret).text,
    b" / ",
    atoms_text(canonical_atoms(atoms), b", "),
    b" ",
    pure,
  ])
}

/// The `k`th clause of its kind, `requires` or `ensures`, that definition `def` states.
fn clause_key(def: Bytes, kind: SpecKind, k: Int) -> RootKey =
  Clause({ def: Named(def), kind: if kind == RequiresClause { Requires } else { Ensures }, n: k })

/// The root the emitter answers the program's test `i` by.
pub fn test_root_at(dump: Dump, i: Int) -> Option<RootKey> / {abort.raise} =
  match dump.tests.at(i) { Some(t) -> Some(test_key(t.module, t.name)), None -> None }

/// A digest of what emitting the root hashed under `key` reads of the rest of the program: the
/// signature of `owner` (the root, or a clause's definition), the signature of every definition it
/// references, and every `type` or `effect` declaration it mentions, sorted by name.
fn root_inputs_digest(
  published: Map<Bytes, Bytes>,
  deps: Map<Bytes, List<Bytes>>,
  decls: Map<Bytes, Bytes>,
  key: Bytes,
  owner: Option<Bytes>,
) -> Bytes / {abort.raise} = {
  let owner_text = match owner {
    Some(o) -> match published.get(o) { Some(text) -> text, None -> b"" },
    None -> b"",
  };
  let names = match deps.get(key) {
    Some(ns) -> Map::of_entries(ns.map(|n: Bytes| { key: n, value: () })).keys(),
    None -> [],
  };
  let each = names.map(|name: Bytes| {
    let text = match published.get(name) { Some(t) -> t, None -> b"" };
    let decl = match decls.get(name) { Some(h) -> h, None -> b"" };
    Bytes::concat_all([name, b"\x00", text, decl, b"\x00"])
  });
  hex(blake3(Bytes::concat_all([owner_text, b"\x00"].concat(each)))).slice(0, 32)
}

/// One `fn`'s clause keys, then its own.
fn function_key_rows(
  published: Map<Bytes, Bytes>,
  own: Map<Bytes, Bytes>,
  sentences: Map<Bytes, List<Bytes>>,
  deps: Map<Bytes, List<Bytes>>,
  decls: Map<Bytes, Bytes>,
  a: List<KeyRow>,
  name: Bytes,
  spec: List<SpecKind>,
) -> List<KeyRow> / {abort.raise} =
  match own.get(name) {
    None -> a,
    Some(owner) -> {
      let read = root_inputs_digest(published, deps, decls, name, Some(name));
      let sents = match sentences.get(name) { Some(s) -> s, None -> [] };
      let clauses = range(0, spec.len()).fold(
        { out: a, requires: 0, ensures: 0 },
        |b: { out: List<KeyRow>, requires: Int, ensures: Int }, i: Int| {
          let kind = spec.get(i);
          // A bound is keyed as the law it becomes.
          if kind == CostClause || kind == SpaceClause { b } else {
            let text = spec_kind_text(kind);
            let k = if kind == RequiresClause { b.requires } else { b.ensures };
            let sentence = match sents.at(i) { Some(s) -> s, None -> owner };
            {
              out: b.out.push({
                root: root_text(root_name(clause_key(name, kind, k))),
                key: Bytes::concat_all([
                  hex(sentence),
                  b"#",
                  text,
                  b"#",
                  ascii_of_int(k),
                  b"+",
                  read,
                ]),
              }),
              requires: if kind == RequiresClause { b.requires + 1 } else { b.requires },
              ensures: if kind == EnsuresClause { b.ensures + 1 } else { b.ensures },
            }
          }
        },
      );
      clauses.out.push({ root: name, key: Bytes::concat_all([hex(owner), b"+", read]) })
    },
  }

pub fn root_keys(
  outlines: List<Outline>,
  checked: CheckOutput,
  hashes: HashOutput,
  within: Option<TestRunScope> = None,
) -> List<KeyRow> / {abort.raise} = {
  let own = by_name(hashes.own);
  let sentences = by_name_many(hashes.spec_texts);
  let deps = by_name_names(hashes.deps);
  let decls = by_name(hashes.decls);
  let owned = |name: Bytes| match within { Some(w) -> w.owners.contains(name), None -> true };
  let tested = |key: Bytes| match within { Some(w) -> w.tests.contains(key), None -> true };
  // A kept root's key reads each definition it references, owned or not.
  let read = match within {
    None -> None,
    Some(w) ->
      Some(
        w.owners.keys().concat(w.tests.keys()).fold(
          Map::new(),
          |acc: Map<Bytes, Bool>, name: Bytes|
            List::fold(
              match deps.get(name) { Some(ns) -> ns, None -> [] },
              acc.insert(name, true),
              |m: Map<Bytes, Bool>, n: Bytes| m.insert(n, true),
            ),
        ),
      ),
  };
  // Each signature printed once: a root reads many definitions, and many roots read one.
  let published = Map::of_entries(
    checked.defs.filter(|d: DefInfo|
      match read { Some(r) -> r.contains(d.name), None -> true }).map(|d: DefInfo|
      { key: d.name, value: emitted_signature_text(d) }),
  );
  let guarded = checked.laws.fold(Map::new(), |acc: Map<Bytes, Bool>, l: LawInfo|
    acc.insert(l.key, l.has_guard));
  outlines.fold([], |acc: List<KeyRow>, o: Outline|
    o.items.fold(acc, |a: List<KeyRow>, item: OutlineItem|
      match item {
        OutlinedFunction(f) -> if !owned(qualify(o.name, f.name)) { a } else {
          function_key_rows(
            published,
            own,
            sentences,
            deps,
            decls,
            a,
            qualify(o.name, f.name),
            f.spec,
          )
        },
        OutlinedTest(t) -> {
          let name = qualify(o.name, t.name);
          if !tested(name) { a } else {
            let read = root_inputs_digest(published, deps, decls, name, None);
            let root = test_key(o.name, t.name);
            let run = a.push({ root: root_text(root_name(root)), key: b"test+".concat(read) });
            if !t.cases { run } else {
              run.push({ root: root_text(root_name(TestCases(root))), key: b"cases+".concat(read) })
            }
          }
        },
        OutlinedLaw(l) -> match within {
          // A run's tests enter no law.
          Some(_) -> a,
          None -> {
            let name = qualify(o.name, l.name);
            match hashes.law_texts.get(name) {
              None -> a,
              Some(text) -> {
                let read = root_inputs_digest(published, deps, decls, name, None);
                List::fold(
                  if guarded.get(name) == Some(true) { [LawGuard, LawBody] } else { [LawBody] },
                  a,
                  |b: List<KeyRow>, part: LawPart|
                    b.push({
                      root: root_text(root_name(law_key(o.name, l.name, part))),
                      key: Bytes::concat_all([hex(text), b"#", part_name(part), b"+", read]),
                    }),
                )
              },
            }
          },
        },
        _ -> a,
      }))
}

// --- The emitter's roots -----------------------------------------------------

/// The span of a root the tables do not place: a test or law whose check output has no row.
pub fn no_module_span() -> ModuleSpan = { module: no_module(), start: 0, end: 0 }

type EmitTables = { fns: List<EmitterRoot>, tests: List<EmitterRoot>, specs: List<EmitterRoot> }

/// The prelude's constructors, then each module's in program order: the order the emitted C
/// names tags by, which is not `CheckOutput::ctors`' dependency order.
fn emitter_ctors_of(
  outlines: List<Outline>,
  checked: CheckOutput,
  width_sums: WidthSums,
) -> List<EmitterCtor> / {abort.raise} = {
  let prelude = checked.ctors.filter(|ctor_info: CtorInfo| ctor_info.module.len() == 0);
  let rest = outlines.fold([], |acc: List<CtorInfo>, o: Outline|
    acc.concat(checked.ctors.filter(|ctor_info: CtorInfo| ctor_info.module == o.name)));
  prelude.concat(rest).map(|ctor_info: CtorInfo|
    {
      name: ctor_info.name,
      arity: ctor_info.arity,
      fields: widths_of_all(width_sums, ctor_info.scheme.ty_vars, ctor_info.fields),
      key: instance_by(checked, ctor_info.type_name, KeyInstance),
      show: instance_by(checked, ctor_info.type_name, ShowInstance),
      numeric: checked.numeric_types.fold([], |acc: List<Bytes>, x: NumericInfo|
        if x.type_name == ctor_info.type_name { x.fns } else { acc }),
      release: instance_by(checked, ctor_info.type_name, ReleaseInstance),
    })
}

/// The function a type states of `kind`, where it states one: what its values are compared (`key`)
/// or shown through, or let go by (`release`).
fn instance_by(checked: CheckOutput, type_name: Bytes, kind: InstanceKind) -> Option<Bytes> =
  checked.instances.fold(None, |acc: Option<Bytes>, x: InstanceInfo|
    if x.type_name == type_name && x.kind == kind { Some(x.by) } else { acc })

/// The constructors `checked` read, as a dump rows them, the names of those whose type states a
/// `key`, and of those whose type states its arithmetic, and the function each type that states a
/// `release` names, by the type's name.
pub fn ctors_read(
  checked: CheckOutput,
) -> { rows: List<CtorRow>, keyed: List<Bytes>, numeric: List<Bytes>, released: Map<Bytes, Bytes> } / {abort.raise} =
  {
    rows: checked.ctors.map(ctor_row),
    keyed: checked.ctors.filter(|c: CtorInfo|
      instance_by(checked, c.type_name, KeyInstance) != None).map(|c: CtorInfo| c.name),
    released: checked.instances.fold(Map::new(), |m: Map<Bytes, Bytes>, x: InstanceInfo|
      if x.kind == ReleaseInstance { m.insert(x.type_name, x.by) } else { m }),
    numeric: checked.ctors.filter(|c: CtorInfo|
      checked.numeric_types.any(|x: NumericInfo| x.type_name == c.type_name)).map(|c: CtorInfo|
      c.name),
  }

// --- How a value reads at the compiled seam ------------------------------------

/// A fixed width by the runtime's numbering, `ply_core::INT_TYPES`.
fn width_number(name: Bytes) -> Option<Int> =
  fixed_widths().find_index(|w: { name: Bytes, bits: Int, signed: Bool }| w.name == name)

/// Each sum type, and whether it holds a width whatever its parameters are.
type WidthSums = { sums: Map<Bytes, Bool> }

fn width_sums_of(ctors: List<CtorInfo>) -> WidthSums = {
  let held = holding_widths(ctors, []);
  {
    sums: Map::of_entries(
      ctors.map(|ctor_info: CtorInfo|
        { key: ctor_info.type_name, value: held.contains(ctor_info.type_name) }),
    ),
  }
}

/// Grown to a fixpoint: a type may hold a width through itself or through another type. A round that
/// grows adds a type, so there are no more rounds than types.
fn holding_widths(ctors: List<CtorInfo>, held: List<Bytes>) -> List<Bytes> =
  range(0, ctors.len() + 1).fold(
    { held: held, done: false },
    |st: { held: List<Bytes>, done: Bool }, i: Int|
      if st.done { st } else {
        let grown = ctors.fold(st.held, |a: List<Bytes>, ctor_info: CtorInfo|
          if a.contains(ctor_info.type_name) { a }
          else if ctor_info.fields.fold(false, |b: Bool, ty: Type| b || reaches_width(ty, a)) {
            a.push(ctor_info.type_name)
          } else { a });
        { held: grown, done: grown.len() == st.held.len() }
      },
  ).held

/// A function is a closure's word, which no reading looks inside.
fn reaches_width(t: Type, held: List<Bytes>) -> Bool =
  match t {
    VariableType(_) -> false,
    NamedType(c) ->
      width_number(c.name) != None || held.contains(c.name)
        || c.args.fold(false, |b: Bool, a: Type| b || reaches_width(a, held)),
    FunctionType(_) -> false,
    RecordType(fs) -> fs.fold(false, |b: Bool, field: Field| b || reaches_width(field.ty, held)),
    NominalType(n) ->
      n.fields.fold(false, |b: Bool, field: Field| b || reaches_width(field.ty, held)),
  }

fn has_no_widths(widths_of: Widths) -> Bool = match widths_of { NoWidths -> true, _ -> false }

/// `ty`'s carry, each type variable numbered by its place in `vars`, and one not there past them.
fn widths_of(width_sums: WidthSums, vars: List<Int>, ty: Type) -> Widths / {abort.raise} =
  match ty {
    VariableType(v) -> VariableWidths(var_number(vars, v)),
    NamedType(c) -> match width_number(c.name) {
      Some(n) -> FixedWidth(n),
      None -> {
        let args = widths_of_all(width_sums, vars, c.args);
        let plain = args.fold(true, |b: Bool, a: Widths| b && has_no_widths(a));
        if list_item(ty) != None || array_element(ty) != None || columns_row(ty) != None {
          if plain { NoWidths } else { ListWidths(args.get(0)) }
        } else if map_parts(ty) != None {
          if plain { NoWidths } else { MapWidths(args.get(0), args.get(1)) }
        } else {
          match width_sums.sums.get(c.name) {
            Some(holds) -> if holds || !plain { SumWidths(args) } else { NoWidths },
            None -> NoWidths,
          }
        }
      },
    },
    FunctionType(f) -> {
      let params = widths_of_all(width_sums, vars, f.params);
      let ret = widths_of(width_sums, vars, f.ret);
      if has_no_widths(ret) && params.fold(true, |b: Bool, p: Widths| b && has_no_widths(p)) {
        NoWidths
      } else { FunctionWidths(params, ret) }
    },
    RecordType(fs) -> record_widths(width_sums, vars, fs),
    // What is read is the record a `new` record is at run time.
    NominalType(n) -> record_widths(width_sums, vars, n.fields),
  }

fn record_widths(
  width_sums: WidthSums,
  vars: List<Int>,
  fs: List<Field>,
) -> Widths / {abort.raise} = {
  let fields = fs.map(|f: Field| { name: f.name, carry: widths_of(width_sums, vars, f.ty) });
  if fields.fold(true, |b: Bool, f: FieldWidths| b && has_no_widths(f.carry)) { NoWidths }
  else { RecordWidths(fields) }
}

fn widths_of_all(
  width_sums: WidthSums,
  vars: List<Int>,
  tys: List<Type>,
) -> List<Widths> / {abort.raise} = tys.map(|ty: Type| widths_of(width_sums, vars, ty))

/// An operation's type variable is fixed where it is performed, which its host never sees: a value
/// there reads as it is, and the host takes it by its own contract.
fn grounded(c: Widths) -> Widths =
  match c {
    VariableWidths(_) -> NoWidths,
    ListWidths(x) -> {
      let g = grounded(x);
      if has_no_widths(g) { NoWidths } else { ListWidths(g) }
    },
    MapWidths(k, v) -> {
      let gk = grounded(k);
      let gv = grounded(v);
      if has_no_widths(gk) && has_no_widths(gv) { NoWidths } else { MapWidths(gk, gv) }
    },
    RecordWidths(fs) -> {
      let gs = fs.map(|f: FieldWidths| { name: f.name, carry: grounded(f.carry) });
      if gs.fold(true, |b: Bool, f: FieldWidths| b && has_no_widths(f.carry)) { NoWidths }
      else { RecordWidths(gs) }
    },
    SumWidths(ps) -> SumWidths(ps.map(grounded)),
    FunctionWidths(ps, r) -> {
      let gs = ps.map(grounded);
      let gr = grounded(r);
      if has_no_widths(gr) && gs.fold(true, |b: Bool, p: Widths| b && has_no_widths(p)) { NoWidths }
      else { FunctionWidths(gs, gr) }
    },
    other -> other,
  }

fn var_number(vars: List<Int>, v: Int) -> Int / {abort.raise} =
  range(0, vars.len()).fold(vars.len() + v, |acc: Int, i: Int|
    if acc >= vars.len() && vars.get(i) == v { i } else { acc })

fn emit_signature(ty: Type) -> { params: List<Type>, ret: Type } =
  match ty {
    FunctionType(f) -> { params: f.params, ret: f.ret },
    other -> { params: [], ret: other },
  }

/// Every root is built here, so what the seam reads of it comes from the types it carries, and its
/// row is named as its key prints. `vars` numbers the type variables those types share.
fn emitter_root(
  width_sums: WidthSums,
  vars: List<Int>,
  witnesses: List<Int>,
  root: RootKey,
  params: List<Type>,
  answer: Type,
  labels: Int,
  pure: Bool,
  place: ModuleSpan,
) -> EmitterRoot / {abort.raise} = {
  let taken = witnesses.map(|w: Int| int_type()).concat(params);
  {
    root: root_text(root_name(root)),
    arity: taken.len() + labels,
    pure: pure,
    at: place,
    params: widths_of_all(width_sums, vars, taken),
    result: widths_of(width_sums, vars, answer),
    witnesses: witnesses,
  }
}

fn proposition_root(
  width_sums: WidthSums,
  vars: List<Int>,
  witnesses: List<Int>,
  root: RootKey,
  params: List<Type>,
  place: ModuleSpan,
) -> EmitterRoot / {abort.raise} =
  emitter_root(width_sums, vars, witnesses, root, params, bool_type(), 0, false, place)

/// The type variables a definition's `numeric` and `integer` constraints are about, by its scheme's
/// numbering and in its order: the witnesses it takes ahead of its parameters, as its clauses do.
fn witness_vars(def: DefInfo) -> List<Int> = witness_params(def.constraints)

/// Every root the emitter offers: the functions in source order, then the tests, then the spec
/// clauses, law parts and the roots that list a test's cases. A label parameter is a trailing
/// `Word` of the emitted body, so an arity counts it.
fn emitter_roots(
  outlines: List<Outline>,
  checked: CheckOutput,
  width_sums: WidthSums,
  within: Option<TestRunScope> = None,
) -> List<EmitterRoot> / {abort.raise} = {
  let owned = |name: Bytes| match within { Some(w) -> w.owners.contains(name), None -> true };
  let defs = Map::of_entries(checked.defs.map(|d: DefInfo| { key: d.name, value: d }));
  let laws = Map::of_entries(checked.laws.map(|l: LawInfo| { key: l.key, value: l }));
  let tests = Map::of_entries(checked.tests.map(|t: TestInfo| { key: t.key, value: t }));
  let walked = outlines.fold({ fns: [], tests: [], specs: [] }, |acc: EmitTables, o: Outline| {
    let items = o.items.fold(
      { fns: [], tests: [], specs: [] },
      |a: EmitTables, item: OutlineItem|
        match item {
          OutlinedFunction(f) -> {
            let name = qualify(o.name, f.name);
            match if owned(name) { defs.get(name) } else { None } {
              None -> a,
              Some(def) -> {
                let sig = emit_signature(def.scheme.ty);
                let vars = def.scheme.ty_vars;
                let witnesses = witness_vars(def);
                let place = span_at(def.at.module, def.at.span);
                let fn_row = emitter_root(
                  width_sums,
                  vars,
                  witnesses,
                  Named(name),
                  sig.params,
                  sig.ret,
                  def.scheme.label_vars.len(),
                  is_pure_definition(def),
                  place,
                );
                let clauses = f.spec.fold(
                  { rows: [], requires: 0, ensures: 0 },
                  |b: { rows: List<EmitterRoot>, requires: Int, ensures: Int }, kind: SpecKind| {
                    match kind {
                      RequiresClause -> {
                        let root = clause_key(name, kind, b.requires);
                        let row = proposition_root(
                          width_sums,
                          vars,
                          witnesses,
                          root,
                          sig.params,
                          place,
                        );
                        { rows: b.rows.push(row), requires: b.requires + 1, ensures: b.ensures }
                      },
                      // `ensures` also takes `result`.
                      EnsuresClause -> {
                        let root = clause_key(name, kind, b.ensures);
                        let row = proposition_root(
                          width_sums,
                          vars,
                          witnesses,
                          root,
                          sig.params.push(sig.ret),
                          place,
                        );
                        { rows: b.rows.push(row), requires: b.requires, ensures: b.ensures + 1 }
                      },
                      CostClause -> b,
                      SpaceClause -> b,
                    }
                  },
                );
                { ..a, fns: a.fns.push(fn_row), specs: a.specs.concat(clauses.rows) }
              },
            }
          },
          OutlinedTest(t) -> {
            let place = match tests.get(qualify(o.name, t.name)) {
              Some(x) -> span_at(x.at.module, x.at.span),
              None -> no_module_span(),
            };
            let root = test_key(o.name, t.name);
            // Over cases it is entered with a case's place and identity; a second root lists them.
            let taken = if !t.cases { [] } else { [int_type(), bytes_type()] };
            let row = emitter_root(width_sums, [], [], root, taken, unit_type(), 0, false, place);
            let listed = if !t.cases { a.specs } else {
              a.specs.push(
                emitter_root(
                  width_sums,
                  [],
                  [],
                  TestCases(root),
                  [],
                  listing_ty(),
                  0,
                  false,
                  place,
                ),
              )
            };
            { ..a, tests: a.tests.push(row), specs: listed }
          },
          OutlinedLaw(l) -> match within {
            Some(_) -> a,
            None -> {
              let name = qualify(o.name, l.name);
              let law = laws.get(name);
              let guarded = match law { Some(x) -> x.has_guard, None -> false };
              let binders = match law { Some(x) -> x.binders.map(|b: LawBinder| b.ty), None -> [] };
              let vars = vars_in(binders);
              let place = match law {
                Some(x) -> span_at(x.at.module, x.at.span),
                None -> no_module_span(),
              };
              let rows = List::map(
                if guarded { [LawGuard, LawBody] } else { [LawBody] },
                |part: LawPart| {
                  proposition_root(
                    width_sums,
                    vars,
                    [],
                    law_key(o.name, l.name, part),
                    binders,
                    place,
                  )
                },
              );
              { ..a, specs: a.specs.concat(rows) }
            },
          },
          _ -> a,
        },
    );
    {
      fns: acc.fns.concat(items.fns),
      tests: acc.tests.concat(items.tests),
      specs: acc.specs.concat(items.specs),
    }
  });
  walked.fns.concat(walked.tests).concat(walked.specs)
}

fn ordinal_row(o: Outline) -> OrdinalRow =
  {
    module: o.name,
    items: o.items.fold([], |acc: List<Bytes>, item: OutlineItem|
      match item {
        OutlinedFunction(f) -> {
          // A bound is proved, never run, so it is no clause root.
          let rooted = f.spec.filter(|kind: SpecKind| kind != CostClause && kind != SpaceClause);
          let kinds = if rooted.len() == 0 { b"" }
          else { b" ".concat(Bytes::join(rooted.map(spec_kind_text), b",")) };
          acc.push(Bytes::concat_all([b"fn ", qualify(o.name, f.name), kinds]))
        },
        OutlinedTest(t) -> acc.push(b"test ".concat(qualify(o.name, t.name))),
        OutlinedLaw(l) -> acc.push(b"law ".concat(qualify(o.name, l.name))),
        _ -> acc,
      }),
  }

/// The definitions by where they are written, whatever order the checker took them in.
fn in_source_order(defs: List<DefInfo>) -> List<DefInfo> =
  defs.sort_by(|a: DefInfo, b: DefInfo|
    if a.at.module != b.at.module { a.at.module < b.at.module }
    else if a.at.span.start != b.at.span.start { a.at.span.start < b.at.span.start }
    else { match compare_values(a.name, b.name) { Greater -> false, _ -> true } })

fn tables(
  warnings: List<Diag>,
  outlines: List<Outline>,
  order: List<Bytes>,
  imports: List<List<Bytes>>,
  checked: CheckOutput,
  hashes: HashOutput,
  packages: List<PackageDeps>,
  pins: List<LockedPackage>,
  module_packages: List<Int>,
  embeds: List<ModuleEmbed>,
  within: Option<TestRunScope> = None,
) -> Dump / {abort.raise} = {
  let fns = written_functions(outlines);
  let effs = effect_visibility(outlines);
  let hosts = effect_hosts(outlines);
  let read = all_body_facts(checked);
  let names = test_label_spans(outlines);
  let lits = law_literals(outlines);
  let width_sums = width_sums_of(checked.ctors);
  {
    diags: warnings.map(normalized_diag),
    order: order,
    packages: packages,
    pins: pins,
    module_packages: module_packages,
    modules: range(0, outlines.len()).map(|i: Int|
      module_row(i, outlines.get(i), match imports.at(i) { Some(xs) -> xs, None -> [] })),
    defs: in_source_order(checked.defs).map(|def_info: DefInfo|
      def_row(def_info, written_function_of(fns, def_info.name))),
    types: type_rows(outlines),
    tests: range(0, checked.tests.len()).map(|i: Int| test_row(checked.tests.get(i), names.get(i))),
    laws: range(0, checked.laws.len()).map(|i: Int| law_row(checked.laws.get(i), lits.get(i))),
    effects: checked.effects.map(|effect_info: EffectInfo|
      effect_row(effect_info, effect_public_of(effs, effect_info), hosts, read, width_sums)),
    ctors: checked.ctors.map(ctor_row),
    hashes: hash_rows(outlines, hashes),
    hashes_digest: digest(hashes),
    keys: root_keys(outlines, checked, hashes, within),
    emitter_roots: emitter_roots(outlines, checked, width_sums, within),
    emitter_ctors: emitter_ctors_of(outlines, checked, width_sums),
    ordinals: outlines.map(ordinal_row),
    bodies: hashes.bodies,
    embeds: embeds,
    rows: rows_from(checked, hashes),
    walked: bin::encode(
      inferred_facts_of(outlines.map(|o: Outline| o.name), checked),
      inferred_facts_bin(),
    ),
    derived: outlines.filter(|o: Outline| o.derived.len() > 0).map(|o: Outline|
      { module: o.name, derivations: o.derived }),
  }
}

pub fn checked_program_of(w: Analysis) -> CheckedProgram / {abort.raise} =
  {
    frame: {
      outlines: outlines_of(w),
      order: w.r.order.map(|i: Int| w.mods.get(i).name),
      imports: imports_resolved(w.mods, w.r),
      hashes: w.hashes,
      warnings: w.warnings,
      manifest: w.manifest,
      packages: w.packages,
      pins: w.pins,
      module_packages: w.module_packages,
      embeds: w.embeds,
      embed_items: w.embed_items,
      tagged: root_tagged(
        w.module_packages,
        w.hashes,
        range(0, w.mods.len()).fold([], |acc: List<TaggedSite>, i: Int|
          acc.concat(tagged_of(w, i))),
      ),
      statements: root_statements(
        w.module_packages,
        w.hashes,
        range(0, w.mods.len()).fold([], |acc: List<StatementSite>, i: Int|
          acc.concat(statements_of(w, i))),
      ),
      consts: root_consts(
        w.module_packages,
        range(0, w.mods.len()).fold([], |acc: List<TypedConst>, i: Int|
          acc.concat(typed_consts_of(w, i))),
      ),
    },
    checked: w.checked,
  }

/// `v`'s tables, scoped to `within` where it is given: what a run of tests enters of it.
pub fn view_dump(v: CheckedProgram, within: Option<TestRunScope>) -> Dump / {abort.raise} = {
  let f = v.frame;
  tables(
    f.warnings,
    f.outlines,
    f.order,
    f.imports,
    v.checked,
    f.hashes,
    f.packages,
    f.pins,
    f.module_packages,
    f.embeds,
    within,
  )
}

/// A stage that reports stops the rest, so a refusal is the diagnostics of exactly one stage.
pub type AnalysisOutcome = | Refused(List<Diag>) | Analysed(Analysis)

/// A `const` definition of a checked program: where it is written, and the hash of all it reaches.
pub type ConstSite = { module: Int, span: Span, name: Bytes, hash: Bytes }

/// Every `const` definition of `frame`'s root package declared as the type named `type_name`
/// program-wide. One in a shipped module that the program does not reach has no hash, and is none
/// of the program's.
pub fn consts_of_type(frame: Frame, type_name: Bytes) -> List<ConstSite> / {abort.raise} = {
  let named = frame.consts.fold(Map::new(), |acc: Map<Bytes, Bool>, c: TypedConst|
    if c.type_name == type_name { acc.insert(c.name, true) } else { acc });
  let hashed = by_name(frame.hashes.defs);
  range(0, frame.outlines.len()).fold([], |acc: List<ConstSite>, i: Int| {
    let o = frame.outlines.get(i);
    o.items.fold(acc, |sites: List<ConstSite>, item: OutlineItem|
      match item {
        OutlinedFunction(f) -> {
          let name = qualify(o.name, f.name);
          match if f.constant && named.contains(name) { hashed.get(name) } else { None } {
            Some(h) -> sites.push({ module: i, span: f.name_span, name: name, hash: h }),
            None -> sites,
          }
        },
        _ -> sites,
      })
  })
}

fn known_defs(rows: List<KnownDefRow>) -> Map<Bytes, CachedDefinition> / {abort.raise} =
  rows.fold(Map::new(), |acc: Map<Bytes, CachedDefinition>, row: KnownDefRow|
    match ((read_atoms(row.footprint), read_atoms(row.performed), read_atoms(row.scaling))) {
      (Some(footprint), Some(performed), Some(scaling)) ->
        acc.insert(row.name, {
          footprint: footprint,
          performed: performed,
          scaling: scaling,
          repeats: row.repeats,
          ending: row.ending,
          summary: row.summary,
          raises: row.raises,
          facts: row.facts,
        }),
      _ -> acc,
    })

/// Each handed row's test by its key, where its footprint reads back.
fn known_tests(rows: List<KnownTestRow>) -> Map<Bytes, CachedTest> / {abort.raise} =
  rows.fold(Map::new(), |acc: Map<Bytes, CachedTest>, r: KnownTestRow|
    match read_atoms(r.footprint) {
      None -> acc,
      Some(atoms) -> acc.insert(r.key, { footprint: atoms, facts: r.facts }),
    })

/// The rows a load is handed, each taken as it is: a row a load is handed is what its definition's
/// check answered against what that check reads now, which the memo store holds it to.
pub fn known_from_rows(rows: Rows, root: Int) -> CheckCache / {abort.raise} =
  {
    ..empty_cache(),
    defs: known_defs(rows.defs),
    tests: known_tests(rows.tests),
    root: root,
    types: rows.types,
  }

// --- The rows an analysis publishes -----------------------------------------------

// What each definition and test of an analysis published, which a module's answer carries and the
// assembly of a program takes in place of walking the body again.

/// Each effect a row names, under the hash its declaration has. A prelude effect is declared by no
/// source, so it has no entry and no edit can rename it.
fn row_effect_hashes(decls: Map<Bytes, Bytes>, atoms: List<Atom>) -> List<EffectHash> =
  atoms.fold(Map::new(), |acc: Map<Bytes, Bytes>, atom: Atom|
    match decls.get(atom.effect) { Some(h) -> acc.insert(atom.effect, h), None -> acc }).fold(
    [],
    |acc: List<EffectHash>, name: Bytes, hash: Bytes| acc.push({ name: name, hash: hash }),
  )

pub fn def_known_row(
  decls: Map<Bytes, Bytes>,
  def_info: DefInfo,
  hash: Bytes,
  read: AllBodyFacts,
) -> KnownDefRow / {abort.raise} =
  {
    name: def_info.name,
    hash: hash,
    effect_hashes: row_effect_hashes(decls, def_info.footprint.concat(def_info.performed)),
    footprint: positional_atoms_text(def_info.footprint, def_info.scheme.label_vars),
    performed: positional_atoms_text(def_info.performed, def_info.scheme.label_vars),
    scaling: positional_atoms_text(def_info.scaling, def_info.scheme.label_vars),
    repeats: def_info.repeats,
    ending: def_info.ending,
    summary: def_info.summary,
    raises: def_info.raises,
    facts: encoded_facts(read, def_info.name),
    scheme: canonical_scheme(def_info.scheme),
  }

fn test_known_row(
  decls: Map<Bytes, Bytes>,
  test_info: TestInfo,
  hash: Bytes,
  owner: Bytes,
  read: AllBodyFacts,
) -> KnownTestRow / {abort.raise} =
  {
    key: test_info.key,
    hash: hash,
    effect_hashes: row_effect_hashes(decls, test_info.footprint),
    footprint: atoms_text(test_info.footprint, b","),
    owner: owner,
    facts: encoded_facts(read, owner),
  }

/// What the emitter reads of each body: what the rows a body was published from held, and what a
/// walk of the rest recorded.
type AllBodyFacts = { kept: Map<Bytes, Bytes>, walked: Map<Bytes, BodyFacts> }

pub fn all_body_facts(checked: CheckOutput) -> AllBodyFacts / {abort.raise} =
  {
    kept: checked.kept.fold(Map::new(), |acc: Map<Bytes, Bytes>, k: CachedFacts|
      acc.insert(k.name, k.facts)),
    walked: facts_by_owner(checked.facts),
  }

/// One body's facts as its row files them: the bytes its last row held where it was published from
/// that, else what this walk recorded.
fn encoded_facts(read: AllBodyFacts, owner: Bytes) -> Bytes / {abort.raise} =
  match read.kept.get(owner) {
    Some(filed) -> filed,
    None -> encode_facts(match read.walked.get(owner) { Some(f) -> f, None -> no_body_facts() }),
  }

/// The types the bodies of `defs` and `tests` name, read from `table`.
pub fn types_of_rows(
  table: TypeTable,
  defs: List<KnownDefRow>,
  tests: List<KnownTestRow>,
) -> TypeTable / {abort.raise} = {
  let bodies = |acc: List<TypedBody<Bytes>>, filed: Bytes|
    match decode_facts(filed, 0, b"") { Some(f) -> acc.concat(f.bodies), None -> acc };
  types_named(
    table,
    tests.fold(
      defs.fold([], |acc: List<TypedBody<Bytes>>, r: KnownDefRow| bodies(acc, r.facts)),
      |acc: List<TypedBody<Bytes>>, r: KnownTestRow| bodies(acc, r.facts),
    ),
  )
}

/// What the emitter reads of a checked program beyond each body's own row: the definitions
/// published pure, each definition's witness order, and the facts of each law, which is walked
/// afresh every time, by its owner. Module indices are into `modules`.
pub type InferredFacts = {
  modules: List<Bytes>,
  pure: List<Bytes>,
  orders: List<WitnessOrder>,
  law_facts: List<{ owner: Bytes, facts: BodyFacts }>,
}

derive bin for InferredFacts

pub fn inferred_facts_of(
  modules: List<Bytes>,
  checked: CheckOutput,
) -> InferredFacts / {abort.raise} = {
  let laws = checked.laws.fold(Map::new(), |acc: Map<Bytes, Bool>, l: LawInfo|
    acc.insert(law_owner(l.module, l.name), true));
  {
    modules: modules,
    pure: checked.facts.pure,
    orders: checked.facts.orders,
    law_facts: facts_by_owner(checked.facts).fold(
      [],
      |acc: List<{ owner: Bytes, facts: BodyFacts }>, owner: Bytes, f: BodyFacts|
        if laws.contains(owner) {
          acc.push({ owner: owner, facts: { ..f, types: types_named(f.types, f.bodies) } })
        } else { acc },
    ),
  }
}

pub fn rows_from(checked: CheckOutput, hashes: HashOutput) -> Rows / {abort.raise} = {
  let keyed = by_name(hashes.defs);
  let decls = by_name(hashes.decls);
  let read = all_body_facts(checked);
  let defs = checked.defs.fold([], |acc: List<KnownDefRow>, def_info: DefInfo|
    match keyed.get(def_info.name) {
      Some(x) -> acc.push(def_known_row(decls, def_info, x, read)),
      None -> acc,
    });
  let tests = test_rows(checked, hashes, decls, read);
  { defs: defs, tests: tests, types: types_of_rows(checked.facts.types, defs, tests) }
}

fn test_rows(
  checked: CheckOutput,
  hashes: HashOutput,
  decls: Map<Bytes, Bytes>,
  read: AllBodyFacts,
) -> List<KnownTestRow> / {abort.raise} = {
  checked.tests.map(|t: TestInfo|
    test_known_row(decls, t, of_key(hashes.tests, t.key), test_owner(t.module, t.name), read))
}

/// What a run of tests enters of a program: the definitions `owners` names, which every root of a
/// test it runs or lists reaches, and the tests and listings `tests` keys. A dump within one leaves
/// out every other definition's root and key, every other test's key and every law's; each test
/// keeps its root, by which a run finds it.
pub type TestRunScope = { owners: Map<Bytes, Bool>, tests: Map<Bytes, Bool> }
