import compiler.syntax.parsing (Span, ParseDiagnostic, error_at, dummy_span, starts_upper,
                                parse_diagnostic_bin)
import compiler.syntax.items (Module, FunctionItem, FnDefinition, item_span, parse)
import compiler.syntax.expressions (Expression, LiteralExpression, NameExpression, CallExpression,
                                    RecordExpression, ListExpression, RecordLiteralField,
                                    expression_span)
import compiler.syntax.patterns (LiteralInt, LiteralBool, LiteralString, LiteralUnit)
import compiler.syntax.type_syntax (NamedTypeExpression, type_span)
import compiler.store.hash.encoding (hex)
import compiler.store.hash.forms (sort_bytes)
import compiler.check.resolve.tables (Source, source_bin)
import compiler.check.known (some_constructor, none_constructor)
import compiler.expand.embed (ModuleEmbed, EmbedFile)
import std.json (Json, Null, Bool, Number, Str, Member, JsonCodec, object, array, variant,
                 error_to_string)
import std.hash (blake3)
import std.bin
import std.pkg (Manifest, Version, Dependency, Path, Git, Registry, Workspace, Suite, manifest_json,
                workspace_json, prefix_of, manifest_bin)
import std.list
import std.graph
import std.string
import std.bytes

type FileKind = { noun: Bytes, file: Bytes, definition: Bytes, ty: Bytes }

fn manifest_file_kind() -> FileKind =
  { noun: b"manifest", file: b"ply.pkg", definition: b"package", ty: b"Manifest" }

fn workspace_file_kind() -> FileKind =
  { noun: b"workspace", file: b"ply.work", definition: b"workspace", ty: b"Workspace" }

pub type CheckedManifest = { manifest: Option<Manifest>, diagnostics: List<ParseDiagnostic> }

pub fn check_manifest(source: Bytes) -> CheckedManifest / {abort.raise} =
  match literal_of(source, manifest_file_kind()) {
    Err(diagnostics) -> { manifest: None, diagnostics: diagnostics },
    Ok(l) -> match decoded(l, manifest_file_kind(), manifest_json()) {
      Err(diagnostics) -> { manifest: None, diagnostics: diagnostics },
      Ok(m) -> validate(m, l.at),
    },
  }

pub type CheckedWorkspace = { workspace: Option<Workspace>, diagnostics: List<ParseDiagnostic> }

pub fn check_workspace(source: Bytes) -> CheckedWorkspace / {abort.raise} =
  match literal_of(source, workspace_file_kind()) {
    Err(diagnostics) -> { workspace: None, diagnostics: diagnostics },
    Ok(l) -> match decoded(l, workspace_file_kind(), workspace_json()) {
      Err(diagnostics) -> { workspace: None, diagnostics: diagnostics },
      Ok(w) -> {
        let diagnostics = workspace_diagnostics(w, field_diagnostic(l.at, workspace_file_kind()));
        { workspace: if diagnostics.len() == 0 { Some(w) } else { None }, diagnostics: diagnostics }
      },
    },
  }

type Literal = { json: Json, at: Span }

fn literal_of(
  source: Bytes,
  s: FileKind,
) -> Result<Literal, List<ParseDiagnostic>> / {abort.raise} = {
  let r = parse(source);
  if r.parser.diagnostics.len() > 0 { Err(r.parser.diagnostics) } else { literal_in(r.node, s) }
}

fn literal_in(
  module: Module,
  s: FileKind,
) -> Result<Literal, List<ParseDiagnostic>> / {abort.raise} =
  match module.items {
    [one] -> match one {
      FunctionItem(d) -> if d.name.name == s.definition { literal_function(d, s) } else {
        Err([
          shape_error(
            d.name.span,
            s,
            message_text([b"a ", s.noun, b"'s one definition is named `", s.definition, b"`"]),
          ),
        ])
      },
      _ ->
        Err([
          shape_error(
            item_span(one),
            s,
            message_text([b"a ", s.noun, b" holds a `fn ", s.definition, b"`, nothing else"]),
          ),
        ]),
    },
    [] ->
      Err([
        shape_error(
          dummy_span(),
          s,
          message_text([
            b"a ",
            s.noun,
            b" defines `",
            s.definition,
            b"`; this file defines nothing",
          ]),
        ),
      ]),
    [_, two, ..rest] ->
      Err([
        shape_error(
          item_span(two),
          s,
          message_text([b"a ", s.noun, b" defines `", s.definition, b"` and nothing else"]),
        ),
      ]),
  }

fn message_text(parts: List<Bytes>) -> Bytes = Bytes::concat_all(parts)

fn shape_error(here: Span, s: FileKind, message: Bytes) -> ParseDiagnostic =
  error_at(b"E0129", here, message, message_text([b"not a valid ", s.noun, b" file"]), [
    message_text([
      b"a `",
      s.file,
      b"` file is exactly `fn ",
      s.definition,
      b"() -> ",
      s.ty,
      b" = ...`, with std.pkg's ",
      s.ty,
    ]),
  ])

fn concat_diagnostics(
  xs: List<ParseDiagnostic>,
  ys: List<ParseDiagnostic>,
) -> List<ParseDiagnostic> =
  ys.fold(xs, |accumulator: List<ParseDiagnostic>, diagnostic: ParseDiagnostic|
    accumulator.push(diagnostic))

fn literal_function(
  definition: FnDefinition,
  s: FileKind,
) -> Result<Literal, List<ParseDiagnostic>> / {abort.raise} = {
  let returns = message_text([b"`", s.definition, b"` returns std.pkg's `", s.ty, b"`"]);
  let not_it = message_text([b"not the ", s.noun, b" type"]);
  let return_diagnostics = match definition.return_type {
    None ->
      [
        labelled_shape_error(
          definition.name.span,
          message_text([
            b"`",
            s.definition,
            b"` declares its return type, std.pkg's `",
            s.ty,
            b"`",
          ]),
          b"no return type written",
        ),
      ],
    Some(t) -> match t {
      NamedTypeExpression(c) -> if c.name.name.name == s.ty { [] }
      else { [labelled_shape_error(type_span(t), returns, not_it)] },
      _ -> [labelled_shape_error(type_span(t), returns, not_it)],
    },
  };
  let param_diagnostics = if definition.params.len() == 0 { [] } else {
    [
      labelled_shape_error(
        definition.name.span,
        message_text([b"`", s.definition, b"` takes no parameters"]),
        message_text([b"a ", s.noun, b" is data; nothing is passed in"]),
      ),
    ]
  };
  let diagnostics = concat_diagnostics(return_diagnostics, param_diagnostics);
  if diagnostics.len() > 0 { Err(diagnostics) } else {
    match literal_json(definition.body) {
      Err(at) ->
        Err([
          error_at(
            b"E0130",
            at,
            message_text([b"a ", s.noun, b" is a value, not something that runs"]),
            message_text([b"a ", s.noun, b" must be a literal value"]),
            [b"a literal, a constructor applied to literals, a record or a list is fine"],
          ),
        ]),
      Ok(j) -> Ok({ json: j, at: expression_span(definition.body) }),
    }
  }
}

fn labelled_shape_error(here: Span, message: Bytes, label: Bytes) -> ParseDiagnostic =
  error_at(b"E0129", here, message, label, [])

fn decoded<a>(
  l: Literal,
  s: FileKind,
  codec: JsonCodec<a>,
) -> Result<a, List<ParseDiagnostic>> / {abort.raise} =
  match (codec.decode)(l.json) {
    Err(e) ->
      Err([
        error_at(
          b"E0131",
          l.at,
          Bytes::of_string(error_to_string(e)),
          message_text([b"the ", s.noun, b" does not decode"]),
          [],
        ),
      ]),
    Ok(v) -> Ok(v),
  }

fn literal_json(expression: Expression) -> Result<Json, Span> / {abort.raise} =
  match expression {
    LiteralExpression(v) -> match v.literal {
      LiteralInt(n) -> Ok(Number(Decimal::of_int(n))),
      LiteralBool(b) -> Ok(Bool(b)),
      LiteralString(s) -> Ok(Str(String::of_bytes(s))),
      LiteralUnit -> Ok(Null),
      _ -> Err(v.span),
    },
    RecordExpression(r) -> fields_json(r.fields, []),
    ListExpression(l) -> match items_json(l.items, []) {
      Err(s) -> Err(s),
      Ok(items) -> Ok(array(items)),
    },
    CallExpression(a) -> match a.function {
      NameExpression(f) -> if a.named.len() == 0 && a.labels.len() == 0
          && starts_upper(f.name.name.name) { constructor_json(a.span, f.name.name.name, a.args) }
      else { Err(a.span) },
      _ -> Err(a.span),
    },
    NameExpression(v) -> if v.name.name.name == none_constructor() { Ok(Null) }
    else if starts_upper(v.name.name.name) { Ok(variant(String::of_bytes(v.name.name.name), [])) }
    else { Err(v.span) },
    _ -> Err(expression_span(expression)),
  }

fn constructor_json(
  here: Span,
  tag: Bytes,
  args: List<Expression>,
) -> Result<Json, Span> / {abort.raise} =
  if tag == some_constructor() { match args { [x] -> literal_json(x), _ -> Err(here) } } else {
    match items_json(args, []) {
      Err(s) -> Err(s),
      Ok(values) -> Ok(variant(String::of_bytes(tag), values)),
    }
  }

fn items_json(
  expressions: List<Expression>,
  accumulator: List<Json>,
) -> Result<List<Json>, Span> / {abort.raise} =
  match expressions {
    [] -> Ok(accumulator),
    [x, ..rest] -> match literal_json(x) {
      Err(s) -> Err(s),
      Ok(j) -> items_json(rest, accumulator.push(j)),
    },
  }

fn fields_json(
  fields: List<RecordLiteralField>,
  accumulator: List<Member>,
) -> Result<Json, Span> / {abort.raise} =
  match fields {
    [] -> Ok(object(accumulator)),
    [f, ..rest] -> match literal_json(f.value) {
      Err(s) -> Err(s),
      Ok(j) ->
        fields_json(rest, accumulator.push({ key: String::of_bytes(f.name.name), value: j })),
    },
  }

fn validate(manifest: Manifest, here: Span) -> CheckedManifest / {abort.raise} = {
  let bad = field_diagnostic(here, manifest_file_kind());
  let name_diagnostics = if Bytes::of_string(manifest.name).len() == 0 {
    [bad(b"a manifest's `name` must not be empty")]
  } else if !is_dotted_path(manifest.name) {
    [bad(b"a manifest's `name` is lower-case identifier segments joined by dots")]
  } else { [] };
  let prefix_diagnostics = match manifest.prefix {
    None -> [],
    Some(p) -> if is_dotted_path(p) { [] }
    else { [bad(b"a manifest's `prefix` is lower-case identifier segments joined by dots")] },
  };
  let version_diagnostics = if version_ok(manifest.version) { [] }
  else { [bad(b"a manifest's `version` numbers must each be zero or greater")] };
  let base = concat_diagnostics(
    name_diagnostics,
    concat_diagnostics(prefix_diagnostics, version_diagnostics),
  );
  {
    manifest: if base.len() == 0 { Some(manifest) } else { None },
    diagnostics: dependencies_ok(manifest.dependencies, [], base, bad),
  }
}

fn field_diagnostic(here: Span, s: FileKind) -> (Bytes) -> ParseDiagnostic =
  |message: Bytes|
    error_at(b"E0131", here, message, message_text([b"not a field a ", s.noun, b" accepts"]), [])

fn directories(w: Workspace) -> List<String> = {
  let own = w.packages.concat(w.suites.map(|s: Suite| s.dir)).concat(w.fixtures);
  match w.toolchain {
    None -> own,
    Some(t) -> [t.std, t.std_tests, t.compiler, t.cli, t.cli_tests].concat(own),
  }
}

fn below(dir: String) -> Bool =
  dir.len() > 0 && dir.split("/").all(|seg: String| seg != "" && seg != "." && seg != "..")

fn cargo_name(name: String) -> Bool / {abort.raise} = {
  let bs = Bytes::of_string(name);
  bs.len() > 0 && bs.at(0) >= 97 && bs.at(0) <= 122
    && range(1, bs.len()).all(|i: Int| {
      let b = bs.at(i);
      (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45 || b == 95
    })
}

fn workspace_diagnostics(
  w: Workspace,
  bad: (Bytes) -> ParseDiagnostic,
) -> List<ParseDiagnostic> / {abort.raise} = {
  let dirs = directories(w);
  let placed = dirs.fold([], |accumulator: List<ParseDiagnostic>, dir: String|
    if below(dir) { accumulator } else {
      accumulator.push(
        bad(
          message_text([
            b"`",
            Bytes::of_string(dir),
            b"` is no directory below the workspace's: names joined by `/`, none of them `.` or `..`",
          ]),
        ),
      )
    });
  let once = range(0, dirs.len()).fold(placed, |accumulator: List<ParseDiagnostic>, i: Int|
    if !dirs.take(i).contains(dirs.get(i)) { accumulator } else {
      accumulator.push(
        bad(message_text([b"the directory `", Bytes::of_string(dirs.get(i)), b"` is named twice"])),
      )
    });
  match w.toolchain {
    None -> once,
    Some(t) -> {
      let entered = if is_dotted_path(t.entry) && t.entry.contains(".") { once } else {
        once.push(
          bad(
            message_text([
              b"the entry `",
              Bytes::of_string(t.entry),
              b"` is not a module name followed by a dot and a definition name",
            ]),
          ),
        )
      };
      if cargo_name(t.runtime) { entered } else {
        entered.push(
          bad(
            message_text([
              b"the runtime `",
              Bytes::of_string(t.runtime),
              b"` is not a valid cargo package name",
            ]),
          ),
        )
      }
    },
  }
}

fn version_ok(v: Version) -> Bool = v.major >= 0 && v.minor >= 0 && v.patch >= 0

fn dependencies_ok(
  dependencies: List<Dependency>,
  seen: List<Bytes>,
  diagnostics: List<ParseDiagnostic>,
  bad: (Bytes) -> ParseDiagnostic,
) -> List<ParseDiagnostic> / {abort.raise} =
  match dependencies {
    [] -> diagnostics,
    [d, ..rest] -> {
      let here = if Bytes::of_string(d.name).len() == 0 {
        diagnostics.push(bad(b"a dependency's `name` must not be empty"))
      } else if seen.contains(Bytes::of_string(d.name)) {
        diagnostics.push(
          bad(
            Bytes::concat_all([
              b"the dependency `",
              Bytes::of_string(d.name),
              b"` is listed twice",
            ]),
          ),
        )
      } else if !version_ok(d.min) {
        diagnostics.push(
          bad(
            Bytes::concat_all([
              b"the dependency `",
              Bytes::of_string(d.name),
              b"` asks for a version below zero",
            ]),
          ),
        )
      } else if is_registry(d) && !is_dotted_path(d.name) {
        diagnostics.push(
          bad(
            Bytes::concat_all([
              b"the registry dependency `",
              Bytes::of_string(d.name),
              b"` is not a package name: lower-case identifier segments joined by dots",
            ]),
          ),
        )
      } else { diagnostics };
      dependencies_ok(rest, seen.push(Bytes::of_string(d.name)), here, bad)
    },
  }

pub fn is_dotted_path(s: String) -> Bool / {abort.raise} = {
  let bs = Bytes::of_string(s);
  bs.len() > 0 && scan_path(bs, 0, true)
}

fn scan_path(bs: Bytes, i: Int, seg_start: Bool) -> Bool / {abort.raise} =
  if i >= bs.len() { !seg_start } else {
    let b = bs.at(i);
    if seg_start { if b >= 97 && b <= 122 { scan_path(bs, i + 1, false) } else { false } }
    else if b == 46 { scan_path(bs, i + 1, true) }
    else if (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95 { scan_path(bs, i + 1, false) }
    else { false }
  }

test "a well-formed manifest checks and decodes" {
  let got = check_manifest(
    b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"tool\", version: {major: 0, minor: 1, patch: 0}, prefix: None, runtime: {major: 0, minor: 1, patch: 0}, dependencies: [{name: \"cli\", prefix: None, min: {major: 1, minor: 2, patch: 3}, source: Path(\"../cli\")}, {name: \"gitlib\", prefix: Some(\"gl\"), min: {major: 0, minor: 0, patch: 1}, source: Git(\"https://example.com/gitlib\", \"deadbee\")}, {name: \"reglib\", prefix: None, min: {major: 2, minor: 0, patch: 0}, source: Registry}], entry: Some(\"app.serve\")}",
  );
  assert_eq(got.diagnostics, []);
  match got.manifest {
    None -> assert(false),
    Some(m) -> {
      assert_eq(m.name, "tool");
      assert_eq(m.entry, Some("app.serve"));
      assert_eq(m.dependencies.len(), 3);
      assert_eq(m.dependencies.get(0).source, Path("../cli"));
      assert_eq(m.dependencies.get(1).prefix, Some("gl"));
      assert_eq(m.dependencies.get(2).source, Registry)
    },
  }
}

test "a manifest is rejected unless it contains exactly one `fn` named `package` that returns a `Manifest`" {
  assert_eq(check_manifest(b"type X = {a: Int}").diagnostics.get(0).code, b"E0129");
  assert_eq(check_manifest(b"fn other() -> Int = 1").diagnostics.get(0).code, b"E0129");
  assert_eq(check_manifest(b"fn package() -> Int = 1").diagnostics.get(0).code, b"E0129");
  assert_eq(
    check_manifest(
      b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"a\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}\nfn extra() -> Int = 1",
    ).diagnostics.get(
      0,
    ).code,
    b"E0129",
  )
}

test "a manifest is rejected when a field needs computing, such as a function call, arithmetic or a `let`, instead of being a plain value" {
  let head = b"import std.pkg (Manifest)\nfn package() -> Manifest = ";
  assert_eq(
    check_manifest(
      head
        ++ b"{name: greet(\"x\"), version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}",
    ).diagnostics.get(
      0,
    ).code,
    b"E0130",
  );
  assert_eq(
    check_manifest(
      head
        ++ b"{name: \"a\", version: {major: 0, minor: 0, patch: 1 + 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}",
    ).diagnostics.get(
      0,
    ).code,
    b"E0130",
  );
  assert_eq(
    check_manifest(
      head
        ++ b"{ let x = 1; {name: \"a\", version: {major: 0, minor: 0, patch: x}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None} }",
    ).diagnostics.get(
      0,
    ).code,
    b"E0130",
  )
}

fn a_manifest(name: String, dependencies: List<String>) -> Bytes =
  Bytes::of_string(
    "import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"" ++ name
      ++ "\", version: {major: 0, minor: 1, patch: 0}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: ["
      ++ String::join(dependencies, ", ")
      ++ "], entry: None}",
  )

fn a_dependency(name: String, floor: Int, path: String) -> String =
  "{name: \"" ++ name ++ "\", prefix: None, min: {major: 0, minor: " ++ floor.to_string()
    ++ ", patch: 0}, source: Path(\""
    ++ path
    ++ "\")}"

fn supplied_at(root: String, name: String, dependencies: List<String>) -> SuppliedPackage =
  { root: Bytes::of_string(root), manifest: Some(a_manifest(name, dependencies)), modules: [] }

fn a_registry_dependency(name: String, floor: Int) -> String =
  "{name: \"" ++ name ++ "\", prefix: None, min: {major: 0, minor: " ++ floor.to_string()
    ++ ", patch: 0}, source: Registry}"

fn codes_of(clo: Closure) -> List<Bytes> =
  clo.diagnostics.map(|d: { slot: Int, diagnostic: ParseDiagnostic }| d.diagnostic.code)

test "a registry dependency is looked for in the `.ply-cache/registry` directory of the root package, whichever package declares it" {
  let app = supplied_at("/x/app", "app", [
    a_registry_dependency("orders", 1),
    a_dependency("lib", 0, "../lib"),
  ]);
  let lib = supplied_at("/x/lib", "lib", [a_registry_dependency("money", 0)]);
  assert_eq(roots_wanted([b"/x/app"], [app]), [b"/x/app/.ply-cache/registry/orders", b"/x/lib"]);
  assert_eq(
    roots_wanted([b"/x/app", b"/x/app/.ply-cache/registry/orders", b"/x/lib"], [app, lib]),
    [b"/x/app/.ply-cache/registry/money"],
  );
  assert_eq(registry_key(b".", b"orders"), b".ply-cache/registry/orders")
}

test "a registry dependency is loaded from the cache when the cached package meets the required minimum version" {
  let packages: PackageSources = {
    root: b"/x/app",
    manifest: Some(a_manifest("app", [a_registry_dependency("orders", 1)])),
    supplied: [supplied_at("/x/app/.ply-cache/registry/orders", "orders", [])],
  };
  let clo = closure(packages, []);
  assert_eq(clo.diagnostics, []);
  assert_eq(clo.packages.map(|package: Package| package.prefix), [b"app", b"orders"]);
  assert_eq(clo.packages.get(0).dependencies, [b"orders"])
}

test "a registry dependency is rejected when it has not been fetched, the cached version is below the minimum, or the cache holds a different package" {
  let unfetched = closure(
    {
      root: b"/x/app",
      manifest: Some(a_manifest("app", [a_registry_dependency("orders", 1)])),
      supplied: [{ root: b"/x/app/.ply-cache/registry/orders", manifest: None, modules: [] }],
    },
    [],
  );
  assert_eq(codes_of(unfetched), [b"E0135"]);
  let message_text = unfetched.diagnostics.get(0).diagnostic;
  assert(String::of_bytes_lossy(message_text.message).contains("`orders` has not been fetched"));
  assert(String::of_bytes_lossy(message_text.notes_text.get(0)).contains("`ply resolve`"));
  let below = closure(
    {
      root: b"/x/app",
      manifest: Some(a_manifest("app", [a_registry_dependency("orders", 2)])),
      supplied: [supplied_at("/x/app/.ply-cache/registry/orders", "orders", [])],
    },
    [],
  );
  assert_eq(codes_of(below), [b"E0136"]);
  assert_eq(below.diagnostics.get(0).diagnostic.notes, 1);
  let other = closure(
    {
      root: b"/x/app",
      manifest: Some(a_manifest("app", [a_registry_dependency("orders", 1)])),
      supplied: [supplied_at("/x/app/.ply-cache/registry/orders", "billing", [])],
    },
    [],
  );
  assert_eq(codes_of(other), [b"E0135"]);
  assert(
    String::of_bytes_lossy(other.diagnostics.get(0).diagnostic.message).contains(
      "holds the package `billing`",
    ),
  )
}

test "a dependency cycle error lists only the packages in the cycle, not the package that leads into it" {
  let packages: PackageSources = {
    root: b"/x/app",
    manifest: Some(a_manifest("app", [a_dependency("mid", 1, "../mid")])),
    supplied: [
      supplied_at("/x/mid", "mid", [a_dependency("lib", 1, "../lib")]),
      supplied_at("/x/lib", "lib", [a_dependency("mid", 1, "../mid")]),
    ],
  };
  let clo = closure(packages, []);
  assert_eq(codes_of(clo), [b"E0134"]);
  assert(
    String::of_bytes_lossy(clo.diagnostics.get(0).diagnostic.message).contains(
      "in a cycle: /x/mid -> /x/lib -> /x/mid",
    ),
  )
}

test "two dependencies that require the same package from the same path load it once and report no error" {
  let packages: PackageSources = {
    root: b"/x/app",
    manifest: Some(a_manifest("app", [a_dependency("b", 1, "../b"), a_dependency("c", 1, "../c")])),
    supplied: [
      supplied_at("/x/b", "b", [a_dependency("d", 0, "../d")]),
      supplied_at("/x/c", "c", [a_dependency("d", 1, "../d")]),
      supplied_at("/x/d", "d", []),
    ],
  };
  let clo = closure(packages, []);
  assert_eq(clo.diagnostics, []);
  assert_eq(clo.packages.map(|package: Package| package.prefix), [b"app", b"b", b"c", b"d"])
}

test "two dependencies that require the same package from different paths are rejected, and the error names both paths" {
  let packages: PackageSources = {
    root: b"/x/app",
    manifest: Some(a_manifest("app", [a_dependency("b", 1, "../b"), a_dependency("c", 1, "../c")])),
    supplied: [
      supplied_at("/x/b", "b", [a_dependency("d", 1, "../d1")]),
      supplied_at("/x/c", "c", [a_dependency("d", 1, "../d2")]),
      supplied_at("/x/d1", "d", []),
      supplied_at("/x/d2", "d", []),
    ],
  };
  let clo = closure(packages, []);
  let codes = clo.diagnostics.map(|d: { slot: Int, diagnostic: ParseDiagnostic }|
    d.diagnostic.code);
  assert_eq(codes, [b"E0137"]);
  let text = String::of_bytes_lossy(clo.diagnostics.get(0).diagnostic.message);
  assert(text.contains("`b` wants `/x/d1`"));
  assert(text.contains("`c` wants `/x/d2`"))
}

test "a dependency older than the minimum version its importer requires is rejected, and the error names both versions" {
  let packages: PackageSources = {
    root: b"/x/app",
    manifest: Some(a_manifest("app", [a_dependency("b", 9, "../b")])),
    supplied: [supplied_at("/x/b", "b", [])],
  };
  let clo = closure(packages, []);
  let codes = clo.diagnostics.map(|d: { slot: Int, diagnostic: ParseDiagnostic }|
    d.diagnostic.code);
  assert_eq(codes, [b"E0136"]);
  let text = String::of_bytes_lossy(clo.diagnostics.get(0).diagnostic.message);
  assert(text.contains("is version 0.1.0"));
  assert(text.contains("at least 0.9.0"))
}

test "fields that fail validation are named" {
  let head = b"import std.pkg (Manifest)\nfn package() -> Manifest = ";
  let tail = b", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}";
  assert_eq(check_manifest(head ++ b"{name: \"\"" ++ tail).diagnostics.get(0).code, b"E0131");
  assert_eq(
    check_manifest(head ++ b"{name: \"Not A Path\"" ++ tail).diagnostics.get(0).code,
    b"E0131",
  );
  assert_eq(check_manifest(head ++ b"{name: 3" ++ tail).diagnostics.get(0).code, b"E0131");
  let dup = b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"a\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [{name: \"d\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Registry}, {name: \"d\", prefix: None, min: {major: 0, minor: 0, patch: 2}, source: Registry}], entry: None}";
  assert_eq(check_manifest(dup).diagnostics.get(0).code, b"E0131");
  let escaping = b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"a\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [{name: \"../up\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Registry}], entry: None}";
  let rejected = check_manifest(escaping).diagnostics.get(0);
  assert_eq(rejected.code, b"E0131");
  assert(String::of_bytes_lossy(rejected.message).contains("is not a package name"))
}

fn a_workspace(toolchain: String) -> Bytes =
  Bytes::of_string(
    "import std.pkg (Workspace)\nfn workspace() -> Workspace = {packages: [\"lib/store\"], suites: [{dir: \"examples\", proved: true}], fixtures: [\"tests/fixtures\"], toolchain: "
      ++ toolchain
      ++ "}",
  )

fn a_toolchain(entry: String, std: String) -> String =
  "Some({std: \"" ++ std
    ++ "\", std_tests: \"tests/std\", compiler: \"lib/compiler\", cli: \"cli\", entry: \""
    ++ entry
    ++ "\", cli_tests: \"tests/cli\", runtime: \"ply-runtime\"})"

fn workspace_codes(source: Bytes) -> List<Bytes> / {abort.raise} =
  check_workspace(source).diagnostics.map(|d: ParseDiagnostic| d.code)

test "a well-formed workspace checks and decodes, with or without a toolchain" {
  let got = check_workspace(a_workspace(a_toolchain("ply.main", "lib/std")));
  assert_eq(got.diagnostics, []);
  match got.workspace {
    None -> panic("the workspace checks"),
    Some(w) -> {
      assert_eq(w.packages, ["lib/store"]);
      assert_eq(w.suites, [{ dir: "examples", proved: true }]);
      match w.toolchain {
        None -> panic("the toolchain is named"),
        Some(t) -> {
          assert_eq(t.std, "lib/std");
          assert_eq(t.entry, "ply.main");
          assert_eq(t.runtime, "ply-runtime")
        },
      }
    },
  };
  assert_eq(check_workspace(a_workspace("None")).diagnostics, [])
}

test "a workspace file with a wrong shape fails with the same error codes as a manifest, and its message names the `workspace` function" {
  let shaped = check_workspace(
    b"import std.pkg (Workspace)\nfn package() -> Workspace = 1",
  ).diagnostics;
  assert_eq(shaped.map(|d: ParseDiagnostic| d.code), [b"E0129"]);
  assert_eq(shaped.get(0).message, b"a workspace's one definition is named `workspace`");
  assert_eq(
    workspace_codes(
      b"import std.pkg (Workspace)\nfn workspace() -> Workspace = { packages: list() }",
    ),
    [b"E0130"],
  );
  assert_eq(
    workspace_codes(b"import std.pkg (Workspace)\nfn workspace() -> Workspace = { packages: [] }"),
    [b"E0131"],
  )
}

test "a workspace is rejected if a directory is listed twice, a directory path is absolute or not normalized, or an entry or runtime name is malformed" {
  let twice = check_workspace(a_workspace(a_toolchain("ply.main", "lib/store"))).diagnostics;
  assert_eq(twice.map(|d: ParseDiagnostic| d.code), [b"E0131"]);
  assert(String::of_bytes_lossy(twice.get(0).message).contains("`lib/store` is named twice"));
  ["/abs/std", "../std", "lib/./std", "lib//std", ""].fold((), |u: Unit, dir: String|
    assert_eq(workspace_codes(a_workspace(a_toolchain("ply.main", dir))), [b"E0131"]));
  assert_eq(workspace_codes(a_workspace(a_toolchain("main", "lib/std"))), [b"E0131"]);
  assert_eq(
    workspace_codes(
      a_workspace(a_toolchain("ply.main", "lib/std").replace("ply-runtime", "Ply Runtime")),
    ),
    [b"E0131"],
  )
}

test "a manifest without a `package` function is rejected with a message that names `package` and the expected form" {
  let d = check_manifest(b"fn other() -> Int = 1").diagnostics.get(0);
  assert_eq(d.message, b"a manifest's one definition is named `package`");
  assert_eq(d.notes_text, [
    b"a `ply.pkg` file is exactly `fn package() -> Manifest = ...`, with std.pkg's Manifest",
  ])
}

test "a manifest with a syntax error reports the syntax error, not the error for a missing `package` function" {
  let got = check_manifest(b"fn package() -> Manifest = {name: \"a\"");
  assert_eq(got.diagnostics.len(), 1);
  assert(got.diagnostics.get(0).code != b"E0129")
}

test "`is_dotted_path` accepts lowercase names joined by dots, and rejects empty segments, capitals and hyphens" {
  assert(is_dotted_path("cli"));
  assert(is_dotted_path("std.pkg"));
  assert(is_dotted_path("a1.b_2.c"));
  assert(!is_dotted_path(""));
  assert(!is_dotted_path("Std"));
  assert(!is_dotted_path("a..b"));
  assert(!is_dotted_path("a."));
  assert(!is_dotted_path(".a"));
  assert(!is_dotted_path("a-b"))
}

pub type SuppliedPackage = { root: Bytes, manifest: Option<Bytes>, modules: List<Source> }

pub type PackageSources = { root: Bytes, manifest: Option<Bytes>, supplied: List<SuppliedPackage> }

pub type Package = {
  root: Bytes,
  prefix: Bytes,
  dependencies: List<Bytes>,
  manifest: Option<Manifest>,
}

pub type Closure = {
  packages: List<Package>,
  modules: List<{ pkg: Int, source: Source }>,
  diagnostics: List<{ slot: Int, diagnostic: ParseDiagnostic }>,
}

fn join_normalized(base: Bytes, rel: Bytes) -> Bytes / {abort.raise} =
  normalize(Bytes::concat_all([base, b"/", rel]))

fn normalize(path: Bytes) -> Bytes / {abort.raise} = {
  let out = path.split(b"/").fold([], |out: List<Bytes>, seg: Bytes|
    if seg == b"." || seg == b"" { out } else if seg == b".." {
      if out.len() == 0 || out.get(out.len() - 1) == b".." { out.push(b"..") }
      else { out.take(out.len() - 1) }
    } else { out.push(seg) });
  let joined = Bytes::join(out, b"/");
  if path.len() > 0 && path.at(0) == 47 { b"/".concat(joined) } else { joined }
}

pub fn roots_wanted(
  known: List<Bytes>,
  manifests: List<SuppliedPackage>,
) -> List<Bytes> / {abort.raise} = {
  let root = match manifests.at(0) { Some(s) -> s.root, None -> b"" };
  manifests.fold([], |accumulator: List<Bytes>, s: SuppliedPackage|
    match s.manifest {
      None -> accumulator,
      Some(manifest_text) -> match check_manifest(manifest_text).manifest {
        None -> accumulator,
        Some(m) ->
          m.dependencies.fold(accumulator, |accumulator2: List<Bytes>, d: Dependency|
            match d.source {
              Path(p) ->
                add_wanted_root(known, accumulator2, join_normalized(s.root, Bytes::of_string(p))),
              Git(url, rev) ->
                add_wanted_root(
                  known,
                  accumulator2,
                  git_key(Bytes::of_string(url), Bytes::of_string(rev)),
                ),
              Registry ->
                add_wanted_root(known, accumulator2, registry_key(root, Bytes::of_string(d.name))),
            }),
      },
    })
}

fn add_wanted_root(known: List<Bytes>, accumulator: List<Bytes>, root: Bytes) -> List<Bytes> =
  if known.contains(root) || accumulator.contains(root) { accumulator }
  else { accumulator.push(root) }

test "`roots_wanted` returns the dependency directories that the loaded manifests list and whose manifests are not loaded yet" {
  let app = supplied_at("/x/app", "app", [
    a_dependency("b", 1, "../b"),
    a_dependency("c", 1, "../c"),
  ]);
  assert_eq(roots_wanted([b"/x/app"], [app]), [b"/x/b", b"/x/c"]);
  assert_eq(roots_wanted([b"/x/app", b"/x/b"], [app]), [b"/x/c"]);
  assert_eq(roots_wanted([b"/x/app"], [{ root: b"/x/app", manifest: None, modules: [] }]), [])
}

pub fn git_key(url: Bytes, rev: Bytes) -> Bytes = Bytes::concat_all([b"git+", url, b"@", rev])

pub fn registry_dir(root: Bytes) -> Bytes / {abort.raise} =
  join_normalized(root, b".ply-cache/registry")

pub fn registry_key(root: Bytes, name: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([registry_dir(root), b"/", name])

pub fn git_spec(key: Bytes) -> Option<{ url: Bytes, rev: Bytes }> / {abort.raise} =
  if !key.starts_with(b"git+") { None } else {
    let rest = key.slice(4, key.len());
    match last_at(rest) {
      None -> None,
      Some(at) -> Some({ url: rest.slice(0, at), rev: rest.slice(at + 1, rest.len()) }),
    }
  }

fn last_at(rest: Bytes) -> Option<Int> = {
  let found = range(0, rest.len()).fold(0, |accumulator: Int, i: Int|
    if rest.at(i) == 64 { i } else { accumulator });
  if found == 0 || found + 1 >= rest.len() { None } else { Some(found) }
}

fn slot_of(manifests: List<Option<Bytes>>, i: Int) -> Int = {
  let before = manifests.take(i);
  before.fold(0, |accumulator: Int, m: Option<Bytes>|
    match m { None -> accumulator, Some(_) -> accumulator + 1 })
}

fn checked_manifests(
  texts: List<Option<Bytes>>,
) -> { manifests: List<Option<Manifest>>, diagnostics: List<{ slot: Int, diagnostic: ParseDiagnostic }> } / {abort.raise} =
  range(0, texts.len()).fold(
    { manifests: [], diagnostics: [] },
    |accumulator: { manifests: List<Option<Manifest>>, diagnostics: List<{ slot: Int, diagnostic: ParseDiagnostic }> }, i: Int|
      match texts.get(i) {
        None -> { ..accumulator, manifests: accumulator.manifests.push(None) },
        Some(manifest_text) -> {
          let c = check_manifest(manifest_text);
          let slot = slot_of(texts, i);
          {
            manifests: accumulator.manifests.push(c.manifest),
            diagnostics: c.diagnostics.fold(
              accumulator.diagnostics,
              |ds: List<{ slot: Int, diagnostic: ParseDiagnostic }>, diagnostic: ParseDiagnostic|
                ds.push({ slot: slot, diagnostic: diagnostic }),
            ),
          }
        },
      },
  )

fn manifest_diagnostic(
  slot: Int,
  code: Bytes,
  message: Bytes,
) -> { slot: Int, diagnostic: ParseDiagnostic } =
  {
    slot: slot,
    diagnostic: error_at(code, dummy_span(), message, b"in this package's manifest", []),
  }

pub fn anonymous_package() -> PackageSources = { root: b"", manifest: None, supplied: [] }

pub fn closure(packages: PackageSources, root_modules: List<Bytes>) -> Closure / {abort.raise} =
  closure_of_validated(read_packages(packages, root_modules), packages.supplied)

pub type ValidatedPackages = {
  packages: List<Package>,
  diagnostics: List<{ slot: Int, diagnostic: ParseDiagnostic }>,
}

pub fn closure_of_validated(
  j: ValidatedPackages,
  supplied: List<SuppliedPackage>,
) -> Closure / {abort.raise} =
  {
    packages: j.packages,
    modules: name_modules(j.packages, supplied, 1, []),
    diagnostics: j.diagnostics,
  }

pub fn without_locations(j: ValidatedPackages) -> ValidatedPackages / {abort.raise} =
  {
    ..j,
    packages: range(0, j.packages.len()).map(|i: Int| {
      let p = j.packages.get(i);
      {
        ..p,
        root: location_placeholder(i),
        manifest: match p.manifest {
          None -> None,
          Some(m) ->
            Some({
              ..m,
              dependencies: m.dependencies.map(|d: Dependency|
                match d.source { Path(_) -> { ..d, source: Path("") }, _ -> d }),
            }),
        },
      }
    }),
  }

pub fn location_placeholder(i: Int) -> Bytes = Bytes::of_string("package " ++ i.to_string())

pub fn read_packages(
  packages: PackageSources,
  root_modules: List<Bytes>,
) -> ValidatedPackages / {abort.raise} = {
  let texts: List<Option<Bytes>> = packages.supplied.fold(
    [packages.manifest],
    |accumulator: List<Option<Bytes>>, supplied: SuppliedPackage|
      accumulator.push(supplied.manifest),
  );
  let roots: List<Bytes> = packages.supplied.fold(
    [packages.root],
    |accumulator: List<Bytes>, supplied: SuppliedPackage| accumulator.push(supplied.root),
  );
  let checked = checked_manifests(texts);
  let packages = range(0, roots.len()).map(|i: Int| {
    let m = checked.manifests.get(i);
    {
      root: roots.get(i),
      prefix: match m { None -> b"", Some(x) -> Bytes::of_string(prefix_of(x)) },
      dependencies: [],
      manifest: m,
    }
  });
  link_packages(texts, roots, checked.manifests, packages, root_modules, checked.diagnostics)
}

derive bin for SuppliedPackage
derive bin for PackageSources
derive bin for Package
derive bin for ValidatedPackages

fn name_modules(
  packages: List<Package>,
  supplied: List<SuppliedPackage>,
  i: Int,
  out: List<{ pkg: Int, source: Source }>,
) -> List<{ pkg: Int, source: Source }> / {abort.raise} =
  if i > supplied.len() { out } else {
    let p = packages.get(i);
    let named = match p.manifest {
      None ->
        supplied.get(i - 1).modules.fold(
          out,
          |o: List<{ pkg: Int, source: Source }>, source: Source|
            o.push({ pkg: i, source: source }),
        ),
      Some(_) ->
        supplied.get(i - 1).modules.fold(
          out,
          |o: List<{ pkg: Int, source: Source }>, source: Source|
            o.push({
              pkg: i,
              source: {
                name: Bytes::concat_all([p.prefix, b".", source.name]),
                source_text: source.source_text,
              },
            }),
        ),
    };
    name_modules(packages, supplied, i + 1, named)
  }

pub type LockedPackage = { name: Bytes, version: Bytes, digest: Bytes }

fn digest_domain() -> Bytes = b"ply.lock.package.1"

pub fn pins_of(
  clo: Closure,
  embeds: List<ModuleEmbed> = [],
) -> List<LockedPackage> / {abort.raise} =
  range(1, clo.packages.len()).fold([], |accumulator: List<LockedPackage>, i: Int| {
    let p = clo.packages.get(i);
    match p.manifest {
      None -> accumulator,
      Some(m) ->
        accumulator.push({
          name: Bytes::of_string(m.name),
          version: version_text(m.version),
          digest: package_digest(i, clo, embeds),
        }),
    }
  })

fn package_digest(pkg: Int, clo: Closure, embeds: List<ModuleEmbed>) -> Bytes / {abort.raise} = {
  let mine = clo.modules.filter(|m: { pkg: Int, source: Source }| m.pkg == pkg);
  let parts = mine.map(|m: { pkg: Int, source: Source }|
    Bytes::concat_all([m.source.name, b"\0", m.source.source_text, b"\0"]));
  let names = mine.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bool>, m: { pkg: Int, source: Source }|
      accumulator.insert(m.source.name, true),
  );
  let embedded = embeds.filter(|embed: ModuleEmbed| names.contains(embed.module)).map(embed_part);
  let modules = Bytes::concat_all(sort_bytes(parts));
  let tail = if embedded.len() == 0 { b"" }
  else { b"\x01embeds".concat(Bytes::concat_all(sort_bytes(embedded))) };
  b"b3:".concat(hex(blake3(Bytes::concat_all([digest_domain(), modules, tail]))))
}

fn embed_part(embed: ModuleEmbed) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    embed.module,
    b"\0",
    embed.key,
    b"\0",
    match embed.read {
      Ok(files) ->
        Bytes::concat_all(
          files.map(|file: EmbedFile|
            Bytes::concat_all([file.name, b"\0", hex(file.digest), b"\0"])),
        ),
      Err(reason) -> Bytes::concat_all([b"\x01", reason, b"\0"]),
    },
  ])

type Pending = {
  packages: List<Package>,
  diagnostics: List<{ slot: Int, diagnostic: ParseDiagnostic }>,
  edges: List<{ from: Int, target: Int }>,
}

fn root_index(roots: List<Bytes>, key: Bytes, i: Int) -> Option<Int> / {abort.raise} =
  if i >= roots.len() { None }
  else if roots.get(i) == key { Some(i) }
  else { root_index(roots, key, i + 1) }

fn link_packages(
  texts: List<Option<Bytes>>,
  roots: List<Bytes>,
  manifests: List<Option<Manifest>>,
  packages: List<Package>,
  root_modules: List<Bytes>,
  diagnostics: List<{ slot: Int, diagnostic: ParseDiagnostic }>,
) -> ValidatedPackages / {abort.raise} = {
  let built = range(0, packages.len()).fold(
    { packages: packages, diagnostics: diagnostics, edges: [] },
    |accumulator: Pending, i: Int|
      match manifests.get(i) {
        None -> accumulator,
        Some(m) ->
          m.dependencies.fold(accumulator, |a: Pending, d: Dependency|
            judge_dependency(texts, roots, manifests, i, a, d)),
      },
  );
  let versioned = version_judgments(texts, roots, built.packages, built.edges, built.diagnostics);
  let collided = prefix_judgments(texts, roots, built.packages, root_modules, versioned);
  let cycled = match graph::cycle(graph::of_edges(roots.len(), built.edges)) {
    None -> collided,
    Some(c) ->
      collided.push({
        slot: slot_of(texts, c.get(0)),
        diagnostic: error_at(
          b"E0134",
          dummy_span(),
          Bytes::concat_all([b"packages depend on one another in a cycle: ", cycle_text(roots, c)]),
          b"in this package's manifest",
          [
            b"break the cycle: a package may not depend on itself, directly or through other packages",
          ],
        ),
      }),
  };
  { packages: built.packages, diagnostics: cycled }
}

fn version_text(v: Version) -> Bytes =
  Bytes::of_string(v.major.to_string() ++ "." ++ v.minor.to_string() ++ "." ++ v.patch.to_string())

fn version_judgments(
  texts: List<Option<Bytes>>,
  roots: List<Bytes>,
  packages: List<Package>,
  edges: List<{ from: Int, target: Int }>,
  diagnostics: List<{ slot: Int, diagnostic: ParseDiagnostic }>,
) -> List<{ slot: Int, diagnostic: ParseDiagnostic }> / {abort.raise} = {
  let named = |p: Package| match p.manifest { None -> "", Some(m) -> m.name };
  range(0, packages.len()).fold(
    diagnostics,
    |accumulator: List<{ slot: Int, diagnostic: ParseDiagnostic }>, i: Int| {
      let p = packages.get(i);
      if p.manifest == None { accumulator } else {
        let earlier = range(0, i).fold(None, |found: Option<Int>, j: Int|
          match found {
            Some(_) -> found,
            None -> if named(packages.get(j)) == named(p) && packages.get(j).manifest != None {
              Some(j)
            } else { None },
          });
        match earlier {
          None -> accumulator,
          Some(j) ->
            accumulator.push({
              slot: slot_of(texts, requester_of(edges, i)),
              diagnostic: error_at(
                b"E0137",
                dummy_span(),
                Bytes::concat_all([
                  b"`",
                  Bytes::of_string(named(p)),
                  b"` is reached at two places: `",
                  Bytes::of_string(package_name(packages.get(requester_of(edges, j)))),
                  b"` wants `",
                  roots.get(j),
                  b"`, and `",
                  Bytes::of_string(package_name(packages.get(requester_of(edges, i)))),
                  b"` wants `",
                  roots.get(i),
                  b"`",
                ]),
                b"in this package's manifest",
                [
                  b"a program uses one version of each package, so only one of these can be used",
                  b"depend on only one of them, or make them the same package",
                ],
              ),
            }),
        }
      }
    },
  )
}

fn requester_of(edges: List<{ from: Int, target: Int }>, target: Int) -> Int =
  match first_edge(edges, target) { Some(from) -> from, None -> target }

fn first_edge(edges: List<{ from: Int, target: Int }>, target: Int) -> Option<Int> =
  match edges {
    [] -> None,
    [e, ..rest] -> if e.target == target { Some(e.from) } else { first_edge(rest, target) },
  }

fn cycle_text(roots: List<Bytes>, c: List<Int>) -> Bytes / {abort.raise} =
  Bytes::join(c.push(c.get(0)).map(|i: Int| roots.get(i)), b" -> ")

fn judge_dependency(
  texts: List<Option<Bytes>>,
  roots: List<Bytes>,
  manifests: List<Option<Manifest>>,
  i: Int,
  accumulator: Pending,
  d: Dependency,
) -> Pending / {abort.raise} = {
  let name = Bytes::of_string(d.name);
  match d.source {
    Git(url, rev) -> {
      let key = git_key(Bytes::of_string(url), Bytes::of_string(rev));
      link_dependency_target(
        texts,
        roots,
        manifests,
        i,
        accumulator,
        d,
        key,
        Bytes::concat_all([b"the dependency `", name, b"` at `", key, b"` was not fetched"]),
        [],
      )
    },
    Path(p) -> {
      let target = join_normalized(roots.get(i), Bytes::of_string(p));
      link_dependency_target(
        texts,
        roots,
        manifests,
        i,
        accumulator,
        d,
        target,
        Bytes::concat_all([b"the dependency `", name, b"` at `", target, b"` was not read"]),
        [],
      )
    },
    Registry ->
      link_dependency_target(
        texts,
        roots,
        manifests,
        i,
        accumulator,
        d,
        registry_key(roots.get(0), name),
        Bytes::concat_all([b"the registry dependency `", name, b"` has not been fetched"]),
        [resolve_note()],
      ),
  }
}

fn resolve_note() -> Bytes =
  b"`ply resolve` fetches the version that the project's dependencies select into the project's `.ply-cache/registry`"

fn is_registry(d: Dependency) -> Bool = match d.source { Registry -> true, _ -> false }

fn link_dependency_target(
  texts: List<Option<Bytes>>,
  roots: List<Bytes>,
  manifests: List<Option<Manifest>>,
  i: Int,
  accumulator: Pending,
  d: Dependency,
  key: Bytes,
  absent: Bytes,
  notes: List<Bytes>,
) -> Pending / {abort.raise} = {
  let slot = slot_of(texts, i);
  let name = Bytes::of_string(d.name);
  match root_index(roots, key, 0) {
    None -> push_diagnostic_notes(accumulator, slot, b"E0135", absent, notes),
    Some(j) -> match texts.get(j) {
      None -> if is_registry(d) {
        push_diagnostic_notes(accumulator, slot, b"E0135", absent, notes)
      } else {
        push_diagnostic_text(
          accumulator,
          slot,
          b"E0135",
          Bytes::concat_all([
            b"the dependency `",
            name,
            b"` at `",
            key,
            b"` holds no ply.pkg; a package that is depended on must declare one",
          ]),
        )
      },
      Some(_) -> match manifests.get(j) {
        None -> accumulator,
        Some(tm) -> {
          let granted = Bytes::of_string(prefix_of(tm));
          let aliased = match d.prefix { None -> granted, Some(a) -> Bytes::of_string(a) };
          if is_registry(d) && tm.name != d.name {
            push_diagnostic_notes(
              accumulator,
              slot,
              b"E0135",
              Bytes::concat_all([
                b"the registry dependency `",
                name,
                b"` at `",
                key,
                b"` holds the package `",
                Bytes::of_string(tm.name),
                b"`",
              ]),
              notes,
            )
          } else if compare(tm.version, d.min) == Less {
            push_diagnostic_notes(
              accumulator,
              slot,
              b"E0136",
              Bytes::concat_all([
                b"the dependency `",
                name,
                b"` at `",
                key,
                b"` is version ",
                version_text(tm.version),
                b", and this manifest asks for at least ",
                version_text(d.min),
              ]),
              notes,
            )
          } else if aliased != granted {
            push_diagnostic_text(
              accumulator,
              slot,
              b"E0133",
              Bytes::concat_all([
                b"the dependency `",
                name,
                b"` is granted the prefix `",
                aliased,
                b"` here, but calls itself `",
                granted,
                b"`",
              ]),
            )
          } else {
            {
              packages: accumulator.packages.set(i, {
                ..accumulator.packages.get(i),
                dependencies: accumulator.packages.get(i).dependencies.push(granted),
              }),
              diagnostics: accumulator.diagnostics,
              edges: accumulator.edges.push({ from: i, target: j }),
            }
          }
        },
      },
    },
  }
}

fn push_diagnostic_notes(
  accumulator: Pending,
  slot: Int,
  code: Bytes,
  message: Bytes,
  notes: List<Bytes>,
) -> Pending =
  {
    ..accumulator,
    diagnostics: accumulator.diagnostics.push({
      slot: slot,
      diagnostic: error_at(code, dummy_span(), message, b"in this package's manifest", notes),
    }),
  }

fn push_diagnostic_text(accumulator: Pending, slot: Int, code: Bytes, message: Bytes) -> Pending =
  {
    ..accumulator,
    diagnostics: accumulator.diagnostics.push(manifest_diagnostic(slot, code, message)),
  }

fn prefix_judgments(
  texts: List<Option<Bytes>>,
  roots: List<Bytes>,
  packages: List<Package>,
  root_modules: List<Bytes>,
  diagnostics: List<{ slot: Int, diagnostic: ParseDiagnostic }>,
) -> List<{ slot: Int, diagnostic: ParseDiagnostic }> / {abort.raise} = {
  let reserved = range(0, packages.len()).fold(
    diagnostics,
    |accumulator: List<{ slot: Int, diagnostic: ParseDiagnostic }>, i: Int| {
      let p = packages.get(i);
      if p.manifest == None || p.prefix.len() == 0 { accumulator } else {
        let with_reserved = if p.prefix == b"std" || p.prefix == b"compiler" {
          accumulator.push({
            slot: slot_of(texts, i),
            diagnostic: error_at(
              b"E0133",
              dummy_span(),
              Bytes::concat_all([
                b"the package at `",
                p.root,
                b"` grants the prefix `",
                p.prefix,
                b"`, which is reserved",
              ]),
              b"in this package's manifest",
              [b"`std` and `compiler` name the modules the toolchain ships"],
            ),
          })
        } else { accumulator };
        range(i + 1, packages.len()).fold(
          with_reserved,
          |accumulator2: List<{ slot: Int, diagnostic: ParseDiagnostic }>, j: Int| {
            let q = packages.get(j);
            if q.manifest == None || p.prefix != q.prefix { accumulator2 }
            else if package_name(p) == package_name(q) { accumulator2 } else {
              accumulator2.push({
                slot: slot_of(texts, j),
                diagnostic: error_at(
                  b"E0133",
                  dummy_span(),
                  Bytes::concat_all([
                    b"the packages at `",
                    p.root,
                    b"` and `",
                    q.root,
                    b"` both grant the prefix `",
                    p.prefix,
                    b"`",
                  ]),
                  b"in this package's manifest",
                  [
                    b"a module prefix can belong to only one package among the project's dependencies",
                  ],
                ),
              })
            }
          },
        )
      }
    },
  );
  root_modules.fold(
    reserved,
    |accumulator: List<{ slot: Int, diagnostic: ParseDiagnostic }>, m: Bytes| {
      let seg = first_segment(m);
      match find_prefix(packages, seg, 1) {
        None -> accumulator,
        Some(j) ->
          accumulator.push({
            slot: slot_of(texts, j),
            diagnostic: error_at(
              b"E0133",
              dummy_span(),
              Bytes::concat_all([
                b"`",
                m,
                b"` is a module of the root package, but `",
                seg,
                b"` is granted by the package at `",
                packages.get(j).root,
                b"`",
              ]),
              b"in this package's manifest",
              [b"rename the directory, or the dependency's prefix"],
            ),
          }),
      }
    },
  )
}

fn package_name(package: Package) -> String =
  match package.manifest { None -> "", Some(m) -> m.name }

pub fn first_segment(name: Bytes) -> Bytes / {abort.raise} =
  match name.index_of(b".") { None -> name, Some(i) -> name.slice(0, i) }

fn find_prefix(packages: List<Package>, prefix: Bytes, i: Int) -> Option<Int> / {abort.raise} =
  if i >= packages.len() { None }
  else if packages.get(i).manifest != None && packages.get(i).prefix == prefix { Some(i) }
  else { find_prefix(packages, prefix, i + 1) }
