import compiler.syntax.parsing (ParseDiagnostic, Label, ParseOutput, no_module)
import compiler.syntax.items (Module, Derivation, header, parse, with_prelude)
import compiler.syntax.expressions (prelude_module)
import compiler.expand.rewrite (expand)
import compiler.syntax.node_ids (numbered_module)
import compiler.expand.derive (Expansion, DeriverRequest, DeriverResponse, expand_derives)
import compiler.check.resolve.tables (Source, ParsedModule, Diagnostic)
import compiler.check.resolve (ResolveSucceeded, ResolveFailed, resolve_modules)
import compiler.store.hash.forms (build_index)
import compiler.check.infer (check_diagnostics)
import std.list
import compiler.prelude_source

pub fn diagnostic_in_module(module: Int, diagnostic: ParseDiagnostic) -> Diagnostic =
  {
    code: diagnostic.code,
    notes: diagnostic.notes,
    labels: diagnostic.labels.map(|label: Label|
      {
        module: module,
        start: label.start,
        end: label.end,
        primary: label.primary,
        text: label.text,
      }),
    text: b"",
    message: diagnostic.message,
    notes_text: diagnostic.notes_text,
    severity: diagnostic.severity,
    fixes: [],
  }

pub type ParsedSource = {
  name: Bytes,
  module: ParsedModule,
  diagnostics: List<Diagnostic>,
  text: Bytes,
}

pub fn parse_all(sources: List<Source>) -> List<ParsedSource> / {abort.raise} =
  range(0, sources.len()).map(|i: Int| parse_at(i, sources.get(i)))

pub fn parse_at(i: Int, source: Source) -> ParsedSource / {abort.raise} =
  parse_from(i, source, parse(source.source_text))

pub fn parse_from<| e>(
  i: Int,
  source: Source,
  r: ParseOutput<Module>,
  derivations: List<Derivation> = [],
  library: Option<(DeriverRequest) -> DeriverResponse / {abort.raise | e}> = None,
) -> ParsedSource / {abort.raise | e} = {
  let x = expand(with_prelude(source.name, numbered_module(r.node)), r.parser.diagnostics);
  let parse_diagnostics = x.diagnostics.map(|d: ParseDiagnostic| diagnostic_in_module(i, d));
  if parse_diagnostics.len() > 0 {
    {
      name: source.name,
      module: { name: source.name, module: x.module, derived: [] },
      diagnostics: parse_diagnostics,
      text: source.source_text,
    }
  } else {
    let d: Expansion = expand_derives(
      i,
      source.name,
      x.module,
      previous: derivations,
      library: library,
    );
    {
      name: source.name,
      module: { name: source.name, module: d.module, derived: d.derived },
      diagnostics: d.diagnostics,
      text: source.source_text,
    }
  }
}

pub fn parse_header_at(i: Int, source: Source) -> ParsedSource / {abort.raise} =
  match header(source.source_text) {
    None -> parse_at(i, source),
    Some(m) ->
      {
        name: source.name,
        module: { name: source.name, module: with_prelude(source.name, m), derived: [] },
        diagnostics: [],
        text: source.source_text,
      },
  }

pub fn with_prelude_source(sources: List<Source>) -> List<Source> =
  if sources.any(|s: Source| s.name == prelude_module) { sources }
  else { sources.push({ name: prelude_module, source_text: prelude_source::text }) }

pub fn diagnostics(sources: List<Source>) -> List<Diagnostic> / {abort.raise} = {
  let parsed = parse_all(with_prelude_source(sources));
  let parse_diagnostics = parsed.fold([], |accumulator: List<Diagnostic>, p: ParsedSource|
    accumulator.concat(p.diagnostics));
  if parse_diagnostics.len() > 0 { parse_diagnostics } else {
    let later = match resolve_modules(parsed.map(|p: ParsedSource| p.module)) {
      ResolveFailed(ds) -> ds,
      ResolveSucceeded(x) -> {
        let built = build_index(x.modules, x.resolution);
        if built.diagnostics.len() > 0 { built.diagnostics }
        else { check_diagnostics(x.resolution, x.modules) }
      },
    };
    later.map(outside_every_module)
  }
}

pub fn outside_every_module(diagnostic: Diagnostic) -> Diagnostic =
  if diagnostic.code == b"E0105" && diagnostic.message.starts_with(b"two files claim") {
    diagnostic
  } else {
    {
      code: diagnostic.code,
      notes: diagnostic.notes,
      labels: diagnostic.labels.map(
        |l: { module: Int, start: Int, end: Int, primary: Bool, text: Bytes }|
          if l.start == 0 && l.end == 0 {
            { module: no_module, start: 0, end: 0, primary: l.primary, text: l.text }
          } else { l },
      ),
      text: diagnostic.text,
      message: diagnostic.message,
      notes_text: diagnostic.notes_text,
      severity: diagnostic.severity,
      fixes: diagnostic.fixes,
    }
  }

fn only(text: Bytes) -> Diagnostic / {abort.raise} = {
  let ds = diagnostics([{ name: b"m", source_text: text }]);
  assert_eq(ds.len(), 1);
  ds.get(0)
}

test "a parser diagnostic names what it expected and the token it found" {
  let d = only(b"fn f() -> Int = )");
  assert_eq(d.code, b"E0001");
  assert_eq(d.severity, b"error");
  assert_eq(d.message, b"expected an expression, found `)`");
  assert_eq(d.labels, [
    { module: 0, start: 16, end: 17, primary: true, text: b"expected an expression" },
  ]);
  assert_eq(d.notes_text, [])
}

test "the error for an import of a missing module includes the note that a module is a file" {
  let d = only(b"import missing\nfn f() -> Int = 1");
  assert_eq(d.code, b"E0106");
  assert_eq(d.message, b"no module named `missing` in this program");
  assert_eq(d.labels, [{ module: 0, start: 7, end: 14, primary: true, text: b"not found" }]);
  assert_eq(d.notes_text, [
    b"a module is a file: `store/orders.ply` is `store.orders`, relative to the project root",
  ])
}

test "a type mismatch error prints the expected and found types in its label" {
  let d = only(b"fn f() -> Int = \"x\"");
  assert_eq(d.code, b"E0201");
  assert_eq(d.message, b"type mismatch: function body type");
  assert_eq(d.labels, [
    { module: 0, start: 16, end: 19, primary: true, text: b"expected `Int`, found `String`" },
  ]);
  assert_eq(d.notes_text, [])
}

test "a check diagnostic carries its note" {
  let d = only(b"fn f() -> Int = 1(2)");
  assert_eq(d.code, b"E0204");
  assert_eq(d.message, b"this is not a function");
  assert_eq(d.labels, [{ module: 0, start: 16, end: 17, primary: true, text: b"has type `Int`" }]);
  assert_eq(d.notes_text, [b"only function values can be applied"])
}

test "a `law` must name a law schema and pass as many arguments as the schema has parameters" {
  let other = only(b"fn f(n: Int) -> Int = n\nlaw \"l\" = f(f)");
  assert_eq(other.code, b"E0472");
  assert_eq(other.message, b"`f` is not a law schema");
  assert_eq(other.labels, [
    { module: 0, start: 34, end: 35, primary: true, text: b"a law instantiates a schema" },
    { module: 0, start: 3, end: 4, primary: false, text: b"declared here" },
  ]);
  let short = only(
    b"fn f(n: Int) -> Int = n\nlaw schema s(g: (Int) -> Int, h: (Int) -> Int) forall (x: Int) { g(x) == h(x) }\nlaw \"l\" = s(f)",
  );
  assert_eq(short.code, b"E0202");
  assert_eq(short.message, b"the schema `s` takes 2 arguments, but 1 was supplied")
}

test "a secondary label comes after the primary label in a diagnostic" {
  let d = only(b"fn g(x: Int) -> Int = x\nfn f() -> Int = g(1, 2)");
  assert_eq(d.code, b"E0202");
  assert_eq(d.message, b"this function takes 1 argument, but 2 were supplied");
  assert_eq(d.labels, [
    { module: 0, start: 40, end: 47, primary: true, text: b"expected 1, found 2" },
    { module: 0, start: 40, end: 41, primary: false, text: b"this is the function being called" },
  ])
}
