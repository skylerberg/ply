pub type OrdinalRow = { module: Bytes, items: List<Bytes> }

pub type BodyRow = { name: Bytes, body: Bytes }

pub type Dump = {
  diagnostics: List<Diagnostic>,
  order: List<Bytes>,
  packages: List<PackageDependencies>,
  pins: List<LockedPackage>,
  module_packages: List<Int>,
  modules: List<ModuleRow>,
  definitions: List<DefinitionRow>,
  types: List<TypeRow>,
  tests: List<TestRow>,
  laws: List<LawRow>,
  effects: List<EffectRow>,
  constructors: List<ConstructorRow>,
  hashes: List<HashTableRow>,
  hashes_digest: Bytes,
  keys: List<KeyRow>,
  emitter_roots: List<EmitterRoot>,
  emitter_constructors: List<EmitterConstructor>,
  ordinals: List<OrdinalRow>,
  bodies: List<BodyRow>,
  embeds: List<ModuleEmbed>,
  rows: Rows,
  inferred_facts: Bytes,
  derived: List<ModuleDerivations>,
}

pub fn normalized_diagnostic(diagnostic: Diagnostic) -> Diagnostic =
  {
    code: diagnostic.code,
    notes: diagnostic.notes_text.len(),
    labels: diagnostic.labels,
    text: b"",
    message: diagnostic.message,
    notes_text: diagnostic.notes_text,
    severity: diagnostic.severity,
    fixes: diagnostic.fixes,
  }

test "`requests_by_item` groups a module's embed requests by function or test name, and its requests equal `embed_requests` of the module, which lists each file once" {
  let m = parse(
    b"fn a() -> Bytes = embed(\"x\")\nfn b() -> Bytes = embed(\"x\")\nfn c() -> List<Int> = embed_dir(\"d\").map(|f: { name: String, bytes: Bytes }| 1)\ntest \"t\" { assert(embed(\"y\").len() > 0) }\n",
  ).node;
  assert_eq(requests_in(requests_by_item(m)), embed_requests(m));
  assert_eq(requests_by_item(m).map(|i: ItemEmbeds| i.name), [
    Some(b"a"),
    Some(b"b"),
    Some(b"c"),
    Some(b"test t"),
  ])
}
