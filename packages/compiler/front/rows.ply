pub type Widths =
  | NoWidths
  | FixedWidth(Int)
  | ListWidths(Widths)
  | MapWidths(Widths, Widths)
  | RecordWidths(List<FieldWidths>)
  | SumWidths(List<Widths>)
  | FunctionWidths(List<Widths>, Widths)
  | VariableWidths(Int)

pub type FieldWidths = { name: Bytes, carry: Widths }

