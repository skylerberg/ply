pub fn span_at(module: Int, span: Span) -> ModuleSpan =
  {
    module: if span.start == 0 && span.end == 0 { no_module() } else { module },
    start: span.start,
    end: span.end,
  }

pub fn location_span(location: Location) -> ModuleSpan = span_at(location.module, location.span)

pub type WrittenFunction = {
  public: Bool,
  reuse: Bool,
  params: List<SpannedName>,
  literals: List<Bytes>,
}

fn no_written_function() -> WrittenFunction =
  { public: false, reuse: false, params: [], literals: [] }

pub fn written_functions(outlines: List<Outline>) -> Map<Bytes, WrittenFunction> =
  outlines.fold(Map::new(), |accumulator: Map<Bytes, WrittenFunction>, o: Outline|
    o.items.fold(accumulator, |a: Map<Bytes, WrittenFunction>, item: OutlineItem|
      match item {
        OutlinedFunction(f) ->
          a.insert(qualify(o.name, f.name), {
            public: f.public,
            reuse: f.reuse,
            params: f.params,
            literals: f.literals,
          }),
        _ -> a,
      }))

pub fn written_function_of(m: Map<Bytes, WrittenFunction>, name: Bytes) -> WrittenFunction =
  match m.get(name) { Some(w) -> w, None -> no_written_function() }

pub type SpannedName = { name: Bytes, span: Span }

pub type FunctionOutline = {
  name: Bytes,
  public: Bool,
  generated: Bool,
  reuse: Bool,
  returns: Bool,
  measured: Bool,
  params: List<SpannedName>,
  literals: List<Bytes>,
  spec: List<SpecKind>,
  constant: Bool,
  name_span: Span,
  span: Span,
}

pub type TestOutline = { name: Bytes, label_span: Span, cases: Bool }

pub type LawOutline = { name: Bytes, literals: List<Bytes> }

pub type TypeOutline = { name: Bytes, public: Bool, arity: Int, span: Span }

pub type OutlineItem =
  | OutlinedFunction(FunctionOutline)
  | OutlinedTest(TestOutline)
  | OutlinedLaw(LawOutline)
  | OutlinedType(TypeOutline)
  | OutlinedEffect({ name: Bytes, public: Bool, host: Option<Bytes>, span: Span })

pub type Outline = {
  name: Bytes,
  items: List<OutlineItem>,
  declared: List<Bytes>,
  imports: List<Bytes>,
  schemas: List<Bytes>,
  sets: List<EffectSetRow>,
  cuts: List<Cut>,
  stated: List<Bytes>,
  set_texts: List<Bytes>,
  derived: List<Derivation>,
}

pub type ModuleDerivations = { module: Bytes, derivations: List<Derivation> }

derive bin for ModuleDerivations

derive bin for SpannedName

derive bin for FunctionOutline

derive bin for TestOutline

derive bin for LawOutline

derive bin for TypeOutline

derive bin for OutlineItem

derive bin for Outline

fn has_effect(effects: List<EffectInfo>, name: Bytes) -> Bool =
  effects.fold(false, |accumulator: Bool, effect_info: EffectInfo|
    accumulator || effect_info.name == name)

fn bare_prelude(qualified_name: QName) -> Option<Bytes> =
  if is_bare(qualified_name) && is_prelude_effect(qualified_name.name.name) {
    Some(qualified_name.name.name)
  } else { None }

fn set_effect(
  resolved: Resolution,
  effects: List<EffectInfo>,
  module: Int,
  qualified_name: QName,
) -> Option<Bytes> / {abort.raise} =
  if is_bare(qualified_name) && qualified_name.name.name == b"scoped" {
    Some(qualified_name.name.name)
  } else {
    let found = if is_bare(qualified_name) {
      lookup(resolved.scopes.get(module).bound, EffectSpace, qualified_name.name.name)
    } else { find(resolved, module, EffectSpace, qualified_name) };
    match found {
      Some(b) -> if has_effect(effects, b.qualified) { Some(b.qualified) }
      else { bare_prelude(qualified_name) },
      None -> bare_prelude(qualified_name),
    }
  }

fn set_effects(
  resolved: Resolution,
  effects: List<EffectInfo>,
  module: Int,
  written: List<EffectExpression>,
) -> List<Effect> / {abort.raise} =
  written.fold([], |accumulator: List<Effect>, entry: EffectExpression|
    match set_effect(resolved, effects, module, entry.effect_name) {
      Some(eff) ->
        effects_insert(accumulator, {
          effect: eff,
          resource: match entry.resource {
            Some(x) -> NamedResource(x.name),
            None -> SingletonResource,
          },
          mode: entry.mode,
          operation: match entry.operation { Some(x) -> Some(x.name), None -> None },
        }),
      None -> accumulator,
    })

pub type EffectSetRow = { name: Bytes, includes: List<Bytes>, listed: List<Effect> }

derive bin for EffectSetRow

fn continue_ok(c: Int) -> Bool = is_identifier_start(c) || (c >= 48 && c <= 57)

fn identifier_ok(segment: String) -> Bool = {
  let b = Bytes::of_string(segment);
  if b.len() == 0 { false } else {
    is_identifier_start(b.at(0))
      && range(1, b.len()).fold(true, |ok: Bool, i: Int| ok && continue_ok(b.at(i)))
  }
}

fn drop_extension(path: String) -> String / {abort.raise} =
  if path.ends_with(".ply") { path.slice(0, path.len() - 4) } else { path }

fn dotted(segments: List<String>) -> String =
  range(0, segments.len()).fold("", |accumulator: String, i: Int|
    match segments.at(i) {
      Some(s) -> if i == 0 { s } else { accumulator ++ "." ++ s },
      None -> accumulator,
    })

fn bad_segment(segments: List<String>) -> Option<String> =
  segments.fold(None, |accumulator: Option<String>, s: String|
    match accumulator {
      Some(_) -> accumulator,
      None -> if identifier_ok(s) { None } else { Some(s) },
    })

pub fn module_of(path: String) -> Result<String, String> / {abort.raise} = {
  let segments = drop_extension(path).split("/");
  match bad_segment(segments) {
    Some(s) -> Err("`" ++ s ++ "` is not an identifier"),
    None -> if segments.len() == 0 { Err("the path has no module name") }
    else { Ok(dotted(segments)) },
  }
}

pub fn effect_sets_of(
  resolved: Resolution,
  effects: List<EffectInfo>,
  module: Int,
  parsed: ParsedModule,
) -> List<EffectSetRow> / {abort.raise} =
  parsed.module.items.fold([], |accumulator: List<EffectSetRow>, item: Item|
    match item {
      EffectSetItem(d) ->
        accumulator.push({
          name: d.name.name,
          includes: d.includes.map(|qualified_name: QName| qualified_name.name.name),
          listed: set_effects(resolved, effects, module, d.expansion),
        }),
      _ -> accumulator,
    })

pub fn module_items(parsed: ParsedModule) -> List<Bytes> =
  parsed.module.items.fold([], |accumulator: List<Bytes>, item: Item|
    match item {
      FunctionItem(d) -> accumulator.push(qualify(parsed.name, d.name.name)),
      TypeItem(d) -> {
        let named = accumulator.push(qualify(parsed.name, d.name.name));
        match d.body {
          SumBody(vs) ->
            vs.fold(named, |a: List<Bytes>, variant: VariantDefinition|
              a.push(qualify(parsed.name, variant.name.name))),
          _ -> named,
        }
      },
      EffectItem(d) -> accumulator.push(qualify(parsed.name, d.name.name)),
      _ -> accumulator,
    })

pub fn module_imports(parsed: ParsedModule) -> List<Bytes> = imported_names(parsed.module.imports)

pub fn imported_names(imports: List<ImportDeclaration>) -> List<Bytes> =
  imports.fold([], |accumulator: List<Bytes>, declaration: ImportDeclaration| {
    let name = Bytes::join(declaration.path.map(|x: Identifier| x.name), b".");
    if accumulator.fold(false, |b: Bool, x: Bytes| b || x == name) { accumulator }
    else { accumulator.push(name) }
  })

pub fn module_row(i: Int, o: Outline, imports: List<Bytes>, unimported: List<Bytes>) -> ModuleRow =
  {
    name: o.name,
    index: i,
    items: o.declared,
    imports: imports,
    unimported: unimported,
    sets: o.sets,
    cuts: o.cuts,
  }

pub fn imports_resolved(
  modules: List<ParsedModule>,
  resolved: Resolution,
) -> List<List<Bytes>> / {abort.raise} =
  range(0, modules.len()).map(|i: Int|
    resolved.imports.get(i).fold([], |accumulator: List<Bytes>, t: Int| {
      let name = modules.get(t).name;
      if accumulator.fold(false, |b: Bool, x: Bytes| b || x == name) { accumulator }
      else { accumulator.push(name) }
    }))

pub fn skeleton_of_outlines(outlines: List<Outline>) -> HashLayout =
  outlines.fold(
    { nodes: [], order: [], tests: [], laws: [] },
    |accumulator: HashLayout, o: Outline|
      o.items.fold(accumulator, |a: HashLayout, item: OutlineItem| {
        let node = |name: Bytes, declaration: Bool|
          {
            ..a,
            nodes: a.nodes.push({ name: qualify(o.name, name), declaration: declaration }),
            order: a.order.push(DefinitionEntry(a.nodes.len())),
          };
        match item {
          OutlinedFunction(f) -> node(f.name, false),
          OutlinedType(t) -> node(t.name, true),
          OutlinedEffect(e) -> node(e.name, true),
          OutlinedTest(t) ->
            {
              ..a,
              tests: a.tests.push({ key: qualify(o.name, t.name), cases: t.cases }),
              order: a.order.push(TestEntry(a.tests.len())),
            },
          OutlinedLaw(l) ->
            {
              ..a,
              laws: a.laws.push(qualify(o.name, l.name)),
              order: a.order.push(LawEntry(a.laws.len())),
            },
        }
      }),
  )

pub fn is_declared_in(module: Bytes, name: Bytes) -> Bool / {abort.raise} =
  name.starts_with(module.concat(b".")) && name.index_of_from(b".", module.len() + 1) == None

pub type Cut = { start: Int, end: Int, braced: Bool, name: Bytes, test: Bool }

derive bin for Cut

pub type KeyRow = { root: Bytes, key: Bytes }

pub type EmitterRoot = {
  root: Bytes,
  arity: Int,
  pure: Bool,
  at: ModuleSpan,
  params: List<Widths>,
  result: Widths,
  witnesses: List<Int>,
}

pub type EmitterConstructor = {
  name: Bytes,
  arity: Int,
  fields: List<Widths>,
  key: Option<Bytes>,
  show: Option<Bytes>,
  numeric: List<Bytes>,
  release: Option<Bytes>,
}

pub type Widths =
  | NoWidths
  | FixedWidth(Int)
  | ListWidths(Widths)
  | MapWidths(Widths, Widths)
  | RecordWidths(List<FieldWidths>)
  | SumWidths(List<Widths>)
  | FunctionWidths(List<Widths>, Widths)
  | VariableWidths(Int)

pub type FieldWidths = { name: Bytes, widths: Widths }

pub type EffectHash = { name: Bytes, hash: Bytes }

pub type KnownDefinitionRow = {
  name: Bytes,
  hash: Bytes,
  effect_hashes: List<EffectHash>,
  effects: Bytes,
  performed_effects: Bytes,
  repeated_effects: Bytes,
  repeats: List<Int>,
  ending: Termination,
  summary: Summary,
  raises: List<Raise>,
  facts: Bytes,
  scheme: Scheme,
  value: Option<ConstantData>,
}

pub type KnownTestRow = {
  key: Bytes,
  hash: Bytes,
  effect_hashes: List<EffectHash>,
  effects: Bytes,
  owner: Bytes,
  body_facts: Bytes,
}

pub type Rows = {
  definitions: List<KnownDefinitionRow>,
  tests: List<KnownTestRow>,
  types: TypeTable,
}

derive bin for EffectHash

derive bin for KnownDefinitionRow

pub fn constant_values(rows: Rows) -> Map<Bytes, ConstantData> =
  rows.definitions.fold(
    Map::new(),
    |accumulator: Map<Bytes, ConstantData>, row: KnownDefinitionRow|
      match row.value { Some(v) -> accumulator.insert(row.name, v), None -> accumulator },
  )

derive bin for KnownTestRow

derive bin for Rows

