pub fn no_rows() -> Rows = { definitions: [], tests: [], types: Map::new() }

pub type EncodedRows = { types: List<InternedType>, at: List<Int>, rows: Rows }

derive bin for EncodedRows

pub fn encode_rows(r: Rows) -> Bytes / {abort.raise} = {
  let h = intern_types(r.definitions.map(|row: KnownDefinitionRow| row.scheme.ty));
  bin::encode(
    {
      types: h.labels,
      at: h.at,
      rows: {
        ..r,
        definitions: r.definitions.map(|row: KnownDefinitionRow|
          { ..row, scheme: { ..row.scheme, ty: unit_type() } }),
      },
    },
    encoded_rows_bin(),
  )
}

pub fn decode_rows(b: Bytes) -> Rows / {abort.raise} =
  match bin::decode(b, encoded_rows_bin()) {
    Err(e) -> panic("the saved module data cannot be decoded: " ++ e.message),
    Ok(k) -> {
      let types = types_of(k.types);
      {
        ..k.rows,
        definitions: range(0, k.rows.definitions.len()).map(|i: Int| {
          let row = k.rows.definitions.get(i);
          { ..row, scheme: { ..row.scheme, ty: types.get(k.at.get(i)) } }
        }),
      }
    },
  }

pub fn rows_of(analysis: Analysis) -> Rows / {abort.raise} =
  rows_from(analysis.checked, analysis.hashes)

pub fn inferred_facts(analysis: Analysis) -> InferredFacts / {abort.raise} =
  inferred_facts_of(analysis.modules.map(|parsed: ParsedModule| parsed.name), analysis.checked)

pub type LoweringTargets = { roots: Map<Bytes, Bool>, modules: Map<Bytes, Bool> }

pub fn lowers(lowered: Option<Map<Bytes, Bool>>, module: Bytes) -> Bool =
  match lowered { None -> true, Some(m) -> m.contains(module) }

type GatheredFacts = { facts: BodyFacts, missing: Option<Bytes> }

fn joined_facts(g: BodyFacts, f: BodyFacts) -> BodyFacts =
  {
    members: g.members.concat(f.members),
    types: types_joined(g.types, f.types),
    bodies: g.bodies.concat(f.bodies),
  }

fn gathered(
  g: GatheredFacts,
  owner: Bytes,
  recorded: Option<Bytes>,
  module: Int,
) -> GatheredFacts / {abort.raise} =
  match g.missing {
    Some(_) -> g,
    None -> match recorded {
      None -> { ..g, missing: Some(owner) },
      Some(bytes) -> match decode_facts(bytes, module, owner) {
        None -> { ..g, missing: Some(owner) },
        Some(f) -> { ..g, facts: joined_facts(g.facts, f) },
      },
    },
  }

pub fn facts_read(
  rows: Rows,
  w: InferredFacts,
  wanted: Option<LoweringTargets>,
  modules: List<ParsedModule>,
) -> Result<EmitFacts, Bytes> / {abort.raise} = {
  let here = range(0, modules.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
    accumulator.insert(modules.get(i).name, i));
  let moved = range(0, w.modules.len()).fold(Map::new(), |accumulator: Map<Int, Int>, i: Int|
    match here.get(w.modules.get(i)) { Some(j) -> accumulator.insert(i, j), None -> accumulator });
  let definitions = rows.definitions.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, row: KnownDefinitionRow|
      accumulator.insert(row.name, row.facts),
  );
  let tests = rows.tests.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, row: KnownTestRow|
    accumulator.insert(row.owner, row.body_facts));
  let loose = w.law_facts.fold(
    { ..no_body_facts(), types: rows.types },
    |accumulator: BodyFacts, l: { owner: Bytes, facts: BodyFacts }| {
      let f = l.facts;
      joined_facts(accumulator, {
        members: f.members.fold([], |a: List<MemberSite>, x: MemberSite|
          match moved.get(x.module) { Some(j) -> a.push({ ..x, module: j }), None -> a }),
        types: f.types,
        bodies: f.bodies.fold([], |a: List<TypedBody<Bytes>>, x: TypedBody<Bytes>|
          match moved.get(x.module) { Some(j) -> a.push({ ..x, module: j }), None -> a }),
      })
    },
  );
  let roots = match wanted { None -> None, Some(x) -> Some(x.roots) };
  let lowered = match wanted { None -> None, Some(x) -> Some(x.modules) };
  let read = range(0, modules.len()).fold(
    { facts: loose, missing: None },
    |g: GatheredFacts, i: Int| {
      let m = modules.get(i);
      if !lowers(lowered, m.name) { g } else {
        m.module.items.fold(g, |accumulator: GatheredFacts, item: Item|
          match item {
            FunctionItem(d) -> {
              let owner = qualify(m.name, d.name.name);
              if !wants(roots, owner) { accumulator }
              else { gathered(accumulator, owner, definitions.get(owner), i) }
            },
            TestItem(d) -> {
              let owner = test_owner(m.name, d.name);
              if !wants(roots, owner) { accumulator }
              else { gathered(accumulator, owner, tests.get(owner), i) }
            },
            _ -> accumulator,
          })
      }
    },
  );
  match read.missing {
    Some(owner) ->
      Err(
        Bytes::concat_all([
          b"the checked program has no definitions for `",
          owner,
          b"`, so the program cannot be lowered",
        ]),
      ),
    None ->
      Ok({
        pure: w.pure,
        orders: w.orders.fold([], |accumulator: List<WitnessOrder>, x: WitnessOrder|
          match moved.get(x.module) {
            Some(j) -> accumulator.push({ ..x, module: j }),
            None -> accumulator,
          }),
        members: read.facts.members,
        types: read.facts.types,
        bodies: read.facts.bodies,
      }),
  }
}

pub fn wants(wanted: Option<Map<Bytes, Bool>>, name: Bytes) -> Bool =
  match wanted { None -> true, Some(m) -> m.contains(name) }

pub type Identity = | ByHashes(List<Bytes>) | ByName(Bytes)

pub type InterfaceType =
  | TypeVariable(Int)
  | Constructed({ named: Identity, args: List<InterfaceType> })
  | Function({ params: List<InterfaceType>, keep_parameters: List<Int>, once: Bool, return_type: InterfaceType, effects: InterfaceEffects })
  | RecordOf(List<InterfaceField>)
  | NominalOf({ named: Identity, args: List<InterfaceType> })

pub type InterfaceField = { name: Bytes, ty: InterfaceType }

pub type InterfaceEffect = {
  effect: Identity,
  resource: Resource,
  mode: Mode,
  operation: Option<Bytes>,
}

pub type InterfaceEffects = { listed: List<InterfaceEffect>, variable: Option<Int> }

pub type DefinitionInterface = {
  type_variables: List<Int>,
  effect_variables: List<Int>,
  keep_variables: List<Int>,
  label_variables: List<Int>,
  ty: InterfaceType,
  effects: List<InterfaceEffect>,
}

derive bin for Identity

derive bin for InterfaceType

derive bin for InterfaceField

derive bin for InterfaceEffect

derive bin for InterfaceEffects

derive bin for DefinitionInterface

pub fn declared_hashes(hashes: HashOutput) -> Map<Bytes, List<Bytes>> =
  hashes.declarations.fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Bytes>>, d: { name: Bytes, hash: Bytes }|
      accumulator.insert(d.name, match accumulator.get(d.name) {
        Some(hs) -> hs.push(d.hash),
        None -> [d.hash],
      }),
  )

pub fn definition_interface_of(
  declarations: Map<Bytes, List<Bytes>>,
  definition_info: DefinitionInfo,
) -> DefinitionInterface / {abort.raise} = {
  let c = canonical_beside(definition_info.scheme, [definition_info.effects]);
  {
    type_variables: c.scheme.type_variables,
    effect_variables: c.scheme.effect_variables,
    keep_variables: c.scheme.keep_variables,
    label_variables: c.scheme.label_variables,
    ty: interface_type(declarations, c.scheme.ty),
    effects: match c.effect_lists.at(0) {
      Some(effects) -> effects.map(|a: Effect| interface_effect(declarations, a)),
      None -> [],
    },
  }
}

fn identity(declarations: Map<Bytes, List<Bytes>>, name: Bytes) -> Identity =
  match declarations.get(name) { Some(hs) -> ByHashes(hs), None -> ByName(name) }

fn interface_effect(declarations: Map<Bytes, List<Bytes>>, a: Effect) -> InterfaceEffect =
  {
    effect: identity(declarations, a.effect),
    resource: a.resource,
    mode: a.mode,
    operation: a.operation,
  }

fn interface_type(
  declarations: Map<Bytes, List<Bytes>>,
  ty: Type,
) -> InterfaceType / {abort.raise} = {
  let fields = |fs: List<Field>|
    fs.map(|f: Field| { name: f.name, ty: interface_type(declarations, f.ty) });
  match ty {
    VariableType(v) -> TypeVariable(v),
    NamedType(c) ->
      Constructed({
        named: identity(declarations, c.name),
        args: c.args.map(|a: Type| interface_type(declarations, a)),
      }),
    FunctionType(f) ->
      Function({
        params: f.params.map(|p: Type| interface_type(declarations, p)),
        keep_parameters: f.keep_parameters,
        once: f.once,
        return_type: interface_type(declarations, f.return_type),
        effects: {
          listed: f.effects.listed.map(|a: Effect| interface_effect(declarations, a)),
          variable: f.effects.variable,
        },
      }),
    RecordType(fs) -> RecordOf(fields(fs)),
    NominalType(n) ->
      NominalOf({
        named: identity(declarations, n.name),
        args: n.args.map(|a: Type| interface_type(declarations, a)),
      }),
  }
}

fn interface_digest_prefix() -> Bytes = b"ply.interface.1"

pub fn interface_digest(i: DefinitionInterface) -> Bytes / {abort.raise} =
  blake3(interface_digest_prefix().concat(bin::encode(i, definition_interface_bin())))

pub type StoredBody = { hash: Bytes, body: Bytes }

pub type PublishedInterface = { name: Bytes, hash: Bytes, interface: Bytes }

pub fn interfaces_of(
  checked: CheckOutput,
  hashes: HashOutput,
) -> List<PublishedInterface> / {abort.raise} = {
  let hashed = by_name(hashes.definitions);
  let declarations = declared_hashes(hashes);
  checked.definitions.fold(
    [],
    |accumulator: List<PublishedInterface>, definition_info: DefinitionInfo|
      match hashed.get(definition_info.name) {
        Some(h) ->
          accumulator.push({
            name: definition_info.name,
            hash: h,
            interface: interface_digest(definition_interface_of(declarations, definition_info)),
          }),
        None -> accumulator,
      },
  )
}

pub fn stored_bodies(hashes: HashOutput) -> List<StoredBody> / {abort.raise} = {
  let definitions = by_name(hashes.definitions);
  let declarations = by_name(hashes.declarations);
  let counted = hashes.bodies.fold(
    Map::new(),
    |accumulator: Map<Bytes, Int>, b: { name: Bytes, body: Bytes }|
      accumulator.insert(b.name, match accumulator.get(b.name) { Some(n) -> n + 1, None -> 1 }),
  );
  let listed = |h: Option<Bytes>| match h { Some(x) -> [x], None -> [] };
  hashes.bodies.fold([], |accumulator: List<StoredBody>, b: { name: Bytes, body: Bytes }|
    if b.body.len() == 0 { accumulator } else {
      let alone = match counted.get(b.name) { Some(n) -> n == 1, None -> false };
      listed(definitions.get(b.name)).concat(listed(declarations.get(b.name))).fold(
        accumulator,
        |a: List<StoredBody>, hash: Bytes|
          if alone || body_key(b.body) == Some(hash) { a.push({ hash: hash, body: b.body }) }
          else { a },
      )
    })
}

pub type StubCuts = { name: Bytes, cuts: List<Cut> }

pub fn analyse(parsed: List<ParsedSource>) -> AnalysisOutcome / {abort.raise} =
  analyse_with(parsed, no_rows())

pub fn analyse_with(
  parsed: List<ParsedSource>,
  rows: Rows,
  packages: PackageSources = { root: b"", manifest: None, supplied: [] },
) -> AnalysisOutcome / {abort.raise} = {
  let clo = closure(packages, parsed.map(|p: ParsedSource| p.name));
  let closed = clo.modules.fold(
    parsed,
    |accumulator: List<ParsedSource>, m: { pkg: Int, source: Source }|
      accumulator.push({ ..parse_at(accumulator.len(), m.source), text: m.source.source_text }),
  );
  let all = if closed.any(|p: ParsedSource| p.name == prelude_module()) { closed } else {
    let source = prelude_source::text();
    closed.push(
      untested({
        ..parse_at(closed.len(), { name: prelude_module(), source_text: source }),
        text: source,
      }),
    )
  };
  let texts = all.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, p: ParsedSource|
    accumulator.insert(p.name, p.text));
  let declared = homes_declaring(|h: Bytes| texts.get(h));
  let unimported = if declared.len() == 0 && !texts.contains(scheduler_module()) { Map::new() }
  else {
    missing_imports(all.map(|p: ParsedSource| { name: p.name, source_text: p.text }), declared)
  };
  analyse_closure(
    all,
    clo,
    rows,
    parsed.len(),
    tree_named(parsed.map(|p: ParsedSource| p.name)),
    unimported,
  )
}

pub fn missing_imports(
  sources: List<Source>,
  declared: List<HomeNames>,
) -> Map<Bytes, List<Bytes>> / {abort.raise} =
  sources.fold(Map::new(), |accumulator: Map<Bytes, List<Bytes>>, s: Source|
    accumulator.insert(
      s.name,
      read_without_import(s.name, start(s.source_text).input, || declared),
    ))

fn unimported_in(
  modules: List<ParsedModule>,
  r: Resolution,
  read: Map<Bytes, List<Bytes>>,
) -> List<List<Bytes>> / {abort.raise} = {
  let module_names = modules.fold(Map::new(), |accumulator: Map<Bytes, Bool>, m: ParsedModule|
    accumulator.insert(m.name, true));
  range(0, modules.len()).map(|i: Int|
    unimported_of(
      match read.get(modules.get(i).name) { Some(xs) -> xs, None -> [] },
      |m: Bytes| module_names.contains(m),
      r.imports.get(i).map(|t: Int| modules.get(t).name),
    ))
}

fn with_prelude_module(
  sources: List<Source>,
  packages: List<PackageDependencies>,
  module_packages: List<Int>,
  shipped: Int,
) -> { sources: List<Source>, module_packages: List<Int> } = {
  let read = with_prelude_source(sources);
  {
    sources: read,
    module_packages: if read.len() == sources.len() || packages.len() == 0 { module_packages }
    else { module_packages.push(shipped) },
  }
}

pub fn reserved_prefix_diagnostics(
  own: List<Bytes>,
  listed: List<Bytes>,
) -> List<{ slot: Int, diagnostic: ParseDiagnostic }> / {abort.raise} =
  std_squats(own, toolchain_tree(own, listed))

fn std_squats(
  own: List<Bytes>,
  tree: ToolchainTree,
) -> List<{ slot: Int, diagnostic: ParseDiagnostic }> / {abort.raise} =
  if tree != NoTree { [] } else {
    range(0, own.len()).fold(
      [],
      |accumulator: List<{ slot: Int, diagnostic: ParseDiagnostic }>, i: Int| {
        let n = own.get(i);
        let seg = first_segment(n);
        if seg != b"std" && seg != b"compiler" { accumulator } else {
          accumulator.push({
            slot: 0 - i - 1,
            diagnostic: parse_diagnostic(
              b"E0133",
              Bytes::concat_all([b"`", n, b"` would shadow the built-in package `", seg, b"`"]),
              [
                parse_label(
                  dummy_span(),
                  true,
                  b"this file claims a module under the toolchain's own prefix",
                ),
              ],
              [
                b"`std` and `compiler` name the modules the toolchain ships; rename the file or the directory",
              ],
            ),
          })
        }
      },
    )
  }

pub type HashedProgram = {
  modules: List<ParsedModule>,
  r: Resolution,
  unimported: List<List<Bytes>>,
  index: Index,
  hashes: HashOutput,
  unused: List<Diagnostic>,
  uses: List<UseNode>,
  closure: Closure,
  packages: List<PackageDependencies>,
  module_packages: List<Int>,
  root_count: Int,
  embeds: List<ModuleEmbed>,
  texts: List<Bytes>,
  cuts: Map<Bytes, List<Cut>>,
  embed_items: Map<Bytes, List<ItemEmbeds>>,
}

pub fn hashed_closure(
  parsed: List<ParsedSource>,
  clo: Closure,
  root_count: Int,
  tree: ToolchainTree,
  unimported: Map<Bytes, List<Bytes>>,
  fixed: CachedHashes = { nodes: [], tests: [], laws: [] },
  embeds: List<ModuleEmbed> = [],
  cuts: List<StubCuts> = [],
  checked: Option<Bytes> = None,
) -> Result<HashedProgram, List<Diagnostic>> / {abort.raise} =
  match resolved_closure(parsed, clo, root_count, tree, checked) {
    Err(diagnostics) -> Err(diagnostics),
    Ok(resolved) -> {
      let x = resolved.program;
      let hashed = hashed_and_unused(resolved.index, fixed, resolved.tables.module_packages);
      Ok({
        modules: x.modules,
        r: x.resolution,
        unimported: unimported_in(x.modules, x.resolution, unimported),
        index: resolved.index,
        hashes: hashed.hashes,
        unused: hashed.unused.filter(|diagnostic: Diagnostic|
          diagnostic.labels.any(
            |l: { module: Int, start: Int, end: Int, primary: Bool, text: Bytes }|
              l.primary && l.module < root_count,
          )),
        uses: hashed.uses,
        closure: clo,
        packages: resolved.tables.packages,
        module_packages: resolved.tables.module_packages,
        root_count: root_count,
        embeds: embeds,
        texts: parsed.map(|p: ParsedSource| p.text),
        cuts: cuts.fold(Map::new(), |accumulator: Map<Bytes, List<Cut>>, c: StubCuts|
          accumulator.insert(c.name, c.cuts)),
        embed_items: Map::new(),
      })
    },
  }

pub fn resolved_closure(
  parsed: List<ParsedSource>,
  clo: Closure,
  root_count: Int,
  tree: ToolchainTree,
  checked: Option<Bytes> = None,
) -> Result<{ program: ResolvedProgram, tables: PackageTables, index: Index }, List<Diagnostic>> / {abort.raise} = {
  let package_diagnostics = std_squats(
    parsed.take(root_count).map(|p: ParsedSource| p.name),
    tree,
  ).fold(
    clo.diagnostics,
    |accumulator: List<{ slot: Int, diagnostic: ParseDiagnostic }>, sd: { slot: Int, diagnostic: ParseDiagnostic }|
      accumulator.push(sd),
  );
  let early = parsed.fold([], |accumulator: List<Diagnostic>, p: ParsedSource|
    accumulator.concat(p.diagnostics));
  if package_diagnostics.len() > 0 {
    Err(
      package_diagnostics.map(|sd: { slot: Int, diagnostic: ParseDiagnostic }|
        if sd.slot < 0 { diagnostic_in_module(0 - sd.slot - 1, sd.diagnostic) }
        else { diagnostic_in_module(parsed.len() + sd.slot, sd.diagnostic) }),
    )
  } else if early.len() > 0 { Err(early) } else {
    let tables = package_tables(parsed.map(|p: ParsedSource| p.name), root_count, clo, tree);
    match resolve_packaged(
        parsed.map(|p: ParsedSource| p.module),
        tables.packages,
        tables.module_packages,
        tables.std,
        tables.compiler,
        tables.other_shipped_package,
      ) {
      ResolveFailed(ds) -> Err(ds.map(outside_every_module)),
      ResolveSucceeded(resolved) -> {
        let x = match checked {
          Some(_) -> { ..resolved, resolution: make_all_visible(resolved.resolution) },
          None -> resolved,
        };
        let built = build_index(x.modules, x.resolution);
        if built.diagnostics.len() > 0 { Err(built.diagnostics.map(outside_every_module)) }
        else { Ok({ program: x, tables: tables, index: built.index }) }
      },
    }
  }
}

pub fn checked_closure(
  h: HashedProgram,
  rows: Rows,
  walks: BodyChecking,
) -> AnalysisOutcome / {abort.raise} = {
  let out = check_output_with(h.r, h.modules, {
    ..cache_from_rows(rows, h.root_count),
    body_checking: walks,
  });
  let checked: CheckOutput = out.checked;
  if !checked.ok { Rejected(checked.diagnostics.map(outside_every_module)) } else {
    Analysed({
      modules: h.modules,
      r: h.r,
      unimported: h.unimported,
      checked: checked,
      index: h.index,
      hashes: {
        let cached_sites = cached_member_sites(h.modules, checked);
        checked_hashes(
          h.hashes,
          checked.facts.members.concat(cached_sites.sites),
          cached_sites.unread,
          checked.tests.fold(Map::new(), |accumulator: Map<Bytes, Bool>, t: TestInfo|
            if cached_sites.unread.contains(test_owner(t.module, t.name)) {
              accumulator.insert(t.key, true)
            } else { accumulator }),
        )
      },
      warnings: h.unused.map(outside_every_module).concat(checked.warnings),
      uses: h.uses,
      manifest: h.closure.packages.get(0).manifest,
      packages: h.packages,
      locked_packages: pins_of(h.closure, h.embeds),
      module_packages: h.module_packages,
      stub_cuts: h.cuts,
      embeds: h.embeds,
      embed_items: h.embed_items,
      bodies: out.bodies,
    })
  }
}

fn cached_member_sites(
  modules: List<ParsedModule>,
  checked: CheckOutput,
) -> { sites: List<MemberSite>, unread: Map<Bytes, Bool> } / {abort.raise} = {
  let cached_facts = checked.cached.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, k: CachedFacts| accumulator.insert(k.name, k.facts),
  );
  let read = range(0, modules.len()).fold(
    { sites: [], placed: Map::new() },
    |accumulator: { sites: List<MemberSite>, placed: Map<Bytes, Bool> }, i: Int| {
      let m = modules.get(i);
      m.module.items.fold(
        accumulator,
        |a: { sites: List<MemberSite>, placed: Map<Bytes, Bool> }, item: Item| {
          let at = match item {
            FunctionItem(d) -> Some({ owner: qualify(m.name, d.name.name) }),
            TestItem(d) -> Some({ owner: test_owner(m.name, d.name) }),
            _ -> None,
          };
          match at {
            None -> a,
            Some(x) -> match cached_facts.get(x.owner) {
              None -> a,
              Some(recorded) -> match decode_facts(recorded, i, x.owner) {
                None -> a,
                Some(f) ->
                  { sites: a.sites.concat(f.members), placed: a.placed.insert(x.owner, true) },
              },
            },
          }
        },
      )
    },
  );
  {
    sites: read.sites,
    unread: checked.seeded.concat(
      checked.tests.fold([], |accumulator: List<Bytes>, t: TestInfo|
        if checked.cached_tests.contains(t.key) { accumulator.push(test_owner(t.module, t.name)) }
        else { accumulator }),
    ).fold(Map::new(), |accumulator: Map<Bytes, Bool>, n: Bytes|
      if read.placed.contains(n) { accumulator } else { accumulator.insert(n, true) }),
  }
}

fn analyse_closure(
  parsed: List<ParsedSource>,
  clo: Closure,
  rows: Rows,
  root_count: Int,
  tree: ToolchainTree,
  unimported: Map<Bytes, List<Bytes>>,
) -> AnalysisOutcome / {abort.raise} =
  match hashed_closure(parsed, clo, root_count, tree, unimported) {
    Err(diagnostics) -> Rejected(diagnostics),
    Ok(h) -> match if parsed.take(root_count).any(|p: ParsedSource| p.name == prelude_module()) {
        None
      } else { prune_prelude(parsed, h) } {
      None -> checked_closure(h, rows, CheckEvery),
      Some(cut) -> match hashed_closure(cut, clo, root_count, tree, unimported) {
        Err(diagnostics) -> Rejected(diagnostics),
        Ok(pruned) -> checked_closure(pruned, rows, CheckEvery),
      },
    },
  }

fn prune_prelude(
  parsed: List<ParsedSource>,
  h: HashedProgram,
) -> Option<List<ParsedSource>> / {abort.raise} = {
  let own = |name: Bytes| module_of_name(name) == prelude_module();
  let roots = h.hashes.definitions.fold(
    [],
    |accumulator: List<Subject>, d: { name: Bytes, hash: Bytes }|
      if own(d.name) { accumulator } else { accumulator.push(FunctionNamed(d.name)) },
  ).concat(
    h.index.nodes.fold([], |accumulator: List<Subject>, n: Node|
      match n.body { NodeFn(_) -> accumulator, _ -> accumulator.push(DeclarationNamed(n.name)) }),
  ).concat(
    h.index.tests.map(|t: TestNode| ItemKeyed(t.key)),
  ).concat(
    h.index.laws.map(|l: LawNode| ItemKeyed(l.key)),
  );
  let reach = reachable_functions(h.hashes, roots);
  let is_reachable = |p: ParsedSource, item: Item|
    match item { FunctionItem(d) -> reach.contains(qualify(p.name, d.name.name)), _ -> true };
  if !parsed.any(|p: ParsedSource|
      p.name == prelude_module()
        && p.module.module.items.any(|item: Item| !is_reachable(p, item))) { None } else {
    Some(
      parsed.map(|p: ParsedSource|
        if p.name != prelude_module() { p } else {
          {
            ..p,
            module: {
              ..p.module,
              module: {
                ..p.module.module,
                items: p.module.module.items.filter(|item: Item| is_reachable(p, item)),
              },
            },
          }
        }),
    )
  }
}

pub fn runtime_dump(d: Dump) -> Dump =
  {
    ..d,
    diagnostics: [],
    order: [],
    packages: [],
    pins: [],
    module_packages: [],
    constructors: [],
    keys: [],
    bodies: [],
    embeds: [],
    rows: no_rows(),
    inferred_facts: b"",
  }

type ReachSearch = { seen: Map<Bytes, Bool>, frontier: List<Bytes> }

fn reachable_names(hashes: List<HashTableRow>, entry: Bytes) -> Map<Bytes, Bool> / {abort.raise} = {
  let dependencies = hashes.fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Bytes>>, frame: HashTableRow|
      match frame {
        DefinitionHashRow(row) -> accumulator.insert(row.name, row.dependencies),
        _ -> accumulator,
      },
  );
  iterate(
    { seen: Map::new().insert(entry, true), frontier: [entry] },
    hashes.len() + 2,
    |w: ReachSearch|
      if w.frontier.len() == 0 { Stop(w.seen) } else {
        Continue(
          w.frontier.fold(
            { seen: w.seen, frontier: [] },
            |accumulator: ReachSearch, name: Bytes|
              List::fold(
                match dependencies.get(name) { Some(qualified_code) -> qualified_code, None -> [] },
                accumulator,
                |met: ReachSearch, dependency: Bytes|
                  if met.seen.contains(dependency) { met } else {
                    {
                      seen: met.seen.insert(dependency, true),
                      frontier: met.frontier.push(dependency),
                    }
                  },
              ),
          ),
        )
      },
  )
}

fn reachable_definitions(hashes: List<HashTableRow>, entry: Bytes) -> Bytes / {abort.raise} = {
  let reachable = reachable_names(hashes, entry);
  let reachable_hashes = hashes.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, frame: HashTableRow|
      match frame {
        DefinitionHashRow(row) -> match row.definition {
          Some(h) -> if reachable.contains(row.name) { accumulator.insert(row.name, h) }
          else { accumulator },
          None -> accumulator,
        },
        _ -> accumulator,
      },
  );
  Bytes::concat_all(
    reachable_hashes.fold([], |lines: List<Bytes>, name: Bytes, h: Bytes|
      lines.push(Bytes::concat_all([name, b" ", h, b"\n"]))),
  )
}

pub fn entry_header(d: Dump, entry: Bytes) -> Option<Bytes> / {abort.raise} =
  match ((
      d.definitions.find(|row: DefinitionRow| row.name == entry),
      d.emitter_roots.find(|root: EmitterRoot| root.root == entry),
    )) {
    (Some(_), Some(_)) ->
      Some(
        Bytes::concat_all([b"ply entry 1\n", entry, b"\n", reachable_definitions(d.hashes, entry)]),
      ),
    _ -> None,
  }

pub fn dump_of(outcome: AnalysisOutcome) -> Dump / {abort.raise} =
  match outcome {
    Rejected(ds) ->
      {
        diagnostics: ds.map(normalized_diagnostic),
        order: [],
        packages: [],
        pins: [],
        module_packages: [],
        modules: [],
        definitions: [],
        types: [],
        tests: [],
        laws: [],
        effects: [],
        constructors: [],
        hashes: [],
        hashes_digest: b"",
        keys: [],
        emitter_roots: [],
        emitter_constructors: [],
        ordinals: [],
        bodies: [],
        embeds: [],
        rows: no_rows(),
        inferred_facts: b"",
        derived: [],
      },
    Analysed(w) -> view_dump(checked_program_of(w), None),
  }

pub type BuiltinRow = {
  name: Bytes,
  scheme: Scheme,
  params: List<Bytes>,
  constraint_parameters: Int,
}

pub fn builtin_rows() -> List<BuiltinRow> / {abort.raise} =
  builtins().filter(|b: Builtin| !b.body).map(|b: Builtin| row_of(b.name, b))

pub fn shipped_builtin_rows(shipped: List<Source>) -> List<BuiltinRow> / {abort.raise} =
  shipped.fold(builtin_rows(), |accumulator: List<BuiltinRow>, s: Source|
    accumulator.concat(
      natives_of(s.name, parse(s.source_text).node).map(|e: { own: Bytes, builtin: Builtin }|
        row_of(e.own, e.builtin)),
    ))

fn row_of(name: Bytes, b: Builtin) -> BuiltinRow =
  {
    name: name,
    scheme: b.scheme,
    params: b.params.map(|p: ParameterMode| p.name),
    constraint_parameters: witness_params(b.constraints).len(),
  }

pub type Claim =
  | ClaimDefinition({ name: Bytes, params: Int, cost_parameters: List<Int>, spaced: List<Int>, body: Option<Code>, spec: List<ClaimClause>, measure: Option<Code>, ends: Bool, stated: Bool })
  | ClaimSum({ name: Bytes, variants: Int })
  | ClaimLaw({ key: Bytes, guard: Option<LoweredClause>, body: Code })

pub type LoweredClause = { at: ModuleSpan, code: Code }

pub type ClaimClause = { kind: SpecKind, clause: LoweredClause }

type Resolved = Map<Bytes, List<TypedBody<Type>>>

fn resolved_by_owner(bodies: List<TypedBody<Type>>) -> Resolved =
  bodies.fold(Map::new(), |m: Resolved, b: TypedBody<Type>|
    m.insert(b.owner, match m.get(b.owner) { Some(xs) -> xs.push(b), None -> [b] }))

fn lowered_part(
  resolved: Resolved,
  owner: Bytes,
  part: BodyPart,
  base: Int,
  labels: List<Bytes> = [],
) -> Option<Code> / {abort.raise} =
  match resolved_at(resolved, owner, part, base) {
    None -> None,
    Some(b) -> {
      let l = lower_function(b.params, labels, b.body);
      if l.failed.len() > 0 { None } else { Some(l.code) }
    },
  }

fn resolved_at(
  resolved: Resolved,
  owner: Bytes,
  part: BodyPart,
  base: Int,
) -> Option<TypedBody<Type>> / {abort.raise} =
  match match resolved.get(owner) {
      Some(bs) -> bs.find(|b: TypedBody<Type>| b.part == part),
      None -> None,
    } {
    None -> None,
    Some(b) ->
      Some(
        body_retyped(without_witnesses(b), (), {
          ty: |t: Type, u: Unit| { ty: t, state: u },
          effects: |r: Effects| r,
          entry: |a: Effect| a,
          span: |span: Span| moved_by(span, base),
        }).out,
      ),
  }

pub fn prover_modelled() -> Map<Bytes, Bool> / {abort.raise} =
  builtins().fold(Map::new(), |m: Map<Bytes, Bool>, b: Builtin|
    match prelude_callback_use(b.name) { Some(_) -> m, None -> m.insert(b.name, true) })

pub fn prover_builtin(modelled: Map<Bytes, Bool>, full: Bytes) -> Option<Bytes> =
  match prelude_own(full) {
    Some(name) -> if modelled.contains(name) { Some(name) } else { None },
    None -> None,
  }

fn prelude_builtins(modelled: Map<Bytes, Bool>, b: TypedBody<Type>) -> TypedBody<Type> =
  {
    ..b,
    body: typed_expression_nodes_mapped(b.body, |e: TypedExpression<Type>|
      match e.node {
        TypedRead(ReadDefinition(d)) -> match prover_builtin(modelled, d.full) {
          Some(name) ->
            {
              ..e,
              node: TypedRead(
                ReadBuiltin({
                  name: name,
                  args: d.args,
                  effect_arguments: d.effect_arguments,
                  witnesses: [],
                }),
              ),
            },
          None -> e,
        },
        _ -> e,
      }),
  }

fn clause_claimed(c: Option<Code>) -> Code / {abort.raise} =
  match c {
    Some(x) -> x,
    None -> panic("the checker did not resolve a clause of this function definition"),
  }

fn definition_claim(
  resolved: Resolved,
  m: Int,
  module: Bytes,
  definition: FnDefinition,
  opaque: Bool,
  ends: Bool,
  stated: Bool,
) -> Claim / {abort.raise} = {
  let full = qualify(module, definition.name.name);
  let labels = definition.generics.labels.map(|i: Identifier| i.name);
  let code = |part: BodyPart| lowered_part(resolved, full, part, definition.span.start, labels);
  let costed = range(0, definition.params.len()).filter(|i: Int|
    definition.params.get(i).cost != None);
  let spaced = range(0, definition.params.len()).filter(|i: Int|
    definition.params.get(i).space != None);
  let shown = !opaque || definition.transparent != None;
  ClaimDefinition({
    name: full,
    ends: ends,
    stated: stated,
    params: definition.params.len(),
    cost_parameters: costed,
    spaced: spaced,
    body: if shown { code(WholeBody) } else { None },
    measure: match definition.decreases {
      Some(_) -> if shown { code(MeasureBody) } else { None },
      None -> None,
    },
    spec: range(0, definition.spec.len()).map(|i: Int| {
      let clause = definition.spec.get(i);
      {
        kind: clause.kind,
        clause: {
          at: span_at(m, expression_span(clause.expression)),
          code: clause_claimed(code(ClauseBody(i))),
        },
      }
    }),
  })
}

fn given_opt(c: Option<Code>, given: Map<Int, Code>) -> Option<Code> =
  match c { Some(x) -> Some(given_in(x, given)), None -> None }

fn given_fields(fs: List<CodeField>, given: Map<Int, Code>) -> List<CodeField> =
  fs.map(|field: CodeField| { name: field.name, value: given_in(field.value, given) })

fn split_given_captures(
  captures: List<Capture>,
  given: Map<Int, Code>,
) -> { captures: List<Capture>, given: Map<Int, Code> } =
  captures.fold(
    { captures: [], given: Map::new() },
    |accumulator: { captures: List<Capture>, given: Map<Int, Code> }, capture: Capture|
      match given.get(capture.source) {
        Some(c) -> { ..accumulator, given: accumulator.given.insert(capture.destination, c) },
        None -> { ..accumulator, captures: accumulator.captures.push(capture) },
      },
  )

fn given_in(c: Code, given: Map<Int, Code>) -> Code = {
  let g = |x: Code| given_in(x, given);
  let gs = |codes: List<Code>| codes.map(|x: Code| given_in(x, given));
  match c.node {
    CodeLiteral(_) -> c,
    CodeLabel(_) -> c,
    CodeVariable(v) -> match given.get(v.slot) { Some(x) -> x, None -> c },
    NDefinition(_) -> c,
    NConstructor(_) -> c,
    NBuiltin(_) -> c,
    CodeUnary(u) -> { ..c, node: CodeUnary({ operation: u.operation, operand: g(u.operand) }) },
    CodeBinary(b) ->
      {
        ..c,
        node: CodeBinary({
          operation: b.operation,
          left_operand: g(b.left_operand),
          right_operand: g(b.right_operand),
        }),
      },
    CodeApply(a) -> { ..c, node: CodeApply({ ..a, function: g(a.function), args: gs(a.args) }) },
    CodeKnownLambda(_) -> c,
    CodeIf(i) ->
      {
        ..c,
        node: CodeIf({
          cond: g(i.cond),
          then_branch: g(i.then_branch),
          else_branch: g(i.else_branch),
        }),
      },
    CodeBlock(b) ->
      {
        ..c,
        node: CodeBlock({
          statements: b.statements.map(|statement: CodeStatement|
            match statement {
              CodeLet(l) -> CodeLet({ name: l.name, slot: l.slot, value: g(l.value) }),
              CodeLetDestructure(l) ->
                CodeLetDestructure({ span: l.span, pattern: l.pattern, value: g(l.value) }),
              CodeDo(d) -> CodeDo({ code: g(d.code) }),
            }),
          tail: given_opt(b.tail, given),
        }),
      },
    CodeList(l) -> { ..c, node: CodeList({ items: gs(l.items) }) },
    CodeRecord(record) -> { ..c, node: CodeRecord({ fields: given_fields(record.fields, given) }) },
    CodeMatch(x) ->
      {
        ..c,
        node: CodeMatch({
          scrutinee: g(x.scrutinee),
          arms: x.arms.map(|a: CodeArm|
            { pattern: a.pattern, guard: given_opt(a.guard, given), body: g(a.body) }),
        }),
      },
    CodePerform(p) ->
      { ..c, node: CodePerform({ ..p, label: given_opt(p.label, given), args: gs(p.args) }) },
    CodeLambda(l) -> {
      let past = split_given_captures(l.captures, given);
      {
        ..c,
        node: CodeLambda({ ..l, captures: past.captures, body: given_in(l.body, past.given) }),
      }
    },
    CodeSimulate(x) -> {
      let past = split_given_captures(x.captures, given);
      {
        ..c,
        node: CodeSimulate({ ..x, captures: past.captures, body: given_in(x.body, past.given) }),
      }
    },
    CodeParallel(x) -> { ..c, node: CodeParallel({ ..x, branches: gs(x.branches) }) },
    CodeHandle(h) ->
      {
        ..c,
        node: CodeHandle({
          ..h,
          body: g(h.body),
          clauses: h.clauses.map(|clause: CodeClause| {
            let past = split_given_captures(clause.captures, given);
            { ..clause, captures: past.captures, body: given_in(clause.body, past.given) }
          }),
          return_clause: match h.return_clause {
            Some(x) -> {
              let past = split_given_captures(x.captures, given);
              Some({ ..x, captures: past.captures, body: given_in(x.body, past.given) })
            },
            None -> None,
          },
        }),
      },
    CodeFieldRead(f) -> { ..c, node: CodeFieldRead({ base: g(f.base), field: f.field }) },
    CodeUpdate(u) ->
      {
        ..c,
        node: CodeUpdate({
          base: g(u.base),
          copied_fields: u.copied_fields,
          sets: given_fields(u.sets, given),
        }),
      },
  }
}

fn function_named(module: Module, name: Bytes) -> Option<FnDefinition> =
  module.items.fold(None, |found: Option<FnDefinition>, item: Item|
    match found {
      Some(_) -> found,
      None -> match item {
        FunctionItem(d) -> if d.name.name == name { Some(d) } else { None },
        _ -> None,
      },
    })

fn instantiated(
  modules: List<ParsedModule>,
  resolved: Resolved,
  binders: Int,
  of: SchemaInstance,
  call: TypedExpression<Type>,
) -> Option<Code> / {abort.raise} =
  match ((call.node, home_of(modules, of))) {
    (TypedCall(a), Some(home)) -> match a.callee.node {
      TypedRead(ReadDefinition(callee)) -> match function_named(
          modules.get(home).module,
          default_binder(callee.full),
        ) {
        None -> None,
        Some(definition) -> match resolved_at(
            resolved,
            callee.full,
            WholeBody,
            definition.span.start,
          ) {
          None -> None,
          Some(b) -> {
            let params = definition.params.len() - binders;
            let l = lower_function(b.params.drop(params).concat(b.params.take(params)), [], b.body);
            let given = range(0, params).fold(
              Some(Map::new()),
              |accumulator: Option<Map<Int, Code>>, k: Int|
                match ((accumulator, a.args.at(k))) {
                  (Some(substitutions), Some(arg)) -> {
                    let x = lower_function([], [], arg);
                    if x.failed.len() > 0 { None }
                    else { Some(substitutions.insert(binders + k, x.code)) }
                  },
                  _ -> None,
                },
            );
            match given {
              Some(substitutions) -> if l.failed.len() > 0 { None }
              else { Some(given_in(l.code, substitutions)) },
              None -> None,
            }
          },
        },
      },
      _ -> None,
    },
    _ -> None,
  }

fn law_statement(
  modules: List<ParsedModule>,
  resolved: Resolved,
  owner: Bytes,
  law_definition: LawDefinition,
  part: BodyPart,
) -> Option<Code> / {abort.raise} =
  match law_definition.of {
    Some(of) -> match resolved_at(resolved, owner, part, law_definition.span.start) {
      Some(b) -> match instantiated(modules, resolved, law_definition.binders.len(), of, b.body) {
        Some(w) -> Some(w),
        None -> lowered_part(resolved, owner, part, law_definition.span.start),
      },
      None -> None,
    },
    None -> lowered_part(resolved, owner, part, law_definition.span.start),
  }

fn law_claim(
  modules: List<ParsedModule>,
  resolved: Resolved,
  m: Int,
  module: Bytes,
  law_definition: LawDefinition,
) -> Claim / {abort.raise} = {
  let owner = law_owner(module, law_definition.name);
  ClaimLaw({
    key: qualify(module, law_definition.name),
    guard: match law_definition.guard {
      Some(g) ->
        Some({
          at: span_at(m, expression_span(g)),
          code: clause_claimed(
            law_statement(modules, resolved, owner, law_definition, typed::LawGuard),
          ),
        }),
      None -> None,
    },
    body: clause_claimed(law_statement(modules, resolved, owner, law_definition, typed::LawBody)),
  })
}

fn claims_of_modules(
  modules: List<ParsedModule>,
  bodies: List<TypedBody<Type>>,
  wanted: List<Int>,
  opaque: (Bytes) -> Bool,
  ends: Map<Bytes, Bool>,
  stated: Map<Bytes, Bool>,
) -> List<Claim> / {abort.raise} = {
  let modelled = prover_modelled();
  let resolved = resolved_by_owner(
    bodies.map(|b: TypedBody<Type>| prelude_builtins(modelled, without_releases(b))),
  );
  wanted.fold([], |accumulator: List<Claim>, i: Int| {
    let m = modules.get(i);
    m.module.items.fold(accumulator, |a: List<Claim>, item: Item|
      match item {
        FunctionItem(d) -> {
          let name = qualify(m.name, d.name.name);
          a.push(
            definition_claim(
              resolved,
              i,
              m.name,
              d,
              opaque(m.name),
              ends.contains(name),
              stated.contains(name),
            ),
          )
        },
        TypeItem(d) -> match d.body {
          SumBody(vs) ->
            a.push(ClaimSum({ name: qualify(m.name, d.name.name), variants: vs.len() })),
          _ -> a,
        },
        LawItem(d) -> a.push(law_claim(modules, resolved, i, m.name, d)),
        _ -> a,
      })
  })
}

pub fn claims(
  given: List<Source>,
  packages: List<PackageDependencies> = [],
  given_packages: List<Int> = [],
  shipped: Int = 0,
) -> List<Claim> / {abort.raise} = {
  let read = with_prelude_module(given, packages, given_packages, shipped);
  let module_packages = read.module_packages;
  let modules = parse_all(read.sources).map(|parsed: ParsedSource| parsed.module);
  let packaged = if packages.len() == 0 { no_packages(modules) } else {
    {
      packages: packages,
      module_packages: module_packages,
      std: shipped - 2,
      compiler: shipped - 1,
      other_shipped_package: shipped,
    }
  };
  match resolve_packaged(
      modules,
      packaged.packages,
      packaged.module_packages,
      packaged.std,
      packaged.compiler,
      packaged.other_shipped_package,
    ) {
    ResolveFailed(_) -> panic("a program the front end accepted fails name resolution"),
    ResolveSucceeded(x) -> match elaborate(x.resolution, x.modules) {
      None -> panic("a program the front end accepted fails type checking"),
      Some(e) ->
        claims_of_modules(
          x.modules,
          e.bodies,
          range(0, given.len()),
          |m: Bytes| false,
          e.ends,
          e.stated,
        ),
    },
  }
}

pub fn claims_in(
  analysis: Analysis,
  wanted: List<Int>,
  owned: (Bytes) -> Bool = |m: Bytes| true,
) -> List<Claim> / {abort.raise} = {
  let bodies = match facts_read(
      rows_of(analysis),
      inferred_facts(analysis),
      None,
      analysis.modules,
    ) {
    Ok(facts) -> bodies_read(facts.bodies, facts.types),
    Err(_) -> rechecked(analysis, wanted),
  };
  claims_of_modules(
    analysis.modules,
    bodies,
    wanted,
    |m: Bytes| !owned(m),
    terminating_definitions(analysis.checked.definitions),
    measured_definitions(analysis.checked.definitions),
  )
}

pub fn rechecked(analysis: Analysis, wanted: List<Int>) -> List<TypedBody<Type>> / {abort.raise} = {
  let walked = wanted.fold(Map::new(), |accumulator: Map<Bytes, Bool>, i: Int| {
    let m = analysis.modules.get(i);
    m.module.items.fold(accumulator, |a: Map<Bytes, Bool>, item: Item|
      match item { FunctionItem(d) -> a.insert(qualify(m.name, d.name.name), true), _ -> a })
  });
  let rows = rows_of(analysis);
  let known = cache_from_rows(
    {
      definitions: rows.definitions.filter(|row: KnownDefinitionRow| !walked.contains(row.name)),
      tests: rows.tests,
      types: rows.types,
    },
    0,
  );
  match bodies_with(analysis.r, analysis.modules, known) {
    None -> panic("a program the front end accepted fails type checking"),
    Some(bodies) -> bodies,
  }
}

pub fn untested(p: ParsedSource) -> ParsedSource =
  {
    ..p,
    module: {
      ..p.module,
      module: {
        ..p.module.module,
        items: p.module.module.items.filter(|item: Item|
          match item { TestItem(_) -> false, LawItem(_) -> false, _ -> true }),
      },
    },
  }

fn size_over(home: Bytes, declared: Bytes) -> Bytes / {abort.raise} = {
  let source = Bytes::concat_all([
    b"import ",
    home,
    b"\npub fn size(s: ",
    home,
    b"::Shape) -> Int / {",
    home,
    b"::log.write} = { ",
    home,
    b"::log.put(1); 1 }\n",
  ]);
  match analyse(
      parse_all([{ name: b"m", source_text: source }, { name: home, source_text: declared }]),
    ) {
    Rejected(_) -> panic("the test program fails to check"),
    Analysed(w) -> match interfaces_of(w.checked, w.hashes).find(|d: PublishedInterface|
        d.name == b"m.size") {
      Some(d) -> d.interface,
      None -> panic("the checked program does not export a definition named `m.size`"),
    },
  }
}

test "an interface identifies each type and effect by the hash of its declaration, not by its name" {
  let declared = |shape: Bytes, operations: Bytes|
    Bytes::concat_all([b"pub type Shape = ", shape, b"\npub effect log {\n", operations, b"}\n"]);
  let put = b"  write put(n: Int) -> Unit\n";
  let first = size_over(b"shapes", declared(b"| Dot | Line(Int)", put));
  assert_eq(size_over(b"forms", declared(b"| Dot | Line(Int)", put)), first);
  assert(size_over(b"shapes", declared(b"| Dot | Circle(Float)", put)) != first, None);
  assert(
    size_over(
        b"shapes",
        declared(b"| Dot | Line(Int)", Bytes::concat_all([put, b"  write flush() -> Unit\n"])),
      )
      != first,
    None,
  )
}

test "an interface distinguishes a type from an effect that has the same name" {
  let opened = |boxed: Bytes|
    match analyse(
        parse_all([
          {
            name: b"m",
            source_text: Bytes::concat_all([
              b"pub type Box = ",
              boxed,
              b"\neffect Box { read held() -> Int }\npub fn open(b: Box) -> Int / {Box.read} = Box.held()\n",
            ]),
          },
        ]),
      ) {
      Rejected(_) -> panic("the test program fails to check"),
      Analysed(w) -> match interfaces_of(w.checked, w.hashes).find(|d: PublishedInterface|
          d.name == b"m.open") {
        Some(d) -> d.interface,
        None -> panic("the checked program does not export a definition named `m.size`"),
      },
    };
  assert(opened(b"| Box(Int)") != opened(b"| Box(Int, Int)"), None)
}

test "an interface differs when a function parameter or type variable is marked `keep` and when it is not" {
  let recorded = |source: Bytes|
    match analyse(parse_all([{ name: b"m", source_text: source }])) {
      Rejected(_) -> panic("the test program fails to check"),
      Analysed(w) -> match interfaces_of(w.checked, w.hashes).find(|d: PublishedInterface|
          d.name == b"m.f") {
        Some(d) -> d.interface,
        None -> panic("the checked program does not export a definition named `m.size`"),
      },
    };
  assert(
    recorded(b"pub fn f(g: keep (Int) -> Int) -> Int = g(1)\n")
      != recorded(b"pub fn f(g: (Int) -> Int) -> Int = g(1)\n"),
    None,
  );
  assert(
    recorded(b"pub fn f<keep a>(x: keep a) -> a = x\n")
      != recorded(b"pub fn f<a>(x: a) -> a = x\n"),
    None,
  )
}

test "the types used in a function body are recorded as keys into one shared table of types, and read back from that table" {
  let source = b"fn first<a>(xs: List<a>, d: a) -> a = match xs { [x, ..] -> x, _ -> d }\nfn go(ys: List<Int>) -> Int = first(ys, 0)\n";
  match analyse(parse_all([{ name: b"m", source_text: source }])) {
    Rejected(_) -> panic("the test program fails to check"),
    Analysed(w) -> {
      let rows = rows_of(w);
      let sites = |name: Bytes|
        match rows.definitions.find(|r: KnownDefinitionRow| r.name == name) {
          Some(r) -> match decode_facts(r.facts, 0, b"") { Some(f) -> f, None -> no_body_facts() },
          None -> no_body_facts(),
        };
      assert_eq(sites(b"m.go").types.len(), 0);
      let bodies = |name: Bytes| bodies_read(sites(name).bodies, rows.types);
      assert_eq(
        bodies(b"m.go").flat_map(|b: TypedBody<Type>| typed_expression_nodes(b.body)).fold(
          [],
          |accumulator: List<List<Type>>, e: TypedExpression<Type>|
            match e.node {
              TypedRead(ReadDefinition(d)) -> accumulator.push(d.args),
              _ -> accumulator,
            },
        ),
        [[int_type()]],
      );
      assert_eq(
        bodies(b"m.first").flat_map(|b: TypedBody<Type>| b.params).filter(
          |p: TypedParam<Type>| p.name == b"d",
        ).map(|p: TypedParam<Type>| p.ty),
        [VariableType(0)],
      )
    },
  }
}

test "each test is identified by its module and label, and tests are listed in the program's test order" {
  let d = dump_of(
    analyse(
      parse_all([
        {
          name: b"a",
          source_text: b"fn one() -> Int = 1\ntest \"first\" { assert_eq(one(), 1) }\ntest \"second\" { assert_eq(one(), 1) }",
        },
        {
          name: b"b",
          source_text: b"fn test_like(x: Int) -> Int requires x > 0 = x\ntest \"third\" { assert_eq(test_like(2), 2) }",
        },
      ]),
    ),
  );
  let tested = d.tests.map(|t: TestRow| test_owner(t.module, t.name));
  assert_eq(d.emitter_roots.map(|r: EmitterRoot| r.root).filter(|r: Bytes| tested.contains(r)), [
    test_owner(b"a", b"first"),
    test_owner(b"a", b"second"),
    test_owner(b"b", b"third"),
  ]);
  assert_eq(range(0, 4).map(|i: Int| test_root_at(d, i)), [
    Some(test_key(b"a", b"first")),
    Some(test_key(b"a", b"second")),
    Some(test_key(b"b", b"third")),
    None,
  ]);
  assert_eq(d.tests.map(|t: TestRow| Bytes::concat_all([t.module, b".", t.name])), [
    b"a.first",
    b"a.second",
    b"b.third",
  ])
}

test "a published listing limited to chosen definitions and tests still has every test as a root, and its keys are the full listing's keys for the chosen roots" {
  let source = b"fn base(x: Int) -> Int = x + 1\nfn used(x: Int) -> Int requires x > 0 = base(x)\nfn other(x: Int) -> Int = x * 2\ntest \"uses\" { assert_eq(used(1), 2) }\ntest \"others\" { assert_eq(other(1), 2) }\nlaw \"l\" forall (x: Int) { other(x) == x * 2 }";
  match analyse(parse_all([{ name: b"m", source_text: source }])) {
    Rejected(_) -> panic("the test program fails to check"),
    Analysed(w) -> {
      let whole = dump_of(Analysed(w));
      let within = view_dump(
        checked_program_of(w),
        Some({
          owners: Map::new().insert(b"m.used", true),
          tests: Map::new().insert(b"m.uses", true),
        }),
      );
      assert_eq(within.emitter_roots.map(|root: EmitterRoot| root.root), [
        b"m.used",
        test_owner(b"m", b"uses"),
        test_owner(b"m", b"others"),
        b"m.used#requires#0",
      ]);
      assert_eq(
        within.keys,
        whole.keys.filter(|k: KeyRow|
          [b"m.used#requires#0", b"m.used", test_owner(b"m", b"uses")].contains(k.root)),
      );
      assert_eq(within.keys.len(), 3);
    },
  }
}

test "a test's key depends on the effect operations its code uses, and not on the order an effect set lists them in" {
  let key = |set: Bytes| {
    let source = Bytes::concat_all([
      b"effect store {\n  read all[r]() -> List<Int>\n  write save[r](rows: List<Int>) -> Unit\n}\n",
      set,
      b"\nfn listed() -> Int / {Web} = store.all[orders]().len()\n",
      b"test \"listed\" { handle { assert_eq(listed(), 0) } with { store.all[orders]() -> [] } }\n",
    ]);
    match analyse(parse_all([{ name: b"m", source_text: source }])) {
      Rejected(_) -> panic("the test program fails to check"),
      Analysed(w) ->
        dump_of(Analysed(w)).keys.filter(|k: KeyRow| k.root == test_owner(b"m", b"listed")).map(
          |k: KeyRow| k.key,
        ),
    }
  };
  let narrow = key(b"effect set Web = {store.read[orders], store.write[audit]}");
  assert_eq(narrow.len(), 1);
  assert_eq(key(b"effect set Web = {store.write[audit], store.read[orders]}"), narrow);
  assert(
    key(b"effect set Web = {store.read[orders], store.write[audit], store.read[inventory]}")
      != narrow,
    Some("a widened set left the key of a test that reaches it"),
  )
}

test "a module at or below a built-in package's root claims its prefix, and one that only starts with its letters does not" {
  let claims = |name: Bytes|
    reserved_prefix_diagnostics([name], []).map(|c: { slot: Int, diagnostic: ParseDiagnostic }|
      c.diagnostic.code);
  [
    b"std",
    b"std.json",
    b"std.net",
    b"std.http.server",
    b"compiler",
    b"compiler.front",
    b"compiler.items",
    b"compiler.fmt",
  ].fold((), |u: Unit, name: Bytes| assert_eq(claims(name), [b"E0133"]));
  [b"stdx", b"stdlib", b"mine.std_helpers", b"a.std_thing", b"compilers"].fold(
    (),
    |u: Unit, name: Bytes| assert_eq(claims(name), []),
  )
}

test "a published builtin lists its type signature and its parameter names" {
  let rows = builtin_rows().filter(|r: BuiltinRow| r.name == b"Array::get");
  assert_eq(rows.len(), 1);
  assert_eq(rows.get(0).params, [b"xs", b"i"]);
  match rows.get(0).scheme.ty {
    FunctionType(f) -> assert_eq(f.params.len(), 2),
    _ -> assert(false),
  }
}

test "prelude function bodies can call extern functions and functions on a type, by method syntax or by qualified name" {
  let source = Bytes::concat_all([
    b"extern fn List::at<a>(xs: List<a>, i: Int) -> Option<a>\n",
    b"extern fn List::len<a>(xs: List<a>) -> Int\n",
    b"fn walked<a>(xs: List<a>, i: Int) -> Int = match xs.at(i) { Some(_) -> walked(xs, i + 1), None -> i }\n",
    b"pub fn List::count<a>(xs: List<a>) -> Int = walked(xs, 0) + xs.len() + List::len(xs)\n",
    b"pub fn List::twice<a>(xs: List<a>) -> Int = xs.count() + List::count(xs)\n",
  ]);
  match analyse(parse_all([{ name: prelude_module(), source_text: source }])) {
    Rejected(ds) ->
      panic(String::of_bytes_lossy(Bytes::join(ds.map(|d: Diagnostic| d.message), b"; "))),
    Analysed(w) ->
      assert_eq(
        w.checked.definitions.map(|d: DefinitionInfo| d.name).filter(|n: Bytes|
          n.index_of(b"::") != None),
        [b"std.prelude.List::count", b"std.prelude.List::twice"],
      ),
  }
}

test "a function that `std.prelude` defines in Ply is checked against the type signature that its callers see" {
  let source = Bytes::concat_all([
    b"pub fn g(xs: List<Int>) -> Int = xs.map(|x: Int| x + 1).filter(|x: Int| x > 2).fold(0, |a: Int, x: Int| a + x)\n",
    b"pub fn k(xs: List<Int>) -> Option<Int> / {abort.raise} = xs.set(0, 1).push(2).at(0)\n",
    b"pub fn l(a: Array<Int>, c: Columns<{ x: Int }>) -> Int = a.to_list().len() + c.to_list().len()\n",
    b"fn e(o: Option<{ key: Int, value: Int }>) -> Int = match o { Some(x) -> x.key, None -> 0 }\n",
    b"fn p(o: Option<{ key: Int, value: Int, rest: Map<Int, Int> }>) -> Int = match o { Some(x) -> x.rest.len(), None -> 0 }\n",
    b"fn some<a>(o: Option<a>) -> Int = match o { Some(_) -> 1, None -> 0 }\n",
    b"pub fn t(n: Int, u: U128, i: I128, s: String, f: Float) -> Int = n.to_string().len() + u.to_string().len() + i.to_string().len() + f.to_string().len() + s.trim().len() + (if Bytes::of_string(s).is_utf8() { 1 } else { 0 }) + some(U128::of_string(s)) + some(I128::of_string(s)) + some(Float::of_string(s))\n",
    b"pub fn u(b: Bytes) -> Int / {abort.raise} = String::of_bytes(b).len() + String::of_bytes_lossy(b).len()\n",
    b"pub fn d(a: Decimal, b: Decimal, f: Float, s: String) -> Int / {abort.raise} = a.div(b, 2, HalfEven).round(1, Down).to_string().len() + some(Decimal::of_string(s)) + some(Decimal::of_float(f)) + some(Int::of_decimal(a, Up)) + some(Int::of_float(f.round(Floor), Ceiling)) + (if Float::of_decimal(a) > 0.0 { 1 } else { 0 })\n",
    b"pub fn n(m: Map<Int, Int>) -> Int = m.remove(1).insert(2, 3).update(2, |v: Int| v + 1).fold(0, |s: Int, k: Int, v: Int| s + k + v) + m.keys().len() + m.values().len() + m.entries().len() + Map::of_entries(m.entries()).merge(m).len() + e(m.first()) + e(m.last()) + e(m.floor(1)) + e(m.ceiling(1)) + e(m.below(1)) + e(m.above(1)) + p(m.pop_first()) + p(m.pop_last()) + m.range(None, true, None, true, 3).len() + (if m.contains(1) { 1 } else { 0 }) + m.split(1).below.len() + match m.get(1) { Some(v) -> v, None -> 0 }\n",
  ]);
  match analyse(parse_all([{ name: b"m", source_text: source }])) {
    Rejected(_) -> panic("the test program fails to check"),
    Analysed(w) -> {
      let checked = w.checked.definitions.fold(
        Map::new(),
        |accumulator: Map<Bytes, Scheme>, d: DefinitionInfo| accumulator.insert(d.name, d.scheme),
      );
      let bodied = builtins().filter(|b: Builtin| b.body);
      assert(bodied.len() > 0, None);
      bodied.fold((), |u: Unit, b: Builtin|
        assert_eq(checked.get(qualify(prelude_module(), b.name)), Some(b.scheme)));
      assert_eq(
        w.checked.definitions.filter(|d: DefinitionInfo|
          module_of_name(d.name) == prelude_module() && d.ending != Terminates
            && d.ending != TerminatesByDecreases).map(|d: DefinitionInfo| d.name),
        [],
      )
    },
  }
}

test "printing a definition's source text writes the parameter name on a method-call argument, as in `c.scaled(plus: 3)`" {
  let source = b"pub type Bag = | Bag(Int)\npub fn Bag::size(b: Bag) -> Int = match b { Bag(n) -> n + 1 }\npub type Cart = | Cart(Int)\npub fn Cart::size(c: Cart) -> Int = match c { Cart(n) -> n }\npub fn Cart::scaled(c: Cart, by: Int = 2, plus: Int = 0) -> Int = c.size() * by + plus\npub fn total(c: Cart) -> Int = c.size()\npub fn more(c: Cart) -> Int = c.scaled(plus: 3)\n";
  match analyse(parse_all([{ name: b"m", source_text: source }])) {
    Rejected(_) -> panic("the fixture program was rejected by the checker"),
    Analysed(w) -> {
      let more = match print_bodies(
          w.hashes.bodies.map(|b: { name: Bytes, body: Bytes }| b.body),
          w.hashes.definitions.concat(w.hashes.declarations).map(
            |d: { name: Bytes, hash: Bytes }| { name: d.name, hash: d.hash, public: true },
          ),
          [],
          [prelude_module()],
        ) {
        Printed(ms) ->
          ms.get(0).text.split(b"\n\n").fold(b"", |accumulator: Bytes, it: Bytes|
            if it.contains(b"fn more(") { it } else { accumulator }),
        Unprintable(reason) -> panic(String::of_bytes(reason.message)),
      };
      assert(more.contains(b".scaled(_l2: 3)"), Some(String::of_bytes_lossy(more)))
    },
  }
}
