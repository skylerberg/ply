import std.bin
import std.list
import std.graph
import std.set (Set)
import compiler.store.memo (memo)
import compiler.store.handles (QueryOf, Written, written, fetch_part, query_definition)
import compiler.check.infer.checker (TestInfo, test_info_bin)
import compiler.check.resolve.tables (in_module)
import compiler.expand.embed (ModuleEmbed, module_embed_bin)
import compiler.front.emitter_input (ConstSite, LawPlace, MainPlace, ModuleMain, RootPlace,
                                     const_site_bin, law_place_bin, main_place_bin, root_place_bin)
import compiler.front.exports (named_node)
import compiler.front.facts (Argument, StatementSite, TaggedSite, callees_of, statement_site_bin,
                             tagged_site_bin)
import compiler.front.rows (DeclaredEffect, DeclaredOperation, declared_effect_bin)
import compiler.front.checking.world (CheckDefinition, ModuleKey, Modules, modules_bin, shipped_for)
import compiler.front.checking.groups (code_part, declared_effects_part, imports_part, sites_part,
                                       tests_part)
import compiler.front.checking.identity (identity_of)
import compiler.store.hash.forms (DefinitionRun)

pub fn own_key(module: Bytes) -> ModuleKey = { module: module, shipped: false, tested: false }

pub fn pulled_key(module: Bytes) -> ModuleKey = { module: module, shipped: true, tested: false }

pub fn keys_of(modules: Modules) -> List<ModuleKey> =
  modules.own.map(own_key).concat(modules.pulled.map(pulled_key))

pub fn names_of(modules: Modules) -> List<Bytes> = modules.own.concat(modules.pulled)

pub type TestList = { root: Int, names: List<Bytes>, tests: List<TestInfo> }

derive bin for TestList

pub fn test_list_query() -> QueryOf<Modules, TestList> =
  { name: b"test list", input: modules_bin(), output: test_list_bin() }

pub fn test_list_result(modules: Modules) -> Written / {memo.read, abort.raise} = {
  let keys = keys_of(modules);
  written(test_list_query(), {
    root: modules.root,
    names: names_of(modules),
    tests: range(0, modules.own.len()).fold([], |found: List<TestInfo>, i: Int|
      fetch_part(tests_part(), keys.get(i)).fold(found, |tests: List<TestInfo>, t: TestInfo|
        tests.push({
          ..t,
          index: tests.len(),
          at: { ..t.at, module: i },
          label: { ..t.label, module: i },
        }))),
  })
}

pub type ProgramRollup = {
  embeds: List<ModuleEmbed>,
  roots: List<RootPlace>,
  mains: List<MainPlace>,
  declared: List<DeclaredEffect>,
  laws: List<LawPlace>,
}

derive bin for ProgramRollup

pub fn program_rollup_query() -> QueryOf<Modules, ProgramRollup> =
  { name: b"program rollup", input: modules_bin(), output: program_rollup_bin() }

fn declared_at(d: DeclaredEffect, i: Int) -> DeclaredEffect =
  {
    ..d,
    at: in_module(d.at, i),
    operations: d.operations.map(|o: DeclaredOperation| { ..o, at: in_module(o.at, i) }),
  }

pub fn program_rollup_result(modules: Modules) -> Written / {memo.read, abort.raise} = {
  let keys = keys_of(modules);
  let at = range(0, keys.len());
  let code = keys.map(|k: ModuleKey| fetch_part(code_part(), k));
  written(program_rollup_query(), {
    embeds: at.fold([], |found: List<ModuleEmbed>, i: Int| found.concat(code.get(i).embeds)),
    roots: at.fold([], |found: List<RootPlace>, i: Int|
      found.concat(code.get(i).roots.map(|r: RootPlace| { ..r, at: in_module(r.at, i) }))),
    mains: at.fold([], |found: List<MainPlace>, i: Int|
      found.concat(
        code.get(i).mains.map(|m: ModuleMain|
          { root: m.root, module: i, span: m.span, effects: m.effects }),
      )),
    declared: at.fold([], |found: List<DeclaredEffect>, i: Int|
      found.concat(
        fetch_part(declared_effects_part(), keys.get(i)).map(|d: DeclaredEffect| declared_at(d, i)),
      )),
    laws: at.fold([], |found: List<LawPlace>, i: Int| found.concat(code.get(i).laws)),
  })
}

pub type CalleeIdentity = | RunIdentity(Bytes) | NoRunIdentity

derive bin for CalleeIdentity

pub type ProgramSites = {
  tagged: List<TaggedSite>,
  statements: List<StatementSite>,
  constants: List<ConstSite>,
  callee_identities: Map<Bytes, CalleeIdentity>,
}

derive bin for ProgramSites

pub fn run_identity(
  identities: Map<Bytes, CalleeIdentity>,
  callee: Bytes,
) -> Option<Bytes> / {abort.raise} =
  match identities.get(callee) {
    Some(RunIdentity(identity)) -> Some(identity),
    Some(NoRunIdentity) -> None,
    None ->
      panic(
        "`" ++ String::of_bytes_lossy(callee)
          ++ "` is not a callee of the program's sites, so it has no listed identity",
      ),
  }

pub fn program_sites_query() -> QueryOf<Modules, ProgramSites> =
  { name: b"program sites", input: modules_bin(), output: program_sites_bin() }

pub fn program_imports_query() -> QueryOf<Modules, List<List<Int>>> =
  {
    name: b"program imports",
    input: modules_bin(),
    output: bin::list_bin(bin::list_bin(bin::int_bin())),
  }

pub fn program_imports_result(modules: Modules) -> Written / {memo.read, abort.raise} = {
  let names = names_of(modules);
  let slots = range(0, names.len()).fold(Map::new(), |found: Map<Bytes, Int>, i: Int|
    found.insert(names.get(i), i));
  written(
    program_imports_query(),
    keys_of(modules).map(|k: ModuleKey|
      fetch_part(imports_part(), k).fold([], |found: List<Int>, name: Bytes|
        match slots.get(name) { Some(i) -> found.push(i), None -> found })),
  )
}

pub fn reached_modules(imports: List<List<Int>>, start: List<Int>) -> Set<Int> / {abort.raise} =
  Set::of_list(graph::reachable({ out: imports }, start))

pub fn names_reached(
  names: List<Bytes>,
  imports: List<List<Int>>,
  start: List<Bytes>,
) -> Set<Bytes> / {abort.raise} = {
  let wanted = Set::of_list(start);
  reached_modules(
    imports,
    range(0, names.len()).filter(|i: Int| wanted.contains(names.get(i))),
  ).fold(Set::empty(), |found: Set<Bytes>, i: Int| found.insert(names.get(i)))
}

fn identities_of_callees(
  modules: Modules,
  callees: List<Bytes>,
) -> Map<Bytes, CalleeIdentity> / {memo.read, abort.raise} = {
  let known = Set::of_list(names_of(modules));
  callees.fold(Map::new(), |found: Map<Bytes, CalleeIdentity>, name: Bytes|
    if found.contains(name) { found } else { found.insert(name, callee_identity(known, name)) })
}

fn callee_identity(known: Set<Bytes>, name: Bytes) -> CalleeIdentity / {memo.read, abort.raise} = {
  let module = named_node(name).module;
  if !known.contains(module) { NoRunIdentity } else {
    match identity_of({
        module: { module: module, shipped: shipped_for(false, module), tested: false },
        subject: DefinitionRun(name),
      }) {
      Some(identity) -> RunIdentity(identity),
      None -> NoRunIdentity,
    }
  }
}

pub fn program_sites_result(modules: Modules) -> Written / {memo.read, abort.raise} = {
  let keys = keys_of(modules);
  let root = range(0, modules.root);
  let read = root.map(|i: Int| fetch_part(sites_part(), keys.get(i)));
  let tagged = root.fold([], |found: List<TaggedSite>, i: Int|
    found.concat(read.get(i).tagged.map(|t: TaggedSite| { ..t, module: i })));
  let statements = root.fold([], |found: List<StatementSite>, i: Int|
    found.concat(read.get(i).statements.map(|x: StatementSite| { ..x, module: i })));
  let constants = root.fold([], |found: List<ConstSite>, i: Int|
    found.concat(read.get(i).constants.map(|c: ConstSite| { ..c, module: i })));
  written(program_sites_query(), {
    tagged: tagged,
    statements: statements,
    constants: constants,
    callee_identities: identities_of_callees(
      modules,
      tagged.map(|t: TaggedSite| t.callee).concat(constants.map(|c: ConstSite| c.name)).concat(
        statements.fold([], |found: List<Bytes>, x: StatementSite|
          x.args.fold(found, |names: List<Bytes>, a: Argument| names.concat(callees_of(a)))),
      ),
    ),
  })
}

pub fn program_queries() -> List<CheckDefinition> =
  [
    query_definition(
      test_list_query(),
      b"compiler.front.checking.program_facts.test_list_result",
      test_list_result,
    ),
    query_definition(
      program_rollup_query(),
      b"compiler.front.checking.program_facts.program_rollup_result",
      program_rollup_result,
    ),
    query_definition(
      program_sites_query(),
      b"compiler.front.checking.program_facts.program_sites_result",
      program_sites_result,
    ),
    query_definition(
      program_imports_query(),
      b"compiler.front.checking.program_facts.program_imports_result",
      program_imports_result,
    ),
  ]

test "a module reaches the modules it imports, directly or indirectly" {
  let imports = [[1], [2], [], [0], []];
  let reached = |m: Int| reached_modules(imports, [m]).elements();
  assert_eq(reached(0), [0, 1, 2]);
  assert_eq(reached(3), [0, 1, 2, 3]);
  assert_eq(reached(4), [4]);
  assert_eq(reached_modules([[1], [0]], [1]).elements(), [0, 1])
}
