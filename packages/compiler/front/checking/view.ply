import std.set (Set)
import std.bin
import std.list
import compiler.store.memo (memo)
import compiler.store.handles (fetched)
import compiler.front.emitter_input (ConstSite, ModuleRollup)
import compiler.front.exports (named_node)
import compiler.front.checking.promises (hash_of_definition)
import compiler.front.facts (Argument, OneModule, ProgramListing, StatementSite, TaggedSite,
                             callees_of, decode_tables, one_module, program_listing, with_hashes)
import compiler.front.rows (Outline)
import compiler.store.hash.forms (ModuleHashes)
import compiler.front.pages (Pages)
import compiler.front.checking (CheckedModule, cycles_among, documented_all, hashed_all,
                                module_hashes, module_of)
import compiler.front.checking.groups (GroupKey, HashSummary, ModuleListing, ProgramSummary,
                                       group_facts_of, group_keys, hash_summary_query,
                                       module_listing_query, module_rollup_query, owners_result_of,
                                       program_summary_query, modules_declaring)
import compiler.front.checking.world (ModuleKey)
import compiler.check.resolve.tables (placed_in)
import compiler.check.resolve.tables (Diagnostic, Label)
import compiler.check.infer.checker (CachedFacts, DefinitionInfo)
import compiler.check.infer (EmitFacts)
import compiler.front.owner_checks (MemberResult, member_facts)
import compiler.check.types (Effect)

pub type Modules = { root: Int, own: List<Bytes>, pulled: List<Bytes> }

fn own_key(module: Bytes) -> ModuleKey = { module: module, shipped: false, tested: false }

fn pulled_key(module: Bytes) -> ModuleKey = { module: module, shipped: true, tested: false }

pub fn keys_of(modules: Modules) -> List<ModuleKey> =
  modules.own.map(own_key).concat(modules.pulled.map(pulled_key))

pub fn summary(own: List<Bytes>) -> ProgramSummary / {memo.read, abort.raise} =
  fetched(program_summary_query(), own)

fn placed_at(diagnostics: List<Diagnostic>, slot: Int) -> List<Diagnostic> =
  diagnostics.map(|d: Diagnostic| placed_in(d, slot))

fn slots_of(names: List<Bytes>) -> Map<Bytes, Int> / {abort.raise} =
  range(0, names.len()).fold(Map::new(), |slots: Map<Bytes, Int>, i: Int|
    slots.insert(names.get(i), i))

pub fn rejections(
  own: List<Bytes>,
  read: ProgramSummary,
) -> List<Diagnostic> / {memo.read, abort.raise} = {
  let slots = slots_of(own.concat(read.pulled));
  let keys = own.map(own_key).concat(read.pulled.map(pulled_key));
  let flagged = keys.filter(|k: ModuleKey| read.rejected.contains(k.module));
  (if read.cycle { cycles_among(own) } else { flagged.map(module_of) }).fold(
    [],
    |found: List<Diagnostic>, a: CheckedModule|
      found.concat(
        placed_at(a.result.rejected.concat(a.result.warnings), match slots.get(a.module) {
          Some(i) -> i,
          None -> 0,
        }),
      ),
  )
}

fn listing_of(key: ModuleKey) -> ModuleListing / {memo.read, abort.raise} =
  fetched(module_listing_query(), key)

pub fn warnings(
  root: List<Bytes>,
  read: ProgramSummary,
) -> List<Diagnostic> / {memo.read, abort.raise} =
  range(0, root.len()).fold([], |found: List<Diagnostic>, i: Int|
    if read.warned.contains(root.get(i)) {
      found.concat(placed_at(listing_of(own_key(root.get(i))).warnings, i))
    } else { found })

pub type CheckedOwner = { facts: EmitFacts, cached: List<CachedFacts> }

pub fn checked_owners(key: ModuleKey) -> List<CheckedOwner> / {memo.read, abort.raise} =
  group_keys(key, owners_result_of(key)).flat_map(|g: GroupKey|
    group_facts_of(g).members.map(|m: MemberResult| {
      let read = member_facts(m);
      { facts: read.facts, cached: read.cached }
    }))

pub fn performed_by(modules: Modules) -> List<Effect> / {memo.read, abort.raise} =
  modules.own.take(modules.root).fold([], |found: List<Effect>, m: Bytes|
    found.concat(
      decode_tables(listing_of(own_key(m)).tables).definitions.flat_map(|d: DefinitionInfo|
        d.effects),
    )).unique(
  )

pub fn outlines(modules: Modules) -> List<Outline> / {memo.read, abort.raise} =
  keys_of(modules).map(|k: ModuleKey| owners_result_of(k).shape.outline)

pub fn listed(modules: Modules) -> ProgramListing / {memo.read, abort.raise} = {
  let listings = keys_of(modules).map(listing_of);
  program_listing(
    modules.root,
    modules.own.len(),
    listings.map(|l: ModuleListing| l.shape),
    listings.map(|l: ModuleListing| decode_tables(l.tables)),
    hashed_all(modules.own, modules.pulled, false),
    modules.pulled.fold(Set::empty(), |names: Set<Bytes>, m: Bytes| names.insert(m)),
  )
}

pub fn listing_from(
  modules: Modules,
  results: List<CheckedModule>,
  hashes: List<ModuleHashes>,
) -> ProgramListing / {abort.raise} =
  program_listing(
    modules.root,
    modules.own.len(),
    results.map(|a: CheckedModule| a.result.shape),
    results.map(|a: CheckedModule| decode_tables(a.result.tables)),
    hashes,
    modules.pulled.fold(Set::empty(), |names: Set<Bytes>, m: Bytes| names.insert(m)),
  )

pub type NamedRollup = { module: Bytes, rollup: ModuleRollup }

pub fn rollups(modules: Modules) -> List<NamedRollup> / {memo.read, abort.raise} =
  keys_of(modules).map(|k: ModuleKey|
    { module: k.module, rollup: fetched(module_rollup_query(), k) })

pub type ProgramSites = {
  names: List<Bytes>,
  imports: List<List<Bytes>>,
  tagged: List<TaggedSite>,
  statements: List<StatementSite>,
  constants: List<ConstSite>,
}

fn hashes_of_callees(
  modules: Modules,
  callees: List<Bytes>,
) -> Map<Bytes, Bytes> / {memo.read, abort.raise} = {
  let known = modules.own.concat(modules.pulled).fold(Set::empty(),
    |found: Set<Bytes>, m: Bytes| found.insert(m),
  );
  callees.fold(Map::new(), |found: Map<Bytes, Bytes>, name: Bytes|
    if found.contains(name) || !known.contains(named_node(name).module) { found }
    else { match hash_of_definition(name) { Some(h) -> found.insert(name, h), None -> found } })
}

pub fn sites(
  modules: Modules,
  rollups: List<NamedRollup>,
) -> ProgramSites / {memo.read, abort.raise} = {
  let root = range(0, modules.root);
  let tagged = root.fold([], |found: List<TaggedSite>, i: Int|
    found.concat(rollups.get(i).rollup.tagged.map(|t: TaggedSite| { ..t, module: i })));
  let statements = root.fold([], |found: List<StatementSite>, i: Int|
    found.concat(rollups.get(i).rollup.statements.map(|x: StatementSite| { ..x, module: i })));
  let constants = root.fold([], |found: List<ConstSite>, i: Int|
    found.concat(rollups.get(i).rollup.constants.map(|c: ConstSite| { ..c, module: i })));
  let hashed = hashes_of_callees(
    modules,
    tagged.map(|t: TaggedSite| t.callee).concat(constants.map(|c: ConstSite| c.name)).concat(
      statements.fold([], |found: List<Bytes>, x: StatementSite|
        x.args.fold(found, |names: List<Bytes>, a: Argument| names.concat(callees_of(a)))),
    ),
  );
  let hash_of = |name: Bytes| hashed.get(name).unwrap_or(b"");
  {
    names: rollups.map(|r: NamedRollup| r.module),
    imports: rollups.map(|r: NamedRollup| r.rollup.imports),
    tagged: tagged.map(|t: TaggedSite| { ..t, hash: hash_of(t.callee) }),
    statements: statements.map(|x: StatementSite| with_hashes(hashed, x)),
    constants: constants.map(|c: ConstSite| { ..c, hash: hash_of(c.name) }),
  }
}

pub type LaterReading = { rollups: List<NamedRollup>, sites: ProgramSites }

pub fn later_reading(modules: Modules) -> LaterReading / {memo.read, abort.raise} = {
  let read = rollups(modules);
  { rollups: read, sites: sites(modules, read) }
}

pub fn imports_reached(
  rollups: List<NamedRollup>,
  start: List<Bytes>,
) -> Set<Bytes> / {abort.raise} = {
  let imports = rollups.fold(Map::new(), |found: Map<Bytes, List<Bytes>>, r: NamedRollup|
    found.insert(r.module, r.rollup.imports));
  iterate(
    { seen: Set::empty(), work: start },
    1000000,
    |s: { seen: Set<Bytes>, work: List<Bytes> }|
      match s.work {
        [] -> Stop(s.seen),
        [m, ..rest] -> if s.seen.contains(m) { Continue({ ..s, work: rest }) } else {
          Continue({
            seen: s.seen.insert(m),
            work: rest.concat(imports.get(m).unwrap_or([])),
          })
        },
      },
  )
}

pub fn hash_summaries(modules: Modules) -> List<HashSummary> / {memo.read, abort.raise} =
  keys_of(modules).map(|k: ModuleKey| fetched(hash_summary_query(), k))

pub type ModuleVersion = { one: OneModule, hashes: ModuleHashes }

pub fn module_version(key: ModuleKey) -> ModuleVersion / {memo.read, abort.raise} = {
  let listing = listing_of(key);
  { one: one_module(listing.shape, decode_tables(listing.tables)), hashes: module_hashes(key) }
}

pub fn declarers(name: Bytes) -> List<Bytes> / {memo.read, abort.raise} =
  modules_declaring(false, name)

pub fn pages(keys: List<ModuleKey>) -> List<Pages> / {memo.read, abort.raise} = documented_all(keys)
