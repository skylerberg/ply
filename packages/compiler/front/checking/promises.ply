import std.bin
import std.list
import compiler.store.memo (memo)
import compiler.check.infer.checker (CheckReads, DefinitionInfo, EffectInfo, TypeFacts, program)
import compiler.front.emitter_input (AnalysisOutcome, Analysed, Rejected)
import compiler.emit.representations (type_names, lowering)
import compiler.front.facts (Analysis)
import compiler.front.rows (OutlineItem, OutlinedFunction)
import compiler.front.exports (item_at_bin, Imported, ItemAt, Mention, OwnerSource, OwnerText,
                               group_imports, hash_entry_bin, item_layout, mention_key, named_node)
import compiler.emit.costs (cost_input_of, GroupWalk, ParamSharing, ReturnOwnership, FreshReturn,
                            WalkedBody, demands_of, group_walk_bin, module_costs,
                            module_demands_bin, parameters_bin, parameters_of, report_bin,
                            return_ownership_bin, walked_group)
import compiler.syntax.items (Item, FunctionItem, TestItem, LawItem, item_span)
import compiler.check.resolve.tables (ParsedModule, qualify)
import compiler.check.infer (item_owner)
import compiler.store.hash.forms (CachedNode, NodeRef)
import compiler.front.checking.units (with_code_reads)
import compiler.program.group_check (LoadedSource, checked_group)
import compiler.front.checking.world (ModuleKey, QueryEffects, SessionReads, context_once, decoded,
                                      interface_key_bin, module_key_bin, own_modules_kind,
                                      package_location_of, shipped_for)
import compiler.front.checking.groups (GroupKey, GroupSource, OwnerFacts, OwnerKey, OwnersResult,
                                       always_entire, with_performed_effects, known_of_types,
                                       declared_of, group_key_bin, layout_of, placed_facts,
                                       group_keys, no_bodies, owner_facts, owner_hash_query,
                                       owner_key_bin, owners_result_of, with_group_read, GroupRead,
                                       unit_key_of)

pub const cost_walk_query: Bytes = b"cost walk"

pub const cost_return_query: Bytes = b"cost return"

pub const cost_demands_query: Bytes = b"cost demands"

pub const cost_parameters_query: Bytes = b"cost parameters"

pub const module_parameters_query: Bytes = b"module parameters"

pub const module_costs_query: Bytes = b"module costs"

pub const measure_query: Bytes = b"measure"

pub const measures_query: Bytes = b"measures"

fn in_root(module: Bytes) -> Bool / {memo.read, abort.raise} =
  match package_location_of(module) { Some(p) -> p.package == 0, None -> false }

fn root_modules() -> List<Bytes> / {memo.read, abort.raise} =
  (match memo.external(own_modules_kind, b"") {
    Some(b) -> decoded(b, bin::list_bin(bin::bytes_bin()), "the program's modules"),
    None -> [],
  }).filter(
    in_root,
  )

fn module_of_unit(u: GroupKey) -> ModuleKey =
  { module: u.module, shipped: u.shipped, tested: u.tested }

fn root_module(module: Bytes) -> ModuleKey = { module: module, shipped: false, tested: false }

fn owner_at(u: GroupKey, owner: Bytes) -> OwnerKey =
  { module: u.module, shipped: u.shipped, tested: u.tested, owner: owner }

fn functions_of(read: OwnersResult, wanted: (OutlineItem) -> Bool) -> Map<Bytes, Bool> =
  read.shape.outline.items.fold(Map::new(), |found: Map<Bytes, Bool>, item: OutlineItem|
    match item {
      OutlinedFunction(f) -> if !wanted(item) { found } else {
        List::fold(
          match read.declared.get(f.name) { Some(owners) -> owners, None -> [] },
          found,
          |m: Map<Bytes, Bool>, o: Bytes| m.insert(o, true),
        )
      },
      _ -> found,
    })

fn any_function(_: OutlineItem) -> Bool = true

fn measured_function(item: OutlineItem) -> Bool =
  match item { OutlinedFunction(f) -> f.measured, _ -> false }

fn is_test_or_law(owner: Bytes) -> Bool = owner.starts_with(b"test ") || owner.starts_with(b"law ")

fn walked_units(named: ModuleKey, read: OwnersResult) -> List<GroupKey> = {
  let bodied = functions_of(read, any_function);
  group_keys(named, read).filter(|u: GroupKey|
    u.owners.any(|o: Bytes| bodied.contains(o) || is_test_or_law(o)))
}

fn unit_members(u: GroupKey) -> List<OwnerFacts> / {memo.read, abort.raise} =
  u.owners.map(|o: Bytes| owner_facts(module_of_unit(u), o))

fn imports_for_unit(
  u: GroupKey,
  members: List<OwnerFacts>,
) -> List<Imported> / {SessionReads, abort.raise} = {
  let context = context_once(module_of_unit(u));
  group_imports(
    u.module,
    members.map(|f: OwnerFacts| f.text),
    members.fold([], |accumulator: List<Mention>, f: OwnerFacts| accumulator.concat(f.mentions)),
    context.imports,
    context.targets,
  )
}

fn unit_roots(m: ParsedModule, source: OwnerSource) -> Map<Bytes, Bool> / {abort.raise} =
  m.module.items.fold(Map::new(), |roots: Map<Bytes, Bool>, item: Item| {
    let start = item_span(item).start - source.offset;
    let inside = source.items.any(|x: ItemAt| x.from <= start && start < x.from + x.len);
    if !inside { roots } else {
      match item {
        FunctionItem(_) -> roots.insert(item_owner(m.name, item), true),
        TestItem(_) -> roots.insert(item_owner(m.name, item), true),
        LawItem(_) -> roots.insert(item_owner(m.name, item), true),
        _ -> roots,
      }
    }
  })

fn returned_by(name: Bytes) -> ReturnOwnership / {memo.read, abort.raise} = {
  let m = named_node(name);
  decoded(
    memo.fetch(
      cost_return_query,
      bin::encode(
        { module: m.module, shipped: false, full_text: false, name: m.name },
        interface_key_bin(),
      ),
    ),
    return_ownership_bin(),
    "what a definition returns",
  )
}

pub fn cost_walk_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let u = decoded(input, group_key_bin(), "a unit's names");
  let members = unit_members(u);
  let read = with_group_read(
    [{ named: module_of_unit(u), members: members, imported: imports_for_unit(u, members) }],
    always_entire,
    no_bodies,
    [],
    |group: GroupRead|
      { out: checked_group(group.inputs, group.walks), source: group.inputs.loaded.get(0).source },
  );
  let unwalked = { ok: false, bodies: [], declared: [] };
  bin::encode(
    match read.out.pulled.out {
      Rejected(_) -> unwalked,
      Analysed(w) -> handle {
        with_code_reads(u.tested, ||
          walked_group(
            {
              ..cost_input_of(w),
              walked: [read.out.at],
              roots: Some(unit_roots(w.modules.get(read.out.at), read.source)),
              origin: read.source.offset,
            },
            returned_by,
          ))
      } with {
        lowering.fail(_) -> unwalked,
      },
    },
    group_walk_bin(),
  )
}

fn walk_of(u: GroupKey) -> GroupWalk / {memo.read, abort.raise} =
  decoded(
    memo.fetch(cost_walk_query, bin::encode(u, group_key_bin())),
    group_walk_bin(),
    "a unit's update walk",
  )

pub fn cost_return_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, interface_key_bin(), "a definition's name");
  let definition = qualify(key.module, key.name);
  bin::encode(
    declared_of(key.module, key.shipped, key.full_text, key.name).fold(
      FreshReturn,
      |found: ReturnOwnership, o: Bytes|
        match walk_of(
            unit_key_of({
              module: key.module,
              shipped: key.shipped,
              tested: key.full_text,
              owner: o,
            }),
          ).bodies.find(|b: WalkedBody| b.definition == Some(definition)) {
          Some(b) -> b.returned,
          None -> found,
        },
    ),
    return_ownership_bin(),
  )
}

pub fn cost_demands_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  bin::encode(
    demands_of(walked_units(named, owners_result_of(named)).map(walk_of)),
    module_demands_bin(),
  )
}

pub fn cost_parameters_result(_: Bytes) -> Bytes / {memo.read, abort.raise} =
  bin::encode(
    parameters_of(
      root_modules().map(|m: Bytes|
        decoded(
          memo.fetch(cost_demands_query, bin::encode(root_module(m), module_key_bin())),
          module_demands_bin(),
          "a module's demands",
        )),
    ),
    parameters_bin(),
  )

pub fn module_parameters_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let all = decoded(
    memo.fetch(cost_parameters_query, b""),
    parameters_bin(),
    "the program's parameters",
  );
  bin::encode(
    {
      ..all,
      table: all.table.fold(
        Map::new(),
        |own_slots: Map<Bytes, Map<Int, ParamSharing>>, name: Bytes, slots: Map<Int, ParamSharing>|
          if named_node(name).module == named.module { own_slots.insert(name, slots) }
          else { own_slots },
      ),
    },
    parameters_bin(),
  )
}

pub fn module_costs_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_result_of(named);
  let facts = placed_facts(named, layout_of(named));
  let text_of = |o: Bytes|
    match facts.get(o) {
      Some(f) -> f.text,
      None -> panic("a unit names a declaration that its module does not hold"),
    };
  bin::encode(
    module_costs(
      walked_units(named, read).map(|u: GroupKey|
        { items: item_layout(u.owners.map(text_of)), walk: walk_of(u) }),
      decoded(
        memo.fetch(module_parameters_query, input),
        parameters_bin(),
        "a module's parameters",
      ),
    ),
    report_bin(),
  )
}

fn owners_of_function(name: Bytes) -> List<OwnerKey> / {memo.read, abort.raise} = {
  let m = named_node(name);
  let shipped = shipped_for(false, m.module);
  declared_of(m.module, shipped, false, m.name).map(|o: Bytes|
    { module: m.module, shipped: shipped, tested: false, owner: o })
}

fn hashed_nodes(o: OwnerKey) -> List<CachedNode> / {memo.read, abort.raise} = {
  let e = memo.fetch(owner_hash_query, bin::encode(o, owner_key_bin()));
  if e.len() == 0 { [] } else { decoded(e, hash_entry_bin(), "a hash entry").cached_nodes }
}

pub fn hash_of_definition(name: Bytes) -> Option<Bytes> / {memo.read, abort.raise} =
  owners_of_function(name).fold(None, |found: Option<Bytes>, o: OwnerKey|
    hashed_nodes(o).fold(found, |h: Option<Bytes>, n: CachedNode|
      if n.name == name && !n.declaration { Some(n.hash) } else { h }))

fn states_clauses(o: OwnerKey) -> Bool / {memo.read, abort.raise} =
  hashed_nodes(o).any(|n: CachedNode| n.specs.len() > 0)

fn functions_used_by(o: OwnerKey) -> List<OwnerKey> / {memo.read, abort.raise} =
  hashed_nodes(o).fold([], |accumulator: List<OwnerKey>, n: CachedNode|
    n.edges.concat(n.clauses).fold(accumulator, |a: List<OwnerKey>, r: NodeRef|
      if r.declaration { a } else { a.concat(owners_of_function(r.name)) }))

fn body_key(o: OwnerKey) -> Bytes = mention_key({ module: o.module, name: o.owner })

fn bodies_reached(start: List<OwnerKey>) -> Map<Bytes, OwnerKey> / {memo.read, abort.raise} =
  iterate(
    { seen: Map::new(), work: start },
    1000000,
    |s: { seen: Map<Bytes, OwnerKey>, work: List<OwnerKey> }|
      match s.work {
        [] -> Stop(s.seen),
        [o, ..rest] -> if s.seen.contains(body_key(o)) { Continue({ ..s, work: rest }) }
        else if !in_root(o.module) && !states_clauses(o) { Continue({ ..s, work: rest }) } else {
          Continue({
            seen: s.seen.insert(body_key(o), o),
            work: if in_root(o.module) { rest.concat(functions_used_by(o)) } else { rest },
          })
        },
      },
  )

fn groups_reached(u: GroupKey) -> List<GroupKey> / {memo.read, abort.raise} = {
  let by_module = bodies_reached(u.owners.map(|o: Bytes| owner_at(u, o))).values().fold(
    Map::new(),
    |found: Map<Bytes, GroupKey>, o: OwnerKey|
      found.insert(o.module, match found.get(o.module) {
        Some(g) -> { ..g, owners: g.owners.push(o.owner) },
        None -> { module: o.module, shipped: o.shipped, tested: o.tested, owners: [o.owner] },
      }),
  );
  [match by_module.get(u.module) { Some(g) -> g, None -> u }].concat(
    by_module.values().filter(|g: GroupKey| g.module != u.module),
  )
}

fn source_of_unit(u: GroupKey) -> GroupSource / {SessionReads, abort.raise} = {
  let members = unit_members(u);
  { named: module_of_unit(u), members: members, imported: imports_for_unit(u, members) }
}

fn with_stored_tables(
  a: Analysis,
  mentioned: List<Mention>,
) -> Analysis / {CheckReads, abort.raise} = {
  let known = known_of_types(
    mentioned.map(|m: Mention| qualify(m.module, m.name)).concat(
      a.checked.definitions.flat_map(|d: DefinitionInfo| type_names(d.scheme.ty)),
    ),
  );
  let read = mentioned.fold(
    { definitions: a.checked.definitions, effects: a.checked.effects },
    |found: { definitions: List<DefinitionInfo>, effects: List<EffectInfo> }, m: Mention| {
      let name = qualify(m.module, m.name);
      {
        definitions: match program.definition_named(name) {
          Some(facts) -> match facts.definition {
            Some(d) -> found.definitions.push(d),
            None -> found.definitions,
          },
          None -> found.definitions,
        },
        effects: match program.effect_named(name) {
          Some(e) -> found.effects.push(e),
          None -> found.effects,
        },
      }
    },
  );
  {
    ..a,
    checked: {
      ..a.checked,
      definitions: read.definitions,
      effects: read.effects,
      constructors: a.checked.constructors.concat(known.constructors).unique(),
      instances: a.checked.instances.concat(known.instances).unique(),
      numeric_types: a.checked.numeric_types.concat(known.numeric).unique(),
    },
    declared: {
      ..a.declared,
      types: known.opaque.fold(
        a.declared.types,
        |found: Map<Bytes, TypeFacts>, n: Bytes, f: TypeFacts|
          if found.contains(n) { found } else { found.insert(n, f) },
      ),
    },
  }
}

pub type MeasureProgram = {
  outcome: AnalysisOutcome,
  measured: List<Bytes>,
  offset: Int,
  owned: List<Bytes>,
}

pub type GroupsAnalysed = { outcome: AnalysisOutcome, offset: Int, loaded: List<OwnerSource> }

fn groups_analysed(groups: List<GroupKey>) -> GroupsAnalysed / {SessionReads, abort.raise} =
  with_group_read(groups.map(source_of_unit), always_entire, no_bodies, [], |group: GroupRead| {
    let checked = checked_group(group.inputs, group.walks);
    {
      outcome: match checked.pulled.out {
        Rejected(ds) -> Rejected(ds),
        Analysed(a) -> Analysed(with_stored_tables(a, with_performed_effects(group.mentioned))),
      },
      offset: group.inputs.loaded.get(0).source.offset,
      loaded: group.inputs.loaded.map(|l: LoadedSource| l.source),
    }
  })

pub type PlacedModule = { module: Bytes, offset: Int, items: List<ItemAt> }

pub type ClaimsProgram = { outcome: AnalysisOutcome, placed: List<PlacedModule> }

fn placed_module(g: GroupKey, offset: Int) -> PlacedModule / {memo.read, abort.raise} = {
  let named = module_of_unit(g);
  let facts = placed_facts(named, layout_of(named));
  {
    module: g.module,
    offset: offset,
    items: item_layout(
      g.owners.map(|o: Bytes|
        match facts.get(o) {
          Some(f) -> f.text,
          None -> panic("a group names a declaration that its module's layout does not place"),
        }),
    ),
  }
}

pub fn claims_analysed(open: List<ModuleKey>) -> ClaimsProgram / {SessionReads, abort.raise} = {
  let whole = open.map(|m: ModuleKey|
    { module: m.module, shipped: m.shipped, tested: m.tested, owners: owners_result_of(m).owners });
  let opened = open.fold(Map::new(), |found: Map<Bytes, Bool>, m: ModuleKey|
    found.insert(m.module, true));
  let reached = bodies_reached(
    whole.flat_map(|u: GroupKey| u.owners.map(|o: Bytes| owner_at(u, o))),
  ).values(
  ).filter(|o: OwnerKey| !opened.contains(o.module)).fold(
    Map::new(),
    |found: Map<Bytes, GroupKey>, o: OwnerKey|
      found.insert(o.module, match found.get(o.module) {
        Some(g) -> { ..g, owners: g.owners.push(o.owner) },
        None -> { module: o.module, shipped: o.shipped, tested: o.tested, owners: [o.owner] },
      }),
  );
  let groups = whole.concat(reached.values());
  let analysed = groups_analysed(groups);
  {
    outcome: analysed.outcome,
    placed: range(0, groups.len()).map(|i: Int|
      placed_module(groups.get(i), analysed.loaded.get(i).offset)),
  }
}

pub fn measure_program(u: GroupKey) -> MeasureProgram / {QueryEffects, abort.raise} = {
  let groups = groups_reached(u);
  let analysed = groups_analysed(groups);
  {
    outcome: analysed.outcome,
    measured: measured_in(u, owners_result_of(module_of_unit(u))),
    offset: analysed.offset,
    owned: groups.map(|g: GroupKey| g.module).filter(|m: Bytes| m == u.module || in_root(m)),
  }
}

fn measured_in(u: GroupKey, read: OwnersResult) -> List<Bytes> =
  read.shape.outline.items.fold([], |found: List<Bytes>, item: OutlineItem|
    match item {
      OutlinedFunction(f) -> if !f.measured { found } else {
        let owners = match read.declared.get(f.name) { Some(os) -> os, None -> [] };
        if owners.any(|o: Bytes| u.owners.contains(o)) { found.push(qualify(u.module, f.name)) }
        else { found }
      },
      _ -> found,
    })

pub type MeasureEntry = { unit: GroupKey, items: List<ItemAt> }

derive bin for MeasureEntry

pub fn measures_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_result_of(named);
  let measured = functions_of(read, measured_function);
  bin::encode(
    if measured.len() == 0 { [] } else {
      let facts = placed_facts(named, layout_of(named));
      group_keys(named, read).filter(|u: GroupKey|
        u.owners.any(|o: Bytes| measured.contains(o))).map(|u: GroupKey|
        {
          unit: u,
          items: item_layout(
            u.owners.fold([], |texts: List<OwnerText>, o: Bytes|
              match facts.get(o) { Some(f) -> texts.push(f.text), None -> texts }),
          ),
        })
    },
    bin::list_bin(measure_entry_bin()),
  )
}

pub fn promise_queries() -> List<{ name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {QueryEffects, abort.raise} }> =
  [
    {
      name: cost_walk_query,
      definition: b"compiler.front.checking.promises.cost_walk_result",
      body: cost_walk_result,
    },
    {
      name: cost_return_query,
      definition: b"compiler.front.checking.promises.cost_return_result",
      body: cost_return_result,
    },
    {
      name: cost_demands_query,
      definition: b"compiler.front.checking.promises.cost_demands_result",
      body: cost_demands_result,
    },
    {
      name: cost_parameters_query,
      definition: b"compiler.front.checking.promises.cost_parameters_result",
      body: cost_parameters_result,
    },
    {
      name: module_parameters_query,
      definition: b"compiler.front.checking.promises.module_parameters_result",
      body: module_parameters_result,
    },
    {
      name: module_costs_query,
      definition: b"compiler.front.checking.promises.module_costs_result",
      body: module_costs_result,
    },
    {
      name: measures_query,
      definition: b"compiler.front.checking.promises.measures_result",
      body: measures_result,
    },
  ]
