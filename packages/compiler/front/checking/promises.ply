                                       always_entire, with_performed_effects, known_of_types,
                                       declared_of, group_key_bin, layout_of, placed_facts,
                                       group_keys, no_bodies, owner_facts, owner_hash_query,
                                       owner_key_bin, owners_result_of, with_group_read, GroupRead,
                                       unit_key_of, group_key_of, group_of, group_hashes_of, Entire,
                                       stored_declarations_of, context_once, hashes_query)

pub fn cost_walk_query() -> QueryOf<GroupKey, GroupWalk> =
  { name: b"cost walk", input: group_key_bin(), output: group_walk_bin() }

pub fn cost_return_query() -> QueryOf<InterfaceKey, ReturnOwnership> =
  { name: b"cost return", input: interface_key_bin(), output: return_ownership_bin() }

pub fn cost_demands_query() -> QueryOf<ModuleKey, ModuleDemands> =
  { name: b"cost demands", input: module_key_bin(), output: module_demands_bin() }

pub fn cost_parameters_query() -> QueryOf<Unit, Parameters> =
  { name: b"cost parameters", input: bin::unit_bin(), output: parameters_bin() }

pub fn module_parameters_query() -> QueryOf<ModuleKey, Parameters> =
  { name: b"module parameters", input: module_key_bin(), output: parameters_bin() }

pub fn module_costs_query() -> QueryOf<ModuleKey, Report> =
  { name: b"module costs", input: module_key_bin(), output: report_bin() }

pub const measure_name: Bytes = b"measure"

pub fn measures_query() -> QueryOf<ModuleKey, List<MeasureEntry>> =
  { name: b"measures", input: module_key_bin(), output: bin::list_bin(measure_entry_bin()) }

fn in_root(module: Bytes) -> Bool / {memo.read, abort.raise} =
  match package_location_of(module) { Some(p) -> p.package == 0, None -> false }

fn root_modules() -> List<Bytes> / {memo.read, abort.raise} =
  (match memo.external(own_modules_kind, b"") {
    Some(b) -> decoded(b, bin::list_bin(bin::bytes_bin()), "the program's modules"),
    None -> [],
  }).filter(
    in_root,
  )

fn module_of_unit(u: GroupKey) -> ModuleKey =
  { module: u.module, shipped: u.shipped, tested: u.tested }

fn root_module(module: Bytes) -> ModuleKey = { module: module, shipped: false, tested: false }

fn owner_at(u: GroupKey, owner: Bytes) -> OwnerKey =
  { module: u.module, shipped: u.shipped, tested: u.tested, owner: owner }

fn functions_of(read: OwnersResult, wanted: (OutlineItem) -> Bool) -> Set<Bytes> =
  read.shape.outline.items.fold(Set::empty(), |found: Set<Bytes>, item: OutlineItem|
    match item {
      OutlinedFunction(f) -> if !wanted(item) { found } else {
        List::fold(
          match read.declared.get(f.name) { Some(owners) -> owners, None -> [] },
          found,
          |m: Set<Bytes>, o: Bytes| m.insert(o),
        )
      },
      _ -> found,
    })

fn any_function(_: OutlineItem) -> Bool = true

fn measured_function(item: OutlineItem) -> Bool =
  match item { OutlinedFunction(f) -> f.measured, _ -> false }

fn is_test_or_law(owner: Bytes) -> Bool = owner.starts_with(b"test ") || owner.starts_with(b"law ")

fn walked_units(named: ModuleKey, read: OwnersResult) -> List<GroupKey> = {
  let bodied = functions_of(read, any_function);
  group_keys(named, read).filter(|u: GroupKey|
    u.owners.any(|o: Bytes| bodied.contains(o) || is_test_or_law(o)))
}

fn unit_members(u: GroupKey) -> List<OwnerFacts> / {memo.read, abort.raise} =
  u.owners.map(|o: Bytes| owner_facts(module_of_unit(u), o))

fn imports_for_unit(
  u: GroupKey,
  members: List<OwnerFacts>,
) -> List<Imported> / {SessionReads, abort.raise} = {
  let context = context_once(module_of_unit(u));
  group_imports(
    u.module,
    members.map(|f: OwnerFacts| f.text),
    members.fold([], |accumulator: List<Mention>, f: OwnerFacts| accumulator.concat(f.mentions)),
    context.imports,
    context.targets,
  )
}

fn unit_roots(m: ParsedModule, source: OwnerSource) -> Set<Bytes> / {abort.raise} =
  m.module.items.fold(Set::empty(), |roots: Set<Bytes>, item: Item| {
    let start = item_span(item).start - source.offset;
    let inside = source.items.any(|x: ItemAt| x.from <= start && start < x.from + x.len);
    if !inside { roots } else {
      match item {
        FunctionItem(_) -> roots.insert(item_owner(m.name, item)),
        TestItem(_) -> roots.insert(item_owner(m.name, item)),
        LawItem(_) -> roots.insert(item_owner(m.name, item)),
        _ -> roots,
      }
    }
  })

fn returned_by(name: Bytes) -> ReturnOwnership / {memo.read, abort.raise} = {
  let m = named_node(name);
  fetched(cost_return_query(), { module: m.module, shipped: false, full_text: false, name: m.name })
}

pub fn cost_walk_result(u: GroupKey) -> Written / {QueryEffects, abort.raise} = {
  let read = stored_analysis([u]);
  let source = read.loaded.get(0);
  let unwalked = { ok: false, bodies: [], declared: [] };
  written(cost_walk_query(), match read.outcome {
    Rejected(_) -> unwalked,
    Analysed(w) -> handle {
      with_code_reads(u.tested, ||
        walked_group(
          {
            ..cost_input_of(w),
            walked: [0],
            roots: Some(unit_roots(w.modules.get(0), source)),
            origin: source.offset,
          },
          returned_by,
        ))
    } with {
      lowering.fail(_) -> unwalked,
    },
  })
}

fn walk_of(u: GroupKey) -> GroupWalk / {memo.read, abort.raise} = fetched(cost_walk_query(), u)

pub fn cost_return_result(key: InterfaceKey) -> Written / {memo.read, abort.raise} = {
  let definition = qualify(key.module, key.name);
  written(
    cost_return_query(),
    declared_of(key.module, key.shipped, key.full_text, key.name).fold(
      FreshReturn,
      |found: ReturnOwnership, o: Bytes|
        match walk_of(
            unit_key_of({
              module: key.module,
              shipped: key.shipped,
              tested: key.full_text,
              owner: o,
            }),
          ).bodies.find(|b: WalkedBody| b.definition == Some(definition)) {
          Some(b) -> b.returned,
          None -> found,
        },
    ),
  )
}

pub fn cost_demands_result(named: ModuleKey) -> Written / {memo.read, abort.raise} =
  written(
    cost_demands_query(),
    demands_of(walked_units(named, owners_result_of(named)).map(walk_of)),
  )

pub fn cost_parameters_result(_: Unit) -> Written / {memo.read, abort.raise} =
  written(
    cost_parameters_query(),
    parameters_of(root_modules().map(|m: Bytes| fetched(cost_demands_query(), root_module(m)))),
  )

pub fn module_parameters_result(named: ModuleKey) -> Written / {memo.read, abort.raise} = {
  let all = fetched(cost_parameters_query(), ());
  written(module_parameters_query(), {
    ..all,
    table: all.table.fold(
      Map::new(),
      |own_slots: Map<Bytes, Map<Int, ParamSharing>>, name: Bytes, slots: Map<Int, ParamSharing>|
        if named_node(name).module == named.module { own_slots.insert(name, slots) }
        else { own_slots },
    ),
  })
}

pub fn module_costs_result(named: ModuleKey) -> Written / {memo.read, abort.raise} = {
  let read = owners_result_of(named);
  let facts = placed_facts(named, layout_of(named));
  let text_of = |o: Bytes|
    match facts.get(o) {
      Some(f) -> f.text,
      None -> panic("a unit names a declaration that its module does not hold"),
    };
  written(
    module_costs_query(),
    module_costs(
      walked_units(named, read).map(|u: GroupKey|
        { items: item_layout(u.owners.map(text_of)), walk: walk_of(u) }),
      fetched(module_parameters_query(), named),
    ),
  )
}

fn owners_of_function(name: Bytes) -> List<OwnerKey> / {memo.read, abort.raise} = {
  let m = named_node(name);
  let shipped = shipped_for(false, m.module);
  declared_of(m.module, shipped, false, m.name).map(|o: Bytes|
    { module: m.module, shipped: shipped, tested: false, owner: o })
}

fn hashed_nodes(o: OwnerKey) -> List<DefinitionHash> / {memo.read, abort.raise} =
  fetched(owner_hash_query(), o).definitions

fn states_clauses(o: OwnerKey) -> Bool / {memo.read, abort.raise} =
  hashed_nodes(o).any(|n: DefinitionHash| n.clauses.len() > 0)

fn references_of(o: OwnerKey) -> List<NodeRef> / {memo.read, abort.raise} =
  if is_test_or_law(o.owner) {
    let own = group_hashes_of(unit_key_of(o));
    own.tests.flat_map(test_uses).concat(own.laws.flat_map(|l: LawHash| l.uses))
  } else { hashed_nodes(o).flat_map(|n: DefinitionHash| n.uses.concat(n.clause_uses)) }

fn functions_used_by(o: OwnerKey) -> List<OwnerKey> / {memo.read, abort.raise} =
  references_of(o).fold([], |accumulator: List<OwnerKey>, r: NodeRef|
    if r.kind != HeldValue { accumulator } else { accumulator.concat(owners_of_function(r.name)) })

fn body_key(o: OwnerKey) -> Bytes = mention_key({ module: o.module, name: o.owner })

fn bodies_reached(start: List<OwnerKey>) -> Map<Bytes, OwnerKey> / {memo.read, abort.raise} =
  iterate(
    { seen: Map::new(), work: start },
    1000000,
    |s: { seen: Map<Bytes, OwnerKey>, work: List<OwnerKey> }|
      match s.work {
        [] -> Stop(s.seen),
        [o, ..rest] -> if s.seen.contains(body_key(o)) { Continue({ ..s, work: rest }) }
        else if !in_root(o.module) && !states_clauses(o) { Continue({ ..s, work: rest }) } else {
          Continue({
            seen: s.seen.insert(body_key(o), o),
            work: if in_root(o.module) { rest.concat(functions_used_by(o)) } else { rest },
          })
        },
      },
  )

fn groups_reached(u: GroupKey) -> List<GroupKey> / {memo.read, abort.raise} = {
  let by_module = bodies_reached(u.owners.map(|o: Bytes| owner_at(u, o))).values().fold(
    Map::new(),
    |found: Map<Bytes, GroupKey>, o: OwnerKey|
      found.insert(o.module, match found.get(o.module) {
        Some(g) -> { ..g, owners: g.owners.push(o.owner) },
        None -> { module: o.module, shipped: o.shipped, tested: o.tested, owners: [o.owner] },
      }),
  );
  [match by_module.get(u.module) { Some(g) -> g, None -> u }].concat(
    by_module.values().filter(|g: GroupKey| g.module != u.module),
  )
}

fn source_of_unit(u: GroupKey) -> GroupSource / {SessionReads, abort.raise} = {
  let members = unit_members(u);
  { named: module_of_unit(u), members: members, imported: imports_for_unit(u, members) }
}

fn with_stored_tables(
  a: Analysis,
  mentioned: List<Mention>,
) -> Analysis / {CheckReads, abort.raise} = {
  let known = known_of_types(
    mentioned.map(|m: Mention| qualify(m.module, m.name)).concat(
      a.checked.definitions.flat_map(|d: DefinitionInfo| type_names(d.scheme.ty)),
    ),
  );
  let read = mentioned.fold(
    { definitions: a.checked.definitions, effects: a.checked.effects },
    |found: { definitions: List<DefinitionInfo>, effects: List<EffectInfo> }, m: Mention| {
      let name = qualify(m.module, m.name);
      {
        definitions: match program.definition_named(name) {
          Some(facts) -> match facts.implementation {
            Checked(d, _) -> found.definitions.push(d),
            _ -> found.definitions,
          },
          None -> found.definitions,
        },
        effects: match program.effect_named(name) {
          Some(e) -> found.effects.push(e),
          None -> found.effects,
        },
      }
    },
  );
  {
    ..a,
    checked: {
      ..a.checked,
      definitions: read.definitions,
      effects: read.effects,
      constructors: a.checked.constructors.concat(known.constructors).unique(),
      instances: a.checked.instances.concat(known.instances).unique(),
      numeric_types: a.checked.numeric_types.concat(known.numeric).unique(),
    },
    declared: {
      ..a.declared,
      types: known.opaque.fold(
        a.declared.types,
        |found: Map<Bytes, TypeFacts>, n: Bytes, f: TypeFacts|
          if found.contains(n) { found } else { found.insert(n, f) },
      ),
    },
  }
}

pub type MeasureProgram = {
  outcome: AnalysisOutcome,
  measured: List<Bytes>,
  offset: Int,
  owned: List<Bytes>,
}

type GroupsAnalysed = { outcome: AnalysisOutcome, offset: Int, loaded: List<OwnerSource> }

type StoredTables = {
  parts: Map<Int, List<PlacedTables>>,
  rejected: List<Diagnostic>,
  declared: StoredDeclarations,
  own: OwnHashes,
  seen: Set<Bytes>,
}

fn with_stored_owner(
  found: StoredTables,
  module: Int,
  u: GroupKey,
  loaded: OwnerSource,
  owner: Bytes,
) -> StoredTables / {SessionReads, abort.raise} = {
  let at = owner_at(u, owner);
  let checked_in = group_key_of(at);
  let result = group_of(checked_in);
  let stored = item_layout(
    checked_in.owners.map(|o: Bytes| owner_facts(module_of_unit(u), o).text),
  );
  let placed = laid_out(loaded.items, loaded.offset);
  let seen = bin::encode(checked_in, group_key_bin());
  let first = !found.seen.contains(seen);
  let own = if first { group_hashes_of(checked_in) } else { no_own_hashes };
  {
    parts: found.parts.insert(
      module,
      found.parts.get(module).unwrap_or([]).concat(
        result.members.filter(|m: MemberResult| m.owner == owner).map(|m: MemberResult|
          { module: module, tables: tables_in(m, stored, placed) }),
      ),
    ),
    rejected: if !first { found.rejected } else {
      found.rejected.concat(
        rejected_in(result.rejected, stored, placed).map(|d: Diagnostic| placed_in(d, module)),
      )
    },
    declared: declarations_joined(found.declared, stored_declarations_of(at, Entire)),
    own: joined_own_hashes([found.own, own]),
    seen: found.seen.insert(seen),
  }
}

fn stored_tables(
  groups: List<GroupKey>,
  loaded: List<OwnerSource>,
) -> StoredTables / {SessionReads, abort.raise} =
  range(0, groups.len()).fold(
    {
      parts: Map::new(),
      rejected: [],
      declared: no_stored_declarations,
      own: no_own_hashes,
      seen: Set::empty(),
    },
    |found: StoredTables, i: Int|
      groups.get(i).owners.fold(found, |f: StoredTables, o: Bytes|
        with_stored_owner(f, i, groups.get(i), loaded.get(i), o)),
  )

fn stored_analysis(groups: List<GroupKey>) -> GroupsAnalysed / {SessionReads, abort.raise} =
  with_group_read(groups.map(source_of_unit), always_entire, no_bodies, [], |group: GroupRead| {
    let loaded = group.inputs.loaded.map(|l: LoadedSource| l.source);
    {
      outcome: match resolved_group(group.inputs) {
        Err(ds) -> Rejected(ds),
        Ok(resolved) -> if resolved.problems.len() > 0 { Rejected(resolved.problems) } else {
          let read = stored_tables(groups, loaded);
          if read.rejected.len() > 0 { Rejected(read.rejected) } else {
            Analysed(
              with_stored_tables(
                hashed_analysis(
                  group_analysis(
                    resolved,
                    checked_of_parts(
                      resolved.resolution.order.flat_map(|i: Int| read.parts.get(i).unwrap_or([])),
                    ),
                    [],
                    read.declared,
                    unreached(resolved.uses),
                  ),
                  hash_output(hash_layout(resolved.index), read.own),
                ),
                with_performed_effects(group.mentioned),
              ),
            )
          }
        },
      },
      offset: loaded.get(0).offset,
      loaded: loaded,
    }
  })

pub type PlacedModule = { module: Bytes, offset: Int, items: List<ItemAt> }

pub type ClaimsProgram = { outcome: AnalysisOutcome, placed: List<PlacedModule> }

fn placed_module(g: GroupKey, offset: Int) -> PlacedModule / {memo.read, abort.raise} = {
  let named = module_of_unit(g);
  let facts = placed_facts(named, layout_of(named));
  {
    module: g.module,
    offset: offset,
    items: item_layout(
      g.owners.map(|o: Bytes|
        match facts.get(o) {
          Some(f) -> f.text,
          None -> panic("a group names a declaration that its module's layout does not place"),
        }),
    ),
  }
}

pub fn claims_analysed(open: List<ModuleKey>) -> ClaimsProgram / {SessionReads, abort.raise} = {
  let whole = open.map(|m: ModuleKey|
    { module: m.module, shipped: m.shipped, tested: m.tested, owners: owners_result_of(m).owners });
  let opened = open.fold(Set::empty(), |found: Set<Bytes>, m: ModuleKey| found.insert(m.module));
  let reached = bodies_reached(
    whole.flat_map(|u: GroupKey| u.owners.map(|o: Bytes| owner_at(u, o))),
  ).values(
  ).filter(|o: OwnerKey| !opened.contains(o.module)).fold(
    Map::new(),
    |found: Map<Bytes, GroupKey>, o: OwnerKey|
      found.insert(o.module, match found.get(o.module) {
        Some(g) -> { ..g, owners: g.owners.push(o.owner) },
        None -> { module: o.module, shipped: o.shipped, tested: o.tested, owners: [o.owner] },
      }),
  );
  let groups = whole.concat(reached.values());
  let analysed = stored_analysis(groups);
  {
    outcome: match analysed.outcome {
      Analysed(w) ->
        Analysed({
          ..w,
          hashes: {
            ..w.hashes,
            identities: open.flat_map(|m: ModuleKey|
              subject_identities(m, fetched(hashes_query(), m).own)),
          },
        }),
      rejected -> rejected,
    },
    placed: range(0, groups.len()).map(|i: Int|
      placed_module(groups.get(i), analysed.loaded.get(i).offset)),
  }
}

pub fn measure_program(u: GroupKey) -> MeasureProgram / {QueryEffects, abort.raise} = {
  let groups = groups_reached(u);
  let analysed = stored_analysis(groups);
  {
    outcome: analysed.outcome,
    measured: measured_in(u, owners_result_of(module_of_unit(u))),
    offset: analysed.offset,
    owned: groups.map(|g: GroupKey| g.module).filter(|m: Bytes| m == u.module || in_root(m)),
  }
}

fn measured_in(u: GroupKey, read: OwnersResult) -> List<Bytes> =
  read.shape.outline.items.fold([], |found: List<Bytes>, item: OutlineItem|
    match item {
      OutlinedFunction(f) -> if !f.measured { found } else {
        let owners = match read.declared.get(f.name) { Some(os) -> os, None -> [] };
        if owners.any(|o: Bytes| u.owners.contains(o)) { found.push(qualify(u.module, f.name)) }
        else { found }
      },
      _ -> found,
    })

pub type MeasureEntry = { unit: GroupKey, items: List<ItemAt> }

derive bin for MeasureEntry

pub fn measures_result(named: ModuleKey) -> Written / {memo.read, abort.raise} = {
  let read = owners_result_of(named);
  let measured = functions_of(read, measured_function);
  written(measures_query(), if measured.is_empty() { [] } else {
    let facts = placed_facts(named, layout_of(named));
    group_keys(named, read).filter(|u: GroupKey| u.owners.any(|o: Bytes| measured.contains(o))).map(
      |u: GroupKey|
        {
          unit: u,
          items: item_layout(
            u.owners.fold([], |texts: List<OwnerText>, o: Bytes|
              match facts.get(o) { Some(f) -> texts.push(f.text), None -> texts }),
          ),
        },
    )
  })
}

pub fn promise_queries() -> List<CheckDefinition> =
  [
    query_definition(
      cost_walk_query(),
      b"compiler.front.checking.promises.cost_walk_result",
      cost_walk_result,
    ),
    query_definition(
      cost_return_query(),
      b"compiler.front.checking.promises.cost_return_result",
      cost_return_result,
    ),
    query_definition(
      cost_demands_query(),
      b"compiler.front.checking.promises.cost_demands_result",
      cost_demands_result,
    ),
    query_definition(
      cost_parameters_query(),
      b"compiler.front.checking.promises.cost_parameters_result",
      cost_parameters_result,
    ),
    query_definition(
      module_parameters_query(),
      b"compiler.front.checking.promises.module_parameters_result",
      module_parameters_result,
    ),
    query_definition(
      module_costs_query(),
      b"compiler.front.checking.promises.module_costs_result",
      module_costs_result,
    ),
    query_definition(
      measures_query(),
      b"compiler.front.checking.promises.measures_result",
      measures_result,
    ),
  ]
