import std.bin
import std.list
import std.set (Set)
import compiler.store.memo (memo)
import compiler.store.handles (QueryOf, Written, written, fetched, query_definition)
import compiler.store.hash.forms (Identified, TestRun, TestListing, LawRun, LawProof, DefinitionRun,
                                  DefinitionProof, DefinitionContract, identified_bin, NodeRef,
                                  DefinitionHash, TestHash, Begun, Found, InsidePackage,
                                  OutsidePackage, Identities, begun_of, begun_subject,
                                  identity_of_begun, identities_over)
import compiler.front.exports (named_node)
import compiler.front.checking.world (ModuleKey, module_key_bin, Modules, CheckDefinition,
                                      shipped_for, package_location_of)
import compiler.front.checking.groups (OwnerKey, declared_of, hashes_query, owner_hash_query)

pub type SubjectKey = { module: ModuleKey, subject: Identified }

derive bin for SubjectKey

pub fn identity_query() -> QueryOf<SubjectKey, Option<Bytes>> =
  { name: b"identity", input: subject_key_bin(), output: bin::option_bin(bin::bytes_bin()) }

pub fn identity_of(key: SubjectKey) -> Option<Bytes> / {memo.read, abort.raise} =
  fetched(identity_query(), key)

pub type TestIdentity = { run: Bytes, listing: Option<Bytes> }

pub fn test_identities(
  modules: Modules,
  keys: List<Bytes>,
) -> Map<Bytes, TestIdentity> / {memo.read, abort.raise} = {
  let wanted = Set::of_list(keys);
  modules.own.fold(Map::new(), |found: Map<Bytes, TestIdentity>, m: Bytes| {
    let module = { module: m, shipped: false, tested: false };
    let subject = |s: Identified| identity_of({ module: module, subject: s });
    fetched(hashes_query(), module).own.tests.fold(
      found,
      |f: Map<Bytes, TestIdentity>, t: TestHash|
        if !wanted.contains(t.key) { f } else {
          match subject(TestRun(t.key)) {
            None -> panic("a test of the module's own hashes has no identity"),
            Some(run) ->
              f.insert(t.key, {
                run: run,
                listing: match t.listing { Some(_) -> subject(TestListing(t.key)), None -> None },
              }),
          }
        },
    )
  })
}

pub fn module_identities(module: ModuleKey) -> Identities / {memo.read, abort.raise} =
  identities_over(
    begun_of(fetched(hashes_query(), module).own),
    module,
    |_: Identified, at: ModuleKey, reference: NodeRef| found_in(module, at, reference),
  )

fn simple_in(module: Bytes, name: Bytes) -> Bytes / {abort.raise} =
  name.slice(module.len() + 1, name.len())

fn owner_in(module: ModuleKey, owner: Bytes) -> OwnerKey =
  { module: module.module, shipped: module.shipped, tested: module.tested, owner: owner }

fn package_of(key: ModuleKey) -> Option<Int> / {memo.read, abort.raise} =
  if key.shipped { None } else {
    match package_location_of(key.module) { Some(p) -> Some(p.package), None -> None }
  }

fn found_in(
  origin: ModuleKey,
  from: ModuleKey,
  reference: NodeRef,
) -> List<Found<ModuleKey>> / {memo.read, abort.raise} = {
  let m = named_node(reference.name);
  let at = if m.module == from.module { from }
  else { { module: m.module, shipped: shipped_for(from.shipped, m.module), tested: false } };
  let boundary = if package_of(at) == package_of(origin) { InsidePackage } else { OutsidePackage };
  declared_of(at.module, at.shipped, at.tested, m.name).flat_map(|o: Bytes|
    fetched(owner_hash_query(), owner_in(at, o)).definitions.filter(|d: DefinitionHash|
      d.name == reference.name && d.kind == reference.kind).map(|d: DefinitionHash|
      { at: at, definition: d, boundary: boundary }))
}

fn owners_of(key: SubjectKey) -> List<Bytes> / {memo.read, abort.raise} = {
  let module = key.module;
  let declared = |name: Bytes|
    declared_of(module.module, module.shipped, module.tested, named_node(name).name);
  let test = |k: Bytes| [b"test ".concat(simple_in(module.module, k))];
  let law = |k: Bytes| [b"law ".concat(simple_in(module.module, k))];
  match key.subject {
    TestRun(k) -> test(k),
    TestListing(k) -> test(k),
    LawRun(k) -> law(k),
    LawProof(k) -> law(k),
    DefinitionRun(name) -> declared(name),
    DefinitionProof(name) -> declared(name),
    DefinitionContract(reference) -> declared(reference.name),
  }
}

fn begun_for(key: SubjectKey) -> Option<Begun> / {memo.read, abort.raise} =
  match owners_of(key).flat_map(|o: Bytes|
      begun_of(fetched(owner_hash_query(), owner_in(key.module, o))).filter(|b: Begun|
        begun_subject(b) == key.subject)) {
    [] -> None,
    [begun] -> Some(begun),
    _ -> panic("more than one owner of a module defines the same subject"),
  }

pub fn identity_result(key: SubjectKey) -> Written / {memo.read, abort.raise} =
  written(identity_query(), match begun_for(key) {
    None -> None,
    Some(begun) ->
      Some(
        identity_of_begun(begun, key.module, |_: Identified, at: ModuleKey, reference: NodeRef|
          found_in(key.module, at, reference)),
      ),
  })

pub fn identity_queries() -> List<CheckDefinition> =
  [
    query_definition(
      identity_query(),
      b"compiler.front.checking.identity.identity_result",
      identity_result,
    ),
  ]
