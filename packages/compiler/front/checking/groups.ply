pub type OwnerKey = { module: Bytes, shipped: Bool, tested: Bool, owner: Bytes }

pub type GroupKey = { module: Bytes, shipped: Bool, tested: Bool, owners: List<Bytes> }

pub type OwnerFacts = { text: OwnerText, mentions: List<Mention> }

pub type OwnersResult = {
  found: Bool,
  text: Bytes,
  owners: List<{ owner: Bytes, facts: Bytes, starts: List<Int> }>,
  groups: List<List<Bytes>>,
  shapes: List<{ owner: Bytes, facts: Bytes }>,
  signing: List<List<Bytes>>,
  declared: Map<Bytes, List<Bytes>>,
  context: Context,
  shape: ModuleShape,
  order: List<Bytes>,
  recorded: List<Bytes>,
  wanted: List<Mention>,
  publishing: Map<Bytes, List<Mention>>,
  rejecting: Bool,
}

pub type GroupHashes = { entries: Map<Bytes, HashEntry>, fixing: CachedHashes }

derive bin for OwnerKey

derive bin for GroupKey

derive bin for OwnerFacts

derive bin for OwnersResult

derive bin for GroupHashes

pub fn owners_query() -> Bytes = b"owners"

pub fn owner_query() -> Bytes = b"owner"

pub fn unit_of_query() -> Bytes = b"unit of"

pub fn calls_query() -> Bytes = b"calls"

pub fn cycles_query() -> Bytes = b"cycles"

pub fn group_of_query() -> Bytes = b"group of"

pub fn shape_query() -> Bytes = b"shape"

pub fn signature_unit_query() -> Bytes = b"sign unit of"

pub fn setting_query() -> Bytes = b"setting"

pub fn group_imports_query() -> Bytes = b"group imports"

pub fn published_query() -> Bytes = b"published"

pub fn visible_modules_query() -> Bytes = b"sees"

pub fn wanted_files_query() -> Bytes = b"wants"

pub fn declared_query() -> Bytes = b"declared"

pub fn group_query() -> Bytes = b"group"

pub fn owner_interface_query() -> Bytes = b"owner entry"

pub fn shown_query() -> Bytes = b"shown"

pub fn signatures_query() -> Bytes = b"signatures"

pub fn signature_query() -> Bytes = b"signature"

pub fn group_interface_query() -> Bytes = b"signed"

pub fn typed_query() -> Bytes = b"typed"

pub fn group_hash_query() -> Bytes = b"group hash"

pub fn owner_hash_query() -> Bytes = b"owner hash"

fn module_key_of(o: OwnerKey) -> ModuleKey =
  { module: o.module, shipped: o.shipped, tested: o.tested }

fn owners_result_of(named: ModuleKey) -> OwnersResult / {memo.read, abort.raise} =
  decoded(
    memo.fetch(owners_query(), bin::encode(named, module_key_bin())),
    owners_result_bin(),
    "a module's owners",
  )

fn no_context() -> Context =
  {
    imports: [],
    targets: [],
    present: [],
    setting: {
      origin: ShippedModule,
      packages: { root: b"", manifest: None, supplied: [] },
      resolved_packages: None,
      tested: false,
      unread: [],
      wanted_texts: [],
      data: [],
      embeds: [],
    },
  }

fn reading_of(c: Setting) -> CheckInputs / {QueryEffects, abort.raise} =
  {
    packages: c.packages,
    checked_packages: c.resolved_packages,
    tested: c.tested,
    unread: c.unread,
    all_sources: c.wanted_texts,
    data: c.data,
    embeds: c.embeds,
    given: c.wanted_texts.map(|source: Source| read_once(source).given),
  }

fn resolved_imports(m: ModuleRead) -> List<Bytes> =
  m.names.concat(m.parsed.module.imports.drop(m.raw.imports.len()).map(import_path)).fold(
    [],
    |accumulator: List<Bytes>, n: Bytes|
      if accumulator.contains(n) || (!m.present.contains(n) && m.names.contains(n)) { accumulator }
      else { accumulator.push(n) },
  )

pub fn owners_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, module_key_bin(), "a module's name");
  let read = match module_read(key) {
    None ->
      {
        found: false,
        text: b"",
        owners: [],
        groups: [],
        shapes: [],
        signing: [],
        declared: Map::new(),
        context: no_context(),
        shape: no_shape(key.module),
        order: [],
        recorded: [],
        wanted: [],
        publishing: Map::new(),
        rejecting: false,
      },
    Some(m) -> {
      let module = m.source.name;
      let scope = module_scope(m.parsed, m.raw, m.names);
      let reads = owner_texts(m.parsed, m.raw, m.source.source_text);
      let mentions = reads.fold(
        Map::new(),
        |accumulator: Map<Bytes, List<Mention>>, o: OwnerText|
          accumulator.insert(
            o.owner,
            owner_mentions(module, scope, o, m.source.source_text, owner_tokens(m.tokens, o)),
          ),
      );
      let imported = resolved_imports(m);
      let items = requests_by_item(m.parsed.module);
      let shapes = reads.map(|o: OwnerText| signature_text(m.raw, o));
      let shape_mentions = range(0, reads.len()).fold(
        Map::new(),
        |accumulator: Map<Bytes, List<Mention>>, k: Int| {
          let o = reads.get(k);
          let lexed = signature_tokens(m.raw, m.tokens, o);
          accumulator.insert(
            o.owner,
            owner_mentions(module, scope, shapes.get(k), m.source.source_text, lexed),
          )
        },
      );
      {
        found: true,
        text: m.source.source_text,
        owners: reads.map(|o: OwnerText|
          {
            owner: o.owner,
            facts: bin::encode(
              {
                text: { ..o, starts: o.starts.map(|_: Int| 0) },
                mentions: match mentions.get(o.owner) { Some(ms) -> ms, None -> [] },
              },
              owner_facts_bin(),
            ),
            starts: o.starts,
          }),
        groups: owner_groups(module, scope, reads.map(|o: OwnerText| o.owner), mentions),
        shapes: shapes.map(|o: OwnerText|
          {
            owner: o.owner,
            facts: bin::encode(
              {
                text: { ..o, starts: o.starts.map(|_: Int| 0) },
                mentions: match shape_mentions.get(o.owner) { Some(ms) -> ms, None -> [] },
              },
              owner_facts_bin(),
            ),
          }),
        signing: owner_groups(module, scope, reads.map(|o: OwnerText| o.owner), shape_mentions),
        declared: scope.written.owners,
        context: {
          imports: unplaced_imports(m.raw),
          targets: m.names,
          present: m.present,
          setting: {
            origin: m.placed,
            packages: m.reading.packages,
            resolved_packages: m.reading.checked_packages,
            tested: m.reading.tested,
            unread: m.reading.unread,
            wanted_texts: m.reading.all_sources,
            data: m.reading.data,
            embeds: m.reading.embeds,
          },
        },
        shape: {
          outline: {
            let o = read_outline(m.parsed);
            if m.reading.tested { o } else {
              {
                ..o,
                items: o.items.filter(|x: OutlineItem|
                  match x { OutlinedTest(_) -> false, OutlinedLaw(_) -> false, _ -> true }),
              }
            }
          },
          imports: imported,
          unimported: m.unimported,
          named: named_imports(m.parsed, imported),
          written: m.parsed.module.imports.map(import_module_name).concat(
            m.present.filter(|p: Bytes| !m.names.contains(p)),
          ),
          embeds: [],
          embed_items: if items.fold(false, |b: Bool, x: ItemEmbeds| b || x.wants.len() > 0) {
            items
          } else { [] },
          tagged: [],
          statements: [],
          consts: [],
        },
        order: checked_functions(m.parsed),
        recorded: check_order(m.parsed),
        wanted: imported_mentions_in(m.parsed, m.raw, m.source.source_text, m.tokens, m.names),
        publishing: m.parsed.module.items.fold(
          Map::new(),
          |accumulator: Map<Bytes, List<Mention>>, item: Item|
            match item {
              TypeItem(d) -> match d.opaque {
                Some(opaque_type) ->
                  accumulator.insert(
                    d.name.name,
                    opaque_type.result.concat(opaque_type.take).map(|f: Bytes|
                      { module: module, name: f }),
                  ),
                None -> accumulator,
              },
              _ -> accumulator,
            },
        ),
        rejecting: m.reading.given.fold(false, |b: Bool, g: ParsedSource|
            b || g.diagnostics.fold(false, |c: Bool, d: Diagnostic| c || d.severity == b"error"))
          || m.names.any(|n: Bytes| !m.present.contains(n))
          || colliding(m.raw.imports).len() > 0,
      }
    },
  };
  prefill_projections(key, read);
  bin::encode(read, owners_result_bin())
}

pub fn owner_facts_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  match written_by_owners(named) {
    Some(o) -> o,
    None -> owner_facts_in(owners_result_of(named), key.owner),
  }
}

pub fn visible_modules_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let context = decoded(memo.fetch(context_query(), input), context_bin(), "a module's context");
  let seen = context.present.fold(Map::new(), |accumulator: Map<Bytes, Bool>, m: Bytes|
    visible_modules_of({ module: m, shipped: shipped_for(named.shipped, m), tested: false }).fold(
      accumulator.insert(m, true),
      |a: Map<Bytes, Bool>, below: Bytes| a.insert(below, true),
    ));
  bin::encode(seen.keys(), bin::list_bin(bin::bytes_bin()))
}

fn visible_modules_of(named: ModuleKey) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(visible_modules_query(), bin::encode(named, module_key_bin())),
    bin::list_bin(bin::bytes_bin()),
    "the modules a module can see",
  )

pub fn value_call_modules_query() -> Bytes = b"answering"

pub fn declaring_modules_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, interface_key_bin(), "an entry's name");
  bin::encode(
    visible_modules_of({ module: key.module, shipped: key.shipped, tested: key.full_text }).filter(
      |m: Bytes|
        declared_of(m, shipped_for(key.shipped, m), false, any_module_name(key.name)).len() > 0,
    ),
    bin::list_bin(bin::bytes_bin()),
  )
}

fn value_call_modules(named: ModuleKey, name: Bytes) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      value_call_modules_query(),
      bin::encode(
        { module: named.module, shipped: named.shipped, full_text: named.tested, name: name },
        interface_key_bin(),
      ),
    ),
    bin::list_bin(bin::bytes_bin()),
    "the modules that define a method name",
  )

fn value_call_mentions(
  named: ModuleKey,
  called: List<Bytes>,
) -> List<Mention> / {memo.read, abort.raise} =
  called.fold([], |accumulator: List<Mention>, n: Bytes|
    accumulator.concat(called_of(value_call_modules(named, n), [n])))

pub fn published_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  match written_by_owners(named) {
    Some(o) -> o,
    None ->
      bin::encode(
        match owners_result_of(named).publishing.get(key.owner) { Some(ms) -> ms, None -> [] },
        bin::list_bin(mention_bin()),
      ),
  }
}

pub fn unit_of_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  match written_by_owners(named) {
    Some(o) -> o,
    None ->
      bin::encode(
        group_containing(owners_result_of(named), key.owner),
        bin::list_bin(bin::bytes_bin()),
      ),
  }
}

pub fn calls_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  bin::encode(
    called_owners(
      key.owner,
      owner_checks::called_names(key.module, inference_of(named, key.owner)),
      |n: Bytes| declared_of(key.module, key.shipped, key.tested, n),
    ),
    bin::list_bin(bin::bytes_bin()),
  )
}

fn called_owners<| e>(
  owner: Bytes,
  names: List<Bytes>,
  declared: (Bytes) -> List<Bytes> / {abort.raise | e},
) -> List<Bytes> / {abort.raise | e} =
  sorted_bytes(
    names.fold([], |accumulator: List<Bytes>, n: Bytes|
      declared(n).fold(accumulator, |a: List<Bytes>, o: Bytes|
        if o == owner || a.contains(o) { a } else { a.push(o) })),
  )

fn calls_of(named: ModuleKey, owner: Bytes) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(calls_query(), owner_at(named, owner)),
    bin::list_bin(bin::bytes_bin()),
    "the declarations a declaration calls",
  )

pub fn cycles_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a unit's names");
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  bin::encode(
    if !current_unit(key) { [] }
    else if key.owners.len() < 2 { [key.owners] }
    else { call_cycles(key.owners, key.owners.map(|o: Bytes| calls_of(named, o))) },
    bin::list_bin(bin::list_bin(bin::bytes_bin())),
  )
}

fn cycles_of(unit: GroupKey) -> List<List<Bytes>> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(cycles_query(), bin::encode(unit, group_key_bin())),
    bin::list_bin(bin::list_bin(bin::bytes_bin())),
    "a unit's groups",
  )

pub fn group_of_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let unit = unit_key_of(key);
  bin::encode(
    if unit.owners.len() < 2 { unit.owners } else {
      cycles_of(unit).fold([], |accumulator: List<Bytes>, g: List<Bytes>|
        if g.contains(key.owner) { g } else { accumulator })
    },
    bin::list_bin(bin::bytes_bin()),
  )
}

pub fn shape_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  match written_by_owners(named) {
    Some(o) -> o,
    None -> facts_in(owners_result_of(named), key.owner),
  }
}

pub fn sign_unit_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  match written_by_owners(named) {
    Some(o) -> o,
    None ->
      bin::encode(
        signing_with(owners_result_of(named), key.owner),
        bin::list_bin(bin::bytes_bin()),
      ),
  }
}

pub fn context_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  match written_by_owners(named) {
    Some(o) -> o,
    None -> bin::encode(owners_result_of(named).context, context_bin()),
  }
}

pub fn setting_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  match written_by_owners(named) {
    Some(o) -> o,
    None -> bin::encode(owners_result_of(named).context.setting, setting_bin()),
  }
}

pub fn wants_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let setting = decoded(memo.fetch(setting_query(), input), setting_bin(), "a module's setting");
  bin::encode(
    {
      texts: setting.wanted_texts.map(|s: Source| s.name),
      data: setting.data.map(|d: EmbedFile| d.name),
    },
    shipped_wants_bin(),
  )
}

pub fn group_imports_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a group's names");
  if !current(key) { bin::encode([], bin::list_bin(imported_bin())) } else {
    let named = { module: key.module, shipped: key.shipped, tested: key.tested };
    let context = context_once(named);
    let members = key.owners.map(|o: Bytes| owner_facts(named, o));
    bin::encode(
      group_imports(
        key.module,
        members.map(|f: OwnerFacts| f.text),
        members.fold([], |accumulator: List<Mention>, f: OwnerFacts|
          accumulator.concat(f.mentions)),
        context.imports,
        context.targets,
      ),
      bin::list_bin(imported_bin()),
    )
  }
}

pub fn declared_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, interface_key_bin(), "a declared name's key");
  let named = { module: key.module, shipped: key.shipped, tested: key.full_text };
  match written_by_owners(named) {
    Some(o) -> o,
    None -> if key.name != b"" && !names_of(named).contains(key.name) {
      bin::encode([], bin::list_bin(bin::bytes_bin()))
    } else {
      bin::encode(declared_in(owners_result_of(named), key.name), bin::list_bin(bin::bytes_bin()))
    },
  }
}

pub fn names_query() -> Bytes = b"names"

pub fn names_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  match written_by_owners(named) {
    Some(o) -> o,
    None -> bin::encode(owners_result_of(named).declared.keys(), bin::list_bin(bin::bytes_bin())),
  }
}

fn names_of(named: ModuleKey) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(names_query(), bin::encode(named, module_key_bin())),
    bin::list_bin(bin::bytes_bin()),
    "the names a module declares",
  )

fn written_by_owners(named: ModuleKey) -> Option<Bytes> / {memo.read, abort.raise} =
  memo.written_by(owners_query(), bin::encode(named, module_key_bin()))

fn owners_result_bytes(named: ModuleKey) -> Bytes / {memo.read, abort.raise} =
  memo.fetch(owners_query(), bin::encode(named, module_key_bin()))

fn owners_of(b: Bytes) -> OwnersResult / {abort.raise} =
  decoded(b, owners_result_bin(), "a module's owners")

fn owner_facts_in(read: OwnersResult, owner: Bytes) -> Bytes =
  read.owners.fold(
    b"",
    |accumulator: Bytes, o: { owner: Bytes, facts: Bytes, starts: List<Int> }|
      if o.owner == owner { o.facts } else { accumulator },
  )

fn group_containing(read: OwnersResult, owner: Bytes) -> List<Bytes> =
  read.groups.fold([], |accumulator: List<Bytes>, g: List<Bytes>|
    if g.contains(owner) { g } else { accumulator })

fn facts_in(read: OwnersResult, owner: Bytes) -> Bytes =
  read.shapes.fold(b"", |accumulator: Bytes, o: { owner: Bytes, facts: Bytes }|
    if o.owner == owner { o.facts } else { accumulator })

fn signing_with(read: OwnersResult, owner: Bytes) -> List<Bytes> =
  read.signing.fold([], |accumulator: List<Bytes>, g: List<Bytes>|
    if g.contains(owner) { g } else { accumulator })

fn declared_in(read: OwnersResult, name: Bytes) -> List<Bytes> =
  if name == b"" { read.owners.map(|o: { owner: Bytes, facts: Bytes, starts: List<Int> }| o.owner) }
  else { match read.declared.get(name) { Some(os) -> os, None -> [] } }

fn prefill_projections(named: ModuleKey, read: OwnersResult) -> Unit / {memo.read, abort.raise} = {
  memo.provide(
    context_query(),
    bin::encode(named, module_key_bin()),
    bin::encode(read.context, context_bin()),
  );
  memo.provide(
    setting_query(),
    bin::encode(named, module_key_bin()),
    bin::encode(read.context.setting, setting_bin()),
  );
  memo.provide(
    names_query(),
    bin::encode(named, module_key_bin()),
    bin::encode(read.declared.keys(), bin::list_bin(bin::bytes_bin())),
  );
  prefill_published(named, read);
  prefill_owners(named, read);
  prefill_units(named, read);
  prefill_shapes(named, read);
  prefill_signature_units(named, read);
  prefill_declared(named, read)
}

fn owner_at(named: ModuleKey, owner: Bytes) -> Bytes / {abort.raise} =
  bin::encode(
    { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
    owner_key_bin(),
  )

fn prefill_published(
  named: ModuleKey,
  read: OwnersResult,
) -> Unit / {memo.read, abort.raise} =
  read.publishing.fold((), |_: Unit, owner: Bytes, ms: List<Mention>|
    memo.provide(
      published_query(),
      owner_at(named, owner),
      bin::encode(ms, bin::list_bin(mention_bin())),
    ))

fn prefill_owners(
  named: ModuleKey,
  read: OwnersResult,
) -> Unit / {memo.read, abort.raise} =
  read.owners.fold((), |_: Unit, o: { owner: Bytes, facts: Bytes, starts: List<Int> }|
    memo.provide(owner_query(), owner_at(named, o.owner), o.facts))

fn prefill_units(
  named: ModuleKey,
  read: OwnersResult,
) -> Unit / {memo.read, abort.raise} =
  read.owners.fold((), |_: Unit, o: { owner: Bytes, facts: Bytes, starts: List<Int> }|
    memo.provide(
      unit_of_query(),
      owner_at(named, o.owner),
      bin::encode(group_containing(read, o.owner), bin::list_bin(bin::bytes_bin())),
    ))

fn prefill_shapes(
  named: ModuleKey,
  read: OwnersResult,
) -> Unit / {memo.read, abort.raise} =
  read.shapes.fold((), |_: Unit, o: { owner: Bytes, facts: Bytes }|
    memo.provide(shape_query(), owner_at(named, o.owner), o.facts))

fn prefill_signature_units(
  named: ModuleKey,
  read: OwnersResult,
) -> Unit / {memo.read, abort.raise} =
  read.shapes.fold((), |_: Unit, o: { owner: Bytes, facts: Bytes }|
    memo.provide(
      signature_unit_query(),
      owner_at(named, o.owner),
      bin::encode(signing_with(read, o.owner), bin::list_bin(bin::bytes_bin())),
    ))

fn prefill_declared(
  named: ModuleKey,
  read: OwnersResult,
) -> Unit / {memo.read, abort.raise} =
  read.declared.keys().push(b"").fold((), |_: Unit, name: Bytes|
    memo.provide(
      declared_query(),
      bin::encode(
        { module: named.module, shipped: named.shipped, full_text: named.tested, name: name },
        interface_key_bin(),
      ),
      bin::encode(declared_in(read, name), bin::list_bin(bin::bytes_bin())),
    ))

fn declared_of(
  module: Bytes,
  shipped: Bool,
  tested: Bool,
  name: Bytes,
) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      declared_query(),
      bin::encode(
        { module: module, shipped: shipped, full_text: tested, name: name },
        interface_key_bin(),
      ),
    ),
    bin::list_bin(bin::bytes_bin()),
    "a name's owners",
  )

pub fn owner_facts(named: ModuleKey, owner: Bytes) -> OwnerFacts / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      owner_query(),
      bin::encode(
        { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
        owner_key_bin(),
      ),
    ),
    owner_facts_bin(),
    "a declaration's cached analysis",
  )

pub fn group_result_of(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a group's names");
  if !current(key) { owner_checks::encode_group(owner_checks::no_group()) } else {
    let named = { module: key.module, shipped: key.shipped, tested: key.tested };
    let alone = unit_key_of({
        module: key.module,
        shipped: key.shipped,
        tested: key.tested,
        owner: key.owners.at_or(0, b""),
      }).owners.len(
      )
      < 2;
    match whole_check_result(key) {
      Some(o) -> {
        reads_of(
          named,
          key.owners,
          key.owners.fold([], |accumulator: List<Mention>, x: Bytes|
            accumulator.concat(owner_facts(named, x).mentions)),
          imports_of(key),
          if alone { always_entire } else { sibling_for_called(inferred_calls(named, key)) },
        );
        o
      },
      None -> {
        let members = key.owners.map(|o: Bytes| owner_facts(named, o));
        match rejected_sibling(key, members) {
          Some(o) -> owner_checks::encode_group(blocked_group_result(key, o)),
          None -> if alone {
            let result = checked_group_result(
              key.module,
              unit_checked(named, members, imports_of(key), always_entire, no_bodies),
            );
            prefill_forms(group_query(), key, members.map(|f: OwnerFacts| f.text), result);
            owner_checks::encode_group(result)
          } else { owner_checks::encode_group(finalize_group(named, key, members)) },
        }
      },
    }
  }
}

fn rejected_sibling(
  key: GroupKey,
  members: List<OwnerFacts>,
) -> Option<Bytes> / {QueryEffects, abort.raise} = {
  let at = |o: Bytes| { module: key.module, shipped: key.shipped, tested: key.tested, owner: o };
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  let unit = unit_key_of(at(key.owners.at_or(0, b""))).owners;
  members.fold([], |accumulator: List<Mention>, f: OwnerFacts| accumulator.concat(f.mentions)).fold(
    None,
    |found: Option<Bytes>, m: Mention|
      match found {
        Some(_) -> found,
        None ->
          siblings_named(named, unit, m).find(|o: Bytes|
            match owner_interface_of(at(o)) { Some(_) -> false, None -> true }),
      },
  )
}

fn siblings_named(
  named: ModuleKey,
  inside: List<Bytes>,
  m: Mention,
) -> List<Bytes> / {memo.read, abort.raise} =
  if m.module != named.module { [] } else {
    declared_of(m.module, named.shipped, named.tested, m.name).filter(|o: Bytes|
      !inside.contains(o))
  }

fn blocked_group_result(key: GroupKey, owner: Bytes) -> owner_checks::GroupResult / {abort.raise} =
  {
    ..owner_checks::no_group(),
    rejected: [
      error_at(
        b"E0505",
        0,
        dummy_span(),
        Bytes::concat_all([
          backticked(key.owners, b", "),
          b" waits on `",
          owner,
          b"`, which does not check, and a check of `",
          key.module,
          b"` whole rejects nothing",
        ]),
        b"the check was put off",
        [b"this is Ply's fault, not the program's"],
      ),
    ],
  }

type Sibling = | Entire | BySignature | ByGroupResult

pub fn always_entire(_: Bytes) -> Sibling = Entire

fn by_signature(_: Bytes) -> Sibling = BySignature

type UnitCheck = {
  texts: List<OwnerText>,
  source: OwnerSource,
  out: { pulled: PulledAnalysis, at: Int },
}

type BodySupplier = (OwnerSource) -> Option<(Int) -> BodyChecking / {abort.raise}> / {abort.raise}

fn no_bodies(_: OwnerSource) -> Option<(Int) -> BodyChecking / {abort.raise}> = None

fn inferring_only(walked: List<Bytes>) -> BodySupplier =
  |_: OwnerSource| Some(|_: Int| CheckOnly(walked))

fn unit_checked(
  named: ModuleKey,
  members: List<OwnerFacts>,
  imported: List<Imported>,
  sibling: (Bytes) -> Sibling,
  body_supplier: BodySupplier,
) -> UnitCheck / {QueryEffects, abort.raise} = {
  let checked_of = |published: Bool| {
    let c = owners_check(named, members, imported, published, sibling);
    let source = group_source_from(named.module, c.reads, c.imported, c.needed);
    {
      texts: c.reads,
      source: source,
      out: checked_owner(
        source,
        c.setting.origin,
        module_origin_lookup(c.places),
        reading_of(c.setting),
        walks: body_supplier(source),
      ),
    }
  };
  let first = checked_of(false);
  match first.out.pulled.out { Analysed(_) -> first, Rejected(_) -> checked_of(true) }
}

fn checked_group_result(module: Bytes, c: UnitCheck) -> owner_checks::GroupResult / {abort.raise} =
  owner_checks::group_result(
    c.out.pulled.out,
    c.out.at,
    c.source.source.source_text,
    module,
    c.texts,
    c.source.items,
    |x: ItemAt| c.source.offset + x.from,
  )

pub fn imports_of(key: GroupKey) -> List<Imported> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(group_imports_query(), bin::encode(key, group_key_bin())),
    bin::list_bin(imported_bin()),
    "a group's imports",
  )

fn inferred_calls(named: ModuleKey, key: GroupKey) -> List<Bytes> / {memo.read, abort.raise} =
  called_in(key, key.owners.map(|o: Bytes| { owner: o, typed: inference_of(named, o) }))

fn called_in(
  key: GroupKey,
  walked: List<{ owner: Bytes, typed: owner_checks::InferenceResult }>,
) -> List<Bytes> / {memo.read, abort.raise} =
  walked.fold(
    [],
    |accumulator: List<Bytes>, w: { owner: Bytes, typed: owner_checks::InferenceResult }|
      called_owners(w.owner, owner_checks::called_names(key.module, w.typed), |n: Bytes|
        declared_of(key.module, key.shipped, key.tested, n)).fold(
        accumulator,
        |a: List<Bytes>, c: Bytes|
          if key.owners.contains(c) || a.contains(c) { a } else { a.push(c) },
      ),
  )

fn sibling_for_called(called: List<Bytes>) -> (Bytes) -> Sibling =
  |o: Bytes| if called.contains(o) { ByGroupResult } else { BySignature }

fn finalize_group(
  named: ModuleKey,
  key: GroupKey,
  members: List<OwnerFacts>,
) -> owner_checks::GroupResult / {QueryEffects, abort.raise} = {
  let walked = key.owners.map(|o: Bytes| { owner: o, typed: inference_of(named, o) });
  let rejected = owner_checks::inference_errors(
    walked,
    item_layout(members.map(|f: OwnerFacts| f.text)),
  );
  if rejected.len() > 0 { { ..owner_checks::no_group(), rejected: rejected } } else {
    let c = unit_checked(
      named,
      members,
      imports_of(key),
      sibling_for_called(called_in(key, walked)),
      |source: OwnerSource|
        Some(owner_checks::supplied_bodies(walked, source.items, source.offset)),
    );
    owner_checks::finalized_result(checked_group_result(key.module, c), walked, c.source.items)
  }
}

fn inference_of(
  named: ModuleKey,
  owner: Bytes,
) -> owner_checks::InferenceResult / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      typed_query(),
      bin::encode(
        { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
        owner_key_bin(),
      ),
    ),
    owner_checks::inference_result_bin(),
    "a declaration's type inference",
  )

pub fn signatures_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(
    input,
    group_key_bin(),
    "the declarations whose signatures are checked together",
  );
  if !is_signature_unit(key) {
    bin::encode({ shown: [], rejected: [] }, owner_checks::signature_check_bin())
  } else {
    let named = { module: key.module, shipped: key.shipped, tested: key.tested };
    let offered = whole_check_result(key);
    let members = key.owners.map(|o: Bytes| shape_of(named, o));
    let context = context_once(named);
    let imported = group_imports(
      key.module,
      members.map(|f: OwnerFacts| f.text),
      members.fold([], |accumulator: List<Mention>, f: OwnerFacts| accumulator.concat(f.mentions)),
      context.imports,
      context.targets,
    );
    match offered {
      Some(o) -> {
        reads_of(
          named,
          key.owners,
          members.fold([], |accumulator: List<Mention>, f: OwnerFacts|
            accumulator.concat(f.mentions)),
          imported,
          by_signature,
        );
        o
      },
      None ->
        bin::encode(
          owner_checks::signature_check_of(
            checked_group_result(
              key.module,
              unit_checked(named, members, imported, by_signature, inferring_only([])),
            ),
          ),
          owner_checks::signature_check_bin(),
        ),
    }
  }
}

fn is_signature_unit(g: GroupKey) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      signature_unit_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

fn signature_unit_of(o: OwnerKey) -> GroupKey / {memo.read, abort.raise} =
  {
    module: o.module,
    shipped: o.shipped,
    tested: o.tested,
    owners: decoded(
      memo.fetch(signature_unit_query(), bin::encode(o, owner_key_bin())),
      bin::list_bin(bin::bytes_bin()),
      "the declarations whose signatures are checked together with this declaration",
    ),
  }

fn shape_of(named: ModuleKey, owner: Bytes) -> OwnerFacts / {memo.read, abort.raise} =
  decoded(
    memo.fetch(shape_query(), owner_at(named, owner)),
    owner_facts_bin(),
    "a declaration's text and mentions",
  )

pub fn signature_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let alone = memo.fetch(group_interface_query(), input);
  if alone.len() == 0 { b"" } else {
    with_reach_digest(
      alone,
      dependencies_digest_of(
        key,
        signature_unit_of(key),
        alone,
        group_interface_query(),
        signature_query(),
      ),
    )
  }
}

pub fn group_interface_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  match owner_checks::group_interfaces(
      memo.fetch(signatures_query(), bin::encode(signature_unit_of(key), group_key_bin())),
    ).get(
      key.owner,
    ) {
    Some(entry) -> entry,
    None -> b"",
  }
}

pub fn typed_result_of(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  let g = unit_key_of(key);
  if g.owners.len() < 2 {
    bin::encode(owner_checks::no_inference_result(), owner_checks::inference_result_bin())
  } else {
    let offered = whole_check_result(g);
    let facts = owner_facts(named, key.owner);
    let context = context_once(named);
    let imported = group_imports(
      key.module,
      [facts.text],
      facts.mentions,
      context.imports,
      context.targets,
    );
    match offered {
      Some(o) -> {
        reads_of(named, [key.owner], facts.mentions, imported, by_signature);
        o
      },
      None -> {
        let c = unit_checked(
          named,
          [facts],
          imported,
          by_signature,
          inferring_only(facts.text.names.map(|n: Bytes| qualify(key.module, n))),
        );
        bin::encode(
          owner_checks::inference_result(
            c.out.pulled.out,
            c.out.at,
            c.source.source.source_text,
            key.module,
            facts.text,
            c.source.items,
            |x: ItemAt| c.source.offset + x.from,
          ),
          owner_checks::inference_result_bin(),
        )
      },
    }
  }
}

fn whole_check_result(key: GroupKey) -> Option<Bytes> / {memo.read, abort.raise} = {
  memo.output_digest(
    whole_query(),
    bin::encode({ module: key.module, shipped: key.shipped, tested: key.tested }, module_key_bin()),
  );
  memo.offered()
}

pub fn whole_query() -> Bytes = b"whole"

pub fn whole_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_result_of(named);
  if read.found {
    let called = read.wanted.fold([], |accumulator: List<Bytes>, m: Mention|
      if m.module == b"" { accumulator.push(m.name) } else { accumulator });
    let seen = value_call_mentions(named, called);
    read.wanted.concat(seen).fold((), |_: Unit, m: Mention|
      if m.module == b"" { () } else {
        memo.output_digest(
          owner_interfaces_query(),
          bin::encode(
            {
              module: m.module,
              shipped: shipped_for(named.shipped, m.module),
              full_text: false,
              name: m.name,
            },
            interface_key_bin(),
          ),
        );
        ()
      });
    prefill_from_whole_check(named, read, group_keys(named, read), false);
    ()
  };
  b""
}

fn reads_of(
  named: ModuleKey,
  owners: List<Bytes>,
  mentions: List<Mention>,
  imported: List<Imported>,
  sibling: (Bytes) -> Sibling,
) -> Unit / {memo.read, abort.raise} = {
  memo.fetch(setting_query(), bin::encode(named, module_key_bin()));
  let targets = imported.map(|x: Imported| x.target).push(named.module);
  let selected = imported.fold([], |accumulator: List<Mention>, x: Imported|
    match x.declaration.kind {
      SelectedNames(ns) ->
        accumulator.concat(ns.map(|n: Identifier| { module: x.target, name: n.name })),
      _ -> accumulator,
    });
  let written = selected.concat(mentions);
  let called = written.fold([], |accumulator: List<Bytes>, m: Mention|
    if m.module == b"" && !accumulator.contains(m.name) { accumulator.push(m.name) }
    else { accumulator });
  let all = written.concat(value_call_mentions(named, called));
  let modules = all.fold(Map::new(), |accumulator: Map<Bytes, Bool>, m: Mention|
    if m.module == b"" { accumulator } else if m.module == named.module {
      if !owners.contains(m.name) {
        siblings_named(named, owners, m).fold((), |_: Unit, o: Bytes|
          sibling_read(named, o, sibling(o)))
      };
      accumulator
    } else {
      let found = owner_interface_bytes_of(named.shipped, m.module, m.name);
      if found.len() == 0 && !targets.contains(m.module) && !m.name.starts_with(b"::") {
        owner_interface_bytes_of(named.shipped, m.module, b"");
        ()
      };
      if found.len() == 0 && m.name.starts_with(b"::") { accumulator }
      else { accumulator.insert(m.module, true) }
    });
  module_origins_of(named.shipped, modules.keys());
  ()
}

fn sibling_read(named: ModuleKey, owner: Bytes, how: Sibling) -> Unit / {memo.read, abort.raise} = {
  let at = bin::encode(
    { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
    owner_key_bin(),
  );
  match how {
    Entire -> memo.output_digest(owner_interface_query(), at),
    BySignature -> memo.output_digest(signature_query(), at),
    ByGroupResult -> {
      memo.output_digest(shown_query(), at);
      memo.output_digest(signature_query(), at)
    },
  };
  ()
}

pub type GroupCheck = {
  needed: Map<Bytes, Map<Bytes, OwnerInterface>>,
  imported: List<Imported>,
  places: Map<Bytes, ModuleOrigin>,
  setting: Setting,
  reads: List<OwnerText>,
}

pub fn owners_check(
  named: ModuleKey,
  members: List<OwnerFacts>,
  imported: List<Imported>,
  published: Bool,
  sibling: (Bytes) -> Sibling,
) -> GroupCheck / {QueryEffects, abort.raise} = {
  let key = {
    module: named.module,
    shipped: named.shipped,
    tested: named.tested,
    owners: members.map(|f: OwnerFacts| f.text.owner),
  };
  let setting = decoded(
    memo.fetch(setting_query(), bin::encode(named, module_key_bin())),
    setting_bin(),
    "a module's setting",
  );
  let reads = members.map(|f: OwnerFacts| f.text);
  let entries = |module: Bytes, n: Bytes|
    if module == key.module {
      declared_of(module, key.shipped, key.tested, n).fold(
        [],
        |accumulator: List<OwnerInterface>, o: Bytes|
          if key.owners.contains(o) { accumulator } else {
            let at_o = { module: module, shipped: key.shipped, tested: key.tested, owner: o };
            match match sibling(o) {
                Entire -> owner_interface_of(at_o),
                BySignature -> signature_of(at_o),
                ByGroupResult -> group_interface_of(at_o),
              } {
              Some(e) -> accumulator.push(e),
              None -> accumulator,
            }
          },
      )
    } else { owner_interfaces_of(key.shipped, module, n) };
  let needed = group_needs(
    key.module,
    reads,
    members.fold([], |accumulator: List<Mention>, f: OwnerFacts| accumulator.concat(f.mentions)),
    imported,
    entries,
    interface_header_of,
    |module: Bytes, owner: Bytes|
      if !published || module == key.module { [] }
      else { published_mentions_of(key.shipped, key.module, module, owner) },
    |n: Bytes| value_call_modules(named, n),
  );
  {
    needed: needed,
    imported: imported,
    places: module_origins_of(key.shipped, needed.keys().filter(|m: Bytes| m != key.module)),
    setting: setting,
    reads: reads,
  }
}

pub fn current(g: GroupKey) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      group_key_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

fn group_key_of(o: OwnerKey) -> GroupKey / {memo.read, abort.raise} =
  {
    module: o.module,
    shipped: o.shipped,
    tested: o.tested,
    owners: decoded(
      memo.fetch(group_of_query(), bin::encode(o, owner_key_bin())),
      bin::list_bin(bin::bytes_bin()),
      "the declarations checked together with this declaration",
    ),
  }

pub fn current_unit(g: GroupKey) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      unit_key_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

fn unit_key_of(o: OwnerKey) -> GroupKey / {memo.read, abort.raise} =
  {
    module: o.module,
    shipped: o.shipped,
    tested: o.tested,
    owners: decoded(
      memo.fetch(unit_of_query(), bin::encode(o, owner_key_bin())),
      bin::list_bin(bin::bytes_bin()),
      "the declarations that may form a dependency cycle with this declaration",
    ),
  }

pub fn group_of(g: GroupKey) -> owner_checks::GroupResult / {memo.read, abort.raise} =
  owner_checks::decode_group(
    decoded(
      memo.fetch(group_query(), bin::encode(g, group_key_bin())),
      owner_checks::encoded_group_bin(),
      "a group's result",
    ),
  )

pub fn shown_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  match owner_checks::group_interfaces(
      memo.fetch(group_query(), bin::encode(group_key_of(key), group_key_bin())),
    ).get(
      key.owner,
    ) {
    Some(entry) -> entry,
    None -> memo.fetch(group_interface_query(), input),
  }
}

pub fn owner_interface_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let alone = memo.fetch(shown_query(), input);
  if alone.len() == 0 { b"" } else {
    with_reach_digest(
      alone,
      dependencies_digest_of(key, unit_key_of(key), alone, shown_query(), owner_interface_query()),
    )
  }
}

type ReachSearch = {
  local: Map<Bytes, Bytes>,
  outside: Map<Bytes, Bytes>,
  seen: Map<Bytes, Bool>,
  work: List<Mention>,
}

fn dependencies_digest_of(
  key: OwnerKey,
  g: GroupKey,
  alone: Bytes,
  inside: Bytes,
  beyond: Bytes,
) -> Bytes / {memo.read, abort.raise} = {
  let walked = iterate(
    {
      local: Map::new().insert(key.owner, alone),
      outside: Map::new(),
      seen: Map::new(),
      work: interface_header(alone).mentions,
    },
    1000000,
    |s: ReachSearch|
      match s.work {
        [] -> Stop(s),
        [m, ..rest] -> if s.seen.contains(mention_key(m)) { Continue({ ..s, work: rest }) } else {
          let at = { ..s, seen: s.seen.insert(mention_key(m), true), work: rest };
          Continue(if m.module == b"" {
            {
              ..at,
              work: at.work.concat(
                called_of(value_call_modules(module_key_of(key), m.name).push(key.module), [
                  m.name,
                ]),
              ),
            }
          } else if m.module == key.module {
            declared_of(m.module, key.shipped, key.tested, m.name).fold(
              at,
              |accumulator: ReachSearch, o: Bytes|
                if accumulator.local.contains(o) { accumulator } else if g.owners.contains(o) {
                  let x = memo.fetch(
                    inside,
                    bin::encode(
                      { module: m.module, shipped: key.shipped, tested: key.tested, owner: o },
                      owner_key_bin(),
                    ),
                  );
                  if x.len() == 0 { accumulator } else {
                    {
                      ..accumulator,
                      local: accumulator.local.insert(o, x),
                      work: accumulator.work.concat(interface_header(x).mentions),
                    }
                  }
                } else {
                  let b = memo.fetch(
                    beyond,
                    bin::encode(
                      { module: m.module, shipped: key.shipped, tested: key.tested, owner: o },
                      owner_key_bin(),
                    ),
                  );
                  if b.len() == 0 { accumulator } else {
                    {
                      ..accumulator,
                      outside: accumulator.outside.insert(o, interface_header(b).transitive_digest),
                    }
                  }
                },
            )
          } else {
            let found = owner_interface_bytes_of(key.shipped, m.module, m.name);
            if found.len() == 0 {
              if m.name.starts_with(b"::") { at } else {
                let any = owner_interface_bytes_of(key.shipped, m.module, b"").len() > 0;
                {
                  ..at,
                  outside: at.outside.insert(b"there ".concat(m.module), if any { b"1" }
                  else { b"" }),
                }
              }
            } else {
              found.fold(at, |accumulator: ReachSearch, b: Bytes| {
                let h = interface_header(b);
                {
                  ..accumulator,
                  outside: accumulator.outside.insert(
                    Bytes::concat_all([m.module, b".", h.owner]),
                    h.transitive_digest,
                  ),
                }
              })
            }
          })
        },
      },
  );
  blake3(
    bin::encode(
      [
        if key.shipped { b"" } else {
          bin::encode(module_origin_of(package_location_of(key.module)), module_origin_bin())
        },
        bin::encode(walked.local, bin::map_bin(bin::bytes_bin(), bin::bytes_bin())),
        bin::encode(walked.outside, bin::map_bin(bin::bytes_bin(), bin::bytes_bin())),
      ],
      bin::list_bin(bin::bytes_bin()),
    ),
  )
}

fn signature_of(o: OwnerKey) -> Option<OwnerInterface> / {QueryEffects, abort.raise} =
  match owner_interfaces_once(signature_query(), bin::encode(o, owner_key_bin()), |b: Bytes|
      if b.len() == 0 { [] } else { [decoded(b, owner_interface_bin(), "an entry")] }) {
    [e, ..] -> Some(e),
    [] -> None,
  }

fn group_interface_of(o: OwnerKey) -> Option<OwnerInterface> / {QueryEffects, abort.raise} =
  match owner_interfaces_once(shown_query(), bin::encode(o, owner_key_bin()), |b: Bytes|
      if b.len() == 0 { [] } else { [decoded(b, owner_interface_bin(), "an entry")] }) {
    [e, ..] -> Some(e),
    [] -> None,
  }

fn owner_interface_of(o: OwnerKey) -> Option<OwnerInterface> / {QueryEffects, abort.raise} =
  match owner_interfaces_once(
      owner_interface_query(),
      bin::encode(o, owner_key_bin()),
      |b: Bytes| if b.len() == 0 { [] } else { [decoded(b, owner_interface_bin(), "an entry")] },
    ) {
    [e, ..] -> Some(e),
    [] -> None,
  }

pub fn entry_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, interface_key_bin(), "an entry's name");
  bin::encode(
    declared_of(key.module, key.shipped, key.full_text, key.name).fold(
      [],
      |accumulator: List<Bytes>, o: Bytes| {
        let e = memo.fetch(
          owner_interface_query(),
          bin::encode(
            { module: key.module, shipped: key.shipped, tested: key.full_text, owner: o },
            owner_key_bin(),
          ),
        );
        if e.len() == 0 { accumulator } else { accumulator.push(e) }
      },
    ),
    bin::list_bin(bin::bytes_bin()),
  )
}

fn group_keys(named: ModuleKey, read: OwnersResult) -> List<GroupKey> =
  read.groups.map(|g: List<Bytes>|
    { module: named.module, shipped: named.shipped, tested: named.tested, owners: g })

fn facts_of(read: OwnersResult) -> Map<Bytes, OwnerFacts> / {abort.raise} =
  read.owners.fold(
    Map::new(),
    |accumulator: Map<Bytes, OwnerFacts>, o: { owner: Bytes, facts: Bytes, starts: List<Int> }| {
      let f = decoded(o.facts, owner_facts_bin(), "a declaration's cached analysis");
      accumulator.insert(o.owner, { ..f, text: { ..f.text, starts: o.starts } })
    },
  )

type WholeCheckResult = {
  rejected: Option<List<Diagnostic>>,
  results: Map<Bytes, owner_checks::GroupResult>,
}

fn alone_costs() -> Int = 16

fn whole_pays(missing: Int, groups: Int) -> Bool = missing > 1 && missing * alone_costs() >= groups

fn prefill_from_whole_check(
  named: ModuleKey,
  read: OwnersResult,
  groups: List<GroupKey>,
  explaining: Bool,
) -> WholeCheckResult / {QueryEffects, abort.raise} = {
  let missing = groups.fold(Map::new(), |accumulator: Map<Bytes, Bool>, g: GroupKey| {
    let at_g = bin::encode(g, group_key_bin());
    if memo.is_cached(if g.owners.len() < 2 { group_query() } else { cycles_query() }, at_g) {
      accumulator
    } else { accumulator.insert(at_g, true) }
  });
  if !whole_pays(missing.len(), groups.len()) { { rejected: None, results: Map::new() } } else {
    let facts = facts_of(read);
    let module = named.module;
    let parse = read_once({ name: module, source_text: read.text });
    let checked = checked_whole(named, read, false, [parse.given]);
    match checked.pulled.out {
      Rejected(ds) -> if !explaining { { rejected: Some([]), results: Map::new() } } else {
        let reason = checked_whole(named, read, true, [parse.given]);
        {
          rejected: Some(match reason.pulled.out {
            Rejected(more) -> more.map(|d: Diagnostic| own_labels(d, reason.at)),
            Analysed(_) -> ds.map(|d: Diagnostic| own_labels(d, checked.at)),
          }),
          results: Map::new(),
        }
      },
      Analysed(w) -> {
        let module_check = owner_checks::module_check_of(
          w,
          checked.at,
          read.text,
          read: Some(parse.raw),
        );
        let read_of = |o: Bytes|
          match facts.get(o) {
            Some(f) -> f.text,
            None ->
              panic("a declaration in a checked group is missing from the module's declarations"),
          };
        let walked = prefill_inferences(
          named,
          module_check,
          read.signing,
          groups.filter(|g: GroupKey| g.owners.len() > 1).map(|g: GroupKey| g.owners.map(read_of)),
        );
        let cut = groups.fold(
          [],
          |accumulator: List<{ unit: GroupKey, owners: List<Bytes> }>, unit: GroupKey|
            accumulator.concat(
              (if unit.owners.len() < 2 { [unit.owners] } else {
                call_cycles(
                  unit.owners,
                  unit.owners.map(|o: Bytes|
                    match walked.get(o) {
                      Some(t) ->
                        called_owners(o, owner_checks::called_names(module, t), |n: Bytes|
                          declared_in(read, n)),
                      None -> [],
                    }),
                )
              }).map(|owners: List<Bytes>| { unit: unit, owners: owners }),
            ),
        );
        let laid = cut.map(|g: { unit: GroupKey, owners: List<Bytes> }| {
          let members = g.owners.map(read_of);
          { members: members, items: item_layout(members) }
        });
        let results = owner_checks::group_results(module_check, module, laid, |x: ItemAt| x.to);
        let encoded_results = owner_checks::encode_groups(results);
        {
          rejected: None,
          results: range(0, cut.len()).fold(
            Map::new(),
            |accumulator: Map<Bytes, owner_checks::GroupResult>, i: Int| {
              let unit = cut.get(i).unit;
              let g = { ..unit, owners: cut.get(i).owners };
              let at_g = bin::encode(g, group_key_bin());
              let result = results.get(i);
              memo.offer_as(whole_query(), group_query(), at_g, encoded_results.get(i));
              if unit.owners.len() < 2 {
                prefill_forms(whole_query(), g, laid.get(i).members, result)
              };
              if missing.contains(bin::encode(unit, group_key_bin())) {
                accumulator.insert(at_g, result)
              } else { accumulator }
            },
          ),
        }
      },
    }
  }
}

fn prefill_inferences(
  named: ModuleKey,
  module_check: owner_checks::ModuleCheck,
  is_signature_unit: List<List<Bytes>>,
  units: List<List<OwnerText>>,
) -> Map<Bytes, owner_checks::InferenceResult> / {memo.read, abort.raise} = {
  let members = units.fold([], |accumulator: List<OwnerText>, u: List<OwnerText>|
    accumulator.concat(u));
  let walked = owner_checks::inference_results(module_check, named.module, members, |x: ItemAt|
    x.to);
  is_signature_unit.fold((), |_: Unit, s: List<Bytes>|
    memo.offer_as(
      whole_query(),
      signatures_query(),
      bin::encode(
        { module: named.module, shipped: named.shipped, tested: named.tested, owners: s },
        group_key_bin(),
      ),
      bin::encode(
        owner_checks::signature_check_from(module_check, s),
        owner_checks::signature_check_bin(),
      ),
    ));
  range(0, members.len()).fold(
    Map::new(),
    |accumulator: Map<Bytes, owner_checks::InferenceResult>, k: Int| {
      let o = members.get(k).owner;
      memo.offer_as(
        whole_query(),
        typed_query(),
        owner_at(named, o),
        bin::encode(walked.get(k), owner_checks::inference_result_bin()),
      );
      accumulator.insert(o, walked.get(k))
    },
  )
}

fn published_mentions_of(
  shipped: Bool,
  own: Bytes,
  module: Bytes,
  owner: Bytes,
) -> List<Mention> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      published_query(),
      bin::encode(
        {
          module: module,
          shipped: if module == own { shipped } else { shipped_for(shipped, module) },
          tested: false,
          owner: owner,
        },
        owner_key_bin(),
      ),
    ),
    bin::list_bin(mention_bin()),
    "what a module publishes",
  )

fn checked_whole(
  named: ModuleKey,
  read: OwnersResult,
  published: Bool,
  given: List<ParsedSource>,
) -> { pulled: PulledAnalysis, at: Int } / {QueryEffects, abort.raise} = {
  let dependencies = needed_entries(
    |d: Bytes, n: Bytes| owner_interfaces_of(named.shipped, d, n),
    interface_header_of,
    read.wanted,
    read.context.present,
    |module: Bytes, owner: Bytes|
      if !published || module == named.module { [] }
      else { published_mentions_of(named.shipped, named.module, module, owner) },
    |n: Bytes| value_call_modules(named, n),
  );
  checked_against(
    { name: named.module, source_text: read.text },
    read.context.setting.origin,
    dependencies,
    module_origin_lookup(module_origins_of(named.shipped, dependencies.keys())),
    {
      let reading = reading_of(read.context.setting);
      { ..reading, given: given.concat(reading.given) }
    },
  )
}

fn own_labels(d: Diagnostic, at: Int) -> Diagnostic =
  {
    ..d,
    labels: d.labels.fold([], |accumulator: List<Label>, l: Label|
      if l.module == at { accumulator.push({ ..l, module: 0 }) } else { accumulator }),
  }

pub fn module_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_result_of(named);
  let source = { name: named.module, source_text: read.text };
  let result = bin::encode(
    if !read.found { absent(named.module) } else {
      let groups = group_keys(named, read);
      let offered = prefill_from_whole_check(named, read, groups, true);
      let whole = match offered.rejected { Some(ds) -> ds, None -> [] };
      if whole.len() > 0 { rejected_for(named.module, read, whole) } else {
        let facts = facts_of(read);
        let placed = groups.fold(
          [],
          |accumulator: List<owner_checks::PositionedGroup>, unit: GroupKey|
            accumulator.concat(
              (if unit.owners.len() < 2 { [unit.owners] } else { cycles_of(unit) }).map(
                |owners: List<Bytes>| {
                  let g = { ..unit, owners: owners };
                  {
                    items: item_layout(
                      owners.map(|o: Bytes|
                        match facts.get(o) {
                          Some(f) -> f.text,
                          None ->
                            panic(
                              "a declaration in a checked group is missing from the module's declarations",
                            ),
                        }),
                    ),
                    result: {
                      let at_g = bin::encode(g, group_key_bin());
                      match offered.results.get(at_g) {
                        Some(a) -> {
                          memo.fetch(group_query(), at_g);
                          a
                        },
                        None -> group_of(g),
                      }
                    },
                  }
                },
              ),
            ),
        );
        let a = owner_checks::assembled(
          named.module,
          read.shape,
          read.order,
          read.recorded,
          placed,
          read.context.setting.origin == InRoot
            || (read.context.setting.origin == ShippedModule && read.context.setting.tested),
        );
        let header = decoded(
          memo.fetch(header_query(), input),
          bin::list_bin(diagnostic_bin()),
          "a header's rejections",
        );
        let rejected = if !read.rejecting && a.rejected.len() == 0 { header } else {
          let checked = checked_whole(named, read, true, [read_once(source).given]);
          let whole_rejections = match checked.pulled.out {
            Rejected(ds) -> ds.map(|d: Diagnostic| own_labels(d, checked.at)),
            Analysed(_) -> [],
          };
          if whole_rejections.len() > 0 { whole_rejections } else { header.concat(a.rejected) }
        };
        if rejected.len() > 0 { rejected_for(named.module, read, rejected) } else {
          {
            imports: read.context.present,
            rejected: [],
            warnings: a.warnings,
            definitions: a.definitions,
            tests: a.tests,
            rows: encode_rows(a.rows),
            shape: a.facts.shape,
            tables: encode_tables(a.facts.tables),
          }
        }
      }
    },
    module_result_bin(),
  );
  decode_cache.evict_text_read(text_key(source));
  result
}

fn rejected_for(
  module: Bytes,
  read: OwnersResult,
  rejected: List<Diagnostic>,
) -> ModuleResult / {abort.raise} =
  {
    ..absent(module),
    rejected: rejected,
    imports: read.context.present,
    shape: { ..no_shape(module), written: read.shape.written },
  }

pub fn header_text_query() -> Bytes = b"header text"

pub fn header_query() -> Bytes = b"header"

pub fn header_text_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, module_key_bin(), "a module's name");
  match text_of(key) {
    None -> b"",
    Some(text) -> match header_read({ name: key.module, source_text: text }) {
      None -> b"",
      Some(m) -> {
        let written = m.imports.filter(is_explicit_import);
        if !written.fold(false, |b: Bool, d: ImportDeclaration| b || selecting(d)) { b"" } else {
          blanked(
            text.slice(0, max_of(written.map(|d: ImportDeclaration| d.span.end))),
            written.filter(|d: ImportDeclaration| !selecting(d)).map(|d: ImportDeclaration| d.span),
          )
        }
      },
    },
  }
}

fn header_read(source: Source) -> Option<Module> / {decode_cache.read, abort.raise} =
  match decode_cache.text_read(text_key(source)) {
    Some(r) -> header_of(r.lexed.input, r.lexed.parser),
    None -> header(source.source_text),
  }

fn max_of(xs: List<Int>) -> Int = xs.fold(0, |m: Int, x: Int| if x > m { x } else { m })

fn selecting(d: ImportDeclaration) -> Bool = match d.kind { SelectedNames(_) -> true, _ -> false }

fn colliding(imports: List<ImportDeclaration>) -> Map<Bytes, Bool> / {abort.raise} = {
  let counted = imports.fold(Map::new(), |accumulator: Map<Bytes, Int>, d: ImportDeclaration|
    match import_binder(d) {
      Some(b) -> accumulator.insert(b, match accumulator.get(b) { Some(n) -> n + 1, None -> 1 }),
      None -> accumulator,
    });
  counted.fold(Map::new(), |accumulator: Map<Bytes, Bool>, b: Bytes, n: Int|
    if n > 1 { accumulator.insert(b, true) } else { accumulator })
}

pub fn header_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, module_key_bin(), "a module's name");
  let prefix = memo.fetch(header_text_query(), input);
  bin::encode(
    if prefix.len() == 0 { [] } else {
      let context = context_once(key);
      let selections = range(0, min(context.imports.len(), context.targets.len())).fold(
        [],
        |accumulator: List<{ module: Bytes, names: List<Bytes> }>, k: Int|
          match context.imports.get(k).kind {
            SelectedNames(ns) ->
              accumulator.push({
                module: context.targets.get(k),
                names: ns.map(|n: Identifier| n.name),
              }),
            _ -> accumulator,
          },
      );
      let all_exported = selections.fold(
        true,
        |b: Bool, x: { module: Bytes, names: List<Bytes> }|
          b && context.present.contains(x.module)
            && x.names.fold(true, |c: Bool, n: Bytes| c && exported(key.shipped, x.module, n)),
      );
      let selected = selections.fold(
        [],
        |accumulator: List<Bytes>, x: { module: Bytes, names: List<Bytes> }|
          accumulator.concat(x.names),
      );
      if all_exported && selected.len() == selected.unique().len() { [] } else {
        let exports_of = |m: Bytes|
          if !context.present.contains(m) { [] } else {
            let read = owners_of(
              owners_result_bytes({
                module: m,
                shipped: shipped_for(key.shipped, m),
                tested: false,
              }),
            );
            read.declared.keys().filter(|n: Bytes| exported(key.shipped, m, n))
          };
        let dependencies = needed_by(
          |d: Bytes, n: Bytes| owner_interfaces_of(key.shipped, d, n),
          selections.fold(
            [],
            |accumulator: List<Mention>, x: { module: Bytes, names: List<Bytes> }|
              accumulator.concat(
                x.names.concat(exports_of(x.module)).map(|n: Bytes| { module: x.module, name: n }),
              ),
          ),
          selections.map(|x: { module: Bytes, names: List<Bytes> }| x.module).filter(|m: Bytes|
            context.present.contains(m)),
          |_: Bytes| [],
        );
        let places = module_origins_of(key.shipped, dependencies.keys());
        let checked = checked_against(
          { name: key.module, source_text: prefix },
          context.setting.origin,
          dependencies,
          module_origin_lookup(places),
          reading_of(context.setting),
        );
        match checked.pulled.out {
          Analysed(_) -> [],
          Rejected(ds) ->
            ds.map(|d: Diagnostic|
              {
                ..d,
                labels: d.labels.filter(|l: Label| l.module == checked.at).map(|l: Label|
                  { ..l, module: 0 }),
              }),
        }
      }
    },
    bin::list_bin(diagnostic_bin()),
  )
}

pub fn exported_query() -> Bytes = b"exported"

pub fn exported_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, interface_key_bin(), "a declared name's key");
  let shown = declared_of(key.module, key.shipped, key.full_text, key.name).fold(
    false,
    |b: Bool, o: Bytes|
      b
        || (match owner_interface_of({
            module: key.module,
            shipped: key.shipped,
            tested: key.full_text,
            owner: o,
          }) {
          Some(e) ->
            e.text.starts_with(b"pub ") && !(o != key.name && e.text.starts_with(b"pub opaque ")),
          None -> false,
        }),
  );
  if shown { b"1" } else { b"" }
}

fn exported(shipped: Bool, module: Bytes, name: Bytes) -> Bool / {memo.read, abort.raise} =
  memo.fetch(
      exported_query(),
      bin::encode(
        { module: module, shipped: shipped_for(shipped, module), full_text: false, name: name },
        interface_key_bin(),
      ),
    ).len(
    )
    > 0

pub fn group_hash_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a group's names");
  if !current_unit(key) {
    bin::encode(
      { entries: Map::new(), fixing: { nodes: [], tests: [], laws: [] } },
      group_hashes_bin(),
    )
  } else {
    let h = group_hash_inputs(key);
    let fixed_definitions = h.fixed.fold(
      Map::new(),
      |accumulator: Map<Bytes, Bool>, f: CachedNode|
        accumulator.insert(definition_key(f.name, f.declaration), true),
    );
    if h.forms.nodes.fold(false, |b: Bool, x: HashNode|
        b
          || (match x.form {
            None -> !fixed_definitions.contains(definition_key(x.name, x.declaration)),
            Some(_) -> false,
          })) {
      bin::encode(
        { entries: Map::new(), fixing: { nodes: [], tests: [], laws: [] } },
        group_hashes_bin(),
      )
    } else {
      let fixing = hash_forms(h.forms, h.fixed);
      bin::encode(
        { entries: hashes_by_owner(key.module, fixing.nodes, h.functions).entries, fixing: fixing },
        group_hashes_bin(),
      )
    }
  }
}

pub fn group_hash_inputs(
  key: GroupKey,
) -> { forms: HashInput, fixed: List<CachedNode>, functions: Map<Bytes, Bytes> } / {memo.read, abort.raise} = {
  let g = decoded(
    memo.fetch(group_forms_query(), bin::encode(key, group_key_bin())),
    group_forms_bin(),
    "a group's forms",
  );
  let forms = g.forms;
  let fixed = forms.nodes.fold([], |accumulator: List<CachedNode>, s: HashNode|
    match s.form {
      Some(_) -> accumulator,
      None -> {
        let m = named_node(s.name);
        let shipped = if m.module == key.module { key.shipped }
        else { shipped_for(key.shipped, m.module) };
        let tested = if m.module == key.module { key.tested } else { false };
        declared_of(m.module, shipped, tested, m.name).fold(
          accumulator,
          |a: List<CachedNode>, o: Bytes|
            if m.module == key.module && key.owners.contains(o) { a } else {
              let e = memo.fetch(
                owner_hash_query(),
                bin::encode(
                  { module: m.module, shipped: shipped, tested: tested, owner: o },
                  owner_key_bin(),
                ),
              );
              if e.len() == 0 { a }
              else { a.concat(decoded(e, hash_entry_bin(), "a hash entry").cached_nodes) }
            },
        )
      },
    });
  { forms: forms, fixed: fixed, functions: g.functions }
}

pub fn group_forms_query() -> Bytes = b"group forms"

type GroupForms = { forms: HashInput, functions: Map<Bytes, Bytes> }

derive bin for GroupForms

pub fn group_forms_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a group's names");
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  if !current_unit(key) {
    bin::encode({ forms: owner_checks::no_group().forms, functions: Map::new() }, group_forms_bin())
  } else if key.owners.len() < 2 {
    let result = memo.fetch(group_query(), input);
    let reads = key.owners.map(|o: Bytes| owner_facts(named, o).text);
    match memo.offered() {
      Some(o) -> o,
      None ->
        forms_of(
          reads,
          decoded(result, owner_checks::encoded_group_bin(), "a group's result").rest,
        ),
    }
  } else {
    formed(
      key.owners.map(|o: Bytes| owner_facts(named, o).text),
      joined_forms(
        cycles_of(key).map(|g: List<Bytes>|
          decoded(
            memo.fetch(group_query(), bin::encode({ ..key, owners: g }, group_key_bin())),
            owner_checks::encoded_group_bin(),
            "a group's result",
          ).rest.forms),
      ),
    )
  }
}

fn forms_of(reads: List<OwnerText>, a: owner_checks::GroupResult) -> Bytes / {abort.raise} =
  formed(reads, a.forms)

fn formed(reads: List<OwnerText>, forms: HashInput) -> Bytes / {abort.raise} =
  bin::encode(
    {
      forms: forms,
      functions: reads.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, r: OwnerText|
        r.names.fold(accumulator, |m: Map<Bytes, Bytes>, n: Bytes| m.insert(n, r.owner))),
    },
    group_forms_bin(),
  )

fn prefill_forms(
  by: Bytes,
  g: GroupKey,
  reads: List<OwnerText>,
  a: owner_checks::GroupResult,
) -> Unit / {memo.read, abort.raise} =
  memo.offer_as(by, group_forms_query(), bin::encode(g, group_key_bin()), forms_of(reads, a))

fn group_hashes_of(g: GroupKey) -> GroupHashes / {memo.read, abort.raise} =
  decoded(
    memo.fetch(group_hash_query(), bin::encode(g, group_key_bin())),
    group_hashes_bin(),
    "a group's hashing",
  )

pub fn owner_hash_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  match group_hashes_of(unit_key_of(key)).entries.get(key.owner) {
    Some(e) -> bin::encode(e, hash_entry_bin()),
    None -> b"",
  }
}

pub fn hashes_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_result_of(named);
  let hashed = group_keys(named, read).map(group_hashes_of);
  let fixing = {
    nodes: hashed.fold([], |accumulator: List<CachedNode>, h: GroupHashes|
      accumulator.concat(h.fixing.nodes)),
    tests: hashed.fold([], |accumulator: List<CachedTest>, h: GroupHashes|
      accumulator.concat(h.fixing.tests)),
    laws: hashed.fold([], |accumulator: List<CachedLaw>, h: GroupHashes|
      accumulator.concat(h.fixing.laws)),
  };
  bin::encode(
    {
      hashes: {
        module: named.module,
        entries: hashed.fold(Map::new(), |accumulator: Map<Bytes, HashEntry>, h: GroupHashes|
          h.entries.fold(accumulator, |a: Map<Bytes, HashEntry>, o: Bytes, e: HashEntry|
            a.insert(o, e))),
      },
      owners: read.declared,
      fixing: fixing,
      record: record_digest(module_record(fixing)),
    },
    hash_result_bin(),
  )
}

pub fn hashes_query() -> Bytes = b"hashes"

pub fn documented_query() -> Bytes = b"documented"

fn laws_referencing(lawful: ModuleKey) -> Map<Bytes, List<Bytes>> / {memo.read, abort.raise} = {
  let read = owners_result_of(lawful);
  read.owners.fold(
    Map::new(),
    |accumulator: Map<Bytes, List<Bytes>>, o: { owner: Bytes, facts: Bytes, starts: List<Int> }|
      if !o.owner.starts_with(b"law ") { accumulator } else {
        let law = o.owner.slice(4, o.owner.len());
        let hashed = group_hashes_of({
          module: lawful.module,
          shipped: lawful.shipped,
          tested: lawful.tested,
          owners: group_containing(read, o.owner),
        });
        hashed.fixing.laws.fold(accumulator, |by: Map<Bytes, List<Bytes>>, l: CachedLaw|
          l.refs.fold(by, |a: Map<Bytes, List<Bytes>>, r: NodeRef| {
            let recorded_laws = match a.get(r.name) { Some(laws) -> laws, None -> [] };
            if r.declaration || recorded_laws.contains(law) { a }
            else { a.insert(r.name, recorded_laws.push(law)) }
          }))
      },
  )
}

pub fn documented_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, module_key_bin(), "a module's name");
  bin::encode(
    match module_read({ ..key, tested: true }) {
      None -> { pages: [] },
      Some(m) -> {
        let checked = decoded(
          memo.fetch(module_query(), input),
          module_result_bin(),
          "a module's result",
        );
        let hashed = decoded(
          memo.fetch(hashes_query(), input),
          hash_result_bin(),
          "a module's hashing",
        );
        module_pages(m.parsed, m.source.source_text, {
          definitions: tables_of_result(checked).definitions,
          hashes: hashed.fixing.nodes.fold(
            Map::new(),
            |accumulator: Map<Bytes, Bytes>, f: CachedNode|
              if f.declaration { accumulator } else { accumulator.insert(f.name, f.hash) },
          ),
          laws_by_definition: if m.raw.items.fold(false, |b: Bool, item: Item|
              b || (match item { LawItem(_) -> true, _ -> false })) {
            laws_referencing({ ..key, tested: key.tested || key.shipped })
          } else { Map::new() },
        })
      },
    },
    pages_bin(),
  )
}

pub fn declaring_query() -> Bytes = b"declaring"

pub fn documenting_modules_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let shipped = match memo.external(shipped_names_kind(), b"") {
    Some(b) -> decoded(b, bin::list_bin(bin::bytes_bin()), "the shipped modules' names"),
    None -> [],
  };
  let under = input.concat(b".");
  bin::encode(
    shipped.filter(|m: Bytes| m == input || m.starts_with(under)).fold(
      Map::new(),
      |accumulator: Map<Bytes, List<Bytes>>, m: Bytes|
        decoded(
          memo.fetch(
            documented_query(),
            bin::encode({ module: m, shipped: true, tested: false }, module_key_bin()),
          ),
          pages_bin(),
          "a module's pages",
        ).pages.fold(accumulator, |by: Map<Bytes, List<Bytes>>, page: Page| {
          let simple = Bytes::of_string(page.simple);
          let listed_modules = match by.get(simple) { Some(ms) -> ms, None -> [] };
          if page.simple == "" || listed_modules.contains(m) { by }
          else { by.insert(simple, listed_modules.push(m)) }
        }),
    ),
    declaring_bin(),
  )
}

pub fn declaring_bin() -> bin::BinCodec<Map<Bytes, List<Bytes>>> =
  bin::map_bin(bin::bytes_bin(), bin::list_bin(bin::bytes_bin()))

