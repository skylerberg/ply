// --- Asking a program's modules -------------------------------------------------------------

/// What `a` says its module's check said of its declarations.
pub fn tables_answered(a: ModuleAnswer) -> ModuleTables / {abort.raise} = tables_read(a.tables)

// --- Through a session of edits -------------------------------------------------------------

pub fn sorted_bytes(xs: List<Bytes>) -> List<Bytes> =
  xs.sort_by(|a: Bytes, b: Bytes| match compare_values(a, b) { Greater -> false, _ -> true })
