pub type OwnerKey = { module: Bytes, shipped: Bool, tested: Bool, owner: Bytes }

pub type GroupKey = { module: Bytes, shipped: Bool, tested: Bool, owners: List<Bytes> }

pub type OwnerFacts = { text: OwnerText, mentions: List<Mention> }

pub type OwnersResult = {
  found: Bool,
  owners: List<Bytes>,
  groups: List<List<Bytes>>,
  signing: List<List<Bytes>>,
  declared: Map<Bytes, List<Bytes>>,
  declarations: Declarations,
  context: Context,
  shape: ModuleShape,
  order: List<Bytes>,
  recorded: List<Bytes>,
  wanted: List<Mention>,
  publishing: Map<Bytes, List<Mention>>,
  stated: List<Bytes>,
  rejecting: Bool,
}

pub type GroupHashes = { entries: Map<Bytes, HashEntry>, fixing: CachedHashes }

pub type OwnerPlace = { owner: Bytes, starts: List<Int> }

pub type ModuleLayout = { owners: List<OwnerPlace>, outline: Outline }

type OwnerRecord = { owner: Bytes, facts: Bytes }

derive bin for OwnerKey

derive bin for GroupKey

derive bin for OwnerFacts

derive bin for OwnersResult

derive bin for GroupHashes

derive bin for OwnerPlace

derive bin for ModuleLayout

pub const declarations_query: Bytes = b"declarations"

pub const signature_declarations_query: Bytes = b"signature declarations"

pub const name_declaration_query: Bytes = b"name declaration"

pub type NameDeclarations = {
  value: Option<Declaration>,
  of_type: Option<Declaration>,
  of_effect: Option<Declaration>,
  of_set: Option<Declaration>,
}

derive bin for NameDeclarations

pub const owners_query: Bytes = b"owners"

pub const owner_query: Bytes = b"owner"

pub const unit_of_query: Bytes = b"unit of"

pub const calls_query: Bytes = b"calls"

pub const cycles_query: Bytes = b"cycles"

pub const group_of_query: Bytes = b"group of"

pub const layout_query: Bytes = b"layout"

pub const shape_query: Bytes = b"shape"

pub const signature_unit_query: Bytes = b"sign unit of"

pub const setting_query: Bytes = b"setting"

pub const group_imports_query: Bytes = b"group imports"

pub const published_query: Bytes = b"published"

pub const visible_modules_query: Bytes = b"sees"

pub const wanted_files_query: Bytes = b"wants"

pub const declared_query: Bytes = b"declared"

pub const group_query: Bytes = b"group"

pub const owner_interface_query: Bytes = b"owner entry"

pub const shown_query: Bytes = b"shown"

pub const signatures_query: Bytes = b"signatures"

pub const signature_query: Bytes = b"signature"

pub const group_interface_query: Bytes = b"signed"

pub const typed_query: Bytes = b"typed"

pub const group_hash_query: Bytes = b"group hash"

pub const owner_hash_query: Bytes = b"owner hash"

pub fn module_key_of(o: OwnerKey) -> ModuleKey =
  { module: o.module, shipped: o.shipped, tested: o.tested }

pub fn owners_result_of(named: ModuleKey) -> OwnersResult / {memo.read, abort.raise} =
  decoded(
    memo.fetch(owners_query, bin::encode(named, module_key_bin())),
    owners_result_bin(),
    "a module's owners",
  )

const no_context: Context =
  {
    imports: [],
    targets: [],
    present: [],
    setting: {
      origin: ShippedModule,
      packages: { root: b"", manifest: None, supplied: [] },
      resolved_packages: None,
      tested: false,
      unread: [],
      wanted_texts: [],
      data: [],
      embeds: [],
    },
  }

fn reading_of(c: Setting) -> CheckInputs / {QueryEffects, abort.raise} =
  {
    packages: c.packages,
    checked_packages: c.resolved_packages,
    tested: c.tested,
    unread: c.unread,
    all_sources: c.wanted_texts,
    data: c.data,
    embeds: c.embeds,
    given: c.wanted_texts.map(|source: Source| read_once(source).given),
  }

fn resolved_imports(m: ModuleRead) -> List<Bytes> =
  m.names.concat(m.parsed.module.imports.drop(m.raw.imports.len()).map(import_path)).fold(
    [],
    |accumulator: List<Bytes>, n: Bytes|
      if accumulator.contains(n) || (!m.present.contains(n) && m.names.contains(n)) { accumulator }
      else { accumulator.push(n) },
  )

fn unread_module(module: Bytes) -> OwnersResult =
  {
    found: false,
    owners: [],
    groups: [],
    signing: [],
    declared: Map::new(),
    declarations: no_declarations,
    context: no_context,
    shape: no_shape(module),
    order: [],
    recorded: [],
    wanted: [],
    publishing: Map::new(),
    stated: [],
    rejecting: false,
  }

fn unplaced_record(
  o: OwnerText,
  mentions: Map<Bytes, List<Mention>>,
) -> OwnerRecord / {abort.raise} =
  {
    owner: o.owner,
    facts: bin::encode(
      {
        text: { ..o, starts: o.starts.map(|_: Int| 0) },
        mentions: match mentions.get(o.owner) { Some(ms) -> ms, None -> [] },
      },
      owner_facts_bin(),
    ),
  }

pub fn owners_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, module_key_bin(), "a module's name");
  match module_read(key) {
    None -> {
      let read = unread_module(key.module);
      prefill_projections(key, read, [], [], { owners: [], outline: read.shape.outline });
      bin::encode(read, owners_result_bin())
    },
    Some(m) -> {
      let module = m.source.name;
      let scope = module_scope(m.parsed, m.raw, m.names);
      let reads = owner_texts(m.parsed, m.raw, m.source.source_text);
      let mentions = reads.fold(
        Map::new(),
        |accumulator: Map<Bytes, List<Mention>>, o: OwnerText|
          accumulator.insert(
            o.owner,
            owner_mentions(module, scope, o, m.source.source_text, owner_tokens(m.tokens, o)),
          ),
      );
      let imported = resolved_imports(m);
      let items = requests_by_item(m.parsed.module);
      let shapes = reads.map(|o: OwnerText| signature_text(m.raw, o));
      let shape_mentions = range(0, reads.len()).fold(
        Map::new(),
        |accumulator: Map<Bytes, List<Mention>>, k: Int| {
          let o = reads.get(k);
          let lexed = signature_tokens(m.raw, m.tokens, o);
          accumulator.insert(
            o.owner,
            owner_mentions(module, scope, shapes.get(k), m.source.source_text, lexed),
          )
        },
      );
      let outline = {
        let o = read_outline(m.parsed);
        if m.reading.tested { o } else {
          {
            ..o,
            items: o.items.filter(|x: OutlineItem|
              match x { OutlinedTest(_) -> false, OutlinedLaw(_) -> false, _ -> true }),
          }
        }
      };
      let read = {
        found: true,
        owners: reads.map(|o: OwnerText| o.owner),
        groups: owner_groups(module, scope, reads.map(|o: OwnerText| o.owner), mentions),
        signing: owner_groups(module, scope, reads.map(|o: OwnerText| o.owner), shape_mentions),
        declared: scope.written.owners,
        declarations: unplaced_declarations(declarations_of(m.parsed)),
        context: {
          imports: unplaced_imports(m.raw),
          targets: m.names,
          present: m.present,
          setting: {
            origin: m.placed,
            packages: m.reading.packages,
            resolved_packages: m.reading.checked_packages,
            tested: m.reading.tested,
            unread: m.reading.unread,
            wanted_texts: m.reading.all_sources,
            data: m.reading.data,
            embeds: m.reading.embeds,
          },
        },
        shape: {
          outline: unplaced_outline(outline),
          imports: imported,
          unimported: m.unimported,
          named: named_imports(m.parsed, imported),
          written: m.parsed.module.imports.map(import_module_name).concat(
            m.present.filter(|p: Bytes| !m.names.contains(p)),
          ),
          embeds: [],
          embed_items: if items.fold(false, |b: Bool, x: ItemEmbeds| b || x.wants.len() > 0) {
            items
          } else { [] },
          tagged: [],
          statements: [],
          consts: [],
        },
        order: checked_functions(m.parsed),
        recorded: check_order(m.parsed),
        wanted: imported_mentions_in(m.parsed, m.raw, m.source.source_text, m.tokens, m.names),
        publishing: m.parsed.module.items.fold(
          Map::new(),
          |accumulator: Map<Bytes, List<Mention>>, item: Item|
            match item {
              TypeItem(d) -> match d.opaque {
                Some(opaque_type) ->
                  accumulator.insert(
                    d.name.name,
                    opaque_type.result.concat(opaque_type.take).map(|f: Bytes|
                      { module: module, name: f }),
                  ),
                None -> accumulator,
              },
              _ -> accumulator,
            },
        ),
        stated: stated_functions(module, m.parsed.module),
        rejecting: m.reading.given.fold(false, |b: Bool, g: ParsedSource|
          b || g.diagnostics.fold(false, |c: Bool, d: Diagnostic| c || d.severity == b"error")),
      };
      prefill_projections(
        key,
        read,
        reads.map(|o: OwnerText| unplaced_record(o, mentions)),
        shapes.map(|o: OwnerText| unplaced_record(o, shape_mentions)),
        {
          owners: reads.map(|o: OwnerText| { owner: o.owner, starts: o.starts }),
          outline: outline,
        },
      );
      bin::encode(read, owners_result_bin())
    },
  }
}

fn stated_functions(module: Bytes, parsed: Module) -> List<Bytes> = {
  let sums = parsed.items.fold(Map::new(), |accumulator: Map<Bytes, Bool>, item: Item|
    match item {
      TypeItem(d) -> match d.body {
        SumBody(_) -> accumulator.insert(d.name.name, true),
        _ -> accumulator,
      },
      _ -> accumulator,
    });
  parsed.items.fold([], |accumulator: List<Bytes>, item: Item|
    match item {
      InstanceItem(d) -> if sums.contains(d.target.name)
          && (d.kind == KeyInstance || d.kind == ShowInstance) {
        accumulator.push(qualify(module, d.function.name))
      } else { accumulator },
      NumericItem(d) -> if !sums.contains(d.target.name) { accumulator } else {
        d.operations.fold(accumulator, |a: List<Bytes>, o: NumericOperation|
          a.push(qualify(module, o.by.name)))
      },
      _ -> accumulator,
    })
}

pub fn owner_facts_result(input: Bytes) -> Bytes / {memo.write, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  match written_by_owners(named) { Some(o) -> o, None -> b"" }
}

pub fn layout_result(input: Bytes) -> Bytes / {memo.write, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  match written_by_owners(named) {
    Some(o) -> o,
    None ->
      bin::encode({ owners: [], outline: no_shape(named.module).outline }, module_layout_bin()),
  }
}

pub fn visible_modules_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let context = decoded(memo.fetch(context_query, input), context_bin(), "a module's context");
  let seen = context.present.fold(Map::new(), |accumulator: Map<Bytes, Bool>, m: Bytes|
    visible_modules_of({ module: m, shipped: shipped_for(named.shipped, m), tested: false }).fold(
      accumulator.insert(m, true),
      |a: Map<Bytes, Bool>, below: Bytes| a.insert(below, true),
    ));
  bin::encode(seen.keys(), bin::list_bin(bin::bytes_bin()))
}

fn visible_modules_of(named: ModuleKey) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(visible_modules_query, bin::encode(named, module_key_bin())),
    bin::list_bin(bin::bytes_bin()),
    "the modules a module can see",
  )

pub const value_call_modules_query: Bytes = b"answering"

pub const symbols_query: Bytes = b"symbols"

pub const symbol_query: Bytes = b"symbol"

type SymbolKey = { shipped: Bool, name: Bytes }

derive bin for SymbolKey

fn symbols_input(shipped: Bool) -> Bytes = if shipped { b"shipped" } else { b"project" }

pub fn declarers_input(name: Bytes) -> Bytes / {abort.raise} =
  bin::encode({ shipped: false, name: any_module_name(name) }, symbol_key_bin())

pub fn symbols_result(input: Bytes) -> Bytes / {memo.read, memo.write, abort.raise} = {
  let shipped = input == symbols_input(true);
  let listed = match memo.external(shipped_names_kind, b"") {
    Some(b) -> decoded(b, bin::list_bin(bin::bytes_bin()), "the shipped modules' names"),
    None -> [],
  };
  let own = if shipped { [] } else {
    match memo.external(own_modules_kind, b"") {
      Some(b) -> decoded(b, bin::list_bin(bin::bytes_bin()), "the program's modules"),
      None -> [],
    }
  };
  let declaring = own.concat(listed.filter(|m: Bytes| !own.contains(m))).fold(
    Map::new(),
    |found: Map<Bytes, List<Bytes>>, m: Bytes|
      names_of({ module: m, shipped: shipped_for(shipped, m), tested: false }).filter(
        |n: Bytes| n.starts_with(b"::"),
      ).fold(found, |by: Map<Bytes, List<Bytes>>, n: Bytes|
        by.insert(n, (match by.get(n) { Some(ms) -> ms, None -> [] }).push(m))),
  );
  declaring.fold((), |_: Unit, name: Bytes, modules: List<Bytes>|
    memo.provide(
      symbol_query,
      bin::encode({ shipped: shipped, name: name }, symbol_key_bin()),
      bin::encode(modules, bin::list_bin(bin::bytes_bin())),
    ));
  b""
}

pub fn symbol_result(input: Bytes) -> Bytes / {memo.write, abort.raise} = {
  let key = decoded(input, symbol_key_bin(), "a name");
  match memo.written_by(symbols_query, symbols_input(key.shipped)) {
    Some(o) -> o,
    None -> bin::encode([], bin::list_bin(bin::bytes_bin())),
  }
}

pub fn declaring_modules_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, interface_key_bin(), "an entry's name");
  let declaring = decoded(
    memo.fetch(
      symbol_query,
      bin::encode({ shipped: key.shipped, name: any_module_name(key.name) }, symbol_key_bin()),
    ),
    bin::list_bin(bin::bytes_bin()),
    "the modules that declare a name",
  );
  bin::encode(
    visible_modules_of({ module: key.module, shipped: key.shipped, tested: key.full_text }).filter(
      |m: Bytes| declaring.contains(m),
    ),
    bin::list_bin(bin::bytes_bin()),
  )
}

fn value_call_modules(named: ModuleKey, name: Bytes) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      value_call_modules_query,
      bin::encode(
        { module: named.module, shipped: named.shipped, full_text: named.tested, name: name },
        interface_key_bin(),
      ),
    ),
    bin::list_bin(bin::bytes_bin()),
    "the modules that define a method name",
  )

pub fn published_result(input: Bytes) -> Bytes / {memo.read, memo.write, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  match written_by_owners(named) {
    Some(o) -> o,
    None ->
      bin::encode(
        match owners_result_of(named).publishing.get(key.owner) { Some(ms) -> ms, None -> [] },
        bin::list_bin(mention_bin()),
      ),
  }
}

pub fn unit_of_result(input: Bytes) -> Bytes / {memo.read, memo.write, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  match written_by_owners(named) {
    Some(o) -> o,
    None ->
      bin::encode(
        group_containing(owners_result_of(named), key.owner),
        bin::list_bin(bin::bytes_bin()),
      ),
  }
}

pub fn calls_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  bin::encode(
    called_owners(
      key.owner,
      owner_checks::called_names(key.module, inference_of(named, key.owner)),
      |n: Bytes| declared_of(key.module, key.shipped, key.tested, n),
    ),
    bin::list_bin(bin::bytes_bin()),
  )
}

fn called_owners<| e>(
  owner: Bytes,
  names: List<Bytes>,
  declared: (Bytes) -> List<Bytes> / {abort.raise | e},
) -> List<Bytes> / {abort.raise | e} =
  sorted_bytes(
    names.fold([], |accumulator: List<Bytes>, n: Bytes|
      declared(n).fold(accumulator, |a: List<Bytes>, o: Bytes|
        if o == owner || a.contains(o) { a } else { a.push(o) })),
  )

fn calls_of(named: ModuleKey, owner: Bytes) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(calls_query, owner_at(named, owner)),
    bin::list_bin(bin::bytes_bin()),
    "the declarations a declaration calls",
  )

pub fn cycles_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a unit's names");
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  bin::encode(
    if !current_unit(key) { [] }
    else if key.owners.len() < 2 { [key.owners] }
    else { call_cycles(key.owners, key.owners.map(|o: Bytes| calls_of(named, o))) },
    bin::list_bin(bin::list_bin(bin::bytes_bin())),
  )
}

fn cycles_of(unit: GroupKey) -> List<List<Bytes>> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(cycles_query, bin::encode(unit, group_key_bin())),
    bin::list_bin(bin::list_bin(bin::bytes_bin())),
    "a unit's groups",
  )

pub fn group_of_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let unit = unit_key_of(key);
  bin::encode(
    if unit.owners.len() < 2 { unit.owners } else {
      cycles_of(unit).fold([], |accumulator: List<Bytes>, g: List<Bytes>|
        if g.contains(key.owner) { g } else { accumulator })
    },
    bin::list_bin(bin::bytes_bin()),
  )
}

pub fn shape_result(input: Bytes) -> Bytes / {memo.write, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  match written_by_owners(named) { Some(o) -> o, None -> b"" }
}

pub fn sign_unit_result(input: Bytes) -> Bytes / {memo.read, memo.write, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  match written_by_owners(named) {
    Some(o) -> o,
    None ->
      bin::encode(
        signing_with(owners_result_of(named), key.owner),
        bin::list_bin(bin::bytes_bin()),
      ),
  }
}

pub fn context_result(input: Bytes) -> Bytes / {memo.read, memo.write, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  match written_by_owners(named) {
    Some(o) -> o,
    None -> bin::encode(owners_result_of(named).context, context_bin()),
  }
}

pub fn setting_result(input: Bytes) -> Bytes / {memo.read, memo.write, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  match written_by_owners(named) {
    Some(o) -> o,
    None -> bin::encode(owners_result_of(named).context.setting, setting_bin()),
  }
}

pub fn wants_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let setting = decoded(memo.fetch(setting_query, input), setting_bin(), "a module's setting");
  bin::encode(
    {
      texts: setting.wanted_texts.map(|s: Source| s.name),
      data: setting.data.map(|d: EmbedFile| d.name),
    },
    shipped_wants_bin(),
  )
}

pub fn group_imports_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a group's names");
  if !current(key) { bin::encode([], bin::list_bin(imported_bin())) } else {
    let named = { module: key.module, shipped: key.shipped, tested: key.tested };
    let context = context_once(named);
    let members = key.owners.map(|o: Bytes| owner_facts(named, o));
    bin::encode(
      group_imports(
        key.module,
        members.map(|f: OwnerFacts| f.text),
        members.fold([], |accumulator: List<Mention>, f: OwnerFacts|
          accumulator.concat(f.mentions)),
        context.imports,
        context.targets,
      ),
      bin::list_bin(imported_bin()),
    )
  }
}

pub const owner_imports_query: Bytes = b"owner imports"

pub const signature_imports_query: Bytes = b"signature imports"

pub fn owner_imports_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  let context = context_once(named);
  let facts = owner_facts(named, key.owner);
  bin::encode(
    group_imports(key.module, [facts.text], facts.mentions, context.imports, context.targets),
    bin::list_bin(imported_bin()),
  )
}

pub fn signature_imports_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a group's names");
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  let context = context_once(named);
  let members = key.owners.map(|o: Bytes| shape_of(named, o));
  bin::encode(
    group_imports(
      key.module,
      members.map(|f: OwnerFacts| f.text),
      members.fold([], |accumulator: List<Mention>, f: OwnerFacts| accumulator.concat(f.mentions)),
      context.imports,
      context.targets,
    ),
    bin::list_bin(imported_bin()),
  )
}

pub fn declared_result(input: Bytes) -> Bytes / {memo.read, memo.write, abort.raise} = {
  let key = decoded(input, interface_key_bin(), "a declared name's key");
  let named = { module: key.module, shipped: key.shipped, tested: key.full_text };
  match written_by_owners(named) {
    Some(o) -> o,
    None -> if key.name != b"" && !names_of(named).contains(key.name) {
      bin::encode([], bin::list_bin(bin::bytes_bin()))
    } else {
      bin::encode(declared_in(owners_result_of(named), key.name), bin::list_bin(bin::bytes_bin()))
    },
  }
}

pub const names_query: Bytes = b"names"

pub fn names_result(input: Bytes) -> Bytes / {memo.read, memo.write, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  match written_by_owners(named) {
    Some(o) -> o,
    None -> bin::encode(owners_result_of(named).declared.keys(), bin::list_bin(bin::bytes_bin())),
  }
}

fn names_of(named: ModuleKey) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(names_query, bin::encode(named, module_key_bin())),
    bin::list_bin(bin::bytes_bin()),
    "the names a module declares",
  )

fn written_by_owners(named: ModuleKey) -> Option<Bytes> / {memo.write, abort.raise} =
  memo.written_by(owners_query, bin::encode(named, module_key_bin()))

fn group_containing(read: OwnersResult, owner: Bytes) -> List<Bytes> =
  read.groups.fold([], |accumulator: List<Bytes>, g: List<Bytes>|
    if g.contains(owner) { g } else { accumulator })

fn signing_with(read: OwnersResult, owner: Bytes) -> List<Bytes> =
  read.signing.fold([], |accumulator: List<Bytes>, g: List<Bytes>|
    if g.contains(owner) { g } else { accumulator })

fn declared_in(read: OwnersResult, name: Bytes) -> List<Bytes> =
  if name == b"" { read.owners }
  else { match read.declared.get(name) { Some(os) -> os, None -> [] } }

fn prefill_projections(
  named: ModuleKey,
  read: OwnersResult,
  owners: List<OwnerRecord>,
  shapes: List<OwnerRecord>,
  layout: ModuleLayout,
) -> Unit / {memo.write, abort.raise} = {
  memo.provide(
    layout_query,
    bin::encode(named, module_key_bin()),
    bin::encode(layout, module_layout_bin()),
  );
  memo.provide(
    context_query,
    bin::encode(named, module_key_bin()),
    bin::encode(read.context, context_bin()),
  );
  memo.provide(
    setting_query,
    bin::encode(named, module_key_bin()),
    bin::encode(read.context.setting, setting_bin()),
  );
  memo.provide(
    names_query,
    bin::encode(named, module_key_bin()),
    bin::encode(read.declared.keys(), bin::list_bin(bin::bytes_bin())),
  );
  prefill_published(named, read);
  prefill_owners(named, owners);
  prefill_units(named, read);
  prefill_shapes(named, shapes);
  prefill_signature_units(named, read, shapes);
  prefill_declared(named, read)
}

fn owner_at(named: ModuleKey, owner: Bytes) -> Bytes / {abort.raise} =
  bin::encode(
    { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
    owner_key_bin(),
  )

fn prefill_published(named: ModuleKey, read: OwnersResult) -> Unit / {memo.write, abort.raise} =
  read.publishing.fold((), |_: Unit, owner: Bytes, ms: List<Mention>|
    memo.provide(
      published_query,
      owner_at(named, owner),
      bin::encode(ms, bin::list_bin(mention_bin())),
    ))

fn prefill_owners(named: ModuleKey, owners: List<OwnerRecord>) -> Unit / {memo.write, abort.raise} =
  owners.fold((), |_: Unit, o: OwnerRecord|
    memo.provide(owner_query, owner_at(named, o.owner), o.facts))

fn prefill_units(named: ModuleKey, read: OwnersResult) -> Unit / {memo.write, abort.raise} =
  read.owners.fold((), |_: Unit, o: Bytes|
    memo.provide(
      unit_of_query,
      owner_at(named, o),
      bin::encode(group_containing(read, o), bin::list_bin(bin::bytes_bin())),
    ))

fn prefill_shapes(named: ModuleKey, shapes: List<OwnerRecord>) -> Unit / {memo.write, abort.raise} =
  shapes.fold((), |_: Unit, o: OwnerRecord|
    memo.provide(shape_query, owner_at(named, o.owner), o.facts))

fn prefill_signature_units(
  named: ModuleKey,
  read: OwnersResult,
  shapes: List<OwnerRecord>,
) -> Unit / {memo.write, abort.raise} =
  shapes.fold((), |_: Unit, o: OwnerRecord|
    memo.provide(
      signature_unit_query,
      owner_at(named, o.owner),
      bin::encode(signing_with(read, o.owner), bin::list_bin(bin::bytes_bin())),
    ))

fn prefill_declared(named: ModuleKey, read: OwnersResult) -> Unit / {memo.write, abort.raise} =
  read.declared.keys().push(b"").fold((), |_: Unit, name: Bytes|
    memo.provide(
      declared_query,
      bin::encode(
        { module: named.module, shipped: named.shipped, full_text: named.tested, name: name },
        interface_key_bin(),
      ),
      bin::encode(declared_in(read, name), bin::list_bin(bin::bytes_bin())),
    ))

pub fn declared_of(
  module: Bytes,
  shipped: Bool,
  tested: Bool,
  name: Bytes,
) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      declared_query,
      bin::encode(
        { module: module, shipped: shipped, full_text: tested, name: name },
        interface_key_bin(),
      ),
    ),
    bin::list_bin(bin::bytes_bin()),
    "a name's owners",
  )

pub fn owner_facts(named: ModuleKey, owner: Bytes) -> OwnerFacts / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      owner_query,
      bin::encode(
        { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
        owner_key_bin(),
      ),
    ),
    owner_facts_bin(),
    "a declaration's cached analysis",
  )

pub fn group_result_of(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a group's names");
  if !current(key) { owner_checks::encode_group(owner_checks::no_group) } else {
    let named = { module: key.module, shipped: key.shipped, tested: key.tested };
    let alone = unit_key_of({
        module: key.module,
        shipped: key.shipped,
        tested: key.tested,
        owner: key.owners.at_or(0, b""),
      }).owners.len(
      )
      < 2;
    let members = key.owners.map(|o: Bytes| owner_facts(named, o));
    owner_checks::encode_group(if reads_rejected_signature(key, members) { owner_checks::no_group }
    else if alone {
      checked_group_result(
        key.module,
        group_checked(named, members, imports_of(key), always_entire, no_bodies),
      )
    } else { finalize_group(named, key, members) })
  }
}

fn mentions_of(members: List<OwnerFacts>) -> List<Mention> =
  members.fold([], |found: List<Mention>, f: OwnerFacts| found.concat(f.mentions))

pub const signature_rejected_query: Bytes = b"signature rejected"

pub fn signature_rejected_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  bin::encode(
    decoded(
        memo.fetch(signatures_query, bin::encode(signature_unit_of(key), group_key_bin())),
        owner_checks::signature_check_bin(),
        "a group's signatures",
      ).rejected.len(
      )
      > 0,
    bin::bool_bin(),
  )
}

fn signature_rejected(at: OwnerKey) -> Bool / {memo.read, abort.raise} =
  decoded(
    memo.fetch(signature_rejected_query, bin::encode(at, owner_key_bin())),
    bin::bool_bin(),
    "whether a signature was rejected",
  )

fn reads_rejected_signature(
  key: GroupKey,
  members: List<OwnerFacts>,
) -> Bool / {memo.read, abort.raise} = {
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  let unit = unit_key_of({ ..at_key(key), owner: key.owners.at_or(0, b"") }).owners;
  mentions_of(members).any(|m: Mention|
    m.module.len() > 0
      && owners_declaring(named, m.module, m.name).any(|at: OwnerKey|
        !(at.module == key.module && unit.contains(at.owner)) && signature_rejected(at)))
}

fn at_key(key: GroupKey) -> OwnerKey =
  { module: key.module, shipped: key.shipped, tested: key.tested, owner: b"" }

pub type Sibling = | Entire | BySignature | ByGroupResult

pub fn always_entire(_: Bytes) -> Sibling = Entire

fn by_signature(_: Bytes) -> Sibling = BySignature

pub type UnitCheck = {
  texts: List<OwnerText>,
  source: OwnerSource,
  out: { pulled: PulledAnalysis, at: Int },
}

pub type BodySupplier = (OwnerSource) -> Option<(Int) -> BodyChecking / {abort.raise}> / {abort.raise}

pub fn no_bodies(_: OwnerSource) -> Option<(Int) -> BodyChecking / {abort.raise}> = None

fn inferring_only(walked: List<Bytes>) -> BodySupplier =
  |_: OwnerSource| Some(|_: Int| CheckOnly(walked))

pub fn unit_checked(
  named: ModuleKey,
  members: List<OwnerFacts>,
  imported: List<Imported>,
  sibling: (Bytes) -> Sibling,
  body_supplier: BodySupplier,
  also: List<Mention> = [],
) -> UnitCheck / {QueryEffects, abort.raise} = {
  let checked_of = |published: Bool| {
    let c = owners_check(named, members, imported, published, sibling, also: also);
    let source = group_source_from(named.module, c.reads, c.imported, c.needed);
    {
      texts: c.reads,
      source: source,
      out: checked_owner(
        source,
        c.setting.origin,
        module_origin_lookup(c.places),
        reading_of(c.setting),
        walks: body_supplier(source),
      ),
    }
  };
  let first = checked_of(false);
  match first.out.pulled.out { Analysed(_) -> first, Rejected(_) -> checked_of(true) }
}

fn stored_declarations_of(
  at: OwnerKey,
  how: Sibling,
) -> StoredDeclarations / {QueryEffects, abort.raise} = {
  let query = match how { BySignature -> signature_declarations_query, _ -> declarations_query };
  let input = bin::encode(at, owner_key_bin());
  let digest = memo.output_digest(query, input);
  match decode_cache.declarations(digest) {
    Some(d) -> d,
    None -> {
      let d = decoded_declarations(match memo.stored_output(digest) {
        Some(b) -> b,
        None -> memo.fetch(query, input),
      });
      decode_cache.cache_declarations(digest, d);
      d
    },
  }
}

fn owner_key_in(
  named: ModuleKey,
  module: Bytes,
  owner: Bytes,
) -> OwnerKey / {memo.read, abort.raise} =
  if module == named.module {
    { module: module, shipped: named.shipped, tested: named.tested, owner: owner }
  } else {
    { module: module, shipped: shipped_for(named.shipped, module), tested: false, owner: owner }
  }

fn owners_declaring(
  named: ModuleKey,
  module: Bytes,
  name: Bytes,
) -> List<OwnerKey> / {memo.read, abort.raise} = {
  let at = owner_key_in(named, module, b"");
  declared_of(module, at.shipped, at.tested, name).map(|o: Bytes| { ..at, owner: o })
}

fn declared_name_of(
  named: ModuleKey,
  module: Bytes,
  namespace: Namespace,
  name: Bytes,
) -> Option<Declaration> / {memo.read, abort.raise} = {
  let at = owner_key_in(named, module, b"");
  let found = decoded(
    memo.fetch(
      name_declaration_query,
      bin::encode(
        { module: module, shipped: at.shipped, full_text: at.tested, name: name },
        interface_key_bin(),
      ),
    ),
    name_declarations_bin(),
    "a declared name",
  );
  match namespace {
    ValueSpace -> found.value,
    TypeSpace -> found.of_type,
    EffectSpace -> found.of_effect,
    SetSpace -> found.of_set,
  }
}

fn package_of_module(
  named: ModuleKey,
  tables: ImportPackages,
  module: Bytes,
) -> Option<Int> / {memo.read, abort.raise} = {
  let shipped_place = if is_compiler(module) { tables.compiler }
  else { tables.other_shipped_package };
  let shipped = if shipped_module_exists(module) { Some(shipped_place) } else { None };
  if named.shipped { shipped }
  else { match package_location_of(module) { Some(p) -> Some(p.package), None -> shipped } }
}

fn import_packages(named: ModuleKey) -> ImportPackages / {memo.read, abort.raise} = {
  let listed = if named.shipped { [] } else {
    build_packages().packages.map(|p: Package| { prefix: p.prefix, dependencies: p.dependencies })
  };
  let own = if listed.len() == 0 { [{ prefix: b"", dependencies: [] }] } else { listed };
  let std = own.len();
  let compiler = std + 1;
  let tables = {
    package: 0,
    packages: own.push(std_package).push(compiler_package),
    std: std,
    compiler: compiler,
    other_shipped_package: compiler + 1,
  };
  {
    ..tables,
    package: match package_of_module(named, tables, named.module) {
      Some(p) -> p,
      None -> tables.other_shipped_package,
    },
  }
}

fn stored_reads(
  named: ModuleKey,
  tables: ImportPackages,
  inside: List<Bytes>,
  sibling: keep (Bytes) -> Sibling,
) -> StoredReads<| {decode_cache.read, decode_cache.write, memo.read, memo.write}> =
  {
    declarations_of: |qualified: Bytes| {
      let module = module_of_name(qualified);
      if module.len() == 0 { [] } else {
        owners_declaring(named, module, qualified.slice(module.len() + 1, qualified.len())).filter(
          |at: OwnerKey| !(module == named.module && inside.contains(at.owner)),
        ).map(|at: OwnerKey|
          stored_declarations_of(at, if module == named.module { sibling(at.owner) }
          else { Entire }))
      }
    },
    module_package: |module: Bytes| package_of_module(named, tables, module),
    module_scope: || Some(module_header(named).scope),
    name_declared: |module: Bytes, namespace: Namespace, name: Bytes|
      declared_name_of(named, module, namespace, name),
    module_declarations: |module: Bytes| {
      let at = owner_key_in(named, module, b"");
      Some(owners_result_of(module_key_of(at)).declarations)
    },
    visible_modules: || visible_modules_of(named),
    every_module: || visible_modules_of(named),
  }

fn names_in_stored(stored: StoredDeclarations) -> List<Bytes> = stored.definitions.keys()

fn declared_extern(qualified: Bytes) -> Bool / {program.read} =
  match program.definition_named(qualified) { Some(f) -> f.definition == None, None -> false }

fn name_elsewhere(
  named: ModuleKey,
  own: Map<Bytes, Bool>,
  mention: Mention,
) -> List<NameElsewhere> / {CheckReads, abort.raise} =
  if mention.module == named.module && own.contains(mention.name) { [] } else {
    let qualified = qualify(mention.module, mention.name);
    let of_type = match module_names.name_declared(mention.module, TypeSpace, mention.name) {
      Some(d) ->
        [
          {
            module: mention.module,
            name: mention.name,
            public: d.public,
            declaration: true,
            effect: false,
            constructor_of: None,
            bare: false,
          },
        ],
      None -> [],
    };
    let of_effect = match module_names.name_declared(mention.module, EffectSpace, mention.name) {
      Some(d) ->
        [
          {
            module: mention.module,
            name: mention.name,
            public: d.public,
            declaration: true,
            effect: true,
            constructor_of: None,
            bare: false,
          },
        ],
      None -> [],
    };
    let of_value = match module_names.name_declared(mention.module, ValueSpace, mention.name) {
      Some(d) -> match program.constructor_named(qualified) {
        Some(c) -> {
          let simple = c.type_name.slice(mention.module.len() + 1, c.type_name.len());
          [
            {
              module: mention.module,
              name: simple,
              public: true,
              declaration: true,
              effect: false,
              constructor_of: None,
              bare: false,
            },
            {
              module: mention.module,
              name: mention.name,
              public: d.public,
              declaration: false,
              effect: false,
              constructor_of: Some(c.type_name),
              bare: false,
            },
          ]
        },
        None -> if declared_extern(qualified) { [] } else {
          [
            {
              module: mention.module,
              name: mention.name,
              public: d.public,
              declaration: false,
              effect: false,
              constructor_of: None,
              bare: false,
            },
          ]
        },
      },
      None -> [],
    };
    of_type.concat(of_effect).concat(of_value)
  }

fn members_in(
  named: ModuleKey,
  inside: List<Bytes>,
  module: Bytes,
  name: Bytes,
) -> List<Mention> / {QueryEffects, abort.raise} =
  owners_declaring(named, module, any_module_name(name)).filter(|at: OwnerKey|
    !(module == named.module && inside.contains(at.owner))).fold(
    [],
    |found: List<Mention>, at: OwnerKey|
      names_in_stored(stored_declarations_of(at, BySignature)).fold(
        found,
        |f: List<Mention>, q: Bytes|
          if q.ends_with(b"::".concat(name)) {
            f.push({ module: module, name: q.slice(module.len() + 1, q.len()) })
          } else { f },
      ),
  )

fn members_named(
  named: ModuleKey,
  inside: List<Bytes>,
  name: Bytes,
) -> List<Mention> / {QueryEffects, abort.raise} =
  value_call_modules(named, name).fold([], |found: List<Mention>, module: Bytes|
    found.concat(members_in(named, inside, module, name)))

fn no_embed_read(_: EmbedRequest) -> EmbedResult = Ok([])

fn setting_of(named: ModuleKey) -> Setting / {memo.read, abort.raise} =
  decoded(
    memo.fetch(setting_query, bin::encode(named, module_key_bin())),
    setting_bin(),
    "a module's setting",
  )

pub type GroupRead = { inputs: GroupInputs, walks: BodyChecking, mentioned: List<Mention> }

pub fn with_group_read<a>(
  named: ModuleKey,
  members: List<OwnerFacts>,
  imported: List<Imported>,
  sibling: keep (Bytes) -> Sibling,
  body_supplier: BodySupplier,
  also: List<Mention>,
  body: (GroupRead) -> a / {CheckReads, QueryEffects, abort.raise},
) -> a / {QueryEffects, abort.raise} = {
  let texts = members.map(|f: OwnerFacts| f.text);
  let source = source_of_group(named.module, texts, imported);
  let own = texts.fold(Map::new(), |found: Map<Bytes, Bool>, o: OwnerText|
    o.names.push(o.owner).fold(found, |f: Map<Bytes, Bool>, n: Bytes| f.insert(n, true)));
  let walks = match body_supplier(source) { Some(at) -> at(0), None -> CheckEvery };
  let embed_read = if !may_call_embed(source.source.source_text) { no_embed_read } else {
    let setting = setting_of(named);
    embed_read_of(named.module, setting.embeds, setting.wanted_texts, setting.data)
  };
  let tables = import_packages(named);
  let inside = texts.map(|o: OwnerText| o.owner);
  over_stored(stored_reads(named, tables, inside, sibling), || {
    let mentions = mentions_of(members).concat(also).fold([], |found: List<Mention>, m: Mention|
      if m.module.len() == 0 { found.concat(members_named(named, inside, m.name)) }
      else if m.name.starts_with(any_module_name(b"")) {
        found.concat(members_in(named, inside, m.module, m.name.slice(2, m.name.len())))
      } else { found.push(m) });
    let in_defaults = mentions.fold([], |found: List<Mention>, m: Mention|
      match module_names.parameters_stored(qualify(m.module, m.name)) {
        Some(p) -> found.concat(names_in_defaults(p)),
        None -> found,
      });
    let seen = mentions.concat(in_defaults).fold(
      Map::new(),
      |found: Map<Bytes, Mention>, m: Mention| found.insert(qualify(m.module, m.name), m),
    );
    let elsewhere = seen.values().fold([], |found: List<NameElsewhere>, m: Mention|
      found.concat(name_elsewhere(named, own, m)));
    let unique = elsewhere.fold(Map::new(), |found: Map<Bytes, NameElsewhere>, n: NameElsewhere| {
      let key = Bytes::concat_all([
        qualify(n.module, n.name),
        if n.effect { b"#e" } else if n.declaration { b"#t" } else { b"#v" },
      ]);
      found.insert(key, match found.get(key) {
        Some(first) -> { ..n, public: n.public && first.public },
        None -> n,
      })
    });
    body({
      inputs: {
        source: source,
        elsewhere: unique.values(),
        tables: tables,
        shipped: named.shipped,
        embed_read: embed_read,
      },
      walks: walks,
      mentioned: seen.values().filter(|m: Mention|
        !(m.module == named.module && own.contains(m.name))),
    })
  })
}

pub fn group_checked(
  named: ModuleKey,
  members: List<OwnerFacts>,
  imported: List<Imported>,
  sibling: keep (Bytes) -> Sibling,
  body_supplier: BodySupplier,
  also: List<Mention> = [],
) -> UnitCheck / {QueryEffects, abort.raise} =
  with_group_read(named, members, imported, sibling, body_supplier, also, |read: GroupRead|
    {
      texts: members.map(|f: OwnerFacts| f.text),
      source: read.inputs.source,
      out: checked_group(read.inputs, read.walks),
    })

fn checked_group_result(module: Bytes, c: UnitCheck) -> owner_checks::GroupResult / {abort.raise} =
  owner_checks::group_result(
    c.out.pulled.out,
    c.out.at,
    c.source.source.source_text,
    module,
    c.texts,
    c.source.items,
    |x: ItemAt| c.source.offset + x.from,
  )

pub fn imports_of(key: GroupKey) -> List<Imported> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(group_imports_query, bin::encode(key, group_key_bin())),
    bin::list_bin(imported_bin()),
    "a group's imports",
  )

fn called_in(
  key: GroupKey,
  walked: List<{ owner: Bytes, typed: owner_checks::InferenceResult }>,
) -> List<Bytes> / {memo.read, abort.raise} =
  walked.fold(
    [],
    |accumulator: List<Bytes>, w: { owner: Bytes, typed: owner_checks::InferenceResult }|
      called_owners(w.owner, owner_checks::called_names(key.module, w.typed), |n: Bytes|
        declared_of(key.module, key.shipped, key.tested, n)).fold(
        accumulator,
        |a: List<Bytes>, c: Bytes|
          if key.owners.contains(c) || a.contains(c) { a } else { a.push(c) },
      ),
  )

fn sibling_for_called(called: List<Bytes>) -> (Bytes) -> Sibling =
  |o: Bytes| if called.contains(o) { ByGroupResult } else { BySignature }

fn finalize_group(
  named: ModuleKey,
  key: GroupKey,
  members: List<OwnerFacts>,
) -> owner_checks::GroupResult / {QueryEffects, abort.raise} = {
  let walked = key.owners.map(|o: Bytes| { owner: o, typed: inference_of(named, o) });
  let rejected = owner_checks::inference_errors(
    walked,
    item_layout(members.map(|f: OwnerFacts| f.text)),
  );
  if rejected.len() > 0 { { ..owner_checks::no_group, rejected: rejected } } else {
    let c = group_checked(
      named,
      members,
      imports_of(key),
      sibling_for_called(called_in(key, walked)),
      |source: OwnerSource|
        Some(owner_checks::supplied_bodies(walked, source.items, source.offset)),
    );
    owner_checks::finalized_result(checked_group_result(key.module, c), walked, c.source.items)
  }
}

pub type GroupProgram = {
  named: ModuleKey,
  members: List<OwnerFacts>,
  imported: List<Imported>,
  sibling: (Bytes) -> Sibling,
  bodies: BodySupplier,
  types: List<TypeTable>,
}

pub fn group_program_of(key: GroupKey) -> GroupProgram / {QueryEffects, abort.raise} = {
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  let members = key.owners.map(|o: Bytes| owner_facts(named, o));
  let cycle = match key.owners {
    [] -> false,
    [o, ..] ->
      unit_key_of({
          module: key.module,
          shipped: key.shipped,
          tested: key.tested,
          owner: o,
        }).owners.len(
        )
        >= 2,
  };
  if !cycle {
    {
      named: named,
      members: members,
      imported: imports_of(key),
      sibling: always_entire,
      bodies: no_bodies,
      types: [],
    }
  } else {
    let walked = key.owners.map(|o: Bytes| { owner: o, typed: inference_of(named, o) });
    {
      named: named,
      members: members,
      imported: imports_of(key),
      sibling: sibling_for_called(called_in(key, walked)),
      bodies: |source: OwnerSource|
        Some(owner_checks::supplied_bodies(walked, source.items, source.offset)),
      types: walked.map(|w: { owner: Bytes, typed: owner_checks::InferenceResult }| w.typed.types),
    }
  }
}

pub fn group_program(
  key: GroupKey,
  also: List<Mention>,
) -> { check: UnitCheck, types: List<TypeTable> } / {QueryEffects, abort.raise} = {
  let g = group_program_of(key);
  {
    check: group_checked(g.named, g.members, g.imported, g.sibling, g.bodies, also),
    types: g.types,
  }
}

fn inference_of(
  named: ModuleKey,
  owner: Bytes,
) -> owner_checks::InferenceResult / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      typed_query,
      bin::encode(
        { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
        owner_key_bin(),
      ),
    ),
    owner_checks::inference_result_bin(),
    "a declaration's type inference",
  )

pub fn signatures_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(
    input,
    group_key_bin(),
    "the declarations whose signatures are checked together",
  );
  if !is_signature_unit(key) {
    bin::encode(
      { shown: [], rejected: [], declared: no_stored_declarations },
      owner_checks::signature_check_bin(),
    )
  } else {
    let named = { module: key.module, shipped: key.shipped, tested: key.tested };
    let members = key.owners.map(|o: Bytes| shape_of(named, o));
    let imported = decoded(
      memo.fetch(signature_imports_query, input),
      bin::list_bin(imported_bin()),
      "a signature's imports",
    );
    bin::encode(
      owner_checks::signature_check_of(
        checked_group_result(
          key.module,
          group_checked(named, members, imported, by_signature, inferring_only([])),
        ),
      ),
      owner_checks::signature_check_bin(),
    )
  }
}

fn is_signature_unit(g: GroupKey) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      signature_unit_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

fn signature_unit_of(o: OwnerKey) -> GroupKey / {memo.read, abort.raise} =
  {
    module: o.module,
    shipped: o.shipped,
    tested: o.tested,
    owners: decoded(
      memo.fetch(signature_unit_query, bin::encode(o, owner_key_bin())),
      bin::list_bin(bin::bytes_bin()),
      "the declarations whose signatures are checked together with this declaration",
    ),
  }

fn shape_of(named: ModuleKey, owner: Bytes) -> OwnerFacts / {memo.read, abort.raise} =
  decoded(
    memo.fetch(shape_query, owner_at(named, owner)),
    owner_facts_bin(),
    "a declaration's text and mentions",
  )

pub fn signature_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let alone = memo.fetch(group_interface_query, input);
  if alone.len() == 0 { b"" } else {
    with_reach_digest(
      alone,
      dependencies_digest_of(
        key,
        signature_unit_of(key),
        alone,
        group_interface_query,
        signature_query,
      ),
    )
  }
}

pub fn group_interface_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  match owner_checks::group_interfaces(
      memo.fetch(signatures_query, bin::encode(signature_unit_of(key), group_key_bin())),
    ).get(
      key.owner,
    ) {
    Some(entry) -> entry,
    None -> b"",
  }
}

pub fn typed_result_of(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  let g = unit_key_of(key);
  if g.owners.len() < 2 {
    bin::encode(owner_checks::no_inference_result, owner_checks::inference_result_bin())
  } else {
    let facts = owner_facts(named, key.owner);
    let imported = decoded(
      memo.fetch(owner_imports_query, input),
      bin::list_bin(imported_bin()),
      "a declaration's imports",
    );
    let c = group_checked(
      named,
      [facts],
      imported,
      by_signature,
      inferring_only(facts.text.names.map(|n: Bytes| qualify(key.module, n))),
    );
    bin::encode(
      owner_checks::inference_result(
        c.out.pulled.out,
        c.out.at,
        c.source.source.source_text,
        key.module,
        facts.text,
        c.source.items,
        |x: ItemAt| c.source.offset + x.from,
      ),
      owner_checks::inference_result_bin(),
    )
  }
}

pub type GroupCheck = {
  needed: Map<Bytes, Map<Bytes, OwnerInterface>>,
  imported: List<Imported>,
  places: Map<Bytes, ModuleOrigin>,
  setting: Setting,
  reads: List<OwnerText>,
}

fn with_body(o: OwnerKey, stub: OwnerInterface) -> OwnerInterface / {QueryEffects, abort.raise} = {
  let facts = owner_facts(module_key_of(o), o.owner);
  let context = context_once(module_key_of(o));
  {
    ..stub,
    text: Bytes::join(facts.text.texts, b"\n\n"),
    imports: group_imports(
      o.module,
      [facts.text],
      facts.mentions,
      context.imports,
      context.targets,
    ).map(|x: Imported| x.declaration),
    mentions: facts.mentions,
    rows: [],
    derived: facts.text.derived,
  }
}

pub fn no_body_reached(_: Bytes, _: Bytes) -> Bool = false

pub fn owners_check(
  named: ModuleKey,
  members: List<OwnerFacts>,
  imported: List<Imported>,
  published: Bool,
  sibling: (Bytes) -> Sibling,
  reached: (Bytes, Bytes) -> Bool = no_body_reached,
  also: List<Mention> = [],
) -> GroupCheck / {QueryEffects, abort.raise} = {
  let key = {
    module: named.module,
    shipped: named.shipped,
    tested: named.tested,
    owners: members.map(|f: OwnerFacts| f.text.owner),
  };
  let setting = setting_of(named);
  let reads = members.map(|f: OwnerFacts| f.text);
  let read_in = |module: Bytes, e: OwnerInterface|
    if !reached(module, e.owner) { e } else {
      with_body(
        {
          module: module,
          shipped: if module == key.module { key.shipped }
          else { shipped_for(key.shipped, module) },
          tested: module == key.module && key.tested,
          owner: e.owner,
        },
        e,
      )
    };
  let asker = key.shipped && also.len() == 0;
  let entries = |module: Bytes, n: Bytes|
    if module == key.module {
      declared_of(module, key.shipped, key.tested, n).fold(
        [],
        |accumulator: List<OwnerInterface>, o: Bytes|
          if key.owners.contains(o) { accumulator } else {
            let at_o = { module: module, shipped: key.shipped, tested: key.tested, owner: o };
            match match sibling(o) {
                Entire -> owner_interface_of(at_o),
                BySignature -> signature_of(at_o),
                ByGroupResult -> group_interface_of(at_o),
              } {
              Some(e) -> accumulator.push(read_in(module, e)),
              None -> accumulator,
            }
          },
      )
    } else { owner_interfaces_of(asker, module, n).map(|e: OwnerInterface| read_in(module, e)) };
  let needed = group_needs(
    key.module,
    reads,
    also.concat(mentions_of(members)),
    imported,
    entries,
    interface_header_of,
    |module: Bytes, owner: Bytes|
      if !published || module == key.module { [] }
      else { published_mentions_of(key.shipped, key.module, module, owner) },
    |n: Bytes| value_call_modules(named, n),
  );
  let places = module_origins_of(asker, needed.keys().filter(|m: Bytes| m != key.module));
  { needed: needed, imported: imported, places: places, setting: setting, reads: reads }
}

pub fn current(g: GroupKey) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      group_key_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

pub fn group_key_of(o: OwnerKey) -> GroupKey / {memo.read, abort.raise} =
  {
    module: o.module,
    shipped: o.shipped,
    tested: o.tested,
    owners: decoded(
      memo.fetch(group_of_query, bin::encode(o, owner_key_bin())),
      bin::list_bin(bin::bytes_bin()),
      "the declarations checked together with this declaration",
    ),
  }

pub fn current_unit(g: GroupKey) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      unit_key_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

pub fn unit_key_of(o: OwnerKey) -> GroupKey / {memo.read, abort.raise} =
  {
    module: o.module,
    shipped: o.shipped,
    tested: o.tested,
    owners: decoded(
      memo.fetch(unit_of_query, bin::encode(o, owner_key_bin())),
      bin::list_bin(bin::bytes_bin()),
      "the declarations that may form a dependency cycle with this declaration",
    ),
  }

pub fn group_of(g: GroupKey) -> owner_checks::GroupResult / {memo.read, abort.raise} =
  owner_checks::decode_group(
    decoded(
      memo.fetch(group_query, bin::encode(g, group_key_bin())),
      owner_checks::encoded_group_bin(),
      "a group's result",
    ),
  )

fn entries_named<a>(entries: Map<Bytes, a>, names: Map<Bytes, Bool>) -> Map<Bytes, a> =
  entries.fold(Map::new(), |found: Map<Bytes, a>, name: Bytes, value: a|
    if names.contains(name) { found.insert(name, value) } else { found })

fn declared_by(
  stored: StoredDeclarations,
  module: Bytes,
  names: List<Bytes>,
) -> StoredDeclarations = {
  let mine = names.fold(Map::new(), |found: Map<Bytes, Bool>, n: Bytes|
    found.insert(qualify(module, n), true));
  {
    types: entries_named(stored.types, mine),
    effects: entries_named(stored.effects, mine),
    constructors: entries_named(stored.constructors, mine),
    definitions: entries_named(stored.definitions, mine),
    sets: entries_named(stored.sets, mine),
    schemas: entries_named(stored.schemas, mine),
    hosts: entries_named(stored.hosts, mine),
    parameters: entries_named(stored.parameters, mine),
  }
}

fn signature_declared(key: OwnerKey) -> StoredDeclarations / {memo.read, abort.raise} =
  decoded(
    memo.fetch(signatures_query, bin::encode(signature_unit_of(key), group_key_bin())),
    owner_checks::signature_check_bin(),
    "a group's signatures",
  ).declared

pub fn declarations_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let text = owner_facts(module_key_of(key), key.owner).text;
  let result = group_of(group_key_of(key));
  encoded_declarations(
    declared_by(
      if result.rejected.len() > 0 { signature_declared(key) } else { result.declared },
      key.module,
      text.names.push(key.owner),
    ),
  )
}

pub fn signature_declarations_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let text = owner_facts(module_key_of(key), key.owner).text;
  encoded_declarations(declared_by(signature_declared(key), key.module, text.names.push(key.owner)))
}

pub fn name_declaration_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, interface_key_bin(), "a declared name's key");
  let d = owners_result_of({
    module: key.module,
    shipped: key.shipped,
    tested: key.full_text,
  }).declarations;
  bin::encode(
    {
      value: lookup_declared(d, ValueSpace, key.name),
      of_type: lookup_declared(d, TypeSpace, key.name),
      of_effect: lookup_declared(d, EffectSpace, key.name),
      of_set: lookup_declared(d, SetSpace, key.name),
    },
    name_declarations_bin(),
  )
}

pub fn shown_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  match owner_checks::group_interfaces(
      memo.fetch(group_query, bin::encode(group_key_of(key), group_key_bin())),
    ).get(
      key.owner,
    ) {
    Some(entry) -> entry,
    None -> b"",
  }
}

pub fn owner_interface_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let shown = memo.fetch(shown_query, input);
  let alone = if shown.len() > 0 { shown } else { memo.fetch(group_interface_query, input) };
  if alone.len() == 0 { b"" } else {
    with_reach_digest(
      alone,
      dependencies_digest_of(key, unit_key_of(key), alone, shown_query, owner_interface_query),
    )
  }
}

type ReachSearch = {
  local: Map<Bytes, Bytes>,
  outside: Map<Bytes, Bytes>,
  seen: Map<Bytes, Bool>,
  work: List<Mention>,
}

fn dependencies_digest_of(
  key: OwnerKey,
  g: GroupKey,
  alone: Bytes,
  inside: Bytes,
  beyond: Bytes,
) -> Bytes / {memo.read, abort.raise} = {
  let walked = iterate(
    {
      local: Map::new().insert(key.owner, alone),
      outside: Map::new(),
      seen: Map::new(),
      work: interface_header(alone).mentions,
    },
    1000000,
    |s: ReachSearch|
      match s.work {
        [] -> Stop(s),
        [m, ..rest] -> if s.seen.contains(mention_key(m)) { Continue({ ..s, work: rest }) } else {
          let at = { ..s, seen: s.seen.insert(mention_key(m), true), work: rest };
          Continue(if m.module == b"" {
            {
              ..at,
              work: at.work.concat(
                called_of(value_call_modules(module_key_of(key), m.name).push(key.module), [
                  m.name,
                ]),
              ),
            }
          } else if m.module == key.module {
            declared_of(m.module, key.shipped, key.tested, m.name).fold(
              at,
              |accumulator: ReachSearch, o: Bytes|
                if accumulator.local.contains(o) { accumulator } else if g.owners.contains(o) {
                  let x = memo.fetch(
                    inside,
                    bin::encode(
                      { module: m.module, shipped: key.shipped, tested: key.tested, owner: o },
                      owner_key_bin(),
                    ),
                  );
                  if x.len() == 0 { accumulator } else {
                    {
                      ..accumulator,
                      local: accumulator.local.insert(o, x),
                      work: accumulator.work.concat(interface_header(x).mentions),
                    }
                  }
                } else {
                  let b = memo.fetch(
                    beyond,
                    bin::encode(
                      { module: m.module, shipped: key.shipped, tested: key.tested, owner: o },
                      owner_key_bin(),
                    ),
                  );
                  if b.len() == 0 { accumulator } else {
                    {
                      ..accumulator,
                      outside: accumulator.outside.insert(o, interface_header(b).transitive_digest),
                    }
                  }
                },
            )
          } else {
            let found = owner_interface_bytes_of(key.shipped, m.module, m.name);
            if found.len() == 0 {
              if m.name.starts_with(b"::") { at } else {
                let any = owner_interface_bytes_of(key.shipped, m.module, b"").len() > 0;
                {
                  ..at,
                  outside: at.outside.insert(b"there ".concat(m.module), if any { b"1" }
                  else { b"" }),
                }
              }
            } else {
              found.fold(at, |accumulator: ReachSearch, b: Bytes| {
                let h = interface_header(b);
                {
                  ..accumulator,
                  outside: accumulator.outside.insert(
                    Bytes::concat_all([m.module, b".", h.owner]),
                    h.transitive_digest,
                  ),
                }
              })
            }
          })
        },
      },
  );
  blake3(
    bin::encode(
      [
        if key.shipped { b"" } else {
          bin::encode(module_origin_of(package_location_of(key.module)), module_origin_bin())
        },
        bin::encode(walked.local, bin::map_bin(bin::bytes_bin(), bin::bytes_bin())),
        bin::encode(walked.outside, bin::map_bin(bin::bytes_bin(), bin::bytes_bin())),
      ],
      bin::list_bin(bin::bytes_bin()),
    ),
  )
}

fn signature_of(o: OwnerKey) -> Option<OwnerInterface> / {QueryEffects, abort.raise} =
  match owner_interfaces_once(signature_query, bin::encode(o, owner_key_bin()), |b: Bytes|
      if b.len() == 0 { [] } else { [decoded(b, owner_interface_bin(), "an entry")] }) {
    [e, ..] -> Some(e),
    [] -> None,
  }

fn group_interface_of(o: OwnerKey) -> Option<OwnerInterface> / {QueryEffects, abort.raise} =
  match owner_interfaces_once(shown_query, bin::encode(o, owner_key_bin()), |b: Bytes|
      if b.len() == 0 { [] } else { [decoded(b, owner_interface_bin(), "an entry")] }) {
    [e, ..] -> Some(e),
    [] -> None,
  }

fn owner_interface_of(o: OwnerKey) -> Option<OwnerInterface> / {QueryEffects, abort.raise} =
  match owner_interfaces_once(
      owner_interface_query,
      bin::encode(o, owner_key_bin()),
      |b: Bytes| if b.len() == 0 { [] } else { [decoded(b, owner_interface_bin(), "an entry")] },
    ) {
    [e, ..] -> Some(e),
    [] -> None,
  }

pub fn entry_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, interface_key_bin(), "an entry's name");
  bin::encode(
    declared_of(key.module, key.shipped, key.full_text, key.name).fold(
      [],
      |accumulator: List<Bytes>, o: Bytes| {
        let at = bin::encode(
          { module: key.module, shipped: key.shipped, tested: key.full_text, owner: o },
          owner_key_bin(),
        );
        let checked = memo.fetch(owner_interface_query, at);
        let e = if checked.len() > 0 { checked } else { memo.fetch(signature_query, at) };
        if e.len() == 0 { accumulator } else { accumulator.push(e) }
      },
    ),
    bin::list_bin(bin::bytes_bin()),
  )
}

pub fn group_keys(named: ModuleKey, read: OwnersResult) -> List<GroupKey> =
  read.groups.map(|g: List<Bytes>|
    { module: named.module, shipped: named.shipped, tested: named.tested, owners: g })

pub fn module_groups(
  named: ModuleKey,
  read: OwnersResult,
) -> List<GroupKey> / {memo.read, abort.raise} =
  group_keys(named, read).fold([], |accumulator: List<GroupKey>, unit: GroupKey|
    accumulator.concat(
      (if unit.owners.len() < 2 { [unit.owners] } else { cycles_of(unit) }).map(
        |owners: List<Bytes>| { ..unit, owners: owners },
      ),
    ))

pub fn layout_of(named: ModuleKey) -> ModuleLayout / {memo.read, abort.raise} =
  decoded(
    memo.fetch(layout_query, bin::encode(named, module_key_bin())),
    module_layout_bin(),
    "a module's layout",
  )

pub fn placed_facts(
  named: ModuleKey,
  layout: ModuleLayout,
) -> Map<Bytes, OwnerFacts> / {memo.read, abort.raise} =
  layout.owners.fold(Map::new(), |accumulator: Map<Bytes, OwnerFacts>, o: OwnerPlace| {
    let f = owner_facts(named, o.owner);
    accumulator.insert(o.owner, { ..f, text: { ..f.text, starts: o.starts } })
  })

fn module_source(named: ModuleKey) -> Source / {QueryEffects, abort.raise} =
  { name: named.module, source_text: match text_of(named) { Some(t) -> t, None -> b"" } }

fn published_mentions_of(
  shipped: Bool,
  own: Bytes,
  module: Bytes,
  owner: Bytes,
) -> List<Mention> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      published_query,
      bin::encode(
        {
          module: module,
          shipped: if module == own { shipped } else { shipped_for(shipped, module) },
          tested: false,
          owner: owner,
        },
        owner_key_bin(),
      ),
    ),
    bin::list_bin(mention_bin()),
    "what a module publishes",
  )

fn assembled_groups<| e>(
  named: ModuleKey,
  read: OwnersResult,
  layout: ModuleLayout,
  result_of: (GroupKey) -> owner_checks::GroupResult / {memo.read, abort.raise | e},
) -> owner_checks::AssembledModule / {memo.read, abort.raise | e} = {
  let facts = placed_facts(named, layout);
  owner_checks::assembled(
    named.module,
    { ..read.shape, outline: layout.outline },
    read.order,
    read.recorded,
    module_groups(named, read).map(|g: GroupKey|
      {
        items: item_layout(
          g.owners.map(|o: Bytes|
            match facts.get(o) {
              Some(f) -> f.text,
              None ->
                panic("a declaration in a checked group is missing from the module's declarations"),
            }),
        ),
        result: result_of(g),
      }),
    reports_unused(read),
  )
}

fn reports_unused(read: OwnersResult) -> Bool =
  read.context.setting.origin == InRoot
    || (read.context.setting.origin == ShippedModule && read.context.setting.tested)

pub fn module_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_result_of(named);
  let source = module_source(named);
  let result = bin::encode(
    if !read.found { absent(named.module) } else {
      let groups = group_keys(named, read);
      let a = assembled_groups(named, read, layout_of(named), group_of);
      let header = module_header(named).problems;
      let rejected = if header.len() > 0 { header } else { a.rejected };
      if rejected.len() > 0 {
        rejected_for(
          named.module,
          read,
          rejected,
          header.len() > 0 || signatures_unreadable(named, read),
        )
      } else {
        {
          imports: read.context.present,
          rejected: [],
          unreadable: false,
          warnings: a.warnings,
          definitions: a.definitions,
          tests: a.tests,
          rows: encode_rows(a.rows),
          shape: a.facts.shape,
          tables: encode_tables(a.facts.tables),
        }
      }
    },
    module_result_bin(),
  );
  decode_cache.evict_text_read(text_key(source));
  result
}

pub type GroupSummary = { rejected: Bool, warned: Bool, later: Bool, uses: List<UseLink> }

derive bin for GroupSummary

pub const group_summary_query: Bytes = b"group summary"

pub fn group_summary_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let g = decoded(
    memo.fetch(group_query, input),
    owner_checks::encoded_group_bin(),
    "a group's result",
  ).rest;
  bin::encode(
    {
      rejected: g.rejected.len() > 0,
      warned: g.members.any(|m: owner_checks::MemberResult| m.result.warnings.len() > 0),
      later: g.members.any(|m: owner_checks::MemberResult|
        m.result.tagged.len() + m.result.statements.len() > 0),
      uses: g.members.fold([], |accumulator: List<UseLink>, m: owner_checks::MemberResult|
        accumulator.concat(m.result.uses.map(link_of))),
    },
    group_summary_bin(),
  )
}

fn group_summary_of(g: GroupKey) -> GroupSummary / {memo.read, abort.raise} =
  decoded(
    memo.fetch(group_summary_query, bin::encode(g, group_key_bin())),
    group_summary_bin(),
    "a group's summary",
  )

pub const group_listing_query: Bytes = b"group listing"

pub fn group_listing_result(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  owner_checks::encode_group(
    owner_checks::listed_group(group_of(decoded(input, group_key_bin(), "a group's names"))),
  )

fn group_listing_of(g: GroupKey) -> owner_checks::GroupResult / {memo.read, abort.raise} =
  owner_checks::decode_group(
    decoded(
      memo.fetch(group_listing_query, bin::encode(g, group_key_bin())),
      owner_checks::encoded_group_bin(),
      "a group's listing",
    ),
  )

pub type ModuleListing = {
  shape: ModuleShape,
  tables: Bytes,
  warnings: List<Diagnostic>,
  imports: List<Bytes>,
  definitions: Int,
  tests: Int,
}

derive bin for ModuleListing

pub const module_listing_query: Bytes = b"module listing"

pub const module_rollup_query: Bytes = b"module rollup"

pub const module_constructors_query: Bytes = b"module constructors"

pub const reached_constructors_query: Bytes = b"reached constructors"

pub fn module_constructors_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let listing = decoded(
    memo.fetch(module_listing_query, input),
    module_listing_bin(),
    "a module's listing",
  );
  bin::encode(
    constructors_of_module(listing.shape, decode_tables(listing.tables)),
    known_constructors_bin(),
  )
}

pub fn constructors_reached_from(key: ModuleKey) -> KnownConstructors / {memo.read, abort.raise} =
  decoded(
    memo.fetch(reached_constructors_query, bin::encode(key, module_key_bin())),
    known_constructors_bin(),
    "the constructors a module reaches",
  )

pub fn reached_constructors_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  bin::encode(
    joined_constructors(
      imports_of_module(named).map(|i: ImportOf| constructors_reached_from(i.named)).push(
        decoded(
          memo.fetch(module_constructors_query, input),
          known_constructors_bin(),
          "a module's constructors",
        ),
      ),
    ),
    known_constructors_bin(),
  )
}

pub fn module_rollup_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let listing = decoded(
    memo.fetch(module_listing_query, input),
    module_listing_bin(),
    "a module's listing",
  );
  let hosted = effect_hosts([listing.shape.outline]).len() > 0;
  let tables = if !hosted { listing.tables } else {
    decoded(memo.fetch(module_query, input), module_result_bin(), "a module's result").tables
  };
  bin::encode(module_rollup(listing.shape, decode_tables(tables)), module_rollup_bin())
}

pub fn module_listing_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_result_of(named);
  let a = assembled_groups(named, read, layout_of(named), group_listing_of);
  bin::encode(
    {
      shape: a.facts.shape,
      tables: encode_tables(a.facts.tables),
      warnings: a.warnings,
      imports: read.context.present,
      definitions: a.definitions,
      tests: a.tests,
    },
    module_listing_bin(),
  )
}

fn signatures_unreadable(named: ModuleKey, read: OwnersResult) -> Bool / {memo.read, abort.raise} =
  read.rejecting
    || read.declared.any(|_: Bytes, owners: List<Bytes>|
      owners.any(|o: Bytes| memo.fetch(group_interface_query, owner_at(named, o)).len() == 0))

fn rejected_for(
  module: Bytes,
  read: OwnersResult,
  rejected: List<Diagnostic>,
  unreadable: Bool,
) -> ModuleResult / {abort.raise} =
  {
    ..absent(module),
    rejected: rejected,
    unreadable: unreadable,
    imports: read.context.present,
    shape: { ..no_shape(module), written: read.shape.written },
  }

pub const header_text_query: Bytes = b"header text"

pub const header_query: Bytes = b"header"

pub fn header_text_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, module_key_bin(), "a module's name");
  match text_of(key) {
    None -> b"",
    Some(text) -> match header_read({ name: key.module, source_text: text }) {
      None -> b"",
      Some(m) -> {
        let written = m.imports.filter(is_explicit_import);
        if written.len() == 0 { b"" }
        else { text.slice(0, max_of(written.map(|d: ImportDeclaration| d.span.end))) }
      },
    },
  }
}

fn header_read(source: Source) -> Option<Module> / {decode_cache.read, abort.raise} =
  match decode_cache.text_read(text_key(source)) {
    Some(r) -> header_of(r.lexed.input, r.lexed.parser),
    None -> header(source.source_text),
  }

fn max_of(xs: List<Int>) -> Int = xs.fold(0, |m: Int, x: Int| if x > m { x } else { m })

pub fn header_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, module_key_bin(), "a module's name");
  let prefix = memo.fetch(header_text_query, input);
  bin::encode(
    match if prefix.len() == 0 { None } else { header(prefix) } {
      None -> empty_header(key.module),
      Some(written) -> {
        let tables = import_packages(key);
        over_stored(stored_reads(key, tables, [], always_entire), ||
          import_problems({ name: key.module, module: written, derived: [] }, tables))
      },
    },
    module_header_bin(),
  )
}

fn module_header(named: ModuleKey) -> ModuleHeader / {memo.read, abort.raise} =
  decoded(
    memo.fetch(header_query, bin::encode(named, module_key_bin())),
    module_header_bin(),
    "a module's imports",
  )

pub fn group_hash_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a group's names");
  if !current_unit(key) {
    bin::encode(
      { entries: Map::new(), fixing: { nodes: [], tests: [], laws: [] } },
      group_hashes_bin(),
    )
  } else {
    let h = group_hash_inputs(key);
    let fixed_definitions = h.fixed.fold(
      Map::new(),
      |accumulator: Map<Bytes, Bool>, f: CachedNode|
        accumulator.insert(definition_key(f.name, f.declaration), true),
    );
    if h.forms.nodes.fold(false, |b: Bool, x: HashNode|
        b
          || (match x.form {
            None -> !fixed_definitions.contains(definition_key(x.name, x.declaration)),
            Some(_) -> false,
          })) {
      bin::encode(
        { entries: Map::new(), fixing: { nodes: [], tests: [], laws: [] } },
        group_hashes_bin(),
      )
    } else {
      let fixing = hash_forms(h.forms, h.fixed);
      bin::encode(
        { entries: hashes_by_owner(key.module, fixing.nodes, h.functions).entries, fixing: fixing },
        group_hashes_bin(),
      )
    }
  }
}

pub fn group_hash_inputs(
  key: GroupKey,
) -> { forms: HashInput, fixed: List<CachedNode>, functions: Map<Bytes, Bytes> } / {memo.read, abort.raise} = {
  let g = decoded(
    memo.fetch(group_forms_query, bin::encode(key, group_key_bin())),
    group_forms_bin(),
    "a group's forms",
  );
  let forms = g.forms;
  let fixed = forms.nodes.fold([], |accumulator: List<CachedNode>, s: HashNode|
    match s.form {
      Some(_) -> accumulator,
      None -> {
        let m = named_node(s.name);
        let shipped = if m.module == key.module { key.shipped }
        else { shipped_for(key.shipped, m.module) };
        let tested = if m.module == key.module { key.tested } else { false };
        declared_of(m.module, shipped, tested, m.name).fold(
          accumulator,
          |a: List<CachedNode>, o: Bytes|
            if m.module == key.module && key.owners.contains(o) { a } else {
              let e = memo.fetch(
                owner_hash_query,
                bin::encode(
                  { module: m.module, shipped: shipped, tested: tested, owner: o },
                  owner_key_bin(),
                ),
              );
              if e.len() == 0 { a }
              else { a.concat(decoded(e, hash_entry_bin(), "a hash entry").cached_nodes) }
            },
        )
      },
    });
  { forms: forms, fixed: fixed, functions: g.functions }
}

pub const group_forms_query: Bytes = b"group forms"

type GroupForms = { forms: HashInput, functions: Map<Bytes, Bytes> }

derive bin for GroupForms

pub fn group_forms_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a group's names");
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  if !current_unit(key) {
    bin::encode({ forms: owner_checks::no_group.forms, functions: Map::new() }, group_forms_bin())
  } else if key.owners.len() < 2 {
    forms_of(
      key.owners.map(|o: Bytes| owner_facts(named, o).text),
      decoded(
        memo.fetch(group_query, input),
        owner_checks::encoded_group_bin(),
        "a group's result",
      ).rest,
    )
  } else {
    formed(
      key.owners.map(|o: Bytes| owner_facts(named, o).text),
      joined_forms(
        cycles_of(key).map(|g: List<Bytes>|
          decoded(
            memo.fetch(group_query, bin::encode({ ..key, owners: g }, group_key_bin())),
            owner_checks::encoded_group_bin(),
            "a group's result",
          ).rest.forms),
      ),
    )
  }
}

fn forms_of(reads: List<OwnerText>, a: owner_checks::GroupResult) -> Bytes / {abort.raise} =
  formed(reads, a.forms)

fn formed(reads: List<OwnerText>, forms: HashInput) -> Bytes / {abort.raise} =
  bin::encode(
    {
      forms: forms,
      functions: reads.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, r: OwnerText|
        r.names.fold(accumulator, |m: Map<Bytes, Bytes>, n: Bytes| m.insert(n, r.owner))),
    },
    group_forms_bin(),
  )

fn group_hashes_of(g: GroupKey) -> GroupHashes / {memo.read, abort.raise} =
  decoded(
    memo.fetch(group_hash_query, bin::encode(g, group_key_bin())),
    group_hashes_bin(),
    "a group's hashing",
  )

pub fn owner_hash_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  match group_hashes_of(unit_key_of(key)).entries.get(key.owner) {
    Some(e) -> bin::encode(e, hash_entry_bin()),
    None -> b"",
  }
}

pub fn hashes_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let hashed = group_keys(named, owners_result_of(named)).map(group_hashes_of);
  let fixing = {
    nodes: hashed.fold([], |accumulator: List<CachedNode>, h: GroupHashes|
      accumulator.concat(h.fixing.nodes)),
    tests: hashed.fold([], |accumulator: List<CachedTest>, h: GroupHashes|
      accumulator.concat(h.fixing.tests)),
    laws: hashed.fold([], |accumulator: List<CachedLaw>, h: GroupHashes|
      accumulator.concat(h.fixing.laws)),
  };
  bin::encode({ fixing: fixing, record: record_digest(module_record(fixing)) }, hash_result_bin())
}

pub const hashes_query: Bytes = b"hashes"

pub type TestHash = { key: Bytes, hash: Bytes }

pub type HashSummary = { record: Bytes, tests: List<TestHash> }

derive bin for TestHash

derive bin for HashSummary

pub const hash_summary_query: Bytes = b"hash summary"

pub fn hash_summary_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let hashed = decoded(memo.fetch(hashes_query, input), hash_result_bin(), "a module's hashing");
  bin::encode(
    {
      record: hashed.record,
      tests: hashed.fixing.tests.map(|t: CachedTest| { key: t.key, hash: t.hash }),
    },
    hash_summary_bin(),
  )
}

pub const documented_query: Bytes = b"documented"

fn laws_referencing(lawful: ModuleKey) -> Map<Bytes, List<Bytes>> / {memo.read, abort.raise} = {
  let read = owners_result_of(lawful);
  read.owners.fold(Map::new(), |accumulator: Map<Bytes, List<Bytes>>, o: Bytes|
    if !o.starts_with(b"law ") { accumulator } else {
      let law = o.slice(4, o.len());
      let hashed = group_hashes_of({
        module: lawful.module,
        shipped: lawful.shipped,
        tested: lawful.tested,
        owners: group_containing(read, o),
      });
      hashed.fixing.laws.fold(accumulator, |by: Map<Bytes, List<Bytes>>, l: CachedLaw|
        l.refs.fold(by, |a: Map<Bytes, List<Bytes>>, r: NodeRef| {
          let recorded_laws = match a.get(r.name) { Some(laws) -> laws, None -> [] };
          if r.declaration || recorded_laws.contains(law) { a }
          else { a.insert(r.name, recorded_laws.push(law)) }
        }))
    })
}

pub fn documented_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, module_key_bin(), "a module's name");
  bin::encode(
    match module_read({ ..key, tested: true }) {
      None -> { pages: [] },
      Some(m) -> {
        let listing = decoded(
          memo.fetch(module_listing_query, input),
          module_listing_bin(),
          "a module's listing",
        );
        let hashed = decoded(
          memo.fetch(hashes_query, input),
          hash_result_bin(),
          "a module's hashing",
        );
        module_pages(m.parsed, m.source.source_text, {
          definitions: decode_tables(listing.tables).definitions,
          hashes: hashed.fixing.nodes.fold(
            Map::new(),
            |accumulator: Map<Bytes, Bytes>, f: CachedNode|
              if f.declaration { accumulator } else { accumulator.insert(f.name, f.hash) },
          ),
          laws_by_definition: if m.raw.items.fold(false, |b: Bool, item: Item|
              b || (match item { LawItem(_) -> true, _ -> false })) {
            laws_referencing({ ..key, tested: key.tested || key.shipped })
          } else { Map::new() },
        })
      },
    },
    pages_bin(),
  )
}

pub type ModuleSummary = {
  rejected: Bool,
  warned: Bool,
  functions: Int,
  tests: Int,
  written: List<Bytes>,
  checked_later: Bool,
  promises: Bool,
  measures: Bool,
}

pub type ProgramSummary = {
  cycle: Bool,
  rejected: List<Bytes>,
  warned: List<Bytes>,
  pulled: List<Bytes>,
  modules: Int,
  definitions: Int,
  tests: Int,
  checked_later: Bool,
  promises: Bool,
  measures: Bool,
}

derive bin for ModuleSummary

derive bin for ProgramSummary

pub const module_summary_query: Bytes = b"module summary"

pub const program_summary_query: Bytes = b"program summary"

fn states_promise(item: OutlineItem) -> Bool =
  match item { OutlinedFunction(f) -> f.reuse || f.returns, _ -> false }

fn states_measure(item: OutlineItem) -> Bool =
  match item { OutlinedFunction(f) -> f.measured, _ -> false }

pub fn module_summary_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_result_of(named);
  let summaries = module_groups(named, read).map(group_summary_of);
  let header = module_header(named).problems;
  let items = read.shape.outline.items;
  bin::encode(
    {
      rejected: read.rejecting || header.len() > 0 || summaries.any(|g: GroupSummary| g.rejected),
      warned: summaries.any(|g: GroupSummary| g.warned)
        || (reports_unused(read)
        && any_unreached(
          summaries.fold([], |accumulator: List<UseLink>, g: GroupSummary|
            accumulator.concat(g.uses)),
        )),
      functions: items.fold(0, |n: Int, item: OutlineItem|
        match item { OutlinedFunction(_) -> n + 1, _ -> n }),
      tests: items.fold(0, |n: Int, item: OutlineItem|
        match item { OutlinedTest(_) -> n + 1, _ -> n }),
      written: read.shape.written,
      checked_later: summaries.any(|g: GroupSummary| g.later)
        || items.any(|i: OutlineItem| states_promise(i) || states_measure(i)),
      promises: items.any(states_promise),
      measures: items.any(states_measure),
    },
    module_summary_bin(),
  )
}

fn summary_of(named: ModuleKey) -> ModuleSummary / {memo.read, abort.raise} =
  decoded(
    memo.fetch(module_summary_query, bin::encode(named, module_key_bin())),
    module_summary_bin(),
    "a module's summary",
  )

fn imports_of_module(named: ModuleKey) -> List<ImportOf> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(imports_query, bin::encode(named, module_key_bin())),
    imports_of_bin(),
    "a module's imports",
  ).imports

fn has_import_cycle(own: List<Bytes>) -> Bool / {memo.read, abort.raise} = {
  let edges = own.fold(Map::new(), |found: Map<Bytes, List<Bytes>>, m: Bytes|
    found.insert(
      m,
      imports_of_module({ module: m, shipped: false, tested: false }).filter(|i: ImportOf|
        !i.named.shipped).map(|i: ImportOf| i.named.module),
    ));
  iterate(own, own.len() + 2, |left: List<Bytes>| {
    let waiting = left.fold(Map::new(), |found: Map<Bytes, Bool>, m: Bytes| found.insert(m, true));
    let blocked = left.filter(|m: Bytes|
      List::any(match edges.get(m) { Some(es) -> es, None -> [] }, |d: Bytes| waiting.contains(d)));
    if blocked.len() == 0 { Stop(false) }
    else if blocked.len() == left.len() { Stop(true) }
    else { Continue(blocked) }
  })
}

pub fn program_summary_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let own = decoded(input, bin::list_bin(bin::bytes_bin()), "a program's modules");
  let nothing = {
    cycle: true,
    rejected: [],
    warned: [],
    pulled: [],
    modules: 0,
    definitions: 0,
    tests: 0,
    checked_later: false,
    promises: false,
    measures: false,
  };
  if has_import_cycle(own) { bin::encode(nothing, program_summary_bin()) } else {
    let mine = own.map(|m: Bytes| summary_of({ module: m, shipped: false, tested: false }));
    let flagged = |pick: (ModuleSummary) -> Bool|
      range(0, own.len()).filter(|i: Int| pick(mine.get(i))).map(|i: Int| own.get(i));
    let listed = (match memo.external(shipped_names_kind, b"") {
      Some(b) -> decoded(b, bin::list_bin(bin::bytes_bin()), "the shipped modules' names"),
      None -> [],
    }).fold(Map::new(), |found: Map<Bytes, Bool>, n: Bytes| found.insert(n, true));
    let written = range(0, own.len()).fold(Map::new(), |found: Map<Bytes, List<Bytes>>, i: Int|
      found.insert(own.get(i), mine.get(i).written));
    let pulled = iterate(
      { written: written, read: own, pulled: [], functions: 0, rejected: [] },
      listed.len() + 2,
      |x: { written: Map<Bytes, List<Bytes>>, read: List<Bytes>, pulled: List<Bytes>, functions: Int, rejected: List<Bytes> }| {
        let fresh = pulled_next(x.read, x.written, listed, []);
        if fresh.len() == 0 { Stop(x) } else {
          Continue(
            fresh.fold(
              { ..x, read: x.read.concat(fresh), pulled: x.pulled.concat(fresh) },
              |sofar: { written: Map<Bytes, List<Bytes>>, read: List<Bytes>, pulled: List<Bytes>, functions: Int, rejected: List<Bytes> }, n: Bytes| {
                let m = summary_of({ module: n, shipped: true, tested: false });
                {
                  ..sofar,
                  written: sofar.written.insert(n, m.written),
                  functions: if n == prelude_module { sofar.functions }
                  else { sofar.functions + m.functions },
                  rejected: if m.rejected { sofar.rejected.push(n) } else { sofar.rejected },
                }
              },
            ),
          )
        }
      },
    );
    bin::encode(
      {
        cycle: false,
        rejected: flagged(|m: ModuleSummary| m.rejected).concat(pulled.rejected),
        warned: flagged(|m: ModuleSummary| m.warned),
        pulled: pulled.pulled,
        modules: own.len() + pulled.pulled.len(),
        definitions: mine.fold(pulled.functions, |n: Int, m: ModuleSummary| n + m.functions),
        tests: mine.fold(0, |n: Int, m: ModuleSummary| n + m.tests),
        checked_later: mine.any(|m: ModuleSummary| m.checked_later),
        promises: mine.any(|m: ModuleSummary| m.promises),
        measures: mine.any(|m: ModuleSummary| m.measures),
      },
      program_summary_bin(),
    )
  }
}

pub const declaring_query: Bytes = b"declaring"

pub fn documenting_modules_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let shipped = match memo.external(shipped_names_kind, b"") {
    Some(b) -> decoded(b, bin::list_bin(bin::bytes_bin()), "the shipped modules' names"),
    None -> [],
  };
  let under = input.concat(b".");
  bin::encode(
    shipped.filter(|m: Bytes| m == input || m.starts_with(under)).fold(
      Map::new(),
      |accumulator: Map<Bytes, List<Bytes>>, m: Bytes|
        decoded(
          memo.fetch(
            documented_query,
            bin::encode({ module: m, shipped: true, tested: false }, module_key_bin()),
          ),
          pages_bin(),
          "a module's pages",
        ).pages.fold(accumulator, |by: Map<Bytes, List<Bytes>>, page: Page| {
          let simple = Bytes::of_string(page.simple);
          let listed_modules = match by.get(simple) { Some(ms) -> ms, None -> [] };
          if page.simple == "" || listed_modules.contains(m) { by }
          else { by.insert(simple, listed_modules.push(m)) }
        }),
    ),
    declaring_bin(),
  )
}

pub fn declaring_bin() -> bin::BinCodec<Map<Bytes, List<Bytes>>> =
  bin::map_bin(bin::bytes_bin(), bin::list_bin(bin::bytes_bin()))

