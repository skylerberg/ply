                               named_node, needed_by, wanted_in, entry_bin, hash_entry_bin,
                               placed_bin, mention_bin, owner_read_bin, module_scope, owner_reads,
                               owner_mentions, owner_groups, group_needs, group_source_from,
                               entry_head, mention_key, unplaced_imports, laid_items, checked_owner,
                               needed_through, head_of, called_of, of_any, reaching, signing_read,
