pub type OwnerKey = { module: Bytes, shipped: Bool, tested: Bool, owner: Bytes }

pub type GroupKey = { module: Bytes, shipped: Bool, tested: Bool, owners: List<Bytes> }

pub type OwnerFacts = { text: OwnerText, mentions: List<Mention> }

pub type OwnersResult = {
  found: Bool,
  signing: List<List<Bytes>>,
  declared: Map<Bytes, List<Bytes>>,
  shape: ModuleShape,
  order: List<Bytes>,
  recorded: List<Bytes>,
  stated: List<Bytes>,
  problems: List<Diagnostic>,
}

type FoundOwners = {
  result: OwnersResult,
  owners: List<Bytes>,
  groups: List<List<Bytes>>,
  values: Map<Bytes, List<Bytes>>,
  declarations: Declarations,
  context: Context,
}

pub type DeclaredOwners = { owners: List<Bytes>, values: List<Bytes> }

pub type OwnerPlace = { owner: Bytes, starts: List<Int> }

pub type ModuleLayout = { owners: List<OwnerPlace>, outline: Outline }

type OwnerRecord = { owner: Bytes, facts: OwnerFacts }

derive bin for OwnerKey

derive bin for GroupKey

derive bin for OwnerFacts

derive bin for OwnersResult

derive bin for DeclaredOwners

derive bin for OwnerPlace

derive bin for ModuleLayout

pub fn owners_query() -> QueryOf<ModuleKey, OwnersResult> =
  { name: b"owners", input: module_key_bin(), output: owners_result_bin() }

pub fn owners_part() -> PartOf<ModuleKey, OwnersResult, List<Bytes>> =
  { query: owners_query(), name: b"owners", output: bin::list_bin(bin::bytes_bin()) }

pub fn groups_part() -> PartOf<ModuleKey, OwnersResult, List<List<Bytes>>> =
  { query: owners_query(), name: b"groups", output: bin::list_bin(bin::list_bin(bin::bytes_bin())) }

pub fn layout_part() -> PartOf<ModuleKey, OwnersResult, ModuleLayout> =
  { query: owners_query(), name: b"layout", output: module_layout_bin() }

pub fn context_part() -> PartOf<ModuleKey, OwnersResult, Context> =
  { query: owners_query(), name: b"context", output: context_bin() }

pub fn setting_part() -> PartOf<ModuleKey, OwnersResult, Setting> =
  { query: owners_query(), name: b"setting", output: setting_bin() }

pub fn names_part() -> PartOf<ModuleKey, OwnersResult, List<Bytes>> =
  { query: owners_query(), name: b"names", output: bin::list_bin(bin::bytes_bin()) }

pub fn module_declarations_part() -> PartOf<ModuleKey, OwnersResult, Declarations> =
  { query: owners_query(), name: b"module declarations", output: declarations_bin() }

pub fn owner_part() -> KeyedPartOf<ModuleKey, OwnersResult, Bytes, OwnerFacts> =
  { query: owners_query(), name: b"owner", key: bin::bytes_bin(), output: owner_facts_bin() }

pub fn unit_part() -> KeyedPartOf<ModuleKey, OwnersResult, Bytes, List<Bytes>> =
  {
    query: owners_query(),
    name: b"unit",
    key: bin::bytes_bin(),
    output: bin::list_bin(bin::bytes_bin()),
  }

pub fn shape_part() -> KeyedPartOf<ModuleKey, OwnersResult, Bytes, OwnerFacts> =
  { query: owners_query(), name: b"shape", key: bin::bytes_bin(), output: owner_facts_bin() }

pub fn signature_unit_part() -> KeyedPartOf<ModuleKey, OwnersResult, Bytes, List<Bytes>> =
  {
    query: owners_query(),
    name: b"signature unit",
    key: bin::bytes_bin(),
    output: bin::list_bin(bin::bytes_bin()),
  }

pub fn declared_part() -> KeyedPartOf<ModuleKey, OwnersResult, Bytes, DeclaredOwners> =
  { query: owners_query(), name: b"declared", key: bin::bytes_bin(), output: declared_owners_bin() }

pub fn signature_declarations_query() -> QueryOf<OwnerKey, StoredDeclarations> =
  { name: b"signature declarations", input: owner_key_bin(), output: stored_declarations_bin() }

pub fn name_declaration_query() -> QueryOf<InterfaceKey, NameDeclarations> =
  { name: b"name declaration", input: interface_key_bin(), output: name_declarations_bin() }

pub fn calls_query() -> QueryOf<OwnerKey, List<Bytes>> =
  { name: b"calls", input: owner_key_bin(), output: bin::list_bin(bin::bytes_bin()) }

pub fn cycles_query() -> QueryOf<GroupKey, List<List<Bytes>>> =
  {
    name: b"cycles",
    input: group_key_bin(),
    output: bin::list_bin(bin::list_bin(bin::bytes_bin())),
  }

pub fn group_of_query() -> QueryOf<OwnerKey, List<Bytes>> =
  { name: b"group of", input: owner_key_bin(), output: bin::list_bin(bin::bytes_bin()) }

pub fn group_imports_query() -> QueryOf<GroupKey, List<Imported>> =
  { name: b"group imports", input: group_key_bin(), output: bin::list_bin(imported_bin()) }

pub fn owner_imports_query() -> QueryOf<OwnerKey, List<Imported>> =
  { name: b"owner imports", input: owner_key_bin(), output: bin::list_bin(imported_bin()) }

pub fn signature_imports_query() -> QueryOf<GroupKey, List<Imported>> =
  { name: b"signature imports", input: group_key_bin(), output: bin::list_bin(imported_bin()) }

pub fn visible_modules_query() -> QueryOf<ModuleKey, List<Bytes>> =
  { name: b"sees", input: module_key_bin(), output: bin::list_bin(bin::bytes_bin()) }

pub fn wanted_files_query() -> QueryOf<ModuleKey, ShippedWants> =
  { name: b"wants", input: module_key_bin(), output: shipped_wants_bin() }

pub fn group_query() -> QueryOf<GroupKey, owner_checks::EncodedGroup> =
  { name: b"group", input: group_key_bin(), output: owner_checks::encoded_group_bin() }

pub fn signatures_query() -> QueryOf<GroupKey, owner_checks::SignatureCheck> =
  { name: b"signatures", input: group_key_bin(), output: owner_checks::signature_check_bin() }

pub fn typed_query() -> QueryOf<OwnerKey, owner_checks::InferenceResult> =
  { name: b"typed", input: owner_key_bin(), output: owner_checks::inference_result_bin() }

pub fn group_hash_query() -> QueryOf<GroupKey, OwnHashes> =
  { name: b"group hash", input: group_key_bin(), output: own_hashes_bin() }

pub fn owner_hash_query() -> QueryOf<OwnerKey, OwnHashes> =
  { name: b"owner hash", input: owner_key_bin(), output: own_hashes_bin() }

pub fn module_key_of(o: OwnerKey) -> ModuleKey =
  { module: o.module, shipped: o.shipped, tested: o.tested }

pub fn owners_result_of(named: ModuleKey) -> OwnersResult / {memo.read, abort.raise} =
  fetch(owners_query(), named)

pub fn module_owners(named: ModuleKey) -> List<Bytes> / {memo.read, abort.raise} =
  fetch_part(owners_part(), named)

const no_context: Context =
  {
    imports: [],
    targets: [],
    present: [],
    setting: {
      origin: ShippedModule,
      packages: { root: b"", manifest: None, supplied: [] },
      resolved_packages: None,
      tested: false,
      unread: [],
      wanted_texts: [],
      data: [],
      embeds: [],
    },
  }

fn resolved_imports(m: ModuleRead) -> List<Bytes> =
  m.names.concat(m.parsed.module.imports.drop(m.raw.imports.len()).map(import_path)).fold(
    [],
    |accumulator: List<Bytes>, n: Bytes|
      if accumulator.contains(n) || (!m.present.contains(n) && m.names.contains(n)) { accumulator }
      else { accumulator.push(n) },
  )

fn unread_module(module: Bytes) -> FoundOwners =
  {
    result: {
      found: false,
      signing: [],
      declared: Map::new(),
      shape: no_shape(module),
      order: [],
      recorded: [],
      stated: [],
      problems: [],
    },
    owners: [],
    groups: [],
    values: Map::new(),
    declarations: no_declarations,
    context: no_context,
  }

fn unplaced_record(o: OwnerText, mentions: Map<Bytes, List<Mention>>) -> OwnerRecord =
  {
    owner: o.owner,
    facts: {
      text: { ..o, starts: o.starts.map(|_: Int| 0) },
      mentions: match mentions.get(o.owner) { Some(ms) -> ms, None -> [] },
    },
  }

pub fn find_owners(key: ModuleKey) -> Written / {QueryEffects, abort.raise} =
  match module_read(key) {
    None -> {
      let read = unread_module(key.module);
      owners_written(read, [], [], { owners: [], outline: read.result.shape.outline })
    },
    Some(m) -> {
      let module = m.source.name;
      let scope = module_scope(m.parsed, m.raw, m.names);
      let reads = owner_texts(m.parsed, m.raw, m.source.source_text);
      let mentions = reads.fold(
        Map::new(),
        |accumulator: Map<Bytes, List<Mention>>, o: OwnerText|
          accumulator.insert(
            o.owner,
            owner_mentions(module, scope, o, m.source.source_text, owner_tokens(m.tokens, o)),
          ),
      );
      let imported = resolved_imports(m);
      let items = requests_by_item(m.parsed.module);
      let shapes = reads.map(|o: OwnerText| signature_text(m.raw, o));
      let shape_mentions = range(0, reads.len()).fold(
        Map::new(),
        |accumulator: Map<Bytes, List<Mention>>, k: Int| {
          let o = reads.get(k);
          let lexed = signature_tokens(m.raw, m.tokens, o);
          accumulator.insert(
            o.owner,
            owner_mentions(module, scope, shapes.get(k), m.source.source_text, lexed),
          )
        },
      );
      let outline = {
        let o = read_outline(m.parsed);
        if m.reading.tested { o } else {
          {
            ..o,
            items: o.items.filter(|x: OutlineItem|
              match x { OutlinedTest(_) -> false, OutlinedLaw(_) -> false, _ -> true }),
          }
        }
      };
      let read = {
        result: {
          found: true,
          signing: owner_groups(module, scope, reads.map(|o: OwnerText| o.owner), shape_mentions),
          declared: scope.written.owners,
          shape: {
            outline: unplaced_outline(outline),
            imports: imported,
            unimported: m.unimported,
            named: named_imports(m.parsed, imported),
            written: m.parsed.module.imports.map(import_module_name).concat(
              m.present.filter(|p: Bytes| !m.names.contains(p)),
            ),
            embeds: [],
            embed_items: if items.fold(false, |b: Bool, x: ItemEmbeds| b || x.wants.len() > 0) {
              items
            } else { [] },
            tagged: [],
            statements: [],
            consts: [],
          },
          order: checked_functions(m.parsed),
          recorded: check_order(m.parsed),
          stated: stated_functions(module, m.parsed.module),
          problems: m.reading.given.flat_map(|g: ParsedSource|
            g.diagnostics.filter(|d: Diagnostic| d.severity == Error)),
        },
        owners: reads.map(|o: OwnerText| o.owner),
        groups: owner_groups(module, scope, reads.map(|o: OwnerText| o.owner), mentions),
        values: value_owners(m.raw, m.parsed),
        declarations: unplaced_declarations(declarations_of(m.parsed)),
        context: {
          imports: unplaced_imports(m.raw),
          targets: m.names,
          present: m.present,
          setting: {
            origin: m.placed,
            packages: m.reading.packages,
            resolved_packages: m.reading.checked_packages,
            tested: m.reading.tested,
            unread: m.reading.unread,
            wanted_texts: m.reading.all_sources,
            data: m.reading.data,
            embeds: m.reading.embeds,
          },
        },
      };
      owners_written(
        read,
        reads.map(|o: OwnerText| unplaced_record(o, mentions)),
        shapes.map(|o: OwnerText| unplaced_record(o, shape_mentions)),
        {
          owners: reads.map(|o: OwnerText| { owner: o.owner, starts: o.starts }),
          outline: outline,
        },
      )
    },
  }

pub fn list_visible_modules(named: ModuleKey) -> Written / {memo.read, abort.raise} = {
  let context = fetch_part(context_part(), named);
  let seen = context.present.fold(Map::new(), |accumulator: Map<Bytes, Bool>, m: Bytes|
    visible_modules_of({ module: m, shipped: shipped_for(named.shipped, m), tested: false }).fold(
      accumulator.insert(m, true),
      |a: Map<Bytes, Bool>, below: Bytes| a.insert(below, true),
    ));
  written(visible_modules_query(), seen.keys())
}

fn visible_modules_of(named: ModuleKey) -> List<Bytes> / {memo.read, abort.raise} =
  fetch(visible_modules_query(), named)

pub fn value_call_modules_query() -> QueryOf<InterfaceKey, List<Bytes>> =
  { name: b"answering", input: interface_key_bin(), output: bin::list_bin(bin::bytes_bin()) }

pub fn symbols_query() -> QueryOf<Bool, Unit> =
  { name: b"symbols", input: bin::bool_bin(), output: bin::unit_bin() }

pub fn symbol_part() -> KeyedPartOf<Bool, Unit, Bytes, List<Bytes>> =
  {
    query: symbols_query(),
    name: b"symbol",
    key: bin::bytes_bin(),
    output: bin::list_bin(bin::bytes_bin()),
  }

pub fn modules_declaring(shipped: Bool, name: Bytes) -> List<Bytes> / {memo.read, abort.raise} =
  fetch_keyed_part(symbol_part(), shipped, any_module_name(name)).unwrap_or([])

pub fn list_symbols(shipped: Bool) -> Written / {memo.read, abort.raise} = {
  let listed = shipped_names_listed();
  let own = if shipped { [] } else {
    match memo.external(own_modules_kind, b"") {
      Some(b) -> decoded(b, bin::list_bin(bin::bytes_bin()), "the program's modules"),
      None -> [],
    }
  };
  let declaring = own.concat(listed.filter(|m: Bytes| !own.contains(m))).fold(
    Map::new(),
    |found: Map<Bytes, List<Bytes>>, m: Bytes|
      names_of({ module: m, shipped: shipped_for(shipped, m), tested: false }).filter(
        |n: Bytes| n.starts_with(b"::"),
      ).fold(found, |by: Map<Bytes, List<Bytes>>, n: Bytes|
        by.insert(n, (match by.get(n) { Some(ms) -> ms, None -> [] }).push(m))),
  );
  declaring.fold(written(symbols_query(), ()), |w: Written, name: Bytes, modules: List<Bytes>|
    with_keyed_part(w, symbol_part(), name, modules))
}

pub fn find_declaring_modules(key: InterfaceKey) -> Written / {memo.read, abort.raise} = {
  let declaring = modules_declaring(key.shipped, key.name);
  written(
    value_call_modules_query(),
    visible_modules_of({ module: key.module, shipped: key.shipped, tested: key.full_text }).filter(
      |m: Bytes| declaring.contains(m),
    ),
  )
}

fn value_call_modules(named: ModuleKey, name: Bytes) -> List<Bytes> / {memo.read, abort.raise} =
  fetch(value_call_modules_query(), {
    module: named.module,
    shipped: named.shipped,
    full_text: named.tested,
    name: name,
  })

pub fn find_calls(key: OwnerKey) -> Written / {memo.read, abort.raise} = {
  let named = module_key_of(key);
  written(
    calls_query(),
    called_owners(
      key.owner,
      owner_checks::called_names(key.module, inference_of(named, key.owner)),
      |n: Bytes| declared_of(key.module, key.shipped, key.tested, n),
    ),
  )
}

fn called_owners<| e>(
  owner: Bytes,
  names: List<Bytes>,
  declared: (Bytes) -> List<Bytes> / {abort.raise | e},
) -> List<Bytes> / {abort.raise | e} =
  sorted_bytes(
    names.fold([], |accumulator: List<Bytes>, n: Bytes|
      declared(n).fold(accumulator, |a: List<Bytes>, o: Bytes|
        if o == owner || a.contains(o) { a } else { a.push(o) })),
  )

fn calls_of(named: ModuleKey, owner: Bytes) -> List<Bytes> / {memo.read, abort.raise} =
  fetch(calls_query(), owner_key_at(named, owner))

pub fn find_cycles(key: GroupKey) -> Written / {memo.read, abort.raise} = {
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  written(cycles_query(), if !current_unit(key) { [] }
  else if key.owners.len() < 2 { [key.owners] }
  else { call_cycles(key.owners, key.owners.map(|o: Bytes| calls_of(named, o))) })
}

fn cycles_of(unit: GroupKey) -> List<List<Bytes>> / {memo.read, abort.raise} =
  fetch(cycles_query(), unit)

pub fn find_group_of(key: OwnerKey) -> Written / {memo.read, abort.raise} =
  written(
    group_of_query(),
    cycles_of(unit_key_of(key)).fold([], |accumulator: List<Bytes>, g: List<Bytes>|
      if g.contains(key.owner) { g } else { accumulator }),
  )

pub fn list_wanted_files(named: ModuleKey) -> Written / {memo.read, abort.raise} = {
  let setting = fetch_part(setting_part(), named);
  written(wanted_files_query(), {
    texts: setting.wanted_texts.map(|s: Source| s.name),
    data: setting.data.map(|d: EmbedFile| d.name),
  })
}

pub fn resolve_group_imports(key: GroupKey) -> Written / {QueryEffects, abort.raise} =
  written(group_imports_query(), if !current(key) { [] } else {
    let named = { module: key.module, shipped: key.shipped, tested: key.tested };
    imports_of_members(named, key.owners.map(|o: Bytes| owner_facts(named, o)))
  })

pub fn resolve_owner_imports(key: OwnerKey) -> Written / {QueryEffects, abort.raise} = {
  let named = module_key_of(key);
  let context = context_once(named);
  let facts = owner_facts(named, key.owner);
  written(
    owner_imports_query(),
    group_imports(key.module, [facts.text], facts.mentions, context.imports, context.targets),
  )
}

pub fn resolve_signature_imports(key: GroupKey) -> Written / {QueryEffects, abort.raise} = {
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  let context = context_once(named);
  let members = key.owners.map(|o: Bytes| shape_of(named, o));
  written(
    signature_imports_query(),
    group_imports(
      key.module,
      members.map(|f: OwnerFacts| f.text),
      members.fold([], |accumulator: List<Mention>, f: OwnerFacts| accumulator.concat(f.mentions)),
      context.imports,
      context.targets,
    ),
  )
}

pub fn context_once(named: ModuleKey) -> Context / {SessionReads, abort.raise} =
  fetch_part_once(
    context_part(),
    named,
    |digest: Bytes| decode_cache.context(digest),
    |digest: Bytes, c: Context| decode_cache.cache_context(digest, c),
  )

fn declarations_once(named: ModuleKey) -> Declarations / {SessionReads, abort.raise} =
  fetch_part_once(
    module_declarations_part(),
    named,
    |digest: Bytes| decode_cache.module_declarations(digest),
    |digest: Bytes, d: Declarations| decode_cache.cache_module_declarations(digest, d),
  )

fn names_of(named: ModuleKey) -> List<Bytes> / {memo.read, abort.raise} =
  fetch_part(names_part(), named)

fn group_containing(groups: List<List<Bytes>>, owner: Bytes) -> List<Bytes> =
  groups.fold([], |accumulator: List<Bytes>, g: List<Bytes>|
    if g.contains(owner) { g } else { accumulator })

fn signing_with(read: OwnersResult, owner: Bytes) -> List<Bytes> =
  read.signing.fold([], |accumulator: List<Bytes>, g: List<Bytes>|
    if g.contains(owner) { g } else { accumulator })

fn declared_in(read: FoundOwners, name: Bytes) -> DeclaredOwners =
  if name == b"" { { owners: read.owners, values: [] } } else {
    {
      owners: match read.result.declared.get(name) { Some(os) -> os, None -> [] },
      values: match read.values.get(name) { Some(os) -> os, None -> [] },
    }
  }

fn owners_written(
  read: FoundOwners,
  owners: List<OwnerRecord>,
  shapes: List<OwnerRecord>,
  layout: ModuleLayout,
) -> Written / {abort.raise} = {
  let module_parts = with_part(
    with_part(
      with_part(
        with_part(
          with_part(
            with_part(
              with_part(written(owners_query(), read.result), owners_part(), read.owners),
              groups_part(),
              read.groups,
            ),
            layout_part(),
            layout,
          ),
          context_part(),
          read.context,
        ),
        setting_part(),
        read.context.setting,
      ),
      names_part(),
      read.result.declared.keys(),
    ),
    module_declarations_part(),
    read.declarations,
  );
  let with_owners = owners.fold(module_parts, |w: Written, o: OwnerRecord|
    with_keyed_part(w, owner_part(), o.owner, o.facts));
  let with_units = read.owners.fold(with_owners, |w: Written, o: Bytes|
    with_keyed_part(w, unit_part(), o, group_containing(read.groups, o)));
  let with_shapes = shapes.fold(with_units, |w: Written, o: OwnerRecord|
    with_keyed_part(
      with_keyed_part(w, shape_part(), o.owner, o.facts),
      signature_unit_part(),
      o.owner,
      signing_with(read.result, o.owner),
    ));
  read.result.declared.keys().push(b"").fold(with_shapes, |w: Written, name: Bytes|
    with_keyed_part(w, declared_part(), name, declared_in(read, name)))
}

fn owner_key_at(named: ModuleKey, owner: Bytes) -> OwnerKey =
  { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner }

pub fn declared_of(
  module: Bytes,
  shipped: Bool,
  tested: Bool,
  name: Bytes,
) -> List<Bytes> / {memo.read, abort.raise} = owners_of_name(module, shipped, tested, name).owners

fn owners_of_name(
  module: Bytes,
  shipped: Bool,
  tested: Bool,
  name: Bytes,
) -> DeclaredOwners / {memo.read, abort.raise} =
  fetch_keyed_part(
    declared_part(),
    { module: module, shipped: shipped, tested: tested },
    name,
  ).unwrap_or({ owners: [], values: [] })

pub fn owner_facts(named: ModuleKey, owner: Bytes) -> OwnerFacts / {memo.read, abort.raise} =
  match fetch_keyed_part(owner_part(), named, owner) {
    Some(f) -> f,
    None ->
      panic(
        "the module `" ++ String::of_bytes_lossy(named.module) ++ "` holds no declaration `"
          ++ String::of_bytes_lossy(owner)
          ++ "`",
      ),
  }

pub fn check_group(key: GroupKey) -> Written / {QueryEffects, abort.raise} =
  if !current(key) { group_written(owner_checks::no_group, owner_checks::no_group, None, []) }
  else {
    let named = { module: key.module, shipped: key.shipped, tested: key.tested };
    let alone = unit_key_of({
        module: key.module,
        shipped: key.shipped,
        tested: key.tested,
        owner: key.owners.at_or(0, b""),
      }).owners.len(
      )
      < 2;
    let members = key.owners.map(|o: Bytes| owner_facts(named, o));
    let checked = if alone {
      let c = group_checked(named, members, imports_of(key), from_groups, no_bodies);
      { result: checked_group_result(key.module, c), lowering: lowering_of(c) }
    } else { finalize_group(named, key, members) };
    let result = checked.result;
    range(0, key.owners.len()).fold(
      group_written(
        owner_checks::facts_of_group(result),
        result,
        checked.lowering,
        members.map(|f: OwnerFacts| f.text),
      ),
      |w: Written, i: Int| {
        let owner = key.owners.get(i);
        with_keyed_part(
          w,
          declarations_part(),
          owner,
          with_module_opaque(
            named,
            declared_by(result.declared, key.module, members.get(i).text.names.push(owner)),
          ),
        )
      },
    )
  }

fn group_written(
  facts: owner_checks::GroupResult,
  result: owner_checks::GroupResult,
  lowering: Option<GroupLowering>,
  texts: List<OwnerText>,
) -> Written / {abort.raise} =
  with_part(
    with_part(
      with_part(
        with_part(
          with_part(
            written(group_query(), owner_checks::encoded_group(facts)),
            lowering_part(),
            lowering,
          ),
          listing_part(),
          owner_checks::encoded_group(owner_checks::listed_group(result)),
        ),
        summary_part(),
        owner_checks::group_flags(result),
      ),
      rows_part(),
      result.members.map(|m: owner_checks::MemberResult| encode_rows(owner_checks::member_rows(m))),
    ),
    forms_part(),
    formed(texts, result.forms),
  )

pub fn lowering_part() -> PartOf<GroupKey, owner_checks::EncodedGroup, Option<GroupLowering>> =
  { query: group_query(), name: b"lowering", output: bin::option_bin(group_lowering_bin()) }

pub fn listing_part() -> PartOf<GroupKey, owner_checks::EncodedGroup, owner_checks::EncodedGroup> =
  { query: group_query(), name: b"listing", output: owner_checks::encoded_group_bin() }

pub fn summary_part() -> PartOf<GroupKey, owner_checks::EncodedGroup, owner_checks::GroupFlags> =
  { query: group_query(), name: b"summary", output: owner_checks::group_flags_bin() }

pub fn rows_part() -> PartOf<GroupKey, owner_checks::EncodedGroup, List<Bytes>> =
  { query: group_query(), name: b"rows", output: bin::list_bin(bin::bytes_bin()) }

pub fn forms_part() -> PartOf<GroupKey, owner_checks::EncodedGroup, GroupForms> =
  { query: group_query(), name: b"forms", output: group_forms_bin() }

pub fn declarations_part() -> KeyedPartOf<GroupKey, owner_checks::EncodedGroup, Bytes, StoredDeclarations> =
  {
    query: group_query(),
    name: b"declarations",
    key: bin::bytes_bin(),
    output: stored_declarations_bin(),
  }

fn mentions_of(members: List<OwnerFacts>) -> List<Mention> =
  members.fold([], |found: List<Mention>, f: OwnerFacts| found.concat(f.mentions))

fn imports_of_members(
  named: ModuleKey,
  members: List<OwnerFacts>,
) -> List<Imported> / {SessionReads, abort.raise} = {
  let context = context_once(named);
  group_imports(
    named.module,
    members.map(|f: OwnerFacts| f.text),
    members.fold([], |accumulator: List<Mention>, f: OwnerFacts| accumulator.concat(f.mentions)),
    context.imports,
    context.targets,
  )
}

pub type DeclarationSource = | GroupDeclarations | SignatureDeclarations

pub fn from_groups(_: Bytes) -> DeclarationSource = GroupDeclarations

fn from_signatures(_: Bytes) -> DeclarationSource = SignatureDeclarations

pub type UnitCheck = { texts: List<OwnerText>, source: OwnerSource, out: GroupCheck }

pub type BodySupplier = (OwnerSource) -> Option<(Int) -> BodyPlan / {abort.raise}> / {abort.raise}

pub fn no_bodies(_: OwnerSource) -> Option<(Int) -> BodyPlan / {abort.raise}> = None

fn inferring_only(walked: List<Bytes>) -> BodySupplier =
  |_: OwnerSource| Some(|_: Int| CheckOnly(walked))

pub fn stored_declarations_of(
  at: OwnerKey,
  source: DeclarationSource,
) -> StoredDeclarations / {SessionReads, abort.raise} = {
  let cached = |digest: Bytes| decode_cache.declarations(digest);
  let cache = |digest: Bytes, d: StoredDeclarations| decode_cache.cache_declarations(digest, d);
  match source {
    SignatureDeclarations ->
      fetch_part_once(main_part_of(signature_declarations_query()), at, cached, cache),
    GroupDeclarations ->
      fetch_keyed_part_once(
        declarations_part(),
        group_key_of(at),
        at.owner,
        cached,
        cache,
      ).unwrap_or(
        no_stored_declarations,
      ),
  }
}

fn owner_key_in(
  named: ModuleKey,
  asker: Bool,
  module: Bytes,
  owner: Bytes,
) -> OwnerKey / {memo.read, abort.raise} =
  if module == named.module {
    { module: module, shipped: named.shipped, tested: named.tested, owner: owner }
  } else { { module: module, shipped: shipped_for(asker, module), tested: false, owner: owner } }

fn owners_declaring(
  named: ModuleKey,
  asker: Bool,
  module: Bytes,
  name: Bytes,
) -> List<OwnerKey> / {memo.read, abort.raise} =
  owners_declaring_in(named, asker, module, name, None)

fn owners_declaring_in(
  named: ModuleKey,
  asker: Bool,
  module: Bytes,
  name: Bytes,
  namespace: Option<Namespace>,
) -> List<OwnerKey> / {memo.read, abort.raise} = {
  let at = owner_key_in(named, asker, module, b"");
  let found = owners_of_name(module, at.shipped, at.tested, name);
  (match namespace {
    None -> found.owners,
    Some(ValueSpace) -> found.values,
    Some(_) -> found.owners.filter(|o: Bytes| o == name),
  }).map(|o: Bytes| { ..at, owner: o })
}

fn declared_names_of(
  named: ModuleKey,
  asker: Bool,
  module: Bytes,
  name: Bytes,
) -> NameDeclarations / {SessionReads, abort.raise} = {
  let at = owner_key_in(named, asker, module, b"");
  if at.shipped { names_declared_in(declarations_once(module_key_of(at)), name) } else {
    fetch(name_declaration_query(), {
      module: module,
      shipped: at.shipped,
      full_text: at.tested,
      name: name,
    })
  }
}

fn package_of_module(
  named: ModuleKey,
  tables: ImportPackages,
  module: Bytes,
) -> Option<Int> / {memo.read, abort.raise} = {
  let shipped_place = if is_compiler(module) { tables.compiler }
  else { tables.other_shipped_package };
  let shipped = if shipped_module_exists(module) { Some(shipped_place) } else { None };
  if named.shipped { shipped }
  else { match package_location_of(module) { Some(p) -> Some(p.package), None -> shipped } }
}

pub fn import_packages(named: ModuleKey) -> ImportPackages / {memo.read, abort.raise} = {
  let listed = if named.shipped { [] } else {
    build_packages().packages.map(|p: Package| { prefix: p.prefix, dependencies: p.dependencies })
  };
  let own = if listed.len() == 0 { [{ prefix: b"", dependencies: [] }] } else { listed };
  let std = own.len();
  let compiler = std + 1;
  let tables = {
    package: 0,
    packages: own.push(std_package).push(compiler_package),
    std: std,
    compiler: compiler,
    other_shipped_package: compiler + 1,
  };
  {
    ..tables,
    package: match package_of_module(named, tables, named.module) {
      Some(p) -> p,
      None -> tables.other_shipped_package,
    },
  }
}

fn is_loaded(inside: Map<Bytes, Bool>, module: Bytes, owner: Bytes) -> Bool =
  inside.contains(mention_key({ module: module, name: owner }))

fn stored_reads(
  named: ModuleKey,
  asker: Bool,
  tables: ImportPackages,
  inside: Map<Bytes, Bool>,
  declared_from: keep (Bytes) -> DeclarationSource,
) -> StoredReads<| {decode_cache.read, decode_cache.write, memo.read}> =
  {
    declarations_of: |qualified: Bytes, namespace: Option<Namespace>| {
      let module = module_of_name(qualified);
      if module.len() == 0 { [] } else {
        owners_declaring_in(
          named,
          asker,
          module,
          qualified.slice(module.len() + 1, qualified.len()),
          namespace,
        ).filter(|at: OwnerKey| !is_loaded(inside, module, at.owner)).map(|at: OwnerKey|
          stored_declarations_of(at, if module == named.module { declared_from(at.owner) }
          else { GroupDeclarations }))
      }
    },
    module_package: |module: Bytes| package_of_module(named, tables, module),
    module_scope: |module: Bytes|
      Some(module_header(module_key_of(owner_key_in(named, asker, module, b""))).scope),
    names_declared: |module: Bytes, name: Bytes| declared_names_of(named, asker, module, name),
    module_declarations: |module: Bytes|
      Some(declarations_once(module_key_of(owner_key_in(named, asker, module, b"")))),
    visible_modules: || visible_modules_of(named),
    every_module: || visible_modules_of(named),
    shipped_modules: shipped_names_listed,
  }

pub fn with_stored_reads<a | e>(
  named: ModuleKey,
  body: () -> a / {CheckReads, SessionReads, abort.raise | e},
) -> a / {SessionReads, abort.raise | e} =
  over_stored(
    stored_reads(named, named.shipped, import_packages(named), Map::new(), from_groups),
    body,
  )

pub fn module_key_in(module: Bytes, tested: Bool) -> ModuleKey / {memo.read, abort.raise} = {
  let shipped = package_location_of(module) == None;
  { module: module, shipped: shipped, tested: shipped && tested }
}

pub fn over_full_names<a | e>(
  tested: Bool,
  body: () -> a / {elsewhere.read, SessionReads, abort.raise | e},
) -> a / {SessionReads, abort.raise | e} =
  handle {
    body()
  } with {
    var cache: Map<Bytes, List<StoredDeclarations>> = Map::new(),
    elsewhere.look_up_type(name) -> {
      let l = declared_by_full_name(tested, cache, name, Some(TypeSpace));
      cache = l.cache;
      first_stored(l.found, |s: StoredDeclarations| s.types.get(name))
    },
    elsewhere.look_up_effect(name) -> {
      let l = declared_by_full_name(tested, cache, name, Some(EffectSpace));
      cache = l.cache;
      first_stored(l.found, |s: StoredDeclarations| s.effects.get(name))
    },
    elsewhere.look_up_constructor(name) -> {
      let l = declared_by_full_name(tested, cache, name, Some(ValueSpace));
      cache = l.cache;
      first_stored(l.found, |s: StoredDeclarations| s.constructors.get(name))
    },
    elsewhere.look_up_definition(name) -> {
      let l = declared_by_full_name(tested, cache, name, Some(ValueSpace));
      cache = l.cache;
      first_stored(l.found, |s: StoredDeclarations| s.definitions.get(name))
    },
    elsewhere.look_up_host(name) -> {
      let l = declared_by_full_name(tested, cache, name, None);
      cache = l.cache;
      first_stored(l.found, |s: StoredDeclarations| s.hosts.get(name))
    },
  }

fn declared_by_full_name(
  tested: Bool,
  cache: Map<Bytes, List<StoredDeclarations>>,
  name: Bytes,
  namespace: Option<Namespace>,
) -> { found: List<StoredDeclarations>, cache: Map<Bytes, List<StoredDeclarations>> } / {SessionReads, abort.raise} = {
  let module = module_of_name(name);
  let key = Bytes::concat_all([
    match namespace {
      None -> b"*",
      Some(TypeSpace) -> b"t",
      Some(EffectSpace) -> b"e",
      Some(_) -> b"v",
    },
    b" ",
    name,
  ]);
  match cache.get(key) {
    Some(found) -> { found: found, cache: cache },
    None -> {
      let found = if module.len() == 0 { [] } else {
        let own = module_key_in(module, tested);
        owners_declaring_in(
          own,
          own.shipped,
          module,
          name.slice(module.len() + 1, name.len()),
          namespace,
        ).map(|at: OwnerKey| stored_declarations_of(at, GroupDeclarations))
      };
      { found: found, cache: cache.insert(key, found) }
    },
  }
}

fn names_in_stored(stored: StoredDeclarations) -> List<Bytes> = stored.definitions.keys()

fn hashed_by_name(qualified: Bytes) -> Bool / {elsewhere.read} =
  match elsewhere.look_up_definition(qualified) {
    Some(f) -> match f.implementation {
      ExternFunction -> true,
      UncheckedBuiltin(_) -> true,
      Checked(_, _) -> false,
    },
    None -> false,
  }

fn name_elsewhere(
  own: Map<Bytes, Bool>,
  mention: Mention,
) -> List<NameElsewhere> / {CheckReads, abort.raise} =
  if own.contains(mention_key(mention)) { [] } else {
    let qualified = qualify(mention.module, mention.name);
    let of_type = match other_modules.look_up_declaration(mention.module, TypeSpace, mention.name) {
      Some(d) ->
        [
          {
            module: mention.module,
            name: mention.name,
            public: d.public,
            held: HeldName(HeldType),
            bare: false,
          },
        ],
      None -> [],
    };
    let of_effect = match other_modules.look_up_declaration(
        mention.module,
        EffectSpace,
        mention.name,
      ) {
      Some(d) ->
        [
          {
            module: mention.module,
            name: mention.name,
            public: d.public,
            held: HeldName(HeldEffect),
            bare: false,
          },
        ],
      None -> [],
    };
    let of_value = match other_modules.look_up_declaration(
        mention.module,
        ValueSpace,
        mention.name,
      ) {
      Some(d) -> match elsewhere.look_up_constructor(qualified) {
        Some(c) -> {
          let simple = c.type_name.slice(mention.module.len() + 1, c.type_name.len());
          [
            {
              module: mention.module,
              name: simple,
              public: true,
              held: HeldName(HeldType),
              bare: false,
            },
            {
              module: mention.module,
              name: mention.name,
              public: d.public,
              held: HeldConstructor(c.type_name),
              bare: false,
            },
          ]
        },
        None -> if hashed_by_name(qualified) { [] } else {
          [
            {
              module: mention.module,
              name: mention.name,
              public: d.public,
              held: HeldName(HeldValue),
              bare: false,
            },
          ]
        },
      },
      None -> [],
    };
    of_type.concat(of_effect).concat(of_value)
  }

fn members_in(
  named: ModuleKey,
  inside: Map<Bytes, Bool>,
  module: Bytes,
  name: Bytes,
) -> List<Mention> / {SessionReads, abort.raise} =
  owners_declaring(named, named.shipped, module, any_module_name(name)).filter(
    |at: OwnerKey| !is_loaded(inside, module, at.owner),
  ).fold([], |found: List<Mention>, at: OwnerKey|
    names_in_stored(stored_declarations_of(at, SignatureDeclarations)).fold(
      found,
      |f: List<Mention>, q: Bytes|
        if q.ends_with(b"::".concat(name)) {
          f.push({ module: module, name: q.slice(module.len() + 1, q.len()) })
        } else { f },
    ))

fn members_named(
  named: ModuleKey,
  inside: Map<Bytes, Bool>,
  name: Bytes,
) -> List<Mention> / {SessionReads, abort.raise} =
  value_call_modules(named, name).fold([], |found: List<Mention>, module: Bytes|
    found.concat(members_in(named, inside, module, name)))

fn no_embed_read(_: EmbedRequest) -> EmbedResult = Ok([])

fn setting_of(named: ModuleKey) -> Setting / {memo.read, abort.raise} =
  fetch_part(setting_part(), named)

pub type GroupRead = { inputs: GroupInputs, body_plan: BodyPlan, mentioned: List<Mention> }

pub type GroupSource = { named: ModuleKey, members: List<OwnerFacts>, imported: List<Imported> }

fn loaded_source(
  g: GroupSource,
  tables: ImportPackages,
) -> LoadedSource / {SessionReads, abort.raise} = {
  let source = source_of_group(g.named.module, g.members.map(|f: OwnerFacts| f.text), g.imported);
  {
    source: source,
    role: if g.named.shipped { Dependency } else { Own },
    tables: tables,
    embed_read: if !may_call_embed(source.source.source_text) { no_embed_read } else {
      let setting = setting_of(g.named);
      embed_read_of(g.named.module, setting.embeds, setting.wanted_texts, setting.data)
    },
  }
}

fn names_loaded(g: GroupSource) -> List<Bytes> =
  g.members.fold([], |found: List<Bytes>, f: OwnerFacts|
    found.concat(
      f.text.names.push(f.text.owner).map(|n: Bytes|
        mention_key({ module: g.named.module, name: n })),
    ))

fn owners_loaded(g: GroupSource) -> List<Bytes> =
  g.members.map(|f: OwnerFacts| mention_key({ module: g.named.module, name: f.text.owner }))

fn mentions_read(
  named: ModuleKey,
  inside: Map<Bytes, Bool>,
  mentions: List<Mention>,
) -> List<Mention> / {SessionReads, abort.raise} =
  mentions.fold([], |found: List<Mention>, m: Mention|
    if m.module.len() == 0 { found.concat(members_named(named, inside, m.name)) }
    else if m.name.starts_with(any_module_name(b"")) {
      found.concat(members_in(named, inside, m.module, m.name.slice(2, m.name.len())))
    } else { found.push(m) })

fn effects_of_set(m: Mention) -> List<Mention> / {CheckReads, abort.raise} =
  match other_modules.look_up_effect_set(m.module, m.name) {
    None -> [],
    Some(set) ->
      set.expansion.map(|e: EffectExpression|
        {
          module: match e.effect_name.module {
            Some(b) -> match implicit_target(b.name) { Some(t) -> t, None -> m.module },
            None -> m.module,
          },
          name: e.effect_name.name.name,
        }),
  }

pub fn with_group_read<a | e>(
  groups: List<GroupSource>,
  declared_from: keep (Bytes) -> DeclarationSource,
  body_supplier: BodySupplier,
  also: List<Mention>,
  body: (GroupRead) -> a / {CheckReads, SessionReads, abort.raise | e},
) -> a / {SessionReads, abort.raise | e} = {
  let first = groups.get(0);
  let named = first.named;
  let tables = import_packages(named);
  let loaded = groups.map(|g: GroupSource| loaded_source(g, import_packages(g.named)));
  let own = groups.flat_map(names_loaded).fold(Map::new(), |found: Map<Bytes, Bool>, n: Bytes|
    found.insert(n, true));
  let inside = groups.flat_map(owners_loaded).fold(
    Map::new(),
    |found: Map<Bytes, Bool>, n: Bytes| found.insert(n, true),
  );
  let body_plan = match body_supplier(loaded.get(0).source) {
    Some(at) -> at(0),
    None -> CheckEvery,
  };
  over_stored(
    stored_reads(named, named.shipped && also.len() == 0, tables, inside, declared_from),
    || {
      let mentions = range(0, groups.len()).fold([], |found: List<Mention>, i: Int|
        found.concat(
          mentions_read(
            groups.get(i).named,
            inside,
            mentions_of(groups.get(i).members).concat(if i == 0 { also } else { [] }),
          ),
        ));
      let in_defaults = mentions.fold([], |found: List<Mention>, m: Mention|
        match other_modules.look_up_parameters(qualify(m.module, m.name)) {
          Some(p) -> found.concat(names_in_defaults(p)),
          None -> found,
        });
      let in_sets = mentions.filter(|m: Mention| !own.contains(mention_key(m))).flat_map(
        effects_of_set,
      );
      let seen = mentions.concat(in_defaults).concat(in_sets).fold(
        Map::new(),
        |found: Map<Bytes, Mention>, m: Mention| found.insert(qualify(m.module, m.name), m),
      );
      let names_elsewhere = seen.values().fold([], |found: List<NameElsewhere>, m: Mention|
        found.concat(name_elsewhere(own, m)));
      let unique = names_elsewhere.fold(
        Map::new(),
        |found: Map<Bytes, NameElsewhere>, n: NameElsewhere| {
          let key = Bytes::concat_all([
            qualify(n.module, n.name),
            match n.held {
              HeldName(HeldEffect) -> b"#e",
              HeldName(HeldType) -> b"#t",
              HeldName(HeldValue) -> b"#v",
              HeldConstructor(_) -> b"#v",
            },
          ]);
          found.insert(key, match found.get(key) {
            Some(first) -> { ..n, public: n.public && first.public },
            None -> n,
          })
        },
      );
      body({
        inputs: { loaded: loaded, elsewhere: unique.values() },
        body_plan: body_plan,
        mentioned: seen.values().filter(|m: Mention| !own.contains(mention_key(m))),
      })
    },
  )
}

pub fn with_performed_effects(mentioned: List<Mention>) -> List<Mention> / {CheckReads} = {
  let named = mentioned.fold(Map::new(), |found: Map<Bytes, Mention>, m: Mention|
    found.insert(qualify(m.module, m.name), m));
  mentioned.fold(named, |found: Map<Bytes, Mention>, m: Mention|
    match elsewhere.look_up_definition(qualify(m.module, m.name)) {
      None -> found,
      Some(facts) -> match facts.scheme.ty {
        FunctionType(f) ->
          f.effects.listed.fold(found, |all: Map<Bytes, Mention>, e: Effect|
            if all.contains(e.effect) { all } else {
              match elsewhere.look_up_effect(e.effect) {
                Some(info) -> all.insert(e.effect, { module: info.module, name: info.simple_name }),
                None -> all,
              }
            }),
        _ -> found,
      },
    }).values(
  )
}

pub fn group_checked(
  named: ModuleKey,
  members: List<OwnerFacts>,
  imported: List<Imported>,
  declared_from: keep (Bytes) -> DeclarationSource,
  body_supplier: BodySupplier,
  also: List<Mention> = [],
) -> UnitCheck / {QueryEffects, abort.raise} =
  with_group_read(
    [{ named: named, members: members, imported: imported }],
    declared_from,
    body_supplier,
    also,
    |read: GroupRead|
      {
        texts: members.map(|f: OwnerFacts| f.text),
        source: read.inputs.loaded.get(0).source,
        out: checked_group(read.inputs, read.body_plan),
      },
  )

fn checked_group_result(module: Bytes, c: UnitCheck) -> owner_checks::GroupResult / {abort.raise} =
  owner_checks::group_result(c.out, module, c.texts, c.source.items, |x: ItemAt|
    c.source.offset + x.from)

pub fn imports_of(key: GroupKey) -> List<Imported> / {memo.read, abort.raise} =
  fetch(group_imports_query(), key)

fn inferences_of(
  named: ModuleKey,
  members: List<OwnerFacts>,
) -> List<owner_checks::OwnerInference> / {memo.read, abort.raise} =
  members.map(|f: OwnerFacts|
    {
      owner: f.text.owner,
      typed: inference_of(named, f.text.owner),
      layout: item_layout([f.text]),
    })

fn called_in(
  key: GroupKey,
  walked: List<owner_checks::OwnerInference>,
) -> List<Bytes> / {memo.read, abort.raise} =
  walked.fold([], |accumulator: List<Bytes>, w: owner_checks::OwnerInference|
    called_owners(w.owner, owner_checks::called_names(key.module, w.typed), |n: Bytes|
      declared_of(key.module, key.shipped, key.tested, n)).fold(
      accumulator,
      |a: List<Bytes>, c: Bytes|
        if key.owners.contains(c) || a.contains(c) { a } else { a.push(c) },
    ))

fn source_for_called(called: List<Bytes>) -> (Bytes) -> DeclarationSource =
  |o: Bytes| if called.contains(o) { GroupDeclarations } else { SignatureDeclarations }

type CheckedGroup = { result: owner_checks::GroupResult, lowering: Option<GroupLowering> }

fn lowering_of(c: UnitCheck) -> Option<GroupLowering> / {abort.raise} =
  match c.out.checked { Some(w) -> Some(group_lowering(w)), None -> None }

fn finalize_group(
  named: ModuleKey,
  key: GroupKey,
  members: List<OwnerFacts>,
) -> CheckedGroup / {QueryEffects, abort.raise} = {
  let walked = inferences_of(named, members);
  let declared_from = source_for_called(called_in(key, walked));
  if walked.fold(false, |found: Bool, w: owner_checks::OwnerInference|
      found || owner_checks::inference_rejected(w.typed)) {
    let c = with_group_read(
      [{ named: named, members: members, imported: imports_of(key) }],
      declared_from,
      no_bodies,
      [],
      |read: GroupRead| {
        let source = read.inputs.loaded.get(0).source;
        {
          texts: members.map(|f: OwnerFacts| f.text),
          source: source,
          out: rejected_group(
            read.inputs,
            owner_checks::inference_errors(walked, source.items, source.offset),
            signature_declarations(key),
          ),
        }
      },
    );
    { result: checked_group_result(key.module, c), lowering: None }
  } else {
    let c = group_checked(named, members, imports_of(key), declared_from, |source: OwnerSource|
      Some(owner_checks::supplied_bodies(walked, source.items, source.offset)));
    {
      result: owner_checks::finalized_result(
        checked_group_result(key.module, c),
        walked,
        c.source.items,
      ),
      lowering: lowering_of(c),
    }
  }
}

fn signature_declarations(key: GroupKey) -> StoredDeclarations / {memo.read, abort.raise} =
  key.owners.fold(no_stored_declarations, |found: StoredDeclarations, o: Bytes|
    declarations_joined(
      found,
      signature_declared({
        module: key.module,
        shipped: key.shipped,
        tested: key.tested,
        owner: o,
      }),
    ))

type GroupProgram = { source: GroupSource, declared_from: (Bytes) -> DeclarationSource }

pub fn resolved_group_of(
  key: GroupKey,
) -> Result<ResolvedGroup, List<Diagnostic>> / {QueryEffects, abort.raise} = {
  let g = group_program_of(key);
  with_group_read([g.source], g.declared_from, no_bodies, [], |read: GroupRead|
    resolved_group(read.inputs))
}

fn group_program_of(key: GroupKey) -> GroupProgram / {QueryEffects, abort.raise} = {
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  let members = key.owners.map(|o: Bytes| owner_facts(named, o));
  let cycle = match key.owners {
    [] -> false,
    [o, ..] ->
      unit_key_of({
          module: key.module,
          shipped: key.shipped,
          tested: key.tested,
          owner: o,
        }).owners.len(
        )
        >= 2,
  };
  {
    source: { named: named, members: members, imported: imports_of(key) },
    declared_from: if !cycle { from_groups }
    else { source_for_called(called_in(key, inferences_of(named, members))) },
  }
}

fn inference_of(
  named: ModuleKey,
  owner: Bytes,
) -> owner_checks::InferenceResult / {memo.read, abort.raise} =
  fetch(typed_query(), owner_key_at(named, owner))

pub fn check_signatures(key: GroupKey) -> Written / {QueryEffects, abort.raise} =
  written(signatures_query(), if !is_signature_unit(key) { owner_checks::no_signature_check } else {
    let named = { module: key.module, shipped: key.shipped, tested: key.tested };
    let members = key.owners.map(|o: Bytes| shape_of(named, o));
    let imported = fetch(signature_imports_query(), key);
    owner_checks::signature_check_of(
      checked_group_result(
        key.module,
        group_checked(named, members, imported, from_signatures, inferring_only([])),
      ),
    )
  })

fn is_signature_unit(g: GroupKey) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      signature_unit_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

fn signature_unit_of(o: OwnerKey) -> GroupKey / {memo.read, abort.raise} =
  {
    module: o.module,
    shipped: o.shipped,
    tested: o.tested,
    owners: fetch_keyed_part(signature_unit_part(), module_key_of(o), o.owner).unwrap_or([]),
  }

fn shape_of(named: ModuleKey, owner: Bytes) -> OwnerFacts / {memo.read, abort.raise} =
  match fetch_keyed_part(shape_part(), named, owner) {
    Some(f) -> f,
    None ->
      panic(
        "the module `" ++ String::of_bytes_lossy(named.module) ++ "` holds no signature of `"
          ++ String::of_bytes_lossy(owner)
          ++ "`",
      ),
  }

pub fn infer_owner_types(key: OwnerKey) -> Written / {QueryEffects, abort.raise} = {
  let named = module_key_of(key);
  let g = unit_key_of(key);
  written(typed_query(), if g.owners.len() < 2 { owner_checks::no_inference_result } else {
    let facts = owner_facts(named, key.owner);
    let imported = fetch(owner_imports_query(), key);
    let c = group_checked(
      named,
      [facts],
      imported,
      from_signatures,
      inferring_only(facts.text.names.map(|n: Bytes| qualify(key.module, n))),
    );
    owner_checks::inference_result(c.out, key.module, facts.text, c.source.items, |x: ItemAt|
      c.source.offset + x.from)
  })
}

pub fn current(g: GroupKey) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      group_key_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

pub fn group_key_of(o: OwnerKey) -> GroupKey / {memo.read, abort.raise} = {
  let unit = unit_key_of(o);
  if unit.owners.len() < 2 { unit } else { { ..unit, owners: fetch(group_of_query(), o) } }
}

pub fn current_unit(g: GroupKey) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      unit_key_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

pub fn unit_key_of(o: OwnerKey) -> GroupKey / {memo.read, abort.raise} =
  {
    module: o.module,
    shipped: o.shipped,
    tested: o.tested,
    owners: fetch_keyed_part(unit_part(), module_key_of(o), o.owner).unwrap_or([]),
  }

fn types_named_in(f: TypeFacts) -> List<Bytes> =
  f.constructors.flat_map(|c: ConstructorInfo| c.fields.flat_map(type_names)).concat(
    match f.alias { Some(a) -> type_names(a.t), None -> [] },
  ).concat(match f.record { Some(r) -> type_names(r.ty), None -> [] })

fn with_type(
  known: KnownConstructors,
  name: Bytes,
  f: TypeFacts,
) -> KnownConstructors / {CheckReads} =
  {
    constructors: known.constructors.concat(f.constructors),
    instances: known.instances.concat(f.instances),
    numeric: match f.numeric { Some(x) -> known.numeric.push(x), None -> known.numeric },
    opaque: if f.declaration.opaque == None { known.opaque } else { known.opaque.insert(name, f) },
    released: match f.release_function {
      Some(by) -> match elsewhere.look_up_definition(by) {
        Some(d) -> known.released.push({ name: by, scheme: d.scheme }),
        None -> known.released,
      },
      None -> known.released,
    },
  }

const no_known: KnownConstructors =
  { constructors: [], instances: [], numeric: [], released: [], opaque: Map::new() }

pub fn known_of_types(names: List<Bytes>) -> KnownConstructors / {CheckReads, abort.raise} =
  traverse(names, |name: Bytes| {
    let facts = elsewhere.look_up_type(name);
    { value: facts, next: match facts { Some(f) -> types_named_in(f), None -> [] } }
  }).fold(no_known, |known: KnownConstructors, v: Visit<Bytes, Option<TypeFacts>>|
    match v.value { Some(f) -> with_type(known, v.key, f), None -> known })

pub fn stored_rows(g: GroupKey) -> Rows / {memo.read, abort.raise} =
  if g.owners.len() == 0 { no_rows } else {
    member_rows(g).fold(no_rows, |rows: Rows, r: Rows|
      {
        definitions: rows.definitions.concat(r.definitions),
        tests: rows.tests.concat(r.tests),
        laws: rows.laws.concat(r.laws),
        types: types_joined(rows.types, r.types),
      })
  }

pub fn stored_lowering(g: GroupKey) -> Option<GroupLowering> / {memo.read, abort.raise} =
  if g.owners.len() == 0 { Some(no_group_lowering) } else { fetch_part(lowering_part(), g) }

fn member_rows(g: GroupKey) -> List<Rows> / {memo.read, abort.raise} =
  fetch_part(rows_part(), g).map(decode_rows)

pub fn group_of(g: GroupKey) -> owner_checks::GroupResult / {memo.read, abort.raise} =
  owner_checks::joined_group(
    group_listing_of(g),
    group_facts_of(g),
    group_forms_of(g).forms,
    member_rows(g),
  )

pub fn group_facts_of(g: GroupKey) -> owner_checks::GroupResult / {memo.read, abort.raise} =
  owner_checks::decode_group(fetch(group_query(), g))

fn entries_named<a>(entries: Map<Bytes, a>, names: Map<Bytes, Bool>) -> Map<Bytes, a> =
  entries.fold(Map::new(), |found: Map<Bytes, a>, name: Bytes, value: a|
    if names.contains(name) { found.insert(name, value) } else { found })

fn declared_by(
  stored: StoredDeclarations,
  module: Bytes,
  names: List<Bytes>,
) -> StoredDeclarations = {
  let mine = names.fold(Map::new(), |found: Map<Bytes, Bool>, n: Bytes|
    found.insert(qualify(module, n), true));
  {
    types: entries_named(stored.types, mine),
    effects: entries_named(stored.effects, mine),
    constructors: entries_named(stored.constructors, mine),
    definitions: entries_named(stored.definitions, mine),
    sets: entries_named(stored.sets, mine),
    schemas: entries_named(stored.schemas, mine),
    hosts: entries_named(stored.hosts, mine),
    parameters: entries_named(stored.parameters, mine),
  }
}

fn with_module_opaque(
  named: ModuleKey,
  stored: StoredDeclarations,
) -> StoredDeclarations / {SessionReads, abort.raise} =
  {
    ..stored,
    types: stored.types.fold(
      Map::new(),
      |found: Map<Bytes, TypeFacts>, name: Bytes, facts: TypeFacts|
        found.insert(name, match facts.declaration.opaque {
          None -> facts,
          Some(written) -> match declared_names_of(
              named,
              named.shipped,
              named.module,
              name.slice(named.module.len() + 1, name.len()),
            ).of_type {
            Some(d) -> match d.closed_by {
              Some(c) ->
                {
                  ..facts,
                  declaration: {
                    ..facts.declaration,
                    opaque: Some({ ..written, result: c.opaque.result, take: c.opaque.take }),
                  },
                },
              None -> facts,
            },
            None -> facts,
          },
        }),
    ),
  }

fn signature_declared(key: OwnerKey) -> StoredDeclarations / {memo.read, abort.raise} =
  signature_check_of(signature_unit_of(key)).declared

pub fn collect_signature_declarations(key: OwnerKey) -> Written / {QueryEffects, abort.raise} = {
  let text = owner_facts(module_key_of(key), key.owner).text;
  written(
    signature_declarations_query(),
    with_module_opaque(
      module_key_of(key),
      declared_by(signature_declared(key), key.module, text.names.push(key.owner)),
    ),
  )
}

pub fn find_name_declaration(key: InterfaceKey) -> Written / {QueryEffects, abort.raise} =
  written(
    name_declaration_query(),
    names_declared_in(
      declarations_once({ module: key.module, shipped: key.shipped, tested: key.full_text }),
      key.name,
    ),
  )

fn names_declared_in(d: Declarations, name: Bytes) -> NameDeclarations =
  {
    value: lookup_declared(d, ValueSpace, name),
    of_type: lookup_declared(d, TypeSpace, name),
    of_effect: lookup_declared(d, EffectSpace, name),
    of_set: lookup_declared(d, SetSpace, name),
  }

pub fn group_keys(named: ModuleKey) -> List<GroupKey> / {memo.read, abort.raise} =
  fetch_part(groups_part(), named).map(|g: List<Bytes>|
    { module: named.module, shipped: named.shipped, tested: named.tested, owners: g })

pub fn module_groups(named: ModuleKey) -> List<GroupKey> / {memo.read, abort.raise} =
  group_keys(named).fold([], |accumulator: List<GroupKey>, unit: GroupKey|
    accumulator.concat(
      (if unit.owners.len() < 2 { [unit.owners] } else { cycles_of(unit) }).map(
        |owners: List<Bytes>| { ..unit, owners: owners },
      ),
    ))

pub fn layout_of(named: ModuleKey) -> ModuleLayout / {memo.read, abort.raise} =
  fetch_part(layout_part(), named)

pub fn placed_facts(
  named: ModuleKey,
  layout: ModuleLayout,
) -> Map<Bytes, OwnerFacts> / {memo.read, abort.raise} =
  layout.owners.fold(Map::new(), |accumulator: Map<Bytes, OwnerFacts>, o: OwnerPlace| {
    let f = owner_facts(named, o.owner);
    accumulator.insert(o.owner, { ..f, text: { ..f.text, starts: o.starts } })
  })

fn assembled_groups<| e>(
  named: ModuleKey,
  read: OwnersResult,
  layout: ModuleLayout,
  result_of: (GroupKey) -> owner_checks::GroupResult / {memo.read, abort.raise | e},
) -> owner_checks::AssembledModule / {memo.read, abort.raise | e} = {
  let facts = placed_facts(named, layout);
  owner_checks::assembled(
    named.module,
    { ..read.shape, outline: layout.outline },
    read.order,
    read.recorded,
    module_groups(named).map(|g: GroupKey|
      {
        items: item_layout(
          g.owners.map(|o: Bytes|
            match facts.get(o) {
              Some(f) -> f.text,
              None ->
                panic("a declaration in a checked group is missing from the module's declarations"),
            }),
        ),
        result: result_of(g),
      }).concat(
      read.signing.filter(|u: List<Bytes>| u.len() > 0).map(|u: List<Bytes>|
        {
          items: item_layout(
            u.map(|o: Bytes|
              match facts.get(o) {
                Some(f) -> f.text,
                None ->
                  panic(
                    "a declaration whose signature is checked is missing from the module's declarations",
                  ),
              }),
          ),
          result: {
            ..owner_checks::no_group,
            rejected: signature_check_of({
              module: named.module,
              shipped: named.shipped,
              tested: named.tested,
              owners: u,
            }).rejected,
          },
        }),
    ),
    reports_unused(fetch_part(setting_part(), named)),
  )
}

fn signature_check_of(unit: GroupKey) -> owner_checks::SignatureCheck / {memo.read, abort.raise} =
  fetch(signatures_query(), unit)

fn reports_unused(setting: Setting) -> Bool =
  setting.origin == InRoot || (setting.origin == ShippedModule && setting.tested)

fn imports_present(named: ModuleKey) -> List<Bytes> / {memo.read, abort.raise} =
  fetch_part(context_part(), named).present

pub fn checked_module(named: ModuleKey) -> ModuleResult / {memo.read, abort.raise} = {
  let read = owners_result_of(named);
  if !read.found { absent(named.module) } else {
    let a = assembled_groups(named, read, layout_of(named), group_of);
    let header = module_header(named).problems;
    let rejected = header.concat(read.problems).concat(a.rejected);
    if rejected.len() > 0 {
      { ..rejected_for(named.module, read, imports_present(named), rejected), warnings: a.warnings }
    } else {
      {
        imports: imports_present(named),
        rejected: [],
        warnings: a.warnings,
        definitions: a.definitions,
        tests: a.tests,
        rows: encode_rows(a.rows),
        shape: a.facts.shape,
        tables: encode_tables(a.facts.tables),
      }
    }
  }
}

fn group_summary_of(g: GroupKey) -> owner_checks::GroupFlags / {memo.read, abort.raise} =
  fetch_part(summary_part(), g)

pub fn checked_law_outline(
  named: ModuleKey,
  written: LawOutline,
) -> LawOutline / {memo.read, abort.raise} = {
  let owner = {
    module: named.module,
    shipped: named.shipped,
    tested: named.tested,
    owner: b"law ".concat(written.name),
  };
  group_listing_of(group_key_of(owner)).members.flat_map(owner_checks::member_laws).find(
    |l: LawOutline| l.name == written.name,
  ).unwrap_or(
    written,
  )
}

fn group_listing_of(g: GroupKey) -> owner_checks::GroupResult / {memo.read, abort.raise} =
  owner_checks::decode_group(fetch_part(listing_part(), g))

pub type ModuleListing = {
  shape: ModuleShape,
  tables: Bytes,
  warnings: List<Diagnostic>,
  imports: List<Bytes>,
  definitions: Int,
  tests: Int,
}

derive bin for ModuleListing

pub fn module_listing_query() -> QueryOf<ModuleKey, ModuleListing> =
  { name: b"module listing", input: module_key_bin(), output: module_listing_bin() }

pub fn module_contents_query() -> QueryOf<ModuleKey, Unit> =
  { name: b"module contents", input: module_key_bin(), output: bin::unit_bin() }

pub fn tests_part() -> PartOf<ModuleKey, Unit, List<TestInfo>> =
  { query: module_contents_query(), name: b"tests", output: bin::list_bin(test_info_bin()) }

pub fn declared_effects_part() -> PartOf<ModuleKey, Unit, List<DeclaredEffect>> =
  {
    query: module_contents_query(),
    name: b"declared",
    output: bin::list_bin(declared_effect_bin()),
  }

pub fn code_part() -> PartOf<ModuleKey, Unit, ModuleCode> =
  { query: module_contents_query(), name: b"code", output: module_code_bin() }

pub fn imports_part() -> PartOf<ModuleKey, Unit, List<Bytes>> =
  { query: module_contents_query(), name: b"imports", output: bin::list_bin(bin::bytes_bin()) }

pub fn sites_part() -> PartOf<ModuleKey, Unit, ModuleSites> =
  { query: module_contents_query(), name: b"sites", output: module_sites_bin() }

pub fn collect_module_contents(named: ModuleKey) -> Written / {memo.read, abort.raise} = {
  let listing = fetch(module_listing_query(), named);
  let hosted = effect_hosts([listing.shape.outline]).len() > 0;
  let tables = if !hosted { listing.tables } else { checked_module(named).tables };
  let contents = module_contents(listing.shape, decode_tables(tables));
  with_part(
    with_part(
      with_part(
        with_part(
          with_part(written(module_contents_query(), ()), tests_part(), contents.tests),
          declared_effects_part(),
          contents.declared,
        ),
        code_part(),
        contents.code,
      ),
      imports_part(),
      contents.imports,
    ),
    sites_part(),
    contents.sites,
  )
}

pub fn list_module(named: ModuleKey) -> Written / {memo.read, abort.raise} = {
  let read = owners_result_of(named);
  let a = assembled_groups(named, read, layout_of(named), group_listing_of);
  written(module_listing_query(), {
    shape: a.facts.shape,
    tables: encode_tables(a.facts.tables),
    warnings: a.warnings,
    imports: imports_present(named),
    definitions: a.definitions,
    tests: a.tests,
  })
}

fn rejected_for(
  module: Bytes,
  read: OwnersResult,
  present: List<Bytes>,
  rejected: List<Diagnostic>,
) -> ModuleResult / {abort.raise} =
  {
    ..absent(module),
    rejected: rejected,
    imports: present,
    shape: { ..no_shape(module), written: read.shape.written },
  }

pub fn header_text_query() -> QueryOf<ModuleKey, Option<Bytes>> =
  { name: b"header text", input: module_key_bin(), output: bin::option_bin(bin::bytes_bin()) }

pub fn header_query() -> QueryOf<ModuleKey, ModuleHeader> =
  { name: b"header", input: module_key_bin(), output: module_header_bin() }

pub fn cut_header_text(key: ModuleKey) -> Written / {QueryEffects, abort.raise} =
  written(header_text_query(), match text_of(key) {
    None -> None,
    Some(text) -> match header_read({ name: key.module, source_text: text }) {
      None -> None,
      Some(m) -> {
        let explicit = m.imports.filter(is_explicit_import);
        if explicit.len() == 0 { None }
        else { Some(text.slice(0, max_of(explicit.map(|d: ImportDeclaration| d.span.end)))) }
      },
    },
  })

fn header_read(source: Source) -> Option<Module> / {decode_cache.read, abort.raise} =
  match decode_cache.text_read(text_key(source)) {
    Some(r) -> header_of(r.lexed.input, r.lexed.parser),
    None -> header(source.source_text),
  }

fn max_of(xs: List<Int>) -> Int = xs.fold(0, |m: Int, x: Int| if x > m { x } else { m })

pub fn check_imports_header(key: ModuleKey) -> Written / {QueryEffects, abort.raise} =
  written(
    header_query(),
    match match fetch(header_text_query(), key) { Some(prefix) -> header(prefix), None -> None } {
      None -> empty_header(key.module),
      Some(imports) -> {
        let tables = import_packages(key);
        over_stored(stored_reads(key, key.shipped, tables, Map::new(), from_groups), ||
          import_problems({ name: key.module, module: imports, derived: [] }, tables))
      },
    },
  )

fn module_header(named: ModuleKey) -> ModuleHeader / {memo.read, abort.raise} =
  fetch(header_query(), named)

pub fn hash_group(key: GroupKey) -> Written / {memo.read, abort.raise} =
  written(group_hash_query(), if !current_unit(key) { no_own_hashes }
  else { own_hashes(group_hash_inputs(key)) })

fn unit_forms(key: GroupKey) -> List<GroupForms> / {memo.read, abort.raise} =
  (if key.owners.len() < 2 { [key.owners] } else { cycles_of(key) }).map(|g: List<Bytes>|
    group_forms_of({ ..key, owners: g }))

pub fn group_hash_inputs(key: GroupKey) -> HashInput / {memo.read, abort.raise} =
  match unit_forms(key) {
    [one] -> one.forms,
    parts -> joined_forms(parts.map(|p: GroupForms| p.forms)),
  }

pub type GroupForms = { forms: HashInput, functions: Map<Bytes, Bytes> }

derive bin for GroupForms

fn group_forms_of(g: GroupKey) -> GroupForms / {memo.read, abort.raise} =
  fetch_part(forms_part(), g)

fn formed(reads: List<OwnerText>, forms: HashInput) -> GroupForms =
  {
    forms: forms,
    functions: reads.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, r: OwnerText|
      r.names.fold(accumulator, |m: Map<Bytes, Bytes>, n: Bytes| m.insert(n, r.owner))),
  }

pub fn group_hashes_of(g: GroupKey) -> OwnHashes / {memo.read, abort.raise} =
  fetch(group_hash_query(), g)

fn owned_by(
  module: Bytes,
  owner: Bytes,
  functions: Map<Bytes, Bytes>,
  all: OwnHashes,
) -> OwnHashes / {abort.raise} = {
  let item = |kind: Bytes, key: Bytes|
    owner.starts_with(kind) && key == qualify(module, owner.slice(kind.len(), owner.len()));
  {
    definitions: all.definitions.filter(|d: DefinitionHash| {
      let simple = simple_of(d.name, module);
      if d.kind == HeldValue { functions.get(simple) == Some(owner) } else { simple == owner }
    }),
    tests: all.tests.filter(|t: TestHash| item(b"test ", t.key)),
    laws: all.laws.filter(|l: LawHash| item(b"law ", l.key)),
  }
}

pub fn hash_owner(key: OwnerKey) -> Written / {memo.read, abort.raise} = {
  let unit = unit_key_of(key);
  written(
    owner_hash_query(),
    owned_by(
      key.module,
      key.owner,
      unit_forms(unit).fold(Map::new(), |found: Map<Bytes, Bytes>, p: GroupForms|
        p.functions.fold(found, |m: Map<Bytes, Bytes>, n: Bytes, o: Bytes| m.insert(n, o))),
      group_hashes_of(unit),
    ),
  )
}

pub fn module_own_hashes(named: ModuleKey) -> OwnHashes / {memo.read, abort.raise} =
  joined_own_hashes(group_keys(named).map(group_hashes_of))

pub fn module_record_query() -> QueryOf<ModuleKey, Bytes> =
  { name: b"module record", input: module_key_bin(), output: bin::bytes_bin() }

pub fn record_module_hashes(named: ModuleKey) -> Written / {memo.read, abort.raise} =
  written(module_record_query(), record_digest(module_record(module_own_hashes(named))))

pub fn documented_query() -> QueryOf<ModuleKey, Pages> =
  { name: b"documented", input: module_key_bin(), output: pages_bin() }

fn laws_referencing(lawful: ModuleKey) -> Map<Bytes, List<Bytes>> / {memo.read, abort.raise} = {
  let groups = fetch_part(groups_part(), lawful);
  module_owners(lawful).fold(Map::new(), |accumulator: Map<Bytes, List<Bytes>>, o: Bytes|
    if !o.starts_with(b"law ") { accumulator } else {
      let law = o.slice(4, o.len());
      let hashed = group_hashes_of({
        module: lawful.module,
        shipped: lawful.shipped,
        tested: lawful.tested,
        owners: group_containing(groups, o),
      });
      hashed.laws.fold(accumulator, |by: Map<Bytes, List<Bytes>>, l: LawHash|
        l.uses.fold(by, |a: Map<Bytes, List<Bytes>>, r: NodeRef| {
          let recorded_laws = match a.get(r.name) { Some(laws) -> laws, None -> [] };
          if r.kind != HeldValue || recorded_laws.contains(law) { a }
          else { a.insert(r.name, recorded_laws.push(law)) }
        }))
    })
}

pub fn document_module(key: ModuleKey) -> Written / {QueryEffects, abort.raise} =
  written(documented_query(), match module_read({ ..key, tested: true }) {
    None -> { pages: [] },
    Some(m) -> {
      let listing = fetch(module_listing_query(), key);
      module_pages(m.parsed, m.source.source_text, {
        definitions: decode_tables(listing.tables).definitions,
        hashes: module_own_hashes(key).definitions.fold(
          Map::new(),
          |accumulator: Map<Bytes, Bytes>, f: DefinitionHash|
            if f.kind == HeldValue { accumulator.insert(f.name, f.hash) } else { accumulator },
        ),
        laws_by_definition: if m.raw.items.fold(false, |b: Bool, item: Item|
            b || (match item { LawItem(_) -> true, _ -> false })) {
          laws_referencing({ ..key, tested: key.tested || key.shipped })
        } else { Map::new() },
      })
    },
  })

pub type ModuleSummary = {
  rejected: Bool,
  warned: Bool,
  functions: Int,
  tests: Int,
  written: List<Bytes>,
  checked_later: Bool,
  promises: Bool,
  measures: Bool,
}

pub type ProgramSummary = {
  cycle: Bool,
  rejected: List<Bytes>,
  warned: List<Bytes>,
  pulled: List<Bytes>,
  modules: Int,
  definitions: Int,
  tests: Int,
  checked_later: Bool,
  promises: Bool,
  measures: Bool,
}

derive bin for ModuleSummary

derive bin for ProgramSummary

pub fn module_summary_query() -> QueryOf<ModuleKey, ModuleSummary> =
  { name: b"module summary", input: module_key_bin(), output: module_summary_bin() }

pub fn program_summary_query() -> QueryOf<List<Bytes>, ProgramSummary> =
  {
    name: b"program summary",
    input: bin::list_bin(bin::bytes_bin()),
    output: program_summary_bin(),
  }

fn states_promise(item: OutlineItem) -> Bool =
  match item { OutlinedFunction(f) -> f.reuse || f.returns, _ -> false }

fn states_measure(item: OutlineItem) -> Bool =
  match item { OutlinedFunction(f) -> f.measured, _ -> false }

pub fn summarize_module(named: ModuleKey) -> Written / {QueryEffects, abort.raise} = {
  let read = owners_result_of(named);
  let summaries = module_groups(named).map(group_summary_of);
  let header = module_header(named).problems;
  let items = read.shape.outline.items;
  written(module_summary_query(), {
    rejected: read.problems.len() > 0 || header.len() > 0
      || summaries.any(|g: owner_checks::GroupFlags| g.rejected),
    warned: summaries.any(|g: owner_checks::GroupFlags| g.warned)
      || (reports_unused(fetch_part(setting_part(), named))
      && any_unreached(
        summaries.fold([], |accumulator: List<UseLink>, g: owner_checks::GroupFlags|
          accumulator.concat(g.uses)),
      )),
    functions: items.fold(0, |n: Int, item: OutlineItem|
      match item { OutlinedFunction(_) -> n + 1, _ -> n }),
    tests: items.fold(0, |n: Int, item: OutlineItem|
      match item { OutlinedTest(_) -> n + 1, _ -> n }),
    written: read.shape.written,
    checked_later: summaries.any(|g: owner_checks::GroupFlags| g.later)
      || items.any(|i: OutlineItem| states_promise(i) || states_measure(i)),
    promises: items.any(states_promise),
    measures: items.any(states_measure),
  })
}

pub fn module_rejected(named: ModuleKey) -> Bool / {memo.read, abort.raise} =
  summary_of(named).rejected

pub fn listed_result(named: ModuleKey) -> ModuleResult / {memo.read, abort.raise} = {
  let l = fetch(module_listing_query(), named);
  {
    ..absent(named.module),
    imports: l.imports,
    warnings: l.warnings,
    definitions: l.definitions,
    tests: l.tests,
    shape: l.shape,
    tables: l.tables,
  }
}

pub fn summary_of(named: ModuleKey) -> ModuleSummary / {memo.read, abort.raise} =
  fetch(module_summary_query(), named)

fn imports_of_module(named: ModuleKey) -> List<ImportOf> / {memo.read, abort.raise} =
  fetch(imports_query(), named).imports

fn has_import_cycle(own: List<Bytes>) -> Bool / {memo.read, abort.raise} = {
  let edges = own.fold(Map::new(), |found: Map<Bytes, List<Bytes>>, m: Bytes|
    found.insert(
      m,
      imports_of_module({ module: m, shipped: false, tested: false }).filter(|i: ImportOf|
        !i.named.shipped).map(|i: ImportOf| i.named.module),
    ));
  iterate(own, own.len() + 2, |left: List<Bytes>| {
    let waiting = left.fold(Map::new(), |found: Map<Bytes, Bool>, m: Bytes| found.insert(m, true));
    let blocked = left.filter(|m: Bytes|
      List::any(match edges.get(m) { Some(es) -> es, None -> [] }, |d: Bytes| waiting.contains(d)));
    if blocked.len() == 0 { Stop(false) }
    else if blocked.len() == left.len() { Stop(true) }
    else { Continue(blocked) }
  })
}

pub fn summarize_program(own: List<Bytes>) -> Written / {memo.read, abort.raise} = {
  let nothing = {
    cycle: true,
    rejected: [],
    warned: [],
    pulled: [],
    modules: 0,
    definitions: 0,
    tests: 0,
    checked_later: false,
    promises: false,
    measures: false,
  };
  written(program_summary_query(), if has_import_cycle(own) { nothing } else {
    let mine = own.map(|m: Bytes| summary_of({ module: m, shipped: false, tested: false }));
    let flagged = |pick: (ModuleSummary) -> Bool|
      range(0, own.len()).filter(|i: Int| pick(mine.get(i))).map(|i: Int| own.get(i));
    let listed = shipped_names_listed().fold(Set::empty(), |found: Set<Bytes>, n: Bytes|
      found.insert(n));
    let written_imports = range(0, own.len()).fold(
      Map::new(),
      |found: Map<Bytes, List<Bytes>>, i: Int| found.insert(own.get(i), mine.get(i).written),
    );
    let pulled = iterate(
      { written: written_imports, read: own, pulled: [], functions: 0, rejected: [] },
      listed.size() + 2,
      |x: { written: Map<Bytes, List<Bytes>>, read: List<Bytes>, pulled: List<Bytes>, functions: Int, rejected: List<Bytes> }| {
        let fresh = pulled_next(x.read, x.written, listed, []);
        if fresh.len() == 0 { Stop(x) } else {
          Continue(
            fresh.fold(
              { ..x, read: x.read.concat(fresh), pulled: x.pulled.concat(fresh) },
              |sofar: { written: Map<Bytes, List<Bytes>>, read: List<Bytes>, pulled: List<Bytes>, functions: Int, rejected: List<Bytes> }, n: Bytes| {
                let m = summary_of({ module: n, shipped: true, tested: false });
                {
                  ..sofar,
                  written: sofar.written.insert(n, m.written),
                  functions: if n == prelude_module { sofar.functions }
                  else { sofar.functions + m.functions },
                  rejected: if m.rejected { sofar.rejected.push(n) } else { sofar.rejected },
                }
              },
            ),
          )
        }
      },
    );
    {
      cycle: false,
      rejected: flagged(|m: ModuleSummary| m.rejected).concat(pulled.rejected),
      warned: flagged(|m: ModuleSummary| m.warned),
      pulled: pulled.pulled,
      modules: own.len() + pulled.pulled.len(),
      definitions: mine.fold(pulled.functions, |n: Int, m: ModuleSummary| n + m.functions),
      tests: mine.fold(0, |n: Int, m: ModuleSummary| n + m.tests),
      checked_later: mine.any(|m: ModuleSummary| m.checked_later),
      promises: mine.any(|m: ModuleSummary| m.promises),
      measures: mine.any(|m: ModuleSummary| m.measures),
    }
  })
}

pub fn declaring_query() -> QueryOf<Bytes, Map<Bytes, List<Bytes>>> =
  { name: b"declaring", input: bin::bytes_bin(), output: declaring_bin() }

pub fn list_documenting_modules(package: Bytes) -> Written / {memo.read, abort.raise} = {
  let shipped = shipped_names_listed();
  let under = package.concat(b".");
  written(
    declaring_query(),
    shipped.filter(|m: Bytes| m == package || m.starts_with(under)).fold(
      Map::new(),
      |accumulator: Map<Bytes, List<Bytes>>, m: Bytes|
        fetch(documented_query(), { module: m, shipped: true, tested: false }).pages.fold(
          accumulator,
          |by: Map<Bytes, List<Bytes>>, page: Page| {
            let simple = Bytes::of_string(page.simple);
            let listed_modules = match by.get(simple) { Some(ms) -> ms, None -> [] };
            if page.simple == "" || listed_modules.contains(m) { by }
            else { by.insert(simple, listed_modules.push(m)) }
          },
        ),
    ),
  )
}

pub fn declaring_bin() -> bin::BinCodec<Map<Bytes, List<Bytes>>> =
  bin::map_bin(bin::bytes_bin(), bin::list_bin(bin::bytes_bin()))

