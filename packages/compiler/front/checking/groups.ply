// --- A module checked a group of owners at a time ------------------------------------------------

// A module is read once for its owners, what each mentions and the groups they check in. Each group
// is checked against the entries its members' text mentions, so an edit to one owner checks its
// group again, and a group that reads an entry checks again only where that entry moved. A module's
// answer and its hashing are its groups', put together.

/// An owner of a module: the module as `ModuleKey` reads it, and the owner by its name there.
pub type OwnerKey = { module: Bytes, shipped: Bool, tested: Bool, owner: Bytes }

/// Owners of a module that check together, each by its name there, in the order of their names.
pub type GroupKey = { module: Bytes, shipped: Bool, tested: Bool, owners: List<Bytes> }

/// One owner as a check of its group reads it: its own text, and what it mentions.
pub type OwnerFacts = { read: OwnerText, mentions: List<Mention> }

/// A module read for its owners: whether there is such a module, its text, each owner's facts
/// encoded apart, where its items stand left out of them and beside them, in the order its first
/// item stands, the groups they check in, each after every
/// group it mentions, each owner's shape encoded as its facts are ([`signature_text`]) and the groups the
/// shapes sign in, the owners of each name it declares, what a check of any group reads of it
/// beside their text, its shape as its text alone says it, its functions in the order a check of it
/// files them and in the order it walks their bodies, and what a check of the whole of it reads of
/// the modules it imports.
pub type OwnersResult = {
  found: Bool,
  text: Bytes,
  owners: List<{ owner: Bytes, facts: Bytes, starts: List<Int> }>,
  groups: List<List<Bytes>>,
  shapes: List<{ owner: Bytes, facts: Bytes }>,
  signing: List<List<Bytes>>,
  declared: Map<Bytes, List<Bytes>>,
  context: Context,
  shape: ModuleShape,
  order: List<Bytes>,
  filed: List<Bytes>,
  wanted: List<Mention>,
  publishing: Map<Bytes, List<Mention>>,
  refusing: Bool,
}

/// What hashing fixed of a group of owners: each owner's hash entry, and each node, test and law.
pub type GroupHashes = { entries: Map<Bytes, HashEntry>, fixing: CachedHashes }

derive bin for OwnerKey

derive bin for GroupKey

derive bin for OwnerFacts

derive bin for OwnersResult

derive bin for GroupHashes

pub fn owners_query() -> Bytes = b"owners"

pub fn owner_query() -> Bytes = b"owner"

pub fn unit_of_query() -> Bytes = b"unit of"

pub fn calls_query() -> Bytes = b"calls"

pub fn cycles_query() -> Bytes = b"cycles"

pub fn group_of_query() -> Bytes = b"group of"

pub fn shape_query() -> Bytes = b"shape"

pub fn signature_unit_query() -> Bytes = b"sign unit of"

pub fn setting_query() -> Bytes = b"setting"

pub fn group_imports_query() -> Bytes = b"group imports"

pub fn published_query() -> Bytes = b"published"

pub fn sees_query() -> Bytes = b"sees"

pub fn wants_query() -> Bytes = b"wants"

pub fn declared_query() -> Bytes = b"declared"

pub fn group_query() -> Bytes = b"group"

pub fn owner_interface_query() -> Bytes = b"owner entry"

pub fn shown_query() -> Bytes = b"shown"

pub fn signatures_query() -> Bytes = b"signatures"

pub fn signature_query() -> Bytes = b"signature"

pub fn signed_query() -> Bytes = b"signed"

pub fn typed_query() -> Bytes = b"typed"

pub fn group_hash_query() -> Bytes = b"group hash"

pub fn owner_hash_query() -> Bytes = b"owner hash"

fn module_key_of(o: OwnerKey) -> ModuleKey =
  { module: o.module, shipped: o.shipped, tested: o.tested }

fn owners_result_of(named: ModuleKey) -> OwnersResult / {memo.read, abort.raise} =
  decoded(
    memo.fetch(owners_query(), bin::encode(named, module_key_bin())),
    owners_result_bin(),
    "a module's owners",
  )

fn no_context() -> Context =
  {
    imports: [],
    targets: [],
    present: [],
    setting: {
      placed: ShippedModule,
      pkgs: { root: b"", manifest: None, supplied: [] },
      judged: None,
      tested: false,
      unread: [],
      whole: [],
      data: [],
      embeds: [],
    },
  }

/// What a check reads of the module `c` sets: each module it reads whole parsed as the load reads
/// it, so its library derivations are what the world answers.
fn reading_of(c: Setting) -> CheckInputs / {QueryEffects, abort.raise} =
  {
    pkgs: c.pkgs,
    judged: c.judged,
    tested: c.tested,
    unread: c.unread,
    whole: c.whole,
    data: c.data,
    embeds: c.embeds,
    given: c.whole.map(|source: Source| read_once(source).given),
  }

/// The modules `m`'s imports resolve to, hidden ones among them, each once: what a load reads of
/// what the module imports.
fn resolved_imports(m: ModuleRead) -> List<Bytes> =
  m.names.concat(m.parsed.module.imports.drop(m.raw.imports.len()).map(import_path)).fold(
    [],
    |acc: List<Bytes>, n: Bytes|
      if acc.contains(n) || (!m.present.contains(n) && m.names.contains(n)) { acc }
      else { acc.push(n) },
  )

/// A module read for its owners, read as `ModuleKey` says.
pub fn owners_answer(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, module_key_bin(), "a module's name");
  let read = match module_read(key) {
    None ->
      {
        found: false,
        text: b"",
        owners: [],
        groups: [],
        shapes: [],
        signing: [],
        declared: Map::new(),
        context: no_context(),
        shape: no_shape(key.module),
        order: [],
        filed: [],
        wanted: [],
        publishing: Map::new(),
        refusing: false,
      },
    Some(m) -> {
      let module = m.source.name;
      let scope = module_scope(m.parsed, m.raw, m.names);
      let reads = owner_texts(m.parsed, m.raw, m.source.src);
      let mentions = reads.fold(Map::new(), |acc: Map<Bytes, List<Mention>>, o: OwnerText|
        acc.insert(
          o.owner,
          owner_mentions(module, scope, o, m.source.src, owner_tokens(m.tokens, o)),
        ));
      let imported = resolved_imports(m);
      let items = requests_by_item(m.parsed.module);
      let shapes = reads.map(|o: OwnerText| signature_text(m.raw, o));
      let shape_mentions = range(0, reads.len()).fold(
        Map::new(),
        |acc: Map<Bytes, List<Mention>>, k: Int| {
          let o = reads.get(k);
          let lexed = signature_tokens(m.raw, m.tokens, o);
          acc.insert(o.owner, owner_mentions(module, scope, shapes.get(k), m.source.src, lexed))
        },
      );
      {
        found: true,
        text: m.source.src,
        owners: reads.map(|o: OwnerText|
          {
            owner: o.owner,
            // Where its items stand is the module's to know: an edit above it moves nothing of it.
            facts: bin::encode(
              {
                read: { ..o, starts: o.starts.map(|_: Int| 0) },
                mentions: match mentions.get(o.owner) { Some(ms) -> ms, None -> [] },
              },
              owner_facts_bin(),
            ),
            starts: o.starts,
          }),
        groups: owner_groups(module, scope, reads.map(|o: OwnerText| o.owner), mentions),
        shapes: shapes.map(|o: OwnerText|
          {
            owner: o.owner,
            facts: bin::encode(
              {
                read: { ..o, starts: o.starts.map(|_: Int| 0) },
                mentions: match shape_mentions.get(o.owner) { Some(ms) -> ms, None -> [] },
              },
              owner_facts_bin(),
            ),
          }),
        signing: owner_groups(module, scope, reads.map(|o: OwnerText| o.owner), shape_mentions),
        declared: scope.written.owners,
        context: {
          imports: unplaced_imports(m.raw),
          targets: m.names,
          present: m.present,
          setting: {
            placed: m.placed,
            pkgs: m.reading.pkgs,
            judged: m.reading.judged,
            tested: m.reading.tested,
            unread: m.reading.unread,
            whole: m.reading.whole,
            data: m.reading.data,
            embeds: m.reading.embeds,
          },
        },
        shape: {
          outline: {
            let o = read_outline(m.parsed);
            // A module read without its tests and laws outlines none, those its statements make among them.
            if m.reading.tested { o } else {
              {
                ..o,
                items: o.items.filter(|x: OutlineItem|
                  match x { OutlinedTest(_) -> false, OutlinedLaw(_) -> false, _ -> true }),
              }
            }
          },
          imports: imported,
          named: named_imports(m.parsed, imported),
          written: m.parsed.module.imports.map(import_module_name).concat(
            m.present.filter(|p: Bytes| !m.names.contains(p)),
          ),
          embeds: [],
          embed_items: if items.fold(false, |b: Bool, x: ItemEmbeds| b || x.wants.len() > 0) {
            items
          } else { [] },
          tagged: [],
          statements: [],
          consts: [],
        },
        order: checked_functions(m.parsed),
        filed: check_order(m.parsed),
        wanted: imported_mentions_in(m.parsed, m.raw, m.source.src, m.tokens, m.names),
        // What the module publishes for each `opaque` type is its whole text's to say: a check of
        // the type's group alone sees only the functions that group reads.
        publishing: m.parsed.module.items.fold(
          Map::new(),
          |acc: Map<Bytes, List<Mention>>, item: Item|
            match item {
              TypeItem(d) -> match d.opaque {
                Some(op) ->
                  acc.insert(
                    d.name.name,
                    op.result.concat(op.take).map(|f: Bytes| { module: module, name: f }),
                  ),
                None -> acc,
              },
              _ -> acc,
            },
        ),
        // Its text, or its imports alone: one naming no module there is, or two binding one name.
        refusing: m.reading.given.fold(false, |b: Bool, g: ParsedSource|
            b || g.diags.fold(false, |c: Bool, d: Diag| c || d.severity == b"error"))
          || m.names.any(|n: Bytes| !m.present.contains(n))
          || colliding(m.raw.imports).len() > 0,
      }
    },
  };
  prefill_projections(key, read);
  bin::encode(read, owners_result_bin())
}

/// One owner of a module, read as `OwnerKey` says: its text and what it mentions; nothing for an
/// owner the module does not hold.
pub fn owner_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  let read = owners_head(named);
  match memo.provided() {
    Some(o) -> o,
    None -> {
      let r = owners_under(named, read);
      prefill_owners(named, r, Some(key.owner));
      owner_facts_in(r, key.owner)
    },
  }
}

/// The modules a module can see beside itself, read as `ModuleKey` says: each it imports, directly
/// or through others, in the order of their names. A function of a type one of them declares, or
/// the module itself, is what a call on a value in it may call.
pub fn sees_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let context = decoded(memo.fetch(context_query(), input), context_bin(), "a module's context");
  let seen = context.present.fold(Map::new(), |acc: Map<Bytes, Bool>, m: Bytes|
    visible_modules_of({ module: m, shipped: shipped_for(named.shipped, m), tested: false }).fold(
      acc.insert(m, true),
      |a: Map<Bytes, Bool>, below: Bytes| a.insert(below, true),
    ));
  bin::encode(seen.keys(), bin::list_bin(bin::bytes_bin()))
}

fn visible_modules_of(named: ModuleKey) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(sees_query(), bin::encode(named, module_key_bin())),
    bin::list_bin(bin::bytes_bin()),
    "the modules a module can see",
  )

pub fn value_call_modules_query() -> Bytes = b"answering"

/// The modules a module can see that declare a function of one of their types under a name, read
/// as `EntryNamed` says, in the order of their names: what a call of that name on a value in the
/// module may call beside the module's own. An import the module gains or loses moves it only
/// where one of those came or went.
pub fn answering_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, interface_key_bin(), "an entry's name");
  bin::encode(
    visible_modules_of({ module: key.module, shipped: key.shipped, tested: key.tested }).filter(
      |m: Bytes| declared_of(m, shipped_for(key.shipped, m), false, of_any(key.name)).len() > 0,
    ),
    bin::list_bin(bin::bytes_bin()),
  )
}

fn value_call_modules(named: ModuleKey, name: Bytes) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      value_call_modules_query(),
      bin::encode(
        { module: named.module, shipped: named.shipped, tested: named.tested, name: name },
        interface_key_bin(),
      ),
    ),
    bin::list_bin(bin::bytes_bin()),
    "the modules that answer a name called on a value",
  )

/// What `called`, names a text of the module `named` names calls on a value, may call in the
/// modules it can see.
fn value_call_mentions(
  named: ModuleKey,
  called: List<Bytes>,
) -> List<Mention> / {memo.read, abort.raise} =
  called.fold([], |acc: List<Mention>, n: Bytes|
    acc.concat(called_of(value_call_modules(named, n), [n])))

/// What a module publishes for an `opaque` type an owner of it declares, read as `OwnerKey` says:
/// each function that answers one and each that takes one; none for any other owner.
pub fn published_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  let read = owners_head(named);
  match memo.provided() {
    Some(o) -> o,
    None -> {
      let r = owners_under(named, read);
      prefill_published(named, r, Some(key.owner));
      bin::encode(
        match r.publishing.get(key.owner) { Some(ms) -> ms, None -> [] },
        bin::list_bin(mention_bin()),
      )
    },
  }
}

/// The group an owner of a module checks in, read as `OwnerKey` says.
pub fn unit_of_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  let read = owners_head(named);
  match memo.provided() {
    Some(o) -> o,
    None -> {
      let r = owners_under(named, read);
      prefill_units(named, r, Some(key.owner));
      bin::encode(group_holding(r, key.owner), bin::list_bin(bin::bytes_bin()))
    },
  }
}

/// The owners of its module an owner's walked bodies call, in the order of their names and itself
/// left out, read as `OwnerKey` says: what its walk left, read for nothing else, so a body edited
/// without a call added or dropped answers as before.
pub fn calls_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  bin::encode(
    called_owners(
      key.owner,
      owner_checks::called_names(key.module, inference_of(named, key.owner)),
      |n: Bytes| declared_of(key.module, key.shipped, key.tested, n),
    ),
    bin::list_bin(bin::bytes_bin()),
  )
}

/// The owners that declare `names`, as `declared` answers each name's, in the order of their
/// names and `owner` left out.
fn called_owners<| e>(
  owner: Bytes,
  names: List<Bytes>,
  declared: (Bytes) -> List<Bytes> / {abort.raise | e},
) -> List<Bytes> / {abort.raise | e} =
  sorted_bytes(
    names.fold([], |acc: List<Bytes>, n: Bytes|
      declared(n).fold(acc, |a: List<Bytes>, o: Bytes|
        if o == owner || a.contains(o) { a } else { a.push(o) })),
  )

fn calls_of(named: ModuleKey, owner: Bytes) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(calls_query(), owner_at(named, owner)),
    bin::list_bin(bin::bytes_bin()),
    "what an owner calls",
  )

/// The groups of the unit `GroupKey` names: its owners cut into those whose walked bodies call
/// one another round a cycle, each group after every group it calls. A unit of one owner is one
/// group; nothing for owners their module no longer holds as a unit.
pub fn cycles_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a unit's names");
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  bin::encode(
    if !current_unit(key) { [] }
    else if key.owners.len() < 2 { [key.owners] }
    else { call_cycles(key.owners, key.owners.map(|o: Bytes| calls_of(named, o))) },
    bin::list_bin(bin::list_bin(bin::bytes_bin())),
  )
}

fn cycles_of(unit: GroupKey) -> List<List<Bytes>> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(cycles_query(), bin::encode(unit, group_key_bin())),
    bin::list_bin(bin::list_bin(bin::bytes_bin())),
    "a unit's groups",
  )

/// The owners an owner of a module is checked with, itself among them, read as `OwnerKey` says:
/// its unit where that is the owner alone, and otherwise the group of its unit that holds it.
pub fn group_of_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let unit = unit_key_of(key);
  bin::encode(
    if unit.owners.len() < 2 { unit.owners } else {
      cycles_of(unit).fold([], |acc: List<Bytes>, g: List<Bytes>|
        if g.contains(key.owner) { g } else { acc })
    },
    bin::list_bin(bin::bytes_bin()),
  )
}

/// One owner of a module as a signing of it reads it, read as `OwnerKey` says: its text with
/// each body cut and what that text mentions, encoded as an owner's facts are; nothing for an
/// owner the module does not hold.
pub fn shape_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  let read = owners_head(named);
  match memo.provided() {
    Some(o) -> o,
    None -> {
      let r = owners_under(named, read);
      prefill_shapes(named, r, Some(key.owner));
      shape_in(r, key.owner)
    },
  }
}

/// The owners an owner of a module signs with, itself among them, read as `OwnerKey` says: those
/// whose shapes mention one another round a cycle.
pub fn sign_unit_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  let read = owners_head(named);
  match memo.provided() {
    Some(o) -> o,
    None -> {
      let r = owners_under(named, read);
      prefill_signature_units(named, r, Some(key.owner));
      bin::encode(signing_with(r, key.owner), bin::list_bin(bin::bytes_bin()))
    },
  }
}

/// What a check of any group of a module's owners reads of the module beside their text, read as
/// `ModuleKey` says.
pub fn context_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_head(named);
  match memo.provided() {
    Some(o) -> o,
    None -> bin::encode(owners_under(named, read).context, context_bin()),
  }
}

/// What a check of any group of a module's owners reads of the module beside their own text and
/// imports, read as `ModuleKey` says.
pub fn setting_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_head(named);
  match memo.provided() {
    Some(o) -> o,
    None -> bin::encode(owners_under(named, read).context.setting, setting_bin()),
  }
}

/// What a module embeds of the shipped modules, read as `ModuleKey` says: what a load ships beside the
/// shipped modules it pulls, read off the module's setting rather than its text.
pub fn wants_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let setting = decoded(memo.fetch(setting_query(), input), setting_bin(), "a module's setting");
  bin::encode(
    { texts: setting.whole.map(|s: Source| s.name), data: setting.data.map(|d: EmbedFile| d.name) },
    shipped_wants_bin(),
  )
}

/// What a group of a module's owners reads of the module's imports, read as `GroupKey` says.
pub fn group_imports_answer(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a group's names");
  if !current(key) { bin::encode([], bin::list_bin(imported_bin())) } else {
    let named = { module: key.module, shipped: key.shipped, tested: key.tested };
    let context = context_once(named);
    let members = key.owners.map(|o: Bytes| owner_facts(named, o));
    bin::encode(
      group_imports(
        key.module,
        members.map(|f: OwnerFacts| f.read),
        members.fold([], |acc: List<Mention>, f: OwnerFacts| acc.concat(f.mentions)),
        context.imports,
        context.targets,
      ),
      bin::list_bin(imported_bin()),
    )
  }
}

/// The owners of a name a module declares, read as `EntryNamed` says: every owner for none.
pub fn declared_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, interface_key_bin(), "an entry's name");
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  let read = owners_head(named);
  match memo.provided() {
    Some(o) -> o,
    // A call on a value asks this of every module it can see, most of which declare nothing so
    // named: that is read off the module's names, not its whole read.
    None -> if key.name != b"" && !names_of(named).contains(key.name) {
      bin::encode([], bin::list_bin(bin::bytes_bin()))
    } else {
      let r = owners_under(named, read);
      prefill_declared(named, r, Some(key.name));
      bin::encode(declared_in(r, key.name), bin::list_bin(bin::bytes_bin()))
    },
  }
}

pub fn names_query() -> Bytes = b"names"

/// The names a module declares an owner under, read as `ModuleKey` says, in their order.
pub fn names_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_head(named);
  match memo.provided() {
    Some(o) -> o,
    None -> bin::encode(owners_under(named, read).declared.keys(), bin::list_bin(bin::bytes_bin())),
  }
}

fn names_of(named: ModuleKey) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(names_query(), bin::encode(named, module_key_bin())),
    bin::list_bin(bin::bytes_bin()),
    "the names a module declares",
  )

/// The digest of a module read for its owners as `named` says: the read a projection of it makes. A
/// projection the read offered is taken whole, so the read's own bytes are fetched only for one it
/// did not ([`owners_under`]).
fn owners_head(named: ModuleKey) -> Bytes / {memo.read, abort.raise} =
  memo.output_digest(owners_query(), bin::encode(named, module_key_bin()))

/// The module read for its owners as `named` says, which [`owners_head`] answered `digest` for.
fn owners_under(named: ModuleKey, digest: Bytes) -> OwnersResult / {memo.read, abort.raise} =
  owners_of(match memo.stored_output(digest) { Some(b) -> b, None -> owners_result_bytes(named) })

fn owners_result_bytes(named: ModuleKey) -> Bytes / {memo.read, abort.raise} =
  memo.fetch(owners_query(), bin::encode(named, module_key_bin()))

fn owners_of(b: Bytes) -> OwnersResult / {abort.raise} =
  decoded(b, owners_result_bin(), "a module's owners")

fn owner_facts_in(read: OwnersResult, owner: Bytes) -> Bytes =
  read.owners.fold(b"", |acc: Bytes, o: { owner: Bytes, facts: Bytes, starts: List<Int> }|
    if o.owner == owner { o.facts } else { acc })

fn group_holding(read: OwnersResult, owner: Bytes) -> List<Bytes> =
  read.groups.fold([], |acc: List<Bytes>, g: List<Bytes>| if g.contains(owner) { g } else { acc })

fn shape_in(read: OwnersResult, owner: Bytes) -> Bytes =
  read.shapes.fold(b"", |acc: Bytes, o: { owner: Bytes, facts: Bytes }|
    if o.owner == owner { o.facts } else { acc })

fn signing_with(read: OwnersResult, owner: Bytes) -> List<Bytes> =
  read.signing.fold([], |acc: List<Bytes>, g: List<Bytes>| if g.contains(owner) { g } else { acc })

fn declared_in(read: OwnersResult, name: Bytes) -> List<Bytes> =
  if name == b"" { read.owners.map(|o: { owner: Bytes, facts: Bytes, starts: List<Int> }| o.owner) }
  else { match read.declared.get(name) { Some(os) -> os, None -> [] } }

/// Offers what each projection of `read`, a module read for its owners as `named` says, answers:
/// what a run that read the module again asks of each owner and name of it is then taken, not
/// decoded out of the whole read.
fn prefill_projections(named: ModuleKey, read: OwnersResult) -> Unit / {memo.read, abort.raise} = {
  memo.provide(
    context_query(),
    bin::encode(named, module_key_bin()),
    bin::encode(read.context, context_bin()),
  );
  memo.provide(
    setting_query(),
    bin::encode(named, module_key_bin()),
    bin::encode(read.context.setting, setting_bin()),
  );
  memo.provide(
    names_query(),
    bin::encode(named, module_key_bin()),
    bin::encode(read.declared.keys(), bin::list_bin(bin::bytes_bin())),
  );
  prefill_published(named, read, None);
  prefill_owners(named, read, None);
  prefill_units(named, read, None);
  prefill_shapes(named, read, None);
  prefill_signature_units(named, read, None);
  prefill_declared(named, read, None)
}

fn owner_at(named: ModuleKey, owner: Bytes) -> Bytes / {abort.raise} =
  bin::encode(
    { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
    owner_key_bin(),
  )

/// Offers what the `published` projection of `read`, a module read as `named` says, answers for
/// each owner but `except`: a projection that decoded the whole read leaves the rest to be taken.
fn prefill_published(
  named: ModuleKey,
  read: OwnersResult,
  except: Option<Bytes>,
) -> Unit / {memo.read, abort.raise} =
  read.publishing.fold((), |_: Unit, owner: Bytes, ms: List<Mention>|
    if except == Some(owner) { () } else {
      memo.provide(
        published_query(),
        owner_at(named, owner),
        bin::encode(ms, bin::list_bin(mention_bin())),
      )
    })

/// [`prefill_published`] for the `owner` projection.
fn prefill_owners(
  named: ModuleKey,
  read: OwnersResult,
  except: Option<Bytes>,
) -> Unit / {memo.read, abort.raise} =
  read.owners.fold((), |_: Unit, o: { owner: Bytes, facts: Bytes, starts: List<Int> }|
    if except == Some(o.owner) { () }
    else { memo.provide(owner_query(), owner_at(named, o.owner), o.facts) })

/// [`prefill_published`] for the `unit of` projection.
fn prefill_units(
  named: ModuleKey,
  read: OwnersResult,
  except: Option<Bytes>,
) -> Unit / {memo.read, abort.raise} =
  read.owners.fold((), |_: Unit, o: { owner: Bytes, facts: Bytes, starts: List<Int> }|
    if except == Some(o.owner) { () } else {
      memo.provide(
        unit_of_query(),
        owner_at(named, o.owner),
        bin::encode(group_holding(read, o.owner), bin::list_bin(bin::bytes_bin())),
      )
    })

/// [`prefill_published`] for the `shape` projection.
fn prefill_shapes(
  named: ModuleKey,
  read: OwnersResult,
  except: Option<Bytes>,
) -> Unit / {memo.read, abort.raise} =
  read.shapes.fold((), |_: Unit, o: { owner: Bytes, facts: Bytes }|
    if except == Some(o.owner) { () }
    else { memo.provide(shape_query(), owner_at(named, o.owner), o.facts) })

/// [`prefill_published`] for the `sign unit of` projection.
fn prefill_signature_units(
  named: ModuleKey,
  read: OwnersResult,
  except: Option<Bytes>,
) -> Unit / {memo.read, abort.raise} =
  read.shapes.fold((), |_: Unit, o: { owner: Bytes, facts: Bytes }|
    if except == Some(o.owner) { () } else {
      memo.provide(
        signature_unit_query(),
        owner_at(named, o.owner),
        bin::encode(signing_with(read, o.owner), bin::list_bin(bin::bytes_bin())),
      )
    })

/// [`prefill_published`] for the `declared` projection: each name the module declares, and every
/// owner under the empty name.
fn prefill_declared(
  named: ModuleKey,
  read: OwnersResult,
  except: Option<Bytes>,
) -> Unit / {memo.read, abort.raise} =
  read.declared.keys().push(b"").fold((), |_: Unit, name: Bytes|
    if except == Some(name) { () } else {
      memo.provide(
        declared_query(),
        bin::encode(
          { module: named.module, shipped: named.shipped, tested: named.tested, name: name },
          interface_key_bin(),
        ),
        bin::encode(declared_in(read, name), bin::list_bin(bin::bytes_bin())),
      )
    })

fn declared_of(
  module: Bytes,
  shipped: Bool,
  tested: Bool,
  name: Bytes,
) -> List<Bytes> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      declared_query(),
      bin::encode(
        { module: module, shipped: shipped, tested: tested, name: name },
        interface_key_bin(),
      ),
    ),
    bin::list_bin(bin::bytes_bin()),
    "a name's owners",
  )

pub fn owner_facts(named: ModuleKey, owner: Bytes) -> OwnerFacts / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      owner_query(),
      bin::encode(
        { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
        owner_key_bin(),
      ),
    ),
    owner_facts_bin(),
    "an owner's facts",
  )

/// The group of owners `key` names checked, beside where its items stand as [`group_source`] lays
/// them: what a check of their own text alone against the entries it mentions answers, or what a
/// check of their whole module offered for it. A group of one owner is walked and settled in one
/// check. One of several is a unit: each owner is walked alone ([`typed_answer_of`]) and the unit
/// settled from what those walks left, so an edit to one body walks one owner.
pub fn group_answer_of(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a group's names");
  if !current(key) { owner_checks::encode_group(owner_checks::no_group()) } else {
    let named = { module: key.module, shipped: key.shipped, tested: key.tested };
    let alone = unit_key_of({
        module: key.module,
        shipped: key.shipped,
        tested: key.tested,
        owner: key.owners.at_or(0, b""),
      }).owners.len(
      )
      < 2;
    match whole_check_result(key) {
      Some(o) -> {
        reads_of(
          named,
          key.owners,
          key.owners.fold([], |acc: List<Mention>, x: Bytes|
            acc.concat(owner_facts(named, x).mentions)),
          imports_of(key),
          // A unit's group stands on its members' walks, which take what the same check offered.
          if alone { entire } else { sibling_reading(inferred_calls(named, key)) },
        );
        o
      },
      None -> {
        let members = key.owners.map(|o: Bytes| owner_facts(named, o));
        match refused_sibling(key, members) {
          Some(o) -> owner_checks::encode_group(blocked_group_result(key, o)),
          None -> if alone {
            let answer = cut_of(
              key.module,
              unit_checked(named, members, imports_of(key), entire, no_bodies),
            );
            prefill_forms(group_query(), key, members.map(|f: OwnerFacts| f.read), answer);
            owner_checks::encode_group(answer)
          } else { owner_checks::encode_group(finalize_group(named, key, members)) },
        }
      },
    }
  }
}

/// An owner of `key`'s module outside its unit, which a member mentions, whose group refuses and
/// so shows no entry. A check against the module without it would refuse too, and its module's
/// answer says what a check of it whole says whenever a group refuses.
fn refused_sibling(
  key: GroupKey,
  members: List<OwnerFacts>,
) -> Option<Bytes> / {QueryEffects, abort.raise} = {
  let at = |o: Bytes| { module: key.module, shipped: key.shipped, tested: key.tested, owner: o };
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  let unit = unit_key_of(at(key.owners.at_or(0, b""))).owners;
  members.fold([], |acc: List<Mention>, f: OwnerFacts| acc.concat(f.mentions)).fold(
    None,
    |found: Option<Bytes>, m: Mention|
      match found {
        Some(_) -> found,
        None ->
          siblings_named(named, unit, m).find(|o: Bytes|
            match owner_interface_of(at(o)) { Some(_) -> false, None -> true }),
      },
  )
}

/// The owners of the module `named` names, none of `inside`, that the mention `m` names: what a
/// check of `inside`'s owners reads of their module beside themselves. A name called on a value
/// names none of them: the module's own functions it may call are mentioned apart, under the
/// name of a type's function.
fn siblings_named(
  named: ModuleKey,
  inside: List<Bytes>,
  m: Mention,
) -> List<Bytes> / {memo.read, abort.raise} =
  if m.module != named.module { [] } else {
    declared_of(m.module, named.shipped, named.tested, m.name).filter(|o: Bytes|
      !inside.contains(o))
  }

/// What a group answers that waits on `owner`, whose group refuses: no member's entry, and a
/// refusal its module's answer takes the whole check's place of, unchecked.
fn blocked_group_result(key: GroupKey, owner: Bytes) -> owner_checks::GroupResult / {abort.raise} =
  {
    ..owner_checks::no_group(),
    refused: [
      error_at(
        b"E0505",
        0,
        dummy_span(),
        Bytes::concat_all([
          backticked(key.owners, b", "),
          b" waits on `",
          owner,
          b"`, which does not check, and a check of `",
          key.module,
          b"` whole refuses nothing",
        ]),
        b"the check was put off",
        [b"this is Ply's fault, not the program's"],
      ),
    ],
  }

/// How a check reads an owner of its module that is none of its members: by the entry it shows
/// any reader; by that entry less its rows, as its signing shows it, which waits on no body; or by
/// the entry its group's record shows, which carries no digest of what it reaches.
type Sibling = | Entire | BySignature | ByGroupResult

pub fn entire(_: Bytes) -> Sibling = Entire

fn by_signature(_: Bytes) -> Sibling = BySignature

/// A check of some owners of a module, and its source.
type UnitCheck = {
  reads: List<OwnerText>,
  source: OwnerSource,
  out: { pulled: PulledAnalysis, at: Int },
}

/// What a check hands itself of its bodies, given its source: nothing where it walks every one.
type BodySupplier = (OwnerSource) -> Option<(Int) -> BodyChecking / {abort.raise}> / {abort.raise}

fn no_bodies(_: OwnerSource) -> Option<(Int) -> BodyChecking / {abort.raise}> = None

/// A check that walks the functions `walked` names and no other, and settles nothing.
fn inferring_only(walked: List<Bytes>) -> BodySupplier =
  |_: OwnerSource| Some(|_: Int| CheckOnly(walked))

/// `members`, owners of the module `named` names, checked together through the imports `imported`
/// against what they read, and again with what the modules of `opaque` types publish where that
/// refuses, which only says why a use of one is refused. `sibling` says how each other owner of
/// the module is read, and `handing` is what the check is handed of its bodies.
fn unit_checked(
  named: ModuleKey,
  members: List<OwnerFacts>,
  imported: List<Imported>,
  sibling: (Bytes) -> Sibling,
  handing: BodySupplier,
) -> UnitCheck / {QueryEffects, abort.raise} = {
  let checked_of = |published: Bool| {
    let c = owners_check(named, members, imported, published, sibling);
    let source = group_source_from(named.module, c.reads, c.imported, c.needed);
    {
      reads: c.reads,
      source: source,
      out: checked_owner(
        source,
        c.setting.placed,
        module_origin_lookup(c.places),
        reading_of(c.setting),
        walks: handing(source),
      ),
    }
  };
  let first = checked_of(false);
  match first.out.pulled.out { Analysed(_) -> first, Refused(_) -> checked_of(true) }
}

/// What `c` answered of the owners of `module` it checked, each place counted from where their own
/// text starts.
fn cut_of(module: Bytes, c: UnitCheck) -> owner_checks::GroupResult / {abort.raise} =
  owner_checks::group_result(
    c.out.pulled.out,
    c.out.at,
    c.source.source.src,
    module,
    c.reads,
    c.source.items,
    |x: ItemAt| c.source.offset + x.from,
  )

pub fn imports_of(key: GroupKey) -> List<Imported> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(group_imports_query(), bin::encode(key, group_key_bin())),
    bin::list_bin(imported_bin()),
    "a group's imports",
  )

/// The owners of its module, itself left out, that the group `key` calls, read off its members'
/// walks, which the group stands on.
fn inferred_calls(named: ModuleKey, key: GroupKey) -> List<Bytes> / {memo.read, abort.raise} =
  called_in(key, key.owners.map(|o: Bytes| { owner: o, typed: inference_of(named, o) }))

/// As `inferred_calls`, of walks `walked` already read.
fn called_in(
  key: GroupKey,
  walked: List<{ owner: Bytes, typed: owner_checks::InferenceResult }>,
) -> List<Bytes> / {memo.read, abort.raise} =
  walked.fold([], |acc: List<Bytes>, w: { owner: Bytes, typed: owner_checks::InferenceResult }|
    called_owners(w.owner, owner_checks::called_names(key.module, w.typed), |n: Bytes|
      declared_of(key.module, key.shipped, key.tested, n)).fold(acc, |a: List<Bytes>, c: Bytes|
      if key.owners.contains(c) || a.contains(c) { a } else { a.push(c) }))

/// How a group that calls `called` reads each other owner of its module: one it calls by what
/// that owner's group settled, which its own settling reads, and any other by its signature.
fn sibling_reading(called: List<Bytes>) -> (Bytes) -> Sibling =
  |o: Bytes| if called.contains(o) { ByGroupResult } else { BySignature }

/// A group of a unit of several owners settled: each member's walk, any of which refusing refuses
/// the group with what every walk refused; then a check of the group's text that is handed those
/// bodies and walks none, whose answer takes from each walk what only a walk makes.
fn finalize_group(
  named: ModuleKey,
  key: GroupKey,
  members: List<OwnerFacts>,
) -> owner_checks::GroupResult / {QueryEffects, abort.raise} = {
  let walked = key.owners.map(|o: Bytes| { owner: o, typed: inference_of(named, o) });
  let refused = owner_checks::inference_errors(
    walked,
    item_layout(members.map(|f: OwnerFacts| f.read)),
  );
  if refused.len() > 0 { { ..owner_checks::no_group(), refused: refused } } else {
    let c = unit_checked(
      named,
      members,
      imports_of(key),
      sibling_reading(called_in(key, walked)),
      |source: OwnerSource|
        Some(owner_checks::supplied_bodies(walked, source.items, source.offset)),
    );
    owner_checks::finalized_result(cut_of(key.module, c), walked, c.source.items)
  }
}

fn inference_of(
  named: ModuleKey,
  owner: Bytes,
) -> owner_checks::InferenceResult / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      typed_query(),
      bin::encode(
        { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
        owner_key_bin(),
      ),
    ),
    owner_checks::inference_result_bin(),
    "an owner's walk",
  )

/// What each owner of the sign unit `key` names shows what reads it, less the rows its settling
/// answers: its entry as a check of the unit's shapes cuts it, which binds each function by its
/// signature and walks none, or as a check of its whole module offered it. It reads no body, so an
/// edit to one leaves it standing. Nothing for owners their module no longer signs together.
pub fn signatures_answer(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a sign unit's names");
  if !is_signature_unit(key) {
    bin::encode({ shown: [], refused: [] }, owner_checks::signature_check_bin())
  } else {
    let named = { module: key.module, shipped: key.shipped, tested: key.tested };
    let offered = whole_check_result(key);
    let members = key.owners.map(|o: Bytes| shape_of(named, o));
    let context = context_once(named);
    let imported = group_imports(
      key.module,
      members.map(|f: OwnerFacts| f.read),
      members.fold([], |acc: List<Mention>, f: OwnerFacts| acc.concat(f.mentions)),
      context.imports,
      context.targets,
    );
    match offered {
      Some(o) -> {
        reads_of(
          named,
          key.owners,
          members.fold([], |acc: List<Mention>, f: OwnerFacts| acc.concat(f.mentions)),
          imported,
          by_signature,
        );
        o
      },
      None ->
        bin::encode(
          owner_checks::signature_check_of(
            cut_of(
              key.module,
              unit_checked(named, members, imported, by_signature, inferring_only([])),
            ),
          ),
          owner_checks::signature_check_bin(),
        ),
    }
  }
}

/// Whether `g` names owners their module signs together.
fn is_signature_unit(g: GroupKey) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      signature_unit_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

fn signature_unit_of(o: OwnerKey) -> GroupKey / {memo.read, abort.raise} =
  {
    module: o.module,
    shipped: o.shipped,
    tested: o.tested,
    owners: decoded(
      memo.fetch(signature_unit_query(), bin::encode(o, owner_key_bin())),
      bin::list_bin(bin::bytes_bin()),
      "an owner's sign unit",
    ),
  }

fn shape_of(named: ModuleKey, owner: Bytes) -> OwnerFacts / {memo.read, abort.raise} =
  decoded(memo.fetch(shape_query(), owner_at(named, owner)), owner_facts_bin(), "an owner's shape")

/// The entry an owner shows a walk of another owner of its module, read as `OwnerKey` says: what
/// it shows any reader, less its rows, with the digest of all that reaches. Empty for an owner whose
/// signing refuses.
pub fn signature_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let alone = memo.fetch(signed_query(), input);
  if alone.len() == 0 { b"" } else {
    with_reach_digest(
      alone,
      reach_of(key, signature_unit_of(key), alone, signed_query(), signature_query()),
    )
  }
}

/// The entry an owner's signing shows, read as `OwnerKey` says, with no digest of what it
/// reaches: empty for an owner whose signing refuses.
pub fn signed_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  match owner_checks::group_interfaces(
      memo.fetch(signatures_query(), bin::encode(signature_unit_of(key), group_key_bin())),
    ).get(
      key.owner,
    ) {
    Some(entry) -> entry,
    None -> b"",
  }
}

/// What a walk of one owner of a unit answers, read as `OwnerKey` says: its own text checked
/// against what the signature of each other owner of its module shows and the entries of whatever
/// else it mentions, its functions walked and nothing settled; or what a check of its whole module
/// offered for it. It reads no other owner's body and nothing of which owners check together.
/// Nothing for an owner that is the whole of its group, which that group's check walks.
pub fn typed_answer_of(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let named = module_key_of(key);
  let g = unit_key_of(key);
  if g.owners.len() < 2 {
    bin::encode(owner_checks::no_inference_result(), owner_checks::inference_result_bin())
  } else {
    let offered = whole_check_result(g);
    let facts = owner_facts(named, key.owner);
    let context = context_once(named);
    let imported = group_imports(
      key.module,
      [facts.read],
      facts.mentions,
      context.imports,
      context.targets,
    );
    match offered {
      Some(o) -> {
        reads_of(named, [key.owner], facts.mentions, imported, by_signature);
        o
      },
      None -> {
        let c = unit_checked(
          named,
          [facts],
          imported,
          by_signature,
          inferring_only(facts.read.names.map(|n: Bytes| qualify(key.module, n))),
        );
        bin::encode(
          owner_checks::inference_result(
            c.out.pulled.out,
            c.out.at,
            c.source.source.src,
            key.module,
            facts.read,
            c.source.items,
            |x: ItemAt| c.source.offset + x.from,
          ),
          owner_checks::inference_result_bin(),
        )
      },
    }
  }
}

/// What a check of the whole module offered for the group `key`, where it offered one. Every
/// group asks `whole` of its module first, so the module is decided, with each entry it names
/// settled, before any group of it is checked.
fn whole_check_result(key: GroupKey) -> Option<Bytes> / {memo.read, abort.raise} = {
  memo.output_digest(
    whole_query(),
    bin::encode({ module: key.module, shipped: key.shipped, tested: key.tested }, module_key_bin()),
  );
  memo.provided()
}

pub fn whole_query() -> Bytes = b"whole"

/// Nothing, read as `ModuleKey` says, once a check of the module whole has offered each of its groups
/// what it answers, where enough of them must be checked again ([`whole_pays`]): what that check
/// reads is this record's, not any group's, and what it answers moves nothing that reads it. It
/// reads each entry the module names of the modules it imports whether it checks or not, so it is
/// asked again whenever a group of the module may be.
pub fn whole_answer(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_result_of(named);
  if read.found {
    let called = read.wanted.fold([], |acc: List<Bytes>, m: Mention|
      if m.module == b"" { acc.push(m.name) } else { acc });
    let seen = value_call_mentions(named, called);
    read.wanted.concat(seen).fold((), |_: Unit, m: Mention|
      if m.module == b"" { () } else {
        memo.output_digest(
          owner_interfaces_query(),
          bin::encode(
            {
              module: m.module,
              shipped: shipped_for(named.shipped, m.module),
              tested: false,
              name: m.name,
            },
            interface_key_bin(),
          ),
        );
        ()
      });
    prefill_from_whole_check(named, read, group_keys(named, read), false);
    ()
  };
  b""
}

/// What a check of `owners` of the module `named` names stands on, read without checking them: what
/// a record a check of the whole module offered reads. `mentions` is what their texts mention and
/// `imported` what they read through, and `sibling` says how each other owner of the module is
/// read. Each entry it names carries the digest of all the entry reaches, so the entries those
/// name are not read.
fn reads_of(
  named: ModuleKey,
  owners: List<Bytes>,
  mentions: List<Mention>,
  imported: List<Imported>,
  sibling: (Bytes) -> Sibling,
) -> Unit / {memo.read, abort.raise} = {
  memo.fetch(setting_query(), bin::encode(named, module_key_bin()));
  let targets = imported.map(|x: Imported| x.target).push(named.module);
  let selected = imported.fold([], |acc: List<Mention>, x: Imported|
    match x.decl.kind {
      SelectedNames(ns) -> acc.concat(ns.map(|n: Ident| { module: x.target, name: n.name })),
      _ -> acc,
    });
  let written = selected.concat(mentions);
  // What the owners call on a value they read of every module their own can see.
  let called = written.fold([], |acc: List<Bytes>, m: Mention|
    if m.module == b"" && !acc.contains(m.name) { acc.push(m.name) } else { acc });
  let all = written.concat(value_call_mentions(named, called));
  let modules = all.fold(Map::new(), |acc: Map<Bytes, Bool>, m: Mention|
    if m.module == b"" { acc } else if m.module == named.module {
      if !owners.contains(m.name) {
        siblings_named(named, owners, m).fold((), |_: Unit, o: Bytes|
          sibling_read(named, o, sibling(o)))
      };
      acc
    } else {
      let found = owner_interface_bytes_of(named.shipped, m.module, m.name);
      // A name a module could declare for the functions of its types says nothing of whether
      // the module is there.
      if found.len() == 0 && !targets.contains(m.module) && !m.name.starts_with(b"::") {
        owner_interface_bytes_of(named.shipped, m.module, b"");
        ()
      };
      if found.len() == 0 && m.name.starts_with(b"::") { acc } else { acc.insert(m.module, true) }
    });
  module_origins_of(named.shipped, modules.keys());
  ()
}

/// Another owner of the module `named` names, read as `how` says for what it shows and all that
/// reaches. What its group settled carries no digest of what it reaches; its signature does.
fn sibling_read(named: ModuleKey, owner: Bytes, how: Sibling) -> Unit / {memo.read, abort.raise} = {
  let at = bin::encode(
    { module: named.module, shipped: named.shipped, tested: named.tested, owner: owner },
    owner_key_bin(),
  );
  match how {
    Entire -> memo.output_digest(owner_interface_query(), at),
    BySignature -> memo.output_digest(signature_query(), at),
    ByGroupResult -> {
      memo.output_digest(shown_query(), at);
      memo.output_digest(signature_query(), at)
    },
  };
  ()
}

/// What a check of a group of owners reads: the entries it needs, by module and owner, where each
/// module it reads stands, what else it reads of its module, and its members as their module writes
/// them.
pub type GroupCheck = {
  needed: Map<Bytes, Map<Bytes, OwnerInterface>>,
  imported: List<Imported>,
  places: Map<Bytes, ModuleOrigin>,
  setting: Setting,
  reads: List<OwnerText>,
}

/// What a check of `members`, owners of the module `named` names, together reads through the
/// imports `imported`, with what the modules of `opaque` types it names publish for them where
/// `published` says: what a check that refuses follows to say why.
pub fn owners_check(
  named: ModuleKey,
  members: List<OwnerFacts>,
  imported: List<Imported>,
  published: Bool,
  sibling: (Bytes) -> Sibling,
) -> GroupCheck / {QueryEffects, abort.raise} = {
  let key = {
    module: named.module,
    shipped: named.shipped,
    tested: named.tested,
    owners: members.map(|f: OwnerFacts| f.read.owner),
  };
  let setting = decoded(
    memo.fetch(setting_query(), bin::encode(named, module_key_bin())),
    setting_bin(),
    "a module's setting",
  );
  let reads = members.map(|f: OwnerFacts| f.read);
  // A name a member declares is read as the group's own text writes it; any other owner declaring
  // it, by its own entry.
  let entries = |module: Bytes, n: Bytes|
    if module == key.module {
      declared_of(module, key.shipped, key.tested, n).fold(
        [],
        |acc: List<OwnerInterface>, o: Bytes|
          if key.owners.contains(o) { acc } else {
            let at_o = { module: module, shipped: key.shipped, tested: key.tested, owner: o };
            match match sibling(o) {
                Entire -> owner_interface_of(at_o),
                BySignature -> signature_of(at_o),
                ByGroupResult -> shown_of(at_o),
              } {
              Some(e) -> acc.push(e),
              None -> acc,
            }
          },
      )
    } else { owner_interfaces_of(key.shipped, module, n) };
  let needed = group_needs(
    key.module,
    reads,
    members.fold([], |acc: List<Mention>, f: OwnerFacts| acc.concat(f.mentions)),
    imported,
    entries,
    interface_header_of,
    |module: Bytes, owner: Bytes|
      if !published || module == key.module { [] }
      else { published_for(key.shipped, key.module, module, owner) },
    |n: Bytes| value_call_modules(named, n),
  );
  {
    needed: needed,
    imported: imported,
    places: module_origins_of(key.shipped, needed.keys().filter(|m: Bytes| m != key.module)),
    setting: setting,
    reads: reads,
  }
}

/// Whether `g` names a group its module checks together: a record kept for a group an edit split,
/// merged or emptied is settled without checking it.
pub fn current(g: GroupKey) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      group_key_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

fn group_key_of(o: OwnerKey) -> GroupKey / {memo.read, abort.raise} =
  {
    module: o.module,
    shipped: o.shipped,
    tested: o.tested,
    owners: decoded(
      memo.fetch(group_of_query(), bin::encode(o, owner_key_bin())),
      bin::list_bin(bin::bytes_bin()),
      "an owner's group",
    ),
  }

/// Whether `g` names a unit of its module: owners whose texts mention one another round a cycle.
pub fn current_unit(g: GroupKey) -> Bool / {memo.read, abort.raise} =
  match g.owners {
    [] -> false,
    [o, ..] ->
      unit_key_of({ module: g.module, shipped: g.shipped, tested: g.tested, owner: o }).owners
        == g.owners,
  }

fn unit_key_of(o: OwnerKey) -> GroupKey / {memo.read, abort.raise} =
  {
    module: o.module,
    shipped: o.shipped,
    tested: o.tested,
    owners: decoded(
      memo.fetch(unit_of_query(), bin::encode(o, owner_key_bin())),
      bin::list_bin(bin::bytes_bin()),
      "an owner's unit",
    ),
  }

pub fn group_of(g: GroupKey) -> owner_checks::GroupResult / {memo.read, abort.raise} =
  owner_checks::decode_group(
    decoded(
      memo.fetch(group_query(), bin::encode(g, group_key_bin())),
      owner_checks::encoded_group_bin(),
      "a group's answer",
    ),
  )

/// The entry an owner of a module shows as its group's record keeps it, read as `OwnerKey` says,
/// with no digest of what it reaches: empty for a test, a law, or an owner whose group refuses.
pub fn shown_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  match owner_checks::group_interfaces(
      memo.fetch(group_query(), bin::encode(group_key_of(key), group_key_bin())),
    ).get(
      key.owner,
    ) {
    Some(entry) -> entry,
    None -> b"",
  }
}

/// The entry an owner of a module shows what reads it, read as `OwnerKey` says: empty for a test,
/// a law, or an owner whose group refuses.
pub fn owner_entry_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  let alone = memo.fetch(shown_query(), input);
  if alone.len() == 0 { b"" } else {
    with_reach_digest(
      alone,
      reach_of(key, unit_key_of(key), alone, shown_query(), owner_interface_query()),
    )
  }
}

/// A walk of what an entry reaches: the entries of its own group it reaches, by owner and each
/// encoded, and the digest each other entry it names reaches, or whether a module it names that
/// declares nothing so named declares anything at all.
type ReachSearch = {
  local: Map<Bytes, Bytes>,
  outside: Map<Bytes, Bytes>,
  seen: Map<Bytes, Bool>,
  work: List<Mention>,
}

/// The digest of every entry `alone`, the entry of `key`, reaches through what it mentions, and
/// of where its module stands: those of `g`, the owners it is made with, as the query `inside`
/// shows them, each other one of its module by the `reach` of what `beyond` shows, and another
/// module's by its own. An edit moves it exactly where it moves one of those entries, so a check
/// that reads an entry need not read what the entry reaches.
fn reach_of(
  key: OwnerKey,
  g: GroupKey,
  alone: Bytes,
  inside: Bytes,
  beyond: Bytes,
) -> Bytes / {memo.read, abort.raise} = {
  let walked = iterate(
    {
      local: Map::new().insert(key.owner, alone),
      outside: Map::new(),
      seen: Map::new(),
      work: interface_header(alone).mentions,
    },
    1000000,
    |s: ReachSearch|
      match s.work {
        [] -> Stop(s),
        [m, ..rest] -> if s.seen.contains(mention_key(m)) { Continue({ ..s, work: rest }) } else {
          let at = { ..s, seen: s.seen.insert(mention_key(m), true), work: rest };
          Continue(if m.module == b"" {
            // What its text calls on a value, of each module its own can see.
            {
              ..at,
              work: at.work.concat(
                called_of(value_call_modules(module_key_of(key), m.name).push(key.module), [
                  m.name,
                ]),
              ),
            }
          } else if m.module == key.module {
            declared_of(m.module, key.shipped, key.tested, m.name).fold(
              at,
              |acc: ReachSearch, o: Bytes|
                if acc.local.contains(o) { acc } else if g.owners.contains(o) {
                  let x = memo.fetch(
                    inside,
                    bin::encode(
                      { module: m.module, shipped: key.shipped, tested: key.tested, owner: o },
                      owner_key_bin(),
                    ),
                  );
                  if x.len() == 0 { acc } else {
                    {
                      ..acc,
                      local: acc.local.insert(o, x),
                      work: acc.work.concat(interface_header(x).mentions),
                    }
                  }
                } else {
                  let b = memo.fetch(
                    beyond,
                    bin::encode(
                      { module: m.module, shipped: key.shipped, tested: key.tested, owner: o },
                      owner_key_bin(),
                    ),
                  );
                  if b.len() == 0 { acc }
                  else { { ..acc, outside: acc.outside.insert(o, interface_header(b).reach) } }
                },
            )
          } else {
            let found = owner_interface_bytes_of(key.shipped, m.module, m.name);
            if found.len() == 0 {
              // No function of a type so named there is nothing reached, whatever else it holds.
              if m.name.starts_with(b"::") { at } else {
                let any = owner_interface_bytes_of(key.shipped, m.module, b"").len() > 0;
                {
                  ..at,
                  outside: at.outside.insert(b"there ".concat(m.module), if any { b"1" }
                  else { b"" }),
                }
              }
            } else {
              found.fold(at, |acc: ReachSearch, b: Bytes| {
                let h = interface_header(b);
                {
                  ..acc,
                  outside: acc.outside.insert(
                    Bytes::concat_all([m.module, b".", h.owner]),
                    h.reach,
                  ),
                }
              })
            }
          })
        },
      },
  );
  blake3(
    bin::encode(
      [
        if key.shipped { b"" } else {
          bin::encode(module_origin_of(package_location_of(key.module)), module_origin_bin())
        },
        bin::encode(walked.local, bin::map_bin(bin::bytes_bin(), bin::bytes_bin())),
        bin::encode(walked.outside, bin::map_bin(bin::bytes_bin(), bin::bytes_bin())),
      ],
      bin::list_bin(bin::bytes_bin()),
    ),
  )
}

/// The entry an owner shows what reads it, read as `OwnerKey` says: none for a test, a law, or an
/// owner whose group refuses.
fn signature_of(o: OwnerKey) -> Option<OwnerInterface> / {QueryEffects, abort.raise} =
  match owner_interfaces_once(signature_query(), bin::encode(o, owner_key_bin()), |b: Bytes|
      if b.len() == 0 { [] } else { [decoded(b, owner_interface_bin(), "an entry")] }) {
    [e, ..] -> Some(e),
    [] -> None,
  }

fn shown_of(o: OwnerKey) -> Option<OwnerInterface> / {QueryEffects, abort.raise} =
  match owner_interfaces_once(shown_query(), bin::encode(o, owner_key_bin()), |b: Bytes|
      if b.len() == 0 { [] } else { [decoded(b, owner_interface_bin(), "an entry")] }) {
    [e, ..] -> Some(e),
    [] -> None,
  }

fn owner_interface_of(o: OwnerKey) -> Option<OwnerInterface> / {QueryEffects, abort.raise} =
  match owner_interfaces_once(
      owner_interface_query(),
      bin::encode(o, owner_key_bin()),
      |b: Bytes| if b.len() == 0 { [] } else { [decoded(b, owner_interface_bin(), "an entry")] },
    ) {
    [e, ..] -> Some(e),
    [] -> None,
  }

/// The entries a module shows under a name, each encoded, read as `EntryNamed` says: under every
/// name for none.
pub fn entry_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, interface_key_bin(), "an entry's name");
  bin::encode(
    declared_of(key.module, key.shipped, key.tested, key.name).fold(
      [],
      |acc: List<Bytes>, o: Bytes| {
        let e = memo.fetch(
          owner_interface_query(),
          bin::encode(
            { module: key.module, shipped: key.shipped, tested: key.tested, owner: o },
            owner_key_bin(),
          ),
        );
        if e.len() == 0 { acc } else { acc.push(e) }
      },
    ),
    bin::list_bin(bin::bytes_bin()),
  )
}

/// Each group of `read`, a module's owners, beside the group's name.
fn group_keys(named: ModuleKey, read: OwnersResult) -> List<GroupKey> =
  read.groups.map(|g: List<Bytes>|
    { module: named.module, shipped: named.shipped, tested: named.tested, owners: g })

/// Each owner's facts in `read`, where its items stand in the module among them.
fn facts_of(read: OwnersResult) -> Map<Bytes, OwnerFacts> / {abort.raise} =
  read.owners.fold(
    Map::new(),
    |acc: Map<Bytes, OwnerFacts>, o: { owner: Bytes, facts: Bytes, starts: List<Int> }| {
      let f = decoded(o.facts, owner_facts_bin(), "an owner's facts");
      acc.insert(o.owner, { ..f, read: { ..f.read, starts: o.starts } })
    },
  )

/// What a check of a whole module offered: why it refused, or the answer of each group the store
/// held none of, by its encoded name.
type WholeCheckResult = {
  refused: Option<List<Diag>>,
  results: Map<Bytes, owner_checks::GroupResult>,
}

/// How many groups checked with their module cost what one checked alone does: a group alone reads
/// again, of every entry it reaches, what its module's check reads once.
fn alone_costs() -> Int = 16

/// Whether `missing` of a module's `groups` are checked sooner by one check of the whole module than
/// each alone.
fn whole_pays(missing: Int, groups: Int) -> Bool = missing > 1 && missing * alone_costs() >= groups

/// Offers each group of `read` what a check of the whole module answers of it, where enough of them
/// must be checked again ([`whole_pays`]): a module checked from nothing, or after an edit that
/// moved most of it, is checked once, not a group at a time. Every group is offered its answer, so
/// one an answer made later in the run moves takes it too, and each as `whole`'s, whichever query
/// asked: `whole` reaches this check and nothing else, so a group's answer does not move with how a
/// module is put together. A module whose check refuses offers nothing, since each group of it
/// answers for itself; why it refused is worked out where `explaining` asks, and is empty elsewhere.
fn prefill_from_whole_check(
  named: ModuleKey,
  read: OwnersResult,
  groups: List<GroupKey>,
  explaining: Bool,
) -> WholeCheckResult / {QueryEffects, abort.raise} = {
  // A unit of several owners stands on its cut into groups, which stands on each member's walk.
  let missing = groups.fold(Map::new(), |acc: Map<Bytes, Bool>, g: GroupKey| {
    let at_g = bin::encode(g, group_key_bin());
    if memo.is_cached(if g.owners.len() < 2 { group_query() } else { cycles_query() }, at_g) { acc }
    else { acc.insert(at_g, true) }
  });
  if !whole_pays(missing.len(), groups.len()) { { refused: None, results: Map::new() } } else {
    let facts = facts_of(read);
    let module = named.module;
    let parse = read_once({ name: module, src: read.text });
    let checked = checked_whole(named, read, false, [parse.given]);
    match checked.pulled.out {
      Refused(ds) -> if !explaining { { refused: Some([]), results: Map::new() } } else {
        let why = checked_whole(named, read, true, [parse.given]);
        {
          refused: Some(match why.pulled.out {
            Refused(more) -> more.map(|d: Diag| own_labels(d, why.at)),
            Analysed(_) -> ds.map(|d: Diag| own_labels(d, checked.at)),
          }),
          results: Map::new(),
        }
      },
      Analysed(w) -> {
        let said = owner_checks::module_check_of(w, checked.at, read.text, read: Some(parse.raw));
        let read_of = |o: Bytes|
          match facts.get(o) {
            Some(f) -> f.read,
            None -> panic("a group's owner is the module's"),
          };
        let walked = prefill_inferences(
          named,
          said,
          read.signing,
          groups.filter(|g: GroupKey| g.owners.len() > 1).map(|g: GroupKey| g.owners.map(read_of)),
        );
        // Each unit's groups, cut as `cycles` cuts them from the walks this check offers.
        let cut = groups.fold(
          [],
          |acc: List<{ unit: GroupKey, owners: List<Bytes> }>, unit: GroupKey|
            acc.concat(
              (if unit.owners.len() < 2 { [unit.owners] } else {
                call_cycles(
                  unit.owners,
                  unit.owners.map(|o: Bytes|
                    match walked.get(o) {
                      Some(t) ->
                        called_owners(o, owner_checks::called_names(module, t), |n: Bytes|
                          declared_in(read, n)),
                      None -> [],
                    }),
                )
              }).map(|owners: List<Bytes>| { unit: unit, owners: owners }),
            ),
        );
        let laid = cut.map(|g: { unit: GroupKey, owners: List<Bytes> }| {
          let members = g.owners.map(read_of);
          { members: members, items: item_layout(members) }
        });
        let answers = owner_checks::group_results(said, module, laid, |x: ItemAt| x.to);
        let kept = owner_checks::encode_groups(answers);
        {
          refused: None,
          results: range(0, cut.len()).fold(
            Map::new(),
            |acc: Map<Bytes, owner_checks::GroupResult>, i: Int| {
              let unit = cut.get(i).unit;
              let g = { ..unit, owners: cut.get(i).owners };
              let at_g = bin::encode(g, group_key_bin());
              let answer = answers.get(i);
              memo.provide_as(whole_query(), group_query(), at_g, kept.get(i));
              if unit.owners.len() < 2 {
                prefill_forms(whole_query(), g, laid.get(i).members, answer)
              };
              if missing.contains(bin::encode(unit, group_key_bin())) { acc.insert(at_g, answer) }
              else { acc }
            },
          ),
        }
      },
    }
  }
}

/// Offers each of `signing`, the module's sign units, its signing, and each member of each of
/// `units`, those of several owners, its walk, as the check of their whole module that `said` what
/// it did answers them, and answers the walks by owner: a group's record stands on those, so the
/// first edit to one body walks that owner and no other.
fn prefill_inferences(
  named: ModuleKey,
  said: owner_checks::ModuleCheck,
  is_signature_unit: List<List<Bytes>>,
  units: List<List<OwnerText>>,
) -> Map<Bytes, owner_checks::InferenceResult> / {memo.read, abort.raise} = {
  let members = units.fold([], |acc: List<OwnerText>, u: List<OwnerText>| acc.concat(u));
  let walked = owner_checks::inference_results(said, named.module, members, |x: ItemAt| x.to);
  is_signature_unit.fold((), |_: Unit, s: List<Bytes>|
    memo.provide_as(
      whole_query(),
      signatures_query(),
      bin::encode(
        { module: named.module, shipped: named.shipped, tested: named.tested, owners: s },
        group_key_bin(),
      ),
      bin::encode(owner_checks::signature_check_from(said, s), owner_checks::signature_check_bin()),
    ));
  range(0, members.len()).fold(
    Map::new(),
    |acc: Map<Bytes, owner_checks::InferenceResult>, k: Int| {
      let o = members.get(k).owner;
      memo.provide_as(
        whole_query(),
        typed_query(),
        owner_at(named, o),
        bin::encode(walked.get(k), owner_checks::inference_result_bin()),
      );
      acc.insert(o, walked.get(k))
    },
  )
}

/// What `module` publishes for its owner `owner`, as a check of the module `own`, shipped where
/// `shipped` says, reads it: the functions that answer or take an `opaque` type it declares. Only
/// another module's are followed: a module builds its own `opaque` types, so its check never names
/// them, and two of its groups that refuse would each wait on the other's entry.
fn published_for(
  shipped: Bool,
  own: Bytes,
  module: Bytes,
  owner: Bytes,
) -> List<Mention> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(
      published_query(),
      bin::encode(
        {
          module: module,
          shipped: if module == own { shipped } else { shipped_for(shipped, module) },
          tested: false,
          owner: owner,
        },
        owner_key_bin(),
      ),
    ),
    bin::list_bin(mention_bin()),
    "what a module publishes",
  )

/// `read`, a module read as `named` says, checked whole against the entries it names, with what
/// the modules of `opaque` types it names publish for them where `published` says: what a check
/// that refuses follows to say why.
fn checked_whole(
  named: ModuleKey,
  read: OwnersResult,
  published: Bool,
  // A parse of the module's text, where the caller has one.
  given: List<ParsedSource>,
) -> { pulled: PulledAnalysis, at: Int } / {QueryEffects, abort.raise} = {
  let deps = needed_through(
    |d: Bytes, n: Bytes| owner_interfaces_of(named.shipped, d, n),
    interface_header_of,
    read.wanted,
    read.context.present,
    |module: Bytes, owner: Bytes|
      if !published || module == named.module { [] }
      else { published_for(named.shipped, named.module, module, owner) },
    |n: Bytes| value_call_modules(named, n),
  );
  checked_against(
    { name: named.module, src: read.text },
    read.context.setting.placed,
    deps,
    module_origin_lookup(module_origins_of(named.shipped, deps.keys())),
    {
      let reading = reading_of(read.context.setting);
      { ..reading, given: given.concat(reading.given) }
    },
  )
}

/// `d` with only its labels into the module at `at`, each moved to module 0.
fn own_labels(d: Diag, at: Int) -> Diag =
  {
    ..d,
    labels: d.labels.fold([], |acc: List<Label>, l: Label|
      if l.module == at { acc.push({ ..l, module: 0 }) } else { acc }),
  }

/// What a module answers checked, read as `ModuleKey` says: its groups' answers put together.
pub fn module_answer(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_result_of(named);
  let source = { name: named.module, src: read.text };
  let answer = bin::encode(
    if !read.found { absent(named.module) } else {
      let groups = group_keys(named, read);
      let offered = prefill_from_whole_check(named, read, groups, true);
      let whole = match offered.refused { Some(ds) -> ds, None -> [] };
      // No group's answer is part of a refusal's: a module its whole check refuses asks none.
      if whole.len() > 0 { refused_for(named.module, read, whole) } else {
        let facts = facts_of(read);
        let placed = groups.fold([], |acc: List<owner_checks::PositionedGroup>, unit: GroupKey|
          acc.concat(
            (if unit.owners.len() < 2 { [unit.owners] } else { cycles_of(unit) }).map(
              |owners: List<Bytes>| {
                let g = { ..unit, owners: owners };
                {
                  items: item_layout(
                    owners.map(|o: Bytes|
                      match facts.get(o) {
                        Some(f) -> f.read,
                        None -> panic("a group's owner is the module's"),
                      }),
                  ),
                  // Asked for the module's reads; the whole check's answer is not decoded again.
                  result: {
                    let at_g = bin::encode(g, group_key_bin());
                    match offered.results.get(at_g) {
                      Some(a) -> {
                        memo.fetch(group_query(), at_g);
                        a
                      },
                      None -> group_of(g),
                    }
                  },
                }
              },
            ),
          ));
        let a = owner_checks::assembled(
          named.module,
          read.shape,
          read.order,
          read.filed,
          placed,
          read.context.setting.placed == InRoot
            || (read.context.setting.placed == ShippedModule && read.context.setting.tested),
        );
        let header = decoded(
          memo.fetch(header_query(), input),
          bin::list_bin(diag_bin()),
          "a header's refusals",
        );
        // A module whose text or any group refuses says what a check of it whole says, which names
        // each error once and none another explains.
        let refused = if !read.refusing && a.refused.len() == 0 { header } else {
          let checked = checked_whole(named, read, true, [read_once(source).given]);
          let said = match checked.pulled.out {
            Refused(ds) -> ds.map(|d: Diag| own_labels(d, checked.at)),
            Analysed(_) -> [],
          };
          if said.len() > 0 { said } else { header.concat(a.refused) }
        };
        if refused.len() > 0 { refused_for(named.module, read, refused) } else {
          {
            imports: read.context.present,
            refused: [],
            warnings: a.warnings,
            defs: a.defs,
            tests: a.tests,
            rows: encode_rows(a.rows),
            shape: a.facts.shape,
            tables: encode_tables(a.facts.tables),
          }
        }
      }
    },
    module_result_bin(),
  );
  // Its read, its check whole and its header have read its text.
  decode_cache.evict_text_read(text_key(source));
  answer
}

/// What `module`, read as `read`, answers refused for `refused`: nothing but why, what it imports
/// and the imports it writes.
fn refused_for(
  module: Bytes,
  read: OwnersResult,
  refused: List<Diag>,
) -> ModuleResult / {abort.raise} =
  {
    ..absent(module),
    refused: refused,
    imports: read.context.present,
    shape: { ..no_shape(module), written: read.shape.written },
  }

pub fn header_text_query() -> Bytes = b"header text"

pub fn header_query() -> Bytes = b"header"

/// A module's text up to the end of its last written import, each import that selects no name
/// blanked at the offsets it had, read as `ModuleKey` says: empty for one that selects no name of
/// another, which no check of its imports alone can refuse.
pub fn header_text_answer(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, module_key_bin(), "a module's name");
  match text_of(key) {
    None -> b"",
    Some(src) -> match header_read({ name: key.module, src: src }) {
      None -> b"",
      Some(m) -> {
        let written = m.imports.filter(is_written);
        if !written.fold(false, |b: Bool, d: ImportDecl| b || selecting(d)) { b"" } else {
          blanked(
            src.slice(0, max_of(written.map(|d: ImportDecl| d.span.end))),
            written.filter(|d: ImportDecl| !selecting(d)).map(|d: ImportDecl| d.span),
          )
        }
      },
    },
  }
}

/// What [`header`] makes of `source`'s text, off the tokens a read of it holds where one does.
fn header_read(source: Source) -> Option<Module> / {decode_cache.read, abort.raise} =
  match decode_cache.text_read(text_key(source)) {
    Some(r) -> header_of(r.lexed.input, r.lexed.parser),
    None -> header(source.src),
  }

fn max_of(xs: List<Int>) -> Int = xs.fold(0, |m: Int, x: Int| if x > m { x } else { m })

fn selecting(d: ImportDecl) -> Bool = match d.kind { SelectedNames(_) -> true, _ -> false }

/// The module names more than one of `imports` binds, which their module refuses alone.
fn colliding(imports: List<ImportDecl>) -> Map<Bytes, Bool> / {abort.raise} = {
  let counted = imports.fold(Map::new(), |acc: Map<Bytes, Int>, d: ImportDecl|
    match import_binder(d) {
      Some(b) -> acc.insert(b, match acc.get(b) { Some(n) -> n + 1, None -> 1 }),
      None -> acc,
    });
  counted.fold(Map::new(), |acc: Map<Bytes, Bool>, b: Bytes, n: Int|
    if n > 1 { acc.insert(b, true) } else { acc })
}

/// What a module's imports alone refuse, read as `ModuleKey` says: each name one selects that its
/// module does not declare, and each a second one selects again, at its place. A group of the
/// module writes only the imports it reads, and those of one module merged.
pub fn header_answer(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, module_key_bin(), "a module's name");
  let prefix = memo.fetch(header_text_query(), input);
  bin::encode(
    if prefix.len() == 0 { [] } else {
      let context = context_once(key);
      let selections = range(0, min(context.imports.len(), context.targets.len())).fold(
        [],
        |acc: List<{ module: Bytes, names: List<Bytes> }>, k: Int|
          match context.imports.get(k).kind {
            SelectedNames(ns) ->
              acc.push({ module: context.targets.get(k), names: ns.map(|n: Ident| n.name) }),
            _ -> acc,
          },
      );
      // A name each module there exports, selected once, refuses nothing, so only a header that
      // selects another, or one name twice, is checked; one an edit to a selected definition leaves
      // exported is not checked again.
      let all_exported = selections.fold(
        true,
        |b: Bool, x: { module: Bytes, names: List<Bytes> }|
          b && context.present.contains(x.module)
            && x.names.fold(true, |c: Bool, n: Bytes| c && exported(key.shipped, x.module, n)),
      );
      let selected = selections.fold(
        [],
        |acc: List<Bytes>, x: { module: Bytes, names: List<Bytes> }| acc.concat(x.names),
      );
      if all_exported && selected.len() == selected.unique().len() { [] } else {
        // A check reads a module only through the entries named to it, so each selected module is
        // named with all it exports, which a refusal of a name it does not export lists.
        let exports_of = |m: Bytes|
          if !context.present.contains(m) { [] } else {
            let read = owners_of(
              owners_result_bytes({
                module: m,
                shipped: shipped_for(key.shipped, m),
                tested: false,
              }),
            );
            read.declared.keys().filter(|n: Bytes| exported(key.shipped, m, n))
          };
        let deps = needed_by(
          |d: Bytes, n: Bytes| owner_interfaces_of(key.shipped, d, n),
          selections.fold([], |acc: List<Mention>, x: { module: Bytes, names: List<Bytes> }|
            acc.concat(
              x.names.concat(exports_of(x.module)).map(|n: Bytes| { module: x.module, name: n }),
            )),
          selections.map(|x: { module: Bytes, names: List<Bytes> }| x.module).filter(|m: Bytes|
            context.present.contains(m)),
          |_: Bytes| [],
        );
        let places = module_origins_of(key.shipped, deps.keys());
        let checked = checked_against(
          { name: key.module, src: prefix },
          context.setting.placed,
          deps,
          module_origin_lookup(places),
          reading_of(context.setting),
        );
        match checked.pulled.out {
          Analysed(_) -> [],
          Refused(ds) ->
            ds.map(|d: Diag|
              {
                ..d,
                labels: d.labels.filter(|l: Label| l.module == checked.at).map(|l: Label|
                  { ..l, module: 0 }),
              }),
        }
      }
    },
    bin::list_bin(diag_bin()),
  )
}

pub fn exported_query() -> Bytes = b"exported"

/// Whether a module exports a name, read as `EntryNamed` says: whether an owner declaring it shows
/// it, `pub`, to what imports the module. A constructor of an `opaque` type is shown to none.
pub fn exported_answer(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, interface_key_bin(), "an entry's name");
  let shown = declared_of(key.module, key.shipped, key.tested, key.name).fold(
    false,
    |b: Bool, o: Bytes|
      b
        || (match owner_interface_of({
            module: key.module,
            shipped: key.shipped,
            tested: key.tested,
            owner: o,
          }) {
          Some(e) ->
            e.text.starts_with(b"pub ") && !(o != key.name && e.text.starts_with(b"pub opaque ")),
          None -> false,
        }),
  );
  if shown { b"1" } else { b"" }
}

fn exported(shipped: Bool, module: Bytes, name: Bytes) -> Bool / {memo.read, abort.raise} =
  memo.fetch(
      exported_query(),
      bin::encode(
        { module: module, shipped: shipped_for(shipped, module), tested: false, name: name },
        interface_key_bin(),
      ),
    ).len(
    )
    > 0

/// What hashing fixed of a group of owners, read as `GroupKey` says: their forms filled from what
/// hashing fixed of each node outside the group they reference.
pub fn group_hash_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a group's names");
  if !current_unit(key) {
    bin::encode(
      { entries: Map::new(), fixing: { nodes: [], tests: [], laws: [] } },
      group_hashes_bin(),
    )
  } else {
    let h = group_hash_inputs(key);
    let held = h.fixed.fold(Map::new(), |acc: Map<Bytes, Bool>, f: CachedNode|
      acc.insert(definition_key(f.name, f.decl), true));
    // A node it reads that hashing fixed nothing of, one whose own group refuses, leaves it unhashed,
    // as a load that refuses hashes nothing.
    if h.forms.nodes.fold(false, |b: Bool, x: HashNode|
        b
          || (match x.form {
            None -> !held.contains(definition_key(x.name, x.decl)),
            Some(_) -> false,
          })) {
      bin::encode(
        { entries: Map::new(), fixing: { nodes: [], tests: [], laws: [] } },
        group_hashes_bin(),
      )
    } else {
      let fixing = hash_forms(h.forms, h.fixed);
      bin::encode(
        { entries: hashes_by_owner(key.module, fixing.nodes, h.fns).entries, fixing: fixing },
        group_hashes_bin(),
      )
    }
  }
}

/// What hashing the group `key`, a current one, reads: the forms its check made, what hashing
/// fixed of each node outside it they reference, and the owner of each function its members declare.
pub fn group_hash_inputs(
  key: GroupKey,
) -> { forms: HashInput, fixed: List<CachedNode>, fns: Map<Bytes, Bytes> } / {memo.read, abort.raise} = {
  let g = decoded(
    memo.fetch(group_forms_query(), bin::encode(key, group_key_bin())),
    group_forms_bin(),
    "a group's forms",
  );
  let forms = g.forms;
  let fixed = forms.nodes.fold([], |acc: List<CachedNode>, s: HashNode|
    match s.form {
      Some(_) -> acc,
      None -> {
        let m = named_node(s.name);
        let shipped = if m.module == key.module { key.shipped }
        else { shipped_for(key.shipped, m.module) };
        let tested = if m.module == key.module { key.tested } else { false };
        declared_of(m.module, shipped, tested, m.name).fold(acc, |a: List<CachedNode>, o: Bytes|

          // A member whose group refused has no form here, and its hash is this one: it leaves
          // the unit unhashed.
          if m.module == key.module && key.owners.contains(o) { a } else {
            let e = memo.fetch(
              owner_hash_query(),
              bin::encode(
                { module: m.module, shipped: shipped, tested: tested, owner: o },
                owner_key_bin(),
              ),
            );
            if e.len() == 0 { a }
            else { a.concat(decoded(e, hash_entry_bin(), "a hash entry").fixed) }
          })
      },
    });
  { forms: forms, fixed: fixed, fns: g.fns }
}

pub fn group_forms_query() -> Bytes = b"group forms"

/// What hashing reads of a group of owners: the forms its check made of them, and the owner of each
/// name they declare.
type GroupForms = { forms: HashInput, fns: Map<Bytes, Bytes> }

derive bin for GroupForms

/// What hashing reads of a group of owners, read as `GroupKey` says, which the rest of its answer
/// and its members' text leave be.
pub fn group_forms_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, group_key_bin(), "a group's names");
  let named = { module: key.module, shipped: key.shipped, tested: key.tested };
  if !current_unit(key) {
    bin::encode({ forms: owner_checks::no_group().forms, fns: Map::new() }, group_forms_bin())
  } else if key.owners.len() < 2 {
    let answer = memo.fetch(group_query(), input);
    let reads = key.owners.map(|o: Bytes| owner_facts(named, o).read);
    match memo.provided() {
      Some(o) -> o,
      None ->
        forms_of(
          reads,
          decoded(answer, owner_checks::encoded_group_bin(), "a group's answer").rest,
        ),
    }
  } else {
    formed(
      key.owners.map(|o: Bytes| owner_facts(named, o).read),
      joined_forms(
        cycles_of(key).map(|g: List<Bytes>|
          decoded(
            memo.fetch(group_query(), bin::encode({ ..key, owners: g }, group_key_bin())),
            owner_checks::encoded_group_bin(),
            "a group's answer",
          ).rest.forms),
      ),
    )
  }
}

/// What hashing reads of `a`, the answer of a group whose members read as `reads`.
fn forms_of(reads: List<OwnerText>, a: owner_checks::GroupResult) -> Bytes / {abort.raise} =
  formed(reads, a.forms)

/// What hashing reads of the unit whose members read as `reads` and whose forms are `forms`.
fn formed(reads: List<OwnerText>, forms: HashInput) -> Bytes / {abort.raise} =
  bin::encode(
    {
      forms: forms,
      fns: reads.fold(Map::new(), |acc: Map<Bytes, Bytes>, r: OwnerText|
        r.names.fold(acc, |m: Map<Bytes, Bytes>, n: Bytes| m.insert(n, r.owner))),
    },
    group_forms_bin(),
  )

/// Offers what hashing reads of `a`, the answer of the group `g` whose members read as `reads`,
/// which a run asking it next then takes without decoding the answer again: under the definition
/// of the query `by`, which reaches the check that made `a`.
fn prefill_forms(
  by: Bytes,
  g: GroupKey,
  reads: List<OwnerText>,
  a: owner_checks::GroupResult,
) -> Unit / {memo.read, abort.raise} =
  memo.provide_as(by, group_forms_query(), bin::encode(g, group_key_bin()), forms_of(reads, a))

fn group_hashes_of(g: GroupKey) -> GroupHashes / {memo.read, abort.raise} =
  decoded(
    memo.fetch(group_hash_query(), bin::encode(g, group_key_bin())),
    group_hashes_bin(),
    "a group's hashing",
  )

/// What hashing fixed of an owner of a module, read as `OwnerKey` says: empty for an owner that
/// fixes nothing.
pub fn owner_hash_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let key = decoded(input, owner_key_bin(), "an owner's name");
  match group_hashes_of(unit_key_of(key)).entries.get(key.owner) {
    Some(e) -> bin::encode(e, hash_entry_bin()),
    None -> b"",
  }
}

/// What hashing a module fixed, read as `ModuleKey` says: its groups' hashing put together.
pub fn hashes_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_result_of(named);
  let hashed = group_keys(named, read).map(group_hashes_of);
  let fixing = {
    nodes: hashed.fold([], |acc: List<CachedNode>, h: GroupHashes| acc.concat(h.fixing.nodes)),
    tests: hashed.fold([], |acc: List<CachedTest>, h: GroupHashes| acc.concat(h.fixing.tests)),
    laws: hashed.fold([], |acc: List<CachedLaw>, h: GroupHashes| acc.concat(h.fixing.laws)),
  };
  bin::encode(
    {
      hashes: {
        module: named.module,
        entries: hashed.fold(Map::new(), |acc: Map<Bytes, HashEntry>, h: GroupHashes|
          h.entries.fold(acc, |a: Map<Bytes, HashEntry>, o: Bytes, e: HashEntry| a.insert(o, e))),
      },
      owners: read.declared,
      fixing: fixing,
      record: record_digest(module_record(fixing)),
    },
    hash_result_bin(),
  )
}

pub fn hashes_query() -> Bytes = b"hashes"

pub fn documented_query() -> Bytes = b"documented"

/// The laws of the module `lawful` names that reference each definition, by its program-wide
/// name: what hashing fixed of a law holds what its sentence references, once checked. A law that
/// does not check references nothing.
fn laws_referencing(lawful: ModuleKey) -> Map<Bytes, List<Bytes>> / {memo.read, abort.raise} = {
  let read = owners_result_of(lawful);
  read.owners.fold(
    Map::new(),
    |acc: Map<Bytes, List<Bytes>>, o: { owner: Bytes, facts: Bytes, starts: List<Int> }|
      if !o.owner.starts_with(b"law ") { acc } else {
        let law = o.owner.slice(4, o.owner.len());
        let hashed = group_hashes_of({
          module: lawful.module,
          shipped: lawful.shipped,
          tested: lawful.tested,
          owners: group_holding(read, o.owner),
        });
        hashed.fixing.laws.fold(acc, |by: Map<Bytes, List<Bytes>>, l: CachedLaw|
          l.refs.fold(by, |a: Map<Bytes, List<Bytes>>, r: NodeRef| {
            let held = match a.get(r.name) { Some(laws) -> laws, None -> [] };
            if r.decl || held.contains(law) { a } else { a.insert(r.name, held.push(law)) }
          }))
      },
  )
}

/// What a module documents, read as `ModuleKey` says: a page for it and for each name it declares, read
/// off its whole text and off what its check and its hashing answered. A shipped module that writes
/// a law is read with its tests for what its laws reference, which a module importing it never
/// reads. A module there is none of documents nothing.
pub fn documented_answer(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, module_key_bin(), "a module's name");
  bin::encode(
    match module_read({ ..key, tested: true }) {
      None -> { pages: [] },
      Some(m) -> {
        let checked = decoded(
          memo.fetch(module_query(), input),
          module_result_bin(),
          "a module's answer",
        );
        let hashed = decoded(
          memo.fetch(hashes_query(), input),
          hash_result_bin(),
          "a module's hashing",
        );
        module_pages(m.parsed, m.source.src, {
          defs: tables_of_result(checked).defs,
          hashes: hashed.fixing.nodes.fold(Map::new(), |acc: Map<Bytes, Bytes>, f: CachedNode|
            if f.decl { acc } else { acc.insert(f.name, f.hash) }),
          // Only a module that writes a law is read with its tests for this.
          laws: if m.raw.items.fold(false, |b: Bool, item: Item|
              b || (match item { LawItem(_) -> true, _ -> false })) {
            laws_referencing({ ..key, tested: key.tested || key.shipped })
          } else { Map::new() },
        })
      },
    },
    pages_bin(),
  )
}

pub fn declaring_query() -> Bytes = b"declaring"

/// The shipped modules under the package `input` names that document each simple name, by that
/// name: where a name that leads with no module is looked for without asking every module of the
/// package what it documents.
pub fn declaring_answer(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let shipped = match memo.external(shipped_names_kind(), b"") {
    Some(b) -> decoded(b, bin::list_bin(bin::bytes_bin()), "the shipped modules' names"),
    None -> [],
  };
  let under = input.concat(b".");
  bin::encode(
    shipped.filter(|m: Bytes| m == input || m.starts_with(under)).fold(
      Map::new(),
      |acc: Map<Bytes, List<Bytes>>, m: Bytes|
        decoded(
          memo.fetch(
            documented_query(),
            bin::encode({ module: m, shipped: true, tested: false }, module_key_bin()),
          ),
          pages_bin(),
          "a module's pages",
        ).pages.fold(acc, |by: Map<Bytes, List<Bytes>>, page: Page| {
          let simple = Bytes::of_string(page.simple);
          let held = match by.get(simple) { Some(ms) -> ms, None -> [] };
          if page.simple == "" || held.contains(m) { by } else { by.insert(simple, held.push(m)) }
        }),
    ),
    declaring_bin(),
  )
}

pub fn declaring_bin() -> bin::BinCodec<Map<Bytes, List<Bytes>>> =
  bin::map_bin(bin::bytes_bin(), bin::list_bin(bin::bytes_bin()))

/// Each query a load asks, by its name, beside the definition that answers it, whose hash its records
/// are kept under.
pub fn queries() -> List<{ name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {QueryEffects, abort.raise} }> =
  [
    {
      name: owners_query(),
      definition: b"compiler.front.checking.groups.owners_answer",
      body: owners_answer,
    },
    {
      name: owner_query(),
      definition: b"compiler.front.checking.groups.owner_answer",
      body: owner_answer,
    },
    {
      name: unit_of_query(),
      definition: b"compiler.front.checking.groups.unit_of_answer",
      body: unit_of_answer,
    },
    {
      name: calls_query(),
      definition: b"compiler.front.checking.groups.calls_answer",
      body: calls_answer,
    },
    {
