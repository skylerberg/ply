pub fn context_result(input: Bytes) -> Bytes / {memo.read, memo.write, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  match written_by_owners(named) {
    Some(o) -> o,
    None -> bin::encode(owners_result_of(named).context, context_bin()),
  }
}

pub fn setting_result(input: Bytes) -> Bytes / {memo.read, memo.write, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  match written_by_owners(named) {
    Some(o) -> o,
    None -> bin::encode(owners_result_of(named).context.setting, setting_bin()),
  }
