pub type CodeUnit = | OfGroup(GroupKey) | OfRoot(RootAt) | NoCode

pub type RootAt = { key: RootKey, tested: Bool }

pub type Entries = { roots: List<RootKey>, tested: Bool }

pub type PartMembers = { module: Bytes, label: Bytes, units: List<CodeUnit> }

pub type RootLink = { root: RootName, unit: Bytes, calls: List<RootName> }

pub type UnitFailure = { unit: CodeUnit, reason: Bytes }

pub type Reached = {
  parts: List<PartMembers>,
  roots: List<RootKey>,
  links: List<RootLink>,
  failures: List<UnitFailure>,
}

pub type MadePart = { identity: Bytes, foreign: Map<RootName, Prototype>, codes: List<Bytes> }

pub type PartCode = { part: PartMembers, made: MadePart }

pub type ProgramCode = {
  parts: List<PartCode>,
  roots: List<RootKey>,
  links: List<RootLink>,
  failures: List<UnitFailure>,
}

derive bin for RootAt

derive bin for CodeUnit

derive bin for Entries

derive bin for PartMembers

derive bin for RootLink

derive bin for UnitFailure

derive bin for Reached

derive bin for MadePart

derive bin for PartCode

derive bin for ProgramCode

pub fn code_query() -> QueryOf<CodeUnit, UnitCode> =
  { name: b"code", input: code_unit_bin(), output: unit_code_bin() }

pub fn code_summary_part() -> PartOf<CodeUnit, UnitCode, UnitSummary> =
  { query: code_query(), name: b"summary", output: unit_summary_bin() }

fn code_failure_part() -> PartOf<CodeUnit, UnitCode, Option<Bytes>> =
  { query: code_query(), name: b"failure", output: bin::option_bin(bin::bytes_bin()) }

fn code_root_part() -> KeyedPartOf<CodeUnit, UnitCode, RootName, RootSummary> =
  { query: code_query(), name: b"root", key: root_name_bin(), output: root_summary_bin() }

pub fn module_units_query() -> QueryOf<ModuleKey, List<RootKey>> =
  { name: b"module units", input: module_key_bin(), output: bin::list_bin(root_key_bin()) }

pub fn root_unit_part() -> KeyedPartOf<ModuleKey, List<RootKey>, RootKey, CodeUnit> =
  { query: module_units_query(), name: b"root unit", key: root_key_bin(), output: code_unit_bin() }

fn group_roots_part() -> KeyedPartOf<ModuleKey, List<RootKey>, List<Bytes>, List<RootKey>> =
  {
    query: module_units_query(),
    name: b"group roots",
    key: bin::list_bin(bin::bytes_bin()),
    output: bin::list_bin(root_key_bin()),
  }

fn group_chunk_part() -> KeyedPartOf<ModuleKey, List<RootKey>, List<Bytes>, Bytes> =
  {
    query: module_units_query(),
    name: b"group chunk",
    key: bin::list_bin(bin::bytes_bin()),
    output: bin::bytes_bin(),
  }

fn chunk_groups_part() -> KeyedPartOf<ModuleKey, List<RootKey>, Bytes, List<List<Bytes>>> =
  {
    query: module_units_query(),
    name: b"chunk groups",
    key: bin::bytes_bin(),
    output: bin::list_bin(bin::list_bin(bin::bytes_bin())),
  }

fn stated_part() -> KeyedPartOf<ModuleKey, List<RootKey>, Bytes, Unit> =
  { query: module_units_query(), name: b"stated", key: bin::bytes_bin(), output: bin::unit_bin() }

pub fn unit_calls_query() -> QueryOf<CodeUnit, List<CodeUnit>> =
  { name: b"unit calls", input: code_unit_bin(), output: bin::list_bin(code_unit_bin()) }

pub fn reachable_query() -> QueryOf<Entries, Reached> =
  { name: b"reachable", input: entries_bin(), output: reached_bin() }

pub fn part_query() -> QueryOf<PartMembers, MadePart> =
  { name: b"part", input: part_members_bin(), output: made_part_bin() }

pub fn constant_values_query() -> QueryOf<GroupKey, Unit> =
  { name: b"constant values", input: group_key_bin(), output: bin::unit_bin() }

fn constant_part() -> KeyedPartOf<GroupKey, Unit, Bytes, ConstantData> =
  {
    query: constant_values_query(),
    name: b"constant",
    key: bin::bytes_bin(),
    output: constant_data_bin(),
  }

fn clause_at(name: Bytes, kind: ClauseKind, n: Int) -> RootKey =
  Clause({ definition: Named(name), kind: kind, n: n })

fn clause_roots(name: Bytes, spec: List<SpecKind>) -> List<RootKey> =
  spec.fold(
    { roots: [], requires: 0, ensures: 0 },
    |b: { roots: List<RootKey>, requires: Int, ensures: Int }, kind: SpecKind|
      match kind {
        RequiresClause ->
          {
            ..b,
            roots: b.roots.push(clause_at(name, Requires, b.requires)),
            requires: b.requires + 1,
          },
        EnsuresClause ->
          { ..b, roots: b.roots.push(clause_at(name, Ensures, b.ensures)), ensures: b.ensures + 1 },
        _ -> b,
      },
  ).roots

fn roots_of_item(
  module: Bytes,
  read: OwnersResult,
  into: Map<Bytes, List<RootKey>>,
  item: OutlineItem,
) -> Map<Bytes, List<RootKey>> / {abort.raise} = {
  let added = |owner: Bytes, roots: List<RootKey>|
    if into.contains(owner) { into.update(owner, |rs: List<RootKey>| rs.concat(roots)) }
    else { into.insert(owner, roots) };
  match item {
    OutlinedFunction(f) -> match read.declared.get(f.name) {
      Some([owner, ..]) -> {
        let name = qualify(module, f.name);
        added(owner, [Named(name)].concat(clause_roots(name, f.spec)))
      },
      _ -> into,
    },
    OutlinedTest(t) -> added(b"test ".concat(t.name), test_roots(module, t.name, t.cases)),
    OutlinedLaw(l) ->
      added(
        b"law ".concat(l.name),
        (if l.guarded { [law_key(module, l.name, LawGuard)] } else { [] }).push(
          law_key(module, l.name, LawBody),
        ),
      ),
    _ -> into,
  }
}

fn is_test_root(k: RootKey) -> Bool =
  match k { Test(_) -> true, TestCases(_) -> true, Law(_) -> true, _ -> false }

type RootedGroup = { group: GroupKey, roots: List<RootKey> }

type GroupRoots = { group: GroupKey, roots: List<RootKey>, chunk: Bytes }

type Chunking = { out: List<GroupRoots>, label: Bytes, groups: Int }

const chunk_rule_bits: Int = 4

const fewest_groups_in_a_chunk: Int = 32

const most_groups_in_a_chunk: Int = 256

fn chunked(module: Bytes, groups: List<RootedGroup>) -> List<GroupRoots> =
  groups.fold({ out: [], label: b"", groups: 0 }, |accumulator: Chunking, g: RootedGroup| {
    let first = g.group.owners.at_or(0, b"");
    let picked = root_id(qualify(module, first)) & (1 << chunk_rule_bits) - 1 == 0;
    let opens = accumulator.label == b""
      || (accumulator.groups >= fewest_groups_in_a_chunk && picked)
      || accumulator.groups >= most_groups_in_a_chunk;
    let label = if opens { first } else { accumulator.label };
    {
      out: accumulator.out.push({ group: g.group, roots: g.roots, chunk: label }),
      label: label,
      groups: if opens { 1 } else { accumulator.groups + 1 },
    }
  }).out

fn owner_places(owners: List<Bytes>) -> Map<Bytes, Int> =
  owners.fold(Map::new(), |at: Map<Bytes, Int>, o: Bytes| at.insert(o, at.len()))

fn placed_first(places: Map<Bytes, Int>, g: RootedGroup) -> Int =
  match places.get(g.group.owners.at_or(0, b"")) { Some(i) -> i, None -> 0 }

pub fn list_module_units(named: ModuleKey) -> Written / {memo.read, abort.raise} = {
  let read = owners_result_of(named);
  let by_owner = read.shape.outline.items.fold(
    Map::new(),
    |into: Map<Bytes, List<RootKey>>, item: OutlineItem|
      roots_of_item(named.module, read, into, match item {
        OutlinedLaw(l) -> OutlinedLaw(checked_law_outline(named, l)),
        _ -> item,
      }),
  );
  let places = owner_places(module_owners(named));
  let rooted = module_groups(named).fold(
    [],
    |accumulator: List<RootedGroup>, g: GroupKey| {
      let roots = g.owners.fold([], |rs: List<RootKey>, o: Bytes|
        rs.concat(match by_owner.get(o) { Some(ks) -> ks, None -> [] }));
      if roots.len() == 0 { accumulator } else { accumulator.push({ group: g, roots: roots }) }
    },
  ).sort_by(|a: RootedGroup, b: RootedGroup| placed_first(places, a) <= placed_first(places, b));
  let tests = |g: RootedGroup| g.roots.any(is_test_root);
  let groups = chunked(named.module, rooted.filter(|g: RootedGroup| !tests(g))).concat(
    chunked(named.module, rooted.filter(tests)),
  );
  let chunks = groups.fold(Map::new(), |by: Map<Bytes, List<List<Bytes>>>, g: GroupRoots|
    if by.contains(g.chunk) {
      by.update(g.chunk, |owners: List<List<Bytes>>| owners.push(g.group.owners))
    } else { by.insert(g.chunk, [g.group.owners]) });
  let with_groups = groups.fold(
    written(module_units_query(), groups.flat_map(|g: GroupRoots| g.roots)),
    |w: Written, g: GroupRoots|
      with_keyed_part(
        with_keyed_part(
          g.roots.fold(w, |into: Written, k: RootKey|
            with_keyed_part(into, root_unit_part(), k, OfGroup(g.group))),
          group_roots_part(),
          g.group.owners,
          g.roots,
        ),
        group_chunk_part(),
        g.group.owners,
        g.chunk,
      ),
  );
  read.stated.fold(
    chunks.fold(with_groups, |w: Written, label: Bytes, owners: List<List<Bytes>>|
      with_keyed_part(w, chunk_groups_part(), label, owners)),
    |w: Written, name: Bytes| with_keyed_part(w, stated_part(), name, ()),
  )
}

fn written_unit(k: RootKey, tested: Bool) -> CodeUnit / {memo.read, abort.raise} =
  fetch_keyed_part(root_unit_part(), module_key_in(module_of(k), tested), k).unwrap_or(NoCode)

pub fn unit_of_root(k: RootKey, tested: Bool) -> CodeUnit / {memo.read, abort.raise} =
  match k {
    Specialisation(a, _) -> match a.borrowed.at(0) {
      Some(f) -> unit_of_root(f.owner, tested),
      None -> OfRoot({ key: k, tested: tested }),
    },
    Generated(_, _) -> OfRoot({ key: k, tested: tested }),
    EntryPoint(_) -> OfRoot({ key: k, tested: tested }),
    Clause(c) -> match c.definition {
      Named(_) -> written_unit(k, tested),
      _ -> OfRoot({ key: k, tested: tested }),
    },
    _ -> written_unit(k, tested),
  }

fn group_of_root(k: RootKey, tested: Bool) -> GroupKey / {memo.read, abort.raise} =
  match unit_of_root(k, tested) {
    OfGroup(g) -> g,
    _ -> {
      let named = module_key_in(module_of(k), tested);
      { module: named.module, shipped: named.shipped, tested: named.tested, owners: [] }
    },
  }

fn owner_of_type(named: ModuleKey, ty: Type) -> Option<Bytes> / {memo.read, abort.raise} =
  match ty {
    NamedType(c) -> {
      let module = module_of_name(c.name);
      if module != named.module { None } else {
        declared_of(
          named.module,
          named.shipped,
          named.tested,
          c.name.slice(module.len() + 1, c.name.len()),
        ).at(
          0,
        )
      }
    },
    _ -> None,
  }

fn group_of_type(named: ModuleKey, ty: Type) -> GroupKey / {memo.read, abort.raise} =
  match owner_of_type(named, ty) {
    Some(owner) ->
      group_key_of({
        module: named.module,
        shipped: named.shipped,
        tested: named.tested,
        owner: owner,
      }),
    None -> { module: named.module, shipped: named.shipped, tested: named.tested, owners: [] },
  }

fn program_of_root(k: RootKey, tested: Bool) -> GroupKey / {memo.read, abort.raise} =
  match k {
    Specialisation(a, _) -> group_of_root(Named(a.definition), tested),
    Clause(c) -> program_of_root(c.definition, tested),
    EntryPoint(e) -> program_of_root(e, tested),
    TestCases(t) -> program_of_root(t, tested),
    Generated(w, _) -> group_of_type(module_key_in(module_of(k), tested), w.ty),
    _ -> group_of_root(k, tested),
  }

type ProgramScope = { scope: emit::Scope, input: LoweringInput }

type Lowering = { scopes: Map<Bytes, ProgramScope>, tested: Bool }

pub fn collect_constant_values(group: GroupKey) -> Written / {memo.read, abort.raise} =
  stored_rows(group).definitions.fold(
    written(constant_values_query(), ()),
    |w: Written, r: KnownDefinitionRow|
      match r.value { Some(v) -> with_keyed_part(w, constant_part(), r.name, v), None -> w },
  )

pub fn module_natives_query() -> QueryOf<ModuleKey, List<Extern>> =
  { name: b"module natives", input: module_key_bin(), output: bin::list_bin(extern_bin()) }

fn native_part() -> KeyedPartOf<ModuleKey, List<Extern>, Bytes, Extern> =
  { query: module_natives_query(), name: b"native", key: bin::bytes_bin(), output: extern_bin() }

pub fn list_module_natives(key: ModuleKey) -> Written / {QueryEffects, abort.raise} = {
  let externs = match module_read(key) {
    Some(m) -> module_externs(m.source.name, m.parsed.module),
    None -> [],
  };
  externs.fold_right(written(module_natives_query(), externs), |e: Extern, w: Written|
    with_keyed_part(w, native_part(), e.name, e))
}

fn natives_of(module: Bytes, tested: Bool) -> List<Extern> / {memo.read, abort.raise} =
  fetch(module_natives_query(), module_key_in(module, tested))

fn constant_value(named: Mention, tested: Bool) -> Option<ConstantData> / {memo.read, abort.raise} = {
  let module = module_key_in(named.module, tested);
  let qualified = qualify(named.module, named.name);
  declared_of(named.module, module.shipped, module.tested, named.name).fold(
    None,
    |found: Option<ConstantData>, owner: Bytes|
      match found {
        Some(_) -> found,
        None ->
          fetch_keyed_part(
            constant_part(),
            group_key_of({
              module: named.module,
              shipped: module.shipped,
              tested: module.tested,
              owner: owner,
            }),
            qualified,
          ),
      },
  )
}

fn module_key_of(g: GroupKey) -> ModuleKey =
  { module: g.module, shipped: g.shipped, tested: g.tested }

type StoredGroup = { lowering: GroupLowering, rows: Rows }

fn stored_group(key: GroupKey) -> Option<StoredGroup> / {memo.read, abort.raise} =
  match stored_lowering(key) {
    None -> None,
    Some(l) -> {
      let rows = stored_rows(key);
      Some({
        lowering: l,
        rows: { ..rows, tests: l.tests, types: types_joined(rows.types, l.test_types) },
      })
    },
  }

fn group_input(g: StoredGroup) -> LoweringInput / {abort.raise} =
  lowering_input(g.lowering.roots, g.rows.definitions, g.lowering.laws)

fn unlowered<a>(key: GroupKey, ds: List<Diagnostic>) -> a / {abort.raise} =
  panic(
    String::of_bytes_lossy(
      Bytes::concat_all([
        b"a checked group of `",
        key.module,
        b"` was rejected when it was lowered alone: ",
        emit::diagnostics_text(ds),
      ]),
    ),
  )

fn group_scope(key: GroupKey, roots: List<RootKey>) -> ProgramScope / {QueryEffects, abort.raise} =
  match ((stored_group(key), resolved_group_of(key))) {
    (_, Err(ds)) -> unlowered(key, ds),
    (None, Ok(r)) -> unlowered(key, r.problems),
    (Some(g), Ok(r)) -> if r.problems.len() > 0 { unlowered(key, r.problems) } else {
      {
        scope: emit::scope_over(
          r.modules.map(|m: GroupModule| m.parsed),
          r.resolution,
          true,
          roots,
          g.rows,
          g.lowering.inferred,
        ),
        input: group_input(g),
      }
    },
  }

fn program_scope(
  s: Lowering,
  key: GroupKey,
  roots: List<RootKey>,
) -> { state: Lowering, program: ProgramScope } / {QueryEffects, abort.raise} = {
  let at = bin::encode(key, group_key_bin());
  match s.scopes.get(at) {
    Some(p) -> { state: s, program: p },
    None -> {
      let p = group_scope(key, roots);
      { state: { ..s, scopes: s.scopes.insert(at, p) }, program: p }
    },
  }
}

fn native_read(name: Bytes, tested: Bool) -> Option<Extern> / {memo.read, abort.raise} = {
  let module = module_of_name(name);
  let short = if module.len() == 0 { name } else { name.slice(module.len() + 1, name.len()) };
  fetch_keyed_part(
    native_part(),
    module_key_in(if module.len() == 0 { prelude_module } else { module }, tested),
    short,
  )
}

fn stated_read(name: Bytes, tested: Bool) -> Bool / {memo.read, abort.raise} = {
  let module = module_of_name(name);
  if module.len() == 0 { false } else {
    match fetch_keyed_part(stated_part(), module_key_in(module, tested), name) {
      Some(_) -> true,
      None -> false,
    }
  }
}

pub fn with_code_reads<a | e>(
  tested: Bool,
  body: () -> a / {elsewhere.read, code_facts.read, SessionReads, abort.raise | e},
) -> a / {SessionReads, abort.raise | e} =
  over_full_names(tested, ||
    over_code_facts(
      stored_sources(
        |name: Bytes| {
          let module = module_of_name(name);
          constant_value({ module: module, name: name.slice(module.len() + 1, name.len()) }, tested)
        },
        |name: Bytes| native_read(name, tested),
        |name: Bytes| stated_read(name, tested),
      ),
      body,
    ))

fn natives_here(s: Lowering) -> List<Extern> / {memo.read, abort.raise} =
  s.scopes.values().fold([prelude_module], |modules: List<Bytes>, p: ProgramScope|
    p.scope.modules.map(|m: ParsedModule| m.name).concat(
      p.scope.module_scopes.flat_map(|t: emit::ModuleScope| t.imports.map(|i: Imported| i.module)),
    ).fold(modules, |found: List<Bytes>, m: Bytes|
      if found.contains(m) { found } else { found.push(m) })).fold(
    declared_natives,
    |found: List<Extern>, m: Bytes| found.concat(natives_of(m, s.tested)),
  )

fn failed_unit(reason: Bytes) -> LoweredUnit =
  {
    code: { results: [], requested: [], externs: [] },
    summary: { published: [], needs: Map::new(), called: Map::new() },
    roots: [],
    failure: Some(reason),
  }

fn lowered_or_failed(
  unit: CodeUnit,
  roots: List<RootKey>,
  tested: Bool,
) -> LoweredUnit / {QueryEffects, abort.raise} =
  handle {
    with_code_reads(tested, || lowered_unit(unit, roots, tested))
  } with {
    lowering.fail(reason) -> failed_unit(reason),
  }

type LoweredBatches = { state: Lowering, batches: List<LoweredBatch> }

fn lambda_owners(ks: List<RootKey>) -> List<RootKey> =
  ks.fold([], |accumulator: List<RootKey>, k: RootKey|
    inlined_lambdas(k).fold(accumulator, |a: List<RootKey>, f: InlinedLambda| a.push(f.owner)))

type LentLambdas = { state: Lowering, lent: Map<RootName, Option<BoundLambda>> }

fn asked_of_program(
  accumulator: LoweredBatches,
  at: Bytes,
  ks: List<RootKey>,
  ownership: Map<RootName, OwnershipSignature>,
) -> LoweredBatches / {EmitReads, QueryEffects} = {
  let tested = accumulator.state.tested;
  let key = decoded(at, group_key_bin(), "a unit's program");
  let p = program_scope(accumulator.state, key, ks);
  let lent = lambda_owners(ks).fold(
    { state: p.state, lent: Map::new() },
    |l: LentLambdas, o: RootKey| {
      let q = program_scope(l.state, program_of_root(o, tested), [o]);
      { state: q.state, lent: l.lent.insert(root_name(o), emit::owner_lambdas(q.program.scope, o)) }
    },
  );
  {
    state: lent.state,
    batches: accumulator.batches.push({
      results: emit::root_outputs(p.program.scope, ks, ownership, Some(lent.lent)),
      input: p.program.input,
    }),
  }
}

fn lowered_batches(
  s: Lowering,
  roots: List<RootKey>,
  ownership: Map<RootName, OwnershipSignature>,
) -> LoweredBatches / {EmitReads, QueryEffects} =
  roots.fold(Map::new(), |m: Map<Bytes, List<RootKey>>, k: RootKey| {
    let at = bin::encode(program_of_root(k, s.tested), group_key_bin());
    if m.contains(at) { m.update(at, |ks: List<RootKey>| ks.push(k)) } else { m.insert(at, [k]) }
  }).fold({ state: s, batches: [] }, |accumulator: LoweredBatches, at: Bytes, ks: List<RootKey>|
    asked_of_program(accumulator, at, ks, ownership))

fn has_published_signature(k: RootKey) -> Bool =
  match k { Generated(_, _) -> false, EntryPoint(_) -> false, _ -> true }

fn summary_of(unit: CodeUnit) -> UnitSummary / {memo.read, abort.raise} =
  fetch_part(code_summary_part(), unit)

fn callee_read(
  unit: CodeUnit,
  tested: Bool,
  facts: CalleeFacts,
  k: RootKey,
) -> CalleeFacts / {memo.read, abort.raise} =
  if !has_published_signature(k) || facts.read.contains(root_name(k)) { facts } else {
    let seen = { ..facts, read: facts.read.insert(root_name(k)) };
    let callee = unit_of_root(k, tested);
    if callee == unit || callee == NoCode { seen } else { with_callee(seen, summary_of(callee)) }
  }

fn lowered_unit(
  unit: CodeUnit,
  roots: List<RootKey>,
  tested: Bool,
) -> LoweredUnit / {EmitReads, QueryEffects} =
  unit_lowered(
    roots,
    { scopes: Map::new(), tested: tested },
    |s: Lowering, ks: List<RootKey>, ownership: Map<RootName, OwnershipSignature>|
      lowered_batches(s, ks, ownership),
    |facts: CalleeFacts, ks: List<RootKey>|
      ks.fold(facts, |f: CalleeFacts, k: RootKey| callee_read(unit, tested, f, k)),
    |k: RootKey| inlined_lambdas(k).len() > 0 && unit_of_root(k, tested) == unit,
    natives_here,
  )

fn group_roots(g: GroupKey) -> List<RootKey> / {memo.read, abort.raise} =
  match fetch_keyed_part(group_roots_part(), module_key_of(g), g.owners) {
    Some(roots) -> roots,
    None -> [],
  }

fn tested_of(g: GroupKey) -> Bool = g.shipped && g.tested

pub fn lower_unit(unit: CodeUnit) -> Written / {QueryEffects, abort.raise} = {
  let made = match unit {
    OfGroup(g) -> lowered_or_failed(unit, group_roots(g), tested_of(g)),
    OfRoot(r) -> lowered_or_failed(unit, [r.key], r.tested),
    NoCode -> lowered_or_failed(unit, [], false),
  };
  made.roots.fold(
    with_part(
      with_part(written(code_query(), made.code), code_summary_part(), made.summary),
      code_failure_part(),
      made.failure,
    ),
    |w: Written, r: RootSummary| with_keyed_part(w, code_root_part(), root_name(r.key), r),
  )
}

type ReachWalk = { units: Map<Bytes, CodeUnit>, links: List<RootLink>, failures: List<UnitFailure> }

const copy_buckets: Int = 16

type PartPlace = { module: Bytes, label: Bytes }

fn chunk_of(g: GroupKey) -> Bytes / {memo.read, abort.raise} =
  match fetch_keyed_part(group_chunk_part(), module_key_of(g), g.owners) {
    Some(label) -> label,
    None -> panic("a reached group is missing from the units of its module"),
  }

fn chunk_members(g: GroupKey, label: Bytes) -> List<CodeUnit> / {memo.read, abort.raise} =
  match fetch_keyed_part(chunk_groups_part(), module_key_of(g), label) {
    Some(groups) -> groups.map(|owners: List<Bytes>| OfGroup({ ..g, owners: owners })),
    None -> panic("the chunk of a reached group is missing from the units of its module"),
  }

fn part_place(unit: CodeUnit) -> PartPlace / {memo.read, abort.raise} =
  match unit {
    OfGroup(g) -> { module: g.module, label: chunk_of(g) },
    OfRoot(r) ->
      {
        module: module_of(r.key),
        label: Bytes::of_string(
          "copies " ++ (root_id(root_text(root_name(r.key))) % copy_buckets).to_string(),
        ),
      },
    NoCode -> panic("a unit without code has no part"),
  }

fn part_members(unit: CodeUnit, label: Bytes) -> List<CodeUnit> / {memo.read, abort.raise} =
  match unit { OfGroup(g) -> chunk_members(g, label), _ -> [unit] }

fn root_summary(unit: CodeUnit, k: RootKey) -> Option<RootSummary> / {memo.read, abort.raise} =
  fetch_keyed_part(code_root_part(), unit, root_name(k))

fn roots_called(unit: CodeUnit, k: RootKey) -> List<RootKey> / {memo.read, abort.raise} =
  if unit == NoCode { [] } else {
    match root_summary(unit, k) { Some(r) -> r.calls, None -> [] }
  }

fn with_unit_part(
  parts: Map<Bytes, PartMembers>,
  unit: CodeUnit,
) -> Map<Bytes, PartMembers> / {memo.read, abort.raise} = {
  let place = part_place(unit);
  let key = Bytes::concat_all([place.module, b"\x00", place.label]);
  if !parts.contains(key) {
    parts.insert(key, {
      module: place.module,
      label: place.label,
      units: part_members(unit, place.label),
    })
  } else {
    match unit {
      OfGroup(_) -> parts,
      _ -> parts.update(key, |p: PartMembers| { ..p, units: p.units.push(unit) }),
    }
  }
}

type ReachedRoot = { unit: CodeUnit, calls: List<RootKey> }

fn unit_tested(unit: CodeUnit) -> Bool =
  match unit { OfGroup(g) -> tested_of(g), OfRoot(r) -> r.tested, NoCode -> false }

fn roots_called_before_lowering(unit: CodeUnit) -> List<RootKey> / {memo.read, abort.raise} =
  match unit {
    OfGroup(g) ->
      fetch_part(forms_part(), g).forms.names.fold([], |found: List<RootKey>, named: NodeRef|
        if named.kind == HeldValue { found.push(Named(named.name)) } else { found }),
    OfRoot(r) -> match r.key { EntryPoint(entered) -> [entered], other -> [unspecialised(other)] },
    NoCode -> [],
  }

pub fn list_unit_calls(unit: CodeUnit) -> Written / {memo.read, abort.raise} = {
  let tested = unit_tested(unit);
  written(
    unit_calls_query(),
    roots_called_before_lowering(unit).fold([], |found: List<CodeUnit>, k: RootKey| {
      let callee = unit_of_root(k, tested);
      if callee == unit || callee == NoCode { found } else { found.push_unique(callee) }
    }),
  )
}

type CalledUnit = Visit<CodeUnit, List<CodeUnit>>

fn call_levels(reached: List<CalledUnit>) -> List<List<CodeUnit>> / {abort.raise} = {
  let index = reached.fold(Map::new(), |m: Map<CodeUnit, Int>, v: CalledUnit|
    m.insert(v.key, m.len()));
  let condensed = graph::condensation({
    out: reached.map(|v: CalledUnit|
      v.value.fold([], |out: List<Int>, callee: CodeUnit|
        match index.get(callee) { Some(i) -> out.push(i), None -> out })),
  });
  let heights = condensed.graph.out.fold([], |found: List<Int>, lower: List<Int>|
    found.push(lower.fold(0, |height: Int, below: Int| max(height, found.get(below) + 1))));
  range(0, condensed.members.len()).fold(
    Map::new(),
    |levels: Map<Int, List<CodeUnit>>, component: Int| {
      let height = heights.get(component);
      let members = condensed.members.get(component).map(|n: Int| reached.get(n).key);
      if levels.contains(height) {
        levels.update(height, |units: List<CodeUnit>| units.concat(members))
      } else { levels.insert(height, members) }
    },
  ).values(
  )
}

type Lowered = Map<CodeUnit, Option<Bytes>>

fn lowered_by_level(lowered: Lowered, needed: List<CodeUnit>) -> Lowered / {memo.read, abort.raise} = {
  let reached = traverse(needed, |unit: CodeUnit| {
    let callees = fetch(unit_calls_query(), unit).filter(|c: CodeUnit| !lowered.contains(c));
    { value: callees, next: callees }
  });
  call_levels(reached).fold(lowered, |done: Lowered, level: List<CodeUnit>| {
    let failures = fetch_all_part(code_failure_part(), level);
    range(0, level.len()).fold(done, |found: Lowered, i: Int|
      found.insert(level.get(i), failures.get(i)))
  })
}

type Frontier = { met: Set<RootKey>, roots: List<RootKey> }

fn with_met(frontier: Frontier, root: RootKey) -> Frontier =
  if frontier.met.contains(root) { frontier }
  else { { met: frontier.met.insert(root), roots: frontier.roots.push(root) } }

type ReachRound = { visits: List<Visit<RootKey, ReachedRoot>>, frontier: Frontier, lowered: Lowered }

type PlacedRoot = { key: RootKey, unit: CodeUnit }

type Expanded = { visits: List<Visit<RootKey, ReachedRoot>>, next: Frontier }

fn expanded_root(sofar: Expanded, root: PlacedRoot) -> Expanded / {memo.read, abort.raise} = {
  let calls = roots_called(root.unit, root.key);
  {
    visits: sofar.visits.push({ key: root.key, value: { unit: root.unit, calls: calls } }),
    next: calls.fold(sofar.next, with_met),
  }
}

fn next_round(round: ReachRound, tested: Bool) -> ReachRound / {memo.read, abort.raise} = {
  let placed = round.frontier.roots.map(|k: RootKey| { key: k, unit: unit_of_root(k, tested) });
  let lowered = lowered_by_level(
    round.lowered,
    placed.fold([], |found: List<CodeUnit>, p: PlacedRoot|
      if p.unit == NoCode || round.lowered.contains(p.unit) { found }
      else { found.push_unique(p.unit) }),
  );
  let expanded = placed.fold(
    { visits: round.visits, next: { met: round.frontier.met, roots: [] } },
    expanded_root,
  );
  { visits: expanded.visits, frontier: expanded.next, lowered: lowered }
}

type ReachedWalk = { visits: List<Visit<RootKey, ReachedRoot>>, lowered: Lowered }

fn reached_roots(entries: Entries) -> ReachedWalk / {memo.read, abort.raise} =
  iterate(
    {
      visits: [],
      frontier: entries.roots.fold({ met: Set::empty(), roots: [] }, with_met),
      lowered: Map::new(),
    },
    unlimited_steps,
    |r: ReachRound|
      match r.frontier.roots {
        [] -> Stop({ visits: r.visits, lowered: r.lowered }),
        _ -> Continue(next_round(r, entries.tested)),
      },
  )

pub fn find_reachable_units(entries: Entries) -> Written / {memo.read, abort.raise} = {
  let walk = reached_roots(entries);
  let reached = walk.visits;
  let walked = reached.fold(
    { units: Map::new(), links: [], failures: [] },
    |w: ReachWalk, v: Visit<RootKey, ReachedRoot>| {
      let at = bin::encode(v.value.unit, code_unit_bin());
      {
        ..w,
        units: if v.value.unit == NoCode { w.units } else { w.units.insert(at, v.value.unit) },
        links: w.links.push({
          root: root_name(v.key),
          unit: at,
          calls: v.value.calls.map(root_name),
        }),
        failures: with_failure(w.failures, v.value.unit, walk.lowered),
      }
    },
  );
  let parts = walked.units.fold(Map::new(), |built: Map<Bytes, PartMembers>, _: Bytes, unit: CodeUnit|
    with_unit_part(built, unit)).values();
  lowered_by_level(
    walk.lowered,
    parts.flat_map(|p: PartMembers| p.units).filter(|u: CodeUnit| !walk.lowered.contains(u)),
  );
  written(reachable_query(), {
    parts: parts,
    roots: reached.map(|v: Visit<RootKey, ReachedRoot>| v.key),
    links: walked.links,
    failures: walked.failures,
  })
}

fn with_failure(
  failures: List<UnitFailure>,
  unit: CodeUnit,
  lowered: Lowered,
) -> List<UnitFailure> / {abort.raise} =
  if unit == NoCode { failures } else {
    match lowered.get(unit) {
      Some(Some(reason)) -> if failures.any(|f: UnitFailure| f.unit == unit) { failures }
      else { failures.push({ unit: unit, reason: reason }) },
      Some(None) -> failures,
      None -> panic("a reached unit was not lowered"),
    }
  }

fn unit_code_of(unit: CodeUnit) -> UnitCode / {memo.read, abort.raise} = fetch(code_query(), unit)

fn foreign_head(
  found: Map<RootName, Prototype>,
  k: RootKey,
  tested: Bool,
) -> Map<RootName, Prototype> / {memo.read, abort.raise} = {
  let unit = unit_of_root(k, tested);
  if unit == NoCode { found } else {
    match root_summary(unit, k) {
      Some(r) -> match r.head { Some(h) -> found.insert(root_name(k), h), None -> found },
      None -> found,
    }
  }
}

fn part_tested(part: PartMembers) -> Bool = part.units.any(unit_tested)

pub fn build_part(part: PartMembers) -> Written / {memo.read, abort.raise} = {
  let tested = part_tested(part);
  let codes = codes_of_part(part);
  let own = codes.fold(Set::empty(), |m: Set<RootName>, c: UnitCode|
    c.results.fold(m, |into: Set<RootName>, r: RootOutput|
      r.result.tables.members.map(root_name).fold(
        into.insert(r.name),
        |x: Set<RootName>, n: RootName| x.insert(n),
      )));
  let foreign = codes.fold(Map::new(), |found: Map<RootName, Prototype>, c: UnitCode|
    c.results.fold(found, |f: Map<RootName, Prototype>, r: RootOutput|
      r.result.tables.calls.fold(f, |x: Map<RootName, Prototype>, k: RootKey|
        if own.contains(root_name(k)) || x.contains(root_name(k)) { x }
        else { foreign_head(x, k, tested) })));
  let digests = part.units.map(|u: CodeUnit| fetch_digest(code_query(), u));
  written(part_query(), {
    identity: blake3(
      Bytes::concat_all(digests).concat(
        bin::encode(foreign, bin::map_bin(root_name_bin(), prototype_bin())),
      ),
    ),
    foreign: foreign,
    codes: digests,
  })
}

pub fn code_queries() -> List<CheckDefinition> =
  [
    query_definition(
      module_natives_query(),
      b"compiler.front.checking.units.list_module_natives",
      list_module_natives,
    ),
    product_definition(
      code_query(),
      b"compiler.front.checking.units.lower_unit",
      lower_unit,
      code_products,
    ),
    product_definition(
      module_units_query(),
      b"compiler.front.checking.units.list_module_units",
      list_module_units,
      code_products,
    ),
    product_definition(
      unit_calls_query(),
      b"compiler.front.checking.units.list_unit_calls",
      list_unit_calls,
      code_products,
    ),
    product_definition(
      reachable_query(),
      b"compiler.front.checking.units.find_reachable_units",
      find_reachable_units,
      code_products,
    ),
    product_definition(
      enterable_query(),
      b"compiler.front.checking.units.decide_enterable",
      decide_enterable,
      code_products,
    ),
    product_definition(
      part_query(),
      b"compiler.front.checking.units.build_part",
      build_part,
      code_products,
    ),
    product_definition(
      constant_values_query(),
      b"compiler.front.checking.units.collect_constant_values",
      collect_constant_values,
      code_products,
    ),
  ]

pub fn enterable_query() -> QueryOf<RootAt, Bool> =
  { name: b"enterable", input: root_at_bin(), output: bin::bool_bin() }

pub fn decide_enterable(at: RootAt) -> Written / {QueryEffects, abort.raise} = {
  let key = program_of_root(at.key, at.tested);
  written(enterable_query(), match stored_group(key) {
    None -> false,
    Some(g) -> handle {
      with_code_reads(key.tested, || enters(group_input(g), at.key))
    } with {
      lowering.fail(reason) -> panic(String::of_bytes_lossy(reason)),
    },
  })
}

pub fn root_enters(k: RootKey, tested: Bool) -> Bool / {memo.read, abort.raise} =
  always_enters(k) || fetch(enterable_query(), { key: k, tested: tested })

pub fn roots_of_modules(own: List<Bytes>) -> List<RootKey> / {memo.read, abort.raise} =
  own.flat_map(|module: Bytes| fetch(module_units_query(), module_key_in(module, false)))

pub fn entries_of(roots: List<RootKey>) -> Entries / {memo.read, abort.raise} =
  {
    roots: roots.concat(roots.filter(|k: RootKey| root_enters(k, false)).map(EntryPoint)),
    tested: false,
  }

pub fn program_code(entries: Entries) -> ProgramCode / {memo.read, abort.raise} = {
  let reached = fetch(reachable_query(), entries);
  {
    parts: list::zip(reached.parts, fetch_all(part_query(), reached.parts)).map(
      |p: { first: PartMembers, second: MadePart }| { part: p.first, made: p.second },
    ),
    roots: reached.roots,
    links: reached.links,
    failures: reached.failures,
  }
}

fn unit_digests(code: ProgramCode) -> Map<Bytes, Bytes> / {abort.raise} =
  code.parts.fold(Map::new(), |found: Map<Bytes, Bytes>, p: PartCode|
    range(0, p.part.units.len()).fold(found, |m: Map<Bytes, Bytes>, i: Int|
      m.insert(bin::encode(p.part.units.get(i), code_unit_bin()), p.made.codes.get(i))))

pub fn reached_digests(code: ProgramCode) -> List<Bytes> / {abort.raise} = {
  let digests = unit_digests(code);
  code.links.fold(
    { seen: Set::empty(), found: [] },
    |s: { seen: Set<Bytes>, found: List<Bytes> }, l: RootLink|
      if s.seen.contains(l.unit) { s } else {
        {
          seen: s.seen.insert(l.unit),
          found: match digests.get(l.unit) { Some(d) -> s.found.push(d), None -> s.found },
        }
      },
  ).found
}

pub fn code_failures(code: ProgramCode) -> List<Diagnostic> =
  code.failures.map(|f: UnitFailure| lowering_rejected(f.reason))

pub fn reached_codes(
  code: ProgramCode,
) -> Result<List<UnitCode>, List<Diagnostic>> / {memo.read, abort.raise} =
  match code_failures(code) {
    [] ->
      Ok(
        code.links.map(|l: RootLink| l.unit).unique().fold(
          [],
          |found: List<UnitCode>, at: Bytes| {
            let unit = decoded(at, code_unit_bin(), "a unit of code");
            if unit == NoCode { found } else { found.push(unit_code_of(unit)) }
          },
        ),
      ),
    failed -> Err(failed),
  }

pub fn closure_codes(code: ProgramCode) -> Map<RootName, Bytes> / {abort.raise} = {
  let links = code.links;
  let digests = unit_digests(code);
  let own = links.map(|l: RootLink| match digests.get(l.unit) { Some(d) -> d, None -> b"" });
  let index = range(0, links.len()).fold(Map::new(), |m: Map<RootName, Int>, i: Int|
    m.insert(links.get(i).root, i));
  let edges = links.map(|l: RootLink|
    l.calls.fold([], |found: List<Int>, c: RootName|
      match index.get(c) { Some(j) -> found.push(j), None -> found }));
  let below = graph::components({ out: edges }).fold(
    Map::new(),
    |done: Map<Int, Bytes>, component: List<Int>| {
      let inside = component.fold(Set::empty(), |m: Set<Int>, i: Int| m.insert(i));
      let reached = component.fold([], |found: List<Bytes>, i: Int|
        edges.get(i).fold(found, |a: List<Bytes>, j: Int|
          if inside.contains(j) { a }
          else { match done.get(j) { Some(d) -> a.push(d), None -> a } }));
      let digest = blake3(
        Bytes::concat_all(
          component.map(|i: Int| own.get(i)).sort().unique().concat(reached.sort().unique()),
        ),
      );
      component.fold(done, |m: Map<Int, Bytes>, i: Int| m.insert(i, digest))
    },
  );
  range(0, links.len()).fold(Map::new(), |found: Map<RootName, Bytes>, i: Int|
    found.insert(links.get(i).root, match below.get(i) { Some(d) -> d, None -> b"" }))
}

pub fn codes_of_part(part: PartMembers) -> List<UnitCode> / {memo.read, abort.raise} =
  fetch_all(code_query(), part.units)

pub fn decoded_code(bytes: Bytes) -> UnitCode / {abort.raise} =
  decoded(bytes, unit_code_bin(), "a unit's code")

pub fn encoded_code(code: UnitCode) -> Bytes / {abort.raise} = bin::encode(code, unit_code_bin())

pub fn part_text(
  made: MadePart,
  codes: List<UnitCode>,
  inputs: Map<Bytes, Bytes>,
) -> List<WrittenPart> / {abort.raise} = part_library(codes, made.foreign, inputs).parts

fn linked_program(
  digests: Map<Bytes, Bytes>,
  calls: Map<Bytes, List<Bytes>>,
) -> ProgramCode / {abort.raise} =
  {
    parts: [
      {
        part: {
          module: b"m",
          label: b"",
          units: digests.keys().map(|n: Bytes| OfRoot({ key: Named(n), tested: false })),
        },
        made: { identity: b"", foreign: Map::new(), codes: digests.values() },
      },
    ],
    roots: [],
    links: digests.keys().map(|n: Bytes|
      {
        root: root_name(Named(n)),
        unit: bin::encode(OfRoot({ key: Named(n), tested: false }), code_unit_bin()),
        calls: match calls.get(n) {
          Some(cs) -> cs.map(|c: Bytes| root_name(Named(c))),
          None -> [],
        },
      }),
    failures: [],
  }

test "a root's code digest changes when anything it can call changes, and not otherwise" {
  let calls = Map::new().insert(b"f", [b"g"]).insert(b"g", [b"f"]);
  let digests = |g: Bytes| Map::new().insert(b"f", b"1").insert(b"g", g).insert(b"h", b"3");
  let before = closure_codes(linked_program(digests(b"2"), calls));
  let after = closure_codes(linked_program(digests(b"4"), calls));
  assert(before.get(root_name(Named(b"f"))) != after.get(root_name(Named(b"f"))), None);
  assert_eq(before.get(root_name(Named(b"h"))), after.get(root_name(Named(b"h"))))
}

test "units are lowered in levels where each unit comes after every unit it calls, and the units of a cycle share a level" {
  let unit = |name: Bytes| OfRoot({ key: Named(name), tested: false });
  let called = |name: Bytes, callees: List<Bytes>| { key: unit(name), value: callees.map(unit) };
  let units = [
    called(b"main", [b"f", b"leaf"]),
    called(b"f", [b"g"]),
    called(b"g", [b"f", b"leaf"]),
    called(b"leaf", []),
  ];
  let levels = call_levels(units);
  let level_of = |name: Bytes|
    range(0, levels.len()).filter(|i: Int| levels.get(i).contains(unit(name)));
  assert_eq(levels.flatten().sort(), units.map(|v: CalledUnit| v.key).sort());
  assert_eq(level_of(b"f"), level_of(b"g"));
  assert(level_of(b"leaf").get(0) < level_of(b"f").get(0), None);
  assert(level_of(b"f").get(0) < level_of(b"main").get(0), None)
}
