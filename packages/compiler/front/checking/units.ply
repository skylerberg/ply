pub type CodeUnit = | OfGroup(GroupKey) | OfRoot(RootAt) | NoCode

pub type RootAt = { key: RootKey, tested: Bool }

pub type GroupRoots = { group: GroupKey, roots: List<RootKey>, chunk: Bytes }

pub type ModuleUnits = { groups: List<GroupRoots>, stated: List<Bytes> }

pub type Entries = { roots: List<RootKey>, tested: Bool }

pub type PartMembers = { module: Bytes, label: Bytes, units: List<CodeUnit> }

pub type RootLink = { root: RootName, unit: Bytes, calls: List<RootName> }

pub type Reached = { parts: List<PartMembers>, roots: List<RootKey>, links: List<RootLink> }

pub type MadePart = { identity: Bytes, foreign: Map<RootName, Prototype>, codes: List<Bytes> }

pub type PartCode = { part: PartMembers, made: MadePart }

pub type ProgramCode = { parts: List<PartCode>, roots: List<RootKey>, links: List<RootLink> }

type ProgramKey = { group: GroupKey, also: List<Mention> }

derive bin for RootAt

derive bin for CodeUnit

derive bin for GroupRoots

derive bin for ModuleUnits

derive bin for Entries

derive bin for PartMembers

derive bin for RootLink

derive bin for Reached

derive bin for MadePart

derive bin for PartCode

derive bin for ProgramCode

derive bin for ProgramKey

pub const code_query: Bytes = b"code"

pub const summary_query: Bytes = b"code summary"

pub const module_units_query: Bytes = b"module units"

pub const root_unit_query: Bytes = b"root unit"

pub const reachable_query: Bytes = b"reachable"

pub const part_query: Bytes = b"part"

pub const constant_values_query: Bytes = b"constant values"

fn module_key_in(module: Bytes, tested: Bool) -> ModuleKey / {memo.read, abort.raise} = {
  let shipped = package_location_of(module) == None;
  { module: module, shipped: shipped, tested: shipped && tested }
}

fn clause_at(name: Bytes, kind: ClauseKind, n: Int) -> RootKey =
  Clause({ definition: Named(name), kind: kind, n: n })

fn clause_roots(name: Bytes, spec: List<SpecKind>) -> List<RootKey> =
  spec.fold(
    { roots: [], requires: 0, ensures: 0 },
    |b: { roots: List<RootKey>, requires: Int, ensures: Int }, kind: SpecKind|
      match kind {
        RequiresClause ->
          {
            ..b,
            roots: b.roots.push(clause_at(name, Requires, b.requires)),
            requires: b.requires + 1,
          },
        EnsuresClause ->
          { ..b, roots: b.roots.push(clause_at(name, Ensures, b.ensures)), ensures: b.ensures + 1 },
        _ -> b,
      },
  ).roots

fn roots_of_item(
  module: Bytes,
  read: OwnersResult,
  into: Map<Bytes, List<RootKey>>,
  item: OutlineItem,
) -> Map<Bytes, List<RootKey>> / {abort.raise} = {
  let added = |owner: Bytes, roots: List<RootKey>|
    into.insert(owner, List::concat(match into.get(owner) { Some(rs) -> rs, None -> [] }, roots));
  match item {
    OutlinedFunction(f) -> match read.declared.get(f.name) {
      Some([owner, ..]) -> {
        let name = qualify(module, f.name);
        added(owner, [Named(name)].concat(clause_roots(name, f.spec)))
      },
      _ -> into,
    },
    OutlinedTest(t) -> {
      let run = test_key(module, t.name);
      added(b"test ".concat(t.name), if t.cases { [run, TestCases(run)] } else { [run] })
    },
    OutlinedLaw(l) ->
      added(
        b"law ".concat(l.name),
        (if l.guarded { [law_key(module, l.name, LawGuard)] } else { [] }).push(
          law_key(module, l.name, LawBody),
        ),
      ),
    _ -> into,
  }
}

fn is_test_root(k: RootKey) -> Bool =
  match k { Test(_) -> true, TestCases(_) -> true, Law(_) -> true, _ -> false }

type RootedGroup = { group: GroupKey, roots: List<RootKey> }

type Chunking = { out: List<GroupRoots>, label: Bytes, groups: Int }

const chunk_rule_bits: Int = 4

const fewest_groups_in_a_chunk: Int = 32

const most_groups_in_a_chunk: Int = 256

fn chunked(module: Bytes, groups: List<RootedGroup>) -> List<GroupRoots> =
  groups.fold({ out: [], label: b"", groups: 0 }, |accumulator: Chunking, g: RootedGroup| {
    let first = g.group.owners.at_or(0, b"");
    let picked = root_id(qualify(module, first)) & (1 << chunk_rule_bits) - 1 == 0;
    let opens = accumulator.label == b""
      || (accumulator.groups >= fewest_groups_in_a_chunk && picked)
      || accumulator.groups >= most_groups_in_a_chunk;
    let label = if opens { first } else { accumulator.label };
    {
      out: accumulator.out.push({ group: g.group, roots: g.roots, chunk: label }),
      label: label,
      groups: if opens { 1 } else { accumulator.groups + 1 },
    }
  }).out

fn owner_places(read: OwnersResult) -> Map<Bytes, Int> =
  read.owners.fold(Map::new(), |at: Map<Bytes, Int>, o: Bytes| at.insert(o, at.len()))

fn placed_first(places: Map<Bytes, Int>, g: RootedGroup) -> Int =
  match places.get(g.group.owners.at_or(0, b"")) { Some(i) -> i, None -> 0 }

pub fn module_units_result(input: Bytes) -> Bytes / {memo.read, memo.write, abort.raise} = {
  let named = decoded(input, module_key_bin(), "a module's name");
  let read = owners_result_of(named);
  let by_owner = read.shape.outline.items.fold(
    Map::new(),
    |into: Map<Bytes, List<RootKey>>, item: OutlineItem|
      roots_of_item(named.module, read, into, item),
  );
  let places = owner_places(read);
  let rooted = module_groups(named, read).fold(
    [],
    |accumulator: List<RootedGroup>, g: GroupKey| {
      let roots = g.owners.fold([], |rs: List<RootKey>, o: Bytes|
        rs.concat(match by_owner.get(o) { Some(ks) -> ks, None -> [] }));
      if roots.len() == 0 { accumulator } else { accumulator.push({ group: g, roots: roots }) }
    },
  ).sort_by(|a: RootedGroup, b: RootedGroup| placed_first(places, a) <= placed_first(places, b));
  let tests = |g: RootedGroup| g.roots.any(is_test_root);
  let groups = chunked(named.module, rooted.filter(|g: RootedGroup| !tests(g))).concat(
    chunked(named.module, rooted.filter(tests)),
  );
  groups.fold((), |_: Unit, g: GroupRoots|
    g.roots.fold((), |_: Unit, k: RootKey|
      memo.provide(
        root_unit_query,
        bin::encode({ key: k, tested: named.tested }, root_at_bin()),
        bin::encode(OfGroup(g.group), code_unit_bin()),
      )));
  bin::encode({ groups: groups, stated: read.stated }, module_units_bin())
}

pub fn root_unit_result(input: Bytes) -> Bytes / {memo.read, memo.write, abort.raise} = {
  let at = decoded(input, root_at_bin(), "a root's key");
  let named = module_key_in(module_of(at.key), at.tested);
  match memo.written_by(module_units_query, bin::encode(named, module_key_bin())) {
    Some(o) -> o,
    None -> bin::encode(NoCode, code_unit_bin()),
  }
}

fn module_units_of(named: ModuleKey) -> ModuleUnits / {memo.read, abort.raise} =
  decoded(
    memo.fetch(module_units_query, bin::encode(named, module_key_bin())),
    module_units_bin(),
    "a module's units",
  )

fn written_unit(k: RootKey, tested: Bool) -> CodeUnit / {memo.read, abort.raise} = {
  let named = module_key_in(module_of(k), tested);
  decoded(
    memo.fetch(root_unit_query, bin::encode({ key: k, tested: named.tested }, root_at_bin())),
    code_unit_bin(),
    "a root's unit",
  )
}

pub fn unit_of_root(k: RootKey, tested: Bool) -> CodeUnit / {memo.read, abort.raise} =
  match k {
    Specialisation(a, _) -> match a.borrowed.at(0) {
      Some(f) -> unit_of_root(f.owner, tested),
      None -> OfRoot({ key: k, tested: tested }),
    },
    Generated(_, _) -> OfRoot({ key: k, tested: tested }),
    EntryPoint(_) -> OfRoot({ key: k, tested: tested }),
    Clause(c) -> match c.definition {
      Named(_) -> written_unit(k, tested),
      _ -> OfRoot({ key: k, tested: tested }),
    },
    _ -> written_unit(k, tested),
  }

fn named_mention(accumulator: List<Mention>, name: Bytes) -> List<Mention> / {abort.raise} = {
  let module = module_of_name(name);
  if module.len() == 0 { accumulator }
  else { accumulator.push({ module: module, name: name.slice(module.len() + 1, name.len()) }) }
}

fn type_mentions(k: RootKey) -> List<Mention> / {abort.raise} =
  types_keyed(k).fold([], |accumulator: List<Mention>, t: Type|
    type_names(t).fold(accumulator, named_mention))

fn generated_mentions(k: RootKey) -> List<Mention> =
  match k {
    Generated(w, _) ->
      emitted_code.calls.map(|n: Bytes| { module: prelude_module, name: n }).concat(
        match w.operation {
          Reflect -> [{ module: b"std.value", name: b"Value" }],
          Show -> [{ module: b"std.value", name: b"Value" }],
          _ -> [],
        },
      ),
    _ -> [],
  }

const host_mentions: List<Mention> =
  prelude_hosts.map(|h: { effect: Bytes, module: Bytes, by: Bytes }|
    { module: h.module, name: h.by })

fn group_of_root(k: RootKey, tested: Bool) -> GroupKey / {memo.read, abort.raise} =
  match unit_of_root(k, tested) {
    OfGroup(g) -> g,
    _ -> {
      let named = module_key_in(module_of(k), tested);
      { module: named.module, shipped: named.shipped, tested: named.tested, owners: [] }
    },
  }

fn program_of_root(k: RootKey, tested: Bool) -> ProgramKey / {memo.read, abort.raise} =
  match k {
    Specialisation(a, _) ->
      { group: group_of_root(Named(a.definition), tested), also: type_mentions(k) },
    Clause(c) -> {
      let p = program_of_root(c.definition, tested);
      { ..p, also: p.also.concat(type_mentions(k)) }
    },
    EntryPoint(e) -> {
      let p = program_of_root(e, tested);
      { ..p, also: p.also.concat(host_mentions) }
    },
    TestCases(t) -> program_of_root(t, tested),
    Generated(_, _) -> {
      let named = module_key_in(module_of(k), tested);
      {
        group: { module: named.module, shipped: named.shipped, tested: named.tested, owners: [] },
        also: type_mentions(k).concat(generated_mentions(k)),
      }
    },
    _ -> { group: group_of_root(k, tested), also: [] },
  }

type ProgramScope = { scope: emit::Scope, batch: LoweredBatch }

type Lowering = {
  scopes: Map<Bytes, ProgramScope>,
  values: Map<Bytes, Map<Bytes, ConstantData>>,
  tested: Bool,
}

fn constant_values_bin() -> bin::BinCodec<Map<Bytes, ConstantData>> =
  bin::map_bin(bin::bytes_bin(), constant_data_bin())

pub fn constant_values_result(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  bin::encode(
    group_of(group_key_of(decoded(input, owner_key_bin(), "an owner's name"))).members.fold(
      Map::new(),
      |m: Map<Bytes, ConstantData>, x: MemberResult|
        x.result.rows.definitions.fold(
          m,
          |into: Map<Bytes, ConstantData>, r: KnownDefinitionRow|
            match r.value { Some(v) -> into.insert(r.name, v), None -> into },
        ),
    ),
    constant_values_bin(),
  )

fn constants_needed(
  needed: Map<Bytes, Map<Bytes, OwnerInterface>>,
  tested: Bool,
) -> Map<Bytes, ConstantData> / {memo.read, abort.raise} =
  needed.fold(
    Map::new(),
    |found: Map<Bytes, ConstantData>, module: Bytes, owners: Map<Bytes, OwnerInterface>|
      owners.fold(found, |f: Map<Bytes, ConstantData>, owner: Bytes, _: OwnerInterface| {
        let named = module_key_in(module, tested);
        decoded(
          memo.fetch(
            constant_values_query,
            bin::encode(
              { module: module, shipped: named.shipped, tested: named.tested, owner: owner },
              owner_key_bin(),
            ),
          ),
          constant_values_bin(),
          "a constant's value",
        ).fold(f, |m: Map<Bytes, ConstantData>, n: Bytes, v: ConstantData| m.insert(n, v))
      }),
  )

fn program_read(s: Lowering, key: ProgramKey) -> Lowering / {QueryEffects, abort.raise} = {
  let at = bin::encode(key, program_key_bin());
  if s.values.contains(at) { s } else {
    let needed = group_program_read(key.group, key.also);
    module_units_of(module_key_of(key.group));
    { ..s, values: s.values.insert(at, constants_needed(needed, s.tested)) }
  }
}

fn module_key_of(g: GroupKey) -> ModuleKey =
  { module: g.module, shipped: g.shipped, tested: g.tested }

fn rows_with_constants(rows: Rows, values: Map<Bytes, ConstantData>) -> Rows =
  {
    ..rows,
    definitions: rows.definitions.map(|r: KnownDefinitionRow|
      match values.get(r.name) { Some(v) -> { ..r, value: Some(v) }, None -> r }),
  }

fn constructors_known(
  key: ProgramKey,
  roots: List<RootKey>,
  tested: Bool,
) -> KnownConstructors / {memo.read, abort.raise} =
  joined_constructors(
    key.also.map(|m: Mention| m.module).concat(lambda_owners(roots).map(module_of)).unique().filter(
      |m: Bytes| m.len() > 0 && m != key.group.module,
    ).map(|m: Bytes| constructors_reached_from(module_key_in(m, tested))).push(
      constructors_reached_from(module_key_of(key.group)),
    ),
  )

fn program_scope(
  s: Lowering,
  key: ProgramKey,
  roots: List<RootKey>,
) -> { state: Lowering, program: ProgramScope } / {QueryEffects, abort.raise} = {
  let at = bin::encode(key, program_key_bin());
  match s.scopes.get(at) {
    Some(p) -> { state: s, program: p },
    None -> {
      let program = group_program(key.group, key.also);
      match program.check.out.pulled.out {
        Rejected(ds) ->
          panic(
            String::of_bytes_lossy(
              Bytes::concat_all([
                b"a checked group of `",
                key.group.module,
                b"` was rejected when it was lowered alone: ",
                emit::diagnostics_text(ds),
              ]),
            ),
          ),
        Analysed(a) -> {
          let known = constructors_known(key, roots, s.tested);
          let dump = with_known_constructors(dump_of(Analysed(a)), known);
          let batch = program_batch(
            dump,
            [],
            module_units_of(module_key_of(key.group)).stated,
            [],
            released_by: known.released,
          );
          let scope = emit::scope_over(
            a.modules,
            a.r,
            batch.constructors,
            true,
            roots,
            rows_with_constants(
              { ..dump.rows, types: program.types.fold(dump.rows.types, types_joined) },
              match s.values.get(at) { Some(v) -> v, None -> Map::new() },
            ),
            dump.effects,
            dump.inferred_facts,
          );
          let p = { scope: scope, batch: { ..batch, natives: scope.natives } };
          { state: { ..s, scopes: s.scopes.insert(at, p) }, program: p }
        },
      }
    },
  }
}

fn agrees_with(ownership: Map<RootName, OwnershipSignature>, a: Output) -> Bool =
  signatures_from(a.tables.assumed).fold(true, |same: Bool, n: RootName, h: OwnershipSignature|
    same && (match ownership.get(n) { Some(given) -> given == h, None -> true }))

fn whole_batch(
  ks: List<RootKey>,
  ownership: Map<RootName, OwnershipSignature>,
) -> Option<LoweredBatch> / {decode_cache.read} =
  match decode_cache.whole_lowering() {
    None -> None,
    Some(whole) -> {
      let found = ks.fold([], |accumulator: List<RootOutput>, k: RootKey|
        match whole.results.get(root_name(k)) {
          Some(a) -> if agrees_with(ownership, a) {
            accumulator.push({ name: root_name(k), result: a })
          } else { accumulator },
          None -> accumulator,
        });
      if found.len() < ks.len() { None } else {
        Some({
          results: found,
          constructors: whole.constructors,
          program: whole.program,
          natives: whole.natives,
        })
      }
    },
  }

type Asked = { state: Lowering, batches: List<LoweredBatch> }

fn lambda_owners(ks: List<RootKey>) -> List<RootKey> =
  ks.fold([], |accumulator: List<RootKey>, k: RootKey|
    inlined_lambdas(k).fold(accumulator, |a: List<RootKey>, f: InlinedLambda| a.push(f.owner)))

type LentLambdas = { state: Lowering, lent: Map<RootName, Option<BoundLambda>> }

fn asked_of_program(
  accumulator: Asked,
  at: Bytes,
  ks: List<RootKey>,
  ownership: Map<RootName, OwnershipSignature>,
) -> Asked / {QueryEffects, abort.raise} = {
  let tested = accumulator.state.tested;
  let key = decoded(at, program_key_bin(), "a unit's program");
  let owners = lambda_owners(ks);
  let read = owners.fold(program_read(accumulator.state, key), |s: Lowering, o: RootKey|
    program_read(s, program_of_root(o, tested)));
  match whole_batch(ks, ownership) {
    Some(b) -> { state: read, batches: accumulator.batches.push(b) },
    None -> {
      let p = program_scope(read, key, ks);
      let lent = owners.fold({ state: p.state, lent: Map::new() }, |l: LentLambdas, o: RootKey| {
        let q = program_scope(l.state, program_of_root(o, tested), [o]);
        {
          state: q.state,
          lent: l.lent.insert(root_name(o), emit::owner_lambdas(q.program.scope, o)),
        }
      });
      {
        state: lent.state,
        batches: accumulator.batches.push({
          ..p.program.batch,
          results: emit::root_outputs(p.program.scope, ks, ownership, Some(lent.lent)),
        }),
      }
    },
  }
}

fn lowered_batches(
  s: Lowering,
  roots: List<RootKey>,
  ownership: Map<RootName, OwnershipSignature>,
) -> Asked / {QueryEffects, abort.raise} =
  roots.fold(Map::new(), |m: Map<Bytes, List<RootKey>>, k: RootKey| {
    let at = bin::encode(program_of_root(k, s.tested), program_key_bin());
    m.insert(at, List::push(match m.get(at) { Some(ks) -> ks, None -> [] }, k))
  }).fold({ state: s, batches: [] }, |accumulator: Asked, at: Bytes, ks: List<RootKey>|
    asked_of_program(accumulator, at, ks, ownership))

fn has_published_signature(k: RootKey) -> Bool =
  match k { Generated(_, _) -> false, EntryPoint(_) -> false, _ -> true }

fn summary_of(unit: CodeUnit) -> UnitSummary / {memo.read, abort.raise} =
  decoded(
    memo.fetch(summary_query, bin::encode(unit, code_unit_bin())),
    unit_summary_bin(),
    "a unit's summary",
  )

fn callee_read(
  unit: CodeUnit,
  tested: Bool,
  facts: CalleeFacts,
  k: RootKey,
) -> CalleeFacts / {memo.read, abort.raise} =
  if !has_published_signature(k) || facts.read.contains(root_name(k)) { facts } else {
    let seen = { ..facts, read: facts.read.insert(root_name(k), true) };
    let callee = unit_of_root(k, tested);
    if callee == unit || callee == NoCode { seen } else { with_callee(seen, summary_of(callee)) }
  }

fn lowered_unit(
  unit: CodeUnit,
  roots: List<RootKey>,
  tested: Bool,
) -> LoweredUnit / {QueryEffects, abort.raise} =
  unit_lowered(
    roots,
    { scopes: Map::new(), values: Map::new(), tested: tested },
    |s: Lowering, ks: List<RootKey>, ownership: Map<RootName, OwnershipSignature>|
      lowered_batches(s, ks, ownership),
    |facts: CalleeFacts, ks: List<RootKey>|
      ks.fold(facts, |f: CalleeFacts, k: RootKey| callee_read(unit, tested, f, k)),
    |k: RootKey| inlined_lambdas(k).len() > 0 && unit_of_root(k, tested) == unit,
  )

fn group_roots(g: GroupKey) -> List<RootKey> / {memo.read, abort.raise} =
  module_units_of(module_key_of(g)).groups.fold([], |accumulator: List<RootKey>, x: GroupRoots|
    if x.group.owners == g.owners { x.roots } else { accumulator })

fn tested_of(g: GroupKey) -> Bool = g.shipped && g.tested

pub fn code_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let unit = decoded(input, code_unit_bin(), "a unit of code");
  let made = match unit {
    OfGroup(g) -> lowered_unit(unit, group_roots(g), tested_of(g)),
    OfRoot(r) -> lowered_unit(unit, [r.key], r.tested),
    NoCode -> lowered_unit(unit, [], false),
  };
  memo.provide(summary_query, input, bin::encode(made.summary, unit_summary_bin()));
  bin::encode(made.code, unit_code_bin())
}

pub fn summary_result(input: Bytes) -> Bytes / {memo.write, abort.raise} =
  match memo.written_by(code_query, input) {
    Some(o) -> o,
    None -> panic("a unit of code published no summary"),
  }

type ReachWalk = {
  work: List<RootKey>,
  next: Int,
  seen: Map<RootName, Bool>,
  units: Map<Bytes, CodeUnit>,
  modules: Map<Bytes, ModuleUnits>,
  links: List<RootLink>,
}

const copy_buckets: Int = 16

fn part_at(
  w: ReachWalk,
  unit: CodeUnit,
) -> { walk: ReachWalk, part: { module: Bytes, label: Bytes } } / {memo.read, abort.raise} =
  match unit {
    OfGroup(g) -> {
      let m = match w.modules.get(g.module) {
        Some(x) -> x,
        None -> module_units_of(module_key_of(g)),
      };
      {
        walk: { ..w, modules: w.modules.insert(g.module, m) },
        part: {
          module: g.module,
          label: m.groups.fold(b"", |found: Bytes, x: GroupRoots|
            if x.group.owners == g.owners { x.chunk } else { found }),
        },
      }
    },
    OfRoot(r) ->
      {
        walk: w,
        part: {
          module: module_of(r.key),
          label: Bytes::of_string(
            "copies " ++ (root_id(root_text(root_name(r.key))) % copy_buckets).to_string(),
          ),
        },
      },
    NoCode -> { walk: w, part: { module: b"", label: b"" } },
  }

fn roots_called(summary: UnitSummary, k: RootKey) -> List<RootKey> =
  match summary.roots.find(|r: RootSummary| root_name(r.key) == root_name(k)) {
    Some(r) -> r.calls,
    None -> [],
  }

type PartsBuilt = { walk: ReachWalk, parts: Map<Bytes, PartMembers> }

fn with_part(
  built: PartsBuilt,
  at: Bytes,
  unit: CodeUnit,
) -> PartsBuilt / {memo.read, abort.raise} = {
  let placed = part_at(built.walk, unit);
  let key = Bytes::concat_all([placed.part.module, b"\x00", placed.part.label]);
  let had = match built.parts.get(key) {
    Some(p) -> p,
    None -> { module: placed.part.module, label: placed.part.label, units: [] },
  };
  { walk: placed.walk, parts: built.parts.insert(key, { ..had, units: had.units.push(unit) }) }
}

pub fn reachable_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let entries = decoded(input, entries_bin(), "a program's entries");
  let walked = iterate(
    {
      work: entries.roots,
      next: 0,
      seen: Map::new(),
      units: Map::new(),
      modules: Map::new(),
      links: [],
    },
    1099511627776,
    |w: ReachWalk|
      match w.work.at(w.next) {
        None -> Stop(w),
        Some(k) -> if w.seen.contains(root_name(k)) { Continue({ ..w, next: w.next + 1 }) } else {
          let unit = unit_of_root(k, entries.tested);
          let at = bin::encode(unit, code_unit_bin());
          let calls = if unit == NoCode { [] } else { roots_called(summary_of(unit), k) };
          Continue({
            ..w,
            next: w.next + 1,
            seen: w.seen.insert(root_name(k), true),
            units: if unit == NoCode { w.units } else { w.units.insert(at, unit) },
            work: calls.fold(w.work, |all: List<RootKey>, c: RootKey| all.push(c)),
            links: w.links.push({ root: root_name(k), unit: at, calls: calls.map(root_name) }),
          })
        },
      },
  );
  let built = walked.units.fold(
    { walk: walked, parts: Map::new() },
    |b: PartsBuilt, at: Bytes, unit: CodeUnit| with_part(b, at, unit),
  );
  bin::encode(
    { parts: built.parts.values(), roots: walked.work.unique(), links: walked.links },
    reached_bin(),
  )
}

fn unit_code_of(unit: CodeUnit) -> UnitCode / {memo.read, abort.raise} =
  decoded(
    memo.fetch(code_query, bin::encode(unit, code_unit_bin())),
    unit_code_bin(),
    "a unit's code",
  )

fn foreign_head(
  found: Map<RootName, Prototype>,
  k: RootKey,
  tested: Bool,
) -> Map<RootName, Prototype> / {memo.read, abort.raise} = {
  let unit = unit_of_root(k, tested);
  if unit == NoCode { found } else {
    match summary_of(unit).roots.find(|r: RootSummary| root_name(r.key) == root_name(k)) {
      Some(r) -> match r.head { Some(h) -> found.insert(root_name(k), h), None -> found },
      None -> found,
    }
  }
}

fn part_tested(part: PartMembers) -> Bool =
  part.units.fold(false, |any: Bool, u: CodeUnit|
    any || (match u { OfGroup(g) -> tested_of(g), OfRoot(r) -> r.tested, NoCode -> false }))

pub fn part_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let part = decoded(input, part_members_bin(), "a part's members");
  let tested = part_tested(part);
  let codes = part.units.map(unit_code_of);
  let own = codes.fold(Map::new(), |m: Map<RootName, Bool>, c: UnitCode|
    c.results.fold(m, |into: Map<RootName, Bool>, r: RootOutput|
      r.result.tables.members.map(root_name).fold(
        into.insert(r.name, true),
        |x: Map<RootName, Bool>, n: RootName| x.insert(n, true),
      )));
  let foreign = codes.fold(Map::new(), |found: Map<RootName, Prototype>, c: UnitCode|
    c.results.fold(found, |f: Map<RootName, Prototype>, r: RootOutput|
      r.result.tables.calls.fold(f, |x: Map<RootName, Prototype>, k: RootKey|
        if own.contains(root_name(k)) || x.contains(root_name(k)) { x }
        else { foreign_head(x, k, tested) })));
  let digests = part.units.map(|u: CodeUnit|
    memo.output_digest(code_query, bin::encode(u, code_unit_bin())));
  bin::encode(
    {
      identity: blake3(
        Bytes::concat_all(digests).concat(
          bin::encode(foreign, bin::map_bin(root_name_bin(), prototype_bin())),
        ),
      ),
      foreign: foreign,
      codes: digests,
    },
    made_part_bin(),
  )
}

pub fn code_queries() -> List<{ name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {QueryEffects, abort.raise} }> =
  [
    {
      name: code_query,
      definition: b"compiler.front.checking.units.code_result",
      body: code_result,
    },
    {
      name: summary_query,
      definition: b"compiler.front.checking.units.summary_result",
      body: summary_result,
    },
    {
      name: module_units_query,
      definition: b"compiler.front.checking.units.module_units_result",
      body: module_units_result,
    },
    {
      name: root_unit_query,
      definition: b"compiler.front.checking.units.root_unit_result",
      body: root_unit_result,
    },
    {
      name: reachable_query,
      definition: b"compiler.front.checking.units.reachable_result",
      body: reachable_result,
    },
    {
      name: enterable_query,
      definition: b"compiler.front.checking.units.enterable_result",
      body: enterable_result,
    },
    {
      name: part_query,
      definition: b"compiler.front.checking.units.part_result",
      body: part_result,
    },
    {
      name: constant_values_query,
      definition: b"compiler.front.checking.units.constant_values_result",
      body: constant_values_result,
    },
  ]

pub const code_product_queries: List<Bytes> =
  [
    code_query,
    summary_query,
    module_units_query,
    root_unit_query,
    reachable_query,
    part_query,
    constant_values_query,
    enterable_query,
  ]

pub const enterable_query: Bytes = b"enterable"

pub fn enterable_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let at = decoded(input, root_at_bin(), "a root's key");
  let key = program_of_root(at.key, at.tested);
  group_program_read(key.group, key.also);
  let program = group_program(key.group, key.also);
  bin::encode(
    match program.check.out.pulled.out {
      Rejected(_) -> false,
      Analysed(a) -> enters(dump_of(Analysed(a)), at.key),
    },
    bin::bool_bin(),
  )
}

pub fn root_enters(k: RootKey, tested: Bool) -> Bool / {memo.read, abort.raise} =
  always_enters(k)
    || decoded(
      memo.fetch(enterable_query, bin::encode({ key: k, tested: tested }, root_at_bin())),
      bin::bool_bin(),
      "whether a root can be entered",
    )

pub fn program_code(entries: Entries) -> ProgramCode / {memo.read, abort.raise} = {
  let reached = decoded(
    memo.fetch(reachable_query, bin::encode(entries, entries_bin())),
    reached_bin(),
    "what a program reaches",
  );
  {
    parts: reached.parts.map(|part: PartMembers|
      {
        part: part,
        made: decoded(
          memo.fetch(part_query, bin::encode(part, part_members_bin())),
          made_part_bin(),
          "a part",
        ),
      }),
    roots: reached.roots,
    links: reached.links,
  }
}

fn unit_digests(code: ProgramCode) -> Map<Bytes, Bytes> / {abort.raise} =
  code.parts.fold(Map::new(), |found: Map<Bytes, Bytes>, p: PartCode|
    range(0, p.part.units.len()).fold(found, |m: Map<Bytes, Bytes>, i: Int|
      m.insert(bin::encode(p.part.units.get(i), code_unit_bin()), p.made.codes.get(i))))

pub fn closure_codes(code: ProgramCode) -> Map<RootName, Bytes> / {abort.raise} = {
  let links = code.links;
  let digests = unit_digests(code);
  let own = links.map(|l: RootLink| match digests.get(l.unit) { Some(d) -> d, None -> b"" });
  let index = range(0, links.len()).fold(Map::new(), |m: Map<RootName, Int>, i: Int|
    m.insert(links.get(i).root, i));
  let edges = links.map(|l: RootLink|
    l.calls.fold([], |found: List<Int>, c: RootName|
      match index.get(c) { Some(j) -> found.push(j), None -> found }));
  let below = graph::components({ out: edges }).fold(
    Map::new(),
    |done: Map<Int, Bytes>, component: List<Int>| {
      let inside = component.fold(Map::new(), |m: Map<Int, Bool>, i: Int| m.insert(i, true));
      let reached = component.fold([], |found: List<Bytes>, i: Int|
        edges.get(i).fold(found, |a: List<Bytes>, j: Int|
          if inside.contains(j) { a }
          else { match done.get(j) { Some(d) -> a.push(d), None -> a } }));
      let digest = blake3(
        Bytes::concat_all(
          component.map(|i: Int| own.get(i)).sort().unique().concat(reached.sort().unique()),
        ),
      );
      component.fold(done, |m: Map<Int, Bytes>, i: Int| m.insert(i, digest))
    },
  );
  range(0, links.len()).fold(Map::new(), |found: Map<RootName, Bytes>, i: Int|
    found.insert(links.get(i).root, match below.get(i) { Some(d) -> d, None -> b"" }))
}

pub fn codes_of_part(part: PartMembers) -> List<UnitCode> / {memo.read, abort.raise} =
  part.units.map(unit_code_of)

pub fn decoded_code(bytes: Bytes) -> UnitCode / {abort.raise} =
  decoded(bytes, unit_code_bin(), "a unit's code")

pub fn encoded_code(code: UnitCode) -> Bytes / {abort.raise} = bin::encode(code, unit_code_bin())

pub fn part_text(
  made: MadePart,
  codes: List<UnitCode>,
  inputs: Map<Bytes, Bytes>,
) -> List<WrittenPart> / {abort.raise} = part_library(codes, made.foreign, inputs).parts

fn is_lowered(k: RootKey, tested: Bool) -> Bool / {memo.read, abort.raise} =
  match unit_of_root(k, tested) {
    NoCode -> true,
    unit -> memo.is_cached(code_query, bin::encode(unit, code_unit_bin())),
  }

pub fn whole_lowering_pays(entries: Entries) -> Bool / {memo.read, abort.raise} = {
  let missing = entries.roots.filter(|k: RootKey| !is_lowered(k, entries.tested)).len();
  missing > 0 && missing * 2 >= entries.roots.len()
}

fn linked_program(
  digests: Map<Bytes, Bytes>,
  calls: Map<Bytes, List<Bytes>>,
) -> ProgramCode / {abort.raise} =
  {
    parts: [
      {
        part: {
          module: b"m",
          label: b"",
          units: digests.keys().map(|n: Bytes| OfRoot({ key: Named(n), tested: false })),
        },
        made: { identity: b"", foreign: Map::new(), codes: digests.values() },
      },
    ],
    roots: [],
    links: digests.keys().map(|n: Bytes|
      {
        root: root_name(Named(n)),
        unit: bin::encode(OfRoot({ key: Named(n), tested: false }), code_unit_bin()),
        calls: match calls.get(n) {
          Some(cs) -> cs.map(|c: Bytes| root_name(Named(c))),
          None -> [],
        },
      }),
  }

test "a root's code digest changes when anything it can call changes, and not otherwise" {
  let calls = Map::new().insert(b"f", [b"g"]).insert(b"g", [b"f"]);
  let digests = |g: Bytes| Map::new().insert(b"f", b"1").insert(b"g", g).insert(b"h", b"3");
  let before = closure_codes(linked_program(digests(b"2"), calls));
  let after = closure_codes(linked_program(digests(b"4"), calls));
  assert(before.get(root_name(Named(b"f"))) != after.get(root_name(Named(b"f"))), None);
  assert_eq(before.get(root_name(Named(b"h"))), after.get(root_name(Named(b"h"))))
}
