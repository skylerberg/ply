import std.bin
import compiler.store.memo (memo)
import compiler.store.hash (Contract, contract_bin, public_contracts)
import compiler.front.interface (ModuleInterface, module_interface_bin, module_interface_of)
import compiler.front.emitter_input (Analysed, Rejected)
import compiler.front.checking.world (ModuleKey, QueryEffects, decoded, module_key_bin)
import compiler.front.checking.promises (modules_analysed)

pub type PublishedModule = { interface: ModuleInterface, contracts: List<Contract> }

derive bin for PublishedModule

pub const interface_query: Bytes = b"interface"

pub fn interface_result(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let key = decoded(input, module_key_bin(), "a module's name");
  let analysed = modules_analysed([key]);
  bin::encode(
    match analysed.outcome {
      Rejected(_) -> None,
      Analysed(a) ->
        Some({
          interface: module_interface_of(a, analysed.sources, key.module),
          contracts: public_contracts(a.index, a.hashes, |m: Bytes| m == key.module),
        }),
    },
    bin::option_bin(published_module_bin()),
  )
}

pub fn published_module(key: ModuleKey) -> Option<PublishedModule> / {memo.read, abort.raise} =
  decoded(
    memo.fetch(interface_query, bin::encode(key, module_key_bin())),
    bin::option_bin(published_module_bin()),
    "a module's published interface",
  )

pub fn interface_queries() -> List<{ name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {QueryEffects, abort.raise} }> =
  [
    {
      name: interface_query,
      definition: b"compiler.front.checking.interfaces.interface_result",
      body: interface_result,
    },
  ]
