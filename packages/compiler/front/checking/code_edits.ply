import std.fs
import std.set (Set)
import std.bin
import std.list
import compiler.check.resolve.tables (Source)
import compiler.emit.keys (Named, EntryPoint, RootKey, module_of, test_key)
import compiler.front (analyse_pulling_std_with)
import compiler.prelude_source
import compiler.syntax.expressions (prelude_module)
import compiler.front.checking (fresh_registry, inputs_alone, lookup_input_alone,
                                lookup_input_shipping, over_decoding, prelude_frames, prelude_files,
                                query_load, listed_module)
import compiler.front.checking.units (Entries, PartCode, code_unit_bin, codes_of_part, part_text,
                                      program_code, entries_of, roots_of_modules)
import compiler.cc (WrittenPart)
import compiler.front.published (dump_of, no_rows)
import compiler.front.emitter_input (Analysed, Rejected)
import compiler.emit (diagnostics_text)
import compiler.store.memo (memo, Run, in_session, reading)
import compiler.unit (unit_code_bin, requested_roots)

type Built = { codes: Map<Bytes, Bytes>, text: Bytes }

type Finished = { store: fs::MemFs, run: Run, built: Built }

const main_entry: Entries =
  {
    roots: [EntryPoint(Named(b"app.main")), EntryPoint(test_key(b"app", b"it adds"))],
    tested: false,
  }

fn built_program(entries: Entries) -> Built / {memo.read, abort.raise} = {
  let code = program_code(entries);
  code.parts.fold({ codes: Map::new(), text: b"" }, |accumulator: Built, p: PartCode| {
    let codes = codes_of_part(p.part);
    {
      codes: range(0, codes.len()).fold(accumulator.codes, |m: Map<Bytes, Bytes>, i: Int|
        m.insert(
          bin::encode(p.part.units.get(i), code_unit_bin()),
          bin::encode(codes.get(i), unit_code_bin()),
        )),
      text: part_text(p.made, codes, Map::new()).fold(
        accumulator.text,
        |t: Bytes, w: WrittenPart| t.concat(w.text),
      ),
    }
  })
}

fn built_from(
  store: fs::MemFs,
  sources: List<Source>,
  wanted: () -> Entries / {memo.read, abort.raise},
) -> Finished / {abort.raise} = {
  let w = inputs_alone(sources);
  let qs = fresh_registry();
  let done = over_decoding(
    store,
    prelude_frames,
    prelude_files,
    |kind: Bytes, at: Bytes| lookup_input_alone(w, kind, at),
    ||
      in_session(qs, |run: Run| {
        let done = reading(qs, run, || {
          query_load(w.own, [], false, listed_module);
          built_program(wanted())
        });
        { run: done.run, value: done }
      }),
  );
  { store: done.store, run: done.value.run, built: done.value.value }
}

fn library(limit: Bytes) -> Source =
  {
    name: b"lib",
    source_text: b"pub type Shape = | Dot | Box(Int)\n\npub type Pair = { left: Shape, right: Int }\n\npub fn area(s: Shape) -> Int = match s { Dot -> 0, Box(n) -> n * n }\n\npub fn twice<a>(xs: List<a>, f: (a) -> a) -> List<a> = xs.map(|x: a| f(f(x)))\n\npub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n\npub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n\npub fn first<a>(xs: List<a>) -> Option<a> = xs.at(0)\n\npub type Id = | Id(Int)\n\nfn id_key(i: Id) -> Int = match i { Id(n) -> n }\n\nkey for Id by id_key\n\nfn id_text(i: Id) -> String = \"id\"\n\nshow for Id by id_text\n\npub effect counter {\n  read next() -> Int\n}\n\npub fn counted(go: () -> Int / {counter.read}) -> Int =\n  handle {\n    go()\n  } with {\n    counter.next() -> 1,\n  }\n\npub const limit: Int = ".concat(
      limit,
    ),
  }

fn program(body: Bytes) -> Source =
  {
    name: b"app",
    source_text: Bytes::concat_all([
      b"import lib\n\nfn total(xs: List<Int>) -> Int = xs.fold(0, |n: Int, x: Int| n + x)\n\nfn helper(n: Int) -> Int = ",
      body,
      b"\n\nfn pairs() -> List<lib::Pair> = [{ left: lib::Dot, right: 1 }]\n\npub fn main() -> Int = helper(total(lib::twice([1, 2, 3], |x: Int| x + 1)) + lib::area(lib::Box(2))) + (if lib::even(4) { 1 } else { 0 }) + (match lib::first(pairs()) { Some(p) -> p.right, None -> 0 }) + lib::counted(|| lib::counter.next()) + lib::limit + Map::new().insert(lib::Id(1), 2).len()\n\ntest \"it adds\" {\n  assert_eq(helper(1), helper(1));\n  assert_eq(pairs(), pairs());\n  assert_eq(lib::Id(1), lib::Id(1))\n}\n",
    ]),
  }

test "after a series of edits each unit's code equals a build from nothing" {
  let steps = [
    { limit: b"3", body: b"n * 2" },
    { limit: b"3", body: b"n * 3" },
    { limit: b"4", body: b"lib::area(lib::Dot) + n" },
    { limit: b"4", body: b"n * n" },
  ];
  steps.fold(fs::mem_empty(), |store: fs::MemFs, step: { limit: Bytes, body: Bytes }| {
    let sources = [library(step.limit), program(step.body)];
    let warm = built_from(store, sources, || main_entry);
    let cold = built_from(fs::mem_empty(), sources, || main_entry);
    assert_eq(warm.built.codes, cold.built.codes);
    assert_eq(warm.built.text, cold.built.text);
    warm.store
  });
  ()
}

fn every_root_kind(body: Bytes) -> Source =
  {
    name: b"kinds",
    source_text: Bytes::concat_all([
      b"pub fn edited(n: Int) -> Int = ",
      body,
      b"\n\npub fn positive(x: Int) -> Int requires x > 0 ensures result > 0 = x\n\n",
      b"pub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n\n",
      b"pub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n\n",
      b"pub fn total<a>(xs: List<a>) -> a where numeric(a) = xs.fold(numeric_of_int(0), |s: a, x: a| s + x)\n\n",
      b"law \"grows\" forall (x: Int) where x > 0 { positive(x) + 1 > x }\n\n",
      b"test \"it holds\" {\n  assert(even(2));\n  assert_eq(total([1, 2]), 3)\n}\n",
    ]),
  }

test "lowering a group after an edit to another group reads the group's stored check, and its code equals a build from nothing" {
  let wanted = || entries_of(roots_of_modules([b"kinds"]));
  [b"n * 2", b"n + 7", b"positive(n)"].fold(fs::mem_empty(), |store: fs::MemFs, body: Bytes| {
    let sources = [every_root_kind(body)];
    let warm = built_from(store, sources, wanted);
    let cold = built_from(fs::mem_empty(), sources, wanted);
    assert_eq(warm.built.codes, cold.built.codes);
    assert_eq(warm.built.text, cold.built.text);
    warm.store
  });
  ()
}

pub fn lowered_over_shipped(
  sources: List<Source>,
  shipped_files: List<Source>,
) -> List<PartCode> / {abort.raise} = {
  let shipped = shipped_files.map(|s: Source|
    if s.name == prelude_module { { ..s, source_text: prelude_source::text } } else { s });
  let analysed = analyse_pulling_std_with(sources, shipped, no_rows).out;
  match analysed {
    Rejected(ds) ->
      panic("the package did not check: " ++ String::of_bytes_lossy(diagnostics_text(ds))),
    Analysed(_) -> (),
  };
  let own = sources.fold(Set::empty(), |m: Set<Bytes>, s: Source| m.insert(s.name));
  let entries = {
    roots: requested_roots(dump_of(analysed)).filter(|k: RootKey| own.contains(module_of(k))),
    tested: false,
  };
  let w = inputs_alone(sources);
  let qs = fresh_registry();
  over_decoding(
    fs::mem_empty(),
    prelude_frames,
    prelude_files,
    |kind: Bytes, at: Bytes| lookup_input_shipping(w, shipped, kind, at),
    ||
      in_session(qs, |run: Run|
        reading(qs, run, || {
          query_load(w.own, [], false, listed_module);
          program_code(entries).parts
        })),
  ).value
}

test "a copy that calls a function passed from another module lowers" {
  let sources = [
    { name: b"names", source_text: b"pub type Oid = Oid(List<Int>)\n" },
    {
      name: b"reader",
      source_text: b"import names\n\npub type Reader = new { data: Bytes, at: Int, end: Int, room: Int, tag: Option<Int> }\n\npub type Read<a> = { value: a, rest: Reader }\n\npub fn start(data: Bytes) -> Reader = { data: data, at: 0, end: data.len(), room: 8, tag: None }\n\npub fn read_oid(r: Reader) -> Read<names::Oid> / {abort.raise} = { value: names::Oid([r.at]), rest: r }\n\npub fn tagged<a | e>(r: Reader, item: (Reader) -> Read<a> / {abort.raise | e}) -> Read<a> / {abort.raise | e} = item({ ..r, tag: Some(1) })\n",
    },
    {
      name: b"top",
      source_text: b"import names\nimport reader\nimport reader (Reader, Read)\n\npub type Name = | Registered(names::Oid) | Blank\n\npub fn name_at(r: Reader) -> Read<Name> / {abort.raise} = {\n  let id = reader::tagged(r, reader::read_oid);\n  { value: Registered(id.value), rest: id.rest }\n}\n\npub fn main() -> Int / {abort.raise} = match name_at(reader::start(b\"x\")).value { Registered(_) -> 1, Blank -> 0 }\n",
    },
  ];
  assert(
    lowered_over_shipped(sources, [
        { name: prelude_module, source_text: prelude_source::text },
      ]).len(
      )
      > 0,
    None,
  )
}
