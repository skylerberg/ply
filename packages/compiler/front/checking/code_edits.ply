import std.bin
import std.list
import compiler.check.resolve.tables (Source)
import compiler.emit.keys (Named, EntryPoint, RootKey, module_of, test_key)
import compiler.front (analyse_pulling_std_with)
import compiler.prelude_source
import compiler.syntax.expressions (prelude_module)
import compiler.front.checking (fresh_registry, inputs_alone, lookup_input_alone,
                                lookup_input_shipping, over_decoding, prelude_frames, prelude_files,
                                query_load)
import compiler.front.checking.groups (GroupKey)
import compiler.front.checking.units (OfGroup, Entries, PartCode, code_query, code_unit_bin,
                                      codes_of_part, part_text, program_code)
import compiler.front.checking.world (decode_cache)
import compiler.cc (WrittenPart)
import compiler.front.diagnostics (parse_all)
import compiler.front.published (analyse, dump_of, no_rows)
import compiler.front.emitter_input (Analysed, Rejected)
import compiler.emit (diagnostics_text)
import compiler.store.memo (memo, MemoryStore, QueryStats, Run, empty_memory_store, executed_for,
                            in_session, query_stats, reading)
import compiler.unit (UnitCode, WholeLowering, unit_code_bin, lowered_whole, requested_roots,
                      sources_in_order)

type Built = { codes: Map<Bytes, Bytes>, text: Bytes }

type Finished = { store: MemoryStore, run: Run, built: Built }

fn main_entry() -> Entries / {abort.raise} =
  {
    roots: [EntryPoint(Named(b"app.main")), EntryPoint(test_key(b"app", b"it adds"))],
    tested: false,
  }

fn built_program() -> Built / {memo.read, abort.raise} = {
  let code = program_code(main_entry());
  code.parts.fold({ codes: Map::new(), text: b"" }, |accumulator: Built, p: PartCode| {
    let codes = codes_of_part(p.part);
    {
      codes: range(0, codes.len()).fold(accumulator.codes, |m: Map<Bytes, Bytes>, i: Int|
        m.insert(
          bin::encode(p.part.units.get(i), code_unit_bin()),
          bin::encode(codes.get(i), unit_code_bin()),
        )),
      text: part_text(p.made, codes, Map::new()).fold(
        accumulator.text,
        |t: Bytes, w: WrittenPart| match w.text { Some(x) -> t.concat(x), None -> t },
      ),
    }
  })
}

fn built_from(store: MemoryStore, sources: List<Source>, whole: Bool) -> Finished / {abort.raise} = {
  let w = inputs_alone(sources);
  let qs = fresh_registry();
  let first = if !whole { None } else {
    let dump = dump_of(analyse(parse_all(sources)));
    Some(
      lowered_whole(
        dump,
        sources_in_order(dump, sources),
        requested_roots(dump).keys,
        Some([Named(b"app.main"), test_key(b"app", b"it adds")]),
      ),
    )
  };
  let done = over_decoding(
    store,
    prelude_frames,
    prelude_files(),
    |kind: Bytes, at: Bytes| lookup_input_alone(w, kind, at),
    ||
      in_session(qs, |run: Run| {
        let done = reading(qs, run, || {
          query_load(w.own, [], false);
          match first { Some(l) -> decode_cache.cache_whole_lowering(l), None -> () };
          built_program()
        });
        { run: done.run, value: done }
      }),
  );
  { store: done.store, run: done.value.run, built: done.value.value }
}

fn library(limit: Bytes) -> Source =
  {
    name: b"lib",
    source_text: b"pub type Shape = | Dot | Box(Int)\n\npub type Pair = { left: Shape, right: Int }\n\npub fn area(s: Shape) -> Int = match s { Dot -> 0, Box(n) -> n * n }\n\npub fn twice<a>(xs: List<a>, f: (a) -> a) -> List<a> = xs.map(|x: a| f(f(x)))\n\npub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n\npub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n\npub fn first<a>(xs: List<a>) -> Option<a> = xs.at(0)\n\npub type Id = | Id(Int)\n\nfn id_key(i: Id) -> Int = match i { Id(n) -> n }\n\nkey for Id by id_key\n\nfn id_text(i: Id) -> String = \"id\"\n\nshow for Id by id_text\n\npub effect counter {\n  read next() -> Int\n}\n\npub fn counted(go: () -> Int / {counter.read}) -> Int =\n  handle {\n    go()\n  } with {\n    counter.next() -> 1,\n  }\n\npub const fn limit() -> Int = ".concat(
      limit,
    ),
  }

fn program(body: Bytes) -> Source =
  {
    name: b"app",
    source_text: Bytes::concat_all([
      b"import lib\n\nfn total(xs: List<Int>) -> Int = xs.fold(0, |n: Int, x: Int| n + x)\n\nfn helper(n: Int) -> Int = ",
      body,
      b"\n\nfn pairs() -> List<lib::Pair> = [{ left: lib::Dot, right: 1 }]\n\npub fn main() -> Int = helper(total(lib::twice([1, 2, 3], |x: Int| x + 1)) + lib::area(lib::Box(2))) + (if lib::even(4) { 1 } else { 0 }) + (match lib::first(pairs()) { Some(p) -> p.right, None -> 0 }) + lib::counted(|| lib::counter.next()) + lib::limit() + Map::new().insert(lib::Id(1), 2).len()\n\ntest \"it adds\" {\n  assert_eq(helper(1), helper(1));\n  assert_eq(pairs(), pairs());\n  assert_eq(lib::Id(1), lib::Id(1))\n}\n",
    ]),
  }

test "a unit lowered alone equals the same unit from the whole-program pipeline" {
  let sources = [library(b"3"), program(b"n * 2")];
  let alone = built_from(empty_memory_store(), sources, false);
  let whole = built_from(empty_memory_store(), sources, true);
  assert(alone.built.codes.len() > 0, None);
  assert_eq(whole.built.codes, alone.built.codes);
  assert_eq(whole.built.text, alone.built.text)
}

test "editing one function's body lowers that function's unit and no other" {
  let before = built_from(empty_memory_store(), [library(b"3"), program(b"n * 2")], false);
  let after = built_from(before.store, [library(b"3"), program(b"n * 3")], false);
  let helper = OfGroup({ module: b"app", shipped: false, tested: false, owners: [b"helper"] });
  assert_eq(executed_for(after.run, code_query()), [bin::encode(helper, code_unit_bin())])
}

test "after a series of edits each unit's code equals a build from nothing" {
  let steps = [
    { limit: b"3", body: b"n * 2" },
    { limit: b"3", body: b"n * 3" },
    { limit: b"4", body: b"lib::area(lib::Dot) + n" },
    { limit: b"4", body: b"n * n" },
  ];
  steps.fold(empty_memory_store(), |store: MemoryStore, step: { limit: Bytes, body: Bytes }| {
    let sources = [library(step.limit), program(step.body)];
    let warm = built_from(store, sources, false);
    let cold = built_from(empty_memory_store(), sources, false);
    assert_eq(warm.built.codes, cold.built.codes);
    assert_eq(warm.built.text, cold.built.text);
    warm.store
  });
  ()
}

fn chain_of(size: Int, body: Bytes) -> List<Source> = {
  let name = |i: Int| b"lib".concat(Bytes::of_string(i.to_string()));
  [
    {
      name: name(0),
      source_text: Bytes::concat_all([b"pub fn step(n: Int) -> Int = ", body, b"\n"]),
    },
  ].concat(
    range(1, size).map(|i: Int|
      {
        name: name(i),
        source_text: Bytes::concat_all([
          b"import ",
          name(i - 1),
          b"\npub fn step(n: Int) -> Int = ",
          name(i - 1),
          b"::step(n) + 1\n",
        ]),
      }),
  ).push({
    name: b"app",
    source_text: Bytes::concat_all([
      b"import ",
      name(size - 1),
      b"\npub fn main() -> Int = ",
      name(size - 1),
      b"::step(1)\ntest \"it adds\" { assert_eq(main(), main()) }\n",
    ]),
  })
}

fn queries_run(run: Run) -> List<{ query: Bytes, ran: Int }> =
  query_stats(run).filter(|t: QueryStats| t.ran > 0).map(|t: QueryStats|
    { query: t.query, ran: t.ran })

test "a body edit runs the same queries at two program sizes, through code and parts" {
  let edit_at = |size: Int| {
    let cold = built_from(empty_memory_store(), chain_of(size, b"n * 3"), false);
    queries_run(built_from(cold.store, chain_of(size, b"n * 4"), false).run)
  };
  assert_eq(edit_at(3), edit_at(9))
}

test "code built with nothing changed runs no query" {
  let cold = built_from(empty_memory_store(), chain_of(3, b"n * 3"), false);
  assert_eq(queries_run(built_from(cold.store, chain_of(3, b"n * 3"), false).run), [])
}

fn built_over_shipped(
  sources: List<Source>,
  shipped: List<Source>,
  entries: Entries,
  first: Option<WholeLowering>,
) -> Map<Bytes, Bytes> / {abort.raise} = {
  let w = inputs_alone(sources);
  let qs = fresh_registry();
  over_decoding(
    empty_memory_store(),
    prelude_frames,
    prelude_files(),
    |kind: Bytes, at: Bytes| lookup_input_shipping(w, shipped, kind, at),
    ||
      in_session(qs, |run: Run|
        reading(qs, run, || {
          query_load(w.own, [], false);
          match first { Some(l) -> decode_cache.cache_whole_lowering(l), None -> () };
          program_code(entries).parts.fold(Map::new(), |found: Map<Bytes, Bytes>, p: PartCode|
            range(0, p.part.units.len()).fold(found, |m: Map<Bytes, Bytes>, i: Int|
              m.insert(bin::encode(p.part.units.get(i), code_unit_bin()), p.made.codes.get(i))))
        })),
  ).value
}

pub fn codes_apart(
  sources: List<Source>,
  shipped_files: List<Source>,
) -> List<Bytes> / {abort.raise} = {
  let shipped = shipped_files.map(|s: Source|
    if s.name == prelude_module() { { ..s, source_text: prelude_source::text() } } else { s });
  let analysed = analyse_pulling_std_with(sources, shipped, no_rows()).out;
  match analysed {
    Rejected(ds) ->
      panic("the package did not check: " ++ String::of_bytes_lossy(diagnostics_text(ds))),
    Analysed(_) -> (),
  };
  let dump = dump_of(analysed);
  let own = sources.fold(Map::new(), |m: Map<Bytes, Bool>, s: Source| m.insert(s.name, true));
  let every = requested_roots(dump).keys;
  let entries = { roots: every.filter(|k: RootKey| own.contains(module_of(k))), tested: false };
  let whole = lowered_whole(dump, sources_in_order(dump, sources.concat(shipped)), every, Some([]));
  let alone = built_over_shipped(sources, shipped, entries, None);
  let batched = built_over_shipped(sources, shipped, entries, Some(whole));
  assert(whole.results.len() > 0, None);
  alone.fold([], |found: List<Bytes>, unit: Bytes, digest: Bytes|
    if batched.get(unit) == Some(digest) { found } else { found.push(unit) })
}
