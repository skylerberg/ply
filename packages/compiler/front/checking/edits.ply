type Reference = {
  whole: OutcomeSummary,
  fixing: CachedHashes,
  results: List<CheckedModule>,
  store: MemoryStore,
  group_inputs: Option<Map<Bytes, Bytes>>,
  hash_inputs: Option<Map<Bytes, Bytes>>,
}

fn reference_of(sources: List<Source>) -> Reference / {abort.raise} = {
  let fresh = queried_results(fresh_registry(), empty_memory_store(), sources);
  {
    whole: outcome_summary(analyse(parse_all(sources))),
    fixing: fresh.fixing,
    results: fresh.results,
    store: fresh.store,
    group_inputs: inputs_over(fresh.store, sources, b"group inputs"),
    hash_inputs: inputs_over(fresh.store, sources, b"hash inputs"),
  }
}

fn sources_key(sources: List<Source>) -> Bytes =
  Bytes::concat_all(
    sources.map(|s: Source| Bytes::concat_all([s.name, b"\x00", s.source_text, b"\x00"])),
  )

fn fresh_digest(
  sources: List<Source>,
  store: MemoryStore,
  record: memo::FactRecord,
) -> Option<Bytes> / {abort.raise} = {
  let w = inputs_alone(sources);
  let qs = fresh_registry();
  handle {
    Some(
      over_decoding(
        store,
        prelude_frames,
        prelude_files(),
        |kind: Bytes, at: Bytes| lookup_input_alone(w, kind, at),
        ||
          memo::digest_of(
            Some(memo::query_output(qs, start_run(qs), record.query, record.input).output),
          ),
      ).value,
    )
  } with {
    abort.raise(_) -> None,
  }
}

fn checked_two_ways(query: Bytes) -> Bool =
  [
    group_query(),
    signatures_query(),
    signature_query(),
    group_interface_query(),
    shown_query(),
    owner_interface_query(),
    owner_interfaces_query(),
  ].contains(
    query,
  )

fn facts_differing(
  warm: MemoryStore,
  fresh: MemoryStore,
  sources: List<Source>,
) -> List<Bytes> / {abort.raise} = {
  let stored = memo::fact_records(fresh);
  let products_behind = warm.cursor < warm.log.len();
  let off = memo::fact_records(warm).fold(
    [],
    |found: List<Bytes>, key: Bytes, record: memo::FactRecord|
      if products_behind && product_queries().contains(record.query) { found } else {
        match stored.get(key) {
          Some(same) -> if same.output == record.output || checked_two_ways(record.query) { found }
          else { found.push(record.query) },
          None -> if fresh_digest(sources, fresh, record) == Some(record.output) { found }
          else { found.push(record.query) },
        }
      },
  );
  off.unique()
}

type EditSession = {
  store: MemoryStore,
  checks: Map<Bytes, Bytes>,
  hashes: Map<Bytes, Bytes>,
  references: Map<Bytes, Reference>,
  off: List<Bytes>,
}

pub fn disagreements(steps: List<Step>) -> List<Bytes> / {abort.raise} =
  steps.fold(
    {
      store: empty_memory_store(),
      checks: Map::new(),
      hashes: Map::new(),
      references: Map::new(),
      off: [],
    },
    |s: EditSession, step: Step| {
      let warm = queried_over(s.store, step.sources);
      let now = outcome_summary(warm.outcome);
      let key = sources_key(step.sources);
      let r = match s.references.get(key) {
        Some(known) -> known,
        None -> reference_of(step.sources),
      };
      let same_outcome = r.results == warm.results
        || now == outcome_summary(outcome_of(step.sources, r.results));
      let agrees = same_outcome && warm.fixing == r.fixing
        && (match r.whole {
          PublicationSummary(_) -> now == r.whole,
          RejectionSummary(_) -> match now {
            RejectionSummary(_) -> true,
            PublicationSummary(_) -> false,
          },
        });
      let checked = pulled(warm.run, group_query(), s.checks, r.group_inputs);
      let hashed = pulled(warm.run, group_hash_query(), s.hashes, r.hash_inputs);
      let wrong_facts = facts_differing(warm.store, r.store, step.sources);
      {
        store: warm.store,
        checks: checked.made,
        hashes: hashed.made,
        references: s.references.insert(key, r),
        off: if !agrees {
          s.off.push(Bytes::concat_all([step.what, hash_differences(warm.fixing, r.fixing)]))
        } else if wrong_facts.len() > 0 {
          s.off.push(Bytes::concat_all([step.what, b" (facts): ", backticked(wrong_facts, b", ")]))
        } else {
          match checked.mismatches {
            Some(reason) -> s.off.push(Bytes::concat_all([step.what, b" (work)", reason])),
            None -> match hashed.mismatches {
              Some(reason) -> s.off.push(Bytes::concat_all([step.what, b" (hash work)", reason])),
              None -> s.off,
            },
          }
        },
      }
    },
  ).off

fn pulled(
  run: Run,
  query: Bytes,
  made: Map<Bytes, Bytes>,
  now: Option<Map<Bytes, Bytes>>,
) -> { made: Map<Bytes, Bytes>, mismatches: Option<Bytes> } / {abort.raise} =
  match now {
    None -> { made: made, mismatches: None },
    Some(reads) -> {
      let q = match fresh_registry().get(query) {
        Some(x) -> x,
        None -> panic("no query with this name exists in the compiler's list of queries"),
      };
      let ran = executed_for(run, query).fold(
        Map::new(),
        |accumulator: Map<Bytes, Bool>, k: Bytes| accumulator.insert(k, true),
      );
      let back = restored_for(run, query).fold(
        Map::new(),
        |accumulator: Map<Bytes, Bool>, k: Bytes| accumulator.insert(k, true),
      );
      let groups = reads.keys();
      let moved = |g: Bytes| made.get(g) != reads.get(g);
      let needless = sorted_bytes(groups.filter(|g: Bytes| ran.contains(g) && !moved(g)));
      let stale = sorted_bytes(
        groups.filter(|g: Bytes|
          run.resolved.contains(memo::key_of(q, g)) && !ran.contains(g) && !back.contains(g)
            && moved(g)),
      );
      {
        made: groups.fold(made, |accumulator: Map<Bytes, Bytes>, g: Bytes|
          if ran.contains(g) || back.contains(g) {
            accumulator.insert(g, match reads.get(g) { Some(d) -> d, None -> b"" })
          } else { accumulator }),
        mismatches: if stale == [] { None } else {
          Some(
            Bytes::concat_all([
              b": ran ",
              groups_shown(needless),
              b" though its reads had not changed; reused ",
              groups_shown(stale),
              b" though their inputs had changed",
            ]),
          )
        },
      }
    },
  }

fn groups_shown(groups: List<Bytes>) -> Bytes / {abort.raise} =
  Bytes::join(
    groups.map(|b: Bytes| {
      let g = decoded(b, group_key_bin(), "a group's names");
      Bytes::concat_all([g.module, b"[", Bytes::join(g.owners, b" "), b"]"])
    }),
    b", ",
  )

fn hash_differences(warm: CachedHashes, fresh: CachedHashes) -> Bytes = {
  let by = |f: CachedHashes|
    f.nodes.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, x: CachedNode|
      accumulator.insert(x.name, x.hash));
  let w = by(warm);
  let c = by(fresh);
  let names = sorted_bytes(
    w.fold(c, |accumulator: Map<Bytes, Bytes>, k: Bytes, v: Bytes| accumulator.insert(k, v)).keys(),
  );
  let apart = names.filter(|n: Bytes| w.get(n) != c.get(n));
  if apart.len() == 0 { b"" }
  else { Bytes::concat_all([b" (hashes of ", Bytes::join(apart, b", "), b")"]) }
}

fn group_check_of(group: GroupKey, published: Bool) -> GroupCheck / {QueryEffects, abort.raise} = {
  let named = { module: group.module, shipped: group.shipped, tested: group.tested };
  owners_check(
    named,
    group.owners.map(|o: Bytes| owner_facts(named, o)),
    imports_of(group),
    published,
    always_entire,
  )
}

fn group_inputs_hash(input: Bytes) -> Bytes / {QueryEffects, abort.raise} = {
  let group = decoded(input, group_key_bin(), "a group's names");
  if !current(group) { b"" } else {
    let of = |c: GroupCheck| {
      let source = group_source_from(group.module, c.reads, c.imported, c.needed);
      Bytes::concat_all([
        bin::encode(source.source.source_text, bin::bytes_bin()),
        bin::encode(source.derived, bin::list_bin(derivation_bin())),
        bin::encode(
          source.dependencies,
          bin::map_bin(bin::bytes_bin(), bin::map_bin(bin::bytes_bin(), owner_interface_bin())),
        ),
        bin::encode(source.rows, bin::list_bin(known_definition_row_bin())),
        bin::encode(source.fixed, bin::list_bin(cached_node_bin())),
        bin::encode(c.setting, setting_bin()),
        bin::encode(c.places, bin::map_bin(bin::bytes_bin(), module_origin_bin())),
      ])
    };
    let rejected = group_of(group).rejected.len() > 0;
    blake3(
      of(group_check_of(group, false)).concat(if rejected { of(group_check_of(group, true)) }
      else { b"" }),
    )
  }
}

fn hash_inputs_result(input: Bytes) -> Bytes / {memo.read, abort.raise} = {
  let group = decoded(input, group_key_bin(), "a group's names");
  if !current_unit(group) { b"" } else {
    let h = group_hash_inputs(group);
    blake3(
      Bytes::concat_all([
        bin::encode(h.forms, hash_input_bin()),
        bin::encode(h.fixed, bin::list_bin(cached_node_bin())),
        bin::encode(h.functions, bin::map_bin(bin::bytes_bin(), bin::bytes_bin())),
      ]),
    )
  }
}

fn inputs_over(
  store: MemoryStore,
  sources: List<Source>,
  probe: Bytes,
) -> Option<Map<Bytes, Bytes>> / {abort.raise} = {
  let w = load_inputs_of(
    {
      root: b"",
      manifest: None,
      files: sources.map(|s: Source| { module: s.name, text: s.source_text }),
    },
    [],
  );
  over_decoding(
    store,
    prelude_frames,
    prelude_files(),
    |kind: Bytes, at: Bytes| lookup_input_alone(w, kind, at),
    || {
      let qs = fresh_registry().insert(b"group inputs", {
        name: b"group inputs",
        hash: b"group inputs",
        body: group_inputs_hash,
        persistent: true,
        product: false,
      }).insert(b"hash inputs", {
        name: b"hash inputs",
        hash: b"hash inputs",
        body: hash_inputs_result,
        persistent: true,
        product: false,
      });
      let cycles = cycles_among(qs, start_run(qs), w.own);
      if cycles.rejected.len() > 0 { None } else {
        Some(
          w.own.fold(
            { run: cycles.run, out: Map::new() },
            |accumulator: { run: Run, out: Map<Bytes, Bytes> }, m: Bytes| {
              let named = bin::encode(
                { module: m, shipped: false, tested: false },
                module_key_bin(),
              );
              let o = query_output(qs, accumulator.run, owners_query(), named);
              decoded(o.output, owners_result_bin(), "a module's owners").groups.fold(
                { run: o.run, out: accumulator.out },
                |a: { run: Run, out: Map<Bytes, Bytes> }, g: List<Bytes>| {
                  let unit = bin::encode(
                    { module: m, shipped: false, tested: false, owners: g },
                    group_key_bin(),
                  );
                  let cut = if probe != b"group inputs" || g.len() < 2 {
                    { run: a.run, groups: [g] }
                  } else {
                    let c = query_output(qs, a.run, cycles_query(), unit);
                    {
                      run: c.run,
                      groups: decoded(
                        c.output,
                        bin::list_bin(bin::list_bin(bin::bytes_bin())),
                        "a unit's groups",
                      ),
                    }
                  };
                  cut.groups.fold(
                    { run: cut.run, out: a.out },
                    |b: { run: Run, out: Map<Bytes, Bytes> }, owners: List<Bytes>| {
                      let key = bin::encode(
                        { module: m, shipped: false, tested: false, owners: owners },
                        group_key_bin(),
                      );
                      let i = query_output(qs, b.run, probe, key);
                      { run: i.run, out: b.out.insert(key, i.output) }
                    },
                  )
                },
              )
            },
          ).out,
        )
      }
    },
  ).value
}

fn step(what: Bytes, sources: List<Source>) -> Step = { what: what, sources: sources }

fn edited(
  sources: List<Source>,
  name: Bytes,
  from: Bytes,
  to: Bytes,
) -> List<Source> / {abort.raise} =
  sources.map(|source: Source|
    if source.name != name { source } else if source.source_text.index_of(from) == None {
      panic("the test sources changed: the text to edit is not in the module")
    } else { { name: source.name, source_text: Bytes::join(source.source_text.split(from), to) } })

fn with_module(sources: List<Source>, name: Bytes, source_text: Bytes) -> List<Source> =
  sources.filter(|source: Source| source.name != name).push({
    name: name,
    source_text: source_text,
  })

fn without(sources: List<Source>, name: Bytes) -> List<Source> =
  sources.filter(|source: Source| source.name != name)

type Change =
  | LeafBody
  | LeafSignature
  | LeafFunctionPrivate
  | LeafError
  | LeafImportsCore
  | LeafReformatted
  | LeafDeleted
  | CoreRenamed
  | CoreBody
  | CoreResultType
  | TypeRenamed
  | EffectRenamed
  | TwiceMoved
  | DoubledRemoved
  | ShopBody
  | ShopImportsLeaf
  | DefaultEdited
  | TestAdded
  | ExtraAdded
  | ExtraBody
  | DuplicateAdded

fn either(on: List<Change>, change: Change, yes: Bytes, no: Bytes) -> Bytes =
  if on.contains(change) { yes } else { no }

fn twice_text() -> Bytes = b"pub fn twice<a>(x: a, f: (a) -> a) -> a = f(f(x))\n"

fn core_module_source(on: List<Change>) -> Bytes = {
  let money = either(on, TypeRenamed, b"Cost", b"Money");
  Bytes::concat_all([
    b"pub type ",
    money,
    b" = Int\npub type Item =\n  | Book(String, ",
    money,
    b")\n  | Note(String)\npub effect ",
    either(on, EffectRenamed, b"ledger", b"db"),
    b" {\n  read get[r](key: Int) -> Int\n  write put[r](key: Int, value: Int) -> Int\n}\npub fn price(i: Item) -> ",
    either(on, CoreResultType, b"Int", money),
    b" =\n  match i {\n    Book(_, p) -> p",
    either(on, CoreBody, b" + 0", b""),
    b",\n    Note(_) -> 0,\n  }\n",
    either(on, TwiceMoved, b"", twice_text()),
    b"pub fn ",
    either(on, CoreRenamed, b"title", b"label"),
    b"(i: Item) -> String =\n  match i {\n    Book(t, _) -> t,\n    Note(t) -> t,\n  }\npub fn shade(n: Int = ",
    either(on, DefaultEdited, b"2", b"1"),
    b") -> Int = n\ntest \"a note is free\" {\n  assert_eq(price(Note(\"n\")), 0)\n}\n",
    either(
      on,
      TestAdded,
      b"test \"a book costs its price\" {\n  assert_eq(price(Book(\"b\", 2)), 2)\n}\n",
      b"",
    ),
  ])
}

fn shop_module_source(on: List<Change>) -> Bytes = {
  let db = either(on, EffectRenamed, b"ledger", b"db");
  Bytes::concat_all([
    b"import core\n",
    if on.contains(ShopImportsLeaf) || on.contains(TwiceMoved) { b"import leaf\n" } else { b"" },
    b"fn total(items: List<core::Item>) -> Int =\n  items.fold(0, |acc, i: core::Item| acc + core::price(i)",
    either(on, ShopBody, b" + 0", b""),
    b")\n",
    either(
      on,
      DoubledRemoved,
      b"",
      Bytes::concat_all([
        b"fn doubled(n: Int) -> Int = ",
        either(on, TwiceMoved, b"leaf", b"core"),
        b"::twice(n, |x: Int| x + x)\n",
      ]),
    ),
    b"fn stored(k: Int) -> Int / {core::",
    db,
    b".read[cart]} = core::",
    db,
    b".get[cart](k)\nfn shaded() -> Int = core::shade()\ntest \"shipped modules adds up\" {\n  assert_eq(total([core::Book(\"b\", 3), core::Note(\"n\")]), 3)\n}\n",
  ])
}

fn leaf_module_source(on: List<Change>) -> Bytes =
  Bytes::concat_all([
    either(on, LeafImportsCore, b"import core\n\n", b""),
    either(on, LeafReformatted, b"// a comment\n", b""),
    either(on, LeafFunctionPrivate, b"", b"pub "),
    either(on, LeafReformatted, b"fn  one", b"fn one"),
    b"() -> Int = ",
    if on.contains(LeafError) { b"\"1\"" }
    else if on.contains(LeafImportsCore) { b"core::price(core::Note(\"n\")) + 1" }
    else { b"1" },
    b"\npub fn two",
    either(on, LeafSignature, b"(k: Int) -> Int = one() + k", b"() -> Int = one() + one()"),
    either(on, LeafBody, b" + 0", b""),
    b"\n",
    either(on, TwiceMoved, twice_text(), b""),
  ])

fn shop_extra(on: List<Change>) -> Bytes =
  Bytes::concat_all([
    b"import leaf\npub fn four() -> Int = leaf::two(",
    either(on, LeafSignature, b"2", b""),
    b") + ",
    either(on, ExtraBody, b"3", b"2"),
    b"\n",
  ])

fn rendered(on: List<Change>) -> List<Source> = {
  let leaf = leaf_module_source(on);
  let present = |change: Change, sources: List<Source>|
    if on.contains(change) { sources } else { [] };
  [
    [
      { name: b"core", source_text: core_module_source(on) },
      { name: b"shop", source_text: shop_module_source(on) },
    ],
    if on.contains(LeafDeleted) { [] } else { [{ name: b"leaf", source_text: leaf }] },
    present(ExtraAdded, [{ name: b"extra", source_text: shop_extra(on) }]),
    present(DuplicateAdded, [{ name: b"twin", source_text: leaf }]),
  ].flatten(
  )
}

fn unedited_sources() -> List<Source> = rendered([])

fn steps_from_edits(edits: List<List<Change>>) -> List<Step> =
  edits.fold(
    { on: [], steps: [step(b"cold", unedited_sources())] },
    |s: { on: List<Change>, steps: List<Step> }, edit: List<Change>| {
      let on = edit.fold(s.on, |accumulator: List<Change>, c: Change|
        if accumulator.contains(c) { accumulator.filter(|d: Change| d != c) }
        else { accumulator.push(c) });
      {
        on: on,
        steps: s.steps.push(step(Bytes::of_string(s.steps.len().to_string()), rendered(on))),
      }
    },
  ).steps

fn reworked() -> { steps: List<Step>, last: List<Source> } / {abort.raise} = {
  let s0 = unedited_sources();
  let s1 = edited(s0, b"leaf", b"one() + one()", b"one() + one() + 0");
  let s2 = edited(
    s1,
    b"leaf",
    b"pub fn two() -> Int = one() + one() + 0",
    b"pub fn two(k: Int) -> Int = one() + k",
  );
  let s3 = edited(s2, b"leaf", b"pub fn one()", b"fn one()");
  let broken = edited(s3, b"leaf", b"fn one() -> Int = 1", b"fn one() -> Int = \"1\"");
  let s4 = edited(s3, b"core", b"pub fn label(", b"pub fn title(");
  let s5 = edited(s4, b"core", b"Book(_, p) -> p,", b"Book(_, p) -> p + 0,");
  let s6 = edited(s5, b"shop", b"acc + core::price(i)", b"acc + core::price(i) + 0");
  let s7 = edited(s6, b"shop", b"import core\n", b"import core\nimport leaf\n");
  {
    steps: [
      step(b"cold", s0),
      step(b"unchanged", s0),
      step(b"a body edit in a leaf", s1),
      step(b"a signature edit in a leaf", s2),
      step(b"`pub` removed in a leaf", s3),
      step(b"a type error", broken),
      step(b"the error undone", s3),
      step(b"a rename in a module another imports", s4),
      step(b"a body edit in a module another imports", s5),
      step(b"a body edit in a module that imports another", s6),
      step(b"an import added", s7),
      step(b"an import removed", s6),
    ],
    last: s6,
  }
}

test "reusing cached results matches checking from scratch after edits to bodies, signatures, `pub` and imports" {
  assert_eq(disagreements(reworked().steps), [])
}

test "reusing cached results matches checking from scratch after a file is added, edited and deleted, and after renames" {
  let s6 = reworked().last;
  let s8 = with_module(s6, b"extra", b"import leaf\npub fn four() -> Int = leaf::two(2) + 2\n");
  let s9 = edited(s8, b"extra", b"+ 2\n", b"+ 3\n");
  let s10 = edited(s9, b"leaf", b"one() + k", b"one() + k + 0");
  let s11 = edited(
    edited(
      s10,
      b"leaf",
      b"fn one() -> Int = 1",
      b"import core\n\nfn one() -> Int = core::price(core::Note(\"n\")) + 1",
    ),
    b"core",
    b"Book(_, p) -> p + 0,",
    b"Book(_, p) -> p + 1,",
  );
  let s12 = without(s11, b"extra");
  let s13 = edited(s12, b"core", b"Money", b"Cost");
  let s14 = edited(
    edited(s13, b"core", b"effect db", b"effect ledger"),
    b"shop",
    b"core::db.",
    b"core::ledger.",
  );
  assert_eq(
    disagreements([
      step(b"cold", s6),
      step(b"a file added", s8),
      step(b"an edit to the added file", s9),
      step(b"an edit to the leaf the added file imports", s10),
      step(b"an import added to a module edited with the one it now imports", s11),
      step(b"the added file deleted", s12),
      step(b"a type renamed", s13),
      step(b"an effect renamed", s14),
      step(b"unchanged again", s14),
    ]),
    [],
  )
}

test "reusing cached results matches checking from scratch when a group member starts calling another member of its group" {
  let source_text = Bytes::concat_all([
    b"pub fn even(n: Int) -> Bool = if n <= 0 { here() } else { odd(n - 1) }\n",
    b"pub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n",
    b"fn here() -> Bool = true\n",
    b"fn there() -> Bool = 1 > 0\n",
    b"pub fn other(n: Int) -> Int = n + 1\n",
  ]);
  let s0 = [{ name: b"cycle", source_text: source_text }];
  let s1 = edited(s0, b"cycle", b"{ here() }", b"{ there() }");
  let s2 = edited(s1, b"cycle", b"{ false }", b"{ here() }");
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"a member calls another sibling", s1),
      step(b"the other member calls the first's old one", s2),
      step(b"back", s0),
    ]),
    [],
  )
}

test "reusing cached results matches checking from scratch after definitions are moved between modules, removed or given new signatures" {
  let s0 = unedited_sources();
  let twice = b"pub fn twice<a>(x: a, f: (a) -> a) -> a = f(f(x))\n";
  let moved = edited(
    edited(
      edited(
        edited(s0, b"core", twice, b""),
        b"leaf",
        b"pub fn one()",
        twice.concat(b"pub fn one()"),
      ),
      b"shop",
      b"import core",
      b"import core\nimport leaf",
    ),
    b"shop",
    b"core::twice",
    b"leaf::twice",
  );
  let removed = edited(
    edited(s0, b"shop", b"fn doubled(n: Int) -> Int = core::twice(n, |x: Int| x + x)\n", b""),
    b"core",
    twice,
    b"",
  );
  let spare = with_module(s0, b"spare", b"pub fn spare() -> Int = 9\n");
  let referenced = with_module(s0, b"extra", b"import leaf\npub fn three() -> Int = leaf::two()\n");
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"a definition moved between modules", moved),
      step(b"back", s0),
      step(b"a definition removed outright", removed),
      step(b"back again", s0),
      step(
        b"a dependency's signature changed",
        edited(s0, b"core", b"pub fn price(i: Item) -> Money =", b"pub fn price(i: Item) -> Int ="),
      ),
      step(b"reformatted", edited(s0, b"leaf", b"pub fn one()", b"// a comment\npub fn  one()")),
      step(b"an unreferenced file", spare),
      step(b"deleted", s0),
      step(b"a file importing the leaf", referenced),
      step(b"the leaf deleted under it", without(referenced, b"leaf")),
      step(b"the leaf restored", referenced),
    ]),
    [],
  )
}

test "checking with cached results matches checking from scratch when modules have identical definitions, similar effects or edited tests" {
  let peel = b"pub type Thing = | Wrap(Int)\npub fn peel(t: Thing) -> Int = match t { Wrap(n) -> n }\n";
  let shared = [{ name: b"a", source_text: peel }, { name: b"b", source_text: peel }];
  let look = b"pub effect db { read get[r](key: Int) -> Int }\npub fn look(k: Int) -> Int / {db.read[t]} = db.get[t](k)\n";
  let pick = |m: Bytes|
    Bytes::concat_all([
      b"import x\nimport y\npub fn pick(k: Int) -> Int / {",
      if m == b"x" { b"y" } else { b"x" },
      b"::db.read[t]} =\n  handle x::look(k) + y::look(k) with { ",
      m,
      b"::db.get[t](j) -> j, }\n",
    ]);
  let alike = [
    { name: b"x", source_text: look },
    { name: b"y", source_text: look },
    { name: b"z", source_text: b"pub fn plain() -> Int = 7\n" },
    { name: b"w", source_text: pick(b"x") },
  ];
  let alias = [
    { name: b"alias", source_text: b"pub type Cents = Int\npub fn zero() -> Cents = 0\n" },
    { name: b"user", source_text: b"import alias\nfn take() -> alias::Cents = alias::zero()\n" },
    { name: b"lone", source_text: b"fn lone() -> Int = 1\n" },
  ];
  let tested = b"fn f() -> Int = 1\ntest \"f is one\" { assert_eq(f(), 1) }\n";
  let palette = b"pub type Color = Red | Green\npub fn paint(what: String, shade: Color = Red) -> String =\n  match shade {\n    Red -> what.concat(\" red\"),\n    Green -> what.concat(\" green\"),\n  }\n";
  let wall = b"import palette\npub fn wall() -> String = palette::paint(\"wall\")\npub fn given() -> String = palette::paint(\"wall\", palette::Green)\ntest \"the default crosses the module boundary\" {\n  assert_eq(wall(), \"wall red\")\n}\n";
  let painted = [{ name: b"palette", source_text: palette }, { name: b"wall", source_text: wall }];
  assert_eq(
    disagreements([
      step(b"two definitions sharing a hash", shared),
      step(b"warm", shared),
      step(b"identically declared effects", alike),
      step(b"warm", alike),
      step(b"the handler switched to the other capability", with_module(alike, b"w", pick(b"y"))),
      step(
        b"an unrelated edit",
        with_module(with_module(alike, b"w", pick(b"y")), b"z", b"pub fn plain() -> Int = 8\n"),
      ),
      step(b"a type alias", alias),
      step(b"warm", alias),
      step(b"an unrelated edit", with_module(alias, b"lone", b"fn lone() -> Int = 2\n")),
      step(b"a test", [{ name: b"m", source_text: tested }]),
      step(b"a test added", [
        { name: b"m", source_text: tested.concat(b"test \"twice\" { assert_eq(f() + f(), 2) }\n") },
      ]),
      step(b"a test with a body already present", [
        { name: b"m", source_text: tested.concat(b"test \"still one\" { assert_eq(f(), 1) }\n") },
      ]),
      step(b"a cross-module default", painted),
      step(
        b"the default edited",
        edited(painted, b"palette", b"shade: Color = Red", b"shade: Color = Green"),
      ),
    ]),
    [],
  )
}

fn effect_user_module(module: Bytes) -> Bytes =
  Bytes::concat_all([
    b"import ",
    module,
    b"\npub fn look(k: Int) -> Int / {",
    module,
    b"::db.read[t]} = ",
    module,
    b"::db.get[t](k)\ntest \"looks\" { handle { assert_eq(look(1), 0) } with { ",
    module,
    b"::db.get[t](k) -> 0 } }\n",
  ])

fn effect_declaration() -> Bytes = b"pub effect db { read get[r](key: Int) -> Int }\n"

test "reusing cached results matches checking from scratch when an effect identical in structure to another is added, renamed or deleted" {
  let one = [
    { name: b"x", source_text: effect_declaration() },
    { name: b"p", source_text: effect_user_module(b"x") },
  ];
  let duplicates = [
    { name: b"a", source_text: effect_declaration() },
    { name: b"x", source_text: effect_declaration() },
    { name: b"p", source_text: effect_user_module(b"a") },
  ];
  let survivors = [
    { name: b"a", source_text: effect_declaration() },
    { name: b"x", source_text: effect_declaration() },
    { name: b"p", source_text: effect_user_module(b"x") },
  ];
  assert_eq(
    disagreements([
      step(b"cold", one),
      step(b"warm", one),
      step(b"an identical effect appeared", with_module(one, b"a", effect_declaration())),
      step(b"twins", duplicates),
      step(
        b"the fake renamed to sort first",
        with_module(duplicates, b"x", b"pub effect audit { read get[r](key: Int) -> Int }\n"),
      ),
      step(b"survivors", survivors),
      step(b"the module that ranked first deleted", without(survivors, b"a")),
    ]),
    [],
  )
}

test "checking with cached results matches checking from scratch after effect operations are reordered, tests are relabelled and exports change" {
  let effect_operations = |first: Bytes, second: Bytes|
    [
      {
        name: b"m",
        source_text: Bytes::concat_all([
          b"pub effect db {\n  ",
          first,
          b"\n  ",
          second,
          b"\n}\npub fn f() -> Int = 1\n",
        ]),
      },
    ];
  let get = b"read get[r](key: Int) -> Int";
  let put = b"write put[r](key: Int, value: String) -> Unit";
  let variants = |body: Bytes| [{ name: b"m", source_text: b"pub type T =\n".concat(body) }];
  let labelled = |label: Bytes|
    [
      {
        name: b"m",
        source_text: Bytes::concat_all([
          b"fn f() -> Int = 1\ntest \"",
          label,
          b"\" { assert_eq(f(), 1) }\n",
        ]),
      },
    ];
  let exported = [
    { name: b"a", source_text: b"pub fn one() -> Int = 1\n" },
    { name: b"b", source_text: b"import a\nfn two() -> Int = a::one() + a::one()\n" },
  ];
  assert_eq(
    disagreements([
      step(b"operations", effect_operations(get, put)),
      step(b"the operations reordered", effect_operations(put, get)),
      step(b"variants", variants(b"  | A(Int)\n  | B(String)\n")),
      step(b"the variants reordered", variants(b"  | B(String)\n  | A(Int)\n")),
      step(b"a test", labelled(b"f is one")),
      step(b"its label changed", labelled(b"f is really one")),
      step(b"and the run after that", labelled(b"f is really one")),
      step(b"an exported name", exported),
      step(b"its `pub` removed", with_module(exported, b"a", b"fn one() -> Int = 1\n")),
      step(
        b"a selective import",
        with_module(exported, b"b", b"import a (one)\nfn two() -> Int = one() + one()\n"),
      ),
      step(b"back to a module import", exported),
    ]),
    [],
  )
}

test "reusing cached results matches checking from scratch after the module of an opaque type is edited and the edit is undone" {
  let lib = b"pub opaque type Count = new { n: Int }\n\npub fn zero() -> Count = { n: 0 }\n\npub fn next(c: Count) -> Count = { n: c.n + 1 }\n\npub fn value(c: Count) -> Int = c.n\n";
  let s0 = [
    { name: b"lib", source_text: lib },
    {
      name: b"app",
      source_text: b"import lib\n\npub fn two() -> Int = lib::value(lib::next(lib::next(lib::zero())))\n\ntest \"two steps\" {\n  assert_eq(two(), 2)\n}\n",
    },
  ];
  let at = |what: Bytes, text: Bytes|
    [step(what, with_module(s0, b"lib", text)), step(what.concat(b", undone"), s0)];
  assert_eq(
    disagreements(
      [step(b"cold", s0)].concat(
        at(b"a function added", lib.concat(b"\npub fn gate_added() -> Int = 7\n")).concat(
          at(
            b"a body that now raises",
            Bytes::join(lib.split(b"= { n: 0 }"), b"= panic(\"x\")"),
          ).concat(
            at(
              b"a function made private",
              Bytes::join(lib.split(b"pub fn zero"), b"fn zero"),
            ).concat(
              at(
                b"a public function renamed",
                Bytes::join(lib.split(b"pub fn zero()"), b"pub fn zero_moved()"),
              ).concat(
                at(
                  b"a function removed",
                  Bytes::join(lib.split(b"\npub fn value(c: Count) -> Int = c.n\n"), b"\n"),
                ).concat(
                  at(
                    b"a test added",
                    lib.concat(b"\ntest \"the gate's test\" {\n  assert(true)\n}\n"),
                  ).concat(
                    at(
                      b"a field added",
                      Bytes::join(lib.split(b"new { n: Int }"), b"new { n: Int, m: Int }"),
                    ),
                  ),
                ),
              ),
            ),
          ),
        ),
      ),
    ),
    [],
  )
}

test "a test named like the function it tests gets its own hash, and reused results match a fresh check across a rejected edit and its undo" {
  let s0 = [
    {
      name: b"lib",
      source_text: b"pub effect log {\n  write emit(Bytes) -> Unit\n  read peek() -> Int\n}\n\npub fn say(b: Bytes) -> Unit / {log.write} = log.emit(b)\n",
    },
    {
      name: b"app",
      source_text: b"import lib\n\npub fn said() -> Int =\n  handle {\n    lib::say(b\"a\");\n    2\n  } with {\n    lib::log.emit(_) -> (),\n  }\n\ntest \"said\" {\n  assert_eq(said(), 2)\n}\n",
    },
  ];
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"a body that now panics", edited(s0, b"lib", b"= log.emit(b)", b"= panic(\"x\")")),
      step(b"and undone", s0),
    ]),
    [],
  )
}

test "reusing cached results matches checking from scratch after undone edits, a renamed module and a deleted imported module" {
  let s0 = unedited_sources();
  let leaf2 = b"pub fn one() -> Int = 1\npub fn two() -> Int = one() + 1\n";
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"a body edited", with_module(s0, b"leaf", leaf2)),
      step(b"and reverted", s0),
      step(
        b"a definition added",
        with_module(
          s0,
          b"leaf",
          leaf_module_source([]).concat(b"pub fn three() -> Int = two() + one()\n"),
        ),
      ),
      step(b"and deleted", s0),
      step(
        b"a module renamed",
        with_module(without(s0, b"leaf"), b"frond", leaf_module_source([])),
      ),
      step(b"and renamed back", s0),
      step(b"an imported module deleted", without(s0, b"core")),
      step(b"and restored", s0),
    ]),
    [],
  )
}

test "reusing cached results matches checking from scratch after a comment, an import alias, an emptied module and a dotted module name" {
  let s0 = unedited_sources();
  let aliased = edited(
    edited(s0, b"shop", b"import core", b"import core as c"),
    b"shop",
    b"core::",
    b"c::",
  );
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"a comment", with_module(s0, b"leaf", b"// a note\n".concat(leaf_module_source([])))),
      step(b"an import aliased", aliased),
      step(b"the alias removed", s0),
      step(b"an empty module", with_module(s0, b"empty", b"")),
      step(b"which gained a definition", with_module(s0, b"empty", b"pub fn now() -> Int = 1\n")),
      step(b"and went away", s0),
      step(b"a nested module beside a flat one", [
        { name: b"a", source_text: b"pub fn x() -> Int = 1\n" },
        { name: b"a.b", source_text: b"pub fn y() -> Int = 2\n" },
      ]),
      step(b"the nested module changed", [
        { name: b"a", source_text: b"pub fn x() -> Int = 1\n" },
        { name: b"a.b", source_text: b"pub fn y() -> Int = 3\n" },
      ]),
    ]),
    [],
  )
}

test "a module fixed after it was rejected beside a renamed import gives the same result as a fresh check" {
  let off = disagreements(steps_from_edits([[LeafError, CoreRenamed], [LeafError]]));
  assert(off.len() == 0, Some(String::of_bytes_lossy(Bytes::join(off, b"; "))))
}

test "checking with cached results matches checking from scratch after deleting module `leaf` while another module has an error, then moving `twice`, then deleting `leaf` again" {
  let off = disagreements(
    steps_from_edits([[LeafDeleted, LeafError], [TwiceMoved, LeafDeleted], [LeafError]]),
  );
  assert(off.len() == 0, Some(String::of_bytes_lossy(Bytes::join(off, b"; "))))
}

test "checking with cached results matches checking from scratch after renaming an effect and adding a test, then renaming a type and moving `twice`, then renaming the type back" {
  let off = disagreements(
    steps_from_edits([
      [EffectRenamed, TestAdded],
      [TypeRenamed, TwiceMoved],
      [TypeRenamed, ShopBody],
    ]),
  );
  assert(off.len() == 0, Some(String::of_bytes_lossy(Bytes::join(off, b"; "))))
}

test "a session of renames, an error fixed and a duplicate added gives the same result as a fresh check" {
  let off = disagreements(
    steps_from_edits([
      [CoreRenamed],
      [EffectRenamed, DefaultEdited, DefaultEdited, DefaultEdited, DefaultEdited, TestAdded],
      [
        TypeRenamed,
        DefaultEdited,
        CoreResultType,
        LeafError,
        LeafFunctionPrivate,
        TestAdded,
        DefaultEdited,
        LeafError,
      ],
      [
        CoreRenamed,
        CoreBody,
        DefaultEdited,
        EffectRenamed,
        LeafImportsCore,
        DuplicateAdded,
        LeafError,
        LeafError,
        CoreResultType,
        LeafFunctionPrivate,
        LeafBody,
        ExtraAdded,
        ShopBody,
        TypeRenamed,
        CoreRenamed,
      ],
    ]),
  );
  assert(off.len() == 0, Some(String::of_bytes_lossy(Bytes::join(off, b"; "))))
}

test "checking with cached results matches checking from scratch after editing a body in module `core`, then renaming module `core` and adding a test" {
  let off = disagreements(steps_from_edits([[CoreBody], [CoreRenamed, TestAdded]]));
  assert(off.len() == 0, Some(String::of_bytes_lossy(Bytes::join(off, b"; "))))
}

fn changes() -> gen::Gen<Change> =
  gen::elements([
    LeafBody,
    LeafSignature,
    LeafFunctionPrivate,
    LeafError,
    LeafImportsCore,
    LeafReformatted,
    LeafDeleted,
    CoreRenamed,
    CoreBody,
    CoreResultType,
    TypeRenamed,
    EffectRenamed,
    TwiceMoved,
    DoubledRemoved,
    ShopBody,
    ShopImportsLeaf,
    DefaultEdited,
    TestAdded,
    ExtraAdded,
    ExtraBody,
    DuplicateAdded,
  ])

fn module_keys() -> gen::Gen<ModuleKey> =
  gen::map3(gen::bytes(), gen::bool(), gen::bool(), |module: Bytes, shipped: Bool, tested: Bool|
    { module: module, shipped: shipped, tested: tested })

fn interface_keys() -> gen::Gen<InterfaceKey> =
  gen::map4(
    gen::bytes(),
    gen::bool(),
    gen::bool(),
    gen::bytes(),
    |module: Bytes, shipped: Bool, tested: Bool, name: Bytes|
      { module: module, shipped: shipped, full_text: tested, name: name },
  )

fn embeddings() -> gen::Gen<Embedding> =
  gen::map2(
    gen::list(gen::map2(gen::bytes(), gen::bytes(), embed_file)),
    gen::option_of(gen::bytes()),
    |files: List<EmbedFile>, rejected: Option<Bytes>| { files: files, rejected: rejected },
  )

fn package_locations() -> gen::Gen<PackageLocation> =
  gen::map2(gen::any_int(), gen::bytes(), |package: Int, relative: Bytes|
    { package: package, relative: relative })

fn drawn_sessions() -> gen::Gen<List<List<Change>>> =
  gen::and_then(gen::int_between(1, 3), |steps: Int|
    gen::list_of_length(gen::list_of(changes(), 3), steps))

pub fn drawn_session(root: Int, size: Int) -> List<Step> / {abort.raise} =
  match gen::sample(drawn_sessions(), root, b"edit session", size, None).value {
    Some(edits) -> steps_from_edits(edits),
    None -> panic("a session of edits has no condition to give up on"),
  }

fn chain_lib(label: Bytes) -> Bytes =
  Bytes::concat_all([
    b"pub effect log { write note[r](msg: String) -> Int }\npub fn base(n: Int) -> Int / {log.note[",
    label,
    b"]} = log.note[",
    label,
    b"](\"n\") + n\npub fn mid(n: Int) -> Int / {log.note[",
    label,
    b"]} = base(n) + 1\n",
  ])

test "reusing cached results matches checking from scratch when a function's effects change beneath a caller that was already checked" {
  let before = [
    { name: b"lib", source_text: chain_lib(b"a") },
    {
      name: b"top",
      source_text: b"import lib\npub fn top(n: Int) -> Int / {lib::log.write[a]} = lib::mid(n) + 1\n",
    },
  ];
  let after = [
    { name: b"lib", source_text: chain_lib(b"b") },
    {
      name: b"top",
      source_text: b"import lib\npub fn top(n: Int) -> Int / {lib::log.write[b]} = lib::mid(n) + 2\n",
    },
  ];
  assert_eq(
    disagreements([
      step(b"cold", before),
      step(b"the effects moved under a checked caller", after),
    ]),
    [],
  );
  let stale = [
    { name: b"lib", source_text: chain_lib(b"a") },
    {
      name: b"top",
      source_text: b"import lib\npub fn top(n: Int) -> Int / {lib::log.note[a]} = lib::mid(n) + 1\n",
    },
  ];
  let moved = with_module(stale, b"lib", chain_lib(b"b"));
  assert_eq(disagreements([step(b"cold", stale), step(b"the callee's effects moved", moved)]), []);
  let warm = queried_over(queried_over(empty_memory_store(), stale).store, moved);
  assert(match warm.outcome { Rejected(_) -> true, Analysed(_) -> false })
}

test "`keep` written on an imported function, or dropped, leaves the result through the store matching the fresh one" {
  let lib = |param: Bytes|
    {
      name: b"lib",
      source_text: Bytes::concat_all([b"pub fn hold(h: ", param, b") -> Int = h(0)\n"]),
    };
  let app = {
    name: b"app",
    source_text: b"import lib\npub fn go(g: (Int) -> Int) -> Int = lib::hold(g)\n",
  };
  let borrowed = [lib(b"(Int) -> Int"), app];
  let with_keep = [lib(b"keep (Int) -> Int"), app];
  assert_eq(
    disagreements([
      step(b"cold", borrowed),
      step(b"keep written", with_keep),
      step(b"keep dropped", borrowed),
    ]),
    [],
  );
  let warm = queried_over(queried_over(empty_memory_store(), borrowed).store, with_keep);
  assert(match warm.outcome { Rejected(_) -> true, Analysed(_) -> false })
}

test "deleting an unused function that another module imports by name is rejected, with cached results as with checking from scratch" {
  let s0 = [
    { name: b"lib", source_text: b"pub fn used() -> Int = 1\npub fn spare() -> Int = 2\n" },
    { name: b"app", source_text: b"import lib (used, spare)\nfn go() -> Int = used()\n" },
  ];
  let gone = with_module(s0, b"lib", b"pub fn used() -> Int = 1\n");
  assert_eq(
    disagreements([step(b"cold", s0), step(b"warm", s0), step(b"the name deleted", gone)]),
    [],
  );
  match queried_over(queried_over(empty_memory_store(), s0).store, gone).outcome {
    Analysed(_) -> panic("an import of a deleted name checked"),
    Rejected(ds) ->
      assert(
        ds.fold(false, |accumulator: Bool, diagnostic: Diagnostic|
          accumulator || diagnostic.code == b"E0101"),
      ),
  }
}

test "checking with cached results matches checking from scratch after narrowing an effect annotation and renaming an effect's resource variable" {
  let narrowing = |row: Bytes|
    [
      {
        name: b"m",
        source_text: Bytes::concat_all([
          b"pub effect db { read get[r](key: Int) -> Int }\npub fn look(k: Int) -> Int / ",
          row,
          b" = db.get[a](k)\n",
        ]),
      },
    ];
  let labelled = |label: Bytes|
    [
      {
        name: b"m",
        source_text: Bytes::concat_all([
          b"pub effect db { read get[r](key: Int) -> Int }\npub fn look(k: Int) -> Int / {db.read[",
          label,
          b"]} = db.get[",
          label,
          b"](k)\n",
        ]),
      },
      {
        name: b"u",
        source_text: Bytes::concat_all([
          b"import m\nfn use_it() -> Int / {m::db.read[",
          label,
          b"]} = m::look(1)\n",
        ]),
      },
    ];
  let renamed = |ty: Bytes|
    [
      {
        name: b"a",
        source_text: Bytes::concat_all([
          b"pub type ",
          ty,
          b" = | Mk(Int)\npub fn mk() -> ",
          ty,
          b" = Mk(1)\n",
        ]),
      },
      {
        name: b"b",
        source_text: Bytes::concat_all([b"import a\npub fn get() -> a::", ty, b" = a::mk()\n"]),
      },
      { name: b"c", source_text: b"import b\npub fn top() -> Bool = { b::get(); true }\n" },
    ];
  assert_eq(
    disagreements([
      step(b"a wide annotation", narrowing(b"{db.read[a], db.read[b]}")),
      step(b"the annotation narrowed", narrowing(b"{db.read[a]}")),
      step(b"a resource", labelled(b"a")),
      step(b"the resource relabelled", labelled(b"z")),
      step(b"a type", renamed(b"T")),
      step(b"the type renamed two modules away", renamed(b"Renamed")),
    ]),
    [],
  )
}

test "the order of a result's definitions, effects and types is the same with cached results as with checking from scratch" {
  let s0 = [
    {
      name: b"app",
      source_text: b"import lib\npub effect audit { write note[log](m: Int) -> Unit }\npub type Wrapped = | Wrap(Int) | Empty\nfn second() -> Int = lib::base()\nfn first() -> Int = second()\n",
    },
    {
      name: b"lib",
      source_text: b"pub effect db { read get[t](k: Int) -> Int }\npub type Row = | Cell(Int)\npub fn base() -> Int = 1\n",
    },
  ];
  assert_eq(disagreements([step(b"cold", s0), step(b"warm", s0)]), [])
}

fn effect_sources(extra: List<Source>) -> List<Source> =
  extra.concat([
    { name: b"core", source_text: b"pub effect db {\n  read get[r](key: Int) -> Int\n}\n" },
    {
      name: b"shop",
      source_text: b"import core\npub fn touch(k: Int) -> Int / {core::db.read[cart]} = core::db.get[cart](k)\ntest \"touch is handled\" {\n  assert_eq(handle touch(1) with { core::db.get[cart](k) -> k + 1, }, 2)\n}\n",
    },
  ])

fn seeded_agrees(before: List<Source>, after: List<Source>) -> Bool / {abort.raise} =
  disagreements([step(b"before", before), step(b"after", after)]) == []

test "checking with cached results matches checking from scratch after adding an effect with the same operation signature as an existing one" {
  let alike = [
    { name: b"aaa", source_text: b"pub effect alpha {\n  read get[r](key: Int) -> Int\n}\n" },
  ];
  assert(seeded_agrees(effect_sources([]), effect_sources([])));
  assert(seeded_agrees(effect_sources([]), effect_sources(alike)))
}

test "adding an unrelated effect leaves cached results matching checking from scratch" {
  let other = [
    { name: b"aaa", source_text: b"pub effect alpha {\n  write put(key: Int) -> Int\n}\n" },
  ];
  assert(seeded_agrees(effect_sources([]), effect_sources(other)))
}

test "module keys, interface keys, embeddings and package locations in cache queries decode to the values that were encoded" {
  gen::check4(
    module_keys(),
    interface_keys(),
    embeddings(),
    package_locations(),
    |n: ModuleKey, e: InterfaceKey, m: Embedding, p: PackageLocation| {
      bin::round_trips(n, module_key_bin()) && bin::round_trips(e, interface_key_bin())
        && bin::round_trips(m, embedding_bin())
        && bin::round_trips(p, package_location_bin())
    },
  )
}

fn run_count(run: Run, name: Bytes) -> Int =
  query_stats(run).fold(0, |n: Int, t: QueryStats| if t.query == name { t.ran } else { n })

fn groups_ran(run: Run, name: Bytes) -> List<GroupKey> / {abort.raise} =
  executed_for(run, name).map(|b: Bytes| decoded(b, group_key_bin(), "a group's names"))

fn group_in(module: Bytes, owners: List<Bytes>) -> GroupKey =
  { module: module, shipped: false, tested: false, owners: owners }

fn modules_ran(run: Run, name: Bytes) -> List<Bytes> / {abort.raise} =
  sorted_bytes(
    executed_for(run, name).map(|b: Bytes| decoded(b, module_key_bin(), "a module's name").module),
  )

fn same_groups(a: List<GroupKey>, b: List<GroupKey>) -> Bool =
  a.len() == b.len() && b.all(|g: GroupKey| a.contains(g))

fn hashed_fixture() -> List<Source> =
  [
    {
      name: b"base",
      source_text: b"pub effect tick { write beat() -> Unit }\npub opaque type Coin = new { cents: Int }\npub fn coin(n: Int) -> Coin = { cents: n }\npub fn cents(c: Coin) -> Int = c.cents\npub fn even(n: Int) -> Bool / { tick.write } = if n <= 0 { true } else { tick.beat(); odd(n - 1) }\nfn odd(n: Int) -> Bool / { tick.write } = if n <= 0 { false } else { even(n - 1) }\nfn spare() -> Int = 3\npub fn half(n: Int) -> Int requires n >= 0 ensures result <= n = n / 2\nlaw \"halving shrinks\" forall (n: Int) where n >= 0 { half(n) <= n }\npub fn width(b: Bytes) -> Int\n  cost b.len()\n= b.len()\n",
    },
    {
      name: b"app",
      source_text: b"import base\npub fn worth(n: Int) -> Int = base::cents(base::coin(base::half(n)))\ntest \"worth\" { assert_eq(worth(4), 2) }\n",
    },
  ]

test "a program hashed from its modules' results has the same hashes and warnings as the program hashed in one pass" {
  [unedited_sources(), hashed_fixture()].fold((), |u: Unit, sources: List<Source>| {
    let fixed = check_sources(empty_memory_store(), sources, []);
    let whole = load_with_shipped(sources, []);
    match ((
        whole.hashed,
        checked_staged(whole, no_rows()).out,
        load_with_shipped(sources, [], fixed: fixed.cached_hashes).hashed,
      )) {
      (Ok(read), Analysed(checked), Ok(taken)) -> {
        assert_eq(taken.hashes, checked.hashes);
        assert_eq(taken.unused, []);
        assert_eq(
          owner_checks::diagnostic_summaries(fixed.warnings),
          owner_checks::diagnostic_summaries(read.unused),
        )
      },
      _ -> panic("the fixture hashes"),
    }
  })
}

test "assembling a program from per-module check results gives the same definitions, tests and effects as checking the whole program at once" {
  [unedited_sources(), hashed_fixture(), faceted(), faceted().reverse()].fold(
    (),
    |u: Unit, sources: List<Source>| {
      let fixed = check_sources(empty_memory_store(), sources, []);
      match analyse_pulling_std_with(sources, [], no_rows()).out {
        Rejected(_) -> panic("the fixture program was rejected by the checker"),
        Analysed(w) -> {
          let returned = assembled_program(
            fixed.results.map(|a: CheckedModule| facts_of_result(a.result)),
            fixed.cached_hashes,
            with_prelude_source([]).fold(Map::new(), |accumulator: Map<Bytes, Bytes>, s: Source|
              accumulator.insert(s.name, s.source_text)),
            true,
            true,
            w.warnings,
            w.manifest,
            w.packages,
            w.locked_packages,
            w.module_packages,
            w.embeds,
          );
          assert_eq(returned.view.checked.definitions, w.checked.definitions);
          assert_eq(returned.view.frame.tagged, checked_program_of(w).frame.tagged);
          assert_eq(returned.view, checked_program_of(w));
          let made = view_dump(returned.view, None);
          let whole = dump_of(Analysed(w));
          assert_eq(made.definitions, whole.definitions);
          assert_eq(made.tests, whole.tests);
          assert_eq(made.effects, whole.effects);
          assert_eq(made.constructors, whole.constructors);
          assert_eq(made.hashes, whole.hashes);
          assert_eq(made.keys, whole.keys);
          assert_eq(made.emitter_roots, whole.emitter_roots);
          assert_eq(made.rows, whole.rows);
          let walked = |b: Bytes|
            match bin::decode(b, inferred_facts_bin()) {
              Ok(w) -> w,
              Err(_) -> panic("walked facts decode"),
            };
          let a = walked(made.inferred_facts);
          let b = walked(whole.inferred_facts);
          assert_eq(a.pure, b.pure);
          assert_eq(a.orders, b.orders);
          assert_eq(a.law_facts, b.law_facts);
          assert_eq(made.inferred_facts, whole.inferred_facts);
          assert_eq(made, whole)
        },
      }
    },
  )
}

fn shipped_import_sources() -> { user: List<Source>, shipped: List<Source> } =
  {
    user: [
      {
        name: b"main",
        source_text: b"import std.shapes\nimport std.shapes (origin, far, Tag, size)\npub fn main() -> Int = far(origin()) + size(0 - 1) + shapes\"two\"\npub fn named(t: Tag) -> String = \"{t}\"\npub fn ranked(t: Tag) -> Int = t.rank(more: 2)\ntest \"sized\" { assert_eq(size(0 - 3), 3) }\n",
      },
    ],
    shipped: [
      {
        name: b"std.shapes",
        source_text: b"pub type Point = { x: Int, y: Int }\npub fn origin() -> Point = { x: 0, y: 0 }\npub fn far(p: Point) -> Int requires p.x >= 0 = p.x + helper(p)\nfn helper(p: Point) -> Int = p.y\nfn spare() -> Int = 5\npub fn unreached() -> Int requires spare() > 0 = spare()\npub type Tag = | A | B\nfn tag_text(t: Tag) -> String = match t { A -> \"a\", B -> \"b\" }\nshow for Tag by tag_text\npub fn Tag::rank(t: Tag, by: Int = 1, more: Int = 0) -> Int = match t { A -> by, B -> by + more }\npub fn size<a>(n: a) -> a where numeric(a) = { let zero: a = numeric_of_int(0); if n < zero { zero - n } else { n } }\npub fn spare_size<a>(n: a) -> a where numeric(a) = n\npub fn literal(text: String) -> Result<Int, { message: String, offset: Int }> = if text == \"two\" { Ok(2) } else { Err({ message: \"not two\", offset: 0 }) }\ntest \"shipped\" { let t = A; assert_eq(far(origin()), t.rank(by: 0)) }\n",
      },
    ],
  }

fn load_with_analysis(
  f: { user: List<Source>, shipped: List<Source> },
  tested: Bool,
  used_only: Bool,
) -> { loaded: AssembledLoad, assembled: CheckedProgram, whole: Analysis } / {abort.raise} = {
  let w = load_inputs_of(
    {
      root: b"",
      manifest: None,
      files: f.user.map(|s: Source| { module: s.name, text: s.source_text }),
    },
    [],
  );
  let shipped = with_prelude_source(f.shipped);
  let texts = shipped.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, s: Source|
    accumulator.insert(s.name, s.source_text));
  let text_of = |name: Bytes| texts.get(name);
  let names = shipped.map(|s: Source| s.name);
  let done = over_decoding(
    empty_memory_store(),
    packs::no_pack,
    b"",
    |kind: Bytes, at: Bytes|
      lookup_input(w, text_of, text_of, || names, reject_embed, nothing_derived, kind, at),
    || {
      let qs = fresh_registry();
      let all = query_load(qs, w.own, if tested { names } else { [] }, tested, start_run(qs));
      let fixed = hashed_all(qs, w.own, all.value.pulled, tested, all.run);
      {
        results: all.value.results,
        pulled: all.value.pulled,
        fixing: joined_cached_hashes(fixed.value),
      }
    },
  ).value;
  let loaded = assembled_load(
    f.user.map(|s: Source| s.name),
    { root: b"", manifest: None, supplied: [] },
    done.results.fold(Map::new(), |accumulator: Map<Bytes, ModuleShape>, a: CheckedModule|
      accumulator.insert(a.module, a.result.shape)),
    done.fixing,
    done.pulled,
    names,
    texts,
    true,
    used_only,
    root_warnings(done.results, f.user.len()),
  );
  match analyse_pulling_std_with(f.user, f.shipped, no_rows(), cut_unused: used_only).out {
    Rejected(_) -> panic("the test program fails to check"),
    Analysed(whole) ->
      {
        loaded: loaded,
        assembled: checked_program_from_results(
          loaded.frame,
          loaded.reads,
          done.results.fold(
            Map::new(),
            |accumulator: Map<Bytes, ModuleResult>, a: CheckedModule|
              accumulator.insert(a.module, a.result),
          ),
        ),
        whole: whole,
      },
  }
}

test "a program assembled from its modules' results, including a shipped module's, equals the program checked all at once" {
  let f = shipped_import_sources();
  [{ tested: false, reachable: true }, { tested: true, reachable: false }].fold(
    (),
    |u: Unit, mode: { tested: Bool, reachable: Bool }| {
      let x = load_with_analysis(f, mode.tested, mode.reachable);
      let loaded = x.loaded;
      let assembled = x.assembled;
      let view = checked_program_of(x.whole);
      assert_eq(loaded.pulled, [b"std.prelude", b"std.shapes"]);
      assert_eq(
        assembled.checked.tests.filter(|t: TestInfo| t.module != prelude_module()).len(),
        if mode.tested { 2 } else { 1 },
      );
      assert_eq(loaded.frame.outlines, view.frame.outlines);
      assert_eq(assembled.checked.definitions, view.checked.definitions);
      assert_eq(assembled.checked.facts, view.checked.facts);
      assert_eq(assembled.checked, view.checked);
      match load_with_shipped(f.user, f.shipped, cut_unused: mode.reachable).hashed {
        Ok(h) ->
          assert(
            checked_body(body_named(h.hashes.bodies, b"main.ranked"), Map::new())
              != body_named(view.frame.hashes.bodies, b"main.ranked"),
          ),
        Err(_) -> panic("the fixture hashes"),
      };
      assert_eq(loaded.frame.hashes, view.frame.hashes);
      assert_eq(assembled, view);
      assert_eq(functions_of(loaded.frame), assembled.checked.definitions.len());
      assert_eq(tests_of(loaded.frame, 1), 1);
      assert_eq(view_dump(assembled, None), dump_of(Analysed(x.whole)))
    },
  )
}

fn reading_unimported() -> { user: List<Source>, shipped: List<Source> } =
  {
    user: [
      {
        name: b"main",
        source_text: b"pub fn first(xs: List<Int>) -> Int / {abort.raise, task.write} = {\n  task.yield();\n  xs.get(0)\n}\n",
      },
    ],
    shipped: [
      {
        name: b"std.list",
        source_text: b"pub fn List::get<a>(xs: List<a>, i: Int) -> a / {abort.raise} = match xs.at(i) { Some(x) -> x, None -> panic(\"no element there\") }\n",
      },
      { name: b"std.internal.schedule", source_text: b"pub fn idle() -> Int = 0\n" },
    ],
  }

test "a module's result lists `std.list` and the scheduler module as used without an import, the same as a whole-program check" {
  let x = load_with_analysis(reading_unimported(), false, true);
  assert_eq(x.loaded.frame.unimported.at(0), Some([b"std.list", b"std.internal.schedule"]));
  assert_eq(x.loaded.frame.unimported, checked_program_of(x.whole).frame.unimported);
  assert_eq(view_dump(x.assembled, None).modules, dump_of(Analysed(x.whole)).modules)
}

fn body_named(bodies: List<{ name: Bytes, body: Bytes }>, name: Bytes) -> Bytes / {abort.raise} =
  match bodies.find(|b: { name: Bytes, body: Bytes }| b.name == name) {
    Some(b) -> b.body,
    None -> panic("no body found for " ++ String::of_bytes_lossy(name)),
  }

test "a function body that calls a method on a value records the same check results whether the program is checked whole or module by module" {
  [
    {
      names: false,
      sources: [
        {
          name: b"m",
          source_text: b"pub type T = | T(Int)\nfn T::size(t: T) -> Int = match t { T(n) -> n }\npub fn f(t: T) -> Int = t.size()\n",
        },
      ],
    },
    {
      names: true,
      sources: [
        {
          name: b"low",
          source_text: b"pub type T = | T(Int)\npub fn T::size(t: T) -> Int = match t { T(n) -> n }\npub fn T::scaled(t: T, by: Int = 2, plus: Int = 0) -> Int = t.size() * by + plus\n",
        },
        {
          name: b"m",
          source_text: b"import low\npub fn f(t: low::T) -> Int = t.scaled(plus: 3)\n",
        },
      ],
    },
    {
      names: false,
      sources: [
        {
          name: b"m",
          source_text: b"pub fn f(xs: List<Int>) -> Int = xs.fold(0, |a: Int, x: Int| a + x)\n",
        },
      ],
    },
  ].fold((), |u: Unit, fixture: { names: Bool, sources: List<Source> }| {
    let returned = check_sources(empty_memory_store(), fixture.sources, [
    ]).cached_hashes.nodes.fold(b"", |accumulator: Bytes, x: CachedNode|
      if x.name == b"m.f" { x.body } else { accumulator });
    match analyse_pulling_std_with(fixture.sources, [], no_rows()).out {
      Rejected(_) -> panic("the fixture program was rejected by the checker"),
      Analysed(w) -> assert_eq(body_named(w.hashes.bodies, b"m.f"), returned),
    };
    match load_with_shipped(fixture.sources, []).hashed {
      Ok(h) -> {
        let unchecked = body_named(h.hashes.bodies, b"m.f");
        if fixture.names {
          assert_eq(body_key(unchecked), None);
          assert(checked_body(unchecked, Map::new()) != returned)
        } else { assert_eq(unchecked, returned) }
      },
      Err(_) -> panic("the fixture hashes"),
    }
  })
}

test "a run over an unchanged program runs no query again" {
  let sources = layered(b"pub fn step(n: Int) -> Int = n + 1\n");
  let cold = queried_over(empty_memory_store(), sources);
  assert_eq(modules_ran(cold.run, module_query()), [b"app", b"aside", b"lib"]);
  assert_eq(executed_count(queried_over(cold.store, sources).run), 0)
}

test "a body edit checks its own definition again and none that reads it" {
  let before = layered(b"pub fn step(n: Int) -> Int = n * 3\n");
  let after = layered(b"pub fn step(n: Int) -> Int = n * 4\n");
  let warm = queried_over(queried_over(empty_memory_store(), before).store, after);
  assert_eq(groups_ran(warm.run, group_query()), [group_in(b"lib", [b"step"])]);
  assert_eq(modules_ran(warm.run, module_query()), [b"lib"]);
  assert_eq(outcome_summary(warm.outcome), outcome_summary(analyse(parse_all(after))))
}

fn paired(base: Bytes, step: Bytes) -> List<Source> =
  [
    {
      name: b"lib",
      source_text: Bytes::concat_all([
        b"pub fn even(n: Int) -> Bool = if n <= 0 { ",
        base,
        b" } else { odd(n - 1) }\n\npub fn odd(",
        step,
        b": Int) -> Bool = if ",
        step,
        b" <= 0 { false } else { even(",
        step,
        b" - 1) }\n\npub fn both(n: Int) -> Bool = even(n) || odd(n)\n",
      ]),
    },
  ]

fn owners_ran(run: Run, name: Bytes) -> List<Bytes> / {abort.raise} =
  executed_for(run, name).map(|b: Bytes| decoded(b, owner_key_bin(), "an owner's name").owner)

test "after a failing edit is reverted, checking again reruns no checks and reuses every cached result" {
  let source = |body: Bytes|
    [
      {
        name: b"lib",
        source_text: Bytes::concat_all([
          b"pub fn base(n: Int) -> Int = ",
          body,
          b"\n\npub fn over(n: Int) -> Int = base(n) + 1\n\npub fn top(n: Int) -> Int = over(n) * 2\n\n",
          b"pub fn apart(n: Int) -> Int = n - 1\n",
        ]),
      },
    ];
  let cold = queried_over(empty_memory_store(), source(b"n + 1"));
  let broken = queried_over(cold.store, source(b"n + true"));
  assert_eq(
    outcome_summary(broken.outcome),
    outcome_summary(analyse(parse_all(source(b"n + true")))),
  );
  let mended = queried_over(broken.store, source(b"n + 1"));
  assert_eq(outcome_summary(mended.outcome), outcome_summary(cold.outcome));
  assert_eq(groups_ran(mended.run, group_query()), [])
}

test "when a set of definitions fails to check, its hash is computed without the hash of each definition in it" {
  let keyed = |name: Bytes, statement: Bytes, more: Bytes|
    [
      {
        name: b"lib",
        source_text: Bytes::concat_all([
          b"pub type Tag =\n  | Tag(Int)",
          more,
          b"\n\npub fn ",
          name,
          b"(t: Tag) -> Int =\n  match t {\n    Tag(n) -> n,\n  }\n\n",
          statement,
          b"\n\npub fn tagged(n: Int) -> Tag = Tag(n)\n",
        ]),
      },
      {
        name: b"app",
        source_text: b"import lib\n\npub fn same(a: lib::Tag, b: lib::Tag) -> Bool = a == b\n",
      },
    ];
  let fixture = keyed(b"tag_key", b"key for Tag by tag_key", b"");
  assert_eq(
    disagreements([
      step(b"a type keyed by its function", fixture),
      step(
        b"a variant its function does not match",
        keyed(b"tag_key", b"key for Tag by tag_key", b" | Other"),
      ),
      step(b"back", fixture),
      step(b"the function renamed", keyed(b"tag_key_moved", b"key for Tag by tag_key", b"")),
      step(b"back again", fixture),
      step(b"the statement dropped", keyed(b"tag_key", b"", b"")),
      step(b"and back", fixture),
    ]),
    [],
  )
}

test "editing one function body in mutually recursive functions rechecks only that body, but redoes the shared signature analysis for all of them" {
  let before = paired(b"true", b"n");
  let cold = queried_over(empty_memory_store(), before);
  assert_eq(outcome_summary(cold.outcome), outcome_summary(analyse(parse_all(before))));
  let after = paired(b"n == 0", b"n");
  let warm = queried_over(cold.store, after);
  assert_eq(owners_ran(warm.run, typed_query()), [b"even"]);
  assert(groups_ran(warm.run, group_query()).contains(group_in(b"lib", [b"even", b"odd"])));
  assert_eq(outcome_summary(warm.outcome), outcome_summary(analyse(parse_all(after))));
  let renamed = paired(b"n == 0", b"left");
  let again = queried_over(warm.store, renamed);
  let rewalked = owners_ran(again.run, typed_query());
  assert(rewalked.len() == 2 && rewalked.contains(b"even") && rewalked.contains(b"odd"));
  assert_eq(outcome_summary(again.outcome), outcome_summary(analyse(parse_all(renamed))));
  let broken = paired(b"n", b"left");
  assert_eq(
    outcome_summary(queried_over(again.store, broken).outcome),
    outcome_summary(analyse(parse_all(broken))),
  )
}

fn recursive_types_sources(more: Bytes) -> List<Source> =
  [
    {
      name: b"lib",
      source_text: range(0, 80).fold(
        Bytes::concat_all([
          b"pub type Step = | Step(Int)",
          more,
          b"\n\npub type Count = | Count(Step)\n\npub fn made(n: Int) -> Count = Count(Step(n))\n\n",
          b"pub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1, made(n)) }\n\n",
          b"pub fn odd(n: Int, _c: Count) -> Bool = if n <= 0 { false } else { even(n - 1) }\n",
        ]),
        |text: Bytes, i: Int|
          Bytes::concat_all([
            text,
            b"\npub fn pad",
            Bytes::of_string(i.to_string()),
            b"() -> Int = 0\n",
          ]),
      ),
    },
  ]

test "a function body checked as part of a whole-module check is rechecked when a sibling definition's signature changes" {
  let before = recursive_types_sources(b"");
  let cold = queried_over(empty_memory_store(), before);
  assert_eq(outcome_summary(cold.outcome), outcome_summary(analyse(parse_all(before))));
  let after = recursive_types_sources(b" | Rest");
  let warm = queried_over(cold.store, after);
  assert(owners_ran(warm.run, typed_query()).contains(b"even"));
  assert_eq(outcome_summary(warm.outcome), outcome_summary(analyse(parse_all(after))))
}

fn derive_sources(more: Bytes) -> List<Source> =
  [
    { name: b"sizes", source_text: b"pub fn derive(declaration: Bytes) -> Bytes = declaration\n" },
    {
      name: b"lib",
      source_text: range(0, 40).fold(
        Bytes::concat_all([
          b"import sizes\n\npub type Tree = | Branch(List<Grove>)",
          more,
          b"\n\npub type Grove = | Grove(List<Tree>)\n\nderive sizes for Tree\n\nderive sizes for Grove\n",
        ]),
        |text: Bytes, i: Int|
          Bytes::concat_all([
            text,
            b"\npub fn pad",
            Bytes::of_string(i.to_string()),
            b"() -> Int = 0\n",
          ]),
      ),
    },
  ]

fn sized(at: Bytes) -> Option<Bytes> / {abort.raise} =
  match bin::decode(at, deriver_request_bin()) {
    Err(_) -> None,
    Ok(ask) -> match value::decode(ask.declaration) {
      Some(VList([VRecord(fields)])) -> match value::field_named(fields, "target") {
        Some(VStr(target)) ->
          Some(
            bin::encode(
              Generated(
                Bytes::concat_all([
                  b"pub fn ",
                  Bytes::of_string(target),
                  b"::size() -> Int = ",
                  Bytes::of_string(ask.declaration.len().to_string()),
                ]),
              ),
              deriver_response_bin(),
            ),
          ),
        _ -> None,
      },
      _ -> None,
    },
  }

test "changing a type that other types derive functions from rechecks the generated code of each deriving type" {
  let cold = check_sources(empty_memory_store(), derive_sources(b""), [], derived: sized);
  let after = derive_sources(b" | Twig(List<Grove>)");
  let warm = check_sources(cold.store, after, [], derived: sized);
  assert(owners_ran(warm.run, typed_query()).contains(b"Tree"));
  assert(owners_ran(warm.run, typed_query()).contains(b"Grove"));
  assert_eq(warm.results, check_sources(empty_memory_store(), after, [], derived: sized).results)
}

fn stack_queue_sources(stack: Bytes, queue: Bytes) -> List<Source> =
  [
    {
      name: b"lib",
      source_text: Bytes::concat_all([
        b"pub type Stack = | Stack(List<Int>)\n\npub type Queue = | Queue(List<Int>, List<Int>)\n\n",
        b"pub fn Stack::len(s: Stack) -> Int = match s { Stack(xs) -> ",
        stack,
        b" }\n\npub fn Queue::len(q: Queue) -> Int = match q { Queue(f, b) -> ",
        queue,
        b" + b.len() }\n",
      ]),
    },
  ]

test "editing a body in definitions that are not mutually recursive rechecks only that definition and recomputes no signatures" {
  let before = stack_queue_sources(b"xs.len()", b"f.len()");
  let cold = queried_over(empty_memory_store(), before);
  assert_eq(outcome_summary(cold.outcome), outcome_summary(analyse(parse_all(before))));
  let after = stack_queue_sources(b"xs.len() + 0", b"f.len()");
  let warm = queried_over(cold.store, after);
  assert_eq(owners_ran(warm.run, typed_query()), [b"Stack::len"]);
  assert_eq(groups_ran(warm.run, group_query()), [group_in(b"lib", [b"Stack::len"])]);
  assert_eq(run_count(warm.run, signatures_query()), 0);
  assert_eq(run_count(warm.run, cycles_query()), 0);
  assert_eq(outcome_summary(warm.outcome), outcome_summary(analyse(parse_all(after))));
  let calling = stack_queue_sources(b"xs.len() + 0", b"Stack(f).len()");
  let called = queried_over(warm.store, calling);
  assert_eq(owners_ran(called.run, typed_query()), [b"Queue::len"]);
  assert_eq(groups_ran(called.run, cycles_query()).map(|g: GroupKey| g.module), [b"lib"]);
  assert_eq(outcome_summary(called.outcome), outcome_summary(analyse(parse_all(calling))));
  let moved = stack_queue_sources(b"0", b"Stack(f).len()");
  let resolved = queried_over(called.store, moved);
  assert_eq(owners_ran(resolved.run, typed_query()), [b"Stack::len"]);
  assert_eq(outcome_summary(resolved.outcome), outcome_summary(analyse(parse_all(moved))))
}

test "a definition added above another checks itself and no other" {
  let cold = queried_over(empty_memory_store(), layered(b"pub fn step(n: Int) -> Int = n + 1\n"));
  let above = layered(b"pub fn first() -> Int = 1\n\npub fn step(n: Int) -> Int = n + 1\n");
  let warm = queried_over(cold.store, above);
  assert_eq(groups_ran(warm.run, group_query()), [group_in(b"lib", [b"first"])]);
  assert_eq(outcome_summary(warm.outcome), outcome_summary(analyse(parse_all(above))))
}

test "a signature edit checks the definitions that read it again, and no other" {
  let cold = queried_over(empty_memory_store(), layered(b"pub fn step(n: Int) -> Int = n + 1\n"));
  let widened = b"pub fn step(n: Int, by: Int = 1) -> Int = n + by\n";
  let warm = queried_over(cold.store, layered(widened));
  assert_eq(groups_ran(warm.run, group_query()), [
    group_in(b"lib", [b"step"]),
    group_in(b"app", [b"go"]),
  ]);
  assert_eq(modules_ran(warm.run, module_query()), [b"app", b"lib"]);
  assert_eq(outcome_summary(warm.outcome), outcome_summary(analyse(parse_all(layered(widened)))))
}

fn shaped(shapes: Bytes, app: Bytes) -> List<Source> =
  [
    { name: b"shapes", source_text: shapes },
    {
      name: b"made",
      source_text: b"import shapes (Shape, Square)\npub fn made() -> Shape = Square(2)\n",
    },
    { name: b"app", source_text: app },
  ]

fn shapes_source() -> Bytes =
  b"pub type Shape = | Square(Int)\npub fn Shape::area(s: Shape) -> Int = match s { Square(n) -> n * n }\n"

fn grown_source() -> Bytes =
  b"pub fn Shape::grown(s: Shape, by: Int) -> Shape = match s { Square(n) -> Square(n + by) }\n"

fn sized_source() -> Bytes =
  b"import made\npub fn size() -> Int = made::made().area()\n\npub fn two() -> Int = [made::made(), made::made()].len()\n"

test "adding a function to a type checks only that function, and changing a signature also rechecks the definitions that call it on a value" {
  let cold = queried_over(empty_memory_store(), shaped(shapes_source(), sized_source()));
  let added = queried_over(
    cold.store,
    shaped(shapes_source().concat(grown_source()), sized_source()),
  );
  assert_eq(groups_ran(added.run, group_query()), [group_in(b"shapes", [b"Shape::grown"])]);
  let resigned = edited(
    shaped(shapes_source().concat(grown_source()), sized_source()),
    b"shapes",
    b"area(s: Shape) -> Int = match s",
    b"area(of: Shape) -> Int = match of",
  );
  let warm = queried_over(added.store, resigned);
  assert_eq(groups_ran(warm.run, group_query()), [
    group_in(b"shapes", [b"Shape::area"]),
    group_in(b"app", [b"size"]),
  ]);
  assert_eq(outcome_summary(warm.outcome), outcome_summary(analyse(parse_all(resigned))));
  assert(match warm.outcome { Analysed(_) -> true, Rejected(_) -> false })
}

test "after each edit to a type's functions, a call on a value gives the same result as a check from scratch" {
  let s0 = shaped(shapes_source(), sized_source());
  let s1 = edited(s0, b"shapes", b"Square(n) -> n * n", b"Square(n) -> n * n + 0");
  let s2 = edited(
    s1,
    b"shapes",
    b"area(s: Shape) -> Int = match s",
    b"area(of: Shape) -> Int = match of",
  );
  let s3 = edited(s2, b"app", b"made::made().area()", b"made::made().grown(1).area()");
  let s4 = edited(
    s3,
    b"shapes",
    b"pub fn Shape::area",
    grown_source().concat(b"pub fn Shape::area"),
  );
  let s5 = edited(s4, b"shapes", b"by: Int) -> Shape", b"by: Int) -> Int");
  let s6 = with_module(
    s4,
    b"named",
    b"import shapes (Shape, Square)\npub fn unit() -> Int = Shape::area(Shape::grown(Square(0), 1))\n",
  );
  assert_eq(
    disagreements([
      step(b"cold", s0),
      step(b"a body edit to a type's function", s1),
      step(b"a type's function re-signed", s2),
      step(b"a call of a function its type has not", s3),
      step(b"the function added", s4),
      step(b"the function returning another type", s5),
      step(b"a module naming the functions through the type", s6),
      step(b"the function gone again", edited(s6, b"shapes", grown_source(), b"")),
      step(b"unchanged", edited(s6, b"shapes", grown_source(), b"")),
    ]),
    [],
  )
}

fn rejected_over(user: List<Source>, shipped: List<Source>) -> List<Bytes> / {abort.raise} =
  check_sources(empty_memory_store(), user, shipped).results.fold(
    [],
    |accumulator: List<Bytes>, a: CheckedModule|
      accumulator.concat(a.result.rejected.map(|d: Diagnostic| d.message)),
  )

test "a module can call a function of a built-in type, such as `Bytes`, when it imports the type's defining module but not that module's own imports" {
  assert_eq(
    rejected_over(
      [
        {
          name: b"main",
          source_text: b"import std.bytes\npub fn main(b: Bytes) -> Bytes = b.twice()\n",
        },
      ],
      [
        {
          name: b"std.bytes",
          source_text: b"import std.radix\npub fn Bytes::twice(b: Bytes) -> Bytes = radix::joined(b, b)\n",
        },
        {
          name: b"std.radix",
          source_text: b"pub fn joined(a: Bytes, b: Bytes) -> Bytes = Bytes::concat_all([a, b])\n",
        },
      ],
    ),
    [],
  )
}

test "a transparent function read from another module calls what its own module can see" {
  assert_eq(
    rejected_over(
      [
        {
          name: b"main",
          source_text: b"import std.picks\npub fn main(xs: List<Int>) -> Option<Int> = picks::pick(xs)\n",
        },
      ],
      [
        {
          name: b"std.list",
          source_text: b"pub fn List::second<a>(xs: List<a>) -> Option<a> = xs.at(1)\n",
        },
        {
          name: b"std.picks",
          source_text: b"import std.list\npub transparent fn pick(xs: List<Int>) -> Option<Int> = xs.second()\n",
        },
      ],
    ),
    [],
  )
}

test "a call on a value finds a built-in type's function however its defining module is imported, or when it is not imported" {
  let shipped = [
    {
      name: b"std.bytes",
      source_text: b"pub fn Bytes::twice(b: Bytes) -> Bytes = b.concat(b)\n\npub fn other(b: Bytes) -> Bytes = b\n",
    },
    {
      name: b"std.through",
      source_text: b"import std.bytes\n\npub fn same(b: Bytes) -> Bytes = b.twice()\n",
    },
  ];
  let main = |imports: Bytes|
    [
      {
        name: b"main",
        source_text: imports.concat(b"pub fn main(b: Bytes) -> Bytes = b.twice()\n"),
      },
    ];
  assert_eq(rejected_over(main(b"import std.bytes\n"), shipped), []);
  assert_eq(rejected_over(main(b"import std.bytes (other)\n"), shipped), []);
  assert_eq(rejected_over(main(b"import std.bytes as held\n"), shipped), []);
  assert_eq(rejected_over(main(b"import std.through\n"), shipped), []);
  assert_eq(rejected_over(main(b""), shipped), [])
}

test "a definition checked against cached interfaces still finds a function it calls on a value, though its source never names that function's module" {
  assert_eq(
    rejected_over(
      [
        {
          name: b"main",
          source_text: b"import std.list\npub fn total(xs: List<Int>) -> Int =\n  match xs.rest() { Some(t) -> 1 + total(t), None -> 0 }\n",
        },
      ],
      [
        {
          name: b"std.list",
          source_text: b"pub fn List::rest<a>(xs: List<a>) -> Option<List<a>> =\n  match xs { [] -> None, [_, ..tail] -> Some(tail) }\n",
        },
      ],
    ),
    [],
  )
}

test "a standard library module is checked from its source, not from a cached interface, when its imports are supplied as cached interfaces" {
  assert_eq(
    rejected_over(
      [
        {
          name: b"main",
          source_text: b"import std.words (words)\npub fn main() -> Int = words(\"a\").len()\n",
        },
      ],
      [
        {
          name: b"std.words",
          source_text: b"import std.parts\n\npub fn words(s: String) -> List<String> = words_from(s)\n\nfn words_from(s: String) -> List<String> = parts::split(s)\n",
        },
        { name: b"std.parts", source_text: b"pub fn split(s: String) -> List<String> = [s]\n" },
      ],
    ),
    [],
  )
}

test "a built-in type's function is found in a module that also defines a constructor with the type's name" {
  assert_eq(
    rejected_over(
      [
        {
          name: b"main",
          source_text: b"import std.float\n\npub type Value = | Float(Float) | Text(String)\n\npub fn main() -> Value = Float(Float::least())\n",
        },
      ],
      [{ name: b"std.float", source_text: b"pub fn Float::least() -> Float = 0.0\n" }],
    ),
    [],
  )
}

fn tables_of(
  results: List<CheckedModule>,
) -> List<{ module: Bytes, tables: ModuleTables }> / {abort.raise} =
  results.map(|a: CheckedModule| { module: a.module, tables: tables_of_result(a.result) })

fn lib_app_sources(lib: Bytes) -> List<Source> =
  [
    { name: b"lib", source_text: lib },
    {
      name: b"app",
      source_text: b"import lib\npub fn go(n: Int) -> Int = lib::step(n) + 1\n\npub fn again(n: Int) -> Int = lib::step(n) * 2\n\npub fn other() -> Int = 7\n",
    },
  ]

test "editing a function's signature rechecks that function and the definitions that call it, and no other definitions" {
  let cold = queried_over(
    empty_memory_store(),
    lib_app_sources(b"pub fn step(n: Int) -> Int = n + 1\n"),
  );
  let widened = lib_app_sources(b"pub fn step(n: Int, by: Int = 1) -> Int = n + by\n");
  let warm = queried_over(cold.store, widened);
  let ran = groups_ran(warm.run, group_query());
  assert(
    same_groups(ran, [
      group_in(b"lib", [b"step"]),
      group_in(b"app", [b"go"]),
      group_in(b"app", [b"again"]),
    ]),
  );
  assert_eq(outcome_summary(warm.outcome), outcome_summary(analyse(parse_all(widened))));
  assert_eq(
    tables_of(warm.results),
    tables_of(queried_over(empty_memory_store(), widened).results),
  );
  assert_eq(warm.results, queried_over(empty_memory_store(), widened).results)
}

test "an edit that affects one definition in a module rechecks that definition alone, and an edit that affects several checks the whole module once" {
  let app = b"import lib\npub fn go(n: Int) -> Int = lib::step(n) + 2\n\npub fn again(n: Int) -> Int = lib::step(n) * 2\n\npub fn other() -> Int = 7\n";
  let over = |lib: Bytes| [{ name: b"lib", source_text: lib }, { name: b"app", source_text: app }];
  let cold = queried_over(
    empty_memory_store(),
    lib_app_sources(b"pub fn step(n: Int) -> Int = n + 1\n"),
  );
  let one = queried_over(cold.store, over(b"pub fn step(n: Int) -> Int = n + 1\n"));
  assert_eq(groups_ran(one.run, group_query()), [group_in(b"app", [b"go"])]);
  let widened = over(b"pub fn step(n: Int, by: Int = 1) -> Int = n + by\n");
  let more = queried_over(one.store, widened);
  let ran = groups_ran(more.run, group_query());
  assert(!ran.contains(group_in(b"app", [b"other"])));
  assert_eq(more.results, queried_over(empty_memory_store(), widened).results)
}

fn checked_whole_in(store: MemoryStore, hash: Bytes, module: Bytes) -> Bool / {abort.raise} =
  memo::fact_records(store).fold(false, |found: Bool, _: Bytes, r: memo::FactRecord|
    found
      || (r.query == hash
      && r.input == bin::encode({ module: module, shipped: false, tested: false }, module_key_bin())
      && r.reads.fold(false, |any: Bool, read: memo::Dependency|
        any
          || (match read {
            memo::QueryDependency(name, _, _) -> name == owner_interfaces_query(),
            memo::ExternalDependency(_, _, _) -> false,
          }))))

test "when only the query that assembles a module's result changes, it reruns but the module's definitions are not rechecked" {
  let sources = lib_app_sources(b"pub fn step(n: Int) -> Int = n + 1\n");
  let cold = queried_over(empty_memory_store(), sources);
  assert(checked_whole_in(cold.store, module_query(), b"app"));
  let anew = b"module, defined anew";
  let qs = fresh_registry().fold(
    Map::new(),
    |accumulator: Map<Bytes, CheckQuery>, n: Bytes, q: CheckQuery|
      accumulator.insert(n, if n == module_query() { { ..q, hash: anew } } else { q }),
  );
  let warm = queried_under(qs, cold.store, sources);
  assert(modules_ran(warm.run, module_query()).contains(b"app"));
  assert(modules_ran(warm.run, module_query()).contains(b"lib"));
  assert_eq(groups_ran(warm.run, group_query()).filter(|g: GroupKey| !g.shipped), []);
  assert(!checked_whole_in(warm.store, anew, b"app"));
  assert_eq(warm.results, cold.results)
}

fn shared_base_sources(lib: Bytes) -> List<Source> =
  [
    { name: b"lib", source_text: lib },
    {
      name: b"app",
      source_text: b"import lib\npub fn go(n: Int) -> Int = lib::step(n) + base()\n\npub fn again(n: Int) -> Int = lib::step(n) * 2 + base()\n\npub fn base() -> Int = 1\n\npub fn aside() -> Int = 7\n",
    },
  ]

fn reads_own_groups(store: MemoryStore) -> Bool / {abort.raise} =
  memo::fact_records(store).fold(false, |found: Bool, _: Bytes, r: memo::FactRecord|
    found
      || (r.query == whole_query()
      && {
        let module = decoded(r.input, module_key_bin(), "a module's name").module;
        r.reads.fold(false, |own: Bool, read: memo::Dependency|
          own
            || (match read {
              memo::QueryDependency(name, input, _) ->
                (name == owner_interface_query()
                  && decoded(input, owner_key_bin(), "an owner's name").module == module)
                  || (name == group_query()
                  && decoded(input, group_key_bin(), "a group's names").module == module),
              memo::ExternalDependency(_, _, _) -> false,
            }))
      }))

test "a whole-module check requested by one definition does not read the results of the module's other definitions" {
  let cold = queried_over(
    empty_memory_store(),
    shared_base_sources(b"pub fn step(n: Int) -> Int = n + 1\n"),
  );
  let widened = shared_base_sources(b"pub fn step(n: Int, by: Int = 1) -> Int = n + by\n");
  let warm = queried_over(cold.store, widened);
  let ran = groups_ran(warm.run, group_query());
  assert(ran.contains(group_in(b"app", [b"go"])));
  assert(ran.contains(group_in(b"app", [b"again"])));
  assert(!ran.contains(group_in(b"app", [b"aside"])));
  assert(!reads_own_groups(warm.store));
  assert_eq(warm.results, queried_over(empty_memory_store(), widened).results)
}

fn stale_group_sources(inner: Bytes, first: Bytes, go: Bytes) -> List<Source> =
  [
    {
      name: b"lib",
      source_text: Bytes::concat_all([inner, b"\n\npub fn step(n: Int) -> Int = inner(n) + 1\n"]),
    },
    {
      name: b"zed",
      source_text: Bytes::concat_all([
        b"import lib\nfn seed() -> Int = 1\n\nfn sprout() -> Int = seed() + 1\n\n",
        first,
        b"\n\nfn shown(n: Int) -> Int = lib::step(n)\n\n",
        go,
        b"\n",
      ]),
    },
  ]

test "a definition whose cached result becomes outdated while other definitions in its module are checked is checked after them" {
  let before = stale_group_sources(
    b"fn inner(n: Int) -> Int = n + 1",
    b"pub fn first() -> Int = sprout() + 1",
    b"pub fn go(n: Int) -> Int = lib::step(0) + shown(n)",
  );
  let after = stale_group_sources(
    b"fn inner(n: Int) -> Int = n + 2",
    b"pub fn first() -> Int = sprout() + 2",
    b"pub fn go(n: Int) -> Int = lib::step(1) + shown(n)",
  );
  let warm = queried_over(queried_over(empty_memory_store(), before).store, after);
  assert_eq(outcome_summary(warm.outcome), outcome_summary(analyse(parse_all(after))));
  assert_eq(warm.results, queried_over(empty_memory_store(), after).results)
}

test "editing a test and a definition it calls gives the same results as checking the edited module from scratch" {
  let before = [
    {
      name: b"m",
      source_text: b"fn scale(n: Int) -> Int = n * 2\nfn other(n: Int) -> Int = n + 1\n\ntest \"doubles\" { assert_eq(scale(2) + other(0), 5) }\n",
    },
  ];
  let after = [
    {
      name: b"m",
      source_text: b"fn scale(n: Int) -> Int = n * 2\nfn other(n: Int) -> Int = 1 + n\n\ntest \"doubles\" { assert_eq(scale(2) + other(0), 9) }\n",
    },
  ];
  let warm = queried_over(queried_over(empty_memory_store(), before).store, after);
  assert_eq(tables_of(warm.results), tables_of(queried_over(empty_memory_store(), after).results));
  assert_eq(warm.results, queried_over(empty_memory_store(), after).results)
}

test "when an edit breaks several definitions, each reports the same error as a check from scratch" {
  let cold = queried_over(
    empty_memory_store(),
    lib_app_sources(b"pub fn step(n: Int) -> Int = n + 1\n"),
  );
  let narrowed = lib_app_sources(b"pub fn step(n: Int, by: Int) -> Int = n + by\n");
  let warm = queried_over(cold.store, narrowed);
  assert_eq(outcome_summary(warm.outcome), outcome_summary(analyse(parse_all(narrowed))))
}

test "a definition added is checked and hashed alone" {
  let cold = check_sources(
    empty_memory_store(),
    layered(b"pub fn step(n: Int) -> Int = n + 1\n"),
    [],
  );
  let added = layered(b"pub fn step(n: Int) -> Int = n + 1\npub fn twice(n: Int) -> Int = n * 2\n");
  let warm = check_sources(cold.store, added, []);
  assert_eq(groups_ran(warm.run, group_query()), [group_in(b"lib", [b"twice"])]);
  assert_eq(groups_ran(warm.run, group_hash_query()), [group_in(b"lib", [b"twice"])]);
  assert_eq(modules_ran(warm.run, hashes_query()), [b"lib"]);
  assert_eq(warm.cached_hashes, check_sources(empty_memory_store(), added, []).cached_hashes)
}

test "a body edit hashes the definitions that call it again, and no other" {
  let cold = check_sources(
    empty_memory_store(),
    layered(b"pub fn step(n: Int) -> Int = n * 3\n"),
    [],
  );
  let edited = layered(b"pub fn step(n: Int) -> Int = n * 4\n");
  let warm = check_sources(cold.store, edited, []);
  assert_eq(groups_ran(warm.run, group_query()), [group_in(b"lib", [b"step"])]);
  assert_eq(groups_ran(warm.run, group_hash_query()), [
    group_in(b"lib", [b"step"]),
    group_in(b"app", [b"go"]),
  ]);
  assert_eq(modules_ran(warm.run, hashes_query()), [b"app", b"lib"]);
  assert_eq(warm.cached_hashes, check_sources(empty_memory_store(), edited, []).cached_hashes)
}

test "adding a definition to a standard library module neither rechecks nor rehashes the modules that import it" {
  let user = [
    {
      name: b"main",
      source_text: b"import std.shapes\npub fn main() -> Int = shapes::far(shapes::origin())\n",
    },
  ];
  let shapes = |more: Bytes|
    [
      {
        name: b"std.shapes",
        source_text: b"pub type Point = { x: Int, y: Int }\npub fn origin() -> Point = { x: 0, y: 0 }\npub fn far(p: Point) -> Int = p.x + p.y\n".concat(
          more,
        ),
      },
    ];
  let cold = check_sources(empty_memory_store(), user, shapes(b""));
  let added = shapes(b"pub fn spare() -> Int = 5\n");
  let warm = check_sources(cold.store, user, added);
  assert_eq(modules_ran(warm.run, module_query()), [b"std.shapes"]);
  assert_eq(modules_ran(warm.run, hashes_query()), [b"std.shapes"]);
  assert_eq(warm.cached_hashes, check_sources(empty_memory_store(), user, added).cached_hashes)
}

test "import cycles and self-imports are rejected with the same errors whether checked from scratch or from the cache" {
  let cycle = [
    { name: b"a", source_text: b"import b\npub fn a() -> Int = b::b()\n" },
    { name: b"b", source_text: b"import a\npub fn b() -> Int = a::a()\n" },
    { name: b"c", source_text: b"import a\npub fn c() -> Int = a::a()\n" },
  ];
  let itself = [{ name: b"me", source_text: b"import me\npub fn f() -> Int = 1\n" }];
  assert_eq(
    disagreements([
      step(b"a cycle", cycle),
      step(b"warm", cycle),
      step(b"a module importing itself", itself),
      step(b"the cycle broken", with_module(cycle, b"b", b"pub fn b() -> Int = 1\n")),
    ]),
    [],
  )
}

test "a module that fails to check causes no check of the modules that import it, nor of its definitions one by one" {
  let sources = [
    {
      name: b"lib",
      source_text: b"pub fn broken() -> Int = missing()\n\npub fn fine() -> Int = 1\n",
    },
    { name: b"app", source_text: b"import lib\npub fn go() -> Int = lib::fine()\n" },
    { name: b"top", source_text: b"import app\npub fn main() -> Int = app::go()\n" },
    {
      name: b"aside",
      source_text: b"pub fn alone() -> Int = nothing()\n\npub fn other() -> Int = 2\n",
    },
  ];
  let cold = queried_over(empty_memory_store(), sources);
  assert_eq(sorted_bytes(rejected_first(cold.results).map(|a: CheckedModule| a.module)), [
    b"aside",
    b"lib",
  ]);
  assert_eq(modules_ran(cold.run, module_query()), [b"aside", b"lib"]);
  assert_eq(groups_ran(cold.run, group_query()), []);
  let mended = with_module(
    with_module(sources, b"lib", b"pub fn broken() -> Int = 3\n\npub fn fine() -> Int = 1\n"),
    b"aside",
    b"pub fn alone() -> Int = 4\n\npub fn other() -> Int = 2\n",
  );
  let warm = queried_over(cold.store, mended);
  assert_eq(modules_ran(warm.run, module_query()), [b"app", b"aside", b"lib", b"top"]);
  assert_eq(
    outcome_summary(warm.outcome),
    outcome_summary(queried_over(empty_memory_store(), mended).outcome),
  )
}

fn summary_run(
  store: MemoryStore,
  sources: List<Source>,
) -> { store: MemoryStore, ran: List<Bytes> } / {abort.raise} = {
  let w = inputs_alone(sources);
  let qs = fresh_registry();
  let done = over_decoding(
    store,
    prelude_frames,
    prelude_files(),
    |kind: Bytes, at: Bytes| lookup_input_alone(w, kind, at),
    || {
      let a = memo::query_output(
        qs,
        start_run(qs),
        program_summary_query(),
        bin::encode(w.own, bin::list_bin(bin::bytes_bin())),
      );
      query_stats(a.run).fold([], |ran: List<Bytes>, t: QueryStats|
        if t.ran > 0 {
          ran.push(Bytes::concat_all([t.query, b" ", Bytes::of_string(t.ran.to_string())]))
        } else { ran })
    },
  );
  { store: done.store, ran: done.value }
}

test "a module that leaves the program and comes back returns to its earlier result" {
  let whole = layered(b"pub fn step(n: Int) -> Int = n + 1\n");
  let cold = queried_over(empty_memory_store(), whole);
  let alone = summary_run(cold.store, whole.filter(|s: Source| s.name == b"aside"));
  assert_eq(modules_ran(queried_over(alone.store, whole).run, module_query()), [])
}

fn module_chain(size: Int, body: Bytes) -> List<Source> =
  [
    {
      name: b"m0",
      source_text: Bytes::concat_all([b"pub fn step(n: Int) -> Int = ", body, b"\n"]),
    },
  ].concat(
    range(1, size).map(|i: Int| {
      let n = Bytes::of_string(i.to_string());
      let below = Bytes::of_string((i - 1).to_string());
      {
        name: b"m".concat(n),
        source_text: Bytes::concat_all([
          b"import m",
          below,
          b"\npub fn step(n: Int) -> Int = m",
          below,
          b"::step(n) + 1\n",
        ]),
      }
    }),
  )

test "a body edit with an unchanged interface runs the same queries at two program sizes" {
  let edit_at = |size: Int| {
    let cold = summary_run(empty_memory_store(), module_chain(size, b"n * 3"));
    summary_run(cold.store, module_chain(size, b"n * 4")).ran
  };
  assert_eq(edit_at(3), edit_at(9))
}

test "a command with no changes runs no query" {
  let cold = summary_run(empty_memory_store(), module_chain(3, b"n + 1"));
  assert_eq(summary_run(cold.store, module_chain(3, b"n + 1")).ran, [])
}
