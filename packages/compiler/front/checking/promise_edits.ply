type Queried<o> = { store: fs::MemFs, run: Run, outputs: List<o> }

fn queried<i, o>(
  store: fs::MemFs,
  sources: List<Source>,
  q: QueryOf<i, o>,
  inputs: List<i>,
  more: List<CheckDefinition> = [],
) -> Queried<o> / {abort.raise} = {
  let w = inputs_alone(sources);
  let qs = fresh_registry(more);
  let done = over_decoding(
    store,
    prelude_frames,
    prelude_files,
    |kind: Bytes, at: Bytes| lookup_input_alone(w, kind, at),
    ||
      in_session(qs, |run: Run| {
        let read = reading(qs, run, || inputs.map(|input: i| fetch(q, input)));
        { run: read.run, value: read }
      }),
  );
  { store: done.store, run: done.value.run, outputs: done.value.value }
}

fn module_key(s: Source) -> ModuleKey = { module: s.name, shipped: false, tested: false }

fn costs_queried(store: fs::MemFs, sources: List<Source>) -> Queried<Report> / {abort.raise} =
  queried(store, sources, module_costs_query(), sources.map(module_key))

fn report_in(a: Queried<Report>) -> Report = report_of(a.outputs)

fn costed_sources(pushed: Bytes, kept_twice: Bool) -> List<Source> =
  [
    { name: b"a", source_text: b"pub fn keep(xs: List<Int>) -> List<Int> = xs.push(0)\n" },
    {
      name: b"b",
      source_text: Bytes::concat_all([
        b"import a (keep)\n\nfn grow(xs: List<Int>) -> List<Int> = keep(xs).push(",
        pushed,
        b")\n\nfn sized(xs: List<Int>) -> Int = ",
        if kept_twice { b"keep(xs).len() + xs.len()" } else { b"keep(xs).len()" },
        b"\n",
      ]),
    },
  ]

test "an edit to a body that leaves its demands alone gives the report of a fresh check" {
  let first = costs_queried(fs::mem_empty(), costed_sources(b"1", false));
  let edited = costs_queried(first.store, costed_sources(b"2", false));
  assert_eq(
    report_in(edited),
    report_in(costs_queried(fs::mem_empty(), costed_sources(b"2", false))),
  )
}

test "an edit that changes what a body demands gives the report of a fresh check" {
  let first = costs_queried(fs::mem_empty(), costed_sources(b"1", false));
  let edited = costs_queried(first.store, costed_sources(b"1", true));
  assert_eq(
    report_in(edited),
    report_in(costs_queried(fs::mem_empty(), costed_sources(b"1", true))),
  )
}

const varied_sources: List<Source> =
  [
    {
      name: b"a",
      source_text: b"pub type Box = { items: List<Int> }\n\npub fn add(b: Box, n: Int) -> Box = { ..b, items: b.items.push(n) }\n\npub fn keep(xs: List<Int>) -> List<Int> returns xs = xs\n\npub fn made(n: Int) -> List<Int> returns fresh = range(0, n)\n",
    },
    {
      name: b"b",
      source_text: b"import a (Box, add, keep, made)\n\nfn ping(xs: List<Int>, n: Int) -> List<Int> = if n <= 0 { xs } else { pong(xs.push(n), n - 1) }\n\nfn pong(xs: List<Int>, n: Int) -> List<Int> = if n <= 0 { xs } else { ping(xs.push(n), n - 1) }\n\nreuse fn once(xs: List<Int>) -> List<Int> = keep(xs).push(1)\n\nfn both(xs: List<Int>) -> List<Int> = keep(xs).push(xs.len())\n\nfn mapped(xss: List<List<Int>>) -> List<List<Int>> = xss.map(|ys: List<Int>| ys.push(1))\n\nfn boxed(b: Box) -> Box = add(b, 1)\n\ntest \"counts down\" {\n  assert_eq(ping(made(1), 2), [0, 2, 1]);\n  assert_eq(boxed({ items: [] }).items, [1])\n}\n",
    },
  ]

fn sites_by_label(r: Report) -> List<Costed> =
  r.definitions.sort_by(|a: Costed, b: Costed|
    match compare_values(a.label, b.label) { Greater -> false, _ -> true })

test "the report over one walk of each unit equals the report over one walk of the whole program" {
  let sources = varied_sources;
  let by_units = report_in(costs_queried(fs::mem_empty(), sources));
  let checked = checked_in_memory(in_memory(sources));
  match checked.outcome {
    Rejected(_) -> panic("the checker rejected a program that should be valid"),
    Analysed(w) -> {
      let whole = lowered_over(checked.program, || report_over_one_walk(cost_input_of(w)));
      assert_eq(by_units.unfinished, []);
      assert(by_units.definitions.len() > 0);
      assert_eq(sites_by_label(by_units), sites_by_label(whole));
      assert_eq(by_units.return_mismatches, whole.return_mismatches)
    },
  }
}

const grouped_sources: List<Source> =
  [
    {
      name: b"m",
      source_text: b"pub type Box = | Box(List<Int>)\n\nshow for Box by shown\n\nfn shown(b: Box) -> String = \"a box of {items(grown(b, 0)).len()}\"\n\nfn items(b: Box) -> List<Int> = match b { Box(xs) -> xs }\n\nfn grown(b: Box, n: Int) -> Box = match b { Box(xs) -> Box(xs.push(n)) }\n",
    },
  ]

test "a unit whose functions are checked in several groups gets the cost report of one walk of the whole program" {
  let by_units = report_in(costs_queried(fs::mem_empty(), grouped_sources));
  assert_eq(by_units.unfinished, []);
  assert_eq(
    by_units.definitions.filter(|d: Costed| d.name == b"grown").map(|d: Costed|
      d.sites.map(|s: Site| s.operation)),
    [[b"List::push"]],
  );
  let checked = checked_in_memory(in_memory(grouped_sources));
  match checked.outcome {
    Rejected(_) -> panic("the checker rejected a program that should be valid"),
    Analysed(w) -> {
      let whole = lowered_over(checked.program, || report_over_one_walk(cost_input_of(w)));
      assert_eq(sites_by_label(by_units), sites_by_label(whole))
    },
  }
}

fn measured_sources(spare: Bytes) -> List<Source> =
  [
    {
      name: b"m",
      source_text: b"fn is_small(n: Int) -> Bool = n <= 0\n\nfn lowered(n: Int) -> Int decreases n = if is_small(n) { 0 } else { lowered(n - 1) + 1 }\n",
    },
    { name: b"n", source_text: Bytes::concat_all([b"pub fn spare() -> Int = ", spare, b"\n"]) },
  ]

fn measures_queried(
  store: fs::MemFs,
  sources: List<Source>,
) -> Queried<List<MeasureEntry>> / {abort.raise} =
  queried(store, sources, measures_query(), sources.map(module_key))

fn entries_in(a: Queried<List<MeasureEntry>>) -> List<MeasureEntry> =
  a.outputs.fold([], |accumulator: List<MeasureEntry>, entries: List<MeasureEntry>|
    accumulator.concat(entries))

test "an edit that a measured function does not reach leaves its program alone" {
  let first = measures_queried(fs::mem_empty(), measured_sources(b"1"));
  assert_eq(entries_in(first).len(), 1);
  let edited = measures_queried(first.store, measured_sources(b"2"));
  assert_eq(entries_in(edited), entries_in(first))
}

fn names_query() -> QueryOf<GroupKey, List<Bytes>> =
  {
    name: b"names in a measured program",
    input: group_key_bin(),
    output: bin::list_bin(bin::bytes_bin()),
  }

fn names_in_program(unit: GroupKey) -> Written / {QueryEffects, abort.raise} =
  written(names_query(), match measure_program(unit).outcome {
    Rejected(_) -> [],
    Analysed(a) -> a.checked.definitions.map(|d: DefinitionInfo| d.name),
  })

test "a measured function's program holds the bodies it calls and checks on its own" {
  let first = measures_queried(fs::mem_empty(), measured_sources(b"1"));
  let unit: GroupKey = entries_in(first).get(0).unit;
  let read = queried(first.store, measured_sources(b"1"), names_query(), [unit], [
    product_definition(names_query(), names_query().name, names_in_program, measure_products),
  ]);
  let names = read.outputs.get(0);
  assert(names.contains(b"m.lowered") && names.contains(b"m.is_small"), None)
}

fn checked_cost_input(
  names: List<Bytes>,
  sources: List<Bytes>,
  module_packages: List<Int> = [],
) -> { program: InMemory, input: CostInput } / {abort.raise} = {
  let checked = checked_in_memory(
    in_memory(
      range(0, names.len()).map(|i: Int| { name: names.get(i), source_text: sources.get(i) }),
    ),
  );
  match checked.outcome {
    Rejected(_) -> panic("the checker rejected a program that should be valid"),
    Analysed(w) -> {
      let a = {
        ..w,
        module_packages: module_packages.concat(w.module_packages.drop(module_packages.len())),
      };
      { program: checked.program, input: cost_input_of(a) }
    },
  }
}

fn reported(
  names: List<Bytes>,
  sources: List<Bytes>,
  module_packages: List<Int> = [],
) -> Report / {abort.raise} = {
  let c = checked_cost_input(names, sources, module_packages);
  lowered_over(c.program, || report_over_one_walk(c.input))
}

test "a cost report gives each update's source location, whether it copies or reuses, the reason, and an edit that would avoid the copy" {
  let source = b"reuse fn grow(m: Map<Int, List<Int>>, n: Int) -> List<Int> =\n  match m.get(0) { Some(xs) -> xs.push(n), None -> [] }\n";
  let r = reported([b"m"], [source]);
  assert_eq(r.unfinished, []);
  assert_eq(r.definitions.len(), 1);
  let d = r.definitions.get(0);
  assert_eq(d.item_kind, CostedFunction(b"m.grow"));
  assert_eq([d.module_name, d.name], [b"m", b"grow"]);
  assert_eq(d.reuse_keyword, Some(span_between(0, 5)));
  assert_eq(d.sites.len(), 1);
  let s = d.sites.get(0);
  assert_eq(source.slice(s.start, s.end), b"xs.push(n)");
  assert_eq(s.operation, b"List::push");
  assert_eq(
    s.verdict,
    Copies({ cause: MapEntry, text: b"`Map::get` returns a clone the map still contains" }, Local),
  );
  assert_eq(suggestion(s.verdict), Some(b"`Map::update`"))
}

test "updating a map entry read with `first` or `floor` copies it, but an entry removed with `pop_first` or `split` is reused" {
  let source = b"fn peek(m: Map<Int, List<Int>>, n: Int) -> List<Int> = match m.first() { Some(e) -> e.value.push(n), None -> [] }\nfn near(m: Map<Int, List<Int>>, n: Int) -> List<Int> = match m.floor(n) { Some(e) -> e.value.push(n), None -> [] }\nfn take(m: Map<Int, List<Int>>, n: Int) -> List<Int> = match m.pop_first() { Some(p) -> p.value.push(n), None -> [] }\nfn cut(m: Map<Int, List<Int>>, n: Int) -> List<Int> = match m.split(n).at { Some(xs) -> xs.push(n), None -> [] }\ntest \"fresh\" { assert_eq(take(Map::new().insert(1, [1]), 2), [1, 2]); assert_eq(cut(Map::new().insert(1, [1]), 1), [1, 1]) }\n";
  let r = reported([b"m"], [source]);
  assert_eq(r.unfinished, []);
  let site_of = |name: Bytes| r.definitions.filter(|d: Costed| d.name == name).get(0).sites.get(0);
  let peeked = site_of(b"peek");
  assert_eq(
    peeked.verdict,
    Copies(
      {
        cause: MapEntry,
        text: b"`.value` was read from a record that another value still owns: `Map::first` returns a clone the map still contains",
      },
      Local,
    ),
  );
  assert_eq(suggestion(peeked.verdict), Some(b"`Map::update`"));
  assert_eq(
    site_reason(site_of(b"near").verdict),
    b"`.value` was read from a record that another value still owns: `Map::floor` returns a clone the map still contains",
  );
  assert_eq(
    site_of(b"take").verdict,
    Reuses(b"the list is parameter 0, and every call site passes it and never uses it again"),
  );
  assert(reuses(site_of(b"cut")))
}

test "an array or list element replaced in place is an update, and one read out first is a copy" {
  let source = b"fn fill(xs: Array<Int>, i: Int) -> Array<Int> / {abort.raise} = if i <= 0 { xs } else { fill(xs.set(i - 1, i), i - 1) }\nfn twice(xs: Array<Int>) -> Array<Int> / {abort.raise} = { let n = xs.get(0) + xs.len(); xs.set(0, n) }\nfn again(xs: Array<Int>) -> Int / {abort.raise} = xs.set(0, 1).len() + xs.len()\nfn sized(xs: Array<Int>) -> Array<Int> / {abort.raise} = xs.set(0, xs.len())\nfn first(ys: List<Array<Int>>) -> Array<Int> / {abort.raise} = match ys.at(0) { Some(a) -> a.set(0, 1), None -> Array::new(1, 0) }\nfn bump(zs: List<Int>) -> List<Int> / {abort.raise} = zs.set(0, 1)\ntest \"fresh\" { assert_eq(fill(Array::new(3, 0), 3).len(), 3); assert_eq(bump([0]), [1]) }\n";
  let r = reported([b"m"], [source]);
  assert_eq(r.unfinished, []);
  let site_of = |name: Bytes| r.definitions.filter(|d: Costed| d.name == name).get(0).sites.get(0);
  let filled = site_of(b"fill");
  assert_eq(filled.operation, b"Array::set");
  assert_eq(
    filled.verdict,
    Reuses(b"the array is parameter 0, and every call site passes it and never uses it again"),
  );
  let twiced = site_of(b"twice");
  assert(twiced.operation == b"Array::set" && reuses(twiced));
  let again = site_of(b"again");
  assert_eq(
    again.verdict,
    Copies(
      { cause: ReadAgain, text: b"`xs` is read again after this point, so this use clones it" },
      Local,
    ),
  );
  assert_eq(
    suggestion(again.verdict),
    Some(
      b"make the update the last use of the variable: first bind anything else you need from the variable to new names",
    ),
  );
  assert(reuses(site_of(b"sized")));
  let read = site_of(b"first");
  assert_eq(read.operation, b"Array::set");
  assert_eq(
    read.verdict,
    Copies(
      {
        cause: ContainerElement,
        text: b"`List::at` returns a clone of an element the list still owns",
      },
      Local,
    ),
  );
  let bumped = site_of(b"bump");
  assert(bumped.operation == b"List::set" && reuses(bumped))
}

test "updating a value read from a scope reports a copy, and updating one the scope's callback returns or ends up using reports an undecided cost" {
  let source = b"fn read(xs: List<Int>, n: Int) -> List<Int> = with_scope[r](xs, |l: List<Int>| ()) { h -> h.get().push(n) }\nfn answered(xs: List<Int>, n: Int) -> List<Int> = List::push(with_scope[r](n, |k: Int| ()) { h -> xs }, n)\nfn released(xs: List<Int>, n: Int) -> Int = with_scope[r](xs, |l: List<Int>| { let grown = l.push(n); () }) { h -> n }\n";
  let r = reported([b"m"], [source]);
  assert_eq(r.unfinished, []);
  let site_of = |name: Bytes| r.definitions.filter(|d: Costed| d.name == name).get(0).sites.get(0);
  let read = site_of(b"read");
  assert_eq(
    read.verdict,
    Copies(
      {
        cause: ContainerElement,
        text: b"`Scoped::get` returns a copy of a value the scope still owns",
      },
      Local,
    ),
  );
  assert_eq(suggestion(read.verdict), None);
  assert(undecided(site_of(b"answered")));
  assert(undecided(site_of(b"released")))
}

fn reuses(s: Site) -> Bool = match s.verdict { Reuses(_) -> true, _ -> false }

fn undecided(s: Site) -> Bool = match s.verdict { Undecided(_, _) -> true, _ -> false }

fn verdict_word(verdict: Verdict) -> Bytes =
  match verdict {
    Reuses(_) -> b"reuses",
    Copies(_, _) -> b"copies",
    Undecided(_, _) -> b"undecided",
  }

fn verdicts(r: Report) -> List<Bytes> =
  r.definitions.fold([], |accumulator: List<Bytes>, d: Costed|
    d.sites.fold(accumulator, |a: List<Bytes>, s: Site|
      a.push(Bytes::concat_all([d.name, b" ", verdict_word(s.verdict)]))))

test "a `returns` clause is checked against the function body, and a mismatch reports the declared and actual return origin" {
  let source = Bytes::concat_all([
    b"fn mk(n: Int) -> List<Int> returns fresh = range(0, n)\n",
    b"fn pick(xs: List<Int>, ys: List<Int>) -> List<Int> returns ys = xs\n",
    b"fn same(xs: List<Int>) -> List<Int> returns xs = xs\n",
    b"fn folded(xs: List<Int>) -> List<Int> returns fresh = xs.fold([], |acc: List<Int>, x: Int| acc.push(x))\n",
  ]);
  let r = reported([b"m"], [source]);
  assert_eq(r.unfinished, []);
  assert_eq(r.return_mismatches.map(|u: ReturnMismatch| (u.name, u.declared, u.actual)), [
    (b"m.pick", b"its parameter `ys`", b"its parameter `xs`"),
    (b"m.folded", b"fresh", b"`List::fold` returns whatever its callback returned"),
  ]);
  assert_eq(source.slice(r.return_mismatches.get(0).start, r.return_mismatches.get(0).end), b"ys")
}

test "an update inside a callback passed to a builtin reports a copy or reuse by what the builtin passes in" {
  let source = Bytes::concat_all([
    b"fn grown(xs: List<Int>) -> List<Int> = xs.fold([], |acc: List<Int>, x: Int| acc.push(x))\n",
    b"fn each(xss: List<List<Int>>) -> List<List<Int>> = xss.map(|ys: List<Int>| ys.push(1))\n",
    b"fn values(m: Map<Int, Int>) -> List<Int> returns fresh = m.fold([], |acc: List<Int>, k: Int, v: Int| acc.push(v))\n",
  ]);
  let r = reported([b"m"], [source]);
  assert_eq(r.unfinished, []);
  let site_of = |name: Bytes| r.definitions.filter(|d: Costed| d.name == name).get(0).sites.get(0);
  assert(reuses(site_of(b"grown")));
  assert_eq(
    site_of(b"each").verdict,
    Copies(
      {
        cause: ContainerElement,
        text: b"an element of the list being iterated over, which the list still owns",
      },
      Local,
    ),
  );
  assert_eq(r.return_mismatches.map(|u: ReturnMismatch| (u.name, u.actual)), [
    (b"m.values", b"`Map::fold` returns whatever its callback returned"),
  ])
}

test "an update that replaces a field with a value grown from that field reuses it, unless the record is read again afterwards" {
  let source = Bytes::concat_all([
    b"type S = { n: Int, out: List<Int> }\n",
    b"type W = { a: Int, b: Int, c: Int, d: Int, e: Int, out: List<Int> }\n",
    b"type N = { k: Int, inner: S }\n",
    b"fn grown(s: S, x: Int) -> S = { ..s, out: s.out.push(x) }\n",
    b"fn counted(s: S, x: Int) -> S = { ..s, n: s.n + 1, out: s.out.push(x) }\n",
    b"fn counted_after(s: S, x: Int) -> S = { ..s, out: s.out.push(x), n: s.n + 1 }\n",
    b"fn wide(w: W, x: Int) -> W = { ..w, out: w.out.push(x) }\n",
    b"fn nested(t: N, x: Int) -> N = { ..t, inner: { ..t.inner, out: t.inner.out.push(x) } }\n",
    b"fn read_again(s: S, x: Int) -> Int = { ..s, out: s.out.push(x) }.out.len() + s.out.len()\n",
  ]);
  let r = reported([b"m"], [source]);
  assert_eq(r.unfinished, []);
  assert_eq(verdicts(r), [
    b"grown reuses",
    b"counted reuses",
    b"counted_after reuses",
    b"wide reuses",
    b"nested reuses",
    b"read_again copies",
  ])
}

test "`fold` is treated as returning whatever its callback returns" {
  let lib = Bytes::concat_all([
    b"pub fn made(n: Int) -> List<Int> returns fresh = range(0, n).fold([], |acc: List<Int>, x: Int| acc.push(x))\n",
    b"pub fn plain(n: Int) -> List<Int> = range(0, n)\n",
  ]);
  let app = b"import lib.more\nreuse fn grow(n: Int) -> List<Int> = more::made(n).push(n)\nreuse fn other(n: Int) -> List<Int> = more::plain(n).push(n)\n";
  let r = reported([b"app", b"lib.more"], [app, lib], [0, 1]);
  assert_eq(r.unfinished, []);
  assert_eq(verdicts(r), [b"grow reuses", b"other undecided"]);
  assert_eq(r.return_mismatches, [])
}

test "a callee in another body is read through the given return, and a demand names the callee" {
  let source = b"pub fn kept(xs: List<Int>) -> List<Int> = xs\nfn grow(xs: List<Int>, n: Int) -> List<Int> = kept(xs).push(n)\n";
  let c = checked_cost_input([b"m"], [source]);
  let only_grow = { ..c.input, roots: Some(Set::of_list([b"m.grow"])) };
  let walked = lowered_over(c.program, ||
    walked_group(only_grow, |name: Bytes|
      if name == b"m.kept" { ReturnOfParam(0) } else { FreshReturn }));
  assert_eq(walked.bodies.map(|b: WalkedBody| b.item_kind), [CostedFunction(b"m.grow")]);
  assert_eq(walked.bodies.get(0).demands, [
    { callee: b"m.kept", param: 0, owner: ParamOwner({ definition: b"m.grow", index: 0 }) },
  ])
}
