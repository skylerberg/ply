import std.fs
import compiler.emit.reads (over_analysis)
import std.bin
import std.list
import compiler.store.memo.engine (Run, in_session, reading)
import compiler.store.handles (QueryOf, Written, written, fetch, query_definition)
import compiler.emit.costs (Costed, Report, cost_input_of, report_of, report_over_one_walk)
import compiler.check.resolve.tables (Source)
import compiler.front.checking (fresh_registry, inputs_alone, lookup_input_alone, over_decoding,
                                prelude_files, prelude_frames)
import compiler.check.infer.checker (DefinitionInfo)
import compiler.front.checking.promises (MeasureEntry, measure_program, measures_query,
                                         module_costs_query)
import compiler.front.checking.groups (GroupKey, group_key_bin)
import compiler.front.checking.world (ModuleKey, QueryEffects, CheckDefinition)
import compiler.front.diagnostics (parse_all)
import compiler.front.emitter_input (Analysed, Rejected)
import compiler.front.published (analyse)

type Queried<o> = { store: fs::MemFs, run: Run, outputs: List<o> }

fn queried<i, o>(
  store: fs::MemFs,
  sources: List<Source>,
  q: QueryOf<i, o>,
  inputs: List<i>,
  more: List<CheckDefinition> = [],
) -> Queried<o> / {abort.raise} = {
  let w = inputs_alone(sources);
  let qs = fresh_registry(more);
  let done = over_decoding(
    store,
    prelude_frames,
    prelude_files,
    |kind: Bytes, at: Bytes| lookup_input_alone(w, kind, at),
    ||
      in_session(qs, |run: Run| {
        let read = reading(qs, run, || inputs.map(|input: i| fetch(q, input)));
        { run: read.run, value: read }
      }),
  );
  { store: done.store, run: done.value.run, outputs: done.value.value }
}

fn module_key(s: Source) -> ModuleKey = { module: s.name, shipped: false, tested: false }

fn costs_queried(store: fs::MemFs, sources: List<Source>) -> Queried<Report> / {abort.raise} =
  queried(store, sources, module_costs_query(), sources.map(module_key))

fn report_in(a: Queried<Report>) -> Report = report_of(a.outputs)

fn costed_sources(pushed: Bytes, kept_twice: Bool) -> List<Source> =
  [
    { name: b"a", source_text: b"pub fn keep(xs: List<Int>) -> List<Int> = xs.push(0)\n" },
    {
      name: b"b",
      source_text: Bytes::concat_all([
        b"import a (keep)\n\nfn grow(xs: List<Int>) -> List<Int> = keep(xs).push(",
        pushed,
        b")\n\nfn sized(xs: List<Int>) -> Int = ",
        if kept_twice { b"keep(xs).len() + xs.len()" } else { b"keep(xs).len()" },
        b"\n",
      ]),
    },
  ]

test "an edit to a body that leaves its demands alone gives the report of a fresh check" {
  let first = costs_queried(fs::mem_empty(), costed_sources(b"1", false));
  let edited = costs_queried(first.store, costed_sources(b"2", false));
  assert_eq(
    report_in(edited),
    report_in(costs_queried(fs::mem_empty(), costed_sources(b"2", false))),
  )
}

test "an edit that changes what a body demands gives the report of a fresh check" {
  let first = costs_queried(fs::mem_empty(), costed_sources(b"1", false));
  let edited = costs_queried(first.store, costed_sources(b"1", true));
  assert_eq(
    report_in(edited),
    report_in(costs_queried(fs::mem_empty(), costed_sources(b"1", true))),
  )
}

const varied_sources: List<Source> =
  [
    {
      name: b"a",
      source_text: b"pub type Box = { items: List<Int> }\n\npub fn add(b: Box, n: Int) -> Box = { ..b, items: b.items.push(n) }\n\npub fn keep(xs: List<Int>) -> List<Int> returns xs = xs\n\npub fn made(n: Int) -> List<Int> returns fresh = range(0, n)\n",
    },
    {
      name: b"b",
      source_text: b"import a (Box, add, keep, made)\n\nfn ping(xs: List<Int>, n: Int) -> List<Int> = if n <= 0 { xs } else { pong(xs.push(n), n - 1) }\n\nfn pong(xs: List<Int>, n: Int) -> List<Int> = if n <= 0 { xs } else { ping(xs.push(n), n - 1) }\n\nreuse fn once(xs: List<Int>) -> List<Int> = keep(xs).push(1)\n\nfn both(xs: List<Int>) -> List<Int> = keep(xs).push(xs.len())\n\nfn mapped(xss: List<List<Int>>) -> List<List<Int>> = xss.map(|ys: List<Int>| ys.push(1))\n\nfn boxed(b: Box) -> Box = add(b, 1)\n\ntest \"counts down\" {\n  assert_eq(ping(made(1), 2), [0, 2, 1]);\n  assert_eq(boxed({ items: [] }).items, [1])\n}\n",
    },
  ]

fn sites_by_label(r: Report) -> List<Costed> =
  r.definitions.sort_by(|a: Costed, b: Costed|
    match compare_values(a.label, b.label) { Greater -> false, _ -> true })

test "the report over one walk of each unit equals the report over one walk of the whole program" {
  let sources = varied_sources;
  let by_units = report_in(costs_queried(fs::mem_empty(), sources));
  match analyse(parse_all(sources)) {
    Rejected(_) -> panic("the checker rejected a program that should be valid"),
    Analysed(w) -> {
      let whole = over_analysis(w, || report_over_one_walk(cost_input_of(w)));
      assert(by_units.ok);
      assert(by_units.definitions.len() > 0);
      assert_eq(sites_by_label(by_units), sites_by_label(whole));
      assert_eq(by_units.return_mismatches, whole.return_mismatches)
    },
  }
}

fn measured_sources(spare: Bytes) -> List<Source> =
  [
    {
      name: b"m",
      source_text: b"fn is_small(n: Int) -> Bool = n <= 0\n\nfn lowered(n: Int) -> Int decreases n = if is_small(n) { 0 } else { lowered(n - 1) + 1 }\n",
    },
    { name: b"n", source_text: Bytes::concat_all([b"pub fn spare() -> Int = ", spare, b"\n"]) },
  ]

fn measures_queried(
  store: fs::MemFs,
  sources: List<Source>,
) -> Queried<List<MeasureEntry>> / {abort.raise} =
  queried(store, sources, measures_query(), sources.map(module_key))

fn entries_in(a: Queried<List<MeasureEntry>>) -> List<MeasureEntry> =
  a.outputs.fold([], |accumulator: List<MeasureEntry>, entries: List<MeasureEntry>|
    accumulator.concat(entries))

test "an edit that a measured function does not reach leaves its program alone" {
  let first = measures_queried(fs::mem_empty(), measured_sources(b"1"));
  assert_eq(entries_in(first).len(), 1);
  let edited = measures_queried(first.store, measured_sources(b"2"));
  assert_eq(entries_in(edited), entries_in(first))
}

fn names_query() -> QueryOf<GroupKey, List<Bytes>> =
  {
    name: b"names in a measured program",
    input: group_key_bin(),
    output: bin::list_bin(bin::bytes_bin()),
  }

fn names_in_program(unit: GroupKey) -> Written / {QueryEffects, abort.raise} =
  written(names_query(), match measure_program(unit).outcome {
    Rejected(_) -> [],
    Analysed(a) -> a.checked.definitions.map(|d: DefinitionInfo| d.name),
  })

test "a measured function's program holds the bodies it calls and checks on its own" {
  let first = measures_queried(fs::mem_empty(), measured_sources(b"1"));
  let unit: GroupKey = entries_in(first).get(0).unit;
  let read = queried(first.store, measured_sources(b"1"), names_query(), [unit], [
    query_definition(names_query(), names_query().name, names_in_program),
  ]);
  let names = read.outputs.get(0);
  assert(names.contains(b"m.lowered") && names.contains(b"m.is_small"), None)
}
