fn pages_of(source: Bytes, named: Bytes, law: Bytes) -> List<Page> / {abort.raise} =
  match parse_all([{ name: b"m", source_text: source }]) {
    [p] -> match analysed_over([{ name: b"m", source_text: source }]) {
      Rejected(_) -> panic("the test source fails to check"),
      Analysed(w) ->
        module_pages(p.module, source, {
          definitions: w.checked.definitions,
          hashes: w.hashes.definitions.fold(
            Map::new(),
            |accumulator: Map<Bytes, Bytes>, x: { name: Bytes, hash: Bytes }|
              accumulator.insert(x.name, x.hash),
          ),
          laws_by_definition: Map::new().insert(named, [law]),
        }).pages,
    },
    _ -> panic("parsing one module must return exactly one module"),
  }

test "a `const` is documented as it is written" {
  let pages = pages_of(b"/// The answer.\npub const answer: Int = 42\n", b"m.answer", b"l");
  assert_eq(
    pages.find(|p: Page| p.name == "m.answer").map(|p: Page| p.signature),
    Some("pub const answer: Int"),
  )
}

test "a module's documentation has a page for the module and for each definition, type, effect and effect operation it declares" {
  let source = b"//! Counting.\n\n/// One more.\npub fn more(x: Int) -> Int\n  ensures result > x\n= x + 1\n\n/// A shape.\npub type Shape = | Dot | Line(Int)\n\npub effect ledger {\n  /// Writes it down.\n  write record(n: Int) -> Unit\n}\n";
  let pages = pages_of(source, b"m.more", b"more grows");
  assert_eq(pages.map(|p: Page| p.kind ++ " " ++ p.name ++ " as " ++ p.simple), [
    "module m as ",
    "definition m.more as more",
    "type m.Shape as Shape",
    "effect m.ledger as ledger",
    "operation m.ledger.record as ledger.record",
  ]);
  let page = |name: String|
    match pages.find(|p: Page| p.name == name) {
      Some(p) -> p,
      None -> panic("`" ++ name ++ "` has a page"),
    };
  assert_eq(page("m").doc, ["Counting."]);
  assert_eq(page("m").members.map(|m: Member| m.kind ++ " " ++ m.signature), [
    "definition pub fn more(x: Int) -> Int",
    "type pub type Shape",
    "effect pub effect ledger",
  ]);
  let more = page("m.more");
  assert_eq(more.signature, "pub fn more(x: Int) -> Int");
  assert_eq(more.params, [{ name: "x", ty: "Int" }]);
  assert_eq(more.doc, ["One more."]);
  assert_eq(more.clauses, ["ensures result > x"]);
  assert_eq(more.effects, Some([]));
  assert_eq(more.laws, ["more grows"]);
  assert(more.hash != None);
  assert_eq(source.slice(more.at, more.at + 7), b"fn more");
  assert_eq(page("m.Shape").members.map(|m: Member| m.signature), ["Dot", "Line(Int)"]);
  assert_eq(page("m.Shape").laws, []);
  assert_eq(page("m.ledger").members, [
    {
      kind: "operation",
      name: "record",
      signature: "write record(n: Int) -> Unit",
      doc: ["Writes it down."],
    },
  ]);
  assert_eq(page("m.ledger.record").signature, "write record(n: Int) -> Unit")
}

test "a type's page lists its variants, then its functions: all of a private type's functions but only the `pub` ones of a `pub` type" {
  let source = b"pub type Shape = | Dot | Line(Int)\n\n/// How long.\npub fn Shape::length(s: Shape) -> Int = match s { Dot -> 0, Line(n) -> n }\n\nfn Shape::kept(s: Shape) -> Int = 0\n\ntype Inner = | Inner\n\nfn Inner::made() -> Inner = Inner\n";
  let pages = pages_of(source, b"none", b"none");
  let members = |name: String|
    match pages.find(|p: Page| p.name == name) {
      Some(p) -> p.members.map(|m: Member| m.kind ++ " " ++ m.name ++ ": " ++ m.signature),
      None -> panic("`" ++ name ++ "` has a page"),
    };
  assert_eq(members("m.Shape"), [
    "variant Dot: Dot",
    "variant Line: Line(Int)",
    "function length: pub fn Shape::length(s: m.Shape) -> Int",
  ]);
  assert_eq(members("m.Inner"), [
    "variant Inner: Inner",
    "function made: fn Inner::made() -> m.Inner",
  ])
}

test "each root a program requests has a key built from its kind, and the key's printed text equals the matching emitter root's name" {
  let user = [
    {
      name: b"m",
      source_text: Bytes::concat_all([
        b"fn f(x: Int) -> Int requires x > 0 ensures result > 0 = x\n",
        b"fn none<a>() -> List<a> ensures result.len() == 0 = []\n",
        b"test \"t\" for n: Int in [1] { assert(n > 0) }\n",
        b"law \"l\" forall (x: Int) where x > 0 { x + 1 > x }\n",
        b"law \"s\" forall (x: a) { x == x }\n",
      ]),
    },
  ];
  let cases = {
    name: b"std.cases",
    source_text: Bytes::concat_all([
      b"pub type Table<a> = List<a>\n",
      b"pub type Listed = { label: String, identity: Bytes }\n",
      b"pub fn listed<a | e>(table: List<a>, label: (a) -> String / e) -> List<Listed> / {abort.raise | e} = table.map(|c: a| { label: label(c), identity: b\"\" })\n",
      b"pub fn chosen<a>(table: List<a>, at: Int, wanted: Bytes) -> a / {abort.raise} = match table.at(at) { Some(c) -> c, None -> panic(\"no case\") }\n",
    ]),
  };
  let analysed = checked_in_memory(in_memory(user, [cases]));
  let dump = dump_of(analysed.outcome);
  let offers = requested_roots(dump);
  assert_eq(offers.filter(|k: RootKey| module_of(k) == b"m"), [
    Named(b"m.f"),
    Named(b"m.none"),
    test_key(b"m", b"t"),
    Clause({ definition: Named(b"m.f"), kind: Requires, n: 0 }),
    Clause({ definition: Named(b"m.f"), kind: Ensures, n: 0 }),
    Clause({ definition: Named(b"m.none"), kind: Ensures, n: 0 }),
    TestCases(test_key(b"m", b"t")),
    law_key(b"m", b"l", LawGuard),
    law_key(b"m", b"l", LawBody),
    law_key(b"m", b"s", LawBody),
  ]);
  let mine = offers.filter(|k: RootKey| module_of(k) == b"m");
  assert_eq(
    mine.filter(|k: RootKey|
      over_outcome(analysed, |_: Analysis| enters(lowering_input_of(dump), k))),
    mine.filter(|k: RootKey| k != law_key(b"m", b"s", LawBody)),
  )
}

test "a host handler waits for the result of each operation whose clause performs a wait, including when the wait is inside a helper function" {
  let user = [
    {
      name: b"m",
      source_text: b"import std.fact (fact)\npub fn asked() -> Int / {fact.slow, fact.fast, fact.behind} = fact.slow() + fact.fast() + fact.behind()\n",
    },
  ];
  let fact = {
    name: b"std.fact",
    source_text: Bytes::concat_all([
      b"import std.internal.native (native, wait, job_wait)\n",
      b"pub effect fact {\n  read slow() -> Int\n  read fast() -> Int\n  read behind() -> Int\n}\n",
      b"host for fact by served\n",
      b"fn waited() -> Int / {native.read, wait.read} = job_wait(1).len()\n",
      b"fn served<a | e>(go: () -> a / {fact.slow, fact.fast, fact.behind | e}) -> a / {native.read, wait.read | e} =\n",
      b"  handle { go() } with { fact.slow() -> job_wait(0).len(), fact.fast() -> 1, fact.behind() -> waited() }\n",
    ]),
  };
  let native = {
    name: b"std.internal.native",
    source_text: b"pub nondet effect native {}\npub nondet effect wait {}\npub extern fn job_wait(ticket: Int) -> Bytes / {native.read, wait.read}\n",
  };
  let dump = dump_of(analysed_over(user, [fact, native]));
  assert_eq(
    dump.diagnostics.filter(|d: Diagnostic| d.severity == Error).map(|d: Diagnostic| d.message),
    [],
  );
  assert_eq(
    dump.effects.filter(|r: EffectRow| r.name == b"std.fact.fact").map(|r: EffectRow| r.waits),
    [[b"slow", b"behind"]],
  )
}

test "an `ensures` clause about a function that a definition returns gets no entry function, because the runtime can return a function but cannot call one" {
  let user = [
    {
      name: b"m",
      source_text: b"pub fn adder(n: Int) -> (Int) -> Int ensures result(1) == n + 1 = |x: Int| x + n\n",
    },
  ];
  let analysed = checked_in_memory(in_memory(user));
  let dump = dump_of(analysed.outcome);
  let entered = |k: RootKey|
    over_outcome(analysed, |_: Analysis| enters(lowering_input_of(dump), k));
  assert(entered(Named(b"m.adder")), None);
  assert(!entered(Clause({ definition: Named(b"m.adder"), kind: Ensures, n: 0 })), None)
}

fn over_outcome<a>(
  analysed: CheckedInMemory,
  body: (Analysis) -> a / {EmitReads},
) -> a / {abort.raise} =
  match analysed.outcome {
    Analysed(a) -> lowered_over(analysed.program, || body(a)),
    Rejected(_) -> panic("the program does not check"),
  }

fn outputs_of(analysed: CheckedInMemory, root: RootKey) -> List<Bytes> / {abort.raise} =
  over_outcome(analysed, |a: Analysis|
    emit::root_outputs(emit::scope_of(a, true, [root]), [root], Map::new()).map(|r: RootOutput|
      root_text(r.name)))

test "a module's analysis record lists the standard library modules it uses without importing, such as the list module and the scheduler" {
  let user = [
    {
      name: b"m",
      source_text: b"pub fn first(xs: List<Int>) -> Int / {abort.raise, task.write} = {\n  task.yield();\n  xs.get(0)\n}\n",
    },
    { name: b"n", source_text: b"import m\npub fn one() -> Int = 1\n" },
  ];
  let shipped = [
    {
      name: b"std.list",
      source_text: b"pub fn List::get<a>(xs: List<a>, i: Int) -> a / {abort.raise} = match xs.at(i) { Some(x) -> x, None -> panic(\"no element there\") }\n",
    },
    { name: b"std.internal.schedule", source_text: b"pub fn idle() -> Int = 0\n" },
  ];
  let dump = dump_of(analysed_over(user, shipped));
  let unimported = |module: Bytes|
    dump.modules.filter(|row: ModuleRow| row.name == module).map(|row: ModuleRow| row.unimported);
  assert_eq(unimported(b"m"), [[b"std.list", b"std.internal.schedule"]]);
  assert_eq(unimported(b"n"), [[]])
}

test "a `law` whose body uses a type variable that the checker treats as unknown is compiled as a generic function, without a copy for each type" {
  let user = [
    {
      name: b"m",
      source_text: b"fn pair<a>(x: a) -> a = x\n\nlaw \"identity is identity\"\n  forall (x: a) {\n    pair(x) == x\n  }\n",
    },
  ];
  let root = law_key(b"m", b"identity is identity", LawBody);
  assert_eq(outputs_of(checked_in_memory(in_memory(user)), root), [printed(root)])
}

fn accepted_analysis(analysis: AnalysisOutcome) -> Analysis / {abort.raise} =
  match analysis { Analysed(w) -> w, Rejected(ds) -> panic("analysis rejected") }

test "an interface round-trips through its binary encoding" {
  let base = depends;
  let iface = interface_of(accepted_analysis(analysed_over([base])), [base], [b"base"]);
  assert_eq(iface.modules.len(), 1);
  match bin::decode(bin::encode(iface, interface_bin()), interface_bin()) {
    Ok(back) -> assert_eq(back, iface),
    Err(e) -> panic("an interface did not decode"),
  }
}

test "a `transparent` function's body is part of its contract, and its stub retains the body" {
  let lib = |two_body: Bytes|
    Bytes::concat_all([
      b"pub fn one() -> Int = 0 + 1\npub transparent fn two(x: Int) -> Int = ",
      two_body,
      b"\n",
    ]);
  let before = contracts_of(lib(b"x + one()"));
  assert(
    contract_named(contracts_of(lib(b"x + one() + 0")), b"lib.two")
      != contract_named(before, b"lib.two"),
    Some("the body is read"),
  );
  assert_eq(
    contract_named(contracts_of(lib(b"x + one()").concat(b"fn aside() -> Int = 2\n")), b"lib.two"),
    contract_named(before, b"lib.two"),
  );
  let source = lib(b"x + one()");
  let stub = stub_module(
    source,
    parse_all([{ name: b"base.lib", source_text: source }]).get(0).module,
  );
  assert(stub.index_of(b"= x + one()") != None, Some(String::of_bytes(stub)));
  assert(stub.index_of(b"0 + 1") == None, Some(String::of_bytes(stub)))
}

test "a `returns` clause is part of a definition's contract" {
  let lib = |clause: Bytes|
    Bytes::concat_all([b"pub fn made(n: Int) -> List<Int>", clause, b" = range(0, n)\n"]);
  assert(
    contract_named(contracts_of(lib(b" returns fresh")), b"lib.made")
      != contract_named(contracts_of(lib(b"")), b"lib.made"),
  )
}

fn contracts_of(source: Bytes) -> List<Contract> / {abort.raise} = {
  let w = accepted_analysis(analysed_over([{ name: b"lib", source_text: source }]));
  public_contracts(w.index, analysis_identities(w), |m: Bytes| m == b"lib")
}

fn contract_named(cs: List<Contract>, name: Bytes) -> Bytes / {abort.raise} =
  match cs.filter(|contract: Contract| contract.reference.name == name) {
    [contract] -> contract.hash,
    _ -> panic("expected exactly one contract with this name"),
  }

test "a public definition's contract moves with its signature and specification, never its body" {
  let lib = |body: Bytes, spec: Bytes, variants: Bytes|
    Bytes::concat_all([
      b"pub type T = ",
      variants,
      b"\npub fn f(x: Int) -> Int",
      spec,
      b" = ",
      body,
      b"\nfn hidden() -> Int = 1\n",
    ]);
  let base = contracts_of(lib(b"x + 1", b"", b"| A | B"));
  assert_eq(base.map(|contract: Contract| contract.reference.name), [b"lib.T", b"lib.f"]);
  assert_eq(contracts_of(lib(b"x + 2", b"", b"| A | B")), base);
  let specified = contracts_of(lib(b"x + 1", b" ensures result > x", b"| A | B"));
  assert(contract_named(specified, b"lib.f") != contract_named(base, b"lib.f"));
  assert_eq(contract_named(specified, b"lib.T"), contract_named(base, b"lib.T"));
  let widened = contracts_of(lib(b"x + 1", b"", b"| A | B | C"));
  assert(contract_named(widened, b"lib.T") != contract_named(base, b"lib.T"))
}

test "a definition's check result lists the files embedded by that definition only, not by other definitions" {
  let source = b"pub fn a() -> Bytes = embed(\"x.txt\")\n\npub fn b() -> Bytes = embed(\"y.txt\")\n\npub fn c() -> Int = 1\n";
  let file = |path: Bytes| { module: b"m", path: path, bytes: path };
  let w = match analysed_over([{ name: b"m", source_text: source }], [], [
      file(b"x.txt"),
      file(b"y.txt"),
    ]) {
    Analysed(w) -> w,
    Rejected(_) -> panic("the fixture program was rejected by the checker"),
  };
  let check = {
    resolved: { uses: w.uses, embeds: w.embeds },
    declared: w.declared,
    checked: Some(group_part(w)),
    diagnostics: [],
  };
  let reads = owner_texts(w.modules.get(0), parse(source).node, source);
  let embed_keys = |owner: Bytes| {
    let members = reads.filter(|o: OwnerText| o.owner == owner);
    group_result(check, b"m", members, item_layout(members), |x: ItemAt| x.to).embeds.map(
      |e: ModuleEmbed| e.key,
    )
  };
  assert_eq(embed_keys(b"a"), [b"file:x.txt"]);
  assert_eq(embed_keys(b"b"), [b"file:y.txt"]);
  assert_eq(embed_keys(b"c"), [])
}

fn pulled_dump(
  user: List<Source>,
  shipped: List<Source>,
) -> { pulled: List<Bytes>, dump: Dump } / {abort.raise} =
  session_over(in_memory(user, shipped), |own: List<Bytes>| {
    let loaded = query_load(own, [], false, listed_module);
    { pulled: loaded.pulled, dump: dump_of(program_outcome(own, loaded.results)) }
  }).value

fn data_sources(data: List<ShippedData>) -> List<Source> =
  data.map(|d: ShippedData| { name: d.name, source_text: d.bytes })

test "building a program's tables from each module's own check results gives the same tables as checking the whole program at once" {
  match analysed_over(faceted) {
    Rejected(ds) ->
      panic(
        "the fixture program was rejected by the checker: "
          ++ String::of_bytes_lossy(Bytes::concat_all(ds.map(|d: Diagnostic| d.message))),
      ),
    Analysed(w) -> {
      let returned = assembled_program(
        range(0, w.modules.len()).map(|i: Int| module_facts(group_part(w), i)),
        own_hashes_of(
          w.index,
          w.hashes,
          w.modules.fold(Set::empty(), |accumulator: Set<Bytes>, m: ParsedModule|
            accumulator.insert(m.name)),
        ),
        Map::new(),
        true,
        true,
        w.warnings,
        w.manifest,
        w.packages,
        w.locked_packages,
        w.module_packages,
        w.embeds,
      );
      let view = checked_program_of(w);
      let fixed = returned.frame.hashes;
      assert_eq(fixed.definitions, w.hashes.definitions);
      assert_eq(fixed.refs, w.hashes.refs);
      assert_eq(fixed.dependencies, w.hashes.dependencies);
      assert_eq(fixed, w.hashes);
      assert_eq(functions_of(view.frame), view.checked.definitions.len());
      assert_eq(tests_of(view.frame, w.modules.len()), view.checked.tests.len());
      assert_eq(returned.frame, view.frame);
      assert_eq(returned, view);
      let made = view_dump(returned);
      let whole = dump_of(Analysed(w));
      assert_eq(made.definitions, whole.definitions);
      assert_eq(made.tests, whole.tests);
      assert_eq(made.laws, whole.laws);
      assert_eq(made.effects, whole.effects);
      assert_eq(made.constructors, whole.constructors);
      assert_eq(made.keys, whole.keys);
      assert_eq(made.emitter_roots, whole.emitter_roots);
      assert_eq(made.emitter_constructors, whole.emitter_constructors);
      assert_eq(made.rows, whole.rows);
      assert_eq(made.inferred_facts, whole.inferred_facts);
      assert_eq(made, whole)
    },
  }
}

test "a call that leads back to a recursive type through a function in the type's own module is recognised as recursion when every module is analysed" {
  let user = [
    {
      name: b"m",
      source_text: b"pub type Expr<r> = | Leaf(r) | Maybe(Option<Expr<r>>)\npub fn mapped<r, s>(e: Expr<r>, f: (r) -> s) -> Expr<s> = match e { Leaf(x) -> Leaf(f(x)), Maybe(o) -> Maybe(o.map(|y: Expr<r>| mapped(y, f))) }\n",
    },
  ];
  let shipped = [
    {
      name: b"std.option",
      source_text: b"pub fn Option::map<a, b | e>(o: Option<a>, f: (a) -> b / e) -> Option<b> / e bounded = match o { None -> None, Some(x) -> Some(f(x)) }\n",
    },
  ];
  match analysed_over(user, shipped) {
    Rejected(ds) ->
      panic(String::of_bytes_lossy(Bytes::concat_all(ds.map(|d: Diagnostic| d.message)))),
    Analysed(_) -> (),
  }
}

test "a call written after a `?` has the same source position in the checked module as in the module's original text" {
  let program = b"fn parsed(s: String) -> Result<Int, String> = Ok(1)\nfn f(s: String) -> Result<Int, String> = { let n = parsed(s)?; Ok(n + s.len()) }\n";
  let sites = |m: Module|
    expressions_matching(m, |e: Expression|
      match e { PerformExpression(p) -> p.operation.name == b"len", _ -> false }).map(
      expression_span,
    ).map(|at: Span| at.site);
  let declaration_sources = sites(numbered_module(parse(program).node));
  assert_eq(declaration_sources.len(), 1);
  match analysed_over([{ name: b"m", source_text: program }], []) {
    Rejected(ds) ->
      panic(String::of_bytes_lossy(Bytes::concat_all(ds.map(|d: Diagnostic| d.message)))),
    Analysed(w) -> assert_eq(sites(w.modules.get(0).module), declaration_sources),
  }
}

test "a caller's key moves with a value folded into it, and not with a body it only calls" {
  let key_of = |source: Bytes|
    match analysed_over([{ name: b"m", source_text: source }]) {
      Rejected(_) -> panic("the program checks"),
      Analysed(w) ->
        root_keys(
          outlines_of(group_part(w)),
          w.checked,
          w.hashes,
          constant_values(rows_of(w)),
        ).filter(|k: KeyRow| k.root == b"m.f").map(|k: KeyRow| k.key),
    };
  let reading = |value: Bytes|
    key_of(Bytes::concat_all([b"fn c() -> Int = ", value, b"\nfn f(x: Int) -> Int = x + c()"]));
  let calling = |value: Bytes|
    key_of(
      Bytes::concat_all([b"fn h(x: Int) -> Int = x + ", value, b"\nfn f(x: Int) -> Int = h(x)"]),
    );
  assert(reading(b"3") != reading(b"4"), None);
  assert_eq(reading(b"1 + 2"), reading(b"2 + 2"));
  assert_eq(calling(b"3"), calling(b"4"))
}

test "the emitter assigns a key to every emitter root, meaning every function, test, law and contract check, and no two roots have the same key" {
  let program = b"fn pos(x: Int) -> Bool = x > 0\nfn f(x: Int) -> Int requires pos(x) ensures x >= 0 = x\ntest \"t\" { assert_eq(f(1), 1) }\nlaw \"l\" forall (x: Int) { f(x) == x }";
  match analysed_over([{ name: b"m", source_text: program }]) {
    Rejected(_) -> panic("the test program fails to check"),
    Analysed(w) -> {
      let keys = root_keys(
        outlines_of(group_part(w)),
        w.checked,
        w.hashes,
        constant_values(rows_of(w)),
      );
      assert_eq(
        keys.map(|k: KeyRow| k.root),
        [
          b"m.pos",
          b"m.f#requires#0",
          b"m.f#ensures#0",
          b"m.f",
          test_owner(b"m", b"t"),
          law_root(b"l", LawBody),
        ].concat(
          used_prelude_functions,
        ),
      );
      let distinct = Map::of_entries(keys.map(|k: KeyRow| { key: k.key, value: () })).keys();
      assert_eq(distinct.len(), keys.len());
    },
  }
}

test "an emitter root is marked pure only when it is a function definition with no effects and no preconditions or postconditions" {
  let program = b"effect log { write emit(Bytes) -> Unit }\nfn origin() -> Int = 0\nfn hello() -> Unit / { log.write } = log.emit(b\"hi\")\nfn same<a>(x: a, y: a) -> Bool where derivable(eq, a) = x == y\nfn positive(n: Int) -> Int requires n > 0 = n\ntest \"t\" { assert_eq(origin(), 0) }\nlaw \"l\" forall (n: Int) { same(n, n) }";
  let d = dump_of(analysed_over([{ name: b"m", source_text: program }]));
  assert_eq(
    d.emitter_roots.filter(|root: EmitterRoot|
      !used_prelude_functions.contains(printed(root.key))).map(|root: EmitterRoot|
      { root: printed(root.key), pure: root.pure }),
    [
      { root: b"m.origin", pure: true },
      { root: b"m.hello", pure: false },
      { root: b"m.same", pure: false },
      { root: b"m.positive", pure: true },
      { root: test_owner(b"m", b"t"), pure: false },
      { root: b"m.positive#requires#0", pure: false },
      { root: law_root(b"l", LawBody), pure: false },
    ],
  );
  assert_eq(
    d.emitter_roots.filter(|root: EmitterRoot|
      used_prelude_functions.contains(printed(root.key))).map(|root: EmitterRoot|
      printed(root.key)),
    used_prelude_functions,
  )
}

test "a program that declares an effect operation with its own type parameters includes the list and map functions that copy values, because a `perform` may call it with a list or map" {
  let roots = |program: Bytes|
    dump_of(analysed_over([{ name: b"m", source_text: program }])).emitter_roots.map(
      |r: EmitterRoot| printed(r.key),
    );
  let marshalling = [b"List::at", b"List::push", b"Map::entries", b"Map::insert"].map(|n: Bytes|
    qualify(prelude_module, n));
  let generic = roots(
    b"effect box {\n  write put<a>(x: a) -> Unit\n}\nfn main() -> Int = handle { box.put([1]); 0 } with { box.put(x) -> () }\n",
  );
  assert_eq(marshalling.filter(|n: Bytes| !generic.contains(n)), []);
  let plain = roots(
    b"effect box {\n  write put(x: Int) -> Unit\n}\nfn main() -> Int = handle { box.put(1); 0 } with { box.put(x) -> () }\n",
  );
  assert_eq(marshalling.filter(|n: Bytes| plain.contains(n)), [])
}

fn law_root(label: Bytes, part: LawPart) -> Bytes / {abort.raise} =
  root_text(root_name(law_key(b"m", label, part)))

test "an emitter root records a fixed integer width exactly for the parameters and result whose type is a fixed-width integer" {
  let program = b"fn low_bit(b: U8) -> Int requires Int::of_u8(b) < 200 ensures result < 2 = Int::of_u8(b & 1u8)\nfn narrow(n: Int) -> U8 / {abort.raise} requires n >= 0 ensures Int::of_u8(result) == n = U8::of_int(n)\nfn inc(x: Int) -> Int requires x > 0 ensures result > x = x + 1\ntest \"t\" { assert_eq(inc(1), 2) }\nlaw \"low\" forall (b: U8) where Int::of_u8(b) > 0 { low_bit(b) < 2 }\nlaw \"grows\" forall (x: Int) where x > 0 { inc(x) > x }";
  let d = dump_of(analysed_over([{ name: b"m", source_text: program }]));
  assert_eq(
    d.emitter_roots.filter(|root: EmitterRoot|
      !used_prelude_functions.contains(printed(root.key))).map(|root: EmitterRoot|
      { root: printed(root.key), params: root.params, result: root.result }),
    [
      { root: b"m.low_bit", params: [FixedWidth(0)], result: NoWidths },
      { root: b"m.narrow", params: [NoWidths], result: FixedWidth(0) },
      { root: b"m.inc", params: [NoWidths], result: NoWidths },
      { root: test_owner(b"m", b"t"), params: [], result: NoWidths },
      { root: b"m.low_bit#requires#0", params: [FixedWidth(0)], result: NoWidths },
      { root: b"m.low_bit#ensures#0", params: [FixedWidth(0), NoWidths], result: NoWidths },
      { root: b"m.narrow#requires#0", params: [NoWidths], result: NoWidths },
      { root: b"m.narrow#ensures#0", params: [NoWidths, FixedWidth(0)], result: NoWidths },
      { root: b"m.inc#requires#0", params: [NoWidths], result: NoWidths },
      { root: b"m.inc#ensures#0", params: [NoWidths, NoWidths], result: NoWidths },
      { root: law_root(b"low", LawGuard), params: [FixedWidth(0)], result: NoWidths },
      { root: law_root(b"low", LawBody), params: [FixedWidth(0)], result: NoWidths },
      { root: law_root(b"grows", LawGuard), params: [NoWidths], result: NoWidths },
      { root: law_root(b"grows", LawBody), params: [NoWidths], result: NoWidths },
    ],
  )
}

test "a fixed integer width is tracked through lists, maps, records, sum types, functions and variables" {
  let program = b"effect probe { write put(xs: List<U8>, n: Int) -> Unit }\ntype Byte = | Byte(U8)\ntype Tree = | Leaf | Node(Tree, I16, Tree)\ntype Pair<a, b> = | Pair(b, a)\ntype Color = | Red | Green\nfn wrap(xs: List<U8>) -> List<Byte> = xs.map(|x: U8| Byte(x))\nfn pick<a>(xs: List<a>, r: { v: I16, n: Int }) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }\nfn swap(m: Map<String, I8>) -> Pair<Int, U64> / {abort.raise} = Pair(U64::of_int(1), 0)\nfn plain(c: Color, o: Option<Int>) -> Tree = Leaf\nfn apply<a>(f: (Int) -> a, x: Int) -> a = f(x)\nfn sent(xs: List<U8>) -> Unit / { probe.write } = probe.put(xs, 1)";
  let d = dump_of(analysed_over([{ name: b"m", source_text: program }]));
  let carried = |root: EmitterRoot|
    { root: printed(root.key), params: root.params, result: root.result };
  assert_eq(
    d.emitter_roots.filter(|root: EmitterRoot| module_of(root.key) == b"m").map(carried),
    [
      { root: b"m.wrap", params: [ListWidths(FixedWidth(0))], result: ListWidths(SumWidths([])) },
      {
        root: b"m.pick",
        params: [
          ListWidths(VariableWidths(0)),
          RecordWidths([{ name: b"n", widths: NoWidths }, { name: b"v", widths: FixedWidth(5) }]),
        ],
        result: SumWidths([VariableWidths(0)]),
      },
      {
        root: b"m.swap",
        params: [MapWidths(NoWidths, FixedWidth(4))],
        result: SumWidths([NoWidths, FixedWidth(3)]),
      },
      { root: b"m.plain", params: [NoWidths, NoWidths], result: SumWidths([]) },
      {
        root: b"m.apply",
        params: [FunctionWidths([NoWidths], VariableWidths(0)), NoWidths],
        result: VariableWidths(0),
      },
      { root: b"m.sent", params: [ListWidths(FixedWidth(0))], result: NoWidths },
    ],
  );
  assert(
    d.emitter_roots.map(carried).contains({
      root: b"std.prelude.List::map",
      params: [
        ListWidths(VariableWidths(0)),
        FunctionWidths([VariableWidths(0)], VariableWidths(1)),
      ],
      result: ListWidths(VariableWidths(1)),
    }),
    None,
  );
  assert_eq(effect_named(d, b"m.probe").operations.map(|o: OperationRow| o.carries), [
    [ListWidths(FixedWidth(0)), NoWidths],
  ]);
  let own = d.emitter_constructors.filter(|k: EmitterConstructor| k.name.slice(0, 2) == b"m.");
  assert_eq(own.map(|k: EmitterConstructor| { name: k.name, fields: k.fields }), [
    { name: b"m.Byte", fields: [FixedWidth(0)] },
    { name: b"m.Leaf", fields: [] },
    { name: b"m.Node", fields: [SumWidths([]), FixedWidth(5), SumWidths([])] },
    { name: b"m.Pair", fields: [VariableWidths(1), VariableWidths(0)] },
    { name: b"m.Red", fields: [] },
    { name: b"m.Green", fields: [] },
  ]);
  let some = d.emitter_constructors.filter(|k: EmitterConstructor| k.name == some_constructor);
  assert_eq(some.map(|k: EmitterConstructor| k.fields), [[VariableWidths(0)]])
}

test "the program description sent to the runtime omits the type information inferred while loading modules and the warnings from checking them" {
  let d = dump_of(analysed_over(program()));
  assert(d.diagnostics.len() > 0, Some("the program warns of something"));
  let shipped = runtime_dump(d);
  assert_eq(shipped.diagnostics, []);
  assert_eq(shipped.inferred_facts, b"");
  assert_eq(runtime_dump({ ..d, inferred_facts: b"another walk", diagnostics: [] }), shipped);
  assert(d.bodies.len() > 0 && d.keys.len() > 0, Some("the program has bodies and keys"));
  assert_eq(shipped.bodies, []);
  assert_eq(shipped.rows, no_rows);
  assert_eq(shipped.keys, []);
  assert_eq(shipped.definitions, d.definitions);
  assert_eq(shipped.hashes, d.hashes);
  assert_eq(shipped.emitter_roots, d.emitter_roots);
  assert_eq(shipped.emitter_constructors, d.emitter_constructors);
  assert_eq(shipped.ordinals, d.ordinals);
  let embedding = dump_of(
    over_words(b"import std.words\npub fn still() -> Int = words::idle()\n", words_data(b"one\n")),
  );
  assert_eq(embedding.embeds.len(), 1);
  assert_eq(runtime_dump(embedding).embeds, [])
}

test "a native program's header contains its entry function and the hash of each function the entry function calls, directly or indirectly" {
  let d = dump_of(analysed_over(faceted));
  let hash_of = |name: Bytes|
    d.hashes.fold(b"", |found: Bytes, frame: HashTableRow|
      match frame {
        DefinitionHashRow(row) -> if row.name == name {
          match row.definition { Some(h) -> h, None -> found }
        } else { found },
        _ -> found,
      });
  let header_names = [
    b"app.worth",
    b"base.cents",
    b"base.coin",
    b"base.half",
    b"base.seven",
  ].concat(
    used_prelude_functions,
  ).sort(
  );
  assert_eq(
    entry_header(d, b"app.worth"),
    Some(
      Bytes::concat_all(
        [b"ply entry 1\napp.worth\n"].concat(
          header_names.map(|n: Bytes| Bytes::concat_all([n, b" ", hash_of(n), b"\n"])),
        ),
      ),
    ),
  );
  assert_eq(entry_header(d, b"app.gone"), None)
}

test "a program's analysis result lists its warnings, its module order, its packages and its modules" {
  let d = dump_of(analysed_over(program()));
  assert_eq(d.diagnostics, [
    {
      code: b"W0611",
      labels: [
        { place: InSource({ module: 0, start: 46, end: 51 }), primary: true, text: b"never used" },
      ],
      text: b"",
      message: b"type `m.Shape` is never used",
      notes_text: [],
      severity: Warning,
      fixes: NoFix,
    },
  ]);
  assert_eq(d.order, [b"std.prelude", b"m"]);
  assert_eq(d.packages.at(0), Some({ prefix: b"", dependencies: [] }));
  assert_eq(d.module_packages, [0, d.packages.len()]);
  assert_eq(
    d.modules.at(0),
    Some({
      name: b"m",
      index: 0,
      items: [b"m.log", b"m.Shape", b"m.Dot", b"m.Line", b"m.say"],
      imports: [prelude_module],
      unimported: [],
      sets: [],
      cuts: [
        { start: 115, end: 126, braced: true, name: b"m.say", test: false },
        { start: 127, end: 152, braced: false, name: b"", test: false },
      ],
    }),
  );
  match d.modules.at(1) {
    Some(prelude) -> {
      assert_eq(prelude.name, prelude_module);
      assert(prelude.items.contains(b"std.prelude.ListNode"), None);
      assert(!prelude.items.any(|i: Bytes| prelude_functions.contains(i)), None)
    },
    None -> assert(false, Some("the result contains the prelude's effects")),
  }
}

const dead_code_sources: List<Source> =
  [
    {
      name: b"m",
      source_text: b"pub fn api() -> Int = shared()\nfn shared() -> Int = 1\nfn dead() -> Int = deader()\nfn deader() -> Int = 2\nfn tested() -> Int = 3\nfn lawful(x: Int) -> Int = x\nfn positive(x: Int) -> Bool = x > 0\npub fn checked(x: Int) -> Int requires positive(x) = x\ntype Pair = { a: Int }\npub fn make() -> Int = { let f = |x: Int| -> Pair { { a: x } }; f(1).a }\nfn _kept() -> Int = 4\nfn main() -> Int = 5\ntype Unused = | Nothing\ntest \"calls it\" { assert_eq(tested(), 3) }\nlaw \"it is the identity\" forall (x: Int) { lawful(x) == x }",
    },
  ]

fn test_effects(program: Bytes, name: Bytes) -> Bytes / {abort.raise} =
  match dump_of(analysed_over([{ name: b"m", source_text: program }])).tests.filter(
      |t: TestRow| t.name == name,
    ) {
    [t, ..] -> effect_list_text(t.effects, b","),
    [] -> panic("the analysis result lists no test with that name"),
  }

test "a test's effects include a scoped effect it uses through a function, but not one used only inside a `with_scope` body" {
  let program = b"fn touches(n: Int) -> Int / {scoped.read[log]} = n\n\ntest \"a read\" {\n  let seen = with_scope[log](41, |x: Int| ()) { c -> c.get() };\n  assert_eq(touches(seen), 41)\n}\n\ntest \"inside the region\" {\n  with_scope[log](41, |x: Int| ()) { c -> assert_eq(c.get(), 41) }\n}\n";
  assert_eq(test_effects(program, b"a read"), b"scoped.read[log]");
  assert_eq(test_effects(program, b"inside the region"), b"")
}

test "a general handler clause inside a scope lets the scope's effects escape the scope, while a tail-resumptive clause does not" {
  let program = b"effect amb { read flip[coin]() -> Bool }\n\nfn leaks(n: Int) -> Int / {scoped.read[t]} =\n  with_scope[t](n, |x: Int| ()) { c ->\n    handle { let b = amb.flip[coin](); c.get() + 1 }\n    with { amb.flip[coin]() resume k -> k(true), return x -> x }\n  }\n\nfn discharges(n: Int) -> Int =\n  with_scope[t](n, |x: Int| ()) { c ->\n    handle { c.get() + 1 }\n    with { amb.flip[coin]() -> true, return x -> x }\n  }\n\ntest \"through a general clause\" { assert_eq(leaks(1), 2) }\ntest \"through a tail-resumptive one\" { assert_eq(discharges(1), 2) }\n";
  assert_eq(test_effects(program, b"through a general clause"), b"scoped.read[t]");
  assert_eq(test_effects(program, b"through a tail-resumptive one"), b"")
}

test "only a definition that no emitter root uses gets an unused-definition warning, once, at the definition's name" {
  let d = dump_of(analysed_over(dead_code_sources));
  let messages = d.diagnostics.map(|diagnostic: Diagnostic| diagnostic.message);
  assert(messages.contains(b"fn `m.dead` is never used"));
  assert(messages.contains(b"fn `m.deader` is never used"));
  assert(messages.contains(b"type `m.Unused` is never used"));
  assert_eq(messages.len(), 3);
  let program = dead_code_sources.get(0).source_text;
  let named = d.diagnostics.flat_map(|diagnostic: Diagnostic|
    match diagnostic.labels.filter(|l: Label| l.primary) {
      [l, ..] -> labelled_text(program, l).to_list(),
      [] -> [],
    });
  assert_eq(named.sort_by(|a: Bytes, b: Bytes| compare(a, b) == Less), [
    b"Unused",
    b"dead",
    b"deader",
  ]);
  assert(d.order.len() > 0)
}

test "a definition's table entry records its effects, its parameters and its source span" {
  let say = definition_named(dump_of(analysed_over(program())), b"m.say");
  assert_eq(say.module, b"m");
  assert_eq(say.simple_name, b"say");
  assert(!say.public && !say.reuse);
  assert_eq(
    scheme_text(scheme_named(published(analysed_over(program())), b"m.say")),
    b"(Bytes) -> Unit / {m.log.write}",
  );
  assert_eq(effect_list_text(say.effects, b","), b"m.log.write");
  assert_eq(effect_list_text(say.performed, b","), b"m.log.emit");
  assert_eq(say.params, [{ name: b"b", at: InSource({ module: 0, start: 79, end: 87 }) }]);
  assert_eq(say.at, InSource({ module: 0, start: 72, end: 126 }))
}

test "a test's table entry is stored at the test's index and records its key" {
  assert_eq(dump_of(analysed_over(program())).tests, [
    {
      key: b"m.says",
      name: b"says",
      module: b"m",
      index: 0,
      nondet: false,
      effects: [
        { effect: b"m.log", resource: SingletonResource, mode: WriteMode, operation: None },
      ],
      at: InSource({ module: 0, start: 127, end: 152 }),
      name_at: InSource({ module: 0, start: 132, end: 138 }),
    },
  ])
}

fn effect_named(d: Dump, name: Bytes) -> EffectRow / {abort.raise} =
  match d.effects.fold(None, |accumulator: Option<EffectRow>, e: EffectRow|
      if e.name == name { Some(e) } else { accumulator }) {
    Some(e) -> e,
    None -> panic("the result contains the effect"),
  }

test "an effect's table entry records each operation with its mode, its types and its source span" {
  let log = effect_named(dump_of(analysed_over(program())), b"m.log");
  assert_eq(log.module, b"m");
  assert_eq(log.simple_name, b"log");
  assert(!log.public && !log.nondet);
  assert_eq(log.operations, [
    {
      name: b"emit",
      mode: WriteMode,
      resource_param: false,
      retained_parameters: [],
      params: [bytes_type],
      return_type: unit_type,
      scheme: None,
      at: InSource({ module: 0, start: 13, end: 38 }),
      carries: [NoWidths],
    },
  ]);
  assert_eq(log.at, InSource({ module: 0, start: 0, end: 40 }))
}

test "a prelude effect has no module and an empty source span, and its operations have a type scheme" {
  let sim = effect_named(dump_of(analysed_over(program())), b"sim");
  assert_eq(sim.module, b"");
  assert(sim.public);
  assert_eq(sim.at, Unplaced);
  assert_eq(sim.operations.map(|o: OperationRow| o.name), [b"seed"]);
  let seed = sim.operations.get(0);
  assert_eq(seed.mode, ReadMode);
  assert_eq(seed.params, []);
  assert_eq(seed.return_type, int_type);
  assert_eq(match seed.scheme { Some(scheme) -> scheme_text(scheme), None -> b"" }, b"() -> Int");
  assert_eq(seed.at, Unplaced)
}

test "a constructor's table entry records its field types and its type scheme" {
  let line = dump_of(analysed_over(program())).constructors.filter(|k: ConstructorRow|
    k.name == b"m.Line");
  assert_eq(line, [
    {
      name: b"m.Line",
      module: b"m",
      simple_name: b"Line",
      type_name: b"m.Shape",
      index: 1,
      arity: 1,
      fields: [int_type],
      scheme: {
        type_variables: [],
        effect_variables: [],
        keep_variables: [],
        label_variables: [],
        ty: FunctionType({
          keep_parameters: [],
          once: false,
          params: [int_type],
          return_type: named_type(b"m.Shape"),
          effects: { listed: [], variable: None },
        }),
      },
      at: InSource({ module: 0, start: 62, end: 71 }),
    },
  ])
}

fn definition_hash_named(d: Dump, name: Bytes) -> HashRow / {abort.raise} =
  match d.hashes.fold(None, |accumulator: Option<HashRow>, h: HashTableRow|
      match h {
        DefinitionHashRow(r) -> if r.name == name { Some(r) } else { accumulator },
        _ -> accumulator,
      }) {
    Some(r) -> r,
    None -> panic("the analysis result has no hash for that definition"),
  }

fn body_named(d: Dump, name: Bytes) -> FramedBody / {abort.raise} =
  match d.bodies.fold(None, |accumulator: Option<FramedBody>, b: BodyRow|
      if b.name == name { Some(b.body) } else { accumulator }) {
    Some(b) -> b,
    None -> panic("the result contains the body"),
  }

test "a definition's entry in the hash table records the definition's hash and the definitions it references, and hashing its body gives the definition hash" {
  let d = dump_of(analysed_over(program()));
  let say = definition_hash_named(d, b"m.say");
  assert_eq(say.dependencies, [b"m.log"]);
  let order = d.hashes.map(|h: HashTableRow|
    match h { DefinitionHashRow(r) -> r.name, TestHashRow(r) -> r.key, LawHashRow(r) -> r.key });
  let placed = range(0, order.len()).fold(0 - 1, |accumulator: Int, j: Int|
    if order.get(j) == b"m.say" { j } else { accumulator });
  assert_eq(order.at(placed + 1), Some(b"m.says"));
  let body = body_named(d, b"m.say");
  assert(body_key(body) != None);
  assert_eq(match body_key(body) { Some(k) -> Some(hex(k)), None -> None }, say.definition)
}

test "the analysis result lists every function, test and law of each module by position, in source order" {
  assert_eq(dump_of(analysed_over(program())).ordinals, [
    { module: b"m", items: [b"fn m.say", b"test m.says"] },
    { module: prelude_module, items: [] },
  ])
}

fn specified() -> List<Source> =
  [
    {
      name: b"m",
      source_text: b"effect log { write emit(Bytes) -> Unit }\neffect set Io = {log.write}\nfn say(b: Bytes) -> Unit / {Io} = log.emit(b)\nfn inc(x: Int) -> Int requires x > 0 ensures result > x = x + 1\nlaw \"inc grows\" forall (x: Int) where x > 0 { inc(x) > x }",
    },
  ]

test "a definition's entry in the definition table records its effect aliases, and for each `requires` or `ensures` clause its kind, position and source span" {
  let d = dump_of(analysed_over(specified()));
  let say = definition_named(d, b"m.say");
  assert_eq(say.effect_aliases, [b"Io"]);
  assert_eq(say.params, [{ name: b"b", at: InSource({ module: 0, start: 76, end: 84 }) }]);
  assert_eq(say.at, InSource({ module: 0, start: 69, end: 114 }));
  let increment = definition_named(d, b"m.inc");
  assert_eq(
    scheme_text(scheme_named(published(analysed_over(specified())), b"m.inc")),
    b"(Int) -> Int",
  );
  assert_eq(increment.effects, []);
  assert_eq(increment.params, [{ name: b"x", at: InSource({ module: 0, start: 122, end: 128 }) }]);
  assert_eq(increment.spec, [
    {
      kind: RequiresClause,
      index: 0,
      effects: [],
      at: InSource({ module: 0, start: 137, end: 151 }),
    },
    {
      kind: EnsuresClause,
      index: 1,
      effects: [],
      at: InSource({ module: 0, start: 152, end: 170 }),
    },
  ]);
  assert_eq(increment.at, InSource({ module: 0, start: 115, end: 178 }));
  assert_eq(increment.literals, [b"int 0"]);
  assert_eq(d.ordinals, [
    { module: b"m", items: [b"fn m.say", b"fn m.inc requires,ensures", b"law m.inc grows"] },
    { module: prelude_module, items: [] },
  ])
}

fn rows_written_as(row: Bytes) -> List<Source> =
  [
    {
      name: b"m",
      source_text: Bytes::concat_all([
        b"pub effect log { write emit(Bytes) -> Unit }\neffect set Io = {log.write}\n",
        b"pub fn say(b: Bytes) -> Unit / {",
        row,
        b"} = log.emit(b)\npub fn twice(b: Bytes) -> Unit / {",
        row,
        b"} = {\n  say(b);\n  say(b)\n}\n",
      ]),
    },
  ]

fn definition_hashes(d: Dump) -> List<{ name: Bytes, definition: Option<Bytes> }> =
  d.hashes.fold(
    [],
    |accumulator: List<{ name: Bytes, definition: Option<Bytes> }>, f: HashTableRow|
      match f {
        DefinitionHashRow(r) -> accumulator.push({ name: r.name, definition: r.definition }),
        _ -> accumulator,
      },
  )

test "a program that names an effect set and one that writes out the set's effects produce the same hashes, bodies and table entries" {
  let aliased = rows_written_as(b"Io");
  let expanded = rows_written_as(b"log.write");
  let published = |sources: List<Source>| {
    let rows = rows_of(analysis_of(sources));
    {
      definitions: rows.definitions.map(|row: KnownDefinitionRow|
        { ..row, facts: CheckedElsewhere }),
      tests: rows.tests.map(|row: KnownTestRow|
        { key: row.key, effects: row.effects, owner: row.owner }),
    }
  };
  assert_eq(published(aliased), published(expanded));
  let a = dump_of(analysed_over(aliased));
  let e = dump_of(analysed_over(expanded));
  assert_eq(definition_hashes(a), definition_hashes(e));
  assert(definition_hashes(a).len() >= 2);
  assert_eq(a.bodies, e.bodies);
  assert_eq(a.definitions.map(|row: DefinitionRow| row.effect_aliases), [[b"Io"], [b"Io"]]);
  assert_eq(e.definitions.map(|row: DefinitionRow| row.effect_aliases), [[], []])
}

test "a definition's table entry records whether it is public, whether it reuses memory, and its parameters as written in the source" {
  let keep = definition_named(dump_of(analysed_over(declaration_sources())), b"m.keep");
  assert(keep.public && keep.reuse);
  assert_eq(keep.params, [{ name: b"xs", at: InSource({ module: 0, start: 104, end: 117 }) }])
}

test "a type's table entry records the type's number of type parameters and whether it is public" {
  let rows = dump_of(analysed_over(declaration_sources())).types.map(|t: TypeRow|
    { name: t.name, module: t.module, public: t.public, arity: t.arity });
  assert_eq(
    rows.filter(|t: { name: Bytes, module: Bytes, public: Bool, arity: Int }| t.module == b"m"),
    [{ name: b"m.Pair", module: b"m", public: true, arity: 2 }],
  );
  assert(
    rows.contains({
      name: b"std.prelude.ListNode",
      module: b"std.prelude",
      public: false,
      arity: 1,
    }),
    None,
  )
}

test "a law's guard lists its integer literals in the order the law search tries them, with a negated literal reduced to a single number" {
  assert_eq(dump_of(analysed_over(declaration_sources())).laws.map(|l: LawRow| l.literals), [
    [b"int 7", b"int -3", b"int 3"],
  ])
}

test "a law's entry in the law table records its variables with their source spans and types, and its hash is computed from the law's statement" {
  let d = dump_of(analysed_over(specified()));
  assert_eq(d.laws, [
    {
      key: b"m.inc grows",
      name: b"inc grows",
      module: b"m",
      index: 0,
      binders: [{ name: b"x", at: InSource({ module: 0, start: 203, end: 209 }), ty: int_type }],
      has_guard: true,
      effects: [],
      at: InSource({ module: 0, start: 179, end: 237 }),
      literals: [b"int 0"],
    },
  ]);
  assert_eq(d.modules.map(|row: ModuleRow| row.sets), [
    [
      {
        name: b"Io",
        includes: [],
        listed: [
          { effect: b"m.log", resource: SingletonResource, mode: WriteMode, operation: None },
        ],
      },
    ],
    [],
  ]);
  let law = match d.hashes.fold(None, |accumulator: Option<ItemHashRow>, h: HashTableRow|
      match h { LawHashRow(r) -> Some(r), _ -> accumulator }) {
    Some(r) -> r,
    None -> panic("the law is hashed"),
  };
  assert_eq(law.key, b"m.inc grows");
  assert_eq(law.hash.len(), 64);
  assert_eq(law.dependencies, [b"m.inc"]);
  let increment = definition_hash_named(d, b"m.inc");
  assert(increment.definition != None);
  assert_eq(increment.specs.len(), 2)
}

test "lowering proof claims from an already analysed program gives the same claims as lowering them from the source files" {
  let sources = [
    {
      name: b"base",
      source_text: b"pub type P = { a: Int, b: Int }\npub fn bump(p: P) -> P ensures result.b == 3 = {..p, b: 3}\npub fn same(p: P) -> P = p\npub effect tally { write add[r](n: Int) -> Unit }\npub fn add_twice<[r]>(n: Int) -> Unit / {tally.add[r]} = { tally.add[r](n); tally.add[r](n) }\npub fn keyed<a>(k: a) -> Map<a, Int> where derivable(ord, a) = Map::new().insert(k, 1)\npub fn size(xs: List<Int>) -> Int cost xs.len() space xs.len() = xs.len()\n",
    },
    {
      name: b"app",
      source_text: b"import base\nfn moved(p: base::P) -> Int requires {..p, a: 1}.a == 1 = base::same(p).a\nfn counted() -> Map<Int, Int> / {base::tally.add[c]} = { base::add_twice[c](2); {..base::bump({ a: 0, b: 0 }), a: 1}.a; base::keyed(4) }\nlaw \"bumped\" forall (p: base::P) { base::bump(p) == {..p, b: 3} }\ntest \"updated\" { assert_eq({..base::same({ a: 1, b: 2 }), a: 5}.a, 5) }\n",
    },
  ];
  let w = analysis_of(sources);
  assert_eq(claims_in(w, range(0, sources.len())), claims(sources))
}

fn pulled_hashes(p: AnalysisOutcome) -> List<{ name: Bytes, hash: Bytes }> =
  match p { Analysed(w) -> w.hashes.definitions, Rejected(_) -> [] }

fn definition_names(p: AnalysisOutcome) -> List<Bytes> =
  pulled_hashes(p).map(|d: { name: Bytes, hash: Bytes }| d.name).sort()

const prelude_functions: List<Bytes> =
  parse(prelude_source::text).node.items.fold([], |accumulator: List<Bytes>, item: Item|
    match item {
      FunctionItem(d) -> accumulator.push(qualify(prelude_module, d.name.name)),
      _ -> accumulator,
    }).sort(
  )

test "analysis loads a standard library function together with the definitions its preconditions and postconditions use" {
  let specified = [
    {
      name: b"std.q",
      source_text: b"import std.s (helper)\nimport std.s as s\npub fn used(n: Int) -> Int\n  requires n > s::other()\n  ensures result == model(n) + helper()\n= n\nfn model(n: Int) -> Int = n - further()\nfn further() -> Int = 1\npub fn unused() -> Int = 2\n",
    },
    {
      name: b"std.s",
      source_text: b"pub fn helper() -> Int = 1\npub fn other() -> Int = 4\npub fn idle() -> Int = 5\n",
    },
  ];
  let cut = analysed_over(
    [{ name: b"m", source_text: b"import std.q\npub fn f() -> Int = q::used(9)\n" }],
    specified,
  );
  assert_eq(
    match cut {
      Analysed(_) -> [],
      Rejected(diagnostics) -> diagnostics.map(|d: Diagnostic| d.code),
    },
    [],
  );
  assert_eq(
    definition_names(cut),
    [
      b"m.f",
      b"std.q.further",
      b"std.q.model",
      b"std.q.used",
      b"std.s.helper",
      b"std.s.other",
    ].concat(
      used_prelude_functions,
    ).sort(
    ),
  )
}

test "analysis loads a standard library type together with the functions its module declares for it, even when the program uses neither" {
  let stating = [
    {
      name: b"std.n",
      source_text: b"import std.s (helper)\npub type N = | N(Int)\nkey for N by held\nshow for N by written\nnumeric for N by { add: plus, sub: plus, mul: plus, neg: same, of_int: of }\nfn held(n: N) -> Int = match n { N(x) -> x + helper() }\nfn written(n: N) -> String = \"n\"\nfn plus(a: N, b: N) -> N = a\nfn same(a: N) -> N = a\nfn of(n: Int) -> N = N(n)\npub fn unused() -> Int = 2\n",
    },
    { name: b"std.s", source_text: b"pub fn helper() -> Int = 1\npub fn other() -> Int = 4\n" },
  ];
  let idle = analysed_over(
    [{ name: b"m", source_text: b"import std.n\npub fn f() -> Int = 1\n" }],
    stating,
  );
  assert_eq(
    match idle {
      Analysed(_) -> [],
      Rejected(diagnostics) -> diagnostics.map(|d: Diagnostic| d.code),
    },
    [],
  );
  assert_eq(definition_names(idle), [
    b"m.f",
    b"std.n.held",
    b"std.n.of",
    b"std.n.plus",
    b"std.n.same",
    b"std.n.written",
    b"std.s.helper",
  ]);
  let used = analysed_over(
    [{ name: b"m", source_text: b"import std.n (N)\npub fn f(a: N, b: N) -> Bool = a + b == a\n" }],
    stating,
  );
  assert_eq(definition_names(used), definition_names(idle).concat(used_prelude_functions).sort())
}

const same_name_sources: List<Source> =
  [
    {
      name: b"std.z",
      source_text: b"pub effect pack {\n  raise rejected(at: Int)\n}\npub effect Pack {\n  raise spilled(at: Int)\n}\npub type Pack = | Pack(Int) | Loose\npub fn pack(n: Int) -> Pack = Pack(squeezed(n))\nfn squeezed(n: Int) -> Int = n + deeper()\nfn deeper() -> Int = 1\npub fn try_unpack(p: Pack) -> Int / {pack.rejected, Pack.spilled} =\n  match p { Pack(n) -> if n < 0 { pack.rejected(n) } else { n }, Loose -> Pack.spilled(0) }\npub fn idle() -> Int = 3\n",
    },
    {
      name: b"std.y",
      source_text: b"import std.z (pack, Pack, Loose)\npub fn guarded(n: Int) -> Int / {pack.rejected} = if n < 0 { pack.rejected(n) } else { n }\npub fn loose() -> Pack = Loose\n",
    },
    {
      name: b"std.w",
      source_text: b"pub effect table {\n  raise missing(at: Int)\n}\npub fn table() -> Bytes = embed(\"w/table.txt\")\npub fn rows() -> Int = table().len()\npub fn try_row(n: Int) -> Int / {table.missing} = if n < 0 { table.missing(n) } else { n }\n",
    },
  ]

fn namesake_data(bytes: Bytes) -> List<ShippedData> = [{ name: b"std/w/table.txt", bytes: bytes }]

fn loaded_names(imports: Bytes) -> List<Bytes> / {abort.raise} = {
  let user = [{ name: b"m", source_text: imports.concat(b"\npub fn f() -> Int = 1\n") }];
  let loaded = analysed_over(user, same_name_sources.concat(data_sources(namesake_data(b"one\n"))));
  match loaded {
    Rejected(diagnostics) ->
      diagnostics.map(|d: Diagnostic| Bytes::concat_all([d.code, b": ", d.message])),
    Analysed(_) -> definition_names(loaded),
  }
}

test "importing a standard library function loads only that function, not an effect or a type with the same name" {
  assert_eq(loaded_names(b"import std.z"), [b"m.f"]);
  assert_eq(loaded_names(b"import std.z (try_unpack)"), [b"m.f", b"std.z.try_unpack"]);
  assert_eq(loaded_names(b"import std.z (pack)"), [b"m.f"]);
  assert_eq(loaded_names(b"import std.z (pack, Pack)\npub fn g() -> Pack = pack(2)"), [
    b"m.f",
    b"m.g",
    b"std.z.deeper",
    b"std.z.pack",
    b"std.z.squeezed",
  ]);
  assert_eq(loaded_names(b"import std.z (Pack)"), [b"m.f"]);
  assert_eq(loaded_names(b"import std.z (Loose)"), [b"m.f"]);
  assert_eq(loaded_names(b"import std.z (idle)"), [b"m.f", b"std.z.idle"]);
  assert_eq(loaded_names(b"import std.y (guarded)"), [b"m.f", b"std.y.guarded"]);
  assert_eq(loaded_names(b"import std.y (loose)"), [b"m.f", b"std.y.loose"]);
  assert_eq(loaded_names(b"import std.y"), [b"m.f"]);
  assert_eq(loaded_names(b"import std.w (try_row)"), [b"m.f", b"std.w.try_row"]);
  assert_eq(loaded_names(b"import std.w (rows)"), [b"m.f", b"std.w.rows", b"std.w.table"]);
  assert_eq(loaded_names(b"import std.w (table)"), [b"m.f"])
}

test "changing a data file a bundled function embeds changes that function's hash, but not the hash of modules that never call it" {
  let over = |imports: Bytes, bytes: Bytes|
    analysed_over(
      [{ name: b"m", source_text: imports.concat(b"\npub fn f() -> Int = 1\n") }],
      same_name_sources.concat(data_sources(namesake_data(bytes))),
    );
  let reader = b"import std.w (try_row)";
  assert_eq(definition_names(over(reader, b"one\n")), [b"m.f", b"std.w.try_row"]);
  assert_eq(pulled_hashes(over(reader, b"one\n")), pulled_hashes(over(reader, b"one\ntwo\n")));
  let named = b"import std.w (table)\npub fn g() -> Bytes = table()";
  let one = over(named, b"one\n");
  assert(pulled_hash(one, b"std.w.table") != None);
  assert(
    pulled_hash(one, b"std.w.table") != pulled_hash(over(named, b"one\ntwo\n"), b"std.w.table"),
  );
  assert_eq(dump_of(one).embeds, [
    { module: b"std.w", key: b"file:w/table.txt", read: Ok([embed_file(b"", b"one\n")]) },
  ])
}

test "importing a bundled compiler module includes only the functions the program uses, directly or indirectly" {
  let user = [
    { name: b"m", source_text: b"import compiler.a (first)\npub fn f() -> Int = first()\n" },
  ];
  let shipped = [
    {
      name: b"compiler.a",
      source_text: b"import compiler.b (second, third)\npub fn first() -> Int = second()\npub fn unused() -> Int = third()\n",
    },
    {
      name: b"compiler.b",
      source_text: b"pub fn second() -> Int = 1\npub fn third() -> Int = 2\n",
    },
  ];
  let cut = analysed_over(user, shipped);
  assert_eq(definition_names(cut), [b"compiler.a.first", b"compiler.b.second", b"m.f"])
}

test "analysis loads the bundled modules a program imports in rounds, one round per import depth, each sorted by name" {
  let a = pulled_dump(
    [{ name: b"m", source_text: b"import std.b\nimport std.a\npub fn f() -> Int = 1" }],
    shipped_modules,
  );
  assert_eq(a.pulled, [b"std.a", b"std.b", b"std.prelude", b"std.c"]);
  assert_eq(a.dump.diagnostics, []);
  assert(a.dump.order.len() > 0)
}

test "importing a module that is not bundled reports an error at the import and lists the bundled modules" {
  let a = pulled_dump(
    [{ name: b"m", source_text: b"import std.e\npub fn f() -> Int = 1" }],
    shipped_modules,
  );
  assert_eq(a.pulled, []);
  assert_eq(a.dump.diagnostics, [
    {
      code: b"E0106",
      labels: [
        { place: InSource({ module: 0, start: 7, end: 12 }), primary: true, text: b"not found" },
      ],
      text: b"",
      message: b"no module named `std.e` ships with this compiler",
      notes_text: [
        b"the standard library contains: `std.a`, `std.b`, `std.c`, `std.d`, `std.prelude`",
        b"`ply std` lists them with the hash of the library sources this binary was built from",
      ],
      severity: Error,
      fixes: NoFix,
    },
  ])
}

const compiler_shipped: List<Source> =
  [
    {
      name: b"compiler.a",
      source_text: b"import compiler.b (second)\npub fn first() -> Int = second()",
    },
    { name: b"compiler.b", source_text: b"pub fn second() -> Int = 1" },
  ]

test "a bundled compiler module is loaded from the compiler package when a program imports it" {
  let a = pulled_dump(
    [{ name: b"m", source_text: b"import compiler.a (first)\npub fn f() -> Int = first()" }],
    compiler_shipped,
  );
  assert_eq(a.pulled, [b"compiler.a", prelude_module, b"compiler.b"]);
  assert_eq(a.dump.diagnostics, []);
  assert_eq(
    a.dump.definitions.filter(|row: DefinitionRow| row.name == b"compiler.a.first").len(),
    1,
  )
}

fn messages(d: Dump) -> List<Bytes> = d.diagnostics.map(|diagnostic: Diagnostic| diagnostic.message)

test "a bundled module that imports a module which is not bundled is reported as a compiler error" {
  let a = pulled_dump(
    [{ name: b"m", source_text: b"import compiler.a (first)\npub fn f() -> Int = first()" }],
    [{ name: b"compiler.a", source_text: b"import std.e (e)\npub fn first() -> Int = e()" }],
  );
  assert(
    messages(a.dump).contains(
      b"the shipped module `compiler.a` imports `std.e`, which this build does not ship",
    ),
  )
}

test "a bundled module that imports a non-bundled module gets an error whose label points at that import in the bundled module" {
  let a = pulled_dump([{ name: b"m", source_text: b"import std.x\npub fn f() -> Int = 1" }], [
    { name: b"std.x", source_text: b"import m\npub fn x() -> Int = 1" },
  ]);
  assert_eq(a.pulled, [prelude_module, b"std.x"]);
  let import_diagnostics = a.dump.diagnostics.filter(|diagnostic: Diagnostic|
    diagnostic.message
      == b"the shipped module `std.x` imports `m`, which this build does not ship");
  assert_eq(import_diagnostics.map(|diagnostic: Diagnostic| diagnostic.labels), [
    [
      {
        place: InSource({ module: 2, start: 7, end: 8 }),
        primary: true,
        text: b"a stdlib module may import only modules that ship with it",
      },
    ],
  ])
}

fn returned() -> List<Source> =
  [
    {
      name: b"base",
      source_text: b"pub effect log { write emit(Bytes) -> Unit }\npub type Shape = | Dot | Line(Int)\npub fn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\npub fn same(x: Int) -> Int = x",
    },
    {
      name: b"app",
      source_text: b"import base\nimport std.b\npub fn two() -> Int = base::same(2)",
    },
  ]

fn definition_named(d: Dump, name: Bytes) -> DefinitionRow / {abort.raise} =
  match d.definitions.fold(None, |accumulator: Option<DefinitionRow>, r: DefinitionRow|
      if r.name == name { Some(r) } else { accumulator }) {
    Some(r) -> r,
    None -> panic("the analysis result lists no definition with that name"),
  }

test "the analysis output contains each type's constructors and each function's effects as the checker computed them" {
  let a = pulled_dump(returned(), shipped_modules);
  assert_eq(a.pulled, [b"std.b", prelude_module]);
  let same = definition_named(a.dump, b"base.same");
  assert_eq(same.effects, []);
  let write: Effect = {
    effect: b"base.log",
    resource: SingletonResource,
    mode: WriteMode,
    operation: None,
  };
  let say = definition_named(a.dump, b"base.say");
  assert_eq(say.effects, [write]);
  assert_eq(
    a.dump.constructors.filter(|k: ConstructorRow| k.name == b"base.Line").map(
      |k: ConstructorRow| k.fields,
    ),
    [[int_type]],
  )
}

test "a rejected program returns only diagnostics located at the error, and no definitions, types or modules" {
  let bad = [{ name: b"m", source_text: b"fn f() -> Int = \"x\"" }];
  let a = pulled_dump(bad, []);
  assert_eq(a.pulled, [prelude_module]);
  assert_eq(a.dump.diagnostics, [
    {
      code: b"E0201",
      labels: [
        {
          place: InSource({ module: 0, start: 16, end: 19 }),
          primary: true,
          text: b"expected `Int`, found `String`",
        },
      ],
      text: b"",
      message: b"type mismatch: function body type",
      notes_text: [],
      severity: Error,
      fixes: NoFix,
    },
  ]);
  assert_eq(a.dump.order, []);
  assert_eq(a.dump.modules, []);
  assert_eq(a.dump.definitions, []);
  assert_eq(a.dump.tests, []);
  assert_eq(a.dump.hashes, [])
}

test "function bodies read back from the stored analysis equal the bodies from checking the program again" {
  let a = analysis_of([
    {
      name: b"m",
      source_text: b"pub type P = { x: Int, y: Int }\n\npub fn moved(p: P) -> P\n  ensures result.x == p.x + 1\n= { ..p, x: p.x + 1 }\n",
    },
  ]);
  match facts_read(rows_of(a), inferred_facts(a), None, a.modules) {
    Err(reason) -> panic(String::of_bytes_lossy(reason)),
    Ok(f) -> {
      let recorded = bodies_read(f.bodies, f.types).filter(|b: TypedBody<Type>|
        b.owner == b"m.moved");
      assert(recorded.len() > 0, Some("the check recorded no body"));
      assert_eq(recorded, rechecked(a, [0]).filter(|b: TypedBody<Type>| b.owner == b"m.moved"))
    },
  }
}

fn analysis_of(sources: List<Source>) -> Analysis / {abort.raise} =
  match analysed_over(sources) {
    Rejected(_) -> panic("the program failed checking"),
    Analysed(w) -> w,
  }

test "database statement sites are the calls to a database effect operation or to a function that uses one, with their arguments as the checker computes them" {
  let w = analysis_of([
    {
      name: b"store",
      source_text: b"pub type Param = | PInt(Int) | PNull\npub type Stmt = { sql: String }\npub fn stmt(sql: String) -> Stmt = { sql: sql }\npub effect db { read query[t](s: Stmt, ps: List<Param>) -> Int }\npub fn run<[t]>(s: Stmt) -> Int / {db.query[t]} = db.query[t](s, [])\n",
    },
    {
      name: b"app",
      source_text: b"import store\nimport store (db)\nfn q() -> store::Stmt = store::stmt(\"select \" ++ \"sku from items\")\npub fn f(n: Int, p: store::Param) -> Int / {db.query[items]} = db.query[items](q(), [store::PInt(n), store::PNull, p])\npub fn g() -> Int / {db.query[items]} = store::run[items](store::stmt(\"select 1\"))\n",
    },
  ]);
  let statement_sites = |callees: List<Bytes>|
    range(0, w.modules.len()).fold([], |accumulator: List<StatementSite<Bytes>>, i: Int|
      accumulator.concat(sites_in(group_part(w), i, |c: Bytes| callees.contains(c))));
  let sites = statement_sites([b"store.db.query", b"store.run"]);
  assert_eq(sites.map(|s: StatementSite<Bytes>| (s.callee, s.label)), [
    (b"store.db.query", b"t"),
    (b"store.db.query", b"items"),
    (b"store.run", b"items"),
  ]);
  assert_eq(sites.map(|s: StatementSite<Bytes>| s.args), [
    [OtherArgument, ListArgument([])],
    [
      CallArgument({ callee: b"app.q", args: [] }),
      ListArgument([
        ConstructorArgument({ type_name: b"store.Param", name: b"PInt" }),
        ConstructorArgument({ type_name: b"store.Param", name: b"PNull" }),
        OtherArgument,
      ]),
    ],
    [CallArgument({ callee: b"store.stmt", args: [TextArgument(b"select 1")] })],
  ]);
  assert_eq(statement_sites([b"store.other"]).len(), 0)
}

test "database effect calls inside the module that declares the effect are not statement sites, but calls from modules that import it are" {
  let w = analysis_of([
    {
      name: b"std.db",
      source_text: b"pub type Stmt = { sql: String }\npub fn stmt(sql: String) -> Stmt = { sql: sql }\npub effect db { read query[t](s: Stmt) -> Int }\npub fn own() -> Int / {db.query[items]} = db.query[items](stmt(\"insert one\"))\n",
    },
    {
      name: b"std.user",
      source_text: b"import std.db as base\nimport std.db (db)\npub fn f() -> Int / {db.query[items]} = db.query[items](base::stmt(\"select 1\"))\n",
    },
  ]);
  assert_eq(statements_of(group_part(w), 0), []);
  assert_eq(statements_of(group_part(w), 1).map(|s: StatementSite<Bytes>| s.callee), [b"std.db.db.query"])
}

fn scheme_named(p: Published, name: Bytes) -> Scheme / {abort.raise} =
  match p.schemes.fold(None, |accumulator: Option<Scheme>, s: { name: Bytes, scheme: Scheme }|
      if s.name == name { Some(s.scheme) } else { accumulator }) {
    Some(scheme) -> scheme,
    None -> panic("the analysis checked the definition"),
  }

test "a generic function gets the same published definition whatever type variable numbers the checker used while checking earlier modules" {
  let pick = b"pub fn pick<p, q>(x: p, y: q, f: (p) -> q) -> List<q> = [f(x), y]";
  let alone = [{ name: b"m", source_text: pick }];
  let behind = [
    { name: b"a", source_text: b"pub fn first<c, d, e>(x: c, y: d, z: e) -> c = x" },
    { name: b"m", source_text: pick },
  ];
  let raw = |sources: List<Source>|
    analysis_of(sources).checked.definitions.fold(
      None,
      |accumulator: Option<Scheme>, definition_info: DefinitionInfo|
        if definition_info.name == b"m.pick" { Some(definition_info.scheme) } else { accumulator },
    );
  assert_eq(raw(alone), raw(behind));
  let one = published(analysed_over(alone));
  let two = published(analysed_over(behind));
  assert_eq(scheme_named(one, b"m.pick"), scheme_named(two, b"m.pick"));
  assert_eq(
    definition_named(one.dump, b"m.pick").effects,
    definition_named(two.dump, b"m.pick").effects,
  );
  assert_eq(scheme_named(one, b"m.pick").type_variables, [0, 1])
}

fn test_effects_of(outcome: AnalysisOutcome, key: Bytes) -> Bytes / {abort.raise} =
  match outcome {
    Rejected(_) -> b"<rejected>",
    Analysed(w) ->
      w.checked.tests.fold(b"", |accumulator: Bytes, test_info: TestInfo|
        if test_info.key == key { effect_list_text(test_info.effects, b",") } else { accumulator }),
  }

test "the effects of a test and of a `law` property do not include `abort.raise`, because running tests handles it" {
  let a = analysed_over([
    {
      name: b"m",
      source_text: b"pub effect log { write put(Bytes) -> Unit }\nfn half(n: Int, d: Int) -> Int / {abort.raise} = n / d\ntest \"halves\" { log.put(b\"x\"); assert_eq(half(4, 2), 2) }\nlaw \"whole\" forall (n: Int) { half(n, 1) == n }",
    },
  ]);
  assert_eq(test_effects_of(a, b"m.halves"), b"m.log.put");
  match a {
    Rejected(_) -> panic("the test program fails to check"),
    Analysed(w) -> assert_eq(w.checked.laws.map(|l: LawInfo| l.effects), [[]]),
  }
}

fn raises_recorded(
  outcome: AnalysisOutcome,
) -> List<{ name: Bytes, raises: Int, performed: Int }> / {abort.raise} =
  match outcome {
    Rejected(_) -> panic("the program failed checking"),
    Analysed(w) ->
      w.checked.definitions.map(|definition_info: DefinitionInfo|
        {
          name: definition_info.name,
          raises: definition_info.raises.len(),
          performed: definition_info.performed.len(),
        }),
  }

test "each function records the raises its body may make and the effects it performs" {
  assert_eq(
    raises_recorded(analysed_over(reading(b"pub fn aside() -> Int = 3\n"))).filter(
      |r: { name: Bytes, raises: Int, performed: Int }| module_of_name(r.name) == b"m",
    ),
    [
      { name: b"m.aside", raises: 0, performed: 0 },
      { name: b"m.at", raises: 1, performed: 1 },
      { name: b"m.walk", raises: 0, performed: 0 },
    ],
  )
}

test "every stored body is keyed by its definition's hash, including the functions of a mutually recursive group" {
  let w = analysis_of(declared());
  let bodies = stored_bodies(w.hashes);
  assert(bodies.len() > 0);
  assert(
    bodies.fold(true, |accumulator: Bool, b: StoredBody|
      accumulator && body_key(b.body) == Some(b.hash)),
  );
  assert_eq(bodies.len(), w.hashes.definitions.len() + w.hashes.declarations.len());
  match by_name(w.hashes.definitions).get(b"m.even") {
    Some(even) ->
      assert(bodies.fold(false, |accumulator: Bool, b: StoredBody| accumulator || b.hash == even)),
    None -> panic("the analysis has no hash for `m.even`"),
  }
}

fn rejected_codes(outcome: AnalysisOutcome) -> List<Bytes> =
  match outcome {
    Rejected(ds) -> ds.map(|diagnostic: Diagnostic| diagnostic.code),
    Analysed(_) -> [],
  }

test "a bundled module can embed another bundled module's text, and changing that text changes the hash" {
  let user = [{ name: b"m", source_text: b"import std.deep.a\npub fn f() -> Bytes = a::text()" }];
  let embedding = {
    name: b"std.deep.a",
    source_text: b"pub fn text() -> Bytes = embed(\"../note.ply\")",
  };
  let over = |note: Bytes| pulled_dump(user, [embedding, { name: b"std.note", source_text: note }]);
  let one = over(b"one");
  assert_eq(one.dump.diagnostics, []);
  assert_eq(one.pulled, [b"std.deep.a", prelude_module]);
  assert_eq(one.dump.embeds, [
    { module: b"std.deep.a", key: b"file:../note.ply", read: Ok([embed_file(b"", b"one")]) },
  ]);
  assert(one.dump.hashes_digest != over(b"two").dump.hashes_digest)
}

test "comparing, ordering or hashing a type that contains a bundled module's `extern type` is rejected" {
  let native = { name: b"std.native", source_text: b"pub extern type Node<a>\n" };
  let codes = |source_text: Bytes|
    pulled_dump([{ name: b"m", source_text: source_text }], [native]).dump.diagnostics.filter(
      |d: Diagnostic| d.severity == Error,
    ).map(|d: Diagnostic| d.code);
  let lookup_or_empty = |inner: Bytes, body: Bytes|
    codes(
      Bytes::concat_all([b"import std.native (Node)\ntype Held = | Held(", inner, b")\n", body]),
    );
  assert_eq(lookup_or_empty(b"Node<Int>", b"fn same(a: Held, b: Held) -> Bool = a == b\n"), [
    b"E0201",
  ]);
  assert_eq(
    lookup_or_empty(
      b"Node<Int>",
      b"fn order(a: Held, b: Held) -> Ordering = compare(a, b)\nfn hashed(a: Held) -> Bytes = digest(a)\n",
    ),
    [b"E0206", b"E0206"],
  );
  assert_eq(lookup_or_empty(b"Int", b"fn same(a: Held, b: Held) -> Bool = a == b\n"), [])
}

test "a bundled module that embeds a file missing from the bundled modules is rejected" {
  let a = pulled_dump(
    [{ name: b"m", source_text: b"import std.a\npub fn f() -> Bytes = a::text()" }],
    [{ name: b"std.a", source_text: b"pub fn text() -> Bytes = embed(\"gone.ply\")" }],
  );
  assert_eq(a.dump.diagnostics.map(|d: Diagnostic| d.code), [b"E0146"])
}

fn over_words(user: Bytes, data: List<ShippedData>) -> AnalysisOutcome / {abort.raise} =
  analysed_over(
    [{ name: b"m", source_text: user }],
    [words_module(b"words/list.txt")].concat(data_sources(data)),
  )

fn pulled_hash(p: AnalysisOutcome, name: Bytes) -> Option<Bytes> =
  pulled_hashes(p).fold(None, |accumulator: Option<Bytes>, d: { name: Bytes, hash: Bytes }|
    if d.name == name { Some(d.hash) } else { accumulator })

test "changing the bytes of a data file a shipped module embeds changes the hashes of the definitions that use it, and no others" {
  let user = b"import std.words\npub fn n() -> Int = words::count()\npub fn still() -> Int = words::idle()\n";
  let one = over_words(user, words_data(b"one\n"));
  let two = over_words(user, words_data(b"one\ntwo\n"));
  assert_eq(rejected_codes(one), []);
  [b"std.words.list", b"std.words.count", b"m.n"].fold((), |u: Unit, name: Bytes| {
    assert(pulled_hash(one, name) != None, Some(String::of_bytes(name)));
    assert(pulled_hash(one, name) != pulled_hash(two, name), Some(String::of_bytes(name)))
  });
  [b"std.words.idle", b"m.still"].fold((), |u: Unit, name: Bytes|
    assert_eq(pulled_hash(one, name), pulled_hash(two, name)));
  assert_eq(dump_of(one).embeds, [
    { module: b"std.words", key: b"file:words/list.txt", read: Ok([embed_file(b"", b"one\n")]) },
  ])
}

test "changing a data file leaves the hashes unchanged for a program that uses no definition depending on that file" {
  let user = b"import std.words\npub fn still() -> Int = words::idle()\n";
  let one = over_words(user, words_data(b"one\n"));
  let two = over_words(user, words_data(b"one\ntwo\n"));
  assert_eq(definition_names(one), [b"m.still", b"std.words.idle"]);
  assert_eq(pulled_hashes(one), pulled_hashes(two));
  assert_eq(dump_of(one).hashes_digest, dump_of(two).hashes_digest)
}

test "embedding a data file missing from the shipped modules, or a path outside them, is rejected with an error in the embedding module" {
  let source_text = b"import std.words\npub fn n() -> Int = words::count()\n";
  let user = [{ name: b"m", source_text: source_text }];
  let placed_at = |p: AnalysisOutcome|
    match p {
      Analysed(_) -> [],
      Rejected(ds) ->
        ds.map(|d: Diagnostic|
          { code: d.code, modules: d.labels.map(|l: Label| place_module(l.place)) }),
    };
  assert_eq(placed_at(over_words(source_text, [])), [{ code: b"E0146", modules: [Some(2)] }]);
  let leaving = analysed_over(
    user,
    [words_module(b"../list.txt")].concat(
      data_sources([{ name: b"list.txt", bytes: b"x" }, { name: b"std/list.txt", bytes: b"x" }]),
    ),
  );
  assert_eq(placed_at(leaving), [{ code: b"E0146", modules: [Some(2)] }]);
  let directory = analysed_over(
    user,
    [
      { name: b"std.words", source_text: b"pub fn count() -> Int = embed_dir(\"words\").len()\n" },
    ].concat(
      data_sources(words_data(b"one\n")),
    ),
  );
  assert_eq(placed_at(directory), [{ code: b"E0146", modules: [Some(2)] }])
}

test "a module's tables and rows read back as a cached result stored them" {
  match analysed_over(program()) {
    Rejected(_) -> panic("the fixture program was rejected by the checker"),
    Analysed(w) -> {
      let t = module_facts(group_part(w), 0).tables;
      assert_eq(decode_tables(encode_tables(t)), t);
      let r = rows_of(w);
      assert_eq(decode_rows(encode_rows(r)), r)
    },
  }
}

fn size_over(home: Bytes, declared: Bytes) -> Bytes / {abort.raise} = {
  let source = Bytes::concat_all([
    b"import ",
    home,
    b"\npub fn size(s: ",
    home,
    b"::Shape) -> Int / {",
    home,
    b"::log.write} = { ",
    home,
    b"::log.put(1); 1 }\n",
  ]);
  match analysed_over([
      { name: b"m", source_text: source },
      { name: home, source_text: declared },
    ]) {
    Rejected(_) -> panic("the test program fails to check"),
    Analysed(w) -> match interfaces_of(w.checked, w.hashes).find(|d: PublishedInterface|
        d.name == b"m.size") {
      Some(d) -> d.interface,
      None -> panic("the checked program does not export a definition named `m.size`"),
    },
  }
}

test "an interface identifies each type and effect by the hash of its declaration, not by its name" {
  let declared = |shape: Bytes, operations: Bytes|
    Bytes::concat_all([b"pub type Shape = ", shape, b"\npub effect log {\n", operations, b"}\n"]);
  let put = b"  write put(n: Int) -> Unit\n";
  let first = size_over(b"shapes", declared(b"| Dot | Line(Int)", put));
  assert_eq(size_over(b"forms", declared(b"| Dot | Line(Int)", put)), first);
  assert(size_over(b"shapes", declared(b"| Dot | Circle(Float)", put)) != first, None);
  assert(
    size_over(
        b"shapes",
        declared(b"| Dot | Line(Int)", Bytes::concat_all([put, b"  write flush() -> Unit\n"])),
      )
      != first,
    None,
  )
}

test "an interface distinguishes a type from an effect that has the same name" {
  let opened = |boxed: Bytes|
    match analysed_over([
        {
          name: b"m",
          source_text: Bytes::concat_all([
            b"pub type Box = ",
            boxed,
            b"\neffect Box { read held() -> Int }\npub fn open(b: Box) -> Int / {Box.read} = Box.held()\n",
          ]),
        },
      ]) {
      Rejected(_) -> panic("the test program fails to check"),
      Analysed(w) -> match interfaces_of(w.checked, w.hashes).find(|d: PublishedInterface|
          d.name == b"m.open") {
        Some(d) -> d.interface,
        None -> panic("the checked program does not export a definition named `m.size`"),
      },
    };
  assert(opened(b"| Box(Int)") != opened(b"| Box(Int, Int)"), None)
}

test "an interface differs when a function parameter or type variable is marked `keep` and when it is not" {
  let recorded = |source: Bytes|
    match analysed_over([{ name: b"m", source_text: source }]) {
      Rejected(_) -> panic("the test program fails to check"),
      Analysed(w) -> match interfaces_of(w.checked, w.hashes).find(|d: PublishedInterface|
          d.name == b"m.f") {
        Some(d) -> d.interface,
        None -> panic("the checked program does not export a definition named `m.size`"),
      },
    };
  assert(
    recorded(b"pub fn f(g: keep (Int) -> Int) -> Int = g(1)\n")
      != recorded(b"pub fn f(g: (Int) -> Int) -> Int = g(1)\n"),
    None,
  );
  assert(
    recorded(b"pub fn f<keep a>(x: keep a) -> a = x\n")
      != recorded(b"pub fn f<a>(x: a) -> a = x\n"),
    None,
  )
}

test "the types used in a function body are recorded as keys into one shared table of types, and read back from that table" {
  let source = b"fn first<a>(xs: List<a>, d: a) -> a = match xs { [x, ..] -> x, _ -> d }\nfn go(ys: List<Int>) -> Int = first(ys, 0)\n";
  match analysed_over([{ name: b"m", source_text: source }]) {
    Rejected(_) -> panic("the test program fails to check"),
    Analysed(w) -> {
      let rows = rows_of(w);
      let sites = |name: Bytes|
        match rows.definitions.find(|r: KnownDefinitionRow| r.name == name) {
          Some(r) -> match r.facts {
            RecordedHere(f) -> decode_facts(f, 0, b""),
            CheckedElsewhere -> no_body_facts,
          },
          None -> no_body_facts,
        };
      assert_eq(sites(b"m.go").types.len(), 0);
      let bodies = |name: Bytes| bodies_read(sites(name).bodies, rows.types);
      assert_eq(
        bodies(b"m.go").flat_map(|b: TypedBody<Type>| typed_expression_nodes(b.body)).fold(
          [],
          |accumulator: List<List<Type>>, e: TypedExpression<Type>|
            match e.node {
              TypedRead(ReadDefinition(d)) -> accumulator.push(d.args),
              _ -> accumulator,
            },
        ),
        [[int_type]],
      );
      assert_eq(
        bodies(b"m.first").flat_map(|b: TypedBody<Type>| b.params).filter(
          |p: TypedParam<Type>| p.name == b"d",
        ).map(|p: TypedParam<Type>| p.ty),
        [VariableType(0)],
      )
    },
  }
}

test "each test is identified by its module and label, and tests are listed in the program's test order" {
  let d = dump_of(
    analysed_over([
      {
        name: b"a",
        source_text: b"fn one() -> Int = 1\ntest \"first\" { assert_eq(one(), 1) }\ntest \"second\" { assert_eq(one(), 1) }",
      },
      {
        name: b"b",
        source_text: b"fn test_like(x: Int) -> Int requires x > 0 = x\ntest \"third\" { assert_eq(test_like(2), 2) }",
      },
    ]),
  );
  let tested = d.tests.map(|t: TestRow| test_owner(t.module, t.name));
  assert_eq(
    d.emitter_roots.map(|r: EmitterRoot| printed(r.key)).filter(|r: Bytes| tested.contains(r)),
    [test_owner(b"a", b"first"), test_owner(b"a", b"second"), test_owner(b"b", b"third")],
  );
  assert_eq(range(0, 4).map(|i: Int| test_root_at(d, i)), [
    Some(test_key(b"a", b"first")),
    Some(test_key(b"a", b"second")),
    Some(test_key(b"b", b"third")),
    None,
  ]);
  assert_eq(d.tests.map(|t: TestRow| Bytes::concat_all([t.module, b".", t.name])), [
    b"a.first",
    b"a.second",
    b"b.third",
  ])
}

test "a test's key depends on the effect operations its code uses, and not on the order an effect set lists them in" {
  let key = |set: Bytes| {
    let source = Bytes::concat_all([
      b"effect store {\n  read all[r]() -> List<Int>\n  write save[r](rows: List<Int>) -> Unit\n}\n",
      set,
      b"\nfn listed() -> Int / {Web} = store.all[orders]().len()\n",
      b"test \"listed\" { handle { assert_eq(listed(), 0) } with { store.all[orders]() -> [] } }\n",
    ]);
    match analysed_over([{ name: b"m", source_text: source }]) {
      Rejected(_) -> panic("the test program fails to check"),
      Analysed(w) ->
        dump_of(Analysed(w)).keys.filter(|k: KeyRow| k.root == test_owner(b"m", b"listed")).map(
          |k: KeyRow| k.key,
        ),
    }
  };
  let narrow = key(b"effect set Web = {store.read[orders], store.write[audit]}");
  assert_eq(narrow.len(), 1);
  assert_eq(key(b"effect set Web = {store.write[audit], store.read[orders]}"), narrow);
  assert(
    key(b"effect set Web = {store.read[orders], store.write[audit], store.read[inventory]}")
      != narrow,
    Some("a widened set left the key of a test that reaches it"),
  )
}

test "prelude function bodies can call extern functions and functions on a type, by method syntax or by qualified name" {
  let source = Bytes::concat_all([
    b"extern fn List::at<a>(xs: List<a>, i: Int) -> Option<a>\n",
    b"extern fn List::len<a>(xs: List<a>) -> Int\n",
    b"fn walked<a>(xs: List<a>, i: Int) -> Int = match xs.at(i) { Some(_) -> walked(xs, i + 1), None -> i }\n",
    b"pub fn List::count<a>(xs: List<a>) -> Int = walked(xs, 0) + xs.len() + List::len(xs)\n",
    b"pub fn List::twice<a>(xs: List<a>) -> Int = xs.count() + List::count(xs)\n",
  ]);
  match analysed_over([{ name: prelude_module, source_text: source }]) {
    Rejected(ds) ->
      panic(String::of_bytes_lossy(Bytes::join(ds.map(|d: Diagnostic| d.message), b"; "))),
    Analysed(w) ->
      assert_eq(
        w.checked.definitions.map(|d: DefinitionInfo| d.name).filter(|n: Bytes|
          n.index_of(b"::") != None),
        [b"std.prelude.List::count", b"std.prelude.List::twice"],
      ),
  }
}

test "a function that `std.prelude` defines in Ply is checked against the type signature that its callers see" {
  let source = Bytes::concat_all([
    b"pub fn g(xs: List<Int>) -> Int = xs.map(|x: Int| x + 1).filter(|x: Int| x > 2).fold(0, |a: Int, x: Int| a + x)\n",
    b"pub fn k(xs: List<Int>) -> Option<Int> / {abort.raise} = xs.set(0, 1).push(2).at(0)\n",
    b"pub fn l(a: Array<Int>, c: Columns<{ x: Int }>) -> Int = a.to_list().len() + c.to_list().len()\n",
    b"fn e(o: Option<{ key: Int, value: Int }>) -> Int = match o { Some(x) -> x.key, None -> 0 }\n",
    b"fn p(o: Option<{ key: Int, value: Int, rest: Map<Int, Int> }>) -> Int = match o { Some(x) -> x.rest.len(), None -> 0 }\n",
    b"fn some<a>(o: Option<a>) -> Int = match o { Some(_) -> 1, None -> 0 }\n",
    b"pub fn t(n: Int, u: U128, i: I128, s: String, f: Float) -> Int = n.to_string().len() + u.to_string().len() + i.to_string().len() + f.to_string().len() + s.trim().len() + (if Bytes::of_string(s).is_utf8() { 1 } else { 0 }) + some(U128::of_string(s)) + some(I128::of_string(s)) + some(Float::of_string(s))\n",
    b"pub fn u(b: Bytes) -> Int / {abort.raise} = String::of_bytes(b).len() + String::of_bytes_lossy(b).len()\n",
    b"pub fn d(a: Decimal, b: Decimal, f: Float, s: String) -> Int / {abort.raise} = a.div(b, 2, HalfEven).round(1, Down).to_string().len() + some(Decimal::of_string(s)) + some(Decimal::of_float(f)) + some(Int::of_decimal(a, Up)) + some(Int::of_float(f.round(Floor), Ceiling)) + (if Float::of_decimal(a) > 0.0 { 1 } else { 0 })\n",
    b"pub fn n(m: Map<Int, Int>) -> Int = m.remove(1).insert(2, 3).update(2, |v: Int| v + 1).fold(0, |s: Int, k: Int, v: Int| s + k + v) + m.keys().len() + m.values().len() + m.entries().len() + Map::of_entries(m.entries()).merge(m).len() + e(m.first()) + e(m.last()) + e(m.floor(1)) + e(m.ceiling(1)) + e(m.below(1)) + e(m.above(1)) + p(m.pop_first()) + p(m.pop_last()) + m.range(None, true, None, true, 3).len() + (if m.contains(1) { 1 } else { 0 }) + m.split(1).below.len() + match m.get(1) { Some(v) -> v, None -> 0 }\n",
  ]);
  match analysed_over([{ name: b"m", source_text: source }]) {
    Rejected(_) -> panic("the test program fails to check"),
    Analysed(w) -> {
      let checked = w.checked.definitions.fold(
        Map::new(),
        |accumulator: Map<Bytes, Scheme>, d: DefinitionInfo| accumulator.insert(d.name, d.scheme),
      );
      let bodied = builtins.filter(|b: Builtin| b.body);
      assert(bodied.len() > 0, None);
      bodied.fold((), |u: Unit, b: Builtin|
        assert_eq(checked.get(qualify(prelude_module, b.name)), Some(b.scheme)));
      assert_eq(
        w.checked.definitions.filter(|d: DefinitionInfo|
          module_of_name(d.name) == prelude_module && d.ending != Terminates
            && d.ending != TerminatesByDecreases).map(|d: DefinitionInfo| d.name),
        [],
      )
    },
  }
}

test "printing a definition's source text writes the parameter name on a method-call argument, as in `c.scaled(plus: 3)`" {
  let source = b"pub type Bag = | Bag(Int)\npub fn Bag::size(b: Bag) -> Int = match b { Bag(n) -> n + 1 }\npub type Cart = | Cart(Int)\npub fn Cart::size(c: Cart) -> Int = match c { Cart(n) -> n }\npub fn Cart::scaled(c: Cart, by: Int = 2, plus: Int = 0) -> Int = c.size() * by + plus\npub fn total(c: Cart) -> Int = c.size()\npub fn more(c: Cart) -> Int = c.scaled(plus: 3)\n";
  match analysed_over([{ name: b"m", source_text: source }]) {
    Rejected(_) -> panic("the fixture program was rejected by the checker"),
    Analysed(w) -> {
      let more = match print_bodies(
          w.hashes.bodies.map(|b: { name: Bytes, body: FramedBody }|
            {
              name: b.name,
              body: b.body,
              role: if module_of_name(b.name) == prelude_module { FromShippedModule }
              else { WrittenWith(Public) },
            }),
          [],
        ) {
        Printed(ms) ->
          ms.get(0).text.split(b"\n\n").fold(b"", |accumulator: Bytes, it: Bytes|
            if it.contains(b"fn more(") { it } else { accumulator }),
        Unprintable(reason) -> panic(String::of_bytes(reason.message)),
      };
      assert(more.contains(b".scaled(_l2: 3)"), Some(String::of_bytes_lossy(more)))
    },
  }
}
