import std.bin
import std.hash (blake3)
import std.list
import compiler.check.resolve.tables (Source, ParsedModule, Diagnostic)
import compiler.front.diagnostics (parse_all)
import compiler.front.pkg (PackageSources)
import compiler.store.hash (Contract, public_contracts)
import compiler.front.facts (Analysis, cuts_of)
import compiler.front.emitter_input (AnalysisOutcome, Analysed, Rejected)
import compiler.front.published (analyse, analyse_with)
import compiler.front.rows (Cut)
import compiler.front.exports (Exports, Hashes, exports_of, hashes_of, exports_bin, hashes_bin)
import compiler.expand.embed (EmbedResult, EmbedFile)
import compiler.syntax.items (unneeded_spans)
import compiler.syntax.parsing (Span)

pub type ModuleInterface = { exports: Exports, hashes: Hashes }

pub type Interface = { modules: List<ModuleInterface> }

derive bin for ModuleInterface

derive bin for Interface

pub type Envelope = { semantics: Bytes, archive: Bytes, payload: Bytes }

derive bin for Envelope

fn envelope_magic() -> Bytes = b"PLYIFC01"

pub fn enveloped(envelope: Envelope) -> Bytes / {abort.raise} =
  envelope_magic().concat(bin::encode(envelope, envelope_bin()))

pub fn envelope_of(b: Bytes) -> Option<Envelope> / {abort.raise} =
  if !b.starts_with(envelope_magic()) { None } else {
    match bin::decode(b.slice(envelope_magic().len(), b.len()), envelope_bin()) {
      Ok(e) -> Some(e),
      Err(_) -> None,
    }
  }

fn spaces(n: Int) -> Bytes =
  if n <= 0 { b"" } else {
    let half = spaces(n / 2);
    let twice = half.concat(half);
    if n % 2 == 1 { twice.concat(b" ") } else { twice }
  }

fn blank(text: Bytes) -> Bytes / {abort.raise} = {
  let segs = text.split(b"\n");
  Bytes::concat_all(
    range(0, segs.len()).fold([], |parts: List<Bytes>, i: Int|
      if i == 0 { parts.push(spaces(segs.get(0).len())) }
      else { parts.push(b"\n").push(spaces(segs.get(i).len())) }),
  )
}

fn cut(source: Bytes, c: Cut) -> List<Bytes> / {abort.raise} =
  if c.braced { [b"{", blank(source.slice(c.start + 1, c.end - 1)), b"}"] }
  else { [blank(source.slice(c.start, c.end))] }

pub fn stub_module(source: Bytes, parsed: ParsedModule) -> Bytes / {abort.raise} =
  blank_cuts(source, cuts_of(parsed))

pub fn imported(source: Bytes) -> Bytes / {abort.raise} = blanked(source, unneeded_spans(source))

pub fn blanked(source: Bytes, spans: List<Span>) -> Bytes / {abort.raise} =
  blank_cuts(
    source,
    spans.map(|s: Span| { start: s.start, end: s.end, braced: false, name: b"", test: false }),
  )

pub fn blank_cuts(source: Bytes, cuts: List<Cut>) -> Bytes / {abort.raise} = {
  let walked = cuts.fold(
    { at: 0, parts: [] },
    |accumulator: { at: Int, parts: List<Bytes> }, c: Cut|
      if c.start < accumulator.at { accumulator } else {
        {
          at: c.end,
          parts: accumulator.parts.push(source.slice(accumulator.at, c.start)).concat(
            cut(source, c),
          ),
        }
      },
  );
  Bytes::concat_all(walked.parts.push(source.slice(walked.at, source.len())))
}

pub fn length_prefixed(b: Bytes) -> Bytes =
  Bytes::concat_all([Bytes::of_string(b.len().to_string()), b":", b])

pub fn embed_read_digest(read: EmbedResult) -> Bytes =
  blake3(
    Bytes::concat_all(match read {
      Err(reason) -> [b"ply.interface.embed.2\0!", reason],
      Ok(files) ->
        files.fold([b"ply.interface.embed.2\0="], |accumulator: List<Bytes>, f: EmbedFile|
          accumulator.push(length_prefixed(f.name)).push(length_prefixed(f.digest))),
    }),
  )

pub fn interface_of(
  analysis: Analysis,
  sources: List<Source>,
  modules: List<Bytes>,
) -> Interface / {abort.raise} = {
  let texts = sources.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, s: Source|
    accumulator.insert(s.name, s.source_text));
  let index = range(0, analysis.modules.len()).fold(
    Map::new(),
    |accumulator: Map<Bytes, Int>, i: Int| accumulator.insert(analysis.modules.get(i).name, i),
  );
  {
    modules: modules.map(|name: Bytes|
      match ((texts.get(name), index.get(name))) {
        (Some(text), Some(i)) ->
          {
            exports: exports_of(analysis, i, text),
            hashes: hashes_of(analysis.index, analysis.hashes, i, text),
          },
        _ -> panic("a module in the interface was not analysed or has no source text"),
      }),
  }
}

fn accepted_analysis(analysis: AnalysisOutcome) -> Analysis / {abort.raise} =
  match analysis { Analysed(w) -> w, Rejected(ds) -> panic("analysis rejected") }

fn depends() -> Source =
  {
    name: b"base",
    source_text: b"pub effect log { write emit(Bytes) -> Unit }\npub effect chan { write put[r](Int) -> Unit }\npub type Pair = { a: Int, b: Int }\nfn helper(x: Int) -> Int = x * 2\npub fn one() -> Int = 1\npub fn two(x: Int) -> Int requires x >= 0 ensures result > x = helper(x) + one()\npub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\npub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\npub fn mk(x: Int) -> Pair = {\n  { a: x, b: two(x) }\n}\npub fn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\npub fn twice<|e>(f: () -> Unit / e) -> Unit / e = { f(); f() }\npub fn send<[l]>(x: Int) -> Unit / { chan.write[l] } = chan.put[l](x)\ntest \"two adds\" { assert_eq(two(1), 3) }\nlaw \"doubling\" forall (x: Int) { helper(x) == x + x }\n",
  }

test "a stub has the same length and line count as its source" {
  let base = { ..depends(), source_text: depends().source_text.concat(b"derive bin for Pair\n") };
  let m = parse_all([base]).get(0).module;
  let stub = stub_module(base.source_text, m);
  assert_eq(stub.len(), base.source_text.len());
  assert_eq(stub.split(b"\n").len(), base.source_text.split(b"\n").len());
  assert(
    stub.index_of(b"pub fn two(x: Int) -> Int requires x >= 0 ensures result > x = {") != None,
  );
  assert(stub.index_of(b"pub fn mk(x: Int) -> Pair = {\n") != None);
  assert(stub.index_of(b"{ a: x") == None);
  assert(stub.index_of(b"= { f(); f() }") == None);
  assert(stub.index_of(b"= chan.put[l](x)") != None);
  assert(stub.index_of(b"derive bin for Pair") != None);
  assert(stub.index_of(b"helper(x) + one()") == None);
  assert(stub.index_of(b"test") == None);
  assert(stub.index_of(b"law") == None)
}

test "an interface round-trips through its binary encoding" {
  let base = depends();
  let iface = interface_of(accepted_analysis(analyse(parse_all([base]))), [base], [b"base"]);
  assert_eq(iface.modules.len(), 1);
  match bin::decode(bin::encode(iface, interface_bin()), interface_bin()) {
    Ok(back) -> assert_eq(back, iface),
    Err(e) -> panic("an interface did not decode"),
  }
}

test "an envelope round-trips its metadata and payload, and no other bytes are read as an envelope" {
  let e: Envelope = { semantics: b"s1", archive: b"b3:ab", payload: b"\x00\x01payload" };
  assert_eq(envelope_of(enveloped(e)), Some(e));
  assert_eq(envelope_of(b"PLYIFC01"), None);
  assert_eq(envelope_of(enveloped(e).slice(1, enveloped(e).len())), None)
}

test "a `transparent` function's body is part of its contract, and its stub retains the body" {
  let lib = |two_body: Bytes|
    Bytes::concat_all([
      b"pub fn one() -> Int = 0 + 1\npub transparent fn two(x: Int) -> Int = ",
      two_body,
      b"\n",
    ]);
  let before = contracts_of(lib(b"x + one()"));
  assert(
    contract_named(contracts_of(lib(b"x + one() + 0")), b"lib.two")
      != contract_named(before, b"lib.two"),
    Some("the body is read"),
  );
  assert_eq(
    contract_named(contracts_of(lib(b"x + one()").concat(b"fn aside() -> Int = 2\n")), b"lib.two"),
    contract_named(before, b"lib.two"),
  );
  let source = lib(b"x + one()");
  let stub = stub_module(
    source,
    parse_all([{ name: b"base.lib", source_text: source }]).get(0).module,
  );
  assert(stub.index_of(b"= x + one()") != None, Some(String::of_bytes(stub)));
  assert(stub.index_of(b"0 + 1") == None, Some(String::of_bytes(stub)))
}

test "a `returns` clause is part of a definition's contract" {
  let lib = |clause: Bytes|
    Bytes::concat_all([b"pub fn made(n: Int) -> List<Int>", clause, b" = range(0, n)\n"]);
  assert(
    contract_named(contracts_of(lib(b" returns fresh")), b"lib.made")
      != contract_named(contracts_of(lib(b"")), b"lib.made"),
  )
}

fn contracts_of(source: Bytes) -> List<Contract> / {abort.raise} = {
  let w = accepted_analysis(analyse(parse_all([{ name: b"lib", source_text: source }])));
  public_contracts(w.index, w.hashes, |m: Bytes| m == b"lib")
}

fn contract_named(cs: List<Contract>, name: Bytes) -> Bytes / {abort.raise} =
  match cs.filter(|contract: Contract| contract.name == name) {
    [contract] -> contract.hash,
    _ -> panic("expected exactly one contract with this name"),
  }

test "a public definition's contract moves with its signature and specification, never its body" {
  let lib = |body: Bytes, spec: Bytes, variants: Bytes|
    Bytes::concat_all([
      b"pub type T = ",
      variants,
      b"\npub fn f(x: Int) -> Int",
      spec,
      b" = ",
      body,
      b"\nfn hidden() -> Int = 1\n",
    ]);
  let base = contracts_of(lib(b"x + 1", b"", b"| A | B"));
  assert_eq(base.map(|contract: Contract| contract.name), [b"lib.T", b"lib.f"]);
  assert_eq(contracts_of(lib(b"x + 2", b"", b"| A | B")), base);
  let specified = contracts_of(lib(b"x + 1", b" ensures result > x", b"| A | B"));
  assert(contract_named(specified, b"lib.f") != contract_named(base, b"lib.f"));
  assert_eq(contract_named(specified, b"lib.T"), contract_named(base, b"lib.T"));
  let widened = contracts_of(lib(b"x + 1", b"", b"| A | B | C"));
  assert(contract_named(widened, b"lib.T") != contract_named(base, b"lib.T"))
}
