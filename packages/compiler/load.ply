pub type SourceFile = { path: String, name: String, text: Bytes }

pub type LoadedAnalysis = {
  dump: Dump,
  files: List<SourceFile>,
  inputs: Map<Bytes, Bytes>,
  read_ms: Int,
  front_end_ms: Int,
  store_ms: Int,
  cached: Bool,
}

pub type LoadedProgram = { front: LoadedAnalysis, parts: List<cc::WrittenPart> }

pub type CheckedProgram = { front: LoadedAnalysis, hashes: HashOutput }

pub type LoadFailure = { diagnostics: List<Diagnostic>, files: List<SourceFile> }

fn load_failure(diagnostics: List<Diagnostic>) -> LoadFailure =
  { diagnostics: diagnostics, files: [] }

pub fn is_skipped(name: String) -> Bool = name.starts_with(".") || name == "target"

fn joined(dir: String, name: String) -> String =
  if dir == "" || dir == "." { name } else if name == "" { dir } else { dir ++ "/" ++ name }

fn load_error(message: String) -> Diagnostic =
  error_unplaced(b"E0502", Bytes::of_string(message), b"nothing to load", [])

const max_directory_depth: Int = 2048

pub fn is_ply(name: String) -> Bool = extension(name) == Some("ply")

pub type Modules = { files: List<String>, unread: List<String> }

pub fn modules_below<[r]>(dir: String, own: Bool) -> Modules / {fs.list_dir[r]} =
  modules_in[r](dir, "", fs.list_dir[r](dir), { files: [], unread: [] }, max_directory_depth, own)

fn modules_in<[r]>(
  dir: String,
  under: String,
  listing: Option<List<Listed>>,
  found: Modules,
  depth_left: Int,
  own: Bool,
) -> Modules / {fs.list_dir[r]} =
  match listing {
    None -> { ..found, unread: found.unread.push(under) },
    Some(files_below) ->
      files_below.fold(found, |accumulator: Modules, l: Listed| {
        let path = joined(under, l.name);
        match l.kind {
          File -> if is_ply(l.name) { { ..accumulator, files: accumulator.files.push(path) } }
          else { accumulator },
          Dir -> if is_skipped(l.name) || depth_left <= 0 { accumulator } else {
            let inner = fs.list_dir[r](joined(dir, path));
            if own && contains_package(inner) { accumulator }
            else { modules_in[r](dir, path, inner, accumulator, depth_left - 1, own) }
          },
          Symlink -> accumulator,
          Missing -> if is_ply(l.name) { { ..accumulator, unread: accumulator.unread.push(path) } }
          else { accumulator },
        }
      }),
  }

fn contains_package(listing: Option<List<Listed>>) -> Bool =
  match listing {
    Some(files_below) -> files_below.any(|l: Listed| l.name == "ply.pkg"),
    None -> false,
  }

pub type Package = { root: String, manifest: Option<Bytes>, files: List<SourceFile> }

fn package_at<[r]>(
  root: String,
) -> Result<Package, List<Diagnostic>> / {fs.list_dir[r], fs.read_file[r], abort.raise} = {
  let read = modules_below[r](root, true).files.sort().fold(
    Ok([]),
    |accumulator: Result<List<SourceFile>, List<Diagnostic>>, p: String|
      match accumulator {
        Err(e) -> Err(e),
        Ok(done) -> match module_of(p) {
          Err(reason) ->
            Err([load_error("`" ++ joined(root, p) ++ "` cannot be a module: " ++ reason)]),
          Ok(name) -> match fs.read_file[r](joined(root, p)) {
            None -> Err([load_error("could not read `" ++ joined(root, p) ++ "`")]),
            Some(text) -> Ok(done.push({ path: joined(root, p), name: name, text: text })),
          },
        },
      },
  );
  match read {
    Err(diagnostics) -> Err(diagnostics),
    Ok(files) ->
      Ok({ root: root, manifest: fs.read_file[r](joined(root, "ply.pkg")), files: files }),
  }
}

fn sources_of(files: List<SourceFile>) -> List<Source> =
  files.map(|f: SourceFile| { name: Bytes::of_string(f.name), source_text: f.text })

fn supplied_of(package: Package) -> SuppliedPackage =
  {
    root: Bytes::of_string(package.root),
    manifest: package.manifest,
    modules: sources_of(package.files),
  }

fn git_dependency_error(key: Bytes) -> Diagnostic =
  load_error(
    "`" ++ String::of_bytes_lossy(key)
      ++ "` is a git dependency, which `ply` fetches; a program's own load reads path dependencies",
  )

fn packages_of<[r]>(
  root: Package,
) -> Result<List<Package>, List<Diagnostic>> / {fs.list_dir[r], fs.read_file[r], abort.raise} = {
  let program_root = Bytes::of_string(root.root);
  let read = traverse([program_root], |key: Bytes| {
    let package = if key == program_root { Ok(root) } else { dependency_at[r](key) };
    {
      value: package,
      next: match package {
        Ok(p) -> dependency_roots(program_root, supplied_of(p)),
        Err(_) -> [],
      },
    }
  });
  read.drop(1).fold(
    Ok([]),
    |accumulator: Result<List<Package>, List<Diagnostic>>, v: Visit<Bytes, Result<Package, List<Diagnostic>>>|
      match accumulator {
        Ok(packages) -> match v.value { Ok(p) -> Ok(packages.push(p)), Err(e) -> Err(e) },
        Err(errors) -> match v.value { Ok(_) -> accumulator, Err(e) -> Err(errors.concat(e)) },
      },
  )
}

fn dependency_at<[r]>(
  key: Bytes,
) -> Result<Package, List<Diagnostic>> / {fs.list_dir[r], fs.read_file[r], abort.raise} =
  match git_spec(key) {
    Some(_) -> Err([git_dependency_error(key)]),
    None -> package_at[r](String::of_bytes(key)),
  }

fn embed_target(file: String, path: String) -> String = normalize(join(parent(file), path))

fn read_error(target: String, what: String) -> EmbedBytesResult =
  Err(Bytes::of_string("`" ++ target ++ "` " ++ what))

pub type EmbeddedFilesError = { path: String, reason: String }

pub fn embedded_below<[r]>(
  dir: String,
) -> Result<Map<String, String>, EmbeddedFilesError> / {fs.list_dir[r]} =
  embedded_in[r](dir, "", Map::new(), max_directory_depth)

fn embedded_in<[r]>(
  dir: String,
  under: String,
  found: Map<String, String>,
  depth_left: Int,
) -> Result<Map<String, String>, EmbeddedFilesError> / {fs.list_dir[r]} =
  match fs.list_dir[r](joined(dir, under)) {
    None -> Err({ path: joined(dir, under), reason: "could not be listed" }),
    Some(entries) ->
      entries.fold(
        Ok(found),
        |accumulator: Result<Map<String, String>, EmbeddedFilesError>, l: Listed|
          match accumulator {
            Err(_) -> accumulator,
            Ok(m) -> if l.name.starts_with(".") { accumulator } else {
              let path = joined(under, l.name);
              match l.kind {
                Dir -> if depth_left <= 0 {
                  Err({
                    path: joined(dir, path),
                    reason: "is nested in too many directories to embed",
                  })
                } else { embedded_in[r](dir, path, m, depth_left - 1) },
                _ -> Ok(m.insert(path, joined(dir, path))),
              }
            },
          },
      ),
  }

fn read_dir<[r]>(dir: String) -> EmbedBytesResult / {fs.list_dir[r], fs.read_file[r]} =
  match embedded_below[r](dir) {
    Err(stopped) -> read_error(stopped.path, stopped.reason),
    Ok(found) ->
      found.fold(Ok([]), |accumulator: EmbedBytesResult, name: String, path: String|
        match accumulator {
          Err(_) -> accumulator,
          Ok(files) -> match fs.read_file[r](path) {
            Some(b) -> Ok(files.push({ name: Bytes::of_string(name), bytes: b })),
            None -> read_error(path, "could not be read"),
          },
        }),
  }

fn read_embed<[r]>(
  file: String,
  path: String,
  dir: Bool,
) -> EmbedBytesResult / {fs.list_dir[r], fs.kind[r], fs.read_file[r]} =
  if is_absolute(path) {
    read_error(path, "is absolute, and a program can embed only files below its root directory")
  } else {
    let target = embed_target(file, path);
    match fs.kind[r](target) {
      Missing -> read_error(target, "does not exist"),
      Dir -> if dir { read_dir[r](target) }
      else { read_error(target, "is a directory, and `embed` takes a file") },
      File -> if dir { read_error(target, "is a file, and `embed_dir` takes a directory") } else {
        match fs.read_file[r](target) {
          Some(b) -> Ok([{ name: b"", bytes: b }]),
          None -> read_error(target, "could not be read"),
        }
      },
      Symlink -> read_error(target, "is a symlink, which a load does not follow"),
    }
  }

fn package_embed<[r]>(
  p: ProgramPackages,
  k: Int,
  name: Bytes,
  want: EmbedRequest,
) -> EmbedBytesResult / {fs.list_dir[r], fs.kind[r], fs.read_file[r]} = {
  let files = if k == 0 { p.main_package.files }
  else { match p.dependencies.at(k - 1) { Some(d) -> d.files, None -> [] } };
  match files.filter(|f: SourceFile| Bytes::of_string(f.name) == name) {
    [f, ..] -> read_embed[r](f.path, String::of_bytes_lossy(want.path), want.dir),
    [] -> Err(b"no file is there"),
  }
}

fn shipped_path(name: String) -> String / {abort.raise} = {
  let segments = name.split(".");
  match segments.at(0) {
    None -> name,
    Some(root) ->
      "<" ++ root ++ ">/"
        ++ range(1, segments.len()).fold("", |accumulator: String, i: Int|
          if i == 1 { segments.get(i) } else { accumulator ++ "/" ++ segments.get(i) })
        ++ ".ply",
  }
}

fn indexed_sources(
  own: Package,
  dependencies: List<Package>,
  pulled: List<Bytes>,
  shipped: Map<Bytes, Bytes>,
) -> List<SourceFile> / {abort.raise} = {
  let modules = dependencies.fold(own.files, |accumulator: List<SourceFile>, package: Package|
    accumulator.concat(package.files));
  let shipped_sources = modules.concat(
    pulled.map(|n: Bytes|
      {
        path: shipped_path(String::of_bytes(n)),
        name: String::of_bytes(n),
        text: match Map::get(shipped, n) { Some(t) -> t, None -> b"" },
      }),
  );
  [own].concat(dependencies).fold(
    shipped_sources,
    |accumulator: List<SourceFile>, package: Package|
      match package.manifest {
        None -> accumulator,
        Some(text) ->
          accumulator.push({ path: joined(package.root, "ply.pkg"), name: "pkg", text: text }),
      },
  )
}

pub type ProgramPackages = {
  main_package: Package,
  dependencies: List<Package>,
  packages: PackageSources,
}

pub fn read_packages<[r]>(
  root: String,
) -> Result<ProgramPackages, LoadFailure> / {fs.list_dir[r], fs.read_file[r], abort.raise} =
  match package_at[r](root) {
    Err(diagnostics) -> Err(load_failure(diagnostics)),
    Ok(own) -> if own.files.len() == 0 {
      Err(load_failure([load_error("no `.ply` files under `" ++ root ++ "`")]))
    } else {
      match packages_of[r](own) {
        Err(diagnostics) -> Err(load_failure(diagnostics)),
        Ok(dependencies) -> {
          let packages = {
            root: Bytes::of_string(own.root),
            manifest: own.manifest,
            supplied: dependencies.map(supplied_of),
          };
          Ok({ main_package: own, dependencies: dependencies, packages: packages })
        },
      }
    },
  }

fn own_package(root: Bytes, p: Package) -> OwnPackage =
  {
    root: root,
    manifest: p.manifest,
    files: p.files.map(|f: SourceFile| { module: Bytes::of_string(f.name), text: f.text }),
  }

fn world_for(p: ProgramPackages) -> LoadInputs / {abort.raise} =
  load_inputs_of(
    own_package(p.packages.root, p.main_package),
    range(0, p.dependencies.len()).map(|i: Int|
      own_package(p.packages.supplied.get(i).root, p.dependencies.get(i))),
  )

fn shipped_module_text(name: Bytes) -> Option<Bytes> / {shipped.module} =
  shipped.module(String::of_bytes_lossy(name))

effect set ReadsShipped = {shipped.names, shipped.module, shipped.read_pack}

fn looking_up<| e>(
  w: LoadInputs,
  read_embed: keep (Int, Bytes, EmbedRequest) -> EmbedBytesResult / {ReadsShipped, abort.raise | e},
  derived: keep (Bytes, Bytes) -> Option<Bytes> / {ReadsShipped, abort.raise | e},
) -> (Bytes, Bytes) -> Option<Bytes> / {ReadsShipped, abort.raise | e} =
  |kind: Bytes, at: Bytes|
    lookup_input(
      w,
      shipped_module_text,
      shipped_module_text,
      || shipped.names().map(Bytes::of_string),
      read_embed,
      derived,
      kind,
      at,
    )

fn in_temporary_store<a | e>(
  w: LoadInputs,
  read_embed: keep (Int, Bytes, EmbedRequest) -> EmbedBytesResult / {ReadsShipped, abort.raise | e},
  derived: keep (Bytes, Bytes) -> Option<Bytes> / {ReadsShipped, abort.raise | e},
  work: (CheckQueries, Run) -> { run: Run, value: a } / {RunEffects, abort.raise},
) -> a / {ReadsShipped, shipped.digests, shipped.stamps, shipped.definitions, abort.raise | e} = {
  let qs = query_registry();
  database::with_store_in_memory(
    fs::mem_empty(),
    pack_frame,
    shipped.digests(),
    looking_up(w, read_embed, derived),
    || with_decode_cache(|| in_session(qs, |run: Run| work(qs, run))),
  ).value
}

fn open_memo_store<a, [r], [s]>(
  p: ProgramPackages,
  dir: String,
  work: (CheckQueries, LoadInputs, Run) -> { run: Run, value: a } / {RunEffects, abort.raise},
) -> a / {Derives, fs.read[r], fs.write[r], fs.list_dir[s], fs.kind[s], fs.read_file[s], abort.raise} = {
  let w = world_for(p);
  let read_embed = |k: Int, name: Bytes, want: EmbedRequest| package_embed[s](p, k, name, want);
  let derived = |kind: Bytes, at: Bytes| derivation_response(w, kind, at);
  let qs = query_registry();
  database::with_database[r](
    dir,
    pack_frame,
    shipped.digests(),
    looking_up(w, read_embed, derived),
    |_: Bytes| (),
    || with_decode_cache(|| in_session(qs, |run: Run| work(qs, w, run))),
  ).value
}

pub fn derivation_response(
  w: LoadInputs,
  kind: Bytes,
  at: Bytes,
) -> Option<Bytes> / {Derives, abort.raise} =
  if kind == deriver_kind { Some(deriver_key(at, deriver_modules(at, w.texts))) } else {
    match bin::decode(at, derivation_at_bin()) {
      Ok(a) -> if value::decode(a.request.declaration) == None { None }
      else { Some(bin::encode(derivation_result(a.request, w.texts), deriver_response_bin())) },
      Err(_) -> None,
    }
  }

fn query_registry() -> CheckQueries / {shipped.definitions, shipped.stamps, abort.raise} =
  registry(shipped.definitions(), evaluator_of(Bytes::of_string(shipped.stamps())))

pub type CheckResults = {
  results: List<CheckedModule>,
  shipped_module_names: List<Bytes>,
  modules: List<ModuleHashes>,
}

fn results_loaded(w: LoadInputs) -> CheckResults / {memo.read, abort.raise} = {
  let all = query_load(w.own, [], false, listed_module);
  {
    results: all.results,
    shipped_module_names: all.pulled,
    modules: if rejected_first(all.results).len() > 0 { [] }
    else { hashed_all(w.own, all.pulled, false) },
  }
}

fn check_modules(
  qs: CheckQueries,
  w: LoadInputs,
  run: Run,
) -> { run: Run, value: CheckResults } / {RunEffects, abort.raise} =
  reading(qs, run, || results_loaded(w))

type LoadedCode = { results: CheckResults, codes: Result<List<UnitCode>, List<Diagnostic>> }

fn code_loaded(
  w: LoadInputs,
  wanted: (LoadInputs) -> List<RootKey> / {memo.read, abort.raise},
) -> LoadedCode / {memo.read, abort.raise} = {
  let results = results_loaded(w);
  {
    results: results,
    codes: if rejected_first(results.results).len() > 0 { Ok([]) } else {
      reached_codes(
        program_code(entries_of(wanted(w).filter(|k: RootKey| unit_of_root(k, false) != NoCode))),
      )
    },
  }
}

fn written_from<[s]>(
  p: ProgramPackages,
  loaded: LoadedCode,
  tested: Bool,
) -> Result<LoadedProgram, LoadFailure> / {shipped.names, shipped.module, shipped.report_view_used, shipped.runtime, fs.list_dir[s], fs.kind[s], fs.read_file[s], abort.raise} =
  match checked_program[s](p, loaded.results, tested) {
    Err(u) -> Err(u),
    Ok(c) -> match match loaded.codes {
        Err(failed) -> Err(failed),
        Ok(codes) -> match code_rejections(shipped_runtime(), codes) {
          [] -> Ok(codes),
          rejected -> Err(rejected),
        },
      } {
      Ok(codes) ->
        Ok({
          front: c.front,
          parts: program_output(
            codes,
            c.front.dump.emitter_constructors.map(|e: EmitterConstructor| e.name),
            c.front.dump.modules.len(),
            c.front.inputs,
          ).parts,
        }),
      Err(rejected) -> Err({ diagnostics: rejected, files: c.front.files }),
    },
  }

pub fn program_written<[r], [s]>(
  p: ProgramPackages,
  dir: String,
  roots: List<RootKey>,
) -> Result<LoadedProgram, LoadFailure> / {Derives, fs.read[r], fs.write[r], fs.list_dir[s], fs.kind[s], fs.read_file[s], abort.raise} =
  written_from[s](
    p,
    open_memo_store[r, s](p, dir, |qs: CheckQueries, w: LoadInputs, run: Run|
      reading(qs, run, || code_loaded(w, |_: LoadInputs| roots))),
    false,
  )

fn fresh_check_with<a, [s]>(
  p: ProgramPackages,
  work: (CheckQueries, LoadInputs, Run) -> { run: Run, value: a } / {RunEffects, abort.raise},
) -> a / {Derives, fs.list_dir[s], fs.kind[s], fs.read_file[s], abort.raise} = {
  let w = world_for(p);
  in_temporary_store(
    w,
    |k: Int, name: Bytes, want: EmbedRequest| package_embed[s](p, k, name, want),
    |kind: Bytes, at: Bytes| derivation_response(w, kind, at),
    |qs: CheckQueries, run: Run| work(qs, w, run),
  )
}

pub fn fresh_check_results<[s]>(
  p: ProgramPackages,
) -> CheckResults / {Derives, fs.list_dir[s], fs.kind[s], fs.read_file[s], abort.raise} =
  fresh_check_with[s](p, check_modules)

fn pulled_texts(pulled: List<Bytes>) -> Map<Bytes, Bytes> / {shipped.module, abort.raise} =
  pulled.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, n: Bytes|
    match shipped_module_text(n) {
      Some(text) -> accumulator.insert(n, imported(text)),
      None -> accumulator,
    })

fn rejections(
  results: List<CheckedModule>,
  files: List<SourceFile>,
  own: List<Bytes>,
) -> List<Diagnostic> / {abort.raise} = {
  let placed_at = range(0, files.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
    accumulator.insert(
      match own.at(i) { Some(name) -> name, None -> Bytes::of_string(files.get(i).name) },
      i,
    ));
  results.filter(|a: CheckedModule| a.result.rejected.len() > 0).fold(
    [],
    |accumulator: List<Diagnostic>, a: CheckedModule| {
      let i = match placed_at.get(a.module) {
        Some(k) -> k,
        None ->
          panic(
            f"`{String::of_bytes_lossy(a.module)}` has errors, but the program has no source file for that module, so the errors cannot be reported",
          ),
      };
      accumulator.concat(a.result.rejected.map(|d: Diagnostic| placed_in(d, i)))
    },
  )
}

pub fn checked_program<[s]>(
  p: ProgramPackages,
  check_modules: CheckResults,
  tested: Bool,
) -> Result<CheckedProgram, LoadFailure> / {shipped.names, shipped.module, shipped.report_view_used, fs.list_dir[s], fs.kind[s], fs.read_file[s], abort.raise} = {
  let texts = pulled_texts(check_modules.shipped_module_names);
  let mine = indexed_sources(
    p.main_package,
    p.dependencies,
    check_modules.shipped_module_names,
    texts,
  );
  let results = check_modules.results;
  let modules = p.dependencies.fold(p.main_package.files.len(), |n: Int, d: Package|
      n + d.files.len())
    + check_modules.shipped_module_names.len();
  let packaged = packages_rejected(
    p.packages,
    p.main_package.files.map(|f: SourceFile| Bytes::of_string(f.name)),
    modules,
    NoTree,
  );
  match if packaged.len() > 0 { packaged } else { rejections(results, mine, world_for(p).own) } {
    [] -> {
      let loaded = assembled_load(
        p.main_package.files.map(|f: SourceFile| Bytes::of_string(f.name)),
        p.packages,
        results.fold(Map::new(), |accumulator: Map<Bytes, ModuleShape>, a: CheckedModule|
          accumulator.insert(a.module, a.result.shape)),
        joined_module_hashes(check_modules.modules),
        check_modules.shipped_module_names,
        NoTree,
        texts,
        tested,
        true,
        root_warnings(results, p.main_package.files.len()),
      );
      let view = checked_program_from_results(
        loaded.frame,
        loaded.reads,
        results.fold(Map::new(), |accumulator: Map<Bytes, ModuleResult>, a: CheckedModule|
          accumulator.insert(a.module, a.result)),
      );
      report_viewed(loaded.views, true);
      let dump = view_dump(view);
      let w = world_for(p);
      let read = |e: ModuleEmbed|
        match package_location_in(w, e.module) {
          Some(at) -> package_embed[s](p, at.package, at.relative, request_of_key(e.key)),
          None -> shipped_bytes(e.module, e.key, shipped_module_text, shipped_module_text),
        };
      match embed_inputs_of(dump.embeds, read) {
        Err(ds) -> Err({ diagnostics: ds, files: mine }),
        Ok(inputs) ->
          Ok({
            front: {
              dump: dump,
              files: indexed_sources(p.main_package, p.dependencies, loaded.pulled, texts),
              inputs: inputs,
              read_ms: 0,
              front_end_ms: 0,
              store_ms: 0,
              cached: false,
            },
            hashes: view.frame.hashes,
          }),
      }
    },
    ds -> Err({ diagnostics: ds, files: mine }),
  }
}

pub fn shipped_for(
  user: List<Source>,
  packages: PackageSources,
) -> ShippedInputs / {shipped.names, shipped.module, abort.raise} = {
  let text_of = |name: Bytes| shipped.module(String::of_bytes_lossy(name));
  let read = |name: Bytes| match text_of(name) { Some(text) -> Some(imported(text)), None -> None };
  shipped_inputs_of(
    user,
    packages,
    shipped.names().map(Bytes::of_string),
    read,
    text_of,
    dependencies_of,
  )
}

pub fn report_viewed(
  viewed: List<ShippedModuleSummary>,
  pulled: Bool,
) -> Unit / {shipped.report_view_used} =
  if viewed.len() == 0 { () } else { shipped.report_view_used(viewed_text(viewed), pulled) }

fn texts_of(shipped_sources: List<Source>) -> Map<Bytes, Bytes> =
  shipped_sources.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, source: Source|
    accumulator.insert(source.name, source.source_text))

pub type InMemoryAnalysis = { out: AnalysisOutcome, files: List<SourceFile> }

fn input_bytes(inputs: Map<Bytes, Bytes>, want: EmbedRequest) -> Option<Bytes> / {abort.raise} =
  if want.dir || want.path.len() != 64 { None }
  else { inputs.get(Bytes::of_hex(String::of_bytes(want.path))) }

fn input_read(inputs: Map<Bytes, Bytes>, want: EmbedRequest) -> EmbedResult / {abort.raise} =
  match input_bytes(inputs, want) {
    Some(b) -> Ok([embed_file(b"", b)]),
    None -> Err(b"the program was given no input file whose hash matches the requested file"),
  }

pub fn analyse_in_memory(
  files: List<SourceFile>,
  inputs: Map<Bytes, Bytes>,
) -> InMemoryAnalysis / {shipped.names, shipped.module, shipped.report_view_used, abort.raise} = {
  let packages = { root: b"", manifest: None, supplied: [] };
  let shipping = shipped_for(sources_of(files), packages);
  let own = { root: "", manifest: None, files: files };
  let pulled = analyse_pulling_std_with(
    sources_of(files),
    shipping.sources,
    packages,
    embeds: embeds_wanted(b"", sources_of(files)).map(|e: EmbedRecord|
      { ..e, read: input_read(inputs, e.want) }),
    unread: shipping.unread,
    data: shipping.data,
  );
  report_viewed(pulled.shipped_views, true);
  { out: pulled.out, files: indexed_sources(own, [], pulled.pulled, texts_of(shipping.sources)) }
}

pub fn every_root(front: LoadedAnalysis) -> List<RootKey> / {abort.raise} =
  requested_roots(front.dump)

fn named_roots(every: List<RootKey>, reached: Set<Bytes>) -> List<RootKey> =
  every.filter(|k: RootKey| match k { Named(n) -> reached.contains(n), _ -> false })

pub fn reachable_roots(
  front: LoadedAnalysis,
  reached: Set<Bytes>,
) -> List<RootKey> / {abort.raise} = named_roots(every_root(front), reached)

pub fn entry_roots(
  front: LoadedAnalysis,
  hashes: HashOutput,
  entries: List<Bytes>,
) -> List<RootKey> / {abort.raise} =
  reachable_roots(
    front,
    entries.fold(
      reach(hashes, entries.map(FunctionNamed)).functions,
      |reached: Set<Bytes>, entry: Bytes| reached.insert(entry),
    ),
  )

test "a program offers what its entries reach, never a test, law or clause" {
  let every = [Named(b"m.main"), Named(b"m.helper"), Named(b"m.unused"), test_key(b"m", b"t")];
  assert_eq(named_roots(every, Map::new().insert(b"m.main").insert(b"m.helper")), [
    Named(b"m.main"),
    Named(b"m.helper"),
  ])
}

pub fn load<[r]>(
  root: String,
) -> Result<LoadedProgram, List<Diagnostic>> / {fs.list_dir[r], fs.kind[r], fs.read_file[r], Derives, abort.raise} =
  match read_packages[r](root) {
    Err(u) -> Err(u.diagnostics),
    Ok(p) -> {
      let loaded = fresh_check_with[r](p, |qs: CheckQueries, w: LoadInputs, run: Run|
        reading(qs, run, || code_loaded(w, |r: LoadInputs| roots_of_modules(r.own))));
      match written_from[r](p, loaded, true) { Err(u) -> Err(u.diagnostics), Ok(l) -> Ok(l) }
    },
  }

pub effect set Derives = {shipped.names, shipped.module, shipped.digests, shipped.read_pack, shipped.stamps, shipped.report_view_used, shipped.definitions, shipped.runtime, shipped.run_root, compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write}

type DeriverModule = { name: Bytes, text: Bytes }

pub fn derivation_result(
  ask: DeriverRequest,
  own: Map<Bytes, Bytes>,
) -> DeriverResponse / {Derives, abort.raise} = {
  let modules = deriver_modules(ask.module, own);
  run_derivation(ask, deriver_key(ask.module, modules), modules)
}

fn deriver_key(module: Bytes, modules: List<DeriverModule>) -> Bytes / {Derives, abort.raise} =
  blake3(
    Bytes::concat_all([
      blake3(shipped.definitions()),
      shipped_runtime().identity,
      blake3(shipped.digests()),
      module,
      b"\x00",
      Bytes::concat_all(
        modules.map(|r: DeriverModule| Bytes::concat_all([r.name, b"\x00", blake3(r.text)])),
      ),
    ]),
  )

fn deriver_modules(module: Bytes, own: Map<Bytes, Bytes>) -> List<DeriverModule> / {abort.raise} =
  iterate(
    { seen: [], frontier: [module] },
    own.len() + 1,
    |walk: { seen: List<DeriverModule>, frontier: List<Bytes> }| {
      let fresh = walk.frontier.fold([], |accumulator: List<DeriverModule>, name: Bytes|
        match if is_shipped(name) { None } else { own.get(name) } {
          Some(text) -> if walk.seen.concat(accumulator).any(|module: DeriverModule|
              module.name == name) { accumulator }
          else { accumulator.push({ name: name, text: text }) },
          None -> accumulator,
        });
      if fresh.len() == 0 { Stop(walk) } else {
        Continue({
          seen: walk.seen.concat(fresh),
          frontier: fresh.fold([], |accumulator: List<Bytes>, module: DeriverModule| {
            let imports = match header(module.text) {
              Some(head) -> head.imports,
              None -> parse(module.text).node.imports,
            };
            accumulator.concat(imports.map(import_path))
          }),
        })
      }
    },
  ).seen

fn derivation_source(deriver: Bytes) -> Bytes =
  Bytes::concat_all([
    b"import std.derive\nimport ",
    deriver,
    b" as deriver\n\npub fn derived(declaration: derive::Declaration) -> Result<String, derive::Refused> / {abort.raise} =\n  deriver::derive(declaration)\n",
  ])

fn unran(code: Bytes, message: Bytes, notes: List<Bytes>) -> DeriverResponse =
  Failed({ code: code, message: message, notes: notes })

fn unavailable(message: Bytes, notes: List<Bytes>) -> DeriverResponse =
  Unavailable({ code: b"E0155", message: message, notes: notes })

fn diagnostic_line(d: Diagnostic) -> Bytes = Bytes::concat_all([d.code, b": ", d.message])

fn run_derivation(
  ask: DeriverRequest,
  deriver: Bytes,
  modules: List<DeriverModule>,
) -> DeriverResponse / {Derives, abort.raise} = {
  let name = derivation_name(modules);
  match deriver_library(ask.module, deriver, name, modules) {
    Err(ran) -> ran,
    Ok(library) ->
      derivation_run_of(
        ask,
        shipped.run_root(
          library,
          String::of_bytes(derived_root(name)),
          ask.declaration,
          unit::entered_timeout_ms,
        ),
      ),
  }
}

fn derivation_name(modules: List<DeriverModule>) -> Bytes / {abort.raise} =
  iterate(b"derivation", modules.len() + 1, |n: Bytes|
    if modules.any(|r: DeriverModule| r.name == n) { Continue(n.concat(b"_")) } else { Stop(n) })

fn derived_root(name: Bytes) -> Bytes = name.concat(b".derived")

fn deriver_library(
  module: Bytes,
  deriver: Bytes,
  name: Bytes,
  modules: List<DeriverModule>,
) -> Result<String, DeriverResponse> / {Derives, abort.raise} = {
  let wanted = { owner: "derivers/" ++ String::of_bytes(module), key: deriver };
  match cc::found_libraries[cc](cc::development(), [wanted]) {
    Err(reason) -> Err(unavailable(Bytes::of_string(reason), [])),
    Ok(found) -> if found.get(0).built { Ok(found.get(0).path) }
    else { compile_deriver(module, found.get(0), name, modules) },
  }
}

fn compile_deriver(
  module: Bytes,
  at: cc::FoundLibrary,
  name: Bytes,
  modules: List<DeriverModule>,
) -> Result<String, DeriverResponse> / {Derives, abort.raise} = {
  let files = modules.map(|r: DeriverModule|
    {
      path: String::of_bytes(r.name) ++ ".ply",
      name: String::of_bytes(r.name),
      text: r.text,
    }).push({
    path: String::of_bytes(name) ++ ".ply",
    name: String::of_bytes(name),
    text: derivation_source(module),
  });
  let rejected = |diagnostics: List<Diagnostic>|
    Err(
      unran(
        b"E0160",
        Bytes::concat_all([b"`", module, b"` cannot be run by `derive`"]),
        [
          b"a module run by `derive` must declare `pub fn derive(declaration: derive::Declaration) -> Result<String, derive::Refused>`, the only effect it may perform is raising, and none of the modules it depends on may use `derive`",
        ].concat(
          diagnostics.map(diagnostic_line),
        ),
      ),
    );
  let unkept = |reason: Bytes, notes: List<Bytes>| Err(unavailable(reason, notes));
  match written_in_memory(files, [Named(derived_root(name))]) {
    Err(u) -> rejected(u.diagnostics),
    Ok(written) -> if compilers.find[cc]() == None {
      unkept(b"no C compiler is found to run the deriver", [])
    } else {
      match cc::built_libraries[cc](cc::development(), [
          { wanted: at.wanted, c: unit::generated_c(written.parts) },
        ]) {
        Err(reason) -> unkept(b"the deriver's program did not compile", [Bytes::of_string(reason)]),
        Ok(_) -> Ok(at.path),
      }
    },
  }
}

fn with_no_files<a | e>(
  body: () -> a / {fs.list_dir[memory], fs.kind[memory], fs.read_file[memory] | e},
) -> a / e =
  handle {
    body()
  } with {
    fs.list_dir[memory](_) -> None,
    fs.kind[memory](_) -> Missing,
    fs.read_file[memory](_) -> None,
  }

fn written_in_memory(
  files: List<SourceFile>,
  roots: List<RootKey>,
) -> Result<LoadedProgram, LoadFailure> / {Derives, abort.raise} = {
  let p = {
    main_package: { root: "", manifest: None, files: files },
    dependencies: [],
    packages: { root: b"", manifest: None, supplied: [] },
  };
  let w = world_for(p);
  let loaded = in_temporary_store(
    w,
    |k: Int, name: Bytes, want: EmbedRequest| reject_embed(k, name, want),
    nothing_derived,
    |qs: CheckQueries, run: Run| reading(qs, run, || code_loaded(w, |_: LoadInputs| roots)),
  );
  with_no_files(|| written_from[memory](p, loaded, false))
}

fn derivation_run_of(ask: DeriverRequest, returned: Option<Bytes>) -> DeriverResponse = {
  let message = Bytes::concat_all([
    b"the deriver `",
    ask.module,
    b"` raised or did not finish in time",
  ]);
  let notes = [
    Bytes::concat_all([
      b"a deriver has ",
      Bytes::of_string(unit::entered_timeout_ms.to_string()),
      b" ms of wall clock, and a deriver that raises produces no output",
    ]),
  ];
  let failed = unran(b"E0155", message, notes);
  match returned {
    None -> unavailable(message, notes),
    Some(bytes) -> match value::decode(bytes) {
      Some(VCtor(c, [VStr(text)])) -> if value::constructor_name(c) == "Ok" {
        Generated(Bytes::of_string(text))
      } else { failed },
      Some(VCtor(c, [VRecord(fields)])) -> if value::constructor_name(c) != "Err" { failed }
      else { match rejected_of(fields) { Some(r) -> Declined(r), None -> failed } },
      _ -> failed,
    },
  }
}

fn rejected_of(fields: List<value::Field>) -> Option<Rejection> =
  match ((
      value::field_named(fields, "message"),
      value::field_named(fields, "at"),
      value::field_named(fields, "notes"),
    )) {
    (Some(VStr(message)), Some(VCtor(at, placed)), Some(VList(notes))) -> {
      let texts = notes.fold(Some([]), |accumulator: Option<List<Bytes>>, n: Value|
        match ((accumulator, n)) {
          (Some(xs), VStr(t)) -> Some(xs.push(Bytes::of_string(t))),
          _ -> None,
        });
      let place = match placed {
        [VStr(p)] -> Some(Some(Bytes::of_string(p))),
        [] -> Some(None),
        _ -> None,
      };
      match ((texts, place)) {
        (Some(ns), Some(p)) -> if value::constructor_name(at) == "Some"
            || value::constructor_name(at) == "None" {
          Some({ message: Bytes::of_string(message), at: p, notes: ns })
        } else { None },
        _ -> None,
      }
    },
    _ -> None,
  }

const bare_runtime: Bytes =
  description(serving_runtime(b"", program_natives([]).map(declared_signature)))

fn loaded_from(
  files: List<{ path: String, body: Bytes }>,
  names: List<String> = [],
) -> Result<LoadedProgram, List<Diagnostic>> / {abort.raise} = {
  let tree = fs::mem_of(files);
  handle {
    forbid_derivers(|| load[t]("p"))
  } with {
    fs.list_dir[t](path) -> fs::mem_list(tree, path),
    fs.kind[t](path) -> fs::mem_kind(tree, path),
    fs.read_file[t](path) -> fs::mem_read(tree, path),
    shipped.names() -> names.push("std.prelude"),
    shipped.module(name) -> prelude_named(name),
    shipped.report_view_used(view, pulled) -> (),
    shipped.runtime() -> bare_runtime,
    shipped.read_pack(path, offset, len) -> None,
    shipped.definitions() -> placeholder_definitions,
    shipped.stamps() -> "",
  }
}

test "a derivation request naming a declaration that is not a value returns nothing and runs no derive function" {
  let w = load_inputs_of({ root: b"", manifest: None, files: [] }, []);
  let ask = { module: b"std.derive.map", declaration: b"no value" };
  assert_eq(
    forbid_derivers(||
      derivation_response(
        w,
        derived_kind,
        bin::encode({ deriver: b"", request: ask }, derivation_at_bin()),
      )),
    None,
  )
}

test "`deriver_modules` returns the project's own modules that a deriver module imports, directly or through other modules, and no standard library modules" {
  let reach = |own: Map<Bytes, Bytes>, module: Bytes|
    deriver_modules(module, own).map(|module: DeriverModule| module.name);
  assert_eq(reach(Map::new(), b"std.derive.map"), []);
  let own = Map::new().insert(
    b"app.deriver",
    b"import std.derive\nimport std.list\nimport std.option\nimport app.helper\n",
  ).insert(
    b"app.helper",
    b"import std.bytes\nimport app.deriver\n",
  );
  assert_eq(reach(own, b"app.deriver"), [b"app.deriver", b"app.helper"]);
  assert_eq(reach(own.insert(b"std.derive.map", b"import std.derive\n"), b"std.derive.map"), [])
}

pub fn forbid_derivers<a | e>(
  work: () -> a / {shipped.digests, shipped.run_root, compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write, abort.raise | e},
) -> a / {abort.raise | e} =
  handle {
    work()
  } with {
    shipped.digests() -> b"",
    shipped.run_root(library, root, arguments, timeout_ms) ->
      panic("a test's load runs no deriver"),
    compilers.find[cc]() -> panic("a test's load runs no deriver"),
    compilers.start[cc](args) -> panic("a test's load runs no deriver"),
    compilers.wait[cc](job) -> panic("a test's load runs no deriver"),
    toolchain.cache() -> panic("a test's load runs no deriver"),
    toolchain.reuse_dir() -> panic("a test's load runs no deriver"),
    toolchain.bodies_dir() -> panic("a test's load runs no deriver"),
    toolchain.exists(path) -> panic("a test's load runs no deriver"),
    toolchain.read_file(path) -> panic("a test's load runs no deriver"),
    toolchain.write_file(path, bytes) -> panic("a test's load runs no deriver"),
    toolchain.rename(from, to) -> panic("a test's load runs no deriver"),
    toolchain.append(path, bytes) -> panic("a test's load runs no deriver"),
    toolchain.temp_dir() -> panic("a test's load runs no deriver"),
    toolchain.remove_tree(dir) -> panic("a test's load runs no deriver"),
    toolchain.libraries() -> panic("a test's load runs no deriver"),
    toolchain.run(path, args) -> panic("a test's load runs no deriver"),
  }

fn prelude_named(name: String) -> Option<Bytes> =
  if name == "std.prelude" { Some(prelude_source::text) } else { None }

fn codes(r: Result<LoadedProgram, List<Diagnostic>>) -> List<Bytes> =
  match r {
    Ok(_) -> [],
    Err(diagnostics) -> diagnostics.map(|diagnostic: Diagnostic| diagnostic.code),
  }

fn messages(diagnostics: List<Diagnostic>) -> String / {abort.raise} =
  String::of_bytes(
    diagnostics.fold(b"", |accumulator: Bytes, diagnostic: Diagnostic|
      accumulator.concat(diagnostic.message)),
  )

test "a program is the `.ply` files below its directory, in path order, each named as the module its path gives" {
  match loaded_from([
      { path: "p/b.ply", body: b"import a.c (two)\n\nfn main() -> Int = two()\n" },
      { path: "p/a/c.ply", body: b"pub fn two() -> Int = 2\n" },
      { path: "p/.cache/x.ply", body: b"not ply" },
      { path: "p/target/y.ply", body: b"not ply" },
      { path: "p/notes.txt", body: b"not ply" },
    ]) {
    Err(diagnostics) -> panic(messages(diagnostics)),
    Ok(l) -> {
      assert_eq(l.front.files.map(|f: SourceFile| f.path), [
        "p/a/c.ply",
        "p/b.ply",
        "<std>/prelude.ply",
      ]);
      assert_eq(l.front.files.map(|f: SourceFile| f.name), ["a.c", "b", "std.prelude"]);
      assert(l.parts != [])
    },
  }
}

test "a file `a.ply` sorts before the files in directory `a/`, as `ply` orders the files of a project" {
  match loaded_from([
      { path: "p/a/b.ply", body: b"pub fn two() -> Int = 2\n" },
      { path: "p/a.ply", body: b"import a.b (two)\n\nfn main() -> Int = two()\n" },
    ]) {
    Err(diagnostics) -> panic(messages(diagnostics)),
    Ok(l) ->
      assert_eq(l.front.files.map(|f: SourceFile| f.path), [
        "p/a.ply",
        "p/a/b.ply",
        "<std>/prelude.ply",
      ]),
  }
}

fn manifest(name: String, dependencies: String) -> Bytes =
  Bytes::of_string(
    "import std.pkg (Manifest)\n\nfn package() -> Manifest = {\n  name: \"" ++ name
      ++ "\",\n  version: { major: 0, minor: 1, patch: 0 },\n  prefix: None,\n  runtime: { major: 0, minor: 16, patch: 0 },\n  dependencies: ["
      ++ dependencies
      ++ "],\n  entry: None,\n}\n",
  )

fn path_dependency(name: String, path: String) -> String =
  "{ name: \"" ++ name ++ "\", prefix: None, min: { major: 0, minor: 1, patch: 0 }, source: Path(\""
    ++ path
    ++ "\") }"

test "a path dependency is read from the directory its manifest names, and its modules come after the main package's modules" {
  match loaded_from([
      { path: "p/ply.pkg", body: manifest("app", path_dependency("lib", "../lib")) },
      { path: "p/m.ply", body: b"import lib.deep (seven)\n\nfn main() -> Int = seven()\n" },
      { path: "lib/ply.pkg", body: manifest("lib", "") },
      { path: "lib/deep.ply", body: b"pub fn seven() -> Int = 7\n" },
    ]) {
    Err(diagnostics) -> panic(messages(diagnostics)),
    Ok(l) ->
      assert_eq(l.front.files.map(|f: SourceFile| f.path), [
        "p/m.ply",
        "lib/deep.ply",
        "<std>/prelude.ply",
        "p/ply.pkg",
        "lib/ply.pkg",
      ]),
  }
}

test "a package in a subdirectory of the root is loaded as a dependency, not as modules of the root package" {
  match loaded_from([
      { path: "p/ply.pkg", body: manifest("app", path_dependency("lib", "vendor/lib")) },
      { path: "p/m.ply", body: b"import lib.deep (seven)\n\nfn main() -> Int = seven()\n" },
      { path: "p/vendor/lib/ply.pkg", body: manifest("lib", "") },
      {
        path: "p/vendor/lib/deep.ply",
        body: b"import near (six)\n\npub fn seven() -> Int = six() + 1\n",
      },
      { path: "p/vendor/lib/near.ply", body: b"pub fn six() -> Int = 6\n" },
    ]) {
    Err(diagnostics) -> panic(messages(diagnostics)),
    Ok(l) ->
      assert_eq(l.front.files.map(|f: SourceFile| f.name), [
        "m",
        "deep",
        "near",
        "std.prelude",
        "pkg",
        "pkg",
      ]),
  }
}

test "an error in a dependency's module is reported against the dependency's own file" {
  match loaded_from([
      { path: "p/ply.pkg", body: manifest("app", path_dependency("lib", "../lib")) },
      { path: "p/m.ply", body: b"import lib.deep (seven)\n\nfn main() -> Int = seven()\n" },
      { path: "lib/ply.pkg", body: manifest("lib", "") },
      { path: "lib/deep.ply", body: b"pub fn seven() -> Int = \"seven\"\n" },
    ]) {
    Ok(_) -> panic("the dependency rejects"),
    Err(diagnostics) -> {
      let labelled = diagnostics.fold([], |accumulator: List<Int>, d: Diagnostic|
        accumulator.concat(d.labels.map(|l: Label| l.module)));
      assert(labelled.len() > 0);
      assert_eq(labelled.filter(|m: Int| m != 1), [])
    },
  }
}

const embedding_program_files: List<{ path: String, body: Bytes }> =
  [
    {
      path: "p/m.ply",
      body: b"fn greeting() -> Bytes = embed(\"hello.txt\")\n\nfn main() -> Int = greeting().len()\n",
    },
    { path: "p/hello.txt", body: b"hello" },
  ]

test "a module can embed a file next to it: the loaded program records the file's digest and the generated C contains its bytes" {
  match loaded_from(embedding_program_files) {
    Err(diagnostics) -> panic(messages(diagnostics)),
    Ok(l) -> {
      assert_eq(l.front.dump.embeds.map(|e: ModuleEmbed| e.read), [
        Ok([embed_file(b"", b"hello")]),
      ]);
      assert_eq(l.front.inputs, Map::new().insert(b"hello".blake3(), b"hello"));
      let text = unit::unit_text(l.parts);
      assert(
        text.index_of(b"{ .len = 5, .room = 5 },\n  \"hello\",\n") != None,
        Some(String::of_bytes_lossy(text)),
      )
    },
  }
}

test "an embedded file whose contents change between two reads during checking is rejected instead of emitted" {
  let tree = fs::mem_of(embedding_program_files);
  let loaded = handle {
    forbid_derivers(|| load[t]("p"))
  } with {
    var reads: Int = 0,
    fs.list_dir[t](path) -> fs::mem_list(tree, path),
    fs.kind[t](path) -> fs::mem_kind(tree, path),
    fs.read_file[t](path) -> if path != "p/hello.txt" { fs::mem_read(tree, path) } else {
      reads = reads + 1;
      Some(if reads == 1 { b"hello" } else { b"moved" })
    },
    shipped.names() -> [],
    shipped.module(name) -> None,
    shipped.report_view_used(view, pulled) -> (),
    shipped.runtime() -> bare_runtime,
    shipped.read_pack(path, offset, len) -> None,
    shipped.definitions() -> placeholder_definitions,
    shipped.stamps() -> "",
  };
  assert_eq(codes(loaded), [b"E0146"]);
  assert_eq(
    messages(match loaded { Ok(_) -> [], Err(diagnostics) -> diagnostics }),
    "`hello.txt`, which `m` embeds, could not be embedded because it changed after the program was checked",
  )
}

test "a standard library module that a program imports can embed a data file shipped inside the `ply` binary" {
  let tree = fs::mem_of([
    { path: "p/m.ply", body: b"import std.words (list)\n\nfn main() -> Int = list().len()\n" },
  ]);
  let over = |data: Option<Bytes>|
    handle {
      forbid_derivers(|| load[t]("p"))
    } with {
      fs.list_dir[t](path) -> fs::mem_list(tree, path),
      fs.kind[t](path) -> fs::mem_kind(tree, path),
      fs.read_file[t](path) -> fs::mem_read(tree, path),
      shipped.names() -> ["std.words", "std.prelude"],
      shipped.module(name) -> if name == "std.words" {
        Some(b"pub fn list() -> Bytes = embed(\"words/list.txt\")\n")
      } else if name == "std/words/list.txt" { data }
      else { prelude_named(name) },
      shipped.report_view_used(view, pulled) -> (),
      shipped.runtime() -> bare_runtime,
      shipped.read_pack(path, offset, len) -> None,
      shipped.definitions() -> placeholder_definitions,
      shipped.stamps() -> "",
    };
  match over(Some(b"one\ntwo\n")) {
    Err(diagnostics) -> panic(messages(diagnostics)),
    Ok(l) -> {
      assert_eq(l.front.dump.embeds.map(|e: ModuleEmbed| e.read), [
        Ok([embed_file(b"", b"one\ntwo\n")]),
      ]);
      assert(unit::unit_text(l.parts).index_of(b"\"one\\012two\\012\"") != None)
    },
  };
  assert_eq(codes(over(None)), [b"E0146"])
}

test "a standard library module is loaded from its shipped source, and a module that imports it sees that source after `imported` is applied to it" {
  let whole = b"/// Two.\npub fn count() -> Int = 2\n\ntest \"two\" {\n  assert_eq(count(), 2)\n}\n";
  let tree = fs::mem_of([
    { path: "p/m.ply", body: b"import std.words (count)\n\nfn main() -> Int = count()\n" },
  ]);
  let loaded = handle {
    forbid_derivers(|| load[t]("p"))
  } with {
    fs.list_dir[t](path) -> fs::mem_list(tree, path),
    fs.kind[t](path) -> fs::mem_kind(tree, path),
    fs.read_file[t](path) -> fs::mem_read(tree, path),
    shipped.names() -> ["std.words", "std.prelude"],
    shipped.module(name) -> if name == "std.words" { Some(whole) } else { prelude_named(name) },
    shipped.report_view_used(view, pulled) -> (),
    shipped.runtime() -> bare_runtime,
    shipped.read_pack(path, offset, len) -> None,
    shipped.definitions() -> placeholder_definitions,
    shipped.stamps() -> "",
  };
  match loaded {
    Err(diagnostics) -> panic(messages(diagnostics)),
    Ok(l) ->
      assert_eq(
        l.front.files.filter(|f: SourceFile| f.name == "std.words").map(|f: SourceFile| f.text),
        [imported(whole)],
      ),
  }
}

test "a law over an unconstrained type variable loads, and its body is lowered like a generic function body" {
  match loaded_from([
      {
        path: "p/m.ply",
        body: b"fn pair<a>(x: a) -> a = x\n\nlaw \"identity is identity\"\n  forall (x: a) {\n    pair(x) == x\n  }\n",
      },
    ]) {
    Err(diagnostics) -> panic(messages(diagnostics)),
    Ok(l) -> assert(l.parts != []),
  }
}

test "a root with nothing to load, and a file that cannot be a module, are rejected" {
  assert_eq(codes(loaded_from([{ path: "p/notes.txt", body: b"" }])), [b"E0502"]);
  assert_eq(codes(loaded_from([{ path: "p/a-b.ply", body: b"fn main() -> Int = 1\n" }])), [
    b"E0502",
  ])
}

test "a program that does not check is rejected with what the checker said" {
  let messages = codes(loaded_from([{ path: "p/m.ply", body: b"fn main() -> Int = \"one\"\n" }]));
  assert(messages.len() > 0 && messages.filter(|c: Bytes| c == b"E0502").len() == 0)
}

test "a root module whose name starts with a built-in package's prefix is rejected, including a module named exactly `std`" {
  ["p/std.ply", "p/std/json.ply", "p/compiler.ply", "p/compiler/front.ply"].fold(
    (),
    |u: Unit, path: String|
      assert(
        codes(
          loaded_from([{ path: path, body: b"pub fn f() -> Int = 1\n" }], ["std.list"]),
        ).contains(
          b"E0133",
        ),
        Some(path),
      ),
  );
  assert_eq(
    codes(loaded_from([{ path: "p/stdx.ply", body: b"pub fn f() -> Int = 1\n" }], ["std.list"])),
    [],
  )
}
