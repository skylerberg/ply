//! A program read from a directory, checked and emitted: what a program that drives another hands
//! the machine, which compiles the C it is handed and loads no source of its own, and what the
//! builder makes a program the launcher ships from. Its modules are the `.ply` files below the
//! root, named by their paths; a `ply.pkg` there names the packages it depends on, each read from
//! the directory its manifest names; what a module embeds is read beside it; the shipped modules
//! they import are the binary's own shipped modules.

import front.published (no_rows, dump_of)
import front.rows (Dump, EmitterRoot, Rows, module_of, HashFrame, HDef)
import front.seam (AnalysisOutcome, Analysed, Refused, view_dump)
import front (Shipping, analyse_pulling_std_with, checked_staged, pulls_of, shipped_pulled,
              staged_pulling_std_with, viewed_text, inputs_of, shipped_bytes, Embedded,
              embeds_wanted)
import front.facts (ShippedView, ModuleShape, answered_load)
import expand.embed (EmbedAt, BytesRead, EmbedRead, EmbedWant, embed_file, want_of_key)
import store.hash.forms (HashOutput, Fixing, no_fixing)
import store.hash.encoding (hex)
import front.interface (imported)
import store.memo
import store.memo (Run, memo, memo_keep, started)
import store.memo_files
import front.checking (Answered, OwnPackage, World, asked_all, entry_hash, evaluator_of, hashed_all,
                       looked, packages_refused, refused_first, registry, root_warnings,
                       view_answered, world_of, world_placing)
import front.checking.world (Answering, CheckQuery, Driving, ModuleAnswer, decoding_once)
import front.checking.groups (queries)
import front.pkg (PackageSources, Supplied, closure, git_spec, wants)
import check.resolve.tables (Source, Diag, Label, error_at)
import unit (Runtime, shipped, compiled, pack_frame, program_natives, declared_answers)
import check.infer.definitions (Extern)
import emit.layout (layouts)
import std.hash (blake3)
import std.fs
import std.fs (fs, File, Dir, Missing, Symlink)
import std.path (is_absolute, join, normalize, parent)
import std.list
import std.prelude_source
import syntax.parsing (no_module, dummy_span)

/// One source a front end's answer names: where it was read, the module it is, and its text.
pub type SourceFile = { path: String, name: String, text: Bytes }

/// What a machine is handed for a program: the front end's answer, every source its ids run over in
/// that order, the bytes of each file the answer says it embeds, by digest, and what its load cost.
pub type LoadedAnalysis = {
  dump: Dump,
  files: List<SourceFile>,
  inputs: Map<Bytes, Bytes>,
  read_ms: Int,
  front_ms: Int,
  file_ms: Int,
  cached: Bool,
}

/// A program a machine can load: its front end's answer and the C of its unit.
pub type Loaded = { front: LoadedAnalysis, unit: Bytes }

/// A program's front end, and the hashing it published, which says what each definition reaches.
pub type Checked = { front: LoadedAnalysis, hashes: HashOutput }

/// Why a program did not load, with every source its diagnostics' module indices run over, as far as
/// the load got.
pub type Unloaded = { diags: List<Diag>, files: List<SourceFile> }

fn unloaded(diags: List<Diag>) -> Unloaded = { diags: diags, files: [] }

/// A directory a walk does not enter: a hidden one holds caches and VCS metadata, and `target`
/// build output.
pub fn skipped(name: String) -> Bool = name.starts_with(".") || name == "target"

fn joined(dir: String, name: String) -> String =
  if dir == "" || dir == "." { name } else if name == "" { dir } else { dir ++ "/" ++ name }

fn nowhere(message: String) -> Diag =
  error_at(b"E0502", no_module(), dummy_span(), Bytes::of_string(message), b"nothing to load", [])

// --- Reading -------------------------------------------------------------------

/// How many directories deep a walk goes: a path the system opens is at most 4096 bytes, and each
/// level adds at least two, so a deeper directory could not be listed anyway.
fn walk_room() -> Int = 2048

/// Every `.ply` file below `dir`, by its path below it: keyed, so a walk reads them in path order as
/// `ply` reads a project. A symlink is not followed, and a directory that holds a `ply.pkg` is a
/// package of its own, none of whose files are this one's.
fn below<[r]>(
  dir: String,
  under: String,
  found: Map<String, Bool>,
  room: Int,
) -> Map<String, Bool> / {fs.list_dir[r], fs.kind[r]} =
  match fs.list_dir[r](joined(dir, under)) {
    None -> found,
    Some(names) ->
      names.fold(found, |acc: Map<String, Bool>, name: String| {
        let path = joined(under, name);
        match fs.kind[r](joined(dir, path)) {
          Dir -> if skipped(name) || room <= 0
              || fs.kind[r](joined(dir, joined(path, "ply.pkg"))) != Missing { acc }
          else { below[r](dir, path, acc, room - 1) },
          File -> if name.ends_with(".ply") { acc.insert(path, true) } else { acc },
          _ -> acc,
        }
      }),
  }

/// One package as it lies below its root: its manifest when it holds one, and its modules, each
/// named by its path below the root.
pub type Package = { root: String, manifest: Option<Bytes>, files: List<SourceFile> }

fn package_at<[r]>(
  root: String,
) -> Result<Package, List<Diag>> / {fs.list_dir[r], fs.kind[r], fs.read_file[r], abort.raise} = {
  let read = below[r](root, "", Map::new(), walk_room()).keys().fold(
    Ok([]),
    |acc: Result<List<SourceFile>, List<Diag>>, p: String|
      match acc {
        Err(e) -> Err(e),
        Ok(done) -> match module_of(p) {
          Err(why) -> Err([nowhere("`" ++ joined(root, p) ++ "` cannot be a module: " ++ why)]),
          Ok(name) -> match fs.read_file[r](joined(root, p)) {
            None -> Err([nowhere("could not read `" ++ joined(root, p) ++ "`")]),
            Some(text) -> Ok(done.push({ path: joined(root, p), name: name, text: text })),
          },
        },
      },
  );
  match read {
    Err(diags) -> Err(diags),
    Ok(files) ->
      Ok({ root: root, manifest: fs.read_file[r](joined(root, "ply.pkg")), files: files }),
  }
}

fn sources_of(files: List<SourceFile>) -> List<Source> =
  files.map(|f: SourceFile| { name: Bytes::of_string(f.name), src: f.text })

fn supplied_of(package: Package) -> Supplied =
  {
    root: Bytes::of_string(package.root),
    manifest: package.manifest,
    modules: sources_of(package.files),
  }

fn unfetched(key: Bytes) -> Diag =
  nowhere(
    "`" ++ String::of_bytes_lossy(key)
      ++ "` is a git dependency, which `ply` fetches; a program's own load reads path dependencies",
  )

/// Every package the root's manifest reaches, round by round as `wants` names them, in the order
/// they were read: what the front end judges the graph from.
fn packages_of<[r]>(
  root: Package,
) -> Result<List<Package>, List<Diag>> / {fs.list_dir[r], fs.kind[r], fs.read_file[r], abort.raise} =
  iterate(Ok([]), 4096, |acc: Result<List<Package>, List<Diag>>|
    match acc {
      Err(e) -> Stop(Err(e)),
      Ok(read) -> {
        let known = read.push(root).map(|p: Package| Bytes::of_string(p.root));
        match wants(known, [root].concat(read).map(supplied_of)) {
          [] -> Stop(Ok(read)),
          next ->
            Continue(
              next.fold(Ok(read), |got: Result<List<Package>, List<Diag>>, key: Bytes|
                match got {
                  Err(e) -> Err(e),
                  Ok(so_far) -> match git_spec(key) {
                    Some(_) -> Err([unfetched(key)]),
                    None -> match package_at[r](String::of_bytes(key)) {
                      Err(e) -> Err(e),
                      Ok(p) -> Ok(so_far.push(p)),
                    },
                  },
                }),
            ),
        }
      },
    })

/// A path an embed names, relative to the directory of the module's own file.
fn embed_target(file: String, path: String) -> String = normalize(join(parent(file), path))

fn unread(target: String, what: String) -> BytesRead =
  Err(Bytes::of_string("`" ++ target ++ "` " ++ what))

/// Every file under `dir`, by its path below it and in that order; nothing under a name starting
/// with `.` is read.
fn listed<[r]>(
  dir: String,
  under: String,
  found: Map<String, String>,
  room: Int,
) -> Result<Map<String, String>, Bytes> / {fs.list_dir[r], fs.kind[r]} =
  match fs.list_dir[r](joined(dir, under)) {
    None -> Err(Bytes::of_string("`" ++ joined(dir, under) ++ "` could not be listed")),
    Some(names) ->
      names.fold(Ok(found), |acc: Result<Map<String, String>, Bytes>, n: String|
        match acc {
          Err(_) -> acc,
          Ok(m) -> if n.starts_with(".") { acc } else {
            let path = joined(under, n);
            match fs.kind[r](joined(dir, path)) {
              Dir -> if room <= 0 {
                Err(
                  Bytes::of_string("`" ++ joined(dir, path) ++ "` is deeper than a path can name"),
                )
              } else { listed[r](dir, path, m, room - 1) },
              _ -> Ok(m.insert(path, joined(dir, path))),
            }
          },
        }),
  }

fn read_dir<[r]>(dir: String) -> BytesRead / {fs.list_dir[r], fs.kind[r], fs.read_file[r]} =
  match listed[r](dir, "", Map::new(), walk_room()) {
    Err(why) -> Err(why),
    Ok(found) ->
      found.fold(Ok([]), |acc: BytesRead, name: String, path: String|
        match acc {
          Err(_) -> acc,
          Ok(files) -> match fs.read_file[r](path) {
            Some(b) -> Ok(files.push({ name: Bytes::of_string(name), bytes: b })),
            None -> unread(path, "could not be read"),
          },
        }),
  }

fn read_embed<[r]>(
  file: String,
  path: String,
  dir: Bool,
) -> BytesRead / {fs.list_dir[r], fs.kind[r], fs.read_file[r]} =
  if is_absolute(path) {
    unread(path, "is absolute, and a program's own load reads below its root")
  } else {
    let target = embed_target(file, path);
    match fs.kind[r](target) {
      Missing -> unread(target, "does not exist"),
      Dir -> if dir { read_dir[r](target) }
      else { unread(target, "is a directory, and `embed` takes a file") },
      File -> if dir { unread(target, "is a file, and `embed_dir` takes a directory") } else {
        match fs.read_file[r](target) {
          Some(b) -> Ok([{ name: b"", bytes: b }]),
          None -> unread(target, "could not be read"),
        }
      },
      Symlink -> unread(target, "is a symlink, which a load does not follow"),
    }
  }

/// What the module `name` of package `k` of `p` embeds as `want` asks: the root package first, then
/// each dependency in its order.
fn embed_read<[r]>(
  p: Prepared,
  k: Int,
  name: Bytes,
  want: EmbedWant,
) -> BytesRead / {fs.list_dir[r], fs.kind[r], fs.read_file[r]} = {
  let files = if k == 0 { p.own.files }
  else { match p.deps.at(k - 1) { Some(d) -> d.files, None -> [] } };
  match files.filter(|f: SourceFile| Bytes::of_string(f.name) == name) {
    [f, ..] -> read_embed[r](f.path, String::of_bytes_lossy(want.path), want.dir),
    [] -> Err(b"no file is there"),
  }
}

// --- The front end --------------------------------------------------------------

/// `std.json` is `<std>/json.ply`, as a rendered span names a shipped module.
fn shipped_path(name: String) -> String / {abort.raise} = {
  let segments = name.split(".");
  match segments.at(0) {
    None -> name,
    Some(root) ->
      "<" ++ root ++ ">/"
        ++ range(1, segments.len()).fold("", |acc: String, i: Int|
          if i == 1 { segments.get(i) } else { acc ++ "/" ++ segments.get(i) })
        ++ ".ply",
  }
}

/// Every source the answer's module indices run over, in their order: the root package's modules,
/// each dependency's in the order they were read, the shipped modules it pulled, then the manifests.
fn placed(
  own: Package,
  deps: List<Package>,
  pulled: List<Bytes>,
  shipped: Map<Bytes, Bytes>,
) -> List<SourceFile> / {abort.raise} = {
  let modules = deps.fold(own.files, |acc: List<SourceFile>, package: Package|
    acc.concat(package.files));
  let shipped_sources = modules.concat(
    pulled.map(|n: Bytes|
      {
        path: shipped_path(String::of_bytes(n)),
        name: String::of_bytes(n),
        text: match Map::get(shipped, n) { Some(t) -> t, None -> b"" },
      }),
  );
  [own].concat(deps).fold(shipped_sources, |acc: List<SourceFile>, package: Package|
    match package.manifest {
      None -> acc,
      Some(text) -> acc.push({ path: joined(package.root, "ply.pkg"), name: "pkg", text: text }),
    })
}

/// What a read takes in before it loads anything: the program's packages.
pub type Prepared = { own: Package, deps: List<Package>, pkgs: PackageSources }

/// The program below `root` as a load takes it in. A file that cannot be a module and a dependency
/// `ply` would have to fetch are each a refusal.
pub fn prepared<[r]>(
  root: String,
) -> Result<Prepared, Unloaded> / {fs.list_dir[r], fs.kind[r], fs.read_file[r], abort.raise} =
  match package_at[r](root) {
    Err(diags) -> Err(unloaded(diags)),
    Ok(own) -> if own.files.len() == 0 {
      Err(unloaded([nowhere("no `.ply` files under `" ++ root ++ "`")]))
    } else {
      match packages_of[r](own) {
        Err(diags) -> Err(unloaded(diags)),
        Ok(deps) -> {
          let pkgs = {
            root: Bytes::of_string(own.root),
            manifest: own.manifest,
            supplied: deps.map(supplied_of),
          };
          Ok({ own: own, deps: deps, pkgs: pkgs })
        },
      }
    },
  }

fn own_package(root: Bytes, p: Package) -> OwnPackage =
  {
    root: root,
    manifest: p.manifest,
    files: p.files.map(|f: SourceFile| { module: Bytes::of_string(f.name), text: f.text }),
  }

/// The world the queries of a load of `p` read.
fn world_for(p: Prepared) -> World / {abort.raise} =
  world_of(
    own_package(p.pkgs.root, p.own),
    range(0, p.deps.len()).map(|i: Int| own_package(p.pkgs.supplied.get(i).root, p.deps.get(i))),
  )

fn held_module(name: Bytes) -> Option<Bytes> / {shipped.module} =
  shipped.module(String::of_bytes_lossy(name))

/// `work` over a load of `p`, whose files are read under `s`, through the memo store in the stage
/// `dir` names under `r`, or over none where `dir` is empty. One store serves every `ply`: a record
/// is kept under the hash of its query, and vouched for only to a run of the queries that kept or
/// checked it.
fn in_store<a, [r], [s]>(
  p: Prepared,
  dir: String,
  work: (Map<Bytes, CheckQuery>, World, Run) -> { run: Run, value: a } / {Driving, abort.raise},
) -> a / {shipped.answer, shipped.names, fs.read[r], fs.write[r], fs.list_dir[s], fs.kind[s], fs.read_file[s], shipped.module, shipped.definitions, shipped.stamps, abort.raise} = {
  let w = world_for(p);
  let qs = running();
  let look = |kind: Bytes, at: Bytes|
    looked(
      w,
      held_module,
      held_module,
      || shipped.names().map(Bytes::of_string),
      |k: Int, name: Bytes, want: EmbedWant| embed_read[s](p, k, name, want),
      kind,
      at,
    );
  if dir == "" {
    memo::fresh(pack_frame, b"", look, || decoding_once(|| work(qs, w, started(qs)).value))
  } else {
    if fs.create_dir[r](dir) {
      fs.write_file[r](dir ++ "/.used", b"");
      ()
    };
    memo_files::kept[r](dir, pack_frame, b"", look, ||
      decoding_once(|| work(qs, w, started(qs)).value))
  }
}

/// The queries, each under the hash this program gives its definition and the evaluator it runs on:
/// the hashes the answers the toolchain ships are kept under.
fn running() -> Map<Bytes, CheckQuery> / {shipped.definitions, shipped.stamps, abort.raise} =
  registry(shipped.definitions(), evaluator_of(Bytes::of_string(shipped.stamps())))

/// What each module of a load answered checked, the shipped modules it pulled in the order it
/// pulled them, and, where none refuses, what hashing fixed of each.
pub type Asked = { answers: List<Answered>, pulled: List<Bytes>, fixing: Fixing }

/// What each module of `w`, a load of `p`, and each shipped module they pull answers, asked of `qs`
/// over a run.
fn asked(
  qs: Map<Bytes, CheckQuery>,
  w: World,
  run: Run,
) -> { run: Run, value: Asked } / {Driving, abort.raise} = {
  let all = asked_all(qs, w.own, [], false, run);
  let answers = all.value.answers;
  let pulled = all.value.pulled;
  // A program some module refuses has nothing to hash.
  if refused_first(answers).len() > 0 {
    { run: all.run, value: { answers: answers, pulled: pulled, fixing: no_fixing() } }
  } else {
    let fixed = hashed_all(qs, w.own, pulled, false, all.run);
    { run: fixed.run, value: { answers: answers, pulled: pulled, fixing: fixed.value } }
  }
}

/// What each module of `p` and each shipped module it pulls answers, through the memo store in the
/// stage `dir` names (none where `dir` is empty).
pub fn answers_of<[r], [s]>(
  p: Prepared,
  dir: String,
) -> Asked / {shipped.answer, shipped.names, fs.read[r], fs.write[r], fs.list_dir[s], fs.kind[s], fs.read_file[s], shipped.module, shipped.definitions, shipped.stamps, abort.raise} =
  in_store[r, s](p, dir, |qs: Map<Bytes, CheckQuery>, w: World, run: Run| asked(qs, w, run))

/// The hash of `entry` as hashing its module fixed it, through the memo store in the stage `dir`
/// names: nothing where its module does not define it or does not hash. No other module is asked,
/// so one beside it that no longer parses is not read.
pub fn entry_hash_of<[r], [s]>(
  p: Prepared,
  dir: String,
  entry: Bytes,
) -> Option<Bytes> / {shipped.answer, shipped.names, fs.read[r], fs.write[r], fs.list_dir[s], fs.kind[s], fs.read_file[s], shipped.module, shipped.definitions, shipped.stamps, abort.raise} =
  in_store[r, s](p, dir, |qs: Map<Bytes, CheckQuery>, w: World, run: Run| {
    let h = entry_hash(qs, run, entry_module(entry), entry);
    { run: h.run, value: h.hash }
  })

/// [`answers_of`] with nothing kept: what the toolchain ships answered for the shipped modules is
/// still read.
pub fn answers_afresh<[s]>(
  p: Prepared,
) -> Asked / {shipped.answer, shipped.names, fs.list_dir[s], fs.kind[s], fs.read_file[s], shipped.module, shipped.definitions, shipped.stamps, abort.raise} = {
  let w = world_for(p);
  let qs = running();
  memo::fresh(
    pack_frame,
    b"",
    |kind: Bytes, at: Bytes|
      looked(
        w,
        held_module,
        held_module,
        || shipped.names().map(Bytes::of_string),
        |k: Int, name: Bytes, want: EmbedWant| embed_read[s](p, k, name, want),
        kind,
        at,
      ),
    || decoding_once(|| asked(qs, w, started(qs)).value),
  )
}

/// Each of `pulled`, the shipped modules a load pulled, by its text as a module importing it reads it.
fn pulled_texts(pulled: List<Bytes>) -> Map<Bytes, Bytes> / {shipped.module, abort.raise} =
  pulled.fold(Map::new(), |acc: Map<Bytes, Bytes>, n: Bytes|
    match held_module(n) { Some(text) -> acc.insert(n, imported(text)), None -> acc })

/// The module that defines `entry`.
fn entry_module(entry: Bytes) -> Bytes / {abort.raise} = {
  let k = range(0, entry.len()).fold(0 - 1, |acc: Int, i: Int|
    if entry.at(i) == 46 { i } else { acc });
  if k < 0 { b"" } else { entry.slice(0, k) }
}

/// The errors of each module `answers` refuses that no refusal of a module it imports explains,
/// each labelled at its module's place among `files`, whose own and dependencies' modules `own`
/// names in their order as the program does; nothing where none refuses.
fn refusals(
  answers: List<Answered>,
  files: List<SourceFile>,
  own: List<Bytes>,
) -> List<Diag> / {abort.raise} = {
  let placed_at = range(0, files.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int|
    acc.insert(
      match own.at(i) { Some(name) -> name, None -> Bytes::of_string(files.get(i).name) },
      i,
    ));
  refused_first(answers).fold([], |acc: List<Diag>, a: Answered| {
    let i = match placed_at.get(a.module) {
      Some(k) -> k,
      None ->
        panic(
          f"`{String::of_bytes_lossy(a.module)}` refuses, and the load placed no file of it to say so in",
        ),
    };
    acc.concat(
      a.answer.refused.map(|d: Diag| { ..d, labels: d.labels.map(|l: Label| { ..l, module: i }) }),
    )
  })
}

/// The program `p` as its modules' answers in `asked` say it checked and hashed, or what refuses it.
/// `tested` reads its tests and laws, which a program to ship has none of. What its modules embed is
/// read again under `s`, and what the shipped modules embed off the binary.
pub fn assembled<[s]>(
  p: Prepared,
  asked: Asked,
  tested: Bool,
) -> Result<Checked, Unloaded> / {shipped.names, shipped.module, shipped.reached, fs.list_dir[s], fs.kind[s], fs.read_file[s], abort.raise} = {
  let texts = pulled_texts(asked.pulled);
  let listed = shipped.names().map(Bytes::of_string);
  let mine = placed(p.own, p.deps, asked.pulled, texts);
  let answers = asked.answers;
  let modules = p.deps.fold(p.own.files.len(), |n: Int, d: Package| n + d.files.len())
    + asked.pulled.len();
  let packaged = packages_refused(
    p.pkgs,
    p.own.files.map(|f: SourceFile| Bytes::of_string(f.name)),
    modules,
    listed,
  );
  match if packaged.len() > 0 { packaged } else { refusals(answers, mine, world_for(p).own) } {
    [] -> {
      let loaded = answered_load(
        p.own.files.map(|f: SourceFile| Bytes::of_string(f.name)),
        p.pkgs,
        answers.fold(Map::new(), |acc: Map<Bytes, ModuleShape>, a: Answered|
          acc.insert(a.module, a.answer.shape)),
        asked.fixing,
        asked.pulled,
        listed,
        texts,
        tested,
        true,
        root_warnings(answers, p.own.files.len()),
      );
      let view = view_answered(
        loaded.frame,
        loaded.reads,
        answers.fold(Map::new(), |acc: Map<Bytes, ModuleAnswer>, a: Answered|
          acc.insert(a.module, a.answer)),
      );
      tell_viewed(loaded.views, true);
      let dump = view_dump(view, None);
      let w = world_for(p);
      let read = |e: EmbedAt|
        match world_placing(w, e.module) {
          Some(at) -> embed_read[s](p, at.package, at.relative, want_of_key(e.key)),
          None -> shipped_bytes(e.module, e.key, held_module, held_module),
        };
      match inputs_of(dump.embeds, read) {
        Err(ds) -> Err({ diags: ds, files: mine }),
        Ok(inputs) ->
          Ok({
            front: {
              dump: dump,
              files: placed(p.own, p.deps, loaded.pulled, texts),
              inputs: inputs,
              read_ms: 0,
              front_ms: 0,
              file_ms: 0,
              cached: false,
            },
            hashes: view.frame.hashes,
          }),
      }
    },
    ds -> Err({ diags: ds, files: mine }),
  }
}

/// The shipped modules a load of `user` and `pkgs` pulls, each as an importer reads it, and the data
/// files those embed, each asked of the binary when it is pulled.
pub fn shipped_for(
  user: List<Source>,
  pkgs: PackageSources,
) -> Shipping / {shipped.names, shipped.module, abort.raise} = {
  let held = |name: Bytes| shipped.module(String::of_bytes_lossy(name));
  let read = |name: Bytes| match held(name) { Some(text) -> Some(imported(text)), None -> None };
  shipped_pulled(user, pkgs, shipped.names().map(Bytes::of_string), read, held, pulls_of)
}

/// What a load read of the shipped modules it pulled, told to whatever observes the run. `pulled` is
/// whether the load read them itself, rather than re-analysing a load that did.
pub fn tell_viewed(viewed: List<ShippedView>, pulled: Bool) -> Unit / {shipped.reached} =
  if viewed.len() == 0 { () } else { shipped.reached(viewed_text(viewed), pulled) }

fn texts_of(shipped_sources: List<Source>) -> Map<Bytes, Bytes> =
  shipped_sources.fold(Map::new(), |acc: Map<Bytes, Bytes>, source: Source|
    acc.insert(source.name, source.src))

/// What the front end answered for a program held in memory, with every source its module indices
/// run over, in their order.
pub type Held = { out: AnalysisOutcome, files: List<SourceFile> }

/// The bytes `inputs` holds under the digest an embed names in hex: how a closure printed back to
/// source embeds a file.
fn input_bytes(inputs: Map<Bytes, Bytes>, want: EmbedWant) -> Option<Bytes> / {abort.raise} =
  if want.dir || want.path.len() != 64 { None }
  else { inputs.get(Bytes::of_hex(String::of_bytes(want.path))) }

fn input_read(inputs: Map<Bytes, Bytes>, want: EmbedWant) -> EmbedRead / {abort.raise} =
  match input_bytes(inputs, want) {
    Some(b) -> Ok([embed_file(b"", b)]),
    None -> Err(b"the program was handed no file of that digest"),
  }

/// A program held in memory, one package with no manifest, analysed against the shipped modules. A
/// module of it embeds what `inputs` holds under the digest its embed names in hex.
pub fn analysed(
  files: List<SourceFile>,
  inputs: Map<Bytes, Bytes>,
) -> Held / {shipped.names, shipped.module, shipped.reached, abort.raise} = {
  let pkgs = { root: b"", manifest: None, supplied: [] };
  let shipping = shipped_for(sources_of(files), pkgs);
  let own = { root: "", manifest: None, files: files };
  let pulled = analyse_pulling_std_with(
    sources_of(files),
    shipping.read,
    no_rows(),
    pkgs,
    embeds: embeds_wanted(b"", sources_of(files)).map(|e: Embedded|
      { ..e, read: input_read(inputs, e.want) }),
    unread: shipping.unread,
    data: shipping.data,
  );
  tell_viewed(pulled.viewed, true);
  { out: pulled.out, files: placed(own, [], pulled.pulled, texts_of(shipping.read)) }
}

/// A program held in memory, one package with no manifest, checked against the shipped modules: its
/// own modules embed what `inputs` holds by digest, and what the shipped modules embed is read off
/// the binary.
pub fn held(
  files: List<SourceFile>,
  inputs: Map<Bytes, Bytes>,
) -> Result<LoadedAnalysis, Unloaded> / {shipped.names, shipped.module, shipped.reached, abort.raise} = {
  let answered = analysed(files, inputs);
  let own = files.fold(Map::new(), |acc: Map<Bytes, Bool>, f: SourceFile|
    acc.insert(Bytes::of_string(f.name), true));
  match answered.out {
    Refused(diags) -> Err({ diags: diags, files: answered.files }),
    Analysed(w) -> {
      let dump = dump_of(Analysed(w));
      match inputs_of(dump.embeds, |e: EmbedAt|
          if !own.contains(e.module) { shipped_bytes(e.module, e.key, held_module, held_module) }
          else {
            match input_bytes(inputs, want_of_key(e.key)) {
              Some(b) -> Ok([{ name: b"", bytes: b }]),
              None -> Err(b"the program was handed no file of that digest"),
            }
          }) {
        Err(diags) -> Err({ diags: diags, files: answered.files }),
        Ok(inputs) ->
          Ok({
            dump: dump,
            files: answered.files,
            inputs: inputs,
            read_ms: 0,
            front_ms: 0,
            file_ms: 0,
            cached: false,
          }),
      }
    },
  }
}

/// Every root a program's answer offers: each `fn` in source order, then its tests, laws and clauses.
pub fn every_root(front: LoadedAnalysis) -> List<Bytes> =
  front.dump.emitter_roots.map(|root: EmitterRoot| root.root)

/// The program below `root`: read, checked, and emitted afresh. A definition the emitter refuses is
/// a refusal too.
pub fn load<[r]>(
  root: String,
) -> Result<Loaded, List<Diag>> / {fs.list_dir[r], fs.kind[r], fs.read_file[r], shipped.answer, shipped.names, shipped.module, shipped.reached, shipped.runtime, shipped.definitions, shipped.stamps, abort.raise} =
  match prepared[r](root) {
    Err(u) -> Err(u.diags),
    Ok(p) -> match assembled[r](p, answers_afresh[r](p), true) {
      Err(u) -> Err(u.diags),
      Ok(c) -> match compiled(
          shipped.runtime(),
          c.front.dump,
          c.front.files.map(|f: SourceFile| f.text),
          c.front.inputs,
          every_root(c.front),
          b"",
          |_: Bytes| None,
          |_: Bytes, _: Bytes| (),
        ) {
        Err(diags) -> Err(diags),
        Ok(unit) -> Ok({ front: c.front, unit: unit }),
      },
    },
  }

// --- Tests ------------------------------------------------------------------

/// A runtime that implements every native the compiler declares and lays out what it writes in
/// place as it does, and binds nothing.
fn bare_runtime() -> Runtime / {abort.raise} =
  {
    head: b"",
    tail: b"",
    helpers: [],
    natives: program_natives([]).map(|e: Extern|
      { name: e.name, words: e.words, answers: declared_answers(e), raises: e.raises }),
    layouts: layouts(),
    identity: b"",
  }

/// What a program holding every query's definition lists, each under a hash of its own.
fn listed_queries() -> Bytes / {abort.raise} =
  Bytes::concat_all(
    queries().map(
      |q: { name: Bytes, definition: Bytes, body: (Bytes) -> Bytes / {Answering, abort.raise} }|
        Bytes::concat_all([q.definition, b" ", hex(blake3(q.definition)), b"\n"]),
    ),
  )

/// `load` over a tree held in memory, with no shipped module but `std.prelude`, which every module
/// imports, and those `names` lists, which hold nothing.
fn loaded_from(
  files: List<{ path: String, body: Bytes }>,
  names: List<String> = [],
) -> Result<Loaded, List<Diag>> / {abort.raise} = {
  let tree = fs::mem_of(files);
  handle {
    load[t]("p")
  } with {
    fs.list_dir[t](path) -> fs::mem_list(tree, path),
    fs.kind[t](path) -> fs::mem_kind(tree, path),
    fs.read_file[t](path) -> fs::mem_read(tree, path),
    shipped.names() -> names.push("std.prelude"),
    shipped.module(name) -> prelude_named(name),
    shipped.reached(view, pulled) -> (),
    shipped.runtime() -> bare_runtime(),
    shipped.answer(path, offset, len) -> None,
    shipped.definitions() -> listed_queries(),
    shipped.stamps() -> "",
  }
}

/// The text of `std.prelude` where `name` names it, as the toolchain ships it.
fn prelude_named(name: String) -> Option<Bytes> =
  if name == "std.prelude" { Some(prelude_source::text()) } else { None }

fn codes(r: Result<Loaded, List<Diag>>) -> List<Bytes> =
  match r { Ok(_) -> [], Err(diags) -> diags.map(|diag: Diag| diag.code) }

fn said(diags: List<Diag>) -> String / {abort.raise} =
  String::of_bytes(diags.fold(b"", |acc: Bytes, diag: Diag| acc.concat(diag.message)))

test "a program is the `.ply` files below its root, in path order, each the module its path names" {
  match loaded_from([
      { path: "p/b.ply", body: b"import a.c (two)\n\nfn main() -> Int = two()\n" },
      { path: "p/a/c.ply", body: b"pub fn two() -> Int = 2\n" },
      { path: "p/.cache/x.ply", body: b"not ply" },
      { path: "p/target/y.ply", body: b"not ply" },
      { path: "p/notes.txt", body: b"not ply" },
    ]) {
    Err(diags) -> panic(said(diags)),
    Ok(l) -> {
      assert_eq(l.front.files.map(|f: SourceFile| f.path), [
        "p/a/c.ply",
        "p/b.ply",
        "<std>/prelude.ply",
      ]);
      assert_eq(l.front.files.map(|f: SourceFile| f.name), ["a.c", "b", "std.prelude"]);
      assert(l.unit.len() > 0)
    },
  }
}

test "a module's path sorts before a directory's that it prefixes, as `ply` reads a project" {
  match loaded_from([
      { path: "p/a/b.ply", body: b"pub fn two() -> Int = 2\n" },
      { path: "p/a.ply", body: b"import a.b (two)\n\nfn main() -> Int = two()\n" },
    ]) {
    Err(diags) -> panic(said(diags)),
    Ok(l) ->
      assert_eq(l.front.files.map(|f: SourceFile| f.path), [
        "p/a.ply",
        "p/a/b.ply",
        "<std>/prelude.ply",
      ]),
  }
}

fn manifest(name: String, deps: String) -> Bytes =
  Bytes::of_string(
    "import std.pkg (Manifest)\n\nfn package() -> Manifest = {\n  name: \"" ++ name
      ++ "\",\n  version: { major: 0, minor: 1, patch: 0 },\n  prefix: None,\n  runtime: { major: 0, minor: 16, patch: 0 },\n  dependencies: ["
      ++ deps
      ++ "],\n  entry: None,\n}\n",
  )

fn path_dep(name: String, path: String) -> String =
  "{ name: \"" ++ name ++ "\", prefix: None, min: { major: 0, minor: 1, patch: 0 }, source: Path(\""
    ++ path
    ++ "\") }"

test "a path dependency is read from the directory its manifest names, its modules placed after the root's" {
  match loaded_from([
      { path: "p/ply.pkg", body: manifest("app", path_dep("lib", "../lib")) },
      { path: "p/m.ply", body: b"import lib.deep (seven)\n\nfn main() -> Int = seven()\n" },
      { path: "lib/ply.pkg", body: manifest("lib", "") },
      { path: "lib/deep.ply", body: b"pub fn seven() -> Int = 7\n" },
    ]) {
    Err(diags) -> panic(said(diags)),
    Ok(l) ->
      assert_eq(l.front.files.map(|f: SourceFile| f.path), [
        "p/m.ply",
        "lib/deep.ply",
        "<std>/prelude.ply",
        "p/ply.pkg",
        "lib/ply.pkg",
      ]),
  }
}

test "a package below the root is its own: read as the dependency it is, and no module of the root" {
  match loaded_from([
      { path: "p/ply.pkg", body: manifest("app", path_dep("lib", "vendor/lib")) },
      { path: "p/m.ply", body: b"import lib.deep (seven)\n\nfn main() -> Int = seven()\n" },
      { path: "p/vendor/lib/ply.pkg", body: manifest("lib", "") },
      {
        path: "p/vendor/lib/deep.ply",
        body: b"import near (six)\n\npub fn seven() -> Int = six() + 1\n",
      },
      { path: "p/vendor/lib/near.ply", body: b"pub fn six() -> Int = 6\n" },
    ]) {
    Err(diags) -> panic(said(diags)),
    Ok(l) ->
      assert_eq(l.front.files.map(|f: SourceFile| f.name), [
        "m",
        "deep",
        "near",
        "std.prelude",
        "pkg",
        "pkg",
      ]),
  }
}

test "a dependency's module that does not check is labelled in its own file" {
  match loaded_from([
      { path: "p/ply.pkg", body: manifest("app", path_dep("lib", "../lib")) },
      { path: "p/m.ply", body: b"import lib.deep (seven)\n\nfn main() -> Int = seven()\n" },
      { path: "lib/ply.pkg", body: manifest("lib", "") },
      { path: "lib/deep.ply", body: b"pub fn seven() -> Int = \"seven\"\n" },
    ]) {
    Ok(_) -> panic("the dependency refuses"),
    Err(diags) -> {
      let labelled = diags.fold([], |acc: List<Int>, d: Diag|
        acc.concat(d.labels.map(|l: Label| l.module)));
      assert(labelled.len() > 0);
      // `p/m.ply` is file 0, `lib/deep.ply` file 1.
      assert_eq(labelled.filter(|m: Int| m != 1), [])
    },
  }
}

/// A module that embeds `hello.txt` beside it, which holds `hello`.
fn greeting() -> List<{ path: String, body: Bytes }> =
  [
    {
      path: "p/m.ply",
      body: b"fn greeting() -> Bytes = embed(\"hello.txt\")\n\nfn main() -> Int = greeting().len()\n",
    },
    { path: "p/hello.txt", body: b"hello" },
  ]

test "a module embeds a file beside it, which its answer knows by digest and its unit holds" {
  match loaded_from(greeting()) {
    Err(diags) -> panic(said(diags)),
    Ok(l) -> {
      assert_eq(l.front.dump.embeds.map(|e: EmbedAt| e.read), [Ok([embed_file(b"", b"hello")])]);
      assert_eq(l.front.inputs, Map::new().insert(b"hello".blake3(), b"hello"));
      // As a byte string's static object, its bytes raw.
      assert(
        l.unit.index_of(b".len = 5, .layout = 5 },\n  \"hello\",\n") != None,
        Some(String::of_bytes_lossy(l.unit)),
      )
    },
  }
}

/// The definition hash `name` is filed under in `d`.
fn def_hash(d: Dump, name: Bytes) -> Option<Bytes> =
  d.hashes.fold(None, |acc: Option<Bytes>, f: HashFrame|
    match f { HDef(r) -> if r.name == name { r.def } else { acc }, _ -> acc })

test "a program held in memory embeds the file its embed names by digest, as one read from disk" {
  let digest = b"hello".blake3();
  let files = [
    {
      path: "m.ply",
      name: "m",
      text: Bytes::concat_all([
        b"fn greeting() -> Bytes = embed(\"",
        hex(digest),
        b"\")\n\nfn main() -> Int = greeting().len()\n",
      ]),
    },
  ];
  let over = |inputs: Map<Bytes, Bytes>|
    handle {
      held(files, inputs)
    } with {
      shipped.names() -> [],
      shipped.module(name) -> None,
      shipped.reached(view, pulled) -> (),
    };
  let read = match loaded_from(greeting()) {
    Ok(l) -> l.front.dump,
    Err(diags) -> panic(said(diags)),
  };
  match over(Map::new().insert(digest, b"hello")) {
    Err(u) -> panic(said(u.diags)),
    Ok(h) -> {
      assert_eq(h.inputs, Map::new().insert(digest, b"hello"));
      assert(def_hash(h.dump, b"m.greeting") != None);
      assert_eq(def_hash(h.dump, b"m.greeting"), def_hash(read, b"m.greeting"))
    },
  };
  assert_eq(match over(Map::new()) { Ok(_) -> [], Err(u) -> u.diags.map(|d: Diag| d.code) }, [
    b"E0146",
  ])
}

test "an embed whose file reads otherwise once the program is checked is refused, not emitted" {
  let tree = fs::mem_of(greeting());
  let loaded = handle {
    load[t]("p")
  } with {
    var reads: Int = 0,
    fs.list_dir[t](path) -> fs::mem_list(tree, path),
    fs.kind[t](path) -> fs::mem_kind(tree, path),
    fs.read_file[t](path) -> if path != "p/hello.txt" { fs::mem_read(tree, path) } else {
      reads = reads + 1;
      Some(if reads == 1 { b"hello" } else { b"moved" })
    },
    shipped.names() -> [],
    shipped.module(name) -> None,
    shipped.reached(view, pulled) -> (),
    shipped.runtime() -> bare_runtime(),
    shipped.answer(path, offset, len) -> None,
    shipped.definitions() -> listed_queries(),
    shipped.stamps() -> "",
  };
  assert_eq(codes(loaded), [b"E0146"]);
  assert_eq(
    said(match loaded { Ok(_) -> [], Err(diags) -> diags }),
    "`hello.txt`, which `m` embeds, could not be embedded",
  )
}

test "a shipped module a program imports embeds a data file the binary holds" {
  let tree = fs::mem_of([
    { path: "p/m.ply", body: b"import std.words (list)\n\nfn main() -> Int = list().len()\n" },
  ]);
  let over = |data: Option<Bytes>|
    handle {
      load[t]("p")
    } with {
      fs.list_dir[t](path) -> fs::mem_list(tree, path),
      fs.kind[t](path) -> fs::mem_kind(tree, path),
      fs.read_file[t](path) -> fs::mem_read(tree, path),
      shipped.names() -> ["std.words", "std.prelude"],
      shipped.module(name) -> if name == "std.words" {
        Some(b"pub fn list() -> Bytes = embed(\"words/list.txt\")\n")
      } else if name == "std/words/list.txt" { data }
      else { prelude_named(name) },
      shipped.reached(view, pulled) -> (),
      shipped.runtime() -> bare_runtime(),
      shipped.answer(path, offset, len) -> None,
      shipped.definitions() -> listed_queries(),
      shipped.stamps() -> "",
    };
  match over(Some(b"one\ntwo\n")) {
    Err(diags) -> panic(said(diags)),
    Ok(l) -> {
      assert_eq(l.front.dump.embeds.map(|e: EmbedAt| e.read), [
        Ok([embed_file(b"", b"one\ntwo\n")]),
      ]);
      assert(l.unit.index_of(b".len = 8, .layout = 8 },\n  \"one\\012two\\012\",\n") != None)
    },
  };
  assert_eq(codes(over(None)), [b"E0146"])
}

// The emitter parses a shipped module's placed text, so the place is the text the front end read.
test "a shipped module is placed as the load read it, what a module importing it reads in place" {
  let whole = b"/// Two.\npub fn count() -> Int = 2\n\ntest \"two\" {\n  assert_eq(count(), 2)\n}\n";
  let tree = fs::mem_of([
    { path: "p/m.ply", body: b"import std.words (count)\n\nfn main() -> Int = count()\n" },
  ]);
  let loaded = handle {
    load[t]("p")
  } with {
    fs.list_dir[t](path) -> fs::mem_list(tree, path),
    fs.kind[t](path) -> fs::mem_kind(tree, path),
    fs.read_file[t](path) -> fs::mem_read(tree, path),
    shipped.names() -> ["std.words", "std.prelude"],
    shipped.module(name) -> if name == "std.words" { Some(whole) } else { prelude_named(name) },
    shipped.reached(view, pulled) -> (),
    shipped.runtime() -> bare_runtime(),
    shipped.answer(path, offset, len) -> None,
    shipped.definitions() -> listed_queries(),
    shipped.stamps() -> "",
  };
  match loaded {
    Err(diags) -> panic(said(diags)),
    Ok(l) ->
      assert_eq(
        l.front.files.filter(|f: SourceFile| f.name == "std.words").map(|f: SourceFile| f.text),
        [imported(whole)],
      ),
  }
}

test "a law over a sort it leaves uninterpreted loads, its body lowered as a generic body as it stands" {
  match loaded_from([
      {
        path: "p/m.ply",
        body: b"fn pair<a>(x: a) -> a = x\n\nlaw \"identity is identity\"\n  forall (x: a) {\n    pair(x) == x\n  }\n",
      },
    ]) {
    Err(diags) -> panic(said(diags)),
    Ok(l) -> assert(l.unit.len() > 0),
  }
}

test "a root with nothing to load, and a file that cannot be a module, are refused" {
  assert_eq(codes(loaded_from([{ path: "p/notes.txt", body: b"" }])), [b"E0502"]);
  assert_eq(codes(loaded_from([{ path: "p/a-b.ply", body: b"fn main() -> Int = 1\n" }])), [
    b"E0502",
  ])
}

test "a program that does not check is refused with what the checker said" {
  let said = codes(loaded_from([{ path: "p/m.ply", body: b"fn main() -> Int = \"one\"\n" }]));
  assert(said.len() > 0 && said.filter(|c: Bytes| c == b"E0502").len() == 0)
}

test "a root module that claims a built-in package's prefix is refused, the bare root among them" {
  ["p/std.ply", "p/std/json.ply", "p/compiler.ply", "p/compiler/front.ply"].fold(
    (),
    |u: Unit, path: String|
      assert(
        codes(
          loaded_from([{ path: path, body: b"pub fn f() -> Int = 1\n" }], ["std.list"]),
        ).contains(
          b"E0133",
        ),
        Some(path),
      ),
  );
  assert_eq(
    codes(loaded_from([{ path: "p/stdx.ply", body: b"pub fn f() -> Int = 1\n" }], ["std.list"])),
    [],
  )
}
