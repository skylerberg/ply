import compiler.checker
import compiler.checker (CheckResult, Source)
import compiler.syntax
import compiler.syntax (Edit, Function, Import, ImportedName, Name, Node)
import std.string

type RenameError =
  | CheckFailedBefore(List<String>)
  | NotDefined(String)
  | CheckFailedAfter(List<String>)
  | HashesChanged(List<String>)

const limits: checker::Limits = { files: 64, bytes: 1048576 }

fn messages(program: CheckResult) -> List<String> =
  program.diagnostics.map(|d: syntax::Diagnostic| d.code ++ ": " ++ d.message)

fn check_sources(sources: List<Source>) -> Result<CheckResult, List<String>> / {abort.raise} =
  match checker::check_alone(sources, limits) {
    Err(_) -> Err(["the sources are too large to rename"]),
    Ok(program) -> if program.ok { Ok(program) } else { Err(messages(program)) },
  }

fn module_of(path: String) -> String / {abort.raise} =
  path.slice(0, path.len() - 4).replace("/", ".")

fn last_segment(module: String) -> String = {
  let parts = module.split(".");
  match parts.at(parts.len() - 1) { Some(last) -> last, None -> module }
}

fn rename_edits(node: Node, to: String) -> List<Edit> =
  match syntax::name(node) {
    Some(identifier) -> [{ path: "", span: identifier.span, text: Bytes::of_string(to) }],
    None -> [],
  }

fn is_named(node: Node, text: String) -> Bool =
  match syntax::name(node) { Some(identifier) -> identifier.text == text, None -> false }

fn is_qualified_by(node: Node, binder: String) -> Bool =
  match syntax::qualifier(node) { Some(identifier) -> identifier.text == binder, None -> false }

type ImportAccess = { bare: Bool, binder: Option<String> }

fn import_access(
  tree: Node,
  own: String,
  module: String,
  from: String,
) -> ImportAccess / {abort.raise} =
  if own == module { { bare: true, binder: None } } else {
    syntax::children(tree).fold({ bare: false, binder: None }, |reach: ImportAccess, node: Node|
      if syntax::kind(node) != Import || !is_named(node, module) { reach } else {
        match syntax::children(node) {
          [] -> { ..reach, binder: Some(last_segment(module)) },
          parts ->
            parts.fold(reach, |r: ImportAccess, part: Node|
              match syntax::kind(part) {
                ImportedName -> if is_named(part, from) { { ..r, bare: true } } else { r },
                _ -> match syntax::name(part) {
                  Some(alias) -> { ..r, binder: Some(alias.text) },
                  None -> r,
                },
              }),
        }
      })
  }

fn edits_in(
  tree: Node,
  own: String,
  module: String,
  from: String,
  to: String,
) -> List<Edit> / {abort.raise} = {
  let reach = import_access(tree, own, module, from);
  syntax::walk(tree).fold([], |edits: List<Edit>, node: Node|
    match syntax::kind(node) {
      Function -> if own == module && is_named(node, from) {
        rename_edits(node, to).fold(edits, push_edit)
      } else { edits },
      ImportedName -> if reach.bare && own != module && is_named(node, from) {
        rename_edits(node, to).fold(edits, push_edit)
      } else { edits },
      Name -> if !is_named(node, from) { edits } else {
        match ((syntax::qualifier(node), reach.binder)) {
          (None, _) -> if reach.bare { rename_edits(node, to).fold(edits, push_edit) }
          else { edits },
          (Some(_), Some(binder)) -> if is_qualified_by(node, binder) {
            rename_edits(node, to).fold(edits, push_edit)
          } else { edits },
          (Some(_), None) -> edits,
        }
      },
      _ -> edits,
    })
}

fn push_edit(edits: List<Edit>, edit: Edit) -> List<Edit> = edits.push(edit)

fn rewrite_sources(
  sources: List<Source>,
  module: String,
  from: String,
  to: String,
) -> List<Source> / {abort.raise} =
  sources.map(|source: Source| {
    let edits = edits_in(syntax::parse(source.text).tree, module_of(source.path), module, from, to);
    match syntax::apply_edits(source.text, edits) {
      Some(text) -> { path: source.path, text: text },
      None -> source,
    }
  })

fn rename(
  sources: List<Source>,
  module: String,
  from: String,
  to: String,
) -> Result<List<Source>, RenameError> / {abort.raise} =
  match check_sources(sources) {
    Err(errors) -> Err(CheckFailedBefore(errors)),
    Ok(before) -> {
      let old = module ++ "." ++ from;
      match checker::hashes(before).get(old) {
        None -> Err(NotDefined(old)),
        Some(hash) -> {
          let after_sources = rewrite_sources(sources, module, from, to);
          match check_sources(after_sources) {
            Err(errors) -> Err(CheckFailedAfter(errors)),
            Ok(after) -> {
              let expected = checker::hashes(before).remove(old).insert(module ++ "." ++ to, hash);
              if checker::hashes(after) == expected { Ok(after_sources) } else {
                Err(
                  HashesChanged(
                    checker::changed(before, after).filter(|name: String|
                      name != old && name != module ++ "." ++ to),
                  ),
                )
              }
            },
          }
        },
      }
    },
  }

const shop: List<Source> =
  [
    {
      path: "shop/prices.ply",
      text: b"/// What a basket costs.\npub fn total(prices: List<Int>) -> Int = prices.fold(0, |sum: Int, p: Int| sum + p)\n\npub fn discounted(prices: List<Int>) -> Int = total(prices) * 9 / 10  // ten off\n",
    },
    {
      path: "main.ply",
      text: b"import shop.prices\nimport shop.prices (total)\n\n// The basket, whole and discounted.\nfn main() -> Int = total([250, 199])   +   prices::total([1]) + prices::discounted([2])\n",
    },
  ]

fn text_of(sources: List<Source>, path: String) -> Bytes =
  sources.fold(b"", |found: Bytes, s: Source| if s.path == path { s.text } else { found })

test "a rename changes the definition, its import and every call, and leaves all other text unchanged" {
  match rename(shop, "shop.prices", "total", "sum_of") {
    Err(_) -> panic("the rename moves no hash"),
    Ok(renamed) -> {
      assert_eq(
        text_of(renamed, "shop/prices.ply"),
        b"/// What a basket costs.\npub fn sum_of(prices: List<Int>) -> Int = prices.fold(0, |sum: Int, p: Int| sum + p)\n\npub fn discounted(prices: List<Int>) -> Int = sum_of(prices) * 9 / 10  // ten off\n",
      );
      assert_eq(
        text_of(renamed, "main.ply"),
        b"import shop.prices\nimport shop.prices (sum_of)\n\n// The basket, whole and discounted.\nfn main() -> Int = sum_of([250, 199])   +   prices::sum_of([1]) + prices::discounted([2])\n",
      )
    },
  }
}

test "after a rename every definition keeps its hash, and the renamed one has its old hash under its new name" {
  let before = check_sources(shop);
  let after = match rename(shop, "shop.prices", "total", "sum_of") {
    Ok(renamed) -> check_sources(renamed),
    Err(_) -> Err(["the rename moves no hash"]),
  };
  match ((before, after)) {
    (Ok(was), Ok(now)) -> {
      assert_eq(checker::changed(was, now), ["shop.prices.sum_of", "shop.prices.total"]);
      assert_eq(
        checker::hashes(now).get("shop.prices.sum_of"),
        checker::hashes(was).get("shop.prices.total"),
      );
      assert_eq(checker::hashes(now).get("main.main"), checker::hashes(was).get("main.main"))
    },
    _ -> panic("both programs check"),
  }
}

const capturing: List<Source> =
  [
    {
      path: "m.ply",
      text: b"fn pick(a: Int, b: Int) -> Int = a\n\nfn main() -> Int = {\n  let chosen = |a: Int, b: Int| b;\n  pick(1, 2) + chosen(3, 4)\n}\n",
    },
  ]

test "a rename onto a name a caller binds is rejected, naming the definition it would change" {
  assert_eq(rename(capturing, "m", "pick", "chosen"), Err(HashesChanged(["m.main"])))
}

test "a rename onto a name that is taken, of a function that is not there, or in a program that does not check is rejected" {
  assert(match rename(shop, "shop.prices", "total", "discounted") {
    Err(CheckFailedAfter(_)) -> true,
    _ -> false,
  });
  assert_eq(rename(shop, "shop.prices", "sum", "s"), Err(NotDefined("shop.prices.sum")));
  assert(match rename([{ path: "m.ply", text: b"fn f() -> Int = \"one\"\n" }], "m", "f", "g") {
    Err(CheckFailedBefore(_)) -> true,
    _ -> false,
  })
}
