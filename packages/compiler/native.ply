//! A native program: its unit's C linked with the runtime's library into an executable, with a pack
//! after it that carries what the program reads at run time: the shipped modules a load of another
//! program compiles against, the answers they gave, and what the program's own front end answered
//! of the definition it enters, which the runtime binds its code to.

import std.bytes (u32_le, u64_le, ascii_of_int)
import std.hash (blake3)
import std.json (Json, Object, Array, Str, Number, Bool, parse)
import compiler.unit (Helper, Native, Runtime)
import compiler.emit.layout (MachineStruct, MachineField, HoldLaid, machine_structs, ctx_struct,
                             release_depth, hold_laid)

/// The `main` every native program has: the runtime entered with the descriptor its unit's C lays
/// out.
pub fn main_c() -> Bytes =
  b"struct ply_descriptor;\nextern const struct ply_descriptor ply_descriptor;\nint ply_native_enter(int, char **, const struct ply_descriptor *);\nint main(int argc, char **argv) { return ply_native_enter(argc, argv, &ply_descriptor); }\n"

/// A program that prints the runtime its library is, as JSON.
pub fn describer_c() -> Bytes =
  b"#include <stdio.h>\nconst char *ply_runtime_describe(void);\nint main(void) { fputs(ply_runtime_describe(), stdout); return 0; }\n"

/// What a native program's objects compile with: nothing of the program is exported, so a unit it
/// loads later binds only to its own code.
pub fn native_flags() -> List<String> = ["-fvisibility=hidden", "-fno-strict-aliasing"]

/// Where the pack carries a native program's front end, as the runtime reads it.
pub fn front_path() -> String = "program/front"

/// Where the pack carries the standard library's files, each by its place below the library's
/// directory, whatever a checkout calls that directory.
pub fn std_root() -> String = "std"

/// Where the pack carries the compiler's modules, each by its place below the compiler's directory.
pub fn compiler_root() -> String = "compiler"

fn text_at(j: Json, name: String) -> Option<String> =
  match j { Object(m) -> match m.get(name) { Some(Str(s)) -> Some(s), _ -> None }, _ -> None }

fn int_at(j: Json, name: String) -> Option<Int> =
  match j {
    Object(m) -> match m.get(name) { Some(Number(d)) -> Int::of_decimal(d, Down), _ -> None },
    _ -> None,
  }

fn list_at_key(j: Json, name: String) -> List<Json> =
  match j { Object(m) -> match m.get(name) { Some(Array(xs)) -> xs, _ -> [] }, _ -> [] }

fn flag_at(j: Json, name: String) -> Bool =
  match j { Object(m) -> m.get(name) == Some(Bool(true)), _ -> false }

/// A native as a description lists it; `None` for an entry that does not read as one.
fn described_native(n: Json) -> Option<Native> =
  match ((text_at(n, "name"), int_at(n, "words"))) {
    (Some(name), Some(words)) ->
      Some({
        name: Bytes::of_string(name),
        words: words,
        answers: flag_at(n, "answers"),
        raises: flag_at(n, "raises"),
      }),
    _ -> None,
  }

/// The natives a description lists; `None` where it lists none or one does not read.
fn natives_at(j: Json) -> Option<List<Native>> =
  match j {
    Object(m) -> match m.get("natives") {
      Some(Array(xs)) ->
        xs.fold(Some([]), |acc: Option<List<Native>>, n: Json|
          match acc {
            None -> None,
            Some(ns) -> match described_native(n) { Some(x) -> Some(ns.push(x)), None -> None },
          }),
      _ -> None,
    },
    _ -> None,
  }

/// What `read` makes of the member `name` of `j`; `None` where there is none.
fn read_at<a>(j: Json, name: String, read: (Json) -> Option<a>) -> Option<a> =
  match j { Object(m) -> match m.get(name) { Some(x) -> read(x), None -> None }, _ -> None }

/// The runtime `json` describes, as a runtime's library describes itself; or why it is none this
/// compiler holds a program's code to: not such a description, or one laying out what emitted code
/// reads in place otherwise than this compiler does.
pub fn runtime_of(json: Bytes) -> Result<Runtime, Bytes> / {abort.raise} =
  match parse(json) {
    Err(_) -> Err(b"it is not JSON"),
    Ok(j) -> match ((
        text_at(j, "head"),
        text_at(j, "tail"),
        text_at(j, "identity"),
        natives_at(j),
      )) {
      (Some(head), Some(tail), Some(identity), Some(natives)) -> match laid_otherwise(j) {
        Some(why) -> Err(why),
        None ->
          Ok({
            head: Bytes::of_string(head),
            tail: Bytes::of_string(tail),
            helpers: list_at_key(j, "helpers").fold([], |acc: List<Helper>, h: Json|
              match ((text_at(h, "name"), int_at(h, "args"))) {
                (Some(name), Some(args)) ->
                  acc.push({
                    name: Bytes::of_string(name),
                    args: args,
                    answers: flag_at(h, "answers"),
                  }),
                _ -> acc,
              }),
            natives: natives,
            identity: Bytes::of_string(identity),
          }),
      },
      _ -> Err(b"it lacks its head, tail, identity or natives, or one does not read"),
    },
  }

/// A field of a struct as a description lists it.
type Described = { name: Bytes, at: Int, bytes: Int }

/// The fields `xs` lists, each as a description lists one; one that does not read as nothing's.
fn described_fields(xs: List<Json>) -> List<Described> =
  xs.map(|f: Json|
    match ((text_at(f, "name"), int_at(f, "at"), int_at(f, "bytes"))) {
      (Some(n), Some(at), Some(b)) -> { name: Bytes::of_string(n), at: at, bytes: b },
      _ -> { name: b"", at: 0 - 1, bytes: 0 - 1 },
    })

/// `s`'s fields as this compiler lays them out.
fn fields_laid(s: MachineStruct) -> List<Described> =
  s.fields.map(|f: MachineField| { name: f.name, at: f.at, bytes: f.bytes })

fn described_said(d: Described) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"`",
    d.name,
    b"` at ",
    ascii_of_int(d.at),
    b" of ",
    ascii_of_int(d.bytes),
    b" bytes",
  ])

/// The first field where the struct `what`, as a description lists it in `described`, and as this
/// compiler lays it out in `laid`, part; `None` where they agree.
fn first_unlike(
  what: Bytes,
  described: List<Described>,
  laid: List<Described>,
) -> Option<Bytes> / {abort.raise} =
  range(0, if described.len() > laid.len() { described.len() } else { laid.len() }).fold(
    None,
    |found: Option<Bytes>, i: Int|
      match found {
        Some(_) -> found,
        None -> if described.at(i) == laid.at(i) { None } else {
          Some(
            Bytes::concat_all([
              what,
              b"'s field ",
              ascii_of_int(i),
              b" is ",
              match described.at(i) { Some(d) -> described_said(d), None -> b"missing" },
              b" where this `ply` lays out ",
              match laid.at(i) { Some(d) -> described_said(d), None -> b"none" },
            ]),
          )
        },
      },
  )

/// Where the runtime `j` describes lays out what emitted code reads in place otherwise than this
/// compiler does: the context's fields, each struct emitted code lays out and the runtime reads, how
/// deeply drop roots nest before a release is put off, and the word a hold keeps its value in. `None`
/// where it agrees.
fn laid_otherwise(j: Json) -> Option<Bytes> / {abort.raise} = {
  let structs = list_at_key(j, "descriptors");
  let depth = int_at(j, "release_depth");
  match first_unlike(
      b"the context",
      described_fields(list_at_key(j, "ctx")),
      fields_laid(ctx_struct()),
    ) {
    Some(why) -> Some(why),
    None -> match range(0, machine_structs().len()).fold(None, |found: Option<Bytes>, i: Int|
        match found {
          Some(_) -> found,
          None -> {
            let s = machine_structs().get(i);
            match structs.at(i) {
              None -> Some(Bytes::concat_all([b"it describes no `", s.name, b"`"])),
              Some(d) -> if text_at(d, "name") != Some(String::of_bytes_lossy(s.name)) {
                Some(
                  Bytes::concat_all([b"its struct ", ascii_of_int(i), b" is not `", s.name, b"`"]),
                )
              } else if int_at(d, "bytes") != Some(s.bytes) {
                Some(
                  Bytes::concat_all([b"`", s.name, b"` is not ", ascii_of_int(s.bytes), b" bytes"]),
                )
              } else {
                first_unlike(
                  Bytes::concat_all([b"`", s.name, b"`"]),
                  described_fields(list_at_key(d, "fields")),
                  fields_laid(s),
                )
              },
            }
          },
        }) {
      Some(why) -> Some(why),
      None -> if depth != Some(release_depth()) {
        Some(
          Bytes::concat_all([
            b"its drop roots nest ",
            match depth { Some(n) -> ascii_of_int(n), None -> b"no number" },
            b" deep, where this `ply`'s nest ",
            ascii_of_int(release_depth()),
          ]),
        )
      } else {
        let held: Option<HoldLaid> = read_at(j, "hold", |h: Json|
          match int_at(h, "held") { Some(n) -> Some({ held: n }), None -> None });
        if held == Some(hold_laid()) { None } else {
          Some(
            Bytes::concat_all([
              b"its holds keep their value at word ",
              match held { Some(h) -> ascii_of_int(h.held), None -> b"none it says" },
              b", where this `ply`'s read it at ",
              ascii_of_int(hold_laid().held),
            ]),
          )
        }
      },
    },
  }
}

/// One file a pack carries, by the path it is read under.
pub type Packed = { path: String, bytes: Bytes }

/// `files` as the pack a binary carries after its code: each file's bytes, then a table of each
/// one's path, where its bytes are, how many and their digest, ascending by path, then the lengths
/// of the pack and of the table and `PLYPACK1`. A path given twice is carried once, as last given.
pub fn pack(files: List<Packed>) -> Bytes = {
  let by_path = files.fold(Map::new(), |acc: Map<String, Bytes>, f: Packed|
    acc.insert(f.path, f.bytes));
  let laid = by_path.fold(
    { data: [], table: [], at: 0 },
    |acc: { data: List<Bytes>, table: List<Bytes>, at: Int }, path: String, bytes: Bytes|
      {
        data: acc.data.push(bytes),
        table: acc.table.push(
          Bytes::concat_all([
            u32_le(Bytes::of_string(path).len()),
            Bytes::of_string(path),
            u64_le(acc.at),
            u64_le(bytes.len()),
            blake3(bytes),
          ]),
        ),
        at: acc.at + bytes.len(),
      },
  );
  let table = u32_le(by_path.len()).concat(Bytes::concat_all(laid.table));
  Bytes::concat_all([
    Bytes::concat_all(laid.data),
    table,
    u64_le(laid.at + table.len()),
    u64_le(table.len()),
    b"PLYPACK1",
  ])
}

// --- Tests -----------------------------------------------------------------------

test "a pack lays its files out by path, then its table, then the lengths and the mark" {
  let b = pack([{ path: "b", bytes: b"22" }, { path: "a", bytes: b"1" }]);
  // `a` first, then `b`, though they were given the other way round.
  assert_eq(b.slice(0, 3), b"122");
  let table_len = 4 + (4 + 1 + 8 + 8 + 32) * 2;
  assert_eq(b.len(), 3 + table_len + 8 + 8 + 8);
  assert_eq(b.slice(b.len() - 8, b.len()), b"PLYPACK1");
  assert_eq(b.slice(b.len() - 16, b.len() - 8), u64_le(table_len));
  assert_eq(b.slice(b.len() - 24, b.len() - 16), u64_le(3 + table_len))
}

/// The members of a description that lay out what emitted code reads in place, as this compiler
/// lays it out.
fn machine_json() -> Bytes / {abort.raise} = {
  let fields = |s: MachineStruct|
    Bytes::concat_all([
      b"[",
      Bytes::join(
        s.fields.map(|f: MachineField|
          Bytes::concat_all([
            b"{\"name\":\"",
            f.name,
            b"\",\"at\":",
            ascii_of_int(f.at),
            b",\"bytes\":",
            ascii_of_int(f.bytes),
            b"}",
          ])),
        b",",
      ),
      b"]",
    ]);
  Bytes::concat_all([
    b"\"ctx\":",
    fields(ctx_struct()),
    b",\"descriptors\":[",
    Bytes::join(
      machine_structs().map(|s: MachineStruct|
        Bytes::concat_all([
          b"{\"name\":\"",
          s.name,
          b"\",\"bytes\":",
          ascii_of_int(s.bytes),
          b",\"fields\":",
          fields(s),
          b"}",
        ])),
      b",",
    ),
    b"],\"release_depth\":",
    ascii_of_int(release_depth()),
    b",\"hold\":{\"held\":",
    ascii_of_int(hold_laid().held),
    b"}",
  ])
}

test "a runtime laying out the context, a struct it reads or its drop roots' depth otherwise is refused" {
  let head = b"{\"head\":\"H\",\"tail\":\"T\",\"identity\":\"I\",\"helpers\":[],";
  let natives = b"\"natives\":[{\"name\":\"panic\",\"words\":1,\"answers\":true,\"raises\":true}]";
  let described = |machine: Bytes|
    runtime_of(Bytes::concat_all([head, natives, b",", machine, b"}"]));
  let why = |machine: Bytes| match described(machine) { Ok(_) -> b"", Err(w) -> w };
  assert_eq(why(machine_json()), b"");
  let moved = machine_json().replace(
    b"\"name\":\"release_depth\",\"at\":72",
    b"\"name\":\"release_depth\",\"at\":80",
  );
  assert(moved != machine_json(), None);
  assert(why(moved).index_of(b"`release_depth` at 80") != None, None);
  let wider = machine_json().replace(
    b"\"name\":\"PlyFnDesc\",\"bytes\":48",
    b"\"name\":\"PlyFnDesc\",\"bytes\":56",
  );
  assert(why(wider).index_of(b"`PlyFnDesc` is not 48 bytes") != None, None);
  let deeper = machine_json().replace(b"\"release_depth\":32", b"\"release_depth\":64");
  assert(why(deeper).index_of(b"nest 64 deep") != None, None);
  let held = machine_json().replace(b"\"hold\":{\"held\":1}", b"\"hold\":{\"held\":2}");
  assert(held != machine_json(), None);
  assert(why(held).index_of(b"keep their value at word 2") != None, None);
  // A description that says nothing of them is refused too: this `ply` cannot check its code against it.
  assert(why(b"\"ctx\":[]").len() > 0, None)
}

test "a runtime reads back from the JSON its library describes itself with" {
  let laid = machine_json();
  let json = Bytes::concat_all([
    b"{\"head\":\"H\",\"tail\":\"T\",\"identity\":\"I\",\"helpers\":[{\"name\":\"h\",\"args\":2,\"answers\":true}],\"natives\":[{\"name\":\"List::len\",\"words\":1,\"answers\":true,\"raises\":false},{\"name\":\"panic\",\"words\":1,\"answers\":true,\"raises\":true}],",
    laid,
    b",\"builtins\":[\"List::len\",\"panic\"]}",
  ]);
  match runtime_of(json) {
    Err(why) -> assert(false, Some(String::of_bytes_lossy(why))),
    Ok(r) -> {
      assert_eq(r.head, b"H");
      assert_eq(r.helpers, [{ name: b"h", args: 2, answers: true }]);
      assert_eq(r.natives, [
        { name: b"List::len", words: 1, answers: true, raises: false },
        { name: b"panic", words: 1, answers: true, raises: true },
      ]);
      assert_eq(r.identity, b"I")
    },
  };
  // A library that lists no natives, or one that does not read, describes a runtime this `ply`
  // cannot hold a program's code to.
  let head = b"{\"head\":\"H\",\"tail\":\"T\",\"identity\":\"I\",\"helpers\":[],";
  let natives = b"\"natives\":[{\"name\":\"panic\",\"words\":1,\"answers\":true,\"raises\":true}]";
  let reads = |j: Bytes| match runtime_of(j) { Ok(_) -> true, Err(_) -> false };
  assert(reads(Bytes::concat_all([head, natives, b",", laid, b"}"])), None);
  assert_eq(reads(Bytes::concat_all([head, laid, b"}"])), false);
  assert_eq(
    reads(Bytes::concat_all([head, b"\"natives\":[{\"name\":\"panic\"}],", laid, b"}"])),
    false,
  )
}
