import std.bytes (u32_le, u64_le)
import std.hash (blake3)

pub const main_c: Bytes =
  b"struct ply_descriptor;\nextern const struct ply_descriptor ply_descriptor;\nint ply_native_enter(int, char **, const struct ply_descriptor *);\nint main(int argc, char **argv) { return ply_native_enter(argc, argv, &ply_descriptor); }\n"

pub const runtime_tool_c: Bytes =
  b"#include <stdio.h>\nconst char *ply_runtime_described(void);\nint ply_unit_entered(void);\nint main(int argc, char **argv) { (void)argv; if (argc > 1) return ply_unit_entered(); fputs(ply_runtime_described(), stdout); return 0; }\n"

pub const native_flags: List<String> = ["-fvisibility=hidden", "-fno-strict-aliasing"]

pub const definitions_path: String = "program/front"

pub const std_root: String = "std"

pub const compiler_root: String = "compiler"

pub type PackFile = { path: String, bytes: Bytes }

pub fn pack(files: List<PackFile>) -> Bytes = {
  let by_path = files.fold(Map::new(), |accumulator: Map<String, Bytes>, f: PackFile|
    accumulator.insert(f.path, f.bytes));
  let layout = by_path.fold(
    { data: [], table: [], at: 0 },
    |accumulator: { data: List<Bytes>, table: List<Bytes>, at: Int }, path: String, bytes: Bytes|
      {
        data: accumulator.data.push(bytes),
        table: accumulator.table.push(
          Bytes::concat_all([
            u32_le(Bytes::of_string(path).len()),
            Bytes::of_string(path),
            u64_le(accumulator.at),
            u64_le(bytes.len()),
            blake3(bytes),
          ]),
        ),
        at: accumulator.at + bytes.len(),
      },
  );
  let table = u32_le(by_path.len()).concat(Bytes::concat_all(layout.table));
  Bytes::concat_all([
    Bytes::concat_all(layout.data),
    table,
    u64_le(layout.at + table.len()),
    u64_le(table.len()),
    b"PLYPACK1",
  ])
}

test "a pack holds the file contents in path order, then a table of entries, then two lengths and the `PLYPACK1` marker" {
  let b = pack([{ path: "b", bytes: b"22" }, { path: "a", bytes: b"1" }]);
  assert_eq(b.slice(0, 3), b"122");
  let table_len = 4 + (4 + 1 + 8 + 8 + 32) * 2;
  assert_eq(b.len(), 3 + table_len + 8 + 8 + 8);
  assert_eq(b.slice(b.len() - 8, b.len()), b"PLYPACK1");
  assert_eq(b.slice(b.len() - 16, b.len() - 8), u64_le(table_len));
  assert_eq(b.slice(b.len() - 24, b.len() - 16), u64_le(3 + table_len))
}
