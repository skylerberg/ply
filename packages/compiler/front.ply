  [
    {
      name: b"m",
      source_text: b"effect log { write emit(Bytes) -> Unit }\ntype Shape = | Dot | Line(Int)\nfn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\ntest \"says\" { say(b\"x\") }",
    },
  ]

pub const faceted: List<Source> =
  [
    {
      name: b"base",
      source_text: b"pub effect tick { write beat() -> Unit }\npub type Shape = | Dot | Line(Int)\nfn shown(s: Shape) -> String = match s { Dot -> \"dot\", Line(n) -> \"line\" }\nshow for Shape by shown\npub opaque type Coin = new { cents: Int }\npub fn coin(n: Int) -> Coin = { cents: n }\npub fn cents(c: Coin) -> Int = c.cents\npub fn even(n: Int) -> Bool / { tick.write } = if n <= 0 { true } else { tick.beat(); odd(n - 1) }\nfn odd(n: Int) -> Bool / { tick.write } = if n <= 0 { false } else { even(n - 1) }\npub fn half(n: Int) -> Int requires n >= 0 ensures result <= n = n / 2\npub const seven: Int = 7\npub fn literal(text: String) -> Result<Int, { message: String, offset: Int }> = Ok(1)\npub fn magnitude<a>(n: a) -> a where numeric(a) = { let zero: a = numeric_of_int(0); if n < zero { zero - n } else { n } }\nlaw \"halving shrinks\" forall (n: Int) where n >= 0 { half(n) <= n }\ntest \"two\" { assert_eq(half(4), 2) }\n",
    },
    {
      name: b"app",
      source_text: b"import base\npub fn worth(n: Int) -> Int = base::cents(base::coin(base::half(n))) + base::seven\npub fn tagged() -> Int = base\"one\" + base\"two\" + base::magnitude(0 - 2)\ntest \"worth\" { assert_eq(worth(4), 9) }\ntest \"tags\" { assert_eq(base\"three\", 1) }\ntest \"lines\" { assert(base::Line(1) == base::Line(1)) }\nlaw \"worth is above seven\" forall (n: Int) where n >= 0 { worth(n) >= 7 }\n",
    },
  ]

