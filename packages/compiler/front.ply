fn import_at(imports: List<ImportDeclaration>, name: Bytes) -> Span / {abort.raise} = {
  let found = imports.fold(None, |acc: Option<Span>, declaration: ImportDeclaration|
    match acc {
      Some(_) -> acc,
      None -> if import_module_name(declaration) == name { Some(path_span(declaration)) }
      else { None },
    });
  match found { Some(s) -> s, None -> dummy_span() }
}

fn unknown_shipped(
  m: Int,
  span: Span,
  name: Bytes,
  listed: List<Bytes>,
) -> Diagnostic / {abort.raise} =
  error_at(
    b"E0106",
    m,
    span,
    Bytes::concat_all([b"no module named `", name, b"` ships with this compiler"]),
    b"not found",
    [
      b"the stdlib holds: ".concat(backticked(listed.filter(is_std), b", ")),
      b"`ply std` lists them with the digest this binary was built from",
    ],
  )

fn foreign_import(m: Int, span: Span, importer: Bytes, name: Bytes) -> Diagnostic =
  error_at(
    b"E0505",
    m,
    span,
    Bytes::concat_all([
      b"the shipped module `",
      importer,
      b"` imports `",
      name,
      b"`, which this build does not ship",
    ]),
    b"a stdlib module may import only modules that ship with it",
    [
      b"this is an internal error in the compiler's own sources, not in this program",
      b"please report it with the version of `ply` that produced it",
    ],
  )

type Round = { wanted: Map<Bytes, Bytes>, diagnostics: List<Diagnostic> }

type Wanted = { names: Map<Bytes, Bool>, diagnostics: List<Diagnostic> }

type Importer = { name: Bytes, imports: List<ImportDeclaration> }

fn importer(p: ParsedSource) -> Importer = { name: p.name, imports: p.module.module.imports }

fn wanted(
  users: Int,
  listed: List<Bytes>,
  parsed: List<Importer>,
  required: List<Bytes>,
) -> Wanted / {abort.raise} = {
  let has = listed.fold(Map::new(), |acc: Map<Bytes, Bool>, name: Bytes| acc.insert(name, true));
  let present = parsed.fold(Map::new(), |acc: Map<Bytes, Bool>, p: Importer|
    acc.insert(p.name, true));
  let named: Wanted = {
    names: required.fold(Map::new(), |acc: Map<Bytes, Bool>, name: Bytes|
      if has.contains(name) && !present.contains(name) { acc.insert(name, true) } else { acc }),
    diagnostics: [],
  };
  range(0, parsed.len()).fold(named, |acc: Wanted, i: Int| {
    let p = parsed.get(i);
    let imports = p.imports;
    let ships = i >= users;
    imports.fold(acc, |w: Wanted, declaration: ImportDeclaration| {
      let name = import_module_name(declaration);
      if is_shipped(name) && !present.contains(name) {
        if has.contains(name) { { ..w, names: w.names.insert(name, true) } } else {
          {
            ..w,
            diagnostics: w.diagnostics.push(if ships {
              foreign_import(i, import_at(imports, name), p.name, name)
            } else { unknown_shipped(i, import_at(imports, name), name, listed) }),
          }
        }
      } else if ships && !is_shipped(name) {
        {
          ..w,
          diagnostics: w.diagnostics.push(
            foreign_import(i, import_at(imports, name), p.name, name),
          ),
        }
      } else { w }
    })
  })
}

fn pull_round(
  users: Int,
  shipped: Map<Bytes, Bytes>,
  listed: List<Bytes>,
  parsed: List<ParsedSource>,
  required: List<Bytes>,
) -> Round / {abort.raise} = {
  let w = wanted(users, listed, parsed.map(importer), required);
  w.names.fold(
    { wanted: Map::new(), diagnostics: w.diagnostics },
    |r: Round, name: Bytes, _: Bool|
      match shipped.get(name) {
        Some(src) -> { ..r, wanted: r.wanted.insert(name, src) },
        None -> { ..r, diagnostics: r.diagnostics.push(unread_shipped(name)) },
      },
  )
}

fn unread_shipped(name: Bytes) -> Diagnostic =
  error_at(
    b"E0505",
    0,
    dummy_span(),
    Bytes::concat_all([b"the shipped module `", name, b"` is pulled and was never read"]),
    b"the load read its shipped modules before it knew what it pulls",
    [b"this is Ply's fault, not the program's"],
  )

pub type ShippedData = { name: Bytes, bytes: Bytes }

derive bin for ShippedData

pub type ShippedInputs = {
  read: List<Source>,
  unread: List<Bytes>,
  data: List<ShippedData>,
  asked: List<Bytes>,
  pulls: List<ModuleDependencies>,
}

pub type ModuleDependencies = { name: Bytes, pulls: Dependencies }

pub type Dependencies = { imports: List<ImportDeclaration>, wants: List<ItemEmbeds> }

derive bin for Dependencies

pub fn dependencies_of(source: Source) -> Dependencies / {abort.raise} =
  {
    imports: parse_header_at(0, source).module.module.imports,
    wants: if may_call_embed(source.src) { requests_by_item(parse(source.src).node) } else { [] },
  }

fn home_imports(homes: List<Bytes>) -> List<ImportDeclaration> =
  homes.map(|h: Bytes|
    {
      path: h.split(b".").map(|part: Bytes| { name: part, span: dummy_span() }),
      kind: WholeModule,
      span: dummy_span(),
    })

pub fn shipped_inputs_of_pulled<| e>(
  pulled: List<Bytes>,
  listed: List<Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
  read_data: (Bytes) -> Option<Bytes> / e,
  wanted: (Source) -> ShippedWants / {abort.raise | e},
  required: List<Bytes>,
) -> ShippedInputs / {abort.raise | e} = {
  let reading = |acc: List<Source>, n: Bytes|
    if acc.fold(false, |b: Bool, s: Source| b || s.name == n) { acc }
    else { match read(n) { Some(src) -> acc.push({ name: n, src: src }), None -> acc } };
  let pulled_read = pulled.fold([], reading);
  let wants = pulled_read.fold(Map::new(), |acc: Map<Bytes, ShippedWants>, source: Source|
    acc.insert(source.name, wanted(source)));
  let wants_of = |source: Source|
    match wants.get(source.name) { Some(w) -> w, None -> wanted(source) };
  let found = pulled_read.fold(pulled_read, |acc: List<Source>, source: Source|
    wants_of(source).texts.fold(acc, reading));
  let lookup_or_empty = found.fold(Map::new(), |acc: Map<Bytes, Bool>, s: Source|
    acc.insert(s.name, true));
  {
    read: found,
    unread: listed.filter(|n: Bytes| !lookup_or_empty.contains(n)),
    data: found.fold([], |acc: List<ShippedData>, source: Source|
      wants_of(source).data.fold(acc, |a: List<ShippedData>, name: Bytes|
        if a.fold(false, |b: Bool, d: ShippedData| b || d.name == name) { a } else {
          match read_data(name) { Some(bytes) -> a.push({ name: name, bytes: bytes }), None -> a }
        })),
    asked: required,
    pulls: [],
  }
}

pub fn shipped_inputs_of<| e>(
  user: List<Source>,
  packages: PackageSources,
  listed: List<Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
  read_data: (Bytes) -> Option<Bytes> / e,
  pulled: (Source) -> Dependencies / e,
  required: List<Bytes> = [],
) -> ShippedInputs / {abort.raise | e} = {
  let package_closure = closure(packages, user.map(|s: Source| s.name));
  let read_own = user.concat(
    package_closure.modules.map(|m: { pkg: Int, src: Source }| m.src),
  ).fold(
    { own: [], declared: None },
    |acc: { own: List<ModuleDependencies>, declared: Option<List<HomeNames>> }, source: Source| {
      let p = with_home_imports(source, pulled(source), acc.declared, read);
      { own: acc.own.push({ name: source.name, pulls: p.pulls }), declared: p.declared }
    },
  );
  let own = read_own.own;
  let needed = read_needed(
    own.len(),
    listed,
    read,
    read_data,
    pulled,
    {
      importers: own.map(|m: ModuleDependencies| { name: m.name, imports: m.pulls.imports }),
      found: [],
      data: [],
      tried: Map::new(),
      pulls: [],
      declared: read_own.declared,
    },
    listed.len() + 1,
    required,
  );
  let lookup_or_empty = needed.found.fold(Map::new(), |acc: Map<Bytes, Bool>, s: Source|
    acc.insert(s.name, true));
  {
    read: needed.found,
    unread: listed.filter(|name: Bytes| !lookup_or_empty.contains(name)),
    data: needed.data,
    asked: required,
    pulls: own.concat(needed.pulls),
  }
}

type ReadProgress = {
  importers: List<Importer>,
  found: List<Source>,
  data: List<ShippedData>,
  tried: Map<Bytes, Bool>,
  pulls: List<ModuleDependencies>,
  declared: Option<List<HomeNames>>,
}

fn with_home_imports<| e>(
  source: Source,
  pulls: Dependencies,
  declared: Option<List<HomeNames>>,
  read: (Bytes) -> Option<Bytes> / e,
) -> { pulls: Dependencies, declared: Option<List<HomeNames>> } / {abort.raise | e} =
  if !sees_homes(source.name) { { pulls: pulls, declared: declared } } else {
    let input = start(source.src).input;
    let called = called_names(input);
    let d = if called.len() == 0 { declared }
    else { Some(match declared { Some(d) -> d, None -> homes_declaring(read) }) };
    let homes = match d { Some(x) -> homes_for(called, x), None -> [] };
    {
      pulls: {
        ..pulls,
        imports: pulls.imports.concat(
          home_imports(homes.concat(scheduler_read(source.name, input))),
        ),
      },
      declared: d,
    }
  }

fn read_needed<| e>(
  users: Int,
  listed: List<Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
  read_data: (Bytes) -> Option<Bytes> / e,
  pulled: (Source) -> Dependencies / e,
  x: ReadProgress,
  rounds_left: Int,
  required: List<Bytes>,
) -> ReadProgress / {abort.raise | e} = {
  let names = wanted(users, listed, x.importers, required).names.keys().filter(|name: Bytes|
    !x.tried.contains(name));
  if names.len() == 0 || rounds_left <= 0 { x } else {
    read_needed(
      users,
      listed,
      read,
      read_data,
      pulled,
      names.fold(x, |acc: ReadProgress, name: Bytes| {
        let tried = acc.tried.insert(name, true);
        match read(name) {
          None -> { ..acc, tried: tried },
          Some(src) -> {
            let source = { name: name, src: src };
            let added = with_home_imports(source, pulled(source), acc.declared, read);
            let pulls = added.pulls;
            read_embedded_files(
              listed,
              read,
              read_data,
              {
                ..acc,
                importers: acc.importers.push({ name: name, imports: pulls.imports }),
                found: acc.found.push(source),
                tried: tried,
                pulls: acc.pulls.push({ name: name, pulls: pulls }),
                declared: added.declared,
              },
              name,
              requests_in(pulls.wants),
            )
          },
        }
      }),
      rounds_left - 1,
      required,
    )
  }
}

fn read_embedded_files<| e>(
  listed: List<Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
  read_data: (Bytes) -> Option<Bytes> / e,
  x: ReadProgress,
  module: Bytes,
  wants: List<EmbedRequest>,
) -> ReadProgress / {abort.raise | e} =
  wants.fold(x, |acc: ReadProgress, want: EmbedRequest|
    if want.dir { acc } else {
      match shipped_name(module, want.path) {
        Some(name) -> if acc.tried.contains(name) || !listed.contains(name) { acc } else {
          let tried = acc.tried.insert(name, true);
          match read(name) {
            None -> { ..acc, tried: tried },
            Some(src) -> { ..acc, found: acc.found.push({ name: name, src: src }), tried: tried },
          }
        },
        None -> match shipped_data_name(module, want.path) {
          None -> acc,
          Some(name) -> if acc.tried.contains(name) { acc } else {
            let tried = acc.tried.insert(name, true);
            match read_data(name) {
              None -> { ..acc, tried: tried },
              Some(bytes) ->
                { ..acc, data: acc.data.push({ name: name, bytes: bytes }), tried: tried },
            }
          },
        },
      }
    })

fn shipped_path_parts(module: Bytes, path: Bytes) -> Option<List<Bytes>> =
  if path.starts_with(b"/") { None } else {
    match path.split(b"/").fold(
        Some(module.split(b".").drop_last(1)),
        |inside: Option<List<Bytes>>, part: Bytes|
          match inside {
            None -> None,
            Some(dir) -> if part == b"" || part == b"." { inside }
            else if part == b".." { if dir.len() > 0 { Some(dir.drop_last(1)) } else { None } }
            else if dir.len() == 0 && !shipped_root(part) { None }
            else { Some(dir.push(part)) },
          },
      ) {
      Some(parts) -> if parts.len() < 2 { None } else { Some(parts) },
      None -> None,
    }
  }

fn shipped_root(part: Bytes) -> Bool = is_shipped(part) && part.index_of(b".") == None

fn shipped_name(module: Bytes, path: Bytes) -> Option<Bytes> / {abort.raise} =
  if !path.ends_with(b".ply") { None } else {
    match shipped_path_parts(module, path) {
      Some(parts) -> {
        let named = Bytes::join(parts, b".");
        Some(named.slice(0, named.len() - 4))
      },
      None -> None,
    }
  }

pub fn shipped_data_name(module: Bytes, path: Bytes) -> Option<Bytes> =
  if path.ends_with(b".ply") { None } else {
    match shipped_path_parts(module, path) {
      Some(parts) -> Some(Bytes::join(parts, b"/")),
      None -> None,
    }
  }

fn data_wants(module: Source) -> List<{ want: EmbedRequest, name: Bytes }> / {abort.raise} =
  if !may_call_embed(module.src) { [] } else {
    embed_requests(parse(module.src).node).fold(
      [],
      |acc: List<{ want: EmbedRequest, name: Bytes }>, want: EmbedRequest|
        if want.dir { acc } else {
          match shipped_data_name(module.name, want.path) {
            Some(name) -> acc.push({ want: want, name: name }),
            None -> acc,
          }
        },
    )
  }

pub fn shipped_data_wanted(module: Source) -> List<Bytes> / {abort.raise} =
  data_wants(module).fold([], |acc: List<Bytes>, w: { want: EmbedRequest, name: Bytes }|
    acc.push_unique(w.name))

pub type ShippedWants = { texts: List<Bytes>, data: List<Bytes> }

derive bin for ShippedWants

pub fn shipped_wants(module: Source) -> ShippedWants / {abort.raise} =
  if !may_call_embed(module.src) { { texts: [], data: [] } }
  else { shipped_wants_in(module.name, parse(module.src).node) }

pub fn shipped_wants_of(module: Source, node: Module) -> ShippedWants / {abort.raise} =
  if !may_call_embed(module.src) { { texts: [], data: [] } }
  else { shipped_wants_in(module.name, node) }

fn shipped_wants_in(name: Bytes, node: Module) -> ShippedWants / {abort.raise} =
  embed_requests(node).fold({ texts: [], data: [] }, |acc: ShippedWants, want: EmbedRequest|
    if want.dir { acc } else {
      match shipped_name(name, want.path) {
        Some(n) -> { ..acc, texts: acc.texts.push_unique(n) },
        None -> match shipped_data_name(name, want.path) {
          Some(n) -> { ..acc, data: acc.data.push_unique(n) },
          None -> acc,
        },
      }
    })

pub fn shipped_data_embeds(
  module: Source,
  data: List<ShippedData>,
) -> List<ModuleEmbed> / {abort.raise} = {
  let lookup_or_empty = data_by_name(embed_files_of(data));
  data_wants(module).fold([], |acc: List<ModuleEmbed>, w: { want: EmbedRequest, name: Bytes }|
    match lookup_or_empty.get(w.name) {
      Some(file) ->
        acc.push({
          module: module.name,
          key: embed_key(w.want),
          read: Ok([{ ..file, name: b"" }]),
        }),
      None -> acc,
    })
}

type PullState = {
  parsed: List<ParsedSource>,
  pulled: List<Bytes>,
  embeds: List<ModuleEmbed>,
  diagnostics: List<Diagnostic>,
  cuts: List<StubCuts>,
  unimported: Map<Bytes, List<Bytes>>,
}

fn asked_with(asked: List<Bytes>, unimported: Map<Bytes, List<Bytes>>) -> List<Bytes> =
  unimported.fold(asked, |acc: List<Bytes>, _: Bytes, read: List<Bytes>| acc.concat(read))

fn with_hidden_imports(p: ParsedSource, dependencies: Option<Dependencies>) -> ParsedSource =
  match dependencies {
    None -> p,
    Some(t) -> {
      let have = p.module.module.imports.fold(
        Map::new(),
        |acc: Map<Bytes, Bool>, d: ImportDeclaration|
          match d.kind { ModuleAlias(a) -> acc.insert(a.name, true), _ -> acc },
      );
      let more = t.imports.filter(|d: ImportDeclaration|
        match d.kind {
          ModuleAlias(a) -> is_hidden_binder(a.name) && !have.contains(a.name),
          _ -> false,
        });
      if more.len() == 0 { p } else {
        {
          ..p,
          module: {
            ..p.module,
            module: { ..p.module.module, imports: p.module.module.imports.concat(more) },
          },
        }
      }
    },
  }

fn pull_rounds(
  users: Int,
  shipped: Map<Bytes, Bytes>,
  whole: Map<Bytes, Bytes>,
  dependencies: Map<Bytes, Dependencies>,
  data: Map<Bytes, EmbedFile>,
  listed: List<Bytes>,
  tested: Bool,
  x: PullState,
  rounds_left: Int,
  required: List<Bytes>,
  declared: List<HomeNames>,
  given: List<ParsedSource>,
  derived: List<ModuleDerivations>,
) -> PullState / {abort.raise} = {
  let early = x.parsed.fold([], |acc: List<Diagnostic>, parsed: ParsedSource|
    acc.concat(parsed.diagnostics));
  if early.len() > 0 { { ..x, diagnostics: early } } else {
    let r = pull_round(users, shipped, listed, x.parsed, required);
    if r.diagnostics.len() > 0 { { ..x, diagnostics: r.diagnostics } }
    else if r.wanted.len() == 0 { x }
    else if rounds_left <= 0 { panic("a shipped module pulled twice") } else {
      let read = unimported_read(
        r.wanted.fold([], |acc: List<Source>, name: Bytes, src: Bytes|
          acc.push({ name: name, src: src })),
        declared,
      );
      let round = r.wanted.fold(x, |acc: PullState, name: Bytes, src: Bytes| {
        let at = acc.parsed.len();
        let o = shipped_embedded(
          whole,
          dependencies,
          data,
          at,
          parsed_at(given, derived, at, { name: name, src: src }),
        );
        {
          ..acc,
          parsed: acc.parsed.push(if tested { o.parsed } else { untested(o.parsed) }),
          cuts: if tested { acc.cuts }
          else { acc.cuts.push({ name: o.parsed.name, cuts: cuts_of(o.parsed.module) }) },
          pulled: acc.pulled.push(name),
          embeds: acc.embeds.concat(o.embeds),
        }
      });
      pull_rounds(
        users,
        shipped,
        whole,
        dependencies,
        data,
        listed,
        tested,
        {
          ..round,
          unimported: read.fold(
            round.unimported,
            |acc: Map<Bytes, List<Bytes>>, name: Bytes, reads: List<Bytes>| acc.insert(name, reads),
          ),
        },
        rounds_left - 1,
        asked_with(required, read),
        declared,
        given,
        derived,
      )
    }
  }
}

fn parsed_at(
  given: List<ParsedSource>,
  derived: List<ModuleDerivations>,
  index: Int,
  source: Source,
) -> ParsedSource / {abort.raise} =
  match given.find(|g: ParsedSource| g.name == source.name && g.src == source.src) {
    Some(g) -> { ..g, diagnostics: g.diagnostics.map(|d: Diagnostic| moved_to(d, index)) },
    None ->
      parse_from(
        index,
        source,
        parse(source.src),
        derivations: match derived.find(|m: ModuleDerivations| m.module == source.name) {
          Some(m) -> m.derivations,
          None -> [],
        },
      ),
  }

fn moved_to(d: Diagnostic, index: Int) -> Diagnostic =
  {
    ..d,
    labels: d.labels.map(|l: Label| if l.module == 0 { { ..l, module: index } } else { l }),
    fixes: d.fixes.map(|f: Fix|
      {
        ..f,
        edits: f.edits.map(|e: Edit| if e.module == 0 { { ..e, module: index } } else { e }),
      }),
  }

type ShippedFile = | ShippedModuleText(Bytes) | ShippedDataFile(Bytes)

fn shipped_file_at(
  module: Bytes,
  want: EmbedRequest,
) -> Result<ShippedFile, Bytes> / {abort.raise} =
  if want.dir { Err(b"a shipped module embeds a file the shipped modules hold, never a directory") }
  else {
    match shipped_name(module, want.path) {
      Some(name) -> Ok(ShippedModuleText(name)),
      None -> match shipped_data_name(module, want.path) {
        Some(name) -> Ok(ShippedDataFile(name)),
        None ->
          Err(Bytes::concat_all([b"`", want.path, b"` names nothing shipped modules could hold"])),
      },
    }
  }

fn not_shipped(want: EmbedRequest) -> Bytes =
  Bytes::concat_all([b"`", want.path, b"` is not among what the shipped modules hold"])

fn shipped_read(
  whole: Map<Bytes, Bytes>,
  data: Map<Bytes, EmbedFile>,
  module: Bytes,
  want: EmbedRequest,
) -> EmbedResult / {abort.raise} =
  match shipped_file_at(module, want) {
    Err(why) -> Err(why),
    Ok(ShippedModuleText(name)) -> match whole.get(name) {
      Some(text) -> Ok([embed_file(b"", text)]),
      None -> Err(not_shipped(want)),
    },
    Ok(ShippedDataFile(name)) -> match data.get(name) {
      Some(file) -> Ok([{ ..file, name: b"" }]),
      None -> Err(not_shipped(want)),
    },
  }

pub fn shipped_bytes<| e>(
  module: Bytes,
  key: Bytes,
  text: (Bytes) -> Option<Bytes> / {abort.raise | e},
  data: (Bytes) -> Option<Bytes> / {abort.raise | e},
) -> EmbedBytesResult / {abort.raise | e} = {
  let want = request_of_key(key);
  match shipped_file_at(module, want) {
    Err(why) -> Err(why),
    Ok(at) -> {
      let lookup_or_empty = match at {
        ShippedModuleText(name) -> text(name),
        ShippedDataFile(name) -> data(name),
      };
      match lookup_or_empty {
        Some(bytes) -> Ok([{ name: b"", bytes: bytes }]),
        None -> Err(not_shipped(want)),
      }
    },
  }
}

fn embed_files_of(data: List<ShippedData>) -> List<EmbedFile> =
  data.map(|d: ShippedData| embed_file(d.name, d.bytes))

fn data_by_name(data: List<EmbedFile>) -> Map<Bytes, EmbedFile> =
  data.fold(Map::new(), |acc: Map<Bytes, EmbedFile>, d: EmbedFile| acc.insert(d.name, d))

fn shipped_embedded(
  whole: Map<Bytes, Bytes>,
  dependencies: Map<Bytes, Dependencies>,
  data: Map<Bytes, EmbedFile>,
  index: Int,
  parsed: ParsedSource,
) -> { parsed: ParsedSource, embeds: List<ModuleEmbed> } / {abort.raise} = {
  let source = { name: parsed.name, src: parsed.src };
  let text = match whole.get(source.name) { Some(t) -> t, None -> source.src };
  let read = if text == source.src { parsed }
  else { with_hidden_imports(parsed, dependencies.get(source.name)) };
  let p = { ..read, src: text };
  if !may_call_embed(text) { { parsed: p, embeds: [] } } else {
    let wants = if text == source.src { embed_requests(p.module.module) } else {
      match dependencies.get(source.name) {
        Some(t) -> requests_in(t.wants),
        None -> embed_requests(parse(text).node),
      }
    };
    let table = wants.fold(Map::new(), |acc: Map<Bytes, EmbedResult>, want: EmbedRequest|
      acc.insert(embed_key(want), shipped_read(whole, data, source.name, want)));
    let r = inline_embeds(p.module.module, table, []);
    {
      parsed: {
        ..p,
        module: { ..p.module, module: r.module },
        diagnostics: p.diagnostics.concat(
          r.diagnostics.map(|diagnostic: ParseDiagnostic| diagnostic_in_module(index, diagnostic)),
        ),
      },
      embeds: table.fold([], |acc: List<ModuleEmbed>, key: Bytes, read: EmbedResult|
        acc.push({ module: source.name, key: key, read: read })),
    }
  }
}

pub fn parse_shipped(
  modules: List<Source>,
  shipped: List<Source>,
  data: List<ShippedData>,
) -> List<ParsedSource> / {abort.raise} = {
  let whole = shipped.fold(Map::new(), |acc: Map<Bytes, Bytes>, s: Source|
    acc.insert(s.name, s.src));
  let lookup_or_empty = data_by_name(embed_files_of(data));
  range(0, modules.len()).map(|i: Int|
    shipped_embedded(whole, Map::new(), lookup_or_empty, i, parse_at(i, modules.get(i))).parsed)
}

pub type PulledAnalysis = {
  pulled: List<Bytes>,
  out: AnalysisOutcome,
  shipped_views: List<ShippedView>,
}

pub fn analyse_pulling_std(
  user: List<Source>,
  shipped: List<Source>,
) -> PulledAnalysis / {abort.raise} = analyse_pulling_std_with(user, shipped, no_rows())

pub type StagedLoad = {
  pulled: List<Bytes>,
  hashed: Result<HashedProgram, List<Diagnostic>>,
  shipped_views: List<ShippedView>,
}

pub fn viewed_text(viewed: List<ShippedView>) -> Bytes = {
  let line = |parts: List<Bytes>|
    parts.fold(b"", |acc: Bytes, part: Bytes|
      if acc.len() == 0 { part } else { Bytes::concat_all([acc, b"\t", part]) }).concat(
      b"\n",
    );
  Bytes::concat_all(
    viewed.fold([], |acc: List<Bytes>, v: ShippedView|
      v.definitions.fold(
        acc.push(line([b"shipform", v.module, v.text, v.form])),
        |a: List<Bytes>, d: { name: Bytes, hash: Bytes }|
          a.push(line([b"shipdef", v.module, d.name, d.hash])),
      )),
  )
}

type PulledLoad = {
  pulled: PullState,
  package_closure: Closure,
  tree: ToolchainTree,
  embeds_at: List<ModuleEmbed>,
  items: Map<Bytes, List<ItemEmbeds>>,
}

fn pulled_load(
  user: List<Source>,
  shipped: List<Source>,
  packages: PackageSources,
  embeds: List<EmbedRecord>,
  tested: Bool,
  unread: List<Bytes>,
  data: List<EmbedFile>,
  required: List<Bytes>,
  apart: Bool,
  pulls: List<ModuleDependencies>,
  given: List<ParsedSource>,
  derived: List<ModuleDerivations>,
  judged: Option<JudgedPackages>,
) -> PulledLoad / {abort.raise} = {
  let package_closure = match judged {
    Some(j) -> closure_of_judged(j, packages.supplied),
    None -> closure(packages, user.map(|s: Source| s.name)),
  };
  let dependencies = pulls.fold(
    Map::new(),
    |acc: Map<Bytes, Dependencies>, m: ModuleDependencies| acc.insert(m.name, m.pulls),
  );
  let lookup_or_empty = if unread.contains(prelude_module()) { shipped }
  else { with_prelude_source(shipped) };
  let texts = lookup_or_empty.fold(Map::new(), |acc: Map<Bytes, Bytes>, s: Source|
    acc.insert(s.name, s.src));
  let sources = user.concat(package_closure.modules.map(|m: { pkg: Int, src: Source }| m.src));
  let declared = homes_declaring(|h: Bytes| texts.get(h));
  let unimported = unimported_read(sources, declared);
  let read = range(0, sources.len()).fold(
    { parsed: [], cuts: [] },
    |acc: { parsed: List<ParsedSource>, cuts: List<StubCuts> }, i: Int| {
      let p = parsed_at(given, derived, i, sources.get(i));
      if tested { { ..acc, parsed: acc.parsed.push(p) } } else {
        {
          parsed: acc.parsed.push(untested(p)),
          cuts: acc.cuts.push({ name: p.name, cuts: cuts_of(p.module) }),
        }
      }
    },
  );
  let parsed = read.parsed;
  let items = range(0, sources.len()).fold(
    pulls.fold(Map::new(), |acc: Map<Bytes, List<ItemEmbeds>>, m: ModuleDependencies|
      if m.pulls.wants.len() == 0 { acc } else { acc.insert(m.name, m.pulls.wants) }),
    |acc: Map<Bytes, List<ItemEmbeds>>, i: Int| {
      let s = sources.get(i);
      if !tested || acc.contains(s.name) || !may_call_embed(s.src) { acc }
      else { acc.insert(s.name, requests_by_item(parsed.get(i).module.module)) }
    },
  );
  let mentions = user.map(|s: Source| may_call_embed(s.src)).concat(
    package_closure.modules.map(|m: { pkg: Int, src: Source }| may_call_embed(m.src.src)),
  );
  let written = embedded_all(parsed, embed_slots(packages, user), mentions, embeds);
  let assembled = written.parsed;
  let named = shipped.map(|s: Source| s.name).concat(unread);
  let listed = named.concat(lookup_or_empty.drop(shipped.len()).map(|s: Source| s.name));
  let rooted = user.map(|u: Source| u.name);
  let tree = if apart { tree_named(rooted) } else { toolchain_tree(rooted, named) };
  let x = pull_rounds(
    assembled.len(),
    texts,
    texts,
    dependencies,
    data_by_name(data),
    listed,
    tested,
    {
      parsed: assembled,
      pulled: [],
      embeds: [],
      cuts: read.cuts,
      diagnostics: [],
      unimported: unimported,
    },
    texts.len(),
    asked_with(required, unimported),
    declared,
    given,
    derived,
  );
  { pulled: x, package_closure: package_closure, tree: tree, embeds_at: written.at, items: items }
}

pub fn staged_pulling_std_with(
  user: List<Source>,
  shipped: List<Source>,
  packages: PackageSources = { root: b"", manifest: None, supplied: [] },
  fixed: CachedHashes = { nodes: [], tests: [], laws: [] },
  embeds: List<EmbedRecord> = [],
  tested: Bool = true,
  unread: List<Bytes> = [],
  reached: Bool = true,
  data: List<EmbedFile> = [],
  required: List<Bytes> = [],
  apart: Bool = false,
  pulls: List<ModuleDependencies> = [],
  given: List<ParsedSource> = [],
  derived: List<ModuleDerivations> = [],
  judged: Option<JudgedPackages> = None,
  checked: Option<Bytes> = None,
) -> StagedLoad / {abort.raise} = {
  let load = pulled_load(
    user,
    shipped,
    packages,
    embeds,
    tested,
    unread,
    data,
    required,
    apart,
    pulls,
    given,
    derived,
    judged,
  );
  let x = load.pulled;
  let hashed = |parsed: List<ParsedSource>|
    match hashed_closure(
        parsed,
        load.package_closure,
        user.len(),
        load.tree,
        x.unimported,
        fixed,
        load.embeds_at.concat(x.embeds),
        x.cuts,
        checked,
      ) {
      Err(diagnostics) -> Err(diagnostics),
      Ok(h) -> Ok({ ..h, embed_items: load.items }),
    };
  if x.diagnostics.len() > 0 { { pulled: x.pulled, hashed: Err(x.diagnostics), shipped_views: [] } }
  else if !reached || x.pulled.len() == 0 {
    { pulled: x.pulled, hashed: hashed(x.parsed), shipped_views: [] }
  } else {
    match hashed(x.parsed) {
      Err(diagnostics) -> { pulled: x.pulled, hashed: Err(diagnostics), shipped_views: [] },
      Ok(h) -> {
        let reach = reached_shipped_functions(h);
        {
          pulled: x.pulled,
          hashed: match cut_to_reach(x.parsed, h, reach) {
            None -> Ok(h),
            Some(cut) -> hashed(cut),
          },
          shipped_views: shipped_views_of(h, |name: Bytes| reach.contains(name)),
        }
      },
    }
  }
}

pub fn resolved_pulling_std_with(
  user: List<Source>,
  shipped: List<Source>,
  packages: PackageSources,
  embeds: List<EmbedRecord>,
  unread: List<Bytes>,
  data: List<ShippedData>,
  required: List<Bytes>,
  pulls: List<ModuleDependencies>,
  given: List<ParsedSource>,
) -> Result<ResolvedProgram, { diagnostics: List<Diagnostic>, modules: List<Source> }> / {abort.raise} = {
  let load = pulled_load(
    user,
    shipped,
    packages,
    embeds,
    true,
    unread,
    embed_files_of(data),
    required,
    false,
    pulls,
    given,
    [],
    None,
  );
  let modules = load.pulled.parsed.map(|p: ParsedSource| { name: p.name, src: p.src });
  if load.pulled.diagnostics.len() > 0 {
    Err({ diagnostics: load.pulled.diagnostics, modules: modules })
  } else {
    match resolved_closure(load.pulled.parsed, load.package_closure, user.len(), load.tree) {
      Err(diagnostics) -> Err({ diagnostics: diagnostics, modules: modules }),
      Ok(resolved) -> Ok(resolved.program),
    }
  }
}

fn first_shipped_slot(h: HashedProgram) -> Int = h.root_count + h.closure.modules.len()

fn shipped_functions(h: HashedProgram) -> Map<Bytes, Bool> / {abort.raise} =
  range(first_shipped_slot(h), h.modules.len()).fold(Map::new(), |acc: Map<Bytes, Bool>, i: Int| {
    let m = h.modules.get(i);
    m.module.items.fold(acc, |a: Map<Bytes, Bool>, item: Item|
      match item { FunctionItem(d) -> a.insert(qualify(m.name, d.name.name), true), _ -> a })
  })

fn reached_shipped_functions(h: HashedProgram) -> Map<Bytes, Bool> / {abort.raise} = {
  let first = first_shipped_slot(h);
  let candidates = shipped_functions(h);
  let imported = range(0, first).fold([], |acc: List<Subject>, i: Int|
    h.modules.get(i).module.imports.fold(acc, |a: List<Subject>, d: ImportDeclaration|
      match d.kind {
        SelectedNames(names) -> {
          let module = Bytes::join(d.path.map(|part: Identifier| part.name), b".");
          names.fold(a, |b: List<Subject>, n: Identifier| {
            let name = qualify(module, n.name);
            if h.hashes.refs.declared.contains(name) { b } else { b.push(FunctionNamed(name)) }
          })
        },
        _ -> a,
      }));
  let stated = range(first, h.modules.len()).fold([], |acc: List<Subject>, i: Int| {
    let m = h.modules.get(i);
    m.module.items.fold(acc, |a: List<Subject>, item: Item|
      match item {
        TypeItem(t) -> a.push(DeclarationNamed(qualify(m.name, t.name.name))),
        EffectItem(e) -> a.push(DeclarationNamed(qualify(m.name, e.name.name))),
        _ -> match target_type(item) {
          Some(target) -> a.push(DeclarationNamed(qualify(m.name, target.name))),
          None -> a,
        },
      })
  });
  reached_functions(
    h.hashes,
    h.index.nodes.fold(
      h.hashes.definitions.fold([], |acc: List<Subject>, d: { name: Bytes, hash: Bytes }|
        if candidates.contains(d.name) { acc } else { acc.push(FunctionNamed(d.name)) }),
      |acc: List<Subject>, n: Node|
        match n.body {
          NodeFn(_) -> acc,
          _ -> if n.module < first { acc.push(DeclarationNamed(n.name)) } else { acc },
        },
    ).concat(
      h.index.tests.filter(|t: TestNode| t.module < first).map(|t: TestNode|
        ItemKeyed(t.key)).concat(
        h.index.laws.filter(|l: LawNode| l.module < first).map(|l: LawNode| ItemKeyed(l.key)),
      ),
    ).concat(
      imported.concat(stated),
    ),
  )
}

fn cut_to_reach(
  parsed: List<ParsedSource>,
  h: HashedProgram,
  reach: Map<Bytes, Bool>,
) -> Option<List<ParsedSource>> / {abort.raise} = {
  let first = first_shipped_slot(h);
  let candidates = shipped_functions(h);
  let wanted = |name: Bytes| !candidates.contains(name) || reach.contains(name);
  let declared = h.index.nodes.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Node|
    match n.body { NodeFn(_) -> acc, _ -> acc.insert(n.name, true) });
  let kept = |p: ParsedSource, item: Item|
    match item {
      FunctionItem(d) -> wanted(qualify(p.name, d.name.name)),
      TestItem(_) -> false,
      LawItem(_) -> false,
      _ -> true,
    };
  let imports = |p: ParsedSource|
    p.module.module.imports.map(|d: ImportDeclaration|
      match d.kind {
        SelectedNames(names) -> {
          let module = import_module_name(d);
          {
            ..d,
            kind: SelectedNames(
              names.filter(|n: Identifier| {
                let name = qualify(module, n.name);
                wanted(name) || declared.contains(name)
              }),
            ),
          }
        },
        _ -> d,
      });
  let cut = range(first, parsed.len()).fold(false, |acc: Bool, i: Int| {
    let p = parsed.get(i);
    acc || p.module.module.items.fold(false, |b: Bool, item: Item| b || !kept(p, item))
      || imports(p) != p.module.module.imports
  });
  if !cut { None } else {
    Some(
      range(0, parsed.len()).map(|i: Int| {
        let p = parsed.get(i);
        if i < first { p } else {
          {
            ..p,
            module: {
              ..p.module,
              module: {
                ..p.module.module,
                imports: imports(p),
                items: p.module.module.items.filter(|item: Item| kept(p, item)),
              },
            },
          }
        }
      }),
    )
  }
}

fn shipped_views_of(h: HashedProgram, read: (Bytes) -> Bool) -> List<ShippedView> / {abort.raise} = {
  let first = first_shipped_slot(h);
  let candidates = shipped_functions(h);
  let definitions = h.hashes.definitions.fold(
    Map::new(),
    |acc: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }| acc.insert(d.name, d.hash),
  );
  let declarations = h.hashes.declarations.fold(
    Map::new(),
    |acc: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }| acc.insert(d.name, d.hash),
  );
  let nodes = h.index.nodes.fold(Map::new(), |acc: Map<Int, List<Node>>, n: Node|
    if n.module < first { acc } else {
      acc.insert(n.module, List::push(match acc.get(n.module) { Some(ns) -> ns, None -> [] }, n))
    });
  range(first, h.modules.len()).map(|i: Int| {
    let m = h.modules.get(i);
    let own = match nodes.get(i) { Some(ns) -> ns, None -> [] };
    let hash_of = |table: Map<Bytes, Bytes>, name: Bytes|
      match table.get(name) { Some(hash) -> hash, None -> b"" };
    let shape = own.fold([], |acc: List<Bytes>, n: Node|
      match n.body {
        NodeFn(_) -> if candidates.contains(n.name) { acc }
        else { acc.push(b"derived ".concat(n.name)) },
        _ ->
          acc.push(Bytes::concat_all([b"declared ", n.name, b" ", hash_of(declarations, n.name)])),
      }).concat(
      m.module.imports.map(|d: ImportDeclaration| b"imports ".concat(import_module_name(d))),
    ).concat(
      m.module.items.fold([], |acc: List<Bytes>, item: Item|
        match item { EffectSetItem(_) -> acc.push(b"set ".concat(dump_item(item))), _ -> acc }),
    );
    {
      module: m.name,
      text: hex(blake3(h.texts.get(i))),
      form: hex(blake3(Bytes::join(shape, b"\n"))),
      definitions: own.fold([], |acc: List<{ name: Bytes, hash: Bytes }>, n: Node|
        match n.body {
          NodeFn(_) -> if read(n.name) {
            acc.push({ name: n.name, hash: hex(hash_of(definitions, n.name)) })
          } else { acc },
          _ -> acc,
        }),
    }
  })
}

pub fn shipped_viewer(modules: List<Bytes>) -> Source =
  {
    name: b"viewer",
    src: Bytes::concat_all(modules.map(|m: Bytes| Bytes::concat_all([b"import ", m, b"\n"]))),
  }

pub fn shipped_views(
  modules: List<Bytes>,
  shipped: List<Source>,
  unread: List<Bytes> = [],
  data: List<ShippedData> = [],
) -> Result<List<ShippedView>, List<Diagnostic>> / {abort.raise} =
  match staged_pulling_std_with(
      [shipped_viewer(modules)],
      shipped,
      tested: false,
      unread: unread,
      reached: false,
      data: embed_files_of(data),
    ).hashed {
    Err(diagnostics) -> Err(diagnostics),
    Ok(h) -> Ok(shipped_views_of(h, |name: Bytes| true)),
  }

pub fn checked_staged(
  staged: StagedLoad,
  rows: Rows,
  walks: BodyChecking = CheckEvery,
) -> PulledAnalysis / {abort.raise} =
  {
    pulled: staged.pulled,
    out: match staged.hashed {
      Err(diagnostics) -> Refused(diagnostics),
      Ok(h) -> checked_closure(h, rows, walks),
    },
    shipped_views: staged.shipped_views,
  }

pub fn analyse_pulling_std_with(
  user: List<Source>,
  shipped: List<Source>,
  rows: Rows,
  packages: PackageSources = { root: b"", manifest: None, supplied: [] },
  embeds: List<EmbedRecord> = [],
  unread: List<Bytes> = [],
  reached: Bool = true,
  data: List<ShippedData> = [],
  required: List<Bytes> = [],
  pulls: List<ModuleDependencies> = [],
  fixed: CachedHashes = { nodes: [], tests: [], laws: [] },
  derived: List<ModuleDerivations> = [],
) -> PulledAnalysis / {abort.raise} =
  checked_staged(
    staged_pulling_std_with(
      user,
      shipped,
      packages,
      fixed,
      embeds: embeds,
      unread: unread,
      reached: reached,
      data: embed_files_of(data),
      required: required,
      pulls: pulls,
      derived: derived,
    ),
    rows,
  )

fn is_module_level_item(item: Item) -> Bool =
  match item {
    EffectSetItem(_) -> true,
    DeriveItem(_) -> true,
    InstanceItem(_) -> true,
    NumericItem(_) -> true,
    SchemaItem(_) -> true,
    _ -> false,
  }

pub fn module_form_digest(module: Module, text: Bytes) -> Bytes / {abort.raise} = {
  let written = module.imports.filter(|d: ImportDeclaration|
    match d.kind { ModuleAlias(a) -> !is_hidden_binder(a.name), _ -> true });
  let imports = written.map(|d: ImportDeclaration|
    Bytes::concat_all([
      b"import ",
      Bytes::join(d.path.map(|part: Identifier| part.name), b"."),
      match d.kind {
        WholeModule -> b"",
        ModuleAlias(a) -> b" as ".concat(a.name),
        SelectedNames(ns) ->
          Bytes::concat_all([b" (", Bytes::join(ns.map(|n: Identifier| n.name), b","), b")"]),
      },
    ]));
  let items = module.items.fold([], |acc: List<Bytes>, item: Item|
    if !is_module_level_item(item) { acc } else {
      let at = item_span(item);
      if at.start < 0 || at.end > text.len() || at.start > at.end { acc.push(b"?") }
      else { acc.push(text.slice(at.start, at.end)) }
    });
  hex(
    blake3(
      Bytes::join(
        imports.sort_by(|a: Bytes, b: Bytes|
          match compare_values(a, b) { Greater -> false, _ -> true }).concat(
          items,
        ),
        b"\n",
      ),
    ),
  )
}

pub fn pins_of_load(
  user: List<Source>,
  packages: PackageSources,
  embeds: List<EmbedRecord>,
) -> Result<List<LockedPackage>, List<Diagnostic>> / {abort.raise} = {
  let package_closure = closure(packages, user.map(|source: Source| source.name));
  let sources = user.concat(package_closure.modules.map(|m: { pkg: Int, src: Source }| m.src));
  if package_closure.diagnostics.len() > 0 {
    Err(
      package_closure.diagnostics.map(|sd: { slot: Int, diagnostic: ParseDiagnostic }|
        if sd.slot < 0 { diagnostic_in_module(0 - sd.slot - 1, sd.diagnostic) }
        else { diagnostic_in_module(sources.len() + sd.slot, sd.diagnostic) }),
    )
  } else {
    let slots = embed_slots(packages, user);
    let tables = embed_reads(embeds);
    let read = range(0, sources.len()).fold([], |acc: List<ModuleEmbed>, i: Int| {
      let source = sources.get(i);
      match slots.at(i) {
        Some(slot) -> if !may_call_embed(source.src) { acc } else {
          match tables.get(slot) {
            Some(table) ->
              table.fold(acc, |a: List<ModuleEmbed>, key: Bytes, read: EmbedResult|
                a.push({ module: source.name, key: key, read: read })),
            None -> acc,
          }
        },
        None -> acc,
      }
    });
    Ok(pins_of(package_closure, read))
  }
}

pub type EmbedRecord = { root: Bytes, module: Bytes, want: EmbedRequest, read: EmbedResult }

derive bin for EmbedRecord

pub fn may_call_embed(src: Bytes) -> Bool / {abort.raise} = calls_embed_from(src, 0)

fn calls_embed_from(src: Bytes, from: Int) -> Bool / {abort.raise} =
  iterate(from, src.len() + 2, |at: Int|
    match src.index_of_from(b"embed", at) {
      None -> Stop(false),
      Some(i) -> {
        let whole = (i == 0 || !is_identifier_continue(src.at(i - 1)))
          && !(i >= 7 && src.slice(i - 7, i) == b"import ");
        let end = if i + 9 < src.len() { i + 9 } else { src.len() };
        let named = if src.slice(i + 5, end) == b"_dir" { i + 9 } else { i + 5 };
        let next = past_spaces(src, named);
        if whole && next < src.len() && (src.at(next) == 40 || src.at(next) == 47) { Stop(true) }
        else { Continue(i + 5) }
      },
    })

fn past_spaces(src: Bytes, at: Int) -> Int / {abort.raise} =
  if at < src.len()
      && (src.at(at) == 32 || src.at(at) == 9 || src.at(at) == 10 || src.at(at) == 13) {
    past_spaces(src, at + 1)
  } else { at }

pub fn embed_inputs_of<| e>(
  embeds: List<ModuleEmbed>,
  read: (ModuleEmbed) -> EmbedBytesResult / {abort.raise | e},
) -> Result<Map<Bytes, Bytes>, List<Diagnostic>> / {abort.raise | e} = {
  let lookup_or_empty = embeds.fold(
    { inputs: Map::new(), moved: [] },
    |acc: { inputs: Map<Bytes, Bytes>, moved: List<ModuleEmbed> }, embed: ModuleEmbed|
      match embed.read {
        Err(_) -> acc,
        Ok(was) -> match read(embed) {
          Err(_) -> { ..acc, moved: acc.moved.push(embed) },
          Ok(files) -> {
            let now = files.map(|f: EmbedBytes| embed_file(f.name, f.bytes));
            if now != was { { ..acc, moved: acc.moved.push(embed) } } else {
              {
                ..acc,
                inputs: range(0, files.len()).fold(acc.inputs, |m: Map<Bytes, Bytes>, i: Int|
                  m.insert(now.get(i).digest, files.get(i).bytes)),
              }
            }
          },
        },
      },
  );
  if lookup_or_empty.moved.len() == 0 { Ok(lookup_or_empty.inputs) }
  else { Err(lookup_or_empty.moved.map(changed_embed_error)) }
}

fn changed_embed_error(embed: ModuleEmbed) -> Diagnostic / {abort.raise} =
  error_at(
    b"E0146",
    no_module(),
    dummy_span(),
    Bytes::concat_all([
      b"`",
      request_of_key(embed.key).path,
      b"`, which `",
      embed.module,
      b"` embeds, could not be embedded",
    ]),
    b"it reads otherwise now than when the program was checked",
    [b"a file an embed reads changed while the program was loaded; run again"],
  )

pub fn embeds_wanted(root: Bytes, sources: List<Source>) -> List<EmbedRecord> / {abort.raise} =
  sources.fold([], |acc: List<EmbedRecord>, source: Source|
    if !may_call_embed(source.src) { acc }
    else { acc.concat(module_embeds_wanted(root, source, parse(source.src).node)) })

pub fn module_embeds_wanted(
  root: Bytes,
  source: Source,
  raw: Module,
) -> List<EmbedRecord> / {abort.raise} =
  if !may_call_embed(source.src) { [] } else {
    embed_requests(raw).map(|want: EmbedRequest|
      { root: root, module: source.name, want: want, read: Err(b"not read yet") })
  }

pub fn embed_slot(root: Bytes, module: Bytes) -> Bytes = Bytes::concat_all([root, b"\x00", module])

fn embed_slots(packages: PackageSources, user: List<Source>) -> List<Bytes> =
  packages.supplied.fold(
    user.map(|source: Source| embed_slot(packages.root, source.name)),
    |acc: List<Bytes>, supplied: SuppliedPackage|
      supplied.modules.fold(acc, |a: List<Bytes>, source: Source|
        a.push(embed_slot(supplied.root, source.name))),
  )

fn embed_reads(embeds: List<EmbedRecord>) -> Map<Bytes, Map<Bytes, EmbedResult>> =
  embeds.fold(Map::new(), |acc: Map<Bytes, Map<Bytes, EmbedResult>>, embed: EmbedRecord| {
    let slot = embed_slot(embed.root, embed.module);
    let was = match acc.get(slot) { Some(t) -> t, None -> Map::new() };
    acc.insert(slot, was.insert(embed_key(embed.want), embed.read))
  })

fn embedded_all(
  parsed: List<ParsedSource>,
  slots: List<Bytes>,
  mentions: List<Bool>,
  embeds: List<EmbedRecord>,
) -> { parsed: List<ParsedSource>, at: List<ModuleEmbed> } / {abort.raise} = {
  let tables = embed_reads(embeds);
  range(0, parsed.len()).fold(
    { parsed: [], at: [] },
    |acc: { parsed: List<ParsedSource>, at: List<ModuleEmbed> }, i: Int| {
      let p = parsed.get(i);
      match ((slots.at(i), mentions.at(i))) {
        (Some(slot), Some(true)) -> {
          let table = match tables.get(slot) { Some(t) -> t, None -> Map::new() };
          let r = inline_embeds(p.module.module, table, []);
          {
            parsed: acc.parsed.push({
              ..p,
              module: { ..p.module, module: r.module },
              diagnostics: p.diagnostics.concat(
                r.diagnostics.map(|diagnostic: ParseDiagnostic|
                  diagnostic_in_module(i, diagnostic)),
              ),
            }),
            at: table.fold(acc.at, |a: List<ModuleEmbed>, key: Bytes, read: EmbedResult|
              a.push({ module: p.name, key: key, read: read })),
          }
        },
        _ -> { ..acc, parsed: acc.parsed.push(p) },
      }
    },
  )
}

fn pulled_dump(
  user: List<Source>,
  shipped: List<Source>,
) -> { pulled: List<Bytes>, dump: Dump } / {abort.raise} = {
  let x = analyse_pulling_std_with(user, shipped, no_rows());
  { pulled: x.pulled, dump: dump_of(x.out) }
}

fn program() -> List<Source> =
  [
    {
      name: b"m",
      src: b"effect log { write emit(Bytes) -> Unit }\ntype Shape = | Dot | Line(Int)\nfn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\ntest \"says\" { say(b\"x\") }",
    },
  ]

pub fn faceted() -> List<Source> =
  [
    {
      name: b"base",
      src: b"pub effect tick { write beat() -> Unit }\npub type Shape = | Dot | Line(Int)\nfn shown(s: Shape) -> String = match s { Dot -> \"dot\", Line(n) -> \"line\" }\nshow for Shape by shown\npub opaque type Coin = new { cents: Int }\npub fn coin(n: Int) -> Coin = { cents: n }\npub fn cents(c: Coin) -> Int = c.cents\npub fn even(n: Int) -> Bool / { tick.write } = if n <= 0 { true } else { tick.beat(); odd(n - 1) }\nfn odd(n: Int) -> Bool / { tick.write } = if n <= 0 { false } else { even(n - 1) }\npub fn half(n: Int) -> Int requires n >= 0 ensures result <= n = n / 2\npub const fn seven() -> Int = 7\npub fn literal(text: String) -> Result<Int, { message: String, offset: Int }> = Ok(1)\npub fn magnitude<a>(n: a) -> a where numeric(a) = { let zero: a = numeric_of_int(0); if n < zero { zero - n } else { n } }\nlaw \"halving shrinks\" forall (n: Int) where n >= 0 { half(n) <= n }\ntest \"two\" { assert_eq(half(4), 2) }\n",
    },
    {
      name: b"app",
      src: b"import base\npub fn worth(n: Int) -> Int = base::cents(base::coin(base::half(n))) + base::seven()\npub fn tagged() -> Int = base\"one\" + base\"two\" + base::magnitude(0 - 2)\ntest \"worth\" { assert_eq(worth(4), 9) }\ntest \"tags\" { assert_eq(base\"three\", 1) }\ntest \"lines\" { assert(base::Line(1) == base::Line(1)) }\nlaw \"worth is above seven\" forall (n: Int) where n >= 0 { worth(n) >= 7 }\n",
    },
  ]

test "a program's tables made from what its modules' checks said of each are the tables of its check" {
  match analyse(parse_all(faceted())) {
    Refused(ds) ->
      panic(
        "the fixture checks: "
          ++ String::of_bytes_lossy(Bytes::concat_all(ds.map(|d: Diagnostic| d.message))),
      ),
    Analysed(w) -> {
      let answered = assembled_program(
        range(0, w.modules.len()).map(|i: Int| module_facts(w, i)),
        cached_hashes_of(
          w.index,
          w.hashes,
          w.modules.fold(Map::new(), |acc: Map<Bytes, Bool>, m: ParsedModule|
            acc.insert(m.name, true)),
        ),
        Map::new(),
        true,
        true,
        w.warnings,
        w.manifest,
        w.packages,
        w.pins,
        w.module_packages,
        w.embeds,
      );
      let view = checked_program_of(w);
      let fixed = answered.view.frame.hashes;
      assert_eq(fixed.definitions, w.hashes.definitions);
      assert_eq(fixed.refs, w.hashes.refs);
      assert_eq(fixed.dependencies, w.hashes.dependencies);
      assert_eq(fixed, w.hashes);
      assert_eq(view.frame.tagged.len(), 3);
      assert_eq(functions_of(view.frame), view.checked.definitions.len());
      assert_eq(tests_of(view.frame, w.modules.len()), view.checked.tests.len());
      assert_eq(answered.view.frame, view.frame);
      assert_eq(answered.view, view);
      let made = view_dump(answered.view, None);
      let whole = dump_of(Analysed(w));
      assert_eq(made.definitions, whole.definitions);
      assert_eq(made.tests, whole.tests);
      assert_eq(made.laws, whole.laws);
      assert_eq(made.effects, whole.effects);
      assert_eq(made.constructors, whole.constructors);
      assert_eq(made.keys, whole.keys);
      assert_eq(made.emitter_roots, whole.emitter_roots);
      assert_eq(made.emitter_constructors, whole.emitter_constructors);
      assert_eq(made.rows, whole.rows);
      assert_eq(made.walked, whole.walked);
      assert_eq(made, whole)
    },
  }
}

test "a program's tables made from its modules' facts, each shipped module's cut to what the program reaches, are the tables of its check" {
  let user = [
    {
      name: b"main",
      src: b"import std.shapes (origin, far, Tag, size)\npub fn main() -> Int = far(origin()) + size(0 - 1)\npub fn named(t: Tag) -> String = \"{t}\"\n",
    },
  ];
  let shipped = [
    {
      name: b"std.shapes",
      src: b"pub type Point = { x: Int, y: Int }\npub fn origin() -> Point = { x: 0, y: 0 }\npub fn far(p: Point) -> Int requires p.x >= 0 = p.x + helper(p)\nfn helper(p: Point) -> Int = p.y\nfn spare() -> Int = 5\npub fn unreached() -> Int requires spare() > 0 = spare()\npub type Tag = | A | B\nfn tag_text(t: Tag) -> String = match t { A -> \"a\", B -> \"b\" }\nshow for Tag by tag_text\npub fn size<a>(n: a) -> a where numeric(a) = { let zero: a = numeric_of_int(0); if n < zero { zero - n } else { n } }\npub fn spare_size<a>(n: a) -> a where numeric(a) = n\ntype Bag = | Bag(List<Point>)\n",
    },
  ];
  let read = |reached: Bool|
    match analyse_pulling_std_with(user, shipped, no_rows(), reached: reached).out {
      Refused(ds) ->
        panic(
          "the fixture checks: "
            ++ String::of_bytes_lossy(Bytes::concat_all(ds.map(|d: Diagnostic| d.message))),
        ),
      Analysed(w) -> w,
    };
  let whole = read(false);
  let cut = read(true);
  let facts = range(0, whole.modules.len()).map(|i: Int| module_facts(whole, i));
  let fixing = cached_hashes_of(
    whole.index,
    whole.hashes,
    whole.modules.fold(Map::new(), |acc: Map<Bytes, Bool>, m: ParsedModule|
      acc.insert(m.name, true)),
  );
  let answered = assembled_program(
    facts,
    fixing,
    Map::new().insert(b"std.shapes", shipped.get(0).src).insert(
      prelude_module(),
      prelude_source::text(),
    ),
    true,
    true,
    cut.warnings,
    cut.manifest,
    cut.packages,
    cut.pins,
    cut.module_packages,
    cut.embeds,
  );
  let whole_dump = dump_of(Analysed(cut));
  let dump = view_dump(answered.view, None);
  assert(
    !dump.definitions.map(|d: DefinitionRow| d.name).contains(b"std.shapes.unreached"),
    Some("an unreached function is cut"),
  );
  assert_eq(dump.modules, whole_dump.modules);
  assert_eq(dump.definitions, whole_dump.definitions);
  assert_eq(answered.view.frame.hashes, cut.hashes);
  assert_eq(answered.view, checked_program_of(cut));
  assert_eq(dump, whole_dump);
  assert_eq(answered.views, staged_pulling_std_with(user, shipped).shipped_views)
}

pub fn written_reach() -> List<Bytes> =
  [
    b"shift_from",
    b"trie_shift",
    b"List::at",
    b"trie_path",
    b"trie_inserted",
    b"trie_pushed",
    b"List::push",
    b"entries_gathered",
    b"Map::entries",
  ].map(|n: Bytes| qualify(prelude_module(), n))

test "a call back into its group through a home module's function is seen to descend when every module is walked" {
  let user = [
    {
      name: b"m",
      src: b"pub type Expr<r> = | Leaf(r) | Maybe(Option<Expr<r>>)\npub fn mapped<r, s>(e: Expr<r>, f: (r) -> s) -> Expr<s> = match e { Leaf(x) -> Leaf(f(x)), Maybe(o) -> Maybe(o.map(|y: Expr<r>| mapped(y, f))) }\n",
    },
  ];
  let shipped = [
    {
      name: b"std.option",
      src: b"pub fn Option::map<a, b | e>(o: Option<a>, f: (a) -> b / e) -> Option<b> / e bounded = match o { None -> None, Some(x) -> Some(f(x)) }\n",
    },
  ];
  match analyse_pulling_std(user, shipped).out {
    Refused(ds) ->
      panic(String::of_bytes_lossy(Bytes::concat_all(ds.map(|d: Diagnostic| d.message)))),
    Analysed(_) -> (),
  }
}

test "a call written after a `?` holds the site its module as written gives it" {
  let src = b"fn parsed(s: String) -> Result<Int, String> = Ok(1)\nfn f(s: String) -> Result<Int, String> = { let n = parsed(s)?; Ok(n + s.len()) }\n";
  let sites = |m: Module|
    expressions_matching(m, |e: Expression|
      match e { PerformExpression(p) -> p.op.name == b"len", _ -> false }).map(
      expression_span,
    ).map(|at: Span| at.site);
  let written = sites(numbered_module(parse(src).node));
  assert_eq(written.len(), 1);
  match analyse_pulling_std([{ name: b"m", src: src }], []).out {
    Refused(ds) ->
      panic(String::of_bytes_lossy(Bytes::concat_all(ds.map(|d: Diagnostic| d.message)))),
    Analysed(w) -> assert_eq(sites(w.modules.get(0).module), written),
  }
}

test "the emitter's root keys cover every root and no two share one" {
  let src = b"fn pos(x: Int) -> Bool = x > 0\nfn f(x: Int) -> Int requires pos(x) ensures x >= 0 = x\ntest \"t\" { assert_eq(f(1), 1) }\nlaw \"l\" forall (x: Int) { f(x) == x }";
  match analyse(parse_all([{ name: b"m", src: src }])) {
    Refused(_) -> panic("the program checks"),
    Analysed(w) -> {
      let keys = root_keys(outlines_of(w), w.checked, w.hashes);
      assert_eq(
        keys.map(|k: KeyRow| k.root),
        [
          b"m.pos",
          b"m.f#requires#0",
          b"m.f#ensures#0",
          b"m.f",
          test_owner(b"m", b"t"),
          law_root(b"l", LawBody),
        ].concat(
          written_reach(),
        ),
      );
      let distinct = Map::of_entries(keys.map(|k: KeyRow| { key: k.key, value: () })).keys();
      assert_eq(distinct.len(), keys.len());
    },
  }
}

test "a root is pure only as a definition with no row and no constraint" {
  let src = b"effect log { write emit(Bytes) -> Unit }\nfn origin() -> Int = 0\nfn hello() -> Unit / { log.write } = log.emit(b\"hi\")\nfn same<a>(x: a, y: a) -> Bool where derivable(eq, a) = x == y\nfn positive(n: Int) -> Int requires n > 0 = n\ntest \"t\" { assert_eq(origin(), 0) }\nlaw \"l\" forall (n: Int) { same(n, n) }";
  let d = dump_of(analyse(parse_all([{ name: b"m", src: src }])));
  assert_eq(
    d.emitter_roots.filter(|root: EmitterRoot| !written_reach().contains(root.root)).map(
      |root: EmitterRoot| { root: root.root, pure: root.pure },
    ),
    [
      { root: b"m.origin", pure: true },
      { root: b"m.hello", pure: false },
      { root: b"m.same", pure: false },
      { root: b"m.positive", pure: true },
      { root: test_owner(b"m", b"t"), pure: false },
      { root: b"m.positive#requires#0", pure: false },
      { root: law_root(b"l", LawBody), pure: false },
    ],
  );
  assert_eq(
    d.emitter_roots.filter(|root: EmitterRoot| written_reach().contains(root.root)).map(
      |root: EmitterRoot| root.root,
    ),
    written_reach(),
  )
}

test "a program declaring an operation generic in its own type parameters reaches what crossing a container calls, which a perform may stand one at" {
  let roots = |src: Bytes|
    dump_of(analyse(parse_all([{ name: b"m", src: src }]))).emitter_roots.map(|r: EmitterRoot|
      r.root);
  let crossing = [b"List::at", b"List::push", b"Map::entries", b"Map::insert"].map(|n: Bytes|
    qualify(prelude_module(), n));
  let generic = roots(
    b"effect box {\n  write put<a>(x: a) -> Unit\n}\nfn main() -> Int = handle { box.put([1]); 0 } with { box.put(x) -> () }\n",
  );
  assert_eq(crossing.filter(|n: Bytes| !generic.contains(n)), []);
  let plain = roots(
    b"effect box {\n  write put(x: Int) -> Unit\n}\nfn main() -> Int = handle { box.put(1); 0 } with { box.put(x) -> () }\n",
  );
  assert_eq(crossing.filter(|n: Bytes| plain.contains(n)), [])
}

fn law_root(label: Bytes, part: LawPart) -> Bytes / {abort.raise} =
  root_text(root_name(law_key(b"m", label, part)))

test "a root carries a width exactly where a value it is entered with or answers is one" {
  let src = b"fn low_bit(b: U8) -> Int requires Int::of_u8(b) < 200 ensures result < 2 = Int::of_u8(b & 1u8)\nfn narrow(n: Int) -> U8 / {abort.raise} requires n >= 0 ensures Int::of_u8(result) == n = U8::of_int(n)\nfn inc(x: Int) -> Int requires x > 0 ensures result > x = x + 1\ntest \"t\" { assert_eq(inc(1), 2) }\nlaw \"low\" forall (b: U8) where Int::of_u8(b) > 0 { low_bit(b) < 2 }\nlaw \"grows\" forall (x: Int) where x > 0 { inc(x) > x }";
  let d = dump_of(analyse(parse_all([{ name: b"m", src: src }])));
  assert_eq(
    d.emitter_roots.filter(|root: EmitterRoot| !written_reach().contains(root.root)).map(
      |root: EmitterRoot| { root: root.root, params: root.params, result: root.result },
    ),
    [
      { root: b"m.low_bit", params: [FixedWidth(0)], result: NoWidths },
      { root: b"m.narrow", params: [NoWidths], result: FixedWidth(0) },
      { root: b"m.inc", params: [NoWidths], result: NoWidths },
      { root: test_owner(b"m", b"t"), params: [], result: NoWidths },
      { root: b"m.low_bit#requires#0", params: [FixedWidth(0)], result: NoWidths },
      { root: b"m.low_bit#ensures#0", params: [FixedWidth(0), NoWidths], result: NoWidths },
      { root: b"m.narrow#requires#0", params: [NoWidths], result: NoWidths },
      { root: b"m.narrow#ensures#0", params: [NoWidths, FixedWidth(0)], result: NoWidths },
      { root: b"m.inc#requires#0", params: [NoWidths], result: NoWidths },
      { root: b"m.inc#ensures#0", params: [NoWidths, NoWidths], result: NoWidths },
      { root: law_root(b"low", LawGuard), params: [FixedWidth(0)], result: NoWidths },
      { root: law_root(b"low", LawBody), params: [FixedWidth(0)], result: NoWidths },
      { root: law_root(b"grows", LawGuard), params: [NoWidths], result: NoWidths },
      { root: law_root(b"grows", LawBody), params: [NoWidths], result: NoWidths },
    ],
  )
}

test "a carry follows a width into lists, maps, records, sum types, functions and variables" {
  let src = b"effect probe { write put(xs: List<U8>, n: Int) -> Unit }\ntype Byte = | Byte(U8)\ntype Tree = | Leaf | Node(Tree, I16, Tree)\ntype Pair<a, b> = | Pair(b, a)\ntype Color = | Red | Green\nfn wrap(xs: List<U8>) -> List<Byte> = xs.map(|x: U8| Byte(x))\nfn pick<a>(xs: List<a>, r: { v: I16, n: Int }) -> Option<a> = match xs { [x, ..] -> Some(x), _ -> None }\nfn swap(m: Map<String, I8>) -> Pair<Int, U64> / {abort.raise} = Pair(U64::of_int(1), 0)\nfn plain(c: Color, o: Option<Int>) -> Tree = Leaf\nfn apply<a>(f: (Int) -> a, x: Int) -> a = f(x)\nfn sent(xs: List<U8>) -> Unit / { probe.write } = probe.put(xs, 1)";
  let d = dump_of(analyse(parse_all([{ name: b"m", src: src }])));
  let carried = |root: EmitterRoot| { root: root.root, params: root.params, result: root.result };
  assert_eq(
    d.emitter_roots.filter(|root: EmitterRoot| module_of_name(root.root) == b"m").map(carried),
    [
      { root: b"m.wrap", params: [ListWidths(FixedWidth(0))], result: ListWidths(SumWidths([])) },
      {
        root: b"m.pick",
        params: [
          ListWidths(VariableWidths(0)),
          RecordWidths([{ name: b"n", carry: NoWidths }, { name: b"v", carry: FixedWidth(5) }]),
        ],
        result: SumWidths([VariableWidths(0)]),
      },
      {
        root: b"m.swap",
        params: [MapWidths(NoWidths, FixedWidth(4))],
        result: SumWidths([NoWidths, FixedWidth(3)]),
      },
      { root: b"m.plain", params: [NoWidths, NoWidths], result: SumWidths([]) },
      {
        root: b"m.apply",
        params: [FunctionWidths([NoWidths], VariableWidths(0)), NoWidths],
        result: VariableWidths(0),
      },
      { root: b"m.sent", params: [ListWidths(FixedWidth(0))], result: NoWidths },
    ],
  );
  assert(
    d.emitter_roots.map(carried).contains({
      root: b"std.prelude.List::map",
      params: [
        ListWidths(VariableWidths(0)),
        FunctionWidths([VariableWidths(0)], VariableWidths(1)),
      ],
      result: ListWidths(VariableWidths(1)),
    }),
    None,
  );
  assert_eq(effect_named(d, b"m.probe").operations.map(|o: OpRow| o.carries), [
    [ListWidths(FixedWidth(0)), NoWidths],
  ]);
  let own = d.emitter_constructors.filter(|k: EmitterConstructor| k.name.slice(0, 2) == b"m.");
  assert_eq(own.map(|k: EmitterConstructor| { name: k.name, fields: k.fields }), [
    { name: b"m.Byte", fields: [FixedWidth(0)] },
    { name: b"m.Leaf", fields: [] },
    { name: b"m.Node", fields: [SumWidths([]), FixedWidth(5), SumWidths([])] },
    { name: b"m.Pair", fields: [VariableWidths(1), VariableWidths(0)] },
    { name: b"m.Red", fields: [] },
    { name: b"m.Green", fields: [] },
  ]);
  let some = d.emitter_constructors.filter(|k: EmitterConstructor| k.name == some_constructor());
  assert_eq(some.map(|k: EmitterConstructor| k.fields), [[VariableWidths(0)]])
}

test "a shipped answer carries neither what a load walked nor what it warned of" {
  let d = dump_of(analyse(parse_all(program())));
  assert(d.diagnostics.len() > 0, Some("the program warns of something"));
  let shipped = runtime_dump(d);
  assert_eq(shipped.diagnostics, []);
  assert_eq(shipped.walked, b"");
  assert_eq(runtime_dump({ ..d, walked: b"another walk", diagnostics: [] }), shipped);
  assert(d.bodies.len() > 0 && d.keys.len() > 0, Some("the program has bodies and keys"));
  assert_eq(shipped.bodies, []);
  assert_eq(shipped.rows, no_rows());
  assert_eq(shipped.keys, []);
  assert_eq(shipped.definitions, d.definitions);
  assert_eq(shipped.hashes, d.hashes);
  assert_eq(shipped.emitter_roots, d.emitter_roots);
  assert_eq(shipped.emitter_constructors, d.emitter_constructors);
  assert_eq(shipped.ordinals, d.ordinals);
  let embedding = dump_of(
    over_words(
      b"import std.words\npub fn still() -> Int = words::idle()\n",
      words_data(b"one\n"),
    ).out,
  );
  assert_eq(embedding.embeds.len(), 1);
  assert_eq(runtime_dump(embedding).embeds, [])
}

test "a native program carries its entry and the hash of each fn its entry reaches" {
  let d = dump_of(analyse(parse_all(faceted())));
  let hash_of = |name: Bytes|
    d.hashes.fold(b"", |found: Bytes, frame: HashTableRow|
      match frame {
        DefinitionHashRow(row) -> if row.name == name {
          match row.definition { Some(h) -> h, None -> found }
        } else { found },
        _ -> found,
      });
  let reached = [b"app.worth", b"base.cents", b"base.coin", b"base.half", b"base.seven"].concat(
    written_reach(),
  ).sort(
  );
  assert_eq(
    entry_header(d, b"app.worth"),
    Some(
      Bytes::concat_all(
        [b"ply entry 1\napp.worth\n"].concat(
          reached.map(|n: Bytes| Bytes::concat_all([n, b" ", hash_of(n), b"\n"])),
        ),
      ),
    ),
  );
  assert_eq(entry_header(d, b"app.gone"), None)
}

test "a program's answer holds its warnings, its order, its packages and its modules" {
  let d = dump_of(analyse(parse_all(program())));
  assert_eq(d.diagnostics, [
    {
      code: b"W0611",
      notes: 0,
      labels: [{ module: 0, start: 46, end: 51, primary: true, text: b"never used" }],
      text: b"",
      message: b"type `m.Shape` is never used",
      notes_text: [],
      severity: b"warning",
      fixes: [],
    },
  ]);
  assert_eq(d.order, [b"std.prelude", b"m"]);
  assert_eq(d.packages.at(0), Some({ prefix: b"", dependencies: [] }));
  assert_eq(d.module_packages, [0, d.packages.len()]);
  assert_eq(
    d.modules.at(0),
    Some({
      name: b"m",
      index: 0,
      items: [b"m.log", b"m.Shape", b"m.Dot", b"m.Line", b"m.say"],
      imports: [prelude_module()],
      unimported: [],
      sets: [],
      cuts: [
        { start: 115, end: 126, braced: true, name: b"m.say", test: false },
        { start: 127, end: 152, braced: false, name: b"", test: false },
      ],
    }),
  );
  match d.modules.at(1) {
    Some(prelude) -> {
      assert_eq(prelude.name, prelude_module());
      assert(prelude.items.contains(b"std.prelude.ListNode"), None);
      assert(!prelude.items.any(|i: Bytes| prelude_functions().contains(i)), None)
    },
    None -> assert(false, Some("the answer holds the prelude's row")),
  }
}

fn reachable() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub fn api() -> Int = shared()\nfn shared() -> Int = 1\nfn dead() -> Int = deader()\nfn deader() -> Int = 2\nfn tested() -> Int = 3\nfn lawful(x: Int) -> Int = x\nfn positive(x: Int) -> Bool = x > 0\npub fn checked(x: Int) -> Int requires positive(x) = x\ntype Pair = { a: Int }\npub fn make() -> Int = { let f = |x: Int| -> Pair { { a: x } }; f(1).a }\nfn _kept() -> Int = 4\nfn main() -> Int = 5\ntype Unused = | Nothing\ntest \"calls it\" { assert_eq(tested(), 3) }\nlaw \"it is the identity\" forall (x: Int) { lawful(x) == x }",
    },
  ]

fn test_effects(src: Bytes, name: Bytes) -> Bytes / {abort.raise} =
  match dump_of(analyse(parse_all([{ name: b"m", src: src }]))).tests.filter(|t: TestRow|
      t.name == name) {
    [t, ..] -> effect_list_text(t.effects, b","),
    [] -> panic("the dump holds the test"),
  }

test "a declared hold atom reaches a test's footprint, and a region's own never does" {
  let src = b"fn touches(n: Int) -> Int / {scoped.read[log]} = n\n\ntest \"a read\" {\n  let seen = with_scope[log](41, |x: Int| ()) { c -> c.get() };\n  assert_eq(touches(seen), 41)\n}\n\ntest \"inside the region\" {\n  with_scope[log](41, |x: Int| ()) { c -> assert_eq(c.get(), 41) }\n}\n";
  assert_eq(test_effects(src, b"a read"), b"scoped.read[log]");
  assert_eq(test_effects(src, b"inside the region"), b"")
}

test "a general clause inside a region carries that region's atoms out of it" {
  let src = b"effect amb { read flip[coin]() -> Bool }\n\nfn leaks(n: Int) -> Int / {scoped.read[t]} =\n  with_scope[t](n, |x: Int| ()) { c ->\n    handle { let b = amb.flip[coin](); c.get() + 1 }\n    with { amb.flip[coin]() resume k -> k(true), return x -> x }\n  }\n\nfn discharges(n: Int) -> Int =\n  with_scope[t](n, |x: Int| ()) { c ->\n    handle { c.get() + 1 }\n    with { amb.flip[coin]() -> true, return x -> x }\n  }\n\ntest \"through a general clause\" { assert_eq(leaks(1), 2) }\ntest \"through a tail-resumptive one\" { assert_eq(discharges(1), 2) }\n";
  assert_eq(test_effects(src, b"through a general clause"), b"scoped.read[t]");
  assert_eq(test_effects(src, b"through a tail-resumptive one"), b"")
}

test "only a definition no root reaches is warned, each once at its name" {
  let d = dump_of(analyse(parse_all(reachable())));
  let said = d.diagnostics.map(|diagnostic: Diagnostic| diagnostic.message);
  assert(said.contains(b"fn `m.dead` is never used"));
  assert(said.contains(b"fn `m.deader` is never used"));
  assert(said.contains(b"type `m.Unused` is never used"));
  assert_eq(said.len(), 3);
  let src = reachable().get(0).src;
  let named = d.diagnostics.map(|diagnostic: Diagnostic|
    match diagnostic.labels.filter(|l: Label| l.primary) {
      [l, ..] -> src.slice(l.start, l.end),
      [] -> b"",
    });
  assert_eq(named.sort_by(|a: Bytes, b: Bytes| compare(a, b) == Less), [
    b"Unused",
    b"dead",
    b"deader",
  ]);
  assert(d.order.len() > 0)
}

test "a definition's row holds its footprint, parameters and span" {
  let say = definition_named(dump_of(analyse(parse_all(program()))), b"m.say");
  assert_eq(say.module, b"m");
  assert_eq(say.simple_name, b"say");
  assert(!say.public && !say.reuse);
  assert_eq(
    scheme_text(scheme_named(published(analyse(parse_all(program()))), b"m.say")),
    b"(Bytes) -> Unit / {m.log.write}",
  );
  assert_eq(effect_list_text(say.effects, b","), b"m.log.write");
  assert_eq(effect_list_text(say.performed, b","), b"m.log.emit");
  assert_eq(say.params, [{ name: b"b", at: { module: 0, start: 79, end: 87 } }]);
  assert_eq(say.at, { module: 0, start: 72, end: 126 })
}

test "a test's row is placed by its index and carries its key" {
  assert_eq(dump_of(analyse(parse_all(program()))).tests, [
    {
      key: b"m.says",
      name: b"says",
      module: b"m",
      index: 0,
      nondet: false,
      effects: [{ effect: b"m.log", resource: SingletonResource, mode: WriteMode, op: None }],
      at: { module: 0, start: 127, end: 152 },
      name_at: { module: 0, start: 132, end: 138 },
    },
  ])
}

fn effect_named(d: Dump, name: Bytes) -> EffectRow / {abort.raise} =
  match d.effects.fold(None, |acc: Option<EffectRow>, e: EffectRow|
      if e.name == name { Some(e) } else { acc }) {
    Some(e) -> e,
    None -> panic("the answer holds the effect"),
  }

test "an effect's row holds each operation with its mode, its types and its span" {
  let log = effect_named(dump_of(analyse(parse_all(program()))), b"m.log");
  assert_eq(log.module, b"m");
  assert_eq(log.simple_name, b"log");
  assert(!log.public && !log.nondet);
  assert_eq(log.operations, [
    {
      name: b"emit",
      mode: b"write",
      resource_param: false,
      kept: [],
      params: [bytes_type()],
      ret: unit_type(),
      scheme: None,
      at: { module: 0, start: 13, end: 38 },
      carries: [NoWidths],
    },
  ]);
  assert_eq(log.at, { module: 0, start: 0, end: 40 })
}

test "a prelude effect is placed outside every module and its operations carry a scheme" {
  let sim = effect_named(dump_of(analyse(parse_all(program()))), b"sim");
  assert_eq(sim.module, b"");
  assert(sim.public);
  assert_eq(sim.at, { module: no_module(), start: 0, end: 0 });
  assert_eq(sim.operations.map(|o: OpRow| o.name), [b"seed"]);
  let seed = sim.operations.get(0);
  assert_eq(seed.mode, b"read");
  assert_eq(seed.params, []);
  assert_eq(seed.ret, int_type());
  assert_eq(match seed.scheme { Some(sc) -> scheme_text(sc), None -> b"" }, b"() -> Int");
  assert_eq(seed.at, { module: no_module(), start: 0, end: 0 })
}

test "a constructor's row holds its fields and its scheme" {
  let line = dump_of(analyse(parse_all(program()))).constructors.filter(|k: ConstructorRow|
    k.name == b"m.Line");
  assert_eq(line, [
    {
      name: b"m.Line",
      module: b"m",
      simple_name: b"Line",
      type_name: b"m.Shape",
      index: 1,
      arity: 1,
      fields: [int_type()],
      scheme: {
        type_variables: [],
        effect_variables: [],
        keep_variables: [],
        label_variables: [],
        ty: FunctionType({
          kept: [],
          once: false,
          params: [int_type()],
          ret: named_type(b"m.Shape"),
          effects: { listed: [], tail: None },
        }),
      },
      at: { module: 0, start: 62, end: 71 },
    },
  ])
}

fn definition_hash_named(d: Dump, name: Bytes) -> HashRow / {abort.raise} =
  match d.hashes.fold(None, |acc: Option<HashRow>, h: HashTableRow|
      match h { DefinitionHashRow(r) -> if r.name == name { Some(r) } else { acc }, _ -> acc }) {
    Some(r) -> r,
    None -> panic("the answer hashes the definition"),
  }

fn body_named(d: Dump, name: Bytes) -> Bytes / {abort.raise} =
  match d.bodies.fold(None, |acc: Option<Bytes>, b: BodyRow|
      if b.name == name { Some(b.body) } else { acc }) {
    Some(b) -> b,
    None -> panic("the answer holds the body"),
  }

test "a hash row carries the definition's hash, its own form and its references, and the body hashes to it" {
  let d = dump_of(analyse(parse_all(program())));
  let say = definition_hash_named(d, b"m.say");
  assert(say.own != None);
  assert_eq(say.dependencies, [b"m.log"]);
  let order = d.hashes.map(|h: HashTableRow|
    match h { DefinitionHashRow(r) -> r.name, TestHashRow(r) -> r.key, LawHashRow(r) -> r.key });
  let placed = range(0, order.len()).fold(0 - 1, |acc: Int, j: Int|
    if order.get(j) == b"m.say" { j } else { acc });
  assert_eq(order.at(placed + 1), Some(b"m.says"));
  let body = body_named(d, b"m.say");
  assert_eq(body.at(0), 0);
  assert_eq(match body_key(body) { Some(k) -> Some(hex(k)), None -> None }, say.definition)
}

test "the ordinals list every fn, test and law in source order" {
  assert_eq(dump_of(analyse(parse_all(program()))).ordinals, [
    { module: b"m", items: [b"fn m.say", b"test m.says"] },
    { module: prelude_module(), items: [] },
  ])
}

fn specified() -> List<Source> =
  [
    {
      name: b"m",
      src: b"effect log { write emit(Bytes) -> Unit }\neffect set Io = {log.write}\nfn say(b: Bytes) -> Unit / {Io} = log.emit(b)\nfn inc(x: Int) -> Int requires x > 0 ensures result > x = x + 1\nlaw \"inc grows\" forall (x: Int) where x > 0 { inc(x) > x }",
    },
  ]

test "a definition's row holds its row aliases and each clause with its kind, index and span" {
  let d = dump_of(analyse(parse_all(specified())));
  let say = definition_named(d, b"m.say");
  assert_eq(say.effect_aliases, [b"Io"]);
  assert_eq(say.params, [{ name: b"b", at: { module: 0, start: 76, end: 84 } }]);
  assert_eq(say.at, { module: 0, start: 69, end: 114 });
  let inc = definition_named(d, b"m.inc");
  assert_eq(
    scheme_text(scheme_named(published(analyse(parse_all(specified()))), b"m.inc")),
    b"(Int) -> Int",
  );
  assert_eq(inc.effects, []);
  assert_eq(inc.params, [{ name: b"x", at: { module: 0, start: 122, end: 128 } }]);
  assert_eq(inc.spec, [
    { kind: b"requires", index: 0, effects: [], at: { module: 0, start: 137, end: 151 } },
    { kind: b"ensures", index: 1, effects: [], at: { module: 0, start: 152, end: 170 } },
  ]);
  assert_eq(inc.at, { module: 0, start: 115, end: 178 });
  assert_eq(inc.literals, [b"int 0"]);
  assert_eq(d.ordinals, [
    { module: b"m", items: [b"fn m.say", b"fn m.inc requires,ensures", b"law m.inc grows"] },
    { module: prelude_module(), items: [] },
  ])
}

fn rows_written_as(row: Bytes) -> List<Source> =
  [
    {
      name: b"m",
      src: Bytes::concat_all([
        b"pub effect log { write emit(Bytes) -> Unit }\neffect set Io = {log.write}\n",
        b"pub fn say(b: Bytes) -> Unit / {",
        row,
        b"} = log.emit(b)\npub fn twice(b: Bytes) -> Unit / {",
        row,
        b"} = {\n  say(b);\n  say(b)\n}\n",
      ]),
    },
  ]

fn definition_hashes(d: Dump) -> List<{ name: Bytes, definition: Option<Bytes> }> =
  d.hashes.fold([], |acc: List<{ name: Bytes, definition: Option<Bytes> }>, f: HashTableRow|
    match f {
      DefinitionHashRow(r) -> acc.push({ name: r.name, definition: r.definition }),
      _ -> acc,
    })

test "a row alias and its expansion are one program: the same hashes, bodies and rows" {
  let aliased = rows_written_as(b"Io");
  let expanded = rows_written_as(b"log.write");
  let published = |sources: List<Source>| {
    let rows = rows_of(analysis_of(sources));
    {
      definitions: rows.definitions.map(|row: KnownDefinitionRow| { ..row, hash: b"", facts: b"" }),
      tests: rows.tests.map(|row: KnownTestRow| { ..row, hash: b"", facts: b"" }),
    }
  };
  assert_eq(published(aliased), published(expanded));
  let a = dump_of(analyse(parse_all(aliased)));
  let e = dump_of(analyse(parse_all(expanded)));
  assert_eq(definition_hashes(a), definition_hashes(e));
  assert(definition_hashes(a).len() >= 2);
  assert_eq(a.bodies, e.bodies);
  assert_eq(a.definitions.map(|row: DefinitionRow| row.effect_aliases), [[b"Io"], [b"Io"]]);
  assert_eq(e.definitions.map(|row: DefinitionRow| row.effect_aliases), [[], []])
}

fn written() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub type Pair<a, b> = { fst: a, snd: b }\npub effect log { write emit(Bytes) -> Unit }\npub reuse fn keep(xs: List<Int>) -> List<Int> = xs.push(1)\nlaw \"bounds\" forall (n: Int) where n > -3 && n < 7 { n == n }",
    },
  ]

test "a definition's row holds its visibility, its reuse marker and its parameters as written" {
  let keep = definition_named(dump_of(analyse(parse_all(written()))), b"m.keep");
  assert(keep.public && keep.reuse);
  assert_eq(keep.params, [{ name: b"xs", at: { module: 0, start: 104, end: 117 } }])
}

test "a type's row holds its arity and its visibility" {
  let rows = dump_of(analyse(parse_all(written()))).types.map(|t: TypeRow|
    { name: t.name, module: t.module, public: t.public, arity: t.arity });
  assert_eq(
    rows.filter(|t: { name: Bytes, module: Bytes, public: Bool, arity: Int }| t.module == b"m"),
    [{ name: b"m.Pair", module: b"m", public: true, arity: 2 }],
  );
  assert(
    rows.contains({
      name: b"std.prelude.ListNode",
      module: b"std.prelude",
      public: false,
      arity: 1,
    }),
    None,
  )
}

test "a guard's literals are in the search's order, a negation folded" {
  assert_eq(dump_of(analyse(parse_all(written()))).laws.map(|l: LawRow| l.literals), [
    [b"int 7", b"int -3", b"int 3"],
  ])
}

fn bounds_written(guard: Bytes) -> List<Bounded> / {abort.raise} = {
  let modules = parse_all([
    {
      name: b"m",
      src: Bytes::concat_all([b"law \"l\" forall (n: Int, m: Int) where ", guard, b" { true }\n"]),
    },
  ]).map(|p: ParsedSource| p.module);
  modules.get(0).module.items.fold([], |acc: List<Bounded>, item: Item|
    match item { LawItem(d) -> guard_bounds(modules, d), _ -> acc })
}

test "a guard holds a name between two literals it compares the name with at the top of its `&&`s" {
  assert_eq(bounds_written(b"n > 0 && n <= 100"), [{ name: b"n", low: 1, high: 100 }]);
  assert_eq(bounds_written(b"3 <= n && 9 > n && m == -2"), [
    { name: b"n", low: 3, high: 8 },
    { name: b"m", low: -2, high: -2 },
  ]);
  assert_eq(bounds_written(b"n >= 0 && n >= 5 && n < 9 && n < 20"), [
    { name: b"n", low: 5, high: 8 },
  ]);
  assert_eq(bounds_written(b"n > 5 && n < 3"), [{ name: b"n", low: 6, high: 2 }]);
  assert_eq(bounds_written(b"n > 0"), []);
  assert_eq(bounds_written(b"(n > 0 && n < 9) || m == 1"), []);
  assert_eq(bounds_written(b"!(n > 0) && n < 9 && m > n && m < 4"), [])
}

test "a law's row holds its binders with their spans and types, and its hashes carry the sentence" {
  let d = dump_of(analyse(parse_all(specified())));
  assert_eq(d.laws, [
    {
      key: b"m.inc grows",
      name: b"inc grows",
      module: b"m",
      index: 0,
      binders: [{ name: b"x", at: { module: 0, start: 203, end: 209 }, ty: int_type() }],
      has_guard: true,
      effects: [],
      at: { module: 0, start: 179, end: 237 },
      literals: [b"int 0"],
    },
  ]);
  assert_eq(d.modules.map(|row: ModuleRow| row.sets), [
    [
      {
        name: b"Io",
        includes: [],
        listed: [{ effect: b"m.log", resource: SingletonResource, mode: WriteMode, op: None }],
      },
    ],
    [],
  ]);
  let law = match d.hashes.fold(None, |acc: Option<ItemHashRow>, h: HashTableRow|
      match h { LawHashRow(r) -> Some(r), _ -> acc }) {
    Some(r) -> r,
    None -> panic("the law is hashed"),
  };
  assert_eq(law.key, b"m.inc grows");
  assert_eq(law.hash.len(), 64);
  assert_eq(law.text.len(), 64);
  assert_eq(law.dependencies, [b"m.inc"]);
  let inc = definition_hash_named(d, b"m.inc");
  assert(inc.own != None);
  assert_eq(inc.specs.len(), 2);
  assert_eq(inc.spec_texts.len(), 2)
}

fn claimed() -> List<Source> =
  [
    { name: b"base", src: b"pub fn one() -> Int = 1\npub type Coin = | Heads | Tails" },
    {
      name: b"app",
      src: b"import base\nfn two(x: Int) -> Option<Int> requires x > 0 = Some(base::one() + [x].len())\nlaw \"it grows\" forall (x: Int) where x > 0 { two(x) != None }",
    },
  ]

fn code_text(c: Option<Code>) -> Bytes / {abort.raise} = match c { Some(x) -> dump(x), None -> b"" }

test "a claim is lowered with each global named program-wide, and a builtin and a prelude constructor as written" {
  let out = claims(claimed());
  assert_eq(out.len(), 4);
  match out.get(0) {
    ClaimDefinition(d) -> {
      assert_eq(d.name, b"base.one");
      assert_eq(d.params, 0);
      assert_eq(code_text(d.body), b"lit(i1)");
      assert_eq(d.spec, [])
    },
    _ -> assert(false),
  };
  assert_eq(out.get(1), ClaimSum({ name: b"base.Coin", variants: 2 }));
  match out.get(2) {
    ClaimDefinition(d) -> {
      assert_eq(d.name, b"app.two");
      assert_eq(d.params, 1);
      assert_eq(
        code_text(d.body),
        b"app(ctor(Some),bin(add,app(def(base.one)),app(builtin(List::len),list(var(x,0),))))",
      );
      assert_eq(d.spec.map(|c: ClaimClause| c.kind), [RequiresClause]);
      let c = d.spec.get(0).clause;
      assert_eq(c.at, { module: 1, start: 51, end: 56 });
      assert_eq(code_text(Some(c.code)), b"bin(gt,var(x,0),lit(i0))")
    },
    _ -> assert(false),
  };
  match out.get(3) {
    ClaimLaw(l) -> {
      assert_eq(l.key, b"app.it grows");
      assert(l.guard != None);
      assert_eq(code_text(Some(l.body)), b"block(bin(ne,app(def(app.two),var(x,0)),ctor(None)))")
    },
    _ -> assert(false),
  }
}

test "an instantiation claims its schema's guard and body with what it was given written in place" {
  let out = claims([
    {
      name: b"lib",
      src: b"pub fn limit() -> Int = 100\npub law schema fixed(f: (Int) -> Int, low: Int) forall (x: Int) where x > low && x < limit() { f(x) == x }",
    },
    {
      name: b"app",
      src: b"import lib\nfn id(n: Int) -> Int = n\nlaw \"made\" = lib::fixed(id, 0)\nlaw \"written\" forall (x: Int) where x > 0 && x < lib::limit() { id(x) == x }\nlaw \"through a lambda\" = lib::fixed(|n: Int| id(n), 0)",
    },
  ]);
  let body_of = |key: Bytes|
    out.fold(b"", |found: Bytes, c: Claim|
      match c {
        ClaimLaw(l) -> if l.key == key { code_text(Some(l.body)) } else { found },
        _ -> found,
      });
  let guard_of = |key: Bytes|
    out.fold(b"", |found: Bytes, c: Claim|
      match c {
        ClaimLaw(l) -> if l.key != key { found }
        else { match l.guard { Some(g) -> code_text(Some(g.code)), None -> b"" } },
        _ -> found,
      });
  assert_eq(body_of(b"app.made"), body_of(b"app.written"));
  assert_eq(guard_of(b"app.made"), guard_of(b"app.written"));
  assert(guard_of(b"app.made").index_of(b"lib.limit") != None);
  assert(body_of(b"app.through a lambda").index_of(b"lam(") != None);
  assert(body_of(b"app.through a lambda").index_of(b"lib.fixed") == None)
}

test "a record update reaches a claim as the literal it stands for" {
  let out = claims([
    { name: b"m", src: b"pub type P = { a: Int, b: Int }\npub fn bump(p: P) -> P = {..p, b: 3}" },
  ]);
  assert_eq(out.len(), 1);
  match out.get(0) {
    ClaimDefinition(d) -> assert(code_text(d.body).index_of(b"upd(") != None),
    _ -> assert(false),
  }
}

test "claims lowered from an analysis are the claims lowered from its sources" {
  let sources = [
    {
      name: b"base",
      src: b"pub type P = { a: Int, b: Int }\npub fn bump(p: P) -> P ensures result.b == 3 = {..p, b: 3}\npub fn same(p: P) -> P = p\npub effect tally { write add[r](n: Int) -> Unit }\npub fn add_twice<[r]>(n: Int) -> Unit / {tally.add[r]} = { tally.add[r](n); tally.add[r](n) }\npub fn keyed<a>(k: a) -> Map<a, Int> where derivable(ord, a) = Map::new().insert(k, 1)\npub fn size(xs: List<Int>) -> Int cost xs.len() space xs.len() = xs.len()\n",
    },
    {
      name: b"app",
      src: b"import base\nfn moved(p: base::P) -> Int requires {..p, a: 1}.a == 1 = base::same(p).a\nfn counted() -> Map<Int, Int> / {base::tally.add[c]} = { base::add_twice[c](2); {..base::bump({ a: 0, b: 0 }), a: 1}.a; base::keyed(4) }\nlaw \"bumped\" forall (p: base::P) { base::bump(p) == {..p, b: 3} }\ntest \"updated\" { assert_eq({..base::same({ a: 1, b: 2 }), a: 5}.a, 5) }\n",
    },
  ];
  let w = analysis_of(sources);
  assert_eq(claims_in(w, range(0, sources.len())), claims(sources))
}

fn shipped_modules() -> List<Source> =
  [
    { name: b"std.a", src: b"import std.c\npub fn a() -> Int = 1" },
    { name: b"std.b", src: b"pub fn b() -> Int = 2" },
    { name: b"std.c", src: b"pub fn c() -> Int = 3" },
    { name: b"std.d", src: b"pub fn d() -> Int = 4" },
  ]

fn reached_fixture() -> List<Source> =
  [
    {
      name: b"std.r",
      src: b"import std.s (helper, other)\npub fn used() -> Int = helper()\npub fn unused() -> Int = other()\npub fn imported() -> Int = 3\ntest \"r holds\" { assert(used() == 1) }\n",
    },
    { name: b"std.s", src: b"pub fn helper() -> Int = 1\npub fn other() -> Int = 4\n" },
  ]

fn pulled_hashes(p: PulledAnalysis) -> List<{ name: Bytes, hash: Bytes }> =
  match p.out { Analysed(w) -> w.hashes.definitions, Refused(_) -> [] }

fn definition_names(p: PulledAnalysis) -> List<Bytes> =
  pulled_hashes(p).map(|d: { name: Bytes, hash: Bytes }| d.name).sort()

pub fn not_written(names: List<Bytes>) -> List<Bytes> =
  names.filter(|n: Bytes| !written_reach().contains(n))

fn prelude_functions() -> List<Bytes> / {abort.raise} =
  parse(prelude_source::text()).node.items.fold([], |acc: List<Bytes>, item: Item|
    match item {
      FunctionItem(d) -> acc.push(qualify(prelude_module(), d.name.name)),
      _ -> acc,
    }).sort(
  )

test "a program reads of a shipped module the functions it reaches and the names it imports" {
  let user = [{ name: b"m", src: b"import std.r (used, imported)\npub fn f() -> Int = used()\n" }];
  let of_prelude = |names: List<Bytes>|
    names.filter(|n: Bytes| module_of_name(n) == prelude_module());
  let not_of_prelude = |names: List<Bytes>|
    names.filter(|n: Bytes| module_of_name(n) != prelude_module());
  let cut = analyse_pulling_std_with(user, reached_fixture(), no_rows());
  assert_eq(definition_names(cut), [b"m.f", b"std.r.imported", b"std.r.used", b"std.s.helper"]);
  let whole = analyse_pulling_std_with(user, reached_fixture(), no_rows(), reached: false);
  assert(definition_names(whole).contains(b"std.prelude.mapped_from"), None);
  assert_eq(not_of_prelude(definition_names(whole)), [
    b"m.f",
    b"std.r.imported",
    b"std.r.unused",
    b"std.r.used",
    b"std.s.helper",
    b"std.s.other",
  ]);
  assert_eq(of_prelude(definition_names(whole)), prelude_functions());
  let hash_of = |p: PulledAnalysis, name: Bytes|
    pulled_hashes(p).fold(None, |acc: Option<Bytes>, d: { name: Bytes, hash: Bytes }|
      if d.name == name { Some(d.hash) } else { acc });
  assert_eq(hash_of(cut, b"std.r.used"), hash_of(whole, b"std.r.used"));
  assert(hash_of(cut, b"std.r.used") != None)
}

test "a shipped function is read with what its specifications name" {
  let specified = [
    {
      name: b"std.q",
      src: b"import std.s (helper)\nimport std.s as s\npub fn used(n: Int) -> Int\n  requires n > s::other()\n  ensures result == model(n) + helper()\n= n\nfn model(n: Int) -> Int = n - further()\nfn further() -> Int = 1\npub fn unused() -> Int = 2\n",
    },
    {
      name: b"std.s",
      src: b"pub fn helper() -> Int = 1\npub fn other() -> Int = 4\npub fn idle() -> Int = 5\n",
    },
  ];
  let cut = analyse_pulling_std_with(
    [{ name: b"m", src: b"import std.q\npub fn f() -> Int = q::used(9)\n" }],
    specified,
    no_rows(),
  );
  assert_eq(
    match cut.out {
      Analysed(_) -> [],
      Refused(diagnostics) -> diagnostics.map(|d: Diagnostic| d.code),
    },
    [],
  );
  assert_eq(
    definition_names(cut),
    [
      b"m.f",
      b"std.q.further",
      b"std.q.model",
      b"std.q.used",
      b"std.s.helper",
      b"std.s.other",
    ].concat(
      written_reach(),
    ).sort(
    ),
  )
}

test "a shipped type is read with what its module states of it, though the program reaches neither" {
  let stating = [
    {
      name: b"std.n",
      src: b"import std.s (helper)\npub type N = | N(Int)\nkey for N by held\nshow for N by written\nnumeric for N by { add: plus, sub: plus, mul: plus, neg: same, of_int: of }\nfn held(n: N) -> Int = match n { N(x) -> x + helper() }\nfn written(n: N) -> String = \"n\"\nfn plus(a: N, b: N) -> N = a\nfn same(a: N) -> N = a\nfn of(n: Int) -> N = N(n)\npub fn unused() -> Int = 2\n",
    },
    { name: b"std.s", src: b"pub fn helper() -> Int = 1\npub fn other() -> Int = 4\n" },
  ];
  let idle = analyse_pulling_std_with(
    [{ name: b"m", src: b"import std.n\npub fn f() -> Int = 1\n" }],
    stating,
    no_rows(),
  );
  assert_eq(
    match idle.out {
      Analysed(_) -> [],
      Refused(diagnostics) -> diagnostics.map(|d: Diagnostic| d.code),
    },
    [],
  );
  assert_eq(definition_names(idle), [
    b"m.f",
    b"std.n.held",
    b"std.n.of",
    b"std.n.plus",
    b"std.n.same",
    b"std.n.written",
    b"std.s.helper",
  ]);
  let used = analyse_pulling_std_with(
    [{ name: b"m", src: b"import std.n (N)\npub fn f(a: N, b: N) -> Bool = a + b == a\n" }],
    stating,
    no_rows(),
  );
  assert_eq(definition_names(used), definition_names(idle).concat(written_reach()).sort())
}

fn namesakes() -> List<Source> =
  [
    {
      name: b"std.z",
      src: b"pub effect pack {\n  raise refused(at: Int)\n}\npub effect Pack {\n  raise spilled(at: Int)\n}\npub type Pack = | Pack(Int) | Loose\npub fn pack(n: Int) -> Pack = Pack(squeezed(n))\nfn squeezed(n: Int) -> Int = n + deeper()\nfn deeper() -> Int = 1\npub fn try_unpack(p: Pack) -> Int / {pack.refused, Pack.spilled} =\n  match p { Pack(n) -> if n < 0 { pack.refused(n) } else { n }, Loose -> Pack.spilled(0) }\npub fn idle() -> Int = 3\n",
    },
    {
      name: b"std.y",
      src: b"import std.z (pack, Pack, Loose)\npub fn guarded(n: Int) -> Int / {pack.refused} = if n < 0 { pack.refused(n) } else { n }\npub fn loose() -> Pack = Loose\n",
    },
    {
      name: b"std.w",
      src: b"pub effect table {\n  raise missing(at: Int)\n}\npub fn table() -> Bytes = embed(\"w/table.txt\")\npub fn rows() -> Int = table().len()\npub fn try_row(n: Int) -> Int / {table.missing} = if n < 0 { table.missing(n) } else { n }\n",
    },
  ]

fn namesake_data(bytes: Bytes) -> List<ShippedData> = [{ name: b"std/w/table.txt", bytes: bytes }]

fn loaded_twice(imports: Bytes) -> List<List<Bytes>> / {abort.raise} = {
  let user = [{ name: b"m", src: imports.concat(b"\npub fn f() -> Int = 1\n") }];
  let said = |diagnostics: List<Diagnostic>|
    diagnostics.map(|d: Diagnostic| Bytes::concat_all([d.code, b": ", d.message]));
  let data = namesake_data(b"one\n");
  let cold = analyse_pulling_std_with(user, namesakes(), no_rows(), data: data);
  match cold.out {
    Refused(diagnostics) -> [said(diagnostics)],
    Analysed(w) -> {
      let rows = rows_of(w);
      let warm = analyse_pulling_std_with(user, namesakes(), rows, data: data);
      [
        definition_names(cold),
        match warm.out {
          Refused(diagnostics) -> said(diagnostics),
          Analysed(_) -> definition_names(warm),
        },
      ]
    },
  }
}

test "a shipped function is read for itself, not for an effect or a type that shares its name" {
  let both = |names: List<Bytes>| [names, names];
  assert_eq(loaded_twice(b"import std.z"), both([b"m.f"]));
  assert_eq(loaded_twice(b"import std.z (try_unpack)"), both([b"m.f", b"std.z.try_unpack"]));
  assert_eq(loaded_twice(b"import std.z (pack)"), both([b"m.f"]));
  assert_eq(
    loaded_twice(b"import std.z (pack, Pack)\npub fn g() -> Pack = pack(2)"),
    both([b"m.f", b"m.g", b"std.z.deeper", b"std.z.pack", b"std.z.squeezed"]),
  );
  assert_eq(loaded_twice(b"import std.z (Pack)"), both([b"m.f"]));
  assert_eq(loaded_twice(b"import std.z (Loose)"), both([b"m.f"]));
  assert_eq(loaded_twice(b"import std.z (idle)"), both([b"m.f", b"std.z.idle"]));
  assert_eq(loaded_twice(b"import std.y (guarded)"), both([b"m.f", b"std.y.guarded"]));
  assert_eq(loaded_twice(b"import std.y (loose)"), both([b"m.f", b"std.y.loose"]));
  assert_eq(loaded_twice(b"import std.y"), both([b"m.f"]));
  assert_eq(loaded_twice(b"import std.w (try_row)"), both([b"m.f", b"std.w.try_row"]));
  assert_eq(loaded_twice(b"import std.w (rows)"), both([b"m.f", b"std.w.rows", b"std.w.table"]));
  assert_eq(loaded_twice(b"import std.w (table)"), both([b"m.f"]))
}

test "a data file a shipped function embeds moves what reaches the function, and nothing that reaches an effect of its name" {
  let over = |imports: Bytes, bytes: Bytes|
    analyse_pulling_std_with(
      [{ name: b"m", src: imports.concat(b"\npub fn f() -> Int = 1\n") }],
      namesakes(),
      no_rows(),
      data: namesake_data(bytes),
    );
  let reader = b"import std.w (try_row)";
  assert_eq(definition_names(over(reader, b"one\n")), [b"m.f", b"std.w.try_row"]);
  assert_eq(pulled_hashes(over(reader, b"one\n")), pulled_hashes(over(reader, b"one\ntwo\n")));
  let named = b"import std.w (table)\npub fn g() -> Bytes = table()";
  let one = over(named, b"one\n");
  assert(pulled_hash(one, b"std.w.table") != None);
  assert(
    pulled_hash(one, b"std.w.table") != pulled_hash(over(named, b"one\ntwo\n"), b"std.w.table"),
  );
  assert_eq(dump_of(one.out).embeds, [
    { module: b"std.w", key: b"file:w/table.txt", read: Ok([embed_file(b"", b"one\n")]) },
  ])
}

test "a shipped compiler module's import of another keeps only what the program reaches" {
  let user = [{ name: b"m", src: b"import compiler.a (first)\npub fn f() -> Int = first()\n" }];
  let shipped = [
    {
      name: b"compiler.a",
      src: b"import compiler.b (second, third)\npub fn first() -> Int = second()\npub fn unused() -> Int = third()\n",
    },
    { name: b"compiler.b", src: b"pub fn second() -> Int = 1\npub fn third() -> Int = 2\n" },
  ];
  let cut = analyse_pulling_std_with(user, shipped, no_rows());
  assert_eq(definition_names(cut), [b"compiler.a.first", b"compiler.b.second", b"m.f"])
}

fn view_named(views: List<ShippedView>, module: Bytes) -> ShippedView / {abort.raise} =
  match views.filter(|v: ShippedView| v.module == module) {
    [v, ..] -> v,
    [] -> panic("no view of the module"),
  }

fn view_names(v: ShippedView) -> List<Bytes> =
  v.definitions.map(|d: { name: Bytes, hash: Bytes }| d.name).sort()

test "a load's view of a shipped module is its form and the functions the program reached" {
  let user = [{ name: b"m", src: b"import std.r (used, imported)\npub fn f() -> Int = used()\n" }];
  let viewed = analyse_pulling_std_with(user, reached_fixture(), no_rows()).shipped_views;
  assert_eq(viewed.map(|v: ShippedView| v.module), [prelude_module(), b"std.r", b"std.s"]);
  assert_eq(view_names(view_named(viewed, b"std.r")), [b"std.r.imported", b"std.r.used"]);
  assert_eq(view_names(view_named(viewed, b"std.s")), [b"std.s.helper"]);
  assert_eq(view_named(viewed, b"std.s").text, hex(blake3(reached_fixture().get(1).src)));
  let hexed = |b: Bytes|
    b.len() == 64
      && range(0, 64).fold(true, |ok: Bool, i: Int| {
        let c = b.at(i);
        ok && ((c >= 48 && c <= 57) || (c >= 97 && c <= 102))
      });
  viewed.fold((), |u: Unit, v: ShippedView| {
    assert(hexed(v.text) && hexed(v.form), None);
    v.definitions.fold((), |w: Unit, d: { name: Bytes, hash: Bytes }| assert(hexed(d.hash), None))
  });
  assert_eq(
    analyse_pulling_std_with(user, reached_fixture(), no_rows(), reached: false).shipped_views,
    [],
  );
  match shipped_views([b"std.r"], reached_fixture()) {
    Err(_) -> panic("the shipped modules hash"),
    Ok(now) ->
      viewed.fold((), |u: Unit, v: ShippedView| {
        let whole = view_named(now, v.module);
        assert_eq(whole.form, v.form);
        assert_eq(whole.text, v.text);
        v.definitions.fold((), |w: Unit, d: { name: Bytes, hash: Bytes }|
          assert(whole.definitions.contains(d), Some(String::of_bytes(d.name))))
      }),
  }
}

test "every load reads `std.prelude`, keeping the functions it writes in Ply that the load reaches" {
  let viewed = |src: Bytes|
    view_names(
      view_named(
        analyse_pulling_std_with([{ name: b"m", src: src }], [], no_rows()).shipped_views,
        prelude_module(),
      ),
    );
  let written = written_reach().sort();
  let holds = |names: List<Bytes>, name: Bytes| names.contains(qualify(prelude_module(), name));
  assert_eq(viewed(b"pub fn g() -> Int = 1\n"), []);
  let crossing = viewed(b"pub fn c(xs: List<Int>) -> Int = 0\n");
  assert(written.all(|n: Bytes| crossing.contains(n)) && holds(crossing, b"Map::insert"), None);
  assert_eq(viewed(b"pub fn d(m: Map<Int, Int>) -> Int = 0\n"), crossing);
  let mapped = viewed(b"pub fn f(xs: List<Int>) -> List<Int> = xs.map(|x: Int| x + 1)\n");
  assert(holds(mapped, b"List::map") && !holds(mapped, b"List::set"), None);
  let set = viewed(b"pub fn h(xs: List<Int>) -> List<Int> / {abort.raise} = xs.set(0, 1)\n");
  assert(holds(set, b"List::set") && !holds(set, b"List::map"), None);
  let got = viewed(b"pub fn k(m: Map<Int, Int>) -> Option<Int> = m.get(1)\n");
  assert(holds(got, b"Map::get") && written.all(|n: Bytes| got.contains(n)), None);
  assert_eq(viewed(b"pub fn same(a: List<Int>, b: List<Int>) -> Bool = a == b\n"), crossing);
  assert_eq(
    viewed(b"pub fn alike(a: Map<Int, Bytes>, b: Map<Int, Bytes>) -> Bool = a == b\n"),
    crossing,
  );
  assert_eq(viewed(b"pub fn hashed(a: List<Int>) -> Bytes = digest(a)\n"), crossing);
  assert_eq(viewed(b"pub fn less(a: Int, b: Int) -> Bool = a < b\n"), []);
  assert_eq(viewed(b"pub fn equal(a: Int, b: Int) -> Bool = a == b\n"), written);
  assert_eq(
    emitted_code().calls.concat(emitted_code().lifts).filter(|n: Bytes|
      !builtins().any(|b: Builtin| b.body && b.name == n)),
    [],
  )
}

test "a function nothing reaches leaves a view's form alone and a type moves it" {
  let user = [{ name: b"m", src: b"import std.r (used)\npub fn f() -> Int = used()\n" }];
  let with_s = |text: Bytes|
    view_named(
      analyse_pulling_std_with(
        user,
        [reached_fixture().get(0), { name: b"std.s", src: text }],
        no_rows(),
      ).shipped_views,
      b"std.s",
    );
  let before = with_s(reached_fixture().get(1).src);
  let added = with_s(reached_fixture().get(1).src.concat(b"pub fn later() -> Int = 5\n"));
  assert(added.text != before.text, None);
  assert_eq(added.form, before.form);
  assert_eq(added.definitions, before.definitions);
  let typed = with_s(reached_fixture().get(1).src.concat(b"pub type T = { x: Int }\n"));
  assert(typed.form != before.form, None)
}

test "the shipped modules a program imports follow it a round at a time, each round in byte order" {
  let a = pulled_dump(
    [{ name: b"m", src: b"import std.b\nimport std.a\npub fn f() -> Int = 1" }],
    shipped_modules(),
  );
  assert_eq(a.pulled, [b"std.a", b"std.b", b"std.prelude", b"std.c"]);
  assert_eq(a.dump.diagnostics, []);
  assert(a.dump.order.len() > 0)
}

test "an import of a module that does not ship is reported at the import, listing the ones that do" {
  let a = pulled_dump(
    [{ name: b"m", src: b"import std.e\npub fn f() -> Int = 1" }],
    shipped_modules(),
  );
  assert_eq(a.pulled, []);
  assert_eq(a.dump.diagnostics, [
    {
      code: b"E0106",
      notes: 2,
      labels: [{ module: 0, start: 7, end: 12, primary: true, text: b"not found" }],
      text: b"",
      message: b"no module named `std.e` ships with this compiler",
      notes_text: [
        b"the stdlib holds: `std.a`, `std.b`, `std.c`, `std.d`, `std.prelude`",
        b"`ply std` lists them with the digest this binary was built from",
      ],
      severity: b"error",
      fixes: [],
    },
  ])
}

fn shipped_text(name: Bytes) -> Option<Bytes> =
  shipped_modules().fold(None, |acc: Option<Bytes>, s: Source|
    if s.name == name { Some(s.src) } else { acc })

effect read_requests {
  write module(name: Bytes) -> Unit
  write data(name: Bytes) -> Unit
}

fn recording_reads<a | e>(
  body: () -> a / {read_requests.module, read_requests.data | e},
) -> { value: a, modules: List<Bytes>, data: List<Bytes> } / e =
  handle {
    body()
  } with {
    var modules: List<Bytes> = [],
    var data: List<Bytes> = [],
    read_requests.module(name) -> {
      modules = modules.push(name);
    },
    read_requests.data(name) -> {
      data = data.push(name);
    },
    return value -> { value: value, modules: modules, data: data },
  }

fn pulled_by(
  user: List<Source>,
  named: List<Bytes> = [],
) -> { shipping: ShippedInputs, asked: List<Bytes> } / {abort.raise} = {
  let ran = recording_reads(||
    shipped_inputs_of(
      user,
      { root: b"", manifest: None, supplied: [] },
      shipped_modules().map(|s: Source| s.name),
      |name: Bytes| {
        read_requests.module(name);
        shipped_text(name)
      },
      |name: Bytes| None,
      dependencies_of,
      named,
    ));
  { shipping: ran.value, asked: ran.modules }
}

test "a load reads the shipped modules it imports and what those import, and no other" {
  let p = pulled_by([{ name: b"m", src: b"import std.a\npub fn f() -> Int = 1" }]);
  assert_eq(p.asked, [b"std.a", b"std.c"]);
  assert_eq(p.shipping.read.map(|s: Source| s.name), [b"std.a", b"std.c"]);
  assert_eq(p.shipping.unread, [b"std.b", b"std.d"])
}

test "a load asked for a shipped module reads and pulls it, and what it imports, though nothing imports it" {
  let user = [{ name: b"m", src: b"import std.b\npub fn f() -> Int = 1" }];
  let p = pulled_by(user, [b"std.d", b"std.a", b"std.b", b"std.nowhere"]);
  assert_eq(p.asked, [b"std.a", b"std.b", b"std.d", b"std.c"]);
  assert_eq(p.shipping.unread, []);
  let pull_rounds = |required: List<Bytes>|
    analyse_pulling_std_with(
      user,
      p.shipping.read,
      no_rows(),
      unread: p.shipping.unread,
      reached: false,
      required: required,
    );
  assert_eq(pull_rounds(p.shipping.asked).pulled, [
    b"std.a",
    b"std.b",
    b"std.d",
    b"std.prelude",
    b"std.c",
  ]);
  assert_eq(pull_rounds([]).pulled, [b"std.b", b"std.prelude"])
}

test "an asked module's tests are in a load that reads it whole, and in none that only imports another" {
  let user = [{ name: b"m", src: b"pub fn f() -> Int = 1\n" }];
  let tests_of = |p: PulledAnalysis|
    match p.out {
      Analysed(w) ->
        w.checked.tests.filter(|t: TestInfo| t.module != prelude_module()).map(|t: TestInfo| t.key),
      Refused(diagnostics) -> diagnostics.map(|d: Diagnostic| d.message),
    };
  let required = analyse_pulling_std_with(
    user,
    reached_fixture(),
    no_rows(),
    reached: false,
    required: [b"std.r"],
  );
  assert_eq(required.pulled, [prelude_module(), b"std.r", b"std.s"]);
  assert_eq(tests_of(required), [b"std.r.r holds"]);
  let plain = analyse_pulling_std_with(user, reached_fixture(), no_rows(), reached: false);
  assert_eq(plain.pulled, [prelude_module()]);
  assert_eq(tests_of(plain), [])
}

fn spinning() -> List<Source> =
  [
    {
      name: b"std.spin",
      src: b"pub fn turn(n: Int) -> Int = spin(n)\nfn spin(n: Int) -> Int = if n <= 0 { 0 } else { spin(n + 1) - 1 }\ntest \"spins\" { assert(spin(0) == 0) }\n",
    },
  ]

test "a shipped recursion not seen to end is refused alike by every load that reads it" {
  let refusals = |p: PulledAnalysis|
    match p.out {
      Analysed(_) -> [],
      Refused(diagnostics) -> diagnostics.map(|d: Diagnostic| { code: d.code, message: d.message }),
    };
  let spun = [{ code: b"E0302", message: b"`spin` may not return, and its effects do not say so" }];
  let importer = |body: Bytes| [{ name: b"m", src: b"import std.spin\n".concat(body) }];
  assert_eq(refusals(analyse_pulling_std_with(spinning(), spinning(), no_rows())), spun);
  assert_eq(
    refusals(
      analyse_pulling_std_with(
        importer(b"pub fn f() -> Int = 1\n"),
        spinning(),
        no_rows(),
        reached: false,
        required: [b"std.spin"],
      ),
    ),
    spun,
  );
  assert_eq(
    refusals(
      analyse_pulling_std_with(
        importer(b"pub fn f() -> Int = spin::turn(1)\n"),
        spinning(),
        no_rows(),
      ),
    ),
    spun,
  );
  assert_eq(
    refusals(analyse_pulling_std_with(importer(b"pub fn f() -> Int = 1\n"), spinning(), no_rows())),
    [],
  )
}

test "an asked module the load never read is refused as the front end's own fault" {
  let lazy = analyse_pulling_std_with(
    [{ name: b"m", src: b"pub fn f() -> Int = 1\n" }],
    [],
    no_rows(),
    unread: [b"std.a"],
    required: [b"std.a"],
  );
  assert_eq(
    match lazy.out {
      Analysed(_) -> [],
      Refused(diagnostics) -> diagnostics.map(|d: Diagnostic| d.code),
    },
    [b"E0505"],
  )
}

test "a load reads a compiler module's imports of its own package and the module text it embeds" {
  let texts = [
    {
      name: b"compiler.fmt",
      src: b"import compiler.lexer\npub fn f() -> Bytes = embed(\"words/table.ply\")\n",
    },
    { name: b"compiler.lexer", src: b"pub fn l() -> Int = 1\n" },
    { name: b"compiler.words.table", src: b"" },
    { name: b"compiler.unit", src: b"pub fn u() -> Int = 2\n" },
  ];
  let s = shipped_inputs_of(
    [{ name: b"app", src: b"import compiler.fmt\nfn main() -> Unit = ()\n" }],
    { root: b"", manifest: None, supplied: [] },
    texts.map(|t: Source| t.name),
    |name: Bytes|
      texts.fold(None, |acc: Option<Bytes>, t: Source|
        if t.name == name { Some(t.src) } else { acc }),
    |name: Bytes| None,
    dependencies_of,
  );
  assert_eq(s.read.map(|t: Source| t.name), [
    b"compiler.fmt",
    b"compiler.words.table",
    b"compiler.lexer",
  ]);
  assert_eq(s.unread, [b"compiler.unit"]);
  assert_eq(s.data, [])
}

test "a load reads the library's module text and data file a compiler module embeds" {
  let texts = [
    {
      name: b"compiler.fmt",
      src: b"pub fn f() -> Bytes = embed(\"../std/words.ply\")\npub fn g() -> Bytes = embed(\"../std/oid/names.txt\")\n",
    },
    { name: b"std.words", src: b"" },
  ];
  let s = shipped_inputs_of(
    [{ name: b"app", src: b"import compiler.fmt\nfn main() -> Unit = ()\n" }],
    { root: b"", manifest: None, supplied: [] },
    texts.map(|t: Source| t.name),
    |name: Bytes|
      texts.fold(None, |acc: Option<Bytes>, t: Source|
        if t.name == name { Some(t.src) } else { acc }),
    |name: Bytes| if name == b"std/oid/names.txt" { Some(b"2.5.4.3 cn\n") } else { None },
    dependencies_of,
  );
  assert_eq(s.read.map(|t: Source| t.name), [b"compiler.fmt", b"std.words"]);
  assert_eq(s.data.map(|d: { name: Bytes, bytes: Bytes }| d.name), [b"std/oid/names.txt"])
}

fn data_pulled_by(
  user: List<Source>,
  named: List<Bytes> = [],
) -> { shipping: ShippedInputs, modules: List<Bytes>, data: List<Bytes> } / {abort.raise} = {
  let texts = [
    {
      name: b"std.words",
      src: b"pub fn list() -> Bytes = embed(\"words/list.txt\")\npub fn again() -> Bytes = embed(\"./words/list.txt\")\n",
    },
    { name: b"std.idle", src: b"pub fn rest() -> Bytes = embed(\"idle/rest.txt\")\n" },
  ];
  let ran = recording_reads(||
    shipped_inputs_of(
      user,
      { root: b"", manifest: None, supplied: [] },
      texts.map(|t: Source| t.name),
      |name: Bytes| {
        read_requests.module(name);
        texts.fold(None, |acc: Option<Bytes>, t: Source|
          if t.name == name { Some(t.src) } else { acc })
      },
      |name: Bytes| {
        read_requests.data(name);
        if name == b"std/words/list.txt" { Some(b"one\ntwo\n") } else { None }
      },
      dependencies_of,
      named,
    ));
  { shipping: ran.value, modules: ran.modules, data: ran.data }
}

test "a load asked for a shipped module reads the data file it embeds, though nothing imports it" {
  let p = data_pulled_by([{ name: b"m", src: b"pub fn f() -> Int = 1" }], [b"std.words"]);
  assert_eq(p.modules, [b"std.words"]);
  assert_eq(p.data, [b"std/words/list.txt"]);
  assert_eq(p.shipping.data, [{ name: b"std/words/list.txt", bytes: b"one\ntwo\n" }]);
  assert_eq(p.shipping.unread, [b"std.idle"])
}

test "a load reads the data files the shipped modules it pulls embed, each once, and no other's" {
  let p = data_pulled_by([{ name: b"m", src: b"import std.words\npub fn f() -> Int = 1" }]);
  assert_eq(p.modules, [b"std.words"]);
  assert_eq(p.data, [b"std/words/list.txt"]);
  assert_eq(p.shipping.data, [{ name: b"std/words/list.txt", bytes: b"one\ntwo\n" }]);
  assert_eq(p.shipping.unread, [b"std.idle"]);
  let none = data_pulled_by([{ name: b"m", src: b"pub fn f() -> Int = 1" }]);
  assert_eq(none.data, []);
  assert_eq(none.shipping.data, [])
}

test "handed only what a load reads, the front end pulls and answers as it does over every module" {
  let user = [{ name: b"m", src: b"import std.b\nimport std.a\npub fn f() -> Int = 1" }];
  let p = pulled_by(user);
  let whole = analyse_pulling_std(user, shipped_modules());
  let lazy = analyse_pulling_std_with(user, p.shipping.read, no_rows(), unread: p.shipping.unread);
  assert_eq(lazy.pulled, whole.pulled);
  assert_eq(dump_of(lazy.out), dump_of(whole.out))
}

test "a module that does not ship is reported listing every one that does, read or not" {
  let user = [{ name: b"m", src: b"import std.e\npub fn f() -> Int = 1" }];
  let p = pulled_by(user);
  assert_eq(p.shipping.read, []);
  let lazy = analyse_pulling_std_with(user, [], no_rows(), unread: p.shipping.unread);
  let whole = analyse_pulling_std(user, shipped_modules());
  assert_eq(dump_of(lazy.out), dump_of(whole.out))
}

fn compiler_shipped() -> List<Source> =
  [
    { name: b"compiler.a", src: b"import compiler.b (second)\npub fn first() -> Int = second()" },
    { name: b"compiler.b", src: b"pub fn second() -> Int = 1" },
  ]

test "a shipped compiler module is pulled in under the compiler's root" {
  let a = pulled_dump(
    [{ name: b"m", src: b"import compiler.a (first)\npub fn f() -> Int = first()" }],
    compiler_shipped(),
  );
  assert_eq(a.pulled, [b"compiler.a", prelude_module(), b"compiler.b"]);
  assert_eq(a.dump.diagnostics, []);
  assert_eq(
    a.dump.definitions.filter(|row: DefinitionRow| row.name == b"compiler.a.first").len(),
    1,
  )
}

fn library_over_compiler() -> List<Source> =
  [
    { name: b"std.base", src: b"pub fn one() -> Int = 1" },
    {
      name: b"std.reader",
      src: b"import compiler.a (first)\nimport std.base (one)\npub fn read() -> Int = first() + one()",
    },
    {
      name: b"compiler.a",
      src: b"import compiler.b (second)\nimport std.base (one)\npub fn first() -> Int = second() + one()\npub fn unreached() -> Int = 0",
    },
    { name: b"compiler.b", src: b"import std.deep (two)\npub fn second() -> Int = two()" },
    { name: b"std.deep", src: b"pub fn two() -> Int = 2\npub fn idle() -> Int = 0" },
  ]

test "library modules read apart pull the compiler's modules they import, and what those import, each for what is reached" {
  let all = library_over_compiler();
  let own = all.filter(|s: Source| s.name == b"std.base" || s.name == b"std.reader");
  let pulled = checked_staged(staged_pulling_std_with(own, all, apart: true), no_rows());
  assert_eq(pulled.pulled, [b"compiler.a", prelude_module(), b"compiler.b", b"std.deep"]);
  let d = dump_of(pulled.out);
  assert_eq(d.diagnostics, []);
  assert_eq(d.definitions.map(|row: DefinitionRow| row.name), [
    b"std.base.one",
    b"std.reader.read",
    b"compiler.a.first",
    b"compiler.b.second",
    b"std.deep.two",
  ]);
  assert_eq(d.packages, [
    { prefix: b"", dependencies: [] },
    { prefix: b"compiler", dependencies: [b"std"] },
  ]);
  assert_eq(d.module_packages, [0, 0, 1, 2, 1, 2])
}

fn messages(d: Dump) -> List<Bytes> = d.diagnostics.map(|diagnostic: Diagnostic| diagnostic.message)

test "a shipped module importing outside the shipped modules is the compiler's own defect" {
  let a = pulled_dump(
    [{ name: b"m", src: b"import compiler.a (first)\npub fn f() -> Int = first()" }],
    [{ name: b"compiler.a", src: b"import std.e (e)\npub fn first() -> Int = e()" }],
  );
  assert(
    messages(a.dump).contains(
      b"the shipped module `compiler.a` imports `std.e`, which this build does not ship",
    ),
  )
}

test "a shipped module importing outside the shipped ones is placed in that module, which the answer names" {
  let a = pulled_dump([{ name: b"m", src: b"import std.x\npub fn f() -> Int = 1" }], [
    { name: b"std.x", src: b"import m\npub fn x() -> Int = 1" },
  ]);
  assert_eq(a.pulled, [prelude_module(), b"std.x"]);
  let said = a.dump.diagnostics.filter(|diagnostic: Diagnostic|
    diagnostic.message
      == b"the shipped module `std.x` imports `m`, which this build does not ship");
  assert_eq(said.map(|diagnostic: Diagnostic| diagnostic.labels), [
    [
      {
        module: 2,
        start: 7,
        end: 8,
        primary: true,
        text: b"a stdlib module may import only modules that ship with it",
      },
    ],
  ])
}

fn answered() -> List<Source> =
  [
    {
      name: b"base",
      src: b"pub effect log { write emit(Bytes) -> Unit }\npub type Shape = | Dot | Line(Int)\npub fn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\npub fn same(x: Int) -> Int = x",
    },
    { name: b"app", src: b"import base\nimport std.b\npub fn two() -> Int = base::same(2)" },
  ]

fn definition_named(d: Dump, name: Bytes) -> DefinitionRow / {abort.raise} =
  match d.definitions.fold(None, |acc: Option<DefinitionRow>, r: DefinitionRow|
      if r.name == name { Some(r) } else { acc }) {
    Some(r) -> r,
    None -> panic("the dump holds the definition"),
  }

test "the answer's rows hold each type and row as the checker's value" {
  let a = pulled_dump(answered(), shipped_modules());
  assert_eq(a.pulled, [b"std.b", prelude_module()]);
  let same = definition_named(a.dump, b"base.same");
  assert_eq(same.effects, []);
  let write: Effect = { effect: b"base.log", resource: SingletonResource, mode: WriteMode, op: None };
  let say = definition_named(a.dump, b"base.say");
  assert_eq(say.effects, [write]);
  assert_eq(
    a.dump.constructors.filter(|k: ConstructorRow| k.name == b"base.Line").map(
      |k: ConstructorRow| k.fields,
    ),
    [[int_type()]],
  )
}

test "a refused program's answer is its diagnostics, placed where it went wrong, with no rows" {
  let bad = [{ name: b"m", src: b"fn f() -> Int = \"x\"" }];
  let a = pulled_dump(bad, []);
  assert_eq(a.pulled, [prelude_module()]);
  assert_eq(a.dump.diagnostics, [
    {
      code: b"E0201",
      notes: 0,
      labels: [
        { module: 0, start: 16, end: 19, primary: true, text: b"expected `Int`, found `String`" },
      ],
      text: b"",
      message: b"type mismatch: function body type",
      notes_text: [],
      severity: b"error",
      fixes: [],
    },
  ]);
  assert_eq(a.dump.order, []);
  assert_eq(a.dump.modules, []);
  assert_eq(a.dump.definitions, []);
  assert_eq(a.dump.tests, []);
  assert_eq(a.dump.hashes, [])
}

test "claims read the bodies the check filed, as a walk again settles them" {
  let a = analysis_of([
    {
      name: b"m",
      src: b"pub type P = { x: Int, y: Int }\n\npub fn moved(p: P) -> P\n  ensures result.x == p.x + 1\n= { ..p, x: p.x + 1 }\n",
    },
  ]);
  match facts_read(rows_of(a), inferred_facts(a), None, a.modules) {
    Err(why) -> panic(String::of_bytes_lossy(why)),
    Ok(f) -> {
      let filed = bodies_read(f.bodies, f.types).filter(|b: TypedBody<Type>| b.owner == b"m.moved");
      assert(filed.len() > 0, Some("the check filed no body"));
      assert_eq(filed, rechecked(a, [0]).filter(|b: TypedBody<Type>| b.owner == b"m.moved"))
    },
  }
}

fn analysis_of(sources: List<Source>) -> Analysis / {abort.raise} =
  match analyse(parse_all(sources)) { Refused(_) -> panic("the program checks"), Analysed(w) -> w }

test "a statement site is a perform or a labelled call, its arguments read as a check computes them" {
  let w = analysis_of([
    {
      name: b"store",
      src: b"pub type Param = | PInt(Int) | PNull\npub type Stmt = { sql: String }\npub fn stmt(sql: String) -> Stmt = { sql: sql }\npub effect db { read query[t](s: Stmt, ps: List<Param>) -> Int }\npub fn run<[t]>(s: Stmt) -> Int / {db.query[t]} = db.query[t](s, [])\n",
    },
    {
      name: b"app",
      src: b"import store\nimport store (db)\nfn q() -> store::Stmt = store::stmt(\"select \" ++ \"sku from items\")\npub fn f(n: Int, p: store::Param) -> Int / {db.query[items]} = db.query[items](q(), [store::PInt(n), store::PNull, p])\npub fn g() -> Int / {db.query[items]} = store::run[items](store::stmt(\"select 1\"))\n",
    },
  ]);
  let hash_of = |name: Bytes|
    match by_name(w.hashes.definitions).get(name) { Some(h) -> h, None -> b"" };
  let statement_sites = |callees: List<Bytes>|
    range(0, w.modules.len()).fold([], |acc: List<StatementSite>, i: Int|
      acc.concat(sites_in(w, i, |c: Bytes| callees.contains(c), by_name(w.hashes.definitions))));
  let sites = statement_sites([b"store.db.query", b"store.run"]);
  assert_eq(sites.map(|s: StatementSite| (s.callee, s.label)), [
    (b"store.db.query", b"t"),
    (b"store.db.query", b"items"),
    (b"store.run", b"items"),
  ]);
  assert_eq(sites.map(|s: StatementSite| s.args), [
    [OtherArgument, ListArgument([])],
    [
      CallArgument({ callee: b"app.q", hash: hash_of(b"app.q"), args: [] }),
      ListArgument([
        ConstructorArgument({ type_name: b"store.Param", name: b"PInt" }),
        ConstructorArgument({ type_name: b"store.Param", name: b"PNull" }),
        OtherArgument,
      ]),
    ],
    [
      CallArgument({
        callee: b"store.stmt",
        hash: hash_of(b"store.stmt"),
        args: [TextArgument(b"select 1")],
      }),
    ],
  ]);
  assert_eq(statement_sites([b"store.other"]).len(), 0)
}

test "a statement module's own calls are no statements a check holds to a database, its importers' are" {
  let w = analysis_of([
    {
      name: b"std.db",
      src: b"pub type Stmt = { sql: String }\npub fn stmt(sql: String) -> Stmt = { sql: sql }\npub effect db { read query[t](s: Stmt) -> Int }\npub fn own() -> Int / {db.query[items]} = db.query[items](stmt(\"insert one\"))\n",
    },
    {
      name: b"std.user",
      src: b"import std.db as base\nimport std.db (db)\npub fn f() -> Int / {db.query[items]} = db.query[items](base::stmt(\"select 1\"))\n",
    },
  ]);
  assert_eq(statements_of(w, 0), []);
  assert_eq(statements_of(w, 1).map(|s: StatementSite| s.callee), [b"std.db.db.query"])
}

fn seeded_of(outcome: AnalysisOutcome) -> List<Bytes> / {abort.raise} =
  match outcome { Refused(_) -> panic("the program checks"), Analysed(w) -> w.checked.seeded }

fn effectful() -> List<Source> =
  [
    {
      name: b"base",
      src: b"pub effect log { write emit(Bytes) -> Unit }\npub fn say(b: Bytes) -> Unit / { log.write } = log.emit(b)",
    },
    {
      name: b"app",
      src: b"import base\nfn twice(b: Bytes) -> Unit / {base::log.write} = base::say(b)\ntest \"says\" { twice(b\"x\") }",
    },
  ]

pub type Published = { dump: Dump, schemes: List<{ name: Bytes, scheme: Scheme }> }

pub fn published(outcome: AnalysisOutcome) -> Published / {abort.raise} =
  {
    dump: { ..dump_of(outcome), walked: b"" },
    schemes: match outcome {
      Refused(_) -> [],
      Analysed(w) ->
        w.checked.definitions.map(|definition_info: DefinitionInfo|
          { name: definition_info.name, scheme: definition_info.scheme }),
    },
  }

fn scheme_named(p: Published, name: Bytes) -> Scheme / {abort.raise} =
  match p.schemes.fold(None, |acc: Option<Scheme>, s: { name: Bytes, scheme: Scheme }|
      if s.name == name { Some(s.scheme) } else { acc }) {
    Some(sc) -> sc,
    None -> panic("the analysis checked the definition"),
  }

test "two programs alike but for what the checker met first publish one definition" {
  let pick = b"pub fn pick<p, q>(x: p, y: q, f: (p) -> q) -> List<q> = [f(x), y]";
  let alone = [{ name: b"m", src: pick }];
  let behind = [
    { name: b"a", src: b"pub fn first<c, d, e>(x: c, y: d, z: e) -> c = x" },
    { name: b"m", src: pick },
  ];
  let raw = |sources: List<Source>|
    analysis_of(sources).checked.definitions.fold(
      None,
      |acc: Option<Scheme>, definition_info: DefinitionInfo|
        if definition_info.name == b"m.pick" { Some(definition_info.scheme) } else { acc },
    );
  assert_eq(raw(alone), raw(behind));
  let one = published(analyse(parse_all(alone)));
  let two = published(analyse(parse_all(behind)));
  assert_eq(scheme_named(one, b"m.pick"), scheme_named(two, b"m.pick"));
  assert_eq(
    definition_named(one.dump, b"m.pick").effects,
    definition_named(two.dump, b"m.pick").effects,
  );
  assert_eq(scheme_named(one, b"m.pick").type_variables, [0, 1])
}

test "a definition whose hash has not moved is published from its rows, not from its body" {
  let rows = rows_of(analysis_of(effectful()));
  assert(rows.definitions.len() > 0);
  assert(rows.tests.len() > 0);
  let seeded = analyse_with(parse_all(effectful()), rows);
  assert_eq(seeded_of(seeded), [b"base.say", b"app.twice"]);
  assert_eq(published(seeded), published(analyse(parse_all(effectful()))));
  assert_eq(seeded_of(analyse(parse_all(effectful()))), [])
}

fn generic() -> List<Source> =
  [
    {
      name: b"base",
      src: b"pub effect log { write emit(Bytes) -> Unit }\npub fn around<a | e>(f: () -> a / e) -> a / {log.write | e} = {\n  log.emit(b\"in\");\n  f()\n}\npub fn bare<a | e>(f: () -> a / e) -> a / e = f()",
    },
    {
      name: b"app",
      src: b"import base\nfn twice(b: Bytes) -> Unit / {base::log.write} = base::around(|| base::bare(|| base::log.emit(b)))\ntest \"says\" { twice(b\"x\") }",
    },
  ]

test "a definition generic over a row is published from its rows, ending in the row it writes" {
  let rows = rows_of(analysis_of(generic()));
  let seeded = analyse_with(parse_all(generic()), rows);
  assert_eq(seeded_of(seeded), [b"base.around", b"base.bare", b"app.twice"]);
  assert_eq(published(seeded), published(analyse(parse_all(generic()))))
}

test "rows filed under a hash this program no longer has are walked instead" {
  let rows = rows_of(analysis_of(effectful()));
  let stale = rows.definitions.map(|row: KnownDefinitionRow|
    { ..row, hash: b"moved", effects: b"nowhere.read", performed: b"nowhere.read" });
  let walked = analyse_with(parse_all(effectful()), { ..rows, definitions: stale, tests: [] });
  assert_eq(seeded_of(walked), []);
  assert_eq(published(walked), published(analyse(parse_all(effectful()))))
}

fn test_effects_of(outcome: AnalysisOutcome, key: Bytes) -> Bytes / {abort.raise} =
  match outcome {
    Refused(_) -> b"<refused>",
    Analysed(w) ->
      w.checked.tests.fold(b"", |acc: Bytes, test_info: TestInfo|
        if test_info.key == key { effect_list_text(test_info.effects, b",") } else { acc }),
  }

test "a test's footprint and a law's leave out a raise, which the run answers" {
  let a = analyse(
    parse_all([
      {
        name: b"m",
        src: b"pub effect log { write put(Bytes) -> Unit }\nfn half(n: Int, d: Int) -> Int / {abort.raise} = n / d\ntest \"halves\" { log.put(b\"x\"); assert_eq(half(4, 2), 2) }\nlaw \"whole\" forall (n: Int) { half(n, 1) == n }",
      },
    ]),
  );
  assert_eq(test_effects_of(a, b"m.halves"), b"m.log.put");
  match a {
    Refused(_) -> panic("the program checks"),
    Analysed(w) -> assert_eq(w.checked.laws.map(|l: LawInfo| l.effects), [[]]),
  }
}

fn moded() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub effect store { read peek[t]() -> Int  write put[t](n: Int) -> Unit }\ntest \"reads\" { handle { assert_eq(store.peek[a](), 1) } with { store.peek[a]() -> 1 } }\ntest \"touches\" { let n = store.peek[b](); store.put[b](n) }",
    },
  ]

test "a test's row read back from the cache has each operation's mode as its declaration gives it" {
  let cold = analysis_of(moded());
  let rows = rows_of(cold);
  match analyse_with(parse_all(moded()), rows) {
    Refused(_) -> panic("the seeded program checks"),
    Analysed(warm) ->
      assert_eq(
        warm.checked.tests.map(|test_info: TestInfo| test_info.effects),
        cold.checked.tests.map(|test_info: TestInfo| test_info.effects),
      ),
  }
}

fn lookup_or_empty(m: Map<Bytes, Bytes>, name: Bytes) -> Bytes =
  match m.get(name) { Some(h) -> h, None -> b"" }

fn effects_text_of(outcome: AnalysisOutcome, name: Bytes) -> Bytes / {abort.raise} =
  match outcome {
    Refused(_) -> b"<refused>",
    Analysed(w) ->
      w.checked.definitions.fold(b"", |acc: Bytes, definition_info: DefinitionInfo|
        if definition_info.name == name { effect_list_text(definition_info.effects, b",") } else { acc }),
  }

fn two_effects() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub effect log { write put() -> Unit }\npub effect other { write put() -> Unit }\npub fn say() -> Unit / {log.write} = log.put()\npub fn quiet(x: Int) -> Int = x",
    },
  ]

fn wrong_rows(sources: List<Source>) -> List<KnownDefinitionRow> / {abort.raise} =
  match analyse(parse_all(sources)) {
    Refused(_) -> panic("the program checks"),
    Analysed(w) -> {
      let definitions = by_name(w.hashes.definitions);
      let schemes = w.checked.definitions.fold(
        Map::new(),
        |acc: Map<Bytes, Scheme>, d: DefinitionInfo| acc.insert(d.name, canonical_scheme(d.scheme)),
      );
      let witness = [
        { name: b"m.other", hash: lookup_or_empty(by_name(w.hashes.declarations), b"m.other") },
      ];
      [b"m.say", b"m.quiet"].map(|n: Bytes|
        {
          name: n,
          hash: lookup_or_empty(definitions, n),
          effect_hashes: witness,
          effects: b"m.other.write",
          performed: b"m.other.write",
          scaling: b"",
          repeats: [],
          ending: Terminates,
          summary: unknown_summary(),
          raises: [],
          facts: encode_facts(no_body_facts()),
          scheme: match schemes.get(n) { Some(s) -> s, None -> panic("the fixture declares it") },
        })
    },
  }

test "a row that will not unify walks the body rather than reporting" {
  let sources = two_effects();
  let seeded = analyse_with(parse_all(sources), { ..no_rows(), definitions: wrong_rows(sources) });
  assert_eq(effects_text_of(seeded, b"m.quiet"), b"");
  assert_eq(effects_text_of(seeded, b"m.say"), b"m.log.write");
  assert_eq(
    effects_text_of(seeded, b"m.say"),
    effects_text_of(analyse(parse_all(sources)), b"m.say"),
  );
  assert_eq(seeded_of(seeded), [])
}

test "an analysis seeded with its own rows answers exactly what a fresh one does" {
  let rows = rows_of(analysis_of(effectful()));
  let seeded = analyse_with(parse_all(effectful()), rows);
  assert_eq(seeded_of(seeded).len(), rows.definitions.len());
  assert_eq(published(seeded), published(analyse(parse_all(effectful()))));
  assert_eq(test_effects_of(seeded, b"app.says"), b"base.log.write")
}

fn labelled() -> List<Source> =
  [
    {
      name: b"m",
      src: b"effect net { write send[r](Bytes) -> Unit }\npub fn relay<[l]>(b: Bytes) -> Unit / {net.send[l]} = net.send[l](b)\npub fn both<[a], [c]>(b: Bytes) -> Unit / {net.send[a], net.send[c]} = { relay[c](b); relay[a](b) }\npub fn go(b: Bytes) -> Unit / {net.send[conn]} = both[conn, conn](b)\n",
    },
  ]

test "a definition generic over labels is seeded from its rows, each label as its parameter" {
  let rows = rows_of(analysis_of(labelled()));
  let seeded = analyse_with(parse_all(labelled()), rows);
  assert_eq(seeded_of(seeded), [b"m.relay", b"m.both", b"m.go"]);
  assert_eq(published(seeded), published(analyse(parse_all(labelled()))))
}

fn looping(above: Bytes, between: Bytes) -> List<Source> =
  [
    {
      name: b"m",
      src: Bytes::concat_all([
        above,
        b"fn spin(n: Int) -> Int / {diverges} = hop(n + 1)\n",
        between,
        b"fn hop(n: Int) -> Int / {diverges} = spin(n)\npub fn wait(n: Int) -> Int / {diverges} = spin(n)\n",
      ]),
    },
  ]

fn endings(outcome: AnalysisOutcome) -> List<{ name: Bytes, ending: Termination }> / {abort.raise} =
  match outcome {
    Refused(_) -> panic("the program checks"),
    Analysed(w) ->
      w.checked.definitions.map(|definition_info: DefinitionInfo|
        { name: definition_info.name, ending: definition_info.ending }),
  }

test "a seeded ending is where its call is now, however its definitions moved" {
  let rows = rows_of(analysis_of(looping(b"", b"")));
  let moved = looping(b"pub fn aside() -> Int = 3\n", b"pub fn apart() -> Int = 4\n");
  let seeded = analyse_with(parse_all(moved), { ..rows, tests: [] });
  assert_eq(seeded_of(seeded), [b"m.spin", b"m.hop", b"m.wait"]);
  assert_eq(endings(seeded), endings(analyse(parse_all(moved))))
}

fn reading(above: Bytes) -> List<Source> =
  [
    {
      name: b"m",
      src: above.concat(
        b"pub fn at(b: Bytes, i: Int) -> Int / {abort.raise} = if i < b.len() { b.at(i) } else { 0 }\npub fn walk(b: Bytes, i: Int) -> Int / {abort.raise} = if i < 0 || i >= b.len() { 0 } else { b.at(i) + walk(b, i + 1) }\n",
      ),
    },
  ]

fn raises_filed(
  outcome: AnalysisOutcome,
) -> List<{ name: Bytes, raises: Int, performed: Int }> / {abort.raise} =
  match outcome {
    Refused(_) -> panic("the program checks"),
    Analysed(w) ->
      w.checked.definitions.map(|definition_info: DefinitionInfo|
        {
          name: definition_info.name,
          raises: definition_info.raises.len(),
          performed: definition_info.performed.len(),
        }),
  }

test "a seeded definition raises where a walk of it found, however it moved" {
  let rows = rows_of(analysis_of(reading(b"")));
  let moved = reading(b"pub fn aside() -> Int = 3\n");
  let seeded = analyse_with(parse_all(moved), { ..rows, tests: [] });
  assert_eq(seeded_of(seeded), [b"std.prelude.List::at", b"m.at", b"m.walk"]);
  assert_eq(
    raises_filed(seeded).filter(|r: { name: Bytes, raises: Int, performed: Int }|
      module_of_name(r.name) == b"m"),
    [
      { name: b"m.aside", raises: 0, performed: 0 },
      { name: b"m.at", raises: 1, performed: 1 },
      { name: b"m.walk", raises: 0, performed: 0 },
    ],
  );
  assert_eq(raises_filed(seeded), raises_filed(analyse(parse_all(moved))))
}

fn declared() -> List<Source> =
  [
    {
      name: b"m",
      src: b"pub type Shape = | Circle(Int) | Empty\npub nondet effect wall { read now() -> Int\n write set[r](Int) -> Unit }\npub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\npub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\ntest \"two is even\" { assert(even(2)) }",
    },
  ]

test "every body is filed under the hash it verifies as, a cycle's members included" {
  let w = analysis_of(declared());
  let bodies = stored_bodies(w.hashes);
  assert(bodies.len() > 0);
  assert(bodies.fold(true, |acc: Bool, b: StoredBody| acc && body_key(b.body) == Some(b.hash)));
  assert_eq(bodies.len(), w.hashes.definitions.len() + w.hashes.declarations.len());
  let even = lookup_or_empty(by_name(w.hashes.definitions), b"m.even");
  assert(bodies.fold(false, |acc: Bool, b: StoredBody| acc || b.hash == even))
}

fn hash_of(sources: List<Source>, name: Bytes) -> Bytes / {abort.raise} =
  match resolve_modules(
      parse_all(with_prelude_source(sources)).map(|parsed: ParsedSource| parsed.module),
    ) {
    ResolveFailed(_) -> b"",
    ResolveSucceeded(x) -> match by_name(
        hash_index(build_index(x.modules, x.r).index).definitions,
      ).get(
        name,
      ) {
      Some(h) -> h,
      None -> b"",
    },
  }

test "a map or a set literal and the call it builds are one definition" {
  let set = {
    name: b"std.set",
    src: b"pub type Set<a> = | Set(Map<a, Unit>)\npub fn Set::of_list<a>(xs: List<a>) -> Set<a> = Set(Map::new())\n",
  };
  let literal = [
    set,
    {
      name: b"m",
      src: b"import std.set (Set)\npub fn two() -> Map<Int, Int> = #{1: 2, 3: 4}\npub fn s() -> Set<Int> = #[5]",
    },
  ];
  let call = [
    set,
    {
      name: b"m",
      src: b"import std.set (Set)\npub fn two() -> Map<Int, Int> = Map::of_entries([{key: 1, value: 2}, {key: 3, value: 4}])\npub fn s() -> Set<Int> = Set::of_list([5])",
    },
  ];
  assert(hash_of(literal, b"m.two") != b"");
  assert_eq(hash_of(literal, b"m.two"), hash_of(call, b"m.two"));
  assert_eq(hash_of(literal, b"m.s"), hash_of(call, b"m.s"))
}

test "a qualified name that is not exported moves the hash of everything that names it" {
  let caller = b"import a\npub fn two() -> Int = a::one()";
  let exported = [{ name: b"a", src: b"pub fn one() -> Int = 1" }, { name: b"b", src: caller }];
  let shut = [{ name: b"a", src: b"fn one() -> Int = 1" }, { name: b"b", src: caller }];
  assert(hash_of(exported, b"b.two") != b"");
  assert(hash_of(shut, b"b.two") != hash_of(exported, b"b.two"));
  assert_eq(hash_of(shut, b"a.one"), hash_of(exported, b"a.one"))
}

test "a project's manifest is checked ahead of the program and carried decoded" {
  let good = analyse_with(parse_all(program()), no_rows(), {
    root: b".",
    manifest: Some(
      b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"m\", version: {major: 0, minor: 1, patch: 0}, prefix: None, runtime: {major: 0, minor: 1, patch: 0}, dependencies: [], entry: None}",
    ),
    supplied: [],
  });
  match good {
    Refused(ds) -> assert_eq(ds.map(|diagnostic: Diagnostic| diagnostic.code), []),
    Analysed(w) -> match w.manifest { None -> assert(false), Some(m) -> assert_eq(m.name, "m") },
  };
  let malformed = analyse_with(parse_all(program()), no_rows(), {
    root: b".",
    manifest: Some(b"fn package() -> Int = 1"),
    supplied: [],
  });
  match malformed {
    Analysed(_) -> assert(false),
    Refused(ds) -> {
      assert_eq(ds.get(0).code, b"E0129");
      assert_eq(ds.get(0).labels.get(0).module, 2)
    },
  };
  match analyse_with(parse_all(program()), no_rows()) {
    Refused(_) -> assert(false),
    Analysed(w) -> assert_eq(w.manifest, None),
  }
}

fn with_lib(user: List<Source>) -> PackageSources =
  {
    root: b"app",
    manifest: Some(
      b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"app\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [{name: \"lib\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Path(\"../lib\")}], entry: None}",
    ),
    supplied: [
      {
        root: b"lib",
        manifest: Some(
          b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"lib\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}",
        ),
        modules: [
          { name: b"answer", src: b"pub fn answer() -> Int = 42" },
          { name: b"extra", src: b"fn hidden() -> Int = 1" },
        ],
      },
    ],
  }

test "a declared dependency's modules answer under its prefix" {
  let user = [{ name: b"m", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  match analyse_with(parse_all(user), no_rows(), with_lib(user)) {
    Refused(ds) -> assert_eq(ds.map(|diagnostic: Diagnostic| diagnostic.code), []),
    Analysed(_) -> assert(true),
  }
}

test "an undeclared dependency's modules refuse, naming holder and importer" {
  let user = [{ name: b"m", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  let packages = with_lib(user);
  let undeclared = analyse_with(parse_all(user), no_rows(), {
    root: b"app",
    manifest: Some(
      b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"app\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [], entry: None}",
    ),
    supplied: packages.supplied,
  });
  match undeclared {
    Analysed(_) -> assert(false),
    Refused(ds) -> assert_eq(ds.get(0).code, b"E0132"),
  }
}

test "a dependency's own imports are siblings of its prefix, not of the root" {
  let user = [{ name: b"m", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  let packages = with_lib(user);
  let supplied = [
    {
      root: b"lib",
      manifest: packages.supplied.get(0).manifest,
      modules: [
        { name: b"answer", src: b"import extra\npub fn answer() -> Int = extra::hidden()" },
        { name: b"extra", src: b"fn hidden() -> Int = 1" },
      ],
    },
  ];
  let package_closure = closure(
    { ..packages, supplied: supplied },
    user.map(|source: Source| source.name),
  );
  assert_eq(package_closure.diagnostics, []);
  assert_eq(package_closure.modules.map(|m: { pkg: Int, src: Source }| m.src.name), [
    b"lib.answer",
    b"lib.extra",
  ])
}

test "a missing dependency manifest is unusable where it is declared" {
  let user = [{ name: b"m", src: b"fn main() -> Int = 1" }];
  let packages = with_lib(user);
  let package_closure = closure(
    { ..packages, supplied: [{ root: b"lib", manifest: None, modules: [] }] },
    user.map(|source: Source| source.name),
  );
  assert_eq(package_closure.diagnostics.get(0).diagnostic.code, b"E0135")
}

test "a cycle of packages is refused, naming the cycle" {
  let user = [{ name: b"m", src: b"fn main() -> Int = 1" }];
  let manifest_dependency = b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"n\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [{name: \"other\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Path(\"../other\")}], entry: None}";
  let package_closure = closure(
    {
      root: b"a",
      manifest: Some(manifest_dependency),
      supplied: [
        { root: b"other", manifest: Some(manifest_dependency), modules: [] },
        { root: b"other/other", manifest: Some(manifest_dependency), modules: [] },
      ],
    },
    [],
  );
  assert(has_diagnostic(package_closure.diagnostics, b"E0134"))
}

fn has_diagnostic(
  diagnostics: List<{ slot: Int, diagnostic: ParseDiagnostic }>,
  code: Bytes,
) -> Bool =
  diagnostics.fold(false, |acc: Bool, sd: { slot: Int, diagnostic: ParseDiagnostic }|
    acc || sd.diagnostic.code == code)

type Read = { want: EmbedRequest, read: EmbedResult }

fn embedding_in(
  packages: PackageSources,
  user: List<Source>,
  reads: List<Read>,
) -> AnalysisOutcome / {abort.raise} =
  analyse_pulling_std_with(
    user,
    [],
    no_rows(),
    packages,
    reads.map(|r: Read| { root: packages.root, module: b"m", want: r.want, read: r.read }),
  ).out

fn embedding(src: Bytes, reads: List<Read>) -> AnalysisOutcome / {abort.raise} =
  embedding_in({ root: b"r", manifest: None, supplied: [] }, [{ name: b"m", src: src }], reads)

fn a_file(bytes: Bytes) -> Read = file_at(b"d.txt", bytes)

fn file_at(path: Bytes, bytes: Bytes) -> Read =
  { want: { path: path, dir: false }, read: Ok([embed_file(b"", bytes)]) }

fn checked_analysis(outcome: AnalysisOutcome) -> Analysis / {abort.raise} =
  match outcome {
    Refused(ds) ->
      panic(
        String::of_bytes_lossy(
          Bytes::join(
            ds.map(|diagnostic: Diagnostic|
              Bytes::concat_all([diagnostic.code, b": ", diagnostic.message])),
            b"; ",
          ),
        ),
      ),
    Analysed(w) -> w,
  }

fn definition_hash_in(outcome: AnalysisOutcome, name: Bytes) -> Bytes / {abort.raise} =
  match checked_analysis(outcome).hashes.definitions.filter(|d: { name: Bytes, hash: Bytes }|
      d.name == name) {
    [d, ..] -> d.hash,
    [] -> panic("no such definition"),
  }

fn refused_codes(outcome: AnalysisOutcome) -> List<Bytes> =
  match outcome {
    Refused(ds) -> ds.map(|diagnostic: Diagnostic| diagnostic.code),
    Analysed(_) -> [],
  }

test "only a module that may call `embed` is parsed for what it embeds" {
  assert(may_call_embed(b"embed(\"x\")"));
  assert(may_call_embed(b"fn f() -> Bytes = embed_dir (\"x\")"));
  assert(may_call_embed(b"fn f() -> Bytes = embed\n  // why\n  (\"x\")"));
  assert(!may_call_embed(b"fn embeds() -> Int = 1"));
  assert(!may_call_embed(b"import embed (EmbedAt, wants_of)\n"));
  assert(!may_call_embed(b"let embedded = an_embed(1)"));
  assert(!may_call_embed(b"// what the embed reads"));
  assert(!may_call_embed(b"x embed"))
}

test "a load hands on what each item asks to embed, from what the text was kept as pulling where it was" {
  let a: Source = { name: b"a", src: b"pub fn text() -> Bytes = embed(\"x.txt\")\n" };
  let read = [
    {
      root: b"",
      module: b"a",
      want: { path: b"x.txt", dir: false },
      read: Ok([embed_file(b"", b"one")]),
    },
  ];
  let items = |pulls: List<ModuleDependencies>|
    match staged_pulling_std_with([a], [], embeds: read, pulls: pulls).hashed {
      Ok(h) -> h.embed_items.get(b"a"),
      Err(_) -> panic("the module loads"),
    };
  assert_eq(items([]), Some([{ name: Some(b"text"), wants: [{ path: b"x.txt", dir: false }] }]));
  let kept = [{ name: Some(b"kept"), wants: [{ path: b"x.txt", dir: false }] }];
  assert_eq(items([{ name: b"a", pulls: { imports: [], wants: kept } }]), Some(kept))
}

test "an embed is the digest of the bytes read for it, and other bytes are another definition" {
  let src = b"fn data() -> Bytes = embed(\"d.txt\")\nfn other() -> Int = 1\n";
  let one = embedding(src, [a_file(b"one")]);
  let two = embedding(src, [a_file(b"two")]);
  assert(definition_hash_in(one, b"m.data") != definition_hash_in(two, b"m.data"));
  assert_eq(definition_hash_in(one, b"m.other"), definition_hash_in(two, b"m.other"));
  assert_eq(
    definition_hash_in(one, b"m.data"),
    definition_hash_in(
      embedding(b"fn data() -> Bytes = embed(\"e.txt\")\nfn other() -> Int = 1\n", [
        file_at(b"e.txt", b"one"),
      ]),
      b"m.data",
    ),
  );
  assert(
    definition_hash_in(one, b"m.data")
      != definition_hash_in(
        embedding(b"fn data() -> Bytes = b\"one\"\nfn other() -> Int = 1\n", []),
        b"m.data",
      ),
  )
}

test "a directory embed is its files as records, by their paths below it" {
  let src = b"fn tree() -> List<{ name: String, bytes: Bytes }> = embed_dir(\"t\")\n";
  let w = checked_analysis(
    embedding(src, [
      {
        want: { path: b"t", dir: true },
        read: Ok([embed_file(b"a", b"1"), embed_file(b"b/c", b"2")]),
      },
    ]),
  );
  assert_eq(w.embeds.map(|embed: ModuleEmbed| embed.key), [b"dir:t"])
}

test "an embed's path is a literal, and an embed nothing could be read for is refused" {
  assert_eq(
    refused_codes(
      embedding(b"fn p() -> String = \"d.txt\"\nfn data() -> Bytes = embed(p())\n", []),
    ),
    [b"E0147"],
  );
  assert_eq(
    refused_codes(
      embedding(b"fn data() -> Bytes = embed(\"d.txt\")\n", [
        { want: { path: b"d.txt", dir: false }, read: Err(b"`d.txt` does not exist") },
      ]),
    ),
    [b"E0146"],
  );
  assert_eq(refused_codes(embedding(b"fn data() -> Bytes = embed(\"d.txt\")\n", [])), [b"E0146"])
}

test "a module that binds `embed` itself calls its own" {
  let w = checked_analysis(
    embedding(
      b"fn embed(p: String) -> Bytes = b\"mine\"\nfn data() -> Bytes = embed(\"d.txt\")\n",
      [],
    ),
  );
  assert_eq(w.embeds, [])
}

test "the pins read off the closure are the pins an analysis answers, embeds included" {
  let user = [{ name: b"main", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  let packages = with_lib(user);
  let lib = packages.supplied.get(0);
  let embedding = {
    ..packages,
    supplied: [
      {
        ..lib,
        modules: [{ name: b"answer", src: b"pub fn answer() -> Int = embed(\"n.txt\").len()" }],
      },
    ],
  };
  let reads = [
    {
      root: b"lib",
      module: b"answer",
      want: { path: b"n.txt", dir: false },
      read: Ok([embed_file(b"", b"one")]),
    },
  ];
  let analysed = checked_analysis(
    analyse_pulling_std_with(user, [], no_rows(), embedding, reads).out,
  ).pins;
  assert_eq(analysed.len(), 1);
  assert_eq(pins_of_load(user, embedding, reads), Ok(analysed))
}

test "a dependency is pinned by what its modules embed as well as by their text" {
  let user = [{ name: b"main", src: b"import lib.answer\nfn main() -> Int = answer::answer()" }];
  let packages = with_lib(user);
  let embedding_lib = |read: Option<Bytes>| {
    let lib = packages.supplied.get(0);
    let src = match read {
      Some(_) -> b"pub fn answer() -> Int = embed(\"n.txt\").len()",
      None -> b"pub fn answer() -> Int = 42",
    };
    let changed = { ..packages, supplied: [{ ..lib, modules: [{ name: b"answer", src: src }] }] };
    let reads = match read {
      Some(b) ->
        [
          {
            root: b"lib",
            module: b"answer",
            want: { path: b"n.txt", dir: false },
            read: Ok([embed_file(b"", b)]),
          },
        ],
      None -> [],
    };
    checked_analysis(analyse_pulling_std_with(user, [], no_rows(), changed, reads).out).pins.map(
      |pin: LockedPackage| pin.digest,
    )
  };
  assert(embedding_lib(Some(b"one")) != embedding_lib(Some(b"two")))
}

test "what sits beside a shipped module is filed under the root of the package it lies in, and nothing outside the shipped files is" {
  assert_eq(shipped_name(b"std.internal.prelude_source", b"../prelude.ply"), Some(b"std.prelude"));
  assert_eq(shipped_name(b"std.a", b"b.ply"), Some(b"std.b"));
  assert_eq(shipped_name(b"std.a", b"./deep/b.ply"), Some(b"std.deep.b"));
  assert_eq(shipped_name(b"std.deep.a", b"../b.ply"), Some(b"std.b"));
  assert_eq(shipped_name(b"std.a", b"../b.ply"), None);
  assert_eq(shipped_name(b"std.a", b"/b.ply"), None);
  assert_eq(shipped_name(b"std.a", b".."), None);
  assert_eq(shipped_name(b"std.a", b"notes.txt"), None);
  assert_eq(shipped_name(b"compiler.prelude_source", b"../std/prelude.ply"), Some(b"std.prelude"));
  assert_eq(shipped_name(b"compiler.emit.a", b"../../std/deep/b.ply"), Some(b"std.deep.b"));
  assert_eq(shipped_name(b"compiler.a", b"../nowhere/b.ply"), None);
  assert_eq(shipped_name(b"compiler.a", b"../std.deep/b.ply"), None);
  assert_eq(shipped_name(b"compiler.a", b"../../std/b.ply"), None);
  assert_eq(shipped_name(b"compiler.a", b"../std"), None)
}

test "a shipped module embeds what the shipped modules hold beside it, and other bytes are another definition" {
  let user = [{ name: b"m", src: b"import std.deep.a\npub fn f() -> Bytes = a::text()" }];
  let embedding = { name: b"std.deep.a", src: b"pub fn text() -> Bytes = embed(\"../note.ply\")" };
  let over = |note: Bytes| pulled_dump(user, [embedding, { name: b"std.note", src: note }]);
  let one = over(b"one");
  assert_eq(one.dump.diagnostics, []);
  assert_eq(one.pulled, [b"std.deep.a", prelude_module()]);
  assert_eq(one.dump.embeds, [
    { module: b"std.deep.a", key: b"file:../note.ply", read: Ok([embed_file(b"", b"one")]) },
  ]);
  assert(one.dump.hashes_digest != over(b"two").dump.hashes_digest)
}

test "a shipped module read as its stub still answers what the shipped modules' text of it embeds" {
  let whole = [
    { name: b"std.a", src: b"pub fn text() -> Bytes = embed(\"note.ply\")" },
    { name: b"std.note", src: b"one" },
  ].fold(Map::new(), |acc: Map<Bytes, Bytes>, s: Source| acc.insert(s.name, s.src));
  let stub = shipped_embedded(
    whole,
    Map::new(),
    Map::new(),
    0,
    parse_at(0, { name: b"std.a", src: b"pub fn text() -> Bytes = b\"\"" }),
  );
  assert_eq(stub.embeds, [
    { module: b"std.a", key: b"file:note.ply", read: Ok([embed_file(b"", b"one")]) },
  ])
}

test "comparing, ordering or digesting a type holding a shipped module's `extern type` is refused" {
  let native = { name: b"std.native", src: b"pub extern type Node<a>\n" };
  let codes = |src: Bytes|
    pulled_dump([{ name: b"m", src: src }], [native]).dump.diagnostics.filter(
      |d: Diagnostic| d.severity == b"error",
    ).map(|d: Diagnostic| d.code);
  let lookup_or_empty = |inner: Bytes, body: Bytes|
    codes(
      Bytes::concat_all([b"import std.native (Node)\ntype Held = | Held(", inner, b")\n", body]),
    );
  assert_eq(lookup_or_empty(b"Node<Int>", b"fn same(a: Held, b: Held) -> Bool = a == b\n"), [
    b"E0201",
  ]);
  assert_eq(
    lookup_or_empty(
      b"Node<Int>",
      b"fn order(a: Held, b: Held) -> Ordering = compare(a, b)\nfn hashed(a: Held) -> Bytes = digest(a)\n",
    ),
    [b"E0206", b"E0206"],
  );
  assert_eq(lookup_or_empty(b"Int", b"fn same(a: Held, b: Held) -> Bool = a == b\n"), [])
}

test "a shipped module that embeds what the shipped modules do not hold is refused" {
  let a = pulled_dump([{ name: b"m", src: b"import std.a\npub fn f() -> Bytes = a::text()" }], [
    { name: b"std.a", src: b"pub fn text() -> Bytes = embed(\"gone.ply\")" },
  ]);
  assert_eq(a.dump.diagnostics.map(|d: Diagnostic| d.code), [b"E0146"])
}

test "a data file beside a shipped module is named by its place below the package's root" {
  assert_eq(shipped_data_name(b"std.oid", b"oid/names.txt"), Some(b"std/oid/names.txt"));
  assert_eq(shipped_data_name(b"std.oid", b"./oid//names.txt"), Some(b"std/oid/names.txt"));
  assert_eq(shipped_data_name(b"std.oid", b"names.txt"), Some(b"std/names.txt"));
  assert_eq(shipped_data_name(b"std.deep.a", b"../b.txt"), Some(b"std/b.txt"));
  assert_eq(shipped_data_name(b"compiler.a", b"../std/oid/names.txt"), Some(b"std/oid/names.txt"));
  assert_eq(shipped_data_name(b"std.a", b"../b.txt"), None);
  assert_eq(shipped_data_name(b"std.a", b"x/../../b.txt"), None);
  assert_eq(shipped_data_name(b"std.a", b"/etc/hosts"), None);
  assert_eq(shipped_data_name(b"std.a", b"b.ply"), None);
  assert_eq(shipped_data_name(b"std.a", b"."), None);
  assert_eq(shipped_data_name(b"std.a", b""), None)
}

fn words_module(path: Bytes) -> Source =
  {
    name: b"std.words",
    src: Bytes::concat_all([
      b"pub fn list() -> Bytes = embed(\"",
      path,
      b"\")\npub fn count() -> Int = list().len()\npub fn idle() -> Int = 7\n",
    ]),
  }

fn words_data(bytes: Bytes) -> List<ShippedData> = [{ name: b"std/words/list.txt", bytes: bytes }]

fn over_words(user: Bytes, data: List<ShippedData>) -> PulledAnalysis / {abort.raise} =
  analyse_pulling_std_with(
    [{ name: b"m", src: user }],
    [words_module(b"words/list.txt")],
    no_rows(),
    data: data,
  )

fn pulled_hash(p: PulledAnalysis, name: Bytes) -> Option<Bytes> =
  pulled_hashes(p).fold(None, |acc: Option<Bytes>, d: { name: Bytes, hash: Bytes }|
    if d.name == name { Some(d.hash) } else { acc })

test "a shipped module embeds a data file, and other bytes are another definition for exactly what reaches it" {
  let user = b"import std.words\npub fn n() -> Int = words::count()\npub fn still() -> Int = words::idle()\n";
  let one = over_words(user, words_data(b"one\n"));
  let two = over_words(user, words_data(b"one\ntwo\n"));
  assert_eq(refused_codes(one.out), []);
  [b"std.words.list", b"std.words.count", b"m.n"].fold((), |u: Unit, name: Bytes| {
    assert(pulled_hash(one, name) != None, Some(String::of_bytes(name)));
    assert(pulled_hash(one, name) != pulled_hash(two, name), Some(String::of_bytes(name)))
  });
  [b"std.words.idle", b"m.still"].fold((), |u: Unit, name: Bytes|
    assert_eq(pulled_hash(one, name), pulled_hash(two, name)));
  assert_eq(dump_of(one.out).embeds, [
    { module: b"std.words", key: b"file:words/list.txt", read: Ok([embed_file(b"", b"one\n")]) },
  ])
}

test "a program that reaches nothing a data file is in holds no definition its bytes move" {
  let user = b"import std.words\npub fn still() -> Int = words::idle()\n";
  let one = over_words(user, words_data(b"one\n"));
  let two = over_words(user, words_data(b"one\ntwo\n"));
  assert_eq(definition_names(one), [b"m.still", b"std.words.idle"]);
  assert_eq(pulled_hashes(one), pulled_hashes(two));
  assert_eq(dump_of(one.out).hashes_digest, dump_of(two.out).hashes_digest)
}

test "a data file the shipped modules do not hold, or a path that leaves them, is refused in the module that asks" {
  let src = b"import std.words\npub fn n() -> Int = words::count()\n";
  let user = [{ name: b"m", src: src }];
  let placed_at = |p: PulledAnalysis|
    match p.out {
      Analysed(_) -> [],
      Refused(ds) ->
        ds.map(|d: Diagnostic| { code: d.code, modules: d.labels.map(|l: Label| l.module) }),
    };
  assert_eq(placed_at(over_words(src, [])), [{ code: b"E0146", modules: [2] }]);
  let leaving = analyse_pulling_std_with(
    user,
    [words_module(b"../list.txt")],
    no_rows(),
    data: [{ name: b"list.txt", bytes: b"x" }, { name: b"std/list.txt", bytes: b"x" }],
  );
  assert_eq(placed_at(leaving), [{ code: b"E0146", modules: [2] }]);
  let directory = analyse_pulling_std_with(
    user,
    [{ name: b"std.words", src: b"pub fn count() -> Int = embed_dir(\"words\").len()\n" }],
    no_rows(),
    data: words_data(b"one\n"),
  );
  assert_eq(placed_at(directory), [{ code: b"E0146", modules: [2] }])
}

test "a shipped module read as its stub still answers the data file its text embeds" {
  let whole = Map::new().insert(b"std.words", words_module(b"words/list.txt").src);
  let stub = shipped_embedded(
    whole,
    Map::new(),
    data_by_name(embed_files_of(words_data(b"one\n"))),
    0,
    parse_at(0, { name: b"std.words", src: b"pub fn list() -> Bytes = b\"\"" }),
  );
  assert_eq(stub.embeds, [
    { module: b"std.words", key: b"file:words/list.txt", read: Ok([embed_file(b"", b"one\n")]) },
  ])
}

test "a shipped module read as its stub answers what its text's read kept that it embeds, never parsing the text again" {
  let whole = Map::new().insert(b"std.words", b"embed( names nothing a parse would find");
  let dependencies = Map::new().insert(b"std.words", {
    imports: [],
    wants: requests_by_item(parse(words_module(b"words/list.txt").src).node),
  });
  let stub = shipped_embedded(
    whole,
    dependencies,
    data_by_name(embed_files_of(words_data(b"one\n"))),
    0,
    parse_at(0, { name: b"std.words", src: b"pub fn list() -> Bytes = b\"\"" }),
  );
  assert_eq(stub.embeds.map(|e: ModuleEmbed| e.key), [b"file:words/list.txt"])
}

test "the shipped modules parse for a listing with their data written out, as a load that pulls them does" {
  let module = words_module(b"words/list.txt");
  assert_eq(shipped_data_wanted(module), [b"std/words/list.txt"]);
  assert_eq(shipped_data_wanted({ name: b"std.plain", src: b"pub fn one() -> Int = 1\n" }), []);
  let pulled = over_words(
    b"import std.words\npub fn n() -> Int = words::count()\n",
    words_data(b"one\n"),
  );
  assert_eq(shipped_data_embeds(module, words_data(b"one\n")), dump_of(pulled.out).embeds);
  assert_eq(shipped_data_embeds(module, []), []);
  let listed = analyse(parse_shipped([module], [module], words_data(b"one\n")));
  assert_eq(refused_codes(listed), []);
  assert_eq(
    Some(definition_hash_in(listed, b"std.words.list")),
    pulled_hash(pulled, b"std.words.list"),
  );
  assert_eq(refused_codes(analyse(parse_shipped([module], [module], []))), [b"E0146"])
}

test "a module's tables and rows read back as an answer kept them" {
  match analyse(parse_all(program())) {
    Refused(_) -> panic("the fixture checks"),
    Analysed(w) -> {
      let t = module_facts(w, 0).tables;
      assert_eq(decode_tables(encode_tables(t)), t);
      let r = rows_of(w);
      assert_eq(decode_rows(encode_rows(r)), r)
    },
  }
}
