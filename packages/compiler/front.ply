pub type ShippedData = { name: Bytes, bytes: Bytes }

derive bin for ShippedData

pub type Dependencies = { imports: List<ImportDeclaration>, wants: List<ItemEmbeds> }

derive bin for Dependencies

fn shipped_path_parts(module: Bytes, path: Bytes) -> Option<List<Bytes>> =
  if path.starts_with(b"/") { None } else {
    match path.split(b"/").fold(
        Some(module.split(b".").drop_last(1)),
        |inside: Option<List<Bytes>>, part: Bytes|
          match inside {
            None -> None,
            Some(dir) -> if part == b"" || part == b"." { inside }
            else if part == b".." { if dir.len() > 0 { Some(dir.drop_last(1)) } else { None } }
            else if dir.len() == 0 && !shipped_root(part) { None }
            else { Some(dir.push(part)) },
          },
      ) {
      Some(parts) -> if parts.len() < 2 { None } else { Some(parts) },
      None -> None,
    }
  }

fn shipped_root(part: Bytes) -> Bool = is_shipped(part) && part.index_of(b".") == None

fn shipped_name(module: Bytes, path: Bytes) -> Option<Bytes> / {abort.raise} =
  if !path.ends_with(b".ply") { None } else {
    match shipped_path_parts(module, path) {
      Some(parts) -> {
        let named = Bytes::join(parts, b".");
        Some(named.slice(0, named.len() - 4))
      },
      None -> None,
    }
  }

pub fn shipped_data_name(module: Bytes, path: Bytes) -> Option<Bytes> =
  if path.ends_with(b".ply") { None } else {
    match shipped_path_parts(module, path) {
      Some(parts) -> Some(Bytes::join(parts, b"/")),
      None -> None,
    }
  }

fn data_wants(module: Source) -> List<{ want: EmbedRequest, name: Bytes }> / {abort.raise} =
  if !may_call_embed(module.source_text) { [] } else {
    embed_requests(parse(module.source_text).node, []).fold(
      [],
      |accumulator: List<{ want: EmbedRequest, name: Bytes }>, want: EmbedRequest|
        if want.dir { accumulator } else {
          match shipped_data_name(module.name, want.path) {
            Some(name) -> accumulator.push({ want: want, name: name }),
            None -> accumulator,
          }
        },
    )
  }

pub fn shipped_data_wanted(module: Source) -> List<Bytes> / {abort.raise} =
  data_wants(module).fold([], |accumulator: List<Bytes>, w: { want: EmbedRequest, name: Bytes }|
    accumulator.push_unique(w.name))

pub type ShippedWants = { texts: List<Bytes>, data: List<Bytes> }

derive bin for ShippedWants

pub fn shipped_wants_of(module: Source, node: Module) -> ShippedWants / {abort.raise} =
  if !may_call_embed(module.source_text) { { texts: [], data: [] } }
  else { shipped_wants_in(module.name, node) }

fn shipped_wants_in(name: Bytes, node: Module) -> ShippedWants / {abort.raise} =
  embed_requests(node, []).fold(
    { texts: [], data: [] },
    |accumulator: ShippedWants, want: EmbedRequest|
      if want.dir { accumulator } else {
        match shipped_name(name, want.path) {
          Some(n) -> { ..accumulator, texts: accumulator.texts.push_unique(n) },
          None -> match shipped_data_name(name, want.path) {
            Some(n) -> { ..accumulator, data: accumulator.data.push_unique(n) },
            None -> accumulator,
          },
        }
      },
  )

pub fn shipped_data_embeds(
  module: Source,
  data: List<ShippedData>,
) -> List<ModuleEmbed> / {abort.raise} = {
  let lookup_or_empty = data_by_name(embed_files_of(data));
  data_wants(module).fold(
    [],
    |accumulator: List<ModuleEmbed>, w: { want: EmbedRequest, name: Bytes }|
      match lookup_or_empty.get(w.name) {
        Some(file) ->
          accumulator.push({
            module: module.name,
            key: embed_key(w.want),
            read: Ok([{ ..file, name: b"" }]),
          }),
        None -> accumulator,
      },
  )
}

fn with_hidden_imports(p: ParsedSource, dependencies: Option<Dependencies>) -> ParsedSource =
  match dependencies {
    None -> p,
    Some(t) -> {
      let have = p.module.module.imports.fold(
        Set::empty(),
        |accumulator: Set<Bytes>, d: ImportDeclaration|
          match d.kind { ModuleAlias(a) -> accumulator.insert(a.name), _ -> accumulator },
      );
      let more = t.imports.filter(|d: ImportDeclaration|
        match d.kind {
          ModuleAlias(a) -> is_hidden_binder(a.name) && !have.contains(a.name),
          _ -> false,
        });
      if more.len() == 0 { p } else {
        {
          ..p,
          module: {
            ..p.module,
            module: { ..p.module.module, imports: p.module.module.imports.concat(more) },
          },
        }
      }
    },
  }

type ShippedFile = | ShippedModuleText(Bytes) | ShippedDataFile(Bytes)

fn shipped_file_at(
  module: Bytes,
  want: EmbedRequest,
) -> Result<ShippedFile, Bytes> / {abort.raise} =
  if want.dir {
    Err(
      b"a standard library module can embed only a file from the standard library, not a directory",
    )
  } else {
    match shipped_name(module, want.path) {
      Some(name) -> Ok(ShippedModuleText(name)),
      None -> match shipped_data_name(module, want.path) {
        Some(name) -> Ok(ShippedDataFile(name)),
        None ->
          Err(
            Bytes::concat_all([
              b"`",
              want.path,
              b"` is not a file in the standard library; check the path",
            ]),
          ),
      },
    }
  }

fn not_shipped(want: EmbedRequest) -> Bytes =
  Bytes::concat_all([b"`", want.path, b"` is not among what the shipped modules contain"])

fn shipped_read(
  whole: Map<Bytes, Bytes>,
  data: Map<Bytes, EmbedFile>,
  module: Bytes,
  want: EmbedRequest,
) -> EmbedResult / {abort.raise} =
  match shipped_file_at(module, want) {
    Err(reason) -> Err(reason),
    Ok(ShippedModuleText(name)) -> match whole.get(name) {
      Some(text) -> Ok([embed_file(b"", text)]),
      None -> Err(not_shipped(want)),
    },
    Ok(ShippedDataFile(name)) -> match data.get(name) {
      Some(file) -> Ok([{ ..file, name: b"" }]),
      None -> Err(not_shipped(want)),
    },
  }

pub fn shipped_bytes<| e>(
  module: Bytes,
  key: Bytes,
  text: (Bytes) -> Option<Bytes> / {abort.raise | e},
  data: (Bytes) -> Option<Bytes> / {abort.raise | e},
) -> EmbedBytesResult / {abort.raise | e} = {
  let want = request_of_key(key);
  match shipped_file_at(module, want) {
    Err(reason) -> Err(reason),
    Ok(at) -> {
      let lookup_or_empty = match at {
        ShippedModuleText(name) -> text(name),
        ShippedDataFile(name) -> data(name),
      };
      match lookup_or_empty {
        Some(bytes) -> Ok([{ name: b"", bytes: bytes }]),
        None -> Err(not_shipped(want)),
      }
    },
  }
}

pub fn embed_read_of(
  module: Bytes,
  records: List<EmbedRecord>,
  whole: List<Source>,
  data: List<EmbedFile>,
) -> (EmbedRequest) -> EmbedResult / {abort.raise} = {
  let texts = whole.fold(Map::new(), |found: Map<Bytes, Bytes>, s: Source|
    found.insert(s.name, s.source_text));
  let files = data_by_name(data);
  |want: EmbedRequest|
    match records.find(|r: EmbedRecord| r.want == want) {
      Some(r) -> r.read,
      None -> shipped_read(texts, files, module, want),
    }
}

fn embed_files_of(data: List<ShippedData>) -> List<EmbedFile> =
  data.map(|d: ShippedData| embed_file(d.name, d.bytes))

fn data_by_name(data: List<EmbedFile>) -> Map<Bytes, EmbedFile> =
  data.fold(Map::new(), |accumulator: Map<Bytes, EmbedFile>, d: EmbedFile|
    accumulator.insert(d.name, d))

fn shipped_embedded(
  whole: Map<Bytes, Bytes>,
  dependencies: Map<Bytes, Dependencies>,
  data: Map<Bytes, EmbedFile>,
  index: Int,
  parsed: ParsedSource,
) -> { parsed: ParsedSource, embeds: List<ModuleEmbed> } / {abort.raise} = {
  let source = { name: parsed.name, source_text: parsed.text };
  let text = match whole.get(source.name) { Some(t) -> t, None -> source.source_text };
  let read = if text == source.source_text { parsed }
  else { with_hidden_imports(parsed, dependencies.get(source.name)) };
  let p = { ..read, text: text };
  if !may_call_embed(text) { { parsed: p, embeds: [] } } else {
    let wants = if text == source.source_text { embed_requests(p.module.module, []) } else {
      match dependencies.get(source.name) {
        Some(t) -> requests_in(t.wants),
        None -> embed_requests(parse(text).node, []),
      }
    };
    let table = wants.fold(
      Map::new(),
      |accumulator: Map<Bytes, EmbedResult>, want: EmbedRequest|
        accumulator.insert(embed_key(want), shipped_read(whole, data, source.name, want)),
    );
    embeds_inlined(p, index, [], table)
  }
}

pub fn embeds_inlined(
  p: ParsedSource,
  index: Int,
  bound_elsewhere: List<Bytes>,
  table: Map<Bytes, EmbedResult>,
) -> { parsed: ParsedSource, embeds: List<ModuleEmbed> } = {
  let r = inline_embeds(p.module.module, bound_elsewhere, table, []);
  {
    parsed: {
      ..p,
      module: { ..p.module, module: r.module },
      diagnostics: p.diagnostics.concat(
        r.diagnostics.map(|diagnostic: ParseDiagnostic| diagnostic_in_module(index, diagnostic)),
      ),
    },
    embeds: table.fold([], |accumulator: List<ModuleEmbed>, key: Bytes, read: EmbedResult|
      accumulator.push({ module: p.name, key: key, read: read })),
  }
}

pub fn parse_shipped(
  modules: List<Source>,
  shipped: List<Source>,
  data: List<ShippedData>,
) -> List<ParsedSource> / {abort.raise} = {
  let whole = shipped.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, s: Source|
    accumulator.insert(s.name, s.source_text));
  let lookup_or_empty = data_by_name(embed_files_of(data));
  range(0, modules.len()).map(|i: Int|
    shipped_embedded(whole, Map::new(), lookup_or_empty, i, parse_at(i, modules.get(i))).parsed)
}

fn is_module_level_item(item: Item) -> Bool =
  match item {
    EffectSetItem(_) -> true,
    DeriveItem(_) -> true,
    InstanceItem(_) -> true,
    NumericItem(_) -> true,
    SchemaItem(_) -> true,
    _ -> false,
  }

pub fn module_form_digest(module: Module, text: Bytes) -> Bytes / {abort.raise} = {
  let declaration_sources = module.imports.filter(|d: ImportDeclaration|
    match d.kind { ModuleAlias(a) -> !is_hidden_binder(a.name), _ -> true });
  let imports = declaration_sources.map(|d: ImportDeclaration|
    Bytes::concat_all([
      b"import ",
      Bytes::join(d.path.map(|part: Identifier| part.name), b"."),
      match d.kind {
        WholeModule -> b"",
        ModuleAlias(a) -> b" as ".concat(a.name),
        SelectedNames(ns) ->
          Bytes::concat_all([b" (", Bytes::join(ns.map(|n: Identifier| n.name), b","), b")"]),
      },
    ]));
  let items = module.items.fold([], |accumulator: List<Bytes>, item: Item|
    if !is_module_level_item(item) { accumulator } else {
      let at = item_span(item);
      if at.start < 0 || at.end > text.len() || at.start > at.end { accumulator.push(b"?") }
      else { accumulator.push(text.slice(at.start, at.end)) }
    });
  hex(
    blake3(
      Bytes::join(
        imports.sort_by(|a: Bytes, b: Bytes|
          match compare_values(a, b) { Greater -> false, _ -> true }).concat(
          items,
        ),
        b"\n",
      ),
    ),
  )
}

pub fn locked_packages(
  user: List<Source>,
  packages: PackageSources,
  embeds: List<EmbedRecord>,
) -> Result<List<LockedPackage>, List<Diagnostic>> / {abort.raise} = {
  let package_closure = closure(packages, user.map(|source: Source| source.name));
  let sources = user.concat(
    package_closure.modules.map(|m: { pkg: Int, source: Source }| m.source),
  );
  if package_closure.diagnostics.len() > 0 {
    Err(
      package_closure.diagnostics.map(|sd: { slot: Int, diagnostic: ParseDiagnostic }|
        if sd.slot < 0 { diagnostic_in_module(0 - sd.slot - 1, sd.diagnostic) }
        else { diagnostic_in_module(sources.len() + sd.slot, sd.diagnostic) }),
    )
  } else {
    let slots = embed_slots(packages, user);
    let tables = embed_reads(embeds);
    let read = range(0, sources.len()).fold([], |accumulator: List<ModuleEmbed>, i: Int| {
      let source = sources.get(i);
      match slots.at(i) {
        Some(slot) -> if !may_call_embed(source.source_text) { accumulator } else {
          match tables.get(slot) {
            Some(table) ->
              table.fold(accumulator, |a: List<ModuleEmbed>, key: Bytes, read: EmbedResult|
                a.push({ module: source.name, key: key, read: read })),
            None -> accumulator,
          }
        },
        None -> accumulator,
      }
    });
    Ok(pins_of(package_closure, read))
  }
}

pub type EmbedRecord = { root: Bytes, module: Bytes, want: EmbedRequest, read: EmbedResult }

derive bin for EmbedRecord

pub fn may_call_embed(text: Bytes) -> Bool / {abort.raise} = calls_embed_from(text, 0)

fn calls_embed_from(text: Bytes, from: Int) -> Bool / {abort.raise} =
  iterate(from, text.len() + 2, |at: Int|
    match text.index_of_from(b"embed", at) {
      None -> Stop(false),
      Some(i) -> {
        let whole = (i == 0 || !is_identifier_continue(text.at(i - 1)))
          && !(i >= 7 && text.slice(i - 7, i) == b"import ");
        let end = if i + 9 < text.len() { i + 9 } else { text.len() };
        let named = if text.slice(i + 5, end) == b"_dir" { i + 9 } else { i + 5 };
        let next = past_spaces(text, named);
        if whole && next < text.len() && (text.at(next) == 40 || text.at(next) == 47) { Stop(true) }
        else { Continue(i + 5) }
      },
    })

fn past_spaces(text: Bytes, at: Int) -> Int / {abort.raise} =
  if at < text.len()
      && (text.at(at) == 32 || text.at(at) == 9 || text.at(at) == 10 || text.at(at) == 13) {
    past_spaces(text, at + 1)
  } else { at }

pub fn embed_inputs_of<| e>(
  embeds: List<ModuleEmbed>,
  read: (ModuleEmbed) -> EmbedBytesResult / {abort.raise | e},
) -> Result<Map<Bytes, Bytes>, List<Diagnostic>> / {abort.raise | e} = {
  let lookup_or_empty = embeds.fold(
    { inputs: Map::new(), moved: [] },
    |accumulator: { inputs: Map<Bytes, Bytes>, moved: List<ModuleEmbed> }, embed: ModuleEmbed|
      match embed.read {
        Err(_) -> accumulator,
        Ok(was) -> match read(embed) {
          Err(_) -> { ..accumulator, moved: accumulator.moved.push(embed) },
          Ok(files) -> {
            let now = files.map(|f: EmbedBytes| embed_file(f.name, f.bytes));
            if now != was { { ..accumulator, moved: accumulator.moved.push(embed) } } else {
              {
                ..accumulator,
                inputs: range(0, files.len()).fold(
                  accumulator.inputs,
                  |m: Map<Bytes, Bytes>, i: Int| m.insert(now.get(i).digest, files.get(i).bytes),
                ),
              }
            }
          },
        },
      },
  );
  if lookup_or_empty.moved.len() == 0 { Ok(lookup_or_empty.inputs) }
  else { Err(lookup_or_empty.moved.map(changed_embed_error)) }
}

fn changed_embed_error(embed: ModuleEmbed) -> Diagnostic / {abort.raise} =
  error_unplaced(
    b"E0146",
    Bytes::concat_all([
      b"`",
      request_of_key(embed.key).path,
      b"`, which `",
      embed.module,
      b"` embeds, could not be embedded because it changed after the program was checked",
    ]),
    b"the contents of the file are different from when the program was checked",
    [b"a file an embed reads changed while the program was loaded; run again"],
  )

pub fn embeds_wanted(root: Bytes, sources: List<Source>) -> List<EmbedRecord> / {abort.raise} =
  sources.fold([], |accumulator: List<EmbedRecord>, source: Source|
    if !may_call_embed(source.source_text) { accumulator }
    else { accumulator.concat(module_embeds_wanted(root, source, parse(source.source_text).node)) })

pub fn module_embeds_wanted(
  root: Bytes,
  source: Source,
  raw: Module,
) -> List<EmbedRecord> / {abort.raise} =
  if !may_call_embed(source.source_text) { [] } else {
    embed_requests(raw, []).map(|want: EmbedRequest|
      { root: root, module: source.name, want: want, read: Err(b"not read yet") })
  }

pub fn embed_slot(root: Bytes, module: Bytes) -> Bytes = Bytes::concat_all([root, b"\x00", module])

fn embed_slots(packages: PackageSources, user: List<Source>) -> List<Bytes> =
  packages.supplied.fold(
    user.map(|source: Source| embed_slot(packages.root, source.name)),
    |accumulator: List<Bytes>, supplied: SuppliedPackage|
      supplied.modules.fold(accumulator, |a: List<Bytes>, source: Source|
        a.push(embed_slot(supplied.root, source.name))),
  )

fn embed_reads(embeds: List<EmbedRecord>) -> Map<Bytes, Map<Bytes, EmbedResult>> =
  embeds.fold(Map::new(), |accumulator: Map<Bytes, Map<Bytes, EmbedResult>>, embed: EmbedRecord| {
    let slot = embed_slot(embed.root, embed.module);
    let was = match accumulator.get(slot) { Some(t) -> t, None -> Map::new() };
    accumulator.insert(slot, was.insert(embed_key(embed.want), embed.read))
  })

pub fn program() -> List<Source> =
  [
    {
      name: b"m",
      source_text: b"effect log { write emit(Bytes) -> Unit }\ntype Shape = | Dot | Line(Int)\nfn say(b: Bytes) -> Unit / { log.write } = log.emit(b)\ntest \"says\" { say(b\"x\") }",
    },
  ]

pub const faceted: List<Source> =
  [
    {
      name: b"base",
      source_text: b"pub effect tick { write beat() -> Unit }\npub type Shape = | Dot | Line(Int)\nfn shown(s: Shape) -> String = match s { Dot -> \"dot\", Line(n) -> \"line\" }\nshow for Shape by shown\npub opaque type Coin = new { cents: Int }\npub fn coin(n: Int) -> Coin = { cents: n }\npub fn cents(c: Coin) -> Int = c.cents\npub fn even(n: Int) -> Bool / { tick.write } = if n <= 0 { true } else { tick.beat(); odd(n - 1) }\nfn odd(n: Int) -> Bool / { tick.write } = if n <= 0 { false } else { even(n - 1) }\npub fn half(n: Int) -> Int requires n >= 0 ensures result <= n = n / 2\npub const seven: Int = 7\npub fn literal(text: String) -> Result<Int, { message: String, offset: Int }> = Ok(1)\npub fn magnitude<a>(n: a) -> a where numeric(a) = { let zero: a = numeric_of_int(0); if n < zero { zero - n } else { n } }\nlaw \"halving shrinks\" forall (n: Int) where n >= 0 { half(n) <= n }\ntest \"two\" { assert_eq(half(4), 2) }\n",
    },
    {
      name: b"app",
      source_text: b"import base\npub fn worth(n: Int) -> Int = base::cents(base::coin(base::half(n))) + base::seven\npub fn tagged() -> Int = base\"one\" + base\"two\" + base::magnitude(0 - 2)\ntest \"worth\" { assert_eq(worth(4), 9) }\ntest \"tags\" { assert_eq(base\"three\", 1) }\ntest \"lines\" { assert(base::Line(1) == base::Line(1)) }\nlaw \"worth is above seven\" forall (n: Int) where n >= 0 { worth(n) >= 7 }\n",
    },
  ]

