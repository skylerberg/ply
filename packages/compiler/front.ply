fn import_at(imports: List<ImportDeclaration>, name: Bytes) -> Span / {abort.raise} = {
  let found = imports.fold(None, |accumulator: Option<Span>, declaration: ImportDeclaration|
    match accumulator {
      Some(_) -> accumulator,
      None -> if import_module_name(declaration) == name { Some(path_span(declaration)) }
      else { None },
    });
  match found { Some(s) -> s, None -> generated_span }
}

fn foreign_import(m: Int, span: Span, importer: Bytes, name: Bytes) -> Diagnostic =
  error_at(
    internal_error_code,
    m,
    span,
    Bytes::concat_all([
      b"the shipped module `",
      importer,
      b"` imports `",
      name,
      b"`, which this build does not ship",
    ]),
    b"a stdlib module may import only modules that ship with it",
    [
      b"this is an internal error in the compiler's own sources, not in this program",
      b"please report it with the version of `ply` that produced it",
    ],
  )

type ImportedModules = { wanted: Map<Bytes, Bytes>, diagnostics: List<Diagnostic> }

type Wanted = { names: Set<Bytes>, diagnostics: List<Diagnostic> }

type Importer = { name: Bytes, imports: List<ImportDeclaration> }

fn importer(p: ParsedSource) -> Importer = { name: p.name, imports: p.module.module.imports }

fn wanted(
  users: Int,
  listed: List<Bytes>,
  parsed: List<Importer>,
  required: List<Bytes>,
) -> Wanted / {abort.raise} = {
  let has = listed.fold(Set::empty(), |accumulator: Set<Bytes>, name: Bytes|
    accumulator.insert(name));
  let present = parsed.fold(Set::empty(), |accumulator: Set<Bytes>, p: Importer|
    accumulator.insert(p.name));
  let named: Wanted = {
    names: required.fold(Set::empty(), |accumulator: Set<Bytes>, name: Bytes|
      if has.contains(name) && !present.contains(name) { accumulator.insert(name) }
      else { accumulator }),
    diagnostics: [],
  };
  range(0, parsed.len()).fold(named, |accumulator: Wanted, i: Int| {
    let p = parsed.get(i);
    let imports = p.imports;
    let ships = i >= users;
    imports.fold(accumulator, |w: Wanted, declaration: ImportDeclaration| {
      let name = import_module_name(declaration);
      if is_shipped(name) && !present.contains(name) {
        if has.contains(name) { { ..w, names: w.names.insert(name) } } else {
          {
            ..w,
            diagnostics: w.diagnostics.push(if ships {
              foreign_import(i, import_at(imports, name), p.name, name)
            } else { unknown_shipped(i, import_at(imports, name), name, listed) }),
          }
        }
      } else if ships && !is_shipped(name) {
        {
          ..w,
          diagnostics: w.diagnostics.push(
            foreign_import(i, import_at(imports, name), p.name, name),
          ),
        }
      } else { w }
    })
  })
}

fn pull_round(
  users: Int,
  shipped: Map<Bytes, Bytes>,
  listed: List<Bytes>,
  parsed: List<ParsedSource>,
  required: List<Bytes>,
) -> ImportedModules / {abort.raise} = {
  let w = wanted(users, listed, parsed.map(importer), required);
  w.names.fold(
    { wanted: Map::new(), diagnostics: w.diagnostics },
    |r: ImportedModules, name: Bytes|
      match shipped.get(name) {
        Some(source) -> { ..r, wanted: r.wanted.insert(name, source) },
        None -> { ..r, diagnostics: r.diagnostics.push(missing_shipped_source(name)) },
      },
  )
}

fn missing_shipped_source(name: Bytes) -> Diagnostic =
  error_at(
    internal_error_code,
    0,
    generated_span,
    Bytes::concat_all([b"the shipped module `", name, b"` is pulled and was never read"]),
    b"the load read its shipped modules before it knew what it pulls",
    [b"this is Ply's fault, not the program's"],
  )

pub type ShippedData = { name: Bytes, bytes: Bytes }

derive bin for ShippedData

pub type ShippedInputs = {
  sources: List<Source>,
  unread: List<Bytes>,
  data: List<ShippedData>,
  required_modules: List<Bytes>,
  dependencies: List<ModuleDependencies>,
}

pub type ModuleDependencies = { name: Bytes, pulls: Dependencies }

pub type Dependencies = { imports: List<ImportDeclaration>, wants: List<ItemEmbeds> }

derive bin for Dependencies

pub fn dependencies_of(source: Source) -> Dependencies / {abort.raise} =
  {
    imports: parse_header_at(0, source).module.module.imports,
    wants: if may_call_embed(source.source_text) {
      requests_by_item(parse(source.source_text).node)
    } else { [] },
  }

fn home_imports(homes: List<Bytes>) -> List<ImportDeclaration> =
  homes.map(|h: Bytes|
    {
      path: h.split(b".").map(|part: Bytes| { name: part, span: generated_span }),
      kind: WholeModule,
      span: generated_span,
    })

pub fn shipped_inputs_of_pulled<| e>(
  pulled: List<Bytes>,
  listed: List<Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
  read_data: (Bytes) -> Option<Bytes> / e,
  wanted: (Source) -> ShippedWants / {abort.raise | e},
  required: List<Bytes>,
) -> ShippedInputs / {abort.raise | e} = {
  let reading = |accumulator: List<Source>, n: Bytes|
    if accumulator.fold(false, |b: Bool, s: Source| b || s.name == n) { accumulator } else {
      match read(n) {
        Some(source_text) -> accumulator.push({ name: n, source_text: source_text }),
        None -> accumulator,
      }
    };
  let pulled_read = pulled.fold([], reading);
  let wants = pulled_read.fold(
    Map::new(),
    |accumulator: Map<Bytes, ShippedWants>, source: Source|
      accumulator.insert(source.name, wanted(source)),
  );
  let wants_of = |source: Source|
    match wants.get(source.name) { Some(w) -> w, None -> wanted(source) };
  let found = pulled_read.fold(pulled_read, |accumulator: List<Source>, source: Source|
    wants_of(source).texts.fold(accumulator, reading));
  let lookup_or_empty = found.fold(Set::empty(), |accumulator: Set<Bytes>, s: Source|
    accumulator.insert(s.name));
  {
    sources: found,
    unread: listed.filter(|n: Bytes| !lookup_or_empty.contains(n)),
    data: found.fold([], |accumulator: List<ShippedData>, source: Source|
      wants_of(source).data.fold(accumulator, |a: List<ShippedData>, name: Bytes|
        if a.fold(false, |b: Bool, d: ShippedData| b || d.name == name) { a } else {
          match read_data(name) { Some(bytes) -> a.push({ name: name, bytes: bytes }), None -> a }
        })),
    required_modules: required,
    dependencies: [],
  }
}

pub fn shipped_inputs_of<| e>(
  user: List<Source>,
  packages: PackageSources,
  listed: List<Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
  read_data: (Bytes) -> Option<Bytes> / e,
  pulled: (Source) -> Dependencies / e,
  required: List<Bytes> = [],
) -> ShippedInputs / {abort.raise | e} = {
  let package_closure = closure(packages, user.map(|s: Source| s.name));
  let read_own = user.concat(
    package_closure.modules.map(|m: { pkg: Int, source: Source }| m.source),
  ).fold(
    { own: [], declared: None },
    |accumulator: { own: List<ModuleDependencies>, declared: Option<List<HomeNames>> }, source: Source| {
      let p = with_home_imports(source, pulled(source), accumulator.declared, read);
      { own: accumulator.own.push({ name: source.name, pulls: p.pulls }), declared: p.declared }
    },
  );
  let own = read_own.own;
  let needed = read_needed(
    own.len(),
    listed,
    read,
    read_data,
    pulled,
    {
      importers: own.map(|m: ModuleDependencies| { name: m.name, imports: m.pulls.imports }),
      found: [],
      data: [],
      tried: Set::empty(),
      pulls: [],
      declared: read_own.declared,
    },
    listed.len() + 1,
    required,
  );
  let lookup_or_empty = needed.found.fold(Set::empty(), |accumulator: Set<Bytes>, s: Source|
    accumulator.insert(s.name));
  {
    sources: needed.found,
    unread: listed.filter(|name: Bytes| !lookup_or_empty.contains(name)),
    data: needed.data,
    required_modules: required,
    dependencies: own.concat(needed.pulls),
  }
}

type ReadProgress = {
  importers: List<Importer>,
  found: List<Source>,
  data: List<ShippedData>,
  tried: Set<Bytes>,
  pulls: List<ModuleDependencies>,
  declared: Option<List<HomeNames>>,
}

fn with_home_imports<| e>(
  source: Source,
  pulls: Dependencies,
  declared: Option<List<HomeNames>>,
  read: (Bytes) -> Option<Bytes> / e,
) -> { pulls: Dependencies, declared: Option<List<HomeNames>> } / {abort.raise | e} =
  if !sees_homes(source.name) { { pulls: pulls, declared: declared } } else {
    let input = start(source.source_text).input;
    let called = called_names(input);
    let d = if called.is_empty() { declared } else {
      Some(match declared {
        Some(d) -> d,
        None -> homes_declaring(|h: Bytes| home_names_in(read(h))),
      })
    };
    let homes = match d { Some(x) -> homes_for(called, x), None -> [] };
    {
      pulls: {
        ..pulls,
        imports: pulls.imports.concat(
          home_imports(homes.concat(scheduler_modules_needed(source.name, input))),
        ),
      },
      declared: d,
    }
  }

fn read_needed<| e>(
  users: Int,
  listed: List<Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
  read_data: (Bytes) -> Option<Bytes> / e,
  pulled: (Source) -> Dependencies / e,
  x: ReadProgress,
  rounds_left: Int,
  required: List<Bytes>,
) -> ReadProgress / {abort.raise | e} = {
  let names = wanted(users, listed, x.importers, required).names.elements().filter(|name: Bytes|
    !x.tried.contains(name));
  if names.len() == 0 || rounds_left <= 0 { x } else {
    read_needed(
      users,
      listed,
      read,
      read_data,
      pulled,
      names.fold(x, |accumulator: ReadProgress, name: Bytes| {
        let tried = accumulator.tried.insert(name);
        match read(name) {
          None -> { ..accumulator, tried: tried },
          Some(text) -> {
            let source = { name: name, source_text: text };
            let added = with_home_imports(source, pulled(source), accumulator.declared, read);
            let pulls = added.pulls;
            read_embedded_files(
              listed,
              read,
              read_data,
              {
                ..accumulator,
                importers: accumulator.importers.push({ name: name, imports: pulls.imports }),
                found: accumulator.found.push(source),
                tried: tried,
                pulls: accumulator.pulls.push({ name: name, pulls: pulls }),
                declared: added.declared,
              },
              name,
              requests_in(pulls.wants),
            )
          },
        }
      }),
      rounds_left - 1,
      required,
    )
  }
}

fn read_embedded_files<| e>(
  listed: List<Bytes>,
  read: (Bytes) -> Option<Bytes> / e,
  read_data: (Bytes) -> Option<Bytes> / e,
  x: ReadProgress,
  module: Bytes,
  wants: List<EmbedRequest>,
) -> ReadProgress / {abort.raise | e} =
  wants.fold(x, |accumulator: ReadProgress, want: EmbedRequest|
    if want.dir { accumulator } else {
      match shipped_name(module, want.path) {
        Some(name) -> if accumulator.tried.contains(name) || !listed.contains(name) { accumulator }
        else {
          let tried = accumulator.tried.insert(name);
          match read(name) {
            None -> { ..accumulator, tried: tried },
            Some(text) ->
              {
                ..accumulator,
                found: accumulator.found.push({ name: name, source_text: text }),
                tried: tried,
              },
          }
        },
        None -> match shipped_data_name(module, want.path) {
          None -> accumulator,
          Some(name) -> if accumulator.tried.contains(name) { accumulator } else {
            let tried = accumulator.tried.insert(name);
            match read_data(name) {
              None -> { ..accumulator, tried: tried },
              Some(bytes) ->
                {
                  ..accumulator,
                  data: accumulator.data.push({ name: name, bytes: bytes }),
                  tried: tried,
                },
            }
          },
        },
      }
    })

fn shipped_path_parts(module: Bytes, path: Bytes) -> Option<List<Bytes>> =
  if path.starts_with(b"/") { None } else {
    match path.split(b"/").fold(
        Some(module.split(b".").drop_last(1)),
        |inside: Option<List<Bytes>>, part: Bytes|
          match inside {
            None -> None,
            Some(dir) -> if part == b"" || part == b"." { inside }
            else if part == b".." { if dir.len() > 0 { Some(dir.drop_last(1)) } else { None } }
            else if dir.len() == 0 && !shipped_root(part) { None }
            else { Some(dir.push(part)) },
          },
      ) {
      Some(parts) -> if parts.len() < 2 { None } else { Some(parts) },
      None -> None,
    }
  }

fn shipped_root(part: Bytes) -> Bool = is_shipped(part) && part.index_of(b".") == None

fn shipped_name(module: Bytes, path: Bytes) -> Option<Bytes> / {abort.raise} =
  if !path.ends_with(b".ply") { None } else {
    match shipped_path_parts(module, path) {
      Some(parts) -> {
        let named = Bytes::join(parts, b".");
        Some(named.slice(0, named.len() - 4))
      },
      None -> None,
    }
  }

pub fn shipped_data_name(module: Bytes, path: Bytes) -> Option<Bytes> =
  if path.ends_with(b".ply") { None } else {
    match shipped_path_parts(module, path) {
      Some(parts) -> Some(Bytes::join(parts, b"/")),
      None -> None,
    }
  }

fn data_wants(module: Source) -> List<{ want: EmbedRequest, name: Bytes }> / {abort.raise} =
  if !may_call_embed(module.source_text) { [] } else {
    embed_requests(parse(module.source_text).node).fold(
      [],
      |accumulator: List<{ want: EmbedRequest, name: Bytes }>, want: EmbedRequest|
        if want.dir { accumulator } else {
          match shipped_data_name(module.name, want.path) {
            Some(name) -> accumulator.push({ want: want, name: name }),
            None -> accumulator,
          }
        },
    )
  }

pub fn shipped_data_wanted(module: Source) -> List<Bytes> / {abort.raise} =
  data_wants(module).fold([], |accumulator: List<Bytes>, w: { want: EmbedRequest, name: Bytes }|
    accumulator.push_unique(w.name))

pub type ShippedWants = { texts: List<Bytes>, data: List<Bytes> }

derive bin for ShippedWants

pub fn shipped_wants(module: Source) -> ShippedWants / {abort.raise} =
  if !may_call_embed(module.source_text) { { texts: [], data: [] } }
  else { shipped_wants_in(module.name, parse(module.source_text).node) }

pub fn shipped_wants_of(module: Source, node: Module) -> ShippedWants / {abort.raise} =
  if !may_call_embed(module.source_text) { { texts: [], data: [] } }
  else { shipped_wants_in(module.name, node) }

fn shipped_wants_in(name: Bytes, node: Module) -> ShippedWants / {abort.raise} =
  embed_requests(node).fold(
    { texts: [], data: [] },
    |accumulator: ShippedWants, want: EmbedRequest|
      if want.dir { accumulator } else {
        match shipped_name(name, want.path) {
          Some(n) -> { ..accumulator, texts: accumulator.texts.push_unique(n) },
          None -> match shipped_data_name(name, want.path) {
            Some(n) -> { ..accumulator, data: accumulator.data.push_unique(n) },
            None -> accumulator,
          },
        }
      },
  )

pub fn shipped_data_embeds(
  module: Source,
  data: List<ShippedData>,
) -> List<ModuleEmbed> / {abort.raise} = {
  let lookup_or_empty = data_by_name(embed_files_of(data));
  data_wants(module).fold(
    [],
    |accumulator: List<ModuleEmbed>, w: { want: EmbedRequest, name: Bytes }|
      match lookup_or_empty.get(w.name) {
        Some(file) ->
          accumulator.push({
            module: module.name,
            key: embed_key(w.want),
            read: Ok([{ ..file, name: b"" }]),
          }),
        None -> accumulator,
      },
  )
}

type PullState = {
  parsed: List<ParsedSource>,
  pulled: List<Bytes>,
  embeds: List<ModuleEmbed>,
  diagnostics: List<Diagnostic>,
  stubbable_bodies: List<StubCuts>,
  unimported: Map<Bytes, List<Bytes>>,
}

fn required_with(required: List<Bytes>, unimported: Map<Bytes, List<Bytes>>) -> List<Bytes> =
  unimported.fold(required, |accumulator: List<Bytes>, _: Bytes, read: List<Bytes>|
    accumulator.concat(read))

fn with_hidden_imports(p: ParsedSource, dependencies: Option<Dependencies>) -> ParsedSource =
  match dependencies {
    None -> p,
    Some(t) -> {
      let have = p.module.module.imports.fold(
        Set::empty(),
        |accumulator: Set<Bytes>, d: ImportDeclaration|
          match d.kind { ModuleAlias(a) -> accumulator.insert(a.name), _ -> accumulator },
      );
      let more = t.imports.filter(|d: ImportDeclaration|
        match d.kind {
          ModuleAlias(a) -> is_hidden_binder(a.name) && !have.contains(a.name),
          _ -> false,
        });
      if more.len() == 0 { p } else {
        {
          ..p,
          module: {
            ..p.module,
            module: { ..p.module.module, imports: p.module.module.imports.concat(more) },
          },
        }
      }
    },
  }

fn pull_rounds(
  users: Int,
  shipped: Map<Bytes, Bytes>,
  whole: Map<Bytes, Bytes>,
  dependencies: Map<Bytes, Dependencies>,
  data: Map<Bytes, EmbedFile>,
  listed: List<Bytes>,
  tested: Bool,
  x: PullState,
  rounds_left: Int,
  required: List<Bytes>,
  declared: List<HomeNames>,
  given: List<ParsedSource>,
  derived: List<ModuleDerivations>,
) -> PullState / {abort.raise} = {
  let early = x.parsed.fold([], |accumulator: List<Diagnostic>, parsed: ParsedSource|
    accumulator.concat(parsed.diagnostics));
  if early.len() > 0 { { ..x, diagnostics: early } } else {
    let r = pull_round(users, shipped, listed, x.parsed, required);
    if r.diagnostics.len() > 0 { { ..x, diagnostics: r.diagnostics } }
    else if r.wanted.len() == 0 { x } else if rounds_left <= 0 {
      panic(
        "standard library modules were still being requested after the last allowed round of loading imports",
      )
    } else {
      let read = missing_imports(
        r.wanted.fold([], |accumulator: List<Source>, name: Bytes, text: Bytes|
          accumulator.push({ name: name, source_text: text })),
        declared,
      );
      let round = r.wanted.fold(x, |accumulator: PullState, name: Bytes, text: Bytes| {
        let at = accumulator.parsed.len();
        let o = shipped_embedded(
          whole,
          dependencies,
          data,
          at,
          parsed_at(given, derived, at, { name: name, source_text: text }),
        );
        {
          ..accumulator,
          parsed: accumulator.parsed.push(if tested { o.parsed } else { untested(o.parsed) }),
          stubbable_bodies: if tested { accumulator.stubbable_bodies } else {
            accumulator.stubbable_bodies.push({
              name: o.parsed.name,
              cuts: cuts_of(o.parsed.module),
            })
          },
          pulled: accumulator.pulled.push(name),
          embeds: accumulator.embeds.concat(o.embeds),
        }
      });
      pull_rounds(
        users,
        shipped,
        whole,
        dependencies,
        data,
        listed,
        tested,
        {
          ..round,
          unimported: read.fold(
            round.unimported,
            |accumulator: Map<Bytes, List<Bytes>>, name: Bytes, reads: List<Bytes>|
              accumulator.insert(name, reads),
          ),
        },
        rounds_left - 1,
        required_with(required, read),
        declared,
        given,
        derived,
      )
    }
  }
}

fn parsed_at(
  given: List<ParsedSource>,
  derived: List<ModuleDerivations>,
  index: Int,
  source: Source,
) -> ParsedSource / {abort.raise} =
  match given.find(|g: ParsedSource| g.name == source.name && g.text == source.source_text) {
    Some(g) -> { ..g, diagnostics: g.diagnostics.map(|d: Diagnostic| moved_to(d, index)) },
    None ->
      parse_from(
        index,
        source,
        parse(source.source_text),
        derivations: match derived.find(|m: ModuleDerivations| m.module == source.name) {
          Some(m) -> m.derivations,
          None -> [],
        },
      ),
  }

fn moved_to(d: Diagnostic, index: Int) -> Diagnostic =
  {
    ..d,
    labels: d.labels.map(|l: Label|
      if place_module(l.place) == Some(0) { { ..l, place: in_module(l.place, index) } } else { l }),
    fixes: fixes_moved(d.fixes, |e: Edit| if e.module == 0 { { ..e, module: index } } else { e }),
  }

type ShippedFile = | ShippedModuleText(Bytes) | ShippedDataFile(Bytes)

fn shipped_file_at(
  module: Bytes,
  want: EmbedRequest,
) -> Result<ShippedFile, Bytes> / {abort.raise} =
  if want.dir {
    Err(
      b"a standard library module can embed only a file from the standard library, not a directory",
    )
  } else {
    match shipped_name(module, want.path) {
      Some(name) -> Ok(ShippedModuleText(name)),
      None -> match shipped_data_name(module, want.path) {
        Some(name) -> Ok(ShippedDataFile(name)),
        None ->
          Err(
            Bytes::concat_all([
              b"`",
              want.path,
              b"` is not a file in the standard library; check the path",
            ]),
          ),
      },
    }
  }

fn not_shipped(want: EmbedRequest) -> Bytes =
  Bytes::concat_all([b"`", want.path, b"` is not among what the shipped modules contain"])

fn shipped_read(
  whole: Map<Bytes, Bytes>,
  data: Map<Bytes, EmbedFile>,
  module: Bytes,
  want: EmbedRequest,
) -> EmbedResult / {abort.raise} =
  match shipped_file_at(module, want) {
    Err(reason) -> Err(reason),
    Ok(ShippedModuleText(name)) -> match whole.get(name) {
      Some(text) -> Ok([embed_file(b"", text)]),
      None -> Err(not_shipped(want)),
    },
    Ok(ShippedDataFile(name)) -> match data.get(name) {
      Some(file) -> Ok([{ ..file, name: b"" }]),
      None -> Err(not_shipped(want)),
    },
  }

pub fn shipped_bytes<| e>(
  module: Bytes,
  key: Bytes,
  text: (Bytes) -> Option<Bytes> / {abort.raise | e},
  data: (Bytes) -> Option<Bytes> / {abort.raise | e},
) -> EmbedBytesResult / {abort.raise | e} = {
  let want = request_of_key(key);
  match shipped_file_at(module, want) {
    Err(reason) -> Err(reason),
    Ok(at) -> {
      let lookup_or_empty = match at {
        ShippedModuleText(name) -> text(name),
        ShippedDataFile(name) -> data(name),
      };
      match lookup_or_empty {
        Some(bytes) -> Ok([{ name: b"", bytes: bytes }]),
        None -> Err(not_shipped(want)),
      }
    },
  }
}

pub fn embed_read_of(
  module: Bytes,
  records: List<EmbedRecord>,
  whole: List<Source>,
  data: List<EmbedFile>,
) -> (EmbedRequest) -> EmbedResult / {abort.raise} = {
  let texts = whole.fold(Map::new(), |found: Map<Bytes, Bytes>, s: Source|
    found.insert(s.name, s.source_text));
  let files = data_by_name(data);
  |want: EmbedRequest|
    match records.find(|r: EmbedRecord| r.want == want) {
      Some(r) -> r.read,
      None -> shipped_read(texts, files, module, want),
    }
}

fn embed_files_of(data: List<ShippedData>) -> List<EmbedFile> =
  data.map(|d: ShippedData| embed_file(d.name, d.bytes))

fn data_by_name(data: List<EmbedFile>) -> Map<Bytes, EmbedFile> =
  data.fold(Map::new(), |accumulator: Map<Bytes, EmbedFile>, d: EmbedFile|
    accumulator.insert(d.name, d))

fn shipped_embedded(
  whole: Map<Bytes, Bytes>,
  dependencies: Map<Bytes, Dependencies>,
  data: Map<Bytes, EmbedFile>,
  index: Int,
  parsed: ParsedSource,
) -> { parsed: ParsedSource, embeds: List<ModuleEmbed> } / {abort.raise} = {
  let source = { name: parsed.name, source_text: parsed.text };
  let text = match whole.get(source.name) { Some(t) -> t, None -> source.source_text };
  let read = if text == source.source_text { parsed }
  else { with_hidden_imports(parsed, dependencies.get(source.name)) };
  let p = { ..read, text: text };
  if !may_call_embed(text) { { parsed: p, embeds: [] } } else {
    let wants = if text == source.source_text { embed_requests(p.module.module) } else {
      match dependencies.get(source.name) {
        Some(t) -> requests_in(t.wants),
        None -> embed_requests(parse(text).node),
      }
    };
    let table = wants.fold(
      Map::new(),
      |accumulator: Map<Bytes, EmbedResult>, want: EmbedRequest|
        accumulator.insert(embed_key(want), shipped_read(whole, data, source.name, want)),
    );
    embeds_inlined(p, index, table)
  }
}

pub fn embeds_inlined(
  p: ParsedSource,
  index: Int,
  table: Map<Bytes, EmbedResult>,
) -> { parsed: ParsedSource, embeds: List<ModuleEmbed> } = {
  let r = inline_embeds(p.module.module, table, []);
  {
    parsed: {
      ..p,
      module: { ..p.module, module: r.module },
      diagnostics: p.diagnostics.concat(
        r.diagnostics.map(|diagnostic: ParseDiagnostic| diagnostic_in_module(index, diagnostic)),
      ),
    },
    embeds: table.fold([], |accumulator: List<ModuleEmbed>, key: Bytes, read: EmbedResult|
      accumulator.push({ module: p.name, key: key, read: read })),
  }
}

pub fn parse_shipped(
  modules: List<Source>,
  shipped: List<Source>,
  data: List<ShippedData>,
) -> List<ParsedSource> / {abort.raise} = {
  let whole = shipped.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, s: Source|
    accumulator.insert(s.name, s.source_text));
  let lookup_or_empty = data_by_name(embed_files_of(data));
  range(0, modules.len()).map(|i: Int|
    shipped_embedded(whole, Map::new(), lookup_or_empty, i, parse_at(i, modules.get(i))).parsed)
}

pub type StagedLoad = { pulled: List<Bytes>, hashed: Result<HashedProgram, List<Diagnostic>> }

pub fn viewed_text(viewed: List<ShippedModuleSummary>) -> Bytes = {
  let line = |parts: List<Bytes>|
    parts.fold(b"", |accumulator: Bytes, part: Bytes|
      if accumulator.len() == 0 { part }
      else { Bytes::concat_all([accumulator, b"\t", part]) }).concat(
      b"\n",
    );
  Bytes::concat_all(
    viewed.fold([], |accumulator: List<Bytes>, v: ShippedModuleSummary|
      v.definitions.fold(
        accumulator.push(line([b"shipform", v.module, v.text, v.form])),
        |a: List<Bytes>, d: { name: Bytes, hash: Bytes }|
          a.push(line([b"shipdef", v.module, d.name, d.hash])),
      )),
  )
}

type PulledLoad = {
  pulled: PullState,
  package_closure: Closure,
  tree: ToolchainTree,
  embeds_at: List<ModuleEmbed>,
  items: Map<Bytes, List<ItemEmbeds>>,
}

fn pulled_load(
  user: List<Source>,
  shipped: List<Source>,
  packages: PackageSources,
  embeds: List<EmbedRecord>,
  tested: Bool,
  unread: List<Bytes>,
  data: List<EmbedFile>,
  required: List<Bytes>,
  pulls: List<ModuleDependencies>,
  given: List<ParsedSource>,
  derived: List<ModuleDerivations>,
  package_verdicts: Option<ValidatedPackages>,
) -> PulledLoad / {abort.raise} = {
  let package_closure = match package_verdicts {
    Some(j) -> closure_of_validated(j, packages.supplied),
    None -> closure(packages, user.map(|s: Source| s.name)),
  };
  let dependencies = pulls.fold(
    Map::new(),
    |accumulator: Map<Bytes, Dependencies>, m: ModuleDependencies|
      accumulator.insert(m.name, m.pulls),
  );
  let lookup_or_empty = if unread.contains(prelude_module) { shipped }
  else { with_prelude_source(shipped) };
  let texts = lookup_or_empty.fold(Map::new(), |accumulator: Map<Bytes, Bytes>, s: Source|
    accumulator.insert(s.name, s.source_text));
  let sources = user.concat(
    package_closure.modules.map(|m: { pkg: Int, source: Source }| m.source),
  );
  let declared = homes_declaring(|h: Bytes| home_names_in(texts.get(h)));
  let unimported = missing_imports(sources, declared);
  let read = range(0, sources.len()).fold(
    { parsed: [], cuts: [] },
    |accumulator: { parsed: List<ParsedSource>, cuts: List<StubCuts> }, i: Int| {
      let p = parsed_at(given, derived, i, sources.get(i));
      if tested { { ..accumulator, parsed: accumulator.parsed.push(p) } } else {
        {
          parsed: accumulator.parsed.push(untested(p)),
          cuts: accumulator.cuts.push({ name: p.name, cuts: cuts_of(p.module) }),
        }
      }
    },
  );
  let parsed = read.parsed;
  let items = range(0, sources.len()).fold(
    pulls.fold(Map::new(), |accumulator: Map<Bytes, List<ItemEmbeds>>, m: ModuleDependencies|
      if m.pulls.wants.len() == 0 { accumulator }
      else { accumulator.insert(m.name, m.pulls.wants) }),
    |accumulator: Map<Bytes, List<ItemEmbeds>>, i: Int| {
      let s = sources.get(i);
      if !tested || accumulator.contains(s.name) || !may_call_embed(s.source_text) { accumulator }
      else { accumulator.insert(s.name, requests_by_item(parsed.get(i).module.module)) }
    },
  );
  let mentions = user.map(|s: Source| may_call_embed(s.source_text)).concat(
    package_closure.modules.map(|m: { pkg: Int, source: Source }|
      may_call_embed(m.source.source_text)),
  );
  let declaration_sources = embedded_all(parsed, embed_slots(packages, user), mentions, embeds);
  let assembled = declaration_sources.parsed;
  let named = shipped.map(|s: Source| s.name).concat(unread);
  let listed = named.concat(lookup_or_empty.drop(shipped.len()).map(|s: Source| s.name));
  let tree = NoTree;
  let x = pull_rounds(
    assembled.len(),
    texts,
    texts,
    dependencies,
    data_by_name(data),
    listed,
    tested,
    {
      parsed: assembled,
      pulled: [],
      embeds: [],
      stubbable_bodies: read.cuts,
      diagnostics: [],
      unimported: unimported,
    },
    texts.len(),
    required_with(required, unimported),
    declared,
    given,
    derived,
  );
  {
    pulled: x,
    package_closure: package_closure,
    tree: tree,
    embeds_at: declaration_sources.at,
    items: items,
  }
}

pub fn load_with_shipped(
  user: List<Source>,
  shipped: List<Source>,
  packages: PackageSources = { root: b"", manifest: None, supplied: [] },
  embeds: List<EmbedRecord> = [],
  tested: Bool = true,
  unread: List<Bytes> = [],
  data: List<EmbedFile> = [],
  required: List<Bytes> = [],
  pulls: List<ModuleDependencies> = [],
  given: List<ParsedSource> = [],
  derived: List<ModuleDerivations> = [],
  package_verdicts: Option<ValidatedPackages> = None,
) -> StagedLoad / {abort.raise} = {
  let load = pulled_load(
    user,
    shipped,
    packages,
    embeds,
    tested,
    unread,
    data,
    required,
    pulls,
    given,
    derived,
    package_verdicts,
  );
  let x = load.pulled;
  let hashed = |parsed: List<ParsedSource>|
    match hashed_closure(
        parsed,
        load.package_closure,
        user.len(),
        load.tree,
        x.unimported,
        load.embeds_at.concat(x.embeds),
        x.stubbable_bodies,
      ) {
      Err(diagnostics) -> Err(diagnostics),
      Ok(h) -> Ok({ ..h, embed_items: load.items }),
    };
  if x.diagnostics.len() > 0 { { pulled: x.pulled, hashed: Err(x.diagnostics) } }
  else { { pulled: x.pulled, hashed: hashed(x.parsed) } }
}

fn first_shipped_slot(h: HashedProgram) -> Int = h.resolved.root_count + h.closure.modules.len()

fn shipped_functions(h: HashedProgram) -> Set<Bytes> / {abort.raise} =
  range(first_shipped_slot(h), h.resolved.modules.len()).fold(
    Set::empty(),
    |accumulator: Set<Bytes>, i: Int| {
      let m = h.resolved.modules.get(i);
      m.module.items.fold(accumulator, |a: Set<Bytes>, item: Item|
        match item { FunctionItem(d) -> a.insert(qualify(m.name, d.name.name)), _ -> a })
    },
  )

fn shipped_views_of(
  h: HashedProgram,
  read: (Bytes) -> Bool,
) -> List<ShippedModuleSummary> / {abort.raise} = {
  let first = first_shipped_slot(h);
  let candidates = shipped_functions(h);
  let definitions = h.hashes.definitions.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }|
      accumulator.insert(d.name, d.hash),
  );
  let declarations = h.hashes.declarations.fold(
    Map::new(),
    |accumulator: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }|
      accumulator.insert(d.name, d.hash),
  );
  let nodes = h.resolved.index.nodes.fold(
    Map::new(),
    |accumulator: Map<Int, List<Node>>, n: Node|
      if n.module < first { accumulator } else {
        accumulator.insert(
          n.module,
          List::push(match accumulator.get(n.module) { Some(ns) -> ns, None -> [] }, n),
        )
      },
  );
  range(first, h.resolved.modules.len()).map(|i: Int| {
    let m = h.resolved.modules.get(i);
    let own = match nodes.get(i) { Some(ns) -> ns, None -> [] };
    let hash_of = |table: Map<Bytes, Bytes>, name: Bytes|
      match table.get(name) { Some(hash) -> hash, None -> b"" };
    let shape = own.fold([], |accumulator: List<Bytes>, n: Node|
      match n.body {
        NodeFn(_) -> if candidates.contains(n.name) { accumulator }
        else { accumulator.push(b"derived ".concat(n.name)) },
        _ ->
          accumulator.push(
            Bytes::concat_all([b"declared ", n.name, b" ", hash_of(declarations, n.name)]),
          ),
      }).concat(
      m.module.imports.map(|d: ImportDeclaration| b"imports ".concat(import_module_name(d))),
    ).concat(
      m.module.items.fold([], |accumulator: List<Bytes>, item: Item|
        match item {
          EffectSetItem(_) -> accumulator.push(b"set ".concat(dump_item(item))),
          _ -> accumulator,
        }),
    );
    {
      module: m.name,
      text: hex(blake3(h.resolved.texts.get(i))),
      form: hex(blake3(Bytes::join(shape, b"\n"))),
      definitions: own.fold([], |accumulator: List<{ name: Bytes, hash: Bytes }>, n: Node|
        match n.body {
          NodeFn(_) -> if read(n.name) {
            accumulator.push({ name: n.name, hash: hex(hash_of(definitions, n.name)) })
          } else { accumulator },
          _ -> accumulator,
        }),
    }
  })
}

pub fn shipped_viewer(modules: List<Bytes>) -> Source =
  {
    name: b"viewer",
    source_text: Bytes::concat_all(
      modules.map(|m: Bytes| Bytes::concat_all([b"import ", m, b"\n"])),
    ),
  }

pub fn shipped_views(
  modules: List<Bytes>,
  shipped: List<Source>,
  unread: List<Bytes> = [],
  data: List<ShippedData> = [],
) -> Result<List<ShippedModuleSummary>, List<Diagnostic>> / {abort.raise} =
  match load_with_shipped(
      [shipped_viewer(modules)],
      shipped,
      tested: false,
      unread: unread,
      data: embed_files_of(data),
    ).hashed {
    Err(diagnostics) -> Err(diagnostics),
    Ok(h) -> Ok(shipped_views_of(h, |name: Bytes| true)),
  }

fn is_module_level_item(item: Item) -> Bool =
  match item {
    EffectSetItem(_) -> true,
    DeriveItem(_) -> true,
    InstanceItem(_) -> true,
    NumericItem(_) -> true,
    SchemaItem(_) -> true,
    _ -> false,
  }

pub fn module_form_digest(module: Module, text: Bytes) -> Bytes / {abort.raise} = {
  let declaration_sources = module.imports.filter(|d: ImportDeclaration|
    match d.kind { ModuleAlias(a) -> !is_hidden_binder(a.name), _ -> true });
  let imports = declaration_sources.map(|d: ImportDeclaration|
    Bytes::concat_all([
      b"import ",
      Bytes::join(d.path.map(|part: Identifier| part.name), b"."),
      match d.kind {
        WholeModule -> b"",
        ModuleAlias(a) -> b" as ".concat(a.name),
        SelectedNames(ns) ->
          Bytes::concat_all([b" (", Bytes::join(ns.map(|n: Identifier| n.name), b","), b")"]),
      },
    ]));
  let items = module.items.fold([], |accumulator: List<Bytes>, item: Item|
    if !is_module_level_item(item) { accumulator } else {
      let at = item_span(item);
      if at.start < 0 || at.end > text.len() || at.start > at.end { accumulator.push(b"?") }
      else { accumulator.push(text.slice(at.start, at.end)) }
    });
  hex(
    blake3(
      Bytes::join(
        imports.sort_by(|a: Bytes, b: Bytes|
          match compare_values(a, b) { Greater -> false, _ -> true }).concat(
          items,
        ),
        b"\n",
      ),
    ),
  )
}

pub fn locked_packages(
  user: List<Source>,
  packages: PackageSources,
  embeds: List<EmbedRecord>,
) -> Result<List<LockedPackage>, List<Diagnostic>> / {abort.raise} = {
  let package_closure = closure(packages, user.map(|source: Source| source.name));
  let sources = user.concat(
    package_closure.modules.map(|m: { pkg: Int, source: Source }| m.source),
  );
  if package_closure.diagnostics.len() > 0 {
    Err(
      package_closure.diagnostics.map(|sd: { slot: Int, diagnostic: ParseDiagnostic }|
        if sd.slot < 0 { diagnostic_in_module(0 - sd.slot - 1, sd.diagnostic) }
        else { diagnostic_in_module(sources.len() + sd.slot, sd.diagnostic) }),
    )
  } else {
    let slots = embed_slots(packages, user);
    let tables = embed_reads(embeds);
    let read = range(0, sources.len()).fold([], |accumulator: List<ModuleEmbed>, i: Int| {
      let source = sources.get(i);
      match slots.at(i) {
        Some(slot) -> if !may_call_embed(source.source_text) { accumulator } else {
          match tables.get(slot) {
            Some(table) ->
              table.fold(accumulator, |a: List<ModuleEmbed>, key: Bytes, read: EmbedResult|
                a.push({ module: source.name, key: key, read: read })),
            None -> accumulator,
          }
        },
        None -> accumulator,
      }
    });
    Ok(pins_of(package_closure, read))
  }
}

pub type EmbedRecord = { root: Bytes, module: Bytes, want: EmbedRequest, read: EmbedResult }

derive bin for EmbedRecord

pub fn may_call_embed(text: Bytes) -> Bool / {abort.raise} = calls_embed_from(text, 0)

fn calls_embed_from(text: Bytes, from: Int) -> Bool / {abort.raise} =
  iterate(from, text.len() + 2, |at: Int|
    match text.index_of_from(b"embed", at) {
      None -> Stop(false),
      Some(i) -> {
        let whole = (i == 0 || !is_identifier_continue(text.at(i - 1)))
          && !(i >= 7 && text.slice(i - 7, i) == b"import ");
        let end = if i + 9 < text.len() { i + 9 } else { text.len() };
        let named = if text.slice(i + 5, end) == b"_dir" { i + 9 } else { i + 5 };
        let next = past_spaces(text, named);
        if whole && next < text.len() && (text.at(next) == 40 || text.at(next) == 47) { Stop(true) }
        else { Continue(i + 5) }
      },
    })

fn past_spaces(text: Bytes, at: Int) -> Int / {abort.raise} =
  if at < text.len()
      && (text.at(at) == 32 || text.at(at) == 9 || text.at(at) == 10 || text.at(at) == 13) {
    past_spaces(text, at + 1)
  } else { at }

pub fn embed_inputs_of<| e>(
  embeds: List<ModuleEmbed>,
  read: (ModuleEmbed) -> EmbedBytesResult / {abort.raise | e},
) -> Result<Map<Bytes, Bytes>, List<Diagnostic>> / {abort.raise | e} = {
  let lookup_or_empty = embeds.fold(
    { inputs: Map::new(), moved: [] },
    |accumulator: { inputs: Map<Bytes, Bytes>, moved: List<ModuleEmbed> }, embed: ModuleEmbed|
      match embed.read {
        Err(_) -> accumulator,
        Ok(was) -> match read(embed) {
          Err(_) -> { ..accumulator, moved: accumulator.moved.push(embed) },
          Ok(files) -> {
            let now = files.map(|f: EmbedBytes| embed_file(f.name, f.bytes));
            if now != was { { ..accumulator, moved: accumulator.moved.push(embed) } } else {
              {
                ..accumulator,
                inputs: range(0, files.len()).fold(
                  accumulator.inputs,
                  |m: Map<Bytes, Bytes>, i: Int| m.insert(now.get(i).digest, files.get(i).bytes),
                ),
              }
            }
          },
        },
      },
  );
  if lookup_or_empty.moved.len() == 0 { Ok(lookup_or_empty.inputs) }
  else { Err(lookup_or_empty.moved.map(changed_embed_error)) }
}

fn changed_embed_error(embed: ModuleEmbed) -> Diagnostic / {abort.raise} =
  error_unplaced(
    b"E0146",
    Bytes::concat_all([
      b"`",
      request_of_key(embed.key).path,
      b"`, which `",
      embed.module,
      b"` embeds, could not be embedded because it changed after the program was checked",
    ]),
    b"the contents of the file are different from when the program was checked",
    [b"a file an embed reads changed while the program was loaded; run again"],
  )

pub fn embeds_wanted(root: Bytes, sources: List<Source>) -> List<EmbedRecord> / {abort.raise} =
  sources.fold([], |accumulator: List<EmbedRecord>, source: Source|
    if !may_call_embed(source.source_text) { accumulator }
    else { accumulator.concat(module_embeds_wanted(root, source, parse(source.source_text).node)) })

pub fn module_embeds_wanted(
  root: Bytes,
  source: Source,
  raw: Module,
) -> List<EmbedRecord> / {abort.raise} =
  if !may_call_embed(source.source_text) { [] } else {
    embed_requests(raw).map(|want: EmbedRequest|
      { root: root, module: source.name, want: want, read: Err(b"not read yet") })
  }

pub fn embed_slot(root: Bytes, module: Bytes) -> Bytes = Bytes::concat_all([root, b"\x00", module])

fn embed_slots(packages: PackageSources, user: List<Source>) -> List<Bytes> =
  packages.supplied.fold(
    user.map(|source: Source| embed_slot(packages.root, source.name)),
    |accumulator: List<Bytes>, supplied: SuppliedPackage|
      supplied.modules.fold(accumulator, |a: List<Bytes>, source: Source|
        a.push(embed_slot(supplied.root, source.name))),
  )

fn embed_reads(embeds: List<EmbedRecord>) -> Map<Bytes, Map<Bytes, EmbedResult>> =
  embeds.fold(Map::new(), |accumulator: Map<Bytes, Map<Bytes, EmbedResult>>, embed: EmbedRecord| {
    let slot = embed_slot(embed.root, embed.module);
    let was = match accumulator.get(slot) { Some(t) -> t, None -> Map::new() };
    accumulator.insert(slot, was.insert(embed_key(embed.want), embed.read))
  })

fn embedded_all(
  parsed: List<ParsedSource>,
  slots: List<Bytes>,
  mentions: List<Bool>,
  embeds: List<EmbedRecord>,
) -> { parsed: List<ParsedSource>, at: List<ModuleEmbed> } / {abort.raise} = {
  let tables = embed_reads(embeds);
  range(0, parsed.len()).fold(
    { parsed: [], at: [] },
    |accumulator: { parsed: List<ParsedSource>, at: List<ModuleEmbed> }, i: Int| {
      let p = parsed.get(i);
      match ((slots.at(i), mentions.at(i))) {
        (Some(slot), Some(true)) -> {
          let table = match tables.get(slot) { Some(t) -> t, None -> Map::new() };
          let inlined = embeds_inlined(p, i, table);
          {
            parsed: accumulator.parsed.push(inlined.parsed),
            at: accumulator.at.concat(inlined.embeds),
          }
        },
        _ -> { ..accumulator, parsed: accumulator.parsed.push(p) },
      }
    },
  )
}

