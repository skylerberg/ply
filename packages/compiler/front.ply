    b"shift_from",
    b"trie_shift",
    b"List::at",
    b"trie_path",
    b"trie_inserted",
    b"trie_pushed",
    b"List::push",
    b"entries_gathered",
    b"Map::entries",
  ].map(|n: Bytes| qualify(prelude_module, n))

pub fn declaration_sources() -> List<Source> =
  [
    {
      name: b"m",
      source_text: b"pub type Pair<a, b> = { fst: a, snd: b }\npub effect log { write emit(Bytes) -> Unit }\npub reuse fn keep(xs: List<Int>) -> List<Int> = xs.push(1)\nlaw \"bounds\" forall (n: Int) where n > -3 && n < 7 { n == n }",
    },
  ]

fn bounds_written(guard: Bytes) -> List<Bounded> / {abort.raise} = {
  let modules = parse_all([
    {
      name: b"m",
      source_text: Bytes::concat_all([
        b"law \"l\" forall (n: Int, m: Int) where ",
        guard,
        b" { true }\n",
      ]),
    },
  ]).map(|p: ParsedSource| p.module);
  modules.get(0).module.items.fold([], |accumulator: List<Bounded>, item: Item|
    match item { LawItem(d) -> guard_bounds(modules, d), _ -> accumulator })
}

test "a guard gives a name a numeric range when `&&`-joined top-level comparisons bound the name between two integer literals" {
  assert_eq(bounds_written(b"n > 0 && n <= 100"), [{ name: b"n", low: 1, high: 100 }]);
  assert_eq(bounds_written(b"3 <= n && 9 > n && m == -2"), [
    { name: b"n", low: 3, high: 8 },
    { name: b"m", low: -2, high: -2 },
  ]);
  assert_eq(bounds_written(b"n >= 0 && n >= 5 && n < 9 && n < 20"), [
    { name: b"n", low: 5, high: 8 },
  ]);
  assert_eq(bounds_written(b"n > 5 && n < 3"), [{ name: b"n", low: 6, high: 2 }]);
  assert_eq(bounds_written(b"n > 0"), []);
  assert_eq(bounds_written(b"(n > 0 && n < 9) || m == 1"), []);
  assert_eq(bounds_written(b"!(n > 0) && n < 9 && m > n && m < 4"), [])
}

const law_sources: List<Source> =
  [
    { name: b"base", source_text: b"pub fn one() -> Int = 1\npub type Coin = | Heads | Tails" },
    {
      name: b"app",
      source_text: b"import base\nfn two(x: Int) -> Option<Int> requires x > 0 = Some(base::one() + [x].len())\nlaw \"it grows\" forall (x: Int) where x > 0 { two(x) != None }",
    },
  ]

fn code_text(c: Option<Code>) -> Bytes / {abort.raise} = match c { Some(x) -> dump(x), None -> b"" }

test "lowering a definition to a proof claim names each global by its program-wide name, but leaves builtins and prelude constructors unqualified" {
  let out = claims(law_sources);
  assert_eq(out.len(), 4);
  match out.get(0) {
    ClaimDefinition(d) -> {
      assert_eq(d.name, b"base.one");
      assert_eq(d.params, 0);
      assert_eq(code_text(d.body), b"lit(i1)");
      assert_eq(d.spec, [])
    },
    _ -> assert(false),
  };
  assert_eq(out.get(1), ClaimSum({ name: b"base.Coin", variants: 2 }));
  match out.get(2) {
    ClaimDefinition(d) -> {
      assert_eq(d.name, b"app.two");
      assert_eq(d.params, 1);
      assert_eq(
        code_text(d.body),
        b"app(ctor(Some),bin(add,app(def(base.one)),app(builtin(List::len),list(var(x,0),))))",
      );
      assert_eq(d.spec.map(|c: ClaimClause| c.kind), [RequiresClause]);
      let c = d.spec.get(0).clause;
      assert_eq(c.at, InSource({ module: 1, start: 51, end: 56 }));
      assert_eq(code_text(Some(c.code)), b"bin(gt,var(x,0),lit(i0))")
    },
    _ -> assert(false),
  };
  match out.get(3) {
    ClaimLaw(l) -> {
      assert_eq(l.key, b"app.it grows");
      assert(l.guard != None);
      assert_eq(code_text(Some(l.body)), b"block(bin(ne,app(def(app.two),var(x,0)),ctor(None)))")
    },
    _ -> assert(false),
  }
}

test "a law that instantiates a schema produces the schema's guard and body with the supplied arguments substituted in" {
  let out = claims([
    {
      name: b"lib",
      source_text: b"pub fn limit() -> Int = 100\npub law schema fixed(f: (Int) -> Int, low: Int) forall (x: Int) where x > low && x < limit() { f(x) == x }",
    },
    {
      name: b"app",
      source_text: b"import lib\nfn id(n: Int) -> Int = n\nlaw \"made\" = lib::fixed(id, 0)\nlaw \"written\" forall (x: Int) where x > 0 && x < lib::limit() { id(x) == x }\nlaw \"through a lambda\" = lib::fixed(|n: Int| id(n), 0)",
    },
  ]);
  let body_of = |key: Bytes|
    out.fold(b"", |found: Bytes, c: Claim|
      match c {
        ClaimLaw(l) -> if l.key == key { code_text(Some(l.body)) } else { found },
        _ -> found,
      });
  let guard_of = |key: Bytes|
    out.fold(b"", |found: Bytes, c: Claim|
      match c {
        ClaimLaw(l) -> if l.key != key { found }
        else { match l.guard { Some(g) -> code_text(Some(g.code)), None -> b"" } },
        _ -> found,
      });
  assert_eq(body_of(b"app.made"), body_of(b"app.written"));
  assert_eq(guard_of(b"app.made"), guard_of(b"app.written"));
  assert(guard_of(b"app.made").index_of(b"lib.limit") != None);
  assert(body_of(b"app.through a lambda").index_of(b"lam(") != None);
  assert(body_of(b"app.through a lambda").index_of(b"lib.fixed") == None)
}

test "lowering a record update to a proof claim gives the equivalent record literal" {
  let out = claims([
    {
      name: b"m",
      source_text: b"pub type P = { a: Int, b: Int }\npub fn bump(p: P) -> P = {..p, b: 3}",
    },
  ]);
  assert_eq(out.len(), 1);
  match out.get(0) {
    ClaimDefinition(d) -> assert(code_text(d.body).index_of(b"upd(") != None),
    _ -> assert(false),
  }
}

pub const shipped_modules: List<Source> =
  [
    { name: b"std.a", source_text: b"import std.c\npub fn a() -> Int = 1" },
    { name: b"std.b", source_text: b"pub fn b() -> Int = 2" },
    { name: b"std.c", source_text: b"pub fn c() -> Int = 3" },
    { name: b"std.d", source_text: b"pub fn d() -> Int = 4" },
  ]

pub fn not_written(names: List<Bytes>) -> List<Bytes> =
  names.filter(|n: Bytes| !used_prelude_functions.contains(n))

pub type Published = { dump: Dump, schemes: List<{ name: Bytes, scheme: Scheme }> }

pub fn published(outcome: AnalysisOutcome) -> Published / {abort.raise} =
  {
    dump: { ..dump_of(outcome), inferred_facts: b"" },
    schemes: match outcome {
      Rejected(_) -> [],
      Analysed(w) ->
        w.checked.definitions.map(|definition_info: DefinitionInfo|
          { name: definition_info.name, scheme: definition_info.scheme }),
    },
  }

pub fn reading(above: Bytes) -> List<Source> =
  [
    {
      name: b"m",
      source_text: above.concat(
        b"pub fn at(b: Bytes, i: Int) -> Int / {abort.raise} = if i < b.len() { b.at(i) } else { 0 }\npub fn walk(b: Bytes, i: Int) -> Int / {abort.raise} = if i < 0 || i >= b.len() { 0 } else { b.at(i) + walk(b, i + 1) }\n",
      ),
    },
  ]

pub fn declared() -> List<Source> =
  [
    {
      name: b"m",
      source_text: b"pub type Shape = | Circle(Int) | Empty\npub nondet effect wall { read now() -> Int\n write set[r](Int) -> Unit }\npub fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\npub fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\ntest \"two is even\" { assert(even(2)) }",
    },
  ]

pub fn hash_of(sources: List<Source>, name: Bytes) -> Bytes / {abort.raise} =
  match resolve_modules(
      parse_all(with_prelude_source(sources)).map(|parsed: ParsedSource| parsed.module),
    ) {
    ResolveFailed(_) -> b"",
    ResolveSucceeded(x) -> match by_name(
        hash_index(build_index(x.modules, x.resolution).index).definitions,
      ).get(
        name,
      ) {
      Some(h) -> h,
      None -> b"",
    },
  }

test "a map or set literal has the same hash as the equivalent constructor call" {
  let set = {
    name: b"std.set",
    source_text: b"pub type Set<a> = | Set(Map<a, Unit>)\npub fn Set::of_list<a>(xs: List<a>) -> Set<a> = Set(Map::new())\n",
  };
  let literal = [
    set,
    {
      name: b"m",
      source_text: b"import std.set (Set)\npub fn two() -> Map<Int, Int> = #{1: 2, 3: 4}\npub fn s() -> Set<Int> = #[5]",
    },
  ];
  let call = [
    set,
    {
      name: b"m",
      source_text: b"import std.set (Set)\npub fn two() -> Map<Int, Int> = Map::of_entries([{key: 1, value: 2}, {key: 3, value: 4}])\npub fn s() -> Set<Int> = Set::of_list([5])",
    },
  ];
  assert(hash_of(literal, b"m.two") != b"");
  assert_eq(hash_of(literal, b"m.two"), hash_of(call, b"m.two"));
  assert_eq(hash_of(literal, b"m.s"), hash_of(call, b"m.s"))
}

test "naming a function that is not exported changes the hash of every definition that names it" {
  let caller = b"import a\npub fn two() -> Int = a::one()";
  let exported = [
    { name: b"a", source_text: b"pub fn one() -> Int = 1" },
    { name: b"b", source_text: caller },
  ];
  let shut = [
    { name: b"a", source_text: b"fn one() -> Int = 1" },
    { name: b"b", source_text: caller },
  ];
  assert(hash_of(exported, b"b.two") != b"");
  assert(hash_of(shut, b"b.two") != hash_of(exported, b"b.two"));
  assert_eq(hash_of(shut, b"a.one"), hash_of(exported, b"a.one"))
}

test "a cycle of packages is rejected, naming the cycle" {
  let user = [{ name: b"m", source_text: b"fn main() -> Int = 1" }];
  let manifest_dependency = b"import std.pkg (Manifest)\nfn package() -> Manifest = {name: \"n\", version: {major: 0, minor: 0, patch: 1}, prefix: None, runtime: {major: 0, minor: 0, patch: 1}, dependencies: [{name: \"other\", prefix: None, min: {major: 0, minor: 0, patch: 1}, source: Path(\"../other\")}], entry: None}";
  let package_closure = closure(
    {
      root: b"a",
      manifest: Some(manifest_dependency),
      supplied: [
        { root: b"other", manifest: Some(manifest_dependency), modules: [] },
        { root: b"other/other", manifest: Some(manifest_dependency), modules: [] },
      ],
    },
    [],
  );
  assert(has_diagnostic(package_closure.diagnostics, b"E0134"))
}

fn has_diagnostic(
  diagnostics: List<{ slot: Int, diagnostic: ParseDiagnostic }>,
  code: Bytes,
) -> Bool =
  diagnostics.fold(false, |accumulator: Bool, sd: { slot: Int, diagnostic: ParseDiagnostic }|
    accumulator || sd.diagnostic.code == code)

test "only a module that may call `embed` is parsed for what it embeds" {
  assert(may_call_embed(b"embed(\"x\")"));
  assert(may_call_embed(b"fn f() -> Bytes = embed_dir (\"x\")"));
  assert(may_call_embed(b"fn f() -> Bytes = embed\n  // why\n  (\"x\")"));
  assert(!may_call_embed(b"fn embeds() -> Int = 1"));
  assert(!may_call_embed(b"import embed (EmbedAt, wants_of)\n"));
  assert(!may_call_embed(b"let embedded = an_embed(1)"));
  assert(!may_call_embed(b"// what the embed reads"));
  assert(!may_call_embed(b"x embed"))
}

test "`shipped_name` maps a file path next to a bundled module to that package's bundled module name, and returns none for paths outside the bundle" {
  assert_eq(shipped_name(b"std.internal.prelude_source", b"../prelude.ply"), Some(b"std.prelude"));
  assert_eq(shipped_name(b"std.a", b"b.ply"), Some(b"std.b"));
  assert_eq(shipped_name(b"std.a", b"./deep/b.ply"), Some(b"std.deep.b"));
  assert_eq(shipped_name(b"std.deep.a", b"../b.ply"), Some(b"std.b"));
  assert_eq(shipped_name(b"std.a", b"../b.ply"), None);
  assert_eq(shipped_name(b"std.a", b"/b.ply"), None);
  assert_eq(shipped_name(b"std.a", b".."), None);
  assert_eq(shipped_name(b"std.a", b"notes.txt"), None);
  assert_eq(shipped_name(b"compiler.prelude_source", b"../std/prelude.ply"), Some(b"std.prelude"));
  assert_eq(shipped_name(b"compiler.emit.a", b"../../std/deep/b.ply"), Some(b"std.deep.b"));
  assert_eq(shipped_name(b"compiler.a", b"../nowhere/b.ply"), None);
  assert_eq(shipped_name(b"compiler.a", b"../std.deep/b.ply"), None);
  assert_eq(shipped_name(b"compiler.a", b"../../std/b.ply"), None);
  assert_eq(shipped_name(b"compiler.a", b"../std"), None)
}

test "`shipped_embedded` returns the files embedded by a bundled module's full text, even when only a stub of the module is parsed" {
  let whole = [
    { name: b"std.a", source_text: b"pub fn text() -> Bytes = embed(\"note.ply\")" },
    { name: b"std.note", source_text: b"one" },
  ].fold(Map::new(), |accumulator: Map<Bytes, Bytes>, s: Source|
    accumulator.insert(s.name, s.source_text));
  let stub = shipped_embedded(
    whole,
    Map::new(),
    Map::new(),
    0,
    parse_at(0, { name: b"std.a", source_text: b"pub fn text() -> Bytes = b\"\"" }),
  );
  assert_eq(stub.embeds, [
    { module: b"std.a", key: b"file:note.ply", read: Ok([embed_file(b"", b"one")]) },
  ])
}

test "a data file beside a shipped module is named by its place below the package's root" {
  assert_eq(shipped_data_name(b"std.oid", b"oid/names.txt"), Some(b"std/oid/names.txt"));
  assert_eq(shipped_data_name(b"std.oid", b"./oid//names.txt"), Some(b"std/oid/names.txt"));
  assert_eq(shipped_data_name(b"std.oid", b"names.txt"), Some(b"std/names.txt"));
  assert_eq(shipped_data_name(b"std.deep.a", b"../b.txt"), Some(b"std/b.txt"));
  assert_eq(shipped_data_name(b"compiler.a", b"../std/oid/names.txt"), Some(b"std/oid/names.txt"));
  assert_eq(shipped_data_name(b"std.a", b"../b.txt"), None);
  assert_eq(shipped_data_name(b"std.a", b"x/../../b.txt"), None);
  assert_eq(shipped_data_name(b"std.a", b"/etc/hosts"), None);
  assert_eq(shipped_data_name(b"std.a", b"b.ply"), None);
  assert_eq(shipped_data_name(b"std.a", b"."), None);
  assert_eq(shipped_data_name(b"std.a", b""), None)
}

pub fn words_module(path: Bytes) -> Source =
  {
    name: b"std.words",
    source_text: Bytes::concat_all([
      b"pub fn list() -> Bytes = embed(\"",
      path,
      b"\")\npub fn count() -> Int = list().len()\npub fn idle() -> Int = 7\n",
    ]),
  }

pub fn words_data(bytes: Bytes) -> List<ShippedData> =
  [{ name: b"std/words/list.txt", bytes: bytes }]

test "`shipped_embedded` returns a shipped module's data file even when the module is given only as a stub without its full source" {
  let whole = Map::new().insert(b"std.words", words_module(b"words/list.txt").source_text);
  let stub = shipped_embedded(
    whole,
    Map::new(),
    data_by_name(embed_files_of(words_data(b"one\n"))),
    0,
    parse_at(0, { name: b"std.words", source_text: b"pub fn list() -> Bytes = b\"\"" }),
  );
  assert_eq(stub.embeds, [
    { module: b"std.words", key: b"file:words/list.txt", read: Ok([embed_file(b"", b"one\n")]) },
  ])
}

test "`shipped_embedded` takes a stub module's embeds from its saved dependency data and never parses its full source" {
  let whole = Map::new().insert(b"std.words", b"embed( names nothing a parse would find");
  let dependencies = Map::new().insert(b"std.words", {
    imports: [],
    wants: requests_by_item(parse(words_module(b"words/list.txt").source_text).node),
  });
  let stub = shipped_embedded(
    whole,
    dependencies,
    data_by_name(embed_files_of(words_data(b"one\n"))),
    0,
    parse_at(0, { name: b"std.words", source_text: b"pub fn list() -> Bytes = b\"\"" }),
  );
  assert_eq(stub.embeds.map(|e: ModuleEmbed| e.key), [b"file:words/list.txt"])
}
