import std.set (Set)
import compiler.check.infer.checker (elsewhere,StoredDeclarations, no_stored_declarations)
import compiler.check.infer.definitions (Extern, parsed_natives)
import compiler.check.resolve.tables (ParsedModule)
import compiler.check.infer.names (simple_name_of)
import compiler.front.facts (Analysis)
import compiler.front.published (rows_of)
import compiler.front.rows (constant_values)
import compiler.emit.lower.module_context (stated_functions)
import compiler.check.typed (ConstantData)
import compiler.emit.representations (EmitReads, over_code_facts, stored_sources, lowering,
                                      failing_on_lowering)

pub fn over_analysis<a>(a: Analysis, body: () -> a / {EmitReads}) -> a / {abort.raise} =
  failing_on_lowering(||
    over_declared(
      a.declared,
      constant_values(rows_of(a)),
      parsed_natives(a.modules),
      a.modules.fold(Set::empty(), |found: Set<Bytes>, m: ParsedModule|
        stated_functions(m.name, m.module).fold(found, |s: Set<Bytes>, n: Bytes| s.insert(n))),
      body,
    ))

pub fn over_nothing_declared<a>(body: () -> a / {EmitReads}) -> a / {abort.raise} =
  failing_on_lowering(|| over_declared(no_stored_declarations, Map::new(), [], Set::empty(), body))

pub fn over_declared<a | e>(
  declared: StoredDeclarations,
  values: Map<Bytes, ConstantData>,
  natives: List<Extern>,
  stated: Set<Bytes>,
  body: () -> a / {EmitReads | e},
) -> a / {lowering.fail, abort.raise | e} =
  handle {
    over_code_facts(
      stored_sources(
        |name: Bytes| values.get(name),
        |name: Bytes| natives.find(|n: Extern| n.name == simple_name_of(name)),
        |name: Bytes| stated.contains(name),
      ),
      body,
    )
  } with {
    elsewhere.look_up_type(name) -> declared.types.get(name),
    elsewhere.look_up_effect(name) -> declared.effects.get(name),
    elsewhere.look_up_constructor(name) -> declared.constructors.get(name),
    elsewhere.look_up_definition(name) -> declared.definitions.get(name),
    elsewhere.look_up_host(name) -> declared.hosts.get(name),
  }
