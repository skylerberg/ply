                             none_constructor, ok_constructor, option_name, result_name,
                             some_constructor, string_name, unit_name, ordering_type)
import compiler.check.types (Type, VariableType, NamedType, FunctionType, RecordType, NominalType,
                             Field, Scheme, Effects, Effect, int_type, bytes_type, bool_type,
                             unit_type, string_type, float_type, list_type, option_type,
                             function_type, monomorphic, no_effects, open_effects, arg_effects,
                             fields_sorted)
import compiler.emit.typing (unknown_type)
import std.list
import std.list (zip)
import compiler.syntax.patterns (LiteralChar)
import std.bytes (ascii_of_int)
