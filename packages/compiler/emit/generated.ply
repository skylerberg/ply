                                      EmitParam, at_args, kind_of, runtime_object,
                                      contains_resource, constructor_fields_at, release_effects)
import compiler.emit.lower.strings (strings_root, strings_code)
import compiler.emit.marks (marked_type, marked_key, without_marks, dynamic_form, has_marks)
import compiler.store.hash.template (emitted_code)
import compiler.emit.writing (unspanned_code, prelude_call, placed, int_code, bool_code, bytes_code,
                              string_code, unit_code, slot_code, binder, field_code, binary_of,
                              applied, builtin_call, native_call, compare_call, constructor_made,
                              prelude_made, prelude_pattern, value_made, if_code, match_code,
                              block_code, some_or, sequence, value_type, Bound, bound_from,
                              bound_pattern, bound_read)

fn is_key_value(t: Type) -> Bool =
  match t { RecordType(fs) -> fs.map(|f: Field| f.name) == [b"key", b"value"], _ -> false }

const walk_operations: List<Bytes> =
  [b"equal", b"equal_from", b"ordered", b"ordered_from"].concat(gathering_walks)

const gathering_walks: List<Bytes> =
  [
    b"reflect_from",
    b"shown_from",
    b"digest_from",
    b"reflect_entries_from",
    b"shown_entries_from",
    b"digest_entries_from",
  ]

const marshal_loops: List<Bytes> =
  [b"lower_items", b"lower_entries", b"lift_items", b"lift_entries"]

pub fn container_operation_generated(operation: Bytes) -> Bool =
  walk_operations.contains(operation) || marshal_loops.contains(operation)
    || dynamic_loops.contains(operation)
    || strings_root(operation)

pub fn container_reads_argument(operation: Bytes, k: Int) -> Bool =
  if gathering_walks.contains(operation) { k != 1 }
  else if dynamic_loops.contains(operation) { k != 1 } else {
    walk_operations.contains(operation) || operation == b"lower_items"
      || operation == b"lower_entries"
      || operation == b"let_go_items"
  }

pub fn container_definitions(module: Bytes, t: Type) -> List<Definition> / {abort.raise} =
  [Reflect, Show, Digest].concat(walk_operations.map(ContainerWalk)).map(
    |written_op: TypeOperation| {
      let operation = operation_name(written_op);
      let root = keys::generated_key(written_op, t, module);
      let typed = container_signature(operation, t);
      {
        name: name_in_module(module, root_text(root_name(root))),
        return_kind: Some(if typed.result_type == bool_type { BoolKind } else { BoxedKind }),
        return_type: OpenShape([]),
        pure: true,
        constant: false,
        value: None,
        arity: typed.params.len(),
        scheme: Some(monomorphic(function_type(typed.params, typed.result_type, no_effects))),
        witnesses: 0,
        borrowed: [],
        root: root,
      }
    },
  )

fn container_signature(operation: Bytes, t: Type) -> { params: List<Type>, result_type: Type } = {
  let value = value_type;
  let entries = list_type(RecordType([{ name: b"key", ty: value }, { name: b"value", ty: value }]));
  let gathered = |l: Type| { params: [t, l, int_type], result_type: l };
  if operation == b"equal" { { params: [t, t], result_type: bool_type } }
  else if operation == b"ordered" { { params: [t, t], result_type: ordering_type } }
  else if operation == b"equal_from" { { params: [t, t, int_type], result_type: bool_type } }
  else if operation == b"ordered_from" { { params: [t, t, int_type], result_type: ordering_type } }
  else if operation == b"reflect_from" || operation == b"shown_from" { gathered(list_type(value)) }
  else if operation == b"digest_from" || operation == b"digest_entries_from" {
    gathered(list_type(bytes_type))
  } else if operation == b"reflect_entries_from" || operation == b"shown_entries_from" {
    gathered(entries)
  } else if operation == b"digest" { { params: [t], result_type: bytes_type } }
  else { { params: [t], result_type: value } }
}

pub type GeneratedRoot = {
  params: List<EmitParam>,
  code: Code,
  definitions: List<Definition>,
  performs: Effects,
}

pub fn container_code(
  module: Bytes,
  constructors: Constructors,
  operation: Bytes,
  t: Type,
) -> GeneratedRoot / {abort.raise} =
  if strings_root(operation) {
    let s = strings_code(module, operation, t);
    { params: s.params, code: s.code, definitions: s.here, performs: no_effects }
  } else {
    let e = container_walk_code(module, constructors, operation, t);
    let word = |n: Bytes|
      { name: n, kind: BoxedKind, ty: kind_of(t).ty, of: Some(t), lambda: None };
    let index = { name: b"i", kind: IntKind, ty: OpenShape([]), of: Some(int_type), lambda: None };
    {
      params: if operation.ends_with(b"_from") { [word(b"a"), word(b"b"), index] }
      else if operation == b"equal" || operation == b"ordered" { [word(b"a"), word(b"b")] }
      else { [word(b"a")] },
      code: e.code,
      definitions: e.here,
      performs: no_effects,
    }
  }

fn container_walk_code(
  module: Bytes,
  constructors: Constructors,
  operation: Bytes,
  t: Type,
) -> { code: Code, here: List<Definition> } / {abort.raise} = {
  let args = match t { NamedType(c) -> c.args, _ -> [] };
  let kind = match t { NamedType(c) -> c.name, _ -> b"" };
  let fields_of = match t { RecordType(fs) -> fs, NominalType(x) -> x.fields, _ -> [] };
  let value = value_type;
  let failure = match args.at(1) { Some(e) -> e, None -> unknown_type };
  let walked = if kind == map_name {
    list_type(
      RecordType([
        { name: b"key", ty: match args.at(0) { Some(k) -> k, None -> unknown_type } },
        { name: b"value", ty: match args.at(1) { Some(v) -> v, None -> unknown_type } },
      ]),
    )
  } else { t };
  let item = match walked {
    NamedType(c) -> match c.args.at(0) { Some(e) -> e, None -> unknown_type },
    _ -> unknown_type,
  };
  let field = |name: Bytes| field_of(item, name);
  let of = if kind == array_name { b"Array::" }
  else if kind == columns_name { b"Columns::" }
  else { b"List::" };
  let here = if kind == map_name {
    container_definitions(module, t).concat(container_definitions(module, walked))
  } else { container_definitions(module, t) };
  let entry_of_values = RecordType([{ name: b"key", ty: value }, { name: b"value", ty: value }]);
  let gathered_item = if operation == b"digest_from" || operation == b"digest_entries_from" {
    bytes_type
  } else if operation == b"reflect_entries_from" || operation == b"shown_entries_from" {
    entry_of_values
  } else { value };
  let typed = container_signature(operation, t);
  let param = |i: Int| match typed.params.at(i) { Some(p) -> p, None -> t };
  let a = slot_code(b"a", 0, param(0));
  let b = slot_code(b"b", 1, param(1));
  let i = slot_code(b"i", 2, int_type);
  let x = slot_code(b"x", 3, item);
  let y = slot_code(b"y", 4, item);
  let next = binary_of(b"add", i, int_code(1));
  let looped = |name: Bytes, operands: List<Code>| {
    let key = keys::generated_key(ContainerWalk(name), walked, module);
    call_of(module, key, operands, container_signature(name, walked).result_type)
  };
  let length = |c: Code, over: List<Type>|
    builtin_call(
      if kind == map_name { b"Map::len" } else { of.concat(b"len") },
      over,
      [c],
      int_type,
    );
  let match_at = |list: Code, name: Bytes, slot: Int, found: Code, ended: Code|
    if kind == array_name || kind == columns_name {
      if_code(
        binary_of(b"lt", i, length(list, [item])),
        block_code(
          [
            CodeLet({
              name: name,
              slot: slot,
              value: builtin_call(of.concat(b"get"), [item], [list, i], item),
            }),
          ],
          found,
        ),
        ended,
      )
    } else {
      some_or(
        prelude_call(b"List::at", [item], [list, i], option_type(item)),
        name,
        slot,
        item,
        found,
        ended,
      )
    };
  let walked_of = |c: Code|
    if kind == map_name { prelude_call(b"Map::entries", args, [c], walked) } else { c };
  let part = |builtin_name: Bytes, c: Code|
    builtin_call(builtin_name, [c.ty], [c], if builtin_name == b"?encoded" { bytes_type }
    else { value });
  let gathered = |name: Bytes, pushed: (Code) -> Code|
    match_at(a, b"x", 3, looped(name, [a, pushed(b), next]), b);
  let push = |list: Code, v: Code| prelude_call(b"List::push", [gathered_item], [list, v], list.ty);
  let entry = |builtin_name: Bytes|
    unspanned_code(
      CodeRecord({
        fields: [
          { name: b"key", value: part(builtin_name, field_code(x, b"key", field(b"key"))) },
          { name: b"value", value: part(builtin_name, field_code(x, b"value", field(b"value"))) },
        ],
      }),
      entry_of_values,
    );
  let empty = |of_item: Type| unspanned_code(CodeList({ items: [] }), list_type(of_item));
  let ordered_then = |name: Bytes, slot: Int, then: Code| {
    let read = |c: Code| if name == b"" { c } else { field_code(c, name, field(name)) };
    let o = b"o".concat(ascii_of_int(slot));
    let compared = compare_call(read(x), read(y));
    block_code(
      [CodeLet({ name: o, slot: slot, value: compared })],
      if_code(
        binary_of(
          b"eq",
          slot_code(o, slot, ordering_type),
          prelude_made(equal_constructor, [], ordering_type),
        ),
        then,
        slot_code(o, slot, ordering_type),
      ),
    )
  };
  let body = if kind == b"" && operation == b"equal" {
    fields_of.fold(
      { code: bool_code(true), first: true },
      |accumulator: { code: Code, first: Bool }, f: Field| {
        let read = |c: Code| field_code(c, f.name, f.ty);
        let eq = binary_of(b"eq", read(a), read(b));
        {
          code: if accumulator.first { eq } else { binary_of(b"and", accumulator.code, eq) },
          first: false,
        }
      },
    ).code
  } else if kind == result_name {
    let arm = |pattern: CodePattern, body2: Code| { pattern: pattern, guard: None, body: body2 };
    let one = |constructor: Bytes, slot: Int, payload_type: Type|
      prelude_pattern(constructor, [
        binder(if slot == 3 { b"x" } else { b"y" }, slot, payload_type),
      ]);
    let other = |constructor: Bytes| prelude_pattern(constructor, [CodeWildcardPattern]);
    let ok = match args.at(0) { Some(o) -> o, None -> unknown_type };
    let xs = |payload_type: Type| slot_code(b"x", 3, payload_type);
    let ys = |payload_type: Type| slot_code(b"y", 4, payload_type);
    if operation == b"equal" {
      match_code(
        a,
        [
          arm(
            one(ok_constructor, 3, ok),
            match_code(
              b,
              [
                arm(one(ok_constructor, 4, ok), binary_of(b"eq", xs(ok), ys(ok))),
                arm(CodeWildcardPattern, bool_code(false)),
              ],
              bool_type,
            ),
          ),
          arm(
            one(err_constructor, 3, failure),
            match_code(
              b,
              [
                arm(one(err_constructor, 4, failure), binary_of(b"eq", xs(failure), ys(failure))),
                arm(CodeWildcardPattern, bool_code(false)),
              ],
              bool_type,
            ),
          ),
        ],
        bool_type,
      )
    } else {
      match_code(
        a,
        [
          arm(
            one(err_constructor, 3, failure),
            match_code(
              b,
              [
                arm(one(err_constructor, 4, failure), compare_call(xs(failure), ys(failure))),
                arm(other(ok_constructor), prelude_made(less_constructor, [], ordering_type)),
              ],
              ordering_type,
            ),
          ),
          arm(
            one(ok_constructor, 3, ok),
            match_code(
              b,
              [
                arm(one(ok_constructor, 4, ok), compare_call(xs(ok), ys(ok))),
                arm(other(err_constructor), prelude_made(greater_constructor, [], ordering_type)),
              ],
              ordering_type,
            ),
          ),
        ],
        ordering_type,
      )
    }
  } else if kind == option_name && operation == b"equal" {
    let arm = |pattern: CodePattern, body2: Code| { pattern: pattern, guard: None, body: body2 };
    let none = prelude_pattern(none_constructor, []);
    match_code(
      a,
      [
        arm(
          none,
          match_code(
            b,
            [arm(none, bool_code(true)), arm(CodeWildcardPattern, bool_code(false))],
            bool_type,
          ),
        ),
        arm(
          prelude_pattern(some_constructor, [binder(b"x", 3, item)]),
          match_code(
            b,
            [
              arm(
                prelude_pattern(some_constructor, [binder(b"y", 4, item)]),
                binary_of(b"eq", x, y),
              ),
              arm(CodeWildcardPattern, bool_code(false)),
            ],
            bool_type,
          ),
        ),
      ],
      bool_type,
    )
  } else if kind == option_name {
    let arm = |pattern: CodePattern, body2: Code| { pattern: pattern, guard: None, body: body2 };
    let none = prelude_pattern(none_constructor, []);
    let order = |name: Bytes| prelude_made(name, [], ordering_type);
    match_code(
      a,
      [
        arm(
          none,
          match_code(
            b,
            [
              arm(none, order(equal_constructor)),
              arm(CodeWildcardPattern, order(less_constructor)),
            ],
            ordering_type,
          ),
        ),
        arm(
          prelude_pattern(some_constructor, [binder(b"x", 3, item)]),
          match_code(
            b,
            [
              arm(none, order(greater_constructor)),
              arm(prelude_pattern(some_constructor, [binder(b"y", 4, item)]), compare_call(x, y)),
            ],
            ordering_type,
          ),
        ),
      ],
      ordering_type,
    )
  } else if operation == b"equal" {
    if_code(
      binary_of(b"eq", length(a, args), length(b, args)),
      looped(b"equal_from", [walked_of(a), walked_of(b), int_code(0)]),
      bool_code(false),
    )
  } else if operation == b"ordered" {
    identical_shortcut(looped(b"ordered_from", [walked_of(a), walked_of(b), int_code(0)]), t)
  } else if operation == b"equal_from" {
    match_at(
      a,
      b"x",
      3,
      match_at(
        b,
        b"y",
        4,
        if_code(binary_of(b"eq", x, y), looped(b"equal_from", [a, b, next]), bool_code(false)),
        bool_code(false),
      ),
      bool_code(true),
    )
  } else if operation == b"ordered_from" {
    match_at(
      a,
      b"x",
      3,
      match_at(
        b,
        b"y",
        4,
        if is_key_value(item) {
          ordered_then(b"key", 5, ordered_then(b"value", 6, looped(b"ordered_from", [a, b, next])))
        } else { ordered_then(b"", 5, looped(b"ordered_from", [a, b, next])) },
        prelude_made(greater_constructor, [], ordering_type),
      ),
      if_code(
        binary_of(b"lt", i, length(b, [item])),
        prelude_made(less_constructor, [], ordering_type),
        prelude_made(equal_constructor, [], ordering_type),
      ),
    )
  } else if operation == b"reflect_from" || operation == b"shown_from" {
    let name = if operation == b"reflect_from" { b"?reflect" } else { b"?shown" };
    gathered(operation, |out: Code| push(out, part(name, x)))
  } else if operation == b"digest_from" {
    gathered(operation, |out: Code| push(out, part(b"?encoded", x)))
  } else if operation == b"reflect_entries_from" || operation == b"shown_entries_from" {
    let name = if operation == b"reflect_entries_from" { b"?reflect" } else { b"?shown" };
    gathered(operation, |out: Code| push(out, entry(name)))
  } else if operation == b"digest_entries_from" {
    gathered(operation, |out: Code|
      push(
        push(out, part(b"?encoded", field_code(x, b"key", field(b"key")))),
        part(b"?encoded", field_code(x, b"value", field(b"value"))),
      ))
  } else if operation == b"digest" {
    let tag = if kind == map_name { 11 }
    else if kind == array_name || kind == columns_name { 10 }
    else { 9 };
    let loop_name = if kind == map_name { b"digest_entries_from" } else { b"digest_from" };
    joined([
      bytes_code(byte_of_int(tag)),
      builtin_call(
        b"Bytes::slice",
        [],
        [part(b"?encoded", length(a, args)), int_code(1), int_code(9)],
        bytes_type,
      ),
      builtin_call(
        b"?concat",
        [],
        [looped(loop_name, [walked_of(a), empty(bytes_type), int_code(0)])],
        bytes_type,
      ),
    ])
  } else {
    let reflecting = operation == b"reflect";
    let made = if kind == map_name { b"std.value.VMap" }
    else if kind == array_name || kind == columns_name { b"std.value.VArray" }
    else { b"std.value.VList" };
    let loop_name = if kind == map_name {
      if reflecting { b"reflect_entries_from" } else { b"shown_entries_from" }
    } else if reflecting { b"reflect_from" }
    else { b"shown_from" };
    value_made(constructors, made, [
      looped(loop_name, [
        walked_of(a),
        empty(if kind == map_name { entry_of_values } else { value }),
        int_code(0),
      ]),
    ])
  };
  { code: body, here: here }
}

pub type InstanceFunction = {
  full: Bytes,
  args: List<Type>,
  fn_type: Type,
  return_type: Type,
  effect_arguments: List<Effects>,
}

pub fn key_instance(
  module: Bytes,
  here: List<Definition>,
  items: List<Item>,
  ty: Type,
) -> Option<InstanceFunction> =
  instance_for(module, here, ty, |c: Bytes|
    items.fold(None, |accumulator: Option<Bytes>, item: Item|
      match item {
        InstanceItem(d) -> if d.kind == KeyInstance && qualify(module, d.target.name) == c {
          Some(d.function.name)
        } else { accumulator },
        _ -> accumulator,
      }))

pub fn numeric_instance(
  module: Bytes,
  here: List<Definition>,
  items: List<Item>,
  ty: Type,
  operation: Bytes,
) -> Option<InstanceFunction> =
  instance_for(module, here, ty, |c: Bytes|
    items.fold(None, |accumulator: Option<Bytes>, item: Item|
      match item {
        NumericItem(d) -> if qualify(module, d.target.name) == c {
          match numeric_by(d, operation) { Some(by) -> Some(by.name), None -> accumulator }
        } else { accumulator },
        _ -> accumulator,
      }))

fn instance_for(
  module: Bytes,
  here: List<Definition>,
  ty: Type,
  named: (Bytes) -> Option<Bytes>,
) -> Option<InstanceFunction> =
  match ty {
    NamedType(c) -> match named(c.name) {
      None -> None,
      Some(f) -> match here.fold(None, |s: Option<Scheme>, h: Definition|
          if h.name == f { h.scheme } else { s }) {
        Some(scheme) -> match scheme.ty {
          FunctionType(fn_type) -> {
            let at_type = fn_type.params.push(fn_type.return_type).fold(
              None,
              |accumulator: Option<List<Type>>, t: Type|
                match accumulator {
                  Some(_) -> accumulator,
                  None -> match t {
                    NamedType(p) -> if p.name == c.name { Some(p.args) } else { None },
                    _ -> None,
                  },
                },
            );
            let written = match at_type { Some(xs) -> xs, None -> [] };
            let args = scheme.type_variables.map(|v: Int|
              range(0, written.len()).fold(unknown_type, |found: Type, i: Int|
                if written.at(i) == Some(VariableType(v)) {
                  match c.args.at(i) { Some(t) -> t, None -> found }
                } else { found }));
            let effect_arguments = scheme.effect_variables.map(|v: Int|
              range(0, written.len()).fold(no_effects, |found: Effects, i: Int|
                match ((written.at(i), c.args.at(i))) {
                  (Some(w), Some(given)) -> if arg_effects(w) == Some(open_effects(v)) {
                    match arg_effects(given) { Some(r) -> r, None -> found }
                  } else { found },
                  _ -> found,
                }));
            Some({
              full: qualify(module, f),
              args: args,
              fn_type: at_args(scheme.ty, scheme.type_variables, args),
              return_type: at_args(fn_type.return_type, scheme.type_variables, args),
              effect_arguments: effect_arguments,
            })
          },
          _ -> None,
        },
        None -> None,
      },
    },
    _ -> None,
  }

fn stated_call(s: InstanceFunction, args: List<Code>) -> Code =
  applied(
    unspanned_code(
      NDefinition({ full: s.full, args: s.args, effect_arguments: s.effect_arguments, labels: [] }),
      s.fn_type,
    ),
    args,
    s.return_type,
  )

pub fn instance_code(s: InstanceFunction, params: List<Type>) -> Code =
  stated_call(
    s,
    range(0, params.len()).map(|i: Int|
      slot_code(if i == 0 { b"a" } else { b"b" }, i, match params.at(i) {
        Some(t) -> t,
        None -> unknown_type,
      })),
  )

pub fn key_comparison_code(k: InstanceFunction, eq: Bool, ty: Type) -> Code = {
  let ordered = compare_call(
    stated_call(k, [slot_code(b"a", 0, ty)]),
    stated_call(k, [slot_code(b"b", 1, ty)]),
  );
  if eq { binary_of(b"eq", ordered, prelude_made(equal_constructor, [], ordering_type)) }
  else { ordered }
}

pub fn equality_code(ty: Type, cs: List<SumConstructor>) -> Code = {
  let sum = match ty { NamedType(c) -> c.name, _ -> b"" };
  let arms = cs.map(|c: SumConstructor| {
    let xs = bound_from(2, b"x", c.fields);
    let ys = bound_from(2 + xs.len(), b"y", c.fields);
    let same = zip(xs, ys).fold(None, |both: Option<Code>, p: { first: Bound, second: Bound }| {
      let eq = binary_of(b"eq", bound_read(p.first), bound_read(p.second));
      Some(match both { None -> eq, Some(b) -> binary_of(b"and", b, eq) })
    });
    let inner = match_code(
      slot_code(b"b", 1, ty),
      [
        {
          pattern: CodeConstructorPattern({
            sum: sum,
            name: c.name,
            case: c.index,
            args: ys.map(bound_pattern),
          }),
          guard: None,
          body: match same { Some(e) -> e, None -> bool_code(true) },
        },
        { pattern: CodeWildcardPattern, guard: None, body: bool_code(false) },
      ],
      bool_type,
    );
    {
      pattern: CodeConstructorPattern({
        sum: sum,
        name: c.name,
        case: c.index,
        args: xs.map(bound_pattern),
      }),
      guard: None,
      body: inner,
    }
  });
  match_code(slot_code(b"a", 0, ty), arms, bool_type)
}

pub fn compared_code(ty: Type) -> Code =
  binary_of(b"eq", slot_code(b"a", 0, ty), slot_code(b"b", 1, ty))

pub fn ordered_code(ty: Type) -> Code =
  builtin_call(b"compare", [ty], [slot_code(b"a", 0, ty), slot_code(b"b", 1, ty)], ordering_type)

type Ordered = { x: Bound, y: Bound, order: Bound }

pub fn ordering_code(ty: Type, cs: List<SumConstructor>) -> Code = {
  let sum = match ty { NamedType(c) -> c.name, _ -> b"" };
  let a = slot_code(b"a", 0, ty);
  let b = slot_code(b"b", 1, ty);
  let rank = |c: SumConstructor|
    cs.fold(0, |n: Int, d: SumConstructor| if compare(d.name, c.name) == Less { n + 1 } else { n });
  let ranked = |scrutinee: Code|
    match_code(
      scrutinee,
      cs.map(|c: SumConstructor|
        {
          pattern: CodeConstructorPattern({
            sum: sum,
            name: c.name,
            case: c.index,
            args: c.fields.map(|_: Type| CodeWildcardPattern),
          }),
          guard: None,
          body: int_code(rank(c)),
        }),
      int_type,
    );
  let equal = prelude_made(equal_constructor, [], ordering_type);
  let walked = cs.fold(
    { arms: [], slot: 4 },
    |accumulator: { arms: List<CodeArm>, slot: Int }, c: SumConstructor| {
      let xs = bound_from(accumulator.slot, b"x", c.fields);
      let ys = bound_from(accumulator.slot + xs.len(), b"y", c.fields);
      let orders = bound_from(
        accumulator.slot + 2 * xs.len(),
        b"o",
        c.fields.map(|_: Type| ordering_type),
      );
      let fields = zip(zip(xs, ys), orders).map(
        |p: { first: { first: Bound, second: Bound }, second: Bound }|
          { x: p.first.first, y: p.first.second, order: p.second },
      );
      let compared = |f: Ordered| compare_call(bound_read(f.x), bound_read(f.y));
      let lex = fields.fold_right(None, |f: Ordered, later: Option<Code>|
        Some(match later {
          None -> compared(f),
          Some(l) ->
            block_code(
              [CodeLet({ name: f.order.name, slot: f.order.slot, value: compared(f) })],
              if_code(binary_of(b"eq", bound_read(f.order), equal), l, bound_read(f.order)),
            ),
        }));
      let inner = match_code(
        b,
        [
          {
            pattern: CodeConstructorPattern({
              sum: sum,
              name: c.name,
              case: c.index,
              args: ys.map(bound_pattern),
            }),
            guard: None,
            body: match lex { Some(l) -> l, None -> equal },
          },
          { pattern: CodeWildcardPattern, guard: None, body: equal },
        ],
        ordering_type,
      );
      {
        arms: accumulator.arms.push({
          pattern: CodeConstructorPattern({
            sum: sum,
            name: c.name,
            case: c.index,
            args: xs.map(bound_pattern),
          }),
          guard: None,
          body: inner,
        }),
        slot: accumulator.slot + 3 * xs.len(),
      }
    },
  );
  let ra = slot_code(b"ra", 2, int_type);
  let rb = slot_code(b"rb", 3, int_type);
  identical_shortcut(
    block_code(
      [
        CodeLet({ name: b"ra", slot: 2, value: ranked(a) }),
        CodeLet({ name: b"rb", slot: 3, value: ranked(b) }),
      ],
      if_code(
        binary_of(b"lt", ra, rb),
        prelude_made(less_constructor, [], ordering_type),
        if_code(
          binary_of(b"gt", ra, rb),
          prelude_made(greater_constructor, [], ordering_type),
          match_code(a, walked.arms, ordering_type),
        ),
      ),
    ),
    ty,
  )
}

fn identical_shortcut(order: Code, ty: Type) -> Code =
  if_code(
    builtin_call(b"?same", [], [slot_code(b"a", 0, ty), slot_code(b"b", 1, ty)], bool_type),
    prelude_made(equal_constructor, [], ordering_type),
    order,
  )

fn little_endian_64(n: Int) -> Bytes =
  Bytes::concat_all(range(0, 8).map(|i: Int| byte_of_int(n >> 8 * i & 255)))

fn joined(parts: List<Code>) -> Code =
  builtin_call(
    b"?concat",
    [],
    [unspanned_code(CodeList({ items: parts }), list_type(bytes_type))],
    bytes_type,
  )

pub fn digest_code(
  module: Bytes,
  constructors: Constructors,
  here: List<Definition>,
  items: List<Item>,
  ty: Type,
) -> Code / {abort.raise} = {
  let a = slot_code(b"a", 0, ty);
  let counted = |tag: Int, n: Int| byte_of_int(tag).concat(little_endian_64(n));
  let blob = |tag: Int, b: Bytes| counted(tag, b.len()).concat(b);
  let part = |x: Code| builtin_call(b"?encoded", [x.ty], [x], bytes_type);
  let read = part(a);
  let fields_of = match ty {
    RecordType(fs) -> Some(fs),
    NominalType(x) -> Some(x.fields),
    _ -> None,
  };
  match fields_of {
    Some(fs) ->
      joined(
        fs.fold([bytes_code(counted(12, fs.len()))], |accumulator: List<Code>, f: Field|
          accumulator.concat([bytes_code(blob(13, f.name)), part(field_code(a, f.name, f.ty))])),
      ),
    None -> match ty {
      NamedType(c) -> match constructors.sums.get(c.name) {
        None -> read,
        Some(cs) -> match key_instance(module, here, items, ty) {
          Some(k) -> joined([bytes_code(byte_of_int(16)), part(stated_call(k, [a]))]),
          None ->
            match_code(
              a,
              cs.fold(
                { arms: [], slot: 1 },
                |accumulator: { arms: List<CodeArm>, slot: Int }, sum_constructor: SumConstructor| {
                  let xs = bound_from(
                    accumulator.slot,
                    b"x",
                    constructor_fields_at(sum_constructor, c.args),
                  );
                  let dot = range(0, sum_constructor.name.len()).fold(0 - 1, |d: Int, i: Int|
                    if sum_constructor.name.at(i) == 46 { i } else { d });
                  let simple = sum_constructor.name.slice(dot + 1, sum_constructor.name.len());
                  {
                    arms: accumulator.arms.push({
                      pattern: CodeConstructorPattern({
                        sum: c.name,
                        name: sum_constructor.name,
                        case: sum_constructor.index,
                        args: xs.map(bound_pattern),
                      }),
                      guard: None,
                      body: joined(
                        [bytes_code(blob(14, simple).concat(counted(15, xs.len())))].concat(
                          xs.map(|x: Bound| part(bound_read(x))),
                        ),
                      ),
                    }),
                    slot: accumulator.slot + xs.len(),
                  }
                },
              ).arms,
              bytes_type,
            ),
        },
      },
      _ -> read,
    },
  }
}

pub fn reflection_code(
  module: Bytes,
  constructors: Constructors,
  here: List<Definition>,
  items: List<Item>,
  shown: Bool,
  ty: Type,
) -> Code = {
  let a = slot_code(b"a", 0, ty);
  let value = value_type;
  let part = |x: Code|
    builtin_call(if shown { b"?shown" } else { b"?reflect" }, [x.ty], [x], value);
  let fields_of = match ty {
    RecordType(fs) -> Some(fs),
    NominalType(x) -> Some(x.fields),
    _ -> None,
  };
  let field = RecordType([{ name: b"name", ty: string_type }, { name: b"value", ty: value }]);
  match fields_of {
    Some(fs) ->
      value_made(constructors, b"std.value.VRecord", [
        unspanned_code(
          CodeList({
            items: fs.map(|f: Field|
              unspanned_code(
                CodeRecord({
                  fields: [
                    { name: b"name", value: string_code(f.name) },
                    { name: b"value", value: part(field_code(a, f.name, f.ty)) },
                  ],
                }),
                field,
              )),
          }),
          list_type(field),
        ),
      ]),
    None -> match ty {
      NamedType(c) -> match constructors.sums.get(c.name) {
        None -> part(a),
        Some(cs) -> {
          let stated = if !shown { None } else {
            instance_for(module, here, ty, |n: Bytes|
              items.fold(None, |accumulator: Option<Bytes>, item: Item|
                match item {
                  InstanceItem(d) -> if d.kind == ShowInstance
                      && qualify(module, d.target.name) == n { Some(d.function.name) }
                  else { accumulator },
                  _ -> accumulator,
                }))
          };
          match stated {
            Some(f) -> value_made(constructors, b"std.value.VShown", [stated_call(f, [a])]),
            None ->
              match_code(
                a,
                cs.fold(
                  { arms: [], slot: 1 },
                  |accumulator: { arms: List<CodeArm>, slot: Int }, sum_constructor: SumConstructor| {
                    let xs = bound_from(
                      accumulator.slot,
                      b"x",
                      constructor_fields_at(sum_constructor, c.args),
                    );
                    {
                      arms: accumulator.arms.push({
                        pattern: CodeConstructorPattern({
                          sum: c.name,
                          name: sum_constructor.name,
                          case: sum_constructor.index,
                          args: xs.map(bound_pattern),
                        }),
                        guard: None,
                        body: value_made(constructors, b"std.value.VCtor", [
                          string_code(sum_constructor.name),
                          unspanned_code(
                            CodeList({ items: xs.map(|x: Bound| part(bound_read(x))) }),
                            list_type(value),
                          ),
                        ]),
                      }),
                      slot: accumulator.slot + xs.len(),
                    }
                  },
                ).arms,
                value,
              ),
          }
        },
      },
      _ -> part(a),
    },
  }
}

pub fn release_resource_code(
  module: Bytes,
  constructors: Constructors,
  here: List<Definition>,
  key: RootKey,
  ty: Type,
) -> GeneratedRoot / {abort.raise} = {
  let a = slot_code(b"a", 0, ty);
  let fields_of = match ty {
    RecordType(fs) -> Some(fs),
    NominalType(x) -> Some(x.fields),
    _ -> None,
  };
  let body = match fields_of {
    Some(fs) ->
      {
        code: sequence(
          fs.filter(|f: Field| contains_resource(constructors, f.ty)).map(|f: Field|
            let_go(field_code(a, f.name, f.ty))),
        ),
        here: [],
      },
    None -> match ty {
      NamedType(c) -> match constructors.released.get(c.name) {
        Some(by) -> {
          let local = name_in_module(module, by);
          match instance_for(module, here, ty, |n: Bytes|
              if n == c.name { Some(local) } else { None }) {
            Some(f) -> { code: stated_call(f, [a]), here: [] },
            None -> { code: unit_code, here: [] },
          }
        },
        None -> if c.name == list_name {
          let items = keys::generated_key(ContainerWalk(b"let_go_items"), ty, module);
          {
            code: call_of(module, items, [a, int_code(0)], unit_type),
            here: [
              definition_of(
                module,
                items,
                [ty, int_type],
                unit_type,
                release_effects(constructors, ty),
              ),
            ],
          }
        } else {
          match constructors.sums.get(c.name) {
            None -> { code: unit_code, here: [] },
            Some(cs) ->
              {
                code: match_code(
                  a,
                  cs.fold(
                    { arms: [], slot: 1 },
                    |accumulator: { arms: List<CodeArm>, slot: Int }, sum_constructor: SumConstructor| {
                      let xs = bound_from(
                        accumulator.slot,
                        b"x",
                        constructor_fields_at(sum_constructor, c.args),
                      );
                      let resource_payloads = xs.filter(|x: Bound|
                        contains_resource(constructors, x.ty));
                      {
                        arms: accumulator.arms.push({
                          pattern: CodeConstructorPattern({
                            sum: c.name,
                            name: sum_constructor.name,
                            case: sum_constructor.index,
                            args: xs.map(|x: Bound|
                              if contains_resource(constructors, x.ty) { bound_pattern(x) }
                              else { CodeWildcardPattern }),
                          }),
                          guard: None,
                          body: sequence(resource_payloads.map(|x: Bound| let_go(bound_read(x)))),
                        }),
                        slot: accumulator.slot + xs.len(),
                      }
                    },
                  ).arms,
                  unit_type,
                ),
                here: [],
              },
          }
        },
      },
      _ -> { code: unit_code, here: [] },
    },
  };
  generated_root(module, key, [ty], unit_type, body, release_effects(constructors, ty))
}

pub fn release_items_code(
  module: Bytes,
  constructors: Constructors,
  key: RootKey,
  ty: Type,
) -> GeneratedRoot / {abort.raise} = {
  let item = match ty {
    NamedType(c) -> match c.args.at(0) { Some(t) -> t, None -> unknown_type },
    _ -> unknown_type,
  };
  let a = slot_code(b"a", 0, ty);
  let i = slot_code(b"i", 1, int_type);
  let next = call_of(module, key, [a, binary_of(b"add", i, int_code(1))], unit_type);
  let got = prelude_call(
    b"List::at",
    [without_marks(item)],
    [a, i],
    option_type(without_marks(item)),
  );
  generated_root(
    module,
    key,
    [ty, int_type],
    unit_type,
    {
      code: some_or(
        got,
        b"x",
        2,
        without_marks(item),
        sequence([let_go(slot_code(b"x", 2, without_marks(item))), next]),
        unit_code,
      ),
      here: [],
    },
    release_effects(constructors, ty),
  )
}

fn let_go(x: Code) -> Code = builtin_call(b"?let_go", [], [x], unit_type)

pub fn is_marshal_operation(operation: TypeOperation) -> Bool =
  match operation {
    Lower -> true,
    Lift -> true,
    Wrapping -> true,
    Opening -> true,
    ContainerWalk(c) -> marshal_loops.contains(c) || dynamic_loops.contains(c),
    _ -> false,
  }

pub fn marshal_root(
  module: Bytes,
  constructors: Constructors,
  key: RootKey,
) -> GeneratedRoot / {abort.raise} =
  match key {
    Generated(w, _) -> {
      let marked = marked_type(w.ty, w.marks);
      match w.operation {
        Lower ->
          generated_root(
            module,
            key,
            [w.ty],
            unit_type,
            lowering_code(module, constructors, marked),
          ),
        Lift -> generated_root(module, key, [], w.ty, lifting_code(module, constructors, marked)),
        Wrapping ->
          generated_root(
            module,
            key,
            [w.ty],
            dynamic_form(marked),
            dynamic_code(module, constructors, marked, true),
          ),
        Opening ->
          generated_root(
            module,
            key,
            [dynamic_form(marked)],
            w.ty,
            dynamic_code(module, constructors, marked, false),
          ),
        ContainerWalk(c) -> match if dynamic_loops.contains(c) { dynamic_loop(module, c, marked) }
          else { marshal_loop(module, c, w.ty, marked) } {
          Some(r) -> r,
          None ->
            internal_error(
              b"no code to convert values between the program and the runtime can be generated for this root type",
            ),
        },
        _ ->
          internal_error(
            b"no code to convert values between the program and the runtime can be generated for this root type",
          ),
      }
    },
    _ ->
      internal_error(
        b"no code to convert values between the program and the runtime can be generated for this root type",
      ),
  }

const dynamic_loops: List<Bytes> =
  [b"keeping_items", b"opening_items", b"keeping_entries", b"opening_entries"]

fn dynamic_side(ty: Type, retained: Bool) -> Type / {abort.raise} =
  if retained { dynamic_form(ty) } else { without_marks(ty) }

fn wrap_handles(x: Code, ty: Type, keeping: Bool) -> Code / {abort.raise} =
  if !has_marks(ty) { x } else {
    builtin_call(
      if keeping { b"?keeping" } else { b"?opening" },
      [ty],
      [x],
      dynamic_side(ty, keeping),
    )
  }

fn dynamic_code(
  module: Bytes,
  constructors: Constructors,
  ty: Type,
  keeping: Bool,
) -> { code: Code, here: List<Definition> } / {abort.raise} = {
  let from = dynamic_side(ty, !keeping);
  let a = slot_code(b"a", 0, from);
  let into = dynamic_side(ty, keeping);
  let items_op = if keeping { b"keeping_items" } else { b"opening_items" };
  let looped = |over: Type, listed: Type| {
    let loop = marked_key(ContainerWalk(items_op), over, module);
    let out = dynamic_side(listed, keeping);
    {
      code: call_of(
        module,
        loop,
        [a, unspanned_code(CodeList({ items: [] }), out), int_code(0)],
        out,
      ),
      here: [definition_of(module, loop, [dynamic_side(over, !keeping), out, int_type], out)],
    }
  };
  match ty {
    NamedType(c) -> if c.name == b"^" && c.args.len() == 1 {
      {
        code: builtin_call(if keeping { b"?keep" } else { b"?open" }, [c.args.get(0)], [a], into),
        here: [],
      }
    } else if !has_marks(ty) { { code: a, here: [] } }
    else if c.name == list_name && c.args.len() == 1 { looped(ty, ty) }
    else if c.name == array_name && c.args.len() == 1 {
      let items = looped(ty, list_type(c.args.get(0)));
      {
        code: builtin_call(
          b"Array::of_list",
          [dynamic_side(c.args.get(0), keeping)],
          [items.code],
          into,
        ),
        here: items.here,
      }
    } else if c.name == map_name && c.args.len() == 2 {
      let entries = list_type(
        RecordType([{ name: b"key", ty: c.args.get(0) }, { name: b"value", ty: c.args.get(1) }]),
      );
      let from_args = match from { NamedType(f) -> f.args, _ -> [] };
      let into_args = match into { NamedType(i) -> i.args, _ -> [] };
      let listed = prelude_call(b"Map::entries", from_args, [a], dynamic_side(entries, !keeping));
      let fresh = builtin_call(b"Map::new", into_args, [], into);
      let loop = marked_key(
        ContainerWalk(if keeping { b"keeping_entries" } else { b"opening_entries" }),
        entries,
        module,
      );
      {
        code: call_of(module, loop, [listed, fresh, int_code(0)], into),
        here: [
          definition_of(module, loop, [dynamic_side(entries, !keeping), into, int_type], into),
        ],
      }
    } else if runtime_object(c.name) {
      internal_error(
        b"cannot convert a value of a runtime-managed type, even when that type is only an operation's type argument",
      )
    } else {
      match constructors.sums.get(c.name) {
        None ->
          internal_error(
            b"no constructors are known for the type being converted: ".concat(c.name),
          ),
        Some(cs) -> {
          let arms = cs.fold(
            { arms: [], slot: 1 },
            |accumulator: { arms: List<CodeArm>, slot: Int }, sum_constructor: SumConstructor| {
              let args = constructor_fields_at(sum_constructor, c.args);
              let xs = bound_from(
                accumulator.slot,
                b"x",
                args.map(|t: Type| dynamic_side(t, !keeping)),
              );
              {
                arms: accumulator.arms.push({
                  pattern: CodeConstructorPattern({
                    sum: c.name,
                    name: sum_constructor.name,
                    case: sum_constructor.index,
                    args: xs.map(bound_pattern),
                  }),
                  guard: None,
                  body: constructor_made(
                    c.name,
                    sum_constructor.name,
                    sum_constructor.index,
                    zip(xs, args).map(|p: { first: Bound, second: Type }|
                      wrap_handles(bound_read(p.first), p.second, keeping)),
                    into,
                  ),
                }),
                slot: accumulator.slot + xs.len(),
              }
            },
          );
          { code: match_code(a, arms.arms, into), here: [] }
        },
      }
    },
    RecordType(fs) -> dynamic_record(a, fs, into, keeping),
    NominalType(x) -> dynamic_record(a, x.fields, into, keeping),
    FunctionType(f) -> dynamic_function(f.params, f.return_type, from, into, keeping),
    VariableType(_) -> internal_error(b"cannot convert a value whose type is a type variable"),
  }
}

fn dynamic_record(
  a: Code,
  fields: List<Field>,
  into: Type,
  keeping: Bool,
) -> { code: Code, here: List<Definition> } / {abort.raise} =
  {
    code: unspanned_code(
      CodeRecord({
        fields: fields.map(|f: Field|
          {
            name: f.name,
            value: wrap_handles(field_code(a, f.name, dynamic_side(f.ty, !keeping)), f.ty, keeping),
          }),
      }),
      into,
    ),
    here: [],
  }

fn dynamic_function(
  params: List<Type>,
  return_type: Type,
  from: Type,
  into: Type,
  keeping: Bool,
) -> { code: Code, here: List<Definition> } / {abort.raise} = {
  let n = params.len();
  let args = range(0, n).map(|j: Int|
    wrap_handles(
      slot_code(b"p".concat(ascii_of_int(j)), j, dynamic_side(params.get(j), keeping)),
      params.get(j),
      !keeping,
    ));
  let called = applied(slot_code(b"f", n, from), args, dynamic_side(return_type, !keeping));
  let ty = match into {
    FunctionType(g) -> g,
    _ ->
      {
        params: params,
        keep_parameters: [],
        once: false,
        return_type: return_type,
        effects: no_effects,
      },
  };
  {
    code: unspanned_code(
      CodeLambda({
        params: n,
        size: n + 1,
        captures: [{ source: 0, destination: n }],
        body: wrap_handles(called, return_type, keeping),
        at: placed(0),
        ty: ty,
        effects: no_effects,
      }),
      FunctionType(ty),
    ),
    here: [],
  }
}

fn dynamic_loop(
  module: Bytes,
  operation: Bytes,
  over: Type,
) -> Option<GeneratedRoot> / {abort.raise} = {
  let wrapping = operation.starts_with(b"keeping");
  let key = marked_key(ContainerWalk(operation), over, module);
  let from = dynamic_side(over, !wrapping);
  let a = slot_code(b"a", 0, from);
  let i = slot_code(b"i", 2, int_type);
  match item_of(over) {
    None -> None,
    Some(item) -> {
      let container = match over { NamedType(c) -> c.name, _ -> list_name };
      let item_side = dynamic_side(item, !wrapping);
      let got = if container == list_name {
        prelude_call(b"List::at", [item_side], [a, i], option_type(item_side))
      } else {
        builtin_call(container.concat(b"::at"), [item_side], [a, i], option_type(item_side))
      };
      let x = slot_code(b"x", 3, item_side);
      let body = if operation.ends_with(b"entries") {
        let key_type = field_of(item, b"key");
        let value_type = field_of(item, b"value");
        let k = wrap_handles(
          field_code(x, b"key", dynamic_side(key_type, !wrapping)),
          key_type,
          wrapping,
        );
        let v = wrap_handles(
          field_code(x, b"value", dynamic_side(value_type, !wrapping)),
          value_type,
          wrapping,
        );
        let both = [dynamic_side(key_type, wrapping), dynamic_side(value_type, wrapping)];
        let into = NamedType({ name: map_name, args: both });
        {
          code: prelude_call(b"Map::insert", both, [slot_code(b"out", 1, into), k, v], into),
          into: into,
        }
      } else {
        let into = dynamic_side(list_type(item), wrapping);
        {
          code: prelude_call(
            b"List::push",
            [dynamic_side(item, wrapping)],
            [slot_code(b"out", 1, into), wrap_handles(x, item, wrapping)],
            into,
          ),
          into: into,
        }
      };
      let out = slot_code(b"out", 1, body.into);
      Some(
        generated_root(module, key, [from, body.into, int_type], body.into, {
          code: some_or(
            got,
            b"x",
            3,
            item_side,
            call_of(module, key, [a, body.code, binary_of(b"add", i, int_code(1))], body.into),
            out,
          ),
          here: [],
        }),
      )
    },
  }
}

fn internal_error<a>(reason: Bytes) -> a / {abort.raise} = panic(String::of_bytes_lossy(reason))

fn marshal_loop(
  module: Bytes,
  operation: Bytes,
  t: Type,
  marked: Type,
) -> Option<GeneratedRoot> / {abort.raise} = {
  let key = marked_key(ContainerWalk(operation), marked, module);
  match item_of(marked) {
    None -> None,
    Some(item) -> if operation == b"lower_items" {
      Some(
        generated_root(
          module,
          key,
          [t, int_type],
          unit_type,
          items_lowered(module, key, t, marked, item),
        ),
      )
    } else if operation == b"lower_entries" {
      Some(
        generated_root(
          module,
          key,
          [t, int_type],
          unit_type,
          entries_lowered(module, key, t, item),
        ),
      )
    } else if operation == b"lift_items" {
      Some(generated_root(module, key, [t, int_type], t, items_lifted(module, key, t, item)))
    } else if operation == b"lift_entries" {
      Some(generated_root(module, key, [t, int_type], t, entries_lifted(module, key, t, marked)))
    } else { None },
  }
}

pub fn runtime_entry_code(
  module: Bytes,
  root: RootKey,
  callee: RootKey,
  at: List<Type>,
  rows: List<Effects>,
  params: List<Type>,
  result: Type,
  effects: Effects,
  hosts: List<{ call: Bytes, effect: Bytes, adds: List<Effect> }>,
  pure: Bool = false,
) -> GeneratedRoot / {abort.raise} = {
  let key = keys::EntryPoint(root);
  let read = range(0, params.len()).fold(
    [CodeDo({ code: native_call(b"?in_count", [int_code(tag_list)], int_type) })],
    |accumulator: List<CodeStatement>, i: Int|
      accumulator.push(
        CodeLet({
          name: b"p".concat(ascii_of_int(i)),
          slot: i,
          value: builtin_call(b"?lift", [params.get(i)], [], params.get(i)),
        }),
      ),
  );
  let reads = range(0, params.len()).map(|i: Int|
    slot_code(b"p".concat(ascii_of_int(i)), i, params.get(i)));
  let direct = applied(
    unspanned_code(
      NDefinition({
        full: qualified_root(module, callee),
        args: at,
        effect_arguments: rows,
        labels: [],
      }),
      function_type(params, result, { listed: effects.listed, variable: None }),
    ),
    reads,
    result,
  );
  let generic = at.len() > 0 || rows.len() > 0;
  let called = hosts.reverse().fold(
    { code: direct, listed: effects.listed, n: 0 },
    |inner: { code: Code, listed: List<Effect>, n: Int }, host: { call: Bytes, effect: Bytes, adds: List<Effect> }| {
      let performs = { listed: inner.listed, variable: None };
      let lambda_type = {
        params: [],
        keep_parameters: [],
        once: false,
        return_type: result,
        effects: no_effects,
      };
      let left = inner.listed.filter(|a: Effect| a.effect != host.effect);
      let leaves = { listed: left, variable: None };
      {
        code: applied(
          unspanned_code(
            NDefinition({
              full: host.call,
              args: [result],
              effect_arguments: [leaves],
              labels: [],
            }),
            function_type([FunctionType({ ..lambda_type, effects: performs })], result, leaves),
          ),
          [
            unspanned_code(
              CodeLambda({
                params: 0,
                size: params.len(),
                captures: range(0, params.len()).map(|i: Int| { source: i, destination: i }),
                body: inner.code,
                at: placed(inner.n),
                ty: lambda_type,
                effects: performs,
              }),
              FunctionType(lambda_type),
            ),
          ],
          result,
        ),
        listed: host.adds.fold(left, |accumulator: List<Effect>, a: Effect|
          if accumulator.contains(a) { accumulator } else { accumulator.push(a) }),
        n: inner.n + 1,
      }
    },
  );
  {
    ..generated_root(module, key, [], unit_type, { code: block_code(read.push(CodeDo({ code: native_call(b"?lift_close", [], unit_type) })), builtin_call(b"?lower", [result], [called.code], unit_type)), here: if generic { [] } else { [called_definition(module, callee, params, result, { listed: effects.listed, variable: None }, pure)] } }),
    performs: { listed: called.listed, variable: None },
  }
}

pub fn called_definition(
  module: Bytes,
  root: RootKey,
  params: List<Type>,
  result: Type,
  effects: Effects,
  pure: Bool,
) -> Definition / {abort.raise} =
  {
    name: name_in_module(module, root_text(root_name(root))),
    return_kind: Some(kind_of(result).kind),
    return_type: OpenShape([]),
    pure: pure,
    constant: false,
    value: None,
    arity: params.len(),
    scheme: Some(monomorphic(function_type(params, result, effects))),
    witnesses: 0,
    borrowed: [],
    root: root,
  }

fn lowering_code(
  module: Bytes,
  constructors: Constructors,
  ty: Type,
) -> { code: Code, here: List<Definition> } / {abort.raise} = {
  let unmarked = without_marks(ty);
  let a = slot_code(b"a", 0, unmarked);
  let out = |name: Bytes, args: List<Code>| native_call(name, args, unit_type);
  let alone = |c: Code| { code: c, here: [] };
  let shared = |parts: List<Code>|
    if_code(
      binary_of(b"eq", native_call(b"?out_again", [a], int_type), int_code(0)),
      sequence(parts),
      unit_code,
    );
  let args_at = match unmarked { NamedType(c) -> c.args, _ -> [] };
  match ty {
    NamedType(c) -> if c.name == b"^" && c.args.len() == 1 {
      alone(builtin_call(b"?out_carried", [unmarked], [a], unit_type))
    } else if c.args.len() == 0 && c.name == unit_name {
      alone(out(b"?out_tag", [int_code(tag_unit)]))
    } else if c.args.len() == 0 && c.name == bool_name {
      alone(out(b"?out_tag", [if_code(a, int_code(tag_true), int_code(tag_false))]))
    } else if c.args.len() == 0 && c.name == int_name { alone(out(b"?out_int", [a])) }
    else if c.args.len() == 0 && c.name == float_name { alone(out(b"?out_float", [a])) }
    else if c.args.len() == 0 && c.name == decimal_name { alone(out(b"?out_decimal", [a])) }
    else if c.args.len() == 0 && width_named(c.name) != None { alone(out(b"?out_fixed", [a])) }
    else if c.args.len() == 0 && c.name == char_name {
      alone(out(b"?out_char", [builtin_call(b"Int::of_char", [], [a], int_type)]))
    } else if c.args.len() == 0 && c.name == string_name { alone(shared([out(b"?out_str", [a])])) }
    else if c.args.len() == 0 && c.name == bytes_name { alone(shared([out(b"?out_bytes", [a])])) }
    else if runtime_object(c.name) { alone(out(b"?out_handle", [a])) }
    else if c.name == list_name && c.args.len() == 1 {
      let items = marked_key(ContainerWalk(b"lower_items"), ty, module);
      {
        code: shared([
          out(b"?out_count", [
            int_code(tag_list),
            builtin_call(b"List::len", args_at, [a], int_type),
          ]),
          call_of(module, items, [a, int_code(0)], unit_type),
        ]),
        here: [definition_of(module, items, [unmarked, int_type], unit_type)],
      }
    } else if (c.name == array_name || c.name == columns_name) && c.args.len() == 1 {
      let items = marked_key(ContainerWalk(b"lower_items"), ty, module);
      {
        code: shared([
          out(b"?out_count", [
            int_code(tag_array),
            builtin_call(c.name.concat(b"::len"), args_at, [a], int_type),
          ]),
          call_of(module, items, [a, int_code(0)], unit_type),
        ]),
        here: [definition_of(module, items, [unmarked, int_type], unit_type)],
      }
    } else if c.name == map_name && c.args.len() == 2 {
      let entries = list_type(
        RecordType([{ name: b"key", ty: c.args.get(0) }, { name: b"value", ty: c.args.get(1) }]),
      );
      let each = marked_key(ContainerWalk(b"lower_entries"), entries, module);
      {
        code: shared([
          out(b"?out_count", [
            int_code(tag_map),
            builtin_call(b"Map::len", args_at, [a], int_type),
          ]),
          call_of(
            module,
            each,
            [prelude_call(b"Map::entries", args_at, [a], without_marks(entries)), int_code(0)],
            unit_type,
          ),
        ]),
        here: [definition_of(module, each, [without_marks(entries), int_type], unit_type)],
      }
    } else {
      match constructors.sums.get(c.name) {
        None ->
          internal_error(
            b"no constructors are known for the type being converted: ".concat(c.name),
          ),
        Some(cs) -> {
          let arms = cs.fold(
            { arms: [], slot: 1 },
            |accumulator: { arms: List<CodeArm>, slot: Int }, constructor: SumConstructor| {
              let args = constructor_fields_at(constructor, c.args);
              let xs = bound_from(accumulator.slot, b"x", args.map(without_marks));
              {
                arms: accumulator.arms.push({
                  pattern: CodeConstructorPattern({
                    sum: c.name,
                    name: constructor.name,
                    case: constructor.index,
                    args: xs.map(bound_pattern),
                  }),
                  guard: None,
                  body: sequence(
                    [
                      out(b"?out_ctor", [bytes_code(constructor.name), int_code(args.len())]),
                    ].concat(
                      zip(xs, args).map(|p: { first: Bound, second: Type }|
                        builtin_call(b"?lower", [p.second], [bound_read(p.first)], unit_type)),
                    ),
                  ),
                }),
                slot: accumulator.slot + xs.len(),
              }
            },
          );
          { code: match_code(a, arms.arms, unit_type), here: [] }
        },
      }
    },
    RecordType(fs) -> record_lowered(a, fs),
    NominalType(x) -> record_lowered(a, x.fields),
    FunctionType(_) -> alone(out(b"?out_fun", [a, bytes_code(b"")])),
    VariableType(_) -> internal_error(b"marshalling at a type variable"),
  }
}

fn record_lowered(
  a: Code,
  fields: List<Field>,
) -> { code: Code, here: List<Definition> } / {abort.raise} = {
  let fs = fields_sorted(fields);
  {
    code: sequence(
      fs.fold(
        [native_call(b"?out_count", [int_code(tag_record), int_code(fs.len())], unit_type)],
        |accumulator: List<Code>, f: Field|
          accumulator.push(native_call(b"?out_name", [bytes_code(f.name)], unit_type)).push(
            builtin_call(
              b"?lower",
              [f.ty],
              [field_code(a, f.name, without_marks(f.ty))],
              unit_type,
            ),
          ),
      ),
    ),
    here: [],
  }
}

fn lifting_code(
  module: Bytes,
  constructors: Constructors,
  ty: Type,
) -> { code: Code, here: List<Definition> } / {abort.raise} = {
  let unmarked = without_marks(ty);
  let args_at = match unmarked { NamedType(c) -> c.args, _ -> [] };
  let alone = |c: Code| { code: c, here: [] };
  let read_as = |name: Bytes| alone(builtin_call(name, [unmarked], [], unmarked));
  let tag = native_call(b"?in_tag", [], int_type);
  let counted = |t: Int| native_call(b"?in_count", [int_code(t)], int_type);
  match ty {
    NamedType(c) -> if (c.name == b"^" && c.args.len() == 1) || runtime_object(c.name) {
      internal_error(
        b"cannot read a value of a runtime-managed type into the program; the `crosses` check should have rejected this type",
      )
    } else if c.args.len() == 0 && c.name == unit_name { alone(sequence([tag, unit_code])) }
    else if c.args.len() == 0 && c.name == bool_name {
      alone(binary_of(b"eq", tag, int_code(tag_true)))
    } else if c.args.len() == 0 && c.name == int_name {
      alone(native_call(b"?in_int", [], int_type))
    } else if c.args.len() == 0 && c.name == float_name {
      alone(native_call(b"?in_float", [], float_type))
    } else if c.args.len() == 0 && c.name == decimal_name { read_as(b"?in_decimal") }
    else if c.args.len() == 0 && width_named(c.name) != None { read_as(b"?in_fixed") }
    else if c.args.len() == 0 && c.name == char_name {
      alone(
        some_or(
          builtin_call(
            b"Char::of_int",
            [],
            [native_call(b"?in_char", [], int_type)],
            option_type(ty),
          ),
          b"ch",
          0,
          ty,
          slot_code(b"ch", 0, ty),
          unspanned_code(CodeLiteral(LiteralChar(0)), ty),
        ),
      )
    } else if c.args.len() == 0 && c.name == string_name { read_as(b"?in_str") }
    else if c.args.len() == 0 && c.name == bytes_name { read_as(b"?in_bytes") }
    else if c.name == list_name && c.args.len() == 1 {
      let items = marked_key(ContainerWalk(b"lift_items"), ty, module);
      {
        code: call_of(
          module,
          items,
          [unspanned_code(CodeList({ items: [] }), unmarked), counted(tag_list)],
          unmarked,
        ),
        here: [definition_of(module, items, [unmarked, int_type], unmarked)],
      }
    } else if (c.name == array_name || c.name == columns_name) && c.args.len() == 1 {
      let listed = list_type(c.args.get(0));
      let items = marked_key(ContainerWalk(b"lift_items"), listed, module);
      {
        code: builtin_call(
          c.name.concat(b"::of_list"),
          args_at,
          [
            call_of(
              module,
              items,
              [unspanned_code(CodeList({ items: [] }), without_marks(listed)), counted(tag_array)],
              without_marks(listed),
            ),
          ],
          unmarked,
        ),
        here: [
          definition_of(module, items, [without_marks(listed), int_type], without_marks(listed)),
        ],
      }
    } else if c.name == map_name && c.args.len() == 2 {
      let each = marked_key(ContainerWalk(b"lift_entries"), ty, module);
      {
        code: call_of(
          module,
          each,
          [builtin_call(b"Map::new", args_at, [], unmarked), counted(tag_map)],
          unmarked,
        ),
        here: [definition_of(module, each, [unmarked, int_type], unmarked)],
      }
    } else {
      match constructors.sums.get(c.name) {
        None ->
          internal_error(
            b"no constructors are known for the type being read into the program: ".concat(c.name),
          ),
        Some(cs) -> {
          let made = cs.map(|constructor: SumConstructor| {
            let args = constructor.fields.map(|f: Type| at_args(f, constructor.params, c.args));
            {
              name: constructor.name,
              code: constructor_made(
                c.name,
                constructor.name,
                constructor.index,
                args.map(|t: Type| builtin_call(b"?lift", [t], [], without_marks(t))),
                unmarked,
              ),
            }
          });
          let chosen = range(0, made.len()).fold(unit_code, |later: Code, n: Int| {
            let k = made.len() - 1 - n;
            let m = made.get(k);
            if k == made.len() - 1 { m.code } else {
              if_code(
                binary_of(
                  b"eq",
                  native_call(b"?in_name_is", [bytes_code(m.name)], int_type),
                  int_code(1),
                ),
                m.code,
                later,
              )
            }
          });
          alone(sequence([counted(tag_constructor), chosen]))
        },
      }
    },
    RecordType(fs) -> record_lifted(unmarked, fs),
    NominalType(x) -> record_lifted(unmarked, x.fields),
    FunctionType(_) -> internal_error(b"a function marshalled back from the runtime"),
    VariableType(_) -> internal_error(b"marshalling at a type variable"),
  }
}

fn record_lifted(
  ty: Type,
  fields: List<Field>,
) -> { code: Code, here: List<Definition> } / {abort.raise} =
  {
    code: sequence([
      native_call(b"?in_count", [int_code(tag_record)], int_type),
      unspanned_code(
        CodeRecord({
          fields: fields_sorted(fields).map(|f: Field|
            {
              name: f.name,
              value: sequence([
                native_call(b"?in_field", [bytes_code(f.name)], unit_type),
                builtin_call(b"?lift", [f.ty], [], without_marks(f.ty)),
              ]),
            }),
        }),
        ty,
      ),
    ]),
    here: [],
  }

fn items_lowered(
  module: Bytes,
  key: RootKey,
  t: Type,
  container: Type,
  item: Type,
) -> { code: Code, here: List<Definition> } / {abort.raise} = {
  let a = slot_code(b"a", 0, t);
  let i = slot_code(b"i", 1, int_type);
  let next = call_of(module, key, [a, binary_of(b"add", i, int_code(1))], unit_type);
  let lowered = builtin_call(
    b"?lower",
    [item],
    [slot_code(b"x", 2, without_marks(item))],
    unit_type,
  );
  match container {
    NamedType(c) -> if c.name == array_name || c.name == columns_name {
      {
        code: if_code(
          binary_of(
            b"lt",
            i,
            builtin_call(c.name.concat(b"::len"), [without_marks(item)], [a], int_type),
          ),
          block_code(
            [
              CodeLet({
                name: b"x",
                slot: 2,
                value: builtin_call(
                  c.name.concat(b"::get"),
                  [without_marks(item)],
                  [a, i],
                  without_marks(item),
                ),
              }),
            ],
            sequence([lowered, next]),
          ),
          unit_code,
        ),
        here: [],
      }
    } else {
      {
        code: some_or(
          prelude_call(
            b"List::at",
            [without_marks(item)],
            [a, i],
            option_type(without_marks(item)),
          ),
          b"x",
          2,
          without_marks(item),
          sequence([lowered, next]),
          unit_code,
        ),
        here: [],
      }
    },
    _ -> internal_error(b"a loop over items was requested for a type that is not a container"),
  }
}

fn entries_lowered(
  module: Bytes,
  key: RootKey,
  t: Type,
  entry: Type,
) -> { code: Code, here: List<Definition> } / {abort.raise} = {
  let es = slot_code(b"es", 0, t);
  let i = slot_code(b"i", 1, int_type);
  let e = slot_code(b"e", 2, without_marks(entry));
  let part = |name: Bytes|
    builtin_call(
      b"?lower",
      [field_of(entry, name)],
      [field_code(e, name, without_marks(field_of(entry, name)))],
      unit_type,
    );
  {
    code: some_or(
      prelude_call(b"List::at", [without_marks(entry)], [es, i], option_type(without_marks(entry))),
      b"e",
      2,
      without_marks(entry),
      sequence([
        part(b"key"),
        part(b"value"),
        call_of(module, key, [es, binary_of(b"add", i, int_code(1))], unit_type),
      ]),
      unit_code,
    ),
    here: [],
  }
}

fn items_lifted(
  module: Bytes,
  key: RootKey,
  t: Type,
  item: Type,
) -> { code: Code, here: List<Definition> } / {abort.raise} = {
  let accumulator = slot_code(b"acc", 0, t);
  let n = slot_code(b"n", 1, int_type);
  let pushed = prelude_call(
    b"List::push",
    [without_marks(item)],
    [accumulator, builtin_call(b"?lift", [item], [], without_marks(item))],
    t,
  );
  {
    code: if_code(
      binary_of(b"eq", n, int_code(0)),
      accumulator,
      call_of(module, key, [pushed, binary_of(b"sub", n, int_code(1))], t),
    ),
    here: [],
  }
}

fn entries_lifted(
  module: Bytes,
  key: RootKey,
  t: Type,
  ty: Type,
) -> { code: Code, here: List<Definition> } / {abort.raise} = {
  let args = match ty { NamedType(c) -> c.args, _ -> [] };
  let m = slot_code(b"m", 0, t);
  let n = slot_code(b"n", 1, int_type);
  let lifted = |k: Int| builtin_call(b"?lift", [args.get(k)], [], without_marks(args.get(k)));
  let inserted = prelude_call(
    b"Map::insert",
    args.map(without_marks),
    [m, lifted(0), lifted(1)],
    t,
  );
  {
    code: if_code(
      binary_of(b"eq", n, int_code(0)),
      m,
      call_of(module, key, [inserted, binary_of(b"sub", n, int_code(1))], t),
    ),
    here: [],
  }
}

fn item_of(ty: Type) -> Option<Type> =
  match ty {
    NamedType(c) -> if (c.name == list_name || c.name == array_name || c.name == columns_name)
        && c.args.len() == 1 { c.args.at(0) }
    else if c.name == map_name && c.args.len() == 2 { Some(ty) }
    else { None },
    _ -> None,
  }

fn field_of(ty: Type, name: Bytes) -> Type =
  match ty {
    RecordType(fs) ->
      fs.fold(unknown_type, |accumulator: Type, f: Field|
        if f.name == name { f.ty } else { accumulator }),
    _ -> unknown_type,
  }

pub type MarshalledSums = {
  sums: Map<Bytes, List<SumConstructor>>,
  unwritten: List<Bytes>,
  unread: List<Bytes>,
  marshals_containers: Bool,
  lifts: Bool,
}

pub fn marshalled_sums(
  sums: Map<Bytes, List<SumConstructor>>,
  is_defined: (Bytes) -> Bool,
) -> MarshalledSums = {
  let c = {
    sums: sums,
    unwritten: [],
    unread: [],
    marshals_containers: emitted_code.calls.all(is_defined),
    lifts: emitted_code.insert_calls.all(is_defined),
  };
  { ..c, unwritten: unmarshallable_sums(c, false), unread: unmarshallable_sums(c, true) }
}

pub fn is_marshallable(c: MarshalledSums, t: Type, back: Bool) -> Bool =
  is_marshallable_part(c, if back { c.unread } else { c.unwritten }, t, false, back)

fn unmarshallable_sums(c: MarshalledSums, back: Bool) -> List<Bytes> =
  range(0, c.sums.len() + 1).fold(
    { bad: [], done: false },
    |st: { bad: List<Bytes>, done: Bool }, _: Int|
      if st.done { st } else {
        let more = c.sums.fold(
          st.bad,
          |accumulator: List<Bytes>, name: Bytes, cs: List<SumConstructor>|
            if accumulator.contains(name)
                || cs.all(|constructor: SumConstructor|
                  constructor.fields.all(|f: Type|
                    is_marshallable_part(c, st.bad, f, true, back))) { accumulator }
            else { accumulator.push(name) },
        );
        { bad: more, done: more.len() == st.bad.len() }
      },
  ).bad

fn is_marshallable_part(
  c: MarshalledSums,
  bad: List<Bytes>,
  t: Type,
  open: Bool,
  back: Bool,
) -> Bool =
  match t {
    VariableType(_) -> open,
    FunctionType(_) -> !back,
    RecordType(fs) -> fs.all(|f: Field| is_marshallable_part(c, bad, f.ty, open, back)),
    NominalType(x) -> x.fields.all(|f: Field| is_marshallable_part(c, bad, f.ty, open, back)),
    NamedType(k) -> {
      let parts = k.args.all(|a: Type| is_marshallable_part(c, bad, a, open, back));
      if k.args.len() == 0
          && ([
            unit_name,
            bool_name,
            int_name,
            float_name,
            decimal_name,
            char_name,
            string_name,
            bytes_name,
          ].contains(
            k.name,
          )
          || width_named(k.name) != None) { true }
      else if runtime_object(k.name) { !back }
      else if (k.name == list_name || k.name == array_name) && k.args.len() == 1 {
        c.marshals_containers && parts
      } else if k.name == columns_name && k.args.len() == 1 {
        c.marshals_containers && parts && k.args.all(|a: Type| has_record_fields(a, open))
      } else if k.name == map_name && k.args.len() == 2 {
        c.marshals_containers && (!back || c.lifts) && parts
      } else { c.sums.contains(k.name) && !bad.contains(k.name) && parts }
    },
  }

fn has_record_fields(t: Type, open: Bool) -> Bool =
  match t {
    RecordType(fs) -> fs.len() > 0,
    NominalType(x) -> x.fields.len() > 0,
    VariableType(_) -> open,
    _ -> false,
  }

fn generated_root(
  module: Bytes,
  key: RootKey,
  params: List<Type>,
  result: Type,
  body: { code: Code, here: List<Definition> },
  effects: Effects = { listed: [], variable: None },
) -> GeneratedRoot / {abort.raise} =
  {
    params: range(0, params.len()).map(|i: Int| {
      let t = params.get(i);
      let k = kind_of(t);
      { name: param_name(key, i), kind: k.kind, ty: k.ty, of: Some(t), lambda: None }
    }),
    code: body.code,
    definitions: [definition_of(module, key, params, result, effects)].concat(body.here),
    performs: no_effects,
  }

fn param_name(key: RootKey, i: Int) -> Bytes =
  match key {
    Generated(w, _) -> match w.operation {
      ContainerWalk(c) -> if dynamic_loops.contains(c) {
        match i { 0 -> b"a", 1 -> b"out", _ -> b"i" }
      } else if i == 1 { if c.starts_with(b"lift") { b"n" } else { b"i" } }
      else if c == b"lower_entries" { b"es" }
      else if c == b"lift_items" { b"acc" }
      else if c == b"lift_entries" { b"m" }
      else { b"a" },
      _ -> b"a",
    },
    _ -> b"p".concat(ascii_of_int(i)),
  }

fn definition_of(
  module: Bytes,
  key: RootKey,
  params: List<Type>,
  result: Type,
  effects: Effects = { listed: [], variable: None },
) -> Definition / {abort.raise} =
  {
    name: name_in_module(module, root_text(root_name(key))),
    return_kind: Some(kind_of(result).kind),
    return_type: OpenShape([]),
    pure: effects.listed.len() == 0,
    constant: false,
    value: None,
    arity: params.len(),
    scheme: Some(monomorphic(function_type(params, result, effects))),
    witnesses: 0,
    borrowed: [],
    root: key,
  }

fn qualified_root(module: Bytes, key: RootKey) -> Bytes / {abort.raise} =
  qualify(module, name_in_module(module, root_text(root_name(key))))

fn call_of(
  module: Bytes,
  key: RootKey,
  args: List<Code>,
  return_type: Type,
) -> Code / {abort.raise} =
  applied(
    unspanned_code(
      NDefinition({
        full: qualified_root(module, key),
        args: [],
        effect_arguments: [],
        labels: [],
      }),
      function_type(args.map(|a: Code| a.ty), return_type, no_effects),
    ),
    args,
    return_type,
  )

const tag_unit: Int = 0

const tag_false: Int = 1

const tag_true: Int = 2

const tag_list: Int = 9

const tag_map: Int = 10

const tag_record: Int = 11

const tag_constructor: Int = 12

const tag_array: Int = 14
