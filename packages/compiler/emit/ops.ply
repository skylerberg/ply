               ctype, unsigned_ctype, width_named, width_index, carried, in_imm, width_min,
               width_max, nth_bytes, bytes_join, int_lit, lit_int, checked_sub, is_bitop, is_shift,
               bitop_c, binary_code, arith_code, overflow_code)
