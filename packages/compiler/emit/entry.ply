                  lower_to_emit, slots_read)
import check.resolve.scopes (of_binder)
import check.resolve.tables (qualify)
import check.types (Type, TyFn, Scheme)
import emit.typing (Typed, node_types, unknown_type)
import std.list
import syntax.exprs (Expr)
import syntax.patterns (LInt, LBad)
import std.bytes (ascii_of_int)
import emit.c (KBool, KBoxed, KDec, KFloat, KInt, KNum, KSum, Kind, is_sum, sum_helper, ctype,
               failing_return, bytes_join, tick_line, sorted_names)
import emit.roots (symbol_of, entry_of, own_definition, specialisation_of)
import emit.answer (no_generics, Tables, no_tables, sorted_widths, Emitted, Head)
import emit.reps (Ctors, Ty, TyList, TyOpen, Def, Imported, Carrier, Cases, Fields, Whole,
                  nth_field, record_leaves, raw_carrier, returned_kind, field_param, word_param,
                  substituted_fully, ctors_of)
import emit.keys (root_name)
import emit.pieces (spelled)
import emit.tir
import emit.tir (Fn)
import emit.lower (root_lowered, group_lowered)
import emit.lower.setting (Root, param_type)
import emit.print.text (Printed)
import emit.print.made (head_types)
import emit.declined (Vetted, vetted, noted)
import emit.state (CValue, Emitter, EffectName, EmitParam, WithValue, line, indent, outdent, fresh,
                   note_slice, charge, note_holder, note_bound, nth_value, tables_of)
