//! A root's C function: its body lowered to the typed form, its counts placed, checked and printed.

import syntax.parsing (dummy_span)
import syntax.exprs (Expr)
import syntax.patterns (Lit, LInt, LBad)
import check.resolve.scopes (of_binder)
import check.resolve.tables (qualify)
import check.types (Type, TyFn)
import emit.code (Code, NLit, lower_fn)
import emit.typing (unknown_type)
import emit.c (Kind, sorted_names)
import emit.roots (symbol_of, entry_of, own_definition, specialisation_of)
import emit.answer (Tables, no_tables, Emitted, Head, Defined)
import emit.reps (Ty, Def, EmitParam, substituted_fully, carried_answer, no_ctors)
import emit.keys (root_name)
import emit.pieces (spelled)
import emit.tir
import emit.tir (Fn, Declined, family_name)
import emit.lower (root_lowered, group_lowered)
import emit.lower.setting (Setting, Root, param_type, params_carried)
import emit.own (owned)
import emit.verify (verified)
import emit.print (printed_fn)
import emit.print.text (Printed)
import emit.print.made (head_types)

/// A definition lowered once, for grouping and for emission; `code` is `None` when it is not wanted or does not lower.
pub type Prepared = {
  full: Bytes,
  base: Int,
  names: List<Bytes>,
  kinds: List<Option<{ kind: Kind, ty: Ty }>>,
  ps: List<EmitParam>,
  known: Bool,
  code: Option<Code>,
}

/// A group's one body under its first member's name, or, when a member does not lower to `Code`,
/// each member on its own.
pub fn group_emitted(s: Setting, members: List<Prepared>) -> List<Emitted> / {abort.raise} = {
  let roots = members.fold([], |acc: List<{ root: Root, code: Code }>, p: Prepared|
    match p.code {
      Some(c) -> acc.push({ root: root_at(s, p.full, p.base, p.ps), code: c }),
      None -> acc,
    });
  if roots.len() != members.len() {
    members.map(|p: Prepared| emitted_from(s, p.base, p.full, p.ps, p.known, p.code))
  } else {
    let first = match members.at(0) { Some(p) -> p.full, None -> b"" };
    [form_emitted(first, group_lowered(s, roots))]
  }
}

/// Root `full` of the setting's module, whose text starts at `base` and whose parameters are `ps`, as
/// the typed form lowers it: each parameter of the type its scheme gives it, its answer carried as
/// its definition's is and of the type its scheme answers.
fn root_at(s: Setting, full: Bytes, base: Int, ps: List<EmitParam>) -> Root / {abort.raise} =
  {
    full: full,
    base: base,
    params: ps,
    types: ps.map(param_type),
    answer: carried_answer(s.module, s.here, full),
    answer_ty: answer_type(s.module, s.here, full),
    code: None,
  }

/// What the root `full` of `module` answers: what its definition's scheme answers, at the root's
/// type arguments where it is a specialisation; unknown for a root of no definition.
fn answer_type(module: Bytes, here: List<Def>, full: Bytes) -> Type / {abort.raise} = {
  let own = own_definition(full);
  let args = match specialisation_of(full) { Some(sp) -> sp.args, None -> [] };
  here.fold(unknown_type(), |acc: Type, d: Def|
    if qualify(module, d.name) != own { acc } else {
      match d.scheme {
        Some(sc) -> match sc.ty { TyFn(f) -> substituted_fully(f.ret, args), _ -> acc },
        None -> acc,
      }
    })
}

/// The root `full` as the typed form lowered it, its counts placed, checked, and printed as an
/// answer's text and tables. A root the form declines, a form the check refuses and one a printer
/// has no C for each fail the build naming the root: it would not compile, or would run wrong.
fn form_emitted(full: Bytes, lowered: Result<Fn, Declined>) -> Emitted / {abort.raise} =
  match lowered {
    Err(no) ->
      internal(full, Bytes::concat_all([b"is declined by ", family_name(no.by), b": ", no.why])),
    Ok(f) -> {
      let counted = owned(f);
      match verified(counted) {
        Some(fault) -> internal(full, b"fails its check: ".concat(fault)),
        None -> {
          let pr = handle {
            printed_fn(counted)
          } with {
            abort.raise(m) -> internal(full, b"does not print: ".concat(Bytes::of_string(m))),
          };
          { name: full, text: spelled(pr.pieces), tables: form_tables(counted, pr), why: None }
        },
      }
    },
  }

/// The internal error that stops a build at root `full`'s typed form, which `what` says.
fn internal<a>(full: Bytes, what: Bytes) -> a / {abort.raise} =
  panic(String::of_bytes_lossy(Bytes::concat_all([b"the typed form of `", full, b"` ", what])))

/// What the root `f` printed as `pr` names of its unit, as an answer's tables hold it: a group's
/// members by their case, and the head each root it holds is declared with.
fn form_tables(f: Fn, pr: Printed) -> Tables / {abort.raise} = {
  let held = if f.members.len() == 0 {
    [{ name: root_name(f.key), head: head_types(f.conv.reps, f.conv.answer) }]
  } else {
    f.members.map(|m: tir::Member|
      { name: root_name(m.key), head: head_types(m.conv.reps, m.conv.answer) })
  };
  {
    consts: pr.consts,
    builtins: pr.builtins,
    fields: pr.fields,
    shapes: pr.shapes.map(sorted_names),
    lambdas: pr.lambdas.map(spelled),
    calls: pr.calls.map(root_name),
    generics: {
      calls: f.links.generics,
      needs: f.links.needs,
      expects: pr.expects,
      called: f.links.called,
      passes: f.links.passes,
    },
    performs: pr.performs,
    handles: pr.handles,
    members: if f.members.len() == 0 { [] }
    else { held.map(|h: { name: Bytes, head: Head }| h.name) },
    symbols: held.map(|h: { name: Bytes, head: Head }|
      { symbol: symbol_of(h.name), entry: entry_of(h.name), head: h.head }),
  }
}

pub fn params_of(
  names: List<Bytes>,
  kinds: List<Option<{ kind: Kind, ty: Ty }>>,
) -> List<EmitParam> = params_carried(names, kinds, [], [])

/// One root's emission, definition, test or proposition alike, from its source `body`.
pub fn root_emitted(
  s: Setting,
  base: Int,
  full: Bytes,
  names: List<Bytes>,
  ps: List<EmitParam>,
  known: Bool,
  sites: Map<Bytes, List<Bytes>>,
  body: Expr,
) -> Emitted / {abort.raise} =
  emitted_from(s, base, full, ps, known, if known {
    match lower_fn(names, [], sites, body, of_binder(s.module)) {
      Some(l) -> Some(l.code),
      None -> None,
    }
  } else { None })

/// One root's emission as the typed form lowers it from `code`; refused where its body does not
/// lower to `Code`, which `known` says is for a parameter of no written type.
pub fn emitted_from(
  s: Setting,
  base: Int,
  full: Bytes,
  ps: List<EmitParam>,
  known: Bool,
  code: Option<Code>,
) -> Emitted / {abort.raise} =
  match code {
    None ->
      {
        name: full,
        text: b"",
        tables: no_tables(),
        why: Some(if known { b"a body the lowering does not reach" }
        else { b"a parameter with no written type" }),
      },
    Some(c) -> form_emitted(full, root_lowered(s, root_at(s, full, base, ps), c)),
  }

fn bare_setting() -> Setting =
  {
    module: b"m",
    here: [],
    imports: [],
    ctors: no_ctors(),
    builtins: [],
    declared: Map::new(),
    effects: [],
    release: false,
    typed: Map::new(),
  }

fn literal_code(l: Lit) -> Code = { span: dummy_span(), node: NLit(l) }

test "a body that answers a literal is printed whole: its head, its fuel test, its body and its entry" {
  let e = emitted_from(bare_setting(), 0, b"m.f", [], true, Some(literal_code(LInt(7))));
  let f = symbol_of(b"m.f");
  assert_eq(e.why, None);
  assert(e.text.index_of(Bytes::concat_all([b"Word ", f, b"(PlyCtx *ctx) {"])) != None);
  assert(e.text.index_of(b"ctx->fuel -= 1;") != None);
  assert(e.text.index_of(b"7") != None);
  assert(
    e.text.index_of(Bytes::concat_all([b"Word ", f, b"_entry(PlyCtx *ctx, const Word *args) {"]))
      != None,
  );
  assert_eq(e.tables.symbols.map(|d: Defined| d.symbol), [f])
}

test "a root the typed form declines is an internal error naming the root and why" {
  let said = handle {
    emitted_from(bare_setting(), 0, b"m.f", [], true, Some(literal_code(LBad)));
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert_eq(said, b"the typed form of `m.f` is declined by Scalars: a literal that does not read")
}
