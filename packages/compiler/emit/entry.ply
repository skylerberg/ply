//! A root's C function: its body lowered to the typed form, its counts placed, checked and printed.

import syntax.parsing (dummy_span)
import syntax.exprs (Expr)
import syntax.patterns (Lit, LInt, LBad)
import check.resolve.scopes (of_binder)
import check.types (Type, TyFn, bool_type, bytes_type, named_type)
import emit.code (Code, NLit, lower_fn)
import emit.typing (Filings, no_filings, unknown_type)
import emit.c (Kind, sorted_names)
import emit.roots (symbol_of, entry_of)
import emit.answer (Tables, no_tables, Emitted, Head, Defined)
import emit.reps (Ty, Def, EmitParam, Ctors, substituted_fully, no_ctors)
import emit.keys
import emit.keys (RootKey, Named, Written, Order, Reflect, Shown, Digest, root_name, key_types,
                  unspecialised)
import emit.pieces (spelled)
import emit.tir
import emit.tir (Fn, Declined, Lambda, Closure, family_name)
import emit.tir.statics (StaticDef)
import emit.lower (root_lowered, group_lowered)
import emit.lower.setting (Setting, Root, param_type, labels_of)
import emit.own (owned)
import emit.verify (verified)
import emit.print (printed_fn)
import emit.print.text (Printed)
import emit.print.made (head_types)

/// A definition lowered once, for grouping and for emission; `code` is why not where it is not
/// wanted or does not lower, and `filed` is what the checker filed of its nodes.
pub type Prepared = {
  full: Bytes,
  base: Int,
  names: List<Bytes>,
  kinds: List<Option<{ kind: Kind, ty: Ty }>>,
  ps: List<EmitParam>,
  known: Bool,
  code: Result<Code, Bytes>,
  filed: Result<Filings, Bytes>,
}

/// A root as the program walk lowers it, before its counts are placed: its form, or what the typed
/// form declined of it; or why the walk refused it without lowering anything.
pub type RootForm =
  | Formed({ name: Bytes, form: Result<Fn, Declined> })
  | Unformed({ name: Bytes, why: Bytes })

/// A group's one form under its first member's name, or, when a member does not lower to `Code`,
/// each member on its own.
pub fn group_formed(s: Setting, members: List<Prepared>) -> List<RootForm> / {abort.raise} = {
  let roots = members.fold([], |acc: List<{ root: Root, code: Code }>, p: Prepared|
    match p.code {
      Ok(c) -> acc.push({ root: root_at(s, Named(p.full), p.base, p.ps, p.filed), code: c }),
      Err(_) -> acc,
    });
  if roots.len() != members.len() {
    members.map(|p: Prepared| formed_from(s, p.base, Named(p.full), p.ps, p.known, p.code, p.filed))
  } else {
    let first = match members.at(0) { Some(p) -> p.full, None -> b"" };
    [Formed({ name: first, form: group_lowered(s, roots) })]
  }
}

/// Root `key` of the setting's module, whose text starts at `base`, whose parameters are `ps` and
/// whose item's nodes the checker filed `filed` of, as the typed form lowers it: each parameter of
/// the type its scheme gives it, and its answer of the type its scheme answers.
fn root_at(
  s: Setting,
  key: RootKey,
  base: Int,
  ps: List<EmitParam>,
  filed: Result<Filings, Bytes>,
) -> Root / {abort.raise} =
  {
    key: key,
    base: base,
    params: ps,
    types: ps.map(param_type),
    answer_ty: answer_type(s.here, key),
    code: Err(b"a root whose code is lowered apart"),
    filed: filed,
  }

/// What root `key` answers: what the scheme of the definition of `here` it runs answers, at the
/// root's type arguments where it is a specialisation; what a root written for a type answers where
/// no definition speaks for it; unknown for any other root.
fn answer_type(here: List<Def>, key: RootKey) -> Type / {abort.raise} = {
  let own = unspecialised(key);
  let args = key_types(key);
  here.fold(written_answer(key), |acc: Type, d: Def|
    if d.root != own { acc } else {
      match d.scheme {
        Some(sc) -> match sc.ty { TyFn(f) -> substituted_fully(f.ret, args), _ -> acc },
        None -> acc,
      }
    })
}

/// What a root written for a type answers: a comparison's `Bool` or `Ordering`, a reflection's
/// `Value` and a digest's `Bytes`; unknown for any other root.
fn written_answer(key: RootKey) -> Type =
  match key {
    Written(w) -> match w.op {
      keys::Equal -> bool_type(),
      Order -> named_type(b"Ordering"),
      Reflect -> named_type(b"std.value.Value"),
      Shown -> named_type(b"std.value.Value"),
      Digest -> bytes_type(),
      _ -> unknown_type(),
    },
    _ -> unknown_type(),
  }

/// The root a walk formed as an answer, printed against the program's constructor table `ctors`:
/// its counts placed, checked and printed, or its refusal.
pub fn emitted_of(r: RootForm, ctors: Ctors) -> Emitted / {abort.raise} =
  match r {
    Formed(f) -> form_emitted(f.name, f.form, ctors),
    Unformed(u) -> { name: u.name, text: b"", tables: no_tables(), why: Some(u.why) },
  }

/// The root `full` as the typed form lowered it, its counts placed, checked, and printed as an
/// answer's text and tables. A root the form declines, a form the check refuses and one a printer
/// has no C for each fail the build naming the root: it would not compile, or would run wrong.
fn form_emitted(
  full: Bytes,
  lowered: Result<Fn, Declined>,
  ctors: Ctors,
) -> Emitted / {abort.raise} =
  match lowered {
    Err(no) ->
      internal(full, Bytes::concat_all([b"is declined by ", family_name(no.by), b": ", no.why])),
    Ok(f) -> {
      let counted = counts_placed(f);
      match verified(counted) {
        Some(fault) -> internal(full, b"fails its check: ".concat(fault)),
        None -> handle {
          let pr = printed_fn(counted, ctors);
          { name: full, text: spelled(pr.pieces), tables: form_tables(counted, pr), why: None }
        } with {
          abort.raise(m) -> internal(full, b"does not print: ".concat(Bytes::of_string(m))),
        },
      }
    },
  }

/// `f` with its counts placed: a plain root's are placed as it is written.
pub fn counts_placed(f: Fn) -> Fn = if f.kind == tir::Plain { f } else { owned(f) }

/// The internal error that stops a build at root `full`'s typed form, which `what` says.
fn internal(full: Bytes, what: Bytes) -> Emitted / {abort.raise} =
  panic(String::of_bytes_lossy(Bytes::concat_all([b"the typed form of `", full, b"` ", what])))

/// What the root `f` printed as `pr` names of its unit, as an answer's tables hold it: a group's
/// members by their case, the head each root it holds is declared with, and the statics it and its
/// closures name.
fn form_tables(f: Fn, pr: Printed) -> Tables / {abort.raise} = {
  let held = if f.members.len() == 0 { [{ name: root_name(f.key), head: head_types(f.conv) }] }
  else { f.members.map(|m: tir::Member| { name: root_name(m.key), head: head_types(m.conv) }) };
  {
    consts: pr.consts,
    builtins: pr.builtins,
    fields: pr.fields,
    shapes: pr.shapes.map(sorted_names),
    lambdas: pr.lambdas.map(spelled),
    calls: pr.calls,
    generics: {
      calls: f.links.generics,
      needs: f.links.needs,
      expects: pr.expects,
      called: f.links.called,
      passes: f.links.passes,
    },
    performs: pr.performs,
    handles: pr.handles,
    members: if f.members.len() == 0 { [] }
    else { held.map(|h: { name: Bytes, head: Head }| h.name) },
    symbols: held.map(|h: { name: Bytes, head: Head }|
      { symbol: symbol_of(h.name), entry: entry_of(h.name), head: h.head }),
    statics: statics_named(f, []),
  }
}

/// `held` and then each static `f` and its closures name that `held` does not, in the order they
/// list them.
fn statics_named(f: Fn, held: List<StaticDef>) -> List<StaticDef> =
  f.lambdas.fold(
    f.statics.fold(held, |acc: List<StaticDef>, d: StaticDef|
      if acc.contains(d) { acc } else { acc.push(d) }),
    |acc: List<StaticDef>, l: Lambda| match l { Closure(c) -> statics_named(c.body, acc) },
  )

/// One root's form, definition, test or proposition alike, from its source `body`, a body of the
/// item whose nodes the checker filed `filed` of.
pub fn root_formed(
  s: Setting,
  base: Int,
  full: Bytes,
  names: List<Bytes>,
  ps: List<EmitParam>,
  known: Bool,
  filed: Result<Filings, Bytes>,
  body: Expr,
) -> RootForm / {abort.raise} =
  formed_from(
    s,
    base,
    Named(full),
    ps,
    known,
    if known {
      match lower_fn(names, [], labels_of(filed), body, of_binder(s.module)) {
        Ok(l) -> Ok(l.code),
        Err(why) -> Err(why),
      }
    } else { Err(b"a parameter with no written type") },
    filed,
  )

/// Root `key` as the typed form lowers it from `code`; refused where its body does not lower to
/// `Code`, saying why, which `known` says is for a parameter of no written type.
pub fn formed_from(
  s: Setting,
  base: Int,
  key: RootKey,
  ps: List<EmitParam>,
  known: Bool,
  code: Result<Code, Bytes>,
  filed: Result<Filings, Bytes>,
) -> RootForm / {abort.raise} =
  match code {
    Err(why) ->
      Unformed({
        name: root_name(key),
        why: if known { why } else { b"a parameter with no written type" },
      }),
    Ok(c) ->
      Formed({ name: root_name(key), form: root_lowered(s, root_at(s, key, base, ps, filed), c) }),
  }

fn bare_setting() -> Setting =
  {
    module: b"m",
    here: [],
    imports: [],
    ctors: no_ctors(),
    builtins: [],
    declared: Map::new(),
    effects: [],
    release: false,
  }

fn literal_code(l: Lit) -> Code = { span: dummy_span(), node: NLit(l) }

test "a body that answers a literal is printed whole: its head, its fuel test, its body and its entry" {
  let e = emitted_of(
    formed_from(
      bare_setting(),
      0,
      Named(b"m.f"),
      [],
      true,
      Ok(literal_code(LInt(7))),
      Ok(no_filings()),
    ),
    no_ctors(),
  );
  let f = symbol_of(b"m.f");
  assert_eq(e.why, None);
  assert(e.text.index_of(Bytes::concat_all([b"Word ", f, b"(PlyCtx *ctx) {"])) != None);
  assert(e.text.index_of(b"ctx->fuel -= 1;") != None);
  assert(e.text.index_of(b"7") != None);
  assert(
    e.text.index_of(Bytes::concat_all([b"Word ", f, b"_entry(PlyCtx *ctx, const Word *args) {"]))
      != None,
  );
  assert_eq(e.tables.symbols.map(|d: Defined| d.symbol), [f])
}

test "a root the typed form declines is an internal error naming the root and why, once it is emitted" {
  let formed = formed_from(
    bare_setting(),
    0,
    Named(b"m.f"),
    [],
    true,
    Ok(literal_code(LBad)),
    Ok(no_filings()),
  );
  // Lowering declines without raising; only emitting the form stops the build.
  assert_eq(
    match formed {
      Formed(f) -> match f.form { Err(_) -> true, Ok(_) -> false },
      Unformed(_) -> false,
    },
    true,
  );
  let said = handle {
    emitted_of(formed, no_ctors());
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert_eq(said, b"the typed form of `m.f` is declined by Scalars: a literal that does not read")
}
