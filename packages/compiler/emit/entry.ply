//! A root's C function: its body lowered to the typed form, its counts placed, checked and printed.

import compiler.syntax.parsing (dummy_span)
import compiler.syntax.patterns (Lit, LInt)
import compiler.check.types (Type, TyFn, TyVar, Row, row_empty, bool_type, bytes_type, named_type,
                             int_type, unit_type)
import compiler.check.known (ordering_type)
import compiler.emit.code (Code, NLit)
import compiler.emit.typing (unknown_type)
import compiler.emit.roots (symbol_of)
import compiler.emit.answer (Tables, no_tables, Emitted, Head, Defined, Exact, settled_by_callers,
                             Keyed, KeyedTag, KeyedField, KeyedEntry)
import compiler.emit.reps (Def, EmitParam, Ctors, substituted_fully, no_ctors)
import compiler.emit.keys
import compiler.emit.keys (RootKey, Named, Written, Law, Clause, Order, Reflect, Shown, Digest,
                           Stated, RootName, root_name, root_text, key_types, unspecialised,
                           has_entry, LetGo, Contained)
import compiler.emit.pieces (Piece, Hole, TagOf, FieldName, LambdaEntry, spelled, body_spelled,
                             own_symbol)
import compiler.emit.tir
import compiler.emit.tir (Fn, Lambda, Closure)
import compiler.emit.evidence (declared_arity)
import compiler.emit.tir.statics (StaticDef, SStruct, WRaw, WEntry, named, entries_of)
import compiler.emit.lower (root_lowered)
import compiler.emit.lower.setting (Setting, Root, param_type)
import compiler.emit.own (owned)
import compiler.emit.release (release_needs)
import compiler.emit.verify (verified)
import compiler.emit.print (printed_fn)
import compiler.emit.print.text (Printed)
import compiler.emit.print.made (head_types)

/// Root `key` of the setting's module, whose text starts at `base`, whose parameters are `ps`, whose
/// body lowers to `code`, as the typed form lowers it: each parameter of the type its scheme gives
/// it, and its answer of the type its scheme answers.
pub fn root_at(
  s: Setting,
  key: RootKey,
  base: Int,
  ps: List<EmitParam>,
  code: Code,
) -> Root / {abort.raise} =
  {
    key: key,
    base: base,
    params: ps,
    types: ps.map(param_type),
    answer_ty: answer_type(s.here, key),
    code: code,
    performs: row_empty(),
  }

/// What root `key` answers: what the scheme of the definition of `here` it runs answers, at the
/// root's type arguments where it is a specialisation; what a root written for a type answers where
/// no definition speaks for it; unknown for any other root.
fn answer_type(here: List<Def>, key: RootKey) -> Type / {abort.raise} = {
  let own = unspecialised(key);
  let args = key_types(key);
  here.fold(written_answer(key), |acc: Type, d: Def|
    if d.root != own { acc } else {
      match d.scheme {
        Some(sc) -> match sc.ty { TyFn(f) -> substituted_fully(f.ret, args), _ -> acc },
        None -> acc,
      }
    })
}

/// What a root no definition speaks for answers: a comparison's `Bool` or `Ordering`, a
/// reflection's `Value`, a digest's `Bytes`, a type's stated arithmetic a value of the type, and a
/// claim's `Bool`; unknown for any other root.
fn written_answer(key: RootKey) -> Type =
  match key {
    Written(w, _) -> match w.op {
      keys::Equal -> bool_type(),
      Order -> ordering_type(),
      Stated(_) -> w.ty,
      Reflect -> named_type(b"std.value.Value"),
      Shown -> named_type(b"std.value.Value"),
      Digest -> bytes_type(),
      LetGo -> unit_type(),
      Contained(c) -> if c == b"let_go_items" { unit_type() } else { unknown_type() },
      _ -> unknown_type(),
    },
    // A law's guard and body and a clause are propositions.
    Law(_) -> bool_type(),
    Clause(_) -> bool_type(),
    _ -> unknown_type(),
  }

/// `run`, a step of making root `name`, its panic naming the root: each is a defect in Ply, since a
/// checked program's every root lowers, passes the form's check and prints.
pub fn naming<a>(name: Bytes, run: () -> a / {abort.raise}) -> a / {abort.raise} =
  handle {
    run()
  } with {
    abort.raise(m) ->
      panic(String::of_bytes_lossy(Bytes::concat_all([b"Ply failed making `", name, b"`: "])) ++ m),
  }

/// Form `f` as an answer printed against the program's constructor table `ctors`: its counts placed
/// and what its releases read noted among its needs, checked, and printed as an answer's text and
/// tables; or, where its needs read a type variable's layout or type, settled by its callers.
pub fn emitted_of(f: Fn, ctors: Ctors) -> Emitted / {abort.raise} = {
  let full = root_name(f.key);
  naming(root_text(full), || {
    let counted = built_form(f);
    if settled_by_callers(counted.links.needs) { settled_emitted(full, counted) } else {
      match verified(counted) {
        Some(fault) ->
          panic(String::of_bytes_lossy(b"its typed form fails its check: ".concat(fault))),
        None -> {
          let pr = printed_fn(counted, ctors);
          {
            name: full,
            text: body_spelled(counted.key, counted.members.map(|m: tir::Member| m.key), pr.pieces),
            tables: form_tables(counted, pr, ctors.stated),
          }
        },
      }
    }
  })
}

/// Root `full`, formed as `f`, which its callers settle: no C, and the tables the unit settles its
/// calls and its callers' by.
fn settled_emitted(full: RootName, f: Fn) -> Emitted =
  {
    name: full,
    text: b"",
    tables: {
      ..no_tables(),
      generics: {
        calls: f.links.generics,
        needs: f.links.needs,
        expects: [],
        called: f.links.called,
        passes: f.links.passes,
      },
      members: f.members.map(|m: tir::Member| m.key),
    },
  }

/// `f` with its counts placed: a plain root's are placed as it is written.
pub fn counts_placed(f: Fn) -> Fn = if f.kind == tir::Plain { f } else { owned(f) }

/// `f` as a build checks and prints it: its counts placed, and what its releases read noted among its
/// needs, which say whether its callers settle it.
pub fn built_form(f: Fn) -> Fn = release_needs(counts_placed(f))

/// What the root `f` printed as `pr` names of its unit, as an answer's tables hold it: a group's
/// members by their case, the head each root it holds is declared with and whether it has an entry
/// (`stated` as `has_entry` reads it), the statics it and its closures name, the natives it calls and
/// the holes its part's table holds a place for.
fn form_tables(f: Fn, pr: Printed, stated: Map<Bytes, Bool>) -> Tables / {abort.raise} = {
  let held = if f.members.len() == 0 {
    [{ key: f.key, arity: declared_arity(f.params), head: head_types(f.conv) }]
  } else {
    f.members.map(|m: tir::Member|
      { key: m.key, arity: declared_arity(m.params), head: head_types(m.conv) })
  };
  let statics = statics_named(f, []);
  {
    fields: pr.fields,
    lambdas: pr.lambdas.map(spelled),
    // A root whose function a static holds is the body's to ask for, as a call's is.
    calls: statics.fold(pr.calls, |acc: List<RootKey>, d: StaticDef|
      entries_of(d).fold(acc, |a: List<RootKey>, k: RootKey|
        if a.contains(k) { a } else { a.push(k) })),
    generics: {
      calls: f.links.generics,
      needs: f.links.needs,
      expects: pr.expects,
      called: f.links.called,
      passes: f.links.passes,
    },
    performs: pr.performs,
    handles: pr.handles,
    members: f.members.map(|m: tir::Member| m.key),
    defined: held.map(|h: { key: RootKey, arity: Int, head: Head }|
      { entered: has_entry(h.key, h.arity, stated), head: h.head }),
    statics: statics,
    // The program's lending settles these, past every body's printing.
    handings: [],
    assumed: [],
    group: [],
    shared: pr.shared,
    natives: pr.natives,
    keyed: keyed_in(pr.pieces),
  }
}

/// Each hole of `pieces` a part's table holds a place for, once, in the order they first stand.
fn keyed_in(pieces: List<Piece>) -> List<Keyed> =
  pieces.fold([], |acc: List<Keyed>, p: Piece| {
    let keyed = match p {
      Hole(TagOf(name)) -> Some(KeyedTag(name)),
      Hole(FieldName(i)) -> Some(KeyedField(i)),
      Hole(LambdaEntry(i)) -> Some(KeyedEntry(i)),
      _ -> None,
    };
    match keyed { Some(k) -> if acc.contains(k) { acc } else { acc.push(k) }, None -> acc }
  })

/// `held` and then each static `f` and its closures name that `held` does not, in the order they
/// list them.
fn statics_named(f: Fn, held: List<StaticDef>) -> List<StaticDef> =
  f.lambdas.fold(
    f.statics.fold(held, |acc: List<StaticDef>, d: StaticDef|
      if acc.contains(d) { acc } else { acc.push(d) }),
    |acc: List<StaticDef>, l: Lambda| match l { Closure(c) -> statics_named(c.body, acc) },
  )

/// Root `key` as the typed form lowers it from `code`, an entry's body performing `performs`.
pub fn formed_from(
  s: Setting,
  base: Int,
  key: RootKey,
  ps: List<EmitParam>,
  code: Code,
  performs: Row = { atoms: [], tail: None },
) -> Fn / {abort.raise} = root_lowered(s, { ..root_at(s, key, base, ps, code), performs: performs })

fn bare_setting() -> Setting =
  {
    module: b"m",
    here: [],
    imports: [],
    ctors: no_ctors(),
    builtins: [],
    declared: Map::new(),
    machine: Map::new(),
    effects: [],
    release: false,
  }

fn literal_code(l: Lit) -> Code = { node: NLit(l), span: dummy_span(), ty: int_type() }

test "a root is defined under its symbol, with the entry the runtime calls it through" {
  let e = emitted_of(
    formed_from(bare_setting(), 0, Named(b"m.f"), [], literal_code(LInt(7))),
    no_ctors(),
  );
  assert_eq(e.tables.defined.map(|d: Defined| d.entered), [true]);
  // The body names its own root by the placeholder the unit writes its symbol into, so its C does
  // not depend on its name.
  assert_eq(e.text.index_of(symbol_of(b"m.f")), None);
  // The runtime's ABI: every root's entry takes its arguments as an array of words.
  assert(
    e.text.index_of(
        Bytes::concat_all([b"Word ", own_symbol(None), b"_entry(PlyCtx *ctx, const Word *args)"]),
      )
      != None,
  )
}

test "a root whose function a static holds is among the calls of the body naming the static" {
  let dup = Named(b"m.dup#T");
  let held = named(
    SStruct({
      of: b"PlyType",
      fields: [WRaw(1), WRaw(0), WRaw(0), WEntry(dup), WRaw(0), WRaw(0), WRaw(0)],
    }),
  );
  let f = formed_from(bare_setting(), 0, Named(b"m.f"), [], literal_code(LInt(7)));
  let counted = { ..owned(f), statics: [held] };
  let t = form_tables(counted, printed_fn(counted, no_ctors()), Map::new());
  assert(t.calls.contains(dup))
}

test "a form letting go of a value of its type variable is settled by its callers: no C, its needs in its tables" {
  let p = { id: 0, ty: TyVar(0), rep: tir::RWord };
  let f = {
    key: Named(b"m.dropping"),
    kind: tir::Rooted,
    params: [p],
    conv: {
      params: [{ handed: tir::Given, rep: tir::RWord }],
      answer: tir::RInt,
      destined: false,
      answered: tir::Owned,
    },
    answer_ty: int_type(),
    body: [tir::Return(tir::AInt(0))],
    lambdas: [],
    base: 0,
    members: [],
    links: tir::no_links(),
    statics: [],
  };
  let settled = emitted_of(f, no_ctors());
  assert_eq(settled.text, b"");
  assert_eq(settled.tables.generics.needs, [{ var: 0, reads: Exact }]);
  assert_eq(settled.tables.defined, []);
  // The same body letting go of a value of a known type is printed.
  let known = emitted_of({ ..f, params: [{ ..p, ty: bytes_type() }] }, no_ctors());
  assert(known.text.len() > 0 && known.tables.generics.needs == [], None)
}
