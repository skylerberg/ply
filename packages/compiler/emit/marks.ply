import compiler.check.types (Type, VariableType, NamedType, FunctionType, RecordType, NominalType,
                             Field, int_type, option_type, no_effects)
import std.list
import compiler.emit.keys
import compiler.emit.keys (RootKey, TypeOperation)
import compiler.check.infer.expression (retained_type)

fn handle_type(t: Type) -> Type = NamedType({ name: b"^", args: [t] })

type MarkState = { types: List<Type>, marks: List<Int>, next: Int }

pub fn marked_type(t: Type, marks: List<Int>) -> Type / {abort.raise} =
  if marks.len() == 0 { t } else { marked_from(t, marks, 0).ty }

fn marked_from(t: Type, marks: List<Int>, at: Int) -> { ty: Type, next: Int } / {abort.raise} = {
  let step = |accumulator: MarkState, p: Type| {
    let r = marked_from(p, marks, accumulator.next);
    { ..accumulator, types: accumulator.types.push(r.ty), next: r.next }
  };
  let start = { types: [], marks: [], next: at + 1 };
  let made = match t {
    NamedType(c) -> {
      let r = c.args.fold(start, step);
      { ty: NamedType({ ..c, args: r.types }), next: r.next }
    },
    RecordType(fs) -> {
      let r = fs.fold(start, |accumulator: MarkState, f: Field| step(accumulator, f.ty));
      {
        ty: RecordType(range(0, fs.len()).map(|i: Int| { ..fs.get(i), ty: r.types.get(i) })),
        next: r.next,
      }
    },
    NominalType(x) -> {
      let r = x.fields.fold(start, |accumulator: MarkState, f: Field| step(accumulator, f.ty));
      {
        ty: NominalType({
          ..x,
          fields: range(0, x.fields.len()).map(|i: Int| { ..x.fields.get(i), ty: r.types.get(i) }),
        }),
        next: r.next,
      }
    },
    FunctionType(f) -> {
      let r = step(f.params.fold(start, step), f.return_type);
      {
        ty: FunctionType({
          ..f,
          params: r.types.take(f.params.len()),
          return_type: r.types.get(f.params.len()),
        }),
        next: r.next,
      }
    },
    VariableType(_) -> { ty: t, next: at + 1 },
  };
  { ty: if marks.contains(at) { handle_type(made.ty) } else { made.ty }, next: made.next }
}

pub fn marks_of(t: Type) -> { ty: Type, marks: List<Int> } / {abort.raise} = {
  let r = strip_marks_from(t, 0);
  { ty: r.ty, marks: r.marks }
}

fn strip_marks_from(t: Type, at: Int) -> { ty: Type, marks: List<Int>, next: Int } / {abort.raise} = {
  let step = |accumulator: MarkState, p: Type| {
    let r = strip_marks_from(p, accumulator.next);
    { types: accumulator.types.push(r.ty), marks: accumulator.marks.concat(r.marks), next: r.next }
  };
  let start = { types: [], marks: [], next: at + 1 };
  match t {
    NamedType(c) -> if c.name == b"^" && c.args.len() == 1 {
      let r = c.args.fold({ types: [], marks: [at], next: at }, step);
      { ty: r.types.get(0), marks: r.marks, next: r.next }
    } else {
      let r = c.args.fold(start, step);
      { ty: NamedType({ ..c, args: r.types }), marks: r.marks, next: r.next }
    },
    RecordType(fs) -> {
      let r = fs.fold(start, |accumulator: MarkState, f: Field| step(accumulator, f.ty));
      {
        ty: RecordType(range(0, fs.len()).map(|i: Int| { ..fs.get(i), ty: r.types.get(i) })),
        marks: r.marks,
        next: r.next,
      }
    },
    NominalType(x) -> {
      let r = x.fields.fold(start, |accumulator: MarkState, f: Field| step(accumulator, f.ty));
      {
        ty: NominalType({
          ..x,
          fields: range(0, x.fields.len()).map(|i: Int| { ..x.fields.get(i), ty: r.types.get(i) }),
        }),
        marks: r.marks,
        next: r.next,
      }
    },
    FunctionType(f) -> {
      let r = step(f.params.fold(start, step), f.return_type);
      {
        ty: FunctionType({
          ..f,
          params: r.types.take(f.params.len()),
          return_type: r.types.get(f.params.len()),
        }),
        marks: r.marks,
        next: r.next,
      }
    },
    VariableType(_) -> { ty: t, marks: [], next: at + 1 },
  }
}

pub fn function_marks(t: Type) -> List<Int> / {abort.raise} = marks_of(wrap_functions(t)).marks

fn wrap_functions(t: Type) -> Type / {abort.raise} =
  match t {
    FunctionType(_) -> handle_type(t),
    NamedType(c) ->
      NamedType({
        ..c,
        args: c.args.fold([], |accumulator: List<Type>, a: Type|
          accumulator.push(wrap_functions(a))),
      }),
    RecordType(fs) ->
      RecordType(
        fs.fold([], |accumulator: List<Field>, f: Field|
          accumulator.push({ ..f, ty: wrap_functions(f.ty) })),
      ),
    NominalType(x) ->
      NominalType({
        ..x,
        fields: x.fields.fold([], |accumulator: List<Field>, f: Field|
          accumulator.push({ ..f, ty: wrap_functions(f.ty) })),
      }),
    VariableType(_) -> t,
  }

pub fn without_marks(t: Type) -> Type / {abort.raise} = marks_of(t).ty

pub fn dynamic_form(t: Type) -> Type =
  match t {
    NamedType(c) -> if c.name == b"^" && c.args.len() == 1 { retained_type() }
    else { NamedType({ ..c, args: c.args.map(dynamic_form) }) },
    RecordType(fs) -> RecordType(fs.map(|f: Field| { ..f, ty: dynamic_form(f.ty) })),
    NominalType(x) ->
      NominalType({
        ..x,
        args: x.args.map(dynamic_form),
        fields: x.fields.map(|f: Field| { ..f, ty: dynamic_form(f.ty) }),
      }),
    FunctionType(f) ->
      FunctionType({
        ..f,
        params: f.params.map(dynamic_form),
        return_type: dynamic_form(f.return_type),
      }),
    VariableType(_) -> t,
  }

pub fn has_marks(t: Type) -> Bool =
  match t {
    NamedType(c) -> c.name == b"^" || c.args.any(has_marks),
    RecordType(fs) -> fs.any(|f: Field| has_marks(f.ty)),
    NominalType(x) -> x.args.any(has_marks) || x.fields.any(|f: Field| has_marks(f.ty)),
    FunctionType(f) -> f.params.any(has_marks) || has_marks(f.return_type),
    VariableType(_) -> false,
  }

pub fn mark_type_params(
  declared: Type,
  actual: Type,
  own: List<Int>,
) -> { marked: Type, bound: List<{ var: Int, ty: Type }> } / {abort.raise} =
  match declared {
    VariableType(v) -> if own.contains(v) {
      { marked: handle_type(actual), bound: [{ var: v, ty: actual }] }
    } else { { marked: actual, bound: [] } },
    NamedType(d) -> match actual {
      NamedType(a) -> if d.name != a.name || d.args.len() != a.args.len() {
        { marked: actual, bound: [] }
      } else {
        let r = d.args.fold(
          { types: [], bound: [], i: 0 },
          |accumulator: { types: List<Type>, bound: List<{ var: Int, ty: Type }>, i: Int }, dt: Type| {
            let x = mark_type_params(dt, a.args.get(accumulator.i), own);
            {
              types: accumulator.types.push(x.marked),
              bound: accumulator.bound.concat(x.bound),
              i: accumulator.i + 1,
            }
          },
        );
        { marked: NamedType({ ..a, args: r.types }), bound: r.bound }
      },
      _ -> { marked: actual, bound: [] },
    },
    RecordType(dfs) -> match actual {
      RecordType(afs) -> {
        let r = mark_type_params_in_fields(dfs, afs, own);
        { marked: RecordType(r.fields), bound: r.bound }
      },
      _ -> { marked: actual, bound: [] },
    },
    NominalType(dx) -> match actual {
      NominalType(ax) -> {
        let r = mark_type_params_in_fields(dx.fields, ax.fields, own);
        { marked: NominalType({ ..ax, fields: r.fields }), bound: r.bound }
      },
      _ -> { marked: actual, bound: [] },
    },
    FunctionType(df) -> match actual {
      FunctionType(af) -> if df.params.len() != af.params.len() { { marked: actual, bound: [] } }
      else {
        let r = df.params.fold(
          { types: [], bound: [], i: 0 },
          |accumulator: { types: List<Type>, bound: List<{ var: Int, ty: Type }>, i: Int }, dt: Type| {
            let x = mark_type_params(dt, af.params.get(accumulator.i), own);
            {
              types: accumulator.types.push(x.marked),
              bound: accumulator.bound.concat(x.bound),
              i: accumulator.i + 1,
            }
          },
        );
        let marked_return = mark_type_params(df.return_type, af.return_type, own);
        {
          marked: FunctionType({ ..af, params: r.types, return_type: marked_return.marked }),
          bound: r.bound.concat(marked_return.bound),
        }
      },
      _ -> { marked: actual, bound: [] },
    },
  }

fn mark_type_params_in_fields(
  declared: List<Field>,
  actual: List<Field>,
  own: List<Int>,
) -> { fields: List<Field>, bound: List<{ var: Int, ty: Type }> } / {abort.raise} =
  declared.fold(
    { fields: actual, bound: [] },
    |accumulator: { fields: List<Field>, bound: List<{ var: Int, ty: Type }> }, df: Field|
      match actual.find(|f: Field| f.name == df.name) {
        None -> accumulator,
        Some(af) -> {
          let x = mark_type_params(df.ty, af.ty, own);
          {
            fields: accumulator.fields.map(|f: Field|
              if f.name == df.name { { ..f, ty: x.marked } } else { f }),
            bound: accumulator.bound.concat(x.bound),
          }
        },
      },
  )

pub fn marked_key(
  type_operation: TypeOperation,
  has_marks: Type,
  module: Bytes,
) -> RootKey / {abort.raise} = {
  let m = marks_of(has_marks);
  keys::with_marks(keys::generated_key(type_operation, m.ty, module), m.marks)
}

test "`function_marks` finds where a type contains a function, and `marked_type` replaces those functions with handle types" {
  let f = FunctionType({
    keep_parameters: [],
    once: false,
    params: [int_type()],
    return_type: int_type(),
    effects: no_effects(),
  });
  assert_eq(function_marks(f), [0]);
  assert_eq(function_marks(option_type(f)), [1]);
  let r = RecordType([{ name: b"f", ty: f }, { name: b"n", ty: int_type() }]);
  assert_eq(function_marks(r), [1]);
  assert_eq(
    marked_type(r, function_marks(r)),
    RecordType([{ name: b"f", ty: handle_type(f) }, { name: b"n", ty: int_type() }]),
  );
  assert_eq(function_marks(int_type()), [])
}
