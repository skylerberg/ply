//! Release per type: what letting go of a value of a type, and counting it once more, does to the
//! words it is laid in, read off how its type lays it out; what the block a value is held in holds;
//! and the plain roots written for a type. A drop root is written per kind of block: it is handed a
//! block whose last count was taken, lets go of what the block holds and gives its memory back.

import compiler.check.types (Type, NamedType, FunctionType, VariableType, RecordType, NominalType,
                             Field, record_fields, field_get, encode_type, int_type, unit_type,
                             row_empty, label_type, is_label_or_row, string_type, list_type,
                             option_type, map_type, secret_type, bool_type, float_type,
                             decimal_type)
import compiler.check.known
import compiler.check.known (list_node_name, list_node_type, map_node_type, task_name, chan_name,
                             secret_name, string_name, bytes_name, list_name, map_name, array_name,
                             columns_name, hold_name, option_name, none_ctor, some_ctor, array_type,
                             columns_type, task_type, chan_type, hold_type, width_type)
import std.bytes (ascii_of_int)
import compiler.syntax.parsing (dummy_span)
import compiler.emit.layout (ValueLayout, PlainWords, RecordFields, SumCases, InlineRecord,
                             FieldLayout, SumLayout, CaseLayout, Payload, Nullary, Inline, Boxed,
                             WordClass, Pointer, PointerSum, RawRange, Mixed, Always, WordIs,
                             WordOutside, WordForm, Itself, Bits, RuntimeBox, Box, words,
                             holds_count, record_layout, sum_layout, raw_sum, inside, by_pointer)
import compiler.emit.abi (hold_layout)
import compiler.emit.evidence (is_evidence)
import compiler.emit.representations
import compiler.emit.representations (Ctors, SumCtor, ctors_of)
import compiler.emit.keys
import compiler.emit.keys (RootKey, Generated, Drop, Dup, Copy, Share, Keep, generated_key)
import compiler.emit.typed_ir (handed_of, param_lent, Var, Representation, AsWord, AsInt, AsSum,
                               AsFlattened, AsListView, AsReuseToken, Leaf, VarOperand, ZeroOperand,
                               IntOperand, Block, Inst, Let, Do, If, Case, Match, Loop, Handle,
                               Return, Restart, Inc, Dec, Reset, Destructure, Fn, Metered, Plain,
                               ParamOwnership, OwnedParam, BorrowedParam, OwnedResult,
                               BorrowedResult, Convention, Member, TagTest, Rvalue, IfUnique,
                               WalkLoop, Lambda, Closure, no_links, is_refcounted, parts_of,
                               may_suspend, handle_suspends, Call, Test)
import compiler.emit.typed_ir.handling (HandleSite, empty_instance)
import compiler.emit.lower.representation (representation_with)
import compiler.emit.output (Need, NeedKind, Scalar, Layout, Exact)
import compiler.emit.print.count_functions (identity_fn, noop_release_fn, box_dup_fn,
                                            sized_box_release_fn)

/// How one counted word is counted. `Object`: 0 or a block's start, given to the drop root it names
/// where its last count goes. `CaseBox`: the box case `case` of the sum `sum` is held in, given to
/// that case's drop root. `SumWord`: a sum of one word over pointers, counted where at or above the
/// pointer floor, its block the word with its tag bits clear, the sum's drop root given the word as
/// it is. `ScalarWord`: the runtime's box of the bits of a scalar of `ty`, `words` of them. A scalar's box
/// holds nothing counted, so its last count gives it back by its size, through no root. `ThroughDescriptor`: a
/// function value, let go of through the release entry of the descriptor its block's first word
/// names. `RuntimeHandle`: a handle the runtime gives back.
pub type CountedWord =
  | Object(RootKey)
  | CaseBox({ sum: Type, case: Int })
  | SumWord(RootKey)
  | ScalarWord({ ty: Type, words: Int })
  | ThroughDescriptor
  | RuntimeHandle

/// A counted part of a value laid in words. `WordAt`: the word at `at`, read with its tag bits
/// clear where `masked`. `ByCase`: a sum of several words from `at`, whose case decides which of its
/// words are counted, each counted case's parts counted from the sum's first word.
pub type Part =
  | WordAt({ at: Int, masked: Bool, how: CountedWord })
  | ByCase({ at: Int, sum: SumLayout, cases: List<{ case: Int, parts: List<Part> }> })

/// A counted part of a block as a body holds it once the block is opened: the word it starts at,
/// its type, and how it is held.
pub type BlockPart = { at: Int, ty: Type, representation: Representation }

/// What the block a value of a type is held in holds, as its drop root lets go of it.
pub type BlockContents =
  /// A box of a value laid by its type, or of a sum's boxed case: its counted parts and how many
  /// payload words it has.
  | BoxContents({ parts: List<BlockPart>, words: Int })
  /// A hold: what it holds, and the rest the runtime's.
  | HoldContents(BlockPart)
  /// A string's or byte string's own object, its bytes after its head (`layout.text_head`), which
  /// holds nothing counted.
  | BytesBlock
  /// A list's own object: its trie's root, let go of at `node`, and each item of its tail, an item's
  /// parts `stride` words apart as its type lays it.
  | ListOf({ node: RootKey, item: List<Part>, stride: Int })
  /// A node of a list's trie: a branch's kids, let go of at `node`, its own drop root, or a leaf's
  /// items, `stride` words apart.
  | ListNodeOf({ node: RootKey, item: List<Part>, stride: Int })
  /// A map's own object: its tree's root, let go of at its node's drop root.
  | MapOf(RootKey)
  /// A node of a map's tree: a branch's kids, let go of at `node`, and the greatest key under each,
  /// or a leaf's keys and values, each laid as its type lays it in `key_words` and `value_words`.
  | MapNodeOf({ node: RootKey, key: List<Part>, value: List<Part>, key_words: Int, value_words: Int })
  /// An array: each element's parts, its elements `stride` words apart, an element of no words
  /// taking one.
  | ArrayOf({ element: List<Part>, stride: Int })
  /// A `Columns`: each field's column, an array let go of at its drop root.
  | ColumnsOf(List<RootKey>)
  /// The runtime's box of a scalar's bits, as many words as it holds, which a walk copies or keeps
  /// and whose last count gives it back by its size.
  | ScalarBox(Int)
  /// A function value's block, let go of through its descriptor.
  | ClosureBlock
  /// A handle the runtime gives back.
  | HandleBlock
  /// A sum of one word of type `ty`, laid as `laid` in place in the word of a case of a sum around
  /// it: the block its own case holds, let go of and walked by that case.
  | InlineSum({ ty: Type, layout: SumLayout })

/// The root doing `op` to the block a value of `ty` is held in, written in the module declaring
/// `ty`'s name and in the prelude for a type no module declares.
pub fn root_of(op: keys::TypeOp, ty: Type) -> RootKey = generated_key(op, ty, b"std.prelude")

/// The drop root of the block a value of `ty` is held in.
pub fn drop_of(ty: Type) -> RootKey = root_of(Drop, ty)

/// The root doing `op` to the box case `case` of the sum `sum` is held in, keyed at the sum's own
/// type.
pub fn case_root(op: keys::TypeOp, sum: Type, case: Int) -> RootKey =
  root_of(keys::OnCase({ op: op, case: case }), sum)

/// How a sum held as `r`, known to hold case `k`, boxed, is held where a body holds its box alone: a
/// sum of one word whose one case is that one, boxed at its word. None where `r` is no sum or does
/// not box case `k`.
pub fn boxed_case_of(r: Representation, k: Int) -> Option<Representation> =
  match r {
    AsSum(s) -> match ((s.layout.cases.at(k), s.cases.at(k))) {
      (Some(c), Some(name)) -> match c.payload {
        Boxed(b) ->
          Some(
            AsSum({
              layout: {
                classes: [Pointer],
                cases: [{ test: Always, payload: Boxed({ ..b, at: 0, stripped: false }) }],
              },
              cases: [name],
            }),
          ),
        _ -> None,
      },
      _ -> None,
    },
    _ -> None,
  }

/// `boxed_case_of` the sum `ty` laid as `s`, held as `sum_rep` holds it.
pub fn boxed_case_rep(
  ctors: Ctors,
  ty: Type,
  s: SumLayout,
  k: Int,
) -> Option<Representation> / {abort.raise} = boxed_case_of(sum_rep(ctors, ty, s), k)

/// The box a sum laid as `s` is held as alone, where its one case is boxed at its word, untagged.
pub fn boxed_alone(
  s: SumLayout,
) -> Option<{ at: Int, stripped: Bool, skip: Int, layout: ValueLayout }> =
  match ((s.classes, s.cases)) {
    ([_], [c]) -> match c.payload {
      Boxed(b) -> if b.at == 0 && !b.stripped { Some(b) } else { None },
      _ -> None,
    },
    _ -> None,
  }

/// A type a generator or a printer cannot read as it must, which no checked program holds.
fn refused<a>(why: Bytes, ty: Type) -> a / {abort.raise} =
  panic(String::of_bytes_lossy(Bytes::concat_all([b"release: ", why, b": ", encode_type(ty)])))

/// What `pointer` says of a pointer word of a type that lays no block, sum or handle.
fn unknown_pointer() -> Bytes = b"a pointer of a type that lays no block, sum or handle"

/// The constructors of the sum `ty` in declared order, as the table names them, each with its
/// arguments' types at `ty`'s arguments.
fn cases_of(ctors: Ctors, ty: Type) -> List<{ name: Bytes, args: List<Type> }> / {abort.raise} =
  match ty {
    NamedType(c) -> match ctors.sums.get(c.name) {
      Some(cs) ->
        cs.map(|x: SumCtor| { name: x.name, args: representations::ctor_fields_at(x, c.args) }),
      None -> refused(b"a sum no constructor table declares", ty),
    },
    _ -> refused(b"a sum of no declared type", ty),
  }

/// The arguments' types of case `k` of `cases`.
fn args_at(cases: List<{ name: Bytes, args: List<Type> }>, k: Int) -> List<Type> =
  match cases.at(k) { Some(c) -> c.args, None -> [] }

/// The types of a record's fields, in the checker's order, which its layout keeps.
fn field_types(ty: Type) -> List<Type> =
  match record_fields(ty) { Some(fs) -> fs.map(|f: Field| f.ty), None -> [] }

/// How a word of `ty` of class `c` is counted, where it is counted: a function value, a clause's
/// continuation among them, through its descriptor; a block emitted
/// code lays out and a sum of one word through their types' drop roots; a task, a channel or a
/// secret by the runtime; evidence counted not at all. A checked program holds no other pointer.
fn pointer(ctors: Ctors, ty: Type, c: WordClass) -> Option<CountedWord> / {abort.raise} =
  match c {
    Pointer -> if is_evidence(ty) { None }
    else if function_valued(ty) { Some(ThroughDescriptor) } else {
      Some(match ty {
        // A record wider than a call's registers lies inside another value as a pointer to its box.
        RecordType(_) -> Object(drop_of(ty)),
        NominalType(_) -> Object(drop_of(ty)),
        NamedType(n) -> if is_emitted_block(n.name) || ctors.sums.contains(n.name) {
          Object(drop_of(ty))
        } else if runtime_handle(n.name) { RuntimeHandle }
        // `release_needs` keys every type a body lets go of exactly, so no build erases one.
        else if ty == representations::word_type() {
          refused(b"a word erased to `_`, which only a key no build makes lets go of", ty)
        } else { refused(unknown_pointer(), ty) },
        _ -> refused(unknown_pointer(), ty),
      })
    },
    PointerSum(_) -> Some(SumWord(drop_of(ty))),
    Mixed -> refused(b"a word its cases lay apart, laid with no cases", ty),
    _ -> None,
  }

/// Whether a value of `ty` is a function value's block, which its descriptor lets go of: a
/// function's or a clause's continuation's.
fn function_valued(ty: Type) -> Bool =
  match ty { FunctionType(_) -> true, _ -> representations::resumed(ty) != None }

/// Whether the type named `name` is a handle the runtime gives back, holding nothing emitted code
/// lets go of.
fn runtime_handle(name: Bytes) -> Bool =
  [task_name(), chan_name(), secret_name()].contains(name)
    || representations::scheduler_objects().contains(name)

/// Whether blocks of the type named `name` hold what emitted code lays out and lets go of.
fn is_emitted_block(name: Bytes) -> Bool =
  [
    string_name(),
    bytes_name(),
    list_name(),
    list_node_name(),
    map_name(),
    known::map_node_name(),
    array_name(),
    columns_name(),
    hold_name(),
    representations::parallel_results_name(),
  ].contains(
    name,
  )

/// The type variables letting go of a value of `ty` reads: each it names but under a function's type
/// or a continuation's, which its descriptor lets go of, or a task's, a channel's or a secret's, which
/// the runtime gives back.
pub fn released_vars(ty: Type) -> List<Int> =
  match ty {
    VariableType(v) -> if v >= 0 { [v] } else { [] },
    FunctionType(_) -> [],
    NamedType(c) -> if runtime_handle(c.name) || function_valued(ty) || is_label_or_row(ty) { [] }
    else {
      c.args.fold({ at: 0, vs: [] }, |acc: { at: Int, vs: List<Int> }, a: Type|
        {
          at: acc.at + 1,
          vs: if representations::is_hold_label(c, acc.at) { acc.vs }
          else { joined(acc.vs, released_vars(a)) },
        }).vs
    },
    RecordType(fs) -> fs.fold([], |acc: List<Int>, f: Field| joined(acc, released_vars(f.ty))),
    NominalType(x) ->
      x.fields.fold([], |acc: List<Int>, f: Field| joined(acc, released_vars(f.ty))),
  }

fn joined(a: List<Int>, b: List<Int>) -> List<Int> =
  b.fold(a, |acc: List<Int>, x: Int| if acc.contains(x) { acc } else { acc.push(x) })

/// `f`, its counts placed, noting among its needs `release_reads(f)`, so a specialisation settles
/// every release on a type.
pub fn release_needs(f: Fn) -> Fn =
  { ..f, links: { ..f.links, needs: fn_needs(entered(f.links.needs, f), f) } }

/// What `f`'s counts read of its type variables: each a count it lets go of reads exactly, since a
/// value is let go of per type, and each a count it takes its layout alone. What its failure paths
/// let go of and what its closures' bodies do count as its own, and so does what a frame's record
/// holds across a stop, which counts each value once more and lets it go, and what its entry counts:
/// each parameter it lends, let go of once the call is done, and an answer it borrows, counted once
/// more before it is handed back. A body reading any is printed only at type arguments its callers
/// settle.
pub fn release_reads(f: Fn) -> List<Need> = fn_needs(entered([], f), f)

/// `needs` with what the entry of `f`, or of each member of its tail group, counts.
fn entered(needs: List<Need>, f: Fn) -> List<Need> = {
  let held = if f.members.len() == 0 { [{ params: f.params, convention: f.convention }] }
  else { f.members.map(|m: Member| { params: m.params, convention: m.convention }) };
  held.fold(needs, |acc: List<Need>, h: { params: List<Var>, convention: Convention }| {
    let lent = range(0, h.params.len()).fold(acc, |a: List<Need>, k: Int|
      match h.params.at(k) {
        Some(v) -> if param_lent(h.convention, k) && is_refcounted(v.representation) {
          reading(a, v.ty, Exact)
        } else { a },
        None -> a,
      });
    match h.convention.answered {
      OwnedResult -> lent,
      BorrowedResult(_) -> if is_refcounted(h.convention.result) {
        reading(lent, f.result_type, Layout)
      } else { lent },
    }
  })
}

fn fn_needs(needs: List<Need>, f: Fn) -> List<Need> =
  f.lambdas.fold(block_needs(needs, f.body), |acc: List<Need>, l: Lambda|
    match l { Closure(c) -> fn_needs(acc, c.body) })

fn block_needs(needs: List<Need>, b: Block) -> List<Need> =
  b.fold(needs, |acc: List<Need>, i: Inst|
    match i {
      Let(l) -> across(unwound(value_needs(acc, l.val), l.unwind), may_suspend(l.val), l.unwind),
      Do(d) -> across(unwound(value_needs(acc, d.val), d.unwind), may_suspend(d.val), d.unwind),
      If(x) -> block_needs(block_needs(acc, x.then), x.otherwise),
      Case(c) ->
        c.arms.fold(block_needs(acc, c.rest), |a: List<Need>, arm: { when: Int, body: Block }|
          block_needs(a, arm.body)),
      Match(m) -> m.arms.fold(block_needs(acc, m.rest), block_needs),
      Loop(l) -> block_needs(acc, l.body),
      Handle(h) ->
        across(
          unwound(block_needs(acc, h.body), h.unwind),
          handle_suspends(h.body, h.site),
          h.unwind,
        ),
      Inc(n) -> reading(acc, n.var.ty, Layout),
      Dec(v) -> reading(acc, v.ty, Exact),
      Reset(r) -> reading(acc, r.of.ty, Exact),
      Destructure(o) -> match o.of.representation {
        AsFlattened(_) -> acc,
        _ -> reading(acc, o.of.ty, Exact),
      },
      _ -> acc,
    })

fn value_needs(needs: List<Need>, val: Rvalue) -> List<Need> =
  match val { IfUnique(v) -> reading(needs, v.ty, Exact), _ -> needs }

/// `needs` with what letting go of each counted value of `unwind` reads; a reuse token, freed by its
/// size, reads nothing.
fn unwound(needs: List<Need>, unwind: List<Var>) -> List<Need> =
  holding(unwind).fold(needs, |acc: List<Need>, v: Var| reading(acc, v.ty, Exact))

/// `needs` with what a frame's record over `unwind` reads where it is held across a stop, as `stops`
/// says: the count of each value `unwound` lets go of taken once more, by its layout.
fn across(needs: List<Need>, stops: Bool, unwind: List<Var>) -> List<Need> =
  if !stops { needs }
  else { holding(unwind).fold(needs, |acc: List<Need>, v: Var| reading(acc, v.ty, Layout)) }

/// The values of `unwind` that hold a count, but a reuse token, which is freed by its size.
fn holding(unwind: List<Var>) -> List<Var> =
  unwind.filter(|v: Var| match v.representation { AsReuseToken(_) -> false, r -> is_refcounted(r) })

/// `needs` with each variable a count of `ty` reads read as `reads`.
fn reading(needs: List<Need>, ty: Type, reads: NeedKind) -> List<Need> =
  released_vars(ty).fold(needs, |acc: List<Need>, v: Int|
    if acc.contains({ var: v, reads: reads }) { acc } else { acc.push({ var: v, reads: reads }) })

/// Whether the type named `name` is a scalar of two words that a pointer to the runtime's box holds.
fn whole(ty: Type) -> Part = WordAt({ at: 0, masked: false, how: Object(drop_of(ty)) })

/// The counted parts of a value of `ty` laid as `l`, its words counted from `at`; a sum laid by its
/// words' classes alone is counted by its class, which a word its cases lay apart cannot be: a sum of
/// a recursion group laid so inside a box of the group's is held by its type's layout
/// (`held_in`). Raises where `l` is no layout of `ty`.
pub fn layout_parts(ctors: Ctors, ty: Type, l: ValueLayout, at: Int) -> List<Part> / {abort.raise} =
  match l {
    PlainWords(cs) ->
      range(0, cs.len()).fold([], |acc: List<Part>, i: Int|
        match cs.at(i) {
          Some(c) -> match pointer(ctors, ty, c) {
            Some(how) -> acc.push(WordAt({ at: at + i, masked: false, how: how })),
            None -> acc,
          },
          None -> acc,
        }),
    RecordFields(fs) -> fields_parts(ctors, field_types(ty), fs, at, ty),
    SumCases(s) -> sum_parts(ctors, ty, s, at),
    // Past the header, whose count is no code's to take.
    InlineRecord(r) -> layout_parts(ctors, ty, r, at + 1),
  }

/// The counted parts of fields `fs` of the types `tys`, in order, the record's words from `at`.
fn fields_parts(
  ctors: Ctors,
  tys: List<Type>,
  fs: List<FieldLayout>,
  at: Int,
  of: Type,
) -> List<Part> / {abort.raise} =
  fs.fold({ i: 0, out: [] }, |acc: { i: Int, out: List<Part> }, f: FieldLayout|
    match tys.at(acc.i) {
      Some(t) -> { i: acc.i + 1, out: acc.out.concat(layout_parts(ctors, t, f.layout, at + f.at)) },
      None -> refused(b"a layout of more fields than its type has", of),
    }).out

/// The counted parts of a sum of `ty` laid as `s` from word `at`: none where no case counts; for a
/// sum of one word its word, given to its own drop root, or counted as its payload is where one case
/// alone lays a pointer in it in place, untagged; for a wider one, each case's parts.
fn sum_parts(ctors: Ctors, ty: Type, s: SumLayout, at: Int) -> List<Part> / {abort.raise} =
  if !holds_count(SumCases(s)) { [] } else {
    let cases = cased(ctors, ty, s);
    let one = |own: CountedWord| [WordAt({ at: at, masked: false, how: own })];
    match s.classes {
      [PointerSum(m)] ->
        one(match inline_pointer(s, cases) {
          Some(Object(k)) -> if m <= 1 { Object(k) } else { SumWord(k) },
          Some(SumWord(k)) -> SumWord(k),
          Some(how) -> if m <= 1 { how } else { SumWord(drop_of(ty)) },
          None -> SumWord(drop_of(ty)),
        }),
      [Pointer] ->
        one(match inline_pointer(s, cases) { Some(how) -> how, None -> Object(drop_of(ty)) }),
      _ -> [ByCase({ at: at, sum: s, cases: cases })],
    }
  }

/// Each case of the sum `ty` laid as `s` that holds a count, with its parts.
fn cased(
  ctors: Ctors,
  ty: Type,
  s: SumLayout,
) -> List<{ case: Int, parts: List<Part> }> / {abort.raise} = {
  let declared = cases_of(ctors, ty);
  range(0, s.cases.len()).fold([], |acc: List<{ case: Int, parts: List<Part> }>, k: Int|
    match s.cases.at(k) {
      Some(c) -> match case_parts(ctors, ty, k, args_at(declared, k), c.payload) {
        [] -> acc,
        ps -> acc.push({ case: k, parts: ps }),
      },
      None -> acc,
    })
}

/// How the one word of a sum is counted where a single case lays a pointer in it in place, and no
/// other case counts: as that pointer.
fn inline_pointer(
  s: SumLayout,
  cases: List<{ case: Int, parts: List<Part> }>,
) -> Option<CountedWord> =
  match cases {
    [only] -> match s.cases.at(only.case) {
      Some(c) -> match c.payload {
        Inline(_) -> match only.parts {
          [WordAt(w)] -> if w.at == 0 && !w.masked { Some(w.how) } else { None },
          _ -> None,
        },
        _ -> None,
      },
      None -> None,
    },
    _ -> None,
  }

/// The counted parts of case `k` of the sum `ty`, of arguments `args`, laid as `p` says, counted
/// from the sum's first word.
fn case_parts(
  ctors: Ctors,
  ty: Type,
  k: Int,
  args: List<Type>,
  p: Payload,
) -> List<Part> / {abort.raise} =
  match p {
    Nullary -> [],
    Inline(i) -> masked_at(payload_parts(ctors, args, i.layout, i.offset, ty), i.stripped),
    Boxed(b) -> [WordAt({ at: b.at, masked: b.stripped, how: CaseBox({ sum: ty, case: k }) })],
  }

/// The counted parts of a case's arguments `args`, laid as a record of them in order, from word `at`.
fn payload_parts(
  ctors: Ctors,
  args: List<Type>,
  l: ValueLayout,
  at: Int,
  sum: Type,
) -> List<Part> / {abort.raise} =
  match l {
    RecordFields(fs) -> if fs.len() == args.len() { fields_parts(ctors, args, fs, at, sum) }
    else { refused(b"a case laid out other than as its arguments", sum) },
    _ -> refused(b"a case laid out other than as a record of its arguments", sum),
  }

/// `ps` with the word at `stripped`, which holds a case's tag in its low bits, read masked.
fn masked_at(ps: List<Part>, stripped: Option<Int>) -> List<Part> =
  match stripped {
    None -> ps,
    Some(w) ->
      ps.map(|p: Part|
        match p { WordAt(x) -> if x.at == w { WordAt({ ..x, masked: true }) } else { p }, _ -> p }),
  }

/// The counted parts of a value of `ty` held as its word form `form`, one word where one word is
/// required (a list's item, a closure's uniform argument, what a type's descriptor counts), where
/// its type lays it as `l`.
pub fn form_parts_of(
  ctors: Ctors,
  ty: Type,
  form: WordForm,
  l: ValueLayout,
) -> List<Part> / {abort.raise} =
  match form {
    Itself -> layout_parts(ctors, ty, l, 0),
    Bits -> [],
    RuntimeBox -> [WordAt({ at: 0, masked: false, how: ScalarWord({ ty: ty, words: words(l) }) })],
    Box(_) -> [whole(ty)],
  }

/// `form_parts_of` at `ty`'s word form and layout over the program's constructors.
pub fn form_parts(ctors: Ctors, ty: Type) -> List<Part> / {abort.raise} =
  form_parts_of(
    ctors,
    ty,
    representations::word_form(ctors, ty),
    representations::layout_of(ctors, ty),
  )

/// The functions of the emitter's head that count a word form once more, answering it, and let go
/// of one, answering 0: what a type's descriptor names where the word form holds no block a root
/// lets go of.
pub type WordFormFunctions = { dup: Bytes, release: Bytes }

/// The head's functions a descriptor of `ty` counts and lets go of its word form by: a word that
/// holds no count; a scalar's box, given back by its size. None where the word form holds a block
/// only the type's own roots let go of.
pub fn word_form_functions(ctors: Ctors, ty: Type) -> Option<WordFormFunctions> / {abort.raise} =
  match form_parts(ctors, ty) {
    [] -> Some(immediate_functions()),
    [WordAt(w)] -> match w.how { ScalarWord(s) -> Some(box_functions(s.words)), _ -> None },
    _ -> None,
  }

/// The head's functions for a word form holding no count.
pub fn immediate_functions() -> WordFormFunctions =
  { dup: identity_fn(), release: noop_release_fn() }

/// The head's functions for a scalar's box of `words` payload words.
pub fn box_functions(words: Int) -> WordFormFunctions =
  { dup: box_dup_fn(), release: sized_box_release_fn(words) }

/// How many payload words a scalar's box holds: a `Decimal`'s or a 128-bit width's. The head defines
/// a release for each.
pub fn scalar_box_words() -> List<Int> = [2]

/// The counted parts of each part of a value of `ty` held as `rep`, in `parts_of(rep)`'s order, each
/// counted from that part's own first C word: a word form's; a sum's words; a flat record's leaves
/// by their fields' types, a sum leaf its words.
/// `laid_of` and `form_of` read a type's layout and word form.
pub fn held_parts_with(
  ctors: Ctors,
  ty: Type,
  rep: Representation,
  laid_of: (Type) -> ValueLayout / {abort.raise},
  form_of: (Type) -> WordForm / {abort.raise},
) -> List<List<Part>> / {abort.raise} =
  match rep {
    AsWord -> [form_parts_of(ctors, ty, form_of(ty), laid_of(ty))],
    AsSum(s) -> [sum_parts(ctors, ty, s.layout, 0)],
    AsFlattened(ls) ->
      ls.map(|l: Leaf| {
        let lty = leaf_type(ty, l.name);
        match l.representation {
          AsWord -> form_parts_of(ctors, lty, form_of(lty), laid_of(lty)),
          AsSum(s) -> sum_parts(ctors, lty, s.layout, 0),
          _ -> [],
        }
      }),
    AsListView -> [[whole(ty)], []],
    _ -> parts_of(rep).map(|_: Representation| []),
  }

/// `held_parts_with` over the program's constructors.
pub fn held_parts(ctors: Ctors, ty: Type, rep: Representation) -> List<List<Part>> / {abort.raise} =
  held_parts_with(ctors, ty, rep, |t: Type| representations::layout_of(ctors, t), |t: Type|
    representations::word_form(ctors, t))

/// The type of the leaf of a flat record of `ty` that `name` names: a field, `field.leaf` a leaf of
/// a record held in place.
fn leaf_type(ty: Type, name: Bytes) -> Type / {abort.raise} =
  name.split(b".").fold(ty, |t: Type, field: Bytes|
    match record_fields(t) {
      Some(fs) -> match field_get(fs, field) {
        Some(f) -> f,
        None -> refused(b"a leaf of no field", t),
      },
      None -> refused(b"a leaf of no record", t),
    })

/// The counted parts of a block's held part `h`, read where the block holds it: a sum laid in place,
/// or one word holding its type's word form.
pub fn stored_parts(ctors: Ctors, h: BlockPart) -> List<Part> / {abort.raise} =
  match h.representation {
    AsSum(s) -> sum_parts(ctors, h.ty, s.layout, 0),
    _ -> form_parts(ctors, h.ty),
  }

/// What the block a value of `ty` held as `rep` is held in holds: a box case of a sum's where `rep`
/// holds that box alone (`boxed_case_rep`), else the block of `ty`'s word. `laid_of` and `form_of` read a
/// type's layout and word form. Raises for a sum of one word, whose word is no block of its own.
pub fn contents_with(
  ctors: Ctors,
  ty: Type,
  rep: Representation,
  laid_of: (Type) -> ValueLayout / {abort.raise},
  form_of: (Type) -> WordForm / {abort.raise},
) -> BlockContents / {abort.raise} =
  match rep {
    AsSum(s) -> match ((boxed_alone(s.layout), s.cases)) {
      (Some(b), [name]) -> case_box_contents(ctors, ty, args_named(ctors, ty, name), b, laid_of),
      _ -> refused(b"a sum opened as a block that holds no box alone", ty),
    },
    _ -> if function_valued(ty) { ClosureBlock } else {
      match ty {
        NamedType(c) -> named_contents(ctors, ty, c.name, c.args, laid_of, form_of),
        _ -> in_box(ctors, ty, laid_of),
      }
    },
  }

/// `contents_with` over the program's constructors.
pub fn block_contents(
  ctors: Ctors,
  ty: Type,
  rep: Representation,
) -> BlockContents / {abort.raise} =
  contents_with(ctors, ty, rep, |t: Type| representations::layout_of(ctors, t), |t: Type|
    representations::word_form(ctors, t))

/// The arguments' types of the case of the sum `ty` the table names `name`.
fn args_named(ctors: Ctors, ty: Type, name: Bytes) -> List<Type> / {abort.raise} =
  match cases_of(ctors, ty).filter(|c: { name: Bytes, args: List<Type> }| c.name == name) {
    [c] -> c.args,
    _ -> refused(Bytes::concat_all([b"no one case named ", name, b" of the sum"]), ty),
  }

/// The root doing `op` to the block a value of `ty` held as `rep` is held in: its boxed case's where
/// `rep` holds that box alone, else its type's.
pub fn held_root(
  op: keys::TypeOp,
  ctors: Ctors,
  ty: Type,
  rep: Representation,
) -> RootKey / {abort.raise} =
  match rep {
    AsSum(s) -> match ((boxed_alone(s.layout), s.cases)) {
      (Some(_), [name]) -> {
        let names = cases_of(ctors, ty).map(|c: { name: Bytes, args: List<Type> }| c.name);
        case_root(
          op,
          ty,
          range(0, names.len()).fold(0, |at: Int, i: Int|
            if names.at(i) == Some(name) { i } else { at }),
        )
      },
      _ -> root_of(op, ty),
    },
    _ -> root_of(op, ty),
  }

fn named_contents(
  ctors: Ctors,
  ty: Type,
  name: Bytes,
  args: List<Type>,
  laid_of: (Type) -> ValueLayout / {abort.raise},
  form_of: (Type) -> WordForm / {abort.raise},
) -> BlockContents / {abort.raise} = {
  let arg = |i: Int|
    match args.at(i) { Some(t) -> t, None -> refused(b"a type short of arguments", ty) };
  // A list's item lies in its node as an array's element does.
  let lies = |t: Type| by_pointer(laid_of(t));
  let element = |t: Type| layout_parts(ctors, t, lies(t), 0);
  let stride = |t: Type| max(1, words(lies(t)));
  if name == string_name() || name == bytes_name() { BytesBlock } else if name == list_name() {
    ListOf({ node: drop_of(list_node_type(arg(0))), item: element(arg(0)), stride: stride(arg(0)) })
  } else if name == list_node_name() {
    ListNodeOf({ node: drop_of(ty), item: element(arg(0)), stride: stride(arg(0)) })
  } else if name == map_name() { MapOf(drop_of(map_node_type(arg(0), arg(1)))) }
  else if name == known::map_node_name() {
    MapNodeOf({
      node: drop_of(ty),
      key: element(arg(0)),
      value: element(arg(1)),
      key_words: stride(arg(0)),
      value_words: stride(arg(1)),
    })
  } else if name == array_name() {
    let l = by_pointer(laid_of(arg(0)));
    ArrayOf({ element: layout_parts(ctors, arg(0), l, 0), stride: max(1, words(l)) })
  } else if name == columns_name() {
    ColumnsOf(field_types(arg(0)).map(|t: Type| drop_of(array_type(t))))
  } else if name == hold_name() {
    // The checker lays a hold's region label first and the type it holds last.
    HoldContents({ at: hold_layout().held, ty: arg(args.len() - 1), representation: AsWord })
  } else if runtime_handle(name) { HandleBlock }
  else if name == representations::parallel_results_name() {
    BoxContents({
      parts: range(0, args.len()).fold([], |acc: List<BlockPart>, i: Int|
        if form_parts_of(ctors, arg(i), form_of(arg(i)), laid_of(arg(i))) == [] { acc }
        else { acc.push({ at: i, ty: arg(i), representation: AsWord }) }),
      words: args.len(),
    })
  } else if ctors.sums.contains(name) { in_box(ctors, ty, laid_of) } else {
    match form_of(ty) {
      RuntimeBox -> ScalarBox(words(laid_of(ty))),
      _ -> refused(b"a block of a type that lays no block, sum or handle", ty),
    }
  }
}

/// The box a value of `ty` is held in, its type laying it as `laid_of` says.
fn in_box(
  ctors: Ctors,
  ty: Type,
  laid_of: (Type) -> ValueLayout / {abort.raise},
) -> BlockContents / {abort.raise} = {
  let l = laid_of(ty);
  BoxContents({ parts: held_in(ctors, ty, l, 0, laid_of), words: words(l) })
}

/// Whether a value in a block laid as `o` is never kept, so keeping it answers 0 before anything is
/// copied and a keep that starts copying always finishes: the block is, or reaches through any word
/// of any case of what it holds, a task, a channel or a secret, a hold, or a function value. A handle
/// and a hold may not outlive the entry that made them, and whether a function value may is known
/// only from the captures it holds, so a value reaching one is not kept. A function value's own
/// block is kept by its descriptor, which reads its captures' types alike. Past the block's own words
/// it reads what the program's sums hold off the constructor table (`representations.holds_unkept`), so a keep
/// walks no type its value reaches.
pub fn never_kept(ctors: Ctors, o: BlockContents) -> Bool / {abort.raise} = {
  let first = contents_reach(ctors, o);
  first.found || first.types.any(|t: Type| representations::holds_unkept(ctors, t))
}

/// What a value reaches of what is never kept, read off its own block or its type's: whether it
/// holds one itself, and the types of the blocks and sums its words name, which may.
type Reach = { found: Bool, types: List<Type> }

fn reached(a: Reach, b: Reach) -> Reach =
  { found: a.found || b.found, types: a.types.concat(b.types) }

/// `Reach` of a block laid as `o`.
fn contents_reach(ctors: Ctors, o: BlockContents) -> Reach / {abort.raise} = {
  let none = { found: false, types: [] };
  let root = |k: RootKey| match k { Generated(w, _) -> { found: false, types: [w.ty] }, _ -> none };
  match o {
    HandleBlock -> { found: true, types: [] },
    HoldContents(_) -> { found: true, types: [] },
    BoxContents(b) ->
      b.parts.fold(none, |acc: Reach, h: BlockPart|
        reached(acc, parts_reach(stored_parts(ctors, h)))),
    ListOf(l) -> parts_reach(l.item),
    ListNodeOf(n) -> parts_reach(n.item),
    MapOf(k) -> root(k),
    MapNodeOf(m) -> reached(parts_reach(m.key), parts_reach(m.value)),
    ArrayOf(a) -> parts_reach(a.element),
    ColumnsOf(ks) -> ks.fold(none, |acc: Reach, k: RootKey| reached(acc, root(k))),
    InlineSum(s) -> { found: false, types: [s.ty] },
    _ -> none,
  }
}

/// `Reach` of `parts`, in every case a sum among them may hold: a runtime handle or a function value
/// found, and each type a word is counted at.
fn parts_reach(parts: List<Part>) -> Reach =
  parts.fold({ found: false, types: [] }, |acc: Reach, p: Part|
    reached(acc, match p {
      WordAt(w) -> match w.how {
        RuntimeHandle -> { found: true, types: [] },
        ThroughDescriptor -> { found: true, types: [] },
        Object(k) -> match k {
          Generated(x, _) -> { found: false, types: [x.ty] },
          _ -> { found: false, types: [] },
        },
        SumWord(k) -> match k {
          Generated(x, _) -> { found: false, types: [x.ty] },
          _ -> { found: false, types: [] },
        },
        ScalarWord(_) -> { found: false, types: [] },
        CaseBox(c) -> { found: false, types: [c.sum] },
      },
      ByCase(c) ->
        c.cases.fold(
          { found: false, types: [] },
          |a: Reach, k: { case: Int, parts: List<Part> }| reached(a, parts_reach(k.parts)),
        ),
    }))

/// The box a case of the sum `sum` of arguments `args` is boxed in as `b` says.
fn case_box_contents(
  ctors: Ctors,
  sum: Type,
  args: List<Type>,
  b: { at: Int, stripped: Bool, skip: Int, layout: ValueLayout },
  laid_of: (Type) -> ValueLayout / {abort.raise},
) -> BlockContents / {abort.raise} =
  BoxContents({
    parts: payload_held(ctors, args, b.layout, b.skip, sum, laid_of),
    words: b.skip + words(b.layout),
  })

/// The counted parts of a value of `ty` laid as `l` from word `at`, as a body holds them: each
/// pointer as a word, and each sum that counts whole, held as `laid_of` lays its type: inside a box
/// of its own recursion group `l` gives only its words' classes, and its cases lay any member of the
/// group so.
/// The counted parts of a value of `ty` held as `rep`, its C values laid in a block from word `at`:
/// its word form where it is held as a word, else what its type lays there.
pub fn held_at(
  ctors: Ctors,
  ty: Type,
  rep: Representation,
  at: Int,
) -> List<BlockPart> / {abort.raise} =
  if rep == AsWord { [{ at: at, ty: ty, representation: AsWord }] } else {
    held_in(ctors, ty, representations::layout_of(ctors, ty), at, |t: Type|
      representations::layout_of(ctors, t))
  }

fn held_in(
  ctors: Ctors,
  ty: Type,
  l: ValueLayout,
  at: Int,
  laid_of: (Type) -> ValueLayout / {abort.raise},
) -> List<BlockPart> / {abort.raise} =
  if !holds_count(l) { [] } else {
    match l {
      RecordFields(fs) -> fields_held(ctors, field_types(ty), fs, at, ty, laid_of),
      InlineRecord(r) -> held_in(ctors, ty, r, at + 1, laid_of),
      _ -> match ty {
        NamedType(c) -> if ctors.sums.contains(c.name) {
          match laid_of(ty) {
            SumCases(s) -> [{ at: at, ty: ty, representation: sum_rep(ctors, ty, s) }],
            _ -> refused(b"a sum laid as no sum", ty),
          }
        } else {
          match l {
            SumCases(s) -> [{ at: at, ty: ty, representation: sum_rep(ctors, ty, s) }],
            PlainWords(cs) -> pointers_held(ty, cs, at),
            _ -> [],
          }
        },
        _ -> match l { PlainWords(cs) -> pointers_held(ty, cs, at), _ -> [] },
      },
    }
  }

fn pointers_held(ty: Type, cs: List<WordClass>, at: Int) -> List<BlockPart> =
  range(0, cs.len()).fold([], |acc: List<BlockPart>, i: Int|
    match cs.at(i) {
      Some(Pointer) -> acc.push({ at: at + i, ty: ty, representation: AsWord }),
      _ -> acc,
    })

fn fields_held(
  ctors: Ctors,
  tys: List<Type>,
  fs: List<FieldLayout>,
  at: Int,
  of: Type,
  laid_of: (Type) -> ValueLayout / {abort.raise},
) -> List<BlockPart> / {abort.raise} =
  fs.fold({ i: 0, out: [] }, |acc: { i: Int, out: List<BlockPart> }, f: FieldLayout|
    match tys.at(acc.i) {
      Some(t) ->
        { i: acc.i + 1, out: acc.out.concat(held_in(ctors, t, f.layout, at + f.at, laid_of)) },
      None -> refused(b"a layout of more fields than its type has", of),
    }).out

fn payload_held(
  ctors: Ctors,
  args: List<Type>,
  l: ValueLayout,
  at: Int,
  sum: Type,
  laid_of: (Type) -> ValueLayout / {abort.raise},
) -> List<BlockPart> / {abort.raise} =
  match l {
    RecordFields(fs) -> if fs.len() == args.len() { fields_held(ctors, args, fs, at, sum, laid_of) }
    else { refused(b"a case laid out other than as its arguments", sum) },
    _ -> refused(b"a case laid out other than as a record of its arguments", sum),
  }

/// How a sum of `ty` laid as `s` is held: its words, its cases as the table names them.
pub fn sum_rep(ctors: Ctors, ty: Type, s: SumLayout) -> Representation / {abort.raise} =
  AsSum({
    layout: s,
    cases: cases_of(ctors, ty).map(|c: { name: Bytes, args: List<Type> }| c.name),
  })

// --- Plain roots ---------------------------------------------------------------------------------

/// Root `k`, an operation a plain root does for a type: `drop#T`, `dup#T` or `release#T`, over the
/// program's constructors.
pub fn generated(ctors: Ctors, k: RootKey) -> Fn / {abort.raise} =
  generated_with(ctors, k, |t: Type| representations::layout_of(ctors, t), |t: Type|
    representations::word_form(ctors, t))

/// `generated`, `laid_of` and `form_of` reading a type's layout and word form. Panics over an
/// operation no plain root does, which no body asks for.
pub fn generated_with(
  ctors: Ctors,
  k: RootKey,
  laid_of: (Type) -> ValueLayout / {abort.raise},
  form_of: (Type) -> WordForm / {abort.raise},
) -> Fn / {abort.raise} =
  match k {
    Generated(w, _) -> match w.op {
      Drop -> dropped(ctors, k, w.ty, laid_of, form_of),
      Dup -> duped(k, w.ty),
      keys::Release -> released(k, w.ty),
      keys::Unboxed(o) -> match o {
        Dup -> held_duped(ctors, k, w.ty),
        keys::Release -> held_released(ctors, k, w.ty),
        _ -> panic("a root over a held value that counts nothing"),
      },
      Copy -> walk_root(k, { id: 0, ty: w.ty, representation: AsWord }, Copy),
      Share -> walk_root(k, walk_param(ctors, w.ty, laid_of), Share),
      Keep -> walk_root(k, walk_param(ctors, w.ty, laid_of), Keep),
      keys::OnCase(c) -> match laid_of(w.ty) {
        SumCases(s) -> match boxed_case_rep(ctors, w.ty, s, c.case) {
          None -> panic("a root of a case its sum does not box"),
          Some(rep) -> match c.op {
            Drop -> case_dropped(ctors, k, w.ty, c.case, laid_of, form_of),
            Share -> walk_root(k, { id: 0, ty: w.ty, representation: rep }, Share),
            Keep -> walk_root(k, { id: 0, ty: w.ty, representation: rep }, Keep),
            _ -> panic("a root of a boxed case no plain root does"),
          },
        },
        _ -> panic("a root of a boxed case of what is no sum"),
      },
      _ -> panic("a plain root of an operation no plain root does"),
    },
    _ -> panic("a plain root of what is no type's operation"),
  }

/// How a share or keep root of `ty` takes its value: a sum of one word as its word, whose case the
/// walk reads, anything else as the block its word names.
fn walk_param(
  ctors: Ctors,
  ty: Type,
  laid_of: (Type) -> ValueLayout / {abort.raise},
) -> Var / {abort.raise} =
  match one_word_sum(ctors, ty, laid_of) {
    Some(s) -> { id: 0, ty: ty, representation: sum_rep(ctors, ty, s) },
    None -> { id: 0, ty: ty, representation: AsWord },
  }

/// `copy#T`, `share#T` or `keep#T`, keyed `k`, of `o`: its block walked as `op` does. A copy takes
/// the block and answers its copy; a share borrows it and answers whether it may cross threads; a
/// keep borrows it and answers it kept for good, or 0, with nothing walked or copied, where its type
/// is `never_kept`: it is or reaches a runtime handle, a hold or a function value.
fn walk_root(k: RootKey, o: Var, op: keys::TypeOp) -> Fn = {
  let shares = op == Share;
  let c = {
    id: 1,
    ty: if shares { int_type() } else { o.ty },
    representation: if shares { AsInt } else { AsWord },
  };
  let f = plain(k, o, if op == Copy { OwnedParam } else { BorrowedParam }, [
    Let({ var: c, val: WalkLoop({ of: o, op: op }), at: dummy_span(), unwind: [] }),
    Return(VarOperand(c)),
  ]);
  { ..f, convention: { ..f.convention, result: c.representation } }
}

/// A plain root keyed `k` of the one parameter `param`, taken as `handed`, answering a word.
fn plain(k: RootKey, param: Var, handed: ParamOwnership, body: List<Inst>) -> Fn =
  {
    key: k,
    kind: Plain,
    params: [param],
    convention: {
      params: [{ handed: handed, representation: param.representation }],
      result: AsWord,
      destination_passing: false,
      answered: OwnedResult,
    },
    result_type: plain_result_type(k),
    body: body,
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  }

/// What the plain root keyed `k` answers: whether a share may cross, a dup's, copy's or keep's value,
/// and nothing for a drop or a release.
fn plain_result_type(k: RootKey) -> Type =
  match k {
    Generated(w, _) -> match w.op {
      Share -> int_type(),
      Dup -> w.ty,
      Copy -> w.ty,
      Keep -> w.ty,
      keys::OnCase(c) -> match c.op { Share -> int_type(), Keep -> w.ty, _ -> unit_type() },
      keys::Unboxed(o) -> if o == Dup { w.ty } else { unit_type() },
      _ -> unit_type(),
    },
    _ -> unit_type(),
  }

fn return_nothing() -> Inst = Return(ZeroOperand(AsWord))

/// `drop#T`: handed a block whose last count was taken, it lets go of what the block holds and
/// gives the block back; for a sum of one word, handed the word, the block of the case it holds.
/// Raises at a scalar's type: its box holds nothing counted, so nothing asks a root to give it back.
fn dropped(
  ctors: Ctors,
  k: RootKey,
  ty: Type,
  laid_of: (Type) -> ValueLayout / {abort.raise},
  form_of: (Type) -> WordForm / {abort.raise},
) -> Fn / {abort.raise} =
  match one_word_sum(ctors, ty, laid_of) {
    Some(s) -> sum_dropped(ctors, k, ty, s, laid_of, form_of),
    None -> {
      let o = { id: 0, ty: ty, representation: AsWord };
      match contents_with(ctors, ty, AsWord, laid_of, form_of) {
        ScalarBox(_) -> refused(b"a scalar's box is given back by its size, by no drop root", ty),
        opened ->
          plain(k, o, OwnedParam, block_dropped(o, opened, 1, o).body.push(return_nothing())),
      }
    },
  }

/// The drop root, keyed `k`, of the box case `case` of the sum `sum` is held in: handed the box whose
/// last count was taken, it lets go of the case's arguments and gives the box back.
pub fn case_dropped(
  ctors: Ctors,
  k: RootKey,
  sum: Type,
  case: Int,
  laid_of: (Type) -> ValueLayout / {abort.raise},
  form_of: (Type) -> WordForm / {abort.raise},
) -> Fn / {abort.raise} =
  match laid_of(sum) {
    SumCases(s) -> match boxed_case_rep(ctors, sum, s, case) {
      Some(rep) -> {
        let o = { id: 0, ty: sum, representation: rep };
        plain(
          k,
          o,
          OwnedParam,
          block_dropped(o, contents_with(ctors, sum, rep, laid_of, form_of), 1, o).body.push(
            return_nothing(),
          ),
        )
      },
      None -> refused(Bytes::concat_all([b"case ", ascii_of_int(case), b" is not boxed"]), sum),
    },
    _ -> refused(b"a boxed case of no sum", sum),
  }

/// How a sum of `ty` is laid, where `ty` is a declared sum of one word.
fn one_word_sum(
  ctors: Ctors,
  ty: Type,
  laid_of: (Type) -> ValueLayout / {abort.raise},
) -> Option<SumLayout> / {abort.raise} =
  match ty {
    NamedType(c) -> if !ctors.sums.contains(c.name) { None } else {
      match laid_of(ty) {
        SumCases(s) -> if s.classes.len() == 1 { Some(s) } else { None },
        _ -> None,
      }
    },
    _ -> None,
  }

/// What lets go of what block `b`, held only here and opened as `o` says, holds, its memory given
/// back: its counted parts bound as owned, numbered from `next`, and each let go of; but the last
/// held as `root` is, which is let go of by starting the root again on it where its count was the
/// last, so a chain of them is let go of in a loop.
fn block_dropped(
  b: Var,
  o: BlockContents,
  next: Int,
  root: Var,
) -> { body: List<Inst>, next: Int } = {
  let held = match o { BoxContents(x) -> x.parts, HoldContents(h) -> [h], _ -> [] };
  let ws = range(0, held.len()).fold([], |acc: List<Var>, i: Int|
    match held.at(i) {
      Some(h) -> acc.push({ id: next + i, ty: h.ty, representation: h.representation }),
      None -> acc,
    });
  let again = range(0, ws.len()).fold(None, |found: Option<Int>, i: Int|
    match ws.at(i) {
      Some(w) -> if w.ty == root.ty && w.representation == root.representation { Some(i) }
      else { found },
      None -> found,
    });
  let n = { id: next + ws.len(), ty: root.ty, representation: root.representation };
  let decs = range(0, ws.len()).fold([], |acc: List<Inst>, i: Int|
    if again == Some(i) { acc }
    else { match ws.at(i) { Some(w) -> acc.push(Dec(w)), None -> acc } });
  let looped = match again {
    Some(i) -> match ws.at(i) {
      Some(c) ->
        [
          Let({ var: n, val: IfUnique(c), at: dummy_span(), unwind: [] }),
          If({ cond: VarOperand(n), then: [Restart([VarOperand(n)])], otherwise: [] }),
        ],
      None -> [],
    },
    None -> [],
  };
  { body: [Destructure({ of: b, words: ws })].concat(decs).concat(looped), next: n.id + 1 }
}

/// The drop root of a sum of one word laid as `s`, handed the word whose case's block lost its last
/// count: `by_case_dropped` of it.
fn sum_dropped(
  ctors: Ctors,
  k: RootKey,
  ty: Type,
  s: SumLayout,
  laid_of: (Type) -> ValueLayout / {abort.raise},
  form_of: (Type) -> WordForm / {abort.raise},
) -> Fn / {abort.raise} = {
  let o = { id: 0, ty: ty, representation: sum_rep(ctors, ty, s) };
  plain(k, o, OwnedParam, [
    by_case_dropped(ctors, o, s, 1, o, inline_sum_depth(), laid_of, form_of).inst,
  ])
}

/// How many sums deep a word lays sums in place at most: each nested one takes values of the
/// word's niche, which holds far fewer.
fn inline_sum_depth() -> Int = 64

/// What lets go of the block the case of `on`, a sum of one word laid as `s`, holds: each case's arm
/// renames the word as that block (unless the word is that block alone) and lets go of what it
/// holds, starting the root again on a sum of `root`'s type held there last; or, where the case lays
/// a sum of one word in place, renames the word as that sum and does so by its case in turn, `depth`
/// sums deep at most. New variables are numbered from `next`.
fn by_case_dropped(
  ctors: Ctors,
  on: Var,
  s: SumLayout,
  next: Int,
  root: Var,
  depth: Int,
  laid_of: (Type) -> ValueLayout / {abort.raise},
  form_of: (Type) -> WordForm / {abort.raise},
) -> { inst: Inst, next: Int } / {abort.raise} =
  if depth <= 0 { refused(b"sums laid in place deeper than a word has room for", on.ty) } else {
    let declared = cases_of(ctors, on.ty);
    let names = declared.map(|c: { name: Bytes, args: List<Type> }| c.name);
    let arms = range(0, s.cases.len()).fold(
      { next: next, arms: [] },
      |acc: { next: Int, arms: List<{ when: Int, body: List<Inst> }> }, c: Int|
        match s.cases.at(c) {
          None -> acc,
          Some(laid) -> match case_block(
              ctors,
              on.ty,
              s,
              c,
              args_at(declared, c),
              laid.payload,
              laid_of,
              form_of,
            ) {
            None -> acc,
            Some(blk) -> match blk.opening {
              InlineSum(inner) -> {
                let w = { id: acc.next, ty: blk.ty, representation: blk.representation };
                let d = by_case_dropped(
                  ctors,
                  w,
                  inner.layout,
                  acc.next + 1,
                  root,
                  depth - 1,
                  laid_of,
                  form_of,
                );
                {
                  next: d.next,
                  arms: acc.arms.push({
                    when: c,
                    body: [Destructure({ of: on, words: [w] }), d.inst],
                  }),
                }
              },
              block_contents -> {
                let alone = match boxed_alone(s) { Some(_) -> true, None -> false };
                let b = if alone { on }
                else { { id: acc.next, ty: blk.ty, representation: blk.representation } };
                let d = block_dropped(
                  b,
                  block_contents,
                  if alone { acc.next } else { acc.next + 1 },
                  root,
                );
                let renamed = if alone { [] } else { [Destructure({ of: on, words: [b] })] };
                {
                  next: d.next,
                  arms: acc.arms.push({
                    when: c,
                    body: renamed.concat(d.body).push(return_nothing()),
                  }),
                }
              },
            },
          },
        },
    );
    // A case holding no block is a word holding no count, which a drop root is never handed: letting
    // it go there does nothing, and leaves the root holding nothing where it answers.
    {
      inst: Case({
        on: on,
        test: TagTest(names),
        arms: arms.arms,
        rest: [Dec(on), return_nothing()],
      }),
      next: arms.next,
    }
  }

/// The block of each case of the sum of one word `ty`, laid as `s`, that holds one, as
/// `case_block` gives it, over the program's constructors.
pub fn case_blocks(
  ctors: Ctors,
  ty: Type,
  s: SumLayout,
) -> List<{ case: Int, ty: Type, representation: Representation, opening: BlockContents }> / {abort.raise} = {
  let declared = cases_of(ctors, ty);
  range(0, s.cases.len()).fold(
    [],
    |acc: List<{ case: Int, ty: Type, representation: Representation, opening: BlockContents }>, c: Int|
      match s.cases.at(c) {
        None -> acc,
        Some(laid) -> match case_block(
            ctors,
            ty,
            s,
            c,
            args_at(declared, c),
            laid.payload,
            |t: Type| representations::layout_of(ctors, t),
            |t: Type| representations::word_form(ctors, t),
          ) {
          None -> acc,
          Some(b) ->
            acc.push({ case: c, ty: b.ty, representation: b.representation, opening: b.opening }),
        },
      },
  )
}

/// The block the sum of one word `ty`, laid as `s`, holds in case `c`, of arguments `args`, laid as
/// `p`: how a body holds it and what it holds; the case's box, the object of the pointer it lays in
/// place, or a sum of one word it lays in place, whose own case holds the block; none for a case
/// holding no count.
fn case_block(
  ctors: Ctors,
  ty: Type,
  s: SumLayout,
  c: Int,
  args: List<Type>,
  p: Payload,
  laid_of: (Type) -> ValueLayout / {abort.raise},
  form_of: (Type) -> WordForm / {abort.raise},
) -> Option<{ ty: Type, representation: Representation, opening: BlockContents }> / {abort.raise} =
  match p {
    Nullary -> None,
    Boxed(b) -> match boxed_case_rep(ctors, ty, s, c) {
      Some(rep) ->
        Some({
          ty: ty,
          representation: rep,
          opening: case_box_contents(ctors, ty, args, b, laid_of),
        }),
      None -> None,
    },
    Inline(i) -> match payload_held(ctors, args, i.layout, i.offset, ty, laid_of) {
      [] -> None,
      [h] -> match h.representation {
        AsSum(x) ->
          Some({
            ty: h.ty,
            representation: h.representation,
            opening: InlineSum({ ty: h.ty, layout: x.layout }),
          }),
        _ ->
          Some({
            ty: h.ty,
            representation: AsWord,
            opening: contents_with(ctors, h.ty, AsWord, laid_of, form_of),
          }),
      },
      _ -> refused(b"a sum of one word laying several pointers in place", ty),
    },
  }

/// `dup#T`: counts a word form of `T` once more and answers it.
fn duped(k: RootKey, ty: Type) -> Fn = {
  let o = { id: 0, ty: ty, representation: AsWord };
  plain(k, o, BorrowedParam, [Inc({ var: o, n: 1 }), Return(VarOperand(o))])
}

/// `release#T`: lets go of a word form of `T`.
fn released(k: RootKey, ty: Type) -> Fn = {
  let o = { id: 0, ty: ty, representation: AsWord };
  plain(k, o, OwnedParam, [Dec(o), return_nothing()])
}

/// `held_dup#T`: counts a value of `T` held as a body holds it once more, each counted word of it,
/// and answers it, so the count it took is its caller's.
fn held_duped(ctors: Ctors, k: RootKey, ty: Type) -> Fn = {
  let o = { id: 0, ty: ty, representation: representation_with(ctors, ty) };
  let f = plain(k, o, BorrowedParam, [Inc({ var: o, n: 1 }), Return(VarOperand(o))]);
  { ..f, convention: { ..f.convention, result: o.representation } }
}

/// `held_release#T`: lets go of a value of `T` held as a body holds it, each counted word of it.
fn held_released(ctors: Ctors, k: RootKey, ty: Type) -> Fn = {
  let o = { id: 0, ty: ty, representation: representation_with(ctors, ty) };
  plain(k, o, OwnedParam, [Dec(o), return_nothing()])
}

/// The root that can count a value of `ty` held as `rep` once more (`op` `Dup`) or once fewer
/// (`Release`) in one call, where counting it word by word takes more than one word's count: a
/// case's switch or two words. None where `rep` is not how a body holds `ty`, so the root written for
/// the type could not take it as it is, or where a variable leaves `ty`'s layout open.
pub fn counted_through(
  op: keys::TypeOp,
  ctors: Ctors,
  ty: Type,
  rep: Representation,
) -> Option<RootKey> / {abort.raise} = {
  let several = match rep { AsFlattened(_) -> true, AsSum(_) -> true, _ -> false };
  if !several || representations::has_vars(ty) || representation_with(ctors, ty) != rep { None }
  else if held_parts(ctors, ty, rep).fold(0, |n: Int, ps: List<Part>| n + counts_in(ps)) < 2 {
    None
  } else { Some(root_of(keys::Unboxed(op), ty)) }
}

/// How many words' counts the C counting `parts` holds, a case's switch as two.
fn counts_in(parts: List<Part>) -> Int =
  parts.fold(0, |n: Int, p: Part| n + (match p { WordAt(_) -> 1, ByCase(_) -> 2 }))

fn named(n: Bytes) -> Type = NamedType({ name: n, args: [] })

fn applied(n: Bytes, args: List<Type>) -> Type = NamedType({ name: n, args: args })

fn raw() -> WordClass = RawRange({ lo: 0, hi: 1 })

fn object(ty: Type, at: Int) -> Part = WordAt({ at: at, masked: false, how: Object(drop_of(ty)) })

/// `Option`, `m.L = | Nil | Cons(Int, m.L)` and `m.E = | Num(Int) | Add(m.E, m.E) | Name(String)`.
fn table() -> Ctors =
  ctors_of(
    [],
    [],
    [],
    Map::new().insert(option_name(), [
      { name: none_ctor(), index: 0, fields: [], params: [0] },
      { name: some_ctor(), index: 1, fields: [VariableType(0)], params: [0] },
    ]).insert(b"m.L", [
      { name: b"m.Nil", index: 0, fields: [], params: [] },
      { name: b"m.Cons", index: 1, fields: [int_type(), named(b"m.L")], params: [] },
    ]).insert(b"m.E", [
      { name: b"m.Num", index: 0, fields: [int_type()], params: [] },
      { name: b"m.Add", index: 1, fields: [named(b"m.E"), named(b"m.E")], params: [] },
      { name: b"m.Name", index: 2, fields: [string_type()], params: [] },
    ]).insert(b"m.A", [{ name: b"m.A", index: 0, fields: [named(b"m.B")], params: [] }]).insert(
      b"m.B",
      [
        { name: b"m.Stop", index: 0, fields: [], params: [] },
        { name: b"m.More", index: 1, fields: [named(b"m.A")], params: [] },
      ],
    ).insert(b"m.R", [
      { name: b"m.Done", index: 0, fields: [], params: [] },
      { name: b"m.Text", index: 1, fields: [string_type()], params: [] },
    ]).insert(b"m.T", [
      { name: b"m.Hello", index: 0, fields: [], params: [] },
      { name: b"m.Bye", index: 1, fields: [], params: [] },
      { name: b"m.Respond", index: 2, fields: [named(b"m.R")], params: [] },
    ]).insert(b"m.Hue", [
      { name: b"m.Red", index: 0, fields: [], params: [] },
      { name: b"m.Blue", index: 1, fields: [], params: [] },
    ]),
  )

/// `table()` with sums that reach what is never kept, or seem to: `m.Job = | Idle | Run(Task<Int>)`,
/// the generic `m.Pair<a, b> = | Pair(a, List<b>)` and `m.Ghost<a> = | Ghost(Int)`, which holds no
/// value of `a`, `m.Deep = | Deep(m.Pair<Int, m.Job>)`, `m.Loop = | End | Again(m.Loop, Hold<Int>)`
/// and `m.Act = | Act({ run: (Int) -> Int })`.
fn reaching() -> Ctors = {
  let t = table();
  let a = VariableType(0);
  let b = VariableType(1);
  ctors_of(
    [],
    [],
    [],
    t.sums.insert(b"m.Job", [
      { name: b"m.Idle", index: 0, fields: [], params: [] },
      { name: b"m.Run", index: 1, fields: [task_type(int_type())], params: [] },
    ]).insert(b"m.Pair", [
      { name: b"m.Pair", index: 0, fields: [a, list_type(b)], params: [0, 1] },
    ]).insert(b"m.Ghost", [
      { name: b"m.Ghost", index: 0, fields: [int_type()], params: [0] },
    ]).insert(b"m.Deep", [
      {
        name: b"m.Deep",
        index: 0,
        fields: [NamedType({ name: b"m.Pair", args: [int_type(), named(b"m.Job")] })],
        params: [],
      },
    ]).insert(b"m.Loop", [
      { name: b"m.End", index: 0, fields: [], params: [] },
      {
        name: b"m.Again",
        index: 1,
        fields: [named(b"m.Loop"), hold_type(label_type(b"r"), int_type())],
        params: [],
      },
    ]).insert(b"m.Act", [
      {
        name: b"m.Act",
        index: 0,
        fields: [
          RecordType([
            {
              name: b"run",
              ty: FunctionType({
                kept: [],
                once: false,
                params: [int_type()],
                ret: int_type(),
                effects: row_empty(),
              }),
            },
          ]),
        ],
        params: [],
      },
    ]),
  )
}

test "a block reaching a handle, a hold or a function value at any depth is never kept, and only such a block" {
  let t = reaching();
  let con = |name: Bytes, args: List<Type>| NamedType({ name: name, args: args });
  let chan = chan_type(int_type());
  let fun = FunctionType({
    kept: [],
    once: false,
    params: [int_type()],
    ret: int_type(),
    effects: row_empty(),
  });
  let never = [
    list_type(chan),
    map_type(string_type(), fun),
    array_type(RecordType([{ name: b"s", ty: secret_type(string_type()) }])),
    columns_type(RecordType([{ name: b"f", ty: fun }, { name: b"n", ty: int_type() }])),
    option_type(option_type(task_type(int_type()))),
    named(b"m.Job"),
    con(b"m.Pair", [chan, string_type()]),
    con(b"m.Pair", [int_type(), list_type(chan)]),
    named(b"m.Deep"),
    named(b"m.Loop"),
    named(b"m.Act"),
    hold_type(label_type(b"r"), int_type()),
    RecordType([{ name: b"a", ty: named(b"m.E") }, { name: b"b", ty: list_type(named(b"m.Job")) }]),
  ];
  // A phantom parameter holds nothing, and a `Columns` only what its records' fields hold.
  let kept = [
    string_type(),
    list_type(int_type()),
    columns_type(RecordType([{ name: b"n", ty: int_type() }])),
    option_type(string_type()),
    named(b"m.E"),
    named(b"m.A"),
    con(b"m.Pair", [int_type(), string_type()]),
    con(b"m.Ghost", [chan]),
  ];
  let wrong = |tys: List<Type>, expected: Bool|
    tys.filter(|ty: Type| never_kept(t, block_contents(t, ty, AsWord)) != expected).map(
      encode_type,
    );
  assert_eq(wrong(never, true), []);
  assert_eq(wrong(kept, false), [])
}

/// `m.RawRange = | Done | Text(String)`, laid as an `Option` of a pointer is.
fn reply_laid() -> SumLayout = maybe_laid()

/// `m.T = | Hello | Bye | Respond(m.RawRange)`, `Respond`'s `m.RawRange` laid in place in the word.
fn todo_laid() -> SumLayout =
  sum_layout([
    { args: record_layout([]), indirect: false },
    { args: record_layout([]), indirect: false },
    { args: record_layout([SumCases(reply_laid())]), indirect: false },
  ])

/// `m.Hue = | Red | Blue`, a small enum.
fn hue_laid() -> SumLayout =
  sum_layout([
    { args: record_layout([]), indirect: false },
    { args: record_layout([]), indirect: false },
  ])

/// An `Option` of the sum laid as `s`, laid in its word.
fn maybe_of(s: SumLayout) -> SumLayout =
  sum_layout([
    { args: record_layout([]), indirect: false },
    { args: record_layout([SumCases(s)]), indirect: false },
  ])

/// `m.A = | A(m.B)`, whose one case reaches its group through `m.B` and so is boxed at its word.
fn alone_laid() -> SumLayout =
  {
    classes: [Pointer],
    cases: [
      {
        test: Always,
        payload: Boxed({
          at: 0,
          stripped: false,
          skip: 0,
          layout: record_layout([PlainWords([PointerSum(1)])]),
        }),
      },
    ],
  }

fn more_laid() -> SumLayout =
  {
    classes: [PointerSum(1)],
    cases: [
      nothing_or(0, 0),
      {
        test: WordOutside({ at: 0, values: [0] }),
        payload: Boxed({
          at: 0,
          stripped: false,
          skip: 0,
          layout: record_layout([PlainWords([Pointer])]),
        }),
      },
    ],
  }

fn nothing_or(at: Int, value: Int) -> CaseLayout =
  { test: WordIs({ at: at, value: value }), payload: Nullary }

fn maybe_laid() -> SumLayout =
  {
    classes: [PointerSum(1)],
    cases: [
      nothing_or(0, 0),
      {
        test: WordOutside({ at: 0, values: [0] }),
        payload: Inline({
          offset: 0,
          layout: record_layout([PlainWords([Pointer])]),
          stripped: None,
        }),
      },
    ],
  }

/// `m.L`, its own word inside its boxed case laid by its class alone.
fn list_laid() -> SumLayout =
  {
    classes: [PointerSum(1)],
    cases: [
      nothing_or(0, 0),
      {
        test: WordOutside({ at: 0, values: [0] }),
        payload: Boxed({
          at: 0,
          stripped: false,
          skip: 0,
          layout: record_layout([PlainWords([raw()]), PlainWords([PointerSum(1)])]),
        }),
      },
    ],
  }

/// `m.E`: a tag word, and a word its cases lay apart.
fn expr_laid() -> SumLayout = {
  let e = PlainWords([raw(), Mixed]);
  {
    classes: [raw(), Mixed],
    cases: [
      {
        test: WordIs({ at: 0, value: 0 }),
        payload: Inline({
          offset: 1,
          layout: record_layout([PlainWords([raw()])]),
          stripped: None,
        }),
      },
      {
        test: WordIs({ at: 0, value: 1 }),
        payload: Boxed({ at: 1, stripped: false, skip: 0, layout: record_layout([e, e]) }),
      },
      {
        test: WordIs({ at: 0, value: 2 }),
        payload: Inline({
          offset: 1,
          layout: record_layout([PlainWords([Pointer])]),
          stripped: None,
        }),
      },
    ],
  }
}

fn point() -> Type =
  RecordType([
    { name: b"a", ty: string_type() },
    { name: b"b", ty: int_type() },
    {
      name: b"c",
      ty: RecordType([{ name: b"x", ty: list_type(int_type()) }, { name: b"y", ty: int_type() }]),
    },
  ])

fn point_laid() -> ValueLayout =
  record_layout([
    PlainWords([Pointer]),
    PlainWords([raw()]),
    record_layout([PlainWords([Pointer]), PlainWords([raw()])]),
  ])

/// Each type the tests lay out, laid as the layout module would.
fn laid_for(ty: Type) -> ValueLayout / {abort.raise} =
  if ty == point() { point_laid() }
  else if ty == named(b"m.L") { SumCases(list_laid()) }
  else if ty == named(b"m.E") { SumCases(expr_laid()) }
  else if ty == option_type(string_type()) { SumCases(maybe_laid()) }
  else if ty == named(b"m.A") { SumCases(alone_laid()) }
  else if ty == named(b"m.B") { SumCases(more_laid()) }
  else if ty == named(b"m.R") { SumCases(reply_laid()) }
  else if ty == named(b"m.T") { SumCases(todo_laid()) }
  else if ty == named(b"m.Hue") { SumCases(hue_laid()) }
  else if ty == option_type(named(b"m.R")) { SumCases(maybe_of(reply_laid())) }
  else if ty == option_type(named(b"m.Hue")) { SumCases(maybe_of(hue_laid())) }
  else if ty == int_type() || ty == bool_type() { PlainWords([raw()]) }
  else if ty == float_type() { PlainWords([raw()]) }
  else if ty == width_type({ bits: 128, signed: false }) || ty == decimal_type() {
    PlainWords([raw(), raw()])
  } else { PlainWords([Pointer]) }

fn form_for(ty: Type) -> WordForm / {abort.raise} =
  if ty == int_type() || ty == bool_type() || ty == float_type() { Bits }
  else if ty == width_type({ bits: 128, signed: false }) || ty == decimal_type() { RuntimeBox }
  else if ty == point() { Box(3) }
  else if ty == named(b"m.E") { Box(2) }
  else { Itself }

fn generated_here(k: RootKey) -> Fn / {abort.raise} = generated_with(table(), k, laid_for, form_for)

test "a record counts its pointers at their words, a record held in it at its own" {
  let fn_ty = FunctionType({
    kept: [],
    once: false,
    params: [int_type()],
    ret: int_type(),
    effects: row_empty(),
  });
  assert_eq(layout_parts(table(), point(), point_laid(), 0), [
    object(string_type(), 0),
    object(list_type(int_type()), 2),
  ]);
  assert_eq(layout_parts(table(), fn_ty, PlainWords([Pointer]), 3), [
    WordAt({ at: 3, masked: false, how: ThroughDescriptor }),
  ]);
  assert_eq(layout_parts(table(), task_type(int_type()), PlainWords([Pointer]), 0), [
    WordAt({ at: 0, masked: false, how: RuntimeHandle }),
  ]);
  // What a `parallel` block gathers is a box let go of at its drop root, which opens it as each
  // answer's word form: an `Int` counts nothing there.
  let gathered = representations::parallel_results_type([string_type(), int_type()]);
  assert_eq(layout_parts(table(), gathered, PlainWords([Pointer]), 0), [object(gathered, 0)]);
  assert_eq(
    contents_with(table(), gathered, AsWord, laid_for, form_for),
    BoxContents({ parts: [{ at: 0, ty: string_type(), representation: AsWord }], words: 2 }),
  );
  assert_eq(layout_parts(table(), int_type(), PlainWords([raw()]), 0), []);
  // A pointer of a type that lays no block, sum or handle is Ply's own failure, not guessed at.
  let said = |t: Type|
    handle {
      match layout_parts(table(), t, PlainWords([Pointer]), 0) { _ -> b"" }
    } with {
      abort.raise(m) -> Bytes::of_string(m),
    };
  assert(said(named(b"m.Opaque")).contains(unknown_pointer()), None);
  assert(said(representations::word_type()).contains(b"only a key no build makes"), None)
}

test "a sum of one word goes to its own drop root, but as its payload where one case lays a pointer alone" {
  let maybe = option_type(string_type());
  let l = named(b"m.L");
  let sum_word = |root: Type| [WordAt({ at: 0, masked: false, how: SumWord(drop_of(root)) })];
  assert_eq(layout_parts(table(), maybe, SumCases(maybe_laid()), 0), [object(string_type(), 0)]);
  // Nullary values past 0 are no pointers, so the payload's root is reached past the floor alone.
  assert_eq(
    layout_parts(table(), maybe, SumCases({ ..maybe_laid(), classes: [PointerSum(3)] }), 0),
    sum_word(string_type()),
  );
  assert_eq(layout_parts(table(), l, SumCases(list_laid()), 0), sum_word(l));
  assert_eq(layout_parts(table(), l, SumCases({ ..list_laid(), classes: [Pointer] }), 1), [
    object(l, 1),
  ]);
  // Its own word inside its boxed case, laid by its class, is counted by that class.
  assert_eq(layout_parts(table(), l, PlainWords([PointerSum(1)]), 0), sum_word(l))
}

test "a wider sum is let go of by its case, a boxed case at its box's own root" {
  let e = named(b"m.E");
  let by_case = ByCase({
    at: 0,
    sum: expr_laid(),
    cases: [
      { case: 1, parts: [WordAt({ at: 1, masked: false, how: CaseBox({ sum: e, case: 1 }) })] },
      { case: 2, parts: [object(string_type(), 1)] },
    ],
  });
  assert_eq(layout_parts(table(), e, SumCases(expr_laid()), 0), [by_case]);
  let rep = sum_rep(table(), e, expr_laid());
  assert_eq(held_parts_with(table(), e, rep, laid_for, form_for), [[by_case]])
}

test "a stripped word of a case's payload is read with its tag bits clear" {
  let laid = {
    classes: [raw(), PointerSum(1)],
    cases: [
      nothing_or(0, 0),
      {
        test: WordIs({ at: 0, value: 1 }),
        payload: Inline({
          offset: 1,
          layout: record_layout([PlainWords([Pointer])]),
          stripped: Some(1),
        }),
      },
    ],
  };
  let maybe = option_type(string_type());
  assert_eq(layout_parts(table(), maybe, SumCases(laid), 0), [
    ByCase({
      at: 0,
      sum: laid,
      cases: [
        { case: 1, parts: [WordAt({ at: 1, masked: true, how: Object(drop_of(string_type())) })] },
      ],
    }),
  ])
}

test "a word form counts as its type lays it in one word, a scalar's box by its size" {
  let parts = |ty: Type| form_parts_of(table(), ty, form_for(ty), laid_for(ty));
  // A scalar of one word is its own bits, which count nothing.
  assert_eq([int_type(), bool_type(), float_type()].map(parts), [[], [], []]);
  assert_eq(parts(width_type({ bits: 128, signed: false })), [
    WordAt({
      at: 0,
      masked: false,
      how: ScalarWord({ ty: width_type({ bits: 128, signed: false }), words: 2 }),
    }),
  ]);
  // A 128-bit width a record holds is its two words, which count nothing.
  assert_eq(
    layout_parts(
      table(),
      width_type({ bits: 128, signed: false }),
      representations::layout_of(table(), width_type({ bits: 128, signed: false })),
      0,
    ),
    [],
  );
  // A descriptor counts and lets go of such a word form through the head's functions, of a size the
  // head defines one for; a string's through its type's roots.
  assert_eq(
    [
      int_type(),
      float_type(),
      decimal_type(),
      width_type({ bits: 64, signed: false }),
      width_type({ bits: 128, signed: false }),
      bool_type(),
    ].map(|t: Type| word_form_functions(table(), t)),
    [
      Some(immediate_functions()),
      Some(immediate_functions()),
      Some(box_functions(2)),
      Some(immediate_functions()),
      Some(box_functions(2)),
      Some(immediate_functions()),
    ],
  );
  assert_eq(word_form_functions(table(), string_type()), None);
  assert_eq(scalar_box_words(), [2]);
  assert_eq(parts(point()), [object(point(), 0)]);
  assert_eq(parts(string_type()), [object(string_type(), 0)])
}

test "a flat record's leaves count by their fields' types" {
  let flat = AsFlattened([
    { name: b"a", representation: AsWord },
    { name: b"b", representation: AsInt },
    { name: b"c.x", representation: AsWord },
    { name: b"c.y", representation: AsInt },
  ]);
  assert_eq(held_parts_with(table(), point(), flat, laid_for, form_for), [
    [object(string_type(), 0)],
    [],
    [object(list_type(int_type()), 0)],
    [],
  ])
}

test "a box a case is held in alone is a sum of one word whose one case is that one, boxed at it" {
  let e = named(b"m.E");
  let rep = boxed_case_rep(table(), e, expr_laid(), 1);
  assert_eq(
    rep,
    Some(
      AsSum({
        layout: {
          classes: [Pointer],
          cases: [
            {
              test: Always,
              payload: Boxed({
                at: 0,
                stripped: false,
                skip: 0,
                layout: record_layout([PlainWords([raw(), Mixed]), PlainWords([raw(), Mixed])]),
              }),
            },
          ],
        },
        cases: [b"m.Add"],
      }),
    ),
  );
  assert_eq(boxed_case_rep(table(), e, expr_laid(), 0), None);
  // Read off the sum's own rep, with no constructor table, it is the same shape.
  let held = sum_rep(table(), e, expr_laid());
  assert_eq(boxed_case_of(held, 1), rep);
  assert_eq([boxed_case_of(held, 0), boxed_case_of(held, 7), boxed_case_of(AsWord, 1)], [
    None,
    None,
    None,
  ])
}

/// What a drop root's body opens and lets go of, wherever they stand: the words each `Destructure` binds,
/// and each value it lets go of by a `Dec`.
fn dropping(b: Block) -> { opened: List<Var>, decremented: List<Var> } =
  b.fold(
    { opened: [], decremented: [] },
    |acc: { opened: List<Var>, decremented: List<Var> }, i: Inst|
      match i {
        Destructure(o) -> { ..acc, opened: acc.opened.concat(o.words) },
        Dec(v) -> { ..acc, decremented: acc.decremented.push(v) },
        Case(c) ->
          c.arms.fold(
            {
              opened: acc.opened.concat(dropping(c.rest).opened),
              decremented: acc.decremented.concat(dropping(c.rest).decremented),
            },
            |a: { opened: List<Var>, decremented: List<Var> }, arm: { when: Int, body: Block }| {
              let d = dropping(arm.body);
              {
                opened: a.opened.concat(d.opened),
                decremented: a.decremented.concat(d.decremented),
              }
            },
          ),
        _ -> acc,
      },
  )

/// The arm of a drop root's `Case` that a sum's case `k` takes, and its test.
fn arm_of(f: Fn, k: Int) -> Option<{ test: Test, body: Block }> =
  match f.body {
    [Case(c)] ->
      c.arms.fold(
        None,
        |found: Option<{ test: Test, body: Block }>, a: { when: Int, body: Block }|
          if a.when == k { Some({ test: c.test, body: a.body }) } else { found },
      ),
    _ -> None,
  }

test "a box's drop root opens it, binding its counted words, and lets go of each" {
  {
    let f = generated_here(drop_of(point()));
    assert_eq(f.kind, Plain);
    assert_eq(f.convention, {
      params: [{ handed: OwnedParam, representation: AsWord }],
      result: AsWord,
      destination_passing: false,
      answered: OwnedResult,
    });
    let d = dropping(f.body);
    assert_eq(d.opened.map(|v: Var| v.ty), [named(b"String"), applied(b"List", [int_type()])]);
    assert_eq(d.decremented, d.opened)
  }
}

test "a sum whose one case is boxed at its word is that box, opened as it is" {
  {
    let f = generated_here(drop_of(named(b"m.A")));
    match arm_of(f, 0) {
      Some(a) -> {
        let d = dropping(a.body);
        assert_eq(d.opened.map(|v: Var| v.ty), [named(b"m.B")]);
        assert_eq(d.decremented, d.opened)
      },
      None -> assert(false, None),
    }
  }
}

test "a sum of one word whose case lays a sum of one word in place lets go of it by that sum's own case" {
  let reply = named(b"m.R");
  // The inner sum is tested by its own case, not let go of whole, and its `Text`'s string is opened.
  let by_its_case = |b: Block|
    b.any(|i: Inst|
      match i {
        Case(c) ->
          c.on.ty == reply && c.test == TagTest([b"m.Done", b"m.Text"])
            && dropping(
              c.arms.fold([], |acc: Block, a: { when: Int, body: Block }| acc.concat(a.body)),
            ).opened.any(|v: Var| v.ty == string_type()),
        _ -> false,
      });
  // A sum's case holding a sum.
  let todo = named(b"m.T");
  assert_eq(todo_laid().classes.len(), 1);
  {
    let f = generated_here(drop_of(todo));
    match arm_of(f, 2) {
      Some(a) ->
        assert(
          by_its_case(a.body)
            && !a.body.any(|i: Inst| match i { Dec(v) -> v.ty == reply, _ -> false }),
          None,
        ),
      None -> assert(false, None),
    }
  };
  // An `Option` of a counted sum, and of a small enum, which holds no count and so no block.
  {
    let f = generated_here(drop_of(applied(b"Option", [reply])));
    match arm_of(f, 1) { Some(a) -> assert(by_its_case(a.body), None), None -> assert(false, None) }
  };
  let hues = option_type(named(b"m.Hue"));
  assert_eq(case_blocks(table(), hues, maybe_of(hue_laid())), []);
  // A walk of the outer sum goes through the inner sum's own root.
  assert_eq(
    case_blocks(table(), todo, todo_laid()).map(
      |b: { case: Int, ty: Type, representation: Representation, opening: BlockContents }|
        { case: b.case, ty: b.ty, opening: b.opening },
    ),
    [{ case: 2, ty: reply, opening: InlineSum({ ty: reply, layout: reply_laid() }) }],
  )
}

test "a boxed case's drop root holds its sums whole, and a sum of its type there is no chain to loop on" {
  let e = named(b"m.E");
  let boxed = match boxed_case_rep(table(), e, expr_laid(), 1) { Some(r) -> r, None -> AsWord };
  let held = sum_rep(table(), e, expr_laid());
  let f = case_dropped(table(), keys::Named(b"m.drop_add"), e, 1, laid_for, form_for);
  assert_eq(f.params.map(|v: Var| v.representation), [boxed]);
  let d = dropping(f.body);
  assert_eq(d.opened.map(|v: Var| v.representation), [held, held]);
  assert_eq(d.decremented, d.opened);
  assert(!f.body.any(|i: Inst| match i { Restart(_) -> true, _ -> false }), None);
  assert_eq(
    contents_with(table(), e, boxed, laid_for, form_for),
    BoxContents({
      parts: [{ at: 0, ty: e, representation: held }, { at: 2, ty: e, representation: held }],
      words: 4,
    }),
  )
}

test "a container's drop root opens it whole, and its opening names its parts' roots" {
  let list = list_type(string_type());
  let o = { id: 0, ty: list, representation: AsWord };
  // It opens the list whole, the opening walking its items, and binds and lets go of no word itself.
  {
    let f = generated_here(drop_of(list));
    assert(f.body.any(|i: Inst| match i { Destructure(x) -> x.of == o, _ -> false }), None);
    assert_eq(dropping(f.body), { opened: [], decremented: [] })
  };
  let opened = |ty: Type| contents_with(table(), ty, AsWord, laid_for, form_for);
  assert_eq(
    opened(list),
    ListOf({
      node: drop_of(list_node_type(string_type())),
      item: [object(string_type(), 0)],
      stride: 1,
    }),
  );
  // The prelude's node, as the checker names it, opens as a node and is let go of at its own root.
  let node = list_node_type(string_type());
  assert_eq(
    opened(node),
    ListNodeOf({ node: drop_of(node), item: [object(string_type(), 0)], stride: 1 }),
  );
  assert_eq(layout_parts(table(), node, PlainWords([Pointer]), 0), [object(node, 0)]);
  let pairs = map_node_type(int_type(), string_type());
  assert_eq(layout_parts(table(), pairs, PlainWords([Pointer]), 0), [object(pairs, 0)]);
  assert_eq(
    opened(applied(b"Hold", [string_type()])),
    HoldContents({ at: 1, ty: string_type(), representation: AsWord }),
  );
  // A hold as the checker types it, its region's label first: it holds what its last argument is.
  assert_eq(
    opened(hold_type(label_type(b"r"), string_type())),
    HoldContents({ at: 1, ty: string_type(), representation: AsWord }),
  );
  assert_eq(opened(decimal_type()), ScalarBox(2));
  assert_eq(opened(width_type({ bits: 128, signed: false })), ScalarBox(2));
  assert_eq(
    opened(named(b"m.E")),
    BoxContents({
      parts: [
        { at: 0, ty: named(b"m.E"), representation: sum_rep(table(), named(b"m.E"), expr_laid()) },
      ],
      words: 2,
    }),
  )
}

test "a word a block holds is its type's word form, a function's or a continuation's let go of through its descriptor" {
  let stored = |ty: Type| stored_parts(table(), { at: 1, ty: ty, representation: AsWord });
  let word = |how: CountedWord| [WordAt({ at: 0, masked: false, how: how })];
  let record = RecordType([{ name: b"a", ty: string_type() }, { name: b"b", ty: int_type() }]);
  assert_eq(stored(int_type()), []);
  assert_eq(stored(record), [object(record, 0)]);
  assert_eq(stored(bool_type()), []);
  assert_eq(stored(string_type()), [object(string_type(), 0)]);
  assert_eq(
    stored(
      FunctionType({
        kept: [],
        once: false,
        params: [int_type()],
        ret: int_type(),
        effects: row_empty(),
      }),
    ),
    word(ThroughDescriptor),
  );
  let k = representations::resumption(VariableType(0));
  assert_eq(stored(k), word(ThroughDescriptor));
  assert_eq(block_contents(table(), k, AsWord), ClosureBlock);
  assert_eq(released_vars(k), []);
  match block_contents(table(), applied(b"Hold", [int_type()]), AsWord) {
    HoldContents(h) -> assert_eq(stored_parts(table(), h), []),
    other -> assert_eq(other, HoldContents({ at: 0, ty: int_type(), representation: AsWord })),
  }
}

test "a program's own `ListNode` is its own type, released as its declaration lays it, not as the prelude's node" {
  let own = named(b"m.ListNode");
  let declared = ctors_of(
    [],
    [],
    [],
    Map::new().insert(b"m.ListNode", [
      { name: b"m.Node", index: 0, fields: [string_type()], params: [] },
      { name: b"m.End", index: 1, fields: [], params: [] },
    ]),
  );
  assert_eq(
    match block_contents(declared, own, AsWord) { ListNodeOf(_) -> true, _ -> false },
    false,
  );
  assert_eq(layout_parts(declared, own, PlainWords([Pointer]), 0), [object(own, 0)]);
  assert(drop_of(own) != drop_of(applied(list_node_name(), [])), None)
}

test "a list's drop root, read off the layout module's own layout, loops on its tail" {
  let l = named(b"m.L");
  {
    let f = generated(table(), drop_of(l));
    match f.body {
      [Case(c)] -> match c.arms {
        [arm] -> match arm.body {
          [Destructure(rename), Destructure(open), Let(last), If(again), Return(_)] -> {
            assert_eq([arm.when], [1]);
            assert_eq(rename.of, f.params.get(0));
            assert_eq(rename.words, [open.of]);
            assert_eq(open.words.map(|w: Var| w.ty), [l]);
            assert_eq(last.val, IfUnique(open.words.get(0)));
            assert_eq(again.then, [Restart([VarOperand(last.var)])])
          },
          other -> assert_eq(other.len(), 0),
        },
        arms -> assert_eq(arms.len(), 1),
      },
      body -> assert_eq(body.len(), 1),
    }
  }
}

test "a wide sum laid by the layout module is let go of by case, its boxed case at that case's root" {
  let e = named(b"m.E");
  match representations::layout_of(table(), e) {
    SumCases(s) -> {
      assert(s.classes.len() > 1, None);
      match layout_parts(table(), e, SumCases(s), 0) {
        [ByCase(c)] -> {
          assert_eq(c.cases.map(|k: { case: Int, parts: List<Part> }| k.case), [1, 2]);
          assert_eq(
            c.cases.map(|k: { case: Int, parts: List<Part> }|
              k.parts.map(|p: Part|
                match p { WordAt(w) -> w.how, ByCase(_) -> ThroughDescriptor })),
            [[CaseBox({ sum: e, case: 1 })], [Object(drop_of(string_type()))]],
          );
          // Its box's drop root holds its sums whole, as their own type lays them.
          {
            let f = generated(table(), drop_of(e));
            match f.body {
              [Destructure(o), Dec(v), Return(_)] -> {
                assert_eq(o.words, [v]);
                assert_eq(v.representation, sum_rep(table(), e, s))
              },
              body -> assert_eq(body.len(), 3),
            }
          }
        },
        parts -> assert_eq(parts.len(), 1),
      }
    },
    _ -> assert(false, None),
  }
}

test "copy, share and keep roots walk a block, a sum of one word through its word, a boxed case its box" {
  let node = list_node_type(string_type());
  let l = named(b"m.L");
  let e = named(b"m.E");
  // What the root walks, as its type and how it holds it, and how: the value it answers.
  let walk = |f: Fn|
    f.body.fold(
      None,
      |found: Option<{ ty: Type, representation: Representation, op: keys::TypeOp }>, i: Inst|
        match i {
          Let(c) -> match c.val {
            WalkLoop(w) -> if f.params.contains(w.of) {
              Some({ ty: w.of.ty, representation: w.of.representation, op: w.op })
            } else { found },
            _ -> found,
          },
          _ -> found,
        },
    );
  {
    let f = generated_here(root_of(Copy, node));
    assert_eq(f.convention, {
      params: [{ handed: OwnedParam, representation: AsWord }],
      result: AsWord,
      destination_passing: false,
      answered: OwnedResult,
    });
    assert_eq(walk(f), Some({ ty: node, representation: AsWord, op: Copy }))
  };
  {
    let f = generated_here(root_of(Share, l));
    assert_eq(handed_of(f.convention), [BorrowedParam]);
    assert_eq(f.convention.result, AsInt);
    assert_eq(walk(f), Some({ ty: l, representation: sum_rep(table(), l, list_laid()), op: Share }))
  };
  let boxed = match boxed_case_rep(table(), e, expr_laid(), 1) { Some(r) -> r, None -> AsWord };
  {
    let f = generated_here(case_root(Keep, e, 1));
    assert_eq(walk(f), Some({ ty: e, representation: boxed, op: Keep }))
  };
  {
    let f = generated_here(case_root(Drop, e, 1));
    assert_eq(f.params.map(|v: Var| v.representation), [boxed])
  };
  // A case its sum lays in place has no box, so no root.
  assert_eq(boxed_case_rep(table(), e, expr_laid(), 0), None)
}

test "a dup root counts its word form once more and answers it; a release root lets go of it" {
  let k = |op: keys::TypeOp| generated_key(op, named(b"String"), b"m");
  {
    let f = generated_here(k(Dup));
    let o = f.params.get(0);
    assert_eq(handed_of(f.convention), [BorrowedParam]);
    assert(f.body.contains(Inc({ var: o, n: 1 })) && f.body.contains(Return(VarOperand(o))), None)
  };
  {
    let f = generated_here(k(keys::Release));
    assert_eq(handed_of(f.convention), [OwnedParam]);
    assert_eq(dropping(f.body).decremented, f.params)
  }
}

test "a body reads exactly each variable it lets go of a value of, and the layout of each it counts" {
  let at = |name: Bytes, args: List<Type>| NamedType({ name: name, args: args });
  let local = |id: Int, ty: Type| { id: id, ty: ty, representation: AsWord };
  let list = local(0, list_type(VariableType(0)));
  let counted_once = local(1, VariableType(1));
  let function = local(
    2,
    FunctionType({
      kept: [],
      once: false,
      params: [VariableType(5)],
      ret: VariableType(6),
      effects: row_empty(),
    }),
  );
  let task = local(3, task_type(VariableType(7)));
  let held = local(4, at(b"Hold", [VariableType(2)]));
  let failing = local(5, VariableType(3));
  let token = { id: 6, ty: VariableType(8), representation: AsReuseToken(2) };
  let last = local(7, at(b"Hold", [VariableType(2)]));
  let f = {
    key: keys::Named(b"m.f"),
    kind: Metered,
    params: [],
    convention: { params: [], result: AsInt, destination_passing: false, answered: OwnedResult },
    result_type: int_type(),
    body: [
      Dec(list),
      Inc({ var: counted_once, n: 1 }),
      Dec(function),
      Dec(task),
      Let({ var: last, val: IfUnique(held), at: dummy_span(), unwind: [failing, token] }),
      Dec(list),
      Return(IntOperand(0)),
    ],
    lambdas: [],
    base: 0,
    members: [],
    links: { ..no_links(), needs: [{ var: 1, reads: Scalar }] },
    statics: [],
  };
  let needs = release_needs(f).links.needs;
  let expected = [
    { var: 1, reads: Scalar },
    { var: 0, reads: Exact },
    { var: 1, reads: Layout },
    { var: 2, reads: Exact },
    { var: 3, reads: Exact },
  ];
  assert(needs.len() == expected.len() && expected.all(|n: Need| needs.contains(n)), None);
  assert_eq(release_reads(f).len(), 4);
  // A body counting only what its types settle reads none of its variables.
  assert_eq(
    release_reads({ ..f, body: [Dec(local(8, list_type(int_type()))), Return(IntOperand(0))] }),
    [],
  );
  // Its entry lets go of what it lends once the call is done, and counts once more what it answers
  // borrowed, though its body counts neither.
  let x = local(9, VariableType(4));
  let n = { id: 10, ty: VariableType(9), representation: AsInt };
  assert_eq(
    release_reads({
      ..f,
      params: [x, n],
      convention: {
        params: [
          { handed: BorrowedParam, representation: AsWord },
          { handed: BorrowedParam, representation: AsInt },
        ],
        result: AsWord,
        destination_passing: false,
        answered: BorrowedResult([{ param: 0, whole: true }]),
      },
      result_type: VariableType(4),
      body: [Return(VarOperand(x))],
    }),
    [{ var: 4, reads: Exact }, { var: 4, reads: Layout }],
  )
}

test "a value held across what may stop is read by its layout too, as the frame's record counts it" {
  let held = { id: 0, ty: VariableType(0), representation: AsWord };
  let token = { id: 1, ty: VariableType(1), representation: AsReuseToken(2) };
  let kept = { id: 2, ty: VariableType(2), representation: AsWord };
  let answer = { id: 3, ty: int_type(), representation: AsWord };
  let call = |stops: Bool|
    Call({
      callee: keys::Root(keys::Named(b"m.g")),
      args: [],
      convention: { params: [], result: AsWord, destination_passing: false, answered: OwnedResult },
      suspends: stops,
    });
  let root = |body: Block|
    {
      key: keys::Named(b"m.f"),
      kind: Metered,
      params: [],
      convention: { params: [], result: AsInt, destination_passing: false, answered: OwnedResult },
      result_type: int_type(),
      body: body.push(Return(IntOperand(0))),
      lambdas: [],
      base: 0,
      members: [],
      links: no_links(),
      statics: [],
    };
  let site = |stops: Bool| [Do({ val: call(stops), at: dummy_span(), unwind: [held, token] })];
  let across = release_reads(root(site(true)));
  assert(
    across.len() == 2 && across.contains({ var: 0, reads: Exact })
      && across.contains({ var: 0, reads: Layout }),
    None,
  );
  assert_eq(release_reads(root(site(false))), [{ var: 0, reads: Exact }]);
  let handled = |s: HandleSite, body: Block|
    [
      Handle({
        body: body,
        args: [],
        uses: { takes: [], owned: false, fails: false, suspends: false },
        site: s,
        result: answer,
        unwind: [kept, token],
      }),
    ];
  let quiet = { clauses: [], ret: None, detached: None, instance: empty_instance(0) };
  // A handle holds across a stop where its return clause may run, or its body may stop.
  [handled({ ..quiet, ret: Some(0) }, []), handled(quiet, site(true))].fold(
    (),
    |_: Unit, b: Block| assert(release_reads(root(b)).contains({ var: 2, reads: Layout }), None),
  );
  assert_eq(release_reads(root(handled(quiet, []))), [{ var: 2, reads: Exact }])
}
