import compiler.check.known (none_constructor, some_constructor)
import compiler.check.types (NamedType, Type, FunctionType, int_type, no_effects, string_type)
import std.bytes (ascii_of_int)
import compiler.syntax.parsing (Span, dummy_span)
import compiler.syntax.patterns (SourceLiteral, LiteralUnit, LiteralString)
import compiler.emit.c (Width)
import compiler.emit.representations (RecordShape, kind_of)
import compiler.emit.output (GenericCall, Need, ForwardedParameter)
import compiler.emit.keys (RootKey, Callee, Generic, Named, TypeOperation, Copy, Share, Keep)
import compiler.emit.layout (SumLayout, SumCases, PlainWords, Pointer, RawRange, WordIs,
                             WordOutside, Nullary, Inline, has_counted_references, words)
import compiler.emit.typed_ir.handling (HandleOperation, HandleSite, WordArray, Label,
                                        empty_instance)
import compiler.emit.typed_ir.containers (ContainerOperation)
import compiler.emit.typed_ir.calling (CallingOperation)
import compiler.emit.typed_ir.statics (StaticDefinition)
import compiler.emit.typed_ir.strings (StringOperation, StringOperand, TakesBlock, OwnBlock,
                                       string_operands, string_result)
import compiler.syntax.expressions (is_arithmetic)

pub type Representation =
  | AsInt
  | AsBool
  | AsFixed(Width)
  | AsFloat
  | AsDecimal
  | AsWideFixed(Width)
  | AsWord
  | AsFlattened(List<Leaf>)
  | AsListView
  | AsReuseToken(Int)
  | AsSum({ layout: SumLayout, cases: List<Bytes> })
  | AsUnit
  | AsAddress
  | AsImmediate

pub type Leaf = { name: Bytes, representation: Representation }

pub type Variable = { id: Int, ty: Type, representation: Representation }

pub type Arg =
  | VariableOperand(Variable)
  | IntOperand(Int)
  | BoolOperand(Bool)
  | FloatOperand(Int)
  | FixedOperand({ width: Width, bits: Int })
  | CharOperand(Int)
  | ZeroOperand(Representation)

pub type FieldWrite = { at: Int, ty: Type, arg: Arg }

pub type ParamOwnership = | OwnedParam | BorrowedParam

pub type LoopVariable = { var: Variable, init: Arg }

pub fn carried_variables(state: List<LoopVariable>) -> List<Variable> =
  state.map(|c: LoopVariable| c.var)

pub fn carried_inits(state: List<LoopVariable>) -> List<Arg> = state.map(|c: LoopVariable| c.init)

pub type ResultOwnership = | OwnedResult | BorrowedResult(List<{ param: Int, whole: Bool }>)

pub type Convention = {
  params: List<ParamTaking>,
  result: Representation,
  destination_passing: Bool,
  returned: ResultOwnership,
}

pub type ParamTaking = { ownership: ParamOwnership, representation: Representation }

pub fn reps_of(c: Convention) -> List<Representation> =
  c.params.map(|p: ParamTaking| p.representation)

pub fn param_ownerships(c: Convention) -> List<ParamOwnership> =
  c.params.map(|p: ParamTaking| p.ownership)

pub fn owned_params(reps: List<Representation>) -> List<ParamTaking> =
  reps.map(|r: Representation| { ownership: OwnedParam, representation: r })

pub fn param_rep(c: Convention, i: Int) -> Option<Representation> =
  match c.params.at(i) { Some(p) -> Some(p.representation), None -> None }

pub fn param_borrowed(c: Convention, i: Int) -> Bool =
  match c.params.at(i) { Some(p) -> p.ownership == BorrowedParam, None -> false }

pub fn with_ownerships(c: Convention, by_convention: List<ParamOwnership>) -> Convention =
  {
    ..c,
    params: c.params.fold([], |accumulator: List<ParamTaking>, p: ParamTaking|
      accumulator.push(match by_convention.at(accumulator.len()) {
        Some(h) -> { ..p, ownership: h },
        None -> p,
      })),
  }

pub fn borrowed_where(reps: List<Representation>, borrowed: List<Int>) -> List<ParamTaking> =
  range(0, reps.len()).fold([], |accumulator: List<ParamTaking>, i: Int|
    match reps.at(i) {
      Some(r) ->
        accumulator.push({
          ownership: if borrowed.contains(i) { BorrowedParam } else { OwnedParam },
          representation: r,
        }),
      None -> accumulator,
    })

pub type OperationSignature = { takes: List<Bool>, owned: Bool, fails: Bool, suspends: Bool }

pub type Allocation =
  | ListAllocation(Int)
  | ClosureAllocation({ nth: Int, captures: Int, params: Int })
  | CaseAllocation({ case: Int, skip: Int, words: Int })
  | StackAllocation(Allocation)
  | RecordAllocation(List<FieldInitializer>)

pub type FieldInitializer = | FromArgument | BuiltInPlace(List<FieldInitializer>)

pub type Path =
  | FieldPath({ name: Bytes, at: Int })
  | ArgumentPath({ constructor: Bytes, at: Int })
  | CapturePath(Int)
  | LeafPath(Int)
  | InlineRecordPath(Int)
  | CasePath({ case: Int, at: Int })
  | PayloadPath

pub type Test =
  | TagTest(List<Bytes>)
  | IntTest(List<Int>)
  | RangeTest({ lo: Int, hi: Int })
  | LengthTest({ at_least: Int })

pub type Operation =
  | OfHandling(HandleOperation)
  | OfContainers(ContainerOperation)
  | OfCalling(CallingOperation)
  | OfStrings(StringOperation)

pub type Rvalue =
  | Primitive({ operation: Bytes, on: Representation, args: List<Arg> })
  | Literal(SourceLiteral)
  | Static(Bytes)
  | Allocate({ made: Allocation, args: List<Arg>, reuse: Option<Variable> })
  | Get({ of: Variable, path: Path })
  | Take({ of: Variable, path: Path })
  | Tag(Bytes)
  | Convert({ arg: Arg, to: Representation })
  | Aggregate({ parts: List<Arg> })
  | Update({ of: Variable, sets: List<FieldWrite> })
  | Call({ callee: Callee, args: List<Arg>, convention: Convention, suspends: Bool })
  | Apply({ f: Arg, args: List<Arg>, convention: Convention, suspends: Bool, closure: Option<Int> })
  | Native({ name: Bytes, args: List<Arg>, uses: OperationSignature })
  | OperationCall({ operation: Operation, args: List<Arg>, uses: OperationSignature })
  | IfUnique(Variable)
  | OperandsOnly(List<{ arg: Arg, takes: Bool }>)
  | WalkLoop({ of: Variable, operation: TypeOperation })

pub type Block = List<Instruction>

pub type Instruction =
  | Let({ var: Variable, value: Rvalue, at: Span, unwind: List<Variable> })
  | Do({ value: Rvalue, at: Span, unwind: List<Variable> })
  | Declaration(Variable)
  | Assign({ var: Variable, arg: Arg })
  | If({ cond: Arg, then: Block, otherwise: Block })
  | Case({ on: Variable, test: Test, arms: List<{ when: Int, body: Block }>, rest: Block })
  | Match({ arms: List<Block>, rest: Block })
  | Miss
  | Loop({ state: List<LoopVariable>, body: Block, result: Variable })
  | Next(List<Arg>)
  | Done(Arg)
  | Return(Arg)
  | Restart(List<Arg>)
  | Jump({ member: Int, args: List<Arg> })
  | Fail({ reason: MatchFailure, at: Span, resource: List<Unwinding>, unwind: List<Variable> })
  | Handle({ body: Block, args: List<Arg>, uses: OperationSignature, site: HandleSite, result: Variable, unwind: List<Variable> })
  | SiteScope(Option<SiteOrigin>)
  | CleanupScope(Option<List<Unwinding>>)
  | Increment({ var: Variable, n: Int })
  | Decrement(Variable)
  | Reset({ token: Variable, of: Variable })
  | Free({ of: Variable, bytes: Arg })
  | Destructure({ of: Variable, words: List<Variable> })

pub type Unwinding = { arg: Arg, words: List<Arg>, callee: RootKey, convention: Convention }

pub type MatchFailure = | NoMatchingArm | LetMismatch

pub type SiteOrigin = { root: RootKey, base: Int }

pub type FunctionKind = | Metered | Plain

pub type Links = {
  generics: List<GenericCall>,
  needs: List<Need>,
  called: List<Int>,
  forwarded_parameters: List<ForwardedParameter>,
  pending: Option<PendingRaise>,
}

pub fn no_links() -> Links =
  { generics: [], needs: [], called: [], forwarded_parameters: [], pending: None }

pub type PendingRaise = { word: Variable, index: Int, operation: Bytes, string: Bytes }

pub type Function = {
  key: RootKey,
  kind: FunctionKind,
  params: List<Variable>,
  convention: Convention,
  result_type: Type,
  body: Block,
  lambdas: List<Lambda>,
  base: Int,
  members: List<Member>,
  links: Links,
  statics: List<StaticDefinition>,
}

pub type Member = { key: RootKey, base: Int, params: List<Variable>, convention: Convention }

pub type Lambda = | Closure({ body: Function, captures: Int, at: Span, words: ClosureEvidence })

pub type ClosureEvidence = { descriptor: Bytes, count: Int, resource_captures: List<Int> }

pub fn no_closure_evidence() -> ClosureEvidence =
  { descriptor: b"", count: 0, resource_captures: [] }

pub fn representation_text(r: Representation) -> Bytes =
  match r {
    AsInt -> b"Int",
    AsBool -> b"Bool",
    AsFixed(_) -> b"a fixed-width integer",
    AsFloat -> b"Float",
    AsDecimal -> b"Decimal",
    AsWideFixed(w) -> if w.signed { b"I128" } else { b"U128" },
    AsWord -> b"a word",
    AsFlattened(ls) -> Bytes::concat_all([b"flat, ", ascii_of_int(ls.len()), b" leaves"]),
    AsListView -> b"a view",
    AsReuseToken(n) -> Bytes::concat_all([b"a token of ", ascii_of_int(n), b" words"]),
    AsSum(s) -> Bytes::concat_all([b"a sum's words, ", ascii_of_int(s.cases.len()), b" cases"]),
    AsUnit -> b"no words",
    AsAddress -> b"an address into a block",
    AsImmediate -> b"a word that is not reference counted",
  }

pub fn variable_text(v: Variable) -> Bytes =
  Bytes::concat_all([
    b"v",
    ascii_of_int(v.id),
    b" represented as ",
    representation_text(v.representation),
  ])

pub fn allocation_text(m: Allocation) -> Bytes =
  match m {
    ListAllocation(n) -> Bytes::concat_all([b"a list of ", ascii_of_int(n)]),
    ClosureAllocation(c) -> Bytes::concat_all([b"closure ", ascii_of_int(c.nth)]),
    CaseAllocation(c) -> Bytes::concat_all([b"case ", ascii_of_int(c.case), b" boxed"]),
    RecordAllocation(_) -> b"record",
    StackAllocation(x) -> Bytes::concat_all([allocation_text(x), b" in the frame"]),
  }

pub fn base_allocation(m: Allocation) -> Allocation =
  match m { StackAllocation(x) -> base_allocation(x), _ -> m }

pub fn stack_borrows(m: Allocation, args: List<Arg>) -> Option<List<Arg>> =
  match m {
    StackAllocation(ClosureAllocation(c)) -> Some(args.take(c.captures)),
    StackAllocation(ListAllocation(_)) -> Some(args),
    _ -> None,
  }

pub fn is_refcounted(r: Representation) -> Bool =
  match r {
    AsWord -> true,
    AsListView -> true,
    AsReuseToken(_) -> true,
    AsFlattened(leaves) ->
      leaves.fold(false, |any: Bool, l: Leaf| any || is_refcounted(l.representation)),
    AsSum(s) -> has_counted_references(SumCases(s.layout)),
    _ -> false,
  }

pub fn is_boxed(r: Representation) -> Bool =
  match r { AsFlattened(_) -> true, AsSum(s) -> words(SumCases(s.layout)) > 1, _ -> false }

pub fn is_unboxing(arg: Arg, to: Representation) -> Bool =
  operand_representation(arg) == AsWord && is_boxed(to)

pub fn parts_of(r: Representation) -> List<Representation> =
  match r {
    AsFlattened(leaves) -> leaves.map(|l: Leaf| l.representation),
    AsListView -> [AsWord, AsInt],
    _ -> [r],
  }

pub fn operand_representation(a: Arg) -> Representation =
  match a {
    VariableOperand(v) -> v.representation,
    IntOperand(_) -> AsInt,
    BoolOperand(_) -> AsBool,
    FloatOperand(_) -> AsFloat,
    FixedOperand(n) -> AsFixed(n.width),
    CharOperand(_) -> AsImmediate,
    ZeroOperand(r) -> r,
  }

pub fn operand_variable(a: Arg) -> Option<Variable> =
  match a { VariableOperand(v) -> Some(v), _ -> None }

pub fn uses_typed_entry(f: Arg) -> Bool =
  match f { VariableOperand(v) -> match v.ty { FunctionType(_) -> true, _ -> false }, _ -> false }

pub fn operands(v: Rvalue) -> List<{ arg: Arg, takes: Bool }> =
  match v {
    Primitive(p) -> p.args.map(|a: Arg| { arg: a, takes: false }),
    Literal(_) -> [],
    Static(_) -> [],
    Allocate(m) -> if is_record_allocation(m.made) { takes_except_records(m.args) } else {
      let borrowed = match stack_borrows(m.made, m.args) { Some(cs) -> cs.len(), None -> 0 };
      range(0, m.args.len()).fold(
        [],
        |accumulator: List<{ arg: Arg, takes: Bool }>, i: Int|
          match m.args.at(i) {
            Some(a) -> accumulator.push({ arg: a, takes: i >= borrowed }),
            None -> accumulator,
          },
      ).concat(match m.reuse { Some(t) -> [{ arg: VariableOperand(t), takes: true }], None -> [] })
    },
    Get(g) -> [{ arg: VariableOperand(g.of), takes: false }],
    Take(t) -> [{ arg: VariableOperand(t.of), takes: false }],
    Tag(_) -> [],
    Convert(p) -> [{ arg: p.arg, takes: is_refcounted(p.to) && !is_unboxing(p.arg, p.to) }],
    Aggregate(g) -> g.parts.map(|a: Arg| { arg: a, takes: true }),
    Update(u) ->
      [{ arg: VariableOperand(u.of), takes: true }].concat(
        takes_except_records(u.sets.map(|s: FieldWrite| s.arg)),
      ),
    Call(c) -> by_convention(c.args, c.convention),
    Apply(c) ->
      [{ arg: c.f, takes: uses_typed_entry(c.f) }].concat(by_convention(c.args, c.convention)),
    Native(n) -> by_signature(n.args, n.uses),
    OperationCall(o) -> by_signature(o.args, o.uses),
    IfUnique(x) -> [{ arg: VariableOperand(x), takes: true }],
    WalkLoop(w) -> [{ arg: VariableOperand(w.of), takes: w.operation == Copy }],
    OperandsOnly(operand_list) -> operand_list,
  }

fn is_record_allocation(m: Allocation) -> Bool = match m { RecordAllocation(_) -> true, _ -> false }

pub fn read_only(args: List<Arg>) -> List<{ arg: Arg, takes: Bool }> =
  args.map(|a: Arg| { arg: a, takes: false })

pub fn reads(n: Int) -> OperationSignature =
  { takes: range(0, n).map(|_: Int| false), owned: false, fails: false, suspends: false }

pub fn takes_except_records(args: List<Arg>) -> List<{ arg: Arg, takes: Bool }> =
  args.map(|a: Arg|
    { arg: a, takes: match operand_variable(a) { Some(v) -> !is_record_word(v), None -> true } })

pub fn is_record_word(v: Variable) -> Bool =
  v.representation == AsWord && (match kind_of(v.ty).ty { RecordShape(_) -> true, _ -> false })

fn by_convention(args: List<Arg>, conv: Convention) -> List<{ arg: Arg, takes: Bool }> =
  range(0, args.len()).fold([], |accumulator: List<{ arg: Arg, takes: Bool }>, i: Int|
    match args.at(i) {
      Some(a) -> accumulator.push({ arg: a, takes: !param_borrowed(conv, i) }),
      None -> accumulator,
    })

pub fn string_signature(operation: StringOperation) -> OperationSignature =
  {
    takes: string_operands(operation).map(|a: StringOperand| a == TakesBlock),
    owned: string_result(operation) == OwnBlock,
    fails: false,
    suspends: false,
  }

pub fn by_signature(args: List<Arg>, uses: OperationSignature) -> List<{ arg: Arg, takes: Bool }> =
  range(0, args.len()).fold([], |accumulator: List<{ arg: Arg, takes: Bool }>, i: Int|
    match args.at(i) {
      Some(a) -> accumulator.push({ arg: a, takes: uses.takes.at(i) == Some(true) }),
      None -> accumulator,
    })

pub type Provenance = | Owns | BorrowSources(List<Variable>) | Immortal

pub fn provenance(v: Rvalue) -> Provenance =
  match v {
    Get(g) -> BorrowSources([g.of]),
    Static(_) -> Immortal,
    Tag(_) -> Immortal,
    Native(n) -> signature_provenance(n.args, n.uses),
    OperationCall(o) -> signature_provenance(o.args, o.uses),
    WalkLoop(w) -> if w.operation == Share { Immortal } else { Owns },
    Convert(p) -> if !is_unboxing(p.arg, p.to) { Owns }
    else { match p.arg { VariableOperand(x) -> BorrowSources([x]), _ -> Immortal } },
    Call(c) -> match c.convention.returned {
      OwnedResult -> Owns,
      BorrowedResult(from) ->
        BorrowSources(
          from.fold([], |xs: List<Variable>, b: { param: Int, whole: Bool }|
            match c.args.at(b.param) {
              Some(VariableOperand(x)) -> if is_refcounted(x.representation) && !xs.contains(x) {
                xs.push(x)
              } else { xs },
              _ -> xs,
            }),
        ),
    },
    _ -> Owns,
  }

fn signature_provenance(args: List<Arg>, uses: OperationSignature) -> Provenance =
  if uses.owned { Owns }
  else { match args.at(0) { Some(VariableOperand(x)) -> BorrowSources([x]), _ -> Immortal } }

pub fn fails(v: Rvalue) -> Bool =
  match v {
    Primitive(p) -> checked(p.operation, p.on),
    Literal(_) -> false,
    Static(_) -> false,
    Allocate(_) -> false,
    Get(_) -> false,
    Take(_) -> false,
    Tag(_) -> false,
    Convert(_) -> false,
    Aggregate(_) -> false,
    Update(_) -> false,
    Call(_) -> true,
    Apply(_) -> true,
    Native(n) -> n.uses.fails,
    OperationCall(o) -> o.uses.fails,
    IfUnique(_) -> false,
    WalkLoop(_) -> false,
    OperandsOnly(_) -> false,
  }

pub fn may_suspend(value: Rvalue) -> Bool =
  match value {
    Call(c) -> c.suspends,
    Apply(c) -> c.suspends,
    Native(n) -> n.uses.suspends,
    OperationCall(o) -> o.uses.suspends,
    _ -> false,
  }

pub fn any_instruction(b: Block, at: (Instruction) -> Bool) -> Bool =
  b.any(|i: Instruction|
    at(i)
      || (match i {
        If(x) -> any_instruction(x.then, at) || any_instruction(x.otherwise, at),
        Case(c) ->
          any_instruction(c.rest, at)
            || c.arms.any(|a: { when: Int, body: Block }| any_instruction(a.body, at)),
        Match(m) ->
          any_instruction(m.rest, at) || m.arms.any(|arm: Block| any_instruction(arm, at)),
        Loop(l) -> any_instruction(l.body, at),
        Handle(h) -> any_instruction(h.body, at),
        _ -> false,
      }))

fn value_matches(i: Instruction, at: (Rvalue) -> Bool) -> Bool =
  match i { Let(l) -> at(l.value), Do(d) -> at(d.value), _ -> false }

pub fn suspends_in(b: Block) -> Bool =
  any_instruction(b, |i: Instruction| value_matches(i, may_suspend))

pub fn calls_in(b: Block) -> Bool =
  any_instruction(b, |i: Instruction|
    value_matches(i, |v: Rvalue| match v { Call(_) -> true, Apply(_) -> true, _ -> false }))

pub fn handle_suspends(body: Block, site: HandleSite) -> Bool =
  site.clauses.len() > 0 || site.return_clause != None || site.detached != None || suspends_in(body)

pub fn checked(operation: Bytes, on: Representation) -> Bool =
  match on {
    AsInt ->
      is_arithmetic(operation) || shift(operation) || operation == b"neg" || operation == b"of_int",
    AsFixed(w) ->
      is_arithmetic(operation) || shift(operation) || operation == b"neg"
        || (operation == b"to_int" && !w.signed && w.bits == 64),
    AsFloat -> operation == b"rem",
    AsDecimal -> is_arithmetic(operation),
    AsWideFixed(_) ->
      is_arithmetic(operation) || shift(operation) || operation == b"neg" || operation == b"to_int",
    _ -> false,
  }

pub fn shift(operation: Bytes) -> Bool =
  operation == b"shl" || operation == b"shr" || operation == b"ushr"

pub fn comparison(operation: Bytes) -> Bool =
  operation == b"eq" || operation == b"ne" || operation == b"lt" || operation == b"le"
    || operation == b"gt"
    || operation == b"ge"

pub fn is_terminator(i: Instruction) -> Bool =
  match i {
    Return(_) -> true,
    Restart(_) -> true,
    Jump(_) -> true,
    Next(_) -> true,
    Done(_) -> true,
    Fail(_) -> true,
    Miss -> true,
    _ -> false,
  }

pub fn falls_through(b: Block) -> Bool =
  b.fold(true, |falls: Bool, i: Instruction|
    match i { SiteScope(_) -> falls, CleanupScope(_) -> falls, _ -> !is_terminator(i) })

pub fn bind(v: Variable, value: Rvalue) -> Instruction =
  Let({ var: v, value: value, at: dummy_span(), unwind: [] })

pub fn local_var(id: Int, ty: Type, rep: Representation) -> Variable =
  { id: id, ty: ty, representation: rep }

pub fn is_integral(r: Representation) -> Bool =
  match r { AsInt -> true, AsBool -> true, AsFixed(_) -> true, _ -> false }

pub fn placeholder_var(id: Int, rep: Representation) -> Variable =
  { id: id, ty: NamedType({ name: b"T", args: [] }), representation: rep }

test "`is_refcounted` is true for `AsWord`, `AsListView` and `AsReuseToken`, false for scalars, and true for a flattened record only if a field is counted" {
  assert_eq(
    [AsInt, AsBool, AsFloat, AsDecimal, AsFixed({ bits: 8, signed: false })].map(is_refcounted),
    [false, false, false, false, false],
  );
  assert_eq([AsWord, AsListView, AsReuseToken(2)].map(is_refcounted), [true, true, true]);
  assert_eq(
    [
      AsFlattened([{ name: b"a", representation: AsInt }]),
      AsFlattened([{ name: b"a", representation: AsInt }, { name: b"s", representation: AsWord }]),
    ].map(
      is_refcounted,
    ),
    [false, true],
  )
}

test "each operation consumes or borrows each operand as its signature says" {
  let s = { id: 1, ty: string_type(), representation: AsWord };
  let conv = {
    params: [
      { ownership: OwnedParam, representation: AsWord },
      { ownership: BorrowedParam, representation: AsWord },
    ],
    result: AsInt,
    destination_passing: false,
    returned: OwnedResult,
  };
  let call = Call({
    callee: Generic(0),
    args: [VariableOperand(s), VariableOperand(s)],
    convention: conv,
    suspends: false,
  });
  let takes = |v: Rvalue| operands(v).map(|o: { arg: Arg, takes: Bool }| o.takes);
  assert_eq(takes(call), [true, false]);
  let f = {
    id: 2,
    ty: FunctionType({
      keep_parameters: [],
      once: false,
      params: [s.ty, s.ty],
      return_type: int_type(),
      effects: no_effects(),
    }),
    representation: AsWord,
  };
  let apply = |f: Arg, args: List<Arg>|
    Apply({ f: f, args: args, convention: conv, suspends: false, closure: None });
  assert_eq(takes(apply(VariableOperand(f), [VariableOperand(s), VariableOperand(s)])), [
    true,
    true,
    false,
  ]);
  assert_eq(takes(apply(VariableOperand(s), [VariableOperand(s)])), [false, true]);
  assert_eq(takes(Get({ of: s, path: LeafPath(0) })), [false]);
  assert_eq(takes(Aggregate({ parts: [VariableOperand(s), IntOperand(1)] })), [true, true]);
  assert_eq(takes(Convert({ arg: VariableOperand(s), to: AsInt })), [false]);
  assert_eq(takes(Convert({ arg: IntOperand(1), to: AsWord })), [true]);
  let flat = AsFlattened([
    { name: b"a", representation: AsWord },
    { name: b"b", representation: AsInt },
  ]);
  assert_eq(takes(Convert({ arg: VariableOperand(s), to: flat })), [false]);
  assert_eq(provenance(Convert({ arg: VariableOperand(s), to: flat })), BorrowSources([s]));
  let closure = |framed: Bool|
    Allocate({
      made: if framed { StackAllocation(ClosureAllocation({ nth: 0, captures: 2, params: 1 })) }
      else { ClosureAllocation({ nth: 0, captures: 2, params: 1 }) },
      args: [VariableOperand(s), VariableOperand(s)],
      reuse: None,
    });
  assert_eq(takes(closure(true)), [false, false]);
  assert_eq(takes(closure(false)), [true, true]);
  let taken = Take({ of: s, path: FieldPath({ name: b"buf", at: 1 }) });
  assert_eq(takes(taken), [false]);
  assert_eq(provenance(taken), Owns);
  assert_eq(provenance(Tag(b"m.Box")), Immortal);
  let borrowed_use = { takes: [false, true], owned: false, fails: true, suspends: false };
  assert_eq(
    takes(
      OperationCall({
        operation: OfHandling(WordArray),
        args: [VariableOperand(s), VariableOperand(s)],
        uses: borrowed_use,
      }),
    ),
    [false, true],
  );
  assert_eq(provenance(Get({ of: s, path: LeafPath(0) })), BorrowSources([s]));
  assert_eq(provenance(call), Owns);
  let borrowed = match call {
    Call(c) ->
      Call({
        ..c,
        convention: { ..c.convention, returned: BorrowedResult([{ param: 1, whole: true }]) },
      }),
    other -> other,
  };
  assert_eq(provenance(borrowed), BorrowSources([s]));
  assert_eq(
    provenance(Native({ name: b"rt_len_p", args: [VariableOperand(s)], uses: borrowed_use })),
    BorrowSources([s]),
  );
  assert_eq(
    provenance(OperationCall({ operation: OfHandling(Label(b"r")), args: [], uses: borrowed_use })),
    Immortal,
  )
}

test "`fails` is true for checked operators and calls that can fail, and false for allocations and constants" {
  assert_eq(
    fails(Primitive({ operation: b"add", on: AsInt, args: [IntOperand(1), IntOperand(2)] })),
    true,
  );
  assert_eq(
    fails(Primitive({ operation: b"lt", on: AsInt, args: [IntOperand(1), IntOperand(2)] })),
    false,
  );
  assert_eq(
    fails(Primitive({ operation: b"add", on: AsFloat, args: [FloatOperand(0), FloatOperand(0)] })),
    false,
  );
  assert_eq(
    fails(
      Primitive({
        operation: b"add",
        on: AsDecimal,
        args: [ZeroOperand(AsDecimal), ZeroOperand(AsDecimal)],
      }),
    ),
    true,
  );
  assert_eq(fails(Primitive({ operation: b"of_int", on: AsInt, args: [IntOperand(300)] })), true);
  let w = { id: 2, ty: string_type(), representation: AsWord };
  assert_eq(fails(Get({ of: w, path: LeafPath(0) })), false);
  let flat = { ..w, representation: AsFlattened([{ name: b"x", representation: AsInt }]) };
  assert_eq(fails(Convert({ arg: IntOperand(7), to: AsWord })), false);
  assert_eq(fails(Convert({ arg: VariableOperand(flat), to: AsWord })), false);
  assert_eq(
    fails(
      Allocate({
        made: CaseAllocation({ case: 0, skip: 0, words: 1 }),
        args: [VariableOperand(w)],
        reuse: None,
      }),
    ),
    false,
  );
  assert_eq(fails(Aggregate({ parts: [IntOperand(1)] })), false);
  assert_eq(fails(Take({ of: w, path: FieldPath({ name: b"x", at: 0 }) })), false);
  assert_eq(fails(Tag(b"m.Box")), false);
  assert_eq([Literal(LiteralUnit), Literal(LiteralString(b"a")), Static(b"ply_k_0")].map(fails), [
    false,
    false,
    false,
  ]);
  assert_eq(is_terminator(Miss), true);
  assert_eq(
    falls_through([Do({ value: Literal(LiteralUnit), at: dummy_span(), unwind: [] })]),
    true,
  )
}

test "a call may suspend only if marked `suspends`, a block if any instruction in it may, and a `Handle` if its body or any of its clauses may" {
  let call = |stops: Bool|
    Call({
      callee: Generic(0),
      args: [],
      convention: { params: [], result: AsWord, destination_passing: false, returned: OwnedResult },
      suspends: stops,
    });
  let calling = |stops: Bool| [Do({ value: call(stops), at: dummy_span(), unwind: [] })];
  assert_eq([may_suspend(call(true)), may_suspend(call(false))], [true, false]);
  assert_eq([suspends_in(calling(true)), suspends_in(calling(false))], [true, false]);
  assert_eq(
    suspends_in([If({ cond: BoolOperand(true), then: [], otherwise: calling(true) })]),
    true,
  );
  let quiet = { clauses: [], return_clause: None, detached: None, instance: empty_instance(0) };
  let clause = { effect: b"e", operation: b"op", mode: 1, string: None, handler: 0 };
  assert_eq(
    [
      handle_suspends(calling(false), quiet),
      handle_suspends(calling(true), quiet),
      handle_suspends([], { ..quiet, return_clause: Some(0) }),
      handle_suspends([], { ..quiet, detached: Some({ body: 1, forwards: 2 }) }),
      handle_suspends([], { ..quiet, clauses: [clause] }),
    ],
    [false, true, true, true, true],
  )
}

test "a block does not fall through when it ends in a failure or return, and scope markers do not change that" {
  let borrowed = SiteScope(Some({ root: Named(b"m.g"), base: 40 }));
  let fail = Fail({ reason: NoMatchingArm, at: dummy_span(), resource: [], unwind: [] });
  assert_eq(falls_through([borrowed, fail, SiteScope(None)]), false);
  assert_eq(falls_through([fail, SiteScope(None), Return(IntOperand(0)), borrowed]), false);
  assert_eq(falls_through([borrowed, SiteScope(None)]), true);
  assert_eq(falls_through([]), true)
}

test "a sum type needs reference counting only when it has a pointer case, and `IfUnique` consumes its operand" {
  let none = { test: WordIs({ at: 0, value: 0 }), payload: Nullary };
  let pointer = {
    test: WordOutside({ at: 0, values: [0] }),
    payload: Inline({ offset: 0, layout: PlainWords([Pointer]), stripped: None }),
  };
  let maybe = AsSum({
    layout: { classes: [Pointer], cases: [none, pointer] },
    cases: [none_constructor(), some_constructor()],
  });
  let flags = AsSum({
    layout: {
      classes: [RawRange({ lo: 0, hi: 1 })],
      cases: [none, { test: WordIs({ at: 0, value: 1 }), payload: Nullary }],
    },
    cases: [b"Off", b"On"],
  });
  assert_eq([maybe, flags, AsUnit, AsAddress].map(is_refcounted), [true, false, false, false]);
  assert_eq(
    parts_of(
      AsFlattened([{ name: b"o", representation: maybe }, { name: b"n", representation: AsInt }]),
    ),
    [maybe, AsInt],
  );
  let s = { id: 1, ty: string_type(), representation: AsWord };
  assert_eq(operands(IfUnique(s)).map(|o: { arg: Arg, takes: Bool }| o.takes), [true]);
  assert_eq(provenance(IfUnique(s)), Owns);
  assert_eq(fails(IfUnique(s)), false)
}

test "a `WalkLoop` with `Copy` takes its operand while `Share` and `Keep` borrow it, and `Share` returns an immortal value with no reference count" {
  let s = { id: 1, ty: string_type(), representation: AsWord };
  let walked = [Copy, Share, Keep].map(|type_operation: TypeOperation|
    WalkLoop({ of: s, operation: type_operation }));
  assert_eq(walked.map(|v: Rvalue| operands(v).map(|o: { arg: Arg, takes: Bool }| o.takes)), [
    [true],
    [false],
    [false],
  ]);
  assert_eq(walked.map(provenance), [Owns, Immortal, Owns]);
  assert_eq(walked.map(fails), [false, false, false])
}
