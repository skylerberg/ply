//! The `Code` written for a type's operations: equality, ordering, reflection, digests and containers.

import syntax.parsing (Span, dummy_span, site_digit)
import emit.code (Code, Node, NLit, NVar, NBinary, NIf, NBlock, NList, NField, NApp, NRecord,
                  NMatch, CodePattern, PxWild, PxVar, PxCtor, CLet, CDo, CodeStmt, CodeArm,
                  CodeField)
import syntax.items (Item, IInstance, NKey)
import check.resolve.tables (qualify)
import check.types (Type, TyVar, TyCon, TyFn, TyRecord, TyNominal, Field, Scheme, int_type,
                    bytes_type, bool_type, unit_type, named_type, list_type, fn_type, monomorphic,
                    row_empty, fields_sorted)
import emit.typing (Typed, unknown_type, filed_as)
import std.list
import syntax.patterns (Lit, LInt, LBool, LStr, LBytes, LChar, LUnit)
import std.bytes (ascii_of_int)
import emit.c (KBool, KBoxed, KInt, width_named)
import emit.keys
import emit.keys (RootKey, Written, Named, TypeOp, Reflect, Shown, Digest, Contained, Lower, Lift,
                  root_name, op_name)
import emit.reps (Ctors, SumCtor, TyOpen, Def, EmitParam, at_args, kind_of)
import emit.lower.strings (strings_root, strings_code)
import emit.marks (marked_type, marked_key, plain)
import store.hash.forms (written_code)

// --- Externs written in place -----------------------------------------------------

/// The constructors and builtins written code names, each read at a site of its own past every
/// site its parts are placed at.
fn said_names() -> List<Bytes> =
  [
    b"Equal",
    b"Less",
    b"Greater",
    b"std.value.VRecord",
    b"std.value.VShown",
    b"std.value.VCtor",
    b"std.value.VMap",
    b"std.value.VArray",
    b"std.value.VList",
    b"Bytes::slice",
  ]

fn said_at(k: Int) -> Span = { start: 0, end: 0, site: site_digit() + k }

/// Name `name` of `said_names` read where written code says it.
fn said(name: Bytes) -> Code = {
  let k = range(0, said_names().len()).fold(0 - 1, |acc: Int, i: Int|
    if said_names().at(i) == Some(name) { i } else { acc });
  { node: NVar({ name: name, slot: None }), span: said_at(k) }
}

/// A list of `items` written code makes, the `k`th it files apart from its names.
fn said_list(items: List<Code>, k: Int) -> Code =
  { node: NList({ items: items }), span: said_at(said_names().len() + k) }

/// `typed` with what written code files where it says a name, as `said_type` types it, and each of
/// `lists`, the lists it makes, at its type.
fn said_typed(typed: Map<Int, Typed>, lists: List<Type>) -> Map<Int, Typed> =
  range(0, lists.len()).fold(
    range(0, said_names().len()).fold(typed, |m: Map<Int, Typed>, i: Int|
      match said_names().at(i) {
        Some(name) -> m.insert(said_at(i).site, filed_as(said_type(name), [])),
        None -> m,
      }),
    |m: Map<Int, Typed>, k: Int|
      match lists.at(k) {
        Some(t) -> m.insert(said_at(said_names().len() + k).site, filed_as(t, [])),
        None -> m,
      },
  )

/// The type a name of `said_names` is filed at: a constructor taking nothing its sum's, one applied
/// a function answering its sum, which lays the value it makes; a builtin none, its call reading the
/// builtin's own.
fn said_type(name: Bytes) -> Type = {
  let value = named_type(b"std.value.Value");
  let string = named_type(b"String");
  let making = |params: List<Type>| fn_type(params, value, row_empty());
  let pair = |a: Bytes, b: Bytes, t: Type| TyRecord([{ name: a, ty: t }, { name: b, ty: value }]);
  if [b"Equal", b"Less", b"Greater"].contains(name) { named_type(b"Ordering") }
  else if name == b"std.value.VRecord" { making([list_type(pair(b"name", b"value", string))]) }
  else if name == b"std.value.VShown" { making([string]) }
  else if name == b"std.value.VCtor" { making([string, list_type(value)]) }
  else if name == b"std.value.VMap" { making([list_type(pair(b"key", b"value", value))]) }
  else if name == b"std.value.VArray" || name == b"std.value.VList" { making([list_type(value)]) }
  else { unknown_type() }
}

/// Whether `t` is the record a map's entries list holds, `{key, value}`.
fn is_entry(t: Type) -> Bool =
  match t { TyRecord(fs) -> fs.map(|f: Field| f.name) == [b"key", b"value"], _ -> false }

/// The walks written for containers beside those of `reflect`, `shown` and `digest`: `equal` and
/// `ordered` of two, answering as `==` and `compare` do, and the loops the roots run from an index:
/// over two containers for those, and over one, gathering what each item writes, for the others.
fn walk_ops() -> List<Bytes> =
  [
    b"equal",
    b"equal_from",
    b"ordered",
    b"ordered_from",
    b"reflect_from",
    b"shown_from",
    b"digest_from",
    b"reflect_entries_from",
    b"shown_entries_from",
    b"digest_entries_from",
  ]

/// The loops a crossing runs over a container's items.
fn crossing_loops() -> List<Bytes> =
  [b"lower_items", b"lower_entries", b"lift_items", b"lift_entries"]

/// Whether the root of `Contained(op)` is written: a walk or a strings root `container_code` writes,
/// or a crossing's loop `crossing_root` writes.
pub fn contained_formed(op: Bytes) -> Bool =
  walk_ops().contains(op) || crossing_loops().contains(op) || strings_root(op)

/// Whether the root of `Contained(op)` only reads its operands, answering afresh: every walk, and
/// the loops that write a container's items into a lowering; the loops that read them from a
/// lifting take the container they add to.
pub fn contained_reads(op: Bytes) -> Bool =
  walk_ops().contains(op) || op == b"lower_items" || op == b"lower_entries"

/// Each root written for containers of type `t` in `module`, as a definition of the module, so a
/// root's call of another, or of itself, is a call of a definition: the two-container ones take
/// both and the loops an index after, the others take the container and the loops a list they add
/// to and an index after.
pub fn container_defs(module: Bytes, t: Type) -> List<Def> / {abort.raise} =
  [Reflect, Shown, Digest].concat(walk_ops().map(Contained)).map(|written_op: TypeOp| {
    let op = op_name(written_op);
    let root = keys::written(written_op, t, module);
    let typed = container_typed(op, t);
    {
      name: local_root(module, root_name(root)),
      ret: Some(if typed.ret == bool_type() { KBool } else { KBoxed }),
      ret_ty: TyOpen([]),
      pure: true,
      arity: typed.params.len(),
      scheme: Some(monomorphic(fn_type(typed.params, typed.ret, row_empty()))),
      witnesses: 0,
      lent: [],
      root: root,
    }
  })

/// What container root `op` written for `t` takes and answers: two containers a comparison, and an
/// index after them its loop; one container a reflection or digest, and the list it adds to and an
/// index after it its loop, which answers that list.
fn container_typed(op: Bytes, t: Type) -> { params: List<Type>, ret: Type } = {
  let value = TyCon({ name: b"std.value.Value", args: [] });
  let entries = list_type(TyRecord([{ name: b"key", ty: value }, { name: b"value", ty: value }]));
  let gathered = |l: Type| { params: [t, l, int_type()], ret: l };
  if op == b"equal" { { params: [t, t], ret: bool_type() } }
  else if op == b"ordered" { { params: [t, t], ret: named_type(b"Ordering") } }
  else if op == b"equal_from" { { params: [t, t, int_type()], ret: bool_type() } }
  else if op == b"ordered_from" { { params: [t, t, int_type()], ret: named_type(b"Ordering") } }
  else if op == b"reflect_from" || op == b"shown_from" { gathered(list_type(value)) }
  else if op == b"digest_from" || op == b"digest_entries_from" { gathered(list_type(bytes_type())) }
  else if op == b"reflect_entries_from" || op == b"shown_entries_from" { gathered(entries) }
  else if op == b"digest" { { params: [t], ret: bytes_type() } }
  else { { params: [t], ret: value } }
}

/// A root written for a type: its parameters, its body over them or why it has none, what its body
/// files, and the definitions its calls name, its own among them where it calls itself.
pub type WrittenRoot = {
  params: List<EmitParam>,
  code: Result<Code, Bytes>,
  typed: Map<Int, Typed>,
  here: List<Def>,
}

/// The root written for walk `op` of containers of type `t` in `module`, under the constructors
/// `ctors`: one `walked_code` writes (a reflection, a showing or a digest of the container, or one
/// `walk_ops` holds) over the container `a`, a second one `b` for a comparison, and an index `i` for
/// a comparison's or a gathering's loop. A strings root is `strings_code`'s, and a crossing's loops
/// are `crossing_root`'s.
pub fn container_code(
  module: Bytes,
  ctors: Ctors,
  op: Bytes,
  t: Type,
) -> WrittenRoot / {abort.raise} =
  if strings_root(op) { strings_code(module, op, t) } else {
    let e = walked_code(module, op, t);
    let word = |n: Bytes| { name: n, kind: KBoxed, ty: kind_of(t).ty, of: Some(t), lambda: None };
    let index = { name: b"i", kind: KInt, ty: TyOpen([]), of: Some(int_type()), lambda: None };
    {
      params: if op.ends_with(b"_from") { [word(b"a"), word(b"b"), index] }
      else if op == b"equal" || op == b"ordered" { [word(b"a"), word(b"b")] }
      else { [word(b"a")] },
      code: Ok(e.code),
      typed: e.typed,
      here: e.here,
    }
  }

/// The body of the root written for `op` of containers of type `t`, as lowered code over its
/// parameters `a`, `b` and, for the loops, `i`, the types it files, and the definitions its calls
/// name. Two lists or arrays are equal where they have one length and each
/// pair at an index is equal, and ordered by the first pair that is not equal, a shorter one first
/// where the other begins with it; two maps as the lists of their entries in key order are. A
/// container is reflected, shown or digested item by item at the items' type, a map entry by entry.
fn walked_code(
  module: Bytes,
  op: Bytes,
  t: Type,
) -> { code: Code, typed: Map<Int, Typed>, here: List<Def> } / {abort.raise} = {
  let at = |node: Node, span: Span| { node: node, span: span };
  let placed = |k: Int| { start: 0, end: k, site: k + 1 };
  let var = |name: Bytes, slot: Int| at(NVar({ name: name, slot: Some(slot) }), dummy_span());
  let named = |name: Bytes| at(NVar({ name: name, slot: None }), dummy_span());
  let lit = |l: Lit| at(NLit(l), dummy_span());
  let call = |f: Code, args: List<Code>| at(NApp({ func: f, args: args }), dummy_span());
  let builtin = |name: Bytes, k: Int| at(NVar({ name: name, slot: None }), placed(k));
  let binary = |op2: Bytes, l: Code, r: Code, k: Int|
    at(NBinary({ op: op2, lhs: l, rhs: r }), placed(k));
  let args = match t { TyCon(c) -> c.args, _ -> [] };
  let kind = match t { TyCon(c) -> c.name, _ -> b"" };
  let fields_of = match t { TyRecord(fs) -> fs, TyNominal(x) -> x.fields, _ -> [] };
  let value = TyCon({ name: b"std.value.Value", args: [] });
  // What a `Result`'s `Err` holds.
  let failure = match args.at(1) { Some(e) -> e, None -> unknown_type() };
  // A map is walked as the list of its entries.
  let walked = if kind == b"Map" {
    TyCon({
      name: b"List",
      args: [
        TyRecord([
          { name: b"key", ty: match args.at(0) { Some(k) -> k, None -> unknown_type() } },
          { name: b"value", ty: match args.at(1) { Some(v) -> v, None -> unknown_type() } },
        ]),
      ],
    })
  } else { t };
  let item = match walked {
    TyCon(c) -> match c.args.at(0) { Some(e) -> e, None -> unknown_type() },
    _ -> unknown_type(),
  };
  let field = |name: Bytes|
    match item {
      TyRecord(fs) ->
        fs.fold(unknown_type(), |acc: Type, f: Field| if f.name == name { f.ty } else { acc }),
      _ -> unknown_type(),
    };
  let of = if kind == b"Array" { b"Array::" } else { b"List::" };
  let loop_named = |name: Bytes|
    local_root(module, root_name(keys::written(Contained(name), walked, module)));
  let here = if kind == b"Map" { container_defs(module, t).concat(container_defs(module, walked)) }
  else { container_defs(module, t) };
  let entry_of_values = TyRecord([{ name: b"key", ty: value }, { name: b"value", ty: value }]);
  // What a loop gathering one container's items pushes onto the list it answers.
  let gathered_item = if op == b"digest_from" || op == b"digest_entries_from" { bytes_type() }
  else if op == b"reflect_entries_from" || op == b"shown_entries_from" { entry_of_values }
  else { value };
  let typed = [
    { k: 0, ty: filed_as(unknown_type(), args) },
    { k: 1, ty: filed_as(unknown_type(), args) },
    { k: 3, ty: filed_as(unknown_type(), [item]) },
    { k: 4, ty: filed_as(unknown_type(), [item]) },
    { k: 5, ty: filed_as(item, []) },
    { k: 6, ty: filed_as(item, []) },
    { k: 9, ty: filed_as(unknown_type(), [item]) },
    { k: 13, ty: filed_as(unknown_type(), [item]) },
    { k: 14, ty: filed_as(TyCon({ name: b"List", args: [value] }), []) },
    { k: 15, ty: filed_as(unknown_type(), [item]) },
    { k: 16, ty: filed_as(unknown_type(), [field(b"key")]) },
    { k: 17, ty: filed_as(unknown_type(), [field(b"value")]) },
    { k: 18, ty: filed_as(entry_of_values, []) },
    { k: 19, ty: filed_as(TyCon({ name: b"List", args: [entry_of_values] }), []) },
    { k: 20, ty: filed_as(TyCon({ name: b"List", args: [bytes_type()] }), []) },
    { k: 21, ty: filed_as(unknown_type(), [int_type()]) },
    { k: 23, ty: filed_as(failure, []) },
    { k: 24, ty: filed_as(failure, []) },
    { k: 25, ty: filed_as(unknown_type(), [failure]) },
    { k: 28, ty: filed_as(unknown_type(), [gathered_item]) },
  ].fold(Map::new(), |m: Map<Int, Typed>, x: { k: Int, ty: Typed }|
    m.insert(placed(x.k).site, x.ty));
  let a = var(b"a", 0);
  let b = var(b"b", 1);
  let i = var(b"i", 2);
  let x = var(b"x", 3);
  let next = binary(b"add", i, lit(LInt(1)), 8);
  let length = |c: Code, k: Int|
    call(builtin(if kind == b"Map" { b"Map::len" } else { of.concat(b"len") }, k), [c]);
  let some = |name: Bytes, slot: Int, k: Int|
    PxCtor({ name: b"Some", args: [PxVar({ name: name, slot: Some(slot), span: placed(k) })] });
  let none = PxCtor({ name: b"None", args: [] });
  // An array's item is read by the inline `Array::get`, so no root calls a prelude function the
  // program may not reach.
  let match_at = |list: Code, k: Int, name: Bytes, slot: Int, binder: Int, found: Code, ended: Code|
    if kind == b"Array" {
      at(
        NIf({
          cond: binary(b"lt", i, length(list, k), 27),
          then_branch: at(
            NBlock({
              stmts: [
                CLet({ name: name, slot: slot, value: call(builtin(b"Array::get", k), [list, i]) }),
              ],
              tail: Some(found),
            }),
            dummy_span(),
          ),
          else_branch: ended,
        }),
        dummy_span(),
      )
    } else {
      at(
        NMatch({
          scrutinee: call(builtin(b"List::at", k), [list, i]),
          arms: [
            { pat: some(name, slot, binder), guard: None, body: found },
            { pat: none, guard: None, body: ended },
          ],
        }),
        dummy_span(),
      )
    };
  // The list or array walked, a map's entries for a map.
  let walked_of = |c: Code, k: Int|
    if kind == b"Map" { call(builtin(b"Map::entries", k), [c]) } else { c };
  // What a loop over one container adds to `b` for the item `x`.
  let part = |builtin_name: Bytes, c: Code, k: Int| call(builtin(builtin_name, k), [c]);
  let gathered = |name: Bytes, pushed: (Code) -> Code|
    match_at(a, 3, b"x", 3, 5, call(named(loop_named(name)), [a, pushed(b), next]), b);
  let push = |list: Code, v: Code| call(builtin(b"List::push", 28), [list, v]);
  let entry = |builtin_name: Bytes|
    at(
      NRecord({
        fields: [
          {
            name: b"key",
            value: part(builtin_name, at(NField({ base: x, field: b"key" }), dummy_span()), 16),
          },
          {
            name: b"value",
            value: part(builtin_name, at(NField({ base: x, field: b"value" }), dummy_span()), 17),
          },
        ],
      }),
      placed(18),
    );
  let empty = |k: Int| at(NList({ items: [] }), placed(k));
  // `?compare` of the two items, or of their field `name`, and `then` where it answers `Equal`.
  let ordered_then = |name: Bytes, k: Int, slot: Int, eq_at: Int, then: Code| {
    let read = |c: Code|
      if name == b"" { c } else { at(NField({ base: c, field: name }), dummy_span()) };
    let o = b"o".concat(ascii_of_int(slot));
    at(
      NBlock({
        stmts: [
          CLet({
            name: o,
            slot: slot,
            value: call(builtin(b"?compare", k), [read(x), read(var(b"y", 4))]),
          }),
        ],
        tail: Some(
          at(
            NIf({
              cond: binary(b"eq", var(o, slot), said(b"Equal"), eq_at),
              then_branch: then,
              else_branch: var(o, slot),
            }),
            dummy_span(),
          ),
        ),
      }),
      dummy_span(),
    )
  };
  let body = if kind == b"" && op == b"equal" {
    // A record's fields in the order their names sort, each compared at its own type.
    range(0, fields_of.len()).fold(lit(LBool(true)), |acc: Code, k: Int| {
      let f = fields_of.get(k);
      let read = |c: Code| at(NField({ base: c, field: f.name }), dummy_span());
      let eq = binary(b"eq", read(a), read(b), 40 + k);
      if k == 0 { eq } else { at(NBinary({ op: b"and", lhs: acc, rhs: eq }), dummy_span()) }
    })
  } else if kind == b"Result" {
    let arm = |pat: CodePattern, body2: Code| { pat: pat, guard: None, body: body2 };
    let on = |scrutinee: Code, arms: List<CodeArm>|
      at(NMatch({ scrutinee: scrutinee, arms: arms }), dummy_span());
    let one = |ctor: Bytes, slot: Int, k: Int|
      PxCtor({
        name: ctor,
        args: [
          PxVar({ name: if slot == 3 { b"x" } else { b"y" }, slot: Some(slot), span: placed(k) }),
        ],
      });
    let other = |ctor: Bytes| PxCtor({ name: ctor, args: [PxWild] });
    let y = var(b"y", 4);
    if op == b"equal" {
      on(a, [
        arm(
          one(b"Ok", 3, 5),
          on(b, [arm(one(b"Ok", 4, 6), binary(b"eq", x, y, 7)), arm(PxWild, lit(LBool(false)))]),
        ),
        arm(
          one(b"Err", 3, 23),
          on(b, [arm(one(b"Err", 4, 24), binary(b"eq", x, y, 26)), arm(PxWild, lit(LBool(false)))]),
        ),
      ])
    } else {
      on(a, [
        arm(
          one(b"Err", 3, 23),
          on(b, [
            arm(one(b"Err", 4, 24), call(builtin(b"?compare", 25), [x, y])),
            arm(other(b"Ok"), said(b"Less")),
          ]),
        ),
        arm(
          one(b"Ok", 3, 5),
          on(b, [
            arm(one(b"Ok", 4, 6), call(builtin(b"?compare", 9), [x, y])),
            arm(other(b"Err"), said(b"Greater")),
          ]),
        ),
      ])
    }
  } else if kind == b"Option" {
    let arm = |pat: CodePattern, body2: Code| { pat: pat, guard: None, body: body2 };
    let on = |scrutinee: Code, arms: List<CodeArm>|
      at(NMatch({ scrutinee: scrutinee, arms: arms }), dummy_span());
    on(a, [
      arm(none, on(b, [arm(none, said(b"Equal")), arm(PxWild, said(b"Less"))])),
      arm(
        some(b"x", 3, 5),
        on(b, [
          arm(none, said(b"Greater")),
          arm(some(b"y", 4, 6), call(builtin(b"?compare", 9), [x, var(b"y", 4)])),
        ]),
      ),
    ])
  } else if op == b"equal" {
    at(
      NIf({
        cond: binary(b"eq", length(a, 0), length(b, 1), 2),
        then_branch: call(named(loop_named(b"equal_from")), [
          walked_of(a, 0),
          walked_of(b, 1),
          lit(LInt(0)),
        ]),
        else_branch: lit(LBool(false)),
      }),
      dummy_span(),
    )
  } else if op == b"ordered" {
    itself_equal(
      call(named(loop_named(b"ordered_from")), [walked_of(a, 0), walked_of(b, 1), lit(LInt(0))]),
    )
  } else if op == b"equal_from" {
    match_at(
      a,
      3,
      b"x",
      3,
      5,
      match_at(
        b,
        4,
        b"y",
        4,
        6,
        at(
          NIf({
            cond: binary(b"eq", x, var(b"y", 4), 7),
            then_branch: call(named(loop_named(b"equal_from")), [a, b, next]),
            else_branch: lit(LBool(false)),
          }),
          dummy_span(),
        ),
        lit(LBool(false)),
      ),
      lit(LBool(true)),
    )
  } else if op == b"ordered_from" {
    match_at(
      a,
      3,
      b"x",
      3,
      5,
      match_at(
        b,
        4,
        b"y",
        4,
        6,
        // Item by item, a map's entry by its key and then its value.
        if is_entry(item) {
          ordered_then(
            b"key",
            16,
            5,
            10,
            ordered_then(
              b"value",
              17,
              6,
              22,
              call(named(loop_named(b"ordered_from")), [a, b, next]),
            ),
          )
        } else {
          ordered_then(b"", 9, 5, 10, call(named(loop_named(b"ordered_from")), [a, b, next]))
        },
        said(b"Greater"),
      ),
      at(
        NIf({
          cond: binary(b"lt", i, call(builtin(of.concat(b"len"), 13), [b]), 12),
          then_branch: said(b"Less"),
          else_branch: said(b"Equal"),
        }),
        dummy_span(),
      ),
    )
  } else if op == b"reflect_from" || op == b"shown_from" {
    let name = if op == b"reflect_from" { b"?reflect" } else { b"?shown" };
    gathered(op, |out: Code| push(out, part(name, x, 15)))
  } else if op == b"digest_from" { gathered(op, |out: Code| push(out, part(b"?encoded", x, 15))) }
  else if op == b"reflect_entries_from" || op == b"shown_entries_from" {
    let name = if op == b"reflect_entries_from" { b"?reflect" } else { b"?shown" };
    gathered(op, |out: Code| push(out, entry(name)))
  } else if op == b"digest_entries_from" {
    gathered(op, |out: Code|
      push(
        push(out, part(b"?encoded", at(NField({ base: x, field: b"key" }), dummy_span()), 16)),
        part(b"?encoded", at(NField({ base: x, field: b"value" }), dummy_span()), 17),
      ))
  } else if op == b"digest" {
    // The encoding `digest.rs` writes: the container's tag and count, then each item's encoding;
    // a count's eight bytes are an `Int` encoding's past its tag.
    let tag = if kind == b"Map" { 11 } else if kind == b"Array" { 10 } else { 9 };
    let loop_name = if kind == b"Map" { b"digest_entries_from" } else { b"digest_from" };
    call(named(b"?concat"), [
      said_list(
        [
          lit(LBytes(byte_of_int(tag))),
          call(said(b"Bytes::slice"), [
            part(b"?encoded", length(a, 0), 21),
            lit(LInt(1)),
            lit(LInt(9)),
          ]),
          call(named(b"?concat"), [
            call(named(loop_named(loop_name)), [walked_of(a, 1), empty(20), lit(LInt(0))]),
          ]),
        ],
        0,
      ),
    ])
  } else {
    // `reflect` or `shown`: the container's constructor of `std.value.Value` over its items'.
    let reflecting = op == b"reflect";
    let made = if kind == b"Map" { b"std.value.VMap" }
    else if kind == b"Array" { b"std.value.VArray" }
    else { b"std.value.VList" };
    let loop_name = if kind == b"Map" {
      if reflecting { b"reflect_entries_from" } else { b"shown_entries_from" }
    } else if reflecting { b"reflect_from" }
    else { b"shown_from" };
    call(said(made), [
      call(named(loop_named(loop_name)), [
        walked_of(a, 1),
        empty(if kind == b"Map" { 19 } else { 14 }),
        lit(LInt(0)),
      ]),
    ])
  };
  {
    code: body,
    typed: said_typed(typed, [TyCon({ name: b"List", args: [bytes_type()] })]),
    here: here,
  }
}

/// The name `root`, written in `module`, has there.
pub fn local_root(module: Bytes, root: Bytes) -> Bytes / {abort.raise} =
  if module.len() == 0 { root } else { root.slice(module.len() + 1, root.len()) }

/// The body of `T#eq` for a sum of constructors `cs`, as lowered code over its two parameters, and the
/// binder types it files: each constructor's arguments compared in turn where both are that
/// constructor.
pub fn equality_code(cs: List<SumCtor>) -> { code: Code, typed: Map<Int, Typed> } = {
  let at = |node: Node, span: Span| { node: node, span: span };
  let placed = |k: Int| { start: 0, end: k, site: k + 1 };
  let var = |name: Bytes, slot: Int| at(NVar({ name: name, slot: Some(slot) }), dummy_span());
  let walked = range(0, cs.len()).fold(
    { arms: [], typed: Map::new(), next: 0 },
    |acc: { arms: List<CodeArm>, typed: Map<Int, Typed>, next: Int }, i: Int| {
      let c = match cs.at(i) {
        Some(x) -> x,
        None -> { name: b"", index: 0, fields: [], params: [] },
      };
      let k = c.fields.len();
      let binder = |side: Int, j: Int|
        {
          name: Bytes::concat_all([if side == 0 { b"x" } else { b"y" }, ascii_of_int(j)]),
          slot: Some(2 + side * k + j),
          span: placed(acc.next + side * k + j),
        };
      let typed = range(0, 2 * k).fold(acc.typed, |m: Map<Int, Typed>, n: Int|
        m.insert(
          placed(acc.next + n).site,
          filed_as(match c.fields.at(n % k) { Some(t) -> t, None -> unknown_type() }, []),
        ));
      let compares = range(0, k).map(|j: Int|
        {
          span: placed(acc.next + 2 * k + j),
          ty: match c.fields.at(j) { Some(t) -> t, None -> unknown_type() },
        });
      let same = range(0, k).fold(at(NLit(LBool(true)), dummy_span()), |acc2: Code, j: Int| {
        let eq = at(
          NBinary({
            op: b"eq",
            lhs: var(b"x".concat(ascii_of_int(j)), 2 + j),
            rhs: var(b"y".concat(ascii_of_int(j)), 2 + k + j),
          }),
          match compares.at(j) { Some(x) -> x.span, None -> dummy_span() },
        );
        if j == 0 { eq } else { at(NBinary({ op: b"and", lhs: acc2, rhs: eq }), dummy_span()) }
      });
      let inner = at(
        NMatch({
          scrutinee: var(b"b", 1),
          arms: [
            {
              pat: PxCtor({ name: c.name, args: range(0, k).map(|j: Int| PxVar(binder(1, j))) }),
              guard: None,
              body: same,
            },
            { pat: PxWild, guard: None, body: at(NLit(LBool(false)), dummy_span()) },
          ],
        }),
        dummy_span(),
      );
      {
        arms: acc.arms.push({
          pat: PxCtor({ name: c.name, args: range(0, k).map(|j: Int| PxVar(binder(0, j))) }),
          guard: None,
          body: inner,
        }),
        typed: typed,
        next: acc.next + 3 * k,
      }
    },
  );
  {
    code: at(NMatch({ scrutinee: var(b"a", 0), arms: walked.arms }), dummy_span()),
    typed: walked.typed,
  }
}

/// The body of `T#cmp` for a sum of constructors `cs`, as lowered code over its two parameters, and
/// the binder and call types it files: as the evaluator orders two constructors' values, by the
/// constructors' names and then by each argument in turn as its type orders.
pub fn ordering_code(cs: List<SumCtor>) -> { code: Code, typed: Map<Int, Typed> } = {
  let at = |node: Node, span: Span| { node: node, span: span };
  let placed = |k: Int| { start: 0, end: k, site: k + 1 };
  let var = |name: Bytes, slot: Int| at(NVar({ name: name, slot: Some(slot) }), dummy_span());
  let rank = |c: SumCtor|
    cs.fold(0, |n: Int, d: SumCtor| if compare(d.name, c.name) == Less { n + 1 } else { n });
  let ranked = |scrutinee: Code|
    at(
      NMatch({
        scrutinee: scrutinee,
        arms: cs.map(|c: SumCtor|
          {
            pat: PxCtor({ name: c.name, args: c.fields.map(|_: Type| PxWild) }),
            guard: None,
            body: at(NLit(LInt(rank(c))), dummy_span()),
          }),
      }),
      dummy_span(),
    );
  let walked = range(0, cs.len()).fold(
    { arms: [], typed: Map::new(), next: 2, slot: 4 },
    |acc: { arms: List<CodeArm>, typed: Map<Int, Typed>, next: Int, slot: Int }, i: Int| {
      let c = match cs.at(i) {
        Some(x) -> x,
        None -> { name: b"", index: 0, fields: [], params: [] },
      };
      let k = c.fields.len();
      let ty = |j: Int| match c.fields.at(j) { Some(t) -> t, None -> unknown_type() };
      let binder = |side: Int, j: Int|
        {
          name: Bytes::concat_all([if side == 0 { b"x" } else { b"y" }, ascii_of_int(j)]),
          slot: Some(acc.slot + side * k + j),
          span: placed(acc.next + side * k + j),
        };
      // Each binder's type, and each `compare`'s type argument, filed where the emitter reads it.
      let typed = range(0, 3 * k).fold(acc.typed, |m: Map<Int, Typed>, n: Int|
        m.insert(placed(acc.next + n).site, if n < 2 * k { filed_as(ty(n % k), []) }
        else { filed_as(unknown_type(), [ty(n - 2 * k)]) }));
      let compared = |j: Int|
        at(
          NApp({
            func: at(NVar({ name: b"?compare", slot: None }), placed(acc.next + 2 * k + j)),
            args: [
              var(b"x".concat(ascii_of_int(j)), acc.slot + j),
              var(b"y".concat(ascii_of_int(j)), acc.slot + k + j),
            ],
          }),
          dummy_span(),
        );
      // The first argument that orders apart decides, from the last back to the first.
      let lex = range(0, k).fold(said(b"Equal"), |later: Code, n: Int| {
        let j = k - 1 - n;
        if j == k - 1 { compared(j) } else {
          let o = b"o".concat(ascii_of_int(j));
          let os = acc.slot + 2 * k + j;
          at(
            NBlock({
              stmts: [CLet({ name: o, slot: os, value: compared(j) })],
              tail: Some(
                at(
                  NIf({
                    cond: at(
                      NBinary({ op: b"eq", lhs: var(o, os), rhs: said(b"Equal") }),
                      placed(acc.next + 3 * k + j),
                    ),
                    then_branch: later,
                    else_branch: var(o, os),
                  }),
                  dummy_span(),
                ),
              ),
            }),
            dummy_span(),
          )
        }
      });
      let inner = at(
        NMatch({
          scrutinee: var(b"b", 1),
          arms: [
            {
              pat: PxCtor({ name: c.name, args: range(0, k).map(|j: Int| PxVar(binder(1, j))) }),
              guard: None,
              body: lex,
            },
            { pat: PxWild, guard: None, body: said(b"Equal") },
          ],
        }),
        dummy_span(),
      );
      {
        arms: acc.arms.push({
          pat: PxCtor({ name: c.name, args: range(0, k).map(|j: Int| PxVar(binder(0, j))) }),
          guard: None,
          body: inner,
        }),
        typed: typed,
        next: acc.next + 4 * k,
        slot: acc.slot + 3 * k,
      }
    },
  );
  let body = at(
    NIf({
      cond: at(NBinary({ op: b"lt", lhs: var(b"ra", 2), rhs: var(b"rb", 3) }), placed(0)),
      then_branch: said(b"Less"),
      else_branch: at(
        NIf({
          cond: at(NBinary({ op: b"gt", lhs: var(b"ra", 2), rhs: var(b"rb", 3) }), placed(1)),
          then_branch: said(b"Greater"),
          else_branch: at(NMatch({ scrutinee: var(b"a", 0), arms: walked.arms }), dummy_span()),
        }),
        dummy_span(),
      ),
    }),
    dummy_span(),
  );
  {
    code: itself_equal(
      at(
        NBlock({
          stmts: [
            CLet({ name: b"ra", slot: 2, value: ranked(var(b"a", 0)) }),
            CLet({ name: b"rb", slot: 3, value: ranked(var(b"b", 1)) }),
          ],
          tail: Some(body),
        }),
        dummy_span(),
      ),
    ),
    typed: said_typed(walked.typed, []),
  }
}

/// `order`, the body of a written root ordering its parameters `a` and `b`, answering `Equal` at
/// once where the two are one object: an order is reflexive, so nothing of it need be walked.
fn itself_equal(order: Code) -> Code = {
  let at = |node: Node| { node: node, span: dummy_span() };
  let var = |name: Bytes, slot: Int| at(NVar({ name: name, slot: Some(slot) }));
  at(
    NIf({
      cond: at(
        NApp({
          func: at(NVar({ name: b"?same", slot: None })),
          args: [var(b"a", 0), var(b"b", 1)],
        }),
      ),
      then_branch: said(b"Equal"),
      else_branch: order,
    }),
  )
}

/// `n`'s low 64 bits, least significant byte first.
fn le64(n: Int) -> Bytes =
  Bytes::concat_all(range(0, 8).map(|i: Int| byte_of_int(n >> 8 * i & 255)))

/// The body of the root `Digest` is written as for `ty`, over its parameter `a`, a value of `ty`,
/// and the types it files: the encoding `digest.rs` writes, a record's and a constructor's own
/// bytes written here and each part's encoding at its type. A type whose module states `key` is its
/// key's encoding; one stated generic is read by the runtime.
pub fn digest_code(
  module: Bytes,
  ctors: Ctors,
  here: List<Def>,
  items: List<Item>,
  ty: Type,
) -> { code: Code, typed: Map<Int, Typed> } / {abort.raise} = {
  let at = |node: Node| { node: node, span: dummy_span() };
  let placed = |k: Int| { start: 0, end: k, site: k + 1 };
  let var = |name: Bytes, slot: Int| at(NVar({ name: name, slot: Some(slot) }));
  let named = |name: Bytes| at(NVar({ name: name, slot: None }));
  let call = |f: Code, args: List<Code>| at(NApp({ func: f, args: args }));
  let written = |b: Bytes| at(NLit(LBytes(b)));
  let counted = |tag: Int, n: Int| byte_of_int(tag).concat(le64(n));
  let blob = |tag: Int, b: Bytes| counted(tag, b.len()).concat(b);
  // `x` encoded at its type: a call the emitter settles by what is filed at `k`.
  let part = |x: Code, k: Int|
    at(
      NApp({ func: { node: NVar({ name: b"?encoded", slot: None }), span: placed(k) }, args: [x] }),
    );
  let parted = |m: Map<Int, Typed>, t: Type, k: Int|
    m.insert(placed(k).site, filed_as(unknown_type(), [t]));
  let joined = |parts: List<Code>| call(named(b"?concat"), [said_list(parts, 0)]);
  // The runtime's encoding, of a type this root cannot write.
  let read = { code: part(var(b"a", 0), 1), typed: Map::new() };
  let fields_of = match ty { TyRecord(fs) -> Some(fs), TyNominal(x) -> Some(x.fields), _ -> None };
  let out = match fields_of {
    Some(fs) -> {
      let walked = range(0, fs.len()).fold(
        { parts: [written(counted(12, fs.len()))], typed: Map::new() },
        |acc: { parts: List<Code>, typed: Map<Int, Typed> }, i: Int|
          match fs.at(i) {
            None -> acc,
            Some(f) ->
              {
                parts: acc.parts.concat([
                  written(blob(13, f.name)),
                  part(at(NField({ base: var(b"a", 0), field: f.name })), i + 1),
                ]),
                typed: parted(acc.typed, f.ty, i + 1),
              },
          },
      );
      { code: joined(walked.parts), typed: walked.typed }
    },
    None -> match ty {
      TyCon(c) -> match ctors.sums.get(c.name) {
        None -> read,
        Some(cs) -> {
          let stated = items.fold(None, |acc: Option<Bytes>, item: Item|
            match item {
              IInstance(d) -> if d.kind == NKey && qualify(module, d.target.name) == c.name {
                Some(d.by.name)
              } else { acc },
              _ -> acc,
            });
          let scheme = |f: Bytes|
            here.fold(None, |s: Option<Scheme>, h: Def| if h.name == f { h.scheme } else { s });
          match stated {
            // Values whose keys are equal are equal, so the key is what is written.
            Some(f) -> match scheme(f) {
              Some(s) -> match s.ty {
                TyFn(fn_ty) -> if s.ty_vars.len() > 0 { read } else {
                  {
                    code: joined([
                      written(byte_of_int(16)),
                      part(call(named(f), [var(b"a", 0)]), 1),
                    ]),
                    typed: parted(Map::new(), fn_ty.ret, 1),
                  }
                },
                _ -> read,
              },
              None -> read,
            },
            None -> {
              let walked = cs.fold(
                { arms: [], typed: Map::new(), next: 1, slot: 1 },
                |acc: { arms: List<CodeArm>, typed: Map<Int, Typed>, next: Int, slot: Int }, sc: SumCtor| {
                  let k = sc.fields.len();
                  let arg = |j: Int|
                    at_args(
                      match sc.fields.at(j) { Some(t) -> t, None -> unknown_type() },
                      sc.params,
                      c.args,
                    );
                  let dot = range(0, sc.name.len()).fold(0 - 1, |d: Int, i: Int|
                    if sc.name.at(i) == 46 { i } else { d });
                  let simple = sc.name.slice(dot + 1, sc.name.len());
                  {
                    arms: acc.arms.push({
                      pat: PxCtor({
                        name: sc.name,
                        args: range(0, k).map(|j: Int|
                          PxVar({
                            name: b"x".concat(ascii_of_int(j)),
                            slot: Some(acc.slot + j),
                            span: placed(acc.next + 2 * j),
                          })),
                      }),
                      guard: None,
                      body: joined(
                        [written(blob(14, simple).concat(counted(15, k)))].concat(
                          range(0, k).map(|j: Int|
                            part(
                              var(b"x".concat(ascii_of_int(j)), acc.slot + j),
                              acc.next + 2 * j + 1,
                            )),
                        ),
                      ),
                    }),
                    typed: range(0, k).fold(acc.typed, |m: Map<Int, Typed>, j: Int|
                      parted(
                        m.insert(placed(acc.next + 2 * j).site, filed_as(arg(j), [])),
                        arg(j),
                        acc.next + 2 * j + 1,
                      )),
                    next: acc.next + 2 * k,
                    slot: acc.slot + k,
                  }
                },
              );
              {
                code: at(NMatch({ scrutinee: var(b"a", 0), arms: walked.arms })),
                typed: walked.typed,
              }
            },
          }
        },
      },
      _ -> read,
    },
  };
  { ..out, typed: said_typed(out.typed, [TyCon({ name: b"List", args: [bytes_type()] })]) }
}

/// The body of the root `Reflect` or `Shown` is written as for `ty`, over its parameter `a`, and the
/// types it files: a record's fields in their names' order, and a declared sum's constructor's name
/// and arguments, each part reflected at its own type. Under `shown`, a sum whose module states a
/// `show` is what that function writes; one stated generic is read by the runtime.
pub fn reflection_code(
  module: Bytes,
  ctors: Ctors,
  here: List<Def>,
  items: List<Item>,
  shown: Bool,
  ty: Type,
) -> { code: Code, typed: Map<Int, Typed> } = {
  let at = |node: Node| { node: node, span: dummy_span() };
  let placed = |k: Int| { start: 0, end: k, site: k + 1 };
  let var = |name: Bytes, slot: Int| at(NVar({ name: name, slot: Some(slot) }));
  let named = |name: Bytes| at(NVar({ name: name, slot: None }));
  let call = |f: Code, args: List<Code>| at(NApp({ func: f, args: args }));
  let builtin = if shown { b"?shown" } else { b"?reflect" };
  // `x`, of type `t`, reflected at its type: a call the emitter settles by what is filed at `k`.
  let part = |x: Code, k: Int|
    at(NApp({ func: { node: NVar({ name: builtin, slot: None }), span: placed(k) }, args: [x] }));
  let parted = |m: Map<Int, Typed>, t: Type, k: Int|
    m.insert(placed(k).site, filed_as(unknown_type(), [t]));
  let fields_of = match ty { TyRecord(fs) -> Some(fs), TyNominal(x) -> Some(x.fields), _ -> None };
  let value = TyCon({ name: b"std.value.Value", args: [] });
  let field = TyRecord([
    { name: b"name", ty: TyCon({ name: b"String", args: [] }) },
    { name: b"value", ty: value },
  ]);
  let out = match fields_of {
    Some(fs) -> {
      let walked = range(0, fs.len()).fold(
        { items: [], typed: Map::new() },
        |acc: { items: List<Code>, typed: Map<Int, Typed> }, i: Int|
          match fs.at(i) {
            None -> acc,
            Some(f) ->
              {
                items: acc.items.push({
                  node: NRecord({
                    fields: [
                      { name: b"name", value: at(NLit(LStr(f.name))) },
                      {
                        name: b"value",
                        value: part(at(NField({ base: var(b"a", 0), field: f.name })), 2 * i + 1),
                      },
                    ],
                  }),
                  span: placed(2 * i + 2),
                }),
                typed: parted(acc.typed, f.ty, 2 * i + 1).insert(
                  placed(2 * i + 2).site,
                  filed_as(field, []),
                ),
              },
          },
      );
      { code: call(said(b"std.value.VRecord"), [said_list(walked.items, 0)]), typed: walked.typed }
    },
    None -> match ty {
      TyCon(c) -> match ctors.sums.get(c.name) {
        None -> { code: part(var(b"a", 0), 1), typed: Map::new() },
        Some(cs) -> {
          let stated = if !shown { None } else {
            items.fold(None, |acc: Option<Bytes>, item: Item|
              match item {
                IInstance(d) -> if d.kind != NKey && qualify(module, d.target.name) == c.name {
                  Some(d.by.name)
                } else { acc },
                _ -> acc,
              })
          };
          let generic = |f: Bytes|
            here.fold(false, |g: Bool, h: Def|
              g
                || (h.name == f
                && (match h.scheme { Some(s) -> s.ty_vars.len() > 0, None -> false })));
          match stated {
            // What the runtime reads, it reads through the function at the type it is called at.
            Some(f) -> if generic(f) { { code: part(var(b"a", 0), 1), typed: Map::new() } } else {
              {
                code: call(said(b"std.value.VShown"), [call(named(f), [var(b"a", 0)])]),
                typed: Map::new(),
              }
            },
            None -> {
              let walked = cs.fold(
                { arms: [], typed: Map::new(), next: 1, slot: 1 },
                |acc: { arms: List<CodeArm>, typed: Map<Int, Typed>, next: Int, slot: Int }, sc: SumCtor| {
                  let k = sc.fields.len();
                  let arg = |j: Int|
                    at_args(
                      match sc.fields.at(j) { Some(t) -> t, None -> unknown_type() },
                      sc.params,
                      c.args,
                    );
                  let typed = range(0, k).fold(acc.typed, |m: Map<Int, Typed>, j: Int|
                    parted(
                      m.insert(placed(acc.next + 2 * j).site, filed_as(arg(j), [])),
                      arg(j),
                      acc.next + 2 * j + 1,
                    ));
                  {
                    arms: acc.arms.push({
                      pat: PxCtor({
                        name: sc.name,
                        args: range(0, k).map(|j: Int|
                          PxVar({
                            name: b"x".concat(ascii_of_int(j)),
                            slot: Some(acc.slot + j),
                            span: placed(acc.next + 2 * j),
                          })),
                      }),
                      guard: None,
                      body: call(said(b"std.value.VCtor"), [
                        at(NLit(LStr(sc.name))),
                        said_list(
                          range(0, k).map(|j: Int|
                            part(
                              var(b"x".concat(ascii_of_int(j)), acc.slot + j),
                              acc.next + 2 * j + 1,
                            )),
                          1,
                        ),
                      ]),
                    }),
                    typed: typed,
                    next: acc.next + 2 * k,
                    slot: acc.slot + k,
                  }
                },
              );
              {
                code: at(NMatch({ scrutinee: var(b"a", 0), arms: walked.arms })),
                typed: walked.typed,
              }
            },
          }
        },
      },
      _ -> { code: part(var(b"a", 0), 1), typed: Map::new() },
    },
  };
  {
    ..out,
    typed: said_typed(out.typed, [
      TyCon({ name: b"List", args: [field] }),
      TyCon({ name: b"List", args: [value] }),
    ]),
  }
}

// --- Crossings --------------------------------------------------------------------------------

/// Whether root `op` of a type is one a crossing runs, which `crossing_root` writes: a lowering, a
/// lifting, or a loop of one over a container's items.
pub fn crossing_op(op: TypeOp) -> Bool =
  match op { Lower -> true, Lift -> true, Contained(c) -> crossing_loops().contains(c), _ -> false }

/// The root `key`, written in `module`, a crossing runs: `lower#T`, which writes the `T` it reads
/// into the innermost lowering as PLV1 holds it and answers `()`; `lift#T`, which reads a `T` from
/// the innermost lifting and answers it as compiled code makes one; or a loop of one over a
/// container's items (`crossing_loop`). The places of `T` the key marks cross carried: a value the
/// runtime keeps with its type, as `HANDLE`, rather than reads.
pub fn crossing_root(module: Bytes, ctors: Ctors, key: RootKey) -> WrittenRoot / {abort.raise} =
  match key {
    Written(w) -> {
      let marked = marked_type(w.ty, w.marks);
      match w.op {
        Lower -> rooted_at(module, key, [w.ty], unit_type(), lowering_code(module, ctors, marked)),
        Lift -> rooted_at(module, key, [], w.ty, lifting_code(module, ctors, marked)),
        Contained(c) -> match crossing_loop(module, c, w.ty, marked) {
          Some(r) -> r,
          None -> unwritten(module, key, b"a root no crossing runs"),
        },
        _ -> unwritten(module, key, b"a root no crossing runs"),
      }
    },
    _ -> unwritten(module, key, b"a root no crossing runs"),
  }

/// Root `key` refused, saying why.
fn unwritten(module: Bytes, key: RootKey, why: Bytes) -> WrittenRoot / {abort.raise} =
  rooted_at(module, key, [], unit_type(), { code: Err(why), w: writing(), here: [] })

/// The loop `op` a crossing runs over the items of a container of type `t`, `marked` with its
/// carried places, where `op` names one: `lower_items` and `lower_entries` over a list's items or a
/// map's entries from an index, `lift_items` and `lift_entries` onto a list or a map so far for as
/// many items as are left.
fn crossing_loop(
  module: Bytes,
  op: Bytes,
  t: Type,
  marked: Type,
) -> Option<WrittenRoot> / {abort.raise} = {
  let key = marked_key(Contained(op), marked, module);
  match item_of(marked) {
    None -> None,
    Some(item) -> if op == b"lower_items" {
      Some(
        rooted_at(
          module,
          key,
          [t, int_type()],
          unit_type(),
          items_lowered(module, key, marked, item),
        ),
      )
    } else if op == b"lower_entries" {
      Some(rooted_at(module, key, [t, int_type()], unit_type(), entries_lowered(module, key, item)))
    } else if op == b"lift_items" {
      Some(rooted_at(module, key, [t, int_type()], t, items_lifted(module, key, item)))
    } else if op == b"lift_entries" {
      Some(rooted_at(module, key, [t, int_type()], t, entries_lifted(module, key, marked)))
    } else { None },
  }
}

/// The root `R#entered` the runtime enters root `root` of `module` through, `root` taking `params`
/// and answering `answer`: from the lifting the runtime opened over the list of its arguments'
/// encodings, each argument read and the lifting ended; then `root` called on them, and its answer
/// written into the lowering the runtime opened beneath, which it ends.
pub fn entered_code(
  module: Bytes,
  root: Bytes,
  params: List<Type>,
  answer: Type,
) -> WrittenRoot / {abort.raise} = {
  let key = keys::Entered(root);
  let read = range(0, params.len()).fold(
    { stmts: [CDo({ code: native_call(b"?in_count", [int_code(tag_list())]) })], w: writing() },
    |acc: { stmts: List<CodeStmt>, w: Writing }, i: Int| {
      let l = call_at(acc.w, b"?lift", [], [params.get(i)]);
      {
        stmts: acc.stmts.push(CLet({ name: b"p".concat(ascii_of_int(i)), slot: i, value: l.code })),
        w: l.w,
      }
    },
  );
  let called = bare(
    NApp({
      func: bare(NVar({ name: local_root(module, root), slot: None })),
      args: range(0, params.len()).map(|i: Int| slot_code(b"p".concat(ascii_of_int(i)), i)),
    }),
  );
  let written = call_at(read.w, b"?lower", [called], [answer]);
  rooted_at(module, key, [], unit_type(), {
    code: Ok(
      bare(
        NBlock({
          stmts: read.stmts.push(CDo({ code: native_call(b"?lift_close", []) })),
          tail: Some(written.code),
        }),
      ),
    ),
    w: written.w,
    here: [
      {
        name: local_root(module, root),
        ret: Some(kind_of(answer).kind),
        ret_ty: TyOpen([]),
        pure: false,
        arity: params.len(),
        scheme: Some(monomorphic(fn_type(params, answer, row_empty()))),
        witnesses: 0,
        lent: [],
        root: Named(root),
      },
    ],
  })
}

/// The body of `lower#T` over its parameter `a`, a value of `ty`, what it files, and the
/// definitions of the loops it calls: a scalar by the crossing native for its kind, a record its
/// fields in name order each after its name, a declared sum its constructor by program-wide name
/// and its arguments, a list, an array or a map its count and its items (a map's each key then its
/// value, in key order; a `Columns` as the array of its records the runtime reads it as), a runtime
/// object as a handle and a function as an anonymous one. A string,
/// bytes, list, array or map is asked after first, and written as `AGAIN` where the lowering shares
/// values and wrote it before.
fn lowering_code(
  module: Bytes,
  ctors: Ctors,
  ty: Type,
) -> { code: Result<Code, Bytes>, w: Writing, here: List<Def> } / {abort.raise} = {
  let a = slot_code(b"a", 0);
  let w = writing();
  let alone = |c: Code| { code: Ok(c), w: w, here: [] };
  let shared = |parts: List<Code>|
    bare(
      NIf({
        cond: binary_of(b"eq", native_call(b"?out_again", [a]), int_code(0)),
        then_branch: sequence(parts),
        else_branch: unit_code(),
      }),
    );
  let held = plain(ty);
  let args_at = match held { TyCon(c) -> c.args, _ -> [] };
  match ty {
    TyCon(c) -> if c.name == b"^" && c.args.len() == 1 {
      let carried = call_at(w, b"?out_carried", [a], [held]);
      { code: Ok(carried.code), w: carried.w, here: [] }
    } else if c.args.len() == 0 && c.name == b"Unit" {
      alone(native_call(b"?out_tag", [int_code(tag_unit())]))
    } else if c.args.len() == 0 && c.name == b"Bool" {
      alone(
        native_call(b"?out_tag", [
          bare(
            NIf({ cond: a, then_branch: int_code(tag_true()), else_branch: int_code(tag_false()) }),
          ),
        ]),
      )
    } else if c.args.len() == 0 && c.name == b"Int" { alone(native_call(b"?out_int", [a])) }
    else if c.args.len() == 0 && c.name == b"Float" { alone(native_call(b"?out_float", [a])) }
    else if c.args.len() == 0 && c.name == b"Decimal" { alone(native_call(b"?out_decimal", [a])) }
    else if c.args.len() == 0 && width_named(c.name) != None {
      alone(native_call(b"?out_fixed", [a]))
    } else if c.args.len() == 0 && c.name == b"Char" {
      let scalar = call_at(w, b"Int::of_char", [a], []);
      { code: Ok(native_call(b"?out_char", [scalar.code])), w: scalar.w, here: [] }
    } else if c.args.len() == 0 && c.name == b"String" {
      alone(shared([native_call(b"?out_str", [a])]))
    } else if c.args.len() == 0 && c.name == b"Bytes" {
      alone(shared([native_call(b"?out_bytes", [a])]))
    } else if runtime_object(c.name) { alone(native_call(b"?out_handle", [a])) }
    else if c.name == b"List" && c.args.len() == 1 {
      let n = call_at(w, b"List::len", [a], args_at);
      let items = marked_key(Contained(b"lower_items"), ty, module);
      {
        code: Ok(
          shared([
            native_call(b"?out_count", [int_code(tag_list()), n.code]),
            call_of(module, items, [a, int_code(0)]),
          ]),
        ),
        w: n.w,
        here: [def_of(module, items, [held, int_type()], unit_type())],
      }
    } else if (c.name == b"Array" || c.name == b"Columns") && c.args.len() == 1 {
      // A `Columns` crosses as the array of its records the runtime reads it as.
      let n = call_at(w, c.name.concat(b"::len"), [a], args_at);
      let items = marked_key(Contained(b"lower_items"), ty, module);
      {
        code: Ok(
          shared([
            native_call(b"?out_count", [int_code(tag_array()), n.code]),
            call_of(module, items, [a, int_code(0)]),
          ]),
        ),
        w: n.w,
        here: [def_of(module, items, [held, int_type()], unit_type())],
      }
    } else if c.name == b"Map" && c.args.len() == 2 {
      let entries = list_type(
        TyRecord([{ name: b"key", ty: c.args.get(0) }, { name: b"value", ty: c.args.get(1) }]),
      );
      let n = call_at(w, b"Map::len", [a], args_at);
      let listed = call_at(n.w, b"Map::entries", [a], args_at);
      let each = marked_key(Contained(b"lower_entries"), entries, module);
      {
        code: Ok(
          shared([
            native_call(b"?out_count", [int_code(tag_map()), n.code]),
            call_of(module, each, [listed.code, int_code(0)]),
          ]),
        ),
        w: listed.w,
        here: [def_of(module, each, [plain(entries), int_type()], unit_type())],
      }
    } else {
      match ctors.sums.get(c.name) {
        None ->
          { code: Err(b"a crossing of a type no root writes: ".concat(c.name)), w: w, here: [] },
        Some(cs) -> {
          let arms = cs.fold(
            { arms: [], w: w, slot: 1 },
            |acc: { arms: List<CodeArm>, w: Writing, slot: Int }, sc: SumCtor| {
              let args = sc.fields.map(|f: Type| at_args(f, sc.params, c.args));
              let bound = range(0, args.len()).fold(
                { pats: [], parts: [], w: acc.w },
                |b: { pats: List<CodePattern>, parts: List<Code>, w: Writing }, j: Int| {
                  let name = b"x".concat(ascii_of_int(j));
                  let binder = filing(b.w, filed_as(plain(args.get(j)), []));
                  let part = call_at(binder.w, b"?lower", [slot_code(name, acc.slot + j)], [
                    args.get(j),
                  ]);
                  {
                    pats: b.pats.push(
                      PxVar({ name: name, slot: Some(acc.slot + j), span: binder.span }),
                    ),
                    parts: b.parts.push(part.code),
                    w: part.w,
                  }
                },
              );
              {
                arms: acc.arms.push({
                  pat: PxCtor({ name: sc.name, args: bound.pats }),
                  guard: None,
                  body: sequence(
                    [native_call(b"?out_ctor", [bytes_code(sc.name), int_code(args.len())])].concat(
                      bound.parts,
                    ),
                  ),
                }),
                w: bound.w,
                slot: acc.slot + args.len(),
              }
            },
          );
          { code: Ok(bare(NMatch({ scrutinee: a, arms: arms.arms }))), w: arms.w, here: [] }
        },
      }
    },
    TyRecord(fs) -> record_lowered(a, fs, w),
    TyNominal(x) -> record_lowered(a, x.fields, w),
    TyFn(_) -> alone(native_call(b"?out_fun", [bytes_code(b"")])),
    TyVar(_) -> { code: Err(b"a crossing at a type variable"), w: w, here: [] },
  }
}

/// A record's fields written in name order, each its name and then its value.
fn record_lowered(
  a: Code,
  fields: List<Field>,
  w: Writing,
) -> { code: Result<Code, Bytes>, w: Writing, here: List<Def> } / {abort.raise} = {
  let fs = fields_sorted(fields);
  let parts = fs.fold(
    { parts: [native_call(b"?out_count", [int_code(tag_record()), int_code(fs.len())])], w: w },
    |acc: { parts: List<Code>, w: Writing }, f: Field| {
      let part = call_at(acc.w, b"?lower", [bare(NField({ base: a, field: f.name }))], [f.ty]);
      {
        parts: acc.parts.push(native_call(b"?out_name", [bytes_code(f.name)])).push(part.code),
        w: part.w,
      }
    },
  );
  { code: Ok(sequence(parts.parts)), w: parts.w, here: [] }
}

/// The body of `lift#T`, which reads a value of `ty` and answers it, what it files, and the
/// definitions of the loops it calls: each kind read as `lowering_code` writes it, a record built
/// from its fields read in name order, a sum's constructor chosen by the name read, a list, array
/// or map built from as many items as its count says. A function made by the program does not
/// cross back.
fn lifting_code(
  module: Bytes,
  ctors: Ctors,
  ty: Type,
) -> { code: Result<Code, Bytes>, w: Writing, here: List<Def> } / {abort.raise} = {
  let w = writing();
  let held = plain(ty);
  let args_at = match held { TyCon(c) -> c.args, _ -> [] };
  let alone = |c: Code| { code: Ok(c), w: w, here: [] };
  let read_as = |name: Bytes| {
    let r = call_at(w, name, [], [held]);
    { code: Ok(r.code), w: r.w, here: [] }
  };
  match ty {
    TyCon(c) -> if c.name == b"^" && c.args.len() == 1 { read_as(b"?in_carried") }
    else if c.args.len() == 0 && c.name == b"Unit" {
      alone(sequence([native_call(b"?in_tag", []), unit_code()]))
    } else if c.args.len() == 0 && c.name == b"Bool" {
      alone(binary_of(b"eq", native_call(b"?in_tag", []), int_code(tag_true())))
    } else if c.args.len() == 0 && c.name == b"Int" { alone(native_call(b"?in_int", [])) }
    else if c.args.len() == 0 && c.name == b"Float" { alone(native_call(b"?in_float", [])) }
    else if c.args.len() == 0 && c.name == b"Decimal" { read_as(b"?in_decimal") }
    else if c.args.len() == 0 && width_named(c.name) != None { read_as(b"?in_fixed") }
    else if c.args.len() == 0 && c.name == b"Char" {
      let of = call_at(w, b"Char::of_int", [native_call(b"?in_char", [])], []);
      let binder = filing(of.w, filed_as(ty, []));
      {
        code: Ok(
          bare(
            NMatch({
              scrutinee: of.code,
              arms: [
                {
                  pat: PxCtor({
                    name: b"Some",
                    args: [PxVar({ name: b"ch", slot: Some(0), span: binder.span })],
                  }),
                  guard: None,
                  body: slot_code(b"ch", 0),
                },
                // The runtime's reader refuses a code that is no character, so this arm never runs.
                {
                  pat: PxCtor({ name: b"None", args: [] }),
                  guard: None,
                  body: bare(NLit(LChar(0))),
                },
              ],
            }),
          ),
        ),
        w: binder.w,
        here: [],
      }
    } else if c.args.len() == 0 && c.name == b"String" { read_as(b"?in_str") }
    else if c.args.len() == 0 && c.name == b"Bytes" { read_as(b"?in_bytes") }
    else if runtime_object(c.name) { read_as(b"?in_handle") }
    else if c.name == b"List" && c.args.len() == 1 {
      let empty = filing(w, filed_as(held, []));
      let items = marked_key(Contained(b"lift_items"), ty, module);
      {
        code: Ok(
          call_of(module, items, [
            { node: NList({ items: [] }), span: empty.span },
            native_call(b"?in_count", [int_code(tag_list())]),
          ]),
        ),
        w: empty.w,
        here: [def_of(module, items, [held, int_type()], held)],
      }
    } else if (c.name == b"Array" || c.name == b"Columns") && c.args.len() == 1 {
      let listed = list_type(c.args.get(0));
      let empty = filing(w, filed_as(plain(listed), []));
      let items = marked_key(Contained(b"lift_items"), listed, module);
      let made = call_at(
        empty.w,
        c.name.concat(b"::of_list"),
        [
          call_of(module, items, [
            { node: NList({ items: [] }), span: empty.span },
            native_call(b"?in_count", [int_code(tag_array())]),
          ]),
        ],
        args_at,
      );
      {
        code: Ok(made.code),
        w: made.w,
        here: [def_of(module, items, [plain(listed), int_type()], plain(listed))],
      }
    } else if c.name == b"Map" && c.args.len() == 2 {
      let fresh = call_at(w, b"Map::new", [], args_at);
      let each = marked_key(Contained(b"lift_entries"), ty, module);
      {
        code: Ok(
          call_of(module, each, [fresh.code, native_call(b"?in_count", [int_code(tag_map())])]),
        ),
        w: fresh.w,
        here: [def_of(module, each, [held, int_type()], held)],
      }
    } else {
      match ctors.sums.get(c.name) {
        None ->
          { code: Err(b"a crossing of a type no root reads: ".concat(c.name)), w: w, here: [] },
        Some(cs) -> {
          let made = cs.fold(
            { made: [], w: w },
            |acc: { made: List<{ name: Bytes, code: Code }>, w: Writing }, sc: SumCtor| {
              let args = sc.fields.map(|f: Type| at_args(f, sc.params, c.args));
              let parts = args.fold(
                { parts: [], w: acc.w },
                |b: { parts: List<Code>, w: Writing }, t: Type| {
                  let part = call_at(b.w, b"?lift", [], [t]);
                  { parts: b.parts.push(part.code), w: part.w }
                },
              );
              let ctor = filing(parts.w, filed_as(held, []));
              let named = { node: NVar({ name: sc.name, slot: None }), span: ctor.span };
              {
                made: acc.made.push({
                  name: sc.name,
                  code: if args.len() == 0 { named }
                  else { bare(NApp({ func: named, args: parts.parts })) },
                }),
                w: ctor.w,
              }
            },
          );
          let chosen = range(0, made.made.len()).fold(unit_code(), |later: Code, n: Int| {
            let k = made.made.len() - 1 - n;
            let m = made.made.get(k);
            if k == made.made.len() - 1 { m.code } else {
              bare(
                NIf({
                  cond: binary_of(
                    b"eq",
                    native_call(b"?in_name_is", [bytes_code(m.name)]),
                    int_code(1),
                  ),
                  then_branch: m.code,
                  else_branch: later,
                }),
              )
            }
          });
          {
            code: Ok(sequence([native_call(b"?in_count", [int_code(tag_ctor())]), chosen])),
            w: made.w,
            here: [],
          }
        },
      }
    },
    TyRecord(fs) -> record_lifted(held, fs, w),
    TyNominal(x) -> record_lifted(held, x.fields, w),
    TyFn(_) -> { code: Err(b"a function crossing back from the runtime"), w: w, here: [] },
    TyVar(_) -> { code: Err(b"a crossing at a type variable"), w: w, here: [] },
  }
}

/// A record of type `ty` read as its fields in name order, each its name and then its value.
fn record_lifted(
  ty: Type,
  fields: List<Field>,
  w: Writing,
) -> { code: Result<Code, Bytes>, w: Writing, here: List<Def> } / {abort.raise} = {
  let fs = fields_sorted(fields);
  let read = fs.fold(
    { fields: [], w: w },
    |acc: { fields: List<CodeField>, w: Writing }, f: Field| {
      let value = call_at(acc.w, b"?lift", [], [f.ty]);
      {
        fields: acc.fields.push({
          name: f.name,
          value: sequence([native_call(b"?in_field", [bytes_code(f.name)]), value.code]),
        }),
        w: value.w,
      }
    },
  );
  let record = filing(read.w, filed_as(ty, []));
  {
    code: Ok(
      sequence([
        native_call(b"?in_count", [int_code(tag_record())]),
        { node: NRecord({ fields: read.fields }), span: record.span },
      ]),
    ),
    w: record.w,
    here: [],
  }
}

/// `lower_items#C<T>` over its parameters `a` and `i`, `C` a list, an array or columns (the
/// `container` with its carried places): each item of `a` from place `i` on written at the items'
/// type, `item` with its carried places.
fn items_lowered(
  module: Bytes,
  key: RootKey,
  container: Type,
  item: Type,
) -> { code: Result<Code, Bytes>, w: Writing, here: List<Def> } / {abort.raise} = {
  let a = slot_code(b"a", 0);
  let i = slot_code(b"i", 1);
  let next = call_of(module, key, [a, binary_of(b"add", i, int_code(1))]);
  match container {
    // An array's or columns' item is read in place below its length, no list made of it.
    TyCon(c) -> if c.name == b"Array" || c.name == b"Columns" {
      let n = call_at(writing(), c.name.concat(b"::len"), [a], [plain(item)]);
      let got = call_at(n.w, c.name.concat(b"::get"), [a, i], [plain(item)]);
      let part = call_at(got.w, b"?lower", [slot_code(b"x", 2)], [item]);
      {
        code: Ok(
          bare(
            NIf({
              cond: binary_of(b"lt", i, n.code),
              then_branch: bare(
                NBlock({
                  stmts: [CLet({ name: b"x", slot: 2, value: got.code })],
                  tail: Some(sequence([part.code, next])),
                }),
              ),
              else_branch: unit_code(),
            }),
          ),
        ),
        w: part.w,
        here: [],
      }
    } else {
      let at = call_at(writing(), b"List::at", [a, i], [plain(item)]);
      let binder = filing(at.w, filed_as(plain(item), []));
      let part = call_at(binder.w, b"?lower", [slot_code(b"x", 2)], [item]);
      {
        code: Ok(some_or(at.code, b"x", 2, binder.span, sequence([part.code, next]), unit_code())),
        w: part.w,
        here: [],
      }
    },
    _ -> { code: Err(b"a loop over items of no container"), w: writing(), here: [] },
  }
}

/// `lower_entries#List<{key, value}>` over its parameters `es` and `i`: each entry of `es` from
/// place `i` on, its key and then its value, each at its own type, `entry` with its carried places.
fn entries_lowered(
  module: Bytes,
  key: RootKey,
  entry: Type,
) -> { code: Result<Code, Bytes>, w: Writing, here: List<Def> } / {abort.raise} = {
  let es = slot_code(b"es", 0);
  let i = slot_code(b"i", 1);
  let at = call_at(writing(), b"List::at", [es, i], [plain(entry)]);
  let binder = filing(at.w, filed_as(plain(entry), []));
  let e = slot_code(b"e", 2);
  let k = call_at(binder.w, b"?lower", [bare(NField({ base: e, field: b"key" }))], [
    field_of(entry, b"key"),
  ]);
  let v = call_at(k.w, b"?lower", [bare(NField({ base: e, field: b"value" }))], [
    field_of(entry, b"value"),
  ]);
  {
    code: Ok(
      some_or(
        at.code,
        b"e",
        2,
        binder.span,
        sequence([k.code, v.code, call_of(module, key, [es, binary_of(b"add", i, int_code(1))])]),
        unit_code(),
      ),
    ),
    w: v.w,
    here: [],
  }
}

/// `lift_items#List<T>` over its parameters `acc` and `n`: `n` more items read onto `acc`, `item`
/// with its carried places.
fn items_lifted(
  module: Bytes,
  key: RootKey,
  item: Type,
) -> { code: Result<Code, Bytes>, w: Writing, here: List<Def> } / {abort.raise} = {
  let acc = slot_code(b"acc", 0);
  let n = slot_code(b"n", 1);
  let x = call_at(writing(), b"?lift", [], [item]);
  let pushed = call_at(x.w, b"List::push", [acc, x.code], [plain(item)]);
  {
    code: Ok(
      bare(
        NIf({
          cond: binary_of(b"eq", n, int_code(0)),
          then_branch: acc,
          else_branch: call_of(module, key, [pushed.code, binary_of(b"sub", n, int_code(1))]),
        }),
      ),
    ),
    w: pushed.w,
    here: [],
  }
}

/// `lift_entries#Map<K, V>` over its parameters `m` and `n`: `n` more entries read into `m`, each a
/// key and then its value, `ty` with its carried places.
fn entries_lifted(
  module: Bytes,
  key: RootKey,
  ty: Type,
) -> { code: Result<Code, Bytes>, w: Writing, here: List<Def> } / {abort.raise} = {
  let args = match ty { TyCon(c) -> c.args, _ -> [] };
  let m = slot_code(b"m", 0);
  let n = slot_code(b"n", 1);
  let k = call_at(writing(), b"?lift", [], [args.get(0)]);
  let v = call_at(k.w, b"?lift", [], [args.get(1)]);
  let inserted = call_at(v.w, b"Map::insert", [m, k.code, v.code], args.map(plain));
  {
    code: Ok(
      bare(
        NIf({
          cond: binary_of(b"eq", n, int_code(0)),
          then_branch: m,
          else_branch: call_of(module, key, [inserted.code, binary_of(b"sub", n, int_code(1))]),
        }),
      ),
    ),
    w: inserted.w,
    here: [],
  }
}

/// What a loop over `ty` walks: a list's, an array's or columns' items, and for `lift_entries` a
/// map's own type.
fn item_of(ty: Type) -> Option<Type> =
  match ty {
    TyCon(c) -> if (c.name == b"List" || c.name == b"Array" || c.name == b"Columns")
        && c.args.len() == 1 { c.args.at(0) }
    else if c.name == b"Map" && c.args.len() == 2 { Some(ty) }
    else { None },
    _ -> None,
  }

fn field_of(ty: Type, name: Bytes) -> Type =
  match ty {
    TyRecord(fs) ->
      fs.fold(unknown_type(), |acc: Type, f: Field| if f.name == name { f.ty } else { acc }),
    _ -> unknown_type(),
  }

/// The runtime's own objects, which cross as handles.
fn runtime_object(name: Bytes) -> Bool =
  name == b"Task" || name == b"Chan" || name == b"Secret" || name == b"Hold"

/// The types a crossing writes and reads back in a program: `sums` each declared sum's
/// constructors, and of them those whose values a lowering cannot write and those a lifting cannot
/// read; whether the program holds what the code written for a container calls, and what the code
/// reading one back calls besides (`written_code`).
pub type CrossedSums = {
  sums: Map<Bytes, List<SumCtor>>,
  unwritten: List<Bytes>,
  unread: List<Bytes>,
  containers: Bool,
  lifts: Bool,
}

/// What crosses in a program of `sums`, `holds` saying whether it holds a function of `std.prelude`
/// by its name there.
pub fn sums_crossed(sums: Map<Bytes, List<SumCtor>>, holds: (Bytes) -> Bool) -> CrossedSums = {
  let c = {
    sums: sums,
    unwritten: [],
    unread: [],
    containers: written_code().calls.all(holds),
    lifts: written_code().lifts.all(holds),
  };
  { ..c, unwritten: sums_uncrossed(c, false), unread: sums_uncrossed(c, true) }
}

/// Whether a lowering writes a value of `t`, or with `back` a lifting reads one: whether
/// `lowering_code` or `lifting_code` writes `t` and every type its parts cross at, and the program
/// holds what that code calls. A function crosses out, never back.
pub fn crosses(c: CrossedSums, t: Type, back: Bool) -> Bool =
  part_crosses(c, if back { c.unread } else { c.unwritten }, t, false, back)

/// The sums of `c` a crossing cannot write, or with `back` read: each with a constructor holding a
/// part of a type that does not cross, its own parameters standing for types that do. A round that
/// grows adds a sum, so there are no more rounds than sums.
fn sums_uncrossed(c: CrossedSums, back: Bool) -> List<Bytes> =
  range(0, c.sums.len() + 1).fold(
    { bad: [], done: false },
    |st: { bad: List<Bytes>, done: Bool }, _: Int|
      if st.done { st } else {
        let more = c.sums.fold(st.bad, |acc: List<Bytes>, name: Bytes, cs: List<SumCtor>|
          if acc.contains(name)
              || cs.all(|sc: SumCtor|
                sc.fields.all(|f: Type| part_crosses(c, st.bad, f, true, back))) { acc }
          else { acc.push(name) });
        { bad: more, done: more.len() == st.bad.len() }
      },
  ).bad

/// `crosses` of `t`, `bad` the sums that do not cross, and with `open` its type variables a sum's
/// parameters.
fn part_crosses(c: CrossedSums, bad: List<Bytes>, t: Type, open: Bool, back: Bool) -> Bool =
  match t {
    TyVar(_) -> open,
    TyFn(_) -> !back,
    TyRecord(fs) -> fs.all(|f: Field| part_crosses(c, bad, f.ty, open, back)),
    TyNominal(x) -> x.fields.all(|f: Field| part_crosses(c, bad, f.ty, open, back)),
    TyCon(k) -> {
      let parts = k.args.all(|a: Type| part_crosses(c, bad, a, open, back));
      if k.args.len() == 0
          && ([
            b"Unit",
            b"Bool",
            b"Int",
            b"Float",
            b"Decimal",
            b"Char",
            b"String",
            b"Bytes",
          ].contains(
            k.name,
          )
          || width_named(k.name) != None) { true }
      else if runtime_object(k.name) { true }
      else if (k.name == b"List" || k.name == b"Array" || k.name == b"Columns")
          && k.args.len() == 1 { c.containers && parts }
      else if k.name == b"Map" && k.args.len() == 2 { c.containers && (!back || c.lifts) && parts }
      else { c.sums.contains(k.name) && !bad.contains(k.name) && parts }
    },
  }

/// Root `key` of `module`, taking `params` and answering `answer`, whose body `body` wrote.
fn rooted_at(
  module: Bytes,
  key: RootKey,
  params: List<Type>,
  answer: Type,
  body: { code: Result<Code, Bytes>, w: Writing, here: List<Def> },
) -> WrittenRoot / {abort.raise} =
  {
    params: range(0, params.len()).map(|i: Int| {
      let t = params.get(i);
      let k = kind_of(t);
      { name: param_name(key, i), kind: k.kind, ty: k.ty, of: Some(t), lambda: None }
    }),
    code: body.code,
    typed: body.w.typed,
    here: [def_of(module, key, params, answer)].concat(body.here),
  }

/// The name parameter `i` of crossing root `key` is read by.
fn param_name(key: RootKey, i: Int) -> Bytes =
  match key {
    Written(w) -> match w.op {
      Contained(c) -> if i == 1 { if c.starts_with(b"lift") { b"n" } else { b"i" } }
      else if c == b"lower_entries" { b"es" }
      else if c == b"lift_items" { b"acc" }
      else if c == b"lift_entries" { b"m" }
      else { b"a" },
      _ -> b"a",
    },
    _ -> b"p".concat(ascii_of_int(i)),
  }

/// The definition a call of root `key`, written in `module`, names: taking `params`, answering
/// `answer`, written by the emitter.
fn def_of(module: Bytes, key: RootKey, params: List<Type>, answer: Type) -> Def / {abort.raise} =
  {
    name: local_root(module, root_name(key)),
    ret: Some(kind_of(answer).kind),
    ret_ty: TyOpen([]),
    pure: true,
    arity: params.len(),
    scheme: Some(monomorphic(fn_type(params, answer, row_empty()))),
    witnesses: 0,
    lent: [],
    root: key,
  }

/// A call of root `key`, written in `module`, on `args`, by the name its definition has there.
fn call_of(module: Bytes, key: RootKey, args: List<Code>) -> Code / {abort.raise} =
  bare(
    NApp({
      func: bare(NVar({ name: local_root(module, root_name(key)), slot: None })),
      args: args,
    }),
  )

// The tags PLV1 opens a value of each kind with.
fn tag_unit() -> Int = 0

fn tag_false() -> Int = 1

fn tag_true() -> Int = 2

fn tag_list() -> Int = 9

fn tag_map() -> Int = 10

fn tag_record() -> Int = 11

fn tag_ctor() -> Int = 12

fn tag_array() -> Int = 14

/// Code being written: the site the next node it files a type for is placed at, and what is filed.
type Writing = { next: Int, typed: Map<Int, Typed> }

fn writing() -> Writing = { next: 0, typed: Map::new() }

/// A place for a node, `t` filed there.
fn filing(w: Writing, t: Typed) -> { span: Span, w: Writing } = {
  let span = { start: 0, end: w.next, site: w.next + 1 };
  { span: span, w: { next: w.next + 1, typed: w.typed.insert(span.site, t) } }
}

/// A call of `name` on `args`, filed as called at type arguments `args_at` where its name is
/// written.
fn call_at(
  w: Writing,
  name: Bytes,
  args: List<Code>,
  args_at: List<Type>,
) -> { code: Code, w: Writing } = {
  let f = filing(w, filed_as(unknown_type(), args_at));
  {
    code: bare(
      NApp({ func: { node: NVar({ name: name, slot: None }), span: f.span }, args: args }),
    ),
    w: f.w,
  }
}

/// `scrutinee`, an `Option`, as `some` with its payload bound as `name` in slot `slot` (its binder
/// at `binder`), or `none`.
fn some_or(scrutinee: Code, name: Bytes, slot: Int, binder: Span, some: Code, none: Code) -> Code =
  bare(
    NMatch({
      scrutinee: scrutinee,
      arms: [
        {
          pat: PxCtor({
            name: b"Some",
            args: [PxVar({ name: name, slot: Some(slot), span: binder })],
          }),
          guard: None,
          body: some,
        },
        { pat: PxCtor({ name: b"None", args: [] }), guard: None, body: none },
      ],
    }),
  )

/// A node at no place, nothing filed for it.
fn bare(n: Node) -> Code = { node: n, span: dummy_span() }

fn int_code(n: Int) -> Code = bare(NLit(LInt(n)))

fn bytes_code(b: Bytes) -> Code = bare(NLit(LBytes(b)))

fn unit_code() -> Code = bare(NLit(LUnit))

fn slot_code(name: Bytes, slot: Int) -> Code = bare(NVar({ name: name, slot: Some(slot) }))

fn binary_of(op: Bytes, l: Code, r: Code) -> Code = bare(NBinary({ op: op, lhs: l, rhs: r }))

/// A call of a builtin no filing types: a crossing native.
fn native_call(name: Bytes, args: List<Code>) -> Code =
  bare(NApp({ func: bare(NVar({ name: name, slot: None })), args: args }))

/// `codes` run in order, the last one's value the block's.
fn sequence(codes: List<Code>) -> Code =
  match codes.at(codes.len() - 1) {
    None -> unit_code(),
    Some(last) -> if codes.len() == 1 { last } else {
      bare(
        NBlock({
          stmts: codes.take(codes.len() - 1).map(|c: Code| CDo({ code: c })),
          tail: Some(last),
        }),
      )
    },
  }
