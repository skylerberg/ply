//! The `Code` written for a type's operations: equality, ordering, reflection, digests and containers.
//! Each node is written with its type, and each read of a definition, a constructor or a builtin
//! with what it reads, as the check settles the code it lowers.

import compiler.emit.code (Code, NLit, NDef, NList, NRecord, NLambda, CodePattern, PxWild, PxCtor,
                           CLet, CDo, CodeStmt, CodeArm)
import compiler.syntax.items (Item, IInstance, NKey, NShow, INumeric, numeric_by)
import compiler.check.resolve.tables (qualify)
import compiler.check.known (array_name, bool_name, bytes_name, char_name, columns_name,
                             decimal_name, equal_ctor, err_ctor, float_name, greater_ctor, int_name,
                             less_ctor, list_name, map_name, none_ctor, ok_ctor, option_name,
                             result_name, some_ctor, string_name, unit_name, ordering_type)
import compiler.check.types (Type, TyVar, TyCon, TyFn, TyRecord, TyNominal, Field, Scheme, Row,
                             Atom, int_type, bytes_type, bool_type, unit_type, string_type,
                             float_type, list_type, option_type, fn_type, monomorphic, row_empty,
                             row_open, arg_row, fields_sorted)
import compiler.emit.typing (unknown_type)
import std.list
import std.list (zip)
import compiler.syntax.patterns (LChar)
import std.bytes (ascii_of_int)
import compiler.emit.c (KBool, KBoxed, KInt, width_named)
import compiler.emit.keys
import compiler.emit.keys (RootKey, Written, TypeOp, Reflect, Shown, Digest, Contained, Lower, Lift,
                           Keeping, Opening, root_name, root_text, op_name)
import compiler.emit.reps (Ctors, SumCtor, TyOpen, Def, EmitParam, at_args, kind_of, runtime_object,
                           holds_resource, ctor_fields_at, release_row)
import compiler.emit.lower.strings (strings_root, strings_code)
import compiler.emit.marks (marked_type, marked_key, plain, kept_form, marked)
import compiler.store.hash.template (written_code)
import compiler.emit.writing (bare, prelude_call, placed, int_code, bool_code, bytes_code,
                              string_code, unit_code, slot_code, binder, field_code, binary_of,
                              applied, builtin_call, native_call, compare_call, ctor_made,
                              prelude_made, prelude_pattern, value_made, if_code, match_code,
                              block_code, some_or, sequence, value_type, Bound, bound_from,
                              bound_pattern, bound_read)

/// Whether `t` is the record a map's entries list holds, `{key, value}`.
fn is_entry(t: Type) -> Bool =
  match t { TyRecord(fs) -> fs.map(|f: Field| f.name) == [b"key", b"value"], _ -> false }

/// The walks written for containers beside those of `reflect`, `shown` and `digest`: `equal` and
/// `ordered` of two, answering as `==` and `compare` do, and the loops the roots run from an index:
/// over two containers for those, and over one, gathering what each item writes, for the others.
fn walk_ops() -> List<Bytes> =
  [b"equal", b"equal_from", b"ordered", b"ordered_from"].concat(gathering_walks())

/// The walks over one container, each gathering onto the list it takes second.
fn gathering_walks() -> List<Bytes> =
  [
    b"reflect_from",
    b"shown_from",
    b"digest_from",
    b"reflect_entries_from",
    b"shown_entries_from",
    b"digest_entries_from",
  ]

/// The loops a crossing runs over a container's items.
fn crossing_loops() -> List<Bytes> =
  [b"lower_items", b"lower_entries", b"lift_items", b"lift_entries"]

/// Whether the root of `Contained(op)` is written: a walk or a strings root `container_code` writes,
/// or a crossing's loop `crossing_root` writes.
pub fn contained_formed(op: Bytes) -> Bool =
  walk_ops().contains(op) || crossing_loops().contains(op) || kept_loops().contains(op)
    || strings_root(op)

/// Whether the root of `Contained(op)` only reads its operand `k`: a walk reads its containers and
/// its index, but a gathering walk takes the list it gathers onto; a loop writing a container's items
/// into a lowering reads its operands, and one reading them from a lifting takes the container it
/// adds to; a keeping's or an opening's loop reads what it walks and takes what it makes.
pub fn contained_reads(op: Bytes, k: Int) -> Bool =
  if gathering_walks().contains(op) { k != 1 }
  else if kept_loops().contains(op) { k != 1 } else {
    walk_ops().contains(op) || op == b"lower_items" || op == b"lower_entries"
      || op == b"let_go_items"
  }

/// Each root written for containers of type `t` in `module`, as a definition of the module, so a
/// root's call of another, or of itself, is a call of a definition: the two-container ones take
/// both and the loops an index after, the others take the container and the loops a list they add
/// to and an index after.
pub fn container_defs(module: Bytes, t: Type) -> List<Def> / {abort.raise} =
  [Reflect, Shown, Digest].concat(walk_ops().map(Contained)).map(|written_op: TypeOp| {
    let op = op_name(written_op);
    let root = keys::written(written_op, t, module);
    let typed = container_typed(op, t);
    {
      name: local_root(module, root_text(root_name(root))),
      ret: Some(if typed.ret == bool_type() { KBool } else { KBoxed }),
      ret_ty: TyOpen([]),
      pure: true,
      constant: false,
      arity: typed.params.len(),
      scheme: Some(monomorphic(fn_type(typed.params, typed.ret, row_empty()))),
      witnesses: 0,
      lent: [],
      root: root,
    }
  })

/// What container root `op` written for `t` takes and answers: two containers a comparison, and an
/// index after them its loop; one container a reflection or digest, and the list it adds to and an
/// index after it its loop, which answers that list.
fn container_typed(op: Bytes, t: Type) -> { params: List<Type>, ret: Type } = {
  let value = value_type();
  let entries = list_type(TyRecord([{ name: b"key", ty: value }, { name: b"value", ty: value }]));
  let gathered = |l: Type| { params: [t, l, int_type()], ret: l };
  if op == b"equal" { { params: [t, t], ret: bool_type() } }
  else if op == b"ordered" { { params: [t, t], ret: ordering_type() } }
  else if op == b"equal_from" { { params: [t, t, int_type()], ret: bool_type() } }
  else if op == b"ordered_from" { { params: [t, t, int_type()], ret: ordering_type() } }
  else if op == b"reflect_from" || op == b"shown_from" { gathered(list_type(value)) }
  else if op == b"digest_from" || op == b"digest_entries_from" { gathered(list_type(bytes_type())) }
  else if op == b"reflect_entries_from" || op == b"shown_entries_from" { gathered(entries) }
  else if op == b"digest" { { params: [t], ret: bytes_type() } }
  else { { params: [t], ret: value } }
}

/// A root written for a type: its parameters, its body over them, the definitions its calls name,
/// its own among them where it calls itself, and what an entry's body performs.
pub type WrittenRoot = { params: List<EmitParam>, code: Code, here: List<Def>, performs: Row }

/// The root written for walk `op` of containers of type `t` in `module`, under the constructors
/// `ctors`: one `walked_code` writes (a reflection, a showing or a digest of the container, or one
/// `walk_ops` holds) over the container `a`, a second one `b` for a comparison, and an index `i` for
/// a comparison's or a gathering's loop. A strings root is `strings_code`'s, and a crossing's loops
/// are `crossing_root`'s.
pub fn container_code(
  module: Bytes,
  ctors: Ctors,
  op: Bytes,
  t: Type,
) -> WrittenRoot / {abort.raise} =
  if strings_root(op) {
    let s = strings_code(module, op, t);
    { params: s.params, code: s.code, here: s.here, performs: row_empty() }
  } else {
    let e = walked_code(module, ctors, op, t);
    let word = |n: Bytes| { name: n, kind: KBoxed, ty: kind_of(t).ty, of: Some(t), lambda: None };
    let index = { name: b"i", kind: KInt, ty: TyOpen([]), of: Some(int_type()), lambda: None };
    {
      params: if op.ends_with(b"_from") { [word(b"a"), word(b"b"), index] }
      else if op == b"equal" || op == b"ordered" { [word(b"a"), word(b"b")] }
      else { [word(b"a")] },
      code: e.code,
      here: e.here,
      performs: row_empty(),
    }
  }

/// The body of the root written for `op` of containers of type `t`, as lowered code over its
/// parameters `a`, `b` and, for the loops, `i`, and the definitions its calls name. Two lists, arrays
/// or columns are equal where they have one length and each pair at an index is equal, and ordered by
/// the first pair that is not equal, a shorter one first where the other begins with it; two maps as
/// the lists of their entries in key order are. A container is reflected, shown or digested item by
/// item at the items' type, a map entry by entry.
fn walked_code(
  module: Bytes,
  ctors: Ctors,
  op: Bytes,
  t: Type,
) -> { code: Code, here: List<Def> } / {abort.raise} = {
  let args = match t { TyCon(c) -> c.args, _ -> [] };
  let kind = match t { TyCon(c) -> c.name, _ -> b"" };
  let fields_of = match t { TyRecord(fs) -> fs, TyNominal(x) -> x.fields, _ -> [] };
  let value = value_type();
  // What a `Result`'s `Err` holds.
  let failure = match args.at(1) { Some(e) -> e, None -> unknown_type() };
  // A map is walked as the list of its entries.
  let walked = if kind == map_name() {
    list_type(
      TyRecord([
        { name: b"key", ty: match args.at(0) { Some(k) -> k, None -> unknown_type() } },
        { name: b"value", ty: match args.at(1) { Some(v) -> v, None -> unknown_type() } },
      ]),
    )
  } else { t };
  let item = match walked {
    TyCon(c) -> match c.args.at(0) { Some(e) -> e, None -> unknown_type() },
    _ -> unknown_type(),
  };
  let field = |name: Bytes| field_of(item, name);
  let of = if kind == array_name() { b"Array::" }
  else if kind == columns_name() { b"Columns::" }
  else { b"List::" };
  let here = if kind == map_name() {
    container_defs(module, t).concat(container_defs(module, walked))
  } else { container_defs(module, t) };
  let entry_of_values = TyRecord([{ name: b"key", ty: value }, { name: b"value", ty: value }]);
  // What a loop gathering one container's items pushes onto the list it answers.
  let gathered_item = if op == b"digest_from" || op == b"digest_entries_from" { bytes_type() }
  else if op == b"reflect_entries_from" || op == b"shown_entries_from" { entry_of_values }
  else { value };
  let typed = container_typed(op, t);
  let param = |i: Int| match typed.params.at(i) { Some(p) -> p, None -> t };
  let a = slot_code(b"a", 0, param(0));
  let b = slot_code(b"b", 1, param(1));
  let i = slot_code(b"i", 2, int_type());
  let x = slot_code(b"x", 3, item);
  let y = slot_code(b"y", 4, item);
  let next = binary_of(b"add", i, int_code(1));
  // A call of the loop `name` written for the walked container.
  let looped = |name: Bytes, operands: List<Code>| {
    let key = keys::written(Contained(name), walked, module);
    call_of(module, key, operands, container_typed(name, walked).ret)
  };
  let length = |c: Code, over: List<Type>|
    builtin_call(
      if kind == map_name() { b"Map::len" } else { of.concat(b"len") },
      over,
      [c],
      int_type(),
    );
  // An array's or columns' item is read by the inline `get`, so no root calls a prelude function the
  // program may not reach.
  let match_at = |list: Code, name: Bytes, slot: Int, found: Code, ended: Code|
    if kind == array_name() || kind == columns_name() {
      if_code(
        binary_of(b"lt", i, length(list, [item])),
        block_code(
          [
            CLet({
              name: name,
              slot: slot,
              value: builtin_call(of.concat(b"get"), [item], [list, i], item),
            }),
          ],
          found,
        ),
        ended,
      )
    } else {
      some_or(
        prelude_call(b"List::at", [item], [list, i], option_type(item)),
        name,
        slot,
        item,
        found,
        ended,
      )
    };
  // The list or array walked, a map's entries for a map.
  let walked_of = |c: Code|
    if kind == map_name() { prelude_call(b"Map::entries", args, [c], walked) } else { c };
  // What a loop over one container adds to `b` for the item `x`.
  let part = |builtin_name: Bytes, c: Code|
    builtin_call(builtin_name, [c.ty], [c], if builtin_name == b"?encoded" { bytes_type() }
    else { value });
  let gathered = |name: Bytes, pushed: (Code) -> Code|
    match_at(a, b"x", 3, looped(name, [a, pushed(b), next]), b);
  let push = |list: Code, v: Code| prelude_call(b"List::push", [gathered_item], [list, v], list.ty);
  let entry = |builtin_name: Bytes|
    bare(
      NRecord({
        fields: [
          { name: b"key", value: part(builtin_name, field_code(x, b"key", field(b"key"))) },
          { name: b"value", value: part(builtin_name, field_code(x, b"value", field(b"value"))) },
        ],
      }),
      entry_of_values,
    );
  let empty = |of_item: Type| bare(NList({ items: [] }), list_type(of_item));
  // `?compare` of the two items, or of their field `name`, and `then` where it answers `Equal`.
  let ordered_then = |name: Bytes, slot: Int, then: Code| {
    let read = |c: Code| if name == b"" { c } else { field_code(c, name, field(name)) };
    let o = b"o".concat(ascii_of_int(slot));
    let compared = compare_call(read(x), read(y));
    block_code(
      [CLet({ name: o, slot: slot, value: compared })],
      if_code(
        binary_of(
          b"eq",
          slot_code(o, slot, ordering_type()),
          prelude_made(equal_ctor(), [], ordering_type()),
        ),
        then,
        slot_code(o, slot, ordering_type()),
      ),
    )
  };
  let body = if kind == b"" && op == b"equal" {
    // A record's fields in the order their names sort, each compared at its own type.
    fields_of.fold(
      { code: bool_code(true), first: true },
      |acc: { code: Code, first: Bool }, f: Field| {
        let read = |c: Code| field_code(c, f.name, f.ty);
        let eq = binary_of(b"eq", read(a), read(b));
        { code: if acc.first { eq } else { binary_of(b"and", acc.code, eq) }, first: false }
      },
    ).code
  } else if kind == result_name() {
    let arm = |pat: CodePattern, body2: Code| { pat: pat, guard: None, body: body2 };
    let one = |ctor: Bytes, slot: Int, held: Type|
      prelude_pattern(ctor, [binder(if slot == 3 { b"x" } else { b"y" }, slot, held)]);
    let other = |ctor: Bytes| prelude_pattern(ctor, [PxWild]);
    let ok = match args.at(0) { Some(o) -> o, None -> unknown_type() };
    let xs = |held: Type| slot_code(b"x", 3, held);
    let ys = |held: Type| slot_code(b"y", 4, held);
    if op == b"equal" {
      match_code(
        a,
        [
          arm(
            one(ok_ctor(), 3, ok),
            match_code(
              b,
              [
                arm(one(ok_ctor(), 4, ok), binary_of(b"eq", xs(ok), ys(ok))),
                arm(PxWild, bool_code(false)),
              ],
              bool_type(),
            ),
          ),
          arm(
            one(err_ctor(), 3, failure),
            match_code(
              b,
              [
                arm(one(err_ctor(), 4, failure), binary_of(b"eq", xs(failure), ys(failure))),
                arm(PxWild, bool_code(false)),
              ],
              bool_type(),
            ),
          ),
        ],
        bool_type(),
      )
    } else {
      match_code(
        a,
        [
          arm(
            one(err_ctor(), 3, failure),
            match_code(
              b,
              [
                arm(one(err_ctor(), 4, failure), compare_call(xs(failure), ys(failure))),
                arm(other(ok_ctor()), prelude_made(less_ctor(), [], ordering_type())),
              ],
              ordering_type(),
            ),
          ),
          arm(
            one(ok_ctor(), 3, ok),
            match_code(
              b,
              [
                arm(one(ok_ctor(), 4, ok), compare_call(xs(ok), ys(ok))),
                arm(other(err_ctor()), prelude_made(greater_ctor(), [], ordering_type())),
              ],
              ordering_type(),
            ),
          ),
        ],
        ordering_type(),
      )
    }
  } else if kind == option_name() && op == b"equal" {
    let arm = |pat: CodePattern, body2: Code| { pat: pat, guard: None, body: body2 };
    let none = prelude_pattern(none_ctor(), []);
    match_code(
      a,
      [
        arm(
          none,
          match_code(b, [arm(none, bool_code(true)), arm(PxWild, bool_code(false))], bool_type()),
        ),
        arm(
          prelude_pattern(some_ctor(), [binder(b"x", 3, item)]),
          match_code(
            b,
            [
              arm(prelude_pattern(some_ctor(), [binder(b"y", 4, item)]), binary_of(b"eq", x, y)),
              arm(PxWild, bool_code(false)),
            ],
            bool_type(),
          ),
        ),
      ],
      bool_type(),
    )
  } else if kind == option_name() {
    let arm = |pat: CodePattern, body2: Code| { pat: pat, guard: None, body: body2 };
    let none = prelude_pattern(none_ctor(), []);
    let order = |name: Bytes| prelude_made(name, [], ordering_type());
    match_code(
      a,
      [
        arm(
          none,
          match_code(
            b,
            [arm(none, order(equal_ctor())), arm(PxWild, order(less_ctor()))],
            ordering_type(),
          ),
        ),
        arm(
          prelude_pattern(some_ctor(), [binder(b"x", 3, item)]),
          match_code(
            b,
            [
              arm(none, order(greater_ctor())),
              arm(prelude_pattern(some_ctor(), [binder(b"y", 4, item)]), compare_call(x, y)),
            ],
            ordering_type(),
          ),
        ),
      ],
      ordering_type(),
    )
  } else if op == b"equal" {
    if_code(
      binary_of(b"eq", length(a, args), length(b, args)),
      looped(b"equal_from", [walked_of(a), walked_of(b), int_code(0)]),
      bool_code(false),
    )
  } else if op == b"ordered" {
    itself_equal(looped(b"ordered_from", [walked_of(a), walked_of(b), int_code(0)]), t)
  } else if op == b"equal_from" {
    match_at(
      a,
      b"x",
      3,
      match_at(
        b,
        b"y",
        4,
        if_code(binary_of(b"eq", x, y), looped(b"equal_from", [a, b, next]), bool_code(false)),
        bool_code(false),
      ),
      bool_code(true),
    )
  } else if op == b"ordered_from" {
    match_at(
      a,
      b"x",
      3,
      match_at(
        b,
        b"y",
        4,
        // Item by item, a map's entry by its key and then its value.
        if is_entry(item) {
          ordered_then(b"key", 5, ordered_then(b"value", 6, looped(b"ordered_from", [a, b, next])))
        } else { ordered_then(b"", 5, looped(b"ordered_from", [a, b, next])) },
        prelude_made(greater_ctor(), [], ordering_type()),
      ),
      if_code(
        binary_of(b"lt", i, length(b, [item])),
        prelude_made(less_ctor(), [], ordering_type()),
        prelude_made(equal_ctor(), [], ordering_type()),
      ),
    )
  } else if op == b"reflect_from" || op == b"shown_from" {
    let name = if op == b"reflect_from" { b"?reflect" } else { b"?shown" };
    gathered(op, |out: Code| push(out, part(name, x)))
  } else if op == b"digest_from" { gathered(op, |out: Code| push(out, part(b"?encoded", x))) }
  else if op == b"reflect_entries_from" || op == b"shown_entries_from" {
    let name = if op == b"reflect_entries_from" { b"?reflect" } else { b"?shown" };
    gathered(op, |out: Code| push(out, entry(name)))
  } else if op == b"digest_entries_from" {
    gathered(op, |out: Code|
      push(
        push(out, part(b"?encoded", field_code(x, b"key", field(b"key")))),
        part(b"?encoded", field_code(x, b"value", field(b"value"))),
      ))
  } else if op == b"digest" {
    // The encoding `digest.rs` writes: the container's tag and count, then each item's encoding;
    // a count's eight bytes are an `Int` encoding's past its tag. A `Columns` is the array of its
    // records.
    let tag = if kind == map_name() { 11 }
    else if kind == array_name() || kind == columns_name() { 10 }
    else { 9 };
    let loop_name = if kind == map_name() { b"digest_entries_from" } else { b"digest_from" };
    joined([
      bytes_code(byte_of_int(tag)),
      builtin_call(
        b"Bytes::slice",
        [],
        [part(b"?encoded", length(a, args)), int_code(1), int_code(9)],
        bytes_type(),
      ),
      builtin_call(
        b"?concat",
        [],
        [looped(loop_name, [walked_of(a), empty(bytes_type()), int_code(0)])],
        bytes_type(),
      ),
    ])
  } else {
    // `reflect` or `shown`: the container's constructor of `std.value.Value` over its items'.
    let reflecting = op == b"reflect";
    let made = if kind == map_name() { b"std.value.VMap" }
    else if kind == array_name() || kind == columns_name() { b"std.value.VArray" }
    else { b"std.value.VList" };
    let loop_name = if kind == map_name() {
      if reflecting { b"reflect_entries_from" } else { b"shown_entries_from" }
    } else if reflecting { b"reflect_from" }
    else { b"shown_from" };
    value_made(ctors, made, [
      looped(loop_name, [
        walked_of(a),
        empty(if kind == map_name() { entry_of_values } else { value }),
        int_code(0),
      ]),
    ])
  };
  { code: body, here: here }
}

/// The name `root`, written in `module`, has there.
pub fn local_root(module: Bytes, root: Bytes) -> Bytes / {abort.raise} =
  if module.len() == 0 { root } else { root.slice(module.len() + 1, root.len()) }

/// A function the module of a declared sum states for it: `full`, its name across the program, the
/// type arguments a call of it names it at, its type at them, what it answers there, and the row a
/// call fills each of its row variables with.
pub type StatedFn = { full: Bytes, args: List<Type>, fn_type: Type, ret: Type, rows: List<Row> }

/// The key the module states for the declared sum `ty` (`key for T by f`), at `ty`'s arguments; none
/// where it states none.
pub fn keyed_by(module: Bytes, here: List<Def>, items: List<Item>, ty: Type) -> Option<StatedFn> =
  stated_for(module, here, ty, |c: Bytes|
    items.fold(None, |acc: Option<Bytes>, item: Item|
      match item {
        IInstance(d) -> if d.kind == NKey && qualify(module, d.target.name) == c { Some(d.by.name) }
        else { acc },
        _ -> acc,
      }))

/// The function the module states `op` of the declared sum `ty`'s arithmetic is (`numeric for T by
/// { op: f, .. }`), at `ty`'s arguments; none where it states none.
pub fn numeric_stated(
  module: Bytes,
  here: List<Def>,
  items: List<Item>,
  ty: Type,
  op: Bytes,
) -> Option<StatedFn> =
  stated_for(module, here, ty, |c: Bytes|
    items.fold(None, |acc: Option<Bytes>, item: Item|
      match item {
        INumeric(d) -> if qualify(module, d.target.name) == c {
          match numeric_by(d, op) { Some(by) -> Some(by.name), None -> acc }
        } else { acc },
        _ -> acc,
      }))

/// The function `named` finds stated for the sum `ty` names, among `here`, the definitions of
/// `module`, at `ty`'s arguments: each of its variables, type or row, the argument of `ty` its
/// signature names it at, a row it names at none the empty row.
fn stated_for(
  module: Bytes,
  here: List<Def>,
  ty: Type,
  named: (Bytes) -> Option<Bytes>,
) -> Option<StatedFn> =
  match ty {
    TyCon(c) -> match named(c.name) {
      None -> None,
      Some(f) -> match here.fold(None, |s: Option<Scheme>, h: Def|
          if h.name == f { h.scheme } else { s }) {
        Some(sc) -> match sc.ty {
          TyFn(fn_ty) -> {
            let at_ty = fn_ty.params.push(fn_ty.ret).fold(
              None,
              |acc: Option<List<Type>>, t: Type|
                match acc {
                  Some(_) -> acc,
                  None -> match t {
                    TyCon(p) -> if p.name == c.name { Some(p.args) } else { None },
                    _ -> None,
                  },
                },
            );
            let written = match at_ty { Some(xs) -> xs, None -> [] };
            let args = sc.ty_vars.map(|v: Int|
              range(0, written.len()).fold(unknown_type(), |found: Type, i: Int|
                if written.at(i) == Some(TyVar(v)) {
                  match c.args.at(i) { Some(t) -> t, None -> found }
                } else { found }));
            let rows = sc.row_vars.map(|v: Int|
              range(0, written.len()).fold(row_empty(), |found: Row, i: Int|
                match ((written.at(i), c.args.at(i))) {
                  (Some(w), Some(given)) -> if arg_row(w) == Some(row_open(v)) {
                    match arg_row(given) { Some(r) -> r, None -> found }
                  } else { found },
                  _ -> found,
                }));
            Some({
              full: qualify(module, f),
              args: args,
              fn_type: at_args(sc.ty, sc.ty_vars, args),
              ret: at_args(fn_ty.ret, sc.ty_vars, args),
              rows: rows,
            })
          },
          _ -> None,
        },
        None -> None,
      },
    },
    _ -> None,
  }

/// A call of `s` on `args`.
fn stated_call(s: StatedFn, args: List<Code>) -> Code =
  applied(
    bare(NDef({ full: s.full, args: s.args, rows: s.rows, labels: [] }), s.fn_type),
    args,
    s.ret,
  )

/// The body of a root doing what `s` does over its parameters `a` and `b`, of types `params`: a call
/// of `s`.
pub fn stated_code(s: StatedFn, params: List<Type>) -> Code =
  stated_call(
    s,
    range(0, params.len()).map(|i: Int|
      slot_code(if i == 0 { b"a" } else { b"b" }, i, match params.at(i) {
        Some(t) -> t,
        None -> unknown_type(),
      })),
  )

/// The body of `T#cmp`, or of `T#eq` where `eq`, for a sum `ty` whose module states its key `k`, over
/// its two parameters: the parameters' keys ordered, and equal where they order so, as values whose
/// keys are equal are.
pub fn keyed_code(k: StatedFn, eq: Bool, ty: Type) -> Code = {
  let ordered = compare_call(
    stated_call(k, [slot_code(b"a", 0, ty)]),
    stated_call(k, [slot_code(b"b", 1, ty)]),
  );
  if eq { binary_of(b"eq", ordered, prelude_made(equal_ctor(), [], ordering_type())) }
  else { ordered }
}

/// The body of `T#eq` for the sum `ty` of constructors `cs`, as lowered code over its two
/// parameters: each constructor's arguments compared in turn where both are that constructor.
pub fn equality_code(ty: Type, cs: List<SumCtor>) -> Code = {
  let sum = match ty { TyCon(c) -> c.name, _ -> b"" };
  let arms = cs.map(|c: SumCtor| {
    let xs = bound_from(2, b"x", c.fields);
    let ys = bound_from(2 + xs.len(), b"y", c.fields);
    let same = zip(xs, ys).fold(None, |both: Option<Code>, p: { first: Bound, second: Bound }| {
      let eq = binary_of(b"eq", bound_read(p.first), bound_read(p.second));
      Some(match both { None -> eq, Some(b) -> binary_of(b"and", b, eq) })
    });
    let inner = match_code(
      slot_code(b"b", 1, ty),
      [
        {
          pat: PxCtor({ sum: sum, name: c.name, case: c.index, args: ys.map(bound_pattern) }),
          guard: None,
          body: match same { Some(e) -> e, None -> bool_code(true) },
        },
        { pat: PxWild, guard: None, body: bool_code(false) },
      ],
      bool_type(),
    );
    {
      pat: PxCtor({ sum: sum, name: c.name, case: c.index, args: xs.map(bound_pattern) }),
      guard: None,
      body: inner,
    }
  });
  match_code(slot_code(b"a", 0, ty), arms, bool_type())
}

/// The body of `T#eq` for a type `ty` no sum names, as lowered code over its two parameters: `a ==
/// b`, which compares them as `==` at `T` does.
pub fn compared_code(ty: Type) -> Code =
  binary_of(b"eq", slot_code(b"a", 0, ty), slot_code(b"b", 1, ty))

/// The body of `T#cmp` for a type `ty` no sum names, as lowered code over its two parameters:
/// `compare(a, b)`, which orders them as `compare` at `ty` does.
pub fn ordered_code(ty: Type) -> Code =
  builtin_call(b"compare", [ty], [slot_code(b"a", 0, ty), slot_code(b"b", 1, ty)], ordering_type())

/// A constructor's argument as `T#cmp` reads it: bound on each side, and the slot holding the order
/// they compare in.
type Ordered = { x: Bound, y: Bound, order: Bound }

/// The body of `T#cmp` for the sum `ty` of constructors `cs`, as lowered code over its two
/// parameters: as the evaluator orders two constructors' values, by the constructors' names and then
/// by each argument in turn as its type orders.
pub fn ordering_code(ty: Type, cs: List<SumCtor>) -> Code = {
  let sum = match ty { TyCon(c) -> c.name, _ -> b"" };
  let a = slot_code(b"a", 0, ty);
  let b = slot_code(b"b", 1, ty);
  let rank = |c: SumCtor|
    cs.fold(0, |n: Int, d: SumCtor| if compare(d.name, c.name) == Less { n + 1 } else { n });
  let ranked = |scrutinee: Code|
    match_code(
      scrutinee,
      cs.map(|c: SumCtor|
        {
          pat: PxCtor({
            sum: sum,
            name: c.name,
            case: c.index,
            args: c.fields.map(|_: Type| PxWild),
          }),
          guard: None,
          body: int_code(rank(c)),
        }),
      int_type(),
    );
  let equal = prelude_made(equal_ctor(), [], ordering_type());
  let walked = cs.fold(
    { arms: [], slot: 4 },
    |acc: { arms: List<CodeArm>, slot: Int }, c: SumCtor| {
      let xs = bound_from(acc.slot, b"x", c.fields);
      let ys = bound_from(acc.slot + xs.len(), b"y", c.fields);
      let orders = bound_from(
        acc.slot + 2 * xs.len(),
        b"o",
        c.fields.map(|_: Type| ordering_type()),
      );
      let fields = zip(zip(xs, ys), orders).map(
        |p: { first: { first: Bound, second: Bound }, second: Bound }|
          { x: p.first.first, y: p.first.second, order: p.second },
      );
      let compared = |f: Ordered| compare_call(bound_read(f.x), bound_read(f.y));
      // The first argument that orders apart decides, from the last back to the first.
      let lex = fields.fold_right(None, |f: Ordered, later: Option<Code>|
        Some(match later {
          None -> compared(f),
          Some(l) ->
            block_code(
              [CLet({ name: f.order.name, slot: f.order.slot, value: compared(f) })],
              if_code(binary_of(b"eq", bound_read(f.order), equal), l, bound_read(f.order)),
            ),
        }));
      let inner = match_code(
        b,
        [
          {
            pat: PxCtor({ sum: sum, name: c.name, case: c.index, args: ys.map(bound_pattern) }),
            guard: None,
            body: match lex { Some(l) -> l, None -> equal },
          },
          { pat: PxWild, guard: None, body: equal },
        ],
        ordering_type(),
      );
      {
        arms: acc.arms.push({
          pat: PxCtor({ sum: sum, name: c.name, case: c.index, args: xs.map(bound_pattern) }),
          guard: None,
          body: inner,
        }),
        slot: acc.slot + 3 * xs.len(),
      }
    },
  );
  let ra = slot_code(b"ra", 2, int_type());
  let rb = slot_code(b"rb", 3, int_type());
  itself_equal(
    block_code(
      [
        CLet({ name: b"ra", slot: 2, value: ranked(a) }),
        CLet({ name: b"rb", slot: 3, value: ranked(b) }),
      ],
      if_code(
        binary_of(b"lt", ra, rb),
        prelude_made(less_ctor(), [], ordering_type()),
        if_code(
          binary_of(b"gt", ra, rb),
          prelude_made(greater_ctor(), [], ordering_type()),
          match_code(a, walked.arms, ordering_type()),
        ),
      ),
    ),
    ty,
  )
}

/// `order`, the body of a written root ordering its parameters `a` and `b`, of type `ty`, answering
/// `Equal` at once where the two are one object: an order is reflexive, so nothing of it need be
/// walked.
fn itself_equal(order: Code, ty: Type) -> Code =
  if_code(
    builtin_call(b"?same", [], [slot_code(b"a", 0, ty), slot_code(b"b", 1, ty)], bool_type()),
    prelude_made(equal_ctor(), [], ordering_type()),
    order,
  )

/// `n`'s low 64 bits, least significant byte first.
fn le64(n: Int) -> Bytes =
  Bytes::concat_all(range(0, 8).map(|i: Int| byte_of_int(n >> 8 * i & 255)))

/// `parts`, each bytes, joined.
fn joined(parts: List<Code>) -> Code =
  builtin_call(
    b"?concat",
    [],
    [bare(NList({ items: parts }), list_type(bytes_type()))],
    bytes_type(),
  )

/// The body of the root `Digest` is written as for `ty`, over its parameter `a`, a value of `ty`: the
/// encoding `digest.rs` writes, a record's and a constructor's own bytes written here and each part's
/// encoding at its type. A type whose module states `key` is its key's encoding.
pub fn digest_code(
  module: Bytes,
  ctors: Ctors,
  here: List<Def>,
  items: List<Item>,
  ty: Type,
) -> Code / {abort.raise} = {
  let a = slot_code(b"a", 0, ty);
  let counted = |tag: Int, n: Int| byte_of_int(tag).concat(le64(n));
  let blob = |tag: Int, b: Bytes| counted(tag, b.len()).concat(b);
  // `x` encoded at its type, which the emitter settles.
  let part = |x: Code| builtin_call(b"?encoded", [x.ty], [x], bytes_type());
  // A type of neither fields nor constructors is encoded as `?encoded` writes it in place.
  let read = part(a);
  let fields_of = match ty { TyRecord(fs) -> Some(fs), TyNominal(x) -> Some(x.fields), _ -> None };
  match fields_of {
    Some(fs) ->
      joined(
        fs.fold([bytes_code(counted(12, fs.len()))], |acc: List<Code>, f: Field|
          acc.concat([bytes_code(blob(13, f.name)), part(field_code(a, f.name, f.ty))])),
      ),
    None -> match ty {
      TyCon(c) -> match ctors.sums.get(c.name) {
        None -> read,
        Some(cs) -> match keyed_by(module, here, items, ty) {
          // Values whose keys are equal are equal, so the key is what is written.
          Some(k) -> joined([bytes_code(byte_of_int(16)), part(stated_call(k, [a]))]),
          None ->
            match_code(
              a,
              cs.fold(
                { arms: [], slot: 1 },
                |acc: { arms: List<CodeArm>, slot: Int }, sc: SumCtor| {
                  let xs = bound_from(acc.slot, b"x", ctor_fields_at(sc, c.args));
                  let dot = range(0, sc.name.len()).fold(0 - 1, |d: Int, i: Int|
                    if sc.name.at(i) == 46 { i } else { d });
                  let simple = sc.name.slice(dot + 1, sc.name.len());
                  {
                    arms: acc.arms.push({
                      pat: PxCtor({
                        sum: c.name,
                        name: sc.name,
                        case: sc.index,
                        args: xs.map(bound_pattern),
                      }),
                      guard: None,
                      body: joined(
                        [bytes_code(blob(14, simple).concat(counted(15, xs.len())))].concat(
                          xs.map(|x: Bound| part(bound_read(x))),
                        ),
                      ),
                    }),
                    slot: acc.slot + xs.len(),
                  }
                },
              ).arms,
              bytes_type(),
            ),
        },
      },
      _ -> read,
    },
  }
}

/// The body of the root `Reflect` or `Shown` is written as for `ty`, over its parameter `a`: a
/// record's fields in their names' order, and a declared sum's constructor's name and arguments, each
/// part reflected at its own type. Under `shown`, a sum whose module states a `show` is what that
/// function writes, at the sum's arguments.
pub fn reflection_code(
  module: Bytes,
  ctors: Ctors,
  here: List<Def>,
  items: List<Item>,
  shown: Bool,
  ty: Type,
) -> Code = {
  let a = slot_code(b"a", 0, ty);
  let value = value_type();
  // `x` reflected at its type, which the emitter settles.
  let part = |x: Code|
    builtin_call(if shown { b"?shown" } else { b"?reflect" }, [x.ty], [x], value);
  let fields_of = match ty { TyRecord(fs) -> Some(fs), TyNominal(x) -> Some(x.fields), _ -> None };
  let field = TyRecord([{ name: b"name", ty: string_type() }, { name: b"value", ty: value }]);
  match fields_of {
    Some(fs) ->
      value_made(ctors, b"std.value.VRecord", [
        bare(
          NList({
            items: fs.map(|f: Field|
              bare(
                NRecord({
                  fields: [
                    { name: b"name", value: string_code(f.name) },
                    { name: b"value", value: part(field_code(a, f.name, f.ty)) },
                  ],
                }),
                field,
              )),
          }),
          list_type(field),
        ),
      ]),
    None -> match ty {
      TyCon(c) -> match ctors.sums.get(c.name) {
        None -> part(a),
        Some(cs) -> {
          let stated = if !shown { None } else {
            stated_for(module, here, ty, |n: Bytes|
              items.fold(None, |acc: Option<Bytes>, item: Item|
                match item {
                  IInstance(d) -> if d.kind == NShow && qualify(module, d.target.name) == n {
                    Some(d.by.name)
                  } else { acc },
                  _ -> acc,
                }))
          };
          match stated {
            // The function the module states, at the type's arguments.
            Some(f) -> value_made(ctors, b"std.value.VShown", [stated_call(f, [a])]),
            None ->
              match_code(
                a,
                cs.fold(
                  { arms: [], slot: 1 },
                  |acc: { arms: List<CodeArm>, slot: Int }, sc: SumCtor| {
                    let xs = bound_from(acc.slot, b"x", ctor_fields_at(sc, c.args));
                    {
                      arms: acc.arms.push({
                        pat: PxCtor({
                          sum: c.name,
                          name: sc.name,
                          case: sc.index,
                          args: xs.map(bound_pattern),
                        }),
                        guard: None,
                        body: value_made(ctors, b"std.value.VCtor", [
                          string_code(sc.name),
                          bare(
                            NList({ items: xs.map(|x: Bound| part(bound_read(x))) }),
                            list_type(value),
                          ),
                        ]),
                      }),
                      slot: acc.slot + xs.len(),
                    }
                  },
                ).arms,
                value,
              ),
          }
        },
      },
      _ -> part(a),
    },
  }
}

// --- Letting go of a resource -----------------------------------------------------------------

/// The root `key`, written in `module`, that lets go of a resource of type `ty`, its parameter `a`:
/// a call of the function the type's `release` names; for a list, each item let go and then the
/// rest, a loop; and for a sum or a record, each part that holds a resource let go, the parts a
/// constructor holds read by a `match`. A part is let go by `?let_go`, which the lowering settles by
/// the type the part holds.
pub fn let_go_code(
  module: Bytes,
  ctors: Ctors,
  here: List<Def>,
  key: RootKey,
  ty: Type,
) -> WrittenRoot / {abort.raise} = {
  let a = slot_code(b"a", 0, ty);
  let fields_of = match ty { TyRecord(fs) -> Some(fs), TyNominal(x) -> Some(x.fields), _ -> None };
  let body = match fields_of {
    Some(fs) ->
      {
        code: sequence(
          fs.filter(|f: Field| holds_resource(ctors, f.ty)).map(|f: Field|
            let_go(field_code(a, f.name, f.ty))),
        ),
        here: [],
      },
    None -> match ty {
      TyCon(c) -> match ctors.released.get(c.name) {
        Some(by) -> {
          let local = local_root(module, by);
          match stated_for(module, here, ty, |n: Bytes|
              if n == c.name { Some(local) } else { None }) {
            Some(f) -> { code: stated_call(f, [a]), here: [] },
            None -> { code: unit_code(), here: [] },
          }
        },
        None -> if c.name == list_name() {
          // Each item let go in turn, from the first, by a loop over the list lent to it.
          let items = keys::written(Contained(b"let_go_items"), ty, module);
          {
            code: call_of(module, items, [a, int_code(0)], unit_type()),
            here: [def_of(module, items, [ty, int_type()], unit_type(), release_row(ctors, ty))],
          }
        } else {
          match ctors.sums.get(c.name) {
            None -> { code: unit_code(), here: [] },
            Some(cs) ->
              {
                code: match_code(
                  a,
                  cs.fold(
                    { arms: [], slot: 1 },
                    |acc: { arms: List<CodeArm>, slot: Int }, sc: SumCtor| {
                      let xs = bound_from(acc.slot, b"x", ctor_fields_at(sc, c.args));
                      let held = xs.filter(|x: Bound| holds_resource(ctors, x.ty));
                      {
                        arms: acc.arms.push({
                          pat: PxCtor({
                            sum: c.name,
                            name: sc.name,
                            case: sc.index,
                            args: xs.map(|x: Bound|
                              if holds_resource(ctors, x.ty) { bound_pattern(x) } else { PxWild }),
                          }),
                          guard: None,
                          body: sequence(held.map(|x: Bound| let_go(bound_read(x)))),
                        }),
                        slot: acc.slot + xs.len(),
                      }
                    },
                  ).arms,
                  unit_type(),
                ),
                here: [],
              },
          }
        },
      },
      _ -> { code: unit_code(), here: [] },
    },
  };
  rooted_at(module, key, [ty], unit_type(), body, release_row(ctors, ty))
}

/// `let_go_items#List<T>` over its parameters `a`, lent, and `i`: each item of `a` from place `i`
/// on let go, by `T`'s own release.
pub fn let_go_items_code(
  module: Bytes,
  ctors: Ctors,
  key: RootKey,
  ty: Type,
) -> WrittenRoot / {abort.raise} = {
  let item = match ty {
    TyCon(c) -> match c.args.at(0) { Some(t) -> t, None -> unknown_type() },
    _ -> unknown_type(),
  };
  let a = slot_code(b"a", 0, ty);
  let i = slot_code(b"i", 1, int_type());
  let next = call_of(module, key, [a, binary_of(b"add", i, int_code(1))], unit_type());
  let got = prelude_call(b"List::at", [plain(item)], [a, i], option_type(plain(item)));
  rooted_at(
    module,
    key,
    [ty, int_type()],
    unit_type(),
    {
      code: some_or(
        got,
        b"x",
        2,
        plain(item),
        sequence([let_go(slot_code(b"x", 2, plain(item))), next]),
        unit_code(),
      ),
      here: [],
    },
    release_row(ctors, ty),
  )
}

/// `x` let go by `?let_go`, which the lowering settles by the type `x` holds.
fn let_go(x: Code) -> Code = builtin_call(b"?let_go", [], [x], unit_type())

// --- Crossings --------------------------------------------------------------------------------

/// Whether root `op` of a type is one a crossing runs, which `crossing_root` writes: a lowering, a
/// lifting, a keeping or an opening, or a loop of one over a container's items.
pub fn crossing_op(op: TypeOp) -> Bool =
  match op {
    Lower -> true,
    Lift -> true,
    Keeping -> true,
    Opening -> true,
    Contained(c) -> crossing_loops().contains(c) || kept_loops().contains(c),
    _ -> false,
  }

/// The root `key`, written in `module`, a crossing runs: `lower#T`, which writes the `T` it reads
/// into the innermost lowering as PLV1 holds it and answers `()`; `lift#T`, which reads a `T` from
/// the innermost lifting and answers it as compiled code makes one; `keeping#T` and `opening#T`
/// (`kept_code`); or a loop of one over a container's items (`crossing_loop`, `kept_loop`). The
/// places of `T` the key marks cross carried: a value the runtime keeps with its type, as `HANDLE`,
/// rather than reads.
pub fn crossing_root(module: Bytes, ctors: Ctors, key: RootKey) -> WrittenRoot / {abort.raise} =
  match key {
    Written(w, _) -> {
      let marked = marked_type(w.ty, w.marks);
      match w.op {
        Lower -> rooted_at(module, key, [w.ty], unit_type(), lowering_code(module, ctors, marked)),
        Lift -> rooted_at(module, key, [], w.ty, lifting_code(module, ctors, marked)),
        Keeping ->
          rooted_at(module, key, [w.ty], kept_form(marked), kept_code(module, ctors, marked, true)),
        Opening ->
          rooted_at(
            module,
            key,
            [kept_form(marked)],
            w.ty,
            kept_code(module, ctors, marked, false),
          ),
        Contained(c) -> match if kept_loops().contains(c) { kept_loop(module, c, marked) }
          else { crossing_loop(module, c, w.ty, marked) } {
          Some(r) -> r,
          None -> uncrossed(b"a root no crossing runs"),
        },
        _ -> uncrossed(b"a root no crossing runs"),
      }
    },
    _ -> uncrossed(b"a root no crossing runs"),
  }

// --- Kept crossings --------------------------------------------------------------------------------

// A perform of an operation a program declares hands its clause, compiled once for every perform,
// each value at a place its operation's own type parameters stand kept (`kept_form`), and opens
// what the clause answers there: `keeping#T` and `opening#T`, marked at those places, make one form
// of the other part by part.

/// The loops a keeping or an opening runs over a container's items or a map's entries, into the
/// list or map it makes.
fn kept_loops() -> List<Bytes> =
  [b"keeping_items", b"opening_items", b"keeping_entries", b"opening_entries"]

/// The form a value of the marked type `ty` takes on the side `keeping` names: where a keeping
/// starts, or an opening ends, its own; else the one its marked places kept.
fn kept_side(ty: Type, kept: Bool) -> Type / {abort.raise} =
  if kept { kept_form(ty) } else { plain(ty) }

/// `x`, a part of the marked type `ty`, made into its other form: unchanged where `ty` marks no
/// place, else by `?keeping` or `?opening` at `ty`, which the part's own root answers.
fn kept_part(x: Code, ty: Type, keeping: Bool) -> Code / {abort.raise} =
  if !marked(ty) { x } else {
    builtin_call(if keeping { b"?keeping" } else { b"?opening" }, [ty], [x], kept_side(ty, keeping))
  }

/// The body of `keeping#T` (`keeping`) or `opening#T` over its parameter `a`, `ty` marked at the
/// places kept: at a marked place, the value kept beside its type's descriptor (`?keep`) or what
/// it keeps opened (`?open`); a record field by field; a sum's constructor with its arguments; a
/// list, an array or a map item by item through a loop (`kept_loop`); a function wrapped, so the
/// clause calls it with values kept and is answered one, its parameters made the other way: an
/// operation generic in its own type parameters takes no row parameter, so a function it is handed
/// performs nothing, and nor does the wrapper. No kept crossing is of a runtime object or a type
/// variable: neither has a place a perform crosses at alone.
fn kept_code(
  module: Bytes,
  ctors: Ctors,
  ty: Type,
  keeping: Bool,
) -> { code: Code, here: List<Def> } / {abort.raise} = {
  let from = kept_side(ty, !keeping);
  let a = slot_code(b"a", 0, from);
  let into = kept_side(ty, keeping);
  let items_op = if keeping { b"keeping_items" } else { b"opening_items" };
  // The items of the container `over` made into the list `listed` (marked) is made of, from empty.
  let looped = |over: Type, listed: Type| {
    let loop = marked_key(Contained(items_op), over, module);
    let out = kept_side(listed, keeping);
    {
      code: call_of(module, loop, [a, bare(NList({ items: [] }), out), int_code(0)], out),
      here: [def_of(module, loop, [kept_side(over, !keeping), out, int_type()], out)],
    }
  };
  match ty {
    TyCon(c) -> if c.name == b"^" && c.args.len() == 1 {
      {
        code: builtin_call(if keeping { b"?keep" } else { b"?open" }, [c.args.get(0)], [a], into),
        here: [],
      }
    } else if !marked(ty) { { code: a, here: [] } }
    else if c.name == list_name() && c.args.len() == 1 { looped(ty, ty) }
    else if c.name == array_name() && c.args.len() == 1 {
      let items = looped(ty, list_type(c.args.get(0)));
      {
        code: builtin_call(
          b"Array::of_list",
          [kept_side(c.args.get(0), keeping)],
          [items.code],
          into,
        ),
        here: items.here,
      }
    } else if c.name == map_name() && c.args.len() == 2 {
      let entries = list_type(
        TyRecord([{ name: b"key", ty: c.args.get(0) }, { name: b"value", ty: c.args.get(1) }]),
      );
      let from_args = match from { TyCon(f) -> f.args, _ -> [] };
      let into_args = match into { TyCon(i) -> i.args, _ -> [] };
      let listed = prelude_call(b"Map::entries", from_args, [a], kept_side(entries, !keeping));
      let fresh = builtin_call(b"Map::new", into_args, [], into);
      let loop = marked_key(
        Contained(if keeping { b"keeping_entries" } else { b"opening_entries" }),
        entries,
        module,
      );
      {
        code: call_of(module, loop, [listed, fresh, int_code(0)], into),
        here: [def_of(module, loop, [kept_side(entries, !keeping), into, int_type()], into)],
      }
    } else if runtime_object(c.name) {
      uncrossed(b"a value of a runtime object an operation's own type parameter stands in")
    } else {
      match ctors.sums.get(c.name) {
        None -> uncrossed(b"a kept crossing of a type no root writes: ".concat(c.name)),
        Some(cs) -> {
          let arms = cs.fold(
            { arms: [], slot: 1 },
            |acc: { arms: List<CodeArm>, slot: Int }, sc: SumCtor| {
              let args = ctor_fields_at(sc, c.args);
              let xs = bound_from(acc.slot, b"x", args.map(|t: Type| kept_side(t, !keeping)));
              {
                arms: acc.arms.push({
                  pat: PxCtor({
                    sum: c.name,
                    name: sc.name,
                    case: sc.index,
                    args: xs.map(bound_pattern),
                  }),
                  guard: None,
                  body: ctor_made(
                    c.name,
                    sc.name,
                    sc.index,
                    zip(xs, args).map(|p: { first: Bound, second: Type }|
                      kept_part(bound_read(p.first), p.second, keeping)),
                    into,
                  ),
                }),
                slot: acc.slot + xs.len(),
              }
            },
          );
          { code: match_code(a, arms.arms, into), here: [] }
        },
      }
    },
    TyRecord(fs) -> kept_record(a, fs, into, keeping),
    TyNominal(x) -> kept_record(a, x.fields, into, keeping),
    TyFn(f) -> kept_function(f.params, f.ret, from, into, keeping),
    TyVar(_) -> uncrossed(b"a kept crossing at a type variable"),
  }
}

/// A record of fields `fields` (each marked) made into its other form `into`, field by field.
fn kept_record(
  a: Code,
  fields: List<Field>,
  into: Type,
  keeping: Bool,
) -> { code: Code, here: List<Def> } / {abort.raise} =
  {
    code: bare(
      NRecord({
        fields: fields.map(|f: Field|
          {
            name: f.name,
            value: kept_part(field_code(a, f.name, kept_side(f.ty, !keeping)), f.ty, keeping),
          }),
      }),
      into,
    ),
    here: [],
  }

/// The function `a` (slot 0), of form `from`, parameters `params` and answer `ret` (each marked),
/// wrapped into its other form `into`: a closure over `a` that makes each argument the other way,
/// calls `a`, and makes its answer this way.
fn kept_function(
  params: List<Type>,
  ret: Type,
  from: Type,
  into: Type,
  keeping: Bool,
) -> { code: Code, here: List<Def> } / {abort.raise} = {
  let n = params.len();
  let args = range(0, n).map(|j: Int|
    kept_part(
      slot_code(b"p".concat(ascii_of_int(j)), j, kept_side(params.get(j), keeping)),
      params.get(j),
      !keeping,
    ));
  // The closure reads `a` as its capture, at the type the root takes it.
  let called = applied(slot_code(b"f", n, from), args, kept_side(ret, !keeping));
  let ty = match into {
    TyFn(g) -> g,
    _ -> { params: params, kept: [], once: false, ret: ret, effects: row_empty() },
  };
  {
    code: bare(
      NLambda({
        params: n,
        size: n + 1,
        captures: [{ src: 0, dst: n }],
        body: kept_part(called, ret, keeping),
        at: placed(0),
        ty: ty,
        row: row_empty(),
      }),
      TyFn(ty),
    ),
    here: [],
  }
}

/// The loop `op` (one of `kept_loops`) over the container of type `over`, marked, where `op` names
/// one: over its parameters `a`, the items or entries, `out`, what is made so far, and `i`, the
/// place reached, each item from `i` on made into its other form and pushed onto `out`, or each
/// entry's key and value inserted into it.
fn kept_loop(module: Bytes, op: Bytes, over: Type) -> Option<WrittenRoot> / {abort.raise} = {
  let keeping = op.starts_with(b"keeping");
  let key = marked_key(Contained(op), over, module);
  let from = kept_side(over, !keeping);
  let a = slot_code(b"a", 0, from);
  let i = slot_code(b"i", 2, int_type());
  match item_of(over) {
    None -> None,
    Some(item) -> {
      let container = match over { TyCon(c) -> c.name, _ -> list_name() };
      let held = kept_side(item, !keeping);
      // A list's item is read by the prelude's `List::at`, written in Ply; any other's by its builtin.
      let got = if container == list_name() {
        prelude_call(b"List::at", [held], [a, i], option_type(held))
      } else { builtin_call(container.concat(b"::at"), [held], [a, i], option_type(held)) };
      let x = slot_code(b"x", 3, held);
      let body = if op.ends_with(b"entries") {
        let key_type = field_of(item, b"key");
        let value_type = field_of(item, b"value");
        let k = kept_part(field_code(x, b"key", kept_side(key_type, !keeping)), key_type, keeping);
        let v = kept_part(
          field_code(x, b"value", kept_side(value_type, !keeping)),
          value_type,
          keeping,
        );
        let both = [kept_side(key_type, keeping), kept_side(value_type, keeping)];
        let into = TyCon({ name: map_name(), args: both });
        {
          code: prelude_call(b"Map::insert", both, [slot_code(b"out", 1, into), k, v], into),
          into: into,
        }
      } else {
        let into = kept_side(list_type(item), keeping);
        {
          code: prelude_call(
            b"List::push",
            [kept_side(item, keeping)],
            [slot_code(b"out", 1, into), kept_part(x, item, keeping)],
            into,
          ),
          into: into,
        }
      };
      let out = slot_code(b"out", 1, body.into);
      Some(
        rooted_at(module, key, [from, body.into, int_type()], body.into, {
          code: some_or(
            got,
            b"x",
            3,
            held,
            call_of(module, key, [a, body.code, binary_of(b"add", i, int_code(1))], body.into),
            out,
          ),
          here: [],
        }),
      )
    },
  }
}

/// Panics over a crossing of what no crossing root writes, as `why` says: a crossing is asked for
/// only at a type the checker lets cross.
fn uncrossed<a>(why: Bytes) -> a / {abort.raise} = panic(String::of_bytes_lossy(why))

/// The loop `op` a crossing runs over the items of a container of type `t`, `marked` with its
/// carried places, where `op` names one: `lower_items` and `lower_entries` over a list's items or a
/// map's entries from an index, `lift_items` and `lift_entries` onto a list or a map so far for as
/// many items as are left.
fn crossing_loop(
  module: Bytes,
  op: Bytes,
  t: Type,
  marked: Type,
) -> Option<WrittenRoot> / {abort.raise} = {
  let key = marked_key(Contained(op), marked, module);
  match item_of(marked) {
    None -> None,
    Some(item) -> if op == b"lower_items" {
      Some(
        rooted_at(
          module,
          key,
          [t, int_type()],
          unit_type(),
          items_lowered(module, key, t, marked, item),
        ),
      )
    } else if op == b"lower_entries" {
      Some(
        rooted_at(module, key, [t, int_type()], unit_type(), entries_lowered(module, key, t, item)),
      )
    } else if op == b"lift_items" {
      Some(rooted_at(module, key, [t, int_type()], t, items_lifted(module, key, t, item)))
    } else if op == b"lift_entries" {
      Some(rooted_at(module, key, [t, int_type()], t, entries_lifted(module, key, t, marked)))
    } else { None },
  }
}

/// The root `R#entered` the runtime enters root `root` of `module` through, calling `callee` at type
/// arguments `at` and its row variables at `rows`, taking `params` and answering `answer`: from the
/// lifting the runtime opened over the list of its arguments' encodings, each argument read and the
/// lifting ended; then `callee` called on them, and its answer written into the lowering the runtime
/// opened beneath, which it ends. A generic definition is called as any caller calls it at `at` and
/// `rows`, through its own scheme; any other root is declared at `params` and `answer`, performing
/// `row`, its own atoms. `hosts` are the real handlers the call runs under, each by its name across
/// the program, the effect it answers and the atoms its own row adds, the first outermost: each is
/// handed a closure over the call inside it, which performs what that call does, and answers it,
/// leaving its caller the rest and what it adds. The body performs what the outermost leaves, the
/// effects the entry holds a word for. A `pure` callee taking nothing is read as a constant is, so
/// only the first entry runs its body.
pub fn entered_code(
  module: Bytes,
  root: RootKey,
  callee: RootKey,
  at: List<Type>,
  rows: List<Row>,
  params: List<Type>,
  answer: Type,
  row: Row,
  hosts: List<{ call: Bytes, effect: Bytes, adds: List<Atom> }>,
  pure: Bool = false,
) -> WrittenRoot / {abort.raise} = {
  let key = keys::Entered(root);
  let read = range(0, params.len()).fold(
    [CDo({ code: native_call(b"?in_count", [int_code(tag_list())], int_type()) })],
    |acc: List<CodeStmt>, i: Int|
      acc.push(
        CLet({
          name: b"p".concat(ascii_of_int(i)),
          slot: i,
          value: builtin_call(b"?lift", [params.get(i)], [], params.get(i)),
        }),
      ),
  );
  let reads = range(0, params.len()).map(|i: Int|
    slot_code(b"p".concat(ascii_of_int(i)), i, params.get(i)));
  let direct = applied(
    bare(
      NDef({ full: qualified_root(module, callee), args: at, rows: rows, labels: [] }),
      fn_type(params, answer, { atoms: row.atoms, tail: None }),
    ),
    reads,
    answer,
  );
  let generic = at.len() > 0 || rows.len() > 0;
  let called = hosts.reverse().fold(
    { code: direct, atoms: row.atoms, n: 0 },
    |inner: { code: Code, atoms: List<Atom>, n: Int }, host: { call: Bytes, effect: Bytes, adds: List<Atom> }| {
      let performs = { atoms: inner.atoms, tail: None };
      let lambda_ty = { params: [], kept: [], once: false, ret: answer, effects: row_empty() };
      let left = inner.atoms.filter(|a: Atom| a.effect != host.effect);
      let leaves = { atoms: left, tail: None };
      {
        code: applied(
          bare(
            NDef({ full: host.call, args: [answer], rows: [leaves], labels: [] }),
            fn_type([TyFn({ ..lambda_ty, effects: performs })], answer, leaves),
          ),
          [
            bare(
              NLambda({
                params: 0,
                size: params.len(),
                captures: range(0, params.len()).map(|i: Int| { src: i, dst: i }),
                body: inner.code,
                at: placed(inner.n),
                ty: lambda_ty,
                row: performs,
              }),
              TyFn(lambda_ty),
            ),
          ],
          answer,
        ),
        atoms: host.adds.fold(left, |acc: List<Atom>, a: Atom|
          if acc.contains(a) { acc } else { acc.push(a) }),
        n: inner.n + 1,
      }
    },
  );
  {
    ..rooted_at(module, key, [], unit_type(), { code: block_code(read.push(CDo({ code: native_call(b"?lift_close", [], unit_type()) })), builtin_call(b"?lower", [answer], [called.code], unit_type())), here: if generic { [] } else { [called_def(module, callee, params, answer, { atoms: row.atoms, tail: None }, pure)] } }),
    performs: { atoms: called.atoms, tail: None },
  }
}

/// Root `root` of `module`, taking `params`, answering `answer` and performing `row`, as a root
/// written to enter it calls it: where `pure`, and it takes nothing, a constant read from what the
/// unit keeps of it; otherwise its own function, called.
pub fn called_def(
  module: Bytes,
  root: RootKey,
  params: List<Type>,
  answer: Type,
  row: Row,
  pure: Bool,
) -> Def / {abort.raise} =
  {
    name: local_root(module, root_text(root_name(root))),
    ret: Some(kind_of(answer).kind),
    ret_ty: TyOpen([]),
    pure: pure,
    constant: false,
    arity: params.len(),
    scheme: Some(monomorphic(fn_type(params, answer, row))),
    witnesses: 0,
    lent: [],
    root: root,
  }

/// The body of `lower#T` over its parameter `a`, a value of `ty`, and the definitions of the loops
/// it calls: a scalar by the crossing native for its kind, a record its fields in name order each
/// after its name, a declared sum its constructor by program-wide name and its arguments, a list, an
/// array or a map its count and its items (a map's each key then its value, in key order; a
/// `Columns` as the array of its records the runtime reads it as), a runtime object as a handle and
/// a function as an anonymous one. A string, bytes, list, array or map is asked after first, and
/// written as `AGAIN` where the lowering shares values and wrote it before.
fn lowering_code(
  module: Bytes,
  ctors: Ctors,
  ty: Type,
) -> { code: Code, here: List<Def> } / {abort.raise} = {
  let held = plain(ty);
  let a = slot_code(b"a", 0, held);
  let out = |name: Bytes, args: List<Code>| native_call(name, args, unit_type());
  let alone = |c: Code| { code: c, here: [] };
  let shared = |parts: List<Code>|
    if_code(
      binary_of(b"eq", native_call(b"?out_again", [a], int_type()), int_code(0)),
      sequence(parts),
      unit_code(),
    );
  let args_at = match held { TyCon(c) -> c.args, _ -> [] };
  match ty {
    TyCon(c) -> if c.name == b"^" && c.args.len() == 1 {
      alone(builtin_call(b"?out_carried", [held], [a], unit_type()))
    } else if c.args.len() == 0 && c.name == unit_name() {
      alone(out(b"?out_tag", [int_code(tag_unit())]))
    } else if c.args.len() == 0 && c.name == bool_name() {
      alone(out(b"?out_tag", [if_code(a, int_code(tag_true()), int_code(tag_false()))]))
    } else if c.args.len() == 0 && c.name == int_name() { alone(out(b"?out_int", [a])) }
    else if c.args.len() == 0 && c.name == float_name() { alone(out(b"?out_float", [a])) }
    else if c.args.len() == 0 && c.name == decimal_name() { alone(out(b"?out_decimal", [a])) }
    else if c.args.len() == 0 && width_named(c.name) != None { alone(out(b"?out_fixed", [a])) }
    else if c.args.len() == 0 && c.name == char_name() {
      alone(out(b"?out_char", [builtin_call(b"Int::of_char", [], [a], int_type())]))
    } else if c.args.len() == 0 && c.name == string_name() {
      alone(shared([out(b"?out_str", [a])]))
    } else if c.args.len() == 0 && c.name == bytes_name() {
      alone(shared([out(b"?out_bytes", [a])]))
    } else if runtime_object(c.name) { alone(out(b"?out_handle", [a])) }
    else if c.name == list_name() && c.args.len() == 1 {
      let items = marked_key(Contained(b"lower_items"), ty, module);
      {
        code: shared([
          out(b"?out_count", [
            int_code(tag_list()),
            builtin_call(b"List::len", args_at, [a], int_type()),
          ]),
          call_of(module, items, [a, int_code(0)], unit_type()),
        ]),
        here: [def_of(module, items, [held, int_type()], unit_type())],
      }
    } else if (c.name == array_name() || c.name == columns_name()) && c.args.len() == 1 {
      // A `Columns` crosses as the array of its records the runtime reads it as.
      let items = marked_key(Contained(b"lower_items"), ty, module);
      {
        code: shared([
          out(b"?out_count", [
            int_code(tag_array()),
            builtin_call(c.name.concat(b"::len"), args_at, [a], int_type()),
          ]),
          call_of(module, items, [a, int_code(0)], unit_type()),
        ]),
        here: [def_of(module, items, [held, int_type()], unit_type())],
      }
    } else if c.name == map_name() && c.args.len() == 2 {
      let entries = list_type(
        TyRecord([{ name: b"key", ty: c.args.get(0) }, { name: b"value", ty: c.args.get(1) }]),
      );
      let each = marked_key(Contained(b"lower_entries"), entries, module);
      {
        code: shared([
          out(b"?out_count", [
            int_code(tag_map()),
            builtin_call(b"Map::len", args_at, [a], int_type()),
          ]),
          call_of(
            module,
            each,
            [prelude_call(b"Map::entries", args_at, [a], plain(entries)), int_code(0)],
            unit_type(),
          ),
        ]),
        here: [def_of(module, each, [plain(entries), int_type()], unit_type())],
      }
    } else {
      match ctors.sums.get(c.name) {
        None -> uncrossed(b"a crossing of a type no root writes: ".concat(c.name)),
        Some(cs) -> {
          let arms = cs.fold(
            { arms: [], slot: 1 },
            |acc: { arms: List<CodeArm>, slot: Int }, sc: SumCtor| {
              let args = ctor_fields_at(sc, c.args);
              let xs = bound_from(acc.slot, b"x", args.map(plain));
              {
                arms: acc.arms.push({
                  pat: PxCtor({
                    sum: c.name,
                    name: sc.name,
                    case: sc.index,
                    args: xs.map(bound_pattern),
                  }),
                  guard: None,
                  body: sequence(
                    [out(b"?out_ctor", [bytes_code(sc.name), int_code(args.len())])].concat(
                      zip(xs, args).map(|p: { first: Bound, second: Type }|
                        builtin_call(b"?lower", [p.second], [bound_read(p.first)], unit_type())),
                    ),
                  ),
                }),
                slot: acc.slot + xs.len(),
              }
            },
          );
          { code: match_code(a, arms.arms, unit_type()), here: [] }
        },
      }
    },
    TyRecord(fs) -> record_lowered(a, fs),
    TyNominal(x) -> record_lowered(a, x.fields),
    // The runtime asks the function whether it may leave its run: a continuation's closure may not.
    TyFn(_) -> alone(out(b"?out_fun", [a, bytes_code(b"")])),
    TyVar(_) -> uncrossed(b"a crossing at a type variable"),
  }
}

/// A record's fields written in name order, each its name and then its value.
fn record_lowered(a: Code, fields: List<Field>) -> { code: Code, here: List<Def> } / {abort.raise} = {
  let fs = fields_sorted(fields);
  {
    code: sequence(
      fs.fold(
        [native_call(b"?out_count", [int_code(tag_record()), int_code(fs.len())], unit_type())],
        |acc: List<Code>, f: Field|
          acc.push(native_call(b"?out_name", [bytes_code(f.name)], unit_type())).push(
            builtin_call(b"?lower", [f.ty], [field_code(a, f.name, plain(f.ty))], unit_type()),
          ),
      ),
    ),
    here: [],
  }
}

/// The body of `lift#T`, which reads a value of `ty` and answers it, and the definitions of the
/// loops it calls: each kind read as `lowering_code` writes it, a record built from its fields read
/// in name order, a sum's constructor chosen by the name read, a list, array or map built from as
/// many items as its count says. A function made by the program, a runtime object and a value the
/// runtime keeps do not cross back.
fn lifting_code(
  module: Bytes,
  ctors: Ctors,
  ty: Type,
) -> { code: Code, here: List<Def> } / {abort.raise} = {
  let held = plain(ty);
  let args_at = match held { TyCon(c) -> c.args, _ -> [] };
  let alone = |c: Code| { code: c, here: [] };
  let read_as = |name: Bytes| alone(builtin_call(name, [held], [], held));
  let tag = native_call(b"?in_tag", [], int_type());
  let counted = |t: Int| native_call(b"?in_count", [int_code(t)], int_type());
  match ty {
    TyCon(c) -> if (c.name == b"^" && c.args.len() == 1) || runtime_object(c.name) {
      uncrossed(b"a lifting of a value the runtime keeps, which `crosses` refuses")
    } else if c.args.len() == 0 && c.name == unit_name() { alone(sequence([tag, unit_code()])) }
    else if c.args.len() == 0 && c.name == bool_name() {
      alone(binary_of(b"eq", tag, int_code(tag_true())))
    } else if c.args.len() == 0 && c.name == int_name() {
      alone(native_call(b"?in_int", [], int_type()))
    } else if c.args.len() == 0 && c.name == float_name() {
      alone(native_call(b"?in_float", [], float_type()))
    } else if c.args.len() == 0 && c.name == decimal_name() { read_as(b"?in_decimal") }
    else if c.args.len() == 0 && width_named(c.name) != None { read_as(b"?in_fixed") }
    else if c.args.len() == 0 && c.name == char_name() {
      alone(
        some_or(
          builtin_call(
            b"Char::of_int",
            [],
            [native_call(b"?in_char", [], int_type())],
            option_type(ty),
          ),
          b"ch",
          0,
          ty,
          slot_code(b"ch", 0, ty),
          // The runtime's reader refuses a code that is no character, so this arm never runs.
          bare(NLit(LChar(0)), ty),
        ),
      )
    } else if c.args.len() == 0 && c.name == string_name() { read_as(b"?in_str") }
    else if c.args.len() == 0 && c.name == bytes_name() { read_as(b"?in_bytes") }
    else if c.name == list_name() && c.args.len() == 1 {
      let items = marked_key(Contained(b"lift_items"), ty, module);
      {
        code: call_of(module, items, [bare(NList({ items: [] }), held), counted(tag_list())], held),
        here: [def_of(module, items, [held, int_type()], held)],
      }
    } else if (c.name == array_name() || c.name == columns_name()) && c.args.len() == 1 {
      let listed = list_type(c.args.get(0));
      let items = marked_key(Contained(b"lift_items"), listed, module);
      {
        code: builtin_call(
          c.name.concat(b"::of_list"),
          args_at,
          [
            call_of(
              module,
              items,
              [bare(NList({ items: [] }), plain(listed)), counted(tag_array())],
              plain(listed),
            ),
          ],
          held,
        ),
        here: [def_of(module, items, [plain(listed), int_type()], plain(listed))],
      }
    } else if c.name == map_name() && c.args.len() == 2 {
      let each = marked_key(Contained(b"lift_entries"), ty, module);
      {
        code: call_of(
          module,
          each,
          [builtin_call(b"Map::new", args_at, [], held), counted(tag_map())],
          held,
        ),
        here: [def_of(module, each, [held, int_type()], held)],
      }
    } else {
      match ctors.sums.get(c.name) {
        None -> uncrossed(b"a crossing of a type no root reads: ".concat(c.name)),
        Some(cs) -> {
          let made = cs.map(|sc: SumCtor| {
            let args = sc.fields.map(|f: Type| at_args(f, sc.params, c.args));
            {
              name: sc.name,
              code: ctor_made(
                c.name,
                sc.name,
                sc.index,
                args.map(|t: Type| builtin_call(b"?lift", [t], [], plain(t))),
                held,
              ),
            }
          });
          let chosen = range(0, made.len()).fold(unit_code(), |later: Code, n: Int| {
            let k = made.len() - 1 - n;
            let m = made.get(k);
            if k == made.len() - 1 { m.code } else {
              if_code(
                binary_of(
                  b"eq",
                  native_call(b"?in_name_is", [bytes_code(m.name)], int_type()),
                  int_code(1),
                ),
                m.code,
                later,
              )
            }
          });
          alone(sequence([counted(tag_ctor()), chosen]))
        },
      }
    },
    TyRecord(fs) -> record_lifted(held, fs),
    TyNominal(x) -> record_lifted(held, x.fields),
    TyFn(_) -> uncrossed(b"a function crossing back from the runtime"),
    TyVar(_) -> uncrossed(b"a crossing at a type variable"),
  }
}

/// A record of type `ty` read as its fields in name order, each its name and then its value.
fn record_lifted(ty: Type, fields: List<Field>) -> { code: Code, here: List<Def> } / {abort.raise} =
  {
    code: sequence([
      native_call(b"?in_count", [int_code(tag_record())], int_type()),
      bare(
        NRecord({
          fields: fields_sorted(fields).map(|f: Field|
            {
              name: f.name,
              value: sequence([
                native_call(b"?in_field", [bytes_code(f.name)], unit_type()),
                builtin_call(b"?lift", [f.ty], [], plain(f.ty)),
              ]),
            }),
        }),
        ty,
      ),
    ]),
    here: [],
  }

/// `lower_items#C<T>` over its parameters `a`, of type `t`, and `i`, `C` a list, an array or columns
/// (the `container` with its carried places): each item of `a` from place `i` on written at the
/// items' type, `item` with its carried places.
fn items_lowered(
  module: Bytes,
  key: RootKey,
  t: Type,
  container: Type,
  item: Type,
) -> { code: Code, here: List<Def> } / {abort.raise} = {
  let a = slot_code(b"a", 0, t);
  let i = slot_code(b"i", 1, int_type());
  let next = call_of(module, key, [a, binary_of(b"add", i, int_code(1))], unit_type());
  let lowered = builtin_call(b"?lower", [item], [slot_code(b"x", 2, plain(item))], unit_type());
  match container {
    // An array's or columns' item is read in place below its length, no list made of it.
    TyCon(c) -> if c.name == array_name() || c.name == columns_name() {
      {
        code: if_code(
          binary_of(
            b"lt",
            i,
            builtin_call(c.name.concat(b"::len"), [plain(item)], [a], int_type()),
          ),
          block_code(
            [
              CLet({
                name: b"x",
                slot: 2,
                value: builtin_call(c.name.concat(b"::get"), [plain(item)], [a, i], plain(item)),
              }),
            ],
            sequence([lowered, next]),
          ),
          unit_code(),
        ),
        here: [],
      }
    } else {
      {
        code: some_or(
          prelude_call(b"List::at", [plain(item)], [a, i], option_type(plain(item))),
          b"x",
          2,
          plain(item),
          sequence([lowered, next]),
          unit_code(),
        ),
        here: [],
      }
    },
    _ -> uncrossed(b"a loop over items of no container"),
  }
}

/// `lower_entries#List<{key, value}>` over its parameters `es`, of type `t`, and `i`: each entry of
/// `es` from place `i` on, its key and then its value, each at its own type, `entry` with its carried
/// places.
fn entries_lowered(
  module: Bytes,
  key: RootKey,
  t: Type,
  entry: Type,
) -> { code: Code, here: List<Def> } / {abort.raise} = {
  let es = slot_code(b"es", 0, t);
  let i = slot_code(b"i", 1, int_type());
  let e = slot_code(b"e", 2, plain(entry));
  let part = |name: Bytes|
    builtin_call(
      b"?lower",
      [field_of(entry, name)],
      [field_code(e, name, plain(field_of(entry, name)))],
      unit_type(),
    );
  {
    code: some_or(
      prelude_call(b"List::at", [plain(entry)], [es, i], option_type(plain(entry))),
      b"e",
      2,
      plain(entry),
      sequence([
        part(b"key"),
        part(b"value"),
        call_of(module, key, [es, binary_of(b"add", i, int_code(1))], unit_type()),
      ]),
      unit_code(),
    ),
    here: [],
  }
}

/// `lift_items#List<T>` over its parameters `acc`, of type `t`, and `n`: `n` more items read onto
/// `acc`, `item` with its carried places.
fn items_lifted(
  module: Bytes,
  key: RootKey,
  t: Type,
  item: Type,
) -> { code: Code, here: List<Def> } / {abort.raise} = {
  let acc = slot_code(b"acc", 0, t);
  let n = slot_code(b"n", 1, int_type());
  let pushed = prelude_call(
    b"List::push",
    [plain(item)],
    [acc, builtin_call(b"?lift", [item], [], plain(item))],
    t,
  );
  {
    code: if_code(
      binary_of(b"eq", n, int_code(0)),
      acc,
      call_of(module, key, [pushed, binary_of(b"sub", n, int_code(1))], t),
    ),
    here: [],
  }
}

/// `lift_entries#Map<K, V>` over its parameters `m`, of type `t`, and `n`: `n` more entries read
/// into `m`, each a key and then its value, `ty` with its carried places.
fn entries_lifted(
  module: Bytes,
  key: RootKey,
  t: Type,
  ty: Type,
) -> { code: Code, here: List<Def> } / {abort.raise} = {
  let args = match ty { TyCon(c) -> c.args, _ -> [] };
  let m = slot_code(b"m", 0, t);
  let n = slot_code(b"n", 1, int_type());
  let lifted = |k: Int| builtin_call(b"?lift", [args.get(k)], [], plain(args.get(k)));
  let inserted = prelude_call(b"Map::insert", args.map(plain), [m, lifted(0), lifted(1)], t);
  {
    code: if_code(
      binary_of(b"eq", n, int_code(0)),
      m,
      call_of(module, key, [inserted, binary_of(b"sub", n, int_code(1))], t),
    ),
    here: [],
  }
}

/// What a loop over `ty` walks: a list's, an array's or columns' items, and for `lift_entries` a
/// map's own type.
fn item_of(ty: Type) -> Option<Type> =
  match ty {
    TyCon(c) -> if (c.name == list_name() || c.name == array_name() || c.name == columns_name())
        && c.args.len() == 1 { c.args.at(0) }
    else if c.name == map_name() && c.args.len() == 2 { Some(ty) }
    else { None },
    _ -> None,
  }

fn field_of(ty: Type, name: Bytes) -> Type =
  match ty {
    TyRecord(fs) ->
      fs.fold(unknown_type(), |acc: Type, f: Field| if f.name == name { f.ty } else { acc }),
    _ -> unknown_type(),
  }

/// The types a crossing writes and reads back in a program: `sums` each declared sum's
/// constructors, and of them those whose values a lowering cannot write and those a lifting cannot
/// read; whether the program holds what the code written for a container calls, and what the code
/// reading one back calls besides (`written_code`).
pub type CrossedSums = {
  sums: Map<Bytes, List<SumCtor>>,
  unwritten: List<Bytes>,
  unread: List<Bytes>,
  containers: Bool,
  lifts: Bool,
}

/// What crosses in a program of `sums`, `holds` saying whether it holds a function of `std.prelude`
/// by its name there.
pub fn sums_crossed(sums: Map<Bytes, List<SumCtor>>, holds: (Bytes) -> Bool) -> CrossedSums = {
  let c = {
    sums: sums,
    unwritten: [],
    unread: [],
    containers: written_code().calls.all(holds),
    lifts: written_code().lifts.all(holds),
  };
  { ..c, unwritten: sums_uncrossed(c, false), unread: sums_uncrossed(c, true) }
}

/// Whether a lowering writes a value of `t`, or with `back` a lifting reads one: whether
/// `lowering_code` or `lifting_code` writes `t` and every type its parts cross at, and the program
/// holds what that code calls. A function and a runtime object cross out, never back.
pub fn crosses(c: CrossedSums, t: Type, back: Bool) -> Bool =
  part_crosses(c, if back { c.unread } else { c.unwritten }, t, false, back)

/// The sums of `c` a crossing cannot write, or with `back` read: each with a constructor holding a
/// part of a type that does not cross, its own parameters standing for types that do. A round that
/// grows adds a sum, so there are no more rounds than sums.
fn sums_uncrossed(c: CrossedSums, back: Bool) -> List<Bytes> =
  range(0, c.sums.len() + 1).fold(
    { bad: [], done: false },
    |st: { bad: List<Bytes>, done: Bool }, _: Int|
      if st.done { st } else {
        let more = c.sums.fold(st.bad, |acc: List<Bytes>, name: Bytes, cs: List<SumCtor>|
          if acc.contains(name)
              || cs.all(|sc: SumCtor|
                sc.fields.all(|f: Type| part_crosses(c, st.bad, f, true, back))) { acc }
          else { acc.push(name) });
        { bad: more, done: more.len() == st.bad.len() }
      },
  ).bad

/// `crosses` of `t`, `bad` the sums that do not cross, and with `open` its type variables a sum's
/// parameters.
fn part_crosses(c: CrossedSums, bad: List<Bytes>, t: Type, open: Bool, back: Bool) -> Bool =
  match t {
    TyVar(_) -> open,
    TyFn(_) -> !back,
    TyRecord(fs) -> fs.all(|f: Field| part_crosses(c, bad, f.ty, open, back)),
    TyNominal(x) -> x.fields.all(|f: Field| part_crosses(c, bad, f.ty, open, back)),
    TyCon(k) -> {
      let parts = k.args.all(|a: Type| part_crosses(c, bad, a, open, back));
      if k.args.len() == 0
          && ([
            unit_name(),
            bool_name(),
            int_name(),
            float_name(),
            decimal_name(),
            char_name(),
            string_name(),
            bytes_name(),
          ].contains(
            k.name,
          )
          || width_named(k.name) != None) { true }
      // A runtime object crosses out as a handle, and no lifting holds one beside its bytes.
      else if runtime_object(k.name) { !back }
      else if (k.name == list_name() || k.name == array_name()) && k.args.len() == 1 {
        c.containers && parts
      } else if k.name == columns_name() && k.args.len() == 1 {
        c.containers && parts && k.args.all(|a: Type| of_records(a, open))
      } else if k.name == map_name() && k.args.len() == 2 {
        c.containers && (!back || c.lifts) && parts
      } else { c.sums.contains(k.name) && !bad.contains(k.name) && parts }
    },
  }

/// Whether a `Columns` of `t` holds records, as the language's `Columns` does (`E0224`): a record of
/// at least one field, or with `open` a type variable standing for one.
fn of_records(t: Type, open: Bool) -> Bool =
  match t {
    TyRecord(fs) -> fs.len() > 0,
    TyNominal(x) -> x.fields.len() > 0,
    TyVar(_) -> open,
    _ -> false,
  }

/// Root `key` of `module`, taking `params` and answering `answer`, whose body `body` wrote.
fn rooted_at(
  module: Bytes,
  key: RootKey,
  params: List<Type>,
  answer: Type,
  body: { code: Code, here: List<Def> },
  row: Row = { atoms: [], tail: None },
) -> WrittenRoot / {abort.raise} =
  {
    params: range(0, params.len()).map(|i: Int| {
      let t = params.get(i);
      let k = kind_of(t);
      { name: param_name(key, i), kind: k.kind, ty: k.ty, of: Some(t), lambda: None }
    }),
    code: body.code,
    here: [def_of(module, key, params, answer, row)].concat(body.here),
    performs: row_empty(),
  }

/// The name parameter `i` of crossing root `key` is read by.
fn param_name(key: RootKey, i: Int) -> Bytes =
  match key {
    Written(w, _) -> match w.op {
      Contained(c) -> if kept_loops().contains(c) { match i { 0 -> b"a", 1 -> b"out", _ -> b"i" } }
      else if i == 1 { if c.starts_with(b"lift") { b"n" } else { b"i" } }
      else if c == b"lower_entries" { b"es" }
      else if c == b"lift_items" { b"acc" }
      else if c == b"lift_entries" { b"m" }
      else { b"a" },
      _ -> b"a",
    },
    _ -> b"p".concat(ascii_of_int(i)),
  }

/// The definition a call of root `key`, written in `module`, names: taking `params`, answering
/// `answer`, performing `row`, written by the emitter.
fn def_of(
  module: Bytes,
  key: RootKey,
  params: List<Type>,
  answer: Type,
  row: Row = { atoms: [], tail: None },
) -> Def / {abort.raise} =
  {
    name: local_root(module, root_text(root_name(key))),
    ret: Some(kind_of(answer).kind),
    ret_ty: TyOpen([]),
    pure: row.atoms.len() == 0,
    constant: false,
    arity: params.len(),
    scheme: Some(monomorphic(fn_type(params, answer, row))),
    witnesses: 0,
    lent: [],
    root: key,
  }

/// The name across the program of the definition root `key`, written in `module`, is.
fn qualified_root(module: Bytes, key: RootKey) -> Bytes / {abort.raise} =
  qualify(module, local_root(module, root_text(root_name(key))))

/// A call of root `key`, written in `module`, on `args`, answering `ret`.
fn call_of(module: Bytes, key: RootKey, args: List<Code>, ret: Type) -> Code / {abort.raise} =
  applied(
    bare(
      NDef({ full: qualified_root(module, key), args: [], rows: [], labels: [] }),
      fn_type(args.map(|a: Code| a.ty), ret, row_empty()),
    ),
    args,
    ret,
  )

// The tags PLV1 opens a value of each kind with.
fn tag_unit() -> Int = 0

fn tag_false() -> Int = 1

fn tag_true() -> Int = 2

fn tag_list() -> Int = 9

fn tag_map() -> Int = 10

fn tag_record() -> Int = 11

fn tag_ctor() -> Int = 12

fn tag_array() -> Int = 14
