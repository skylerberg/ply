pub type OwnershipSignature = { params: List<ParamOwnership>, result: ResultOwnership }

pub type OwnershipReasons = { params: List<Option<Span>>, result: Option<Span> }

pub type InferredOwnership = { signature: OwnershipSignature, reason: OwnershipReasons }

pub type InferenceTarget = {
  definition: RootName,
  f: Fn,
  group: List<RootName>,
  borrowed: List<Int>,
  whole: Fn,
}

pub fn all_owned(arity: Int) -> OwnershipSignature =
  { params: range(0, arity).map(|_: Int| OwnedParam), result: OwnedResult }

pub fn inference_targets_of(
  declared: Map<RootName, List<Int>>,
  forms: List<Fn>,
) -> List<InferenceTarget> =
  forms.fold([], |acc: List<InferenceTarget>, f: Fn|
    match signature_name(f.key) { Some(_) -> acc.concat(targets_of(declared, f)), None -> acc })

pub fn declared_borrows(
  into: Map<RootName, List<Int>>,
  module: Bytes,
  here: List<Definition>,
) -> Map<RootName, List<Int>> =
  here.fold(into, |m: Map<RootName, List<Int>>, d: Definition|
    if d.borrowed.len() == 0 { m }
    else { m.insert(root_name(Named(qualify(module, d.name))), d.borrowed) })

pub fn group_signatures(
  group: List<InferenceTarget>,
  published: Map<RootName, OwnershipSignature>,
) -> List<InferredOwnership> / {abort.raise} = {
  let plain = inferred_from(group, published, group.map(|_: InferenceTarget| Map::new()));
  let borrowing = range(0, group.len()).fold(Map::new(), |m: Map<RootName, Bool>, k: Int|
    match ((group.at(k), plain.at(k))) {
      (Some(l), Some(x)) -> if borrows_counted(l, x.signature) && may_reuse(l.whole) {
        m.insert(root_name(l.whole.key), true)
      } else { m },
      _ -> m,
    });
  if borrowing.len() == 0 { plain } else {
    let placed = borrowing.fold(
      Map::new(),
      |m: Map<RootName, Map<Int, Span>>, name: RootName, _: Bool|
        match group.find(|l: InferenceTarget| root_name(l.whole.key) == name) {
          Some(l) -> m.insert(name, reused_params(l.whole)),
          None -> m,
        },
    );
    let resets = group.map(|l: InferenceTarget|
      match placed.get(root_name(l.whole.key)) {
        Some(r) -> by_place(r, l.f.params),
        None -> Map::new(),
      });
    if resets.all(|r: Map<Int, Span>| r.len() == 0) { plain }
    else { inferred_from(group, published, resets) }
  }
}

pub fn reset_params(l: InferenceTarget) -> Map<Int, Span> = by_place(reused_params(l.whole), l.f.params)

fn inferred_from(
  group: List<InferenceTarget>,
  published: Map<RootName, OwnershipSignature>,
  resets: List<Map<Int, Span>>,
) -> List<InferredOwnership> / {abort.raise} =
  iterate(
    range(0, group.len()).fold([], |acc: List<InferredOwnership>, k: Int|
      match group.at(k) {
        Some(l) ->
          acc.push(first_guess(l, match resets.at(k) { Some(r) -> r, None -> Map::new() })),
        None -> acc,
      }),
    group.fold(2, |n: Int, m: InferenceTarget| n + 3 * m.f.params.len() + 2),
    |cur: List<InferredOwnership>| {
      let next = round(group, published, cur);
      if signatures_of(next) == signatures_of(cur) { Stop(next) } else { Continue(next) }
    },
  )

fn borrows_counted(l: InferenceTarget, h: OwnershipSignature) -> Bool =
  range(0, l.f.params.len()).any(|k: Int|
    (match l.f.params.at(k) { Some(p) -> is_refcounted(p.representation), None -> false })
      && h.params.at(k) == Some(BorrowedParam))

pub type InferenceResult = {
  handed: Map<RootName, OwnershipSignature>,
  groups: Map<RootName, List<RootKey>>,
}

pub fn infer_signatures(
  lendings: List<InferenceTarget>,
  given: Map<RootName, OwnershipSignature>,
  declared: Map<RootName, List<Int>>,
) -> InferenceResult / {abort.raise} = {
  let published = with_declared_borrows(given, declared, lendings);
  let at = range(0, lendings.len()).fold(Map::new(), |m: Map<RootName, Int>, k: Int|
    match lendings.at(k) { Some(l) -> m.insert(l.definition, k), None -> m });
  let out = lendings.map(|l: InferenceTarget|
    called(l).fold([], |acc: List<Int>, d: RootName|
      match at.get(d) { Some(k) -> acc.push(k), None -> acc }));
  let calls = graph::of(lendings.len(), |k: Int| match out.at(k) { Some(xs) -> xs, None -> [] });
  graph::components(calls).fold(
    { handed: published, groups: Map::new() },
    |done: InferenceResult, comp: List<Int>| {
      let group = comp.fold([], |g: List<InferenceTarget>, k: Int|
        match lendings.at(k) { Some(l) -> g.push(l), None -> g });
      let definitions = group.map(|l: InferenceTarget| l.f.key);
      let hs = signatures_of(group_signatures(group, done.handed));
      range(0, group.len()).fold(done, |s: InferenceResult, k: Int|
        match group.at(k) {
          Some(l) -> match hs.at(k) {
            Some(h) ->
              {
                handed: s.handed.insert(l.definition, h),
                groups: s.groups.insert(l.definition, definitions),
              },
            None -> s,
          },
          None -> s,
        })
    },
  )
}

fn with_declared_borrows(
  published: Map<RootName, OwnershipSignature>,
  declared: Map<RootName, List<Int>>,
  lendings: List<InferenceTarget>,
) -> Map<RootName, OwnershipSignature> =
  lendings.fold(published, |look: Map<RootName, OwnershipSignature>, l: InferenceTarget| {
    let generics = generics_of(l.f);
    vals_folded(l.f.body, look, |m: Map<RootName, OwnershipSignature>, v: Rvalue|
      match v {
        Call(c) -> match callee_definition(generics, c.callee) {
          Some(d) -> if m.contains(d) { m } else {
            match declared.get(d) {
              Some(borrowed) -> {
                let n = borrowed.fold(0, |most: Int, k: Int|
                  if k + 1 > most { k + 1 } else { most });
                m.insert(d, {
                  params: range(0, n).map(|k: Int|
                    if borrowed.contains(k) { BorrowedParam } else { OwnedParam }),
                  result: OwnedResult,
                })
              },
              None -> m,
            }
          },
          None -> m,
        },
        _ -> m,
      })
  })

pub fn ownership_text(h: OwnershipSignature) -> Bytes =
  Bytes::concat_all([
    b"[",
    Bytes::join(
      h.params.map(|p: ParamOwnership|
        match p { BorrowedParam -> b"borrowed", OwnedParam -> b"given" }),
      b", ",
    ),
    b"] ",
    match h.result {
      OwnedResult -> b"owned",
      BorrowedResult(from) ->
        Bytes::concat_all([
          b"borrowed(",
          Bytes::join(
            from.map(|x: { param: Int, whole: Bool }|
              if x.whole { ascii_of_int(x.param) } else { ascii_of_int(x.param).concat(b" part") }),
            b", ",
          ),
          b")",
        ]),
    },
  ])

pub fn with_conventions(f: Fn, handed: Map<RootName, OwnershipSignature>) -> Fn / {abort.raise} = {
  let own = |k: RootKey, c: Convention|
    match key_definition(k) {
      Some(d) -> match handed.get(d) { Some(h) -> convention_for(c, h, root_text(d)), None -> c },
      None -> match k {
        Generated(x, _) ->
          convention_for(c, generated_signature(x.op, c.params.len()), root_text(root_name(k))),
        _ -> c,
      },
    };
  let called = calls_with_conventions(f, generics_of(f), handed);
  {
    ..called,
    convention: if f.members.len() == 0 { own(f.key, f.convention) } else { f.convention },
    members: f.members.map(|m: Member| { ..m, convention: own(m.key, m.convention) }),
  }
}

fn key_definition(k: RootKey) -> Option<RootName> = signature_name(unspecialised(k))

fn signature_name(k: RootKey) -> Option<RootName> =
  match k {
    Specialisation(_, _) -> None,
    Generated(_, _) -> None,
    EntryPoint(_) -> None,
    _ -> Some(root_name(k)),
  }

fn convention_for(c: Convention, h: OwnershipSignature, what: Bytes) -> Convention / {abort.raise} =
  if h.params.len() > c.params.len() {
    panic(
      String::of_bytes_lossy(
        Bytes::concat_all([
          b"a handing of ",
          ascii_of_int(h.params.len()),
          b" parameters for a convention of ",
          ascii_of_int(c.params.len()),
          b": ",
          what,
        ]),
      ),
    )
  } else {
    {
      ..with_ownerships(c, h.params),
      returned: match h.result {
        OwnedResult -> OwnedResult,
        BorrowedResult(from) -> if !is_refcounted(c.result) { OwnedResult } else {
          BorrowedResult(
            from.filter(|x: { param: Int, whole: Bool }|
              match param_rep(c, x.param) { Some(r) -> is_refcounted(r), None -> false }),
          )
        },
      },
    }
  }

fn calls_with_conventions(
  f: Fn,
  generics: List<RootName>,
  handed: Map<RootName, OwnershipSignature>,
) -> Fn / {abort.raise} =
  {
    ..f,
    body: block_with_conventions(root_text(root_name(f.key)), generics, handed, f.body),
    lambdas: f.lambdas.map(|l: Lambda|
      match l {
        Closure(c) -> Closure({ ..c, body: calls_with_conventions(c.body, generics, handed) }),
      }),
  }

fn generics_of(f: Fn) -> List<RootName> = f.links.generics.map(|g: GenericCall| root_name(g.callee))

fn block_with_conventions(
  within: Bytes,
  generics: List<RootName>,
  handed: Map<RootName, OwnershipSignature>,
  b: Block,
) -> Block / {abort.raise} =
  b.map(|i: Inst|
    match i {
      Let(l) -> Let({ ..l, value: value_with_conventions(within, generics, handed, l.value) }),
      Do(d) -> Do({ ..d, value: value_with_conventions(within, generics, handed, d.value) }),
      If(x) ->
        If({
          ..x,
          then: block_with_conventions(within, generics, handed, x.then),
          otherwise: block_with_conventions(within, generics, handed, x.otherwise),
        }),
      Case(c) ->
        Case({
          ..c,
          arms: c.arms.map(|a: { when: Int, body: Block }|
            { when: a.when, body: block_with_conventions(within, generics, handed, a.body) }),
          rest: block_with_conventions(within, generics, handed, c.rest),
        }),
      Match(m) ->
        Match({
          arms: m.arms.map(|a: Block| block_with_conventions(within, generics, handed, a)),
          rest: block_with_conventions(within, generics, handed, m.rest),
        }),
      Loop(l) -> Loop({ ..l, body: block_with_conventions(within, generics, handed, l.body) }),
      Handle(h) -> Handle({ ..h, body: block_with_conventions(within, generics, handed, h.body) }),
      CleanupScope(Some(xs)) -> CleanupScope(Some(cleanups_with_conventions(generics, handed, xs))),
      Fail(x) -> Fail({ ..x, resource: cleanups_with_conventions(generics, handed, x.resource) }),
      _ -> i,
    })

fn cleanups_with_conventions(
  generics: List<RootName>,
  handed: Map<RootName, OwnershipSignature>,
  xs: List<Unwinding>,
) -> List<Unwinding> / {abort.raise} =
  xs.map(|x: Unwinding|
    {
      ..x,
      convention: convention_for(
        x.convention,
        signature_at(handed, generics, Root(x.callee), 1),
        root_text(root_name(x.callee)),
      ),
    })

fn value_with_conventions(
  within: Bytes,
  generics: List<RootName>,
  handed: Map<RootName, OwnershipSignature>,
  v: Rvalue,
) -> Rvalue / {abort.raise} =
  match v {
    Call(c) ->
      Call({
        ..c,
        convention: convention_for(
          c.convention,
          signature_at(handed, generics, c.callee, c.args.len()),
          Bytes::concat_all([
            match c.callee {
              Root(k) -> root_text(root_name(k)),
              Generic(n) -> match generics.at(n) {
                Some(d) ->
                  Bytes::concat_all([b"generic call ", ascii_of_int(n), b" of ", root_text(d)]),
                None -> b"generic call ".concat(ascii_of_int(n)),
              },
            },
            b" in ",
            within,
          ]),
        ),
      }),
    _ -> v,
  }

fn targets_of(declared: Map<RootName, List<Int>>, f: Fn) -> List<InferenceTarget> = {
  let borrowing = |g: Fn, group: List<RootName>| {
    let name = root_name(g.key);
    {
      definition: name,
      f: g,
      group: group,
      borrowed: match declared.get(name) { Some(ps) -> ps, None -> [] },
      whole: f,
    }
  };
  if f.members.len() == 0 { [borrowing(f, [])] } else {
    let names = f.members.map(|m: Member| root_name(m.key));
    range(0, f.members.len()).fold([], |acc: List<InferenceTarget>, i: Int|
      match f.members.at(i) {
        Some(m) ->
          acc.push(
            borrowing(
              {
                ..f,
                key: m.key,
                params: m.params,
                convention: m.convention,
                body: arm_of(f.body, i),
                base: m.base,
                members: [],
              },
              names,
            ),
          ),
        None -> acc,
      })
  }
}

fn arm_of(b: Block, i: Int) -> Block =
  match b {
    [Case(c)] ->
      c.arms.fold([], |body: Block, a: { when: Int, body: Block }|
        if a.when == i { a.body } else { body }),
    _ -> [],
  }

fn by_place(resets: Map<Int, Span>, params: List<Var>) -> Map<Int, Span> =
  range(0, params.len()).fold(Map::new(), |m: Map<Int, Span>, k: Int|
    match params.at(k) {
      Some(p) -> match resets.get(p.id) { Some(at) -> m.insert(k, at), None -> m },
      None -> m,
    })

fn reused_params(f: Fn) -> Map<Int, Span> = {
  let giving = |c: Convention|
    { ..c, params: c.params.map(|p: ParamTaking| { ..p, handed: OwnedParam }) };
  let counted_form = insert_reference_counts({
    ..f,
    convention: giving(f.convention),
    members: f.members.map(|m: Member| { ..m, convention: giving(m.convention) }),
  });
  let params = f.members.fold(f.params, |ps: List<Var>, m: Member| ps.concat(m.params));
  collect_memory_reuse(
    {
      held: params.fold(Map::new(), |h: Map<Int, List<Int>>, p: Var| h.insert(p.id, [p.id])),
      tokens: Map::new(),
      at: Map::new(),
    },
    counted_form.body,
  ).at
}

type Reuse = { held: Map<Int, List<Int>>, tokens: Map<Int, List<Int>>, at: Map<Int, Span> }

fn collect_memory_reuse(r: Reuse, b: Block) -> Reuse =
  b.fold(r, |acc: Reuse, i: Inst|
    match i {
      Let(l) -> {
        let from = value_sources(acc, l.value);
        {
          ..acc,
          held: if from.len() == 0 { acc.held } else { acc.held.insert(l.var.id, from) },
          at: match l.value {
            Allocate(m) -> match m.reuse {
              Some(t) ->
                (match acc.tokens.get(t.id) { Some(ps) -> ps, None -> [] }).fold(
                  acc.at,
                  |a: Map<Int, Span>, p: Int| if a.contains(p) { a } else { a.insert(p, l.at) },
                ),
              None -> acc.at,
            },
            _ -> acc.at,
          },
        }
      },
      Assign(x) ->
        {
          ..acc,
          held: acc.held.insert(x.var.id, joined(var_sources(acc, x.var), arg_sources(acc, x.arg))),
        },
      Destructure(o) ->
        {
          ..acc,
          held: o.words.fold(acc.held, |h: Map<Int, List<Int>>, w: Var|
            h.insert(w.id, var_sources(acc, o.of))),
        },
      Reset(x) -> { ..acc, tokens: acc.tokens.insert(x.token.id, var_sources(acc, x.of)) },
      If(x) -> collect_memory_reuse(collect_memory_reuse(acc, x.then), x.otherwise),
      Case(c) ->
        c.arms.fold(collect_memory_reuse(acc, c.rest), |a: Reuse, arm: { when: Int, body: Block }|
          collect_memory_reuse(a, arm.body)),
      Match(m) -> m.arms.fold(collect_memory_reuse(acc, m.rest), collect_memory_reuse),
      Loop(l) -> collect_memory_reuse(acc, l.body),
      Handle(h) -> collect_memory_reuse(acc, h.body),
      _ -> acc,
    })

fn value_sources(r: Reuse, value: Rvalue) -> List<Int> =
  match value {
    Take(t) -> var_sources(r, t.of),
    Convert(p) -> if allocates(operand_representation(p.arg), p.to) { [] }
    else { arg_sources(r, p.arg) },
    Aggregate(g) -> g.parts.fold([], |ps: List<Int>, a: Arg| joined(ps, arg_sources(r, a))),
    Update(u) ->
      u.sets.fold(var_sources(r, u.of), |ps: List<Int>, s: FieldWrite| joined(ps, arg_sources(r, s.arg))),
    _ -> match provenance(value) {
      BorrowSources(xs) -> xs.fold([], |ps: List<Int>, x: Var| joined(ps, var_sources(r, x))),
      _ -> [],
    },
  }

fn var_sources(r: Reuse, v: Var) -> List<Int> = match r.held.get(v.id) { Some(ps) -> ps, None -> [] }

fn arg_sources(r: Reuse, a: Arg) -> List<Int> =
  match operand_var(a) { Some(v) -> var_sources(r, v), None -> [] }

fn joined(a: List<Int>, b: List<Int>) -> List<Int> =
  b.fold(a, |acc: List<Int>, x: Int| if acc.contains(x) { acc } else { acc.push(x) })

type Origin = { sources: Map<Int, Bool>, fresh: Bool }

type Use = { does: Action, at: Span }

type Action =
  | Consumes(Origin)
  | PassesOn(Origin)
  | Jumps({ to: RootName, param: Int, of: Origin, counts: Bool })
  | Returns(Origin)
  | Sets({ join: Int, of: Origin })

type Walk = {
  origins: Map<Int, Origin>,
  captured: Map<Int, List<Origin>>,
  uses: List<Use>,
  at: Span,
}

type WalkContext = {
  signatures: Map<RootName, OwnershipSignature>,
  generics: List<RootName>,
  definition: RootName,
  group: List<RootName>,
  framed: Map<Int, Bool>,
}

type RequiredOwnedParam = { to: RootName, param: Int, at: Span }

type ConsumedParams = { own: Map<Int, Span>, jumped: List<RequiredOwnedParam> }

type MemberResult = {
  borrowing: InferenceTarget,
  cur: InferredOwnership,
  walk: Walk,
  gone: ConsumedParams,
}

fn first_guess(m: InferenceTarget, resets: Map<Int, Span>) -> InferredOwnership = {
  let n = declared_arity(m.f.params);
  let reset = |k: Int| !m.borrowed.contains(k) && resets.contains(k);
  {
    signature: {
      params: range(0, n).map(|k: Int| if reset(k) { OwnedParam } else { BorrowedParam }),
      result: if n > 0 && is_refcounted(m.f.convention.result) && !has_variables(m.f.result_type) {
        BorrowedResult([])
      } else { OwnedResult },
    },
    reason: {
      params: range(0, n).map(|k: Int| if reset(k) { resets.get(k) } else { None }),
      result: None,
    },
  }
}

fn signatures_of(xs: List<InferredOwnership>) -> List<OwnershipSignature> =
  xs.map(|x: InferredOwnership| x.signature)

fn round(
  group: List<InferenceTarget>,
  published: Map<RootName, OwnershipSignature>,
  cur: List<InferredOwnership>,
) -> List<InferredOwnership> = {
  let look = range(0, group.len()).fold(
    published,
    |m: Map<RootName, OwnershipSignature>, k: Int|
      match group.at(k) {
        Some(l) -> match cur.at(k) { Some(c) -> m.insert(l.definition, c.signature), None -> m },
        None -> m,
      },
  );
  let reps = group.fold(Map::new(), |m: Map<RootName, List<Representation>>, l: InferenceTarget|
    m.insert(l.definition, l.f.params.map(|p: Var| p.representation)));
  let found = range(0, group.len()).fold([], |acc: List<MemberResult>, k: Int|
    match group.at(k) {
      Some(l) -> match cur.at(k) {
        Some(c) -> {
          let w = member_walk(
            {
              signatures: look,
              generics: generics_of(l.f),
              definition: l.definition,
              group: l.group,
              framed: Map::new(),
            },
            l.f,
          );
          acc.push({
            borrowing: l,
            cur: c,
            walk: w,
            gone: consumed_in(c.signature, look, reps, l.f.params.map(|p: Var| p.representation), w),
          })
        },
        None -> acc,
      },
      None -> acc,
    });
  let jumps = found.fold([], |js: List<RequiredOwnedParam>, x: MemberResult| js.concat(x.gone.jumped));
  found.map(|x: MemberResult|
    resolved(
      x.borrowing,
      x.cur,
      x.walk,
      jumps.fold(x.gone.own, |g: Map<Int, Span>, j: RequiredOwnedParam|
        if j.to == x.borrowing.definition { first_at(g, j.param, j.at) } else { g }),
    ))
}

fn member_walk(s: WalkContext, f: Fn) -> Walk = stack_placed_walk(s, f).walk

fn stack_placed_walk(s: WalkContext, f: Fn) -> { walk: Walk, framed: Map<Int, Bool> } = {
  let start = range(0, f.params.len()).fold(
    { origins: Map::new(), captured: Map::new(), uses: [], at: dummy_span() },
    |w: Walk, k: Int|
      match f.params.at(k) {
        Some(p) -> defined(w, p, { sources: Map::new().insert(k, true), fresh: false }),
        None -> w,
      },
  );
  let candidates = stack_candidates(f);
  walk_dropping_escapes(s, start, f.body, candidates, candidates.len())
}

fn walk_dropping_escapes(
  s: WalkContext,
  start: Walk,
  b: Block,
  framed: Map<Int, Bool>,
  room: Int,
) -> { walk: Walk, framed: Map<Int, Bool> } = {
  let w = walk_block({ ..s, framed: framed }, start, b);
  let gone = escaping_blocks(w);
  let kept = framed.fold(Map::new(), |m: Map<Int, Bool>, id: Int, _: Bool|
    if gone.contains(id) { m } else { m.insert(id, true) });
  if kept.len() == framed.len() || room <= 0 { { walk: w, framed: framed } }
  else { walk_dropping_escapes(s, start, b, kept, room - 1) }
}

fn block_base(id: Int) -> Int = 0 - 1 - id

fn stack_candidates(f: Fn) -> Map<Int, Bool> =
  if stops_in(f.body) { Map::new() } else {
    vals_bound(f.body, Map::new(), |m: Map<Int, Bool>, v: Var, value: Rvalue|
      match value {
        Allocate(x) -> match x.made {
          ListAllocation(n) -> if n > 0 && n <= layout::container_layouts().trie.width
              && allocation_words(x.made, x.args) <= layout::frame_block_words()
              && !x.args.any(|a: Arg| match a { VarOperand(y) -> is_record_word(y), _ -> false }) {
            m.insert(v.id, true)
          } else { m },
          _ -> m,
        },
        _ -> m,
      })
  }

fn capped(b: Block, placed: Map<Int, Bool>) -> Map<Int, Bool> =
  vals_bound(
    b,
    { kept: placed, words: 0 },
    |acc: { kept: Map<Int, Bool>, words: Int }, v: Var, value: Rvalue|
      match value {
        Allocate(x) -> {
          let w = allocation_words(base_allocation(x.made), x.args);
          if base_allocation(x.made) != x.made { { ..acc, words: acc.words + w } }
          else if !placed.contains(v.id) { acc }
          else if acc.words + w > layout::frame_words() { { ..acc, kept: acc.kept.remove(v.id) } }
          else { { ..acc, words: acc.words + w } }
        },
        _ -> acc,
      },
  ).kept

fn allocation_words(fresh_origin: Allocation, args: List<Arg>) -> Int = {
  let widths = args.map(|a: Arg| max(1, value_words(operand_representation(a))));
  match fresh_origin {
    ListAllocation(n) -> 1 + layout::head_words(layout::list_head()) + n * widths.fold(1, max),
    _ -> 2 + widths.fold(0, |s: Int, w: Int| s + w),
  }
}

fn stops_in(b: Block) -> Bool = vals_folded(b, false, |acc: Bool, v: Rvalue| acc || may_suspend(v))

fn vals_bound<s>(b: Block, acc: s, on: (s, Var, Rvalue) -> s) -> s =
  b.fold(acc, |a: s, i: Inst|
    match i {
      Let(l) -> on(a, l.var, l.value),
      If(x) -> vals_bound(x.otherwise, vals_bound(x.then, a, on), on),
      Case(c) ->
        c.arms.fold(vals_bound(c.rest, a, on), |q: s, arm: { when: Int, body: Block }|
          vals_bound(arm.body, q, on)),
      Match(m) -> m.arms.fold(vals_bound(m.rest, a, on), |q: s, arm: Block| vals_bound(arm, q, on)),
      Loop(l) -> vals_bound(l.body, a, on),
      Handle(h) -> vals_bound(h.body, a, on),
      _ -> a,
    })

fn escaping_blocks(w: Walk) -> Map<Int, Bool> = {
  let blocks = |g: Map<Int, Bool>, o: Origin, part: Bool|
    o.sources.fold(g, |m: Map<Int, Bool>, k: Int, whole: Bool|
      if k < 0 && (whole || part) { m.insert(0 - 1 - k, true) } else { m });
  w.uses.fold(Map::new(), |g: Map<Int, Bool>, u: Use|
    match u.does {
      Consumes(o) -> blocks(g, o, false),
      PassesOn(o) -> blocks(g, o, false),
      Returns(o) -> blocks(g, o, false),
      Sets(x) -> blocks(g, x.of, false),
      Jumps(j) -> blocks(g, j.of, true),
    })
}

pub fn with_stack_blocks(f: Fn, look: Map<RootName, OwnershipSignature>) -> Fn = {
  let s = {
    signatures: look,
    generics: generics_of(f),
    definition: root_name(f.key),
    group: f.members.map(|m: Member| root_name(m.key)),
    framed: Map::new(),
  };
  {
    ..f,
    body: block_with_stack_blocks(f.body, capped(f.body, stack_placed_walk(s, f).framed)),
    lambdas: f.lambdas.map(|l: Lambda|
      match l { Closure(c) -> Closure({ ..c, body: with_stack_blocks(c.body, look) }) }),
  }
}

fn block_with_stack_blocks(b: Block, framed: Map<Int, Bool>) -> Block =
  b.map(|i: Inst|
    match i {
      Let(l) -> match l.value {
        Allocate(m) -> if framed.contains(l.var.id) {
          Let({ ..l, value: Allocate({ ..m, made: StackAllocation(m.made) }) })
        } else { i },
        _ -> i,
      },
      If(x) ->
        If({
          ..x,
          then: block_with_stack_blocks(x.then, framed),
          otherwise: block_with_stack_blocks(x.otherwise, framed),
        }),
      Case(c) ->
        Case({
          ..c,
          arms: c.arms.map(|a: { when: Int, body: Block }|
            { when: a.when, body: block_with_stack_blocks(a.body, framed) }),
          rest: block_with_stack_blocks(c.rest, framed),
        }),
      Match(m) ->
        Match({
          arms: m.arms.map(|a: Block| block_with_stack_blocks(a, framed)),
          rest: block_with_stack_blocks(m.rest, framed),
        }),
      Loop(l) -> Loop({ ..l, body: block_with_stack_blocks(l.body, framed) }),
      Handle(h) -> Handle({ ..h, body: block_with_stack_blocks(h.body, framed) }),
      _ -> i,
    })

fn consumed_in(
  h: OwnershipSignature,
  look: Map<RootName, OwnershipSignature>,
  reps: Map<RootName, List<Representation>>,
  own: List<Representation>,
  w: Walk,
) -> ConsumedParams =
  w.uses.fold({ own: Map::new(), jumped: [] }, |g: ConsumedParams, u: Use|
    match u.does {
      Consumes(o) -> { ..g, own: wholes(g.own, o, u.at) },
      PassesOn(o) -> { ..g, own: parts(g.own, o, u.at) },
      Jumps(j) -> {
        let borrowed_there = match look.get(j.to) {
          Some(t) -> t.params.at(j.param) == Some(BorrowedParam),
          None -> false,
        };
        let pointed = match reps.get(j.to) {
          Some(rs) -> match rs.at(j.param) { Some(r) -> passing(r) == ByReference, None -> false },
          None -> false,
        };
        let pointable = j.of.sources.len() > 0
          && j.of.sources.all(|k: Int, whole: Bool|
            whole && (match own.at(k) { Some(r) -> passing(r) == ByReference, None -> false }));
        if !borrowed_there { if j.counts { { ..g, own: wholes(g.own, j.of, u.at) } } else { g } }
        else if (j.counts
            && (j.of.fresh || j.of.sources.keys().any(|k: Int| h.params.at(k) == Some(OwnedParam))))
            || (pointed && !pointable) {
          { ..g, jumped: g.jumped.push({ to: j.to, param: j.param, at: u.at }) }
        } else { g }
      },
      Returns(o) -> if h.result == OwnedResult { { ..g, own: wholes(g.own, o, u.at) } } else { g },
      Sets(x) -> if owned_join(w, x.join) { { ..g, own: wholes(g.own, x.of, u.at) } } else { g },
    })

fn resolved(
  m: InferenceTarget,
  cur: InferredOwnership,
  w: Walk,
  gone: Map<Int, Span>,
) -> InferredOwnership = {
  let n = declared_arity(m.f.params);
  let given = |k: Int|
    !m.borrowed.contains(k) && (cur.signature.params.at(k) == Some(OwnedParam) || gone.contains(k));
  let params = range(0, n).map(|k: Int| if given(k) { OwnedParam } else { BorrowedParam });
  let result = if cur.signature.result == OwnedResult {
    { returned: OwnedResult, at: cur.reason.result }
  } else { result_ownership_of(w.uses, params) };
  {
    signature: { params: params, result: result.returned },
    reason: {
      params: range(0, n).map(|k: Int|
        if !given(k) { None }
        else { match cur.reason.params.at(k) { Some(Some(at)) -> Some(at), _ -> gone.get(k) } }),
      result: result.at,
    },
  }
}

fn result_ownership_of(
  uses: List<Use>,
  params: List<ParamOwnership>,
) -> { returned: ResultOwnership, at: Option<Span> } =
  match uses.fold(Ok(Map::new()), |acc: Result<Map<Int, Bool>, Span>, u: Use|
      match acc {
        Err(_) -> acc,
        Ok(m) -> match u.does {
          Returns(o) -> if o.fresh
              || o.sources.keys().any(|k: Int| params.at(k) != Some(BorrowedParam)) { Err(u.at) }
          else { Ok(bases_with(m, o)) },
          _ -> acc,
        },
      }) {
    Err(at) -> { returned: OwnedResult, at: Some(at) },
    Ok(m) ->
      {
        returned: BorrowedResult(
          m.fold([], |acc: List<{ param: Int, whole: Bool }>, k: Int, whole: Bool|
            acc.push({ param: k, whole: whole })),
        ),
        at: None,
      },
  }

fn owned_join(w: Walk, j: Int) -> Bool = match w.origins.get(j) { Some(o) -> o.fresh, None -> true }

fn wholes(g: Map<Int, Span>, o: Origin, at: Span) -> Map<Int, Span> =
  o.sources.fold(g, |acc: Map<Int, Span>, k: Int, whole: Bool|
    if whole { first_at(acc, k, at) } else { acc })

fn parts(g: Map<Int, Span>, o: Origin, at: Span) -> Map<Int, Span> =
  o.sources.fold(g, |acc: Map<Int, Span>, k: Int, _: Bool| first_at(acc, k, at))

fn first_at(g: Map<Int, Span>, k: Int, at: Span) -> Map<Int, Span> =
  if g.contains(k) { g } else { g.insert(k, at) }

fn no_origin() -> Origin = { sources: Map::new(), fresh: false }

fn fresh_origin() -> Origin = { sources: Map::new(), fresh: true }

fn bases_with(m: Map<Int, Bool>, o: Origin) -> Map<Int, Bool> =
  o.sources.fold(m, |acc: Map<Int, Bool>, k: Int, whole: Bool|
    acc.insert(k, whole || acc.get(k) == Some(true)))

fn union(a: Origin, b: Origin) -> Origin =
  { sources: bases_with(a.sources, b), fresh: a.fresh || b.fresh }

fn read_out(o: Origin) -> Origin =
  {
    sources: o.sources.fold(Map::new(), |m: Map<Int, Bool>, k: Int, _: Bool| m.insert(k, false)),
    fresh: o.fresh,
  }

fn borrowed_out(o: Origin) -> Origin =
  {
    sources: o.sources.fold(Map::new(), |m: Map<Int, Bool>, k: Int, whole: Bool|
      m.insert(k, k < 0 && whole)),
    fresh: o.fresh,
  }

fn origin_of(w: Walk, v: Var) -> Origin =
  match w.origins.get(v.id) {
    Some(o) -> o,
    None -> if is_refcounted(v.representation) { fresh_origin() } else { no_origin() },
  }

fn arg_origin(w: Walk, a: Arg) -> Origin =
  match a { VarOperand(v) -> origin_of(w, v), _ -> no_origin() }

fn defined(w: Walk, v: Var, o: Origin) -> Walk =
  if is_refcounted(v.representation) || passing(v.representation) == ByReference {
    { ..w, origins: w.origins.insert(v.id, o) }
  } else { w }

fn used(w: Walk, d: Action) -> Walk = { ..w, uses: w.uses.push({ does: d, at: w.at }) }

fn consumed(w: Walk, a: Arg) -> Walk =
  if is_refcounted(operand_representation(a)) { used(w, Consumes(arg_origin(w, a))) } else { w }

fn taken(w: Walk, ops: List<{ arg: Arg, takes: Bool }>) -> Walk =
  ops.fold(w, |acc: Walk, o: { arg: Arg, takes: Bool }|
    if o.takes { consumed(acc, o.arg) } else { acc })

fn passed_owned(w: Walk, a: Arg) -> Walk =
  if is_refcounted(operand_representation(a)) { used(w, PassesOn(arg_origin(w, a))) } else { w }

fn passed_owned_operands(w: Walk, ops: List<{ arg: Arg, takes: Bool }>) -> Walk =
  ops.fold(w, |acc: Walk, o: { arg: Arg, takes: Bool }|
    if o.takes { passed_owned(acc, o.arg) } else { acc })

fn jumped(w: Walk, to: RootName, args: List<Arg>) -> Walk =
  range(0, args.len()).fold(w, |a: Walk, k: Int|
    match args.at(k) {
      Some(x) ->
        used(
          a,
          Jumps({
            to: to,
            param: k,
            of: arg_origin(a, x),
            counts: is_refcounted(operand_representation(x)),
          }),
        ),
      None -> a,
    })

fn walk_block(s: WalkContext, w: Walk, b: Block) -> Walk =
  b.fold(w, |acc: Walk, i: Inst|
    match i {
      Let(l) -> {
        let v = walk_value(s, { ..acc, at: l.at }, l.value, Some(l.var));
        defined(v.walk, l.var, v.origin)
      },
      Do(d) -> walk_value(s, { ..acc, at: d.at }, d.value, None).walk,
      Declaration(v) -> defined(acc, v, no_origin()),
      Assign(x) -> {
        let o = match x.arg {
          VarOperand(_) -> arg_origin(acc, x.arg),
          _ -> if is_refcounted(operand_representation(x.arg)) { fresh_origin() }
          else { no_origin() },
        };
        let set = defined(acc, x.var, union(origin_of(acc, x.var), o));
        if is_refcounted(x.var.representation) { used(set, Sets({ join: x.var.id, of: o })) }
        else { set }
      },
      If(x) -> placed(walk_block(s, placed(walk_block(s, acc, x.then), acc.at), x.otherwise), acc.at),
      Case(c) ->
        placed(
          c.arms.fold(walk_block(s, acc, c.rest), |a: Walk, arm: { when: Int, body: Block }|
            walk_block(s, placed(a, acc.at), arm.body)),
          acc.at,
        ),
      Match(m) ->
        placed(
          m.arms.fold(walk_block(s, acc, m.rest), |a: Walk, arm: Block|
            walk_block(s, placed(a, acc.at), arm)),
          acc.at,
        ),
      Loop(l) -> {
        let looping = l.state.fold(
          carried_inits(l.state).fold(acc, consumed),
          |a: Walk, c: LoopVariable| defined(a, c.var, fresh_origin()),
        );
        defined(placed(walk_block(s, looping, l.body), acc.at), l.result, fresh_origin())
      },
      Next(args) -> args.fold(acc, consumed),
      Done(a) -> consumed(acc, a),
      Return(a) -> if is_refcounted(operand_representation(a)) {
        used(acc, Returns(arg_origin(acc, a)))
      } else { acc },
      Restart(args) -> jumped(acc, s.definition, args),
      Jump(e) -> match s.group.at(e.member) {
        Some(to) -> jumped(acc, to, e.args),
        None -> e.args.fold(acc, consumed),
      },
      Handle(h) ->
        defined(
          placed(walk_block(s, taken(acc, by_signature(h.args, h.uses)), h.body), acc.at),
          h.result,
          fresh_origin(),
        ),
      _ -> acc,
    })

fn placed(w: Walk, at: Span) -> Walk = { ..w, at: at }

fn walk_value(
  s: WalkContext,
  w: Walk,
  value: Rvalue,
  bound: Option<Var>,
) -> { walk: Walk, origin: Origin } = {
  let v = walk_value_origin(s, w, value, bound);
  { ..v, walk: borrowed_from_blocks(blocks_taken(v.walk, w, value), value, bound, v.origin) }
}

fn borrowed_from_blocks(w: Walk, value: Rvalue, bound: Option<Var>, o: Origin) -> Walk = {
  let borrows = match value { Allocate(_) -> false, _ -> true };
  let counts = match bound { Some(v) -> is_refcounted(v.representation), None -> false };
  let blocks = o.sources.fold(Map::new(), |m: Map<Int, Bool>, k: Int, _: Bool|
    if k < 0 { m.insert(k, true) } else { m });
  if !borrows || !counts || blocks.len() == 0 { w }
  else { used(w, Consumes({ sources: blocks, fresh: false })) }
}

fn blocks_taken(after: Walk, before: Walk, value: Rvalue) -> Walk =
  match value {
    Call(_) -> after,
    Apply(_) -> after,
    Allocate(_) -> after,
    _ ->
      operands(value).fold(after, |a: Walk, o: { arg: Arg, takes: Bool }|
        if !o.takes { a } else {
          let blocks = arg_origin(before, o.arg).sources.fold(
            Map::new(),
            |m: Map<Int, Bool>, k: Int, whole: Bool|
              if k < 0 && whole { m.insert(k, true) } else { m },
          );
          if blocks.len() == 0 { a } else { used(a, Consumes({ sources: blocks, fresh: false })) }
        }),
  }

fn walk_value_origin(
  s: WalkContext,
  w: Walk,
  value: Rvalue,
  bound: Option<Var>,
) -> { walk: Walk, origin: Origin } =
  match value {
    Primitive(_) -> { walk: w, origin: fresh_origin() },
    Literal(_) -> { walk: w, origin: fresh_origin() },
    Static(_) -> { walk: w, origin: no_origin() },
    Tag(_) -> { walk: w, origin: no_origin() },
    Allocate(m) -> {
      let framed = base_allocation(m.made) != m.made
        || (match bound { Some(to) -> s.framed.contains(to.id), None -> false });
      let stored = if framed {
        m.args.fold(w, |a: Walk, x: Arg| {
          let o = arg_origin(w, x);
          let blocks = o.sources.fold(Map::new(), |b: Map<Int, Bool>, k: Int, whole: Bool|
            if k < 0 { b.insert(k, whole) } else { b });
          if blocks.len() == 0 { a } else { used(a, Consumes({ sources: blocks, fresh: false })) }
        })
      } else { taken(w, operands(value)) };
      {
        walk: match bound {
          Some(to) -> match m.made {
            ClosureAllocation(_) ->
              {
                ..stored,
                captured: stored.captured.insert(to.id, m.args.map(|x: Arg| arg_origin(w, x))),
              },
            _ -> stored,
          },
          None -> stored,
        },
        origin: match bound {
          Some(to) -> if s.framed.contains(to.id) {
            { sources: Map::new().insert(block_base(to.id), true), fresh: false }
          } else { fresh_origin() },
          None -> fresh_origin(),
        },
      }
    },
    Get(g) ->
      {
        walk: w,
        origin: match g.path {
          LeafPath(_) -> origin_of(w, g.of),
          CapturePath(k) -> match w.captured.get(g.of.id) {
            Some(cs) -> match cs.at(k) { Some(o) -> o, None -> read_out(origin_of(w, g.of)) },
            None -> read_out(origin_of(w, g.of)),
          },
          _ -> match bound {
            Some(y) -> if payload_of(value, y) != None { origin_of(w, g.of) }
            else { read_out(origin_of(w, g.of)) },
            None -> read_out(origin_of(w, g.of)),
          },
        },
      },
    Take(t) -> { walk: w, origin: read_out(origin_of(w, t.of)) },
    Convert(p) -> match shared_count_var(bound, value) {
      Some(x) -> { walk: w, origin: origin_of(w, x) },
      None -> if is_unboxing(p.arg, p.to) { { walk: w, origin: read_out(arg_origin(w, p.arg)) } }
      else if operands(value).any(|o: { arg: Arg, takes: Bool }| o.takes) {
        { walk: consumed(w, p.arg), origin: fresh_origin() }
      } else { { walk: w, origin: no_origin() } },
    },
    Aggregate(g) -> match shared_count_var(bound, value) {
      Some(x) -> { walk: w, origin: origin_of(w, x) },
      None ->
        {
          walk: taken(w, operands(value)),
          origin: if g.parts.any(|a: Arg| is_refcounted(operand_representation(a))) {
            fresh_origin()
          } else { no_origin() },
        },
    },
    Call(c) -> {
      let h = signature_at(s.signatures, s.generics, c.callee, c.args.len());
      {
        walk: range(0, c.args.len()).fold(w, |a: Walk, k: Int|
          if h.params.at(k) == Some(BorrowedParam) { a }
          else { match c.args.at(k) { Some(x) -> passed_owned(a, x), None -> a } }),
        origin: match h.result {
          OwnedResult -> fresh_origin(),
          BorrowedResult(from) ->
            from.fold(no_origin(), |o: Origin, x: { param: Int, whole: Bool }|
              match c.args.at(x.param) {
                Some(a) ->
                  union(o, if x.whole { arg_origin(w, a) } else { borrowed_out(arg_origin(w, a)) }),
                None -> o,
              }),
        },
      }
    },
    Update(_) -> { walk: taken(w, operands(value)), origin: fresh_origin() },
    Apply(_) -> { walk: passed_owned_operands(w, operands(value).drop(1)), origin: fresh_origin() },
    Native(n) -> { walk: passed_owned_operands(w, operands(value)), origin: result_origin(w, n.args, n.uses) },
    Op(o) -> { walk: passed_owned_operands(w, operands(value)), origin: result_origin(w, o.args, o.uses) },
    IfUnique(x) -> { walk: taken(w, operands(value)), origin: arg_origin(w, VarOperand(x)) },
    WalkLoop(x) ->
      {
        walk: taken(w, operands(value)),
        origin: if x.op == Share { no_origin() } else { fresh_origin() },
      },
    OperandsOnly(_) -> { walk: taken(w, operands(value)), origin: fresh_origin() },
  }

fn shared_count_var(bound: Option<Var>, value: Rvalue) -> Option<Var> =
  match bound { Some(y) -> count_shared_with(y, value), None -> None }

fn result_origin(w: Walk, args: List<Arg>, uses: OperationSignature) -> Origin =
  if uses.owned { fresh_origin() }
  else { match args.at(0) { Some(a) -> borrowed_out(arg_origin(w, a)), None -> no_origin() } }

fn signature_at(
  look: Map<RootName, OwnershipSignature>,
  generics: List<RootName>,
  c: Callee,
  arity: Int,
) -> OwnershipSignature =
  match callee_definition(generics, c) {
    Some(d) -> match look.get(d) { Some(h) -> h, None -> all_owned(arity) },
    None -> match c {
      Root(k) -> match k {
        Generated(x, _) -> generated_signature(x.op, arity),
        _ -> all_owned(arity),
      },
      Generic(_) -> all_owned(arity),
    },
  }

pub fn generated_signature(op: TypeOp, arity: Int) -> OwnershipSignature =
  {
    params: range(0, arity).map(|k: Int| if reads(op, k) { BorrowedParam } else { OwnedParam }),
    result: OwnedResult,
  }

fn reads(op: TypeOp, k: Int) -> Bool =
  match op {
    Equal -> true,
    Order -> true,
    NumericFunction(_) -> true,
    Reflect -> true,
    Show -> true,
    Digest -> true,
    Lower -> true,
    Share -> true,
    Keep -> true,
    Dup -> true,
    ReleaseResource -> true,
    ContainerWalk(c) -> container_reads_argument(c, k),
    OnCase(c) -> reads(c.op, k),
    OnWordForm(w) -> reads(w, k),
    Unboxed(h) -> reads(h, k),
    _ -> false,
  }

fn callee_definition(generics: List<RootName>, c: Callee) -> Option<RootName> =
  match c { Root(k) -> key_definition(k), Generic(i) -> generics.at(i) }

fn called(l: InferenceTarget) -> List<RootName> = calls_in(generics_of(l.f), l.group, l.f.body)

fn calls_in(generics: List<RootName>, acc: List<RootName>, b: Block) -> List<RootName> =
  vals_folded(b, acc, |a: List<RootName>, v: Rvalue| call_named(generics, a, v))

fn vals_folded<s>(b: Block, acc: s, on: (s, Rvalue) -> s) -> s =
  b.fold(acc, |a: s, i: Inst|
    match i {
      Let(l) -> on(a, l.value),
      Do(d) -> on(a, d.value),
      If(x) -> vals_folded(x.otherwise, vals_folded(x.then, a, on), on),
      Case(c) ->
        c.arms.fold(vals_folded(c.rest, a, on), |n: s, arm: { when: Int, body: Block }|
          vals_folded(arm.body, n, on)),
      Match(m) ->
        m.arms.fold(vals_folded(m.rest, a, on), |n: s, arm: Block| vals_folded(arm, n, on)),
      Loop(l) -> vals_folded(l.body, a, on),
      Handle(h) -> vals_folded(h.body, a, on),
      _ -> a,
    })

fn assumed_in(
  f: Fn,
  generics: List<RootName>,
  handed: Map<RootName, OwnershipSignature>,
  outside: (RootName) -> Bool,
) -> List<PublishedSignature> = {
  let added = |a: List<PublishedSignature>, p: PublishedSignature|
    if a.any(|x: PublishedSignature| x.definition == p.definition) { a } else { a.push(p) };
  let own = vals_folded(f.body, [], |a: List<PublishedSignature>, v: Rvalue|
    match v {
      Call(c) -> match callee_definition(generics, c.callee) {
        Some(d) -> if !outside(d) { a }
        else { added(a, published_of(d, signature_at(handed, generics, c.callee, c.args.len()))) },
        None -> a,
      },
      _ -> a,
    });
  f.lambdas.fold(own, |a: List<PublishedSignature>, l: Lambda|
    match l { Closure(c) -> assumed_in(c.body, generics, handed, outside).fold(a, added) })
}

pub fn published_of(definition: RootName, h: OwnershipSignature) -> PublishedSignature =
  {
    definition: definition,
    borrowed: h.params.map(|p: ParamOwnership| p == BorrowedParam),
    borrowed_from: match h.result { OwnedResult -> None, BorrowedResult(from) -> Some(from) },
  }

pub fn signatures_from(ps: List<PublishedSignature>) -> Map<RootName, OwnershipSignature> =
  ps.fold(Map::new(), |m: Map<RootName, OwnershipSignature>, p: PublishedSignature|
    m.insert(p.definition, {
      params: p.borrowed.map(|l: Bool| if l { BorrowedParam } else { OwnedParam }),
      result: match p.borrowed_from { None -> OwnedResult, Some(from) -> BorrowedResult(from) },
    }))

pub type InferredFn = {
  form: Fn,
  handings: List<PublishedSignature>,
  assumed: List<PublishedSignature>,
  group: List<RootKey>,
}

pub fn inferred_fn(f: Fn, s: InferenceResult) -> InferredFn / {abort.raise} = {
  let borrowed = with_stack_blocks(with_conventions(f, s.handed), s.handed);
  let own = if borrowed.members.len() == 0 {
    [{ key: borrowed.key, convention: borrowed.convention }]
  } else { borrowed.members.map(|m: Member| { key: m.key, convention: m.convention }) };
  let definitions = own.fold(
    [],
    |acc: List<RootKey>, o: { key: RootKey, convention: Convention }|
      match signature_name(o.key) { Some(_) -> acc.push(o.key), None -> acc },
  );
  let group = definitions.fold(definitions, |acc: List<RootKey>, d: RootKey|
    match s.groups.get(root_name(d)) {
      Some(g) ->
        g.fold(acc, |a: List<RootKey>, x: RootKey| if a.contains(x) { a } else { a.push(x) }),
      None -> acc,
    });
  let inside = group.map(root_name);
  let specialised = own.fold(
    [],
    |acc: List<PublishedSignature>, o: { key: RootKey, convention: Convention }|
      match o.key {
        Specialisation(_, _) -> {
          let d = root_name(unspecialised(o.key));
          acc.push(
            published_of(d, match s.handed.get(d) {
              Some(h) -> h,
              None -> all_owned(o.convention.params.len()),
            }),
          )
        },
        _ -> acc,
      },
  );
  {
    form: borrowed,
    handings: definitions.fold([], |acc: List<PublishedSignature>, d: RootKey| {
      let n = root_name(d);
      match s.handed.get(n) { Some(h) -> acc.push(published_of(n, h)), None -> acc }
    }),
    assumed: assumed_in(borrowed, generics_of(borrowed), s.handed, |d: RootName|
      !inside.contains(d)).fold(
      specialised,
      |a: List<PublishedSignature>, p: PublishedSignature|
        if a.any(|x: PublishedSignature| x.definition == p.definition) { a } else { a.push(p) },
    ),
    group: if group.len() > definitions.len() { group } else { [] },
  }
}

fn call_named(generics: List<RootName>, a: List<RootName>, v: Rvalue) -> List<RootName> =
  match v {
    Call(c) -> match callee_definition(generics, c.callee) {
      Some(d) -> if a.contains(d) { a } else { a.push(d) },
      None -> a,
    },
    _ -> a,
  }

fn of_type(id: Int, ty: Bytes, rep: Representation) -> Var =
  { id: id, ty: NamedType({ name: ty, args: [] }), representation: rep }

fn string_var(id: Int) -> Var = of_type(id, b"String", AsWord)

fn tree(id: Int) -> Var = of_type(id, b"m.Tree", AsWord)

fn int(id: Int) -> Var = of_type(id, b"Int", AsInt)

fn bool_var(id: Int) -> Var = of_type(id, b"Bool", AsBool)

fn bind(v: Var, value: Rvalue) -> Inst = Let({ var: v, value: value, at: dummy_span(), unwind: [] })

fn owned_convention(params: List<Var>, result: Representation) -> Convention =
  {
    params: owned_params(params.map(|p: Var| p.representation)),
    result: result,
    destination_passing: false,
    returned: OwnedResult,
  }

fn definition_of(
  name: Bytes,
  params: List<Var>,
  result: Representation,
  body: Block,
) -> InferenceTarget = {
  let f = {
    key: Named(qualify(b"m", name)),
    kind: Metered,
    params: params,
    convention: owned_convention(params, result),
    result_type: NamedType({ name: b"T", args: [] }),
    body: body,
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  };
  { definition: of_m(name), f: f, group: [], borrowed: [], whole: f }
}

fn of_m(name: Bytes) -> RootName = root_name(Named(qualify(b"m", name)))

fn call_of(name: Bytes, args: List<Arg>) -> Rvalue =
  Call({
    callee: Root(Named(qualify(b"m", name))),
    args: args,
    convention: {
      params: owned_params(args.map(operand_representation)),
      result: AsWord,
      destination_passing: false,
      returned: OwnedResult,
    },
    suspends: false,
  })

fn resolved_with(
  group: List<InferenceTarget>,
  published: List<{ name: Bytes, signature: OwnershipSignature }>,
) -> List<OwnershipSignature> / {abort.raise} =
  signatures_of(
    group_signatures(
      group,
      published.fold(
        Map::new(),
        |m: Map<RootName, OwnershipSignature>, p: { name: Bytes, signature: OwnershipSignature }|
          m.insert(of_m(p.name), p.signature),
      ),
    ),
  )

fn infer_group_signatures(group: List<InferenceTarget>) -> List<OwnershipSignature> / {abort.raise} =
  resolved_with(group, [])

fn made_of(fresh_origin: Allocation, args: List<Arg>) -> Rvalue =
  Allocate({ made: fresh_origin, args: args, reuse: None })

test "a walk that only reads its parameters borrows both" {
  let a = string_var(0);
  let t = tree(1);
  let l = tree(2);
  let r = tree(3);
  let x = int(4);
  let y = int(5);
  let z = int(6);
  let walk = definition_of(b"walk", [a, t], AsInt, [
    Case({
      on: t,
      test: TagTest([b"m.Leaf", b"m.Node"]),
      arms: [
        {
          when: 1,
          body: [
            bind(l, Get({ of: t, path: ArgumentPath({ ctor: b"m.Node", at: 0 }) })),
            bind(r, Get({ of: t, path: ArgumentPath({ ctor: b"m.Node", at: 1 }) })),
            bind(x, call_of(b"walk", [VarOperand(a), VarOperand(l)])),
            bind(y, call_of(b"walk", [VarOperand(a), VarOperand(r)])),
            bind(z, Primitive({ op: b"add", on: AsInt, args: [VarOperand(x), VarOperand(y)] })),
            Return(VarOperand(z)),
          ],
        },
      ],
      rest: [Return(IntOperand(0))],
    }),
  ]);
  assert_eq(infer_group_signatures([walk]), [{ params: [BorrowedParam, BorrowedParam], result: OwnedResult }])
}

test "a parameter stored, updated in place, performed, given on, or captured by a closure that outlives the call is given" {
  let s = string_var(0);
  let r = string_var(1);
  let by = |value: Rvalue|
    infer_group_signatures([definition_of(b"f", [s], AsWord, [bind(r, value), Return(VarOperand(r))])]);
  let gives = [{ params: [OwnedParam], result: OwnedResult }];
  assert_eq(by(made_of(CaseAllocation({ case: 0, skip: 0, words: 1 }), [VarOperand(s)])), gives);
  assert_eq(
    by(
      Native({
        name: b"rt_push",
        args: [VarOperand(s), IntOperand(1)],
        uses: { takes: [true, false], owned: true, fails: true, suspends: false },
      }),
    ),
    gives,
  );
  assert_eq(
    by(
      Op({
        op: OfHandling(
          Perform({
            effect: b"m.log",
            op: b"put",
            index: 0,
            resource: b"",
            labelled: false,
            mode: 1,
            descriptor: b"ply_k_put",
          }),
        ),
        args: [VarOperand(s)],
        uses: { takes: [true], owned: true, fails: true, suspends: true },
      }),
    ),
    gives,
  );
  assert_eq(by(call_of(b"keep", [VarOperand(s)])), gives);
  assert_eq(
    by(made_of(ClosureAllocation({ nth: 0, captures: 1, params: 1 }), [VarOperand(s)])),
    gives,
  );
  assert_eq(
    resolved_with(
      [
        definition_of(b"f", [s], AsWord, [
          bind(r, call_of(b"look", [VarOperand(s)])),
          Return(VarOperand(r)),
        ]),
      ],
      [{ name: b"look", signature: { params: [BorrowedParam], result: OwnedResult } }],
    ),
    [{ params: [BorrowedParam], result: OwnedResult }],
  )
}

test "a handing says where the use is that first gave each parameter and made the result owned" {
  let s = string_var(0);
  let q = string_var(1);
  let r = string_var(2);
  let k = string_var(3);
  let at = |v: Var, value: Rvalue, from: Int, to: Int|
    Let({ var: v, value: value, at: span_between(from, to), unwind: [] });
  let got = group_signatures(
    [
      definition_of(b"f", [s, q], AsWord, [
        at(r, call_of(b"look", [VarOperand(q)]), 10, 14),
        at(k, made_of(ListAllocation(2), [VarOperand(s), VarOperand(r)]), 20, 25),
        Return(VarOperand(k)),
      ]),
    ],
    Map::new().insert(of_m(b"look"), { params: [BorrowedParam], result: OwnedResult }),
  );
  assert_eq(got.map(|x: InferredOwnership| x.signature), [
    { params: [OwnedParam, BorrowedParam], result: OwnedResult },
  ]);
  assert_eq(got.map(|x: InferredOwnership| x.reason), [
    { params: [Some(span_between(20, 25)), None], result: Some(span_between(20, 25)) },
  ])
}

test "a closure laid on this frame's stack only reads its captures, whatever its body does with them" {
  let s = string_var(0);
  let k = string_var(1);
  let r = int(2);
  let c = string_var(0);
  let x = int(1);
  let with_body = |result: Representation, body: Block| {
    let f = definition_of(b"f", [s], AsInt, [
      bind(
        k,
        made_of(StackAllocation(ClosureAllocation({ nth: 0, captures: 1, params: 1 })), [
          VarOperand(s),
        ]),
      ),
      bind(r, call_of(b"each", [VarOperand(k)])),
      Return(VarOperand(r)),
    ]);
    let lambda = {
      key: Named(b"m.f"),
      kind: Metered,
      params: [c, x],
      convention: owned_convention([c, x], result),
      result_type: NamedType({ name: b"T", args: [] }),
      body: body,
      lambdas: [],
      base: 0,
      members: [],
      links: no_links(),
      statics: [],
    };
    resolved_with(
      [
        {
          ..f,
          f: {
            ..f.f,
            lambdas: [
              Closure({
                body: lambda,
                captures: 1,
                at: dummy_span(),
                words: no_closure_evidence(),
              }),
            ],
          },
        },
      ],
      [{ name: b"each", signature: { params: [BorrowedParam], result: OwnedResult } }],
    )
  };
  assert_eq(with_body(AsInt, [Return(IntOperand(0))]), [
    { params: [BorrowedParam], result: OwnedResult },
  ]);
  assert_eq(with_body(AsWord, [Return(VarOperand(c))]), [
    { params: [BorrowedParam], result: OwnedResult },
  ])
}

test "a constructor made of the cells of the parameter a case matched gives it, as the ownership pass resets it" {
  let list = AsSum({
    layout: {
      classes: [layout::Pointer],
      cases: [
        { test: layout::WordIs({ at: 0, value: 0 }), payload: layout::Nullary },
        {
          test: layout::WordOutside({ at: 0, values: [0] }),
          payload: layout::Boxed({
            at: 0,
            stripped: false,
            skip: 0,
            layout: PlainWords([layout::Pointer, layout::Pointer]),
          }),
        },
      ],
    },
    cases: [b"m.Nil", b"m.Cons"],
  });
  let xs = of_type(0, b"m.L", list);
  let v = string_var(1);
  let t = of_type(2, b"m.L", list);
  let box = of_type(3, b"m.L", AsWord);
  let n = of_type(4, b"m.L", list);
  let rebuilt = |names: List<Bytes>|
    definition_of(b"cons", [xs, v], list, [
      Case({
        on: xs,
        test: TagTest(names),
        arms: [
          {
            when: 0,
            body: [
              bind(t, Get({ of: xs, path: CasePath({ case: 1, at: 1 }) })),
              bind(
                box,
                made_of(CaseAllocation({ case: 1, skip: 0, words: 2 }), [
                  VarOperand(v),
                  VarOperand(t),
                ]),
              ),
              bind(n, Aggregate({ parts: [IntOperand(1), VarOperand(box)] })),
              Return(VarOperand(n)),
            ],
          },
        ],
        rest: [Return(ZeroOperand(list))],
      }),
    ]);
  assert_eq(infer_group_signatures([rebuilt([b"m.Cons", b"m.Nil"])]), [
    { params: [OwnedParam, OwnedParam], result: OwnedResult },
  ]);
  assert_eq(reset_params(rebuilt([b"m.Cons", b"m.Nil"])).keys(), [0]);
  assert_eq(infer_group_signatures([rebuilt([b"m.Nil", b"m.Cons"])]), [
    { params: [BorrowedParam, OwnedParam], result: OwnedResult },
  ]);
  assert_eq(reset_params(rebuilt([b"m.Nil", b"m.Cons"])).keys(), []);
  let from_every = |l: InferenceTarget| signatures_of(inferred_from([l], Map::new(), [reset_params(l)]));
  assert_eq(infer_group_signatures([rebuilt([b"m.Cons", b"m.Nil"])]), from_every(rebuilt([b"m.Cons", b"m.Nil"])));
  assert_eq(infer_group_signatures([rebuilt([b"m.Nil", b"m.Cons"])]), from_every(rebuilt([b"m.Nil", b"m.Cons"])))
}

test "a jump back to the start keeps a parameter borrowed while it hands on only what it borrows" {
  let p = string_var(0);
  let q = string_var(1);
  let n = int(2);
  let stop = bool_var(3);
  let m = int(4);
  let x = string_var(5);
  let go = |before: Block, args: List<Arg>|
    infer_group_signatures([
      definition_of(b"go", [p, q, n], AsInt, [
        bind(stop, Primitive({ op: b"le", on: AsInt, args: [VarOperand(n), IntOperand(0)] })),
        If({
          cond: VarOperand(stop),
          then: [Return(IntOperand(0))],
          otherwise: before.concat([
            bind(m, Primitive({ op: b"sub", on: AsInt, args: [VarOperand(n), IntOperand(1)] })),
            Restart(args.push(VarOperand(m))),
          ]),
        }),
      ]),
    ]);
  let borrows = [{ params: [BorrowedParam, BorrowedParam, BorrowedParam], result: OwnedResult }];
  assert_eq(go([], [VarOperand(p), VarOperand(q)]), borrows);
  assert_eq(go([], [VarOperand(q), VarOperand(p)]), borrows);
  assert_eq(
    go([bind(x, Get({ of: p, path: FieldPath({ name: b"rest", at: 1 }) }))], [
      VarOperand(x),
      VarOperand(q),
    ]),
    borrows,
  );
  assert_eq(go([bind(x, call_of(b"fresh", []))], [VarOperand(x), VarOperand(q)]), [
    { params: [OwnedParam, BorrowedParam, BorrowedParam], result: OwnedResult },
  ])
}

test "a record borrowed by reference stays borrowed across a jump only where the jump hands on a record borrowed the same way" {
  let b = string_var(2);
  let n = int(3);
  let stop = bool_var(4);
  let m = int(5);
  let jumps = |wide: Representation| {
    let w = of_type(0, b"m.W", wide);
    let v = of_type(1, b"m.W", wide);
    let x = of_type(6, b"m.W", wide);
    let go = |before: Block, args: List<Arg>|
      match infer_group_signatures([
          definition_of(b"go", [w, v, b, n], AsInt, [
            bind(stop, Primitive({ op: b"le", on: AsInt, args: [VarOperand(n), IntOperand(0)] })),
            If({
              cond: VarOperand(stop),
              then: [Return(IntOperand(0))],
              otherwise: before.concat([
                bind(m, Primitive({ op: b"sub", on: AsInt, args: [VarOperand(n), IntOperand(1)] })),
                Restart(args.concat([VarOperand(b), VarOperand(m)])),
              ]),
            }),
          ]),
        ]).at(
          0,
        ) {
        Some(h) -> h.params,
        None -> [],
      };
    let read = [bind(x, Get({ of: b, path: FieldPath({ name: b"w", at: 0 }) }))];
    [
      go([], [VarOperand(v), VarOperand(w)]),
      go(read, [VarOperand(x), VarOperand(v)]),
      go(read, [VarOperand(x), VarOperand(w)]),
    ]
  };
  let counted_fields = range(0, layout::max_flat_words() + 1).map(|k: Int|
    { name: b"f".concat(ascii_of_int(k)), representation: if k == 0 { AsWord } else { AsInt } });
  assert_eq(jumps(AsFlattened(counted_fields)), [
    [BorrowedParam, BorrowedParam, BorrowedParam, BorrowedParam],
    [OwnedParam, BorrowedParam, BorrowedParam, BorrowedParam],
    [OwnedParam, OwnedParam, BorrowedParam, BorrowedParam],
  ]);
  let scalars = range(0, layout::max_flat_words() + 1).map(|_: Int| layout::any_integer());
  let words = AsSum({
    layout: {
      classes: scalars,
      cases: [
        {
          test: Always,
          payload: Inline({ offset: 0, layout: PlainWords(scalars), stripped: None }),
        },
      ],
    },
    cases: [b"m.W"],
  });
  assert_eq(jumps(words), [
    [BorrowedParam, BorrowedParam, BorrowedParam, BorrowedParam],
    [OwnedParam, BorrowedParam, BorrowedParam, BorrowedParam],
    [OwnedParam, BorrowedParam, BorrowedParam, BorrowedParam],
  ])
}

test "a group that hands a parameter around borrows it, and gives it once any member keeps it" {
  let s = string_var(0);
  let y = int(1);
  let kept = string_var(2);
  let passing = |name: Bytes, to: Bytes, keeps: Bool|
    definition_of(
      name,
      [s],
      AsInt,
      (if keeps {
        [bind(kept, made_of(CaseAllocation({ case: 0, skip: 0, words: 1 }), [VarOperand(s)]))]
      } else { [] }).concat([bind(y, call_of(to, [VarOperand(s)])), Return(VarOperand(y))]),
    );
  let borrows = { params: [BorrowedParam], result: OwnedResult };
  let gives = { params: [OwnedParam], result: OwnedResult };
  assert_eq(infer_group_signatures([passing(b"ping", b"pong", false), passing(b"pong", b"ping", false)]), [
    borrows,
    borrows,
  ]);
  assert_eq(infer_group_signatures([passing(b"ping", b"pong", false), passing(b"pong", b"ping", true)]), [
    gives,
    gives,
  ]);
  assert_eq(
    infer_group_signatures([
      passing(b"one", b"two", false),
      passing(b"two", b"three", false),
      passing(b"three", b"one", true),
    ]),
    [gives, gives, gives],
  )
}

test "a tail group's member handed a value another member made is given it, and so is what it hands on" {
  let s = string_var(0);
  let n = int(1);
  let stop = bool_var(2);
  let m = int(3);
  let fresh = string_var(4);
  let member = |name: Bytes, to: Int, makes: Bool|
    {
      ..definition_of(name, [s, n], AsInt, [bind(stop, Primitive({ op: b"le", on: AsInt, args: [VarOperand(n), IntOperand(0)] })), If({ cond: VarOperand(stop), then: [Return(IntOperand(0))], otherwise: (if makes { [bind(fresh, call_of(b"fresh", []))] } else { [] }).concat([bind(m, Primitive({ op: b"sub", on: AsInt, args: [VarOperand(n), IntOperand(1)] })), Jump({ member: to, args: [if makes { VarOperand(fresh) } else { VarOperand(s) }, VarOperand(m)] })]) })]),
      group: [b"hop", b"skip"].map(of_m),
    };
  let borrows = { params: [BorrowedParam, BorrowedParam], result: OwnedResult };
  let gives = { params: [OwnedParam, BorrowedParam], result: OwnedResult };
  assert_eq(infer_group_signatures([member(b"hop", 1, false), member(b"skip", 0, false)]), [borrows, borrows]);
  assert_eq(infer_group_signatures([member(b"hop", 1, false), member(b"skip", 0, true)]), [gives, gives])
}

test "every recursion group is resolved after the groups it calls" {
  let s = string_var(0);
  let r = string_var(1);
  let keeps = definition_of(b"keeps", [s], AsWord, [
    bind(r, made_of(ListAllocation(1), [VarOperand(s)])),
    Return(VarOperand(r)),
  ]);
  let hands = definition_of(b"hands", [s], AsWord, [
    bind(r, call_of(b"keeps", [VarOperand(s)])),
    Return(VarOperand(r)),
  ]);
  let handed = infer_signatures([hands, keeps], Map::new(), Map::new()).handed;
  assert_eq(handed.get(of_m(b"hands")), Some({ params: [OwnedParam], result: OwnedResult }));
  assert_eq(handed.get(of_m(b"keeps")), Some({ params: [OwnedParam], result: OwnedResult }))
}

test "a parameter declared borrowed stays borrowed, and one it keeps is inferred" {
  let f = string_var(0);
  let r = string_var(1);
  let storing = definition_of(b"f", [f], AsWord, [
    bind(r, made_of(ListAllocation(1), [VarOperand(f)])),
    Return(VarOperand(r)),
  ]);
  assert_eq(infer_group_signatures([{ ..storing, borrowed: [0] }]), [
    { params: [BorrowedParam], result: OwnedResult },
  ]);
  assert_eq(infer_group_signatures([storing]), [{ params: [OwnedParam], result: OwnedResult }]);
  let reading = definition_of(b"g", [f], AsInt, [Return(IntOperand(0))]);
  assert_eq(infer_group_signatures([reading]), [{ params: [BorrowedParam], result: OwnedResult }])
}

test "a result read out of what is borrowed is borrowed of it, and one made on any path is owned" {
  let p = string_var(0);
  let q = string_var(1);
  let c = bool_var(2);
  let x = string_var(3);
  let j = string_var(4);
  let m = string_var(5);
  assert_eq(
    infer_group_signatures([
      definition_of(b"name", [p], AsWord, [
        bind(x, Get({ of: p, path: FieldPath({ name: b"name", at: 0 }) })),
        Return(VarOperand(x)),
      ]),
    ]),
    [{ params: [BorrowedParam], result: BorrowedResult([{ param: 0, whole: false }]) }],
  );
  let pick = |otherwise: Block|
    definition_of(b"pick", [p, q, c], AsWord, [
      Declaration(j),
      If({
        cond: VarOperand(c),
        then: [Assign({ var: j, arg: VarOperand(p) })],
        otherwise: otherwise,
      }),
      Return(VarOperand(j)),
    ]);
  assert_eq(infer_group_signatures([pick([Assign({ var: j, arg: VarOperand(q) })])]), [
    {
      params: [BorrowedParam, BorrowedParam, BorrowedParam],
      result: BorrowedResult([{ param: 0, whole: true }, { param: 1, whole: true }]),
    },
  ]);
  assert_eq(
    infer_group_signatures([pick([bind(m, call_of(b"fresh", [])), Assign({ var: j, arg: VarOperand(m) })])]),
    [{ params: [OwnedParam, BorrowedParam, BorrowedParam], result: OwnedResult }],
  );
  let some = |item: Type| {
    let result = option_type(item);
    let o = { id: 6, ty: result, representation: AsWord };
    let l = definition_of(b"some", [x], AsWord, [
      bind(o, Aggregate({ parts: [IntOperand(1), VarOperand(x)] })),
      Return(VarOperand(o)),
    ]);
    { ..l, f: { ..l.f, result_type: result }, whole: { ..l.whole, result_type: result } }
  };
  assert_eq([string_type(), VariableType(0)].map(|t: Type| infer_group_signatures([some(t)])), [
    [{ params: [BorrowedParam], result: BorrowedResult([{ param: 0, whole: true }]) }],
    [{ params: [OwnedParam], result: OwnedResult }],
  ])
}

test "an item read out of a borrowed list is borrowed, and a caller keeping it borrows the list but gives what it returns whole" {
  let xs = string_var(0);
  let i = int(1);
  let x = string_var(2);
  let ys = string_var(3);
  let y = string_var(4);
  let kept = string_var(5);
  let read = Native({
    name: b"rt_list_at",
    args: [VarOperand(xs), VarOperand(i)],
    uses: { takes: [false, false], owned: false, fails: true, suspends: false },
  });
  let item = {
    params: [BorrowedParam, BorrowedParam],
    result: BorrowedResult([{ param: 0, whole: false }]),
  };
  assert_eq(
    infer_group_signatures([definition_of(b"at", [xs, i], AsWord, [bind(x, read), Return(VarOperand(x))])]),
    [item],
  );
  let keeping = |callee: Bytes, handing: OwnershipSignature|
    resolved_with(
      [
        definition_of(b"keep", [ys], AsWord, [
          bind(y, call_of(callee, [VarOperand(ys), IntOperand(0)])),
          bind(kept, made_of(ListAllocation(1), [VarOperand(y)])),
          Return(VarOperand(kept)),
        ]),
      ],
      [{ name: callee, signature: handing }],
    );
  assert_eq(keeping(b"at", item), [{ params: [BorrowedParam], result: OwnedResult }]);
  assert_eq(
    keeping(b"same", {
      params: [BorrowedParam, BorrowedParam],
      result: BorrowedResult([{ param: 0, whole: true }]),
    }),
    [{ params: [OwnedParam], result: OwnedResult }],
  )
}

test "a root written for a type borrows what it reads, and a drop takes its operand" {
  let p = string_var(0);
  let q = string_var(1);
  let same = bool_var(2);
  let written = |op: TypeOp, args: List<Arg>|
    Call({
      callee: Root(keys::generated_key(op, NamedType({ name: b"m.T", args: [] }), b"m")),
      args: args,
      convention: {
        params: owned_params(args.map(operand_representation)),
        result: AsWord,
        destination_passing: false,
        returned: OwnedResult,
      },
      suspends: false,
    });
  assert_eq(
    infer_group_signatures([
      definition_of(b"same", [p, q], AsBool, [
        bind(same, written(Equal, [VarOperand(p), VarOperand(q)])),
        Return(VarOperand(same)),
      ]),
    ]),
    [{ params: [BorrowedParam, BorrowedParam], result: OwnedResult }],
  );
  assert_eq(
    infer_group_signatures([
      definition_of(b"gone", [p], AsInt, [
        Do({ value: written(Drop, [VarOperand(p)]), at: dummy_span(), unwind: [] }),
        Return(IntOperand(0)),
      ]),
    ]),
    [{ params: [OwnedParam], result: OwnedResult }],
  );
  assert_eq(
    [
      Lower,
      Lift,
      ContainerWalk(b"lower_items"),
      ContainerWalk(b"lower_entries"),
      ContainerWalk(b"lift_items"),
      ContainerWalk(b"lift_entries"),
    ].map(|op: TypeOp| generated_signature(op, 2).params),
    [
      [BorrowedParam, BorrowedParam],
      [OwnedParam, OwnedParam],
      [BorrowedParam, BorrowedParam],
      [BorrowedParam, BorrowedParam],
      [OwnedParam, OwnedParam],
      [OwnedParam, OwnedParam],
    ],
  );
  assert_eq(
    [ContainerWalk(b"equal_from"), ContainerWalk(b"digest_from")].map(|op: TypeOp|
      generated_signature(op, 3).params),
    [[BorrowedParam, BorrowedParam, BorrowedParam], [BorrowedParam, OwnedParam, BorrowedParam]],
  )
}

test "a handing reads as its parameters and then how it returns" {
  assert_eq(
    ownership_text({
      params: [BorrowedParam, OwnedParam],
      result: BorrowedResult([{ param: 0, whole: true }, { param: 2, whole: false }]),
    }),
    b"[borrowed, given] borrowed(0, 2 part)",
  );
  assert_eq(ownership_text(all_owned(0)), b"[] owned")
}

fn calls_written(b: Block) -> List<Convention> =
  b.fold([], |acc: List<Convention>, i: Inst|
    match i { Let(l) -> match l.value { Call(c) -> acc.push(c.convention), _ -> acc }, _ -> acc })

test "a body is written against its own handing and each callee's, a callee nothing infers taking all" {
  let s = string_var(0);
  let r = string_var(1);
  let q = string_var(2);
  let f = definition_of(b"f", [s], AsWord, [
    bind(r, call_of(b"look", [VarOperand(s)])),
    bind(q, call_of(b"other", [VarOperand(r)])),
    Return(VarOperand(q)),
  ]).f;
  let read = { params: [BorrowedParam], result: BorrowedResult([{ param: 0, whole: false }]) };
  let handed = Map::new().insert(of_m(b"f"), {
    params: [BorrowedParam],
    result: OwnedResult,
  }).insert(
    of_m(b"look"),
    read,
  );
  let written = with_conventions(f, handed);
  assert_eq(param_ownerships(written.convention), [BorrowedParam]);
  assert_eq(
    calls_written(written.body).map(|c: Convention| { params: param_ownerships(c), result: c.returned }),
    [read, all_owned(1)],
  );
  let said = handle {
    with_conventions(f, handed.insert(of_m(b"look"), all_owned(2)));
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert_eq(said, b"a handing of 2 parameters for a convention of 1: m.look in m.f");
  let at = { ..f, key: keys::specialisation_key(b"m.f", [], []) };
  assert_eq(param_ownerships(with_conventions(at, handed).convention), [BorrowedParam]);
  let borrowing = handed.insert(of_m(b"f"), read);
  let scalar = {
    ..at,
    params: [int(0)],
    convention: {
      ..at.convention,
      params: at.convention.params.map(|p: ParamTaking| { ..p, representation: AsInt }),
      result: AsInt,
    },
  };
  assert_eq(
    [
      with_conventions(at, borrowing).convention.returned,
      with_conventions(scalar, borrowing).convention.returned,
    ],
    [read.result, OwnedResult],
  );
  let for_type = |op: TypeOp|
    param_ownerships(
      with_conventions(
        { ..f, key: keys::generated_key(op, NamedType({ name: b"m.T", args: [] }), b"m") },
        handed,
      ).convention,
    );
  assert_eq([for_type(Equal), for_type(Drop)], [[BorrowedParam], [OwnedParam]]);
  let generic = match call_of(b"look", [VarOperand(s)]) {
    Call(c) -> Call({ ..c, callee: Generic(0) }),
    other -> other,
  };
  let closure = {
    ..f,
    key: Named(b"m.f"),
    body: [bind(r, generic), Return(VarOperand(r))],
    links: no_links(),
  };
  let rooted = {
    ..f,
    lambdas: [
      Closure({ body: closure, captures: 0, at: dummy_span(), words: no_closure_evidence() }),
    ],
    links: {
      ..no_links(),
      generics: [
        { callee: Named(b"m.look"), args: [], carried: [], functions: [], effect_evidence: [] },
      ],
    },
  };
  match with_conventions(rooted, handed).lambdas {
    [Closure(c)] ->
      assert_eq(
        calls_written(c.body.body).map(|x: Convention|
          { params: param_ownerships(x), result: x.returned }),
        [read],
      ),
    _ -> assert(false, None),
  }
}

test "only a definition's own form is read, each borrowing what its declaration borrows" {
  let s = string_var(0);
  let f = definition_of(b"f", [s], AsWord, [Return(VarOperand(s))]).f;
  let typed = NamedType({ name: b"m.T", args: [] });
  let forms = [
    f,
    { ..f, key: keys::specialisation_key(b"m.f", [], []) },
    { ..f, key: keys::generated_key(Equal, typed, b"m") },
  ];
  assert_eq(
    inference_targets_of(Map::new().insert(of_m(b"f"), [0]), forms).map(|l: InferenceTarget|
      { definition: l.definition, borrowed: l.borrowed }),
    [{ definition: of_m(b"f"), borrowed: [0] }],
  )
}
