pub type OwnershipSignature = { params: List<ParamOwnership>, result: ResultOwnership }

pub type OwnershipReasons = { params: List<Option<Span>>, result: Option<Span> }

pub type InferredOwnership = { signature: OwnershipSignature, reason: OwnershipReasons }

pub type InferenceTarget = {
  definition: RootName,
  member: Function,
  group: List<RootName>,
  borrowed: List<Int>,
  enclosing: Function,
}

pub fn all_owned(arity: Int) -> OwnershipSignature =
  { params: range(0, arity).map(|_: Int| OwnedParam), result: OwnedResult }

pub fn inference_targets_of(
  declared: Map<RootName, List<Int>>,
  forms: List<Function>,
) -> List<InferenceTarget> =
  forms.fold([], |accumulator: List<InferenceTarget>, f: Function|
    match signature_name(f.key) {
      Some(_) -> accumulator.concat(targets_of(declared, f)),
      None -> accumulator,
    })

pub fn declared_borrows(
  into: Map<RootName, List<Int>>,
  module: Bytes,
  here: List<Definition>,
) -> Map<RootName, List<Int>> =
  here.fold(into, |m: Map<RootName, List<Int>>, d: Definition|
    if d.borrowed.len() == 0 { m }
    else { m.insert(root_name(Named(qualify(module, d.name))), d.borrowed) })

pub fn group_signatures(
  group: List<InferenceTarget>,
  published: Map<RootName, OwnershipSignature>,
) -> List<InferredOwnership> / {abort.raise} = {
  let plain = inferred_from(group, published, group.map(|_: InferenceTarget| Map::new()));
  let borrowing = range(0, group.len()).fold(Map::new(), |m: Map<RootName, Bool>, k: Int|
    match ((group.at(k), plain.at(k))) {
      (Some(l), Some(x)) -> if borrows_counted(l, x.signature) && may_reuse(l.enclosing) {
        m.insert(root_name(l.enclosing.key), true)
      } else { m },
      _ -> m,
    });
  if borrowing.len() == 0 { plain } else {
    let placed = borrowing.fold(
      Map::new(),
      |m: Map<RootName, Map<Int, Span>>, name: RootName, _: Bool|
        match group.find(|l: InferenceTarget| root_name(l.enclosing.key) == name) {
          Some(l) -> m.insert(name, reused_params(l.enclosing)),
          None -> m,
        },
    );
    let resets = group.map(|l: InferenceTarget|
      match placed.get(root_name(l.enclosing.key)) {
        Some(r) -> by_place(r, l.member.params),
        None -> Map::new(),
      });
    if resets.all(|r: Map<Int, Span>| r.len() == 0) { plain }
    else { inferred_from(group, published, resets) }
  }
}

pub fn reset_params(l: InferenceTarget) -> Map<Int, Span> =
  by_place(reused_params(l.enclosing), l.member.params)

fn inferred_from(
  group: List<InferenceTarget>,
  published: Map<RootName, OwnershipSignature>,
  resets: List<Map<Int, Span>>,
) -> List<InferredOwnership> / {abort.raise} =
  iterate(
    range(0, group.len()).fold([], |accumulator: List<InferredOwnership>, k: Int|
      match group.at(k) {
        Some(l) ->
          accumulator.push(first_guess(l, match resets.at(k) { Some(r) -> r, None -> Map::new() })),
        None -> accumulator,
      }),
    group.fold(2, |n: Int, m: InferenceTarget| n + 3 * m.member.params.len() + 2),
    |current: List<InferredOwnership>| {
      let next = round(group, published, current);
      if signatures_of(next) == signatures_of(current) { Stop(next) } else { Continue(next) }
    },
  )

fn borrows_counted(l: InferenceTarget, h: OwnershipSignature) -> Bool =
  range(0, l.member.params.len()).any(|k: Int|
    (match l.member.params.at(k) { Some(p) -> is_refcounted(p.representation), None -> false })
      && h.params.at(k) == Some(BorrowedParam))

pub type InferenceResult = {
  signatures: Map<RootName, OwnershipSignature>,
  groups: Map<RootName, List<RootKey>>,
}

pub fn infer_signatures(
  lendings: List<InferenceTarget>,
  given: Map<RootName, OwnershipSignature>,
  declared: Map<RootName, List<Int>>,
) -> InferenceResult / {abort.raise} = {
  let published = with_declared_borrows(given, declared, lendings);
  let at = range(0, lendings.len()).fold(Map::new(), |m: Map<RootName, Int>, k: Int|
    match lendings.at(k) { Some(l) -> m.insert(l.definition, k), None -> m });
  let out = lendings.map(|l: InferenceTarget|
    called(l).fold([], |accumulator: List<Int>, d: RootName|
      match at.get(d) { Some(k) -> accumulator.push(k), None -> accumulator }));
  let calls = graph::of(lendings.len(), |k: Int| match out.at(k) { Some(xs) -> xs, None -> [] });
  graph::components(calls).fold(
    { signatures: published, groups: Map::new() },
    |done: InferenceResult, comp: List<Int>| {
      let group = comp.fold([], |g: List<InferenceTarget>, k: Int|
        match lendings.at(k) { Some(l) -> g.push(l), None -> g });
      let definitions = group.map(|l: InferenceTarget| l.member.key);
      let hs = signatures_of(group_signatures(group, done.signatures));
      range(0, group.len()).fold(done, |s: InferenceResult, k: Int|
        match group.at(k) {
          Some(l) -> match hs.at(k) {
            Some(h) ->
              {
                signatures: s.signatures.insert(l.definition, h),
                groups: s.groups.insert(l.definition, definitions),
              },
            None -> s,
          },
          None -> s,
        })
    },
  )
}

fn with_declared_borrows(
  published: Map<RootName, OwnershipSignature>,
  declared: Map<RootName, List<Int>>,
  lendings: List<InferenceTarget>,
) -> Map<RootName, OwnershipSignature> =
  lendings.fold(published, |look: Map<RootName, OwnershipSignature>, l: InferenceTarget| {
    let generics = generics_of(l.member);
    values_folded(l.member.body, look, |m: Map<RootName, OwnershipSignature>, v: Rvalue|
      match v {
        Call(c) -> match callee_definition(generics, c.callee) {
          Some(d) -> if m.contains(d) { m } else {
            match declared.get(d) {
              Some(borrowed) -> {
                let n = borrowed.fold(0, |most: Int, k: Int|
                  if k + 1 > most { k + 1 } else { most });
                m.insert(d, {
                  params: range(0, n).map(|k: Int|
                    if borrowed.contains(k) { BorrowedParam } else { OwnedParam }),
                  result: OwnedResult,
                })
              },
              None -> m,
            }
          },
          None -> m,
        },
        _ -> m,
      })
  })

pub fn ownership_text(h: OwnershipSignature) -> Bytes =
  Bytes::concat_all([
    b"[",
    Bytes::join(
      h.params.map(|p: ParamOwnership|
        match p { BorrowedParam -> b"borrowed", OwnedParam -> b"given" }),
      b", ",
    ),
    b"] ",
    match h.result {
      OwnedResult -> b"owned",
      BorrowedResult(from) ->
        Bytes::concat_all([
          b"borrowed(",
          Bytes::join(
            from.map(|x: { param: Int, whole: Bool }|
              if x.whole { ascii_of_int(x.param) } else { ascii_of_int(x.param).concat(b" part") }),
            b", ",
          ),
          b")",
        ]),
    },
  ])

pub fn with_conventions(
  f: Function,
  published_signatures: Map<RootName, OwnershipSignature>,
) -> Function / {abort.raise} = {
  let own = |k: RootKey, c: Convention|
    match key_definition(k) {
      Some(d) -> match published_signatures.get(d) {
        Some(h) -> convention_for(c, h, root_text(d)),
        None -> c,
      },
      None -> match k {
        Generated(x, _) ->
          convention_for(
            c,
            generated_signature(x.operation, c.params.len()),
            root_text(root_name(k)),
          ),
        _ -> c,
      },
    };
  let called = calls_with_conventions(f, generics_of(f), published_signatures);
  {
    ..called,
    convention: if f.members.len() == 0 { own(f.key, f.convention) } else { f.convention },
    members: f.members.map(|m: Member| { ..m, convention: own(m.key, m.convention) }),
  }
}

fn key_definition(k: RootKey) -> Option<RootName> = signature_name(unspecialised(k))

fn signature_name(k: RootKey) -> Option<RootName> =
  match k {
    Specialisation(_, _) -> None,
    Generated(_, _) -> None,
    EntryPoint(_) -> None,
    _ -> Some(root_name(k)),
  }

fn convention_for(c: Convention, h: OwnershipSignature, what: Bytes) -> Convention / {abort.raise} =
  if h.params.len() > c.params.len() {
    panic(
      String::of_bytes_lossy(
        Bytes::concat_all([
          b"a handing of ",
          ascii_of_int(h.params.len()),
          b" parameters, but the function has only ",
          ascii_of_int(c.params.len()),
          b": ",
          what,
        ]),
      ),
    )
  } else {
    {
      ..with_ownerships(c, h.params),
      returned: match h.result {
        OwnedResult -> OwnedResult,
        BorrowedResult(from) -> if !is_refcounted(c.result) { OwnedResult } else {
          BorrowedResult(
            from.filter(|x: { param: Int, whole: Bool }|
              match param_rep(c, x.param) { Some(r) -> is_refcounted(r), None -> false }),
          )
        },
      },
    }
  }

fn calls_with_conventions(
  f: Function,
  generics: List<RootName>,
  published_signatures: Map<RootName, OwnershipSignature>,
) -> Function / {abort.raise} =
  {
    ..f,
    body: block_with_conventions(
      root_text(root_name(f.key)),
      generics,
      published_signatures,
      f.body,
    ),
    lambdas: f.lambdas.map(|l: Lambda|
      match l {
        Closure(c) ->
          Closure({ ..c, body: calls_with_conventions(c.body, generics, published_signatures) }),
      }),
  }

fn generics_of(f: Function) -> List<RootName> =
  f.links.generics.map(|g: GenericCall| root_name(g.callee))

fn block_with_conventions(
  within: Bytes,
  generics: List<RootName>,
  published_signatures: Map<RootName, OwnershipSignature>,
  b: Block,
) -> Block / {abort.raise} =
  b.map(|i: Instruction|
    match i {
      Let(l) ->
        Let({
          ..l,
          value: value_with_conventions(within, generics, published_signatures, l.value),
        }),
      Do(d) ->
        Do({ ..d, value: value_with_conventions(within, generics, published_signatures, d.value) }),
      If(x) ->
        If({
          ..x,
          then: block_with_conventions(within, generics, published_signatures, x.then),
          otherwise: block_with_conventions(within, generics, published_signatures, x.otherwise),
        }),
      Case(c) ->
        Case({
          ..c,
          arms: c.arms.map(|a: { when: Int, body: Block }|
            {
              when: a.when,
              body: block_with_conventions(within, generics, published_signatures, a.body),
            }),
          rest: block_with_conventions(within, generics, published_signatures, c.rest),
        }),
      Match(m) ->
        Match({
          arms: m.arms.map(|a: Block|
            block_with_conventions(within, generics, published_signatures, a)),
          rest: block_with_conventions(within, generics, published_signatures, m.rest),
        }),
      Loop(l) ->
        Loop({ ..l, body: block_with_conventions(within, generics, published_signatures, l.body) }),
      Handle(h) ->
        Handle({
          ..h,
          body: block_with_conventions(within, generics, published_signatures, h.body),
        }),
      CleanupScope(Some(xs)) ->
        CleanupScope(Some(cleanups_with_conventions(generics, published_signatures, xs))),
      Fail(x) ->
        Fail({
          ..x,
          resource: cleanups_with_conventions(generics, published_signatures, x.resource),
        }),
      _ -> i,
    })

fn cleanups_with_conventions(
  generics: List<RootName>,
  published_signatures: Map<RootName, OwnershipSignature>,
  xs: List<Unwinding>,
) -> List<Unwinding> / {abort.raise} =
  xs.map(|x: Unwinding|
    {
      ..x,
      convention: convention_for(
        x.convention,
        signature_at(published_signatures, generics, Root(x.callee), 1),
        root_text(root_name(x.callee)),
      ),
    })

fn value_with_conventions(
  within: Bytes,
  generics: List<RootName>,
  published_signatures: Map<RootName, OwnershipSignature>,
  v: Rvalue,
) -> Rvalue / {abort.raise} =
  match v {
    Call(c) ->
      Call({
        ..c,
        convention: convention_for(
          c.convention,
          signature_at(published_signatures, generics, c.callee, c.args.len()),
          Bytes::concat_all([
            match c.callee {
              Root(k) -> root_text(root_name(k)),
              Generic(n) -> match generics.at(n) {
                Some(d) ->
                  Bytes::concat_all([b"generic call ", ascii_of_int(n), b" of ", root_text(d)]),
                None -> b"generic call ".concat(ascii_of_int(n)),
              },
            },
            b" in ",
            within,
          ]),
        ),
      }),
    _ -> v,
  }

fn targets_of(declared: Map<RootName, List<Int>>, f: Function) -> List<InferenceTarget> = {
  let borrowing = |g: Function, group: List<RootName>| {
    let name = root_name(g.key);
    {
      definition: name,
      member: g,
      group: group,
      borrowed: match declared.get(name) { Some(ps) -> ps, None -> [] },
      enclosing: f,
    }
  };
  if f.members.len() == 0 { [borrowing(f, [])] } else {
    let names = f.members.map(|m: Member| root_name(m.key));
    range(0, f.members.len()).fold([], |accumulator: List<InferenceTarget>, i: Int|
      match f.members.at(i) {
        Some(m) ->
          accumulator.push(
            borrowing(
              {
                ..f,
                key: m.key,
                params: m.params,
                convention: m.convention,
                body: arm_of(f.body, i),
                base: m.base,
                members: [],
              },
              names,
            ),
          ),
        None -> accumulator,
      })
  }
}

fn arm_of(b: Block, i: Int) -> Block =
  match b {
    [Case(c)] ->
      c.arms.fold([], |body: Block, a: { when: Int, body: Block }|
        if a.when == i { a.body } else { body }),
    _ -> [],
  }

fn by_place(resets: Map<Int, Span>, params: List<Variable>) -> Map<Int, Span> =
  range(0, params.len()).fold(Map::new(), |m: Map<Int, Span>, k: Int|
    match params.at(k) {
      Some(p) -> match resets.get(p.id) { Some(at) -> m.insert(k, at), None -> m },
      None -> m,
    })

fn reused_params(f: Function) -> Map<Int, Span> = {
  let giving = |c: Convention|
    { ..c, params: c.params.map(|p: ParamTaking| { ..p, ownership: OwnedParam }) };
  let counted_form = insert_reference_counts({
    ..f,
    convention: giving(f.convention),
    members: f.members.map(|m: Member| { ..m, convention: giving(m.convention) }),
  });
  let params = f.members.fold(f.params, |ps: List<Variable>, m: Member| ps.concat(m.params));
  collect_memory_reuse(
    {
      sources: params.fold(Map::new(), |h: Map<Int, List<Int>>, p: Variable|
        h.insert(p.id, [p.id])),
      tokens: Map::new(),
      at: Map::new(),
    },
    counted_form.body,
  ).at
}

type Reuse = { sources: Map<Int, List<Int>>, tokens: Map<Int, List<Int>>, at: Map<Int, Span> }

fn collect_memory_reuse(r: Reuse, b: Block) -> Reuse =
  b.fold(r, |accumulator: Reuse, i: Instruction|
    match i {
      Let(l) -> {
        let from = value_sources(accumulator, l.value);
        {
          ..accumulator,
          sources: if from.len() == 0 { accumulator.sources }
          else { accumulator.sources.insert(l.var.id, from) },
          at: match l.value {
            Allocate(m) -> match m.reuse {
              Some(t) ->
                (match accumulator.tokens.get(t.id) { Some(ps) -> ps, None -> [] }).fold(
                  accumulator.at,
                  |a: Map<Int, Span>, p: Int| if a.contains(p) { a } else { a.insert(p, l.at) },
                ),
              None -> accumulator.at,
            },
            _ -> accumulator.at,
          },
        }
      },
      Assign(x) ->
        {
          ..accumulator,
          sources: accumulator.sources.insert(
            x.var.id,
            ints_joined(variable_sources(accumulator, x.var), arg_sources(accumulator, x.arg)),
          ),
        },
      Destructure(o) ->
        {
          ..accumulator,
          sources: o.words.fold(accumulator.sources, |h: Map<Int, List<Int>>, w: Variable|
            h.insert(w.id, variable_sources(accumulator, o.of))),
        },
      Reset(x) ->
        {
          ..accumulator,
          tokens: accumulator.tokens.insert(x.token.id, variable_sources(accumulator, x.of)),
        },
      If(x) -> collect_memory_reuse(collect_memory_reuse(accumulator, x.then), x.otherwise),
      Case(c) ->
        c.arms.fold(
          collect_memory_reuse(accumulator, c.rest),
          |a: Reuse, arm: { when: Int, body: Block }| collect_memory_reuse(a, arm.body),
        ),
      Match(m) -> m.arms.fold(collect_memory_reuse(accumulator, m.rest), collect_memory_reuse),
      Loop(l) -> collect_memory_reuse(accumulator, l.body),
      Handle(h) -> collect_memory_reuse(accumulator, h.body),
      _ -> accumulator,
    })

fn value_sources(r: Reuse, value: Rvalue) -> List<Int> =
  match value {
    Take(t) -> variable_sources(r, t.of),
    Convert(p) -> if allocates(operand_representation(p.arg), p.to) { [] }
    else { arg_sources(r, p.arg) },
    Aggregate(g) -> g.parts.fold([], |ps: List<Int>, a: Arg| ints_joined(ps, arg_sources(r, a))),
    Update(u) ->
      u.sets.fold(variable_sources(r, u.of), |ps: List<Int>, s: FieldWrite|
        ints_joined(ps, arg_sources(r, s.arg))),
    _ -> match provenance(value) {
      BorrowSources(xs) ->
        xs.fold([], |ps: List<Int>, x: Variable| ints_joined(ps, variable_sources(r, x))),
      _ -> [],
    },
  }

fn variable_sources(r: Reuse, v: Variable) -> List<Int> =
  match r.sources.get(v.id) { Some(ps) -> ps, None -> [] }

fn arg_sources(r: Reuse, a: Arg) -> List<Int> =
  match operand_variable(a) { Some(v) -> variable_sources(r, v), None -> [] }

type Origin = { sources: Map<Int, Bool>, fresh: Bool }

type Use = { does: Action, at: Span }

type Action =
  | Consumes(Origin)
  | PassesOn(Origin)
  | Jumps({ to: RootName, param: Int, of: Origin, counts: Bool })
  | Returns(Origin)
  | Sets({ join: Int, of: Origin })

type Walk = {
  origins: Map<Int, Origin>,
  captured: Map<Int, List<Origin>>,
  uses: List<Use>,
  at: Span,
}

type WalkContext = {
  signatures: Map<RootName, OwnershipSignature>,
  generics: List<RootName>,
  definition: RootName,
  group: List<RootName>,
  framed: Map<Int, Bool>,
}

type RequiredOwnedParam = { to: RootName, param: Int, at: Span }

type ConsumedParams = { own: Map<Int, Span>, jumped: List<RequiredOwnedParam> }

type MemberResult = {
  borrowing: InferenceTarget,
  current: InferredOwnership,
  walk: Walk,
  consumed_params: ConsumedParams,
}

fn first_guess(m: InferenceTarget, resets: Map<Int, Span>) -> InferredOwnership = {
  let n = declared_arity(m.member.params);
  let reset = |k: Int| !m.borrowed.contains(k) && resets.contains(k);
  {
    signature: {
      params: range(0, n).map(|k: Int| if reset(k) { OwnedParam } else { BorrowedParam }),
      result: if n > 0 && is_refcounted(m.member.convention.result)
          && !has_variables(m.member.result_type) { BorrowedResult([]) }
      else { OwnedResult },
    },
    reason: {
      params: range(0, n).map(|k: Int| if reset(k) { resets.get(k) } else { None }),
      result: None,
    },
  }
}

fn signatures_of(xs: List<InferredOwnership>) -> List<OwnershipSignature> =
  xs.map(|x: InferredOwnership| x.signature)

fn round(
  group: List<InferenceTarget>,
  published: Map<RootName, OwnershipSignature>,
  current: List<InferredOwnership>,
) -> List<InferredOwnership> = {
  let look = range(0, group.len()).fold(
    published,
    |m: Map<RootName, OwnershipSignature>, k: Int|
      match group.at(k) {
        Some(l) -> match current.at(k) {
          Some(c) -> m.insert(l.definition, c.signature),
          None -> m,
        },
        None -> m,
      },
  );
  let reps = group.fold(Map::new(), |m: Map<RootName, List<Representation>>, l: InferenceTarget|
    m.insert(l.definition, l.member.params.map(|p: Variable| p.representation)));
  let found = range(0, group.len()).fold([], |accumulator: List<MemberResult>, k: Int|
    match group.at(k) {
      Some(l) -> match current.at(k) {
        Some(c) -> {
          let w = member_walk(
            {
              signatures: look,
              generics: generics_of(l.member),
              definition: l.definition,
              group: l.group,
              framed: Map::new(),
            },
            l.member,
          );
          accumulator.push({
            borrowing: l,
            current: c,
            walk: w,
            consumed_params: consumed_in(
              c.signature,
              look,
              reps,
              l.member.params.map(|p: Variable| p.representation),
              w,
            ),
          })
        },
        None -> accumulator,
      },
      None -> accumulator,
    });
  let jumps = found.fold([], |js: List<RequiredOwnedParam>, x: MemberResult|
    js.concat(x.consumed_params.jumped));
  found.map(|x: MemberResult|
    resolved(
      x.borrowing,
      x.current,
      x.walk,
      jumps.fold(x.consumed_params.own, |g: Map<Int, Span>, j: RequiredOwnedParam|
        if j.to == x.borrowing.definition { first_at(g, j.param, j.at) } else { g }),
    ))
}

fn member_walk(s: WalkContext, f: Function) -> Walk = stack_placed_walk(s, f).walk

fn stack_placed_walk(s: WalkContext, f: Function) -> { walk: Walk, framed: Map<Int, Bool> } = {
  let start = range(0, f.params.len()).fold(
    { origins: Map::new(), captured: Map::new(), uses: [], at: dummy_span() },
    |w: Walk, k: Int|
      match f.params.at(k) {
        Some(p) -> defined(w, p, { sources: Map::new().insert(k, true), fresh: false }),
        None -> w,
      },
  );
  let candidates = stack_candidates(f);
  walk_dropping_escapes(s, start, f.body, candidates, candidates.len())
}

fn walk_dropping_escapes(
  s: WalkContext,
  start: Walk,
  b: Block,
  framed: Map<Int, Bool>,
  room: Int,
) -> { walk: Walk, framed: Map<Int, Bool> } = {
  let w = walk_block({ ..s, framed: framed }, start, b);
  let gone = escaping_blocks(w);
  let retained_frames = framed.fold(Map::new(), |m: Map<Int, Bool>, id: Int, _: Bool|
    if gone.contains(id) { m } else { m.insert(id, true) });
  if retained_frames.len() == framed.len() || room <= 0 { { walk: w, framed: framed } }
  else { walk_dropping_escapes(s, start, b, retained_frames, room - 1) }
}

fn block_base(id: Int) -> Int = 0 - 1 - id

fn stack_candidates(f: Function) -> Map<Int, Bool> =
  if stops_in(f.body) { Map::new() } else {
    bound_values(f.body, Map::new(), |m: Map<Int, Bool>, v: Variable, value: Rvalue|
      match value {
        Allocate(x) -> match x.made {
          ListAllocation(n) -> if n > 0 && n <= layout::max_frame_list_items()
              && allocation_words(x.made, x.args) <= layout::frame_block_words()
              && !x.args.any(|a: Arg|
                match a { VariableOperand(y) -> is_record_word(y), _ -> false }) {
            m.insert(v.id, true)
          } else { m },
          _ -> m,
        },
        _ -> m,
      })
  }

fn capped(b: Block, placed: Map<Int, Bool>) -> Map<Int, Bool> =
  bound_values(
    b,
    { retained: placed, words: 0 },
    |accumulator: { retained: Map<Int, Bool>, words: Int }, v: Variable, value: Rvalue|
      match value {
        Allocate(x) -> {
          let w = allocation_words(base_allocation(x.made), x.args);
          if base_allocation(x.made) != x.made { { ..accumulator, words: accumulator.words + w } }
          else if !placed.contains(v.id) { accumulator }
          else if accumulator.words + w > layout::frame_words() {
            { ..accumulator, retained: accumulator.retained.remove(v.id) }
          } else { { ..accumulator, words: accumulator.words + w } }
        },
        _ -> accumulator,
      },
  ).retained

fn allocation_words(fresh_origin: Allocation, args: List<Arg>) -> Int = {
  let widths = args.map(|a: Arg| max(1, value_words(operand_representation(a))));
  match fresh_origin {
    ListAllocation(n) -> 1 + layout::head_words(layout::list_head()) + n * widths.fold(1, max),
    _ -> 2 + widths.fold(0, |s: Int, w: Int| s + w),
  }
}

fn stops_in(b: Block) -> Bool =
  values_folded(b, false, |accumulator: Bool, v: Rvalue| accumulator || may_suspend(v))

fn bound_values<s>(b: Block, accumulator: s, on: (s, Variable, Rvalue) -> s) -> s =
  b.fold(accumulator, |a: s, i: Instruction|
    match i {
      Let(l) -> on(a, l.var, l.value),
      If(x) -> bound_values(x.otherwise, bound_values(x.then, a, on), on),
      Case(c) ->
        c.arms.fold(bound_values(c.rest, a, on), |q: s, arm: { when: Int, body: Block }|
          bound_values(arm.body, q, on)),
      Match(m) ->
        m.arms.fold(bound_values(m.rest, a, on), |q: s, arm: Block| bound_values(arm, q, on)),
      Loop(l) -> bound_values(l.body, a, on),
      Handle(h) -> bound_values(h.body, a, on),
      _ -> a,
    })

fn escaping_blocks(w: Walk) -> Map<Int, Bool> = {
  let blocks = |g: Map<Int, Bool>, o: Origin, part: Bool|
    o.sources.fold(g, |m: Map<Int, Bool>, k: Int, whole: Bool|
      if k < 0 && (whole || part) { m.insert(0 - 1 - k, true) } else { m });
  w.uses.fold(Map::new(), |g: Map<Int, Bool>, u: Use|
    match u.does {
      Consumes(o) -> blocks(g, o, false),
      PassesOn(o) -> blocks(g, o, false),
      Returns(o) -> blocks(g, o, false),
      Sets(x) -> blocks(g, x.of, false),
      Jumps(j) -> blocks(g, j.of, true),
    })
}

pub fn with_stack_blocks(f: Function, look: Map<RootName, OwnershipSignature>) -> Function = {
  let s = {
    signatures: look,
    generics: generics_of(f),
    definition: root_name(f.key),
    group: f.members.map(|m: Member| root_name(m.key)),
    framed: Map::new(),
  };
  {
    ..f,
    body: block_with_stack_blocks(f.body, capped(f.body, stack_placed_walk(s, f).framed)),
    lambdas: f.lambdas.map(|l: Lambda|
      match l { Closure(c) -> Closure({ ..c, body: with_stack_blocks(c.body, look) }) }),
  }
}

fn block_with_stack_blocks(b: Block, framed: Map<Int, Bool>) -> Block =
  b.map(|i: Instruction|
    match i {
      Let(l) -> match l.value {
        Allocate(m) -> if framed.contains(l.var.id) {
          Let({ ..l, value: Allocate({ ..m, made: StackAllocation(m.made) }) })
        } else { i },
        _ -> i,
      },
      If(x) ->
        If({
          ..x,
          then: block_with_stack_blocks(x.then, framed),
          otherwise: block_with_stack_blocks(x.otherwise, framed),
        }),
      Case(c) ->
        Case({
          ..c,
          arms: c.arms.map(|a: { when: Int, body: Block }|
            { when: a.when, body: block_with_stack_blocks(a.body, framed) }),
          rest: block_with_stack_blocks(c.rest, framed),
        }),
      Match(m) ->
        Match({
          arms: m.arms.map(|a: Block| block_with_stack_blocks(a, framed)),
          rest: block_with_stack_blocks(m.rest, framed),
        }),
      Loop(l) -> Loop({ ..l, body: block_with_stack_blocks(l.body, framed) }),
      Handle(h) -> Handle({ ..h, body: block_with_stack_blocks(h.body, framed) }),
      _ -> i,
    })

fn consumed_in(
  h: OwnershipSignature,
  look: Map<RootName, OwnershipSignature>,
  reps: Map<RootName, List<Representation>>,
  own: List<Representation>,
  w: Walk,
) -> ConsumedParams =
  w.uses.fold({ own: Map::new(), jumped: [] }, |g: ConsumedParams, u: Use|
    match u.does {
      Consumes(o) -> { ..g, own: wholes(g.own, o, u.at) },
      PassesOn(o) -> { ..g, own: parts(g.own, o, u.at) },
      Jumps(j) -> {
        let borrowed_there = match look.get(j.to) {
          Some(t) -> t.params.at(j.param) == Some(BorrowedParam),
          None -> false,
        };
        let pointed = match reps.get(j.to) {
          Some(rs) -> match rs.at(j.param) { Some(r) -> passing(r) == ByReference, None -> false },
          None -> false,
        };
        let pointable = j.of.sources.len() > 0
          && j.of.sources.all(|k: Int, whole: Bool|
            whole && (match own.at(k) { Some(r) -> passing(r) == ByReference, None -> false }));
        if !borrowed_there { if j.counts { { ..g, own: wholes(g.own, j.of, u.at) } } else { g } }
        else if (j.counts
            && (j.of.fresh || j.of.sources.keys().any(|k: Int| h.params.at(k) == Some(OwnedParam))))
            || (pointed && !pointable) {
          { ..g, jumped: g.jumped.push({ to: j.to, param: j.param, at: u.at }) }
        } else { g }
      },
      Returns(o) -> if h.result == OwnedResult { { ..g, own: wholes(g.own, o, u.at) } } else { g },
      Sets(x) -> if owned_join(w, x.join) { { ..g, own: wholes(g.own, x.of, u.at) } } else { g },
    })

fn resolved(
  m: InferenceTarget,
  current: InferredOwnership,
  w: Walk,
  gone: Map<Int, Span>,
) -> InferredOwnership = {
  let n = declared_arity(m.member.params);
  let given = |k: Int|
    !m.borrowed.contains(k)
      && (current.signature.params.at(k) == Some(OwnedParam) || gone.contains(k));
  let params = range(0, n).map(|k: Int| if given(k) { OwnedParam } else { BorrowedParam });
  let result = if current.signature.result == OwnedResult {
    { returned: OwnedResult, at: current.reason.result }
  } else { result_ownership_of(w.uses, params) };
  {
    signature: { params: params, result: result.returned },
    reason: {
      params: range(0, n).map(|k: Int|
        if !given(k) { None } else {
          match current.reason.params.at(k) { Some(Some(at)) -> Some(at), _ -> gone.get(k) }
        }),
      result: result.at,
    },
  }
}

fn result_ownership_of(
  uses: List<Use>,
  params: List<ParamOwnership>,
) -> { returned: ResultOwnership, at: Option<Span> } =
  match uses.fold(Ok(Map::new()), |accumulator: Result<Map<Int, Bool>, Span>, u: Use|
      match accumulator {
        Err(_) -> accumulator,
        Ok(m) -> match u.does {
          Returns(o) -> if o.fresh
              || o.sources.keys().any(|k: Int| params.at(k) != Some(BorrowedParam)) { Err(u.at) }
          else { Ok(bases_with(m, o)) },
          _ -> accumulator,
        },
      }) {
    Err(at) -> { returned: OwnedResult, at: Some(at) },
    Ok(m) ->
      {
        returned: BorrowedResult(
          m.fold([], |accumulator: List<{ param: Int, whole: Bool }>, k: Int, whole: Bool|
            accumulator.push({ param: k, whole: whole })),
        ),
        at: None,
      },
  }

fn owned_join(w: Walk, j: Int) -> Bool = match w.origins.get(j) { Some(o) -> o.fresh, None -> true }

fn wholes(g: Map<Int, Span>, o: Origin, at: Span) -> Map<Int, Span> =
  o.sources.fold(g, |accumulator: Map<Int, Span>, k: Int, whole: Bool|
    if whole { first_at(accumulator, k, at) } else { accumulator })

fn parts(g: Map<Int, Span>, o: Origin, at: Span) -> Map<Int, Span> =
  o.sources.fold(g, |accumulator: Map<Int, Span>, k: Int, _: Bool| first_at(accumulator, k, at))

fn first_at(g: Map<Int, Span>, k: Int, at: Span) -> Map<Int, Span> =
  if g.contains(k) { g } else { g.insert(k, at) }

fn no_origin() -> Origin = { sources: Map::new(), fresh: false }

fn fresh_origin() -> Origin = { sources: Map::new(), fresh: true }

fn bases_with(m: Map<Int, Bool>, o: Origin) -> Map<Int, Bool> =
  o.sources.fold(m, |accumulator: Map<Int, Bool>, k: Int, whole: Bool|
    accumulator.insert(k, whole || accumulator.get(k) == Some(true)))

fn union(a: Origin, b: Origin) -> Origin =
  { sources: bases_with(a.sources, b), fresh: a.fresh || b.fresh }

fn read_out(o: Origin) -> Origin =
  {
    sources: o.sources.fold(Map::new(), |m: Map<Int, Bool>, k: Int, _: Bool| m.insert(k, false)),
    fresh: o.fresh,
  }

fn borrowed_out(o: Origin) -> Origin =
  {
    sources: o.sources.fold(Map::new(), |m: Map<Int, Bool>, k: Int, whole: Bool|
      m.insert(k, k < 0 && whole)),
    fresh: o.fresh,
  }

fn origin_of(w: Walk, v: Variable) -> Origin =
  match w.origins.get(v.id) {
    Some(o) -> o,
    None -> if is_refcounted(v.representation) { fresh_origin() } else { no_origin() },
  }

fn arg_origin(w: Walk, a: Arg) -> Origin =
  match a { VariableOperand(v) -> origin_of(w, v), _ -> no_origin() }

fn defined(w: Walk, v: Variable, o: Origin) -> Walk =
  if is_refcounted(v.representation) || passing(v.representation) == ByReference {
    { ..w, origins: w.origins.insert(v.id, o) }
  } else { w }

fn used(w: Walk, d: Action) -> Walk = { ..w, uses: w.uses.push({ does: d, at: w.at }) }

fn consumed(w: Walk, a: Arg) -> Walk =
  if is_refcounted(operand_representation(a)) { used(w, Consumes(arg_origin(w, a))) } else { w }

fn taken(w: Walk, operands: List<{ arg: Arg, takes: Bool }>) -> Walk =
  operands.fold(w, |accumulator: Walk, o: { arg: Arg, takes: Bool }|
    if o.takes { consumed(accumulator, o.arg) } else { accumulator })

fn passed_owned(w: Walk, a: Arg) -> Walk =
  if is_refcounted(operand_representation(a)) { used(w, PassesOn(arg_origin(w, a))) } else { w }

fn passed_owned_operands(w: Walk, operands: List<{ arg: Arg, takes: Bool }>) -> Walk =
  operands.fold(w, |accumulator: Walk, o: { arg: Arg, takes: Bool }|
    if o.takes { passed_owned(accumulator, o.arg) } else { accumulator })

fn jumped(w: Walk, to: RootName, args: List<Arg>) -> Walk =
  range(0, args.len()).fold(w, |a: Walk, k: Int|
    match args.at(k) {
      Some(x) ->
        used(
          a,
          Jumps({
            to: to,
            param: k,
            of: arg_origin(a, x),
            counts: is_refcounted(operand_representation(x)),
          }),
        ),
      None -> a,
    })

fn walk_block(s: WalkContext, w: Walk, b: Block) -> Walk =
  b.fold(w, |accumulator: Walk, i: Instruction|
    match i {
      Let(l) -> {
        let v = walk_value(s, { ..accumulator, at: l.at }, l.value, Some(l.var));
        defined(v.walk, l.var, v.origin)
      },
      Do(d) -> walk_value(s, { ..accumulator, at: d.at }, d.value, None).walk,
      Declaration(v) -> defined(accumulator, v, no_origin()),
      Assign(x) -> {
        let o = match x.arg {
          VariableOperand(_) -> arg_origin(accumulator, x.arg),
          _ -> if is_refcounted(operand_representation(x.arg)) { fresh_origin() }
          else { no_origin() },
        };
        let set = defined(accumulator, x.var, union(origin_of(accumulator, x.var), o));
        if is_refcounted(x.var.representation) { used(set, Sets({ join: x.var.id, of: o })) }
        else { set }
      },
      If(x) ->
        placed(
          walk_block(s, placed(walk_block(s, accumulator, x.then), accumulator.at), x.otherwise),
          accumulator.at,
        ),
      Case(c) ->
        placed(
          c.arms.fold(
            walk_block(s, accumulator, c.rest),
            |a: Walk, arm: { when: Int, body: Block }|
              walk_block(s, placed(a, accumulator.at), arm.body),
          ),
          accumulator.at,
        ),
      Match(m) ->
        placed(
          m.arms.fold(walk_block(s, accumulator, m.rest), |a: Walk, arm: Block|
            walk_block(s, placed(a, accumulator.at), arm)),
          accumulator.at,
        ),
      Loop(l) -> {
        let looping = l.state.fold(
          carried_inits(l.state).fold(accumulator, consumed),
          |a: Walk, c: LoopVariable| defined(a, c.var, fresh_origin()),
        );
        defined(placed(walk_block(s, looping, l.body), accumulator.at), l.result, fresh_origin())
      },
      Next(args) -> args.fold(accumulator, consumed),
      Done(a) -> consumed(accumulator, a),
      Return(a) -> if is_refcounted(operand_representation(a)) {
        used(accumulator, Returns(arg_origin(accumulator, a)))
      } else { accumulator },
      Restart(args) -> jumped(accumulator, s.definition, args),
      Jump(e) -> match s.group.at(e.member) {
        Some(to) -> jumped(accumulator, to, e.args),
        None -> e.args.fold(accumulator, consumed),
      },
      Handle(h) ->
        defined(
          placed(
            walk_block(s, taken(accumulator, by_signature(h.args, h.uses)), h.body),
            accumulator.at,
          ),
          h.result,
          fresh_origin(),
        ),
      _ -> accumulator,
    })

fn placed(w: Walk, at: Span) -> Walk = { ..w, at: at }

fn walk_value(
  s: WalkContext,
  w: Walk,
  value: Rvalue,
  bound: Option<Variable>,
) -> { walk: Walk, origin: Origin } = {
  let v = walk_value_origin(s, w, value, bound);
  { ..v, walk: borrowed_from_blocks(blocks_taken(v.walk, w, value), value, bound, v.origin) }
}

fn borrowed_from_blocks(w: Walk, value: Rvalue, bound: Option<Variable>, o: Origin) -> Walk = {
  let borrows = match value { Allocate(_) -> false, _ -> true };
  let counts = match bound { Some(v) -> is_refcounted(v.representation), None -> false };
  let blocks = o.sources.fold(Map::new(), |m: Map<Int, Bool>, k: Int, _: Bool|
    if k < 0 { m.insert(k, true) } else { m });
  if !borrows || !counts || blocks.len() == 0 { w }
  else { used(w, Consumes({ sources: blocks, fresh: false })) }
}

fn blocks_taken(after: Walk, before: Walk, value: Rvalue) -> Walk =
  match value {
    Call(_) -> after,
    Apply(_) -> after,
    Allocate(_) -> after,
    _ ->
      operands(value).fold(after, |a: Walk, o: { arg: Arg, takes: Bool }|
        if !o.takes { a } else {
          let blocks = arg_origin(before, o.arg).sources.fold(
            Map::new(),
            |m: Map<Int, Bool>, k: Int, whole: Bool|
              if k < 0 && whole { m.insert(k, true) } else { m },
          );
          if blocks.len() == 0 { a } else { used(a, Consumes({ sources: blocks, fresh: false })) }
        }),
  }

fn walk_value_origin(
  s: WalkContext,
  w: Walk,
  value: Rvalue,
  bound: Option<Variable>,
) -> { walk: Walk, origin: Origin } =
  match value {
    Primitive(_) -> { walk: w, origin: fresh_origin() },
    Literal(_) -> { walk: w, origin: fresh_origin() },
    Static(_) -> { walk: w, origin: no_origin() },
    Tag(_) -> { walk: w, origin: no_origin() },
    Allocate(m) -> {
      let framed = base_allocation(m.made) != m.made
        || (match bound { Some(to) -> s.framed.contains(to.id), None -> false });
      let stored = if framed {
        m.args.fold(w, |a: Walk, x: Arg| {
          let o = arg_origin(w, x);
          let blocks = o.sources.fold(Map::new(), |b: Map<Int, Bool>, k: Int, whole: Bool|
            if k < 0 { b.insert(k, whole) } else { b });
          if blocks.len() == 0 { a } else { used(a, Consumes({ sources: blocks, fresh: false })) }
        })
      } else { taken(w, operands(value)) };
      {
        walk: match bound {
          Some(to) -> match m.made {
            ClosureAllocation(_) ->
              {
                ..stored,
                captured: stored.captured.insert(to.id, m.args.map(|x: Arg| arg_origin(w, x))),
              },
            _ -> stored,
          },
          None -> stored,
        },
        origin: match bound {
          Some(to) -> if s.framed.contains(to.id) {
            { sources: Map::new().insert(block_base(to.id), true), fresh: false }
          } else { fresh_origin() },
          None -> fresh_origin(),
        },
      }
    },
    Get(g) ->
      {
        walk: w,
        origin: match g.path {
          LeafPath(_) -> origin_of(w, g.of),
          CapturePath(k) -> match w.captured.get(g.of.id) {
            Some(cs) -> match cs.at(k) { Some(o) -> o, None -> read_out(origin_of(w, g.of)) },
            None -> read_out(origin_of(w, g.of)),
          },
          _ -> match bound {
            Some(y) -> if payload_of(value, y) != None { origin_of(w, g.of) }
            else { read_out(origin_of(w, g.of)) },
            None -> read_out(origin_of(w, g.of)),
          },
        },
      },
    Take(t) -> { walk: w, origin: read_out(origin_of(w, t.of)) },
    Convert(p) -> match shared_count_variable(bound, value) {
      Some(x) -> { walk: w, origin: origin_of(w, x) },
      None -> if is_unboxing(p.arg, p.to) { { walk: w, origin: read_out(arg_origin(w, p.arg)) } }
      else if operands(value).any(|o: { arg: Arg, takes: Bool }| o.takes) {
        { walk: consumed(w, p.arg), origin: fresh_origin() }
      } else { { walk: w, origin: no_origin() } },
    },
    Aggregate(g) -> match shared_count_variable(bound, value) {
      Some(x) -> { walk: w, origin: origin_of(w, x) },
      None ->
        {
          walk: taken(w, operands(value)),
          origin: if g.parts.any(|a: Arg| is_refcounted(operand_representation(a))) {
            fresh_origin()
          } else { no_origin() },
        },
    },
    Call(c) -> {
      let h = signature_at(s.signatures, s.generics, c.callee, c.args.len());
      {
        walk: range(0, c.args.len()).fold(w, |a: Walk, k: Int|
          if h.params.at(k) == Some(BorrowedParam) { a }
          else { match c.args.at(k) { Some(x) -> passed_owned(a, x), None -> a } }),
        origin: match h.result {
          OwnedResult -> fresh_origin(),
          BorrowedResult(from) ->
            from.fold(no_origin(), |o: Origin, x: { param: Int, whole: Bool }|
              match c.args.at(x.param) {
                Some(a) ->
                  union(o, if x.whole { arg_origin(w, a) } else { borrowed_out(arg_origin(w, a)) }),
                None -> o,
              }),
        },
      }
    },
    Update(_) -> { walk: taken(w, operands(value)), origin: fresh_origin() },
    Apply(_) -> { walk: passed_owned_operands(w, operands(value).drop(1)), origin: fresh_origin() },
    Native(n) ->
      { walk: passed_owned_operands(w, operands(value)), origin: result_origin(w, n.args, n.uses) },
    OperationCall(o) ->
      { walk: passed_owned_operands(w, operands(value)), origin: result_origin(w, o.args, o.uses) },
    IfUnique(x) -> { walk: taken(w, operands(value)), origin: arg_origin(w, VariableOperand(x)) },
    WalkLoop(x) ->
      {
        walk: taken(w, operands(value)),
        origin: if x.operation == Share { no_origin() } else { fresh_origin() },
      },
    OperandsOnly(_) -> { walk: taken(w, operands(value)), origin: fresh_origin() },
  }

fn shared_count_variable(bound: Option<Variable>, value: Rvalue) -> Option<Variable> =
  match bound { Some(y) -> count_shared_with(y, value), None -> None }

fn result_origin(w: Walk, args: List<Arg>, uses: OperationSignature) -> Origin =
  if uses.owned { fresh_origin() }
  else { match args.at(0) { Some(a) -> borrowed_out(arg_origin(w, a)), None -> no_origin() } }

fn signature_at(
  look: Map<RootName, OwnershipSignature>,
  generics: List<RootName>,
  c: Callee,
  arity: Int,
) -> OwnershipSignature =
  match callee_definition(generics, c) {
    Some(d) -> match look.get(d) { Some(h) -> h, None -> all_owned(arity) },
    None -> match c {
      Root(k) -> match k {
        Generated(x, _) -> generated_signature(x.operation, arity),
        _ -> all_owned(arity),
      },
      Generic(_) -> all_owned(arity),
    },
  }

pub fn generated_signature(operation: TypeOperation, arity: Int) -> OwnershipSignature =
  {
    params: range(0, arity).map(|k: Int|
      if reads(operation, k) { BorrowedParam } else { OwnedParam }),
    result: OwnedResult,
  }

fn reads(operation: TypeOperation, k: Int) -> Bool =
  match operation {
    Equal -> true,
    Order -> true,
    NumericFunction(_) -> true,
    Reflect -> true,
    Show -> true,
    Digest -> true,
    Lower -> true,
    Share -> true,
    Keep -> true,
    Dup -> true,
    ReleaseResource -> true,
    ContainerWalk(c) -> container_reads_argument(c, k),
    OnCase(c) -> reads(c.operation, k),
    OnWordForm(w) -> reads(w, k),
    Unboxed(h) -> reads(h, k),
    _ -> false,
  }

fn callee_definition(generics: List<RootName>, c: Callee) -> Option<RootName> =
  match c { Root(k) -> key_definition(k), Generic(i) -> generics.at(i) }

fn called(l: InferenceTarget) -> List<RootName> =
  calls_in(generics_of(l.member), l.group, l.member.body)

fn calls_in(generics: List<RootName>, accumulator: List<RootName>, b: Block) -> List<RootName> =
  values_folded(b, accumulator, |a: List<RootName>, v: Rvalue| call_named(generics, a, v))

fn values_folded<s>(b: Block, accumulator: s, on: (s, Rvalue) -> s) -> s =
  b.fold(accumulator, |a: s, i: Instruction|
    match i {
      Let(l) -> on(a, l.value),
      Do(d) -> on(a, d.value),
      If(x) -> values_folded(x.otherwise, values_folded(x.then, a, on), on),
      Case(c) ->
        c.arms.fold(values_folded(c.rest, a, on), |n: s, arm: { when: Int, body: Block }|
          values_folded(arm.body, n, on)),
      Match(m) ->
        m.arms.fold(values_folded(m.rest, a, on), |n: s, arm: Block| values_folded(arm, n, on)),
      Loop(l) -> values_folded(l.body, a, on),
      Handle(h) -> values_folded(h.body, a, on),
      _ -> a,
    })

fn assumed_in(
  f: Function,
  generics: List<RootName>,
  signatures: Map<RootName, OwnershipSignature>,
  outside: (RootName) -> Bool,
) -> List<PublishedSignature> = {
  let added = |a: List<PublishedSignature>, p: PublishedSignature|
    if a.any(|x: PublishedSignature| x.definition == p.definition) { a } else { a.push(p) };
  let own = values_folded(f.body, [], |a: List<PublishedSignature>, v: Rvalue|
    match v {
      Call(c) -> match callee_definition(generics, c.callee) {
        Some(d) -> if !outside(d) { a } else {
          added(a, published_of(d, signature_at(signatures, generics, c.callee, c.args.len())))
        },
        None -> a,
      },
      _ -> a,
    });
  f.lambdas.fold(own, |a: List<PublishedSignature>, l: Lambda|
    match l { Closure(c) -> assumed_in(c.body, generics, signatures, outside).fold(a, added) })
}

pub fn published_of(definition: RootName, h: OwnershipSignature) -> PublishedSignature =
  {
    definition: definition,
    borrowed: h.params.map(|p: ParamOwnership| p == BorrowedParam),
    borrowed_from: match h.result { OwnedResult -> None, BorrowedResult(from) -> Some(from) },
  }

pub fn signatures_from(ps: List<PublishedSignature>) -> Map<RootName, OwnershipSignature> =
  ps.fold(Map::new(), |m: Map<RootName, OwnershipSignature>, p: PublishedSignature|
    m.insert(p.definition, {
      params: p.borrowed.map(|l: Bool| if l { BorrowedParam } else { OwnedParam }),
      result: match p.borrowed_from { None -> OwnedResult, Some(from) -> BorrowedResult(from) },
    }))

pub type InferredFunction = {
  form: Function,
  own_signatures: List<PublishedSignature>,
  assumed: List<PublishedSignature>,
  group: List<RootKey>,
}

pub fn inferred_function(f: Function, s: InferenceResult) -> InferredFunction / {abort.raise} = {
  let borrowed = with_stack_blocks(with_conventions(f, s.signatures), s.signatures);
  let own = if borrowed.members.len() == 0 {
    [{ key: borrowed.key, convention: borrowed.convention }]
  } else { borrowed.members.map(|m: Member| { key: m.key, convention: m.convention }) };
  let definitions = own.fold(
    [],
    |accumulator: List<RootKey>, o: { key: RootKey, convention: Convention }|
      match signature_name(o.key) { Some(_) -> accumulator.push(o.key), None -> accumulator },
  );
  let group = definitions.fold(definitions, |accumulator: List<RootKey>, d: RootKey|
    match s.groups.get(root_name(d)) {
      Some(g) ->
        g.fold(accumulator, |a: List<RootKey>, x: RootKey|
          if a.contains(x) { a } else { a.push(x) }),
      None -> accumulator,
    });
  let inside = group.map(root_name);
  let specialised = own.fold(
    [],
    |accumulator: List<PublishedSignature>, o: { key: RootKey, convention: Convention }|
      match o.key {
        Specialisation(_, _) -> {
          let d = root_name(unspecialised(o.key));
          accumulator.push(
            published_of(d, match s.signatures.get(d) {
              Some(h) -> h,
              None -> all_owned(o.convention.params.len()),
            }),
          )
        },
        _ -> accumulator,
      },
  );
  {
    form: borrowed,
    own_signatures: definitions.fold([], |accumulator: List<PublishedSignature>, d: RootKey| {
      let n = root_name(d);
      match s.signatures.get(n) {
        Some(h) -> accumulator.push(published_of(n, h)),
        None -> accumulator,
      }
    }),
    assumed: assumed_in(borrowed, generics_of(borrowed), s.signatures, |d: RootName|
      !inside.contains(d)).fold(
      specialised,
      |a: List<PublishedSignature>, p: PublishedSignature|
        if a.any(|x: PublishedSignature| x.definition == p.definition) { a } else { a.push(p) },
    ),
    group: if group.len() > definitions.len() { group } else { [] },
  }
}

fn call_named(generics: List<RootName>, a: List<RootName>, v: Rvalue) -> List<RootName> =
  match v {
    Call(c) -> match callee_definition(generics, c.callee) {
      Some(d) -> if a.contains(d) { a } else { a.push(d) },
      None -> a,
    },
    _ -> a,
  }

fn of_type(id: Int, ty: Bytes, rep: Representation) -> Variable =
  { id: id, ty: NamedType({ name: ty, args: [] }), representation: rep }

fn string_variable(id: Int) -> Variable = of_type(id, b"String", AsWord)

fn tree(id: Int) -> Variable = of_type(id, b"m.Tree", AsWord)

fn int(id: Int) -> Variable = of_type(id, b"Int", AsInt)

fn bool_variable(id: Int) -> Variable = of_type(id, b"Bool", AsBool)

fn owned_convention(params: List<Variable>, result: Representation) -> Convention =
  {
    params: owned_params(params.map(|p: Variable| p.representation)),
    result: result,
    destination_passing: false,
    returned: OwnedResult,
  }

fn definition_of(
  name: Bytes,
  params: List<Variable>,
  result: Representation,
  body: Block,
) -> InferenceTarget = {
  let f = {
    key: Named(qualify(b"m", name)),
    kind: Metered,
    params: params,
    convention: owned_convention(params, result),
    result_type: NamedType({ name: b"T", args: [] }),
    body: body,
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  };
  { definition: of_m(name), member: f, group: [], borrowed: [], enclosing: f }
}

fn of_m(name: Bytes) -> RootName = root_name(Named(qualify(b"m", name)))

fn call_of(name: Bytes, args: List<Arg>) -> Rvalue =
  Call({
    callee: Root(Named(qualify(b"m", name))),
    args: args,
    convention: {
      params: owned_params(args.map(operand_representation)),
      result: AsWord,
      destination_passing: false,
      returned: OwnedResult,
    },
    suspends: false,
  })

fn resolved_with(
  group: List<InferenceTarget>,
  published: List<{ name: Bytes, signature: OwnershipSignature }>,
) -> List<OwnershipSignature> / {abort.raise} =
  signatures_of(
    group_signatures(
      group,
      published.fold(
        Map::new(),
        |m: Map<RootName, OwnershipSignature>, p: { name: Bytes, signature: OwnershipSignature }|
          m.insert(of_m(p.name), p.signature),
      ),
    ),
  )

fn infer_group_signatures(
  group: List<InferenceTarget>,
) -> List<OwnershipSignature> / {abort.raise} = resolved_with(group, [])

fn made_of(fresh_origin: Allocation, args: List<Arg>) -> Rvalue =
  Allocate({ made: fresh_origin, args: args, reuse: None })

test "a recursive walk that only reads its two parameters infers both as borrowed" {
  let a = string_variable(0);
  let t = tree(1);
  let l = tree(2);
  let r = tree(3);
  let x = int(4);
  let y = int(5);
  let z = int(6);
  let walk = definition_of(b"walk", [a, t], AsInt, [
    Case({
      on: t,
      test: TagTest([b"m.Leaf", b"m.Node"]),
      arms: [
        {
          when: 1,
          body: [
            bind(l, Get({ of: t, path: ArgumentPath({ constructor: b"m.Node", at: 0 }) })),
            bind(r, Get({ of: t, path: ArgumentPath({ constructor: b"m.Node", at: 1 }) })),
            bind(x, call_of(b"walk", [VariableOperand(a), VariableOperand(l)])),
            bind(y, call_of(b"walk", [VariableOperand(a), VariableOperand(r)])),
            bind(
              z,
              Primitive({
                operation: b"add",
                on: AsInt,
                args: [VariableOperand(x), VariableOperand(y)],
              }),
            ),
            Return(VariableOperand(z)),
          ],
        },
      ],
      rest: [Return(IntOperand(0))],
    }),
  ]);
  assert_eq(infer_group_signatures([walk]), [
    { params: [BorrowedParam, BorrowedParam], result: OwnedResult },
  ])
}

test "a parameter that is stored, updated in place, passed to an effect operation or to a function that takes ownership, or captured by an escaping closure is inferred as owned" {
  let s = string_variable(0);
  let r = string_variable(1);
  let by = |value: Rvalue|
    infer_group_signatures([
      definition_of(b"f", [s], AsWord, [bind(r, value), Return(VariableOperand(r))]),
    ]);
  let gives = [{ params: [OwnedParam], result: OwnedResult }];
  assert_eq(
    by(made_of(CaseAllocation({ case: 0, skip: 0, words: 1 }), [VariableOperand(s)])),
    gives,
  );
  assert_eq(
    by(
      Native({
        name: b"rt_push",
        args: [VariableOperand(s), IntOperand(1)],
        uses: { takes: [true, false], owned: true, fails: true, suspends: false },
      }),
    ),
    gives,
  );
  assert_eq(
    by(
      OperationCall({
        operation: OfHandling(
          Perform({
            effect: b"m.log",
            operation: b"put",
            index: 0,
            resource: b"",
            labelled: false,
            mode: 1,
            descriptor: b"ply_k_put",
          }),
        ),
        args: [VariableOperand(s)],
        uses: { takes: [true], owned: true, fails: true, suspends: true },
      }),
    ),
    gives,
  );
  assert_eq(by(call_of(b"keep", [VariableOperand(s)])), gives);
  assert_eq(
    by(made_of(ClosureAllocation({ nth: 0, captures: 1, params: 1 }), [VariableOperand(s)])),
    gives,
  );
  assert_eq(
    resolved_with(
      [
        definition_of(b"f", [s], AsWord, [
          bind(r, call_of(b"look", [VariableOperand(s)])),
          Return(VariableOperand(r)),
        ]),
      ],
      [{ name: b"look", signature: { params: [BorrowedParam], result: OwnedResult } }],
    ),
    [{ params: [BorrowedParam], result: OwnedResult }],
  )
}

test "ownership inference reports the source span of the first use that made each parameter owned, and the span of the use that made the result owned" {
  let s = string_variable(0);
  let q = string_variable(1);
  let r = string_variable(2);
  let k = string_variable(3);
  let at = |v: Variable, value: Rvalue, from: Int, to: Int|
    Let({ var: v, value: value, at: span_between(from, to), unwind: [] });
  let got = group_signatures(
    [
      definition_of(b"f", [s, q], AsWord, [
        at(r, call_of(b"look", [VariableOperand(q)]), 10, 14),
        at(k, made_of(ListAllocation(2), [VariableOperand(s), VariableOperand(r)]), 20, 25),
        Return(VariableOperand(k)),
      ]),
    ],
    Map::new().insert(of_m(b"look"), { params: [BorrowedParam], result: OwnedResult }),
  );
  assert_eq(got.map(|x: InferredOwnership| x.signature), [
    { params: [OwnedParam, BorrowedParam], result: OwnedResult },
  ]);
  assert_eq(got.map(|x: InferredOwnership| x.reason), [
    { params: [Some(span_between(20, 25)), None], result: Some(span_between(20, 25)) },
  ])
}

test "a closure allocated on the stack is passed to a call as a borrowed value, whatever its body does with its captured variables" {
  let s = string_variable(0);
  let k = string_variable(1);
  let r = int(2);
  let c = string_variable(0);
  let x = int(1);
  let with_body = |result: Representation, body: Block| {
    let f = definition_of(b"f", [s], AsInt, [
      bind(
        k,
        made_of(StackAllocation(ClosureAllocation({ nth: 0, captures: 1, params: 1 })), [
          VariableOperand(s),
        ]),
      ),
      bind(r, call_of(b"each", [VariableOperand(k)])),
      Return(VariableOperand(r)),
    ]);
    let lambda = {
      key: Named(b"m.f"),
      kind: Metered,
      params: [c, x],
      convention: owned_convention([c, x], result),
      result_type: NamedType({ name: b"T", args: [] }),
      body: body,
      lambdas: [],
      base: 0,
      members: [],
      links: no_links(),
      statics: [],
    };
    resolved_with(
      [
        {
          ..f,
          member: {
            ..f.member,
            lambdas: [
              Closure({
                body: lambda,
                captures: 1,
                at: dummy_span(),
                words: no_closure_evidence(),
              }),
            ],
          },
        },
      ],
      [{ name: b"each", signature: { params: [BorrowedParam], result: OwnedResult } }],
    )
  };
  assert_eq(with_body(AsInt, [Return(IntOperand(0))]), [
    { params: [BorrowedParam], result: OwnedResult },
  ]);
  assert_eq(with_body(AsWord, [Return(VariableOperand(c))]), [
    { params: [BorrowedParam], result: OwnedResult },
  ])
}

test "a constructor built from the fields of a matched list parameter makes that parameter owned" {
  let list = AsSum({
    layout: {
      classes: [layout::Pointer],
      cases: [
        { test: layout::WordIs({ at: 0, value: 0 }), payload: layout::Nullary },
        {
          test: layout::WordOutside({ at: 0, values: [0] }),
          payload: layout::Boxed({
            at: 0,
            stripped: false,
            skip: 0,
            layout: PlainWords([layout::Pointer, layout::Pointer]),
          }),
        },
      ],
    },
    cases: [b"m.Nil", b"m.Cons"],
  });
  let xs = of_type(0, b"m.L", list);
  let v = string_variable(1);
  let t = of_type(2, b"m.L", list);
  let box = of_type(3, b"m.L", AsWord);
  let n = of_type(4, b"m.L", list);
  let rebuilt = |names: List<Bytes>|
    definition_of(b"cons", [xs, v], list, [
      Case({
        on: xs,
        test: TagTest(names),
        arms: [
          {
            when: 0,
            body: [
              bind(t, Get({ of: xs, path: CasePath({ case: 1, at: 1 }) })),
              bind(
                box,
                made_of(CaseAllocation({ case: 1, skip: 0, words: 2 }), [
                  VariableOperand(v),
                  VariableOperand(t),
                ]),
              ),
              bind(n, Aggregate({ parts: [IntOperand(1), VariableOperand(box)] })),
              Return(VariableOperand(n)),
            ],
          },
        ],
        rest: [Return(ZeroOperand(list))],
      }),
    ]);
  assert_eq(infer_group_signatures([rebuilt([b"m.Cons", b"m.Nil"])]), [
    { params: [OwnedParam, OwnedParam], result: OwnedResult },
  ]);
  assert_eq(reset_params(rebuilt([b"m.Cons", b"m.Nil"])).keys(), [0]);
  assert_eq(infer_group_signatures([rebuilt([b"m.Nil", b"m.Cons"])]), [
    { params: [BorrowedParam, OwnedParam], result: OwnedResult },
  ]);
  assert_eq(reset_params(rebuilt([b"m.Nil", b"m.Cons"])).keys(), []);
  let from_every = |l: InferenceTarget|
    signatures_of(inferred_from([l], Map::new(), [reset_params(l)]));
  assert_eq(
    infer_group_signatures([rebuilt([b"m.Cons", b"m.Nil"])]),
    from_every(rebuilt([b"m.Cons", b"m.Nil"])),
  );
  assert_eq(
    infer_group_signatures([rebuilt([b"m.Nil", b"m.Cons"])]),
    from_every(rebuilt([b"m.Nil", b"m.Cons"])),
  )
}

test "a function that loops by restarting itself keeps a parameter borrowed when each restart passes only borrowed values" {
  let p = string_variable(0);
  let q = string_variable(1);
  let n = int(2);
  let stop = bool_variable(3);
  let m = int(4);
  let x = string_variable(5);
  let go = |before: Block, args: List<Arg>|
    infer_group_signatures([
      definition_of(b"go", [p, q, n], AsInt, [
        bind(
          stop,
          Primitive({ operation: b"le", on: AsInt, args: [VariableOperand(n), IntOperand(0)] }),
        ),
        If({
          cond: VariableOperand(stop),
          then: [Return(IntOperand(0))],
          otherwise: before.concat([
            bind(
              m,
              Primitive({
                operation: b"sub",
                on: AsInt,
                args: [VariableOperand(n), IntOperand(1)],
              }),
            ),
            Restart(args.push(VariableOperand(m))),
          ]),
        }),
      ]),
    ]);
  let borrows = [{ params: [BorrowedParam, BorrowedParam, BorrowedParam], result: OwnedResult }];
  assert_eq(go([], [VariableOperand(p), VariableOperand(q)]), borrows);
  assert_eq(go([], [VariableOperand(q), VariableOperand(p)]), borrows);
  assert_eq(
    go([bind(x, Get({ of: p, path: FieldPath({ name: b"rest", at: 1 }) }))], [
      VariableOperand(x),
      VariableOperand(q),
    ]),
    borrows,
  );
  assert_eq(go([bind(x, call_of(b"fresh", []))], [VariableOperand(x), VariableOperand(q)]), [
    { params: [OwnedParam, BorrowedParam, BorrowedParam], result: OwnedResult },
  ])
}

test "a record parameter passed by reference stays borrowed across a restart only when the restart passes another record passed by reference" {
  let b = string_variable(2);
  let n = int(3);
  let stop = bool_variable(4);
  let m = int(5);
  let jumps = |wide: Representation| {
    let w = of_type(0, b"m.W", wide);
    let v = of_type(1, b"m.W", wide);
    let x = of_type(6, b"m.W", wide);
    let go = |before: Block, args: List<Arg>|
      match infer_group_signatures([
          definition_of(b"go", [w, v, b, n], AsInt, [
            bind(
              stop,
              Primitive({ operation: b"le", on: AsInt, args: [VariableOperand(n), IntOperand(0)] }),
            ),
            If({
              cond: VariableOperand(stop),
              then: [Return(IntOperand(0))],
              otherwise: before.concat([
                bind(
                  m,
                  Primitive({
                    operation: b"sub",
                    on: AsInt,
                    args: [VariableOperand(n), IntOperand(1)],
                  }),
                ),
                Restart(args.concat([VariableOperand(b), VariableOperand(m)])),
              ]),
            }),
          ]),
        ]).at(
          0,
        ) {
        Some(h) -> h.params,
        None -> [],
      };
    let read = [bind(x, Get({ of: b, path: FieldPath({ name: b"w", at: 0 }) }))];
    [
      go([], [VariableOperand(v), VariableOperand(w)]),
      go(read, [VariableOperand(x), VariableOperand(v)]),
      go(read, [VariableOperand(x), VariableOperand(w)]),
    ]
  };
  let counted_fields = range(0, layout::max_flat_words() + 1).map(|k: Int|
    { name: b"f".concat(ascii_of_int(k)), representation: if k == 0 { AsWord } else { AsInt } });
  assert_eq(jumps(AsFlattened(counted_fields)), [
    [BorrowedParam, BorrowedParam, BorrowedParam, BorrowedParam],
    [OwnedParam, BorrowedParam, BorrowedParam, BorrowedParam],
    [OwnedParam, OwnedParam, BorrowedParam, BorrowedParam],
  ]);
  let scalars = range(0, layout::max_flat_words() + 1).map(|_: Int| layout::any_integer());
  let words = AsSum({
    layout: {
      classes: scalars,
      cases: [
        {
          test: Always,
          payload: Inline({ offset: 0, layout: PlainWords(scalars), stripped: None }),
        },
      ],
    },
    cases: [b"m.W"],
  });
  assert_eq(jumps(words), [
    [BorrowedParam, BorrowedParam, BorrowedParam, BorrowedParam],
    [OwnedParam, BorrowedParam, BorrowedParam, BorrowedParam],
    [OwnedParam, BorrowedParam, BorrowedParam, BorrowedParam],
  ])
}

test "in a recursion group, a parameter passed between members is borrowed, and becomes owned once any member stores it" {
  let s = string_variable(0);
  let y = int(1);
  let stored = string_variable(2);
  let passing = |name: Bytes, to: Bytes, stores: Bool|
    definition_of(
      name,
      [s],
      AsInt,
      (if stores {
        [
          bind(
            stored,
            made_of(CaseAllocation({ case: 0, skip: 0, words: 1 }), [VariableOperand(s)]),
          ),
        ]
      } else { [] }).concat([
        bind(y, call_of(to, [VariableOperand(s)])),
        Return(VariableOperand(y)),
      ]),
    );
  let borrows = { params: [BorrowedParam], result: OwnedResult };
  let gives = { params: [OwnedParam], result: OwnedResult };
  assert_eq(
    infer_group_signatures([passing(b"ping", b"pong", false), passing(b"pong", b"ping", false)]),
    [borrows, borrows],
  );
  assert_eq(
    infer_group_signatures([passing(b"ping", b"pong", false), passing(b"pong", b"ping", true)]),
    [gives, gives],
  );
  assert_eq(
    infer_group_signatures([
      passing(b"one", b"two", false),
      passing(b"two", b"three", false),
      passing(b"three", b"one", true),
    ]),
    [gives, gives, gives],
  )
}

test "in a group of tail-calling functions, a parameter that receives a value another member created is owned, and so is the parameter that passes it on" {
  let s = string_variable(0);
  let n = int(1);
  let stop = bool_variable(2);
  let m = int(3);
  let fresh = string_variable(4);
  let member = |name: Bytes, to: Int, makes: Bool|
    {
      ..definition_of(name, [s, n], AsInt, [bind(stop, Primitive({ operation: b"le", on: AsInt, args: [VariableOperand(n), IntOperand(0)] })), If({ cond: VariableOperand(stop), then: [Return(IntOperand(0))], otherwise: (if makes { [bind(fresh, call_of(b"fresh", []))] } else { [] }).concat([bind(m, Primitive({ operation: b"sub", on: AsInt, args: [VariableOperand(n), IntOperand(1)] })), Jump({ member: to, args: [if makes { VariableOperand(fresh) } else { VariableOperand(s) }, VariableOperand(m)] })]) })]),
      group: [b"hop", b"skip"].map(of_m),
    };
  let borrows = { params: [BorrowedParam, BorrowedParam], result: OwnedResult };
  let gives = { params: [OwnedParam, BorrowedParam], result: OwnedResult };
  assert_eq(infer_group_signatures([member(b"hop", 1, false), member(b"skip", 0, false)]), [
    borrows,
    borrows,
  ]);
  assert_eq(infer_group_signatures([member(b"hop", 1, false), member(b"skip", 0, true)]), [
    gives,
    gives,
  ])
}

test "every recursion group is resolved after the groups it calls" {
  let s = string_variable(0);
  let r = string_variable(1);
  let storing = definition_of(b"keeps", [s], AsWord, [
    bind(r, made_of(ListAllocation(1), [VariableOperand(s)])),
    Return(VariableOperand(r)),
  ]);
  let passing = definition_of(b"hands", [s], AsWord, [
    bind(r, call_of(b"keeps", [VariableOperand(s)])),
    Return(VariableOperand(r)),
  ]);
  let signatures = infer_signatures([passing, storing], Map::new(), Map::new()).signatures;
  assert_eq(signatures.get(of_m(b"hands")), Some({ params: [OwnedParam], result: OwnedResult }));
  assert_eq(signatures.get(of_m(b"keeps")), Some({ params: [OwnedParam], result: OwnedResult }))
}

test "a parameter declared borrowed stays borrowed, and a parameter the function stores is inferred as owned" {
  let f = string_variable(0);
  let r = string_variable(1);
  let storing = definition_of(b"f", [f], AsWord, [
    bind(r, made_of(ListAllocation(1), [VariableOperand(f)])),
    Return(VariableOperand(r)),
  ]);
  assert_eq(infer_group_signatures([{ ..storing, borrowed: [0] }]), [
    { params: [BorrowedParam], result: OwnedResult },
  ]);
  assert_eq(infer_group_signatures([storing]), [{ params: [OwnedParam], result: OwnedResult }]);
  let reading = definition_of(b"g", [f], AsInt, [Return(IntOperand(0))]);
  assert_eq(infer_group_signatures([reading]), [{ params: [BorrowedParam], result: OwnedResult }])
}

test "a result read out of a borrowed parameter is borrowed from it, and a result created on any path is owned" {
  let p = string_variable(0);
  let q = string_variable(1);
  let c = bool_variable(2);
  let x = string_variable(3);
  let j = string_variable(4);
  let m = string_variable(5);
  assert_eq(
    infer_group_signatures([
      definition_of(b"name", [p], AsWord, [
        bind(x, Get({ of: p, path: FieldPath({ name: b"name", at: 0 }) })),
        Return(VariableOperand(x)),
      ]),
    ]),
    [{ params: [BorrowedParam], result: BorrowedResult([{ param: 0, whole: false }]) }],
  );
  let pick = |otherwise: Block|
    definition_of(b"pick", [p, q, c], AsWord, [
      Declaration(j),
      If({
        cond: VariableOperand(c),
        then: [Assign({ var: j, arg: VariableOperand(p) })],
        otherwise: otherwise,
      }),
      Return(VariableOperand(j)),
    ]);
  assert_eq(infer_group_signatures([pick([Assign({ var: j, arg: VariableOperand(q) })])]), [
    {
      params: [BorrowedParam, BorrowedParam, BorrowedParam],
      result: BorrowedResult([{ param: 0, whole: true }, { param: 1, whole: true }]),
    },
  ]);
  assert_eq(
    infer_group_signatures([
      pick([bind(m, call_of(b"fresh", [])), Assign({ var: j, arg: VariableOperand(m) })]),
    ]),
    [{ params: [OwnedParam, BorrowedParam, BorrowedParam], result: OwnedResult }],
  );
  let some = |item: Type| {
    let result = option_type(item);
    let o = { id: 6, ty: result, representation: AsWord };
    let l = definition_of(b"some", [x], AsWord, [
      bind(o, Aggregate({ parts: [IntOperand(1), VariableOperand(x)] })),
      Return(VariableOperand(o)),
    ]);
    {
      ..l,
      member: { ..l.member, result_type: result },
      enclosing: { ..l.enclosing, result_type: result },
    }
  };
  assert_eq([string_type(), VariableType(0)].map(|t: Type| infer_group_signatures([some(t)])), [
    [{ params: [BorrowedParam], result: BorrowedResult([{ param: 0, whole: true }]) }],
    [{ params: [OwnedParam], result: OwnedResult }],
  ])
}

test "an item read from a borrowed list is borrowed from that list, so a caller that stores the item only borrows the list" {
  let xs = string_variable(0);
  let i = int(1);
  let x = string_variable(2);
  let ys = string_variable(3);
  let y = string_variable(4);
  let stored = string_variable(5);
  let read = Native({
    name: b"rt_list_at",
    args: [VariableOperand(xs), VariableOperand(i)],
    uses: { takes: [false, false], owned: false, fails: true, suspends: false },
  });
  let item = {
    params: [BorrowedParam, BorrowedParam],
    result: BorrowedResult([{ param: 0, whole: false }]),
  };
  assert_eq(
    infer_group_signatures([
      definition_of(b"at", [xs, i], AsWord, [bind(x, read), Return(VariableOperand(x))]),
    ]),
    [item],
  );
  let storing_caller = |callee: Bytes, callee_signature: OwnershipSignature|
    resolved_with(
      [
        definition_of(b"keep", [ys], AsWord, [
          bind(y, call_of(callee, [VariableOperand(ys), IntOperand(0)])),
          bind(stored, made_of(ListAllocation(1), [VariableOperand(y)])),
          Return(VariableOperand(stored)),
        ]),
      ],
      [{ name: callee, signature: callee_signature }],
    );
  assert_eq(storing_caller(b"at", item), [{ params: [BorrowedParam], result: OwnedResult }]);
  assert_eq(
    storing_caller(b"same", {
      params: [BorrowedParam, BorrowedParam],
      result: BorrowedResult([{ param: 0, whole: true }]),
    }),
    [{ params: [OwnedParam], result: OwnedResult }],
  )
}

test "a function generated for a type borrows the values it only reads, and a generated drop takes ownership of its operand" {
  let p = string_variable(0);
  let q = string_variable(1);
  let same = bool_variable(2);
  let written = |operation: TypeOperation, args: List<Arg>|
    Call({
      callee: Root(keys::generated_key(operation, NamedType({ name: b"m.T", args: [] }), b"m")),
      args: args,
      convention: {
        params: owned_params(args.map(operand_representation)),
        result: AsWord,
        destination_passing: false,
        returned: OwnedResult,
      },
      suspends: false,
    });
  assert_eq(
    infer_group_signatures([
      definition_of(b"same", [p, q], AsBool, [
        bind(same, written(Equal, [VariableOperand(p), VariableOperand(q)])),
        Return(VariableOperand(same)),
      ]),
    ]),
    [{ params: [BorrowedParam, BorrowedParam], result: OwnedResult }],
  );
  assert_eq(
    infer_group_signatures([
      definition_of(b"gone", [p], AsInt, [
        Do({ value: written(Drop, [VariableOperand(p)]), at: dummy_span(), unwind: [] }),
        Return(IntOperand(0)),
      ]),
    ]),
    [{ params: [OwnedParam], result: OwnedResult }],
  );
  assert_eq(
    [
      Lower,
      Lift,
      ContainerWalk(b"lower_items"),
      ContainerWalk(b"lower_entries"),
      ContainerWalk(b"lift_items"),
      ContainerWalk(b"lift_entries"),
    ].map(|operation: TypeOperation| generated_signature(operation, 2).params),
    [
      [BorrowedParam, BorrowedParam],
      [OwnedParam, OwnedParam],
      [BorrowedParam, BorrowedParam],
      [BorrowedParam, BorrowedParam],
      [OwnedParam, OwnedParam],
      [OwnedParam, OwnedParam],
    ],
  );
  assert_eq(
    [ContainerWalk(b"equal_from"), ContainerWalk(b"digest_from")].map(|operation: TypeOperation|
      generated_signature(operation, 3).params),
    [[BorrowedParam, BorrowedParam, BorrowedParam], [BorrowedParam, OwnedParam, BorrowedParam]],
  )
}

test "`ownership_text` prints each parameter as borrowed or owned, followed by whether the result is owned or borrowed from parameters" {
  assert_eq(
    ownership_text({
      params: [BorrowedParam, OwnedParam],
      result: BorrowedResult([{ param: 0, whole: true }, { param: 2, whole: false }]),
    }),
    b"[borrowed, given] borrowed(0, 2 part)",
  );
  assert_eq(ownership_text(all_owned(0)), b"[] owned")
}

fn calls_written(b: Block) -> List<Convention> =
  b.fold([], |accumulator: List<Convention>, i: Instruction|
    match i {
      Let(l) -> match l.value { Call(c) -> accumulator.push(c.convention), _ -> accumulator },
      _ -> accumulator,
    })

test "a body is compiled against its own inferred ownership and each callee's, and a callee with no inferred ownership is assumed to take every argument as owned" {
  let s = string_variable(0);
  let r = string_variable(1);
  let q = string_variable(2);
  let f = definition_of(b"f", [s], AsWord, [
    bind(r, call_of(b"look", [VariableOperand(s)])),
    bind(q, call_of(b"other", [VariableOperand(r)])),
    Return(VariableOperand(q)),
  ]).member;
  let read = { params: [BorrowedParam], result: BorrowedResult([{ param: 0, whole: false }]) };
  let signatures = Map::new().insert(of_m(b"f"), {
    params: [BorrowedParam],
    result: OwnedResult,
  }).insert(
    of_m(b"look"),
    read,
  );
  let written = with_conventions(f, signatures);
  assert_eq(param_ownerships(written.convention), [BorrowedParam]);
  assert_eq(
    calls_written(written.body).map(|c: Convention|
      { params: param_ownerships(c), result: c.returned }),
    [read, all_owned(1)],
  );
  let message = handle {
    with_conventions(f, signatures.insert(of_m(b"look"), all_owned(2)));
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert_eq(message, b"a handing of 2 parameters, but the function has only 1: m.look in m.f");
  let at = { ..f, key: keys::specialisation_key(b"m.f", [], []) };
  assert_eq(param_ownerships(with_conventions(at, signatures).convention), [BorrowedParam]);
  let borrowing = signatures.insert(of_m(b"f"), read);
  let scalar = {
    ..at,
    params: [int(0)],
    convention: {
      ..at.convention,
      params: at.convention.params.map(|p: ParamTaking| { ..p, representation: AsInt }),
      result: AsInt,
    },
  };
  assert_eq(
    [
      with_conventions(at, borrowing).convention.returned,
      with_conventions(scalar, borrowing).convention.returned,
    ],
    [read.result, OwnedResult],
  );
  let for_type = |operation: TypeOperation|
    param_ownerships(
      with_conventions(
        { ..f, key: keys::generated_key(operation, NamedType({ name: b"m.T", args: [] }), b"m") },
        signatures,
      ).convention,
    );
  assert_eq([for_type(Equal), for_type(Drop)], [[BorrowedParam], [OwnedParam]]);
  let generic = match call_of(b"look", [VariableOperand(s)]) {
    Call(c) -> Call({ ..c, callee: Generic(0) }),
    other -> other,
  };
  let closure = {
    ..f,
    key: Named(b"m.f"),
    body: [bind(r, generic), Return(VariableOperand(r))],
    links: no_links(),
  };
  let rooted = {
    ..f,
    lambdas: [
      Closure({ body: closure, captures: 0, at: dummy_span(), words: no_closure_evidence() }),
    ],
    links: {
      ..no_links(),
      generics: [
        {
          callee: Named(b"m.look"),
          args: [],
          specialised_variables: [],
          functions: [],
          effect_evidence: [],
        },
      ],
    },
  };
  match with_conventions(rooted, signatures).lambdas {
    [Closure(c)] ->
      assert_eq(
        calls_written(c.body.body).map(|x: Convention|
          { params: param_ownerships(x), result: x.returned }),
        [read],
      ),
    _ -> assert(false, None),
  }
}

test "ownership inference covers only a definition itself, not its specialisations or generated functions, and keeps the parameters its declaration marks borrowed" {
  let s = string_variable(0);
  let f = definition_of(b"f", [s], AsWord, [Return(VariableOperand(s))]).member;
  let typed = NamedType({ name: b"m.T", args: [] });
  let forms = [
    f,
    { ..f, key: keys::specialisation_key(b"m.f", [], []) },
    { ..f, key: keys::generated_key(Equal, typed, b"m") },
  ];
  assert_eq(
    inference_targets_of(Map::new().insert(of_m(b"f"), [0]), forms).map(|l: InferenceTarget|
      { definition: l.definition, borrowed: l.borrowed }),
    [{ definition: of_m(b"f"), borrowed: [0] }],
  )
}
