//! What the emitter answers for a root: its C text, the tables beside it, its head and its needs.

import std.bin
import std.list
import compiler.check.types (Type, type_bin)
import compiler.emit.keys (RootKey, FnArg, RootName, Evidence, root_key_bin, fn_arg_bin,
                           root_name_bin, evidence_bin, root_name, root_text)
import compiler.emit.tir.statics (StaticDef, static_def_bin)

// --- Specialisation ----------------------------------------------------------------------------

/// What the emitted C calls one definition, and the entry the loader binds it by.
pub type Defined = { symbol: Bytes, entry: Bytes, head: Head }

/// A root's C function as a call declares it: its answer's and each parameter's carried C type.
pub type Head = { answer: Bytes, params: List<Bytes> }

/// The head a body's call of `callee` was written to, its callee named by its place so an answer
/// spells each root it calls once, in `Tables.calls`.
pub type Expect = { callee: Called, head: Head }

/// Where a call's callee stands: a root at its place among the body's `Tables.calls`, or the body's
/// generic call `n`, whose placeholder the unit settles on a root.
pub type Called = | CallAt(Int) | GenericAt(Int)

/// Root `k` by its place among `calls`, which hold it.
pub fn call_at(calls: List<RootKey>, k: RootKey) -> Called / {abort.raise} =
  match calls.index_of(k) {
    Some(i) -> CallAt(i),
    None ->
      panic(
        String::of_bytes_lossy(
          b"a call of a root its body does not name: ".concat(root_text(root_name(k))),
        ),
      ),
  }

/// The name of the root `e`'s callee stands at among `t`'s calls; none for a generic call the unit
/// has not settled.
pub fn expected_callee(t: Tables, e: Expect) -> Option<RootName> =
  match e.callee {
    CallAt(i) -> match t.calls.at(i) { Some(k) -> Some(root_name(k)), None -> None },
    GenericAt(_) -> None,
  }

/// The head of a root of `n` parameters that takes and answers words.
pub fn word_head(n: Int) -> Head = { answer: b"Word", params: range(0, n).map(|_: Int| b"Word") }

/// A call of a generic definition: the callee, the definition's root as it stands, and each type
/// argument the checker gave the call, a variable of the calling body as itself, which the unit
/// settles the callee's root by; `carried` are the variables the call hands over raw, which it
/// settles on; `fns` the lambdas it hands, which the root it settles on may run in place of its
/// calls of them; and `rows` the words it hands for each of the callee's row variables, as a key
/// holds them.
pub type GenericCall = {
  callee: RootKey,
  args: List<Type>,
  carried: List<Int>,
  fns: List<FnArg>,
  rows: List<List<Evidence>>,
}

/// Where a body's code took a slow path because type variable `var` was unknown, and what a
/// specialisation would read of it.
pub type Need = { var: Int, reads: Reads }

/// Whether the variable's type is a scalar the code holds apart from a word, its layout, or the
/// type itself: an operation done per type, `==` or `compare`, reads which type it is. `Rowed` is a
/// body generic over rows, which takes as many words as its callers' rows say, so it names no type
/// variable.
pub type Reads = | Scalar | Layout | Exact | Rowed

/// Whether a body needing `needs` reads a type variable's layout or the type itself, or takes words
/// only its callers' rows count, which only what its callers settle says: such a body is settled by
/// its callers, never printed or emitted but at what they settle.
pub fn settled_by_callers(needs: List<Need>) -> Bool =
  needs.any(|n: Need| n.reads == Layout || n.reads == Exact || n.reads == Rowed)

/// A body's calls of generic definitions, numbered as their `@@gN@@` placeholders are, and its
/// needs: what a specialisation at its type arguments would read of each; the head each call of a
/// root was written to, which the unit holds the callee's own to; and the parameters it calls as
/// functions, or hands on to calls, which the unit closes to know where a function argument is called.
pub type Generics = {
  calls: List<GenericCall>,
  needs: List<Need>,
  expects: List<Expect>,
  called: List<Int>,
  passes: List<Pass>,
}

/// A body's parameter `param` handed on as argument `at` of a call of the definition whose root as it
/// stands is `callee`.
pub type Pass = { param: Int, callee: RootKey, at: Int }

pub fn no_generics() -> Generics = { calls: [], needs: [], expects: [], called: [], passes: [] }

/// A definition's handing as an answer publishes it for its callers' code, by the name of the
/// definition's root: whether each parameter, by place, is only lent; and for an answer read out of
/// lent parameters rather than owned, those parameters by place, each `whole` where the answer may be
/// the argument itself.
pub type Published = {
  def: RootName,
  lent: List<Bool>,
  borrowed: Option<List<{ param: Int, whole: Bool }>>,
}

/// What one body names of the unit around it, each table in the order its own text numbers it, and
/// each root by its key, so the unit asks for each as what it is. `calls` are the roots its C calls;
/// `members` a tail group's roots in case order, and empty for a body of its own; `statics` the
/// static objects its C names, each after those it names and each once, which the unit lays out once
/// for the program. `handings` are the handings of the definitions the body defines; `assumed` those
/// of the definitions outside `group` its calls were written against, which the answer holds only
/// while each stands; `group` the roots of the definitions the lending inference settled with the
/// body's, which the unit asks for together.
pub type Tables = {
  fields: List<Bytes>,
  lambdas: List<Bytes>,
  calls: List<RootKey>,
  generics: Generics,
  performs: List<Bytes>,
  handles: List<Bytes>,
  members: List<RootKey>,
  symbols: List<Defined>,
  statics: List<StaticDef>,
  handings: List<Published>,
  assumed: List<Published>,
  group: List<RootKey>,
  shared: List<SharedFn>,
}

/// A function of a closure's block that closures alike share, named `symbol` and written whole as
/// `text`: the unit writes it once in each part whose bodies name it.
pub type SharedFn = { symbol: Bytes, text: Bytes }

/// What a body that names nothing of its unit holds.
pub fn no_tables() -> Tables =
  {
    fields: [],
    lambdas: [],
    calls: [],
    generics: no_generics(),
    performs: [],
    handles: [],
    members: [],
    symbols: [],
    statics: [],
    handings: [],
    assumed: [],
    group: [],
    shared: [],
  }

/// `s` with every `byte` taken out.
pub fn without(s: Bytes, byte: Int) -> Bytes =
  Bytes::concat_all(
    range(0, s.len()).map(|i: Int| if s.at(i) == byte { b"" } else { s.slice(i, i + 1) }),
  )

/// The bits of the `Float` a literal's text names, its `_`s read past.
pub fn literal_bits(literal: Bytes) -> Int / {abort.raise} =
  match Float::of_string(String::of_bytes(without(unspaced(literal), 95))) {
    Some(x) -> bits_of_float(x),
    None -> panic("a float literal that does not read"),
  }

/// A negative pattern literal's text runs from its `-`, across any space written after it.
fn unspaced(s: Bytes) -> Bytes =
  Bytes::concat_all(
    range(0, s.len()).map(|i: Int| if s.at(i) <= 32 { b"" } else { s.slice(i, i + 1) }),
  )

// --- the emitter's entry ----------------------------------------------------

/// A root's C and the tables it names, both empty where its callers settle it.
pub type Emitted = { name: RootName, text: Bytes, tables: Tables }

/// A body's C and the tables it names.
pub type Answer = { text: Bytes, tables: Tables }

pub type RootAnswer = { name: RootName, answer: Answer }

derive bin for Head

derive bin for Defined

derive bin for Called

derive bin for Expect

derive bin for Pass

derive bin for GenericCall

derive bin for Reads

derive bin for Need

derive bin for Generics

derive bin for Published

derive bin for SharedFn

derive bin for Tables

derive bin for Answer

derive bin for RootAnswer
