//! Pattern tests, and the bindings a match makes.

import emit.code (CodePattern, PxWild, PxVar, PxLit, PxRange, PxCtor, PxRecord, PxList,
                  CodePatternField, irrefutable)
import std.list
import syntax.patterns (Lit, LInt, LFixed, LWide, LBool, LStr, LBytes, LEmbedded, LChar, LUnit,
                        LBad)
import std.bytes (ascii_of_int)
import emit.c (KBool, KBoxed, KInt, Kind, counted, is_sum, width_named, in_imm, int_lit)
import emit.reps (Ty, TyOpen, TyRec, FieldTy, raw_slot, word_kind, field_at, typed_kind, case_index)
import emit.state (CValue, Emitter, Slice, WithValue, line, fresh, deferred_of, held_sum_of,
                   slice_of, note_slice, note_made, spend_made, is_pinned, spendable, note_holder,
                   check, known_or, field_of)
import emit.scope (tag_of, sum_case, ctor_bare, tag_text, arg_ty)
import emit.values (remember, bind, sum_made, raw_at, ctor_fields, ctor_width, bind_keeping,
                    ensure_owned, moved_field, from_table, built_field, field_read, as_word,
                    case_copy, arg_at)
import emit.ops (bytes_equal)

// --- Externs written in place -----------------------------------------------------

/// Outside the immediate range an `Int` is boxed, and so is every word that can equal it.
fn int_test(subj: Bytes, n: Int) -> Bytes =
  if n >= 0 - 4611686018427387904 && n < 4611686018427387904 {
    Bytes::concat_all([
      b"(ply_is_imm(",
      subj,
      b") ? ply_imm_value(",
      subj,
      b") == ",
      int_lit(n),
      b" : 0)",
    ])
  } else {
    Bytes::concat_all([
      b"(",
      subj,
      b" != 0 && !ply_is_imm(",
      subj,
      b") && rt_unbox_int_p(ctx, ",
      subj,
      b") == ",
      int_lit(n),
      b")",
    ])
  }

/// An `Int` or a carried width from `lo` through `hi`. Every word that can be in the immediate
/// range is immediate, so bounds inside it leave a boxed word out.
fn int_between(subj: Bytes, lo: Int, hi: Int) -> Bytes = {
  let within = |v: Bytes|
    Bytes::concat_all([b"(", v, b" >= ", int_lit(lo), b" && ", v, b" <= ", int_lit(hi), b")"]);
  let immediate = within(Bytes::concat_all([b"ply_imm_value(", subj, b")"]));
  if lo >= 0 - 4611686018427387904 && hi < 4611686018427387904 {
    Bytes::concat_all([b"(ply_is_imm(", subj, b") ? ", immediate, b" : 0)"])
  } else {
    Bytes::concat_all([
      b"(",
      subj,
      b" != 0 && (ply_is_imm(",
      subj,
      b") ? ",
      immediate,
      b" : ",
      within(Bytes::concat_all([b"rt_unbox_int_p(ctx, ", subj, b")"])),
      b"))",
    ])
  }
}

/// A range over a width past 32 bits, whose values the runtime orders, against the unit's constants.
fn between_test(
  emitter: Emitter,
  lo: Lit,
  hi: Lit,
  subj: CValue,
) -> { emitter: Emitter, expr: Bytes } = {
  let from = from_table(emitter, lo);
  let to = from_table(from.emitter, hi);
  let held = bind(
    to.emitter,
    KBool,
    Bytes::concat_all([
      b"(",
      subj.expr,
      b" != 0 && rt_between_p(ctx, ",
      subj.expr,
      b", ",
      from.value.expr,
      b", ",
      to.value.expr,
      b"))",
    ]),
  );
  { emitter: check(held.emitter), expr: held.value.expr }
}

/// As `==` compares, against the unit's constant: a string or byte string by its bytes, a character
/// by its word, anything else as the runtime compares it. A zero subject is an enclosing test that
/// failed.
fn equal_test(emitter: Emitter, literal: Lit, subj: CValue) -> { emitter: Emitter, expr: Bytes } = {
  let k = from_table(emitter, literal);
  let same = match literal {
    LStr(_) -> bytes_equal(subj.expr, k.value.expr),
    LBytes(_) -> bytes_equal(subj.expr, k.value.expr),
    LEmbedded(_, _) -> bytes_equal(subj.expr, k.value.expr),
    LChar(_) -> Bytes::concat_all([b"(", subj.expr, b" == ", k.value.expr, b")"]),
    _ -> Bytes::concat_all([b"rt_equal_p(ctx, ", subj.expr, b", ", k.value.expr, b")"]),
  };
  let eq = bind(k.emitter, KBool, Bytes::concat_all([b"(", subj.expr, b" != 0 && ", same, b")"]));
  { emitter: check(eq.emitter), expr: eq.value.expr }
}

/// `v`, a value a pattern tests, as patterns read it: a word, a sum's word, or a record held back,
/// and any other value made its word.
fn tested_value(emitter: Emitter, v: CValue) -> WithValue =
  if v.kind == KBoxed || is_sum(v.kind) { { emitter: emitter, value: v } }
  else { bind(emitter, KBoxed, as_word(v)) }

/// A nested pattern reads a field into a local under the test so far, since reading a non-record raises. `None` for an unsupported pattern.
pub fn pat_test(
  pattern: CodePattern,
  subj: CValue,
  emitter: Emitter,
) -> Option<{ emitter: Emitter, expr: Bytes }> / {abort.raise} =
  match pattern {
    PxWild -> Some({ emitter: emitter, expr: b"1" }),
    PxVar(_) -> Some({ emitter: emitter, expr: b"1" }),
    PxLit(l) -> match l {
      LInt(n) -> Some({ emitter: emitter, expr: int_test(subj.expr, n) }),
      // At 64 bits a width is the runtime's own object, not an immediate.
      LFixed(name, bits) -> match width_named(name) {
        None -> None,
        Some(w) -> if in_imm(w) { Some({ emitter: emitter, expr: int_test(subj.expr, bits) }) }
        else { Some(equal_test(emitter, l, subj)) },
      },
      LBool(b) ->
        Some({
          emitter: emitter,
          expr: Bytes::concat_all([
            b"(",
            subj.expr,
            b" == ",
            if b { b"ply_true" } else { b"ply_false" },
            b")",
          ]),
        }),
      // `()` is the only value of its type.
      LUnit -> Some({ emitter: emitter, expr: b"1" }),
      LBad -> None,
      _ -> Some(equal_test(emitter, l, subj)),
    },
    PxRange(r) -> match ((r.lo, r.hi)) {
      (LInt(lo), LInt(hi)) -> Some({ emitter: emitter, expr: int_between(subj.expr, lo, hi) }),
      (LFixed(name, lo), LFixed(_, hi)) -> match width_named(name) {
        None -> None,
        Some(w) -> if in_imm(w) { Some({ emitter: emitter, expr: int_between(subj.expr, lo, hi) }) }
        else { Some(between_test(emitter, r.lo, r.hi, subj)) },
      },
      (LWide(_, _, _), LWide(_, _, _)) -> Some(between_test(emitter, r.lo, r.hi, subj)),
      _ -> None,
    },
    // A constructor tests its tag and width over an object; an argument with its own test is read into a local under the test so far.
    // A nested subject is zero when an enclosing test failed, and its header must not be read then.
    // A sum held as its word: `None` zero and `Some` that word otherwise; `Err` the word tagged
    // `100` and `Ok` any other. The argument is the word, untagged for `Err`.
    // A sum held back tests its constructor's index, and its argument is the value it holds.
    PxCtor(c) -> match held_sum_of(emitter, subj.expr) {
      Some(h) -> match case_index(h.cases, ctor_bare(emitter, c.name)) {
        None -> None,
        Some(i) -> {
          let tested = Bytes::concat_all([b"(", h.tag, b" == ", ascii_of_int(i), b")"]);
          match c.args.at(0) {
            None -> Some({ emitter: emitter, expr: tested }),
            Some(sub) -> if irrefutable(sub) { Some({ emitter: emitter, expr: tested }) } else {
              match h.args.at(i) {
                Some(Some(v)) -> {
                  let w = tested_value(emitter, v);
                  match pat_test(sub, w.value, w.emitter) {
                    None -> None,
                    Some(inner) ->
                      Some({
                        emitter: inner.emitter,
                        expr: Bytes::concat_all([b"(", tested, b" && ", inner.expr, b")"]),
                      }),
                  }
                },
                _ -> None,
              }
            },
          }
        },
      },
      None -> if is_sum(subj.kind) {
        let case = sum_case(emitter, subj.kind, c.name, subj.expr);
        match c.args.at(0) {
          None -> Some({ emitter: emitter, expr: case.test }),
          Some(sub) -> if irrefutable(sub) { Some({ emitter: emitter, expr: case.test }) } else {
            match pat_test(
                sub,
                { kind: KBoxed, expr: case.arg, ty: arg_ty(emitter, subj, c.name) },
                emitter,
              ) {
              None -> None,
              Some(inner) ->
                Some({
                  emitter: inner.emitter,
                  expr: Bytes::concat_all([b"(", case.test, b" && ", inner.expr, b")"]),
                }),
            }
          },
        }
      } else {
        match tag_of(emitter, c.name) {
          None -> None,
          Some(tag) -> {
            let head = Bytes::concat_all([
              b"(",
              subj.expr,
              b" != 0 && !ply_is_imm(",
              subj.expr,
              b") && ply_obj(",
              subj.expr,
              b")->kind == 4 && ply_obj(",
              subj.expr,
              b")->layout == ",
              tag_text(emitter, tag),
              b" && ply_obj(",
              subj.expr,
              b")->len == ",
              ascii_of_int(ctor_width(emitter, tag, c.args.len())),
              b")",
            ]);
            let laid = ctor_fields(emitter, tag);
            range(0, c.args.len()).fold(
              Some({ emitter: emitter, expr: head }),
              |acc: Option<{ emitter: Emitter, expr: Bytes }>, k: Int|
                match acc {
                  None -> None,
                  Some(t) -> match c.args.at(k) {
                    None -> None,
                    Some(sub) -> if irrefutable(sub) { Some(t) } else {
                      let read = arg_tested(t.emitter, t.expr, subj.expr, k, laid);
                      let field = {
                        emitter: read.emitter,
                        value: {
                          ..read.value,
                          ty: known_or(read.value.ty, arg_ty(read.emitter, subj, c.name)),
                        },
                      };
                      match pat_test(sub, field.value, field.emitter) {
                        None -> None,
                        Some(inner) ->
                          Some({
                            emitter: inner.emitter,
                            expr: Bytes::concat_all([b"(", t.expr, b" && ", inner.expr, b")"]),
                          }),
                      }
                    },
                  },
                },
            )
          },
        }
      },
    },
    // A record held back tests each field's pattern on the value it holds.
    PxRecord(r) -> if deferred_of(emitter, subj.expr) != None {
      r.fields.fold(
        Some({ emitter: emitter, expr: b"1" }),
        |acc: Option<{ emitter: Emitter, expr: Bytes }>, f: CodePatternField|
          match acc {
            None -> None,
            Some(t) -> if irrefutable(f.pat) { acc } else {
              match built_field(t.emitter, subj.expr, f.name) {
                None -> None,
                Some(v) -> {
                  let w = tested_value(t.emitter, v);
                  match pat_test(f.pat, w.value, w.emitter) {
                    None -> None,
                    Some(inner) ->
                      Some({
                        emitter: inner.emitter,
                        expr: Bytes::concat_all([b"(", t.expr, b" && ", inner.expr, b")"]),
                      }),
                  }
                },
              }
            },
          },
      )
    } else {
      // Refutable despite the shape: a non-record, the field count without `..`, or a missing field.
      match pattern_slots(subj.ty, r.fields) {
        // A record of a known layout holds every field its type names: only the fields' own
        // patterns are tested, each on the field read where it stands.
        Some(slots) ->
          range(0, r.fields.len()).fold(
            Some({ emitter: emitter, expr: is_object(subj.expr) }),
            |acc: Option<{ emitter: Emitter, expr: Bytes }>, i: Int|
              match acc {
                None -> None,
                Some(t) -> match r.fields.at(i) {
                  None -> acc,
                  Some(f) -> if irrefutable(f.pat) { acc } else {
                    match slots.at(i) {
                      None -> None,
                      Some(x) -> {
                        let field = laid_tested(t.emitter, t.expr, subj.expr, x);
                        match pat_test(f.pat, field.value, field.emitter) {
                          None -> None,
                          Some(inner) ->
                            Some({
                              emitter: inner.emitter,
                              expr: Bytes::concat_all([b"(", t.expr, b" && ", inner.expr, b")"]),
                            }),
                        }
                      },
                    }
                  },
                },
              },
          ),
        None -> {
          let head = Bytes::concat_all([
            b"(",
            is_object(subj.expr),
            b" && rt_record_fits_p(ctx, ",
            subj.expr,
            b", ",
            ascii_of_int(r.fields.len()),
            b", ",
            if r.rest { b"0" } else { b"1" },
            b"))",
          ]);
          r.fields.fold(
            Some({ emitter: emitter, expr: head }),
            |acc: Option<{ emitter: Emitter, expr: Bytes }>, f: CodePatternField|
              match acc {
                None -> None,
                Some(t) -> {
                  let idx = field_of(t.emitter, f.name);
                  let has = Bytes::concat_all([
                    b"(",
                    t.expr,
                    b" && rt_record_has_p(ctx, ",
                    subj.expr,
                    b", @@f",
                    ascii_of_int(idx.i),
                    b"@@))",
                  ]);
                  if irrefutable(f.pat) { Some({ emitter: idx.emitter, expr: has }) } else {
                    let field = bind(
                      idx.emitter,
                      KBoxed,
                      Bytes::concat_all([
                        b"(",
                        has,
                        b" ? rt_field_p(ctx, ",
                        subj.expr,
                        b", @@f",
                        ascii_of_int(idx.i),
                        b"@@, 0) : 0)",
                      ]),
                    );
                    match pat_test(
                        f.pat,
                        field.value,
                        note_holder(check(field.emitter), field.value.expr),
                      ) {
                      None -> None,
                      Some(inner) ->
                        Some({
                          emitter: inner.emitter,
                          expr: Bytes::concat_all([b"(", has, b" && ", inner.expr, b")"]),
                        }),
                    }
                  }
                },
              },
          )
        },
      }
    },
    // A refutable `..rest` would allocate the tail inside a test that may fail, so it is refused.
    PxList(l) -> if match l.rest { Some(r) -> !irrefutable(r), None -> false } { None } else {
      let sliced = slice_of(emitter, subj.expr);
      let head = match sliced {
        Some(sl) ->
          Bytes::concat_all([
            b"((int64_t)ply_obj(",
            sl.base,
            b")->len - ",
            sl.from,
            match l.rest { Some(_) -> b" >= ", None -> b" == " },
            ascii_of_int(l.items.len()),
            b")",
          ]),
        None ->
          Bytes::concat_all([
            b"rt_list_fits_p(ctx, ",
            subj.expr,
            b", ",
            ascii_of_int(l.items.len()),
            b", ",
            match l.rest { Some(_) -> b"0", None -> b"1" },
            b")",
          ]),
      };
      range(0, l.items.len()).fold(
        Some({ emitter: emitter, expr: head }),
        |acc: Option<{ emitter: Emitter, expr: Bytes }>, i: Int|
          match acc {
            None -> None,
            Some(t) -> match l.items.at(i) {
              None -> None,
              Some(item) -> if irrefutable(item) { Some(t) } else {
                let at = bind(
                  t.emitter,
                  KBoxed,
                  Bytes::concat_all([
                    b"(",
                    t.expr,
                    b" ? ",
                    list_at_text(sliced, subj, i),
                    b" : 0)",
                  ]),
                );
                match pat_test(item, at.value, note_holder(check(at.emitter), at.value.expr)) {
                  None -> None,
                  Some(inner) ->
                    Some({
                      emitter: inner.emitter,
                      expr: Bytes::concat_all([b"(", t.expr, b" && ", inner.expr, b")"]),
                    }),
                }
              },
            },
          },
      )
    },
  }

/// Argument `k` of constructor object `subj` as a word, read where `so_far` holds and zero where it
/// does not: borrowed from the object, but for a raw argument, boxed and held by this body.
fn arg_tested(
  emitter: Emitter,
  so_far: Bytes,
  subj: Bytes,
  k: Int,
  laid: Option<List<FieldTy>>,
) -> WithValue =
  laid_tested(emitter, so_far, subj, match match laid { Some(fs) -> arg_at(fs, k), None -> None } {
    Some(x) -> x,
    None -> { at: k, kind: KBoxed, ty: TyOpen([]) },
  })

/// What `x` lays out in the object `subj` as a word, read where `so_far` holds and zero where it
/// does not: borrowed from the object, but for a raw value, boxed and held by this body.
fn laid_tested(
  emitter: Emitter,
  so_far: Bytes,
  subj: Bytes,
  x: { at: Int, kind: Kind, ty: Ty },
) -> WithValue =
  if raw_slot(x.kind) {
    let boxed = bind(
      emitter,
      KBoxed,
      Bytes::concat_all([
        b"(",
        so_far,
        b" ? ",
        as_word({ kind: x.kind, expr: raw_at(subj, ascii_of_int(x.at), x.kind), ty: TyOpen([]) }),
        b" : 0)",
      ]),
    );
    { emitter: note_holder(check(boxed.emitter), boxed.value.expr), value: boxed.value }
  } else {
    bind_keeping(
      emitter,
      word_kind(x.kind),
      x.ty,
      Bytes::concat_all([b"(", so_far, b" ? ", field_read(subj, x), b" : 0)"]),
    )
  }

/// Whether the word `w` is an object's. Under a pattern that did not match it is not: zero, an
/// immediate, or a `Result`'s tagged `Err`.
fn is_object(w: Bytes) -> Bytes =
  Bytes::concat_all([b"(", w, b" != 0 && ((uint64_t)", w, b" & 7) == 0)"])

/// Where each field `fields` names is laid out in a record of `ty`; none unless `ty` lays out every
/// one of them.
fn pattern_slots(
  ty: Ty,
  fields: List<CodePatternField>,
) -> Option<List<{ at: Int, kind: Kind, ty: Ty }>> =
  match ty {
    TyRec(_) ->
      fields.fold(
        Some([]),
        |acc: Option<List<{ at: Int, kind: Kind, ty: Ty }>>, f: CodePatternField|
          match acc {
            None -> None,
            Some(slots) -> match field_at(ty, f.name) {
              Some(x) -> Some(slots.push(x)),
              None -> None,
            },
          },
      ),
    _ -> None,
  }

/// What `x` lays out in the object `subj`, read where it stands: a scalar held apart as itself, a
/// word as the object still holds it.
fn laid_read(emitter: Emitter, subj: Bytes, x: { at: Int, kind: Kind, ty: Ty }) -> WithValue =
  if raw_slot(x.kind) { bind(emitter, x.kind, raw_at(subj, ascii_of_int(x.at), x.kind)) }
  else { bind_keeping(emitter, word_kind(x.kind), x.ty, field_read(subj, x)) }

/// `laid_read`, with a count of its own where the value is counted.
fn laid_held(emitter: Emitter, subj: Bytes, x: { at: Int, kind: Kind, ty: Ty }) -> WithValue = {
  let w = laid_read(emitter, subj, x);
  if !counted(w.value.kind) { w } else {
    {
      emitter: note_holder(
        line(w.emitter, Bytes::concat_all([b"ply_inc(", w.value.expr, b");"])),
        w.value.expr,
      ),
      value: w.value,
    }
  }
}

/// Whether `pattern` matches the record held back as `name` whatever its values: one of its fields,
/// each irrefutable.
pub fn matches_held(emitter: Emitter, name: Bytes, pattern: CodePattern) -> Bool =
  deferred_of(emitter, name) != None
    && (match pattern {
      PxRecord(r) ->
        r.fields.fold(true, |ok: Bool, f: CodePatternField|
          ok && built_field(emitter, name, f.name) != None && irrefutable(f.pat)),
      _ -> irrefutable(pattern),
    })

/// A constructor's argument is duplicated when bound: the object still holds it.
pub fn pat_bind(emitter: Emitter, pattern: CodePattern, subj: CValue) -> Emitter / {abort.raise} =
  match pattern {
    // The binder carries the subject's shape, so `match r { x -> x.f }` reads at an offset.
    PxVar(v) -> match v.slot {
      None -> emitter,
      Some(s) -> {
        // What the subject's own shape does not say, the type the checker bound says.
        let ty = match subj.ty {
          TyOpen(_) -> typed_kind(emitter.typed, v.span).ty,
          known -> known,
        };
        // A sum held back is bound as its word.
        let ready = match held_sum_of(emitter, subj.expr) {
          Some(h) -> sum_made(emitter, h, !is_pinned(emitter, subj.expr)),
          None -> emitter,
        };
        let b = bind_keeping(ready, subj.kind, ty, subj.expr);
        remember(ensure_owned(b.emitter, b.value), s, b.value)
      },
    },
    // The argument of a sum held as its word is that word, untagged for `Err`; its binder takes
    // the subject's count where the subject moves into it, and holds one of its own where it does not.
    // A sum held back binds the argument it holds, a copy of it where a failing guard may hand the
    // subject on to the next arm.
    PxCtor(c) -> match held_sum_of(emitter, subj.expr) {
      Some(h) -> match c.args.at(0) {
        None -> emitter,
        Some(sub) -> match case_index(h.cases, ctor_bare(emitter, c.name)) {
          None -> emitter,
          Some(i) -> match h.args.at(i) {
            Some(Some(v)) -> {
              let a = if is_pinned(emitter, subj.expr) { case_copy(emitter, v) }
              else { { emitter: emitter, value: v } };
              pat_bind(a.emitter, sub, a.value)
            },
            _ -> emitter,
          },
        },
      },
      None -> if is_sum(subj.kind) {
        match c.args.at(0) {
          None -> emitter,
          Some(sub) -> {
            let case = sum_case(emitter, subj.kind, c.name, subj.expr);
            let ty = arg_ty(emitter, subj, c.name);
            if case.arg == subj.expr {
              let w = bind_keeping(emitter, KBoxed, ty, subj.expr);
              pat_bind(ensure_owned(w.emitter, w.value), sub, w.value)
            } else {
              let w = bind_keeping(emitter, KBoxed, ty, case.arg);
              if emitter.release && spendable(w.emitter, subj.expr) {
                let moved = line(
                  note_made(spend_made(w.emitter, subj.expr), w.value.expr),
                  Bytes::concat_all([subj.expr, b" = 0;"]),
                );
                pat_bind(moved, sub, w.value)
              } else { pat_bind(ensure_owned(w.emitter, w.value), sub, w.value) }
            }
          },
        }
      } else {
        // Every argument is read and duplicated whether or not the pattern names it, so the arm's scope has one shape.
        let laid = match tag_of(emitter, c.name) {
          Some(tag) -> ctor_fields(emitter, tag),
          None -> None,
        };
        range(0, c.args.len()).fold(emitter, |acc: Emitter, i: Int| {
          let f = match laid { Some(fs) -> arg_at(fs, i), None -> None };
          let w = laid_held(acc, subj.expr, match f {
            Some(x) -> x,
            None -> { at: i, kind: KBoxed, ty: TyOpen([]) },
          });
          // The object holds the argument as a word, which the subject's type says the layout of.
          let arg = { ..w.value, ty: known_or(w.value.ty, arg_ty(w.emitter, subj, c.name)) };
          match c.args.at(i) { Some(sub) -> pat_bind(w.emitter, sub, arg), None -> w.emitter }
        })
      },
    },
    // A record held back binds its values, each moved out where the record is spent; otherwise the
    // runtime's read by name answers the field duplicated, with no increment here.
    PxRecord(r) -> if deferred_of(emitter, subj.expr) != None {
      let spent = spendable(emitter, subj.expr);
      r.fields.fold(emitter, |acc: Emitter, f: CodePatternField|
        match built_field(acc, subj.expr, f.name) {
          Some(v) -> match moved_field(acc, spent, subj, v) {
            Some(m) -> pat_bind(note_made(m.emitter, m.value.expr), f.pat, m.value),
            None -> pat_bind(acc, f.pat, v),
          },
          None -> acc,
        })
    } else {
      match pattern_slots(subj.ty, r.fields) {
        // A record of a known layout hands over each field from where it holds it.
        Some(slots) ->
          range(0, r.fields.len()).fold(emitter, |acc: Emitter, i: Int|
            match r.fields.at(i) {
              Some(f) -> match slots.at(i) {
                Some(x) -> {
                  let w = laid_held(acc, subj.expr, x);
                  pat_bind(w.emitter, f.pat, w.value)
                },
                None -> acc,
              },
              None -> acc,
            }),
        None ->
          r.fields.fold(emitter, |acc: Emitter, f: CodePatternField| {
            let idx = field_of(acc, f.name);
            let field = bind(
              idx.emitter,
              KBoxed,
              Bytes::concat_all([
                b"rt_field_p(ctx, ",
                subj.expr,
                b", @@f",
                ascii_of_int(idx.i),
                b"@@, 0)",
              ]),
            );
            pat_bind(check(field.emitter), f.pat, field.value)
          }),
      }
    },
    PxList(l) -> {
      let sliced = slice_of(emitter, subj.expr);
      let items = range(0, l.items.len()).fold(emitter, |acc: Emitter, i: Int| {
        let at = bind(acc, KBoxed, list_at_text(sliced, subj, i));
        match l.items.at(i) {
          Some(item) -> pat_bind(check(at.emitter), item, at.value),
          None -> check(at.emitter),
        }
      });
      match l.rest {
        None -> items,
        Some(r) -> match sliced {
          // The rest of a slice is the same list from further on, bound without a copy.
          Some(sl) -> match r {
            PxVar(v) -> match v.slot {
              Some(s) -> {
                let from = bind(
                  items,
                  KInt,
                  Bytes::concat_all([sl.from, b" + ", ascii_of_int(l.items.len())]),
                );
                let f = fresh(from.emitter);
                remember(note_slice(f.emitter, f.name, sl.base, from.value.expr), s, {
                  kind: KBoxed,
                  expr: f.name,
                  ty: subj.ty,
                })
              },
              None -> items,
            },
            PxWild -> items,
            _ -> {
              let tail = bind(
                items,
                KBoxed,
                Bytes::concat_all([
                  b"rt_list_rest_p(ctx, ",
                  sl.base,
                  b", ",
                  sl.from,
                  b" + ",
                  ascii_of_int(l.items.len()),
                  b")",
                ]),
              );
              pat_bind(check(tail.emitter), r, tail.value)
            },
          },
          None -> {
            let tail = bind(
              items,
              KBoxed,
              Bytes::concat_all([
                b"rt_list_rest_p(ctx, ",
                subj.expr,
                b", ",
                ascii_of_int(l.items.len()),
                b")",
              ]),
            );
            pat_bind(check(tail.emitter), r, tail.value)
          },
        },
      }
    },
    _ -> emitter,
  }

/// Element `i` of the list `subj` a pattern reads, from a slice's offset on where it is one.
fn list_at_text(sliced: Option<Slice>, subj: CValue, i: Int) -> Bytes =
  match sliced {
    Some(sl) ->
      Bytes::concat_all([
        b"rt_list_at_p(ctx, ",
        sl.base,
        b", ",
        sl.from,
        b" + ",
        ascii_of_int(i),
        b")",
      ]),
    None -> Bytes::concat_all([b"rt_list_at_p(ctx, ", subj.expr, b", ", ascii_of_int(i), b")"]),
  }
