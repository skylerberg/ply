import compiler.emit.code (Code, CodeLiteral, CodeBinary)
import compiler.check.known (fixed_widths)
import std.list
import compiler.syntax.patterns (LiteralInt)
import std.bytes (ascii_of_int)
import std.math (pow)

pub type Kind =
  | BoxedKind
  | IntKind
  | BoolKind
  | SizedIntKind(Width)
  | FloatKind
  | DecimalKind
  | WideKind(Width)

pub type Width = { bits: Int, signed: Bool }

pub fn kind_c_type(k: Kind) -> Bytes =
  match k {
    SizedIntKind(w) -> if w.signed {
      if w.bits == 8 { b"int8_t" }
      else if w.bits == 16 { b"int16_t" }
      else if w.bits == 32 { b"int32_t" }
      else { b"int64_t" }
    } else { unsigned_c_type(w) },
    FloatKind -> b"double",
    DecimalKind -> b"PlyDec",
    WideKind(_) -> b"PlyWide",
    _ -> b"int64_t",
  }

pub fn unsigned_c_type(width: Width) -> Bytes =
  if width.bits == 8 { b"uint8_t" }
  else if width.bits == 16 { b"uint16_t" }
  else if width.bits == 32 { b"uint32_t" }
  else { b"uint64_t" }

pub fn width_named(name: Bytes) -> Option<Width> =
  fixed_widths.find_map(|w: { name: Bytes, bits: Int, signed: Bool }|
    if w.name == name { Some({ bits: w.bits, signed: w.signed }) } else { None })

pub fn width_index(width: Width) -> Int =
  if width.bits == 128 { if width.signed { 9 } else { 8 } } else {
    (if width.signed { 4 } else { 0 })
      + (if width.bits == 8 { 0 }
      else if width.bits == 16 { 1 }
      else if width.bits == 32 { 2 }
      else { 3 })
  }

pub fn overflow_code(operation: Bytes) -> Int =
  if operation == b"add" { 0 }
  else if operation == b"sub" { 1 }
  else if operation == b"neg" { 2 }
  else if operation == b"mul" { 3 }
  else if operation == b"rem" { 5 }
  else { 4 }

const literal_chunk_len: Int = 2000

pub fn c_string(b: Bytes) -> Bytes / {abort.raise} = {
  let n = b.len();
  let count = if n == 0 { 1 } else { (n + literal_chunk_len - 1) / literal_chunk_len };
  Bytes::join(
    range(0, count).map(|i: Int| {
      let end = if (i + 1) * literal_chunk_len < n { (i + 1) * literal_chunk_len } else { n };
      Bytes::concat_all([b"\"", escaped(b.slice(i * literal_chunk_len, end)), b"\""])
    }),
    b"\n  ",
  )
}

const unescaped_bytes: Bytes =
  Bytes::concat_all(range(32, 127).filter(|b: Int| b != 34 && b != 63 && b != 92).map(byte_of_int))

fn octal(b: Int) -> Bytes =
  Bytes::concat_all([b"\\", ascii_of_int(b / 64), ascii_of_int(b / 8 % 8), ascii_of_int(b % 8)])

pub fn escaped(piece: Bytes) -> Bytes / {abort.raise} = {
  let n = piece.len();
  let unescaped = unescaped_bytes;
  Bytes::concat_all(
    iterate({ from: 0, out: [] }, n + 1, |s: { from: Int, out: List<Bytes> }|
      if s.from >= n { Stop(s.out) } else {
        let stop = piece.scan(s.from, unescaped, n - s.from);
        if stop > s.from { Continue({ from: stop, out: s.out.push(piece.slice(s.from, stop)) }) }
        else {
          let b = piece.at(s.from);
          Continue({
            from: s.from + 1,
            out: s.out.push(if b == 34 { b"\\\"" } else if b == 92 { b"\\\\" } else { octal(b) }),
          })
        }
      }),
  )
}

pub fn in_register(width: Width) -> Bool = width.bits <= 64

pub fn fits_immediate(width: Width) -> Bool = width.bits < 64

pub fn width_min(width: Width) -> Int = if width.signed { 0 - pow(2, width.bits - 1) } else { 0 }

pub fn width_max(width: Width) -> Int =
  if width.signed { pow(2, width.bits - 1) - 1 } else { pow(2, width.bits) - 1 }

pub fn position_of(xs: List<Bytes>, x: Bytes) -> Option<Int> =
  range(0, xs.len()).fold(None, |accumulator: Option<Int>, i: Int|
    match accumulator {
      Some(_) -> accumulator,
      None -> if xs.at(i) == Some(x) { Some(i) } else { None },
    })

pub fn rank_of(names: List<Bytes>, name: Bytes) -> Int =
  names.fold(0, |accumulator: Int, n: Bytes|
    if compare(n, name) == Less { accumulator + 1 } else { accumulator })

pub fn bytes_join(xs: List<Bytes>, sep: Bytes) -> Bytes =
  range(0, xs.len()).fold(b"", |accumulator: Bytes, i: Int|
    Bytes::concat_all([
      accumulator,
      if i == 0 { b"" } else { sep },
      match xs.at(i) { Some(x) -> x, None -> b"" },
    ]))

pub fn sorted_names(ns: List<Bytes>) -> List<Bytes> =
  range(0, ns.len()).fold([], |accumulator: List<Bytes>, i: Int|
    ns.fold(accumulator, |a2: List<Bytes>, n: Bytes|
      if rank_of(ns, n) == i { a2.push(n) } else { a2 }))

pub fn int_literal(n: Int) -> Bytes =
  if n == 0 - 9223372036854775807 - 1 { b"INT64_MIN" }
  else { Bytes::concat_all([b"INT64_C(", ascii_of_int(n), b")"]) }

pub fn folded_constant(code: Code) -> Option<Int> =
  match code.node {
    CodeLiteral(l) -> match l { LiteralInt(n) -> Some(n), _ -> None },
    CodeBinary(b) -> match folded_constant(b.left_operand) {
      None -> None,
      Some(a) -> match folded_constant(b.right_operand) {
        None -> None,
        Some(x) -> if b.operation == b"add" { checked_add(a, x) }
        else if b.operation == b"sub" { checked_sub(a, x) }
        else if b.operation == b"mul" { checked_mul(a, x) }
        else if b.operation == b"bitand" { Some(a & x) }
        else if b.operation == b"bitor" { Some(a | x) }
        else if b.operation == b"bitxor" { Some(a ^ x) }
        else if b.operation == b"shl" && x >= 0 && x < 64 { Some(a << x) }
        else if b.operation == b"shr" && x >= 0 && x < 64 { Some(a >> x) }
        else if b.operation == b"ushr" && x >= 0 && x < 64 { Some(a >>> x) }
        else { None },
      },
    },
    _ -> None,
  }

fn checked_add(a: Int, b: Int) -> Option<Int> = {
  let s = wrap_add(a, b);
  if a >= 0 == (b >= 0) && s >= 0 != (a >= 0) { None } else { Some(s) }
}

pub fn checked_sub(a: Int, b: Int) -> Option<Int> = {
  let s = wrap_sub(a, b);
  if a >= 0 != (b >= 0) && s >= 0 != (a >= 0) { None } else { Some(s) }
}

fn checked_mul(a: Int, b: Int) -> Option<Int> =
  if a == 0 || b == 0 { Some(0) }
  else if a == -1 { checked_sub(0, b) }
  else if b == -1 { checked_sub(0, a) } else {
    let p = wrap_mul(a, b);
    if p / a == b && p % a == 0 { Some(p) } else { None }
  }

pub fn is_bitwise(operation: Bytes) -> Bool =
  operation == b"bitand" || operation == b"bitor" || operation == b"bitxor"

pub fn bitwise_c_operator(operation: Bytes) -> Bytes =
  if operation == b"bitand" { b"&" } else if operation == b"bitor" { b"|" } else { b"^" }

pub fn bytes_join_dots(xs: List<Bytes>) -> Bytes =
  range(0, xs.len()).fold(b"", |accumulator: Bytes, i: Int|
    Bytes::concat_all([
      accumulator,
      if i == 0 { b"" } else { b"." },
      match xs.at(i) { Some(x) -> x, None -> b"" },
    ]))
