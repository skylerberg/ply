//! C as the emitter spells it: the C types of kinds and widths, literals, and text joins.

import compiler.emit.code (Code, CodeLiteral, CodeBinary)
import compiler.check.known (fixed_widths)
import std.list
import compiler.syntax.patterns (LiteralInt)
import std.bytes (ascii_of_int)
import std.math (pow)

/// `BoxedKind` is a tagged word; `IntKind` is the untagged 64 bits inside one.
pub type Kind =
  | BoxedKind
  | IntKind
  | BoolKind
  /// Below 64 bits a width has its own C type; signed overflow is undefined in C, so casts carry signedness.
  | SizedIntKind(Width)
  /// A `Float` in a C `double`, whose arithmetic is IEEE-754's own once contraction is off.
  | FloatKind
  /// A `Decimal` in a `PlyDec`, the two words of its object, whose arithmetic is the runtime's.
  | DecimalKind
  /// A 128-bit width in a `PlyWide`, its low word and its high one, whose arithmetic is the
  /// runtime's.
  | WideKind(Width)

pub type Width = { bits: Int, signed: Bool }

pub fn kind_c_type(k: Kind) -> Bytes =
  match k {
    SizedIntKind(w) -> if w.signed {
      if w.bits == 8 { b"int8_t" }
      else if w.bits == 16 { b"int16_t" }
      else if w.bits == 32 { b"int32_t" }
      else { b"int64_t" }
    } else { unsigned_c_type(w) },
    FloatKind -> b"double",
    DecimalKind -> b"PlyDec",
    WideKind(_) -> b"PlyWide",
    _ -> b"int64_t",
  }

pub fn unsigned_c_type(width: Width) -> Bytes =
  if width.bits == 8 { b"uint8_t" }
  else if width.bits == 16 { b"uint16_t" }
  else if width.bits == 32 { b"uint32_t" }
  else { b"uint64_t" }

/// The width of the fixed-width integer type named `name`.
pub fn width_named(name: Bytes) -> Option<Width> =
  fixed_widths().find_map(|w: { name: Bytes, bits: Int, signed: Bool }|
    if w.name == name { Some({ bits: w.bits, signed: w.signed }) } else { None })

pub fn width_index(width: Width) -> Int =
  if width.bits == 128 { if width.signed { 9 } else { 8 } } else {
    (if width.signed { 4 } else { 0 })
      + (if width.bits == 8 { 0 }
      else if width.bits == 16 { 1 }
      else if width.bits == 32 { 2 }
      else { 3 })
  }

/// The code `rt_overflow` and `rt_decimal_overflow` name the operation that overflowed by.
pub fn overflow_code(op: Bytes) -> Int =
  if op == b"add" { 0 }
  else if op == b"sub" { 1 }
  else if op == b"neg" { 2 }
  else if op == b"mul" { 3 }
  else if op == b"rem" { 5 }
  else { 4 }

/// Whether a value of the width is held in a C register of its own type: up to 64 bits.
pub fn in_register(width: Width) -> Bool = width.bits <= 64

/// Whether the width's word is an `Int`'s immediate, as below 64 bits; at 64 it is an object of
/// the width's own, which compares by the width's order.
pub fn fits_immediate(width: Width) -> Bool = width.bits < 64

pub fn width_min(width: Width) -> Int = if width.signed { 0 - pow(2, width.bits - 1) } else { 0 }

pub fn width_max(width: Width) -> Int =
  if width.signed { pow(2, width.bits - 1) - 1 } else { pow(2, width.bits) - 1 }

pub fn position_of(xs: List<Bytes>, x: Bytes) -> Option<Int> =
  range(0, xs.len()).fold(None, |acc: Option<Int>, i: Int|
    match acc { Some(_) -> acc, None -> if xs.at(i) == Some(x) { Some(i) } else { None } })

// --- Externs written in place -----------------------------------------------------

pub fn rank_of(names: List<Bytes>, name: Bytes) -> Int =
  names.fold(0, |acc: Int, n: Bytes| if compare(n, name) == Less { acc + 1 } else { acc })

pub fn bytes_join(xs: List<Bytes>, sep: Bytes) -> Bytes =
  range(0, xs.len()).fold(b"", |acc: Bytes, i: Int|
    Bytes::concat_all([
      acc,
      if i == 0 { b"" } else { sep },
      match xs.at(i) { Some(x) -> x, None -> b"" },
    ]))

/// Sorted by name: the order a shape holds its fields in.
pub fn sorted_names(ns: List<Bytes>) -> List<Bytes> =
  range(0, ns.len()).fold([], |acc: List<Bytes>, i: Int|
    ns.fold(acc, |a2: List<Bytes>, n: Bytes| if rank_of(ns, n) == i { a2.push(n) } else { a2 }))

/// `INT64_C(-9223372036854775808)` negates an unsigned literal, which C cannot write as a constant, so the least `Int` is named.
pub fn int_lit(n: Int) -> Bytes =
  if n == 0 - 9223372036854775807 - 1 { b"INT64_MIN" }
  else { Bytes::concat_all([b"INT64_C(", ascii_of_int(n), b")"]) }

/// Two literals folded under an operator: `+`, `-`, `*` only without overflow, a shift only by a count the width holds.
pub fn folded_constant(code: Code) -> Option<Int> =
  match code.node {
    CodeLiteral(l) -> match l { LiteralInt(n) -> Some(n), _ -> None },
    CodeBinary(b) -> match folded_constant(b.lhs) {
      None -> None,
      Some(a) -> match folded_constant(b.rhs) {
        None -> None,
        Some(x) -> if b.op == b"add" { checked_add(a, x) }
        else if b.op == b"sub" { checked_sub(a, x) }
        else if b.op == b"mul" { checked_mul(a, x) }
        else if b.op == b"bitand" { Some(a & x) }
        else if b.op == b"bitor" { Some(a | x) }
        else if b.op == b"bitxor" { Some(a ^ x) }
        else if b.op == b"shl" && x >= 0 && x < 64 { Some(a << x) }
        else if b.op == b"shr" && x >= 0 && x < 64 { Some(a >> x) }
        else if b.op == b"ushr" && x >= 0 && x < 64 { Some(a >>> x) }
        else { None },
      },
    },
    _ -> None,
  }

fn checked_add(a: Int, b: Int) -> Option<Int> = {
  let s = wrap_add(a, b);
  if a >= 0 == (b >= 0) && s >= 0 != (a >= 0) { None } else { Some(s) }
}

pub fn checked_sub(a: Int, b: Int) -> Option<Int> = {
  let s = wrap_sub(a, b);
  if a >= 0 != (b >= 0) && s >= 0 != (a >= 0) { None } else { Some(s) }
}

fn checked_mul(a: Int, b: Int) -> Option<Int> =
  if a == 0 || b == 0 { Some(0) }
  else if a == -1 { checked_sub(0, b) }
  else if b == -1 { checked_sub(0, a) } else {
    let p = wrap_mul(a, b);
    if p / a == b && p % a == 0 { Some(p) } else { None }
  }

pub fn is_bitwise(op: Bytes) -> Bool = op == b"bitand" || op == b"bitor" || op == b"bitxor"

pub fn bitwise_c_operator(op: Bytes) -> Bytes =
  if op == b"bitand" { b"&" } else if op == b"bitor" { b"|" } else { b"^" }

// --- the emitter's entry ----------------------------------------------------

pub fn bytes_join_dots(xs: List<Bytes>) -> Bytes =
  range(0, xs.len()).fold(b"", |acc: Bytes, i: Int|
    Bytes::concat_all([
      acc,
      if i == 0 { b"" } else { b"." },
      match xs.at(i) { Some(x) -> x, None -> b"" },
    ]))
