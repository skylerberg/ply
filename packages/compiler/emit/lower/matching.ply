import compiler.emit.code (Code, CodeArm, CodePattern, CodePatternField, CodeWildcardPattern,
                           CodeBindingPattern, CodeLiteralPattern, CodeRangePattern,
                           CodeConstructorPattern, CodeRecordPattern, CodeListPattern, CodeVar,
                           NCtor, CodeApply, CodeLiteral)
import compiler.syntax.patterns (SourceLiteral, LiteralInt, LiteralFixed, LiteralBool, LiteralUnit)
import compiler.syntax.parsing (Span, dummy_span)
import compiler.check.types (Type, NamedType, named_type, int_type, bool_type)
import compiler.check.known (list_item, none_ctor)
import compiler.emit.typing (unknown_type)
import compiler.emit.representations (SumCtor, at_args)
import compiler.emit.typed_ir (Representation, AsInt, AsBool, AsFixed, AsWord, AsListView, AsSum,
                               AsUnit, Var, Arg, VarOperand, IntOperand, BoolOperand, FixedOperand,
                               ZeroOperand, Primitive, Get, Aggregate, CasePath, LeafPath, Inst,
                               Decl, Assign, If, Case, Match, Miss, Fail, NoMatchingArm,
                               LetMismatch, Block, Test, TagTest, IntTest, RangeTest, LengthTest,
                               operand_representation)
import compiler.emit.lower.module_context (ModuleContext)
import compiler.emit.lower.representation (representation_of, case_index, case_argument_offset)
import compiler.emit.lower.base (Context, Lowering, LoweredValue, LoweredArm, unreachable, fresh,
                                 bound_as, emitted, enter_block, exit_block, join_type,
                                 join_representation, set_join, type_of, represented_as,
                                 list_of_view)
import compiler.emit.lower.data (field, note_open_layouts)
import compiler.emit.lower.containers
import compiler.emit.lower.scalars (literal, binary)

pub fn arm_start(
  cx: Context,
  st: Lowering,
  subject: Arg,
  arm: CodeArm,
) -> Lowering / {abort.raise} = pattern_bound(cx, st, subject, arm.pat, [Miss])

pub fn match_joined(
  cx: Context,
  before: Lowering,
  subject: Arg,
  arms: List<LoweredArm>,
  after: Lowering,
  tail: Bool,
  at: Span,
) -> LoweredValue = {
  let ty = join_type(cx, arms.map(|a: LoweredArm| a.body));
  let j = fresh(exit_block(before, after), ty, join_representation(cx, ty, tail));
  let made = arms.fold(
    { st: j.st, blocks: [] },
    |acc: { st: Lowering, blocks: List<Block> }, a: LoweredArm| {
      let set = set_join(acc.st, a.body, j.var, at);
      let block = match a.guard {
        None -> set.block,
        Some(g) -> g.st.insts.push(If({ cond: g.arg, then: set.block, otherwise: [Miss] })),
      };
      { st: set.st, blocks: acc.blocks.push(nest(block, [Miss])) }
    },
  );
  {
    st: {
      ..made.st,
      insts: before.insts.push(Decl(j.var)).push(
        Match({
          arms: made.blocks,
          rest: [Fail({ reason: NoMatchingArm, at: at, letting: [], unwind: [] })],
        }),
      ),
    },
    arg: VarOperand(j.var),
  }
}

pub fn let_bound(
  cx: Context,
  value: LoweredValue,
  pat: CodePattern,
  at: Span,
) -> Lowering / {abort.raise} =
  let_else(cx, value, pat, [
    Fail({ reason: LetMismatch, at: at, letting: value.st.unwinding, unwind: [] }),
  ])

pub fn let_else(
  cx: Context,
  value: LoweredValue,
  pat: CodePattern,
  miss: List<Inst>,
) -> Lowering / {abort.raise} = pattern_bound(cx, value.st, value.arg, pat, miss)

pub fn compared_side(cx: Context, op: Bytes, lhs: Code, rhs: Code) -> Option<Bool> / {abort.raise} =
  if op != b"eq" && op != b"ne" { None }
  else if compares_structurally(cx, rhs) { Some(false) }
  else if compares_structurally(cx, lhs) { Some(true) }
  else { None }

fn is_constructor(c: Code) -> Bool =
  match c.node {
    NCtor(_) -> true,
    CodeApply(a) -> match a.func.node { NCtor(_) -> true, _ -> false },
    _ -> false,
  }

fn compares_structurally(cx: Context, c: Code) -> Bool =
  match c.node {
    NCtor(k) -> !cx.setting.ctors.keyed.contains(k.name),
    CodeApply(a) -> match a.func.node {
      NCtor(k) -> !cx.setting.ctors.keyed.contains(k.name),
      _ -> false,
    },
    _ -> false,
  }

pub fn compared_args(cx: Context, ctor: Code) -> List<Bool> / {abort.raise} =
  match ctor.node { CodeApply(a) -> a.args.map(|x: Code| !pattern_like(cx, x)), _ -> [] }

fn pattern_like(cx: Context, x: Code) -> Bool / {abort.raise} =
  match x.node {
    CodeLiteral(_) -> true,
    CodeVar(_) -> true,
    NCtor(_) -> compares_structurally(cx, x),
    CodeApply(a) -> compares_structurally(cx, x) && a.args.all(|y: Code| pattern_like(cx, y)),
    _ -> false,
  }

pub fn compared(
  cx: Context,
  value: LoweredValue,
  ctor: Code,
  args: List<Option<Arg>>,
  op: Bytes,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let r = fresh(value.st, bool_type(), AsBool);
  let differ = [Assign({ var: r.var, arg: BoolOperand(op == b"ne") })];
  let tested = value_tested(cx, { st: enter_block(r.st), arg: value.arg }, ctor, args, differ);
  let same = emitted(tested, Assign({ var: r.var, arg: BoolOperand(op == b"eq") }));
  {
    st: { ..same, insts: value.st.insts.push(Decl(r.var)).concat(nest(same.insts, differ)) },
    arg: VarOperand(r.var),
  }
}

fn value_tested(
  cx: Context,
  read: LoweredValue,
  x: Code,
  given: List<Option<Arg>>,
  differ: Block,
) -> Lowering / {abort.raise} =
  match x.node {
    CodeLiteral(l) -> literal_tested(cx, read.st, read.arg, l, differ),
    CodeVar(v) -> match read.st.env.get(v.slot) {
      Some(a) -> {
        let w = list_of_view({ st: read.st, arg: a }, dummy_span());
        equal_to(cx, { ..read, st: w.st }, w.arg, differ)
      },
      None -> unreachable(b"a comparison with a slot nothing bound"),
    },
    NCtor(v) -> match ctor_of(cx.setting, type_of(read.arg), v.sum, v.case) {
      Some(k) -> tag_tested(cx, read.st, read.arg, k, differ),
      None -> unreachable(b"a comparison with a constructor of no declared sum: ".concat(v.name)),
    },
    CodeApply(a) -> match a.func.node {
      NCtor(f) -> {
        match ctor_of(cx.setting, type_of(read.arg), f.sum, f.case) {
          Some(k) ->
            a.args.fold(
              { st: tag_tested(cx, read.st, read.arg, k, differ), at: 0 },
              |acc: { st: Lowering, at: Int }, y: Code| {
                let lying = arg_read(cx, acc.st, read.arg, k, acc.at);
                {
                  st: match given.at(acc.at) {
                    Some(Some(g)) -> equal_to(cx, as_read(cx, lying, k, acc.at, false), g, differ),
                    _ ->
                      value_tested(
                        cx,
                        as_read(cx, lying, k, acc.at, is_constructor(y)),
                        y,
                        [],
                        differ,
                      ),
                  },
                  at: acc.at + 1,
                }
              },
            ).st,
          None -> unreachable(b"a constructor compared with a call's value"),
        }
      },
      _ -> unreachable(b"a constructor compared whose argument is computed"),
    },
    _ -> unreachable(b"a constructor compared whose argument is computed"),
  }

fn equal_to(cx: Context, read: LoweredValue, a: Arg, differ: Block) -> Lowering / {abort.raise} = {
  let eq = binary(cx, read, { st: read.st, arg: a }, b"eq", dummy_span());
  emitted(eq.st, If({ cond: eq.arg, then: [], otherwise: differ }))
}

fn pattern_bound(
  cx: Context,
  st: Lowering,
  subject: Arg,
  pat: CodePattern,
  failing: Block,
) -> Lowering / {abort.raise} =
  match pat {
    CodeWildcardPattern -> st,
    CodeBindingPattern(v) -> { ..st, env: st.env.insert(v.slot, subject) },
    CodeLiteralPattern(l) -> literal_tested(cx, st, subject, l, failing),
    CodeRangePattern(r) -> range_tested(cx, st, subject, r.lo, r.hi, failing),
    CodeConstructorPattern(c) -> match ctor_of(cx.setting, type_of(subject), c.sum, c.case) {
      None -> unreachable(b"a constructor of no declared sum: ".concat(c.name)),
      Some(k) ->
        c.args.fold(
          { st: tag_tested(cx, st, subject, k, failing), at: 0 },
          |acc: { st: Lowering, at: Int }, sub: CodePattern|
            match sub {
              CodeWildcardPattern -> { ..acc, at: acc.at + 1 },
              _ -> {
                let a = as_read(
                  cx,
                  arg_read(cx, acc.st, subject, k, acc.at),
                  k,
                  acc.at,
                  match sub { CodeConstructorPattern(_) -> true, _ -> false },
                );
                { st: pattern_bound(cx, a.st, a.arg, sub, failing), at: acc.at + 1 }
              },
            },
        ).st,
    },
    CodeRecordPattern(r) ->
      r.fields.fold(st, |acc: Lowering, f: CodePatternField|
        match f.pat {
          CodeWildcardPattern -> acc,
          sub -> {
            let a = field(cx, { st: acc, arg: subject }, f.name, dummy_span());
            pattern_bound(cx, a.st, a.arg, sub, failing)
          },
        }),
    CodeListPattern(l) -> match subject {
      VarOperand(v) -> match list_item_type(v) {
        None -> unreachable(b"a list pattern over a value held as no list"),
        Some(item) -> {
          let n = l.items.len();
          let tested = case_tested(
            st,
            subject,
            LengthTest({ at_least: if l.rest == None { n + 1 } else { n } }),
            n,
            failing,
          );
          let seen = list_and_start(tested, v);
          let items = l.items.fold(
            { st: seen.st, at: 0 },
            |acc: { st: Lowering, at: Int }, x: CodePattern|
              match x {
                CodeWildcardPattern -> { ..acc, at: acc.at + 1 },
                _ -> {
                  let a = item_read(cx, acc.st, seen.list, seen.from, item, acc.at);
                  { st: pattern_bound(cx, a.st, a.arg, x, failing), at: acc.at + 1 }
                },
              },
          );
          match l.rest {
            None -> items.st,
            Some(CodeWildcardPattern) -> items.st,
            Some(r) -> {
              let a = rest_read(items.st, v, seen.list, seen.from, n);
              pattern_bound(cx, a.st, a.arg, r, failing)
            },
          }
        },
      },
      _ -> unreachable(b"a list pattern over a constant"),
    },
  }

fn literal_tested(
  cx: Context,
  st: Lowering,
  subject: Arg,
  l: SourceLiteral,
  failing: Block,
) -> Lowering / {abort.raise} =
  match l {
    LiteralUnit -> st,
    LiteralBool(b) -> {
      let held = represented_as({ st: st, arg: subject }, AsBool, dummy_span());
      case_tested(held.st, held.arg, IntTest([if b { 1 } else { 0 }]), 0, failing)
    },
    LiteralInt(n) -> if integral(operand_representation(subject)) {
      case_tested(st, subject, IntTest([n]), 0, failing)
    } else { equal_tested(cx, st, subject, l, failing) },
    LiteralFixed(_, bits) -> if integral(operand_representation(subject)) {
      case_tested(st, subject, IntTest([bits]), 0, failing)
    } else { equal_tested(cx, st, subject, l, failing) },
    _ -> equal_tested(cx, st, subject, l, failing),
  }

fn equal_tested(
  cx: Context,
  st: Lowering,
  subject: Arg,
  l: SourceLiteral,
  failing: Block,
) -> Lowering / {abort.raise} = {
  let k = literal(cx, st, l, dummy_span());
  let eq = binary(cx, { st: k.st, arg: subject }, k, b"eq", dummy_span());
  emitted(eq.st, If({ cond: eq.arg, then: [], otherwise: failing }))
}

fn range_tested(
  cx: Context,
  st: Lowering,
  subject: Arg,
  lo: SourceLiteral,
  hi: SourceLiteral,
  failing: Block,
) -> Lowering / {abort.raise} =
  match bounds(lo, hi) {
    Some(b) -> if integral(operand_representation(subject)) {
      case_tested(st, subject, RangeTest(b), 0, failing)
    } else { ordered_tested(cx, st, subject, lo, hi, failing) },
    None -> ordered_tested(cx, st, subject, lo, hi, failing),
  }

fn ordered_tested(
  cx: Context,
  st: Lowering,
  subject: Arg,
  lo: SourceLiteral,
  hi: SourceLiteral,
  failing: Block,
) -> Lowering / {abort.raise} = {
  let l = literal(cx, st, lo, dummy_span());
  let above = binary(cx, { st: l.st, arg: subject }, l, b"ge", dummy_span());
  let h = literal(
    cx,
    emitted(above.st, If({ cond: above.arg, then: [], otherwise: failing })),
    hi,
    dummy_span(),
  );
  let below = binary(cx, { st: h.st, arg: subject }, h, b"le", dummy_span());
  emitted(below.st, If({ cond: below.arg, then: [], otherwise: failing }))
}

fn bounds(lo: SourceLiteral, hi: SourceLiteral) -> Option<{ lo: Int, hi: Int }> =
  match lo {
    LiteralInt(a) -> match hi { LiteralInt(b) -> Some({ lo: a, hi: b }), _ -> None },
    LiteralFixed(_, a) -> match hi { LiteralFixed(_, b) -> Some({ lo: a, hi: b }), _ -> None },
    _ -> None,
  }

fn integral(r: Representation) -> Bool =
  match r { AsInt -> true, AsBool -> true, AsFixed(_) -> true, _ -> false }

fn tag_tested(
  cx: Context,
  st: Lowering,
  subject: Arg,
  k: ResolvedConstructor,
  failing: Block,
) -> Lowering =
  match operand_representation(subject) {
    AsUnit -> st,
    AsWord ->
      case_tested(
        note_open_layouts(cx, st, type_of(subject)),
        subject,
        TagTest(k.names),
        k.index,
        failing,
      ),
    _ -> case_tested(st, subject, TagTest(k.names), k.index, failing),
  }

fn case_tested(st: Lowering, subject: Arg, t: Test, when: Int, failing: Block) -> Lowering =
  match subject {
    VarOperand(v) ->
      emitted(st, Case({ on: v, test: t, arms: [{ when: when, body: [] }], rest: failing })),
    other ->
      emitted(
        st,
        If({ cond: BoolOperand(constant_is_case(other, t, when)), then: [], otherwise: failing }),
      ),
  }

fn constant_is_case(a: Arg, t: Test, when: Int) -> Bool =
  match t {
    TagTest(names) -> match a { ZeroOperand(_) -> names.at(when) == Some(none_ctor()), _ -> false },
    IntTest(ns) -> match constant_int(a) { Some(n) -> ns.at(when) == Some(n), None -> false },
    RangeTest(r) -> match constant_int(a) {
      Some(n) -> if unsigned_word(a) { flipped(r.lo) <= flipped(n) && flipped(n) <= flipped(r.hi) }
      else { r.lo <= n && n <= r.hi },
      None -> false,
    },
    _ -> false,
  }

fn constant_int(a: Arg) -> Option<Int> =
  match a {
    IntOperand(n) -> Some(n),
    BoolOperand(b) -> Some(if b { 1 } else { 0 }),
    FixedOperand(x) -> Some(x.bits),
    _ -> None,
  }

fn unsigned_word(a: Arg) -> Bool =
  match a { FixedOperand(x) -> !x.width.signed && x.width.bits == 64, _ -> false }

fn flipped(n: Int) -> Int = n ^ 0 - 9223372036854775807 - 1

fn nest(b: Block, failing: Block) -> Block =
  b.fold_right([], |i: Inst, after: Block|
    match i {
      Case(c) -> if c.rest == failing && c.arms.len() == 1
          && c.arms.all(|a: { when: Int, body: Block }| a.body.len() == 0) {
        [
          Case({
            ..c,
            arms: c.arms.map(|a: { when: Int, body: Block }| { ..a, body: after.reverse() }),
          }),
        ]
      } else { after.push(i) },
      If(x) -> if x.then.len() == 0 && x.otherwise == failing {
        [If({ ..x, then: after.reverse() })]
      } else { after.push(i) },
      _ -> after.push(i),
    }).reverse(
  )

type ResolvedConstructor = { full: Bytes, names: List<Bytes>, index: Int, args: List<Type> }

fn ctor_of(s: ModuleContext, ty: Type, sum: Bytes, case: Int) -> Option<ResolvedConstructor> =
  match s.ctors.sums.get(sum) {
    None -> None,
    Some(cs) -> match cs.at(case) {
      None -> None,
      Some(c) ->
        Some({
          full: c.name,
          names: cs.map(|x: SumCtor| x.name),
          index: case,
          args: arg_types(c, ty),
        }),
    },
  }

fn arg_types(c: SumCtor, ty: Type) -> List<Type> =
  match ty {
    NamedType(t) -> if t.args.len() != c.params.len() { c.fields }
    else { c.fields.map(|f: Type| at_args(f, c.params, t.args)) },
    _ -> c.fields,
  }

fn as_read(
  cx: Context,
  lying: LoweredValue,
  k: ResolvedConstructor,
  at: Int,
  tag_only: Bool,
) -> LoweredValue =
  if tag_only { lying }
  else { represented_as(lying, representation_of(cx.setting, arg_type(k, at)), dummy_span()) }

fn arg_type(k: ResolvedConstructor, at: Int) -> Type =
  match k.args.at(at) { Some(t) -> t, None -> unknown_type() }

fn arg_read(
  cx: Context,
  st: Lowering,
  subject: Arg,
  k: ResolvedConstructor,
  at: Int,
) -> LoweredValue / {abort.raise} = {
  let ty = arg_type(k, at);
  let want = representation_of(cx.setting, ty);
  if want == AsUnit { { st: st, arg: ZeroOperand(AsUnit) } } else {
    match subject {
      VarOperand(v) -> match v.representation {
        AsSum(s) -> match case_index(v.representation, k.full) {
          None -> unreachable(b"a constructor its sum's cases do not hold: ".concat(k.full)),
          Some(i) -> match case_argument_offset(s.layout, i, at) {
            None -> unreachable(b"an argument its case's layout does not hold"),
            Some(w) -> {
              let lies = representation_of(cx.setting, ty);
              let read = bound_as(
                st,
                ty,
                lies,
                Get({ of: v, path: CasePath({ case: i, at: w }) }),
                dummy_span(),
              );
              if lies == want { read } else { represented_as(read, want, dummy_span()) }
            },
          },
        },
        AsWord ->
          represented_as(
            bound_as(
              note_open_layouts(cx, st, v.ty),
              ty,
              AsWord,
              Get({ of: v, path: CasePath({ case: k.index, at: at }) }),
              dummy_span(),
            ),
            want,
            dummy_span(),
          ),
        _ -> unreachable(b"a constructor's argument read out of no sum: ".concat(k.full)),
      },
      _ -> { st: st, arg: ZeroOperand(want) },
    }
  }
}

fn list_item_type(v: Var) -> Option<Type> =
  if v.representation != AsWord && v.representation != AsListView { None } else { list_item(v.ty) }

fn list_and_start(st: Lowering, v: Var) -> { st: Lowering, list: Arg, from: Option<Arg> } =
  if v.representation != AsListView { { st: st, list: VarOperand(v), from: None } } else {
    let list = bound_as(st, v.ty, AsWord, Get({ of: v, path: LeafPath(0) }), dummy_span());
    let from = bound_as(
      list.st,
      int_type(),
      AsInt,
      Get({ of: v, path: LeafPath(1) }),
      dummy_span(),
    );
    { st: from.st, list: list.arg, from: Some(from.arg) }
  }

fn item_index(st: Lowering, from: Option<Arg>, at: Int) -> LoweredValue =
  match from {
    None -> { st: st, arg: IntOperand(at) },
    Some(f) -> if at == 0 { { st: st, arg: f } } else {
      bound_as(
        st,
        int_type(),
        AsInt,
        Primitive({ op: b"add", on: AsInt, args: [f, IntOperand(at)] }),
        dummy_span(),
      )
    },
  }

fn item_read(
  cx: Context,
  st: Lowering,
  list: Arg,
  from: Option<Arg>,
  item: Type,
  at: Int,
) -> LoweredValue = {
  let i = item_index(st, from, at);
  containers::item_read(cx, i.st, list, i.arg, item)
}

fn rest_read(st: Lowering, v: Var, list: Arg, from: Option<Arg>, n: Int) -> LoweredValue =
  match from {
    Some(_) -> {
      let i = item_index(st, from, n);
      bound_as(i.st, v.ty, AsListView, Aggregate({ parts: [list, i.arg] }), dummy_span())
    },
    None -> containers::rest_read(st, v.ty, list, IntOperand(n)),
  }

test "a test holds what follows it, nested in its arm" {
  let v = { id: 0, ty: named_type(b"m.T"), representation: AsWord };
  let tested = |body: Block|
    Case({ on: v, test: TagTest([b"m.A", b"m.B"]), arms: [{ when: 0, body: body }], rest: [Miss] });
  let decls = [Decl({ ..v, id: 1 }), Decl({ ..v, id: 2 })];
  assert_eq(nest([Decl(v), tested([])].concat(decls), [Miss]), [Decl(v), tested(decls)])
}
