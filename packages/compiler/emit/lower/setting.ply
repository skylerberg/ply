//! What a module's roots are lowered among: the module's and its imports' definitions with how
//! each crosses a call, its constructors, builtins and effects, and the types its check filed. The
//! emitter hands the lowering what it holds for every root; `setting_in` builds the same from an
//! analysed program, for lowering a program's text in tests.

import std.bin
import std.bytes
import std.bytes (ascii_of_int)
import compiler.syntax.parsing (Ident, Span, span_between, prelude_binder)
import compiler.syntax.type_syntax (Mode, MRead, MWrite, MRaise, MBad, mode_text, TypeExpr)
import compiler.syntax.items (case_params)
import compiler.check.types (Type, TyVar, TyCon, TyFn, TyRecord, TyNominal, Field, Scheme, int_type,
                             bool_type, float_type, decimal_type, bytes_type, fn_type, row_empty,
                             unit_type)
import compiler.emit.typing (Typed, Filings, filings, no_filings, filed_as, unknown_type)
import compiler.syntax.items (Module, Item, IFn, ITest, ILaw, FnDef, TestDef, LawDef, Binder,
                              INames, IModule, IAlias, test_run)
import compiler.syntax.exprs (Param, freed_by, case_at, case_identity, scheduler_module)
import compiler.check.resolve.tables (ParsedModule, Resolved, ModuleBinding, Binding, lookup,
                                      ValueSpace, qualify)
import compiler.check.resolve.scopes (of_module, of_binder)
import compiler.expand.rewrite (program_wide)
import compiler.check.infer (EmitFacts, RootFacts, expanded_mods, no_root_facts, item_owner)
import compiler.check.infer.checker (TypedSite, LabelSite, MemberSite, UpdateShape, TrySite,
                                     WitnessOp, WitnessRef, RowSite, Builtin, builtins, EffectInfo,
                                     OpInfo, ReleaseSite)
import compiler.check.infer.definitions (Extern, MachineCall, machine_calls, parsed_natives)
import compiler.front.facts (Analysis)
import compiler.front.seam (WalkedFacts, walked_facts_bin, ctors_read)
import compiler.front.rows (Rows, KnownDefRow, CtorRow, EffectRow, OpRow)
import compiler.front.published (facts_read, rows_of, walked_facts)
import compiler.emit.code (Code, lower_fn, Releasing)
import compiler.emit.reps (Def, Imported, Ctors, SumCtor, Ty, TyOpen, TyBytes, EffectName, OpMode,
                           EmitParam, ctors_of, ctor_sums, sig_of, def_entry, param_kinds,
                           param_types, typed_kind, type_vars, with_released)
import compiler.emit.c (Kind, KBoxed, KInt, KBool, KFloat, KDec, bytes_join_dots)
import compiler.emit.keys (RootKey, Named, LawBody, test_key, law_key, law_owner)

/// What the emitter hands the lowering for every root of one module: `builtins` are the natives the
/// program declares, `declared` the scheme the prelude declares each builtin at, by the same
/// name, over variables numbered from zero in the order a call's type arguments are filed, and
/// `machine` how a call of each native of a shipped module called over machine words crosses.
pub type Setting = {
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  ctors: Ctors,
  builtins: List<Bytes>,
  declared: Map<Bytes, Scheme>,
  machine: Map<Bytes, MachineCall>,
  effects: List<EffectName>,
  release: Bool,
}

/// A definition of the module as a root: its key, where its text starts, its parameters as the
/// emitter holds them (each label a trailing `Int`), the types its scheme gives them and its answer
/// (unknown where none speaks), its body lowered to `Code`, and what the checker filed for its
/// item's nodes.
pub type Root = {
  key: RootKey,
  base: Int,
  params: List<EmitParam>,
  types: List<Type>,
  answer_ty: Type,
  code: Code,
  filed: Filings,
}

/// Module `module` of the analysed program `a` as the emitter reads it, and each definition, test
/// and law it writes as a root, or why the program's facts cannot be read.
pub fn setting_in(
  a: Analysis,
  module: Bytes,
) -> Result<{ setting: Setting, roots: List<Root> }, Bytes> / {abort.raise} =
  match range(0, a.mods.len()).fold(None, |acc: Option<Int>, k: Int|
      if a.mods.get(k).name == module { Some(k) } else { acc }) {
    None -> Err(b"no such module"),
    Some(i) -> match settings_in(
        a,
        rows_of(a),
        walked_facts(a),
        a.mods,
        [i],
        |_: Int, s: Setting, rs: List<ItemRoot>|
          { setting: s, roots: rs.map(|r: ItemRoot| r.root) },
      ) {
      Err(why) -> Err(why),
      Ok(found) -> match found.at(0) { Some(x) -> Ok(x), None -> Err(b"no such module") },
    },
  }

/// The scheduler as an import of every module where the load read it, bound to its module's name,
/// which no source can write as a binder.
pub fn scheduler_imported(defs_of: (Bytes) -> List<Def>) -> List<Imported> = {
  let defs = defs_of(scheduler_module());
  if defs.len() == 0 { [] }
  else { [{ name: scheduler_module(), module: scheduler_module(), defs: defs, whole: true }] }
}

/// A body a module writes, a definition's, a test's or a law's, and its root. A test over cases is
/// its run's root, and a law its body's.
pub type ItemRoot = { item: Item, root: Root }

/// `each` of the modules at `wanted` among `mods`, which are `a`'s or what each was read from
/// again, handed what the emitter reads of it and its bodies as roots; `rows` and `walked` are what
/// `a`'s check read (`rows_of`, `walked_facts`), and the facts are read off them once.
pub fn settings_in<b | e>(
  a: Analysis,
  rows: Rows,
  walked: WalkedFacts,
  mods: List<ParsedModule>,
  wanted: List<Int>,
  each: (Int, Setting, List<ItemRoot>) -> b / {abort.raise | e},
) -> Result<List<b>, Bytes> / {abort.raise | e} =
  match facts_read(rows, walked, None, mods) {
    Err(why) -> Err(why),
    Ok(facts) -> {
      let expanded = expanded_mods(mods, facts.elaboration, a.r.signatures);
      let pure = facts.pure.fold(Map::new(), |acc: Map<Bytes, Bool>, n: Bytes| acc.insert(n, true));
      let schemes = rows.defs.fold(Map::new(), |acc: Map<Bytes, Scheme>, row: KnownDefRow|
        acc.insert(row.name, row.scheme));
      let by_name = expanded.fold(Map::new(), |acc: Map<Bytes, List<Def>>, m: ParsedModule|
        acc.insert(m.name, defs_in(m.name, m.module, pure, schemes)));
      let defs_of = |path: Bytes| match by_name.get(path) { Some(ds) -> ds, None -> [] };
      let read = ctors_read(a.checked);
      let ctors = with_released(
        ctors_of(
          read.rows.map(|c: CtorRow| c.name),
          read.keyed,
          read.numeric,
          ctor_sums(read.rows),
        ),
        read.released,
        |by: Bytes| schemes.get(by),
      );
      let declared = declared_schemes();
      let effects = declared_effects(a.r, checked_operations(a.checked.effects));
      let machine = machine_calls(parsed_natives(expanded));
      let owned = facts_by_item(facts);
      Ok(
        wanted.filter(|i: Int| i < expanded.len()).map(|i: Int| {
          let m = expanded.get(i);
          let here = defs_of(m.name);
          each(
            i,
            {
              module: m.name,
              here: here,
              imports: resolved_imports(
                a.r,
                i,
                expanded,
                m.module,
                defs_of,
                facts.elaboration.members.filter(|s: MemberSite| s.module == i),
              ).concat(
                scheduler_imported(defs_of),
              ),
              ctors: ctors,
              builtins: [],
              declared: declared,
              machine: machine,
              effects: effects_in(a.r, i, effects),
              release: false,
            },
            m.module.items.fold([], |acc: List<ItemRoot>, item: Item| {
              let filed = filings_of(owned, item_owner(m.name, item));
              match item {
                IFn(def) -> acc.push({ item: item, root: root_of(m.name, schemes, filed, def) }),
                ITest(t) -> acc.push({ item: item, root: test_root(m.name, filed, t) }),
                ILaw(l) -> acc.push({ item: item, root: law_root_of(m.name, filed, l) }),
                _ -> acc,
              }
            }),
          )
        }),
      )
    },
  }

/// What the checker filed of each item `facts` holds sites of, by the item's owner.
pub fn facts_by_item(facts: EmitFacts) -> Map<Bytes, RootFacts> = {
  let into = |m: Map<Bytes, RootFacts>, owner: Bytes, add: (RootFacts) -> RootFacts|
    m.insert(
      owner,
      add(match m.get(owner) { Some(f) -> f, None -> { ..no_root_facts(), types: facts.types } }),
    );
  let e = facts.elaboration;
  let labelled = facts.label_sites.fold(Map::new(), |m: Map<Bytes, RootFacts>, x: LabelSite|
    into(m, x.owner, |f: RootFacts| { ..f, label_sites: f.label_sites.push(x) }));
  let updated = e.updates.fold(labelled, |m: Map<Bytes, RootFacts>, x: UpdateShape|
    into(m, x.owner, |f: RootFacts| { ..f, updates: f.updates.push(x) }));
  let witnessed = e.ops.fold(updated, |m: Map<Bytes, RootFacts>, x: WitnessOp|
    into(m, x.owner, |f: RootFacts| { ..f, ops: f.ops.push(x) }));
  let referenced = e.refs.fold(witnessed, |m: Map<Bytes, RootFacts>, x: WitnessRef|
    into(m, x.owner, |f: RootFacts| { ..f, refs: f.refs.push(x) }));
  let tried = e.tries.fold(referenced, |m: Map<Bytes, RootFacts>, x: TrySite|
    into(m, x.owner, |f: RootFacts| { ..f, tries: f.tries.push(x) }));
  let released = e.releases.fold(tried, |m: Map<Bytes, RootFacts>, x: ReleaseSite|
    into(m, x.owner, |f: RootFacts| { ..f, releases: f.releases.push(x) }));
  let called = e.members.fold(released, |m: Map<Bytes, RootFacts>, x: MemberSite|
    into(m, x.owner, |f: RootFacts| { ..f, members: f.members.push(x) }));
  let typed = facts.typed.fold(called, |m: Map<Bytes, RootFacts>, x: TypedSite|
    into(m, x.owner, |f: RootFacts| { ..f, typed: f.typed.push(x) }));
  facts.rows.fold(typed, |m: Map<Bytes, RootFacts>, x: RowSite|
    into(m, x.owner, |f: RootFacts| { ..f, rows: f.rows.push(x) }))
}

/// What the checker filed for the nodes of the item `owner` names, by site; nothing for an item it
/// filed nothing of.
pub fn filings_of(owned: Map<Bytes, RootFacts>, owner: Bytes) -> Filings / {abort.raise} =
  match owned.get(owner) { None -> no_filings(), Some(f) -> filings(f) }

/// Where the body of an item, of whose nodes the checker filed `filed`, lets go of the resources it
/// owns, its parameters `params`.
pub fn releasing_of(filed: Filings, params: List<Param>) -> Releasing =
  { sites: filed.releases, params: params.map(|p: Param| p.name.span.site) }

/// Test `t` of `module` as the root a build makes of it: its run, which over cases takes a case's
/// place and identity.
fn test_root(module: Bytes, filed: Filings, t: TestDef) -> Root / {abort.raise} = {
  let names = if t.cases == None { [] } else { [case_at(), case_identity()] };
  let ps = params_carried(
    names,
    if t.cases == None { [] }
    else { [Some({ kind: KInt, ty: TyOpen([]) }), Some({ kind: KBoxed, ty: TyBytes })] },
    if t.cases == None { [] } else { [Some(int_type()), Some(bytes_type())] },
  );
  {
    key: test_key(module, t.name),
    base: t.span.start,
    params: ps,
    types: ps.map(param_type),
    answer_ty: unit_type(),
    code: lower_fn(
      match t.cases {
        Some(c) -> case_params(c).map(|p: { name: Ident, ty: TypeExpr }| p.name),
        None -> [],
      },
      [],
      filed.labels,
      test_run(t),
      of_binder(module),
      releasing_of(filed, []),
    ).code,
    filed: filed,
  }
}

/// Law `l` of `module` as the root a build makes of its body, its binders its parameters.
fn law_root_of(module: Bytes, filed: Filings, l: LawDef) -> Root / {abort.raise} = {
  let ps = law_params(law_owner(module, l.name), filed, l.binders);
  {
    key: law_key(module, l.name, LawBody),
    base: l.span.start,
    params: ps,
    types: ps.map(param_type),
    answer_ty: bool_type(),
    code: lower_fn(
      l.binders.map(|b: Binder| b.name),
      [],
      filed.labels,
      l.body,
      of_binder(module),
      releasing_of(filed, []),
    ).code,
    filed: filed,
  }
}

/// The binders of law `owner` as its roots take them, each of the type the checker filed for it and
/// held as a value of that type is. Panics on a binder it filed nothing for, as it files every one.
pub fn law_params(
  owner: Bytes,
  filed: Filings,
  binders: List<Binder>,
) -> List<EmitParam> / {abort.raise} = {
  let typed = filed.typed;
  match binders.find(|b: Binder| !typed.contains(b.span.site)) {
    Some(b) ->
      panic(
        String::of_bytes_lossy(
          Bytes::concat_all([
            b"a law's binder the check filed nothing for: `",
            owner,
            b"` site ",
            ascii_of_int(b.span.site),
            b" at ",
            ascii_of_int(b.span.start),
            b":",
            ascii_of_int(b.span.end),
          ]),
        ),
      ),
    None ->
      params_carried(
        binders.map(|b: Binder| b.name.name),
        binders.map(|b: Binder| Some(typed_kind(typed, b.span))),
        binders.map(|b: Binder|
          match typed.get(b.span.site) {
            Some(t) -> if t.ty == unknown_type() { None } else { Some(t.ty) },
            None -> None,
          }),
      ),
  }
}

/// Definition `def` of `module` as a root, as the emitter prepares one.
fn root_of(
  module: Bytes,
  schemes: Map<Bytes, Scheme>,
  filed: Filings,
  def: FnDef,
) -> Root / {abort.raise} = {
  let full = qualify(module, def.name.name);
  let sig = sig_of(schemes, full);
  let names = def.params.map(|p: Param| p.name.name);
  let labels = def.generics.labels.map(|i: Ident| i.name);
  let kinds = param_kinds(def, sig).map(|k: { kind: Kind, ty: Ty }| Some(k)).concat(
    labels.map(|_: Bytes| Some({ kind: KInt, ty: TyOpen([]) })),
  );
  let ps = params_carried(names.concat(labels), kinds, param_types(def, sig));
  {
    key: Named(full),
    base: def.span.start,
    params: ps,
    types: ps.map(param_type),
    answer_ty: match sig { Some(s) -> s.ret, None -> unknown_type() },
    code: lower_fn(
      def.params.map(|p: Param| p.name),
      labels,
      filed.labels,
      def.body,
      of_binder(module),
      releasing_of(filed, def.params),
    ).code,
    filed: filed,
  }
}

/// The type parameter `p` holds: the one its definition's scheme gives it, else the scalar the
/// emitter holds it as (a label's place is an `Int`), else unknown.
pub fn param_type(p: EmitParam) -> Type =
  match p.of {
    Some(t) -> t,
    None -> match p.kind {
      KInt -> int_type(),
      KBool -> bool_type(),
      KFloat -> float_type(),
      KDec -> decimal_type(),
      _ -> unknown_type(),
    },
  }

/// The name the program's constructor table gives the constructor written `written`. One qualified
/// by a binder (`binder::Name`) is the module the binder names, the prelude's binder the prelude; a
/// bare one is the module's own, else the one an import brought in by that name, else the prelude's,
/// so an import shadows a prelude constructor of the same name.
pub fn ctor_named(s: Setting, written: Bytes) -> Option<Bytes> =
  match qualified(written) {
    Some(q) -> if q.binder == prelude_binder() { tabled(s, q.name) } else {
      tabled(s, match module_import(s.imports, q.binder) {
        Some(imp) -> qualify(imp.module, q.name),
        None -> Bytes::concat_all([b"std.", q.binder, b".", q.name]),
      })
    },
    None -> match tabled(s, qualify(s.module, written)) {
      Some(own) -> Some(own),
      None -> match s.imports.fold(None, |acc: Option<Bytes>, imp: Imported|
          match acc {
            Some(_) -> acc,
            None -> if !imp.whole && imp.name == written { tabled(s, qualify(imp.module, written)) }
            else { None },
          }) {
        Some(imported) -> Some(imported),
        None -> tabled(s, written),
      },
    },
  }

/// The declared sum holding constructor `full`, as the table names it: its constructors in their
/// declared order, and `full`'s place among them.
pub fn ctor_sum(s: Setting, full: Bytes) -> Option<{ ctors: List<SumCtor>, index: Int }> =
  match s.ctors.sum_of.get(full) {
    None -> None,
    Some(sum) -> match s.ctors.sums.get(sum) {
      None -> None,
      Some(cs) -> match range(0, cs.len()).fold(None, |at: Option<Int>, i: Int|
          match at {
            Some(_) -> at,
            None -> match cs.at(i) {
              Some(c) -> if c.name == full { Some(i) } else { None },
              None -> None,
            },
          }) {
        Some(i) -> Some({ ctors: cs, index: i }),
        None -> None,
      },
    },
  }

/// The prelude's constructor `name` as code the emitter writes names it: through the prelude's
/// binder, which no declaration or import of the module the code is written in can take.
pub fn prelude_ctor(name: Bytes) -> Bytes = Bytes::concat_all([prelude_binder(), b"::", name])

fn tabled(s: Setting, name: Bytes) -> Option<Bytes> =
  if s.ctors.named.contains(name) { Some(name) } else { None }

/// Every builtin the prelude declares, by name, at the scheme its declaration gives it: what
/// `Setting.declared` holds. The prelude is read once.
pub fn declared_schemes() -> Map<Bytes, Scheme> / {abort.raise} =
  builtins().fold(Map::new(), |m: Map<Bytes, Scheme>, b: Builtin| m.insert(b.name, b.scheme))

/// The types a call takes and answers.
pub type CallTypes = { params: List<Type>, ret: Type }

/// The types builtin `name` is called at where its name is written at `callee`, of which `filed`
/// is what the checker filed: the function type filed there, else its declared scheme at the type
/// arguments filed there, which are all that code the emitter writes for a type files.
pub fn builtin_at(s: Setting, filed: Option<Typed>, name: Bytes) -> Option<CallTypes> =
  match filed {
    None -> declared_at(s, name, []),
    Some(t) -> match t.ty {
      TyFn(f) -> Some({ params: f.params, ret: f.ret }),
      _ -> declared_at(s, name, t.args),
    },
  }

/// The types builtin `name` takes and answers at type arguments `args`, one for each variable of
/// its scheme in the order they are filed; none where the prelude declares no such builtin or
/// `args` do not type each of its variables.
pub fn declared_at(s: Setting, name: Bytes, args: List<Type>) -> Option<CallTypes> =
  match s.declared.get(name) {
    None -> None,
    Some(sc) -> if sc.ty_vars.len() > 0 && args.len() != sc.ty_vars.len() { None } else {
      let by = range(0, sc.ty_vars.len()).fold(Map::new(), |m: Map<Int, Type>, i: Int|
        match sc.ty_vars.at(i) {
          Some(v) -> match args.at(i) { Some(t) -> m.insert(v, t), None -> m },
          None -> m,
        });
      match sc.ty {
        TyFn(f) ->
          Some({ params: f.params.map(|p: Type| substituted(p, by)), ret: substituted(f.ret, by) }),
        _ -> None,
      }
    },
  }

/// `ty` with each variable `by` types written as that type.
fn substituted(ty: Type, by: Map<Int, Type>) -> Type =
  match ty {
    TyVar(v) -> match by.get(v) { Some(t) -> t, None -> ty },
    TyCon(c) -> TyCon({ ..c, args: c.args.map(|a: Type| substituted(a, by)) }),
    TyFn(f) ->
      TyFn({
        ..f,
        params: f.params.map(|p: Type| substituted(p, by)),
        ret: substituted(f.ret, by),
      }),
    TyRecord(fs) -> TyRecord(fs.map(|f: Field| { ..f, ty: substituted(f.ty, by) })),
    TyNominal(x) ->
      TyNominal({
        ..x,
        args: x.args.map(|a: Type| substituted(a, by)),
        fields: x.fields.map(|f: Field| { ..f, ty: substituted(f.ty, by) }),
      }),
  }

/// The import a name no definition of the module answers to reaches, and the name there: one
/// qualified by a binder (`binder::name`) in the module the binder names, a bare one in the import
/// that brought it in by that name, else the prelude's where it defines one.
pub fn imported_target(
  imports: List<Imported>,
  name: Bytes,
) -> Option<{ imp: Imported, name: Bytes }> =
  match match qualified(name) {
      Some(q) -> match module_import(imports, q.binder) {
        Some(imp) -> Some({ imp: imp, name: q.name }),
        None -> None,
      },
      None -> match from_import(imports, name) {
        Some(imp) -> Some({ imp: imp, name: name }),
        None -> None,
      },
    } {
    Some(t) -> Some(t),
    None -> match module_import(imports, prelude_binder()) {
      Some(imp) -> if imp.defs.any(|d: Def| d.name == name) { Some({ imp: imp, name: name }) }
      else { None },
      None -> None,
    },
  }

/// The import that brought `name` in by that name.
pub fn from_import(xs: List<Imported>, name: Bytes) -> Option<Imported> =
  xs.fold(None, |acc: Option<Imported>, i: Imported|
    if !i.whole && i.name == name { Some(i) } else { acc })

/// `binder::name`'s two parts, where `name` is written so.
pub fn qualified(name: Bytes) -> Option<{ binder: Bytes, name: Bytes }> =
  match name.index_of(b"::") {
    None -> None,
    Some(i) -> match name.slice_at(0, i) {
      None -> None,
      Some(binder) -> match name.slice_at(i + 2, name.len() - i - 2) {
        Some(rest) -> Some({ binder: binder, name: rest }),
        None -> None,
      },
    },
  }

/// What the front end's check read, or nothing when its answer carried none or one this program does
/// not read.
pub fn walked_read(walked: Bytes) -> Option<WalkedFacts> / {abort.raise} =
  if walked.len() == 0 { None }
  else { match bin::decode(walked, walked_facts_bin()) { Ok(w) -> Some(w), Err(_) -> None } }

/// The definitions module `module`, parsed as `m`, writes, each as calls read it.
pub fn defs_in(
  module: Bytes,
  m: Module,
  pure: Map<Bytes, Bool>,
  schemes: Map<Bytes, Scheme>,
) -> List<Def> =
  m.items.fold([], |acc: List<Def>, item: Item|
    match item { IFn(d) -> acc.push(def_entry(module, d, pure, schemes)), _ -> acc })

/// Parameters `names` held as `kinds` say, and of the type `types` gives each.
pub fn params_carried(
  names: List<Bytes>,
  kinds: List<Option<{ kind: Kind, ty: Ty }>>,
  types: List<Option<Type>>,
) -> List<EmitParam> =
  range(0, names.len()).map(|i: Int|
    {
      name: match names.at(i) { Some(n) -> n, None -> b"" },
      kind: match kinds.at(i) { Some(Some(p)) -> p.kind, _ -> KInt },
      ty: match kinds.at(i) { Some(Some(p)) -> p.ty, _ -> TyOpen([]) },
      of: match types.at(i) { Some(t) -> t, None -> None },
      lambda: None,
    })

/// Every effect the program declares, written as a clause the lowering writes names it, by its
/// program-wide name, with its operations as `operations` holds them.
pub fn declared_effects(resolved: Resolved, operations: Operations) -> List<EffectName> =
  range(0, resolved.declared.len()).fold([], |acc: List<EffectName>, j: Int|
    match resolved.declared.at(j) {
      None -> acc,
      Some(theirs) ->
        theirs.effects.fold(acc, |a: List<EffectName>, b: Binding|
          a.push({
            written: program_wide(b.qualified),
            global: b.qualified,
            ops: match operations.get(b.qualified) { Some(xs) -> xs, None -> [] },
          })),
    })

/// The effects module `i` names, bare or through a module's binder, then every one of `declared`,
/// the program's: each with the operations of the effect its program-wide name names.
pub fn effects_in(resolved: Resolved, i: Int, declared: List<EffectName>) -> List<EffectName> = {
  let ops = |global: Bytes|
    match declared.find(|e: EffectName| e.global == global) { Some(e) -> e.ops, None -> [] };
  let named = match resolved.scopes.at(i) {
    None -> [],
    Some(scope) -> {
      let bare = scope.bound.effects.map(|b: Binding|
        { written: b.name, global: b.qualified, ops: ops(b.qualified) });
      scope.modules.fold(bare, |acc: List<EffectName>, mb: ModuleBinding|
        match resolved.declared.at(mb.target) {
          None -> acc,
          Some(theirs) ->
            theirs.effects.fold(acc, |a: List<EffectName>, b: Binding|
              a.push({
                written: Bytes::concat_all([mb.binder, b"::", b.name]),
                global: b.qualified,
                ops: ops(b.qualified),
              })),
        })
    },
  };
  named.concat(declared)
}

/// Each effect's operations as a perform reads them, by the effect's program-wide name.
pub type Operations = Map<Bytes, List<OpMode>>

/// Operation `o` as its check typed it, as a perform reads it: its parameters and answer, and its
/// own type parameters (`own_of`).
pub fn op_mode_of(o: OpInfo) -> OpMode =
  {
    name: o.name,
    mode: o.mode,
    params: o.params,
    ret: o.ret,
    own: own_of(o.scheme, o.params, o.ret),
  }

/// The own type parameters of an operation of `params` and answer `ret`: the variables `scheme`
/// quantifies, where it has one, else every variable its types name, which are its own alone, in the
/// order they first stand.
fn own_of(scheme: Option<Scheme>, params: List<Type>, ret: Type) -> List<Int> =
  match scheme {
    Some(s) -> s.ty_vars,
    None ->
      params.push(ret).fold([], |acc: List<Int>, t: Type|
        type_vars(t).fold(acc, |a: List<Int>, v: Int| if a.contains(v) { a } else { a.push(v) })),
  }

/// The operations of each of `effects`, as a check typed them.
pub fn checked_operations(effects: List<EffectInfo>) -> Operations =
  effects.fold(Map::new(), |acc: Operations, e: EffectInfo|
    acc.insert(e.name, e.ops.map(op_mode_of)))

/// The operations of each of `effects`, as a front end's answer publishes them.
pub fn published_operations(effects: List<EffectRow>) -> Operations =
  effects.fold(Map::new(), |acc: Operations, e: EffectRow|
    acc.insert(
      e.name,
      e.ops.map(|o: OpRow|
        {
          name: o.name,
          mode: match [MRead, MWrite, MRaise].find(|m: Mode| mode_text(m) == o.mode) {
            Some(m) -> m,
            None -> MBad,
          },
          params: o.params,
          ret: o.ret,
          own: own_of(o.scheme, o.params, o.ret),
        }),
    ))

/// What module `index`, parsed as `x_module`, imports: each import as it is written and as it
/// resolves, then each module a function of a type or a copied default is named through by a binder
/// no import wrote. A dependency's sibling import is written bare and means the module of the same
/// package, which the scope's binders name.
pub fn resolved_imports(
  resolved: Resolved,
  index: Int,
  mods: List<ParsedModule>,
  x_module: Module,
  defs_of: (Bytes) -> List<Def>,
  members: List<MemberSite>,
) -> List<Imported> / {abort.raise} = {
  let written = range(0, x_module.imports.len()).fold([], |acc: List<Imported>, j: Int| {
    let im = x_module.imports.get(j);
    let full = match resolved.imports.get(index).at(j) {
      Some(t) -> mods.get(t).name,
      None -> bytes_join_dots(im.path.map(|i: Ident| i.name)),
    };
    match im.kind {
      INames(ns) ->
        ns.fold(acc, |a: List<Imported>, n: Ident|
          a.push({ name: n.name, module: full, defs: defs_of(full), whole: false })),
      IModule ->
        acc.push({
          name: match im.path.at(im.path.len() - 1) { Some(i) -> i.name, None -> b"" },
          module: full,
          defs: defs_of(full),
          whole: true,
        }),
      // A module the parser imports for names read with no import names each the resolver bound
      // to it.
      IAlias(a2) ->
        freed_by(a2.name).fold(
          acc.push({ name: a2.name, module: full, defs: defs_of(full), whole: true }),
          |a: List<Imported>, n: Bytes|
            match resolved.scopes.at(index) {
              Some(sc) -> match lookup(sc.bound, ValueSpace, n) {
                Some(b) -> if b.qualified != qualify(full, n) { a }
                else { a.push({ name: n, module: full, defs: defs_of(full), whole: false }) },
                None -> a,
              },
              None -> a,
            },
        ),
    }
  });
  // A function of a type is named through a binder of its module no import wrote, and so is each
  // name of a default a call on a value copied.
  let through = members.fold(written, |acc: List<Imported>, m: MemberSite|
    List::concat(match of_module(m.qualifier) { Some(home) -> [home], None -> [] }, m.reaches).fold(
      acc,
      |a: List<Imported>, home: Bytes|
        match module_import(a, of_binder(home)) {
          Some(_) -> a,
          None -> a.push({ name: of_binder(home), module: home, defs: defs_of(home), whole: true }),
        },
    ));
  match resolved.scopes.at(index) {
    None -> through,
    Some(scope) ->
      scope.modules.fold(through, |acc: List<Imported>, mb: ModuleBinding|
        match module_import(acc, mb.binder) {
          Some(_) -> acc,
          None -> {
            let full = mods.get(mb.target).name;
            acc.push({ name: mb.binder, module: full, defs: defs_of(full), whole: true })
          },
        }),
  }
}

/// The import that binds a whole module to `binder`.
pub fn module_import(xs: List<Imported>, binder: Bytes) -> Option<Imported> =
  xs.fold(None, |acc: Option<Imported>, i: Imported|
    if i.whole && i.name == binder { Some(i) } else { acc })

/// A setting of module `m` importing `imports`, whose program declares constructors `names`, the
/// prelude's `Less` and `Equal` an `Ordering`'s.
fn ctor_setting(imports: List<Imported>, names: List<Bytes>) -> Setting =
  {
    module: b"m",
    here: [],
    imports: imports,
    ctors: ctors_of(
      names,
      [],
      [],
      Map::new().insert(b"Ordering", [
        { name: b"Less", index: 0, fields: [], params: [] },
        { name: b"Equal", index: 1, fields: [], params: [] },
      ]),
    ),
    builtins: [],
    declared: Map::new(),
    machine: Map::new(),
    effects: [],
    release: false,
  }

test "a builtin is typed by the checker's filing where it called it, else by its declared scheme at the filed type arguments" {
  let s = { ..ctor_setting([], []), declared: declared_schemes() };
  let ints = TyCon({ name: b"List", args: [int_type()] });
  let len = Some({ params: [ints], ret: int_type() });
  assert_eq(declared_at(s, b"List::len", [int_type()]), len);
  // A generic builtin at no type arguments, or a name the prelude declares nothing by, is untyped.
  assert_eq(declared_at(s, b"List::len", []), None);
  assert_eq(declared_at(s, b"m.nothing", []), None);
  // Code the emitter writes for a type files only the type arguments.
  assert_eq(builtin_at(s, Some(filed_as(unknown_type(), [int_type()])), b"List::len"), len);
  let checked = fn_type([bytes_type()], int_type(), row_empty());
  assert_eq(
    builtin_at(s, Some(filed_as(checked, [int_type()])), b"List::len"),
    Some({ params: [bytes_type()], ret: int_type() }),
  )
}

test "a bare constructor is the module's own, else an import's, else the prelude's; one through the prelude's binder is the prelude's alone" {
  let names = [b"Less", b"Equal", b"lib.Equal", b"m.Box"];
  let by_name = { name: b"Equal", module: b"lib", defs: [], whole: false };
  let whole = { name: b"lib", module: b"lib", defs: [], whole: true };
  assert_eq(ctor_named(ctor_setting([by_name], names), b"Equal"), Some(b"lib.Equal"));
  assert_eq(ctor_named(ctor_setting([], names), b"Equal"), Some(b"Equal"));
  assert_eq(ctor_named(ctor_setting([], names.push(b"m.Equal")), b"Equal"), Some(b"m.Equal"));
  assert_eq(ctor_named(ctor_setting([whole], names), b"lib::Equal"), Some(b"lib.Equal"));
  assert_eq(ctor_named(ctor_setting([], names), b"Box"), Some(b"m.Box"));
  assert_eq(ctor_named(ctor_setting([], names), b"Gone"), None);
  // Through the prelude's binder, as code the emitter writes names one, it is the prelude's whatever
  // the module declares or imports.
  assert_eq(
    ctor_named(ctor_setting([by_name], names.push(b"m.Equal")), prelude_ctor(b"Equal")),
    Some(b"Equal"),
  );
  assert_eq(ctor_named(ctor_setting([], names), prelude_ctor(b"Box")), None);
  assert_eq(
    ctor_sum(ctor_setting([], names), b"Equal"),
    Some({
      ctors: [
        { name: b"Less", index: 0, fields: [], params: [] },
        { name: b"Equal", index: 1, fields: [], params: [] },
      ],
      index: 1,
    }),
  );
  assert_eq(ctor_sum(ctor_setting([], names), b"m.Box"), None)
}
