import compiler.syntax.parsing (Span)
import compiler.check.types (Type, NamedType, RecordType, NominalType, Field)
import compiler.emit.typing (unknown_type)
import compiler.emit.representations (Ctors, SumCtor, open_vars)
import compiler.emit.c (sorted_names)
import compiler.emit.output (Layout)
import compiler.emit.layout (SumLayout, Boxed, words, tag_bits)
import compiler.emit.typed_ir (Representation, AsWord, AsFlattened, AsSum, AsUnit, Leaf, Var, Arg,
                               VarOperand, IntOperand, ZeroOperand, Allocate, CaseAllocation,
                               RecordAllocation, FromArgument, Get, Aggregate, Update, FieldWrite,
                               LeafPath, FieldPath, InlineRecordPath, operand_representation,
                               read_only, read_records)
import compiler.emit.lower.module_context (ctor_sum)
import compiler.emit.lower.representation (representation_of, leaf_spans, leaves_within, field_type,
                                           field_offsets, case_index, leaf_type, layout_leaves,
                                           leaves_inside, record_parts, record_fields, RecordPart,
                                           case_parts, inline_with_header)
import compiler.emit.lower.base (Context, Lowering, LoweredValue, unreachable, bound_as,
                                 represented_as, noted, packed_from, deferred_to_specialisation)

pub fn constructed(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = constructed_as(cx, st, name, args, ty, at)

pub fn constructed_as(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ctor = name;
  {
    let r = representation_of(cx.setting, ty);
    match r {
      AsSum(s) -> match case_index(r, ctor) {
        Some(i) -> case_gathered(cx, st, ty, s, i, args, at),
        None -> unreachable(b"a constructor its sum's cases do not hold: ".concat(ctor)),
      },
      AsUnit -> { st: st, arg: ZeroOperand(AsUnit) },
      _ -> if open_vars(cx.setting.ctors, ty) == [] {
        unreachable(b"a constructor at a type no declared sum or variable lays out: ".concat(ctor))
      } else { open_layout_constructed(cx, st, ty, ctor, args, at) },
    }
  }
}

fn open_layout_constructed(
  cx: Context,
  st: Lowering,
  ty: Type,
  ctor: Bytes,
  args: List<Arg>,
  at: Span,
) -> LoweredValue = {
  let sum = ctor_sum(cx.setting, ctor);
  let i = match sum { Some(x) -> x.index, None -> 0 };
  let held = all_represented_as(
    note_open_layouts(cx, st, ty),
    args.map(|a: Arg| { arg: a, to: AsWord }),
    at,
  );
  let inline = args.len() == 0
    || (match ((sum, ty)) {
      (Some(x), NamedType(c)) -> inline_everywhere(cx.setting.ctors, c.name, x.ctors, i),
      _ -> false,
    });
  bound_as(
    held.st,
    ty,
    AsWord,
    if inline { Aggregate({ parts: [IntOperand(i)].concat(held.args) }) } else {
      Allocate({
        made: CaseAllocation({ case: i, skip: 0, words: args.len() }),
        args: held.args,
        reuse: None,
      })
    },
    at,
  )
}

fn inline_everywhere(ctors: Ctors, sum: Bytes, cs: List<SumCtor>, i: Int) -> Bool =
  !(match ctors.recursive.get(sum) { Some(r) -> r.indirect.at(i) == Some(true), None -> false })
    && cs.filter(|c: SumCtor| c.fields.len() > 0).len() <= 1 << tag_bits()

pub fn note_open_layouts(cx: Context, st: Lowering, ty: Type) -> Lowering =
  open_vars(cx.setting.ctors, ty).fold(st, |s: Lowering, v: Int|
    noted(s, { var: v, reads: Layout }))

fn case_gathered(
  cx: Context,
  st: Lowering,
  ty: Type,
  s: { layout: SumLayout, cases: List<Bytes> },
  i: Int,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let cps = case_parts(cx.setting.ctors, ty, i);
  if cps.len() != args.len() { unreachable(b"a constructor applied to other than its arguments") }
  else {
    let held = all_represented_as(
      st,
      range(0, args.len()).fold([], |acc: List<{ arg: Arg, to: Representation }>, k: Int|
        match ((args.at(k), cps.at(k))) {
          (Some(a), Some(cp)) -> acc.push({ arg: a, to: cp.representation }),
          _ -> acc,
        }),
      at,
    );
    let r = AsSum(s);
    match s.layout.cases.at(i) {
      Some(c) -> match c.payload {
        Boxed(b) -> {
          let boxed = bound_as(
            held.st,
            ty,
            AsWord,
            Allocate({
              made: CaseAllocation({ case: i, skip: b.skip, words: words(b.layout) }),
              args: held.args,
              reuse: None,
            }),
            at,
          );
          bound_as(boxed.st, ty, r, Aggregate({ parts: [IntOperand(i), boxed.arg] }), at)
        },
        _ -> bound_as(held.st, ty, r, Aggregate({ parts: [IntOperand(i)].concat(held.args) }), at),
      },
      None -> unreachable(b"a case its sum's layout does not hold"),
    }
  }
}

fn all_represented_as(
  st: Lowering,
  xs: List<{ arg: Arg, to: Representation }>,
  at: Span,
) -> { st: Lowering, args: List<Arg> } =
  xs.fold(
    { st: st, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, x: { arg: Arg, to: Representation }| {
      let h = represented_as({ st: acc.st, arg: x.arg }, x.to, at);
      { st: h.st, args: acc.args.push(h.arg) }
    },
  )

pub fn record_literal(
  cx: Context,
  st: Lowering,
  fields: List<{ name: Bytes, arg: Arg }>,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = record_literal_as(cx, st, fields, ty, at)

pub fn record_literal_as(
  cx: Context,
  st: Lowering,
  fields: List<{ name: Bytes, arg: Arg }>,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let value = |name: Bytes|
    fields.fold(None, |acc: Option<Arg>, f: { name: Bytes, arg: Arg }|
      if f.name == name { Some(f.arg) } else { acc });
  let rep = representation_of(cx.setting, ty);
  if rep == AsUnit { { st: st, arg: ZeroOperand(AsUnit) } } else {
    match layout_leaves(cx.setting.ctors, ty) {
      Some(ls) -> {
        let given = record_parts(cx.setting.ctors, ty).fold(
          { xs: [], missing: false },
          |acc: { xs: List<{ arg: Arg, to: Representation }>, missing: Bool }, p: RecordPart|
            match value(p.name) {
              Some(a) -> { ..acc, xs: acc.xs.push({ arg: a, to: p.representation }) },
              None -> { ..acc, missing: true },
            },
        );
        if given.missing { unreachable(b"a record literal missing a field its type holds") } else {
          let parts = all_represented_as(st, given.xs, at);
          record_built(parts.st, ty, ls, rep, parts.args, at)
        }
      },
      None -> {
        let names = names_of(ty, fields.map(|f: { name: Bytes, arg: Arg }| f.name));
        let given = names.fold([], |acc: List<Arg>, n: Bytes|
          match value(n) { Some(a) -> acc.push(a), None -> acc });
        if given.len() != names.len() {
          unreachable(b"a record literal missing a field its type holds")
        } else {
          deferred_to_specialisation(
            note_open_layouts(cx, st, ty),
            ty,
            AsWord,
            read_records(given),
            at,
          )
        }
      },
    }
  }
}

fn record_built(
  st: Lowering,
  ty: Type,
  ls: List<Leaf>,
  rep: Representation,
  parts: List<Arg>,
  at: Span,
) -> LoweredValue =
  if rep == AsWord {
    bound_as(
      st,
      ty,
      AsWord,
      Allocate({
        made: RecordAllocation(parts.map(|_: Arg| FromArgument)),
        args: parts,
        reuse: None,
      }),
      at,
    )
  } else { record_represented_as(gathered_record(st, ty, ls, parts, at), rep, at) }

fn record_represented_as(flat: LoweredValue, rep: Representation, at: Span) -> LoweredValue =
  if operand_representation(flat.arg) == rep { flat } else { represented_as(flat, rep, at) }

fn gathered_record(
  st: Lowering,
  ty: Type,
  ls: List<Leaf>,
  parts: List<Arg>,
  at: Span,
) -> LoweredValue = bound_as(st, ty, AsFlattened(ls), Aggregate({ parts: parts }), at)

fn names_of(ty: Type, written: List<Bytes>) -> List<Bytes> =
  match ty {
    RecordType(fs) -> fs.map(|f: Field| f.name),
    NominalType(x) -> x.fields.map(|f: Field| f.name),
    _ -> sorted_names(written),
  }

pub fn field(
  cx: Context,
  base: LoweredValue,
  name: Bytes,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let lies = match base.arg {
    VarOperand(b) -> match ((b.representation, layout_leaves(cx.setting.ctors, b.ty))) {
      (AsWord, Some(ls)) -> match packed_from(base.st, b, AsFlattened(ls)) {
        Some(s) -> { st: base.st, arg: VarOperand(s) },
        None -> base,
      },
      _ -> base,
    },
    _ -> base,
  };
  match lies.arg {
    VarOperand(b) -> {
      let fty = match field_type(b.ty, name) { Some(t) -> t, None -> unknown_type() };
      match read_field(
          cx,
          lies.st,
          b,
          field_layout(cx, b),
          name,
          fty,
          representation_of(cx.setting, fty),
          at,
        ) {
        None -> unreachable(b"a field its record does not hold: ".concat(name)),
        Some(r) -> r,
      }
    },
    ZeroOperand(AsUnit) -> { st: lies.st, arg: ZeroOperand(AsUnit) },
    _ -> unreachable(b"a field of a value that is no record: ".concat(name)),
  }
}

type FieldLayout =
  | Spans({ leaves: List<Leaf>, of: Map<Bytes, { at: Int, n: Int }> })
  | Offsets(Map<Bytes, Int>)
  | Empty
  | Open

fn field_layout(cx: Context, b: Var) -> FieldLayout =
  match b.representation {
    AsFlattened(ls) -> Spans({ leaves: ls, of: leaf_spans(ls) }),
    AsUnit -> Empty,
    _ -> match layout_leaves(cx.setting.ctors, b.ty) {
      Some(_) -> Offsets(field_offsets(cx.setting, b.ty)),
      None -> if representation_of(cx.setting, b.ty) == AsUnit { Empty } else { Open },
    },
  }

fn read_field(
  cx: Context,
  st: Lowering,
  b: Var,
  lay: FieldLayout,
  name: Bytes,
  fty: Type,
  want: Representation,
  at: Span,
) -> Option<LoweredValue> / {abort.raise} =
  if want == AsUnit { Some({ st: st, arg: ZeroOperand(AsUnit) }) } else {
    let nested = leaves_inside(cx.setting.ctors, fty);
    let as_wanted = |l: LoweredValue|
      if operand_representation(l.arg) == want { l } else { represented_as(l, want, at) };
    match lay {
      Spans(s) -> match s.of.get(name) {
        None -> None,
        Some(sp) -> Some(as_wanted(leaves_read(st, b, s.leaves, sp, fty, nested != None, at))),
      },
      Offsets(offsets) -> match offsets.get(name) {
        None -> None,
        Some(o) -> {
          let read = if inline_with_header(cx.setting.ctors, fty) {
            Get({ of: b, path: InlineRecordPath(o) })
          } else { Get({ of: b, path: FieldPath({ name: name, at: o }) }) };
          Some(match nested {
            Some(ls) -> as_wanted(bound_as(st, fty, AsFlattened(ls), read, at)),
            None -> bound_as(st, fty, want, read, at),
          })
        },
      },
      Empty -> None,
      Open ->
        Some(
          deferred_to_specialisation(
            note_open_layouts(cx, st, b.ty),
            fty,
            want,
            read_only([VarOperand(b)]),
            at,
          ),
        ),
    }
  }

fn leaves_read(
  st: Lowering,
  b: Var,
  ls: List<Leaf>,
  sp: { at: Int, n: Int },
  fty: Type,
  record: Bool,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let one = |s: Lowering, k: Int, ty: Type|
    bound_as(s, ty, leaf_representation(ls, k), Get({ of: b, path: LeafPath(k) }), at);
  if !record { one(st, sp.at, fty) } else {
    let inner = leaves_within(ls, sp);
    let read = range(0, inner.len()).fold(
      { st: st, parts: [] },
      |acc: { st: Lowering, parts: List<Arg> }, j: Int| {
        let name = match inner.at(j) { Some(l) -> l.name, None -> b"" };
        let g = match leaf_type(fty, name) {
          Some(t) -> one(acc.st, sp.at + j, t),
          None -> unreachable(b"a leaf its record's type does not hold: ".concat(name)),
        };
        { st: g.st, parts: acc.parts.push(g.arg) }
      },
    );
    bound_as(read.st, fty, AsFlattened(inner), Aggregate({ parts: read.parts }), at)
  }
}

fn leaf_representation(ls: List<Leaf>, k: Int) -> Representation =
  match ls.at(k) { Some(l) -> l.representation, None -> AsWord }

pub fn record_update(
  cx: Context,
  st: Lowering,
  base: Arg,
  copies: List<Bytes>,
  sets: List<{ name: Bytes, arg: Arg }>,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match base {
    VarOperand(b) -> {
      let rep = representation_of(cx.setting, ty);
      if rep == AsUnit { { st: st, arg: ZeroOperand(AsUnit) } } else {
        match layout_leaves(cx.setting.ctors, ty) {
          Some(ls) -> {
            let given = sets.fold(Map::new(), |m: Map<Bytes, Arg>, f: { name: Bytes, arg: Arg }|
              m.insert(f.name, f.arg));
            let kept = copies.fold(Map::new(), |m: Map<Bytes, Bool>, n: Bytes| m.insert(n, true));
            let lay = field_layout(cx, b);
            let parts_of_ty = record_parts(cx.setting.ctors, ty);
            let in_place = rep == AsWord && b.representation == AsWord
              && record_fields(b.ty) == record_fields(ty)
              && parts_of_ty.all(|p: RecordPart| given.contains(p.name) || kept.contains(p.name));
            if in_place { box_fields_written(cx, st, b, ty, sets, at) } else {
              let parts = parts_of_ty.fold(
                { st: st, parts: [], missing: false },
                |acc: { st: Lowering, parts: List<Arg>, missing: Bool }, p: RecordPart| {
                  match given.get(p.name) {
                    Some(a) -> {
                      let h = represented_as({ st: acc.st, arg: a }, p.representation, at);
                      { ..acc, st: h.st, parts: acc.parts.push(h.arg) }
                    },
                    None -> if !kept.contains(p.name) { { ..acc, missing: true } } else {
                      match read_field(cx, acc.st, b, lay, p.name, p.ty, p.representation, at) {
                        None -> { ..acc, missing: true },
                        Some(r) -> { ..acc, st: r.st, parts: acc.parts.push(r.arg) },
                      }
                    },
                  }
                },
              );
              if parts.missing {
                unreachable(b"an update of a field its base does not hold where its type lays it")
              } else { record_built(parts.st, ty, ls, rep, parts.parts, at) }
            }
          },
          None ->
            deferred_to_specialisation(
              note_open_layouts(cx, note_open_layouts(cx, st, b.ty), ty),
              ty,
              AsWord,
              [{ arg: VarOperand(b), takes: true }].concat(
                read_records(sets.map(|f: { name: Bytes, arg: Arg }| f.arg)),
              ),
              at,
            ),
        }
      }
    },
    _ -> unreachable(b"an update of a value that is no record"),
  }

fn box_fields_written(
  cx: Context,
  st: Lowering,
  b: Var,
  ty: Type,
  sets: List<{ name: Bytes, arg: Arg }>,
  at: Span,
) -> LoweredValue = {
  let offsets = field_offsets(cx.setting, ty);
  let written = sets.fold(
    { st: st, sets: [] },
    |acc: { st: Lowering, sets: List<FieldWrite> }, f: { name: Bytes, arg: Arg }| {
      let fty = match field_type(ty, f.name) { Some(t) -> t, None -> unknown_type() };
      let laid = representation_of(cx.setting, fty);
      match offsets.get(f.name) {
        Some(o) -> if laid == AsUnit { acc } else {
          let h = represented_as({ st: acc.st, arg: f.arg }, laid, at);
          { st: h.st, sets: acc.sets.push({ at: o, ty: fty, arg: h.arg }) }
        },
        None -> acc,
      }
    },
  );
  bound_as(written.st, ty, AsWord, Update({ of: b, sets: written.sets }), at)
}
