//! Records, constructors, fields, updates and constants, as their types lay them out. A record is
//! gathered from its fields' values into its leaves, and a sum's case from its place and its
//! arguments into the sum's words, a boxed case's arguments made its box first; a value of no words
//! is no value at all. One whose layout a type variable leaves open is made as a placeholder whose
//! layout is a need its callers' specialisations settle. A field is read where its record holds it,
//! and an update gathers its record from the fields it keeps of its base and the ones it sets.

import syntax.parsing (Span)
import check.types (Type, TyCon, TyFn, TyRecord, TyNominal, Field)
import emit.typing (unknown_type)
import emit.reps (Ctors, SumCtor, open_vars, ctor_fields_at)
import emit.c (sorted_names)
import emit.answer (Layout)
import emit.layout (SumLaid, Boxed, words, tag_bits)
import emit.tir (Rep, RWord, RFlat, RSum, RUnit, Leaf, Var, Arg, AVar, AInt, AZero, Make, MRecord,
                 MCase, Get, Gathered, PLeaf, PNamed, PField, Data, rep_of_arg)
import emit.lower.setting (ctor_named, ctor_sum)
import emit.lower.held (held_as, leaf_span, leaf_spans, leaves_within, field_type, field_types,
                        field_offsets, case_index, leaf_type, laid_leaves, laid_held)
import emit.lower.base (Context, Lowering, Lowered, refuse, bound_as, handed, filed, unfiled, noted)

/// Constructor `name`, written at `ctor_at`, applied to `args` by the call at `at`, made at the type
/// the checker filed for the constructor.
pub fn constructed(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ctor_at: Span,
  at: Span,
) -> Lowered =
  match filed(cx, ctor_at) {
    None -> unfiled(cx, st, b"a constructor", ctor_at),
    Some(t) ->
      constructed_as(
        cx,
        st,
        name,
        args,
        match t.ty { TyFn(f) -> if args.len() > 0 { f.ret } else { t.ty }, other -> other },
        at,
      ),
  }

/// Constructor `name` applied to `args`, making a value of type `ty`: gathered into the sum's words
/// where its type lays it out, no value where it lays it in none, and a placeholder where a type
/// variable leaves the layout open. Declined at a type neither lays out, which nothing settles: one
/// filed at no type among them.
pub fn constructed_as(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ty: Type,
  at: Span,
) -> Lowered =
  match ctor_named(cx.setting, name) {
    None -> refuse(st, Data, b"a constructor not in the table: ".concat(name)),
    Some(ctor) -> {
      let r = held_as(cx.setting, ty);
      match r {
        RSum(s) -> match case_index(r, ctor) {
          Some(i) -> case_gathered(cx, st, ty, s, i, args, at),
          None -> refuse(st, Data, b"a constructor its sum's cases do not hold: ".concat(ctor)),
        },
        RUnit -> { st: st, arg: AZero(RUnit) },
        _ -> if open_vars(cx.setting.ctors, ty) == [] {
          refuse(
            st,
            Data,
            b"a constructor at a type no declared sum or variable lays out: ".concat(ctor),
          )
        } else { open_made(cx, st, ty, ctor, args, at) },
      }
    },
  }

/// Constructor `ctor` of `args` of a sum of type `ty` a type variable leaves the layout of open, a
/// placeholder no printer sees, the layout a need of each such variable, which the specialisations
/// its callers settle lay out: a case every one of them lays in the sum's own words gathered from
/// its place and its arguments, each as its word, as it is wherever it is laid out (a case of none
/// a constant); any other case boxed with each argument as its word.
fn open_made(
  cx: Context,
  st: Lowering,
  ty: Type,
  ctor: Bytes,
  args: List<Arg>,
  at: Span,
) -> Lowered = {
  let sum = ctor_sum(cx.setting, ctor);
  let i = match sum { Some(x) -> x.index, None -> 0 };
  let held = handed_all(open_needed(cx, st, ty), args.map(|a: Arg| { arg: a, to: RWord }), at);
  let inline = args.len() == 0
    || (match ((sum, ty)) {
      (Some(x), TyCon(c)) -> inline_everywhere(cx.setting.ctors, c.name, x.ctors, i),
      _ -> false,
    });
  bound_as(
    held.st,
    ty,
    RWord,
    if inline { Gathered({ parts: [AInt(i)].concat(held.args) }) } else {
      Make({ made: MCase({ case: i, skip: 0, words: args.len() }), args: held.args, reuse: None })
    },
    at,
  )
}

/// Whether case `i` of the sum named `sum`, of constructors `cs`, lies in the sum's own words at any
/// type its arguments take: boxed for no recursion, and among few enough cases with arguments that
/// pointer tags never run out, past which `layout.sum_laid` boxes a case.
fn inline_everywhere(ctors: Ctors, sum: Bytes, cs: List<SumCtor>, i: Int) -> Bool =
  !(match ctors.recursive.get(sum) { Some(r) -> r.indirect.at(i) == Some(true), None -> false })
    && cs.filter(|c: SumCtor| c.fields.len() > 0).len() <= 1 << tag_bits()

/// `st` noting the layout of each type variable a value of `ty` is laid out by, which a
/// specialisation at known types lays out.
pub fn open_needed(cx: Context, st: Lowering, ty: Type) -> Lowering =
  open_vars(cx.setting.ctors, ty).fold(st, |s: Lowering, v: Int|
    noted(s, { var: v, reads: Layout }))

/// Case `i` of `args` of a sum of type `ty` laid as `s`: its place and its arguments, each held as
/// its type is, gathered into the sum's words; a boxed case's arguments made its box first.
fn case_gathered(
  cx: Context,
  st: Lowering,
  ty: Type,
  s: { laid: SumLaid, cases: List<Bytes> },
  i: Int,
  args: List<Arg>,
  at: Span,
) -> Lowered = {
  let types = match ty {
    TyCon(c) -> match cx.setting.ctors.sums.get(c.name) {
      Some(cs) -> match cs.at(i) { Some(k) -> ctor_fields_at(k, c.args), None -> [] },
      None -> [],
    },
    _ -> [],
  };
  if types.len() != args.len() {
    refuse(st, Data, b"a constructor applied to other than its arguments")
  } else {
    let held = handed_all(
      st,
      range(0, args.len()).fold([], |acc: List<{ arg: Arg, to: Rep }>, k: Int|
        match args.at(k) {
          Some(a) ->
            acc.push({
              arg: a,
              to: laid_held(cx.setting.ctors, match types.at(k) {
                Some(t) -> t,
                None -> unknown_type(),
              }),
            }),
          None -> acc,
        }),
      at,
    );
    let r = RSum(s);
    match s.laid.cases.at(i) {
      Some(c) -> match c.payload {
        // The box is the sum's alone until it is gathered into the sum's words.
        Boxed(b) -> {
          let boxed = bound_as(
            held.st,
            ty,
            RWord,
            Make({
              made: MCase({ case: i, skip: b.skip, words: words(b.laid) }),
              args: held.args,
              reuse: None,
            }),
            at,
          );
          bound_as(boxed.st, ty, r, Gathered({ parts: [AInt(i), boxed.arg] }), at)
        },
        _ -> bound_as(held.st, ty, r, Gathered({ parts: [AInt(i)].concat(held.args) }), at),
      },
      None -> refuse(held.st, Data, b"a case its sum's layout does not hold"),
    }
  }
}

/// Each of `xs`' values held as its `to` says, in order.
fn handed_all(
  st: Lowering,
  xs: List<{ arg: Arg, to: Rep }>,
  at: Span,
) -> { st: Lowering, args: List<Arg> } =
  xs.fold(
    { st: st, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, x: { arg: Arg, to: Rep }| {
      let h = handed({ st: acc.st, arg: x.arg }, x.to, at);
      { st: h.st, args: acc.args.push(h.arg) }
    },
  )

/// The fields of a record type, in the checker's order (sorted by name).
fn fields_of(ty: Type) -> List<Field> =
  match ty { TyRecord(fs) -> fs, TyNominal(x) -> x.fields, _ -> [] }

/// A record literal of `fields`, each lowered in written order, at the type the checker filed for
/// it: gathered into its leaves where its type lays it out, no value where it lays it in none, and
/// made by value where a type variable leaves the layout open.
pub fn recorded(
  cx: Context,
  st: Lowering,
  fields: List<{ name: Bytes, arg: Arg }>,
  at: Span,
) -> Lowered =
  match filed(cx, at) {
    None -> unfiled(cx, st, b"a record", at),
    Some(t) -> recorded_as(cx, st, fields, t.ty, at),
  }

/// A record of `fields` at type `ty`, as `recorded` makes one at the type the checker filed.
pub fn recorded_as(
  cx: Context,
  st: Lowering,
  fields: List<{ name: Bytes, arg: Arg }>,
  ty: Type,
  at: Span,
) -> Lowered = {
  let value = |name: Bytes|
    fields.fold(None, |acc: Option<Arg>, f: { name: Bytes, arg: Arg }|
      if f.name == name { Some(f.arg) } else { acc });
  let rep = held_as(cx.setting, ty);
  if rep == RUnit { { st: st, arg: AZero(RUnit) } } else {
    match laid_leaves(cx.setting.ctors, ty) {
      Some(ls) -> {
        let given = fields_of(ty).fold(
          { xs: [], missing: false },
          |acc: { xs: List<{ arg: Arg, to: Rep }>, missing: Bool }, f: Field|
            match value(f.name) {
              Some(a) ->
                { ..acc, xs: acc.xs.push({ arg: a, to: laid_held(cx.setting.ctors, f.ty) }) },
              None -> { ..acc, missing: true },
            },
        );
        if given.missing { refuse(st, Data, b"a record literal missing a field its type holds") }
        else {
          let parts = handed_all(st, given.xs, at);
          held_made(record_made(parts.st, ty, ls, parts.args, at), rep, at)
        }
      },
      None -> {
        let names = names_of(ty, fields.map(|f: { name: Bytes, arg: Arg }| f.name));
        let given = names.fold([], |acc: List<Arg>, n: Bytes|
          match value(n) { Some(a) -> acc.push(a), None -> acc });
        if given.len() != names.len() {
          refuse(st, Data, b"a record literal missing a field its type holds")
        } else { by_value(cx, st, ty, names, given, at) }
      },
    }
  }
}

/// `flat`, a record made as its leaves, held as `rep` its type holds it as: as it is, or boxed.
fn held_made(flat: Lowered, rep: Rep, at: Span) -> Lowered =
  if rep_of_arg(flat.arg) == rep { flat } else { handed(flat, rep, at) }

/// The record of type `ty` held as the leaves `ls`, gathered from `parts`, its fields' values in
/// order, a field of no words giving none.
fn record_made(st: Lowering, ty: Type, ls: List<Leaf>, parts: List<Arg>, at: Span) -> Lowered =
  bound_as(
    st,
    ty,
    RFlat(ls),
    Gathered({ parts: parts.filter(|a: Arg| rep_of_arg(a) != RUnit) }),
    at,
  )

/// A record of `names` holding `args`, each as its word, of a layout a type variable leaves open: a
/// placeholder no printer sees, the layout a need of each such variable.
fn by_value(
  cx: Context,
  st: Lowering,
  ty: Type,
  names: List<Bytes>,
  args: List<Arg>,
  at: Span,
) -> Lowered = {
  let held = handed_all(open_needed(cx, st, ty), args.map(|a: Arg| { arg: a, to: RWord }), at);
  bound_as(
    held.st,
    ty,
    RWord,
    Make({ made: MRecord({ names: names, width: names.len() }), args: held.args, reuse: None }),
    at,
  )
}

/// The names of a record of type `ty` in the order it holds them, or `written` in that order where
/// `ty` is no record.
fn names_of(ty: Type, written: List<Bytes>) -> List<Bytes> =
  match ty {
    TyRecord(fs) -> fs.map(|f: Field| f.name),
    TyNominal(x) -> x.fields.map(|f: Field| f.name),
    _ -> sorted_names(written),
  }

/// Field `name` of `base`, held as its type says, borrowed: a flat record's leaves, or the words at
/// its offset in the box a record's word is; no value for a field of no words; or, where a type
/// variable leaves the layout open, read by name, a placeholder no printer sees.
pub fn field(cx: Context, base: Lowered, name: Bytes, at: Span) -> Lowered =
  match base.arg {
    AVar(b) -> {
      let fty = match field_type(b.ty, name) { Some(t) -> t, None -> unknown_type() };
      match read_in(cx, base.st, b, lay_of(cx, b), name, fty, held_as(cx.setting, fty), at) {
        None -> refuse(base.st, Data, b"a field its record does not hold: ".concat(name)),
        Some(r) -> r,
      }
    },
    AZero(RUnit) -> { st: base.st, arg: AZero(RUnit) },
    _ -> refuse(base.st, Data, b"a field of a value that is no record: ".concat(name)),
  }

/// Where the fields of a record lie, read once for every field read out of it: each field's span
/// of a flat record's leaves; each field's first word in the box a record's word is; nothing for a
/// record of no words; or nothing known, where a type variable leaves the layout open.
type Lay =
  | Spans({ leaves: List<Leaf>, of: Map<Bytes, { at: Int, n: Int }> })
  | Slots(Map<Bytes, Int>)
  | Empty
  | Open

fn lay_of(cx: Context, b: Var) -> Lay =
  match b.rep {
    RFlat(ls) -> Spans({ leaves: ls, of: leaf_spans(ls) }),
    RUnit -> Empty,
    _ -> match laid_leaves(cx.setting.ctors, b.ty) {
      Some(_) -> Slots(field_offsets(cx.setting, b.ty)),
      None -> if held_as(cx.setting, b.ty) == RUnit { Empty } else { Open },
    },
  }

/// Field `name` of type `fty` of `b`, laid out as `lay` says, held as `want` and borrowed from `b`;
/// nothing where `b`'s layout holds no such field.
fn read_in(
  cx: Context,
  st: Lowering,
  b: Var,
  lay: Lay,
  name: Bytes,
  fty: Type,
  want: Rep,
  at: Span,
) -> Option<Lowered> =
  if want == RUnit { Some({ st: st, arg: AZero(RUnit) }) } else {
    // A record lies in place in the record around it: read as its leaves, then held as wanted.
    let nested = laid_leaves(cx.setting.ctors, fty);
    let as_wanted = |l: Lowered| if rep_of_arg(l.arg) == want { l } else { handed(l, want, at) };
    match lay {
      Spans(s) -> match s.of.get(name) {
        None -> None,
        Some(sp) -> Some(as_wanted(leaves_read(st, b, s.leaves, sp, fty, nested != None, at))),
      },
      Slots(offsets) -> match offsets.get(name) {
        None -> None,
        Some(o) -> {
          let read = Get({ of: b, path: PField({ name: name, at: o }) });
          Some(match nested {
            Some(ls) -> as_wanted(bound_as(st, fty, RFlat(ls), read, at)),
            None -> bound_as(st, fty, want, read, at),
          })
        },
      },
      Empty -> None,
      Open ->
        Some(
          handed(
            bound_as(open_needed(cx, st, b.ty), fty, RWord, Get({ of: b, path: PNamed(name) }), at),
            want,
            at,
          ),
        ),
    }
  }

/// The leaves `sp` spans of the flat record `b` of leaves `ls`, a field of type `fty`: a record's
/// leaves, where it is one, each read at its type and gathered; otherwise the one leaf.
fn leaves_read(
  st: Lowering,
  b: Var,
  ls: List<Leaf>,
  sp: { at: Int, n: Int },
  fty: Type,
  record: Bool,
  at: Span,
) -> Lowered = {
  let one = |s: Lowering, k: Int, ty: Type|
    bound_as(s, ty, leaf_rep(ls, k), Get({ of: b, path: PLeaf(k) }), at);
  if !record { one(st, sp.at, fty) } else {
    let inner = leaves_within(ls, sp);
    let read = range(0, inner.len()).fold(
      { st: st, parts: [] },
      |acc: { st: Lowering, parts: List<Arg> }, j: Int| {
        let name = match inner.at(j) { Some(l) -> l.name, None -> b"" };
        let g = match leaf_type(fty, name) {
          Some(t) -> one(acc.st, sp.at + j, t),
          None -> refuse(acc.st, Data, b"a leaf its record's type does not hold: ".concat(name)),
        };
        { st: g.st, parts: acc.parts.push(g.arg) }
      },
    );
    bound_as(read.st, fty, RFlat(inner), Gathered({ parts: read.parts }), at)
  }
}

fn leaf_rep(ls: List<Leaf>, k: Int) -> Rep = match ls.at(k) { Some(l) -> l.rep, None -> RWord }

/// `{ ..base, sets }`, the fields `copies` read out of `base` as they stand, at the type the checker
/// filed for it: gathered from what it keeps of `base` and what it sets where its type lays it out,
/// no value where it lays it in none, or made by value of the fields it keeps read by name and those
/// it sets where a type variable leaves the layout open.
pub fn updated(
  cx: Context,
  st: Lowering,
  base: Arg,
  copies: List<Bytes>,
  sets: List<{ name: Bytes, arg: Arg }>,
  at: Span,
) -> Lowered =
  match ((base, filed(cx, at))) {
    (_, None) -> unfiled(cx, st, b"a record update", at),
    (AVar(b), Some(t)) -> {
      let ty = t.ty;
      let rep = held_as(cx.setting, ty);
      if rep == RUnit { { st: st, arg: AZero(RUnit) } } else {
        match laid_leaves(cx.setting.ctors, ty) {
          Some(ls) -> {
            // Each field is looked up once in maps read once, however wide the record is.
            let given = sets.fold(Map::new(), |m: Map<Bytes, Arg>, f: { name: Bytes, arg: Arg }|
              m.insert(f.name, f.arg));
            let kept = copies.fold(Map::new(), |m: Map<Bytes, Bool>, n: Bytes| m.insert(n, true));
            let lay = lay_of(cx, b);
            let parts = fields_of(ty).fold(
              { st: st, parts: [], missing: false },
              |acc: { st: Lowering, parts: List<Arg>, missing: Bool }, f: Field| {
                let laid = laid_held(cx.setting.ctors, f.ty);
                match given.get(f.name) {
                  Some(a) -> {
                    let h = handed({ st: acc.st, arg: a }, laid, at);
                    { ..acc, st: h.st, parts: acc.parts.push(h.arg) }
                  },
                  None -> if !kept.contains(f.name) { { ..acc, missing: true } } else {
                    match read_in(cx, acc.st, b, lay, f.name, f.ty, laid, at) {
                      None -> { ..acc, missing: true },
                      Some(r) -> { ..acc, st: r.st, parts: acc.parts.push(r.arg) },
                    }
                  },
                }
              },
            );
            if parts.missing {
              refuse(
                st,
                Data,
                b"an update of a field its base does not hold where its type lays it",
              )
            } else { held_made(record_made(parts.st, ty, ls, parts.parts, at), rep, at) }
          },
          None -> {
            let names = names_of(
              ty,
              copies.concat(sets.map(|f: { name: Bytes, arg: Arg }| f.name)),
            );
            let given = names.fold(
              { st: open_needed(cx, st, b.ty), args: [] },
              |acc: { st: Lowering, args: List<Arg> }, n: Bytes|
                match sets.fold(None, |found: Option<Arg>, f: { name: Bytes, arg: Arg }|
                    if f.name == n { Some(f.arg) } else { found }) {
                  Some(a) -> { ..acc, args: acc.args.push(a) },
                  None -> {
                    let g = bound_as(
                      acc.st,
                      match field_type(ty, n) { Some(t) -> t, None -> unknown_type() },
                      RWord,
                      Get({ of: b, path: PNamed(n) }),
                      at,
                    );
                    { st: g.st, args: acc.args.push(g.arg) }
                  },
                },
            );
            by_value(cx, given.st, ty, names, given.args, at)
          },
        }
      }
    },
    (_, Some(_)) -> refuse(st, Data, b"an update of a value that is no record"),
  }
