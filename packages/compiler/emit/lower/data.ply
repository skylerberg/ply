import compiler.syntax.parsing (Span)
import compiler.check.types (Type, NamedType, RecordType, NominalType, Field)
import compiler.emit.typing (unknown_type)
import compiler.emit.representations (SumConstructor, open_variables, EmitReads, ShapeReads,
                                      code_facts)
import compiler.emit.c (sorted_names)
import compiler.emit.output (Layout)
import compiler.emit.layout (SumLayout, Boxed, words, tag_bits)
import compiler.emit.typed_ir (Representation, AsWord, AsFlattened, AsSum, AsUnit, Leaf, Variable,
                               Arg, VariableOperand, IntOperand, ZeroOperand, Allocate,
                               CaseAllocation, RecordAllocation, FromArgument, Get, Aggregate,
                               Update, FieldWrite, LeafPath, FieldPath, InlineRecordPath,
                               operand_representation, read_only, takes_except_records)
import compiler.emit.lower.module_context (constructor_sum)
import compiler.emit.lower.representation (representation_of, leaf_spans, leaves_within, field_type,
                                           field_offsets, case_index, leaf_type, layout_leaves,
                                           flattened_leaves, record_parts, record_fields,
                                           RecordPart, case_parts, is_inline_record)
import compiler.emit.lower.base (Context, Lowering, LoweredValue, unreachable, bound_as,
                                 represented_as, with_need, packed_from, deferred_to_specialisation)

pub fn constructed(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ty: Type,
  at: Span,
) -> LoweredValue / {EmitReads} = constructed_as(context, st, name, args, ty, at)

pub fn constructed_as(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ty: Type,
  at: Span,
) -> LoweredValue / {EmitReads} = {
  let constructor = name;
  {
    let r = representation_of(ty);
    match r {
      AsSum(s) -> match case_index(r, constructor) {
        Some(i) -> case_value(context, st, ty, s, i, args, at),
        None ->
          unreachable(
            b"a constructor is not one of the cases of its sum type: ".concat(constructor),
          ),
      },
      AsUnit -> { st: st, arg: ZeroOperand(AsUnit) },
      _ -> if open_variables(ty) == [] {
        unreachable(
          b"a constructor is used at a type that is neither a declared sum type nor a type variable: ".concat(
            constructor,
          ),
        )
      } else { open_layout_constructed(context, st, ty, constructor, args, at) },
    }
  }
}

fn open_layout_constructed(
  context: Context,
  st: Lowering,
  ty: Type,
  constructor: Bytes,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {EmitReads} = {
  let sum = constructor_sum(constructor);
  let i = match sum { Some(x) -> x.index, None -> 0 };
  let converted = all_represented_as(
    note_open_layouts(context, st, ty),
    args.map(|a: Arg| { arg: a, to: AsWord }),
    at,
  );
  let inline = args.len() == 0
    || (match ((sum, ty)) {
      (Some(x), NamedType(c)) -> inline_everywhere(c.name, x.constructors, i),
      _ -> false,
    });
  bound_as(
    converted.st,
    ty,
    AsWord,
    if inline { Aggregate({ parts: [IntOperand(i)].concat(converted.args) }) } else {
      Allocate({
        made: CaseAllocation({ case: i, skip: 0, words: args.len() }),
        args: converted.args,
        reuse: None,
      })
    },
    at,
  )
}

fn inline_everywhere(sum: Bytes, cs: List<SumConstructor>, i: Int) -> Bool / {ShapeReads} =
  !(match code_facts.recursive_group_of(sum) {
      Some(r) -> r.indirect.at(i) == Some(true),
      None -> false,
    })
    && cs.filter(|c: SumConstructor| c.fields.len() > 0).len() <= 1 << tag_bits

pub fn note_open_layouts(context: Context, st: Lowering, ty: Type) -> Lowering / {ShapeReads} =
  open_variables(ty).fold(st, |s: Lowering, v: Int| with_need(s, { var: v, reads: Layout }))

fn case_value(
  context: Context,
  st: Lowering,
  ty: Type,
  s: { layout: SumLayout, cases: List<Bytes> },
  i: Int,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {EmitReads} = {
  let cps = case_parts(ty, i);
  if cps.len() != args.len() {
    unreachable(b"a constructor is applied to a different number of arguments than it takes")
  } else {
    let converted = all_represented_as(
      st,
      range(0, args.len()).fold(
        [],
        |accumulator: List<{ arg: Arg, to: Representation }>, k: Int|
          match ((args.at(k), cps.at(k))) {
            (Some(a), Some(part)) -> accumulator.push({ arg: a, to: part.representation }),
            _ -> accumulator,
          },
      ),
      at,
    );
    let r = AsSum(s);
    match s.layout.cases.at(i) {
      Some(c) -> match c.payload {
        Boxed(b) -> {
          let boxed = bound_as(
            converted.st,
            ty,
            AsWord,
            Allocate({
              made: CaseAllocation({ case: i, skip: b.skip, words: words(b.layout) }),
              args: converted.args,
              reuse: None,
            }),
            at,
          );
          bound_as(boxed.st, ty, r, Aggregate({ parts: [IntOperand(i), boxed.arg] }), at)
        },
        _ ->
          bound_as(
            converted.st,
            ty,
            r,
            Aggregate({ parts: [IntOperand(i)].concat(converted.args) }),
            at,
          ),
      },
      None -> unreachable(b"a case is missing from the memory layout of its sum type"),
    }
  }
}

fn all_represented_as(
  st: Lowering,
  xs: List<{ arg: Arg, to: Representation }>,
  at: Span,
) -> { st: Lowering, args: List<Arg> } =
  xs.fold(
    { st: st, args: [] },
    |accumulator: { st: Lowering, args: List<Arg> }, x: { arg: Arg, to: Representation }| {
      let h = represented_as({ st: accumulator.st, arg: x.arg }, x.to, at);
      { st: h.st, args: accumulator.args.push(h.arg) }
    },
  )

pub fn record_literal(
  context: Context,
  st: Lowering,
  fields: List<{ name: Bytes, arg: Arg }>,
  ty: Type,
  at: Span,
) -> LoweredValue / {EmitReads} = record_literal_as(context, st, fields, ty, at)

pub fn record_literal_as(
  context: Context,
  st: Lowering,
  fields: List<{ name: Bytes, arg: Arg }>,
  ty: Type,
  at: Span,
) -> LoweredValue / {EmitReads} = {
  let value = |name: Bytes|
    fields.fold(None, |accumulator: Option<Arg>, f: { name: Bytes, arg: Arg }|
      if f.name == name { Some(f.arg) } else { accumulator });
  let rep = representation_of(ty);
  if rep == AsUnit { { st: st, arg: ZeroOperand(AsUnit) } } else {
    match layout_leaves(ty) {
      Some(ls) -> {
        let given = record_parts(ty).fold(
          { xs: [], missing: false },
          |accumulator: { xs: List<{ arg: Arg, to: Representation }>, missing: Bool }, p: RecordPart|
            match value(p.name) {
              Some(a) ->
                { ..accumulator, xs: accumulator.xs.push({ arg: a, to: p.representation }) },
              None -> { ..accumulator, missing: true },
            },
        );
        if given.missing { unreachable(b"a record literal omits a field that its type declares") }
        else {
          let parts = all_represented_as(st, given.xs, at);
          record_built(parts.st, ty, ls, rep, parts.args, at)
        }
      },
      None -> {
        let names = names_of(ty, fields.map(|f: { name: Bytes, arg: Arg }| f.name));
        let given = names.fold([], |accumulator: List<Arg>, n: Bytes|
          match value(n) { Some(a) -> accumulator.push(a), None -> accumulator });
        if given.len() != names.len() {
          unreachable(b"a record literal omits a field that its type declares")
        } else {
          deferred_to_specialisation(
            note_open_layouts(context, st, ty),
            ty,
            AsWord,
            takes_except_records(given),
            at,
          )
        }
      },
    }
  }
}

fn record_built(
  st: Lowering,
  ty: Type,
  ls: List<Leaf>,
  rep: Representation,
  parts: List<Arg>,
  at: Span,
) -> LoweredValue =
  if rep == AsWord {
    bound_as(
      st,
      ty,
      AsWord,
      Allocate({
        made: RecordAllocation(parts.map(|_: Arg| FromArgument)),
        args: parts,
        reuse: None,
      }),
      at,
    )
  } else { record_represented_as(gathered_record(st, ty, ls, parts, at), rep, at) }

fn record_represented_as(flat: LoweredValue, rep: Representation, at: Span) -> LoweredValue =
  if operand_representation(flat.arg) == rep { flat } else { represented_as(flat, rep, at) }

fn gathered_record(
  st: Lowering,
  ty: Type,
  ls: List<Leaf>,
  parts: List<Arg>,
  at: Span,
) -> LoweredValue = bound_as(st, ty, AsFlattened(ls), Aggregate({ parts: parts }), at)

fn names_of(ty: Type, written: List<Bytes>) -> List<Bytes> =
  match ty {
    RecordType(fs) -> fs.map(|f: Field| f.name),
    NominalType(x) -> x.fields.map(|f: Field| f.name),
    _ -> sorted_names(written),
  }

pub fn field(
  context: Context,
  base: LoweredValue,
  name: Bytes,
  at: Span,
) -> LoweredValue / {EmitReads} = {
  let lies = match base.arg {
    VariableOperand(b) -> match ((b.representation, layout_leaves(b.ty))) {
      (AsWord, Some(ls)) -> match packed_from(base.st, b, AsFlattened(ls)) {
        Some(s) -> { st: base.st, arg: VariableOperand(s) },
        None -> base,
      },
      _ -> base,
    },
    _ -> base,
  };
  match lies.arg {
    VariableOperand(b) -> {
      let fty = match field_type(b.ty, name) { Some(t) -> t, None -> unknown_type };
      match read_field(
          context,
          lies.st,
          b,
          field_layout(context, b),
          name,
          fty,
          representation_of(fty),
          at,
        ) {
        None ->
          unreachable(b"a field access names a field that the record does not have: ".concat(name)),
        Some(r) -> r,
      }
    },
    ZeroOperand(AsUnit) -> { st: lies.st, arg: ZeroOperand(AsUnit) },
    _ -> unreachable(b"a field access on a value that is not a record: ".concat(name)),
  }
}

type FieldLayout =
  | Spans({ leaves: List<Leaf>, of: Map<Bytes, { at: Int, n: Int }> })
  | Offsets(Map<Bytes, Int>)
  | Empty
  | Open

fn field_layout(context: Context, b: Variable) -> FieldLayout / {ShapeReads} =
  match b.representation {
    AsFlattened(ls) -> Spans({ leaves: ls, of: leaf_spans(ls) }),
    AsUnit -> Empty,
    _ -> match layout_leaves(b.ty) {
      Some(_) -> Offsets(field_offsets(b.ty)),
      None -> if representation_of(b.ty) == AsUnit { Empty } else { Open },
    },
  }

fn read_field(
  context: Context,
  st: Lowering,
  b: Variable,
  lay: FieldLayout,
  name: Bytes,
  fty: Type,
  want: Representation,
  at: Span,
) -> Option<LoweredValue> / {EmitReads} =
  if want == AsUnit { Some({ st: st, arg: ZeroOperand(AsUnit) }) } else {
    let nested = flattened_leaves(fty);
    let as_wanted = |l: LoweredValue|
      if operand_representation(l.arg) == want { l } else { represented_as(l, want, at) };
    match lay {
      Spans(s) -> match s.of.get(name) {
        None -> None,
        Some(leaf_range) ->
          Some(as_wanted(leaves_read(st, b, s.leaves, leaf_range, fty, nested != None, at))),
      },
      Offsets(offsets) -> match offsets.get(name) {
        None -> None,
        Some(o) -> {
          let read = if is_inline_record(fty) { Get({ of: b, path: InlineRecordPath(o) }) }
          else { Get({ of: b, path: FieldPath({ name: name, at: o }) }) };
          Some(match nested {
            Some(ls) -> as_wanted(bound_as(st, fty, AsFlattened(ls), read, at)),
            None -> bound_as(st, fty, want, read, at),
          })
        },
      },
      Empty -> None,
      Open ->
        Some(
          deferred_to_specialisation(
            note_open_layouts(context, st, b.ty),
            fty,
            want,
            read_only([VariableOperand(b)]),
            at,
          ),
        ),
    }
  }

fn leaves_read(
  st: Lowering,
  b: Variable,
  ls: List<Leaf>,
  leaf_range: { at: Int, n: Int },
  fty: Type,
  record: Bool,
  at: Span,
) -> LoweredValue / {EmitReads} = {
  let one = |s: Lowering, k: Int, ty: Type|
    bound_as(s, ty, leaf_representation(ls, k), Get({ of: b, path: LeafPath(k) }), at);
  if !record { one(st, leaf_range.at, fty) } else {
    let inner = leaves_within(ls, leaf_range);
    let read = range(0, inner.len()).fold(
      { st: st, parts: [] },
      |accumulator: { st: Lowering, parts: List<Arg> }, j: Int| {
        let name = match inner.at(j) { Some(l) -> l.name, None -> b"" };
        let g = match leaf_type(fty, name) {
          Some(t) -> one(accumulator.st, leaf_range.at + j, t),
          None ->
            unreachable(
              b"a field access names a field that the record type does not have: ".concat(name),
            ),
        };
        { st: g.st, parts: accumulator.parts.push(g.arg) }
      },
    );
    bound_as(read.st, fty, AsFlattened(inner), Aggregate({ parts: read.parts }), at)
  }
}

fn leaf_representation(ls: List<Leaf>, k: Int) -> Representation =
  match ls.at(k) { Some(l) -> l.representation, None -> AsWord }

type RebuiltPart = { part: RecordPart, copied: Option<Arg> }

pub type UpdatePlan =
  | UnitUpdate
  | WrittenInPlace(Variable)
  | Rebuilt({ leaves: List<Leaf>, representation: Representation, parts: List<RebuiltPart> })
  | Specialised(Variable)

pub type StartedUpdate = { st: Lowering, plan: UpdatePlan }

pub fn holds_base(plan: UpdatePlan) -> Bool =
  match plan { WrittenInPlace(_) -> true, Specialised(_) -> true, _ -> false }

pub fn update_started(
  context: Context,
  st: Lowering,
  base: Arg,
  copies: List<Bytes>,
  set_names: List<Bytes>,
  ty: Type,
  at: Span,
) -> StartedUpdate / {EmitReads} =
  match base {
    VariableOperand(b) -> {
      let rep = representation_of(ty);
      if rep == AsUnit { { st: st, plan: UnitUpdate } } else {
        match layout_leaves(ty) {
          Some(ls) -> {
            let written = set_names.fold(Map::new(), |m: Map<Bytes, Bool>, n: Bytes|
              m.insert(n, true));
            let copied_names = copies.fold(Map::new(), |m: Map<Bytes, Bool>, n: Bytes|
              m.insert(n, true));
            let parts_of_type = record_parts(ty);
            let in_place = rep == AsWord && b.representation == AsWord
              && record_fields(b.ty) == record_fields(ty)
              && parts_of_type.all(|p: RecordPart|
                written.contains(p.name) || copied_names.contains(p.name));
            if in_place { { st: st, plan: WrittenInPlace(b) } } else {
              let lay = field_layout(context, b);
              let copied = parts_of_type.fold(
                { st: st, parts: [] },
                |accumulator: { st: Lowering, parts: List<RebuiltPart> }, p: RecordPart|
                  if written.contains(p.name) {
                    { ..accumulator, parts: accumulator.parts.push({ part: p, copied: None }) }
                  } else if !copied_names.contains(p.name) { missing_field() } else {
                    match read_field(
                        context,
                        accumulator.st,
                        b,
                        lay,
                        p.name,
                        p.ty,
                        p.representation,
                        at,
                      ) {
                      Some(r) ->
                        {
                          st: r.st,
                          parts: accumulator.parts.push({ part: p, copied: Some(r.arg) }),
                        },
                      None -> missing_field(),
                    }
                  },
              );
              {
                st: copied.st,
                plan: Rebuilt({ leaves: ls, representation: rep, parts: copied.parts }),
              }
            }
          },
          None -> { st: st, plan: Specialised(b) },
        }
      }
    },
    _ -> unreachable(b"a record update on a value that is not a record"),
  }

fn missing_field<a>() -> a / {EmitReads} =
  unreachable(
    b"a record update sets a field that the base record does not have in its memory layout",
  )

pub fn update_finished(
  context: Context,
  st: Lowering,
  plan: UpdatePlan,
  sets: List<{ name: Bytes, arg: Arg }>,
  ty: Type,
  at: Span,
) -> LoweredValue / {EmitReads} =
  match plan {
    UnitUpdate -> { st: st, arg: ZeroOperand(AsUnit) },
    WrittenInPlace(b) -> box_fields_written(context, st, b, ty, sets, at),
    Rebuilt(r) -> {
      let given = sets.fold(Map::new(), |m: Map<Bytes, Arg>, f: { name: Bytes, arg: Arg }|
        m.insert(f.name, f.arg));
      let parts = r.parts.fold(
        { st: st, parts: [] },
        |accumulator: { st: Lowering, parts: List<Arg> }, x: RebuiltPart|
          match x.copied {
            Some(a) -> { ..accumulator, parts: accumulator.parts.push(a) },
            None -> match given.get(x.part.name) {
              Some(a) -> {
                let h = represented_as({ st: accumulator.st, arg: a }, x.part.representation, at);
                { st: h.st, parts: accumulator.parts.push(h.arg) }
              },
              None -> missing_field(),
            },
          },
      );
      record_built(parts.st, ty, r.leaves, r.representation, parts.parts, at)
    },
    Specialised(b) ->
      deferred_to_specialisation(
        note_open_layouts(context, note_open_layouts(context, st, b.ty), ty),
        ty,
        AsWord,
        [{ arg: VariableOperand(b), takes: true }].concat(
          takes_except_records(sets.map(|f: { name: Bytes, arg: Arg }| f.arg)),
        ),
        at,
      ),
  }

fn box_fields_written(
  context: Context,
  st: Lowering,
  b: Variable,
  ty: Type,
  sets: List<{ name: Bytes, arg: Arg }>,
  at: Span,
) -> LoweredValue / {ShapeReads} = {
  let offsets = field_offsets(ty);
  let written = sets.fold(
    { st: st, sets: [] },
    |accumulator: { st: Lowering, sets: List<FieldWrite> }, f: { name: Bytes, arg: Arg }| {
      let fty = match field_type(ty, f.name) { Some(t) -> t, None -> unknown_type };
      let laid = representation_of(fty);
      match offsets.get(f.name) {
        Some(o) -> if laid == AsUnit { accumulator } else {
          let h = represented_as({ st: accumulator.st, arg: f.arg }, laid, at);
          { st: h.st, sets: accumulator.sets.push({ at: o, ty: fty, arg: h.arg }) }
        },
        None -> accumulator,
      }
    },
  );
  bound_as(written.st, ty, AsWord, Update({ of: b, sets: written.sets }), at)
}
