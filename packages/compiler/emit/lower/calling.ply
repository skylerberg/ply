pub fn context_of(setting: ModuleContext, r: Root, body: Code) -> Context / {abort.raise} = {
  let h = evidence_parameters(setting, r.key);
  let context = with_inlinable_lambdas({
    setting: setting,
    key: r.key,
    full: root_text(root_name(r.key)),
    base: r.base,
    params: r.params,
    types: r.types,
    param_effects: param_effects_of(setting, r),
    result: signature_convention(
      setting,
      call_signature(setting, r.key, r.types, r.result_type),
    ).result,
    result_type: r.result_type,
    body: body,
    tails: Restarts([]),
    parameter_positions: range(0, r.params.len()).fold(Map::new(), |m: Map<Int, Int>, i: Int|
      m.insert(i, i)),
    inlined_from: None,
    owners: r.params.fold(
      Map::new().insert(root_text(root_name(r.key)), r.key),
      |m: Map<Bytes, RootKey>, p: EmitParam|
        match p.lambda {
          Some(bl) -> m.insert(root_text(root_name(bl.owner)), bl.owner),
          None -> m,
        },
    ),
    emits_notes: false,
    frame_span: dummy_span(),
    captured: [],
    allows_lambda_inlining: false,
    written: [],
    words: [],
    effect_evidence: key_effects(r.key),
    labels: h.labels,
    label_names: labels_among(r.params, h.labels).map(|p: EmitParam| p.name),
    label_values: [],
    evidence_arguments: [],
    instance: None,
    retained_arguments: [],
    performs: r.performs,
  });
  { ..context, tails: Restarts(tail_parameter_representations(context)) }
}

fn param_effects_of(setting: ModuleContext, r: Root) -> List<Option<Effects>> =
  match match definition_of(r.key) {
      Some(full_name) ->
        definition_full(setting.module, setting.definitions, setting.imports, full_name),
      None -> None,
    } {
    Some(d) -> match d.definition.scheme {
      Some(scheme) -> match scheme.ty {
        FunctionType(f) ->
          range(0, r.params.len()).map(|p: Int|
            match f.params.at(p - d.definition.witnesses) {
              Some(FunctionType(g)) -> Some(in_scheme(scheme, g.effects)),
              _ -> None,
            }),
        _ -> [],
      },
      None -> [],
    },
    None -> [],
  }

fn with_inlinable_lambdas(context: Context) -> Context / {abort.raise} = {
  let borrows = allows_lambda_inlining(context);
  {
    ..context,
    allows_lambda_inlining: borrows,
    written: if borrows && context.inlined_from == None { inlinable_lambdas_of(context) }
    else { [] },
  }
}

pub fn convention(context: Context) -> Convention = {
  let h = evidence_parameters(context.setting, context.key);
  with_evidence_parameters(
    signature_convention(
      context.setting,
      call_signature(context.setting, context.key, context.types, context.result_type),
    ),
    h.hidden,
    h.declared.len(),
  )
}

fn call_signature(s: ModuleContext, key: RootKey, types: List<Type>, result: Type) -> Signature = {
  let own = unspecialised(key);
  match s.definitions.fold(None, |accumulator: Option<Signature>, d: Definition|
      if d.root == own { call_signature_at(s, d, key_types(key)) } else { accumulator }) {
    Some(c) -> c,
    None -> { params: types, result: result },
  }
}

type Signature = { params: List<Type>, result: Type }

fn call_signature_at(s: ModuleContext, d: Definition, args: List<Type>) -> Option<Signature> =
  match d.scheme {
    None -> None,
    Some(scheme) -> match scheme.ty {
      FunctionType(f) -> {
        let carried = specialised_variables(s, scheme, args, d.arity);
        let at = range(0, args.len()).map(|j: Int|
          match args.at(j) {
            Some(t) -> if carried.contains(j) { t } else { unknown_type() },
            None -> unknown_type(),
          });
        let ints = |n: Int| range(0, n).map(|_: Int| int_type());
        Some({
          params: ints(d.witnesses).concat(f.params.map(|t: Type| substituted(t, at))).concat(
            ints(d.arity - d.witnesses - f.params.len()),
          ),
          result: substituted(f.return_type, at),
        })
      },
      _ -> None,
    },
  }

fn specialised_variables(
  s: ModuleContext,
  scheme: Scheme,
  args: List<Type>,
  arity: Int,
) -> List<Int> =
  match scheme.ty {
    FunctionType(f) -> {
      let known_lambda_read = range(0, args.len()).filter(|j: Int|
        match args.at(j) { Some(t) -> !has_variables(t), None -> false });
      specialised_among(
        s,
        if arity > 0 { f.params.push(f.return_type) } else { f.params },
        args,
        known_lambda_read,
        known_lambda_read.len(),
      )
    },
    _ -> [],
  }

fn specialised_among(
  s: ModuleContext,
  call_signature: List<Type>,
  args: List<Type>,
  known_lambda_read: List<Int>,
  fuel: Int,
) -> List<Int> = {
  let at = |variable_indices: List<Int>|
    range(0, args.len()).map(|k: Int|
      if variable_indices.contains(k) { match args.at(k) { Some(t) -> t, None -> unknown_type() } }
      else { unknown_type() });
  let retained_indices = known_lambda_read.filter(|j: Int|
    call_signature.any(|p: Type|
      type_variables(p).contains(j)
        && {
          let full_name = substituted(p, at(known_lambda_read));
          representation_of(s, full_name)
            != representation_of(s, substituted(p, at(known_lambda_read.filter(|i: Int| i != j))))
            && (match known_layout(s.constructors, full_name) {
              Some(l) -> classes(l) != [Pointer],
              None -> false,
            })
        }));
  if fuel <= 0 || retained_indices.len() == known_lambda_read.len() { retained_indices }
  else { specialised_among(s, call_signature, args, retained_indices, fuel - 1) }
}

fn signature_convention(s: ModuleContext, c: Signature) -> Convention =
  typed_convention(s.constructors, c.params, c.result)

pub fn parameter_representations(context: Context) -> List<Representation> =
  match context.tails { Restarts(reps) -> reps, _ -> reps_of(convention(context)) }

fn tail_parameter_representations(context: Context) -> List<Representation> / {abort.raise} = {
  let reps = reps_of(convention(context));
  range(0, reps.len()).map(|i: Int|
    match reps.at(i) {
      Some(AsWord) -> match context.types.at(i) {
        Some(t) -> if list_item(t) != None && recurses_on_rest(context, context.body, i) {
          AsListView
        } else { AsWord },
        _ -> AsWord,
      },
      Some(r) -> r,
      None -> AsWord,
    })
}

fn recurses_on_rest(context: Context, c: Code, i: Int) -> Bool / {abort.raise} =
  match c.node {
    CodeIf(x) ->
      recurses_on_rest(context, x.then_branch, i) || recurses_on_rest(context, x.else_branch, i),
    CodeBlock(b) -> match b.tail { Some(t) -> recurses_on_rest(context, t, i), None -> false },
    CodeBinary(b) ->
      (b.operation == b"and" || b.operation == b"or")
        && recurses_on_rest(context, b.right_operand, i),
    CodeMatch(m) -> {
      let on_param = match m.scrutinee.node { CodeVariable(v) -> v.slot == i, _ -> false };
      m.arms.fold(false, |found: Bool, a: CodeArm|
        found || recurses_on_rest(context, a.body, i)
          || (on_param
          && (match a.pattern {
            CodeListPattern(l) -> match l.rest {
              Some(CodeBindingPattern(r)) -> self_call_passes_slot(context, a.body, i, r.slot),
              _ -> false,
            },
            _ -> false,
          })))
    },
    _ -> false,
  }

fn self_call_passes_slot(context: Context, c: Code, i: Int, r: Int) -> Bool / {abort.raise} =
  match c.node {
    CodeApply(a) ->
      a.args.len() == context.params.len()
        && (match a.args.at(i) {
          Some(x) -> match x.node { CodeVariable(v) -> v.slot == r, _ -> false },
          None -> false,
        })
        && (match target(context, a.function, a.args) {
          Some(ToDefinition(full_name)) -> definition_of(context.key) == Some(full_name),
          _ -> false,
        }),
    CodeIf(x) ->
      self_call_passes_slot(context, x.then_branch, i, r)
        || self_call_passes_slot(context, x.else_branch, i, r),
    CodeBlock(b) -> match b.tail {
      Some(t) -> self_call_passes_slot(context, t, i, r),
      None -> false,
    },
    CodeBinary(b) ->
      (b.operation == b"and" || b.operation == b"or")
        && self_call_passes_slot(context, b.right_operand, i, r),
    CodeMatch(m) ->
      m.arms.fold(false, |found: Bool, a: CodeArm|
        found || self_call_passes_slot(context, a.body, i, r)),
    _ -> false,
  }

pub fn target(
  context: Context,
  function: Code,
  args: List<Code>,
) -> Option<Target> / {abort.raise} =
  match function.node {
    CodeKnownLambda(k) -> if !k.in_place || frame_of(context, k.owner, k.nth) == None {
      Some(ToValue)
    } else { Some(ToInlinedBody(KnownLambda)) },
    CodeVariable(_) -> Some(ToValue),
    NConstructor(c) -> Some(ToConstructor(c.name)),
    NDefinition(f) -> match list_builtin_of(f.full) {
      Some(b) -> Some(ToBuiltin(b)),
      None -> match defined(context, f.full) {
        Some(d) -> match walk_of(context, d, function, args) {
          Some(w) -> Some(ToInlinedBody(WalkFunction(w))),
          None -> Some(ToDefinition(d.full)),
        },
        None -> None,
      },
    },
    NBuiltin(b) -> if b.name == b"iterate" && iterate_inlinable(args) {
      Some(ToInlinedBody(IterateStep))
    } else { Some(ToBuiltin(simple_name_of(b.name))) },
    _ -> Some(ToValue),
  }

fn list_builtin_of(full: Bytes) -> Option<Bytes> =
  [b"List::at", b"List::push", b"List::set"].find(|b: Bytes| qualify(prelude_module(), b) == full)

fn walk_of(context: Context, d: NamedDefinition, function: Code, args: List<Code>) -> Option<Walk> =
  match walk_kind(d.definition) {
    None -> None,
    Some(b) -> {
      let n = args.len() - 1;
      let runs = match args.at(n) {
        Some(f) -> inlined_here(context, f, walk_arity(b)),
        None -> false,
      };
      match if runs { walk_types(d, function) } else { None } {
        Some(t) -> {
          let ranged = b != EntryFolding
            && (match args.at(0) { Some(c) -> range_ends(context, c) != None, None -> false });
          Some({ kind: b, at: n, over: t.over, accumulator: t.held, ranged: ranged })
        },
        None -> None,
      }
    },
  }

pub fn range_ends(context: Context, c: Code) -> Option<List<Code>> =
  match c.node {
    CodeApply(a) -> match a.function.node {
      NBuiltin(f) -> if f.name == b"range" && a.args.len() == 2 { Some(a.args) } else { None },
      _ -> None,
    },
    _ -> None,
  }

fn walk_kind(d: Definition) -> Option<WalkKind> =
  if d.root != Named(prelude_type_name(d.name)) { None } else {
    match prelude_walks().find(|w: { name: Bytes, by: WalkKind }| w.name == d.name) {
      Some(w) -> Some(w.by),
      None -> None,
    }
  }

fn prelude_walks() -> List<{ name: Bytes, by: WalkKind }> =
  [
    { name: b"List::fold", by: Folding },
    { name: b"List::map", by: Mapping },
    { name: b"List::filter", by: Filtering },
    { name: b"Map::fold", by: EntryFolding },
  ]

fn reads_walk(function: Code) -> Bool =
  match function.node {
    NDefinition(f) ->
      prelude_walks().any(|w: { name: Bytes, by: WalkKind }| prelude_type_name(w.name) == f.full),
    _ -> false,
  }

fn walk_arity(by: WalkKind) -> Int = match by { Folding -> 2, EntryFolding -> 3, _ -> 1 }

fn walk_types(d: NamedDefinition, function: Code) -> Option<{ over: List<Type>, held: Type }> =
  match d.definition.scheme {
    Some(scheme) -> match substituted_fully(scheme.ty, reference_args(function)) {
      FunctionType(f) -> match f.params.at(0) {
        Some(t) -> match ((list_item(t), map_parts(t))) {
          (Some(item), _) -> Some({ over: [item], held: f.return_type }),
          (_, Some(m)) -> Some({ over: [m.key, m.value], held: f.return_type }),
          _ -> None,
        },
        _ -> None,
      },
      _ -> None,
    },
    _ -> None,
  }

fn inlined_here(context: Context, f: Code, n: Int) -> Bool =
  match f.node {
    CodeLambda(l) -> l.params == n,
    CodeKnownLambda(k) -> k.lambda.params == n && frame_of(context, k.owner, k.nth) != None,
    NDefinition(_) ->
      named_arity(context.setting.module, context.setting.definitions, context.setting.imports, f)
        == Some(n),
    _ -> false,
  }

pub fn inlined_argument(how: InlinedBody) -> Option<Int> =
  match how { KnownLambda -> None, IterateStep -> Some(2), WalkFunction(w) -> Some(w.at) }

pub fn range_argument(how: InlinedBody) -> Option<Int> =
  match how { WalkFunction(w) -> if w.ranged { Some(0) } else { None }, _ -> None }

pub fn named_function_call(
  context: Context,
  st: Lowering,
  f: Code,
  how: InlinedBody,
) -> LoweredValue / {abort.raise} =
  match ((f.node, how)) {
    (NDefinition(v), WalkFunction(w)) -> match ((
        defined(context, v.full),
        named_lambda(f, walk_arity(w.kind)).body.node,
      )) {
      (Some(d), CodeApply(a)) -> {
        let read = range(0, a.args.len()).fold(
          { st: st, args: [] },
          |accumulator: { st: Lowering, args: List<Arg> }, j: Int|
            match accumulator.st.env.get(j) {
              Some(x) ->
                {
                  st: note_slot_read(context, accumulator.st, read_note(), j, f.span),
                  args: accumulator.args.push(x),
                },
              None -> accumulator,
            },
        );
        match list_builtin_of(v.full) {
          Some(b) -> called_builtin(context, read.st, b, read.args, f, f.span),
          None -> called(context, read.st, d.full, f, a.args, read.args, false, f.span),
        }
      },
      _ -> unreachable(b"a call refers to a definition that the module does not contain"),
    },
    _ -> unreachable(b"a body to inline is not a lambda"),
  }

pub fn global_value(
  context: Context,
  st: Lowering,
  function: Code,
) -> LoweredValue / {abort.raise} = {
  let at = function.span;
  match function.ty {
    FunctionType(f) -> {
      let frame = {
        params: f.params.len(),
        size: f.params.len(),
        captures: [],
        resumes: None,
        body: function,
        ty: f,
        words: match function.node {
          NDefinition(n) -> match defined(context, n.full) {
            Some(d) -> evidence_arguments(context, st, d.definition, function, []).wanted,
            None -> [],
          },
          _ -> [],
        },
        captured_evidence: no_captured_evidence(),
      };
      let o = lambda_body_start(context, st, frame, at);
      let params = range(0, frame.params).fold([], |accumulator: List<Arg>, j: Int|
        match o.st.env.get(j) { Some(a) -> accumulator.push(a), None -> accumulator });
      closure(
        context,
        st,
        match target(o.context, function, []) {
          Some(ToConstructor(c)) -> constructed(o.context, o.st, c, params, f.return_type, at),
          Some(ToDefinition(full_name)) ->
            called(o.context, o.st, full_name, function, [], params, false, at),
          Some(ToBuiltin(b)) -> called_builtin(o.context, o.st, b, params, function, at),
          _ -> unreachable(b"a definition read as a value that the program does not contain"),
        },
        frame,
        Plain,
        at,
      )
    },
    _ -> match function.node {
      NConstructor(c) -> constructed(context, st, c.name, [], function.ty, at),
      _ -> unreachable(b"a definition used as a value does not have a function type"),
    },
  }
}

pub fn continuation_closure(
  context: Context,
  st: Lowering,
  slot: Int,
  k: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match resume_function_type(type_of(k)) {
    None -> unreachable(b"a continuation of no function type read as a value"),
    Some(t) -> match t {
      FunctionType(f) -> {
        let n = f.params.len();
        let frame = {
          params: n,
          size: n + 1,
          captures: [{ source: slot, destination: n }],
          resumes: None,
          body: { node: CodeVariable({ name: b"resume", slot: n }), span: at, ty: t },
          ty: f,
          words: effects_evidence(f.effects, context.effect_evidence, context.labels),
          captured_evidence: no_captured_evidence(),
        };
        let o = lambda_body_start(context, st, frame, at);
        let resumed_by = match o.st.env.get(n) {
          Some(k) ->
            applied(
              o.context,
              o.st,
              k,
              range(0, n).fold([], |accumulator: List<Arg>, j: Int|
                match o.st.env.get(j) { Some(a) -> accumulator.push(a), None -> accumulator }),
              no_effects(),
              false,
              at,
            ),
          None ->
            unreachable(
              b"a closure made to resume a suspended computation has no resume function in its environment",
            ),
        };
        closure(context, st, resumed_by, frame, Plain, at)
      },
      _ -> unreachable(b"a resume function used as a value does not have a function type"),
    },
  }

pub fn known_lambda_read(
  context: Context,
  st: Lowering,
  k: KnownLambdaCall,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match st.env.get(k.slot) {
    Some(a) ->
      typed_slot_read(
        context,
        { st: note_slot_read(context, st, read_note(), k.slot, at), arg: a },
        k.name,
        k.slot,
        FunctionType(k.lambda.ty),
        at,
      ),
    None -> unreachable(b"the variable for a lambda called by name has no value: ".concat(k.name)),
  }

pub fn called(
  context: Context,
  st: Lowering,
  full_name: Bytes,
  function: Code,
  codes: List<Code>,
  args: List<Arg>,
  tail: Bool,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match match function.node { NDefinition(f) -> defined(context, f.full), _ -> None } {
    None -> unreachable(b"a call of a name the module does not define: ".concat(full_name)),
    Some(d) -> if d.full != full_name {
      unreachable(b"a call whose callee resolves elsewhere: ".concat(full_name))
    } else if args.len() != d.definition.arity {
      unreachable(b"a call that does not fill its parameters: ".concat(full_name))
    } else if args.len() == 0 && d.definition.pure && !generic(d.definition) {
      match d.definition.value {
        Some(v) -> constant_lowered(context, st, v, at),
        None -> constant_read(context, st, d, function, at),
      }
    } else {
      match if tail { tail_jump(context, st, d, function, codes, args, at) } else { None } {
        Some(j) -> j,
        None -> convention_call(context, st, d, function, codes, args, at),
      }
    },
  }

pub fn applied(
  context: Context,
  st: Lowering,
  f: Arg,
  args: List<Arg>,
  effects: Effects,
  tail: Bool,
  at: Span,
) -> LoweredValue / {abort.raise} =
  applied_wanting(
    context,
    st,
    f,
    args,
    effects_evidence(effects, context.effect_evidence, context.labels),
    tail,
    at,
  )

pub fn known_applied(
  context: Context,
  st: Lowering,
  k: KnownLambdaCall,
  f: Arg,
  args: List<Arg>,
  effects: Effects,
  tail: Bool,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let wanted = match ((frame_of(context, k.owner, k.nth), f)) {
    (Some(None), _) -> effects_evidence(k.lambda.effects, context.effect_evidence, context.labels),
    (Some(Some(_)), VariableOperand(v)) -> param_wanted(context, v),
    _ -> effects_evidence(effects, context.effect_evidence, context.labels),
  };
  applied_wanting(context, st, f, args, wanted, tail, at)
}

fn applied_wanting(
  context: Context,
  st: Lowering,
  f: Arg,
  args: List<Arg>,
  wanted: List<EffectsEvidence>,
  tail: Bool,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match type_of(f) {
    FunctionType(t) -> if t.params.len() != args.len() {
      unreachable(b"a function value called with another arity")
    } else {
      let reps = t.params.map(|p: Type| representation_of(context.setting, p));
      let result = representation_of(context.setting, t.return_type);
      let e = wanted_evidence_arguments(
        context,
        note_parameter_called(context, note_function_layout(st, FunctionType(t)), f),
        wanted,
        at,
      );
      let all = reps.concat([AsImmediate, AsImmediate]);
      let h = all_represented_as(e.st, args.concat(e.args), all, at);
      bound_as(
        h.st,
        t.return_type,
        result,
        Apply({
          f: f,
          args: h.args,
          convention: {
            params: owned_params(all),
            result: result,
            destination_passing: false,
            returned: typed_ir::OwnedResult,
          },
          suspends: true,
          closure: match f { VariableOperand(v) -> st.closures.get(v.id), _ -> None },
        }),
        at,
      )
    },
    _ -> {
      let words = args.map(|_: Arg| AsWord);
      let h = all_represented_as(note_parameter_called(context, st, f), args, words, at);
      let enter_inlined = match resume_function_type(type_of(f)) {
        Some(FunctionType(k)) -> {
          let e = function_value_evidence(context, h.st, k.effects, at);
          run_for_effect(
            e.st,
            OperationCall({
              operation: OfHandling(Entering),
              args: e.args,
              uses: { takes: [false, false], owned: false, fails: false, suspends: false },
            }),
            at,
          )
        },
        _ -> h.st,
      };
      let returned = resume_result_type(type_of(f));
      let word = bound_as(
        enter_inlined,
        match returned { Some(a) -> a, None -> unknown_type() },
        AsWord,
        Apply({
          f: f,
          args: h.args,
          convention: {
            params: owned_params(words),
            result: AsWord,
            destination_passing: false,
            returned: typed_ir::OwnedResult,
          },
          suspends: true,
          closure: None,
        }),
        at,
      );
      match returned {
        Some(a) -> if tail { word }
        else { represented_as(word, representation_of(context.setting, a), at) },
        None -> word,
      }
    },
  }

fn note_function_layout(st: Lowering, t: Type) -> Lowering =
  type_variables(t).fold(st, |s: Lowering, v: Int| with_need(s, { var: v, reads: Layout }))

fn note_capture_releases(st: Lowering, captures: List<Variable>) -> Lowering =
  captures.fold(st, |s: Lowering, v: Variable|
    released_variables(v.ty).fold(s, |q: Lowering, x: Int| with_need(q, { var: x, reads: Exact })))

pub type InPlaceArgs = { args: List<Option<Arg>>, range: Option<{ lo: Arg, hi: Arg }> }

pub type Entered = { context: Context, st: Lowering, looped: LoopKind }

pub type LoopKind =
  | NotLooped
  | StepLoop(StepVariables)
  | WalkLoop({ walk: Walk, variables: WalkVariables, entry: Option<MapWalkVariables> })

pub fn enter_inlined(
  context: Context,
  st: Lowering,
  function: Code,
  args: List<Code>,
  lowered: InPlaceArgs,
  how: InlinedBody,
  at: Span,
) -> Entered / {abort.raise} = {
  let once = |o: Opened| { context: o.context, st: o.st, looped: NotLooped };
  match how {
    KnownLambda -> once(enter_known_lambda(context, st, function, lowered.args, at)),
    IterateStep -> match args.at(2) {
      None -> unreachable(b"a step that is not there"),
      Some(code) -> enter_step(context, st, code, lowered.args, at),
    },
    WalkFunction(w) -> match args.at(w.at) {
      None -> unreachable(b"a walk's function that is not there"),
      Some(f) -> enter_walk(context, st, f, lowered, w, at),
    },
  }
}

fn enter_known_lambda(
  context: Context,
  st: Lowering,
  function: Code,
  lowered: List<Option<Arg>>,
  at: Span,
) -> Opened / {abort.raise} =
  match function.node {
    CodeKnownLambda(k) -> match frame_of(context, k.owner, k.nth) {
      None ->
        unreachable(
          b"the lambda that the caller passed as a borrowed argument to the function being compiled was not found",
        ),
      Some(defining_frame) -> {
        let lambdas_stack_allocated = match defining_frame {
          None -> context,
          Some(bl) ->
            with_inlinable_lambdas({
              ..context,
              setting: {
                ..context.setting,
                module: bl.module,
                definitions: bl.module_definitions,
                imports: bl.imports,
                effects: bl.effects,
              },
              base: bl.base,
              inlined_from: Some({ owner: bl.owner, written: bl.written }),
              owners: context.owners.insert(root_text(root_name(bl.owner)), bl.owner),
            }),
        };
        inlined_in_frame(
          lambdas_stack_allocated,
          st,
          slot_variable(st, k.slot),
          k,
          lowered,
          defining_frame,
          at,
        )
      },
    },
    _ -> unreachable(b"a call to be expanded in place does not call a lambda whose body is known"),
  }

fn enter_walk(
  context: Context,
  st: Lowering,
  f: Code,
  lowered: InPlaceArgs,
  w: Walk,
  at: Span,
) -> Entered / {abort.raise} = {
  let made = walk_variables(context, st, w);
  let v = made.vars;
  let read = match ((w.ranged, lowered.args.at(0), lowered.range)) {
    (true, _, Some(r)) -> if operand_representation(r.lo) != AsInt {
      unreachable(b"a walk over a range from other than an integer")
    } else {
      {
        st: emitted(
          enter_block(made.st),
          Let({
            var: v.item,
            value: Primitive({ operation: b"add", on: AsInt, args: [r.lo, VariableOperand(v.at)] }),
            at: at,
            unwind: [],
          }),
        ),
        args: [VariableOperand(v.item)],
        entry: None,
      }
    },
    (false, Some(Some(xs)), _) -> if operand_representation(xs) != AsWord {
      unreachable(b"a loop over a list whose value is not represented as one word")
    } else {
      match w.kind {
        EntryFolding -> {
          let e = map_traversal_variables(context, made.st, w);
          let r = entry_read(context, enter_block(e.st), v, e.vars, w, at);
          { st: r.st, args: r.args, entry: Some(e.vars) }
        },
        _ ->
          {
            st: item_read_into(enter_block(made.st), xs, VariableOperand(v.at), v.item, at),
            args: [VariableOperand(v.item)],
            entry: None,
          },
      }
    },
    _ -> unreachable(b"a loop over a value that is not a list"),
  };
  let params = match w.kind {
    Folding -> [VariableOperand(v.accumulator)].concat(read.args),
    EntryFolding -> [VariableOperand(v.accumulator)].concat(read.args),
    _ -> read.args,
  };
  let o = match f.node {
    CodeKnownLambda(k) -> if k.in_place {
      enter_known_lambda(context, read.st, f, params.map(Some), at)
    } else { enter_inlined_lambda(context, read.st, called_frame(k), params, at) },
    CodeLambda(l) -> enter_inlined_lambda(context, read.st, l, params, at),
    _ -> enter_inlined_lambda(context, read.st, named_lambda(f, params.len()), params, at),
  };
  { context: o.context, st: o.st, looped: WalkLoop({ walk: w, variables: v, entry: read.entry }) }
}

pub type MapWalkVariables = {
  node: Variable,
  i: Variable,
  leaf: Variable,
  place: Variable,
  root: Variable,
  height: Variable,
  len: Variable,
}

fn map_traversal_variables(
  context: Context,
  st: Lowering,
  w: Walk,
) -> { st: Lowering, vars: MapWalkVariables } = {
  let made = |s: Lowering, t: Type| fresh(s, t, representation_of(context.setting, t));
  let node = made(st, map_node(w));
  let i = made(node.st, int_type());
  let leaf = made(i.st, map_node(w));
  let place = made(leaf.st, int_type());
  let root = made(place.st, map_node(w));
  let height = made(root.st, int_type());
  let len = made(height.st, int_type());
  {
    st: len.st,
    vars: {
      node: node.var,
      i: i.var,
      leaf: leaf.var,
      place: place.var,
      root: root.var,
      height: height.var,
      len: len.var,
    },
  }
}

fn map_node(w: Walk) -> Type = match w.over { [k, v] -> map_node_type(k, v), _ -> unknown_type() }

fn entry_read(
  context: Context,
  st: Lowering,
  v: WalkVariables,
  e: MapWalkVariables,
  w: Walk,
  at: Span,
) -> { st: Lowering, args: List<Arg> } / {abort.raise} = {
  let count = intrinsic_call(
    context,
    st,
    OfMap(NodeCount),
    [VariableOperand(e.node)],
    int_type(),
    at,
  );
  let inside = bound_as(
    count.st,
    bool_type(),
    AsBool,
    Primitive({ operation: b"lt", on: AsInt, args: [VariableOperand(e.i), count.arg] }),
    at,
  );
  let joining = emitted(emitted(inside.st, Declaration(e.leaf)), Declaration(e.place));
  let greatest = prelude_called(
    context,
    enter_block(joining),
    b"node_max",
    w.over,
    [VariableOperand(e.node), IntOperand(0)],
    at,
  );
  let above = prelude_called(
    context,
    greatest.st,
    b"leaf_above",
    w.over,
    [VariableOperand(e.root), VariableOperand(e.height), greatest.arg],
    at,
  );
  let found = some_payload_read(context, enter_block(above.st), above.arg, map_node(w), at);
  let next = emitted(
    exit_block(above.st, found.st),
    Case({
      on: match above.arg { VariableOperand(x) -> x, _ -> e.leaf },
      test: TagTest(cases_of(above.arg)),
      arms: [
        {
          when: some_case(above.arg),
          body: found.st.instructions.concat([
            Assign({ var: e.leaf, arg: found.arg }),
            Assign({ var: e.place, arg: IntOperand(0) }),
          ]),
        },
      ],
      rest: [Done(VariableOperand(v.accumulator))],
    }),
  );
  let read = emitted(
    exit_block(joining, next),
    If({
      cond: inside.arg,
      then: [
        Assign({ var: e.leaf, arg: VariableOperand(e.node) }),
        Assign({ var: e.place, arg: VariableOperand(e.i) }),
      ],
      otherwise: next.instructions,
    }),
  );
  let key = intrinsic_call(
    context,
    read,
    OfMap(NodeKey),
    [VariableOperand(e.leaf), VariableOperand(e.place)],
    w.over.get(0),
    at,
  );
  let value = intrinsic_call(
    context,
    key.st,
    OfMap(NodeValue),
    [VariableOperand(e.leaf), VariableOperand(e.place)],
    w.over.get(1),
    at,
  );
  { st: value.st, args: [key.arg, value.arg] }
}

fn prelude_called(
  context: Context,
  st: Lowering,
  name: Bytes,
  types: List<Type>,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match prelude_defined(context, name) {
    Some(d) -> defined_called(context, st, d, types, [], [], args, at),
    None ->
      unreachable(
        b"a loop calls a function that the prelude (the built-in definitions) does not define: ".concat(
          name,
        ),
      ),
  }

fn some_payload_read(
  context: Context,
  st: Lowering,
  o: Arg,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let v = fresh(st, ty, representation_of(context.setting, ty));
  { st: some_bound(v.st, o, v.var, at), arg: VariableOperand(v.var) }
}

fn some_bound(st: Lowering, o: Arg, into: Variable, at: Span) -> Lowering / {abort.raise} =
  match ((o, operand_representation(o))) {
    (VariableOperand(x), AsSum(s)) -> match case_argument_offset(s.layout, some_case(o), 0) {
      Some(word) ->
        emitted(
          st,
          Let({
            var: into,
            value: Get({ of: x, path: CasePath({ case: some_case(o), at: word }) }),
            at: at,
            unwind: [],
          }),
        ),
      None -> unreachable(b"an Option of a pointer has no word to hold its `Some` value"),
    },
    _ -> unreachable(b"an Option of a pointer is not represented as a tagged union"),
  }

fn cases_of(o: Arg) -> List<Bytes> =
  match operand_representation(o) { AsSum(s) -> s.cases, _ -> [] }

fn some_case(o: Arg) -> Int =
  match case_index(operand_representation(o), some_constructor()) { Some(i) -> i, None -> 0 }

fn enter_inlined_lambda(
  context: Context,
  st: Lowering,
  l: Lambda,
  params: List<Arg>,
  at: Span,
) -> Opened / {abort.raise} = {
  let t = l.ty;
  let inner = {
    ..context,
    result_type: t.return_type,
    frame_span: l.at,
    captured: l.captures.map(|c: Capture| c.destination),
  };
  let taken = range(0, params.len()).fold(
    { st: note_frame_entry(inner, st, at), env: Map::new() },
    |accumulator: { st: Lowering, env: Map<Int, Arg> }, j: Int|
      match params.at(j) {
        Some(a) -> {
          let p = match t.params.at(j) {
            Some(ty) -> retyped(context, { st: accumulator.st, arg: a }, ty, at),
            None -> { st: accumulator.st, arg: a },
          };
          { st: p.st, env: accumulator.env.insert(j, p.arg) }
        },
        None -> accumulator,
      },
  );
  match l.captures.fold(Some(taken.env), |accumulator: Option<Map<Int, Arg>>, cap: Capture|
      match accumulator {
        None -> None,
        Some(m) -> match st.env.get(cap.source) {
          Some(a) -> Some(m.insert(cap.destination, a)),
          None -> None,
        },
      }) {
    None -> unreachable(b"a lambda's captured variable has no bound value"),
    Some(env) -> { context: inner, st: { ..taken.st, env: env } },
  }
}

fn frame_of(context: Context, owner: Bytes, nth: Int) -> Option<Option<BoundLambda>> =
  if owner
      == root_text(
        root_name(match context.inlined_from { Some(l) -> l.owner, None -> context.key }),
      ) { Some(None) } else {
    match context.params.fold(None, |accumulator: Option<BoundLambda>, p: EmitParam|
        match accumulator {
          Some(_) -> accumulator,
          None -> match p.lambda {
            Some(bl) -> if root_text(root_name(bl.owner)) == owner && bl.nth == nth { Some(bl) }
            else { None },
            None -> None,
          },
        }) {
      Some(bl) -> Some(Some(bl)),
      None -> None,
    }
  }

fn slot_variable(st: Lowering, slot: Int) -> Option<Variable> =
  match st.env.get(slot) { Some(VariableOperand(v)) -> Some(v), _ -> None }

fn inlined_in_frame(
  context: Context,
  st: Lowering,
  f: Option<Variable>,
  k: KnownLambdaCall,
  lowered: List<Option<Arg>>,
  defining_frame: Option<BoundLambda>,
  at: Span,
) -> Opened / {abort.raise} =
  match f {
    None -> unreachable(b"a lambda called in place has no variable holding its closure"),
    Some(closure) -> {
      let typed = k.lambda.ty;
      let sited = match defining_frame {
        Some(bl) -> emitted(st, SiteScope(Some({ root: bl.owner, base: bl.base }))),
        None -> st,
      };
      let representations = capture_representations(context, k.lambda.body, k.lambda.captures);
      let caps = range(0, k.lambda.captures.len()).fold(
        { st: sited, env: Map::new() },
        |accumulator: { st: Lowering, env: Map<Int, Arg> }, i: Int|
          match k.lambda.captures.at(i) {
            None -> accumulator,
            Some(c) -> {
              let read = bound_as(
                accumulator.st,
                captured_type(context, st, k.lambda, i),
                match representations.at(i) { Some(r) -> r, None -> AsWord },
                Get({ of: closure, path: CapturePath(capture_offset(representations, i)) }),
                at,
              );
              { st: read.st, env: accumulator.env.insert(c.destination, read.arg) }
            },
          },
      );
      let inner = {
        ..context,
        result_type: typed.return_type,
        frame_span: k.lambda.at,
        captured: k.lambda.captures.map(|c: Capture| c.destination),
        words: match defining_frame {
          Some(_) -> parameter_function_words(context, closure),
          None -> context.words,
        },
      };
      let params = range(0, lowered.len()).fold(
        { st: note_frame_entry(inner, caps.st, at), env: caps.env },
        |accumulator: { st: Lowering, env: Map<Int, Arg> }, j: Int|
          match lowered.at(j) {
            Some(Some(a)) -> {
              let p = match typed.params.at(j) {
                Some(t) -> retyped(context, { st: accumulator.st, arg: a }, t, at),
                None -> { st: accumulator.st, arg: a },
              };
              { st: p.st, env: accumulator.env.insert(j, p.arg) }
            },
            _ -> accumulator,
          },
      );
      { context: inner, st: { ..params.st, env: params.env } }
    },
  }

fn parameter_function_words(context: Context, closure: Variable) -> List<EvidenceWord> = {
  let wanted = param_wanted(context, closure);
  let words = evidence_for(context, wanted);
  range(0, wanted.len()).fold([], |accumulator: List<EvidenceWord>, i: Int|
    match ((wanted.at(i), words.at(i))) {
      (Some(o), Some(w)) ->
        accumulator.push({ evidence: o.evidence, word: w, inherited: false, handled: false }),
      _ -> accumulator,
    })
}

fn param_wanted(context: Context, closure: Variable) -> List<EffectsEvidence> =
  match context.parameter_positions.get(closure.id) {
    Some(p) -> match context.param_effects.at(p) {
      Some(Some(r)) -> effects_evidence(r, context.effect_evidence, context.labels),
      _ -> [],
    },
    None -> [],
  }

pub fn exit_inlined(
  context: Context,
  before: Lowering,
  enter_inlined: Entered,
  body: LoweredValue,
  lowered: InPlaceArgs,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match enter_inlined.looped {
    NotLooped ->
      {
        st: end_site_scope(enter_inlined.st.instructions, before.instructions.len(), {
          ..body.st,
          env: before.env,
        }),
        arg: body.arg,
      },
    WalkLoop(w) -> match w.entry {
      Some(e) ->
        exit_map_walk(context, before, enter_inlined, body, lowered, w.walk, w.variables, e, at),
      None -> exit_walk(context, before, enter_inlined, body, lowered, w.walk, w.variables, at),
    },
    StepLoop(v) -> match ((lowered.args.at(0), lowered.args.at(1))) {
      (Some(Some(seed)), Some(Some(budget))) -> {
        let ended = {
          state: v.state,
          left: v.left_after,
          result: v.result,
          next: body.st.next,
          at: at,
        };
        let pass = match fused(body.st.instructions, body.arg, ended) {
          Some(f) -> f,
          None -> iterator_step_tested(context, body.st.instructions, body.arg, ended),
        };
        let seeded = represented_as(
          {
            st: { ..body.st, instructions: before.instructions, env: before.env, next: pass.next },
            arg: seed,
          },
          v.state.representation,
          at,
        );
        {
          st: emitted(
            seeded.st,
            Loop({
              state: [{ var: v.state, init: seeded.arg }, { var: v.left, init: budget }],
              body: pass.block,
              result: v.result,
            }),
          ),
          arg: VariableOperand(v.result),
        }
      },
      _ -> unreachable(b"a step with no seed or no budget"),
    },
  }

fn end_site_scope(instructions: Block, from: Int, back: Lowering) -> Lowering =
  if instructions.drop(from).any(|i: Instruction|
      match i { SiteScope(Some(_)) -> true, _ -> false }) { emitted(back, SiteScope(None)) }
  else { back }

pub type WalkVariables = { at: Variable, accumulator: Variable, result: Variable, item: Variable }

fn walk_variables(
  context: Context,
  st: Lowering,
  w: Walk,
) -> { st: Lowering, vars: WalkVariables } = {
  let p = fresh(st, int_type(), AsInt);
  let h = fresh(p.st, w.accumulator, representation_of(context.setting, w.accumulator));
  let a = fresh(h.st, w.accumulator, representation_of(context.setting, w.accumulator));
  let item = match w.over.at(0) { Some(t) -> t, None -> unknown_type() };
  let x = fresh(a.st, item, representation_of(context.setting, item));
  { st: x.st, vars: { at: p.var, accumulator: h.var, result: a.var, item: x.var } }
}

fn exit_walk(
  context: Context,
  before: Lowering,
  enter_inlined: Entered,
  body: LoweredValue,
  lowered: InPlaceArgs,
  w: Walk,
  v: WalkVariables,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let outside = |s: Lowering| { ..s, instructions: before.instructions, env: before.env };
  let back = end_site_scope(enter_inlined.st.instructions, 0, { ..body.st, env: before.env });
  let after = bound_as(
    back,
    int_type(),
    AsInt,
    Primitive({ operation: b"add", on: AsInt, args: [VariableOperand(v.at), IntOperand(1)] }),
    at,
  );
  let went = |s: Lowering, next_value: Arg| emitted(s, Next([after.arg, next_value]));
  let item = match w.kind {
    Mapping -> {
      let o = list_pushed(
        context,
        after.st,
        VariableOperand(v.accumulator),
        body.arg,
        w.accumulator,
        at,
      );
      went(o.st, o.arg)
    },
    Filtering -> {
      let k = represented_as({ st: after.st, arg: body.arg }, AsBool, at);
      let o = list_pushed(
        context,
        enter_block(k.st),
        VariableOperand(v.accumulator),
        VariableOperand(v.item),
        w.accumulator,
        at,
      );
      emitted(
        exit_block(k.st, o.st),
        If({
          cond: k.arg,
          then: went(o.st, o.arg).instructions,
          otherwise: [Next([after.arg, VariableOperand(v.accumulator)])],
        }),
      )
    },
    _ -> {
      let h = represented_as({ st: after.st, arg: body.arg }, v.accumulator.representation, at);
      went(h.st, h.arg)
    },
  };
  let looped = |s: Lowering, n: Arg| {
    let first = match w.kind {
      Folding -> match lowered.args.at(1) {
        Some(Some(init)) -> represented_as({ st: s, arg: init }, v.accumulator.representation, at),
        _ -> unreachable(b"a fold with no first accumulator"),
      },
      Filtering -> empty_list_with_capacity(context, s, w.accumulator, IntOperand(0), at),
      _ -> empty_list_with_capacity(context, s, w.accumulator, n, at),
    };
    let ended = fresh(first.st, bool_type(), AsBool);
    let pass = [
      Let({
        var: ended.var,
        value: Primitive({ operation: b"ge", on: AsInt, args: [VariableOperand(v.at), n] }),
        at: at,
        unwind: [],
      }),
      If({
        cond: VariableOperand(ended.var),
        then: [Done(VariableOperand(v.accumulator))],
        otherwise: item.instructions,
      }),
    ];
    {
      st: emitted(
        ended.st,
        Loop({
          state: [{ var: v.at, init: IntOperand(0) }, { var: v.accumulator, init: first.arg }],
          body: pass,
          result: v.result,
        }),
      ),
      arg: VariableOperand(v.result),
    }
  };
  match ((w.ranged, lowered.args.at(0), lowered.range)) {
    (true, _, Some(r)) ->
      range_guarded(context, outside(item), r.lo, r.hi, at, |s: Lowering, lo: Arg, hi: Arg| {
        let n = bound_as(
          s,
          int_type(),
          AsInt,
          Primitive({ operation: b"sub", on: AsInt, args: [hi, lo] }),
          at,
        );
        looped(n.st, n.arg)
      }),
    (false, Some(Some(xs)), _) -> {
      let n = length_read(outside(item), xs, at);
      looped(n.st, n.arg)
    },
    _ -> unreachable(b"a loop over a value that is not a list"),
  }
}

fn exit_map_walk(
  context: Context,
  before: Lowering,
  enter_inlined: Entered,
  body: LoweredValue,
  lowered: InPlaceArgs,
  w: Walk,
  v: WalkVariables,
  e: MapWalkVariables,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let outside = |s: Lowering| { ..s, instructions: before.instructions, env: before.env };
  let back = end_site_scope(enter_inlined.st.instructions, 0, { ..body.st, env: before.env });
  let plus_one = |s: Lowering, x: Variable|
    bound_as(
      s,
      int_type(),
      AsInt,
      Primitive({ operation: b"add", on: AsInt, args: [VariableOperand(x), IntOperand(1)] }),
      at,
    );
  let done_next = plus_one(back, v.at);
  let place_next = plus_one(done_next.st, e.place);
  let h = represented_as({ st: place_next.st, arg: body.arg }, v.accumulator.representation, at);
  let item = emitted(h.st, Next([done_next.arg, VariableOperand(e.leaf), place_next.arg, h.arg]));
  match ((lowered.args.at(0), lowered.args.at(1))) {
    (Some(Some(m)), Some(Some(init))) -> {
      let seed = represented_as({ st: outside(item), arg: init }, v.accumulator.representation, at);
      let root = intrinsic_call(
        context,
        seed.st,
        OfMap(MapRoot),
        [m],
        option_type(map_node(w)),
        at,
      );
      let result = fresh(root.st, w.accumulator, representation_of(context.setting, w.accumulator));
      let reads = |operation: ContainerOperation|
        OperationCall({ operation: OfContainers(operation), args: [m], uses: typed_ir::reads(1) });
      let opened_root = emitted(
        some_bound(enter_block(result.st), root.arg, e.root, at),
        Let({ var: e.height, value: reads(NodeIntrinsic(OfMap(MapHeight))), at: at, unwind: [] }),
      );
      let first = prelude_called(
        context,
        opened_root,
        b"first_leaf",
        w.over,
        [VariableOperand(e.root), VariableOperand(e.height)],
        at,
      );
      let measured = emitted(
        first.st,
        Let({ var: e.len, value: reads(Length), at: at, unwind: [] }),
      );
      let ended = fresh(measured, bool_type(), AsBool);
      let pass = [
        Let({
          var: ended.var,
          value: Primitive({
            operation: b"ge",
            on: AsInt,
            args: [VariableOperand(v.at), VariableOperand(e.len)],
          }),
          at: at,
          unwind: [],
        }),
        If({
          cond: VariableOperand(ended.var),
          then: [Done(VariableOperand(v.accumulator))],
          otherwise: item.instructions,
        }),
      ];
      let looped = emitted(
        ended.st,
        Loop({
          state: [
            { var: v.at, init: IntOperand(0) },
            { var: e.node, init: first.arg },
            { var: e.i, init: IntOperand(0) },
            { var: v.accumulator, init: seed.arg },
          ],
          body: pass,
          result: v.result,
        }),
      );
      let some = emitted(looped, Assign({ var: result.var, arg: VariableOperand(v.result) }));
      match root.arg {
        VariableOperand(r) ->
          {
            st: emitted(
              exit_block(emitted(result.st, Declaration(result.var)), some),
              Case({
                on: r,
                test: TagTest(cases_of(root.arg)),
                arms: [{ when: some_case(root.arg), body: some.instructions }],
                rest: [Assign({ var: result.var, arg: seed.arg })],
              }),
            ),
            arg: VariableOperand(result.var),
          },
        _ -> unreachable(b"the `Map` being folded is not stored in a variable"),
      }
    },
    _ -> unreachable(b"a fold over a map is missing its map argument or its initial value"),
  }
}

fn prelude_defined(context: Context, name: Bytes) -> Option<NamedDefinition> =
  if context.setting.module == prelude_module() {
    match context.setting.definitions.find(|d: Definition| d.name == name) {
      Some(d) -> Some({ full: prelude_type_name(name), definition: d }),
      None -> None,
    }
  } else {
    match module_import(context.setting.imports, prelude_binder()) {
      Some(imp) -> match imp.definitions.find(|d: Definition| d.name == name) {
        Some(d) -> Some({ full: qualify(imp.module, name), definition: d }),
        None -> None,
      },
      None -> None,
    }
  }

fn enter_step(
  context: Context,
  st: Lowering,
  code: Code,
  lowered: List<Option<Arg>>,
  at: Span,
) -> Entered / {abort.raise} = {
  match code.node {
    CodeLambda(l) -> match step_typed(l) {
      None ->
        unreachable(b"the step function of an iteration does not have the type of an `Iter` step"),
      Some(t) -> match lowered.at(1) {
        Some(Some(budget)) -> {
          let v = step_variables(context, st, t.state, t.result);
          let begun = budget_checked(
            note_frame_entry({ ..context, frame_span: l.at }, enter_block(v.st), at),
            v.left,
            budget,
            at,
          );
          match l.captures.fold(
              Some(Map::new().insert(0, VariableOperand(v.state))),
              |accumulator: Option<Map<Int, Arg>>, cap: Capture|
                match accumulator {
                  None -> None,
                  Some(m) -> match st.env.get(cap.source) {
                    Some(a) -> Some(m.insert(cap.destination, a)),
                    None -> None,
                  },
                },
            ) {
            None ->
              unreachable(b"a variable captured by the step function of an iteration has no value"),
            Some(env) ->
              {
                context: {
                  ..context,
                  result_type: t.result,
                  frame_span: l.at,
                  captured: l.captures.map(|cap: Capture| cap.destination),
                },
                st: { ..begun.st, env: env },
                looped: StepLoop({
                  state: v.state,
                  left: v.left,
                  left_after: begun.spent,
                  result: v.result,
                }),
              },
          }
        },
        _ -> unreachable(b"a step with no budget"),
      },
    },
    _ -> unreachable(b"a step that is no lambda"),
  }
}

fn budget_checked(
  st: Lowering,
  exit_inlined: Variable,
  budget: Arg,
  at: Span,
) -> { st: Lowering, spent: Variable } = {
  let c = bound_as(
    st,
    bool_type(),
    AsBool,
    Primitive({
      operation: b"le",
      on: AsInt,
      args: [VariableOperand(exit_inlined), IntOperand(0)],
    }),
    at,
  );
  let k = fresh(c.st, bool_type(), AsBool);
  let guarded = emitted(
    k.st,
    If({
      cond: c.arg,
      then: [
        Let({
          var: k.var,
          value: Primitive({ operation: b"ge", on: AsInt, args: [budget, IntOperand(1)] }),
          at: at,
          unwind: [],
        }),
        Do({
          value: Native({
            name: b"ply_iterate_bad",
            args: [VariableOperand(k.var), budget],
            uses: budget_failure_uses(),
          }),
          at: at,
          unwind: [],
        }),
      ],
      otherwise: [],
    }),
  );
  let budget_failure_uses = fresh(guarded, int_type(), AsInt);
  {
    st: emitted(
      budget_failure_uses.st,
      Let({
        var: budget_failure_uses.var,
        value: Primitive({
          operation: b"sub",
          on: AsInt,
          args: [VariableOperand(exit_inlined), IntOperand(1)],
        }),
        at: at,
        unwind: [],
      }),
    ),
    spent: budget_failure_uses.var,
  }
}

pub fn iterate_builtin(
  context: Context,
  st: Lowering,
  args: List<Arg>,
  effects: Effects,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args {
    [seed, budget, step] -> match match type_of(step) {
        FunctionType(f) -> iterator_types(f.params, f.return_type),
        _ -> None,
      } {
      None ->
        unreachable(b"the step function of an iteration does not have the type of an `Iter` step"),
      Some(t) -> {
        let v = step_variables(context, st, t.state, t.result);
        let begun = budget_checked(enter_block(v.st), v.left, budget, at);
        let r = applied(context, begun.st, step, [VariableOperand(v.state)], effects, false, at);
        let exit_inlined = begun.spent;
        let pass = iterator_step_tested(context, r.st.instructions, r.arg, {
          state: v.state,
          left: exit_inlined,
          result: v.result,
          next: r.st.next,
          at: at,
        });
        let seeded = represented_as(
          { st: { ..r.st, instructions: st.instructions, next: pass.next }, arg: seed },
          v.state.representation,
          at,
        );
        {
          st: emitted(
            seeded.st,
            Loop({
              state: [{ var: v.state, init: seeded.arg }, { var: v.left, init: budget }],
              body: pass.block,
              result: v.result,
            }),
          ),
          arg: VariableOperand(v.result),
        }
      },
    },
    _ -> unreachable(b"an `iterate` of other than a seed, a budget and a step"),
  }

pub fn called_builtin(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  function: Code,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let effects = builtin_effects(function);
  if name == b"iterate" { iterate_builtin(context, st, args, effects, at) }
  else if name == b"panic" {
    match function_parts(function.ty, args.len()) {
      Some(f) ->
        performed(
          context,
          st,
          { effect: b"abort", operation: b"raise", resource: b"" },
          None,
          None,
          args,
          f.return_type,
          at,
        ),
      None -> unreachable(b"a `panic` used as a value does not have a function type"),
    }
  } else if name == b"?let_go" {
    match args {
      [a] -> release_value(context, st, a, at),
      _ -> unreachable(b"a release of other than one value"),
    }
  } else { builtin(context, st, name, args, function, at) }
}

fn step_typed(l: Lambda) -> Option<{ state: Type, result: Type }> =
  iterator_types(l.ty.params, l.ty.return_type)

fn iterator_types(params: List<Type>, return_type: Type) -> Option<{ state: Type, result: Type }> =
  match ((iterator_parts(return_type), params)) {
    (Some(it), [a]) -> Some({ state: a, result: it.result }),
    _ -> None,
  }

fn function_parts(
  t: Type,
  arity: Int,
) -> Option<{ ty: Type, params: List<Type>, return_type: Type }> =
  match t {
    FunctionType(f) -> if f.params.len() == arity {
      Some({ ty: t, params: f.params, return_type: f.return_type })
    } else { None },
    _ -> None,
  }

pub type StepVariables = { state: Variable, left: Variable, left_after: Variable, result: Variable }

fn step_variables(
  context: Context,
  st: Lowering,
  state: Type,
  result: Type,
) -> { st: Lowering, state: Variable, left: Variable, result: Variable } = {
  let s = fresh(st, state, representation_of(context.setting, state));
  let n = fresh(s.st, int_type(), AsInt);
  let a = fresh(n.st, result, representation_of(context.setting, result));
  { st: a.st, state: s.var, left: n.var, result: a.var }
}

type PassEnd = { state: Variable, left: Variable, result: Variable, next: Int, at: Span }

type Pass = { block: Block, next: Int }

fn fused(b: Block, v: Arg, e: PassEnd) -> Option<Pass> =
  match v {
    VariableOperand(x) -> match b.at(b.len() - 1) {
      Some(Let(l)) -> if l.var != x { None }
      else { ending(b.take(b.len() - 1), l.var, l.value, e) },
      _ -> if b.contains(Declaration(x)) {
        tail_fused(b.filter(|i: Instruction| i != Declaration(x)), x, e)
      } else { None },
    },
    _ -> None,
  }

fn tail_fused(b: Block, j: Variable, e: PassEnd) -> Option<Pass> = {
  let n = b.len();
  let before = b.take(n - 1);
  match b.at(n - 1) {
    Some(Assign(a)) -> if a.var != j { None } else {
      match a.arg {
        VariableOperand(x) -> match b.at(n - 2) {
          Some(Let(l)) -> if l.var != x { None } else { ending(b.take(n - 2), l.var, l.value, e) },
          Some(i) -> if !before.contains(Declaration(x)) { None }
          else { last_fused(b.take(n - 2).filter(|y: Instruction| y != Declaration(x)), i, x, e) },
          None -> None,
        },
        _ -> None,
      }
    },
    Some(i) -> last_fused(before, i, j, e),
    None -> None,
  }
}

fn last_fused(before: Block, last: Instruction, j: Variable, e: PassEnd) -> Option<Pass> =
  match last {
    If(x) -> match tail_fused(x.then, j, e) {
      None -> None,
      Some(t) -> match tail_fused(x.otherwise, j, { ..e, next: t.next }) {
        None -> None,
        Some(o) ->
          Some({
            block: before.push(If({ ..x, then: t.block, otherwise: o.block })),
            next: o.next,
          }),
      },
    },
    Case(c) -> {
      let arms = c.arms.fold(
        Some({ arms: [], next: e.next }),
        |got: Option<{ arms: List<{ when: Int, body: Block }>, next: Int }>, arm: { when: Int, body: Block }|
          match got {
            None -> None,
            Some(g) -> match tail_fused(arm.body, j, { ..e, next: g.next }) {
              None -> None,
              Some(r) ->
                Some({ arms: g.arms.push({ when: arm.when, body: r.block }), next: r.next }),
            },
          },
      );
      match arms {
        None -> None,
        Some(g) -> match tail_fused(c.rest, j, { ..e, next: g.next }) {
          None -> None,
          Some(r) ->
            Some({ block: before.push(Case({ ..c, arms: g.arms, rest: r.block })), next: r.next }),
        },
      }
    },
    Match(m) -> {
      let arms = m.arms.fold(
        Some({ arms: [], next: e.next }),
        |got: Option<{ arms: List<Block>, next: Int }>, arm: Block|
          match got {
            None -> None,
            Some(g) -> match tail_fused(arm, j, { ..e, next: g.next }) {
              None -> None,
              Some(r) -> Some({ arms: g.arms.push(r.block), next: r.next }),
            },
          },
      );
      match arms {
        None -> None,
        Some(g) -> match tail_fused(m.rest, j, { ..e, next: g.next }) {
          None -> None,
          Some(r) ->
            Some({ block: before.push(Match({ arms: g.arms, rest: r.block })), next: r.next }),
        },
      }
    },
    _ -> {
      let b = before.push(last);
      if falls_through(b) { None } else { Some({ block: b, next: e.next }) }
    },
  }

fn ending(b: Block, made: Variable, value: Rvalue, e: PassEnd) -> Option<Pass> =
  match value {
    Aggregate(g) -> match ((made.representation, g.parts)) {
      (AsSum(s), [IntOperand(i), a]) -> {
        let u = without_construction(b, a);
        if s.cases.at(i) == Some(continue_constructor()) {
          let h = packed_into(u.arg, e.state, e);
          Some({
            block: u.block.concat(h.block).push(Next([h.arg, VariableOperand(e.left)])),
            next: h.next,
          })
        } else if s.cases.at(i) == Some(stop_constructor()) {
          let h = packed_into(u.arg, e.result, e);
          Some({ block: u.block.concat(h.block).push(Done(h.arg)), next: h.next })
        } else { None }
      },
      _ -> None,
    },
    _ -> None,
  }

fn without_construction(b: Block, a: Arg) -> { block: Block, arg: Arg } =
  match a {
    VariableOperand(w) -> match b.at(b.len() - 1) {
      Some(Let(l)) -> if l.var != w { { block: b, arg: a } } else {
        match l.value {
          Convert(k) -> { block: b.take(b.len() - 1), arg: k.arg },
          _ -> { block: b, arg: a },
        }
      },
      _ -> { block: b, arg: a },
    },
    _ -> { block: b, arg: a },
  }

fn packed_into(a: Arg, into: Variable, e: PassEnd) -> { block: Block, arg: Arg, next: Int } =
  if operand_representation(a) == into.representation { { block: [], arg: a, next: e.next } } else {
    let v = { id: e.next, ty: into.ty, representation: into.representation };
    {
      block: [
        Let({ var: v, value: Convert({ arg: a, to: into.representation }), at: e.at, unwind: [] }),
      ],
      arg: VariableOperand(v),
      next: e.next + 1,
    }
  }

fn iterator_step_tested(context: Context, b: Block, v: Arg, e: PassEnd) -> Pass =
  match v {
    VariableOperand(x) -> {
      let go = read_out(context, x, continue_constructor(), e.state, e);
      let stop = read_out(context, x, stop_constructor(), e.result, { ..e, next: go.next });
      {
        block: b.push(
          Case({
            on: x,
            test: TagTest([continue_constructor(), stop_constructor()]),
            arms: [
              { when: 0, body: go.block.push(Next([go.arg, VariableOperand(e.left)])) },
              { when: 1, body: stop.block.push(Done(stop.arg)) },
            ],
            rest: [Fail({ reason: NoMatchingArm, at: e.at, resource: [], unwind: [] })],
          }),
        ),
        next: stop.next,
      }
    },
    _ ->
      {
        block: b.push(Fail({ reason: NoMatchingArm, at: e.at, resource: [], unwind: [] })),
        next: e.next,
      },
  }

fn read_out(
  context: Context,
  x: Variable,
  constructor: Bytes,
  into: Variable,
  e: PassEnd,
) -> { block: Block, arg: Arg, next: Int } =
  if into.representation == AsUnit { { block: [], arg: ZeroOperand(AsUnit), next: e.next } } else {
    let i = match case_index(x.representation, constructor) { Some(k) -> k, None -> 0 };
    let read = match x.representation {
      AsSum(s) ->
        {
          path: CasePath({
            case: i,
            at: match case_argument_offset(s.layout, i, 0) { Some(w) -> w, None -> 0 },
          }),
          representation: representation_of(context.setting, into.ty),
        },
      _ ->
        {
          path: CasePath({ case: if constructor == stop_constructor() { 1 } else { 0 }, at: 0 }),
          representation: AsWord,
        },
    };
    let r = { id: e.next, ty: into.ty, representation: read.representation };
    let h = packed_into(VariableOperand(r), into, { ..e, next: e.next + 1 });
    {
      block: [Let({ var: r, value: Get({ of: x, path: read.path }), at: e.at, unwind: [] })].concat(
        h.block,
      ),
      arg: h.arg,
      next: h.next,
    }
  }

fn budget_failure_uses() -> { takes: List<Bool>, owned: Bool, fails: Bool, suspends: Bool } =
  { takes: [false, false], owned: false, fails: true, suspends: false }

pub fn lambda_body_start(context: Context, st: Lowering, frame: Frame, at: Span) -> Opened = {
  let s = closure_layout(context, st.env, frame, at);
  let reserved = with_lambda(
    st,
    Closure({
      body: empty_function(context),
      captures: shape_captures(s).len(),
      at: at,
      words: no_closure_evidence(),
    }),
  ).st;
  let caps = zip(frame.captures, s.captured).fold(
    enter_function(reserved, shape_params(s), Map::new()),
    |accumulator: Lowering, p: { first: Capture, second: Variable }|
      {
        ..accumulator,
        env: accumulator.env.insert(p.first.destination, VariableOperand(p.second)),
        closures: match st.env.get(p.first.source) {
          Some(VariableOperand(outer)) -> match st.closures.get(outer.id) {
            Some(n) -> accumulator.closures.insert(p.second.id, n),
            None -> accumulator.closures,
          },
          _ -> accumulator.closures,
        },
      },
  );
  let given = {
    ..caps,
    env: range(0, s.parameters.len()).fold(caps.env, |m: Map<Int, Arg>, j: Int|
      match s.parameters.at(j) { Some(p) -> m.insert(j, VariableOperand(p)), None -> m }),
  };
  let read = read_evidence_words(given, s.evidence_parameters, frame.words, at);
  let inside = substitute_evidence_variables(frame.captured_evidence, s.held_evidence);
  {
    context: {
      ..context,
      tails: PlainCalls,
      params: [],
      types: [],
      result: s.result,
      result_type: s.return_type,
      parameter_positions: Map::new(),
      frame_span: at,
      captured: frame.captures.map(|c: Capture| c.destination),
      words: inside.words.concat(read.words),
      label_values: label_values_at(
        context,
        frame_labels(context, frame),
        s.labels.map(VariableOperand),
      ),
      instance: inside.instance,
      retained_arguments: inside.retained_values,
    },
    st: read.st,
  }
}

fn note_captures(context: Context, st: Lowering, captures: List<Capture>, at: Span) -> Lowering =
  captures.fold(st, |s: Lowering, c: Capture|
    note_slot_read(context, s, capture_note(), c.source, at))

pub fn note_step_captures(
  context: Context,
  st: Lowering,
  args: List<Code>,
  how: InlinedBody,
) -> Lowering =
  match inlined_argument(how) {
    None -> st,
    Some(n) -> match args.at(n) {
      Some(code) -> match code.node {
        CodeLambda(l) -> note_captures(context, st, l.captures, l.at),
        _ -> st,
      },
      None -> st,
    },
  }

pub fn closure(
  context: Context,
  outer: Lowering,
  inner: LoweredValue,
  frame: Frame,
  kind: FunctionKind,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let s = closure_layout(context, outer.env, frame, at);
  let nth = outer.lambdas.len();
  let laid = shape_captures(s);
  let returned = if falls_through(inner.st.instructions) { represented_as(inner, s.result, at) }
  else { inner };
  let instructions = if falls_through(returned.st.instructions) {
    returned.st.instructions.push(Return(returned.arg))
  } else { returned.st.instructions };
  let body = {
    key: context.key,
    kind: kind,
    params: shape_params(s),
    convention: shape_convention(s),
    result_type: if frame.resumes != None { word_type() } else { s.return_type },
    body: match context.inlined_from {
      Some(l) -> [SiteScope(Some({ root: l.owner, base: context.base }))].concat(instructions),
      None -> instructions,
    },
    lambdas: [],
    base: context.base,
    members: [],
    links: no_links(),
    statics: [],
  };
  let unraised = exit_function(outer, returned.st);
  let exit_inlined = frame_labels(context, frame);
  let raising = match substitute_evidence_variables(
      frame.captured_evidence,
      s.held_evidence,
    ).words.find(|w: EvidenceWord| w.evidence.effect == b"abort" && !w.inherited) {
    Some(w) -> match w.word {
      VariableOperand(v) -> pending_abort_raise(context, unraised, v),
      _ -> { st: unraised, pending: None },
    },
    None -> { st: unraised, pending: None },
  };
  let after = raising.st;
  let own = if frame.words.len() == 0 { { st: after, name: b"" } } else {
    static_added(after, effects_descriptor(frame.words.map(|o: EffectsEvidence| o.evidence)))
  };
  let placed = {
    ..own.st,
    lambdas: own.st.lambdas.set(
      nth,
      Closure({
        body: { ..body, links: { ..body.links, pending: raising.pending } },
        captures: laid.len(),
        at: at,
        words: {
          descriptor: own.name,
          count: frame.words.len(),
          resource_captures: frame.words.fold([], |accumulator: List<Int>, o: EffectsEvidence|
            match o.evidence.resource {
              ResourceVariable(p) -> match zip(exit_inlined, s.labels).find(
                  |l: { first: Int, second: Variable }| l.first == p,
                ) {
                Some(l) -> match range(0, laid.len()).find(|k: Int|
                    match laid.at(k) { Some(v) -> v.id == l.second.id, None -> false }) {
                  Some(k) -> accumulator.push(k),
                  None -> accumulator,
                },
                None -> accumulator,
              },
              _ -> accumulator,
            }),
        },
      }),
    ),
  };
  let caps = zip(frame.captures, s.captured).fold(
    { st: note_captures(context, placed, frame.captures, at), args: [] },
    |accumulator: { st: Lowering, args: List<Arg> }, p: { first: Capture, second: Variable }|
      match accumulator.st.env.get(p.first.source) {
        Some(a) -> {
          let h = represented_as({ st: accumulator.st, arg: a }, p.second.representation, at);
          { st: h.st, args: accumulator.args.push(h.arg) }
        },
        None -> unreachable(b"a captured variable has no bound value"),
      },
  );
  let made = bound_as(
    note_function_layout(note_capture_releases(caps.st, laid), s.ty),
    s.ty,
    AsWord,
    Allocate({
      made: ClosureAllocation({ nth: nth, captures: laid.len(), params: s.parameters.len() }),
      args: captures_in_order(
        caps.args,
        exit_inlined.map(|p: Int| label_value(context, p)),
        evidence_values_of(frame.captured_evidence),
      ),
      reuse: None,
    }),
    at,
  );
  match made.arg {
    VariableOperand(v) ->
      { ..made, st: { ..made.st, closures: made.st.closures.insert(v.id, nth) } },
    _ -> made,
  }
}

pub fn group_body_starts(members: List<GroupMember>) -> List<Opened> = {
  let keys = members.map(|m: GroupMember| m.context.key);
  let params = member_params(members);
  let after = params.fold(1, |n: Int, ps: List<Variable>| n + ps.len());
  range(0, members.len()).fold([], |accumulator: List<Opened>, i: Int|
    match members.at(i) {
      None -> accumulator,
      Some(m) -> {
        let own = match params.at(i) { Some(ps) -> ps, None -> [] };
        let begun = enter_root_body(
          {
            ..m.context,
            tails: Enters(keys),
            parameter_positions: range(0, own.len()).fold(
              Map::new(),
              |pa: Map<Int, Int>, j: Int|
                match own.at(j) { Some(v) -> pa.insert(v.id, j), None -> pa },
            ),
          },
          {
            ..initial_lowering([]),
            next: after,
            env: range(0, own.len()).fold(Map::new(), |e: Map<Int, Arg>, j: Int|
              match own.at(j) { Some(v) -> e.insert(j, VariableOperand(v)), None -> e }),
          },
          own,
          m.context.params.len(),
          evidence_parameters(m.context.setting, m.context.key),
        );
        accumulator.push({ context: begun.context, st: begun.st })
      },
    })
}

pub fn tail_group_root(
  members: List<GroupMember>,
  bodies: List<LoweredValue>,
) -> Function / {abort.raise} =
  match members.at(0) {
    None -> unreachable(b"a group of tail-calling functions has no members"),
    Some(first) -> {
      let params = member_params(members);
      let which = { id: 0, ty: int_type(), representation: AsInt };
      let last = match bodies.at(bodies.len() - 1) {
        Some(b) -> b.st,
        None -> initial_lowering([]),
      };
      let arms = range(0, bodies.len()).fold(
        { next: last.next, arms: [] },
        |accumulator: { next: Int, arms: List<{ when: Int, body: Block }> }, i: Int|
          match bodies.at(i) {
            None -> accumulator,
            Some(b) -> match members.at(i) {
              None -> accumulator,
              Some(m) -> if !falls_through(b.st.instructions) {
                { ..accumulator, arms: accumulator.arms.push({ when: i, body: b.st.instructions }) }
              } else {
                let h = represented_as(
                  { st: { ..b.st, next: accumulator.next }, arg: b.arg },
                  convention(m.context).result,
                  m.body.span,
                );
                {
                  next: h.st.next,
                  arms: accumulator.arms.push({
                    when: i,
                    body: h.st.instructions.push(Return(h.arg)),
                  }),
                }
              },
            },
          },
      );
      {
        key: first.context.key,
        kind: Metered,
        params: [which],
        convention: {
          params: [{ ownership: OwnedParam, representation: AsInt }],
          result: AsWord,
          destination_passing: false,
          returned: typed_ir::OwnedResult,
        },
        result_type: first.context.result_type,
        body: [
          Case({
            on: which,
            test: IntTest(range(0, members.len())),
            arms: arms.arms,
            rest: [Return(ZeroOperand(AsWord))],
          }),
        ],
        lambdas: members.drop(1).fold(last.lambdas, |ls: List<typed_ir::Lambda>, m: GroupMember|
          ls.map(|l: typed_ir::Lambda|
            match l {
              Closure(c) -> if c.body.key != m.context.key { l } else {
                Closure({
                  ..c,
                  body: {
                    ..c.body,
                    body: [SiteScope(Some({ root: m.context.key, base: m.context.base }))].concat(
                      c.body.body,
                    ),
                  },
                })
              },
            })),
        base: first.context.base,
        members: range(0, members.len()).fold([], |accumulator: List<Member>, i: Int|
          match members.at(i) {
            Some(m) ->
              accumulator.push({
                key: m.context.key,
                base: m.context.base,
                params: match params.at(i) { Some(ps) -> ps, None -> [] },
                convention: convention(m.context),
              }),
            None -> accumulator,
          }),
        links: last.links,
        statics: [],
      }
    },
  }

fn member_params(members: List<GroupMember>) -> List<List<Variable>> =
  members.fold(
    { next: 1, out: [] },
    |accumulator: { next: Int, out: List<List<Variable>> }, m: GroupMember| {
      let reps = reps_of(convention(m.context));
      let declared = m.context.params.len();
      let handed_types = evidence_parameter_types(
        evidence_parameters(m.context.setting, m.context.key),
      );
      {
        next: accumulator.next + reps.len(),
        out: accumulator.out.push(
          range(0, reps.len()).map(|j: Int|
            {
              id: accumulator.next + j,
              ty: if j >= declared {
                match handed_types.at(j - declared) { Some(t) -> t, None -> evidence_type() }
              } else { match m.context.types.at(j) { Some(t) -> t, None -> unknown_type() } },
              representation: match reps.at(j) { Some(r) -> r, None -> AsWord },
            }),
        ),
      }
    },
  ).out

pub fn known_body(full_name: Bytes, params: List<EmitParam>, body: Code) -> Code = {
  let slots = range(0, params.len()).fold([], |accumulator: List<KnownSlot>, i: Int|
    match match params.at(i) { Some(p) -> p.lambda, None -> None } {
      Some(bl) -> if has_handle(bl.code.body) { accumulator } else {
        accumulator.push({
          slot: i,
          owner: root_text(root_name(bl.owner)),
          nth: bl.nth,
          code: bl.code,
        })
      },
      None -> accumulator,
    });
  let own = lambdas_of(body);
  let sites = called_known_lambdas(known_values(body, slots, full_name, own, []));
  known_values(
    body,
    slots,
    full_name,
    own,
    sites.filter(|s: KnownLambda| sites.filter(|t: KnownLambda| t == s).len() > 1),
  )
}

type KnownLambda = { owner: Bytes, nth: Int }

fn called_known_lambdas(c: Code) -> List<KnownLambda> = {
  let known_lambda_read = |x: Code|
    match x.node { CodeKnownLambda(k) -> [{ owner: k.owner, nth: k.nth }], _ -> [] };
  match c.node {
    CodeKnownLambda(_) -> [],
    _ -> {
      let definitions = match c.node {
        CodeApply(a) ->
          known_lambda_read(a.function).concat(if !reads_walk(a.function) { [] } else {
            match a.args.at(a.args.len() - 1) { Some(x) -> known_lambda_read(x), None -> [] }
          }),
        _ -> [],
      };
      code_children(c).fold(definitions, |accumulator: List<KnownLambda>, x: Code|
        accumulator.concat(called_known_lambdas(x)))
    },
  }
}

pub type NamedDefinition = { full: Bytes, definition: Definition }

type Reference = { st: Lowering, callee: Callee, args: List<Type>, given: List<Type> }

type ClosureLayout = {
  captured: List<Variable>,
  labels: List<Variable>,
  held_evidence: EvidenceValues<Variable>,
  parameters: List<Variable>,
  evidence_parameters: List<Variable>,
  result: Representation,
  ty: Type,
  return_type: Type,
}

fn captures_in_order<a>(
  note_captures: List<a>,
  labels: List<a>,
  evidence_values: EvidenceValues<a>,
) -> List<a> = note_captures.concat(labels).concat(listed_evidence_values(evidence_values))

fn shape_captures(s: ClosureLayout) -> List<Variable> =
  captures_in_order(s.captured, s.labels, s.held_evidence)

fn shape_params(s: ClosureLayout) -> List<Variable> =
  shape_captures(s).concat(s.parameters).concat(s.evidence_parameters)

fn shape_convention(s: ClosureLayout) -> Convention = {
  let params = shape_params(s);
  {
    params: owned_params(params.map(|v: Variable| v.representation)),
    result: s.result,
    destination_passing: false,
    returned: typed_ir::OwnedResult,
  }
}

fn numbered(
  first: Int,
  specs: List<{ ty: Type, representation: Representation }>,
) -> { vars: List<Variable>, next: Int } =
  {
    vars: specs.fold(
      [],
      |accumulator: List<Variable>, s: { ty: Type, representation: Representation }|
        accumulator.push({
          id: first + accumulator.len(),
          ty: s.ty,
          representation: s.representation,
        }),
    ),
    next: first + specs.len(),
  }

fn continuation_type(t: Type, resumes: Option<Effects>) -> Type =
  match ((t, resumes)) { (FunctionType(f), Some(r)) -> FunctionType({ ..f, effects: r }), _ -> t }

fn closure_layout(context: Context, env: Map<Int, Arg>, frame: Frame, at: Span) -> ClosureLayout = {
  let f = frame.ty;
  let continued = |j: Int| frame.resumes != None && j == frame.params - 1;
  let capture_representations = capture_representations(context, frame.body, frame.captures);
  let note_captures = numbered(
    0,
    range(0, frame.captures.len()).map(|i: Int|
      {
        ty: match frame.captures.at(i) {
          Some(c) -> match env.get(c.source) { Some(a) -> type_of(a), None -> unknown_type() },
          None -> unknown_type(),
        },
        representation: match capture_representations.at(i) { Some(r) -> r, None -> AsWord },
      }),
  );
  let labels = numbered(
    note_captures.next,
    frame_labels(context, frame).map(|_: Int| { ty: int_type(), representation: AsInt }),
  );
  let uncounted = { ty: evidence_type(), representation: AsImmediate };
  let words_held = numbered(
    labels.next,
    frame.captured_evidence.words.map(|_: EvidenceWord| uncounted),
  );
  let instance = numbered(words_held.next, match frame.captured_evidence.instance {
    Some(_) -> [uncounted],
    None -> [],
  });
  let retained_evidence = numbered(
    instance.next,
    frame.captured_evidence.retained_values.map(|_: Arg|
      { ty: instance_block_type(), representation: AsWord }),
  );
  let own = numbered(
    retained_evidence.next,
    f.params.fold([], |accumulator: List<{ ty: Type, representation: Representation }>, t: Type|
      accumulator.push(if continued(accumulator.len()) {
        { ty: resumption(continuation_type(t, frame.resumes)), representation: AsWord }
      } else { { ty: t, representation: representation_of(context.setting, t) } })),
  );
  let laid = if frame.words.len() > max_evidence_params() { evidence_array_type() }
  else { evidence_type() };
  let words = numbered(
    own.next,
    range(0, evidence_param_count(frame.words.len())).map(|_: Int|
      { ty: laid, representation: AsImmediate }),
  );
  {
    captured: note_captures.vars,
    labels: labels.vars,
    held_evidence: {
      words: words_held.vars,
      instance: instance.vars.at(0),
      retained_values: retained_evidence.vars,
    },
    parameters: own.vars,
    evidence_parameters: words.vars,
    result: if frame.resumes != None { AsWord }
    else { representation_of(context.setting, f.return_type) },
    ty: FunctionType(f),
    return_type: f.return_type,
  }
}

fn frame_labels(context: Context, frame: Frame) -> List<Int> =
  labels_read(
    context,
    frame.body,
    caller_filled_labels(
      frame.words.concat(
        frame.captured_evidence.words.map(|w: EvidenceWord|
          { evidence: w.evidence, from_variable: w.inherited }),
      ),
    ),
  )

fn empty_function(context: Context) -> Function =
  {
    key: context.key,
    kind: Metered,
    params: [],
    convention: {
      params: [],
      result: AsWord,
      destination_passing: false,
      returned: typed_ir::OwnedResult,
    },
    result_type: word_type(),
    body: [],
    lambdas: [],
    base: context.base,
    members: [],
    links: no_links(),
    statics: [],
  }

fn capture_type(st: Lowering, at: Span, i: Int) -> Type =
  range(0, st.lambdas.len()).fold(unknown_type(), |accumulator: Type, k: Int|
    match st.lambdas.at(k) {
      Some(Closure(c)) -> if c.at.site == at.site && i < c.captures {
        match c.body.params.at(i) { Some(v) -> v.ty, None -> accumulator }
      } else { accumulator },
      None -> accumulator,
    })

fn capture_representations(
  context: Context,
  body: Code,
  captures: List<Capture>,
) -> List<Representation> =
  captures.map(|c: Capture|
    match slot_read(body, c.destination) {
      Some(read) -> {
        let r = representation_of(context.setting, read.ty);
        if passing(r) == ByValue { r } else { AsWord }
      },
      None -> AsWord,
    })

fn capture_offset(representations: List<Representation>, i: Int) -> Int =
  representations.take(i).fold(0, |n: Int, r: Representation| n + value_words(r))

fn captured_type(context: Context, st: Lowering, l: Lambda, i: Int) -> Type = {
  let own = capture_type(st, l.at, i);
  if own != unknown_type() { own } else {
    match match l.captures.at(i) { Some(c) -> slot_read(l.body, c.destination), None -> None } {
      Some(read) -> read.ty,
      None -> unknown_type(),
    }
  }
}

fn slot_read(c: Code, slot: Int) -> Option<Code> = {
  let first = |codes: List<Code>|
    codes.fold(None, |accumulator: Option<Code>, x: Code|
      match accumulator { Some(_) -> accumulator, None -> slot_read(x, slot) });
  let into = |captures: List<Capture>|
    captures.fold(None, |accumulator: Option<Int>, k: Capture|
      match accumulator {
        Some(_) -> accumulator,
        None -> if k.source == slot { Some(k.destination) } else { None },
      });
  match c.node {
    CodeVariable(v) -> if v.slot == slot { Some(c) } else { None },
    CodeKnownLambda(k) -> if k.slot == slot { Some(c) } else { None },
    CodeUnary(u) -> slot_read(u.operand, slot),
    CodeBinary(b) -> first([b.left_operand, b.right_operand]),
    CodeApply(a) -> first(a.args.push(a.function)),
    CodeIf(i) -> first([i.cond, i.then_branch, i.else_branch]),
    CodeBlock(b) ->
      first(
        b.statements.fold(
          match b.tail { Some(t) -> [t], None -> [] },
          |accumulator: List<Code>, statement: CodeStatement|
            accumulator.push(match statement {
              CodeLet(l) -> l.value,
              CodeLetDestructure(l) -> l.value,
              CodeDo(d) -> d.code,
            }),
        ),
      ),
    CodeList(l) -> first(l.items),
    CodeRecord(r) -> first(r.fields.map(|f: CodeField| f.value)),
    CodeUpdate(u) -> first(u.sets.map(|f: CodeField| f.value).push(u.base)),
    CodeMatch(m) ->
      first(
        m.arms.fold([m.scrutinee], |accumulator: List<Code>, a: CodeArm|
          List::push(
            match a.guard { Some(g) -> accumulator.push(g), None -> accumulator },
            a.body,
          )),
      ),
    CodePerform(p) -> first(match p.label { Some(l) -> p.args.push(l), None -> p.args }),
    CodeFieldRead(f) -> slot_read(f.base, slot),
    CodeParallel(p) -> first(p.branches),
    CodeLambda(l) -> match into(l.captures) { Some(d) -> slot_read(l.body, d), None -> None },
    CodeSimulate(s) -> match into(s.captures) { Some(d) -> slot_read(s.body, d), None -> None },
    CodeHandle(h) -> match slot_read(h.body, slot) {
      Some(x) -> Some(x),
      None ->
        h.clauses.fold(
          match h.return_clause {
            Some(r) -> match into(r.captures) { Some(d) -> slot_read(r.body, d), None -> None },
            None -> None,
          },
          |accumulator: Option<Code>, clause: CodeClause|
            match accumulator {
              Some(_) -> accumulator,
              None -> match into(clause.captures) {
                Some(d) -> slot_read(clause.body, d),
                None -> None,
              },
            },
        ),
    },
    _ -> None,
  }
}

fn generic(d: Definition) -> Bool =
  match d.scheme {
    Some(scheme) -> scheme.type_variables.len() > 0 || scheme.effect_variables.len() > 0,
    None -> false,
  }

fn constant_lowered(
  context: Context,
  st: Lowering,
  value: ConstantData,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match value {
    LiteralData(l) -> literal(context, st, l, at),
    RecordData(r) -> {
      let made = r.fields.fold(
        { st: st, fields: [] },
        |accumulator: { st: Lowering, fields: List<{ name: Bytes, arg: Arg }> }, f: { name: Bytes, value: ConstantData }| {
          let o = constant_lowered(context, accumulator.st, f.value, at);
          { st: o.st, fields: accumulator.fields.push({ name: f.name, arg: o.arg }) }
        },
      );
      record_literal(context, made.st, made.fields, r.ty, at)
    },
    CaseData(c) -> {
      let made = c.args.fold(
        { st: st, args: [] },
        |accumulator: { st: Lowering, args: List<Arg> }, x: ConstantData| {
          let o = constant_lowered(context, accumulator.st, x, at);
          { st: o.st, args: accumulator.args.push(o.arg) }
        },
      );
      constructed(context, made.st, c.name, made.args, c.ty, at)
    },
  }

fn constant_read(
  context: Context,
  st: Lowering,
  d: NamedDefinition,
  function: Code,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match return_type_at(d.definition, reference_args(function)) {
    None -> unreachable(b"a constant of no function type: ".concat(d.full)),
    Some(return_type) ->
      represented_as(
        bound_as(
          st,
          return_type,
          AsWord,
          OperationCall({
            operation: OfCalling(
              ConstantRead({
                callee: Root(d.definition.root),
                value_type: return_type,
                constant: d.definition.constant,
              }),
            ),
            args: [],
            uses: owned_fallible_uses(),
          }),
          at,
        ),
        representation_of(context.setting, return_type),
        at,
      ),
  }

fn borrows_outlive_jump(context: Context, d: NamedDefinition, args: List<Arg>) -> Bool = {
  let own = context.setting.definitions.fold([], |accumulator: List<Int>, h: Definition|
    if Some(qualify(context.setting.module, h.name)) == definition_of(context.key) { h.borrowed }
    else { accumulator });
  d.definition.borrowed.all(|k: Int|
    match args.at(k) {
      Some(a) ->
        !is_refcounted(operand_representation(a))
          || (match a {
            VariableOperand(v) -> v.id < context.params.len() && own.contains(v.id),
            _ -> false,
          }),
      None -> false,
    })
}

fn tail_jump(
  context: Context,
  st: Lowering,
  d: NamedDefinition,
  function: Code,
  codes: List<Code>,
  args: List<Arg>,
  at: Span,
) -> Option<LoweredValue> / {abort.raise} =
  if context.tails == PlainCalls || !borrows_outlive_jump(context, d, args) { None } else {
    let given = evidence_arguments(
      context,
      st,
      d.definition,
      function,
      label_codes(d.definition, codes),
    );
    tail_jump_with_evidence(context, st, d, function, codes, args, given, at)
  }

fn tail_jump_with_evidence(
  context: Context,
  st: Lowering,
  d: NamedDefinition,
  function: Code,
  codes: List<Code>,
  args: List<Arg>,
  given: EvidenceArguments,
  at: Span,
) -> Option<LoweredValue> / {abort.raise} =
  if unspecialised(context.key) == d.definition.root && args.len() == context.params.len()
      && is_self_reference(
        context,
        reference_args(function),
        function_arguments(context, d.definition, codes),
        given.effect_evidence,
      )
      && (passed_as_given(context, given) || given.words.len() <= max_evidence_params()) {
    let e = if passed_as_given(context, given) { { st: st, args: context.evidence_arguments } }
    else { passed_evidence_arguments(st, given, at) };
    let h = all_represented_as(e.st, args.concat(e.args), parameter_representations(context), at);
    Some({
      st: emitted(h.st, Restart(h.args)),
      arg: ZeroOperand(representation_of(context.setting, context.result_type)),
    })
  } else {
    match context.tails {
      Enters(keys) -> match member_at(
          keys,
          instance_key(
            d.full,
            reference_args(function).map(|t: Type|
              if has_variables(t) { unknown_type() } else { t }),
          ),
        ) {
        Some(i) -> match call_signature_at(context.setting, d.definition, match keys.at(i) {
            Some(k) -> key_types(k),
            None -> [],
          }) {
          None -> Some(unreachable(b"a member of a tail-calling group has no type")),
          Some(c) -> {
            let e = passed_evidence_arguments(st, given, at);
            let h = all_represented_as(
              e.st,
              args.concat(e.args),
              reps_of(
                with_evidence_parameters(
                  signature_convention(context.setting, c),
                  given.labels.len(),
                  given.words.len(),
                ),
              ),
              at,
            );
            Some({
              st: emitted(h.st, Jump({ member: i, args: h.args })),
              arg: ZeroOperand(representation_of(context.setting, context.result_type)),
            })
          },
        },
        None -> None,
      },
      _ -> None,
    }
  }

fn member_at(keys: List<RootKey>, key: RootKey) -> Option<Int> =
  range(0, keys.len()).fold(None, |accumulator: Option<Int>, i: Int|
    match accumulator {
      Some(_) -> accumulator,
      None -> if keys.at(i) == Some(key) { Some(i) } else { None },
    })

fn convention_call(
  context: Context,
  st: Lowering,
  d: NamedDefinition,
  function: Code,
  codes: List<Code>,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let given = evidence_arguments(
    context,
    st,
    d.definition,
    function,
    label_codes(d.definition, codes),
  );
  called_as(
    context,
    d,
    given,
    named_ref(
      context,
      st,
      d,
      function,
      function_arguments(context, d.definition, codes),
      given.effect_evidence,
    ),
    codes,
    args,
    at,
  )
}

pub fn called_at_types(
  context: Context,
  st: Lowering,
  name: Bytes,
  types: List<Type>,
  rows: List<Effects>,
  codes: List<Code>,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match definition_named(context, name) {
    None ->
      unreachable(b"a call of a function that was not loaded into the program: ".concat(name)),
    Some(d) -> defined_called(context, st, d, types, rows, codes, args, at),
  }

fn defined_called(
  context: Context,
  st: Lowering,
  d: NamedDefinition,
  types: List<Type>,
  rows: List<Effects>,
  codes: List<Code>,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let given = evidence_arguments_filled(context, d.definition, rows, []);
  called_as(
    context,
    d,
    given,
    reference_to(
      context.setting,
      st,
      d,
      types,
      function_arguments(context, d.definition, codes),
      given.effect_evidence,
    ),
    codes,
    args,
    at,
  )
}

pub fn simulate_called(
  context: Context,
  st: Lowering,
  body: Arg,
  effects: Effects,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let name = scheduler_module().concat(b"::simulated");
  let returned = match definition_named(context, name) {
    Some(d) -> match d.definition.scheme {
      Some(scheme) -> match scheme.ty {
        FunctionType(f) -> match f.params.last() {
          Some(FunctionType(b)) -> b.effects.listed.map(|a: Effect| a.effect),
          _ -> [],
        },
        _ -> [],
      },
      None -> [],
    },
    None -> [],
  };
  let sites = range(0, 3).fold(
    { st: st, args: [] },
    |accumulator: { st: Lowering, args: List<Arg> }, part: Int| {
      let s = bound_as(
        accumulator.st,
        int_type(),
        AsInt,
        OperationCall({
          operation: OfHandling(CurrentSite(part)),
          args: [],
          uses: { takes: [], owned: false, fails: false, suspends: false },
        }),
        at,
      );
      { st: s.st, args: accumulator.args.push(s.arg) }
    },
  );
  called_at_types(
    context,
    sites.st,
    name,
    [match type_of(body) { FunctionType(f) -> f.return_type, _ -> unknown_type() }],
    [{ ..effects, listed: effects.listed.filter(|a: Effect| !returned.contains(a.effect)) }],
    [],
    sites.args.push(body),
    at,
  )
}

fn called_as(
  context: Context,
  d: NamedDefinition,
  given: EvidenceArguments,
  n: Reference,
  codes: List<Code>,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let st = n.st;
  match ((
      call_signature_at(context.setting, d.definition, n.args),
      return_type_at(d.definition, n.given),
    )) {
    (None, _) -> unreachable(b"a call of a definition that has no type: ".concat(d.full)),
    (_, None) ->
      unreachable(b"a call of a definition whose type is not a function type: ".concat(d.full)),
    (Some(c), Some(return_type)) -> {
      let conv = with_evidence_parameters(
        signature_convention(context.setting, c),
        given.labels.len(),
        given.words.len(),
      );
      let e = passed_evidence_arguments(
        note_forwarded_functions(
          context,
          lambdas_stack_allocated(n.st, d.definition.borrowed, codes, args),
          Named(d.full),
          codes,
          args,
        ),
        given,
        at,
      );
      let h = all_represented_as(e.st, args.concat(e.args), reps_of(conv), at);
      represented_as(
        bound_as(
          h.st,
          return_type,
          conv.result,
          Call({
            callee: n.callee,
            args: h.args,
            convention: conv,
            suspends: match d.definition.scheme {
              Some(scheme) -> match scheme.ty {
                FunctionType(f) -> may_suspend(f.effects),
                _ -> true,
              },
              None -> true,
            },
          }),
          at,
        ),
        representation_of(context.setting, return_type),
        at,
      )
    },
  }
}

fn return_type_at(d: Definition, given: List<Type>) -> Option<Type> =
  match d.scheme {
    Some(scheme) -> match scheme.ty {
      FunctionType(f) -> if scheme.type_variables.len() == 0 { Some(f.return_type) }
      else if given.len() == scheme.type_variables.len() {
        Some(substituted_fully(f.return_type, given))
      } else { None },
      other -> if scheme.type_variables.len() == 0 { Some(other) } else { None },
    },
    None -> None,
  }

fn may_suspend(effects: Effects) -> Bool =
  effects.variable != None || run_needs(effects.listed).len() > 0

fn all_represented_as(
  st: Lowering,
  args: List<Arg>,
  reps: List<Representation>,
  at: Span,
) -> { st: Lowering, args: List<Arg> } =
  range(0, args.len()).fold(
    { st: st, args: [] },
    |accumulator: { st: Lowering, args: List<Arg> }, i: Int|
      match args.at(i) {
        Some(a) -> {
          let h = represented_as(
            { st: accumulator.st, arg: a },
            match reps.at(i) { Some(r) -> r, None -> AsWord },
            at,
          );
          { st: h.st, args: accumulator.args.push(h.arg) }
        },
        None -> accumulator,
      },
  )

fn named_ref(
  context: Context,
  st: Lowering,
  d: NamedDefinition,
  function: Code,
  functions: List<InlinedLambda>,
  effect_evidence: List<List<Evidence>>,
) -> Reference / {abort.raise} = {
  let given = reference_args(function);
  if unspecialised(context.key) == d.definition.root
      && is_self_reference(context, given, functions, effect_evidence) {
    { st: st, callee: Root(context.key), args: key_types(context.key), given: given }
  } else { reference_to(context.setting, st, d, given, functions, effect_evidence) }
}

fn reference_to(
  s: ModuleContext,
  st: Lowering,
  d: NamedDefinition,
  given: List<Type>,
  functions: List<InlinedLambda>,
  effect_evidence: List<List<Evidence>>,
) -> Reference =
  if given.len() == 0 && functions.len() == 0 && effect_evidence.len() == 0 {
    { st: st, callee: Root(d.definition.root), args: [], given: given }
  } else {
    {
      st: {
        ..st,
        links: {
          ..st.links,
          generics: st.links.generics.push({
            callee: Named(d.full),
            args: given,
            specialised_variables: match d.definition.scheme {
              Some(scheme) -> specialised_variables(s, scheme, given, d.definition.arity),
              None -> [],
            },
            functions: functions,
            effect_evidence: effect_evidence,
          }),
        },
      },
      callee: Generic(st.links.generics.len()),
      args: given,
      given: given,
    }
  }

pub fn instance_key(full_name: Bytes, args: List<Type>) -> RootKey =
  if args.all(|t: Type| t == unknown_type()) { Named(full_name) }
  else { specialisation_key(full_name, args, []) }

fn is_self_reference(
  context: Context,
  given: List<Type>,
  functions: List<InlinedLambda>,
  effect_evidence: List<List<Evidence>>,
) -> Bool / {abort.raise} =
  match context.key {
    Specialisation(a, _) ->
      same_functions(a.borrowed, functions) && a.effect_evidence == effect_evidence
        && given.len() == a.args.len()
        && range(0, given.len()).all(|j: Int|
          match ((a.args.at(j), given.at(j))) {
            (Some(KeyType(m)), Some(g)) -> m == unknown_type() || g == m,
            (Some(KeyLayout(l)), Some(g)) ->
              g == l.at
                || (!has_variables(g) && layout_key(context.setting.constructors, g) == l.key),
            _ -> false,
          }),
    _ -> true,
  }

fn lambdas_stack_allocated(
  st: Lowering,
  borrowed: List<Int>,
  codes: List<Code>,
  args: List<Arg>,
) -> Lowering =
  borrowed.fold(st, |accumulator: Lowering, i: Int|
    match codes.at(i) {
      Some(c) -> match c.node {
        CodeLambda(_) -> match args.at(i) {
          Some(VariableOperand(v)) ->
            {
              ..accumulator,
              instructions: stack_allocated_in_block(
                accumulator.instructions,
                v,
                accumulator.instructions.len() - 1,
              ),
            },
          _ -> accumulator,
        },
        _ -> accumulator,
      },
      None -> accumulator,
    })

pub fn stack_allocated(l: LoweredValue) -> LoweredValue =
  match l.arg {
    VariableOperand(v) ->
      {
        ..l,
        st: {
          ..l.st,
          instructions: stack_allocated_in_block(l.st.instructions, v, l.st.instructions.len() - 1),
        },
      },
    _ -> l,
  }

fn stack_allocated_in_block(b: Block, v: Variable, i: Int) -> Block =
  if i < 0 { b } else {
    match b.at(i) {
      Some(Let(x)) -> if x.var != v { stack_allocated_in_block(b, v, i - 1) } else {
        match x.value {
          Allocate(m) -> match m.made {
            ClosureAllocation(_) ->
              b.set(i, Let({ ..x, value: Allocate({ ..m, made: StackAllocation(m.made) }) })),
            _ -> b,
          },
          _ -> b,
        }
      },
      _ -> stack_allocated_in_block(b, v, i - 1),
    }
  }

fn note_forwarded_functions(
  context: Context,
  st: Lowering,
  callee: RootKey,
  codes: List<Code>,
  args: List<Arg>,
) -> Lowering =
  if context.tails == PlainCalls { st } else {
    range(0, codes.len()).fold(st, |accumulator: Lowering, i: Int|
      match codes.at(i) {
        Some(c) -> match c.node {
          CodeVariable(_) -> {
            match args.at(i) {
              Some(VariableOperand(p)) -> match context.parameter_positions.get(p.id) {
                Some(j) -> if may_hold_function(context, j) {
                  {
                    ..accumulator,
                    links: {
                      ..accumulator.links,
                      forwarded_parameters: accumulator.links.forwarded_parameters.push({
                        param: j,
                        callee: callee,
                        at: i,
                      }),
                    },
                  }
                } else { accumulator },
                None -> accumulator,
              },
              _ -> accumulator,
            }
          },
          _ -> accumulator,
        },
        None -> accumulator,
      })
  }

fn note_parameter_called(context: Context, st: Lowering, f: Arg) -> Lowering =
  match f {
    VariableOperand(p) -> match context.parameter_positions.get(p.id) {
      Some(j) -> if context.tails == PlainCalls || st.links.called.contains(j) { st }
      else { { ..st, links: { ..st.links, called: st.links.called.push(j) } } },
      None -> st,
    },
    _ -> st,
  }

fn may_hold_function(context: Context, j: Int) -> Bool =
  match context.types.at(j) {
    Some(t) -> match t { FunctionType(_) -> true, VariableType(_) -> true, _ -> false },
    None -> true,
  }

fn function_arguments(
  context: Context,
  callee: Definition,
  codes: List<Code>,
) -> List<InlinedLambda> / {abort.raise} = {
  let owner = root_text(root_name(context.key));
  let borrows = context.allows_lambda_inlining;
  let by = match context.inlined_from {
    Some(b) -> Some(b),
    None -> if borrows { Some({ owner: context.key, written: context.written }) } else { None },
  };
  let handed_as = |j: Int, l: Lambda, accumulator: List<InlinedLambda>|
    match if !inlinable(context, l) || labelled_param(callee, j) { None } else { by } {
      None -> accumulator,
      Some(b) -> match position_in(b.written, l) {
        Some(nth) -> accumulator.push({ param: j, owner: b.owner, nth: nth }),
        None -> accumulator,
      },
    };
  if walk_kind(callee) != None { [] } else {
    range(0, codes.len()).fold([], |accumulator: List<InlinedLambda>, j: Int|
      match codes.at(j) {
        Some(c) -> match c.node {
          CodeLambda(l) -> handed_as(j, l, accumulator),
          CodeKnownLambda(k) -> if labelled_param(callee, j) { accumulator }
          else if k.owner != owner || (borrows && inlinable(context, k.lambda)) {
            accumulator.push({ param: j, owner: owner_named(context, k.owner), nth: k.nth })
          } else { accumulator },
          NDefinition(_) -> match named_arity(
              context.setting.module,
              context.setting.definitions,
              context.setting.imports,
              c,
            ) {
            Some(n) -> handed_as(j, named_lambda(c, n), accumulator),
            None -> accumulator,
          },
          _ -> accumulator,
        },
        None -> accumulator,
      })
  }
}

fn passed_as_given(context: Context, given: EvidenceArguments) -> Bool =
  given.wanted == evidence_parameters(context.setting, context.key).declared

fn labelled_param(d: Definition, j: Int) -> Bool =
  match d.scheme {
    Some(scheme) -> match scheme.ty {
      FunctionType(f) -> match f.params.at(j) {
        Some(FunctionType(p)) ->
          p.effects.listed.any(|a: Effect|
            match a.resource { ResourceVariable(_) -> true, _ -> false }),
        _ -> false,
      },
      _ -> false,
    },
    None -> false,
  }

fn inlinable(context: Context, l: Lambda) -> Bool / {abort.raise} =
  !has_handle(l.body)
    && has_static_effects({ node: CodeLambda(l), span: l.at, ty: FunctionType(l.ty) })

fn owner_named(context: Context, name: Bytes) -> RootKey / {abort.raise} =
  match context.owners.get(name) {
    Some(k) -> k,
    None ->
      panic(
        String::of_bytes_lossy(
          b"the compiler knows a lambda for this root, but the body contains no lambda for it: ".concat(
            name,
          ),
        ),
      ),
  }

fn allows_lambda_inlining(context: Context) -> Bool =
  match context.key {
    Test(_) -> true,
    Specialisation(a, _) ->
      a.borrowed.len() == 0
        && key_types(context.key).all(|t: Type| t != unknown_type() && !has_variables(t)),
    Named(n) -> match context.setting.definitions.fold(
        None,
        |accumulator: Option<Definition>, d: Definition|
          if qualify(context.setting.module, d.name) == n { Some(d) } else { accumulator },
      ) {
      Some(d) -> match d.scheme { Some(sc) -> sc.type_variables.len() == 0, None -> true },
      None -> false,
    },
    _ -> false,
  }

fn inlinable_lambdas_of(context: Context) -> List<Lambda> / {abort.raise} =
  lambdas_of(context.body).concat(
    named_in(
      context.setting.module,
      context.setting.definitions,
      context.setting.imports,
      context.body,
    ),
  )

fn named_arity(
  module: Bytes,
  definitions: List<Definition>,
  imports: List<Imported>,
  c: Code,
) -> Option<Int> =
  match c.node {
    NDefinition(v) -> {
      match definition_full(module, definitions, imports, v.full) {
        Some(d) -> match d.definition.scheme {
          Some(scheme) -> match scheme.ty {
            FunctionType(f) -> if d.definition.witnesses == 0
                && f.params.len() == d.definition.arity { Some(d.definition.arity) }
            else { None },
            _ -> None,
          },
          None -> None,
        },
        None -> None,
      }
    },
    _ -> None,
  }

fn named_lambda(c: Code, n: Int) -> Lambda = {
  let f = match c.ty {
    FunctionType(t) -> t,
    _ ->
      {
        params: [],
        keep_parameters: [],
        once: false,
        return_type: unknown_type(),
        effects: no_effects(),
      },
  };
  {
    params: n,
    size: n,
    captures: [],
    at: c.span,
    ty: f,
    effects: f.effects,
    body: {
      node: CodeApply({
        function: c,
        args: range(0, n).map(|i: Int|
          {
            node: CodeVariable({ name: b"p".concat(ascii_of_int(i)), slot: i }),
            span: c.span,
            ty: match f.params.at(i) { Some(t) -> t, None -> unknown_type() },
          }),
        effects: no_effects(),
      }),
      span: c.span,
      ty: f.return_type,
    },
  }
}

fn called_frame(k: KnownLambdaCall) -> Lambda =
  {
    ..k.lambda,
    size: k.lambda.params + 1,
    captures: [{ source: k.slot, destination: k.lambda.params }],
  }

pub fn known_run(
  context: Context,
  st: Lowering,
  k: KnownLambdaCall,
  effects: Effects,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let f = known_lambda_read(context, st, { ..k, slot: k.lambda.params }, at);
  let read = range(0, k.lambda.params).fold(
    { st: f.st, args: [] },
    |accumulator: { st: Lowering, args: List<Arg> }, j: Int|
      match accumulator.st.env.get(j) {
        Some(x) ->
          {
            st: note_slot_read(context, accumulator.st, read_note(), j, at),
            args: accumulator.args.push(x),
          },
        None -> accumulator,
      },
  );
  known_applied(context, read.st, k, f.arg, read.args, effects, false, at)
}

pub fn named_in(
  module: Bytes,
  definitions: List<Definition>,
  imports: List<Imported>,
  c: Code,
) -> List<Lambda> / {abort.raise} = {
  let go = |x: Code| named_in(module, definitions, imports, x);
  let within = |codes: List<Code>|
    codes.fold([], |accumulator: List<Lambda>, x: Code| accumulator.concat(go(x)));
  match c.node {
    CodeApply(a) -> {
      let callee = match a.function.node {
        NDefinition(v) -> definition_full(module, definitions, imports, v.full) != None,
        _ -> false,
      };
      let named_arguments = if !callee { [] } else {
        a.args.fold([], |accumulator: List<Lambda>, x: Code|
          match named_arity(module, definitions, imports, x) {
            Some(n) -> accumulator.push(named_lambda(x, n)),
            None -> accumulator,
          })
      };
      named_arguments.concat(within(a.args.push(a.function)))
    },
    CodeLambda(l) -> go(l.body),
    CodeUnary(u) -> go(u.operand),
    CodeBinary(b) -> within([b.left_operand, b.right_operand]),
    CodeFieldRead(f) -> go(f.base),
    CodeIf(i) -> within([i.cond, i.then_branch, i.else_branch]),
    CodeBlock(b) ->
      within(
        b.statements.fold(
          match b.tail { Some(t) -> [t], None -> [] },
          |accumulator: List<Code>, statement: CodeStatement|
            accumulator.push(match statement {
              CodeLet(l) -> l.value,
              CodeLetDestructure(l) -> l.value,
              CodeDo(d) -> d.code,
            }),
        ),
      ),
    CodeList(l) -> within(l.items),
    CodeRecord(r) -> within(r.fields.map(|f: CodeField| f.value)),
    CodeUpdate(u) -> within(u.sets.map(|f: CodeField| f.value).push(u.base)),
    CodeMatch(m) ->
      within(
        m.arms.fold([m.scrutinee], |accumulator: List<Code>, a: CodeArm|
          List::push(
            match a.guard { Some(g) -> accumulator.push(g), None -> accumulator },
            a.body,
          )),
      ),
    CodePerform(x) -> within(x.args),
    CodeSimulate(x) -> go(x.body),
    CodeParallel(x) -> within(x.branches),
    CodeHandle(h) ->
      within(
        h.clauses.fold(
          match h.return_clause { Some(r) -> [h.body, r.body], None -> [h.body] },
          |accumulator: List<Code>, clause: CodeClause| accumulator.push(clause.body),
        ),
      ),
    _ -> [],
  }
}

pub fn lambdas_of(c: Code) -> List<Lambda> = {
  let within = |codes: List<Code>|
    codes.fold([], |accumulator: List<Lambda>, x: Code| accumulator.concat(lambdas_of(x)));
  match c.node {
    CodeLambda(l) -> [l].concat(lambdas_of(l.body)),
    CodeUnary(u) -> lambdas_of(u.operand),
    CodeBinary(b) -> within([b.left_operand, b.right_operand]),
    CodeFieldRead(f) -> lambdas_of(f.base),
    CodeApply(a) -> within(a.args.push(a.function)),
    CodeIf(i) -> within([i.cond, i.then_branch, i.else_branch]),
    CodeBlock(b) ->
      within(
        b.statements.fold(
          match b.tail { Some(t) -> [t], None -> [] },
          |accumulator: List<Code>, statement: CodeStatement|
            accumulator.push(match statement {
              CodeLet(l) -> l.value,
              CodeLetDestructure(l) -> l.value,
              CodeDo(d) -> d.code,
            }),
        ),
      ),
    CodeList(l) -> within(l.items),
    CodeRecord(r) -> within(r.fields.map(|f: CodeField| f.value)),
    CodeUpdate(u) -> within(u.sets.map(|f: CodeField| f.value).push(u.base)),
    CodeMatch(m) ->
      within(
        m.arms.fold([m.scrutinee], |accumulator: List<Code>, a: CodeArm|
          List::push(
            match a.guard { Some(g) -> accumulator.push(g), None -> accumulator },
            a.body,
          )),
      ),
    CodePerform(x) -> within(x.args),
    CodeSimulate(x) -> lambdas_of(x.body),
    CodeParallel(x) -> within(x.branches),
    CodeHandle(h) ->
      within(
        h.clauses.fold(
          match h.return_clause { Some(r) -> [h.body, r.body], None -> [h.body] },
          |accumulator: List<Code>, clause: CodeClause| accumulator.push(clause.body),
        ),
      ),
    _ -> [],
  }
}

fn position_in(ls: List<Lambda>, l: Lambda) -> Option<Int> =
  range(0, ls.len()).fold(None, |accumulator: Option<Int>, k: Int|
    match accumulator {
      Some(_) -> accumulator,
      None -> if ls.at(k) == Some(l) { Some(k) } else { None },
    })

pub fn has_handle(c: Code) -> Bool = has_handle_matching(c, |clauses: List<CodeClause>| true)

pub fn has_handle_matching(c: Code, counted: (List<CodeClause>) -> Bool) -> Bool = {
  let within = |codes: List<Code>|
    codes.fold(false, |accumulator: Bool, x: Code| accumulator || has_handle_matching(x, counted));
  match c.node {
    CodeHandle(h) ->
      counted(h.clauses) || has_handle_matching(h.body, counted)
        || within(h.clauses.map(|clause: CodeClause| clause.body))
        || (match h.return_clause {
          Some(r) -> has_handle_matching(r.body, counted),
          None -> false,
        }),
    CodeUnary(u) -> has_handle_matching(u.operand, counted),
    CodeBinary(b) -> within([b.left_operand, b.right_operand]),
    CodeFieldRead(f) -> has_handle_matching(f.base, counted),
    CodeApply(a) -> within(a.args.push(a.function)),
    CodeIf(i) -> within([i.cond, i.then_branch, i.else_branch]),
    CodeBlock(b) ->
      (match b.tail { Some(t) -> has_handle_matching(t, counted), None -> false })
        || b.statements.fold(false, |accumulator: Bool, statement: CodeStatement|
          accumulator
            || (match statement {
              CodeLet(l) -> has_handle_matching(l.value, counted),
              CodeLetDestructure(l) -> has_handle_matching(l.value, counted),
              CodeDo(d) -> has_handle_matching(d.code, counted),
            })),
    CodeList(l) -> within(l.items),
    CodeRecord(r) -> within(r.fields.map(|f: CodeField| f.value)),
    CodeUpdate(u) -> within(u.sets.map(|f: CodeField| f.value).push(u.base)),
    CodeMatch(m) ->
      has_handle_matching(m.scrutinee, counted)
        || m.arms.fold(false, |accumulator: Bool, a: CodeArm|
          accumulator
            || (match a.guard { Some(g) -> has_handle_matching(g, counted), None -> false })
            || has_handle_matching(a.body, counted)),
    CodePerform(p) -> within(p.args),
    CodeLambda(l) -> has_handle_matching(l.body, counted),
    CodeSimulate(x) -> has_handle_matching(x.body, counted),
    CodeKnownLambda(k) -> has_handle_matching(k.lambda.body, counted),
    CodeParallel(parallel_code) -> within(parallel_code.branches),
    _ -> false,
  }
}

type KnownSlot = { slot: Int, owner: Bytes, nth: Int, code: Lambda }

fn known_values(
  c: Code,
  bound: List<KnownSlot>,
  owner: Bytes,
  own: List<Lambda>,
  again: List<KnownLambda>,
) -> Code = {
  let go = |x: Code| known_values(x, bound, owner, own, again);
  let known_lambda_read = |slot: Int|
    bound.fold(None, |found: Option<KnownSlot>, k: KnownSlot|
      if k.slot == slot { Some(k) } else { found });
  let inside = |caps: List<Capture>|
    caps.fold([], |accumulator: List<KnownSlot>, cap: Capture|
      match known_lambda_read(cap.source) {
        Some(k) -> accumulator.push({ ..k, slot: cap.destination }),
        None -> accumulator,
      });
  let maybe = |x: Option<Code>| match x { Some(y) -> Some(go(y)), None -> None };
  let node = match c.node {
    CodeVariable(v) -> match known_lambda_read(v.slot) {
      Some(k) ->
        CodeKnownLambda({
          name: v.name,
          slot: k.slot,
          lambda: k.code,
          owner: k.owner,
          nth: k.nth,
          in_place: !again.contains({ owner: k.owner, nth: k.nth }),
        }),
      None -> c.node,
    },
    CodeApply(a) -> CodeApply({ ..a, function: go(a.function), args: a.args.map(go) }),
    CodeUnary(u) -> CodeUnary({ ..u, operand: go(u.operand) }),
    CodeBinary(b) ->
      CodeBinary({ ..b, left_operand: go(b.left_operand), right_operand: go(b.right_operand) }),
    CodeIf(i) ->
      CodeIf({ cond: go(i.cond), then_branch: go(i.then_branch), else_branch: go(i.else_branch) }),
    CodeBlock(b) -> {
      let walked = b.statements.fold(
        { bound: bound, statements: [] },
        |accumulator: { bound: List<KnownSlot>, statements: List<CodeStatement> }, statement: CodeStatement|
          match statement {
            CodeLet(l) -> {
              let value = known_values(l.value, accumulator.bound, owner, own, again);
              let rest = accumulator.bound.filter(|k: KnownSlot| k.slot != l.slot);
              {
                bound: match value.node {
                  CodeLambda(lam) -> match match l.value.node {
                      CodeLambda(written) -> position_in(own, written),
                      _ -> None,
                    } {
                    Some(nth) -> if has_handle(lam.body) { rest }
                    else { rest.push({ slot: l.slot, owner: owner, nth: nth, code: lam }) },
                    None -> rest,
                  },
                  CodeKnownLambda(k) ->
                    rest.push({ slot: l.slot, owner: k.owner, nth: k.nth, code: k.lambda }),
                  _ -> rest,
                },
                statements: accumulator.statements.push(CodeLet({ ..l, value: value })),
              }
            },
            CodeLetDestructure(l) ->
              {
                bound: accumulator.bound,
                statements: accumulator.statements.push(
                  CodeLetDestructure({
                    ..l,
                    value: known_values(l.value, accumulator.bound, owner, own, again),
                  }),
                ),
              },
            CodeDo(d) ->
              {
                bound: accumulator.bound,
                statements: accumulator.statements.push(
                  CodeDo({ code: known_values(d.code, accumulator.bound, owner, own, again) }),
                ),
              },
          },
      );
      CodeBlock({
        statements: walked.statements,
        tail: match b.tail {
          Some(t) -> Some(known_values(t, walked.bound, owner, own, again)),
          None -> None,
        },
      })
    },
    CodeList(l) -> CodeList({ items: l.items.map(go) }),
    CodeRecord(r) ->
      CodeRecord({ fields: r.fields.map(|f: CodeField| { ..f, value: go(f.value) }) }),
    CodeMatch(m) ->
      CodeMatch({
        scrutinee: go(m.scrutinee),
        arms: m.arms.map(|a: CodeArm| { ..a, guard: maybe(a.guard), body: go(a.body) }),
      }),
    CodePerform(x) -> CodePerform({ ..x, label: maybe(x.label), args: x.args.map(go) }),
    CodeLambda(l) ->
      CodeLambda({ ..l, body: known_values(l.body, inside(l.captures), owner, own, again) }),
    CodeSimulate(x) ->
      CodeSimulate({ ..x, body: known_values(x.body, inside(x.captures), owner, own, again) }),
    CodeParallel(parallel_code) ->
      CodeParallel({ ..parallel_code, branches: parallel_code.branches.map(go) }),
    CodeFieldRead(f) -> CodeFieldRead({ ..f, base: go(f.base) }),
    CodeUpdate(u) ->
      CodeUpdate({
        ..u,
        base: go(u.base),
        sets: u.sets.map(|f: CodeField| { ..f, value: go(f.value) }),
      }),
    other -> other,
  };
  { ..c, node: node }
}

fn owned_fallible_uses() -> { takes: List<Bool>, owned: Bool, fails: Bool, suspends: Bool } =
  { takes: [], owned: true, fails: true, suspends: false }

fn iterate_inlinable(args: List<Code>) -> Bool =
  args.len() == 3
    && (match args.at(2) {
      Some(c) -> match c.node { CodeLambda(l) -> l.params == 1, _ -> false },
      None -> false,
    })

fn defined(context: Context, full_name: Bytes) -> Option<NamedDefinition> =
  definition_full(
    context.setting.module,
    context.setting.definitions,
    context.setting.imports,
    full_name,
  )

pub fn definition_full(
  module: Bytes,
  definitions: List<Definition>,
  imports: List<Imported>,
  full_name: Bytes,
) -> Option<NamedDefinition> =
  match last_of(definitions, |d: Definition| qualify(module, d.name) == full_name) {
    Some(d) -> Some({ full: full_name, definition: d }),
    None ->
      imports.fold(None, |accumulator: Option<NamedDefinition>, imp: Imported|
        match accumulator {
          Some(_) -> accumulator,
          None -> match imp.definitions.find(|d: Definition|
              qualify(imp.module, d.name) == full_name) {
            Some(d) -> Some({ full: full_name, definition: d }),
            None -> None,
          },
        }),
  }

fn last_of(definitions: List<Definition>, named: (Definition) -> Bool) -> Option<Definition> =
  definitions.fold(None, |accumulator: Option<Definition>, d: Definition|
    if named(d) { Some(d) } else { accumulator })

fn definition_named(context: Context, name: Bytes) -> Option<NamedDefinition> =
  definition_in(context.setting.module, context.setting.definitions, context.setting.imports, name)

pub fn definition_in(
  module: Bytes,
  definitions: List<Definition>,
  imports: List<Imported>,
  name: Bytes,
) -> Option<NamedDefinition> =
  match last_of(definitions, |d: Definition| d.name == name) {
    Some(d) -> Some({ full: qualify(module, name), definition: d }),
    None -> match imported_target(imports, name) {
      None -> None,
      Some(t) -> match t.imp.definitions.fold(
          None,
          |accumulator: Option<Definition>, d: Definition|
            if d.name == t.name { Some(d) } else { accumulator },
        ) {
        Some(d) -> Some({ full: qualify(t.imp.module, t.name), definition: d }),
        None -> None,
      },
    },
  }

fn reference_args(function: Code) -> List<Type> =
  match function.node { NDefinition(r) -> r.args, _ -> [] }

fn same_functions(a: List<InlinedLambda>, b: List<InlinedLambda>) -> Bool =
  a.len() == b.len() && a.all(|f: InlinedLambda| b.contains(f))
