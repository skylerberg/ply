//! What a call calls and how: a definition's root by the convention it has at the call's type
//! arguments, a generic definition's call the unit settles, a call in tail position as a jump, a
//! pure definition read once, a function value, a body run in place of the call, a closure made of a
//! lambda's body, and a tail group's roots as one.

import emit.code (Code, Node, NVar, NKnown, NLambda, NApp, NUnary, NBinary, NField, NIf, NBlock,
                  NList, NRecord, NUpdate, NMatch, NPerform, NSimulate, NParallel, NHandle, Lambda,
                  Capture, CodeStmt, CLet, CLetPat, CDo, CodeField, CodeArm, CodeClause, PxList,
                  PxVar)
import check.types (Type, TyFn, TyVar, TyCon, Scheme, Row, int_type, bool_type, run_needs)
import emit.typing (Filings, no_filings, unknown_type)
import syntax.parsing (Span, dummy_span)
import check.resolve.tables (qualify)
import std.bytes (ascii_of_int)
import emit.reps (Def, Imported, EmitParam, BoundLambda, has_vars, word_type, substituted,
                  substituted_fully, type_vars, resumption, resumed, layout_key, laid_known)
import emit.layout (P, classes)
import emit.answer (Layout, Exact)
import emit.release (released_vars)
import emit.keys (RootKey, FnArg, Named, At, Test, KeyType, KeyLayout, Callee, Root, Generic,
                  root_name, root_text, definition_of, key_types, unspecialised, at_key)
import emit.tir
import emit.tir (Rep, RInt, RBool, RWord, RSlice, RSum, RUnit, Var, Arg, AVar, AInt, AZero, Given,
                 Lent, Convention, Val, Prim, Make, Get, Gathered, Pack, Native, Op, OCalling,
                 MClosure, PCapture, PCase, TTag, TInt, Call, Apply, Inst, Let, Do, Decl, Assign,
                 If, Case, Match, Loop, Next, Done, Restart, Enter, Return, Fail, NoArm, Sited,
                 Block, Fn, Rooted, Member, Closure, Declined, Calling, no_links, falls_through,
                 rep_of_arg)
import emit.tir.calling (ConstantRead, Ticked)
import emit.lower.setting (Setting, Root, imported_target, ctor_named)
import emit.lower.held (held_as, case_index, arg_word, typed_convention)
import emit.lower.base (Context, Lowering, Lowered, Target, ToCtor, ToBuiltin, ToDef, ToValue,
                        ToInPlace, Frame, Opened, GroupMember, Restarts, Enters, Calls, refuse,
                        fresh, bound_as, done, emitted, opened, nested, unnested, with_lambda,
                        started, filed, unfiled, read_taken, type_of, handed, read_noted, read_note,
                        capture_note, frame_entered, taken_as, noted)
import emit.lower.data (constructed)
import emit.lower.containers (builtin)
import emit.lower.crossing (metered)

/// The context root `r` of `setting`, a definition of its own, lowers `body` under.
pub fn context_of(setting: Setting, r: Root, body: Code) -> Context / {abort.raise} = {
  let cx = lending({
    setting: setting,
    filed: match r.filed { Ok(f) -> f, Err(_) -> no_filings() },
    key: r.key,
    full: root_text(root_name(r.key)),
    base: r.base,
    params: r.params,
    types: r.types,
    answer: conventional(setting, crossing(setting, r.key, r.types, r.answer_ty)).answer,
    answer_ty: r.answer_ty,
    body: body,
    tails: Restarts([]),
    param_at: range(0, r.params.len()).fold(Map::new(), |m: Map<Int, Int>, i: Int| m.insert(i, i)),
    lender: None,
    owners: r.params.fold(
      Map::new().insert(root_text(root_name(r.key)), r.key),
      |m: Map<Bytes, RootKey>, p: EmitParam|
        match p.lambda {
          Some(bl) -> m.insert(root_text(root_name(bl.owner)), bl.owner),
          None -> m,
        },
    ),
    observing: false,
    frame: dummy_span(),
    captured: [],
    lends: false,
    written: [],
  });
  { ..cx, tails: Restarts(walked_as(cx)) }
}

/// `cx` with whether its root lends its lambdas read under its setting, and what it lends then.
fn lending(cx: Context) -> Context / {abort.raise} = {
  let lends = lends_lambdas(cx);
  { ..cx, lends: lends, written: if lends && cx.lender == None { written_in(cx) } else { [] } }
}

/// How the root takes its parameters and hands back its answer, as every call of it does.
pub fn convention(cx: Context) -> Convention / {abort.raise} =
  conventional(cx.setting, crossing(cx.setting, cx.key, cx.types, cx.answer_ty))

/// The types a call of root `key` hands its arguments at and reads its answer at, which its
/// convention holds them by: a definition's as `crossing_at` reads them at the root's type
/// arguments, and any other root's own, its parameters' `types` and its `answer`.
fn crossing(s: Setting, key: RootKey, types: List<Type>, answer: Type) -> Crossing / {abort.raise} = {
  let own = unspecialised(key);
  match s.here.fold(None, |acc: Option<Crossing>, d: Def|
      if d.root == own { crossing_at(s, d, key_types(key)) } else { acc }) {
    Some(c) -> c,
    None -> { params: types, answer: answer },
  }
}

/// The types a root's parameters and answer cross a call at.
type Crossing = { params: List<Type>, answer: Type }

/// The types a call of `d` at type arguments `args` hands its arguments at and reads its answer at,
/// which a root of it at `args` takes them at alike: its scheme's, each variable the call carries
/// (`carried_at`) read at its argument and every other left a variable, so a caller and the root
/// the unit settles its call on read the same; each witness before them and each label after them
/// an `Int`. None where no scheme speaks for `d`.
fn crossing_at(s: Setting, d: Def, args: List<Type>) -> Option<Crossing> / {abort.raise} =
  match d.scheme {
    None -> None,
    Some(sc) -> match sc.ty {
      TyFn(f) -> {
        let carried = carried_at(s, sc, args, d.arity);
        let at = range(0, args.len()).map(|j: Int|
          match args.at(j) {
            Some(t) -> if carried.contains(j) { t } else { unknown_type() },
            None -> unknown_type(),
          });
        let ints = |n: Int| range(0, n).map(|_: Int| int_type());
        Some({
          params: ints(d.witnesses).concat(f.params.map(|t: Type| substituted(t, at))).concat(
            ints(d.arity - d.witnesses - f.params.len()),
          ),
          answer: substituted(f.ret, at),
        })
      },
      _ -> None,
    },
  }

/// The variables of `scheme` a call at `args` carries as its arguments are held: each standing bare
/// as a parameter, or as the answer of a function taking any, at an argument naming no variable that
/// a body holds other than as a plain word, neither a word nor laid as one pointer, which a generic
/// body holds alike. The unit settles such a call on the callee's specialisation at each argument's
/// layout.
fn carried_at(s: Setting, scheme: Scheme, args: List<Type>, arity: Int) -> List<Int> =
  match scheme.ty {
    TyFn(f) ->
      range(0, args.len()).filter(|j: Int|
        (f.params.contains(TyVar(j)) || (arity > 0 && f.ret == TyVar(j)))
          && (match args.at(j) {
            Some(t) ->
              !has_vars(t) && held_as(s, t) != RWord
                && (match laid_known(s.ctors, t) { Some(l) -> classes(l) != [P], None -> false }),
            None -> false,
          })),
    _ -> [],
  }

/// The convention of a root whose parameters and answer cross at `c`'s types.
fn conventional(s: Setting, c: Crossing) -> Convention =
  typed_convention(s.ctors, c.params, c.answer)

/// How the root's body holds its parameters, which a restart hands its arguments to.
pub fn params_held(cx: Context) -> List<Rep> / {abort.raise} =
  match cx.tails { Restarts(reps) -> reps, _ -> convention(cx).reps }

/// How the root's body holds its parameters: as its convention takes them, but a list the body walks
/// down by restarting on a rest of it, which it holds as a view of the list it was handed, so each
/// step reads the same list further on and copies nothing.
fn walked_as(cx: Context) -> List<Rep> / {abort.raise} = {
  let reps = convention(cx).reps;
  range(0, reps.len()).map(|i: Int|
    match reps.at(i) {
      Some(RWord) -> match cx.types.at(i) {
        Some(TyCon(c)) -> if c.name == b"List" && walks(cx, cx.body, i) { RSlice } else { RWord },
        _ -> RWord,
      },
      Some(r) -> r,
      None -> RWord,
    })
}

/// Whether `c`, in tail position, matches parameter `i` against a list pattern whose rest a self call
/// in tail position in that arm hands back as its argument `i`.
fn walks(cx: Context, c: Code, i: Int) -> Bool / {abort.raise} =
  match c.node {
    NIf(x) -> walks(cx, x.then_branch, i) || walks(cx, x.else_branch, i),
    NBlock(b) -> match b.tail { Some(t) -> walks(cx, t, i), None -> false },
    NBinary(b) -> (b.op == b"and" || b.op == b"or") && walks(cx, b.rhs, i),
    NMatch(m) -> {
      let on_param = match m.scrutinee.node { NVar(v) -> v.slot == Some(i), _ -> false };
      m.arms.fold(false, |found: Bool, a: CodeArm|
        found || walks(cx, a.body, i)
          || (on_param
          && (match a.pat {
            PxList(l) -> match l.rest {
              Some(PxVar(r)) -> match r.slot {
                Some(s) -> hands_back(cx, a.body, i, s),
                None -> false,
              },
              _ -> false,
            },
            _ -> false,
          })))
    },
    _ -> false,
  }

/// Whether `c`, in tail position, calls the root's own definition with slot `r` as its argument `i`.
fn hands_back(cx: Context, c: Code, i: Int, r: Int) -> Bool / {abort.raise} =
  match c.node {
    NApp(a) ->
      a.args.len() == cx.params.len()
        && (match a.args.at(i) {
          Some(x) -> match x.node { NVar(v) -> v.slot == Some(r), _ -> false },
          None -> false,
        })
        && (match target(cx, a.func, a.args) {
          Some(ToDef(full)) -> definition_of(cx.key) == Some(full),
          _ -> false,
        }),
    NIf(x) -> hands_back(cx, x.then_branch, i, r) || hands_back(cx, x.else_branch, i, r),
    NBlock(b) -> match b.tail { Some(t) -> hands_back(cx, t, i, r), None -> false },
    NBinary(b) -> (b.op == b"and" || b.op == b"or") && hands_back(cx, b.rhs, i, r),
    NMatch(m) ->
      m.arms.fold(false, |found: Bool, a: CodeArm| found || hands_back(cx, a.body, i, r)),
    _ -> false,
  }

/// What the call of `func` on `args` calls: a lambda known to the slot it reads, run in place where
/// this frame was handed it, and otherwise its closure called as a function value, as a closure the
/// root writes calls a lambda the root was lent; a function value; a constructor; a definition; a
/// step `iterate` runs in place of each of its passes; or a builtin, an import's extern by its own
/// name.
pub fn target(cx: Context, func: Code, args: List<Code>) -> Option<Target> / {abort.raise} =
  match func.node {
    NKnown(k) -> match frame_of(cx, k.owner, k.nth) {
      None -> Some(ToValue),
      Some(_) -> Some(ToInPlace(None)),
    },
    NVar(f) -> match f.slot {
      Some(_) -> Some(ToValue),
      None -> if ctor_named(cx.setting, f.name) != None { Some(ToCtor(f.name)) } else {
        match def_named(cx, f.name) {
          Some(d) -> Some(ToDef(d.full)),
          None -> if f.name == b"iterate" && stepped(args) { Some(ToInPlace(Some(2))) }
          else { Some(ToBuiltin(extern_named(cx, f.name))) },
        }
      },
    },
    _ -> Some(ToValue),
  }

/// A name no slot holds read as a value: a constructor of no argument, the value itself; and a
/// definition, a constructor or a builtin the checker filed a function type for, the closure of a
/// lambda around a call of it, which the emitter writes at that type.
pub fn global(cx: Context, st: Lowering, name: Bytes, at: Span) -> Lowered / {abort.raise} =
  match filed(cx, at) {
    None -> unfiled(cx, st, b"a name read as a value", at),
    Some(t) -> match t.ty {
      TyFn(f) -> {
        let frame = { params: f.params.len(), size: f.params.len(), captures: [], resumes: false };
        let o = lambda_opened(cx, st, frame, at);
        let params = range(0, frame.params).fold([], |acc: List<Arg>, j: Int|
          match o.st.env.get(j) { Some(a) -> acc.push(a), None -> acc });
        let func = { node: NVar({ name: name, slot: None }), span: at };
        closure(
          cx,
          st,
          match target(o.cx, func, []) {
            Some(ToCtor(c)) -> constructed(o.cx, o.st, c, params, at, at),
            Some(ToDef(full)) -> called(o.cx, o.st, full, func, [], params, false, at),
            Some(ToBuiltin(b)) -> if cx.setting.builtins.contains(b) {
              called_builtin(o.cx, o.st, b, params, at, at)
            } else {
              refuse(o.st, Calling, b"a global the lowering does not resolve: ".concat(name))
            },
            _ -> refuse(o.st, Calling, b"a global the lowering does not resolve: ".concat(name)),
          },
          frame,
          at,
        )
      },
      _ -> if ctor_named(cx.setting, name) != None { constructed(cx, st, name, [], at, at) }
      else { refuse(st, Calling, b"a global read at no function type: ".concat(name)) },
    },
  }

/// A read of a slot known to hold the closure of a lambda its owner wrote: the closure itself, read
/// as `read_taken` reads a slot.
pub fn known(
  cx: Context,
  st: Lowering,
  k: { name: Bytes, slot: Int, lambda: Lambda, owner: Bytes, nth: Int },
  at: Span,
) -> Lowered =
  match st.env.get(k.slot) {
    Some(a) ->
      read_taken(
        cx,
        { st: read_noted(cx, st, read_note(), k.slot, at), arg: a },
        k.name,
        k.slot,
        at,
      ),
    None -> refuse(st, Calling, b"a known lambda's slot nothing bound: ".concat(k.name)),
  }

/// A call of definition `full`, which `func` names, on `args`, lowered from `codes`: a pure
/// definition of no parameters read once; a jump where the call is in tail position and the root
/// may jump there; otherwise a call through the convention the callee has at the call's type
/// arguments, a lambda written at a parameter it lends laid out on this frame's stack.
pub fn called(
  cx: Context,
  st: Lowering,
  full: Bytes,
  func: Code,
  codes: List<Code>,
  args: List<Arg>,
  tail: Bool,
  at: Span,
) -> Lowered / {abort.raise} =
  match match func.node { NVar(f) -> def_named(cx, f.name), _ -> None } {
    None -> refuse(st, Calling, b"a call of a name the module does not define: ".concat(full)),
    Some(d) -> if d.full != full {
      refuse(st, Calling, b"a call whose callee resolves elsewhere: ".concat(full))
    } else if args.len() != d.def.arity {
      refuse(st, Calling, b"a call that does not fill its parameters: ".concat(full))
    } else if args.len() == 0 && d.def.pure && !generic(d.def) {
      constant_read(cx, st, d, func.span, at)
    } else {
      match if tail { jumped(cx, st, d, func.span, codes, args, at) } else { None } {
        Some(j) -> j,
        None -> call(cx, st, d, func.span, codes, args, at),
      }
    },
  }

/// A call of the function value `f` on `args`, through the convention a function of its type has;
/// a clause's continuation, or a value of no function type, through its descriptor's uniform entry,
/// every argument and the answer a word, the answer kept as the word it is, at the type a
/// continuation answers.
pub fn applied(
  cx: Context,
  st: Lowering,
  f: Arg,
  args: List<Arg>,
  tail: Bool,
  at: Span,
) -> Lowered =
  match type_of(f) {
    TyFn(t) -> if t.params.len() != args.len() {
      refuse(st, Calling, b"a function value called with another arity")
    } else {
      let reps = t.params.map(|p: Type| held_as(cx.setting, p));
      let answer = held_as(cx.setting, t.ret);
      let h = handed_all(param_called(cx, function_laid(st, TyFn(t)), f), args, reps, at);
      bound_as(
        h.st,
        t.ret,
        answer,
        Apply({
          f: f,
          args: h.args,
          conv: {
            params: reps.map(|_: Rep| Given),
            reps: reps,
            answer: answer,
            answered: tir::Owned,
          },
          stops: stops_in(t.effects),
        }),
        at,
      )
    },
    _ -> {
      let words = args.map(|_: Arg| RWord);
      let h = handed_all(param_called(cx, st, f), args, words, at);
      bound_as(
        h.st,
        match resumed(type_of(f)) { Some(a) -> a, None -> unknown_type() },
        RWord,
        Apply({
          f: f,
          args: h.args,
          conv: {
            params: words.map(|_: Rep| Given),
            reps: words,
            answer: RWord,
            answered: tir::Owned,
          },
          stops: true,
        }),
        at,
      )
    },
  }

/// `st` noting that a specialisation would lay out each type variable function type `t` names,
/// where the body makes or applies a function value of it: the value's entry is typed at `t`, so the
/// body is emitted only where each is settled.
fn function_laid(st: Lowering, t: Type) -> Lowering =
  type_vars(t).fold(st, |s: Lowering, v: Int| noted(s, { var: v, reads: Layout }))

/// `st` noting what the descriptor of a closure capturing `captures` reads of each type variable
/// their types name, as a body letting go of a value of each type would: its release, share and keep
/// entries walk each capture by its type.
fn captures_released(st: Lowering, captures: List<Var>) -> Lowering =
  captures.fold(st, |s: Lowering, v: Var|
    released_vars(v.ty).fold(s, |q: Lowering, x: Int| noted(q, { var: x, reads: Exact })))

/// The state a body run in place of the call of `func` on `args` is lowered in. A known lambda's
/// frame: its parameters the arguments `lowered` holds, its captures read off its closure, a step
/// counted as the call it replaces would count one. A step's (`which` the lambda's place): a pass
/// of the loop `left` makes, its parameter the loop's state, its captures the caller's own values,
/// the budget spent first.
pub fn entered(
  cx: Context,
  st: Lowering,
  func: Code,
  args: List<Code>,
  lowered: List<Option<Arg>>,
  which: Option<Int>,
  at: Span,
) -> Opened / {abort.raise} =
  match which {
    Some(n) -> match args.at(n) {
      None -> { cx: cx, st: refuse(st, Calling, b"a step that is not there").st },
      Some(code) -> stepped_in(cx, st, code, lowered, at),
    },
    None -> match func.node {
      NKnown(k) -> match frame_of(cx, k.owner, k.nth) {
        None ->
          {
            cx: cx,
            st: refuse(st, Calling, b"a lambda another root lent this root was not handed").st,
          },
        Some(lender) -> {
          let framed = match lender {
            None -> cx,
            Some(bl) ->
              lending({
                ..cx,
                setting: {
                  ..cx.setting,
                  module: bl.module,
                  here: bl.here,
                  imports: bl.imports,
                  effects: bl.effects,
                },
                filed: bl.filed,
                base: bl.base,
                lender: Some({ owner: bl.owner, written: bl.written }),
                owners: cx.owners.insert(root_text(root_name(bl.owner)), bl.owner),
              }),
          };
          in_frame(framed, st, f_of(st, k.slot), k, lowered, lender, at)
        },
      },
      _ -> { cx: cx, st: refuse(st, Calling, b"a body run in place that is no known lambda").st },
    },
  }

/// The frame `owner`'s `nth` lambda runs in here: the one the code is in (`Some(None)`), the root's
/// or, inside a lent lambda, its lender's; the lambda a parameter of this specialisation was handed
/// by another root (`Some(Some(bl))`); or none where this root was not handed it.
fn frame_of(cx: Context, owner: Bytes, nth: Int) -> Option<Option<BoundLambda>> =
  if owner == root_text(root_name(match cx.lender { Some(l) -> l.owner, None -> cx.key })) {
    Some(None)
  } else {
    match cx.params.fold(None, |acc: Option<BoundLambda>, p: EmitParam|
        match acc {
          Some(_) -> acc,
          None -> match p.lambda {
            Some(bl) -> if root_text(root_name(bl.owner)) == owner && bl.nth == nth { Some(bl) }
            else { None },
            None -> None,
          },
        }) {
      Some(bl) -> Some(Some(bl)),
      None -> None,
    }
  }

fn f_of(st: Lowering, slot: Int) -> Option<Var> =
  match st.env.get(slot) { Some(AVar(v)) -> Some(v), _ -> None }

/// A known lambda's body run in place in `cx`'s frame: another root's sites taken from here on where
/// it is lent, a step counted as the call it replaces would count one but where it is a definition
/// named as a value, its captures read off its closure `f`, its parameters the arguments `lowered`.
fn in_frame(
  cx: Context,
  st: Lowering,
  f: Option<Var>,
  k: { name: Bytes, slot: Int, lambda: Lambda, owner: Bytes, nth: Int },
  lowered: List<Option<Arg>>,
  lender: Option<BoundLambda>,
  at: Span,
) -> Opened =
  match ((f, filed_fn(cx, k.lambda.at, k.lambda.params))) {
    (None, _) ->
      { cx: cx, st: refuse(st, Calling, b"a known lambda whose closure no variable holds").st },
    (_, None) -> { cx: cx, st: unfiled(cx, st, b"a lambda run in place", k.lambda.at).st },
    (Some(closure), Some(typed)) -> {
      let sited = match lender {
        Some(bl) -> emitted(st, Sited(Some({ root: bl.owner, base: bl.base }))),
        None -> st,
      };
      let counted = match lender {
        Some(bl) -> if bl.named { sited }
        else { done(sited, Op({ op: OCalling(Ticked), args: [], uses: ticks() }), at) },
        None -> done(sited, Op({ op: OCalling(Ticked), args: [], uses: ticks() }), at),
      };
      let caps = range(0, k.lambda.captures.len()).fold(
        { st: counted, env: Map::new() },
        |acc: { st: Lowering, env: Map<Int, Arg> }, i: Int|
          match k.lambda.captures.at(i) {
            None -> acc,
            Some(c) -> {
              let read = bound_as(
                acc.st,
                captured_type(cx, st, k.lambda, i),
                RWord,
                Get({ of: closure, path: PCapture(i) }),
                at,
              );
              { st: read.st, env: acc.env.insert(c.dst, read.arg) }
            },
          },
      );
      let inner = {
        ..cx,
        answer_ty: typed.ret,
        frame: k.lambda.at,
        captured: k.lambda.captures.map(|c: Capture| c.dst),
      };
      let params = range(0, lowered.len()).fold(
        { st: frame_entered(inner, caps.st, at), env: caps.env },
        |acc: { st: Lowering, env: Map<Int, Arg> }, j: Int|
          match lowered.at(j) {
            Some(Some(a)) -> {
              let p = match typed.params.at(j) {
                Some(t) -> taken_as(cx, { st: acc.st, arg: a }, t, at),
                None -> { st: acc.st, arg: a },
              };
              { st: p.st, env: acc.env.insert(j, p.arg) }
            },
            _ -> acc,
          },
      );
      { cx: inner, st: { ..params.st, env: params.env } }
    },
  }

/// The call's value once the body run in place was lowered to `body` from `entered`'s state, back
/// in the caller's slots: what a known lambda's body answers; or a step's loop, seeded and budgeted
/// by `lowered`, each pass going on with what a `Continue` holds and leaving with what a `Stop`
/// does.
pub fn left(
  cx: Context,
  before: Lowering,
  entered: Opened,
  body: Lowered,
  lowered: List<Option<Arg>>,
  which: Option<Int>,
  at: Span,
) -> Lowered =
  match which {
    None -> {
      let back = { ..body.st, env: before.env };
      // A lent lambda's run took its lender's sites from where `entered` began it.
      match entered.st.insts.at(before.insts.len()) {
        Some(Sited(Some(_))) -> { st: emitted(back, Sited(None)), arg: body.arg },
        _ -> { st: back, arg: body.arg },
      }
    },
    Some(_) -> match entered.st.env.get(0) {
      Some(AVar(s)) -> match lowered.at(0) {
        Some(Some(seed)) -> match lowered.at(1) {
          Some(Some(budget)) -> {
            let v = step_vars(cx, before, s.ty, entered.cx.answer_ty);
            let spent_one = { id: before.next + 5, ty: int_type(), rep: RInt };
            let ended = {
              state: v.state,
              left: spent_one,
              answer: v.answer,
              next: body.st.next,
              at: at,
            };
            let pass = match fused(body.st.insts, body.arg, ended) {
              Some(f) -> f,
              None -> tested(cx, body.st.insts, body.arg, ended),
            };
            let seeded = handed(
              {
                st: { ..body.st, insts: before.insts, env: before.env, next: pass.next },
                arg: seed,
              },
              v.state.rep,
              at,
            );
            {
              st: emitted(
                seeded.st,
                Loop({
                  state: [v.state, v.left],
                  init: [seeded.arg, budget],
                  body: pass.block,
                  answer: v.answer,
                }),
              ),
              arg: AVar(v.answer),
            }
          },
          _ ->
            refuse(
              { ..body.st, insts: before.insts, env: before.env },
              Calling,
              b"a step with no budget",
            ),
        },
        _ ->
          refuse(
            { ..body.st, insts: before.insts, env: before.env },
            Calling,
            b"a step with no seed",
          ),
      },
      _ ->
        refuse(
          { ..body.st, insts: before.insts, env: before.env },
          Calling,
          b"a step whose state no variable holds",
        ),
    },
  }

/// The state a step's pass, `code`, is lowered in: its own block, the budget spent first, its
/// parameter the loop's state and its captures the caller's own values.
fn stepped_in(
  cx: Context,
  st: Lowering,
  code: Code,
  lowered: List<Option<Arg>>,
  at: Span,
) -> Opened =
  match code.node {
    NLambda(l) -> match step_typed(cx, l) {
      None -> if filed(cx, l.at) == None { { cx: cx, st: unfiled(cx, st, b"a step", l.at).st } }
      else { { cx: cx, st: refuse(st, Calling, b"a step at no `Iter` type").st } },
      Some(t) -> match lowered.at(1) {
        Some(Some(budget)) -> {
          let v = step_vars(cx, st, t.state, t.answer);
          let spent_one = pass_begun(
            frame_entered({ ..cx, frame: l.at }, opened(v.st), at),
            v.left,
            budget,
            at,
          );
          match l.captures.fold(
              Some(Map::new().insert(0, AVar(v.state))),
              |acc: Option<Map<Int, Arg>>, cap: Capture|
                match acc {
                  None -> None,
                  Some(m) -> match st.env.get(cap.src) {
                    Some(a) -> Some(m.insert(cap.dst, a)),
                    None -> None,
                  },
                },
            ) {
            None -> { cx: cx, st: refuse(st, Calling, b"a step's capture nothing bound").st },
            Some(env) ->
              {
                cx: {
                  ..cx,
                  answer_ty: t.answer,
                  frame: l.at,
                  captured: l.captures.map(|cap: Capture| cap.dst),
                },
                st: { ..spent_one.st, env: env },
              },
          }
        },
        _ -> { cx: cx, st: refuse(st, Calling, b"a step with no budget").st },
      },
    },
    _ -> { cx: cx, st: refuse(st, Calling, b"a step that is no lambda").st },
  }

/// A step's pass begun in `st`: the loop's budget, `left` before this pass, checked against the
/// `budget` it was handed, which raises once it is spent; then what this pass leaves the next.
fn pass_begun(st: Lowering, left: Var, budget: Arg, at: Span) -> Lowered = {
  let c = bound_as(
    st,
    bool_type(),
    RBool,
    Prim({ op: b"le", on: RInt, args: [AVar(left), AInt(0)] }),
    at,
  );
  let k = fresh(c.st, bool_type(), RBool);
  let guarded = emitted(
    k.st,
    If({
      cond: c.arg,
      then: [
        Let({
          var: k.var,
          val: Prim({ op: b"ge", on: RInt, args: [budget, AInt(1)] }),
          at: at,
          unwind: [],
        }),
        Do({
          val: Native({ name: b"rt_iterate_bad_p", args: [AVar(k.var), budget], uses: spent() }),
          at: at,
          unwind: [],
        }),
      ],
      otherwise: [],
    }),
  );
  bound_as(
    guarded,
    int_type(),
    RInt,
    Prim({ op: b"sub", on: RInt, args: [AVar(left), AInt(1)] }),
    at,
  )
}

/// `iterate(seed, budget, step)` on a step that is a function value: the loop the call of a step
/// lambda runs in place, each pass applying the step to the state through its descriptor, the step
/// lent, and going on with what a `Continue` holds or leaving with what a `Stop` holds.
pub fn iterated(cx: Context, st: Lowering, args: List<Arg>, at: Span) -> Lowered / {abort.raise} =
  match args {
    [seed, budget, step] -> match match type_of(step) {
        TyFn(f) -> iter_of(f.params, f.ret),
        _ -> None,
      } {
      None -> refuse(st, Calling, b"a step at no `Iter` type"),
      Some(t) -> {
        let v = step_vars(cx, st, t.state, t.answer);
        let begun = pass_begun(opened(v.st), v.left, budget, at);
        let r = applied(cx, begun.st, step, [AVar(v.state)], false, at);
        let left = match begun.arg { AVar(x) -> x, _ -> v.left };
        let pass = tested(cx, r.st.insts, r.arg, {
          state: v.state,
          left: left,
          answer: v.answer,
          next: r.st.next,
          at: at,
        });
        let seeded = handed(
          { st: { ..r.st, insts: st.insts, next: pass.next }, arg: seed },
          v.state.rep,
          at,
        );
        {
          st: emitted(
            seeded.st,
            Loop({
              state: [v.state, v.left],
              init: [seeded.arg, budget],
              body: pass.block,
              answer: v.answer,
            }),
          ),
          arg: AVar(v.answer),
        }
      },
    },
    _ -> refuse(st, Calling, b"an `iterate` of other than a seed, a budget and a step"),
  }

/// A call of builtin `name` on `args`: `iterate` on a step that is a function value as `iterated`'s
/// loop, `metered` as the crossings lower it around the call of its function, and any other as the
/// containers family lowers it.
pub fn called_builtin(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Span,
  at: Span,
) -> Lowered / {abort.raise} =
  if name == b"iterate" { iterated(cx, st, args, at) } else if name == b"metered" {
    metered(cx, st, args, at, |s: Lowering, f: Arg| applied(cx, s, f, [], false, at))
  } else { builtin(cx, st, name, args, callee, at) }

/// The types a step lambda's parameter and the loop's answer hold: `a` and `b` of its `(a) -> Iter<a, b>`.
fn step_typed(cx: Context, l: Lambda) -> Option<{ state: Type, answer: Type }> =
  match filed_fn(cx, l.at, 1) { Some(f) -> iter_of(f.params, f.ret), None -> None }

/// `a` and `b` of a step's type `(a) -> Iter<a, b>`, its parameters `params` and answer `ret`.
fn iter_of(params: List<Type>, ret: Type) -> Option<{ state: Type, answer: Type }> =
  match ret {
    TyCon(c) -> if c.name != b"Iter" || c.args.len() != 2 || params.len() != 1 { None } else {
      match params.at(0) {
        Some(a) -> match c.args.at(1) { Some(b) -> Some({ state: a, answer: b }), None -> None },
        None -> None,
      }
    },
    _ -> None,
  }

/// The function type the checker filed for the lambda at `at`, of `arity` parameters: what each
/// takes and what it answers; none where it filed none of that arity.
fn filed_fn(
  cx: Context,
  at: Span,
  arity: Int,
) -> Option<{ ty: Type, params: List<Type>, ret: Type }> =
  match filed(cx, at) {
    Some(t) -> match t.ty {
      TyFn(f) -> if f.params.len() == arity { Some({ ty: t.ty, params: f.params, ret: f.ret }) }
      else { None },
      _ -> None,
    },
    None -> None,
  }

/// A step's loop variables, numbered from `st` alike in `entered` and in `left`: its state, the
/// budget left, and its answer.
fn step_vars(
  cx: Context,
  st: Lowering,
  state: Type,
  answer: Type,
) -> { st: Lowering, state: Var, left: Var, answer: Var } = {
  let s = fresh(st, state, held_as(cx.setting, state));
  let n = fresh(s.st, int_type(), RInt);
  let a = fresh(n.st, answer, held_as(cx.setting, answer));
  { st: a.st, state: s.var, left: n.var, answer: a.var }
}

/// What a step's pass ends in: its state, the budget it leaves for the next pass, the loop's
/// answer, the next variable's number, and where the call is written.
type Ended = { state: Var, left: Var, answer: Var, next: Int, at: Span }

/// A pass's block, `block`, and the next variable's number after it.
type Pass = { block: Block, next: Int }

/// A step's pass `b`, answering `v`, where `v` is made last or joined by the `if`, `case` or
/// `match` the pass ends in, and each path that falls off it answers a `Continue` or a `Stop` it
/// makes there: that path goes on to the next pass with what the `Continue` holds, or leaves with
/// what the `Stop` holds, and nothing is made; nothing where a path answers otherwise.
fn fused(b: Block, v: Arg, e: Ended) -> Option<Pass> =
  match v {
    AVar(x) -> match b.at(b.len() - 1) {
      Some(Let(l)) -> if l.var != x { None } else { ending(b.take(b.len() - 1), l.var, l.val, e) },
      _ -> if b.contains(Decl(x)) { tail_fused(b.filter(|i: Inst| i != Decl(x)), x, e) }
      else { None },
    },
    _ -> None,
  }

/// `b`, a block that ends where the pass does, with each path that ends setting join `j` to a
/// `Continue` or a `Stop` it makes going on or leaving instead: where it ends in that setting, or in
/// an `if`, `case` or `match` each of whose blocks is such a block. `b` as it is where nothing falls
/// off it; nothing where a path falls off otherwise.
fn tail_fused(b: Block, j: Var, e: Ended) -> Option<Pass> = {
  let n = b.len();
  let before = b.take(n - 1);
  match b.at(n - 1) {
    Some(Assign(a)) -> if a.var != j { None } else {
      match a.arg {
        AVar(x) -> match b.at(n - 2) {
          Some(Let(l)) -> if l.var != x { None } else { ending(b.take(n - 2), l.var, l.val, e) },
          // Set from a join of its own, as an `if` in a `match` arm sets it: that join's paths end.
          Some(i) -> if !before.contains(Decl(x)) { None }
          else { last_fused(b.take(n - 2).filter(|y: Inst| y != Decl(x)), i, x, e) },
          None -> None,
        },
        _ -> None,
      }
    },
    Some(i) -> last_fused(before, i, j, e),
    None -> None,
  }
}

/// `before` followed by `last`, as `tail_fused` makes a block of them.
fn last_fused(before: Block, last: Inst, j: Var, e: Ended) -> Option<Pass> =
  match last {
    If(x) -> match tail_fused(x.then, j, e) {
      None -> None,
      Some(t) -> match tail_fused(x.otherwise, j, { ..e, next: t.next }) {
        None -> None,
        Some(o) ->
          Some({
            block: before.push(If({ ..x, then: t.block, otherwise: o.block })),
            next: o.next,
          }),
      },
    },
    Case(c) -> {
      let arms = c.arms.fold(
        Some({ arms: [], next: e.next }),
        |got: Option<{ arms: List<{ when: Int, body: Block }>, next: Int }>, arm: { when: Int, body: Block }|
          match got {
            None -> None,
            Some(g) -> match tail_fused(arm.body, j, { ..e, next: g.next }) {
              None -> None,
              Some(r) ->
                Some({ arms: g.arms.push({ when: arm.when, body: r.block }), next: r.next }),
            },
          },
      );
      match arms {
        None -> None,
        Some(g) -> match tail_fused(c.rest, j, { ..e, next: g.next }) {
          None -> None,
          Some(r) ->
            Some({ block: before.push(Case({ ..c, arms: g.arms, rest: r.block })), next: r.next }),
        },
      }
    },
    Match(m) -> {
      let arms = m.arms.fold(
        Some({ arms: [], next: e.next }),
        |got: Option<{ arms: List<Block>, next: Int }>, arm: Block|
          match got {
            None -> None,
            Some(g) -> match tail_fused(arm, j, { ..e, next: g.next }) {
              None -> None,
              Some(r) -> Some({ arms: g.arms.push(r.block), next: r.next }),
            },
          },
      );
      match arms {
        None -> None,
        Some(g) -> match tail_fused(m.rest, j, { ..e, next: g.next }) {
          None -> None,
          Some(r) ->
            Some({ block: before.push(Match({ arms: g.arms, rest: r.block })), next: r.next }),
        },
      }
    },
    _ -> {
      let b = before.push(last);
      if falls_through(b) { None } else { Some({ block: b, next: e.next }) }
    },
  }

/// `b` ended by the step's answer made as `val`: a `Continue`'s argument the next pass's state, a
/// `Stop`'s the loop's answer.
fn ending(b: Block, made: Var, val: Val, e: Ended) -> Option<Pass> =
  match val {
    Gathered(g) -> match ((made.rep, g.parts)) {
      (RSum(s), [AInt(i), a]) -> {
        let u = unmade(b, a);
        if s.cases.at(i) == Some(b"Continue") {
          let h = held_into(u.arg, e.state, e);
          Some({ block: u.block.concat(h.block).push(Next([h.arg, AVar(e.left)])), next: h.next })
        } else if s.cases.at(i) == Some(b"Stop") {
          let h = held_into(u.arg, e.answer, e);
          Some({ block: u.block.concat(h.block).push(Done(h.arg)), next: h.next })
        } else { None }
      },
      _ -> None,
    },
    _ -> None,
  }

/// `b` and the argument `a` of the constructor no longer made: where `b` ends making `a` the word of a
/// value only so the constructor could hold it, that value, and `b` without making it.
fn unmade(b: Block, a: Arg) -> { block: Block, arg: Arg } =
  match a {
    AVar(w) -> match b.at(b.len() - 1) {
      Some(Let(l)) -> if l.var != w { { block: b, arg: a } } else {
        match l.val {
          Pack(k) -> { block: b.take(b.len() - 1), arg: k.arg },
          _ -> { block: b, arg: a },
        }
      },
      _ -> { block: b, arg: a },
    },
    _ -> { block: b, arg: a },
  }

/// `a` held as `into` is, by a `Pack` numbered `e.next` where it is held otherwise.
fn held_into(a: Arg, into: Var, e: Ended) -> { block: Block, arg: Arg, next: Int } =
  if rep_of_arg(a) == into.rep { { block: [], arg: a, next: e.next } } else {
    let v = { id: e.next, ty: into.ty, rep: into.rep };
    {
      block: [Let({ var: v, val: Pack({ arg: a, to: into.rep }), at: e.at, unwind: [] })],
      arg: AVar(v),
      next: e.next + 1,
    }
  }

/// A step's pass `b`, answering the `Iter` `v` it was handed or made, tested for which it is: a
/// `Continue`'s argument the next pass's state, a `Stop`'s the loop's answer.
fn tested(cx: Context, b: Block, v: Arg, e: Ended) -> Pass =
  match v {
    AVar(x) -> {
      let go = read_out(cx, x, b"Continue", e.state, e);
      let stop = read_out(cx, x, b"Stop", e.answer, { ..e, next: go.next });
      {
        block: b.push(
          Case({
            on: x,
            test: TTag([b"Continue", b"Stop"]),
            arms: [
              { when: 0, body: go.block.push(Next([go.arg, AVar(e.left)])) },
              { when: 1, body: stop.block.push(Done(stop.arg)) },
            ],
            rest: [Fail({ why: NoArm, at: e.at })],
          }),
        ),
        next: stop.next,
      }
    },
    _ -> { block: b.push(Fail({ why: NoArm, at: e.at })), next: e.next },
  }

/// The argument of constructor `ctor` the `Iter` `x` holds, read as `into` holds it: out of the
/// case's payload where the sum's layout lays it, and as a word where a type variable leaves it open.
fn read_out(
  cx: Context,
  x: Var,
  ctor: Bytes,
  into: Var,
  e: Ended,
) -> { block: Block, arg: Arg, next: Int } =
  if into.rep == RUnit { { block: [], arg: AZero(RUnit), next: e.next } } else {
    let i = match case_index(x.rep, ctor) { Some(k) -> k, None -> 0 };
    let read = match x.rep {
      RSum(s) ->
        {
          path: PCase({ case: i, at: match arg_word(s.laid, i, 0) { Some(w) -> w, None -> 0 } }),
          rep: into.rep,
        },
      _ -> { path: PCase({ case: if ctor == b"Stop" { 1 } else { 0 }, at: 0 }), rep: RWord },
    };
    let r = { id: e.next, ty: into.ty, rep: read.rep };
    let h = held_into(AVar(r), into, { ..e, next: e.next + 1 });
    {
      block: [Let({ var: r, val: Get({ of: x, path: read.path }), at: e.at, unwind: [] })].concat(
        h.block,
      ),
      arg: h.arg,
      next: h.next,
    }
  }

/// What the runtime's report of a spent or bad budget does: reads its operands and fails.
fn spent() -> { takes: List<Bool>, owned: Bool, fails: Bool, stops: Bool } =
  { takes: [false, false], owned: false, fails: true, stops: false }

/// The state the body of a lambda laid out as `frame` is lowered in, inside `st`: its captures, each
/// the word the closure holds, opened where the body reads it as its type, and its own parameters,
/// as the closure's function takes them. Its place among the root's closures is taken now, so a
/// lambda it writes comes after it.
pub fn lambda_opened(cx: Context, st: Lowering, frame: Frame, at: Span) -> Opened =
  match shaped(cx, st.env, frame, at) {
    None -> {
      let reserved = with_lambda(
        st,
        Closure({ body: placeholder(cx), captures: frame.captures.len(), at: at }),
      ).st;
      { cx: cx, st: unfiled(cx, reserved, b"a closure", at).st }
    },
    Some(s) -> {
      let reserved = with_lambda(
        st,
        Closure({ body: placeholder(cx), captures: s.captures, at: at }),
      ).st;
      let caps = range(0, frame.captures.len()).fold(
        nested(reserved, s.params, Map::new()),
        |acc: Lowering, i: Int|
          match frame.captures.at(i) {
            None -> acc,
            Some(c) -> match s.params.at(i) {
              None -> acc,
              Some(q) -> { ..acc, env: acc.env.insert(c.dst, AVar(q)) },
            },
          },
      );
      {
        cx: {
          ..cx,
          tails: Calls,
          params: [],
          types: [],
          answer: s.conv.answer,
          answer_ty: s.ret,
          param_at: Map::new(),
          frame: at,
          captured: frame.captures.map(|c: Capture| c.dst),
        },
        st: {
          ..caps,
          env: range(0, s.own).fold(caps.env, |m: Map<Int, Arg>, j: Int|
            match s.params.at(s.captures + j) { Some(p) -> m.insert(j, AVar(p)), None -> m }),
        },
      }
    },
  }

/// `st` noting, where `cx` observes, each slot the lambda written at `at` captures, where it does.
fn captured(cx: Context, st: Lowering, captures: List<Capture>, at: Span) -> Lowering =
  captures.fold(st, |s: Lowering, c: Capture| read_noted(cx, s, capture_note(), c.src, at))

/// `st` noting, where `cx` observes, the slots a step at argument `which` of `args` reads of the
/// caller's, as a closure's captures, before its loop.
pub fn step_captured(cx: Context, st: Lowering, args: List<Code>, which: Option<Int>) -> Lowering =
  match which {
    None -> st,
    Some(n) -> match args.at(n) {
      Some(code) -> match code.node { NLambda(l) -> captured(cx, st, l.captures, l.at), _ -> st },
      None -> st,
    },
  }

/// The closure of the body lowered to `inner` from `lambda_opened`'s state, made after `outer` of
/// the values it captures, each as its word.
pub fn closure(
  cx: Context,
  outer: Lowering,
  inner: Lowered,
  frame: Frame,
  at: Span,
) -> Lowered / {abort.raise} =
  match shaped(cx, outer.env, frame, at) {
    None -> unfiled(cx, outer, b"a closure", at),
    Some(s) -> {
      let nth = outer.lambdas.len();
      let answered = if falls_through(inner.st.insts) { handed(inner, s.conv.answer, at) }
      else { inner };
      let insts = if falls_through(answered.st.insts) {
        answered.st.insts.push(Return(answered.arg))
      } else { answered.st.insts };
      let body = {
        key: cx.key,
        kind: Rooted,
        params: s.params,
        conv: s.conv,
        answer_ty: if frame.resumes { word_type() } else { s.ret },
        // Written inside a lent lambda, its sites are the lender's, as the run it was written in.
        body: match cx.lender {
          Some(l) -> [Sited(Some({ root: l.owner, base: cx.base }))].concat(insts),
          None -> insts,
        },
        lambdas: [],
        base: cx.base,
        members: [],
        links: no_links(),
        statics: [],
      };
      let after = unnested(outer, answered.st);
      // `lambda_opened` reserved place `nth` for this closure.
      let placed = {
        ..after,
        lambdas: after.lambdas.set(nth, Closure({ body: body, captures: s.captures, at: at })),
      };
      let caps = frame.captures.fold(
        { st: captured(cx, placed, frame.captures, at), args: [] },
        |acc: { st: Lowering, args: List<Arg> }, c: Capture|
          match acc.st.env.get(c.src) {
            Some(a) -> {
              let h = handed({ st: acc.st, arg: a }, RWord, at);
              { st: h.st, args: acc.args.push(h.arg) }
            },
            None ->
              {
                st: refuse(acc.st, Calling, b"a capture nothing bound").st,
                args: acc.args.push(AZero(RWord)),
              },
          },
      );
      bound_as(
        function_laid(captures_released(caps.st, s.params.take(s.captures)), s.ty),
        s.ty,
        RWord,
        Make({
          made: MClosure({ nth: nth, captures: s.captures, params: s.own, stacked: false }),
          args: caps.args,
          reuse: None,
        }),
        at,
      )
    },
  }

/// The state each member of a tail group is lowered in.
pub fn group_opened(members: List<GroupMember>) -> List<Opened> / {abort.raise} = {
  let keys = members.map(|m: GroupMember| m.cx.key);
  let params = member_params(members);
  let after = params.fold(1, |n: Int, ps: List<Var>| n + ps.len());
  range(0, members.len()).fold([], |acc: List<Opened>, i: Int|
    match members.at(i) {
      None -> acc,
      Some(m) -> {
        let own = match params.at(i) { Some(ps) -> ps, None -> [] };
        acc.push({
          cx: {
            ..m.cx,
            tails: Enters(keys),
            param_at: range(0, own.len()).fold(Map::new(), |pa: Map<Int, Int>, j: Int|
              match own.at(j) { Some(v) -> pa.insert(v.id, j), None -> pa }),
          },
          st: {
            ..started([]),
            next: after,
            env: range(0, own.len()).fold(Map::new(), |e: Map<Int, Arg>, j: Int|
              match own.at(j) { Some(v) -> e.insert(j, AVar(v)), None -> e }),
          },
        })
      },
    })
}

/// The group's root from each member's body lowered from `group_opened`'s state: a case on which
/// member runs, each arm a member's body answering as the member does.
pub fn grouped(
  members: List<GroupMember>,
  bodies: List<Lowered>,
) -> Result<Fn, Declined> / {abort.raise} =
  match bodies.fold(None, |acc: Option<Declined>, b: Lowered|
      match acc { Some(_) -> acc, None -> b.st.refused }) {
    Some(no) -> Err(no),
    None -> match members.at(0) {
      None -> Err({ by: Calling, why: b"a tail group of no member" }),
      Some(first) -> {
        let params = member_params(members);
        let which = { id: 0, ty: int_type(), rep: RInt };
        let last = match bodies.at(bodies.len() - 1) { Some(b) -> b.st, None -> started([]) };
        let arms = range(0, bodies.len()).fold(
          { next: last.next, arms: [] },
          |acc: { next: Int, arms: List<{ when: Int, body: Block }> }, i: Int|
            match bodies.at(i) {
              None -> acc,
              Some(b) -> match members.at(i) {
                None -> acc,
                Some(m) -> if !falls_through(b.st.insts) {
                  { ..acc, arms: acc.arms.push({ when: i, body: b.st.insts }) }
                } else {
                  let h = handed(
                    { st: { ..b.st, next: acc.next }, arg: b.arg },
                    convention(m.cx).answer,
                    m.body.span,
                  );
                  {
                    next: h.st.next,
                    arms: acc.arms.push({ when: i, body: h.st.insts.push(Return(h.arg)) }),
                  }
                },
              },
            },
        );
        Ok({
          key: first.cx.key,
          kind: Rooted,
          params: [which],
          conv: { params: [Given], reps: [RInt], answer: RWord, answered: tir::Owned },
          answer_ty: first.cx.answer_ty,
          body: [
            Case({
              on: which,
              test: TInt(range(0, members.len())),
              arms: arms.arms,
              rest: [Return(AZero(RWord))],
            }),
          ],
          // A closure a later member writes fails at that member's sites, the group's being the first's.
          lambdas: members.drop(1).fold(last.lambdas, |ls: List<tir::Lambda>, m: GroupMember|
            ls.map(|l: tir::Lambda|
              match l {
                Closure(c) -> if c.body.key != m.cx.key { l } else {
                  Closure({
                    ..c,
                    body: {
                      ..c.body,
                      body: [Sited(Some({ root: m.cx.key, base: m.cx.base }))].concat(c.body.body),
                    },
                  })
                },
              })),
          base: first.cx.base,
          members: range(0, members.len()).fold([], |acc: List<Member>, i: Int|
            match members.at(i) {
              Some(m) ->
                acc.push({
                  key: m.cx.key,
                  base: m.cx.base,
                  params: match params.at(i) { Some(ps) -> ps, None -> [] },
                  conv: convention(m.cx),
                }),
              None -> acc,
            }),
          links: last.links,
          statics: [],
        })
      },
    },
  }

/// Each member's parameters, numbered apart from the group's `which` and from one another, and held
/// as the member takes them.
fn member_params(members: List<GroupMember>) -> List<List<Var>> / {abort.raise} =
  members.fold(
    { next: 1, out: [] },
    |acc: { next: Int, out: List<List<Var>> }, m: GroupMember| {
      let reps = convention(m.cx).reps;
      {
        next: acc.next + reps.len(),
        out: acc.out.push(
          range(0, reps.len()).map(|j: Int|
            {
              id: acc.next + j,
              ty: match m.cx.types.at(j) { Some(t) -> t, None -> unknown_type() },
              rep: match reps.at(j) { Some(r) -> r, None -> RWord },
            }),
        ),
      }
    },
  ).out

/// A root's body as it is lowered: each read of a slot `let` binds to a lambda, and each of its
/// parameters a specialisation was handed a lambda for, written as the lambda it is known to be, so
/// a call of it runs the lambda in place. A lambda holding a `handle` stays a closure.
pub fn known_body(full: Bytes, params: List<EmitParam>, body: Code) -> Code =
  known_values(
    body,
    range(0, params.len()).fold([], |acc: List<KnownSlot>, i: Int|
      match match params.at(i) { Some(p) -> p.lambda, None -> None } {
        Some(bl) -> if has_handle(bl.code.body) { acc } else {
          acc.push({ slot: i, owner: root_text(root_name(bl.owner)), nth: bl.nth, code: bl.code })
        },
        None -> acc,
      }),
    full,
    lambdas_of(body),
  )

/// A definition the root names: its full name and how the emitter reads it.
pub type Defined = { full: Bytes, def: Def }

/// A call's callee as the root names it, the type arguments it names it at (none for a definition as
/// it stands), and `given`, those the check filed at the reference, in this body's variables.
type Reference = { st: Lowering, callee: Callee, args: List<Type>, given: List<Type> }

/// A closure's body as the lambda's type lays it out: its captures, each a word it reads out of the
/// closure, lent, then its own parameters as a body holds values of their types, given; how it
/// answers; and the types of the closure and of its answer.
type Shape = { params: List<Var>, conv: Convention, ty: Type, ret: Type, captures: Int, own: Int }

/// The shape of the closure laid out as `frame` at `at`, from the function type the checker filed
/// there; none where it filed none of the frame's arity.
fn shaped(cx: Context, env: Map<Int, Arg>, frame: Frame, at: Span) -> Option<Shape> =
  match filed_fn(cx, at, frame.params) {
    None -> None,
    Some(f) -> {
      // A continuation is a word the runtime calls, and a clause binding one answers the word it
      // hands back, which for a tail-only clause is the resumed value `c.resumed` holds the count of.
      let continued = |j: Int| frame.resumes && j == frame.params - 1;
      let answer = if frame.resumes { RWord } else { held_as(cx.setting, f.ret) };
      let n = frame.captures.len();
      let caps = range(0, n).map(|i: Int|
        {
          id: i,
          ty: match frame.captures.at(i) {
            Some(c) -> match env.get(c.src) { Some(a) -> type_of(a), None -> unknown_type() },
            None -> unknown_type(),
          },
          rep: RWord,
        });
      let own = f.params.fold([], |acc: List<Var>, t: Type| {
        let j = acc.len();
        acc.push(if continued(j) {
          {
            id: n + j,
            ty: resumption(match t { TyFn(k) -> k.ret, _ -> unknown_type() }),
            rep: RWord,
          }
        } else { { id: n + j, ty: t, rep: held_as(cx.setting, t) } })
      });
      let params = caps.concat(own);
      Some({
        params: params,
        conv: {
          // The body reads its captures out of the closure, which its caller holds while it runs.
          params: range(0, params.len()).map(|i: Int| if i < n { Lent } else { Given }),
          reps: params.map(|v: Var| v.rep),
          answer: answer,
          answered: tir::Owned,
        },
        ty: f.ty,
        ret: f.ret,
        captures: n,
        own: frame.params,
      })
    },
  }

/// What a closure's place among the root's closures holds until its body is lowered.
fn placeholder(cx: Context) -> Fn =
  {
    key: cx.key,
    kind: Rooted,
    params: [],
    conv: { params: [], reps: [], answer: RWord, answered: tir::Owned },
    answer_ty: word_type(),
    body: [],
    lambdas: [],
    base: cx.base,
    members: [],
    links: no_links(),
    statics: [],
  }

/// The type capture `i` of the closure written at `at` holds, as its body took it.
fn capture_type(st: Lowering, at: Span, i: Int) -> Type =
  range(0, st.lambdas.len()).fold(unknown_type(), |acc: Type, k: Int|
    match st.lambdas.at(k) {
      Some(Closure(c)) -> if c.at.site == at.site && i < c.captures {
        match c.body.params.at(i) { Some(v) -> v.ty, None -> acc }
      } else { acc },
      None -> acc,
    })

/// The type capture `i` of `l` holds: as this root's closure of `l` took it, or for a lambda another
/// root made the closure of, as the checker filed a read of the capture in `l`'s body.
fn captured_type(cx: Context, st: Lowering, l: Lambda, i: Int) -> Type = {
  let own = capture_type(st, l.at, i);
  if own != unknown_type() { own } else {
    match match l.captures.at(i) { Some(c) -> slot_read_at(l.body, c.dst), None -> None } {
      Some(at) -> match filed(cx, at) { Some(t) -> t.ty, None -> unknown_type() },
      None -> unknown_type(),
    }
  }
}

/// Where `c` reads slot `slot` of its frame, or reads it in a barrier inside that copies it in.
fn slot_read_at(c: Code, slot: Int) -> Option<Span> = {
  let first = |codes: List<Code>|
    codes.fold(None, |acc: Option<Span>, x: Code|
      match acc { Some(_) -> acc, None -> slot_read_at(x, slot) });
  // The slot a barrier copies `slot` into, where it copies it.
  let into = |captures: List<Capture>|
    captures.fold(None, |acc: Option<Int>, k: Capture|
      match acc { Some(_) -> acc, None -> if k.src == slot { Some(k.dst) } else { None } });
  match c.node {
    NVar(v) -> if v.slot == Some(slot) { Some(c.span) } else { None },
    NKnown(k) -> if k.slot == slot { Some(c.span) } else { None },
    NUnary(u) -> slot_read_at(u.operand, slot),
    NBinary(b) -> first([b.lhs, b.rhs]),
    NApp(a) -> first(a.args.push(a.func)),
    NIf(i) -> first([i.cond, i.then_branch, i.else_branch]),
    NBlock(b) ->
      first(
        b.stmts.fold(
          match b.tail { Some(t) -> [t], None -> [] },
          |acc: List<Code>, stmt: CodeStmt|
            acc.push(match stmt { CLet(l) -> l.value, CLetPat(l) -> l.value, CDo(d) -> d.code }),
        ),
      ),
    NList(l) -> first(l.items),
    NRecord(r) -> first(r.fields.map(|f: CodeField| f.value)),
    NUpdate(u) -> first(u.sets.map(|f: CodeField| f.value).push(u.base)),
    NMatch(m) ->
      first(
        m.arms.fold([m.scrutinee], |acc: List<Code>, a: CodeArm|
          List::push(match a.guard { Some(g) -> acc.push(g), None -> acc }, a.body)),
      ),
    NPerform(p) -> first(match p.label { Some(l) -> p.args.push(l), None -> p.args }),
    NField(f) -> slot_read_at(f.base, slot),
    NParallel(p) -> first(p.branches),
    NLambda(l) -> match into(l.captures) { Some(d) -> slot_read_at(l.body, d), None -> None },
    NSimulate(s) -> match into(s.captures) { Some(d) -> slot_read_at(s.body, d), None -> None },
    NHandle(h) -> match slot_read_at(h.body, slot) {
      Some(x) -> Some(x),
      None ->
        h.clauses.fold(
          match h.ret {
            Some(r) -> match into(r.captures) { Some(d) -> slot_read_at(r.body, d), None -> None },
            None -> None,
          },
          |acc: Option<Span>, cl: CodeClause|
            match acc {
              Some(_) -> acc,
              None -> match into(cl.captures) { Some(d) -> slot_read_at(cl.body, d), None -> None },
            },
        ),
    },
    _ -> None,
  }
}

/// Whether definition `d` is generic over a type, so its callers settle its body at their own type
/// arguments: a call of it is a call of that specialisation even where it takes nothing.
fn generic(d: Def) -> Bool = match d.scheme { Some(sc) -> sc.ty_vars.len() > 0, None -> false }

/// What a pure definition of no parameters answers, read from what the unit keeps of its one run, of
/// the type it answers.
fn constant_read(cx: Context, st: Lowering, d: Defined, ref: Span, at: Span) -> Lowered =
  match match reference_args(cx, d.def.scheme, ref) {
      Some(given) -> answer_type(d.def, given),
      None -> None,
    } {
    None -> unfiled(cx, st, b"a constant's type arguments: ".concat(d.full), ref),
    Some(ret) ->
      handed(
        bound_as(
          st,
          ret,
          RWord,
          Op({
            op: OCalling(ConstantRead({ callee: Root(d.def.root), kept: ret })),
            args: [],
            uses: answers(),
          }),
          at,
        ),
        held_as(cx.setting, ret),
        at,
      ),
  }

/// A call in tail position as a jump: a restart where it calls the root's own definition at the
/// root's own type arguments, filling every parameter, a group member's included; an entry into
/// the member of the root's tail group the call reaches, its definition at the type arguments the
/// reference names, handed as that member takes its parameters; nothing where the root cannot jump
/// there.
fn jumped(
  cx: Context,
  st: Lowering,
  d: Defined,
  ref: Span,
  codes: List<Code>,
  args: List<Arg>,
  at: Span,
) -> Option<Lowered> / {abort.raise} =
  if cx.tails == Calls { None }
  else if unspecialised(cx.key) == d.def.root && args.len() == cx.params.len()
      && (match reference_args(cx, d.def.scheme, ref) {
        Some(given) -> owns(cx, given, fn_args(cx, codes)),
        None -> false,
      }) {
    let h = handed_all(st, args, params_held(cx), at);
    Some({ st: emitted(h.st, Restart(h.args)), arg: AZero(held_as(cx.setting, cx.answer_ty)) })
  } else {
    match cx.tails {
      Enters(keys) -> match match reference_args(cx, d.def.scheme, ref) {
          Some(given) -> {
            let reached = instance_key(
              d.full,
              given.map(|t: Type| if has_vars(t) { unknown_type() } else { t }),
            );
            range(0, keys.len()).fold(None, |acc: Option<Int>, i: Int|
              match acc {
                Some(_) -> acc,
                None -> if keys.at(i) == Some(reached) { Some(i) } else { None },
              })
          },
          None -> None,
        } {
        Some(i) -> match crossing_at(cx.setting, d.def, match keys.at(i) {
            Some(k) -> key_types(k),
            None -> [],
          }) {
          None -> Some(refuse(st, Calling, b"a tail group's member no scheme speaks for")),
          Some(c) -> {
            let h = handed_all(st, args, conventional(cx.setting, c).reps, at);
            Some({
              st: emitted(h.st, Enter({ member: i, args: h.args })),
              arg: AZero(held_as(cx.setting, cx.answer_ty)),
            })
          },
        },
        None -> None,
      },
      _ -> None,
    }
  }

/// A call of `d` through the convention it has at the call's type arguments, its answer of the type
/// `d` answers at the type arguments the reference names it at, in this body's own variables
/// whatever convention the root it reaches answers by, held as that type is in a body.
fn call(
  cx: Context,
  st: Lowering,
  d: Defined,
  ref: Span,
  codes: List<Code>,
  args: List<Arg>,
  at: Span,
) -> Lowered / {abort.raise} = {
  let n = named_ref(cx, st, d, ref, fn_args(cx, codes));
  match ((crossing_at(cx.setting, d.def, n.args), answer_type(d.def, n.given))) {
    (None, _) ->
      refuse(st, Calling, b"a call of a definition no scheme speaks for: ".concat(d.full)),
    (_, None) ->
      unfiled(cx, st, b"a call's type arguments of a generic definition: ".concat(d.full), ref),
    (Some(c), Some(ret)) -> {
      let conv = conventional(cx.setting, c);
      let h = handed_all(
        passed(cx, stacked(n.st, d.def.lent, codes, args), d.full, codes, args),
        args,
        conv.reps,
        at,
      );
      handed(
        bound_as(
          h.st,
          ret,
          conv.answer,
          Call({
            callee: n.callee,
            args: h.args,
            conv: conv,
            stops: match d.def.scheme {
              Some(sc) -> match sc.ty { TyFn(f) -> stops_in(f.effects), _ -> true },
              None -> true,
            },
          }),
          at,
        ),
        held_as(cx.setting, ret),
        at,
      )
    },
  }
}

/// The type `d` answers at the type arguments `given` a reference names it at, in the referring
/// body's variables; none where `d` is generic and `given` does not fill each of its variables.
fn answer_type(d: Def, given: List<Type>) -> Option<Type> =
  match d.scheme {
    Some(sc) -> match sc.ty {
      TyFn(f) -> if sc.ty_vars.len() == 0 { Some(f.ret) }
      else if given.len() == sc.ty_vars.len() { Some(substituted_fully(f.ret, given)) }
      else { None },
      other -> if sc.ty_vars.len() == 0 { Some(other) } else { None },
    },
    None -> None,
  }

/// Whether a call of a function of effect row `row` can stop for a handler that may resume it later:
/// where the row is open or names an operation a run must be given.
fn stops_in(row: Row) -> Bool = row.tail != None || run_needs(row.atoms).len() > 0

/// Each of `args` held as `reps` says, in order.
fn handed_all(
  st: Lowering,
  args: List<Arg>,
  reps: List<Rep>,
  at: Span,
) -> { st: Lowering, args: List<Arg> } =
  range(0, args.len()).fold(
    { st: st, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, i: Int|
      match args.at(i) {
        Some(a) -> {
          let h = handed(
            { st: acc.st, arg: a },
            match reps.at(i) { Some(r) -> r, None -> RWord },
            at,
          );
          { st: h.st, args: acc.args.push(h.arg) }
        },
        None -> acc,
      },
  )

/// How a reference at `at` names definition `d`: the root being lowered, where it calls its own
/// definition at its own type arguments handing the lambdas it runs; else, where the reference
/// names it at no type arguments and hands no lambdas, the definition as it stands; else the body's
/// next generic call, which the unit settles. A specialisation's reference of its own definition at
/// other type arguments is such a call: the definition as it stands may be one its callers settle,
/// emitted only at their types.
fn named_ref(
  cx: Context,
  st: Lowering,
  d: Defined,
  at: Span,
  fns: List<FnArg>,
) -> Reference / {abort.raise} =
  match reference_args(cx, d.def.scheme, at) {
    None ->
      {
        st: unfiled(cx, st, b"a generic definition's reference", at).st,
        callee: Root(d.def.root),
        args: [],
        given: [],
      },
    Some(given) -> if unspecialised(cx.key) == d.def.root && owns(cx, given, fns) {
      { st: st, callee: Root(cx.key), args: key_types(cx.key), given: given }
    } else { referred(cx.setting, st, d, given, fns) },
  }

/// Definition `d` named at type arguments `given`, handing `fns`: as it stands where it is named at
/// none and handed none, else the body's next generic call.
fn referred(
  s: Setting,
  st: Lowering,
  d: Defined,
  given: List<Type>,
  fns: List<FnArg>,
) -> Reference =
  if given.len() == 0 && fns.len() == 0 {
    { st: st, callee: Root(d.def.root), args: [], given: given }
  } else {
    {
      st: {
        ..st,
        links: {
          ..st.links,
          generics: st.links.generics.push({
            callee: d.full,
            args: given,
            carried: match d.def.scheme {
              Some(sc) -> carried_at(s, sc, given, d.def.arity),
              None -> [],
            },
            fns: fns,
          }),
        },
      },
      callee: Generic(st.links.generics.len()),
      args: given,
      given: given,
    }
  }

/// The root a call of definition `full` at type arguments `args` reaches in a tail loop: the
/// definition as it stands where each is open, as a body at its own variables names it, else the
/// definition at them.
pub fn instance_key(full: Bytes, args: List<Type>) -> RootKey =
  if args.all(|t: Type| t == unknown_type()) { Named(full) } else { at_key(full, args, []) }

/// Whether a reference of the root's own definition at type arguments `given`, handing `fns`, names
/// the root itself: always for a definition as it stands; for a specialisation, where it hands the
/// same lambdas and each type argument is the root's, or is laid out as the root's layout says.
fn owns(cx: Context, given: List<Type>, fns: List<FnArg>) -> Bool / {abort.raise} =
  match cx.key {
    At(a) ->
      same_fns(a.lent, fns) && given.len() == a.args.len()
        && range(0, given.len()).all(|j: Int|
          match ((a.args.at(j), given.at(j))) {
            (Some(KeyType(m)), Some(g)) -> m == unknown_type() || g == m,
            (Some(KeyLayout(l)), Some(g)) ->
              g == l.at || (!has_vars(g) && layout_key(cx.setting.ctors, g) == l.key),
            _ -> false,
          }),
    _ -> true,
  }

/// `st` with each lambda `codes` writes at a parameter the callee lends, and which captures
/// something, laid out on this frame's stack.
fn stacked(st: Lowering, lent: List<Int>, codes: List<Code>, args: List<Arg>) -> Lowering =
  lent.fold(st, |acc: Lowering, i: Int|
    match codes.at(i) {
      Some(c) -> match c.node {
        NLambda(l) -> if l.captures.len() == 0 { acc } else {
          match args.at(i) {
            Some(AVar(v)) -> { ..acc, insts: laid_on_stack(acc.insts, v, acc.insts.len() - 1) },
            _ -> acc,
          }
        },
        _ -> acc,
      },
      None -> acc,
    })

/// `b` with the closure `v` binds at place `i` or before laid out on this frame's stack. It was just
/// made, so it is sought from the block's end.
fn laid_on_stack(b: Block, v: Var, i: Int) -> Block =
  if i < 0 { b } else {
    match b.at(i) {
      Some(Let(x)) -> if x.var != v { laid_on_stack(b, v, i - 1) } else {
        match x.val {
          Make(m) -> match m.made {
            MClosure(k) ->
              b.set(i, Let({ ..x, val: Make({ ..m, made: MClosure({ ..k, stacked: true }) }) })),
            _ -> b,
          },
          _ -> b,
        }
      },
      _ -> laid_on_stack(b, v, i - 1),
    }
  }

/// `st` noting each parameter of the root that may hold a function and that the call of `callee`
/// hands on as itself, by the argument it is.
fn passed(
  cx: Context,
  st: Lowering,
  callee: Bytes,
  codes: List<Code>,
  args: List<Arg>,
) -> Lowering =
  if cx.tails == Calls { st } else {
    range(0, codes.len()).fold(st, |acc: Lowering, i: Int|
      match codes.at(i) {
        Some(c) -> match c.node {
          NVar(v) -> if v.slot == None { acc } else {
            match args.at(i) {
              Some(AVar(p)) -> match cx.param_at.get(p.id) {
                Some(j) -> if may_be_called(cx, j) {
                  {
                    ..acc,
                    links: {
                      ..acc.links,
                      passes: acc.links.passes.push({ param: j, callee: callee, at: i }),
                    },
                  }
                } else { acc },
                None -> acc,
              },
              _ -> acc,
            }
          },
          _ -> acc,
        },
        None -> acc,
      })
  }

/// `st` noting that the body calls parameter `f` is, where it is one of the root's.
fn param_called(cx: Context, st: Lowering, f: Arg) -> Lowering =
  match f {
    AVar(p) -> match cx.param_at.get(p.id) {
      Some(j) -> if cx.tails == Calls || st.links.called.contains(j) { st }
      else { { ..st, links: { ..st.links, called: st.links.called.push(j) } } },
      None -> st,
    },
    _ -> st,
  }

/// Whether parameter `j` of the root may hold a function: its type is one, a variable, or unknown.
fn may_be_called(cx: Context, j: Int) -> Bool =
  match cx.types.at(j) {
    Some(t) -> match t { TyFn(_) -> true, TyVar(_) -> true, _ -> false },
    None -> true,
  }

/// The lambdas among a call's `codes`, each by its argument's place, which a callee's
/// specialisation reads and runs: a literal one where the root lends its lambdas, one known to a
/// slot, another root's wherever it is handed on, and a definition named as a value as the lambda
/// around a call of it.
fn fn_args(cx: Context, codes: List<Code>) -> List<FnArg> / {abort.raise} = {
  let owner = root_text(root_name(cx.key));
  let lends = cx.lends;
  // Code of a lambda another root lent is that root's, which lends each lambda within it.
  let by = match cx.lender {
    Some(b) -> Some(b),
    None -> if lends { Some({ owner: cx.key, written: cx.written }) } else { None },
  };
  let handed_as = |j: Int, l: Lambda, acc: List<FnArg>|
    match if has_handle(l.body) { None } else { by } {
      None -> acc,
      Some(b) -> match position_in(b.written, l) {
        Some(nth) -> acc.push({ param: j, owner: b.owner, nth: nth }),
        None -> acc,
      },
    };
  range(0, codes.len()).fold([], |acc: List<FnArg>, j: Int|
    match codes.at(j) {
      Some(c) -> match c.node {
        NLambda(l) -> handed_as(j, l, acc),
        NKnown(k) -> if k.owner != owner || lends {
          acc.push({ param: j, owner: owner_named(cx, k.owner), nth: k.nth })
        } else { acc },
        NVar(_) -> match named_arity(cx.setting.module, cx.setting.here, cx.setting.imports, c) {
          Some(n) -> handed_as(j, named_lambda(c, n), acc),
          None -> acc,
        },
        _ -> acc,
      },
      None -> acc,
    })
}

/// The key of the root named `name` whose lambda a slot of this body is known to hold.
fn owner_named(cx: Context, name: Bytes) -> RootKey / {abort.raise} =
  match cx.owners.get(name) {
    Some(k) -> k,
    None ->
      panic(
        String::of_bytes_lossy(
          b"a lambda known from a root this body holds no lambda of: ".concat(name),
        ),
      ),
  }

/// Whether a lambda of the root can be read again where another root runs it: the root is a test,
/// a definition of no type variable as it stands, or one at type arguments that are all known and
/// that runs no lambda of another root itself.
fn lends_lambdas(cx: Context) -> Bool / {abort.raise} =
  match cx.key {
    Test(_) -> true,
    At(a) ->
      a.lent.len() == 0 && key_types(cx.key).all(|t: Type| t != unknown_type() && !has_vars(t)),
    Named(n) -> match cx.setting.here.fold(None, |acc: Option<Def>, d: Def|
        if qualify(cx.setting.module, d.name) == n { Some(d) } else { acc }) {
      Some(d) -> match d.scheme { Some(sc) -> sc.ty_vars.len() == 0, None -> true },
      None -> false,
    },
    _ -> false,
  }

/// What the root lends: the lambdas its body writes, then each definition it hands a definition as a
/// value, as the lambda around a call of it.
fn written_in(cx: Context) -> List<Lambda> / {abort.raise} =
  lambdas_of(cx.body).concat(
    named_in(cx.setting.module, cx.setting.here, cx.setting.imports, cx.body),
  )

/// How many arguments the definition `c` names as a value takes, its name read in `module`, which
/// defines `here` and imports `imports`; none where `c` is not a definition named as a value, or
/// takes a witness or a label a call would fill.
fn named_arity(
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  c: Code,
) -> Option<Int> / {abort.raise} =
  match c.node {
    NVar(v) -> if v.slot != None { None } else {
      match def_in(module, here, imports, v.name) {
        Some(d) -> match d.def.scheme {
          Some(sc) -> match sc.ty {
            TyFn(f) -> if d.def.witnesses == 0 && f.params.len() == d.def.arity {
              Some(d.def.arity)
            } else { None },
            _ -> None,
          },
          None -> None,
        },
        None -> None,
      }
    },
    _ -> None,
  }

/// The lambda around a call of the definition `c` names, which takes `n` arguments.
fn named_lambda(c: Code, n: Int) -> Lambda = {
  let at = |node: Node| { node: node, span: c.span };
  {
    params: n,
    size: n,
    captures: [],
    at: c.span,
    body: at(
      NApp({
        func: c,
        args: range(0, n).map(|i: Int|
          at(NVar({ name: b"p".concat(ascii_of_int(i)), slot: Some(i) }))),
      }),
    ),
  }
}

/// Each definition `c` hands a definition as a value, as `named_lambda` reads it, in one fixed order,
/// names read in `module`, which defines `here` and imports `imports`.
pub fn named_in(
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  c: Code,
) -> List<Lambda> / {abort.raise} = {
  let go = |x: Code| named_in(module, here, imports, x);
  let within = |codes: List<Code>| codes.fold([], |acc: List<Lambda>, x: Code| acc.concat(go(x)));
  match c.node {
    NApp(a) -> {
      let callee = match a.func.node {
        NVar(v) -> v.slot == None && def_in(module, here, imports, v.name) != None,
        _ -> false,
      };
      let handed = if !callee { [] } else {
        a.args.fold([], |acc: List<Lambda>, x: Code|
          match named_arity(module, here, imports, x) {
            Some(n) -> acc.push(named_lambda(x, n)),
            None -> acc,
          })
      };
      handed.concat(within(a.args.push(a.func)))
    },
    NLambda(l) -> go(l.body),
    NUnary(u) -> go(u.operand),
    NBinary(b) -> within([b.lhs, b.rhs]),
    NField(f) -> go(f.base),
    NIf(i) -> within([i.cond, i.then_branch, i.else_branch]),
    NBlock(b) ->
      within(
        b.stmts.fold(
          match b.tail { Some(t) -> [t], None -> [] },
          |acc: List<Code>, stmt: CodeStmt|
            acc.push(match stmt { CLet(l) -> l.value, CLetPat(l) -> l.value, CDo(d) -> d.code }),
        ),
      ),
    NList(l) -> within(l.items),
    NRecord(r) -> within(r.fields.map(|f: CodeField| f.value)),
    NUpdate(u) -> within(u.sets.map(|f: CodeField| f.value).push(u.base)),
    NMatch(m) ->
      within(
        m.arms.fold([m.scrutinee], |acc: List<Code>, a: CodeArm|
          List::push(match a.guard { Some(g) -> acc.push(g), None -> acc }, a.body)),
      ),
    NPerform(x) -> within(x.args),
    NSimulate(x) -> go(x.body),
    NParallel(x) -> within(x.branches),
    NHandle(h) ->
      within(
        h.clauses.fold(
          match h.ret { Some(r) -> [h.body, r.body], None -> [h.body] },
          |acc: List<Code>, cl: CodeClause| acc.push(cl.body),
        ),
      ),
    _ -> [],
  }
}

/// The lambdas `c` writes, at any depth, each before those its body writes, in one fixed order.
pub fn lambdas_of(c: Code) -> List<Lambda> = {
  let within = |codes: List<Code>|
    codes.fold([], |acc: List<Lambda>, x: Code| acc.concat(lambdas_of(x)));
  match c.node {
    NLambda(l) -> [l].concat(lambdas_of(l.body)),
    NUnary(u) -> lambdas_of(u.operand),
    NBinary(b) -> within([b.lhs, b.rhs]),
    NField(f) -> lambdas_of(f.base),
    NApp(a) -> within(a.args.push(a.func)),
    NIf(i) -> within([i.cond, i.then_branch, i.else_branch]),
    NBlock(b) ->
      within(
        b.stmts.fold(
          match b.tail { Some(t) -> [t], None -> [] },
          |acc: List<Code>, stmt: CodeStmt|
            acc.push(match stmt { CLet(l) -> l.value, CLetPat(l) -> l.value, CDo(d) -> d.code }),
        ),
      ),
    NList(l) -> within(l.items),
    NRecord(r) -> within(r.fields.map(|f: CodeField| f.value)),
    NUpdate(u) -> within(u.sets.map(|f: CodeField| f.value).push(u.base)),
    NMatch(m) ->
      within(
        m.arms.fold([m.scrutinee], |acc: List<Code>, a: CodeArm|
          List::push(match a.guard { Some(g) -> acc.push(g), None -> acc }, a.body)),
      ),
    NPerform(x) -> within(x.args),
    NSimulate(x) -> lambdas_of(x.body),
    NParallel(x) -> within(x.branches),
    NHandle(h) ->
      within(
        h.clauses.fold(
          match h.ret { Some(r) -> [h.body, r.body], None -> [h.body] },
          |acc: List<Code>, cl: CodeClause| acc.push(cl.body),
        ),
      ),
    _ -> [],
  }
}

/// Where `l` first stands in `ls`.
fn position_in(ls: List<Lambda>, l: Lambda) -> Option<Int> =
  range(0, ls.len()).fold(None, |acc: Option<Int>, k: Int|
    match acc { Some(_) -> acc, None -> if ls.at(k) == Some(l) { Some(k) } else { None } })

/// Whether `c` holds a `handle` anywhere, a lambda's or a known lambda's body among it.
pub fn has_handle(c: Code) -> Bool = {
  let within = |codes: List<Code>| codes.fold(false, |acc: Bool, x: Code| acc || has_handle(x));
  match c.node {
    NHandle(_) -> true,
    NUnary(u) -> has_handle(u.operand),
    NBinary(b) -> within([b.lhs, b.rhs]),
    NField(f) -> has_handle(f.base),
    NApp(a) -> within(a.args.push(a.func)),
    NIf(i) -> within([i.cond, i.then_branch, i.else_branch]),
    NBlock(b) ->
      (match b.tail { Some(t) -> has_handle(t), None -> false })
        || b.stmts.fold(false, |acc: Bool, stmt: CodeStmt|
          acc
            || (match stmt {
              CLet(l) -> has_handle(l.value),
              CLetPat(l) -> has_handle(l.value),
              CDo(d) -> has_handle(d.code),
            })),
    NList(l) -> within(l.items),
    NRecord(r) -> within(r.fields.map(|f: CodeField| f.value)),
    NUpdate(u) -> within(u.sets.map(|f: CodeField| f.value).push(u.base)),
    NMatch(m) ->
      has_handle(m.scrutinee)
        || m.arms.fold(false, |acc: Bool, a: CodeArm|
          acc || (match a.guard { Some(g) -> has_handle(g), None -> false }) || has_handle(a.body)),
    NPerform(p) -> within(p.args),
    NLambda(l) -> has_handle(l.body),
    NSimulate(x) -> has_handle(x.body),
    NKnown(k) -> has_handle(k.lambda.body),
    NParallel(pr) -> within(pr.branches),
    _ -> false,
  }
}

/// A slot known to hold `owner`'s `nth` lambda, whose code is `code`.
type KnownSlot = { slot: Int, owner: Bytes, nth: Int, code: Lambda }

/// `c`, code of the root `owner`, with each read of a slot `bound` names written as the lambda it is
/// known to be, through lambdas that capture the slot. A slot a `let` binds to a lambda, or to such
/// a read, is known for the rest of its block. `own` is the root's lambdas before any is rewritten,
/// which is what numbers them.
fn known_values(c: Code, bound: List<KnownSlot>, owner: Bytes, own: List<Lambda>) -> Code = {
  let go = |x: Code| known_values(x, bound, owner, own);
  let known = |slot: Int|
    bound.fold(None, |found: Option<KnownSlot>, k: KnownSlot|
      if k.slot == slot { Some(k) } else { found });
  let inside = |caps: List<Capture>|
    caps.fold([], |acc: List<KnownSlot>, cap: Capture|
      match known(cap.src) { Some(k) -> acc.push({ ..k, slot: cap.dst }), None -> acc });
  let maybe = |x: Option<Code>| match x { Some(y) -> Some(go(y)), None -> None };
  let node = match c.node {
    NVar(v) -> match match v.slot { Some(sl) -> known(sl), None -> None } {
      Some(k) -> NKnown({ name: v.name, slot: k.slot, lambda: k.code, owner: k.owner, nth: k.nth }),
      None -> c.node,
    },
    NApp(a) -> NApp({ func: go(a.func), args: a.args.map(go) }),
    NUnary(u) -> NUnary({ ..u, operand: go(u.operand) }),
    NBinary(b) -> NBinary({ ..b, lhs: go(b.lhs), rhs: go(b.rhs) }),
    NIf(i) ->
      NIf({ cond: go(i.cond), then_branch: go(i.then_branch), else_branch: go(i.else_branch) }),
    NBlock(b) -> {
      let walked = b.stmts.fold(
        { bound: bound, stmts: [] },
        |acc: { bound: List<KnownSlot>, stmts: List<CodeStmt> }, stmt: CodeStmt|
          match stmt {
            CLet(l) -> {
              let value = known_values(l.value, acc.bound, owner, own);
              let rest = acc.bound.filter(|k: KnownSlot| k.slot != l.slot);
              {
                bound: match value.node {
                  NLambda(lam) -> match match l.value.node {
                      NLambda(written) -> position_in(own, written),
                      _ -> None,
                    } {
                    Some(nth) -> if has_handle(lam.body) { rest }
                    else { rest.push({ slot: l.slot, owner: owner, nth: nth, code: lam }) },
                    None -> rest,
                  },
                  NKnown(k) ->
                    rest.push({ slot: l.slot, owner: k.owner, nth: k.nth, code: k.lambda }),
                  _ -> rest,
                },
                stmts: acc.stmts.push(CLet({ ..l, value: value })),
              }
            },
            CLetPat(l) ->
              {
                bound: acc.bound,
                stmts: acc.stmts.push(
                  CLetPat({ ..l, value: known_values(l.value, acc.bound, owner, own) }),
                ),
              },
            CDo(d) ->
              {
                bound: acc.bound,
                stmts: acc.stmts.push(CDo({ code: known_values(d.code, acc.bound, owner, own) })),
              },
          },
      );
      NBlock({
        stmts: walked.stmts,
        tail: match b.tail {
          Some(t) -> Some(known_values(t, walked.bound, owner, own)),
          None -> None,
        },
      })
    },
    NList(l) -> NList({ items: l.items.map(go) }),
    NRecord(r) -> NRecord({ fields: r.fields.map(|f: CodeField| { ..f, value: go(f.value) }) }),
    NMatch(m) ->
      NMatch({
        scrutinee: go(m.scrutinee),
        arms: m.arms.map(|a: CodeArm| { ..a, guard: maybe(a.guard), body: go(a.body) }),
      }),
    NPerform(x) -> NPerform({ ..x, label: maybe(x.label), args: x.args.map(go) }),
    NLambda(l) -> NLambda({ ..l, body: known_values(l.body, inside(l.captures), owner, own) }),
    NSimulate(x) -> NSimulate({ ..x, body: known_values(x.body, inside(x.captures), owner, own) }),
    NParallel(pr) -> NParallel({ ..pr, branches: pr.branches.map(go) }),
    NField(f) -> NField({ ..f, base: go(f.base) }),
    NUpdate(u) ->
      NUpdate({
        ..u,
        base: go(u.base),
        sets: u.sets.map(|f: CodeField| { ..f, value: go(f.value) }),
      }),
    other -> other,
  };
  { ..c, node: node }
}

/// What an operation that answers a word of its own and can fail does with its operands: it has none.
fn answers() -> { takes: List<Bool>, owned: Bool, fails: Bool, stops: Bool } =
  { takes: [], owned: true, fails: true, stops: false }

/// A step counted, which can fail where the run is cancelled, and answers nothing.
fn ticks() -> { takes: List<Bool>, owned: Bool, fails: Bool, stops: Bool } =
  { takes: [], owned: false, fails: true, stops: false }

/// Whether `args` are what `iterate` runs in place: a seed, a budget, and a step of one parameter.
fn stepped(args: List<Code>) -> Bool =
  args.len() == 3
    && (match args.at(2) {
      Some(c) -> match c.node { NLambda(l) -> l.params == 1, _ -> false },
      None -> false,
    })

/// The builtin a call of `name` reaches: an import's extern by its own name, else `name`.
fn extern_named(cx: Context, name: Bytes) -> Bytes =
  match imported_target(cx.setting.imports, name) {
    Some(t) -> if cx.setting.builtins.contains(t.name) { t.name } else { name },
    None -> name,
  }

/// The definition `name` names in the root's module.
fn def_named(cx: Context, name: Bytes) -> Option<Defined> / {abort.raise} =
  def_in(cx.setting.module, cx.setting.here, cx.setting.imports, name)

/// The definition `name` names in `module`, which defines `here` and imports `imports`: the
/// module's own first, then what an import reaches. A constructor's name names none, since a
/// constructor and a definition share the names a module sees.
pub fn def_in(
  module: Bytes,
  here: List<Def>,
  imports: List<Imported>,
  name: Bytes,
) -> Option<Defined> / {abort.raise} =
  match here.fold(None, |acc: Option<Def>, d: Def| if d.name == name { Some(d) } else { acc }) {
    Some(d) -> Some({ full: qualify(module, name), def: d }),
    None -> match imported_target(imports, name) {
      None -> None,
      Some(t) -> match t.imp.defs.fold(None, |acc: Option<Def>, d: Def|
          if d.name == t.name { Some(d) } else { acc }) {
        Some(d) -> Some({ full: qualify(t.imp.module, t.name), def: d }),
        None -> None,
      },
    },
  }

/// The type arguments the checker gave a reference at `at` of a definition of scheme `scheme`, none
/// for one that takes none; `None` where it filed none, or not one for each of the scheme's
/// variables.
fn reference_args(cx: Context, scheme: Option<Scheme>, at: Span) -> Option<List<Type>> =
  match scheme {
    None -> Some([]),
    Some(sc) -> if sc.ty_vars.len() == 0 { Some([]) } else {
      match filed(cx, at) {
        Some(t) -> if t.args.len() == sc.ty_vars.len() { Some(t.args) } else { None },
        None -> None,
      }
    },
  }

fn same_fns(a: List<FnArg>, b: List<FnArg>) -> Bool =
  a.len() == b.len() && a.all(|f: FnArg| b.contains(f))
