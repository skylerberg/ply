//! How often a `handle` clause that resumes off its tail may resume its continuation, which decides
//! whether the runtime snapshots the stop it resumes: never where the clause resumes it at most once.

import compiler.check.types (Row)
import compiler.emit.code (Code, CodeClause, CodeStmt, CLet, CLetPat, CDo, CodeArm, CodeField, NLit,
                           NVar, NUnary, NBinary, NApp, NIf, NBlock, NList, NRecord, NMatch,
                           NPerform, NLabel, NLambda, NSimulate, NParallel, NHandle, NField,
                           NUpdate, NKnown, NDef, NCtor, NBuiltin, slots_read, all_read)

/// The runtime's code for clause `cl`, which resumes off its tail: `2` where it calls its
/// continuation at most once however it runs, so the stop it resumes needs no snapshot, and `4`
/// where it may call it again. At most once is every read of the continuation a direct call whose
/// argument does not read it, none under a lambda, `handle`, `simulate` or `parallel`, no path
/// making two, and nothing before the call that may stop: a handler around the clause that resumes
/// such a stop twice would run the call twice. Read off the code alone, since the type filed for a
/// clause carries no row of what its body performs.
pub fn off_tail_code(cl: CodeClause) -> Int = {
  let r = run(cl.body, continuation_slot(cl));
  let once = match r.calls { Some(n) -> n <= 1, None -> false };
  if once && !r.stops_first { 2 } else { 4 }
}

/// The most calls of continuation `k`, slot `k`, on one path through `code`; none where some read of
/// it is not a direct call whose argument does not read it, or is under a lambda, `handle`,
/// `simulate` or `parallel`, which may call it any number of times.
pub fn max_calls_on_a_path(code: Code, k: Int) -> Option<Int> = run(code, k).calls

/// The slot a clause's continuation takes: after its parameters and the label it binds.
pub fn continuation_slot(cl: CodeClause) -> Int = cl.params + (if cl.binds_label { 1 } else { 0 })

/// What running code may do with a continuation: the most calls of it on one path, as
/// `max_calls_on_a_path` answers; whether it may stop; and whether some path may stop before it
/// calls the continuation.
type Run = { calls: Option<Int>, stops: Bool, stops_first: Bool }

fn still() -> Run = { calls: Some(0), stops: false, stops_first: false }

fn stop() -> Run = { calls: Some(0), stops: true, stops_first: false }

/// `a`, then `b`.
fn followed(a: Run, b: Run) -> Run =
  {
    calls: match a.calls {
      Some(x) -> match b.calls { Some(y) -> Some(x + y), None -> None },
      None -> None,
    },
    stops: a.stops || b.stops,
    stops_first: a.stops_first || b.stops_first || (a.stops && b.calls != Some(0)),
  }

/// `a` or `b`, whichever a path takes.
fn either(a: Run, b: Run) -> Run =
  {
    calls: match a.calls {
      Some(x) -> match b.calls { Some(y) -> Some(if x > y { x } else { y }), None -> None },
      None -> None,
    },
    stops: a.stops || b.stops,
    stops_first: a.stops_first || b.stops_first,
  }

fn in_turn(codes: List<Code>, k: Int) -> Run =
  codes.fold(still(), |acc: Run, c: Code| followed(acc, run(c, k)))

/// Running `code`, a lambda, `handle`, `simulate` or `parallel`, whose reads of `k` may call it any
/// number of times, and which stops where it `runs` code.
fn enclosed(code: Code, k: Int, runs: Bool) -> Run =
  {
    calls: if slots_read(code).contains(k) { None } else { Some(0) },
    stops: runs,
    stops_first: false,
  }

/// Whether `a` calls continuation `k` directly with one argument that does not read it.
fn resumes(a: { func: Code, args: List<Code>, row: Row }, k: Int) -> Bool =
  match a.func.node {
    NVar(v) -> v.slot == k && a.args.len() == 1 && !all_read(a.args).contains(k),
    _ -> false,
  }

/// What running `code` may do with continuation `k`. A call of anything but `k`, a perform, a
/// `handle`, a `simulate` and a `parallel` may stop; a call of `k` is no stop that matters, since
/// where `k` is called at most once nothing after the call calls it again.
fn run(code: Code, k: Int) -> Run =
  match code.node {
    NLit(_) -> still(),
    NLabel(_) -> still(),
    NVar(v) -> if v.slot == k { { ..still(), calls: None } } else { still() },
    NDef(_) -> still(),
    NCtor(_) -> still(),
    NBuiltin(_) -> still(),
    NKnown(x) -> if x.slot == k { { ..still(), calls: None } } else { still() },
    NUnary(u) -> run(u.operand, k),
    NBinary(b) -> followed(run(b.lhs, k), run(b.rhs, k)),
    NField(f) -> run(f.base, k),
    NUpdate(u) ->
      u.sets.fold(run(u.base, k), |acc: Run, f: CodeField| followed(acc, run(f.value, k))),
    NRecord(r) -> r.fields.fold(still(), |acc: Run, f: CodeField| followed(acc, run(f.value, k))),
    NList(l) -> in_turn(l.items, k),
    NApp(a) -> if resumes(a, k) {
      let e = in_turn(a.args, k);
      { calls: Some(1), stops: e.stops, stops_first: e.stops }
    } else { followed(followed(run(a.func, k), in_turn(a.args, k)), stop()) },
    NIf(i) -> followed(run(i.cond, k), either(run(i.then_branch, k), run(i.else_branch, k))),
    NBlock(b) -> {
      let stmts = b.stmts.fold(still(), |acc: Run, s: CodeStmt|
        followed(acc, match s {
          CLet(l) -> run(l.value, k),
          CLetPat(l) -> run(l.value, k),
          CDo(d) -> run(d.code, k),
        }));
      match b.tail { Some(t) -> followed(stmts, run(t, k)), None -> stmts }
    },
    // Every guard may run before the arm a path takes.
    NMatch(m) ->
      followed(
        m.arms.fold(run(m.scrutinee, k), |acc: Run, a: CodeArm|
          match a.guard { Some(g) -> followed(acc, run(g, k)), None -> acc }),
        m.arms.fold(still(), |acc: Run, a: CodeArm| either(acc, run(a.body, k))),
      ),
    NPerform(p) ->
      followed(
        followed(match p.label { Some(l) -> run(l, k), None -> still() }, in_turn(p.args, k)),
        stop(),
      ),
    NLambda(_) -> enclosed(code, k, false),
    NSimulate(_) -> enclosed(code, k, true),
    NParallel(_) -> enclosed(code, k, true),
    NHandle(_) -> enclosed(code, k, true),
  }
