//! How a value of a type is held in a body and crosses a call between roots, and where a record's
//! field or a sum's case's argument lies, each as `reps.laid` lays the type out. A record held as
//! its leaves names each leaf by its field, and the leaves of a record it holds by `field.leaf`, so a
//! flat representation spells the layout it was flattened from.

import compiler.check.types
import compiler.check.types (Type, VariableType, NamedType, RecordType, NominalType, Field,
                             int_type, option_type, string_type, float_type, unit_type)
import compiler.check.known (char_type, ordering_type, result_type, width_type, option_name,
                             result_name, ordering_name, none_ctor, some_ctor, ok_ctor, err_ctor,
                             less_ctor, equal_ctor, greater_ctor)
import compiler.emit.representations (SumCtor, Ctors, kind_of, known_layout, inside_layout,
                                      ctors_of, ctor_fields_at)
import compiler.emit.c (Width, Kind, IntKind, BoolKind, SizedIntKind, FloatKind, DecimalKind,
                        WideKind, in_register)
import compiler.emit.typed_ir (all_given, Representation, AsInt, AsBool, AsFixed, AsFloat,
                               AsDecimal, AsWideFixed, AsWord, AsFlattened, Leaf, AsSum, AsUnit,
                               AsListView, AsImmediate, Convention, OwnedParam, OwnedResult,
                               parts_of)
import compiler.emit.layout (ValueLayout, SumCases, RecordFields, PlainWords, InlineRecord,
                             FieldLayout, Pointer, Mixed, Always, Inline, Boxed, Nullary, SumLayout,
                             words, register_words, raw, holds_count)
import compiler.emit.lower.module_context (ModuleContext)

/// How a value of `ty` is held in a body, and so how it crosses a call: `representation_with` the setting's
/// constructor table.
pub fn representation_of(s: ModuleContext, ty: Type) -> Representation =
  representation_with(s.ctors, ty)

/// How a root whose parameters are of `params` and whose answer is of `answer` takes and answers
/// them: each held as a body holds a value of its type, given, and the answer owned, written where
/// the caller says when it is a record lying in place. A root is lowered to it and every call of
/// the root is written to it, a root written for a type among them, so a call's head and its
/// callee's are one.
pub fn typed_convention(ctors: Ctors, params: List<Type>, answer: Type) -> Convention =
  {
    params: all_given(params.map(|t: Type| representation_with(ctors, t))),
    result: representation_with(ctors, answer),
    destination_passing: match inside_layout(ctors, answer) {
      Some(InlineRecord(_)) -> true,
      _ -> false,
    },
    answered: OwnedResult,
  }

/// How a value of `ty` is held, as `reps.laid` lays the type out over the constructor table
/// `ctors`, and so how it lies inside another value: a value of no words in none; a record as its
/// leaves while it fits a call's registers (`layout.flat_record`), else as the box its word form
/// is; a declared sum as its words; a scalar as itself, one C holds in no type of its own as a word
/// holding no count; and a pointer, and any value whose layout a type variable leaves open, as a
/// word.
pub fn representation_with(ctors: Ctors, ty: Type) -> Representation =
  match inside_layout(ctors, ty) {
    None -> AsWord,
    Some(l) -> representation_of_layout(ctors, ty, l),
  }

/// How a value of `ty` laid as `l` is held, each field of a record held as the layout it has there
/// says, so no field is laid out again.
fn representation_of_layout(ctors: Ctors, ty: Type, l: ValueLayout) -> Representation =
  if words(l) == 0 { AsUnit } else {
    match l {
      SumCases(x) -> AsSum({ layout: x, cases: case_names(ctors, ty) }),
      RecordFields(fs) -> AsFlattened(record_leaves(ctors, ty, fs)),
      // Held as the word its header's address is, or its box's.
      InlineRecord(_) -> AsWord,
      PlainWords(_) -> match scalar_representation(kind_of(ty).kind) {
        AsWord -> if holds_count(l) { AsWord } else { AsImmediate },
        r -> r,
      },
    }
  }

/// The leaves a record of type `ty` is laid in, however wide: what its box holds where it is held as
/// one; none for a value of any other type.
pub fn layout_leaves(ctors: Ctors, ty: Type) -> Option<List<Leaf>> =
  match known_layout(ctors, ty) {
    Some(RecordFields(fs)) -> match representation_of_layout(ctors, ty, RecordFields(fs)) {
      AsFlattened(ls) -> Some(ls),
      _ -> None,
    },
    _ -> None,
  }

/// The leaves a value of `ty` lies in, in place, inside another value: a record's that `representation_with`
/// holds as its leaves; none for a record held as its box, which lies there as a pointer to it.
pub fn leaves_inside(ctors: Ctors, ty: Type) -> Option<List<Leaf>> =
  match representation_with(ctors, ty) { AsFlattened(ls) -> Some(ls), _ -> None }

/// Whether a value of `ty` lies in place inside another behind a header: a record too wide to be
/// held as its leaves, which a read of it answers the header's address of.
pub fn inline_with_header(ctors: Ctors, ty: Type) -> Bool =
  match inside_layout(ctors, ty) { Some(InlineRecord(_)) -> true, _ -> false }

/// The constructors of the declared sum `ty`, as the table names them, in their declared order.
fn case_names(ctors: Ctors, ty: Type) -> List<Bytes> =
  match ty {
    NamedType(c) -> match ctors.sums.get(c.name) {
      Some(cs) -> cs.map(|x: SumCtor| x.name),
      None -> [],
    },
    _ -> [],
  }

/// How a value of width `w` is held: in its own C type, or at 128 bits as its two words.
pub fn width_representation(w: Width) -> Representation =
  if in_register(w) { AsFixed(w) } else { AsWideFixed(w) }

/// How a scalar of kind `k` is held: in its own C type, or as a word.
fn scalar_representation(k: Kind) -> Representation =
  match k {
    IntKind -> AsInt,
    BoolKind -> AsBool,
    SizedIntKind(w) -> AsFixed(w),
    FloatKind -> AsFloat,
    DecimalKind -> AsDecimal,
    WideKind(w) -> AsWideFixed(w),
    _ -> AsWord,
  }

/// The fields of a record type, in the checker's order (sorted by name); none for any other type.
pub fn record_fields(ty: Type) -> List<Field> =
  match types::record_fields(ty) { Some(fs) -> fs, None -> [] }

/// A field of a record that holds a value: its place among the type's fields, its name and type,
/// and how it lies in the record, as it is held (`representation_with`).
pub type RecordPart = { field: Int, name: Bytes, ty: Type, representation: Representation }

/// The parts of a record of type `ty`, in its words' order: each field that holds a value, a field
/// of no words none. Whatever makes, reads or lays out a record's fields walks these.
pub fn record_parts(ctors: Ctors, ty: Type) -> List<RecordPart> =
  match known_layout(ctors, ty) {
    Some(RecordFields(fs)) -> record_parts_of_layout(ctors, ty, fs),
    _ -> [],
  }

fn record_parts_of_layout(ctors: Ctors, ty: Type, fs: List<FieldLayout>) -> List<RecordPart> = {
  let fields = record_fields(ty);
  range(0, fields.len()).fold([], |acc: List<RecordPart>, i: Int|
    match ((fields.at(i), fs.at(i))) {
      (Some(f), Some(laid)) -> match representation_of_layout(ctors, f.ty, laid.layout) {
        AsUnit -> acc,
        r -> acc.push({ field: i, name: f.name, ty: f.ty, representation: r }),
      },
      _ -> acc,
    })
}

/// An argument of a sum's case: its type at the sum's arguments, and how it lies in the case's
/// payload, as it is held (`representation_with`).
pub type CasePart = { ty: Type, representation: Representation }

/// The arguments of case `case` of the sum `ty`, in order; none where `ty` declares no such case.
/// Whatever makes or lays out a case's payload walks these.
pub fn case_parts(ctors: Ctors, ty: Type, case: Int) -> List<CasePart> =
  match ty {
    NamedType(c) -> match ctors.sums.get(c.name) {
      Some(cs) -> match cs.at(case) {
        Some(k) ->
          ctor_fields_at(k, c.args).map(|t: Type|
            { ty: t, representation: representation_with(ctors, t) }),
        None -> [],
      },
      None -> [],
    },
    _ -> [],
  }

/// The leaves of a record of type `ty` whose fields are laid as `fs`, in its words' order: each
/// part held as it lies, named by its field, a record's leaves named `field.leaf` in place.
fn record_leaves(ctors: Ctors, ty: Type, fs: List<FieldLayout>) -> List<Leaf> =
  record_parts_of_layout(ctors, ty, fs).fold([], |acc: List<Leaf>, p: RecordPart|
    match p.representation {
      AsFlattened(inner) ->
        acc.concat(
          inner.map(|l: Leaf|
            { name: Bytes::concat_all([p.name, b".", l.name]), representation: l.representation }),
        ),
      r -> acc.push({ name: p.name, representation: r }),
    })

/// Where field `name` of a flat record of leaves `ls` lies among them: its first leaf and how many
/// it takes, a record's leaves all; none for a field of no words, which holds no leaf.
pub fn leaf_span(ls: List<Leaf>, name: Bytes) -> Option<{ at: Int, n: Int }> = {
  let prefix = name.concat(b".");
  range(0, ls.len()).fold(None, |acc: Option<{ at: Int, n: Int }>, k: Int|
    match ls.at(k) {
      None -> acc,
      Some(l) -> if l.name == name || l.name.starts_with(prefix) {
        match acc { Some(a) -> Some({ at: a.at, n: a.n + 1 }), None -> Some({ at: k, n: 1 }) }
      } else { acc },
    })
}

/// `leaf_span` of every field at once, by the field's name.
pub fn leaf_spans(ls: List<Leaf>) -> Map<Bytes, { at: Int, n: Int }> =
  range(0, ls.len()).fold(Map::new(), |m: Map<Bytes, { at: Int, n: Int }>, k: Int|
    match ls.at(k) {
      None -> m,
      Some(l) -> {
        let field = match l.name.index_of(b".") {
          Some(dot) -> before(l.name, dot),
          None -> l.name,
        };
        m.insert(field, match m.get(field) {
          Some(sp) -> { at: sp.at, n: sp.n + 1 },
          None -> { at: k, n: 1 },
        })
      },
    })

/// The leaves of the field a span of a flat record's leaves holds, named as that field's own type
/// names them: `field.leaf` read as `leaf`.
pub fn leaves_within(ls: List<Leaf>, sp: { at: Int, n: Int }) -> List<Leaf> =
  ls.drop(sp.at).take(sp.n).map(|l: Leaf|
    match l.name.index_of(b".") {
      Some(dot) -> { name: after(l.name, dot + 1), representation: l.representation },
      None -> l,
    })

/// Where leaf `k` of a flat record of leaves `ls` lies among `c_values_of(AsFlattened(ls))`: its first
/// value and how many it takes, a sum's its words.
pub fn leaf_values(ls: List<Leaf>, k: Int) -> { at: Int, n: Int } =
  range(0, k + 1).fold({ at: 0, n: 0 }, |acc: { at: Int, n: Int }, j: Int| {
    let n = match ls.at(j) { Some(l) -> c_values_of(l.representation).len(), None -> 0 };
    if j == k { { at: acc.at, n: n } } else { { at: acc.at + n, n: 0 } }
  })

/// The type of field `name` of a record of type `ty`.
pub fn field_type(ty: Type, name: Bytes) -> Option<Type> =
  record_fields(ty).fold(None, |acc: Option<Type>, f: Field|
    if f.name == name { Some(f.ty) } else { acc })

/// The type of the leaf `name` names in a flat record of type `ty`: a field's, and `field.leaf`'s
/// the leaf's of the record that field holds in place.
pub fn leaf_type(ty: Type, name: Bytes) -> Option<Type> =
  name.split(b".").fold(Some(ty), |at: Option<Type>, f: Bytes|
    match at { Some(t) -> field_type(t, f), None -> None })

/// `field_type` of every field at once, by its name.
pub fn field_types(ty: Type) -> Map<Bytes, Type> =
  record_fields(ty).fold(Map::new(), |m: Map<Bytes, Type>, f: Field| m.insert(f.name, f.ty))

/// The word of each field of a record of type `ty` laid out, by the field's name: where the box of
/// its words holds the field.
pub fn field_offsets(s: ModuleContext, ty: Type) -> Map<Bytes, Int> =
  match known_layout(s.ctors, ty) {
    Some(RecordFields(ls)) -> {
      let fs = record_fields(ty);
      range(0, fs.len()).fold(Map::new(), |m: Map<Bytes, Int>, i: Int|
        match ((fs.at(i), ls.at(i))) { (Some(f), Some(l)) -> m.insert(f.name, l.at), _ -> m })
    },
    _ -> Map::new(),
  }

/// The place of constructor `ctor` (as the table names it) among the constructors of a sum held as
/// `r`.
pub fn case_index(r: Representation, ctor: Bytes) -> Option<Int> =
  match r {
    AsSum(s) ->
      range(0, s.cases.len()).fold(None, |acc: Option<Int>, i: Int|
        if acc == None && s.cases.at(i) == Some(ctor) { Some(i) } else { acc }),
    _ -> None,
  }

/// Where argument `at` of case `i` of a sum laid as `s` starts in the case's payload: where the
/// case's arguments, laid as a record of them, lay it; none for a case of no words.
pub fn case_argument_offset(s: SumLayout, i: Int, at: Int) -> Option<Int> = {
  let field = |l: ValueLayout|
    match l {
      RecordFields(fs) -> match fs.at(at) { Some(f) -> Some(f.at), None -> None },
      _ -> None,
    };
  match s.cases.at(i) {
    Some(c) -> match c.payload {
      Inline(p) -> field(p.layout),
      Boxed(b) -> field(b.layout),
      Nullary -> None,
    },
    None -> None,
  }
}

/// How a value crosses a call: in its C values, or as the address of the caller's copy of it laid
/// in place, the callee owning the counts in it.
pub type Passing = | InWords | ByReference

/// How a value held as `r` crosses a call, as a root's parameter or a closure's typed entry's: a
/// record or a sum of more than `register_words()` words by reference, and any other value in its C
/// values.
pub fn passing(r: Representation) -> Passing =
  match r { AsFlattened(_) -> passing_by_size(r), AsSum(_) -> passing_by_size(r), _ -> InWords }

fn passing_by_size(r: Representation) -> Passing =
  if value_words(r) > register_words() { ByReference } else { InWords }

/// How each C value a value held as `r` is held in is held, in order: a flat record's leaves'
/// values, a sum leaf's its words; a sum's words; a value of no words in none; a view as its parts;
/// any other value in itself. A record or a sum is exactly its words: its word form, a box of them,
/// is made only where it is asked for.
pub fn c_values_of(r: Representation) -> List<Representation> =
  match r {
    AsFlattened(ls) ->
      ls.fold([], |acc: List<Representation>, l: Leaf| acc.concat(c_values_of(l.representation))),
    AsSum(s) -> range(0, words(SumCases(s.layout))).map(|_: Int| AsWord),
    AsUnit -> [],
    AsListView -> parts_of(r),
    _ -> [r],
  }

/// How many words the C values held as `vs` take: a `Decimal`'s and a 128-bit width's two, one for
/// any other.
pub fn word_count(vs: List<Representation>) -> Int =
  vs.fold(0, |n: Int, v: Representation|
    n + (match v { AsDecimal -> 2, AsWideFixed(_) -> 2, _ -> 1 }))

/// How many words a value held as `r` takes.
pub fn value_words(r: Representation) -> Int = word_count(c_values_of(r))

/// How many words a caller's buffer holds for an answer held as `r`, which the callee writes past
/// the C value it returns: the words of its other values, none for an answer of one C value.
pub fn return_buffer_words(r: Representation) -> Int = word_count(c_values_of(r).drop(1))

/// `b` from byte `at` on.
fn after(b: Bytes, at: Int) -> Bytes =
  match b.slice_at(at, b.len() - at) { Some(x) -> x, None -> b"" }

/// `b` up to byte `at`.
fn before(b: Bytes, at: Int) -> Bytes = match b.slice_at(0, at) { Some(x) -> x, None -> b"" }

fn module_context_of(ctors: Ctors) -> ModuleContext =
  {
    module: b"m",
    here: [],
    imports: [],
    ctors: ctors,
    builtins: [],
    declared: Map::new(),
    machine: Map::new(),
    effects: [],
    release: false,
  }

fn named(n: Bytes) -> Type = NamedType({ name: n, args: [] })

fn record(fs: List<{ name: Bytes, ty: Type }>) -> Type = RecordType(fs)

fn point() -> Type = record([{ name: b"x", ty: float_type() }, { name: b"y", ty: float_type() }])

/// A record held as its fields.
fn line() -> Type = record([{ name: b"from", ty: point() }, { name: b"to", ty: point() }])

/// A record wider than a call's registers, held as its box.
fn segment() -> Type =
  record(
    [
      { name: b"from", ty: point() },
      { name: b"label", ty: string_type() },
      { name: b"to", ty: point() },
    ].concat(
      range(0, register_words()).map(|i: Int|
        { name: b"z".concat(Bytes::of_string(i.to_string())), ty: int_type() }),
    ),
  )

/// A table of the prelude's `Option` and `Result`, an enum and a sum of one case of no words.
fn sums() -> Ctors = {
  let ctor = |n: Bytes, i: Int, fields: List<Type>, params: List<Int>|
    { name: n, index: i, fields: fields, params: params };
  ctors_of(
    [],
    [],
    [],
    Map::new().insert(option_name(), [
      ctor(none_ctor(), 0, [], [0]),
      ctor(some_ctor(), 1, [VariableType(0)], [0]),
    ]).insert(result_name(), [
      ctor(ok_ctor(), 0, [VariableType(0)], [0, 1]),
      ctor(err_ctor(), 1, [VariableType(1)], [0, 1]),
    ]).insert(ordering_name(), [
      ctor(less_ctor(), 0, [], []),
      ctor(equal_ctor(), 1, [], []),
      ctor(greater_ctor(), 2, [], []),
    ]).insert(b"m.Token", [ctor(b"m.Token", 0, [], [])]),
  )
}

test "a scalar is held as itself, a pointer as a word, and a value of no words in none" {
  let s = module_context_of(sums());
  assert_eq(representation_of(s, int_type()), AsInt);
  assert_eq(representation_of(s, float_type()), AsFloat);
  assert_eq(
    representation_of(s, width_type({ bits: 8, signed: false })),
    AsFixed({ bits: 8, signed: false }),
  );
  assert_eq(
    representation_of(s, width_type({ bits: 128, signed: true })),
    AsWideFixed({ bits: 128, signed: true }),
  );
  // A `Char` is its own word, which holds no count.
  assert_eq([string_type(), char_type()].map(|t: Type| representation_of(s, t)), [
    AsWord,
    AsImmediate,
  ]);
  assert_eq(
    [unit_type(), record([]), record([{ name: b"u", ty: unit_type() }]), named(b"m.Token")].map(
      |t: Type| representation_of(s, t),
    ),
    [AsUnit, AsUnit, AsUnit, AsUnit],
  );
  // A type variable leaves the layout open: the value is a word.
  assert_eq(representation_of(s, VariableType(0)), AsWord)
}

test "a declared sum is held as the words its type lays it in, and one a variable leaves open as a word" {
  let s = module_context_of(sums());
  match representation_of(s, option_type(string_type())) {
    AsSum(x) -> {
      assert_eq(x.cases, [b"None", b"Some"]);
      assert_eq(c_values_of(AsSum(x)), [AsWord])
    },
    other -> assert_eq(other, AsWord),
  };
  // A tag word and the payload, and no word of its own.
  assert_eq(c_values_of(representation_of(s, option_type(int_type()))), [AsWord, AsWord]);
  assert_eq(case_index(representation_of(s, ordering_type()), greater_ctor()), Some(2));
  assert_eq(representation_of(s, option_type(VariableType(0))), AsWord)
}

test "a record is held as its leaves in its words' order, a record it holds among them and no word of its own" {
  let s = module_context_of(sums());
  assert_eq(
    representation_of(s, point()),
    AsFlattened([{ name: b"x", representation: AsFloat }, { name: b"y", representation: AsFloat }]),
  );
  let leaves = match representation_of(s, line()) { AsFlattened(ls) -> ls, _ -> [] };
  assert_eq(leaves.map(|l: Leaf| l.name), [b"from.x", b"from.y", b"to.x", b"to.y"]);
  assert_eq(leaf_span(leaves, b"to"), Some({ at: 2, n: 2 }));
  assert_eq(leaf_span(leaves, b"from"), Some({ at: 0, n: 2 }));
  assert_eq(leaves_within(leaves, { at: 2, n: 2 }).map(|l: Leaf| l.name), [b"x", b"y"]);
  // A field of no words holds no leaf; a sum field is one leaf, its words its record's own.
  let holder = record([
    { name: b"o", ty: option_type(int_type()) },
    { name: b"u", ty: unit_type() },
    { name: b"z", ty: int_type() },
  ]);
  let hs = match representation_of(s, holder) { AsFlattened(ls) -> ls, _ -> [] };
  assert_eq(hs.map(|l: Leaf| l.name), [b"o", b"z"]);
  assert_eq(c_values_of(AsFlattened(hs)), [AsWord, AsWord, AsInt]);
  assert_eq([leaf_values(hs, 0), leaf_values(hs, 1)], [{ at: 0, n: 2 }, { at: 2, n: 1 }]);
  // A field of a variable's type leaves the layout open: the record is a word.
  assert_eq(representation_of(s, record([{ name: b"inner", ty: VariableType(0) }])), AsWord)
}

// A wider record copied whole at each read of it or of a field it holds would make a body's code
// and frame grow as its fields times its reads.
test "a record wider than a call's registers is a box, lies in place in a record holding it, and in a case as a pointer" {
  let s = module_context_of(sums());
  assert_eq(representation_of(s, segment()), AsWord);
  // A holder that fits the registers with it a pointer holds the pointer and is held as its fields;
  // one wider anyway is a box too, the record's header at the field's word and its words after it.
  let small = record([{ name: b"n", ty: int_type() }, { name: b"s", ty: segment() }]);
  assert(representation_of(s, small) != AsWord, None);
  let holder = record(
    range(0, register_words()).map(|i: Int|
      { name: b"a".concat(Bytes::of_string(i.to_string())), ty: int_type() }).push({
      name: b"s",
      ty: segment(),
    }),
  );
  assert_eq(representation_of(s, holder), AsWord);
  assert(inline_with_header(s.ctors, segment()), None);
  // A case's argument holds it as its box: `Some` of one is a word, its payload the pointer.
  assert_eq(case_parts(s.ctors, option_type(segment()), 1).map(|p: CasePart| p.representation), [
    AsWord,
  ]);
  assert_eq(c_values_of(representation_of(s, option_type(segment()))), [AsWord])
}

test "a field lies at its first word in the box of its record's words" {
  let s = module_context_of(sums());
  assert_eq(field_offsets(s, segment()).get(b"label"), Some(2));
  assert_eq(field_offsets(s, segment()).get(b"to"), Some(3));
  assert_eq(
    field_offsets(s, record([{ name: b"inner", ty: VariableType(0) }])).get(b"inner"),
    None,
  );
  assert_eq(field_type(segment(), b"to"), Some(point()))
}

test "a case's argument starts where the case's arguments, laid as a record, lay it" {
  let s = module_context_of(sums());
  match representation_of(s, result_type(int_type(), point())) {
    AsSum(x) -> {
      // `Ok`'s `Int` and `Err`'s two floats both follow the tag word.
      assert_eq([case_argument_offset(x.layout, 0, 0), case_argument_offset(x.layout, 1, 0)], [
        Some(0),
        Some(0),
      ]);
      assert_eq(case_index(AsSum(x), err_ctor()), Some(1))
    },
    other -> assert_eq(other, AsWord),
  }
}

test "an answer of one word needs no buffer, and a wider one its other words" {
  let sum = |n: Int|
    AsSum({
      layout: {
        classes: range(0, n).map(|_: Int| Pointer),
        cases: [
          {
            test: Always,
            payload: Inline({
              offset: 0,
              layout: PlainWords(range(0, n).map(|_: Int| Pointer)),
              stripped: None,
            }),
          },
        ],
      },
      cases: [b"m.Only"],
    });
  assert_eq([AsInt, AsWord, sum(1), AsUnit].map(return_buffer_words), [0, 0, 0, 0]);
  assert_eq(return_buffer_words(sum(3)), 2);
  assert_eq(
    return_buffer_words(
      AsFlattened([
        { name: b"x", representation: AsFloat },
        { name: b"y", representation: AsFloat },
      ]),
    ),
    1,
  );
  // A decimal past the first value takes two words of the buffer.
  assert_eq(
    return_buffer_words(
      AsFlattened([
        { name: b"n", representation: AsInt },
        { name: b"d", representation: AsDecimal },
      ]),
    ),
    2,
  );
  assert_eq(case_index(sum(1), b"m.Only"), Some(0));
  assert_eq(case_index(sum(1), b"m.Other"), None)
}

test "a record or a sum wider than a call's registers crosses by reference" {
  let flat = |reps: List<Representation>|
    AsFlattened(reps.map(|r: Representation| { name: b"f", representation: r }));
  let n = register_words();
  let ints = |k: Int| range(0, k).map(|_: Int| AsInt);
  assert_eq(passing(flat(ints(n))), InWords);
  assert_eq(passing(flat(ints(n + 1))), ByReference);
  // A decimal takes two words.
  assert_eq(passing(flat(ints(n - 2).push(AsDecimal))), InWords);
  assert_eq(passing(flat(ints(n - 1).push(AsDecimal))), ByReference);
  let sum = |n: Int|
    AsSum({
      layout: {
        classes: range(0, n).map(|_: Int| Mixed),
        cases: [
          {
            test: Always,
            payload: Inline({
              offset: 0,
              layout: PlainWords(range(0, n).map(|_: Int| raw())),
              stripped: None,
            }),
          },
        ],
      },
      cases: [b"m.Only"],
    });
  assert_eq([sum(n), sum(n + 1)].map(passing), [InWords, ByReference]);
  // A record holding a sum holds the sum's words.
  assert_eq(
    value_words(
      AsFlattened([{ name: b"s", representation: sum(3) }, { name: b"n", representation: AsInt }]),
    ),
    4,
  );
  // A scalar is never handed by reference, however wide.
  assert_eq([AsDecimal, AsWord, AsInt, AsUnit].map(passing), [InWords, InWords, InWords, InWords])
}
