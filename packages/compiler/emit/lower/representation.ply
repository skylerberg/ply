import compiler.check.types
import compiler.check.types (named_type, Type, VariableType, NamedType, RecordType, NominalType,
                             Field, int_type, option_type, string_type, float_type, unit_type)
import compiler.check.known (char_type, ordering_type, result_type, width_type, option_name,
                             result_name, ordering_name, none_constructor, some_constructor,
                             ok_constructor, err_constructor, less_constructor, equal_constructor,
                             greater_constructor)
import compiler.emit.representations (SumConstructor, Constructors, kind_of, known_layout,
                                      inside_layout, constructors_of, constructor_fields_at)
import compiler.emit.c (Width, Kind, IntKind, BoolKind, SizedIntKind, FloatKind, DecimalKind,
                        WideKind, in_register)
import compiler.emit.typed_ir (owned_params, Representation, AsInt, AsBool, AsFixed, AsFloat,
                               AsDecimal, AsWideFixed, AsWord, AsFlattened, Leaf, AsSum, AsUnit,
                               AsListView, AsImmediate, Convention, OwnedParam, OwnedResult,
                               parts_of)
import compiler.emit.layout (ValueLayout, SumCases, RecordFields, PlainWords, InlineRecord,
                             FieldLayout, Pointer, Mixed, Always, Inline, Boxed, Nullary, SumLayout,
                             words, max_flat_words, any_integer, has_counted_references)
import compiler.emit.lower.module_context (ModuleContext)

pub fn representation_of(s: ModuleContext, ty: Type) -> Representation =
  representation_with(s.constructors, ty)

pub fn typed_convention(
  constructors: Constructors,
  params: List<Type>,
  result: Type,
) -> Convention =
  {
    params: owned_params(params.map(|t: Type| representation_with(constructors, t))),
    result: representation_with(constructors, result),
    destination_passing: match inside_layout(constructors, result) {
      Some(InlineRecord(_)) -> true,
      _ -> false,
    },
    returned: OwnedResult,
  }

pub fn representation_with(constructors: Constructors, ty: Type) -> Representation =
  match inside_layout(constructors, ty) {
    None -> AsWord,
    Some(l) -> representation_of_layout(constructors, ty, l),
  }

fn representation_of_layout(
  constructors: Constructors,
  ty: Type,
  l: ValueLayout,
) -> Representation =
  if words(l) == 0 { AsUnit } else {
    match l {
      SumCases(x) -> AsSum({ layout: x, cases: case_names(constructors, ty) }),
      RecordFields(fs) -> AsFlattened(record_leaves(constructors, ty, fs)),
      InlineRecord(_) -> AsWord,
      PlainWords(_) -> match scalar_representation(kind_of(ty).kind) {
        AsWord -> if has_counted_references(l) { AsWord } else { AsImmediate },
        r -> r,
      },
    }
  }

pub fn layout_leaves(constructors: Constructors, ty: Type) -> Option<List<Leaf>> =
  match known_layout(constructors, ty) {
    Some(RecordFields(fs)) -> match representation_of_layout(constructors, ty, RecordFields(fs)) {
      AsFlattened(ls) -> Some(ls),
      _ -> None,
    },
    _ -> None,
  }

pub fn flattened_leaves(constructors: Constructors, ty: Type) -> Option<List<Leaf>> =
  match representation_with(constructors, ty) { AsFlattened(ls) -> Some(ls), _ -> None }

pub fn is_inline_record(constructors: Constructors, ty: Type) -> Bool =
  match inside_layout(constructors, ty) { Some(InlineRecord(_)) -> true, _ -> false }

fn case_names(constructors: Constructors, ty: Type) -> List<Bytes> =
  match ty {
    NamedType(c) -> match constructors.sums.get(c.name) {
      Some(cs) -> cs.map(|x: SumConstructor| x.name),
      None -> [],
    },
    _ -> [],
  }

pub fn width_representation(w: Width) -> Representation =
  if in_register(w) { AsFixed(w) } else { AsWideFixed(w) }

fn scalar_representation(k: Kind) -> Representation =
  match k {
    IntKind -> AsInt,
    BoolKind -> AsBool,
    SizedIntKind(w) -> AsFixed(w),
    FloatKind -> AsFloat,
    DecimalKind -> AsDecimal,
    WideKind(w) -> AsWideFixed(w),
    _ -> AsWord,
  }

pub fn record_fields(ty: Type) -> List<Field> =
  match types::record_fields(ty) { Some(fs) -> fs, None -> [] }

pub type RecordPart = { field: Int, name: Bytes, ty: Type, representation: Representation }

pub fn record_parts(constructors: Constructors, ty: Type) -> List<RecordPart> =
  match known_layout(constructors, ty) {
    Some(RecordFields(fs)) -> record_parts_of_layout(constructors, ty, fs),
    _ -> [],
  }

fn record_parts_of_layout(
  constructors: Constructors,
  ty: Type,
  fs: List<FieldLayout>,
) -> List<RecordPart> = {
  let fields = record_fields(ty);
  range(0, fields.len()).fold([], |accumulator: List<RecordPart>, i: Int|
    match ((fields.at(i), fs.at(i))) {
      (Some(f), Some(laid)) -> match representation_of_layout(constructors, f.ty, laid.layout) {
        AsUnit -> accumulator,
        r -> accumulator.push({ field: i, name: f.name, ty: f.ty, representation: r }),
      },
      _ -> accumulator,
    })
}

pub type CasePart = { ty: Type, representation: Representation }

pub fn case_parts(constructors: Constructors, ty: Type, case: Int) -> List<CasePart> =
  match ty {
    NamedType(c) -> match constructors.sums.get(c.name) {
      Some(cs) -> match cs.at(case) {
        Some(k) ->
          constructor_fields_at(k, c.args).map(|t: Type|
            { ty: t, representation: representation_with(constructors, t) }),
        None -> [],
      },
      None -> [],
    },
    _ -> [],
  }

fn record_leaves(constructors: Constructors, ty: Type, fs: List<FieldLayout>) -> List<Leaf> =
  record_parts_of_layout(constructors, ty, fs).fold([], |accumulator: List<Leaf>, p: RecordPart|
    match p.representation {
      AsFlattened(inner) ->
        accumulator.concat(
          inner.map(|l: Leaf|
            { name: Bytes::concat_all([p.name, b".", l.name]), representation: l.representation }),
        ),
      r -> accumulator.push({ name: p.name, representation: r }),
    })

pub fn leaf_span(ls: List<Leaf>, name: Bytes) -> Option<{ at: Int, n: Int }> = {
  let prefix = name.concat(b".");
  range(0, ls.len()).fold(None, |accumulator: Option<{ at: Int, n: Int }>, k: Int|
    match ls.at(k) {
      None -> accumulator,
      Some(l) -> if l.name == name || l.name.starts_with(prefix) {
        match accumulator {
          Some(a) -> Some({ at: a.at, n: a.n + 1 }),
          None -> Some({ at: k, n: 1 }),
        }
      } else { accumulator },
    })
}

pub fn leaf_spans(ls: List<Leaf>) -> Map<Bytes, { at: Int, n: Int }> =
  range(0, ls.len()).fold(Map::new(), |m: Map<Bytes, { at: Int, n: Int }>, k: Int|
    match ls.at(k) {
      None -> m,
      Some(l) -> {
        let field = match l.name.index_of(b".") {
          Some(dot) -> before(l.name, dot),
          None -> l.name,
        };
        m.insert(field, match m.get(field) {
          Some(span) -> { at: span.at, n: span.n + 1 },
          None -> { at: k, n: 1 },
        })
      },
    })

pub fn leaves_within(ls: List<Leaf>, span: { at: Int, n: Int }) -> List<Leaf> =
  ls.drop(span.at).take(span.n).map(|l: Leaf|
    match l.name.index_of(b".") {
      Some(dot) -> { name: after(l.name, dot + 1), representation: l.representation },
      None -> l,
    })

pub fn leaf_values(ls: List<Leaf>, k: Int) -> { at: Int, n: Int } =
  range(0, k + 1).fold({ at: 0, n: 0 }, |accumulator: { at: Int, n: Int }, j: Int| {
    let n = match ls.at(j) { Some(l) -> c_values_of(l.representation).len(), None -> 0 };
    if j == k { { at: accumulator.at, n: n } } else { { at: accumulator.at + n, n: 0 } }
  })

pub fn field_type(ty: Type, name: Bytes) -> Option<Type> =
  record_fields(ty).fold(None, |accumulator: Option<Type>, f: Field|
    if f.name == name { Some(f.ty) } else { accumulator })

pub fn leaf_type(ty: Type, name: Bytes) -> Option<Type> =
  name.split(b".").fold(Some(ty), |at: Option<Type>, f: Bytes|
    match at { Some(t) -> field_type(t, f), None -> None })

pub fn field_types(ty: Type) -> Map<Bytes, Type> =
  record_fields(ty).fold(Map::new(), |m: Map<Bytes, Type>, f: Field| m.insert(f.name, f.ty))

pub fn field_offsets(s: ModuleContext, ty: Type) -> Map<Bytes, Int> =
  match known_layout(s.constructors, ty) {
    Some(RecordFields(ls)) -> {
      let fs = record_fields(ty);
      range(0, fs.len()).fold(Map::new(), |m: Map<Bytes, Int>, i: Int|
        match ((fs.at(i), ls.at(i))) { (Some(f), Some(l)) -> m.insert(f.name, l.at), _ -> m })
    },
    _ -> Map::new(),
  }

pub fn case_index(r: Representation, constructor: Bytes) -> Option<Int> =
  match r {
    AsSum(s) ->
      range(0, s.cases.len()).fold(None, |accumulator: Option<Int>, i: Int|
        if accumulator == None && s.cases.at(i) == Some(constructor) { Some(i) }
        else { accumulator }),
    _ -> None,
  }

pub fn case_argument_offset(s: SumLayout, i: Int, at: Int) -> Option<Int> = {
  let field = |l: ValueLayout|
    match l {
      RecordFields(fs) -> match fs.at(at) { Some(f) -> Some(f.at), None -> None },
      _ -> None,
    };
  match s.cases.at(i) {
    Some(c) -> match c.payload {
      Inline(p) -> field(p.layout),
      Boxed(b) -> field(b.layout),
      Nullary -> None,
    },
    None -> None,
  }
}

pub type Passing = | ByValue | ByReference

pub fn passing(r: Representation) -> Passing =
  match r { AsFlattened(_) -> passing_by_size(r), AsSum(_) -> passing_by_size(r), _ -> ByValue }

fn passing_by_size(r: Representation) -> Passing =
  if value_words(r) > max_flat_words { ByReference } else { ByValue }

pub fn c_values_of(r: Representation) -> List<Representation> =
  match r {
    AsFlattened(ls) ->
      ls.fold([], |accumulator: List<Representation>, l: Leaf|
        accumulator.concat(c_values_of(l.representation))),
    AsSum(s) -> range(0, words(SumCases(s.layout))).map(|_: Int| AsWord),
    AsUnit -> [],
    AsListView -> parts_of(r),
    _ -> [r],
  }

pub fn word_count(vs: List<Representation>) -> Int =
  vs.fold(0, |n: Int, v: Representation|
    n + (match v { AsDecimal -> 2, AsWideFixed(_) -> 2, _ -> 1 }))

pub fn value_words(r: Representation) -> Int = word_count(c_values_of(r))

pub fn return_buffer_words(r: Representation) -> Int = word_count(c_values_of(r).drop(1))

fn after(b: Bytes, at: Int) -> Bytes =
  match b.slice_at(at, b.len() - at) { Some(x) -> x, None -> b"" }

fn before(b: Bytes, at: Int) -> Bytes = match b.slice_at(0, at) { Some(x) -> x, None -> b"" }

fn module_context_of(constructors: Constructors) -> ModuleContext =
  {
    module: b"m",
    definitions: [],
    imports: [],
    constructors: constructors,
    builtins: [],
    declared: Map::new(),
    machine: Map::new(),
    effects: [],
    release_build: false,
  }

fn record(fs: List<{ name: Bytes, ty: Type }>) -> Type = RecordType(fs)

const point: Type = record([{ name: b"x", ty: float_type }, { name: b"y", ty: float_type }])

const point_pair: Type = record([{ name: b"from", ty: point }, { name: b"to", ty: point }])

const large_record: Type =
  record(
    [
      { name: b"from", ty: point },
      { name: b"label", ty: string_type },
      { name: b"to", ty: point },
    ].concat(
      range(0, max_flat_words).map(|i: Int|
        { name: b"z".concat(Bytes::of_string(i.to_string())), ty: int_type }),
    ),
  )

const test_constructors: Constructors = {
  let constructor = |n: Bytes, i: Int, fields: List<Type>, params: List<Int>|
    { name: n, index: i, fields: fields, params: params };
  constructors_of(
    [],
    [],
    [],
    Map::new().insert(option_name, [
      constructor(none_constructor, 0, [], [0]),
      constructor(some_constructor, 1, [VariableType(0)], [0]),
    ]).insert(result_name, [
      constructor(ok_constructor, 0, [VariableType(0)], [0, 1]),
      constructor(err_constructor, 1, [VariableType(1)], [0, 1]),
    ]).insert(ordering_name, [
      constructor(less_constructor, 0, [], []),
      constructor(equal_constructor, 1, [], []),
      constructor(greater_constructor, 2, [], []),
    ]).insert(b"m.Token", [constructor(b"m.Token", 0, [], [])]),
  )
}

test "a scalar is represented as itself, a pointer as one word, and a value with no data as nothing" {
  let s = module_context_of(test_constructors);
  assert_eq(representation_of(s, int_type), AsInt);
  assert_eq(representation_of(s, float_type), AsFloat);
  assert_eq(
    representation_of(s, width_type({ bits: 8, signed: false })),
    AsFixed({ bits: 8, signed: false }),
  );
  assert_eq(
    representation_of(s, width_type({ bits: 128, signed: true })),
    AsWideFixed({ bits: 128, signed: true }),
  );
  assert_eq([string_type, char_type].map(|t: Type| representation_of(s, t)), [AsWord, AsImmediate]);
  assert_eq(
    [unit_type, record([]), record([{ name: b"u", ty: unit_type }]), named_type(b"m.Token")].map(
      |t: Type| representation_of(s, t),
    ),
    [AsUnit, AsUnit, AsUnit, AsUnit],
  );
  assert_eq(representation_of(s, VariableType(0)), AsWord)
}

test "a declared sum is represented by the words of its layout, and a sum with an unresolved type variable as a single word" {
  let s = module_context_of(test_constructors);
  match representation_of(s, option_type(string_type)) {
    AsSum(x) -> {
      assert_eq(x.cases, [b"None", b"Some"]);
      assert_eq(c_values_of(AsSum(x)), [AsWord])
    },
    other -> assert_eq(other, AsWord),
  };
  assert_eq(c_values_of(representation_of(s, option_type(int_type))), [AsWord, AsWord]);
  assert_eq(case_index(representation_of(s, ordering_type), greater_constructor), Some(2));
  assert_eq(representation_of(s, option_type(VariableType(0))), AsWord)
}

test "a record is represented as its leaf fields in order, with nested records contributing their leaves and unit fields contributing none" {
  let s = module_context_of(test_constructors);
  assert_eq(
    representation_of(s, point),
    AsFlattened([{ name: b"x", representation: AsFloat }, { name: b"y", representation: AsFloat }]),
  );
  let leaves = match representation_of(s, point_pair) { AsFlattened(ls) -> ls, _ -> [] };
  assert_eq(leaves.map(|l: Leaf| l.name), [b"from.x", b"from.y", b"to.x", b"to.y"]);
  assert_eq(leaf_span(leaves, b"to"), Some({ at: 2, n: 2 }));
  assert_eq(leaf_span(leaves, b"from"), Some({ at: 0, n: 2 }));
  assert_eq(leaves_within(leaves, { at: 2, n: 2 }).map(|l: Leaf| l.name), [b"x", b"y"]);
  let holder = record([
    { name: b"o", ty: option_type(int_type) },
    { name: b"u", ty: unit_type },
    { name: b"z", ty: int_type },
  ]);
  let hs = match representation_of(s, holder) { AsFlattened(ls) -> ls, _ -> [] };
  assert_eq(hs.map(|l: Leaf| l.name), [b"o", b"z"]);
  assert_eq(c_values_of(AsFlattened(hs)), [AsWord, AsWord, AsInt]);
  assert_eq([leaf_values(hs, 0), leaf_values(hs, 1)], [{ at: 0, n: 2 }, { at: 2, n: 1 }]);
  assert_eq(representation_of(s, record([{ name: b"inner", ty: VariableType(0) }])), AsWord)
}

test "a record too wide for a call's registers is passed as a pointer, stored inline inside a smaller record, and stored as a pointer in a case" {
  let s = module_context_of(test_constructors);
  assert_eq(representation_of(s, large_record), AsWord);
  let small = record([{ name: b"n", ty: int_type }, { name: b"s", ty: large_record }]);
  assert(representation_of(s, small) != AsWord, None);
  let holder = record(
    range(0, max_flat_words).map(|i: Int|
      { name: b"a".concat(Bytes::of_string(i.to_string())), ty: int_type }).push({
      name: b"s",
      ty: large_record,
    }),
  );
  assert_eq(representation_of(s, holder), AsWord);
  assert(is_inline_record(s.constructors, large_record), None);
  assert_eq(
    case_parts(s.constructors, option_type(large_record), 1).map(|p: CasePart| p.representation),
    [AsWord],
  );
  assert_eq(c_values_of(representation_of(s, option_type(large_record))), [AsWord])
}

test "a field's offset is the index of its first word within its boxed record" {
  let s = module_context_of(test_constructors);
  assert_eq(field_offsets(s, large_record).get(b"label"), Some(2));
  assert_eq(field_offsets(s, large_record).get(b"to"), Some(3));
  assert_eq(
    field_offsets(s, record([{ name: b"inner", ty: VariableType(0) }])).get(b"inner"),
    None,
  );
  assert_eq(field_type(large_record, b"to"), Some(point))
}

test "a case's argument offset is where that argument starts when the case's arguments are laid out as a record" {
  let s = module_context_of(test_constructors);
  match representation_of(s, result_type(int_type, point)) {
    AsSum(x) -> {
      assert_eq([case_argument_offset(x.layout, 0, 0), case_argument_offset(x.layout, 1, 0)], [
        Some(0),
        Some(0),
      ]);
      assert_eq(case_index(AsSum(x), err_constructor), Some(1))
    },
    other -> assert_eq(other, AsWord),
  }
}

test "a result of one word needs no return buffer, and a wider result needs buffer words for the words after the first" {
  let sum = |n: Int|
    AsSum({
      layout: {
        classes: range(0, n).map(|_: Int| Pointer),
        cases: [
          {
            test: Always,
            payload: Inline({
              offset: 0,
              layout: PlainWords(range(0, n).map(|_: Int| Pointer)),
              stripped: None,
            }),
          },
        ],
      },
      cases: [b"m.Only"],
    });
  assert_eq([AsInt, AsWord, sum(1), AsUnit].map(return_buffer_words), [0, 0, 0, 0]);
  assert_eq(return_buffer_words(sum(3)), 2);
  assert_eq(
    return_buffer_words(
      AsFlattened([
        { name: b"x", representation: AsFloat },
        { name: b"y", representation: AsFloat },
      ]),
    ),
    1,
  );
  assert_eq(
    return_buffer_words(
      AsFlattened([
        { name: b"n", representation: AsInt },
        { name: b"d", representation: AsDecimal },
      ]),
    ),
    2,
  );
  assert_eq(case_index(sum(1), b"m.Only"), Some(0));
  assert_eq(case_index(sum(1), b"m.Other"), None)
}

test "a record or sum wider than a call's registers is passed by reference" {
  let flat = |reps: List<Representation>|
    AsFlattened(reps.map(|r: Representation| { name: b"f", representation: r }));
  let n = max_flat_words;
  let ints = |k: Int| range(0, k).map(|_: Int| AsInt);
  assert_eq(passing(flat(ints(n))), ByValue);
  assert_eq(passing(flat(ints(n + 1))), ByReference);
  assert_eq(passing(flat(ints(n - 2).push(AsDecimal))), ByValue);
  assert_eq(passing(flat(ints(n - 1).push(AsDecimal))), ByReference);
  let sum = |n: Int|
    AsSum({
      layout: {
        classes: range(0, n).map(|_: Int| Mixed),
        cases: [
          {
            test: Always,
            payload: Inline({
              offset: 0,
              layout: PlainWords(range(0, n).map(|_: Int| any_integer())),
              stripped: None,
            }),
          },
        ],
      },
      cases: [b"m.Only"],
    });
  assert_eq([sum(n), sum(n + 1)].map(passing), [ByValue, ByReference]);
  assert_eq(
    value_words(
      AsFlattened([{ name: b"s", representation: sum(3) }, { name: b"n", representation: AsInt }]),
    ),
    4,
  );
  assert_eq([AsDecimal, AsWord, AsInt, AsUnit].map(passing), [ByValue, ByValue, ByValue, ByValue])
}
