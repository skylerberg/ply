pub fn literal(
  cx: Context,
  st: Lowering,
  l: SourceLiteral,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match l {
    LiteralInt(n) -> { st: st, arg: IntOperand(n) },
    LiteralBool(b) -> { st: st, arg: BoolOperand(b) },
    LiteralFloat(x) -> { st: st, arg: FloatOperand(float_literal_bits(x)) },
    LiteralChar(v) -> { st: st, arg: CharOperand(v) },
    LiteralFixed(name, bits) -> width_literal(cx, st, l, name, bits, at),
    LiteralWide(name, _, low) -> width_literal(cx, st, l, name, low, at),
    LiteralString(_) -> bound(cx, st, string_type(), Literal(l), at),
    LiteralBytes(_) -> bound(cx, st, bytes_type(), Literal(l), at),
    LiteralEmbedded(_, _) -> bound(cx, st, bytes_type(), Literal(l), at),
    LiteralDecimal(_) -> bound(cx, st, decimal_type(), Literal(l), at),
    LiteralUnit -> { st: st, arg: ZeroOperand(AsUnit) },
    LiteralInvalid -> unreachable(b"a literal that does not read"),
  }

fn width_literal(
  cx: Context,
  st: Lowering,
  l: SourceLiteral,
  name: Bytes,
  bits: Int,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match width_named(name) {
    Some(w) -> if w.bits <= 64 { { st: st, arg: FixedOperand({ width: w, bits: bits }) } }
    else { bound(cx, st, named_type(name), Literal(l), at) },
    None -> unreachable(b"a literal of no known width"),
  }

pub fn constant(cx: Context, c: Code) -> Option<Arg> =
  match folded_constant(c) { Some(n) -> Some(IntOperand(n)), None -> None }

pub fn operand(cx: Context, op: Bytes, rhs: Code) -> Option<Arg> =
  match divisor(op, rhs) { Some(d) -> Some(IntOperand(d)), None -> None }

pub fn unary(cx: Context, o: LoweredValue, op: Bytes, at: Span) -> LoweredValue / {abort.raise} =
  if op == b"not" {
    let b = represented_as(o, AsBool, at);
    bound(cx, b.st, named_type(b"Bool"), Primitive({ op: op, on: AsBool, args: [b.arg] }), at)
  } else if op != b"neg" && op != b"bitnot" { unreachable(b"an operator: ".concat(op)) } else {
    let ty = type_of(o.arg);
    if ty == unknown_type() {
      unreachable(b"an operator over an operand of no known type: ".concat(op))
    } else {
      match class_of(cx.setting.ctors, ty) {
        IntOperands -> unary_primitive(cx, o, op, AsInt, ty, at),
        WidthOperands(w) -> unary_primitive(cx, o, op, width_representation(w), ty, at),
        FloatOperands -> if op == b"neg" { unary_primitive(cx, o, op, AsFloat, ty, at) }
        else { fail_missing_operator(o.st, op) },
        DecimalOperands -> if op == b"neg" { unary_primitive(cx, o, op, AsDecimal, ty, at) }
        else { fail_missing_operator(o.st, op) },
        WordOperands(t) ->
          deferred_to_specialisation(
            note_exact_types(o.st, t),
            ty,
            representation_of(cx.setting, ty),
            read_only([o.arg]),
            at,
          ),
        SumOperands(t) -> if op == b"neg" && numeric_sum(cx.setting.ctors, t) {
          stated(cx, o.st, op, [o.arg], [t], t, at)
        } else { fail_missing_operator(o.st, op) },
        _ -> fail_missing_operator(o.st, op),
      }
    }
  }

pub fn binary(
  cx: Context,
  l: LoweredValue,
  r: LoweredValue,
  op: Bytes,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = match l.arg { IntOperand(_) -> type_of(r.arg), _ -> type_of(l.arg) };
  if op == b"concat" { concatenated(cx, r.st, l.arg, r.arg, ty, at) }
  else if !comparison(op) && !arithmetic(op) && !shift(op) && !is_bitwise(op) {
    unreachable(b"an operator: ".concat(op))
  } else if ty == unknown_type() {
    unreachable(b"an operator over operands of no known type: ".concat(op))
  } else if (op == b"eq" || op == b"ne") && representation_of(cx.setting, ty) == AsUnit {
    { st: r.st, arg: BoolOperand(op == b"eq") }
  } else {
    let eq = op == b"eq" || op == b"ne";
    let equal = match class_of(cx.setting.ctors, ty) {
      RecordOperands(fs) -> if eq { Some(fields_equal(cx, r.st, fs, l.arg, r.arg, at)) }
      else { None },
      _ -> None,
    };
    match equal {
      Some(e) -> if op == b"ne" { negation(cx, e, at) } else { e },
      None -> binary_by_class(cx, l, r, op, ty, class_of(cx.setting.ctors, ty), at),
    }
  }
}

fn binary_by_class(
  cx: Context,
  l: LoweredValue,
  r: LoweredValue,
  op: Bytes,
  ty: Type,
  c: OperatorClass,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let eq = op == b"eq" || op == b"ne";
  let truth = bool_type();
  let answer = if comparison(op) { truth } else { ty };
  {
    match c {
      IntOperands -> binary_primitive(cx, l, r, op, AsInt, answer, at),
      WidthOperands(w) -> binary_primitive(cx, l, r, op, width_representation(w), answer, at),
      BoolOperands -> if eq { binary_primitive(cx, l, r, op, AsBool, truth, at) }
      else { fail_missing_operator(r.st, op) },
      FloatOperands -> if comparison(op) || arithmetic(op) {
        binary_primitive(cx, l, r, op, AsFloat, answer, at)
      } else { fail_missing_operator(r.st, op) },
      DecimalOperands -> if comparison(op) || arithmetic(op) {
        binary_primitive(cx, l, r, op, AsDecimal, answer, at)
      } else { fail_missing_operator(r.st, op) },
      CharOperands -> if comparison(op) { binary_primitive(cx, l, r, op, AsImmediate, truth, at) }
      else { fail_missing_operator(r.st, op) },
      TextOperands -> if eq {
        binary_primitive(
          cx,
          l,
          r,
          if op == b"eq" { b"bytes_eq" } else { b"bytes_ne" },
          AsWord,
          truth,
          at,
        )
      } else { fail_missing_operator(r.st, op) },
      NullaryOperands(_) -> if eq {
        match representation_of(cx.setting, ty) {
          AsSum(k) -> binary_primitive(cx, l, r, op, AsSum(k), truth, at),
          _ -> fail_missing_operator(r.st, op),
        }
      } else { compared_by_order(cx, l, r, op, ty, at) },
      SumOperands(t) -> if !eq && numeric_sum(cx.setting.ctors, t) && arithmetic(op) {
        stated(cx, r.st, op, [l.arg, r.arg], [t, t], t, at)
      } else if eq {
        equal_by(
          cx,
          r.st,
          op,
          keys::generated_key(keys::Equal, t, cx.setting.module),
          t,
          [l.arg, r.arg],
          at,
        )
      } else { compared_by_order(cx, l, r, op, ty, at) },
      WalkedOperands(t) -> if eq {
        equal_by(
          cx,
          r.st,
          op,
          keys::generated_key(ContainerWalk(b"equal"), t, cx.setting.module),
          t,
          [l.arg, r.arg],
          at,
        )
      } else { compared_by_order(cx, l, r, op, ty, at) },
      WordOperands(t) -> if eq && is_secret(t) {
        handles_equal(l, r, op, b"builtin_elaborated_secret_equal_p", at)
      } else if eq && t == kept_type() {
        handles_equal(l, r, op, b"builtin_elaborated_kept_equal_p", at)
      } else { compared_by_order(cx, l, r, op, t, at) },
      RecordOperands(_) -> fail_missing_operator(r.st, op),
    }
  }
}

fn is_secret(ty: Type) -> Bool = secret_item(ty) != None

fn is_function(ty: Type) -> Bool = match ty { FunctionType(_) -> true, _ -> false }

fn functions_compared(st: Lowering, at: Span) -> LoweredValue = {
  let failed = bound_as(
    st,
    int_type(),
    AsInt,
    Native({
      name: b"builtin_elaborated_functions_compared_p",
      args: [],
      uses: { takes: [], owned: true, fails: true, suspends: false },
    }),
    at,
  );
  bound_as(
    failed.st,
    bool_type(),
    AsBool,
    Primitive({ op: b"ne", on: AsInt, args: [failed.arg, IntOperand(0)] }),
    at,
  )
}

fn handles_equal(
  l: LoweredValue,
  r: LoweredValue,
  op: Bytes,
  native: Bytes,
  at: Span,
) -> LoweredValue = {
  let a = represented_as({ st: r.st, arg: l.arg }, AsWord, at);
  let b = represented_as({ st: a.st, arg: r.arg }, AsWord, at);
  let same = bound_as(
    b.st,
    int_type(),
    AsInt,
    Native({
      name: native,
      args: [a.arg, b.arg],
      uses: { takes: [false, false], owned: true, fails: true, suspends: false },
    }),
    at,
  );
  bound_as(
    same.st,
    bool_type(),
    AsBool,
    Primitive({
      op: if op == b"eq" { b"ne" } else { b"eq" },
      on: AsInt,
      args: [same.arg, IntOperand(0)],
    }),
    at,
  )
}

fn fields_equal(
  cx: Context,
  st: Lowering,
  fs: List<Field>,
  a: Arg,
  b: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} =
  fields_with_values(cx, fs).fold(
    { out: { st: st, arg: BoolOperand(true) }, first: true },
    |acc: { out: LoweredValue, first: Bool }, f: Field| {
      let x = field(
        cx,
        { st: if acc.first { acc.out.st } else { enter_block(acc.out.st) }, arg: a },
        f.name,
        at,
      );
      let y = field(cx, { st: x.st, arg: b }, f.name, at);
      let xs = { st: y.st, arg: x.arg };
      let e = match f.ty {
        RecordType(gs) -> fields_equal(cx, y.st, gs, x.arg, y.arg, at),
        NominalType(n) -> fields_equal(cx, y.st, n.fields, x.arg, y.arg, at),
        _ -> binary_by_class(cx, xs, y, b"eq", f.ty, class_of(cx.setting.ctors, f.ty), at),
      };
      { out: if acc.first { e } else { short_circuit(cx, acc.out, e, true, at) }, first: false }
    },
  ).out

fn fields_order(
  cx: Context,
  st: Lowering,
  fs: List<Field>,
  a: Arg,
  b: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} =
  fields_with_values(cx, fs).fold(
    { out: { st: st, arg: IntOperand(0) }, first: true },
    |acc: { out: LoweredValue, first: Bool }, f: Field| {
      let x = field(
        cx,
        { st: if acc.first { acc.out.st } else { enter_block(acc.out.st) }, arg: a },
        f.name,
        at,
      );
      let y = field(cx, { st: x.st, arg: b }, f.name, at);
      let s = match f.ty {
        RecordType(gs) -> fields_order(cx, y.st, gs, x.arg, y.arg, at),
        NominalType(n) -> fields_order(cx, y.st, n.fields, x.arg, y.arg, at),
        _ -> order_sign(cx, { st: y.st, arg: x.arg }, y, f.ty, at),
      };
      { out: if acc.first { s } else { first_nonzero_sign(cx, acc.out, s, at) }, first: false }
    },
  ).out

fn fields_with_values(cx: Context, fs: List<Field>) -> List<Field> =
  fs.filter(|f: Field| representation_of(cx.setting, f.ty) != AsUnit)

fn first_nonzero_sign(cx: Context, l: LoweredValue, r: LoweredValue, at: Span) -> LoweredValue = {
  let j = fresh(exit_block(l.st, r.st), int_type(), AsInt);
  let c = bound(
    cx,
    j.st,
    bool_type(),
    Primitive({ op: b"ne", on: AsInt, args: [l.arg, IntOperand(0)] }),
    at,
  );
  let right = set_join(c.st, r, j.var, at);
  {
    st: {
      ..right.st,
      insts: right.st.insts.push(Decl(j.var)).push(
        If({ cond: c.arg, then: [Assign({ var: j.var, arg: l.arg })], otherwise: right.block }),
      ),
    },
    arg: VarOperand(j.var),
  }
}

pub fn scalar_builtin_call(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args.at(0) {
    None -> unreachable(b"a builtin of no argument: ".concat(name)),
    Some(a) -> {
      let b = match args.at(1) { Some(x) -> x, None -> IntOperand(0) };
      if args.len() != arity(name) {
        unreachable(b"a builtin called with other than its arguments: ".concat(name))
      } else if name == b"compare" || name == b"compare_values" { ordered(cx, st, name, a, b, at) }
      else if name == b"min" || name == b"max" { min_or_max(cx, st, name == b"max", a, b, at) }
      else if name == b"reflect" || name == b"shown" { reflected(cx, st, name, a, at) }
      else if name == b"?encoded" || name == b"digest" { encoded(cx, st, name == b"digest", a, at) }
      else if name == b"?same" {
        let x = represented_as({ st: st, arg: a }, AsWord, at);
        let y = represented_as({ st: x.st, arg: b }, AsWord, at);
        bound(cx, y.st, bool_type(), Primitive({ op: b"eq", on: AsWord, args: [x.arg, y.arg] }), at)
      } else if name == b"Float::of_int" || name == b"Float::of_bits" {
        let x = represented_as({ st: st, arg: a }, AsInt, at);
        bound(
          cx,
          x.st,
          float_type(),
          Primitive({
            op: if name == b"Float::of_int" { b"to_float" } else { b"of_bits" },
            on: AsInt,
            args: [x.arg],
          }),
          at,
        )
      } else if name == b"bits_of_float" {
        let x = represented_as({ st: st, arg: a }, AsFloat, at);
        bound(cx, x.st, int_type(), Primitive({ op: b"bits", on: AsFloat, args: [x.arg] }), at)
      } else if float_function(name) != None { float_called(st, name, args, at) }
      else if float_exact(name) != None { float_computed(cx, st, name, a, at) }
      else if decimal_conversion(name) { decimal_converted(cx, st, name, a, at) }
      else if wrapping(name) || saturating(name) || name.starts_with(b"checked_") {
        width_arithmetic(cx, st, name, args, at)
      } else if name == b"to_int" { to_int_call(cx, st, args, at) }
      else if name == b"?numeric_binary" || name == b"?numeric_unary" {
        witnessed_operator(cx, st, name, args, at)
      } else if name == b"?stated_witness" { witness_value(cx, st, a, at) } else {
        match of_int_width(name) {
          Some(w) -> {
            let x = represented_as({ st: st, arg: a }, AsInt, at);
            bound(
              cx,
              x.st,
              width_type(w),
              Primitive({ op: b"of_int", on: AsInt, args: [x.arg] }),
              at,
            )
          },
          None -> match int_of_width(name) {
            Some(w) -> {
              let x = represented_as({ st: st, arg: a }, width_representation(w), at);
              bound(
                cx,
                x.st,
                int_type(),
                Primitive({ op: b"to_int", on: width_representation(w), args: [x.arg] }),
                at,
              )
            },
            None -> unreachable(b"a builtin no scalar's: ".concat(name)),
          },
        }
      }
    },
  }

pub fn decimal_conversion(name: Bytes) -> Bool =
  name == b"Decimal::of_int" || name == b"Decimal::scale"

fn decimal_converted(
  cx: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} =
  if name == b"Decimal::of_int" {
    let x = represented_as({ st: st, arg: a }, AsInt, at);
    bound(cx, x.st, decimal_type(), Primitive({ op: b"to_decimal", on: AsInt, args: [x.arg] }), at)
  } else {
    let d = represented_as({ st: st, arg: a }, AsDecimal, at);
    bound(cx, d.st, int_type(), Primitive({ op: b"scale", on: AsDecimal, args: [d.arg] }), at)
  }

fn builtin_return_type(cx: Context, name: Bytes, ty: Type, known: Type) -> Type =
  match declared_call_types(cx.setting, name, [ty]) { Some(t) -> t.ret, None -> known }

fn witness_value(cx: Context, st: Lowering, a: Arg, at: Span) -> LoweredValue / {abort.raise} =
  match read_literal(st, a) {
    None -> unreachable(b"a stated witness named by no literal"),
    Some(s) -> if !cx.setting.ctors.named.contains(s.name) {
      unreachable(b"a stated witness of a type no constructor names")
    } else {
      let tag = bound(cx, s.st, int_type(), Tag(s.name), at);
      bound(cx, tag.st, int_type(), Primitive({ op: b"witness", on: AsInt, args: [tag.arg] }), at)
    },
  }

fn read_literal(st: Lowering, a: Arg) -> Option<{ st: Lowering, name: Bytes }> =
  match a {
    VarOperand(v) -> match st.insts.at(st.insts.len() - 1) {
      Some(Let(l)) -> if l.var.id != v.id { None } else {
        match l.val {
          Literal(LiteralString(n)) ->
            Some({ st: { ..st, insts: st.insts.take(st.insts.len() - 1) }, name: n }),
          _ -> None,
        }
      },
      _ -> None,
    },
    _ -> None,
  }

pub fn numeric_in_place(ctors: Ctors, ty: Type) -> Bool =
  match class_of(ctors, ty) {
    IntOperands -> true,
    FloatOperands -> true,
    DecimalOperands -> true,
    WidthOperands(_) -> true,
    _ -> false,
  }

pub fn numeric_converted(
  cx: Context,
  st: Lowering,
  n: Arg,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let x = represented_as({ st: st, arg: n }, AsInt, at);
  let converted = |op: Bytes|
    bound(cx, x.st, ty, Primitive({ op: op, on: AsInt, args: [x.arg] }), at);
  match class_of(cx.setting.ctors, ty) {
    FloatOperands -> converted(b"to_float"),
    DecimalOperands -> converted(b"to_decimal"),
    WidthOperands(_) -> converted(b"of_int"),
    _ -> x,
  }
}

type OperatorClass =
  | IntOperands
  | BoolOperands
  | WidthOperands(Width)
  | FloatOperands
  | DecimalOperands
  | CharOperands
  | TextOperands
  | NullaryOperands(Type)
  | SumOperands(Type)
  | WalkedOperands(Type)
  | RecordOperands(List<Field>)
  | WordOperands(Type)

pub fn comparison_built(ctors: Ctors, t: Type, order: Bool) -> Bool / {abort.raise} =
  iterate({ todo: [t], seen: [] }, 1 << 24, |s: { todo: List<Type>, seen: List<Bytes> }|
    match s.todo {
      [] -> Stop(true),
      [x, ..rest] -> match x {
        FunctionType(_) -> if order { Stop(false) } else { Continue({ ..s, todo: rest }) },
        _ -> match class_of(ctors, x) {
          RecordOperands(fs) -> Continue({ ..s, todo: rest.concat(fs.map(|f: Field| f.ty)) }),
          WalkedOperands(w) -> Continue({ ..s, todo: rest.concat(type_args(w)) }),
          SumOperands(w) -> match w {
            NamedType(c) -> if s.seen.contains(c.name) || keyed_sum(ctors, c.name) {
              Continue({ ..s, todo: rest })
            } else {
              let cs = match ctors.sums.get(c.name) { Some(found) -> found, None -> [] };
              Continue({
                todo: rest.concat(
                  cs.fold([], |acc: List<Type>, k: SumCtor|
                    acc.concat(k.fields.map(|f: Type| at_args(f, k.params, c.args)))),
                ),
                seen: s.seen.push(c.name),
              })
            },
            _ -> Continue({ ..s, todo: rest }),
          },
          WordOperands(w) -> if w == kept_type() || w == unit_type() || w == RecordType([])
              || (!order && is_secret(w)) { Continue({ ..s, todo: rest }) }
          else { Stop(false) },
          _ -> Continue({ ..s, todo: rest }),
        },
      },
    })

fn type_args(t: Type) -> List<Type> = match t { NamedType(c) -> c.args, _ -> [] }

fn class_of(ctors: Ctors, ty: Type) -> OperatorClass =
  match ty {
    RecordType(fs) -> if fs.len() > 0 && !has_vars(ty) { RecordOperands(fs) }
    else { WordOperands(ty) },
    NominalType(x) -> if x.fields.len() > 0 && !has_vars(ty) { RecordOperands(x.fields) }
    else { WordOperands(ty) },
    NamedType(c) -> if c.args.len() > 0 {
      if is_walked_container(ty) || is_walked_columns(ty) || is_result(ty)
          || (is_option(ty) && !has_vars(ty)) { WalkedOperands(ty) }
      else if generic_sum(ctors, ty) { SumOperands(ty) }
      else { WordOperands(ty) }
    } else if is_int(ty) { IntOperands }
    else if is_bool(ty) { BoolOperands }
    else if is_float(ty) { FloatOperands }
    else if is_decimal(ty) { DecimalOperands }
    else if is_char(ty) { CharOperands }
    else if is_string(ty) || is_bytes(ty) { TextOperands } else if compared_by_root(ctors, c.name) {
      if nullary_sum(match ctors.sums.get(c.name) { Some(cs) -> cs, None -> [] })
          && !keyed_sum(ctors, c.name)
          && !numeric_sum(ctors, ty) { NullaryOperands(ty) }
      else { SumOperands(ty) }
    } else { match width_named(c.name) { Some(w) -> WidthOperands(w), None -> WordOperands(ty) } },
    _ -> WordOperands(ty),
  }

fn unary_primitive(
  cx: Context,
  o: LoweredValue,
  op: Bytes,
  on: Representation,
  ty: Type,
  at: Span,
) -> LoweredValue = {
  let a = represented_as(o, on, at);
  bound(cx, a.st, ty, Primitive({ op: op, on: on, args: [a.arg] }), at)
}

fn binary_primitive(
  cx: Context,
  l: LoweredValue,
  r: LoweredValue,
  op: Bytes,
  on: Representation,
  answer: Type,
  at: Span,
) -> LoweredValue = {
  let a = represented_as({ st: r.st, arg: l.arg }, on, at);
  let b = if has_count_operand(op) { { st: a.st, arg: r.arg } }
  else { represented_as({ st: a.st, arg: r.arg }, on, at) };
  bound(cx, b.st, answer, Primitive({ op: op, on: on, args: [a.arg, b.arg] }), at)
}

fn equal_by(
  cx: Context,
  st: Lowering,
  op: Bytes,
  key: RootKey,
  ty: Type,
  args: List<Arg>,
  at: Span,
) -> LoweredValue = {
  let e = root_call(cx, st, key, args, [ty, ty], bool_type(), at);
  if op == b"ne" { negation(cx, e, at) } else { e }
}

pub fn stated(
  cx: Context,
  st: Lowering,
  op: Bytes,
  args: List<Arg>,
  types: List<Type>,
  ty: Type,
  at: Span,
) -> LoweredValue =
  root_call(
    cx,
    st,
    keys::generated_key(NumericFunction(op), ty, cx.setting.module),
    args,
    types,
    ty,
    at,
  )

fn compared_by_order(
  cx: Context,
  l: LoweredValue,
  r: LoweredValue,
  op: Bytes,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match if comparison(op) { root_order(cx, r.st, ty, l.arg, r.arg, at) } else { None } {
    None -> if op != b"eq" && op != b"ne" { fail_missing_operator(r.st, op) }
    else if is_function(ty) { functions_compared(r.st, at) } else {
      let truth = bool_type();
      deferred_to_specialisation(
        note_exact_types(r.st, ty),
        truth,
        representation_of(cx.setting, truth),
        read_only([l.arg, r.arg]),
        at,
      )
    },
    Some(o) -> {
      let s = bound(
        cx,
        o.st,
        int_type(),
        Primitive({ op: b"sign", on: operand_representation(o.arg), args: [o.arg] }),
        at,
      );
      bound(
        cx,
        s.st,
        bool_type(),
        Primitive({ op: op, on: AsInt, args: [s.arg, IntOperand(0)] }),
        at,
      )
    },
  }

fn root_call(
  cx: Context,
  st: Lowering,
  key: RootKey,
  args: List<Arg>,
  types: List<Type>,
  answer: Type,
  at: Span,
) -> LoweredValue = root_call_with_words(cx, st, key, args, types, answer, at, false)

fn root_call_with_words(
  cx: Context,
  st: Lowering,
  key: RootKey,
  args: List<Arg>,
  types: List<Type>,
  answer: Type,
  at: Span,
  stops: Bool,
  words: { count: Int, args: List<Arg> } = { count: 0, args: [] },
) -> LoweredValue = {
  let conv = with_evidence_parameters(
    typed_convention(cx.setting.ctors, types, answer),
    0,
    words.count,
  );
  let given = range(0, args.len()).fold(
    { st: st, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, i: Int|
      match ((args.at(i), types.at(i))) {
        (Some(x), Some(t)) -> {
          let h = represented_as({ st: acc.st, arg: x }, representation_of(cx.setting, t), at);
          { st: h.st, args: acc.args.push(h.arg) }
        },
        _ -> acc,
      },
  );
  bound_as(
    given.st,
    answer,
    conv.result,
    Call({
      callee: Root(key),
      args: given.args.concat(words.args),
      convention: conv,
      suspends: stops,
    }),
    at,
  )
}

fn negation(cx: Context, b: LoweredValue, at: Span) -> LoweredValue =
  bound(cx, b.st, bool_type(), Primitive({ op: b"not", on: AsBool, args: [b.arg] }), at)

fn ordered(
  cx: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  b: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = match a { IntOperand(_) -> type_of(b), _ -> type_of(a) };
  let order = builtin_return_type(cx, name, ty, ordering_type());
  let made = |s: LoweredValue|
    bound(cx, s.st, order, Primitive({ op: b"ordering", on: AsInt, args: [s.arg] }), at);
  if has_unknown_part(ty) { open_at(cx, st, ty, [a, b], order, at) } else {
    match root_order(cx, st, ty, a, b, at) {
      Some(o) -> o,
      None -> match class_of(cx.setting.ctors, ty) {
        RecordOperands(fs) -> made(fields_order(cx, st, fs, a, b, at)),
        _ -> made(order_sign(cx, { st: st, arg: a }, { st: st, arg: b }, ty, at)),
      },
    }
  }
}

fn open_at(
  cx: Context,
  st: Lowering,
  ty: Type,
  args: List<Arg>,
  answer: Type,
  at: Span,
) -> LoweredValue =
  deferred_to_specialisation(
    note_exact_types(st, ty),
    answer,
    representation_of(cx.setting, answer),
    read_only(args),
    at,
  )

fn kept_sign(st: Lowering, a: Arg, b: Arg, at: Span) -> LoweredValue = {
  let l = represented_as({ st: st, arg: a }, AsWord, at);
  let r = represented_as({ st: l.st, arg: b }, AsWord, at);
  bound_as(
    r.st,
    int_type(),
    AsInt,
    Native({
      name: b"builtin_elaborated_kept_order_p",
      args: [l.arg, r.arg],
      uses: { takes: [false, false], owned: true, fails: true, suspends: false },
    }),
    at,
  )
}

fn min_or_max(
  cx: Context,
  st: Lowering,
  most: Bool,
  a: Arg,
  b: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = match a { IntOperand(_) -> type_of(b), _ -> type_of(a) };
  let s = match class_of(cx.setting.ctors, ty) {
    RecordOperands(fs) -> fields_order(cx, st, fs, b, a, at),
    _ -> order_sign(cx, { st: st, arg: b }, { st: st, arg: a }, ty, at),
  };
  let past = bound(
    cx,
    s.st,
    bool_type(),
    Primitive({ op: if most { b"gt" } else { b"lt" }, on: AsInt, args: [s.arg, IntOperand(0)] }),
    at,
  );
  joined(
    cx,
    past,
    { st: enter_block(past.st), arg: b },
    { st: enter_block(past.st), arg: a },
    false,
    at,
  )
}

fn root_order(
  cx: Context,
  st: Lowering,
  ty: Type,
  a: Arg,
  b: Arg,
  at: Span,
) -> Option<LoweredValue> = {
  let order = ordering_type();
  let at_root = |op: TypeOp, t: Type|
    Some(
      root_call(cx, st, keys::generated_key(op, t, cx.setting.module), [a, b], [t, t], order, at),
    );
  match class_of(cx.setting.ctors, ty) {
    NullaryOperands(t) -> at_root(Order, t),
    SumOperands(t) -> at_root(Order, t),
    WalkedOperands(t) -> at_root(ContainerWalk(b"ordered"), t),
    WordOperands(t) -> if is_option(t) && !has_vars(t) { at_root(ContainerWalk(b"ordered"), t) }
    else { None },
    _ -> None,
  }
}

fn order_sign(
  cx: Context,
  l: LoweredValue,
  r: LoweredValue,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let int = int_type();
  let signed = |o: LoweredValue|
    bound(
      cx,
      o.st,
      int,
      Primitive({ op: b"sign", on: operand_representation(o.arg), args: [o.arg] }),
      at,
    );
  if has_unknown_part(ty) { signed(open_at(cx, r.st, ty, [l.arg, r.arg], ordering_type(), at)) }
  else {
    match root_order(cx, r.st, ty, l.arg, r.arg, at) {
      Some(o) -> signed(o),
      None -> match class_of(cx.setting.ctors, ty) {
        IntOperands -> binary_primitive(cx, l, r, b"order", AsInt, int, at),
        BoolOperands -> binary_primitive(cx, l, r, b"order", AsBool, int, at),
        CharOperands -> binary_primitive(cx, l, r, b"order", AsImmediate, int, at),
        WidthOperands(w) -> binary_primitive(cx, l, r, b"order", width_representation(w), int, at),
        DecimalOperands -> binary_primitive(cx, l, r, b"order", AsDecimal, int, at),
        TextOperands -> binary_primitive(cx, l, r, b"bytes_order", AsWord, int, at),
        FloatOperands -> {
          let x = total_key(cx, { st: r.st, arg: l.arg }, at);
          let y = total_key(cx, { st: x.st, arg: r.arg }, at);
          bound(cx, y.st, int, Primitive({ op: b"order", on: AsInt, args: [x.arg, y.arg] }), at)
        },
        _ -> if representation_of(cx.setting, ty) == AsUnit { { st: r.st, arg: IntOperand(0) } }
        else if ty == kept_type() { kept_sign(r.st, l.arg, r.arg, at) }
        else { unreachable(b"an order of a type none is derived for: ".concat(encode_type(ty))) },
      },
    }
  }
}

fn total_key(cx: Context, f: LoweredValue, at: Span) -> LoweredValue = {
  let int = int_type();
  let x = represented_as(f, AsFloat, at);
  let bits = bound(cx, x.st, int, Primitive({ op: b"bits", on: AsFloat, args: [x.arg] }), at);
  let sign = bound(
    cx,
    bits.st,
    int,
    Primitive({ op: b"shr", on: AsInt, args: [bits.arg, IntOperand(63)] }),
    at,
  );
  let flips = bound(
    cx,
    sign.st,
    int,
    Primitive({ op: b"ushr", on: AsInt, args: [sign.arg, IntOperand(1)] }),
    at,
  );
  bound(cx, flips.st, int, Primitive({ op: b"bitxor", on: AsInt, args: [bits.arg, flips.arg] }), at)
}

fn reflected(
  cx: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = type_of(a);
  let value_type = named_type(b"std.value.Value");
  let op = if name == b"shown" { Show } else { Reflect };
  let value = |ctor: Bytes| constructed_as(cx, st, ctor, [a], value_type, at);
  let unary_primitive = |ctor: Bytes| constructed_as(cx, st, ctor, [], value_type, at);
  let none = || unreachable(b"a reflection of a value none describes: ".concat(encode_type(ty)));
  if !cx.setting.ctors.named.contains(b"std.value.VUnit") {
    unreachable(b"a reflection in a program that holds no `std.value`")
  } else {
    match ty {
      FunctionType(_) -> {
        let f = constructed_as(
          cx,
          st,
          b"std.value.FAnonymous",
          [],
          named_type(b"std.value.Fun"),
          at,
        );
        constructed_as(cx, f.st, b"std.value.VFn", [f.arg], value_type, at)
      },
      NamedType(c) -> if c.name == hold_name() { unary_primitive(b"std.value.VHold") }
      else if c.name == secret_name() { unary_primitive(b"std.value.VSecret") }
      else if has_unknown_part(ty) { open_at(cx, st, ty, [a], value_type, at) }
      else if written_sum(cx.setting.ctors, c) || is_walked_container(ty) || is_walked_columns(ty) {
        type_operation_call(cx, st, op, ty, a, at)
      } else if c.args.len() > 0 { none() }
      else if is_int(ty) { value(b"std.value.VInt") }
      else if is_bool(ty) { value(b"std.value.VBool") }
      else if is_float(ty) { value(b"std.value.VFloat") }
      else if is_decimal(ty) { value(b"std.value.VDecimal") }
      else if is_char(ty) { value(b"std.value.VChar") }
      else if is_string(ty) { value(b"std.value.VStr") }
      else if is_bytes(ty) { value(b"std.value.VBytes") }
      else if is_unit(ty) { unary_primitive(b"std.value.VUnit") } else {
        match width_named(c.name) {
          Some(w) -> width_reflected(cx, st, c.name, w, a, value_type, at),
          None -> none(),
        }
      },
      _ -> if has_unknown_part(ty) { open_at(cx, st, ty, [a], value_type, at) }
      else { type_operation_call(cx, st, op, ty, a, at) },
    }
  }
}

fn width_reflected(
  cx: Context,
  st: Lowering,
  name: Bytes,
  w: Width,
  a: Arg,
  value_type: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let int = int_type();
  let u128 = width_type({ bits: 128, signed: false });
  let made = |s: Lowering, lo: Arg, hi: Arg|
    bound(cx, s, u128, Primitive({ op: b"wide", on: AsInt, args: [lo, hi] }), at);
  let wide = if w.bits > 64 {
    let p = pair_words(st, a, AsWideFixed(w), at);
    made(p.st, p.lo, p.hi)
  } else if w.bits == 64 {
    let x = unary_primitive(cx, { st: st, arg: a }, b"narrow", AsFixed(w), int, at);
    made(x.st, x.arg, IntOperand(0))
  } else {
    let x = unary_primitive(cx, { st: st, arg: a }, b"to_int", AsFixed(w), int, at);
    let bits = if !w.signed { x } else {
      bound(
        cx,
        x.st,
        int,
        Primitive({ op: b"bitand", on: AsInt, args: [x.arg, IntOperand((1 << w.bits) - 1)] }),
        at,
      )
    };
    made(bits.st, bits.arg, IntOperand(0))
  };
  let spelled = literal(cx, wide.st, LiteralString(name), at);
  constructed_as(cx, spelled.st, b"std.value.VFixed", [spelled.arg, wide.arg], value_type, at)
}

fn encoded(
  cx: Context,
  st: Lowering,
  hashed: Bool,
  a: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = type_of(a);
  let bytes = builtin_return_type(
    cx,
    if hashed { b"digest" } else { b"?encoded" },
    ty,
    bytes_type(),
  );
  let rooted_by = match ty {
    NamedType(c) ->
      written_sum(cx.setting.ctors, c) || is_walked_container(ty) || is_walked_columns(ty),
    RecordType(_) -> true,
    NominalType(_) -> true,
    _ -> false,
  };
  if has_unknown_part(ty) { open_at(cx, st, ty, [a], bytes, at) } else {
    match if rooted_by { Some(type_operation_call(cx, st, Digest, ty, a, at)) }
      else { scalar_encoding(cx, st, a, ty, at) } {
      Some(e) -> if hashed { blake3_of(e.st, e.arg, at) } else { e },
      None -> unreachable(b"a digest of a type none is derived for: ".concat(encode_type(ty))),
    }
  }
}

fn type_operation_call(
  cx: Context,
  st: Lowering,
  op: TypeOp,
  ty: Type,
  a: Arg,
  at: Span,
) -> LoweredValue =
  root_call(
    cx,
    st,
    keys::generated_key(op, ty, cx.setting.module),
    [a],
    [ty],
    match op { Digest -> bytes_type(), _ -> named_type(b"std.value.Value") },
    at,
  )

pub fn let_go(cx: Context, st: Lowering, a: Arg, at: Span) -> LoweredValue / {abort.raise} = {
  let ty = type_of(a);
  if has_vars(ty) {
    deferred_to_specialisation(
      note_exact_types(st, ty),
      unit_type(),
      representation_of(cx.setting, unit_type()),
      read_only([a]),
      at,
    )
  } else {
    let h = let_go_evidence(cx, ty);
    let w = passed_evidence_arguments(st, h, at);
    let words = { count: h.words.len(), args: w.args };
    root_call_with_words(cx, w.st, let_go_root(cx, ty), [a], [ty], unit_type(), at, true, words)
  }
}

pub fn unwound(
  cx: Context,
  st: Lowering,
  a: Arg,
  at: Span,
) -> { st: Lowering, unwound: Unwinding } / {abort.raise} = {
  let ty = type_of(a);
  let h = let_go_evidence(cx, ty);
  let w = passed_evidence_arguments(note_exact_types(st, ty), h, at);
  {
    st: w.st,
    unwound: {
      arg: a,
      words: w.args,
      callee: let_go_root(cx, ty),
      convention: with_evidence_parameters(
        typed_convention(cx.setting.ctors, [ty], unit_type()),
        0,
        h.words.len(),
      ),
    },
  }
}

fn let_go_root(cx: Context, ty: Type) -> RootKey =
  keys::generated_key(ReleaseResource, ty, cx.setting.module)

fn let_go_evidence(cx: Context, ty: Type) -> EvidenceArguments / {abort.raise} =
  scheme_evidence_arguments(
    cx,
    Some(monomorphic(fn_type([ty], unit_type(), release_row(cx.setting.ctors, ty)))),
    [],
    [],
  )

fn width_arithmetic(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let a = match args.at(0) { Some(x) -> x, None -> IntOperand(0) };
  let b = match args.at(1) { Some(x) -> x, None -> IntOperand(0) };
  let ty = match a { IntOperand(_) -> type_of(b), _ -> type_of(a) };
  let checked = name.starts_with(b"checked_");
  let answer = builtin_return_type(cx, name, ty, if checked { option_type(ty) } else { ty });
  match class_of(cx.setting.ctors, ty) {
    WidthOperands(w) -> if w.bits > 64 {
      if checked {
        checked_in_place(
          cx,
          st,
          name,
          a,
          b,
          { ty: ty, held: AsWideFixed(w), on: AsWideFixed(w) },
          answer,
          at,
        )
      } else {
        binary_primitive(cx, { st: st, arg: a }, { st: st, arg: b }, name, AsWideFixed(w), ty, at)
      }
    } else if wrapping(name) || (saturating(name) && w.bits == 64) {
      binary_primitive(cx, { st: st, arg: a }, { st: st, arg: b }, name, AsFixed(w), ty, at)
    } else if w.bits == 64 {
      checked_in_place(cx, st, name, a, b, { ty: ty, held: AsFixed(w), on: AsFixed(w) }, answer, at)
    } else if checked { checked_width(cx, st, name, a, b, w, answer, at) }
    else { binary_primitive(cx, { st: st, arg: a }, { st: st, arg: b }, name, AsFixed(w), ty, at) },
    IntOperands -> if wrapping(name) || saturating(name) {
      let x = represented_as({ st: st, arg: a }, AsInt, at);
      let y = if has_count_operand(name) { { st: x.st, arg: b } }
      else { represented_as({ st: x.st, arg: b }, AsInt, at) };
      bound(
        cx,
        y.st,
        ty,
        Primitive({ op: name, on: AsFixed({ bits: 64, signed: true }), args: [x.arg, y.arg] }),
        at,
      )
    } else {
      let word = AsFixed({ bits: 64, signed: true });
      checked_in_place(cx, st, name, a, b, { ty: ty, held: AsInt, on: word }, answer, at)
    },
    _ -> unreachable(b"an integer's builtin at a type that is no integer: ".concat(name)),
  }
}

fn to_int_call(
  cx: Context,
  st: Lowering,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args {
    [_, x] -> {
      let ty = type_of(x);
      let int = int_type();
      let option = builtin_return_type(cx, b"to_int", ty, option_type(int));
      let some = |l: LoweredValue| constructed_as(cx, l.st, some_ctor(), [l.arg], option, at);
      match class_of(cx.setting.ctors, ty) {
        IntOperands -> some(represented_as({ st: st, arg: x }, AsInt, at)),
        WidthOperands(w) -> if w.bits < 64 || (w.bits == 64 && w.signed) {
          some(unary_primitive(cx, { st: st, arg: x }, b"to_int", AsFixed(w), int, at))
        } else {
          let h = represented_as({ st: st, arg: x }, width_representation(w), at);
          let fits = bound(
            cx,
            h.st,
            bool_type(),
            if w.bits == 64 {
              Primitive({
                op: b"le",
                on: AsFixed(w),
                args: [h.arg, FixedOperand({ width: w, bits: 9223372036854775807 })],
              })
            } else { Primitive({ op: b"fits_int", on: AsWideFixed(w), args: [h.arg] }) },
            at,
          );
          let value = bound(
            cx,
            enter_block(fits.st),
            int,
            Primitive({
              op: if w.bits == 64 { b"narrow" } else { b"lo" },
              on: width_representation(w),
              args: [h.arg],
            }),
            at,
          );
          some_if(cx, fits, value, option, at)
        },
        _ -> if has_vars(ty) {
          left_to_callers(cx, st, b"to_int", args, { params: args.map(type_of), ret: option }, at)
        } else { unreachable(b"`to_int` at a type that is no integer") },
      }
    },
    _ -> unreachable(b"`to_int` called other than with a witness and a value"),
  }

fn witnessed_operator(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let scalar = |t: Type|
    match t { VariableType(v) -> noted(st, { var: v, reads: Scalar }), _ -> st };
  match args {
    [IntOperand(k), _, x, y] -> match numeric_operators().at(k) {
      None -> unreachable(b"an operator over a witness numbered as none is"),
      Some(op) -> {
        let ty = match x { IntOperand(_) -> type_of(y), _ -> type_of(x) };
        if !has_vars(ty) { binary(cx, { st: st, arg: x }, { st: st, arg: y }, op, at) } else {
          left_to_callers(
            cx,
            scalar(ty),
            name,
            args,
            { params: args.map(type_of), ret: if comparison(op) { bool_type() } else { ty } },
            at,
          )
        }
      },
    },
    [IntOperand(k), _, x] -> if !has_vars(type_of(x)) {
      unary(cx, { st: st, arg: x }, if k == 1 { b"bitnot" } else { b"neg" }, at)
    } else {
      left_to_callers(
        cx,
        scalar(type_of(x)),
        name,
        args,
        { params: args.map(type_of), ret: type_of(x) },
        at,
      )
    },
    _ -> unreachable(b"an operator over a witness written other than as the elaboration writes it"),
  }
}

fn checked_width(
  cx: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  b: Arg,
  w: Width,
  option: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = width_type(w);
  let neg = name == b"checked_neg";
  let unsigned = !w.signed && name == b"checked_mul";
  let word = { bits: 64, signed: false };
  let x = represented_as({ st: st, arg: a }, AsFixed(w), at);
  let y = if neg { x } else { represented_as({ st: x.st, arg: b }, AsFixed(w), at) };
  let exact = bound(
    cx,
    y.st,
    if unsigned { width_type(word) } else { int_type() },
    Primitive({
      op: if neg { b"exact_neg" }
      else if name == b"checked_add" { b"exact_add" }
      else if name == b"checked_sub" { b"exact_sub" }
      else { b"exact_mul" },
      on: AsFixed(w),
      args: if neg { [x.arg] } else { [x.arg, y.arg] },
    }),
    at,
  );
  let fits = bound(
    cx,
    exact.st,
    bool_type(),
    if unsigned {
      Primitive({
        op: b"le",
        on: AsFixed(word),
        args: [exact.arg, FixedOperand({ width: word, bits: most(w) })],
      })
    } else {
      Primitive({
        op: b"within",
        on: AsInt,
        args: [exact.arg, IntOperand(least(w)), IntOperand(most(w))],
      })
    },
    at,
  );
  let narrowed = bound(
    cx,
    enter_block(fits.st),
    ty,
    Primitive({ op: b"narrow", on: operand_representation(exact.arg), args: [exact.arg] }),
    at,
  );
  some_if(cx, fits, narrowed, option, at)
}

fn checked_in_place(
  cx: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  b: Arg,
  k: { ty: Type, held: Representation, on: Representation },
  option: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let neg = name == b"checked_neg";
  let x = represented_as({ st: st, arg: a }, k.held, at);
  let y = if neg { x } else { represented_as({ st: x.st, arg: b }, k.held, at) };
  let fits = bound(
    cx,
    y.st,
    bool_type(),
    Primitive({ op: name, on: k.on, args: if neg { [x.arg] } else { [x.arg, y.arg] } }),
    at,
  );
  let wrapped = bound(
    cx,
    enter_block(fits.st),
    k.ty,
    Primitive({
      op: if neg || name == b"checked_sub" { b"wrap_sub" }
      else if name == b"checked_add" { b"wrap_add" }
      else { b"wrap_mul" },
      on: k.on,
      args: if neg { [ZeroOperand(k.held), x.arg] } else { [x.arg, y.arg] },
    }),
    at,
  );
  some_if(cx, fits, wrapped, option, at)
}

fn some_if(
  cx: Context,
  fits: LoweredValue,
  value: LoweredValue,
  option: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let some = constructed_as(cx, value.st, some_ctor(), [value.arg], option, at);
  let none = constructed_as(
    cx,
    exit_block(enter_block(fits.st), some.st),
    none_ctor(),
    [],
    option,
    at,
  );
  let j = fresh(exit_block(fits.st, none.st), option, representation_of(cx.setting, option));
  let t = set_join(j.st, some, j.var, at);
  let e = set_join(t.st, none, j.var, at);
  {
    st: {
      ..e.st,
      insts: fits.st.insts.push(Decl(j.var)).push(
        If({ cond: fits.arg, then: t.block, otherwise: e.block }),
      ),
    },
    arg: VarOperand(j.var),
  }
}

fn least(w: Width) -> Int = if w.signed { 0 - (1 << w.bits - 1) } else { 0 }

fn most(w: Width) -> Int = if w.signed { (1 << w.bits - 1) - 1 } else { (1 << w.bits) - 1 }

fn fail_missing_operator(st: Lowering, op: Bytes) -> LoweredValue / {abort.raise} =
  unreachable(b"an operator its operands' type does not have: ".concat(op))

fn note_exact_types(st: Lowering, ty: Type) -> Lowering =
  match ty {
    VariableType(v) -> if v < 0 { st } else { noted(st, { var: v, reads: Exact }) },
    _ -> type_vars(ty).fold(st, |s: Lowering, v: Int| noted(s, { var: v, reads: Exact })),
  }

fn has_count_operand(op: Bytes) -> Bool = shift(op) || op == b"rotl" || op == b"rotr"

fn wrapping(name: Bytes) -> Bool =
  name == b"wrap_add" || name == b"wrap_sub" || name == b"wrap_mul" || name == b"rotr"
    || name == b"rotl"

fn saturating(name: Bytes) -> Bool =
  name == b"saturating_add" || name == b"saturating_sub" || name == b"saturating_mul"

fn arity(name: Bytes) -> Int =
  if name == b"compare" || name == b"compare_values" || name == b"?same" || name == b"min"
      || name == b"max"
      || wrapping(name)
      || saturating(name)
      || (name.starts_with(b"checked_") && name != b"checked_neg") { 2 }
  else if name == b"to_int" { 2 }
  else if name == b"?numeric_binary" { 4 }
  else if name == b"?numeric_unary" { 3 }
  else { match float_function(name) { Some(f) -> f.operands, None -> 1 } }

fn float_computed(
  cx: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match float_exact(name) {
    None -> unreachable(b"no exact Float function: ".concat(name)),
    Some(op) -> {
      let x = represented_as({ st: st, arg: a }, AsFloat, at);
      bound(cx, x.st, float_type(), Primitive({ op: op, on: AsFloat, args: [x.arg] }), at)
    },
  }

fn float_called(
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match float_function(name) {
    None -> unreachable(b"no Float function: ".concat(name)),
    Some(f) -> float_native_called(st, f, args, at),
  }

fn float_native_called(
  st: Lowering,
  f: FloatFunction,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let given = args.fold({ st: st, bits: [] }, |acc: { st: Lowering, bits: List<Arg> }, a: Arg| {
    let x = represented_as({ st: acc.st, arg: a }, AsFloat, at);
    let b = bound_as(
      x.st,
      int_type(),
      AsInt,
      Primitive({ op: b"bits", on: AsFloat, args: [x.arg] }),
      at,
    );
    { st: b.st, bits: acc.bits.push(b.arg) }
  });
  let answered = bound_as(
    given.st,
    int_type(),
    AsInt,
    Native({
      name: builtin_helper(f.native).concat(b"_p"),
      args: given.bits,
      uses: { takes: given.bits.map(|_: Arg| false), owned: true, fails: false, suspends: false },
    }),
    at,
  );
  bound_as(
    answered.st,
    float_type(),
    AsFloat,
    Primitive({ op: b"of_bits", on: AsInt, args: [answered.arg] }),
    at,
  )
}

fn divisor(op: Bytes, rhs: Code) -> Option<Int> =
  if op != b"div" && op != b"rem" { None } else {
    match rhs.node {
      CodeUnary(u) -> if u.op != b"neg" { None } else {
        match u.operand.node {
          CodeLiteral(l) -> match l {
            LiteralInt(v) -> if v == 0 || v == 1 { None } else { Some(0 - v) },
            _ -> None,
          },
          _ -> None,
        }
      },
      _ -> None,
    }
  }

fn width_called(
  name: Bytes,
  named: ({ name: Bytes, bits: Int, signed: Bool }) -> Bytes,
) -> Option<Width> =
  fixed_widths().find_map(|w: { name: Bytes, bits: Int, signed: Bool }|
    if name == named(w) { Some({ bits: w.bits, signed: w.signed }) } else { None })

fn of_int_width(name: Bytes) -> Option<Width> =
  width_called(name, |w: { name: Bytes, bits: Int, signed: Bool }| w.name.concat(b"::of_int"))

fn int_of_width(name: Bytes) -> Option<Width> =
  width_called(name, |w: { name: Bytes, bits: Int, signed: Bool }|
    Bytes::concat_all([b"Int::of_", if w.signed { b"i" } else { b"u" }, ascii_of_int(w.bits)]))

fn is_option(t: Type) -> Bool = option_item(t) != None

pub fn is_walked_container(t: Type) -> Bool =
  !has_vars(t) && (list_item(t) != None || array_element(t) != None || map_parts(t) != None)

pub fn is_walked_columns(t: Type) -> Bool = !has_vars(t) && columns_row(t) != None

fn is_result(t: Type) -> Bool = !has_vars(t) && result_parts(t) != None
