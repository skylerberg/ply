pub fn literal(
  context: Context,
  st: Lowering,
  l: SourceLiteral,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match l {
    LiteralInt(n) -> { st: st, arg: IntOperand(n) },
    LiteralBool(b) -> { st: st, arg: BoolOperand(b) },
    LiteralFloat(x) -> { st: st, arg: FloatOperand(float_literal_bits(x)) },
    LiteralChar(v) -> { st: st, arg: CharOperand(v) },
    LiteralFixed(name, bits) -> width_literal(context, st, l, name, bits, at),
    LiteralWide(name, _, low) -> width_literal(context, st, l, name, low, at),
    LiteralString(_) -> bound(context, st, string_type(), Literal(l), at),
    LiteralBytes(_) -> bound(context, st, bytes_type(), Literal(l), at),
    LiteralEmbedded(_, _) -> bound(context, st, bytes_type(), Literal(l), at),
    LiteralDecimal(_) -> bound(context, st, decimal_type(), Literal(l), at),
    LiteralUnit -> { st: st, arg: ZeroOperand(AsUnit) },
    LiteralInvalid -> unreachable(b"a literal that does not read"),
  }

fn width_literal(
  context: Context,
  st: Lowering,
  l: SourceLiteral,
  name: Bytes,
  bits: Int,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match width_named(name) {
    Some(w) -> if w.bits <= 64 { { st: st, arg: FixedOperand({ width: w, bits: bits }) } }
    else { bound(context, st, named_type(name), Literal(l), at) },
    None -> unreachable(b"a literal of no known width"),
  }

pub fn constant(context: Context, c: Code) -> Option<Arg> =
  match folded_constant(c) { Some(n) -> Some(IntOperand(n)), None -> None }

pub fn operand(context: Context, op: Bytes, rhs: Code) -> Option<Arg> =
  match divisor(op, rhs) { Some(d) -> Some(IntOperand(d)), None -> None }

pub fn unary(
  context: Context,
  o: LoweredValue,
  op: Bytes,
  at: Span,
) -> LoweredValue / {abort.raise} =
  if op == b"not" {
    let b = represented_as(o, AsBool, at);
    bound(context, b.st, named_type(b"Bool"), Primitive({ op: op, on: AsBool, args: [b.arg] }), at)
  } else if op != b"neg" && op != b"bitnot" { unreachable(b"an operator: ".concat(op)) } else {
    let ty = type_of(o.arg);
    if ty == unknown_type() {
      unreachable(b"an operator over an operand of no known type: ".concat(op))
    } else {
      match class_of(context.setting.constructors, ty) {
        IntOperands -> unary_primitive(context, o, op, AsInt, ty, at),
        WidthOperands(w) -> unary_primitive(context, o, op, width_representation(w), ty, at),
        FloatOperands -> if op == b"neg" { unary_primitive(context, o, op, AsFloat, ty, at) }
        else { fail_missing_operator(o.st, op) },
        DecimalOperands -> if op == b"neg" { unary_primitive(context, o, op, AsDecimal, ty, at) }
        else { fail_missing_operator(o.st, op) },
        WordOperands(t) ->
          deferred_to_specialisation(
            note_exact_types(o.st, t),
            ty,
            representation_of(context.setting, ty),
            read_only([o.arg]),
            at,
          ),
        SumOperands(t) -> if op == b"neg" && numeric_sum(context.setting.constructors, t) {
          numeric_function_call(context, o.st, op, [o.arg], [t], t, at)
        } else { fail_missing_operator(o.st, op) },
        _ -> fail_missing_operator(o.st, op),
      }
    }
  }

pub fn binary(
  context: Context,
  l: LoweredValue,
  r: LoweredValue,
  op: Bytes,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = match l.arg { IntOperand(_) -> type_of(r.arg), _ -> type_of(l.arg) };
  if op == b"concat" { concatenated(context, r.st, l.arg, r.arg, ty, at) }
  else if !comparison(op) && !is_arithmetic(op) && !shift(op) && !is_bitwise(op) {
    unreachable(b"an operator: ".concat(op))
  } else if ty == unknown_type() {
    unreachable(b"an operator over operands of no known type: ".concat(op))
  } else if (op == b"eq" || op == b"ne") && representation_of(context.setting, ty) == AsUnit {
    { st: r.st, arg: BoolOperand(op == b"eq") }
  } else {
    let eq = op == b"eq" || op == b"ne";
    let equal = match class_of(context.setting.constructors, ty) {
      RecordOperands(fs) -> if eq { Some(fields_equal(context, r.st, fs, l.arg, r.arg, at)) }
      else { None },
      _ -> None,
    };
    match equal {
      Some(e) -> if op == b"ne" { negation(context, e, at) } else { e },
      None ->
        binary_by_class(context, l, r, op, ty, class_of(context.setting.constructors, ty), at),
    }
  }
}

fn binary_by_class(
  context: Context,
  l: LoweredValue,
  r: LoweredValue,
  op: Bytes,
  ty: Type,
  c: OperatorClass,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let eq = op == b"eq" || op == b"ne";
  let truth = bool_type();
  let result = if comparison(op) { truth } else { ty };
  {
    match c {
      IntOperands -> binary_primitive(context, l, r, op, AsInt, result, at),
      WidthOperands(w) -> binary_primitive(context, l, r, op, width_representation(w), result, at),
      BoolOperands -> if eq { binary_primitive(context, l, r, op, AsBool, truth, at) }
      else { fail_missing_operator(r.st, op) },
      FloatOperands -> if comparison(op) || is_arithmetic(op) {
        binary_primitive(context, l, r, op, AsFloat, result, at)
      } else { fail_missing_operator(r.st, op) },
      DecimalOperands -> if comparison(op) || is_arithmetic(op) {
        binary_primitive(context, l, r, op, AsDecimal, result, at)
      } else { fail_missing_operator(r.st, op) },
      CharOperands -> if comparison(op) {
        binary_primitive(context, l, r, op, AsImmediate, truth, at)
      } else { fail_missing_operator(r.st, op) },
      TextOperands -> if eq {
        binary_primitive(
          context,
          l,
          r,
          if op == b"eq" { b"bytes_eq" } else { b"bytes_ne" },
          AsWord,
          truth,
          at,
        )
      } else { fail_missing_operator(r.st, op) },
      NullaryOperands(_) -> if eq {
        match representation_of(context.setting, ty) {
          AsSum(k) -> binary_primitive(context, l, r, op, AsSum(k), truth, at),
          _ -> fail_missing_operator(r.st, op),
        }
      } else { compared_by_order(context, l, r, op, ty, at) },
      SumOperands(t) -> if !eq && numeric_sum(context.setting.constructors, t)
          && is_arithmetic(op) {
        numeric_function_call(context, r.st, op, [l.arg, r.arg], [t, t], t, at)
      } else if eq {
        equal_by(
          context,
          r.st,
          op,
          keys::generated_key(keys::Equal, t, context.setting.module),
          t,
          [l.arg, r.arg],
          at,
        )
      } else { compared_by_order(context, l, r, op, ty, at) },
      ContainerOperands(t) -> if eq {
        equal_by(
          context,
          r.st,
          op,
          keys::generated_key(ContainerWalk(b"equal"), t, context.setting.module),
          t,
          [l.arg, r.arg],
          at,
        )
      } else { compared_by_order(context, l, r, op, ty, at) },
      WordOperands(t) -> if eq && is_secret(t) {
        handles_equal(l, r, op, b"builtin_elaborated_secret_equal_p", at)
      } else if eq && t == kept_type() {
        handles_equal(l, r, op, b"builtin_elaborated_kept_equal_p", at)
      } else { compared_by_order(context, l, r, op, t, at) },
      RecordOperands(_) -> fail_missing_operator(r.st, op),
    }
  }
}

fn is_secret(ty: Type) -> Bool = secret_item(ty) != None

fn is_function(ty: Type) -> Bool = match ty { FunctionType(_) -> true, _ -> false }

fn functions_compared(st: Lowering, at: Span) -> LoweredValue = {
  let failed = bound_as(
    st,
    int_type(),
    AsInt,
    Native({
      name: b"ply_functions_compared",
      args: [],
      uses: { takes: [], owned: true, fails: true, suspends: false },
    }),
    at,
  );
  bound_as(
    failed.st,
    bool_type(),
    AsBool,
    Primitive({ op: b"ne", on: AsInt, args: [failed.arg, IntOperand(0)] }),
    at,
  )
}

fn handles_equal(
  l: LoweredValue,
  r: LoweredValue,
  op: Bytes,
  native: Bytes,
  at: Span,
) -> LoweredValue = {
  let a = represented_as({ st: r.st, arg: l.arg }, AsWord, at);
  let b = represented_as({ st: a.st, arg: r.arg }, AsWord, at);
  let same = bound_as(
    b.st,
    int_type(),
    AsInt,
    Native({
      name: native,
      args: [a.arg, b.arg],
      uses: { takes: [false, false], owned: true, fails: true, suspends: false },
    }),
    at,
  );
  bound_as(
    same.st,
    bool_type(),
    AsBool,
    Primitive({
      op: if op == b"eq" { b"ne" } else { b"eq" },
      on: AsInt,
      args: [same.arg, IntOperand(0)],
    }),
    at,
  )
}

fn fields_equal(
  context: Context,
  st: Lowering,
  fs: List<Field>,
  a: Arg,
  b: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} =
  fields_with_values(context, fs).fold(
    { out: { st: st, arg: BoolOperand(true) }, first: true },
    |acc: { out: LoweredValue, first: Bool }, f: Field| {
      let x = field(
        context,
        { st: if acc.first { acc.out.st } else { enter_block(acc.out.st) }, arg: a },
        f.name,
        at,
      );
      let y = field(context, { st: x.st, arg: b }, f.name, at);
      let xs = { st: y.st, arg: x.arg };
      let e = match f.ty {
        RecordType(gs) -> fields_equal(context, y.st, gs, x.arg, y.arg, at),
        NominalType(n) -> fields_equal(context, y.st, n.fields, x.arg, y.arg, at),
        _ ->
          binary_by_class(
            context,
            xs,
            y,
            b"eq",
            f.ty,
            class_of(context.setting.constructors, f.ty),
            at,
          ),
      };
      {
        out: if acc.first { e } else { short_circuit(context, acc.out, e, true, at) },
        first: false,
      }
    },
  ).out

fn fields_order(
  context: Context,
  st: Lowering,
  fs: List<Field>,
  a: Arg,
  b: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} =
  fields_with_values(context, fs).fold(
    { out: { st: st, arg: IntOperand(0) }, first: true },
    |acc: { out: LoweredValue, first: Bool }, f: Field| {
      let x = field(
        context,
        { st: if acc.first { acc.out.st } else { enter_block(acc.out.st) }, arg: a },
        f.name,
        at,
      );
      let y = field(context, { st: x.st, arg: b }, f.name, at);
      let s = match f.ty {
        RecordType(gs) -> fields_order(context, y.st, gs, x.arg, y.arg, at),
        NominalType(n) -> fields_order(context, y.st, n.fields, x.arg, y.arg, at),
        _ -> order_sign(context, { st: y.st, arg: x.arg }, y, f.ty, at),
      };
      { out: if acc.first { s } else { first_nonzero_sign(context, acc.out, s, at) }, first: false }
    },
  ).out

fn fields_with_values(context: Context, fs: List<Field>) -> List<Field> =
  fs.filter(|f: Field| representation_of(context.setting, f.ty) != AsUnit)

fn first_nonzero_sign(
  context: Context,
  l: LoweredValue,
  r: LoweredValue,
  at: Span,
) -> LoweredValue = {
  let j = fresh(exit_block(l.st, r.st), int_type(), AsInt);
  let c = bound(
    context,
    j.st,
    bool_type(),
    Primitive({ op: b"ne", on: AsInt, args: [l.arg, IntOperand(0)] }),
    at,
  );
  let right = set_join(c.st, r, j.var, at);
  {
    st: {
      ..right.st,
      insts: right.st.insts.push(Declaration(j.var)).push(
        If({ cond: c.arg, then: [Assign({ var: j.var, arg: l.arg })], otherwise: right.block }),
      ),
    },
    arg: VarOperand(j.var),
  }
}

pub fn scalar_builtin_call(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args.at(0) {
    None -> unreachable(b"a builtin of no argument: ".concat(name)),
    Some(a) -> {
      let b = match args.at(1) { Some(x) -> x, None -> IntOperand(0) };
      if args.len() != arity(name) {
        unreachable(b"a builtin called with other than its arguments: ".concat(name))
      } else if name == b"compare" || name == b"compare_values" {
        ordered(context, st, name, a, b, at)
      } else if name == b"min" || name == b"max" {
        min_or_max(context, st, name == b"max", a, b, at)
      } else if name == b"reflect" || name == b"shown" {
        reflect_to_value(context, st, name, a, at)
      } else if name == b"?encoded" || name == b"digest" {
        encoded(context, st, name == b"digest", a, at)
      } else if name == b"?same" {
        let x = represented_as({ st: st, arg: a }, AsWord, at);
        let y = represented_as({ st: x.st, arg: b }, AsWord, at);
        bound(
          context,
          y.st,
          bool_type(),
          Primitive({ op: b"eq", on: AsWord, args: [x.arg, y.arg] }),
          at,
        )
      } else if name == b"Float::of_int" || name == b"Float::of_bits" {
        let x = represented_as({ st: st, arg: a }, AsInt, at);
        bound(
          context,
          x.st,
          float_type(),
          Primitive({
            op: if name == b"Float::of_int" { b"to_float" } else { b"of_bits" },
            on: AsInt,
            args: [x.arg],
          }),
          at,
        )
      } else if name == b"bits_of_float" {
        let x = represented_as({ st: st, arg: a }, AsFloat, at);
        bound(context, x.st, int_type(), Primitive({ op: b"bits", on: AsFloat, args: [x.arg] }), at)
      } else if float_function(name) != None { float_called(st, name, args, at) }
      else if float_exact(name) != None { float_computed(context, st, name, a, at) }
      else if is_decimal_conversion(name) { decimal_converted(context, st, name, a, at) }
      else if wrapping(name) || is_saturating_operation(name) || name.starts_with(b"checked_") {
        width_arithmetic(context, st, name, args, at)
      } else if name == b"to_int" { to_int_call(context, st, args, at) }
      else if name == b"?numeric_binary" || name == b"?numeric_unary" {
        indexed_numeric_operator(context, st, name, args, at)
      } else if name == b"?stated_witness" { witness_value(context, st, a, at) } else {
        match of_int_width(name) {
          Some(w) -> {
            let x = represented_as({ st: st, arg: a }, AsInt, at);
            bound(
              context,
              x.st,
              width_type(w),
              Primitive({ op: b"of_int", on: AsInt, args: [x.arg] }),
              at,
            )
          },
          None -> match int_of_width(name) {
            Some(w) -> {
              let x = represented_as({ st: st, arg: a }, width_representation(w), at);
              bound(
                context,
                x.st,
                int_type(),
                Primitive({ op: b"to_int", on: width_representation(w), args: [x.arg] }),
                at,
              )
            },
            None -> unreachable(b"a builtin no scalar's: ".concat(name)),
          },
        }
      }
    },
  }

pub fn is_decimal_conversion(name: Bytes) -> Bool =
  name == b"Decimal::of_int" || name == b"Decimal::scale"

fn decimal_converted(
  context: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  at: Span,
) -> LoweredValue =
  if name == b"Decimal::of_int" {
    let x = represented_as({ st: st, arg: a }, AsInt, at);
    bound(
      context,
      x.st,
      decimal_type(),
      Primitive({ op: b"to_decimal", on: AsInt, args: [x.arg] }),
      at,
    )
  } else {
    let d = represented_as({ st: st, arg: a }, AsDecimal, at);
    bound(context, d.st, int_type(), Primitive({ op: b"scale", on: AsDecimal, args: [d.arg] }), at)
  }

fn builtin_return_type(context: Context, name: Bytes, ty: Type, known: Type) -> Type =
  match declared_call_types(context.setting, name, [ty]) { Some(t) -> t.ret, None -> known }

fn witness_value(context: Context, st: Lowering, a: Arg, at: Span) -> LoweredValue / {abort.raise} =
  match read_literal(st, a) {
    None -> unreachable(b"a stated witness named by no literal"),
    Some(s) -> if !context.setting.constructors.named.contains(s.name) {
      unreachable(b"a stated witness of a type no constructor names")
    } else {
      let tag = bound(context, s.st, int_type(), Tag(s.name), at);
      bound(
        context,
        tag.st,
        int_type(),
        Primitive({ op: b"witness", on: AsInt, args: [tag.arg] }),
        at,
      )
    },
  }

fn read_literal(st: Lowering, a: Arg) -> Option<{ st: Lowering, name: Bytes }> =
  match a {
    VarOperand(v) -> match st.insts.at(st.insts.len() - 1) {
      Some(Let(l)) -> if l.var.id != v.id { None } else {
        match l.value {
          Literal(LiteralString(n)) ->
            Some({ st: { ..st, insts: st.insts.take(st.insts.len() - 1) }, name: n }),
          _ -> None,
        }
      },
      _ -> None,
    },
    _ -> None,
  }

pub fn numeric_in_place(constructors: Constructors, ty: Type) -> Bool =
  match class_of(constructors, ty) {
    IntOperands -> true,
    FloatOperands -> true,
    DecimalOperands -> true,
    WidthOperands(_) -> true,
    _ -> false,
  }

pub fn numeric_converted(
  context: Context,
  st: Lowering,
  n: Arg,
  ty: Type,
  at: Span,
) -> LoweredValue = {
  let x = represented_as({ st: st, arg: n }, AsInt, at);
  let converted = |op: Bytes|
    bound(context, x.st, ty, Primitive({ op: op, on: AsInt, args: [x.arg] }), at);
  match class_of(context.setting.constructors, ty) {
    FloatOperands -> converted(b"to_float"),
    DecimalOperands -> converted(b"to_decimal"),
    WidthOperands(_) -> converted(b"of_int"),
    _ -> x,
  }
}

type OperatorClass =
  | IntOperands
  | BoolOperands
  | WidthOperands(Width)
  | FloatOperands
  | DecimalOperands
  | CharOperands
  | TextOperands
  | NullaryOperands(Type)
  | SumOperands(Type)
  | ContainerOperands(Type)
  | RecordOperands(List<Field>)
  | WordOperands(Type)

pub fn comparison_built(constructors: Constructors, t: Type, order: Bool) -> Bool / {abort.raise} =
  iterate({ todo: [t], seen: [] }, 1 << 24, |s: { todo: List<Type>, seen: List<Bytes> }|
    match s.todo {
      [] -> Stop(true),
      [x, ..rest] -> match x {
        FunctionType(_) -> if order { Stop(false) } else { Continue({ ..s, todo: rest }) },
        _ -> match class_of(constructors, x) {
          RecordOperands(fs) -> Continue({ ..s, todo: rest.concat(fs.map(|f: Field| f.ty)) }),
          ContainerOperands(w) -> Continue({ ..s, todo: rest.concat(type_args(w)) }),
          SumOperands(w) -> match w {
            NamedType(c) -> if s.seen.contains(c.name) || keyed_sum(constructors, c.name) {
              Continue({ ..s, todo: rest })
            } else {
              let cs = match constructors.sums.get(c.name) { Some(found) -> found, None -> [] };
              Continue({
                todo: rest.concat(
                  cs.fold([], |acc: List<Type>, k: SumConstructor|
                    acc.concat(k.fields.map(|f: Type| at_args(f, k.params, c.args)))),
                ),
                seen: s.seen.push(c.name),
              })
            },
            _ -> Continue({ ..s, todo: rest }),
          },
          WordOperands(w) -> if w == kept_type() || w == unit_type() || w == RecordType([])
              || (!order && is_secret(w)) { Continue({ ..s, todo: rest }) }
          else { Stop(false) },
          _ -> Continue({ ..s, todo: rest }),
        },
      },
    })

fn type_args(t: Type) -> List<Type> = match t { NamedType(c) -> c.args, _ -> [] }

fn class_of(constructors: Constructors, ty: Type) -> OperatorClass =
  match ty {
    RecordType(fs) -> if fs.len() > 0 && !has_variables(ty) { RecordOperands(fs) }
    else { WordOperands(ty) },
    NominalType(x) -> if x.fields.len() > 0 && !has_variables(ty) { RecordOperands(x.fields) }
    else { WordOperands(ty) },
    NamedType(c) -> if c.args.len() > 0 {
      if is_walked_container(ty) || is_columns_type(ty) || is_result(ty)
          || (is_option(ty) && !has_variables(ty)) { ContainerOperands(ty) }
      else if generic_sum(constructors, ty) { SumOperands(ty) }
      else { WordOperands(ty) }
    } else if is_int(ty) { IntOperands }
    else if is_bool(ty) { BoolOperands }
    else if is_float(ty) { FloatOperands }
    else if is_decimal(ty) { DecimalOperands }
    else if is_char(ty) { CharOperands }
    else if is_string(ty) || is_bytes(ty) { TextOperands }
    else if compared_by_root(constructors, c.name) {
      if nullary_sum(match constructors.sums.get(c.name) { Some(cs) -> cs, None -> [] })
          && !keyed_sum(constructors, c.name)
          && !numeric_sum(constructors, ty) { NullaryOperands(ty) }
      else { SumOperands(ty) }
    } else { match width_named(c.name) { Some(w) -> WidthOperands(w), None -> WordOperands(ty) } },
    _ -> WordOperands(ty),
  }

fn unary_primitive(
  context: Context,
  o: LoweredValue,
  op: Bytes,
  on: Representation,
  ty: Type,
  at: Span,
) -> LoweredValue = {
  let a = represented_as(o, on, at);
  bound(context, a.st, ty, Primitive({ op: op, on: on, args: [a.arg] }), at)
}

fn binary_primitive(
  context: Context,
  l: LoweredValue,
  r: LoweredValue,
  op: Bytes,
  on: Representation,
  result: Type,
  at: Span,
) -> LoweredValue = {
  let a = represented_as({ st: r.st, arg: l.arg }, on, at);
  let b = if has_count_operand(op) { { st: a.st, arg: r.arg } }
  else { represented_as({ st: a.st, arg: r.arg }, on, at) };
  bound(context, b.st, result, Primitive({ op: op, on: on, args: [a.arg, b.arg] }), at)
}

fn equal_by(
  context: Context,
  st: Lowering,
  op: Bytes,
  key: RootKey,
  ty: Type,
  args: List<Arg>,
  at: Span,
) -> LoweredValue = {
  let e = root_call(context, st, key, args, [ty, ty], bool_type(), at);
  if op == b"ne" { negation(context, e, at) } else { e }
}

pub fn numeric_function_call(
  context: Context,
  st: Lowering,
  op: Bytes,
  args: List<Arg>,
  types: List<Type>,
  ty: Type,
  at: Span,
) -> LoweredValue =
  root_call(
    context,
    st,
    keys::generated_key(NumericFunction(op), ty, context.setting.module),
    args,
    types,
    ty,
    at,
  )

fn compared_by_order(
  context: Context,
  l: LoweredValue,
  r: LoweredValue,
  op: Bytes,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match if comparison(op) { root_order(context, r.st, ty, l.arg, r.arg, at) } else { None } {
    None -> if op != b"eq" && op != b"ne" { fail_missing_operator(r.st, op) }
    else if is_function(ty) { functions_compared(r.st, at) } else {
      let truth = bool_type();
      deferred_to_specialisation(
        note_exact_types(r.st, ty),
        truth,
        representation_of(context.setting, truth),
        read_only([l.arg, r.arg]),
        at,
      )
    },
    Some(o) -> {
      let s = bound(
        context,
        o.st,
        int_type(),
        Primitive({ op: b"sign", on: operand_representation(o.arg), args: [o.arg] }),
        at,
      );
      bound(
        context,
        s.st,
        bool_type(),
        Primitive({ op: op, on: AsInt, args: [s.arg, IntOperand(0)] }),
        at,
      )
    },
  }

fn root_call(
  context: Context,
  st: Lowering,
  key: RootKey,
  args: List<Arg>,
  types: List<Type>,
  result: Type,
  at: Span,
) -> LoweredValue = root_call_with_words(context, st, key, args, types, result, at, false)

fn root_call_with_words(
  context: Context,
  st: Lowering,
  key: RootKey,
  args: List<Arg>,
  types: List<Type>,
  result: Type,
  at: Span,
  stops: Bool,
  words: { count: Int, args: List<Arg> } = { count: 0, args: [] },
) -> LoweredValue = {
  let conv = with_evidence_parameters(
    typed_convention(context.setting.constructors, types, result),
    0,
    words.count,
  );
  let given = range(0, args.len()).fold(
    { st: st, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, i: Int|
      match ((args.at(i), types.at(i))) {
        (Some(x), Some(t)) -> {
          let h = represented_as({ st: acc.st, arg: x }, representation_of(context.setting, t), at);
          { st: h.st, args: acc.args.push(h.arg) }
        },
        _ -> acc,
      },
  );
  bound_as(
    given.st,
    result,
    conv.result,
    Call({
      callee: Root(key),
      args: given.args.concat(words.args),
      convention: conv,
      suspends: stops,
    }),
    at,
  )
}

fn negation(context: Context, b: LoweredValue, at: Span) -> LoweredValue =
  bound(context, b.st, bool_type(), Primitive({ op: b"not", on: AsBool, args: [b.arg] }), at)

fn ordered(
  context: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  b: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = match a { IntOperand(_) -> type_of(b), _ -> type_of(a) };
  let order = builtin_return_type(context, name, ty, ordering_type());
  let made = |s: LoweredValue|
    bound(context, s.st, order, Primitive({ op: b"ordering", on: AsInt, args: [s.arg] }), at);
  if has_unknown_part(ty) { open_at(context, st, ty, [a, b], order, at) } else {
    match root_order(context, st, ty, a, b, at) {
      Some(o) -> o,
      None -> match class_of(context.setting.constructors, ty) {
        RecordOperands(fs) -> made(fields_order(context, st, fs, a, b, at)),
        _ -> made(order_sign(context, { st: st, arg: a }, { st: st, arg: b }, ty, at)),
      },
    }
  }
}

fn open_at(
  context: Context,
  st: Lowering,
  ty: Type,
  args: List<Arg>,
  result: Type,
  at: Span,
) -> LoweredValue =
  deferred_to_specialisation(
    note_exact_types(st, ty),
    result,
    representation_of(context.setting, result),
    read_only(args),
    at,
  )

fn kept_order(st: Lowering, a: Arg, b: Arg, at: Span) -> LoweredValue = {
  let l = represented_as({ st: st, arg: a }, AsWord, at);
  let r = represented_as({ st: l.st, arg: b }, AsWord, at);
  bound_as(
    r.st,
    int_type(),
    AsInt,
    Native({
      name: b"builtin_elaborated_kept_order_p",
      args: [l.arg, r.arg],
      uses: { takes: [false, false], owned: true, fails: true, suspends: false },
    }),
    at,
  )
}

fn min_or_max(
  context: Context,
  st: Lowering,
  most: Bool,
  a: Arg,
  b: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = match a { IntOperand(_) -> type_of(b), _ -> type_of(a) };
  let s = match class_of(context.setting.constructors, ty) {
    RecordOperands(fs) -> fields_order(context, st, fs, b, a, at),
    _ -> order_sign(context, { st: st, arg: b }, { st: st, arg: a }, ty, at),
  };
  let past = bound(
    context,
    s.st,
    bool_type(),
    Primitive({ op: if most { b"gt" } else { b"lt" }, on: AsInt, args: [s.arg, IntOperand(0)] }),
    at,
  );
  joined(
    context,
    past,
    { st: enter_block(past.st), arg: b },
    { st: enter_block(past.st), arg: a },
    false,
    at,
  )
}

fn root_order(
  context: Context,
  st: Lowering,
  ty: Type,
  a: Arg,
  b: Arg,
  at: Span,
) -> Option<LoweredValue> = {
  let order = ordering_type();
  let at_root = |op: TypeOp, t: Type|
    Some(
      root_call(
        context,
        st,
        keys::generated_key(op, t, context.setting.module),
        [a, b],
        [t, t],
        order,
        at,
      ),
    );
  match class_of(context.setting.constructors, ty) {
    NullaryOperands(t) -> at_root(Order, t),
    SumOperands(t) -> at_root(Order, t),
    ContainerOperands(t) -> at_root(ContainerWalk(b"ordered"), t),
    WordOperands(t) -> if is_option(t) && !has_variables(t) {
      at_root(ContainerWalk(b"ordered"), t)
    } else { None },
    _ -> None,
  }
}

fn order_sign(
  context: Context,
  l: LoweredValue,
  r: LoweredValue,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let int = int_type();
  let signed = |o: LoweredValue|
    bound(
      context,
      o.st,
      int,
      Primitive({ op: b"sign", on: operand_representation(o.arg), args: [o.arg] }),
      at,
    );
  if has_unknown_part(ty) {
    signed(open_at(context, r.st, ty, [l.arg, r.arg], ordering_type(), at))
  } else {
    match root_order(context, r.st, ty, l.arg, r.arg, at) {
      Some(o) -> signed(o),
      None -> match class_of(context.setting.constructors, ty) {
        IntOperands -> binary_primitive(context, l, r, b"order", AsInt, int, at),
        BoolOperands -> binary_primitive(context, l, r, b"order", AsBool, int, at),
        CharOperands -> binary_primitive(context, l, r, b"order", AsImmediate, int, at),
        WidthOperands(w) ->
          binary_primitive(context, l, r, b"order", width_representation(w), int, at),
        DecimalOperands -> binary_primitive(context, l, r, b"order", AsDecimal, int, at),
        TextOperands -> binary_primitive(context, l, r, b"bytes_order", AsWord, int, at),
        FloatOperands -> {
          let x = total_key(context, { st: r.st, arg: l.arg }, at);
          let y = total_key(context, { st: x.st, arg: r.arg }, at);
          bound(
            context,
            y.st,
            int,
            Primitive({ op: b"order", on: AsInt, args: [x.arg, y.arg] }),
            at,
          )
        },
        _ -> if representation_of(context.setting, ty) == AsUnit {
          { st: r.st, arg: IntOperand(0) }
        } else if ty == kept_type() { kept_order(r.st, l.arg, r.arg, at) }
        else { unreachable(b"an order of a type none is derived for: ".concat(encode_type(ty))) },
      },
    }
  }
}

fn total_key(context: Context, f: LoweredValue, at: Span) -> LoweredValue = {
  let int = int_type();
  let x = represented_as(f, AsFloat, at);
  let bits = bound(context, x.st, int, Primitive({ op: b"bits", on: AsFloat, args: [x.arg] }), at);
  let sign = bound(
    context,
    bits.st,
    int,
    Primitive({ op: b"shr", on: AsInt, args: [bits.arg, IntOperand(63)] }),
    at,
  );
  let flips = bound(
    context,
    sign.st,
    int,
    Primitive({ op: b"ushr", on: AsInt, args: [sign.arg, IntOperand(1)] }),
    at,
  );
  bound(
    context,
    flips.st,
    int,
    Primitive({ op: b"bitxor", on: AsInt, args: [bits.arg, flips.arg] }),
    at,
  )
}

fn reflect_to_value(
  context: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = type_of(a);
  let value_type = named_type(b"std.value.Value");
  let op = if name == b"shown" { Show } else { Reflect };
  let value = |ctor: Bytes| constructed_as(context, st, ctor, [a], value_type, at);
  let unary_primitive = |ctor: Bytes| constructed_as(context, st, ctor, [], value_type, at);
  let none = || unreachable(b"a reflection of a value none describes: ".concat(encode_type(ty)));
  if !context.setting.constructors.named.contains(b"std.value.VUnit") {
    unreachable(b"a reflection in a program that holds no `std.value`")
  } else {
    match ty {
      FunctionType(_) -> {
        let f = constructed_as(
          context,
          st,
          b"std.value.FAnonymous",
          [],
          named_type(b"std.value.Fun"),
          at,
        );
        constructed_as(context, f.st, b"std.value.VFn", [f.arg], value_type, at)
      },
      NamedType(c) -> if c.name == scoped_name() { unary_primitive(b"std.value.VHold") }
      else if c.name == secret_name() { unary_primitive(b"std.value.VSecret") }
      else if has_unknown_part(ty) { open_at(context, st, ty, [a], value_type, at) }
      else if written_sum(context.setting.constructors, c) || is_walked_container(ty)
          || is_columns_type(ty) { type_operation_call(context, st, op, ty, a, at) }
      else if c.args.len() > 0 { none() }
      else if is_int(ty) { value(b"std.value.VInt") }
      else if is_bool(ty) { value(b"std.value.VBool") }
      else if is_float(ty) { value(b"std.value.VFloat") }
      else if is_decimal(ty) { value(b"std.value.VDecimal") }
      else if is_char(ty) { value(b"std.value.VChar") }
      else if is_string(ty) { value(b"std.value.VStr") }
      else if is_bytes(ty) { value(b"std.value.VBytes") }
      else if is_unit(ty) { unary_primitive(b"std.value.VUnit") } else {
        match width_named(c.name) {
          Some(w) -> width_reflected(context, st, c.name, w, a, value_type, at),
          None -> none(),
        }
      },
      _ -> if has_unknown_part(ty) { open_at(context, st, ty, [a], value_type, at) }
      else { type_operation_call(context, st, op, ty, a, at) },
    }
  }
}

fn width_reflected(
  context: Context,
  st: Lowering,
  name: Bytes,
  w: Width,
  a: Arg,
  value_type: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let int = int_type();
  let u128 = width_type({ bits: 128, signed: false });
  let made = |s: Lowering, lo: Arg, hi: Arg|
    bound(context, s, u128, Primitive({ op: b"wide", on: AsInt, args: [lo, hi] }), at);
  let wide = if w.bits > 64 {
    let p = pair_words(st, a, AsWideFixed(w), at);
    made(p.st, p.lo, p.hi)
  } else if w.bits == 64 {
    let x = unary_primitive(context, { st: st, arg: a }, b"narrow", AsFixed(w), int, at);
    made(x.st, x.arg, IntOperand(0))
  } else {
    let x = unary_primitive(context, { st: st, arg: a }, b"to_int", AsFixed(w), int, at);
    let bits = if !w.signed { x } else {
      bound(
        context,
        x.st,
        int,
        Primitive({ op: b"bitand", on: AsInt, args: [x.arg, IntOperand((1 << w.bits) - 1)] }),
        at,
      )
    };
    made(bits.st, bits.arg, IntOperand(0))
  };
  let spelled = literal(context, wide.st, LiteralString(name), at);
  constructed_as(context, spelled.st, b"std.value.VFixed", [spelled.arg, wide.arg], value_type, at)
}

fn encoded(
  context: Context,
  st: Lowering,
  hashed: Bool,
  a: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = type_of(a);
  let bytes = builtin_return_type(
    context,
    if hashed { b"digest" } else { b"?encoded" },
    ty,
    bytes_type(),
  );
  let rooted_by = match ty {
    NamedType(c) ->
      written_sum(context.setting.constructors, c) || is_walked_container(ty)
        || is_columns_type(ty),
    RecordType(_) -> true,
    NominalType(_) -> true,
    _ -> false,
  };
  if has_unknown_part(ty) { open_at(context, st, ty, [a], bytes, at) } else {
    match if rooted_by { Some(type_operation_call(context, st, Digest, ty, a, at)) }
      else { scalar_encoding(context, st, a, ty, at) } {
      Some(e) -> if hashed { blake3_of(e.st, e.arg, at) } else { e },
      None -> unreachable(b"a digest of a type none is derived for: ".concat(encode_type(ty))),
    }
  }
}

fn type_operation_call(
  context: Context,
  st: Lowering,
  op: TypeOp,
  ty: Type,
  a: Arg,
  at: Span,
) -> LoweredValue =
  root_call(
    context,
    st,
    keys::generated_key(op, ty, context.setting.module),
    [a],
    [ty],
    match op { Digest -> bytes_type(), _ -> named_type(b"std.value.Value") },
    at,
  )

pub fn release_value(
  context: Context,
  st: Lowering,
  a: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = type_of(a);
  if has_variables(ty) {
    deferred_to_specialisation(
      note_exact_types(st, ty),
      unit_type(),
      representation_of(context.setting, unit_type()),
      read_only([a]),
      at,
    )
  } else {
    let h = release_function_evidence(context, ty);
    let w = passed_evidence_arguments(st, h, at);
    let words = { count: h.words.len(), args: w.args };
    root_call_with_words(
      context,
      w.st,
      release_function_root(context, ty),
      [a],
      [ty],
      unit_type(),
      at,
      true,
      words,
    )
  }
}

pub fn unwound(
  context: Context,
  st: Lowering,
  a: Arg,
  at: Span,
) -> { st: Lowering, unwound: Unwinding } / {abort.raise} = {
  let ty = type_of(a);
  let h = release_function_evidence(context, ty);
  let w = passed_evidence_arguments(note_exact_types(st, ty), h, at);
  {
    st: w.st,
    unwound: {
      arg: a,
      words: w.args,
      callee: release_function_root(context, ty),
      convention: with_evidence_parameters(
        typed_convention(context.setting.constructors, [ty], unit_type()),
        0,
        h.words.len(),
      ),
    },
  }
}

fn release_function_root(context: Context, ty: Type) -> RootKey =
  keys::generated_key(ReleaseResource, ty, context.setting.module)

fn release_function_evidence(context: Context, ty: Type) -> EvidenceArguments / {abort.raise} =
  scheme_evidence_arguments(
    context,
    Some(
      monomorphic(fn_type([ty], unit_type(), release_effects(context.setting.constructors, ty))),
    ),
    [],
    [],
  )

fn width_arithmetic(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let a = match args.at(0) { Some(x) -> x, None -> IntOperand(0) };
  let b = match args.at(1) { Some(x) -> x, None -> IntOperand(0) };
  let ty = match a { IntOperand(_) -> type_of(b), _ -> type_of(a) };
  let checked = name.starts_with(b"checked_");
  let result = builtin_return_type(context, name, ty, if checked { option_type(ty) } else { ty });
  match class_of(context.setting.constructors, ty) {
    WidthOperands(w) -> if w.bits > 64 {
      if checked {
        checked_operation(
          context,
          st,
          name,
          a,
          b,
          { ty: ty, held: AsWideFixed(w), on: AsWideFixed(w) },
          result,
          at,
        )
      } else {
        binary_primitive(
          context,
          { st: st, arg: a },
          { st: st, arg: b },
          name,
          AsWideFixed(w),
          ty,
          at,
        )
      }
    } else if wrapping(name) || (is_saturating_operation(name) && w.bits == 64) {
      binary_primitive(context, { st: st, arg: a }, { st: st, arg: b }, name, AsFixed(w), ty, at)
    } else if w.bits == 64 {
      checked_operation(
        context,
        st,
        name,
        a,
        b,
        { ty: ty, held: AsFixed(w), on: AsFixed(w) },
        result,
        at,
      )
    } else if checked { checked_width(context, st, name, a, b, w, result, at) } else {
      binary_primitive(context, { st: st, arg: a }, { st: st, arg: b }, name, AsFixed(w), ty, at)
    },
    IntOperands -> if wrapping(name) || is_saturating_operation(name) {
      let x = represented_as({ st: st, arg: a }, AsInt, at);
      let y = if has_count_operand(name) { { st: x.st, arg: b } }
      else { represented_as({ st: x.st, arg: b }, AsInt, at) };
      bound(
        context,
        y.st,
        ty,
        Primitive({ op: name, on: AsFixed({ bits: 64, signed: true }), args: [x.arg, y.arg] }),
        at,
      )
    } else {
      let word = AsFixed({ bits: 64, signed: true });
      checked_operation(context, st, name, a, b, { ty: ty, held: AsInt, on: word }, result, at)
    },
    _ -> unreachable(b"an integer's builtin at a type that is no integer: ".concat(name)),
  }
}

fn to_int_call(
  context: Context,
  st: Lowering,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args {
    [_, x] -> {
      let ty = type_of(x);
      let int = int_type();
      let option = builtin_return_type(context, b"to_int", ty, option_type(int));
      let some = |l: LoweredValue|
        constructed_as(context, l.st, some_constructor(), [l.arg], option, at);
      match class_of(context.setting.constructors, ty) {
        IntOperands -> some(represented_as({ st: st, arg: x }, AsInt, at)),
        WidthOperands(w) -> if w.bits < 64 || (w.bits == 64 && w.signed) {
          some(unary_primitive(context, { st: st, arg: x }, b"to_int", AsFixed(w), int, at))
        } else {
          let h = represented_as({ st: st, arg: x }, width_representation(w), at);
          let fits = bound(
            context,
            h.st,
            bool_type(),
            if w.bits == 64 {
              Primitive({
                op: b"le",
                on: AsFixed(w),
                args: [h.arg, FixedOperand({ width: w, bits: 9223372036854775807 })],
              })
            } else { Primitive({ op: b"fits_int", on: AsWideFixed(w), args: [h.arg] }) },
            at,
          );
          let value = bound(
            context,
            enter_block(fits.st),
            int,
            Primitive({
              op: if w.bits == 64 { b"narrow" } else { b"lo" },
              on: width_representation(w),
              args: [h.arg],
            }),
            at,
          );
          some_if(context, fits, value, option, at)
        },
        _ -> if has_variables(ty) {
          left_to_callers(
            context,
            st,
            b"to_int",
            args,
            { params: args.map(type_of), ret: option },
            at,
          )
        } else { unreachable(b"`to_int` at a type that is no integer") },
      }
    },
    _ -> unreachable(b"`to_int` called other than with a witness and a value"),
  }

fn indexed_numeric_operator(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let scalar = |t: Type|
    match t { VariableType(v) -> with_need(st, { var: v, reads: Scalar }), _ -> st };
  match args {
    [IntOperand(k), _, x, y] -> match numeric_operators().at(k) {
      None -> unreachable(b"an operator over a witness numbered as none is"),
      Some(op) -> {
        let ty = match x { IntOperand(_) -> type_of(y), _ -> type_of(x) };
        if !has_variables(ty) { binary(context, { st: st, arg: x }, { st: st, arg: y }, op, at) }
        else {
          left_to_callers(
            context,
            scalar(ty),
            name,
            args,
            { params: args.map(type_of), ret: if comparison(op) { bool_type() } else { ty } },
            at,
          )
        }
      },
    },
    [IntOperand(k), _, x] -> if !has_variables(type_of(x)) {
      unary(context, { st: st, arg: x }, if k == 1 { b"bitnot" } else { b"neg" }, at)
    } else {
      left_to_callers(
        context,
        scalar(type_of(x)),
        name,
        args,
        { params: args.map(type_of), ret: type_of(x) },
        at,
      )
    },
    _ -> unreachable(b"an operator over a witness written other than as the elaboration writes it"),
  }
}

fn checked_width(
  context: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  b: Arg,
  w: Width,
  option: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = width_type(w);
  let neg = name == b"checked_neg";
  let unsigned = !w.signed && name == b"checked_mul";
  let word = { bits: 64, signed: false };
  let x = represented_as({ st: st, arg: a }, AsFixed(w), at);
  let y = if neg { x } else { represented_as({ st: x.st, arg: b }, AsFixed(w), at) };
  let exact = bound(
    context,
    y.st,
    if unsigned { width_type(word) } else { int_type() },
    Primitive({
      op: if neg { b"exact_neg" }
      else if name == b"checked_add" { b"exact_add" }
      else if name == b"checked_sub" { b"exact_sub" }
      else { b"exact_mul" },
      on: AsFixed(w),
      args: if neg { [x.arg] } else { [x.arg, y.arg] },
    }),
    at,
  );
  let fits = bound(
    context,
    exact.st,
    bool_type(),
    if unsigned {
      Primitive({
        op: b"le",
        on: AsFixed(word),
        args: [exact.arg, FixedOperand({ width: word, bits: most(w) })],
      })
    } else {
      Primitive({
        op: b"within",
        on: AsInt,
        args: [exact.arg, IntOperand(least(w)), IntOperand(most(w))],
      })
    },
    at,
  );
  let narrowed = bound(
    context,
    enter_block(fits.st),
    ty,
    Primitive({ op: b"narrow", on: operand_representation(exact.arg), args: [exact.arg] }),
    at,
  );
  some_if(context, fits, narrowed, option, at)
}

fn checked_operation(
  context: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  b: Arg,
  k: { ty: Type, held: Representation, on: Representation },
  option: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let neg = name == b"checked_neg";
  let x = represented_as({ st: st, arg: a }, k.held, at);
  let y = if neg { x } else { represented_as({ st: x.st, arg: b }, k.held, at) };
  let fits = bound(
    context,
    y.st,
    bool_type(),
    Primitive({ op: name, on: k.on, args: if neg { [x.arg] } else { [x.arg, y.arg] } }),
    at,
  );
  let wrapped = bound(
    context,
    enter_block(fits.st),
    k.ty,
    Primitive({
      op: if neg || name == b"checked_sub" { b"wrap_sub" }
      else if name == b"checked_add" { b"wrap_add" }
      else { b"wrap_mul" },
      on: k.on,
      args: if neg { [ZeroOperand(k.held), x.arg] } else { [x.arg, y.arg] },
    }),
    at,
  );
  some_if(context, fits, wrapped, option, at)
}

fn some_if(
  context: Context,
  fits: LoweredValue,
  value: LoweredValue,
  option: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let some = constructed_as(context, value.st, some_constructor(), [value.arg], option, at);
  let none = constructed_as(
    context,
    exit_block(enter_block(fits.st), some.st),
    none_constructor(),
    [],
    option,
    at,
  );
  let j = fresh(exit_block(fits.st, none.st), option, representation_of(context.setting, option));
  let t = set_join(j.st, some, j.var, at);
  let e = set_join(t.st, none, j.var, at);
  {
    st: {
      ..e.st,
      insts: fits.st.insts.push(Declaration(j.var)).push(
        If({ cond: fits.arg, then: t.block, otherwise: e.block }),
      ),
    },
    arg: VarOperand(j.var),
  }
}

fn least(w: Width) -> Int = if w.signed { 0 - (1 << w.bits - 1) } else { 0 }

fn most(w: Width) -> Int = if w.signed { (1 << w.bits - 1) - 1 } else { (1 << w.bits) - 1 }

fn fail_missing_operator(st: Lowering, op: Bytes) -> LoweredValue / {abort.raise} =
  unreachable(b"an operator its operands' type does not have: ".concat(op))

fn note_exact_types(st: Lowering, ty: Type) -> Lowering =
  match ty {
    VariableType(v) -> if v < 0 { st } else { with_need(st, { var: v, reads: Exact }) },
    _ -> type_variables(ty).fold(st, |s: Lowering, v: Int| with_need(s, { var: v, reads: Exact })),
  }

fn has_count_operand(op: Bytes) -> Bool = shift(op) || op == b"rotl" || op == b"rotr"

fn wrapping(name: Bytes) -> Bool =
  name == b"wrap_add" || name == b"wrap_sub" || name == b"wrap_mul" || name == b"rotr"
    || name == b"rotl"

fn is_saturating_operation(name: Bytes) -> Bool =
  name == b"saturating_add" || name == b"saturating_sub" || name == b"saturating_mul"

fn arity(name: Bytes) -> Int =
  if name == b"compare" || name == b"compare_values" || name == b"?same" || name == b"min"
      || name == b"max"
      || wrapping(name)
      || is_saturating_operation(name)
      || (name.starts_with(b"checked_") && name != b"checked_neg") { 2 }
  else if name == b"to_int" { 2 }
  else if name == b"?numeric_binary" { 4 }
  else if name == b"?numeric_unary" { 3 }
  else { match float_function(name) { Some(f) -> f.operands, None -> 1 } }

fn float_computed(
  context: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match float_exact(name) {
    None -> unreachable(b"no exact Float function: ".concat(name)),
    Some(op) -> {
      let x = represented_as({ st: st, arg: a }, AsFloat, at);
      bound(context, x.st, float_type(), Primitive({ op: op, on: AsFloat, args: [x.arg] }), at)
    },
  }

fn float_called(
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match float_function(name) {
    None -> unreachable(b"no Float function: ".concat(name)),
    Some(f) -> float_native_called(st, f, args, at),
  }

fn float_native_called(
  st: Lowering,
  f: FloatFunction,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let given = args.fold({ st: st, bits: [] }, |acc: { st: Lowering, bits: List<Arg> }, a: Arg| {
    let x = represented_as({ st: acc.st, arg: a }, AsFloat, at);
    let b = bound_as(
      x.st,
      int_type(),
      AsInt,
      Primitive({ op: b"bits", on: AsFloat, args: [x.arg] }),
      at,
    );
    { st: b.st, bits: acc.bits.push(b.arg) }
  });
  let returned = bound_as(
    given.st,
    int_type(),
    AsInt,
    Native({
      name: builtin_helper(f.native).concat(b"_p"),
      args: given.bits,
      uses: { takes: given.bits.map(|_: Arg| false), owned: true, fails: false, suspends: false },
    }),
    at,
  );
  bound_as(
    returned.st,
    float_type(),
    AsFloat,
    Primitive({ op: b"of_bits", on: AsInt, args: [returned.arg] }),
    at,
  )
}

fn divisor(op: Bytes, rhs: Code) -> Option<Int> =
  if op != b"div" && op != b"rem" { None } else {
    match rhs.node {
      CodeUnary(u) -> if u.op != b"neg" { None } else {
        match u.operand.node {
          CodeLiteral(l) -> match l {
            LiteralInt(v) -> if v == 0 || v == 1 { None } else { Some(0 - v) },
            _ -> None,
          },
          _ -> None,
        }
      },
      _ -> None,
    }
  }

fn width_called(
  name: Bytes,
  named: ({ name: Bytes, bits: Int, signed: Bool }) -> Bytes,
) -> Option<Width> =
  fixed_widths().find_map(|w: { name: Bytes, bits: Int, signed: Bool }|
    if name == named(w) { Some({ bits: w.bits, signed: w.signed }) } else { None })

fn of_int_width(name: Bytes) -> Option<Width> =
  width_called(name, |w: { name: Bytes, bits: Int, signed: Bool }| w.name.concat(b"::of_int"))

fn int_of_width(name: Bytes) -> Option<Width> =
  width_called(name, |w: { name: Bytes, bits: Int, signed: Bool }|
    Bytes::concat_all([b"Int::of_", if w.signed { b"i" } else { b"u" }, ascii_of_int(w.bits)]))

pub fn is_option(t: Type) -> Bool = option_item(t) != None

pub fn is_walked_container(t: Type) -> Bool =
  !has_variables(t) && (list_item(t) != None || array_element(t) != None || map_parts(t) != None)

pub fn is_columns_type(t: Type) -> Bool = !has_variables(t) && columns_row(t) != None

fn is_result(t: Type) -> Bool = !has_variables(t) && result_parts(t) != None
