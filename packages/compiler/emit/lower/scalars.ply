//! Literals, operators and widths, and every operation done per type at a site: equality, order,
//! show, digest and reflection. An operator means what the type its operands hold says: C's own
//! over a scalar a register holds, over a character's or a constructor's word and over a string's
//! bytes, a root written for a declared sum or a container, and the runtime's over any other word.

import compiler.emit.code (Code, NLit, NUnary)
import compiler.syntax.patterns (Lit, LInt, LBool, LFloat, LFixed, LWide, LChar, LStr, LBytes,
                                 LEmbedded, LDec, LUnit, LBad)
import compiler.check.types (Type, TyVar, TyCon, TyFn, TyRecord, TyNominal, Field, named_type,
                             spelled_type, unit_type, fn_type, monomorphic)
import compiler.emit.typing (unknown_type)
import compiler.syntax.parsing (Span)
import compiler.emit.c (Width, width_named, lit_int, is_bitop)
import compiler.emit.reps (Ctors, SumCtor, has_vars, type_vars, compared_by_root, keyed_sum,
                           numeric_sum, nullary_sum, generic_sum, written_sum, at_args, release_row)
import compiler.check.infer.expr (kept_type)
import compiler.emit.answer (Scalar, Exact, literal_bits)
import compiler.emit.keys
import compiler.emit.keys (RootKey, TypeOp, Root, Order, Stated, Reflect, Shown, Digest, Contained,
                           LetGo)
import compiler.emit.tir (Rep, RInt, RBool, RNum, RFloat, RDec, RWide, RWord, RSum, RUnit, RImm,
                          Arg, AVar, AInt, AZero, ABool, AFloat, ANum, AChar, Val, Prim, Literal,
                          Get, Tag, Call, Native, Let, Decl, Assign, If, rep_of_arg, comparison,
                          arithmetic, shift, Unwound, read_only)
import compiler.emit.lower.setting (declared_at, prelude_ctor)
import compiler.emit.lower.held (held_as, typed_convention, width_held)
import compiler.emit.lower.base (Context, Lowering, Lowered, unreachable, fresh, bound, bound_as,
                                 opened, pair_words, continued, type_of, handed, noted, set_join,
                                 joined, short_circuit, unsettled, unsaid)
import compiler.emit.lower.data (constructed_as, field)
import compiler.emit.lower.crossing (left_to_callers, blake3_of, scalar_encoding, concatenated)
import compiler.emit.lower.evidence (Handing, handing_scheme, words_handed, evidenced)
import compiler.emit.roots (builtin_helper)
import compiler.expand.rewrite (FloatFunction, float_function, numeric_ops_numbered)

/// A literal as the operand it is, or read from the pool into a variable of its type where no
/// register holds it: a string, bytes, an embedded file, a `Decimal`, `()` and a width past 64 bits.
pub fn literal(cx: Context, st: Lowering, l: Lit, at: Span) -> Lowered / {abort.raise} =
  match l {
    LInt(n) -> { st: st, arg: AInt(n) },
    LBool(b) -> { st: st, arg: ABool(b) },
    LFloat(x) -> { st: st, arg: AFloat(literal_bits(x)) },
    LChar(v) -> { st: st, arg: AChar(v) },
    LFixed(name, bits) -> fixed(cx, st, l, name, bits, at),
    LWide(name, _, low) -> fixed(cx, st, l, name, low, at),
    LStr(_) -> bound(cx, st, named_type(b"String"), Literal(l), at),
    LBytes(_) -> bound(cx, st, named_type(b"Bytes"), Literal(l), at),
    LEmbedded(_, _) -> bound(cx, st, named_type(b"Bytes"), Literal(l), at),
    LDec(_) -> bound(cx, st, named_type(b"Decimal"), Literal(l), at),
    LUnit -> { st: st, arg: AZero(RUnit) },
    LBad -> unreachable(b"a literal that does not read"),
  }

/// A width's literal: its bits where a register holds the width, else its word from the pool.
fn fixed(
  cx: Context,
  st: Lowering,
  l: Lit,
  name: Bytes,
  bits: Int,
  at: Span,
) -> Lowered / {abort.raise} =
  match width_named(name) {
    Some(w) -> if w.bits <= 64 { { st: st, arg: ANum({ width: w, bits: bits }) } }
    else { bound(cx, st, named_type(name), Literal(l), at) },
    None -> unreachable(b"a literal of no known width"),
  }

/// A node folded to a constant without lowering anything: two `Int` literals under an operator
/// whose result is exact.
pub fn constant(cx: Context, c: Code) -> Option<Arg> =
  match lit_int(c) { Some(n) -> Some(AInt(n)), None -> None }

/// The right operand of `op` taken as a constant where its node is one C's own operator takes: a
/// negated literal divisor.
pub fn operand(cx: Context, op: Bytes, rhs: Code) -> Option<Arg> =
  match divisor(op, rhs) { Some(d) -> Some(AInt(d)), None -> None }

/// `op` over `o`: `!` over a `Bool`, `-` and `~` at the type `o` holds, C's own over a scalar a
/// register holds, a declared sum's negation its witness's; over a type variable's value, what only
/// a specialisation computes.
pub fn unary(cx: Context, o: Lowered, op: Bytes, at: Span) -> Lowered / {abort.raise} =
  if op == b"not" {
    let b = handed(o, RBool, at);
    bound(cx, b.st, named_type(b"Bool"), Prim({ op: op, on: RBool, args: [b.arg] }), at)
  } else if op != b"neg" && op != b"bitnot" { unreachable(b"an operator: ".concat(op)) } else {
    let ty = type_of(o.arg);
    if ty == unknown_type() {
      unreachable(b"an operator over an operand of no known type: ".concat(op))
    } else {
      match class_of(cx.setting.ctors, ty) {
        CInt -> alone(cx, o, op, RInt, ty, at),
        CWidth(w) -> alone(cx, o, op, width_held(w), ty, at),
        CFloat -> if op == b"neg" { alone(cx, o, op, RFloat, ty, at) } else { lacking(o.st, op) },
        CDec -> if op == b"neg" { alone(cx, o, op, RDec, ty, at) } else { lacking(o.st, op) },
        CWord(t) ->
          unsettled(needing(o.st, t), ty, held_as(cx.setting, ty), read_only([o.arg]), at),
        CSum(t) -> if op == b"neg" && numeric_sum(cx.setting.ctors, t) {
          stated(cx, o.st, op, [o.arg], [t], t, at)
        } else { lacking(o.st, op) },
        _ -> lacking(o.st, op),
      }
    }
  }

/// `l op r` at the type the operands hold, read off whichever says more than an `Int` literal does:
/// a comparison answers a `Bool`, any other operator a value of the operands' type.
pub fn binary(cx: Context, l: Lowered, r: Lowered, op: Bytes, at: Span) -> Lowered / {abort.raise} = {
  let ty = match l.arg { AInt(_) -> type_of(r.arg), _ -> type_of(l.arg) };
  if op == b"concat" { concatenated(cx, r.st, l.arg, r.arg, ty, at) }
  else if !comparison(op) && !arithmetic(op) && !shift(op) && !is_bitop(op) {
    unreachable(b"an operator: ".concat(op))
  } else if ty == unknown_type() {
    unreachable(b"an operator over operands of no known type: ".concat(op))
  } else if (op == b"eq" || op == b"ne") && held_as(cx.setting, ty) == RUnit {
    // Two values of no words are one value.
    { st: r.st, arg: ABool(op == b"eq") }
  } else {
    let eq = op == b"eq" || op == b"ne";
    let equal = match class_of(cx.setting.ctors, ty) {
      CRecord(fs) -> if eq { Some(fields_equal(cx, r.st, fs, l.arg, r.arg, at)) } else { None },
      _ -> None,
    };
    match equal {
      Some(e) -> if op == b"ne" { negation(cx, e, at) } else { e },
      None -> classed(cx, l, r, op, ty, class_of(cx.setting.ctors, ty), at),
    }
  }
}

/// `l op r` over values of `ty` of class `c`, but a record's or an `Option`'s equality, which
/// `binary` compares part by part.
fn classed(
  cx: Context,
  l: Lowered,
  r: Lowered,
  op: Bytes,
  ty: Type,
  c: Class,
  at: Span,
) -> Lowered / {abort.raise} = {
  let eq = op == b"eq" || op == b"ne";
  let truth = named_type(b"Bool");
  let answer = if comparison(op) { truth } else { ty };
  {
    match c {
      CInt -> over(cx, l, r, op, RInt, answer, at),
      CWidth(w) -> over(cx, l, r, op, width_held(w), answer, at),
      CBool -> if eq { over(cx, l, r, op, RBool, truth, at) } else { lacking(r.st, op) },
      CFloat -> if comparison(op) || arithmetic(op) { over(cx, l, r, op, RFloat, answer, at) }
      else { lacking(r.st, op) },
      CDec -> if comparison(op) || arithmetic(op) { over(cx, l, r, op, RDec, answer, at) }
      else { lacking(r.st, op) },
      CChar -> if comparison(op) { over(cx, l, r, op, RImm, truth, at) } else { lacking(r.st, op) },
      CText -> if eq {
        over(cx, l, r, if op == b"eq" { b"bytes_eq" } else { b"bytes_ne" }, RWord, truth, at)
      } else { lacking(r.st, op) },
      CNullary(_) -> if eq {
        match held_as(cx.setting, ty) {
          RSum(k) -> over(cx, l, r, op, RSum(k), truth, at),
          _ -> lacking(r.st, op),
        }
      } else { ranked(cx, l, r, op, ty, at) },
      CSum(t) -> if !eq && numeric_sum(cx.setting.ctors, t) && arithmetic(op) {
        stated(cx, r.st, op, [l.arg, r.arg], [t, t], t, at)
      } else if eq {
        // A bare `Equal` is `Ordering`'s, which the prelude declares.
        equal_by(
          cx,
          r.st,
          op,
          keys::written(keys::Equal, t, cx.setting.module),
          t,
          [l.arg, r.arg],
          at,
        )
      } else { ranked(cx, l, r, op, ty, at) },
      CWalked(t) -> if eq {
        equal_by(
          cx,
          r.st,
          op,
          keys::written(Contained(b"equal"), t, cx.setting.module),
          t,
          [l.arg, r.arg],
          at,
        )
      } else { ranked(cx, l, r, op, ty, at) },
      CWord(t) -> if eq && is_secret(t) {
        handles_equal(l, r, op, b"builtin_elaborated_secret_equal_p", at)
      } else if eq && t == kept_type() {
        handles_equal(l, r, op, b"builtin_elaborated_kept_equal_p", at)
      } else { ranked(cx, l, r, op, t, at) },
      CRecord(_) -> lacking(r.st, op),
    }
  }
}

fn is_secret(ty: Type) -> Bool = match ty { TyCon(c) -> c.name == b"Secret", _ -> false }

fn is_function(ty: Type) -> Bool = match ty { TyFn(_) -> true, _ -> false }

/// `==` or `!=` of two functions: the run fails there, answering no truth.
fn functions_compared(st: Lowering, at: Span) -> Lowered = {
  let failed = bound_as(
    st,
    named_type(b"Int"),
    RInt,
    Native({
      name: b"builtin_elaborated_functions_compared_p",
      args: [],
      uses: { takes: [], owned: true, fails: true, stops: false },
    }),
    at,
  );
  bound_as(
    failed.st,
    named_type(b"Bool"),
    RBool,
    Prim({ op: b"ne", on: RInt, args: [failed.arg, AInt(0)] }),
    at,
  )
}

/// `l == r` or `l != r` of two runtime objects the runtime's `native` compares, borrowing both and
/// answering 1 where they are equal: two secrets, in constant time, or two kept values, as their
/// type compares them.
fn handles_equal(l: Lowered, r: Lowered, op: Bytes, native: Bytes, at: Span) -> Lowered = {
  let a = handed({ st: r.st, arg: l.arg }, RWord, at);
  let b = handed({ st: a.st, arg: r.arg }, RWord, at);
  let same = bound_as(
    b.st,
    named_type(b"Int"),
    RInt,
    Native({
      name: native,
      args: [a.arg, b.arg],
      uses: { takes: [false, false], owned: true, fails: true, stops: false },
    }),
    at,
  );
  bound_as(
    same.st,
    named_type(b"Bool"),
    RBool,
    Prim({ op: if op == b"eq" { b"ne" } else { b"eq" }, on: RInt, args: [same.arg, AInt(0)] }),
    at,
  )
}

/// Whether `a` and `b`, records of fields `fs`, are equal: field by field in order, a field of no
/// words being equal, each compared only where those before it were equal and as its own type
/// compares, a field of a record type field by field again.
fn fields_equal(
  cx: Context,
  st: Lowering,
  fs: List<Field>,
  a: Arg,
  b: Arg,
  at: Span,
) -> Lowered / {abort.raise} =
  valued(cx, fs).fold(
    { out: { st: st, arg: ABool(true) }, first: true },
    |acc: { out: Lowered, first: Bool }, f: Field| {
      let x = field(
        cx,
        { st: if acc.first { acc.out.st } else { opened(acc.out.st) }, arg: a },
        f.name,
        at,
      );
      let y = field(cx, { st: x.st, arg: b }, f.name, at);
      let xs = { st: y.st, arg: x.arg };
      let e = match f.ty {
        TyRecord(gs) -> fields_equal(cx, y.st, gs, x.arg, y.arg, at),
        TyNominal(n) -> fields_equal(cx, y.st, n.fields, x.arg, y.arg, at),
        _ -> classed(cx, xs, y, b"eq", f.ty, class_of(cx.setting.ctors, f.ty), at),
      };
      { out: if acc.first { e } else { short_circuit(cx, acc.out, e, true, at) }, first: false }
    },
  ).out

/// The sign of `a` and `b`'s order, records of fields `fs`: by their fields of any words in order,
/// the first that orders them apart deciding, each read only where those before it were equal.
fn fields_order(
  cx: Context,
  st: Lowering,
  fs: List<Field>,
  a: Arg,
  b: Arg,
  at: Span,
) -> Lowered / {abort.raise} =
  valued(cx, fs).fold(
    { out: { st: st, arg: AInt(0) }, first: true },
    |acc: { out: Lowered, first: Bool }, f: Field| {
      let x = field(
        cx,
        { st: if acc.first { acc.out.st } else { opened(acc.out.st) }, arg: a },
        f.name,
        at,
      );
      let y = field(cx, { st: x.st, arg: b }, f.name, at);
      let s = match f.ty {
        TyRecord(gs) -> fields_order(cx, y.st, gs, x.arg, y.arg, at),
        TyNominal(n) -> fields_order(cx, y.st, n.fields, x.arg, y.arg, at),
        _ -> sign_at(cx, { st: y.st, arg: x.arg }, y, f.ty, at),
      };
      { out: if acc.first { s } else { decided(cx, acc.out, s, at) }, first: false }
    },
  ).out

/// The fields of `fs` that hold a value, a field of no words none, as `held.record_parts` says.
fn valued(cx: Context, fs: List<Field>) -> List<Field> =
  fs.filter(|f: Field| held_as(cx.setting, f.ty) != RUnit)

/// The sign `l` where it is not zero, else `r`, lowered in a block of its own after `l`'s state.
fn decided(cx: Context, l: Lowered, r: Lowered, at: Span) -> Lowered = {
  let j = fresh(continued(l.st, r.st), named_type(b"Int"), RInt);
  let c = bound(
    cx,
    j.st,
    named_type(b"Bool"),
    Prim({ op: b"ne", on: RInt, args: [l.arg, AInt(0)] }),
    at,
  );
  let right = set_join(c.st, r, j.var, at);
  {
    st: {
      ..right.st,
      insts: right.st.insts.push(Decl(j.var)).push(
        If({ cond: c.arg, then: [Assign({ var: j.var, arg: l.arg })], otherwise: right.block }),
      ),
    },
    arg: AVar(j.var),
  }
}

/// Builtin `name` over `args`, which `containers` hands on as one written in place at the type its
/// operands hold: an order, a reflection, an encoding, an identity test, a width's wrapping,
/// saturating and checked arithmetic and its conversions, an operator over a witness, and a
/// `Float`'s.
pub fn operated(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  at: Span,
) -> Lowered / {abort.raise} =
  match args.at(0) {
    None -> unreachable(b"a builtin of no argument: ".concat(name)),
    Some(a) -> {
      let b = match args.at(1) { Some(x) -> x, None -> AInt(0) };
      if args.len() != arity(name) {
        unreachable(b"a builtin called with other than its arguments: ".concat(name))
      } else if name == b"compare" || name == b"compare_values" { ordered(cx, st, name, a, b, at) }
      else if name == b"min" || name == b"max" { extreme(cx, st, name == b"max", a, b, at) }
      else if name == b"reflect" || name == b"shown" { reflected(cx, st, name, a, at) }
      else if name == b"?encoded" || name == b"digest" { encoded(cx, st, name == b"digest", a, at) }
      else if name == b"?same" {
        let x = handed({ st: st, arg: a }, RWord, at);
        let y = handed({ st: x.st, arg: b }, RWord, at);
        bound(
          cx,
          y.st,
          named_type(b"Bool"),
          Prim({ op: b"eq", on: RWord, args: [x.arg, y.arg] }),
          at,
        )
      } else if name == b"Float::of_int" || name == b"Float::of_bits" {
        let x = handed({ st: st, arg: a }, RInt, at);
        bound(
          cx,
          x.st,
          named_type(b"Float"),
          Prim({
            op: if name == b"Float::of_int" { b"to_float" } else { b"of_bits" },
            on: RInt,
            args: [x.arg],
          }),
          at,
        )
      } else if name == b"bits_of_float" {
        let x = handed({ st: st, arg: a }, RFloat, at);
        bound(cx, x.st, named_type(b"Int"), Prim({ op: b"bits", on: RFloat, args: [x.arg] }), at)
      } else if float_function(name) != None { float_called(st, name, args, at) }
      else if decimal_conversion(name) { decimal_converted(cx, st, name, a, at) }
      else if wrapping(name) || saturating(name) || name.starts_with(b"checked_") {
        width_arithmetic(cx, st, name, args, at)
      } else if name == b"to_int" { int_held(cx, st, args, at) }
      else if name == b"?numeric_binary" || name == b"?numeric_unary" {
        witnessed_operator(cx, st, name, args, at)
      } else if name == b"?stated_witness" { witnessed(cx, st, a, at) } else {
        match of_int_width(name) {
          Some(w) -> {
            let x = handed({ st: st, arg: a }, RInt, at);
            bound(cx, x.st, width_type(w), Prim({ op: b"of_int", on: RInt, args: [x.arg] }), at)
          },
          None -> match int_of_width(name) {
            Some(w) -> {
              let x = handed({ st: st, arg: a }, width_held(w), at);
              bound(
                cx,
                x.st,
                named_type(b"Int"),
                Prim({ op: b"to_int", on: width_held(w), args: [x.arg] }),
                at,
              )
            },
            None -> unreachable(b"a builtin no scalar's: ".concat(name)),
          },
        }
      }
    },
  }

/// Whether builtin `name` converts to or from a `Decimal` over its two words.
pub fn decimal_conversion(name: Bytes) -> Bool =
  name == b"Decimal::of_int" || name == b"Decimal::scale"

/// `Decimal::of_int` or `Decimal::scale` of `a`, over a `Decimal`'s two words.
fn decimal_converted(
  cx: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  at: Span,
) -> Lowered / {abort.raise} =
  if name == b"Decimal::of_int" {
    let x = handed({ st: st, arg: a }, RInt, at);
    bound(
      cx,
      x.st,
      named_type(b"Decimal"),
      Prim({ op: b"to_decimal", on: RInt, args: [x.arg] }),
      at,
    )
  } else {
    let d = handed({ st: st, arg: a }, RDec, at);
    bound(cx, d.st, named_type(b"Int"), Prim({ op: b"scale", on: RDec, args: [d.arg] }), at)
  }

/// The type builtin `name` answers called on operands of type `ty`: its declared scheme at that
/// type, or `known` where the setting declares no such builtin.
fn answer_of(cx: Context, name: Bytes, ty: Type, known: Type) -> Type =
  match declared_at(cx.setting, name, [ty]) { Some(t) -> t.ret, None -> known }

/// The witness of a type that states its own arithmetic, which the elaboration names by one of the
/// type's constructors written as a literal string: the runtime's first such witness past that
/// constructor's tag. The literal is read as the name it spells, never from the pool.
fn witnessed(cx: Context, st: Lowering, a: Arg, at: Span) -> Lowered / {abort.raise} =
  match read_literal(st, a) {
    None -> unreachable(b"a stated witness named by no literal"),
    Some(s) -> if !cx.setting.ctors.named.contains(s.name) {
      unreachable(b"a stated witness of a type no constructor names")
    } else {
      let tag = bound(cx, s.st, named_type(b"Int"), Tag(s.name), at);
      bound(cx, tag.st, named_type(b"Int"), Prim({ op: b"witness", on: RInt, args: [tag.arg] }), at)
    },
  }

/// The string `a` holds where the last instruction of `st` read it from the pool as a literal, and
/// `st` without that read, which nothing else reads.
fn read_literal(st: Lowering, a: Arg) -> Option<{ st: Lowering, name: Bytes }> =
  match a {
    AVar(v) -> match st.insts.at(st.insts.len() - 1) {
      Some(Let(l)) -> if l.var.id != v.id { None } else {
        match l.val {
          Literal(LStr(n)) ->
            Some({ st: { ..st, insts: st.insts.take(st.insts.len() - 1) }, name: n }),
          _ -> None,
        }
      },
      _ -> None,
    },
    _ -> None,
  }

/// Whether `numeric_of_int` at `ty` is a conversion written in place: at `Int`, `Float`, `Decimal`
/// or a width.
pub fn numeric_in_place(ctors: Ctors, ty: Type) -> Bool =
  match class_of(ctors, ty) {
    CInt -> true,
    CFloat -> true,
    CDec -> true,
    CWidth(_) -> true,
    _ -> false,
  }

/// `numeric_of_int(n)` at `ty`, where `numeric_in_place` holds: `n` itself at `Int`, else `n`
/// converted as `Float::of_int`, `Decimal::of_int` or the width's `of_int` converts it.
pub fn numeric_converted(
  cx: Context,
  st: Lowering,
  n: Arg,
  ty: Type,
  at: Span,
) -> Lowered / {abort.raise} = {
  let x = handed({ st: st, arg: n }, RInt, at);
  let converted = |op: Bytes| bound(cx, x.st, ty, Prim({ op: op, on: RInt, args: [x.arg] }), at);
  match class_of(cx.setting.ctors, ty) {
    CFloat -> converted(b"to_float"),
    CDec -> converted(b"to_decimal"),
    CWidth(_) -> converted(b"of_int"),
    _ -> x,
  }
}

/// What an operator over two values of a type does, read off the type alone: C's own over a scalar
/// a register holds, a character's word, a string's bytes or the constructor a word holds; a root
/// written for a declared sum or for a container; the runtime's over any other word.
type Class =
  | CInt
  | CBool
  | CWidth(Width)
  | CFloat
  | CDec
  | CChar
  | CText
  | CNullary(Type)
  | CSum(Type)
  | CWalked(Type)
  | CRecord(List<Field>)
  | CWord(Type)

/// Whether `==` of two values of `t` is built, or `compare` where `order`: no part of it is a type
/// variable or a value only the runtime reads (a runtime object or an extern type) but a kept value,
/// which compares as what it keeps does, and a secret, which only `==` compares. A function part
/// compares for equality by failing the run, as `==` at a type variable a function fills does, and
/// orders not at all; a sum stating a `key` compares through it alone.
pub fn comparison_built(ctors: Ctors, t: Type, order: Bool) -> Bool / {abort.raise} =
  iterate({ todo: [t], seen: [] }, 1 << 24, |s: { todo: List<Type>, seen: List<Bytes> }|
    match s.todo {
      [] -> Stop(true),
      [x, ..rest] -> match x {
        TyFn(_) -> if order { Stop(false) } else { Continue({ ..s, todo: rest }) },
        _ -> match class_of(ctors, x) {
          CRecord(fs) -> Continue({ ..s, todo: rest.concat(fs.map(|f: Field| f.ty)) }),
          CWalked(w) -> Continue({ ..s, todo: rest.concat(type_args(w)) }),
          CSum(w) -> match w {
            TyCon(c) -> if s.seen.contains(c.name) || keyed_sum(ctors, c.name) {
              Continue({ ..s, todo: rest })
            } else {
              let cs = match ctors.sums.get(c.name) { Some(found) -> found, None -> [] };
              Continue({
                todo: rest.concat(
                  cs.fold([], |acc: List<Type>, k: SumCtor|
                    acc.concat(k.fields.map(|f: Type| at_args(f, k.params, c.args)))),
                ),
                seen: s.seen.push(c.name),
              })
            },
            _ -> Continue({ ..s, todo: rest }),
          },
          CWord(w) -> if w == kept_type() || w == named_type(b"Unit") || w == TyRecord([])
              || (!order && is_secret(w)) { Continue({ ..s, todo: rest }) }
          else { Stop(false) },
          _ -> Continue({ ..s, todo: rest }),
        },
      },
    })

fn type_args(t: Type) -> List<Type> = match t { TyCon(c) -> c.args, _ -> [] }

fn class_of(ctors: Ctors, ty: Type) -> Class =
  match ty {
    TyRecord(fs) -> if fs.len() > 0 && !has_vars(ty) { CRecord(fs) } else { CWord(ty) },
    TyNominal(x) -> if x.fields.len() > 0 && !has_vars(ty) { CRecord(x.fields) } else { CWord(ty) },
    TyCon(c) -> if c.args.len() > 0 {
      if walked_container(ty) || walked_columns(ty) || is_result(ty)
          || (is_option(ty) && !has_vars(ty)) { CWalked(ty) }
      else if generic_sum(ctors, ty) { CSum(ty) }
      else { CWord(ty) }
    } else if c.name == b"Int" { CInt }
    else if c.name == b"Bool" { CBool }
    else if c.name == b"Float" { CFloat }
    else if c.name == b"Decimal" { CDec }
    else if c.name == b"Char" { CChar }
    else if c.name == b"String" || c.name == b"Bytes" { CText }
    else if compared_by_root(ctors, c.name) {
      // A keyed sum compares as its key does, never by which constructor it is.
      if nullary_sum(match ctors.sums.get(c.name) { Some(cs) -> cs, None -> [] })
          && !keyed_sum(ctors, c.name)
          && !numeric_sum(ctors, ty) { CNullary(ty) }
      else { CSum(ty) }
    } else { match width_named(c.name) { Some(w) -> CWidth(w), None -> CWord(ty) } },
    _ -> CWord(ty),
  }

/// `op` over `o` held as `on`, answering a value of `ty`.
fn alone(cx: Context, o: Lowered, op: Bytes, on: Rep, ty: Type, at: Span) -> Lowered = {
  let a = handed(o, on, at);
  bound(cx, a.st, ty, Prim({ op: op, on: on, args: [a.arg] }), at)
}

/// `l op r` as C's own over operands held as `on`, answering a value of `answer`. A shift's or a
/// rotation's count is an `Int` whatever it moves, so it stays as it is held.
fn over(
  cx: Context,
  l: Lowered,
  r: Lowered,
  op: Bytes,
  on: Rep,
  answer: Type,
  at: Span,
) -> Lowered = {
  let a = handed({ st: r.st, arg: l.arg }, on, at);
  let b = if counts(op) { { st: a.st, arg: r.arg } }
  else { handed({ st: a.st, arg: r.arg }, on, at) };
  bound(cx, b.st, answer, Prim({ op: op, on: on, args: [a.arg, b.arg] }), at)
}

/// `==`, or `!=`, through the root `key` names, which takes both operands as values of `ty` and
/// answers their equality.
fn equal_by(
  cx: Context,
  st: Lowering,
  op: Bytes,
  key: RootKey,
  ty: Type,
  args: List<Arg>,
  at: Span,
) -> Lowered = {
  let e = rooted(cx, st, key, args, [ty, ty], named_type(b"Bool"), at);
  if op == b"ne" { negation(cx, e, at) } else { e }
}

/// Operation `op` of the arithmetic the module of `ty` states, over `args` of `types`: a call of the
/// root written for it, which calls the function the module names.
pub fn stated(
  cx: Context,
  st: Lowering,
  op: Bytes,
  args: List<Arg>,
  types: List<Type>,
  ty: Type,
  at: Span,
) -> Lowered = rooted(cx, st, keys::written(Stated(op), ty, cx.setting.module), args, types, ty, at)

/// `l op r` over two values of `ty`: an order's comparison read off the sign of the order a root
/// written for the type answers; where none is, `==` and `!=` of functions fail the run, as no
/// function has equality, and at any other type are what only a specialisation computes; no other
/// operator is the type's.
fn ranked(
  cx: Context,
  l: Lowered,
  r: Lowered,
  op: Bytes,
  ty: Type,
  at: Span,
) -> Lowered / {abort.raise} =
  match if comparison(op) { by_root(cx, r.st, ty, l.arg, r.arg, at) } else { None } {
    None -> if op != b"eq" && op != b"ne" { lacking(r.st, op) }
    else if is_function(ty) { functions_compared(r.st, at) } else {
      let truth = named_type(b"Bool");
      unsettled(needing(r.st, ty), truth, held_as(cx.setting, truth), read_only([l.arg, r.arg]), at)
    },
    Some(o) -> {
      let s = bound(
        cx,
        o.st,
        named_type(b"Int"),
        Prim({ op: b"sign", on: rep_of_arg(o.arg), args: [o.arg] }),
        at,
      );
      bound(cx, s.st, named_type(b"Bool"), Prim({ op: op, on: RInt, args: [s.arg, AInt(0)] }), at)
    },
  }

/// The root `key` names called on `args`, of `types` in order, and answering a value of `answer`:
/// each crossing as a body holds a value of its type, as the root takes its parameters and answers.
fn rooted(
  cx: Context,
  st: Lowering,
  key: RootKey,
  args: List<Arg>,
  types: List<Type>,
  answer: Type,
  at: Span,
) -> Lowered = root_called(cx, st, key, args, types, answer, at, false)

/// `rooted`, where the root may stop for a handler that resumes it later where `stops`, handed
/// past `args` the `count` words of its row as `words.args` holds them.
fn root_called(
  cx: Context,
  st: Lowering,
  key: RootKey,
  args: List<Arg>,
  types: List<Type>,
  answer: Type,
  at: Span,
  stops: Bool,
  words: { count: Int, args: List<Arg> } = { count: 0, args: [] },
) -> Lowered = {
  let conv = evidenced(typed_convention(cx.setting.ctors, types, answer), 0, words.count);
  let given = range(0, args.len()).fold(
    { st: st, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, i: Int|
      match ((args.at(i), types.at(i))) {
        (Some(x), Some(t)) -> {
          let h = handed({ st: acc.st, arg: x }, held_as(cx.setting, t), at);
          { st: h.st, args: acc.args.push(h.arg) }
        },
        _ -> acc,
      },
  );
  bound_as(
    given.st,
    answer,
    conv.answer,
    Call({ callee: Root(key), args: given.args.concat(words.args), conv: conv, stops: stops }),
    at,
  )
}

fn negation(cx: Context, b: Lowered, at: Span) -> Lowered =
  bound(cx, b.st, named_type(b"Bool"), Prim({ op: b"not", on: RBool, args: [b.arg] }), at)

/// `compare(a, b)`, or `compare_values`, at the type its operands hold: through the root written
/// for a declared sum, a container, an `Option` or a `Result` known throughout, which answers the
/// `Ordering`; at any other type the sign `sign_at` writes made its `Ordering`.
fn ordered(
  cx: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  b: Arg,
  at: Span,
) -> Lowered / {abort.raise} = {
  let ty = match a { AInt(_) -> type_of(b), _ -> type_of(a) };
  let order = answer_of(cx, name, ty, named_type(b"Ordering"));
  let made = |s: Lowered|
    bound(cx, s.st, order, Prim({ op: b"ordering", on: RInt, args: [s.arg] }), at);
  if unsaid(ty) { open_at(cx, st, ty, [a, b], order, at) } else {
    match by_root(cx, st, ty, a, b, at) {
      Some(o) -> o,
      None -> match class_of(cx.setting.ctors, ty) {
        CRecord(fs) -> made(fields_order(cx, st, fs, a, b, at)),
        _ -> made(sign_at(cx, { st: st, arg: a }, { st: st, arg: b }, ty, at)),
      },
    }
  }
}

/// A builtin over `args` at `ty`, a type a body generic over it leaves unsaid, answering a value of
/// `answer`: what only the specialisations its callers settle compute.
fn open_at(
  cx: Context,
  st: Lowering,
  ty: Type,
  args: List<Arg>,
  answer: Type,
  at: Span,
) -> Lowered = unsettled(needing(st, ty), answer, held_as(cx.setting, answer), read_only(args), at)

/// The sign of the order of two kept values `a` and `b`, as their type orders what they keep: the
/// runtime's `?kept_order`, borrowing both.
fn kept_sign(st: Lowering, a: Arg, b: Arg, at: Span) -> Lowered = {
  let l = handed({ st: st, arg: a }, RWord, at);
  let r = handed({ st: l.st, arg: b }, RWord, at);
  bound_as(
    r.st,
    named_type(b"Int"),
    RInt,
    Native({
      name: b"builtin_elaborated_kept_order_p",
      args: [l.arg, r.arg],
      uses: { takes: [false, false], owned: true, fails: true, stops: false },
    }),
    at,
  )
}

/// `max(a, b)`, or `min(a, b)` where not `most`: the one `compare` orders last or first, `a` where
/// they are equal, ordered at the type they hold as `compare` orders them.
fn extreme(
  cx: Context,
  st: Lowering,
  most: Bool,
  a: Arg,
  b: Arg,
  at: Span,
) -> Lowered / {abort.raise} = {
  let ty = match a { AInt(_) -> type_of(b), _ -> type_of(a) };
  let s = match class_of(cx.setting.ctors, ty) {
    CRecord(fs) -> fields_order(cx, st, fs, b, a, at),
    _ -> sign_at(cx, { st: st, arg: b }, { st: st, arg: a }, ty, at),
  };
  let past = bound(
    cx,
    s.st,
    named_type(b"Bool"),
    Prim({ op: if most { b"gt" } else { b"lt" }, on: RInt, args: [s.arg, AInt(0)] }),
    at,
  );
  joined(cx, past, { st: opened(past.st), arg: b }, { st: opened(past.st), arg: a }, false, at)
}

/// The order of `a` and `b` where a root written for their type answers it: a declared sum, a
/// container, an `Option` or a `Result` known throughout.
fn by_root(cx: Context, st: Lowering, ty: Type, a: Arg, b: Arg, at: Span) -> Option<Lowered> = {
  let order = named_type(b"Ordering");
  let at_root = |op: TypeOp, t: Type|
    Some(rooted(cx, st, keys::written(op, t, cx.setting.module), [a, b], [t, t], order, at));
  match class_of(cx.setting.ctors, ty) {
    CNullary(t) -> at_root(Order, t),
    CSum(t) -> at_root(Order, t),
    CWalked(t) -> at_root(Contained(b"ordered"), t),
    CWord(t) -> if is_option(t) && !has_vars(t) { at_root(Contained(b"ordered"), t) } else { None },
    _ -> None,
  }
}

/// The sign of `l` and `r`'s order, an `Int` below, at or above zero, at their type, which is no
/// record's (`fields_order` walks a record's fields): in C where C orders it, a `Float` by its bits
/// in IEEE 754's total order; read off the `Ordering` a root answers; zero for a type of one value;
/// and what a specialisation computes at a type left unsaid. The checker derives no order for a
/// function, a credential or a runtime object, so none reaches here.
fn sign_at(cx: Context, l: Lowered, r: Lowered, ty: Type, at: Span) -> Lowered / {abort.raise} = {
  let int = named_type(b"Int");
  let signed = |o: Lowered|
    bound(cx, o.st, int, Prim({ op: b"sign", on: rep_of_arg(o.arg), args: [o.arg] }), at);
  if unsaid(ty) { signed(open_at(cx, r.st, ty, [l.arg, r.arg], named_type(b"Ordering"), at)) }
  else {
    match by_root(cx, r.st, ty, l.arg, r.arg, at) {
      Some(o) -> signed(o),
      None -> match class_of(cx.setting.ctors, ty) {
        CInt -> over(cx, l, r, b"order", RInt, int, at),
        CBool -> over(cx, l, r, b"order", RBool, int, at),
        CChar -> over(cx, l, r, b"order", RImm, int, at),
        CWidth(w) -> over(cx, l, r, b"order", width_held(w), int, at),
        CDec -> over(cx, l, r, b"order", RDec, int, at),
        CText -> over(cx, l, r, b"bytes_order", RWord, int, at),
        CFloat -> {
          let x = total_key(cx, { st: r.st, arg: l.arg }, at);
          let y = total_key(cx, { st: x.st, arg: r.arg }, at);
          bound(cx, y.st, int, Prim({ op: b"order", on: RInt, args: [x.arg, y.arg] }), at)
        },
        _ -> if held_as(cx.setting, ty) == RUnit { { st: r.st, arg: AInt(0) } }
        else if ty == kept_type() { kept_sign(r.st, l.arg, r.arg, at) }
        else { unreachable(b"an order of a type none is derived for: ".concat(spelled_type(ty))) },
      },
    }
  }
}

/// A `Float`'s bits as a word that orders as IEEE 754's total order does, every NaN read as one:
/// a negative one's magnitude bits flipped.
fn total_key(cx: Context, f: Lowered, at: Span) -> Lowered = {
  let int = named_type(b"Int");
  let x = handed(f, RFloat, at);
  let bits = bound(cx, x.st, int, Prim({ op: b"bits", on: RFloat, args: [x.arg] }), at);
  let sign = bound(
    cx,
    bits.st,
    int,
    Prim({ op: b"shr", on: RInt, args: [bits.arg, AInt(63)] }),
    at,
  );
  let flips = bound(
    cx,
    sign.st,
    int,
    Prim({ op: b"ushr", on: RInt, args: [sign.arg, AInt(1)] }),
    at,
  );
  bound(cx, flips.st, int, Prim({ op: b"bitxor", on: RInt, args: [bits.arg, flips.arg] }), at)
}

/// `reflect(a)` or `shown(a)` at the type `a` holds, where the program holds `std.value`: a scalar
/// as its constructor of the value, a width as its bits and name, a declared sum, a container and a
/// record through a root, a hold and a credential as what stands for one, and a function as an
/// anonymous one, which is all a function the program wrote says of itself; what a specialisation
/// computes at a type left unsaid. The checker reflects no runtime object, which no `Value`
/// describes.
fn reflected(cx: Context, st: Lowering, name: Bytes, a: Arg, at: Span) -> Lowered / {abort.raise} = {
  let ty = type_of(a);
  // The builtin answers `std.value`'s `Value` whatever a module of the program names `reflect`.
  let value_type = named_type(b"std.value.Value");
  let op = if name == b"shown" { Shown } else { Reflect };
  let value = |ctor: Bytes| constructed_as(cx, st, ctor, [a], value_type, at);
  let alone = |ctor: Bytes| constructed_as(cx, st, ctor, [], value_type, at);
  let none = || unreachable(b"a reflection of a value none describes: ".concat(spelled_type(ty)));
  if !cx.setting.ctors.named.contains(b"std.value.VUnit") {
    unreachable(b"a reflection in a program that holds no `std.value`")
  } else {
    match ty {
      TyFn(_) -> {
        let f = constructed_as(
          cx,
          st,
          b"std.value.FAnonymous",
          [],
          named_type(b"std.value.Fun"),
          at,
        );
        constructed_as(cx, f.st, b"std.value.VFn", [f.arg], value_type, at)
      },
      TyCon(c) -> if c.name == b"Hold" { alone(b"std.value.VHold") }
      else if c.name == b"Secret" { alone(b"std.value.VSecret") }
      else if unsaid(ty) { open_at(cx, st, ty, [a], value_type, at) }
      else if written_sum(cx.setting.ctors, c) || walked_container(ty) || walked_columns(ty) {
        written(cx, st, op, ty, a, at)
      } else if c.args.len() > 0 { none() }
      else if c.name == b"Int" { value(b"std.value.VInt") }
      else if c.name == b"Bool" { value(b"std.value.VBool") }
      else if c.name == b"Float" { value(b"std.value.VFloat") }
      else if c.name == b"Decimal" { value(b"std.value.VDecimal") }
      else if c.name == b"Char" { value(b"std.value.VChar") }
      else if c.name == b"String" { value(b"std.value.VStr") }
      else if c.name == b"Bytes" { value(b"std.value.VBytes") }
      else if c.name == b"Unit" { alone(b"std.value.VUnit") } else {
        match width_named(c.name) {
          Some(w) -> width_reflected(cx, st, c.name, w, a, value_type, at),
          None -> none(),
        }
      },
      _ -> if unsaid(ty) { open_at(cx, st, ty, [a], value_type, at) }
      else { written(cx, st, op, ty, a, at) },
    }
  }
}

/// A width reflected: its bits with nothing above them as a `U128`, a signed one's cut to its width,
/// and its type's name.
fn width_reflected(
  cx: Context,
  st: Lowering,
  name: Bytes,
  w: Width,
  a: Arg,
  value_type: Type,
  at: Span,
) -> Lowered / {abort.raise} = {
  let int = named_type(b"Int");
  let u128 = named_type(b"U128");
  let made = |s: Lowering, lo: Arg, hi: Arg|
    bound(cx, s, u128, Prim({ op: b"wide", on: RInt, args: [lo, hi] }), at);
  let wide = if w.bits > 64 {
    let p = pair_words(st, a, RWide(w), at);
    made(p.st, p.lo, p.hi)
  } else if w.bits == 64 {
    let x = alone(cx, { st: st, arg: a }, b"narrow", RNum(w), int, at);
    made(x.st, x.arg, AInt(0))
  } else {
    let x = alone(cx, { st: st, arg: a }, b"to_int", RNum(w), int, at);
    let bits = if !w.signed { x } else {
      bound(
        cx,
        x.st,
        int,
        Prim({ op: b"bitand", on: RInt, args: [x.arg, AInt((1 << w.bits) - 1)] }),
        at,
      )
    };
    made(bits.st, bits.arg, AInt(0))
  };
  let spelled = literal(cx, wide.st, LStr(name), at);
  constructed_as(cx, spelled.st, b"std.value.VFixed", [spelled.arg, wide.arg], value_type, at)
}

/// `digest(a)`, or `?encoded(a)` where `hashed` is false: the encoding of a declared sum, a container
/// or a record written by the root for its type, a scalar's by the runtime's native over its words,
/// then hashed; what a specialisation computes at a type left unsaid. The checker derives no hash
/// for a `Float`, a function, a credential or a runtime object, so none reaches here.
fn encoded(cx: Context, st: Lowering, hashed: Bool, a: Arg, at: Span) -> Lowered / {abort.raise} = {
  let ty = type_of(a);
  let bytes = answer_of(cx, if hashed { b"digest" } else { b"?encoded" }, ty, named_type(b"Bytes"));
  let rooted_by = match ty {
    TyCon(c) -> written_sum(cx.setting.ctors, c) || walked_container(ty) || walked_columns(ty),
    TyRecord(_) -> true,
    TyNominal(_) -> true,
    _ -> false,
  };
  if unsaid(ty) { open_at(cx, st, ty, [a], bytes, at) } else {
    match if rooted_by { Some(written(cx, st, Digest, ty, a, at)) }
      else { scalar_encoding(cx, st, a, ty, at) } {
      Some(e) -> if hashed { blake3_of(e.st, e.arg, at) } else { e },
      None -> unreachable(b"a digest of a type none is derived for: ".concat(spelled_type(ty))),
    }
  }
}

/// What the root written for `op` of a value of `ty` answers for `a`.
fn written(cx: Context, st: Lowering, op: TypeOp, ty: Type, a: Arg, at: Span) -> Lowered =
  rooted(
    cx,
    st,
    keys::written(op, ty, cx.setting.module),
    [a],
    [ty],
    match op { Digest -> named_type(b"Bytes"), _ -> named_type(b"std.value.Value") },
    at,
  )

/// `a`, a resource, let go: its type's `LetGo` root called on it and on the words the body holds
/// for what the releases it calls perform, which only a specialisation settles where a type
/// variable leaves the type open.
pub fn let_go(cx: Context, st: Lowering, a: Arg, at: Span) -> Lowered / {abort.raise} = {
  let ty = type_of(a);
  if has_vars(ty) {
    unsettled(needing(st, ty), unit_type(), held_as(cx.setting, unit_type()), read_only([a]), at)
  } else {
    let h = let_go_handing(cx, ty);
    let w = words_handed(st, h, at);
    // A release may perform what a clause answers by stopping.
    let words = { count: h.words.len(), args: w.args };
    root_called(cx, w.st, let_go_root(cx, ty), [a], [ty], unit_type(), at, true, words)
  }
}

/// What a failure lets go of `a`, a resource, made after `st` at `at`: its type's `LetGo` root,
/// called as `let_go` calls it.
pub fn unwound(
  cx: Context,
  st: Lowering,
  a: Arg,
  at: Span,
) -> { st: Lowering, unwound: Unwound } / {abort.raise} = {
  let ty = type_of(a);
  let h = let_go_handing(cx, ty);
  let w = words_handed(needing(st, ty), h, at);
  {
    st: w.st,
    unwound: {
      arg: a,
      words: w.args,
      callee: let_go_root(cx, ty),
      conv: evidenced(typed_convention(cx.setting.ctors, [ty], unit_type()), 0, h.words.len()),
    },
  }
}

fn let_go_root(cx: Context, ty: Type) -> RootKey = keys::written(LetGo, ty, cx.setting.module)

/// What a call of `ty`'s `LetGo` root hands it past the value, as the root's definition is declared
/// where it is written: a word for each operation the releases it calls perform.
fn let_go_handing(cx: Context, ty: Type) -> Handing / {abort.raise} =
  handing_scheme(
    cx,
    Some(monomorphic(fn_type([ty], unit_type(), release_row(cx.setting.ctors, ty)))),
    [],
    [],
  )

/// A width's or an `Int`'s wrapping, saturating or checked builtin at the type its operands hold, in C
/// where a register holds the value, checked below 64 bits exactly in a word, at 64 bits by C's
/// overflow tests and at 128 bits over the width's two words. The check admits no other type.
fn width_arithmetic(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  at: Span,
) -> Lowered / {abort.raise} = {
  let a = match args.at(0) { Some(x) -> x, None -> AInt(0) };
  let b = match args.at(1) { Some(x) -> x, None -> AInt(0) };
  let ty = match a { AInt(_) -> type_of(b), _ -> type_of(a) };
  let checked = name.starts_with(b"checked_");
  let answer = answer_of(cx, name, ty, if checked { TyCon({ name: b"Option", args: [ty] }) }
  else { ty });
  match class_of(cx.setting.ctors, ty) {
    CWidth(w) -> if w.bits > 64 {
      if checked {
        checked_in_place(cx, st, name, a, b, { ty: ty, held: RWide(w), on: RWide(w) }, answer, at)
      } else { over(cx, { st: st, arg: a }, { st: st, arg: b }, name, RWide(w), ty, at) }
    } else if wrapping(name) || (saturating(name) && w.bits == 64) {
      over(cx, { st: st, arg: a }, { st: st, arg: b }, name, RNum(w), ty, at)
    } else if w.bits == 64 {
      checked_in_place(cx, st, name, a, b, { ty: ty, held: RNum(w), on: RNum(w) }, answer, at)
    } else if checked { checked_width(cx, st, name, a, b, w, answer, at) }
    else { over(cx, { st: st, arg: a }, { st: st, arg: b }, name, RNum(w), ty, at) },
    // An `Int` wraps and saturates as the 64-bit signed width its register holds.
    CInt -> if wrapping(name) || saturating(name) {
      let x = handed({ st: st, arg: a }, RInt, at);
      let y = if counts(name) { { st: x.st, arg: b } }
      else { handed({ st: x.st, arg: b }, RInt, at) };
      bound(
        cx,
        y.st,
        ty,
        Prim({ op: name, on: RNum({ bits: 64, signed: true }), args: [x.arg, y.arg] }),
        at,
      )
    } else {
      let word = RNum({ bits: 64, signed: true });
      checked_in_place(cx, st, name, a, b, { ty: ty, held: RInt, on: word }, answer, at)
    },
    _ -> unreachable(b"an integer's builtin at a type that is no integer: ".concat(name)),
  }
}

/// `to_int(x)`, the elaboration's witness first, at the integer type `x` holds: `Some` of it at
/// `Int` and at a width every value of which an `Int` holds, and at a wider one `Some` where the
/// `Int` holds it and `None` where it does not.
fn int_held(cx: Context, st: Lowering, args: List<Arg>, at: Span) -> Lowered / {abort.raise} =
  match args {
    [_, x] -> {
      let ty = type_of(x);
      let int = named_type(b"Int");
      let option = answer_of(cx, b"to_int", ty, TyCon({ name: b"Option", args: [int] }));
      let some = |l: Lowered| constructed_as(cx, l.st, prelude_ctor(b"Some"), [l.arg], option, at);
      match class_of(cx.setting.ctors, ty) {
        CInt -> some(handed({ st: st, arg: x }, RInt, at)),
        CWidth(w) -> if w.bits < 64 || (w.bits == 64 && w.signed) {
          some(alone(cx, { st: st, arg: x }, b"to_int", RNum(w), int, at))
        } else {
          let h = handed({ st: st, arg: x }, width_held(w), at);
          let fits = bound(
            cx,
            h.st,
            named_type(b"Bool"),
            if w.bits == 64 {
              Prim({
                op: b"le",
                on: RNum(w),
                args: [h.arg, ANum({ width: w, bits: 9223372036854775807 })],
              })
            } else { Prim({ op: b"fits_int", on: RWide(w), args: [h.arg] }) },
            at,
          );
          let value = bound(
            cx,
            opened(fits.st),
            int,
            Prim({
              op: if w.bits == 64 { b"narrow" } else { b"lo" },
              on: width_held(w),
              args: [h.arg],
            }),
            at,
          );
          some_where(cx, fits, value, option, at)
        },
        _ -> if has_vars(ty) {
          left_to_callers(cx, st, b"to_int", args, { params: args.map(type_of), ret: option }, at)
        } else { unreachable(b"`to_int` at a type that is no integer") },
      }
    },
    _ -> unreachable(b"`to_int` called other than with a witness and a value"),
  }

/// An operator the elaboration wrote over the witness of a `numeric` or `integer` parameter,
/// `?numeric_binary(op, witness, x, y)` or `?numeric_unary(op, witness, x)`: where its operands'
/// type is known, that type's operator as written at it; where a type variable leaves it open, what
/// only a specialisation computes.
fn witnessed_operator(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  at: Span,
) -> Lowered / {abort.raise} =
  match args {
    [AInt(k), _, x, y] -> match numeric_ops_numbered().at(k) {
      None -> unreachable(b"an operator over a witness numbered as none is"),
      Some(op) -> {
        let ty = match x { AInt(_) -> type_of(y), _ -> type_of(x) };
        if !has_vars(ty) { binary(cx, { st: st, arg: x }, { st: st, arg: y }, op, at) } else {
          left_to_callers(
            cx,
            st,
            name,
            args,
            {
              params: args.map(type_of),
              ret: if comparison(op) { named_type(b"Bool") } else { ty },
            },
            at,
          )
        }
      },
    },
    [AInt(k), _, x] -> if !has_vars(type_of(x)) {
      unary(cx, { st: st, arg: x }, if k == 1 { b"bitnot" } else { b"neg" }, at)
    } else {
      left_to_callers(cx, st, name, args, { params: args.map(type_of), ret: type_of(x) }, at)
    },
    _ -> unreachable(b"an operator over a witness written other than as the elaboration writes it"),
  }

/// A width's checked arithmetic below 64 bits, answering an `Option` of type `option`: exact in 64
/// bits, `Some` of the answer where the width holds it and `None` where it does not. Only an
/// unsigned 32-bit product needs the unsigned word, and it can only pass the greatest value.
fn checked_width(
  cx: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  b: Arg,
  w: Width,
  option: Type,
  at: Span,
) -> Lowered / {abort.raise} = {
  let ty = width_type(w);
  let neg = name == b"checked_neg";
  let unsigned = !w.signed && name == b"checked_mul";
  let word = { bits: 64, signed: false };
  let x = handed({ st: st, arg: a }, RNum(w), at);
  let y = if neg { x } else { handed({ st: x.st, arg: b }, RNum(w), at) };
  let exact = bound(
    cx,
    y.st,
    if unsigned { named_type(b"U64") } else { named_type(b"Int") },
    Prim({
      op: if neg { b"exact_neg" }
      else if name == b"checked_add" { b"exact_add" }
      else if name == b"checked_sub" { b"exact_sub" }
      else { b"exact_mul" },
      on: RNum(w),
      args: if neg { [x.arg] } else { [x.arg, y.arg] },
    }),
    at,
  );
  let fits = bound(
    cx,
    exact.st,
    named_type(b"Bool"),
    if unsigned {
      Prim({ op: b"le", on: RNum(word), args: [exact.arg, ANum({ width: word, bits: most(w) })] })
    } else { Prim({ op: b"within", on: RInt, args: [exact.arg, AInt(least(w)), AInt(most(w))] }) },
    at,
  );
  let narrowed = bound(
    cx,
    opened(fits.st),
    ty,
    Prim({ op: b"narrow", on: rep_of_arg(exact.arg), args: [exact.arg] }),
    at,
  );
  some_where(cx, fits, narrowed, option, at)
}

/// The checked arithmetic of an `Int`, a 64-bit width or a 128-bit width, its operands of type
/// `k.ty` held as `k.held` and operated on as `k.on`, answering an `Option` of type `option`:
/// whether the exact answer fits, as C or the runtime over the words tests it, and `Some` of the
/// wrapped answer there, which is the exact one.
fn checked_in_place(
  cx: Context,
  st: Lowering,
  name: Bytes,
  a: Arg,
  b: Arg,
  k: { ty: Type, held: Rep, on: Rep },
  option: Type,
  at: Span,
) -> Lowered / {abort.raise} = {
  let neg = name == b"checked_neg";
  let x = handed({ st: st, arg: a }, k.held, at);
  let y = if neg { x } else { handed({ st: x.st, arg: b }, k.held, at) };
  let fits = bound(
    cx,
    y.st,
    named_type(b"Bool"),
    Prim({ op: name, on: k.on, args: if neg { [x.arg] } else { [x.arg, y.arg] } }),
    at,
  );
  let wrapped = bound(
    cx,
    opened(fits.st),
    k.ty,
    Prim({
      op: if neg || name == b"checked_sub" { b"wrap_sub" }
      else if name == b"checked_add" { b"wrap_add" }
      else { b"wrap_mul" },
      on: k.on,
      args: if neg { [AZero(k.held), x.arg] } else { [x.arg, y.arg] },
    }),
    at,
  );
  some_where(cx, fits, wrapped, option, at)
}

/// `Some(value)` of type `option` where `fits` holds and `None` where it does not, `value` lowered
/// in a block of its own after `fits`.
fn some_where(
  cx: Context,
  fits: Lowered,
  value: Lowered,
  option: Type,
  at: Span,
) -> Lowered / {abort.raise} = {
  let some = constructed_as(cx, value.st, prelude_ctor(b"Some"), [value.arg], option, at);
  let none = constructed_as(
    cx,
    continued(opened(fits.st), some.st),
    prelude_ctor(b"None"),
    [],
    option,
    at,
  );
  let j = fresh(continued(fits.st, none.st), option, held_as(cx.setting, option));
  let t = set_join(j.st, some, j.var, at);
  let e = set_join(t.st, none, j.var, at);
  {
    st: {
      ..e.st,
      insts: fits.st.insts.push(Decl(j.var)).push(
        If({ cond: fits.arg, then: t.block, otherwise: e.block }),
      ),
    },
    arg: AVar(j.var),
  }
}

/// The least value width `w` holds, below 64 bits.
fn least(w: Width) -> Int = if w.signed { 0 - (1 << w.bits - 1) } else { 0 }

/// The greatest value width `w` holds, below 64 bits.
fn most(w: Width) -> Int = if w.signed { (1 << w.bits - 1) - 1 } else { (1 << w.bits) - 1 }

fn lacking(st: Lowering, op: Bytes) -> Lowered / {abort.raise} =
  unreachable(b"an operator its operands' type does not have: ".concat(op))

/// `st` noting that a specialisation reads each type variable the operator meets as the type itself.
fn needing(st: Lowering, ty: Type) -> Lowering =
  match ty {
    TyVar(v) -> if v < 0 { st } else { noted(st, { var: v, reads: Exact }) },
    _ -> type_vars(ty).fold(st, |s: Lowering, v: Int| noted(s, { var: v, reads: Exact })),
  }

/// Whether `op`'s second operand is a count, an `Int` whatever the first is.
fn counts(op: Bytes) -> Bool = shift(op) || op == b"rotl" || op == b"rotr"

fn wrapping(name: Bytes) -> Bool =
  name == b"wrap_add" || name == b"wrap_sub" || name == b"wrap_mul" || name == b"rotr"
    || name == b"rotl"

fn saturating(name: Bytes) -> Bool =
  name == b"saturating_add" || name == b"saturating_sub" || name == b"saturating_mul"

fn arity(name: Bytes) -> Int =
  if name == b"compare" || name == b"compare_values" || name == b"?same" || name == b"min"
      || name == b"max"
      || wrapping(name)
      || saturating(name)
      || (name.starts_with(b"checked_") && name != b"checked_neg") { 2 }
  else if name == b"to_int" { 2 }
  else if name == b"?numeric_binary" { 4 }
  else if name == b"?numeric_unary" { 3 }
  else { match float_function(name) { Some(f) -> f.operands, None -> 1 } }

/// `Float` function `name` over `args`: each operand handed its native as its bits, and the bits
/// the native answers the `Float` the call does.
fn float_called(st: Lowering, name: Bytes, args: List<Arg>, at: Span) -> Lowered / {abort.raise} =
  match float_function(name) {
    None -> unreachable(b"no Float function: ".concat(name)),
    Some(f) -> float_native_called(st, f, args, at),
  }

fn float_native_called(
  st: Lowering,
  f: FloatFunction,
  args: List<Arg>,
  at: Span,
) -> Lowered / {abort.raise} = {
  let given = args.fold({ st: st, bits: [] }, |acc: { st: Lowering, bits: List<Arg> }, a: Arg| {
    let x = handed({ st: acc.st, arg: a }, RFloat, at);
    let b = bound_as(
      x.st,
      named_type(b"Int"),
      RInt,
      Prim({ op: b"bits", on: RFloat, args: [x.arg] }),
      at,
    );
    { st: b.st, bits: acc.bits.push(b.arg) }
  });
  let answered = bound_as(
    given.st,
    named_type(b"Int"),
    RInt,
    Native({
      name: builtin_helper(f.native).concat(b"_p"),
      args: given.bits,
      uses: { takes: given.bits.map(|_: Arg| false), owned: true, fails: false, stops: false },
    }),
    at,
  );
  bound_as(
    answered.st,
    named_type(b"Float"),
    RFloat,
    Prim({ op: b"of_bits", on: RInt, args: [answered.arg] }),
    at,
  )
}

/// The divisor an `Int` division or remainder takes as a literal where it is a negated one:
/// C's own operator then divides by it.
fn divisor(op: Bytes, rhs: Code) -> Option<Int> =
  if op != b"div" && op != b"rem" { None } else {
    match rhs.node {
      NUnary(u) -> if u.op != b"neg" { None } else {
        match u.operand.node {
          NLit(l) -> match l {
            LInt(v) -> if v == 0 || v == 1 { None } else { Some(0 - v) },
            _ -> None,
          },
          _ -> None,
        }
      },
      _ -> None,
    }
  }

/// The type a width is.
fn width_type(w: Width) -> Type =
  named_type(
    Bytes::concat_all([
      if w.signed { b"I" } else { b"U" },
      if w.bits == 8 { b"8" }
      else if w.bits == 16 { b"16" }
      else if w.bits == 32 { b"32" }
      else if w.bits == 64 { b"64" }
      else { b"128" },
    ]),
  )

fn of_int_width(name: Bytes) -> Option<Width> =
  [b"U8", b"U16", b"U32", b"U64", b"I8", b"I16", b"I32", b"I64", b"U128", b"I128"].fold(
    None,
    |acc: Option<Width>, w: Bytes| if name == w.concat(b"::of_int") { width_named(w) } else { acc },
  )

fn int_of_width(name: Bytes) -> Option<Width> =
  [b"U8", b"U16", b"U32", b"U64", b"I8", b"I16", b"I32", b"I64", b"U128", b"I128"].fold(
    None,
    |acc: Option<Width>, w: Bytes|
      if name
          == Bytes::concat_all([
            b"Int::of_",
            if w.starts_with(b"U") { b"u" } else { b"i" },
            digits_of(w),
          ]) { width_named(w) }
      else { acc },
  )

/// A width's name past its sign.
fn digits_of(w: Bytes) -> Bytes =
  if w.ends_with(b"128") { b"128" }
  else if w.ends_with(b"16") { b"16" }
  else if w.ends_with(b"32") { b"32" }
  else if w.ends_with(b"64") { b"64" }
  else { b"8" }

fn is_option(t: Type) -> Bool =
  match t { TyCon(c) -> c.name == b"Option" && c.args.len() == 1, _ -> false }

/// Whether `==` and `compare` of two values of `t` walk them through roots written for `t`: a
/// `List`, an `Array` or a `Map` whose type is known throughout.
pub fn walked_container(t: Type) -> Bool =
  !has_vars(t)
    && (match t {
      TyCon(c) -> c.name == b"List" || c.name == b"Array" || c.name == b"Map",
      _ -> false,
    })

/// Whether `t` is a `Columns` known throughout, which every operation per type walks record by
/// record as the array of its records, through the roots written for it.
pub fn walked_columns(t: Type) -> Bool =
  !has_vars(t) && (match t { TyCon(c) -> c.name == b"Columns" && c.args.len() == 1, _ -> false })

fn is_result(t: Type) -> Bool =
  !has_vars(t) && (match t { TyCon(c) -> c.name == b"Result" && c.args.len() == 2, _ -> false })
