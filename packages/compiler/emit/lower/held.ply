//! How a value of a type is held in a body and crosses a call between roots, and where a record's
//! field or a sum's case's argument lies, each as `reps.laid` lays the type out. A record held as
//! its leaves names each leaf by its field, and the leaves of a record it holds by `field.leaf`, so a
//! flat representation spells the layout it was flattened from.

import check.types (Type, TyVar, TyCon, TyRecord, TyNominal, Field, int_type, option_type,
                    string_type)
import emit.reps (SumCtor, Ctors, kind_of, laid_known, ctors_of)
import emit.c (Kind, KInt, KBool, KNum, KFloat, KDec)
import emit.tir (Rep, RInt, RBool, RNum, RFloat, RDec, RWord, RFlat, Leaf, RSum, RUnit, RSlice,
                 RImm, Convention, Given, Owned, parts_of)
import emit.layout (Laid, LSum, LRecord, LWords, FieldLaid, P, U, Always, Inline, Boxed, Nullary,
                    SumLaid, words, register_words, raw, counts)
import emit.lower.setting (Setting)

/// How a value of `ty` is held in a body, and so how it crosses a call: `held_with` the setting's
/// constructor table.
pub fn held_as(s: Setting, ty: Type) -> Rep = held_with(s.ctors, ty)

/// How a root whose parameters are of `params` and whose answer is of `answer` takes and answers
/// them: each held as a body holds a value of its type, given, and the answer owned. A root is
/// lowered to it and every call of the root is written to it, a root written for a type among them,
/// so a call's head and its callee's are one.
pub fn typed_convention(ctors: Ctors, params: List<Type>, answer: Type) -> Convention =
  {
    params: params.map(|_: Type| Given),
    reps: params.map(|t: Type| held_with(ctors, t)),
    answer: held_with(ctors, answer),
    answered: Owned,
  }

/// How a value of `ty` is held, as `reps.laid` lays the type out over the constructor table
/// `ctors`: a value of no words in none; a record as its leaves, or past `flat_leaves` of them as
/// the box its word form is; a declared sum as its words; a scalar as itself, one C holds in no type
/// of its own as a word holding no count; and a pointer, and any value whose layout a type variable
/// leaves open, as a word.
pub fn held_with(ctors: Ctors, ty: Type) -> Rep = held_boxing(ctors, ty, true)

/// The most leaves a record value is held as: a wider one is held as its box, so a join, a move or
/// a failure path handles one word of it rather than each leaf.
pub fn flat_leaves() -> Int = 32

/// `held_with`, a record past `flat_leaves` held as its box where `boxing`, else as its leaves.
fn held_boxing(ctors: Ctors, ty: Type, boxing: Bool) -> Rep =
  match laid_known(ctors, ty) { None -> RWord, Some(l) -> held_laid(ctors, ty, l, boxing) }

/// `held_boxing` of a value of `ty` laid as `l`, each field of a record held as the layout it has
/// there says, so no field is laid out again.
fn held_laid(ctors: Ctors, ty: Type, l: Laid, boxing: Bool) -> Rep =
  if words(l) == 0 { RUnit } else {
    match l {
      LSum(x) -> RSum({ laid: x, cases: case_names(ctors, ty) }),
      LRecord(fs) -> {
        let ls = record_leaves(ctors, ty, fs);
        if boxing && ls.len() > flat_leaves() { RWord } else { RFlat(ls) }
      },
      LWords(_) -> match slot_rep(kind_of(ty).kind) {
        RWord -> if counts(l) { RWord } else { RImm },
        r -> r,
      },
    }
  }

/// The leaves a record of type `ty` is laid in, however wide: what its box holds where it is held as
/// one; none for a value of any other type.
pub fn laid_leaves(ctors: Ctors, ty: Type) -> Option<List<Leaf>> =
  match held_boxing(ctors, ty, false) { RFlat(ls) -> Some(ls), _ -> None }

/// How a value of `ty` lies where a layout lays it in place, a sum's payload among them: a record
/// as its leaves however wide, anything else as `held_with` holds it.
pub fn laid_held(ctors: Ctors, ty: Type) -> Rep = held_boxing(ctors, ty, false)

/// The constructors of the declared sum `ty`, as the table names them, in their declared order.
fn case_names(ctors: Ctors, ty: Type) -> List<Bytes> =
  match ty {
    TyCon(c) -> match ctors.sums.get(c.name) {
      Some(cs) -> cs.map(|x: SumCtor| x.name),
      None -> [],
    },
    _ -> [],
  }

/// How a scalar of kind `k` is held: in its own C type, or as a word.
fn slot_rep(k: Kind) -> Rep =
  match k {
    KInt -> RInt,
    KBool -> RBool,
    KNum(w) -> RNum(w),
    KFloat -> RFloat,
    KDec -> RDec,
    _ -> RWord,
  }

/// The fields of a record type, in the checker's order (sorted by name); none for any other type.
fn record_fields(ty: Type) -> List<Field> =
  match ty { TyRecord(fs) -> fs, TyNominal(x) -> x.fields, _ -> [] }

/// The leaves of a record of type `ty` whose fields are laid as `fs`, in its words' order: each
/// field held as its type holds it, named by it, a record's leaves, however wide, named
/// `field.leaf` in place, and a field of no words none.
fn record_leaves(ctors: Ctors, ty: Type, fs: List<FieldLaid>) -> List<Leaf> = {
  let fields = record_fields(ty);
  range(0, fields.len()).fold([], |acc: List<Leaf>, i: Int|
    match ((fields.at(i), fs.at(i))) {
      (Some(f), Some(laid)) -> match held_laid(ctors, f.ty, laid.laid, false) {
        RUnit -> acc,
        RFlat(inner) ->
          acc.concat(
            inner.map(|l: Leaf| { name: Bytes::concat_all([f.name, b".", l.name]), rep: l.rep }),
          ),
        r -> acc.push({ name: f.name, rep: r }),
      },
      _ -> acc,
    })
}

/// Where field `name` of a flat record of leaves `ls` lies among them: its first leaf and how many
/// it takes, a record's leaves all; none for a field of no words, which holds no leaf.
pub fn leaf_span(ls: List<Leaf>, name: Bytes) -> Option<{ at: Int, n: Int }> = {
  let prefix = name.concat(b".");
  range(0, ls.len()).fold(None, |acc: Option<{ at: Int, n: Int }>, k: Int|
    match ls.at(k) {
      None -> acc,
      Some(l) -> if l.name == name || l.name.starts_with(prefix) {
        match acc { Some(a) -> Some({ at: a.at, n: a.n + 1 }), None -> Some({ at: k, n: 1 }) }
      } else { acc },
    })
}

/// `leaf_span` of every field at once, by the field's name.
pub fn leaf_spans(ls: List<Leaf>) -> Map<Bytes, { at: Int, n: Int }> =
  range(0, ls.len()).fold(Map::new(), |m: Map<Bytes, { at: Int, n: Int }>, k: Int|
    match ls.at(k) {
      None -> m,
      Some(l) -> {
        let field = match l.name.index_of(b".") {
          Some(dot) -> before(l.name, dot),
          None -> l.name,
        };
        m.insert(field, match m.get(field) {
          Some(sp) -> { at: sp.at, n: sp.n + 1 },
          None -> { at: k, n: 1 },
        })
      },
    })

/// The leaves of the field a span of a flat record's leaves holds, named as that field's own type
/// names them: `field.leaf` read as `leaf`.
pub fn leaves_within(ls: List<Leaf>, sp: { at: Int, n: Int }) -> List<Leaf> =
  ls.drop(sp.at).take(sp.n).map(|l: Leaf|
    match l.name.index_of(b".") {
      Some(dot) -> { name: after(l.name, dot + 1), rep: l.rep },
      None -> l,
    })

/// Where leaf `k` of a flat record of leaves `ls` lies among `values_of(RFlat(ls))`: its first
/// value and how many it takes, a sum's its words.
pub fn leaf_values(ls: List<Leaf>, k: Int) -> { at: Int, n: Int } =
  range(0, k + 1).fold({ at: 0, n: 0 }, |acc: { at: Int, n: Int }, j: Int| {
    let n = match ls.at(j) { Some(l) -> values_of(l.rep).len(), None -> 0 };
    if j == k { { at: acc.at, n: n } } else { { at: acc.at + n, n: 0 } }
  })

/// The type of field `name` of a record of type `ty`.
pub fn field_type(ty: Type, name: Bytes) -> Option<Type> =
  record_fields(ty).fold(None, |acc: Option<Type>, f: Field|
    if f.name == name { Some(f.ty) } else { acc })

/// The type of the leaf `name` names in a flat record of type `ty`: a field's, and `field.leaf`'s
/// the leaf's of the record that field holds in place.
pub fn leaf_type(ty: Type, name: Bytes) -> Option<Type> =
  name.split(b".").fold(Some(ty), |at: Option<Type>, f: Bytes|
    match at { Some(t) -> field_type(t, f), None -> None })

/// `field_type` of every field at once, by its name.
pub fn field_types(ty: Type) -> Map<Bytes, Type> =
  record_fields(ty).fold(Map::new(), |m: Map<Bytes, Type>, f: Field| m.insert(f.name, f.ty))

/// The word of each field of a record of type `ty` laid out, by the field's name: where the box of
/// its words holds the field.
pub fn field_offsets(s: Setting, ty: Type) -> Map<Bytes, Int> =
  match laid_known(s.ctors, ty) {
    Some(LRecord(ls)) -> {
      let fs = record_fields(ty);
      range(0, fs.len()).fold(Map::new(), |m: Map<Bytes, Int>, i: Int|
        match ((fs.at(i), ls.at(i))) { (Some(f), Some(l)) -> m.insert(f.name, l.at), _ -> m })
    },
    _ -> Map::new(),
  }

/// The place of constructor `ctor` (as the table names it) among the constructors of a sum held as
/// `r`.
pub fn case_index(r: Rep, ctor: Bytes) -> Option<Int> =
  match r {
    RSum(s) ->
      range(0, s.cases.len()).fold(None, |acc: Option<Int>, i: Int|
        if acc == None && s.cases.at(i) == Some(ctor) { Some(i) } else { acc }),
    _ -> None,
  }

/// Where argument `at` of case `i` of a sum laid as `s` starts in the case's payload: where the
/// case's arguments, laid as a record of them, lay it; none for a case of no words.
pub fn arg_word(s: SumLaid, i: Int, at: Int) -> Option<Int> = {
  let field = |l: Laid|
    match l { LRecord(fs) -> match fs.at(at) { Some(f) -> Some(f.at), None -> None }, _ -> None };
  match s.cases.at(i) {
    Some(c) -> match c.payload {
      Inline(p) -> field(p.laid),
      Boxed(b) -> field(b.laid),
      Nullary -> None,
    },
    None -> None,
  }
}

/// How a value crosses a call: in its C values, or as the address of the caller's copy of it laid
/// in place, the callee owning the counts in it.
pub type Passing = | InWords | ByReference

/// How a value held as `r` crosses a call, as a root's parameter or a closure's typed entry's: a
/// record or a sum of more than `register_words()` words by reference, and any other value in its C
/// values.
pub fn passing(r: Rep) -> Passing =
  match r { RFlat(_) -> widely(r), RSum(_) -> widely(r), _ -> InWords }

fn widely(r: Rep) -> Passing = if value_words(r) > register_words() { ByReference } else { InWords }

/// How each C value a value held as `r` is held in is held, in order: a flat record's leaves'
/// values, a sum leaf's its words; a sum's words; a value of no words in none; a view as its parts;
/// any other value in itself. A record or a sum is exactly its words: its word form, a box of them,
/// is made only where it is asked for.
pub fn values_of(r: Rep) -> List<Rep> =
  match r {
    RFlat(ls) -> ls.fold([], |acc: List<Rep>, l: Leaf| acc.concat(values_of(l.rep))),
    RSum(s) -> range(0, words(LSum(s.laid))).map(|_: Int| RWord),
    RUnit -> [],
    RSlice -> parts_of(r),
    _ -> [r],
  }

/// How many words the C values held as `vs` take: a `Decimal`'s two, one for any other.
pub fn words_held(vs: List<Rep>) -> Int =
  vs.fold(0, |n: Int, v: Rep| n + (match v { RDec -> 2, _ -> 1 }))

/// How many words a value held as `r` takes.
pub fn value_words(r: Rep) -> Int = words_held(values_of(r))

/// How many words a caller's buffer holds for an answer held as `r`, which the callee writes past
/// the C value it returns: the words of its other values, none for an answer of one C value.
pub fn answer_buffer(r: Rep) -> Int = words_held(values_of(r).drop(1))

/// `b` from byte `at` on.
fn after(b: Bytes, at: Int) -> Bytes =
  match b.slice_at(at, b.len() - at) { Some(x) -> x, None -> b"" }

/// `b` up to byte `at`.
fn before(b: Bytes, at: Int) -> Bytes = match b.slice_at(0, at) { Some(x) -> x, None -> b"" }

fn setting_of(ctors: Ctors) -> Setting =
  {
    module: b"m",
    here: [],
    imports: [],
    ctors: ctors,
    builtins: [],
    declared: Map::new(),
    effects: [],
    release: false,
  }

fn named(n: Bytes) -> Type = TyCon({ name: n, args: [] })

fn record(fs: List<{ name: Bytes, ty: Type }>) -> Type = TyRecord(fs)

fn point() -> Type =
  record([{ name: b"x", ty: named(b"Float") }, { name: b"y", ty: named(b"Float") }])

fn segment() -> Type =
  record([
    { name: b"from", ty: point() },
    { name: b"label", ty: named(b"String") },
    { name: b"to", ty: point() },
  ])

/// A table of the prelude's `Option` and `Result`, an enum and a sum of one case of no words.
fn sums() -> Ctors = {
  let ctor = |n: Bytes, i: Int, fields: List<Type>, params: List<Int>|
    { name: n, index: i, fields: fields, params: params };
  ctors_of(
    [],
    [],
    [],
    Map::new().insert(b"Option", [
      ctor(b"None", 0, [], [0]),
      ctor(b"Some", 1, [TyVar(0)], [0]),
    ]).insert(b"Result", [
      ctor(b"Ok", 0, [TyVar(0)], [0, 1]),
      ctor(b"Err", 1, [TyVar(1)], [0, 1]),
    ]).insert(b"Ordering", [
      ctor(b"Less", 0, [], []),
      ctor(b"Equal", 1, [], []),
      ctor(b"Greater", 2, [], []),
    ]).insert(b"m.Token", [ctor(b"m.Token", 0, [], [])]),
  )
}

test "a scalar is held as itself, a pointer as a word, and a value of no words in none" {
  let s = setting_of(sums());
  assert_eq(held_as(s, named(b"Int")), RInt);
  assert_eq(held_as(s, named(b"Float")), RFloat);
  assert_eq(held_as(s, named(b"U8")), RNum({ bits: 8, signed: false }));
  // A `Char` is its own word, which holds no count.
  assert_eq([b"U128", b"String", b"Char"].map(|n: Bytes| held_as(s, named(n))), [
    RWord,
    RWord,
    RImm,
  ]);
  assert_eq(
    [
      named(b"Unit"),
      record([]),
      record([{ name: b"u", ty: named(b"Unit") }]),
      named(b"m.Token"),
    ].map(|t: Type| held_as(s, t)),
    [RUnit, RUnit, RUnit, RUnit],
  );
  // A type variable leaves the layout open: the value is a word.
  assert_eq(held_as(s, TyVar(0)), RWord)
}

test "a declared sum is held as the words its type lays it in, and one a variable leaves open as a word" {
  let s = setting_of(sums());
  match held_as(s, option_type(string_type())) {
    RSum(x) -> {
      assert_eq(x.cases, [b"None", b"Some"]);
      assert_eq(values_of(RSum(x)), [RWord])
    },
    other -> assert_eq(other, RWord),
  };
  // A tag word and the payload, and no word of its own.
  assert_eq(values_of(held_as(s, option_type(int_type()))), [RWord, RWord]);
  assert_eq(case_index(held_as(s, named(b"Ordering")), b"Greater"), Some(2));
  assert_eq(held_as(s, option_type(TyVar(0))), RWord)
}

test "a record is held as its leaves in its words' order, a record it holds among them and no word of its own" {
  let s = setting_of(sums());
  assert_eq(held_as(s, point()), RFlat([{ name: b"x", rep: RFloat }, { name: b"y", rep: RFloat }]));
  let leaves = match held_as(s, segment()) { RFlat(ls) -> ls, _ -> [] };
  assert_eq(leaves.map(|l: Leaf| l.name), [b"from.x", b"from.y", b"label", b"to.x", b"to.y"]);
  assert_eq(leaf_span(leaves, b"to"), Some({ at: 3, n: 2 }));
  assert_eq(leaf_span(leaves, b"label"), Some({ at: 2, n: 1 }));
  assert_eq(leaves_within(leaves, { at: 3, n: 2 }).map(|l: Leaf| l.name), [b"x", b"y"]);
  // A field of no words holds no leaf; a sum field is one leaf, its words its record's own.
  let holder = record([
    { name: b"o", ty: option_type(int_type()) },
    { name: b"u", ty: named(b"Unit") },
    { name: b"z", ty: named(b"Int") },
  ]);
  let hs = match held_as(s, holder) { RFlat(ls) -> ls, _ -> [] };
  assert_eq(hs.map(|l: Leaf| l.name), [b"o", b"z"]);
  assert_eq(values_of(RFlat(hs)), [RWord, RWord, RInt]);
  assert_eq([leaf_values(hs, 0), leaf_values(hs, 1)], [{ at: 0, n: 2 }, { at: 2, n: 1 }]);
  // A field of a variable's type leaves the layout open: the record is a word.
  assert_eq(held_as(s, record([{ name: b"inner", ty: TyVar(0) }])), RWord)
}

test "a field lies at its first word in the box of its record's words" {
  let s = setting_of(sums());
  assert_eq(field_offsets(s, segment()).get(b"label"), Some(2));
  assert_eq(field_offsets(s, segment()).get(b"to"), Some(3));
  assert_eq(field_offsets(s, record([{ name: b"inner", ty: TyVar(0) }])).get(b"inner"), None);
  assert_eq(field_type(segment(), b"to"), Some(point()))
}

test "a case's argument starts where the case's arguments, laid as a record, lay it" {
  let s = setting_of(sums());
  match held_as(s, TyCon({ name: b"Result", args: [int_type(), point()] })) {
    RSum(x) -> {
      // `Ok`'s `Int` and `Err`'s two floats both follow the tag word.
      assert_eq([arg_word(x.laid, 0, 0), arg_word(x.laid, 1, 0)], [Some(0), Some(0)]);
      assert_eq(case_index(RSum(x), b"Err"), Some(1))
    },
    other -> assert_eq(other, RWord),
  }
}

test "an answer of one word needs no buffer, and a wider one its other words" {
  let sum = |n: Int|
    RSum({
      laid: {
        classes: range(0, n).map(|_: Int| P),
        cases: [
          {
            test: Always,
            payload: Inline({
              offset: 0,
              laid: LWords(range(0, n).map(|_: Int| P)),
              stripped: None,
            }),
          },
        ],
      },
      cases: [b"m.Only"],
    });
  assert_eq([RInt, RWord, sum(1), RUnit].map(answer_buffer), [0, 0, 0, 0]);
  assert_eq(answer_buffer(sum(3)), 2);
  assert_eq(answer_buffer(RFlat([{ name: b"x", rep: RFloat }, { name: b"y", rep: RFloat }])), 1);
  // A decimal past the first value takes two words of the buffer.
  assert_eq(answer_buffer(RFlat([{ name: b"n", rep: RInt }, { name: b"d", rep: RDec }])), 2);
  assert_eq(case_index(sum(1), b"m.Only"), Some(0));
  assert_eq(case_index(sum(1), b"m.Other"), None)
}

test "a record or a sum wider than four words crosses by reference" {
  let flat = |reps: List<Rep>| RFlat(reps.map(|r: Rep| { name: b"f", rep: r }));
  assert_eq(passing(flat([RInt, RInt, RInt, RInt])), InWords);
  assert_eq(passing(flat([RInt, RInt, RInt, RInt, RInt])), ByReference);
  // A decimal takes two words.
  assert_eq(passing(flat([RInt, RInt, RDec])), InWords);
  assert_eq(passing(flat([RInt, RInt, RInt, RDec])), ByReference);
  let sum = |n: Int|
    RSum({
      laid: {
        classes: range(0, n).map(|_: Int| U),
        cases: [
          {
            test: Always,
            payload: Inline({
              offset: 0,
              laid: LWords(range(0, n).map(|_: Int| raw())),
              stripped: None,
            }),
          },
        ],
      },
      cases: [b"m.Only"],
    });
  assert_eq([sum(4), sum(5)].map(passing), [InWords, ByReference]);
  // A record holding a sum holds the sum's words.
  assert_eq(value_words(RFlat([{ name: b"s", rep: sum(3) }, { name: b"n", rep: RInt }])), 4);
  // A scalar is never handed by reference, however wide.
  assert_eq([RDec, RWord, RInt, RUnit].map(passing), [InWords, InWords, InWords, InWords])
}
