pub fn performed(
  context: Context,
  st: Lowering,
  p: { effect: Bytes, op: Bytes, resource: Bytes },
  label: Option<Arg>,
  written: Option<Code>,
  args: List<Arg>,
  result: Type,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match effect_of(context, p.effect) {
    None -> unreachable(b"an effect the lowering does not resolve: ".concat(p.effect)),
    Some(en) -> {
      let index = range(0, en.operations.len()).find(|k: Int|
        match en.operations.at(k) { Some(o) -> o.name == p.op, None -> false });
      let resource = match written {
        Some(c) -> label_resource(context, c),
        None -> if p.resource == b"" { SingletonResource } else { NamedResource(p.resource) },
      };
      let word = fill_missing_evidence(
        st,
        evidence_for(context, [
          { evidence: { effect: en.global, resource: resource }, from_variable: false },
        ]),
        at,
      );
      let keyed = match label {
        Some(l) -> {
          let k = represented_as({ st: word.st, arg: l }, AsInt, at);
          { st: k.st, args: [k.arg] }
        },
        None -> { st: word.st, args: [] },
      };
      let declared = op_declared(en, p.op);
      let mode = declared.mode;
      let kept = kept_type_parameters(en.global, declared);
      let crossed = range(0, args.len()).fold(
        { st: keyed.st, args: [] },
        |acc: { st: Lowering, args: List<Arg> }, i: Int| {
          let x = kept_argument(context, acc.st, declared.params.at(i), kept, args.get(i), at);
          { st: x.st, args: acc.args.push(x.arg) }
        },
      );
      let words = crossed.args.fold(
        { st: crossed.st, args: [] },
        |acc: { st: Lowering, args: List<Arg> }, a: Arg| {
          let w = represented_as({ st: acc.st, arg: a }, AsWord, at);
          { st: w.st, args: acc.args.push(w.arg) }
        },
      );
      let ty = result;
      {
        {
          let out = if is_raise(mode) { { ty: ty, marked: None } }
          else { kept_result_type(declared.ret, kept, ty) };
          let d = operation_descriptor(
            context,
            words.st,
            en.global,
            declared,
            crossed.args.map(type_of),
            out.ty,
          );
          let uses = {
            takes: keyed.args.map(|_: Arg| false).concat(words.args.map(|_: Arg| true)),
            owned: true,
            fails: true,
            suspends: !is_raise(mode),
          };
          let op = match ((d.name, index)) {
            (Some(described), Some(k)) ->
              Op({
                op: OfHandling(
                  Perform({
                    effect: en.global,
                    op: p.op,
                    index: k,
                    resource: if label == None { p.resource } else { b"" },
                    labelled: label != None,
                    mode: mode_code(mode),
                    descriptor: described,
                  }),
                ),
                args: word.args.concat(keyed.args).concat(words.args),
                uses: { ..uses, takes: [false].concat(uses.takes) },
              }),
            _ ->
              Op({
                op: OfHandling(UnspecialisedBuiltin(p.op)),
                args: keyed.args.concat(words.args),
                uses: uses,
              }),
          };
          let returned = represented_as(
            bound_as(d.st, out.ty, AsWord, op, at),
            representation_of(context.setting, out.ty),
            at,
          );
          match out.marked {
            None -> returned,
            Some(m) -> kept_conversion(context, returned.st, returned.arg, m, false, at),
          }
        }
      }
    },
  }

fn kept_type_parameters(global: Bytes, op: EffectOperation) -> List<Int> / {abort.raise} =
  if global.index_of(b".") == None || is_shipped(global) { [] }
  else { variables_in_signature(op.params, op.ret, op.mode, op.own) }

fn names_kept(declared: Type, kept: List<Int>) -> Bool =
  type_variables(declared).any(|v: Int| kept.contains(v))

fn kept_argument(
  context: Context,
  st: Lowering,
  declared: Option<Type>,
  kept: List<Int>,
  a: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match declared {
    Some(d) -> if !names_kept(d, kept) { { st: st, arg: a } } else {
      kept_conversion(context, st, a, mark_type_params(d, type_of(a), kept).marked, true, at)
    },
    None -> { st: st, arg: a },
  }

fn kept_result_type(
  declared: Type,
  kept: List<Int>,
  recorded: Type,
) -> { ty: Type, marked: Option<Type> } / {abort.raise} =
  if !names_kept(declared, kept) { { ty: recorded, marked: None } } else {
    let marked_type = mark_type_params(declared, recorded, kept).marked;
    { ty: dynamic_form(marked_type), marked: Some(marked_type) }
  }

pub fn scheduler_perform_call(
  context: Context,
  p: { effect: Bytes, op: Bytes, resource: Bytes },
  codes: List<Code>,
  args: List<Arg>,
  result: Type,
  at: Span,
) -> Option<{ name: Bytes, types: List<Type>, rows: List<Effects> }> / {abort.raise} =
  match effect_of(context, p.effect) {
    Some(named) -> {
      let t = { ty: result };
      let marshalling = match prelude_effects().find(|e: EffectInfo| e.name == named.global) {
        Some(e) -> match e.operations.find(|o: OpInfo| o.name == p.op) {
          Some(o) -> marshalling_variables(o),
          None -> [],
        },
        None -> [],
      };
      let en = match effect_of(context, named.global) { Some(e) -> e, None -> named };
      let declared = op_declared(en, p.op);
      let types = own_types(declared, args.map(type_of), t.ty);
      if marshalling.len() == 0 || types.any(|x: Option<Type>| x == None)
          || marshalling.all(|i: Int| types.at(i) == Some(Some(kept_type()))) { None } else {
        Some({
          name: Bytes::concat_all([scheduler_module(), b"::crossing_", p.op]),
          types: types.fold([], |acc: List<Type>, x: Option<Type>|
            match x { Some(y) -> acc.push(y), None -> acc }),
          rows: range(0, declared.params.len()).fold([], |acc: List<Effects>, i: Int|
            match declared.params.at(i) {
              Some(FunctionType(f)) -> if f.effects.variable == None { acc } else {
                acc.push(match codes.at(i) {
                  Some(c) -> match c.node {
                    CodeLambda(l) -> l.effects,
                    _ -> match args.at(i) {
                      Some(a) -> match type_of(a) {
                        FunctionType(g) -> g.effects,
                        _ -> no_effects(),
                      },
                      None -> no_effects(),
                    },
                  },
                  None -> no_effects(),
                })
              },
              _ -> acc,
            }),
        })
      }
    },
    _ -> None,
  }

pub fn label(context: Context, st: Lowering, name: Bytes, at: Span) -> LoweredValue =
  bound_as(
    st,
    int_type(),
    AsInt,
    Op({
      op: OfHandling(Label(name)),
      args: [],
      uses: { takes: [], owned: false, fails: false, suspends: false },
    }),
    at,
  )

pub fn clause_frame(clause: CodeClause, held: CapturedEvidence) -> Frame =
  {
    params: clause.params + (if clause.binds_label { 1 } else { 0 })
      + (if clause.resume { 1 } else { 0 }),
    size: clause.size,
    captures: clause.captures,
    resumes: if clause.resume { Some(clause.resumed) } else { None },
    body: clause.body,
    ty: clause.ty,
    words: [],
    captured_evidence: held,
  }

pub fn return_frame(r: CodeReturn, held: CapturedEvidence) -> Frame =
  {
    params: 1,
    size: r.size,
    captures: r.captures,
    resumes: None,
    body: r.body,
    ty: r.ty,
    words: [],
    captured_evidence: held,
  }

pub type HandlePlan = {
  st: Lowering,
  instance: { word: Arg, layout: HandleInstance, block: Option<Arg> },
  forwarding: Option<ForwardingBlock>,
}

pub type ForwardingBlock = { pointer: Arg, outer: List<EvidenceWord> }

pub fn handle_plan(
  context: Context,
  st: Lowering,
  h: CodeHandler,
  at: Span,
) -> HandlePlan / {abort.raise} = {
  let detached = detaches(h.clauses);
  let keys = instance_keys(context, h.clauses);
  let known = match keys.find(|k: InstanceKey| k.effect.operations.len() == 0) {
    Some(k) ->
      unreachable(
        b"a handle of an effect whose operations the lowering does not know: ".concat(
          k.effect.global,
        ),
      ),
    None -> st,
  };
  let f = if !detached { { st: known, forwarding: None } } else {
    let made = forwarding(context, known, at);
    { st: made.st, forwarding: Some(made.forwarding) }
  };
  let around = match f.forwarding { Some(w) -> { ..context, words: w.outer }, None -> context };
  let raised = h.clauses.fold(0, |m: Int, cl: CodeClause|
    if clause_mode(context, cl) == 3 && cl.params > m { cl.params } else { m });
  let records = raise_offset() + raised;
  let returned = h.clauses.len();
  let vars = records + 4 * (returned + (if h.ret == None { 0 } else { 1 }));
  let count = handler_variables(h.body);
  let tables = keys.fold(0, |n: Int, k: InstanceKey| n + tables_of(plan_key(around, h.clauses, k)));
  let objects = keys.fold(0, |n: Int, k: InstanceKey| n + object_words(k));
  let layout = {
    operand: 0,
    records: range(0, h.clauses.len()).map(|k: Int| records + 4 * k),
    vars: vars,
    count: count,
    pending: range(0, h.clauses.len()).find(|k: Int|
      match h.clauses.at(k) { Some(cl) -> handles_abort(context, cl), None -> false }),
    result: None,
    raise_clause_indexes: range(0, h.clauses.len()).filter(|k: Int|
      match h.clauses.at(k) {
        Some(cl) -> clause_mode(context, cl) == 3 && !handles_abort(context, cl),
        None -> false,
      }),
    heap: None,
    ret: if h.ret == None { None } else { Some(records + 4 * returned) },
    preset: false,
  };
  let words = vars + 2 * count + objects + tables;
  if detached || spawning(context) {
    let b = bound_as(
      f.st,
      instance_block_type(),
      AsWord,
      Op({
        op: OfHandling(HeapInstance(words)),
        args: [],
        uses: { takes: [], owned: true, fails: false, suspends: false },
      }),
      at,
    );
    let i = bound_as(
      b.st,
      evidence_type(),
      AsImmediate,
      Op({ op: OfHandling(InstanceAddress), args: [b.arg], uses: reads(1) }),
      at,
    );
    {
      st: i.st,
      instance: { word: i.arg, layout: layout, block: Some(b.arg) },
      forwarding: f.forwarding,
    }
  } else {
    let i = bound_as(
      f.st,
      evidence_type(),
      AsImmediate,
      Op({ op: OfHandling(Instance(words)), args: [], uses: reads(0) }),
      at,
    );
    { st: i.st, instance: { word: i.arg, layout: layout, block: None }, forwarding: None }
  }
}

fn spawning(context: Context) -> Bool =
  context.words.any(|w: EvidenceWord| w.evidence.effect == b"task")

type ForwardingLayout = { targets: Int, tasks: Int, labels: Int, forwards: List<Int>, words: Int }

type OuterWord = { word: EvidenceWord, operation_count: Int }

fn forwarding(
  context: Context,
  st: Lowering,
  at: Span,
) -> { st: Lowering, forwarding: ForwardingBlock } / {abort.raise} = {
  let known = context.words.fold([], |acc: List<OuterWord>, w: EvidenceWord|
    match effect_of(context, w.evidence.effect) {
      Some(e) -> if e.operations.len() > 0 {
        acc.push({ word: w, operation_count: e.operations.len() })
      } else { acc },
      None -> acc,
    });
  let outer = known.map(|f: OuterWord| f.word);
  let labels = outer.filter(|w: EvidenceWord|
    match w.evidence.resource { ResourceVariable(_) -> true, _ -> false });
  let header = 5;
  let tasks = header + outer.len();
  let forwards = known.fold(
    { at: tasks + outer.len() + labels.len(), starts: [] },
    |acc: { at: Int, starts: List<Int> }, f: OuterWord|
      { at: acc.at + 1 + 5 * f.operation_count, starts: acc.starts.push(acc.at) },
  );
  let placed = {
    targets: header,
    tasks: tasks,
    labels: tasks + outer.len(),
    forwards: forwards.starts,
    words: forwards.at,
  };
  let block = bound_as(
    st,
    evidence_type(),
    AsImmediate,
    Op({ op: OfHandling(AllocateForwarding(placed.words)), args: [], uses: reads(0) }),
    at,
  );
  let headed = forwarding_header(context, block.st, block.arg, outer, placed, at);
  let forwarded = range(0, known.len()).fold(
    { st: headed, words: [] },
    |acc: { st: Lowering, words: List<EvidenceWord> }, i: Int| {
      let f = known.get(i);
      let start = placed.forwards.get(i);
      let o = bound_as(
        acc.st,
        evidence_type(),
        AsImmediate,
        Op({
          op: OfHandling(
            ObjectAt({
              at: start,
              slots: range(0, f.operation_count).map(|j: Int|
                ForwardedSlot({
                  target: placed.targets + i,
                  task: placed.tasks + i,
                  record: start + 1 + 2 * f.operation_count + 3 * j,
                })),
              shared_from: None,
            }),
          ),
          args: [block.arg],
          uses: reads(1),
        }),
        at,
      );
      { st: o.st, words: acc.words.push({ ..f.word, word: o.arg }) }
    },
  );
  let unknown = context.words.filter(|w: EvidenceWord| !outer.contains(w));
  let bridged_unknown = if unknown.len() == 0 { { st: forwarded.st, words: [] } } else {
    let b = bound_as(
      forwarded.st,
      evidence_type(),
      AsImmediate,
      Op({ op: OfHandling(SchedulerEvidence), args: [], uses: reads(0) }),
      at,
    );
    { st: b.st, words: unknown.map(|w: EvidenceWord| { ..w, word: b.arg }) }
  };
  {
    st: bridged_unknown.st,
    forwarding: { pointer: block.arg, outer: forwarded.words.concat(bridged_unknown.words) },
  }
}

fn forwarding_header(
  context: Context,
  st: Lowering,
  block: Arg,
  outer: List<EvidenceWord>,
  placed: ForwardingLayout,
  at: Span,
) -> Lowering / {abort.raise} = {
  let set = |s: Lowering, k: Int, a: Arg|
    run_for_effect(
      s,
      Op({ op: OfHandling(SetForwarding(k)), args: [block, a], uses: reads(2) }),
      at,
    );
  let mapped = bound_as(
    st,
    evidence_type(),
    AsImmediate,
    Op({ op: OfHandling(EffectsMapping), args: [], uses: reads(0) }),
    at,
  );
  let d = static_added(mapped.st, effects_descriptor(outer.map(|w: EvidenceWord| w.evidence)));
  let desc = bound_as(d.st, effects_descriptor_type(), AsImmediate, Static(d.name), at);
  let words = fill_missing_evidence(desc.st, outer.map(|w: EvidenceWord| w.word), at);
  let headed = set(
    set(set(set(words.st, 1, mapped.arg), 2, desc.arg), 3, IntOperand(outer.len())),
    4,
    IntOperand(placed.words),
  );
  let targeted = range(0, words.args.len()).fold(headed, |s: Lowering, i: Int|
    set(s, placed.targets + i, words.args.get(i)));
  let labels = outer.fold([], |acc: List<Arg>, w: EvidenceWord|
    match w.evidence.resource {
      ResourceVariable(p) -> acc.push(label_value(context, p)),
      _ -> acc,
    });
  range(0, labels.len()).fold(targeted, |s: Lowering, l: Int|
    set(s, placed.labels + l, labels.get(l)))
}

fn handles_abort(context: Context, cl: CodeClause) -> Bool =
  cl.op == b"raise" && cl.effect == b"abort"

fn handler_variables(body: Code) -> Int =
  match body.node {
    CodeBlock(b) ->
      b.statements.fold(0, |n: Int, s: CodeStatement|
        match s {
          CodeDo(d) -> match d.code.node {
            CodeApply(a) -> match a.function.node {
              NBuiltin(v) -> if v.name == b"?handler_init" { n + 1 } else { n },
              _ -> n,
            },
            _ -> n,
          },
          _ -> n,
        }),
    _ -> 0,
  }

pub fn clause_captured_evidence(
  context: Context,
  st: Lowering,
  plan: HandlePlan,
  effects: Effects,
  at: Span,
) -> { st: Lowering, held: CapturedEvidence } = {
  let around = match plan.forwarding { Some(f) -> { ..context, words: f.outer }, None -> context };
  let words = captured_evidence_for(around, st, words_of(context, effects), at);
  {
    st: words.st,
    held: {
      words: words.words,
      instance: Some({ word: plan.instance.word, vars: plan.instance.layout.vars }),
      kept: context.kept,
    },
  }
}

fn handle_keys(
  context: Context,
  clauses: List<CodeClause>,
) -> List<{ evidence: Evidence, effect: EffectName }> =
  clauses.fold([], |acc: List<{ evidence: Evidence, effect: EffectName }>, cl: CodeClause| {
    let en = match effect_of(context, cl.effect) {
      Some(e) -> e,
      None -> { global: cl.effect, operations: [] },
    };
    let returned = { effect: en.global, resource: clause_resource(context, cl) };
    if acc.any(|k: { evidence: Evidence, effect: EffectName }| k.evidence == returned) { acc }
    else { acc.push({ evidence: returned, effect: en }) }
  })

pub fn enter_handle(
  context: Context,
  st: Lowering,
  h: CodeHandler,
  plan: HandlePlan,
  at: Span,
) -> { context: Context, st: Lowering } / {abort.raise} = {
  let i = plan.instance;
  let made = instance_objects(context, st, h, plan, at);
  {
    context: {
      ..context,
      words: made.words.concat(context.words),
      instance: Some({ word: i.word, vars: i.layout.vars }),
      kept: match i.block { Some(b) -> context.kept.push(b), None -> context.kept },
    },
    st: made.st,
  }
}

pub fn instance_objects(
  context: Context,
  st: Lowering,
  h: CodeHandler,
  plan: HandlePlan,
  at: Span,
) -> { st: Lowering, words: List<EvidenceWord> } / {abort.raise} = {
  let i = plan.instance;
  let around = match plan.forwarding { Some(f) -> { ..context, words: f.outer }, None -> context };
  let keys = instance_keys(context, h.clauses);
  let first = i.layout.vars + 2 * i.layout.count;
  let made = keys.fold(
    {
      st: st,
      words: [],
      object: first,
      table: first + keys.fold(0, |n: Int, k: InstanceKey| n + object_words(k)),
    },
    |acc: { st: Lowering, words: List<EvidenceWord>, object: Int, table: Int }, k: InstanceKey| {
      let kp = plan_key(around, h.clauses, k);
      let o = write_object(around, acc.st, h.clauses, i, kp, acc.object, acc.table, at);
      {
        st: o.st,
        words: acc.words.push({
          evidence: kp.key.evidence,
          word: o.arg,
          inherited: false,
          handled: true,
        }),
        object: acc.object + object_words(k),
        table: acc.table + tables_of(kp),
      }
    },
  );
  { st: made.st, words: made.words }
}

fn object_words(k: InstanceKey) -> Int = 1 + 2 * k.effect.operations.len()

type InstanceKey = { evidence: Evidence, effect: EffectName }

fn instance_keys(context: Context, clauses: List<CodeClause>) -> List<InstanceKey> = {
  let keys = handle_keys(context, clauses);
  keys.filter(|k: InstanceKey|
    k.evidence.resource == AnyResource
      || !keys.any(|o: InstanceKey|
        o.evidence.effect == k.evidence.effect && o.evidence.resource == AnyResource))
}

type SlotPlan = | ByClause(Int) | ByWord | ByTable({ clauses: List<Int>, words: List<Int> })

type KeyPlan = { key: InstanceKey, outer: List<EvidenceWord>, slots: List<SlotPlan> }

fn plan_key(
  context: Context,
  clauses: List<CodeClause>,
  k: InstanceKey,
) -> KeyPlan / {abort.raise} = {
  let every = k.evidence.resource == AnyResource;
  let outer = if !every { [] } else {
    context.words.fold(
      { out: [], closed: false },
      |acc: { out: List<EvidenceWord>, closed: Bool }, w: EvidenceWord|
        if acc.closed || w.evidence.effect != k.evidence.effect { acc }
        else { { out: acc.out.push(w), closed: w.evidence.resource == AnyResource } },
    ).out
  };
  let plain = outer.len() == 0
    || (outer.len() == 1 && outer.get(0).evidence.resource == AnyResource);
  let returning = |op: Bytes|
    range(0, clauses.len()).filter(|c: Int|
      match clauses.at(c) {
        Some(cl) ->
          cl.op == op && cl.effect == k.evidence.effect
            && (every || clause_resource(context, cl) == k.evidence.resource),
        None -> false,
      });
  let on_every = |c: Int|
    match clauses.at(c) { Some(cl) -> clause_resource(context, cl) == AnyResource, None -> false };
  let words = range(0, outer.len());
  {
    key: k,
    outer: outer,
    slots: k.effect.operations.map(|op: EffectOperation| {
      let all = returning(op.name);
      if !every { match all.at(0) { Some(c) -> ByClause(c), None -> ByWord } } else {
        let reach = all.fold(
          { out: [], closed: false },
          |acc: { out: List<Int>, closed: Bool }, c: Int|
            if acc.closed { acc } else { { out: acc.out.push(c), closed: on_every(c) } },
        );
        match reach.out.at(0) {
          None -> if plain { ByWord } else { ByTable({ clauses: [], words: words }) },
          Some(c) -> if on_every(c) { ByClause(c) }
          else { ByTable({ clauses: reach.out, words: if reach.closed { [] } else { words } }) },
        }
      }
    }),
  }
}

fn tables_of(kp: KeyPlan) -> Int =
  kp.slots.fold(0, |n: Int, s: SlotPlan|
    match s { ByTable(t) -> n + 1 + 3 * (t.clauses.len() + t.words.len()), _ -> n })

fn write_object(
  context: Context,
  st: Lowering,
  clauses: List<CodeClause>,
  i: { word: Arg, layout: HandleInstance, block: Option<Arg> },
  kp: KeyPlan,
  object: Int,
  table: Int,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let routed_to = if kp.slots.any(|x: SlotPlan| x == ByWord) {
    fill_missing_evidence(st, [covering_evidence_word(context, kp.key.evidence)], at)
  } else { { st: st, args: [ZeroOperand(AsImmediate)] } };
  let first_label = 2 + kp.outer.len();
  let clause_slot = |c: Int| {
    let cl = clauses.get(c);
    let entry = match entry_of(clause_mode(context, cl)) {
      ReturnsResult -> if module_of(context.key) == scheduler_module() && !cl.binds_label {
        Schedules
      } else { ReturnsResult },
      other -> other,
    };
    ClauseSlot({ entry: entry, record: i.layout.records.get(c), labelled: cl.binds_label })
  };
  let labelled = |s: Lowering, labels: List<Arg>, r: Resource|
    match r {
      AnyResource -> { st: s, labels: labels, at: None },
      SingletonResource ->
        { st: s, labels: labels.push(IntOperand(0 - 1)), at: Some(first_label + labels.len()) },
      ResourceVariable(p) ->
        {
          st: s,
          labels: labels.push(label_value(context, p)),
          at: Some(first_label + labels.len()),
        },
      NamedResource(n) -> {
        let l = label(context, s, n, at);
        { st: l.st, labels: labels.push(l.arg), at: Some(first_label + labels.len()) }
      },
    };
  let laid = range(0, kp.slots.len()).fold(
    { st: routed_to.st, labels: [], slots: [], table: table },
    |acc: { st: Lowering, labels: List<Arg>, slots: List<Slot>, table: Int }, j: Int|
      match kp.slots.get(j) {
        ByClause(c) -> { ..acc, slots: acc.slots.push(clause_slot(c)) },
        ByWord -> { ..acc, slots: acc.slots.push(CopiedSlot({ operand: 1, op: j })) },
        ByTable(t) -> {
          let by_clause = t.clauses.fold(
            { st: acc.st, labels: acc.labels, rows: [] },
            |r: { st: Lowering, labels: List<Arg>, rows: List<KeyedCase> }, c: Int| {
              let l = labelled(r.st, r.labels, clause_resource(context, clauses.get(c)));
              {
                st: l.st,
                labels: l.labels,
                rows: r.rows.push({ label: l.at, slot: clause_slot(c) }),
              }
            },
          );
          let by_word = t.words.fold(
            by_clause,
            |r: { st: Lowering, labels: List<Arg>, rows: List<KeyedCase> }, w: Int| {
              let l = labelled(r.st, r.labels, kp.outer.get(w).evidence.resource);
              {
                st: l.st,
                labels: l.labels,
                rows: r.rows.push({ label: l.at, slot: CopiedSlot({ operand: 2 + w, op: j }) }),
              }
            },
          );
          {
            st: by_word.st,
            labels: by_word.labels,
            slots: acc.slots.push(KeyedSlot({ table: acc.table, rows: by_word.rows })),
            table: acc.table + 1 + 3 * by_word.rows.len(),
          }
        },
      },
  );
  let outer = fill_missing_evidence(laid.st, kp.outer.map(|w: EvidenceWord| w.word), at);
  let placed = [i.word].concat(routed_to.args).concat(outer.args).concat(laid.labels);
  let shared = shared_over(
    context,
    clauses,
    i,
    clauses_reached(kp),
    routed_to.args.concat(outer.args),
  );
  let operands = placed.concat(match shared { Some(words) -> words, None -> [] });
  bound_as(
    outer.st,
    evidence_type(),
    AsImmediate,
    Op({
      op: OfHandling(
        ObjectAt({
          at: object,
          slots: laid.slots,
          shared_from: match shared { Some(_) -> Some(placed.len()), None -> None },
        }),
      ),
      args: operands,
      uses: reads(operands.len()),
    }),
    at,
  )
}

fn clauses_reached(kp: KeyPlan) -> List<Int> =
  kp.slots.fold([], |acc: List<Int>, s: SlotPlan|
    match s { ByClause(c) -> acc.push(c), ByTable(t) -> acc.concat(t.clauses), ByWord -> acc })

fn shared_over(
  context: Context,
  clauses: List<CodeClause>,
  i: { word: Arg, layout: HandleInstance, block: Option<Arg> },
  reached: List<Int>,
  copied: List<Arg>,
) -> Option<List<Arg>> / {abort.raise} =
  if i.block != None || i.layout.count > 0
      || !reached.all(|c: Int| only_returns(context, clauses.get(c))) { None } else {
    Some(
      reached.fold(copied, |acc: List<Arg>, c: Int|
        acc.concat(evidence_for(context, words_of(context, clauses.get(c).effects)))).fold(
        [],
        |acc: List<Arg>, w: Arg|
          if w == ZeroOperand(AsImmediate) || acc.contains(w) { acc } else { acc.push(w) },
      ),
    )
  }

fn only_returns(context: Context, cl: CodeClause) -> Bool =
  clause_mode(context, cl) == 0 && cl.captures.len() == 0
    && module_of(context.key) != scheduler_module()

fn entry_of(mode: Int) -> ClauseEntry =
  if mode == 3 { Raises }
  else if mode == 1 { Resumes }
  else if mode == 2 { Suspends }
  else { ReturnsResult }

fn may_stop(c: Clause) -> Bool = match entry_of(c.mode) { Resumes -> true, _ -> false }

fn clause_resource(context: Context, cl: CodeClause) -> Resource =
  if cl.label != None {
    match range(0, context.label_names.len()).find(|i: Int|
        context.label_names.at(i) == Some(cl.resource)) {
      Some(p) -> ResourceVariable(p),
      None -> NamedResource(cl.resource),
    }
  } else if cl.resource == b"" { SingletonResource }
  else if cl.resource == b"*" { AnyResource }
  else { NamedResource(cl.resource) }

pub fn body_frame(
  context: Context,
  h: CodeHandler,
  plan: HandlePlan,
  own: List<EvidenceWord>,
  result: Type,
) -> Frame = {
  let inside = bound_in(h.body);
  let reads = slots_read(h.body).fold([], |acc: List<Int>, r: Int|
    if acc.contains(r) || inside.contains(r) { acc } else { acc.push(r) });
  {
    params: 0,
    size: reads.concat(inside).fold(0, |m: Int, r: Int| if r + 1 > m { r + 1 } else { m }),
    captures: reads.map(|r: Int| { src: r, destination: r }),
    resumes: None,
    body: h.body,
    ty: { params: [], kept: [], once: false, ret: result, effects: no_effects() },
    words: [],
    captured_evidence: {
      words: own.concat(match plan.forwarding { Some(f) -> f.outer, None -> [] }),
      instance: Some({ word: plan.instance.word, vars: plan.instance.layout.vars }),
      kept: context.kept,
    },
  }
}

pub fn handle_assembled(
  context: Context,
  st: Lowering,
  body: LoweredValue,
  clauses: List<Arg>,
  ret: Option<Arg>,
  h: CodeHandler,
  plan: HandlePlan,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let detached = detaches(h.clauses);
  let ty = match ret {
    Some(r) -> return_type_of(type_of(r)),
    None -> if detached { return_type_of(type_of(body.arg)) } else { type_of(body.arg) },
  };
  let result_rep = if detached { AsWord } else { representation_of(context.setting, ty) };
  let inner = if detached { { outer: body.st, block: [], word: None } }
  else if !falls_through(body.st.insts) {
    { outer: exit_block(st, body.st), block: body.st.insts, word: None }
  } else {
    match ret {
      Some(r) -> {
        let w = represented_as(body, representation_of(context.setting, param_of(type_of(r))), at);
        let given = run_for_effect(
          w.st,
          Op({
            op: OfHandling(Returning),
            args: [plan.instance.word, w.arg],
            uses: { takes: [false, true], owned: false, fails: false, suspends: false },
          }),
          at,
        );
        { outer: exit_block(st, given), block: given.insts, word: None }
      },
      None -> {
        let w = represented_as(body, result_rep, at);
        { outer: exit_block(st, w.st), block: w.st.insts, word: Some(w.arg) }
      },
    }
  };
  let laid = range(0, h.clauses.len()).fold(
    { st: inner.outer, args: [], takes: [], clauses: [], unknown_effect: None },
    |acc: ClauseLayout, i: Int|
      match h.clauses.at(i) {
        None -> acc,
        Some(cl) -> match clauses.at(i) {
          None -> acc,
          Some(closure) -> clause_added(context, acc, cl, closure, at),
        },
      },
  );
  let tail = match ret {
    Some(r) -> { args: laid.args.push(r), takes: laid.takes.push(true), at: Some(laid.args.len()) },
    None -> { args: laid.args, takes: laid.takes, at: None },
  };
  let all = if detached {
    { args: tail.args.push(body.arg), takes: tail.takes.push(true), at: Some(tail.args.len()) }
  } else { { args: tail.args, takes: tail.takes, at: None } };
  let i = plan.instance;
  let held = all.args.push(i.word).concat(match i.block { Some(b) -> [b], None -> [] });
  let forwarded = held.concat(match plan.forwarding { Some(f) -> [f.pointer], None -> [] });
  let result = if laid.clauses.any(may_stop) {
    let d = type_descriptor(context, laid.st, ty, at);
    { st: d.st, args: [d.arg] }
  } else { { st: laid.st, args: [] } };
  let taken = forwarded.concat(result.args);
  let site = {
    st: result.st,
    args: taken,
    takes: range(0, taken.len()).map(|k: Int| all.at == Some(k)),
    instance: {
      ..i.layout,
      operand: all.args.len(),
      result: if result.args.len() == 0 { None } else { Some(forwarded.len()) },
      heap: match i.block { Some(_) -> Some(all.args.len() + 1), None -> None },
    },
    detached: match ((all.at, plan.forwarding)) {
      (Some(body), Some(_)) -> Some({ body: body, forwards: held.len() }),
      _ -> None,
    },
  };
  let a = fresh(site.st, ty, result_rep);
  match laid.unknown_effect {
    Some(name) -> unreachable(b"an effect the lowering does not resolve: ".concat(name)),
    None -> if escapes(inner.block, false, false) {
      unreachable(b"a handle body that leaves other than by its end")
    } else {
      let out = emitted(
        a.st,
        Handle({
          body: match inner.word {
            Some(w) -> inner.block.push(Assign({ var: a.var, arg: w })),
            None -> inner.block,
          },
          args: site.args,
          uses: { takes: site.takes, owned: true, fails: true, suspends: false },
          site: {
            clauses: laid.clauses,
            ret: tail.at,
            detached: site.detached,
            instance: site.instance,
          },
          result: a.var,
          unwind: [],
        }),
      );
      represented_as(
        { st: out, arg: VarOperand(a.var) },
        representation_of(context.setting, ty),
        at,
      )
    },
  }
}

pub fn lower_detached_handle(
  context: Context,
  before: Lowering,
  body: LoweredValue,
  h: CodeHandler,
  plan: HandlePlan,
  result: Type,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match context.instance {
    Some(held) -> {
      let i = plan.instance;
      let inner = if !falls_through(body.st.insts) {
        { outer: exit_block(before, body.st), block: body.st.insts, word: None }
      } else {
        let w = represented_as(body, AsWord, at);
        { outer: exit_block(before, w.st), block: w.st.insts, word: Some(w.arg) }
      };
      let a = fresh(inner.outer, result, AsWord);
      if escapes(inner.block, false, false) {
        unreachable(b"a handle body that leaves other than by its end")
      } else {
        let out = emitted(
          a.st,
          Handle({
            body: match inner.word {
              Some(w) -> inner.block.push(Assign({ var: a.var, arg: w })),
              None -> inner.block,
            },
            args: [held.word],
            uses: { takes: [false], owned: true, fails: true, suspends: false },
            site: {
              clauses: preset_clauses(context, h.clauses),
              ret: None,
              detached: None,
              instance: { ..i.layout, operand: 0, result: None, heap: Some(0), preset: true },
            },
            result: a.var,
            unwind: [],
          }),
        );
        represented_as(
          { st: out, arg: VarOperand(a.var) },
          representation_of(context.setting, result),
          at,
        )
      }
    },
    None -> unreachable(b"a detached body holding no instance"),
  }

fn preset_clauses(context: Context, clauses: List<CodeClause>) -> List<Clause> =
  clauses.map(|cl: CodeClause|
    { effect: cl.effect, op: cl.op, mode: clause_mode(context, cl), string: None, handler: 0 })

pub fn parallel_block(
  context: Context,
  st: Lowering,
  branches: List<Arg>,
  performs: Effects,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let closures = branches.fold(
    { st: st, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, b: Arg| {
      let w = represented_as({ st: acc.st, arg: b }, AsWord, at);
      { st: w.st, args: acc.args.push(w.arg) }
    },
  );
  let described = branches.fold(
    { st: closures.st, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, b: Arg| {
      let d = type_descriptor(context, acc.st, return_type_of(type_of(b)), at);
      { st: d.st, args: acc.args.push(d.arg) }
    },
  );
  let unaborted = {
    ..context,
    words: context.words.filter(|w: EvidenceWord| w.evidence.effect != b"abort"),
  };
  let handing = function_value_evidence(unaborted, described.st, performs, at);
  let entering = run_for_effect(
    handing.st,
    Op({ op: OfHandling(Entering), args: handing.args, uses: reads(2) }),
    at,
  );
  let words = { st: entering, args: closures.args.concat(described.args) };
  let ty = RecordType(
    fields_sorted(
      range(0, branches.len()).map(|i: Int|
        {
          name: b"_".concat(ascii_of_int(i)),
          ty: match branches.at(i) {
            Some(b) -> return_type_of(type_of(b)),
            None -> unknown_type(),
          },
        }),
    ),
  );
  let op = Op({
    op: OfHandling(Parallel),
    args: words.args,
    uses: {
      takes: closures.args.map(|_: Arg| true).concat(described.args.map(|_: Arg| false)),
      owned: true,
      fails: true,
      suspends: true,
    },
  });
  let results = branches.map(|b: Arg| return_type_of(type_of(b)));
  let gathered = bound_as(words.st, parallel_results_type(results), AsWord, op, at);
  match gathered.arg {
    VarOperand(record) -> {
      let parts = range(0, branches.len()).fold(
        { st: gathered.st, fields: [] },
        |acc: { st: Lowering, fields: List<{ name: Bytes, arg: Arg }> }, i: Int| {
          let name = b"_".concat(ascii_of_int(i));
          let t = results.get(i);
          let w = bound_as(
            acc.st,
            t,
            AsWord,
            Get({ of: record, path: FieldPath({ name: name, at: i }) }),
            at,
          );
          let h = represented_as(w, representation_of(context.setting, t), at);
          { st: h.st, fields: acc.fields.push({ name: name, arg: h.arg }) }
        },
      );
      record_literal_as(context, parts.st, parts.fields, ty, at)
    },
    _ -> unreachable(b"a parallel block's results bound to no variable"),
  }
}

type ClauseLayout = {
  st: Lowering,
  args: List<Arg>,
  takes: List<Bool>,
  clauses: List<Clause>,
  unknown_effect: Option<Bytes>,
}

fn clause_added(
  context: Context,
  acc: ClauseLayout,
  cl: CodeClause,
  closure: Arg,
  at: Span,
) -> ClauseLayout / {abort.raise} =
  match effect_of(context, cl.effect) {
    None ->
      {
        ..acc,
        unknown_effect: match acc.unknown_effect { Some(u) -> Some(u), None -> Some(cl.effect) },
      },
    Some(en) -> {
      let stringed = cl.binds_label || (en.global == b"abort" && cl.op == b"raise");
      let bound = if stringed {
        let d = type_descriptor(context, acc.st, string_type(), at);
        { st: d.st, args: [d.arg] }
      } else { { st: acc.st, args: [] } };
      {
        st: bound.st,
        args: acc.args.push(closure).concat(bound.args),
        takes: acc.takes.push(true).concat(bound.args.map(|_: Arg| false)),
        clauses: acc.clauses.push({
          effect: en.global,
          op: cl.op,
          mode: clause_mode(context, cl),
          string: if stringed { Some(acc.args.len() + 1) } else { None },
          handler: acc.args.len(),
        }),
        unknown_effect: acc.unknown_effect,
      }
    },
  }

fn clause_mode(context: Context, cl: CodeClause) -> Int =
  if match effect_of(context, cl.effect) { Some(e) -> is_raise(op_mode(e, cl.op)), None -> false } {
    3
  } else if !cl.resume { 0 }
  else if resume_in_tail_only(cl) { 1 }
  else { 2 }

pub fn detaches(clauses: List<CodeClause>) -> Bool =
  clauses.any(|cl: CodeClause| cl.resume && !resume_in_tail_only(cl))

fn resume_in_tail_only(cl: CodeClause) -> Bool = {
  let k = cl.params + (if cl.binds_label { 1 } else { 0 });
  slots_read(cl.body).fold(0, |n: Int, y: Int| if y == k { n + 1 } else { n })
    == tail_calls_of(cl.body, k)
}

fn tail_calls_of(code: Code, k: Int) -> Int =
  match code.node {
    CodeApply(a) -> match a.function.node {
      CodeVar(v) -> if v.slot == k && a.args.len() == 1 && !all_read(a.args).contains(k) { 1 }
      else { 0 },
      _ -> 0,
    },
    CodeIf(i) -> tail_calls_of(i.then_branch, k) + tail_calls_of(i.else_branch, k),
    CodeBlock(b) -> match b.tail { Some(t) -> tail_calls_of(t, k), None -> 0 },
    CodeMatch(m) -> m.arms.fold(0, |n: Int, a: CodeArm| n + tail_calls_of(a.body, k)),
    _ -> 0,
  }

fn bound_in(c: Code) -> List<Int> =
  match c.node {
    CodeBlock(b) ->
      b.statements.fold([], |acc: List<Int>, s: CodeStatement|
        acc.concat(match s {
          CodeLet(l) -> bound_in(l.value).push(l.slot),
          CodeLetDestructure(l) -> bound_in(l.value).concat(pattern_slots(l.pattern)),
          CodeDo(d) -> bound_in(d.code),
        })).concat(match b.tail { Some(t) -> bound_in(t), None -> [] }),
    CodeIf(i) -> bound_in(i.cond).concat(bound_in(i.then_branch)).concat(bound_in(i.else_branch)),
    CodeMatch(m) ->
      m.arms.fold(bound_in(m.scrutinee), |acc: List<Int>, a: CodeArm|
        acc.concat(pattern_slots(a.pattern)).concat(match a.guard {
          Some(g) -> bound_in(g),
          None -> [],
        }).concat(
          bound_in(a.body),
        )),
    CodeUnary(u) -> bound_in(u.operand),
    CodeBinary(x) -> bound_in(x.lhs).concat(bound_in(x.rhs)),
    CodeApply(a) ->
      a.args.fold(bound_in(a.function), |acc: List<Int>, x: Code| acc.concat(bound_in(x))),
    CodeList(l) -> l.items.fold([], |acc: List<Int>, x: Code| acc.concat(bound_in(x))),
    CodeRecord(r) ->
      r.fields.fold([], |acc: List<Int>, f: CodeField| acc.concat(bound_in(f.value))),
    CodeFieldRead(f) -> bound_in(f.base),
    CodeUpdate(u) ->
      u.sets.fold(bound_in(u.base), |acc: List<Int>, f: CodeField| acc.concat(bound_in(f.value))),
    CodePerform(p) -> p.args.fold([], |acc: List<Int>, x: Code| acc.concat(bound_in(x))),
    CodeParallel(pr) -> pr.branches.fold([], |acc: List<Int>, x: Code| acc.concat(bound_in(x))),
    CodeHandle(hd) -> bound_in(hd.body),
    _ -> [],
  }

fn escapes(b: Block, matched: Bool, looped: Bool) -> Bool =
  b.fold(false, |found: Bool, i: Inst|
    found
      || (match i {
        Return(_) -> true,
        Restart(_) -> true,
        Jump(_) -> true,
        Miss -> !matched,
        Next(_) -> !looped,
        Done(_) -> !looped,
        If(x) -> escapes(x.then, matched, looped) || escapes(x.otherwise, matched, looped),
        Case(c) ->
          c.arms.fold(
            escapes(c.rest, matched, looped),
            |any: Bool, a: { when: Int, body: Block }| any || escapes(a.body, matched, looped),
          ),
        Match(m) ->
          m.arms.fold(escapes(m.rest, matched, looped), |any: Bool, a: Block|
            any || escapes(a, true, looped)),
        Loop(l) -> escapes(l.body, matched, true),
        Handle(hd) -> escapes(hd.body, false, false),
        _ -> false,
      }))

fn return_type_of(t: Type) -> Type = match t { FunctionType(f) -> f.ret, _ -> unknown_type() }

fn param_of(t: Type) -> Type =
  match t {
    FunctionType(f) -> match f.params.at(0) { Some(p) -> p, None -> unknown_type() },
    _ -> unknown_type(),
  }

fn op_declared(e: EffectName, op: Bytes) -> EffectOperation =
  e.operations.fold(
    { name: op, mode: ReadMode, params: [], ret: unknown_type(), own: [] },
    |acc: EffectOperation, o: EffectOperation| if o.name == op { o } else { acc },
  )

fn op_mode(e: EffectName, op: Bytes) -> Mode = op_declared(e, op).mode

fn mode_code(m: Mode) -> Int =
  match m { ReadMode -> 0, WriteMode -> 1, RaiseMode -> 2, InvalidMode -> 0 }
