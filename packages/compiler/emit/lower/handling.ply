//! `perform`, labels, `handle` and `parallel`. A perform calls the entry of its operation in the
//! evidence object the body holds for its effect; a `handle` is a block its body runs in over an
//! instance its evidence objects' clause slots point into, inline or detached on a stack of its own
//! where a clause resumes off its tail. Effects are named program-wide.

import compiler.emit.code (Code, CodeClause, CodeReturn, CodeStmt, CLet, CLetPat, CDo, CodeArm,
                           CodeField, NApp, NVar, NIf, NBlock, NMatch, NUnary, NBinary, NField,
                           NUpdate, NRecord, NList, NPerform, NParallel, NHandle, NLambda,
                           slots_read, all_read, pat_slots)
import compiler.emit.keys (Evidence)
import compiler.emit.evidence (evidence_type, instance_block_type, row_described_type)
import compiler.syntax.parsing (Span)
import compiler.syntax.exprs (is_exit_effect, scheduler_module)
import compiler.syntax.items (is_shipped)
import compiler.check.types (Type, TyVar, TyCon, TyFn, TyRecord, TyNominal, Field, Row, Resource,
                             RNamed, RSingleton, RAny, RVar, int_type, string_type, fields_sorted,
                             fn_type, row_empty)
import compiler.check.infer.expr (kept_type, crossing_vars, crossing_own)
import compiler.emit.typing (unknown_type)
import compiler.expand.rewrite (named_program_wide)
import compiler.check.infer.checker (prelude_effects, EffectInfo, OpInfo)
import compiler.syntax.type_syntax (Mode, MRead, MWrite, MRaise, MBad, is_raise)
import std.bytes (ascii_of_int)
import compiler.emit.reps (EffectName, OpMode, gathered_of, type_vars)
import compiler.emit.keys (module_of)
import compiler.emit.marks (carried_by, kept_form)
import compiler.emit.tir (RInt, RWord, RImm, Arg, AVar, AZero, Inst, Block, Op, OHandle, Get,
                          PField, Assign, If, Case, Match, Miss, Loop, Next, Done, Return, Restart,
                          Enter, Handle, Uses, AInt, Static, falls_through, reads)
import compiler.emit.tir.handling (Perform, Label, Parallel, Unsettled, Clause, Bridge, Instance,
                                   InstanceHeap, InstanceIn, Entering, ForwardsLaid, ForwardsSet,
                                   ObjectAt, Mapped, Slot, Answering, Forwarding, Forwarded, Keyed,
                                   KeyedRow, Entry, Answers, Schedules, Stops, Resumes, Raises,
                                   HandleInstance, Returning, raised_at)
import compiler.emit.lower.crossing (op_described, type_described, effect_of, exit_effect_named,
                                     own_types)
import compiler.emit.lower.kept (crossed_kept)
import compiler.emit.lower.base (Context, Lowering, Lowered, Frame, Worded, Held, unreachable,
                                 fresh, bound_as, done, emitted, continued, filed, unfiled, type_of,
                                 handed, static_added)
import compiler.emit.lower.evidence (words_at, routed, around, bridged, held_routed, label_resource,
                                     value_handing, described, label_value, filed_row)
import compiler.emit.lower.held (held_as)
import compiler.emit.lower.setting (op_mode_of)
import compiler.emit.lower.data (recorded_as)

/// Operation `op` of `effect` performed on `resource` with `args`, at `label` where one is read,
/// written `written`: the label opened as the field-table entry it is, each argument handed over as
/// a word to the entry of the object the body holds for the effect there, and what the entry
/// answers, a word, held as `answer`, or, where that is `None`, as the type the checker filed for
/// the perform. Where a program declares the effect, a value of one of the operation's own type
/// parameters crosses kept, as the clause, compiled once for every perform, holds it (`kept_by`).
pub fn performed(
  cx: Context,
  st: Lowering,
  p: { effect: Bytes, op: Bytes, resource: Bytes },
  label: Option<Arg>,
  written: Option<Code>,
  args: List<Arg>,
  answer: Option<Type>,
  at: Span,
) -> Lowered / {abort.raise} =
  match effect_named(cx, p.effect) {
    None -> unreachable(b"an effect the lowering does not resolve: ".concat(p.effect)),
    Some(named) -> {
      let en = match effect_of(cx, named.global) { Some(e) -> e, None -> named };
      let index = range(0, en.ops.len()).find(|k: Int|
        match en.ops.at(k) { Some(o) -> o.name == p.op, None -> false });
      let resource = match written {
        Some(c) -> label_resource(cx, c),
        None -> if p.resource == b"" { RSingleton } else { RNamed(p.resource) },
      };
      let word = bridged(
        st,
        routed(cx, [{ evidence: { effect: en.global, resource: resource }, through: false }]),
        at,
      );
      // The label is opened first, so an argument boxed after it fails holding no count of it.
      let keyed = match label {
        Some(l) -> {
          let k = handed({ st: word.st, arg: l }, RInt, at);
          { st: k.st, args: [k.arg] }
        },
        None -> { st: word.st, args: [] },
      };
      let declared = op_declared(en, p.op);
      let mode = declared.mode;
      let kept = kept_by(en.global, declared);
      let crossed = range(0, args.len()).fold(
        { st: keyed.st, args: [] },
        |acc: { st: Lowering, args: List<Arg> }, i: Int| {
          let x = crossed_in(cx, acc.st, declared.params.at(i), kept, args.get(i), at);
          { st: x.st, args: acc.args.push(x.arg) }
        },
      );
      let words = crossed.args.fold(
        { st: crossed.st, args: [] },
        |acc: { st: Lowering, args: List<Arg> }, a: Arg| {
          let w = handed({ st: acc.st, arg: a }, RWord, at);
          { st: w.st, args: acc.args.push(w.arg) }
        },
      );
      let typed = match answer {
        Some(a) -> Some(a),
        None -> match filed(cx, at) { Some(f) -> Some(f.ty), None -> None },
      };
      match typed {
        None -> unfiled(cx, b"a perform", at),
        Some(ty) -> {
          let out = if is_raise(mode) { { ty: ty, marked: None } }
          else { crossed_out(declared.ret, kept, ty) };
          let d = op_described(
            cx,
            words.st,
            en.global,
            declared,
            crossed.args.map(type_of),
            out.ty,
          );
          let uses = {
            takes: keyed.args.map(|_: Arg| false).concat(words.args.map(|_: Arg| true)),
            owned: true,
            fails: true,
            stops: !is_raise(mode),
          };
          let op = match ((d.name, index)) {
            (Some(described), Some(k)) ->
              Op({
                op: OHandle(
                  Perform({
                    effect: en.global,
                    op: p.op,
                    index: k,
                    resource: if label == None { p.resource } else { b"" },
                    labelled: label != None,
                    mode: mode_code(mode),
                    described: described,
                  }),
                ),
                args: word.args.concat(keyed.args).concat(words.args),
                uses: { ..uses, takes: [false].concat(uses.takes) },
              }),
            _ ->
              Op({ op: OHandle(Unsettled(p.op)), args: keyed.args.concat(words.args), uses: uses }),
          };
          let answered = handed(
            bound_as(d.st, out.ty, RWord, op, at),
            held_as(cx.setting, out.ty),
            at,
          );
          match out.marked {
            None -> answered,
            Some(m) -> crossed_kept(cx, answered.st, answered.arg, m, false, at),
          }
        },
      }
    },
  }

/// The own type parameters of `op`, of the effect named `global` program-wide, whose values a
/// perform hands its clause kept: where a program declares the effect, each a value crosses at;
/// none of an operation of `std.prelude` or of a module the toolchain ships, whose crossings are
/// written in Ply.
fn kept_by(global: Bytes, op: OpMode) -> List<Int> / {abort.raise} =
  if global.index_of(b".") == None || is_shipped(global) { [] }
  else { crossing_own(op.params, op.ret, op.mode, op.own) }

fn names_kept(declared: Type, kept: List<Int>) -> Bool =
  type_vars(declared).any(|v: Int| kept.contains(v))

/// `a`, which a perform hands where its operation declares a value of `declared`, as the clause takes
/// it: each place one of `kept` stands at in `declared` kept (`crossed_kept`).
fn crossed_in(
  cx: Context,
  st: Lowering,
  declared: Option<Type>,
  kept: List<Int>,
  a: Arg,
  at: Span,
) -> Lowered / {abort.raise} =
  match declared {
    Some(d) -> if !names_kept(d, kept) { { st: st, arg: a } }
    else { crossed_kept(cx, st, a, carried_by(d, type_of(a), kept).marked, true, at) },
    None -> { st: st, arg: a },
  }

/// What a perform's entry answers where its operation declares an answer of `declared` and the
/// checker filed `filed` for it: its type, each place one of `kept` stands at kept, and the
/// answer's type so marked, which the perform opens it at.
fn crossed_out(
  declared: Type,
  kept: List<Int>,
  filed: Type,
) -> { ty: Type, marked: Option<Type> } / {abort.raise} =
  if !names_kept(declared, kept) { { ty: filed, marked: None } } else {
    let marked_ty = carried_by(declared, filed, kept).marked;
    { ty: kept_form(marked_ty), marked: Some(marked_ty) }
  }

/// The call a perform of `p` with `args`, lowered from `codes`, is written as where a value of the
/// operation's own type parameters crosses and the toolchain declares its effect (GUIDE §6.1): its
/// crossing in the toolchain's scheduler, at the types the perform stands its type parameters at
/// and filling its row variables with what the perform fills the operation's own rows with. None
/// for any other perform, and for one whose types are already `Kept`.
pub fn crossing_of(
  cx: Context,
  p: { effect: Bytes, op: Bytes, resource: Bytes },
  codes: List<Code>,
  args: List<Arg>,
  at: Span,
) -> Option<{ name: Bytes, types: List<Type>, rows: List<Row> }> / {abort.raise} =
  match ((effect_named(cx, p.effect), filed(cx, at))) {
    (Some(named), Some(t)) -> {
      let crossing = match prelude_effects().find(|e: EffectInfo| e.name == named.global) {
        Some(e) -> match e.ops.find(|o: OpInfo| o.name == p.op) {
          Some(o) -> crossing_vars(o),
          None -> [],
        },
        None -> [],
      };
      let en = match effect_of(cx, named.global) { Some(e) -> e, None -> named };
      let declared = op_declared(en, p.op);
      let types = own_types(declared, args.map(type_of), t.ty);
      if crossing.len() == 0 || types.any(|x: Option<Type>| x == None)
          || crossing.all(|i: Int| types.at(i) == Some(Some(kept_type()))) { None } else {
        Some({
          name: Bytes::concat_all([scheduler_module(), b"::crossing_", p.op]),
          types: types.fold([], |acc: List<Type>, x: Option<Type>|
            match x { Some(y) -> acc.push(y), None -> acc }),
          rows: range(0, declared.params.len()).fold([], |acc: List<Row>, i: Int|
            match declared.params.at(i) {
              Some(TyFn(f)) -> if f.effects.tail == None { acc } else {
                acc.push(match codes.at(i) {
                  Some(c) -> match c.node {
                    NLambda(l) -> filed_row(cx, l.at),
                    _ -> match args.at(i) {
                      Some(a) -> match type_of(a) { TyFn(g) -> g.effects, _ -> row_empty() },
                      None -> row_empty(),
                    },
                  },
                  None -> row_empty(),
                })
              },
              _ -> acc,
            }),
        })
      }
    },
    _ -> None,
  }

/// The field-table entry of resource `name`, as a call's label argument.
pub fn label(cx: Context, st: Lowering, name: Bytes, at: Span) -> Lowered =
  bound_as(
    st,
    int_type(),
    RInt,
    Op({
      op: OHandle(Label(name)),
      args: [],
      uses: { takes: [], owned: false, fails: false, stops: false },
    }),
    at,
  )

/// How clause `clause`'s body is laid out as a function of its own: its parameters, then the call
/// site's label where it binds one, then its continuation where it resumes; holding `held`, the
/// words its row takes as they stand where the `handle` is, since what calls it hands none.
pub fn clause_frame(clause: CodeClause, held: Held) -> Frame =
  {
    params: clause.params + (if clause.binds_label { 1 } else { 0 })
      + (if clause.resume { 1 } else { 0 }),
    size: clause.size,
    captures: clause.captures,
    resumes: clause.resume,
    body: clause.body,
    ty: None,
    words: [],
    held: held,
  }

/// How a `handle`'s return clause is laid out as a function of its own: the value the body answered,
/// then what it copies in; holding `held`, as a clause does.
pub fn ret_frame(r: CodeReturn, held: Held) -> Frame =
  {
    params: 1,
    size: r.size,
    captures: r.captures,
    resumes: false,
    body: r.body,
    ty: None,
    words: [],
    held: held,
  }

/// How a `handle` answers what its clauses do: through evidence objects laid over an instance in
/// the frame of the function it is written in, or on the heap in a counted block where its body
/// runs detached or that function may spawn a task, either of which may outlive the frame, the
/// instance's word, layout and block here; and where the body runs detached, its forwarding block.
pub type Planned = {
  st: Lowering,
  instance: { word: Arg, layout: HandleInstance, block: Option<Arg> },
  forwarding: Option<Forwards>,
}

/// A detached body's forwarding block: its address, and the words the body, its clauses and its
/// return clause hold for what is around the `handle`, which forward to the words the call resuming
/// it hands, so a body resumed after the function around it returned reaches no word that function
/// held.
pub type Forwards = { word: Arg, outer: List<Worded> }

/// The `handle` `h` written at `at` planned after `st`, its instance laid out: the fuel and unwind
/// words, each clause's record, then the return clause's, its variables and its keyed tables.
pub fn handle_planned(
  cx: Context,
  st: Lowering,
  h: { body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> },
  at: Span,
) -> Planned / {abort.raise} = {
  let detached = detaches(h.clauses);
  let keys = instance_keys(cx, h.clauses);
  // An object over an effect whose operations are unknown holds no slot a perform could read.
  let known = match keys.find(|k: Key| k.effect.ops.len() == 0) {
    Some(k) ->
      unreachable(
        b"a handle of an effect whose operations the lowering does not know: ".concat(
          k.effect.global,
        ),
      ),
    None -> st,
  };
  let f = if !detached { { st: known, forwarding: None } } else {
    let made = forwarding(cx, known, at);
    { st: made.st, forwarding: Some(made.forwarding) }
  };
  let around = match f.forwarding { Some(w) -> { ..cx, words: w.outer }, None -> cx };
  let raised = h.clauses.fold(0, |m: Int, cl: CodeClause|
    if clause_mode(cx, cl) == 3 && cl.params > m { cl.params } else { m });
  let records = raised_at() + raised;
  let returned = h.clauses.len();
  let vars = records + 4 * (returned + (if h.ret == None { 0 } else { 1 }));
  let count = handler_vars(h.body);
  let tables = keys.fold(0, |n: Int, k: Key| n + tables_of(key_planned(around, h.clauses, k)));
  let objects = keys.fold(0, |n: Int, k: Key| n + object_words(k));
  let layout = {
    operand: 0,
    records: range(0, h.clauses.len()).map(|k: Int| records + 4 * k),
    vars: vars,
    count: count,
    pending: range(0, h.clauses.len()).find(|k: Int|
      match h.clauses.at(k) { Some(cl) -> answers_abort(cx, cl), None -> false }),
    answer: None,
    raised: range(0, h.clauses.len()).filter(|k: Int|
      match h.clauses.at(k) {
        Some(cl) -> clause_mode(cx, cl) == 3 && !answers_abort(cx, cl),
        None -> false,
      }),
    heap: None,
    ret: if h.ret == None { None } else { Some(records + 4 * returned) },
    preset: false,
  };
  let words = vars + 2 * count + objects + tables;
  if detached || spawning(cx) {
    let b = bound_as(
      f.st,
      instance_block_type(),
      RWord,
      Op({
        op: OHandle(InstanceHeap(words)),
        args: [],
        uses: { takes: [], owned: true, fails: false, stops: false },
      }),
      at,
    );
    let i = bound_as(
      b.st,
      evidence_type(),
      RImm,
      Op({ op: OHandle(InstanceIn), args: [b.arg], uses: reads(1) }),
      at,
    );
    {
      st: i.st,
      instance: { word: i.arg, layout: layout, block: Some(b.arg) },
      forwarding: f.forwarding,
    }
  } else {
    let i = bound_as(
      f.st,
      evidence_type(),
      RImm,
      Op({ op: OHandle(Instance(words)), args: [], uses: reads(0) }),
      at,
    );
    { st: i.st, instance: { word: i.arg, layout: layout, block: None }, forwarding: None }
  }
}

/// Whether the function `cx` lowers may spawn a task, which holds none of its words.
fn spawning(cx: Context) -> Bool = cx.words.any(|w: Worded| w.evidence.effect == b"task")

/// Where a detached body's forwarding block holds what: its header, the words around the `handle`
/// it forwards to, the task that handed each, which the runtime writes, the labels their descriptor
/// leaves to them and each forwarding object with its records; and how many words it holds.
type Placed = { targets: Int, tasks: Int, labels: Int, forwards: List<Int>, words: Int }

/// A word around a detached `handle` its body forwards to, and how many operations the effect it
/// answers has; none for an effect whose operations the lowering does not know, which the body
/// reaches through the bridge.
type Outer = { word: Worded, ops: Int }

/// A detached body's forwarding block laid out on the heap after `st`: its header, the words around
/// the `handle` it forwards to, and an object forwarding to each, which each call resuming the body
/// points at the words that call hands.
fn forwarding(
  cx: Context,
  st: Lowering,
  at: Span,
) -> { st: Lowering, forwarding: Forwards } / {abort.raise} = {
  let known = cx.words.fold([], |acc: List<Outer>, w: Worded|
    match effect_of(cx, w.evidence.effect) {
      Some(e) -> if e.ops.len() > 0 { acc.push({ word: w, ops: e.ops.len() }) } else { acc },
      None -> acc,
    });
  let outer = known.map(|f: Outer| f.word);
  let labels = outer.filter(|w: Worded| match w.evidence.resource { RVar(_) -> true, _ -> false });
  let header = 5;
  let tasks = header + outer.len();
  let forwards = known.fold(
    { at: tasks + outer.len() + labels.len(), starts: [] },
    |acc: { at: Int, starts: List<Int> }, f: Outer|
      { at: acc.at + 1 + 5 * f.ops, starts: acc.starts.push(acc.at) },
  );
  let placed = {
    targets: header,
    tasks: tasks,
    labels: tasks + outer.len(),
    forwards: forwards.starts,
    words: forwards.at,
  };
  let block = bound_as(
    st,
    evidence_type(),
    RImm,
    Op({ op: OHandle(ForwardsLaid(placed.words)), args: [], uses: reads(0) }),
    at,
  );
  let headed = forwarding_header(cx, block.st, block.arg, outer, placed, at);
  let forwarded = range(0, known.len()).fold(
    { st: headed, words: [] },
    |acc: { st: Lowering, words: List<Worded> }, i: Int| {
      let f = known.get(i);
      let start = placed.forwards.get(i);
      let o = bound_as(
        acc.st,
        evidence_type(),
        RImm,
        Op({
          op: OHandle(
            ObjectAt({
              at: start,
              slots: range(0, f.ops).map(|j: Int|
                Forwarded({
                  target: placed.targets + i,
                  task: placed.tasks + i,
                  record: start + 1 + 2 * f.ops + 3 * j,
                })),
            }),
          ),
          args: [block.arg],
          uses: reads(1),
        }),
        at,
      );
      { st: o.st, words: acc.words.push({ ..f.word, word: o.arg }) }
    },
  );
  // A word whose effect's operations the lowering does not know reaches the bridge.
  let unknown = cx.words.filter(|w: Worded| !outer.contains(w));
  let bridged_unknown = if unknown.len() == 0 { { st: forwarded.st, words: [] } } else {
    let b = bound_as(
      forwarded.st,
      evidence_type(),
      RImm,
      Op({ op: OHandle(Bridge), args: [], uses: reads(0) }),
      at,
    );
    { st: b.st, words: unknown.map(|w: Worded| { ..w, word: b.arg }) }
  };
  {
    st: bridged_unknown.st,
    forwarding: { word: block.arg, outer: forwarded.words.concat(bridged_unknown.words) },
  }
}

/// The header of a detached body's forwarding block at `block`, and the words and labels around the
/// `handle` it forwards to as they stand when the `handle` opens: the unit's word mapping, the
/// descriptor of what the words answer, how many they are and how many words the block holds.
fn forwarding_header(
  cx: Context,
  st: Lowering,
  block: Arg,
  outer: List<Worded>,
  placed: Placed,
  at: Span,
) -> Lowering / {abort.raise} = {
  let set = |s: Lowering, k: Int, a: Arg|
    done(s, Op({ op: OHandle(ForwardsSet(k)), args: [block, a], uses: reads(2) }), at);
  let mapped = bound_as(
    st,
    evidence_type(),
    RImm,
    Op({ op: OHandle(Mapped), args: [], uses: reads(0) }),
    at,
  );
  let d = static_added(mapped.st, described(outer.map(|w: Worded| w.evidence)));
  let desc = bound_as(d.st, row_described_type(), RImm, Static(d.name), at);
  let words = bridged(desc.st, outer.map(|w: Worded| w.word), at);
  let headed = set(
    set(set(set(words.st, 1, mapped.arg), 2, desc.arg), 3, AInt(outer.len())),
    4,
    AInt(placed.words),
  );
  let targeted = range(0, words.args.len()).fold(headed, |s: Lowering, i: Int|
    set(s, placed.targets + i, words.args.get(i)));
  let labels = outer.fold([], |acc: List<Arg>, w: Worded|
    match w.evidence.resource { RVar(p) -> acc.push(label_value(cx, p)), _ -> acc });
  range(0, labels.len()).fold(targeted, |s: Lowering, l: Int|
    set(s, placed.labels + l, labels.get(l)))
}

/// Whether clause `cl` answers `abort.raise`, which a raise the runtime left pending reaches.
fn answers_abort(cx: Context, cl: CodeClause) -> Bool / {abort.raise} =
  cl.op == b"raise"
    && (match effect_named(cx, cl.effect) { Some(en) -> en.global == b"abort", None -> false })

/// How many variables the `handle` whose body is `body` holds: what its body's first statements
/// install.
fn handler_vars(body: Code) -> Int =
  match body.node {
    NBlock(b) ->
      b.stmts.fold(0, |n: Int, s: CodeStmt|
        match s {
          CDo(d) -> match d.code.node {
            NApp(a) -> match a.func.node {
              NVar(v) -> if v.name == b"?handler_init" { n + 1 } else { n },
              _ -> n,
            },
            _ -> n,
          },
          _ -> n,
        }),
    _ -> 0,
  }

/// What a clause or the return clause of a `handle` planned as `plan`, written at `at`, holds: the
/// words its row takes as they stand around the `handle`, each the bridge where none answers,
/// and the instance.
pub fn clause_held(
  cx: Context,
  st: Lowering,
  plan: Planned,
  at: Span,
) -> { st: Lowering, held: Held } / {abort.raise} = {
  let around = match plan.forwarding { Some(f) -> { ..cx, words: f.outer }, None -> cx };
  let words = held_routed(around, st, words_at(cx, at), at);
  {
    st: words.st,
    held: {
      words: words.words,
      instance: Some({ word: plan.instance.word, vars: plan.instance.layout.vars }),
      kept: cx.kept,
    },
  }
}

/// The keys a `handle` of `clauses` answers: each effect and resource a clause answers there,
/// once, with the effect's operations, none for an effect the lowering does not know.
fn handle_keys(
  cx: Context,
  clauses: List<CodeClause>,
) -> List<{ evidence: Evidence, effect: EffectName }> / {abort.raise} =
  clauses.fold([], |acc: List<{ evidence: Evidence, effect: EffectName }>, cl: CodeClause| {
    let en = match effect_named(cx, cl.effect) {
      None -> { written: cl.effect, global: cl.effect, ops: [] },
      Some(named) -> match effect_of(cx, named.global) { Some(e) -> e, None -> named },
    };
    let answered = { effect: en.global, resource: clause_resource(cx, cl) };
    if acc.any(|k: { evidence: Evidence, effect: EffectName }| k.evidence == answered) { acc }
    else { acc.push({ evidence: answered, effect: en }) }
  })

/// `cx` inside the body of a `handle` planned as `plan`, run in place, and the state after `st`
/// holding what it needs: before any word it held, a word for each effect and resource a clause
/// answers there, an evidence object whose slots enter the clauses answering its operations and
/// copy the rest from the word around the `handle`.
pub fn handle_entered(
  cx: Context,
  st: Lowering,
  h: { body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> },
  plan: Planned,
  at: Span,
) -> { cx: Context, st: Lowering } / {abort.raise} = {
  let i = plan.instance;
  let made = instance_objects(cx, st, h, plan, at);
  {
    cx: {
      ..cx,
      words: made.words.concat(cx.words),
      instance: Some({ word: i.word, vars: i.layout.vars }),
      kept: match i.block { Some(b) -> cx.kept.push(b), None -> cx.kept },
    },
    st: made.st,
  }
}

/// The objects of the `handle` `h` planned as `plan`, over its instance, laid after `st`: one for
/// each key its clauses answer, each slot entering a clause, the word around the `handle` (the
/// forwarding block's, where the body runs detached) or a table of them.
pub fn instance_objects(
  cx: Context,
  st: Lowering,
  h: { body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> },
  plan: Planned,
  at: Span,
) -> { st: Lowering, words: List<Worded> } / {abort.raise} = {
  let i = plan.instance;
  let around = match plan.forwarding { Some(f) -> { ..cx, words: f.outer }, None -> cx };
  let keys = instance_keys(cx, h.clauses);
  let first = i.layout.vars + 2 * i.layout.count;
  let made = keys.fold(
    {
      st: st,
      words: [],
      object: first,
      table: first + keys.fold(0, |n: Int, k: Key| n + object_words(k)),
    },
    |acc: { st: Lowering, words: List<Worded>, object: Int, table: Int }, k: Key| {
      let kp = key_planned(around, h.clauses, k);
      let o = object_laid(around, acc.st, h.clauses, i, kp, acc.object, acc.table, at);
      {
        st: o.st,
        words: acc.words.push({
          evidence: kp.key.evidence,
          word: o.arg,
          through: false,
          handled: true,
        }),
        object: acc.object + object_words(k),
        table: acc.table + tables_of(kp),
      }
    },
  );
  { st: made.st, words: made.words }
}

/// How many words key `k`'s object takes in its instance: its flags, then an entry and its
/// environment per operation of its effect.
fn object_words(k: Key) -> Int = 1 + 2 * k.effect.ops.len()

/// An effect and resource a `handle` answers, with the effect's operations.
type Key = { evidence: Evidence, effect: EffectName }

/// The keys an instance's objects answer: each effect and resource a clause answers, once; an
/// effect a clause answers on every label has the one key on every label, which takes all its
/// clauses, so their order holds across labels.
fn instance_keys(cx: Context, clauses: List<CodeClause>) -> List<Key> / {abort.raise} = {
  let keys = handle_keys(cx, clauses);
  keys.filter(|k: Key|
    k.evidence.resource == RAny
      || !keys.any(|o: Key| o.evidence.effect == k.evidence.effect && o.evidence.resource == RAny))
}

/// What an operation's slot of an instance's object enters: the clause at its place, the word its
/// key is routed to around the `handle`, or a table of clauses (by place) then of words around the
/// `handle` (by place among its key's), the first whose label is the perform's.
type SlotPlan = | ByClause(Int) | ByWord | ByTable({ clauses: List<Int>, words: List<Int> })

/// A key of an instance, the words around the `handle` its tables forward to by label, innermost
/// first up to the first on every label, and what each of its operations' slots enters.
type KeyPlan = { key: Key, outer: List<Worded>, slots: List<SlotPlan> }

/// Key `k` of a `handle` of `clauses` planned: a key on one resource enters the clause answering
/// an operation there, or else the word around; one on every label, the first clause answering the
/// operation in clause order where it answers every label, and otherwise a table of the clauses up
/// to that one, then of the words around where no clause answers every label and those differ by
/// label. A perform through a clause on every label so reads no table.
fn key_planned(cx: Context, clauses: List<CodeClause>, k: Key) -> KeyPlan / {abort.raise} = {
  let every = k.evidence.resource == RAny;
  let outer = if !every { [] } else {
    cx.words.fold(
      { out: [], closed: false },
      |acc: { out: List<Worded>, closed: Bool }, w: Worded|
        if acc.closed || w.evidence.effect != k.evidence.effect { acc }
        else { { out: acc.out.push(w), closed: w.evidence.resource == RAny } },
    ).out
  };
  let plain = outer.len() == 0 || (outer.len() == 1 && outer.get(0).evidence.resource == RAny);
  let answering = |op: Bytes|
    range(0, clauses.len()).filter(|c: Int|
      match clauses.at(c) {
        Some(cl) ->
          cl.op == op
            && (match effect_named(cx, cl.effect) {
              Some(en) -> en.global == k.evidence.effect,
              None -> false,
            })
            && (every || clause_resource(cx, cl) == k.evidence.resource),
        None -> false,
      });
  let on_every = |c: Int|
    match clauses.at(c) { Some(cl) -> clause_resource(cx, cl) == RAny, None -> false };
  let words = range(0, outer.len());
  {
    key: k,
    outer: outer,
    slots: k.effect.ops.map(|op: OpMode| {
      let all = answering(op.name);
      if !every { match all.at(0) { Some(c) -> ByClause(c), None -> ByWord } } else {
        let reach = all.fold(
          { out: [], closed: false },
          |acc: { out: List<Int>, closed: Bool }, c: Int|
            if acc.closed { acc } else { { out: acc.out.push(c), closed: on_every(c) } },
        );
        match reach.out.at(0) {
          None -> if plain { ByWord } else { ByTable({ clauses: [], words: words }) },
          Some(c) -> if on_every(c) { ByClause(c) }
          else { ByTable({ clauses: reach.out, words: if reach.closed { [] } else { words } }) },
        }
      }
    }),
  }
}

/// How many words the tables of the slots `kp` plans take in the instance: for each, its count,
/// then a label, an entry and its environment per row.
fn tables_of(kp: KeyPlan) -> Int =
  kp.slots.fold(0, |n: Int, s: SlotPlan|
    match s { ByTable(t) -> n + 1 + 3 * (t.clauses.len() + t.words.len()), _ -> n })

/// The object for key `kp` laid at word `object` of instance `i` after `st`, so it lives as long as
/// the instance, its tables from word `table` of the instance on: its operands the instance, the word its key is routed to around the `handle` (zero
/// where no slot forwards to it), the words its tables forward to, then the labels the tables' rows
/// answer.
fn object_laid(
  cx: Context,
  st: Lowering,
  clauses: List<CodeClause>,
  i: { word: Arg, layout: HandleInstance, block: Option<Arg> },
  kp: KeyPlan,
  object: Int,
  table: Int,
  at: Span,
) -> Lowered / {abort.raise} = {
  // The word the key is routed to around the `handle`, where a slot forwards to it.
  let routed_to = if kp.slots.any(|x: SlotPlan| x == ByWord) {
    bridged(st, [around(cx, kp.key.evidence)], at)
  } else { { st: st, args: [AZero(RImm)] } };
  let first_label = 2 + kp.outer.len();
  let clause_slot = |c: Int| {
    let cl = clauses.get(c);
    let entry = match entry_of(clause_mode(cx, cl)) {
      Answers -> if module_of(cx.key) == scheduler_module() && !cl.binds_label { Schedules }
      else { Answers },
      other -> other,
    };
    Answering({ entry: entry, record: i.layout.records.get(c), labelled: cl.binds_label })
  };
  // Each row's label as an operand, made where the label is named.
  let labelled = |s: Lowering, labels: List<Arg>, r: Resource|
    match r {
      RAny -> { st: s, labels: labels, at: None },
      RSingleton ->
        { st: s, labels: labels.push(AInt(0 - 1)), at: Some(first_label + labels.len()) },
      RVar(p) ->
        { st: s, labels: labels.push(label_value(cx, p)), at: Some(first_label + labels.len()) },
      RNamed(n) -> {
        let l = label(cx, s, n, at);
        { st: l.st, labels: labels.push(l.arg), at: Some(first_label + labels.len()) }
      },
    };
  let laid = range(0, kp.slots.len()).fold(
    { st: routed_to.st, labels: [], slots: [], table: table },
    |acc: { st: Lowering, labels: List<Arg>, slots: List<Slot>, table: Int }, j: Int|
      match kp.slots.get(j) {
        ByClause(c) -> { ..acc, slots: acc.slots.push(clause_slot(c)) },
        ByWord -> { ..acc, slots: acc.slots.push(Forwarding({ operand: 1, op: j })) },
        ByTable(t) -> {
          let by_clause = t.clauses.fold(
            { st: acc.st, labels: acc.labels, rows: [] },
            |r: { st: Lowering, labels: List<Arg>, rows: List<KeyedRow> }, c: Int| {
              let l = labelled(r.st, r.labels, clause_resource(cx, clauses.get(c)));
              {
                st: l.st,
                labels: l.labels,
                rows: r.rows.push({ label: l.at, enters: clause_slot(c) }),
              }
            },
          );
          let by_word = t.words.fold(
            by_clause,
            |r: { st: Lowering, labels: List<Arg>, rows: List<KeyedRow> }, w: Int| {
              let l = labelled(r.st, r.labels, kp.outer.get(w).evidence.resource);
              {
                st: l.st,
                labels: l.labels,
                rows: r.rows.push({ label: l.at, enters: Forwarding({ operand: 2 + w, op: j }) }),
              }
            },
          );
          {
            st: by_word.st,
            labels: by_word.labels,
            slots: acc.slots.push(Keyed({ table: acc.table, rows: by_word.rows })),
            table: acc.table + 1 + 3 * by_word.rows.len(),
          }
        },
      },
  );
  let outer = bridged(laid.st, kp.outer.map(|w: Worded| w.word), at);
  let operands = [i.word].concat(routed_to.args).concat(outer.args).concat(laid.labels);
  bound_as(
    outer.st,
    evidence_type(),
    RImm,
    Op({
      op: OHandle(ObjectAt({ at: object, slots: laid.slots })),
      args: operands,
      uses: reads(operands.len()),
    }),
    at,
  )
}

/// How a clause of the runtime's mode `mode` is entered from its slot.
fn entry_of(mode: Int) -> Entry =
  if mode == 3 { Raises } else if mode == 1 { Resumes } else if mode == 2 { Stops } else { Answers }

/// Whether clause `c` may stop its `handle` with what it answers, which its instance then holds.
fn may_stop(c: Clause) -> Bool = match entry_of(c.mode) { Resumes -> true, _ -> false }

/// The resource clause `cl` answers on, in the root's numbering: a label parameter's, every label,
/// one named, or none.
fn clause_resource(cx: Context, cl: CodeClause) -> Resource =
  if cl.label != None {
    match range(0, cx.label_names.len()).find(|i: Int| cx.label_names.at(i) == Some(cl.resource)) {
      Some(p) -> RVar(p),
      None -> RNamed(cl.resource),
    }
  } else if cl.resource == b"" { RSingleton }
  else if cl.resource == b"*" { RAny }
  else { RNamed(cl.resource) }

/// How a detached `handle`'s body is laid out as a function of its own, run on a stack of its own:
/// no parameters, each slot it reads that is bound around it copied in at its own number;
/// answering what the `handle` answers, `answer`, since its landing ends it; holding, since the
/// runtime hands it none, `own`, the `handle`'s objects, the words its forwarding block forwards
/// to what is around it, and the instance its landing reads.
pub fn body_frame(
  cx: Context,
  h: { body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> },
  plan: Planned,
  own: List<Worded>,
  answer: Type,
) -> Frame = {
  let inside = bound_in(h.body);
  let reads = slots_read(h.body).fold([], |acc: List<Int>, r: Int|
    if acc.contains(r) || inside.contains(r) { acc } else { acc.push(r) });
  {
    params: 0,
    size: reads.concat(inside).fold(0, |m: Int, r: Int| if r + 1 > m { r + 1 } else { m }),
    captures: reads.map(|r: Int| { src: r, dst: r }),
    resumes: false,
    body: h.body,
    ty: Some(fn_type([], answer, row_empty())),
    words: [],
    held: {
      words: own.concat(match plan.forwarding { Some(f) -> f.outer, None -> [] }),
      instance: Some({ word: plan.instance.word, vars: plan.instance.layout.vars }),
      kept: cx.kept,
    },
  }
}

/// The `handle` `h`, planned as `plan`, its body lowered to `body` (in a block of its own, or as a
/// closure where `body_frame` says it runs detached), its clauses' and return clause's closures
/// made: the clauses laid out over their closures, its instance holding their records, its body
/// run under them, and what it answers, a word, held as the type it answers.
pub fn handled(
  cx: Context,
  st: Lowering,
  body: Lowered,
  clauses: List<Arg>,
  ret: Option<Arg>,
  h: { body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> },
  plan: Planned,
  at: Span,
) -> Lowered / {abort.raise} = {
  let detached = detaches(h.clauses);
  let ty = match ret {
    Some(r) -> answer_of(type_of(r)),
    None -> if detached { answer_of(type_of(body.arg)) } else { type_of(body.arg) },
  };
  // The answer is held as its type holds it, and a `return` clause is handed the body's value as
  // its parameter's type holds it; a detached body answers the runtime a word.
  let answer_rep = if detached { RWord } else { held_as(cx.setting, ty) };
  let inner = if detached { { outer: body.st, block: [], word: None } }
  else if !falls_through(body.st.insts) {
    { outer: continued(st, body.st), block: body.st.insts, word: None }
  } else {
    match ret {
      Some(r) -> {
        let w = handed(body, held_as(cx.setting, param_of(type_of(r))), at);
        let given = done(
          w.st,
          Op({
            op: OHandle(Returning),
            args: [plan.instance.word, w.arg],
            uses: { takes: [false, true], owned: false, fails: false, stops: false },
          }),
          at,
        );
        { outer: continued(st, given), block: given.insts, word: None }
      },
      None -> {
        let w = handed(body, answer_rep, at);
        { outer: continued(st, w.st), block: w.st.insts, word: Some(w.arg) }
      },
    }
  };
  let laid = range(0, h.clauses.len()).fold(
    { st: inner.outer, args: [], takes: [], clauses: [], unknown: None },
    |acc: Laid, i: Int|
      match h.clauses.at(i) {
        None -> acc,
        Some(cl) -> match clauses.at(i) {
          None -> acc,
          Some(closure) -> clause_laid(cx, acc, cl, closure, at),
        },
      },
  );
  let tail = match ret {
    Some(r) -> { args: laid.args.push(r), takes: laid.takes.push(true), at: Some(laid.args.len()) },
    None -> { args: laid.args, takes: laid.takes, at: None },
  };
  let all = if detached {
    { args: tail.args.push(body.arg), takes: tail.takes.push(true), at: Some(tail.args.len()) }
  } else { { args: tail.args, takes: tail.takes, at: None } };
  // The `handle` only reads its closures, whose counts are the body's to let go, and, where a
  // clause may stop it, the descriptor of what it answers. A heap instance's block is read across
  // the body, so it lives until the landing; a detached body's forwarding block is the runtime's
  // once the body opens.
  let i = plan.instance;
  let held = all.args.push(i.word).concat(match i.block { Some(b) -> [b], None -> [] });
  let forwarded = held.concat(match plan.forwarding { Some(f) -> [f.word], None -> [] });
  let answer = if laid.clauses.any(may_stop) {
    let d = type_described(cx, laid.st, ty, at);
    { st: d.st, args: [d.arg] }
  } else { { st: laid.st, args: [] } };
  // The runtime takes a detached body's closure, and nothing else the `handle` holds.
  let taken = forwarded.concat(answer.args);
  let site = {
    st: answer.st,
    args: taken,
    takes: range(0, taken.len()).map(|k: Int| all.at == Some(k)),
    instance: {
      ..i.layout,
      operand: all.args.len(),
      answer: if answer.args.len() == 0 { None } else { Some(forwarded.len()) },
      heap: match i.block { Some(_) -> Some(all.args.len() + 1), None -> None },
    },
    detached: match ((all.at, plan.forwarding)) {
      (Some(body), Some(_)) -> Some({ body: body, forwards: held.len() }),
      _ -> None,
    },
  };
  let a = fresh(site.st, ty, answer_rep);
  match laid.unknown {
    Some(name) -> unreachable(b"an effect the lowering does not resolve: ".concat(name)),
    None -> if escapes(inner.block, false, false) {
      unreachable(b"a handle body that leaves other than by its end")
    } else {
      let out = emitted(
        a.st,
        Handle({
          body: match inner.word {
            Some(w) -> inner.block.push(Assign({ var: a.var, arg: w })),
            None -> inner.block,
          },
          args: site.args,
          uses: { takes: site.takes, owned: true, fails: true, stops: false },
          site: {
            clauses: laid.clauses,
            ret: tail.at,
            detached: site.detached,
            instance: site.instance,
          },
          answer: a.var,
          unwind: [],
        }),
      );
      handed({ st: out, arg: AVar(a.var) }, held_as(cx.setting, ty), at)
    },
  }
}

/// The landing ending the closure a detached `handle` `h`, planned as `plan`, runs its body in: the
/// body lowered to `body` after `before`, inside the closure `cx` lowers, which holds the instance
/// whose records the opener set; and what it answers, a word, held as `answer`, the type the
/// `handle` answers.
pub fn detached_landed(
  cx: Context,
  before: Lowering,
  body: Lowered,
  h: { body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> },
  plan: Planned,
  answer: Type,
  at: Span,
) -> Lowered / {abort.raise} =
  match cx.instance {
    Some(held) -> {
      let i = plan.instance;
      let inner = if !falls_through(body.st.insts) {
        { outer: continued(before, body.st), block: body.st.insts, word: None }
      } else {
        let w = handed(body, RWord, at);
        { outer: continued(before, w.st), block: w.st.insts, word: Some(w.arg) }
      };
      let a = fresh(inner.outer, answer, RWord);
      if escapes(inner.block, false, false) {
        unreachable(b"a handle body that leaves other than by its end")
      } else {
        let out = emitted(
          a.st,
          Handle({
            body: match inner.word {
              Some(w) -> inner.block.push(Assign({ var: a.var, arg: w })),
              None -> inner.block,
            },
            args: [held.word],
            uses: { takes: [false], owned: true, fails: true, stops: false },
            site: {
              clauses: preset_clauses(cx, h.clauses),
              ret: None,
              detached: None,
              instance: { ..i.layout, operand: 0, answer: None, heap: Some(0), preset: true },
            },
            answer: a.var,
            unwind: [],
          }),
        );
        handed({ st: out, arg: AVar(a.var) }, held_as(cx.setting, answer), at)
      }
    },
    None -> unreachable(b"a detached body holding no instance"),
  }

/// The clauses of `clauses` as a landing over an instance whose records are set reads them: each
/// one's effect, operation and mode; it enters each through its record.
fn preset_clauses(cx: Context, clauses: List<CodeClause>) -> List<Clause> / {abort.raise} =
  clauses.map(|cl: CodeClause|
    {
      effect: match effect_named(cx, cl.effect) { Some(en) -> en.global, None -> cl.effect },
      op: cl.op,
      mode: clause_mode(cx, cl),
      string: None,
      handler: 0,
    })

/// A `parallel` block of the closures `branches`, which perform `performs`: the runtime runs them,
/// at once where it may, handing each the words of that row, and the block answers the tuple of
/// their answers. Each branch's answer is handed with the descriptor of its type, which lets it go
/// where another branch failed.
pub fn branched(
  cx: Context,
  st: Lowering,
  branches: List<Arg>,
  performs: Row,
  at: Span,
) -> Lowered / {abort.raise} = {
  let closures = branches.fold(
    { st: st, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, b: Arg| {
      let w = handed({ st: acc.st, arg: b }, RWord, at);
      { st: w.st, args: acc.args.push(w.arg) }
    },
  );
  let described = branches.fold(
    { st: closures.st, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, b: Arg| {
      let d = type_described(cx, acc.st, answer_of(type_of(b)), at);
      { st: d.st, args: acc.args.push(d.arg) }
    },
  );
  // A branch raises `abort.raise` through the bridge, which leaves it pending for the block to
  // carry back and raise where it stands, so a block that can merely fail still runs at once.
  let unaborted = { ..cx, words: cx.words.filter(|w: Worded| w.evidence.effect != b"abort") };
  let handing = value_handing(unaborted, described.st, performs, at);
  let entering = done(
    handing.st,
    Op({ op: OHandle(Entering), args: handing.args, uses: reads(2) }),
    at,
  );
  let words = { st: entering, args: closures.args.concat(described.args) };
  let ty = TyRecord(
    fields_sorted(
      range(0, branches.len()).map(|i: Int|
        {
          name: b"_".concat(ascii_of_int(i)),
          ty: match branches.at(i) { Some(b) -> answer_of(type_of(b)), None -> unknown_type() },
        }),
    ),
  );
  let op = Op({
    op: OHandle(Parallel),
    args: words.args,
    uses: {
      takes: closures.args.map(|_: Arg| true).concat(described.args.map(|_: Arg| false)),
      owned: true,
      fails: true,
      stops: true,
    },
  });
  // The answers' words are gathered into a box, each read out at its place and held as its type
  // holds it, and the tuple made of them as its type lays it out.
  let answers = branches.map(|b: Arg| answer_of(type_of(b)));
  let gathered = bound_as(words.st, gathered_of(answers), RWord, op, at);
  match gathered.arg {
    AVar(record) -> {
      let parts = range(0, branches.len()).fold(
        { st: gathered.st, fields: [] },
        |acc: { st: Lowering, fields: List<{ name: Bytes, arg: Arg }> }, i: Int| {
          let name = b"_".concat(ascii_of_int(i));
          let t = answers.get(i);
          let w = bound_as(
            acc.st,
            t,
            RWord,
            Get({ of: record, path: PField({ name: name, at: i }) }),
            at,
          );
          let h = handed(w, held_as(cx.setting, t), at);
          { st: h.st, fields: acc.fields.push({ name: name, arg: h.arg }) }
        },
      );
      recorded_as(cx, parts.st, parts.fields, ty, at)
    },
    _ -> unreachable(b"a parallel block's answers bound to no variable"),
  }
}

/// A `handle`'s clauses laid out so far: the state, the handle's operands and whether it takes each,
/// the clauses, and the first effect no clause's name resolves to.
type Laid = {
  st: Lowering,
  args: List<Arg>,
  takes: List<Bool>,
  clauses: List<Clause>,
  unknown: Option<Bytes>,
}

/// Clause `cl`, its closure `closure`, laid out after `acc`: the closure, then the descriptor of
/// `String` where it binds the call site's label or answers `abort.raise`, each of which its entry
/// hands it as a `String`.
fn clause_laid(
  cx: Context,
  acc: Laid,
  cl: CodeClause,
  closure: Arg,
  at: Span,
) -> Laid / {abort.raise} =
  match effect_named(cx, cl.effect) {
    None -> { ..acc, unknown: match acc.unknown { Some(u) -> Some(u), None -> Some(cl.effect) } },
    Some(en) -> {
      let stringed = cl.binds_label || (en.global == b"abort" && cl.op == b"raise");
      let bound = if stringed {
        let d = type_described(cx, acc.st, string_type(), at);
        { st: d.st, args: [d.arg] }
      } else { { st: acc.st, args: [] } };
      {
        st: bound.st,
        args: acc.args.push(closure).concat(bound.args),
        takes: acc.takes.push(true).concat(bound.args.map(|_: Arg| false)),
        clauses: acc.clauses.push({
          effect: en.global,
          op: cl.op,
          mode: clause_mode(cx, cl),
          string: if stringed { Some(acc.args.len() + 1) } else { None },
          handler: acc.args.len(),
        }),
        unknown: acc.unknown,
      }
    },
  }

/// As the runtime numbers a clause: `3` answers a raise, `0` never resumes, `1` resumes in tail
/// position only, and `2` resumes off its tail.
fn clause_mode(cx: Context, cl: CodeClause) -> Int / {abort.raise} =
  if named_program_wide(cl.effect) != None
      || (match effect_named(cx, cl.effect) {
        Some(e) -> is_raise(op_mode(e, cl.op)),
        None -> false,
      }) { 3 }
  else if !cl.resume { 0 }
  else if resume_in_tail_only(cl) { 1 }
  else { 2 }

/// Whether a clause resumes off its tail, so its `handle`'s body runs on a stack of its own.
pub fn detaches(clauses: List<CodeClause>) -> Bool =
  clauses.any(|cl: CodeClause| cl.resume && !resume_in_tail_only(cl))

/// Whether clause `cl` reads its continuation only to call it in tail position, once on each path.
/// The continuation takes the slot after the parameters and the label the clause binds.
fn resume_in_tail_only(cl: CodeClause) -> Bool = {
  let k = cl.params + (if cl.binds_label { 1 } else { 0 });
  slots_read(cl.body).fold(0, |n: Int, y: Int| if y == k { n + 1 } else { n })
    == tail_calls_of(cl.body, k)
}

fn tail_calls_of(code: Code, k: Int) -> Int =
  match code.node {
    NApp(a) -> match a.func.node {
      NVar(v) -> if v.slot == Some(k) && a.args.len() == 1 && !all_read(a.args).contains(k) { 1 }
      else { 0 },
      _ -> 0,
    },
    NIf(i) -> tail_calls_of(i.then_branch, k) + tail_calls_of(i.else_branch, k),
    NBlock(b) -> match b.tail { Some(t) -> tail_calls_of(t, k), None -> 0 },
    NMatch(m) -> m.arms.fold(0, |n: Int, a: CodeArm| n + tail_calls_of(a.body, k)),
    _ -> 0,
  }

/// The slots `c` binds in the frame it runs in: its `let`s' and its patterns'. A lambda's, a
/// clause's and a `simulate`'s body bind in frames of their own.
fn bound_in(c: Code) -> List<Int> =
  match c.node {
    NBlock(b) ->
      b.stmts.fold([], |acc: List<Int>, s: CodeStmt|
        acc.concat(match s {
          CLet(l) -> bound_in(l.value).push(l.slot),
          CLetPat(l) -> bound_in(l.value).concat(pat_slots(l.pat)),
          CDo(d) -> bound_in(d.code),
        })).concat(match b.tail { Some(t) -> bound_in(t), None -> [] }),
    NIf(i) -> bound_in(i.cond).concat(bound_in(i.then_branch)).concat(bound_in(i.else_branch)),
    NMatch(m) ->
      m.arms.fold(bound_in(m.scrutinee), |acc: List<Int>, a: CodeArm|
        acc.concat(pat_slots(a.pat)).concat(match a.guard {
          Some(g) -> bound_in(g),
          None -> [],
        }).concat(
          bound_in(a.body),
        )),
    NUnary(u) -> bound_in(u.operand),
    NBinary(x) -> bound_in(x.lhs).concat(bound_in(x.rhs)),
    NApp(a) -> a.args.fold(bound_in(a.func), |acc: List<Int>, x: Code| acc.concat(bound_in(x))),
    NList(l) -> l.items.fold([], |acc: List<Int>, x: Code| acc.concat(bound_in(x))),
    NRecord(r) -> r.fields.fold([], |acc: List<Int>, f: CodeField| acc.concat(bound_in(f.value))),
    NField(f) -> bound_in(f.base),
    NUpdate(u) ->
      u.sets.fold(bound_in(u.base), |acc: List<Int>, f: CodeField| acc.concat(bound_in(f.value))),
    NPerform(p) -> p.args.fold([], |acc: List<Int>, x: Code| acc.concat(bound_in(x))),
    NParallel(pr) -> pr.branches.fold([], |acc: List<Int>, x: Code| acc.concat(bound_in(x))),
    NHandle(hd) -> bound_in(hd.body),
    _ -> [],
  }

/// Whether control can leave `b` other than by its end or a failure: a `Return`, a restart or an
/// entry into the group anywhere in it, or a `Miss`, `Next` or `Done` of a `Match` or `Loop` around
/// it, which would leave a handle's frame installed.
fn escapes(b: Block, matched: Bool, looped: Bool) -> Bool =
  b.fold(false, |found: Bool, i: Inst|
    found
      || (match i {
        Return(_) -> true,
        Restart(_) -> true,
        Enter(_) -> true,
        Miss -> !matched,
        Next(_) -> !looped,
        Done(_) -> !looped,
        If(x) -> escapes(x.then, matched, looped) || escapes(x.otherwise, matched, looped),
        Case(c) ->
          c.arms.fold(
            escapes(c.rest, matched, looped),
            |any: Bool, a: { when: Int, body: Block }| any || escapes(a.body, matched, looped),
          ),
        Match(m) ->
          m.arms.fold(escapes(m.rest, matched, looped), |any: Bool, a: Block|
            any || escapes(a, true, looped)),
        Loop(l) -> escapes(l.body, matched, true),
        Handle(hd) -> escapes(hd.body, false, false),
        _ -> false,
      }))

/// What a function of type `t` answers.
fn answer_of(t: Type) -> Type = match t { TyFn(f) -> f.ret, _ -> unknown_type() }

/// The type of the one parameter of a function of type `t`, a `return` clause's.
fn param_of(t: Type) -> Type =
  match t {
    TyFn(f) -> match f.params.at(0) { Some(p) -> p, None -> unknown_type() },
    _ -> unknown_type(),
  }

/// The effect a body names `written`: one a `try` names program-wide, one the module's scope binds,
/// or one of the prelude's, which are known program-wide by their bare names.
fn effect_named(cx: Context, written: Bytes) -> Option<EffectName> / {abort.raise} =
  if is_exit_effect(written) { Some(exit_effect_named(written)) } else {
    match named_program_wide(written) {
      Some(global) ->
        Some(match effect_of(cx, global) {
          Some(e) -> e,
          None -> { written: written, global: global, ops: [] },
        }),
      None -> match cx.setting.effects.fold(None, |acc: Option<EffectName>, e: EffectName|
          if e.written == written { Some(e) } else { acc }) {
        Some(e) -> Some(e),
        None ->
          prelude_effects().fold(None, |acc: Option<EffectName>, e: EffectInfo|
            if e.name == written {
              Some({ written: e.name, global: e.name, ops: e.ops.map(op_mode_of) })
            } else { acc }),
      },
    }
  }

/// Operation `op` as effect `e` declares it: a read of no types it says where it does not declare it.
fn op_declared(e: EffectName, op: Bytes) -> OpMode =
  e.ops.fold(
    { name: op, mode: MRead, params: [], ret: unknown_type(), own: [] },
    |acc: OpMode, o: OpMode| if o.name == op { o } else { acc },
  )

/// An operation's declared mode: a read where its effect does not declare it.
fn op_mode(e: EffectName, op: Bytes) -> Mode = op_declared(e, op).mode

/// A mode as the runtime numbers it.
fn mode_code(m: Mode) -> Int = match m { MRead -> 0, MWrite -> 1, MRaise -> 2, MBad -> 0 }
