//! `perform`, labels, `handle`, `parallel` and `simulate`. A perform calls the entry of its
//! operation in the evidence object the body holds for its effect; a `handle` is a block its body
//! runs in, inline over an instance its evidence objects' clause slots point into or under the
//! runtime's frame its clauses lay out, or detached on a stack of its own where a clause resumes off
//! its tail. Effects are named program-wide.

import compiler.emit.code (Code, CodeClause, CodeReturn, CodeStmt, CLet, CLetPat, CDo, CodeArm,
                           CodeField, NApp, NVar, NIf, NBlock, NMatch, NUnary, NBinary, NField,
                           NUpdate, NRecord, NList, NPerform, NParallel, NHandle, slots_read,
                           all_read, pat_slots)
import compiler.emit.keys (Evidence)
import compiler.emit.evidence (evidence_type)
import compiler.syntax.parsing (Span)
import compiler.check.types (Type, TyFn, TyRecord, Scheme, Atom, Row, Resource, RNamed, RSingleton,
                             RAny, RVar, is_diverges, int_type, string_type, fields_sorted)
import compiler.emit.typing (unknown_type)
import compiler.check.resolve.tables (qualify)
import compiler.expand.rewrite (named_program_wide)
import compiler.check.infer.checker (prelude_effects, EffectInfo, OpInfo)
import compiler.syntax.type_syntax (Mode, MRead, MWrite, MRaise, MBad, is_raise)
import std.bytes (ascii_of_int)
import compiler.emit.reps (Def, EffectName, OpMode, gathered_of)
import compiler.emit.keys (Named, unspecialised)
import compiler.emit.tir (RInt, RWord, RImm, Arg, AVar, AZero, Inst, Block, Op, OHandle, Get,
                          PField, Assign, If, Case, Match, Miss, Loop, Next, Done, Return, Restart,
                          Enter, Handle, Handling, Uses, falls_through)
import compiler.emit.tir.handling (Perform, Label, Parallel, Simulate, Unsettled, Clause, Reached,
                                   Bridge, Instance, ObjectLaid, Entering, Answering, Forwarding,
                                   Entry, Answers, Resumes, Raises, HandleInstance, raised_at)
import compiler.emit.lower.crossing (op_described, type_described, effect_of)
import compiler.emit.lower.base (Context, Lowering, Lowered, Frame, ClauseMade, Worded, Held,
                                 refuse, fresh, bound_as, done, emitted, continued, filed, unfiled,
                                 type_of, handed)
import compiler.emit.lower.evidence (words_at, routed, bridged, label_resource, value_handing)
import compiler.emit.lower.held (held_as)
import compiler.emit.lower.data (recorded_as)
import compiler.emit.lower.resumes (off_tail_code)

/// Operation `op` of `effect` performed on `resource` with `args`, at `label` where one is read,
/// written `written`: the label opened as the field-table entry it is, each argument handed over as
/// a word to the entry of the object the body holds for the effect there, and what the entry
/// answers, a word, held as the type the checker filed for the perform.
pub fn performed(
  cx: Context,
  st: Lowering,
  p: { effect: Bytes, op: Bytes, resource: Bytes },
  label: Option<Arg>,
  written: Option<Code>,
  args: List<Arg>,
  at: Span,
) -> Lowered / {abort.raise} =
  match effect_named(cx, p.effect) {
    None -> refuse(st, Handling, b"an effect the lowering does not resolve: ".concat(p.effect)),
    Some(named) -> {
      let en = match effect_of(cx, named.global) { Some(e) -> e, None -> named };
      let index = range(0, en.ops.len()).find(|k: Int|
        match en.ops.at(k) { Some(o) -> o.name == p.op, None -> false });
      let resource = match written {
        Some(c) -> label_resource(cx, c),
        None -> if p.resource == b"" { RSingleton } else { RNamed(p.resource) },
      };
      let word = bridged(
        st,
        routed(cx, [{ evidence: { effect: en.global, resource: resource }, through: false }]),
        at,
      );
      // The label is opened first, so an argument boxed after it fails holding no count of it.
      let keyed = match label {
        Some(l) -> {
          let k = handed({ st: word.st, arg: l }, RInt, at);
          { st: k.st, args: [k.arg] }
        },
        None -> { st: word.st, args: [] },
      };
      let words = args.fold(
        { st: keyed.st, args: [] },
        |acc: { st: Lowering, args: List<Arg> }, a: Arg| {
          let w = handed({ st: acc.st, arg: a }, RWord, at);
          { st: w.st, args: acc.args.push(w.arg) }
        },
      );
      let declared = op_declared(en, p.op);
      let mode = declared.mode;
      match filed(cx, at) {
        None -> unfiled(cx, words.st, b"a perform", at),
        Some(t) -> {
          let d = op_described(cx, words.st, en.global, declared, args.map(type_of), t.ty);
          let uses = {
            takes: keyed.args.map(|_: Arg| false).concat(words.args.map(|_: Arg| true)),
            owned: true,
            fails: true,
            stops: !is_raise(mode),
          };
          let op = match ((d.name, index)) {
            (Some(described), Some(k)) ->
              Op({
                op: OHandle(
                  Perform({
                    effect: en.global,
                    op: p.op,
                    index: k,
                    resource: if label == None { p.resource } else { b"" },
                    labelled: label != None,
                    mode: mode_code(mode),
                    described: described,
                  }),
                ),
                args: word.args.concat(keyed.args).concat(words.args),
                uses: { ..uses, takes: [false].concat(uses.takes) },
              }),
            _ ->
              Op({ op: OHandle(Unsettled(p.op)), args: keyed.args.concat(words.args), uses: uses }),
          };
          handed(bound_as(d.st, t.ty, RWord, op, at), held_as(cx.setting, t.ty), at)
        },
      }
    },
  }

/// The field-table entry of resource `name`, as a call's label argument.
pub fn label(cx: Context, st: Lowering, name: Bytes, at: Span) -> Lowered =
  bound_as(
    st,
    int_type(),
    RInt,
    Op({
      op: OHandle(Label(name)),
      args: [],
      uses: { takes: [], owned: false, fails: false, stops: false },
    }),
    at,
  )

/// How clause `clause`'s body is laid out as a function of its own: its parameters, then the call
/// site's label where it binds one, then its continuation where it resumes; holding `held`, the
/// words its row takes as they stand where the `handle` is, since what calls it hands none.
pub fn clause_frame(clause: CodeClause, held: Held) -> Frame =
  {
    params: clause.params + (if clause.binds_label { 1 } else { 0 })
      + (if clause.resume { 1 } else { 0 }),
    size: clause.size,
    captures: clause.captures,
    resumes: clause.resume,
    body: clause.body,
    ty: None,
    words: [],
    held: held,
  }

/// How a `handle`'s return clause is laid out as a function of its own: the value the body answered,
/// then what it copies in; holding `held`, as a clause does.
pub fn ret_frame(r: CodeReturn, held: Held) -> Frame =
  {
    params: 1,
    size: r.size,
    captures: r.captures,
    resumes: false,
    body: r.body,
    ty: None,
    words: [],
    held: held,
  }

/// How a `handle` answers what its clauses do: through evidence objects laid over an instance in
/// the frame of the function it is written in, the instance's word and layout here; or through the
/// runtime's frames, the frame bridge's word what its body performs those through.
pub type Planned = {
  st: Lowering,
  instance: Option<{ word: Arg, layout: HandleInstance }>,
  bridge: Option<Arg>,
}

/// The `handle` `h` written at `at` planned after `st`. It answers through evidence objects unless a
/// clause resumes off its tail, which runs the body detached, binds the label it answers at or
/// answers on every label, or the function it is in may spawn a task, which may outlive the frame;
/// those the runtime's frames hold.
pub fn handle_planned(
  cx: Context,
  st: Lowering,
  h: { body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> },
  at: Span,
) -> Planned / {abort.raise} =
  if !in_place(cx, h.clauses) {
    let b = bound_as(
      st,
      evidence_type(),
      RImm,
      Op({ op: OHandle(Bridge), args: [], uses: reading(0) }),
      at,
    );
    { st: b.st, instance: None, bridge: Some(b.arg) }
  } else {
    let raised = h.clauses.fold(0, |m: Int, cl: CodeClause|
      if clause_mode(cx, cl) == 3 && cl.params > m { cl.params } else { m });
    let records = raised_at() + raised;
    let vars = records + 3 * h.clauses.len();
    let count = handler_vars(h.body);
    let layout = {
      operand: 0,
      records: range(0, h.clauses.len()).map(|k: Int| records + 3 * k),
      vars: vars,
      count: count,
      pending: range(0, h.clauses.len()).find(|k: Int|
        match h.clauses.at(k) { Some(cl) -> answers_abort(cx, cl), None -> false }),
      answer: None,
    };
    let i = bound_as(
      st,
      evidence_type(),
      RImm,
      Op({ op: OHandle(Instance(vars + 2 * count)), args: [], uses: reading(0) }),
      at,
    );
    { st: i.st, instance: Some({ word: i.arg, layout: layout }), bridge: None }
  }

/// Whether a `handle` of `clauses` written in `cx` answers through evidence objects, as
/// `handle_planned` says.
fn in_place(cx: Context, clauses: List<CodeClause>) -> Bool / {abort.raise} =
  !detaches(clauses) && !cx.words.any(|w: Worded| w.evidence.effect == b"task")
    && clauses.all(|cl: CodeClause|
      !cl.binds_label && cl.resource != b"*"
        && (match effect_named(cx, cl.effect) {
          Some(en) -> match effect_of(cx, en.global) {
            Some(e) -> e.ops.any(|o: OpMode| o.name == cl.op),
            None -> false,
          },
          None -> false,
        }))

/// Whether clause `cl` answers `abort.raise`, which a raise the runtime left pending reaches.
fn answers_abort(cx: Context, cl: CodeClause) -> Bool / {abort.raise} =
  cl.op == b"raise"
    && (match effect_named(cx, cl.effect) { Some(en) -> en.global == b"abort", None -> false })

/// How many variables the `handle` whose body is `body` holds: what its body's first statements
/// install.
fn handler_vars(body: Code) -> Int =
  match body.node {
    NBlock(b) ->
      b.stmts.fold(0, |n: Int, s: CodeStmt|
        match s {
          CDo(d) -> match d.code.node {
            NApp(a) -> match a.func.node {
              NVar(v) -> if v.name == b"?handler_init" { n + 1 } else { n },
              _ -> n,
            },
            _ -> n,
          },
          _ -> n,
        }),
    _ -> 0,
  }

/// What a clause or the return clause of a `handle` planned as `plan`, written at `at`, holds: the
/// words its row takes as they stand around the `handle`, each the frame bridge where none answers,
/// and the instance where there is one.
pub fn clause_held(
  cx: Context,
  st: Lowering,
  plan: Planned,
  at: Span,
) -> { st: Lowering, held: Held } / {abort.raise} = {
  let own = words_at(cx, at);
  let words = bridged(st, routed(cx, own), at);
  {
    st: words.st,
    held: {
      words: range(0, own.len()).fold([], |acc: List<Worded>, k: Int|
        match ((own.at(k), words.args.at(k))) {
          (Some(o), Some(w)) ->
            acc.push({ evidence: o.evidence, word: w, through: o.through, handled: false }),
          _ -> acc,
        }),
      instance: match plan.instance {
        Some(i) -> Some({ word: i.word, vars: i.layout.vars }),
        None -> None,
      },
    },
  }
}

/// The keys a `handle` of `clauses` answers: each effect and resource a clause answers there,
/// once, with the effect's operations.
fn handle_keys(
  cx: Context,
  clauses: List<CodeClause>,
) -> List<{ evidence: Evidence, effect: EffectName }> / {abort.raise} =
  clauses.fold([], |acc: List<{ evidence: Evidence, effect: EffectName }>, cl: CodeClause|
    match effect_named(cx, cl.effect) {
      None -> acc,
      Some(named) -> {
        let en = match effect_of(cx, named.global) { Some(e) -> e, None -> named };
        let answered = { effect: en.global, resource: clause_resource(cx, cl) };
        if acc.any(|k: { evidence: Evidence, effect: EffectName }| k.evidence == answered) { acc }
        else { acc.push({ evidence: answered, effect: en }) }
      },
    })

/// `cx` inside the body of a `handle` planned as `plan`, run in place, and the state after `st`
/// holding what it needs: before any word it held, a word for each effect and resource a clause
/// answers there. Over an instance, each word is an evidence object whose slots enter the clauses
/// answering its operations and copy the rest from the word around the `handle`; held by the
/// runtime's frames, each is the frame bridge.
pub fn handle_entered(
  cx: Context,
  st: Lowering,
  h: { body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> },
  plan: Planned,
  at: Span,
) -> { cx: Context, st: Lowering } / {abort.raise} = {
  let keys = handle_keys(cx, h.clauses);
  match plan.instance {
    None -> {
      let bridge = match plan.bridge { Some(b) -> b, None -> AZero(RImm) };
      {
        cx: {
          ..cx,
          words: keys.map(|k: { evidence: Evidence, effect: EffectName }|
            { evidence: k.evidence, word: bridge, through: false, handled: true }).concat(
            cx.words,
          ),
          instance: None,
        },
        st: st,
      }
    },
    Some(i) -> {
      let made = keys.fold(
        { st: st, words: [] },
        |acc: { st: Lowering, words: List<Worded> }, k: { evidence: Evidence, effect: EffectName }| {
          let outer = bridged(acc.st, routed(cx, [{ evidence: k.evidence, through: false }]), at);
          let slots = range(0, k.effect.ops.len()).map(|j: Int| {
            let op = k.effect.ops.get(j);
            match range(0, h.clauses.len()).find(|c: Int|
                match h.clauses.at(c) {
                  Some(cl) ->
                    cl.op == op.name
                      && (match effect_named(cx, cl.effect) {
                        Some(en) -> en.global == k.evidence.effect,
                        None -> false,
                      })
                      && clause_resource(cx, cl) == k.evidence.resource,
                  None -> false,
                }) {
              Some(c) ->
                Answering({
                  entry: entry_of(clause_mode(cx, h.clauses.get(c))),
                  record: i.layout.records.get(c),
                }),
              None -> Forwarding({ operand: 1, op: j }),
            }
          });
          let o = bound_as(
            outer.st,
            evidence_type(),
            RImm,
            Op({
              op: OHandle(ObjectLaid(slots)),
              args: [i.word].concat(outer.args),
              uses: reading(2),
            }),
            at,
          );
          {
            st: o.st,
            words: acc.words.push({
              evidence: k.evidence,
              word: o.arg,
              through: false,
              handled: true,
            }),
          }
        },
      );
      {
        cx: {
          ..cx,
          words: made.words.concat(cx.words),
          instance: Some({ word: i.word, vars: i.layout.vars }),
        },
        st: made.st,
      }
    },
  }
}

/// How a clause of the runtime's mode `mode` is entered from its slot.
fn entry_of(mode: Int) -> Entry =
  if mode == 3 { Raises } else if mode == 1 { Resumes } else { Answers }

/// Whether clause `c` may stop its `handle` with what it answers, which its instance then holds.
fn may_stop(c: Clause) -> Bool = match entry_of(c.mode) { Resumes -> true, _ -> false }

/// What an operation over `n` words does with them: reads them, answering what holds no count.
fn reading(n: Int) -> Uses =
  { takes: range(0, n).map(|_: Int| false), owned: false, fails: false, stops: false }

/// The resource clause `cl` answers on, in the root's numbering: a label parameter's, every label,
/// one named, or none.
fn clause_resource(cx: Context, cl: CodeClause) -> Resource =
  if cl.label != None {
    match range(0, cx.label_names.len()).find(|i: Int| cx.label_names.at(i) == Some(cl.resource)) {
      Some(p) -> RVar(p),
      None -> RNamed(cl.resource),
    }
  } else if cl.resource == b"" { RSingleton }
  else if cl.resource == b"*" { RAny }
  else { RNamed(cl.resource) }

/// How a `handle`'s body is laid out as a function of its own where it runs detached, on a stack of
/// its own: no parameters, each slot it reads that is bound around it copied in at its own number;
/// holding, since the runtime hands it none, the words the function around it holds, before them
/// the frame bridge for what the `handle` answers. Nothing where it runs in place.
pub fn body_frame(
  cx: Context,
  h: { body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> },
  plan: Planned,
) -> Option<Frame> / {abort.raise} =
  if !detaches(h.clauses) { None } else {
    let inside = bound_in(h.body);
    let reads = slots_read(h.body).fold([], |acc: List<Int>, r: Int|
      if acc.contains(r) || inside.contains(r) { acc } else { acc.push(r) });
    let bridge = match plan.bridge { Some(b) -> b, None -> AZero(RImm) };
    Some({
      params: 0,
      size: reads.concat(inside).fold(0, |m: Int, r: Int| if r + 1 > m { r + 1 } else { m }),
      captures: reads.map(|r: Int| { src: r, dst: r }),
      resumes: false,
      body: h.body,
      ty: None,
      words: [],
      held: {
        words: handle_keys(cx, h.clauses).map(
          |k: { evidence: Evidence, effect: EffectName }|
            { evidence: k.evidence, word: bridge, through: false, handled: true },
        ).concat(
          cx.words,
        ),
        instance: None,
      },
    })
  }

/// The `handle` `h`, planned as `plan`, its body lowered to `body` (in a block of its own, or as a
/// closure where `body_frame` says it runs detached), its clauses and return clause made: the
/// clauses laid out over their closures and the labels they key on, for the runtime's frame or the
/// instance, its body run under them, and what it answers, a word, held as the type it answers.
pub fn handled(
  cx: Context,
  st: Lowering,
  body: Lowered,
  clauses: List<ClauseMade>,
  ret: Option<Arg>,
  h: { body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> },
  plan: Planned,
  at: Span,
) -> Lowered / {abort.raise} = {
  let detached = detaches(h.clauses);
  let inner = if detached { { outer: body.st, block: [], word: None } }
  else if !falls_through(body.st.insts) {
    { outer: continued(st, body.st), block: body.st.insts, word: None }
  } else {
    let w = handed(body, RWord, at);
    { outer: continued(st, w.st), block: w.st.insts, word: Some(w.arg) }
  };
  let laid = range(0, h.clauses.len()).fold(
    { st: inner.outer, args: [], takes: [], clauses: [], unknown: None },
    |acc: Laid, i: Int|
      match h.clauses.at(i) {
        None -> acc,
        Some(cl) -> match clauses.at(i) {
          None -> acc,
          Some(made) -> clause_laid(cx, acc, cl, made, at),
        },
      },
  );
  let tail = match ret {
    Some(r) -> { args: laid.args.push(r), takes: laid.takes.push(true), at: Some(laid.args.len()) },
    None -> { args: laid.args, takes: laid.takes, at: None },
  };
  let all = if detached {
    { args: tail.args.push(body.arg), takes: tail.takes.push(true), at: Some(tail.args.len()) }
  } else { { args: tail.args, takes: tail.takes, at: None } };
  let ty = match ret {
    Some(r) -> answer_of(type_of(r)),
    None -> if detached { answer_of(type_of(body.arg)) } else { type_of(body.arg) },
  };
  // Over an instance the `handle` only reads its closures, whose counts are the body's to let go,
  // and, where a clause may stop it, the descriptor of what it answers.
  let site = match plan.instance {
    None -> { st: laid.st, args: all.args, takes: all.takes, instance: None },
    Some(i) -> {
      let held = all.args.push(i.word);
      let answer = if laid.clauses.any(may_stop) {
        let d = type_described(cx, laid.st, ty, at);
        { st: d.st, args: [d.arg] }
      } else { { st: laid.st, args: [] } };
      {
        st: answer.st,
        args: held.concat(answer.args),
        takes: held.concat(answer.args).map(|_: Arg| false),
        instance: Some({
          ..i.layout,
          operand: all.args.len(),
          answer: if answer.args.len() == 0 { None } else { Some(held.len()) },
        }),
      }
    },
  };
  let a = fresh(site.st, ty, RWord);
  match laid.unknown {
    Some(name) -> refuse(a.st, Handling, b"an effect the lowering does not resolve: ".concat(name)),
    None -> if escapes(inner.block, false, false) {
      refuse(a.st, Handling, b"a handle body that leaves other than by its end")
    } else {
      let out = emitted(
        a.st,
        Handle({
          body: match inner.word {
            Some(w) -> inner.block.push(Assign({ var: a.var, arg: w })),
            None -> inner.block,
          },
          args: site.args,
          uses: { takes: site.takes, owned: true, fails: true, stops: false },
          site: { clauses: laid.clauses, ret: tail.at, detached: all.at, instance: site.instance },
          answer: a.var,
          unwind: [],
        }),
      );
      handed({ st: out, arg: AVar(a.var) }, held_as(cx.setting, ty), at)
    },
  }
}

/// A `parallel` block of the closures `branches`, which perform `performs`: the runtime runs them,
/// at once where it may, handing each the words of that row, and the block answers the tuple of
/// their answers. Each branch's answer is handed with the descriptor of its type, which lets it go
/// where another branch failed. Where the block is in its definition's own body, the runtime is told
/// what the definition's row lets the branches reach.
pub fn branched(
  cx: Context,
  st: Lowering,
  branches: List<Arg>,
  performs: Row,
  rooted: Bool,
  at: Span,
) -> Lowered / {abort.raise} = {
  let closures = branches.fold(
    { st: st, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, b: Arg| {
      let w = handed({ st: acc.st, arg: b }, RWord, at);
      { st: w.st, args: acc.args.push(w.arg) }
    },
  );
  let described = branches.fold(
    { st: closures.st, args: [] },
    |acc: { st: Lowering, args: List<Arg> }, b: Arg| {
      let d = type_described(cx, acc.st, answer_of(type_of(b)), at);
      { st: d.st, args: acc.args.push(d.arg) }
    },
  );
  let handing = value_handing(cx, described.st, performs, at);
  let entering = done(
    handing.st,
    Op({ op: OHandle(Entering), args: handing.args, uses: reading(2) }),
    at,
  );
  let words = { st: entering, args: closures.args.concat(described.args) };
  let ty = TyRecord(
    fields_sorted(
      range(0, branches.len()).map(|i: Int|
        {
          name: b"_".concat(ascii_of_int(i)),
          ty: match branches.at(i) { Some(b) -> answer_of(type_of(b)), None -> unknown_type() },
        }),
    ),
  );
  let op = Op({
    op: OHandle(Parallel({ reach: if rooted { owner_reach(cx) } else { None } })),
    args: words.args,
    uses: {
      takes: closures.args.map(|_: Arg| true).concat(described.args.map(|_: Arg| false)),
      owned: true,
      fails: true,
      stops: true,
    },
  });
  // The answers' words are gathered into a box, each read out at its place and held as its type
  // holds it, and the tuple made of them as its type lays it out.
  let answers = branches.map(|b: Arg| answer_of(type_of(b)));
  let gathered = bound_as(words.st, gathered_of(answers), RWord, op, at);
  match gathered.arg {
    AVar(record) -> {
      let parts = range(0, branches.len()).fold(
        { st: gathered.st, fields: [] },
        |acc: { st: Lowering, fields: List<{ name: Bytes, arg: Arg }> }, i: Int| {
          let name = b"_".concat(ascii_of_int(i));
          let t = answers.get(i);
          let w = bound_as(
            acc.st,
            t,
            RWord,
            Get({ of: record, path: PField({ name: name, at: i }) }),
            at,
          );
          let h = handed(w, held_as(cx.setting, t), at);
          { st: h.st, fields: acc.fields.push({ name: name, arg: h.arg }) }
        },
      );
      recorded_as(cx, parts.st, parts.fields, ty, at)
    },
    _ -> refuse(gathered.st, Handling, b"a parallel block's answers bound to no variable"),
  }
}

/// A `simulate` of the nullary closure `body`, which performs `performs` and answers what the body
/// answers: the runtime takes the body and the descriptor of its answer's type, which it keeps the
/// answer by, and hands the body the words of that row, the frame bridge's for what the region
/// answers.
pub fn simulated(
  cx: Context,
  st: Lowering,
  body: Arg,
  performs: Row,
  at: Span,
) -> Lowered / {abort.raise} = {
  let w = handed({ st: st, arg: body }, RWord, at);
  let ty = answer_of(type_of(body));
  let described = type_described(cx, w.st, ty, at);
  let handing = value_handing(cx, described.st, performs, at);
  let entered = done(
    handing.st,
    Op({ op: OHandle(Entering), args: handing.args, uses: reading(2) }),
    at,
  );
  let op = Op({
    op: OHandle(Simulate),
    args: [w.arg, described.arg],
    uses: { takes: [true, false], owned: true, fails: true, stops: true },
  });
  handed(bound_as(entered, ty, RWord, op, at), held_as(cx.setting, ty), at)
}

/// A `handle`'s clauses laid out so far: the state, the handle's operands and whether it takes each,
/// the clauses, and the first effect no clause's name resolves to.
type Laid = {
  st: Lowering,
  args: List<Arg>,
  takes: List<Bool>,
  clauses: List<Clause>,
  unknown: Option<Bytes>,
}

/// Clause `cl`, made as `made`, laid out after `acc`: its closure, then the label it keys on, then
/// the descriptor of `String` where it binds the call site's label or answers `abort.raise`, each of
/// which the runtime hands it as a `String`.
fn clause_laid(
  cx: Context,
  acc: Laid,
  cl: CodeClause,
  made: ClauseMade,
  at: Span,
) -> Laid / {abort.raise} =
  match effect_named(cx, cl.effect) {
    None -> { ..acc, unknown: match acc.unknown { Some(u) -> Some(u), None -> Some(cl.effect) } },
    Some(en) -> {
      let keyed = match made.label {
        Some(l) -> {
          let k = handed({ st: acc.st, arg: l }, RInt, at);
          { st: k.st, args: [k.arg] }
        },
        None -> { st: acc.st, args: [] },
      };
      // The runtime hands a clause a `String` as the label it binds or the message a raise carries.
      let stringed = cl.binds_label || (en.global == b"abort" && cl.op == b"raise");
      let bound = if stringed {
        let d = type_described(cx, keyed.st, string_type(), at);
        { st: d.st, args: [d.arg] }
      } else { { st: keyed.st, args: [] } };
      let at_label = acc.args.len() + 1 + keyed.args.len();
      {
        st: bound.st,
        args: acc.args.push(made.closure).concat(keyed.args).concat(bound.args),
        takes: acc.takes.push(true).concat(keyed.args.concat(bound.args).map(|_: Arg| false)),
        clauses: acc.clauses.push({
          effect: en.global,
          op: cl.op,
          resource: if made.label == None { cl.resource } else { b"" },
          mode: clause_mode(cx, cl),
          string: if stringed { Some(at_label) } else { None },
          handler: acc.args.len(),
          label: if made.label == None { None } else { Some(acc.args.len() + 1) },
        }),
        unknown: acc.unknown,
      }
    },
  }

/// As the runtime numbers a clause: `3` answers a raise, `0` never resumes, `1` resumes in tail
/// position only, and off its tail `2` resumes at most once and `4` may resume again.
fn clause_mode(cx: Context, cl: CodeClause) -> Int / {abort.raise} =
  if named_program_wide(cl.effect) != None
      || (match effect_named(cx, cl.effect) {
        Some(e) -> is_raise(op_mode(e, cl.op)),
        None -> false,
      }) { 3 }
  else if !cl.resume { 0 }
  else if resume_in_tail_only(cl) { 1 }
  else { off_tail_code(cl) }

/// Whether a clause resumes off its tail, so its `handle`'s body runs on a stack of its own.
fn detaches(clauses: List<CodeClause>) -> Bool =
  clauses.any(|cl: CodeClause| cl.resume && !resume_in_tail_only(cl))

/// Whether clause `cl` reads its continuation only to call it in tail position, once on each path.
/// The continuation takes the slot after the parameters and the label the clause binds.
fn resume_in_tail_only(cl: CodeClause) -> Bool = {
  let k = cl.params + (if cl.binds_label { 1 } else { 0 });
  slots_read(cl.body).fold(0, |n: Int, y: Int| if y == k { n + 1 } else { n })
    == tail_calls_of(cl.body, k)
}

fn tail_calls_of(code: Code, k: Int) -> Int =
  match code.node {
    NApp(a) -> match a.func.node {
      NVar(v) -> if v.slot == Some(k) && a.args.len() == 1 && !all_read(a.args).contains(k) { 1 }
      else { 0 },
      _ -> 0,
    },
    NIf(i) -> tail_calls_of(i.then_branch, k) + tail_calls_of(i.else_branch, k),
    NBlock(b) -> match b.tail { Some(t) -> tail_calls_of(t, k), None -> 0 },
    NMatch(m) -> m.arms.fold(0, |n: Int, a: CodeArm| n + tail_calls_of(a.body, k)),
    _ -> 0,
  }

/// The slots `c` binds in the frame it runs in: its `let`s' and its patterns'. A lambda's, a
/// clause's and a `simulate`'s body bind in frames of their own.
fn bound_in(c: Code) -> List<Int> =
  match c.node {
    NBlock(b) ->
      b.stmts.fold([], |acc: List<Int>, s: CodeStmt|
        acc.concat(match s {
          CLet(l) -> bound_in(l.value).push(l.slot),
          CLetPat(l) -> bound_in(l.value).concat(pat_slots(l.pat)),
          CDo(d) -> bound_in(d.code),
        })).concat(match b.tail { Some(t) -> bound_in(t), None -> [] }),
    NIf(i) -> bound_in(i.cond).concat(bound_in(i.then_branch)).concat(bound_in(i.else_branch)),
    NMatch(m) ->
      m.arms.fold(bound_in(m.scrutinee), |acc: List<Int>, a: CodeArm|
        acc.concat(pat_slots(a.pat)).concat(match a.guard {
          Some(g) -> bound_in(g),
          None -> [],
        }).concat(
          bound_in(a.body),
        )),
    NUnary(u) -> bound_in(u.operand),
    NBinary(x) -> bound_in(x.lhs).concat(bound_in(x.rhs)),
    NApp(a) -> a.args.fold(bound_in(a.func), |acc: List<Int>, x: Code| acc.concat(bound_in(x))),
    NList(l) -> l.items.fold([], |acc: List<Int>, x: Code| acc.concat(bound_in(x))),
    NRecord(r) -> r.fields.fold([], |acc: List<Int>, f: CodeField| acc.concat(bound_in(f.value))),
    NField(f) -> bound_in(f.base),
    NUpdate(u) ->
      u.sets.fold(bound_in(u.base), |acc: List<Int>, f: CodeField| acc.concat(bound_in(f.value))),
    NPerform(p) -> p.args.fold([], |acc: List<Int>, x: Code| acc.concat(bound_in(x))),
    NParallel(pr) -> pr.branches.fold([], |acc: List<Int>, x: Code| acc.concat(bound_in(x))),
    NHandle(hd) -> bound_in(hd.body),
    _ -> [],
  }

/// Whether control can leave `b` other than by its end or a failure: a `Return`, a restart or an
/// entry into the group anywhere in it, or a `Miss`, `Next` or `Done` of a `Match` or `Loop` around
/// it, which would leave a handle's frame installed.
fn escapes(b: Block, matched: Bool, looped: Bool) -> Bool =
  b.fold(false, |found: Bool, i: Inst|
    found
      || (match i {
        Return(_) -> true,
        Restart(_) -> true,
        Enter(_) -> true,
        Miss -> !matched,
        Next(_) -> !looped,
        Done(_) -> !looped,
        If(x) -> escapes(x.then, matched, looped) || escapes(x.otherwise, matched, looped),
        Case(c) ->
          c.arms.fold(
            escapes(c.rest, matched, looped),
            |any: Bool, a: { when: Int, body: Block }| any || escapes(a.body, matched, looped),
          ),
        Match(m) ->
          m.arms.fold(escapes(m.rest, matched, looped), |any: Bool, a: Block|
            any || escapes(a, true, looped)),
        Loop(l) -> escapes(l.body, matched, true),
        Handle(hd) -> escapes(hd.body, false, false),
        _ -> false,
      }))

/// What a function of type `t` answers.
fn answer_of(t: Type) -> Type = match t { TyFn(f) -> f.ret, _ -> unknown_type() }

/// The effect a body names `written`: one a `try` names program-wide, one the module's scope binds,
/// or one of the prelude's, which are known program-wide by their bare names.
fn effect_named(cx: Context, written: Bytes) -> Option<EffectName> / {abort.raise} =
  match named_program_wide(written) {
    Some(global) -> Some({ written: written, global: global, ops: [] }),
    None -> match cx.setting.effects.fold(None, |acc: Option<EffectName>, e: EffectName|
        if e.written == written { Some(e) } else { acc }) {
      Some(e) -> Some(e),
      None ->
        prelude_effects().fold(None, |acc: Option<EffectName>, e: EffectInfo|
          if e.name == written {
            Some({
              written: e.name,
              global: e.name,
              ops: e.ops.map(|o: OpInfo|
                {
                  name: o.name,
                  mode: o.mode,
                  params: o.params,
                  ret: o.ret,
                  own: match o.scheme { Some(s) -> s.ty_vars, None -> [] },
                }),
            })
          } else { acc }),
    },
  }

/// Operation `op` as effect `e` declares it: a read of no types it says where it does not declare it.
fn op_declared(e: EffectName, op: Bytes) -> OpMode =
  e.ops.fold(
    { name: op, mode: MRead, params: [], ret: unknown_type(), own: [] },
    |acc: OpMode, o: OpMode| if o.name == op { o } else { acc },
  )

/// An operation's declared mode: a read where its effect does not declare it.
fn op_mode(e: EffectName, op: Bytes) -> Mode = op_declared(e, op).mode

/// A mode as the runtime numbers it.
fn mode_code(m: Mode) -> Int = match m { MRead -> 0, MWrite -> 1, MRaise -> 2, MBad -> 0 }

/// Every operation the root's row says it may perform and does not answer, by program-wide names:
/// what a `parallel` block in its own body may reach of the handlers its callers installed. Nothing
/// where the row is left open or no definition's scheme speaks for the root.
fn owner_reach(cx: Context) -> Option<List<Reached>> =
  match cx.setting.here.fold(None, |found: Option<Scheme>, d: Def|
      if unspecialised(cx.key) == Named(qualify(cx.setting.module, d.name)) { d.scheme }
      else { found }) {
    None -> None,
    Some(s) -> match s.ty {
      TyFn(f) -> match f.effects.tail {
        Some(_) -> None,
        None ->
          Some(
            f.effects.atoms.filter(|a: Atom| !is_diverges(a)).map(|a: Atom|
              { effect: a.effect, resource: match a.resource { RNamed(n) -> Some(n), _ -> None } }),
          ),
      },
      _ -> None,
    },
  }
