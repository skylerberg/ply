//! Lists, maps, arrays, `Columns`, strings and bytes: their literals, builtins and intrinsics. Every
//! builtin call comes here first: what the emitter writes for a scalar's type goes on to `scalars`,
//! what reads or writes a container's cells is written in place, and the rest is called through the
//! runtime's helper named for it.

import syntax.parsing (Span)
import emit.code (Code, NApp, NVar)
import check.types (Type, TyVar, TyCon, TyFn, TyRecord, TyNominal, Field, named_type, int_type,
                    bool_type, bytes_type, unit_type, option_type)
import emit.typing (unknown_type)
import check.resolve.tables (qualify)
import emit.layout (Intrinsic, OfList, OfMap, ListStart, TailLen, ListRoot, TailAt, NodeLen, LeafAt,
                    KidAt, TailPush, TailSet, LeafSet, RootSwap, KidSwap, TailStart, Spill,
                    NewBranch, MapRoot, NodeCount, MapHeight, NodeKey, NodeValue, NodeKid, KidMax,
                    KidSize, NewLeaf, NewMapBranch, PairPut, PairSet, PairTake, LeafCut, BranchCut,
                    KidOut, KidBack, KidPut, KidDrop, MapSwap, intrinsic_named)
import emit.reps (Def, FieldTy, TyRec, kind_of, has_vars, laid_vars, spelled_field, laid_of)
import emit.c (KInt, KFloat, KDec, KNum, KSum, Zeroed)
import emit.answer (Layout)
import emit.roots (builtin_helper, generated_builtin)
import emit.tir (Rep, RInt, RBool, RNum, RFloat, RDec, RWord, RMaybe, RFlat, Leaf, Var, Arg, AVar,
                 AInt, Make, MList, Native, Op, OContainer, Let, Containers)
import emit.tir.containers (ContainerOp, Laid, Length, Elements, ByteAt, U32At, Joined, ArrayNew,
                            ArraySet, ArrayOfList, ArrayGet, ColumnField, Position, Element, Held,
                            Words, Bits, Payloads, Records, IntBits, WidthBits, FloatBits,
                            DecimalBits)
import emit.lower.setting (imported_target, qualified, from_import, module_import, builtin_at,
                           ctor_named)
import emit.lower.held (held_as, laid_fields, field_type, leaves_of)
import emit.lower.base (Context, Lowering, Lowered, refuse, bound_as, handed, noted, filed, unfiled,
                        type_of, through_runtime, as_words)
import emit.lower.scalars (operated, runtime_builtin)

/// Builtin `name` called on `args`; `callee` is where its name is written, which the checker files
/// the types it called the builtin at under. A native the elaboration writes calls of, its name
/// `?`-led, has no filing of its own.
pub fn builtin(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Span,
  at: Span,
) -> Lowered / {abort.raise} =
  if filed(cx, callee) == None && !name.starts_with(b"?") {
    unfiled(cx, st, b"a builtin's call", callee)
  } else { builtin_filed(cx, st, name, args, callee, at) }

fn builtin_filed(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Span,
  at: Span,
) -> Lowered / {abort.raise} =
  match intrinsic_at(cx, name) {
    Some(op) -> match called_at(cx, name, callee).ret {
      None -> refuse(st, Containers, b"an extern written in place the checker filed no type for"),
      Some(ret) -> laid(cx, st, op, args, ret, at),
    },
    None -> match resolved(cx, name) {
      None ->
        refuse(
          st,
          Containers,
          b"an imported name that is neither a definition nor a builtin: ".concat(name),
        ),
      Some(b) -> if written_part(name) && filed(cx, callee) == None {
        // Written code files a part's type where a root of its own writes it; the rest only the
        // runtime can answer, the root that asks among them.
        runtime_builtin(cx, st, b, args, at)
      } else if scalar_builtin(b) { operated(cx, st, b, args, at) }
      else { contained(cx, st, b, args, called_at(cx, b, callee), at) },
    },
  }

/// Whether `name` is a builtin written code calls on a part of the value its root takes, encoding or
/// reflecting it at the type filed for the part.
fn written_part(name: Bytes) -> Bool =
  name == b"?encoded" || name == b"?reflect" || name == b"?shown"

/// Whether field `name` of `base` is read from its column, with no record made: `base` a call of the
/// builtin `Columns::get` of two, whose records the checker settled to a type that lays them out and
/// holds `name`. The driver then lowers the call's arguments and hands them `column_read`.
pub fn columned(cx: Context, base: Code, name: Bytes) -> Bool / {abort.raise} =
  match base.node {
    NApp(a) -> match a.func.node {
      NVar(f) -> if f.slot != None || a.args.len() != 2 || f.name != b"Columns::get"
          || cx.setting.here.any(|d: Def| d.name == f.name)
          || from_import(cx.setting.imports, f.name) != None { false }
      else { match column_at(cx, a.func.span, name) { Some(_) -> true, None -> false } },
      _ -> false,
    },
    _ -> false,
  }

/// Field `name` of record `args[1]` of the `Columns` `args[0]`, as the call `base` reads it: loaded
/// from its column where the `Columns` is laid out in columns and holds that record, and read by the
/// runtime otherwise, which raises as `Columns::get` does.
pub fn column_read(
  cx: Context,
  st: Lowering,
  args: List<Arg>,
  base: Code,
  name: Bytes,
  at: Span,
) -> Lowered / {abort.raise} =
  match column_at(cx, match base.node { NApp(a) -> a.func.span, _ -> base.span }, name) {
    None -> refuse(st, Containers, b"a field of a Columns' record no column holds: ".concat(name)),
    Some(c) -> match args {
      [xs, i] -> {
        let object = handed({ st: st, arg: xs }, RWord, at);
        let index = handed({ st: object.st, arg: i }, RInt, at);
        let rep = match c.column.held {
          Payloads -> RMaybe,
          Records(_) -> RWord,
          _ -> item_rep(cx, c.ty),
        };
        let answered = bound_as(
          index.st,
          c.ty,
          rep,
          Op({
            op: OContainer(ColumnField({ k: c.k, column: c.column })),
            args: [object.arg, index.arg],
            uses: { takes: [false, false], owned: true, fails: true, stops: false },
          }),
          at,
        );
        handed(answered, held_as(cx.setting, c.ty), at)
      },
      _ -> refuse(st, Containers, b"a Columns' record read on other operands than two"),
    },
  }

/// Where field `name` of the records a call of `Columns::get` written at `callee` reads lies: its
/// place among the record's fields, its type, and how its column holds it.
fn column_at(
  cx: Context,
  callee: Span,
  name: Bytes,
) -> Option<{ k: Int, ty: Type, column: Element }> =
  match called_at(cx, b"Columns::get", callee).args.at(0) {
    None -> None,
    Some(record) -> match laid_fields(record) {
      None -> None,
      Some(fs) -> match range(0, fs.len()).fold(None, |acc: Option<Int>, k: Int|
          match fs.at(k) { Some(f) -> if f.name == name { Some(k) } else { acc }, None -> acc }) {
        None -> None,
        Some(k) -> match field_type(record, name) {
          None -> None,
          Some(ty) -> match laid_as(element_field(name, ty)) {
            Some(e) -> Some({ k: k, ty: ty, column: e }),
            None -> None,
          },
        },
      },
    },
  }

/// A list literal of `items`, each a word the list takes, of the type the checker filed for it.
pub fn listed(cx: Context, st: Lowering, items: List<Arg>, at: Span) -> Lowered / {abort.raise} =
  match filed(cx, at) {
    None -> unfiled(cx, st, b"a list", at),
    Some(t) -> {
      let words = as_words(st, items, at);
      bound_as(
        words.st,
        t.ty,
        held_as(cx.setting, t.ty),
        Make({ made: MList(items.len()), args: words.args, reuse: None, kept: [] }),
        at,
      )
    },
  }

/// What a call of a builtin answers, as the checker filed it where the name is written or as the
/// builtin's declared scheme gives it at the type arguments filed there, and those type arguments.
type Settled = { ret: Option<Type>, args: List<Type> }

fn called_at(cx: Context, name: Bytes, callee: Span) -> Settled =
  {
    ret: match builtin_at(cx.setting, filed(cx, callee), name) {
      Some(c) -> Some(c.ret),
      None -> None,
    },
    args: match filed(cx, callee) { Some(t) -> t.args, None -> [] },
  }

/// A builtin that is no scalar's: written in place where it reads or writes a container's cells, and
/// otherwise called through the runtime, which must implement it.
fn contained(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  f: Settled,
  at: Span,
) -> Lowered / {abort.raise} =
  if (name == b"List::len" || name == b"Bytes::len") && args.len() == 1 {
    read_in_place(st, Length, args, int_type(), RInt, at)
  } else if name == b"Array::len" && args.len() == 1 {
    read_in_place(st, Elements, args, int_type(), RInt, at)
  } else if name == b"Bytes::at" && args.len() == 2 {
    read_in_place(st, ByteAt, args, int_type(), RInt, at)
  } else if name == b"Bytes::u32_le" && args.len() == 2 {
    read_in_place(st, U32At, args, named_type(b"U32"), RNum({ bits: 32, signed: false }), at)
  } else if name == b"Bytes::concat_all" && args.len() == 1 { joined(cx, st, args, f, at) }
  else if is_callback(name) {
    refuse(st, Containers, b"a callback builtin outside its fused shape: ".concat(name))
  } else if name == b"Bytes::position" && cx.setting.release { positioned(cx, st, args, at) } else {
    match laid_element(name, args, f) {
      Some(t) -> if has_vars(t) { called(cx, layout_needed(st, t), name, args, f, at) }
      else if name == b"Columns::get" { called(cx, st, name, args, f, at) }
      else { arrayed(cx, st, name, args, t, at) },
      None -> called(cx, st, name, args, f, at),
    }
  }

/// A builtin called through the runtime, which must implement it, answering the type `f` gives.
fn called(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  f: Settled,
  at: Span,
) -> Lowered / {abort.raise} =
  if !cx.setting.builtins.contains(name) {
    refuse(st, Containers, b"a name the runtime implements no builtin of: ".concat(name))
  } else {
    match match f.ret { Some(r) -> Some(r), None -> elaborated_answer(cx, name, args, at) } {
      None -> if name == b"?handler_var" { unfiled(cx, st, b"a handler variable's read", at) }
      else {
        refuse(
          st,
          Containers,
          b"a builtin called at a type neither filed nor declared: ".concat(name),
        )
      },
      Some(ret) -> if is_lookup(name) && args.len() == 2 { looked_up(cx, st, name, args, ret, at) }
      else { through_runtime(cx, st, name, args, ret, at) },
    }
  }

/// What a native the elaboration writes calls of answers, which no declaration states: an operator
/// at a type a witness stands for its operands' type, but `<`, `<=`, `>` and `>=`, which the
/// elaboration numbers 5 to 8, a `Bool`; a handler's variable the type the checker filed for its
/// read, where the read is written; installing or setting one `Unit`; a hold's region what its body
/// answers; and a hold, and the value taken out of one, a word of no type the checker filed. Where
/// nothing says more, the runtime's word.
fn elaborated_answer(cx: Context, name: Bytes, args: List<Arg>, at: Span) -> Option<Type> = {
  let word = |t: Option<Type>| match t { Some(x) -> Some(x), None -> Some(unknown_type()) };
  if name == b"?numeric_binary" {
    match args {
      [AInt(k), _, x, _] -> Some(if k >= 5 && k <= 8 { bool_type() } else { type_of(x) }),
      _ -> None,
    }
  } else if name == b"?numeric_unary" { match args { [_, _, x] -> Some(type_of(x)), _ -> None } }
  else if name == b"?handler_var" { match filed(cx, at) { Some(t) -> Some(t.ty), None -> None } }
  else if name == b"?handler_init" || name == b"?handler_set" { Some(unit_type()) }
  else if name == b"?hold_new" || name == b"?hold_take" { Some(unknown_type()) }
  else if name == b"?hold_bracket" {
    word(match args.at(2) {
      Some(AVar(body)) -> match body.ty { TyFn(f) -> Some(f.ret), _ -> None },
      _ -> None,
    })
  } else { None }
}

/// `st` noting each type variable that leaves the layout of an element of type `t` unknown, which a
/// specialisation would lay its elements out by.
fn layout_needed(st: Lowering, t: Type) -> Lowering =
  if !open(t) { st }
  else { laid_vars(t).fold(st, |acc: Lowering, v: Int| noted(acc, { var: v, reads: Layout })) }

/// Whether a value of type `t` is laid out by a type variable: one, or a record holding one.
fn open(t: Type) -> Bool =
  match t {
    TyVar(_) -> true,
    TyRecord(fs) -> fs.any(|x: Field| open(x.ty)),
    TyNominal(x) -> x.fields.any(|y: Field| open(y.ty)),
    _ -> false,
  }

/// An operation that reads `args`, written in place, its answer held as `rep`: the object first,
/// as a word, and then each index as an `Int`.
fn read_in_place(
  st: Lowering,
  op: ContainerOp,
  args: List<Arg>,
  ty: Type,
  rep: Rep,
  at: Span,
) -> Lowered / {abort.raise} = {
  let object = match args.at(0) {
    Some(a) -> handed({ st: st, arg: a }, RWord, at),
    None -> refuse(st, Containers, b"a read of nothing"),
  };
  let index = match args.at(1) {
    Some(i) -> {
      let h = handed({ st: object.st, arg: i }, RInt, at);
      { st: h.st, args: [object.arg, h.arg] }
    },
    None -> { st: object.st, args: [object.arg] },
  };
  bound_as(
    index.st,
    ty,
    rep,
    Op({
      op: OContainer(op),
      args: index.args,
      uses: {
        takes: index.args.map(|_: Arg| false),
        owned: false,
        fails: op == ByteAt || op == U32At,
        stops: false,
      },
    }),
    at,
  )
}

/// `Bytes::concat_all` of a list this call alone was handed, made just before it: the list's items
/// joined without the list made. Any other list is joined through the runtime.
fn joined(
  cx: Context,
  st: Lowering,
  args: List<Arg>,
  f: Settled,
  at: Span,
) -> Lowered / {abort.raise} =
  match match args.at(0) { Some(AVar(v)) -> made_here(st, v), _ -> None } {
    Some(parts) ->
      bound_as(
        { ..st, insts: st.insts.take(st.insts.len() - 1) },
        bytes_type(),
        RWord,
        Op({
          op: OContainer(Joined),
          args: parts,
          uses: { takes: parts.map(|_: Arg| true), owned: true, fails: true, stops: false },
        }),
        at,
      ),
    None -> called(cx, st, b"Bytes::concat_all", args, f, at),
  }

/// The items of the list `v` holds, where the last instruction made it and no slot holds it.
fn made_here(st: Lowering, v: Var) -> Option<List<Arg>> =
  if st.env.values().contains(AVar(v)) { None } else {
    match st.insts.at(st.insts.len() - 1) {
      Some(Let(l)) -> if l.var != v { None } else {
        match l.val { Make(m) -> match m.made { MList(_) -> Some(m.args), _ -> None }, _ -> None }
      },
      _ -> None,
    }
  }

/// A builtin whose helper answers an element or `None` as an `Option` held as its payload's word,
/// with no object made.
fn looked_up(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ty: Type,
  at: Span,
) -> Lowered / {abort.raise} = {
  let words = as_words(st, args, at);
  let answer = bound_as(
    words.st,
    ty,
    RMaybe,
    Native({
      name: if name == b"Array::at" { b"rt_array_lookup_p" }
      else { builtin_helper(name).concat(b"_p") },
      args: words.args,
      uses: { takes: args.map(|_: Arg| true), owned: true, fails: true, stops: false },
    }),
    at,
  );
  handed(answer, held_as(cx.setting, ty), at)
}

/// What an extern written in place does with an operand: reads the object it reads, takes a word it
/// writes or stores, takes an `Option` as its payload's word, or reads an index or a count.
type Operand = | Read | Taken | TakenMaybe | Index

/// What an extern written in place answers: a value held as a representation of its own, an item,
/// held as the item's type says where that is a scalar and as its word otherwise, or the record of
/// what it wrote and what it took out, held as its fields.
type Answer = | Plain(Rep) | Item | Fields

/// How an extern written in place takes its operands and answers, and whether its answer holds a
/// count of its own, which a node made or an object written does, and a read does not.
type Laying = { operands: List<Operand>, answer: Answer, owned: Bool }

/// Extern `op` called on `args`, answering a value of `ty`, written over the runtime's objects.
fn laid(cx: Context, st: Lowering, op: Intrinsic, args: List<Arg>, ty: Type, at: Span) -> Lowered = {
  let l = laying(op);
  let answer = match l.answer {
    Plain(r) -> Some(r),
    Item -> Some(item_rep(cx, ty)),
    Fields -> match fields_held(ty) { Some(ls) -> Some(RFlat(ls)), None -> None },
  };
  match answer {
    None -> refuse(st, Containers, b"a write in place answering a record of a width past a word"),
    Some(rep) -> if l.operands.len() != args.len() {
      refuse(st, Containers, b"an extern written in place on other operands than it takes")
    } else {
      let handed_over = range(0, args.len()).fold(
        { st: st, args: [] },
        |acc: { st: Lowering, args: List<Arg> }, i: Int|
          match args.at(i) {
            None -> acc,
            Some(a) -> {
              let h = handed(
                { st: acc.st, arg: a },
                match l.operands.at(i) {
                  Some(Index) -> RInt,
                  Some(TakenMaybe) -> RMaybe,
                  _ -> RWord,
                },
                at,
              );
              { st: h.st, args: acc.args.push(h.arg) }
            },
          },
      );
      let answered = bound_as(
        handed_over.st,
        ty,
        rep,
        Op({
          op: OContainer(Laid(op)),
          args: handed_over.args,
          uses: {
            takes: l.operands.map(|o: Operand| o == Taken || o == TakenMaybe),
            owned: l.owned,
            fails: false,
            stops: false,
          },
        }),
        at,
      );
      handed(answered, held_as(cx.setting, ty), at)
    },
  }
}

/// The leaves a record of type `ty` an extern answers is held as: as its type holds it, a record it
/// holds in place at any depth as that record's leaves and then its word; nothing where a leaf is a
/// width past a word, which a word cannot be read as.
fn fields_held(ty: Type) -> Option<List<Leaf>> = {
  let ls = match laid_fields(ty) {
    Some(fs) -> leaves_of(fs),
    // A record a type variable leaves open holds each field of that variable's type as a word.
    None -> match ty {
      TyRecord(fs) -> leaves_of(fs.map(|f: Field| element_field(f.name, f.ty))),
      _ -> [],
    },
  };
  if ls.len() == 0 || ls.any(|x: Leaf| match x.rep { RNum(w) -> w.bits > 64, _ -> false }) { None }
  else { Some(ls) }
}

/// An item read out of an object as the scalar its type holds, or else as the word it is there.
fn item_rep(cx: Context, ty: Type) -> Rep =
  match held_as(cx.setting, ty) {
    RInt -> RInt,
    RBool -> RBool,
    RFloat -> RFloat,
    RDec -> RDec,
    RNum(w) -> if w.bits <= 64 { RNum(w) } else { RWord },
    _ -> RWord,
  }

/// How each extern written in place takes its operands and answers.
fn laying(op: Intrinsic) -> Laying = {
  let read = |operands: List<Operand>, rep: Rep|
    { operands: operands, answer: Plain(rep), owned: false };
  let item = { operands: [Read, Index], answer: Item, owned: false };
  let made = { operands: [], answer: Plain(RWord), owned: true };
  let written = |operands: List<Operand>| { operands: operands, answer: Plain(RWord), owned: true };
  let record = |operands: List<Operand>| { operands: operands, answer: Fields, owned: true };
  match op {
    OfList(ListStart) -> read([Read], RInt),
    OfList(TailLen) -> read([Read], RInt),
    OfList(NodeLen) -> read([Read], RInt),
    OfList(ListRoot) -> read([Read], RMaybe),
    OfList(TailAt) -> item,
    OfList(LeafAt) -> item,
    OfList(KidAt) -> read([Read, Index], RWord),
    OfList(TailPush) -> written([Taken, Taken]),
    OfList(TailStart) -> written([Taken, Taken]),
    OfList(TailSet) -> written([Taken, Index, Taken]),
    OfList(LeafSet) -> written([Taken, Index, Taken]),
    OfList(NewBranch) -> made,
    OfList(RootSwap) -> record([Taken, TakenMaybe]),
    OfList(KidSwap) -> record([Taken, Index, TakenMaybe]),
    OfList(Spill) -> record([Taken]),
    OfMap(MapRoot) -> read([Read], RMaybe),
    OfMap(NodeCount) -> read([Read], RInt),
    OfMap(MapHeight) -> read([Read], RInt),
    OfMap(NodeKey) -> item,
    OfMap(NodeValue) -> item,
    OfMap(KidMax) -> item,
    OfMap(NodeKid) -> read([Read, Index], RWord),
    OfMap(KidSize) -> read([Read, Index], RInt),
    OfMap(NewLeaf) -> made,
    OfMap(NewMapBranch) -> made,
    OfMap(PairPut) -> written([Taken, Index, Taken, Taken]),
    OfMap(PairSet) -> written([Taken, Index, Taken, Taken]),
    OfMap(KidBack) -> written([Taken, Index, Taken, Taken, Index]),
    OfMap(KidPut) -> written([Taken, Index, Taken, Taken, Index]),
    OfMap(KidDrop) -> written([Taken, Index]),
    OfMap(PairTake) -> record([Taken, Index]),
    OfMap(LeafCut) -> record([Taken, Index]),
    OfMap(BranchCut) -> record([Taken, Index]),
    OfMap(KidOut) -> record([Taken, Index]),
    OfMap(MapSwap) -> record([Taken, TakenMaybe, Index, Index]),
  }
}

fn is_lookup(name: Bytes) -> Bool = name == b"Array::at" || name == b"ListNode::leaf_of"

/// The type of the elements a call of `name` lays out or reads where they lie: an array's for
/// `Array::new`, `set`, `of_list` and `get`, and a `Columns`' for `Columns::get`.
fn laid_element(name: Bytes, args: List<Arg>, f: Settled) -> Option<Type> =
  if (name == b"Array::new" && args.len() == 2) || (name == b"Array::set" && args.len() == 3)
      || (name == b"Array::of_list" && args.len() == 1)
      || ((name == b"Array::get" || name == b"Columns::get") && args.len() == 2) { f.args.at(0) }
  else { None }

/// Array builtin `name` called on `args`, written over an array laid out for elements of type `ty`:
/// `Array::get` answers an element, and the others the array.
fn arrayed(cx: Context, st: Lowering, name: Bytes, args: List<Arg>, ty: Type, at: Span) -> Lowered =
  match element_of(ty) {
    None -> refuse(st, Containers, b"an array of a width past a word"),
    Some(e) -> {
      let item = element_rep(e);
      // What each operand is held as and whether the operation takes it.
      let shape = if name == b"Array::new" {
        { op: ArrayNew(e), reps: [RInt, item], takes: [false, true] }
      } else if name == b"Array::set" {
        { op: ArraySet(e), reps: [RWord, RInt, item], takes: [true, false, true] }
      } else if name == b"Array::of_list" { { op: ArrayOfList(e), reps: [RWord], takes: [true] } }
      else { { op: ArrayGet(e), reps: [RWord, RInt], takes: [false, false] } };
      let got = name == b"Array::get";
      let answer = if got { ty } else { TyCon({ name: b"Array", args: [ty] }) };
      let operands = range(0, args.len()).fold(
        { st: st, args: [] },
        |acc: { st: Lowering, args: List<Arg> }, i: Int|
          match args.at(i) {
            None -> acc,
            Some(a) -> {
              let h = handed(
                { st: acc.st, arg: a },
                match shape.reps.at(i) { Some(r) -> r, None -> RWord },
                at,
              );
              { st: h.st, args: acc.args.push(h.arg) }
            },
          },
      );
      let answered = bound_as(
        operands.st,
        answer,
        if got { item } else { RWord },
        Op({
          op: OContainer(shape.op),
          args: operands.args,
          uses: { takes: shape.takes, owned: !got, fails: true, stops: false },
        }),
        at,
      );
      handed(answered, held_as(cx.setting, answer), at)
    },
  }

/// How an array holds elements of type `ty`, as a record holds a field of that type: a record in
/// place behind a header of its own, a scalar as its bits, an `Option` as its payload's word in
/// place, and anything else as its word; nothing for a width past a word.
fn element_of(ty: Type) -> Option<Element> = laid_as(element_field(b"e", ty))

/// How a holder of elements laid out as field `e` holds each.
fn laid_as(e: FieldTy) -> Option<Element> = {
  let laid = laid_of([e]);
  let in_place = |h: Held|
    Some({ held: h, stride: laid.width, shapes: shapes_of([e]), counted: laid.counted });
  match e.ty {
    TyRec(inner) -> in_place(Records({ tail: laid_of(inner).tail })),
    _ -> match e.kind {
      KInt -> in_place(Bits(IntBits)),
      KFloat -> in_place(Bits(FloatBits)),
      KDec -> in_place(Bits(DecimalBits)),
      KNum(w) -> if w.bits > 64 { None } else { in_place(Bits(WidthBits(w))) },
      KSum(Zeroed) -> in_place(Payloads),
      _ -> Some({ held: Words, stride: 1, shapes: [], counted: [] }),
    },
  }
}

/// The shapes a record of `fs` is laid out by: each record it holds in place's first, then its own.
fn shapes_of(fs: List<FieldTy>) -> List<List<Bytes>> =
  fs.fold([], |acc: List<List<Bytes>>, f: FieldTy|
    match f.ty { TyRec(inner) -> acc.concat(shapes_of(inner)), _ -> acc }).push(
    fs.map(spelled_field),
  )

/// Field `name` of type `ty` as a record lays it out: an `Option` as its payload's word.
fn element_field(name: Bytes, ty: Type) -> FieldTy = {
  let k = kind_of(ty);
  { name: name, kind: if is_option(ty) { KSum(Zeroed) } else { k.kind }, ty: k.ty }
}

/// How a value an element laid out as `e` holds is held once read or before it is written.
fn element_rep(e: Element) -> Rep =
  match e.held {
    Bits(IntBits) -> RInt,
    Bits(WidthBits(w)) -> RNum(w),
    Bits(FloatBits) -> RFloat,
    Bits(DecimalBits) -> RDec,
    Payloads -> RMaybe,
    _ -> RWord,
  }

fn is_option(t: Type) -> Bool =
  match t { TyCon(c) -> c.name == b"Option" && c.args.len() == 1, _ -> false }

/// `Bytes::position(b, from, f)` under release, written as a loop in the body rather than the
/// runtime's call: `f` may stop for a handler its effects reach, and a native's frame cannot resume.
/// It answers the index as an `Option`'s object, made of the program's own constructors.
fn positioned(cx: Context, st: Lowering, args: List<Arg>, at: Span) -> Lowered =
  match ({ some: ctor_named(cx.setting, b"Some"), none: ctor_named(cx.setting, b"None") }) {
    { some: Some(some), none: Some(none) } -> match args {
      [b, from, f] -> {
        let bw = handed({ st: st, arg: b }, RWord, at);
        let fr = handed({ st: bw.st, arg: from }, RInt, at);
        let fw = handed({ st: fr.st, arg: f }, RWord, at);
        let ty = option_type(int_type());
        let answered = bound_as(
          fw.st,
          ty,
          RWord,
          Op({
            op: OContainer(Position({ some: some, none: none })),
            args: [bw.arg, fr.arg, fw.arg],
            uses: { takes: [true, false, true], owned: true, fails: true, stops: true },
          }),
          at,
        );
        handed(answered, held_as(cx.setting, ty), at)
      },
      _ -> refuse(st, Containers, b"a byte string's position on other operands than three"),
    },
    _ ->
      refuse(
        st,
        Containers,
        b"a byte string's position with no `Option` constructors to answer in",
      ),
  }

/// A builtin that calls a function it is handed in a shape only a fused loop writes.
fn is_callback(name: Bytes) -> Bool = name == b"iterate"

/// The builtins `scalars` lowers: those the emitter writes at the type of a scalar it was called at,
/// or per type (order, show, digest, reflection).
pub fn scalar_builtin(name: Bytes) -> Bool =
  [
    b"reflect",
    b"shown",
    b"digest",
    b"?encoded",
    b"?same",
    b"compare",
    b"compare_values",
    b"wrap_add",
    b"wrap_sub",
    b"wrap_mul",
    b"rotr",
    b"rotl",
    b"saturating_add",
    b"saturating_sub",
    b"saturating_mul",
    b"checked_add",
    b"checked_sub",
    b"checked_mul",
    b"checked_neg",
    b"U8::of_int",
    b"U16::of_int",
    b"U32::of_int",
    b"U64::of_int",
    b"I8::of_int",
    b"I16::of_int",
    b"I32::of_int",
    b"I64::of_int",
    b"U128::of_int",
    b"I128::of_int",
    b"Int::of_u8",
    b"Int::of_u16",
    b"Int::of_u32",
    b"Int::of_u64",
    b"Int::of_i8",
    b"Int::of_i16",
    b"Int::of_i32",
    b"Int::of_i64",
    b"Int::of_u128",
    b"Int::of_i128",
    b"Float::of_int",
    b"Float::of_bits",
    b"bits_of_float",
    b"?stated_witness",
  ].contains(
    name,
  )

/// The builtin a call of `name` reaches: a name no import holds a definition of, as its own name
/// where an import names an extern the runtime implements; nothing where an import names what is
/// neither.
fn resolved(cx: Context, name: Bytes) -> Option<Bytes> / {abort.raise} =
  match imported_target(cx.setting.imports, name) {
    None -> Some(generated_builtin(name)),
    Some(t) -> if t.imp.defs.any(|d: Def| d.name == t.name)
        || !cx.setting.builtins.contains(t.name) { None }
    else { Some(t.name) },
  }

/// What the emitter writes in place of a call of `name`: an extern the module, or one it imports,
/// declares under a program-wide name `layout.intrinsics` lists.
fn intrinsic_at(cx: Context, name: Bytes) -> Option<Intrinsic> / {abort.raise} =
  intrinsic_named(match qualified(name) {
    Some(q) -> match module_import(cx.setting.imports, q.binder) {
      Some(imp) -> qualify(imp.module, q.name),
      None -> qualify(cx.setting.module, name),
    },
    None -> match from_import(cx.setting.imports, name) {
      Some(imp) -> qualify(imp.module, name),
      None -> qualify(cx.setting.module, name),
    },
  })
