                             NodeKid, ChildMaxKey, KidSize, NewLeaf, NewMapBranch, PairPut, PairSet,
                             PairTake, LeafSplit, BranchSplit, KidOut, KidRestore, KidPut, KidDrop,
                             MapSwap, Recast, Pointer, PointerSum, CaseLayout, Inline, classes,
                             words, intrinsic_named)
import compiler.emit.representations (Definition, has_variables, layout_variables, numeric_sum,
                                      pointer_layout, type_variables)
import compiler.emit.output (Layout)
import compiler.emit.roots (builtin_helper, generated_builtin)
import compiler.emit.release (released_variables)
import compiler.emit.typed_ir (Representation, AsInt, AsBool, AsWord, AsSum, AsFlattened, Leaf,
                               Variable, Arg, VariableOperand, IntOperand, ZeroOperand, AsUnit,
                               Allocate, ListAllocation, Native, OperationCall, OfContainers,
                               OfHandling, OfCalling, Let, Primitive, If, Static,
                               operand_representation)
import compiler.emit.typed_ir.handling (UnspecialisedBuiltin, Entering)
import compiler.emit.typed_ir.calling (BlackBox)
import compiler.emit.lower.evidence (function_value_evidence, builtin_effects)
import compiler.emit.typed_ir.containers (ContainerOperation, NodeIntrinsic, Length, ArrayLength,
                                          InBounds, ArrayNew, ArraySet, ArrayOfList, ArrayGet,
                                          ColumnsNew, ColumnsSet, ColumnsOfList, ColumnsGet,
                                          ColumnField, ListInBounds, ListPush, ListSet, ColumnOf,
                                          ItemAt, Rest, WithCapacity, Position, Element)
import compiler.emit.lower.module_context (imported_target, qualified, from_import, module_import,
                                           builtin_call_types)
import compiler.emit.lower.representation (representation_of, layout_leaves)
import compiler.emit.lower.base (Context, Lowering, LoweredValue, unreachable, bound_as,
                                 run_for_effect, represented_as, with_need, type_of, enter_block,
                                 exit_block, fresh, emitted, read_typed)
import compiler.emit.lower.base
import compiler.emit.lower.data (constructed_as)
import compiler.emit.lower.scalars (is_option, scalar_builtin_call, numeric_function_call, binary,
                                    numeric_in_place, numeric_converted, is_decimal_conversion)
import compiler.expand.rewrite (float_function, float_exact)
import compiler.emit.statics (empty_map_static)
import compiler.emit.typed_ir.statics (StaticDefinition)
import compiler.emit.lower.marshalling (marshalling_builtin, marshalling_builtin_call,
                                        type_descriptor, machine_word_call, fully_known,
                                        left_to_callers, assertion_failed)
import compiler.emit.lower.conversions (conversion_builtin, conversion_builtin_call)
import compiler.emit.lower.strings
import compiler.emit.lower.strings (string_builtin)

pub fn builtin(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} = typed_builtin(context, st, name, args, callee, at)

fn typed_builtin(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match intrinsic_at(context, name) {
    Some(intrinsic) -> match builtin_types_at(context, name, callee).return_type {
      None ->
        unreachable(
          b"an `extern` declared inside a function has no type recorded by type checking",
        ),
      Some(return_type) -> intrinsic_call(context, st, intrinsic, args, return_type, at),
    },
    None -> match if list_written_in_place(name) { Some(name) } else { resolved(context, name) } {
      None ->
        unreachable(b"an imported name that is neither a definition nor a builtin: ".concat(name)),
      Some(b) -> if b == b"assert_eq" { asserted(context, st, args, at) }
      else if b == b"observe" { observe_call(context, st, args, at) }
      else if b == b"Map::new" && args.len() == 0 { empty_map(context, st, args, callee, at) }
      else if conversion_builtin(b) { conversion_builtin_call(context, st, b, args, callee, at) }
      else if marshalling_builtin(b) { marshalling_builtin_call(context, st, b, args, callee, at) }
      else if string_builtin(b) { strings::string_builtin_call(context, st, b, args, callee, at) }
      else if scalar_builtin(b) { scalar_builtin_call(context, st, b, args, at) } else {
        container_builtin_call(
          context,
          st,
          b,
          args,
          builtin_types_at(context, b, callee),
          callee,
          at,
        )
      },
    },
  }

fn asserted(
  context: Context,
  st: Lowering,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args {
    [a, b] -> {
      let ty = type_of(a);
      if has_variables(ty) {
        left_to_callers(
          context,
          st,
          b"assert_eq",
          args,
          { params: [ty, ty], result_type: unit_type },
          at,
        )
      } else {
        let equal = binary(context, { st: st, arg: a }, { st: st, arg: b }, b"eq", at);
        let failed = assertion_failed(context, enter_block(equal.st), a, b, ty, at);
        {
          st: {
            ..exit_block(equal.st, failed),
            instructions: equal.st.instructions.push(
              If({ cond: equal.arg, then: [], otherwise: failed.instructions }),
            ),
          },
          arg: ZeroOperand(AsUnit),
        }
      }
    },
    _ -> unreachable(b"`assert_eq` of other than two values"),
  }

fn observe_call(
  context: Context,
  st: Lowering,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args {
    [x] -> {
      let ty = type_of(x);
      let represented = represented_as(
        { st: st, arg: x },
        representation_of(context.setting, ty),
        at,
      );
      bound_as(
        represented.st,
        ty,
        operand_representation(represented.arg),
        OperationCall({
          operation: OfCalling(BlackBox),
          args: [represented.arg],
          uses: { takes: [false], owned: false, fails: false, suspends: false },
        }),
        at,
      )
    },
    _ -> unreachable(b"`observe` of other than one value"),
  }

fn empty_map(
  context: Context,
  st: Lowering,
  args: List<Arg>,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match builtin_types_at(context, b"Map::new", callee).return_type {
    Some(ty) -> {
      let d = empty_map_static;
      let statics = if st.statics.any(|x: StaticDefinition| x.name == d.name) { st.statics }
      else { st.statics.push(d) };
      bound_as({ ..st, statics: statics }, ty, AsWord, Static(d.name), at)
    },
    None ->
      container_builtin_call(
        context,
        st,
        b"Map::new",
        args,
        builtin_types_at(context, b"Map::new", callee),
        callee,
        at,
      ),
  }

pub fn reads_column(context: Context, base: Code, name: Bytes) -> Bool =
  match base.node {
    CodeApply(a) -> match a.function.node {
      NBuiltin(f) -> if a.args.len() != 2 || f.name != b"Columns::get" { false }
      else { match column_at(context, a.function, name) { Some(_) -> true, None -> false } },
      _ -> false,
    },
    _ -> false,
  }

pub fn column_read(
  context: Context,
  st: Lowering,
  args: List<Arg>,
  base: Code,
  name: Bytes,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match column_at(context, match base.node { CodeApply(a) -> a.function, _ -> base }, name) {
    None ->
      unreachable(b"a field of a `Columns` record is not stored in any column: ".concat(name)),
    Some(c) -> match args {
      [xs, i] -> {
        let object = represented_as({ st: st, arg: xs }, AsWord, at);
        let index = represented_as({ st: object.st, arg: i }, AsInt, at);
        bound_as(
          index.st,
          c.ty,
          representation_of(context.setting, c.ty),
          OperationCall({
            operation: OfContainers(ColumnField({ k: c.k, column: c.column })),
            args: [object.arg, index.arg],
            uses: { takes: [false, false], owned: false, fails: true, suspends: false },
          }),
          at,
        )
      },
      _ ->
        unreachable(b"a read of a `Columns` record was given a number of arguments other than two"),
    },
  }

fn column_at(
  context: Context,
  callee: Code,
  name: Bytes,
) -> Option<{ k: Int, ty: Type, column: Element }> =
  match builtin_types_at(context, b"Columns::get", callee).args.at(0) {
    None -> None,
    Some(record) -> match record_fields(record) {
      None -> None,
      Some(fs) -> match range(0, fs.len()).find(|k: Int|
          match fs.at(k) { Some(f) -> f.name == name, None -> false }) {
        None -> None,
        Some(k) -> match fs.at(k) {
          Some(f) -> match element_of(context, f.ty) {
            Some(e) -> Some({ k: k, ty: f.ty, column: e }),
            None -> None,
          },
          None -> None,
        },
      },
    },
  }

pub fn list_literal(
  context: Context,
  st: Lowering,
  items: List<Arg>,
  ty: Type,
  at: Span,
) -> LoweredValue = {
  let t = { ty: ty };
  {
    let item = match t.ty { NamedType(c) -> c.args.at(0), _ -> None };
    let represented_items = items.fold(
      { st: match item { Some(i) -> note_element_layout(st, i), None -> st }, args: [] },
      |accumulator: { st: Lowering, args: List<Arg> }, a: Arg| {
        let h = represented_as(
          { st: accumulator.st, arg: a },
          match item { Some(i) -> representation_of(context.setting, i), None -> AsWord },
          at,
        );
        { st: h.st, args: accumulator.args.push(h.arg) }
      },
    );
    bound_as(
      represented_items.st,
      t.ty,
      representation_of(context.setting, t.ty),
      Allocate({ made: ListAllocation(items.len()), args: represented_items.args, reuse: None }),
      at,
    )
  }
}

pub fn item_read(context: Context, st: Lowering, xs: Arg, i: Arg, item: Type) -> LoweredValue = {
  let v = fresh(st, item, representation_of(context.setting, item));
  { st: item_read_into(v.st, xs, i, v.var, dummy_span), arg: VariableOperand(v.var) }
}

pub fn item_read_into(st: Lowering, xs: Arg, i: Arg, into: Variable, at: Span) -> Lowering =
  emitted(
    note_element_layout(st, into.ty),
    Let({
      var: into,
      value: OperationCall({
        operation: OfContainers(ItemAt),
        args: [xs, i],
        uses: { takes: [false, false], owned: false, fails: false, suspends: false },
      }),
      at: at,
      unwind: [],
    }),
  )

pub fn length_read(st: Lowering, xs: Arg, at: Span) -> LoweredValue / {abort.raise} =
  read_in_place(st, Length, [xs], int_type, AsInt, at)

pub fn empty_list_with_capacity(
  context: Context,
  st: Lowering,
  list: Type,
  n: Arg,
  at: Span,
) -> LoweredValue = {
  let laid_st = match list {
    NamedType(c) -> match c.args.at(0) { Some(item) -> note_element_layout(st, item), None -> st },
    _ -> st,
  };
  let count = represented_as({ st: laid_st, arg: n }, AsInt, at);
  bound_as(
    count.st,
    list,
    AsWord,
    OperationCall({
      operation: OfContainers(WithCapacity),
      args: [count.arg],
      uses: { takes: [false], owned: true, fails: false, suspends: false },
    }),
    at,
  )
}

pub fn rest_read(st: Lowering, ty: Type, xs: Arg, k: Arg) -> LoweredValue =
  bound_as(
    note_block_layout(st, ty),
    ty,
    AsWord,
    OperationCall({
      operation: OfContainers(Rest),
      args: [xs, k],
      uses: { takes: [false, false], owned: true, fails: false, suspends: false },
    }),
    dummy_span,
  )

fn note_block_layout(st: Lowering, ty: Type) -> Lowering =
  released_variables(ty).fold(st, |accumulator: Lowering, v: Int|
    with_need(accumulator, { var: v, reads: Layout }))

type BuiltinCallTypes = { return_type: Option<Type>, args: List<Type> }

fn builtin_types_at(context: Context, name: Bytes, callee: Code) -> BuiltinCallTypes =
  {
    return_type: match builtin_call_types(context.setting, Some(read_typed(callee)), name) {
      Some(c) -> Some(c.result_type),
      None -> None,
    },
    args: read_typed(callee).args,
  }

fn container_builtin_call(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  f: BuiltinCallTypes,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} =
  if (name == b"List::len" || name == b"Bytes::len" || name == b"Map::len") && args.len() == 1 {
    read_in_place(st, Length, args, int_type, AsInt, at)
  } else if name == b"Array::len" && args.len() == 1 {
    read_in_place(st, ArrayLength, args, int_type, AsInt, at)
  } else if name == b"List::with_capacity" && args.len() == 1 {
    match ((f.return_type, args)) {
      (Some(return_type), [n]) -> empty_list_with_capacity(context, st, return_type, n, at),
      _ -> unreachable(b"an empty list has no type recorded by the checker"),
    }
  } else if name == b"numeric_of_int" && args.len() == 2
      && (match f.return_type {
        Some(t) ->
          numeric_sum(context.setting.constructors, t)
            || numeric_in_place(context.setting.constructors, t),
        None -> false,
      }) {
    match f.return_type {
      Some(t) -> if numeric_sum(context.setting.constructors, t) {
        numeric_function_call(context, st, b"of_int", args.drop(1), [int_type], t, at)
      } else { numeric_converted(context, st, args.get(1), t, at) },
      None -> unreachable(b"`numeric_of_int` has no type recorded by the checker"),
    }
  } else if name == b"Bytes::position" { bytes_position(context, st, args, callee, at) }
  else if name == b"bracket" || name == b"?hold_bracket" {
    bracketed(context, st, args, callee, at)
  } else if name.starts_with(b"Array::") || name.starts_with(b"Columns::")
      || list_written_in_place(name) { laid_out_builtin(context, st, name, args, f, at) }
  else if name.starts_with(b"ListNode::") { retired_list_call(context, st, name, args, callee, at) }
  else { runtime_builtin_call(context, st, name, args, f, callee, at) }

fn retired_list_call(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match builtin_call_types(context.setting, Some(read_typed(callee)), name) {
    Some(t) -> left_to_callers(context, st, name, args, t, at),
    None -> unreachable(b"a retired list extern at no type the checker recorded: ".concat(name)),
  }

fn list_written_in_place(name: Bytes) -> Bool =
  [b"List::at", b"List::push", b"List::set"].contains(name)

pub fn list_pushed(
  context: Context,
  st: Lowering,
  out: Arg,
  x: Arg,
  list: Type,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match list {
    NamedType(c) ->
      laid_out_builtin(
        context,
        st,
        b"List::push",
        [out, x],
        { return_type: Some(list), args: c.args },
        at,
      ),
    _ -> unreachable(b"a push onto what is no list"),
  }

fn laid_out_builtin(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  f: BuiltinCallTypes,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match f.args.at(0) {
    None -> unreachable(b"a container's builtin at no type the checker recorded: ".concat(name)),
    Some(t) -> match if name.starts_with(b"Columns::") { columns_of(context, t) }
      else { match element_of(context, t) { Some(e) -> Some([e]), None -> None } } {
      None -> if has_variables(t) {
        open_layout_builtin(context, layouts_needed(st, t), name, args, f, at)
      } else {
        unreachable(b"a container's elements laid out no way the emitter knows: ".concat(name))
      },
      Some(es) -> if name.starts_with(b"Array::") {
        array_builtin_call(context, note_block_layout(st, t), name, args, t, es, f, at)
      } else if name.starts_with(b"List::") {
        list_builtin_call(context, note_block_layout(st, t), name, args, t, es, f, at)
      } else { columns_builtin_call(context, note_block_layout(st, t), name, args, t, es, f, at) },
    },
  }

fn layouts_needed(st: Lowering, t: Type) -> Lowering =
  type_variables(t).fold(st, |accumulator: Lowering, v: Int|
    with_need(accumulator, { var: v, reads: Layout }))

fn list_builtin_call(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ty: Type,
  es: List<Element>,
  f: BuiltinCallTypes,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match es.at(0) {
    None -> unreachable(b"a list whose items lay out as nothing"),
    Some(e) -> {
      let held = representation_of(context.setting, ty);
      let list = list_type(ty);
      if name == b"List::at" {
        found_at(
          context,
          st,
          args,
          ty,
          return_type_or(f, option_type(ty)),
          ListInBounds,
          ItemAt,
          false,
          None,
          at,
        )
      } else if name == b"List::push" {
        container_called(
          context,
          st,
          ListPush(e),
          args,
          [AsWord, held],
          [true, true],
          true,
          false,
          list,
          at,
        )
      } else if name == b"List::set" {
        container_called(
          context,
          st,
          ListSet(e),
          args,
          [AsWord, AsInt, held],
          [true, false, true],
          true,
          true,
          list,
          at,
        )
      } else { unreachable(b"a list's builtin no emitted code writes: ".concat(name)) }
    },
  }

fn open_layout_builtin(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  f: BuiltinCallTypes,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match f.return_type {
    None ->
      unreachable(b"an array builtin has no type recorded by the type checker: ".concat(name)),
    Some(return_type) ->
      represented_as(
        bound_as(
          st,
          return_type,
          AsWord,
          OperationCall({
            operation: OfHandling(UnspecialisedBuiltin(name)),
            args: args,
            uses: { takes: args.map(|_: Arg| true), owned: true, fails: true, suspends: false },
          }),
          at,
        ),
        representation_of(context.setting, return_type),
        at,
      ),
  }

fn runtime_builtin_call(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  f: BuiltinCallTypes,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} =
  if !context.setting.builtins.contains(name) {
    unreachable(b"the program declares no native function with this name: ".concat(name))
  } else if name == b"?scope_new" || name == b"?scope_take" || name == b"Scoped::get" {
    match f.return_type {
      Some(return_type) -> scoped_builtin_call(context, st, name, args, return_type, at),
      None ->
        unreachable(
          b"a builtin on scoped values (`?scope_new`, `?scope_take` or `Scoped::get`) has no return type recorded by the type checker: ".concat(
            name,
          ),
        ),
    }
  } else {
    match context.setting.machine.get(name) {
      Some(call) -> machine_word_call(context, st, name, call, args, f.return_type, callee, at),
      None -> unspecialised_builtin_call(context, st, name, args, f, callee, at),
    }
  }

fn unspecialised_builtin_call(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  f: BuiltinCallTypes,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let types = match builtin_call_types(context.setting, Some(read_typed(callee)), name) {
    Some(t) -> Some(t),
    None -> match f.return_type {
      Some(return_type) -> Some({ params: args.map(type_of), result_type: return_type }),
      None -> None,
    },
  };
  match types {
    Some(t) -> if t.params.push(t.result_type).all(fully_known) {
      unreachable(b"the compiler generates no code for this builtin: ".concat(name))
    } else { left_to_callers(context, st, name, args, t, at) },
    None ->
      unreachable(
        b"the type checker recorded no types for this builtin call, and the program declares none: ".concat(
          name,
        ),
      ),
  }
}

fn scoped_builtin_call(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  return_type: Type,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args {
    [a] -> {
      let w = represented_as({ st: st, arg: a }, AsWord, at);
      let made = name == b"?scope_new";
      let read = name == b"Scoped::get";
      let native = if made { b"?hold_made" } else if read { b"?hold_read" } else { b"?hold_taken" };
      let result = bound_as(
        w.st,
        return_type,
        AsWord,
        Native({
          name: builtin_helper(native).concat(b"_p"),
          args: [w.arg],
          uses: { takes: [made], owned: !read, fails: !made, suspends: false },
        }),
        at,
      );
      represented_as(result, representation_of(context.setting, return_type), at)
    },
    _ ->
      unreachable(
        b"a builtin on scoped values (`?scope_new`, `?scope_take` or `Scoped::get`) must take exactly one argument: ".concat(
          name,
        ),
      ),
  }

fn note_element_layout(st: Lowering, t: Type) -> Lowering =
  if !has_open_layout(t) { st } else {
    layout_variables(t).fold(st, |accumulator: Lowering, v: Int|
      with_need(accumulator, { var: v, reads: Layout }))
  }

fn has_open_layout(t: Type) -> Bool =
  match t {
    VariableType(_) -> true,
    RecordType(fs) -> fs.any(|x: Field| has_open_layout(x.ty)),
    NominalType(x) -> x.fields.any(|y: Field| has_open_layout(y.ty)),
    _ -> false,
  }

fn read_in_place(
  st: Lowering,
  container_operation: ContainerOperation,
  args: List<Arg>,
  ty: Type,
  rep: Representation,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let object = match args.at(0) {
    Some(a) -> represented_as({ st: st, arg: a }, AsWord, at),
    None -> unreachable(b"a read from a container has no container argument"),
  };
  let index = match args.at(1) {
    Some(i) -> {
      let h = represented_as({ st: object.st, arg: i }, AsInt, at);
      { st: h.st, args: [object.arg, h.arg] }
    },
    None -> { st: object.st, args: [object.arg] },
  };
  bound_as(
    index.st,
    ty,
    rep,
    OperationCall({
      operation: OfContainers(container_operation),
      args: index.args,
      uses: { takes: index.args.map(|_: Arg| false), owned: false, fails: false, suspends: false },
    }),
    at,
  )
}

fn pointer_option(context: Context, ty: Type) -> Bool =
  match representation_of(context.setting, ty) {
    AsSum(s) ->
      s.layout.classes == [PointerSum(1)]
        && s.layout.cases.any(|c: CaseLayout|
          match c.payload { Inline(i) -> classes(i.layout) == [Pointer], _ -> false }),
    _ -> false,
  }

type Operand = | Read | Consumed | ConsumedOption | Index

type IntrinsicReturn = | Plain(Representation) | Item | Fields

type IntrinsicShape = { operands: List<Operand>, result: IntrinsicReturn, owned: Bool }

pub fn intrinsic_call(
  context: Context,
  st: Lowering,
  intrinsic: Intrinsic,
  args: List<Arg>,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let l = intrinsic_shape(intrinsic);
  let items = intrinsic_items(intrinsic);
  let result = match l.result {
    Plain(r) -> Some(r),
    Item -> Some(representation_of(context.setting, ty)),
    Fields -> match returned_record_leaves(context, ty) {
      Some(ls) -> Some(AsFlattened(ls)),
      None -> None,
    },
  };
  match result {
    None ->
      unreachable(
        b"an extern function that updates a container in place returns a record that does not fit in one machine word",
      ),
    Some(rep) -> if l.operands.len() != args.len() {
      unreachable(
        b"an extern function that updates a container in place is called with a different number of arguments than it declares",
      )
    } else if (match l.result { Item -> false, _ -> is_option(ty) && !pointer_option(context, ty) })
        || range(0, args.len()).any(|i: Int|
          l.operands.at(i) == Some(ConsumedOption)
            && (match args.at(i) {
              Some(VariableOperand(v)) -> !pointer_option(context, v.ty),
              Some(_) -> false,
              None -> true,
            })) {
      unreachable(
        b"an extern function that updates a container in place uses an `Option` that is not represented as a single pointer",
      )
    } else {
      let object = match args.at(0) { Some(a) -> type_of(a), None -> ty };
      let laid_types = match intrinsic {
        OfMap(_) -> match object {
          NamedType(c) -> if c.name == map_name { [] } else { c.args },
          _ -> [],
        },
        Recast -> [],
      };
      let laid_st = laid_types.fold(st, |s: Lowering, t: Type| note_element_layout(s, t));
      let handed_over = range(0, args.len()).fold(
        { st: laid_st, args: [] },
        |accumulator: { st: Lowering, args: List<Arg> }, i: Int|
          match args.at(i) {
            None -> accumulator,
            Some(a) -> {
              let h = represented_as(
                { st: accumulator.st, arg: a },
                match l.operands.at(i) {
                  Some(Index) -> AsInt,
                  Some(ConsumedOption) -> AsWord,
                  _ -> if items.at.contains(i) { representation_of(context.setting, type_of(a)) }
                  else { AsWord },
                },
                at,
              );
              { st: h.st, args: accumulator.args.push(h.arg) }
            },
          },
      );
      let copies = l.operands.at(0) == Some(Consumed) && intrinsic != Recast;
      let returned = bound_as(
        if copies {
          match args.at(0) {
            Some(a) -> note_block_layout(handed_over.st, type_of(a)),
            None -> handed_over.st,
          }
        } else { handed_over.st },
        ty,
        rep,
        OperationCall({
          operation: OfContainers(NodeIntrinsic(intrinsic)),
          args: handed_over.args,
          uses: {
            takes: l.operands.map(|o: Operand| o == Consumed || o == ConsumedOption),
            owned: l.owned,
            fails: false,
            suspends: false,
          },
        }),
        at,
      );
      represented_as(returned, representation_of(context.setting, ty), at)
    },
  }
}

fn returned_record_leaves(context: Context, ty: Type) -> Option<List<Leaf>> = {
  let ls = match layout_leaves(context.setting.constructors, ty) {
    Some(x) -> x,
    None -> match record_fields(ty) {
      Some(fs) -> fs.map(|f: Field| { name: f.name, representation: AsWord }),
      None -> [],
    },
  };
  if ls.len() == 0 { None } else { Some(ls) }
}

type IntrinsicItems = { read: Bool, at: List<Int> }

fn intrinsic_items(intrinsic: Intrinsic) -> IntrinsicItems =
  match intrinsic {
    OfMap(NodeKey) -> { read: true, at: [] },
    OfMap(NodeValue) -> { read: true, at: [] },
    OfMap(ChildMaxKey) -> { read: true, at: [] },
    OfMap(PairPut) -> { read: false, at: [2, 3] },
    OfMap(PairSet) -> { read: false, at: [2, 3] },
    OfMap(KidRestore) -> { read: false, at: [3] },
    OfMap(KidPut) -> { read: false, at: [3] },
    _ -> { read: false, at: [] },
  }

fn intrinsic_shape(intrinsic: Intrinsic) -> IntrinsicShape = {
  let read = |operands: List<Operand>, rep: Representation|
    { operands: operands, result: Plain(rep), owned: false };
  let item = { operands: [Read, Index], result: Item, owned: false };
  let made = { operands: [], result: Plain(AsWord), owned: true };
  let written = |operands: List<Operand>|
    { operands: operands, result: Plain(AsWord), owned: true };
  let record = |operands: List<Operand>| { operands: operands, result: Fields, owned: true };
  match intrinsic {
    OfMap(MapRoot) -> read([Read], AsWord),
    OfMap(NodeCount) -> read([Read], AsInt),
    OfMap(MapHeight) -> read([Read], AsInt),
    OfMap(NodeKey) -> item,
    OfMap(NodeValue) -> item,
    OfMap(ChildMaxKey) -> item,
    OfMap(NodeKid) -> read([Read, Index], AsWord),
    OfMap(KidSize) -> read([Read, Index], AsInt),
    OfMap(NewLeaf) -> made,
    OfMap(NewMapBranch) -> made,
    OfMap(PairPut) -> written([Consumed, Index, Consumed, Consumed]),
    OfMap(PairSet) -> written([Consumed, Index, Consumed, Consumed]),
    OfMap(KidRestore) -> written([Consumed, Index, Consumed, Consumed, Index]),
    OfMap(KidPut) -> written([Consumed, Index, Consumed, Consumed, Index]),
    OfMap(KidDrop) -> written([Consumed, Index]),
    OfMap(PairTake) -> record([Consumed, Index]),
    OfMap(LeafSplit) -> record([Consumed, Index]),
    OfMap(BranchSplit) -> record([Consumed, Index]),
    OfMap(KidOut) -> record([Consumed, Index]),
    OfMap(MapSwap) -> record([Consumed, ConsumedOption, Index, Index]),
    Recast -> written([Consumed]),
  }
}

fn element_of(context: Context, ty: Type) -> Option<Element> =
  match pointer_layout(context.setting.constructors, ty) {
    Some(l) -> Some({ layout: l, stride: max(1, words(l)) }),
    None -> None,
  }

fn columns_of(context: Context, ty: Type) -> Option<List<Element>> =
  match record_fields(ty) {
    None -> None,
    Some(fs) ->
      fs.fold(Some([]), |accumulator: Option<List<Element>>, x: Field|
        match accumulator {
          None -> None,
          Some(es) -> match element_of(context, x.ty) { Some(e) -> Some(es.push(e)), None -> None },
        }),
  }

fn array_builtin_call(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ty: Type,
  es: List<Element>,
  f: BuiltinCallTypes,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match es.at(0) {
    None -> unreachable(b"an array element type has no memory layout"),
    Some(e) -> {
      let representation = representation_of(context.setting, ty);
      let array = array_type(ty);
      if name == b"Array::at" {
        found_at(
          context,
          st,
          args,
          ty,
          return_type_or(f, option_type(ty)),
          InBounds,
          ArrayGet(e),
          true,
          None,
          at,
        )
      } else if name == b"Array::new" {
        container_called(
          context,
          st,
          ArrayNew(e),
          args,
          [AsInt, representation],
          [false, true],
          true,
          true,
          array,
          at,
        )
      } else if name == b"Array::set" {
        container_called(
          context,
          st,
          ArraySet(e),
          args,
          [AsWord, AsInt, representation],
          [true, false, true],
          true,
          true,
          array,
          at,
        )
      } else if name == b"Array::of_list" {
        container_called(context, st, ArrayOfList(e), args, [AsWord], [true], true, true, array, at)
      } else if name == b"Array::get" {
        container_called(
          context,
          st,
          ArrayGet(e),
          args,
          [AsWord, AsInt],
          [false, false],
          false,
          true,
          ty,
          at,
        )
      } else {
        unreachable(b"the compiler generates no code for this array builtin: ".concat(name))
      }
    },
  }

fn columns_builtin_call(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ty: Type,
  es: List<Element>,
  f: BuiltinCallTypes,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let representation = representation_of(context.setting, ty);
  let columns = columns_type(ty);
  let first = match record_fields(ty) {
    Some(fs) -> match fs.at(0) { Some(x) -> x.ty, None -> unit_type },
    None -> unit_type,
  };
  if name == b"Columns::len" {
    match args {
      [cs] -> {
        let cw = represented_as({ st: st, arg: cs }, AsWord, at);
        let c0 = column_of(cw.st, cw.arg, 0, first, at);
        read_in_place(c0.st, ArrayLength, [c0.arg], int_type, AsInt, at)
      },
      _ -> unreachable(b"a Columns length must take exactly one operand"),
    }
  } else if name == b"Columns::at" {
    found_at(
      context,
      st,
      args,
      ty,
      return_type_or(f, option_type(ty)),
      InBounds,
      ColumnsGet(es),
      true,
      Some(first),
      at,
    )
  } else if name == b"Columns::new" {
    container_called(
      context,
      st,
      ColumnsNew(es),
      args,
      [AsInt, representation],
      [false, true],
      true,
      true,
      columns,
      at,
    )
  } else if name == b"Columns::set" {
    container_called(
      context,
      st,
      ColumnsSet(es),
      args,
      [AsWord, AsInt, representation],
      [true, false, true],
      true,
      true,
      columns,
      at,
    )
  } else if name == b"Columns::of_list" {
    container_called(
      context,
      st,
      ColumnsOfList(es),
      args,
      [AsWord],
      [true],
      true,
      true,
      columns,
      at,
    )
  } else if name == b"Columns::get" {
    container_called(
      context,
      st,
      ColumnsGet(es),
      args,
      [AsWord, AsInt],
      [false, false],
      false,
      true,
      ty,
      at,
    )
  } else { unreachable(b"the compiler generates no code for this Columns builtin: ".concat(name)) }
}

fn return_type_or(f: BuiltinCallTypes, otherwise: Type) -> Type =
  match f.return_type { Some(t) -> t, None -> otherwise }

fn container_called(
  context: Context,
  st: Lowering,
  container_operation: ContainerOperation,
  args: List<Arg>,
  reps: List<Representation>,
  takes: List<Bool>,
  owned: Bool,
  fails: Bool,
  result: Type,
  at: Span,
) -> LoweredValue / {abort.raise} =
  if args.len() != reps.len() {
    unreachable(b"a container builtin has a different number of operands than it takes")
  } else {
    let operands = range(0, args.len()).fold(
      { st: st, args: [] },
      |accumulator: { st: Lowering, args: List<Arg> }, i: Int|
        match ((args.at(i), reps.at(i))) {
          (Some(a), Some(r)) -> {
            let h = represented_as({ st: accumulator.st, arg: a }, r, at);
            { st: h.st, args: accumulator.args.push(h.arg) }
          },
          _ -> accumulator,
        },
    );
    bound_as(
      operands.st,
      result,
      representation_of(context.setting, result),
      OperationCall({
        operation: OfContainers(container_operation),
        args: operands.args,
        uses: { takes: takes, owned: owned, fails: fails, suspends: false },
      }),
      at,
    )
  }

fn found_at(
  context: Context,
  st: Lowering,
  args: List<Arg>,
  item: Type,
  result: Type,
  inside_test: ContainerOperation,
  get: ContainerOperation,
  fails: Bool,
  column: Option<Type>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args {
    [xs, i] -> {
      let xw = represented_as({ st: st, arg: xs }, AsWord, at);
      let iw = represented_as({ st: xw.st, arg: i }, AsInt, at);
      let tested = match column {
        Some(t) -> column_of(iw.st, xw.arg, 0, t, at),
        None -> { st: iw.st, arg: xw.arg },
      };
      let inside = bound_as(
        tested.st,
        bool_type,
        AsBool,
        OperationCall({
          operation: OfContainers(inside_test),
          args: [tested.arg, iw.arg],
          uses: { takes: [false, false], owned: false, fails: false, suspends: false },
        }),
        at,
      );
      let got = bound_as(
        enter_block(inside.st),
        item,
        representation_of(context.setting, item),
        OperationCall({
          operation: OfContainers(get),
          args: [xw.arg, iw.arg],
          uses: { takes: [false, false], owned: false, fails: fails, suspends: false },
        }),
        at,
      );
      let some = constructed_as(context, got.st, some_constructor, [got.arg], result, at);
      let none = constructed_as(
        context,
        enter_block(exit_block(inside.st, some.st)),
        none_constructor,
        [],
        result,
        at,
      );
      base::joined(context, inside, some, none, false, at)
    },
    _ -> unreachable(b"a container element lookup must take exactly two operands"),
  }

fn column_of(st: Lowering, cs: Arg, k: Int, ty: Type, at: Span) -> LoweredValue =
  bound_as(
    st,
    array_type(ty),
    AsWord,
    OperationCall({
      operation: OfContainers(ColumnOf(k)),
      args: [cs],
      uses: { takes: [false], owned: false, fails: false, suspends: false },
    }),
    at,
  )

fn bytes_position(
  context: Context,
  st: Lowering,
  args: List<Arg>,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args {
    [b, from, f] -> {
      let bw = represented_as({ st: st, arg: b }, AsWord, at);
      let fr = represented_as({ st: bw.st, arg: from }, AsInt, at);
      let fw = represented_as({ st: fr.st, arg: f }, AsWord, at);
      let words = function_value_evidence(context, fw.st, builtin_effects(callee), at);
      let ty = option_type(int_type);
      let index = bound_as(
        words.st,
        int_type,
        AsInt,
        OperationCall({
          operation: OfContainers(Position),
          args: [bw.arg, fr.arg, fw.arg].concat(words.args),
          uses: {
            takes: [false, false, false, false, false],
            owned: true,
            fails: true,
            suspends: true,
          },
        }),
        at,
      );
      let found = bound_as(
        index.st,
        bool_type,
        AsBool,
        Primitive({ operation: b"ge", on: AsInt, args: [index.arg, IntOperand(0)] }),
        at,
      );
      let some = constructed_as(
        context,
        enter_block(found.st),
        some_constructor,
        [index.arg],
        ty,
        at,
      );
      let none = constructed_as(
        context,
        enter_block(exit_block(found.st, some.st)),
        none_constructor,
        [],
        ty,
        at,
      );
      base::joined(context, found, some, none, false, at)
    },
    _ -> unreachable(b"a byte string position lookup must take exactly three operands"),
  }

fn bracketed(
  context: Context,
  st: Lowering,
  args: List<Arg>,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args {
    [acquire, release, body] -> match ((type_of(acquire), type_of(body))) {
      (FunctionType(a), FunctionType(b)) -> {
        let aw = represented_as({ st: st, arg: acquire }, AsWord, at);
        let bw = represented_as({ st: aw.st, arg: body }, AsWord, at);
        let rw = represented_as({ st: bw.st, arg: release }, AsWord, at);
        let resource_descriptor = type_descriptor(context, rw.st, a.return_type, at);
        let result = type_descriptor(context, resource_descriptor.st, b.return_type, at);
        let words = function_value_evidence(context, result.st, builtin_effects(callee), at);
        let ran = bound_as(
          run_for_effect(
            words.st,
            OperationCall({
              operation: OfHandling(Entering),
              args: words.args,
              uses: { takes: [false, false], owned: false, fails: false, suspends: false },
            }),
            at,
          ),
          b.return_type,
          AsWord,
          Native({
            name: b"rt_with_cleanup_p",
            args: [aw.arg, bw.arg, rw.arg, resource_descriptor.arg, result.arg],
            uses: {
              takes: [true, true, true, false, false],
              owned: true,
              fails: true,
              suspends: true,
            },
          }),
          at,
        );
        represented_as(ran, representation_of(context.setting, b.return_type), at)
      },
      _ -> unreachable(b"the operands of `bracket` must all be functions"),
    },
    _ -> unreachable(b"`bracket` must take exactly three operands"),
  }

pub fn scalar_builtin(name: Bytes) -> Bool =
  [
      b"reflect",
      b"shown",
      b"digest",
      b"?encoded",
      b"?same",
      b"compare",
      b"min",
      b"max",
      b"compare_values",
      b"wrap_add",
      b"wrap_sub",
      b"wrap_mul",
      b"rotr",
      b"rotl",
      b"saturating_add",
      b"saturating_sub",
      b"saturating_mul",
      b"checked_add",
      b"checked_sub",
      b"checked_mul",
      b"checked_neg",
      b"to_int",
      b"?numeric_binary",
      b"?numeric_unary",
      b"U8::of_int",
      b"U16::of_int",
      b"U32::of_int",
      b"U64::of_int",
      b"I8::of_int",
      b"I16::of_int",
      b"I32::of_int",
      b"I64::of_int",
      b"U128::of_int",
      b"I128::of_int",
      b"Int::of_u8",
      b"Int::of_u16",
      b"Int::of_u32",
      b"Int::of_u64",
      b"Int::of_i8",
      b"Int::of_i16",
      b"Int::of_i32",
      b"Int::of_i64",
      b"Int::of_u128",
      b"Int::of_i128",
      b"Float::of_int",
      b"Float::of_bits",
      b"bits_of_float",
      b"?stated_witness",
    ].contains(
      name,
    )
    || float_function(name) != None
    || float_exact(name) != None
    || is_decimal_conversion(name)

fn resolved(context: Context, name: Bytes) -> Option<Bytes> =
  match imported_target(context.setting.imports, name) {
    None -> Some(generated_builtin(name)),
    Some(t) -> if t.imp.definitions.any(|d: Definition| d.name == t.name)
        || !context.setting.builtins.contains(t.name) { None }
    else { Some(t.name) },
  }

fn intrinsic_at(context: Context, name: Bytes) -> Option<Intrinsic> =
  intrinsic_named(match qualified(name) {
    Some(q) -> match module_import(context.setting.imports, q.binder) {
      Some(imp) -> qualify(imp.module, q.name),
      None -> qualify(context.setting.module, name),
    },
    None -> match from_import(context.setting.imports, name) {
      Some(imp) -> qualify(imp.module, name),
      None -> qualify(context.setting.module, name),
    },
  })
