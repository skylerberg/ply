//! Lists, maps, arrays and `Columns`: their literals, builtins and intrinsics. Every builtin call
//! comes here first: a crossing goes on to `crossing`, what `strings` writes over strings and bytes
//! to it, what the emitter writes for a scalar's type to `scalars`; what reads or writes a
//! container's cells is written in place, and the rest is called through the runtime's helper named
//! for it.

import std.list
import compiler.syntax.parsing (Span, dummy_span)
import compiler.emit.code (Code, NApp, NVar)
import compiler.check.types (Type, TyVar, TyCon, TyFn, TyRecord, TyNominal, Field, int_type,
                             bool_type, unit_type, option_type, record_fields)
import compiler.check.resolve.tables (qualify)
import compiler.emit.layout (Intrinsic, OfList, OfMap, ListStart, TailLen, ListRoot, TailAt,
                             NodeLen, LeafAt, KidAt, TailPush, TailSet, LeafSet, RootSwap, KidSwap,
                             TailStart, Spill, NewBranch, MapRoot, NodeCount, MapHeight, NodeKey,
                             NodeValue, NodeKid, KidMax, KidSize, NewLeaf, NewMapBranch, PairPut,
                             PairSet, PairTake, LeafCut, BranchCut, KidOut, KidBack, KidPut,
                             KidDrop, MapSwap, Recast, P, S, CaseLaid, Inline, classes, words,
                             intrinsic_named)
import compiler.emit.reps (Def, has_vars, laid_vars, laid_inside, numeric_sum, laid_by_pointer)
import compiler.emit.answer (Layout)
import compiler.emit.roots (builtin_helper, generated_builtin)
import compiler.emit.release (released_vars)
import compiler.emit.tir (Rep, RInt, RBool, RNum, RFloat, RDec, RWide, RWord, RSum, RFlat, Leaf,
                          Var, Arg, AVar, AInt, AZero, RUnit, Make, MList, Native, Op, OContainer,
                          OHandle, Let, Prim, If, Containers, Static)
import compiler.emit.tir.handling (Unsettled)
import compiler.emit.tir.containers (ContainerOp, Laid, Length, Elements, Within, ArrayNew,
                                     ArraySet, ArrayOfList, ArrayGet, ColumnsNew, ColumnsSet,
                                     ColumnsOfList, ColumnsGet, ColumnField, ColumnOf, ItemAt, Rest,
                                     LeafOf, Room, Position, Element)
import compiler.emit.lower.setting (imported_target, qualified, from_import, module_import,
                                    builtin_at, prelude_ctor)
import compiler.emit.lower.held (held_as, laid_leaves)
import compiler.emit.lower.base (Context, Lowering, Lowered, refuse, bound_as, handed, noted, filed,
                                 unfiled, type_of, as_words, opened, continued)
import compiler.emit.lower.base
import compiler.emit.lower.data (constructed_as)
import compiler.emit.lower.scalars (operated, runtime_builtin, stated, binary, numeric_in_place,
                                    numeric_converted, decimal_conversion)
import compiler.expand.rewrite (float_function)
import compiler.emit.statics (laid_at, KnownMap)
import compiler.emit.tir.statics (StaticDef)
import compiler.emit.lower.crossing (crossing_builtin, crossed, type_described, over_encoding,
                                     by_encoding, through_runtime)
import compiler.emit.lower.strings
import compiler.emit.lower.strings (string_builtin)

/// Builtin `name` called on `args`; `callee` is where its name is written, which the checker files
/// the types it called the builtin at under. A native the elaboration writes calls of, its name
/// `?`-led, has no filing of its own.
pub fn builtin(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Span,
  at: Span,
) -> Lowered / {abort.raise} =
  if filed(cx, callee) == None && !name.starts_with(b"?") {
    unfiled(cx, st, b"a builtin's call", callee)
  } else { builtin_filed(cx, st, name, args, callee, at) }

fn builtin_filed(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Span,
  at: Span,
) -> Lowered / {abort.raise} =
  match intrinsic_at(cx, name) {
    Some(op) -> match called_at(cx, name, callee).ret {
      None -> refuse(st, Containers, b"an extern written in place the checker filed no type for"),
      Some(ret) -> laid(cx, st, op, args, ret, at),
    },
    None -> match resolved(cx, name) {
      None ->
        refuse(
          st,
          Containers,
          b"an imported name that is neither a definition nor a builtin: ".concat(name),
        ),
      Some(b) -> if written_part(name) && filed(cx, callee) == None {
        // Written code files a part's type where a root of its own writes it; the rest only the
        // runtime can answer, the root that asks among them.
        runtime_builtin(cx, st, b, args, at)
      } else if b == b"assert_eq" { asserted(cx, st, args, callee, at) }
      else if b == b"Map::new" && args.len() == 0 { empty_map(cx, st, args, callee, at) }
      else if crossing_builtin(b) { crossed(cx, st, b, args, callee, at) }
      else if string_builtin(b) { strings::lowered(cx, st, b, args, callee, at) }
      else if scalar_builtin(b) { operated(cx, st, b, args, at) }
      else { contained(cx, st, b, args, called_at(cx, b, callee), callee, at) },
    },
  }

/// `assert_eq(actual, expected)`: the two compared as `==` compares them, and handed the runtime over
/// their encoding only where they differ, which raises with both shown. In a body generic over their
/// type, the runtime's builtin, which only the specialisations its callers settle run.
fn asserted(
  cx: Context,
  st: Lowering,
  args: List<Arg>,
  callee: Span,
  at: Span,
) -> Lowered / {abort.raise} =
  match args {
    [a, b] -> {
      let ty = type_of(a);
      if has_vars(ty) { crossed(cx, st, b"assert_eq", args, callee, at) } else {
        let equal = binary(cx, { st: st, arg: a }, { st: st, arg: b }, b"eq", at);
        let failed = by_encoding(
          cx,
          opened(equal.st),
          b"?assert_failed",
          args,
          { params: [ty, ty], ret: unit_type() },
          at,
        );
        {
          st: {
            ..continued(equal.st, failed.st),
            insts: equal.st.insts.push(
              If({ cond: equal.arg, then: [], otherwise: failed.st.insts }),
            ),
          },
          arg: AZero(RUnit),
        }
      }
    },
    _ -> refuse(st, Containers, b"`assert_eq` of other than two values"),
  }

/// `Map::new()`: the empty map laid out as static data, immortal as the runtime's own is, which a
/// write copies. Its object is the same at every type, an open one too.
fn empty_map(
  cx: Context,
  st: Lowering,
  args: List<Arg>,
  callee: Span,
  at: Span,
) -> Lowered / {abort.raise} =
  match called_at(cx, b"Map::new", callee).ret {
    Some(ty) -> {
      let l = laid_at(cx.setting.ctors, ty, KnownMap({ keys: [], values: [] }));
      let statics = l.defs.fold(st.statics, |acc: List<StaticDef>, d: StaticDef|
        if acc.any(|x: StaticDef| x.name == d.name) { acc } else { acc.push(d) });
      bound_as({ ..st, statics: statics }, ty, RWord, Static(l.defs.get(l.defs.len() - 1).name), at)
    },
    None -> contained(cx, st, b"Map::new", args, called_at(cx, b"Map::new", callee), callee, at),
  }

/// Whether `name` is a builtin written code calls on a part of the value its root takes, encoding or
/// reflecting it at the type filed for the part.
fn written_part(name: Bytes) -> Bool =
  name == b"?encoded" || name == b"?reflect" || name == b"?shown"

/// Whether field `name` of `base` is read from its column, with no record made: `base` a call of the
/// builtin `Columns::get` of two, whose records the checker settled to a type that lays them out and
/// holds `name`. The driver then lowers the call's arguments and hands them `column_read`.
pub fn columned(cx: Context, base: Code, name: Bytes) -> Bool =
  match base.node {
    NApp(a) -> match a.func.node {
      NVar(f) -> if f.slot != None || a.args.len() != 2 || f.name != b"Columns::get"
          || cx.setting.here.any(|d: Def| d.name == f.name)
          || from_import(cx.setting.imports, f.name) != None { false }
      else { match column_at(cx, a.func.span, name) { Some(_) -> true, None -> false } },
      _ -> false,
    },
    _ -> false,
  }

/// Field `name` of record `args[1]` of the `Columns` `args[0]`, as the call `base` reads it: read
/// from its column, borrowed, raising as `Columns::get` does where the index names no record.
pub fn column_read(
  cx: Context,
  st: Lowering,
  args: List<Arg>,
  base: Code,
  name: Bytes,
  at: Span,
) -> Lowered =
  match column_at(cx, match base.node { NApp(a) -> a.func.span, _ -> base.span }, name) {
    None -> refuse(st, Containers, b"a field of a Columns' record no column holds: ".concat(name)),
    Some(c) -> match args {
      [xs, i] -> {
        let object = handed({ st: st, arg: xs }, RWord, at);
        let index = handed({ st: object.st, arg: i }, RInt, at);
        bound_as(
          index.st,
          c.ty,
          held_as(cx.setting, c.ty),
          Op({
            op: OContainer(ColumnField({ k: c.k, column: c.column })),
            args: [object.arg, index.arg],
            uses: { takes: [false, false], owned: false, fails: true, stops: false },
          }),
          at,
        )
      },
      _ -> refuse(st, Containers, b"a Columns' record read on other operands than two"),
    },
  }

/// Where field `name` of the records a call of `Columns::get` written at `callee` reads lies: its
/// place among the record's fields, its type, and how its column lays it out.
fn column_at(
  cx: Context,
  callee: Span,
  name: Bytes,
) -> Option<{ k: Int, ty: Type, column: Element }> =
  match called_at(cx, b"Columns::get", callee).args.at(0) {
    None -> None,
    Some(record) -> match record_fields(record) {
      None -> None,
      Some(fs) -> match range(0, fs.len()).find(|k: Int|
          match fs.at(k) { Some(f) -> f.name == name, None -> false }) {
        None -> None,
        Some(k) -> match fs.at(k) {
          Some(f) -> match element_of(cx, f.ty) {
            Some(e) -> Some({ k: k, ty: f.ty, column: e }),
            None -> None,
          },
          None -> None,
        },
      },
    },
  }

/// A list literal of `items`, each held as the item's type holds it and taken by the list, which
/// lays it as that type lays it, of the type the checker filed for it.
pub fn listed(cx: Context, st: Lowering, items: List<Arg>, at: Span) -> Lowered / {abort.raise} =
  match filed(cx, at) {
    None -> unfiled(cx, st, b"a list", at),
    Some(t) -> {
      let item = match t.ty { TyCon(c) -> c.args.at(0), _ -> None };
      let held = items.fold(
        { st: match item { Some(i) -> layout_needed(st, i), None -> st }, args: [] },
        |acc: { st: Lowering, args: List<Arg> }, a: Arg| {
          let h = handed(
            { st: acc.st, arg: a },
            match item { Some(i) -> held_as(cx.setting, i), None -> RWord },
            at,
          );
          { st: h.st, args: acc.args.push(h.arg) }
        },
      );
      bound_as(
        held.st,
        t.ty,
        held_as(cx.setting, t.ty),
        Make({ made: MList(items.len()), args: held.args, reuse: None }),
        at,
      )
    },
  }

/// Item `i` of the list `xs`, which a length test admitted, as a value of `item` is held: borrowed
/// from the list, a scalar read out of its word.
pub fn item_read(cx: Context, st: Lowering, xs: Arg, i: Arg, item: Type) -> Lowered =
  bound_as(
    layout_needed(st, item),
    item,
    held_as(cx.setting, item),
    Op({
      op: OContainer(ItemAt),
      args: [xs, i],
      uses: { takes: [false, false], owned: false, fails: false, stops: false },
    }),
    dummy_span(),
  )

/// The items of the list `xs`, of type `ty`, from `k` on, which a length test admitted: a list of
/// their own sharing `xs`'s trie, `xs` read, each item it copies counted as its type counts it.
pub fn rest_read(st: Lowering, ty: Type, xs: Arg, k: Arg) -> Lowered =
  bound_as(
    layout_noted(st, ty),
    ty,
    RWord,
    Op({
      op: OContainer(Rest),
      args: [xs, k],
      uses: { takes: [false, false], owned: true, fails: false, stops: false },
    }),
    dummy_span(),
  )

/// `st` noting each type variable the counted words of a block of `ty` are laid by, which only a
/// specialisation lays out.
fn layout_noted(st: Lowering, ty: Type) -> Lowering =
  released_vars(ty).fold(st, |acc: Lowering, v: Int| noted(acc, { var: v, reads: Layout }))

/// What a call of a builtin answers, as the checker filed it where the name is written or as the
/// builtin's declared scheme gives it at the type arguments filed there, and those type arguments.
type Settled = { ret: Option<Type>, args: List<Type> }

fn called_at(cx: Context, name: Bytes, callee: Span) -> Settled =
  {
    ret: match builtin_at(cx.setting, filed(cx, callee), name) {
      Some(c) -> Some(c.ret),
      None -> None,
    },
    args: match filed(cx, callee) { Some(t) -> t.args, None -> [] },
  }

/// A builtin that is no scalar's: written in place where it reads or writes a container's cells, and
/// otherwise called through the runtime, which must implement it.
fn contained(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  f: Settled,
  callee: Span,
  at: Span,
) -> Lowered / {abort.raise} =

  // A map's header counts its entries as a list's counts its items (`layout.MapLaid`).
  if (name == b"List::len" || name == b"Bytes::len" || name == b"Map::len") && args.len() == 1 {
    read_in_place(st, Length, args, int_type(), RInt, at)
  } else if name == b"Array::len" && args.len() == 1 {
    read_in_place(st, Elements, args, int_type(), RInt, at)
  } else if name == b"ListNode::leaf_of" && args.len() == 2 {
    // The leaf's word or 0, which an `Option` of one pointer is.
    match f.ret {
      Some(ret) -> if pointer_option(cx, ret) {
        handed(read_in_place(st, LeafOf, args, ret, RWord, at), held_as(cx.setting, ret), at)
      } else {
        refuse(st, Containers, b"a trie's leaf read as other than an Option of one pointer")
      },
      None -> refuse(st, Containers, b"a trie's leaf read at no type the checker filed"),
    }
  } else if name == b"List::with_capacity" && args.len() == 1 {
    match ((f.ret, args)) {
      (Some(ret), [n]) -> {
        // The room is its items' words, which the item's layout says.
        let laid_st = match ret {
          TyCon(c) -> match c.args.at(0) { Some(item) -> layout_needed(st, item), None -> st },
          _ -> st,
        };
        let count = handed({ st: laid_st, arg: n }, RInt, at);
        bound_as(
          count.st,
          ret,
          RWord,
          Op({
            op: OContainer(Room),
            args: [count.arg],
            uses: { takes: [false], owned: true, fails: false, stops: false },
          }),
          at,
        )
      },
      _ -> refuse(st, Containers, b"an empty list made at no type the checker filed"),
    }
  } else if name == b"numeric_of_int" && args.len() == 2
      && (match f.ret {
        Some(t) -> numeric_sum(cx.setting.ctors, t) || numeric_in_place(cx.setting.ctors, t),
        None -> false,
      }) {
    // The witness the elaboration passes first names the type the answer already does.
    match f.ret {
      Some(t) -> if numeric_sum(cx.setting.ctors, t) {
        stated(cx, st, b"of_int", args.drop(1), [int_type()], t, at)
      } else { numeric_converted(cx, st, args.get(1), t, at) },
      None -> refuse(st, Containers, b"`numeric_of_int` at no type the checker filed"),
    }
  } else if name == b"Bytes::position" { positioned(cx, st, args, at) }
  else if name == b"bracket" || name == b"?hold_bracket" { bracketed(cx, st, args, at) }
  else if name.starts_with(b"Array::") || name.starts_with(b"Columns::") {
    match f.args.at(0) {
      None ->
        refuse(st, Containers, b"an array's builtin at no type the checker filed: ".concat(name)),
      Some(t) -> match if name.starts_with(b"Array::") {
          match element_of(cx, t) { Some(e) -> Some([e]), None -> None }
        } else { columns_of(cx, t) } {
        None -> if open(t) { unlaid(cx, layout_needed(st, t), name, args, f, at) }
        else { called(cx, st, name, args, f, callee, at) },
        Some(es) -> if name.starts_with(b"Array::") {
          arrayed(cx, layout_noted(st, t), name, args, t, es, f, at)
        } else { columns_called(cx, layout_noted(st, t), name, args, t, es, f, at) },
      },
    }
  } else { called(cx, st, name, args, f, callee, at) }

/// Builtin `name` over elements whose layout a type variable leaves open, in a body its callers
/// settle at that layout (`layout_needed`) and lower again there: a placeholder no printer sees,
/// taking its arguments so the body lets go of none of them by a type it does not know.
fn unlaid(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  f: Settled,
  at: Span,
) -> Lowered / {abort.raise} =
  match f.ret {
    None ->
      refuse(st, Containers, b"an array's builtin at no type the checker filed: ".concat(name)),
    Some(ret) ->
      handed(
        bound_as(
          st,
          ret,
          RWord,
          Op({
            op: OHandle(Unsettled(name)),
            args: args,
            uses: { takes: args.map(|_: Arg| true), owned: true, fails: true, stops: false },
          }),
          at,
        ),
        held_as(cx.setting, ret),
        at,
      ),
  }

/// A builtin called through the runtime, which must implement it, over its arguments' encoding,
/// answering the type `f` gives. A hold's builtins are the runtime's natives over the hold
/// (`held_through`).
fn called(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  f: Settled,
  callee: Span,
  at: Span,
) -> Lowered / {abort.raise} =
  if !cx.setting.builtins.contains(name) {
    refuse(st, Containers, b"a name the runtime implements no builtin of: ".concat(name))
  } else if name == b"?hold_new" || name == b"?hold_take" || name == b"Hold::get" {
    match f.ret {
      Some(ret) -> held_through(cx, st, name, args, ret, at),
      None ->
        refuse(st, Containers, b"a hold's builtin at no type the checker filed: ".concat(name)),
    }
  } else {
    match builtin_at(cx.setting, filed(cx, callee), name) {
      Some(_) -> over_encoding(cx, st, name, args, callee, at),
      None -> match match f.ret { Some(r) -> Some(r), None -> elaborated_answer(name, args) } {
        None ->
          refuse(
            st,
            Containers,
            b"a builtin called at a type neither filed nor declared: ".concat(name),
          ),
        Some(ret) -> through_runtime(cx, st, name, args, ret, at),
      },
    }
  }

/// A hold's builtin `name` over its one operand, answering `ret`, by the runtime's native over the
/// hold, which never reads what the hold holds: `?hold_new` makes a hold of the value's word form,
/// which it takes; `Hold::get` answers that word lent from the hold, which whoever keeps it counts as
/// its type does; `?hold_take` takes it out, the hold letting go.
fn held_through(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ret: Type,
  at: Span,
) -> Lowered / {abort.raise} =
  match args {
    [a] -> {
      let w = handed({ st: st, arg: a }, RWord, at);
      let made = name == b"?hold_new";
      let read = name == b"Hold::get";
      let native = if made { b"?hold_made" } else if read { b"?hold_read" } else { b"?hold_taken" };
      let answer = bound_as(
        w.st,
        ret,
        RWord,
        Native({
          name: builtin_helper(native).concat(b"_p"),
          args: [w.arg],
          uses: { takes: [made], owned: !read, fails: !made, stops: false },
        }),
        at,
      );
      handed(answer, held_as(cx.setting, ret), at)
    },
    _ -> refuse(st, Containers, b"a hold's builtin of other than one operand: ".concat(name)),
  }

/// What a native the elaboration writes calls of answers, which no declaration states: an operator
/// at a type a witness stands for its operands' type, but `<`, `<=`, `>` and `>=`, which the
/// elaboration numbers 5 to 8, a `Bool`.
fn elaborated_answer(name: Bytes, args: List<Arg>) -> Option<Type> =
  if name == b"?numeric_binary" {
    match args {
      [AInt(k), _, x, _] -> Some(if k >= 5 && k <= 8 { bool_type() } else { type_of(x) }),
      _ -> None,
    }
  } else if name == b"?numeric_unary" { match args { [_, _, x] -> Some(type_of(x)), _ -> None } }
  else { None }

/// `st` noting each type variable that leaves the layout of an element of type `t` unknown, which a
/// specialisation would lay its elements out by.
fn layout_needed(st: Lowering, t: Type) -> Lowering =
  if !open(t) { st }
  else { laid_vars(t).fold(st, |acc: Lowering, v: Int| noted(acc, { var: v, reads: Layout })) }

/// Whether a value of type `t` is laid out by a type variable: one, or a record holding one.
fn open(t: Type) -> Bool =
  match t {
    TyVar(_) -> true,
    TyRecord(fs) -> fs.any(|x: Field| open(x.ty)),
    TyNominal(x) -> x.fields.any(|y: Field| open(y.ty)),
    _ -> false,
  }

/// An operation that reads `args`, written in place and never failing, its answer held as `rep`: the
/// object first, as a word, and then each index as an `Int`.
fn read_in_place(
  st: Lowering,
  op: ContainerOp,
  args: List<Arg>,
  ty: Type,
  rep: Rep,
  at: Span,
) -> Lowered = {
  let object = match args.at(0) {
    Some(a) -> handed({ st: st, arg: a }, RWord, at),
    None -> refuse(st, Containers, b"a read of nothing"),
  };
  let index = match args.at(1) {
    Some(i) -> {
      let h = handed({ st: object.st, arg: i }, RInt, at);
      { st: h.st, args: [object.arg, h.arg] }
    },
    None -> { st: object.st, args: [object.arg] },
  };
  bound_as(
    index.st,
    ty,
    rep,
    Op({
      op: OContainer(op),
      args: index.args,
      uses: { takes: index.args.map(|_: Arg| false), owned: false, fails: false, stops: false },
    }),
    at,
  )
}

/// Whether `ty` is an `Option` held as one pointer or 0, as the runtime holds one as its
/// payload's word: one word, `None` its one small value, `Some`'s payload one pointer.
fn pointer_option(cx: Context, ty: Type) -> Bool =
  match held_as(cx.setting, ty) {
    RSum(s) ->
      s.laid.classes == [S(1)]
        && s.laid.cases.any(|c: CaseLaid|
          match c.payload { Inline(i) -> classes(i.laid) == [P], _ -> false }),
    _ -> false,
  }

fn is_option(t: Type) -> Bool =
  match t { TyCon(c) -> c.name == b"Option" && c.args.len() == 1, _ -> false }

/// What an extern written in place does with an operand: reads the object it reads, takes a word it
/// writes or stores, takes an `Option` as its payload's word, or reads an index or a count.
type Operand = | Read | Taken | TakenMaybe | Index

/// What an extern written in place answers: a value held as a representation of its own, an item,
/// held as the item's type says where that is a scalar and as its word otherwise, or the record of
/// what it wrote and what it took out, held as its fields.
type Answer = | Plain(Rep) | Item | Fields

/// How an extern written in place takes its operands and answers, and whether its answer holds a
/// count of its own, which a node made or an object written does, and a read does not.
type Laying = { operands: List<Operand>, answer: Answer, owned: Bool }

/// Extern `op` called on `args`, answering a value of `ty`, written over the runtime's objects.
fn laid(cx: Context, st: Lowering, op: Intrinsic, args: List<Arg>, ty: Type, at: Span) -> Lowered = {
  let l = laying(op);
  let items = laid_items(op);
  let answer = match l.answer {
    Plain(r) -> Some(r),
    Item -> Some(held_as(cx.setting, ty)),
    Fields -> match fields_held(cx, ty) { Some(ls) -> Some(RFlat(ls)), None -> None },
  };
  match answer {
    None -> refuse(st, Containers, b"a write in place answering a record of a width past a word"),
    Some(rep) -> if l.operands.len() != args.len() {
      refuse(st, Containers, b"an extern written in place on other operands than it takes")
    } else if (match l.answer {
          // An item is laid as its type lays it, and read as its type holds it.
          Item -> false,
          _ -> is_option(ty) && !pointer_option(cx, ty),
        })
        || range(0, args.len()).any(|i: Int|
          l.operands.at(i) == Some(TakenMaybe)
            && (match args.at(i) {
              Some(AVar(v)) -> !pointer_option(cx, v.ty),
              // A constant `None` is the zero word an `Option` of one pointer lays it as.
              Some(_) -> false,
              None -> true,
            })) {
      refuse(st, Containers, b"an extern written in place over an Option of other than one pointer")
    } else {
      // An item lies in its node as its type lays it, which a specialisation reads: a list's
      // item, or a map's key and value, whose words a pair and a greatest key take.
      let object = match args.at(0) { Some(a) -> type_of(a), None -> ty };
      let laid_types = match op {
        OfList(_) -> if items.read { [ty] } else if items.at.len() > 0 || op == OfList(Spill) {
          match object { TyCon(c) -> c.args.take(1), _ -> [] }
        } else { [] },
        OfMap(_) -> match object {
          TyCon(c) -> if c.name == b"Map" { [] } else { c.args },
          _ -> [],
        },
        Recast -> [],
      };
      let laid_st = laid_types.fold(st, |s: Lowering, t: Type| layout_needed(s, t));
      let handed_over = range(0, args.len()).fold(
        { st: laid_st, args: [] },
        |acc: { st: Lowering, args: List<Arg> }, i: Int|
          match args.at(i) {
            None -> acc,
            Some(a) -> {
              let h = handed(
                { st: acc.st, arg: a },
                match l.operands.at(i) {
                  Some(Index) -> RInt,
                  Some(TakenMaybe) -> RWord,
                  _ -> if items.at.contains(i) { held_as(cx.setting, type_of(a)) } else { RWord },
                },
                at,
              );
              { st: h.st, args: acc.args.push(h.arg) }
            },
          },
      );
      // A write copies the object it takes where another holds it too, by the root its type has; a
      // recast writes nothing.
      let copies = l.operands.at(0) == Some(Taken) && op != OfList(TailStart) && op != Recast;
      let answered = bound_as(
        if copies {
          match args.at(0) {
            Some(a) -> layout_noted(handed_over.st, type_of(a)),
            None -> handed_over.st,
          }
        } else { handed_over.st },
        ty,
        rep,
        Op({
          op: OContainer(Laid(op)),
          args: handed_over.args,
          uses: {
            takes: l.operands.map(|o: Operand| o == Taken || o == TakenMaybe),
            owned: l.owned,
            fails: false,
            stops: false,
          },
        }),
        at,
      );
      handed(answered, held_as(cx.setting, ty), at)
    },
  }
}

/// The leaves a record of type `ty` an extern answers is held as: its fields laid in place however
/// wide (`laid_leaves`), which a record held as its box is then packed from, and where a type
/// variable leaves its layout open each field as its word; nothing for a record of no fields.
fn fields_held(cx: Context, ty: Type) -> Option<List<Leaf>> = {
  let ls = match laid_leaves(cx.setting.ctors, ty) {
    Some(x) -> x,
    None -> match record_fields(ty) {
      Some(fs) -> fs.map(|f: Field| { name: f.name, rep: RWord }),
      None -> [],
    },
  };
  if ls.len() == 0 { None } else { Some(ls) }
}

/// Whether an extern written in place reads an item out, and which operands are items it writes: an
/// item, a list's or a map's key or value, lies in its node as its type lays it, held as its type
/// holds it.
type LaidItems = { read: Bool, at: List<Int> }

fn laid_items(op: Intrinsic) -> LaidItems =
  match op {
    OfList(TailAt) -> { read: true, at: [] },
    OfList(LeafAt) -> { read: true, at: [] },
    OfList(TailPush) -> { read: false, at: [1] },
    OfList(TailStart) -> { read: false, at: [1] },
    OfList(TailSet) -> { read: false, at: [2] },
    OfList(LeafSet) -> { read: false, at: [2] },
    OfMap(NodeKey) -> { read: true, at: [] },
    OfMap(NodeValue) -> { read: true, at: [] },
    OfMap(KidMax) -> { read: true, at: [] },
    OfMap(PairPut) -> { read: false, at: [2, 3] },
    OfMap(PairSet) -> { read: false, at: [2, 3] },
    OfMap(KidBack) -> { read: false, at: [3] },
    OfMap(KidPut) -> { read: false, at: [3] },
    _ -> { read: false, at: [] },
  }

/// How each extern written in place takes its operands and answers.
fn laying(op: Intrinsic) -> Laying = {
  let read = |operands: List<Operand>, rep: Rep|
    { operands: operands, answer: Plain(rep), owned: false };
  let item = { operands: [Read, Index], answer: Item, owned: false };
  let made = { operands: [], answer: Plain(RWord), owned: true };
  let written = |operands: List<Operand>| { operands: operands, answer: Plain(RWord), owned: true };
  let record = |operands: List<Operand>| { operands: operands, answer: Fields, owned: true };
  match op {
    OfList(ListStart) -> read([Read], RInt),
    OfList(TailLen) -> read([Read], RInt),
    OfList(NodeLen) -> read([Read], RInt),
    OfList(ListRoot) -> read([Read], RWord),
    OfList(TailAt) -> item,
    OfList(LeafAt) -> item,
    OfList(KidAt) -> read([Read, Index], RWord),
    OfList(TailPush) -> written([Taken, Taken]),
    OfList(TailStart) -> written([Taken, Taken]),
    OfList(TailSet) -> written([Taken, Index, Taken]),
    OfList(LeafSet) -> written([Taken, Index, Taken]),
    OfList(NewBranch) -> made,
    OfList(RootSwap) -> record([Taken, TakenMaybe]),
    OfList(KidSwap) -> record([Taken, Index, TakenMaybe]),
    OfList(Spill) -> record([Taken]),
    OfMap(MapRoot) -> read([Read], RWord),
    OfMap(NodeCount) -> read([Read], RInt),
    OfMap(MapHeight) -> read([Read], RInt),
    OfMap(NodeKey) -> item,
    OfMap(NodeValue) -> item,
    OfMap(KidMax) -> item,
    OfMap(NodeKid) -> read([Read, Index], RWord),
    OfMap(KidSize) -> read([Read, Index], RInt),
    OfMap(NewLeaf) -> made,
    OfMap(NewMapBranch) -> made,
    OfMap(PairPut) -> written([Taken, Index, Taken, Taken]),
    OfMap(PairSet) -> written([Taken, Index, Taken, Taken]),
    OfMap(KidBack) -> written([Taken, Index, Taken, Taken, Index]),
    OfMap(KidPut) -> written([Taken, Index, Taken, Taken, Index]),
    OfMap(KidDrop) -> written([Taken, Index]),
    OfMap(PairTake) -> record([Taken, Index]),
    OfMap(LeafCut) -> record([Taken, Index]),
    OfMap(BranchCut) -> record([Taken, Index]),
    OfMap(KidOut) -> record([Taken, Index]),
    OfMap(MapSwap) -> record([Taken, TakenMaybe, Index, Index]),
    Recast -> written([Taken]),
  }
}

/// How an array lays out elements of type `ty`, as a container lays a value of it
/// (`reps.laid_by_pointer`), at least a word apart; none where a type variable leaves their layout
/// open.
fn element_of(cx: Context, ty: Type) -> Option<Element> =
  match laid_by_pointer(cx.setting.ctors, ty) {
    Some(l) -> Some({ laid: l, stride: max(1, words(l)) }),
    None -> None,
  }

/// How a `Columns` of records of type `ty` lays out each field's column, in the record's field
/// order; none where `ty` is no record or a type variable leaves a field's layout open.
fn columns_of(cx: Context, ty: Type) -> Option<List<Element>> =
  match record_fields(ty) {
    None -> None,
    Some(fs) ->
      fs.fold(Some([]), |acc: Option<List<Element>>, x: Field|
        match acc {
          None -> None,
          Some(es) -> match element_of(cx, x.ty) { Some(e) -> Some(es.push(e)), None -> None },
        }),
  }

/// Array builtin `name` on `args`, over an array of elements of type `ty` laid out as `es`'s one
/// element says: `get` reads an element, borrowed, `at` answers `Some` of it where the index names
/// one, and the rest answer the array they make or write.
fn arrayed(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ty: Type,
  es: List<Element>,
  f: Settled,
  at: Span,
) -> Lowered / {abort.raise} =
  match es.at(0) {
    None -> refuse(st, Containers, b"an array whose elements lay out as nothing"),
    Some(e) -> {
      let held = held_as(cx.setting, ty);
      let array = TyCon({ name: b"Array", args: [ty] });
      if name == b"Array::at" {
        found_at(cx, st, args, ty, answer_or(f, option_type(ty)), ArrayGet(e), None, at)
      } else if name == b"Array::new" {
        container_called(cx, st, ArrayNew(e), args, [RInt, held], [false, true], true, array, at)
      } else if name == b"Array::set" {
        container_called(
          cx,
          st,
          ArraySet(e),
          args,
          [RWord, RInt, held],
          [true, false, true],
          true,
          array,
          at,
        )
      } else if name == b"Array::of_list" {
        container_called(cx, st, ArrayOfList(e), args, [RWord], [true], true, array, at)
      } else if name == b"Array::get" {
        container_called(cx, st, ArrayGet(e), args, [RWord, RInt], [false, false], false, ty, at)
      } else { refuse(st, Containers, b"an array's builtin no emitted code writes: ".concat(name)) }
    },
  }

/// `Columns` builtin `name` on `args`, over records of type `ty` whose fields' columns lay out as
/// `es` says: `len` and `at` read the first column's length, `get` reads a record, borrowed, and
/// the rest answer the `Columns` they make or write.
fn columns_called(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ty: Type,
  es: List<Element>,
  f: Settled,
  at: Span,
) -> Lowered / {abort.raise} = {
  let held = held_as(cx.setting, ty);
  let columns = TyCon({ name: b"Columns", args: [ty] });
  let first = match record_fields(ty) {
    Some(fs) -> match fs.at(0) { Some(x) -> x.ty, None -> unit_type() },
    None -> unit_type(),
  };
  if name == b"Columns::len" {
    match args {
      [cs] -> {
        let cw = handed({ st: st, arg: cs }, RWord, at);
        let c0 = column_of(cw.st, cw.arg, 0, first, at);
        read_in_place(c0.st, Elements, [c0.arg], int_type(), RInt, at)
      },
      _ -> refuse(st, Containers, b"a Columns' length on other operands than one"),
    }
  } else if name == b"Columns::at" {
    found_at(cx, st, args, ty, answer_or(f, option_type(ty)), ColumnsGet(es), Some(first), at)
  } else if name == b"Columns::new" {
    container_called(cx, st, ColumnsNew(es), args, [RInt, held], [false, true], true, columns, at)
  } else if name == b"Columns::set" {
    container_called(
      cx,
      st,
      ColumnsSet(es),
      args,
      [RWord, RInt, held],
      [true, false, true],
      true,
      columns,
      at,
    )
  } else if name == b"Columns::of_list" {
    container_called(cx, st, ColumnsOfList(es), args, [RWord], [true], true, columns, at)
  } else if name == b"Columns::get" {
    container_called(cx, st, ColumnsGet(es), args, [RWord, RInt], [false, false], false, ty, at)
  } else { refuse(st, Containers, b"a Columns' builtin no emitted code writes: ".concat(name)) }
}

/// What the checker filed a call as answering, or `otherwise` where it filed nothing.
fn answer_or(f: Settled, otherwise: Type) -> Type = match f.ret { Some(t) -> t, None -> otherwise }

/// `op` over `args`, each handed as `reps` says, taking those `takes` marks, answering a value of
/// `answer` held as its type holds it, owned where `owned`; it raises where a length or an index is
/// out of range.
fn container_called(
  cx: Context,
  st: Lowering,
  op: ContainerOp,
  args: List<Arg>,
  reps: List<Rep>,
  takes: List<Bool>,
  owned: Bool,
  answer: Type,
  at: Span,
) -> Lowered =
  if args.len() != reps.len() {
    refuse(st, Containers, b"a container's builtin on other operands than it takes")
  } else {
    let operands = range(0, args.len()).fold(
      { st: st, args: [] },
      |acc: { st: Lowering, args: List<Arg> }, i: Int|
        match ((args.at(i), reps.at(i))) {
          (Some(a), Some(r)) -> {
            let h = handed({ st: acc.st, arg: a }, r, at);
            { st: h.st, args: acc.args.push(h.arg) }
          },
          _ -> acc,
        },
    );
    bound_as(
      operands.st,
      answer,
      held_as(cx.setting, answer),
      Op({
        op: OContainer(op),
        args: operands.args,
        uses: { takes: takes, owned: owned, fails: true, stops: false },
      }),
      at,
    )
  }

/// `Some` of what `get` reads at index `args[1]` of `args[0]`, of type `item`, where the index names
/// an element of the array tested, the container itself or, for a `Columns`, its first column, of
/// elements of type `column`; `None` where it names none.
fn found_at(
  cx: Context,
  st: Lowering,
  args: List<Arg>,
  item: Type,
  answer: Type,
  get: ContainerOp,
  column: Option<Type>,
  at: Span,
) -> Lowered / {abort.raise} =
  match args {
    [xs, i] -> {
      let xw = handed({ st: st, arg: xs }, RWord, at);
      let iw = handed({ st: xw.st, arg: i }, RInt, at);
      let tested = match column {
        Some(t) -> column_of(iw.st, xw.arg, 0, t, at),
        None -> { st: iw.st, arg: xw.arg },
      };
      let inside = bound_as(
        tested.st,
        bool_type(),
        RBool,
        Op({
          op: OContainer(Within),
          args: [tested.arg, iw.arg],
          uses: { takes: [false, false], owned: false, fails: false, stops: false },
        }),
        at,
      );
      let got = bound_as(
        opened(inside.st),
        item,
        held_as(cx.setting, item),
        Op({
          op: OContainer(get),
          args: [xw.arg, iw.arg],
          uses: { takes: [false, false], owned: false, fails: true, stops: false },
        }),
        at,
      );
      let some = constructed_as(cx, got.st, prelude_ctor(b"Some"), [got.arg], answer, at);
      let none = constructed_as(
        cx,
        opened(continued(inside.st, some.st)),
        prelude_ctor(b"None"),
        [],
        answer,
        at,
      );
      base::joined(cx, inside, some, none, false, at)
    },
    _ -> refuse(st, Containers, b"a container's element looked up on other operands than two"),
  }

/// Column `k` of the `Columns` `cs`, an array of elements of type `ty`, borrowed.
fn column_of(st: Lowering, cs: Arg, k: Int, ty: Type, at: Span) -> Lowered =
  bound_as(
    st,
    TyCon({ name: b"Array", args: [ty] }),
    RWord,
    Op({
      op: OContainer(ColumnOf(k)),
      args: [cs],
      uses: { takes: [false], owned: false, fails: false, stops: false },
    }),
    at,
  )

/// `Bytes::position(b, from, f)`, a loop in the body rather than the runtime's call, since `f` may
/// stop for a handler its effects reach and a native's frame cannot resume: the first index found,
/// `-1` where none is, made the `Option` it answers, `Some` of it or `None`. Reads `b` and `f`.
fn positioned(cx: Context, st: Lowering, args: List<Arg>, at: Span) -> Lowered =
  match args {
    [b, from, f] -> {
      let bw = handed({ st: st, arg: b }, RWord, at);
      let fr = handed({ st: bw.st, arg: from }, RInt, at);
      let fw = handed({ st: fr.st, arg: f }, RWord, at);
      let ty = option_type(int_type());
      let index = bound_as(
        fw.st,
        int_type(),
        RInt,
        Op({
          op: OContainer(Position),
          args: [bw.arg, fr.arg, fw.arg],
          uses: { takes: [false, false, false], owned: true, fails: true, stops: true },
        }),
        at,
      );
      let found = bound_as(
        index.st,
        bool_type(),
        RBool,
        Prim({ op: b"ge", on: RInt, args: [index.arg, AInt(0)] }),
        at,
      );
      let some = constructed_as(cx, opened(found.st), prelude_ctor(b"Some"), [index.arg], ty, at);
      let none = constructed_as(
        cx,
        opened(continued(found.st, some.st)),
        prelude_ctor(b"None"),
        [],
        ty,
        at,
      );
      base::joined(cx, found, some, none, false, at)
    },
    _ -> refuse(st, Containers, b"a byte string's position on other operands than three"),
  }

/// `bracket(acquire, release, body)`, or a hold's region, which is one: the runtime's
/// `rt_with_cleanup`, which takes the three closures and counts what it holds across their calls
/// by the types of what `acquire` and `body` answer.
fn bracketed(cx: Context, st: Lowering, args: List<Arg>, at: Span) -> Lowered / {abort.raise} =
  match args {
    [acquire, release, body] -> match ((type_of(acquire), type_of(body))) {
      (TyFn(a), TyFn(b)) -> {
        let aw = handed({ st: st, arg: acquire }, RWord, at);
        let bw = handed({ st: aw.st, arg: body }, RWord, at);
        let rw = handed({ st: bw.st, arg: release }, RWord, at);
        let held = type_described(cx, rw.st, a.ret, at);
        let answer = type_described(cx, held.st, b.ret, at);
        let ran = bound_as(
          answer.st,
          b.ret,
          RWord,
          Native({
            name: b"rt_with_cleanup_p",
            args: [aw.arg, bw.arg, rw.arg, held.arg, answer.arg],
            uses: {
              takes: [true, true, true, false, false],
              owned: true,
              fails: true,
              stops: true,
            },
          }),
          at,
        );
        handed(ran, held_as(cx.setting, b.ret), at)
      },
      _ -> refuse(st, Containers, b"a bracket over other than functions"),
    },
    _ -> refuse(st, Containers, b"a bracket on other operands than three"),
  }

/// The builtins `scalars` lowers: those the emitter writes at the type of a scalar it was called at,
/// or per type (order, show, digest, reflection).
pub fn scalar_builtin(name: Bytes) -> Bool =
  [
      b"reflect",
      b"shown",
      b"digest",
      b"?encoded",
      b"?same",
      b"compare",
      b"min",
      b"max",
      b"compare_values",
      b"wrap_add",
      b"wrap_sub",
      b"wrap_mul",
      b"rotr",
      b"rotl",
      b"saturating_add",
      b"saturating_sub",
      b"saturating_mul",
      b"checked_add",
      b"checked_sub",
      b"checked_mul",
      b"checked_neg",
      b"U8::of_int",
      b"U16::of_int",
      b"U32::of_int",
      b"U64::of_int",
      b"I8::of_int",
      b"I16::of_int",
      b"I32::of_int",
      b"I64::of_int",
      b"U128::of_int",
      b"I128::of_int",
      b"Int::of_u8",
      b"Int::of_u16",
      b"Int::of_u32",
      b"Int::of_u64",
      b"Int::of_i8",
      b"Int::of_i16",
      b"Int::of_i32",
      b"Int::of_i64",
      b"Int::of_u128",
      b"Int::of_i128",
      b"Float::of_int",
      b"Float::of_bits",
      b"bits_of_float",
      b"?stated_witness",
    ].contains(
      name,
    )
    || float_function(name) != None
    || decimal_conversion(name)

/// The builtin a call of `name` reaches: a name no import holds a definition of, as its own name
/// where an import names an extern the runtime implements; nothing where an import names what is
/// neither.
fn resolved(cx: Context, name: Bytes) -> Option<Bytes> =
  match imported_target(cx.setting.imports, name) {
    None -> Some(generated_builtin(name)),
    Some(t) -> if t.imp.defs.any(|d: Def| d.name == t.name)
        || !cx.setting.builtins.contains(t.name) { None }
    else { Some(t.name) },
  }

/// What the emitter writes in place of a call of `name`: an extern the module, or one it imports,
/// declares under a program-wide name `layout.intrinsics` lists.
fn intrinsic_at(cx: Context, name: Bytes) -> Option<Intrinsic> =
  intrinsic_named(match qualified(name) {
    Some(q) -> match module_import(cx.setting.imports, q.binder) {
      Some(imp) -> qualify(imp.module, q.name),
      None -> qualify(cx.setting.module, name),
    },
    None -> match from_import(cx.setting.imports, name) {
      Some(imp) -> qualify(imp.module, name),
      None -> qualify(cx.setting.module, name),
    },
  })
