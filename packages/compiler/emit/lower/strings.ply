                                        concatenated)

pub fn string_builtin(name: Bytes) -> Bool = string_builtins().contains(name)

fn string_builtins() -> List<Bytes> =
  [
    b"String::concat",
    b"Bytes::concat",
    b"Bytes::at",
    b"Bytes::u32_le",
    b"range",
    b"String::split",
    b"Bytes::split",
    b"String::chars",
    b"String::of_chars",
    b"Char::of_int",
    b"Int::of_char",
    b"Bytes::concat_all",
    b"Bytes::slice",
    b"Bytes::of_string",
    b"Bytes::starts_with",
    b"Bytes::ends_with",
    b"Bytes::index_of",
    b"Bytes::index_of_from",
    b"Bytes::index_of_byte",
    b"Bytes::scan",
    b"Bytes::scan_until",
    b"Bytes::blake3",
    b"byte_of_int",
    b"String::len",
    b"String::slice",
    b"String::starts_with",
    b"String::ends_with",
    b"String::contains",
    b"String::find",
    b"Decimal::bits",
    b"Decimal::of_bits",
    b"Secret::of_string",
    b"Secret::of_bytes",
    b"Secret::verify",
    b"Secret::is_empty",
    b"Secret::len",
    b"Secret::bytes",
    b"Secret::concat",
    b"assert",
  ].concat(
    secret_derivations(),
  )

pub fn string_builtin_call(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let c = { context: context, name: name, at: at };
  let named = if name.starts_with(b"String::") { string_type() } else { bytes_type() };
  let ty = match callee.ty {
    FunctionType(f) -> if f.return_type == string_type() || f.return_type == bytes_type() {
      f.return_type
    } else { named },
    _ -> named,
  };
  if secret_operation(name) { secret_basic_call(c, st, args) }
  else if secret_derivations().contains(name) { secret_derived(c, st, args) } else {
    match args {
      [a, b] -> if name == b"String::concat" || name == b"Bytes::concat" {
        concatenated(c.context, st, a, b, ty, c.at)
      } else if name == b"Bytes::starts_with" || name == b"String::starts_with" {
        starts_or_ends_with(c, st, a, b, true)
      } else if name == b"Bytes::ends_with" || name == b"String::ends_with" {
        starts_or_ends_with(c, st, a, b, false)
      } else if name == b"String::contains" {
        let f = first_occurrence(st, a, b, IntOperand(0), at);
        compared(f.st, b"ge", f.arg, IntOperand(0), at)
      } else if name == b"Bytes::index_of" {
        position(context, first_occurrence(st, a, b, IntOperand(0), at), at)
      } else if name == b"Bytes::index_of_byte" { index_of_byte(c, st, a, b) }
      else if name == b"String::find" { string_find(c, st, a, b) }
      else if name == b"Secret::verify" { secret_verify(c, st, a, b) }
      else if name == b"Bytes::at" { byte_read(c, st, a, b, false) }
      else if name == b"Bytes::u32_le" { byte_read(c, st, a, b, true) }
      else if name == b"range" { range_builtin(c, st, a, b) }
      else if name == b"String::split" || name == b"Bytes::split" { split(c, st, a, b, ty) }
      else if name == b"assert" { asserted(c, st, a, b) }
      else if name == b"Decimal::of_bits" { decimal_of_bits(c, st, a, b) }
      else { unreachable(b"unknown string builtin taking two arguments: ".concat(name)) },
      [a, b, x] -> if name == b"Bytes::slice" { byte_slice(c, st, a, b, x, ty) }
      else if name == b"String::slice" { char_slice(c, st, a, b, x) }
      else if name == b"Bytes::index_of_from" { index_of(c, st, a, b, x) }
      else { unreachable(b"unknown string builtin taking three arguments: ".concat(name)) },
      [h, from, class, budget] ->
        scanned(c, st, h, from, class, budget, name == b"Bytes::scan_until"),
      [a] -> unary_builtin(c, st, a),
      _ ->
        unreachable(
          b"unknown string builtin taking an unsupported number of arguments: ".concat(name),
        ),
    }
  }
}

type BuiltinCall = { context: Context, name: Bytes, at: Span }

fn unary_builtin(c: BuiltinCall, st: Lowering, a: Arg) -> LoweredValue / {abort.raise} = {
  let n = c.name;
  let at = c.at;
  if n == b"Bytes::of_string" { recast(st, a, bytes_type(), at) } else if n == b"String::chars" {
    let e = empty_list(c, st, char_type());
    generated_string_call(c, e.st, b"chars_from", string_type(), [a, IntOperand(0), e.arg])
  } else if n == b"Char::of_int" {
    let x = represented_as({ st: st, arg: a }, AsInt, at);
    let k = bound_as(
      x.st,
      int_type(),
      AsInt,
      Primitive({ operation: b"scalar_value", on: AsInt, args: [x.arg] }),
      at,
    );
    option_if_nonnegative(
      c.context,
      k,
      char_type(),
      |s: Lowering|
        bound_as(
          s,
          char_type(),
          AsImmediate,
          Primitive({ operation: b"char_of", on: AsInt, args: [k.arg] }),
          at,
        ),
      at,
    )
  } else if n == b"Int::of_char" {
    let x = represented_as({ st: st, arg: a }, AsImmediate, at);
    bound_as(
      x.st,
      int_type(),
      AsInt,
      Primitive({ operation: b"char_code", on: AsImmediate, args: [x.arg] }),
      at,
    )
  } else if n == b"String::of_chars" {
    let e = bound_string_operation(st, string_type(), AsWord, AllocateBytes, [IntOperand(0)], at);
    generated_string_call(c, e.st, b"of_chars_from", list_type(char_type()), [
      a,
      IntOperand(0),
      e.arg,
    ])
  } else if n == b"Bytes::concat_all" {
    let e = bound_string_operation(st, bytes_type(), AsWord, AllocateBytes, [IntOperand(0)], at);
    generated_string_call(c, e.st, b"concat_all_from", list_type(bytes_type()), [
      a,
      IntOperand(0),
      e.arg,
    ])
  } else if n == b"String::len" {
    let t = bytes_address(st, a, at);
    int_operation(t.st, CharCount, [t.address, t.count], at)
  } else if n == b"Bytes::blake3" { blake3_of(st, a, at) }
  else { unary_conversion(c, st, a) }
}

fn unary_conversion(c: BuiltinCall, st: Lowering, a: Arg) -> LoweredValue / {abort.raise} = {
  let n = c.name;
  let at = c.at;
  if n == b"Decimal::bits" {
    let w = pair_words(st, a, AsDecimal, at);
    let ty = RecordType([{ name: b"_0", ty: int_type() }, { name: b"_1", ty: int_type() }]);
    bound_as(
      w.st,
      ty,
      AsFlattened([{ name: b"_0", representation: AsInt }, { name: b"_1", representation: AsInt }]),
      Aggregate({ parts: [w.lo, w.hi] }),
      at,
    )
  } else if n == b"Secret::of_string" || n == b"Secret::of_bytes" {
    let t = bytes_address(st, a, at);
    let text = IntOperand(if n == b"Secret::of_string" { 1 } else { 0 });
    let secret = secret_type(if n == b"Secret::of_string" { string_type() } else { bytes_type() });
    let h = bound_as(
      t.st,
      secret,
      AsWord,
      Native({
        name: native_of(b"?secret_of"),
        args: [t.address, t.count, text],
        uses: { takes: [false, false, false], owned: true, fails: false, suspends: false },
      }),
      at,
    );
    represented_as(h, representation_of(c.context.setting, secret), at)
  } else if n == b"byte_of_int" {
    let i = represented_as({ st: st, arg: a }, AsInt, at);
    let lo = compared(i.st, b"ge", i.arg, IntOperand(0), at);
    let hi = compared(enter_block(lo.st), b"le", i.arg, IntOperand(255), at);
    let ok = short_circuit(c.context, lo, hi, true, at);
    let unary_builtin = bound_as(
      enter_block(ok.st),
      bytes_type(),
      AsWord,
      Native({
        name: b"ply_byte_text",
        args: [i.arg],
        uses: { takes: [false], owned: true, fails: false, suspends: false },
      }),
      at,
    );
    failing_else(
      c,
      ok,
      represented_as(unary_builtin, representation_of(c.context.setting, bytes_type()), at),
      |r: Lowering| raise_rejection(c, r, [i.arg]),
    )
  } else { unreachable(b"unknown string builtin taking one argument: ".concat(n)) }
}

fn range_builtin(c: BuiltinCall, st: Lowering, lo: Arg, hi: Arg) -> LoweredValue / {abort.raise} =
  range_guarded(c.context, st, lo, hi, c.at, |s: Lowering, l: Arg, h: Arg| {
    let e = empty_list(c, s, int_type());
    generated_string_call(c, e.st, b"range_from", list_type(int_type()), [l, h, e.arg])
  })

pub fn range_guarded(
  context: Context,
  st: Lowering,
  lo: Arg,
  hi: Arg,
  at: Span,
  then: (Lowering, Arg, Arg) -> LoweredValue / {abort.raise},
) -> LoweredValue / {abort.raise} = {
  let c = { context: context, name: b"range", at: at };
  let l = represented_as({ st: st, arg: lo }, AsInt, at);
  let h = represented_as({ st: l.st, arg: hi }, AsInt, at);
  let most = range_limit();
  let top = compared(h.st, b"gt", l.arg, IntOperand(9223372036854775807 - most), at);
  let reach = arithmetic(enter_block(top.st), b"add", l.arg, IntOperand(most), at);
  let near = compared(reach.st, b"le", h.arg, reach.arg, at);
  let ok = short_circuit(context, top, near, false, at);
  failing_else(c, ok, then(enter_block(ok.st), l.arg, h.arg), |r: Lowering|
    raise_rejection(c, r, [l.arg, h.arg]))
}

fn split(c: BuiltinCall, st: Lowering, s: Arg, sep: Arg, ty: Type) -> LoweredValue / {abort.raise} = {
  let y = bytes_address(st, sep, c.at);
  let ok = compared(y.st, b"gt", y.count, IntOperand(0), c.at);
  let e = empty_list(c, enter_block(ok.st), ty);
  failing_else(
    c,
    ok,
    generated_string_call(c, e.st, b"split_from", ty, [s, sep, IntOperand(0), e.arg]),
    |r: Lowering| raise_rejection(c, r, []),
  )
}

fn empty_list(c: BuiltinCall, st: Lowering, item: Type) -> LoweredValue = {
  let ty = list_type(item);
  bound_as(
    st,
    ty,
    representation_of(c.context.setting, ty),
    Allocate({ made: ListAllocation(0), args: [], reuse: None }),
    c.at,
  )
}

fn generated_string_call(
  c: BuiltinCall,
  st: Lowering,
  operation: Bytes,
  t: Type,
  args: List<Arg>,
) -> LoweredValue = {
  let typed = string_root_signature(operation, t);
  let conv = typed_convention(
    c.context.setting.constructors,
    typed.params.map(|p: { name: Bytes, ty: Type }| p.ty),
    typed.result_type,
  );
  let reps = reps_of(conv);
  let given = range(0, args.len()).fold(
    { st: st, args: [] },
    |accumulator: { st: Lowering, args: List<Arg> }, i: Int|
      match ((args.at(i), reps.at(i))) {
        (Some(a), Some(r)) -> {
          let h = represented_as({ st: accumulator.st, arg: a }, r, c.at);
          { st: h.st, args: accumulator.args.push(h.arg) }
        },
        _ -> accumulator,
      },
  );
  bound_as(
    given.st,
    typed.result_type,
    conv.result,
    Call({
      callee: Root(keys::generated_key(ContainerWalk(operation), t, c.context.setting.module)),
      args: given.args,
      convention: conv,
      suspends: false,
    }),
    c.at,
  )
}

fn starts_or_ends_with(
  c: BuiltinCall,
  st: Lowering,
  a: Arg,
  b: Arg,
  start: Bool,
) -> LoweredValue / {abort.raise} = {
  let x = bytes_address(st, a, c.at);
  let y = bytes_address(x.st, b, c.at);
  let fits = compared(y.st, b"le", y.count, x.count, c.at);
  let from = if start { { st: enter_block(fits.st), arg: IntOperand(0) } }
  else { arithmetic(enter_block(fits.st), b"sub", x.count, y.count, c.at) };
  let same = bound_string_operation(
    from.st,
    bool_type(),
    AsBool,
    BytesEqual,
    [x.address, from.arg, y.address, IntOperand(0), y.count],
    c.at,
  );
  short_circuit(c.context, fits, same, true, c.at)
}

fn first_occurrence(
  st: Lowering,
  a: Arg,
  b: Arg,
  from: Arg,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let x = bytes_address(st, a, at);
  let y = bytes_address(x.st, b, at);
  let f = represented_as({ st: y.st, arg: from }, AsInt, at);
  int_operation(f.st, FindBytes, [x.address, x.count, y.address, y.count, f.arg], at)
}

fn index_of(
  c: BuiltinCall,
  st: Lowering,
  a: Arg,
  b: Arg,
  from: Arg,
) -> LoweredValue / {abort.raise} = {
  let x = bytes_address(st, a, c.at);
  let f = represented_as({ st: x.st, arg: from }, AsInt, c.at);
  let lo = compared(f.st, b"ge", f.arg, IntOperand(0), c.at);
  let hi = compared(enter_block(lo.st), b"le", f.arg, x.count, c.at);
  let ok = short_circuit(c.context, lo, hi, true, c.at);
  let offset = first_occurrence(enter_block(ok.st), a, b, f.arg, c.at);
  failing_else(c, ok, position(c.context, offset, c.at), |r: Lowering|
    raise_rejection(c, r, [f.arg, x.count]))
}

fn index_of_byte(c: BuiltinCall, st: Lowering, a: Arg, byte: Arg) -> LoweredValue / {abort.raise} = {
  let i = represented_as({ st: st, arg: byte }, AsInt, c.at);
  let lo = compared(i.st, b"ge", i.arg, IntOperand(0), c.at);
  let hi = compared(enter_block(lo.st), b"le", i.arg, IntOperand(255), c.at);
  let ok = short_circuit(c.context, lo, hi, true, c.at);
  let unary_builtin = bound_string_operation(
    enter_block(ok.st),
    bytes_type(),
    AsWord,
    AllocateBytes,
    [IntOperand(1)],
    c.at,
  );
  let set = string_operation_for_effect(
    unary_builtin.st,
    ByteSet,
    [unary_builtin.arg, IntOperand(0), i.arg],
    c.at,
  );
  let f = first_occurrence(set, a, unary_builtin.arg, IntOperand(0), c.at);
  failing_else(c, ok, position(c.context, f, c.at), |r: Lowering| raise_rejection(c, r, [i.arg]))
}

fn position(context: Context, l: LoweredValue, at: Span) -> LoweredValue / {abort.raise} =
  option_if_nonnegative(context, l, int_type(), |s: Lowering| { st: s, arg: l.arg }, at)

fn string_find(c: BuiltinCall, st: Lowering, a: Arg, b: Arg) -> LoweredValue / {abort.raise} = {
  let x = bytes_address(st, a, c.at);
  let y = bytes_address(x.st, b, c.at);
  let f = int_operation(
    y.st,
    FindBytes,
    [x.address, x.count, y.address, y.count, IntOperand(0)],
    c.at,
  );
  let ok = compared(f.st, b"ge", f.arg, IntOperand(0), c.at);
  failing_else(
    c,
    ok,
    int_operation(enter_block(ok.st), CharCount, [x.address, f.arg], c.at),
    |r: Lowering| rejected_text(c, r, [x.address, x.count, y.address, y.count]),
  )
}

fn byte_slice(
  c: BuiltinCall,
  st: Lowering,
  a: Arg,
  s: Arg,
  e: Arg,
  ty: Type,
) -> LoweredValue / {abort.raise} = {
  let x = bytes_address(st, a, c.at);
  let from = represented_as({ st: x.st, arg: s }, AsInt, c.at);
  let to = represented_as({ st: from.st, arg: e }, AsInt, c.at);
  let ok = within(c.context, to.st, from.arg, to.arg, x.count, c.at);
  let n = arithmetic(enter_block(ok.st), b"sub", to.arg, from.arg, c.at);
  failing_else(c, ok, copied_out(n.st, ty, x.address, from.arg, n.arg, c.at), |r: Lowering|
    raise_rejection(c, r, [from.arg, to.arg, x.count]))
}

fn char_slice(
  c: BuiltinCall,
  st: Lowering,
  a: Arg,
  s: Arg,
  e: Arg,
) -> LoweredValue / {abort.raise} = {
  let x = bytes_address(st, a, c.at);
  let from = represented_as({ st: x.st, arg: s }, AsInt, c.at);
  let to = represented_as({ st: from.st, arg: e }, AsInt, c.at);
  let b0 = int_operation(to.st, CharStart, [x.address, x.count, from.arg], c.at);
  let b1 = int_operation(b0.st, CharStart, [x.address, x.count, to.arg], c.at);
  let lo = compared(b1.st, b"ge", b0.arg, IntOperand(0), c.at);
  let le = compared(enter_block(lo.st), b"le", b0.arg, b1.arg, c.at);
  let ok = short_circuit(c.context, lo, le, true, c.at);
  let n = arithmetic(enter_block(ok.st), b"sub", b1.arg, b0.arg, c.at);
  failing_else(
    c,
    ok,
    copied_out(n.st, string_type(), x.address, b0.arg, n.arg, c.at),
    |r: Lowering| {
      let chars = int_operation(r, CharCount, [x.address, x.count], c.at);
      raise_rejection(c, chars.st, [from.arg, to.arg, chars.arg])
    },
  )
}

fn byte_read(
  c: BuiltinCall,
  st: Lowering,
  a: Arg,
  i: Arg,
  four: Bool,
) -> LoweredValue / {abort.raise} = {
  let x = bytes_address(st, a, c.at);
  let k = represented_as({ st: x.st, arg: i }, AsInt, c.at);
  let last = if four { arithmetic(k.st, b"sub", x.count, IntOperand(4), c.at) }
  else { arithmetic(k.st, b"sub", x.count, IntOperand(1), c.at) };
  let lo = compared(last.st, b"ge", k.arg, IntOperand(0), c.at);
  let hi = compared(enter_block(lo.st), b"le", k.arg, last.arg, c.at);
  let ok = short_circuit(c.context, lo, hi, true, c.at);
  let read = if four {
    bound_string_operation(
      enter_block(ok.st),
      width_type({ bits: 32, signed: false }),
      AsFixed({ bits: 32, signed: false }),
      U32Read,
      [x.address, k.arg],
      c.at,
    )
  } else { int_operation(enter_block(ok.st), ByteRead, [x.address, k.arg], c.at) };
  failing_else(c, ok, read, |r: Lowering| raise_rejection(c, r, [k.arg, x.count]))
}

fn within(context: Context, st: Lowering, s: Arg, e: Arg, n: Arg, at: Span) -> LoweredValue = {
  let a = compared(st, b"ge", s, IntOperand(0), at);
  let b = compared(enter_block(a.st), b"le", s, e, at);
  let ab = short_circuit(context, a, b, true, at);
  let d = compared(enter_block(ab.st), b"le", e, n, at);
  short_circuit(context, ab, d, true, at)
}

fn scanned(
  c: BuiltinCall,
  st: Lowering,
  h: Arg,
  from: Arg,
  class: Arg,
  budget: Arg,
  until: Bool,
) -> LoweredValue / {abort.raise} = {
  let x = bytes_address(st, h, c.at);
  let f = represented_as({ st: x.st, arg: from }, AsInt, c.at);
  let b = represented_as({ st: f.st, arg: budget }, AsInt, c.at);
  let ok = within(c.context, b.st, IntOperand(0), f.arg, x.count, c.at);
  let positive = compared(enter_block(ok.st), b"ge", b.arg, IntOperand(0), c.at);
  let both = short_circuit(c.context, ok, positive, true, c.at);
  let k = bytes_address(enter_block(both.st), class, c.at);
  failing_else(
    c,
    both,
    int_operation(
      k.st,
      ScanBytes({ until: until }),
      [x.address, x.count, f.arg, k.address, k.count, b.arg],
      c.at,
    ),
    |r: Lowering| raise_rejection(c, r, [f.arg, x.count, b.arg]),
  )
}

fn secret_operation(name: Bytes) -> Bool =
  name == b"Secret::len" || name == b"Secret::is_empty" || name == b"Secret::bytes"
    || name == b"Secret::concat"

fn secret_basic_call(
  c: BuiltinCall,
  st: Lowering,
  args: List<Arg>,
) -> LoweredValue / {abort.raise} = {
  let h = args.fold(
    { st: st, words: [] },
    |accumulator: { st: Lowering, words: List<Arg> }, a: Arg| {
      let w = represented_as({ st: accumulator.st, arg: a }, AsWord, c.at);
      { st: w.st, words: accumulator.words.push(w.arg) }
    },
  );
  if c.name == b"Secret::len" { native_int(h.st, b"?secret_len", h.words, c.at) }
  else if c.name == b"Secret::is_empty" {
    let n = native_int(h.st, b"?secret_len", h.words, c.at);
    compared(n.st, b"eq", n.arg, IntOperand(0), c.at)
  } else {
    let secret = secret_type(bytes_type());
    let made = bound_as(
      h.st,
      secret,
      AsWord,
      Native({
        name: native_of(if c.name == b"Secret::bytes" { b"?secret_bytes" }
        else { b"?secret_concat" }),
        args: h.words,
        uses: { takes: h.words.map(|_: Arg| false), owned: true, fails: false, suspends: false },
      }),
      c.at,
    );
    represented_as(made, representation_of(c.context.setting, secret), c.at)
  }
}

fn secret_verify(c: BuiltinCall, st: Lowering, s: Arg, a: Arg) -> LoweredValue / {abort.raise} = {
  let h = represented_as({ st: st, arg: s }, AsWord, c.at);
  let t = bytes_address(h.st, a, c.at);
  let v = native_int(t.st, b"?secret_verify", [h.arg, t.address, t.count], c.at);
  compared(v.st, b"ne", v.arg, IntOperand(0), c.at)
}

fn secret_derivations() -> List<Bytes> =
  [
    b"Secret::decode",
    b"Secret::encode",
    b"Secret::private_key",
    b"Secret::rsa_jwk",
    b"Secret::hmac",
    b"Secret::hkdf_extract",
    b"Secret::hkdf_expand",
    b"Secret::pbkdf2",
  ]

fn secret_derived(c: BuiltinCall, st: Lowering, args: List<Arg>) -> LoweredValue / {abort.raise} = {
  let n = c.name;
  match args {
    [der] -> if n == b"Secret::private_key" { private_key_read(c, st, der) }
    else { unreachable(b"unknown `Secret::` builtin taking one argument: ".concat(n)) },
    [a, b] -> if n == b"Secret::decode" { secret_decoded(c, st, a, b) }
    else if n == b"Secret::encode" { secret_encoded(c, st, a, b) }
    else { unreachable(b"unknown `Secret::` builtin taking two arguments: ".concat(n)) },
    [a, b, x] -> if n == b"Secret::hmac" { secret_hmac(c, st, a, b, x) }
    else if n == b"Secret::hkdf_extract" { hkdf_extracted(c, st, a, b, x) }
    else if n == b"Secret::rsa_jwk" { secret_rsa_jwk(c, st, a, b, x) }
    else { unreachable(b"unknown `Secret::` builtin taking three arguments: ".concat(n)) },
    [hash, key, info, length] -> hkdf_expanded(c, st, hash, key, info, length),
    [hash, password, salt, iterations, length] ->
      pbkdf2_derived(c, st, hash, password, salt, iterations, length),
    _ ->
      unreachable(
        b"unknown `Secret::` builtin taking an unsupported number of arguments: ".concat(n),
      ),
  }
}

fn secret_of(of: Type) -> Type = secret_type(of)

fn new_secret(
  c: BuiltinCall,
  st: Lowering,
  native: Bytes,
  args: List<Arg>,
  of: Type,
) -> LoweredValue / {abort.raise} = {
  let secret = secret_of(of);
  let made = bound_as(
    st,
    secret,
    AsWord,
    Native({
      name: native_of(native),
      args: args,
      uses: { takes: args.map(|_: Arg| false), owned: true, fails: false, suspends: false },
    }),
    c.at,
  );
  represented_as(made, representation_of(c.context.setting, secret), c.at)
}

fn nonempty_secret(c: BuiltinCall, made: LoweredValue) -> LoweredValue / {abort.raise} = {
  let n = native_int(made.st, b"?secret_len", [made.arg], c.at);
  let k = arithmetic(n.st, b"sub", n.arg, IntOperand(1), c.at);
  option_if_nonnegative(
    c.context,
    k,
    secret_of(bytes_type()),
    |r: Lowering| { st: r, arg: made.arg },
    c.at,
  )
}

fn secret_decoded(
  c: BuiltinCall,
  st: Lowering,
  encoding: Arg,
  text: Arg,
) -> LoweredValue / {abort.raise} = {
  let e = bytes_address(st, encoding, c.at);
  let t = represented_as({ st: e.st, arg: text }, AsWord, c.at);
  let s = native_int(t.st, b"?secret_decodes", [e.address, e.count, t.arg], c.at);
  let reads = compared(s.st, b"ge", s.arg, IntOperand(0 - 1), c.at);
  failing_else(
    c,
    reads,
    option_if_nonnegative(
      c.context,
      { st: enter_block(reads.st), arg: s.arg },
      secret_of(bytes_type()),
      |r: Lowering| new_secret(c, r, b"?secret_decoded", [e.address, e.count, t.arg], bytes_type()),
      c.at,
    ),
    |r: Lowering| rejected_text(c, r, [e.address, e.count]),
  )
}

fn secret_encoded(
  c: BuiltinCall,
  st: Lowering,
  encoding: Arg,
  bytes: Arg,
) -> LoweredValue / {abort.raise} = {
  let e = bytes_address(st, encoding, c.at);
  let b = represented_as({ st: e.st, arg: bytes }, AsWord, c.at);
  let w = native_int(b.st, b"?secret_encodes", [e.address, e.count], c.at);
  let writes = compared(w.st, b"ne", w.arg, IntOperand(0), c.at);
  failing_else(
    c,
    writes,
    new_secret(
      c,
      enter_block(writes.st),
      b"?secret_encoded",
      [e.address, e.count, b.arg],
      string_type(),
    ),
    |r: Lowering| rejected_text(c, r, [e.address, e.count]),
  )
}

fn private_key_read(c: BuiltinCall, st: Lowering, der: Arg) -> LoweredValue / {abort.raise} = {
  let d = represented_as({ st: st, arg: der }, AsWord, c.at);
  let n = native_int(d.st, b"?secret_key_scheme", [d.arg], c.at);
  let key = secret_of(bytes_type());
  let first_occurrence = RecordType([
    { name: b"key", ty: key },
    { name: b"scheme", ty: string_type() },
  ]);
  option_if_nonnegative(
    c.context,
    n,
    first_occurrence,
    |r: Lowering| {
      let scheme = taken_out(r, n.arg, string_type(), c.at);
      let s = bytes_address(scheme.st, scheme.arg, c.at);
      let k = new_secret(c, s.st, b"?secret_key", [d.arg, s.address, s.count], bytes_type());
      record_literal_as(
        c.context,
        k.st,
        [{ name: b"key", arg: k.arg }, { name: b"scheme", arg: scheme.arg }],
        first_occurrence,
        c.at,
      )
    },
    c.at,
  )
}

fn secret_rsa_jwk(
  c: BuiltinCall,
  st: Lowering,
  n: Arg,
  e: Arg,
  private: Arg,
) -> LoweredValue / {abort.raise} = {
  let xs = represented_as({ st: st, arg: private }, AsWord, c.at);
  let count = bound_as(
    xs.st,
    int_type(),
    AsInt,
    OperationCall({
      operation: OfContainers(Length),
      args: [xs.arg],
      uses: { takes: [false], owned: false, fails: false, suspends: false },
    }),
    c.at,
  );
  let six = compared(count.st, b"eq", count.arg, IntOperand(6), c.at);
  let texts = list_type(secret_of(string_type()));
  let none = new_secret(
    c,
    enter_block(six.st),
    b"?secret_of",
    [IntOperand(0), IntOperand(0), IntOperand(0)],
    bytes_type(),
  );
  let joined = generated_string_call(c, none.st, b"jwk_from", texts, [
    xs.arg,
    IntOperand(0),
    none.arg,
  ]);
  let ns = bytes_address(joined.st, n, c.at);
  let es = bytes_address(ns.st, e, c.at);
  failing_else(
    c,
    six,
    nonempty_secret(
      c,
      new_secret(
        c,
        es.st,
        b"?secret_rsa_jwk",
        [ns.address, ns.count, es.address, es.count, joined.arg],
        bytes_type(),
      ),
    ),
    |r: Lowering| raise_rejection(c, r, [count.arg]),
  )
}

fn secret_hmac(
  c: BuiltinCall,
  st: Lowering,
  hash: Arg,
  key: Arg,
  message: Arg,
) -> LoweredValue / {abort.raise} = {
  let h = bytes_address(st, hash, c.at);
  let k = represented_as({ st: h.st, arg: key }, AsWord, c.at);
  let m = bytes_address(k.st, message, c.at);
  let n = native_int(m.st, b"?secret_hmac", [h.address, h.count, k.arg, m.address, m.count], c.at);
  option_if_nonnegative(
    c.context,
    n,
    bytes_type(),
    |r: Lowering| taken_out(r, n.arg, bytes_type(), c.at),
    c.at,
  )
}

fn hkdf_extracted(
  c: BuiltinCall,
  st: Lowering,
  hash: Arg,
  salt: Arg,
  key: Arg,
) -> LoweredValue / {abort.raise} = {
  let h = bytes_address(st, hash, c.at);
  let s = bytes_address(h.st, salt, c.at);
  let k = represented_as({ st: s.st, arg: key }, AsWord, c.at);
  nonempty_secret(
    c,
    new_secret(
      c,
      k.st,
      b"?secret_hkdf_extract",
      [h.address, h.count, s.address, s.count, k.arg],
      bytes_type(),
    ),
  )
}

fn hkdf_expanded(
  c: BuiltinCall,
  st: Lowering,
  hash: Arg,
  key: Arg,
  info: Arg,
  length: Arg,
) -> LoweredValue / {abort.raise} = {
  let h = bytes_address(st, hash, c.at);
  let k = represented_as({ st: h.st, arg: key }, AsWord, c.at);
  let i = bytes_address(k.st, info, c.at);
  let l = represented_as({ st: i.st, arg: length }, AsInt, c.at);
  let s = native_int(l.st, b"?secret_hkdf_expands", [h.address, h.count, l.arg], c.at);
  option_if_nonnegative(
    c.context,
    s,
    secret_of(bytes_type()),
    |r: Lowering|
      new_secret(
        c,
        r,
        b"?secret_hkdf_expand",
        [h.address, h.count, k.arg, i.address, i.count, l.arg],
        bytes_type(),
      ),
    c.at,
  )
}

fn pbkdf2_derived(
  c: BuiltinCall,
  st: Lowering,
  hash: Arg,
  password: Arg,
  salt: Arg,
  iterations: Arg,
  length: Arg,
) -> LoweredValue / {abort.raise} = {
  let h = bytes_address(st, hash, c.at);
  let p = represented_as({ st: h.st, arg: password }, AsWord, c.at);
  let s = bytes_address(p.st, salt, c.at);
  let it = represented_as({ st: s.st, arg: iterations }, AsInt, c.at);
  let l = represented_as({ st: it.st, arg: length }, AsInt, c.at);
  nonempty_secret(
    c,
    new_secret(
      c,
      l.st,
      b"?secret_pbkdf2",
      [h.address, h.count, p.arg, s.address, s.count, it.arg, l.arg],
      bytes_type(),
    ),
  )
}

fn asserted(c: BuiltinCall, st: Lowering, cond: Arg, message: Arg) -> LoweredValue / {abort.raise} = {
  let b = represented_as({ st: st, arg: cond }, AsBool, c.at);
  let raise_rejection = assert_failure(c, enter_block(b.st), message);
  literal(
    c.context,
    {
      ..exit_block(b.st, raise_rejection),
      instructions: b.st.instructions.push(
        If({ cond: b.arg, then: [], otherwise: raise_rejection.instructions }),
      ),
    },
    LiteralUnit,
    c.at,
  )
}

fn assert_failure(c: BuiltinCall, st: Lowering, m: Arg) -> Lowering / {abort.raise} = {
  let untold = |r: Lowering| rejected_text(c, r, [IntOperand(0), IntOperand(0 - 1)]);
  let setting = c.context.setting;
  let o = option_type(string_type());
  let full = some_constructor();
  match m {
    VariableOperand(given) -> match constructor_sum(setting, full) {
      None -> untold(st),
      Some(sum) -> {
        let message_option = represented_as(
          { st: st, arg: VariableOperand({ ..given, ty: o }) },
          representation_of(setting, o),
          c.at,
        );
        match message_read(c.context, message_option, full, sum.index) {
          None -> unreachable(b"an `assert` message is stored as a type other than `Option`"),
          Some(r) -> {
            let text = bound_as(
              enter_block(r.st),
              string_type(),
              AsWord,
              Get({ of: r.of, path: r.path }),
              c.at,
            );
            let t = bytes_address(text.st, text.arg, c.at);
            let text_failure = rejected_text(c, t.st, [t.address, t.count]);
            let none = untold(enter_block(exit_block(r.st, text_failure)));
            {
              ..exit_block(r.st, none),
              instructions: r.st.instructions.push(
                Case({
                  on: r.of,
                  test: TagTest(sum.constructors.map(|x: SumConstructor| x.name)),
                  arms: [{ when: sum.index, body: text_failure.instructions }],
                  rest: none.instructions,
                }),
              ),
            }
          },
        }
      },
    },
    _ -> untold(st),
  }
}

fn message_read(
  context: Context,
  l: LoweredValue,
  full: Bytes,
  index: Int,
) -> Option<{ st: Lowering, of: Variable, path: Path }> =
  match l.arg {
    VariableOperand(v) -> match v.representation {
      AsSum(x) -> match case_index(v.representation, full) {
        Some(i) -> match case_argument_offset(x.layout, i, 0) {
          Some(w) -> Some({ st: l.st, of: v, path: CasePath({ case: i, at: w }) }),
          None -> None,
        },
        None -> None,
      },
      AsWord ->
        Some({
          st: note_open_layouts(context, l.st, v.ty),
          of: v,
          path: CasePath({ case: index, at: 0 }),
        }),
      _ -> None,
    },
    _ -> None,
  }

fn failing_else(
  c: BuiltinCall,
  cond: LoweredValue,
  then: LoweredValue,
  rejection: (Lowering) -> Lowering / {abort.raise},
) -> LoweredValue / {abort.raise} = {
  let raised = rejection(enter_block(exit_block(cond.st, then.st)));
  joined(
    c.context,
    cond,
    then,
    { st: raised, arg: ZeroOperand(operand_representation(then.arg)) },
    false,
    c.at,
  )
}

fn raise_rejection(c: BuiltinCall, st: Lowering, ns: List<Arg>) -> Lowering =
  raising(c, st, b"ply_refused", ns, 3)

fn rejected_text(c: BuiltinCall, st: Lowering, texts: List<Arg>) -> Lowering =
  raising(c, st, b"ply_refused_text", texts, 4)

fn raising(
  c: BuiltinCall,
  st: Lowering,
  failure: Bytes,
  operands: List<Arg>,
  words: Int,
) -> Lowering = {
  let args = [IntOperand(rejection(c.name))].concat(operands).concat(
    range(operands.len(), words).map(|_: Int| IntOperand(0)),
  );
  run_for_effect(
    st,
    Native({
      name: failure,
      args: args,
      uses: { takes: args.map(|_: Arg| false), owned: false, fails: true, suspends: false },
    }),
    c.at,
  )
}

fn option_if_nonnegative(
  context: Context,
  k: LoweredValue,
  ty: Type,
  payload: (Lowering) -> LoweredValue / {abort.raise},
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let none = compared(k.st, b"lt", k.arg, IntOperand(0), at);
  let o = option_type(ty);
  let n = constructed_as(context, enter_block(none.st), none_constructor(), [], o, at);
  let p = payload(enter_block(exit_block(none.st, n.st)));
  let s = constructed_as(context, p.st, some_constructor(), [p.arg], o, at);
  joined(context, none, n, s, false, at)
}

fn decimal_of_bits(
  c: BuiltinCall,
  st: Lowering,
  low: Arg,
  high: Arg,
) -> LoweredValue / {abort.raise} = {
  let lo = represented_as({ st: st, arg: low }, AsInt, c.at);
  let hi = represented_as({ st: lo.st, arg: high }, AsInt, c.at);
  let k = bound_as(
    hi.st,
    int_type(),
    AsInt,
    Primitive({ operation: b"decimal_flags", on: AsInt, args: [lo.arg] }),
    c.at,
  );
  let d = decimal_type();
  option_if_nonnegative(
    c.context,
    k,
    d,
    |s: Lowering|
      bound_as(
        s,
        d,
        AsDecimal,
        Primitive({ operation: b"decimal", on: AsInt, args: [lo.arg, hi.arg] }),
        c.at,
      ),
    c.at,
  )
}

fn recast(st: Lowering, a: Arg, ty: Type, at: Span) -> LoweredValue = {
  let s = represented_as({ st: st, arg: a }, AsWord, at);
  bound_as(
    s.st,
    ty,
    AsWord,
    OperationCall({
      operation: OfContainers(NodeIntrinsic(Recast)),
      args: [s.arg],
      uses: { takes: [true], owned: true, fails: false, suspends: false },
    }),
    at,
  )
}

fn copied_out(st: Lowering, ty: Type, address: Arg, from: Arg, n: Arg, at: Span) -> LoweredValue = {
  let o = bound_string_operation(st, ty, AsWord, AllocateBytes, [n], at);
  {
    st: string_operation_for_effect(o.st, CopyBytes, [o.arg, IntOperand(0), address, from, n], at),
    arg: o.arg,
  }
}

fn compared(st: Lowering, operation: Bytes, a: Arg, b: Arg, at: Span) -> LoweredValue =
  bound_as(
    st,
    bool_type(),
    AsBool,
    Primitive({ operation: operation, on: AsInt, args: [a, b] }),
    at,
  )

fn arithmetic(st: Lowering, operation: Bytes, a: Arg, b: Arg, at: Span) -> LoweredValue =
  bound_as(st, int_type(), AsInt, Primitive({ operation: operation, on: AsInt, args: [a, b] }), at)

fn bound_string_operation(
  st: Lowering,
  ty: Type,
  rep: Representation,
  operation: StringOperation,
  args: List<Arg>,
  at: Span,
) -> LoweredValue =
  bound_as(
    st,
    ty,
    rep,
    OperationCall({
      operation: OfStrings(operation),
      args: args,
      uses: string_signature(operation),
    }),
    at,
  )

fn int_operation(
  st: Lowering,
  operation: StringOperation,
  args: List<Arg>,
  at: Span,
) -> LoweredValue = bound_string_operation(st, int_type(), AsInt, operation, args, at)

fn string_operation_for_effect(
  st: Lowering,
  operation: StringOperation,
  args: List<Arg>,
  at: Span,
) -> Lowering =
  run_for_effect(
    st,
    OperationCall({
      operation: OfStrings(operation),
      args: args,
      uses: string_signature(operation),
    }),
    at,
  )

fn native_int(
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  bound_as(
    st,
    int_type(),
    AsInt,
    Native({
      name: native_of(name),
      args: args,
      uses: { takes: args.map(|_: Arg| false), owned: true, fails: false, suspends: false },
    }),
    at,
  )

pub type GeneratedRoot = { params: List<EmitParam>, code: Code, here: List<Definition> }

pub fn strings_root(operation: Bytes) -> Bool =
  [
    b"range_from",
    b"split_from",
    b"chars_from",
    b"of_chars_from",
    b"concat_all_from",
    b"jwk_from",
  ].contains(
    operation,
  )

fn string_root_signature(
  operation: Bytes,
  t: Type,
) -> { params: List<{ name: Bytes, ty: Type }>, result_type: Type } = {
  let p = |name: Bytes, ty: Type| { name: name, ty: ty };
  if operation == b"range_from" {
    { params: [p(b"lo", int_type()), p(b"hi", int_type()), p(b"acc", t)], result_type: t }
  } else if operation == b"split_from" {
    {
      params: [p(b"s", t), p(b"sep", t), p(b"from", int_type()), p(b"acc", list_type(t))],
      result_type: list_type(t),
    }
  } else if operation == b"chars_from" {
    {
      params: [p(b"s", t), p(b"at", int_type()), p(b"acc", list_type(char_type()))],
      result_type: list_type(char_type()),
    }
  } else if operation == b"of_chars_from" {
    {
      params: [p(b"cs", t), p(b"i", int_type()), p(b"acc", string_type())],
      result_type: string_type(),
    }
  } else if operation == b"jwk_from" {
    let joined = secret_of(bytes_type());
    { params: [p(b"xs", t), p(b"i", int_type()), p(b"acc", joined)], result_type: joined }
  } else {
    {
      params: [p(b"bs", t), p(b"i", int_type()), p(b"acc", bytes_type())],
      result_type: bytes_type(),
    }
  }
}

fn param_name(ps: List<{ name: Bytes, ty: Type }>, slot: Int) -> Bytes =
  match ps.at(slot) { Some(p) -> p.name, None -> b"" }

pub fn strings_code(module: Bytes, operation: Bytes, t: Type) -> GeneratedRoot / {abort.raise} = {
  let key = keys::generated_key(ContainerWalk(operation), t, module);
  let typed_of = string_root_signature(operation, t);
  let name = name_in_module(module, root_text(root_name(key)));
  let param_types = typed_of.params.map(|x: { name: Bytes, ty: Type }| x.ty);
  let definition = {
    name: name,
    return_kind: Some(kind_of(typed_of.result_type).kind),
    return_type: kind_of(typed_of.result_type).ty,
    pure: true,
    constant: false,
    value: None,
    arity: typed_of.params.len(),
    scheme: Some(monomorphic(function_type(param_types, typed_of.result_type, no_effects()))),
    witnesses: 0,
    borrowed: [],
    root: key,
  };
  let v = |slot: Int|
    slot_code(param_name(typed_of.params, slot), slot, match param_types.at(slot) {
      Some(p) -> p,
      None -> unknown_type(),
    });
  let again = |args: List<Code>|
    applied(
      unspanned_code(
        NDefinition({ full: qualify(module, name), args: [], effect_arguments: [], labels: [] }),
        function_type(param_types, typed_of.result_type, no_effects()),
      ),
      args,
      typed_of.result_type,
    );
  let literal = int_code;
  let bin = binary_of;
  let cond = if_code;
  let bound = |n: Bytes, slot: Int, value: Code, tail: Code|
    block_code([CodeLet({ name: n, slot: slot, value: value })], tail);
  let call = |b: Bytes, args: List<Code>, return_type: Type| builtin_call(b, [], args, return_type);
  let item = match t { NamedType(c) -> match c.args.at(0) { Some(x) -> x, None -> t }, _ -> t };
  let code = if operation == b"range_from" {
    cond(
      bin(b"lt", v(0), v(1)),
      again([
        bin(b"add", v(0), literal(1)),
        v(1),
        prelude_call(b"List::push", [int_type()], [v(2), v(0)], t),
      ]),
      v(2),
    )
  } else if operation == b"split_from" {
    let first_occurrence = call(
      b"Bytes::index_of_from",
      [v(0), v(1), v(2)],
      option_type(int_type()),
    );
    let piece = |to: Code| call(b"Bytes::slice", [v(0), v(2), to], t);
    let at = slot_code(b"at", 4, int_type());
    some_or(
      first_occurrence,
      b"at",
      4,
      int_type(),
      again([
        v(0),
        v(1),
        bin(b"add", at, call(b"Bytes::len", [v(1)], int_type())),
        prelude_call(b"List::push", [t], [v(3), piece(at)], list_type(t)),
      ]),
      prelude_call(
        b"List::push",
        [t],
        [v(3), piece(call(b"Bytes::len", [v(0)], int_type()))],
        list_type(t),
      ),
    )
  } else if operation == b"chars_from" {
    let byte = |off: Int| call(b"Bytes::at", [v(0), bin(b"add", v(1), literal(off))], int_type());
    let more = |accumulator: Code, off: Int|
      bin(b"add", bin(b"mul", accumulator, literal(64)), bin(b"sub", byte(off), literal(128)));
    let b0 = slot_code(b"b0", 3, int_type());
    let width = slot_code(b"w", 4, int_type());
    let lead = |base: Int| bin(b"sub", b0, literal(base));
    let scalar = cond(
      bin(b"eq", width, literal(1)),
      b0,
      cond(
        bin(b"eq", width, literal(2)),
        more(lead(192), 1),
        cond(
          bin(b"eq", width, literal(3)),
          more(more(lead(224), 1), 2),
          more(more(more(lead(240), 1), 2), 3),
        ),
      ),
    );
    let pushed = some_or(
      call(b"Char::of_int", [slot_code(b"n", 5, int_type())], option_type(char_type())),
      b"c",
      6,
      char_type(),
      again([
        v(0),
        bin(b"add", v(1), width),
        prelude_call(
          b"List::push",
          [char_type()],
          [v(2), slot_code(b"c", 6, char_type())],
          list_type(char_type()),
        ),
      ]),
      v(2),
    );
    let w = cond(
      bin(b"lt", b0, literal(128)),
      literal(1),
      cond(
        bin(b"lt", b0, literal(224)),
        literal(2),
        cond(bin(b"lt", b0, literal(240)), literal(3), literal(4)),
      ),
    );
    cond(
      bin(b"lt", v(1), call(b"Bytes::len", [v(0)], int_type())),
      bound(b"b0", 3, byte(0), bound(b"w", 4, w, bound(b"n", 5, scalar, pushed))),
      v(2),
    )
  } else if operation == b"of_chars_from" {
    let n = slot_code(b"n", 4, int_type());
    let byte_at = |e: Code| call(b"byte_of_int", [e], bytes_type());
    let tail = |shift: Int|
      byte_at(bin(b"add", literal(128), bin(b"rem", bin(b"div", n, literal(shift)), literal(64))));
    let joined = |a: Code, b: Code| call(b"Bytes::concat", [a, b], bytes_type());
    let utf8 = cond(
      bin(b"lt", n, literal(128)),
      byte_at(n),
      cond(
        bin(b"lt", n, literal(2048)),
        joined(byte_at(bin(b"add", literal(192), bin(b"div", n, literal(64)))), tail(1)),
        cond(
          bin(b"lt", n, literal(65536)),
          joined(
            joined(byte_at(bin(b"add", literal(224), bin(b"div", n, literal(4096)))), tail(64)),
            tail(1),
          ),
          joined(
            joined(
              joined(
                byte_at(bin(b"add", literal(240), bin(b"div", n, literal(262144)))),
                tail(4096),
              ),
              tail(64),
            ),
            tail(1),
          ),
        ),
      ),
    );
    some_or(
      prelude_call(b"List::at", [char_type()], [v(0), v(1)], option_type(char_type())),
      b"c",
      3,
      char_type(),
      bound(
        b"n",
        4,
        call(b"Int::of_char", [slot_code(b"c", 3, char_type())], int_type()),
        again([
          v(0),
          bin(b"add", v(1), literal(1)),
          call(b"String::concat", [v(2), utf8], string_type()),
        ]),
      ),
      v(2),
    )
  } else if operation == b"jwk_from" {
    let joined = secret_of(bytes_type());
    let dot = call(b"Secret::of_bytes", [bytes_code(b".")], joined);
    let text = call(b"Secret::bytes", [slot_code(b"x", 3, item)], joined);
    some_or(
      prelude_call(b"List::at", [item], [v(0), v(1)], option_type(item)),
      b"x",
      3,
      item,
      again([
        v(0),
        bin(b"add", v(1), literal(1)),
        call(b"Secret::concat", [v(2), call(b"Secret::concat", [dot, text], joined)], joined),
      ]),
      v(2),
    )
  } else {
    some_or(
      prelude_call(b"List::at", [item], [v(0), v(1)], option_type(item)),
      b"b",
      3,
      item,
      again([
        v(0),
        bin(b"add", v(1), literal(1)),
        call(b"Bytes::concat", [v(2), slot_code(b"b", 3, item)], bytes_type()),
      ]),
      v(2),
    )
  };
  {
    params: typed_of.params.map(|x: { name: Bytes, ty: Type }| {
      let k = kind_of(x.ty);
      { name: x.name, kind: k.kind, ty: k.ty, of: Some(x.ty), lambda: None }
    }),
    code: code,
    here: [definition],
  }
}

test "each generated string or list helper has its own parameters, and the loop in that helper calls only that definition" {
  let cases = [
    {
      operation: b"range_from",
      t: list_type(int_type()),
      params: [int_type(), int_type(), list_type(int_type())],
    },
    {
      operation: b"split_from",
      t: string_type(),
      params: [string_type(), string_type(), int_type(), list_type(string_type())],
    },
    {
      operation: b"chars_from",
      t: string_type(),
      params: [string_type(), int_type(), list_type(char_type())],
    },
    {
      operation: b"of_chars_from",
      t: list_type(char_type()),
      params: [list_type(char_type()), int_type(), string_type()],
    },
    {
      operation: b"concat_all_from",
      t: list_type(bytes_type()),
      params: [list_type(bytes_type()), int_type(), bytes_type()],
    },
    {
      operation: b"jwk_from",
      t: list_type(secret_of(string_type())),
      params: [list_type(secret_of(string_type())), int_type(), secret_of(bytes_type())],
    },
  ];
  cases.fold((), |_: Unit, x: { operation: Bytes, t: Type, params: List<Type> }| {
    assert(strings_root(x.operation), None);
    let w = strings_code(b"m", x.operation, x.t);
    assert_eq(w.params.map(|p: EmitParam| p.of), x.params.map(|p: Type| Some(p)));
    assert_eq(w.here.map(|d: Definition| d.root), [
      keys::generated_key(ContainerWalk(x.operation), x.t, b"m"),
    ]);
    assert_eq(w.here.map(|d: Definition| d.arity), [x.params.len()])
  });
  assert(!strings_root(b"equal_from"), None)
}

test "`rejection` returns the runtime's numeric code for a builtin that is not compiled inline, or -1, and the codes after the container builtins are string builtins" {
  assert_eq(
    [
      b"Array::new",
      b"Columns::set",
      b"Bytes::at",
      b"range",
      b"String::find",
      b"assert",
      b"Bytes::position",
      b"Secret::decode",
      b"Secret::rsa_jwk",
    ].map(
      rejection,
    ),
    [0, 7, 8, 17, 20, 21, 22, 23, 25],
  );
  assert_eq(rejection(b"Bytes::concat"), 0 - 1);
  assert(
    rejections().drop(8).filter(|n: Bytes| n != b"Bytes::position" && n != b"List::set").all(
      string_builtin,
    ),
    None,
  )
}

test "`string_builtin` is true for the string and bytes builtins implemented in the compiler and false for other builtins" {
  assert([b"String::concat", b"Bytes::at", b"range", b"String::split"].all(string_builtin), None);
  assert(![b"List::len", b"Bytes::len", b"Bytes::position"].any(string_builtin), None)
}
