import compiler.syntax.parsing (Span)
import compiler.check.types (Type, Effects, Effect, Resource, NamedResource, SingletonResource,
                             ResourceVariable, AnyResource, Scheme, int_type, no_effects)
import compiler.check.infer.checker (simulated_effect_names)
import compiler.emit.code (Code, CodeLabel, CodeVariable, NDefinition, NBuiltin, CodePerform,
                           CodeLambda, CodeSimulate, CodeHandle, CodeClause, is_label_binder,
                           code_children, labels_among)
import compiler.emit.keys (RootKey, EntryPoint, Evidence, key_effects, unspecialised)
import compiler.emit.evidence (EffectsEvidence, KeyedEvidence, effects_evidence, declared_effects,
                               offset_labels, passed_label_count, renumber_labels, key_effects_of,
                               covers, needs_evidence, sorted_by_evidence, evidence_type,
                               max_evidence_params, evidence_param_count, evidence_array_type,
                               evidence_array_of, effects_descriptor_type)
import compiler.emit.representations (Definition)
import compiler.emit.typed_ir (Representation, AsInt, AsImmediate, Variable, Arg, VariableOperand,
                               IntOperand, ZeroOperand, OperationCall, OfHandling, Static,
                               Convention, BorrowedParam, reads)
import compiler.emit.typed_ir.handling (HandleOperation, WordArray, WordAt, SchedulerEvidence,
                                        UnhandledEvidence)
import compiler.emit.typed_ir.statics (StaticLayout, StaticWord, StaticWords, RawWord, FieldWord)
import compiler.emit.lower.module_context (ModuleContext)
import compiler.emit.lower.base (Context, Lowering, EvidenceWord, bound_as, static_added)

pub type EvidenceParameters = {
  declared: List<EffectsEvidence>,
  labels: Int,
  hidden: Int,
  unfilled: Bool,
}

pub fn evidence_parameters(s: ModuleContext, key: RootKey) -> EvidenceParameters =
  match s.definitions.fold(None, |accumulator: Option<Scheme>, d: Definition|
      if d.root == unspecialised(key) { d.scheme } else { accumulator }) {
    None -> { declared: [], labels: 0, hidden: 0, unfilled: false },
    Some(scheme) -> {
      let effect_evidence = key_effects(key);
      {
        declared: effects_evidence(
          declared_effects(scheme),
          effect_evidence,
          scheme.label_variables.len(),
        ),
        labels: scheme.label_variables.len(),
        hidden: passed_label_count(effect_evidence),
        unfilled: scheme.effect_variables.len() > effect_evidence.len(),
      }
    },
  }

pub fn with_evidence_parameters(c: Convention, hidden: Int, words: Int) -> Convention = {
  let more = range(0, hidden).map(|_: Int| AsInt).concat(
    range(0, evidence_param_count(words)).map(|_: Int| AsImmediate),
  );
  {
    ..c,
    params: c.params.concat(
      more.map(|r: Representation| { ownership: BorrowedParam, representation: r }),
    ),
  }
}

pub fn evidence_parameter_types(h: EvidenceParameters) -> List<Type> =
  range(0, h.hidden).map(|_: Int| int_type()).concat(if h.declared.len() <= max_evidence_params() {
    h.declared.map(|_: EffectsEvidence| evidence_type())
  } else { [evidence_array_of(h.declared.len())] })

pub fn enter_root_body(
  context: Context,
  st: Lowering,
  params: List<Variable>,
  declared: Int,
  h: EvidenceParameters,
) -> { context: Context, st: Lowering } = {
  let read = read_evidence_words(
    st,
    params.drop(declared + h.hidden),
    h.declared,
    context.body.span,
  );
  {
    context: {
      ..context,
      words: read.words,
      label_values: labels_among(params.take(declared), h.labels).concat(
        params.drop(declared).take(h.hidden),
      ).map(|v: Variable| Some(VariableOperand(v))),
      evidence_arguments: params.drop(declared).map(VariableOperand),
    },
    st: read.st,
  }
}

pub fn entry_body_start(
  o: { context: Context, st: Lowering },
  performs: Effects,
) -> { context: Context, st: Lowering } =
  match o.context.key {
    EntryPoint(_) -> {
      let effects = performs.listed.fold([], |accumulator: List<Bytes>, a: Effect|
        if !needs_evidence(a.effect) || accumulator.contains(a.effect) { accumulator }
        else { accumulator.push(a.effect) });
      let entry_evidence = effects.fold(
        { st: o.st, made: [], words: [] },
        |accumulator: { st: Lowering, made: List<EntryObject>, words: List<EvidenceWord> }, e: Bytes| {
          let operation = entry_object(e);
          let w = match accumulator.made.find(|m: EntryObject| m.operation == operation) {
            Some(m) -> { st: accumulator.st, made: accumulator.made, arg: m.arg },
            None -> {
              let b = bound_as(
                accumulator.st,
                evidence_type(),
                AsImmediate,
                OperationCall({ operation: OfHandling(operation), args: [], uses: reads(0) }),
                o.context.body.span,
              );
              {
                st: b.st,
                made: accumulator.made.push({ operation: operation, arg: b.arg }),
                arg: b.arg,
              }
            },
          };
          {
            st: w.st,
            made: w.made,
            words: accumulator.words.push({
              evidence: { effect: e, resource: AnyResource },
              word: w.arg,
              inherited: false,
              handled: false,
            }),
          }
        },
      );
      {
        context: { ..o.context, words: entry_evidence.words.concat(o.context.words) },
        st: entry_evidence.st,
      }
    },
    _ -> o,
  }

type EntryObject = { operation: HandleOperation, arg: Arg }

fn entry_object(name: Bytes) -> HandleOperation =
  if name == b"sim" || simulated_effect_names().contains(name) { SchedulerEvidence }
  else { UnhandledEvidence }

pub fn read_evidence_words(
  st: Lowering,
  carried: List<Variable>,
  own: List<EffectsEvidence>,
  at: Span,
) -> { st: Lowering, words: List<EvidenceWord> } = {
  let read = if own.len() <= max_evidence_params() {
    { st: st, words: carried.map(VariableOperand) }
  } else {
    match carried.at(0) {
      None -> { st: st, words: [] },
      Some(array) ->
        range(0, own.len()).fold(
          { st: st, words: [] },
          |accumulator: { st: Lowering, words: List<Arg> }, i: Int| {
            let w = bound_as(
              accumulator.st,
              evidence_type(),
              AsImmediate,
              OperationCall({
                operation: OfHandling(WordAt(i)),
                args: [VariableOperand(array)],
                uses: reads(1),
              }),
              at,
            );
            { st: w.st, words: accumulator.words.push(w.arg) }
          },
        ),
    }
  };
  {
    st: read.st,
    words: range(0, own.len()).fold([], |accumulator: List<EvidenceWord>, i: Int|
      match own.at(i) {
        Some(o) ->
          accumulator.push({
            evidence: o.evidence,
            word: match read.words.at(i) { Some(a) -> a, None -> ZeroOperand(AsImmediate) },
            inherited: o.from_variable,
            handled: false,
          }),
        None -> accumulator,
      }),
  }
}

pub fn performed_by(codes: List<Code>) -> Effects =
  codes.fold(no_effects(), |accumulator: Effects, c: Code|
    match c.node {
      CodeLambda(l) -> {
        let r = l.effects;
        {
          listed: r.listed.fold(accumulator.listed, |xs: List<Effect>, a: Effect|
            if xs.contains(a) { xs } else { xs.push(a) }),
          variable: match accumulator.variable { Some(t) -> Some(t), None -> r.variable },
        }
      },
      _ -> accumulator,
    })

pub fn builtin_effects(function: Code) -> Effects =
  match function.node {
    NBuiltin(b) -> match b.effect_arguments.at(0) { Some(r) -> r, None -> no_effects() },
    _ -> no_effects(),
  }

fn effects_of(c: Code) -> { effect_arguments: List<Effects>, listed: List<Effect> } =
  match c.node {
    CodeLambda(l) -> { effect_arguments: [l.effects], listed: [] },
    CodeSimulate(x) -> { effect_arguments: [x.effects], listed: [] },
    NDefinition(d) -> { effect_arguments: d.effect_arguments, listed: [] },
    NBuiltin(b) -> { effect_arguments: b.effect_arguments, listed: [] },
    CodePerform(p) -> { effect_arguments: [], listed: [p.entry] },
    CodeHandle(h) ->
      {
        effect_arguments: h.clauses.fold(
          match h.return_clause { Some(r) -> [h.effects, r.effects], None -> [h.effects] },
          |accumulator: List<Effects>, clause: CodeClause| accumulator.push(clause.effects),
        ),
        listed: [],
      },
    _ -> { effect_arguments: [], listed: [] },
  }

pub fn has_static_effects(c: Code) -> Bool / {abort.raise} = {
  let own = effects_of(c);
  own.effect_arguments.all(static_effects)
    && own.listed.all(|a: Effect| match a.resource { ResourceVariable(_) -> false, _ -> true })
    && code_children(c).all(has_static_effects)
}

fn static_effects(r: Effects) -> Bool =
  r.variable == None
    && r.listed.all(|a: Effect| match a.resource { ResourceVariable(_) -> false, _ -> true })

pub fn labels_read(context: Context, c: Code, accumulator: List<Int>) -> List<Int> = {
  let places = |ws: List<EffectsEvidence>|
    ws.fold([], |out: List<Int>, o: EffectsEvidence|
      match o.evidence.resource { ResourceVariable(p) -> out.push(p), _ -> out });
  let own = effects_of(c);
  let argument_labels = own.effect_arguments.fold(
    own.listed.fold([], |out: List<Int>, a: Effect|
      match a.resource { ResourceVariable(p) -> out.push(p), _ -> out }),
    |out: List<Int>, r: Effects|
      out.concat(places(effects_evidence(r, context.effect_evidence, context.labels))),
  );
  let named = match c.node {
    CodeVariable(v) ->
      range(0, context.label_names.len()).filter(|i: Int|
        match context.label_names.at(i) {
          Some(n) -> Bytes::concat_all([b"[", n, b"]"]) == v.name,
          None -> false,
        }),
    _ -> [],
  };
  code_children(c).fold(
    argument_labels.concat(named).fold(accumulator, |out: List<Int>, p: Int|
      if out.contains(p) { out } else { out.push(p) }),
    |out: List<Int>, x: Code| labels_read(context, x, out),
  )
}

pub fn words_of(context: Context, effects: Effects) -> List<EffectsEvidence> =
  effects_evidence(effects, context.effect_evidence, context.labels)

pub fn evidence_for(context: Context, wanted: List<EffectsEvidence>) -> List<Arg> =
  wanted.fold(
    { out: [], seen: [] },
    |accumulator: { out: List<Arg>, seen: List<Evidence> }, w: EffectsEvidence|
      if w.from_variable {
        let n = accumulator.seen.filter(|e: Evidence| e == w.evidence).len();
        let alike = context.words.filter(|x: EvidenceWord|
          x.inherited && !x.handled && x.evidence == w.evidence);
        {
          out: accumulator.out.push(match alike.at(n) {
            Some(x) -> x.word,
            None -> ZeroOperand(AsImmediate),
          }),
          seen: accumulator.seen.push(w.evidence),
        }
      } else {
        {
          ..accumulator,
          out: accumulator.out.push(
            match context.words.find(|x: EvidenceWord|
                !x.inherited && covers(x.evidence, w.evidence)) {
              Some(x) -> x.word,
              None -> ZeroOperand(AsImmediate),
            },
          ),
        }
      },
  ).out

pub fn covering_evidence_word(context: Context, e: Evidence) -> Arg =
  match context.words.find(|x: EvidenceWord| !x.inherited && covers(x.evidence, e)) {
    Some(x) -> x.word,
    None -> match context.words.find(|x: EvidenceWord| x.inherited && covers(x.evidence, e)) {
      Some(x) -> x.word,
      None -> ZeroOperand(AsImmediate),
    },
  }

pub fn label_value(context: Context, p: Int) -> Arg =
  match context.label_values.at(p) { Some(Some(a)) -> a, _ -> IntOperand(0) }

pub type EvidenceArguments = {
  effect_evidence: List<List<Evidence>>,
  labels: List<Arg>,
  words: List<Arg>,
  wanted: List<EffectsEvidence>,
}

type EvidencePair = { callee: Evidence, wanted: EffectsEvidence }

pub fn evidence_arguments(
  context: Context,
  st: Lowering,
  d: Definition,
  function: Code,
  labels: List<Code>,
) -> EvidenceArguments / {abort.raise} =
  evidence_arguments_filled(
    context,
    d,
    match function.node { NDefinition(r) -> r.effect_arguments, _ -> [] },
    labels,
  )

pub fn evidence_arguments_filled(
  context: Context,
  d: Definition,
  filled: List<Effects>,
  labels: List<Code>,
) -> EvidenceArguments / {abort.raise} =
  scheme_evidence_arguments(context, d.scheme, filled, labels)

pub fn scheme_evidence_arguments(
  context: Context,
  scheme: Option<Scheme>,
  filled: List<Effects>,
  labels: List<Code>,
) -> EvidenceArguments / {abort.raise} =
  match scheme {
    None -> { effect_evidence: [], labels: [], words: [], wanted: [] },
    Some(known_scheme) -> {
      let given = filled.map(|r: Effects|
        effects_evidence(r, context.effect_evidence, context.labels));
      let k = renumber_labels(
        given.map(|ws: List<EffectsEvidence>| ws.map(|o: EffectsEvidence| o.evidence)),
      );
      let effects = declared_effects(known_scheme);
      let own_labels = known_scheme.label_variables.len();
      let written = effects.listed.fold([], |accumulator: List<EvidencePair>, a: Effect|
        if !needs_evidence(a.effect) { accumulator } else {
          let callee = { effect: a.effect, resource: a.resource };
          if accumulator.any(|p: EvidencePair| p.callee == callee) { accumulator } else {
            accumulator.push({
              callee: callee,
              wanted: {
                evidence: {
                  effect: a.effect,
                  resource: resolve_label_resource(context, labels, a.resource),
                },
                from_variable: false,
              },
            })
          }
        });
      let through = match effects.variable {
        None -> [],
        Some(t) -> match ((k.effect_evidence.at(t), given.at(t))) {
          (Some(keys), Some(ws)) ->
            keys.fold([], |accumulator: List<EvidencePair>, x: KeyedEvidence|
              match ws.at(x.from) {
                Some(o) ->
                  accumulator.push({
                    callee: match offset_labels([x.key], own_labels).at(0) {
                      Some(e) -> e,
                      None -> x.key,
                    },
                    wanted: o,
                  }),
                None -> accumulator,
              }),
          _ -> [],
        },
      };
      let pairs = sorted_by_evidence(written.concat(through), |p: EvidencePair| p.callee);
      let wanted = pairs.map(|p: EvidencePair| p.wanted);
      {
        effect_evidence: key_effects_of(k.effect_evidence),
        labels: k.sources.map(|p: Int| label_value(context, p)),
        words: evidence_for(context, wanted),
        wanted: wanted,
      }
    },
  }

pub fn passed_evidence_arguments(
  st: Lowering,
  h: EvidenceArguments,
  at: Span,
) -> { st: Lowering, args: List<Arg> } = {
  let words = fill_missing_evidence(st, h.words, at);
  if words.args.len() <= max_evidence_params() {
    { st: words.st, args: h.labels.concat(words.args) }
  } else {
    let laid = bound_as(
      words.st,
      evidence_array_type(),
      AsImmediate,
      OperationCall({
        operation: OfHandling(WordArray),
        args: words.args,
        uses: reads(words.args.len()),
      }),
      at,
    );
    { st: laid.st, args: h.labels.push(laid.arg) }
  }
}

pub fn captured_evidence_for(
  context: Context,
  st: Lowering,
  own: List<EffectsEvidence>,
  at: Span,
) -> { st: Lowering, words: List<EvidenceWord> } = {
  let words = fill_missing_evidence(st, evidence_for(context, own), at);
  {
    st: words.st,
    words: range(0, own.len()).fold([], |accumulator: List<EvidenceWord>, k: Int|
      match ((own.at(k), words.args.at(k))) {
        (Some(o), Some(w)) ->
          accumulator.push({
            evidence: o.evidence,
            word: w,
            inherited: o.from_variable,
            handled: false,
          }),
        _ -> accumulator,
      }),
  }
}

pub fn fill_missing_evidence(
  st: Lowering,
  words: List<Arg>,
  at: Span,
) -> { st: Lowering, args: List<Arg> } =
  if !words.contains(ZeroOperand(AsImmediate)) { { st: st, args: words } } else {
    let b = bound_as(
      st,
      evidence_type(),
      AsImmediate,
      OperationCall({ operation: OfHandling(SchedulerEvidence), args: [], uses: reads(0) }),
      at,
    );
    { st: b.st, args: words.map(|w: Arg| if w == ZeroOperand(AsImmediate) { b.arg } else { w }) }
  }

pub fn label_codes(d: Definition, codes: List<Code>) -> List<Code> =
  match d.scheme { Some(scheme) -> labels_among(codes, scheme.label_variables.len()), None -> [] }

fn resolve_label_resource(
  context: Context,
  labels: List<Code>,
  r: Resource,
) -> Resource / {abort.raise} =
  match r {
    ResourceVariable(q) -> match labels.at(q) {
      Some(c) -> label_resource(context, c),
      None -> unknown_resource(),
    },
    _ -> r,
  }

pub fn label_resource(context: Context, c: Code) -> Resource / {abort.raise} =
  match c.node {
    CodeLabel(n) -> NamedResource(n),
    CodeVariable(v) -> if !is_label_binder(v.name) { unknown_resource() } else {
      let name = v.name.slice(1, v.name.len() - 1);
      match range(0, context.label_names.len()).find(|i: Int|
          context.label_names.at(i) == Some(name)) {
        Some(p) -> ResourceVariable(p),
        None -> unknown_resource(),
      }
    },
    _ -> unknown_resource(),
  }

fn unknown_resource() -> Resource = NamedResource(b"?")

pub fn function_value_evidence(
  context: Context,
  st: Lowering,
  effects: Effects,
  at: Span,
) -> { st: Lowering, args: List<Arg> } / {abort.raise} =
  wanted_evidence_arguments(
    context,
    st,
    effects_evidence(effects, context.effect_evidence, context.labels),
    at,
  )

pub fn wanted_evidence_arguments(
  context: Context,
  st: Lowering,
  wanted: List<EffectsEvidence>,
  at: Span,
) -> { st: Lowering, args: List<Arg> } / {abort.raise} = {
  let words = fill_missing_evidence(st, evidence_for(context, wanted), at);
  let left = wanted.fold([], |accumulator: List<Arg>, o: EffectsEvidence|
    match o.evidence.resource {
      ResourceVariable(p) -> accumulator.push(label_value(context, p)),
      _ -> accumulator,
    });
  let d = static_added(words.st, effects_descriptor(wanted.map(|o: EffectsEvidence| o.evidence)));
  let descriptor = bound_as(d.st, effects_descriptor_type(), AsImmediate, Static(d.name), at);
  let all = words.args.concat(left);
  if all.len() == 0 { { st: descriptor.st, args: [descriptor.arg, ZeroOperand(AsImmediate)] } }
  else {
    let laid = bound_as(
      descriptor.st,
      evidence_array_type(),
      AsImmediate,
      OperationCall({ operation: OfHandling(WordArray), args: all, uses: reads(all.len()) }),
      at,
    );
    { st: laid.st, args: [descriptor.arg, laid.arg] }
  }
}

pub fn effects_descriptor(ws: List<Evidence>) -> StaticLayout =
  StaticWords(
    [RawWord(ws.len())].concat(
      ws.fold([], |accumulator: List<StaticWord>, w: Evidence|
        accumulator.push(FieldWord(w.effect)).push(match w.resource {
          SingletonResource -> RawWord(0 - 1),
          AnyResource -> RawWord(0 - 2),
          ResourceVariable(_) -> RawWord(0 - 3),
          NamedResource(n) -> FieldWord(n),
        })),
    ),
  )

pub fn label_values_at(
  context: Context,
  places: List<Int>,
  values: List<Arg>,
) -> List<Option<Arg>> =
  range(0, context.labels + passed_label_count(context.effect_evidence)).map(|p: Int|
    match range(0, places.len()).find(|i: Int| places.at(i) == Some(p)) {
      Some(i) -> values.at(i),
      None -> None,
    })

pub fn caller_filled_labels(own: List<EffectsEvidence>) -> List<Int> =
  own.fold([], |accumulator: List<Int>, o: EffectsEvidence|
    match o.evidence.resource {
      ResourceVariable(p) -> if accumulator.contains(p) { accumulator }
      else { accumulator.push(p) },
      _ -> accumulator,
    })
