import compiler.syntax.parsing (Span)
import compiler.check.types (Type, Row, Atom, Resource, NamedResource, SingletonResource,
                             ResourceVariable, AnyResource, Scheme, int_type, row_empty)
import compiler.check.infer.checker (simulated_effect_names)
import compiler.emit.code (Code, CodeLabel, CodeVar, NDef, NBuiltin, CodePerform, CodeLambda,
                           CodeSimulate, CodeHandle, CodeClause, is_label_binder, code_children,
                           labels_among)
import compiler.emit.keys (RootKey, EntryPoint, Evidence, key_rows, unspecialised)
import compiler.emit.evidence (RowEvidence, KeyedEvidence, row_evidence, declared_row,
                               offset_labels, passed_label_count, renumber_labels, key_rows_of,
                               covers, needs_evidence, sorted_by_evidence, evidence_type,
                               max_evidence_params, evidence_param_count, evidence_array_type,
                               evidence_array_of, row_descriptor_type)
import compiler.emit.representations (Def)
import compiler.emit.typed_ir (Representation, AsInt, AsImmediate, Var, Arg, VarOperand, IntOperand,
                               ZeroOperand, Op, OfHandling, Static, Convention, BorrowedParam,
                               reads)
import compiler.emit.typed_ir.handling (HandleOp, WordArray, WordAt, SchedulerEvidence,
                                        UnhandledEvidence)
import compiler.emit.typed_ir.statics (StaticLayout, StaticWord, StaticWords, RawWord, FieldWord)
import compiler.emit.lower.module_context (ModuleContext)
import compiler.emit.lower.base (Context, Lowering, EvidenceWord, bound_as, static_added)

pub type EvidenceParameters = { own: List<RowEvidence>, labels: Int, hidden: Int, unfilled: Bool }

pub fn evidence_parameters(s: ModuleContext, key: RootKey) -> EvidenceParameters / {abort.raise} =
  match s.here.fold(None, |acc: Option<Scheme>, d: Def|
      if d.root == unspecialised(key) { d.scheme } else { acc }) {
    None -> { own: [], labels: 0, hidden: 0, unfilled: false },
    Some(sc) -> {
      let rows = key_rows(key);
      {
        own: row_evidence(declared_row(sc), rows, sc.label_vars.len()),
        labels: sc.label_vars.len(),
        hidden: passed_label_count(rows),
        unfilled: sc.row_vars.len() > rows.len(),
      }
    },
  }

pub fn with_evidence_parameters(c: Convention, hidden: Int, words: Int) -> Convention = {
  let more = range(0, hidden).map(|_: Int| AsInt).concat(
    range(0, evidence_param_count(words)).map(|_: Int| AsImmediate),
  );
  {
    ..c,
    params: c.params.concat(
      more.map(|r: Representation| { handed: BorrowedParam, representation: r }),
    ),
  }
}

pub fn evidence_parameter_types(h: EvidenceParameters) -> List<Type> =
  range(0, h.hidden).map(|_: Int| int_type()).concat(if h.own.len() <= max_evidence_params() {
    h.own.map(|_: RowEvidence| evidence_type())
  } else { [evidence_array_of(h.own.len())] })

pub fn root_body_start(
  cx: Context,
  st: Lowering,
  params: List<Var>,
  declared: Int,
  h: EvidenceParameters,
) -> { cx: Context, st: Lowering } = {
  let read = words_read(st, params.drop(declared + h.hidden), h.own, cx.body.span);
  {
    cx: {
      ..cx,
      words: read.words,
      label_values: labels_among(params.take(declared), h.labels).concat(
        params.drop(declared).take(h.hidden),
      ).map(|v: Var| Some(VarOperand(v))),
      handed: params.drop(declared).map(VarOperand),
    },
    st: read.st,
  }
}

pub fn entry_body_start(
  o: { cx: Context, st: Lowering },
  performs: Row,
) -> { cx: Context, st: Lowering } =
  match o.cx.key {
    EntryPoint(_) -> {
      let effects = performs.atoms.fold([], |acc: List<Bytes>, a: Atom|
        if !needs_evidence(a.effect) || acc.contains(a.effect) { acc } else { acc.push(a.effect) });
      let held = effects.fold(
        { st: o.st, made: [], words: [] },
        |acc: { st: Lowering, made: List<EntryObject>, words: List<EvidenceWord> }, e: Bytes| {
          let op = entry_object(e);
          let w = match acc.made.find(|m: EntryObject| m.op == op) {
            Some(m) -> { st: acc.st, made: acc.made, arg: m.arg },
            None -> {
              let b = bound_as(
                acc.st,
                evidence_type(),
                AsImmediate,
                Op({ op: OfHandling(op), args: [], uses: reads(0) }),
                o.cx.body.span,
              );
              { st: b.st, made: acc.made.push({ op: op, arg: b.arg }), arg: b.arg }
            },
          };
          {
            st: w.st,
            made: w.made,
            words: acc.words.push({
              evidence: { effect: e, resource: AnyResource },
              word: w.arg,
              through: false,
              handled: false,
            }),
          }
        },
      );
      { cx: { ..o.cx, words: held.words.concat(o.cx.words) }, st: held.st }
    },
    _ -> o,
  }

type EntryObject = { op: HandleOp, arg: Arg }

fn entry_object(name: Bytes) -> HandleOp =
  if name == b"sim" || simulated_effect_names().contains(name) { SchedulerEvidence }
  else { UnhandledEvidence }

pub fn words_read(
  st: Lowering,
  carried: List<Var>,
  own: List<RowEvidence>,
  at: Span,
) -> { st: Lowering, words: List<EvidenceWord> } = {
  let read = if own.len() <= max_evidence_params() { { st: st, words: carried.map(VarOperand) } }
  else {
    match carried.at(0) {
      None -> { st: st, words: [] },
      Some(array) ->
        range(0, own.len()).fold(
          { st: st, words: [] },
          |acc: { st: Lowering, words: List<Arg> }, i: Int| {
            let w = bound_as(
              acc.st,
              evidence_type(),
              AsImmediate,
              Op({ op: OfHandling(WordAt(i)), args: [VarOperand(array)], uses: reads(1) }),
              at,
            );
            { st: w.st, words: acc.words.push(w.arg) }
          },
        ),
    }
  };
  {
    st: read.st,
    words: range(0, own.len()).fold([], |acc: List<EvidenceWord>, i: Int|
      match own.at(i) {
        Some(o) ->
          acc.push({
            evidence: o.evidence,
            word: match read.words.at(i) { Some(a) -> a, None -> ZeroOperand(AsImmediate) },
            through: o.through,
            handled: false,
          }),
        None -> acc,
      }),
  }
}

pub fn performed_by(codes: List<Code>) -> Row =
  codes.fold(row_empty(), |acc: Row, c: Code|
    match c.node {
      CodeLambda(l) -> {
        let r = l.row;
        {
          atoms: r.atoms.fold(acc.atoms, |xs: List<Atom>, a: Atom|
            if xs.contains(a) { xs } else { xs.push(a) }),
          tail: match acc.tail { Some(t) -> Some(t), None -> r.tail },
        }
      },
      _ -> acc,
    })

pub fn builtin_row(func: Code) -> Row =
  match func.node {
    NBuiltin(b) -> match b.rows.at(0) { Some(r) -> r, None -> row_empty() },
    _ -> row_empty(),
  }

fn rows_of(c: Code) -> { rows: List<Row>, atoms: List<Atom> } =
  match c.node {
    CodeLambda(l) -> { rows: [l.row], atoms: [] },
    CodeSimulate(x) -> { rows: [x.row], atoms: [] },
    NDef(d) -> { rows: d.rows, atoms: [] },
    NBuiltin(b) -> { rows: b.rows, atoms: [] },
    CodePerform(p) -> { rows: [], atoms: [p.atom] },
    CodeHandle(h) ->
      {
        rows: h.clauses.fold(
          match h.ret { Some(r) -> [h.row, r.row], None -> [h.row] },
          |acc: List<Row>, cl: CodeClause| acc.push(cl.row),
        ),
        atoms: [],
      },
    _ -> { rows: [], atoms: [] },
  }

pub fn rows_static(c: Code) -> Bool / {abort.raise} = {
  let own = rows_of(c);
  own.rows.all(static_row)
    && own.atoms.all(|a: Atom| match a.resource { ResourceVariable(_) -> false, _ -> true })
    && code_children(c).all(rows_static)
}

fn static_row(r: Row) -> Bool =
  r.tail == None
    && r.atoms.all(|a: Atom| match a.resource { ResourceVariable(_) -> false, _ -> true })

pub fn labels_read(cx: Context, c: Code, acc: List<Int>) -> List<Int> = {
  let places = |ws: List<RowEvidence>|
    ws.fold([], |out: List<Int>, o: RowEvidence|
      match o.evidence.resource { ResourceVariable(p) -> out.push(p), _ -> out });
  let own = rows_of(c);
  let held = own.rows.fold(
    own.atoms.fold([], |out: List<Int>, a: Atom|
      match a.resource { ResourceVariable(p) -> out.push(p), _ -> out }),
    |out: List<Int>, r: Row| out.concat(places(row_evidence(r, cx.rows, cx.labels))),
  );
  let named = match c.node {
    CodeVar(v) ->
      range(0, cx.label_names.len()).filter(|i: Int|
        match cx.label_names.at(i) {
          Some(n) -> Bytes::concat_all([b"[", n, b"]"]) == v.name,
          None -> false,
        }),
    _ -> [],
  };
  code_children(c).fold(
    held.concat(named).fold(acc, |out: List<Int>, p: Int|
      if out.contains(p) { out } else { out.push(p) }),
    |out: List<Int>, x: Code| labels_read(cx, x, out),
  )
}

pub fn words_of(cx: Context, row: Row) -> List<RowEvidence> / {abort.raise} =
  row_evidence(row, cx.rows, cx.labels)

pub fn evidence_for(cx: Context, wanted: List<RowEvidence>) -> List<Arg> =
  wanted.fold(
    { out: [], seen: [] },
    |acc: { out: List<Arg>, seen: List<Evidence> }, w: RowEvidence|
      if w.through {
        let n = acc.seen.filter(|e: Evidence| e == w.evidence).len();
        let alike = cx.words.filter(|x: EvidenceWord|
          x.through && !x.handled && x.evidence == w.evidence);
        {
          out: acc.out.push(match alike.at(n) {
            Some(x) -> x.word,
            None -> ZeroOperand(AsImmediate),
          }),
          seen: acc.seen.push(w.evidence),
        }
      } else {
        {
          ..acc,
          out: acc.out.push(
            match cx.words.find(|x: EvidenceWord| !x.through && covers(x.evidence, w.evidence)) {
              Some(x) -> x.word,
              None -> ZeroOperand(AsImmediate),
            },
          ),
        }
      },
  ).out

pub fn outer_evidence(cx: Context, e: Evidence) -> Arg =
  match cx.words.find(|x: EvidenceWord| !x.through && covers(x.evidence, e)) {
    Some(x) -> x.word,
    None -> match cx.words.find(|x: EvidenceWord| x.through && covers(x.evidence, e)) {
      Some(x) -> x.word,
      None -> ZeroOperand(AsImmediate),
    },
  }

pub fn label_value(cx: Context, p: Int) -> Arg =
  match cx.label_values.at(p) { Some(Some(a)) -> a, _ -> IntOperand(0) }

pub type EvidenceArguments = {
  rows: List<List<Evidence>>,
  labels: List<Arg>,
  words: List<Arg>,
  wanted: List<RowEvidence>,
}

type EvidencePair = { callee: Evidence, wanted: RowEvidence }

pub fn evidence_arguments(
  cx: Context,
  st: Lowering,
  d: Def,
  func: Code,
  labels: List<Code>,
) -> EvidenceArguments / {abort.raise} =
  evidence_arguments_filled(cx, d, match func.node { NDef(r) -> r.rows, _ -> [] }, labels)

pub fn evidence_arguments_filled(
  cx: Context,
  d: Def,
  filled: List<Row>,
  labels: List<Code>,
) -> EvidenceArguments / {abort.raise} = scheme_evidence_arguments(cx, d.scheme, filled, labels)

pub fn scheme_evidence_arguments(
  cx: Context,
  scheme: Option<Scheme>,
  filled: List<Row>,
  labels: List<Code>,
) -> EvidenceArguments / {abort.raise} =
  match scheme {
    None -> { rows: [], labels: [], words: [], wanted: [] },
    Some(sc) -> {
      let given = filled.map(|r: Row| row_evidence(r, cx.rows, cx.labels));
      let k = renumber_labels(
        given.map(|ws: List<RowEvidence>| ws.map(|o: RowEvidence| o.evidence)),
      );
      let row = declared_row(sc);
      let own_labels = sc.label_vars.len();
      let written = row.atoms.fold([], |acc: List<EvidencePair>, a: Atom|
        if !needs_evidence(a.effect) { acc } else {
          let callee = { effect: a.effect, resource: a.resource };
          if acc.any(|p: EvidencePair| p.callee == callee) { acc } else {
            acc.push({
              callee: callee,
              wanted: {
                evidence: { effect: a.effect, resource: filled_label(cx, labels, a.resource) },
                through: false,
              },
            })
          }
        });
      let through = match row.tail {
        None -> [],
        Some(t) -> match ((k.rows.at(t), given.at(t))) {
          (Some(keys), Some(ws)) ->
            keys.fold([], |acc: List<EvidencePair>, x: KeyedEvidence|
              match ws.at(x.from) {
                Some(o) ->
                  acc.push({
                    callee: match offset_labels([x.key], own_labels).at(0) {
                      Some(e) -> e,
                      None -> x.key,
                    },
                    wanted: o,
                  }),
                None -> acc,
              }),
          _ -> [],
        },
      };
      let pairs = sorted_by_evidence(written.concat(through), |p: EvidencePair| p.callee);
      let wanted = pairs.map(|p: EvidencePair| p.wanted);
      {
        rows: key_rows_of(k.rows),
        labels: k.sources.map(|p: Int| label_value(cx, p)),
        words: evidence_for(cx, wanted),
        wanted: wanted,
      }
    },
  }

pub fn passed_evidence_arguments(
  st: Lowering,
  h: EvidenceArguments,
  at: Span,
) -> { st: Lowering, args: List<Arg> } = {
  let words = bridged(st, h.words, at);
  if words.args.len() <= max_evidence_params() {
    { st: words.st, args: h.labels.concat(words.args) }
  } else {
    let laid = bound_as(
      words.st,
      evidence_array_type(),
      AsImmediate,
      Op({ op: OfHandling(WordArray), args: words.args, uses: reads(words.args.len()) }),
      at,
    );
    { st: laid.st, args: h.labels.push(laid.arg) }
  }
}

pub fn captured_evidence_for(
  cx: Context,
  st: Lowering,
  own: List<RowEvidence>,
  at: Span,
) -> { st: Lowering, words: List<EvidenceWord> } = {
  let words = bridged(st, evidence_for(cx, own), at);
  {
    st: words.st,
    words: range(0, own.len()).fold([], |acc: List<EvidenceWord>, k: Int|
      match ((own.at(k), words.args.at(k))) {
        (Some(o), Some(w)) ->
          acc.push({ evidence: o.evidence, word: w, through: o.through, handled: false }),
        _ -> acc,
      }),
  }
}

pub fn bridged(st: Lowering, words: List<Arg>, at: Span) -> { st: Lowering, args: List<Arg> } =
  if !words.contains(ZeroOperand(AsImmediate)) { { st: st, args: words } } else {
    let b = bound_as(
      st,
      evidence_type(),
      AsImmediate,
      Op({ op: OfHandling(SchedulerEvidence), args: [], uses: reads(0) }),
      at,
    );
    { st: b.st, args: words.map(|w: Arg| if w == ZeroOperand(AsImmediate) { b.arg } else { w }) }
  }

pub fn label_codes(d: Def, codes: List<Code>) -> List<Code> =
  match d.scheme { Some(sc) -> labels_among(codes, sc.label_vars.len()), None -> [] }

fn filled_label(cx: Context, labels: List<Code>, r: Resource) -> Resource / {abort.raise} =
  match r {
    ResourceVariable(q) -> match labels.at(q) {
      Some(c) -> label_resource(cx, c),
      None -> unfilled(),
    },
    _ -> r,
  }

pub fn label_resource(cx: Context, c: Code) -> Resource / {abort.raise} =
  match c.node {
    CodeLabel(n) -> NamedResource(n),
    CodeVar(v) -> if !is_label_binder(v.name) { unfilled() } else {
      let name = v.name.slice(1, v.name.len() - 1);
      match range(0, cx.label_names.len()).find(|i: Int| cx.label_names.at(i) == Some(name)) {
        Some(p) -> ResourceVariable(p),
        None -> unfilled(),
      }
    },
    _ -> unfilled(),
  }

fn unfilled() -> Resource = NamedResource(b"?")

pub fn function_value_evidence(
  cx: Context,
  st: Lowering,
  row: Row,
  at: Span,
) -> { st: Lowering, args: List<Arg> } / {abort.raise} =
  wanted_handing(cx, st, row_evidence(row, cx.rows, cx.labels), at)

pub fn wanted_handing(
  cx: Context,
  st: Lowering,
  wanted: List<RowEvidence>,
  at: Span,
) -> { st: Lowering, args: List<Arg> } / {abort.raise} = {
  let words = bridged(st, evidence_for(cx, wanted), at);
  let left = wanted.fold([], |acc: List<Arg>, o: RowEvidence|
    match o.evidence.resource { ResourceVariable(p) -> acc.push(label_value(cx, p)), _ -> acc });
  let d = static_added(words.st, row_descriptor(wanted.map(|o: RowEvidence| o.evidence)));
  let desc = bound_as(d.st, row_descriptor_type(), AsImmediate, Static(d.name), at);
  let all = words.args.concat(left);
  if all.len() == 0 { { st: desc.st, args: [desc.arg, ZeroOperand(AsImmediate)] } } else {
    let laid = bound_as(
      desc.st,
      evidence_array_type(),
      AsImmediate,
      Op({ op: OfHandling(WordArray), args: all, uses: reads(all.len()) }),
      at,
    );
    { st: laid.st, args: [desc.arg, laid.arg] }
  }
}

pub fn row_descriptor(ws: List<Evidence>) -> StaticLayout =
  StaticWords(
    [RawWord(ws.len())].concat(
      ws.fold([], |acc: List<StaticWord>, w: Evidence|
        acc.push(FieldWord(w.effect)).push(match w.resource {
          SingletonResource -> RawWord(0 - 1),
          AnyResource -> RawWord(0 - 2),
          ResourceVariable(_) -> RawWord(0 - 3),
          NamedResource(n) -> FieldWord(n),
        })),
    ),
  )

pub fn label_values_at(cx: Context, places: List<Int>, values: List<Arg>) -> List<Option<Arg>> =
  range(0, cx.labels + passed_label_count(cx.rows)).map(|p: Int|
    match range(0, places.len()).find(|i: Int| places.at(i) == Some(p)) {
      Some(i) -> values.at(i),
      None -> None,
    })

pub fn caller_filled_labels(own: List<RowEvidence>) -> List<Int> =
  own.fold([], |acc: List<Int>, o: RowEvidence|
    match o.evidence.resource {
      ResourceVariable(p) -> if acc.contains(p) { acc } else { acc.push(p) },
      _ -> acc,
    })
