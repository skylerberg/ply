pub fn left_to_callers(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  types: CallTypes,
  at: Span,
) -> LoweredValue =
  bound(
    context,
    types.params.push(types.result_type).fold(st, |s: Lowering, t: Type|
      type_variables(t).fold(s, |n: Lowering, v: Int| with_need(n, { var: v, reads: Exact }))),
    types.result_type,
    OperationCall({
      operation: OfHandling(UnspecialisedBuiltin(name)),
      args: args,
      uses: { takes: args.map(|_: Arg| false), owned: true, fails: true, suspends: false },
    }),
    at,
  )

pub fn marshalling_builtin(name: Bytes) -> Bool =
  marshalling_native_named(name) != None || name == b"?lower" || name == b"?lift"
    || name == b"?out_carried"
    || handler_builtin(name)

pub fn marshalling_builtin_call(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let at_type = called_at(context, callee, args);
  if name == b"?lower" {
    match args {
      [x] -> serialize_part(context, st, x, at_type, at),
      _ -> unreachable(b"`?lower` must take exactly one argument"),
    }
  } else if name == b"?lift" { deserialize_part(context, st, at_type, at) }
  else if name == b"?out_carried" {
    match args {
      [x] -> {
        let word = represented_as({ st: st, arg: x }, AsWord, at);
        let d = serializable_type_descriptor(context, word.st, at_type, at);
        unit_after(native_for_effect(d.st, b"?out_carried", [word.arg, d.arg], false, at))
      },
      _ -> unreachable(b"`?out_carried` must take exactly one argument"),
    }
  } else if handler_builtin(name) { handler_variable(context, st, name, args, callee, at) } else {
    match marshalling_native_named(name) {
      Some(m) -> marshalling_native_call(context, st, m, args, at_type, at),
      None -> unreachable(b"the compiler does not support this conversion builtin: ".concat(name)),
    }
  }
}

fn handler_builtin(name: Bytes) -> Bool =
  name == b"?handler_init" || name == b"?handler_var" || name == b"?handler_set"

fn handler_variable(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match context.instance {
    Some(i) -> instance_variable(context, st, i, name, args, callee, at),
    None -> unreachable(b"a handler variable is used outside every handle expression"),
  }

fn instance_variable(
  context: Context,
  st: Lowering,
  i: HandlerInstance,
  name: Bytes,
  args: List<Arg>,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let place = |a: Arg| match a { IntOperand(n) -> Some(i.variable_count + 2 * n), _ -> None };
  let handling_operation = |o: HandleOperation, operands: List<Arg>, takes: List<Bool>|
    OperationCall({
      operation: OfHandling(o),
      args: [i.word].concat(operands),
      uses: {
        takes: [false].concat(takes),
        owned: takes.len() == 0,
        fails: false,
        suspends: false,
      },
    });
  match args {
    [p] -> if name != b"?handler_var" {
      unreachable(b"only `?handler_var` may be called with one argument")
    } else {
      match ((place(p), callee.ty)) {
        (Some(word_at), FunctionType(t)) ->
          represented_as(
            bound_as(
              st,
              t.return_type,
              AsWord,
              handling_operation(VariableRead(word_at), [], []),
              at,
            ),
            representation_of(context.setting, t.return_type),
            at,
          ),
        _ -> unreachable(b"a handler variable read has no known storage location or function type"),
      }
    },
    [p, x] -> match place(p) {
      None ->
        unreachable(b"the first operand of a handler variable builtin is not a storage location"),
      Some(word_at) -> {
        let word = represented_as({ st: st, arg: x }, AsWord, at);
        if name == b"?handler_init" {
          let d = type_descriptor(context, word.st, type_of(x), at);
          unit_after(
            run_for_effect(
              d.st,
              handling_operation(VariableInitialize(word_at), [word.arg, d.arg], [true, false]),
              at,
            ),
          )
        } else if name == b"?handler_set" {
          unit_after(
            run_for_effect(
              word.st,
              handling_operation(VariableWrite(word_at), [word.arg], [true]),
              at,
            ),
          )
        } else {
          unreachable(
            b"a handler variable builtin that takes a value must be an initialization or an assignment",
          )
        }
      },
    },
    _ -> unreachable(b"a handler variable builtin must take one or two operands"),
  }
}

pub fn called_at(context: Context, callee: Code, args: List<Arg>) -> Type =
  match read_typed(callee).args.at(0) {
    Some(a) -> a,
    None -> match args.at(0) { Some(x) -> type_of(x), None -> unknown_type() },
  }

fn serialize_part(
  context: Context,
  st: Lowering,
  x: Arg,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let unmarked_type = marks_of(ty).ty;
  if !fully_known(unmarked_type) {
    unreachable(b"a value is converted at a type that is not fully known")
  } else {
    let conv = typed_convention(context.setting.constructors, [unmarked_type], unit_type());
    let h = represented_as(
      { st: st, arg: x },
      representation_of(context.setting, unmarked_type),
      at,
    );
    bound_as(
      h.st,
      unit_type(),
      conv.result,
      Call({
        callee: Root(marked_key(Lower, ty, context.setting.module)),
        args: [h.arg],
        convention: conv,
        suspends: false,
      }),
      at,
    )
  }
}

fn deserialize_part(
  context: Context,
  st: Lowering,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let unmarked_type = marks_of(ty).ty;
  if !fully_known(unmarked_type) {
    unreachable(b"`?lift` is called at a type that is not fully known")
  } else {
    let conv = typed_convention(context.setting.constructors, [], unmarked_type);
    bound_as(
      st,
      unmarked_type,
      conv.result,
      Call({
        callee: Root(marked_key(Lift, ty, context.setting.module)),
        args: [],
        convention: conv,
        suspends: false,
      }),
      at,
    )
  }
}

pub fn fully_known(ty: Type) -> Bool =
  match ty {
    NamedType(c) -> ty != word_type() && c.args.all(fully_known),
    VariableType(_) -> false,
    FunctionType(f) -> f.params.push(f.return_type).all(fully_known),
    RecordType(fs) -> fs.all(|f: Field| fully_known(f.ty)),
    NominalType(x) -> x.fields.all(|f: Field| fully_known(f.ty)),
  }

fn shown(
  context: Context,
  st: Lowering,
  x: Arg,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let opened = native_for_effect(st, b"?shown_open", [], false, at);
  let written = serialize_part(context, opened, x, ty, at);
  let n = native_int(written.st, b"?lower_close", [], true, at);
  taken_out(n.st, n.arg, bytes_type(), at)
}

pub fn assertion_failed(
  context: Context,
  st: Lowering,
  actual: Arg,
  expected: Arg,
  ty: Type,
  at: Span,
) -> Lowering / {abort.raise} = {
  let a = shown(context, st, actual, ty, at);
  let e = shown(context, a.st, expected, ty, at);
  let a_at = bytes_address(e.st, a.arg, at);
  let e_at = bytes_address(a_at.st, e.arg, at);
  let args = [a_at.address, a_at.count, e_at.address, e_at.count];
  run_for_effect(
    e_at.st,
    Native({
      name: b"ply_assert_failed",
      args: args,
      uses: { takes: args.map(|_: Arg| false), owned: false, fails: true, suspends: false },
    }),
    at,
  )
}

type NativeOperand = | Bits | FloatBits | Text | Object

type NativeReturn = | Nothing | WithBits | WithFloat | WithBytes

type MarshallingNative = {
  name: Bytes,
  takes: List<NativeOperand>,
  result: NativeReturn,
  fails: Bool,
}

fn marshalling_natives() -> List<MarshallingNative> =
  [
    { name: b"?out_tag", takes: [Bits], result: Nothing, fails: false },
    { name: b"?out_int", takes: [Bits], result: Nothing, fails: false },
    { name: b"?out_float", takes: [FloatBits], result: Nothing, fails: false },
    { name: b"?out_char", takes: [Bits], result: Nothing, fails: true },
    { name: b"?out_str", takes: [Text], result: Nothing, fails: false },
    { name: b"?out_bytes", takes: [Text], result: Nothing, fails: false },
    { name: b"?out_count", takes: [Bits, Bits], result: Nothing, fails: false },
    { name: b"?out_ctor", takes: [Text, Bits], result: Nothing, fails: false },
    { name: b"?out_name", takes: [Text], result: Nothing, fails: false },
    { name: b"?out_handle", takes: [Object], result: Nothing, fails: false },
    { name: b"?out_fun", takes: [Object, Text], result: Nothing, fails: false },
    { name: b"?out_again", takes: [Object], result: WithBits, fails: false },
    { name: b"?in_tag", takes: [], result: WithBits, fails: true },
    { name: b"?in_int", takes: [], result: WithBits, fails: true },
    { name: b"?in_float", takes: [], result: WithFloat, fails: true },
    { name: b"?in_char", takes: [], result: WithBits, fails: true },
    { name: b"?in_str", takes: [], result: WithBytes, fails: true },
    { name: b"?in_bytes", takes: [], result: WithBytes, fails: true },
    { name: b"?in_count", takes: [Bits], result: WithBits, fails: true },
    { name: b"?in_field", takes: [Text], result: Nothing, fails: true },
    { name: b"?in_name_is", takes: [Text], result: WithBits, fails: true },
    { name: b"?lift_close", takes: [], result: Nothing, fails: true },
    { name: b"?out_decimal", takes: [], result: Nothing, fails: false },
    { name: b"?out_fixed", takes: [], result: Nothing, fails: false },
    { name: b"?in_decimal", takes: [], result: Nothing, fails: true },
    { name: b"?in_fixed", takes: [], result: Nothing, fails: true },
  ]

fn marshalling_native_named(name: Bytes) -> Option<MarshallingNative> =
  marshalling_natives().fold(None, |accumulator: Option<MarshallingNative>, m: MarshallingNative|
    if m.name == name { Some(m) } else { accumulator })

fn marshalling_native_call(
  context: Context,
  st: Lowering,
  m: MarshallingNative,
  args: List<Arg>,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} =
  if m.name == b"?out_decimal" { decimal_out(context, st, args, at) }
  else if m.name == b"?out_fixed" { write_fixed_width(context, st, args, at) }
  else if m.name == b"?in_decimal" { decimal_in(context, st, ty, at) }
  else if m.name == b"?in_fixed" { fixed_in(context, st, ty, at) }
  else if args.len() != m.takes.len() {
    unreachable(
      b"an internal conversion function was called with the wrong number of arguments: ".concat(
        m.name,
      ),
    )
  } else {
    let given = range(0, args.len()).fold(
      { st: st, args: [] },
      |accumulator: { st: Lowering, args: List<Arg> }, i: Int|
        match m.takes.get(i) {
          Bits -> {
            let h = represented_as({ st: accumulator.st, arg: args.get(i) }, AsInt, at);
            { st: h.st, args: accumulator.args.push(h.arg) }
          },
          FloatBits -> {
            let f = represented_as({ st: accumulator.st, arg: args.get(i) }, AsFloat, at);
            let b = bound_as(
              f.st,
              int_type(),
              AsInt,
              Primitive({ operation: b"bits", on: AsFloat, args: [f.arg] }),
              at,
            );
            { st: b.st, args: accumulator.args.push(b.arg) }
          },
          Text -> {
            let a = bytes_address(accumulator.st, args.get(i), at);
            { st: a.st, args: accumulator.args.push(a.address).push(a.count) }
          },
          Object -> {
            let h = represented_as({ st: accumulator.st, arg: args.get(i) }, AsWord, at);
            { st: h.st, args: accumulator.args.push(h.arg) }
          },
        },
    );
    match m.result {
      Nothing -> unit_after(native_for_effect(given.st, m.name, given.args, m.fails, at)),
      WithBits -> native_int(given.st, m.name, given.args, m.fails, at),
      WithFloat -> {
        let b = native_int(given.st, m.name, given.args, m.fails, at);
        bound_as(
          b.st,
          float_type(),
          AsFloat,
          Primitive({ operation: b"of_bits", on: AsInt, args: [b.arg] }),
          at,
        )
      },
      WithBytes -> {
        let n = native_int(given.st, m.name, given.args, m.fails, at);
        taken_out(n.st, n.arg, ty, at)
      },
    }
  }

fn decimal_out(
  context: Context,
  st: Lowering,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args {
    [d] -> {
      let w = pair_words(st, d, AsDecimal, at);
      unit_after(native_for_effect(w.st, b"?out_decimal", [w.lo, w.hi], false, at))
    },
    _ -> unreachable(b"writing a `Decimal` needs exactly one argument"),
  }

fn write_fixed_width(
  context: Context,
  st: Lowering,
  args: List<Arg>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args {
    [x] -> match width_of(type_of(x)) {
      None ->
        unreachable(
          b"writing a fixed-size integer, but the argument's type is not a fixed-size integer type",
        ),
      Some(w) -> if w.bits <= 64 {
        let h = represented_as({ st: st, arg: x }, AsFixed(w), at);
        let lo = bound_as(
          h.st,
          int_type(),
          AsInt,
          Primitive({ operation: b"narrow", on: AsFixed(w), args: [h.arg] }),
          at,
        );
        unit_after(
          native_for_effect(
            lo.st,
            b"?out_fixed",
            [IntOperand(width_index(w)), lo.arg, IntOperand(0)],
            false,
            at,
          ),
        )
      } else {
        let p = pair_words(st, x, AsWideFixed(w), at);
        unit_after(
          native_for_effect(
            p.st,
            b"?out_fixed",
            [IntOperand(width_index(w)), p.lo, p.hi],
            false,
            at,
          ),
        )
      },
    },
    _ -> unreachable(b"writing a fixed-width integer needs exactly one argument"),
  }

fn decimal_in(context: Context, st: Lowering, ty: Type, at: Span) -> LoweredValue / {abort.raise} = {
  let lo = native_int(st, b"?in_decimal", [], true, at);
  let hi = native_int(lo.st, b"?in_high", [], false, at);
  bound_as(
    hi.st,
    decimal_type(),
    AsDecimal,
    Primitive({ operation: b"decimal", on: AsInt, args: [lo.arg, hi.arg] }),
    at,
  )
}

fn fixed_in(context: Context, st: Lowering, ty: Type, at: Span) -> LoweredValue / {abort.raise} =
  match width_of(ty) {
    None ->
      unreachable(
        b"reading a fixed-size integer, but the expected type is not a fixed-size integer type",
      ),
    Some(w) -> {
      let lo = native_int(st, b"?in_fixed", [IntOperand(width_index(w))], true, at);
      if w.bits <= 64 {
        bound_as(
          lo.st,
          ty,
          AsFixed(w),
          Primitive({ operation: b"narrow", on: AsInt, args: [lo.arg] }),
          at,
        )
      } else {
        let hi = native_int(lo.st, b"?in_high", [], false, at);
        bound_as(
          hi.st,
          ty,
          AsWideFixed(w),
          Primitive({ operation: b"wide", on: AsInt, args: [lo.arg, hi.arg] }),
          at,
        )
      }
    },
  }

fn width_of(ty: Type) -> Option<Width> =
  match ty { NamedType(c) -> if c.args.len() == 0 { width_named(c.name) } else { None }, _ -> None }

fn word_variable(l: LoweredValue) -> Option<Variable> =
  match l.arg { VariableOperand(v) -> Some(v), _ -> None }

pub fn bytes_address(
  st: Lowering,
  b: Arg,
  at: Span,
) -> { st: Lowering, address: Arg, count: Arg } / {abort.raise} = {
  let w = represented_as({ st: st, arg: b }, AsWord, at);
  match word_variable(w) {
    None -> unreachable(b"a byte string is not stored in a variable"),
    Some(v) -> {
      let a = bound_as(w.st, int_type(), AsAddress, Get({ of: v, path: PayloadPath }), at);
      let n = bound_as(
        a.st,
        int_type(),
        AsInt,
        OperationCall({
          operation: OfContainers(Length),
          args: [VariableOperand(v)],
          uses: { takes: [false], owned: false, fails: false, suspends: false },
        }),
        at,
      );
      { st: n.st, address: a.arg, count: n.arg }
    },
  }
}

pub fn taken_out(st: Lowering, n: Arg, ty: Type, at: Span) -> LoweredValue =
  bound_as(
    st,
    ty,
    AsWord,
    OperationCall({
      operation: OfContainers(CopyOut),
      args: [n],
      uses: { takes: [false], owned: true, fails: true, suspends: false },
    }),
    at,
  )

pub fn native_of(name: Bytes) -> Bytes / {abort.raise} = builtin_helper(name).concat(b"_p")

fn native_uses(args: List<Arg>, fails: Bool) -> OperationSignature =
  { takes: args.map(|_: Arg| false), owned: true, fails: fails, suspends: false }

fn native_for_effect(
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  fails: Bool,
  at: Span,
) -> Lowering / {abort.raise} =
  run_for_effect(
    st,
    Native({
      name: native_of(name),
      args: args,
      uses: { takes: args.map(|_: Arg| false), owned: false, fails: fails, suspends: false },
    }),
    at,
  )

fn native_int(
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  fails: Bool,
  at: Span,
) -> LoweredValue / {abort.raise} =
  bound_as(
    st,
    int_type(),
    AsInt,
    Native({ name: native_of(name), args: args, uses: native_uses(args, fails) }),
    at,
  )

fn unit_after(st: Lowering) -> LoweredValue = { st: st, arg: ZeroOperand(AsUnit) }

pub fn concatenated(
  context: Context,
  st: Lowering,
  a: Arg,
  b: Arg,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let w = represented_as({ st: st, arg: a }, AsWord, at);
  let t = bytes_address(w.st, b, at);
  let args = [w.arg, t.address, t.count];
  let g = bound_as(
    t.st,
    ty,
    AsWord,
    OperationCall({
      operation: OfStrings(AppendBytes),
      args: args,
      uses: string_signature(AppendBytes),
    }),
    at,
  );
  represented_as(g, representation_of(context.setting, ty), at)
}

pub fn machine_word_call(
  context: Context,
  st: Lowering,
  name: Bytes,
  call: MachineCall,
  args: List<Arg>,
  result: Option<Type>,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} =
  if args.len() != call.params.len() {
    unreachable(
      b"a runtime function that takes plain integers or floats was called with the wrong number of arguments: ".concat(
        name,
      ),
    )
  } else {
    let borrowed = |accumulator: { st: Lowering, args: List<Arg>, takes: List<Bool> }, a: Arg| {
      let h = represented_as({ st: accumulator.st, arg: a }, AsWord, at);
      { st: h.st, args: accumulator.args.push(h.arg), takes: accumulator.takes.push(false) }
    };
    let given = range(0, args.len()).fold(
      { st: st, args: [], takes: [] },
      |accumulator: { st: Lowering, args: List<Arg>, takes: List<Bool> }, i: Int|
        match call.params.get(i) {
          MachineInt(t) -> match match t {
              NamedType(c) -> scalar_words(context, accumulator.st, args.get(i), c.name, at),
              _ -> None,
            } {
            Some(w) ->
              { st: w.st, args: accumulator.args.push(w.lo), takes: accumulator.takes.push(false) },
            None ->
              unreachable(
                b"an integer argument of a runtime function does not have an integer type",
              ),
          },
          MachineFloat -> {
            let f = represented_as({ st: accumulator.st, arg: args.get(i) }, AsFloat, at);
            let b = bound_as(
              f.st,
              int_type(),
              AsInt,
              Primitive({ operation: b"bits", on: AsFloat, args: [f.arg] }),
              at,
            );
            { st: b.st, args: accumulator.args.push(b.arg), takes: accumulator.takes.push(false) }
          },
          MachineText(_) -> {
            let a = bytes_address(accumulator.st, args.get(i), at);
            {
              st: a.st,
              args: accumulator.args.push(a.address).push(a.count),
              takes: accumulator.takes.push(false).push(false),
            }
          },
          MachineSecret(_) -> borrowed(accumulator, args.get(i)),
          MachineObject(_) -> borrowed(accumulator, args.get(i)),
          MachineTypeVariable(_) -> {
            let h = represented_as({ st: accumulator.st, arg: args.get(i) }, AsWord, at);
            let d = type_descriptor(context, h.st, type_of(args.get(i)), at);
            {
              st: d.st,
              args: accumulator.args.push(h.arg).push(d.arg),
              takes: accumulator.takes.push(true).push(false),
            }
          },
          MachineFunction(k) -> {
            let f = borrowed(accumulator, args.get(i));
            match match callee.node { NBuiltin(b) -> b.effect_arguments.at(k), _ -> None } {
              None ->
                unreachable(b"a function passed to a runtime function has no declared effects"),
              Some(r) -> {
                let e = function_value_evidence(context, f.st, r, at);
                { st: e.st, args: f.args.concat(e.args), takes: f.takes.push(false).push(false) }
              },
            }
          },
          MachineUnit -> accumulator,
        },
    );
    let made = { name: name, args: given.args, takes: given.takes };
    let returned_as = |declared: Type| match result { Some(t) -> t, None -> declared };
    match call.result {
      MachineUnit -> {
        let n = native_call(made);
        unit_after(run_for_effect(given.st, Native({ ..n, uses: { ..n.uses, owned: false } }), at))
      },
      MachineText(t) -> {
        let n = native_word(given.st, made, at);
        taken_out(n.st, n.arg, t, at)
      },
      MachineSecret(t) -> object_returned(context, given.st, made, returned_as(t), at),
      MachineObject(t) -> object_returned(context, given.st, made, returned_as(t), at),
      MachineTypeVariable(_) -> match result {
        None ->
          unreachable(
            b"a runtime function returns a generic type, but the compiler has no concrete type for the result",
          ),
        Some(t) -> {
          let d = type_descriptor(context, given.st, t, at);
          object_returned(
            context,
            d.st,
            { ..made, args: made.args.push(d.arg), takes: made.takes.push(false) },
            t,
            at,
          )
        },
      },
      MachineFunction(_) -> unreachable(b"a native returning a function value"),
      MachineFloat -> {
        let b = native_word(given.st, made, at);
        bound_as(
          b.st,
          float_type(),
          AsFloat,
          Primitive({ operation: b"of_bits", on: AsInt, args: [b.arg] }),
          at,
        )
      },
      MachineInt(t) -> integer_returned(native_word(given.st, made, at), t, at),
    }
  }

type NativeCall = { name: Bytes, args: List<Arg>, takes: List<Bool> }

fn native_call(
  m: NativeCall,
) -> { name: Bytes, args: List<Arg>, uses: OperationSignature } / {abort.raise} =
  {
    name: native_of(m.name),
    args: m.args,
    uses: { takes: m.takes, owned: true, fails: true, suspends: false },
  }

fn native_word(st: Lowering, m: NativeCall, at: Span) -> LoweredValue / {abort.raise} =
  bound_as(st, int_type(), AsInt, Native(native_call(m)), at)

fn object_returned(
  context: Context,
  st: Lowering,
  m: NativeCall,
  t: Type,
  at: Span,
) -> LoweredValue / {abort.raise} =
  represented_as(
    bound_as(st, t, AsWord, Native(native_call(m)), at),
    representation_of(context.setting, t),
    at,
  )

fn integer_returned(w: LoweredValue, t: Type, at: Span) -> LoweredValue =
  match t {
    NamedType(c) -> if is_bool(t) {
      bound_as(
        w.st,
        t,
        AsBool,
        Primitive({ operation: b"ne", on: AsInt, args: [w.arg, IntOperand(0)] }),
        at,
      )
    } else if is_char(t) {
      bound_as(
        w.st,
        t,
        AsImmediate,
        Primitive({ operation: b"char_of", on: AsInt, args: [w.arg] }),
        at,
      )
    } else {
      match width_named(c.name) {
        Some(n) ->
          bound_as(
            w.st,
            t,
            AsFixed(n),
            Primitive({ operation: b"narrow", on: AsInt, args: [w.arg] }),
            at,
          ),
        None -> w,
      }
    },
    _ -> w,
  }

pub fn blake3_of(st: Lowering, a: Arg, at: Span) -> LoweredValue / {abort.raise} = {
  let t = bytes_address(st, a, at);
  let n = native_int(t.st, b"?blake3", [t.address, t.count], false, at);
  taken_out(n.st, n.arg, bytes_type(), at)
}

pub fn scalar_encoding(
  context: Context,
  st: Lowering,
  a: Arg,
  ty: Type,
  at: Span,
) -> Option<LoweredValue> / {abort.raise} =
  match ty {
    NamedType(c) -> if c.args.len() > 0 { None } else if is_string(ty) || is_bytes(ty) {
      let t = bytes_address(st, a, at);
      let text = IntOperand(if is_string(ty) { 1 } else { 0 });
      Some(encoded(t.st, b"ply_text_encoded", [text, t.address, t.count], at))
    } else {
      match scalar_words(context, st, a, c.name, at) {
        None -> None,
        Some(w) ->
          Some(
            encoded(
              w.st,
              b"ply_scalar_encoded",
              [IntOperand(w.kind), IntOperand(w.t), w.lo, w.hi],
              at,
            ),
          ),
      }
    },
    _ -> None,
  }

fn encoded(st: Lowering, name: Bytes, args: List<Arg>, at: Span) -> LoweredValue =
  bound_as(
    st,
    bytes_type(),
    AsWord,
    Native({ name: name, args: args, uses: native_uses(args, false) }),
    at,
  )

fn scalar_words(
  context: Context,
  st: Lowering,
  a: Arg,
  name: Bytes,
  at: Span,
) -> Option<{ st: Lowering, kind: Int, t: Int, lo: Arg, hi: Arg }> =
  if name == unit_name() { Some({ st: st, kind: 0, t: 0, lo: IntOperand(0), hi: IntOperand(0) }) }
  else if name == bool_name() {
    let b = represented_as({ st: st, arg: a }, AsBool, at);
    Some({ st: b.st, kind: 1, t: 0, lo: b.arg, hi: IntOperand(0) })
  } else if name == int_name() {
    let n = represented_as({ st: st, arg: a }, AsInt, at);
    Some({ st: n.st, kind: 2, t: 0, lo: n.arg, hi: IntOperand(0) })
  } else if name == char_name() {
    let k = represented_as({ st: st, arg: a }, AsImmediate, at);
    let v = bound_as(
      k.st,
      int_type(),
      AsInt,
      Primitive({ operation: b"char_code", on: AsImmediate, args: [k.arg] }),
      at,
    );
    Some({ st: v.st, kind: 4, t: 0, lo: v.arg, hi: IntOperand(0) })
  } else if name == decimal_name() {
    let p = pair_words(st, a, AsDecimal, at);
    Some({ st: p.st, kind: 5, t: 0, lo: p.lo, hi: p.hi })
  } else {
    match width_named(name) {
      None -> None,
      Some(w) -> if w.bits > 64 {
        let p = pair_words(st, a, AsWideFixed(w), at);
        Some({ st: p.st, kind: 3, t: width_index(w), lo: p.lo, hi: p.hi })
      } else {
        let x = represented_as({ st: st, arg: a }, AsFixed(w), at);
        let n = bound_as(
          x.st,
          int_type(),
          AsInt,
          Primitive({ operation: b"narrow", on: AsFixed(w), args: [x.arg] }),
          at,
        );
        if w.bits < 64 { Some({ st: n.st, kind: 2, t: 0, lo: n.arg, hi: IntOperand(0) }) }
        else { Some({ st: n.st, kind: 3, t: width_index(w), lo: n.arg, hi: IntOperand(0) }) }
      },
    }
  }

pub fn type_descriptor(
  context: Context,
  st: Lowering,
  t: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = described(context, st, t, false, at)

pub fn serializable_type_descriptor(
  context: Context,
  st: Lowering,
  t: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = described(context, st, t, true, at)

fn described(
  context: Context,
  st: Lowering,
  t: Type,
  shown: Bool,
  at: Span,
) -> LoweredValue / {abort.raise} =
  if !fully_known(t) {
    bound_as(
      type_variables(t).fold(st, |s: Lowering, v: Int| with_need(s, { var: v, reads: Exact })),
      int_type(),
      AsInt,
      OperationCall({
        operation: OfHandling(UnspecialisedBuiltin(b"type#".concat(encode_type(t)))),
        args: [],
        uses: { takes: [], owned: false, fails: false, suspends: false },
      }),
      at,
    )
  } else {
    let s = type_static(
      context.setting.constructors,
      context.setting.module,
      st,
      t,
      function_marks(t),
      shown,
    );
    bound_as(s.st, int_type(), AsInt, Static(s.name), at)
  }

pub fn dynamic_descriptor(
  context: Context,
  st: Lowering,
  t: Type,
  built: { equal: Bool, order: Bool },
  at: Span,
) -> LoweredValue / {abort.raise} =
  if !fully_known(t) {
    bound_as(
      type_variables(t).fold(st, |s: Lowering, v: Int| with_need(s, { var: v, reads: Exact })),
      int_type(),
      AsInt,
      OperationCall({
        operation: OfHandling(UnspecialisedBuiltin(b"kept#".concat(encode_type(t)))),
        args: [],
        uses: { takes: [], owned: false, fails: false, suspends: false },
      }),
      at,
    )
  } else {
    let module = context.setting.module;
    let ty = type_static(context.setting.constructors, module, st, t, function_marks(t), false);
    let entry = |type_operation: TypeOperation, built: Bool|
      if built { EntryWord(keys::generated_key(OnWordForm(type_operation), t, module)) }
      else { RawWord(0) };
    let k = static_added(
      ty.st,
      StaticStruct({
        of: b"PlyKept",
        fields: [
          AddressWord({ name: ty.name, tag: 0 }),
          entry(keys::Equal, built.equal),
          entry(keys::Order, built.order),
        ],
      }),
    );
    bound_as(k.st, int_type(), AsInt, Static(k.name), at)
  }

pub fn operation_descriptor(
  context: Context,
  st: Lowering,
  eff: Bytes,
  operation: EffectOperation,
  params: List<Type>,
  result: Type,
) -> { st: Lowering, name: Option<Bytes> } / {abort.raise} =
  if !params.push(result).all(fully_known) {
    {
      st: params.push(result).fold(st, |s: Lowering, t: Type|
        type_variables(t).fold(s, |n: Lowering, v: Int| with_need(n, { var: v, reads: Exact }))),
      name: None,
    }
  } else {
    let module = context.setting.module;
    let declared = |i: Int| match operation.params.at(i) { Some(d) -> d, None -> unknown_type() };
    let whole = |i: Int|
      match declared(i) { VariableType(v) -> operation.own.contains(v), _ -> false };
    let walked = range(0, params.len()).map(|i: Int|
      mark_type_params(declared(i), params.get(i), operation.own));
    let return_marks = mark_type_params(operation.return_type, result, operation.own);
    let own_variable_types = own_types(operation, params, result);
    if own_variable_types.any(|t: Option<Type>| t == None) { { st: st, name: None } } else {
      let typed = |s: Lowering, t: Type, marks: List<Int>, shown: Bool|
        type_static(context.setting.constructors, module, s, t, marks, shown);
      let returned = typed(st, result, marks_of(return_marks.marked).marks, false);
      let taken = range(0, params.len()).fold(
        { st: returned.st, names: [] },
        |accumulator: { st: Lowering, names: List<Bytes> }, i: Int| {
          let d = typed(
            accumulator.st,
            params.get(i),
            if whole(i) { [] } else { marks_of(walked.get(i).marked).marks },
            serializes_parameters(eff, operation),
          );
          { st: d.st, names: accumulator.names.push(d.name) }
        },
      );
      let stood = own_variable_types.fold(
        { st: taken.st, names: [] },
        |accumulator: { st: Lowering, names: List<Bytes> }, t: Option<Type>|
          match t {
            Some(x) -> {
              let d = typed(accumulator.st, x, [], false);
              { st: d.st, names: accumulator.names.push(d.name) }
            },
            None -> accumulator,
          },
      );
      let listed = |s: Lowering, names: List<Bytes>|
        if names.len() == 0 { { st: s, word: RawWord(0) } } else {
          let l = static_added(
            s,
            StaticWords(names.map(|n: Bytes| AddressWord({ name: n, tag: 0 }))),
          );
          { st: l.st, word: AddressWord({ name: l.name, tag: 0 }) }
        };
      let ps = listed(stood.st, taken.names);
      let vs = listed(ps.st, stood.names);
      let d = static_added(
        vs.st,
        StaticStruct({
          of: b"PlyOp",
          fields: [
            FieldWord(eff),
            FieldWord(operation.name),
            AddressWord({ name: returned.name, tag: 0 }),
            RawWord(
              range(0, params.len()).fold(0, |m: Int, i: Int|
                if whole(i) { m + (1 << i) } else { m }),
            ),
            RawWord(params.len()),
            ps.word,
            RawWord(stood.names.len()),
            vs.word,
          ],
        }),
      );
      { st: d.st, name: Some(d.name) }
    }
  }

fn serializes_parameters(eff: Bytes, operation: EffectOperation) -> Bool =
  is_raise(operation.mode) || (eff == b"abort" && operation.name == b"raise")

pub fn own_types(
  operation: EffectOperation,
  params: List<Type>,
  result: Type,
) -> List<Option<Type>> / {abort.raise} = {
  let declared = |i: Int| match operation.params.at(i) { Some(d) -> d, None -> unknown_type() };
  let bound = range(0, params.len()).fold(
    [],
    |accumulator: List<{ var: Int, ty: Type }>, i: Int|
      accumulator.concat(mark_type_params(declared(i), params.get(i), operation.own).bound),
  ).concat(
    mark_type_params(operation.return_type, result, operation.own).bound,
  );
  operation.own.map(|v: Int|
    bound.fold(None, |found: Option<Type>, b: { var: Int, ty: Type }|
      if found == None && b.var == v { Some(b.ty) } else { found }))
}

pub fn effect_of(context: Context, global: Bytes) -> Option<EffectName> =
  if is_exit_effect(global) { Some(exit_effect_named(global)) } else {
    match context.setting.effects.find(|e: EffectName|
        e.global == global && e.operations.len() > 0) {
      Some(e) -> Some(e),
      None ->
        prelude_effects().find(|e: EffectInfo| e.name == global).map(|e: EffectInfo|
          { global: e.name, operations: e.operations.map(effect_operation_of) }),
    }
  }

pub fn exit_effect_named(name: Bytes) -> EffectName =
  {
    global: name,
    operations: [
      {
        name: exit_operation_name(),
        mode: RaiseMode,
        params: [VariableType(0)],
        return_type: VariableType(1),
        own: [0, 1],
      },
    ],
  }

pub fn pending_abort_raise(
  context: Context,
  st: Lowering,
  word: Variable,
) -> { st: Lowering, pending: Option<PendingRaise> } / {abort.raise} =
  match effect_of(context, b"abort") {
    None -> { st: st, pending: None },
    Some(e) -> match range(0, e.operations.len()).find(|k: Int|
        e.operations.get(k).name == b"raise") {
      None -> { st: st, pending: None },
      Some(k) -> {
        let d = operation_descriptor(
          context,
          st,
          e.global,
          e.operations.get(k),
          [string_type()],
          unit_type(),
        );
        match d.name {
          None -> { st: d.st, pending: None },
          Some(descriptor_name) -> {
            let s = type_static(
              context.setting.constructors,
              context.setting.module,
              d.st,
              string_type(),
              function_marks(string_type()),
              false,
            );
            {
              st: s.st,
              pending: Some({ word: word, index: k, operation: descriptor_name, string: s.name }),
            }
          },
        }
      },
    },
  }

fn type_static(
  constructors: Constructors,
  module: Bytes,
  st: Lowering,
  t: Type,
  marks: List<Int>,
  shown: Bool,
) -> { st: Lowering, name: Bytes } / {abort.raise} = {
  let spelled = encode_type(t);
  let text = static_added(st, StaticWords([BytesWord(spelled)]));
  let marked = |operation: TypeOperation|
    keys::with_marks(keys::generated_key(operation, t, module), marks);
  let heads = word_form_functions(constructors, t);
  static_added(
    text.st,
    StaticStruct({
      of: b"PlyType",
      fields: [
        RawWord(match spelled.blake3().u64_at(0) { Some(n) -> n, None -> 0 }),
        AddressWord({ name: text.name, tag: 0 }),
        RawWord(spelled.len()),
        match heads {
          Some(h) -> PreludeWord(h.dup),
          None -> EntryWord(keys::generated_key(Dup, t, module)),
        },
        match heads {
          Some(h) -> PreludeWord(h.release),
          None -> EntryWord(keys::generated_key(keys::Release, t, module)),
        },
        if shown { EntryWord(marked(OnWordForm(Lower))) }
        else { PreludeWord(never_shown_function()) },
        if is_string(t) && marks.len() == 0 {
          EntryWord(keys::generated_key(OnWordForm(Lift), t, module))
        } else { PreludeWord(never_lifted_function()) },
      ],
    }),
  )
}

pub fn serialization_function(constructors: Constructors, k: RootKey) -> Function / {abort.raise} =
  match k {
    Generated(w, _) -> {
      let rep = representation_with(constructors, w.ty);
      let word = { id: 0, ty: w.ty, representation: AsWord };
      let represented = { id: 1, ty: w.ty, representation: rep };
      let call = |operation: TypeOperation, args: List<Arg>, result: Type|
        Call({
          callee: Root(keys::with_operation(k, operation)),
          args: args,
          convention: typed_convention(constructors, args.map(|_: Arg| w.ty), result),
          suspends: false,
        });
      let opened = rep == AsWord;
      match w.operation {
        OnWordForm(Lower) -> {
          let done = {
            id: 2,
            ty: unit_type(),
            representation: representation_with(constructors, unit_type()),
          };
          entry_function(
            k,
            unit_type(),
            done.representation,
            [word],
            (if opened { [] } else {
              [
                Let({
                  var: represented,
                  value: Convert({ arg: VariableOperand(word), to: rep }),
                  at: dummy_span(),
                  unwind: [],
                }),
              ]
            }).concat([
              Let({
                var: done,
                value: call(
                  Lower,
                  [VariableOperand(if opened { word } else { represented })],
                  unit_type(),
                ),
                at: dummy_span(),
                unwind: [],
              }),
              Return(VariableOperand(done)),
            ]),
          )
        },
        OnWordForm(Lift) -> {
          let out = { id: 2, ty: w.ty, representation: AsWord };
          entry_function(
            k,
            w.ty,
            AsWord,
            [],
            [
              Let({ var: represented, value: call(Lift, [], w.ty), at: dummy_span(), unwind: [] }),
            ].concat(if opened { [Return(VariableOperand(represented))] } else {
              [
                Let({
                  var: out,
                  value: Convert({ arg: VariableOperand(represented), to: AsWord }),
                  at: dummy_span(),
                  unwind: [],
                }),
                Return(VariableOperand(out)),
              ]
            }),
          )
        },
        OnWordForm(operation) -> if operation != keys::Equal && operation != keys::Order {
          unreachable(
            b"an entry function for a type represented as an integer must convert values or compare them",
          )
        } else {
          let other = { id: 1, ty: w.ty, representation: AsWord };
          let left = { id: 2, ty: w.ty, representation: rep };
          let right = { id: 3, ty: w.ty, representation: rep };
          let returned_type = if operation == keys::Equal { bool_type() } else { ordering_type() };
          let returned = {
            id: 4,
            ty: returned_type,
            representation: representation_with(constructors, returned_type),
          };
          let signed = { id: 5, ty: int_type(), representation: AsInt };
          let word_type = if operation == keys::Equal { returned_type } else { int_type() };
          let out = { id: 6, ty: word_type, representation: AsWord };
          let let_of = |v: Variable, value: Rvalue|
            Let({ var: v, value: value, at: dummy_span(), unwind: [] });
          let held_pair = if opened { [] } else {
            [
              let_of(left, Convert({ arg: VariableOperand(word), to: rep })),
              let_of(right, Convert({ arg: VariableOperand(other), to: rep })),
            ]
          };
          let compared = if opened { [VariableOperand(word), VariableOperand(other)] }
          else { [VariableOperand(left), VariableOperand(right)] };
          let finished = if operation == keys::Equal {
            [let_of(out, Convert({ arg: VariableOperand(returned), to: AsWord }))]
          } else {
            [
              let_of(
                signed,
                Primitive({
                  operation: b"sign",
                  on: returned.representation,
                  args: [VariableOperand(returned)],
                }),
              ),
              let_of(out, Convert({ arg: VariableOperand(signed), to: AsWord })),
            ]
          };
          entry_function(
            k,
            word_type,
            AsWord,
            [word, other],
            held_pair.push(let_of(returned, call(operation, compared, returned_type))).concat(
              finished,
            ).push(
              Return(VariableOperand(out)),
            ),
          )
        },
        _ ->
          unreachable(
            b"an entry function for a type represented as an integer must convert values to or from that integer",
          ),
      }
    },
    _ -> unreachable(b"an entry function for a type represented as an integer has no type"),
  }

fn entry_function(
  k: RootKey,
  result_type: Type,
  result: Representation,
  params: List<Variable>,
  body: List<Instruction>,
) -> Function =
  {
    key: k,
    kind: Metered,
    params: params,
    convention: {
      params: params.map(|v: Variable|
        { ownership: BorrowedParam, representation: v.representation }),
      result: result,
      destination_passing: false,
      returned: OwnedResult,
    },
    result_type: result_type,
    body: body,
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  }
