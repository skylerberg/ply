import compiler.syntax.parsing (Span)
import compiler.check.types (Type, NamedType)
import compiler.emit.code (Code)
import compiler.check.infer.expr (kept_type)
import compiler.emit.keys (Root, Keeping, Opening)
import compiler.emit.roots (builtin_helper)
import compiler.emit.marks (has_marks, marked_key, dynamic_form, without_marks)
import compiler.emit.typed_ir (AsWord, Arg, Native, Call)
import compiler.emit.lower.base (Context, Lowering, LoweredValue, unreachable, bound_as,
                                 represented_as)
import compiler.emit.lower.representation (representation_of, typed_convention)
import compiler.emit.lower.marshalling (kept_descriptor, type_descriptor, called_at)
import compiler.emit.lower.scalars (comparison_built)

pub fn kept_builtin(name: Bytes) -> Bool =
  name == b"?keep" || name == b"?open" || name == b"?keeping" || name == b"?opening"

pub fn kept_builtin_call(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = called_at(cx, callee, args);
  match args {
    [x] -> if name == b"?keep" { kept_value(cx, st, x, ty, at) }
    else if name == b"?open" { opened_kept(cx, st, x, ty, at) }
    else { kept_conversion(cx, st, x, ty, name == b"?keeping", at) },
    _ -> unreachable(b"a kept crossing of other than one value: ".concat(name)),
  }
}

pub fn kept_conversion(
  cx: Context,
  st: Lowering,
  a: Arg,
  marked_ty: Type,
  keeping: Bool,
  at: Span,
) -> LoweredValue / {abort.raise} =
  if !has_marks(marked_ty) { { st: st, arg: a } } else {
    match marked_ty {
      NamedType(c) -> if c.name == b"^" && c.args.len() == 1 {
        if keeping { kept_value(cx, st, a, c.args.get(0), at) }
        else { opened_kept(cx, st, a, c.args.get(0), at) }
      } else { converted(cx, st, a, marked_ty, keeping, at) },
      _ -> converted(cx, st, a, marked_ty, keeping, at),
    }
  }

fn converted(
  cx: Context,
  st: Lowering,
  a: Arg,
  marked_ty: Type,
  keeping: Bool,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let from = if keeping { without_marks(marked_ty) } else { dynamic_form(marked_ty) };
  let into = if keeping { dynamic_form(marked_ty) } else { without_marks(marked_ty) };
  let op = if keeping { Keeping } else { Opening };
  let conv = typed_convention(cx.setting.ctors, [from], into);
  let h = represented_as({ st: st, arg: a }, representation_of(cx.setting, from), at);
  bound_as(
    h.st,
    into,
    conv.result,
    Call({
      callee: Root(marked_key(op, marked_ty, cx.setting.module)),
      args: [h.arg],
      convention: conv,
      suspends: false,
    }),
    at,
  )
}

fn kept_value(
  cx: Context,
  st: Lowering,
  a: Arg,
  t: Type,
  at: Span,
) -> LoweredValue / {abort.raise} =
  if t == kept_type() { { st: st, arg: a } } else {
    let h = represented_as({ st: st, arg: a }, AsWord, at);
    let ctors = cx.setting.ctors;
    let d = kept_descriptor(
      cx,
      h.st,
      t,
      { equal: comparison_built(ctors, t, false), order: comparison_built(ctors, t, true) },
      at,
    );
    bound_as(
      d.st,
      kept_type(),
      AsWord,
      Native({
        name: builtin_helper(b"?keep").concat(b"_p"),
        args: [h.arg, d.arg],
        uses: { takes: [true, false], owned: true, fails: false, suspends: false },
      }),
      at,
    )
  }

fn opened_kept(
  cx: Context,
  st: Lowering,
  k: Arg,
  t: Type,
  at: Span,
) -> LoweredValue / {abort.raise} =
  if t == kept_type() { { st: st, arg: k } } else {
    let d = type_descriptor(cx, st, t, at);
    let w = bound_as(
      d.st,
      t,
      AsWord,
      Native({
        name: builtin_helper(b"?open").concat(b"_p"),
        args: [k, d.arg],
        uses: { takes: [false, false], owned: true, fails: true, suspends: false },
      }),
      at,
    );
    represented_as(w, representation_of(cx.setting, t), at)
  }
