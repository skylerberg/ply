import compiler.syntax.parsing (Span)
import compiler.check.types (Type, NamedType)
import compiler.emit.code (Code)
import compiler.check.infer.expression (retained_type)
import compiler.emit.keys (Root, Wrapping, Opening)
import compiler.emit.roots (builtin_helper)
import compiler.emit.marks (has_marks, marked_key, dynamic_form, without_marks)
import compiler.emit.typed_ir (AsWord, Arg, Native, Call)
import compiler.emit.lower.base (Context, Lowering, LoweredValue, unreachable, bound_as,
                                 represented_as)
import compiler.emit.lower.representation (representation_of, typed_convention)
import compiler.emit.lower.marshalling (dynamic_descriptor, type_descriptor, called_at)
import compiler.emit.lower.scalars (comparison_built)

pub fn conversion_builtin(name: Bytes) -> Bool =
  name == b"?keep" || name == b"?open" || name == b"?keeping" || name == b"?opening"

pub fn conversion_builtin_call(
  context: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Code,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let ty = called_at(context, callee, args);
  match args {
    [x] -> if name == b"?keep" { dynamic_value(context, st, x, ty, at) }
    else if name == b"?open" { opened_dynamic_value(context, st, x, ty, at) }
    else { marked_conversion(context, st, x, ty, name == b"?keeping", at) },
    _ ->
      unreachable(
        b"a builtin that converts a marked value must take exactly one argument: ".concat(name),
      ),
  }
}

pub fn marked_conversion(
  context: Context,
  st: Lowering,
  a: Arg,
  marked_type: Type,
  to_dynamic: Bool,
  at: Span,
) -> LoweredValue / {abort.raise} =
  if !has_marks(marked_type) { { st: st, arg: a } } else {
    match marked_type {
      NamedType(c) -> if c.name == b"^" && c.args.len() == 1 {
        if to_dynamic { dynamic_value(context, st, a, c.args.get(0), at) }
        else { opened_dynamic_value(context, st, a, c.args.get(0), at) }
      } else { converted(context, st, a, marked_type, to_dynamic, at) },
      _ -> converted(context, st, a, marked_type, to_dynamic, at),
    }
  }

fn converted(
  context: Context,
  st: Lowering,
  a: Arg,
  marked_type: Type,
  to_dynamic: Bool,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let from = if to_dynamic { without_marks(marked_type) } else { dynamic_form(marked_type) };
  let into = if to_dynamic { dynamic_form(marked_type) } else { without_marks(marked_type) };
  let marked_operation = if to_dynamic { Wrapping } else { Opening };
  let conv = typed_convention(context.setting.constructors, [from], into);
  let h = represented_as({ st: st, arg: a }, representation_of(context.setting, from), at);
  bound_as(
    h.st,
    into,
    conv.result,
    Call({
      callee: Root(marked_key(marked_operation, marked_type, context.setting.module)),
      args: [h.arg],
      convention: conv,
      suspends: false,
    }),
    at,
  )
}

fn dynamic_value(
  context: Context,
  st: Lowering,
  a: Arg,
  t: Type,
  at: Span,
) -> LoweredValue / {abort.raise} =
  if t == retained_type() { { st: st, arg: a } } else {
    let h = represented_as({ st: st, arg: a }, AsWord, at);
    let constructors = context.setting.constructors;
    let d = dynamic_descriptor(
      context,
      h.st,
      t,
      {
        equal: comparison_built(constructors, t, false),
        order: comparison_built(constructors, t, true),
      },
      at,
    );
    bound_as(
      d.st,
      retained_type(),
      AsWord,
      Native({
        name: builtin_helper(b"?keep").concat(b"_p"),
        args: [h.arg, d.arg],
        uses: { takes: [true, false], owned: true, fails: false, suspends: false },
      }),
      at,
    )
  }

fn opened_dynamic_value(
  context: Context,
  st: Lowering,
  k: Arg,
  t: Type,
  at: Span,
) -> LoweredValue / {abort.raise} =
  if t == retained_type() { { st: st, arg: k } } else {
    let d = type_descriptor(context, st, t, at);
    let w = bound_as(
      d.st,
      t,
      AsWord,
      Native({
        name: builtin_helper(b"?open").concat(b"_p"),
        args: [k, d.arg],
        uses: { takes: [false, false], owned: true, fails: true, suspends: false },
      }),
      at,
    );
    represented_as(w, representation_of(context.setting, t), at)
  }
