//! What a value crosses as between a perform of an operation a program declares and its clause,
//! which is compiled once for every perform: each value at a place one of the operation's own type
//! parameters stands kept beside its type's descriptor (`Kept`), and what the clause answers there
//! opened at the type the perform picked.

import compiler.syntax.parsing (Span)
import compiler.check.types (Type, TyCon)
import compiler.check.infer.expr (kept_type)
import compiler.emit.keys (Root, Keeping, Opening)
import compiler.emit.roots (builtin_helper)
import compiler.emit.marks (marked, marked_key, kept_form, plain)
import compiler.emit.tir (RWord, Arg, Native, Call, Handling)
import compiler.emit.lower.base (Context, Lowering, Lowered, refuse, bound_as, handed)
import compiler.emit.lower.held (held_as, typed_convention)
import compiler.emit.lower.crossing (kept_described, type_described, called_at)
import compiler.emit.lower.scalars (comparison_built)

/// Whether builtin `name` is one written code crosses a value kept or opened through.
pub fn kept_builtin(name: Bytes) -> Bool =
  name == b"?keep" || name == b"?open" || name == b"?keeping" || name == b"?opening"

/// Builtin `name` (one of `kept_builtin`) called on `args`, at the type filed where its name is
/// written at `callee`: `?keep` and `?open` at a value's own type, `?keeping` and `?opening` at a
/// type marked where the places kept are.
pub fn kept_called(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Span,
  at: Span,
) -> Lowered / {abort.raise} = {
  let ty = called_at(cx, callee, args);
  match args {
    [x] -> if name == b"?keep" { kept_value(cx, st, x, ty, at) }
    else if name == b"?open" { opened_kept(cx, st, x, ty, at) }
    else { crossed_kept(cx, st, x, ty, name == b"?keeping", at) },
    _ -> refuse(st, Handling, b"a kept crossing of other than one value: ".concat(name)),
  }
}

/// `a`, a value of the type `marked` marks where an operation's own type parameters stand, made into
/// the form a clause holds (`keeping`) or back into its own: unchanged where nothing is marked, at a
/// marked place kept or opened, and elsewhere by the root written for the type's form,
/// `keeping#T` or `opening#T`.
pub fn crossed_kept(
  cx: Context,
  st: Lowering,
  a: Arg,
  marked_ty: Type,
  keeping: Bool,
  at: Span,
) -> Lowered / {abort.raise} =
  if !marked(marked_ty) { { st: st, arg: a } } else {
    match marked_ty {
      TyCon(c) -> if c.name == b"^" && c.args.len() == 1 {
        if keeping { kept_value(cx, st, a, c.args.get(0), at) }
        else { opened_kept(cx, st, a, c.args.get(0), at) }
      } else { converted(cx, st, a, marked_ty, keeping, at) },
      _ -> converted(cx, st, a, marked_ty, keeping, at),
    }
  }

/// `a` made into its other form by the root written for the marked type `marked_ty`.
fn converted(
  cx: Context,
  st: Lowering,
  a: Arg,
  marked_ty: Type,
  keeping: Bool,
  at: Span,
) -> Lowered / {abort.raise} = {
  let from = if keeping { plain(marked_ty) } else { kept_form(marked_ty) };
  let into = if keeping { kept_form(marked_ty) } else { plain(marked_ty) };
  let op = if keeping { Keeping } else { Opening };
  let conv = typed_convention(cx.setting.ctors, [from], into);
  let h = handed({ st: st, arg: a }, held_as(cx.setting, from), at);
  bound_as(
    h.st,
    into,
    conv.answer,
    Call({
      callee: Root(marked_key(op, marked_ty, cx.setting.module)),
      args: [h.arg],
      conv: conv,
      stops: false,
    }),
    at,
  )
}

/// `a`, a value of type `t`, kept beside `kept#T`, which compares and orders two values of `t` where
/// `==` and `compare` at it are built: what the runtime's `?keep` makes of it, taking it. A value
/// already kept crosses as it is.
fn kept_value(cx: Context, st: Lowering, a: Arg, t: Type, at: Span) -> Lowered / {abort.raise} =
  if t == kept_type() { { st: st, arg: a } } else {
    let h = handed({ st: st, arg: a }, RWord, at);
    let ctors = cx.setting.ctors;
    let d = kept_described(
      cx,
      h.st,
      t,
      { equal: comparison_built(ctors, t, false), order: comparison_built(ctors, t, true) },
      at,
    );
    bound_as(
      d.st,
      kept_type(),
      RWord,
      Native({
        name: builtin_helper(b"?keep").concat(b"_p"),
        args: [h.arg, d.arg],
        uses: { takes: [true, false], owned: true, fails: false, stops: false },
      }),
      at,
    )
  }

/// What the kept value `k` keeps, a value of `t` its type's descriptor says it is, held as `t` is;
/// the run fails where it keeps another type's. A value that is itself kept crosses as it is.
fn opened_kept(cx: Context, st: Lowering, k: Arg, t: Type, at: Span) -> Lowered / {abort.raise} =
  if t == kept_type() { { st: st, arg: k } } else {
    let d = type_described(cx, st, t, at);
    let w = bound_as(
      d.st,
      t,
      RWord,
      Native({
        name: builtin_helper(b"?open").concat(b"_p"),
        args: [k, d.arg],
        uses: { takes: [false, false], owned: true, fails: true, stops: false },
      }),
      at,
    );
    handed(w, held_as(cx.setting, t), at)
  }
