import std.bin
import compiler.syntax.parsing (Identifier, Span, prelude_binder)
import compiler.syntax.type_syntax (Mode, ReadMode, WriteMode, RaiseMode, InvalidMode, mode_text)
import compiler.check.types (Type, VariableType, NamedType, FunctionType, RecordType, NominalType,
                             Field, Scheme, Effects, Effect, int_type, bool_type, float_type,
                             decimal_type, bytes_type, function_type, no_effects, unit_type,
                             list_type)
import compiler.check.known (ordering_name, less_constructor, equal_constructor)
import compiler.emit.typing (SiteType, SiteAnnotations, annotations_of, no_annotations, site_type,
                             unknown_type, body_at)
import compiler.syntax.items (Module, Item, FunctionItem, TestItem, LawItem, FnDefinition,
                              TestDefinition, LawDefinition, SelectedNames, WholeModule,
                              ModuleAlias, InvariantInstance, HostInstance, TypeItem, SumBody,
                              InstanceItem, KeyInstance, ShowInstance, NumericItem,
                              NumericOperation)
import compiler.syntax.expressions (implicitly_imported_by, scheduler_module, prelude_hosts,
                                    prelude_module)
import compiler.check.resolve.tables (ParsedModule, Resolution, ModuleBinding, lookup, ValueSpace,
                                      qualify, module_of_name)
import compiler.check.resolve.scopes (method_binder_module, method_binder)
import compiler.check.typed
import compiler.check.typed (TypedBody, TypedParam, BodyPart, WholeBody, TestRun, part_key,
                             body_retyped)
import compiler.check.infer (BodyFacts, item_owner, facts_by_owner)
import compiler.check.infer.checker (MemberSite, Builtin, builtins, OperationInfo, StatedReturn,
                                     InstanceInfo, program)
import compiler.check.infer.definitions (Extern, declared_natives)
import compiler.front.facts (Analysis)
import compiler.front.emitter_input (InferredFacts, inferred_facts_bin)
import compiler.front.rows (Rows, KnownDefinitionRow, EffectRow, OperationRow)
import compiler.front.published (LoweringTargets, facts_read, rows_of, inferred_facts, wants)
import compiler.emit.code (Code, lower_function, with_labels)
import compiler.emit.representations (Definition, Imported, SumConstructor, OpenShape, EffectName,
                                      EffectOperation, EmitParam, sig_of, type_variables, kind_of,
                                      substituted, definition_shaped, EmitReads, ShapeReads,
                                      code_facts, lowering, table_sources, over_code_facts)
import compiler.emit.c (IntKind, BoolKind, FloatKind, DecimalKind, bytes_join_dots)
import compiler.emit.keys (RootKey, Named, LawBody, test_key, law_key)
import compiler.check.infer.names (simple_name_of)

pub type ModuleContext = {
  module: Bytes,
  definitions: List<Definition>,
  imports: List<Imported>,
  release_build: Bool,
}

pub type Root = {
  key: RootKey,
  base: Int,
  params: List<EmitParam>,
  types: List<Type>,
  result_type: Type,
  code: Code,
  performs: Effects,
}

pub fn module_context_in(
  a: Analysis,
  module: Bytes,
) -> Result<{ setting: ModuleContext, roots: List<Root> }, Bytes> / {abort.raise} =
  match range(0, a.modules.len()).fold(None, |accumulator: Option<Int>, k: Int|
      if a.modules.get(k).name == module { Some(k) } else { accumulator }) {
    None -> Err(b"no such module"),
    Some(i) -> match handle {
        module_contexts_in(
          a.r,
          rows_of(a),
          inferred_facts(a),
          a.modules,
          [i],
          |_: Int, s: ModuleContext, rs: List<ItemRoot>|
            { setting: s, roots: rs.map(|r: ItemRoot| r.root) },
        )
      } with {
        lowering.fail(reason) -> Err(reason),
      } {
      Err(reason) -> Err(reason),
      Ok(found) -> match found.at(0) { Some(x) -> Ok(x), None -> Err(b"no such module") },
    },
  }

pub const scheduler_imported: Imported =
  { name: scheduler_module, module: scheduler_module, whole: true }

pub type ItemRoot = { item: Item, root: Root }

pub type HostHandler = { call: Bytes, module: Bytes }

pub type NamedDefinition = { full: Bytes, definition: Definition }

pub fn definition_called(full: Bytes) -> Option<Definition> / {EmitReads} =
  match program.definition_named(full) {
    None -> None,
    Some(facts) -> match facts.call {
      None -> None,
      Some(shape) -> {
        let module = module_of_name(full);
        Some(
          definition_shaped(
            module,
            full.slice(module.len() + 1, full.len()),
            shape,
            facts.pure,
            facts.scheme,
            code_facts.value_named(full),
          ),
        )
      },
    },
  }

pub fn scheme_called(full: Bytes) -> Option<Scheme> / {EmitReads} =
  match program.definition_named(full) { Some(facts) -> Some(facts.scheme), None -> None }

pub fn returned_called(full: Bytes) -> Option<StatedReturn> / {EmitReads} =
  match program.definition_named(full) {
    Some(facts) -> match facts.call { Some(shape) -> shape.returned, None -> None },
    None -> None,
  }

pub fn effect_called(global: Bytes) -> Option<EffectName> / {EmitReads} =
  match program.effect_named(global) {
    Some(info) -> Some({ global: global, operations: info.operations.map(effect_operation_of) }),
    None -> None,
  }

pub fn host_called(served: Bytes) -> Option<HostHandler> / {EmitReads} =
  match prelude_hosts.find(|h: { effect: Bytes, module: Bytes, by: Bytes }| h.effect == served) {
    Some(h) -> hosted_by(h.module, h.by),
    None -> match program.host_named(served) {
      Some(by) -> hosted_by(module_of_name(served), by),
      None -> None,
    },
  }

fn hosted_by(module: Bytes, by: Bytes) -> Option<HostHandler> / {EmitReads} =
  match definition_called(qualify(module, by)) {
    Some(_) -> Some({ call: qualify(module, by), module: module }),
    None -> None,
  }

pub fn native_called(name: Bytes) -> Option<Extern> / {EmitReads} = {
  let short = simple_name_of(name);
  match declared_natives.find(|e: Extern| e.name == short) {
    Some(e) -> Some(e),
    None -> code_facts.native_named(name),
  }
}

pub fn stated_functions_of(tag: Bytes) -> List<Bytes> / {EmitReads} =
  match code_facts.sum_of_constructor(tag) {
    None -> [],
    Some(type_name) -> match program.type_named(type_name) {
      None -> [],
      Some(t) -> {
        let home = module_of_name(type_name);
        let full = |by: Bytes| if module_of_name(by).len() == 0 { qualify(home, by) } else { by };
        t.instances.filter(|i: InstanceInfo|
          i.kind != InvariantInstance && i.kind != HostInstance).map(|i: InstanceInfo|
          full(i.by)).concat(match t.numeric { Some(n) -> n.functions.map(full), None -> [] })
      },
    },
  }

pub fn stated_functions(module: Bytes, parsed: Module) -> List<Bytes> = {
  let sums = parsed.items.fold(Map::new(), |accumulator: Map<Bytes, Bool>, item: Item|
    match item {
      TypeItem(d) -> match d.body {
        SumBody(_) -> accumulator.insert(d.name.name, true),
        _ -> accumulator,
      },
      _ -> accumulator,
    });
  parsed.items.fold([], |accumulator: List<Bytes>, item: Item|
    match item {
      InstanceItem(d) -> if sums.contains(d.target.name)
          && (d.kind == KeyInstance || d.kind == ShowInstance) {
        accumulator.push(qualify(module, d.function.name))
      } else { accumulator },
      NumericItem(d) -> if !sums.contains(d.target.name) { accumulator } else {
        d.operations.fold(accumulator, |a: List<Bytes>, o: NumericOperation|
          a.push(qualify(module, o.by.name)))
      },
      _ -> accumulator,
    })
}

pub fn definition_at(s: ModuleContext, full: Bytes) -> Option<NamedDefinition> / {EmitReads} =
  match last_added(s, |d: Definition| qualify(s.module, d.name) == full) {
    Some(d) -> Some({ full: full, definition: d }),
    None -> match definition_called(full) {
      Some(d) -> Some({ full: full, definition: d }),
      None -> None,
    },
  }

pub fn definition_written(s: ModuleContext, name: Bytes) -> Option<NamedDefinition> / {EmitReads} =
  match last_added(s, |d: Definition| d.name == name) {
    Some(d) -> Some({ full: qualify(s.module, name), definition: d }),
    None -> match definition_at(s, qualify(s.module, name)) {
      Some(own) -> Some(own),
      None -> match imported_target(s.imports, name) {
        Some(t) -> definition_at(s, qualify(t.imp.module, t.name)),
        None -> None,
      },
    },
  }

pub fn definition_rooted(s: ModuleContext, root: RootKey) -> Option<Definition> / {EmitReads} =
  match last_added(s, |d: Definition| d.root == root) {
    Some(d) -> Some(d),
    None -> match root { Named(full) -> definition_called(full), _ -> None },
  }

fn last_added(s: ModuleContext, named: (Definition) -> Bool) -> Option<Definition> =
  s.definitions.fold(None, |accumulator: Option<Definition>, d: Definition|
    if named(d) { Some(d) } else { accumulator })

pub fn module_contexts_in<b | e>(
  r: Resolution,
  rows: Rows,
  walked: InferredFacts,
  modules: List<ParsedModule>,
  wanted: List<Int>,
  each: (Int, ModuleContext, List<ItemRoot>) -> b / {abort.raise | e},
  targets: Option<LoweringTargets> = None,
) -> Result<List<b>, Bytes> / {lowering.fail, abort.raise | e} =
  match facts_read(rows, walked, targets, modules) {
    Err(reason) -> Err(reason),
    Ok(facts) -> {
      let schemes = rows.definitions.fold(
        Map::new(),
        |accumulator: Map<Bytes, Scheme>, row: KnownDefinitionRow|
          accumulator.insert(row.name, row.scheme),
      );
      let owned = facts_by_owner(facts);
      Ok(
        wanted.filter(|i: Int| i < modules.len()).map(|i: Int| {
          let m = modules.get(i);
          each(
            i,
            {
              module: m.name,
              definitions: [],
              imports: resolved_imports(
                r,
                i,
                modules,
                m.module,
                facts.members.filter(|s: MemberSite| s.module == i),
              ).push(
                scheduler_imported,
              ),
              release_build: false,
            },
            m.module.items.fold([], |accumulator: List<ItemRoot>, item: Item| {
              let owner = item_owner(m.name, item);
              if !wants(target_roots(targets), owner) { accumulator } else {
                let recorded = recorded_annotations(owned, owner);
                match item {
                  FunctionItem(definition) ->
                    accumulator.push({
                      item: item,
                      root: root_of(m.name, schemes, recorded, definition),
                    }),
                  TestItem(t) ->
                    accumulator.push({ item: item, root: test_root(m.name, recorded, t) }),
                  LawItem(l) ->
                    accumulator.push({ item: item, root: law_root_of(m.name, recorded, l) }),
                  _ -> accumulator,
                }
              }
            }),
          )
        }),
      )
    },
  }

fn target_roots(targets: Option<LoweringTargets>) -> Option<Map<Bytes, Bool>> =
  match targets { Some(t) -> Some(t.roots), None -> None }

pub fn recorded_annotations(
  owned: Map<Bytes, BodyFacts>,
  owner: Bytes,
) -> SiteAnnotations / {abort.raise} =
  match owned.get(owner) { None -> no_annotations, Some(f) -> annotations_of(f) }

pub type RootBody = { params: List<EmitParam>, code: Code }

pub fn resolved_at(
  recorded: SiteAnnotations,
  part: BodyPart,
  base: Int,
  args: List<Type>,
) -> TypedBody<Type> / {lowering.fail, abort.raise} =
  match body_at(recorded, part, base) {
    None -> unlowered(b"the check resolved no body for its ".concat(part_key(part))),
    Some(found) -> if args.len() == 0 { found } else {
      body_retyped(found, (), {
        ty: |t: Type, u: Unit| { ty: substituted(t, args), state: u },
        effects: |r: Effects| r,
        entry: |a: Effect| a,
        span: |span: Span| span,
      }).out
    },
  }

pub fn root_params(b: TypedBody<Type>, labels: List<Bytes>) -> List<EmitParam> =
  with_labels(
    b.params.map(|q: TypedParam<Type>| {
      let parameter_kind = kind_of(q.ty);
      {
        name: q.name,
        kind: parameter_kind.kind,
        ty: parameter_kind.ty,
        of: Some(q.ty),
        lambda: None,
      }
    }),
    labels.map(|n: Bytes| { name: n, kind: IntKind, ty: OpenShape([]), of: None, lambda: None }),
  )

pub fn body_code(
  b: TypedBody<Type>,
  labels: List<Bytes>,
  recorded: SiteAnnotations,
) -> Code / {lowering.fail, abort.raise} = {
  let l = lower_function(b.params, labels, b.body);
  match l.failed.at(0) { Some(reason) -> unlowered(reason), None -> l.code }
}

pub fn root_body(
  recorded: SiteAnnotations,
  part: BodyPart,
  base: Int,
  labels: List<Bytes>,
  args: List<Type>,
) -> RootBody / {lowering.fail, abort.raise} = {
  let b = resolved_at(recorded, part, base, args);
  { params: root_params(b, labels), code: body_code(b, labels, recorded) }
}

fn unlowered<a>(reason: Bytes) -> a / {lowering.fail} =
  lowering.fail(b"a checked body cannot be compiled: ".concat(reason))

fn body_root(
  key: RootKey,
  recorded: SiteAnnotations,
  part: BodyPart,
  base: Int,
  labels: List<Bytes>,
  result_type: Type,
) -> Root / {lowering.fail, abort.raise} = {
  let b = root_body(recorded, part, base, labels, []);
  {
    key: key,
    base: base,
    params: b.params,
    types: b.params.map(param_type),
    result_type: result_type,
    code: b.code,
    performs: no_effects,
  }
}

fn test_root(
  module: Bytes,
  recorded: SiteAnnotations,
  t: TestDefinition,
) -> Root / {lowering.fail, abort.raise} =
  body_root(test_key(module, t.name), recorded, TestRun, t.span.start, [], unit_type)

fn law_root_of(
  module: Bytes,
  recorded: SiteAnnotations,
  l: LawDefinition,
) -> Root / {lowering.fail, abort.raise} =
  body_root(law_key(module, l.name, LawBody), recorded, typed::LawBody, l.span.start, [], bool_type)

fn root_of(
  module: Bytes,
  schemes: Map<Bytes, Scheme>,
  recorded: SiteAnnotations,
  definition: FnDefinition,
) -> Root / {lowering.fail, abort.raise} = {
  let full = qualify(module, definition.name.name);
  body_root(
    Named(full),
    recorded,
    WholeBody,
    definition.span.start,
    definition.generics.labels.map(|i: Identifier| i.name),
    match sig_of(schemes, full) { Some(s) -> s.result_type, None -> unknown_type },
  )
}

pub fn param_type(p: EmitParam) -> Type =
  match p.of {
    Some(t) -> t,
    None -> match p.kind {
      IntKind -> int_type,
      BoolKind -> bool_type,
      FloatKind -> float_type,
      DecimalKind -> decimal_type,
      _ -> unknown_type,
    },
  }

pub fn constructor_sum(
  full: Bytes,
) -> Option<{ constructors: List<SumConstructor>, index: Int }> / {ShapeReads} =
  match code_facts.sum_of_constructor(full) {
    None -> None,
    Some(sum) -> match code_facts.sum_named(sum) {
      None -> None,
      Some(cs) -> match range(0, cs.len()).fold(None, |at: Option<Int>, i: Int|
          match at {
            Some(_) -> at,
            None -> match cs.at(i) {
              Some(c) -> if c.name == full { Some(i) } else { None },
              None -> None,
            },
          }) {
        Some(i) -> Some({ constructors: cs, index: i }),
        None -> None,
      },
    },
  }

pub fn prelude_constructor(name: Bytes) -> Bytes = Bytes::concat_all([prelude_binder, b"::", name])

pub const declared_schemes: Map<Bytes, Scheme> =
  builtins.fold(Map::new(), |m: Map<Bytes, Scheme>, b: Builtin| m.insert(b.name, b.scheme))

pub type CallTypes = { params: List<Type>, result_type: Type }

pub fn builtin_call_types(recorded: Option<SiteType>, name: Bytes) -> Option<CallTypes> =
  match recorded {
    None -> declared_call_types(name, []),
    Some(t) -> match t.ty {
      FunctionType(f) -> Some({ params: f.params, result_type: f.return_type }),
      _ -> declared_call_types(name, t.args),
    },
  }

pub fn declared_call_types(name: Bytes, args: List<Type>) -> Option<CallTypes> =
  match declared_schemes.get(name) {
    None -> None,
    Some(scheme) -> if scheme.type_variables.len() > 0
        && args.len() != scheme.type_variables.len() { None } else {
      let by = range(0, scheme.type_variables.len()).fold(
        Map::new(),
        |m: Map<Int, Type>, i: Int|
          match scheme.type_variables.at(i) {
            Some(v) -> match args.at(i) { Some(t) -> m.insert(v, t), None -> m },
            None -> m,
          },
      );
      match scheme.ty {
        FunctionType(f) ->
          Some({
            params: f.params.map(|p: Type| instantiated(p, by)),
            result_type: instantiated(f.return_type, by),
          }),
        _ -> None,
      }
    },
  }

fn instantiated(ty: Type, by: Map<Int, Type>) -> Type =
  match ty {
    VariableType(v) -> match by.get(v) { Some(t) -> t, None -> ty },
    NamedType(c) -> NamedType({ ..c, args: c.args.map(|a: Type| instantiated(a, by)) }),
    FunctionType(f) ->
      FunctionType({
        ..f,
        params: f.params.map(|p: Type| instantiated(p, by)),
        return_type: instantiated(f.return_type, by),
      }),
    RecordType(fs) -> RecordType(fs.map(|f: Field| { ..f, ty: instantiated(f.ty, by) })),
    NominalType(x) ->
      NominalType({
        ..x,
        args: x.args.map(|a: Type| instantiated(a, by)),
        fields: x.fields.map(|f: Field| { ..f, ty: instantiated(f.ty, by) }),
      }),
  }

pub fn imported_target(
  imports: List<Imported>,
  name: Bytes,
) -> Option<{ imp: Imported, name: Bytes }> / {EmitReads} =
  match match qualified(name) {
      Some(q) -> match module_import(imports, q.binder) {
        Some(imp) -> Some({ imp: imp, name: q.name }),
        None -> None,
      },
      None -> match from_import(imports, name) {
        Some(imp) -> Some({ imp: imp, name: name }),
        None -> None,
      },
    } {
    Some(t) -> Some(t),
    None -> match module_import(imports, prelude_binder) {
      Some(imp) -> if definition_called(qualify(imp.module, name)) != None {
        Some({ imp: imp, name: name })
      } else { None },
      None -> None,
    },
  }

pub fn from_import(xs: List<Imported>, name: Bytes) -> Option<Imported> =
  xs.fold(None, |accumulator: Option<Imported>, i: Imported|
    if !i.whole && i.name == name { Some(i) } else { accumulator })

pub fn qualified(name: Bytes) -> Option<{ binder: Bytes, name: Bytes }> =
  match name.index_of(b"::") {
    None -> None,
    Some(i) -> match name.slice_at(0, i) {
      None -> None,
      Some(binder) -> match name.slice_at(i + 2, name.len() - i - 2) {
        Some(rest) -> Some({ binder: binder, name: rest }),
        None -> None,
      },
    },
  }

pub fn decode_inferred_facts(walked: Bytes) -> Option<InferredFacts> / {abort.raise} =
  if walked.len() == 0 { None }
  else { match bin::decode(walked, inferred_facts_bin()) { Ok(w) -> Some(w), Err(_) -> None } }

pub fn effect_operation_of(o: OperationInfo) -> EffectOperation =
  {
    name: o.name,
    mode: o.mode,
    params: o.params,
    return_type: o.return_type,
    own: own_type_parameters(o.scheme, o.params, o.return_type),
  }

fn own_type_parameters(scheme: Option<Scheme>, params: List<Type>, result: Type) -> List<Int> =
  match scheme {
    Some(s) -> s.type_variables,
    None ->
      params.push(result).fold([], |accumulator: List<Int>, t: Type|
        type_variables(t).fold(accumulator, |a: List<Int>, v: Int|
          if a.contains(v) { a } else { a.push(v) })),
  }

pub fn resolved_imports(
  resolved: Resolution,
  index: Int,
  modules: List<ParsedModule>,
  x_module: Module,
  members: List<MemberSite>,
) -> List<Imported> / {abort.raise} = {
  let written = range(0, x_module.imports.len()).fold([], |accumulator: List<Imported>, j: Int| {
    let import_item = x_module.imports.get(j);
    let full = match resolved.imports.get(index).at(j) {
      Some(t) -> modules.get(t).name,
      None -> bytes_join_dots(import_item.path.map(|i: Identifier| i.name)),
    };
    match import_item.kind {
      SelectedNames(ns) ->
        ns.fold(accumulator, |a: List<Imported>, n: Identifier|
          a.push({ name: n.name, module: full, whole: false })),
      WholeModule ->
        accumulator.push({
          name: match import_item.path.at(import_item.path.len() - 1) {
            Some(i) -> i.name,
            None -> b"",
          },
          module: full,
          whole: true,
        }),
      ModuleAlias(a2) ->
        implicitly_imported_by(a2.name).fold(
          accumulator.push({ name: a2.name, module: full, whole: true }),
          |a: List<Imported>, n: Bytes|
            match resolved.scopes.at(index) {
              Some(module_scope) -> match lookup(module_scope.bound, ValueSpace, n) {
                Some(b) -> if b.qualified != qualify(full, n) { a }
                else { a.push({ name: n, module: full, whole: false }) },
                None -> a,
              },
              None -> a,
            },
        ),
    }
  });
  let through = members.fold(written, |accumulator: List<Imported>, m: MemberSite|
    List::concat(
      match method_binder_module(m.qualifier) { Some(home) -> [home], None -> [] },
      m.imported_modules,
    ).fold(accumulator, |a: List<Imported>, home: Bytes|
      match module_import(a, method_binder(home)) {
        Some(_) -> a,
        None -> a.push({ name: method_binder(home), module: home, whole: true }),
      }));
  match resolved.scopes.at(index) {
    None -> through,
    Some(scope) ->
      scope.modules.fold(through, |accumulator: List<Imported>, mb: ModuleBinding|
        match module_import(accumulator, mb.binder) {
          Some(_) -> accumulator,
          None -> accumulator.push({ name: mb.binder, module: mb.target, whole: true }),
        }),
  }
}

pub fn module_import(xs: List<Imported>, binder: Bytes) -> Option<Imported> =
  xs.fold(None, |accumulator: Option<Imported>, i: Imported|
    if i.whole && i.name == binder { Some(i) } else { accumulator })

test "a builtin is typed by what the checker recorded where it called it, else by its declared scheme at the recorded type arguments" {
  let ints = list_type(int_type);
  let len = Some({ params: [ints], result_type: int_type });
  assert_eq(declared_call_types(b"List::len", [int_type]), len);
  assert_eq(declared_call_types(b"List::len", []), None);
  assert_eq(declared_call_types(b"m.nothing", []), None);
  assert_eq(builtin_call_types(Some(site_type(unknown_type, [int_type])), b"List::len"), len);
  let checked = function_type([bytes_type], int_type, no_effects);
  assert_eq(
    builtin_call_types(Some(site_type(checked, [int_type])), b"List::len"),
    Some({ params: [bytes_type], result_type: int_type }),
  )
}

test "a constructor's sum lists its cases in order and gives the constructor's place among them" {
  let cases = [
    { name: less_constructor, index: 0, fields: [], params: [] },
    { name: equal_constructor, index: 1, fields: [], params: [] },
  ];
  let sums = Map::new().insert(ordering_name, cases);
  assert_eq(
    over_code_facts(table_sources(sums), || constructor_sum(equal_constructor)),
    Some({ constructors: cases, index: 1 }),
  );
  assert_eq(over_code_facts(table_sources(sums), || constructor_sum(b"m.Box")), None)
}
