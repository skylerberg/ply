import std.bin
import std.bytes
import compiler.syntax.parsing (Identifier, Span, prelude_binder)
import compiler.syntax.type_syntax (Mode, ReadMode, WriteMode, RaiseMode, InvalidMode, mode_text)
import compiler.check.types (Type, VariableType, NamedType, FunctionType, RecordType, NominalType,
                             Field, Scheme, Effects, Effect, int_type, bool_type, float_type,
                             decimal_type, bytes_type, function_type, no_effects, unit_type,
                             list_type)
import compiler.check.known (ordering_name, less_constructor, equal_constructor)
import compiler.emit.typing (SiteType, SiteAnnotations, annotations_of, no_annotations, site_type,
                             unknown_type, body_at)
import compiler.syntax.items (Module, Item, FunctionItem, TestItem, LawItem, FnDefinition,
                              TestDefinition, LawDefinition, SelectedNames, WholeModule,
                              ModuleAlias)
import compiler.syntax.expressions (implicitly_imported_by, scheduler_module)
import compiler.check.resolve.tables (ParsedModule, Resolution, ModuleBinding, Binding, lookup,
                                      ValueSpace, qualify)
import compiler.check.resolve.scopes (method_binder_module, method_binder)
import compiler.check.typed
import compiler.check.typed (TypedBody, TypedParam, BodyPart, WholeBody, TestRun, part_key,
                             body_retyped, ConstantData)
import compiler.check.infer (BodyFacts, item_owner, facts_by_owner)
import compiler.check.infer.checker (MemberSite, Builtin, builtins, EffectInfo, OperationInfo)
import compiler.check.infer.definitions (MachineCall, machine_calls, parsed_natives)
import compiler.front.facts (Analysis)
import compiler.front.emitter_input (InferredFacts, inferred_facts_bin, constructors_read)
import compiler.front.rows (Rows, KnownDefinitionRow, constant_values, ConstructorRow, EffectRow,
                            OperationRow)
import compiler.front.published (facts_read, rows_of, inferred_facts)
import compiler.emit.code (Code, lower_function, with_labels)
import compiler.emit.representations (Definition, Imported, Constructors, SumConstructor, OpenShape,
                                      EffectName, EffectOperation, EmitParam, constructors_of,
                                      constructor_sums, sig_of, definition_entry, type_variables,
                                      with_released, kind_of, substituted)
import compiler.emit.c (IntKind, BoolKind, FloatKind, DecimalKind, bytes_join_dots)
import compiler.emit.keys (RootKey, Named, LawBody, test_key, law_key)

pub type ModuleContext = {
  module: Bytes,
  definitions: List<Definition>,
  imports: List<Imported>,
  constructors: Constructors,
  builtins: List<Bytes>,
  declared: Map<Bytes, Scheme>,
  machine: Map<Bytes, MachineCall>,
  effects: List<EffectName>,
  release_build: Bool,
}

pub type Root = {
  key: RootKey,
  base: Int,
  params: List<EmitParam>,
  types: List<Type>,
  result_type: Type,
  code: Code,
  performs: Effects,
}

pub fn module_context_in(
  a: Analysis,
  module: Bytes,
) -> Result<{ setting: ModuleContext, roots: List<Root> }, Bytes> / {abort.raise} =
  match range(0, a.modules.len()).fold(None, |accumulator: Option<Int>, k: Int|
      if a.modules.get(k).name == module { Some(k) } else { accumulator }) {
    None -> Err(b"no such module"),
    Some(i) -> match module_contexts_in(
        a,
        rows_of(a),
        inferred_facts(a),
        a.modules,
        [i],
        |_: Int, s: ModuleContext, rs: List<ItemRoot>|
          { setting: s, roots: rs.map(|r: ItemRoot| r.root) },
      ) {
      Err(reason) -> Err(reason),
      Ok(found) -> match found.at(0) { Some(x) -> Ok(x), None -> Err(b"no such module") },
    },
  }

pub fn scheduler_imported(definitions_of: (Bytes) -> List<Definition>) -> List<Imported> = {
  let definitions = definitions_of(scheduler_module());
  if definitions.len() == 0 { [] } else {
    [
      {
        name: scheduler_module(),
        module: scheduler_module(),
        definitions: definitions,
        whole: true,
      },
    ]
  }
}

pub type ItemRoot = { item: Item, root: Root }

pub fn module_contexts_in<b | e>(
  a: Analysis,
  rows: Rows,
  walked: InferredFacts,
  modules: List<ParsedModule>,
  wanted: List<Int>,
  each: (Int, ModuleContext, List<ItemRoot>) -> b / {abort.raise | e},
) -> Result<List<b>, Bytes> / {abort.raise | e} =
  match facts_read(rows, walked, None, modules) {
    Err(reason) -> Err(reason),
    Ok(facts) -> {
      let expanded = modules;
      let pure = facts.pure.fold(Map::new(), |accumulator: Map<Bytes, Bool>, n: Bytes|
        accumulator.insert(n, true));
      let schemes = rows.definitions.fold(
        Map::new(),
        |accumulator: Map<Bytes, Scheme>, row: KnownDefinitionRow|
          accumulator.insert(row.name, row.scheme),
      );
      let values = constant_values(rows);
      let by_name = expanded.fold(
        Map::new(),
        |accumulator: Map<Bytes, List<Definition>>, m: ParsedModule|
          accumulator.insert(m.name, definitions_in(m.name, m.module, pure, schemes, values)),
      );
      let definitions_of = |path: Bytes| match by_name.get(path) { Some(ds) -> ds, None -> [] };
      let read = constructors_read(a.checked);
      let constructors = with_released(
        constructors_of(
          read.rows.map(|c: ConstructorRow| c.name),
          read.keyed,
          read.numeric,
          constructor_sums(read.rows),
        ),
        read.released,
        |by: Bytes| schemes.get(by),
      );
      let declared = declared_schemes();
      let effects = declared_effects(a.r, checked_operations(a.checked.effects));
      let machine = machine_calls(parsed_natives(expanded));
      let owned = facts_by_owner(facts);
      Ok(
        wanted.filter(|i: Int| i < expanded.len()).map(|i: Int| {
          let m = expanded.get(i);
          let here = definitions_of(m.name);
          each(
            i,
            {
              module: m.name,
              definitions: here,
              imports: resolved_imports(
                a.r,
                i,
                expanded,
                m.module,
                definitions_of,
                facts.members.filter(|s: MemberSite| s.module == i),
              ).concat(
                scheduler_imported(definitions_of),
              ),
              constructors: constructors,
              builtins: [],
              declared: declared,
              machine: machine,
              effects: effects,
              release_build: false,
            },
            m.module.items.fold([], |accumulator: List<ItemRoot>, item: Item| {
              let recorded = recorded_annotations(owned, item_owner(m.name, item));
              match item {
                FunctionItem(definition) ->
                  accumulator.push({
                    item: item,
                    root: root_of(m.name, schemes, recorded, definition),
                  }),
                TestItem(t) ->
                  accumulator.push({ item: item, root: test_root(m.name, recorded, t) }),
                LawItem(l) ->
                  accumulator.push({ item: item, root: law_root_of(m.name, recorded, l) }),
                _ -> accumulator,
              }
            }),
          )
        }),
      )
    },
  }

pub fn recorded_annotations(
  owned: Map<Bytes, BodyFacts>,
  owner: Bytes,
) -> SiteAnnotations / {abort.raise} =
  match owned.get(owner) { None -> no_annotations(), Some(f) -> annotations_of(f) }

pub type RootBody = { params: List<EmitParam>, code: Code }

pub fn resolved_at(
  recorded: SiteAnnotations,
  part: BodyPart,
  base: Int,
  args: List<Type>,
) -> TypedBody<Type> / {abort.raise} =
  match body_at(recorded, part, base) {
    None -> unlowered(b"the check resolved no body for its ".concat(part_key(part))),
    Some(found) -> if args.len() == 0 { found } else {
      body_retyped(found, (), {
        ty: |t: Type, u: Unit| { ty: substituted(t, args), state: u },
        effects: |r: Effects| r,
        entry: |a: Effect| a,
        span: |span: Span| span,
      }).out
    },
  }

pub fn root_params(b: TypedBody<Type>, labels: List<Bytes>) -> List<EmitParam> =
  with_labels(
    b.params.map(|q: TypedParam<Type>| {
      let parameter_kind = kind_of(q.ty);
      {
        name: q.name,
        kind: parameter_kind.kind,
        ty: parameter_kind.ty,
        of: Some(q.ty),
        lambda: None,
      }
    }),
    labels.map(|n: Bytes| { name: n, kind: IntKind, ty: OpenShape([]), of: None, lambda: None }),
  )

pub fn body_code(
  b: TypedBody<Type>,
  labels: List<Bytes>,
  recorded: SiteAnnotations,
) -> Code / {abort.raise} = {
  let l = lower_function(b.params, labels, b.body);
  match l.failed.at(0) { Some(reason) -> unlowered(reason), None -> l.code }
}

pub fn root_body(
  recorded: SiteAnnotations,
  part: BodyPart,
  base: Int,
  labels: List<Bytes>,
  args: List<Type>,
) -> RootBody / {abort.raise} = {
  let b = resolved_at(recorded, part, base, args);
  { params: root_params(b, labels), code: body_code(b, labels, recorded) }
}

fn unlowered<a>(reason: Bytes) -> a / {abort.raise} =
  panic(String::of_bytes_lossy(b"a checked body cannot be compiled: ".concat(reason)))

fn body_root(
  key: RootKey,
  recorded: SiteAnnotations,
  part: BodyPart,
  base: Int,
  labels: List<Bytes>,
  result_type: Type,
) -> Root / {abort.raise} = {
  let b = root_body(recorded, part, base, labels, []);
  {
    key: key,
    base: base,
    params: b.params,
    types: b.params.map(param_type),
    result_type: result_type,
    code: b.code,
    performs: no_effects(),
  }
}

fn test_root(module: Bytes, recorded: SiteAnnotations, t: TestDefinition) -> Root / {abort.raise} =
  body_root(test_key(module, t.name), recorded, TestRun, t.span.start, [], unit_type())

fn law_root_of(module: Bytes, recorded: SiteAnnotations, l: LawDefinition) -> Root / {abort.raise} =
  body_root(
    law_key(module, l.name, LawBody),
    recorded,
    typed::LawBody,
    l.span.start,
    [],
    bool_type(),
  )

fn root_of(
  module: Bytes,
  schemes: Map<Bytes, Scheme>,
  recorded: SiteAnnotations,
  definition: FnDefinition,
) -> Root / {abort.raise} = {
  let full = qualify(module, definition.name.name);
  body_root(
    Named(full),
    recorded,
    WholeBody,
    definition.span.start,
    definition.generics.labels.map(|i: Identifier| i.name),
    match sig_of(schemes, full) { Some(s) -> s.result_type, None -> unknown_type() },
  )
}

pub fn param_type(p: EmitParam) -> Type =
  match p.of {
    Some(t) -> t,
    None -> match p.kind {
      IntKind -> int_type(),
      BoolKind -> bool_type(),
      FloatKind -> float_type(),
      DecimalKind -> decimal_type(),
      _ -> unknown_type(),
    },
  }

pub fn constructor_named(s: ModuleContext, written: Bytes) -> Option<Bytes> =
  match qualified(written) {
    Some(q) -> if q.binder == prelude_binder() { known_constructor(s, q.name) } else {
      known_constructor(s, match module_import(s.imports, q.binder) {
        Some(imp) -> qualify(imp.module, q.name),
        None -> Bytes::concat_all([b"std.", q.binder, b".", q.name]),
      })
    },
    None -> match known_constructor(s, qualify(s.module, written)) {
      Some(own) -> Some(own),
      None -> match s.imports.fold(None, |accumulator: Option<Bytes>, imp: Imported|
          match accumulator {
            Some(_) -> accumulator,
            None -> if !imp.whole && imp.name == written {
              known_constructor(s, qualify(imp.module, written))
            } else { None },
          }) {
        Some(imported) -> Some(imported),
        None -> known_constructor(s, written),
      },
    },
  }

pub fn constructor_sum(
  s: ModuleContext,
  full: Bytes,
) -> Option<{ constructors: List<SumConstructor>, index: Int }> =
  match s.constructors.sum_of.get(full) {
    None -> None,
    Some(sum) -> match s.constructors.sums.get(sum) {
      None -> None,
      Some(cs) -> match range(0, cs.len()).fold(None, |at: Option<Int>, i: Int|
          match at {
            Some(_) -> at,
            None -> match cs.at(i) {
              Some(c) -> if c.name == full { Some(i) } else { None },
              None -> None,
            },
          }) {
        Some(i) -> Some({ constructors: cs, index: i }),
        None -> None,
      },
    },
  }

pub fn prelude_constructor(name: Bytes) -> Bytes =
  Bytes::concat_all([prelude_binder(), b"::", name])

fn known_constructor(s: ModuleContext, name: Bytes) -> Option<Bytes> =
  if s.constructors.named.contains(name) { Some(name) } else { None }

pub fn declared_schemes() -> Map<Bytes, Scheme> / {abort.raise} =
  builtins().fold(Map::new(), |m: Map<Bytes, Scheme>, b: Builtin| m.insert(b.name, b.scheme))

pub type CallTypes = { params: List<Type>, result_type: Type }

pub fn builtin_call_types(
  s: ModuleContext,
  recorded: Option<SiteType>,
  name: Bytes,
) -> Option<CallTypes> =
  match recorded {
    None -> declared_call_types(s, name, []),
    Some(t) -> match t.ty {
      FunctionType(f) -> Some({ params: f.params, result_type: f.return_type }),
      _ -> declared_call_types(s, name, t.args),
    },
  }

pub fn declared_call_types(s: ModuleContext, name: Bytes, args: List<Type>) -> Option<CallTypes> =
  match s.declared.get(name) {
    None -> None,
    Some(scheme) -> if scheme.type_variables.len() > 0
        && args.len() != scheme.type_variables.len() { None } else {
      let by = range(0, scheme.type_variables.len()).fold(
        Map::new(),
        |m: Map<Int, Type>, i: Int|
          match scheme.type_variables.at(i) {
            Some(v) -> match args.at(i) { Some(t) -> m.insert(v, t), None -> m },
            None -> m,
          },
      );
      match scheme.ty {
        FunctionType(f) ->
          Some({
            params: f.params.map(|p: Type| instantiated(p, by)),
            result_type: instantiated(f.return_type, by),
          }),
        _ -> None,
      }
    },
  }

fn instantiated(ty: Type, by: Map<Int, Type>) -> Type =
  match ty {
    VariableType(v) -> match by.get(v) { Some(t) -> t, None -> ty },
    NamedType(c) -> NamedType({ ..c, args: c.args.map(|a: Type| instantiated(a, by)) }),
    FunctionType(f) ->
      FunctionType({
        ..f,
        params: f.params.map(|p: Type| instantiated(p, by)),
        return_type: instantiated(f.return_type, by),
      }),
    RecordType(fs) -> RecordType(fs.map(|f: Field| { ..f, ty: instantiated(f.ty, by) })),
    NominalType(x) ->
      NominalType({
        ..x,
        args: x.args.map(|a: Type| instantiated(a, by)),
        fields: x.fields.map(|f: Field| { ..f, ty: instantiated(f.ty, by) }),
      }),
  }

pub fn imported_target(
  imports: List<Imported>,
  name: Bytes,
) -> Option<{ imp: Imported, name: Bytes }> =
  match match qualified(name) {
      Some(q) -> match module_import(imports, q.binder) {
        Some(imp) -> Some({ imp: imp, name: q.name }),
        None -> None,
      },
      None -> match from_import(imports, name) {
        Some(imp) -> Some({ imp: imp, name: name }),
        None -> None,
      },
    } {
    Some(t) -> Some(t),
    None -> match module_import(imports, prelude_binder()) {
      Some(imp) -> if imp.definitions.any(|d: Definition| d.name == name) {
        Some({ imp: imp, name: name })
      } else { None },
      None -> None,
    },
  }

pub fn from_import(xs: List<Imported>, name: Bytes) -> Option<Imported> =
  xs.fold(None, |accumulator: Option<Imported>, i: Imported|
    if !i.whole && i.name == name { Some(i) } else { accumulator })

pub fn qualified(name: Bytes) -> Option<{ binder: Bytes, name: Bytes }> =
  match name.index_of(b"::") {
    None -> None,
    Some(i) -> match name.slice_at(0, i) {
      None -> None,
      Some(binder) -> match name.slice_at(i + 2, name.len() - i - 2) {
        Some(rest) -> Some({ binder: binder, name: rest }),
        None -> None,
      },
    },
  }

pub fn decode_inferred_facts(walked: Bytes) -> Option<InferredFacts> / {abort.raise} =
  if walked.len() == 0 { None }
  else { match bin::decode(walked, inferred_facts_bin()) { Ok(w) -> Some(w), Err(_) -> None } }

pub fn definitions_in(
  module: Bytes,
  m: Module,
  pure: Map<Bytes, Bool>,
  schemes: Map<Bytes, Scheme>,
  values: Map<Bytes, ConstantData>,
) -> List<Definition> =
  m.items.fold([], |accumulator: List<Definition>, item: Item|
    match item {
      FunctionItem(d) -> accumulator.push(definition_entry(module, d, pure, schemes, values)),
      _ -> accumulator,
    })

pub fn declared_effects(resolved: Resolution, operations: Operations) -> List<EffectName> =
  range(0, resolved.declared.len()).fold([], |accumulator: List<EffectName>, j: Int|
    match resolved.declared.at(j) {
      None -> accumulator,
      Some(theirs) ->
        theirs.effects.fold(accumulator, |a: List<EffectName>, b: Binding|
          a.push({
            global: b.qualified,
            operations: match operations.get(b.qualified) { Some(xs) -> xs, None -> [] },
          })),
    })

pub type Operations = Map<Bytes, List<EffectOperation>>

pub fn effect_operation_of(o: OperationInfo) -> EffectOperation =
  {
    name: o.name,
    mode: o.mode,
    params: o.params,
    return_type: o.return_type,
    own: own_type_parameters(o.scheme, o.params, o.return_type),
  }

fn own_type_parameters(scheme: Option<Scheme>, params: List<Type>, result: Type) -> List<Int> =
  match scheme {
    Some(s) -> s.type_variables,
    None ->
      params.push(result).fold([], |accumulator: List<Int>, t: Type|
        type_variables(t).fold(accumulator, |a: List<Int>, v: Int|
          if a.contains(v) { a } else { a.push(v) })),
  }

pub fn checked_operations(effects: List<EffectInfo>) -> Operations =
  effects.fold(Map::new(), |accumulator: Operations, e: EffectInfo|
    accumulator.insert(e.name, e.operations.map(effect_operation_of)))

pub fn published_operations(effects: List<EffectRow>) -> Operations =
  effects.fold(Map::new(), |accumulator: Operations, e: EffectRow|
    accumulator.insert(
      e.name,
      e.operations.map(|o: OperationRow|
        {
          name: o.name,
          mode: match [ReadMode, WriteMode, RaiseMode].find(|m: Mode| mode_text(m) == o.mode) {
            Some(m) -> m,
            None -> InvalidMode,
          },
          params: o.params,
          return_type: o.return_type,
          own: own_type_parameters(o.scheme, o.params, o.return_type),
        }),
    ))

pub fn resolved_imports(
  resolved: Resolution,
  index: Int,
  modules: List<ParsedModule>,
  x_module: Module,
  definitions_of: (Bytes) -> List<Definition>,
  members: List<MemberSite>,
) -> List<Imported> / {abort.raise} = {
  let written = range(0, x_module.imports.len()).fold([], |accumulator: List<Imported>, j: Int| {
    let import_item = x_module.imports.get(j);
    let full = match resolved.imports.get(index).at(j) {
      Some(t) -> modules.get(t).name,
      None -> bytes_join_dots(import_item.path.map(|i: Identifier| i.name)),
    };
    match import_item.kind {
      SelectedNames(ns) ->
        ns.fold(accumulator, |a: List<Imported>, n: Identifier|
          a.push({ name: n.name, module: full, definitions: definitions_of(full), whole: false })),
      WholeModule ->
        accumulator.push({
          name: match import_item.path.at(import_item.path.len() - 1) {
            Some(i) -> i.name,
            None -> b"",
          },
          module: full,
          definitions: definitions_of(full),
          whole: true,
        }),
      ModuleAlias(a2) ->
        implicitly_imported_by(a2.name).fold(
          accumulator.push({
            name: a2.name,
            module: full,
            definitions: definitions_of(full),
            whole: true,
          }),
          |a: List<Imported>, n: Bytes|
            match resolved.scopes.at(index) {
              Some(module_scope) -> match lookup(module_scope.bound, ValueSpace, n) {
                Some(b) -> if b.qualified != qualify(full, n) { a } else {
                  a.push({ name: n, module: full, definitions: definitions_of(full), whole: false })
                },
                None -> a,
              },
              None -> a,
            },
        ),
    }
  });
  let through = members.fold(written, |accumulator: List<Imported>, m: MemberSite|
    List::concat(
      match method_binder_module(m.qualifier) { Some(home) -> [home], None -> [] },
      m.imported_modules,
    ).fold(accumulator, |a: List<Imported>, home: Bytes|
      match module_import(a, method_binder(home)) {
        Some(_) -> a,
        None ->
          a.push({
            name: method_binder(home),
            module: home,
            definitions: definitions_of(home),
            whole: true,
          }),
      }));
  match resolved.scopes.at(index) {
    None -> through,
    Some(scope) ->
      scope.modules.fold(through, |accumulator: List<Imported>, mb: ModuleBinding|
        match module_import(accumulator, mb.binder) {
          Some(_) -> accumulator,
          None -> {
            let full = modules.get(mb.target).name;
            accumulator.push({
              name: mb.binder,
              module: full,
              definitions: definitions_of(full),
              whole: true,
            })
          },
        }),
  }
}

pub fn module_import(xs: List<Imported>, binder: Bytes) -> Option<Imported> =
  xs.fold(None, |accumulator: Option<Imported>, i: Imported|
    if i.whole && i.name == binder { Some(i) } else { accumulator })

fn constructor_module_context(imports: List<Imported>, names: List<Bytes>) -> ModuleContext =
  {
    module: b"m",
    definitions: [],
    imports: imports,
    constructors: constructors_of(
      names,
      [],
      [],
      Map::new().insert(ordering_name(), [
        { name: less_constructor(), index: 0, fields: [], params: [] },
        { name: equal_constructor(), index: 1, fields: [], params: [] },
      ]),
    ),
    builtins: [],
    declared: Map::new(),
    machine: Map::new(),
    effects: [],
    release_build: false,
  }

test "a builtin is typed by what the checker recorded where it called it, else by its declared scheme at the recorded type arguments" {
  let s = { ..constructor_module_context([], []), declared: declared_schemes() };
  let ints = list_type(int_type());
  let len = Some({ params: [ints], result_type: int_type() });
  assert_eq(declared_call_types(s, b"List::len", [int_type()]), len);
  assert_eq(declared_call_types(s, b"List::len", []), None);
  assert_eq(declared_call_types(s, b"m.nothing", []), None);
  assert_eq(
    builtin_call_types(s, Some(site_type(unknown_type(), [int_type()])), b"List::len"),
    len,
  );
  let checked = function_type([bytes_type()], int_type(), no_effects());
  assert_eq(
    builtin_call_types(s, Some(site_type(checked, [int_type()])), b"List::len"),
    Some({ params: [bytes_type()], result_type: int_type() }),
  )
}

test "a bare constructor name resolves to the module's own, else an import's, else the prelude's; a prelude-qualified name resolves only to the prelude's" {
  let names = [b"Less", b"Equal", b"lib.Equal", b"m.Box"];
  let by_name = { name: b"Equal", module: b"lib", definitions: [], whole: false };
  let whole = { name: b"lib", module: b"lib", definitions: [], whole: true };
  assert_eq(
    constructor_named(constructor_module_context([by_name], names), b"Equal"),
    Some(b"lib.Equal"),
  );
  assert_eq(constructor_named(constructor_module_context([], names), b"Equal"), Some(b"Equal"));
  assert_eq(
    constructor_named(constructor_module_context([], names.push(b"m.Equal")), b"Equal"),
    Some(b"m.Equal"),
  );
  assert_eq(
    constructor_named(constructor_module_context([whole], names), b"lib::Equal"),
    Some(b"lib.Equal"),
  );
  assert_eq(constructor_named(constructor_module_context([], names), b"Box"), Some(b"m.Box"));
  assert_eq(constructor_named(constructor_module_context([], names), b"Gone"), None);
  assert_eq(
    constructor_named(
      constructor_module_context([by_name], names.push(b"m.Equal")),
      prelude_constructor(b"Equal"),
    ),
    Some(b"Equal"),
  );
  assert_eq(
    constructor_named(constructor_module_context([], names), prelude_constructor(b"Box")),
    None,
  );
  assert_eq(
    constructor_sum(constructor_module_context([], names), b"Equal"),
    Some({
      constructors: [
        { name: b"Less", index: 0, fields: [], params: [] },
        { name: b"Equal", index: 1, fields: [], params: [] },
      ],
      index: 1,
    }),
  );
  assert_eq(constructor_sum(constructor_module_context([], names), b"m.Box"), None)
}
