//! Values crossing into the runtime and back: written as PLV1 a part at a time through the runtime's
//! crossing natives (a lowering), read back the same way (a lifting), and what is built on them:
//! `?encode`, `?decode`, `observe`, and an extern the runtime answers over its arguments' encoding.
//! A crossing native takes and answers machine data only: an integer's raw bits, a `Float`'s bits,
//! the address and length of a byte string's bytes, a runtime object's word.
//!
//! `lower#T` and `lift#T`, the roots written for each type that crosses, are `emit.written`'s; a
//! part of one at another type, `?lower(x)` and `?lift()`, is a call of that type's root here.

import std.list
import std.bytes
import compiler.syntax.parsing (Span, dummy_span)
import compiler.syntax.type_syntax (MRaise)
import compiler.syntax.exprs (is_exit_effect, exit_op)
import compiler.check.types (Type, TyCon, TyVar, TyFn, TyRecord, TyNominal, Field, named_type,
                             int_type, unit_type, bytes_type, list_type, string_type, spelled_type,
                             bool_type)
import compiler.check.infer.checker (prelude_effects, EffectInfo, OpInfo, RowArguments)
import compiler.emit.typing (unknown_type, rows_filed_at)
import compiler.emit.c (Width, width_named, width_index)
import compiler.emit.roots (builtin_helper)
import compiler.emit.keys
import compiler.emit.keys (RootKey, Root, Written, TypeOp, Lower, Lift, Dup, Worded)
import compiler.emit.tir (Rep, RInt, RBool, RImm, RWord, RFloat, RNum, RDec, RWide, RAddr, RUnit,
                          Arg, AVar, OStrings, string_uses, AInt, AZero, Var, Val, Uses, Prim, Get,
                          PField, PPayload, Pack, Call, Native, Op, OContainer, OHandle, Lent,
                          Owned, Handling, Static, Fn, Inst, Let, Do, Return, Crossing, Declined,
                          Pending, no_links)
import compiler.emit.tir.containers (Taken, Length)
import compiler.emit.tir.strings (Grown)
import compiler.emit.tir.handling (HandleOp, Encoded, Unsettled, VarInit, VarRead, VarWrite)
import compiler.emit.tir.statics (SPlain, SStruct, WRaw, WAddress, WEntry, WBytes, WField, WHead)
import compiler.emit.release (word_form_heads)
import compiler.emit.lower.setting (CallTypes, builtin_at, op_mode_of)
import compiler.emit.lower.held (held_as, held_with, typed_convention)
import compiler.emit.lower.base (Context, Lowering, Lowered, Instanced, refuse, bound, bound_as,
                                 done, handed, type_of, pair_words, filed, unfiled, noted,
                                 static_added)
import compiler.emit.reps (Ctors, SumCtor, OpMode, EffectName, type_vars, runtime_object)
import compiler.emit.print.counting (never_lifted_fn)
import compiler.emit.marks (marks_of, marked_key, carried_by, marked_type, function_marks)
import compiler.emit.answer (Exact)
import compiler.emit.lower.data (field, recorded_as)
import compiler.check.infer.definitions (MachineCall, MachineInt, MachineFloat, MachineText,
                                         MachineSecret, MachineObject, MachineHanded,
                                         MachineFunction, MachineUnit)
import compiler.emit.lower.evidence (value_handing)

/// The externs a body calls over its arguments' encoding whatever type it calls them at, which the
/// runtime decodes, answers as it always has, and encodes the answer of.
pub fn encoded_externs() -> List<Bytes> = [b"assert_eq", b"Secret::private_key", b"Secret::rsa_jwk"]

/// Extern `name` called on `args` over their encoding, as `by_encoding` calls it; in a body generic
/// over its types, a call settled in the specialisations its callers settle. The witnesses the
/// elaboration passes before the arguments are encoded first, as the `Int`s they are, which the
/// runtime's builtin takes as it declares them. `observe` is the identity through that crossing,
/// which no C compiler sees through. `callee` is where its name is written, which the types it is
/// called at are filed under.
pub fn over_encoding(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Span,
  at: Span,
) -> Lowered / {abort.raise} =
  match builtin_at(cx.setting, filed(cx, callee), name) {
    None -> refuse(st, Handling, b"an extern called over its encoding at no type: ".concat(name)),
    Some(types) -> if name == b"observe" && types.params.push(types.ret).all(settled) {
      let at_type = called_at(cx, callee, args);
      match args {
        [x] -> {
          let e = encoded(cx, st, x, at_type, false, at);
          decoded(cx, e.st, e.arg, at_type, at)
        },
        _ -> refuse(st, Handling, b"`observe` of other than one value"),
      }
    } else {
      let witnesses = args.take(args.len() - types.params.len()).map(type_of);
      encoded_at(cx, st, name, args, { ..types, params: witnesses.concat(types.params) }, at)
    },
  }

/// Extern `name` called on `args` over their encoding at `types`, as `by_encoding` calls it; where a
/// type variable leaves them open, a call settled in the specialisations its callers settle.
fn encoded_at(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  types: CallTypes,
  at: Span,
) -> Lowered / {abort.raise} =
  if types.params.push(types.ret).all(settled) { by_encoding(cx, st, name, args, types, at) } else {
    bound(
      cx,
      types.params.push(types.ret).fold(st, |s: Lowering, t: Type|
        type_vars(t).fold(s, |n: Lowering, v: Int| noted(n, { var: v, reads: Exact }))),
      types.ret,
      Op({
        op: OHandle(Unsettled(name)),
        args: args,
        uses: { takes: args.map(|_: Arg| false), owned: true, fails: true, stops: false },
      }),
      at,
    )
  }

/// Builtin `name` the runtime answers, called on `args` over their encoding, answering a value of
/// `ty`.
pub fn through_runtime(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ty: Type,
  at: Span,
) -> Lowered / {abort.raise} =
  encoded_at(cx, st, name, args, { params: args.map(type_of), ret: ty }, at)

/// Whether a call of builtin `name` is lowered here: a crossing native, a part of a crossing root,
/// an encoding or a decoding, `observe`, or an extern called over its arguments' encoding.
pub fn crossing_builtin(name: Bytes) -> Bool =
  machine_named(name) != None || name == b"?lower" || name == b"?lift" || name == b"?encode"
    || name == b"?decode"
    || name == b"?out_carried"
    || name == b"?in_carried"
    || handler_builtin(name)
    || name == b"observe"
    || encoded_externs().contains(name)

/// Builtin `name`, one `crossing_builtin` holds, called on `args`; `callee` is where its name is
/// written, which the type a generic one is called at is filed under.
pub fn crossed(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  callee: Span,
  at: Span,
) -> Lowered / {abort.raise} = {
  let at_type = called_at(cx, callee, args);
  if name == b"?lower" {
    match args {
      [x] -> lowered_part(cx, st, x, at_type, at),
      _ -> refuse(st, Handling, b"a part lowered other than alone"),
    }
  } else if name == b"?lift" { lifted_part(cx, st, at_type, at) } else if name == b"?out_carried" {
    match args {
      [x] -> {
        let word = handed({ st: st, arg: x }, RWord, at);
        let d = type_described(cx, word.st, at_type, at);
        unit_after(native_done(d.st, b"?out_carried", [word.arg, d.arg], false, at))
      },
      _ -> refuse(st, Handling, b"a carried value written other than alone"),
    }
  } else if name == b"?in_carried" {
    let w = bound_as(
      st,
      at_type,
      RWord,
      Native({ name: native_of(name), args: [], uses: answering([], true) }),
      at,
    );
    handed(w, held_as(cx.setting, at_type), at)
  } else if handler_builtin(name) { handler_var(cx, st, name, args, at) }
  else if name == b"?encode" {
    match args {
      [x] -> encoded(cx, st, x, at_type, true, at),
      _ -> refuse(st, Handling, b"an encoding of other than one value"),
    }
  } else if name == b"?decode" {
    match args {
      [b] -> decoded(cx, st, b, at_type, at),
      _ -> refuse(st, Handling, b"a decoding of other than one byte string"),
    }
  } else if name == b"observe" || encoded_externs().contains(name) {
    over_encoding(cx, st, name, args, callee, at)
  } else {
    match machine_named(name) {
      Some(m) -> machine(cx, st, m, args, at_type, at),
      None -> refuse(st, Handling, b"a crossing builtin this family does not lower: ".concat(name)),
    }
  }
}

/// Whether `name` is one of the elaboration's natives over a handler's variables, which its
/// instance holds each with its type: the first value installed, a variable read, a variable set.
fn handler_builtin(name: Bytes) -> Bool =
  name == b"?handler_init" || name == b"?handler_var" || name == b"?handler_set"

/// Handler builtin `name` on `args`, the variable's place first, over the instance of the `handle`
/// around it.
fn handler_var(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  at: Span,
) -> Lowered / {abort.raise} =
  match cx.instance {
    Some(i) -> instance_var(cx, st, i, name, args, at),
    None -> refuse(st, Handling, b"a handler variable outside every handle's instance"),
  }

/// Handler builtin `name` on `args` where the handle's instance `i` holds its variables: each at
/// its place's two words, its value and its type's descriptor.
fn instance_var(
  cx: Context,
  st: Lowering,
  i: Instanced,
  name: Bytes,
  args: List<Arg>,
  at: Span,
) -> Lowered / {abort.raise} = {
  let place = |a: Arg| match a { AInt(n) -> Some(i.vars + 2 * n), _ -> None };
  let op = |o: HandleOp, operands: List<Arg>, takes: List<Bool>|
    Op({
      op: OHandle(o),
      args: [i.word].concat(operands),
      uses: { takes: [false].concat(takes), owned: takes.len() == 0, fails: false, stops: false },
    });
  match args {
    [p] -> if name != b"?handler_var" { refuse(st, Handling, b"a handler variable set to nothing") }
    else {
      match ((place(p), filed(cx, at))) {
        (Some(word_at), Some(t)) ->
          handed(
            bound_as(st, t.ty, RWord, op(VarRead(word_at), [], []), at),
            held_as(cx.setting, t.ty),
            at,
          ),
        _ -> refuse(st, Handling, b"a handler variable read at no place or type"),
      }
    },
    [p, x] -> match place(p) {
      None -> refuse(st, Handling, b"a handler variable named by other than its place"),
      Some(word_at) -> {
        let word = handed({ st: st, arg: x }, RWord, at);
        if name == b"?handler_init" {
          let d = type_described(cx, word.st, type_of(x), at);
          unit_after(done(d.st, op(VarInit(word_at), [word.arg, d.arg], [true, false]), at))
        } else if name == b"?handler_set" {
          unit_after(done(word.st, op(VarWrite(word_at), [word.arg], [true]), at))
        } else { refuse(word.st, Handling, b"a handler variable's read handed a value") }
      },
    },
    _ -> refuse(st, Handling, b"a handler variable named by other than its place"),
  }
}

/// The type a generic crossing builtin is called at, as filed where its name is written: its first
/// type argument; else what its first operand holds.
pub fn called_at(cx: Context, callee: Span, args: List<Arg>) -> Type =
  match filed(cx, callee) {
    Some(t) -> match t.args.at(0) {
      Some(a) -> a,
      None -> match args.at(0) { Some(x) -> type_of(x), None -> unknown_type() },
    },
    None -> match args.at(0) { Some(x) -> type_of(x), None -> unknown_type() },
  }

/// `x`, of type `ty`, written into the innermost lowering by the root written for its type, which
/// reads it while the call runs; the places of `ty` wrapped as carried, by the root that hands them
/// over carried.
fn lowered_part(cx: Context, st: Lowering, x: Arg, ty: Type, at: Span) -> Lowered / {abort.raise} = {
  let held = marks_of(ty).ty;
  if !settled(held) { refuse(st, Handling, b"a value lowered at a type left open") } else {
    let conv = typed_convention(cx.setting.ctors, [held], unit_type());
    let h = handed({ st: st, arg: x }, held_as(cx.setting, held), at);
    bound_as(
      h.st,
      unit_type(),
      conv.answer,
      Call({
        callee: Root(marked_key(Lower, ty, cx.setting.module)),
        args: [h.arg],
        conv: conv,
        stops: false,
      }),
      at,
    )
  }
}

/// A value of type `ty` read from the innermost lifting by the root written for its type; the places
/// of `ty` wrapped as carried, by the root that takes them carried.
fn lifted_part(cx: Context, st: Lowering, ty: Type, at: Span) -> Lowered / {abort.raise} = {
  let held = marks_of(ty).ty;
  if !settled(held) { refuse(st, Handling, b"a value lifted at a type left open") } else {
    let conv = typed_convention(cx.setting.ctors, [], held);
    bound_as(
      st,
      held,
      conv.answer,
      Call({
        callee: Root(marked_key(Lift, ty, cx.setting.module)),
        args: [],
        conv: conv,
        stops: false,
      }),
      at,
    )
  }
}

/// Whether `ty` names every part of a value of it: no type variable and no word erased to `_`.
fn settled(ty: Type) -> Bool =
  match ty {
    TyCon(c) -> c.name != b"_" && c.args.all(settled),
    TyVar(_) -> false,
    TyFn(f) -> f.params.push(f.ret).all(settled),
    TyRecord(fs) -> fs.all(|f: Field| settled(f.ty)),
    TyNominal(x) -> x.fields.all(|f: Field| settled(f.ty)),
  }

/// `x`, of type `ty`, as the bytes of its encoding: a lowering of its own, `x` written into it, and
/// the bytes it ends with copied out. `again` writes a value met a second time as `AGAIN`, which a
/// kept value's reader expands and the runtime's crossing readers refuse.
fn encoded(
  cx: Context,
  st: Lowering,
  x: Arg,
  ty: Type,
  again: Bool,
  at: Span,
) -> Lowered / {abort.raise} = {
  let opened = native_done(st, b"?lower_open", [AInt(if again { 1 } else { 0 })], false, at);
  let written = lowered_part(cx, opened, x, ty, at);
  let n = native_int(written.st, b"?lower_close", [], true, at);
  taken_out(n.st, n.arg, bytes_type(), at)
}

/// The value of type `ty` the encoding `b` holds: a lifting of its own over `b`'s bytes, the value
/// read from it, and the lifting ended, which every byte must have been read by.
fn decoded(cx: Context, st: Lowering, b: Arg, ty: Type, at: Span) -> Lowered / {abort.raise} = {
  let bytes = addressed(st, b, at);
  let opened = native_done(bytes.st, b"?lift_open", [bytes.address, bytes.count], true, at);
  let v = lifted_part(cx, opened, ty, at);
  { st: native_done(v.st, b"?lift_close", [], true, at), arg: v.arg }
}

/// Extern `name` called over its arguments' encoding at `types`, those it takes and answers: each
/// argument lowered at its type into a list the runtime decodes and calls the extern on, which raises
/// as the extern does, or opens a lifting of its answer's encoding, which the answer is read from.
pub fn by_encoding(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  types: CallTypes,
  at: Span,
) -> Lowered / {abort.raise} =
  if types.params.len() != args.len() {
    refuse(st, Handling, b"an extern called over its encoding with other arguments: ".concat(name))
  } else {
    let opened = native_done(st, b"?lower_open", [AInt(0)], false, at);
    let head = native_done(opened, b"?out_count", [AInt(9), AInt(args.len())], false, at);
    let written = range(0, args.len()).fold(head, |s: Lowering, i: Int|
      lowered_part(cx, s, args.get(i), types.params.get(i), at).st);
    let call = Op({
      op: OHandle(Encoded(name)),
      args: [],
      uses: { takes: [], owned: false, fails: true, stops: false },
    });
    // One that never answers raises with nothing open: its answer is a word nothing reads.
    if never_answers(cx, name, args.len()) {
      handed(bound_as(written, types.ret, RWord, call, at), held_as(cx.setting, types.ret), at)
    } else {
      let answer = lifted_part(cx, done(written, call, at), types.ret, at);
      { st: native_done(answer.st, b"?lift_close", [], true, at), arg: answer.arg }
    }
  }

/// `metered(f)`: `f()` and what it cost, the runtime's counts from a mark taken before the call to
/// their reading after it, read back by a lifting as a record of them, `f`'s answer beside them. The
/// reading holds `f` lent, so `f`'s release, the caller's, falls after it, as the lifting does.
/// `apply` calls a function value on nothing.
pub fn metered(
  cx: Context,
  st: Lowering,
  args: List<Arg>,
  at: Span,
  apply: (Lowering, Arg) -> Lowered / {abort.raise},
) -> Lowered / {abort.raise} =
  match args {
    [f] -> {
      let mark = native_int(st, b"?cost_mark", [], false, at);
      let ran = apply(mark.st, f);
      let spent = native_done(ran.st, b"?cost_spent", [mark.arg, f], false, at);
      let counts = lifted_part(cx, spent, counts_type(), at);
      let read = native_done(counts.st, b"?lift_close", [], true, at);
      let fields = [b"allocations", b"bytes", b"live", b"performs", b"steps"].fold(
        { st: read, fields: [] },
        |acc: { st: Lowering, fields: List<{ name: Bytes, arg: Arg }> }, name: Bytes| {
          let x = field(cx, { st: acc.st, arg: counts.arg }, name, at);
          { st: x.st, fields: acc.fields.push({ name: name, arg: x.arg }) }
        },
      );
      let answer = match counts_type() {
        TyRecord(fs) -> TyRecord(fs.push({ name: b"value", ty: type_of(ran.arg) })),
        t -> t,
      };
      recorded_as(cx, fields.st, fields.fields.push({ name: b"value", arg: ran.arg }), answer, at)
    },
    _ -> refuse(st, Handling, b"a `metered` of other than one function"),
  }

/// The counts `?cost_spent` opens a lifting of: what `metered` answers but its function's answer,
/// `value`, which sorts after them.
pub fn counts_type() -> Type =
  TyRecord([
    { name: b"allocations", ty: int_type() },
    { name: b"bytes", ty: int_type() },
    { name: b"live", ty: int_type() },
    {
      name: b"performs",
      ty: list_type(
        TyRecord([
          { name: b"atom", ty: named_type(b"String") },
          { name: b"count", ty: int_type() },
        ]),
      ),
    },
    { name: b"steps", ty: int_type() },
  ])

/// Whether extern `name`, called on `n` arguments, never answers: its declared answer holds a type
/// variable none of its parameters does, and the call passes no witness that would fix it, so it
/// only raises, as `panic` does.
fn never_answers(cx: Context, name: Bytes, n: Int) -> Bool =
  match cx.setting.declared.get(name) {
    Some(sc) -> match sc.ty {
      TyFn(f) ->
        n == f.params.len()
          && type_vars(f.ret).any(|v: Int| !f.params.any(|p: Type| type_vars(p).contains(v))),
      _ -> false,
    },
    None -> false,
  }

// --- The crossing natives ------------------------------------------------------------------

/// What a crossing native takes past the context, as written code calls it, and answers. `Bits` is
/// an integer's raw bits; `Text` the address of a byte string's bytes and then their count, written
/// code handing the byte string; `Object` a runtime object's word, lent.
type Taking = | Bits | FloatBits | Text | Object

/// What a crossing native answers: nothing, raw bits, a `Float`'s bits, how many bytes it left as
/// the crossing's taken bytes, which are copied out into a value of the type the call is filed at,
/// or a runtime object's word with a count of its own.
type Answer = | Nothing | WithBits | WithFloat | WithBytes | WithObject

/// A crossing native as written code calls it: its name, what it takes and answers, and whether a
/// call of it can fail the run: a reading, which meets bytes that do not hold what it reads.
type Machine = { name: Bytes, takes: List<Taking>, answer: Answer, fails: Bool }

/// Every crossing native, as written code calls it. `?out_decimal`, `?out_fixed`, `?in_decimal`
/// and `?in_fixed` are written code's over a value of their type, which `machine` lowers to the
/// natives over its words.
fn machines() -> List<Machine> =
  [
    { name: b"?out_tag", takes: [Bits], answer: Nothing, fails: false },
    { name: b"?out_int", takes: [Bits], answer: Nothing, fails: false },
    { name: b"?out_float", takes: [FloatBits], answer: Nothing, fails: false },
    { name: b"?out_char", takes: [Bits], answer: Nothing, fails: true },
    { name: b"?out_str", takes: [Text], answer: Nothing, fails: false },
    { name: b"?out_bytes", takes: [Text], answer: Nothing, fails: false },
    { name: b"?out_count", takes: [Bits, Bits], answer: Nothing, fails: false },
    { name: b"?out_ctor", takes: [Text, Bits], answer: Nothing, fails: false },
    { name: b"?out_name", takes: [Text], answer: Nothing, fails: false },
    { name: b"?out_handle", takes: [Object], answer: Nothing, fails: false },
    { name: b"?out_fun", takes: [Object, Text], answer: Nothing, fails: false },
    { name: b"?out_again", takes: [Object], answer: WithBits, fails: false },
    { name: b"?in_tag", takes: [], answer: WithBits, fails: true },
    { name: b"?in_int", takes: [], answer: WithBits, fails: true },
    { name: b"?in_float", takes: [], answer: WithFloat, fails: true },
    { name: b"?in_char", takes: [], answer: WithBits, fails: true },
    { name: b"?in_str", takes: [], answer: WithBytes, fails: true },
    { name: b"?in_bytes", takes: [], answer: WithBytes, fails: true },
    { name: b"?in_count", takes: [Bits], answer: WithBits, fails: true },
    { name: b"?in_field", takes: [Text], answer: Nothing, fails: true },
    { name: b"?in_name_is", takes: [Text], answer: WithBits, fails: true },
    { name: b"?in_handle", takes: [], answer: WithObject, fails: true },
    { name: b"?lift_close", takes: [], answer: Nothing, fails: true },
    { name: b"?out_decimal", takes: [], answer: Nothing, fails: false },
    { name: b"?out_fixed", takes: [], answer: Nothing, fails: false },
    { name: b"?in_decimal", takes: [], answer: Nothing, fails: true },
    { name: b"?in_fixed", takes: [], answer: Nothing, fails: true },
  ]

fn machine_named(name: Bytes) -> Option<Machine> =
  machines().fold(None, |acc: Option<Machine>, m: Machine|
    if m.name == name { Some(m) } else { acc })

/// Crossing native `m` called on `args` by written code, its answer of type `ty` where it answers a
/// value of a type its call is filed at.
fn machine(
  cx: Context,
  st: Lowering,
  m: Machine,
  args: List<Arg>,
  ty: Type,
  at: Span,
) -> Lowered / {abort.raise} =
  if m.name == b"?out_decimal" { decimal_out(cx, st, args, at) }
  else if m.name == b"?out_fixed" { fixed_out(cx, st, args, at) }
  else if m.name == b"?in_decimal" { decimal_in(cx, st, ty, at) }
  else if m.name == b"?in_fixed" { fixed_in(cx, st, ty, at) } else if args.len() != m.takes.len() {
    refuse(st, Handling, b"a crossing native called with other operands: ".concat(m.name))
  } else {
    let given = range(0, args.len()).fold(
      { st: st, args: [] },
      |acc: { st: Lowering, args: List<Arg> }, i: Int|
        match m.takes.get(i) {
          Bits -> {
            let h = handed({ st: acc.st, arg: args.get(i) }, RInt, at);
            { st: h.st, args: acc.args.push(h.arg) }
          },
          FloatBits -> {
            let f = handed({ st: acc.st, arg: args.get(i) }, RFloat, at);
            let b = bound_as(
              f.st,
              int_type(),
              RInt,
              Prim({ op: b"bits", on: RFloat, args: [f.arg] }),
              at,
            );
            { st: b.st, args: acc.args.push(b.arg) }
          },
          Text -> {
            let a = addressed(acc.st, args.get(i), at);
            { st: a.st, args: acc.args.push(a.address).push(a.count) }
          },
          Object -> {
            let h = handed({ st: acc.st, arg: args.get(i) }, RWord, at);
            { st: h.st, args: acc.args.push(h.arg) }
          },
        },
    );
    match m.answer {
      Nothing -> unit_after(native_done(given.st, m.name, given.args, m.fails, at)),
      WithBits -> native_int(given.st, m.name, given.args, m.fails, at),
      WithFloat -> {
        let b = native_int(given.st, m.name, given.args, m.fails, at);
        bound_as(
          b.st,
          named_type(b"Float"),
          RFloat,
          Prim({ op: b"of_bits", on: RInt, args: [b.arg] }),
          at,
        )
      },
      WithBytes -> {
        let n = native_int(given.st, m.name, given.args, m.fails, at);
        taken_out(n.st, n.arg, ty, at)
      },
      WithObject -> {
        let w = bound_as(
          given.st,
          ty,
          RWord,
          Native({
            name: native_of(m.name),
            args: given.args,
            uses: answering(given.args, m.fails),
          }),
          at,
        );
        handed(w, held_as(cx.setting, ty), at)
      },
    }
  }

/// A `Decimal` written as its two words.
fn decimal_out(cx: Context, st: Lowering, args: List<Arg>, at: Span) -> Lowered / {abort.raise} =
  match args {
    [d] -> {
      let w = pair_words(st, d, RDec, at);
      unit_after(native_done(w.st, b"?out_decimal", [w.lo, w.hi], false, at))
    },
    _ -> refuse(st, Handling, b"a `Decimal` written other than alone"),
  }

/// A width written as its place among the runtime's widths and its bits: up to 64 its own bits
/// extended to a word as its sign says, past 64 its two words.
fn fixed_out(cx: Context, st: Lowering, args: List<Arg>, at: Span) -> Lowered / {abort.raise} =
  match args {
    [x] -> match width_of(type_of(x)) {
      None -> refuse(st, Handling, b"a width written of no width's type"),
      Some(w) -> if w.bits <= 64 {
        let h = handed({ st: st, arg: x }, RNum(w), at);
        let lo = bound_as(
          h.st,
          int_type(),
          RInt,
          Prim({ op: b"narrow", on: RNum(w), args: [h.arg] }),
          at,
        );
        unit_after(
          native_done(lo.st, b"?out_fixed", [AInt(width_index(w)), lo.arg, AInt(0)], false, at),
        )
      } else {
        let p = pair_words(st, x, RWide(w), at);
        unit_after(native_done(p.st, b"?out_fixed", [AInt(width_index(w)), p.lo, p.hi], false, at))
      },
    },
    _ -> refuse(st, Handling, b"a width written other than alone"),
  }

/// A `Decimal` read as its two words, the low one answered and the high one kept for `?in_high`.
fn decimal_in(cx: Context, st: Lowering, ty: Type, at: Span) -> Lowered / {abort.raise} = {
  let lo = native_int(st, b"?in_decimal", [], true, at);
  let hi = native_int(lo.st, b"?in_high", [], false, at);
  bound_as(
    hi.st,
    named_type(b"Decimal"),
    RDec,
    Prim({ op: b"decimal", on: RInt, args: [lo.arg, hi.arg] }),
    at,
  )
}

/// A width of type `ty` read as its place among the runtime's widths says: up to 64 bits its low
/// word narrowed to it, past 64 its two words.
fn fixed_in(cx: Context, st: Lowering, ty: Type, at: Span) -> Lowered / {abort.raise} =
  match width_of(ty) {
    None -> refuse(st, Handling, b"a width read at no width's type"),
    Some(w) -> {
      let lo = native_int(st, b"?in_fixed", [AInt(width_index(w))], true, at);
      if w.bits <= 64 {
        bound_as(lo.st, ty, RNum(w), Prim({ op: b"narrow", on: RInt, args: [lo.arg] }), at)
      } else {
        let hi = native_int(lo.st, b"?in_high", [], false, at);
        bound_as(hi.st, ty, RWide(w), Prim({ op: b"wide", on: RInt, args: [lo.arg, hi.arg] }), at)
      }
    },
  }

fn width_of(ty: Type) -> Option<Width> =
  match ty { TyCon(c) -> if c.args.len() == 0 { width_named(c.name) } else { None }, _ -> None }

fn word_var(l: Lowered) -> Option<Var> = match l.arg { AVar(v) -> Some(v), _ -> None }

/// The address of the bytes the byte string or string `b` holds, borrowed from it, and how many.
pub fn addressed(st: Lowering, b: Arg, at: Span) -> { st: Lowering, address: Arg, count: Arg } = {
  let w = handed({ st: st, arg: b }, RWord, at);
  match word_var(w) {
    None ->
      {
        st: refuse(w.st, Handling, b"a byte string no variable holds").st,
        address: AInt(0),
        count: AInt(0),
      },
    Some(v) -> {
      let a = bound_as(w.st, int_type(), RAddr, Get({ of: v, path: PPayload }), at);
      let n = bound_as(
        a.st,
        int_type(),
        RInt,
        Op({
          op: OContainer(Length),
          args: [AVar(v)],
          uses: { takes: [false], owned: false, fails: false, stops: false },
        }),
        at,
      );
      { st: n.st, address: a.arg, count: n.arg }
    },
  }
}

/// The `n` bytes the context's crossing holds copied out into a fresh value of type `ty`, a byte
/// string or a string.
pub fn taken_out(st: Lowering, n: Arg, ty: Type, at: Span) -> Lowered =
  bound_as(
    st,
    ty,
    RWord,
    Op({
      op: OContainer(Taken),
      args: [n],
      uses: { takes: [false], owned: true, fails: true, stops: false },
    }),
    at,
  )

/// The C helper crossing native `name` is called through.
fn native_of(name: Bytes) -> Bytes / {abort.raise} = builtin_helper(name).concat(b"_p")

fn answering(args: List<Arg>, fails: Bool) -> Uses =
  { takes: args.map(|_: Arg| false), owned: true, fails: fails, stops: false }

/// Crossing native `name` called on `args`, which it reads, for what it does.
fn native_done(
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  fails: Bool,
  at: Span,
) -> Lowering / {abort.raise} =
  done(
    st,
    Native({
      name: native_of(name),
      args: args,
      uses: { takes: args.map(|_: Arg| false), owned: false, fails: fails, stops: false },
    }),
    at,
  )

/// Crossing native `name` called on `args`, which it reads, its answer raw bits.
fn native_int(
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  fails: Bool,
  at: Span,
) -> Lowered / {abort.raise} =
  bound_as(
    st,
    int_type(),
    RInt,
    Native({ name: native_of(name), args: args, uses: answering(args, fails) }),
    at,
  )

/// `()`, the value of what is done for its effect alone.
fn unit_after(st: Lowering) -> Lowered = { st: st, arg: AZero(RUnit) }

/// `a ++ b`, two strings or two byte strings of type `ty`: `a`'s block, which it takes, grown by
/// `b`'s bytes in place.
pub fn concatenated(cx: Context, st: Lowering, a: Arg, b: Arg, ty: Type, at: Span) -> Lowered = {
  let w = handed({ st: st, arg: a }, RWord, at);
  let t = addressed(w.st, b, at);
  let args = [w.arg, t.address, t.count];
  let g = bound_as(
    t.st,
    ty,
    RWord,
    Op({ op: OStrings(Grown), args: args, uses: string_uses(Grown) }),
    at,
  );
  handed(g, held_as(cx.setting, ty), at)
}

/// Native `name` of a shipped module, which `call` says crosses over machine words, called on
/// `args`, answering `answer` where the checker filed what the call answers, its name written at
/// `callee`: each argument handed as its raw bits, a `Float`'s bits, a string's or byte string's
/// address and count, a secret's or a runtime object's handle, or a function value's block beside
/// its row's descriptor and words, borrowed for the call, or a value of a type variable handed over
/// beside its type's descriptor; and the answer read back from the word the native answers, copied
/// out of the bytes it left taken, or held as the handle or the value it answered. A native that
/// asks the machine refuses where a run may not, so the run is checked after every call.
pub fn over_machine_words(
  cx: Context,
  st: Lowering,
  name: Bytes,
  call: MachineCall,
  args: List<Arg>,
  answer: Option<Type>,
  callee: Span,
  at: Span,
) -> Lowered / {abort.raise} =
  if args.len() != call.params.len() {
    refuse(st, Handling, b"a native over machine words called with other arguments: ".concat(name))
  } else {
    let lent = |acc: { st: Lowering, args: List<Arg>, takes: List<Bool> }, a: Arg| {
      let h = handed({ st: acc.st, arg: a }, RWord, at);
      { st: h.st, args: acc.args.push(h.arg), takes: acc.takes.push(false) }
    };
    let given = range(0, args.len()).fold(
      { st: st, args: [], takes: [] },
      |acc: { st: Lowering, args: List<Arg>, takes: List<Bool> }, i: Int|
        match call.params.get(i) {
          MachineInt(t) -> match match t {
              TyCon(c) -> scalar_words(cx, acc.st, args.get(i), c.name, at),
              _ -> None,
            } {
            Some(w) -> { st: w.st, args: acc.args.push(w.lo), takes: acc.takes.push(false) },
            None ->
              {
                ..acc,
                st: refuse(
                  acc.st,
                  Handling,
                  b"an integer over machine words of no integer's type",
                ).st,
              },
          },
          MachineFloat -> {
            let f = handed({ st: acc.st, arg: args.get(i) }, RFloat, at);
            let b = bound_as(
              f.st,
              int_type(),
              RInt,
              Prim({ op: b"bits", on: RFloat, args: [f.arg] }),
              at,
            );
            { st: b.st, args: acc.args.push(b.arg), takes: acc.takes.push(false) }
          },
          MachineText(_) -> {
            let a = addressed(acc.st, args.get(i), at);
            {
              st: a.st,
              args: acc.args.push(a.address).push(a.count),
              takes: acc.takes.push(false).push(false),
            }
          },
          MachineSecret(_) -> lent(acc, args.get(i)),
          MachineObject(_) -> lent(acc, args.get(i)),
          MachineHanded(_) -> {
            let h = handed({ st: acc.st, arg: args.get(i) }, RWord, at);
            let d = type_described(cx, h.st, type_of(args.get(i)), at);
            {
              st: d.st,
              args: acc.args.push(h.arg).push(d.arg),
              takes: acc.takes.push(true).push(false),
            }
          },
          MachineFunction(k) -> {
            let f = lent(acc, args.get(i));
            match match rows_filed_at(cx.filed, callee.site) {
                Some(RowArguments(rows)) -> rows.at(k),
                _ -> None,
              } {
              None ->
                {
                  ..f,
                  st: refuse(f.st, Handling, b"a function value a native takes at no row").st,
                },
              Some(r) -> {
                let e = value_handing(cx, f.st, r, at);
                { st: e.st, args: f.args.concat(e.args), takes: f.takes.push(false).push(false) }
              },
            }
          },
          MachineUnit -> acc,
        },
    );
    let made = { name: name, args: given.args, takes: given.takes };
    let answered_as = |declared: Type| match answer { Some(t) -> t, None -> declared };
    match call.answer {
      MachineUnit -> {
        let n = native_made(made);
        unit_after(done(given.st, Native({ ..n, uses: { ..n.uses, owned: false } }), at))
      },
      MachineText(t) -> {
        let n = native_word(given.st, made, at);
        taken_out(n.st, n.arg, t, at)
      },
      MachineSecret(t) -> object_answered(cx, given.st, made, answered_as(t), at),
      MachineObject(t) -> object_answered(cx, given.st, made, answered_as(t), at),
      MachineHanded(_) -> match answer {
        None -> refuse(given.st, Handling, b"a native's value of a type variable at no type filed"),
        Some(t) -> {
          let d = type_described(cx, given.st, t, at);
          object_answered(
            cx,
            d.st,
            { ..made, args: made.args.push(d.arg), takes: made.takes.push(false) },
            t,
            at,
          )
        },
      },
      MachineFunction(_) -> refuse(given.st, Handling, b"a native answering a function value"),
      MachineFloat -> {
        let b = native_word(given.st, made, at);
        bound_as(
          b.st,
          named_type(b"Float"),
          RFloat,
          Prim({ op: b"of_bits", on: RInt, args: [b.arg] }),
          at,
        )
      },
      MachineInt(t) -> integer_answered(native_word(given.st, made, at), t, at),
    }
  }

/// A call of a native over machine words: its name, the words it passes, and which of them it takes.
type NativeMade = { name: Bytes, args: List<Arg>, takes: List<Bool> }

fn native_made(m: NativeMade) -> { name: Bytes, args: List<Arg>, uses: Uses } / {abort.raise} =
  {
    name: native_of(m.name),
    args: m.args,
    uses: { takes: m.takes, owned: true, fails: true, stops: false },
  }

/// What the call `m` answers, a raw word.
fn native_word(st: Lowering, m: NativeMade, at: Span) -> Lowered / {abort.raise} =
  bound_as(st, int_type(), RInt, Native(native_made(m)), at)

/// What the call `m` answers, a word the caller holds as a value of `t`.
fn object_answered(
  cx: Context,
  st: Lowering,
  m: NativeMade,
  t: Type,
  at: Span,
) -> Lowered / {abort.raise} =
  handed(bound_as(st, t, RWord, Native(native_made(m)), at), held_as(cx.setting, t), at)

/// The word `w` a native answered read as a value of the integer type `t`: an `Int` as it is, a
/// `Bool` as whether it is other than 0, a `Char` as the scalar value it is, and a width narrowed.
fn integer_answered(w: Lowered, t: Type, at: Span) -> Lowered =
  match t {
    TyCon(c) -> if c.name == b"Bool" {
      bound_as(w.st, t, RBool, Prim({ op: b"ne", on: RInt, args: [w.arg, AInt(0)] }), at)
    } else if c.name == b"Char" {
      bound_as(w.st, t, RImm, Prim({ op: b"char_of", on: RInt, args: [w.arg] }), at)
    } else {
      match width_named(c.name) {
        Some(n) -> bound_as(w.st, t, RNum(n), Prim({ op: b"narrow", on: RInt, args: [w.arg] }), at),
        None -> w,
      }
    },
    _ -> w,
  }

/// The BLAKE3 hash of byte string `a`, read in place by the `?blake3` native, whose answer's bytes
/// are copied out.
pub fn blake3_of(st: Lowering, a: Arg, at: Span) -> Lowered / {abort.raise} = {
  let t = addressed(st, a, at);
  let n = native_int(t.st, b"?blake3", [t.address, t.count], false, at);
  taken_out(n.st, n.arg, bytes_type(), at)
}

/// The encoding `digest` hashes of `a`, a value of the scalar type `ty`, as the runtime's natives
/// write it over its words or its bytes: a `()`, a `Bool`, an `Int`, a width, a `Char`, a
/// `Decimal`, a string or a byte string. None at any other type.
pub fn scalar_encoding(
  cx: Context,
  st: Lowering,
  a: Arg,
  ty: Type,
  at: Span,
) -> Option<Lowered> / {abort.raise} =
  match ty {
    TyCon(c) -> if c.args.len() > 0 { None } else if c.name == b"String" || c.name == b"Bytes" {
      let t = addressed(st, a, at);
      let text = AInt(if c.name == b"String" { 1 } else { 0 });
      let n = native_int(t.st, b"?text_encoded", [text, t.address, t.count], true, at);
      Some(taken_out(n.st, n.arg, bytes_type(), at))
    } else {
      match scalar_words(cx, st, a, c.name, at) {
        None -> None,
        Some(w) -> {
          let n = native_int(
            w.st,
            b"?scalar_encoded",
            [AInt(w.kind), AInt(w.t), w.lo, w.hi],
            true,
            at,
          );
          Some(taken_out(n.st, n.arg, bytes_type(), at))
        },
      }
    },
    _ -> None,
  }

/// The kind `?scalar_encoded` reads a value of the scalar type named `name` as, its width's place,
/// and its words; none for a type of no such kind.
fn scalar_words(
  cx: Context,
  st: Lowering,
  a: Arg,
  name: Bytes,
  at: Span,
) -> Option<{ st: Lowering, kind: Int, t: Int, lo: Arg, hi: Arg }> / {abort.raise} =
  if name == b"Unit" { Some({ st: st, kind: 0, t: 0, lo: AInt(0), hi: AInt(0) }) }
  else if name == b"Bool" {
    let b = handed({ st: st, arg: a }, RBool, at);
    Some({ st: b.st, kind: 1, t: 0, lo: b.arg, hi: AInt(0) })
  } else if name == b"Int" {
    let n = handed({ st: st, arg: a }, RInt, at);
    Some({ st: n.st, kind: 2, t: 0, lo: n.arg, hi: AInt(0) })
  } else if name == b"Char" {
    let k = handed({ st: st, arg: a }, RImm, at);
    let v = bound_as(
      k.st,
      int_type(),
      RInt,
      Prim({ op: b"char_code", on: RImm, args: [k.arg] }),
      at,
    );
    Some({ st: v.st, kind: 4, t: 0, lo: v.arg, hi: AInt(0) })
  } else if name == b"Decimal" {
    let p = pair_words(st, a, RDec, at);
    Some({ st: p.st, kind: 5, t: 0, lo: p.lo, hi: p.hi })
  } else {
    match width_named(name) {
      None -> None,
      Some(w) -> if w.bits > 64 {
        let p = pair_words(st, a, RWide(w), at);
        Some({ st: p.st, kind: 3, t: width_index(w), lo: p.lo, hi: p.hi })
      } else {
        let x = handed({ st: st, arg: a }, RNum(w), at);
        let n = bound_as(
          x.st,
          int_type(),
          RInt,
          Prim({ op: b"narrow", on: RNum(w), args: [x.arg] }),
          at,
        );
        // Below 64 bits a width is the `Int` it reads as.
        if w.bits < 64 { Some({ st: n.st, kind: 2, t: 0, lo: n.arg, hi: AInt(0) }) }
        else { Some({ st: n.st, kind: 3, t: width_index(w), lo: n.arg, hi: AInt(0) }) }
      },
    }
  }

// --- Descriptors ---------------------------------------------------------------------------

/// The address of `type#T`, the descriptor the runtime counts and crosses a value of type `t`
/// through, each function it holds at a place crossing carried, bound as an uncounted word, its
/// static added with the roots its words name. At a type a body generic over it leaves open, the
/// specialisations its callers settle describe it.
pub fn type_described(cx: Context, st: Lowering, t: Type, at: Span) -> Lowered / {abort.raise} =
  if !settled(t) {
    bound_as(
      type_vars(t).fold(st, |s: Lowering, v: Int| noted(s, { var: v, reads: Exact })),
      int_type(),
      RInt,
      Op({
        op: OHandle(Unsettled(b"type#".concat(spelled_type(t)))),
        args: [],
        uses: { takes: [], owned: false, fails: false, stops: false },
      }),
      at,
    )
  } else {
    let s = type_static(cx.setting.ctors, cx.setting.module, st, t, function_marks(t));
    bound_as(s.st, int_type(), RInt, Static(s.name), at)
  }

/// The address of `kept#T`, the descriptor a kept value of type `t` is held beside: `type#T`, the
/// entry comparing two values of `t` for equality where `built.equal`, and the one ordering them
/// where `built.order`, bound as an uncounted word. At a type a body generic over it leaves open, the
/// specialisations its callers settle describe it.
pub fn kept_described(
  cx: Context,
  st: Lowering,
  t: Type,
  built: { equal: Bool, order: Bool },
  at: Span,
) -> Lowered / {abort.raise} =
  if !settled(t) {
    bound_as(
      type_vars(t).fold(st, |s: Lowering, v: Int| noted(s, { var: v, reads: Exact })),
      int_type(),
      RInt,
      Op({
        op: OHandle(Unsettled(b"kept#".concat(spelled_type(t)))),
        args: [],
        uses: { takes: [], owned: false, fails: false, stops: false },
      }),
      at,
    )
  } else {
    let module = cx.setting.module;
    let ty = type_static(cx.setting.ctors, module, st, t, function_marks(t));
    let entry = |op: TypeOp, built: Bool|
      if built { WEntry(keys::written(Worded(op), t, module)) } else { WRaw(0) };
    let k = static_added(
      ty.st,
      SStruct({
        of: b"PlyKept",
        fields: [
          WAddress({ name: ty.name, tag: 0 }),
          entry(keys::Equal, built.equal),
          entry(keys::Order, built.order),
        ],
      }),
    );
    bound_as(k.st, int_type(), RInt, Static(k.name), at)
  }

/// `st` holding `op#`, the descriptor of operation `op` of effect `eff` as a perform at argument types
/// `params` answering `answer` meets it, and that static's name: the effect's and the operation's
/// field-table entries; the answer's type, each place an own type parameter stands at taken carried;
/// which parameters are one of those parameters whole, kept carried; each parameter's type, a place
/// of one nested in it crossing carried; and the type each own type parameter stands for, in the
/// order `op` declares them. `None` where a type is left open, the specialisations' to settle.
pub fn op_described(
  cx: Context,
  st: Lowering,
  eff: Bytes,
  op: OpMode,
  params: List<Type>,
  answer: Type,
) -> { st: Lowering, name: Option<Bytes> } / {abort.raise} =
  if !params.push(answer).all(settled) {
    {
      st: params.push(answer).fold(st, |s: Lowering, t: Type|
        type_vars(t).fold(s, |n: Lowering, v: Int| noted(n, { var: v, reads: Exact }))),
      name: None,
    }
  } else {
    let module = cx.setting.module;
    let declared = |i: Int| match op.params.at(i) { Some(d) -> d, None -> unknown_type() };
    let whole = |i: Int| match declared(i) { TyVar(v) -> op.own.contains(v), _ -> false };
    let walked = range(0, params.len()).map(|i: Int|
      carried_by(declared(i), params.get(i), op.own));
    let ret = carried_by(op.ret, answer, op.own);
    let vars = own_types(op, params, answer);
    if vars.any(|t: Option<Type>| t == None) { { st: st, name: None } } else {
      let typed = |s: Lowering, t: Type, marks: List<Int>|
        type_static(cx.setting.ctors, module, s, t, marks);
      let answered = typed(st, answer, marks_of(ret.marked).marks);
      let taken = range(0, params.len()).fold(
        { st: answered.st, names: [] },
        |acc: { st: Lowering, names: List<Bytes> }, i: Int| {
          let d = typed(acc.st, params.get(i), if whole(i) { [] }
          else { marks_of(walked.get(i).marked).marks });
          { st: d.st, names: acc.names.push(d.name) }
        },
      );
      let stood = vars.fold(
        { st: taken.st, names: [] },
        |acc: { st: Lowering, names: List<Bytes> }, t: Option<Type>|
          match t {
            Some(x) -> {
              let d = typed(acc.st, x, []);
              { st: d.st, names: acc.names.push(d.name) }
            },
            None -> acc,
          },
      );
      let listed = |s: Lowering, names: List<Bytes>|
        if names.len() == 0 { { st: s, word: WRaw(0) } } else {
          let l = static_added(s, SPlain(names.map(|n: Bytes| WAddress({ name: n, tag: 0 }))));
          { st: l.st, word: WAddress({ name: l.name, tag: 0 }) }
        };
      let ps = listed(stood.st, taken.names);
      let vs = listed(ps.st, stood.names);
      let d = static_added(
        vs.st,
        SStruct({
          of: b"PlyOp",
          fields: [
            WField(eff),
            WField(op.name),
            WAddress({ name: answered.name, tag: 0 }),
            WRaw(
              range(0, params.len()).fold(0, |m: Int, i: Int|
                if whole(i) { m + (1 << i) } else { m }),
            ),
            WRaw(params.len()),
            ps.word,
            WRaw(stood.names.len()),
            vs.word,
          ],
        }),
      );
      { st: d.st, name: Some(d.name) }
    }
  }

/// The type each of `op`'s own type parameters stands for where a perform at argument types `params`
/// answers `answer`, in the order `op` declares them; none for one those types leave unsaid.
pub fn own_types(
  op: OpMode,
  params: List<Type>,
  answer: Type,
) -> List<Option<Type>> / {abort.raise} = {
  let declared = |i: Int| match op.params.at(i) { Some(d) -> d, None -> unknown_type() };
  let bound = range(0, params.len()).fold([], |acc: List<{ var: Int, ty: Type }>, i: Int|
    acc.concat(carried_by(declared(i), params.get(i), op.own).bound)).concat(
    carried_by(op.ret, answer, op.own).bound,
  );
  op.own.map(|v: Int|
    bound.fold(None, |found: Option<Type>, b: { var: Int, ty: Type }|
      if found == None && b.var == v { Some(b.ty) } else { found }))
}

/// The effect named `global` program-wide, with its operations in the order it declares them: one
/// the program declares, in whichever module, or one of the prelude's.
pub fn effect_of(cx: Context, global: Bytes) -> Option<EffectName> / {abort.raise} =
  if is_exit_effect(global) { Some(exit_effect_named(global)) } else {
    match cx.setting.effects.find(|e: EffectName| e.global == global && e.ops.len() > 0) {
      Some(e) -> Some(e),
      None ->
        prelude_effects().find(|e: EffectInfo| e.name == global).map(|e: EffectInfo|
          { written: e.name, global: e.name, ops: e.ops.map(op_mode_of) }),
    }
  }

/// The effect named `name` a `?` inside a `handle` leaves it by (`exit_effect`): one raise of what
/// the `?` exits with, of a type each raise names.
pub fn exit_effect_named(name: Bytes) -> EffectName =
  {
    written: name,
    global: name,
    ops: [{ name: exit_op(), mode: MRaise, params: [TyVar(0)], ret: TyVar(1), own: [0, 1] }],
  }

/// How a function holding `word`, its evidence object for `abort`, raises a raise the runtime left
/// pending as it leaves on a failure: `abort.raise` by its place, its `op#` and the descriptor of
/// `String` static objects of `st`.
pub fn pending_raised(
  cx: Context,
  st: Lowering,
  word: Var,
) -> { st: Lowering, pending: Option<Pending> } / {abort.raise} =
  match effect_of(cx, b"abort") {
    None -> { st: st, pending: None },
    Some(e) -> match range(0, e.ops.len()).find(|k: Int| e.ops.get(k).name == b"raise") {
      None -> { st: st, pending: None },
      Some(k) -> {
        let d = op_described(cx, st, e.global, e.ops.get(k), [string_type()], unit_type());
        match d.name {
          None -> { st: d.st, pending: None },
          Some(op) -> {
            let s = type_static(
              cx.setting.ctors,
              cx.setting.module,
              d.st,
              string_type(),
              function_marks(string_type()),
            );
            { st: s.st, pending: Some({ word: word, index: k, op: op, string: s.name }) }
          },
        }
      },
    },
  }

/// `st` holding `type#T` for `t` as module `module` asks for it over the program's constructors
/// `ctors`, the places `marks` names crossing as carried: `t`'s identity and spelling, then the
/// entries the runtime calls over a value's word form, counting it (`dup#T`) and letting go of it
/// (`release#T`), the head's own where the form holds no block a root lets go of, and the word-form
/// lowering and lifting, the head's refusal where a value of `t` can hold a function, which crosses
/// out of compiled code and never back; and the static's name.
fn type_static(
  ctors: Ctors,
  module: Bytes,
  st: Lowering,
  t: Type,
  marks: List<Int>,
) -> { st: Lowering, name: Bytes } / {abort.raise} = {
  let spelled = spelled_type(t);
  let text = static_added(st, SPlain([WBytes(spelled)]));
  let marked = |op: TypeOp| keys::marked(keys::written(op, t, module), marks);
  let heads = word_form_heads(ctors, t);
  static_added(
    text.st,
    SStruct({
      of: b"PlyType",
      fields: [
        WRaw(match spelled.blake3().u64_at(0) { Some(n) -> n, None -> 0 }),
        WAddress({ name: text.name, tag: 0 }),
        WRaw(spelled.len()),
        match heads { Some(h) -> WHead(h.dup), None -> WEntry(keys::written(Dup, t, module)) },
        match heads {
          Some(h) -> WHead(h.release),
          None -> WEntry(keys::written(keys::Release, t, module)),
        },
        WEntry(marked(Worded(Lower))),
        if holds_function(ctors, marked_type(t, marks)) { WHead(never_lifted_fn()) }
        else { WEntry(marked(Worded(Lift))) },
      ],
    }),
  )
}

/// Whether a value of `t` can hold a function its crossing does not carry: one of a function type,
/// or a record, a sum's case or a type's argument that can, over the constructors `ctors`, but a
/// runtime object's, which crosses as a handle whatever it holds, and a place marked carried. Each
/// sum's cases are read once, so the walk ends within the parts of `t` and of every sum's cases.
pub fn holds_function(ctors: Ctors, t: Type) -> Bool / {abort.raise} =
  iterate({ todo: [t], seen: [] }, 1 << 24, |s: { todo: List<Type>, seen: List<Bytes> }|
    match s.todo {
      [] -> Stop(false),
      [x, ..rest] -> match x {
        TyFn(_) -> Stop(true),
        TyVar(_) -> Continue({ ..s, todo: rest }),
        TyRecord(fs) -> Continue({ ..s, todo: rest.concat(fs.map(|f: Field| f.ty)) }),
        TyNominal(n) -> Continue({ ..s, todo: rest.concat(n.fields.map(|f: Field| f.ty)) }),
        TyCon(k) -> if k.name == b"^" { Continue({ ..s, todo: rest }) } else {
          match if s.seen.contains(k.name) { None } else { ctors.sums.get(k.name) } {
            Some(cs) ->
              Continue({
                todo: rest.concat(k.args).concat(
                  cs.fold([], |a: List<Type>, c: SumCtor| a.concat(c.fields)),
                ),
                seen: s.seen.push(k.name),
              }),
            None ->
              Continue({
                ..s,
                todo: if runtime_object(k.name) { rest } else { rest.concat(k.args) },
              }),
          }
        },
      },
    })

/// The entry `type#T` or `kept#T` names for `k`, `Worded(op)` of `T`: handed `T`'s word form, lent,
/// the lowering of the value it is (`Lower`), answering nothing; the lifting (`Lift`), answering the
/// value's word form, owned; or handed two, whether they are equal (`Equal`) or the sign of their
/// order (`Order`), as a word.
pub fn worded(ctors: Ctors, k: RootKey) -> Result<Fn, Declined> =
  match k {
    Written(w, _) -> {
      let rep = held_with(ctors, w.ty);
      let word = { id: 0, ty: w.ty, rep: RWord };
      let held = { id: 1, ty: w.ty, rep: rep };
      let call = |op: TypeOp, args: List<Arg>, answer: Type|
        Call({
          callee: Root(keys::as_op(k, op)),
          args: args,
          conv: typed_convention(ctors, args.map(|_: Arg| w.ty), answer),
          stops: false,
        });
      let opened = rep == RWord;
      match w.op {
        // It answers the `()` the lowering answered, which the runtime lets go of unread.
        Worded(Lower) -> {
          let done = { id: 2, ty: unit_type(), rep: held_with(ctors, unit_type()) };
          Ok(
            entry_fn(
              k,
              unit_type(),
              done.rep,
              [word],
              (if opened { [] } else {
                [
                  Let({
                    var: held,
                    val: Pack({ arg: AVar(word), to: rep }),
                    at: dummy_span(),
                    unwind: [],
                  }),
                ]
              }).concat([
                Let({
                  var: done,
                  val: call(Lower, [AVar(if opened { word } else { held })], unit_type()),
                  at: dummy_span(),
                  unwind: [],
                }),
                Return(AVar(done)),
              ]),
            ),
          )
        },
        Worded(Lift) -> {
          let out = { id: 2, ty: w.ty, rep: RWord };
          Ok(
            entry_fn(
              k,
              w.ty,
              RWord,
              [],
              [Let({ var: held, val: call(Lift, [], w.ty), at: dummy_span(), unwind: [] })].concat(
                if opened { [Return(AVar(held))] } else {
                  [
                    Let({
                      var: out,
                      val: Pack({ arg: AVar(held), to: RWord }),
                      at: dummy_span(),
                      unwind: [],
                    }),
                    Return(AVar(out)),
                  ]
                },
              ),
            ),
          )
        },
        // Two values compared as `==` at the type compares them, answering `Bool`'s word, or ordered
        // as `compare` orders them, answering the sign of the `Ordering`, below, at or above zero.
        Worded(op) -> if op != keys::Equal && op != keys::Order {
          Err({ by: Handling, why: b"a word-form entry of no crossing or comparison" })
        } else {
          let other = { id: 1, ty: w.ty, rep: RWord };
          let left = { id: 2, ty: w.ty, rep: rep };
          let right = { id: 3, ty: w.ty, rep: rep };
          let answered_ty = if op == keys::Equal { bool_type() } else { named_type(b"Ordering") };
          let answered = { id: 4, ty: answered_ty, rep: held_with(ctors, answered_ty) };
          let signed = { id: 5, ty: int_type(), rep: RInt };
          let word_ty = if op == keys::Equal { answered_ty } else { int_type() };
          let out = { id: 6, ty: word_ty, rep: RWord };
          let let_of = |v: Var, val: Val| Let({ var: v, val: val, at: dummy_span(), unwind: [] });
          let held_pair = if opened { [] } else {
            [
              let_of(left, Pack({ arg: AVar(word), to: rep })),
              let_of(right, Pack({ arg: AVar(other), to: rep })),
            ]
          };
          let compared = if opened { [AVar(word), AVar(other)] } else { [AVar(left), AVar(right)] };
          let finished = if op == keys::Equal {
            [let_of(out, Pack({ arg: AVar(answered), to: RWord }))]
          } else {
            [
              let_of(signed, Prim({ op: b"sign", on: answered.rep, args: [AVar(answered)] })),
              let_of(out, Pack({ arg: AVar(signed), to: RWord })),
            ]
          };
          Ok(
            entry_fn(
              k,
              word_ty,
              RWord,
              [word, other],
              held_pair.push(let_of(answered, call(op, compared, answered_ty))).concat(
                finished,
              ).push(
                Return(AVar(out)),
              ),
            ),
          )
        },
        _ -> Err({ by: Handling, why: b"a word-form entry of other than a lowering or a lifting" }),
      }
    },
    _ -> Err({ by: Handling, why: b"a word-form entry of no type" }),
  }

/// Root `k`, taking `params` lent at their own reps, running `body` and answering a value of type
/// `answer_ty` held as `answer`, owned; the ownership pass places its counts.
fn entry_fn(k: RootKey, answer_ty: Type, answer: Rep, params: List<Var>, body: List<Inst>) -> Fn =
  {
    key: k,
    kind: Crossing,
    params: params,
    conv: {
      params: params.map(|_: Var| Lent),
      reps: params.map(|v: Var| v.rep),
      answer: answer,
      destined: false,
      answered: Owned,
    },
    answer_ty: answer_ty,
    body: body,
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  }
