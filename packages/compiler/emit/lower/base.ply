//! The state a root's body is lowered in, and what every part of the lowering shares: binding a
//! value, a block of its own, a join, a frame of its own for a body lowered as a function, a
//! refusal. Nothing here calls the lowering's recursion, which `emit.lower` alone holds.

import emit.code
import emit.code (Code, CodeArm, Capture)
import check.types (Type, TyVar, TyCon, TyFn, TyRecord, TyNominal, Field, named_type)
import emit.typing (Typed, Filings, unknown_type)
import syntax.parsing (Span, dummy_span)
import std.bytes (ascii_of_int)
import emit.reps (EmitParam)
import emit.answer (Need)
import emit.keys (RootKey, root_name, root_text)
import emit.tir (Rep, RInt, RBool, RNum, RFloat, RDec, Var, Arg, AVar, AInt, ABool, AFloat, ANum,
                 AChar, AZero, Val, Pack, Native, Inst, Let, Do, Decl, Assign, If, Case, Match,
                 Miss, Loop, Next, Done, Return, Restart, Enter, Fail, Handle, Sited, Inc, Dec,
                 Reset, Free, Opened, Block, Lambda, Links, Declined, Family, Spine, RWord, RUnit,
                 RSlice, Gathered, rep_of_arg, falls_through, counted, operands, parts_of)
import emit.lower.setting (Setting)
import emit.lower.held (held_as)
import emit.tir.statics (StaticDef, StaticLaid, SPlain, WAddress, WBytes, named)

/// What a root's body is lowered under: the module's setting, the root's key and full name, where
/// its definition's text starts, its parameters as the emitter holds them and their types, how its
/// answer is handed back and its type, the body itself, where a call in tail position goes, each
/// parameter's place among them by its variable's id (`i` for `i` in a root of its own; a tail
/// group's member's variables are numbered apart from the other members'), and, in a lambda another
/// root lent this one, run in place, that root and every lambda it lends by their places, by which
/// what the lambda hands on is numbered. An `observing` lowering writes where each slot is read and
/// each frame entered (`read_noted`, `frame_entered`), for `emit.moves` to read the form's moves
/// off; nothing else lowers so. `frame` is the place of the lambda whose slots the body being
/// lowered reads, or nowhere in the root's own, and `captured` the slots of that frame that hold
/// what the frame around it handed in. `lends` is whether the root lends its own lambdas,
/// as read under this setting, and `written` what it lends then: the lambdas its body writes and
/// the definitions it hands as values, read once for the whole body. `filed` is what the checker
/// filed for the nodes of the body being lowered: the root's item's, or its lender's in a lambda run
/// in place.
pub type Context = {
  setting: Setting,
  filed: Filings,
  key: RootKey,
  full: Bytes,
  base: Int,
  params: List<EmitParam>,
  types: List<Type>,
  answer: Rep,
  answer_ty: Type,
  body: Code,
  tails: Tails,
  param_at: Map<Int, Int>,
  lender: Option<{ owner: RootKey, written: List<code::Lambda> }>,
  /// Each root whose lambda a slot of this body, or of a closure it makes, may be known to hold, by
  /// the name its code calls it: the root itself, each root a parameter was handed a lambda of, and
  /// each lender whose lambda runs here.
  owners: Map<Bytes, RootKey>,
  observing: Bool,
  frame: Span,
  captured: List<Int>,
  lends: Bool,
  written: List<code::Lambda>,
}

/// Where a call in tail position goes without a call of its own: to the root's start where it calls
/// the root's own definition, its parameters held there as `Restarts` says, to a member of the
/// root's tail group (its members' keys in case order), or nowhere, in a closure's body.
pub type Tails = | Restarts(List<Rep>) | Enters(List<RootKey>) | Calls

/// A body lowered so far: the next variable's number, what each slot holds, the block being
/// written, the first refusal, the closures' bodies made so far, the static objects the root and its
/// closures name so far, each after those it names, and what the root tells the unit.
pub type Lowering = {
  next: Int,
  env: Map<Int, Arg>,
  insts: List<Inst>,
  refused: Option<Declined>,
  lambdas: List<Lambda>,
  statics: List<StaticDef>,
  links: Links,
}

/// A node lowered: the state after it and the operand holding its value.
pub type Lowered = { st: Lowering, arg: Arg }

/// What a call calls: a constructor, a builtin, a definition by its full name, a function value, or
/// a body run in place of the call (a known lambda's where `None`, else the lambda argument at that
/// place, a step's).
pub type Target =
  | ToCtor(Bytes)
  | ToBuiltin(Bytes)
  | ToDef(Bytes)
  | ToValue
  | ToInPlace(Option<Int>)

/// A body lowered as a function of its own: how many parameters lead its slots, its frame's size,
/// what it copies in from the frame around it, and whether its last parameter is the continuation a
/// handler's clause binds, a word of no type the runtime calls.
pub type Frame = { params: Int, size: Int, captures: List<Capture>, resumes: Bool }

/// A body to lower under a context of its own, from its first state.
pub type Opened = { cx: Context, st: Lowering }

/// A `match` arm lowered: the arm as written, its guard's value where it has one, and its body.
pub type Armed = { arm: CodeArm, guard: Option<Lowered>, body: Lowered }

/// A `handle` clause made: the label it keys on where it names one, and its closure.
pub type ClauseMade = { label: Option<Arg>, closure: Arg }

/// A member of a tail group: its context and its body.
pub type GroupMember = { cx: Context, body: Code }

/// The first state of a body whose leading slots hold `params`.
pub fn started(params: List<Var>) -> Lowering =
  {
    next: params.fold(0, |n: Int, p: Var| if p.id >= n { p.id + 1 } else { n }),
    env: range(0, params.len()).fold(Map::new(), |m: Map<Int, Arg>, i: Int|
      match params.at(i) { Some(p) -> m.insert(i, AVar(p)), None -> m }),
    insts: [],
    refused: None,
    lambdas: [],
    statics: [],
    links: { generics: [], needs: [], called: [], passes: [] },
  }

/// `st` refused for the reason `why` the part `by` gives, unless it was refused already.
pub fn refuse(st: Lowering, by: Family, why: Bytes) -> Lowered =
  {
    st: match st.refused { Some(_) -> st, None -> { ..st, refused: Some({ by: by, why: why }) } },
    arg: AZero(RInt),
  }

/// A new variable of type `ty` held as `rep`.
pub fn fresh(st: Lowering, ty: Type, rep: Rep) -> { st: Lowering, var: Var } =
  { st: { ..st, next: st.next + 1 }, var: { id: st.next, ty: ty, rep: rep } }

/// `val` bound to a new variable of type `ty`, held as a value of that type is in a body.
pub fn bound(cx: Context, st: Lowering, ty: Type, val: Val, at: Span) -> Lowered =
  bound_as(st, ty, held_as(cx.setting, ty), val, at)

/// `val` bound to a new variable of type `ty` held as `rep`.
pub fn bound_as(st: Lowering, ty: Type, rep: Rep, val: Val, at: Span) -> Lowered = {
  let v = fresh(st, ty, rep);
  { st: emitted(v.st, Let({ var: v.var, val: val, at: at, unwind: [] })), arg: AVar(v.var) }
}

/// `val` done for what it does, its answer let go.
pub fn done(st: Lowering, val: Val, at: Span) -> Lowering =
  emitted(st, Do({ val: val, at: at, unwind: [] }))

pub fn emitted(st: Lowering, i: Inst) -> Lowering = { ..st, insts: st.insts.push(i) }

/// The name an observing lowering's note of a slot read stands under, of a slot a closure captures
/// where it is made, and of a frame whose slots are bound anew.
pub fn read_note() -> Bytes = b"#read"

pub fn capture_note() -> Bytes = b"#capture"

pub fn enter_note() -> Bytes = b"#enter"

/// `st`, where `cx` observes, noting that `slot` of `cx`'s frame is read at `at`: an operation over
/// the slot's number and the frame's site that reads no variable and does nothing, so the
/// ownership pass places every count as it would without it.
pub fn read_noted(cx: Context, st: Lowering, note: Bytes, slot: Int, at: Span) -> Lowering =
  if !cx.observing { st } else { with_note(st, note, [AInt(slot), AInt(cx.frame.site)], at) }

/// `st`, where `cx` observes, noting that `cx`'s frame is entered at `at` with every slot bound
/// anew: a known lambda's body run in place, or a step's pass.
pub fn frame_entered(cx: Context, st: Lowering, at: Span) -> Lowering =
  if !cx.observing { st } else { with_note(st, enter_note(), [AInt(cx.frame.site)], at) }

fn with_note(st: Lowering, note: Bytes, args: List<Arg>, at: Span) -> Lowering =
  done(
    st,
    Native({
      name: note,
      args: args,
      uses: { takes: args.map(|_: Arg| false), owned: false, fails: false, stops: false },
    }),
    at,
  )

/// A block of its own after `st`: its environment, no instructions yet.
pub fn opened(st: Lowering) -> Lowering = { ..st, insts: [] }

/// `outer`, whose block and environment go on, after a block of its own lowered to `inner`: the
/// variables, closures, statics, links and refusal `inner` added.
pub fn continued(outer: Lowering, inner: Lowering) -> Lowering =
  {
    ..outer,
    next: inner.next,
    refused: match outer.refused { Some(r) -> Some(r), None -> inner.refused },
    lambdas: inner.lambdas,
    statics: inner.statics,
    links: inner.links,
  }

/// The first state of a body lowered as a function of its own inside `st`'s: its variables numbered
/// from its parameters, `env` its slots, the root's closures, statics and links carried on.
pub fn nested(st: Lowering, params: List<Var>, env: Map<Int, Arg>) -> Lowering =
  {
    ..started(params),
    env: env,
    refused: st.refused,
    lambdas: st.lambdas,
    statics: st.statics,
    links: st.links,
  }

/// `outer` after a function of its own lowered to `inner`: `outer`'s variables, block and
/// environment, and the closures, statics, links and refusal `inner` added.
pub fn unnested(outer: Lowering, inner: Lowering) -> Lowering =
  {
    ..outer,
    refused: match outer.refused { Some(r) -> Some(r), None -> inner.refused },
    lambdas: inner.lambdas,
    statics: inner.statics,
    links: inner.links,
  }

/// `st` holding the static object laid as `laid`, named by its content as `emit.tir.statics.named`
/// names it, once however often it is added; and that name, which `Val.Static` reads the object by.
/// A static whose words address others is added after them, so the root lists each after those it
/// names.
pub fn static_added(
  st: Lowering,
  laid: StaticLaid,
) -> { st: Lowering, name: Bytes } / {abort.raise} = {
  let d = named(laid);
  {
    st: if st.statics.any(|x: StaticDef| x.name == d.name) { st }
    else { { ..st, statics: st.statics.push(d) } },
    name: d.name,
  }
}

/// `l` added as the body of the next closure the root makes, and its place among them.
pub fn with_lambda(st: Lowering, l: Lambda) -> { st: Lowering, nth: Int } =
  { st: { ..st, lambdas: st.lambdas.push(l) }, nth: st.lambdas.len() }

/// `st` noting that a specialisation would read `need` of a type variable.
pub fn noted(st: Lowering, need: Need) -> Lowering =
  if st.links.needs.contains(need) { st }
  else { { ..st, links: { ..st.links, needs: st.links.needs.push(need) } } }

/// What the checker filed for the node at `at` of the body being lowered, or of its lender's in a
/// lambda run in place. A node of a kind the checker files for always has one; `None` is a
/// refusal, never a cue to read something else.
pub fn filed(cx: Context, at: Span) -> Option<Typed> = cx.filed.typed.get(at.site)

/// `st` refused for `what` at `at`, which the checker filed nothing for: the owner, the site, the
/// place.
pub fn unfiled(cx: Context, st: Lowering, what: Bytes, at: Span) -> Lowered =
  refuse(
    st,
    Spine,
    Bytes::concat_all([
      what,
      b" the check filed nothing for: `",
      match cx.lender { Some(l) -> root_text(root_name(l.owner)), None -> cx.full },
      b"` site ",
      ascii_of_int(at.site),
      b" at ",
      ascii_of_int(at.start),
      b":",
      ascii_of_int(at.end),
    ]),
  )

/// `l`, the value of slot `slot`, bound as `name`, read at `at`: where the slot is one the frame was
/// handed or holds a word, taken at the type the checker filed for the read, else at its own, since
/// a body another root lends the lambda to holds a capture as a word of no type, and a
/// specialisation is handed a parameter of its full type as the call crosses it, a word where a
/// variable the call does not carry stands; any other slot holds the type its binder gave it.
pub fn read_taken(cx: Context, l: Lowered, name: Bytes, slot: Int, at: Span) -> Lowered = {
  let captured = cx.captured.contains(slot);
  if !captured && rep_of_arg(l.arg) != RWord { l } else {
    match filed(cx, at) {
      None -> if captured {
        unfiled(cx, l.st, Bytes::concat_all([b"a read of capture `", name, b"`"]), at)
      } else { taken_as(cx, l, type_of(l.arg), at) },
      Some(t) -> taken_as(cx, l, if t.ty == unknown_type() { type_of(l.arg) } else { t.ty }, at),
    }
  }
}

/// The type an operand holds.
pub fn type_of(a: Arg) -> Type =
  match a {
    AVar(v) -> v.ty,
    AInt(_) -> named_type(b"Int"),
    ABool(_) -> named_type(b"Bool"),
    AFloat(_) -> named_type(b"Float"),
    ANum(n) -> width_type(n.width),
    AChar(_) -> named_type(b"Char"),
    AZero(r) -> zero_type(r),
  }

/// The type a zero held as `r` is of where `r` says it: a scalar's own, and `Unit` for a value of no
/// words, whose word is 0; unknown for any other representation.
fn zero_type(r: Rep) -> Type =
  match r {
    RUnit -> named_type(b"Unit"),
    RInt -> named_type(b"Int"),
    RBool -> named_type(b"Bool"),
    RFloat -> named_type(b"Float"),
    RDec -> named_type(b"Decimal"),
    RNum(w) -> width_type(w),
    _ -> unknown_type(),
  }

fn width_type(w: { bits: Int, signed: Bool }) -> Type =
  named_type(Bytes::concat_all([if w.signed { b"I" } else { b"U" }, digits(w.bits)]))

fn digits(n: Int) -> Bytes =
  if n == 8 { b"8" }
  else if n == 16 { b"16" }
  else if n == 32 { b"32" }
  else if n == 64 { b"64" }
  else { b"128" }

/// `l`'s value held as `to`: an integer constant written as the width it is handed as, a zero of a
/// representation holding no count as `to`'s where `to` holds none either (the zero of each is the
/// number zero), a value made by holding one held as `to` otherwise that nothing has read since and
/// no slot names as that one, and anything else packed, a sum's zero among them (an `Option`'s is
/// `None`). A value no slot names, which nothing reads after the operation it is handed to, packed
/// into one holding a count but holding no more than it did is packed right after the block last
/// names it: the operands an operation is handed are each made what it takes as soon as they are
/// made, so what a failure among them holds only grows and the failure paths share their releases,
/// rather than each releasing every operand still unpacked and every one packed. A list's word
/// handed as a view is a view of it from its first item.
pub fn handed(l: Lowered, to: Rep, at: Span) -> Lowered =
  if rep_of_arg(l.arg) == to { l } else if to == RSlice && rep_of_arg(l.arg) == RWord {
    bound_as(l.st, type_of(l.arg), RSlice, Gathered({ parts: [l.arg, AInt(0)] }), at)
  } else {
    let packed = bound_as(l.st, type_of(l.arg), to, Pack({ arg: l.arg, to: to }), at);
    match l.arg {
      AInt(n) -> match to {
        RNum(w) -> { st: l.st, arg: ANum({ width: w, bits: n }) },
        _ -> packed,
      },
      AZero(r) -> if !counted(r) && !counted(to) { { st: l.st, arg: AZero(to) } } else { packed },
      AVar(v) -> match packed_from(l.st, v, to) {
        Some(s) -> { st: l.st, arg: AVar(s) },
        None -> if counted(to) && counts_in(to) <= counts_in(v.rep) && !slot_named(l.st, v) {
          packed_after(l.st, v, to, at)
        } else { packed },
      },
      _ -> packed,
    }
  }

/// `l` as what reads a slot holding it anywhere but in the walk down a list it views: the list, where
/// it is a view of one.
pub fn unviewed(l: Lowered, at: Span) -> Lowered =
  if rep_of_arg(l.arg) == RSlice { handed(l, RWord, at) } else { l }

/// How many of the values a value held as `r` is laid in hold a count.
fn counts_in(r: Rep) -> Int = parts_of(r).filter(counted).len()

fn slot_named(st: Lowering, v: Var) -> Bool =
  st.env.fold(false, |named: Bool, _: Int, a: Arg| named || a == AVar(v))

/// `v` packed as `to` into a new variable, the `Let` that does it placed right after the last
/// instruction of `st`'s block that names `v`, but after any change of whose sites follow; at the
/// block's end where nothing in it names `v`, which a block around holds.
fn packed_after(st: Lowering, v: Var, to: Rep, at: Span) -> Lowered = {
  let w = fresh(st, v.ty, to);
  let named = after_naming(st.insts, v.id);
  let k = if named == 0 { st.insts.len() } else { named };
  {
    st: {
      ..w.st,
      insts: st.insts.take(k).push(
        Let({ var: w.var, val: Pack({ arg: AVar(v), to: to }), at: at, unwind: [] }),
      ).concat(
        st.insts.drop(k),
      ),
    },
    arg: AVar(w.var),
  }
}

/// The place in `b` right after the last instruction that names variable `id` or changes whose
/// sites follow; 0 where none does.
fn after_naming(b: Block, id: Int) -> Int =
  b.fold_right({ at: b.len(), found: false }, |i: Inst, s: { at: Int, found: Bool }|
    if s.found { s }
    else if names(i, id) || (match i { Sited(_) -> true, _ -> false }) { { ..s, found: true } }
    else { { at: s.at - 1, found: false } }).at

/// Whether instruction `i`, or a block it holds, names variable `id`.
fn names(i: Inst, id: Int) -> Bool = named_by(i, id, true)

fn names_in(b: Block, id: Int) -> Bool = b.any(|i: Inst| names(i, id))

/// Whether instruction `i`, or a block it holds, names variable `id`, a `Let` binding it among them
/// where `binding`.
fn named_by(i: Inst, id: Int, binding: Bool) -> Bool = {
  let within = |b: Block| b.any(|x: Inst| named_by(x, id, binding));
  match i {
    Let(l) ->
      (binding && l.var.id == id)
        || operands(l.val).any(|o: { arg: Arg, takes: Bool }| arg_names(o.arg, id)),
    Do(d) -> operands(d.val).any(|o: { arg: Arg, takes: Bool }| arg_names(o.arg, id)),
    Decl(v) -> v.id == id,
    Assign(s) -> s.var.id == id || arg_names(s.arg, id),
    If(x) -> arg_names(x.cond, id) || within(x.then) || within(x.otherwise),
    Case(c) ->
      c.on.id == id || within(c.rest) || c.arms.any(|a: { when: Int, body: Block }| within(a.body)),
    Match(m) -> within(m.rest) || m.arms.any(within),
    Loop(l) ->
      l.answer.id == id || l.state.any(|s: Var| s.id == id) || l.init.any(|a: Arg| arg_names(a, id))
        || within(l.body),
    Next(args) -> args.any(|a: Arg| arg_names(a, id)),
    Done(a) -> arg_names(a, id),
    Return(a) -> arg_names(a, id),
    Restart(args) -> args.any(|a: Arg| arg_names(a, id)),
    Enter(e) -> e.args.any(|a: Arg| arg_names(a, id)),
    Handle(h) -> h.answer.id == id || h.args.any(|a: Arg| arg_names(a, id)) || within(h.body),
    Inc(n) -> n.var.id == id,
    Dec(v) -> v.id == id,
    Reset(r) -> r.token.id == id || r.of.id == id,
    Free(f) -> f.of.id == id || arg_names(f.bytes, id),
    Opened(o) -> o.of.id == id || o.words.any(|w: Var| w.id == id),
    Fail(_) -> false,
    Miss -> false,
    Sited(_) -> false,
  }
}

/// The variable `v` was packed from, held as `to`, where `st`'s block makes `v` by packing one that
/// block does not declare to be set again: what a read of `v` reads where it lies, `v` left to any
/// other reader.
pub fn packed_from(st: Lowering, v: Var, to: Rep) -> Option<Var> = {
  let declared = |s: Var| st.insts.any(|i: Inst| i == Decl(s));
  st.insts.fold(None, |found: Option<Var>, i: Inst|
    match i {
      Let(l) -> if l.var != v { found } else {
        match l.val {
          Pack(p) -> match p.arg {
            AVar(s) -> if s.rep == to && !declared(s) { Some(s) } else { None },
            _ -> None,
          },
          _ -> None,
        }
      },
      _ -> found,
    })
}

/// Body `b` without each `Pack` nothing in it reads: a value made for a reader that read what it was
/// made from instead.
pub fn unread_packs_dropped(b: Block) -> Block =
  unread_dropped_in(b, |id: Int| b.any(|i: Inst| named_by(i, id, false)))

fn unread_dropped_in(b: Block, read: (Int) -> Bool) -> Block =
  b.fold([], |acc: List<Inst>, i: Inst|
    match i {
      Let(l) -> match l.val {
        Pack(_) -> if read(l.var.id) { acc.push(i) } else { acc },
        _ -> acc.push(i),
      },
      If(x) ->
        acc.push(
          If({
            ..x,
            then: unread_dropped_in(x.then, read),
            otherwise: unread_dropped_in(x.otherwise, read),
          }),
        ),
      Case(c) ->
        acc.push(
          Case({
            ..c,
            arms: c.arms.map(|a: { when: Int, body: Block }|
              { when: a.when, body: unread_dropped_in(a.body, read) }),
            rest: unread_dropped_in(c.rest, read),
          }),
        ),
      Match(m) ->
        acc.push(
          Match({
            arms: m.arms.map(|a: Block| unread_dropped_in(a, read)),
            rest: unread_dropped_in(m.rest, read),
          }),
        ),
      Loop(l) -> acc.push(Loop({ ..l, body: unread_dropped_in(l.body, read) })),
      Handle(h) -> acc.push(Handle({ ..h, body: unread_dropped_in(h.body, read) })),
      _ -> acc.push(i),
    })

fn arg_names(a: Arg, id: Int) -> Bool = match a { AVar(v) -> v.id == id, _ -> false }

/// `l`'s value at what `t`, the type the checker gave it, says of each part `l`'s variable's type
/// leaves unsaid: a lambda another root lent, run in place where its arguments and captures arrive
/// as a type variable's words or a specialisation's erased ones, reads them at the types it was
/// written for, as far as those say. The variable itself where that type is held as it is;
/// otherwise its word, the value itself where it is one, held as that type is: an erased `Option<_>`
/// is its payload's word where an `Option` of a record is its cases, and a capture, a word of its
/// full type, is held as that type. `l` as it is for anything else, a view among them.
pub fn taken_as(cx: Context, l: Lowered, t: Type, at: Span) -> Lowered =
  match l.arg {
    AVar(v) -> {
      let said = told(v.ty, t);
      let rep = held_as(cx.setting, said);
      if rep == v.rep { if said == v.ty { l } else { { st: l.st, arg: AVar({ ..v, ty: said }) } } }
      else if said == v.ty && v.rep != RWord { l } else {
        let word = handed(l, RWord, at);
        match word.arg {
          AVar(w) -> if rep == RWord { { st: word.st, arg: AVar({ ..w, ty: said }) } }
          else { bound_as(word.st, said, rep, Pack({ arg: word.arg, to: rep }), at) },
          _ -> l,
        }
      }
    },
    _ -> l,
  }

/// `s` with each part it leaves unsaid told by `t`'s part at the same place, where `t` says
/// something there: a type variable of `t`'s, which is another root's, read as a word it says
/// nothing more of. A part `s` says is kept, and so is all of `s` where `t` is shaped otherwise.
fn told(s: Type, t: Type) -> Type =
  if blank(s) { if blank(t) { s } else { worded(t) } } else {
    match s {
      TyCon(c) -> match t {
        TyCon(d) -> if d.name != c.name || d.args.len() != c.args.len() { s }
        else { TyCon({ name: c.name, args: told_all(c.args, d.args) }) },
        _ -> s,
      },
      TyRecord(fs) -> match t { TyRecord(gs) -> TyRecord(told_fields(fs, gs)), _ -> s },
      TyNominal(x) -> match t {
        TyNominal(y) -> if y.name != x.name { s }
        else { TyNominal({ ..x, fields: told_fields(x.fields, y.fields) }) },
        _ -> s,
      },
      TyFn(f) -> match t {
        TyFn(g) -> if g.params.len() != f.params.len() { s }
        else { TyFn({ ..f, params: told_all(f.params, g.params), ret: told(f.ret, g.ret) }) },
        _ -> s,
      },
      _ -> s,
    }
  }

fn told_all(ss: List<Type>, ts: List<Type>) -> List<Type> =
  range(0, ss.len()).fold([], |acc: List<Type>, i: Int|
    match ss.at(i) {
      Some(x) -> acc.push(match ts.at(i) { Some(y) -> told(x, y), None -> x }),
      None -> acc,
    })

fn told_fields(fs: List<Field>, gs: List<Field>) -> List<Field> =
  fs.map(|f: Field|
    match gs.fold(None, |acc: Option<Type>, g: Field|
        if g.name == f.name { Some(g.ty) } else { acc }) {
      Some(gt) -> { name: f.name, ty: told(f.ty, gt) },
      None -> f,
    })

/// Whether `t` says nothing of a value: a type variable, or a word erased to `_`.
fn blank(t: Type) -> Bool =
  match t { TyVar(_) -> true, TyCon(c) -> c.name == b"_" && c.args.len() == 0, _ -> false }

/// `t` with each type variable, which is another root's, read as a word, `_`.
fn worded(t: Type) -> Type =
  match t {
    TyVar(_) -> TyCon({ name: b"_", args: [] }),
    TyCon(c) -> TyCon({ name: c.name, args: c.args.map(worded) }),
    TyFn(f) -> TyFn({ ..f, params: f.params.map(worded), ret: worded(f.ret) }),
    TyRecord(fs) -> TyRecord(fs.map(|f: Field| { name: f.name, ty: worded(f.ty) })),
    TyNominal(x) ->
      TyNominal({
        ..x,
        args: x.args.map(worded),
        fields: x.fields.map(|f: Field| { name: f.name, ty: worded(f.ty) }),
      }),
  }

/// Whether `t` leaves part of a value's type unsaid: a type variable, or a word a specialisation
/// erased to `_`, which says nothing more of it.
pub fn unsaid(t: Type) -> Bool =
  match t {
    TyVar(_) -> true,
    TyCon(c) -> c.name == b"_" || c.args.any(unsaid),
    TyFn(f) -> f.params.push(f.ret).any(unsaid),
    TyRecord(fs) -> fs.any(|f: Field| unsaid(f.ty)),
    TyNominal(x) -> x.fields.any(|f: Field| unsaid(f.ty)),
  }


/// `args` each handed over as a word.
pub fn as_words(st: Lowering, args: List<Arg>, at: Span) -> { st: Lowering, args: List<Arg> } =
  args.fold({ st: st, args: [] }, |acc: { st: Lowering, args: List<Arg> }, a: Arg| {
    let h = handed({ st: acc.st, arg: a }, RWord, at);
    { st: h.st, args: acc.args.push(h.arg) }
  })

/// The type a join of `arms` holds: the first arm's that falls through holding a variable, then the
/// first's that falls through, then the root's answer's.
pub fn join_type(cx: Context, arms: List<Lowered>) -> Type = {
  let live = arms.filter(|a: Lowered| falls_through(a.st.insts));
  match live.fold(None, |acc: Option<Type>, a: Lowered|
      match acc { Some(_) -> acc, None -> match a.arg { AVar(v) -> Some(v.ty), _ -> None } }) {
    Some(t) -> t,
    None -> match live.at(0) { Some(a) -> type_of(a.arg), None -> cx.answer_ty },
  }
}

/// An arm's block ending in its value set into join `j`, held as `j` is; an arm that leaves sets
/// nothing. `st` numbers what it adds.
pub fn set_join(st: Lowering, arm: Lowered, j: Var, at: Span) -> { st: Lowering, block: Block } =
  if !falls_through(arm.st.insts) { { st: st, block: arm.st.insts } } else {
    let h = handed({ st: { ..st, insts: arm.st.insts }, arg: arm.arg }, j.rep, at);
    { st: { ..h.st, insts: st.insts }, block: h.st.insts.push(Assign({ var: j, arg: h.arg })) }
  }

/// How a join of type `ty` holds its value: in tail position as the body answers, which is a word
/// for a clause that resumes, whose continuation hands back what the runtime resumes with and no
/// value of `ty`; elsewhere as its type holds it.
pub fn join_held(cx: Context, ty: Type, tail: Bool) -> Rep =
  if tail { cx.answer } else { held_as(cx.setting, ty) }

/// An `if` whose arms join in a variable of the type they answer.
pub fn joined(
  cx: Context,
  cond: Lowered,
  then: Lowered,
  otherwise: Lowered,
  tail: Bool,
  at: Span,
) -> Lowered = {
  let ty = join_type(cx, [then, otherwise]);
  let j = fresh(continued(cond.st, otherwise.st), ty, join_held(cx, ty, tail));
  let t = set_join(j.st, then, j.var, at);
  let e = set_join(t.st, otherwise, j.var, at);
  {
    st: {
      ..e.st,
      insts: cond.st.insts.push(Decl(j.var)).push(
        If({ cond: cond.arg, then: t.block, otherwise: e.block }),
      ),
    },
    arg: AVar(j.var),
  }
}

/// `l && r` or `l || r`: a `Bool` joined from the right operand where the left one does not decide.
pub fn short_circuit(cx: Context, l: Lowered, r: Lowered, both: Bool, at: Span) -> Lowered = {
  let j = fresh(continued(l.st, r.st), named_type(b"Bool"), RBool);
  let right = set_join(j.st, r, j.var, at);
  let decided = [Assign({ var: j.var, arg: ABool(!both) })];
  {
    st: {
      ..right.st,
      insts: l.st.insts.push(Decl(j.var)).push(
        If({
          cond: l.arg,
          then: if both { right.block } else { decided },
          otherwise: if both { decided } else { right.block },
        }),
      ),
    },
    arg: AVar(j.var),
  }
}

test "a zero is handed as another representation's zero only where neither holds a count" {
  let st = started([]);
  let byte = RNum({ bits: 8, signed: false });
  assert_eq(handed({ st: st, arg: AZero(RInt) }, byte, dummy_span()).arg, AZero(byte));
  // A value of no words handed as a word is its word 0, which is packed, of `Unit`'s type, which its
  // release reads.
  assert_eq(
    match handed({ st: st, arg: AZero(RUnit) }, RWord, dummy_span()).st.insts {
      [Let(x)] -> Some({ val: x.val, ty: x.var.ty }),
      _ -> None,
    },
    Some({ val: Pack({ arg: AZero(RUnit), to: RWord }), ty: named_type(b"Unit") }),
  );
  // A word's zero may stand for a count, so it is read as an `Int`, not taken for one's zero.
  assert(handed({ st: st, arg: AZero(RWord) }, RInt, dummy_span()).st.insts != [], None)
}

test "a word just opened to its type and handed straight back as a word is the word itself" {
  let int = named_type(b"Int");
  let w = { id: 0, ty: int, rep: RWord };
  let opened = bound_as(started([w]), int, RInt, Pack({ arg: AVar(w), to: RInt }), dummy_span());
  let back = handed(opened, RWord, dummy_span());
  assert_eq(back.arg, AVar(w));
  // The opening stays for any other reader, and goes where nothing reads it.
  assert_eq(back.st.insts, opened.st.insts);
  assert_eq(unread_packs_dropped(back.st.insts), []);
  let named = { ..opened, st: { ..opened.st, env: opened.st.env.insert(1, opened.arg) } };
  assert_eq(handed(named, RWord, dummy_span()).arg, AVar(w));
  // Held back as another representation than the word it came from, it is packed.
  let byte = RNum({ bits: 8, signed: false });
  assert(handed(opened, byte, dummy_span()).arg != AVar(w), None)
}

test "a static is held once however often it is added, after the static it addresses, and a lambda's are the root's" {
  let spelling = SPlain([WBytes(b"m.T")]);
  let child = static_added(started([]), spelling);
  let parent = static_added(child.st, SPlain([WAddress({ name: child.name, tag: 0 })]));
  let again = static_added(parent.st, spelling);
  assert_eq(again.name, child.name);
  assert_eq(again.st.statics.map(|d: StaticDef| d.name), [child.name, parent.name]);
  // One added while a lambda's body is lowered is the root's when the root goes on.
  let inner = static_added(nested(child.st, [], Map::new()), SPlain([WBytes(b"m.U")]));
  assert_eq(unnested(child.st, inner.st).statics.map(|d: StaticDef| d.name), [
    child.name,
    inner.name,
  ])
}
