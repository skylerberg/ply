//! The state a root's body is lowered in, and what every part of the lowering shares: binding a
//! value, a block of its own, a join, a frame of its own for a body lowered as a function, a
//! refusal. Nothing here calls the lowering's recursion, which `emit.lower` alone holds.

import emit.code
import emit.code (Code, CodeArm, Capture)
import check.types (Type, TyVar, TyCon, TyFn, TyRecord, TyNominal, Field, named_type)
import emit.typing (unknown_type)
import syntax.parsing (Span, span_key, dummy_span)
import emit.reps (Carrier, EmitParam)
import emit.answer (Need)
import emit.roots (builtin_helper)
import emit.keys (RootKey)
import emit.tir (Rep, RInt, RBool, RNum, Var, Arg, AVar, AInt, ABool, AFloat, ANum, AChar, AZero,
                 Val, Pack, Native, Inst, Let, Do, Decl, Assign, If, Block, Lambda, Links, Declined,
                 Family, RWord, RMaybe, rep_of_arg, falls_through, counted)
import emit.lower.setting (Setting)
import emit.lower.held (held_as)

/// What a root's body is lowered under: the module's setting, the root's key and full name, where
/// its definition's text starts, its parameters as the emitter holds them and their types, how its
/// answer crosses a call and its type, the body itself, where a call in tail position goes, each
/// parameter's place among them by its variable's id (`i` for `i` in a root of its own; a tail
/// group's member's variables are numbered apart from the other members'), and, in a lambda another
/// root lent this one, run in place, that root and every lambda it lends by their places, by which
/// what the lambda hands on is numbered. An `observing` lowering writes where each slot is read and
/// each frame entered (`read_noted`, `frame_entered`), for `emit.moves` to read the form's moves
/// off; nothing else lowers so. `frame` is the place of the lambda whose slots the body being
/// lowered reads, or nowhere in the root's own. `lends` is whether the root lends its own lambdas,
/// as read under this setting, and `written` what it lends then: the lambdas its body writes and
/// the definitions it hands as values, read once for the whole body.
pub type Context = {
  setting: Setting,
  key: RootKey,
  full: Bytes,
  base: Int,
  params: List<EmitParam>,
  types: List<Type>,
  answer: Carrier,
  answer_ty: Type,
  body: Code,
  tails: Tails,
  param_at: Map<Int, Int>,
  lender: Option<{ owner: Bytes, written: List<code::Lambda> }>,
  observing: Bool,
  frame: Span,
  lends: Bool,
  written: List<code::Lambda>,
}

/// Where a call in tail position goes without a call of its own: to the root's start where it calls
/// the root's own definition, to a member of the root's tail group (full names in case order), or
/// nowhere, in a closure's body.
pub type Tails = | Restarts | Enters(List<Bytes>) | Calls

/// A body lowered so far: the next variable's number, what each slot holds, the block being
/// written, the first refusal, the closures' bodies made so far, and what the root tells the unit.
pub type Lowering = {
  next: Int,
  env: Map<Int, Arg>,
  insts: List<Inst>,
  refused: Option<Declined>,
  lambdas: List<Lambda>,
  links: Links,
}

/// A node lowered: the state after it and the operand holding its value.
pub type Lowered = { st: Lowering, arg: Arg }

/// What a call calls: a constructor, a builtin, a definition by its full name, a function value, or
/// a body run in place of the call (a known lambda's where `None`, else the lambda argument at that
/// place, a step's).
pub type Target =
  | ToCtor(Bytes)
  | ToBuiltin(Bytes)
  | ToDef(Bytes)
  | ToValue
  | ToInPlace(Option<Int>)

/// A body lowered as a function of its own: how many parameters lead its slots, its frame's size,
/// what it copies in from the frame around it, and whether its last parameter is the continuation a
/// handler's clause binds, a word of no type the runtime calls.
pub type Frame = { params: Int, size: Int, captures: List<Capture>, resumes: Bool }

/// A body to lower under a context of its own, from its first state.
pub type Opened = { cx: Context, st: Lowering }

/// A `match` arm lowered: the arm as written, its guard's value where it has one, and its body.
pub type Armed = { arm: CodeArm, guard: Option<Lowered>, body: Lowered }

/// A `handle` clause made: the label it keys on where it names one, and its closure.
pub type ClauseMade = { label: Option<Arg>, closure: Arg }

/// A member of a tail group: its context and its body.
pub type GroupMember = { cx: Context, body: Code }

/// The first state of a body whose leading slots hold `params`.
pub fn started(params: List<Var>) -> Lowering =
  {
    next: params.fold(0, |n: Int, p: Var| if p.id >= n { p.id + 1 } else { n }),
    env: range(0, params.len()).fold(Map::new(), |m: Map<Int, Arg>, i: Int|
      match params.at(i) { Some(p) -> m.insert(i, AVar(p)), None -> m }),
    insts: [],
    refused: None,
    lambdas: [],
    links: { generics: [], needs: [], called: [], passes: [] },
  }

/// `st` refused for the reason `why` the part `by` gives, unless it was refused already.
pub fn refuse(st: Lowering, by: Family, why: Bytes) -> Lowered =
  {
    st: match st.refused { Some(_) -> st, None -> { ..st, refused: Some({ by: by, why: why }) } },
    arg: AZero(RInt),
  }

/// A new variable of type `ty` held as `rep`.
pub fn fresh(st: Lowering, ty: Type, rep: Rep) -> { st: Lowering, var: Var } =
  { st: { ..st, next: st.next + 1 }, var: { id: st.next, ty: ty, rep: rep } }

/// `val` bound to a new variable of type `ty`, held as a value of that type is in a body.
pub fn bound(cx: Context, st: Lowering, ty: Type, val: Val, at: Span) -> Lowered =
  bound_as(st, ty, held_as(cx.setting, ty), val, at)

/// `val` bound to a new variable of type `ty` held as `rep`.
pub fn bound_as(st: Lowering, ty: Type, rep: Rep, val: Val, at: Span) -> Lowered = {
  let v = fresh(st, ty, rep);
  { st: emitted(v.st, Let({ var: v.var, val: val, at: at, unwind: [] })), arg: AVar(v.var) }
}

/// `val` done for what it does, its answer let go.
pub fn done(st: Lowering, val: Val, at: Span) -> Lowering =
  emitted(st, Do({ val: val, at: at, unwind: [] }))

pub fn emitted(st: Lowering, i: Inst) -> Lowering = { ..st, insts: st.insts.push(i) }

/// The name an observing lowering's note of a slot read stands under, of a slot a closure captures
/// where it is made, and of a frame whose slots are bound anew.
pub fn read_note() -> Bytes = b"#read"

pub fn capture_note() -> Bytes = b"#capture"

pub fn enter_note() -> Bytes = b"#enter"

/// `st`, where `cx` observes, noting that `slot` of `cx`'s frame is read at `at`: an operation over
/// the slot's number and the frame's place that reads no variable and does nothing, so the
/// ownership pass places every count as it would without it.
pub fn read_noted(cx: Context, st: Lowering, note: Bytes, slot: Int, at: Span) -> Lowering =
  if !cx.observing { st }
  else { with_note(st, note, [AInt(slot), AInt(cx.frame.start), AInt(cx.frame.end)], at) }

/// `st`, where `cx` observes, noting that `cx`'s frame is entered at `at` with every slot bound
/// anew: a known lambda's body run in place, or a step's pass.
pub fn frame_entered(cx: Context, st: Lowering, at: Span) -> Lowering =
  if !cx.observing { st }
  else { with_note(st, enter_note(), [AInt(cx.frame.start), AInt(cx.frame.end)], at) }

fn with_note(st: Lowering, note: Bytes, args: List<Arg>, at: Span) -> Lowering =
  done(
    st,
    Native({
      name: note,
      args: args,
      uses: { takes: args.map(|_: Arg| false), owned: false, fails: false, stops: false },
    }),
    at,
  )

/// A block of its own after `st`: its environment, no instructions yet.
pub fn opened(st: Lowering) -> Lowering = { ..st, insts: [] }

/// `outer`, whose block and environment go on, after a block of its own lowered to `inner`: the
/// variables, closures, links and refusal `inner` added.
pub fn continued(outer: Lowering, inner: Lowering) -> Lowering =
  {
    ..outer,
    next: inner.next,
    refused: match outer.refused { Some(r) -> Some(r), None -> inner.refused },
    lambdas: inner.lambdas,
    links: inner.links,
  }

/// The first state of a body lowered as a function of its own inside `st`'s: its variables numbered
/// from its parameters, `env` its slots, the root's closures and links carried on.
pub fn nested(st: Lowering, params: List<Var>, env: Map<Int, Arg>) -> Lowering =
  { ..started(params), env: env, refused: st.refused, lambdas: st.lambdas, links: st.links }

/// `outer` after a function of its own lowered to `inner`: `outer`'s variables, block and
/// environment, and the closures, links and refusal `inner` added.
pub fn unnested(outer: Lowering, inner: Lowering) -> Lowering =
  {
    ..outer,
    refused: match outer.refused { Some(r) -> Some(r), None -> inner.refused },
    lambdas: inner.lambdas,
    links: inner.links,
  }

/// `l` added as the body of the next closure the root makes, and its place among them.
pub fn with_lambda(st: Lowering, l: Lambda) -> { st: Lowering, nth: Int } =
  { st: { ..st, lambdas: st.lambdas.push(l) }, nth: st.lambdas.len() }

/// `st` noting that a specialisation would read `need` of a type variable.
pub fn noted(st: Lowering, need: Need) -> Lowering =
  if st.links.needs.contains(need) { st }
  else { { ..st, links: { ..st.links, needs: st.links.needs.push(need) } } }

/// The type the checker filed for the node written at `at`, where it filed one.
pub fn type_at(cx: Context, at: Span) -> Option<Type> =
  match cx.setting.typed.get(span_key(at)) {
    Some(t) -> if t.ty == unknown_type() { None } else { Some(t.ty) },
    None -> None,
  }

/// The type an operand holds.
pub fn type_of(a: Arg) -> Type =
  match a {
    AVar(v) -> v.ty,
    AInt(_) -> named_type(b"Int"),
    ABool(_) -> named_type(b"Bool"),
    AFloat(_) -> named_type(b"Float"),
    ANum(n) ->
      named_type(
        Bytes::concat_all([if n.width.signed { b"I" } else { b"U" }, digits(n.width.bits)]),
      ),
    AChar(_) -> named_type(b"Char"),
    AZero(_) -> unknown_type(),
  }

fn digits(n: Int) -> Bytes =
  if n == 8 { b"8" }
  else if n == 16 { b"16" }
  else if n == 32 { b"32" }
  else if n == 64 { b"64" }
  else { b"128" }

/// `l`'s value held as `to`: an integer constant written as the width it is handed as, a zero of a
/// representation holding no count as `to`'s where `to` holds none either (the zero of each is the
/// number zero), a value just made by holding one held as `to` otherwise and named by no slot as
/// that one, and anything else packed, a sum's zero among them (an `Option`'s is `None`).
pub fn handed(l: Lowered, to: Rep, at: Span) -> Lowered =
  if rep_of_arg(l.arg) == to { l } else {
    let packed = bound_as(l.st, type_of(l.arg), to, Pack({ arg: l.arg, to: to }), at);
    match l.arg {
      AInt(n) -> match to {
        RNum(w) -> { st: l.st, arg: ANum({ width: w, bits: n }) },
        _ -> packed,
      },
      AZero(r) -> if !counted(r) && !counted(to) { { st: l.st, arg: AZero(to) } } else { packed },
      AVar(v) -> match unpacked(l.st, v, to) { Some(back) -> back, None -> packed },
      _ -> packed,
    }
  }

/// `l`'s value at `t`, the type the checker gave it, where `l` holds a variable whose type leaves
/// part of it unsaid and `t` says all of it: a lambda another root lent, run in place where its
/// arguments and captures arrive as a type variable's words or a specialisation's erased ones, reads
/// them at the types it was written for. The variable itself where `t` is held as it is, a word
/// opened where it is held otherwise; `l` as it is for anything else.
pub fn taken_as(cx: Context, l: Lowered, t: Type, at: Span) -> Lowered =
  match l.arg {
    AVar(v) -> if !unsaid(v.ty) || unsaid(t) { l } else {
      let rep = held_as(cx.setting, t);
      if rep == v.rep { { st: l.st, arg: AVar({ ..v, ty: t }) } }
      else if v.rep == RWord { bound_as(l.st, t, rep, Pack({ arg: l.arg, to: rep }), at) }
      else { l }
    },
    _ -> l,
  }

/// Whether `t` leaves part of a value's type unsaid: a type variable, or a word a specialisation
/// erased to `_`, which says nothing more of it.
pub fn unsaid(t: Type) -> Bool =
  match t {
    TyVar(_) -> true,
    TyCon(c) -> c.name == b"_" || c.args.any(unsaid),
    TyFn(f) -> f.params.push(f.ret).any(unsaid),
    TyRecord(fs) -> fs.any(|f: Field| unsaid(f.ty)),
    TyNominal(x) -> x.fields.any(|f: Field| unsaid(f.ty)),
  }

/// `st` without its last instruction, where that makes `v` by holding a variable held as `to`
/// otherwise and no slot names `v`, and that variable: `v` was made for one reader, which takes the
/// variable instead.
fn unpacked(st: Lowering, v: Var, to: Rep) -> Option<Lowered> =
  match st.insts.at(st.insts.len() - 1) {
    Some(Let(x)) -> match x.val {
      Pack(p) -> match p.arg {
        AVar(s) -> if x.var != v || s.rep != to
            || st.env.fold(false, |named: Bool, _: Int, a: Arg| named || a == AVar(v)) { None }
        else { Some({ st: { ..st, insts: st.insts.take(st.insts.len() - 1) }, arg: AVar(s) }) },
        _ -> None,
      },
      _ -> None,
    },
    _ -> None,
  }

/// Builtin `name`'s runtime helper called on `args`, each handed over as a word the helper takes,
/// its answer a word with a count of its own, held as a value of `ty` is.
pub fn through_runtime(
  cx: Context,
  st: Lowering,
  name: Bytes,
  args: List<Arg>,
  ty: Type,
  at: Span,
) -> Lowered / {abort.raise} = {
  let words = as_words(st, args, at);
  let answer = bound_as(
    words.st,
    ty,
    RWord,
    Native({
      name: builtin_helper(name).concat(b"_p"),
      args: words.args,
      uses: { takes: args.map(|_: Arg| true), owned: true, fails: true, stops: false },
    }),
    at,
  );
  handed(answer, held_as(cx.setting, ty), at)
}

/// `args` each handed over as a word.
pub fn as_words(st: Lowering, args: List<Arg>, at: Span) -> { st: Lowering, args: List<Arg> } =
  args.fold({ st: st, args: [] }, |acc: { st: Lowering, args: List<Arg> }, a: Arg| {
    let h = handed({ st: acc.st, arg: a }, RWord, at);
    { st: h.st, args: acc.args.push(h.arg) }
  })

/// The type a join of `arms` holds: the first arm's that falls through holding a variable, then the
/// first's that falls through, then the root's answer's.
pub fn join_type(cx: Context, arms: List<Lowered>) -> Type = {
  let live = arms.filter(|a: Lowered| falls_through(a.st.insts));
  match live.fold(None, |acc: Option<Type>, a: Lowered|
      match acc { Some(_) -> acc, None -> match a.arg { AVar(v) -> Some(v.ty), _ -> None } }) {
    Some(t) -> t,
    None -> match live.at(0) { Some(a) -> type_of(a.arg), None -> cx.answer_ty },
  }
}

/// An arm's block ending in its value set into join `j`, held as `j` is; an arm that leaves sets
/// nothing. `st` numbers what it adds.
pub fn set_join(st: Lowering, arm: Lowered, j: Var, at: Span) -> { st: Lowering, block: Block } =
  if !falls_through(arm.st.insts) { { st: st, block: arm.st.insts } } else {
    let h = handed({ st: { ..st, insts: arm.st.insts }, arg: arm.arg }, j.rep, at);
    { st: { ..h.st, insts: st.insts }, block: h.st.insts.push(Assign({ var: j, arg: h.arg })) }
  }

/// An `if` whose arms join in a variable of the type they answer.
pub fn joined(cx: Context, cond: Lowered, then: Lowered, otherwise: Lowered, at: Span) -> Lowered = {
  let ty = join_type(cx, [then, otherwise]);
  let j = fresh(continued(cond.st, otherwise.st), ty, held_as(cx.setting, ty));
  let t = set_join(j.st, then, j.var, at);
  let e = set_join(t.st, otherwise, j.var, at);
  {
    st: {
      ..e.st,
      insts: cond.st.insts.push(Decl(j.var)).push(
        If({ cond: cond.arg, then: t.block, otherwise: e.block }),
      ),
    },
    arg: AVar(j.var),
  }
}

/// `l && r` or `l || r`: a `Bool` joined from the right operand where the left one does not decide.
pub fn short_circuit(cx: Context, l: Lowered, r: Lowered, both: Bool, at: Span) -> Lowered = {
  let j = fresh(continued(l.st, r.st), named_type(b"Bool"), RBool);
  let right = set_join(j.st, r, j.var, at);
  let decided = [Assign({ var: j.var, arg: ABool(!both) })];
  {
    st: {
      ..right.st,
      insts: l.st.insts.push(Decl(j.var)).push(
        If({
          cond: l.arg,
          then: if both { right.block } else { decided },
          otherwise: if both { decided } else { right.block },
        }),
      ),
    },
    arg: AVar(j.var),
  }
}

test "a zero is handed as another representation's zero only where neither holds a count" {
  let st = started([]);
  let byte = RNum({ bits: 8, signed: false });
  assert_eq(handed({ st: st, arg: AZero(RInt) }, byte, dummy_span()).arg, AZero(byte));
  // `None` held as an `Option`'s word is no zero word: it is packed.
  assert_eq(
    match handed({ st: st, arg: AZero(RMaybe) }, RWord, dummy_span()).st.insts {
      [Let(x)] -> Some(x.val),
      _ -> None,
    },
    Some(Pack({ arg: AZero(RMaybe), to: RWord })),
  );
  assert_eq(handed({ st: st, arg: AZero(RWord) }, RInt, dummy_span()).st.insts.len(), 1)
}

test "a word just opened to its type and handed straight back as a word is the word itself" {
  let int = named_type(b"Int");
  let w = { id: 0, ty: int, rep: RWord };
  let opened = bound_as(started([w]), int, RInt, Pack({ arg: AVar(w), to: RInt }), dummy_span());
  let back = handed(opened, RWord, dummy_span());
  assert_eq(back.arg, AVar(w));
  assert_eq(back.st.insts, []);
  // A value a slot names may be read again, so it stays and is packed back.
  let named = { ..opened, st: { ..opened.st, env: opened.st.env.insert(1, opened.arg) } };
  assert_eq(handed(named, RWord, dummy_span()).st.insts.len(), 2);
  // Held back as another representation than the word it came from, it is packed.
  let byte = RNum({ bits: 8, signed: false });
  assert_eq(handed(opened, byte, dummy_span()).st.insts.len(), 2)
}
