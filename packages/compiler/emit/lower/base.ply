import compiler.emit.code
import compiler.emit.code (Code, CodeArm, Capture, NDefinition, NBuiltin, NConstructor)
import compiler.check.types (Type, VariableType, NamedType, FunctionType, RecordType, NominalType,
                             Field, FunctionSignature, Effects, named_type, int_type, bool_type,
                             float_type, decimal_type, unit_type)
import compiler.check.known (char_type, width_named)
import compiler.emit.typing (SiteType, unknown_type)
import compiler.syntax.parsing (Span, dummy_span)
import std.list (zip)
import compiler.emit.representations (EmitParam, word_type)
import compiler.emit.output (Need)
import compiler.emit.keys (RootKey, Evidence)
import compiler.emit.evidence (EffectsEvidence)
import compiler.emit.typed_ir (Representation, AsInt, AsBool, AsFixed, AsFloat, AsDecimal,
                               AsWideFixed, Variable, Arg, VariableOperand, IntOperand, BoolOperand,
                               FloatOperand, FixedOperand, CharOperand, ZeroOperand, Rvalue,
                               Convert, Native, Instruction, Let, Do, Declaration, Assign, If, Case,
                               Match, Miss, Loop, Next, Done, Return, Restart, Jump, Fail, Handle,
                               SiteScope, Increment, Decrement, Reset, Free, Destructure, Block,
                               Lambda, Links, AsWord, AsUnit, AsListView, Aggregate, Primitive,
                               OperandsOnly, operand_representation, falls_through, is_refcounted,
                               operands, parts_of, no_links, CleanupScope, Unwinding, LoopVariable)
import compiler.emit.lower.module_context (ModuleContext)
import compiler.emit.lower.representation (representation_of)
import compiler.emit.typed_ir.statics (StaticDefinition, StaticLayout, StaticWords, AddressWord,
                                       BytesWord, named_by_content)

pub type Context = {
  setting: ModuleContext,
  key: RootKey,
  full: Bytes,
  base: Int,
  params: List<EmitParam>,
  types: List<Type>,
  param_effects: List<Option<Effects>>,
  result: Representation,
  result_type: Type,
  body: Code,
  tails: TailCalls,
  parameter_positions: Map<Int, Int>,
  inlined_from: Option<{ owner: RootKey, written: List<code::Lambda> }>,
  owners: Map<Bytes, RootKey>,
  emits_notes: Bool,
  frame_span: Span,
  captured: List<Int>,
  allows_lambda_inlining: Bool,
  written: List<code::Lambda>,
  words: List<EvidenceWord>,
  effect_evidence: List<List<Evidence>>,
  labels: Int,
  label_names: List<Bytes>,
  label_values: List<Option<Arg>>,
  evidence_arguments: List<Arg>,
  instance: Option<HandlerInstance>,
  retained_arguments: List<Arg>,
  performs: Effects,
}

pub type HandlerInstance = { word: Arg, variable_count: Int }

pub type CapturedEvidence = {
  words: List<EvidenceWord>,
  instance: Option<HandlerInstance>,
  retained_values: List<Arg>,
}

pub fn no_captured_evidence() -> CapturedEvidence =
  { words: [], instance: None, retained_values: [] }

pub type EvidenceValues<a> = { words: List<a>, instance: Option<a>, retained_values: List<a> }

pub fn listed_evidence_values<a>(h: EvidenceValues<a>) -> List<a> =
  h.words.concat(match h.instance { Some(i) -> [i], None -> [] }).concat(h.retained_values)

pub fn evidence_values_of(h: CapturedEvidence) -> EvidenceValues<Arg> =
  {
    words: h.words.map(|w: EvidenceWord| w.word),
    instance: match h.instance { Some(i) -> Some(i.word), None -> None },
    retained_values: h.retained_values,
  }

pub fn substitute_evidence_variables(
  h: CapturedEvidence,
  variables: EvidenceValues<Variable>,
) -> CapturedEvidence =
  {
    words: zip(h.words, variables.words).map(|p: { first: EvidenceWord, second: Variable }|
      { ..p.first, word: VariableOperand(p.second) }),
    instance: match ((h.instance, variables.instance)) {
      (Some(i), Some(v)) -> Some({ ..i, word: VariableOperand(v) }),
      _ -> None,
    },
    retained_values: variables.retained_values.map(VariableOperand),
  }

pub type EvidenceWord = { evidence: Evidence, word: Arg, inherited: Bool, handled: Bool }

pub type TailCalls = | Restarts(List<Representation>) | Enters(List<RootKey>) | PlainCalls

pub type Lowering = {
  next: Int,
  env: Map<Int, Arg>,
  instructions: List<Instruction>,
  lambdas: List<Lambda>,
  statics: List<StaticDefinition>,
  links: Links,
  unwinding: List<Unwinding>,
  closures: Map<Int, Int>,
}

pub type LoweredValue = { st: Lowering, arg: Arg }

pub type Target =
  | ToConstructor(Bytes)
  | ToBuiltin(Bytes)
  | ToDefinition(Bytes)
  | ToValue
  | ToInlinedBody(InlinedBody)

pub type InlinedBody = | KnownLambda | IterateStep | WalkFunction(Walk)

pub type Walk = { kind: WalkKind, at: Int, over: List<Type>, accumulator: Type, ranged: Bool }

pub type WalkKind = | Folding | Mapping | Filtering | EntryFolding

pub type Frame = {
  params: Int,
  size: Int,
  captures: List<Capture>,
  resumes: Option<Effects>,
  body: Code,
  ty: FunctionSignature,
  words: List<EffectsEvidence>,
  captured_evidence: CapturedEvidence,
}

pub type Opened = { context: Context, st: Lowering }

pub type LoweredArm = { arm: CodeArm, guard: Option<LoweredValue>, body: LoweredValue }

pub type GroupMember = { context: Context, body: Code }

pub fn initial_lowering(params: List<Variable>) -> Lowering =
  {
    next: params.fold(0, |n: Int, p: Variable| if p.id >= n { p.id + 1 } else { n }),
    env: range(0, params.len()).fold(Map::new(), |m: Map<Int, Arg>, i: Int|
      match params.at(i) { Some(p) -> m.insert(i, VariableOperand(p)), None -> m }),
    instructions: [],
    lambdas: [],
    statics: [],
    links: no_links(),
    unwinding: [],
    closures: Map::new(),
  }

pub fn unreachable<a>(reason: Bytes) -> a / {abort.raise} =
  panic(
    String::of_bytes_lossy(
      b"internal compiler error, impossible in a checked program: ".concat(reason),
    ),
  )

pub fn fresh(st: Lowering, ty: Type, rep: Representation) -> { st: Lowering, var: Variable } =
  { st: { ..st, next: st.next + 1 }, var: { id: st.next, ty: ty, representation: rep } }

pub fn bound(context: Context, st: Lowering, ty: Type, value: Rvalue, at: Span) -> LoweredValue =
  bound_as(st, ty, representation_of(context.setting, ty), value, at)

pub fn bound_as(
  st: Lowering,
  ty: Type,
  rep: Representation,
  value: Rvalue,
  at: Span,
) -> LoweredValue = {
  let v = fresh(st, ty, rep);
  {
    st: emitted(v.st, Let({ var: v.var, value: value, at: at, unwind: [] })),
    arg: VariableOperand(v.var),
  }
}

pub fn deferred_to_specialisation(
  st: Lowering,
  ty: Type,
  rep: Representation,
  operands: List<{ arg: Arg, takes: Bool }>,
  at: Span,
) -> LoweredValue = bound_as(st, ty, rep, OperandsOnly(operands), at)

pub fn run_for_effect(st: Lowering, value: Rvalue, at: Span) -> Lowering =
  emitted(st, Do({ value: value, at: at, unwind: [] }))

pub fn emitted(st: Lowering, i: Instruction) -> Lowering =
  { ..st, instructions: st.instructions.push(i) }

pub fn read_note() -> Bytes = b"#read"

pub fn capture_note() -> Bytes = b"#capture"

pub fn enter_note() -> Bytes = b"#enter"

pub fn note_slot_read(
  context: Context,
  st: Lowering,
  note: Bytes,
  slot: Int,
  at: Span,
) -> Lowering =
  if !context.emits_notes { st }
  else { with_note(st, note, [IntOperand(slot), IntOperand(context.frame_span.site)], at) }

pub fn note_frame_entry(context: Context, st: Lowering, at: Span) -> Lowering =
  if !context.emits_notes { st }
  else { with_note(st, enter_note(), [IntOperand(context.frame_span.site)], at) }

fn with_note(st: Lowering, note: Bytes, args: List<Arg>, at: Span) -> Lowering =
  run_for_effect(
    st,
    Native({
      name: note,
      args: args,
      uses: { takes: args.map(|_: Arg| false), owned: false, fails: false, suspends: false },
    }),
    at,
  )

pub fn enter_block(st: Lowering) -> Lowering = { ..st, instructions: [] }

pub fn exit_block(outer: Lowering, inner: Lowering) -> Lowering =
  { ..outer, next: inner.next, lambdas: inner.lambdas, statics: inner.statics, links: inner.links }

pub fn enter_function(st: Lowering, params: List<Variable>, env: Map<Int, Arg>) -> Lowering =
  {
    ..initial_lowering(params),
    env: env,
    lambdas: st.lambdas,
    statics: st.statics,
    links: st.links,
  }

pub fn exit_function(outer: Lowering, inner: Lowering) -> Lowering =
  { ..outer, lambdas: inner.lambdas, statics: inner.statics, links: inner.links }

pub fn static_added(
  st: Lowering,
  laid: StaticLayout,
) -> { st: Lowering, name: Bytes } / {abort.raise} = {
  let d = named_by_content(laid);
  {
    st: if st.statics.any(|x: StaticDefinition| x.name == d.name) { st }
    else { { ..st, statics: st.statics.push(d) } },
    name: d.name,
  }
}

pub fn with_lambda(st: Lowering, l: Lambda) -> { st: Lowering, nth: Int } =
  { st: { ..st, lambdas: st.lambdas.push(l) }, nth: st.lambdas.len() }

pub fn with_need(st: Lowering, need: Need) -> Lowering =
  if st.links.needs.contains(need) { st }
  else { { ..st, links: { ..st.links, needs: st.links.needs.push(need) } } }

pub fn read_typed(c: Code) -> SiteType =
  {
    ty: c.ty,
    args: match c.node {
      NDefinition(d) -> d.args,
      NBuiltin(b) -> b.args,
      NConstructor(k) -> k.args,
      _ -> [],
    },
  }

pub fn typed_slot_read(
  context: Context,
  l: LoweredValue,
  name: Bytes,
  slot: Int,
  ty: Type,
  at: Span,
) -> LoweredValue =
  if !context.captured.contains(slot) && operand_representation(l.arg) != AsWord { l }
  else { retyped(context, l, ty, at) }

pub fn type_of(a: Arg) -> Type =
  match a {
    VariableOperand(v) -> v.ty,
    IntOperand(_) -> int_type(),
    BoolOperand(_) -> bool_type(),
    FloatOperand(_) -> float_type(),
    FixedOperand(n) -> width_type(n.width),
    CharOperand(_) -> char_type(),
    ZeroOperand(r) -> zero_type(r),
  }

fn zero_type(r: Representation) -> Type =
  match r {
    AsUnit -> unit_type(),
    AsInt -> int_type(),
    AsBool -> bool_type(),
    AsFloat -> float_type(),
    AsDecimal -> decimal_type(),
    AsFixed(w) -> width_type(w),
    AsWideFixed(w) -> width_type(w),
    _ -> unknown_type(),
  }

fn width_type(w: { bits: Int, signed: Bool }) -> Type =
  match width_named(w) { Some(n) -> named_type(n), None -> unknown_type() }

pub fn pair_words(
  st: Lowering,
  a: Arg,
  two: Representation,
  at: Span,
) -> { st: Lowering, lo: Arg, hi: Arg } = {
  let d = represented_as({ st: st, arg: a }, two, at);
  let lo = bound_as(
    d.st,
    int_type(),
    AsInt,
    Primitive({ operation: b"lo", on: two, args: [d.arg] }),
    at,
  );
  let hi = bound_as(
    lo.st,
    int_type(),
    AsInt,
    Primitive({ operation: b"hi", on: two, args: [d.arg] }),
    at,
  );
  { st: hi.st, lo: lo.arg, hi: hi.arg }
}

pub fn represented_as(l: LoweredValue, to: Representation, at: Span) -> LoweredValue =
  if operand_representation(l.arg) == to { l }
  else if to == AsListView && operand_representation(l.arg) == AsWord {
    bound_as(l.st, type_of(l.arg), AsListView, Aggregate({ parts: [l.arg, IntOperand(0)] }), at)
  } else {
    let packed = bound_as(l.st, type_of(l.arg), to, Convert({ arg: l.arg, to: to }), at);
    match l.arg {
      IntOperand(n) -> match to {
        AsFixed(w) -> { st: l.st, arg: FixedOperand({ width: w, bits: n }) },
        _ -> packed,
      },
      ZeroOperand(r) -> if !is_refcounted(r) && !is_refcounted(to) {
        { st: l.st, arg: ZeroOperand(to) }
      } else { packed },
      VariableOperand(v) -> match packed_from(l.st, v, to) {
        Some(s) -> { st: l.st, arg: VariableOperand(s) },
        None -> if is_refcounted(to) && counts_in(to) <= counts_in(v.representation)
            && !slot_named(l.st, v) { packed_after(l.st, v, to, at) }
        else { packed },
      },
      _ -> packed,
    }
  }

pub fn list_of_view(l: LoweredValue, at: Span) -> LoweredValue =
  if operand_representation(l.arg) == AsListView { represented_as(l, AsWord, at) } else { l }

fn counts_in(r: Representation) -> Int = parts_of(r).filter(is_refcounted).len()

fn slot_named(st: Lowering, v: Variable) -> Bool =
  st.env.fold(false, |named: Bool, _: Int, a: Arg| named || a == VariableOperand(v))

fn packed_after(st: Lowering, v: Variable, to: Representation, at: Span) -> LoweredValue = {
  let w = fresh(st, v.ty, to);
  let named = after_last_reference(st.instructions, v.id);
  let k = if named == 0 { st.instructions.len() } else { named };
  {
    st: {
      ..w.st,
      instructions: st.instructions.take(k).push(
        Let({
          var: w.var,
          value: Convert({ arg: VariableOperand(v), to: to }),
          at: at,
          unwind: [],
        }),
      ).concat(
        st.instructions.drop(k),
      ),
    },
    arg: VariableOperand(w.var),
  }
}

fn after_last_reference(b: Block, id: Int) -> Int =
  b.fold_right({ at: b.len(), found: false }, |i: Instruction, s: { at: Int, found: Bool }|
    if s.found { s } else if references(i, id) || (match i { SiteScope(_) -> true, _ -> false }) {
      { ..s, found: true }
    } else { { at: s.at - 1, found: false } }).at

fn references(i: Instruction, id: Int) -> Bool = references_variable(i, id, true)

fn references_variable(i: Instruction, id: Int, binding: Bool) -> Bool = {
  let within = |b: Block| b.any(|x: Instruction| references_variable(x, id, binding));
  match i {
    Let(l) ->
      (binding && l.var.id == id)
        || operands(l.value).any(|o: { arg: Arg, takes: Bool }| argument_references(o.arg, id)),
    Do(d) -> operands(d.value).any(|o: { arg: Arg, takes: Bool }| argument_references(o.arg, id)),
    Declaration(v) -> v.id == id,
    Assign(s) -> s.var.id == id || argument_references(s.arg, id),
    If(x) -> argument_references(x.cond, id) || within(x.then) || within(x.otherwise),
    Case(c) ->
      c.on.id == id || within(c.rest) || c.arms.any(|a: { when: Int, body: Block }| within(a.body)),
    Match(m) -> within(m.rest) || m.arms.any(within),
    Loop(l) ->
      l.result.id == id
        || l.state.any(|c: LoopVariable| c.var.id == id || argument_references(c.init, id))
        || within(l.body),
    Next(args) -> args.any(|a: Arg| argument_references(a, id)),
    Done(a) -> argument_references(a, id),
    Return(a) -> argument_references(a, id),
    Restart(args) -> args.any(|a: Arg| argument_references(a, id)),
    Jump(e) -> e.args.any(|a: Arg| argument_references(a, id)),
    Handle(h) ->
      h.result.id == id || h.args.any(|a: Arg| argument_references(a, id)) || within(h.body),
    Increment(n) -> n.var.id == id,
    Decrement(v) -> v.id == id,
    Reset(r) -> r.token.id == id || r.of.id == id,
    Free(f) -> f.of.id == id || argument_references(f.bytes, id),
    Destructure(o) -> o.of.id == id || o.words.any(|w: Variable| w.id == id),
    Fail(_) -> false,
    Miss -> false,
    SiteScope(_) -> false,
    CleanupScope(u) -> match u {
      Some(xs) -> xs.any(|x: Unwinding| argument_references(x.arg, id)),
      None -> false,
    },
  }
}

pub fn packed_from(st: Lowering, v: Variable, to: Representation) -> Option<Variable> = {
  let declared = |s: Variable| st.instructions.any(|i: Instruction| i == Declaration(s));
  st.instructions.fold(None, |found: Option<Variable>, i: Instruction|
    match i {
      Let(l) -> match l.value {
        Convert(p) -> match p.arg {
          VariableOperand(s) -> if l.var == v && s.representation == to && !declared(s) { Some(s) }
          else if s == v && l.var.representation == to && !declared(v) { Some(l.var) }
          else if l.var == v { None }
          else { found },
          _ -> if l.var == v { None } else { found },
        },
        _ -> if l.var == v { None } else { found },
      },
      _ -> found,
    })
}

pub fn drop_unread_conversions(b: Block) -> Block =
  unread_dropped_in(b, |id: Int| b.any(|i: Instruction| references_variable(i, id, false)))

fn unread_dropped_in(b: Block, read: (Int) -> Bool) -> Block =
  b.fold([], |accumulator: List<Instruction>, i: Instruction|
    match i {
      Let(l) -> match l.value {
        Convert(_) -> if read(l.var.id) { accumulator.push(i) } else { accumulator },
        _ -> accumulator.push(i),
      },
      If(x) ->
        accumulator.push(
          If({
            ..x,
            then: unread_dropped_in(x.then, read),
            otherwise: unread_dropped_in(x.otherwise, read),
          }),
        ),
      Case(c) ->
        accumulator.push(
          Case({
            ..c,
            arms: c.arms.map(|a: { when: Int, body: Block }|
              { when: a.when, body: unread_dropped_in(a.body, read) }),
            rest: unread_dropped_in(c.rest, read),
          }),
        ),
      Match(m) ->
        accumulator.push(
          Match({
            arms: m.arms.map(|a: Block| unread_dropped_in(a, read)),
            rest: unread_dropped_in(m.rest, read),
          }),
        ),
      Loop(l) -> accumulator.push(Loop({ ..l, body: unread_dropped_in(l.body, read) })),
      Handle(h) -> accumulator.push(Handle({ ..h, body: unread_dropped_in(h.body, read) })),
      _ -> accumulator.push(i),
    })

fn argument_references(a: Arg, id: Int) -> Bool =
  match a { VariableOperand(v) -> v.id == id, _ -> false }

pub fn retyped(context: Context, l: LoweredValue, t: Type, at: Span) -> LoweredValue =
  match l.arg {
    VariableOperand(v) -> {
      let refined = refined_type(v.ty, t);
      let rep = representation_of(context.setting, refined);
      if rep == v.representation {
        if refined == v.ty { l } else { { st: l.st, arg: VariableOperand({ ..v, ty: refined }) } }
      } else if refined == v.ty && v.representation != AsWord { l } else {
        let word = represented_as(l, AsWord, at);
        match word.arg {
          VariableOperand(w) -> if rep == AsWord {
            { st: word.st, arg: VariableOperand({ ..w, ty: refined }) }
          } else { bound_as(word.st, refined, rep, Convert({ arg: word.arg, to: rep }), at) },
          _ -> l,
        }
      }
    },
    _ -> l,
  }

fn refined_type(s: Type, t: Type) -> Type =
  if is_unknown_type(s) { if is_unknown_type(t) { s } else { type_variables_erased(t) } } else {
    match s {
      NamedType(c) -> match t {
        NamedType(d) -> if d.name != c.name || d.args.len() != c.args.len() { s }
        else { NamedType({ name: c.name, args: refined_types(c.args, d.args) }) },
        _ -> s,
      },
      RecordType(fs) -> match t { RecordType(gs) -> RecordType(refined_fields(fs, gs)), _ -> s },
      NominalType(x) -> match t {
        NominalType(y) -> if y.name != x.name { s }
        else { NominalType({ ..x, fields: refined_fields(x.fields, y.fields) }) },
        _ -> s,
      },
      FunctionType(f) -> match t {
        FunctionType(g) -> if g.params.len() != f.params.len() { s } else {
          FunctionType({
            ..f,
            params: refined_types(f.params, g.params),
            return_type: refined_type(f.return_type, g.return_type),
          })
        },
        _ -> s,
      },
      _ -> s,
    }
  }

fn refined_types(ss: List<Type>, ts: List<Type>) -> List<Type> =
  range(0, ss.len()).fold([], |accumulator: List<Type>, i: Int|
    match ss.at(i) {
      Some(x) -> accumulator.push(match ts.at(i) { Some(y) -> refined_type(x, y), None -> x }),
      None -> accumulator,
    })

fn refined_fields(fs: List<Field>, gs: List<Field>) -> List<Field> =
  fs.map(|f: Field|
    match gs.fold(None, |accumulator: Option<Type>, g: Field|
        if g.name == f.name { Some(g.ty) } else { accumulator }) {
      Some(gt) -> { name: f.name, ty: refined_type(f.ty, gt) },
      None -> f,
    })

fn is_unknown_type(t: Type) -> Bool = match t { VariableType(_) -> true, _ -> t == word_type() }

fn type_variables_erased(t: Type) -> Type =
  match t {
    VariableType(_) -> word_type(),
    NamedType(c) -> NamedType({ name: c.name, args: c.args.map(type_variables_erased) }),
    FunctionType(f) ->
      FunctionType({
        ..f,
        params: f.params.map(type_variables_erased),
        return_type: type_variables_erased(f.return_type),
      }),
    RecordType(fs) ->
      RecordType(fs.map(|f: Field| { name: f.name, ty: type_variables_erased(f.ty) })),
    NominalType(x) ->
      NominalType({
        ..x,
        args: x.args.map(type_variables_erased),
        fields: x.fields.map(|f: Field| { name: f.name, ty: type_variables_erased(f.ty) }),
      }),
  }

pub fn has_unknown_part(t: Type) -> Bool =
  match t {
    VariableType(_) -> true,
    NamedType(c) -> t == word_type() || c.args.any(has_unknown_part),
    FunctionType(f) -> f.params.push(f.return_type).any(has_unknown_part),
    RecordType(fs) -> fs.any(|f: Field| has_unknown_part(f.ty)),
    NominalType(x) -> x.fields.any(|f: Field| has_unknown_part(f.ty)),
  }

pub fn as_words(st: Lowering, args: List<Arg>, at: Span) -> { st: Lowering, args: List<Arg> } =
  args.fold({ st: st, args: [] }, |accumulator: { st: Lowering, args: List<Arg> }, a: Arg| {
    let h = represented_as({ st: accumulator.st, arg: a }, AsWord, at);
    { st: h.st, args: accumulator.args.push(h.arg) }
  })

pub fn join_type(context: Context, arms: List<LoweredValue>) -> Type = {
  let live = arms.filter(|a: LoweredValue| falls_through(a.st.instructions));
  match live.fold(None, |accumulator: Option<Type>, a: LoweredValue|
      match accumulator {
        Some(_) -> accumulator,
        None -> match a.arg { VariableOperand(v) -> Some(v.ty), _ -> None },
      }) {
    Some(t) -> t,
    None -> match live.at(0) { Some(a) -> type_of(a.arg), None -> context.result_type },
  }
}

pub fn set_join(
  st: Lowering,
  arm: LoweredValue,
  j: Variable,
  at: Span,
) -> { st: Lowering, block: Block } =
  if !falls_through(arm.st.instructions) { { st: st, block: arm.st.instructions } } else {
    let h = represented_as(
      { st: { ..st, instructions: arm.st.instructions }, arg: arm.arg },
      j.representation,
      at,
    );
    {
      st: { ..h.st, instructions: st.instructions },
      block: h.st.instructions.push(Assign({ var: j, arg: h.arg })),
    }
  }

pub fn join_representation(context: Context, ty: Type, tail: Bool) -> Representation =
  if tail { context.result } else { representation_of(context.setting, ty) }

pub fn joined(
  context: Context,
  cond: LoweredValue,
  then: LoweredValue,
  otherwise: LoweredValue,
  tail: Bool,
  at: Span,
) -> LoweredValue = {
  let ty = join_type(context, [then, otherwise]);
  let j = fresh(exit_block(cond.st, otherwise.st), ty, join_representation(context, ty, tail));
  let t = set_join(j.st, then, j.var, at);
  let e = set_join(t.st, otherwise, j.var, at);
  {
    st: {
      ..e.st,
      instructions: cond.st.instructions.push(Declaration(j.var)).push(
        If({ cond: cond.arg, then: t.block, otherwise: e.block }),
      ),
    },
    arg: VariableOperand(j.var),
  }
}

pub fn short_circuit(
  context: Context,
  l: LoweredValue,
  r: LoweredValue,
  both: Bool,
  at: Span,
) -> LoweredValue = {
  let j = fresh(exit_block(l.st, r.st), bool_type(), AsBool);
  let right = set_join(j.st, r, j.var, at);
  let decided = [Assign({ var: j.var, arg: BoolOperand(!both) })];
  {
    st: {
      ..right.st,
      instructions: l.st.instructions.push(Declaration(j.var)).push(
        If({
          cond: l.arg,
          then: if both { right.block } else { decided },
          otherwise: if both { decided } else { right.block },
        }),
      ),
    },
    arg: VariableOperand(j.var),
  }
}

test "a zero converts directly to another representation's zero, except when either representation may be a counted reference" {
  let st = initial_lowering([]);
  let byte = AsFixed({ bits: 8, signed: false });
  assert_eq(
    represented_as({ st: st, arg: ZeroOperand(AsInt) }, byte, dummy_span()).arg,
    ZeroOperand(byte),
  );
  assert_eq(
    match represented_as(
        { st: st, arg: ZeroOperand(AsUnit) },
        AsWord,
        dummy_span(),
      ).st.instructions {
      [Let(x)] -> Some({ value: x.value, ty: x.var.ty }),
      _ -> None,
    },
    Some({ value: Convert({ arg: ZeroOperand(AsUnit), to: AsWord }), ty: unit_type() }),
  );
  assert(
    represented_as({ st: st, arg: ZeroOperand(AsWord) }, AsInt, dummy_span()).st.instructions != [],
    None,
  )
}

test "converting a word to its typed form and straight back to a word returns the original word, and drops the unused conversion" {
  let int = int_type();
  let w = { id: 0, ty: int, representation: AsWord };
  let enter_block = bound_as(
    initial_lowering([w]),
    int,
    AsInt,
    Convert({ arg: VariableOperand(w), to: AsInt }),
    dummy_span(),
  );
  let back = represented_as(enter_block, AsWord, dummy_span());
  assert_eq(back.arg, VariableOperand(w));
  assert_eq(back.st.instructions, enter_block.st.instructions);
  assert_eq(drop_unread_conversions(back.st.instructions), []);
  let named = {
    ..enter_block,
    st: { ..enter_block.st, env: enter_block.st.env.insert(1, enter_block.arg) },
  };
  assert_eq(represented_as(named, AsWord, dummy_span()).arg, VariableOperand(w));
  let byte = AsFixed({ bits: 8, signed: false });
  assert(represented_as(enter_block, byte, dummy_span()).arg != VariableOperand(w), None)
}

test "a static data block is stored once however often it is added, after any block it points to, and a lambda's blocks go to the enclosing function" {
  let spelling = StaticWords([BytesWord(b"m.T")]);
  let child = static_added(initial_lowering([]), spelling);
  let parent = static_added(child.st, StaticWords([AddressWord({ name: child.name, tag: 0 })]));
  let again = static_added(parent.st, spelling);
  assert_eq(again.name, child.name);
  assert_eq(again.st.statics.map(|d: StaticDefinition| d.name), [child.name, parent.name]);
  let inner = static_added(
    enter_function(child.st, [], Map::new()),
    StaticWords([BytesWord(b"m.U")]),
  );
  assert_eq(exit_function(child.st, inner.st).statics.map(|d: StaticDefinition| d.name), [
    child.name,
    inner.name,
  ])
}
