//! Family C's tests through `emit.compare`: what `match`, a `let` pattern and a comparison with a
//! constructor lower to, read off the form of small programs; and a corpus of them lowered, checked
//! and printed.

import check.types (Type, TyCon, TyVar)
import syntax.parsing (Span, dummy_span)
import syntax.exprs (Expr, EBlock, SLet, expr_span)
import syntax.items (Item, IFn, parse)
import syntax.sites (numbered)
import emit.code (PxList, PxVar)
import emit.keys (Named)
import emit.tir (RInt, RBool, RNum, RWord, RMaybe, RFloat, RCases, RSlice, Var, AVar, AInt, ABool,
                 Val, Prim, Get, Pack, Gathered, Native, PArg, PLeaf, Inst, Let, Decl, Assign, If,
                 Case, Match, Miss, Fail, NoArm, NoLet, Return, Block, Test, TTag, TInt, TRange,
                 TLength, Rooted, Given, Owned, Family, Matching, Spine, Scalars, Data, Calling,
                 Handling, Containers, no_links)
import emit.lower.base (started)
import emit.lower.calling (context_of)
import emit.lower.matching (arm_opened)
import emit.compare (Program, program_of, formed, unbuilt)
import emit.print (printed_fn)
import emit.pieces (spelled)

fn ty(name: Bytes, args: List<Type>) -> Type = TyCon({ name: name, args: args })

fn int_var(id: Int) -> Var = { id: id, ty: ty(b"Int", []), rep: RInt }

fn bool_var(id: Int) -> Var = { id: id, ty: ty(b"Bool", []), rep: RBool }

fn maybe_int(id: Int) -> Var = { id: id, ty: ty(b"Option", [ty(b"Int", [])]), rep: RMaybe }

/// The body of root `m.<name>` of `src`'s form, or why it was not formed.
fn body_of(src: Bytes, name: Bytes) -> Result<Block, Bytes> / {abort.raise} =
  match program_of(src) {
    Err(why) -> Err(why),
    Ok(p) -> match formed(p, name) { Ok(f) -> Ok(f.body), Err(no) -> Err(no.why) },
  }

/// Where the node `pick` finds in the body of definition `name` of `src` stands, its site as the
/// check numbers it.
fn placed_in(src: Bytes, name: Bytes, pick: (Expr) -> Span) -> Span / {abort.raise} =
  parse(src).node.items.fold(dummy_span(), |acc: Span, item: Item|
    match numbered(item) {
      IFn(d) -> if d.name.name == name { pick(d.body) } else { acc },
      _ -> acc,
    })

/// The arms of the first `Match` of `body`.
fn arms_of(body: Block) -> List<Block> =
  body.fold([], |acc: List<Block>, i: Inst|
    match i { Match(m) -> if acc == [] { m.arms } else { acc }, _ -> acc })

/// Each `Case` an arm opens with: what it tests, and where its one arm is taken.
fn opening(arm: Block) -> Option<{ test: Test, when: Int, body: Block }> =
  match arm.at(0) {
    Some(Case(c)) -> match c.arms.at(0) {
      Some(a) -> Some({ test: c.test, when: a.when, body: a.body }),
      None -> None,
    },
    _ -> None,
  }

/// What `i` reads with `Get`, where it is a `Let` of one.
fn read_at(i: Inst) -> Option<{ of: Var, path: Bytes }> =
  match i {
    Let(l) -> match l.val {
      Get(g) -> match g.path {
        PArg(a) -> Some({ of: g.of, path: a.ctor }),
        _ -> Some({ of: g.of, path: b"" }),
      },
      _ -> None,
    },
    _ -> None,
  }

fn bind(v: Var, val: Val) -> Inst = Let({ var: v, val: val, at: dummy_span(), unwind: [] })

/// The first `Case` of `b`.
fn first_case(
  b: Block,
) -> Option<{ on: Var, test: Test, arms: List<{ when: Int, body: Block }>, rest: Block }> =
  b.fold(
    None,
    |acc: Option<{ on: Var, test: Test, arms: List<{ when: Int, body: Block }>, rest: Block }>, i: Inst|
      match acc { Some(_) -> acc, None -> match i { Case(c) -> Some(c), _ -> None } },
  )

/// Whether `run` stands in `lines` as consecutive lines.
fn holds_run(lines: List<Bytes>, run: List<Bytes>) -> Bool =
  range(0, lines.len()).any(|i: Int| lines.drop(i).take(run.len()) == run)

/// Root `m.<name>` of `src` printed by the form, checked or not.
fn printed_of(src: Bytes, name: Bytes) -> Result<Bytes, Bytes> / {abort.raise} =
  match program_of(src) {
    Err(why) -> Err(why),
    Ok(p) -> match formed(p, name) {
      Ok(f) -> Ok(spelled(printed_fn(f).pieces)),
      Err(no) -> Err(no.why),
    },
  }

test "integer literals and ranges are tested in a Case each, and an arm that does not hold misses to the next" {
  let n = int_var(0);
  let j = int_var(1);
  let tested = |t: Test, then: Block|
    Case({ on: n, test: t, arms: [{ when: 0, body: then }], rest: [Miss] });
  let src = b"fn digit(n: Int) -> Int = match n { 0 -> 10, 1..=9 -> n, _ -> 99 }\n";
  let matched = placed_in(src, b"digit", expr_span);
  assert_eq(matched.start == 26 && matched.end == 66, true);
  assert_eq(
    body_of(src, b"digit"),
    Ok([
      Decl(j),
      Match({
        arms: [
          [tested(TInt([0]), [Assign({ var: j, arg: AInt(10) })])],
          [tested(TRange({ lo: 1, hi: 9 }), [Assign({ var: j, arg: AVar(n) })])],
          [Assign({ var: j, arg: AInt(99) })],
        ],
        rest: [Fail({ why: NoArm, at: matched })],
      }),
      Return(AVar(j)),
    ]),
  )
}

test "a Bool and a width are tested as the integers their registers hold, and a constant subject as it lowers" {
  match body_of(b"fn flag(b: Bool) -> Int = match b { true -> 1, false -> 0 }\n", b"flag") {
    Err(why) -> assert_eq(why, b""),
    Ok(body) ->
      assert_eq(
        arms_of(body).map(|a: Block|
          opening(a).map(|o: { test: Test, when: Int, body: Block }| o.test)),
        [Some(TInt([1])), Some(TInt([0]))],
      ),
  };
  match body_of(
      b"fn small(n: U8) -> Int = match n { 255u8 -> 1, 0u8..=9u8 -> 2, _ -> 0 }\n",
      b"small",
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(body) -> {
      assert_eq(
        arms_of(body).map(|a: Block|
          opening(a).map(|o: { test: Test, when: Int, body: Block }| o.test)),
        [Some(TInt([255])), Some(TRange({ lo: 0, hi: 9 })), None],
      );
      assert_eq(
        match arms_of(body).at(0) { Some([Case(c)]) -> Some(c.on.rep), _ -> None },
        Some(RNum({ bits: 8, signed: false })),
      )
    },
  };
  // A subject the lowering knows is tested before any C runs: an `If` on the answer.
  match body_of(b"fn seven() -> Int = match 7 { 8 -> 1, 7 -> 2, _ -> 0 }\n", b"seven") {
    Err(why) -> assert_eq(why, b""),
    Ok(body) ->
      assert_eq(
        arms_of(body).map(|a: Block|
          match a.at(0) {
            Some(If(x)) -> Some({ cond: x.cond, otherwise: x.otherwise }),
            _ -> None,
          }),
        [
          Some({ cond: ABool(false), otherwise: [Miss] }),
          Some({ cond: ABool(true), otherwise: [Miss] }),
          None,
        ],
      ),
  }
}

test "a guard is tested under its arm's pattern and misses to the next arm where it does not hold" {
  let n = int_var(0);
  let even = bool_var(1);
  let j = int_var(2);
  match body_of(
      b"fn guarded(n: Int, even: Bool) -> Int = match n { 0..=9 if even -> 1, _ -> 0 }\n",
      b"guarded",
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(body) ->
      assert_eq(arms_of(body), [
        [
          Case({
            on: n,
            test: TRange({ lo: 0, hi: 9 }),
            arms: [
              {
                when: 0,
                body: [
                  If({
                    cond: AVar(even),
                    then: [Assign({ var: j, arg: AInt(1) })],
                    otherwise: [Miss],
                  }),
                ],
              },
            ],
            rest: [Miss],
          }),
        ],
        [Assign({ var: j, arg: AInt(0) })],
      ]),
  };
  // Each alternative of an or-pattern is an arm of its own.
  match body_of(b"fn either(n: Int) -> Int = match n { 1 | 2 -> 1, _ -> 0 }\n", b"either") {
    Err(why) -> assert_eq(why, b""),
    Ok(body) ->
      assert_eq(
        arms_of(body).map(|a: Block|
          opening(a).map(|o: { test: Test, when: Int, body: Block }| o.test)),
        [Some(TInt([1])), Some(TInt([2])), None],
      ),
  }
}

test "a constructor's test names its place among its sum's constructors, and its arguments are read where it held" {
  let src = Bytes::concat_all([
    b"type Shape = | Circle(Float) | Rect(Int, Int) | Dot\n",
    b"fn area(s: Shape) -> Int = match s { Circle(_) -> 1, Rect(w, h) -> w * h, Dot -> 0 }\n",
  ]);
  match body_of(src, b"area") {
    Err(why) -> assert_eq(why, b""),
    Ok(body) -> {
      let opened = arms_of(body).map(opening);
      let names = [b"m.Circle", b"m.Rect", b"m.Dot"];
      assert_eq(
        opened.map(|o: Option<{ test: Test, when: Int, body: Block }>|
          match o { Some(x) -> Some({ test: x.test, when: x.when }), None -> None }),
        [
          Some({ test: TTag(names), when: 0 }),
          Some({ test: TTag(names), when: 1 }),
          Some({ test: TTag(names), when: 2 }),
        ],
      );
      // `Circle(_)` reads nothing; `Rect(w, h)` reads both arguments of the subject it tested.
      assert_eq(
        opened.map(|o: Option<{ test: Test, when: Int, body: Block }>|
          match o {
            Some(x) ->
              x.body.map(read_at).filter(|r: Option<{ of: Var, path: Bytes }>| r != None).len(),
            None -> 0 - 1,
          }),
        [0, 2, 0],
      );
      let reads = match opened.at(1) { Some(Some(x)) -> x.body.take(2).map(read_at), _ -> [] };
      assert_eq(
        reads.map(|r: Option<{ of: Var, path: Bytes }>|
          match r { Some(x) -> Some({ of: x.of.id, rep: x.of.rep, path: x.path }), None -> None }),
        [
          Some({ of: 0, rep: RWord, path: b"m.Rect" }),
          Some({ of: 0, rep: RWord, path: b"m.Rect" }),
        ],
      )
    },
  }
}

test "a constructor's arguments are read at its subject's type arguments, a generic body's own variables among them" {
  // `Option`'s and `Pair`'s variables are numbered as the bodies' own are, which `p` holds crossed.
  let src = Bytes::concat_all([
    b"type Pair<a, b> = | Both(a, b) | Neither\n",
    b"fn unwrapped<a>(o: Option<a>, d: a) -> a = match o { Some(x) -> x, None -> d }\n",
    b"fn first<a, b>(p: Pair<b, a>, d: b) -> b = match p { Both(x, _) -> x, Neither -> d }\n",
  ]);
  let read = |name: Bytes|
    match body_of(src, name) {
      Err(why) -> [Err(why)],
      Ok(body) ->
        arms_of(body).map(|a: Block|
          match opening(a) {
            Some(o) -> match o.body.at(0) { Some(Let(l)) -> Ok(l.var.ty), _ -> Err(b"") },
            None -> Err(b""),
          }),
    };
  assert_eq(read(b"unwrapped"), [Ok(TyVar(0)), Err(b"")]);
  assert_eq(read(b"first"), [Ok(TyVar(1)), Err(b"")])
}

test "an Option's constructors are tested on the word it is held as, its payload read where Some held" {
  let o = maybe_int(0);
  let x = int_var(1);
  let j = int_var(2);
  let some = |body: Block|
    Case({ on: o, test: TTag([b"None", b"Some"]), arms: [{ when: 1, body: body }], rest: [Miss] });
  let none = |body: Block|
    Case({ on: o, test: TTag([b"None", b"Some"]), arms: [{ when: 0, body: body }], rest: [Miss] });
  let src = b"fn payload(o: Option<Int>) -> Int = match o { Some(n) -> n, None -> 0 }\n";
  match body_of(src, b"payload") {
    Err(why) -> assert_eq(why, b""),
    Ok(body) ->
      assert_eq(arms_of(body), [
        [
          some([
            bind(x, Get({ of: o, path: PArg({ ctor: b"Some", at: 0 }) })),
            Assign({ var: j, arg: AVar(x) }),
          ]),
        ],
        [none([Assign({ var: j, arg: AInt(0) })])],
      ]),
  };
  match printed_of(src, b"payload") {
    Err(why) -> assert_eq(why, b""),
    Ok(text) -> {
      assert(text.index_of(b"  if ((p0) != 0) {\n") != None);
      assert(text.index_of(b"  if ((p0) == 0) {\n") != None)
    },
  }
}

test "a Result held as a tagged word tests its tag, and a constructor inside it is tested where it lies" {
  let src = Bytes::concat_all([
    b"type Tone = | Warm | Cool\n",
    b"fn settled(r: Result<Int, Tone>) -> Int = match r { Ok(n) -> n, Err(Warm) -> 1, Err(Cool) -> 2 }\n",
  ]);
  match body_of(src, b"settled") {
    Err(why) -> assert_eq(why, b""),
    Ok(body) -> {
      let arms = arms_of(body);
      assert_eq(
        arms.map(|a: Block| opening(a).map(|o: { test: Test, when: Int, body: Block }| o.when)),
        [Some(0), Some(1), Some(1)],
      );
      // The tone is read as the payload's word, which is its object, and tested there only under
      // the test that the result is an `Err`.
      assert_eq(
        match opening(arms.get(1)) {
          Some(e) -> match first_case(e.body) {
            Some(c) ->
              Some({
                test: c.test,
                when: c.arms.map(|a: { when: Int, body: Block }| a.when),
                on: c.on.rep,
              }),
            None -> None,
          },
          None -> None,
        },
        Some({ test: TTag([b"m.Warm", b"m.Cool"]), when: [0], on: RWord }),
      )
    },
  };
  match printed_of(src, b"settled") {
    Err(why) -> assert_eq(why, b""),
    Ok(text) -> {
      assert(text.index_of(b"  if (((p0) & 7) != 4) {\n") != None);
      assert(text.index_of(b"  if (((p0) & 7) == 4) {\n") != None);
      assert(text.index_of(b")->layout == @@Tm.Cool@@) {\n") != None)
    },
  }
}

test "a sum held as its cases is tested by its constructor's index" {
  let src = Bytes::concat_all([
    b"type Tone = | Warm | Cool\n",
    b"fn chosen(c: Bool) -> Int = { let t = if c { Warm } else { Cool }; match t { Warm -> 1, Cool -> 2 } }\n",
    b"fn inner(o: Option<{ a: Int, b: Int }>) -> Int = match o { Some({ a, b }) -> a + b, None -> 0 }\n",
  ]);
  match body_of(src, b"chosen") {
    Err(why) -> assert_eq(why, b""),
    Ok(body) ->
      assert_eq(
        arms_of(body).map(|a: Block|
          match a.at(0) {
            Some(Case(c)) ->
              Some({ test: c.test, cased: match c.on.rep { RCases(_) -> true, _ -> false } }),
            _ -> None,
          }),
        [
          Some({ test: TTag([b"m.Warm", b"m.Cool"]), cased: true }),
          Some({ test: TTag([b"m.Warm", b"m.Cool"]), cased: true }),
        ],
      ),
  };
  // An index alone is the value's one C value; beside its cases' leaves it is the first of them.
  assert_eq(
    [
      { name: b"chosen", seen: b") == INT64_C(1)) {\n" },
      { name: b"inner", seen: b"  if ((p0_0) == INT64_C(1)) {\n" },
    ].map(|x: { name: Bytes, seen: Bytes }|
      match printed_of(src, x.name) { Ok(t) -> t.index_of(x.seen) != None, Err(_) -> false }),
    [true, true],
  )
}

test "a list pattern tests the list's length, then reads each item it tests or binds" {
  let xs = { id: 0, ty: ty(b"List", [ty(b"Int", [])]), rep: RWord };
  let src = b"fn leading(xs: List<Int>) -> Int = match xs { [] -> 0, [x] -> x, [x, _, ..] -> x }\n";
  match body_of(src, b"leading") {
    Err(why) -> assert_eq(why, b""),
    Ok(body) -> {
      let opened = arms_of(body).map(opening);
      assert_eq(
        opened.map(|o: Option<{ test: Test, when: Int, body: Block }>|
          match o { Some(x) -> Some({ test: x.test, when: x.when }), None -> None }),
        [
          Some({ test: TLength({ at_least: 1 }), when: 0 }),
          Some({ test: TLength({ at_least: 2 }), when: 1 }),
          Some({ test: TLength({ at_least: 2 }), when: 2 }),
        ],
      );
      // The item is read as a word with a count of its own, then held as an `Int` is.
      let item = { id: 1, ty: ty(b"Int", []), rep: RWord };
      assert_eq(match opened.at(1) { Some(Some(x)) -> x.body.take(2), _ -> [] }, [
        bind(
          item,
          Native({
            name: b"rt_list_at_p",
            args: [AVar(xs), AInt(0)],
            uses: { takes: [false, false], owned: true, fails: true, stops: false },
          }),
        ),
        bind(int_var(2), Pack({ arg: AVar(item), to: RInt })),
      ])
    },
  };
  match printed_of(src, b"leading") {
    Err(why) -> assert_eq(why, b""),
    Ok(text) -> {
      assert(text.index_of(b"  if ((int64_t)ply_obj(p0)->len == INT64_C(0)) {\n") != None);
      assert(text.index_of(b"  if ((int64_t)ply_obj(p0)->len >= INT64_C(2)) {\n") != None)
    },
  }
}

test "a record or tuple pattern tests nothing and reads the fields it binds" {
  match body_of(b"fn pair(p: (Int, Int)) -> Int = { let (a, b) = p; a * b }\n", b"pair") {
    Err(why) -> assert_eq(why, b""),
    Ok(body) -> {
      assert_eq(
        body.filter(|i: Inst|
          match i { Case(_) -> true, If(_) -> true, Match(_) -> true, _ -> false }),
        [],
      );
      assert_eq(
        body.take(2).map(|i: Inst| match read_at(i) { Some(r) -> r.of.id, None -> 0 - 1 }),
        [0, 0],
      )
    },
  };
  match body_of(
      b"fn total(p: { a: Int, b: Int }) -> Int = match p { { a, b } -> a + b }\n",
      b"total",
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(body) ->
      assert_eq(arms_of(body).map(|a: Block| a.take(2).map(|i: Inst| read_at(i) != None)), [
        [true, true],
      ]),
  }
}

test "a refutable let tests its pattern and fails the let where it does not hold" {
  let o = maybe_int(0);
  let n = int_var(1);
  let src = b"fn unwrap(o: Option<Int>) -> Int / {abort.raise} = { let Some(n) = o; n }\n";
  let bound = placed_in(src, b"unwrap", |e: Expr|
    match e {
      EBlock(b) -> match b.stmts.at(0) { Some(SLet(l)) -> l.span, _ -> dummy_span() },
      _ -> dummy_span(),
    });
  // The `let` is written from byte 53 to byte 69, its `;` included.
  assert_eq(bound.start == 53 && bound.end == 69, true);
  assert_eq(
    body_of(src, b"unwrap"),
    Ok([
      Case({
        on: o,
        test: TTag([b"None", b"Some"]),
        arms: [{ when: 1, body: [] }],
        rest: [Fail({ why: NoLet, at: bound })],
      }),
      bind(n, Get({ of: o, path: PArg({ ctor: b"Some", at: 0 }) })),
      Return(AVar(n)),
    ]),
  )
}

test "a value compared with a constructor of its sum is a Bool joined from the constructor's test" {
  let o = maybe_int(0);
  let r = bool_var(1);
  let set = |b: Bool| [Assign({ var: r, arg: ABool(b) })];
  assert_eq(
    body_of(b"fn unset(o: Option<Int>) -> Bool = o == None\n", b"unset"),
    Ok([
      Decl(r),
      Case({
        on: o,
        test: TTag([b"None", b"Some"]),
        arms: [{ when: 0, body: set(true) }],
        rest: set(false),
      }),
      Return(AVar(r)),
    ]),
  );
  // An argument is tested as its pattern would be, where the constructor held.
  let n = int_var(2);
  assert_eq(
    body_of(b"fn not_three(o: Option<Int>) -> Bool = o != Some(3)\n", b"not_three"),
    Ok([
      Decl(r),
      Case({
        on: o,
        test: TTag([b"None", b"Some"]),
        arms: [
          {
            when: 1,
            body: [
              bind(n, Get({ of: o, path: PArg({ ctor: b"Some", at: 0 }) })),
              Case({
                on: n,
                test: TInt([3]),
                arms: [{ when: 0, body: set(false) }],
                rest: set(true),
              }),
            ],
          },
        ],
        rest: set(true),
      }),
      Return(AVar(r)),
    ]),
  );
  // A constructor inside one is tested as its pattern would be, under the test that reads it.
  let nested = Bytes::concat_all([
    b"type Spec = | Zeroed | Tagged\n",
    b"type Kind = | Plain | Sum(Spec)\n",
    b"fn zeroed(k: Kind) -> Bool = k == Sum(Zeroed)\n",
  ]);
  match body_of(nested, b"zeroed") {
    Err(why) -> assert_eq(why, b""),
    Ok(body) ->
      assert_eq(
        match body.at(1) {
          Some(Case(c)) -> match c.arms.at(0) {
            Some(a) -> match first_case(a.body) {
              Some(inner) ->
                Some({
                  outer: { test: c.test, when: a.when, rest: c.rest },
                  inner: {
                    test: inner.test,
                    when: inner.arms.map(|x: { when: Int, body: Block }| x.when),
                    rest: inner.rest,
                  },
                }),
              _ -> None,
            },
            None -> None,
          },
          _ -> None,
        },
        Some({
          outer: {
            test: TTag([b"m.Plain", b"m.Sum"]),
            when: 1,
            rest: [Assign({ var: bool_var(1), arg: ABool(false) })],
          },
          inner: {
            test: TTag([b"m.Zeroed", b"m.Tagged"]),
            when: [0],
            rest: [Assign({ var: bool_var(1), arg: ABool(false) })],
          },
        }),
      ),
  };
  // A variable's value is compared by its type's equality, with the constructor on either side.
  match body_of(b"fn holds_n(o: Option<Int>, n: Int) -> Bool = Some(n) == o\n", b"holds_n") {
    Err(why) -> assert_eq(why, b""),
    Ok(body) ->
      assert_eq(
        match body.at(1) {
          Some(Case(c)) -> match c.arms.at(0) {
            Some(a) ->
              a.body.map(|i: Inst|
                match i {
                  Let(l) -> match l.val {
                    Prim(p) -> Some(p.op),
                    Get(_) -> Some(b"get"),
                    _ -> None,
                  },
                  If(x) -> if x.otherwise
                      == [
                        Assign({
                          var: { id: 2, ty: ty(b"Bool", []), rep: RBool },
                          arg: ABool(false),
                        }),
                      ] { Some(b"if") }
                  else { None },
                  _ -> None,
                }),
            None -> [],
          },
          _ -> [],
        },
        [Some(b"get"), Some(b"eq"), Some(b"if")],
      ),
  }
}

test "a constructor's computed argument is lowered before the comparison and compared by its type's equality" {
  let src = Bytes::concat_all([
    b"fn owner_is(o: Option<Int>, r: { owner: Int, n: Int }) -> Bool = o == Some(r.owner)\n",
    b"fn not_negative_zero(x: Option<Float>) -> Bool = x != Some(-0.0)\n",
  ]);
  let ops = |body: Block|
    body.fold([], |acc: List<Bytes>, i: Inst|
      match i {
        Case(c) -> match c.arms.at(0) {
          Some(a) ->
            acc.concat(
              a.body.map(|x: Inst|
                match x {
                  Let(l) -> match l.val { Prim(p) -> p.op, Get(_) -> b"get", _ -> b"other" },
                  If(_) -> b"if",
                  _ -> b"other",
                }),
            ),
          None -> acc,
        },
        _ -> acc,
      });
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) ->
      assert_eq(
        [b"owner_is", b"not_negative_zero"].map(|n: Bytes|
          match formed(p, n) { Ok(f) -> ops(f.body), Err(no) -> [no.why] }),
        [[b"get", b"eq", b"if"], [b"get", b"eq", b"if"]],
      ),
  }
}

/// The constructors each `Case` of `b` tests a tag among, its arms' and branches' too.
fn tags_tested(b: Block) -> List<List<Bytes>> =
  b.fold([], |acc: List<List<Bytes>>, i: Inst|
    match i {
      Case(c) -> {
        let here = match c.test { TTag(names) -> acc.push(names), _ -> acc };
        c.arms.fold(here, |a: List<List<Bytes>>, arm: { when: Int, body: Block }|
          a.concat(tags_tested(arm.body))).concat(
          tags_tested(c.rest),
        )
      },
      If(x) -> acc.concat(tags_tested(x.then)).concat(tags_tested(x.otherwise)),
      Match(m) ->
        m.arms.fold(acc, |a: List<List<Bytes>>, arm: Block| a.concat(tags_tested(arm))).concat(
          tags_tested(m.rest),
        ),
      _ -> acc,
    })

test "a value of a type its module states a key for is compared with a constructor as its key is, never by its tag" {
  let src = Bytes::concat_all([
    b"type Rounded = | Rounded(Int)\n",
    b"key for Rounded by rounded\n",
    b"fn rounded(r: Rounded) -> Int = match r { Rounded(n) -> n / 10 }\n",
    b"fn same_rounded(r: Rounded, n: Int) -> Bool = r == Rounded(n)\n",
    b"fn other_rounded(r: Rounded) -> Bool = Rounded(12) != r\n",
    b"type Wrapped = | Wrapped(Rounded) | Bare\n",
    b"fn wraps(w: Wrapped, n: Int) -> Bool = w == Wrapped(Rounded(n))\n",
    b"type Length = | Metres(Int) | Millimetres(Int)\n",
    b"key for Length by millimetres\n",
    b"fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }\n",
    b"fn differ(n: Int) -> Bool = Metres(n) != Millimetres(n * 1000)\n",
  ]);
  let tagged = |name: Bytes|
    match body_of(src, name) { Err(why) -> [[why]], Ok(body) -> tags_tested(body) };
  assert_eq(tagged(b"same_rounded"), []);
  assert_eq(tagged(b"other_rounded"), []);
  // Two constructors of a keyed sum are equal where their keys are, whatever they were built with.
  assert_eq(tagged(b"differ"), []);
  // A sum that states no key is tested by its tag, and a keyed value inside it by its key.
  assert_eq(tagged(b"wraps"), [[b"m.Wrapped", b"m.Bare"]])
}

test "a list pattern over a view reads its items from the view's list at its offset and binds its rest as a view" {
  match program_of(b"fn walk(xs: List<Int>) -> Int = 0\n") {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match p.roots.at(0) {
      None -> assert(false),
      Some(root) -> match root.code {
        None -> assert(false),
        Some(code) -> {
          let list = ty(b"List", [ty(b"Int", [])]);
          let s = { id: 0, ty: list, rep: RSlice };
          let binder = |name: Bytes, slot: Int|
            PxVar({ name: name, slot: Some(slot), span: dummy_span() });
          let st = arm_opened(context_of(p.setting, root, code), started([s]), AVar(s), {
            pat: PxList({ items: [binder(b"x", 1)], rest: Some(binder(b"r", 2)) }),
            guard: None,
            body: code,
          });
          let l = { id: 1, ty: list, rep: RWord };
          let o = int_var(2);
          let w = { id: 3, ty: ty(b"Int", []), rep: RWord };
          let i = int_var(5);
          let r = { id: 6, ty: list, rep: RSlice };
          assert_eq(st.insts, [
            Case({
              on: s,
              test: TLength({ at_least: 1 }),
              arms: [{ when: 1, body: [] }],
              rest: [Miss],
            }),
            bind(l, Get({ of: s, path: PLeaf(0) })),
            bind(o, Get({ of: s, path: PLeaf(1) })),
            bind(
              w,
              Native({
                name: b"rt_list_at_p",
                args: [AVar(l), AVar(o)],
                uses: { takes: [false, false], owned: true, fails: true, stops: false },
              }),
            ),
            bind(int_var(4), Pack({ arg: AVar(w), to: RInt })),
            bind(i, Prim({ op: b"add", on: RInt, args: [AVar(o), AInt(1)] })),
            bind(r, Gathered({ parts: [AVar(l), AVar(i)] })),
          ]);
          assert_eq([st.env.get(1), st.env.get(2)], [Some(AVar(int_var(4))), Some(AVar(r))])
        },
      },
    },
  };
  // A view's length is its list's past its offset.
  let s = { id: 0, ty: ty(b"List", [ty(b"Int", [])]), rep: RSlice };
  let f = {
    key: Named(b"m.walk"),
    kind: Rooted,
    params: [s],
    conv: { params: [Given], reps: [RSlice], answer: RInt, answered: Owned },
    body: [
      Case({
        on: s,
        test: TLength({ at_least: 1 }),
        arms: [{ when: 1, body: [Return(AInt(1))] }],
        rest: [Return(AInt(0))],
      }),
    ],
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
  };
  assert(
    spelled(printed_fn(f).pieces).index_of(
        b"  if (((int64_t)ply_obj(p0_0)->len - p0_1) >= INT64_C(1)) {\n",
      )
      != None,
  )
}

test "a literal of any other type is tested by its type's equality" {
  match body_of(b"fn half(f: Float) -> Int = match f { 0.5 -> 1, _ -> 0 }\n", b"half") {
    Err(why) -> assert_eq(why, b""),
    Ok(body) ->
      assert_eq(
        match arms_of(body).at(0) {
          Some([Let(l), If(x)]) -> match l.val {
            Prim(p) ->
              Some({ op: p.op, on: p.on, tested: x.cond == AVar(l.var), otherwise: x.otherwise }),
            _ -> None,
          },
          _ -> None,
        },
        Some({ op: b"eq", on: RFloat, tested: true, otherwise: [Miss] }),
      ),
  };
  // A string's equality is its own family's: lowered as an `If` on what it answers, or declined by it.
  match program_of(b"fn word(s: String) -> Int = match s { \"one\" -> 1, _ -> 0 }\n") {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match formed(p, b"word") {
      Ok(f) ->
        assert(match arms_of(f.body).at(0) {
          Some(a) -> a.any(|i: Inst| match i { If(_) -> true, _ -> false }),
          None -> false,
        }),
      Err(no) -> assert_eq(no.by, Scalars),
    },
  }
}

test "a match prints its arms as tests that go to the next arm's label where they do not hold" {
  match printed_of(
      b"fn digit(n: Int) -> Int = match n { 0 -> 10, 1..=9 -> n, _ -> 99 }\n",
      b"digit",
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(text) ->
      assert(
        holds_run(text.split(b"\n"), [
          b"  int64_t t1;",
          b"  if ((p0) == INT64_C(0)) {",
          b"    t1 = INT64_C(10);",
          b"  } else {",
          b"    goto ply_m0_1;",
          b"  }",
          b"  goto ply_m0_end;",
          b"  ply_m0_1: ;",
          b"  if ((p0) >= INT64_C(1) && (p0) <= INT64_C(9)) {",
          b"    t1 = p0;",
          b"  } else {",
          b"    goto ply_m0_2;",
          b"  }",
          b"  goto ply_m0_end;",
          b"  ply_m0_2: ;",
          b"  t1 = INT64_C(99);",
          b"  goto ply_m0_end;",
          b"  ply_m0_3: ;",
          b"  PLY_SITE(ctx, @@r@@, 26, 66);",
          b"  rt_no_match_p(ctx); return 0;",
          b"  ply_m0_end: ;",
          b"  ctx->fuel += 1;",
          b"  return t1;",
        ]),
      ),
  };
  let area = b"type Shape = | Circle(Float) | Dot\nfn round(s: Shape) -> Bool = match s { Circle(_) -> true, Dot -> false }\n";
  match printed_of(area, b"round") {
    Err(why) -> assert_eq(why, b""),
    Ok(text) -> assert(text.index_of(b"  if (ply_obj(p0)->layout == @@Tm.Circle@@) {\n") != None),
  };
  match printed_of(b"fn small(n: U8) -> Int = match n { 255u8 -> 1, _ -> 0 }\n", b"small") {
    Err(why) -> assert_eq(why, b""),
    Ok(text) -> assert(text.index_of(b"  if ((p0) == ((uint8_t)INT64_C(255))) {\n") != None),
  };
  match printed_of(
      b"fn unwrap(o: Option<Int>) -> Int / {abort.raise} = { let Some(n) = o; n }\n",
      b"unwrap",
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(text) ->
      assert(
        text.index_of(
            b"  if ((p0) != 0) {\n  } else {\n    PLY_SITE(ctx, @@r@@, 53, 69);\n    rt_let_no_match_p(ctx); return 0;\n  }\n",
          )
          != None,
      ),
  }
}

/// A root of the corpus: its name, its definition, and the families other than this one that may
/// decline it, each for a construct of its own the root holds.
type Root = { name: Bytes, src: Bytes, others: List<Family> }

fn lowers(name: Bytes, src: Bytes) -> Root = { name: name, src: src, others: [] }

fn others(name: Bytes, src: Bytes, by: List<Family>) -> Root = { name: name, src: src, others: by }

/// The types and helpers the corpus's roots read.
fn corpus_types() -> Bytes =
  Bytes::concat_all([
    b"type Shape = | Circle(Float) | Rect(Int, Int) | Dot\n",
    b"type Tone = | Warm | Cool\n",
    b"type Tok = | TEof | TNum(Int) | TName(Bytes)\n",
    b"type Point = { x: Float, y: Float }\n",
    b"type Figure = | Ring(Point, Float) | Labelled(String, Point) | Tally(U64, I64) | Spot(Float) | Blank\n",
    b"type P = { x: Int, y: Int }\n",
    b"type Named = { name: String, weight: Float, at: P }\n",
    b"type Parsed = { rest: String, node: P }\n",
    b"type Track = | Mark(P) | Line(P, P) | Empty\n",
    b"type Coin = | Penny | Nickel | Dime | Quarter\n",
    b"type Plot = | Round(Int) | Square(Int) | Oblong(Int, Int)\n",
    b"type Reading = | Level(Int) | Estimate(Int) | Offline | Broken(String)\n",
    b"type Bad = { why: String, at: Int }\n",
    b"type Taken = { value: Int, at: Int }\n",
    b"type Side = | Left(Taken) | Right(Taken)\n",
    b"type Step = { value: Int, next: Int }\n",
    b"type Marked = { wide: Int, mark: Option<String> }\n",
    b"type Tagline = | Tag(Option<String>, Int) | Untagged\n",
    b"type Tree = | Con({ name: String, args: List<Tree> }) | Leaf\n",
    b"type Token = | Punct(String) | Num(Int, Float) | Eof\n",
    b"type Rounded = | Rounded(Int)\n",
    b"type Wrapper = | Holds(Rounded) | Nothing\n",
    b"type Ref = | Ref({ name: String, args: List<Int> }) | Anon\n",
    b"type Pr = | Pr(Bytes, Int)\n",
    b"type Stream = | Over | More(Bytes, () -> Stream)\n",
    b"type Wrapped = | Wrap({ name: String }) | Bare(Int)\n",
    b"fn bigger(p: P, q: P) -> P = if p.x > q.x { p } else { q }\n",
    b"fn step(n: Int) -> Step = { value: n, next: n + 1 }\n",
    b"fn stepped(n: Int) -> Result<Step, Int> = if n < 0 { Err(0 - n) } else { Ok(step(n)) }\n",
    b"fn halves(a: Int) -> (Int, Int) = (a / 2, a % 2)\n",
    b"fn even(i: Int) -> Option<Int> = if i % 2 == 0 { Some(i) } else { None }\n",
    b"fn len_of(s: String) -> Int = s.len()\n",
  ])

/// Fresh roots holding every `match`, `let` pattern and comparison with a constructor the lang
/// tests in `matches`, `records` and `tuples` use, a shape at a time.
fn corpus_roots() -> List<Root> =
  [
    // Literals, ranges, guards and or-patterns over scalars.
    lowers(b"digit", b"fn digit(n: Int) -> Int = match n { 0 -> 10, 1..=9 -> n, _ -> 99 }"),
    lowers(b"flag", b"fn flag(b: Bool) -> Int = match b { true -> 1, false -> 0 }"),
    lowers(b"unit_arm", b"fn unit_arm(u: Unit) -> Int = match u { () -> 1 }"),
    lowers(b"half", b"fn half(f: Float) -> Int = match f { 0.5 -> 1, -1.5 -> 2, _ -> 0 }"),
    lowers(b"price", b"fn price(d: Decimal) -> Int = match d { 1.50m -> 1, -0.25m -> 2, _ -> 0 }"),
    lowers(b"small", b"fn small(n: U8) -> Int = match n { 255u8 -> 1, 0u8..=9u8 -> 2, _ -> 0 }"),
    lowers(b"signed", b"fn signed(n: I8) -> Int = match n { -1i8 -> 1, 127i8 -> 2, _ -> 0 }"),
    lowers(
      b"high",
      b"fn high(n: U64) -> Int = match n { 0u64..=9u64 -> 1, 0x8000_0000_0000_0000u64..=0xFFFF_FFFF_FFFF_FFFFu64 -> 2, 0xFFFF_FFFF_FFFF_FFFFu64 -> 3, _ -> 0 }",
    ),
    lowers(
      b"low",
      b"fn low(n: I64) -> Int = match n { -10i64..=-1i64 -> 1, 9223372036854775807i64 -> 2, _ -> 0 }",
    ),
    lowers(
      b"huge",
      b"fn huge(n: U128) -> Int = match n { 1u128..=18446744073709551616u128 -> 1, _ -> 0 }",
    ),
    lowers(
      b"big",
      b"fn big(n: Int) -> Int = match n { 4611686018427387904 -> 1, -4611686018427387905 -> 2, 9223372036854775807 -> 3, _ -> 0 }",
    ),
    lowers(
      b"sign",
      b"fn sign(n: Int) -> Int = match n { -9223372036854775807..=-1 -> -1, 0 -> 0, _ -> 1 }",
    ),
    lowers(
      b"halved",
      b"fn halved(b: U8) -> Int = match b { 0u8..=127u8 -> 0, 128u8..=255u8 -> 1 }",
    ),
    lowers(
      b"cold",
      b"fn cold(t: I8) -> Bool = match t { -127i8..=-1i8 -> true, 0i8..=127i8 -> false, _ -> true }",
    ),
    lowers(
      b"port",
      b"fn port(p: U16) -> Int = match p { 0u16 -> 0, 1u16..=1023u16 -> 1, 1024u16..=49151u16 -> 2, _ -> 3 }",
    ),
    lowers(b"seven", b"fn seven() -> Int = match 7 { 8 -> 1, 7 -> 2, _ -> 0 }"),
    lowers(b"byte_x", b"fn byte_x() -> Int = match b'x' { b'x' -> 1, _ -> 0 }"),
    lowers(
      b"digit_of",
      b"fn digit_of(c: Int) -> Int = match c { b'0'..=b'9' -> c - b'0', _ -> -1 }",
    ),
    lowers(
      b"class_of",
      b"fn class_of(c: Int) -> Int = match c { b'\"' -> 0, b'-' | b'0'..=b'9' -> 1, b'a'..=b'z' | b'A'..=b'Z' | b'_' -> 2, b' ' | b'\\t' -> 3, _ -> 4 }",
    ),
    lowers(
      b"guarded",
      b"fn guarded(n: Int, even: Bool) -> Int = match n { 0..=9 if even -> 1, 0..=99 -> 2, _ -> 0 }",
    ),
    lowers(
      b"classify",
      b"fn classify(n: Int) -> Int = match n { x if x < 0 -> -1, 0 -> 0, x if x > 100 -> 2, _ -> 1 }",
    ),
    lowers(b"either", b"fn either(n: Int) -> Int = match n { 1 | 2 -> 1, _ -> 0 }"),
    lowers(
      b"digit_word",
      b"fn digit_word(n: Int) -> Int = match n { 0 | 1 | 2 -> 0, 3 | 4 | 5 | 6 -> 1, _ -> 2 }",
    ),
    lowers(b"word", b"fn word(s: String) -> Int = match s { \"one\" -> 1, \"\" -> 3, _ -> 0 }"),
    lowers(
      b"tag_of",
      b"fn tag_of(b: Bytes) -> Int = match b { b\"ab\" -> 1, b\"\\x00\" -> 2, b\"\" -> 3, _ -> 0 }",
    ),
    lowers(
      b"label",
      b"fn label(s: String) -> Int = match s { t if t == \"a\" -> 1, \"b\" -> 2, _ -> 3 }",
    ),
    others(
      b"sized",
      b"fn sized(s: String) -> Int = match s { _ if s.len() > 3 -> 1, \"ab\" -> 2, _ -> 3 }",
      [Containers],
    ),
    lowers(
      b"count_down",
      b"fn count_down(n: Int) -> Int / {abort.raise} = iterate(n, 100, |k: Int| match k { m if m <= 0 -> Stop(m), m -> Continue(m - 1) })",
    ),
    // Constructors of declared sums, their arguments as their declarations lay them out.
    lowers(
      b"area",
      b"fn area(s: Shape) -> Int = match s { Circle(_) -> 1, Rect(w, h) -> w * h, Dot -> 0 }",
    ),
    lowers(b"warm", b"fn warm(t: Tone) -> Bool = match t { Warm -> true, Cool -> false }"),
    lowers(
      b"code_of",
      b"fn code_of(t: Tok) -> Int = match t { TEof -> 0, TNum(n) -> n, TName(b) -> b.len() }",
    ),
    lowers(
      b"figured",
      b"fn figured(s: Figure) -> Float = match s { Ring(_, r) -> 3.0 * r * r, Labelled(_, p) -> p.x * p.y, Tally(_, _) -> 0.0, Spot(_) -> 0.0, Blank -> 0.0 }",
    ),
    lowers(
      b"centre",
      b"fn centre(s: Figure) -> Option<Point> = match s { Ring(p, _) -> Some(p), Labelled(_, p) -> Some(p), _ -> None }",
    ),
    lowers(
      b"unit_ring",
      b"fn unit_ring(s: Figure) -> Bool = match s { Ring(_, 1.0) -> true, _ -> false }",
    ),
    lowers(
      b"grown",
      b"fn grown(s: Figure, by: Float) -> Figure = match s { Ring(p, r) -> Ring({ ..p, x: p.x + by }, r + by), other -> other }",
    ),
    lowers(
      b"tallied",
      b"fn tallied() -> Int = match Tally(7u64, 5i64) { Tally(n, _) -> if n == 7u64 { 1 } else { 0 }, _ -> 0 }",
    ),
    lowers(
      b"first_of",
      b"fn first_of<a>(xs: List<a>) -> Option<a> = match xs { [x, ..] -> Some(x), [] -> None }",
    ),
    lowers(b"radius", b"fn radius(s: Plot) -> Int = match s { Round(r) -> r, _ -> 0 }"),
    others(
      b"tagged",
      b"fn tagged(t: Tagline) -> Int = match t { Tag(Some(s), _) -> s.len(), Tag(None, n) -> n, Untagged -> 0 }",
      [Containers],
    ),
    lowers(b"kids", b"fn kids(t: Tree) -> Int = match t { Con(c) -> c.args.len(), Leaf -> 0 }"),
    lowers(
      b"pulled",
      b"fn pulled(k: () -> Stream) -> Bytes = match k() { Over -> b\"\", More(b, _) -> b }",
    ),
    lowers(b"pr_len", b"fn pr_len(p: Pr) -> Int = match p { Pr(b, n) -> b.len() + n }"),
    lowers(
      b"name_of",
      b"fn name_of(x: Wrapped) -> String = match x { Wrap(r) -> r.name, Bare(_) -> \"\" }",
    ),
    lowers(b"rounded", b"fn rounded(r: Rounded) -> Int = match r { Rounded(n) -> n / 10 }"),
    lowers(
      b"sided",
      b"fn sided(side: Side) -> Side = match side { Left(n) -> Left({ ..n, at: 0 }), Right(n) -> Right({ ..n, at: 1 }) }",
    ),
    lowers(
      b"side_of",
      b"fn side_of(s: Plot) -> Int = match s { Round(n) | Square(n) -> n, Oblong(w, _) -> w }",
    ),
    lowers(
      b"small_coin",
      b"fn small_coin(c: Coin) -> Bool = match c { Penny | Nickel -> true, Dime | Quarter -> false }",
    ),
    // `Option` and `Result`, held as their words or as their cases.
    lowers(b"payload", b"fn payload(o: Option<Int>) -> Int = match o { Some(n) -> n, None -> 0 }"),
    lowers(
      b"few",
      b"fn few(o: Option<Int>) -> Int = match o { Some(1..=3) -> 1, Some(_) -> 2, None -> 3 }",
    ),
    lowers(
      b"settled",
      b"fn settled(r: Result<Int, Tone>) -> Int = match r { Ok(n) -> n, Err(Warm) -> 1, Err(Cool) -> 2 }",
    ),
    lowers(
      b"toned",
      b"fn toned(t: Result<Tone, Int>) -> Int = match t { Ok(Warm) -> 1, Ok(Cool) -> 2, Err(n) -> n }",
    ),
    lowers(
      b"inner",
      b"fn inner(o: Option<{ a: Int, b: Int }>) -> Int = match o { Some({ a, b }) -> a + b, None -> 0 }",
    ),
    lowers(
      b"settled_opt",
      b"fn settled_opt(r: Result<Option<Bool>, Tone>) -> Int = match r { Ok(Some(true)) -> 1, Ok(Some(false)) -> 2, Ok(None) -> 3, Err(Warm) -> 4, Err(Cool) -> 5 }",
    ),
    lowers(
      b"tone_opt",
      b"fn tone_opt(t: Option<Tone>) -> Int = match t { Some(Warm) -> 1, Some(Cool) -> 2, None -> 3 }",
    ),
    lowers(
      b"heat",
      b"fn heat(t: Option<Tone>, n: Int) -> Int = match t { Some(Warm) if n > 0 -> 0, Some(Warm) -> 1, Some(Cool) -> 2, _ -> 3 }",
    ),
    lowers(
      b"some_small",
      b"fn some_small(o: Option<Coin>) -> Bool = match o { Some(Penny | Nickel) -> true, _ -> false }",
    ),
    lowers(
      b"inner_opt",
      b"fn inner_opt(o: Option<{ a: Option<Int> }>) -> Int = match o { Some({ a: Some(n) }) -> n, _ -> 0 }",
    ),
    others(
      b"greeting",
      b"fn greeting(o: Option<String>) -> Int = match o { Some(s) if s == \"\" -> 0, Some(s) -> s.len(), None -> -1 }",
      [Containers],
    ),
    lowers(
      b"pick",
