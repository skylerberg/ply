    ),
    lowers(
      b"looked_any",
      b"fn looked_any(m: Map<Int, Int>) -> Int = match m.get(1) { None -> -1, _ -> 7 }",
    ),
    lowers(
      b"looked_two",
      b"fn looked_two(m: Map<Int, Int>) -> Int = match m.get(0) { Some(a) -> match m.get(1) { Some(b) -> a + b, None -> a }, None -> 0 }",
    ),
    lowers(
      b"ordered",
      b"fn ordered(a: Int, b: Int) -> Int = match compare(a, b) { Less -> -1, Equal -> 0, Greater -> 1 }",
    ),
    // Lists, their items and their rests.
    lowers(
      b"leading",
      b"fn leading(xs: List<Int>) -> Int = match xs { [] -> 0, [x] -> x, [x, y, ..] -> x + y }",
    ),
    lowers(
      b"rest_of",
      b"fn rest_of(xs: List<Int>) -> List<Int> = match xs { [_, ..rest] -> rest, _ -> xs }",
    ),
    lowers(
      b"leads",
      b"fn leads(xs: List<Int>) -> Int = match xs { [0..=9, ..] -> 1, [_, 10..=19] -> 2, _ -> 0 }",
    ),
    lowers(
      b"descent",
      b"fn descent(xs: List<Int>) -> Int = match xs { [x, y, ..rest] if x > y -> x + rest.len(), [x, ..] -> x, [] -> 0 }",
    ),
    lowers(
      b"leads_some",
      b"fn leads_some(xs: List<Option<Int>>) -> Int = match xs { [Some(1), ..] -> 1, _ -> 0 }",
    ),
    lowers(
      b"shape_opts",
      b"fn shape_opts(xs: List<Option<Int>>) -> Int = match xs { [] -> 0, [None, ..] -> 1, [Some(n)] -> n, [Some(_), _, ..rest] -> 10 + rest.len() }",
    ),
    lowers(
      b"head_or_tail",
      b"fn head_or_tail(xs: List<Int>) -> Int = match xs { [x] | [_, x] -> x, _ -> 0 }",
    ),
    lowers(
      b"first_on_axis",
      b"fn first_on_axis(ps: List<P>) -> Int = match ps { [{ x, y: 0 }, ..] -> x, _ -> -1 }",
    ),
    lowers(
      b"floats_at",
      b"fn floats_at(xs: List<Float>, i: Int) -> Float = match xs.at(i) { Some(x) -> x + 1.0, None -> 0.0 }",
    ),
    lowers(
      b"listed_at",
      b"fn listed_at(rs: List<Result<P, Named>>) -> Int = match rs.at(0) { Some(Ok({ x: 0, y })) -> y, Some(Ok({ x, .. })) -> x, Some(Err({ weight: 0.0, .. })) -> -1, Some(Err(_)) -> -2, None -> -3 }",
    ),
    lowers(
      b"as_arg",
      b"fn as_arg(names: List<String>, i: Int) -> Int = len_of(match names.at(i) { Some(x) -> x, None -> \"\" })",
    ),
    // Records and tuples taken apart.
    lowers(b"total", b"fn total(p: { a: Int, b: Int }) -> Int = match p { { a, b } -> a + b }"),
    lowers(b"swap", b"fn swap(p: (Int, Bool)) -> (Bool, Int) = match p { (n, flag) -> (flag, n) }"),
    lowers(
      b"paired",
      b"fn paired(p: (Option<Int>, Bool)) -> Int = match p { (Some(1), true) -> 1, _ -> 0 }",
    ),
    lowers(b"other", b"fn other(p: (Int, Int)) -> Int = match p { (x, 0) | (0, x) -> x, _ -> -1 }"),
    lowers(
      b"coin_pair",
      b"fn coin_pair(p: (Coin, Coin)) -> Int = match p { (Penny | Nickel, Dime | Quarter) -> 1, (Dime | Quarter, _) -> 2, _ -> 3 }",
    ),
    lowers(
      b"guarded_or",
      b"fn guarded_or(p: (Int, Int)) -> Int = match p { (x, 1) | (1, x) if x > 5 -> x, _ -> 0 }",
    ),
    lowers(
      b"both",
      b"fn both(a: Bool, b: Bool) -> Int = match ((a, b)) { (true, true) -> 1, (true, false) -> 2, (false, _) -> 3 }",
    ),
    lowers(
      b"nested_lit",
      b"fn nested_lit(p: (Option<String>, Unit)) -> Int = match p { (Some(\"x\"), ()) -> 1, (None, ()) -> 2, _ -> 0 }",
    ),
    lowers(
      b"lamp",
      b"fn lamp(p: { tone: Tone, on: Bool }) -> Int = match p { { tone: Warm, on: true } -> 1, { tone: Warm, on: false } -> 2, { tone: Cool, .. } -> 3 }",
    ),
    lowers(
      b"at_origin",
      b"fn at_origin(o: Option<P>) -> Bool = match o { Some({ x: 0, y: 0 }) -> true, _ -> false }",
    ),
    lowers(
      b"from_origin",
      b"fn from_origin(s: Track) -> Int = match s { Line({ x: 0, y: 0 }, { x, y }) -> x + y, Mark({ x: 0, y }) -> y, Line(_, _) -> -1, Mark(_) -> -2, Empty -> -3 }",
    ),
    lowers(
      b"seventh",
      b"fn seventh(r: Result<P, String>) -> Int = match r { Ok({ x: 7, y }) -> y, Ok(_) -> 0, Err(_) -> -1 }",
    ),
    lowers(
      b"on_axis",
      b"fn on_axis(p: P, q: P) -> Bool = match bigger(p, q) { { y: 0, .. } -> true, _ -> false }",
    ),
    lowers(
      b"heavy",
      b"fn heavy(n: Named) -> Int = match n { { name: \"none\", .. } -> 0, { weight: 0.0, name, .. } -> name.len(), { at: { x: 0, y: 0 }, .. } -> 1, { at: { x, .. }, .. } -> x }",
    ),
    lowers(
      b"told",
      b"fn told(r: Result<Parsed, Named>) -> String = match r { Ok({ node: { x: 1, .. }, rest }) -> rest, Ok({ rest, .. }) -> rest ++ \"!\", Err({ name, at: { x: 0, .. }, .. }) -> name, Err({ name, .. }) -> name ++ \"?\" }",
    ),
    lowers(
      b"deep",
      b"fn deep(o: Option<Result<P, Named>>) -> Int = match o { Some(Ok({ x, y })) -> x + y, Some(Err({ at: { x, .. }, .. })) -> 0 - x, None -> 0 }",
    ),
    lowers(
      b"grown_rec",
      b"fn grown_rec(g: { r: { lo: Int, hi: Int }, n: Int }) -> Int = match g { { r: { lo: l, hi: _ }, n: n } -> l * 10 + n }",
    ),
    lowers(
      b"taken",
      b"fn taken(n: Int) -> Int = match step(n) { { value, next } -> value + next }",
    ),
    lowers(b"ignored", b"fn ignored(n: Int) -> Int = match step(n) { { value, .. } -> value }"),
    lowers(
      b"nested_step",
      b"fn nested_step(n: Int) -> Int = match stepped(n) { Ok({ value, next }) -> value + next, Err(e) -> e }",
    ),
    lowers(
      b"mark_of",
      b"fn mark_of(m: Marked, n: Int) -> Int = match m.mark { Some(s) -> s.len() + n, None -> n }",
    ),
    lowers(
      b"noted",
      b"fn noted(n: { name: String, note: Option<String> }) -> String = match n.note { Some(x) -> x, None -> n.name }",
    ),
    lowers(
      b"entry_text",
      b"fn entry_text(e: { note: Option<String>, parsed: Result<Int, { why: String }> }) -> Int = { let note = match e.note { Some(n) -> n, None -> \"-\" }; let parsed = match e.parsed { Ok(n) -> n, Err(x) -> x.why.len() }; note.len() + parsed }",
    ),
    lowers(
      b"made_rec",
      b"fn made_rec(t: Tone) -> Int = { let made = match t { Warm -> { a: 1, b: 2 }, Cool -> { a: 3, b: 4 } }; made.a + made.b }",
    ),
    lowers(
      b"keyed",
      b"fn keyed(h: { table: List<Int>, key: Int }, c: Int) -> { table: List<Int>, key: Int } = match c { 0 -> h, 1 -> { table: [], key: 0 }, _ -> { ..h, key: c } }",
    ),
    // `let` patterns, refutable ones and `let .. else`.
    lowers(b"pair", b"fn pair(p: (Int, Int)) -> Int = { let (a, b) = p; a * b }"),
    lowers(b"field_a", b"fn field_a(p: { a: Int, b: Int }) -> Int = { let { a, .. } = p; a }"),
    lowers(b"halved_let", b"fn halved_let(n: Int) -> Int = { let (q, r) = halves(n); q * 10 + r }"),
    lowers(
      b"larger_sum",
      b"fn larger_sum(p: P, q: P) -> Int = { let { x, y } = bigger(p, q); x + y }",
    ),
    lowers(
      b"let_step",
      b"fn let_step(n: Int) -> Int = { let { value, next } = step(n); let { value: v, .. } = step(next); value + v }",
    ),
    lowers(b"let_tuple", b"fn let_tuple(n: Int) -> Int = { let (a, b) = (n, n + 1); a * b }"),
    lowers(
      b"let_nested",
      b"fn let_nested(n: Int) -> Int = { let { left: { value, .. }, right: (r, _) } = { left: step(n), right: (n, n) }; value + r }",
    ),
    lowers(
      b"buffered",
      b"fn buffered(s: { out: Bytes, n: Int }) -> Int = { let { out, n } = s; out.len() + n }",
    ),
    lowers(
      b"lit_let",
      b"fn lit_let(s: String) -> Int = { let { name, tags } = { name: s, tags: [s] }; name.len() + tags.len() }",
    ),
    lowers(
      b"parsed_x",
      b"fn parsed_x(r: Result<Parsed, Named>) -> Result<Int, Named> = { let { rest, node: { x, .. } } = r?; Ok(x + rest.len()) }",
    ),
    lowers(b"unwrap", b"fn unwrap(o: Option<Int>) -> Int / {abort.raise} = { let Some(n) = o; n }"),
    lowers(
      b"same_either",
      b"fn same_either(r: Result<Int, Int>) -> Int = { let Ok(v) | Err(v) = r; v }",
    ),
    lowers(b"level", b"fn level(r: Reading) -> Int = { let Level(n) = r else { -1 }; n * 2 }"),
    lowers(
      b"sum_both",
      b"fn sum_both(a: Option<Int>, b: Option<Int>) -> Int = { let Some(x) = a else { 0 }; let Some(y) = b else { x }; x + y }",
    ),
    lowers(
      b"head_plus",
      b"fn head_plus(xs: List<Int>) -> Int = { let [h, ..rest] = xs else { 0 }; h + rest.len() }",
    ),
    lowers(
      b"value_of",
      b"fn value_of(r: Reading) -> Int = { let Level(n) | Estimate(n) = r else { 0 }; n }",
    ),
    lowers(
      b"describe",
      b"fn describe(r: Reading) -> String = { let word = { let Broken(why) = r else { \"fine\" }; \"broken: \" ++ why }; word ++ \".\" }",
    ),
    lowers(
      b"parsed_opt",
      b"fn parsed_opt(o: Option<Int>) -> Result<Int, String> = { let Some(n) = o else { Err(\"missing\") }; Ok(n + 1) }",
    ),
    lowers(b"doubled", b"fn doubled(n: Int) -> Int = { let true = n > 10 else { 0 }; n * 2 }"),
    lowers(b"small_let", b"fn small_let(n: Int) -> Int = { let 0..=9 = n else { -1 }; n }"),
    lowers(
      b"found_r",
      b"fn found_r(r: Result<Option<Int>, String>) -> Result<Int, String> = { let Some(n) = r? else { Ok(-1) }; Ok(n) }",
    ),
    // Comparisons with a constructor.
    lowers(b"unset", b"fn unset(o: Option<Int>) -> Bool = o == None"),
    lowers(b"not_three", b"fn not_three(o: Option<Int>) -> Bool = o != Some(3)"),
    lowers(b"holds_n", b"fn holds_n(o: Option<Int>, n: Int) -> Bool = Some(n) == o"),
    lowers(b"is_warm", b"fn is_warm(t: Tone) -> Bool = t == Warm"),
    lowers(b"warm_err", b"fn warm_err(r: Result<Int, Tone>) -> Bool = r != Err(Warm)"),
    lowers(
      b"owner_is",
      b"fn owner_is(o: Option<Int>, r: { owner: Int, n: Int }) -> Bool = o == Some(r.owner)",
    ),
    lowers(
      b"not_negative_zero",
      b"fn not_negative_zero(x: Option<Float>) -> Bool = x != Some(-0.0)",
    ),
    lowers(
      b"found_at",
      b"fn found_at(xs: List<Int>, x: Int, at: Int) -> Bool = xs.at(at) == Some(x)",
    ),
    lowers(b"absent", b"fn absent(o: Option<Taken>) -> Bool = o == None"),
    lowers(
      b"evens",
      b"fn evens(i: Int) -> Int = if even(i) != None && even(i) == Some(i) { 1 } else { 0 }",
    ),
    lowers(b"is_punct", b"fn is_punct(t: Token, p: String) -> Bool = t == Punct(p)"),
    lowers(b"not_num", b"fn not_num(t: Token, n: Int) -> Bool = t != Num(n, 0.5)"),
    lowers(b"at_end", b"fn at_end(t: Token) -> Bool = t == Eof"),
    lowers(b"same_rounded", b"fn same_rounded(r: Rounded, n: Int) -> Bool = r == Rounded(n)"),
    lowers(
      b"is_ref",
      b"fn is_ref(x: Ref, n: String) -> Bool = x == Ref({ name: n, args: [1, 2] })",
    ),
    lowers(b"nested_var", b"fn nested_var(w: Wrapper, n: Int) -> Bool = w == Holds(Rounded(n))"),
    lowers(
      b"nested_computed",
      b"fn nested_computed(w: Wrapper, n: Int) -> Bool = w == Holds(Rounded(n + 1))",
    ),
  ]

fn corpus() -> Bytes =
  corpus_types().concat(Bytes::concat_all(corpus_roots().map(|r: Root| r.src.concat(b"\n"))))

test "every root of the corpus lowers, passes the check and prints" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> assert_eq(not_built(p, corpus_roots().map(|r: Root| r.name)), []),
  }
}

// A generic body is lowered before its callers settle its types: an `Option` of a variable is held as
// a word, and its payload read out of it a placeholder the specialisations lay out.
test "a payload read out of a sum a type variable leaves open passes the check, closures' too" {
  let src = Bytes::concat_all([
    b"fn get_or<a>(o: Option<a>, d: a) -> a = match o { Some(x) -> x, None -> d }\n",
    b"fn decoded<a>(r: Result<a, String>) -> Option<a> = match r { Ok(v) -> Some(v), Err(_) -> None }\n",
    b"fn flat<a, b>(cs: List<Option<a>>, of: (a) -> List<b>) -> List<b> = cs.fold([], |acc: List<b>, c: Option<a>| match c { None -> acc, Some(x) -> of(x).fold(acc, |out: List<b>, y: b| out.push(y)) })\n",
  ]);
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) ->
      assert_eq(
        [b"get_or", b"decoded", b"flat"].map(|n: Bytes| {
          let f = formed(p, n);
          verified(owned(f))
        }),
        [None, None, None],
      ),
  }
}
