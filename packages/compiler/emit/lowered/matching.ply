    ),
  ]

fn corpus() -> Bytes =
  corpus_types().concat(Bytes::concat_all(corpus_roots().map(|r: Root| r.src.concat(b"\n"))))

/// What became of a corpus root: lowered, checked and printed, declined by a family and why, or
/// lowered and refused by the check or a printer, and why.
type Outcome = { name: Bytes, by: Option<Family>, refused: Option<Bytes>, why: Bytes }

fn outcome(p: Program, r: Root) -> Outcome / {abort.raise} =
  match formed(p, r.name) {
    Ok(f) -> { name: r.name, by: None, refused: unbuilt(f), why: b"" },
    Err(no) -> { name: r.name, by: Some(no.by), refused: None, why: no.why },
  }

test "the corpus lowers but for constructs other families decline, and what lowers passes the check and prints" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let outcomes = corpus_roots().map(|r: Root| { root: r, out: outcome(p, r) });
      let unexpected = outcomes.filter(|o: { root: Root, out: Outcome }|
        match o.out.by { Some(f) -> !o.root.others.contains(f), None -> o.out.refused != None });
      assert(
        unexpected == [],
        Some(
          String::of_bytes_lossy(
            Bytes::join(
              unexpected.map(|o: { root: Root, out: Outcome }|
                Bytes::concat_all([
                  o.out.name,
                  b": ",
                  match o.out.by {
                    None -> match o.out.refused { Some(why) -> why, None -> b"lowers" },
                    Some(f) -> Bytes::concat_all([family_name(f), b" declines: ", o.out.why]),
                  },
                ])),
              b"\n",
            ),
          ),
        ),
      )
    },
  }
}

fn family_name(f: Family) -> Bytes =
  match f {
    Spine -> b"the spine",
    Data -> b"data",
    Calling -> b"calling",
    Matching -> b"matching",
    Handling -> b"handling",
    Scalars -> b"scalars",
    Containers -> b"containers",
  }
