    ),
    lowers(
      b"sevens",
      b"fn sevens(o: Option<Taken>, n: Int) -> Int = match o { None -> n, Some(t) -> t.at + n }",
    ),
    lowers(
      b"listed_ok",
      b"fn listed_ok(n: Int) -> Int = match [Ok(n), Err(2)] { [Ok(a), Err(b)] -> a + b, _ -> 0 }",
    ),
    lowers(
      b"looked",
