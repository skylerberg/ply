//! Bodies as the check settles them lowered whole: every form a body writes, and every root a
//! build makes of an item, lowers.

import compiler.emit.compare (answered_by_form, program_of)
import compiler.emit.code (Code, NApp, NBuiltin, code_parts)
import compiler.emit.lower.setting (Root)
import compiler.expand.rewrite (Elaborated, elaboration_natives)
import compiler.emit.keys (RootKey, Named, Cases, Clause, ClauseKind, Requires, Ensures, LawPart,
                           LawGuard, LawBody, test_key, law_key)

/// `std.cases` as far as a test over cases, once expanded, calls it.
fn cases_module() -> { name: Bytes, src: Bytes } =
  {
    name: b"std.cases",
    src: Bytes::concat_all([
      b"pub type Table<a> = List<a>\n",
      b"pub type Listed = { label: String, identity: Bytes }\n",
      b"pub fn listed<a | e>(table: List<a>, label: (a) -> String / e) -> List<Listed> / {abort.raise | e} =\n",
      b"  table.map(|c: a| { label: label(c), identity: b\"\" })\n",
      b"pub fn chosen<a>(table: List<a>, at: Int, wanted: Bytes) -> a / {abort.raise} =\n",
      b"  match table.at(at) { Some(c) -> c, None -> panic(\"no case\") }\n",
    ]),
  }

/// A tag whose literals hold holes: its check reads the texts, and `fill` the texts and the holes.
fn tag_module() -> { name: Bytes, src: Bytes } =
  {
    name: b"std.tg",
    src: Bytes::concat_all([
      b"pub fn literal(text: String) -> Result<String, { message: String, offset: Int }> = Ok(text)\n",
      b"pub fn compile(texts: List<String>) -> Result<List<String>, { message: String, offset: Int, part: Int }> = Ok(texts)\n",
      b"pub fn fill(texts: List<String>, holes: List<Int>) -> Int = texts.len() + holes.len()\n",
    ]),
  }

/// A module that writes every form the check writes out: a holed tagged literal, a call on a value
/// copying a default, an update of a call's record, a `try`, a hold, a handler's variables read by
/// what a clause hands on, a witness passed and read, and a test over cases.
fn every_maker() -> Bytes =
  Bytes::concat_all([
    b"import std.tg\n",
    b"type Box = | Box(Int)\n",
    b"type P = { x: Int, y: Int }\n",
    b"effect parse {\n  raise bad(why: String)\n}\n",
    b"effect e {\n  write op(k: Int) -> Int\n}\n",
    b"fn Box::size(b: Box, extra: Int = 2) -> Int = match b { Box(v) -> v + extra }\n",
    b"fn mk() -> P = { x: 1, y: 2 }\n",
    b"fn digit(b: Int) -> Int / {parse.bad} = if b < 10 { b } else { parse.bad(\"no\") }\n",
    b"fn twice<a>(x: a) -> a where numeric(a) = x + x\n",
    b"fn holed(n: Int) -> Int = tg\"a {n} b {n + 1}\"\n",
    b"fn sized(b: Box) -> Int = b.size()\n",
    b"fn moved() -> P = { ..mk(), x: 3 }\n",
    b"fn tried(b: Int) -> Result<Int, String> = try { digit(b) }\n",
    b"fn held() -> Int = with_hold[r](1, |x: Int| ()) { h -> 7 }\n",
    b"fn counted() -> Int = handle { e.op(1) } with { var n = 0, e.op(k) -> { n = k; let f = |j: Int| j + n; f(1) }, return x -> x + n }\n",
    b"fn doubled() -> Int = twice(3)\n",
    b"test \"each case is positive\" for c: Int in [1, 2] { assert(c > 0) }\n",
  ])

/// Whether a build writes root `root` of module `m` of text `src`, or why not.
fn built(src: Bytes, root: RootKey) -> Result<Bool, Bytes> / {abort.raise} =
  match answered_by_form(src, [tag_module(), cases_module()], root) {
    Err(why) -> Err(why),
    Ok(_) -> Ok(true),
  }

test "a test over cases runs and lists" {
  let src = b"type Pair = { a: Int, b: String }\ntest \"each pair holds\" for p: Pair in [{ a: 1, b: \"x\" }] { assert(p.a > 0) }\n";
  let run = test_key(b"m", b"each pair holds");
  assert_eq([run, Cases(run)].map(|r: RootKey| built(src, r)), [Ok(true), Ok(true)])
}

test "a contract's clauses lower over their definition's parameters" {
  let src = b"fn inc(x: Int) -> Int\n  requires x > 0\n  ensures result > x\n= x + 1\n";
  assert_eq(
    [Requires, Ensures].map(|kind: ClauseKind|
      built(src, Clause({ def: Named(b"m.inc"), kind: kind, n: 0 }))),
    [Ok(true), Ok(true)],
  )
}

test "a law's guard and body lower over the law's binders" {
  let src = b"type Few = | One | Two\nlaw \"distinct\" forall (a: Few, b: Few) where a != b { a != b }\n";
  assert_eq(
    [LawGuard, LawBody].map(|part: LawPart| built(src, law_key(b"m", b"distinct", part))),
    [Ok(true), Ok(true)],
  )
}

test "a holed tagged literal, an update of a call's record, a try, a hold, a handler's variables and a witness lower" {
  let roots = [b"m.holed", b"m.moved", b"m.tried", b"m.counted", b"m.sized", b"m.held", b"m.doubled", b"m.twice"];
  assert_eq(
    roots.map(|r: Bytes| { root: r, built: built(every_maker(), Named(r)) }),
    roots.map(|r: Bytes| { root: r, built: Ok(true) }),
  )
}

test "a closure reads what it captures at the type of each read" {
  let src = Bytes::concat_all([
    b"fn within(fs: List<Int>, room: Int) -> List<Int> = range(0, fs.len()).map(|i: Int| match fs.at(i) { Some(x) -> x + room, None -> 0 })\n",
    b"fn nested(xs: List<Int>) -> Int = xs.fold(0, |s: Int, x: Int| { let { a, b } = { a: s, b: x }; range(0, a).fold(b, |acc: Int, k: Int| acc + k + a) })\n",
    b"fn handed(xs: List<Int>, n: Int) -> List<Int> = xs.map(|x: Int| x + n)\n",
    b"fn kept(xs: List<{ k: Int, v: Int }>, n: Int) -> List<Int> = xs.map(|e: { k: Int, v: Int }| e.k + n)\n",
    // A record made of a field of a record it may reuse the cells of: the reuse reads it there.
    b"type T = { word: Bytes, n: Int }\n",
    b"fn reused(t: T) -> T = { let to = |n: Int| { word: if n > 0 { t.word } else { b\"\" }, n: n }; to(1) }\n",
  ]);
  let roots = [b"m.within", b"m.nested", b"m.handed", b"m.kept", b"m.reused"];
  assert_eq(
    roots.map(|r: Bytes| { root: r, built: built(src, Named(r)) }),
    roots.map(|r: Bytes| { root: r, built: Ok(true) }),
  )
}

/// Each call of a builtin `c` makes, by its name and how many arguments it hands.
fn builtin_calls(c: Code) -> List<{ name: Bytes, args: Int }> =
  code_parts(c).fold(
    match c.node {
      NApp(a) -> match a.func.node {
        NBuiltin(b) -> [{ name: b.name, args: a.args.len() }],
        _ -> [],
      },
      _ -> [],
    },
    |acc: List<{ name: Bytes, args: Int }>, x: Code| acc.concat(builtin_calls(x)),
  )

test "each native the lowering writes a call of is passed the words it is declared to take" {
  let declared = elaboration_natives().fold(Map::new(), |acc: Map<Bytes, Int>, n: Elaborated|
    acc.insert(n.name, n.words));
  let src = Bytes::concat_all([
    b"effect e {\n  write op(k: Int) -> Int\n}\n",
    b"fn f<a>(x: a, y: a) -> a where numeric(a) = x + -y\n",
    b"fn g() -> Int = with_hold[r](1, |x: Int| ()) { h -> h.get() }\n",
    b"fn h() -> Int = handle { e.op(1) } with { var n = 0, e.op(k) -> { n = k; n }, return x -> x + n }\n",
  ]);
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let written = p.roots.fold([], |acc: List<{ name: Bytes, args: Int }>, r: Root|
        acc.concat(builtin_calls(r.code).filter(|c: { name: Bytes, args: Int }| declared.contains(c.name))));
      assert_eq(
        written.filter(|c: { name: Bytes, args: Int }| declared.get(c.name) != Some(c.args)),
        [],
      );
      let names = written.fold(Map::new(), |acc: Map<Bytes, Bool>, c: { name: Bytes, args: Int }|
        acc.insert(c.name, true));
      assert_eq(names.keys(), declared.keys())
    },
  }
}
