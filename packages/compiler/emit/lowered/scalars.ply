    b"ordered",
    b"sorted",
    b"wordered",
    b"bordered",
    b"dordered",
    b"cordered",
    b"narrowed",
    b"unsigned",
    b"widened",
    b"wrapped",
    b"turned",
    b"clamped",
    b"floated",
    b"bits",
    b"big",
    b"bigeq",
    b"text",
