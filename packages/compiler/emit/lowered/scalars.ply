//! The scalar family's lowering read off programs: the decision each operator, literal and per-type
//! operation takes, and a corpus that lowers, checks and prints.

import check.types (Type, TyVar, TyCon)
import syntax.patterns (LStr, LDec, LWide, LUnit)
import emit.answer (Exact)
import emit.keys
import emit.keys (Root, RootName, root_name, root_text)
import emit.tir (Rep, RInt, RBool, RNum, RFloat, RDec, RWord, RSum, RImm, Var, Arg, AVar, AInt,
                 ANum, AChar, Val, Prim, Literal, Get, Tag, Call, Native, Inst, Let, Do, If, Block,
                 Scalars)
import emit.compare (Program, program_of, formed, printed_by_form, not_built)

import emit.tir (Static)
import emit.statics (Datum, SStr, SWide, statics_of)

/// Every value `b` binds or does, through the blocks its branches hold.
fn values(b: Block) -> List<Val> =
  b.fold([], |acc: List<Val>, i: Inst|
    match i {
      Let(l) -> acc.push(l.val),
      Do(d) -> acc.push(d.val),
      If(x) -> acc.concat(values(x.then)).concat(values(x.otherwise)),
      _ -> acc,
    })

/// Every variable `b` binds, through the blocks its branches hold.
fn bound_in(b: Block) -> List<Var> =
  b.fold([], |acc: List<Var>, i: Inst|
    match i {
      Let(l) -> acc.push(l.var),
      If(x) -> acc.concat(bound_in(x.then)).concat(bound_in(x.otherwise)),
      _ -> acc,
    })

type Applied = { op: Bytes, on: Rep }

/// The operators root `name` of `p` applies, in order, or why it was not formed.
fn applied(p: Program, name: Bytes) -> Result<List<Applied>, Bytes> / {abort.raise} =
  match formed(p, name) {
    Err(no) -> Err(no.why),
    Ok(f) ->
      Ok(
        values(f.body).fold([], |acc: List<Applied>, v: Val|
          match v { Prim(x) -> acc.push({ op: x.op, on: x.on }), _ -> acc }),
      ),
  }

/// The roots root `name` of `p` calls by name, or why it was not formed.
fn roots_called(p: Program, name: Bytes) -> Result<List<RootName>, Bytes> / {abort.raise} =
  match formed(p, name) {
    Err(no) -> Err(no.why),
    Ok(f) ->
      Ok(
        values(f.body).fold([], |acc: List<RootName>, v: Val|
          match v {
            Call(c) -> match c.callee { Root(k) -> acc.push(root_name(k)), _ -> acc },
            _ -> acc,
          }),
      ),
  }

/// The runtime functions root `name` of `p` calls, or why it was not formed.
fn natives(p: Program, name: Bytes) -> Result<List<Bytes>, Bytes> / {abort.raise} =
  match formed(p, name) {
    Err(no) -> Err(no.why),
    Ok(f) ->
      Ok(
        values(f.body).fold([], |acc: List<Bytes>, v: Val|
          match v { Native(n) -> acc.push(n.name), _ -> acc }),
      ),
  }

fn analysed(src: Bytes) -> Program / {abort.raise} =
  match program_of(src) { Ok(p) -> p, Err(why) -> panic(String::of_bytes(why)) }

/// The root written in `m` for operation `op` of `ty`, by its name.
fn written_root(op: keys::TypeOp, ty: Type) -> RootName / {abort.raise} =
  root_name(keys::written(op, ty, b"m"))

fn con(name: Bytes, args: List<Type>) -> Type = TyCon({ name: name, args: args })

/// The operands of each operator root `name` of `p` applies, in order, or why it was not formed.
fn operands(p: Program, name: Bytes) -> Result<List<List<Arg>>, Bytes> / {abort.raise} =
  match formed(p, name) {
    Err(no) -> Err(no.why),
    Ok(f) ->
      Ok(
        values(f.body).fold([], |acc: List<List<Arg>>, v: Val|
          match v { Prim(x) -> acc.push(x.args), _ -> acc }),
      ),
  }

/// Whether root `name` of `p` reads a field, or why it was not formed.
fn reads(p: Program, name: Bytes) -> Result<Bool, Bytes> / {abort.raise} =
  match formed(p, name) {
    Err(no) -> Err(no.why),
    Ok(f) -> Ok(values(f.body).any(|v: Val| match v { Get(_) -> true, _ -> false })),
  }

test "records of a known type are compared and ordered field by field, not by the runtime" {
  let p = analysed(
    Bytes::concat_all([
      b"type P = { x: Int, name: String }\n",
      b"type Q = { p: P, k: Char }\n",
      b"type R = { o: Option<Int>, n: Int }\n",
      b"fn same(a: P, b: P) -> Bool = a == b\n",
      b"fn apart(a: Q, b: Q) -> Bool = a != b\n",
      b"fn order(a: P, b: P) -> Ordering = compare(a, b)\n",
      b"fn optional(a: R, b: R) -> Bool = a == b\n",
    ]),
  );
  // Fields in the checker's order, each compared only where those before it were equal.
  assert_eq(applied(p, b"same"), Ok([{ op: b"bytes_eq", on: RWord }, { op: b"eq", on: RInt }]));
  assert_eq(reads(p, b"same"), Ok(true));
  assert_eq(natives(p, b"same"), Ok([]));
  // An `Option` a record holds is compared by the root written for its type.
  assert_eq(applied(p, b"optional"), Ok([{ op: b"eq", on: RInt }]));
  assert_eq(
    roots_called(p, b"optional"),
    Ok([written_root(keys::Contained(b"equal"), con(b"Option", [con(b"Int", [])]))]),
  );
  assert_eq(natives(p, b"optional"), Ok([]));
  // A record a record holds is compared field by field again.
  assert_eq(
    applied(p, b"apart"),
    Ok([
      { op: b"eq", on: RImm },
      { op: b"bytes_eq", on: RWord },
      { op: b"eq", on: RInt },
      { op: b"not", on: RBool },
    ]),
  );
  assert_eq(natives(p, b"apart"), Ok([]));
  // The first field that orders them apart decides; the sign is made the `Ordering` once.
  assert_eq(
    applied(p, b"order"),
    Ok([
      { op: b"bytes_order", on: RWord },
      { op: b"ne", on: RInt },
      { op: b"order", on: RInt },
      { op: b"ordering", on: RInt },
    ]),
  );
  assert_eq(roots_called(p, b"order"), Ok([]))
}

fn width(bits: Int, signed: Bool) -> Rep = RNum({ bits: bits, signed: signed })

test "an operator is read at the type its operands hold, a width's literal as its own bits" {
  let p = analysed(
    Bytes::concat_all([
      b"fn wadd(a: U8) -> U8 = a + 1u8\n",
      b"fn half(x: Float) -> Float = 0.5 * x\n",
      b"fn less(a: Int, b: Int) -> Bool = a < b\n",
      b"fn wide(a: U64, b: U64) -> U64 = a * b\n",
      b"fn big(a: U128, b: U128) -> U128 = a + b\n",
    ]),
  );
  let byte = { bits: 8, signed: false };
  assert_eq(applied(p, b"wadd"), Ok([{ op: b"add", on: RNum(byte) }]));
  // The literal is the width's own bits.
  assert_eq(
    operands(p, b"wadd").map(|xs: List<List<Arg>>| xs.map(|a: List<Arg>| a.drop(1))),
    Ok([[ANum({ width: byte, bits: 1 })]]),
  );
  assert_eq(applied(p, b"half"), Ok([{ op: b"mul", on: RFloat }]));
  assert_eq(applied(p, b"less"), Ok([{ op: b"lt", on: RInt }]));
  assert_eq(applied(p, b"wide"), Ok([{ op: b"mul", on: width(64, false) }]));
  // No register holds 128 bits: the runtime's operator takes the words.
  assert_eq(applied(p, b"big"), Ok([]));
  assert_eq(natives(p, b"big"), Ok([b"rt_binary_p"]))
}

/// The codes root `name` of `p` hands `rt_binary_p`, in order, or why it was not formed.
fn runtime_codes(p: Program, name: Bytes) -> Result<List<Int>, Bytes> / {abort.raise} =
  match formed(p, name) {
    Err(no) -> Err(no.why),
    Ok(f) ->
      Ok(
        values(f.body).fold([], |acc: List<Int>, v: Val|
          match v {
            Native(n) -> if n.name != b"rt_binary_p" { acc }
            else { match n.args.at(0) { Some(AInt(code)) -> acc.push(code), _ -> acc } },
            _ -> acc,
          }),
      ),
  }

test "an operator the runtime does over two words is named by its place in the runtime's table" {
  let p = analysed(
    Bytes::concat_all([
      b"fn ops(a: U128, b: U128, n: Int) -> U128 / {abort.raise} = {\n",
      b"  let s = a + b;\n  let d = s - a;\n  let m = d * b;\n  let q = m / b;\n  let r = q % b;\n",
      b"  let x = r & a;\n  let o = x | b;\n  let e = o ^ a;\n  let l = e << n;\n  let h = l >> n;\n",
      b"  h >>> n\n}\n",
      b"fn orders(a: I128, b: I128) -> Bool = {\n",
      b"  let lt = a < b;\n  let le = a <= b;\n  let gt = a > b;\n  let ge = a >= b;\n",
      b"  lt == le && gt == ge\n}\n",
    ]),
  );
  // The runtime's `BINOPS`: `concat` at 11 lies between the orders and the bit operators.
  assert_eq(runtime_codes(p, b"ops"), Ok([0, 1, 2, 3, 4, 12, 13, 14, 15, 16, 17]));
  assert_eq(runtime_codes(p, b"orders"), Ok([7, 8, 9, 10]))
}

test "an Int quotient or remainder by a literal is C's own operator, and by anything else the runtime's" {
  let p = analysed(b"fn q(a: Int, b: Int) -> Int / {abort.raise} = a / -4 + a % 7 + a / b\n");
  match formed(p, b"q") {
    Err(no) -> assert_eq(no.why, b""),
    Ok(f) ->
      assert_eq(
        values(f.body).fold([], |acc: List<List<Arg>>, v: Val|
          match v {
            Prim(x) -> if x.op == b"div" || x.op == b"rem" { acc.push(x.args.drop(1)) }
            else { acc },
            _ -> acc,
          }),
        [[AInt(0 - 4)], [AInt(7)], [AVar(f.params.get(1))]],
      ),
  };
  // C divides by the literals itself, and asks the runtime where the divisor may be 0 or -1.
  match printed_by_form(p, b"q") {
    Err(why) -> assert_eq(why, b""),
    Ok(text) -> {
      assert(text.index_of(b"/ INT64_C(-4)") != None && text.index_of(b"% INT64_C(7)") != None);
      assert(text.index_of(b"rt_arith_p(") != None)
    },
  }
}

test "a Decimal is held in registers as its two words, a literal one written as them" {
  let p = analysed(
    b"fn d(a: Decimal, b: Decimal) -> Decimal = a * b - a\nfn dl(a: Decimal) -> Bool = a < 1.5m\n",
  );
  assert_eq(applied(p, b"d"), Ok([{ op: b"mul", on: RDec }, { op: b"sub", on: RDec }]));
  assert_eq(applied(p, b"dl"), Ok([{ op: b"decimal", on: RInt }, { op: b"lt", on: RDec }]));
  match formed(p, b"dl") {
    Err(no) -> assert_eq(no.why, b""),
    Ok(f) -> assert_eq(bound_in(f.body).map(|v: Var| v.rep), [RDec, RBool]),
  };
  // The runtime is handed the two words of each operand, never a box of them.
  match printed_by_form(p, b"d") {
    Err(why) -> assert_eq(why, b""),
    Ok(text) ->
      assert(
        text.index_of(b"rt_decimal_binary_p(") != None && text.index_of(b"p0.lo") != None
          && text.index_of(b"p1.hi") != None,
      ),
  };
  match printed_by_form(p, b"dl") {
    Err(why) -> assert_eq(why, b""),
    Ok(text) ->
      assert(
        text.index_of(b"(PlyDec){") != None && text.index_of(b"rt_decimal_compare_p(") != None,
      ),
  }
}

test "a Char is its own word, compared as C compares the words" {
  let p = analysed(b"fn c(a: Char) -> Bool = a < 'z'\n");
  assert_eq(applied(p, b"c"), Ok([{ op: b"lt", on: RImm }]));
  assert_eq(
    operands(p, b"c").map(|xs: List<List<Arg>>| xs.map(|a: List<Arg>| a.drop(1))),
    Ok([[AChar(122)]]),
  )
}

test "strings and byte strings are compared by their bytes, constructors of no argument by their index" {
  let p = analysed(
    Bytes::concat_all([
      b"type Suit = | Hearts | Spades\n",
      b"fn s(a: String, b: String) -> Bool = a == b\n",
      b"fn bs(a: Bytes, b: Bytes) -> Bool = a != b\n",
      b"fn suit(a: Suit, b: Suit) -> Bool = a != b\n",
      b"fn picked(c: Bool) -> Bool = { let x = if c { Hearts } else { Spades }; let y = if c { Spades } else { Hearts }; x == y }\n",
    ]),
  );
  assert_eq(applied(p, b"s"), Ok([{ op: b"bytes_eq", on: RWord }]));
  assert_eq(applied(p, b"bs"), Ok([{ op: b"bytes_ne", on: RWord }]));
  // Parameters cross as their one word, which is their case's place, compared as two numbers.
  let ops = |name: Bytes|
    match applied(p, name) {
      Ok(xs) ->
        xs.map(|x: { op: Bytes, on: Rep }|
          { op: x.op, sum: match x.on { RSum(_) -> true, _ -> false } }),
      Err(why) -> [{ op: why, sum: false }],
    };
  assert_eq(ops(b"suit"), [{ op: b"ne", sum: true }]);
  assert_eq(ops(b"picked"), [{ op: b"eq", sum: true }])
}

test "an Option and a Result are compared by the roots written for their types" {
  let p = analysed(
    Bytes::concat_all([
      b"fn ints(a: Option<Int>, b: Option<Int>) -> Bool = a == b\n",
      b"fn texts(a: Option<String>, b: Option<String>) -> Bool = a != b\n",
      b"fn results(a: Result<Int, String>, b: Result<Int, String>) -> Bool = a == b\n",
    ]),
  );
  let equal = |ty: Type| Ok([written_root(keys::Contained(b"equal"), ty)]);
  assert_eq(roots_called(p, b"ints"), equal(con(b"Option", [con(b"Int", [])])));
  assert_eq(roots_called(p, b"texts"), equal(con(b"Option", [con(b"String", [])])));
  assert_eq([b"ints", b"texts"].map(|n: Bytes| natives(p, n)), [Ok([]), Ok([])]);
  assert_eq(
    roots_called(p, b"results"),
    equal(con(b"Result", [con(b"Int", []), con(b"String", [])])),
  )
}

test "two values of a declared sum are compared and ordered through roots written for it" {
  let p = analysed(
    Bytes::concat_all([
      b"type Shape = | Circle(Int) | Square(Int, Int)\n",
      b"fn same(a: Shape, b: Shape) -> Bool = a == b\n",
      b"fn apart(a: Shape, b: Shape) -> Bool = a != b\n",
      b"fn order(a: Shape, b: Shape) -> Ordering = compare(a, b)\n",
    ]),
  );
  let shape = con(b"m.Shape", []);
  assert_eq(roots_called(p, b"same"), Ok([written_root(keys::Equal, shape)]));
  // The root answers a `Bool`, which `!=` negates.
  assert_eq(applied(p, b"apart"), Ok([{ op: b"not", on: RBool }]));
  assert_eq(roots_called(p, b"order"), Ok([written_root(keys::Order, shape)]));
  assert_eq(applied(p, b"order"), Ok([]))
}

test "a list, an array or a map is compared through the root written for its type" {
  let p = analysed(
    b"fn lists(a: List<Int>, b: List<Int>) -> Bool = a == b\nfn maps(a: Map<Int, String>, b: Map<Int, String>) -> Ordering = compare(a, b)\n",
  );
  assert_eq(
    roots_called(p, b"lists"),
    Ok([written_root(keys::Contained(b"equal"), con(b"List", [con(b"Int", [])]))]),
  );
  match formed(p, b"lists") {
    Err(no) -> assert_eq(no.why, b""),
    // The root answers a `Bool` as itself, as today's roots for containers do.
    Ok(f) ->
      assert_eq(
        values(f.body).fold([], |acc: List<Rep>, v: Val|
          match v { Call(c) -> acc.push(c.conv.answer), _ -> acc }),
        [RBool],
      ),
  };
  assert_eq(
    roots_called(p, b"maps"),
    Ok([
      written_root(keys::Contained(b"ordered"), con(b"Map", [con(b"Int", []), con(b"String", [])])),
    ]),
  )
}

test "compare at a number, a character or a string orders in C and answers its constructor" {
  let p = analysed(
    Bytes::concat_all([
      b"fn ci(a: Int, b: Int) -> Ordering = compare(a, b)\n",
      b"fn cc(a: Char, b: Char) -> Ordering = compare(a, b)\n",
      b"fn cs(a: String, b: String) -> Ordering = compare(a, b)\n",
      b"fn cw(a: U16, b: U16) -> Ordering = compare_values(a, b)\n",
      b"fn cd(a: Decimal, b: Decimal) -> Ordering = compare(a, b)\n",
    ]),
  );
  let made = { op: b"ordering", on: RInt };
  assert_eq(applied(p, b"ci"), Ok([{ op: b"order", on: RInt }, made]));
  assert_eq(applied(p, b"cc"), Ok([{ op: b"order", on: RImm }, made]));
  assert_eq(applied(p, b"cs"), Ok([{ op: b"bytes_order", on: RWord }, made]));
  assert_eq(applied(p, b"cw"), Ok([{ op: b"order", on: width(16, false) }, made]));
  assert_eq(applied(p, b"cd"), Ok([{ op: b"order", on: RDec }, made]));
  assert_eq([b"ci", b"cc", b"cs", b"cw", b"cd"].map(|n: Bytes| roots_called(p, n)), [
    Ok([]),
    Ok([]),
    Ok([]),
    Ok([]),
    Ok([]),
  ])
}

test "a width is converted, wrapped, rotated and saturated in place at its operands' type" {
  let p = analysed(
    Bytes::concat_all([
      b"fn n(x: Int) -> U8 / {abort.raise} = U8::of_int(x)\n",
      b"fn i(a: U16) -> Int = Int::of_u16(a)\n",
      b"fn w(a: U32, b: U32) -> U32 = a *% b\n",
      b"fn r(a: U32) -> U32 = rotl(a, 5)\n",
      b"fn s(a: I8, b: I8) -> I8 = a -| b\n",
      b"fn f(n: Int) -> Float = Float::of_int(n)\n",
      b"fn bits(x: Float) -> Int = bits_of_float(x)\n",
    ]),
  );
  assert_eq(applied(p, b"n"), Ok([{ op: b"of_int", on: RInt }]));
  assert_eq(applied(p, b"i"), Ok([{ op: b"to_int", on: width(16, false) }]));
  assert_eq(applied(p, b"w"), Ok([{ op: b"wrap_mul", on: width(32, false) }]));
  assert_eq(applied(p, b"r"), Ok([{ op: b"rotl", on: width(32, false) }]));
  assert_eq(applied(p, b"s"), Ok([{ op: b"saturating_sub", on: width(8, true) }]));
  assert_eq(applied(p, b"f"), Ok([{ op: b"to_float", on: RInt }]));
  assert_eq(applied(p, b"bits"), Ok([{ op: b"bits", on: RFloat }]));
  match formed(p, b"n") {
    Err(no) -> assert_eq(no.why, b""),
    Ok(f) -> assert_eq(bound_in(f.body).map(|v: Var| v.rep), [width(8, false)]),
  }
}

test "a Float function is its native's over the operands' bits, nothing boxed" {
  let p = analysed(
    Bytes::concat_all([
      b"fn root(x: Float) -> Float = x.sqrt()\n",
      b"fn angle(y: Float, x: Float) -> Float = Float::atan2(y, x)\n",
    ]),
  );
  assert_eq(natives(p, b"root"), Ok([b"builtin_elaborated_float_sqrt_p"]));
  assert_eq(natives(p, b"angle"), Ok([b"builtin_elaborated_float_atan2_p"]));
  assert_eq(
    applied(p, b"angle"),
    Ok([{ op: b"bits", on: RFloat }, { op: b"bits", on: RFloat }, { op: b"of_bits", on: RInt }]),
  )
}

test "a value of a type variable is compared by the runtime, which notes the type a specialisation reads" {
  let p = analysed(b"fn same<a>(x: a, y: a) -> Bool = x != y\n");
  assert_eq(natives(p, b"same"), Ok([b"rt_equal_p"]));
  assert_eq(applied(p, b"same"), Ok([{ op: b"not", on: RBool }]));
  match formed(p, b"same") {
    Err(no) -> assert_eq(no.why, b""),
    Ok(f) -> match f.params.at(0) {
      Some(x) -> match x.ty {
        TyVar(v) -> assert_eq(f.links.needs, [{ var: v, reads: Exact }]),
        other -> assert_eq(Some(other), None),
      },
      None -> assert_eq(f.params.len(), 2),
    },
  }
}

test "a constant is a static object, a decimal its two words, and a register's written as itself" {
  let p = analysed(
    Bytes::concat_all([
      b"fn text() -> String = \"ply\"\n",
      b"fn dec() -> Decimal = 2.50m\n",
      b"fn huge() -> U128 = 7u128\n",
      b"fn unit() -> Unit = ()\n",
      b"fn top() -> U64 = 18446744073709551615u64\n",
    ]),
  );
  // What each body binds first: a root of no parameter hands its answer back as a word after it.
  let read = |name: Bytes|
    match formed(p, name) {
      Err(no) -> Err(no.why),
      Ok(f) ->
        Ok(match f.body.at(0) { Some(Let(l)) -> Some({ val: l.val, rep: l.var.rep }), _ -> None }),
    };
  let named = |s: Datum| Static(statics_of(s).get(0).name);
  assert_eq(read(b"text"), Ok(Some({ val: named(SStr(b"ply")), rep: RWord })));
  // 2.50 is 250 at scale 2: the scale in the flags' bits 16 to 23, the mantissa from bit 32.
  assert_eq(
    read(b"dec"),
    Ok(
      Some({
        val: Prim({ op: b"decimal", on: RInt, args: [AInt(2 << 16 | 250 << 32), AInt(0)] }),
        rep: RDec,
      }),
    ),
  );
  assert_eq(
    read(b"huge"),
    Ok(
      Some({
        val: named(SWide({ width: { bits: 128, signed: false }, high: 0, low: 7 })),
        rep: RWord,
      }),
    ),
  );
  // `()` is no value at all.
  assert_eq(read(b"unit"), Ok(None));
  match formed(p, b"top") {
    Err(no) -> assert_eq(no.why, b""),
    Ok(f) ->
      assert_eq(values(f.body).filter(|v: Val| match v { Literal(_) -> true, _ -> false }), []),
  };
  match printed_by_form(p, b"text") {
    Err(why) -> assert_eq(why, b""),
    Ok(t) -> {
      let address = Bytes::concat_all([b"(Word)(intptr_t)&", statics_of(SStr(b"ply")).get(0).name]);
      assert(t.index_of(address) != None, None)
    },
  }
}

test "what C does not write at a type is the runtime's builtin, an encoding written by a root hashed" {
  let p = analysed(
    Bytes::concat_all([
      b"type P = { x: Int, name: String }\n",
      b"fn h(x: Int) -> Bytes = digest(x)\n",
      b"fn hr(x: P) -> Bytes = digest(x)\n",
      b"fn sat(a: U64, b: U64) -> U64 = a +| b\n",
      b"fn wi(a: Int, b: Int) -> Int = a +% b\n",
      b"fn big(a: U128) -> Option<U128> = checked_neg(a)\n",
    ]),
  );
  assert_eq([b"h", b"hr", b"sat", b"wi", b"big"].map(|n: Bytes| natives(p, n)), [
    Ok([b"builtin_digest_p"]),
    Ok([b"builtin_bytes_blake3_p"]),
    Ok([b"builtin_saturating_add_p"]),
    Ok([b"builtin_wrap_add_p"]),
    // An `Option` the runtime answers crosses back as its encoding.
    Ok([
      b"builtin_elaborated_lower_open_p",
      b"builtin_elaborated_out_count_p",
      b"builtin_elaborated_lift_close_p",
    ]),
  ]);
  assert_eq(
    roots_called(p, b"hr").map(|rs: List<RootName>|
      rs.map(|r: RootName| root_text(r).starts_with(b"m.digest#"))),
    Ok([true]),
  )
}

test "a width's checked arithmetic is exact in 64 bits, its answer `Some` where the width holds it" {
  let p = analysed(
    Bytes::concat_all([
      b"fn add(a: U8, b: U8) -> Option<U8> = checked_add(a, b)\n",
      b"fn mul(a: U32, b: U32) -> Option<U32> = checked_mul(a, b)\n",
      b"fn neg(a: I16) -> Option<I16> = checked_neg(a)\n",
    ]),
  );
  assert_eq(
    applied(p, b"add"),
    Ok([
      { op: b"exact_add", on: width(8, false) },
      { op: b"within", on: RInt },
      { op: b"narrow", on: RInt },
    ]),
  );
  // Only an unsigned 32-bit product needs the unsigned word.
  assert_eq(
    applied(p, b"mul"),
    Ok([
      { op: b"exact_mul", on: width(32, false) },
      { op: b"le", on: width(64, false) },
      { op: b"narrow", on: width(64, false) },
    ]),
  );
  assert_eq(
    applied(p, b"neg"),
    Ok([
      { op: b"exact_neg", on: width(16, true) },
      { op: b"within", on: RInt },
      { op: b"narrow", on: RInt },
    ]),
  );
  assert_eq([b"add", b"mul", b"neg"].map(|n: Bytes| natives(p, n)), [Ok([]), Ok([]), Ok([])])
}

test "a stated witness is its constructor's tag, past the witnesses the runtime numbers itself" {
  let p = analysed(
    Bytes::concat_all([
      b"type Length = | Metres(Int) | Millimetres(Int)\n",
      b"key for Length by millimetres\n",
      b"numeric for Length by { add: plus, sub: plus, mul: plus, neg: negated, of_int: metres }\n",
      b"fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }\n",
      b"fn plus(a: Length, b: Length) -> Length = a\n",
      b"fn negated(a: Length) -> Length = a\n",
      b"fn metres(n: Int) -> Length = Metres(n)\n",
      b"fn twice<a>(x: a) -> a\n  where numeric(a)\n= x + x\n",
      b"fn doubled(g: Length) -> Length = twice(g)\n",
    ]),
  );
  match formed(p, b"doubled") {
    Err(no) -> assert_eq(no.why, b""),
    Ok(f) -> {
      assert_eq(
        values(f.body).fold([], |acc: List<Bytes>, v: Val|
          match v {
            Tag(n) ->
              acc.push(if n == b"m.Metres" || n == b"m.Millimetres" { b"a tag of Length" }
              else { n }),
            Prim(x) -> if x.op == b"witness" { acc.push(b"13 +") } else { acc },
            _ -> acc,
          }),
        [b"a tag of Length", b"13 +"],
      );
      // The name is read off the literal the elaboration writes, never from the pool.
      assert_eq(values(f.body).filter(|v: Val| match v { Literal(_) -> true, _ -> false }), [])
    },
  }
}

test "a declared sum's negation is the function its module states, which no native runs" {
  let p = analysed(
    Bytes::concat_all([
      b"type Length = | Metres(Int) | Millimetres(Int)\n",
      b"numeric for Length by { add: plus, sub: plus, mul: plus, neg: negated, of_int: metres }\n",
      b"fn plus(a: Length, b: Length) -> Length = a\n",
      b"fn negated(a: Length) -> Length = a\n",
      b"fn metres(n: Int) -> Length = Metres(n)\n",
      b"fn back(g: Length) -> Length = -g\n",
    ]),
  );
  assert_eq(natives(p, b"back"), Ok([]))
}

/// The corpus as module `m` of a program.
fn corpus_program() -> Program / {abort.raise} = analysed(corpus())

fn corpus() -> Bytes =
  Bytes::concat_all([
    b"type Suit = | Hearts | Spades\n",
    b"type Card = | Pip(Int) | Face(String)\n",
    b"fn add8(a: U8, b: U8) -> U8 = a + b\n",
    b"fn mul16(a: I16, b: I16) -> I16 = a * b\n",
    b"fn sub64(a: I64, b: I64) -> I64 = a - b\n",
    b"fn neg8(a: I8) -> I8 = -a\n",
    b"fn neg64(a: I64) -> I64 = -a\n",
    b"fn inv32(a: U32) -> U32 = ~a\n",
    b"fn shl8(a: U8) -> U8 = a << 3\n",
    b"fn sar(a: Int, n: Int) -> Int = a >> n\n",
    b"fn lsr(a: Int, n: Int) -> Int = a >>> n\n",
    b"fn mix(a: Int, b: Int) -> Int = (a ^ b) & ~a\n",
    b"fn quotient(a: Int) -> Int / {abort.raise} = a / -4 - a % 3\n",
    b"fn ratio(x: Float, y: Float) -> Float = x / y % 2.0\n",
    b"fn below(x: Float, y: Float) -> Bool = x - y < 0.001\n",
    b"fn scaled(d: Decimal, e: Decimal) -> Decimal = d * e - d\n",
    b"fn dless(d: Decimal, e: Decimal) -> Bool = d >= e\n",
    b"fn dneg(d: Decimal) -> Decimal = -d\n",
    b"fn cless(a: Char, b: Char) -> Bool = a > b\n",
    b"fn cmid(a: Char) -> Bool = a != 'm'\n",
    b"fn texts(a: String, b: String) -> Bool = a == b\n",
    b"fn raw(a: Bytes, b: Bytes) -> Bool = a != b\n",
    b"fn joined(a: String, b: String) -> String = a ++ b\n",
    b"fn ordered(a: Int, b: Int) -> Ordering = compare(a, b)\n",
    b"fn sorted(a: String, b: String) -> Ordering = compare(a, b)\n",
    b"fn wordered(a: U16, b: U16) -> Ordering = compare(a, b)\n",
    b"fn bordered(a: Bool, b: Bool) -> Ordering = compare_values(a, b)\n",
    b"fn dordered(a: Decimal, b: Decimal) -> Ordering = compare(a, b)\n",
    b"fn cordered(a: Char, b: Char) -> Ordering = compare(a, b)\n",
    b"fn narrowed(x: Int) -> I16 / {abort.raise} = I16::of_int(x)\n",
    b"fn unsigned(x: Int) -> U64 / {abort.raise} = U64::of_int(x)\n",
    b"fn widened(x: I32) -> Int = Int::of_i32(x)\n",
    b"fn wrapped(a: U32, b: U32) -> U32 = a *% b +% rotl(a, 5)\n",
    b"fn turned(a: U8, n: Int) -> U8 = rotr(a, n)\n",
    b"fn clamped(a: U8, b: U8) -> U8 = a +| b\n",
    b"fn floated(n: Int) -> Float = Float::of_int(n) + Float::of_bits(n)\n",
    b"fn bits(x: Float) -> Int = bits_of_float(x)\n",
    b"fn big(a: U128, b: U128) -> U128 = a + b\n",
    b"fn bigeq(a: I128, b: I128) -> Bool = a == b\n",
    b"fn text() -> String = \"ply\"\n",
    b"fn dec() -> Decimal = 2.50m\n",
    b"fn huge() -> U128 = 7u128\n",
    b"fn unit() -> Unit = ()\n",
    b"fn suited(a: Suit, b: Suit) -> Bool = a == b\n",
    b"fn cards(a: Card, b: Card) -> Bool = a != b\n",
    b"fn ranked(a: Card, b: Card) -> Ordering = compare(a, b)\n",
    b"fn lists(a: List<Int>, b: List<Int>) -> Bool = a == b\n",
    b"fn generic<a>(x: a, y: a) -> Bool = x != y\n",
    b"fn same(a: Bool, b: Bool) -> Bool = a != b\n",
    b"fn flags(a: Bool) -> Bool = !a\n",
    b"type Pt = { x: Int, y: Int }\n",
    b"fn points(a: Pt, b: Pt) -> Bool = a == b\n",
    b"fn hashed(x: Int) -> Bytes = digest(x)\n",
    b"fn checked8(a: U8, b: U8) -> Option<U8> = checked_add(a, b)\n",
    b"fn wrapped64(a: Int, b: Int) -> Int = a *% b\n",
  ])

fn corpus_names() -> List<Bytes> =
  [
    b"add8",
    b"mul16",
    b"sub64",
    b"neg8",
    b"neg64",
    b"inv32",
    b"shl8",
    b"sar",
