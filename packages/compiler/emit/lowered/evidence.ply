//! The evidence words programs' roots are lowered to take and hand on: a definition's past its
//! parameters, a call's to its callee, a call of a function value's with its row's descriptor, and
//! the rows a call of a definition generic over rows hands words for.

import compiler.check.types (TyCon, RSingleton, RNamed, RVar)
import compiler.emit.keys (Evidence)
import compiler.emit.evidence (evidence_type, words_apart)
import compiler.emit.answer (GenericCall, Need, Rowed)
import compiler.emit.tir (handed_of, reps_of, RImm, RInt, Var, Arg, AVar, AZero, Val, Call, Apply,
                          Static, Op, OHandle, Inst, Let, Do, Handle, Fn, Block, Return)
import compiler.emit.tir.handling (WordsLaid, ObjectAt)
import compiler.emit.compare (Program, program_of, formed, checked, printed_by_form)

fn corpus() -> Bytes =
  Bytes::concat_all([
    b"effect log {\n  write note(n: Int) -> Unit\n}\n",
    b"effect link {\n  write send[s](payload: Int) -> Int\n}\n",
    b"fn noted(n: Int) -> Unit / {log.note, abort.raise} = if n < 0 { abort.raise(\"no\") } else { log.note(n) }\n",
    b"fn relayed(n: Int) -> Unit / {log.note, abort.raise} = noted(n)\n",
    b"fn quiet(n: Int) -> Unit / {abort.raise} = handle { noted(n) } with { log.note(_n) -> () }\n",
    b"fn apply<|e>(f: () -> Int / e) -> Int / e = f()\n",
    b"fn logged() -> Int / {log.note} = apply(|| { log.note(1); 2 })\n",
    b"fn sent<[l]>(x: Int) -> Int / {link.send[l]} = apply(|| link.send[l](x))\n",
    b"fn wide() -> Unit / {a.x, b.x, c.x, d.x, e.x} = { a.x(); b.x(); c.x(); d.x(); e.x() }\n",
    b"effect a {\n  write x() -> Unit\n}\n",
    b"effect b {\n  write x() -> Unit\n}\n",
    b"effect c {\n  write x() -> Unit\n}\n",
    b"effect d {\n  write x() -> Unit\n}\n",
    b"effect e {\n  write x() -> Unit\n}\n",
    b"fn widely() -> Unit / {a.x, b.x, c.x, d.x, e.x} = wide()\n",
  ])

fn program() -> Program / {abort.raise} =
  match program_of(corpus()) { Ok(p) -> p, Err(why) -> panic(String::of_bytes_lossy(why)) }

fn form(name: Bytes) -> Fn / {abort.raise} = formed(program(), name)

/// The values `b` binds or does, at any depth.
fn vals(b: Block) -> List<Val> =
  b.fold([], |acc: List<Val>, i: Inst|
    match i {
      Let(l) -> acc.push(l.val),
      Do(d) -> acc.push(d.val),
      Handle(h) -> acc.concat(vals(h.body)),
      _ -> acc,
    })

fn calls(f: Fn) -> List<List<Arg>> =
  vals(f.body).fold([], |acc: List<List<Arg>>, v: Val|
    match v { Call(c) -> acc.push(c.args), _ -> acc })

fn word(name: Bytes) -> Evidence = { effect: name, resource: RSingleton }

test "a definition takes a word for each effect and resource its row names, past its parameters" {
  let f = form(b"noted");
  // One parameter, then `abort`'s word and `log`'s, in order.
  assert_eq(f.params.map(|v: Var| v.rep), [RInt, RImm, RImm]);
  assert_eq(f.params.drop(1).map(|v: Var| v.ty), [evidence_type(), evidence_type()]);
  assert_eq(f.conv.params.len(), 3)
}

test "a call hands its callee the words the caller holds, and a handle around it its own" {
  let relayed = form(b"relayed");
  assert_eq(calls(relayed), [
    [AVar(relayed.params.get(0)), AVar(relayed.params.get(1)), AVar(relayed.params.get(2))],
  ]);
  // `quiet` holds a word for `abort` and answers `log` with its handle: the object it lays out.
  let quiet = form(b"quiet");
  assert_eq(calls(quiet).map(|args: List<Arg>| args.drop(1)), [
    [AVar(quiet.params.get(1))].concat(objects(quiet.body).map(AVar)),
  ])
}

/// The evidence objects `b` lays out, a `handle`'s body's among them.
fn objects(b: Block) -> List<Var> =
  b.fold([], |acc: List<Var>, i: Inst|
    match i {
      Let(l) -> match l.val {
        Op(o) -> match o.op { OHandle(ObjectAt(_)) -> acc.push(l.var), _ -> acc },
        _ -> acc,
      },
      Handle(h) -> acc.concat(objects(h.body)),
      _ -> acc,
    })

test "more words than a function takes apart go as one array" {
  let wide = form(b"wide");
  assert_eq(wide.params.len(), 1);
  assert(5 > words_apart(), None);
  let widely = form(b"widely");
  assert_eq(
    vals(widely.body).any(|v: Val| match v { Op(o) -> o.op == OHandle(WordsLaid), _ -> false }),
    true,
  )
}

test "a definition generic over rows is settled by its callers, at the rows they hand words for" {
  // `apply` as it stands leaves its row variable unfilled.
  assert_eq(form(b"apply").links.needs.contains({ var: 0 - 1, reads: Rowed }), true);
  let logged = form(b"logged");
  assert_eq(logged.links.generics.map(|g: GenericCall| g.rows), [[[word(b"m.log")]]]);
  // A caller's label is the first the specialisation is handed, beside its words.
  let sent = form(b"sent");
  assert_eq(sent.links.generics.map(|g: GenericCall| g.rows), [
    [[{ effect: b"m.link", resource: RVar(0) }]],
  ]);
  match calls(sent).at(0) {
    Some(args) -> assert_eq(args.len(), 3),
    None -> assert(false, Some("`sent` calls nothing")),
  }
}

test "a call of a function value hands it its row's descriptor and an array of the words" {
  let logged = form(b"logged");
  let applies = vals(logged.body).filter(|v: Val| match v { Apply(_) -> true, _ -> false });
  assert_eq(applies, []);
  // The body of `apply` at no row calls `f` handing a descriptor of nothing.
  let apply = form(b"apply");
  let applied = vals(apply.body).fold([], |acc: List<List<Arg>>, v: Val|
    match v { Apply(c) -> acc.push(c.args), _ -> acc });
  assert_eq(applied.map(|args: List<Arg>| args.len()), [2]);
  assert(vals(apply.body).any(|v: Val| match v { Static(_) -> true, _ -> false }), None)
}

test "each form with words checks and prints" {
  let p = program();
  [b"noted", b"relayed", b"quiet", b"logged", b"sent", b"wide", b"widely"].map(|n: Bytes|
    match printed_by_form(p, n) {
      Ok(_) -> (),
      Err(why) -> panic(String::of_bytes_lossy(n.concat(b": ").concat(why))),
    });
  ()
}
