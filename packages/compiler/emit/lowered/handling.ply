//! The handling family's decisions read off the form of programs' text, its parts lowered from
//! hand-built inputs where another family's construct stands in front of them, its framing printed,
//! and a corpus that lowers, checks and prints.

import emit.code (Code, NHandle, NBlock, NApp, NLambda, Lambda, Capture, CodeClause, CodeReturn)
import syntax.parsing (Span, span_between)
import check.resolve.tables (qualify)
import check.types (Type, TyCon, TyRecord, fn_type, row_empty, fields_sorted)
import emit.keys (Named)
import emit.pieces (spelled)
import emit.tir (Rep, RInt, RWord, Var, Arg, AVar, AInt, Prim, Pack, Make, MClosure, Op, OHandle,
                 Uses, Inst, Let, Assign, Return, Handle, Fn, Rooted, Given, Owned, Handling, RFlat,
                 Leaf, Get, Path, PLeaf, Closure, Decl, no_links)
import emit.tir.handling (HandleOp, Perform, Label, Parallel, Simulate)
import emit.lower.setting (Root)
import emit.lower.base (Context, started, emitted, opened)
import emit.lower.calling (context_of)
import emit.lower.handling (label, clause_frame, body_frame, handled, branched, simulated)
import emit.print (printed_fn)
import emit.compare (Program, program_of, formed, checked, printed_by_form, not_built)

fn named(n: Bytes) -> Type = TyCon({ name: n, args: [] })

fn local(id: Int, ty: Type, rep: Rep) -> Var = { id: id, ty: ty, rep: rep }

fn word(id: Int) -> Var = local(id, named(b"String"), RWord)

/// A closure answering `ret`, as the calling family makes one: a word.
fn closure_of(id: Int, ret: Type) -> Var = local(id, fn_type([], ret, row_empty()), RWord)

fn place() -> Span = span_between(3, 9)

fn nowhere() -> Span = span_between(0, 0)

/// The context root `m.<name>` of `p` is lowered in, and its body.
fn rooted(p: Program, name: Bytes) -> Option<{ cx: Context, code: Code }> / {abort.raise} =
  p.roots.fold(None, |acc: Option<{ cx: Context, code: Code }>, r: Root|
    if r.key != Named(qualify(b"m", name)) { acc } else {
      match r.code {
        Err(_) -> acc,
        Ok(code) -> Some({ cx: context_of(p.setting, r, code), code: code }),
      }
    })

/// The `handle` root `m.<name>` of `p` is, and the context it is lowered in.
fn handle_at(
  p: Program,
  name: Bytes,
) -> Option<{ cx: Context, h: { body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> } }> / {abort.raise} =
  match rooted(p, name) {
    None -> None,
    Some(r) -> match handle_of(r.code) { Some(h) -> Some({ cx: r.cx, h: h }), None -> None },
  }

/// The `handle` `c` is, or ends in.
fn handle_of(
  c: Code,
) -> Option<{ body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> }> =
  match c.node {
    NHandle(h) -> Some(h),
    NBlock(b) -> match b.tail {
      Some(t) -> match t.node { NHandle(h) -> Some(h), _ -> None },
      None -> None,
    },
    _ -> None,
  }

/// The operations on effects `body` binds, each with the variable it binds.
fn ops_in(body: List<Inst>) -> List<{ var: Var, op: HandleOp, args: List<Arg>, uses: Uses }> =
  body.fold([], |acc: List<{ var: Var, op: HandleOp, args: List<Arg>, uses: Uses }>, i: Inst|
    match i {
      Let(l) -> match l.val {
        Op(o) -> match o.op {
          OHandle(h) -> acc.push({ var: l.var, op: h, args: o.args, uses: o.uses }),
          _ -> acc,
        },
        _ -> acc,
      },
      _ -> acc,
    })

/// `i` with its source place cleared, for holding a form to one written by hand.
fn placeless(i: Inst) -> Inst = match i { Let(l) -> Let({ ..l, at: nowhere() }), other -> other }

fn performs() -> Bytes =
  Bytes::concat_all([
    b"effect log {\n  write put(n: Int) -> Unit\n}\n",
    b"effect ask {\n  read get() -> Int\n}\n",
    b"effect net {\n  write send[s](payload: Int) -> Unit\n}\n",
    b"fn note(n: Int) -> Unit / {log.put} = log.put(n)\n",
    b"fn asked(n: Int) -> Int / {ask.get} = ask.get() + n\n",
    b"fn sent(n: Int) -> Unit / {net.send[conn]} = net.send[conn](n)\n",
    b"fn relay<[l]>(n: Int) -> Unit / {net.send[l]} = net.send[l](n)\n",
    b"fn raised(m: String) -> Int / {abort.raise} = abort.raise(m)\n",
  ])

test "a perform hands the runtime its arguments as words and holds what the handler answers as its type" {
  match program_of(performs()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let int = named(b"Int");
      let boxed = local(1, int, RWord);
      let answer = local(2, named(b"Unit"), RWord);
      match formed(p, b"note") {
        Err(no) -> assert_eq(no.why, b""),
        Ok(f) ->
          assert_eq(f.body.map(placeless), [
            Let({
              var: boxed,
              val: Pack({ arg: AVar(local(0, int, RInt)), to: RWord }),
              at: nowhere(),
              unwind: [],
            }),
            Let({
              var: answer,
              val: Op({
                op: OHandle(
                  Perform({
                    effect: b"m.log",
                    op: b"put",
                    resource: b"",
                    labelled: false,
                    mode: 1,
                  }),
                ),
                args: [AVar(boxed)],
                uses: { takes: [true], owned: true, fails: true, stops: true },
              }),
              at: nowhere(),
              unwind: [],
            }),
            Return(AVar(answer)),
          ]),
      };
      // The handler's word is held as the `Int` the checker filed for the perform before it is read.
      match formed(p, b"asked") {
        Err(no) -> assert_eq(no.why, b""),
        Ok(f) -> match f.body {
          [Let(o), Let(k), ..] -> {
            assert_eq((o.var.ty, o.var.rep), (int, RWord));
            assert_eq((k.val, k.var.rep), (Pack({ arg: AVar(o.var), to: RInt }), RInt))
          },
          other -> assert_eq(other, []),
        },
      };
      // A resource named where the perform is written is its field-table entry; a label parameter
      // is opened to the entry it holds and leads the operands, which the operation only reads.
      let keyed = |name: Bytes| match formed(p, name) { Ok(f) -> ops_in(f.body), Err(_) -> [] };
      assert_eq(
        keyed(b"sent").map(|o: { var: Var, op: HandleOp, args: List<Arg>, uses: Uses }| o.op),
        [Perform({ effect: b"m.net", op: b"send", resource: b"conn", labelled: false, mode: 1 })],
      );
      match keyed(b"relay") {
        [o] -> {
          assert_eq(
            o.op,
            Perform({ effect: b"m.net", op: b"send", resource: b"", labelled: true, mode: 1 }),
          );
          assert_eq(o.uses.takes, [false, true]);
          assert_eq(o.args.map(|a: Arg| match a { AVar(v) -> v.rep, _ -> RWord }), [RInt, RWord])
        },
        other -> assert_eq(other.len(), 1),
      };
      // A raise is the prelude's, never comes back, and so never stops to be resumed.
      assert_eq(
        keyed(b"raised").map(|o: { var: Var, op: HandleOp, args: List<Arg>, uses: Uses }|
          (o.op, o.uses.stops)),
        [
          (
            Perform({ effect: b"abort", op: b"raise", resource: b"", labelled: false, mode: 2 }),
            false,
          ),
        ],
      )
    },
  }
}

test "a label argument is the resource's field-table entry, an Int no count is kept of" {
  match program_of(performs()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match rooted(p, b"sent") {
      None -> assert(false),
      Some(r) -> {
        let entry = local(0, named(b"Int"), RInt);
        let o = label(r.cx, started([]), b"conn", place());
        assert_eq(o.arg, AVar(entry));
        assert_eq(o.st.insts, [
          Let({
            var: entry,
            val: Op({
              op: OHandle(Label(b"conn")),
              args: [],
              uses: { takes: [], owned: false, fails: false, stops: false },
            }),
            at: place(),
            unwind: [],
          }),
        ])
      },
    },
  }
}

fn handles() -> Bytes =
  Bytes::concat_all([
    b"effect ask {\n  read get() -> Int\n}\n",
    b"effect amb {\n  read flip() -> Bool\n}\n",
    b"effect db {\n  read query[r](q: Int) -> Int\n}\n",
    b"fn asked() -> Int / {db.query[users]} = db.query[users](1)\n",
    b"fn guarded(n: Int) -> Int = handle { ask.get() + n } with { ask.get() -> 1 }\n",
    b"fn both() -> Int = handle { if amb.flip() { 1 } else { 2 } } with { amb.flip() resume k -> k(true) + k(false) }\n",
    b"fn tail_only(n: Int) -> Int = handle { if amb.flip() { n } else { 2 } } with { amb.flip() resume k -> k(true) }\n",
    b"fn twice(n: Int) -> Int = handle { let m = n + 1; if amb.flip() { m } else { 2 } } with { amb.flip() resume k -> k(true) + k(false) }\n",
    b"fn tagged() -> Int = handle { asked() } with { db.query[*t](q) resume k -> k(q) + 1 }\n",
    b"fn once() -> Int = handle { asked() } with { db.query[*t](q) resume k -> k(q) }\n",
  ])

test "a clause resuming in its tail joins its arms as the word it hands back, never opening what its continuation answers" {
  // Called in the tail, the continuation answers what the runtime resumes with, no record.
  let src = Bytes::concat_all([
    b"effect ask {\n  read get(n: Int) -> Int\n}\n",
    b"type R = { a: String, n: Int, m: Int }\n",
    b"fn run(n: Int) -> R = handle { { a: \"x\", n: ask.get(n), m: 0 } } with { ask.get(q) resume k -> if q > 0 { k(q) } else { { a: \"y\", n: 0, m: 0 } } }\n",
  ]);
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match formed(p, b"run") {
      Err(no) -> assert_eq(no.why, b""),
      Ok(f) ->
        assert_eq(
          match f.lambdas.at(0) {
            Some(Closure(c)) ->
              c.body.body.fold([], |a: List<Rep>, i: Inst|
                match i { Decl(v) -> a.push(v.rep), _ -> a }),
            None -> [],
          },
          [RWord],
        ),
    },
  }
}

test "a handle runs its body in place under its clauses' frame and sets its answer as a word" {
  match program_of(handles()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match handle_at(p, b"guarded") {
      None -> assert(false),
      Some(g) -> {
        let int = named(b"Int");
        let n = local(0, int, RInt);
        let clause = closure_of(1, int);
        let made = Let({
          var: clause,
          val: Make({
            made: MClosure({ nth: 0, captures: 0, params: 0, stacked: false }),
            args: [],
            reuse: None,
            kept: [],
          }),
          at: place(),
          unwind: [],
        });
        let outer = emitted({ ..started([n]), next: 2 }, made);
        let sum = local(2, int, RInt);
        let add = Let({
          var: sum,
          val: Prim({ op: b"add", on: RInt, args: [AVar(n), AInt(1)] }),
          at: place(),
          unwind: [],
        });
        let body = { st: { ..emitted(opened(outer), add), next: 3 }, arg: AVar(sum) };
        let o = handled(
          g.cx,
          outer,
          body,
          [{ label: None, closure: AVar(clause) }],
          None,
          g.h,
          place(),
        );
        let boxed = local(3, int, RWord);
        let answer = local(4, int, RWord);
        assert_eq(o.st.refused, None);
        assert_eq(o.st.insts, [
          made,
          Handle({
            body: [
              add,
              Let({
                var: boxed,
                val: Pack({ arg: AVar(sum), to: RWord }),
                at: place(),
                unwind: [],
              }),
              Assign({ var: answer, arg: AVar(boxed) }),
            ],
            args: [AVar(clause)],
            uses: { takes: [true], owned: true, fails: true, stops: false },
            site: {
              clauses: [
                {
                  effect: b"m.ask",
                  op: b"get",
                  resource: b"",
                  mode: 0,
                  binds_label: false,
                  handler: 0,
                  label: None,
                },
              ],
              ret: None,
              detached: None,
            },
            answer: answer,
            unwind: [],
          }),
          Let({
            var: local(5, int, RInt),
            val: Pack({ arg: AVar(answer), to: RInt }),
            at: place(),
            unwind: [],
          }),
        ]);
        // A body that would leave the handle's frame installed is refused.
        let left = { st: emitted(body.st, Return(AVar(sum))), arg: AVar(sum) };
        assert_eq(
          handled(
            g.cx,
            outer,
            left,
            [{ label: None, closure: AVar(clause) }],
            None,
            g.h,
            place(),
          ).st.refused,
          Some({ by: Handling, why: b"a handle body that leaves other than by its end" }),
        )
      },
    },
  }
}

test "a clause resuming off its tail runs the handle's body detached, copying in what it reads from around it" {
  match program_of(handles()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let frame_of = |name: Bytes|
        match handle_at(p, name) { Some(g) -> body_frame(g.cx, g.h), None -> None };
      assert_eq(frame_of(b"tail_only"), None);
      assert_eq(frame_of(b"once"), None);
      // The parameter is copied in at its own slot; the body's own `let` is not.
      match frame_of(b"twice") {
        None -> assert(false),
        Some(f) -> {
          assert_eq((f.params, f.captures), (0, [{ src: 0, dst: 0 }]));
          assert(f.size >= 2)
        },
      };
      // A clause binding the call site's label takes it before its continuation, which it here
      // reads off its tail.
      match handle_at(p, b"tagged") {
        None -> assert(false),
        Some(g) -> {
          assert_eq(g.h.clauses.map(|cl: CodeClause| clause_frame(g.cx, cl).params), [3]);
          assert_eq(
            match body_frame(g.cx, g.h) { Some(f) -> Some(f.captures.len()), None -> None },
            Some(0),
          )
        },
      };
      // The detached body is a closure the handle takes after its clauses'.
      match handle_at(p, b"both") {
        None -> assert(false),
        Some(g) -> {
          let int = named(b"Int");
          let clause = closure_of(0, int);
          let inner = closure_of(1, int);
          let outer = { ..started([]), next: 1 };
          let o = handled(
            g.cx,
            outer,
            { st: { ..outer, next: 2 }, arg: AVar(inner) },
            [{ label: None, closure: AVar(clause) }],
            None,
            g.h,
            place(),
          );
          let answer = local(2, int, RWord);
          assert_eq(o.st.insts, [
            Handle({
              body: [],
              args: [AVar(clause), AVar(inner)],
              uses: { takes: [true, true], owned: true, fails: true, stops: false },
              site: {
                clauses: [
                  {
                    effect: b"m.amb",
                    op: b"flip",
                    resource: b"",
                    mode: 2,
                    binds_label: false,
                    handler: 0,
                    label: None,
                  },
                ],
                ret: None,
                detached: Some(1),
              },
              answer: answer,
              unwind: [],
            }),
            Let({
              var: local(3, int, RInt),
              val: Pack({ arg: AVar(answer), to: RInt }),
              at: place(),
              unwind: [],
            }),
          ])
        },
      }
    },
  }
}

fn blocks() -> Bytes =
  Bytes::concat_all([
    b"effect meter {\n  read level() -> Int\n}\n",
    b"fn reads() -> (Int, Int) / {meter.level} = parallel { meter.level(), meter.level() }\n",
    b"fn open<| e>(g: () -> Int / e) -> (Int, Int) / e = parallel { g(), 1 }\n",
    b"fn pure(n: Int) -> (Int, Int) = parallel { n + 1, n + 2 }\n",
    b"fn ticked() -> Int / {abort.raise, sim.read} = simulate { 1 }\n",
  ])

test "a parallel block hands the runtime its branches and tells it its definition's row where that row is closed" {
  match program_of(blocks()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let int = named(b"Int");
      let branches = [AVar(closure_of(0, int)), AVar(closure_of(1, int))];
      let ran = |name: Bytes, own: Bool|
        match rooted(p, name) {
          None -> [],
          Some(r) ->
            ops_in(branched(r.cx, { ..started([]), next: 2 }, branches, own, place()).st.insts),
        };
      match ran(b"reads", true) {
        [o] -> {
          assert_eq(o.op, Parallel({ reach: Some([{ effect: b"m.meter", resource: None }]) }));
          assert_eq((o.var.ty, o.var.rep), (
            TyRecord(fields_sorted([{ name: b"_0", ty: int }, { name: b"_1", ty: int }])),
            RWord,
          ));
          assert_eq((o.args, o.uses), (
            branches,
            { takes: [true, true], owned: true, fails: true, stops: true },
          ))
        },
        other -> assert_eq(other.len(), 1),
      };
      let told = |name: Bytes, own: Bool|
        ran(name, own).map(|o: { var: Var, op: HandleOp, args: List<Arg>, uses: Uses }| o.op);
      // A row left open says nothing; a definition that performs nothing says so.
      assert_eq(told(b"open", true), [Parallel({ reach: None })]);
      assert_eq(told(b"pure", true), [Parallel({ reach: Some([]) })]);
      // A block outside its definition's own body is told nothing.
      assert_eq(told(b"reads", false), [Parallel({ reach: None })])
    },
  }
}

test "a simulate hands the runtime its body's closure and holds what the body answers as its type" {
  match program_of(blocks()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match rooted(p, b"ticked") {
      None -> assert(false),
      Some(r) -> {
        let int = named(b"Int");
        let body = closure_of(0, int);
        let answer = local(1, int, RWord);
        assert_eq(simulated(r.cx, { ..started([]), next: 1 }, AVar(body), place()).st.insts, [
          Let({
            var: answer,
            val: Op({
              op: OHandle(Simulate),
              args: [AVar(body)],
              uses: { takes: [true], owned: true, fails: true, stops: true },
            }),
            at: place(),
            unwind: [],
          }),
          Let({
            var: local(2, int, RInt),
            val: Pack({ arg: AVar(answer), to: RInt }),
            at: place(),
            unwind: [],
          }),
        ])
      },
    },
  }
}

/// Root `m.<name>` over `params`, each given, answering a word.
fn fn_of(name: Bytes, params: List<Var>, body: List<Inst>) -> Fn =
  {
    key: Named(qualify(b"m", name)),
    kind: Rooted,
    params: params,
    conv: {
      params: params.map(|_: Var| Given),
      reps: params.map(|v: Var| v.rep),
      answer: RWord,
      answered: Owned,
    },
    body: body,
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  }

fn op_let(v: Var, op: HandleOp, args: List<Arg>) -> Inst =
  Let({
    var: v,
    val: Op({
      op: OHandle(op),
      args: args,
      uses: { takes: args.map(|_: Arg| true), owned: true, fails: true, stops: true },
    }),
    at: place(),
    unwind: [],
  })

test "a handle's body runs in a block between the frame's push and its landing, where a failure inside it goes" {
  let int = named(b"Int");
  let n = local(0, int, RInt);
  let clause = word(1);
  let sum = local(2, int, RInt);
  let boxed = word(3);
  let answer = word(4);
  let asked = {
    effect: b"m.ask",
    op: b"get",
    resource: b"",
    mode: 0,
    binds_label: false,
    handler: 0,
    label: None,
  };
  let printed = printed_fn(
    fn_of(b"guarded", [n, clause], [
      Handle({
        body: [
          Let({
            var: sum,
            val: Prim({ op: b"add", on: RInt, args: [AVar(n), AInt(1)] }),
            at: span_between(10, 15),
            unwind: [],
          }),
          Let({ var: boxed, val: Pack({ arg: AVar(sum), to: RWord }), at: place(), unwind: [] }),
          Assign({ var: answer, arg: AVar(boxed) }),
        ],
        args: [AVar(clause)],
        uses: { takes: [true], owned: true, fails: true, stops: false },
        site: { clauses: [asked], ret: None, detached: None },
        answer: answer,
        unwind: [],
      }),
      Return(AVar(answer)),
    ]),
  );
  let text = spelled(printed.pieces);
  assert(
    text.index_of(
        b"  Word t1 = 0;\n  Word t2[] = {@@f0@@, -1, @@f1@@, p1, 0, 0};\n  int64_t t3 = rt_handle_push_p(ctx, (Word)(intptr_t)t2, 1, 0);\n  {\n",
      )
      != None,
  );
  assert(text.index_of(b"rt_overflow_p(ctx, 0); goto ply_h0; }") != None);
  assert(text.index_of(b"\n    t1 = t") != None);
  // The landing pops the frame and reads what the handle answers, which is what the root returns.
  let lead = b"  }\n  ply_h0: ;\n  Word ";
  match text.index_of(lead) {
    None -> assert(false),
    Some(from) -> {
      let rest = text.slice(from + lead.len(), text.len());
      match rest.index_of(b" = ") {
        None -> assert(false),
        Some(eq) ->
          assert_eq(
            rest.index_of(
              Bytes::concat_all([
                b" = rt_handle_land_p(ctx, t3, t1);\n  if (ctx->failed) return 0;\n  ctx->fuel += 1;\n  return ",
                rest.slice(0, eq),
                b";\n",
              ]),
            ),
            Some(eq),
          ),
      }
    },
  };
  assert_eq((printed.fields, printed.handles), ([b"m.ask", b"get"], [b"m.ask#get"]));
  // Detached, the handle is one call of the runtime's, its body's closure last.
  let alone = spelled(
    printed_fn(
      fn_of(b"both", [clause, word(5)], [
        Handle({
          body: [],
          args: [AVar(clause), AVar(word(5))],
          uses: { takes: [true, true], owned: true, fails: true, stops: false },
          site: { clauses: [{ ..asked, mode: 2 }], ret: None, detached: Some(1) },
          answer: answer,
          unwind: [],
        }),
        Return(AVar(answer)),
      ]),
    ).pieces,
  );
  assert(
    alone.index_of(
        b"  Word t1[] = {@@f0@@, -1, @@f1@@, p0, 2, 0};\n  Word t2 = rt_handle_detached_p(ctx, (Word)(intptr_t)t1, 1, 0, p1);\n  if (ctx->failed) return 0;\n  ctx->fuel += 1;\n  return t2;\n",
      )
      != None,
  );
  assert_eq(alone.index_of(b"ply_h0"), None)
}

test "a perform's words go to the runtime in an array, its effect, operation and resource by their entries" {
  let entry = local(0, named(b"Int"), RInt);
  let printed = printed_fn(
    fn_of(b"sends", [entry, word(1)], [
      Let({
        var: word(2),
        val: Op({
          op: OHandle(
            Perform({ effect: b"m.net", op: b"send", resource: b"", labelled: true, mode: 1 }),
          ),
          args: [AVar(entry), AVar(word(1))],
          uses: { takes: [false, true], owned: true, fails: true, stops: true },
        }),
        at: place(),
        unwind: [],
      }),
      op_let(
        word(3),
        Perform({ effect: b"m.net", op: b"send", resource: b"conn", labelled: false, mode: 1 }),
        [],
      ),
      op_let(
        word(4),
        Perform({ effect: b"m.net", op: b"close", resource: b"", labelled: false, mode: 1 }),
        [],
      ),
      Let({
        var: local(5, named(b"Int"), RInt),
        val: Op({
          op: OHandle(Label(b"conn")),
          args: [],
          uses: { takes: [], owned: false, fails: false, stops: false },
        }),
        at: place(),
        unwind: [],
      }),
      Return(AVar(word(4))),
    ]),
  );
  let text = spelled(printed.pieces);
  assert(
    text.index_of(
        b"  Word t1[] = {p1};\n  PLY_SITE(ctx, @@r@@, 3, 9);\n  Word t2 = rt_perform_p(ctx, @@f0@@, @@f1@@, p0, 1, (Word)(intptr_t)t1, 1);\n  if (ctx->failed) return 0;\n",
      )
      != None,
  );
  assert(
    text.index_of(
        b"  Word t3[] = {0};\n  PLY_SITE(ctx, @@r@@, 3, 9);\n  Word t4 = rt_perform_p(ctx, @@f0@@, @@f1@@, @@f2@@, 1, (Word)(intptr_t)t3, 0);\n",
      )
      != None,
  );
  assert(
    text.index_of(b"rt_perform_p(ctx, @@f0@@, @@f3@@, -1, 1, (Word)(intptr_t)t5, 0);") != None,
  );
  assert(text.index_of(b"  int64_t t7 = @@f2@@;\n") != None);
  assert_eq(printed.fields, [b"m.net", b"send", b"conn", b"close"]);
  assert_eq(printed.performs, [b"m.net#send", b"m.net#send", b"m.net#close"])
}

test "a parallel block's answers are made its tuple in the order its fields' names sort" {
  let branches = range(0, 11).map(word);
  let printed = printed_fn(
    fn_of(b"many", branches, [
      op_let(word(11), Parallel({ reach: None }), branches.map(|v: Var| AVar(v))),
      Return(AVar(word(11))),
    ]),
  );
  let text = spelled(printed.pieces);
  assert(
    text.index_of(
        b"  Word t1[] = {p0, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10};\n  PLY_SITE(ctx, @@r@@, 3, 9);\n  rt_parallel_p(ctx, (Word)(intptr_t)t1, 11);\n  if (ctx->failed) return 0;\n",
      )
      != None,
  );
  assert(
    text.index_of(
        b"  Word t2[] = {t1[0], t1[1], t1[10], t1[2], t1[3], t1[4], t1[5], t1[6], t1[7], t1[8], t1[9]};\n  Word t3 = rt_record_p(ctx, @@s0@@, (Word)(intptr_t)t2, 11);\n",
      )
      != None,
  );
  assert_eq(printed.shapes.map(|s: List<Bytes>| s.take(3)), [[b"_0", b"_1", b"_10"]]);
  // Told the definition's row, the runtime reads each effect and resource it names by its entry.
  let reach = [
    { effect: b"m.meter", resource: None },
    { effect: b"m.net", resource: Some(b"conn") },
  ];
  let told = spelled(
    printed_fn(
      fn_of(b"told", [word(0), word(1)], [
        op_let(word(2), Parallel({ reach: Some(reach) }), [AVar(word(0)), AVar(word(1))]),
        op_let(word(3), Parallel({ reach: Some([]) }), [AVar(word(0)), AVar(word(1))]),
        Return(AVar(word(2))),
      ]),
    ).pieces,
  );
  assert(
    told.index_of(
        b"  Word t1[] = {p0, p1};\n  Word t2[] = {@@f0@@, -1, @@f1@@, @@f2@@};\n  PLY_SITE(ctx, @@r@@, 3, 9);\n  rt_parallel_past_p(ctx, (Word)(intptr_t)t1, 2, (Word)(intptr_t)t2, 2);\n",
      )
      != None,
  );
  assert(
    told.index_of(
        b"  Word t6[] = {0};\n  PLY_SITE(ctx, @@r@@, 3, 9);\n  rt_parallel_past_p(ctx, (Word)(intptr_t)t5, 2, (Word)(intptr_t)t6, 0);\n",
      )
      != None,
  )
}

test "a simulate hands the runtime its body and answers every operation a region schedules" {
  let printed = printed_fn(
    fn_of(b"ticked", [word(0)], [
      op_let(word(1), Simulate, [AVar(word(0))]),
      Return(AVar(word(1))),
    ]),
  );
  assert(
    spelled(printed.pieces).index_of(
        b"  PLY_SITE(ctx, @@r@@, 3, 9);\n  Word t1 = rt_simulate_p(ctx, p0);\n  if (ctx->failed) return 0;\n",
      )
      != None,
  );
  assert_eq(printed.handles.len(), 8);
  assert(printed.handles.contains(b"task#spawn") && printed.handles.contains(b"sim#seed"))
}

fn corpus() -> Bytes =
  Bytes::concat_all([
    b"effect log {\n  write put(n: Int) -> Unit\n  write say(s: String) -> Unit\n  read ping() -> Unit\n}\n",
    b"effect ask {\n  read get() -> Int\n}\n",
    b"effect amb {\n  read flip() -> Bool\n}\n",
    b"effect net {\n  write send[s](payload: Int) -> Unit\n}\n",
    b"effect link {\n  write send[s](payload: Int) -> Int\n}\n",
    b"effect meter {\n  read level() -> Int\n}\n",
    b"effect tally {\n  write add(n: Int) -> Unit\n  read total() -> Int\n}\n",
    b"fn note(n: Int) -> Unit / {log.put} = log.put(n)\n",
    b"fn told(s: String) -> Unit / {log.say} = log.say(s)\n",
    b"fn pinged() -> Unit / {log.ping} = log.ping()\n",
    b"fn asked(n: Int) -> Int / {ask.get} = ask.get() + n\n",
    b"fn sent(n: Int) -> Unit / {net.send[conn]} = net.send[conn](n)\n",
    b"fn relay<[l]>(n: Int) -> Unit / {net.send[l]} = net.send[l](n)\n",
    b"fn driven(n: Int) -> Unit / {net.send[conn]} = relay[conn](n)\n",
    b"fn raised(m: String) -> Int / {abort.raise} = abort.raise(m)\n",
    b"fn answered(n: Int) -> Int = handle { ask.get() + n } with { ask.get() -> n * 2 }\n",
    b"fn keyed(x: Int) -> Int = handle { link.send[conn](x) } with { link.send[conn](p) -> p + 1 }\n",
    b"fn forward<[l]>(x: Int) -> Int / {link.send[l]} = link.send[l](x)\n",
    b"fn labelled(x: Int) -> Int = handle { forward[conn](x) } with { link.send[conn](p) -> p + 1 }\n",
    b"fn every(x: Int) -> Int = handle { forward[conn](x) + forward[up](x) } with { link.send[*](p) -> p + 1 }\n",
    b"fn caught(n: Int) -> Result<Int, String> = handle { if n > 0 { n } else { abort.raise(\"low\") } } with { abort.raise(m) -> Err(m), return v -> Ok(v) }\n",
    b"fn nested() -> Int = handle { handle { ask.get() } with { abort.raise(m) -> 0 } } with { ask.get() -> 7 }\n",
    b"fn tailed() -> Int = handle { if amb.flip() { 1 } else { 2 } } with { amb.flip() resume k -> k(true) }\n",
    b"fn both() -> Int = handle { if amb.flip() { 1 } else { 2 } } with { amb.flip() resume k -> k(true) + k(false) }\n",
    b"fn tagged(x: Int) -> Int = handle { forward[conn](x) } with { link.send[*t](p) -> p + 1 }\n",
    b"fn mapped(n: Int) -> Int = handle { ask.get() + n } with { ask.get() -> 1, return v -> v * 10 }\n",
    b"fn counted() -> Int = handle { tally.add(1); tally.add(2); tally.total() } with { var n = 0, tally.add(k) -> { n = n + k; }, tally.total() -> n }\n",
    b"fn pair(n: Int) -> (Int, Int) = parallel { n + 1, n + 2 }\n",
    b"fn reads() -> (Int, Int) / {meter.level} = parallel { meter.level(), meter.level() }\n",
    b"fn summed(n: Int) -> Int = { let (a, b) = parallel { n + 1, n + 2 }; a + b }\n",
    b"fn ticked() -> Int / {abort.raise, sim.read} = simulate { 1 }\n",
    b"fn clocked() -> Instant / {abort.raise, sim.read} = simulate { clock.now() }\n",
    b"fn drawn() -> Int / {abort.raise, sim.read} = simulate { random.below(6) }\n",
    b"fn spawned() -> Int / {abort.raise, sim.read} = simulate { let t = task.spawn(|| 1 + 2); task.join(t) }\n",
    b"fn yielded() -> Int / {abort.raise, sim.read} = simulate { task.yield(); 1 }\n",
    b"fn chan() -> Int / {abort.raise, sim.read} = simulate { let c = task.channel(1); task.send(c, 5); match task.recv(c) { Some(v) -> v, None -> 0 } }\n",
    b"fn shut() -> Bool / {abort.raise, sim.read} = simulate { let c: Chan<Int> = task.channel(1); task.close(c); task.send(c, 1) }\n",
    b"fn cancelled() -> Bool / {abort.raise, sim.read} = simulate { let t = task.spawn(|| 1); task.cancel(t) }\n",
    b"fn awaited() -> Option<Int> / {abort.raise, sim.read} = simulate { let t = task.spawn(|| 1); task.await(t) }\n",
    b"fn selected() -> Int / {abort.raise, sim.read} = simulate { let c = task.channel(1); task.send(c, 3); match task.select([(c, None)], false) { Some((i, _)) -> i, None -> 0 - 1 } }\n",
    b"fn release(_: Int) -> Unit = ()\n",
    b"fn held(n: Int) -> Int = with_hold[t](n, release) { c -> c.get() }\n",
    b"fn bracketed(n: Int) -> Int = bracket(|| n, release, |x: Int| x + 1)\n",
    b"effect fail {\n  raise bad(why: String)\n  raise far(at: Int, why: String)\n}\n",
    b"fn tried(n: Int) -> Result<Int, String> = try { if n > 0 { n } else { fail.bad(\"low\") } }\n",
    b"fn tried_far(n: Int) -> Int = match try { if n > 0 { n } else { fail.far(n, \"low\") } } { Ok(v) -> v, Err(e) -> e._0 }\n",
  ])

/// The corpus's roots the form lowers and checks: every construct of the family, under the
/// effects, `parallel`, region, task, channel, cancellation and select tests' shapes.
fn lowers() -> List<Bytes> =
  [
    b"note",
    b"told",
    b"pinged",
    b"asked",
    b"sent",
    b"relay",
    b"driven",
    b"raised",
    b"answered",
    b"keyed",
    b"labelled",
    b"every",
    b"caught",
    b"nested",
    b"tailed",
    b"both",
    b"tagged",
    b"mapped",
    b"summed",
    b"pair",
    b"reads",
    b"ticked",
    b"clocked",
    b"drawn",
    b"spawned",
    b"yielded",
    b"chan",
    b"shut",
    b"cancelled",
    b"awaited",
    b"selected",
    b"bracketed",
    b"counted",
    b"held",
    b"tried",
    b"tried_far",
  ]

test "every root of the handling corpus lowers, passes the check and prints" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> assert_eq(not_built(p, lowers()), []),
  }
}

/// How many times `s` stands in `t`.
fn occurrences(t: Bytes, s: Bytes) -> Int / {abort.raise} = t.split(s).len() - 1

fn landings() -> Bytes =
  Bytes::concat_all([
    b"effect ask {\n  read get() -> Int\n}\n",
    b"fn halved(a: Int, b: Int) -> Int / {abort.raise} = a / b\n",
    b"fn guarded(n: Int) -> Int = handle { ask.get() + halved(n, n) + (0 - n) * (n << 3) } with { abort.raise(m) -> 0, ask.get() -> 1 }\n",
  ])

test "a body that fails inside a handle leaves by the handle's landing, whatever failed" {
  match program_of(landings()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match printed_by_form(p, b"guarded") {
      Err(why) -> assert_eq(why, b""),
      Ok(t) -> match t.index_of(b"rt_handle_push_p(") {
        None -> assert(false),
        Some(from) -> match t.index_of(b"ply_h0: ;") {
          None -> assert(false),
          Some(to) -> {
            let body = t.slice(from, to);
            // The perform, the call and each checked operator go to the landing; nothing returns.
            assert_eq(body.index_of(b"return"), None);
            assert(occurrences(body, b"goto ply_h0;") >= 6)
          },
        },
      },
    },
  }
}

fn rows() -> Bytes =
  Bytes::concat_all([
    b"effect meter {\n  read level() -> Int\n}\n",
    b"fn pure(n: Int) -> (Int, Int) = parallel { n + 1, n + 2 }\n",
    b"fn reads() -> (Int, Int) / {meter.level} = parallel { meter.level(), meter.level() }\n",
    b"fn under() -> (Int, Int) = handle { parallel { meter.level(), meter.level() } } with { meter.level() -> 0 }\n",
    b"fn open<| e>(g: () -> Int / e) -> (Int, Int) / e = parallel { g(), 1 }\n",
  ])

test "a parallel block tells the runtime its definition's row only where that row holds all its branches reach" {
  match program_of(rows()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let calls = |helper: Bytes|
        [b"pure", b"reads", b"under", b"open"].map(|n: Bytes|
          match printed_by_form(p, n) {
            Ok(t) -> Ok(t.index_of(helper) != None),
            Err(why) -> Err(why),
          });
      // A block under a `handle`, or in a definition whose row is left open, is told nothing.
      assert_eq(calls(b"rt_parallel_past_p(ctx, "), [Ok(true), Ok(true), Ok(false), Ok(false)]);
      assert_eq(calls(b"rt_parallel_p(ctx, "), [Ok(false), Ok(false), Ok(true), Ok(true)])
    },
  }
}

fn records() -> Bytes =
  Bytes::concat_all([
    b"type P = { x: Int, y: Int }\n",
    b"effect store {\n  read held() -> P\n  write keep(p: P) -> Int\n}\n",
    b"fn summed() -> Int / {store.held} = { let p = store.held(); p.x + p.y }\n",
    b"fn kept(start: P) -> Int = handle { store.keep(start) } with { store.keep(p) -> p.x + p.y }\n",
  ])

/// The paths `body` reads out of `of`, in order.
fn reads_of(body: List<Inst>, of: Var) -> List<Path> =
  body.fold([], |acc: List<Path>, i: Inst|
    match i {
      Let(l) -> match l.val {
        Get(g) -> if g.of.id == of.id { acc.push(g.path) } else { acc },
        _ -> acc,
      },
      _ -> acc,
    })

test "what an operation answers and what its clause is handed are held as their types and read leaf by leaf" {
  match program_of(records()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      match formed(p, b"summed") {
        Err(no) -> assert_eq(no.why, b""),
        Ok(f) -> match ops_in(f.body) {
          [o] -> assert_eq(match o.var.ty { TyRecord(fs) -> fs.len(), _ -> 0 }, 2),
          other -> assert_eq(other.len(), 1),
        },
      };
      // The clause's closure takes the record the operation is handed as its leaves, and reads
      // each field off its leaf.
      match checked(p, b"kept") {
        Err(why) -> assert_eq(why, b""),
        Ok(f) -> match f.lambdas.at(0) {
          Some(Closure(c)) -> match c.body.params.at(c.captures) {
            None -> assert(false),
            Some(handed) -> {
              assert_eq(match handed.ty { TyRecord(fs) -> fs.len(), _ -> 0 }, 2);
              assert_eq(
                match handed.rep { RFlat(ls) -> Some(ls.map(|l: Leaf| l.rep)), _ -> None },
                Some([RInt, RInt]),
              );
              assert_eq(reads_of(c.body.body, handed), [PLeaf(0), PLeaf(1)])
            },
          },
          None -> assert(false),
        },
      };
      // Neither reads a field by its name at run time.
      assert_eq(
        [b"summed", b"kept"].map(|n: Bytes|
          match printed_by_form(p, n) {
            Ok(t) -> Ok(t.index_of(b"rt_field_p")),
            Err(why) -> Err(why),
          }),
        [Ok(None), Ok(None)],
      )
    },
  }
}

fn steps() -> Bytes =
  Bytes::concat_all([
    b"effect ask {\n  read get() -> Int\n}\n",
    b"fn stepped(k: Int, n: Int, pad: Int) -> Int / {abort.raise} = iterate(k, n + pad, |s: Int| handle { let y = ask.get(); if s + y >= n { Stop(s) } else { Continue(s + y) } } with { ask.get() resume r -> { let v = r(1); v } })\n",
  ])

/// The lambda a call hands as an argument in `c`, where `c` is one.
fn lambda_handed(c: Code) -> Option<Lambda> =
  match c.node {
    NApp(a) ->
      a.args.fold(None, |acc: Option<Lambda>, x: Code|
        match acc { Some(_) -> acc, None -> match x.node { NLambda(l) -> Some(l), _ -> None } }),
    NBlock(b) -> match b.tail { Some(t) -> lambda_handed(t), None -> None },
    _ -> None,
  }

test "a step iterate runs in place copies into a detached handle's body only slots the step's frame holds" {
  match program_of(steps()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match rooted(p, b"stepped") {
      None -> assert(false),
      Some(r) -> match lambda_handed(r.code) {
        None -> assert(false),
        Some(l) -> match handle_of(l.body) {
          None -> assert(false),
          Some(h) -> match body_frame(r.cx, h) {
            None -> assert(false),
            Some(f) -> {
              let own = range(0, l.params).concat(l.captures.map(|c: Capture| c.dst));
              // The step's parameter and the bound it captures; its own `let` is the body's.
              assert_eq(f.captures.len(), 2);
              assert(f.captures.all(|c: Capture| own.contains(c.src) && c.dst == c.src))
            },
          },
        },
      },
    },
  }
}
