//! The calling family's programs lowered through the form: calls of definitions, generic calls,
//! closures, function values, bodies run in place, steps and tail groups.

import check.resolve.tables (qualify)
import check.types (Type, TyCon, int_type, bool_type)
import emit.keys (RootKey, FnArg, Named, Root, Generic, LawPart, LawGuard, LawBody, at_key,
                  RootName, root_name, root_text, filed_as, test_key, law_key)
import emit.reps (filings_at, BoundLambda, has_vars)
import emit.typing (no_filings, unknown_type)
import emit.tir (Rep, RInt, RBool, RWord, RFlat, RSum, RSlice, MCase, Var, Arg, AVar, AInt, Val,
                 Call, Apply, Make, Get, Pack, Gathered, Prim, Native, Op, OCalling, OContainer,
                 MClosure, PCapture, TTag, Inst, Let, Do, If, Case, Match, Loop, Next, Done,
                 Restart, Enter, Return, Sited, Block, Fn, Member, Closure, Declined, Family, Spine,
                 Data, Calling, Matching, Handling, Scalars, Containers, RNum, TInt, TRange,
                 Convention, Lambda, Lent, Given, Plain, rep_of_arg)
import emit.tir.calling (ConstantRead, Ticked)
import emit.tir.containers (Rest)
import emit.lower (lowered_fn, lowered_group)
import emit.lower.base (GroupMember)
import emit.lower.calling (known_body, lambdas_of, context_of)
import emit.answer (GenericCall, settled_by_callers)
import emit.entry (built_form)
import emit.own (owned)
import emit.verify (verified)
import emit.roots (symbol_of)
import emit.compare (Program, program_of, printed_text, unbuilt, answered_by_form)
import emit.lower.held (passing, ByReference, values_of)
import emit.print.made (head_types)
import emit.print.counting (rel_int_fn, free_fn, call_text)

fn corpus() -> Bytes =
  Bytes::concat_all([
    b"fn add(a: Int, b: Int) -> Int = a + b\n",
    b"fn twice(x: Int) -> Int = add(x, x)\n",
    b"fn same(s: String) -> String = s\n",
    b"fn handed(s: String) -> String = same(s)\n",
    b"fn ident<T>(x: T) -> T = x\n",
    b"fn ident_int(x: Int) -> Int = ident(x)\n",
    b"fn ident_word(s: String) -> String = ident(s)\n",
    b"fn adder(x: Int) -> (Int) -> Int = |y: Int| y + x\n",
    b"fn captor(c: { items: List<Int>, at: Int }) -> () -> Int = || c.at + c.items.len()\n",
    b"fn wide_captor(c: { a: Int, b: Int, c: Int, d: Int, e: Int }) -> () -> Int = || c.a + c.e\n",
    b"fn doubler() -> (Int) -> Int = |y: Int| y * 2\n",
    b"fn named() -> (Int, Int) -> Int = add\n",
    b"fn nested(x: Int) -> (Int) -> (Int) -> Int = |y: Int| |z: Int| x + y + z\n",
    b"fn applied(f: (Int) -> Int, x: Int) -> Int = f(x)\n",
    b"fn applied_word(f: (String) -> String, s: String) -> String = f(s)\n",
    b"fn local(x: Int) -> Int = { let f = |y: Int| y + x; f(1) }\n",
    b"fn count(n: Int) -> Int = if n <= 0 { 0 } else { count(n - 1) }\n",
    b"fn counter() -> (Int) -> Int = |y: Int| count(y)\n",
    b"fn kept() -> Int = 42\n",
    b"fn read_kept(x: Int) -> Int = kept() + x\n",
    b"fn apply_to<T>(f: (T) -> T, x: T) -> T = f(x)\n",
    b"fn lends(x: Int) -> Int = apply_to(|y: Int| y + x, x)\n",
    b"fn steps(n: Int) -> Int / {abort.raise} = iterate(0, n, |i: Int| if i >= 10 { Stop(i) } else { Continue(i + 1) })\n",
    b"fn count_down(n: Int) -> Int / {abort.raise} = iterate(n, 100, |k: Int| match k { m if m <= 0 -> Stop(m), m -> Continue(m - 1) })\n",
    b"fn step_of(i: Int) -> Iter<Int, Int> = if i >= 10 { Stop(i) } else { Continue(i + 1) }\n",
    b"fn stepped(n: Int, k: Int) -> Int / {abort.raise} = iterate(0, n, |i: Int| step_of(i + k))\n",
    b"fn even(n: Int) -> Bool / {diverges} = if n == 0 { true } else { odd(n - 1) }\n",
    b"fn odd(n: Int) -> Bool / {diverges} = if n == 0 { false } else { even(n - 1) }\n",
    b"fn pair(a: Int, b: Int) -> { x: Int, y: Int } = { x: a, y: b }\n",
    b"fn swapped(p: { x: Int, y: Int }) -> { x: Int, y: Int } = pair(p.y, p.x)\n",
    b"fn summed(a: Int) -> Int = { let p = swapped(pair(a, 1)); p.x + p.y }\n",
    b"fn lends_word(s: String) -> String = apply_to(|y: String| s, s)\n",
    b"fn pair_summer() -> ({ x: Int, y: Int }) -> Int = |p: { x: Int, y: Int }| p.x + p.y\n",
    b"fn applied_pair(f: ({ x: Int, y: Int }) -> Int, a: Int) -> Int = f(pair(a, a))\n",
    b"fn walk(p: { x: Int, y: Int }, n: Int) -> { x: Int, y: Int } / {diverges} = if n == 0 { p } else { stride(pair(p.y, p.x), n - 1) }\n",
    b"fn stride(p: { x: Int, y: Int }, n: Int) -> { x: Int, y: Int } / {diverges} = if n == 0 { p } else { walk(p, n - 1) }\n",
    b"fn seek(o: Option<{ x: Int, y: Int }>, n: Int) -> Option<{ x: Int, y: Int }> / {diverges} = if n == 0 { o } else { probe(o, n - 1) }\n",
    b"fn probe(o: Option<{ x: Int, y: Int }>, n: Int) -> Option<{ x: Int, y: Int }> / {diverges} = if n == 0 { o } else { seek(o, n - 2) }\n",
    b"fn lends_on(x: Int) -> Int = apply_to(|y: Int| { let g = |z: Int| z + x; g(y) + applied(|w: Int| w + y, y) }, x)\n",
    b"fn raised_step(n: Int) -> Int / {abort.raise} = iterate(0, n, |i: Int| { let next = if i >= 10 { Stop(i) } else { Continue(i + 1) }; if i == 5 { abort.raise(\"five\") } else { () }; next })\n",
    b"fn paired_step(n: Int) -> Int / {abort.raise} = iterate(pair(0, 1), n, |q: { x: Int, y: Int }| if q.x >= 10 { Stop(q.x + q.y) } else { Continue(pair(q.y, q.x + q.y)) })\n",
    b"fn walk1(p: { x: Int, y: Int }, n: Int) -> { x: Int, y: Int } = if n <= 0 { p } else { walk1(pair(p.y, p.x), n - 1) }\n",
    b"fn go<T>(x: T, n: Int) -> Int = if n <= 0 { 0 } else { go(x, n - 1) }\n",
    b"effect amb {\n  read flip() -> Bool\n}\n",
    b"effect gauge {\n  read level() -> Float\n}\n",
    b"fn tailed() -> Int = handle { if amb.flip() { 1 } else { 2 } } with { amb.flip() resume k -> k(true) }\n",
    b"fn gauged() -> Float = handle { gauge.level() + 1.0 } with { gauge.level() resume k -> k(1.5) }\n",
    b"fn both() -> Int = handle { if amb.flip() { 1 } else { 2 } } with { amb.flip() resume k -> k(true) + k(false) }\n",
    b"fn ping(n: Int) -> Int / {diverges} = if n == 0 { 0 } else { pong(n - 1) }\n",
    b"fn pong(n: Int) -> Int / {diverges} = if n == 0 { let f = |x: Int| x * n; f(2) } else { ping(n - 1) }\n",
    b"fn chooser(whole: Bool) -> (Int) -> Int = |y: Int| if whole { y } else { 0 - y }\n",
    b"fn guarded(whole: Bool) -> (Int) -> Int = |y: Int| match y { n if whole -> n, n -> 0 - n }\n",
    b"fn either(whole: Bool) -> (Int) -> Bool = |y: Int| whole && y > 0\n",
    b"fn picked(whole: Bool) -> (Int) -> Int = |y: Int| match whole { true -> y, false -> 0 - y }\n",
    b"fn walked_to(xs: List<Int>, from: Int) -> Int / {abort.raise} = iterate(from, 100, |i: Int| match xs.at(i) { Some(x) -> if x > 0 { Continue(i + 1) } else { Stop(i) }, None -> Stop(i) })\n",
    b"fn has(xs: List<Int>, x: Int) -> Bool = match xs { [] -> false, [y, ..rest] -> if y == x { true } else { has(rest, x) } }\n",
    b"fn pair_sums(xs: List<Int>, acc: Int) -> Int = match xs { [a, b, ..rest] -> pair_sums(rest, acc + a * b), [a] -> acc + a, [] -> acc }\n",
    b"fn lengths(xs: List<Int>, acc: List<Int>) -> List<Int> = match xs { [] -> acc, [_, ..rest] -> lengths(rest, acc.push(rest.len())) }\n",
    b"fn again(xs: List<Int>, n: Int, acc: Int) -> Int = match xs { [] -> if n > 0 { again([7, 8], n - 1, acc) } else { acc }, [_, ..rest] -> again(rest, n, acc + 1) }\n",
    b"fn tail_of(xs: List<Int>, n: Int) -> List<Int> = match xs { [] -> [], [y, ..rest] -> if y == n { rest } else { tail_of(rest, n) } }\n",
    b"fn rest_lens(xs: List<Int>, n: Int) -> List<Int> = match xs { [] -> [], [y, ..rest] -> if y == n { [0].map(|_: Int| rest.len()) } else { rest_lens(rest, n) } }\n",
    b"fn total(xs: List<Int>) -> Int = match xs { [] -> 0, [y, ..rest] -> y + total(rest) }\n",
    b"fn widen(n: Int) -> { a: Int, b: Int, c: Int, d: Int, e: Int } = { a: n, b: n + 1, c: n, d: n, e: n }\n",
    b"fn wide_sum(w: { a: Int, b: Int, c: Int, d: Int, e: Int }) -> Int = w.a + w.e\n",
    b"fn wide_twice(n: Int) -> Int = wide_sum(widen(n))\n",
    b"fn wide_loop(w: { a: Int, b: Int, c: Int, d: Int, e: Int }, n: Int) -> Int = if n <= 0 { w.a } else { wide_loop({ ..w, a: w.a + 1 }, n - 1) }\n",
    b"fn wide_even(w: { a: Int, b: Int, c: Int, d: Int, e: Int }, n: Int) -> Int / {diverges} = if n == 0 { w.a } else { wide_odd(w, n - 1) }\n",
    b"fn wide_odd(w: { a: Int, b: Int, c: Int, d: Int, e: Int }, n: Int) -> Int / {diverges} = if n == 0 { w.b } else { wide_even(w, n - 1) }\n",
    b"fn wide_reader() -> ({ a: Int, b: Int, c: Int, d: Int, e: Int }) -> Int = |w: { a: Int, b: Int, c: Int, d: Int, e: Int }| w.a + w.b\n",
    b"fn wide_applied(f: ({ a: Int, b: Int, c: Int, d: Int, e: Int }) -> Int, n: Int) -> Int = f(widen(n))\n",
    b"type Hue = | Red | Green | Blue\n",
    b"fn hue_next(h: Hue) -> Hue = match h { Red -> Green, Green -> Blue, Blue -> Red }\n",
    b"fn hue_twice(h: Hue) -> Hue = hue_next(hue_next(h))\n",
    b"fn some_of() -> (Int) -> Option<Int> = Some\n",
    b"fn held(n: Int) -> Int = with_hold[file](n, |x: Int| ()) { h -> h.get() + 1 }\n",
    b"fn iterate_named(n: Int) -> Int / {abort.raise} = iterate(n, 100, step_of)\n",
    b"fn iterate_by(n: Int) -> Int / {abort.raise} = { let by = |f: (Int, Int, (Int) -> Iter<Int, Int>) -> Int / {abort.raise}| f(n, 1000, step_of); by(iterate) }\n",
    b"fn or_named(o: Option<String>) -> (String) -> String = |s: String| match o { Some(n) -> n, None -> s }\n",
    b"fn or_lent(o: Option<String>, s: String) -> String = apply_to(|t: String| match o { Some(n) -> n, None -> t }, s)\n",
    b"fn or_returned(o: Option<String>, s: String) -> String = handle { if amb.flip() { s } else { \"b\" } } with { amb.flip() resume k -> k(true), return v -> match o { Some(n) -> n, None -> v } }\n",
  ])

