/// The corpus's tail groups, each by its members' names.
fn groups() -> List<List<Bytes>> =
  [
    [b"even", b"odd"],
    [b"walk", b"stride"],
    [b"seek", b"probe"],
    [b"ping", b"pong"],
    [b"wide_even", b"wide_odd"],
  ]

/// Definition `m.<name>` of `p` lowered as a build lowers it.
fn lowered_as_built(p: Program, name: Bytes) -> Result<Fn, Declined> / {abort.raise} =
  key_lowered(p, Named(qualify(b"m", name)))

/// Root `key` of `p` lowered as a build lowers it: its body after `known_body`.
fn key_lowered(p: Program, key: RootKey) -> Result<Fn, Declined> / {abort.raise} =
  match match range(0, p.roots.len()).fold(None, |acc: Option<Int>, i: Int|
        match p.roots.at(i) { Some(r) -> if r.key == key { Some(i) } else { acc }, None -> acc }) {
      Some(i) -> p.roots.at(i),
      None -> None,
    } {
    None -> Err({ by: Spine, why: b"no such definition" }),
    Some(r) -> match r.code {
      Err(why) -> Err({ by: Spine, why: why }),
      Ok(code) -> {
        let body = known_body(root_text(root_name(r.key)), r.params, code);
        lowered_fn(context_of(p.setting, r, body), body)
      },
    },
  }

/// The corpus's root `name` lowered, or why not.
/// The calling corpus analysed.
fn corpus_program() -> Program / {abort.raise} =
  match program_of(corpus()) { Ok(p) -> p, Err(why) -> panic(String::of_bytes_lossy(why)) }

fn form(name: Bytes) -> Result<Fn, Bytes> / {abort.raise} =
  match program_of(corpus()) {
    Err(why) -> Err(why),
    Ok(p) -> match lowered_as_built(p, name) { Ok(f) -> Ok(f), Err(no) -> Err(no.why) },
  }

/// Every value `b` binds or does, its branches', cases', arms' and loops' too, in order.
fn vals_in(b: Block) -> List<Val> =
  b.fold([], |acc: List<Val>, i: Inst|
    match i {
      Let(l) -> acc.push(l.val),
      Do(d) -> acc.push(d.val),
      If(x) -> acc.concat(vals_in(x.then)).concat(vals_in(x.otherwise)),
      Case(c) ->
        c.arms.fold(acc, |a: List<Val>, arm: { when: Int, body: Block }|
          a.concat(vals_in(arm.body))).concat(
          vals_in(c.rest),
        ),
      Match(m) ->
        m.arms.fold(acc, |a: List<Val>, arm: Block| a.concat(vals_in(arm))).concat(vals_in(m.rest)),
      Loop(l) -> acc.concat(vals_in(l.body)),
      _ -> acc,
    })

/// Every variable `b` binds, its branches', cases', arms' and loops' too, in order.
fn bound_in(b: Block) -> List<Var> =
  b.fold([], |acc: List<Var>, i: Inst|
    match i {
      Let(l) -> acc.push(l.var),
      If(x) -> acc.concat(bound_in(x.then)).concat(bound_in(x.otherwise)),
      Case(c) ->
        c.arms.fold(acc, |a: List<Var>, arm: { when: Int, body: Block }|
          a.concat(bound_in(arm.body))).concat(
          bound_in(c.rest),
        ),
      Match(m) ->
        m.arms.fold(acc, |a: List<Var>, arm: Block| a.concat(bound_in(arm))).concat(
          bound_in(m.rest),
        ),
      Loop(l) -> acc.concat(bound_in(l.body)),
      _ -> acc,
    })

/// Whether a self call restarts `b` anywhere.
fn restarts(b: Block) -> Bool =
  b.fold(false, |found: Bool, i: Inst|
    found
      || (match i {
        Restart(_) -> true,
        If(x) -> restarts(x.then) || restarts(x.otherwise),
        _ -> false,
      }))

/// The body of closure `nth` of `f`, and how many of its parameters are captures.
fn closure_of(f: Fn, nth: Int) -> Option<{ body: Fn, captures: Int }> =
  match f.lambdas.at(nth) {
    Some(Closure(c)) -> Some({ body: c.body, captures: c.captures }),
    None -> None,
  }

test "a call of a definition hands its arguments as the callee carries them" {
  match form(b"twice") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(
        vals_in(f.body).fold([], |acc: List<{ reps: List<Rep>, answer: Rep }>, v: Val|
          match v {
            Call(c) -> if c.callee == Root(Named(b"m.add")) {
              acc.push({ reps: c.conv.reps, answer: c.conv.answer })
            } else { acc },
            _ -> acc,
          }),
        [{ reps: [RInt, RInt], answer: RInt }],
      ),
  };
  match form(b"handed") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(
        vals_in(f.body).fold([], |acc: List<List<Rep>>, v: Val|
          match v { Call(c) -> acc.push(c.conv.reps.push(c.conv.answer)), _ -> acc }),
        [[RWord, RWord]],
      ),
  }
}

test "a small record crosses a call as its fields and its word, both ways" {
  match form(b"summed") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(
        vals_in(f.body).fold([], |acc: List<{ reps: List<Rep>, answer: Rep }>, v: Val|
          match v {
            Call(c) -> if c.callee == Root(Named(b"m.swapped")) {
              acc.push({ reps: c.conv.reps, answer: c.conv.answer })
            } else { acc },
            _ -> acc,
          }),
        [
          {
            reps: [RFlat([{ name: b"x", rep: RInt }, { name: b"y", rep: RInt }])],
            answer: RFlat([{ name: b"x", rep: RInt }, { name: b"y", rep: RInt }]),
          },
        ],
      ),
  }
}

test "a lambda and a function value take a small record as its fields too" {
  let fields = RFlat([{ name: b"x", rep: RInt }, { name: b"y", rep: RInt }]);
  match form(b"pair_summer") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> match closure_of(f, 0) {
      None -> assert(false, Some("pair_summer makes no closure")),
      Some(c) ->
        assert_eq(c.body.conv.reps.drop(c.captures).push(c.body.conv.answer), [fields, RInt]),
    },
  };
  match form(b"applied_pair") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(
        vals_in(f.body).fold([], |acc: List<List<Rep>>, v: Val|
          match v { Apply(a) -> acc.push(a.conv.reps.push(a.conv.answer)), _ -> acc }),
        [[fields, RInt]],
      ),
  }
}

test "a call of a generic definition is the body's generic call at the reference's type arguments" {
  match form(b"ident_int") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(f.links.generics, [
        { callee: Named(b"m.ident"), args: [int_type()], carried: [0], fns: [] },
      ]);
      assert_eq(
        vals_in(f.body).fold([], |acc: List<List<Rep>>, v: Val|
          match v {
            Call(c) -> if c.callee == Generic(0) { acc.push(c.conv.reps.push(c.conv.answer)) }
            else { acc },
            _ -> acc,
          }),
        [[RInt, RInt]],
      )
    },
  };
  // A word crosses as itself at any type, so the call carries no variable raw.
  match form(b"ident_word") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(f.links.generics, [
        {
          callee: Named(b"m.ident"),
          args: [TyCon({ name: b"String", args: [] })],
          carried: [],
          fns: [],
        },
      ]),
  }
}

test "a self call in tail position restarts the body, and a lambda's call of its root's definition calls it" {
  match form(b"count") { Err(why) -> assert_eq(why, b""), Ok(f) -> assert(restarts(f.body), None) };
  match form(b"counter") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> match closure_of(f, 0) {
      None -> assert(false, Some("counter makes no closure")),
      Some(c) -> {
        assert(!restarts(c.body.body), None);
        assert_eq(
          vals_in(c.body.body).filter(|v: Val|
            match v { Call(x) -> x.callee == Root(Named(b"m.count")), _ -> false }).len(
          ),
          1,
        )
      },
    },
  }
}

test "a lambda is a closure of a function of its own taking its captures as words, then its parameters" {
  match form(b"adder") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(f.lambdas.len(), 1);
      assert_eq(
        vals_in(f.body).fold(
          [],
          |acc: List<{ captures: Int, params: Int, stacked: Bool, args: Int }>, v: Val|
            match v {
              Make(m) -> match m.made {
                MClosure(c) -> if c.nth == 0 {
                  acc.push({
                    captures: c.captures,
                    params: c.params,
                    stacked: c.stacked,
                    args: m.args.len(),
                  })
                } else { acc },
                _ -> acc,
              },
              _ -> acc,
            },
        ),
        [{ captures: 1, params: 1, stacked: false, args: 1 }],
      );
      match closure_of(f, 0) {
        None -> assert(false, Some("adder makes no closure")),
        Some(c) -> {
          assert_eq(c.captures, 1);
          assert_eq(c.body.conv.reps, [RInt, RInt]);
          assert_eq(c.body.conv.answer, RInt);
          // The captured `Int` is held as its body reads it, so nothing opens a word to add it.
          assert_eq(
            vals_in(c.body.body).filter(|v: Val| match v { Pack(_) -> true, _ -> false }).len(),
            0,
          )
        },
      }
    },
  }
}

test "a closure is a block of its own, its descriptor first, whose entries give up its captures and whose release lets each go" {
  match form(b"adder") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      let text = printed_text(corpus_program(), f);
      let name = symbol_of(b"m.adder").concat(b"_lambda0");
      let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
      // The block: its header, its descriptor, its one capture; the descriptor its first word.
      has(b"rt_alloc_bytes_p(ctx, 32)");
      has(Bytes::concat_all([b")[0] = (Word)(intptr_t)&", name, b"_desc"]));
      // The runtime's ABI: a descriptor's entries in their places, each taking the block.
      has(
        Bytes::concat_all([
          b"const PlyFnDesc ",
          name,
          b"_desc = { ",
          name,
          b"_uniform, (void (*)(void))",
          name,
          b"_typed, ",
        ]),
      );
      has(name.concat(b"_uniform(PlyCtx *ctx, Word self, const Word *args)"));
      has(name.concat(b"_typed(PlyCtx *ctx, Word self, int64_t p0)"));
      // Each entry takes the capture out of a closure held only by its caller, which may spend it,
      // and counts it once more otherwise; the captured `Int` lies in the block as its own bits.
      has(b"int unique = ply_obj(self)->rc == 1;");
      has(
        b"int64_t c0 = (int64_t)ply_words(self)[1];\n  if (unique) { ply_words(self)[1] = 0; } else {",
      );
      match closure_of(f, 0) {
        None -> assert(false, Some("adder makes no closure")),
        Some(c) -> {
          assert_eq(c.body.conv.params, [Given, Given]);
          assert_eq(c.body.conv.reps, [RInt, RInt])
        },
      };
      // The release counts nothing of the `Int`, and gives the block back.
      assert(
        text.index_of(call_text(rel_int_fn(), [b"ctx", b"ply_words(self)[1]"])) == None,
        Some(String::of_bytes_lossy(text)),
      );
      has(call_text(free_fn(), [b"ctx", b"self", b"32"]));
      // A closure that captures is made afresh, never a static block.
      assert(text.index_of(b"PlyFnBlock ") == None, Some(String::of_bytes_lossy(text)))
    },
  }
}

test "a record a closure captures lies in its block as its fields, boxed for nothing" {
  match form(b"captor") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(vals_in(f.body).filter(|v: Val| match v { Pack(_) -> true, _ -> false }).len(), 0);
      // The header, the descriptor's word, and the record's two.
      let text = printed_text(corpus_program(), f);
      assert(
        text.index_of(b"rt_alloc_bytes_p(ctx, 40)") != None,
        Some(String::of_bytes_lossy(text)),
      )
    },
  }
}

test "a record a call would hand by reference is captured as its word" {
  match form(b"wide_captor") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> match closure_of(f, 0) {
      None -> assert(false, Some("wide_captor makes no closure")),
      Some(c) -> assert_eq(c.body.conv.reps, [RWord]),
    },
  }
}

test "a lambda a lambda writes is the root's next closure, numbered in the order they are written" {
  match form(b"nested") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(f.lambdas.len(), 2);
      match closure_of(f, 0) {
        None -> assert(false, Some("nested makes no closure")),
        Some(outer) ->
          assert_eq(
            vals_in(outer.body.body).fold([], |acc: List<{ nth: Int, captures: Int }>, v: Val|
              match v {
                Make(m) -> match m.made {
                  MClosure(c) -> acc.push({ nth: c.nth, captures: c.captures }),
                  _ -> acc,
                },
                _ -> acc,
              }),
            [{ nth: 1, captures: 2 }],
          ),
      }
    },
  }
}

test "a definition or a constructor named as a value is the closure of a lambda around it, and a pure definition of no parameters is read once" {
  let made = |f: Fn|
    vals_in(f.body).fold([], |acc: List<{ captures: Int, params: Int }>, v: Val|
      match v {
        Make(m) -> match m.made {
          MClosure(c) -> acc.push({ captures: c.captures, params: c.params }),
          _ -> acc,
        },
        _ -> acc,
      });
  match form(b"named") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(made(f), [{ captures: 0, params: 2 }]);
      match closure_of(f, 0) {
        None -> assert(false, Some("named makes no closure")),
        Some(c) -> {
          assert_eq(c.body.conv.reps, [RInt, RInt]);
          // The call counts the step; the closure standing for the name counts none of its own.
          assert_eq(c.body.kind, Plain);
          assert_eq(
            vals_in(c.body.body).filter(|v: Val|
              match v { Call(k) -> k.callee == Root(Named(b"m.add")), _ -> false }).len(
            ),
            1,
          )
        },
      }
    },
  };
  match form(b"some_of") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(made(f), [{ captures: 0, params: 1 }]);
      match closure_of(f, 0) {
        None -> assert(false, Some("some_of makes no closure")),
        Some(c) ->
          assert_eq(
            vals_in(c.body.body).filter(|v: Val|
              match v { Call(_) -> true, Apply(_) -> true, _ -> false }).len(
            ),
            0,
          ),
      }
    },
  };
  match form(b"read_kept") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      let vs = vals_in(f.body);
      assert_eq(
        vs.filter(|v: Val|
          match v {
            Op(o) ->
              o.op == OCalling(ConstantRead({ callee: Root(Named(b"m.kept")), kept: int_type() })),
            _ -> false,
          }).len(
        ),
        1,
      );
      // The kept word is opened to the `Int` it holds.
      assert_eq(vs.filter(|v: Val| match v { Pack(k) -> k.to == RInt, _ -> false }).len(), 1);
      assert_eq(vs.filter(|v: Val| match v { Call(_) -> true, _ -> false }).len(), 0)
    },
  }
}

test "a hold's closures and what its builtins answer are typed by the hold, so nothing it binds is of no known type" {
  match form(b"held") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      let open = |b: Fn| b.params.concat(bound_in(b.body)).filter(|v: Var| has_vars(v.ty));
      assert_eq(open(f), []);
      assert_eq(
        f.lambdas.map(|l: Lambda| match l { Closure(c) -> open(c.body) }),
        f.lambdas.map(|_: Lambda| []),
      );
      // The close takes the hold the body takes.
      let holds = f.lambdas.fold([], |acc: List<Type>, l: Lambda|
        match l {
          Closure(c) -> match c.body.params.drop(c.captures) {
            [p] -> match p.ty {
              TyCon(t) -> if t.name == b"Hold" { acc.push(p.ty) } else { acc },
              _ -> acc,
            },
            _ -> acc,
          },
        });
      assert_eq(holds.len(), 2);
      assert_eq(holds.at(0), holds.at(1))
    },
  }
}

test "a lambda handed where its callee lends it lies on the caller's stack, and the call is settled with it" {
  match form(b"lends") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      let vs = vals_in(f.body);
      assert_eq(
        vs.fold([], |acc: List<Bool>, v: Val|
          match v {
            Make(m) -> match m.made { MClosure(c) -> acc.push(c.stacked), _ -> acc },
            _ -> acc,
          }),
        [true],
      );
      assert_eq(f.links.generics, [
        {
          callee: Named(b"m.apply_to"),
          args: [int_type()],
          carried: [0],
          fns: [{ param: 0, owner: Named(b"m.lends"), nth: 0 }],
        },
      ]);
      assert_eq(
        vs.filter(|v: Val| match v { Call(c) -> c.callee == Generic(0), _ -> false }).len(),
        1,
      )
    },
  }
}

test "a function value is applied through the convention its type has, and the parameter is noted as called" {
  match form(b"applied") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(
        vals_in(f.body).fold([], |acc: List<List<Rep>>, v: Val|
          match v { Apply(a) -> acc.push(a.conv.reps.push(a.conv.answer)), _ -> acc }),
        [[RInt, RInt]],
      );
      assert_eq(f.links.called, [0])
    },
  }
}

test "a lambda a let binds and a call runs in place reads its captures off its closure" {
  match form(b"local") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      let vs = vals_in(f.body);
      assert_eq(vs.filter(|v: Val| match v { Apply(_) -> true, _ -> false }).len(), 0);
      assert_eq(
        vs.filter(|v: Val| match v { Op(o) -> o.op == OCalling(Ticked), _ -> false }).len(),
        1,
      );
      assert_eq(
        vs.filter(|v: Val| match v { Get(g) -> g.path == PCapture(0), _ -> false }).len(),
        1,
      )
    },
  }
}

test "a step whose every arm makes its Continue or Stop goes on or leaves at once, making no object" {
  let made = |f: Fn|
    vals_in(f.body).filter(|v: Val|
      match v {
        Make(m) -> match m.made { MCase(_) -> true, _ -> false },
        Gathered(_) -> true,
        _ -> false,
      }).len(
    );
  let looped = |f: Fn| f.body.filter(|i: Inst| match i { Loop(_) -> true, _ -> false }).len();
  match form(b"steps") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(looped(f), 1);
      assert_eq(made(f), 0)
    },
  };
  // A `match` with a guard, as well as an `if`, and an `if` in a `match` arm.
  [b"count_down", b"walked_to"].fold((), |_: Unit, name: Bytes|
    match form(name) {
      Err(why) -> assert_eq(why, b""),
      Ok(f) -> assert_eq([looped(f), made(f)], [1, 0]),
    })
}

test "`iterate` on a step that is a function value loops in the body, applying the step through its descriptor each pass" {
  // Each loop of `b` whose passes apply a function value.
  let applying = |b: Block|
    b.filter(|i: Inst|
      match i {
        Loop(l) -> vals_in(l.body).any(|v: Val| match v { Apply(_) -> true, _ -> false }),
        _ -> false,
      }).len(
    );
  // A named step, handed as a value.
  match form(b"iterate_named") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(applying(f.body), 1);
      assert(printed_text(corpus_program(), f).index_of(b"->typed)(ctx") != None, None)
    },
  };
  // `iterate` itself handed as a value, and called.
  match form(b"iterate_by") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(
        f.lambdas.map(|l: Lambda| match l { Closure(c) -> applying(c.body.body) }).fold(
          0,
          |n: Int, k: Int| n + k,
        ),
        1,
      ),
  }
}

test "a step's loop fails by the runtime once its budget is spent" {
  match form(b"stepped") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(printed_text(corpus_program(), f).split(b"rt_iterate_bad_p(ctx, ").len() - 1, 1),
  }
}

test "a step iterate runs is a loop over its state and budget, each pass going on or leaving as its Iter says" {
  match form(b"stepped") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> match f.body.fold(None, |acc: Option<Inst>, i: Inst|
        match i { Loop(_) -> Some(i), _ -> acc }) {
      Some(Loop(l)) -> {
        assert_eq(l.state.map(|v: Var| v.rep), [RInt, RInt]);
        assert_eq(l.answer.rep, RInt);
        // The pass ends testing the `Iter` the step answered: a `Continue` goes on, a `Stop` leaves.
        match l.body.at(l.body.len() - 1) {
          Some(Case(c)) -> {
            assert_eq(c.test, TTag([b"Continue", b"Stop"]));
            assert_eq(
              c.arms.map(|a: { when: Int, body: Block }|
                match a.body.at(a.body.len() - 1) {
                  Some(Next(_)) -> 0,
                  Some(Done(_)) -> 1,
                  _ -> 2,
                }),
              [0, 1],
            )
          },
          other -> assert_eq(other, None),
        }
      },
      _ -> assert(false, Some("the step is no loop")),
    },
  }
}

/// Where the corpus's root `name` stands among the analysed program's roots.
fn root_at(p: Program, name: Bytes) -> Option<Int> =
  range(0, p.roots.len()).fold(None, |acc: Option<Int>, i: Int|
    match p.roots.at(i) {
      Some(r) -> if r.key == Named(qualify(b"m", name)) { Some(i) } else { acc },
      None -> acc,
    })

/// The corpus's root `name` lowered as a build lowers its specialisation at `args` running `fns`,
/// each parameter `lent` names running that lambda: keyed by the name that spells it, its body's
/// types read at `args`; or why not.
fn specialised_form(
  p: Program,
  name: Bytes,
  args: List<Type>,
  fns: List<FnArg>,
  lent: List<Option<BoundLambda>>,
) -> Result<Fn, Bytes> / {abort.raise} =
  match match root_at(p, name) { Some(i) -> p.roots.at(i), None -> None } {
    None -> Err(b"no such root"),
    Some(r) -> match r.code {
      Err(why) -> Err(why),
      Ok(code) -> {
        let key = at_key(filed_as(r.key), args, fns);
        let params = range(0, r.params.len()).map(|i: Int|
          match lent.at(i) {
            Some(Some(bl)) -> { ..r.params.get(i), lambda: Some(bl) },
            _ -> r.params.get(i),
          });
        let body = known_body(root_text(root_name(key)), params, code);
        let filed = match r.filed { Ok(f) -> Ok(filings_at(f, args)), Err(why) -> Err(why) };
        match lowered_fn(
            context_of(p.setting, { ..r, key: key, params: params, filed: filed }, body),
            body,
          ) {
          Ok(f) -> Ok(f),
          Err(no) -> Err(no.why),
        }
      },
    },
  }

/// Generic root `generic` of `p` at `args` as the specialisation a build lowers where root `lender`
/// hands its parameter `param` the first lambda it writes, typed as a build types it, with its
/// lender's whole body; and the lender's base; or why not.
fn lent_run(
  p: Program,
  lender: Bytes,
  generic: Bytes,
  args: List<Type>,
  param: Int,
) -> Result<{ f: Fn, base: Int }, Bytes> / {abort.raise} =
  match match root_at(p, lender) { Some(i) -> p.roots.at(i), None -> None } {
    None -> Err(b"no such lender"),
    Some(l) -> match l.code {
      Err(why) -> Err(why),
      Ok(code) -> {
        let written = lambdas_of(known_body(root_text(root_name(l.key)), l.params, code));
        match written.at(0) {
          None -> Err(b"a lender that writes no lambda"),
          Some(first) -> {
            let bound = {
              owner: l.key,
              nth: 0,
              code: first,
              named: false,
              module: b"m",
              here: p.setting.here,
              imports: p.setting.imports,
              effects: p.setting.effects,
              filed: match l.filed { Ok(f) -> f, Err(_) -> no_filings() },
              base: l.base,
              written: written,
            };
            match specialised_form(
                p,
                generic,
                args,
                [{ param: param, owner: l.key, nth: 0 }],
                range(0, param + 1).map(|i: Int| if i == param { Some(bound) } else { None }),
              ) {
              Ok(f) -> Ok({ f: f, base: l.base }),
              Err(why) -> Err(why),
            }
          },
        }
      },
    },
  }

test "another root's lambda a specialisation runs in place takes its lender's sites, and only there" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match lent_run(
        p,
        b"lends_word",
        b"apply_to",
        [TyCon({ name: b"String", args: [] })],
        0,
      ) {
      Err(why) -> assert_eq(why, b""),
      Ok(run) -> {
        assert_eq(
          run.f.body.fold([], |acc: List<Inst>, i: Inst|
            match i { Sited(_) -> acc.push(i), _ -> acc }),
          [Sited(Some({ root: Named(b"m.lends_word"), base: run.base })), Sited(None)],
        );
        assert_eq(
          vals_in(run.f.body).filter(|v: Val| match v { Apply(_) -> true, _ -> false }).len(),
          0,
        );
        assert_eq(
          vals_in(run.f.body).filter(|v: Val|
            match v { Get(g) -> g.path == PCapture(0), _ -> false }).len(
          ),
          1,
        )
      },
    },
  }
}

test "a lent lambda's own lambdas are its lender's: one it binds runs in place, its closures take the lender's sites, one it hands on is lent by the lender" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match lent_run(p, b"lends_on", b"apply_to", [int_type()], 0) {
      Err(why) -> assert_eq(why, b""),
      Ok(run) -> {
        let lent = Sited(Some({ root: Named(b"m.lends_on"), base: run.base }));
        assert_eq(
          range(0, run.f.lambdas.len()).map(|k: Int|
            match closure_of(run.f, k) { Some(c) -> c.body.body.at(0), None -> None }),
          [Some(lent), Some(lent)],
        );
        assert_eq(
          vals_in(run.f.body).filter(|v: Val| match v { Apply(_) -> true, _ -> false }).len(),
          0,
        );
        assert_eq(run.f.links.generics.map(|g: GenericCall| g.fns), [
          [{ param: 0, owner: Named(b"m.lends_on"), nth: 1 }],
        ])
      },
    },
  }
}

/// The operators root `lender`'s lambda does over `Int`s where `fold_from` at `args` runs it in place,
/// and how many it hands the runtime as words; or why it was not formed.
fn folded_ops(
  p: Program,
  lender: Bytes,
  args: List<Type>,
) -> Result<{ c: List<Bytes>, runtime: Int }, Bytes> / {abort.raise} =
  match lent_run(p, lender, b"fold_from", args, 3) {
    Err(why) -> Err(why),
    Ok(run) -> {
      let vals = vals_in(run.f.body);
      Ok({
        c: vals.fold([], |acc: List<Bytes>, v: Val|
          match v {
            Prim(x) -> if x.on == RInt && x.op != b"ge" { acc.push(x.op) } else { acc },
            _ -> acc,
          }),
        runtime: vals.filter(|v: Val|
          match v { Native(n) -> n.name == b"rt_binary_p", _ -> false }).len(
        ),
      })
    },
  }

test "a lent lambda run where its arguments and captures arrive as a type variable's or an erased word reads them at the types it was written for" {
  let src = Bytes::concat_all([
    b"fn fold_from<T, A>(xs: List<T>, i: Int, acc: A, f: (A, T) -> A) -> A =\n",
    b"  match xs.at(i) { Some(x) -> fold_from(xs, i + 1, f(acc, x), f), None -> acc }\n",
    b"fn bits(n: Int) -> Int =\n",
    b"  fold_from(range(1, 7), 0, 0, |found: Int, b: Int| if 1 << b == n { b } else { found })\n",
    b"fn digits(n: Int) -> Option<Int> =\n",
    b"  fold_from(range(0, n), 0, Some(0), |so_far: Option<Int>, d: Int|\n",
    b"    match so_far { Some(v) -> Some(v * 10 + d), None -> None })\n",
  ]);
  let erased = TyCon({ name: b"Option", args: [TyCon({ name: b"_", args: [] })] });
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      assert_eq(
        folded_ops(p, b"bits", [unknown_type(), int_type()]),
        Ok({ c: [b"add", b"shl", b"eq"], runtime: 0 }),
      );
      assert_eq(
        folded_ops(p, b"digits", [unknown_type(), erased]),
        Ok({ c: [b"add", b"mul", b"add"], runtime: 0 }),
      )
    },
  }
}

test "a fold's accumulator erased to `Option<_>`, its payload's word, is read as the `Option` of a record its lambda was written for, which is its cases" {
  let src = Bytes::concat_all([
    b"fn spans(n: Int) -> Option<{ at: Int, n: Int }> =\n",
    b"  range(0, n).fold(None, |acc: Option<{ at: Int, n: Int }>, k: Int|\n",
    b"    match acc { Some(a) -> Some({ at: a.at, n: a.n + 1 }), None -> Some({ at: k, n: 1 }) })\n",
  ]);
  let words = TyCon({ name: b"Option", args: [TyCon({ name: b"_", args: [] })] });
  match answered_by_form(src, [], prelude_fold([unknown_type(), words], b"m.spans")) {
    Err(why) -> assert_eq(why, b""),
    Ok(text) -> assert_eq(text.index_of(b"rt_binary_p"), None),
  }
}

test "a lent lambda's parameter is read at what its written type says, a type variable of its lender's read as a word" {
  let src = Bytes::concat_all([
    b"fn heaviest<a>(pairs: List<{ item: a, weight: Int }>) -> Int =\n",
    b"  pairs.fold(0, |most: Int, p: { item: a, weight: Int }| if p.weight > most { p.weight } else { most })\n",
  ]);
  match answered_by_form(src, [], prelude_fold([unknown_type(), int_type()], b"m.heaviest")) {
    Err(why) -> assert_eq(why, b""),
    Ok(text) -> assert_eq(text.index_of(b"rt_binary_p"), None),
  }
}

/// The prelude's fold loop at `args`, running the first lambda `lender` writes.
fn prelude_fold(args: List<Type>, lender: Bytes) -> RootKey =
  at_key(b"std.prelude.folded_from", args, [{ param: 5, owner: Named(lender), nth: 0 }])

test "a closure a root writes calls a lambda the root was lent through its closure, as a function value" {
  let src = Bytes::concat_all([
    b"fn twice_each<T>(xs: List<T>, f: (T) -> T) -> List<T> = xs.map(|x: T| f(f(x)))\n",
    b"fn bumped(xs: List<Int>) -> List<Int> = twice_each(xs, |n: Int| n + 1)\n",
  ]);
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match lent_run(p, b"bumped", b"twice_each", [int_type()], 1) {
      Err(why) -> assert_eq(why, b""),
      Ok(run) ->
        assert_eq(
          range(0, run.f.lambdas.len()).map(|k: Int|
            match closure_of(run.f, k) {
              Some(c) ->
                vals_in(c.body.body).filter(|v: Val| match v { Apply(_) -> true, _ -> false }).len(
                ),
              None -> 0,
            }),
          [2],
        ),
    },
  }
}

/// How a value a branch or a number's `Case` tests is held: `branch` where an `If` tests it.
type Tested = { held: Rep, branch: Bool }

/// What each branch and each number's `Case` of `b` tests, its branches', cases', arms' and loops'
/// too, in order.
fn tested_in(b: Block) -> List<Tested> =
  b.fold([], |acc: List<Tested>, i: Inst|
    match i {
      If(x) ->
        acc.push({ held: rep_of_arg(x.cond), branch: true }).concat(tested_in(x.then)).concat(
          tested_in(x.otherwise),
        ),
      Case(c) -> {
        let here = match c.test {
          TInt(_) -> acc.push({ held: c.on.rep, branch: false }),
          TRange(_) -> acc.push({ held: c.on.rep, branch: false }),
          _ -> acc,
        };
        c.arms.fold(here, |a: List<Tested>, arm: { when: Int, body: Block }|
          a.concat(tested_in(arm.body))).concat(
          tested_in(c.rest),
        )
      },
      Match(m) ->
        m.arms.fold(acc, |a: List<Tested>, arm: Block| a.concat(tested_in(arm))).concat(
          tested_in(m.rest),
        ),
      Loop(l) -> acc.concat(tested_in(l.body)),
      _ -> acc,
    })

/// Whether a test reads its value as it is not held: a branch a non-`Bool`, a number's test a word.
fn misheld(t: Tested) -> Bool =
  if t.branch { t.held != RBool }
  else { match t.held { RInt -> false, RBool -> false, RNum(_) -> false, _ -> true } }

test "a closure testing a Bool it captured tests the Bool, never the word its capture is" {
  [b"chooser", b"guarded", b"either", b"picked"].fold((), |_: Unit, name: Bytes|
    match form(name) {
      Err(why) -> assert_eq(why, b""),
      Ok(f) -> match closure_of(f, 0) {
        None -> assert_eq(name, b""),
        Some(c) -> {
          let tests = tested_in(c.body.body);
          assert(tests.len() > 0);
          assert_eq(tests.filter(misheld), [])
        },
      },
    })
}

test "a closure matching a sum it captured reads the sum's cases, never the word its capture is" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let own = [b"or_named", b"or_lent", b"or_returned"].map(|name: Bytes|
        match lowered_as_built(p, name) { Ok(f) -> verified(owned(f)), Err(no) -> Some(no.why) });
      let in_place = match lent_run(
          p,
          b"or_lent",
          b"apply_to",
          [TyCon({ name: b"String", args: [] })],
          0,
        ) {
        Ok(run) -> verified(owned(run.f)),
        Err(why) -> Some(why),
      };
      assert_eq(own.push(in_place), [None, None, None, None])
    },
  }
}

test "a specialisation reads a parameter it is handed as a word at its full type, so a match reads the sum's cases" {
  let src = Bytes::concat_all([
    b"type Fault = { path: String, at: Option<Int>, message: String }\n",
    b"fn mapped_ok<a, b>(r: Result<a, Fault>, f: (a) -> b) -> Result<b, Fault> = match r { Ok(x) -> Ok(f(x)), Err(e) -> Err(e) }\n",
    b"fn positive(r: Result<Int, Fault>) -> Result<Bool, Fault> = mapped_ok(r, |n: Int| n > 0)\n",
  ]);
  let built = |lent: List<FnArg>|
    match answered_by_form(src, [], at_key(b"m.mapped_ok", [int_type(), bool_type()], lent)) {
      Ok(text) -> if text.len() == 0 { Some(b"settled by its callers") } else { None },
      Err(why) -> Some(why),
    };
  assert_eq([built([]), built([{ param: 1, owner: Named(b"m.positive"), nth: 0 }])], [None, None])
}

/// `std.cases` as far as a test over cases, once expanded, calls it.
fn cases_module() -> { name: Bytes, src: Bytes } =
  {
    name: b"std.cases",
    src: Bytes::concat_all([
      b"pub type Table<a> = List<a>\n",
      b"pub type Listed = { label: String, identity: Bytes }\n",
      b"pub fn listed<a | e>(table: List<a>, label: (a) -> String / e) -> List<Listed> / {abort.raise | e} =\n",
      b"  table.map(|c: a| { label: label(c), identity: b\"\" })\n",
      b"pub fn chosen<a>(table: List<a>, at: Int, wanted: Bytes) -> a / {abort.raise} =\n",
      b"  match table.at(at) { Some(c) -> c, None -> panic(\"no case\") }\n",
    ]),
  }

/// Whether a build writes root `root` of module `m` of text `src`, which imports `shipped`, or why
/// not.
fn formed_root(
  src: Bytes,
  shipped: List<{ name: Bytes, src: Bytes }>,
  root: RootKey,
) -> Result<Bool, Bytes> / {abort.raise} =
  match answered_by_form(src, shipped, root) { Err(why) -> Err(why), Ok(_) -> Ok(true) }

test "a test over cases reads its case at the case's type, which its generic callees' sites agree on" {
  let src = Bytes::concat_all([
    b"type Fixture = { name: String, unified: String }\n",
    b"fn fixtures() -> List<Fixture> = [{ name: \"a\", unified: \"\" }]\n",
    b"test \"each case's text is empty\" for f: Fixture in fixtures() { assert(f.unified == \"\") }\n",
  ]);
  assert_eq(
    formed_root(src, [cases_module()], test_key(b"m", b"each case's text is empty")),
    Ok(true),
  )
}

test "a law's binders are its roots' parameters at the types the checker gave them" {
  let src = Bytes::concat_all([
    b"type Few = | Zero | One | Two\n",
    b"law \"two that differ differ\"\n  forall (a: Few, b: Few) where a != b {\n    a != b\n  }\n",
  ]);
  let root = |part: LawPart| law_key(b"m", b"two that differ differ", part);
  assert_eq([root(LawGuard), root(LawBody)].map(|r: RootKey| formed_root(src, [], r)), [
    Ok(true),
    Ok(true),
  ]);
  // A binder of a type variable compares as a value of that variable does.
  let poly = b"fn pair<a>(x: a) -> a = x\nlaw \"identity is identity\"\n  forall (x: a) {\n    pair(x) == x\n  }\n";
  assert_eq(formed_root(poly, [], law_key(b"m", b"identity is identity", LawBody)), Ok(true));
  // Its sites the first a program files, as where it is all the program writes.
  let alone = b"law \"a value is itself\"\n  forall (x: a, y: b) {\n    x == x && y == y\n  }\n";
  let itself = law_key(b"m", b"a value is itself", LawBody);
  assert_eq(formed_root(alone, [], itself), Ok(true));
  // And as the program's setting offers it.
  match program_of(alone) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> assert_eq(match key_lowered(p, itself) { Ok(_) -> b"", Err(no) -> no.why }, b""),
  }
}

/// The corpus's roots `names` lowered as one tail group, or why not.
fn group_form(names: List<Bytes>) -> Result<Fn, Bytes> / {abort.raise} =
  match program_of(corpus()) {
    Err(why) -> Err(why),
    Ok(p) -> {
      let members = names.fold([], |acc: List<GroupMember>, n: Bytes|
        match range(0, p.roots.len()).fold(None, |found: Option<GroupMember>, i: Int|
            match p.roots.at(i) {
              Some(r) -> if r.key != Named(qualify(b"m", n)) { found } else {
                match r.code {
                  Ok(code) -> {
                    let body = known_body(root_text(root_name(r.key)), r.params, code);
                    Some({ cx: context_of(p.setting, r, body), body: body })
                  },
                  Err(_) -> found,
                }
              },
              None -> found,
            }) {
          Some(m) -> acc.push(m),
          None -> acc,
        });
      match lowered_group(members) { Ok(f) -> Ok(f), Err(no) -> Err(no.why) }
    },
  }

/// Every instruction `b` holds, its branches' and cases' too.
fn insts_in(b: Block) -> List<Inst> =
  b.fold([], |acc: List<Inst>, i: Inst|
    match i {
      If(x) -> acc.push(i).concat(insts_in(x.then)).concat(insts_in(x.otherwise)),
      Case(c) ->
        c.arms.fold(
          acc.push(i).concat(insts_in(c.rest)),
          |a: List<Inst>, arm: { when: Int, body: Block }| a.concat(insts_in(arm.body)),
        ),
      Match(m) ->
        m.arms.fold(acc.push(i).concat(insts_in(m.rest)), |a: List<Inst>, arm: Block|
          a.concat(insts_in(arm))),
      _ -> acc.push(i),
    })

test "a tail group is one root whose case runs each member, a tail call into another member entering it" {
  match group_form([b"even", b"odd"]) {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(f.members.map(|m: Member| m.key), [Named(b"m.even"), Named(b"m.odd")]);
      assert_eq(f.members.map(|m: Member| m.params.map(|v: Var| v.rep)), [[RInt], [RInt]]);
      assert_eq(
        insts_in(f.body).fold([], |acc: List<Int>, i: Inst|
          match i { Enter(e) -> acc.push(e.member), _ -> acc }),
        [1, 0],
      );
      assert_eq(
        insts_in(f.body).filter(|i: Inst| match i { Restart(_) -> true, _ -> false }).len(),
        0,
      )
    },
  }
}

/// Whether a value held as `r` crosses as several values.
fn parted(r: Rep) -> Bool = values_of(r).len() > 1

test "a tail group's members take and answer a record and a sum as their values, their wrappers handing the group's function words" {
  match group_form([b"walk", b"stride"]) {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(f.members.map(|m: Member| m.conv.reps.push(m.conv.answer).map(parted)), [
        [true, false, true],
        [true, false, true],
      ]);
      assert_eq(
        insts_in(f.body).fold([], |acc: List<Int>, i: Inst|
          match i { Enter(e) -> acc.push(e.member), _ -> acc }),
        [1, 0],
      );
      // Each member's wrapper enters the group at its own place.
      let text = printed_text(corpus_program(), owned(f));
      assert(text.index_of(symbol_of(b"m.walk").concat(b"_group(ctx, 0, ")) != None)
    },
  };
  match group_form([b"seek", b"probe"]) {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(f.members.map(|m: Member| m.conv.reps.push(m.conv.answer).map(parted)), [
        [true, false, true],
        [true, false, true],
      ]);
      let text = printed_text(corpus_program(), owned(f));
      assert(text.index_of(symbol_of(b"m.seek").concat(b"_group(ctx, 0, ")) != None)
    },
  }
}

test "a closure a later member of a tail group writes fails at that member's sites" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match group_form([b"ping", b"pong"]) {
      Err(why) -> assert_eq(why, b""),
      Ok(f) -> {
        let base = match match root_at(p, b"pong") { Some(i) -> p.roots.at(i), None -> None } {
          Some(r) -> r.base,
          None -> 0 - 1,
        };
        assert_eq(
          range(0, f.lambdas.len()).map(|k: Int|
            match closure_of(f, k) { Some(c) -> c.body.body.at(0), None -> None }),
          [Some(Sited(Some({ root: Named(b"m.pong"), base: base })))],
        )
      },
    },
  }
}

test "a specialisation, keyed by the name that spells it, restarts its own tail calls" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match specialised_form(p, b"go", [int_type()], [], []) {
      Err(why) -> assert_eq(why, b""),
      Ok(f) -> {
        assert_eq(
          insts_in(f.body).filter(|i: Inst| match i { Restart(_) -> true, _ -> false }).len(),
          1,
        );
        assert_eq(vals_in(f.body).filter(|v: Val| match v { Call(_) -> true, _ -> false }).len(), 0)
      },
    },
  }
}

/// The lists `b` makes of a rest it reads: lists of their own sharing a list's trie, and views made
/// lists.
fn rests_made(b: Block) -> Int =
  vals_in(b).filter(|v: Val|
    match v {
      Op(o) -> o.op == OContainer(Rest),
      Pack(k) -> rep_of_arg(k.arg) == RSlice,
      _ -> false,
    }).len(
  )

test "a list a root walks down by restarting on its rest is a view of the list it was handed, which no step copies" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let walked = |name: Bytes|
        match lowered_as_built(p, name) {
          Err(no) -> Err(no.why),
          Ok(f) ->
            Ok({
              held: f.params.map(|v: Var| v.rep).take(1),
              taken: f.conv.reps.take(1),
              restarts: insts_in(f.body).any(|i: Inst| match i { Restart(_) -> true, _ -> false }),
              rests: rests_made(f.body),
            }),
        };
      let viewed = |rests: Int|
        Ok({ held: [RSlice], taken: [RWord], restarts: true, rests: rests });
      // A rest read whole is made a list where it is read, and only there.
      assert_eq([b"has", b"pair_sums", b"lengths", b"again", b"tail_of"].map(walked), [
        viewed(0),
        viewed(0),
        viewed(1),
        viewed(0),
        viewed(1),
      ]);
      assert_eq(
        match walked(b"rest_lens") { Ok(w) -> Ok(w.held), Err(why) -> Err(why) },
        Ok([RSlice]),
      );
      // A walk that calls itself other than in tail position takes the list as it is.
      assert_eq(walked(b"total"), Ok({ held: [RWord], taken: [RWord], restarts: false, rests: 1 }));
      match lowered_as_built(p, b"again") {
        Err(no) -> assert_eq(no.why, b""),
        Ok(f) ->
          assert(
            vals_in(f.body).any(|v: Val|
              match v { Gathered(g) -> g.parts.at(1) == Some(AInt(0)), _ -> false }),
          ),
      }
    },
  }
}

/// The block of the first loop `b` runs.
fn loop_in(b: Block) -> Option<Block> =
  b.fold(None, |acc: Option<Block>, i: Inst|
    match acc { Some(_) -> acc, None -> match i { Loop(l) -> Some(l.body), _ -> None } })

test "a step whose join more of its pass follows runs the rest of the pass, then tests the `Iter` it answers" {
  match form(b"raised_step") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> match loop_in(f.body) {
      None -> assert(false, Some("no loop")),
      Some(pass) -> {
        assert(match pass.at(pass.len() - 1) {
          Some(Case(c)) -> c.test == TTag([b"Continue", b"Stop"]),
          _ -> false,
        });
        // Each case the pass makes, as its sum lays it: gathered into the sum's words, or an object.
        assert_eq(
          vals_in(pass).filter(|v: Val|
            match v {
              Gathered(_) -> true,
              Make(m) -> match m.made { MCase(_) -> true, _ -> false },
              _ -> false,
            }).len(
          ),
          2,
        )
      },
    },
  }
}

test "a restart and a loop over a record set its parameter or state value by value" {
  match form(b"walk1") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert(
        restarts(f.body) && (match f.params.at(0) { Some(p) -> parted(p.rep), None -> false }),
      ),
  };
  match form(b"paired_step") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(
        f.body.fold([], |acc: List<Bool>, i: Inst|
          match i { Loop(l) -> acc.concat(l.state.map(|v: Var| parted(v.rep))), _ -> acc }),
        [true, false],
      );
      assert_eq(undeclared(printed_text(corpus_program(), owned(f))), [])
    },
  }
}

test "a continuation is a word the runtime calls with words, and a clause binding one answers the very word it hands back" {
  let applied = |f: Fn| vals_in(f.body).filter(|v: Val| match v { Apply(_) -> true, _ -> false });
  let clause_of = |f: Fn|
    range(0, f.lambdas.len()).fold(None, |acc: Option<Fn>, k: Int|
      match closure_of(f, k) {
        Some(c) -> if applied(c.body).len() > 0 { Some(c.body) } else { acc },
        None -> acc,
      });
  let conventions = |c: Fn|
    applied(c).map(|v: Val| match v { Apply(a) -> a.conv.reps.push(a.conv.answer), _ -> [] });
  let resumed = |c: Fn|
    c.body.fold([], |acc: List<Var>, i: Inst|
      match i { Let(l) -> match l.val { Apply(_) -> acc.push(l.var), _ -> acc }, _ -> acc });
  let tail_only = |n: Bytes|
    match form(n) {
      Err(why) -> assert_eq(why, b""),
      Ok(f) -> match clause_of(f) {
        None -> assert(false, Some("no clause calls its continuation")),
        Some(c) -> {
          assert_eq(c.conv.answer, RWord);
          assert_eq(conventions(c), [[RWord, RWord]]);
          assert_eq(resumed(c).map(|v: Var| c.body.contains(Return(AVar(v)))), [true]);
          assert_eq(
            vals_in(c.body).filter(|v: Val|
              match v { Pack(k) -> resumed(c).any(|r: Var| k.arg == AVar(r)), _ -> false }).len(
            ),
            0,
          )
        },
      },
    };
  tail_only(b"tailed");
  tail_only(b"gauged");
  match form(b"both") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> match clause_of(f) {
      None -> assert(false, Some("no clause calls its continuation")),
      Some(c) -> {
        assert_eq(c.conv.answer, RWord);
        assert_eq(conventions(c), [[RWord, RWord], [RWord, RWord]])
      },
    },
  }
}

/// The C functions of `text`, each its lines from the head at column 0 that opens it to the `}`
/// that closes it.
fn functions_of(text: Bytes) -> List<List<Bytes>> =
  text.split(b"\n").fold(
    { done: [], open: None },
    |acc: { done: List<List<Bytes>>, open: Option<List<Bytes>> }, l: Bytes|
      match acc.open {
        None -> if !l.starts_with(b" ") && l.ends_with(b"{") { { ..acc, open: Some([l]) } }
        else { acc },
        Some(o) -> if l == b"}" { { done: acc.done.push(o), open: None } }
        else { { ..acc, open: Some(o.push(l)) } },
      },
  ).done

/// The names a C function `text` holds sets, `name = …`, that the same function declares nowhere.
fn undeclared(text: Bytes) -> List<Bytes> / {abort.raise} =
  functions_of(text).fold([], |acc: List<Bytes>, f: List<Bytes>| {
    let pieces = f.fold([], |s: List<Bytes>, l: Bytes| s.concat(statements_of(l)));
    let declared = pieces.fold([], |d: List<Bytes>, s: Bytes|
      match declared_name(s) { Some(n) -> d.push(n), None -> d });
    pieces.fold(acc, |a: List<Bytes>, s: Bytes|
      match set_name(s) {
        Some(n) -> if declared.contains(n) || a.contains(n) { a } else { a.push(n) },
        None -> a,
      })
  })

/// A line of C cut at each `;`, `,`, parenthesis and brace, each piece without its leading spaces.
fn statements_of(l: Bytes) -> List<Bytes> / {abort.raise} =
  [b";", b",", b"(", b")", b"{", b"}"].fold([l], |ps: List<Bytes>, sep: Bytes|
    ps.fold([], |out: List<Bytes>, x: Bytes| out.concat(x.split(sep)))).map(|s: Bytes| {
    let from = range(0, s.len()).fold(s.len(), |at: Int, k: Int|
      if at == s.len() && s.at(k) != 32 { k } else { at });
    s.slice(from, s.len())
  })

/// The name a piece of C declares, `<type> name`.
fn declared_name(s: Bytes) -> Option<Bytes> / {abort.raise} =
  [b"Word", b"int64_t", b"int", b"double", b"bool", b"PlyMaybe", b"PlyTagged", b"PlyDec"].fold(
    None,
    |acc: Option<Bytes>, t: Bytes| {
      let head = t.concat(b" ");
      match acc {
        Some(_) -> acc,
        None -> if !s.starts_with(head) { None } else {
          let rest = s.slice(head.len(), s.len());
          let n = name_length(rest);
          if n == 0 { None } else { Some(rest.slice(0, n)) }
        },
      }
    },
  )

/// The name a piece of C sets, `name = …`.
fn set_name(s: Bytes) -> Option<Bytes> / {abort.raise} = {
  let n = name_length(s);
  if n > 0 && s.slice(n, s.len()).starts_with(b" = ") { Some(s.slice(0, n)) } else { None }
}

/// How many of `s`'s first bytes spell a C name.
fn name_length(s: Bytes) -> Int =
  range(0, s.len()).fold({ n: 0, open: true }, |acc: { n: Int, open: Bool }, k: Int| {
    let b = s.at(k);
    if acc.open
        && (b == 95 || (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122)) {
      { n: acc.n + 1, open: true }
    } else { { ..acc, open: false } }
  }).n

test "every function the calling corpus prints sets only names it declares" {
  // What a build prints of a form: nothing where its callers settle it.
  let left_of = |f: Fn| {
    let built = built_form(f);
    if settled_by_callers(built.links.needs) { [] }
    else { undeclared(printed_text(corpus_program(), built)) }
  };
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let roots = names().fold([], |acc: List<{ name: Bytes, names: List<Bytes> }>, n: Bytes|
        match lowered_as_built(p, n) {
          Err(_) -> acc,
          Ok(f) -> {
            let left = left_of(f);
            if left.len() == 0 { acc } else { acc.push({ name: n, names: left }) }
          },
        });
      assert_eq(
        groups().fold(roots, |acc: List<{ name: Bytes, names: List<Bytes> }>, g: List<Bytes>|
          match group_form(g) {
            Err(_) -> acc,
            Ok(f) -> {
              let left = left_of(f);
              if left.len() == 0 { acc }
              else { acc.push({ name: match g.at(0) { Some(n) -> n, None -> b"" }, names: left }) }
            },
          }),
        [],
      )
    },
  }
}

test "every root and tail group of the calling corpus lowers, keeps the form's rules and prints, or another family declines a root" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let failed = names().fold([], |acc: List<{ name: Bytes, why: Bytes }>, n: Bytes|
        match lowered_as_built(p, n) {
          Err(no) -> if no.by != Calling { acc } else { acc.push({ name: n, why: no.why }) },
          Ok(f) -> match unbuilt(p, f) {
            Some(why) -> acc.push({ name: n, why: why }),
            None -> acc,
          },
        });
      let grouped = groups().fold(
        failed,
        |acc: List<{ name: Bytes, why: Bytes }>, g: List<Bytes>| {
          let first = match g.at(0) { Some(n) -> n, None -> b"" };
          match group_form(g) {
            Err(why) -> acc.push({ name: first, why: why }),
            Ok(f) -> match unbuilt(p, f) {
              Some(why) -> acc.push({ name: first, why: why }),
              None -> acc,
            },
          }
        },
      );
      assert_eq(grouped, [])
    },
  }
}

/// Each call of a root by its key in `f`'s body and its closures' bodies, with the convention it
/// was written to.
fn root_calls(f: Fn) -> List<{ callee: RootKey, conv: Convention }> =
  f.lambdas.fold(
    vals_in(f.body).fold([], |acc: List<{ callee: RootKey, conv: Convention }>, v: Val|
      match v {
        Call(c) -> match c.callee { Root(k) -> acc.push({ callee: k, conv: c.conv }), _ -> acc },
        _ -> acc,
      }),
    |acc: List<{ callee: RootKey, conv: Convention }>, l: Lambda|
      match l { Closure(c) -> acc.concat(root_calls(c.body)) },
  )

test "every call of a root the corpus defines is written to the head the root is declared with" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let heads = names().fold(
        Map::new(),
        |m: Map<RootName, { answer: Bytes, params: List<Bytes> }>, n: Bytes|
          match lowered_as_built(p, n) {
            Ok(f) -> m.insert(root_name(Named(qualify(b"m", n))), head_types(f.conv)),
            Err(_) -> m,
          },
      );
      assert_eq(
        names().fold([], |acc: List<{ caller: Bytes, callee: RootName }>, n: Bytes|
          match lowered_as_built(p, n) {
            Err(_) -> acc,
            Ok(f) ->
              root_calls(f).fold(
                acc,
                |a: List<{ caller: Bytes, callee: RootName }>, c: { callee: RootKey, conv: Convention }|
                  match heads.get(root_name(c.callee)) {
                    Some(h) -> if h == head_types(c.conv) { a }
                    else { a.push({ caller: n, callee: root_name(c.callee) }) },
                    None -> a,
                  },
              ),
          }),
        [],
      )
    },
  }
}

/// Whether `r` holds a record of five `Int`s crossing a call by reference.
fn wide(r: Rep) -> Bool =
  match r { RFlat(ls) -> ls.len() == 5 && passing(r) == ByReference, _ -> false }

test "a record wider than four words crosses a call by reference, its answer through the caller's buffer" {
  match form(b"wide_twice") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(
        root_calls(f).map(|c: { callee: RootKey, conv: Convention }|
          c.conv.reps.map(wide).push(wide(c.conv.answer))),
        [[false, true], [true, false]],
      );
      assert_eq(undeclared(printed_text(corpus_program(), owned(f))), [])
    },
  }
}

test "a lent record wider than four words is read through a const pointer, never written through" {
  match form(b"wide_loop") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      let lent = { ..f, conv: { ..f.conv, params: f.conv.params.set(0, Lent) } };
      assert_eq(head_types(lent.conv).params.at(0), Some(b"const Word*"));
      // A restart sets its own locals of the record's values, never the caller's words.
      let written = printed_text(corpus_program(), lent).split(b"\n").filter(|l: Bytes|
        match l.index_of(b" = ") {
          Some(i) -> l.slice(0, i).index_of(b"p0[") != None,
          None -> false,
        });
      assert_eq(written, [])
    },
  }
}

test "a closure and a function value take a record wider than four words by reference too" {
  match form(b"wide_reader") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> match closure_of(f, 0) {
      None -> assert(false, Some("wide_reader makes no closure")),
      Some(c) -> assert_eq(c.body.conv.reps.drop(c.captures).map(wide), [true]),
    },
  };
  match form(b"wide_applied") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(
        vals_in(f.body).fold([], |acc: List<Bool>, v: Val|
          match v { Apply(a) -> acc.concat(a.conv.reps.map(wide)), _ -> acc }),
        [true],
      ),
  }
}

test "a tail group's member takes a record by reference, its wrapper handing on its caller's buffer itself" {
  match group_form([b"wide_even", b"wide_odd"]) {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(f.members.map(|m: Member| m.conv.reps.map(wide)), [[true, false], [true, false]]);
      let text = printed_text(corpus_program(), owned(f));
      assert(
        text.index_of(symbol_of(b"m.wide_even").concat(b"_group(ctx, 0, (Word)(intptr_t)p0"))
          != None,
        Some(String::of_bytes_lossy(text)),
      )
    },
  }
}

test "a sum whose constructors take nothing crosses a call as its one word, its entry handing that word on" {
  match form(b"hue_twice") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(
        root_calls(f).map(|c: { callee: RootKey, conv: Convention }|
          c.conv.reps.push(c.conv.answer).map(|r: Rep|
            match r { RSum(_) -> values_of(r).len() == 1, _ -> false })),
        [[true, true], [true, true]],
      ),
  };
  match form(b"hue_next") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      let text = printed_text(corpus_program(), owned(f));
      assert(text.index_of(b"->layout == ") == None, Some(String::of_bytes_lossy(text)))
    },
  }
}
