/// The corpus's tail groups, each by its members' names.
fn groups() -> List<List<Bytes>> =
  [[b"even", b"odd"], [b"walk", b"stride"], [b"seek", b"probe"], [b"ping", b"pong"]]

/// Root `m.<name>` of `p` lowered as a build lowers it: its body after `known_body`.
fn lowered_as_built(p: Program, name: Bytes) -> Result<Fn, Declined> / {abort.raise} =
  match match range(0, p.roots.len()).fold(None, |acc: Option<Int>, i: Int|
        match p.roots.at(i) {
          Some(r) -> if r.full == qualify(b"m", name) { Some(i) } else { acc },
          None -> acc,
        }) {
      Some(i) -> p.roots.at(i),
      None -> None,
    } {
    None -> Err({ by: Spine, why: b"no such definition" }),
    Some(r) -> match r.code {
      None -> Err({ by: Spine, why: b"a body that does not lower to Code" }),
      Some(code) -> {
        let body = known_body(r.full, r.params, code);
        lowered_fn(context_of(p.setting, r, body), body)
      },
    },
  }

/// The corpus's root `name` lowered, or why not.
fn form(name: Bytes) -> Result<Fn, Bytes> / {abort.raise} =
  match program_of(corpus()) {
    Err(why) -> Err(why),
    Ok(p) -> match lowered_as_built(p, name) { Ok(f) -> Ok(f), Err(no) -> Err(no.why) },
  }

/// Every value `b` binds or does, its branches', cases', arms' and loops' too, in order.
fn vals_in(b: Block) -> List<Val> =
  b.fold([], |acc: List<Val>, i: Inst|
    match i {
      Let(l) -> acc.push(l.val),
      Do(d) -> acc.push(d.val),
      If(x) -> acc.concat(vals_in(x.then)).concat(vals_in(x.otherwise)),
      Case(c) ->
        c.arms.fold(acc, |a: List<Val>, arm: { when: Int, body: Block }|
          a.concat(vals_in(arm.body))).concat(
          vals_in(c.rest),
        ),
      Match(m) ->
        m.arms.fold(acc, |a: List<Val>, arm: Block| a.concat(vals_in(arm))).concat(vals_in(m.rest)),
      Loop(l) -> acc.concat(vals_in(l.body)),
      _ -> acc,
    })

/// Whether a self call restarts `b` anywhere.
fn restarts(b: Block) -> Bool =
  b.fold(false, |found: Bool, i: Inst|
    found
      || (match i {
        Restart(_) -> true,
        If(x) -> restarts(x.then) || restarts(x.otherwise),
        _ -> false,
      }))

/// The body of closure `nth` of `f`, and how many of its parameters are captures.
fn closure_of(f: Fn, nth: Int) -> Option<{ body: Fn, captures: Int }> =
  match f.lambdas.at(nth) {
    Some(Closure(c)) -> Some({ body: c.body, captures: c.captures }),
    None -> None,
  }

test "a call of a definition hands its arguments as the callee carries them" {
  match form(b"twice") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(
        vals_in(f.body).fold([], |acc: List<{ reps: List<Rep>, answer: Rep }>, v: Val|
          match v {
            Call(c) -> if c.callee == Root(Named(b"m.add")) {
              acc.push({ reps: c.conv.reps, answer: c.conv.answer })
            } else { acc },
            _ -> acc,
          }),
        [{ reps: [RInt, RInt], answer: RInt }],
      ),
  };
  match form(b"handed") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(
        vals_in(f.body).fold([], |acc: List<List<Rep>>, v: Val|
          match v { Call(c) -> acc.push(c.conv.reps.push(c.conv.answer)), _ -> acc }),
        [[RWord, RWord]],
      ),
  }
}

test "a small record crosses a call as its fields and its word, both ways" {
  match form(b"summed") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(
        vals_in(f.body).fold([], |acc: List<{ reps: List<Rep>, answer: Rep }>, v: Val|
          match v {
            Call(c) -> if c.callee == Root(Named(b"m.swapped")) {
              acc.push({ reps: c.conv.reps, answer: c.conv.answer })
            } else { acc },
            _ -> acc,
          }),
        [
          {
            reps: [RFlat([{ name: b"x", rep: RInt }, { name: b"y", rep: RInt }])],
            answer: RFlat([{ name: b"x", rep: RInt }, { name: b"y", rep: RInt }]),
          },
        ],
      ),
  }
}

test "a lambda and a function value take a small record as its fields too" {
  let fields = RFlat([{ name: b"x", rep: RInt }, { name: b"y", rep: RInt }]);
  match form(b"pair_summer") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> match closure_of(f, 0) {
      None -> assert(false, Some("pair_summer makes no closure")),
      Some(c) ->
        assert_eq(c.body.conv.reps.drop(c.captures).push(c.body.conv.answer), [fields, RInt]),
    },
  };
  match form(b"applied_pair") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(
        vals_in(f.body).fold([], |acc: List<List<Rep>>, v: Val|
          match v { Apply(a) -> acc.push(a.conv.reps.push(a.conv.answer)), _ -> acc }),
        [[fields, RInt]],
      ),
  }
}

test "a call of a generic definition is the body's generic call at the reference's type arguments" {
  match form(b"ident_int") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(f.links.generics, [{ callee: b"m.ident", args: [b"Int"], carried: [0], fns: [] }]);
      assert_eq(
        vals_in(f.body).fold([], |acc: List<List<Rep>>, v: Val|
          match v {
            Call(c) -> if c.callee == Generic(0) { acc.push(c.conv.reps.push(c.conv.answer)) }
            else { acc },
            _ -> acc,
          }),
        [[RInt, RInt]],
      )
    },
  };
  // A word crosses as itself at any type, so the call carries no variable raw.
  match form(b"ident_word") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(f.links.generics, [
        { callee: b"m.ident", args: [b"String"], carried: [], fns: [] },
      ]),
  }
}

test "a self call in tail position restarts the body, and a lambda's call of its root's definition calls it" {
  match form(b"count") { Err(why) -> assert_eq(why, b""), Ok(f) -> assert(restarts(f.body), None) };
  match form(b"counter") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> match closure_of(f, 0) {
      None -> assert(false, Some("counter makes no closure")),
      Some(c) -> {
        assert(!restarts(c.body.body), None);
        assert_eq(
          vals_in(c.body.body).filter(|v: Val|
            match v { Call(x) -> x.callee == Root(Named(b"m.count")), _ -> false }).len(
          ),
          1,
        )
      },
    },
  }
}

test "a lambda is a closure of a function of its own taking its captures as words, then its parameters" {
  match form(b"adder") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(f.lambdas.len(), 1);
      assert_eq(
        vals_in(f.body).fold(
          [],
          |acc: List<{ captures: Int, params: Int, stacked: Bool, args: Int }>, v: Val|
            match v {
              Make(m) -> match m.made {
                MClosure(c) -> if c.nth == 0 {
                  acc.push({
                    captures: c.captures,
                    params: c.params,
                    stacked: c.stacked,
                    args: m.args.len(),
                  })
                } else { acc },
                _ -> acc,
              },
              _ -> acc,
            },
        ),
        [{ captures: 1, params: 1, stacked: false, args: 1 }],
      );
      match closure_of(f, 0) {
        None -> assert(false, Some("adder makes no closure")),
        Some(c) -> {
          assert_eq(c.captures, 1);
          assert_eq(c.body.conv.reps, [RWord, RInt]);
          assert_eq(c.body.conv.answer, RInt);
          // The captured `Int` stays its word until the body reads it as an `Int` to add it.
          assert_eq(
            vals_in(c.body.body).filter(|v: Val|
              match v { Pack(k) -> k.to == RInt, _ -> false }).len(
            ),
            1,
          )
        },
      }
    },
  }
}

test "a lambda a lambda writes is the root's next closure, numbered in the order they are written" {
  match form(b"nested") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(f.lambdas.len(), 2);
      match closure_of(f, 0) {
        None -> assert(false, Some("nested makes no closure")),
        Some(outer) ->
          assert_eq(
            vals_in(outer.body.body).fold([], |acc: List<{ nth: Int, captures: Int }>, v: Val|
              match v {
                Make(m) -> match m.made {
                  MClosure(c) -> acc.push({ nth: c.nth, captures: c.captures }),
                  _ -> acc,
                },
                _ -> acc,
              }),
            [{ nth: 1, captures: 2 }],
          ),
      }
    },
  }
}

test "a definition named as a value is the unit's closure over its entry, and a pure one of no parameters is read once" {
  match form(b"named") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) ->
      assert_eq(
        vals_in(f.body).filter(|v: Val|
          match v {
            Op(o) -> o.op == OCalling(EntryValue({ callee: Root(Named(b"m.add")), arity: 2 })),
            _ -> false,
          }).len(
        ),
        1,
      ),
  };
  match form(b"read_kept") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      let vs = vals_in(f.body);
      assert_eq(
        vs.filter(|v: Val|
          match v {
            Op(o) -> o.op == OCalling(ConstantRead(Root(Named(b"m.kept")))),
            _ -> false,
          }).len(
        ),
        1,
      );
      // The kept word is opened to the `Int` it holds.
      assert_eq(vs.filter(|v: Val| match v { Pack(k) -> k.to == RInt, _ -> false }).len(), 1);
      assert_eq(vs.filter(|v: Val| match v { Call(_) -> true, _ -> false }).len(), 0)
    },
  }
}

test "a lambda handed where its callee lends it lies on the caller's stack, and the call is settled with it" {
  match form(b"lends") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      let vs = vals_in(f.body);
      assert_eq(
        vs.fold([], |acc: List<Bool>, v: Val|
          match v {
            Make(m) -> match m.made { MClosure(c) -> acc.push(c.stacked), _ -> acc },
            _ -> acc,
          }),
        [true],
      );
      assert_eq(f.links.generics, [
        {
          callee: b"m.apply_to",
          args: [b"Int"],
          carried: [0],
          fns: [{ param: 0, owner: b"m.lends", nth: 0 }],
        },
      ]);
      assert_eq(
        vs.filter(|v: Val| match v { Call(c) -> c.callee == Generic(0), _ -> false }).len(),
        1,
      )
    },
  }
}

test "a function value is applied through the convention its type has, and the parameter is noted as called" {
  match form(b"applied") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(
        vals_in(f.body).fold([], |acc: List<List<Rep>>, v: Val|
          match v { Apply(a) -> acc.push(a.conv.reps.push(a.conv.answer)), _ -> acc }),
        [[RInt, RInt]],
      );
      assert_eq(f.links.called, [0])
    },
  }
}

test "a lambda a let binds and a call runs in place reads its captures off its closure" {
  match form(b"local") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      let vs = vals_in(f.body);
      assert_eq(vs.filter(|v: Val| match v { Apply(_) -> true, _ -> false }).len(), 0);
      assert_eq(
        vs.filter(|v: Val| match v { Op(o) -> o.op == OCalling(Ticked), _ -> false }).len(),
        1,
      );
      assert_eq(
        vs.filter(|v: Val| match v { Get(g) -> g.path == PCapture(0), _ -> false }).len(),
        1,
      )
    },
  }
}

test "a step whose every arm makes its Continue or Stop goes on or leaves at once, making no object" {
  let made = |f: Fn|
    vals_in(f.body).filter(|v: Val|
      match v { Make(m) -> match m.made { MCtor(_) -> true, _ -> false }, _ -> false }).len(
    );
  let looped = |f: Fn| f.body.filter(|i: Inst| match i { Loop(_) -> true, _ -> false }).len();
  match form(b"steps") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(looped(f), 1);
      assert_eq(made(f), 0)
    },
  };
  // A `match` with a guard, as well as an `if`.
  match form(b"count_down") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(looped(f), 1);
      assert_eq(made(f), 0)
    },
  }
}

test "a step's loop prints as a C for over its state, spending its budget before each pass" {
  match form(b"stepped") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      let lines = printed_text(f).split(b"\n").map(|l: Bytes|
        l.slice(
          range(0, l.len()).fold(l.len(), |at: Int, i: Int|
            if at < l.len() || l.at(i) == 32 { at } else { i }),
          l.len(),
        ));
      assert(lines.contains(b"for (;;) {"), None);
      assert(lines.contains(b"continue;"), None);
      assert(lines.contains(b"break;"), None);
      assert(lines.filter(|l: Bytes| l.starts_with(b"rt_iterate_bad_p(ctx, ")).len() == 1, None)
    },
  }
}

test "a step iterate runs is a loop over its state and budget, each pass going on or leaving as its Iter says" {
  match form(b"stepped") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> match f.body.fold(None, |acc: Option<Inst>, i: Inst|
        match i { Loop(_) -> Some(i), _ -> acc }) {
      Some(Loop(l)) -> {
        assert_eq(l.state.map(|v: Var| v.rep), [RInt, RInt]);
        assert_eq(l.answer.rep, RInt);
        // The pass ends testing the `Iter` the step answered: a `Continue` goes on, a `Stop` leaves.
        match l.body.at(l.body.len() - 1) {
          Some(Case(c)) -> {
            assert_eq(c.test, TTag([b"Continue", b"Stop"]));
            assert_eq(
              c.arms.map(|a: { when: Int, body: Block }|
                match a.body.at(a.body.len() - 1) {
                  Some(Next(_)) -> 0,
                  Some(Done(_)) -> 1,
                  _ -> 2,
                }),
              [0, 1],
            )
          },
          other -> assert_eq(other, None),
        }
      },
      _ -> assert(false, Some("the step is no loop")),
    },
  }
}

/// Where the corpus's root `name` stands among the analysed program's roots.
fn root_at(p: Program, name: Bytes) -> Option<Int> =
  range(0, p.roots.len()).fold(None, |acc: Option<Int>, i: Int|
    match p.roots.at(i) {
      Some(r) -> if r.full == qualify(b"m", name) { Some(i) } else { acc },
      None -> acc,
    })

/// The corpus's root `name` lowered as a build lowers its specialisation at `args` running `fns`,
/// each parameter `lent` names running that lambda: keyed by the name that spells it, its body's
/// types read at `args`; or why not.
fn specialised_form(
  p: Program,
  name: Bytes,
  args: List<Type>,
  fns: List<FnArg>,
  lent: List<Option<BoundLambda>>,
) -> Result<Fn, Bytes> / {abort.raise} =
  match match root_at(p, name) { Some(i) -> p.roots.at(i), None -> None } {
    None -> Err(b"no such root"),
    Some(r) -> match r.code {
      None -> Err(b"a root of no code"),
      Some(code) -> {
        let full = specialised_with(r.full, args, fns);
        let params = range(0, r.params.len()).map(|i: Int|
          match lent.at(i) {
            Some(Some(bl)) -> { ..r.params.get(i), lambda: Some(bl) },
            _ -> r.params.get(i),
          });
        let body = known_body(full, params, code);
        let setting = { ..p.setting, typed: typed_at(p.setting.typed, args) };
        match lowered_fn(context_of(setting, { ..r, full: full, params: params }, body), body) {
          Ok(f) -> Ok(f),
          Err(no) -> Err(no.why),
        }
      },
    },
  }

/// Generic root `generic` of `p` at `args` as the specialisation a build lowers where root `lender`
/// hands its parameter `param` the first lambda it writes, typed as a build types it, with its
/// lender's whole body; and the lender's base; or why not.
fn lent_run(
  p: Program,
  lender: Bytes,
  generic: Bytes,
  args: List<Type>,
  param: Int,
) -> Result<{ f: Fn, base: Int }, Bytes> / {abort.raise} =
  match match root_at(p, lender) { Some(i) -> p.roots.at(i), None -> None } {
    None -> Err(b"no such lender"),
    Some(l) -> match l.code {
      None -> Err(b"a lender of no code"),
      Some(code) -> {
        let written = lambdas_of(known_body(l.full, l.params, code));
        match written.at(0) {
          None -> Err(b"a lender that writes no lambda"),
          Some(first) -> {
            let bound = {
              owner: l.full,
              nth: 0,
              code: first,
              named: false,
              module: b"m",
              here: p.setting.here,
              imports: p.setting.imports,
              effects: p.setting.effects,
              typed: node_types(p.setting.typed, l.params.map(|q: EmitParam| q.of), code),
              operands: Map::new(),
              base: l.base,
              written: written,
            };
            match specialised_form(
                p,
                generic,
                args,
                [{ param: param, owner: l.full, nth: 0 }],
                range(0, param + 1).map(|i: Int| if i == param { Some(bound) } else { None }),
              ) {
              Ok(f) -> Ok({ f: f, base: l.base }),
              Err(why) -> Err(why),
            }
          },
        }
      },
    },
  }

test "another root's lambda a specialisation runs in place takes its lender's sites, and only there" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match lent_run(
        p,
        b"lends_word",
        b"apply_to",
        [TyCon({ name: b"String", args: [] })],
        0,
      ) {
      Err(why) -> assert_eq(why, b""),
      Ok(run) -> {
        assert_eq(
          run.f.body.fold([], |acc: List<Inst>, i: Inst|
            match i { Sited(_) -> acc.push(i), _ -> acc }),
          [Sited(Some({ root: Named(b"m.lends_word"), base: run.base })), Sited(None)],
        );
        assert_eq(
          vals_in(run.f.body).filter(|v: Val| match v { Apply(_) -> true, _ -> false }).len(),
          0,
        );
        assert_eq(
          vals_in(run.f.body).filter(|v: Val|
            match v { Get(g) -> g.path == PCapture(0), _ -> false }).len(
          ),
          1,
        )
      },
    },
  }
}

test "a lent lambda's own lambdas are its lender's: one it binds runs in place, its closures take the lender's sites, one it hands on is lent by the lender" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match lent_run(p, b"lends_on", b"apply_to", [int_type()], 0) {
      Err(why) -> assert_eq(why, b""),
      Ok(run) -> {
        let lent = Sited(Some({ root: Named(b"m.lends_on"), base: run.base }));
        assert_eq(
          range(0, run.f.lambdas.len()).map(|k: Int|
            match closure_of(run.f, k) { Some(c) -> c.body.body.at(0), None -> None }),
          [Some(lent), Some(lent)],
        );
        assert_eq(
          vals_in(run.f.body).filter(|v: Val| match v { Apply(_) -> true, _ -> false }).len(),
          0,
        );
        assert_eq(run.f.links.generics.map(|g: GenericCall| g.fns), [
          [{ param: 0, owner: b"m.lends_on", nth: 1 }],
        ])
      },
    },
  }
}

/// The operators root `lender`'s lambda does over `Int`s where `fold_from` at `args` runs it in place,
/// and how many it hands the runtime as words; or why it was not formed.
fn folded_ops(
  p: Program,
  lender: Bytes,
  args: List<Type>,
) -> Result<{ c: List<Bytes>, runtime: Int }, Bytes> / {abort.raise} =
  match lent_run(p, lender, b"fold_from", args, 3) {
    Err(why) -> Err(why),
    Ok(run) -> {
      let vals = vals_in(run.f.body);
      Ok({
        c: vals.fold([], |acc: List<Bytes>, v: Val|
          match v {
            Prim(x) -> if x.on == RInt && x.op != b"ge" { acc.push(x.op) } else { acc },
            _ -> acc,
          }),
        runtime: vals.filter(|v: Val|
          match v { Native(n) -> n.name == b"rt_binary_p", _ -> false }).len(
        ),
      })
    },
  }

test "a lent lambda run where its arguments and captures arrive as a type variable's or an erased word reads them at the types it was written for" {
  let src = Bytes::concat_all([
    b"fn fold_from<T, A>(xs: List<T>, i: Int, acc: A, f: (A, T) -> A) -> A =\n",
    b"  match xs.at(i) { Some(x) -> fold_from(xs, i + 1, f(acc, x), f), None -> acc }\n",
    b"fn bits(n: Int) -> Int =\n",
    b"  fold_from(range(1, 7), 0, 0, |found: Int, b: Int| if 1 << b == n { b } else { found })\n",
    b"fn digits(n: Int) -> Option<Int> =\n",
    b"  fold_from(range(0, n), 0, Some(0), |so_far: Option<Int>, d: Int|\n",
    b"    match so_far { Some(v) -> Some(v * 10 + d), None -> None })\n",
  ]);
  let erased = TyCon({ name: b"Option", args: [TyCon({ name: b"_", args: [] })] });
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      assert_eq(
        folded_ops(p, b"bits", [unknown_type(), int_type()]),
        Ok({ c: [b"add", b"shl", b"eq"], runtime: 0 }),
      );
      assert_eq(
        folded_ops(p, b"digits", [unknown_type(), erased]),
        Ok({ c: [b"add", b"mul", b"add"], runtime: 0 }),
      )
    },
  }
}

/// The corpus's roots `names` lowered as one tail group, or why not.
fn group_form(names: List<Bytes>) -> Result<Fn, Bytes> / {abort.raise} =
  match program_of(corpus()) {
    Err(why) -> Err(why),
    Ok(p) -> {
      let members = names.fold([], |acc: List<GroupMember>, n: Bytes|
        match range(0, p.roots.len()).fold(None, |found: Option<GroupMember>, i: Int|
            match p.roots.at(i) {
              Some(r) -> if r.full != qualify(b"m", n) { found } else {
                match r.code {
                  Some(code) -> {
                    let body = known_body(r.full, r.params, code);
                    Some({ cx: context_of(p.setting, r, body), body: body })
                  },
                  None -> found,
                }
              },
              None -> found,
            }) {
          Some(m) -> acc.push(m),
          None -> acc,
        });
      match lowered_group(members) { Ok(f) -> Ok(f), Err(no) -> Err(no.why) }
    },
  }

/// Every instruction `b` holds, its branches' and cases' too.
fn insts_in(b: Block) -> List<Inst> =
  b.fold([], |acc: List<Inst>, i: Inst|
    match i {
      If(x) -> acc.push(i).concat(insts_in(x.then)).concat(insts_in(x.otherwise)),
      Case(c) ->
        c.arms.fold(
          acc.push(i).concat(insts_in(c.rest)),
          |a: List<Inst>, arm: { when: Int, body: Block }| a.concat(insts_in(arm.body)),
        ),
      _ -> acc.push(i),
    })

test "a tail group is one root whose case runs each member, a tail call into another member entering it" {
  match group_form([b"even", b"odd"]) {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(f.members.map(|m: Member| m.key), [Named(b"m.even"), Named(b"m.odd")]);
      assert_eq(f.members.map(|m: Member| m.params.map(|v: Var| v.rep)), [[RInt], [RInt]]);
      assert_eq(
        insts_in(f.body).fold([], |acc: List<Int>, i: Inst|
          match i { Enter(e) -> acc.push(e.member), _ -> acc }),
        [1, 0],
      );
      assert_eq(
        insts_in(f.body).filter(|i: Inst| match i { Restart(_) -> true, _ -> false }).len(),
        0,
      )
    },
  }
}

/// Whether a value held as `r` crosses as several values.
fn parted(r: Rep) -> Bool = match r { RFlat(_) -> true, RCases(_) -> true, _ -> false }

test "a tail group's members take and answer a record as its fields and a sum as its cases, their wrappers handing the group's function words" {
  match group_form([b"walk", b"stride"]) {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(f.members.map(|m: Member| m.conv.reps.push(m.conv.answer).map(parted)), [
        [true, false, true],
        [true, false, true],
      ]);
      assert_eq(
        insts_in(f.body).fold([], |acc: List<Int>, i: Inst|
          match i { Enter(e) -> acc.push(e.member), _ -> acc }),
        [1, 0],
      );
      let text = printed_text(owned(f));
      assert(text.index_of(symbol_of(b"m.walk").concat(b"_group(ctx, 0, ply_g0, ")) != None);
      assert(text.index_of(b"  *o1 = v_1;\n  *o2 = v_2;\n  return v_0;\n") != None)
    },
  };
  match group_form([b"seek", b"probe"]) {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(f.members.map(|m: Member| m.conv.reps.push(m.conv.answer).map(parted)), [
        [true, false, true],
        [true, false, true],
      ]);
      let text = printed_text(owned(f));
      assert(
        text.index_of(symbol_of(b"m.seek").concat(b"_group(ctx, 0, rt_maybe_take_p(ctx, ply_g0), "))
          != None,
      );
      assert(text.index_of(b"  *o3 = v_3;\n  return v_0;\n") != None)
    },
  }
}

test "a closure a later member of a tail group writes fails at that member's sites" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match group_form([b"ping", b"pong"]) {
      Err(why) -> assert_eq(why, b""),
      Ok(f) -> {
        let base = match match root_at(p, b"pong") { Some(i) -> p.roots.at(i), None -> None } {
          Some(r) -> r.base,
          None -> 0 - 1,
        };
        assert_eq(
          range(0, f.lambdas.len()).map(|k: Int|
            match closure_of(f, k) { Some(c) -> c.body.body.at(0), None -> None }),
          [Some(Sited(Some({ root: Named(b"m.pong"), base: base })))],
        )
      },
    },
  }
}

test "a specialisation, keyed by the name that spells it, restarts its own tail calls" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> match specialised_form(p, b"go", [int_type()], [], []) {
      Err(why) -> assert_eq(why, b""),
      Ok(f) -> {
        assert_eq(
          insts_in(f.body).filter(|i: Inst| match i { Restart(_) -> true, _ -> false }).len(),
          1,
        );
        assert_eq(vals_in(f.body).filter(|v: Val| match v { Call(_) -> true, _ -> false }).len(), 0)
      },
    },
  }
}

/// The block of the first loop `b` runs.
fn loop_in(b: Block) -> Option<Block> =
  b.fold(None, |acc: Option<Block>, i: Inst|
    match acc { Some(_) -> acc, None -> match i { Loop(l) -> Some(l.body), _ -> None } })

test "a step whose join more of its pass follows runs the rest of the pass, then tests the `Iter` it answers" {
  match form(b"raised_step") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> match loop_in(f.body) {
      None -> assert(false, Some("no loop")),
      Some(pass) -> {
        assert(match pass.at(pass.len() - 1) {
          Some(Case(c)) -> c.test == TTag([b"Continue", b"Stop"]),
          _ -> false,
        });
        assert_eq(
          vals_in(pass).filter(|v: Val|
            match v { Make(m) -> match m.made { MCtor(_) -> true, _ -> false }, _ -> false }).len(
          ),
          2,
        )
      },
    },
  }
}

test "a restart and a loop over a record set its parameter or state value by value" {
  match form(b"walk1") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      let text = printed_text(owned(f));
      assert(text.index_of(b" p0_0 = ") != None);
      assert(text.index_of(b" p0_2 = ") != None);
      assert(text.index_of(b" p0 = ") == None)
    },
  };
  match form(b"paired_step") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> {
      assert_eq(
        f.body.fold([], |acc: List<Bool>, i: Inst|
          match i { Loop(l) -> acc.concat(l.state.map(|v: Var| parted(v.rep))), _ -> acc }),
        [true, false],
      );
      assert_eq(undeclared(printed_text(owned(f))), [])
    },
  }
}

test "a continuation is a word the runtime calls with words, and a clause binding one answers the very word it hands back" {
  let applied = |f: Fn| vals_in(f.body).filter(|v: Val| match v { Apply(_) -> true, _ -> false });
  let clause_of = |f: Fn|
    range(0, f.lambdas.len()).fold(None, |acc: Option<Fn>, k: Int|
      match closure_of(f, k) {
        Some(c) -> if applied(c.body).len() > 0 { Some(c.body) } else { acc },
        None -> acc,
      });
  let conventions = |c: Fn|
    applied(c).map(|v: Val| match v { Apply(a) -> a.conv.reps.push(a.conv.answer), _ -> [] });
  let resumed = |c: Fn|
    c.body.fold([], |acc: List<Var>, i: Inst|
      match i { Let(l) -> match l.val { Apply(_) -> acc.push(l.var), _ -> acc }, _ -> acc });
  let tail_only = |n: Bytes|
    match form(n) {
      Err(why) -> assert_eq(why, b""),
      Ok(f) -> match clause_of(f) {
        None -> assert(false, Some("no clause calls its continuation")),
        Some(c) -> {
          assert_eq(c.conv.answer, RWord);
          assert_eq(conventions(c), [[RWord, RWord]]);
          assert_eq(resumed(c).map(|v: Var| c.body.contains(Return(AVar(v)))), [true]);
          assert_eq(
            vals_in(c.body).filter(|v: Val|
              match v { Pack(k) -> resumed(c).any(|r: Var| k.arg == AVar(r)), _ -> false }).len(
            ),
            0,
          )
        },
      },
    };
  tail_only(b"tailed");
  tail_only(b"gauged");
  match form(b"both") {
    Err(why) -> assert_eq(why, b""),
    Ok(f) -> match clause_of(f) {
      None -> assert(false, Some("no clause calls its continuation")),
      Some(c) -> {
        assert_eq(c.conv.answer, RWord);
        assert_eq(conventions(c), [[RWord, RWord], [RWord, RWord]])
      },
    },
  }
}

/// The C functions of `text`, each its lines from the head at column 0 that opens it to the `}`
/// that closes it.
fn functions_of(text: Bytes) -> List<List<Bytes>> / {abort.raise} =
  text.split(b"\n").fold(
    { done: [], open: None },
    |acc: { done: List<List<Bytes>>, open: Option<List<Bytes>> }, l: Bytes|
      match acc.open {
        None -> if !l.starts_with(b" ") && l.ends_with(b"{") { { ..acc, open: Some([l]) } }
        else { acc },
        Some(o) -> if l == b"}" { { done: acc.done.push(o), open: None } }
        else { { ..acc, open: Some(o.push(l)) } },
      },
  ).done

/// The names a C function `text` holds sets, `name = …`, that the same function declares nowhere.
fn undeclared(text: Bytes) -> List<Bytes> / {abort.raise} =
  functions_of(text).fold([], |acc: List<Bytes>, f: List<Bytes>| {
    let pieces = f.fold([], |s: List<Bytes>, l: Bytes| s.concat(statements_of(l)));
    let declared = pieces.fold([], |d: List<Bytes>, s: Bytes|
      match declared_name(s) { Some(n) -> d.push(n), None -> d });
    pieces.fold(acc, |a: List<Bytes>, s: Bytes|
      match set_name(s) {
        Some(n) -> if declared.contains(n) || a.contains(n) { a } else { a.push(n) },
        None -> a,
      })
  })

/// A line of C cut at each `;`, `,`, parenthesis and brace, each piece without its leading spaces.
fn statements_of(l: Bytes) -> List<Bytes> / {abort.raise} =
  [b";", b",", b"(", b")", b"{", b"}"].fold([l], |ps: List<Bytes>, sep: Bytes|
    ps.fold([], |out: List<Bytes>, x: Bytes| out.concat(x.split(sep)))).map(|s: Bytes| {
    let from = range(0, s.len()).fold(s.len(), |at: Int, k: Int|
      if at == s.len() && s.at(k) != 32 { k } else { at });
    s.slice(from, s.len())
  })

/// The name a piece of C declares, `<type> name`.
fn declared_name(s: Bytes) -> Option<Bytes> / {abort.raise} =
  [b"Word", b"int64_t", b"int", b"double", b"bool", b"PlyMaybe", b"PlyTagged", b"PlyDec"].fold(
    None,
    |acc: Option<Bytes>, t: Bytes| {
      let head = t.concat(b" ");
      match acc {
        Some(_) -> acc,
        None -> if !s.starts_with(head) { None } else {
          let rest = s.slice(head.len(), s.len());
          let n = name_length(rest);
          if n == 0 { None } else { Some(rest.slice(0, n)) }
        },
      }
    },
  )

/// The name a piece of C sets, `name = …`.
fn set_name(s: Bytes) -> Option<Bytes> / {abort.raise} = {
  let n = name_length(s);
  if n > 0 && s.slice(n, s.len()).starts_with(b" = ") { Some(s.slice(0, n)) } else { None }
}

/// How many of `s`'s first bytes spell a C name.
fn name_length(s: Bytes) -> Int / {abort.raise} =
  range(0, s.len()).fold({ n: 0, open: true }, |acc: { n: Int, open: Bool }, k: Int| {
    let b = s.at(k);
    if acc.open
        && (b == 95 || (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122)) {
      { n: acc.n + 1, open: true }
    } else { { ..acc, open: false } }
  }).n

test "every function the calling corpus prints sets only names it declares" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let roots = names().fold([], |acc: List<{ name: Bytes, names: List<Bytes> }>, n: Bytes|
        match lowered_as_built(p, n) {
          Err(_) -> acc,
          Ok(f) -> {
            let left = undeclared(printed_text(owned(f)));
            if left.len() == 0 { acc } else { acc.push({ name: n, names: left }) }
          },
        });
      assert_eq(
        groups().fold(roots, |acc: List<{ name: Bytes, names: List<Bytes> }>, g: List<Bytes>|
          match group_form(g) {
            Err(_) -> acc,
            Ok(f) -> {
              let left = undeclared(printed_text(owned(f)));
              if left.len() == 0 { acc }
              else { acc.push({ name: match g.at(0) { Some(n) -> n, None -> b"" }, names: left }) }
            },
          }),
        [],
      )
    },
  }
}

/// Every run of lines two readings of one root's C differ in, spelled for a failure's message.
fn differences(today: Bytes, form: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    hunks(normalised(past_counts(today)), normalised(past_counts(form))).map(|h: Hunk|
      Bytes::concat_all([
        Bytes::concat_all(h.today.map(|l: Bytes| Bytes::concat_all([b"\n  - ", l]))),
        Bytes::concat_all(h.form.map(|l: Bytes| Bytes::concat_all([b"\n  + ", l]))),
        b"\n  ..",
      ])),
  )

test "the corpus's C reads as today's emitter's, but for the roots named with why" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let today = answered_today(p, names());
      let compared = names().filter(|n: Bytes| !groups().any(|g: List<Bytes>| g.contains(n))).fold(
        [],
        |acc: List<{ name: Bytes, at: Bytes }>, n: Bytes|
          match lowered_as_built(p, n) {
            Err(_) -> acc,
            Ok(f) -> {
              let at = differences(today_text(today, n), printed_text(owned(f)));
              if at == b"" { acc } else { acc.push({ name: n, at: at }) }
            },
          },
      );
      let differing = groups().fold(
        compared,
        |acc: List<{ name: Bytes, at: Bytes }>, g: List<Bytes>| {
          let first = match g.at(0) { Some(n) -> n, None -> b"" };
          let at = match group_form(g) {
            Ok(f) -> differences(today_text(today, first), printed_text(owned(f))),
            Err(why) -> why,
          };
          if at == b"" { acc } else { acc.push({ name: first, at: at }) }
        },
      );
      // Each root that differs on purpose, and why.
      let opened = b"a captured `Int` is opened into a local of its own before it is added, where today's emitter opens it inside the addition";
      let released = b"a failure path releases what the path holds, where today's emitter leaves without";
      let parts = b"a record a call answers comes back into its parts' locals, where today's emitter holds its word in a local declared first";
      let budget = b"the step is the form's `Loop`: its budget a state variable counted down by a checked subtraction, where today's emitter counts the budget parameter down in place";
      let resumed = b"a clause binding a continuation answers the word the continuation hands back, where today's emitter opens it as the clause's type";
      let opened_parts = b"a member's record or sum is opened into its parts where its arm starts and made a word again where it is answered or handed on, and its wrapper opens the answer into locals before writing them through its pointers, where today's emitter keeps the word and writes through the pointers as it opens it";
      let expected = [
        { name: b"adder", why: opened },
        { name: b"nested", why: opened },
        // And: the body run in place prints at its caller's depth, where today's indents it.
        { name: b"local", why: released },
        { name: b"lends", why: released },
        { name: b"steps", why: budget },
        { name: b"count_down", why: budget },
        // And: the `Iter` the step answers is tested by its tag and its argument read and opened.
        { name: b"stepped", why: budget },
        { name: b"lends_word", why: released },
        {
          name: b"pair_summer",
          why: b"a closure's entry loads a record parameter's fields on one line and its word into a local of its own",
        },
        { name: b"applied_pair", why: parts },
        // And: its captured `Int`s are opened as in `adder`.
        { name: b"lends_on", why: released },
        // And: the pass is not fused, so the `Iter` it answers is tested once the pass has run.
        { name: b"raised_step", why: budget },
        // And: the state is a record held as its parts.
        { name: b"paired_step", why: budget },
        {
          name: b"walk1",
          why: b"a record parameter is set value by value on a restart, its word among them, where today's emitter holds the word in a local",
        },
        { name: b"go", why: released },
        { name: b"tailed", why: resumed },
        { name: b"gauged", why: resumed },
        { name: b"both", why: resumed },
        // And: the rest of the switch returns through `ctx->fuel += 1;`.
        {
          name: b"even",
          why: b"a member's answer is made its word in its return, where today's emitter binds it first",
        },
        // And: each member's entry opens a record or a sum parameter on one line, as in `pair_summer`.
        { name: b"walk", why: opened_parts },
        { name: b"seek", why: opened_parts },
        {
          name: b"ping",
          why: b"a closure a later member writes is the group's, named and numbered among its closures and naming the member's sites by its id, where today's emitter names and numbers it as the member's",
        },
      ];
      assert(
        differing.map(|d: { name: Bytes, at: Bytes }| d.name)
          == expected.map(|e: { name: Bytes, why: Bytes }| e.name),
        Some(
          String::of_bytes(
            Bytes::concat_all(
              differing.map(|d: { name: Bytes, at: Bytes }|
                Bytes::concat_all([b"=== ", d.name, b" ", d.at])),
            ),
          ),
        ),
      )
    },
  }
}

test "every root and tail group of the calling corpus lowers and keeps the form's rules, or another family declines a root" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let failed = names().fold([], |acc: List<{ name: Bytes, why: Bytes }>, n: Bytes|
        match lowered_as_built(p, n) {
          Err(no) -> if no.by != Calling { acc } else { acc.push({ name: n, why: no.why }) },
          Ok(f) -> match verified(owned(f)) {
            Some(why) -> acc.push({ name: n, why: why }),
            None -> acc,
          },
        });
      let grouped = groups().fold(
        failed,
        |acc: List<{ name: Bytes, why: Bytes }>, g: List<Bytes>| {
          let first = match g.at(0) { Some(n) -> n, None -> b"" };
          match group_form(g) {
            Err(why) -> acc.push({ name: first, why: why }),
            Ok(f) -> match verified(owned(f)) {
              Some(why) -> acc.push({ name: first, why: why }),
              None -> acc,
            },
          }
        },
      );
      assert_eq(grouped, [])
    },
  }
}

/// The closures' functions of root `symbol`'s C `text`, each but for its body and its stack probe,
/// which the form writes otherwise: its declaration, head and step checks, its entries and its
/// descriptor.
fn closures_framed(text: Bytes, symbol: Bytes) -> List<Bytes> / {abort.raise} = {
  let lines = text.split(b"\n");
  let first = Bytes::concat_all([b"Word ", symbol, b"_lambda"]);
  match range(0, lines.len()).fold(None, |acc: Option<Int>, i: Int|
      match acc {
        Some(_) -> acc,
        None -> if lines.get(i).starts_with(first) { Some(i) } else { None },
      }) {
    None -> [],
    Some(s) ->
      lines.drop(s).fold(
        { inside: false, out: [] },
        |acc: { inside: Bool, out: List<Bytes> }, l: Bytes|
          if l == b"  ctx->fuel -= 1;" { { inside: true, out: acc.out.push(l) } }
          else if l == b"}" { { inside: false, out: acc.out.push(l) } }
          else if acc.inside || l.starts_with(b"  { char probe;") { acc }
          else { { ..acc, out: acc.out.push(l) } },
      ).out,
  }
}

test "a closure's function, its entries and its descriptor print as today's emitter writes them" {
  match program_of(corpus()) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let roots = [b"adder", b"doubler", b"nested", b"counter", b"local", b"lends"];
      let today = answered_today(p, roots);
      let differing = roots.fold(
        [],
        |acc: List<{ name: Bytes, today: List<Bytes>, form: List<Bytes> }>, n: Bytes| {
          let symbol = symbol_of(qualify(b"m", n));
          let old = closures_framed(today_text(today, n), symbol);
          let form = match lowered_as_built(p, n) {
            Ok(f) -> closures_framed(printed_text(f), symbol),
            Err(no) -> [no.why],
          };
          if old.len() > 0 && form == old { acc }
          else { acc.push({ name: n, today: old, form: form }) }
        },
      );
      assert_eq(differing, [])
    },
  }
}
