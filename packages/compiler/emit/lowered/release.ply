//! The plain roots written for the types a program declares, read off the layouts the layout module
//! gives them.

import compiler.check.types (Type, TyCon, TyRecord, int_type, string_type, list_type)
import compiler.check.known (task_type, chan_type)
import compiler.emit.compare (program_of, printed_by_form)
import compiler.emit.layout (LSum)
import compiler.emit.reps
import compiler.emit.reps (Ctors, SumCtor, ctors_of)
import compiler.emit.release (Part, WordAt, ByCase, CaseBox, Object, InBox, laid_parts, drop_of,
                              generated, case_dropped, never_kept, root_of, case_root)
import compiler.emit.keys
import compiler.emit.keys (RootKey, Named, TypeOp, Drop, Dup, Copy, Share, Keep, Lower, Lift,
                           Worded, written, root_name, root_text)
import compiler.emit.verify (verified)
import compiler.emit.tir (no_closure_words, Fn, Var, Block, Inst, Case, Opened, Let, If, Restart,
                          Dec, Return, LastOf, AVar, RWord, RSum, RInt, Rooted, Lent, Given, Owned,
                          Closure, no_links)
import compiler.emit.lend (conventions)
import compiler.emit.entry (built_form)
import compiler.emit.lower.crossing (worded)
import compiler.emit.print.invoked (lambda_text)
import compiler.emit.print.text (printing)
import compiler.emit.answer (SharedFn)
import compiler.emit.pieces (spelled)
import compiler.emit.roots (symbol_of)
import compiler.syntax.parsing (span_between)
import compiler.emit.print (printed_fn)
import std.math (ilog2)
import std.pace (paced)
import std.bytes (ascii_of_int)

fn corpus() -> Bytes =
  Bytes::concat_all([
    b"type Tree = | Leaf | Node(Tree, Int, Tree)\n",
    b"type Expr = | Num(Int) | Add(Expr, Expr) | Neg(Expr) | Name(String)\n",
    b"type Pair = { name: String, items: List<Int>, tree: Tree }\n",
    b"type Job = | Run((Int) -> Int, Int) | Idle\n",
    b"fn uses(t: Tree, e: Expr, p: Pair, j: Job) -> Int = 0\n",
  ])

fn declared(name: Bytes) -> Type = TyCon({ name: name, args: [] })

/// The corpus's constructor table, as the emitter is handed it.
fn corpus_ctors() -> Result<Ctors, Bytes> / {abort.raise} =
  match program_of(corpus()) { Ok(p) -> Ok(p.setting.ctors), Err(why) -> Err(why) }

/// Every instruction of `b`, through the arms of each `Case` and the branches of each `If`.
fn insts(b: Block) -> List<Inst> =
  b.fold([], |acc: List<Inst>, i: Inst|
    match i {
      Case(c) ->
        c.arms.fold(
          acc.push(i).concat(insts(c.rest)),
          |a: List<Inst>, arm: { when: Int, body: Block }| a.concat(insts(arm.body)),
        ),
      If(x) -> acc.push(i).concat(insts(x.then)).concat(insts(x.otherwise)),
      _ -> acc.push(i),
    })

/// The words the `Opened` of `b` bind, and the values its `Dec`s let go of, wherever they stand.
fn dropping(b: Block) -> { opened: List<Var>, decs: List<Var> } =
  insts(b).fold({ opened: [], decs: [] }, |acc: { opened: List<Var>, decs: List<Var> }, i: Inst|
    match i {
      Opened(o) -> { ..acc, opened: acc.opened.concat(o.words) },
      Dec(v) -> { ..acc, decs: acc.decs.push(v) },
      _ -> acc,
    })

test "a tree's drop root lets go of its left subtree and starts again on its right" {
  let tree = declared(b"m.Tree");
  match corpus_ctors() {
    Err(why) -> assert_eq(why, b""),
    Ok(ctors) -> {
      let f = generated(ctors, drop_of(tree));
      let all = insts(f.body);
      let opens = all.fold([], |acc: List<{ of: Var, words: List<Var> }>, i: Inst|
        match i { Opened(o) -> acc.push(o), _ -> acc });
      // The box's own words of its type, not the box itself as it is opened.
      let subtrees = dropping(f.body).opened.filter(|v: Var|
        v.ty == tree && !opens.any(|o: { of: Var, words: List<Var> }| o.of == v));
      assert_eq(subtrees.len(), 2);
      // The left is let go of, the right taken last and started on again, in a loop.
      assert(dropping(f.body).decs.contains(subtrees.get(0)), None);
      let last = all.fold(None, |found: Option<Var>, i: Inst|
        match i {
          Let(l) -> if l.val == LastOf(subtrees.get(1)) { Some(l.var) } else { found },
          _ -> found,
        });
      match last {
        Some(v) -> assert(all.contains(Restart([AVar(v)])), None),
        None -> assert(false, None),
      }
    },
  }
}

test "a wide sum is let go of by its case, each boxed case at its own root, which holds its sums whole" {
  let expr = declared(b"m.Expr");
  match corpus_ctors() {
    Err(why) -> assert_eq(why, b""),
    Ok(ctors) -> match reps::laid(ctors, expr) {
      LSum(s) -> {
        match laid_parts(ctors, expr, LSum(s), 0) {
          [ByCase(c)] ->
            assert_eq(
              c.cases.map(|k: { case: Int, parts: List<Part> }|
                k.parts.map(|p: Part| match p { WordAt(w) -> Some(w.how), ByCase(_) -> None })),
              [
                [Some(CaseBox({ sum: expr, case: 1 }))],
                [Some(CaseBox({ sum: expr, case: 2 }))],
                [Some(Object(drop_of(string_type())))],
              ],
            ),
          parts -> assert_eq(parts.len(), 1),
        };
        let add = case_dropped(
          ctors,
          Named(b"m.drop_add"),
          expr,
          1,
          |t: Type| reps::laid(ctors, t),
          |t: Type| reps::word_form(ctors, t),
        );
        let d = dropping(add.body);
        assert_eq(d.opened.map(|v: Var| v.ty), [expr, expr]);
        assert(d.opened.all(|v: Var| match v.rep { RSum(_) -> true, _ -> false }), None);
        assert_eq(d.decs, d.opened)
      },
      _ -> assert(false, None),
    },
  }
}

test "a record's box lets go of its pointers and of a sum it holds whole" {
  let pair = TyRecord([
    { name: b"items", ty: list_type(int_type()) },
    { name: b"name", ty: string_type() },
    { name: b"tree", ty: declared(b"m.Tree") },
  ]);
  match corpus_ctors() {
    Err(why) -> assert_eq(why, b""),
    Ok(ctors) -> {
      let f = generated(ctors, drop_of(pair));
      let d = dropping(f.body);
      assert_eq(d.opened.map(|v: Var| v.ty), [
        list_type(declared(b"Int")),
        declared(b"String"),
        declared(b"m.Tree"),
      ]);
      assert_eq(d.decs, d.opened);
      assert(match d.opened.get(2).rep { RSum(_) -> true, _ -> false }, None)
    },
  }
}

test "a type reaching a function value through a case's box is never kept, and a type holding itself is asked once" {
  match corpus_ctors() {
    Err(why) -> assert_eq(why, b""),
    Ok(ctors) -> {
      let held = |ty: Type|
        never_kept(ctors, InBox({ parts: [{ at: 0, ty: ty, rep: RWord }], words: 1 }));
      let plan = TyRecord([
        { name: b"job", ty: declared(b"m.Job") },
        { name: b"name", ty: string_type() },
      ]);
      assert_eq(held(declared(b"m.Tree")), false);
      assert_eq(held(declared(b"m.Expr")), false);
      assert_eq(held(declared(b"m.Job")), true);
      assert_eq(held(plan), true)
    },
  }
}

test "the keep roots of a chain of sums, each reaching every one before it, print at the pace of the chain" {
  let int = int_type();
  let sum = |k: Int| declared(b"m.S".concat(ascii_of_int(k)));
  // `m.S<k> = | A<k> | B<k>(List<m.S<k - 1>>)`, its first holding `first`.
  let chain = |n: Int, first: Type|
    ctors_of(
      [],
      [],
      [],
      range(0, n).fold(Map::new(), |m: Map<Bytes, List<SumCtor>>, k: Int|
        m.insert(b"m.S".concat(ascii_of_int(k)), [
          { name: b"m.A".concat(ascii_of_int(k)), index: 0, fields: [], params: [] },
          {
            name: b"m.B".concat(ascii_of_int(k)),
            index: 1,
            fields: [if k == 0 { first } else { list_type(sum(k - 1)) }],
            params: [],
          },
        ])),
    );
  let printed = |n: Int, first: Type| {
    let ctors = chain(n, first);
    range(0, n).fold(0, |acc: Int, k: Int| {
      let f = generated(ctors, root_of(Keep, sum(k)));
      acc + printed_fn(built_form(f), ctors).pieces.len()
    })
  };
  let log_linear = |n: Int| n * (ilog2(n) + 1);
  // Each kept: every root walks its case's list.
  paced(log_linear, |n: Int| printed(n, int));
  // None kept, a task at the chain's root: every root answers 0 at once.
  paced(log_linear, |n: Int| printed(n, task_type(int)))
}

test "a closure capturing a channel is kept as 0, its keep entry making no copy, and shares as before" {
  let int = int_type();
  let chan = chan_type(int);
  let body = {
    key: Named(b"m.outer"),
    kind: Rooted,
    params: [{ id: 0, ty: chan, rep: RWord }, { id: 1, ty: int, rep: RInt }],
    conv: {
      params: [{ handed: Lent, rep: RWord }, { handed: Given, rep: RInt }],
      answer: RInt,
      destined: false,
      answered: Owned,
    },
    answer_ty: int,
    body: [Return(AVar({ id: 1, ty: int, rep: RInt }))],
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  };
  let l = Closure({ body: body, captures: 1, at: span_between(0, 0), words: no_closure_words() });
  let printed = lambda_text(body, 0, l, printing(Map::new()));
  // The functions closures alike share, which the unit writes before the root, then the closure's.
  let text = Bytes::concat_all(
    printed.pr.shared.map(|s: SharedFn| s.text).push(spelled(printed.out)),
  );
  let name = symbol_of(b"m.outer").concat(b"_lambda0");
  // The C of the entry the closure's descriptor names at place `at`.
  let named = match text.index_of(name.concat(b"_desc = { ")) {
    Some(i) -> text.slice(i + name.len() + 10, text.len()),
    None -> b"",
  };
  let entries = named.slice(0, match named.index_of(b" };") { Some(e) -> e, None -> 0 }).split(
    b", ",
  );
  let defined = |at: Int|
    match text.index_of(entries.get(at).concat(b"(PlyCtx")) {
      Some(i) -> match text.index_of_from(b"\n}\n", i) { Some(j) -> text.slice(i, j), None -> b"" },
      None -> b"",
    };
  let said = Some(String::of_bytes_lossy(text));
  // Its keep entry answers 0 at once and copies nothing; its share entry answers 0 for the channel.
  let keep = defined(5);
  assert(
    keep.len() > 0 && keep.index_of(b"= 0;") != None && keep.index_of(b"rt_alloc") == None,
    said,
  );
  assert(defined(4).index_of(b"= 0;") != None, said)
}

/// Why root `k`, generated as `f`, is not written taking its operands as `written_handing` says, or
/// fails its check once counted under that handing.
fn handing_faults(k: RootKey, f: Fn) -> List<Bytes> / {abort.raise} = {
  let handed = conventions(f, Map::new());
  if handed.conv != f.conv {
    [root_text(root_name(k)).concat(b" takes otherwise than its handing")]
  } else {
    match verified(built_form(handed)) {
      Some(why) -> [root_text(root_name(k)).concat(b": ").concat(why)],
      None -> [],
    }
  }
}

test "each root written for a type takes its operands as its handing says, and is counted right so taken" {
  let expr = declared(b"m.Expr");
  let pair = TyRecord([
    { name: b"items", ty: list_type(int_type()) },
    { name: b"name", ty: string_type() },
    { name: b"tree", ty: declared(b"m.Tree") },
  ]);
  let types = [declared(b"m.Tree"), expr, pair, declared(b"m.Job"), string_type()];
  let over = |ops: List<TypeOp>, key: (TypeOp, Type) -> RootKey|
    ops.fold([], |acc: List<RootKey>, op: TypeOp| acc.concat(types.map(|t: Type| key(op, t))));
  match corpus_ctors() {
    Err(why) -> assert_eq(why, b""),
    Ok(ctors) -> {
      let plain = over(
        [Drop, Dup, keys::Release, Copy, Share, Keep, keys::Held(Dup), keys::Held(keys::Release)],
        root_of,
      ).concat(
        [Drop, Share, Keep].fold([], |acc: List<RootKey>, op: TypeOp|
          acc.concat([case_root(op, expr, 1), case_root(op, expr, 2)])),
      );
      let entries = over([Worded(Lower), Worded(Lift)], |op: TypeOp, t: Type| written(op, t, b"m"));
      assert_eq(
        plain.fold([], |acc: List<Bytes>, k: RootKey|
          acc.concat(handing_faults(k, generated(ctors, k)))).concat(
          entries.fold([], |acc: List<Bytes>, k: RootKey|
            acc.concat(handing_faults(k, worded(ctors, k)))),
        ),
        [],
      )
    },
  }
}

test "a sum of several counted words is let go of by one call of its type's root, which is checked and counts each word" {
  // `Duo`'s case lies in place: its two pointers, counted by the case the sum holds.
  let src = Bytes::concat_all([
    b"type Duo = | Both(String, List<Int>) | Neither\n",
    b"fn g(n: Int) -> Int / {abort.raise} = if n > 3 { panic(\"big\") } else { n }\n",
    b"fn kept(d: Duo, n: Int) -> Duo / {abort.raise} = { let m = g(n); if m > 0 { d } else { d } }\n",
    b"fn pick(d: Duo, b: Bool) -> Duo = if b { d } else { Neither }\n",
  ]);
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let held = |op: TypeOp| root_of(keys::Held(op), declared(b"m.Duo"));
      let call = |k: RootKey| symbol_of(root_text(root_name(k))).concat(b"(ctx, ");
      let calls_in = |name: Bytes, k: RootKey|
        match printed_by_form(p, name) {
          Ok(t) -> t.split(call(k)).len() - 1,
          Err(why) -> panic(String::of_bytes_lossy(why)),
        };
      // Where a branch is done with it, and on a failure's way out, the value is let go of by one
      // call.
      assert_eq(
        [calls_in(b"pick", held(keys::Release)), calls_in(b"kept", held(keys::Release))],
        [1, 1],
      );
      // Each root passes the check and counts each of the case's two counted words itself.
      [keys::Release, Dup].fold((), |_: Unit, op: TypeOp| {
        let f = generated(p.setting.ctors, held(op));
        let built = built_form(f);
        let c = spelled(printed_fn(built, p.setting.ctors).pieces);
        // The function itself, not the entry the runtime calls it through.
        let body = match c.index_of(b"_entry(PlyCtx *ctx, const Word *args) {") {
          Some(at) -> c.slice(0, at),
          None -> c,
        };
        let each = if op == Dup { b"ply_dup(" } else { b"ply_rel" };
        assert(
          verified(built) == None && body.split(each).len() - 1 == 2
            && !body.contains(call(held(op))),
          Some(String::of_bytes_lossy(c)),
        )
      })
    },
  }
}

test "a sum of one word's drop root lets go of the word of a case holding no block, so every path passes the check" {
  // Two cases tagged in a pointer's low bits and one holding nothing, as a store's lookup answers.
  let src = b"type Found = | Hit(Bytes) | Miss | Bad(String)\ntype L = | Nil | Cons(Int, L)\nfn uses(f: Found, l: L) -> Int = 0\n";
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) ->
      assert_eq(
        [declared(b"m.Found"), declared(b"m.L")].map(|t: Type| {
          let f = generated(p.setting.ctors, drop_of(t));
          verified(f)
        }),
        [None, None],
      ),
  }
}
