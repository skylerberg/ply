//! The containers family's lowering held to its decisions: list literals, builtins called through
//! the runtime's helpers, and lengths, bytes and joins written in place; and a corpus that lowers,
//! checks and prints.

import emit.reps (laid)
import std.bytes (ascii_of_int)
import std.prelude_source
import check.types (Type, TyCon, TyFn, TyRecord)
import syntax.parsing (span_between)
import emit.typing (Typed, Filings, no_filings, filed_as, unknown_type)
import front.diagnostics (parse_all)
import front.seam (Analysed)
import front.published (analyse, no_rows)
import front (analyse_pulling_std_with)
import check.resolve.tables (qualify)
import emit.layout (Intrinsic, intrinsics, layouts, words)
import emit.answer (Need, Layout)
import emit.pieces (spelled)
import emit.roots (symbol_of)
import emit.release (root_of, drop_of)
import emit.code (Code, NField)
import emit.tir (Rep, RInt, RBool, RFloat, RWord, RSum, RNum, RFlat, Leaf, Var, Arg, AVar, AInt,
                 Val, Make, Made, MList, Call, Native, Op, OContainer, Operation, Pack, Uses, Inst,
                 Let, Fn, Lambda, Closure, Spine, Data, Containers, rep_of_arg)
import emit.tir.containers (Laid, Length, Elements, Within, ArrayNew, ArraySet, ArrayOfList,
                            ArrayGet, ColumnsNew, ColumnsSet, ColumnsOfList, ColumnsGet,
                            ColumnField, ColumnOf, ItemAt, Rest, Position, Element)
import emit.lower (lowered_fn)
import emit.own (owned)
import emit.lower.base (Context, Lowered, started)
import emit.lower.calling (context_of)
import emit.lower.containers (columned, column_read, listed, item_read, rest_read)
import emit.lower.setting (Root, setting_in)
import emit.keys (RootKey, Named, Written, Copy, root_name)
import emit.print (printed_fn)
import emit.compare (Program, program_of, formed, checked, printed_text, not_built)
import emit.print.counting (dup_fn, last_fn, free_fn, inc_fn, dec_fn, rel_int_fn, call_text,
                            call_start, takes_count)

/// `src` as module `m` of a program.
fn program(src: Bytes) -> Program / {abort.raise} =
  match program_of(src) { Ok(p) -> p, Err(why) -> panic(String::of_bytes_lossy(why)) }

type Bound = { var: Var, val: Val }

/// What root `m.<name>` of `p` binds in its body's own block, in order.
fn bound_in(p: Program, name: Bytes) -> List<Bound> / {abort.raise} =
  match formed(p, name) {
    Ok(f) ->
      f.body.fold([], |acc: List<Bound>, i: Inst|
        match i { Let(l) -> acc.push({ var: l.var, val: l.val }), _ -> acc }),
    Err(no) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", no.why]))),
  }

fn made(bs: List<Bound>) -> List<{ made: Made, args: List<Arg> }> =
  bs.fold([], |acc: List<{ made: Made, args: List<Arg> }>, b: Bound|
    match b.val { Make(m) -> acc.push({ made: m.made, args: m.args }), _ -> acc })

fn natives_in(bs: List<Bound>) -> List<{ name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }> =
  bs.fold([], |acc: List<{ name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }>, b: Bound|
    match b.val {
      Native(n) -> acc.push({ name: n.name, args: n.args, uses: n.uses, answer: b.var.rep }),
      _ -> acc,
    })

fn ops_in(bs: List<Bound>) -> List<{ op: Operation, args: List<Arg>, uses: Uses, answer: Rep }> =
  bs.fold([], |acc: List<{ op: Operation, args: List<Arg>, uses: Uses, answer: Rep }>, b: Bound|
    match b.val {
      Op(o) -> acc.push({ op: o.op, args: o.args, uses: o.uses, answer: b.var.rep }),
      _ -> acc,
    })

/// The representation each `Pack` holds its operand as.
fn packs_in(bs: List<Bound>) -> List<Rep> =
  bs.fold([], |acc: List<Rep>, b: Bound| match b.val { Pack(k) -> acc.push(k.to), _ -> acc })

fn param(id: Int, ty: Bytes) -> Arg =
  AVar({ id: id, ty: TyCon({ name: ty, args: [] }), rep: RWord })

test "a list literal is made of its items, each handed over as a word" {
  let p = program(
    Bytes::concat_all([
      b"fn pair(a: String, b: String) -> List<String> = [a, b]\n",
      b"fn nums(a: Int) -> List<Int> = [a, 2]\n",
      b"fn none() -> List<Int> = []\n",
    ]),
  );
  assert_eq(made(bound_in(p, b"pair")), [
    { made: MList(2), args: [param(0, b"String"), param(1, b"String")] },
  ]);
  assert_eq(packs_in(bound_in(p, b"nums")), [RWord, RWord]);
  assert_eq(
    made(bound_in(p, b"nums")).map(|m: { made: Made, args: List<Arg> }| m.args.map(rep_of_arg)),
    [[RWord, RWord]],
  );
  assert_eq(made(bound_in(p, b"none")), [{ made: MList(0), args: [] }]);
  // The list's variable holds the list's type, an item's where the literal has one.
  assert_eq(
    bound_in(p, b"nums").fold([], |acc: List<Type>, b: Bound|
      match b.val { Make(_) -> acc.push(b.var.ty), _ -> acc }),
    [TyCon({ name: b"List", args: [TyCon({ name: b"Int", args: [] })] })],
  )
}

test "a list pattern's item is read where it lies, and its rest made a list of its own" {
  let p = program(b"fn f(xs: List<String>) -> Int = 0\n");
  let strings = con(b"List", [con(b"String", [])]);
  let opened = |name: Bytes, ty: Type, act: (Context, Var) -> Lowered|
    match p.roots.find(|r: Root| r.key == Named(qualify(b"m", name))) {
      None -> panic("no such root"),
      Some(r) -> match r.code {
        Err(why) -> panic(String::of_bytes_lossy(why)),
        Ok(code) -> {
          let xs = { id: 0, ty: ty, rep: RWord };
          act(context_of(p.setting, r, code), xs)
        },
      },
    };
  let bound = |l: Lowered|
    l.st.insts.fold([], |acc: List<Bound>, i: Inst|
      match i { Let(x) -> acc.push({ var: x.var, val: x.val }), _ -> acc });
  let item = opened(b"f", strings, |cx: Context, xs: Var|
    item_read(cx, started([xs]), AVar(xs), AInt(40), con(b"String", [])));
  // Borrowed from the list, read as its word, and never failing: its length test admitted it.
  assert_eq(ops_in(bound(item)), [
    {
      op: OContainer(ItemAt),
      args: [AVar({ id: 0, ty: strings, rep: RWord }), AInt(40)],
      uses: { takes: [false, false], owned: false, fails: false, stops: false },
      answer: RWord,
    },
  ]);
  let rest = opened(b"f", strings, |cx: Context, xs: Var|
    rest_read(started([xs]), strings, AVar(xs), AInt(2)));
  assert_eq(
    ops_in(bound(rest)).map(|o: { op: Operation, args: List<Arg>, uses: Uses, answer: Rep }|
      { op: o.op, uses: o.uses }),
    [
      {
        op: OContainer(Rest),
        uses: { takes: [false, false], owned: true, fails: false, stops: false },
      },
    ],
  );
  // Neither goes through the runtime.
  assert_eq(natives_in(bound(item).concat(bound(rest))), [])
}

test "a builtin the runtime implements is called through its helper over words, its answer held as its type" {
  let p = program(
    Bytes::concat_all([
      b"fn fresh() -> Map<Int, String> = Map::new()\n",
      b"fn keys(m: Map<Int, String>) -> Int = m.len()\n",
    ]),
  );
  let name = |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name;
  assert_eq(natives_in(bound_in(p, b"fresh")).map(name), [b"builtin_map_new_p"]);
  // A method is the builtin its type names, taking its word, its word answer unboxed to the `Int`
  // it holds.
  let calls = natives_in(bound_in(p, b"keys"));
  assert_eq(calls.map(name), [b"builtin_map_len_p"]);
  assert_eq(
    calls.map(|c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }|
      { args: c.args.map(rep_of_arg), uses: c.uses, answer: c.answer }),
    [
      {
        args: [RWord],
        uses: { takes: [true], owned: true, fails: true, stops: false },
        answer: RWord,
      },
    ],
  );
  assert_eq(packs_in(bound_in(p, b"keys")), [RInt])
}

test "a length is read in place off its header, never failing and taking nothing" {
  let p = program(
    Bytes::concat_all([
      b"fn count(xs: List<String>) -> Int = xs.len()\n",
      b"fn size(b: Bytes) -> Int = b.len()\n",
      b"fn arity(a: Array<String>) -> Int = a.len()\n",
    ]),
  );
  let read = |name: Bytes| {
    let bs = bound_in(p, name);
    assert_eq(natives_in(bs), []);
    ops_in(bs).map(|o: { op: Operation, args: List<Arg>, uses: Uses, answer: Rep }|
      { op: o.op, takes: o.uses.takes, fails: o.uses.fails, answer: o.answer })
  };
  assert_eq([read(b"count"), read(b"size"), read(b"arity")], [
    [{ op: OContainer(Length), takes: [false], fails: false, answer: RInt }],
    [{ op: OContainer(Length), takes: [false], fails: false, answer: RInt }],
    [{ op: OContainer(Elements), takes: [false], fails: false, answer: RInt }],
  ])
}

/// How an array of program `p` lays out an element of type `t`: as its type lays it, at least a
/// word apart.
fn element_in(p: Program, t: Type) -> Element / {abort.raise} = {
  let l = laid(p.setting.ctors, t);
  { laid: l, stride: max(1, words(l)) }
}

test "an array's `at` tests its index and reads the element where it lies, its Option made by the body" {
  let p = program(b"fn element(a: Array<String>, i: Int) -> Option<String> = a.at(i)\n");
  assert_eq(natives_in(bound_in(p, b"element")), []);
  assert_eq(
    ops_in(bound_in(p, b"element")).map(
      |o: { op: Operation, args: List<Arg>, uses: Uses, answer: Rep }|
        { op: o.op, answer: o.answer },
    ),
    [{ op: OContainer(Within), answer: RBool }],
  );
  let text = form_text(p, b"element");
  assert(text.index_of(b"(uint64_t)") != None, Some(String::of_bytes_lossy(text)))
}

test "an array is made, written and read as its elements' type lays out a value of it, in place" {
  let p = program(
    Bytes::concat_all([
      b"fn made(n: Int) -> Array<Int> / {abort.raise} = Array::new(n, 0)\n",
      b"fn written(a: Array<Float>, x: Float) -> Array<Float> / {abort.raise} = a.set(1, x)\n",
      b"fn laid(xs: List<Decimal>) -> Array<Decimal> = Array::of_list(xs)\n",
      b"fn read(a: Array<Int>, i: Int) -> Int / {abort.raise} = a.get(i)\n",
      b"fn words(a: Array<String>, i: Int) -> String / {abort.raise} = a.get(i)\n",
      b"fn records(n: Int, r: { x: Int, y: Int }) -> Array<{ x: Int, y: Int }> / {abort.raise} = Array::new(n, r)\n",
      b"fn record(a: Array<{ x: Int, y: Int }>) -> Int / {abort.raise} = a.get(0).y\n",
      b"fn options(a: Array<Option<String>>, x: Option<String>) -> Array<Option<String>> / {abort.raise} = a.set(0, x)\n",
      b"fn units(n: Int) -> Array<Unit> / {abort.raise} = Array::new(n, ())\n",
    ]),
  );
  let op = |name: Bytes|
    ops_in(bound_in(p, name)).map(
      |o: { op: Operation, args: List<Arg>, uses: Uses, answer: Rep }|
        { op: o.op, answer: o.answer, takes: o.uses.takes },
    );
  let int = con(b"Int", []);
  let point = TyRecord([{ name: b"x", ty: int }, { name: b"y", ty: int }]);
  // A record lies in the array's own words, its fields' words one after another, with no header.
  assert_eq(op(b"records"), [
    { op: OContainer(ArrayNew(element_in(p, point))), answer: RWord, takes: [false, true] },
  ]);
  assert_eq(element_in(p, point).stride, 2);
  // An element read is the record's leaves, borrowed from where they lie.
  assert(
    op(b"record").any(|o: { op: Operation, answer: Rep, takes: List<Bool> }|
      o.op == OContainer(ArrayGet(element_in(p, point)))
        && (match o.answer { RFlat(_) -> true, _ -> false })),
    None,
  );
  // An `Option` of a pointer is one word, `None` its zero.
  let option = con(b"Option", [con(b"String", [])]);
  assert_eq(op(b"options"), [
    { op: OContainer(ArraySet(element_in(p, option))), answer: RWord, takes: [true, false, true] },
  ]);
  assert_eq(element_in(p, option).stride, 1);
  assert_eq(op(b"made"), [
    { op: OContainer(ArrayNew(element_in(p, int))), answer: RWord, takes: [false, true] },
  ]);
  assert_eq(op(b"written"), [
    {
      op: OContainer(ArraySet(element_in(p, con(b"Float", [])))),
      answer: RWord,
      takes: [true, false, true],
    },
  ]);
  assert_eq(op(b"laid"), [
    {
      op: OContainer(ArrayOfList(element_in(p, con(b"Decimal", [])))),
      answer: RWord,
      takes: [true],
    },
  ]);
  assert_eq(element_in(p, con(b"Decimal", [])).stride, 2);
  assert_eq(op(b"read"), [
    { op: OContainer(ArrayGet(element_in(p, int))), answer: RInt, takes: [false, false] },
  ]);
  assert_eq(op(b"words"), [
    {
      op: OContainer(ArrayGet(element_in(p, con(b"String", [])))),
      answer: RWord,
      takes: [false, false],
    },
  ]);
  // A value of no words still takes a word of the array.
  assert_eq(element_in(p, con(b"Unit", [])).stride, 1);
  // The element written is handed over as its type holds it: an `Int` is its bits, never a word.
  assert_eq(packs_in(bound_in(p, b"made")), []);
  // Nothing reaches the runtime's arrays, and every root passes the check once its counts are placed.
  [
    b"made",
    b"written",
    b"laid",
    b"read",
    b"words",
    b"records",
    b"record",
    b"options",
    b"units",
  ].fold((), |_: Unit, n: Bytes| {
    assert_eq(
      natives_in(bound_in(p, n)).filter(
        |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }|
          c.name.index_of(b"array") != None,
      ),
      [],
    );
    match checked(p, n) {
      Ok(_) -> (),
      Err(why) -> panic(String::of_bytes_lossy(Bytes::concat_all([n, b": ", why]))),
    }
  })
}

test "a Columns is made, written, read, measured and searched one array per field, never by the runtime" {
  let p = program(
    Bytes::concat_all([
      b"type P = { x: Float, label: String }\n",
      b"fn made(n: Int, r: P) -> Columns<P> / {abort.raise} = Columns::new(n, r)\n",
      b"fn listed(rs: List<P>) -> Columns<P> = Columns::of_list(rs)\n",
      b"fn written(c: Columns<P>, r: P) -> Columns<P> / {abort.raise} = c.set(0, r)\n",
      b"fn read(c: Columns<P>, i: Int) -> P / {abort.raise} = c.get(i)\n",
      b"fn counted(c: Columns<P>) -> Int = c.len()\n",
      b"fn found(c: Columns<P>, i: Int) -> Option<P> = c.at(i)\n",
    ]),
  );
  let op = |name: Bytes|
    ops_in(bound_in(p, name)).map(
      |o: { op: Operation, args: List<Arg>, uses: Uses, answer: Rep }| o.op,
    );
  // The fields in the record's order: `label`, then `x`.
  let es = [element_in(p, con(b"String", [])), element_in(p, con(b"Float", []))];
  assert_eq(op(b"made"), [OContainer(ColumnsNew(es))]);
  assert_eq(op(b"listed"), [OContainer(ColumnsOfList(es))]);
  assert_eq(op(b"written"), [OContainer(ColumnsSet(es))]);
  assert_eq(op(b"read"), [OContainer(ColumnsGet(es))]);
  assert_eq(op(b"counted"), [OContainer(ColumnOf(0)), OContainer(Elements)]);
  assert_eq(op(b"found"), [OContainer(ColumnOf(0)), OContainer(Within)]);
  [b"made", b"listed", b"written", b"read", b"counted", b"found"].fold((), |_: Unit, n: Bytes| {
    assert_eq(natives_in(bound_in(p, n)), []);
    match checked(p, n) {
      Ok(_) -> (),
      Err(why) -> panic(String::of_bytes_lossy(Bytes::concat_all([n, b": ", why]))),
    }
  })
}

test "an array of a type variable's elements is made by the runtime, its layout noted for a specialisation" {
  let p = program(b"fn made<a>(n: Int, x: a) -> Array<a> / {abort.raise} = Array::new(n, x)\n");
  match formed(p, b"made") {
    Ok(f) -> {
      assert_eq(f.links.needs.map(|n: Need| n.reads), [Layout]);
      assert_eq(
        natives_in(bound_in(p, b"made")).map(
          |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name,
        ),
        [b"builtin_array_new_p"],
      )
    },
    Err(no) -> panic(String::of_bytes_lossy(no.why)),
  }
}

test "a builtin where only its type arguments are filed, as in code written for a type, is still written in place" {
  let p = program(
    Bytes::concat_all([
      b"fn count(xs: List<Int>) -> Int = xs.len()\n",
      b"fn read(a: Array<Int>, i: Int) -> Int / {abort.raise} = a.get(i)\n",
      b"fn keys(m: Map<Int, String>) -> Int = m.len()\n",
    ]),
  );
  let argued = |filed: Result<Filings, Bytes>|
    match filed {
      Err(_) -> filed,
      Ok(f) ->
        Ok({
          ..f,
          typed: f.typed.fold(f.typed, |m: Map<Int, Typed>, k: Int, t: Typed|
            match t.ty { TyFn(_) -> m.insert(k, filed_as(unknown_type(), t.args)), _ -> m }),
        }),
    };
  let q = { ..p, roots: p.roots.map(|r: Root| { ..r, filed: argued(r.filed) }) };
  let op = |name: Bytes|
    ops_in(bound_in(q, name)).map(
      |o: { op: Operation, args: List<Arg>, uses: Uses, answer: Rep }| o.op,
    );
  assert_eq(op(b"count"), [OContainer(Length)]);
  assert_eq(op(b"read"), [OContainer(ArrayGet(element_in(q, con(b"Int", []))))]);
  // A call through the runtime answers a value of the type its declaration gives it there.
  assert_eq(
    natives_in(bound_in(q, b"keys")).map(
      |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name,
    ),
    [b"builtin_map_len_p"],
  );
  assert_eq(packs_in(bound_in(q, b"keys")), [RInt])
}

test "a field of a Columns' record is read from its column, with no record made" {
  let p = program(
    Bytes::concat_all([
      b"type P = { x: Float, label: String, at: { a: Int, b: Int } }\n",
      b"fn x_at(ps: Columns<P>, i: Int) -> Float / {abort.raise} = ps.get(i).x\n",
      b"fn label_at(ps: Columns<P>, i: Int) -> String / {abort.raise} = ps.get(i).label\n",
      b"fn at_at(ps: Columns<P>, i: Int) -> Int / {abort.raise} = ps.get(i).at.b\n",
      b"fn var_at<a>(ps: Columns<{ v: a }>, i: Int) -> a / {abort.raise} = ps.get(i).v\n",
    ]),
  );
  // The field read where the driver hands it over: the call's arguments, then the read.
  let read = |name: Bytes|
    match p.roots.find(|r: Root| r.key == Named(qualify(b"m", name))) {
      None -> [],
      Some(r) -> match r.code {
        Err(_) -> [],
        Ok(code) -> {
          let cx = context_of(p.setting, r, code);
          // The field read off the record `Columns::get` answers: the innermost of a chain of reads.
          let base = match code.node {
            NField(f) -> match f.base.node {
              NField(g) -> Some({ base: g.base, name: g.field }),
              _ -> Some({ base: f.base, name: f.field }),
            },
            _ -> None,
          };
          match base {
            None -> [],
            Some(b) -> match columned(cx, b.base, b.name) {
              false -> [],
              true -> {
                let ps = {
                  id: 0,
                  ty: match r.types.at(0) { Some(t) -> t, None -> unknown_type() },
                  rep: RWord,
                };
                let i = { id: 1, ty: TyCon({ name: b"Int", args: [] }), rep: RInt };
                let l = column_read(
                  cx,
                  started([ps, i]),
                  [AVar(ps), AVar(i)],
                  b.base,
                  b.name,
                  code.span,
                );
                l.st.insts.fold([], |acc: List<{ op: Operation, answer: Rep }>, x: Inst|
                  match x {
                    Let(v) -> match v.val {
                      Op(o) -> acc.push({ op: o.op, answer: v.var.rep }),
                      _ -> acc,
                    },
                    _ -> acc,
                  })
              },
            },
          }
        },
      },
    };
  // The record's fields in their order: `at`, `label`, `x`.
  assert_eq(read(b"x_at"), [
    {
      op: OContainer(ColumnField({ k: 2, column: element_in(p, con(b"Float", [])) })),
      answer: RFloat,
    },
  ]);
  assert_eq(read(b"label_at"), [
    {
      op: OContainer(ColumnField({ k: 1, column: element_in(p, con(b"String", [])) })),
      answer: RWord,
    },
  ]);
  // A record held in place in a column is read as its leaves, its words where they lie.
  assert(
    read(b"at_at").any(|o: { op: Operation, answer: Rep }|
      match o.answer { RFlat(_) -> true, _ -> false }),
    None,
  );
  // Only a field of a record a type lays out has a column of its own.
  assert_eq(read(b"var_at"), [])
}

test "a byte string's position is a loop in the body, its predicate called by its type and lent, its Option made by the body" {
  let p = program(b"fn found(b: Bytes) -> Option<Int> = b.position(0, |c: Int| c == 32)\n");
  // Under either profile: the loop reads the bytes and the predicate, answering an index.
  [p, { ..p, setting: { ..p.setting, release: true } }].fold((), |_: Unit, q: Program| {
    assert_eq(
      ops_in(bound_in(q, b"found")).map(
        |o: { op: Operation, args: List<Arg>, uses: Uses, answer: Rep }|
          { op: o.op, uses: o.uses, answer: o.answer },
      ),
      [
        {
          op: OContainer(Position),
          uses: { takes: [false, false, false], owned: true, fails: true, stops: true },
          answer: RInt,
        },
      ],
    );
    assert_eq(natives_in(bound_in(q, b"found")), [])
  });
  let text = form_text(p, b"found");
  let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  has(b"((int64_t (*)(PlyCtx *, Word, int64_t))((const PlyFnDesc *)(intptr_t)ply_words(");
  has(b"break; }");
  // The predicate is lent to each call, so no count of it is taken in the loop.
  let looped = match text.index_of(b"for (int64_t ") {
    Some(i) -> text.slice(i, text.len()),
    None -> b"",
  };
  assert(looped.len() > 0 && !takes_count(looped), Some(String::of_bytes_lossy(text)));
  // The `Option` is the body's own, made where the index is found or not: never the runtime's.
  assert_eq(text.index_of(b"rt_call_p"), None)
}

test "a byte string's position named as a value is a lambda whose loop calls the predicate it is handed by its type" {
  let p = program(
    Bytes::concat_all([
      b"fn space(c: Int) -> Bool = c == 32\n",
      b"fn by(f: (Bytes, Int, (Int) -> Bool) -> Option<Int> / {abort.raise}, b: Bytes) -> Option<Int> / {abort.raise} = f(b, 0, space)\n",
      b"fn spaced(b: Bytes) -> Option<Int> / {abort.raise} = by(Bytes::position, b)\n",
    ]),
  );
  let positions = match checked(p, b"spaced") {
    Ok(f) ->
      f.lambdas.fold([], |acc: List<Uses>, l: Lambda|
        match l {
          Closure(c) ->
            c.body.body.fold(acc, |us: List<Uses>, i: Inst|
              match i {
                Let(x) -> match x.val {
                  Op(o) -> if o.op == OContainer(Position) { us.push(o.uses) } else { us },
                  _ -> us,
                },
                _ -> us,
              }),
        }),
    Err(why) -> panic(String::of_bytes_lossy(why)),
  };
  assert_eq(positions, [{ takes: [false, false, false], owned: true, fails: true, stops: true }]);
  let text = form_text(p, b"spaced");
  assert(
    text.index_of(
        b"((int64_t (*)(PlyCtx *, Word, int64_t))((const PlyFnDesc *)(intptr_t)ply_words(",
      )
      != None,
    Some(String::of_bytes_lossy(text)),
  );
  assert_eq(text.index_of(b"rt_call_p"), None)
}

/// What each `rt_with_cleanup` root `m.<name>` of `p` calls, in its body or a lambda's, takes and
/// answers, once its counts are placed and checked.
fn cleanups(p: Program, name: Bytes) -> List<Uses> / {abort.raise} =
  match checked(p, name) {
    Ok(f) ->
      f.lambdas.fold([f.body], |acc: List<List<Inst>>, l: Lambda|
        match l { Closure(c) -> acc.push(c.body.body) }).fold(
        [],
        |acc: List<Uses>, b: List<Inst>|
          b.fold(acc, |us: List<Uses>, i: Inst|
            match i {
              Let(x) -> match x.val {
                Native(n) -> if n.name == b"rt_with_cleanup_p" { us.push(n.uses) } else { us },
                _ -> us,
              },
              _ -> us,
            }),
      ),
    Err(why) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", why]))),
  }

/// The closures are taken; the types of what is held and answered are only read.
fn cleanup_uses() -> Uses =
  { takes: [true, true, true, false, false], owned: true, fails: true, stops: true }

test "`bracket`, named or passed as a value, is the runtime's `rt_with_cleanup`, taking its closures" {
  let p = program(
    Bytes::concat_all([
      b"fn release(_: Int) -> Unit = ()\n",
      b"fn bracketed(n: Int) -> Int = bracket(|| n, release, |x: Int| x + 1)\n",
      b"fn by(f: (() -> Int, (Int) -> Unit, (Int) -> Int) -> Int, n: Int) -> Int = f(|| n, release, |x: Int| x + 1)\n",
      b"fn bracketed_by(n: Int) -> Int = by(bracket, n)\n",
    ]),
  );
  assert_eq(cleanups(p, b"bracketed"), [cleanup_uses()]);
  assert_eq(cleanups(p, b"bracketed_by"), [cleanup_uses()]);
  [b"bracketed", b"bracketed_by"].fold((), |_: Unit, n: Bytes| {
    let text = form_text(p, n);
    assert(text.index_of(b"rt_with_cleanup_p(ctx, ") != None, Some(String::of_bytes_lossy(text)));
    assert_eq(text.index_of(b"builtin_bracket_p"), None)
  })
}

test "a handler's variables are the runtime's, a hold's region its `rt_with_cleanup`, each answering its type" {
  let p = program(
    Bytes::concat_all([
      b"effect tally {\n  write add(n: Int) -> Unit\n  read total() -> Int\n}\n",
      b"fn counted() -> Int = handle { tally.add(1); tally.add(2); tally.total() } with { var n = 0, tally.add(k) -> { n = n + k; }, tally.total() -> n }\n",
      b"fn release(_: Int) -> Unit = ()\n",
      b"fn held(n: Int) -> Int = with_hold[t](n, release) { c -> c.get() }\n",
      b"fn copied(n: Int) -> Bool = { let got = with_hold[t](n, release) { c -> with_hold[u](c.get(), release) { d -> d.get() } }; got >= 0 }\n",
    ]),
  );
  assert_eq(
    [b"counted", b"held", b"copied"].fold([], |acc: List<{ name: Bytes, why: Bytes }>, n: Bytes|
      match checked(p, n) { Ok(_) -> acc, Err(why) -> acc.push({ name: n, why: why }) }),
    [],
  );
  assert_eq(cleanups(p, b"held"), [cleanup_uses()]);
  // A hold answers what its body answers, here an `Int` its comparison reads in a register.
  assert(
    !natives_in(bound_in(p, b"copied")).any(
      |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name == b"rt_binary_p",
    ),
  );
  // The hold made, the value taken out of it and a read of it are each of the type the region
  // gives them, which the checker filed for its body and its release.
  let hold_natives = |name: Bytes|
    match formed(p, name) {
      Ok(f) ->
        f.lambdas.fold([], |acc: List<Bound>, l: Lambda|
          match l {
            Closure(c) ->
              acc.concat(
                c.body.body.fold([], |bs: List<Bound>, i: Inst|
                  match i { Let(x) -> bs.push({ var: x.var, val: x.val }), _ -> bs }),
              ),
          }).filter(|b: Bound|
          match b.val { Native(n) -> n.name.index_of(b"hold_") != None, _ -> false }),
      Err(_) -> [],
    };
  let int = TyCon({ name: b"Int", args: [] });
  let typed = hold_natives(b"held").map(|b: Bound|
    match b.val {
      Native(n) ->
        {
          name: n.name,
          held: match b.var.ty { TyCon(c) -> c.args.at(c.args.len() - 1), _ -> None },
          whole: b.var.ty,
        },
      _ -> { name: b"", held: None, whole: b.var.ty },
    });
  assert_eq(typed.map(|t: { name: Bytes, held: Option<Type>, whole: Type }| t.name), [
    b"builtin_elaborated_hold_new_p",
    b"builtin_elaborated_hold_take_p",
    b"builtin_hold_get_p",
  ]);
  assert_eq(
    typed.map(|t: { name: Bytes, held: Option<Type>, whole: Type }|
      match t.held { Some(h) -> h, None -> t.whole }),
    [int, int, int],
  )
}

test "an operator at a type a witness stands for is the runtime's, a comparison answering a `Bool`" {
  let p = program(
    Bytes::concat_all([
      b"fn less<a>(x: a, y: a) -> Bool where numeric(a) = x < y\n",
      b"fn sum<a>(x: a, y: a) -> a where numeric(a) = x + y\n",
      b"fn negated<a>(x: a) -> a where numeric(a) = -x\n",
      b"fn halved<a>(x: a) -> a where integer(a) = x >> 1\n",
    ]),
  );
  let names = [b"less", b"sum", b"negated", b"halved"];
  assert_eq(
    names.fold([], |acc: List<{ name: Bytes, why: Bytes }>, n: Bytes|
      match checked(p, n) { Ok(_) -> acc, Err(why) -> acc.push({ name: n, why: why }) }),
    [],
  );
  assert_eq(
    names.map(|n: Bytes|
      natives_in(bound_in(p, n)).map(
        |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name,
      )),
    [
      [b"builtin_elaborated_numeric_binary_p"],
      [b"builtin_elaborated_numeric_binary_p"],
      [b"builtin_elaborated_numeric_unary_p"],
      [b"builtin_elaborated_numeric_binary_p"],
    ],
  );
  // The runtime's word is unboxed only where the operator compares.
  assert_eq(names.map(|n: Bytes| packs_in(bound_in(p, n)).filter(|r: Rep| r == RBool).len()), [
    1,
    0,
    0,
    0,
  ])
}

/// Module `m` of the program of `sources`, run by a runtime implementing `natives`.
fn program_of_modules(
  sources: List<{ name: Bytes, src: Bytes }>,
  natives: List<Bytes>,
) -> Program / {abort.raise} =
  match analyse(parse_all(sources)) {
    Analysed(a) -> match setting_in(a, b"m") {
      Ok(s) ->
        { src: b"", analysis: a, setting: { ..s.setting, builtins: natives }, roots: s.roots },
      Err(why) -> panic(String::of_bytes_lossy(why)),
    },
    _ -> panic("the program does not check"),
  }

test "a name no import takes is the builtin's, and an import that takes a builtin's name is called instead" {
  let names = |p: Program, root: Bytes|
    natives_in(bound_in(p, root)).map(
      |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name,
    );
  let whole = program_of_modules(
    [
      { name: b"min", src: b"pub fn size(xs: List<Int>) -> Int = xs.len()\n" },
      {
        name: b"m",
        src: b"import min\nfn least(x: Int) -> Int = min(x, 1)\nfn n(xs: List<Int>) -> Int = min::size(xs)\n",
      },
    ],
    [b"min", b"List::len"],
  );
  assert_eq(names(whole, b"least"), [b"builtin_min_p"]);
  assert(
    match formed(whole, b"n") {
      Ok(f) ->
        natives_in(
            f.body.fold([], |acc: List<Bound>, i: Inst|
              match i { Let(l) -> acc.push({ var: l.var, val: l.val }), _ -> acc }),
          )
          == [],
      Err(no) -> no.by != Containers,
    },
    None,
  );
  let taken = program_of_modules(
    [
      { name: b"a", src: b"pub fn min(x: Int, y: Int) -> Int = x\n" },
      { name: b"m", src: b"import a (min)\nfn least(x: Int) -> Int = min(x, 1)\n" },
    ],
    [b"min"],
  );
  assert(
    match formed(taken, b"least") {
      Ok(_) -> names(taken, b"least") == [],
      Err(no) -> no.by != Containers,
    },
    None,
  )
}

test "a builtin the runtime lacks is declined, and one written at a scalar's type goes on to scalars" {
  let src = Bytes::concat_all([
    b"fn keys(m: Map<Int, String>) -> Int = m.len()\n",
    b"fn wrapped(a: U8, b: U8) -> U8 = wrap_add(a, b)\n",
  ]);
  let by = |p: Program, name: Bytes|
    match formed(p, name) { Ok(_) -> None, Err(no) -> Some(no.by) };
  let bare = program(src);
  assert_eq(by({ ..bare, setting: { ..bare.setting, builtins: [] } }, b"keys"), Some(Containers));
  assert_eq(by(program(src), b"keys"), None);
  assert(by(program(src), b"wrapped") != Some(Containers), None)
}

test "a shipped module's extern is called as the builtin of its own name" {
  let user = b"import std.native (doubled)\nimport std.native as n\nfn f() -> Int = doubled(2) + n::doubled(3)\n";
  let shipped = [{ name: b"std.native", src: b"pub extern fn doubled(x: Int) -> Int\n" }];
  match analyse_pulling_std_with([{ name: b"m", src: user }], shipped, no_rows()).out {
    Analysed(a) -> match setting_in(a, b"m") {
      Ok(s) -> {
        let p = {
          src: user,
          analysis: a,
          setting: { ..s.setting, builtins: [b"doubled"] },
          roots: s.roots,
        };
        assert_eq(
          natives_in(bound_in(p, b"f")).map(
            |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name,
          ),
          [b"builtin_doubled_p", b"builtin_doubled_p"],
        )
      },
      Err(why) -> panic(String::of_bytes_lossy(why)),
    },
    _ -> panic("the program does not check"),
  }
}

/// Programs covering what the lang tests of lists, bytes, strings, arrays and maps lower through this
/// family, each root using each counted value it holds once.
fn corpus() -> Bytes =
  Bytes::concat_all([
    b"fn pair(a: String, b: String) -> List<String> = [a, b]\n",
    b"fn ints(a: Int, b: Int) -> List<Int> = [a, b, a + b]\n",
    b"fn floats(x: Float) -> List<Float> = [x, x * 2.0]\n",
    b"fn flags(c: Bool) -> List<Bool> = [c, !c, true]\n",
    b"fn empty() -> List<String> = []\n",
    b"fn nested(a: String) -> List<List<String>> = [[a], []]\n",
    b"fn count(xs: List<String>) -> Int = xs.len()\n",
    b"fn size(b: Bytes) -> Int = b.len()\n",
    b"fn byte(b: Bytes, i: Int) -> Int / {abort.raise} = b.at(i)\n",
    b"fn third(b: Bytes) -> Int / {abort.raise} = b.at(3)\n",
    b"fn word(b: Bytes, i: Int) -> U32 / {abort.raise} = b.u32_le(i)\n",
    b"fn glued(a: Bytes, b: Bytes) -> Bytes = Bytes::concat_all([a, b])\n",
    b"fn all(bs: List<Bytes>) -> Bytes = Bytes::concat_all(bs)\n",
    b"fn cat(a: String, b: String) -> String = String::concat(a, b)\n",
    b"fn cut(b: Bytes, i: Int) -> Bytes / {abort.raise} = b.slice(i, 4)\n",
    b"fn measured(s: String) -> Int = s.len()\n",
    b"fn starts(s: String, p: String) -> Bool = s.starts_with(p)\n",
    b"fn found(h: Bytes, n: Bytes) -> Option<Int> = h.index_of(n)\n",
    b"fn numbers(n: Int) -> List<Int> = range(0, n)\n",
    b"fn fresh() -> Map<Int, String> = Map::new()\n",
    b"fn keys(m: Map<Int, String>) -> Int = m.len()\n",
    b"fn listed(a: Array<Int>) -> List<Int> = a.to_list()\n",
    b"fn arity(a: Array<String>) -> Int = a.len()\n",
    b"fn text(n: Int) -> String = n.to_string()\n",
    b"fn element(a: Array<String>, i: Int) -> Option<String> = a.at(i)\n",
    b"fn reserved(n: Int) -> List<String> = List::with_capacity(n)\n",
    b"fn filled(n: Int, x: Float) -> Array<Float> / {abort.raise} = Array::new(n, x)\n",
    b"fn shared(n: Int, s: String) -> Array<String> / {abort.raise} = Array::new(n, s)\n",
    b"fn replaced(a: Array<Int>, i: Int, x: Int) -> Array<Int> / {abort.raise} = a.set(i, x)\n",
    b"fn renamed(a: Array<String>, s: String) -> Array<String> / {abort.raise} = a.set(0, s)\n",
    b"fn arrayed(xs: List<Int>) -> Array<Int> = Array::of_list(xs)\n",
    b"fn decimals(xs: List<Decimal>) -> Array<Decimal> = Array::of_list(xs)\n",
    b"fn got(a: Array<Float>, i: Int) -> Float / {abort.raise} = a.get(i)\n",
    b"fn small(a: Array<U8>) -> U8 / {abort.raise} = a.get(2)\n",
    b"fn points(n: Int, p: { x: Int, y: Int }) -> Array<{ x: Int, y: Int }> / {abort.raise} = Array::new(n, p)\n",
    b"fn point_y(a: Array<{ x: Int, y: Int }>, i: Int) -> Int / {abort.raise} = a.get(i).y\n",
    b"fn maybes(xs: List<Option<String>>) -> Array<Option<String>> = Array::of_list(xs)\n",
    b"fn maybe_at(a: Array<Option<String>>, i: Int) -> Option<String> / {abort.raise} = a.get(i)\n",
    b"fn put_maybe(a: Array<Option<Int>>, x: Option<Int>) -> Array<Option<Int>> / {abort.raise} = a.set(0, x)\n",
    b"type Tagged = { name: String, n: Int }\n",
    b"fn tags(n: Int, t: Tagged) -> Array<Tagged> / {abort.raise} = Array::new(n, t)\n",
    b"fn retag(a: Array<Tagged>, t: Tagged) -> Array<Tagged> / {abort.raise} = a.set(1, t)\n",
    b"fn tag_list(ts: List<Tagged>) -> Array<Tagged> = Array::of_list(ts)\n",
    b"fn tag_at(a: Array<Tagged>, i: Int) -> Option<Tagged> = a.at(i)\n",
    b"fn columns(ts: List<Tagged>) -> Columns<Tagged> = Columns::of_list(ts)\n",
    b"fn column_new(n: Int, t: Tagged) -> Columns<Tagged> / {abort.raise} = Columns::new(n, t)\n",
    b"fn column_set(c: Columns<Tagged>, t: Tagged) -> Columns<Tagged> / {abort.raise} = c.set(0, t)\n",
    b"fn column_get(c: Columns<Tagged>, i: Int) -> Tagged / {abort.raise} = c.get(i)\n",
    b"fn column_name(c: Columns<Tagged>, i: Int) -> String / {abort.raise} = c.get(i).name\n",
    b"fn column_at(c: Columns<Tagged>, i: Int) -> Option<Tagged> = c.at(i)\n",
    b"fn column_len(c: Columns<Tagged>) -> Int = c.len()\n",
  ])

