//! The containers family's lowering held to its decisions, and its corpus to today's emitter: list
//! literals, builtins called through the runtime's helpers, and lengths, bytes and joins written in
//! place.

import std.bytes (ascii_of_int)
import std.prelude_source
import check.types (Type, TyCon, TyFn)
import emit.typing (Typed, filed_as, unknown_type)
import front.diagnostics (parse_all)
import front.seam (Analysed)
import front.published (analyse, no_rows)
import front (analyse_pulling_std_with)
import check.resolve.tables (qualify)
import emit.layout (Intrinsic, intrinsics, layouts)
import emit.answer (Need, Layout)
import emit.pieces (spelled)
import emit.code (NField)
import emit.tir (Rep, RInt, RFloat, RWord, RMaybe, RNum, RFlat, Var, Arg, AVar, Val, Make, Made,
                 MList, Call, Native, Op, OContainer, Operation, Pack, Uses, Inst, Let, Fn,
                 Declined, Spine, Data, Containers, rep_of_arg)
import emit.tir.containers (Laid, Length, Elements, ByteAt, U32At, Joined, ArrayNew, ArraySet,
                            ArrayOfList, ArrayGet, ColumnField, Bits, IntBits, FloatBits,
                            DecimalBits, Words, Payloads, Records)
import emit.lower (lowered_fn)
import emit.lower.base (context_of, started)
import emit.lower.containers (columned, column_read)
import emit.lower.setting (Root, setting_in)
import emit.print (printed_fn)
import emit.compare (Program, Hunk, program_of, formed, checked, answered_today, today_text,
                     printed_text, normalised, past_counts, hunks)

/// `src` as module `m` of a program.
fn program(src: Bytes) -> Program / {abort.raise} =
  match program_of(src) { Ok(p) -> p, Err(why) -> panic(String::of_bytes_lossy(why)) }

type Bound = { var: Var, val: Val }

/// What root `m.<name>` of `p` binds in its body's own block, in order.
fn bound_in(p: Program, name: Bytes) -> List<Bound> / {abort.raise} =
  match formed(p, name) {
    Ok(f) ->
      f.body.fold([], |acc: List<Bound>, i: Inst|
        match i { Let(l) -> acc.push({ var: l.var, val: l.val }), _ -> acc }),
    Err(no) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", no.why]))),
  }

fn made(bs: List<Bound>) -> List<{ made: Made, args: List<Arg> }> =
  bs.fold([], |acc: List<{ made: Made, args: List<Arg> }>, b: Bound|
    match b.val { Make(m) -> acc.push({ made: m.made, args: m.args }), _ -> acc })

fn natives_in(bs: List<Bound>) -> List<{ name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }> =
  bs.fold([], |acc: List<{ name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }>, b: Bound|
    match b.val {
      Native(n) -> acc.push({ name: n.name, args: n.args, uses: n.uses, answer: b.var.rep }),
      _ -> acc,
    })

fn ops_in(bs: List<Bound>) -> List<{ op: Operation, args: List<Arg>, uses: Uses, answer: Rep }> =
  bs.fold([], |acc: List<{ op: Operation, args: List<Arg>, uses: Uses, answer: Rep }>, b: Bound|
    match b.val {
      Op(o) -> acc.push({ op: o.op, args: o.args, uses: o.uses, answer: b.var.rep }),
      _ -> acc,
    })

/// The representation each `Pack` holds its operand as.
fn packs_in(bs: List<Bound>) -> List<Rep> =
  bs.fold([], |acc: List<Rep>, b: Bound| match b.val { Pack(k) -> acc.push(k.to), _ -> acc })

fn param(id: Int, ty: Bytes) -> Arg =
  AVar({ id: id, ty: TyCon({ name: ty, args: [] }), rep: RWord })

test "a list literal is made of its items, each handed over as a word" {
  let p = program(
    Bytes::concat_all([
      b"fn pair(a: String, b: String) -> List<String> = [a, b]\n",
      b"fn nums(a: Int) -> List<Int> = [a, 2]\n",
      b"fn none() -> List<Int> = []\n",
    ]),
  );
  assert_eq(made(bound_in(p, b"pair")), [
    { made: MList(2), args: [param(0, b"String"), param(1, b"String")] },
  ]);
  assert_eq(packs_in(bound_in(p, b"nums")), [RWord, RWord]);
  assert_eq(
    made(bound_in(p, b"nums")).map(|m: { made: Made, args: List<Arg> }| m.args.map(rep_of_arg)),
    [[RWord, RWord]],
  );
  assert_eq(made(bound_in(p, b"none")), [{ made: MList(0), args: [] }]);
  // The list's variable holds the list's type, an item's where the literal has one.
  assert_eq(
    bound_in(p, b"nums").fold([], |acc: List<Type>, b: Bound|
      match b.val { Make(_) -> acc.push(b.var.ty), _ -> acc }),
    [TyCon({ name: b"List", args: [TyCon({ name: b"Int", args: [] })] })],
  )
}

test "a builtin the runtime implements is called through its helper over words, its answer held as its type" {
  let p = program(
    Bytes::concat_all([
      b"fn joined(a: String, b: String) -> String = String::concat(a, b)\n",
      b"fn size(s: String) -> Int = s.len()\n",
      b"fn numbers(n: Int) -> List<Int> = range(0, n)\n",
    ]),
  );
  let calls = natives_in(bound_in(p, b"joined"));
  assert_eq(calls.map(|c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name), [
    b"builtin_string_concat_p",
  ]);
  assert_eq(calls.map(|c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.args), [
    [param(0, b"String"), param(1, b"String")],
  ]);
  assert_eq(calls.map(|c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.uses), [
    { takes: [true, true], owned: true, fails: true, stops: false },
  ]);
  // A method is the builtin its type names, its word answer unboxed to the `Int` it holds.
  assert_eq(
    natives_in(bound_in(p, b"size")).map(
      |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.answer,
    ),
    [RWord],
  );
  assert_eq(
    natives_in(bound_in(p, b"size")).map(
      |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name,
    ),
    [b"builtin_string_len_p"],
  );
  assert_eq(packs_in(bound_in(p, b"size")), [RInt]);
  // Each scalar argument is boxed into the word the helper takes.
  assert_eq(packs_in(bound_in(p, b"numbers")), [RWord, RWord]);
  assert_eq(
    natives_in(bound_in(p, b"numbers")).map(
      |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.args.map(rep_of_arg),
    ),
    [[RWord, RWord]],
  )
}

test "a length and a byte are read in place, and only a read that can fall outside the object fails" {
  let p = program(
    Bytes::concat_all([
      b"fn count(xs: List<String>) -> Int = xs.len()\n",
      b"fn size(b: Bytes) -> Int = b.len()\n",
      b"fn arity(a: Array<String>) -> Int = a.len()\n",
      b"fn byte(b: Bytes, i: Int) -> Int / {abort.raise} = b.at(i)\n",
      b"fn word(b: Bytes, i: Int) -> U32 / {abort.raise} = b.u32_le(i)\n",
    ]),
  );
  let read = |name: Bytes| {
    let bs = bound_in(p, name);
    assert_eq(natives_in(bs), []);
    ops_in(bs).map(|o: { op: Operation, args: List<Arg>, uses: Uses, answer: Rep }|
      { op: o.op, fails: o.uses.fails, answer: o.answer })
  };
  assert_eq(read(b"count"), [{ op: OContainer(Length), fails: false, answer: RInt }]);
  assert_eq(read(b"size"), [{ op: OContainer(Length), fails: false, answer: RInt }]);
  assert_eq(read(b"arity"), [{ op: OContainer(Elements), fails: false, answer: RInt }]);
  assert_eq(read(b"byte"), [{ op: OContainer(ByteAt), fails: true, answer: RInt }]);
  assert_eq(read(b"word"), [
    { op: OContainer(U32At), fails: true, answer: RNum({ bits: 32, signed: false }) },
  ]);
  // A read takes nothing it reads.
  assert_eq(
    ops_in(bound_in(p, b"byte")).map(
      |o: { op: Operation, args: List<Arg>, uses: Uses, answer: Rep }| o.uses.takes,
    ),
    [[false, false]],
  )
}

test "byte strings joined from a list made for the join make no list" {
  let p = program(
    Bytes::concat_all([
      b"fn glued(a: Bytes, b: Bytes) -> Bytes = Bytes::concat_all([a, b])\n",
      b"fn all(bs: List<Bytes>) -> Bytes = Bytes::concat_all(bs)\n",
      b"fn named(a: Bytes) -> Bytes = { let xs = [a]; Bytes::concat_all(xs) }\n",
    ]),
  );
  let glued = bound_in(p, b"glued");
  assert_eq(made(glued), []);
  assert_eq(
    ops_in(glued).map(|o: { op: Operation, args: List<Arg>, uses: Uses, answer: Rep }|
      { op: o.op, args: o.args }),
    [{ op: OContainer(Joined), args: [param(0, b"Bytes"), param(1, b"Bytes")] }],
  );
  let name = |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name;
  assert_eq(natives_in(bound_in(p, b"all")).map(name), [b"builtin_bytes_concat_all_p"]);
  // A list a slot holds may be read again, so it is made and joined by the runtime.
  assert_eq(made(bound_in(p, b"named")).len(), 1);
  assert_eq(natives_in(bound_in(p, b"named")).map(name), [b"builtin_bytes_concat_all_p"])
}

test "a lookup answers an Option held as its payload's word, with no object made" {
  let p = program(b"fn element(a: Array<String>, i: Int) -> Option<String> = a.at(i)\n");
  assert_eq(
    natives_in(bound_in(p, b"element")).map(
      |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }|
        { name: c.name, answer: c.answer },
    ),
    [{ name: b"rt_array_lookup_p", answer: RMaybe }],
  )
}

test "an array is made, written and read as its elements' type lays it out" {
  let p = program(
    Bytes::concat_all([
      b"fn made(n: Int) -> Array<Int> / {abort.raise} = Array::new(n, 0)\n",
      b"fn written(a: Array<Float>, x: Float) -> Array<Float> / {abort.raise} = a.set(1, x)\n",
      b"fn laid(xs: List<Decimal>) -> Array<Decimal> = Array::of_list(xs)\n",
      b"fn read(a: Array<Int>, i: Int) -> Int / {abort.raise} = a.get(i)\n",
      b"fn words(a: Array<String>, i: Int) -> String / {abort.raise} = a.get(i)\n",
      b"fn records(n: Int, r: { x: Int, y: Int }) -> Array<{ x: Int, y: Int }> / {abort.raise} = Array::new(n, r)\n",
      b"fn record(a: Array<{ x: Int, y: Int }>) -> Int / {abort.raise} = a.get(0).y\n",
      b"fn options(a: Array<Option<String>>, x: Option<String>) -> Array<Option<String>> / {abort.raise} = a.set(0, x)\n",
    ]),
  );
  let op = |name: Bytes|
    ops_in(bound_in(p, name)).map(
      |o: { op: Operation, args: List<Arg>, uses: Uses, answer: Rep }|
        { op: o.op, answer: o.answer, takes: o.uses.takes },
    );
  let bits = |b: Bits, stride: Int, shape: Bytes|
    { held: Bits(b), stride: stride, shapes: [[shape]], counted: [] };
  // A record is copied in place behind a header of its own, laid out by its own shape, which goes
  // to the table before the element's.
  let point = {
    held: Records({ tail: 0 }),
    stride: 4,
    shapes: [[b"x!int", b"y!int"], [b"e!r(x!int,y!int)"]],
    counted: [],
  };
  assert_eq(op(b"records"), [
    { op: OContainer(ArrayNew(point)), answer: RWord, takes: [false, true] },
  ]);
  // An element read in place is the address of its header there, which the record's leaves are
  // loaded from.
  assert_eq(op(b"record"), [
    { op: OContainer(ArrayGet(point)), answer: RWord, takes: [false, false] },
  ]);
  // An `Option` is its payload's word in place, every element's word counted.
  assert_eq(op(b"options"), [
    {
      op: OContainer(ArraySet({ held: Payloads, stride: 1, shapes: [[b"e!m"]], counted: [0] })),
      answer: RWord,
      takes: [true, false, true],
    },
  ]);
  assert_eq(
    bound_in(p, b"options").fold([], |acc: List<Rep>, b: Bound|
      match b.val { Op(o) -> acc.concat(o.args.map(rep_of_arg)), _ -> acc }),
    [RWord, RInt, RMaybe],
  );
  // A scalar is held as its bits in place, an element of any other type as its word.
  assert_eq(op(b"made"), [
    { op: OContainer(ArrayNew(bits(IntBits, 1, b"e!int"))), answer: RWord, takes: [false, true] },
  ]);
  assert_eq(op(b"written"), [
    {
      op: OContainer(ArraySet(bits(FloatBits, 1, b"e!f"))),
      answer: RWord,
      takes: [true, false, true],
    },
  ]);
  assert_eq(op(b"laid"), [
    { op: OContainer(ArrayOfList(bits(DecimalBits, 2, b"e!d"))), answer: RWord, takes: [true] },
  ]);
  assert_eq(op(b"read"), [
    { op: OContainer(ArrayGet(bits(IntBits, 1, b"e!int"))), answer: RInt, takes: [false, false] },
  ]);
  assert_eq(op(b"words"), [
    {
      op: OContainer(ArrayGet({ held: Words, stride: 1, shapes: [], counted: [] })),
      answer: RWord,
      takes: [false, false],
    },
  ]);
  // The element written is handed over as the array holds it, a scalar unboxed.
  assert_eq(packs_in(bound_in(p, b"made")), [])
}

test "an array of a type variable's elements is made by the runtime, its layout noted for a specialisation" {
  let p = program(b"fn made<a>(n: Int, x: a) -> Array<a> / {abort.raise} = Array::new(n, x)\n");
  match formed(p, b"made") {
    Ok(f) -> {
      assert_eq(f.links.needs.map(|n: Need| n.reads), [Layout]);
      assert_eq(
        natives_in(bound_in(p, b"made")).map(
          |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name,
        ),
        [b"builtin_array_new_p"],
      )
    },
    Err(no) -> panic(String::of_bytes_lossy(no.why)),
  }
}

test "a builtin where only its type arguments are filed, as in code written for a type, is still written in place" {
  let p = program(
    Bytes::concat_all([
      b"fn count(xs: List<Int>) -> Int = xs.len()\n",
      b"fn read(a: Array<Int>, i: Int) -> Int / {abort.raise} = a.get(i)\n",
      b"fn glued(a: Bytes, b: Bytes) -> Bytes = Bytes::concat_all([a, b])\n",
      b"fn measured(s: String) -> Int = s.len()\n",
    ]),
  );
  let typed = p.setting.typed.keys().fold(p.setting.typed, |m: Map<Bytes, Typed>, k: Bytes|
    match m.get(k) {
      Some(t) -> match t.ty { TyFn(_) -> m.insert(k, filed_as(unknown_type(), t.args)), _ -> m },
      None -> m,
    });
  let q = { ..p, setting: { ..p.setting, typed: typed } };
  let op = |name: Bytes|
    ops_in(bound_in(q, name)).map(
      |o: { op: Operation, args: List<Arg>, uses: Uses, answer: Rep }| o.op,
    );
  assert_eq(op(b"count"), [OContainer(Length)]);
  assert_eq(op(b"read"), [
    OContainer(ArrayGet({ held: Bits(IntBits), stride: 1, shapes: [[b"e!int"]], counted: [] })),
  ]);
  assert_eq(op(b"glued"), [OContainer(Joined)]);
  // A call through the runtime answers a value of the type its declaration gives it there.
  assert_eq(
    natives_in(bound_in(q, b"measured")).map(
      |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name,
    ),
    [b"builtin_string_len_p"],
  );
  assert_eq(packs_in(bound_in(q, b"measured")), [RInt])
}

test "a field of a Columns' record is read from its column, with no record made" {
  let p = program(
    Bytes::concat_all([
      b"type P = { x: Float, label: String, at: { a: Int, b: Int } }\n",
      b"fn x_at(ps: Columns<P>, i: Int) -> Float / {abort.raise} = ps.get(i).x\n",
      b"fn label_at(ps: Columns<P>, i: Int) -> String / {abort.raise} = ps.get(i).label\n",
      b"fn at_at(ps: Columns<P>, i: Int) -> Int / {abort.raise} = ps.get(i).at.b\n",
      b"fn var_at<a>(ps: Columns<{ v: a }>, i: Int) -> a / {abort.raise} = ps.get(i).v\n",
    ]),
  );
  // The field read where the driver hands it over: the call's arguments, then the read.
  let read = |name: Bytes|
    match p.roots.find(|r: Root| r.full == qualify(b"m", name)) {
      None -> [],
      Some(r) -> match r.code {
        None -> [],
        Some(code) -> {
          let cx = context_of(p.setting, r, code);
          // The field read off the record `Columns::get` answers: the innermost of a chain of reads.
          let base = match code.node {
            NField(f) -> match f.base.node {
              NField(g) -> Some({ base: g.base, name: g.field }),
              _ -> Some({ base: f.base, name: f.field }),
            },
            _ -> None,
          };
          match base {
            None -> [],
            Some(b) -> match columned(cx, b.base, b.name) {
              false -> [],
              true -> {
                let ps = {
                  id: 0,
                  ty: match r.types.at(0) { Some(t) -> t, None -> unknown_type() },
                  rep: RWord,
                };
                let i = { id: 1, ty: TyCon({ name: b"Int", args: [] }), rep: RInt };
                let l = column_read(
                  cx,
                  started([ps, i]),
                  [AVar(ps), AVar(i)],
                  b.base,
                  b.name,
                  code.span,
                );
                l.st.insts.fold([], |acc: List<{ op: Operation, answer: Rep }>, x: Inst|
                  match x {
                    Let(v) -> match v.val {
                      Op(o) -> acc.push({ op: o.op, answer: v.var.rep }),
                      _ -> acc,
                    },
                    _ -> acc,
                  })
              },
            },
          }
        },
      },
    };
  // The record's fields in their order: `at`, `label`, `x`.
  assert_eq(read(b"x_at"), [
    {
      op: OContainer(
        ColumnField({
          k: 2,
          column: { held: Bits(FloatBits), stride: 1, shapes: [[b"x!f"]], counted: [] },
        }),
      ),
      answer: RFloat,
    },
  ]);
  assert_eq(read(b"label_at"), [
    {
      op: OContainer(
        ColumnField({ k: 1, column: { held: Words, stride: 1, shapes: [], counted: [] } }),
      ),
      answer: RWord,
    },
  ]);
  // A record held in place in a column is read as the address of its header there.
  assert_eq(read(b"at_at").map(|o: { op: Operation, answer: Rep }| o.answer), [RWord]);
  // Only a field of a record a type lays out has a column of its own.
  assert_eq(read(b"var_at"), [])
}

test "under release a byte string's position is a loop in the body, its predicate called through the runtime" {
  let p = program(b"fn found(b: Bytes) -> Option<Int> = b.position(0, |c: Int| c == 32)\n");
  let released = { ..p, setting: { ..p.setting, release: true } };
  assert_eq(
    ops_in(bound_in(released, b"found")).map(
      |o: { op: Operation, args: List<Arg>, uses: Uses, answer: Rep }| o.uses,
    ),
    [{ takes: [true, false, true], owned: true, fails: true, stops: true }],
  );
  let text = form_text(released, b"found");
  assert(
    text.index_of(b"rt_call_p(ctx, ") != None && text.index_of(b"break;") != None,
    Some(String::of_bytes_lossy(text)),
  );
  // Without release it is the runtime's call.
  assert_eq(
    natives_in(bound_in(p, b"found")).map(
      |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name,
    ),
    [b"builtin_bytes_position_p"],
  )
}

test "a handler's variables, a hold's region and `bracket` are the runtime's, each answering its type" {
  let p = program(
    Bytes::concat_all([
      b"effect tally {\n  write add(n: Int) -> Unit\n  read total() -> Int\n}\n",
      b"fn counted() -> Int = handle { tally.add(1); tally.add(2); tally.total() } with { var n = 0, tally.add(k) -> { n = n + k; }, tally.total() -> n }\n",
      b"fn release(_: Int) -> Unit = ()\n",
      b"fn held(n: Int) -> Int = with_hold[t](n, release) { c -> c.get() }\n",
      b"fn bracketed(n: Int) -> Int = bracket(|| n, release, |x: Int| x + 1)\n",
    ]),
  );
  assert_eq(
    [b"counted", b"held", b"bracketed"].fold(
      [],
      |acc: List<{ name: Bytes, why: Bytes }>, n: Bytes|
        match checked(p, n) { Ok(_) -> acc, Err(why) -> acc.push({ name: n, why: why }) },
    ),
    [],
  );
  assert_eq(
    natives_in(bound_in(p, b"bracketed")).map(
      |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name,
    ),
    [b"builtin_bracket_p"],
  )
}

/// Module `m` of the program of `sources`, run by a runtime implementing `natives`.
fn program_of_modules(
  sources: List<{ name: Bytes, src: Bytes }>,
  natives: List<Bytes>,
) -> Program / {abort.raise} =
  match analyse(parse_all(sources)) {
    Analysed(a) -> match setting_in(a, b"m") {
      Ok(s) ->
        { src: b"", analysis: a, setting: { ..s.setting, builtins: natives }, roots: s.roots },
      Err(why) -> panic(String::of_bytes_lossy(why)),
    },
    _ -> panic("the program does not check"),
  }

test "a name no import takes is the builtin's, and an import that takes a builtin's name is called instead" {
  let names = |p: Program, root: Bytes|
    natives_in(bound_in(p, root)).map(
      |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name,
    );
  let whole = program_of_modules(
    [
      { name: b"min", src: b"pub fn size(xs: List<Int>) -> Int = xs.len()\n" },
      {
        name: b"m",
        src: b"import min\nfn least(x: Int) -> Int = min(x, 1)\nfn n(xs: List<Int>) -> Int = min::size(xs)\n",
      },
    ],
    [b"min", b"List::len"],
  );
  assert_eq(names(whole, b"least"), [b"builtin_min_p"]);
  assert(
    match formed(whole, b"n") {
      Ok(f) ->
        natives_in(
            f.body.fold([], |acc: List<Bound>, i: Inst|
              match i { Let(l) -> acc.push({ var: l.var, val: l.val }), _ -> acc }),
          )
          == [],
      Err(no) -> no.by != Containers,
    },
    None,
  );
  let taken = program_of_modules(
    [
      { name: b"a", src: b"pub fn min(x: Int, y: Int) -> Int = x\n" },
      { name: b"m", src: b"import a (min)\nfn least(x: Int) -> Int = min(x, 1)\n" },
    ],
    [b"min"],
  );
  assert(
    match formed(taken, b"least") {
      Ok(_) -> names(taken, b"least") == [],
      Err(no) -> no.by != Containers,
    },
    None,
  )
}

test "a builtin the runtime lacks is declined, and one written at a scalar's type goes on to scalars" {
  let src = Bytes::concat_all([
    b"fn size(s: String) -> Int = s.len()\n",
    b"fn wrapped(a: U8, b: U8) -> U8 = wrap_add(a, b)\n",
  ]);
  let by = |p: Program, name: Bytes|
    match formed(p, name) { Ok(_) -> None, Err(no) -> Some(no.by) };
  let bare = program(src);
  assert_eq(by({ ..bare, setting: { ..bare.setting, builtins: [] } }, b"size"), Some(Containers));
  assert_eq(by(program(src), b"size"), None);
  assert(by(program(src), b"wrapped") != Some(Containers), None)
}

test "a shipped module's extern is called as the builtin of its own name" {
  let user = b"import std.native (doubled)\nimport std.native as n\nfn f() -> Int = doubled(2) + n::doubled(3)\n";
  let shipped = [{ name: b"std.native", src: b"pub extern fn doubled(x: Int) -> Int\n" }];
  match analyse_pulling_std_with([{ name: b"m", src: user }], shipped, no_rows()).out {
    Analysed(a) -> match setting_in(a, b"m") {
      Ok(s) -> {
        let p = {
          src: user,
          analysis: a,
          setting: { ..s.setting, builtins: [b"doubled"] },
          roots: s.roots,
        };
        assert_eq(
          natives_in(bound_in(p, b"f")).map(
            |c: { name: Bytes, args: List<Arg>, uses: Uses, answer: Rep }| c.name,
          ),
          [b"builtin_doubled_p", b"builtin_doubled_p"],
        )
      },
      Err(why) -> panic(String::of_bytes_lossy(why)),
    },
    _ -> panic("the program does not check"),
  }
}

/// Programs covering what the lang tests of lists, bytes, strings, arrays and maps lower through this
/// family, each root using each counted value it holds once.
fn corpus() -> Bytes =
  Bytes::concat_all([
    b"fn pair(a: String, b: String) -> List<String> = [a, b]\n",
    b"fn ints(a: Int, b: Int) -> List<Int> = [a, b, a + b]\n",
    b"fn floats(x: Float) -> List<Float> = [x, x * 2.0]\n",
    b"fn flags(c: Bool) -> List<Bool> = [c, !c, true]\n",
    b"fn empty() -> List<String> = []\n",
    b"fn nested(a: String) -> List<List<String>> = [[a], []]\n",
    b"fn count(xs: List<String>) -> Int = xs.len()\n",
    b"fn size(b: Bytes) -> Int = b.len()\n",
    b"fn byte(b: Bytes, i: Int) -> Int / {abort.raise} = b.at(i)\n",
    b"fn third(b: Bytes) -> Int / {abort.raise} = b.at(3)\n",
    b"fn word(b: Bytes, i: Int) -> U32 / {abort.raise} = b.u32_le(i)\n",
    b"fn glued(a: Bytes, b: Bytes) -> Bytes = Bytes::concat_all([a, b])\n",
    b"fn all(bs: List<Bytes>) -> Bytes = Bytes::concat_all(bs)\n",
    b"fn cat(a: String, b: String) -> String = String::concat(a, b)\n",
    b"fn cut(b: Bytes, i: Int) -> Bytes / {abort.raise} = b.slice(i, 4)\n",
    b"fn measured(s: String) -> Int = s.len()\n",
    b"fn starts(s: String, p: String) -> Bool = s.starts_with(p)\n",
    b"fn found(h: Bytes, n: Bytes) -> Option<Int> = h.index_of(n)\n",
    b"fn numbers(n: Int) -> List<Int> = range(0, n)\n",
    b"fn fresh() -> Map<Int, String> = Map::new()\n",
    b"fn keys(m: Map<Int, String>) -> Int = m.len()\n",
    b"fn listed(a: Array<Int>) -> List<Int> = a.to_list()\n",
    b"fn arity(a: Array<String>) -> Int = a.len()\n",
    b"fn text(n: Int) -> String = n.to_string()\n",
    b"fn element(a: Array<String>, i: Int) -> Option<String> = a.at(i)\n",
    b"fn reserved(n: Int) -> List<String> = List::with_capacity(n)\n",
    b"fn filled(n: Int, x: Float) -> Array<Float> / {abort.raise} = Array::new(n, x)\n",
    b"fn shared(n: Int, s: String) -> Array<String> / {abort.raise} = Array::new(n, s)\n",
    b"fn replaced(a: Array<Int>, i: Int, x: Int) -> Array<Int> / {abort.raise} = a.set(i, x)\n",
    b"fn renamed(a: Array<String>, s: String) -> Array<String> / {abort.raise} = a.set(0, s)\n",
    b"fn arrayed(xs: List<Int>) -> Array<Int> = Array::of_list(xs)\n",
    b"fn decimals(xs: List<Decimal>) -> Array<Decimal> = Array::of_list(xs)\n",
    b"fn got(a: Array<Float>, i: Int) -> Float / {abort.raise} = a.get(i)\n",
    b"fn small(a: Array<U8>) -> U8 / {abort.raise} = a.get(2)\n",
    b"fn points(n: Int, p: { x: Int, y: Int }) -> Array<{ x: Int, y: Int }> / {abort.raise} = Array::new(n, p)\n",
    b"fn point_y(a: Array<{ x: Int, y: Int }>, i: Int) -> Int / {abort.raise} = a.get(i).y\n",
    b"fn maybes(xs: List<Option<String>>) -> Array<Option<String>> = Array::of_list(xs)\n",
    b"fn maybe_at(a: Array<Option<String>>, i: Int) -> Option<String> / {abort.raise} = a.get(i)\n",
    b"fn put_maybe(a: Array<Option<Int>>, x: Option<Int>) -> Array<Option<Int>> / {abort.raise} = a.set(0, x)\n",
  ])

fn corpus_names() -> List<Bytes> =
  [
    b"pair",
    b"ints",
    b"floats",
    b"flags",
    b"empty",
    b"nested",
    b"count",
    b"size",
    b"byte",
    b"third",
    b"word",
    b"glued",
    b"all",
    b"cat",
    b"cut",
    b"measured",
    b"starts",
    b"found",
    b"numbers",
    b"fresh",
    b"keys",
    b"listed",
    b"arity",
    b"text",
    b"element",
    b"reserved",
    b"filled",
    b"shared",
    b"replaced",
    b"renamed",
    b"arrayed",
    b"decimals",
    b"got",
    b"small",
    b"points",
    b"point_y",
    b"maybes",
    b"maybe_at",
    b"put_maybe",
  ]

/// `text` read past counts, then as `normalised` reads it.
fn read_past_counts(text: Bytes) -> List<Bytes> / {abort.raise} = normalised(past_counts(text))

/// Root `m.<name>` of `p` as the form prints it before any check, or why it was not formed.
fn form_text(p: Program, name: Bytes) -> Bytes / {abort.raise} =
  match formed(p, name) { Ok(f) -> printed_text(f), Err(no) -> no.why }

test "the corpus lowers, and prints as today's emitter writes it but for counts" {
  let p = program(corpus());
  assert_eq(
    corpus_names().fold([], |acc: List<{ name: Bytes, declined: Declined }>, n: Bytes|
      match formed(p, n) { Ok(_) -> acc, Err(no) -> acc.push({ name: n, declined: no }) }),
    [],
  );
  // Each root's counts, once `own` writes them, pass the check.
  assert_eq(
    corpus_names().fold([], |acc: List<{ name: Bytes, why: Bytes }>, n: Bytes|
      match checked(p, n) { Ok(_) -> acc, Err(why) -> acc.push({ name: n, why: why }) }),
    [],
  );
  let today = answered_today(p, corpus_names());
  let differing = corpus_names().fold(
    [],
    |acc: List<{ name: Bytes, today: List<Bytes>, form: List<Bytes> }>, n: Bytes| {
      let form = read_past_counts(form_text(p, n));
      let old = read_past_counts(today_text(today, n));
      if form == old { acc } else { acc.push({ name: n, today: old, form: form }) }
    },
  );
  let items_boxed = b"each item boxed once every item is evaluated, a boxed number tested for failure";
  let boxed_first = b"each operand boxed and tested before the call stores its site, where today boxes after the site without a test";
  let named = [
    { name: b"ints", why: items_boxed },
    { name: b"floats", why: items_boxed },
    { name: b"flags", why: items_boxed },
    { name: b"cut", why: boxed_first },
    { name: b"numbers", why: boxed_first },
    { name: b"text", why: boxed_first },
    { name: b"element", why: boxed_first },
    { name: b"reserved", why: boxed_first },
    {
      name: b"points",
      why: b"the record made its object by `print.made`, which writes it otherwise",
    },
    {
      name: b"put_maybe",
      why: b"the element written as its payload's word; today's writes the `Option`'s object there",
    },
  ];
  assert(
    differing.map(|d: { name: Bytes, today: List<Bytes>, form: List<Bytes> }| d.name)
      == named.map(|n: { name: Bytes, why: Bytes }| n.name),
    Some(
      String::of_bytes_lossy(
        Bytes::join(
          differing.map(|d: { name: Bytes, today: List<Bytes>, form: List<Bytes> }|
            Bytes::concat_all(
              [b"== ", d.name].concat(
                hunks(d.today, d.form).map(|h: Hunk|
                  Bytes::concat_all([
                    b"\n-- today\n",
                    Bytes::join(h.today, b"\n"),
                    b"\n-- form\n",
                    Bytes::join(h.form, b"\n"),
                  ])),
              ),
            )),
          b"\n",
        ),
      ),
    ),
  )
}

/// A function of the prelude calling each extern written in place, as the prelude's own functions
/// call them: at a scalar item, a counted one, an item of a type variable, and through a value.
fn in_place_calls() -> List<{ name: Bytes, src: Bytes }> =
  [
    { name: b"start", src: b"(xs: List<Int>) -> Int = ListNode::start(xs)" },
    { name: b"tail_len", src: b"(xs: List<Int>) -> Int = ListNode::tail_len(xs)" },
    { name: b"root", src: b"(xs: List<Int>) -> Option<ListNode<Int>> = ListNode::root(xs)" },
    { name: b"tail_at", src: b"(xs: List<String>) -> String = ListNode::tail_at(xs, 1)" },
    { name: b"len", src: b"(n: ListNode<Int>) -> Int = ListNode::len(n)" },
    { name: b"leaf_at", src: b"(n: ListNode<Int>) -> Int = ListNode::leaf_at(n, 3)" },
    { name: b"leaf_at_any", src: b"<a>(n: ListNode<a>) -> a = ListNode::leaf_at(n, 3)" },
    { name: b"leaf_at_on", src: b"(n: ListNode<String>) -> String = n.leaf_at(3)" },
    { name: b"kid_at", src: b"(n: ListNode<Int>) -> ListNode<Int> = ListNode::kid_at(n, 1)" },
    {
      name: b"tail_push",
      src: b"(xs: List<String>, x: String) -> List<String> = ListNode::tail_push(xs, x)",
    },
    { name: b"tail_set", src: b"(xs: List<Int>) -> List<Int> = ListNode::tail_set(xs, 2, 7)" },
    {
      name: b"leaf_set",
      src: b"(n: ListNode<String>, x: String) -> ListNode<String> = ListNode::leaf_set(n, 2, x)",
    },
    {
      name: b"root_swap",
      src: b"(xs: List<Int>, r: ListNode<Int>) -> Option<ListNode<Int>> = ListNode::root_swap(xs, Some(r)).old",
    },
    {
      name: b"kid_swap",
      src: b"(n: ListNode<Int>) -> ListNode<Int> = ListNode::kid_swap(n, 0, None).node",
    },
    { name: b"tail_start", src: b"(xs: List<Int>) -> List<Int> = ListNode::tail_start(xs, 7)" },
    { name: b"spill", src: b"(xs: List<Int>) -> ListNode<Int> = ListNode::spill(xs).leaf" },
    { name: b"branch", src: b"() -> ListNode<Int> = ListNode::branch()" },
    {
      name: b"map_root",
      src: b"(m: Map<Int, String>) -> Option<MapNode<Int, String>> = MapNode::root(m)",
    },
    { name: b"height", src: b"(m: Map<Int, String>) -> Int = MapNode::height(m)" },
    { name: b"count", src: b"(n: MapNode<Int, String>) -> Int = MapNode::count(n)" },
    { name: b"key", src: b"(n: MapNode<Int, String>) -> Int = MapNode::key(n, 1)" },
    { name: b"value", src: b"(n: MapNode<Int, String>) -> String = MapNode::value(n, 1)" },
    {
      name: b"kid",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid(n, 1)",
    },
    { name: b"kid_max", src: b"(n: MapNode<Int, String>) -> Int = MapNode::kid_max(n, 1)" },
    { name: b"kid_size", src: b"(n: MapNode<Int, String>) -> Int = MapNode::kid_size(n, 1)" },
    { name: b"leaf", src: b"() -> MapNode<Int, String> = MapNode::leaf()" },
    { name: b"map_branch", src: b"() -> MapNode<Int, String> = MapNode::branch()" },
    {
      name: b"pair_put",
      src: b"(n: MapNode<Int, String>, v: String) -> MapNode<Int, String> = MapNode::pair_put(n, 1, 5, v)",
    },
    {
      name: b"pair_set",
      src: b"(n: MapNode<Int, String>, v: String) -> MapNode<Int, String> = MapNode::pair_set(n, 1, 5, v)",
    },
    {
      name: b"pair_take",
      src: b"(n: MapNode<Int, String>) -> String = MapNode::pair_take(n, 1).value",
    },
    {
      name: b"key_take",
      src: b"(n: MapNode<{ a: Int, b: Int }, Int>) -> { a: Int, b: Int } = MapNode::pair_take(n, 1).key",
    },
    {
      name: b"leaf_cut",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::leaf_cut(n, 16).right",
    },
    {
      name: b"branch_cut",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::branch_cut(n, 16).left",
    },
    {
      name: b"kid_out",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_out(n, 1).kid",
    },
    {
      name: b"kid_back",
      src: b"(n: MapNode<Int, String>, k: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_back(n, 1, k, 9, 4)",
    },
    {
      name: b"kid_put",
      src: b"(n: MapNode<Int, String>, k: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_put(n, 1, k, 9, 4)",
    },
    {
      name: b"kid_drop",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_drop(n, 1)",
    },
    {
      name: b"map_swap",
      src: b"(m: Map<Int, String>, r: MapNode<Int, String>) -> Map<Int, String> = MapNode::map_swap(m, Some(r), 1, 40).map",
    },
  ]

test "each extern written in place is an operation over the runtime's objects as the layouts lay them out" {
  let calls = in_place_calls();
  let probes = calls.fold(b"\n", |acc: Bytes, c: { name: Bytes, src: Bytes }|
    Bytes::concat_all([acc, b"fn probe_", c.name, c.src, b"\n"]));
  assert_eq(
    intrinsics().filter(|i: { name: Bytes, op: Intrinsic }|
      probes.index_of(i.name.slice(b"std.prelude.".len(), i.name.len()).concat(b"(")) == None).map(
      |i: { name: Bytes, op: Intrinsic }| i.name,
    ),
    [],
  );
  match analyse(parse_all([{ name: b"std.prelude", src: prelude_source::text().concat(probes) }])) {
    Analysed(a) -> match setting_in(a, b"std.prelude") {
      Ok(s) -> {
        let form = |name: Bytes| {
          let full = b"std.prelude.probe_".concat(name);
          match s.roots.find(|r: Root| r.full == full) {
            None -> Err({ by: Spine, why: b"no such probe" }),
            Some(r) -> match r.code {
              None -> Err({ by: Spine, why: b"a probe that does not lower to Code" }),
              Some(code) -> lowered_fn(context_of(s.setting, r, code), code),
            },
          }
        };
        // Each probe writes its extern as one operation and calls nothing.
        let written = |f: Fn|
          f.body.fold([], |acc: List<Val>, i: Inst|
            match i {
              Let(l) -> match l.val {
                Op(_) -> acc.push(l.val),
                Native(_) -> acc.push(l.val),
                Call(_) -> acc.push(l.val),
                _ -> acc,
              },
              _ -> acc,
            });
        assert_eq(
          calls.fold(
            [],
            |acc: List<{ name: Bytes, why: Bytes }>, c: { name: Bytes, src: Bytes }|
              match form(c.name) {
                Ok(f) -> match written(f) {
                  [Op(o)] -> match o.op {
                    OContainer(Laid(_)) -> acc,
                    _ -> acc.push({ name: c.name, why: b"another operation" }),
                  },
                  _ -> acc.push({ name: c.name, why: b"not one operation" }),
                },
                Err(no) -> acc.push({ name: c.name, why: no.why }),
              },
          ),
          [],
        );
        let code = |name: Bytes|
          match form(name) { Ok(f) -> spelled(printed_fn(f).pieces), Err(no) -> no.why };
        let laid = layouts();
        let has = |name: Bytes, text: Bytes| code(name).index_of(text) != None;
        let field = |name: Bytes| b"->".concat(name);
        let node = |kind: Int| Bytes::concat_all([b"rt_node_p(ctx, ", ascii_of_int(kind), b")"]);
        let past = |from: Int| ascii_of_int(from).concat(b" + (");
        assert_eq(
          [
            has(b"start", field(laid.list.start)),
            has(b"tail_len", field(laid.list.tail_len)),
            has(b"tail_at", past(laid.list.tail)),
            has(b"height", field(laid.map.height)),
            has(b"kid_max", past(laid.tree.keys)),
            has(b"kid_size", past(laid.tree.sizes)),
            has(b"branch", node(laid.trie.branch)),
            has(b"leaf", node(laid.tree.leaf)),
            has(b"map_branch", node(laid.tree.branch)),
            has(b"tail_push", field(laid.list.room)),
            has(b"spill", node(laid.trie.leaf)),
            has(b"branch_cut", node(laid.tree.branch)),
            has(b"leaf_cut", node(laid.tree.leaf)),
          ],
          [true, true, true, true, true, true, true, true, true, true, true, true, true],
        );
        // A write makes what it writes held once where it is not, and counts an item's or a pair's.
        assert_eq(
          [
            has(b"tail_push", b"rt_list_writable_p(ctx, "),
            has(b"leaf_set", b"rt_node_writable_p(ctx, "),
            has(b"map_swap", b"rt_map_writable_p(ctx, "),
            has(b"pair_set", b"rt_note_update_p(ctx, "),
            has(b"kid_put", b"rt_note_update_p(ctx, "),
          ],
          [true, true, true, true, false],
        );
        // An extern answering a record answers it as its fields, no record made: its word stays none.
        let fields = |name: Bytes|
          match form(name) {
            Ok(f) ->
              f.body.fold([], |acc: List<Rep>, i: Inst|
                match i {
                  Let(l) -> match l.val { Op(_) -> acc.push(l.var.rep), _ -> acc },
                  _ -> acc,
                }),
            Err(_) -> [],
          };
        assert_eq(fields(b"root_swap"), [
          RFlat([{ name: b"list", rep: RWord }, { name: b"old", rep: RMaybe }]),
        ]);
        assert_eq(fields(b"pair_take"), [
          RFlat([
            { name: b"key", rep: RInt },
            { name: b"node", rep: RWord },
            { name: b"value", rep: RWord },
          ]),
        ]);
        assert(
          code(b"pair_take").index_of(b"_3 = 0;") != None,
          Some(String::of_bytes_lossy(code(b"pair_take"))),
        );
        // A key held in place is its leaves, loaded out of the word the pair held, and that word,
        // whose count the record takes.
        assert_eq(fields(b"key_take"), [
          RFlat([
            { name: b"key.a", rep: RInt },
            { name: b"key.b", rep: RInt },
            { name: b"key", rep: RWord },
            { name: b"node", rep: RWord },
            { name: b"value", rep: RInt },
          ]),
        ]);
        assert(
          code(b"key_take").index_of(b"_0 = (int64_t)(ply_words(") != None,
          Some(String::of_bytes_lossy(code(b"key_take"))),
        );
        assert_eq(
          calls.filter(|c: { name: Bytes, src: Bytes }| has(c.name, b"builtin_")).map(
            |c: { name: Bytes, src: Bytes }| c.name,
          ),
          [],
        )
      },
      Err(why) -> panic(String::of_bytes_lossy(why)),
    },
    _ -> panic("the prelude and its probes do not check"),
  }
}
