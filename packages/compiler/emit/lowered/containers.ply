/// Root `m.<name>` of `p` as the form prints it before any check, or why it was not formed.
fn form_text(p: Program, name: Bytes) -> Bytes / {abort.raise} =
  match formed(p, name) { Ok(f) -> printed_text(p, f), Err(no) -> no.why }

test "the corpus lowers, passes the check once its counts are placed, and prints" {
  assert_eq(not_built(program(corpus()), corpus_names()), [])
}

/// A function of the prelude calling each extern written in place, as the prelude's own functions
/// call them: at a scalar item, a counted one, an item of a type variable, and through a value.
fn in_place_calls() -> List<{ name: Bytes, src: Bytes }> =
  [
    { name: b"start", src: b"(xs: List<Int>) -> Int = ListNode::start(xs)" },
    { name: b"tail_len", src: b"(xs: List<Int>) -> Int = ListNode::tail_len(xs)" },
    { name: b"root", src: b"(xs: List<Int>) -> Option<ListNode<Int>> = ListNode::root(xs)" },
    { name: b"tail_at", src: b"(xs: List<String>) -> String = ListNode::tail_at(xs, 1)" },
    {
      name: b"tail_at_maybe",
      src: b"(xs: List<Option<Int>>) -> Option<Int> = ListNode::tail_at(xs, 1)",
    },
    { name: b"len", src: b"(n: ListNode<Int>) -> Int = ListNode::len(n)" },
    { name: b"leaf_at", src: b"(n: ListNode<Int>) -> Int = ListNode::leaf_at(n, 3)" },
    { name: b"leaf_at_any", src: b"<a>(n: ListNode<a>) -> a = ListNode::leaf_at(n, 3)" },
    { name: b"leaf_at_on", src: b"(n: ListNode<String>) -> String = n.leaf_at(3)" },
    { name: b"kid_at", src: b"(n: ListNode<Int>) -> ListNode<Int> = ListNode::kid_at(n, 1)" },
    {
      name: b"tail_push",
      src: b"(xs: List<String>, x: String) -> List<String> = ListNode::tail_push(xs, x)",
    },
    { name: b"tail_set", src: b"(xs: List<Int>) -> List<Int> = ListNode::tail_set(xs, 2, 7)" },
    {
      name: b"leaf_set",
      src: b"(n: ListNode<String>, x: String) -> ListNode<String> = ListNode::leaf_set(n, 2, x)",
    },
    {
      name: b"leaf_set_any",
      src: b"<a>(n: ListNode<a>, x: a) -> ListNode<a> = ListNode::leaf_set(n, 2, x)",
    },
    {
      name: b"root_swap",
      src: b"(xs: List<Int>, r: ListNode<Int>) -> Option<ListNode<Int>> = ListNode::root_swap(xs, Some(r)).old",
    },
    {
      name: b"kid_swap",
      src: b"(n: ListNode<Int>) -> ListNode<Int> = ListNode::kid_swap(n, 0, None).node",
    },
    { name: b"tail_start", src: b"(xs: List<Int>) -> List<Int> = ListNode::tail_start(xs, 7)" },
    { name: b"spill", src: b"(xs: List<Int>) -> ListNode<Int> = ListNode::spill(xs).leaf" },
    { name: b"branch", src: b"() -> ListNode<Int> = ListNode::branch()" },
    {
      name: b"map_root",
      src: b"(m: Map<Int, String>) -> Option<MapNode<Int, String>> = MapNode::root(m)",
    },
    { name: b"height", src: b"(m: Map<Int, String>) -> Int = MapNode::height(m)" },
    { name: b"count", src: b"(n: MapNode<Int, String>) -> Int = MapNode::count(n)" },
    { name: b"key", src: b"(n: MapNode<Int, String>) -> Int = MapNode::key(n, 1)" },
    { name: b"value", src: b"(n: MapNode<Int, String>) -> String = MapNode::value(n, 1)" },
    {
      name: b"kid",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid(n, 1)",
    },
    { name: b"kid_max", src: b"(n: MapNode<Int, String>) -> Int = MapNode::kid_max(n, 1)" },
    { name: b"kid_size", src: b"(n: MapNode<Int, String>) -> Int = MapNode::kid_size(n, 1)" },
    { name: b"leaf", src: b"() -> MapNode<Int, String> = MapNode::leaf()" },
    { name: b"map_branch", src: b"() -> MapNode<Int, String> = MapNode::branch()" },
    {
      name: b"pair_put",
      src: b"(n: MapNode<Int, String>, v: String) -> MapNode<Int, String> = MapNode::pair_put(n, 1, 5, v)",
    },
    {
      name: b"pair_set",
      src: b"(n: MapNode<Int, String>, v: String) -> MapNode<Int, String> = MapNode::pair_set(n, 1, 5, v)",
    },
    {
      name: b"pair_take",
      src: b"(n: MapNode<Int, String>) -> String = MapNode::pair_take(n, 1).value",
    },
    {
      name: b"key_take",
      src: b"(n: MapNode<{ a: Int, b: Int }, Int>) -> { a: Int, b: Int } = MapNode::pair_take(n, 1).key",
    },
    {
      name: b"open_key_take",
      src: b"<v>(n: MapNode<{ a: Int, b: Int }, v>) -> { a: Int, b: Int } = MapNode::pair_take(n, 1).key",
    },
    {
      name: b"nested_take",
      src: b"(n: MapNode<{ a: { x: Int, y: String }, b: Int }, Int>) -> { a: { x: Int, y: String }, b: Int } = MapNode::pair_take(n, 1).key",
    },
    {
      name: b"leaf_cut",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::leaf_cut(n, 16).right",
    },
    {
      name: b"branch_cut",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::branch_cut(n, 16).left",
    },
    {
      name: b"kid_out",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_out(n, 1).kid",
    },
    {
      name: b"kid_back",
      src: b"(n: MapNode<Int, String>, k: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_back(n, 1, k, 9, 4)",
    },
    {
      name: b"kid_put",
      src: b"(n: MapNode<Int, String>, k: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_put(n, 1, k, 9, 4)",
    },
    {
      name: b"kid_drop",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_drop(n, 1)",
    },
    {
      name: b"map_swap",
      src: b"(m: Map<Int, String>, r: MapNode<Int, String>) -> Map<Int, String> = MapNode::map_swap(m, Some(r), 1, 40).map",
    },
  ]

fn con(name: Bytes, args: List<Type>) -> Type = TyCon({ name: name, args: args })

/// The C a write prints copying a block of type `ty` where another holds it too: a call of the root
/// written to copy it, as the unit names the root.
fn copy_call(ty: Type) -> Bytes / {abort.raise} =
  Bytes::concat_all([b" = ", symbol_of(root_name(root_of(Copy, ty))), b"(ctx, "])

/// The C a write prints letting go of an item of type `ty` it wrote over: the root dropping it, as
/// the unit names the root.
fn dropped_with(ty: Type) -> Bytes / {abort.raise} =
  Bytes::concat_all([b", ", symbol_of(root_name(drop_of(ty))), b");"])

/// For each probe of `in_place_calls`, C its printed body holds and C it must not: each slot read or
/// written as what it holds. A root or a kid is an `Option`'s one word, which nothing opens; an item
/// a word, read as the scalar it stands for; a size an immediate.
fn laid_expected() -> List<{ name: Bytes, has: List<Bytes>, lacks: List<Bytes> }> / {abort.raise} = {
  let reads = |name: Bytes, has: List<Bytes>| { name: name, has: has, lacks: [] };
  let payload = |name: Bytes, has: List<Bytes>|
    { name: name, has: has, lacks: [b"rt_maybe_open_p", b"rt_maybe_take_p"] };
  let returned = |name: Bytes, has: List<Bytes>|
    { name: name, has: has, lacks: [b"rt_maybe_open_p"] };
  let dec = call_start(dec_fn(), [b"ctx"]);
  [
    reads(b"start", [b" = (int64_t)ply_obj(p0)->layout;"]),
    reads(b"tail_len", [b" = (int64_t)ply_obj(p0)->flags;"]),
    returned(b"root", [b" = ply_words(p0)[0];"]),
    reads(b"tail_at", [b" = ply_words(p0)[1 + (INT64_C(1))];"]),
    reads(b"len", [b" = (int64_t)ply_obj(p0)->len;"]),
    reads(b"leaf_at", [
      b" = (ply_is_imm(ply_words(p0)[0 + (INT64_C(3))]) ? ply_imm_value(ply_words(p0)[0 + (INT64_C(3))]) : rt_unbox_int_p(ctx, ply_words(p0)[0 + (INT64_C(3))]));",
    ]),
    reads(b"leaf_at_any", [b" = ply_words(p0)[0 + (INT64_C(3))];"]),
    reads(b"leaf_at_on", [b" = ply_words(p0)[0 + (INT64_C(3))];"]),
    reads(b"kid_at", [b" = ply_words(p0)[0 + (INT64_C(1))];"]),
    reads(b"tail_push", [
      copy_call(con(b"List", [con(b"String", [])])),
      b" = rt_list_room_p(ctx, 2 * n); ",
      call_start(free_fn(), [b"ctx"]),
      b")->flags)] = p1; ",
      b")->flags += 1; ply_obj(",
    ]),
    reads(b"tail_set", [
      b"rt_note_update_p(ctx, in_place, in_place ? 0 : ply_obj(",
      b"[1 + (INT64_C(2))]; ply_words(",
    ]),
    reads(b"leaf_set", [
      copy_call(con(b"std.prelude.ListNode", [con(b"String", [])])),
      b"[INT64_C(2)] = p1;",
      dropped_with(con(b"String", [])),
    ]),
    returned(b"root_swap", [
      copy_call(con(b"List", [con(b"Int", [])])),
      b")[0]; ply_words(",
      b")[0] = ",
    ]),
    payload(b"kid_swap", [
      b" = 0; if (INT64_C(0) < (int64_t)ply_obj(",
      b")->len = (uint32_t)(INT64_C(0)) + 1; ",
    ]),
    reads(b"tail_start", [b"[1 + (0)] = ", b")->flags = 1; "]),
    reads(b"spill", [b"rt_node_p(ctx, 11); memcpy(ply_words(", b"32 * sizeof(Word)); ply_obj("]),
    reads(b"branch", [b"rt_node_p(ctx, 12)"]),
    returned(b"map_root", [b" = ply_words(p0)[0];"]),
    reads(b"height", [b" = (int64_t)ply_obj(p0)->layout;"]),
    reads(b"count", [b" = (int64_t)ply_obj(p0)->len;"]),
    reads(b"key", [b" = (ply_is_imm(ply_words(p0)[2 * (INT64_C(1))]) ? "]),
    reads(b"value", [b" = ply_words(p0)[2 * (INT64_C(1)) + 1];"]),
    reads(b"kid", [b" = ply_words(p0)[0 + (INT64_C(1))];"]),
    reads(b"kid_max", [b" = (ply_is_imm(ply_words(p0)[33 + (INT64_C(1))]) ? "]),
    reads(b"kid_size", [b" = ply_imm_value(ply_words(p0)[66 + (INT64_C(1))]);"]),
    reads(b"leaf", [b"rt_node_p(ctx, 13)"]),
    reads(b"map_branch", [b"rt_node_p(ctx, 14)"]),
    reads(b"pair_put", [
      b"[2 * (INT64_C(1)) + 2], &ply_words(",
      b"[2 * (INT64_C(1)) + 1] = p1; ",
      b")->len += 1;",
    ]),
    reads(b"pair_set", [
      b"[2 * (INT64_C(1)) + 1] = p1;",
      call_start(rel_int_fn(), [b"ctx"]),
      dropped_with(con(b"String", [])),
    ]),
    reads(b"pair_take", [
      b"[2 * (INT64_C(1))]; Word ",
      b"[2 * (INT64_C(1)) + 2 + -2], &ply_words(",
      b")->len -= 1;",
      Bytes::concat_all([b"; ", dec, b"t"]),
    ]),
    reads(b"leaf_cut", [b"rt_node_p(ctx, 13); memcpy(&ply_words(", b"[0 + 2 * (INT64_C(16))]"]),
    reads(b"branch_cut", [b"rt_node_p(ctx, 14); memcpy(&ply_words(", b"[33 + 1 * (INT64_C(16))]"]),
    reads(b"kid_out", [b"[(INT64_C(1))] = 0;"]),
    reads(b"kid_back", [b"[66 + ((INT64_C(1)))] = ply_imm(INT64_C(4));", b"[(INT64_C(1))] = p1; "]),
    reads(b"kid_put", [b"[66 + ((INT64_C(1)))] = ply_imm(INT64_C(4)); ", b")->len += 1;"]),
    reads(b"kid_drop", [
      dropped_with(con(b"std.prelude.MapNode", [con(b"Int", []), con(b"String", [])])),
      call_start(rel_int_fn(), [b"ctx"]),
      b")->len -= 1;",
    ]),
    payload(b"map_swap", [
      copy_call(con(b"Map", [con(b"Int", []), con(b"String", [])])),
      b")[0]; ply_words(",
      b")->layout = (uint32_t)(INT64_C(1)); ",
      b")->len = (uint32_t)(INT64_C(40));",
    ]),
    // A key held as its word in the pair: its leaves opened out of that box, freed where it held the
    // last count.
    {
      name: b"key_take",
      has: [
        b"_0 = (int64_t)ply_words(t2)[0];",
        Bytes::concat_all([
          b"if (",
          call_text(last_fn(), [b"ctx", b"t2"]),
          b") ",
          call_text(free_fn(), [b"ctx", b"t2", b"INT64_C(32)"]),
          b";",
        ]),
      ],
      lacks: [call_start(inc_fn(), []), call_start(dup_fn(), [])],
    },
    // Two levels deep, a leaf is read out of the key's box at its place, counted again where the box
    // was shared.
    reads(b"nested_take", [
      b"Word t4_1 = ply_words(t2)[1];",
      Bytes::concat_all([b"else { ", call_text(dup_fn(), [b"t4_1"]), b"; }"]),
    ]),
  ]
}

test "each extern written in place is an operation over the runtime's objects as the layouts lay them out" {
  let calls = in_place_calls();
  let probes = calls.fold(b"\n", |acc: Bytes, c: { name: Bytes, src: Bytes }|
    Bytes::concat_all([acc, b"fn probe_", c.name, c.src, b"\n"]));
  assert_eq(
    intrinsics().filter(|i: { name: Bytes, op: Intrinsic }|
      probes.index_of(i.name.slice(b"std.prelude.".len(), i.name.len()).concat(b"(")) == None).map(
      |i: { name: Bytes, op: Intrinsic }| i.name,
    ),
    [],
  );
  match analyse(parse_all([{ name: b"std.prelude", src: prelude_source::text().concat(probes) }])) {
    Analysed(a) -> match setting_in(a, b"std.prelude") {
      Ok(s) -> {
        let form = |name: Bytes| {
          let full = b"std.prelude.probe_".concat(name);
          match s.roots.find(|r: Root| r.key == Named(full)) {
            None -> Err({ by: Spine, why: b"no such probe" }),
            Some(r) -> match r.code {
              Err(why) -> Err({ by: Spine, why: why }),
              Ok(code) -> lowered_fn(context_of(s.setting, r, code), code),
            },
          }
        };
        // Each probe writes its extern as one operation and calls nothing.
        let written = |f: Fn|
          f.body.fold([], |acc: List<Val>, i: Inst|
            match i {
              Let(l) -> match l.val {
                Op(_) -> acc.push(l.val),
                Native(_) -> acc.push(l.val),
                Call(_) -> acc.push(l.val),
                _ -> acc,
              },
              _ -> acc,
            });
        assert_eq(
          calls.fold(
            [],
            |acc: List<{ name: Bytes, why: Bytes }>, c: { name: Bytes, src: Bytes }|
              match form(c.name) {
                Ok(f) -> match written(f) {
                  [Op(o)] -> match o.op {
                    OContainer(Laid(_)) -> acc,
                    _ -> acc.push({ name: c.name, why: b"another operation" }),
                  },
                  _ -> acc.push({ name: c.name, why: b"not one operation" }),
                },
                Err(no) -> acc.push({ name: c.name, why: no.why }),
              },
          ),
          [],
        );
        let code = |name: Bytes|
          match form(name) {
            Ok(f) -> spelled(printed_fn(f, s.setting.ctors).pieces),
            Err(no) -> no.why,
          };
        let laid = layouts();
        let has = |name: Bytes, text: Bytes| code(name).index_of(text) != None;
        let field = |name: Bytes| b"->".concat(name);
        let node = |kind: Int| Bytes::concat_all([b"rt_node_p(ctx, ", ascii_of_int(kind), b")"]);
        let past = |from: Int| ascii_of_int(from).concat(b" + (");
        assert_eq(
          [
            has(b"start", field(laid.list.start)),
            has(b"tail_len", field(laid.list.tail_len)),
            has(b"tail_at", past(laid.list.tail)),
            has(b"height", field(laid.map.height)),
            has(b"kid_max", past(laid.tree.keys)),
            has(b"kid_size", past(laid.tree.sizes)),
            has(b"branch", node(laid.trie.branch)),
            has(b"leaf", node(laid.tree.leaf)),
            has(b"map_branch", node(laid.tree.branch)),
            has(b"tail_push", field(laid.list.room)),
            has(b"spill", node(laid.trie.leaf)),
            has(b"branch_cut", node(laid.tree.branch)),
            has(b"leaf_cut", node(laid.tree.leaf)),
          ],
          [true, true, true, true, true, true, true, true, true, true, true, true, true],
        );
        // A write makes what it writes held once where it is not, by the root copying its type's
        // block, which the root's calls name; and counts an item's or a pair's.
        assert_eq(
          [has(b"pair_set", b"rt_note_update_p(ctx, "), has(b"kid_put", b"rt_note_update_p(ctx, ")],
          [true, false],
        );
        // A probe a type variable leaves open is printed only at the types its callers settle.
        let settled = calls.filter(|c: { name: Bytes, src: Bytes }|
          match form(c.name) { Ok(f) -> f.links.needs == [], Err(_) -> true });
        assert_eq(settled.filter(|c: { name: Bytes, src: Bytes }| has(c.name, b"_writable_p(")), [
        ]);
        let copies = |name: Bytes|
          match form(name) {
            Ok(f) ->
              printed_fn(f, s.setting.ctors).calls.filter(|k: RootKey|
                match k { Written(w) -> w.op == Copy, _ -> false }),
            Err(_) -> [],
          };
        assert_eq(
          [b"leaf_set", b"kid_put", b"map_swap", b"branch_cut", b"tail_start", b"leaf_at"].map(
            copies,
          ),
          [
            [root_of(Copy, con(b"std.prelude.ListNode", [con(b"String", [])]))],
            [root_of(Copy, con(b"std.prelude.MapNode", [con(b"Int", []), con(b"String", [])]))],
            [root_of(Copy, con(b"Map", [con(b"Int", []), con(b"String", [])]))],
            [root_of(Copy, con(b"std.prelude.MapNode", [con(b"Int", []), con(b"String", [])]))],
            [],
            [],
          ],
        );
        // A write at a type variable notes it, so only a specialisation, which lays its items out,
        // copies the block.
        assert_eq(match form(b"leaf_set_any") { Ok(f) -> f.links.needs, Err(_) -> [] }, [
          { var: 0, reads: Layout },
        ]);
        // An extern answering a record answers it as its fields, no record made: its word stays none.
        let fields = |name: Bytes|
          match form(name) {
            Ok(f) ->
              f.body.fold([], |acc: List<Rep>, i: Inst|
                match i {
                  Let(l) -> match l.val { Op(_) -> acc.push(l.var.rep), _ -> acc },
                  _ -> acc,
                }),
            Err(_) -> [],
          };
        assert_eq(
          fields(b"root_swap").map(|r: Rep|
            match r {
              RFlat(ls) ->
                ls.map(|l: Leaf|
                  { name: l.name, sum: match l.rep { RSum(_) -> true, _ -> false } }),
              _ -> [],
            }),
          [[{ name: b"list", sum: false }, { name: b"old", sum: true }]],
        );
        assert_eq(fields(b"pair_take"), [
          RFlat([
            { name: b"key", rep: RInt },
            { name: b"node", rep: RWord },
            { name: b"value", rep: RWord },
          ]),
        ]);
        // A key held in place is its leaves, opened out of the word the pair held, whose count the
        // record takes.
        assert_eq(fields(b"key_take"), [
          RFlat([
            { name: b"key.a", rep: RInt },
            { name: b"key.b", rep: RInt },
            { name: b"node", rep: RWord },
            { name: b"value", rep: RInt },
          ]),
        ]);
        // A record a type variable leaves open holds each field as its word.
        assert_eq(fields(b"open_key_take"), [
          RFlat([
            { name: b"key", rep: RWord },
            { name: b"node", rep: RWord },
            { name: b"value", rep: RWord },
          ]),
        ]);
        assert_eq(fields(b"nested_take"), [
          RFlat([
            { name: b"key.a.x", rep: RInt },
            { name: b"key.a.y", rep: RWord },
            { name: b"key.b", rep: RInt },
            { name: b"node", rep: RWord },
            { name: b"value", rep: RInt },
          ]),
        ]);
        assert_eq(
          settled.filter(|c: { name: Bytes, src: Bytes }| has(c.name, b"builtin_")).map(
            |c: { name: Bytes, src: Bytes }| c.name,
          ),
          [],
        );
        let none_missed = |missed: List<Bytes>|
          assert(missed.len() == 0, Some(String::of_bytes_lossy(Bytes::join(missed, b"\n"))));
        // What each extern reads and writes, slot by slot, in the representation the slot holds.
        none_missed(
          laid_expected().fold(
            [],
            |acc: List<Bytes>, e: { name: Bytes, has: List<Bytes>, lacks: List<Bytes> }| {
              let text = code(e.name);
              if e.has.all(|t: Bytes| text.index_of(t) != None)
                  && e.lacks.all(|t: Bytes| text.index_of(t) == None) { acc }
              else { acc.push(Bytes::concat_all([e.name, b":\n", text])) }
            },
          ),
        );
        // A root is read without a count of its own, so answering it takes one.
        none_missed(
          [b"root", b"map_root"].fold([], |acc: List<Bytes>, name: Bytes| {
            let text = match form(name) {
              Ok(f) -> spelled(printed_fn(owned(f), s.setting.ctors).pieces),
              Err(no) -> no.why,
            };
            if takes_count(text) { acc } else { acc.push(Bytes::concat_all([name, b":\n", text])) }
          }),
        )
      },
      Err(why) -> panic(String::of_bytes_lossy(why)),
    },
    _ -> panic("the prelude and its probes do not check"),
  }
}
