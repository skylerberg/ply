//! Records, sums, fields, updates and joins lowered from a program's text: the decision the form
//! makes for each, read off the lowered root; and a corpus of them, each root lowered, checked and
//! printed or declined by the family its construct belongs to.

import check.resolve.tables (qualify)
import emit.answer (Need, Layout, Exact)
import emit.roots (symbol_of)
import emit.keys (Named)
import emit.pieces (spelled)
import emit.compare (Program, program_of, formed, checked, printed_text, printed_in, not_built,
                     printed_by_form)
import emit.own (owned)
import emit.tir (Rep, RFloat, RWord, RInt, RSum, RFlat, Var, AVar, AInt, AZero, Val, Make, MRecord,
                 Get, Pack, Gathered, PLeaf, PNamed, Inst, Let, Decl, Assign, If, Case, Match,
                 Block, Fn, Family, Data, Calling, Leaf, counted, rep_of_arg)
import emit.lower.held (held_as, passing, ByReference, values_of)
import emit.lower.base (Context, started)
import emit.lower.calling (context_of)
import emit.lower.data (updated)
import emit.code (NLit)
import emit.reps (no_ctors)
import emit.typing (no_filings, unknown_type, filed_as)
import check.types (TyRecord, int_type)
import syntax.patterns (LUnit)
import syntax.parsing (dummy_span)
import std.math (ilog2)
import std.pace (paced)
import std.bytes (ascii_of_int)
import emit.print.made (head_types)

/// Records, sums and joins of them, each root lowered by this family or declined by the family a
/// construct of it belongs to.
fn corpus() -> Bytes =
  Bytes::concat_all([
    b"type P = { x: Float, y: Float }\n",
    b"type Seg = { from: P, label: String, to: P }\n",
    b"type Wide = { a: Int, b: Int, c: Int, d: Int, e: Float }\n",
    b"type Pt = new { x: Int, y: Int }\n",
    b"type Shape = | Circle(Float) | Box(Int, String) | Dot\n",
    b"type Holder = { name: String, maybe: Option<String> }\n",
    b"type Bad = { why: Bytes }\n",
    b"type Def = { effect: Bytes, nondet: Bool, type: Int }\n",
    b"fn point(x: Float, y: Float) -> P = { y: y, x: x }\n",
    b"fn sum(p: P) -> Float = p.x + p.y\n",
    b"fn moved(p: P, by: Float) -> P = { ..p, x: by }\n",
    b"fn pick(c: Bool, p: P, q: P) -> P = if c { p } else { q }\n",
    b"fn mid(a: P, b: P) -> P = { x: a.x, y: b.y }\n",
    b"fn last(w: Wide) -> Float = w.e\n",
    b"fn widened(w: Wide, e: Float) -> Wide = { ..w, e: e }\n",
    b"fn segment(from: P, to: P, label: String) -> Seg = { from: from, label: label, to: to }\n",
    b"fn start(s: Seg) -> P = s.from\n",
    b"fn end_x(s: Seg) -> Float = s.to.x\n",
    b"fn relabelled(s: Seg, label: String) -> Seg = { ..s, label: label }\n",
    b"fn wides(w: Wide, e: Float) -> List<Wide> = [{ ..w, e: e }]\n",
    b"fn segments(from: P, to: P, label: String) -> List<Seg> = [{ from: from, label: label, to: to }]\n",
    b"fn relabelleds(s: Seg, label: String) -> List<Seg> = [{ ..s, label: label }]\n",
    b"fn pt(x: Int, y: Int) -> Pt = { x: x, y: y }\n",
    b"fn pt_x(p: Pt) -> Int = p.x\n",
    b"fn pair(n: Int, s: String) -> (Int, String) = (n, s)\n",
    b"fn second(t: (Int, String)) -> String = t._1\n",
    b"fn declare(e: Bytes) -> Def = { effect: e, nondet: false, type: 1 }\n",
    b"fn kind_of(d: Def) -> Int = d.type\n",
    b"fn circle(r: Float) -> Shape = Circle(r)\n",
    b"fn boxed(n: Int, s: String) -> Shape = Box(n, s)\n",
    b"fn dot(n: Int) -> Shape = Dot\n",
    b"fn nothing(n: Int) -> Option<String> = None\n",
    b"fn none_of(n: Int) -> Option<P> = None\n",
    b"fn held(h: Holder) -> Option<String> = h.maybe\n",
    b"fn keep(o: Option<String>) -> Option<String> = o\n",
    b"fn pass(r: Result<Int, Bad>) -> Result<Int, Bad> = r\n",
    b"fn wrapped<a>(x: a) -> { inner: a } = { inner: x }\n",
    b"fn least(n: Int) -> Ordering = Less\n",
    b"type In = { a: Int }\n",
    b"type Out = { i: In, b: Int }\n",
    b"type Coord = P\n",
    b"opaque type Money = | Money(Int)\n",
    b"opaque type Date = new { year: Int, month: Int }\n",
    b"fn outer(o: Out) -> Out = o\n",
    b"fn inner_a(o: Out) -> Int = o.i.a\n",
    b"fn deep_pick(c: Bool, d: Bool, p: P, q: P, r: P) -> P = if c { p } else { if d { q } else { r } }\n",
    b"fn reset(c: Bool, p: P) -> P = if c { p } else { { x: 0.0, y: 0.0 } }\n",
    b"fn opt_join(c: Bool, o: Option<String>) -> Option<String> = if c { None } else { o }\n",
    b"fn coord(c: Coord) -> Float = c.x\n",
    b"fn money(n: Int) -> Money = Money(n)\n",
    b"fn year_of(d: Date) -> Int = d.year\n",
    b"fn walk(n: Int, p: P) -> P = if n <= 0 { p } else { walk(n - 1, { ..p, x: p.x + 1.0 }) }\n",
    b"const fn origin() -> P = { x: 0.0, y: 0.0 }\n",
    b"fn seven() -> Int = 7\n",
    b"fn origin_x(n: Int) -> Float = origin().x\n",
  ])

/// Roots of `corpus` holding a construct of another family's, each with the family that declines it.
fn others_roots() -> List<{ name: Bytes, by: Family }> =
  [{ name: b"walk", by: Calling }, { name: b"origin_x", by: Calling }]

/// The roots of `corpus` this family lowers whole.
fn lowered_roots() -> List<Bytes> =
  [
    b"point",
    b"sum",
    b"moved",
    b"pick",
    b"mid",
    b"last",
    b"widened",
    b"segment",
    b"start",
    b"end_x",
    b"relabelled",
    b"wides",
    b"segments",
    b"relabelleds",
    b"pt",
    b"pt_x",
    b"pair",
    b"second",
    b"declare",
    b"kind_of",
    b"circle",
    b"boxed",
    b"dot",
    b"nothing",
    b"none_of",
    b"held",
    b"keep",
    b"pass",
    b"wrapped",
    b"least",
    b"outer",
    b"inner_a",
    b"deep_pick",
    b"reset",
    b"opt_join",
    b"coord",
    b"money",
    b"year_of",
    b"origin",
    b"seven",
  ]

fn program() -> Program / {abort.raise} =
  match program_of(corpus()) { Ok(p) -> p, Err(why) -> panic(String::of_bytes_lossy(why)) }

fn form_of(p: Program, name: Bytes) -> Fn / {abort.raise} =
  match formed(p, name) {
    Ok(f) -> f,
    Err(no) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", no.why]))),
  }

/// Every value bound in `b`, in order, through the blocks it holds.
fn lets(b: Block) -> List<{ var: Var, val: Val }> =
  b.fold([], |acc: List<{ var: Var, val: Val }>, i: Inst|
    match i {
      Let(l) -> acc.push({ var: l.var, val: l.val }),
      If(x) -> acc.concat(lets(x.then)).concat(lets(x.otherwise)),
      Case(c) ->
        c.arms.fold(
          acc,
          |a: List<{ var: Var, val: Val }>, arm: { when: Int, body: Block }|
            a.concat(lets(arm.body)),
        ).concat(
          lets(c.rest),
        ),
      Match(m) ->
        m.arms.fold(acc, |a: List<{ var: Var, val: Val }>, arm: Block| a.concat(lets(arm))).concat(
          lets(m.rest),
        ),
      _ -> acc,
    })

fn vals(f: Fn) -> List<Val> = lets(f.body).map(|l: { var: Var, val: Val }| l.val)

fn param(f: Fn, i: Int) -> Var / {abort.raise} = f.params.get(i)

fn floats(names: List<Bytes>) -> Rep = RFlat(names.map(|n: Bytes| { name: n, rep: RFloat }))

test "a record or a sum a type variable lays out is lowered as a placeholder its callers' layouts settle" {
  // `Sample<a>` and `Found<a>` lay `a` out, so each body needs the layout of its own `a`.
  let src = Bytes::concat_all([
    b"type Sample<a> = { value: Option<a>, record: List<Int>, discards: Int }\n",
    b"type Found<a> = { value: a, record: List<Int>, size: Int }\n",
    b"fn sample<a>(x: a, n: Int) -> Sample<a> = { value: Some(x), record: [n], discards: 0 }\n",
    b"fn direct<a>(x: a, n: Int) -> Found<a> = { let drew = sample(x, n); match drew.value { Some(v) -> { value: v, record: drew.record, size: n }, None -> { value: x, record: [], size: 0 } } }\n",
  ]);
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) ->
      assert_eq(
        [b"sample", b"direct"].map(|n: Bytes|
          match formed(p, n) {
            Ok(f) -> f.links.needs.contains({ var: 0, reads: Layout }),
            Err(_) -> false,
          }),
        [true, true],
      ),
  }
}

test "each leaf read out of a record held in place is read at its own type" {
  let src = Bytes::concat_all([
    b"type Inner = new { out: List<Int>, at: Int }\n",
    b"type Outer = new { inner: Inner, n: Int }\n",
    b"fn whole(o: Outer) -> Inner = o.inner\n",
    b"fn opened(o: Outer) -> Int = { let { inner: i, n } = o; i.at + n }\n",
  ]);
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) ->
      [b"whole", b"opened"].fold((), |_: Unit, n: Bytes|
        assert_eq(
          lets(form_of(p, n).body).filter(|l: { var: Var, val: Val }|
            l.var.ty == unknown_type()).map(|l: { var: Var, val: Val }| l.var.id),
          [],
        )),
  }
}

test "a case of a sum a type variable leaves open is gathered where every layout holds it inline, and boxed where one may not" {
  // `Many` has nine cases with arguments: at a pointer's type its pointer tags run out and its last
  // cases are boxed, so a case of it is made a box at the open type.
  let many = Bytes::concat_all([
    b"type Many<a> = | M1(a) | M2(a) | M3(a) | M4(a) | M5(a) | M6(a) | M7(a) | M8(a) | M9(a)\n",
    b"fn ninth<a>(x: a) -> Many<a> = M9(x)\n",
  ]);
  match program_of(
      Bytes::concat_all([
        b"fn none<a>(x: a) -> Option<a> = None\nfn some<a>(x: a) -> Option<a> = Some(x)\n",
        many,
      ]),
    ) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let none = form_of(p, b"none");
      assert_eq(vals(none), [Gathered({ parts: [AInt(0)] })]);
      assert_eq(lets(none.body).map(|l: { var: Var, val: Val }| l.var.rep), [RWord]);
      let some = form_of(p, b"some");
      assert_eq(vals(some), [Gathered({ parts: [AInt(1), AVar(param(some, 0))] })]);
      assert(vals(form_of(p, b"ninth")).any(|v: Val| match v { Make(_) -> true, _ -> false }), None)
    },
  }
}

test "a record literal is gathered in its type's order and held as its leaves" {
  let f = form_of(program(), b"point");
  let made = lets(f.body);
  assert_eq(made.map(|l: { var: Var, val: Val }| l.val), [
    Gathered({ parts: [AVar(param(f, 0)), AVar(param(f, 1))] }),
  ]);
  assert_eq(made.map(|l: { var: Var, val: Val }| l.var.rep), [floats([b"x", b"y"])]);
  assert_eq(f.conv.answer, floats([b"x", b"y"]))
}

test "a field of a record held as its leaves is the leaf it borrows" {
  let f = form_of(program(), b"sum");
  let p = param(f, 0);
  assert_eq(p.rep, floats([b"x", b"y"]));
  assert_eq(vals(f).filter(|v: Val| match v { Get(_) -> true, _ -> false }), [
    Get({ of: p, path: PLeaf(0) }),
    Get({ of: p, path: PLeaf(1) }),
  ])
}

test "a record wider than four words is held as its leaves, crossing a call by reference" {
  let f = form_of(program(), b"last");
  let w = param(f, 0);
  // Five words of fields: past `register_words`, the record crosses as the address of its words.
  assert_eq(passing(w.rep), ByReference);
  assert_eq(lets(f.body).map(|l: { var: Var, val: Val }| { rep: l.var.rep, val: l.val }), [
    { rep: RFloat, val: Get({ of: w, path: PLeaf(4) }) },
  ])
}

test "a record held in place is read as its leaves among its holder's, and through to a field" {
  let p = program();
  // `from` is the first two of `Seg`'s leaves, a record in place having no word of its own.
  let s = form_of(p, b"start");
  let read = lets(s.body);
  assert_eq(read.map(|l: { var: Var, val: Val }| l.val).take(2), [
    Get({ of: param(s, 0), path: PLeaf(0) }),
    Get({ of: param(s, 0), path: PLeaf(1) }),
  ]);
  assert_eq(read.map(|l: { var: Var, val: Val }| l.var.rep).drop(2), [floats([b"x", b"y"])]);
  // `to.x` is the fourth, and nothing is read but leaves.
  let e = form_of(p, b"end_x");
  assert(vals(e).contains(Get({ of: param(e, 0), path: PLeaf(3) })), None);
  assert_eq(
    vals(e).filter(|v: Val|
      match v { Get(g) -> match g.path { PLeaf(_) -> false, _ -> true }, _ -> false }),
    [],
  )
}

test "an update gathers what it keeps from its base and what it sets" {
  let f = form_of(program(), b"moved");
  let made = lets(f.body);
  match made.at(0) {
    Some(y) -> {
      assert_eq(y.val, Get({ of: param(f, 0), path: PLeaf(1) }));
      assert_eq(made.map(|l: { var: Var, val: Val }| l.val).drop(1), [
        Gathered({ parts: [AVar(param(f, 1)), AVar(y.var)] }),
      ])
    },
    None -> assert(false),
  }
}

/// The context a root of no parameters lowers under in a setting of nothing but its types.
fn bare_context() -> Context / {abort.raise} =
  context_of(
    {
      module: b"m",
      here: [],
      imports: [],
      ctors: no_ctors(),
      builtins: [],
      declared: Map::new(),
      effects: [],
      release: false,
    },
    {
      key: Named(b"m.f"),
      base: 0,
      params: [],
      types: [],
      answer_ty: unknown_type(),
      code: Err(b"lowered apart"),
      filed: Ok(no_filings()),
    },
    { node: NLit(LUnit), span: dummy_span() },
  )

test "an update reads its base's layout once, however wide the record" {
  let cx = bare_context();
  let named = |i: Int| b"f".concat(ascii_of_int(100000 + i));
  let moved = |n: Int| {
    let ty = TyRecord(range(0, n).map(|i: Int| { name: named(i), ty: int_type() }));
    let b = { id: 0, ty: ty, rep: held_as(cx.setting, ty) };
    updated(
      { ..cx, filed: { ..cx.filed, typed: Map::new().insert(1, filed_as(ty, [])) } },
      started([b]),
      AVar(b),
      range(1, n).map(named),
      [{ name: named(0), arg: AInt(1) }],
      { ..dummy_span(), site: 1 },
    )
  };
  // The field set is the constant itself; each other is read off its leaf, then all are gathered,
  // however wide the record.
  assert_eq(moved(3).st.insts.len(), 3);
  let wide = moved(6).st.insts;
  assert_eq(wide.len(), 6);
  assert_eq(
    match wide.at(5) {
      Some(Let(l)) -> match l.val { Gathered(_) -> true, _ -> false },
      _ -> false,
    },
    true,
  );
  paced(|n: Int| n * (ilog2(n) + 1), |n: Int| moved(n).st.insts.len())
}

test "a record wider than four words is held as its leaves, and an update gathers them with nothing made" {
  let f = form_of(program(), b"relabelled");
  let s = param(f, 0);
  // `Seg` is its points' leaves and its label: five words, crossing by reference.
  assert_eq(passing(s.rep), ByReference);
  assert_eq(vals(f).filter(|v: Val| match v { Make(_) -> true, Pack(_) -> true, _ -> false }), []);
  match vals(f).at(vals(f).len() - 1) { Some(Gathered(_)) -> (), other -> assert_eq(other, None) }
}

test "a join of records is a variable of their type held as its leaves, each arm setting it" {
  let f = form_of(program(), b"pick");
  match f.body.at(0) {
    Some(Decl(j)) -> {
      assert_eq(j.rep, floats([b"x", b"y"]));
      assert_eq(
        f.body.at(1),
        Some(
          If({
            cond: AVar(param(f, 0)),
            then: [Assign({ var: j, arg: AVar(param(f, 1)) })],
            otherwise: [Assign({ var: j, arg: AVar(param(f, 2)) })],
          }),
        ),
      )
    },
    other -> assert_eq(other, None),
  }
}

/// The variables `b` declares as joins, through the blocks it holds.
fn joins(b: Block) -> List<Var> =
  b.fold([], |acc: List<Var>, i: Inst|
    match i {
      Decl(v) -> acc.push(v),
      If(x) -> acc.concat(joins(x.then)).concat(joins(x.otherwise)),
      _ -> acc,
    })

test "a record joined however deep, from a parameter or a literal, and an Option joined with a word, hold as their type" {
  let p = program();
  // Nested joins of records each hold the record's leaves; no arm makes a record's word to join.
  let deep = form_of(p, b"deep_pick");
  assert_eq(joins(deep.body).map(|v: Var| v.rep), [floats([b"x", b"y"]), floats([b"x", b"y"])]);
  assert_eq(vals(deep).filter(|v: Val| match v { Pack(_) -> true, _ -> false }), []);
  // A literal arm is gathered into its leaves and set as they are.
  let reset = form_of(p, b"reset");
  assert_eq(joins(reset.body).map(|v: Var| v.rep), [floats([b"x", b"y"])]);
  assert_eq(vals(reset).map(|v: Val| match v { Gathered(_) -> true, _ -> false }), [true]);
  // `None` and an `Option` parameter join as the `Option`'s one word, no box made.
  let opt = form_of(p, b"opt_join");
  assert_eq(joins(opt.body).map(|v: Var| values_of(v.rep).len()), [1]);
  assert_eq(vals(opt).filter(|v: Val| match v { Pack(_) -> true, Make(_) -> true, _ -> false }), [])
}

test "a record holds an Option among its leaves as its words, and a record in place as its leaves" {
  let p = program();
  let held = form_of(p, b"held");
  assert_eq(
    lets(held.body).map(|l: { var: Var, val: Val }|
      { sum: match l.var.rep { RSum(_) -> true, _ -> false }, val: l.val }),
    [{ sum: true, val: Get({ of: param(held, 0), path: PLeaf(0) }) }],
  );
  // `Out` crosses as its own `b` and `In`'s leaf; `o.i.a` reads `In`'s leaf where it lies.
  let o = form_of(p, b"inner_a");
  match param(o, 0).rep {
    RFlat(ls) -> assert_eq(ls.map(|l: Leaf| l.name), [b"b", b"i.a"]),
    other -> assert_eq(other, RWord),
  };
  assert_eq(vals(o).filter(|v: Val| match v { Get(g) -> g.of == param(o, 0), _ -> false }), [
    Get({ of: param(o, 0), path: PLeaf(1) }),
  ])
}

test "a sum is gathered from its case's place and its arguments, nothing for a case of no words" {
  let p = program();
  let none = lets(form_of(p, b"nothing").body);
  assert_eq(none.map(|l: { var: Var, val: Val }| l.val), [Gathered({ parts: [AInt(0)] })]);
  assert_eq(
    none.map(|l: { var: Var, val: Val }| match l.var.rep { RSum(_) -> true, _ -> false }),
    [true],
  );
  // An `Option` of a record is gathered alike: `None` holds no leaves.
  assert_eq(lets(form_of(p, b"none_of").body).map(|l: { var: Var, val: Val }| l.val), [
    Gathered({ parts: [AInt(0)] }),
  ])
}

test "a sum whose constructors take nothing is held as its one word, gathered from its case's place" {
  let made = lets(form_of(program(), b"least").body);
  assert_eq(made.map(|l: { var: Var, val: Val }| values_of(l.var.rep).len()), [1]);
  assert_eq(made.map(|l: { var: Var, val: Val }| l.val).take(1), [Gathered({ parts: [AInt(0)] })])
}

test "a declared sum's constructor is gathered from its case's place and its arguments" {
  let p = program();
  let circle = form_of(p, b"circle");
  let boxed = form_of(p, b"boxed");
  assert_eq(vals(circle), [Gathered({ parts: [AInt(0), AVar(param(circle, 0))] })]);
  assert_eq(vals(boxed), [
    Gathered({ parts: [AInt(1), AVar(param(boxed, 0)), AVar(param(boxed, 1))] }),
  ]);
  assert_eq(vals(form_of(p, b"dot")), [Gathered({ parts: [AInt(2)] })])
}

/// Root `m.<name>`'s C as the form prints it, but for its entry, which boxes what it carries raw.
fn own_code(p: Program, name: Bytes) -> Bytes / {abort.raise} = {
  let t = spelled(printed_in(p, form_of(p, name)).pieces);
  let from = match t.index_of(b"ctx->fuel -= 1;\n") { Some(i) -> i, None -> 0 };
  let to = match t.index_of(b"_entry(PlyCtx *ctx, const Word *args) {") {
    Some(i) -> i,
    None -> t.len(),
  };
  t.slice(from, to)
}

test "a record made its word is a box of its words, its floats as their bits" {
  let p = program();
  // Each record is made its word for the list holding it.
  let has = |text: Bytes|
    [b"wides", b"segments", b"relabelleds"].map(|n: Bytes| own_code(p, n).index_of(text) != None);
  assert_eq(has(b"rt_box_float_p"), [false, false, false]);
  assert_eq(has(b" = ply_f64_bits("), [true, true, true]);
  assert_eq(has(b"rt_alloc_bytes_p(ctx, "), [true, true, true]);
  // `Wide`'s box holds its five words, and `Seg`'s its points' words in place: five words, no
  // header or bitmap of a point's.
  assert_eq(has(b"rt_alloc_bytes_p(ctx, INT64_C(56));"), [true, true, true]);
  assert_eq(has(b"rt_alloc_p("), [false, false, false]);
  assert_eq(has(b"ply_embed"), [false, false, false])
}

test "a record whose layout a type variable leaves open is made by value" {
  let f = form_of(program(), b"wrapped");
  assert_eq(vals(f), [
    Make({
      made: MRecord({ names: [b"inner"], width: 1 }),
      args: [AVar(param(f, 0))],
      reuse: None,
      kept: [],
    }),
  ])
}

test "a field a type variable lays out is read and updated by name, owning what it reads" {
  let src = Bytes::concat_all([
    b"fn inner_of<a>(r: { inner: a, n: Int }) -> a = r.inner\n",
    b"fn renamed<a>(r: { inner: a, n: Int }, m: Int) -> { inner: a, n: Int } = { ..r, n: m }\n",
  ]);
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let read = form_of(p, b"inner_of");
      assert_eq(vals(read), [Get({ of: param(read, 0), path: PNamed(b"inner") })]);
      // The record is laid out by value, its kept field read by name.
      let update = form_of(p, b"renamed");
      assert_eq(
        vals(update).filter(|v: Val| match v { Get(_) -> true, Make(_) -> true, _ -> false }).map(
          |v: Val|
            match v {
              Get(g) -> g.path == PNamed(b"inner"),
              Make(m) -> m.made == MRecord({ names: [b"inner", b"n"], width: 2 }),
              _ -> false,
            },
        ),
        [true, true],
      );
      // A specialisation would lay the record out where the runtime does here.
      assert_eq(read.links.needs.map(|n: Need| n.reads == Layout), [true]);
      assert_eq(
        [b"inner_of", b"renamed"].map(|n: Bytes|
          match checked(p, n) { Ok(_) -> true, Err(_) -> false }),
        [true, true],
      )
    },
  }
}

test "an Option's constructor applied is typed where it is written" {
  match program_of(b"fn some(s: String) -> Option<String> = Some(s)\n") {
    Err(why) -> assert_eq(why, b""),
    Ok(p) ->
      assert_eq(vals(form_of(p, b"some")), [
        Gathered({ parts: [AInt(1), AVar(param(form_of(p, b"some"), 0))] }),
      ]),
  }
}

test "every root of the corpus lowers, passes the check and prints, or is declined by another family" {
  let p = program();
  assert_eq(not_built(p, lowered_roots()), []);
  // The roots another family's construct stands in front of lower now that the family is merged,
  // or that family declines them.
  assert_eq(
    others_roots().map(|r: { name: Bytes, by: Family }|
      match formed(p, r.name) { Err(no) -> no.by == r.by, Ok(_) -> true }),
    others_roots().map(|_: { name: Bytes, by: Family }| true),
  )
}

// Records and sums whose constructs other families lower, as a build checks and prints them.

fn ported(src: Bytes) -> Program / {abort.raise} =
  match program_of(src) { Ok(p) -> p, Err(why) -> panic(String::of_bytes_lossy(why)) }

/// Root `m.<name>`'s C once its counts are placed and checked, its closures' bodies with it, but for
/// its entry, which boxes what it carries raw.
fn built(p: Program, name: Bytes) -> Bytes / {abort.raise} =
  match checked(p, name) {
    Ok(f) -> {
      let t = printed_text(p, f);
      let from = match t.index_of(b"ctx->fuel -= 1;\n") { Some(i) -> i, None -> 0 };
      let entry = Bytes::concat_all([
        symbol_of(qualify(b"m", name)),
        b"_entry(PlyCtx *ctx, const Word *args) {",
      ]);
      match t.index_of(entry) {
        Some(to) ->
          t.slice(from, to).concat(match t.slice(to, t.len()).index_of(b"\n}\n") {
            Some(e) -> t.slice(to + e + 3, t.len()),
            None -> b"",
          }),
        None -> t.slice(from, t.len()),
      }
    },
    Err(why) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", why]))),
  }

fn holds(p: Program, names: List<Bytes>, text: Bytes) -> List<Bool> / {abort.raise} =
  names.map(|n: Bytes| built(p, n).index_of(text) != None)

/// `holds` where each of `names` lowers; a root another family declines (its construct not yet
/// covered) is read as `expected` says, and one this family declines fails the test.
fn where_lowered(
  p: Program,
  names: List<Bytes>,
  text: Bytes,
  expected: List<Bool>,
) -> List<Bool> / {abort.raise} =
  range(0, names.len()).map(|i: Int| {
    let n = names.get(i);
    match formed(p, n) {
      Ok(_) -> built(p, n).index_of(text) != None,
      Err(no) -> if no.by == Data {
        panic(String::of_bytes_lossy(Bytes::concat_all([n, b": ", no.why])))
      } else { expected.get(i) },
    }
  })

fn nested() -> Program / {abort.raise} =
  ported(
    Bytes::concat_all([
      b"type P = { x: Float, y: Float }\n",
      b"type Seg = { from: P, label: String, to: P }\n",
      b"type Holder = { s: Seg, n: Int }\n",
      b"type Shape = | Dot(P) | Line(Seg) | Empty\n",
      b"fn dx(s: Shape) -> Float = match s { Dot(p) -> p.x, _ -> 0.0 }\n",
      b"fn line(s: Seg) -> Shape = Line(s)\n",
      b"fn line_of(a: P, b: P, l: String) -> Shape = Line({ from: a, label: l, to: b })\n",
      b"fn first_x(h: Holder) -> Float = h.s.from.x\n",
    ]),
  )

test "a case's record argument is read out of the sum's words where its case lays it" {
  let dx = built(nested(), b"dx");
  assert_eq([dx.index_of(b"(ply_words("), dx.index_of(b"rt_field_p")], [None, None])
}

test "a case holding a wide record holds its words inline, with nothing made" {
  let p = nested();
  let made = [b"line", b"line_of"].map(|n: Bytes| built(p, n));
  assert_eq(made.map(|t: Bytes| [t.index_of(b"rt_alloc_bytes_p"), t.index_of(b"rt_alloc_p(")]), [
    [None, None],
    [None, None],
  ])
}

test "records held in place at any depth are read as their holder's leaves" {
  let p = nested();
  // `Holder`'s leaves: `n`, then `s`'s, `from`'s first among them.
  let f = form_of(p, b"first_x");
  assert(vals(f).contains(Get({ of: param(f, 0), path: PLeaf(1) })), None);
  assert_eq(built(p, b"first_x").index_of(b"(ply_words(p0) + "), None)
}

test "a value's layout is read off its node's type where the value carries none" {
  let p = ported(
    Bytes::concat_all([
      b"type P = { x: Int, y: Int }\n",
      b"fn larger(p: P, q: P) -> Int = max(p, q).x\n",
      b"fn kept(p: P, q: P) -> Int = { let m = max(p, q); m.x + m.y }\n",
      b"fn opened(p: P, q: P) -> Int = { let { x, y } = max(p, q); x + y }\n",
      b"fn chosen(p: P, q: P) -> Int = match max(p, q) { { x, y } -> x + y }\n",
    ]),
  );
  let roots = [b"larger", b"kept", b"opened", b"chosen"];
  let none = [false, false, false, false];
  // What a generic builtin answers is read at its fields' offsets: nothing asks the runtime for a
  // field by name or whether the record holds one.
  assert_eq(where_lowered(p, roots, b"rt_field_p", none), none);
  assert_eq(where_lowered(p, roots, b"rt_record_has_p", none), none)
}

test "a record rebuilt from a captured record's fields reads them where they lie" {
  let p = ported(
    Bytes::concat_all([
      b"type Sp = { start: Int, end: Int, gen: Int }\n",
      b"type C = { own: Int, node: Int, span: Sp }\n",
      b"fn rebuilt(c: C, n: Int) -> C = { let at = |k: Int| { own: 0, node: k, span: c.span }; at(n) }\n",
    ]),
  );
  assert_eq(holds(p, [b"rebuilt"], b"rt_field_p"), [false])
}

test "an Option is the words its payload lays out, crossing a call and stored with no object made" {
  let p = ported(
    Bytes::concat_all([
      b"fn picked(c: Bool, s: String) -> Int = match if c { Some(s) } else { None } { Some(_) -> 1, None -> 0 }\n",
      b"fn found(xs: List<String>, i: Int) -> String = match xs.at(i) { Some(s) -> s, None -> \"\" }\n",
      b"fn nested(s: String) -> Int = match Some(Some(s)) { Some(Some(_)) -> 2, Some(None) -> 1, None -> 0 }\n",
      b"fn kept(s: String) -> Option<String> = Some(s)\n",
      b"fn held(s: String) -> List<Option<String>> = [Some(s), None]\n",
      b"fn same(a: String, b: String) -> Bool = Some(a) == Some(b)\n",
      b"fn either(c: Bool, s: String, o: Option<String>) -> Option<String> = if c { Some(s) } else { o }\n",
      b"fn guarded(xs: List<Int>) -> Int = match xs.at(0) { Some(n) if n > 1 -> n, Some(1) -> 10, _ -> 0 }\n",
      b"fn asked(o: Option<String>) -> Int = match kept(\"k\") { Some(_) -> 1, None -> 0 }\n",
    ]),
  );
  let roots = [
    b"picked",
    b"found",
    b"nested",
    b"kept",
    b"held",
    b"same",
    b"either",
    b"guarded",
    b"asked",
  ];
  let none = roots.map(|_: Bytes| false);
  // Built, matched, handed across a call, answered, stored or compared, no object is made: an
  // `Option` of a pointer, nested or not, is one word.
  [b"rt_ctor_p", b"rt_maybe_", b"rt_equal_p", b"rt_alloc_bytes_p"].fold((), |_: Unit, t: Bytes|
    assert_eq(holds(p, roots, t), none));
  let head = |n: Bytes| {
    let f = form_of(p, n);
    head_types(f.conv)
  };
  assert_eq(head(b"kept"), { answer: b"Word", params: [b"Word"] });
  assert_eq(head(b"either"), { answer: b"Word", params: [b"int64_t", b"Word", b"Word"] })
}

test "a Result is its case's words, its error's record laid inline" {
  let p = ported(
    Bytes::concat_all([
      b"type Bad = { why: Bytes, a: Int, b: Int, c: Int, d: Int }\n",
      b"fn half(n: Int) -> Result<Int, Bad> = if n % 2 == 0 { Ok(n / 2) } else { Err({ why: b\"odd\", a: 0, b: 0, c: 0, d: 0 }) }\n",
      b"fn quarter(n: Int) -> Result<Int, Bad> = { let h = half(n)?; half(h) }\n",
      b"fn told(n: Int) -> Bytes = match quarter(n) { Ok(_) -> b\"\", Err(b) -> b.why }\n",
      b"fn plain(n: Int) -> Result<Int, Int> = if n > 0 { Ok(n) } else { Err(n) }\n",
    ]),
  );
  let roots = [b"half", b"quarter", b"told", b"plain"];
  // Built, answered, handed on by `?` and matched, no object is made.
  let none = [false, false, false, false];
  [b"rt_ctor_p", b"rt_tagged_", b"rt_alloc_bytes_p"].fold((), |_: Unit, t: Bytes|
    assert_eq(holds(p, roots, t), none))
}

test "a Result whose error is a small record crosses a call as its constructor and the record's fields" {
  let p = ported(
    Bytes::concat_all([
      b"type Bad = { why: Bytes }\n",
      b"fn half(n: Int) -> Result<Int, Bad> = if n % 2 == 0 { Ok(n / 2) } else { Err({ why: b\"odd\" }) }\n",
      b"fn quarter(n: Int) -> Result<Int, Bad> = { let h = half(n)?; half(h) }\n",
      b"fn told(n: Int) -> Bytes = match quarter(n) { Ok(_) -> b\"\", Err(b) -> b.why }\n",
    ]),
  );
  let roots = [b"half", b"quarter", b"told"];
  let none = [false, false, false];
  // Built, answered, handed on by `?` and matched as its constructor and the record's fields: no
  // record or `Result` is made, and the error's field is read where it came back. A call crossing a
  // sum as its cases is the calling family's to lower.
  assert_eq(where_lowered(p, roots, b"rt_alloc_p", none), none);
  assert_eq(where_lowered(p, roots, b"rt_ctor_p", none), none);
  assert_eq(where_lowered(p, roots, b"rt_tagged_", none), none);
  assert_eq(where_lowered(p, roots, b"rt_field_p", none), none);
  assert_eq(where_lowered(p, roots, b"o[0] = ", [true, true, false]), [true, true, false])
}

test "a sum's constructors hold their arguments at the sum's arguments, as their types lay them" {
  let p = ported(
    Bytes::concat_all([
      b"type Q<a, b> = | L(a) | R(b, a) | N\n",
      b"fn r(s: String, n: Int) -> Q<Int, String> = R(s, n)\n",
      b"fn l(n: Int) -> Q<Int, String> = L(n)\n",
    ]),
  );
  let gathered = |n: Bytes|
    vals(form_of(p, n)).filter(|v: Val| match v { Gathered(_) -> true, _ -> false });
  // `R` at `Q<Int, String>` holds its `b` a string's word and its `a` an `Int`'s bits.
  assert_eq(
    gathered(b"r").map(|v: Val| match v { Gathered(g) -> g.parts.map(rep_of_arg), _ -> [] }),
    [[RInt, RWord, RInt]],
  );
  assert_eq(holds(p, [b"l"], b"rt_box_int_p"), [false])
}

test "a field of a Columns' record is loaded from its column, with no record made" {
  let p = ported(
    Bytes::concat_all([
      b"type P = { label: String, x: Float }\n",
      b"fn x_at(ps: Columns<P>, i: Int) -> Float / {abort.raise} = ps.get(i).x\n",
      b"fn label_at(ps: Columns<P>, i: Int) -> String / {abort.raise} = ps.get(i).label\n",
      b"fn whole(ps: Columns<P>, i: Int) -> List<P> / {abort.raise} = [ps.get(i)]\n",
    ]),
  );
  let roots = [b"x_at", b"label_at", b"whole"];
  // A field's column is its place among the record's fields: `label` the first, `x` the second;
  // a whole record's index is tested against the first.
  assert_eq(where_lowered(p, roots, b")[1])) {", [true, false, false]), [true, false, false]);
  assert_eq(where_lowered(p, roots, b")[0])) {", [false, true, true]), [false, true, true]);
  let none = [false, false, false];
  assert_eq(where_lowered(p, roots, b"rt_columns_field_p(ctx, ", none), none)
}

test "a sum a generic root answers at a type its call carries raw crosses as its words, the record's among them" {
  let p = ported(
    Bytes::concat_all([
      b"type Replay = { lines: List<String>, errs: List<String>, code: Int, json: String }\n",
      b"type Bad = { at: Int, message: String }\n",
      b"fn decoded<a>(x: a, n: Int) -> Result<a, Bad> = if n > 0 { Ok(x) } else { Err({ at: n, message: \"short\" }) }\n",
      b"fn replayed(r: Replay, n: Int) -> Option<Int> = match decoded(r, n) { Err(_) -> None, Ok(x) -> Some(x.code) }\n",
    ]),
  );
  // `decoded` at `Replay` answers its words past the first through the caller's buffer; nothing is
  // loaded out of a box.
  let text = built(p, b"replayed");
  assert_eq([text.index_of(b"(ply_words("), text.index_of(b"rt_alloc_bytes_p")], [None, None])
}

test "a record held in place that holds a count, read through a borrow, passes the check" {
  let p = ported(
    Bytes::concat_all([
      b"type S = { start: Int, end: Int }\n",
      b"type T = | TFn({ span: S, params: List<Int>, ret: Int }) | TNone\n",
      b"type In = { xs: List<Int>, at: S }\n",
      b"type R = { s: In, n: Int, m: Int, k: Int }\n",
      b"fn arg_len(t: T) -> Int = match t { TFn(f) -> f.params.len(), TNone -> 0 }\n",
      b"fn field_len(r: R) -> Int = r.s.xs.len()\n",
      b"fn field_at(r: R) -> Int = r.s.at.end\n",
      b"fn kept(r: R) -> In = r.s\n",
    ]),
  );
  let roots = [b"arg_len", b"field_len", b"field_at", b"kept"];
  let faults = roots.fold([], |acc: List<Bytes>, n: Bytes|
    match formed(p, n) {
      Err(no) -> acc.push(Bytes::concat_all([n, b" declined: ", no.why])),
      Ok(f) -> match checked(p, n) {
        Ok(_) -> acc,
        Err(why) ->
          acc.push(Bytes::concat_all([b"== ", n, b": ", why, b"\n", printed_text(p, owned(f))])),
      },
    });
  assert(faults == [], Some(String::of_bytes_lossy(Bytes::join(faults, b"\n"))))
}

test "a record or a sum of scalars holds no count: nothing lets go of it or of what is read out of it" {
  let src = Bytes::concat_all([
    b"type P = { x: Int, y: Int }\n",
    b"effect store { write keep(p: P) -> Unit }\n",
    b"fn summed(p: P) -> Int = p.x + p.y\n",
    b"fn inner(o: Option<P>) -> Int = match o { Some({ x, y }) -> x + y, None -> 0 }\n",
    b"fn kept(start: P) -> Int = handle { store.keep(start) } with { var seen = 0, store.keep(p) -> { seen = p.x + p.y; }, return u -> seen }\n",
  ]);
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      assert_eq(not_built(p, [b"summed", b"inner", b"kept"]), []);
      let lets_go = |n: Bytes| {
        let t = printed_text(p, owned(form_of(p, n)));
        t.index_of(b"ply_rel(") != None || t.index_of(b"ply_dec(") != None
      };
      assert_eq([b"summed", b"inner"].map(lets_go), [false, false])
    },
  }
}
