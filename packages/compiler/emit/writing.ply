import compiler.syntax.parsing (Span, dummy_span)
import compiler.emit.code (Code, Node, CodeLiteral, CodeVar, NDefinition, NConstructor, NBuiltin,
                           CodeBinary, CodeIf, CodeBlock, CodeFieldRead, CodeApply, CodeMatch,
                           CodePattern, CodeBindingPattern, CodeConstructorPattern, CodeDo,
                           CodeStatement, CodeArm)
import compiler.syntax.patterns (LiteralInt, LiteralBool, LiteralString, LiteralBytes, LiteralUnit)
import compiler.check.types (Type, NamedType, int_type, bytes_type, bool_type, unit_type,
                             string_type, named_type, fn_type, row_empty)
import compiler.check.known (builtin_constructor_at, ordering_type)
import compiler.check.resolve.tables (qualify)
import compiler.syntax.expressions (prelude_module)
import compiler.emit.representations (Constructors, SumConstructor)
import std.list
import std.bytes (ascii_of_int)

pub fn value_type() -> Type = named_type(b"std.value.Value")

pub fn bare(n: Node, ty: Type) -> Code = { node: n, span: dummy_span(), ty: ty }

pub fn placed(k: Int) -> Span = { start: 0, end: k, site: k + 1 }

pub fn int_code(n: Int) -> Code = bare(CodeLiteral(LiteralInt(n)), int_type())

pub fn bool_code(b: Bool) -> Code = bare(CodeLiteral(LiteralBool(b)), bool_type())

pub fn bytes_code(b: Bytes) -> Code = bare(CodeLiteral(LiteralBytes(b)), bytes_type())

pub fn string_code(s: Bytes) -> Code = bare(CodeLiteral(LiteralString(s)), string_type())

pub fn unit_code() -> Code = bare(CodeLiteral(LiteralUnit), unit_type())

pub fn slot_code(name: Bytes, slot: Int, ty: Type) -> Code =
  bare(CodeVar({ name: name, slot: slot }), ty)

pub fn binder(name: Bytes, slot: Int, ty: Type) -> CodePattern =
  CodeBindingPattern({ name: name, slot: slot, span: dummy_span(), ty: ty })

pub type Bound = { name: Bytes, slot: Int, ty: Type }

pub fn bound_from(first: Int, prefix: Bytes, types: List<Type>) -> List<Bound> =
  types.fold([], |bound: List<Bound>, t: Type|
    bound.push({
      name: prefix.concat(ascii_of_int(bound.len())),
      slot: first + bound.len(),
      ty: t,
    }))

pub fn bound_pattern(b: Bound) -> CodePattern = binder(b.name, b.slot, b.ty)

pub fn bound_read(b: Bound) -> Code = slot_code(b.name, b.slot, b.ty)

pub fn field_code(base: Code, name: Bytes, ty: Type) -> Code =
  bare(CodeFieldRead({ base: base, field: name }), ty)

pub fn binary_of(op: Bytes, l: Code, r: Code) -> Code =
  bare(
    CodeBinary({ op: op, lhs: l, rhs: r }),
    if [b"eq", b"ne", b"lt", b"le", b"gt", b"ge", b"and", b"or"].contains(op) { bool_type() }
    else { l.ty },
  )

pub fn applied(function: Code, args: List<Code>, ret: Type) -> Code =
  bare(CodeApply({ function: function, args: args, row: row_empty() }), ret)

pub fn builtin_call(name: Bytes, at: List<Type>, args: List<Code>, ret: Type) -> Code =
  applied(
    bare(
      NBuiltin({ name: name, args: at, rows: [] }),
      fn_type(args.map(|a: Code| a.ty), ret, row_empty()),
    ),
    args,
    ret,
  )

pub fn prelude_call(name: Bytes, at: List<Type>, args: List<Code>, ret: Type) -> Code =
  applied(
    bare(
      NDefinition({ full: qualify(prelude_module(), name), args: at, rows: [], labels: [] }),
      fn_type(args.map(|a: Code| a.ty), ret, row_empty()),
    ),
    args,
    ret,
  )

pub fn native_call(name: Bytes, args: List<Code>, ret: Type) -> Code =
  builtin_call(name, [], args, ret)

pub fn compare_call(x: Code, y: Code) -> Code =
  builtin_call(b"?compare", [x.ty], [x, y], ordering_type())

pub fn constructor_made(sum: Bytes, name: Bytes, case: Int, args: List<Code>, ty: Type) -> Code = {
  let read = |t: Type|
    bare(
      NConstructor({
        sum: sum,
        name: name,
        case: case,
        args: match ty { NamedType(c) -> c.args, _ -> [] },
      }),
      t,
    );
  if args.len() == 0 { read(ty) }
  else { applied(read(fn_type(args.map(|a: Code| a.ty), ty, row_empty())), args, ty) }
}

pub fn prelude_made(name: Bytes, args: List<Code>, ty: Type) -> Code = {
  let at = prelude_place(name);
  constructor_made(at.sum, name, at.case, args, ty)
}

pub fn prelude_pattern(name: Bytes, args: List<CodePattern>) -> CodePattern = {
  let at = prelude_place(name);
  CodeConstructorPattern({ sum: at.sum, name: name, case: at.case, args: args })
}

pub fn prelude_place(name: Bytes) -> { sum: Bytes, case: Int } =
  match builtin_constructor_at(name) { Some(p) -> p, None -> { sum: b"", case: 0 - 1 } }

pub fn value_made(constructors: Constructors, name: Bytes, args: List<Code>) -> Code = {
  let sum = b"std.value.Value";
  let case = match constructors.sums.get(sum) {
    Some(cs) -> match cs.find(|c: SumConstructor| c.name == name) {
      Some(c) -> c.index,
      None -> 0 - 1,
    },
    None -> 0 - 1,
  };
  constructor_made(sum, name, case, args, value_type())
}

pub fn if_code(cond: Code, then: Code, otherwise: Code) -> Code =
  bare(CodeIf({ cond: cond, then_branch: then, else_branch: otherwise }), then.ty)

pub fn match_code(scrutinee: Code, arms: List<CodeArm>, ty: Type) -> Code =
  bare(CodeMatch({ scrutinee: scrutinee, arms: arms }), ty)

pub fn block_code(statements: List<CodeStatement>, tail: Code) -> Code =
  bare(CodeBlock({ statements: statements, tail: Some(tail) }), tail.ty)

pub fn some_or(
  scrutinee: Code,
  name: Bytes,
  slot: Int,
  held: Type,
  some: Code,
  none: Code,
) -> Code =
  match_code(
    scrutinee,
    [
      { pattern: prelude_pattern(b"Some", [binder(name, slot, held)]), guard: None, body: some },
      { pattern: prelude_pattern(b"None", []), guard: None, body: none },
    ],
    some.ty,
  )

pub fn sequence(codes: List<Code>) -> Code =
  match codes.at(codes.len() - 1) {
    None -> unit_code(),
    Some(last) -> if codes.len() == 1 { last }
    else { block_code(codes.take(codes.len() - 1).map(|c: Code| CodeDo({ code: c })), last) },
  }
