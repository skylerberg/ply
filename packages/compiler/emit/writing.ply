//! Typed `Code` the emitter writes itself, for the roots it writes for a type: each node with its
//! type, and each read of a definition, a constructor or a builtin with what it reads, as the check
//! settles the code it lowers.

import compiler.syntax.parsing (Span, dummy_span)
import compiler.emit.code (Code, Node, CodeLiteral, CodeVar, NDef, NCtor, NBuiltin, CodeBinary,
                           CodeIf, CodeBlock, CodeFieldRead, CodeApply, CodeMatch, CodePattern,
                           CodeBindingPattern, CodeConstructorPattern, CodeDo, CodeStmt, CodeArm)
import compiler.syntax.patterns (LiteralInt, LiteralBool, LiteralString, LiteralBytes, LiteralUnit)
import compiler.check.types (Type, NamedType, int_type, bytes_type, bool_type, unit_type,
                             string_type, named_type, fn_type, row_empty)
import compiler.check.known (builtin_ctor_at, ordering_type)
import compiler.check.resolve.tables (qualify)
import compiler.syntax.exprs (prelude_module)
import compiler.emit.representations (Ctors, SumCtor)
import std.list
import std.bytes (ascii_of_int)

pub fn value_type() -> Type = named_type(b"std.value.Value")

/// A node at no place, of type `ty`.
pub fn bare(n: Node, ty: Type) -> Code = { node: n, span: dummy_span(), ty: ty }

/// A place apart for the `k`th lambda a root writes, which its closure is known by.
pub fn placed(k: Int) -> Span = { start: 0, end: k, site: k + 1 }

pub fn int_code(n: Int) -> Code = bare(CodeLiteral(LiteralInt(n)), int_type())

pub fn bool_code(b: Bool) -> Code = bare(CodeLiteral(LiteralBool(b)), bool_type())

pub fn bytes_code(b: Bytes) -> Code = bare(CodeLiteral(LiteralBytes(b)), bytes_type())

pub fn string_code(s: Bytes) -> Code = bare(CodeLiteral(LiteralString(s)), string_type())

pub fn unit_code() -> Code = bare(CodeLiteral(LiteralUnit), unit_type())

/// A read of slot `slot`, bound as `name`, holding a value of type `ty`.
pub fn slot_code(name: Bytes, slot: Int, ty: Type) -> Code =
  bare(CodeVar({ name: name, slot: slot }), ty)

/// The binder of slot `slot`, `name`, of a value of type `ty`.
pub fn binder(name: Bytes, slot: Int, ty: Type) -> CodePattern =
  CodeBindingPattern({ name: name, slot: slot, span: dummy_span(), ty: ty })

/// A value written code binds: its name, the slot holding it, and its type.
pub type Bound = { name: Bytes, slot: Int, ty: Type }

/// A value of each of `types` in turn, bound from slot `first` on and named `prefix` and its place.
pub fn bound_from(first: Int, prefix: Bytes, types: List<Type>) -> List<Bound> =
  types.fold([], |bound: List<Bound>, t: Type|
    bound.push({
      name: prefix.concat(ascii_of_int(bound.len())),
      slot: first + bound.len(),
      ty: t,
    }))

pub fn bound_pattern(b: Bound) -> CodePattern = binder(b.name, b.slot, b.ty)

pub fn bound_read(b: Bound) -> Code = slot_code(b.name, b.slot, b.ty)

/// Field `name`, of type `ty`, of `base`.
pub fn field_code(base: Code, name: Bytes, ty: Type) -> Code =
  bare(CodeFieldRead({ base: base, field: name }), ty)

/// `l op r`: a comparison's or a logical operator's `Bool`, any other operator's value of the
/// operands' type.
pub fn binary_of(op: Bytes, l: Code, r: Code) -> Code =
  bare(
    CodeBinary({ op: op, lhs: l, rhs: r }),
    if [b"eq", b"ne", b"lt", b"le", b"gt", b"ge", b"and", b"or"].contains(op) { bool_type() }
    else { l.ty },
  )

/// `func` called on `args`, answering `ret`.
pub fn applied(func: Code, args: List<Code>, ret: Type) -> Code =
  bare(CodeApply({ func: func, args: args, row: row_empty() }), ret)

/// A call of builtin `name` at the type arguments `at` on `args`, answering `ret`.
pub fn builtin_call(name: Bytes, at: List<Type>, args: List<Code>, ret: Type) -> Code =
  applied(
    bare(
      NBuiltin({ name: name, args: at, rows: [] }),
      fn_type(args.map(|a: Code| a.ty), ret, row_empty()),
    ),
    args,
    ret,
  )

/// A call of the prelude's function `name`, which it writes in Ply, at the type arguments `at` on
/// `args`, answering `ret`: a definition of the prelude's module, as the check reads one.
pub fn prelude_call(name: Bytes, at: List<Type>, args: List<Code>, ret: Type) -> Code =
  applied(
    bare(
      NDef({ full: qualify(prelude_module(), name), args: at, rows: [], labels: [] }),
      fn_type(args.map(|a: Code| a.ty), ret, row_empty()),
    ),
    args,
    ret,
  )

/// A call of the native `name` crossing code writes, on `args`, answering `ret`.
pub fn native_call(name: Bytes, args: List<Code>, ret: Type) -> Code =
  builtin_call(name, [], args, ret)

/// `?compare` of `x` and `y`, ordering them as their type orders.
pub fn compare_call(x: Code, y: Code) -> Code =
  builtin_call(b"?compare", [x.ty], [x, y], ordering_type())

/// Constructor `name` of the sum `sum`, at place `case`, applied to `args`, making a value of `ty`.
pub fn ctor_made(sum: Bytes, name: Bytes, case: Int, args: List<Code>, ty: Type) -> Code = {
  let read = |t: Type|
    bare(
      NCtor({
        sum: sum,
        name: name,
        case: case,
        args: match ty { NamedType(c) -> c.args, _ -> [] },
      }),
      t,
    );
  if args.len() == 0 { read(ty) }
  else { applied(read(fn_type(args.map(|a: Code| a.ty), ty, row_empty())), args, ty) }
}

/// The prelude's constructor `name` applied to `args`, making a value of `ty`.
pub fn prelude_made(name: Bytes, args: List<Code>, ty: Type) -> Code = {
  let at = prelude_place(name);
  ctor_made(at.sum, name, at.case, args, ty)
}

/// The prelude's constructor `name` as a pattern over `args`.
pub fn prelude_pattern(name: Bytes, args: List<CodePattern>) -> CodePattern = {
  let at = prelude_place(name);
  CodeConstructorPattern({ sum: at.sum, name: name, case: at.case, args: args })
}

/// Where the prelude's constructor `name` stands; a place no sum holds for a name none does, which
/// the lowering refuses.
pub fn prelude_place(name: Bytes) -> { sum: Bytes, case: Int } =
  match builtin_ctor_at(name) { Some(p) -> p, None -> { sum: b"", case: 0 - 1 } }

/// Constructor `name` of `std.value.Value` applied to `args`, as the program's table holds it.
pub fn value_made(ctors: Ctors, name: Bytes, args: List<Code>) -> Code = {
  let sum = b"std.value.Value";
  let case = match ctors.sums.get(sum) {
    Some(cs) -> match cs.find(|c: SumCtor| c.name == name) { Some(c) -> c.index, None -> 0 - 1 },
    None -> 0 - 1,
  };
  ctor_made(sum, name, case, args, value_type())
}

pub fn if_code(cond: Code, then: Code, otherwise: Code) -> Code =
  bare(CodeIf({ cond: cond, then_branch: then, else_branch: otherwise }), then.ty)

pub fn match_code(scrutinee: Code, arms: List<CodeArm>, ty: Type) -> Code =
  bare(CodeMatch({ scrutinee: scrutinee, arms: arms }), ty)

/// `stmts`, then `tail`, the block's value.
pub fn block_code(stmts: List<CodeStmt>, tail: Code) -> Code =
  bare(CodeBlock({ stmts: stmts, tail: Some(tail) }), tail.ty)

/// `scrutinee`, an `Option` of `held`, as `some` with its payload bound as `name` in slot `slot`, or
/// `none`.
pub fn some_or(
  scrutinee: Code,
  name: Bytes,
  slot: Int,
  held: Type,
  some: Code,
  none: Code,
) -> Code =
  match_code(
    scrutinee,
    [
      { pat: prelude_pattern(b"Some", [binder(name, slot, held)]), guard: None, body: some },
      { pat: prelude_pattern(b"None", []), guard: None, body: none },
    ],
    some.ty,
  )

/// `codes` run in order, the last one's value the block's.
pub fn sequence(codes: List<Code>) -> Code =
  match codes.at(codes.len() - 1) {
    None -> unit_code(),
    Some(last) -> if codes.len() == 1 { last }
    else { block_code(codes.take(codes.len() - 1).map(|c: Code| CodeDo({ code: c })), last) },
  }
