import compiler.emit.print.probe (probed_fn)
import compiler.front.diagnostics (parse_all)
import compiler.front.emitter_input (Analysed, Rejected)
import compiler.front.facts (Analysis)
import compiler.front.published (analyse, dump_of, no_rows, facts_read, rows_of, inferred_facts)
import compiler.check.infer (facts_by_owner)
import compiler.emit.typing (SiteAnnotations, annotations_of, no_annotations)
import compiler.front (analyse_pulling_std_with)
import compiler.front.rows (ModuleRow)
import compiler.syntax.expressions (prelude_module, scheduler_module)
import compiler.prelude_source
import compiler.check.resolve.tables (Diagnostic, qualify)
import compiler.check.types (encode_type)
import std.bytes (ascii_of_int, hex_digit)
import compiler.emit (emit_root_results)
import compiler.check.infer.definitions (Extern, program_natives)
import compiler.emit.output
import compiler.emit.output (RootOutput, GenericCall, SharedFunction, needs_specialisation)
import compiler.emit.root_emission (built_form)
import compiler.emit.keys (RootKey, InlinedLambda, Named, root_name, root_text)
import compiler.emit.pieces (Piece, pieces_text, body_text)
import compiler.emit.roots (symbol_of)
import compiler.emit.typed_ir (Variable, Arg, VariableOperand, BoolOperand, AsInt, AsBool,
                               Instruction, Declaration, Assign, If, Return, Restart, Function,
                               Member)
import compiler.emit.lower (root_lowered)
import compiler.emit.lower.module_context (ModuleContext, Root, module_context_in)
import compiler.emit.print (printed_function)
import compiler.emit.print.text (PrintOutput)
import compiler.emit.own (insert_reference_counts)
import compiler.emit.verify (ownership_fault)

pub type Program = { source: Bytes, analysis: Analysis, setting: ModuleContext, roots: List<Root> }

pub fn program_of(source: Bytes) -> Result<Program, Bytes> / {abort.raise} =
  match analyse(parse_all([{ name: b"m", source_text: source }])) {
    Rejected(diagnostics) -> Err(Bytes::join(diagnostics.map(|d: Diagnostic| d.message), b"\n")),
    Analysed(a) -> match module_context_in(a, b"m") {
      Err(reason) -> Err(reason),
      Ok(s) ->
        Ok({
          source: source,
          analysis: a,
          setting: { ..s.setting, builtins: program_natives([]).map(|e: Extern| e.name) },
          roots: s.roots,
        }),
    },
  }

pub fn recorded_in(a: Analysis, owner: Bytes) -> SiteAnnotations / {abort.raise} =
  match facts_read(rows_of(a), inferred_facts(a), None, a.modules) {
    Err(reason) -> panic(String::of_bytes_lossy(reason)),
    Ok(facts) -> match facts_by_owner(facts).get(owner) {
      Some(f) -> annotations_of(f),
      None -> no_annotations,
    },
  }

const scheduler_stub: Bytes =
  Bytes::concat_all([
    b"import std.internal.native (native)\n",
    b"pub fn simulated<a | e>(root: Int, start: Int, end: Int, body: keep () -> a / {task.write, clock.read, clock.write, random.write, sim.read | e}) -> a / {abort.raise, native.read, native.write | e} = abort.raise(\"none\")\n",
    b"pub fn crossing_spawn<a | e>(body: keep () -> a / e) -> Task<a> / {task.spawn | e} = task.spawn(body)\n",
    b"pub fn crossing_join<a>(t: Task<a>) -> a / {task.join, abort.raise} = abort.raise(\"none\")\n",
    b"pub fn crossing_cancel<a>(t: Task<a>) -> Bool / {task.cancel} = false\n",
    b"pub fn crossing_await<a>(t: Task<a>) -> Option<a> / {task.await} = None\n",
    b"pub fn crossing_channel<a>(capacity: Int) -> Chan<a> / {task.channel, abort.raise} = abort.raise(\"none\")\n",
    b"pub fn crossing_send<a>(c: Chan<a>, x: a) -> Bool / {task.send} = false\n",
    b"pub fn crossing_recv<a>(c: Chan<a>) -> Option<a> / {task.recv} = None\n",
    b"pub fn crossing_close<a>(c: Chan<a>) -> Unit / {task.close} = ()\n",
    b"pub fn crossing_select<a>(arms: List<(Chan<a>, Option<a>)>, wait: Bool) -> Option<(Int, Option<a>)> / {task.select} = None\n",
  ])

pub fn scheduled_program_of(source: Bytes) -> Result<Program, Bytes> / {abort.raise} = {
  let shipped = [
    { name: scheduler_module, source_text: scheduler_stub },
    { name: b"std.internal.native", source_text: b"pub nondet effect native {}\n" },
  ];
  match analyse_pulling_std_with([{ name: b"m", source_text: source }], shipped, no_rows).out {
    Rejected(diagnostics) -> Err(Bytes::join(diagnostics.map(|d: Diagnostic| d.message), b"\n")),
    Analysed(a) -> match module_context_in(a, b"m") {
      Err(reason) -> Err(reason),
      Ok(s) ->
        Ok({
          source: source,
          analysis: a,
          setting: { ..s.setting, builtins: program_natives([]).map(|e: Extern| e.name) },
          roots: s.roots,
        }),
    },
  }
}

pub fn lowered_root(p: Program, name: Bytes) -> Function / {abort.raise} =
  lowered_at(p, Named(qualify(b"m", name)))

fn lowered_at(p: Program, key: RootKey) -> Function / {abort.raise} =
  match p.roots.find(|r: Root| r.key == key) {
    None ->
      panic(String::of_bytes_lossy(b"no such definition: ".concat(root_text(root_name(key))))),
    Some(r) -> root_lowered(p.setting, r),
  }

pub fn shipped_lowered(
  source: Bytes,
  shipped: List<{ name: Bytes, source_text: Bytes }>,
  module: Bytes,
  name: Bytes,
) -> Function / {abort.raise} =
  match analyse_pulling_std_with([{ name: b"m", source_text: source }], shipped, no_rows).out {
    Rejected(diagnostics) ->
      panic(String::of_bytes_lossy(Bytes::join(diagnostics.map(|d: Diagnostic| d.message), b"\n"))),
    Analysed(a) -> match module_context_in(a, module) {
      Err(reason) -> panic(String::of_bytes_lossy(reason)),
      Ok(s) ->
        lowered_at(
          {
            source: source,
            analysis: a,
            setting: { ..s.setting, builtins: program_natives([]).map(|e: Extern| e.name) },
            roots: s.roots,
          },
          Named(qualify(module, name)),
        ),
    },
  }

pub fn checked(p: Program, name: Bytes) -> Result<Function, Bytes> / {abort.raise} = {
  let counted = insert_reference_counts(lowered_root(p, name));
  match ownership_fault(counted) {
    Some(reason) -> Err(b"rejected by the check: ".concat(reason)),
    None -> Ok(counted),
  }
}

pub fn entry_handler_words(text: Bytes) -> List<Bytes> / {abort.raise} = {
  let descriptor_marker = b"ctx->entering_desc = ";
  let words = b"; ctx->entering_words = ";
  iterate({ from: 0, out: [] }, text.len() + 1, |s: { from: Int, out: List<Bytes> }|
    match text.slice(s.from, text.len()).index_of(descriptor_marker) {
      None -> Stop(s.out),
      Some(i) -> {
        let start = s.from + i + descriptor_marker.len();
        let rest = text.slice(start, text.len());
        match rest.index_of(words) {
          None -> Stop(s.out),
          Some(j) -> {
            let after = rest.slice(j + words.len(), rest.len());
            let end = match after.index_of(b";") { Some(k) -> k, None -> after.len() };
            Continue({
              from: start + j + words.len() + end,
              out: if rest.slice(0, j) == b"0" { s.out } else { s.out.push(after.slice(0, end)) },
            })
          },
        }
      },
    })
}

pub fn printed_by_ir(p: Program, name: Bytes) -> Result<Bytes, Bytes> / {abort.raise} =
  match checked(p, name) { Err(reason) -> Err(reason), Ok(form) -> Ok(printed_text(p, form)) }

pub fn printed_in(p: Program, f: Function) -> PrintOutput / {abort.raise} =
  printed_function(f, p.setting.constructors)

pub fn build_failure(p: Program, f: Function) -> Option<Bytes> = {
  let counted = built_form(f);
  if needs_specialisation(counted.links.needs) { None } else {
    match ownership_fault(counted) {
      Some(reason) -> Some(b"rejected by the check: ".concat(reason)),
      None -> handle {
        printed_in(p, counted);
        None
      } with {
        abort.raise(m) -> Some(Bytes::of_string(m)),
      },
    }
  }
}

pub fn build_failures(
  p: Program,
  names: List<Bytes>,
) -> List<{ name: Bytes, reason: Bytes }> / {abort.raise} =
  names.fold([], |accumulator: List<{ name: Bytes, reason: Bytes }>, n: Bytes|
    match build_failure(p, lowered_root(p, n)) {
      Some(reason) -> accumulator.push({ name: n, reason: reason }),
      None -> accumulator,
    })

pub fn printed_text(p: Program, f: Function) -> Bytes / {abort.raise} = {
  let printed = printed_in(p, f);
  let generics = f.links.generics.map(call_text);
  let members = f.members.map(|m: Member| m.key);
  let symbol = |k: RootKey| symbol_of(root_text(root_name(k)));
  resolved(
    Bytes::concat_all(
      printed.shared.map(|s: SharedFunction| s.text).push(
        body_text(f.key, members, printed.pieces),
      ),
    ),
    {
      f: printed.fields,
      l: printed.lambdas.map(|ps: List<Piece>| entry_text(pieces_text(ps), generics)),
      g: generics,
      own: symbol(f.key),
      members: members.map(symbol),
    },
  )
}

pub fn built_c(
  source: Bytes,
  shipped: List<{ name: Bytes, source_text: Bytes }>,
  key: RootKey,
) -> Result<Bytes, Bytes> / {abort.raise} = {
  let root = root_name(key);
  match analyse_pulling_std_with([{ name: b"m", source_text: source }], shipped, no_rows).out {
    Rejected(diagnostics) -> Err(Bytes::join(diagnostics.map(|d: Diagnostic| d.message), b"\n")),
    Analysed(a) -> match module_context_in(a, b"m") {
      Err(reason) -> Err(reason),
      Ok(s) -> {
        let d = dump_of(Analysed(a));
        let texts = shipped.fold(
          Map::new().insert(b"m", source).insert(prelude_module, prelude_source::text),
          |accumulator: Map<Bytes, Bytes>, x: { name: Bytes, source_text: Bytes }|
            accumulator.insert(x.name, x.source_text),
        );
        let order = d.modules.fold(Map::new(), |accumulator: Map<Int, Bytes>, row: ModuleRow|
          accumulator.insert(row.index, row.name));
        let names = range(0, order.len()).map(|i: Int|
          match order.get(i) { Some(n) -> n, None -> b"" });
        handle {
          match emit_root_results(
              names,
              names.map(|n: Bytes| match texts.get(n) { Some(t) -> t, None -> b"" }),
              s.setting.constructors,
              [key],
              [],
              [],
              d.embeds,
              d.rows,
              d.effects,
              d.inferred_facts,
            ).fold(None, |accumulator: Option<RootOutput>, r: RootOutput|
              if r.name == root { Some(r) } else { accumulator }) {
            Some(r) -> Ok(own_written(r)),
            None -> Err(b"the program has no definition with that name"),
          }
        } with {
          abort.raise(m) -> Err(Bytes::of_string(m)),
        }
      },
    },
  }
}

fn own_written(r: RootOutput) -> Bytes / {abort.raise} =
  resolved(r.result.text, {
    f: [],
    l: [],
    g: [],
    own: symbol_of(root_text(r.name)),
    members: r.result.tables.members.map(|k: RootKey| symbol_of(root_text(root_name(k)))),
  })

type Entries = { f: List<Bytes>, l: List<Bytes>, g: List<Bytes>, own: Bytes, members: List<Bytes> }

fn resolved(text: Bytes, e: Entries) -> Bytes / {abort.raise} = {
  let cut = text.split(b"@@");
  let member = |h: Bytes|
    if !digits_after(h, 115) { None }
    else { match h.slice(1, h.len()).int_of_ascii() { Some(n) -> e.members.at(n), None -> None } };
  Bytes::concat_all(
    range(0, cut.len()).map(|i: Int| {
      let s = cut.get(i);
      if i % 2 == 0 { s }
      else if i == cut.len() - 1 { b"@@".concat(s) }
      else if s == b"s" { e.own } else {
        match member(s) { Some(m) -> m, None -> Bytes::concat_all([b"@@", hole_text(s, e), b"@@"]) }
      }
    }),
  )
}

fn hole_text(h: Bytes, e: Entries) -> Bytes / {abort.raise} =
  if !numbered_hole(h) { h } else {
    let table = h.slice(0, 1);
    let entries = if table == b"f" { e.f } else if table == b"l" { e.l } else { e.g };
    match h.slice(1, h.len()).int_of_ascii() {
      Some(n) -> match entries.at(n) {
        Some(x) -> Bytes::concat_all([table, b"=", escaped(x)]),
        None -> h,
      },
      None -> h,
    }
  }

fn numbered_hole(h: Bytes) -> Bool / {abort.raise} =
  [108, 102, 103].any(|t: Int| digits_after(h, t))

fn entry_text(entry: Bytes, generics: List<Bytes>) -> Bytes / {abort.raise} =
  resolved(entry, { f: [], l: [], g: generics, own: b"", members: [] })

fn escaped(b: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, b.len()).map(|i: Int| {
      let x = b.at(i);
      if x >= 32 && x <= 126 && x != 64 && x != 92 && x != 59 && x != 123 && x != 125 {
        b.slice(i, i + 1)
      } else { Bytes::concat_all([b"\\x", hex_digit(x / 16), hex_digit(x % 16)]) }
    }),
  )

fn call_text(g: GenericCall) -> Bytes =
  Bytes::concat_all([
    root_text(root_name(g.callee)),
    b"<",
    Bytes::join(g.args.map(encode_type), b","),
    b">",
    if g.specialised_variables.len() == 0 { b"" } else {
      Bytes::concat_all([b"[", Bytes::join(g.specialised_variables.map(ascii_of_int), b","), b"]"])
    },
    Bytes::concat_all(
      g.functions.map(|x: InlinedLambda|
        Bytes::concat_all([
          b"|",
          ascii_of_int(x.param),
          b"=",
          root_text(root_name(x.owner)),
          b":",
          ascii_of_int(x.nth),
        ])),
    ),
  ])

fn digits_after(v: Bytes, lead: Int) -> Bool / {abort.raise} =
  v.len() > 1 && v.at(0) == lead && range(1, v.len()).all(|i: Int| v.at(i) >= 48 && v.at(i) <= 57)

const scalar_corpus: Bytes =
  Bytes::concat_all([
    b"fn add(a: Int, b: Int) -> Int = a + b\n",
    b"fn diff(a: Int, b: Int) -> Int = a - b * 3\n",
    b"fn quot(a: Int, b: Int) -> Int / {abort.raise} = a / b + a % 7\n",
    b"fn less(a: Int, b: Int) -> Bool = a < b\n",
    b"fn apart(a: Int, b: Int) -> Bool = a != b\n",
    b"fn negated(a: Int) -> Int = -a\n",
    b"fn bits(a: Int, b: Int) -> Int = (a & b) | 5\n",
    b"fn folded(a: Int) -> Int = a + (2 * 3 + 1)\n",
    b"fn pick(c: Bool, a: Int, b: Int) -> Int = if c { a } else { b + 1 }\n",
    b"fn square(x: Float) -> Float = x * x + 1.5\n",
    b"fn fless(x: Float, y: Float) -> Bool = x < y\n",
    b"fn fneg(x: Float) -> Float = -x\n",
    b"fn twice(x: Int) -> Int = add(x, x)\n",
    b"fn total(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { total(n - 1, acc + n) }\n",
    b"fn bound(x: Int) -> Int = { let y = x * 2; let z = y + 3; z - x }\n",
    b"fn flip(b: Bool) -> Bool = !b\n",
    b"fn same(a: Bool, b: Bool) -> Bool = a == b\n",
    b"fn wadd(a: U8, b: U8) -> U8 = a + b\n",
    b"fn wless(a: U8, b: U8) -> Bool = a < b\n",
    b"fn wmul(a: I32, b: I32) -> I32 = a * b\n",
    b"fn wide(a: I64, b: I64) -> I64 = a + b\n",
    b"fn uwide(a: U64, b: U64) -> U64 = a - b\n",
    b"fn wand(a: U16, b: U16) -> U16 = a & b\n",
  ])

const scalar_names: List<Bytes> =
  [
    b"add",
    b"diff",
    b"quot",
    b"less",
    b"apart",
    b"negated",
    b"bits",
    b"folded",
    b"pick",
    b"square",
    b"fless",
    b"fneg",
    b"twice",
    b"total",
    b"bound",
    b"flip",
    b"same",
    b"wadd",
    b"wless",
    b"wmul",
    b"wide",
    b"uwide",
    b"wand",
  ]

test "a function probes the stack once if it calls or loops, and a closure's function always probes it once" {
  let source = Bytes::concat_all([
    scalar_corpus,
    b"fn adder(n: Int) -> (Int) -> Int = |x: Int| x + n\n",
    b"fn even(n: Int) -> Bool = adder(n)(1) == 0\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let probed = probed_fn.concat(b"(ctx)");
      let probes = |n: Bytes|
        match printed_by_ir(p, n) { Ok(t) -> t.split(probed).len() - 1, Err(_) -> 0 - 1 };
      let probing = [b"twice", b"total", b"adder", b"even"];
      let names = scalar_names.concat([b"adder", b"even"]);
      assert_eq(names.filter(|n: Bytes| probes(n) != (if probing.contains(n) { 1 } else { 0 })), [])
    },
  }
}

test "a table placeholder in emitted C is replaced by the text of the entry it refers to, so the order entries were added in does not change the result" {
  let none: Entries = { f: [], l: [], g: [], own: b"", members: [] };
  let one = resolved(b"  Word t1 = ply_field(ctx, @@f0@@);", { ..none, f: [b"one"] });
  let two = resolved(b"  Word t1 = ply_field(ctx, @@f1@@);", { ..none, f: [b"zero", b"one"] });
  assert_eq(one, two);
  assert(resolved(b"  Word t1 = ply_field(ctx, @@f0@@);", { ..none, f: [b"zero"] }) != one);
  assert_eq(
    resolved(b"  f(@@f1@@, @@l0@@, @@f9@@, @@r@@, @@Tm.Box@@);", {
      ..none,
      f: [b"one", b"a\nb"],
      l: [b"entry"],
    }),
    b"  f(@@f=a\\x0ab@@, @@l=entry@@, @@f9@@, @@r@@, @@Tm.Box@@);",
  );
  assert_eq(entry_text(b"@@g0@@_entry", [b"m.id<Int>"]), b"@@g=m.id<Int>@@_entry")
}

fn body_of(source: Bytes, name: Bytes) -> Result<List<Instruction>, Bytes> / {abort.raise} =
  match program_of(source) { Err(reason) -> Err(reason), Ok(p) -> Ok(lowered_root(p, name).body) }

fn join_assignments(
  body: List<Instruction>,
) -> Option<{ var: Variable, then: List<Arg>, otherwise: List<Arg>, returned: Bool }> = {
  let sets = |b: List<Instruction>, j: Variable|
    b.fold([], |accumulator: List<Arg>, i: Instruction|
      match i {
        Assign(a) -> if a.var == j { accumulator.push(a.arg) } else { accumulator },
        _ -> accumulator,
      });
  match body.fold(None, |found: Option<Variable>, i: Instruction|
      match i { Declaration(v) -> Some(v), _ -> found }) {
    None -> None,
    Some(j) ->
      body.fold(
        None,
        |found: Option<{ var: Variable, then: List<Arg>, otherwise: List<Arg>, returned: Bool }>, i: Instruction|
          match i {
            If(x) ->
              Some({
                var: j,
                then: sets(x.then, j),
                otherwise: sets(x.otherwise, j),
                returned: body.contains(Return(VariableOperand(j))),
              }),
            _ -> found,
          },
      ),
  }
}

test "an `if` that returns a value assigns it to one variable of the type its branches return" {
  match join_assignments(
      match body_of(b"fn pick(c: Bool, a: Int, b: Int) -> Int = if c { a } else { b }\n", b"pick") {
        Ok(b) -> b,
        Err(reason) -> panic(String::of_bytes_lossy(reason)),
      },
    ) {
    Some(j) -> {
      assert_eq(j.var.representation, AsInt);
      assert(
        j.returned && j.then.len() == 1 && j.otherwise.len() == 1 && j.then != j.otherwise,
        None,
      )
    },
    None -> assert(false, None),
  }
}

test "a self call in tail position restarts the body, and an `if` branch that restarts assigns no result" {
  match body_of(
      b"fn total(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { total(n - 1, acc) }\n",
      b"total",
    ) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) -> match body.at(2) {
      Some(If(i)) -> {
        assert_eq(i.then.len(), 1);
        match i.otherwise.at(i.otherwise.len() - 1) {
          Some(Restart(args)) -> assert_eq(args.len(), 2),
          other -> assert_eq(other, None),
        };
        assert(!i.otherwise.any(|x: Instruction| match x { Assign(_) -> true, _ -> false }), None)
      },
      other -> assert_eq(other, None),
    },
  }
}

test "`&&` produces its Bool from the right operand when the left operand does not decide the result" {
  match join_assignments(
      match body_of(b"fn both(a: Bool, b: Bool) -> Bool = a && b\n", b"both") {
        Ok(b) -> b,
        Err(reason) -> panic(String::of_bytes_lossy(reason)),
      },
    ) {
    Some(j) -> {
      assert_eq(j.var.representation, AsBool);
      assert(j.returned && j.otherwise == [BoolOperand(false)], None);
      assert(match j.then { [VariableOperand(_)] -> true, _ -> false }, None)
    },
    None -> assert(false, None),
  }
}

test "each language construct in a function body lowers to its own kind of instruction" {
  let source = Bytes::concat_all([
    b"type P = { a: Int, b: Int }\n",
    b"effect amb {\n  read flip() -> Bool\n}\n",
    b"fn text() -> String = \"a\"\n",
    b"fn record(x: Int) -> P = { a: x, b: 2 }\n",
    b"fn read(p: P) -> Int = p.a\n",
    b"fn some(x: Int) -> Option<Int> = Some(x)\n",
    b"fn listed(x: Int) -> List<Int> = [x]\n",
    b"fn matched(x: Int) -> Int = match x { 0 -> 1, _ -> 2 }\n",
    b"fn none(x: Option<Int>) -> Bool = x == None\n",
    b"fn applied(f: (Int) -> Int) -> Int = f(1)\n",
    b"fn lambda(x: Int) -> (Int) -> Int = |y: Int| y + x\n",
    b"fn flipped() -> Bool / {amb.flip} = amb.flip()\n",
    b"fn handled() -> Int = handle { if amb.flip() { 1 } else { 2 } } with { amb.flip() resume k -> k(true) }\n",
  ]);
  let names = [
    b"text",
    b"record",
    b"read",
    b"some",
    b"listed",
    b"matched",
    b"none",
    b"applied",
    b"lambda",
    b"flipped",
    b"handled",
  ];
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) ->
      assert_eq(
        names.map(|n: Bytes| root_text(root_name(lowered_root(p, n).key))),
        names.map(|n: Bytes| qualify(b"m", n)),
      ),
  }
}
