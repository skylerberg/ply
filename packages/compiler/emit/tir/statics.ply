//! Static objects a body's C names: values laid out once, at build, where the program's data lives.

import std.bin
import std.bytes (hex_digit)
import emit.keys (RootKey, root_key_bin)
import emit.layout (text_head)
import check.types (Type, string_type, bytes_type)

/// A static object (`Val.Static` names one): its name, `ply_k_` and the start of the digest of what
/// it holds, so one name is one content and the unit lays each out once; and how it is laid.
pub type StaticDef = { name: Bytes, laid: StaticLaid }

/// How a static object is laid out. `SBlock`: as emitted code reads a block it made, an immortal
/// count, its `head` where its type keeps one, then `words`. `SPlain`: words with no header.
/// `SStruct`: one of the machine structs `emit.layout` declares, by its name, each field in order.
/// `SFile`: the bytes of a file the program embeds, by their digest, as a byte string the unit lays
/// out from what it was handed.
pub type StaticLaid =
  | SBlock({ head: Option<StaticHead>, words: List<StaticWord> })
  | SPlain(List<StaticWord>)
  | SStruct({ of: Bytes, fields: List<StaticWord> })
  | SFile(Bytes)

/// A static block's head: one of `layout.head_structs` by its name, each field set by its name.
pub type StaticHead = { of: Bytes, fields: List<{ field: Bytes, value: Int }> }

/// A word of a static object, or a field of a machine struct. `WRaw`: the integer itself.
/// `WAddress`: another static object's address, its low bits `tag`. `WEntry`: a root's C function.
/// `WBytes`: bytes laid in place, padded with zeros to a whole word. `WField`: the field table's
/// entry of a name, which the unit writes in. `WHead`: a C function the emitter's head defines, by
/// its name.
pub type StaticWord =
  | WRaw(Int)
  | WAddress({ name: Bytes, tag: Int })
  | WEntry(RootKey)
  | WBytes(Bytes)
  | WField(Bytes)
  | WHead(Bytes)

derive bin for StaticWord
derive bin for StaticHead
derive bin for StaticLaid
derive bin for StaticDef

/// The static laid as `laid`, named by its content: `ply_k_` and the first 32 hex digits of the
/// blake3 of `laid`, which names the statics it addresses by their own content, so two statics share
/// a name exactly where they hold the same.
pub fn named(laid: StaticLaid) -> StaticDef / {abort.raise} = {
  let digest = bin::encode(laid, static_laid_bin()).blake3().slice(0, 16);
  {
    name: Bytes::concat_all(
      [b"ply_k_"].concat(
        range(0, digest.len()).map(|i: Int|
          hex_digit(digest.at(i) / 16).concat(hex_digit(digest.at(i) % 16))),
      ),
    ),
    laid: laid,
  }
}

/// The words `d` lays out after any header, a machine struct's fields among them; none for a file's
/// bytes.
pub fn words_of(d: StaticDef) -> List<StaticWord> =
  match d.laid { SBlock(b) -> b.words, SPlain(ws) -> ws, SStruct(s) -> s.fields, SFile(_) -> [] }

/// The roots whose C functions `d` holds, in order.
pub fn entries_of(d: StaticDef) -> List<RootKey> =
  words_of(d).fold([], |acc: List<RootKey>, w: StaticWord|
    match w { WEntry(k) -> acc.push(k), _ -> acc })

/// Whether a value of `ty` is text: a `String` or `Bytes`, which a block lays out alike.
pub fn is_text(ty: Type) -> Bool = ty == string_type() || ty == bytes_type()

/// The head and words of a string's or a byte string's block holding `b`: its length and its room
/// both `b`'s.
pub fn text_block(b: Bytes) -> { head: Option<StaticHead>, words: List<StaticWord> } =
  {
    head: Some({
      of: text_head().name,
      fields: [{ field: b"len", value: b.len() }, { field: b"room", value: b.len() }],
    }),
    words: if b.len() == 0 { [] } else { [WBytes(b)] },
  }

test "a static's name is its content's: equal contents share one, and a child's content moves its parents'" {
  let s = named(SBlock(text_block(b"ply")));
  assert_eq(named(SBlock(text_block(b"ply"))), s);
  assert(named(SBlock(text_block(b"plz"))).name != s.name, None);
  let parent = |child: StaticDef| named(SPlain([WAddress({ name: child.name, tag: 0 })]));
  assert(parent(s).name != parent(named(SBlock(text_block(b"plz")))).name, None)
}
