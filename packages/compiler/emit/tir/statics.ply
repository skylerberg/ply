//! Static objects a body's C names: values laid out once, at build, where the program's data lives.

import std.bin
import emit.keys (RootKey, root_key_bin)

/// A static object (`Val.Static` names one): its name, `ply_k_` and the start of the digest of what
/// it holds, so one name is one content and the unit lays each out once; and how it is laid.
pub type StaticDef = { name: Bytes, laid: StaticLaid }

/// How a static object is laid out. `SBlock`: as emitted code reads a block it made, an immortal
/// count, the refused kind, each `head` field of the header set by its name (`flags`, `aux`, `len`,
/// `layout`), then `words`. `SPlain`: words with no header. `SStruct`: one of the machine structs
/// `emit.layout` declares, by its name, each field in order. `SFile`: the bytes of a file the program
/// embeds, by their digest, as a byte string the unit lays out from what it was handed.
pub type StaticLaid =
  | SBlock({ head: List<{ field: Bytes, value: Int }>, words: List<StaticWord> })
  | SPlain(List<StaticWord>)
  | SStruct({ of: Bytes, fields: List<StaticWord> })
  | SFile(Bytes)

/// A word of a static object, or a field of a machine struct. `WRaw`: the integer itself.
/// `WAddress`: another static object's address, its low bits `tag`. `WEntry`: a root's C function.
/// `WBytes`: bytes laid in place, padded with zeros to a whole word. `WField`: the field table's
/// entry of a name, which the unit writes in.
pub type StaticWord =
  | WRaw(Int)
  | WAddress({ name: Bytes, tag: Int })
  | WEntry(RootKey)
  | WBytes(Bytes)
  | WField(Bytes)

derive bin for StaticWord
derive bin for StaticLaid
derive bin for StaticDef
