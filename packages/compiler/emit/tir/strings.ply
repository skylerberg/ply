//! What the form's operations on the bytes of strings and byte strings hold beyond their operands.
//! A string and a byte string are blocks laid alike, as `layout.str_laid` says; an address is an
//! `RAddr` a `Get` of `PPayload` read, borrowed from its block, and every count and offset an `Int`
//! of bytes.

/// An operation over the bytes of strings and byte strings, written in place.
pub type StringOp =
  /// A fresh block of as many bytes as its one operand says, unwritten, with room for exactly
  /// those.
  | Made
  /// Writes into the fresh block that is operand 0, at its byte operand 1, the bytes at the address
  /// operand 2 from its byte operand 3, as many as operand 4 says. Answers nothing.
  | Copied
  /// Writes the byte operand 2 at byte operand 1 of the fresh block operand 0. Answers nothing.
  | ByteSet
  /// The byte at the address operand 0 at offset operand 1, an `Int` 0 to 255.
  | ByteRead
  /// The four bytes at the address operand 0 from offset operand 1, least significant first, a
  /// `U32`.
  | U32Read
  /// The block operand 0, which it takes, with as many bytes as operand 2 says from the address
  /// operand 1 appended: in place where it held the block's one count and the block has room,
  /// else into a fresh block with room to grow, the block let go of.
  | Grown
  /// Whether the bytes at the address operand 0 from its byte operand 1 equal those at the address
  /// operand 2 from its byte operand 3, as many as operand 4 says: 1 or 0.
  | Compared
  /// Where the bytes at the address operand 2, as many as operand 3 says, first occur among the
  /// bytes at the address operand 0, as many as operand 1 says, from byte operand 4 on: their
  /// offset, or -1 where they do not. An empty needle occurs at operand 4.
  | Found
  /// How many characters the UTF-8 at the address operand 0 holds, as many bytes as operand 1
  /// says.
  | CharsIn
  /// The byte at which character operand 2 of the UTF-8 at the address operand 0 begins, as many
  /// bytes as operand 1 says; operand 1 for the character just past the last, and -1 for any
  /// other character past it or below 0.
  | CharStart
  /// Where `Bytes::scan` (`until` false) or `Bytes::scan_until` (`until` true) stops in the bytes
  /// at the address operand 0, as many as operand 1 says, from byte operand 2 for at most operand 5
  /// bytes: the first byte that is (`until`) or is not one of the bytes at the address operand 3,
  /// as many as operand 4 says, or the window's end. Operand 2 lies within the bytes.
  | Scanned({ until: Bool })

/// What an operation over bytes does with one operand: takes the block (`Grown`'s first), writes
/// into the fresh block it holds (`Copied`'s and `ByteSet`'s first), reads through an address
/// borrowed from the block it points into, or reads a number: a count, an offset or a byte.
pub type StringArg = | TakesBlock | WritesBlock | ReadsAt | Number

/// What an operation over bytes answers: a block of its own, a number, or nothing.
pub type StringAnswer = | OwnBlock | Count | NoAnswer

/// What `op` does with each of its operands, in order: the one rule the ownership pass places counts
/// by and the check checks, through the `uses` an operation is written with.
pub fn string_args(op: StringOp) -> List<StringArg> =
  match op {
    Made -> [Number],
    Copied -> [WritesBlock, Number, ReadsAt, Number, Number],
    ByteSet -> [WritesBlock, Number, Number],
    ByteRead -> [ReadsAt, Number],
    U32Read -> [ReadsAt, Number],
    Grown -> [TakesBlock, ReadsAt, Number],
    Compared -> [ReadsAt, Number, ReadsAt, Number, Number],
    Found -> [ReadsAt, Number, ReadsAt, Number, Number],
    CharsIn -> [ReadsAt, Number],
    CharStart -> [ReadsAt, Number, Number],
    Scanned(_) -> [ReadsAt, Number, Number, ReadsAt, Number, Number],
  }

/// What `op` answers.
pub fn string_answer(op: StringOp) -> StringAnswer =
  match op {
    Made -> OwnBlock,
    Grown -> OwnBlock,
    Copied -> NoAnswer,
    ByteSet -> NoAnswer,
    _ -> Count,
  }
