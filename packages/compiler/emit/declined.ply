//! Each root the typed form declines, or lowers to a form its check refuses, and today's emitter
//! writes instead, marked in its C by why, so a build's kept answers count what the form does not
//! cover yet.

import emit.answer (Emitted)
import emit.tir (Fn, Declined, Family, Spine, Data, Calling, Matching, Handling, Scalars,
                 Containers)
import emit.own (owned)
import emit.verify (verified)

/// Why today's emitter writes a root: the family that declined it, or the fault the check found in
/// the form it was lowered to.
pub type Fallback = | Unformed(Declined) | Faulted(Bytes)

/// The form a root was lowered to, where the check passes it once its counts are placed; else why
/// today's emitter writes the root instead.
pub fn vetted(lowered: Result<Fn, Declined>) -> Result<Fn, Fallback> / {abort.raise} =
  match lowered {
    Err(no) -> Err(Unformed(no)),
    Ok(f) -> match verified(owned(f)) { Some(fault) -> Err(Faulted(fault)), None -> Ok(f) },
  }

/// `e`, which today's emitter wrote for `root` where the form fell back as `why` says, its text led
/// by `/* ply-form-declined <family> <root>: <why> */` or `/* ply-form-faulted <root>: <fault> */`.
pub fn noted(e: Emitted, root: Bytes, why: Fallback) -> Emitted / {abort.raise} =
  if e.text.len() == 0 { e } else {
    let marker = match why {
      Unformed(no) ->
        Bytes::concat_all([
          b"declined ",
          family_name(no.by),
          b" ",
          plain(root),
          b": ",
          plain(no.why),
        ]),
      Faulted(fault) -> Bytes::concat_all([b"faulted ", plain(root), b": ", plain(fault)]),
    };
    { ..e, text: Bytes::concat_all([b"/* ply-form-", marker, b" */\n", e.text]) }
  }

fn family_name(f: Family) -> Bytes =
  match f {
    Spine -> b"Spine",
    Data -> b"Data",
    Calling -> b"Calling",
    Matching -> b"Matching",
    Handling -> b"Handling",
    Scalars -> b"Scalars",
    Containers -> b"Containers",
  }

/// `b` with every byte but a letter, a digit, a space, `.`, `,`, `(`, `)` and a backtick written
/// `-`: nothing a comment closes on, a hole the unit fills, or a helper's name it links.
fn plain(b: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, b.len()).map(|i: Int| {
      let x = b.at(i);
      if (x >= 48 && x <= 57) || (x >= 65 && x <= 90) || (x >= 97 && x <= 122) || x == 32 || x == 46
          || x == 44
          || x == 40
          || x == 41
          || x == 96 { b.slice(i, i + 1) }
      else { b"-" }
    }),
  )
