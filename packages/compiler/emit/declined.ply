//! Each root the typed form declines, lowers to a form its check refuses, or cannot print, and today's
//! emitter writes instead, marked in its C by why, so a build's kept answers count what the form does
//! not cover yet.

import emit.answer (Emitted)
import emit.tir (Fn, Declined, family_name)
import emit.own (owned)
import emit.verify (verified)
import emit.print (printed_fn)
import emit.print.text (Printed)

/// Why today's emitter writes a root: the family that declined it, the fault the check found in the
/// form it was lowered to, or what a printer had no C for.
pub type Fallback = | Unformed(Declined) | Faulted(Bytes) | Unprinted(Bytes)

/// A root's form with its counts placed, which the check passed, and what it printed as.
pub type Vetted = { counted: Fn, printed: Printed }

/// The form a root was lowered to, where the check passes it once its counts are placed and it
/// prints; else why today's emitter writes the root instead.
pub fn vetted(lowered: Result<Fn, Declined>) -> Result<Vetted, Fallback> / {abort.raise} =
  match lowered {
    Err(no) -> Err(Unformed(no)),
    Ok(f) -> {
      let counted = owned(f);
      match verified(counted) {
        Some(fault) -> Err(Faulted(fault)),
        None -> handle {
          Ok({ counted: counted, printed: printed_fn(counted) })
        } with {
          abort.raise(m) -> Err(Unprinted(Bytes::of_string(m))),
        },
      }
    },
  }

/// `e`, which today's emitter wrote for `root` where the form fell back as `why` says, its text led
/// by `/* ply-form-declined <family> <root>: <why> */`, `/* ply-form-faulted <root>: <fault> */` or
/// `/* ply-form-unprinted <root>: <what> */`.
pub fn noted(e: Emitted, root: Bytes, why: Fallback) -> Emitted / {abort.raise} =
  if e.text.len() == 0 { e } else {
    let marker = match why {
      Unformed(no) ->
        Bytes::concat_all([
          b"declined ",
          family_name(no.by),
          b" ",
          plain(root),
          b": ",
          plain(no.why),
        ]),
      Faulted(fault) -> Bytes::concat_all([b"faulted ", plain(root), b": ", plain(fault)]),
      Unprinted(what) ->
        Bytes::concat_all([
          b"unprinted ",
          plain(root),
          b": ",
          plain(if what.starts_with(b"unprinted ") { what.slice(10, what.len()) } else { what }),
        ]),
    };
    { ..e, text: Bytes::concat_all([b"/* ply-form-", marker, b" */\n", e.text]) }
  }

/// `b` with every byte but a letter, a digit, a space, `.`, `,`, `:`, `(`, `)` and a backtick
/// written `-`: nothing a comment closes on, a hole the unit fills, or a helper's name it links.
fn plain(b: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, b.len()).map(|i: Int| {
      let x = b.at(i);
      if (x >= 48 && x <= 58) || (x >= 65 && x <= 90) || (x >= 97 && x <= 122) || x == 32 || x == 46
          || x == 44
          || x == 40
          || x == 41
          || x == 96 { b.slice(i, i + 1) }
      else { b"-" }
    }),
  )
