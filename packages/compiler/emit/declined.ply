//! Each root the typed form declines and today's emitter writes, marked in its C by the family that
//! declined it and why, so a build's kept answers count what the form does not cover yet.

import emit.answer (Emitted)
import emit.tir (Declined, Family, Spine, Data, Calling, Matching, Handling, Scalars, Containers)

/// `e`, which today's emitter wrote for `root` where the form declined it as `no` says, its text
/// led by `/* ply-form-declined <family> <root>: <why> */`.
pub fn noted(e: Emitted, root: Bytes, no: Declined) -> Emitted / {abort.raise} =
  if e.text.len() == 0 { e } else {
    {
      ..e,
      text: Bytes::concat_all([
        b"/* ply-form-declined ",
        family_name(no.by),
        b" ",
        plain(root),
        b": ",
        plain(no.why),
        b" */\n",
        e.text,
      ]),
    }
  }

fn family_name(f: Family) -> Bytes =
  match f {
    Spine -> b"Spine",
    Data -> b"Data",
    Calling -> b"Calling",
    Matching -> b"Matching",
    Handling -> b"Handling",
    Scalars -> b"Scalars",
    Containers -> b"Containers",
  }

/// `b` with every byte but a letter, a digit, a space, `.`, `,`, `(`, `)` and a backtick written
/// `-`: nothing a comment closes on, a hole the unit fills, or a helper's name it links.
fn plain(b: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, b.len()).map(|i: Int| {
      let x = b.at(i);
      if (x >= 48 && x <= 57) || (x >= 65 && x <= 90) || (x >= 97 && x <= 122) || x == 32 || x == 46
          || x == 44
          || x == 40
          || x == 41
          || x == 96 { b.slice(i, i + 1) }
      else { b"-" }
    }),
  )
