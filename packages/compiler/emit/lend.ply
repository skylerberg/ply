//! Lending: which parameters a definition only reads, so a call lends them rather than gives them,
//! and which answers it reads out of what it is lent, so a caller borrows them. Lean's borrow
//! inference over the typed form, extended to answers and settled per recursion group of the call
//! graph against what every callee outside the group hands. A definition is read as a build lowers
//! it, a tail group's members together, so a jump from one member to another is read as one. Its
//! handing is what every caller's code is written against.

import std.bytes (ascii_of_int)
import std.graph
import check.types (Type, TyCon, TyVar)
import check.resolve.tables (qualify)
import syntax.parsing (Span, dummy_span, span_between)
import emit.keys (RootKey, Named, At, Written, Callee, Root, Generic, TypeOp, Equal, Order, Reflect,
                  Shown, Digest, Contained, Lower, Lift, Drop, Share, Keep, Dup, Cased, Worded,
                  root_name)
import emit.written (contained_reads)
import emit.reps (Def, has_vars)
import emit.answer (GenericCall, Published)
import emit.layout
import emit.layout (Always, Inline, LWords)
import emit.tir (Rep, RWord, RInt, RBool, RFlat, RSlice, RSum, Var, Arg, AVar, AInt, AZero, Val,
                 Prim, Literal, Static, Make, Get, Take, Tag, Pack, Gathered, Call, Apply, Native,
                 Op, OHandle, Made, MClosure, MList, MRecord, MCase, PLeaf, PField, PArg, PCase,
                 PCapture, PNamed, Inst, Let, Do, Decl, Assign, If, Case, Match, Loop, Next, Done,
                 Return, Restart, Enter, Handle, Reset, Opened, Block, Fn, Member, Rooted, Lambda,
                 Closure, Handed, Given, Lent, Returned, Owned, Borrowed, Convention, TTag, Uses,
                 ReadsOf, LastOf, Walked, no_links, counted, rep_of_arg, used_as, operands,
                 answered, var_of, unpacks)
import emit.tir.handling (Perform)
import emit.verify (payload_of, allocates, re_held)
import emit.own (owned, may_reuse)
import emit.lower.held (passing, ByReference)

/// How a definition takes its parameters and hands back its answer, which every caller's code is
/// written against: inferred from its body and its callees' handings, never written.
pub type Handing = { params: List<Handed>, answer: Returned }

/// Where the uses are that settled a handing below lending: for each parameter given, the first use
/// found to give it (`None` where it is lent); for an answer owned, the first return found to make
/// it so.
pub type Why = { params: List<Option<Span>>, answer: Option<Span> }

/// A definition's handing, and why it is so.
pub type Inferred = { handing: Handing, why: Why }

/// A definition as the inference reads it: its full name; its parameters and body as a build lowers
/// them, alone or as a member of a tail group, whose members' names `group` holds in the order its
/// `Enter`s number them (none for a root of its own); the parameters, by place, its declaration lends
/// (E0475), which nothing inferred moves; and the form it was read from, the tail group's where it
/// is a member, whose resets the ownership pass places.
pub type Lending = { def: Bytes, f: Fn, group: List<Bytes>, lent: List<Int>, whole: Fn }

/// How a callee nothing infers is handed `arity` arguments: it takes each and answers a count of its
/// own.
pub fn taking_all(arity: Int) -> Handing =
  { params: range(0, arity).map(|_: Int| Given), answer: Owned }

/// The definitions `forms` hold as the inference reads them: each form a root or tail group as the
/// build lowered it, which emission then counts and prints, and `declared` the parameters each
/// definition lends by declaration, by its full name. A specialisation takes its definition's
/// handing and a root written for a type its fixed one, so neither is read.
pub fn lendings_of(declared: Map<Bytes, List<Int>>, forms: List<Fn>) -> List<Lending> =
  forms.fold([], |acc: List<Lending>, f: Fn|
    match f.key { Named(_) -> acc.concat(read_as(declared, f)), _ -> acc })

/// `into` with the parameters, by place, each of `here`, the definitions of `module`, lends by
/// declaration (E0475), by its full name: what `lendings_of` reads for them.
pub fn declared_lent(
  into: Map<Bytes, List<Int>>,
  module: Bytes,
  here: List<Def>,
) -> Map<Bytes, List<Int>> =
  here.fold(into, |m: Map<Bytes, List<Int>>, d: Def|
    if d.lent.len() == 0 { m } else { m.insert(qualify(module, d.name), d.lent) })

/// Each of `group`'s definitions' handing in its order, and why: a fixpoint that starts every
/// parameter lent but those reset for reuse and every answer borrowed of nothing, and moves each
/// down only as far as some use forces it. An answer whose type a type variable leaves open is
/// owned from the start: a handing holds at every specialisation, and some type holds that answer
/// otherwise than the generic body does, made afresh (an `Option<Int>` boxes its `Int`, a record
/// gathers its fields). A call of a definition outside the group is handed as `published` holds,
/// else as `taking_all`.
///
/// Settled first with no resets, then again from those of the members it still lends a counted
/// parameter of, where any is reset: a reset only gives a parameter, so one already given stays
/// given, and the ownership pass runs only where a handing can move.
pub fn group_handings(
  group: List<Lending>,
  published: Map<Bytes, Handing>,
) -> List<Inferred> / {abort.raise} = {
  let plain = settled_from(group, published, group.map(|_: Lending| Map::new()));
  let lending = range(0, group.len()).fold(Map::new(), |m: Map<Bytes, Bool>, k: Int|
    match ((group.at(k), plain.at(k))) {
      (Some(l), Some(x)) -> if lends_counted(l, x.handing) && may_reuse(l.whole) {
        m.insert(root_name(l.whole.key), true)
      } else { m },
      _ -> m,
    });
  if lending.len() == 0 { plain } else {
    let placed = lending.fold(Map::new(), |m: Map<Bytes, Map<Int, Span>>, name: Bytes, _: Bool|
      match group.find(|l: Lending| root_name(l.whole.key) == name) {
        Some(l) -> m.insert(name, resets_of(l.whole)),
        None -> m,
      });
    let resets = group.map(|l: Lending|
      match placed.get(root_name(l.whole.key)) {
        Some(r) -> by_place(r, l.f.params),
        None -> Map::new(),
      });
    if resets.all(|r: Map<Int, Span>| r.len() == 0) { plain }
    else { settled_from(group, published, resets) }
  }
}

/// The parameters of `l`, by place, the ownership pass resets for a constructor to reuse where every
/// parameter of the form it was read from is given, each with where that constructor is.
pub fn reset_params(l: Lending) -> Map<Int, Span> = by_place(resets_of(l.whole), l.f.params)

/// `group`'s handings settled from every parameter lent but those `resets` names, member by member.
fn settled_from(
  group: List<Lending>,
  published: Map<Bytes, Handing>,
  resets: List<Map<Int, Span>>,
) -> List<Inferred> / {abort.raise} =
  iterate(
    range(0, group.len()).fold([], |acc: List<Inferred>, k: Int|
      match group.at(k) {
        Some(l) ->
          acc.push(first_guess(l, match resets.at(k) { Some(r) -> r, None -> Map::new() })),
        None -> acc,
      }),
    group.fold(2, |n: Int, m: Lending| n + 3 * m.f.params.len() + 2),
    |cur: List<Inferred>| {
      let next = round(group, published, cur);
      if handings(next) == handings(cur) { Stop(next) } else { Continue(next) }
    },
  )

/// Whether `h` lends a parameter of `l` that holds a count.
fn lends_counted(l: Lending, h: Handing) -> Bool =
  range(0, l.f.params.len()).any(|k: Int|
    (match l.f.params.at(k) { Some(p) -> counted(p.rep), None -> false })
      && h.params.at(k) == Some(Lent))

/// What the lending inference settled: `published` with the handing of every definition it read, by
/// full name, and the recursion group of their calls and jumps each was settled with.
pub type Settled = { handed: Map<Bytes, Handing>, groups: Map<Bytes, List<Bytes>> }

/// `published` with the handing of every definition `lendings` holds, each recursion group of their
/// calls and jumps settled after every group it calls.
pub fn handings_of(
  lendings: List<Lending>,
  published: Map<Bytes, Handing>,
) -> Settled / {abort.raise} = {
  let at = range(0, lendings.len()).fold(Map::new(), |m: Map<Bytes, Int>, k: Int|
    match lendings.at(k) { Some(l) -> m.insert(l.def, k), None -> m });
  let out = lendings.map(|l: Lending|
    called(l).fold([], |acc: List<Int>, d: Bytes|
      match at.get(d) { Some(k) -> acc.push(k), None -> acc }));
  let calls = graph::of(lendings.len(), |k: Int| match out.at(k) { Some(xs) -> xs, None -> [] });
  graph::components(calls).fold(
    { handed: published, groups: Map::new() },
    |done: Settled, comp: List<Int>| {
      let group = comp.fold([], |g: List<Lending>, k: Int|
        match lendings.at(k) { Some(l) -> g.push(l), None -> g });
      let defs = group.map(|l: Lending| l.def);
      let hs = handings(group_handings(group, done.handed));
      range(0, group.len()).fold(done, |s: Settled, k: Int|
        match group.at(k) {
          Some(l) -> match hs.at(k) {
            Some(h) -> { handed: s.handed.insert(l.def, h), groups: s.groups.insert(l.def, defs) },
            None -> s,
          },
          None -> s,
        })
    },
  )
}

/// A handing as text: each parameter `lent` or `given` in order, then how it answers, each
/// parameter a borrowed answer reads out of by place and `part` where it is only something read out
/// of it.
pub fn handing_said(h: Handing) -> Bytes =
  Bytes::concat_all([
    b"[",
    Bytes::join(h.params.map(|p: Handed| match p { Lent -> b"lent", Given -> b"given" }), b", "),
    b"] ",
    match h.answer {
      Owned -> b"owned",
      Borrowed(from) ->
        Bytes::concat_all([
          b"borrowed(",
          Bytes::join(
            from.map(|x: { param: Int, whole: Bool }|
              if x.whole { ascii_of_int(x.param) } else { ascii_of_int(x.param).concat(b" part") }),
            b", ",
          ),
          b")",
        ]),
    },
  ])

/// `f` written against the handings `handed` holds by definition: a root's parameters and answer, or
/// each tail group member's, as its definition's handing says (a specialisation's as the one it
/// specialises, a root written for a type's as `written_handing`), and each call's as its callee's. A
/// closure's body takes and answers as its function type does, and its calls as their callees'.
/// Raises where a handing's parameters are not the convention's, which no call can be written to.
pub fn conventions(f: Fn, handed: Map<Bytes, Handing>) -> Fn / {abort.raise} = {
  let own = |k: RootKey, c: Convention|
    match key_def(k) {
      Some(d) -> match handed.get(d) { Some(h) -> conv_handed(c, h, d), None -> c },
      None -> match k {
        Written(x) -> conv_handed(c, written_handing(x.op, c.params.len()), root_name(k)),
        _ -> c,
      },
    };
  let called = calls_handed(f, generics_of(f), handed);
  {
    ..called,
    conv: if f.members.len() == 0 { own(f.key, f.conv) } else { f.conv },
    members: f.members.map(|m: Member| { ..m, conv: own(m.key, m.conv) }),
  }
}

/// The definition root `k` runs: its own, or the one it specialises.
fn key_def(k: RootKey) -> Option<Bytes> =
  match k { Named(n) -> Some(n), At(a) -> Some(a.def), _ -> None }

/// `c` taking its parameters and answering as `h`, the handing of `what`. An answer borrowed holds no
/// count of what holds none where `c` holds it: a specialisation at a scalar answers it owned.
fn conv_handed(c: Convention, h: Handing, what: Bytes) -> Convention / {abort.raise} =
  if h.params.len() != c.params.len() {
    panic(
      String::of_bytes_lossy(
        Bytes::concat_all([
          b"a handing of ",
          ascii_of_int(h.params.len()),
          b" parameters for a convention of ",
          ascii_of_int(c.params.len()),
          b": ",
          what,
        ]),
      ),
    )
  } else {
    {
      ..c,
      params: h.params,
      answered: match h.answer {
        Owned -> Owned,
        Borrowed(from) -> if !counted(c.answer) { Owned } else {
          Borrowed(
            from.filter(|x: { param: Int, whole: Bool }|
              match c.reps.at(x.param) { Some(r) -> counted(r), None -> false }),
          )
        },
      },
    }
  }

/// `f` with each call of its body and of its closures' bodies written against its callee's handing,
/// a generic call found among `generics`, the root's, which number its closures' calls too.
fn calls_handed(f: Fn, generics: List<Bytes>, handed: Map<Bytes, Handing>) -> Fn / {abort.raise} =
  {
    ..f,
    body: block_handed(generics, handed, f.body),
    lambdas: f.lambdas.map(|l: Lambda|
      match l { Closure(c) -> Closure({ ..c, body: calls_handed(c.body, generics, handed) }) }),
  }

/// The definitions the generic calls of `f`, a root, and of its closures name, by the calls' number.
fn generics_of(f: Fn) -> List<Bytes> = f.links.generics.map(|g: GenericCall| g.callee)

fn block_handed(
  generics: List<Bytes>,
  handed: Map<Bytes, Handing>,
  b: Block,
) -> Block / {abort.raise} =
  b.map(|i: Inst|
    match i {
      Let(l) -> Let({ ..l, val: val_handed(generics, handed, l.val) }),
      Do(d) -> Do({ ..d, val: val_handed(generics, handed, d.val) }),
      If(x) ->
        If({
          ..x,
          then: block_handed(generics, handed, x.then),
          otherwise: block_handed(generics, handed, x.otherwise),
        }),
      Case(c) ->
        Case({
          ..c,
          arms: c.arms.map(|a: { when: Int, body: Block }|
            { when: a.when, body: block_handed(generics, handed, a.body) }),
          rest: block_handed(generics, handed, c.rest),
        }),
      Match(m) ->
        Match({
          arms: m.arms.map(|a: Block| block_handed(generics, handed, a)),
          rest: block_handed(generics, handed, m.rest),
        }),
      Loop(l) -> Loop({ ..l, body: block_handed(generics, handed, l.body) }),
      Handle(h) -> Handle({ ..h, body: block_handed(generics, handed, h.body) }),
      _ -> i,
    })

fn val_handed(generics: List<Bytes>, handed: Map<Bytes, Handing>, v: Val) -> Val / {abort.raise} =
  match v {
    Call(c) ->
      Call({
        ..c,
        conv: conv_handed(
          c.conv,
          handing_at(handed, generics, c.callee, c.args.len()),
          match c.callee {
            Root(k) -> root_name(k),
            Generic(n) -> b"generic call ".concat(ascii_of_int(n)),
          },
        ),
      }),
    _ -> v,
  }

// --- What a build lowers ---------------------------------------------------------------------

/// The definitions `f` lowers as the inference reads them: `f` itself, or each member of the tail
/// group it is, that member's arm of `f`'s body its body.
fn read_as(declared: Map<Bytes, List<Int>>, f: Fn) -> List<Lending> = {
  let lending = |g: Fn, group: List<Bytes>| {
    let full = root_name(g.key);
    {
      def: full,
      f: g,
      group: group,
      lent: match declared.get(full) { Some(ps) -> ps, None -> [] },
      whole: f,
    }
  };
  if f.members.len() == 0 { [lending(f, [])] } else {
    let fulls = f.members.map(|m: Member| root_name(m.key));
    range(0, f.members.len()).fold([], |acc: List<Lending>, i: Int|
      match f.members.at(i) {
        Some(m) ->
          acc.push(
            lending(
              {
                ..f,
                key: m.key,
                params: m.params,
                conv: m.conv,
                body: arm_of(f.body, i),
                base: m.base,
                members: [],
              },
              fulls,
            ),
          ),
        None -> acc,
      })
  }
}

/// Arm `i` of a tail group's body, the body of its member `i`.
fn arm_of(b: Block, i: Int) -> Block =
  match b {
    [Case(c)] ->
      c.arms.fold([], |body: Block, a: { when: Int, body: Block }|
        if a.when == i { a.body } else { body }),
    _ -> [],
  }

/// `resets` of the parameters `params`, by place.
fn by_place(resets: Map<Int, Span>, params: List<Var>) -> Map<Int, Span> =
  range(0, params.len()).fold(Map::new(), |m: Map<Int, Span>, k: Int|
    match params.at(k) {
      Some(p) -> match resets.get(p.id) { Some(at) -> m.insert(k, at), None -> m },
      None -> m,
    })

/// Each parameter of `f`, or of its tail group's members, by number, whose cells the ownership pass
/// resets for a constructor to reuse where every parameter is given (Lean's `reset`): the parameter
/// reset itself, or the one a part it resets was read out of or is held again as. Each comes with
/// where the constructor taking its cells is.
fn resets_of(f: Fn) -> Map<Int, Span> = {
  let giving = |c: Convention| { ..c, params: c.params.map(|_: Handed| Given) };
  let counted_form = owned({
    ..f,
    conv: giving(f.conv),
    members: f.members.map(|m: Member| { ..m, conv: giving(m.conv) }),
  });
  let params = f.members.fold(f.params, |ps: List<Var>, m: Member| ps.concat(m.params));
  reused(
    {
      held: params.fold(Map::new(), |h: Map<Int, List<Int>>, p: Var| h.insert(p.id, [p.id])),
      tokens: Map::new(),
      at: Map::new(),
    },
    counted_form.body,
  ).at
}

/// What `resets_of` reads off a body with its counts placed: the parameters, by number, each
/// variable is, holds or was read out of; those whose cells each reuse token holds; and each
/// parameter whose cells a constructor takes, with where.
type Reuse = { held: Map<Int, List<Int>>, tokens: Map<Int, List<Int>>, at: Map<Int, Span> }

fn reused(r: Reuse, b: Block) -> Reuse =
  b.fold(r, |acc: Reuse, i: Inst|
    match i {
      Let(l) -> {
        let from = held_in(acc, l.val);
        {
          ..acc,
          held: if from.len() == 0 { acc.held } else { acc.held.insert(l.var.id, from) },
          at: match l.val {
            Make(m) -> match m.reuse {
              Some(t) ->
                (match acc.tokens.get(t.id) { Some(ps) -> ps, None -> [] }).fold(
                  acc.at,
                  |a: Map<Int, Span>, p: Int| if a.contains(p) { a } else { a.insert(p, l.at) },
                ),
              None -> acc.at,
            },
            _ -> acc.at,
          },
        }
      },
      Assign(x) ->
        {
          ..acc,
          held: acc.held.insert(x.var.id, joined(held_of(acc, x.var), arg_held(acc, x.arg))),
        },
      Opened(o) ->
        {
          ..acc,
          held: o.words.fold(acc.held, |h: Map<Int, List<Int>>, w: Var|
            h.insert(w.id, held_of(acc, o.of))),
        },
      Reset(x) -> { ..acc, tokens: acc.tokens.insert(x.token.id, held_of(acc, x.of)) },
      If(x) -> reused(reused(acc, x.then), x.otherwise),
      Case(c) ->
        c.arms.fold(reused(acc, c.rest), |a: Reuse, arm: { when: Int, body: Block }|
          reused(a, arm.body)),
      Match(m) -> m.arms.fold(reused(acc, m.rest), reused),
      Loop(l) -> reused(acc, l.body),
      Handle(h) -> reused(acc, h.body),
      _ -> acc,
    })

/// The parameters what `val` answers holds as `reused` reads them: what it reads out of, a field
/// taken out of a block, or what a value held again as another, with no object made, holds.
fn held_in(r: Reuse, val: Val) -> List<Int> =
  match val {
    Take(t) -> held_of(r, t.of),
    Pack(p) -> if allocates(rep_of_arg(p.arg), p.to) { [] } else { arg_held(r, p.arg) },
    Gathered(g) -> g.parts.fold([], |ps: List<Int>, a: Arg| joined(ps, arg_held(r, a))),
    _ -> match answered(val) {
      ReadsOf(xs) -> xs.fold([], |ps: List<Int>, x: Var| joined(ps, held_of(r, x))),
      _ -> [],
    },
  }

fn held_of(r: Reuse, v: Var) -> List<Int> = match r.held.get(v.id) { Some(ps) -> ps, None -> [] }

fn arg_held(r: Reuse, a: Arg) -> List<Int> =
  match var_of(a) { Some(v) -> held_of(r, v), None -> [] }

fn joined(a: List<Int>, b: List<Int>) -> List<Int> =
  b.fold(a, |acc: List<Int>, x: Int| if acc.contains(x) { acc } else { acc.push(x) })

// --- A round -----------------------------------------------------------------------------------

/// Where a variable's counted words come from: the parameters, by place, it is or holds in place
/// (`true`) or was read out of (`false`), and whether it holds a value the body made, which lives
/// only while the body holds it.
type Origin = { bases: Map<Int, Bool>, fresh: Bool }

/// What a body does with a value, read once its walk knows every join, and where in the text: it
/// consumes it, hands it to parameter `param` of definition `to` by a jump to that one's start,
/// answers it, or sets join `join` to it.
type Use = { does: Does, at: Span }

type Does =
  | Consumes(Origin)
  | Jumps({ to: Bytes, param: Int, of: Origin, counts: Bool })
  | Answers(Origin)
  | Sets({ join: Int, of: Origin })

/// A body walked: each variable's origin, the origins each closure it made holds as its captures,
/// its uses in order, and the place of the last instruction walked that has one.
type Walk = {
  origins: Map<Int, Origin>,
  captured: Map<Int, List<Origin>>,
  uses: List<Use>,
  at: Span,
}

/// What a walk reads beside the body: each definition's handing as this round has it, the definition
/// each of the root's generic calls names, the definition walked, and its tail group's members in
/// the order an `Enter` numbers them.
type Sight = { look: Map<Bytes, Handing>, generics: List<Bytes>, def: Bytes, group: List<Bytes> }

/// A parameter of definition `to` that a jump hands what the jumping member does not lend on, and
/// where.
type Jumped = { to: Bytes, param: Int, at: Span }

/// What a member's walk gives against a round's handings: each of its own parameters a use consumes
/// whole, with where the first such use is, and each parameter of a member it jumps to that must be
/// given.
type Gone = { own: Map<Int, Span>, jumped: List<Jumped> }

type Found = { lending: Lending, cur: Inferred, walk: Walk, gone: Gone }

fn first_guess(m: Lending, resets: Map<Int, Span>) -> Inferred = {
  let n = m.f.params.len();
  let reset = |k: Int| !m.lent.contains(k) && resets.contains(k);
  {
    handing: {
      params: range(0, n).map(|k: Int| if reset(k) { Given } else { Lent }),
      answer: if counted(m.f.conv.answer) && !has_vars(m.f.answer_ty) { Borrowed([]) }
      else { Owned },
    },
    why: {
      params: range(0, n).map(|k: Int| if reset(k) { resets.get(k) } else { None }),
      answer: None,
    },
  }
}

fn handings(xs: List<Inferred>) -> List<Handing> = xs.map(|x: Inferred| x.handing)

/// Each member's handing settled once against `cur`, the group's so far: a parameter is given where
/// a use in its own body gives it, or where a member jumps to it with a value that member does not
/// lend on.
fn round(
  group: List<Lending>,
  published: Map<Bytes, Handing>,
  cur: List<Inferred>,
) -> List<Inferred> = {
  let look = range(0, group.len()).fold(published, |m: Map<Bytes, Handing>, k: Int|
    match group.at(k) {
      Some(l) -> match cur.at(k) { Some(c) -> m.insert(l.def, c.handing), None -> m },
      None -> m,
    });
  let reps = group.fold(Map::new(), |m: Map<Bytes, List<Rep>>, l: Lending|
    m.insert(l.def, l.f.params.map(|p: Var| p.rep)));
  let found = range(0, group.len()).fold([], |acc: List<Found>, k: Int|
    match group.at(k) {
      Some(l) -> match cur.at(k) {
        Some(c) -> {
          let w = member_walk(
            {
              look: look,
              generics: l.f.links.generics.map(|g: GenericCall| g.callee),
              def: l.def,
              group: l.group,
            },
            l.f,
          );
          acc.push({
            lending: l,
            cur: c,
            walk: w,
            gone: gone_in(c.handing, look, reps, l.f.params.map(|p: Var| p.rep), w),
          })
        },
        None -> acc,
      },
      None -> acc,
    });
  let jumps = found.fold([], |js: List<Jumped>, x: Found| js.concat(x.gone.jumped));
  found.map(|x: Found|
    settled(
      x.lending,
      x.cur,
      x.walk,
      jumps.fold(x.gone.own, |g: Map<Int, Span>, j: Jumped|
        if j.to == x.lending.def { first_at(g, j.param, j.at) } else { g }),
    ))
}

/// A walk of root `f`'s body, each counted parameter its own base.
fn member_walk(s: Sight, f: Fn) -> Walk =
  walked(
    s,
    range(0, f.params.len()).fold(
      { origins: Map::new(), captured: Map::new(), uses: [], at: dummy_span() },
      |w: Walk, k: Int|
        match f.params.at(k) {
          Some(p) -> defined(w, p, { bases: Map::new().insert(k, true), fresh: false }),
          None -> w,
        },
    ),
    f.body,
  )

/// What walk `w` gives, against `look`, the group's handings this round, and `h`, the walked
/// member's own: its parameter whose value is consumed whole, answered owned, set to an owned join
/// or jumped with to a given place; and a parameter a jump hands, at a lent place, something the
/// jumping member does not lend on, so nothing outlasts the jump to release it.
fn gone_in(
  h: Handing,
  look: Map<Bytes, Handing>,
  reps: Map<Bytes, List<Rep>>,
  own: List<Rep>,
  w: Walk,
) -> Gone =
  w.uses.fold({ own: Map::new(), jumped: [] }, |g: Gone, u: Use|
    match u.does {
      Consumes(o) -> { ..g, own: wholes(g.own, o, u.at) },
      Jumps(j) -> {
        let lent_there = match look.get(j.to) {
          Some(t) -> t.params.at(j.param) == Some(Lent),
          None -> false,
        };
        // A lent record passed by reference is pointed at again by a jump, never written through:
        // only a lent record passed by reference, or one laid inside such a one, outlasts it.
        let pointed = match reps.get(j.to) {
          Some(rs) -> match rs.at(j.param) { Some(r) -> passing(r) == ByReference, None -> false },
          None -> false,
        };
        let pointable = j.of.bases.len() > 0
          && j.of.bases.all(|k: Int, whole: Bool|
            whole && (match own.at(k) { Some(r) -> passing(r) == ByReference, None -> false }));
        if !lent_there { if j.counts { { ..g, own: wholes(g.own, j.of, u.at) } } else { g } }
        else if (j.counts
            && (j.of.fresh || j.of.bases.keys().any(|k: Int| h.params.at(k) == Some(Given))))
            || (pointed && !pointable) {
          { ..g, jumped: g.jumped.push({ to: j.to, param: j.param, at: u.at }) }
        } else { g }
      },
      Answers(o) -> if h.answer == Owned { { ..g, own: wholes(g.own, o, u.at) } } else { g },
      Sets(x) -> if owned_join(w, x.join) { { ..g, own: wholes(g.own, x.of, u.at) } } else { g },
    })

/// Member `m`'s handing and why, settled from `cur`, its own so far, its walk `w` and what this
/// round gives of its parameters (`gone`): a parameter its declaration lends stays lent; one given
/// before or now is given, with the place of the use that first gave it; the answer stays borrowed
/// while every return answers only what it read out of what it is lent.
fn settled(m: Lending, cur: Inferred, w: Walk, gone: Map<Int, Span>) -> Inferred = {
  let n = m.f.params.len();
  let given = |k: Int|
    !m.lent.contains(k) && (cur.handing.params.at(k) == Some(Given) || gone.contains(k));
  let params = range(0, n).map(|k: Int| if given(k) { Given } else { Lent });
  let answer = if cur.handing.answer == Owned { { returned: Owned, at: cur.why.answer } }
  else { answered_over(w.uses, params) };
  {
    handing: { params: params, answer: answer.returned },
    why: {
      params: range(0, n).map(|k: Int|
        if !given(k) { None }
        else { match cur.why.params.at(k) { Some(Some(at)) -> Some(at), _ -> gone.get(k) } }),
      answer: answer.at,
    },
  }
}

/// How a body answering as `uses` say answers, its parameters handed as `params`: borrowed of every
/// base its answers reach while none holds anything made and each base is lent, else owned, with the
/// place of the first return that makes it so.
fn answered_over(
  uses: List<Use>,
  params: List<Handed>,
) -> { returned: Returned, at: Option<Span> } =
  match uses.fold(Ok(Map::new()), |acc: Result<Map<Int, Bool>, Span>, u: Use|
      match acc {
        Err(_) -> acc,
        Ok(m) -> match u.does {
          Answers(o) -> if o.fresh || o.bases.keys().any(|k: Int| params.at(k) != Some(Lent)) {
            Err(u.at)
          } else { Ok(bases_with(m, o)) },
          _ -> acc,
        },
      }) {
    Err(at) -> { returned: Owned, at: Some(at) },
    Ok(m) ->
      {
        returned: Borrowed(
          m.fold([], |acc: List<{ param: Int, whole: Bool }>, k: Int, whole: Bool|
            acc.push({ param: k, whole: whole })),
        ),
        at: None,
      },
  }

/// Whether join `j` holds a count of its own: some value set to it was made in the body, so every
/// value set to it is consumed.
fn owned_join(w: Walk, j: Int) -> Bool = match w.origins.get(j) { Some(o) -> o.fresh, None -> true }

fn wholes(g: Map<Int, Span>, o: Origin, at: Span) -> Map<Int, Span> =
  o.bases.fold(g, |acc: Map<Int, Span>, k: Int, whole: Bool|
    if whole { first_at(acc, k, at) } else { acc })

fn first_at(g: Map<Int, Span>, k: Int, at: Span) -> Map<Int, Span> =
  if g.contains(k) { g } else { g.insert(k, at) }

// --- A walk ------------------------------------------------------------------------------------

fn none() -> Origin = { bases: Map::new(), fresh: false }

fn made() -> Origin = { bases: Map::new(), fresh: true }

fn bases_with(m: Map<Int, Bool>, o: Origin) -> Map<Int, Bool> =
  o.bases.fold(m, |acc: Map<Int, Bool>, k: Int, whole: Bool|
    acc.insert(k, whole || acc.get(k) == Some(true)))

fn union(a: Origin, b: Origin) -> Origin =
  { bases: bases_with(a.bases, b), fresh: a.fresh || b.fresh }

/// What is read out of a value of origin `o`: a word of its own, so no base of it is that word.
fn read_out(o: Origin) -> Origin =
  {
    bases: o.bases.fold(Map::new(), |m: Map<Int, Bool>, k: Int, _: Bool| m.insert(k, false)),
    fresh: o.fresh,
  }

/// `v`'s origin; one the walk never bound holds a count of its own, so nothing is lent through it.
fn origin_of(w: Walk, v: Var) -> Origin =
  match w.origins.get(v.id) { Some(o) -> o, None -> if counted(v.rep) { made() } else { none() } }

fn arg_origin(w: Walk, a: Arg) -> Origin = match a { AVar(v) -> origin_of(w, v), _ -> none() }

/// `w` with `v` of origin `o`, where `v` holds a count or is passed by reference: a record a jump
/// points at again must lie where its caller lent it, whether or not it holds a count.
fn defined(w: Walk, v: Var, o: Origin) -> Walk =
  if counted(v.rep) || passing(v.rep) == ByReference { { ..w, origins: w.origins.insert(v.id, o) } }
  else { w }

fn used(w: Walk, d: Does) -> Walk = { ..w, uses: w.uses.push({ does: d, at: w.at }) }

/// `w` past consuming `a`, where it holds a count: a value holding none gives nothing up.
fn consumed(w: Walk, a: Arg) -> Walk =
  if counted(rep_of_arg(a)) { used(w, Consumes(arg_origin(w, a))) } else { w }

fn taken(w: Walk, ops: List<{ arg: Arg, takes: Bool }>) -> Walk =
  ops.fold(w, |acc: Walk, o: { arg: Arg, takes: Bool }|
    if o.takes { consumed(acc, o.arg) } else { acc })

/// Each of `args` handed to its parameter of `to` by a jump to that one's start.
fn jumped(w: Walk, to: Bytes, args: List<Arg>) -> Walk =
  range(0, args.len()).fold(w, |a: Walk, k: Int|
    match args.at(k) {
      Some(x) ->
        used(a, Jumps({ to: to, param: k, of: arg_origin(a, x), counts: counted(rep_of_arg(x)) })),
      None -> a,
    })

/// The one recursion: `b` walked in order, each use at the place of the last instruction before it
/// that has one; a nested block is walked from the place before it, which holds again after it.
fn walked(s: Sight, w: Walk, b: Block) -> Walk =
  b.fold(w, |acc: Walk, i: Inst|
    match i {
      Let(l) -> {
        let v = valued(s, { ..acc, at: l.at }, l.val, Some(l.var));
        defined(v.walk, l.var, v.origin)
      },
      Do(d) -> valued(s, { ..acc, at: d.at }, d.val, None).walk,
      Decl(v) -> defined(acc, v, none()),
      Assign(x) -> {
        // A constant set to a counted join is held as the join's count.
        let o = match x.arg {
          AVar(_) -> arg_origin(acc, x.arg),
          _ -> if counted(rep_of_arg(x.arg)) { made() } else { none() },
        };
        let set = defined(acc, x.var, union(origin_of(acc, x.var), o));
        if counted(x.var.rep) { used(set, Sets({ join: x.var.id, of: o })) } else { set }
      },
      If(x) -> placed(walked(s, placed(walked(s, acc, x.then), acc.at), x.otherwise), acc.at),
      Case(c) ->
        placed(
          c.arms.fold(walked(s, acc, c.rest), |a: Walk, arm: { when: Int, body: Block }|
            walked(s, placed(a, acc.at), arm.body)),
          acc.at,
        ),
      Match(m) ->
        placed(
          m.arms.fold(walked(s, acc, m.rest), |a: Walk, arm: Block|
            walked(s, placed(a, acc.at), arm)),
          acc.at,
        ),
      Loop(l) -> {
        let looping = l.state.fold(l.init.fold(acc, consumed), |a: Walk, v: Var|
          defined(a, v, made()));
        defined(placed(walked(s, looping, l.body), acc.at), l.answer, made())
      },
      Next(args) -> args.fold(acc, consumed),
      Done(a) -> consumed(acc, a),
      Return(a) -> if counted(rep_of_arg(a)) { used(acc, Answers(arg_origin(acc, a))) }
      else { acc },
      Restart(args) -> jumped(acc, s.def, args),
      Enter(e) -> match s.group.at(e.member) {
        Some(to) -> jumped(acc, to, e.args),
        None -> e.args.fold(acc, consumed),
      },
      Handle(h) ->
        defined(
          placed(walked(s, taken(acc, used_as(h.args, h.uses)), h.body), acc.at),
          h.answer,
          made(),
        ),
      _ -> acc,
    })

fn placed(w: Walk, at: Span) -> Walk = { ..w, at: at }

/// What `val`, bound to `bound` where it binds one, holds and does with its operands. It consumes
/// what `tir.operands` says it does, but for a call, which lends what its callee lends; a function
/// applied, which the call reads while its caller holds it; and a word held again as another
/// (`verify.re_held`), which holds what its operand holds. A value read out of another holds that
/// one's bases as read out of them, a part of a transparent value or a sum's payload as they are.
fn valued(s: Sight, w: Walk, val: Val, bound: Option<Var>) -> { walk: Walk, origin: Origin } =
  match val {
    Prim(_) -> { walk: w, origin: made() },
    Literal(_) -> { walk: w, origin: made() },
    Static(_) -> { walk: w, origin: none() },
    Tag(_) -> { walk: w, origin: none() },
    Make(m) -> {
      let stored = taken(w, operands(val));
      {
        walk: match bound {
          Some(to) -> match m.made {
            MClosure(_) ->
              {
                ..stored,
                captured: stored.captured.insert(to.id, m.args.map(|x: Arg| arg_origin(w, x))),
              },
            _ -> stored,
          },
          None -> stored,
        },
        origin: made(),
      }
    },
    Get(g) ->
      {
        walk: w,
        origin: match g.path {
          PLeaf(_) -> origin_of(w, g.of),
          PCapture(k) -> match w.captured.get(g.of.id) {
            Some(cs) -> match cs.at(k) { Some(o) -> o, None -> read_out(origin_of(w, g.of)) },
            None -> read_out(origin_of(w, g.of)),
          },
          PNamed(_) -> made(),
          _ -> match bound {
            Some(y) -> if payload_of(val, y) != None { origin_of(w, g.of) }
            else { read_out(origin_of(w, g.of)) },
            None -> read_out(origin_of(w, g.of)),
          },
        },
      },
    Take(t) -> { walk: w, origin: read_out(origin_of(w, t.of)) },
    Pack(p) -> match again_of(bound, val) {
      Some(x) -> { walk: w, origin: origin_of(w, x) },
      None -> if unpacks(p.arg, p.to) { { walk: w, origin: read_out(arg_origin(w, p.arg)) } }
      else if operands(val).any(|o: { arg: Arg, takes: Bool }| o.takes) {
        { walk: consumed(w, p.arg), origin: made() }
      } else { { walk: w, origin: none() } },
    },
    // The ownership pass holds a value gathered from counted parts as a count of its own, but for
    // a one-word sum gathered from one word, which holds that word again.
    Gathered(g) -> {
      let again = again_of(bound, val);
      {
        walk: w,
        origin: match again {
          Some(x) -> origin_of(w, x),
          None -> if g.parts.any(|a: Arg| counted(rep_of_arg(a))) { made() } else { none() },
        },
      }
    },
    Call(c) -> {
      let h = handing_at(s.look, s.generics, c.callee, c.args.len());
      {
        walk: range(0, c.args.len()).fold(w, |a: Walk, k: Int|
          if h.params.at(k) == Some(Lent) { a }
          else { match c.args.at(k) { Some(x) -> consumed(a, x), None -> a } }),
        origin: match h.answer {
          Owned -> made(),
          Borrowed(from) ->
            from.fold(none(), |o: Origin, x: { param: Int, whole: Bool }|
              match c.args.at(x.param) {
                Some(a) ->
                  union(o, if x.whole { arg_origin(w, a) } else { read_out(arg_origin(w, a)) }),
                None -> o,
              }),
        },
      }
    },
    Apply(_) -> { walk: taken(w, operands(val).drop(1)), origin: made() },
    Native(n) -> { walk: taken(w, operands(val)), origin: answered_by(w, n.args, n.uses) },
    Op(o) -> { walk: taken(w, operands(val)), origin: answered_by(w, o.args, o.uses) },
    LastOf(x) -> { walk: taken(w, operands(val)), origin: arg_origin(w, AVar(x)) },
    Walked(x) ->
      { walk: taken(w, operands(val)), origin: if x.op == Share { none() } else { made() } },
  }

fn again_of(bound: Option<Var>, val: Val) -> Option<Var> =
  match bound { Some(y) -> re_held(y, val), None -> None }

/// What an operation that answers as `uses` says answers: a count of its own, or what it read out
/// of its first operand.
fn answered_by(w: Walk, args: List<Arg>, uses: Uses) -> Origin =
  if uses.owned { made() }
  else { match args.at(0) { Some(a) -> read_out(arg_origin(w, a)), None -> none() } }

/// How `c`, called with `arity` arguments, is handed them: a definition as `look` has it, the
/// definition a generic call names found in `generics` by its number, a root written for a type as
/// `written_handing` says, anything else taking all it is handed.
fn handing_at(look: Map<Bytes, Handing>, generics: List<Bytes>, c: Callee, arity: Int) -> Handing =
  match callee_def(generics, c) {
    Some(d) -> match look.get(d) { Some(h) -> h, None -> taking_all(arity) },
    None -> match c {
      Root(k) -> match k { Written(x) -> written_handing(x.op, arity), _ -> taking_all(arity) },
      Generic(_) -> taking_all(arity),
    },
  }

/// The handing of a root written for a type, `arity` operands, as its generator writes it and the
/// runtime calls it: a comparison, a reflection, a printing, a digest, a lowering, a container's walk
/// (but for the list a gathering walk adds to) and a lowering's loop over a list's items or entries,
/// a share, a keep and a count taken once more only read their operands and answer afresh, and so
/// does the entry the runtime lowers a word form through, which it lends that word; a drop, a
/// release, a copy, a lifting and a lifting's loop take them. A case's root hands as its operation
/// does.
pub fn written_handing(op: TypeOp, arity: Int) -> Handing =
  { params: range(0, arity).map(|k: Int| if reads(op, k) { Lent } else { Given }), answer: Owned }

/// Whether the root written for a type that does `op` only reads its operand `k`.
fn reads(op: TypeOp, k: Int) -> Bool =
  match op {
    Equal -> true,
    Order -> true,
    Reflect -> true,
    Shown -> true,
    Digest -> true,
    Lower -> true,
    Share -> true,
    Keep -> true,
    Dup -> true,
    Contained(c) -> contained_reads(c, k),
    Cased(c) -> reads(c.op, k),
    Worded(w) -> reads(w, k),
    _ -> false,
  }

/// The definition a call of `c` runs, by name: a definition, one at type arguments, or the one a
/// generic call names, which `generics` holds by the call's number.
fn callee_def(generics: List<Bytes>, c: Callee) -> Option<Bytes> =
  match c {
    Root(k) -> match k { Named(n) -> Some(n), At(a) -> Some(a.def), _ -> None },
    Generic(i) -> generics.at(i),
  }

/// The definitions `l` calls or jumps to, each once: its body's callees and its tail group's
/// members. Its closures' bodies are not read: what one does with a capture is its closure's to
/// count.
fn called(l: Lending) -> List<Bytes> =
  calls_in(l.f.links.generics.map(|g: GenericCall| g.callee), l.group, l.f.body)

fn calls_in(generics: List<Bytes>, acc: List<Bytes>, b: Block) -> List<Bytes> =
  vals_folded(b, acc, |a: List<Bytes>, v: Val| call_named(generics, a, v))

/// `acc` folded by `on` over each value `b` and the blocks it holds bind or do.
fn vals_folded<s>(b: Block, acc: s, on: (s, Val) -> s) -> s =
  b.fold(acc, |a: s, i: Inst|
    match i {
      Let(l) -> on(a, l.val),
      Do(d) -> on(a, d.val),
      If(x) -> vals_folded(x.otherwise, vals_folded(x.then, a, on), on),
      Case(c) ->
        c.arms.fold(vals_folded(c.rest, a, on), |n: s, arm: { when: Int, body: Block }|
          vals_folded(arm.body, n, on)),
      Match(m) ->
        m.arms.fold(vals_folded(m.rest, a, on), |n: s, arm: Block| vals_folded(arm, n, on)),
      Loop(l) -> vals_folded(l.body, a, on),
      Handle(h) -> vals_folded(h.body, a, on),
      _ -> a,
    })

/// The handing each definition `outside` names was written against by the calls of `f`'s body and
/// of its closures' bodies, as `handed` holds it, each definition once, as an answer publishes it; a
/// generic call found among `generics`, the root's.
fn assumed_in(
  f: Fn,
  generics: List<Bytes>,
  handed: Map<Bytes, Handing>,
  outside: (Bytes) -> Bool,
) -> List<Published> = {
  let added = |a: List<Published>, p: Published|
    if a.any(|x: Published| x.def == p.def) { a } else { a.push(p) };
  let own = vals_folded(f.body, [], |a: List<Published>, v: Val|
    match v {
      Call(c) -> match callee_def(generics, c.callee) {
        Some(d) -> if !outside(d) { a }
        else { added(a, published_of(d, handing_at(handed, generics, c.callee, c.args.len()))) },
        None -> a,
      },
      _ -> a,
    });
  f.lambdas.fold(own, |a: List<Published>, l: Lambda|
    match l { Closure(c) -> assumed_in(c.body, generics, handed, outside).fold(a, added) })
}

/// `h`, the handing of definition `def`, as an answer publishes it.
pub fn published_of(def: Bytes, h: Handing) -> Published =
  {
    def: def,
    lent: h.params.map(|p: Handed| p == Lent),
    borrowed: match h.answer { Owned -> None, Borrowed(from) -> Some(from) },
  }

/// The handings answers published as `ps`, by definition.
pub fn handed_from(ps: List<Published>) -> Map<Bytes, Handing> =
  ps.fold(Map::new(), |m: Map<Bytes, Handing>, p: Published|
    m.insert(p.def, {
      params: p.lent.map(|l: Bool| if l { Lent } else { Given }),
      answer: match p.borrowed { None -> Owned, Some(from) -> Borrowed(from) },
    }))

/// A form of the build written against the handings the inference settled: the handings of the
/// definitions it defines as its answer publishes them; those of the definitions outside its group
/// it was written against, a specialisation's own definition's among them; and that group where it
/// holds more than the form's own.
pub type LentForm = {
  form: Fn,
  handings: List<Published>,
  assumed: List<Published>,
  group: List<Bytes>,
}

/// `f`, a form of the build, written against `s`: its own convention, each member's, and each of its
/// calls' as their definitions' handings say (`conventions`).
pub fn lent_form(f: Fn, s: Settled) -> LentForm / {abort.raise} = {
  let lent = conventions(f, s.handed);
  let own = if lent.members.len() == 0 { [{ key: lent.key, conv: lent.conv }] }
  else { lent.members.map(|m: Member| { key: m.key, conv: m.conv }) };
  let defs = own.fold([], |acc: List<Bytes>, o: { key: RootKey, conv: Convention }|
    match o.key { Named(n) -> acc.push(n), _ -> acc });
  let group = defs.fold(defs, |acc: List<Bytes>, d: Bytes|
    match s.groups.get(d) {
      Some(g) -> g.fold(acc, |a: List<Bytes>, x: Bytes| if a.contains(x) { a } else { a.push(x) }),
      None -> acc,
    });
  // A specialisation takes as its definition hands, whichever form of the build settled that.
  let specialised = own.fold([], |acc: List<Published>, o: { key: RootKey, conv: Convention }|
    match o.key {
      At(a) ->
        acc.push(
          published_of(a.def, match s.handed.get(a.def) {
            Some(h) -> h,
            None -> taking_all(o.conv.params.len()),
          }),
        ),
      _ -> acc,
    });
  {
    form: lent,
    handings: defs.fold([], |acc: List<Published>, d: Bytes|
      match s.handed.get(d) { Some(h) -> acc.push(published_of(d, h)), None -> acc }),
    assumed: assumed_in(lent, generics_of(lent), s.handed, |d: Bytes| !group.contains(d)).fold(
      specialised,
      |a: List<Published>, p: Published|
        if a.any(|x: Published| x.def == p.def) { a } else { a.push(p) },
    ),
    group: if group.len() > defs.len() { group } else { [] },
  }
}

fn call_named(generics: List<Bytes>, a: List<Bytes>, v: Val) -> List<Bytes> =
  match v {
    Call(c) -> match callee_def(generics, c.callee) {
      Some(d) -> if a.contains(d) { a } else { a.push(d) },
      None -> a,
    },
    _ -> a,
  }

fn of_type(id: Int, ty: Bytes, rep: Rep) -> Var =
  { id: id, ty: TyCon({ name: ty, args: [] }), rep: rep }

fn word(id: Int) -> Var = of_type(id, b"String", RWord)

fn tree(id: Int) -> Var = of_type(id, b"m.Tree", RWord)

fn int(id: Int) -> Var = of_type(id, b"Int", RInt)

fn flag(id: Int) -> Var = of_type(id, b"Bool", RBool)

fn bind(v: Var, val: Val) -> Inst = Let({ var: v, val: val, at: dummy_span(), unwind: [] })

fn given_all(params: List<Var>, answer: Rep) -> Convention =
  {
    params: params.map(|_: Var| Given),
    reps: params.map(|p: Var| p.rep),
    answer: answer,
    answered: Owned,
  }

/// Definition `m.<name>` over `params`, answering as `answer`, nothing about it declared.
fn def_of(name: Bytes, params: List<Var>, answer: Rep, body: Block) -> Lending = {
  let f = {
    key: Named(qualify(b"m", name)),
    kind: Rooted,
    params: params,
    conv: given_all(params, answer),
    answer_ty: TyCon({ name: b"T", args: [] }),
    body: body,
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  };
  { def: qualify(b"m", name), f: f, group: [], lent: [], whole: f }
}

/// A call of `m.<name>` handing `args`, as the lowering writes one before it reads any handing.
fn call_of(name: Bytes, args: List<Arg>) -> Val =
  Call({
    callee: Root(Named(qualify(b"m", name))),
    args: args,
    conv: {
      params: args.map(|_: Arg| Given),
      reps: args.map(rep_of_arg),
      answer: RWord,
      answered: Owned,
    },
    stops: false,
  })

/// What `group` settles on, each of `published` handing `m.<name>` as it says.
fn settled_with(
  group: List<Lending>,
  published: List<{ name: Bytes, handing: Handing }>,
) -> List<Handing> / {abort.raise} =
  handings(
    group_handings(
      group,
      published.fold(Map::new(), |m: Map<Bytes, Handing>, p: { name: Bytes, handing: Handing }|
        m.insert(qualify(b"m", p.name), p.handing)),
    ),
  )

fn alone(group: List<Lending>) -> List<Handing> / {abort.raise} = settled_with(group, [])

fn made_of(made: Made, args: List<Arg>) -> Val = Make({ made: made, args: args, reuse: None })

test "a walk that only reads its parameters lends both" {
  let a = word(0);
  let t = tree(1);
  let l = tree(2);
  let r = tree(3);
  let x = int(4);
  let y = int(5);
  let z = int(6);
  let walk = def_of(b"walk", [a, t], RInt, [
    Case({
      on: t,
      test: TTag([b"m.Leaf", b"m.Node"]),
      arms: [
        {
          when: 1,
          body: [
            bind(l, Get({ of: t, path: PArg({ ctor: b"m.Node", at: 0 }) })),
            bind(r, Get({ of: t, path: PArg({ ctor: b"m.Node", at: 1 }) })),
            bind(x, call_of(b"walk", [AVar(a), AVar(l)])),
            bind(y, call_of(b"walk", [AVar(a), AVar(r)])),
            bind(z, Prim({ op: b"add", on: RInt, args: [AVar(x), AVar(y)] })),
            Return(AVar(z)),
          ],
        },
      ],
      rest: [Return(AInt(0))],
    }),
  ]);
  assert_eq(alone([walk]), [{ params: [Lent, Lent], answer: Owned }])
}

test "a parameter stored, updated in place, performed, given on, or captured by a closure that outlives the call is given" {
  let s = word(0);
  let r = word(1);
  let by = |val: Val| alone([def_of(b"f", [s], RWord, [bind(r, val), Return(AVar(r))])]);
  let gives = [{ params: [Given], answer: Owned }];
  assert_eq(by(made_of(MRecord({ names: [b"s"], width: 1 }), [AVar(s)])), gives);
  assert_eq(
    by(
      Native({
        name: b"rt_push",
        args: [AVar(s), AInt(1)],
        uses: { takes: [true, false], owned: true, fails: true, stops: false },
      }),
    ),
    gives,
  );
  assert_eq(
    by(
      Op({
        op: OHandle(
          Perform({
            effect: b"m.log",
            op: b"put",
            resource: b"",
            labelled: false,
            mode: 1,
            described: b"ply_k_put",
          }),
        ),
        args: [AVar(s)],
        uses: { takes: [true], owned: true, fails: true, stops: true },
      }),
    ),
    gives,
  );
  assert_eq(by(call_of(b"keep", [AVar(s)])), gives);
  assert_eq(
    by(made_of(MClosure({ nth: 0, captures: 1, params: 1, stacked: false }), [AVar(s)])),
    gives,
  );
  // Handed to a parameter its callee lends, it stays lent.
  assert_eq(
    settled_with(
      [def_of(b"f", [s], RWord, [bind(r, call_of(b"look", [AVar(s)])), Return(AVar(r))])],
      [{ name: b"look", handing: { params: [Lent], answer: Owned } }],
    ),
    [{ params: [Lent], answer: Owned }],
  )
}

test "a handing says where the use is that first gave each parameter and made the answer owned" {
  let s = word(0);
  let q = word(1);
  let r = word(2);
  let k = word(3);
  let at = |v: Var, val: Val, from: Int, to: Int|
    Let({ var: v, val: val, at: span_between(from, to), unwind: [] });
  let got = group_handings(
    [
      def_of(b"f", [s, q], RWord, [
        at(r, call_of(b"look", [AVar(q)]), 10, 14),
        at(k, made_of(MList(2), [AVar(s), AVar(r)]), 20, 25),
        Return(AVar(k)),
      ]),
    ],
    Map::new().insert(b"m.look", { params: [Lent], answer: Owned }),
  );
  assert_eq(got.map(|x: Inferred| x.handing), [{ params: [Given, Lent], answer: Owned }]);
  assert_eq(got.map(|x: Inferred| x.why), [
    { params: [Some(span_between(20, 25)), None], answer: Some(span_between(20, 25)) },
  ])
}

test "a closure laid on this frame's stack only reads its captures, whatever its body does with them" {
  let s = word(0);
  let k = word(1);
  let r = int(2);
  let c = word(0);
  let x = int(1);
  let with_body = |answer: Rep, body: Block| {
    let f = def_of(b"f", [s], RInt, [
      bind(k, made_of(MClosure({ nth: 0, captures: 1, params: 1, stacked: true }), [AVar(s)])),
      bind(r, call_of(b"each", [AVar(k)])),
      Return(AVar(r)),
    ]);
    let lambda = {
      key: Named(b"m.f"),
      kind: Rooted,
      params: [c, x],
      conv: given_all([c, x], answer),
      answer_ty: TyCon({ name: b"T", args: [] }),
      body: body,
      lambdas: [],
      base: 0,
      members: [],
      links: no_links(),
      statics: [],
    };
    settled_with(
      [{ ..f, f: { ..f.f, lambdas: [Closure({ body: lambda, captures: 1, at: dummy_span() })] } }],
      [{ name: b"each", handing: { params: [Lent], answer: Owned } }],
    )
  };
  assert_eq(with_body(RInt, [Return(AInt(0))]), [{ params: [Lent], answer: Owned }]);
  // The body keeps its capture, which the closure's entry counts once more, so the owner still only
  // lends it.
  assert_eq(with_body(RWord, [Return(AVar(c))]), [{ params: [Lent], answer: Owned }])
}

test "a constructor made of the cells of the parameter a case matched gives it, as the ownership pass resets it" {
  // A list of strings: `Nil` the zero word, `Cons` a box of its head and its tail.
  let list = RSum({
    laid: {
      classes: [layout::P],
      cases: [
        { test: layout::WordIs({ at: 0, value: 0 }), payload: layout::Nullary },
        {
          test: layout::WordOutside({ at: 0, values: [0] }),
          payload: layout::Boxed({
            at: 0,
            stripped: false,
            skip: 0,
            laid: LWords([layout::P, layout::P]),
          }),
        },
      ],
    },
    cases: [b"m.Nil", b"m.Cons"],
  });
  let xs = of_type(0, b"m.L", list);
  let v = word(1);
  let t = of_type(2, b"m.L", list);
  let box = of_type(3, b"m.L", RWord);
  let n = of_type(4, b"m.L", list);
  let rebuilt = |names: List<Bytes>|
    def_of(b"cons", [xs, v], list, [
      Case({
        on: xs,
        test: TTag(names),
        arms: [
          {
            when: 0,
            body: [
              bind(t, Get({ of: xs, path: PCase({ case: 1, at: 1 }) })),
              bind(box, made_of(MCase({ case: 1, skip: 0, words: 2 }), [AVar(v), AVar(t)])),
              bind(n, Gathered({ parts: [AInt(1), AVar(box)] })),
              Return(AVar(n)),
            ],
          },
        ],
        rest: [Return(AZero(list))],
      }),
    ]);
  assert_eq(alone([rebuilt([b"m.Cons", b"m.Nil"])]), [{ params: [Given, Given], answer: Owned }]);
  assert_eq(reset_params(rebuilt([b"m.Cons", b"m.Nil"])).keys(), [0]);
  // Where the case knows it to hold another constructor its cells fit nothing, and it is lent.
  assert_eq(alone([rebuilt([b"m.Nil", b"m.Cons"])]), [{ params: [Lent, Given], answer: Owned }]);
  assert_eq(reset_params(rebuilt([b"m.Nil", b"m.Cons"])).keys(), []);
  // Settled first with no resets, it settles where settling from every reset does.
  let from_every = |l: Lending| handings(settled_from([l], Map::new(), [reset_params(l)]));
  assert_eq(alone([rebuilt([b"m.Cons", b"m.Nil"])]), from_every(rebuilt([b"m.Cons", b"m.Nil"])));
  assert_eq(alone([rebuilt([b"m.Nil", b"m.Cons"])]), from_every(rebuilt([b"m.Nil", b"m.Cons"])))
}

test "a jump back to the start keeps a parameter lent while it hands on only what it is lent" {
  let p = word(0);
  let q = word(1);
  let n = int(2);
  let stop = flag(3);
  let m = int(4);
  let x = word(5);
  let go = |before: Block, args: List<Arg>|
    alone([
      def_of(b"go", [p, q, n], RInt, [
        bind(stop, Prim({ op: b"le", on: RInt, args: [AVar(n), AInt(0)] })),
        If({
          cond: AVar(stop),
          then: [Return(AInt(0))],
          otherwise: before.concat([
            bind(m, Prim({ op: b"sub", on: RInt, args: [AVar(n), AInt(1)] })),
            Restart(args.push(AVar(m))),
          ]),
        }),
      ]),
    ]);
  let lends = [{ params: [Lent, Lent, Lent], answer: Owned }];
  assert_eq(go([], [AVar(p), AVar(q)]), lends);
  assert_eq(go([], [AVar(q), AVar(p)]), lends);
  assert_eq(
    go([bind(x, Get({ of: p, path: PField({ name: b"rest", at: 1 }) }))], [AVar(x), AVar(q)]),
    lends,
  );
  assert_eq(go([bind(x, call_of(b"fresh", []))], [AVar(x), AVar(q)]), [
    { params: [Given, Lent, Lent], answer: Owned },
  ])
}

test "a record lent by reference stays lent across a jump only where the jump hands on a record lent so" {
  let b = word(2);
  let n = int(3);
  let stop = flag(4);
  let m = int(5);
  // Handed on swapped, read through a block it is lent, and read so with the other handed on.
  let jumps = |wide: Rep| {
    let w = of_type(0, b"m.W", wide);
    let v = of_type(1, b"m.W", wide);
    let x = of_type(6, b"m.W", wide);
    let go = |before: Block, args: List<Arg>|
      match alone([
          def_of(b"go", [w, v, b, n], RInt, [
            bind(stop, Prim({ op: b"le", on: RInt, args: [AVar(n), AInt(0)] })),
            If({
              cond: AVar(stop),
              then: [Return(AInt(0))],
              otherwise: before.concat([
                bind(m, Prim({ op: b"sub", on: RInt, args: [AVar(n), AInt(1)] })),
                Restart(args.concat([AVar(b), AVar(m)])),
              ]),
            }),
          ]),
        ]).at(
          0,
        ) {
        Some(h) -> h.params,
        None -> [],
      };
    let read = [bind(x, Get({ of: b, path: PField({ name: b"w", at: 0 }) }))];
    [go([], [AVar(v), AVar(w)]), go(read, [AVar(x), AVar(v)]), go(read, [AVar(x), AVar(w)])]
  };
  // Read through a block it is lent, a record lies in that block, not in storage its caller lent
  // it, so the record it is jumped to is given; and one holding a count given is handed on given.
  let counted_fields = range(0, 5).map(|k: Int|
    { name: b"f".concat(ascii_of_int(k)), rep: if k == 0 { RWord } else { RInt } });
  assert_eq(jumps(RFlat(counted_fields)), [
    [Lent, Lent, Lent, Lent],
    [Given, Lent, Lent, Lent],
    [Given, Given, Lent, Lent],
  ]);
  // A record holding no count is pointed at all the same, but gives nothing up where it goes.
  let scalars = range(0, 5).map(|_: Int| layout::raw());
  let words = RSum({
    laid: {
      classes: scalars,
      cases: [
        { test: Always, payload: Inline({ offset: 0, laid: LWords(scalars), stripped: None }) },
      ],
    },
    cases: [b"m.W"],
  });
  assert_eq(jumps(words), [
    [Lent, Lent, Lent, Lent],
    [Given, Lent, Lent, Lent],
    [Given, Lent, Lent, Lent],
  ])
}

test "a group that hands a parameter around lends it, and gives it once any member keeps it" {
  let s = word(0);
  let y = int(1);
  let kept = word(2);
  let passing = |name: Bytes, to: Bytes, keeps: Bool|
    def_of(
      name,
      [s],
      RInt,
      (if keeps { [bind(kept, made_of(MList(1), [AVar(s)]))] } else { [] }).concat([
        bind(y, call_of(to, [AVar(s)])),
        Return(AVar(y)),
      ]),
    );
  let lends = { params: [Lent], answer: Owned };
  let gives = { params: [Given], answer: Owned };
  assert_eq(alone([passing(b"ping", b"pong", false), passing(b"pong", b"ping", false)]), [
    lends,
    lends,
  ]);
  assert_eq(alone([passing(b"ping", b"pong", false), passing(b"pong", b"ping", true)]), [
    gives,
    gives,
  ]);
  // Kept two calls on, the keeping reaches the first member only once the round that follows it.
  assert_eq(
    alone([
      passing(b"one", b"two", false),
      passing(b"two", b"three", false),
      passing(b"three", b"one", true),
    ]),
    [gives, gives, gives],
  )
}

test "a tail group's member handed a value another member made is given it, and so is what it hands on" {
  let s = word(0);
  let n = int(1);
  let stop = flag(2);
  let m = int(3);
  let fresh = word(4);
  let member = |name: Bytes, to: Int, makes: Bool|
    {
      ..def_of(name, [s, n], RInt, [bind(stop, Prim({ op: b"le", on: RInt, args: [AVar(n), AInt(0)] })), If({ cond: AVar(stop), then: [Return(AInt(0))], otherwise: (if makes { [bind(fresh, call_of(b"fresh", []))] } else { [] }).concat([bind(m, Prim({ op: b"sub", on: RInt, args: [AVar(n), AInt(1)] })), Enter({ member: to, args: [if makes { AVar(fresh) } else { AVar(s) }, AVar(m)] })]) })]),
      group: [b"m.hop", b"m.skip"],
    };
  let lends = { params: [Lent, Lent], answer: Owned };
  let gives = { params: [Given, Lent], answer: Owned };
  assert_eq(alone([member(b"hop", 1, false), member(b"skip", 0, false)]), [lends, lends]);
  assert_eq(alone([member(b"hop", 1, false), member(b"skip", 0, true)]), [gives, gives])
}

test "every recursion group is settled after the groups it calls" {
  let s = word(0);
  let r = word(1);
  let keeps = def_of(b"keeps", [s], RWord, [
    bind(r, made_of(MList(1), [AVar(s)])),
    Return(AVar(r)),
  ]);
  let hands = def_of(b"hands", [s], RWord, [
    bind(r, call_of(b"keeps", [AVar(s)])),
    Return(AVar(r)),
  ]);
  let handed = handings_of([hands, keeps], Map::new()).handed;
  assert_eq(handed.get(b"m.hands"), Some({ params: [Given], answer: Owned }));
  assert_eq(handed.get(b"m.keeps"), Some({ params: [Given], answer: Owned }))
}

test "a parameter its declaration lends stays lent, and one it keeps is inferred" {
  let f = word(0);
  let r = word(1);
  let storing = def_of(b"f", [f], RWord, [bind(r, made_of(MList(1), [AVar(f)])), Return(AVar(r))]);
  assert_eq(alone([{ ..storing, lent: [0] }]), [{ params: [Lent], answer: Owned }]);
  assert_eq(alone([storing]), [{ params: [Given], answer: Owned }]);
  let reading = def_of(b"g", [f], RInt, [Return(AInt(0))]);
  assert_eq(alone([reading]), [{ params: [Lent], answer: Owned }])
}

test "an answer read out of what is lent is borrowed of it, and one made on any path is owned" {
  let p = word(0);
  let q = word(1);
  let c = flag(2);
  let x = word(3);
  let j = word(4);
  let m = word(5);
  assert_eq(
    alone([
      def_of(b"name", [p], RWord, [
        bind(x, Get({ of: p, path: PField({ name: b"name", at: 0 }) })),
        Return(AVar(x)),
      ]),
    ]),
    [{ params: [Lent], answer: Borrowed([{ param: 0, whole: false }]) }],
  );
  let pick = |otherwise: Block|
    def_of(b"pick", [p, q, c], RWord, [
      Decl(j),
      If({ cond: AVar(c), then: [Assign({ var: j, arg: AVar(p) })], otherwise: otherwise }),
      Return(AVar(j)),
    ]);
  assert_eq(alone([pick([Assign({ var: j, arg: AVar(q) })])]), [
    {
      params: [Lent, Lent, Lent],
      answer: Borrowed([{ param: 0, whole: true }, { param: 1, whole: true }]),
    },
  ]);
  assert_eq(alone([pick([bind(m, call_of(b"fresh", [])), Assign({ var: j, arg: AVar(m) })])]), [
    { params: [Given, Lent, Lent], answer: Owned },
  ]);
  // A word held again as an `Option`'s is borrowed of it, but not where a type variable leaves the
  // answer's type open: at `Int` the `Option` boxes the item afresh. Answered owned, it is given.
  let some = |item: Type| {
    let answer = TyCon({ name: b"Option", args: [item] });
    let o = { id: 6, ty: answer, rep: RWord };
    let l = def_of(b"some", [x], RWord, [
      bind(o, Gathered({ parts: [AInt(1), AVar(x)] })),
      Return(AVar(o)),
    ]);
    { ..l, f: { ..l.f, answer_ty: answer }, whole: { ..l.whole, answer_ty: answer } }
  };
  assert_eq([TyCon({ name: b"String", args: [] }), TyVar(0)].map(|t: Type| alone([some(t)])), [
    [{ params: [Lent], answer: Borrowed([{ param: 0, whole: true }]) }],
    [{ params: [Given], answer: Owned }],
  ])
}

test "an item read out of a lent list is borrowed, and a caller keeping it lends the list but gives what it answers whole" {
  let xs = word(0);
  let i = int(1);
  let x = word(2);
  let ys = word(3);
  let y = word(4);
  let kept = word(5);
  let read = Native({
    name: b"rt_list_at",
    args: [AVar(xs), AVar(i)],
    uses: { takes: [false, false], owned: false, fails: true, stops: false },
  });
  let item = { params: [Lent, Lent], answer: Borrowed([{ param: 0, whole: false }]) };
  assert_eq(alone([def_of(b"at", [xs, i], RWord, [bind(x, read), Return(AVar(x))])]), [item]);
  let keeping = |callee: Bytes, handing: Handing|
    settled_with(
      [
        def_of(b"keep", [ys], RWord, [
          bind(y, call_of(callee, [AVar(ys), AInt(0)])),
          bind(kept, made_of(MList(1), [AVar(y)])),
          Return(AVar(kept)),
        ]),
      ],
      [{ name: callee, handing: handing }],
    );
  assert_eq(keeping(b"at", item), [{ params: [Lent], answer: Owned }]);
  assert_eq(
    keeping(b"same", { params: [Lent, Lent], answer: Borrowed([{ param: 0, whole: true }]) }),
    [{ params: [Given], answer: Owned }],
  )
}

test "a root written for a type lends what it reads, and a drop takes its operand" {
  let p = word(0);
  let q = word(1);
  let same = flag(2);
  let written = |op: TypeOp, args: List<Arg>|
    Call({
      callee: Root(
        Written({ op: op, ty: TyCon({ name: b"m.T", args: [] }), home: b"m", marks: [] }),
      ),
      args: args,
      conv: {
        params: args.map(|_: Arg| Given),
        reps: args.map(rep_of_arg),
        answer: RWord,
        answered: Owned,
      },
      stops: false,
    });
  assert_eq(
    alone([
      def_of(b"same", [p, q], RBool, [
        bind(same, written(Equal, [AVar(p), AVar(q)])),
        Return(AVar(same)),
      ]),
    ]),
    [{ params: [Lent, Lent], answer: Owned }],
  );
  assert_eq(
    alone([
      def_of(b"gone", [p], RInt, [
        Do({ val: written(Drop, [AVar(p)]), at: dummy_span(), unwind: [] }),
        Return(AInt(0)),
      ]),
    ]),
    [{ params: [Given], answer: Owned }],
  );
  // A lowering's loops read the list they walk; a lifting's take what they read onto.
  assert_eq(
    [
      Lower,
      Lift,
      Contained(b"lower_items"),
      Contained(b"lower_entries"),
      Contained(b"lift_items"),
      Contained(b"lift_entries"),
    ].map(|op: TypeOp| written_handing(op, 2).params),
    [[Lent, Lent], [Given, Given], [Lent, Lent], [Lent, Lent], [Given, Given], [Given, Given]],
  );
  // A walk reads the containers it compares, and a gathering walk the one it walks, not the list it
  // gathers onto, which it starts again with grown.
  assert_eq(
    [Contained(b"equal_from"), Contained(b"digest_from")].map(|op: TypeOp|
      written_handing(op, 3).params),
    [[Lent, Lent, Lent], [Lent, Given, Lent]],
  )
}

test "a handing reads as its parameters and then how it answers" {
  assert_eq(
    handing_said({
      params: [Lent, Given],
      answer: Borrowed([{ param: 0, whole: true }, { param: 2, whole: false }]),
    }),
    b"[lent, given] borrowed(0, 2 part)",
  );
  assert_eq(handing_said(taking_all(0)), b"[] owned")
}

/// The convention of each call `b` makes at its top, in order.
fn calls_written(b: Block) -> List<Convention> =
  b.fold([], |acc: List<Convention>, i: Inst|
    match i { Let(l) -> match l.val { Call(c) -> acc.push(c.conv), _ -> acc }, _ -> acc })

test "a body is written against its own handing and each callee's, a callee nothing infers taking all" {
  let s = word(0);
  let r = word(1);
  let q = word(2);
  let f = def_of(b"f", [s], RWord, [
    bind(r, call_of(b"look", [AVar(s)])),
    bind(q, call_of(b"other", [AVar(r)])),
    Return(AVar(q)),
  ]).f;
  let read = { params: [Lent], answer: Borrowed([{ param: 0, whole: false }]) };
  let handed = Map::new().insert(b"m.f", { params: [Lent], answer: Owned }).insert(b"m.look", read);
  let written = conventions(f, handed);
  assert_eq(written.conv.params, [Lent]);
  assert_eq(
    calls_written(written.body).map(|c: Convention| { params: c.params, answer: c.answered }),
    [read, taking_all(1)],
  );
  let said = handle {
    conventions(f, handed.insert(b"m.look", taking_all(2)));
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert_eq(said, b"a handing of 2 parameters for a convention of 1: m.look");
  // A specialisation is written as the definition it specialises, a root written for a type as its
  // fixed handing.
  let at = { ..f, key: At({ def: b"m.f", args: [], lent: [] }) };
  assert_eq(conventions(at, handed).conv.params, [Lent]);
  // Where a specialisation holds a scalar, what its definition answers borrowed of it is owned.
  let borrowing = handed.insert(b"m.f", read);
  let scalar = { ..at, params: [int(0)], conv: { ..at.conv, reps: [RInt], answer: RInt } };
  assert_eq(
    [conventions(at, borrowing).conv.answered, conventions(scalar, borrowing).conv.answered],
    [read.answer, Owned],
  );
  let for_type = |op: TypeOp|
    conventions(
      {
        ..f,
        key: Written({ op: op, ty: TyCon({ name: b"m.T", args: [] }), home: b"m", marks: [] }),
      },
      handed,
    ).conv.params;
  assert_eq([for_type(Equal), for_type(Drop)], [[Lent], [Given]]);
  // A closure's generic call is numbered among its root's, which the closure's own links hold none of.
  let generic = match call_of(b"look", [AVar(s)]) {
    Call(c) -> Call({ ..c, callee: Generic(0) }),
    other -> other,
  };
  let closure = {
    ..f,
    key: Named(b"m.f"),
    body: [bind(r, generic), Return(AVar(r))],
    links: no_links(),
  };
  let rooted = {
    ..f,
    lambdas: [Closure({ body: closure, captures: 0, at: dummy_span() })],
    links: { ..no_links(), generics: [{ callee: b"m.look", args: [], carried: [], fns: [] }] },
  };
  match conventions(rooted, handed).lambdas {
    [Closure(c)] ->
      assert_eq(
        calls_written(c.body.body).map(|x: Convention| { params: x.params, answer: x.answered }),
        [read],
      ),
    _ -> assert(false, None),
  }
}

test "only a definition's own form is read, each lending what its declaration lends" {
  let s = word(0);
  let f = def_of(b"f", [s], RWord, [Return(AVar(s))]).f;
  let typed = TyCon({ name: b"m.T", args: [] });
  let forms = [
    f,
    { ..f, key: At({ def: b"m.f", args: [], lent: [] }) },
    { ..f, key: Written({ op: Equal, ty: typed, home: b"m", marks: [] }) },
  ];
  assert_eq(
    lendings_of(Map::new().insert(b"m.f", [0]), forms).map(|l: Lending|
      { def: l.def, lent: l.lent }),
    [{ def: b"m.f", lent: [0] }],
  )
}
