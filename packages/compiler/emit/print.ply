pub fn printed_function(f: Function, constructors: Constructors) -> PrintOutput / {abort.raise} = {
  let name = own_symbol(None);
  let own = if f.members.len() == 0 { root_printed(name, f, constructors) }
  else { group_printed(name, f, constructors) };
  let closures = range(0, f.lambdas.len()).fold(
    { printing: own.printing, out: [] },
    |accumulator: { printing: Printing, out: List<Piece> }, k: Int|
      match f.lambdas.at(k) {
        Some(l) -> {
          let t = lambda_text(name, k, l, closure_printed(name, k, l, accumulator.printing));
          { printing: t.printing, out: accumulator.out.concat(t.out) }
        },
        None -> accumulator,
      },
  );
  let tables = closures.printing;
  let declared = Bytes::concat_all(
    range(0, f.lambdas.len()).map(|k: Int| typed_declared(name, k, f.lambdas.get(k))),
  );
  {
    pieces: merged(
      [Text(declared)].concat(each_functions_printed(name, tables)).concat(own.out).concat(
        closures.out,
      ),
    ),
    calls: tables.calls,
    fields: tables.fields,
    lambdas: tables.lambdas,
    performs: tables.performs,
    handles: tables.handles,
    expects: tables.expects,
    shared: tables.shared,
    natives: tables.natives,
  }
}

fn root_printed(
  name: Bytes,
  f: Function,
  constructors: Constructors,
) -> { printing: Printing, out: List<Piece> } / {abort.raise} = {
  let sited = match definition_of(f.key) {
    Some(d) -> if is_marshalling_function(d) { Some(FromCaller) } else { None },
    None -> None,
  };
  let scheduling = match definition_of(f.key) { Some(d) -> enters_scheduler(d), None -> false };
  let own = if scheduling { name.concat(b"_scheduling") } else { name };
  let body = body_printed(name, f, sited, {
    ..empty_printing(param_names(f)),
    constructors: constructors,
    count_root_type: counted_here(f.key),
  });
  let entered = if !has_entry(f.key, declared_arity(f.params), constructors.stated) {
    { printing: body, out: [] }
  } else { runtime_entry(body, name, entry_signature_of(f)) };
  let opening = match f.kind {
    Metered -> if needs_stack_check(f) { head_probe(f.convention.result) } else { b"" },
    Plain -> if !is_drop_root(f.key) { b"" }
    else { Bytes::concat_all([b"  if (ply_drop_deep(ctx, p0, ", name, b")) return 0;\n"]) },
  };
  {
    printing: entered.printing,
    out: [
      Text(
        Bytes::concat_all([
          if entered.out.len() == 0 { b"" }
          else { Bytes::concat_all([b"Word ", name, b"_entry(PlyCtx *ctx, const Word *args);\n"]) },
          if scheduling { b"static " } else { b"" },
          c_declaration(own, f),
          b" {\n",
          opening,
        ]),
      ),
    ].concat(
      body.out,
    ).push(
      Text(b"}\n"),
    ).concat(if scheduling { [Text(scheduler_entry(name, own, f))] } else { [] }).concat(
      entered.out,
    ),
  }
}

fn enters_scheduler(d: Bytes) -> Bool =
  is_marshalling_function(d) || d == scheduler_module.concat(b".simulated")
    || d == scheduler_module.concat(b".scheduled")
    || d == scheduler_module.concat(b".clocked")

fn scheduler_entry(name: Bytes, own: Bytes, f: Function) -> Bytes =
  Bytes::concat_all([
    c_declaration(name, f),
    b" {\n  Word was = rt_scheduler_entered_p(ctx);\n  ",
    signature_types(f.convention).result,
    b" r = ",
    own,
    b"(ctx",
    Bytes::concat_all(signature_names(f.convention).map(|p: Bytes| b", ".concat(p))),
    b");\n  rt_scheduler_left_p(ctx, was);\n  return r;\n}\n",
  ])

fn group_printed(
  name: Bytes,
  f: Function,
  constructors: Constructors,
) -> { printing: Printing, out: List<Piece> } / {abort.raise} = {
  let g = name.concat(b"_group");
  let width = f.members.fold(0, |w: Int, m: Member|
    if m.params.len() > w { m.params.len() } else { w });
  let words = range(0, width).map(|i: Int| b"p".concat(ascii_of_int(i)));
  let u = {
    symbol: name,
    base: f.base,
    result: f.convention.result,
    site: None,
    arm: None,
    looping: None,
    handler_jump: None,
    group: None,
    unwinds: [],
    epilogue: b"",
  };
  let start = {
    ..empty_printing(match f.params.at(0) { Some(which) -> Map::new().insert(which.id, b"which"), None -> Map::new() }),
    constructors: constructors,
  };
  let switched = match f.body {
    [Case(c)] -> {
      let arms = c.arms.fold(start, |printing: Printing, a: { when: Int, body: Block }|
        match f.members.at(a.when) {
          None ->
            unsupported(
              b"a `case` arm refers to a function that is not in its merged function group",
              Bytes::concat_all([
                b"arm ",
                ascii_of_int(a.when),
                b" of ",
                ascii_of_int(f.members.len()),
                b" members",
              ]),
            ),
          Some(m) -> {
            let armed = {
              ..u,
              base: m.base,
              site: Some(InGroup(a.when)),
              group: Some({ at: a.when, members: f.members, width: width }),
            };
            let opened = range(0, m.params.len()).fold(
              block_opened(
                line(printing, 0, Bytes::concat_all([b"case ", ascii_of_int(a.when), b": {"])),
              ),
              |q: Printing, j: Int| {
                let v = m.params.get(j);
                let word = b"p".concat(ascii_of_int(j));
                if passing(v.representation) == ByReference { member_opened(q, 1, v, word) } else {
                  match v.representation {
                    AsWord -> { ..q, names: q.names.insert(v.id, word) },
                    AsFlattened(_) -> unpacked_from_word(q, v, word),
                    AsSum(_) -> unpacked_from_word(q, v, word),
                    AsUnit -> q,
                    _ ->
                      assigned(q, 1, v, c_type(v.representation), word_as(word, v.representation)),
                  }
                }
              },
            );
            line(
              block_closed(
                printed(armed, opened, a.body, 1),
                printing.block,
                1,
                falls_through(a.body),
              ),
              0,
              b"}",
            )
          },
        });
      block_closed(
        printed(u, line(arms, 0, b"}"), c.rest, 0),
        start.block,
        0,
        falls_through(c.rest),
      )
    },
    body ->
      unsupported(
        b"the body of a merged function group must be a single `case` that selects which function to run",
        Bytes::concat_all([ascii_of_int(body.len()), b" instructions"]),
      ),
  };
  let wrappers = range(0, f.members.len()).fold(
    { printing: switched, out: [] },
    |accumulator: { printing: Printing, out: List<Piece> }, i: Int| {
      let w = group_wrapper(name, f, i, accumulator.printing);
      { printing: w.printing, out: accumulator.out.concat(w.out) }
    },
  );
  {
    printing: wrappers.printing,
    out: [
      Text(
        Bytes::concat_all([
          b"static Word ",
          g,
          b"(PlyCtx *ctx, int which",
          Bytes::concat_all(words.map(|w: Bytes| b", Word ".concat(w))),
          b") {\n",
          Bytes::concat_all(group_buffers(f).map(|d: Bytes| Bytes::concat_all([b"  ", d, b"\n"]))),
          record_declared(switched),
          b"  ply_loop: ",
          probe(f.convention.result),
          b"\n  switch (which) {\n",
        ]),
      ),
    ].concat(
      switched.out,
    ).push(
      Text(b"}\n"),
    ).concat(
      wrappers.out,
    ),
  }
}

fn moved_to_destination(
  printing: Printing,
  a: Arg,
) -> { printing: Printing, text: Bytes } / {abort.raise} =
  match a {
    VariableOperand(x) -> if !printing.placing.destination_passing
        || printing.placing.results.contains(x.id) { { printing: printing, text: b"" } } else {
      match known_layout(printing.constructors, x.ty) {
        Some(l) -> {
          let moved = write_inline(
            printing,
            b"*(Word *)d",
            b"ply_words(d)",
            name_of(printing, x),
            l,
          );
          {
            printing: moved.printing,
            text: Bytes::concat_all([b"  if (d) { ", moved.text, b" return d; }\n"]),
          }
        },
        None -> { printing: printing, text: b"" },
      }
    },
    _ -> { printing: printing, text: b"" },
  }

fn unpacked_from_word(printing: Printing, v: Variable, word: Bytes) -> Printing = {
  let n = named(printing, v);
  pieces(
    n.printing,
    [Text(pad(1))].concat(
      word_to_parts(word, v.representation, part_names(n.name, v.representation)),
    ).push(
      Text(b"\n"),
    ),
  )
}

fn is_drop_root(k: RootKey) -> Bool =
  match k {
    Generated(w, _) -> match w.operation {
      keys::Drop -> true,
      keys::OnCase(c) -> c.operation == keys::Drop,
      _ -> false,
    },
    _ -> false,
  }

fn counted_here(k: RootKey) -> Option<Type> =
  match k {
    Generated(w, _) -> match w.operation { keys::Unboxed(_) -> Some(w.ty), _ -> None },
    _ -> None,
  }

fn return_epilogue(f: Function) -> Bytes =
  match f.kind { Plain -> if is_drop_root(f.key) { b"ply_drop_done(ctx);" } else { b"" }, _ -> b"" }

fn param_names(f: Function) -> Map<Int, Bytes> / {abort.raise} =
  range(0, f.params.len()).fold(Map::new(), |m: Map<Int, Bytes>, i: Int|
    m.insert(f.params.get(i).id, b"p".concat(ascii_of_int(i))))

fn closure_printed(
  symbol: Bytes,
  nth: Int,
  l: Lambda,
  printing: Printing,
) -> Printing / {abort.raise} =
  match l {
    Closure(c) -> body_printed(symbol, c.body, None, function_body(printing, lambda_names(l, nth))),
  }

fn body_printed(
  symbol: Bytes,
  f: Function,
  sited: Option<FailureOwner>,
  given: Printing,
) -> Printing / {abort.raise} = {
  let with_caller_site = if sited == Some(FromCaller) {
    line(
      given,
      0,
      b"const int64_t ply_called[3] = { ctx->site_root, ctx->site_start, ctx->site_end };",
    )
  } else { given };
  let printing = { ..with_caller_site, placing: destinations_of(f) };
  let u = {
    symbol: symbol,
    base: f.base,
    result: f.convention.result,
    site: sited,
    arm: None,
    looping: None,
    handler_jump: match f.links.pending { Some(_) -> Some(b"goto ply_pending;"), None -> None },
    group: None,
    unwinds: [],
    epilogue: return_epilogue(f),
  };
  let opened = params_opened(
    f.params.map(|v: Variable| name_of(printing, v)),
    reps_of(f.convention),
  ).fold(printing, |q: Printing, l: Bytes| line(q, 0, l));
  let viewed = declare_list_views(f, opened);
  let probed = match f.kind { Metered -> probe(f.convention.result), _ -> b";" };
  let looped = if restarts(f.body) {
    text(viewed, Bytes::concat_all([b"  ply_loop: ", probed, b"\n"]))
  } else { viewed };
  let body = block_closed(printed(u, looped, f.body, 0), printing.block, 0, falls_through(f.body));
  let closed = match f.links.pending {
    None -> body,
    Some(pd) ->
      text(
        body,
        Bytes::concat_all([
          b"  ply_pending: ply_pending_raised(ctx, ",
          name_of(body, pd.word),
          b", ",
          ascii_of_int(pd.index),
          b", (Word)(intptr_t)&",
          pd.operation,
          b", (Word)(intptr_t)&",
          pd.string,
          b");\n  ",
          failing_return(f.convention.result),
          b"\n",
        ]),
      ),
  };
  let done = { ..closed, placing: given.placing };
  let record = record_declared(done);
  if record.len() == 0 { done } else { { ..done, out: [Text(record)].concat(done.out) } }
}

fn declare_list_views(f: Function, printing: Printing) -> Printing =
  range(0, f.params.len()).fold(printing, |q: Printing, i: Int|
    match f.params.at(i) {
      Some(v) -> if v.representation != AsListView || param_rep(f.convention, i) != Some(AsWord) {
        q
      } else {
        let word = name_of(q, v);
        line(
          q,
          0,
          Bytes::concat_all([
            b"Word ",
            part_name(word, 0),
            b" = ",
            word,
            b"; int64_t ",
            part_name(word, 1),
            b" = 0;",
          ]),
        )
      },
      None -> q,
    })

fn restarts(b: Block) -> Bool =
  any_instruction(b, |i: Instruction| match i { Restart(_) -> true, _ -> false })

fn needs_stack_check(f: Function) -> Bool =
  !restarts(f.body) && (match f.key { Generated(_, _) -> true, _ -> calls_in(f.body) })

fn failure_target(u: BodyContext) -> Bytes =
  match u.handler_jump { Some(j) -> j, None -> failing_return(u.result) }

fn exiting(
  p: InstructionContext,
  printing: Printing,
  unwind: List<Variable>,
  into: Option<Variable>,
  value: Rvalue,
) -> Printing / {abort.raise} = {
  let x = failure_exit_through(printing, p.u.unwinds, unwind, failure_target(p.u));
  let l = site_linked({ ..p, exit_statement: x.leave }, x.printing, unwind, value);
  let after = unlinked(
    value_printed({ ..p, exit_statement: l.leave }, l.printing, into, value),
    p.depth,
    l,
  );
  if x.printing.tails.all.len() == printing.tails.all.len()
      || range(printing.out.len(), after.out.len()).any(|i: Int|
        match after.out.at(i) { Some(Text(t)) -> t.index_of(x.leave) != None, _ -> false }) {
    after
  } else { { ..after, tails: printing.tails } }
}

type BlockState = { printing: Printing, context: BodyContext, outer: List<BodyContext> }

fn with_cleanup_scope(s: BlockState, unwindings: Option<List<Unwinding>>) -> BlockState =
  match unwindings {
    Some(xs) -> {
      let id = |x: Unwinding| match operand_variable(x.arg) { Some(v) -> v.id, None -> -1 };
      let ids = xs.map(id);
      let around = s.context.unwinds.filter(|x: Unwinding| !ids.contains(id(x)));
      { ..s, context: { ..s.context, unwinds: xs.concat(around) }, outer: s.outer.push(s.context) }
    },
    None -> match s.outer.at(s.outer.len() - 1) {
      Some(o) -> { ..s, context: o, outer: s.outer.take(s.outer.len() - 1) },
      None -> s,
    },
  }

fn with_site_scope(s: BlockState, borrowed: Option<SiteOrigin>) -> BlockState =
  match borrowed {
    Some(l) ->
      {
        ..s,
        context: { ..s.context, site: Some(LambdaOwner(l.root)), base: l.base },
        outer: s.outer.push(s.context),
      },
    None -> match s.outer.at(s.outer.len() - 1) {
      Some(o) -> { ..s, context: o, outer: s.outer.take(s.outer.len() - 1) },
      None -> s,
    },
  }

fn printed(
  home: BodyContext,
  printing: Printing,
  b: Block,
  depth: Int,
) -> Printing / {abort.raise} =
  b.fold(
    { printing: printing, context: home, outer: [] },
    |sites: BlockState, i: Instruction| {
      let u = sites.context;
      let accumulator = sites.printing;
      let p = { u: u, at: span_between(0, 0), exit_statement: failure_target(u), depth: depth };
      let inner = depth + 1;
      match i {
        SiteScope(borrowed) -> with_site_scope(sites, borrowed),
        CleanupScope(cleanup_scope) -> with_cleanup_scope(sites, cleanup_scope),
        _ ->
          {
            ..sites,
            printing: match i {
              Let(l) -> exiting({ ..p, at: l.at }, accumulator, l.unwind, Some(l.var), l.value),
              Do(d) -> exiting({ ..p, at: d.at }, accumulator, d.unwind, None, d.value),
              Declaration(v) -> join_declared(accumulator, depth, v),
              Assign(s) -> set_parts(accumulator, depth, s.var, s.arg),
              If(x) -> {
                let opened = line(
                  accumulator,
                  depth,
                  Bytes::concat_all([b"if (", arg_text(accumulator, x.cond), b") {"]),
                );
                let t = block_closed(
                  printed(u, block_opened(opened), x.then, inner),
                  accumulator.block,
                  inner,
                  falls_through(x.then),
                );
                let e = block_closed(
                  printed(u, block_opened(line(t, depth, b"} else {")), x.otherwise, inner),
                  accumulator.block,
                  inner,
                  falls_through(x.otherwise),
                );
                line(e, depth, b"}")
              },
              Case(c) -> {
                let arms = c.arms.fold(
                  case_opened(p, accumulator, c.on, c.test),
                  |q: Printing, a: { when: Int, body: Block }|
                    case_arm_closed(
                      p,
                      block_closed(
                        printed(
                          u,
                          block_opened(case_arm(p, q, c.on, c.test, a.when)),
                          a.body,
                          inner,
                        ),
                        accumulator.block,
                        inner,
                        falls_through(a.body),
                      ),
                    ),
                );
                case_closed(
                  p,
                  block_closed(
                    printed(u, block_opened(case_rest(p, arms, c.on, c.test)), c.rest, inner),
                    accumulator.block,
                    inner,
                    falls_through(c.rest),
                  ),
                )
              },
              Match(m) -> {
                let l = label(accumulator);
                let arms = m.arms.fold(
                  { printing: match_opened(p, l.printing, l.n, m.arms.len()), at: 0 },
                  |q: { printing: Printing, at: Int }, a: Block| {
                    let armed = printed(
                      { ..u, arm: Some({ label: l.n, at: q.at }) },
                      match_arm(p, q.printing, l.n, q.at),
                      a,
                      depth,
                    );
                    {
                      printing: if falls_through(a) { match_arm_closed(p, armed, l.n, q.at) }
                      else { armed },
                      at: q.at + 1,
                    }
                  },
                );
                match_closed(
                  p,
                  printed(u, match_rest(p, arms.printing, l.n, m.arms.len()), m.rest, depth),
                  l.n,
                )
              },
              Miss -> match u.arm {
                Some(a) -> next_arm_jump(p, accumulator, a.label, a.at),
                None -> unsupported(b"a failed pattern test outside a match", b"Miss"),
              },
              Fail(x) -> {
                let out = failure_exit_through(
                  accumulator,
                  x.resource,
                  x.unwind,
                  failure_target(u),
                );
                failed({ ..p, at: x.at, exit_statement: out.leave }, out.printing, x.reason)
              },
              Loop(lp) -> {
                let l = label(accumulator);
                let looped = {
                  ..u,
                  looping: Some({
                    label: l.n,
                    state: carried_variables(lp.state),
                    result: lp.result,
                  }),
                };
                loop_closed(
                  p,
                  block_closed(
                    printed(
                      looped,
                      block_opened(loop_opened(p, l.printing, l.n, lp.state, lp.result)),
                      lp.body,
                      inner,
                    ),
                    accumulator.block,
                    inner,
                    falls_through(lp.body),
                  ),
                  l.n,
                  lp.result,
                )
              },
              Next(args) -> match u.looping {
                Some(lp) -> next(p, accumulator, lp.label, lp.state, args),
                None ->
                  unsupported(
                    b"a jump to the next loop iteration outside a loop",
                    Bytes::concat_all([b"Next of ", ascii_of_int(args.len()), b" values"]),
                  ),
              },
              Done(a) -> match u.looping {
                Some(lp) -> loop_done(p, accumulator, lp.label, lp.result, a),
                None -> unsupported(b"a loop's final value returned outside a loop", b"Done"),
              },
              Return(a) -> match u.group {
                Some(_) -> member_returned(p, accumulator, a),
                None -> {
                  let r = write_return_value(accumulator, depth, a);
                  let leaving = if u.epilogue == b"" { b"" }
                  else { Bytes::concat_all([b"  ", u.epilogue, b"\n"]) };
                  let moved = moved_to_destination(r.printing, a);
                  text(
                    moved.printing,
                    Bytes::concat_all([leaving, moved.text, b"  return ", r.value, b";\n"]),
                  )
                },
              },
              Restart(args) -> match u.group {
                Some(g) -> entered_member(p, accumulator, g.at, args),
                None -> restarted(p, accumulator, args),
              },
              Jump(e) -> entered_member(p, accumulator, e.member, e.args),
              Handle(h) -> {
                let l = label(accumulator);
                let x = failure_exit_through(l.printing, u.unwinds, h.unwind, failure_target(u));
                let f = handle_linked(
                  { ..p, exit_statement: x.leave },
                  x.printing,
                  l.n,
                  h.body,
                  h.site,
                  h.unwind,
                );
                let hp = { ..p, exit_statement: f.leave };
                let inside = { ..u, handler_jump: Some(landing_jump(l.n)), unwinds: [] };
                let opened = handle_opened(hp, f.printing, l.n, h.args, h.uses, h.site, h.result);
                unlinked(
                  handle_closed(
                    hp,
                    if h.site.detached != None { printed(inside, opened, h.body, inner) } else {
                      block_closed(
                        printed(inside, block_opened(opened), h.body, inner),
                        accumulator.block,
                        inner,
                        falls_through(h.body),
                      )
                    },
                    l.n,
                    h.args,
                    h.site,
                    h.result,
                  ),
                  depth,
                  f,
                )
              },
              Increment(_) -> count_printed(p, accumulator, i),
              Decrement(_) -> count_printed(p, accumulator, i),
              Reset(_) -> count_printed(p, accumulator, i),
              Free(_) -> count_printed(p, accumulator, i),
              Destructure(_) -> count_printed(p, accumulator, i),
              SiteScope(_) -> accumulator,
              CleanupScope(_) -> accumulator,
            },
          },
      }
    },
  ).printing

fn value_printed(
  p: InstructionContext,
  printing: Printing,
  into: Option<Variable>,
  value: Rvalue,
) -> Printing / {abort.raise} =
  match value {
    Primitive(x) -> primitive(p, printing, into, x),
    Literal(l) -> literal(p, printing, into, l),
    Static(n) -> static_word(p, printing, into, n),
    Allocate(m) -> match base_allocation(m.made) {
      ClosureAllocation(_) -> closure_made(p, printing, into, m),
      ListAllocation(_) -> list_printed(p, printing, into, m),
      _ -> value_printing(p, printing, into, m),
    },
    Get(g) -> match g.path {
      CapturePath(i) -> capture_printed(p, printing, into, g.of, i),
      _ -> get_printed(p, printing, into, g),
    },
    Take(t) -> taken(p, printing, into, t),
    Tag(name) -> tagged(p, printing, into, name),
    Convert(k) -> representation_converted(p, printing, into, k),
    Aggregate(g) -> build_value(p, printing, into, g.parts),
    Update(u) -> updated(p, printing, into, u),
    Call(c) -> call(p, printing, into, c),
    Apply(c) -> applied(p, printing, into, c),
    Native(n) -> native(p, printing, into, n),
    OperationCall(o) -> match o.operation {
      OfHandling(h) -> effect_operation(p, printing, into, h, o.args, o.uses),
      OfContainers(x) -> container_operation(p, printing, into, x, o.args, o.uses),
      OfCalling(x) -> calling_operation(p, printing, into, x, o.args, o.uses),
      OfStrings(x) -> string_operation(p, printing, into, x, o.args),
    },
    IfUnique(v) -> last_of(p, printing, into, v),
    WalkLoop(w) -> walk_value(p, printing, into, w.of, w.operation),
    OperandsOnly(_) ->
      unsupported(
        b"an operation that can only be computed once the function is copied for a specific caller",
        b"a function body where each caller chooses a different operation",
      ),
  }

fn taken(
  p: InstructionContext,
  printing: Printing,
  into: Option<Variable>,
  t: { of: Variable, path: Path },
) -> Printing / {abort.raise} =
  match into {
    None -> unsupported(b"a field is read but its value is never used", variable_text(t.of)),
    Some(v) -> match match ((t.of.representation, t.path)) {
        (AsSum(s), CasePath(c)) -> inline_word_at(s.layout, c.case, c.at),
        _ -> None,
      } {
      Some(w) -> {
        let name = name_of(printing, t.of);
        let word = match part_names(name, t.of.representation).at(w) { Some(x) -> x, None -> name };
        let n = named(printing, v);
        line(
          line(
            n.printing,
            p.depth,
            Bytes::concat_all([c_type(v.representation), b" ", n.name, b" = ", word, b";"]),
          ),
          p.depth,
          word.concat(b" = 0;"),
        )
      },
      None -> match t.path {
        InlineRecordPath(at) -> taken_from_inline_record(p, printing, v, t.of, at),
        _ -> taken_from_block(p, printing, v, t),
      },
    },
  }

fn taken_from_inline_record(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  of: Variable,
  at: Int,
) -> Printing / {abort.raise} =
  match known_layout(printing.constructors, v.ty) {
    Some(l) -> {
      let m = words(l);
      let block = name_of(printing, of);
      let n = named(printing, v);
      let place = Bytes::concat_all([b"&", slot(block, at + 1)]);
      let bytes = int_literal(8 * m);
      let counted = layout_retain_at(
        n.printing,
        l,
        Bytes::concat_all([b"ply_words(", n.name, b")"]),
      );
      line(
        counted.printing,
        p.depth,
        Bytes::concat_all([
          b"Word ",
          n.name,
          b" = ply_alloc(ctx, ",
          int_literal(header_bytes + 8 * m),
          b"); memcpy(ply_words(",
          n.name,
          b"), ",
          place,
          b", ",
          bytes,
          b"); if (ply_obj(",
          block,
          b")->rc == 1) memset(",
          place,
          b", 0, ",
          bytes,
          b"); else { ",
          counted.text,
          b" }",
        ]),
      )
    },
    None ->
      unsupported(
        b"a record is read from a variable that has no known memory layout",
        variable_text(v),
      ),
  }

fn taken_from_block(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  t: { of: Variable, path: Path },
) -> Printing / {abort.raise} =
  match field_of(name_of(printing, t.of), t.of.representation, t.path) {
    None ->
      unsupported(
        b"a field is read from something that is neither a heap-allocated record nor a sum type case",
        variable_text(t.of),
      ),
    Some(at) -> {
      let n = named(printing, v);
      let read = line(
        n.printing,
        p.depth,
        Bytes::concat_all([c_type(v.representation), b" ", n.name, b" = ", at.field, b";"]),
      );
      let clear_if_unique = Bytes::concat_all([
        b"if (ply_obj(",
        at.block,
        b")->rc == 1) ",
        at.field,
        b" = 0; else",
      ]);
      line(
        count_printed(
          { ..p, depth: p.depth + 1 },
          line(read, p.depth, clear_if_unique.concat(b" {")),
          Increment({ var: v, n: 1 }),
        ),
        p.depth,
        b"}",
      )
    },
  }

fn field_of(name: Bytes, r: Representation, path: Path) -> Option<{ block: Bytes, field: Bytes }> =
  match ((r, path)) {
    (AsWord, FieldPath(f)) -> Some({ block: name, field: slot(name, f.at) }),
    (AsWord, ArgumentPath(a)) -> Some({ block: name, field: slot(name, a.at) }),
    (AsSum(s), CasePath(c)) -> match s.layout.cases.at(c.case) {
      Some(x) -> match x.payload {
        Boxed(b) -> {
          let word = match part_names(name, r).at(b.at) { Some(w) -> w, None -> name };
          let block = if b.stripped {
            Bytes::concat_all([
              b"((",
              word,
              b") & ~(Word)",
              ascii_of_int((1 << tag_bits) - 1),
              b")",
            ])
          } else { word };
          Some({ block: block, field: slot(block, b.skip + c.at) })
        },
        _ -> None,
      },
      None -> None,
    },
    _ -> None,
  }

fn tagged(
  p: InstructionContext,
  printing: Printing,
  into: Option<Variable>,
  name: Bytes,
) -> Printing =
  match into {
    None -> printing,
    Some(v) -> {
      let n = named(printing, v);
      pieces(n.printing, [
        Text(Bytes::concat_all([pad(p.depth), c_type(v.representation), b" ", n.name, b" = "])),
        Hole(ConstructorTag(name)),
        Text(b";\n"),
      ])
    },
  }

fn native(
  p: InstructionContext,
  printing: Printing,
  into: Option<Variable>,
  n: { name: Bytes, args: List<Arg>, uses: OperationSignature },
) -> Printing / {abort.raise} = {
  let call = Bytes::concat_all([
    n.name,
    b"(ctx",
    Bytes::concat_all(n.args.map(|a: Arg| b", ".concat(arg_text(printing, a)))),
    b")",
  ]);
  let noted = match builtin_pointed(n.name) {
    Some(h) -> native_noted(printing, h),
    None -> printing,
  };
  let sited = if n.uses.fails { source_position(p, noted) } else { noted };
  let written = match into {
    Some(v) -> assigned(sited, p.depth, v, c_type(v.representation), call),
    None -> line(sited, p.depth, call.concat(b";")),
  };
  if n.uses.fails { check(p, written) } else { written }
}

fn c_declaration(name: Bytes, f: Function) -> Bytes =
  Bytes::concat_all([
    signature_types(f.convention).result,
    b" ",
    name,
    b"(PlyCtx *ctx",
    Bytes::concat_all(signature_parameters(f.convention).map(|p: Bytes| b", ".concat(p))),
    b")",
  ])

fn restart_printed(
  restart: (Arg, Arg) -> List<Arg>,
) -> { text: Bytes, arm: Bytes } / {abort.raise} = {
  let int = int_type;
  let local = |id: Int, rep: Representation| { id: id, ty: int, representation: rep };
  let n = local(0, AsInt);
  let accumulator = local(1, AsInt);
  let c = local(2, AsBool);
  let j = local(3, AsInt);
  let a = local(4, AsInt);
  let let_of = |v: Variable, value: Rvalue, at: Span|
    Let({ var: v, value: value, at: at, unwind: [] });
  let f = {
    key: Named(b"m.count"),
    kind: Metered,
    params: [n, accumulator],
    convention: {
      params: [
        { ownership: OwnedParam, representation: AsInt },
        { ownership: OwnedParam, representation: AsInt },
      ],
      result: AsInt,
      destination_passing: false,
      returned: OwnedResult,
    },
    result_type: int_type,
    body: [
      let_of(
        c,
        Primitive({ operation: b"eq", on: AsInt, args: [VariableOperand(n), IntOperand(0)] }),
        span_between(0, 0),
      ),
      Declaration(j),
      If({
        cond: VariableOperand(c),
        then: [Assign({ var: j, arg: VariableOperand(accumulator) })],
        otherwise: [
          let_of(
            a,
            Primitive({ operation: b"sub", on: AsInt, args: [VariableOperand(n), IntOperand(1)] }),
            span_between(10, 15),
          ),
          Restart(restart(VariableOperand(a), VariableOperand(accumulator))),
        ],
      }),
      Return(VariableOperand(j)),
    ],
    lambdas: [],
    base: 0,
    members: [],
    links: no_links,
    statics: [],
  };
  let text = pieces_text(printed_function(f, no_constructors).pieces);
  {
    text: text,
    arm: match text.index_of(b"} else {") { Some(i) -> text.slice(i, text.len()), None -> b"" },
  }
}

test "a restart skips assigning a parameter whose argument is that same parameter" {
  let p = restart_printed(|less: Arg, accumulator: Arg| [less, accumulator]);
  assert(
    p.arm.index_of(b"p0 = ") != None && p.arm.index_of(b"p1 = ") == None,
    Some(String::of_bytes_lossy(p.text)),
  )
}

test "a restart takes its arguments into temporaries before it sets the parameters, then loops" {
  let p = restart_printed(|less: Arg, accumulator: Arg| [accumulator, less]);
  let text = p.text;
  let arm = p.arm;
  let text_message = Some(String::of_bytes_lossy(text));
  let in_arm = |s: Bytes| match arm.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  let read = in_arm(b" = p1;");
  assert(read >= 0 && read < in_arm(b"p0 = ") && read < in_arm(b"p1 = "), text_message);
  let jump = in_arm(b"goto ");
  let label = match arm.slice(jump + 5, arm.len()).index_of(b";") {
    Some(end) -> arm.slice(jump + 5, jump + 5 + end),
    None -> b"",
  };
  let label_position = match text.index_of(label.concat(b":")) { Some(i) -> i, None -> 0 - 1 };
  assert(
    jump > in_arm(b"p1 = ") && label.len() > 0 && label_position >= 0
      && label_position < text.len() - arm.len(),
    text_message,
  )
}

fn handle_over(result: Variable, body: Block) -> Instruction =
  Handle({
    body: body,
    args: [],
    uses: { takes: [], owned: false, fails: false, suspends: false },
    site: { clauses: [], return_clause: None, detached: None, instance: empty_instance(0) },
    result: result,
    unwind: [],
  })

fn returning(result: Variable, body: Block) -> Bytes / {abort.raise} =
  pieces_text(
    printed_function(
      {
        key: Named(b"m.guarded"),
        kind: Metered,
        params: [],
        convention: {
          params: [],
          result: AsWord,
          destination_passing: false,
          returned: OwnedResult,
        },
        result_type: result.ty,
        body: body.push(Return(VariableOperand(result))),
        lambdas: [],
        base: 0,
        members: [],
        links: no_links,
        statics: [],
      },
      no_constructors,
    ).pieces,
  )

fn nested_handle_text(fails: Bool) -> Bytes / {abort.raise} = {
  let outer = word(0);
  let inner = word(1);
  let t = word(2);
  let probe = Let({
    var: t,
    value: Native({
      name: b"rt_probe_p",
      args: [],
      uses: { takes: [], owned: true, fails: fails, suspends: false },
    }),
    at: span_between(0, 0),
    unwind: [],
  });
  returning(outer, [
    handle_over(outer, [
      handle_over(inner, [probe, Assign({ var: inner, arg: VariableOperand(t) })]),
      Assign({ var: outer, arg: VariableOperand(inner) }),
    ]),
  ])
}

test "a failure inside a nested handler body jumps to the inner handler's failure label, which then jumps to the outer handler's" {
  let failing = nested_handle_text(true);
  let quiet = nested_handle_text(false);
  assert_eq(occurrences(failing, landing_jump(1)), occurrences(quiet, landing_jump(1)) + 1);
  assert_eq(occurrences(failing, b"return "), occurrences(quiet, b"return "));
  let after = match failing.index_of(b"ply_h1:") {
    Some(at) -> failing.slice(at, failing.len()),
    None -> b"",
  };
  assert(match after.index_of(b"ply_h0:") {
    Some(end) -> after.slice(0, end).index_of(landing_jump(0)) != None,
    None -> false,
  })
}

test "a failure inside a handler body jumps to the handler's failure label, and the function does not return" {
  let result = word(0);
  let set = returning(result, [
    handle_over(result, [Assign({ var: result, arg: ZeroOperand(AsWord) })]),
  ]);
  let failing = returning(result, [
    handle_over(result, [
      Fail({ reason: NoMatchingArm, at: span_between(0, 0), resource: [], unwind: [] }),
    ]),
  ]);
  assert_eq(occurrences(failing, landing_jump(0)), occurrences(set, landing_jump(0)) + 1);
  assert_eq(occurrences(failing, b"return "), occurrences(set, b"return "))
}

test "a group of mutually tail-calling functions prints as one function that switches on the member number, each case unpacking that member's words" {
  let int = int_type;
  let which = { id: 0, ty: int, representation: AsInt };
  let n = { id: 1, ty: int, representation: AsInt };
  let m = { id: 2, ty: int, representation: AsInt };
  let conv = {
    params: [{ ownership: OwnedParam, representation: AsInt }],
    result: AsInt,
    destination_passing: false,
    returned: OwnedResult,
  };
  let text = pieces_text(
    printed_function(
      {
        key: Named(b"m.even"),
        kind: Metered,
        params: [which],
        convention: {
          params: [{ ownership: OwnedParam, representation: AsInt }],
          result: AsWord,
          destination_passing: false,
          returned: OwnedResult,
        },
        result_type: m.ty,
        body: [
          Case({
            on: which,
            test: IntTest([0, 1]),
            arms: [
              { when: 0, body: [Jump({ member: 1, args: [VariableOperand(n)] })] },
              { when: 1, body: [Return(VariableOperand(m))] },
            ],
            rest: [Return(ZeroOperand(AsWord))],
          }),
        ],
        lambdas: [],
        base: 0,
        members: [
          { key: Named(b"m.even"), base: 0, params: [n], convention: conv },
          { key: Named(b"m.odd"), base: 40, params: [m], convention: conv },
        ],
        links: no_links,
        statics: [],
      },
      no_constructors,
    ).pieces,
  );
  let g = own_symbol(None).concat(b"_group");
  let text_message = Some(String::of_bytes_lossy(text));
  let at = |s: Bytes| match text.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  assert(at(g.concat(b"(PlyCtx *ctx, int which")) >= 0 && at(b"switch (which)") >= 0, text_message);
  let opened = Bytes::concat_all([b" = ", word_as(b"p0", AsInt), b";"]);
  let arm = |k: Int| {
    let from = at(Bytes::concat_all([b"case ", ascii_of_int(k), b":"]));
    if from < 0 { b"" } else { text.slice(from, text.len()) }
  };
  assert(arm(0).index_of(opened) != None && arm(1).index_of(opened) != None, text_message);
  let param = {
    let a = arm(1);
    match a.index_of(opened) {
      Some(e) -> match a.slice(0, e).split(b" ").last() { Some(p) -> p, None -> b"" },
      None -> b"",
    }
  };
  assert(arm(1).index_of(b"return ".concat(as_word(param, AsInt))) != None, text_message);
  assert(at(g.concat(b"(ctx, ")) >= 0, text_message)
}

test "a closure's C function is printed after the function that makes it, and numbers its own temporaries from the start" {
  let int = int_type;
  let x = { id: 0, ty: int, representation: AsInt };
  let j = { id: 1, ty: int, representation: AsInt };
  let body = {
    key: Named(b"m.outer"),
    kind: Metered,
    params: [x],
    convention: {
      params: [{ ownership: OwnedParam, representation: AsInt }],
      result: AsInt,
      destination_passing: false,
      returned: OwnedResult,
    },
    result_type: int,
    body: [Declaration(j), Assign({ var: j, arg: VariableOperand(x) }), Return(VariableOperand(j))],
    lambdas: [],
    base: 0,
    members: [],
    links: no_links,
    statics: [],
  };
  let l = Closure({
    body: body,
    captures: 0,
    at: span_between(20, 30),
    words: no_closure_evidence,
  });
  let f = { ..body, lambdas: [l] };
  let name = own_symbol(None);
  let inner = closure_printed(name, 0, l, { ..empty_printing(Map::new()), temps: 7, labels: 3 });
  let body = pieces_text(inner.out);
  assert(body.index_of(b" t1;") != None && body.index_of(b"t8") == None, None);
  let printed = printed_function(f, no_constructors);
  assert(
    pieces_text(printed.pieces).ends_with(
      b"}\n".concat(pieces_text(lambda_text(name, 0, l, inner).out)),
    ),
  );
  assert_eq(printed.lambdas, [])
}

test "a generated function never checks the stack, but a generated drop function tracks its release depth when it starts and returns" {
  let ty = NamedType({ name: b"m.T", args: [] });
  let o = { id: 0, ty: ty, representation: AsWord };
  let plain = |type_operation: keys::TypeOperation|
    {
      key: keys::generated_key(type_operation, ty, b"m"),
      kind: Plain,
      params: [o],
      convention: {
        params: [{ ownership: OwnedParam, representation: AsWord }],
        result: AsWord,
        destination_passing: false,
        returned: OwnedResult,
      },
      result_type: ty,
      body: [
        If({
          cond: VariableOperand(o),
          then: [Restart([VariableOperand(o)])],
          otherwise: [Return(ZeroOperand(AsWord))],
        }),
      ],
      lambdas: [],
      base: 0,
      members: [],
      links: no_links,
      statics: [],
    };
  let text_of = |type_operation: keys::TypeOperation| {
    let f = plain(type_operation);
    let all = pieces_text(printed_function(f, no_constructors).pieces);
    let own = Bytes::concat_all([c_declaration(own_symbol(None), f), b" {"]);
    match all.index_of(own) {
      Some(i) -> match all.index_of_from(b"\n}\n", i) { Some(j) -> all.slice(i, j), None -> b"" },
      None -> b"",
    }
  };
  let dropped = text_of(keys::Drop);
  let shared = text_of(keys::Share);
  [dropped, shared].fold((), |_: Unit, t: Bytes| {
    assert(t.len() > 0, None);
    assert_eq(t.index_of(probed_fn), None);
    assert(t.index_of(b"ply_loop: ;") != None, None)
  });
  let at = |s: Bytes| match dropped.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  let deep = at(b"if (ply_drop_deep(ctx, p0, ");
  assert(deep >= 0 && deep < at(b"ply_loop:"), None);
  assert_eq(
    occurrences(dropped, b"ply_drop_done(ctx);\n  return "),
    occurrences(dropped, b"return 0;") - 1,
  );
  assert_eq(shared.index_of(b"ply_drop"), None);
  assert(
    text_of(keys::OnCase({ operation: keys::Drop, case: 1 })).index_of(b"ply_drop_deep(") != None,
    None,
  )
}

fn int_root(params: List<Variable>, body: Block) -> Function =
  {
    key: Named(b"m.sited"),
    kind: Metered,
    params: params,
    convention: {
      params: owned_params(params.map(|v: Variable| v.representation)),
      result: AsInt,
      destination_passing: false,
      returned: OwnedResult,
    },
    result_type: int_type,
    body: body,
    lambdas: [],
    base: 100,
    members: [],
    links: no_links,
    statics: [],
  }

test "after a `SiteScope` instruction, failure messages name the scope's function and use offsets within its source text until the scope ends" {
  let int = int_type;
  let v = |id: Int| { id: id, ty: int, representation: AsInt };
  let add = |x: Variable, at: Span|
    Let({
      var: { ..x, id: x.id + 1 },
      value: Primitive({ operation: b"add", on: AsInt, args: [VariableOperand(x), IntOperand(1)] }),
      at: at,
      unwind: [],
    });
  let j = v(20);
  let main = { root: Named(b"app.main"), base: 1000 };
  let other = { root: Named(b"lib.k"), base: 2000 };
  let text = pieces_text(
    printed_function(
      int_root([v(0)], [
        add(v(0), span_between(110, 115)),
        SiteScope(Some(main)),
        add(v(1), span_between(1004, 1009)),
        Declaration(j),
        If({
          cond: BoolOperand(true),
          then: [
            SiteScope(Some(other)),
            add(v(2), span_between(2001, 2003)),
            Assign({ var: j, arg: VariableOperand(v(3)) }),
          ],
          otherwise: [Assign({ var: j, arg: VariableOperand(v(2)) })],
        }),
        add(j, span_between(1020, 1025)),
        SiteScope(None),
        add(v(21), span_between(130, 135)),
        Return(VariableOperand(v(22))),
      ]),
      no_constructors,
    ).pieces,
  );
  let sites = text.split(b"PLY_SITE(").drop(1).map(|rest: Bytes|
    Bytes::concat_all([b"PLY_SITE(", rest.split(b";").get(0), b";"]));
  let borrowed = |n: Bytes, from: Bytes, to: Bytes|
    Bytes::concat_all([b"PLY_SITE(ctx, ", ascii_of_int(root_id(n)), b", ", from, b", ", to, b");"]);
  assert_eq(sites, [
    b"PLY_SITE(ctx, @@r@@, 10, 15);",
    borrowed(b"app.main", b"4", b"9"),
    borrowed(b"lib.k", b"1", b"3"),
    borrowed(b"app.main", b"20", b"25"),
    b"PLY_SITE(ctx, @@r@@, 30, 35);",
  ])
}

test "taking a field moves it out and clears it in place when the block has one owner, and retains it first when the block is shared" {
  let block = { id: 0, ty: NamedType({ name: b"m.Buf", args: [] }), representation: AsWord };
  let field = word(1);
  let f = {
    ..int_root([block], [Let({ var: field, value: Take({ of: block, path: FieldPath({ name: b"bytes", at: 1 }) }), at: span_between(0, 0), unwind: [] }), Return(IntOperand(0))]),
    convention: {
      params: [{ ownership: OwnedParam, representation: AsWord }],
      result: AsWord,
      destination_passing: false,
      returned: OwnedResult,
    },
  };
  let text = pieces_text(printed_function(f, no_constructors).pieces);
  assert(
    text.index_of(b"ply_words(p0)[1] = 0;") != None
      && text.index_of(call_text(duplicate_function, [b"t1"])) != None,
    Some(String::of_bytes_lossy(text)),
  )
}

test "printing a constructor's tag emits a hole that is replaced with the tag's value after printing" {
  let k = { id: 0, ty: int_type, representation: AsInt };
  let printing = printed_function(
    int_root([], [
      Let({ var: k, value: Tag(b"m.Box"), at: span_between(0, 0), unwind: [] }),
      Return(VariableOperand(k)),
    ]),
    no_constructors,
  );
  assert(printing.pieces.contains(Hole(ConstructorTag(b"m.Box"))))
}

fn called(args: List<Arg>) -> Rvalue =
  Call({
    callee: Root(Named(b"m.g")),
    args: args,
    convention: {
      params: owned_params(args.map(|_: Arg| AsWord)),
      result: AsWord,
      destination_passing: false,
      returned: OwnedResult,
    },
    suspends: false,
  })

fn let_unwinding(v: Variable, value: Rvalue, unwind: List<Variable>) -> Instruction =
  Let({ var: v, value: value, at: span_between(0, 0), unwind: unwind })

fn word_root(params: List<Variable>, body: Block) -> Bytes / {abort.raise} =
  pieces_text(
    printed_function(
      {
        ..int_root(params, body),
        convention: {
          params: owned_params(params.map(|v: Variable| v.representation)),
          result: AsWord,
          destination_passing: false,
          returned: OwnedResult,
        },
      },
      no_constructors,
    ).pieces,
  )

fn released_text(name: Bytes) -> Bytes / {abort.raise} =
  call_text(release_function, [
    b"ctx",
    name,
    pieces_text([Hole(Symbol(Root(drop_of(string_type))))]),
  ]).concat(
    b";",
  )

test "failure cleanup code releases each owned value once, as a chain that later failures reuse" {
  let s = word(0);
  let a = word(1);
  let b = word(2);
  let c = word(3);
  let text = word_root([s], [
    let_unwinding(a, called([]), [s]),
    let_unwinding(b, called([]), [s, a]),
    let_unwinding(c, called([VariableOperand(a)]), [s, b]),
    Return(VariableOperand(c)),
  ]);
  let text_message = Some(String::of_bytes_lossy(text));
  let at = |s: Bytes| match text.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  let jumps = text.split(b"\n").filter(|l: Bytes| l.index_of(b"if (ctx->failed) goto ") != None);
  let distinct = jumps.fold([], |accumulator: List<Bytes>, l: Bytes|
    if accumulator.contains(l) { accumulator } else { accumulator.push(l) });
  assert(jumps.len() == 3 && distinct.len() == 3, text_message);
  let freed = [b"t2", b"t1", b"p0"].map(|x: Bytes| released_text(x));
  assert(freed.all(|r: Bytes| occurrences(text, r) == 1), text_message);
  assert(at(b"return t3;") < at(freed.get(0)), text_message);
  assert(at(freed.get(0)) < at(freed.get(1)) && at(freed.get(1)) < at(freed.get(2)), text_message)
}

test "a cleanup block is placed in the block where its value was declared, and continues into the cleanup of the enclosing blocks" {
  let s = word(0);
  let flag = { id: 1, ty: bool_type, representation: AsBool };
  let j = word(2);
  let a = word(3);
  let b = word(4);
  let text = word_root([s, flag], [
    Declaration(j),
    If({
      cond: VariableOperand(flag),
      then: [
        let_unwinding(a, called([]), [s]),
        let_unwinding(b, called([]), [s, a]),
        Assign({ var: j, arg: VariableOperand(b) }),
      ],
      otherwise: [Assign({ var: j, arg: VariableOperand(s) })],
    }),
    Return(VariableOperand(j)),
  ]);
  let text_message = Some(String::of_bytes_lossy(text));
  let at = |s: Bytes| match text.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  let arm_tail = at(released_text(b"t2"));
  assert(at(b"t1 = t3;") < arm_tail && arm_tail < at(b"} else {"), text_message);
  assert(at(b"return t1;") < at(released_text(b"p0")), text_message)
}

test "a failure inside a handler body releases the values the body created, then jumps to the failure label, which releases the handler's recorded values" {
  let s = word(0);
  let result = word(1);
  let a = word(2);
  let b = word(3);
  let text = word_root([s], [
    Handle({
      body: [
        let_unwinding(a, called([]), []),
        let_unwinding(b, called([]), [a]),
        Assign({ var: result, arg: VariableOperand(b) }),
      ],
      args: [],
      uses: { takes: [], owned: false, fails: false, suspends: false },
      site: { clauses: [], return_clause: None, detached: None, instance: empty_instance(0) },
      result: result,
      unwind: [s],
    }),
    Return(VariableOperand(result)),
  ]);
  let jumps = text.split(landing_jump(0));
  let landing = text.len() - (match jumps.last() { Some(rest) -> rest.len(), None -> 0 });
  let body = text.slice(0, landing);
  let after = text.slice(landing, text.len());
  let text_message = Some(String::of_bytes_lossy(text));
  assert(jumps.len() >= 3 && occurrences(body, released_text(b"t2")) == 1, text_message);
  assert_eq(occurrences(body, released_text(b"p0")), 0);
  assert_eq(occurrences(after, released_text(b"p0")), 1)
}

test "a value computed by C code that cannot fail adds no failure cleanup code" {
  let s = word(0);
  let n = { id: 1, ty: int_type, representation: AsInt };
  let half = { ..n, id: 2 };
  let a = word(3);
  let quiet = word_root([s, n], [
    let_unwinding(
      half,
      Primitive({ operation: b"div", on: AsInt, args: [VariableOperand(n), IntOperand(2)] }),
      [s],
    ),
    Return(VariableOperand(s)),
  ]);
  assert_eq(quiet.index_of(b"goto ply_u"), None);
  assert_eq(quiet.index_of(b"ply_u0:"), None);
  let then_called = word_root([s, n], [
    let_unwinding(
      half,
      Primitive({ operation: b"div", on: AsInt, args: [VariableOperand(n), IntOperand(2)] }),
      [s],
    ),
    let_unwinding(a, called([]), [s]),
    Return(VariableOperand(a)),
  ]);
  assert(then_called.index_of(b"if (ctx->failed) goto ply_u0;") != None);
  assert_eq(occurrences(then_called, b"ply_u0:"), 1)
}
