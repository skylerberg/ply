import compiler.emit.print.placing (placing_of)
import compiler.emit.print.fuel (fuel_head, crossed_head)
import compiler.emit.print.prims (literal, prim)
import compiler.emit.print.containers (contained, container_op)
import compiler.emit.print.strings (string_op)
import compiler.emit.print.tested (case_opened, case_arm, case_arm_closed, case_rest, case_closed,
                                   match_opened, match_arm, match_arm_closed, match_rest,
                                   match_closed, missed, failed)
import compiler.emit.print.invoked (call, applied, closure_made, restarted, entered_member,
                                    loop_opened, loop_closed, next, done, calling_op, lambda_names,
                                    lambda_text, group_wrapper, capture_got, member_returned,
                                    runtime_entry, entered_of, kept_entry, group_buffers,
                                    member_opened)
import compiler.emit.lower.held (passing, ByReference)
import compiler.emit.print.handled (handle_opened, handle_closed, landing_jump, effect_op)
