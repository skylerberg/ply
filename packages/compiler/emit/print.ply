/// Root `f` as its C function and entry, or a tail group as its group function, the group's entry
/// and each member's wrapper; then each of its closures' functions in `f.lambdas` order; the `each`
/// functions their frame records name before them all. `ctors` is the program's constructor table.
pub fn printed_fn(f: Fn, ctors: Ctors) -> Printed / {abort.raise} = {
  let name = symbol_of(root_text(root_name(f.key)));
  let own = if f.members.len() == 0 { root_printed(name, f, ctors) }
  else { group_printed(name, f, ctors) };
  let closures = range(0, f.lambdas.len()).fold(
    { pr: own.pr, out: [] },
    |acc: { pr: Printing, out: List<Piece> }, k: Int|
      match f.lambdas.at(k) {
        Some(l) -> {
          let t = lambda_text(f, k, l, closure_printed(name, k, l, acc.pr));
          { pr: t.pr, out: acc.out.concat(t.out) }
        },
        None -> acc,
      },
  );
  let tables = closures.pr;
  {
    pieces: merged(eaches_printed(name, tables).concat(own.out).concat(closures.out)),
    calls: tables.calls,
    builtins: tables.builtins,
    fields: tables.fields,
    lambdas: tables.lambdas,
    performs: tables.performs,
    handles: tables.handles,
    expects: tables.expects,
    shared: tables.shared,
  }
}

/// A root of its own as its C function, named `name`, and its entry: the printing after it and its
/// pieces.
fn root_printed(
  name: Bytes,
  f: Fn,
  ctors: Ctors,
) -> { pr: Printing, out: List<Piece> } / {abort.raise} = {
  let body = body_printed(name, f, {
    ..printing(param_names(f)),
    ctors: ctors,
    counting: counted_here(f.key),
  });
  let entered = if !has_entry(f.key, declared_arity(f.params), ctors.stated) {
    { pr: body, out: [] }
  } else {
    match f.kind {
      Kept(w) -> kept_entry(body, name, w),
      _ -> runtime_entry(body, name, entered_of(f)),
    }
  };
  // A plain root counts no steps; a drop root nests only so deep, past which its block waits.
  let opening = match f.kind {
    Rooted -> fuel_head(f.conv.answer),
    Crossing -> crossed_head(f.conv.answer),
    Plain -> if !dropping(f.key) { b"" }
    else { Bytes::concat_all([b"  if (ply_drop_deep(ctx, p0, ", name, b")) return 0;\n"]) },
    Kept(_) -> b"",
  };
  {
    pr: entered.pr,
    out: [
      Text(
        Bytes::concat_all([
          if entered.out.len() == 0 { b"" }
          else { Bytes::concat_all([b"Word ", name, b"_entry(PlyCtx *ctx, const Word *args);\n"]) },
          head(name, f),
          b" {\n",
          opening,
        ]),
      ),
    ].concat(
      body.out,
    ).push(
      Text(b"}\n"),
    ).concat(
      entered.out,
    ),
  }
}

/// A tail group, its first member named `name`, as its group function, which takes the member's
/// place `which` and the widest member's parameters as words and switches on `which` to that
/// member's arm, each arm opening its member's parameters from the words; then each member's
/// wrapper.
fn group_printed(
  name: Bytes,
  f: Fn,
  ctors: Ctors,
) -> { pr: Printing, out: List<Piece> } / {abort.raise} = {
  let g = name.concat(b"_group");
  let width = f.members.fold(0, |w: Int, m: Member|
    if m.params.len() > w { m.params.len() } else { w });
  let words = range(0, width).map(|i: Int| b"p".concat(ascii_of_int(i)));
  let u = {
    symbol: name,
    base: f.base,
    answer: f.conv.answer,
    site: None,
    arm: None,
    looping: None,
    landing: None,
    group: None,
    leaving: fuel_returned(),
  };
  let start = {
    ..printing(match f.params.at(0) { Some(which) -> Map::new().insert(which.id, b"which"), None -> Map::new() }),
    ctors: ctors,
  };
  let switched = match f.body {
    [Case(c)] -> {
      let arms = c.arms.fold(start, |pr: Printing, a: { when: Int, body: Block }|
        match f.members.at(a.when) {
          None ->
            unprinted(
              Spine,
              b"an arm of no member of the group",
              Bytes::concat_all([
                b"arm ",
                ascii_of_int(a.when),
                b" of ",
                ascii_of_int(f.members.len()),
                b" members",
              ]),
            ),
          Some(m) -> {
            let armed = {
              ..u,
              base: m.base,
              site: Some(InGroup(a.when)),
              group: Some({ at: a.when, members: f.members, width: width }),
            };
            let opened = range(0, m.params.len()).fold(
              block_opened(
                line(pr, 0, Bytes::concat_all([b"case ", ascii_of_int(a.when), b": {"])),
              ),
              |q: Printing, j: Int| {
                let v = m.params.get(j);
                let word = b"p".concat(ascii_of_int(j));
                if passing(v.rep) == ByReference { member_opened(q, 1, v, word) } else {
                  match v.rep {
                    RWord -> { ..q, names: q.names.insert(v.id, word) },
                    RFlat(_) -> parted(q, v, word),
                    RSum(_) -> parted(q, v, word),
                    RUnit -> q,
                    _ -> assigned(q, 1, v, c_type(v.rep), word_as(word, v.rep)),
                  }
                }
              },
            );
            line(
              block_closed(printed(armed, opened, a.body, 1), pr.block, 1, falls_through(a.body)),
              0,
              b"}",
            )
          },
        });
      block_closed(
        printed(u, line(arms, 0, b"}"), c.rest, 0),
        start.block,
        0,
        falls_through(c.rest),
      )
    },
    body ->
      unprinted(
        Spine,
        b"a group whose body is no case on its member's place",
        Bytes::concat_all([ascii_of_int(body.len()), b" instructions"]),
      ),
  };
  let wrappers = range(0, f.members.len()).fold(
    { pr: switched, out: [] },
    |acc: { pr: Printing, out: List<Piece> }, i: Int| {
      let w = group_wrapper(f, i, acc.pr);
      { pr: w.pr, out: acc.out.concat(w.out) }
    },
  );
  {
    pr: wrappers.pr,
    out: [
      Text(
        Bytes::concat_all([
          b"static Word ",
          g,
          b"(PlyCtx *ctx, int which",
          Bytes::concat_all(words.map(|w: Bytes| b", Word ".concat(w))),
          b") {\n",
          fuel_head(f.conv.answer),
          Bytes::concat_all(group_buffers(f).map(|d: Bytes| Bytes::concat_all([b"  ", d, b"\n"]))),
          record_declared(switched),
          b"  ply_loop: ",
          tick_line(failing_return(f.conv.answer)),
          b"\n  switch (which) {\n",
        ]),
      ),
    ].concat(
      switched.out,
    ).push(
      Text(b"}\n"),
    ).concat(
      wrappers.out,
    ),
  }
}

/// The C a destined root answering `a` runs before it returns it: where its caller gave a
/// destination, the record moved there and the destination answered; nothing where `a` was
/// written there already.
fn moved_to_destination(pr: Printing, a: Arg) -> { pr: Printing, text: Bytes } / {abort.raise} =
  match a {
    AVar(x) -> if !pr.placing.destined || pr.placing.answers.contains(x.id) {
      { pr: pr, text: b"" }
    } else {
      match laid_known(pr.ctors, x.ty) {
        Some(l) -> {
          let moved = placed_write(pr, b"*(Word *)d", b"ply_words(d)", name_of(pr, x), l);
          { pr: moved.pr, text: Bytes::concat_all([b"  if (d) { ", moved.text, b" return d; }\n"]) }
        },
        None -> { pr: pr, text: b"" },
      }
    },
    _ -> { pr: pr, text: b"" },
  }

/// `v`, held as several values, bound in a group's arm from the word `word`, which it takes.
fn parted(pr: Printing, v: Var, word: Bytes) -> Printing = {
  let n = named(pr, v);
  pieces(
    n.pr,
    [Text(pad(1))].concat(word_parts(word, v.rep, part_names(n.name, v.rep))).push(Text(b"\n")),
  )
}

/// Whether root `k` is a drop root: of a type, or of the box of one of its sum's cases.
fn dropping(k: RootKey) -> Bool =
  match k {
    Written(w, _) -> match w.op {
      keys::Drop -> true,
      keys::Cased(c) -> c.op == keys::Drop,
      _ -> false,
    },
    _ -> false,
  }

/// The type root `k` counts a value of word by word, where it is a `Held` count root.
fn counted_here(k: RootKey) -> Option<Type> =
  match k { Written(w, _) -> match w.op { keys::Held(_) -> Some(w.ty), _ -> None }, _ -> None }

/// The C `f`'s `Return` runs before it returns: a root's unit of fuel given back, a drop root's
/// depth, nothing for another plain root.
fn leaving_of(f: Fn) -> Bytes =
  match f.kind {
    Rooted -> fuel_returned(),
    Crossing -> fuel_returned(),
    Plain -> if dropping(f.key) { b"ply_drop_done(ctx);" } else { b"" },
    Kept(_) -> b"",
  }

fn param_names(f: Fn) -> Map<Int, Bytes> / {abort.raise} =
  range(0, f.params.len()).fold(Map::new(), |m: Map<Int, Bytes>, i: Int|
    m.insert(f.params.get(i).id, b"p".concat(ascii_of_int(i))))

/// Closure body `nth` of the root named `symbol`, `l`, printed after what `pr` holds: the body of a C
/// function of its own, so its temporaries, labels and tails are its own, but the root's tables go
/// on.
fn closure_printed(symbol: Bytes, nth: Int, l: Lambda, pr: Printing) -> Printing / {abort.raise} =
  match l { Closure(c) -> body_printed(symbol, c.body, function_body(pr, lambda_names(l, nth))) }

/// `f`'s body, a body of the root named `symbol`: the frame record its sites link, its parameters
/// opened, its restart label where a self call restarts it, and the tails of what it declares at
/// its end.
fn body_printed(symbol: Bytes, f: Fn, given: Printing) -> Printing / {abort.raise} = {
  let pr = { ..given, placing: placing_of(f) };
  let u = {
    symbol: symbol,
    base: f.base,
    answer: f.conv.answer,
    site: None,
    arm: None,
    looping: None,
    // A failure leaves by raising what the runtime left pending, where the function holds a word to.
    landing: match f.links.pending { Some(_) -> Some(b"goto ply_pending;"), None -> None },
    group: None,
    leaving: leaving_of(f),
  };
  let opened = params_opened(f.params.map(|v: Var| name_of(pr, v)), f.conv.reps).fold(
    pr,
    |q: Printing, l: Bytes| line(q, 0, l),
  );
  let viewed = views_opened(f, opened);
  // A plain root's restart counts no tick.
  let ticked = match f.kind { Rooted -> tick_line(failing_return(f.conv.answer)), _ -> b";" };
  let looped = if restarts(f.body) {
    text(viewed, Bytes::concat_all([b"  ply_loop: ", ticked, b"\n"]))
  } else { viewed };
  let body = block_closed(printed(u, looped, f.body, 0), pr.block, 0, falls_through(f.body));
  let closed = match f.links.pending {
    None -> body,
    Some(pd) ->
      text(
        body,
        Bytes::concat_all([
          b"  ply_pending: ply_pending_raised(ctx, ",
          name_of(body, pd.word),
          b", ",
          ascii_of_int(pd.index),
          b", (Word)(intptr_t)&",
          pd.op,
          b", (Word)(intptr_t)&",
          pd.string,
          b");\n  ",
          failing_return(f.conv.answer),
          b"\n",
        ]),
      ),
  };
  let done = { ..closed, placing: given.placing };
  let record = record_declared(done);
  if record.len() == 0 { done } else { { ..done, out: [Text(record)].concat(done.out) } }
}

/// Each parameter `f` holds as a view of the list whose word it takes, viewing the list from its
/// first item.
fn views_opened(f: Fn, pr: Printing) -> Printing =
  range(0, f.params.len()).fold(pr, |q: Printing, i: Int|
    match f.params.at(i) {
      Some(v) -> if v.rep != RSlice || f.conv.reps.at(i) != Some(RWord) { q } else {
        let word = name_of(q, v);
        line(
          q,
          0,
          Bytes::concat_all([
            b"Word ",
            part_name(word, 0),
            b" = ",
            word,
            b"; int64_t ",
            part_name(word, 1),
            b" = 0;",
          ]),
        )
      },
      None -> q,
    })

/// Whether a self call restarts the body anywhere in `b`.
fn restarts(b: Block) -> Bool =
  b.fold(false, |found: Bool, i: Inst|
    found
      || (match i {
        Restart(_) -> true,
        If(x) -> restarts(x.then) || restarts(x.otherwise),
        Case(c) ->
          restarts(c.rest)
            || c.arms.fold(false, |any: Bool, a: { when: Int, body: Block }|
              any || restarts(a.body)),
        Match(m) ->
          restarts(m.rest) || m.arms.fold(false, |any: Bool, a: Block| any || restarts(a)),
        Loop(l) -> restarts(l.body),
        Handle(h) -> restarts(h.body),
        _ -> false,
      }))

/// Where a failure goes once it has released what it holds: the enclosing handle's landing, or else
/// out of the function.
fn root_of(u: Under) -> Bytes = match u.landing { Some(j) -> j, None -> failing_return(u.answer) }

/// `val` printed into `into` at `p`, a failure in it releasing `unwind` on its way out, and where it
/// may stop, a record of `unwind` linked around it. The tails it adds are kept only where the C it
/// prints has a failure test, which goes by them.
fn exiting(
  p: Place,
  pr: Printing,
  unwind: List<Var>,
  into: Option<Var>,
  val: Val,
) -> Printing / {abort.raise} = {
  let x = exit_of(pr, unwind, root_of(p.u));
  let l = site_linked({ ..p, leave: x.leave }, x.pr, unwind, val);
  let after = unlinked(value_printed({ ..p, leave: l.leave }, l.pr, into, val), p.depth, l);
  if x.pr.tails.all.len() == pr.tails.all.len()
      || range(pr.out.len(), after.out.len()).any(|i: Int|
        match after.out.at(i) { Some(Text(t)) -> t.index_of(x.leave) != None, _ -> false }) {
    after
  } else { { ..after, tails: pr.tails } }
}

/// A block printed so far: what is printed, what its next instruction is printed under, and what
/// each lent run it began and has not ended set aside.
type Sites = { pr: Printing, u: Under, outer: List<Under> }

/// `s` after a `Sited(lent)`: a lender's run begun, its sites the lender's, or the innermost one the
/// block began ended.
fn resited(s: Sites, lent: Option<Lender>) -> Sites =
  match lent {
    Some(l) ->
      { ..s, u: { ..s.u, site: Some(LentBy(l.root)), base: l.base }, outer: s.outer.push(s.u) },
    None -> match s.outer.at(s.outer.len() - 1) {
      Some(o) -> { ..s, u: o, outer: s.outer.take(s.outer.len() - 1) },
      None -> s,
    },
  }

/// The one recursion over a body: each instruction printed in turn, a block it holds within it. A
/// block C writes as a block of its own is opened as one and closed by the tails of what it declares.
fn printed(home: Under, pr: Printing, b: Block, depth: Int) -> Printing / {abort.raise} =
  b.fold({ pr: pr, u: home, outer: [] }, |sites: Sites, i: Inst| {
    let u = sites.u;
    let acc = sites.pr;
    let p = { u: u, at: span_between(0, 0), leave: root_of(u), depth: depth };
    let inner = depth + 1;
    match i {
      Sited(lent) -> resited(sites, lent),
      _ ->
        {
          ..sites,
          pr: match i {
            Let(l) -> exiting({ ..p, at: l.at }, acc, l.unwind, Some(l.var), l.val),
            Do(d) -> exiting({ ..p, at: d.at }, acc, d.unwind, None, d.val),
            Decl(v) -> join_declared(acc, depth, v),
            Assign(s) -> set_parts(acc, depth, s.var, s.arg),
            If(x) -> {
              let opened = line(
                acc,
                depth,
                Bytes::concat_all([b"if (", arg_text(acc, x.cond), b") {"]),
              );
              let t = block_closed(
                printed(u, block_opened(opened), x.then, inner),
                acc.block,
                inner,
                falls_through(x.then),
              );
              let e = block_closed(
                printed(u, block_opened(line(t, depth, b"} else {")), x.otherwise, inner),
                acc.block,
                inner,
                falls_through(x.otherwise),
              );
              line(e, depth, b"}")
            },
            Case(c) -> {
              let arms = c.arms.fold(
                case_opened(p, acc, c.on, c.test),
                |q: Printing, a: { when: Int, body: Block }|
                  case_arm_closed(
                    p,
                    block_closed(
                      printed(u, block_opened(case_arm(p, q, c.on, c.test, a.when)), a.body, inner),
                      acc.block,
                      inner,
                      falls_through(a.body),
                    ),
                  ),
              );
              case_closed(
                p,
                block_closed(
                  printed(u, block_opened(case_rest(p, arms, c.on, c.test)), c.rest, inner),
                  acc.block,
                  inner,
                  falls_through(c.rest),
                ),
              )
            },
            Match(m) -> {
              let l = label(acc);
              let arms = m.arms.fold(
                { pr: match_opened(p, l.pr, l.n, m.arms.len()), at: 0 },
                |q: { pr: Printing, at: Int }, a: Block| {
                  let armed = printed(
                    { ..u, arm: Some({ label: l.n, at: q.at }) },
                    match_arm(p, q.pr, l.n, q.at),
                    a,
                    depth,
                  );
                  {
                    pr: if falls_through(a) { match_arm_closed(p, armed, l.n, q.at) }
                    else { armed },
                    at: q.at + 1,
                  }
                },
              );
              match_closed(
                p,
                printed(u, match_rest(p, arms.pr, l.n, m.arms.len()), m.rest, depth),
                l.n,
              )
            },
            Miss -> match u.arm {
              Some(a) -> missed(p, acc, a.label, a.at),
              None -> unprinted(Spine, b"a miss outside a match", b"Miss"),
            },
            Fail(x) -> failed({ ..p, at: x.at }, acc, x.why),
            Loop(lp) -> {
              let l = label(acc);
              let looped = {
                ..u,
                looping: Some({ label: l.n, state: lp.state, answer: lp.answer }),
              };
              loop_closed(
                p,
                block_closed(
                  printed(
                    looped,
                    block_opened(loop_opened(p, l.pr, l.n, lp.state, lp.init, lp.answer)),
                    lp.body,
                    inner,
                  ),
                  acc.block,
                  inner,
                  falls_through(lp.body),
                ),
                l.n,
                lp.answer,
              )
            },
            Next(args) -> match u.looping {
              Some(lp) -> next(p, acc, lp.label, lp.state, args),
              None ->
                unprinted(
                  Spine,
                  b"a next pass outside a loop",
                  Bytes::concat_all([b"Next of ", ascii_of_int(args.len()), b" values"]),
                ),
            },
            Done(a) -> match u.looping {
              Some(lp) -> done(p, acc, lp.label, lp.answer, a),
              None -> unprinted(Spine, b"a loop's answer outside a loop", b"Done"),
            },
            // A member of a tail group answers at its own convention, through the group's word.
            Return(a) -> match u.group {
              Some(_) -> member_returned(p, acc, a),
              None -> {
                let r = returned(acc, depth, a);
                let leaving = if u.leaving == b"" { b"" }
                else { Bytes::concat_all([b"  ", u.leaving, b"\n"]) };
                let moved = moved_to_destination(r.pr, a);
                text(
                  moved.pr,
                  Bytes::concat_all([leaving, moved.text, b"  return ", r.value, b";\n"]),
                )
              },
            },
            Restart(args) -> match u.group {
              Some(g) -> entered_member(p, acc, g.at, args),
              None -> restarted(p, acc, args),
            },
            Enter(e) -> entered_member(p, acc, e.member, e.args),
            // A failure in the body goes to the landing, which leaves by `hp.leave` where no clause answers.
            Handle(h) -> {
              let l = label(acc);
              let x = exit_of(l.pr, h.unwind, root_of(u));
              let f = handle_linked({ ..p, leave: x.leave }, x.pr, l.n, h.body, h.site, h.unwind);
              let hp = { ..p, leave: f.leave };
              let inside = { ..u, landing: Some(landing_jump(l.n)) };
              let opened = handle_opened(hp, f.pr, l.n, h.args, h.uses, h.site, h.answer);
              unlinked(
                handle_closed(
                  hp,
                  if h.site.detached != None { printed(inside, opened, h.body, inner) } else {
                    block_closed(
                      printed(inside, block_opened(opened), h.body, inner),
                      acc.block,
                      inner,
                      falls_through(h.body),
                    )
                  },
                  l.n,
                  h.args,
                  h.site,
                  h.answer,
                ),
                depth,
                f,
              )
            },
            Inc(_) -> count_printed(p, acc, i),
            Dec(_) -> count_printed(p, acc, i),
            Reset(_) -> count_printed(p, acc, i),
            Free(_) -> count_printed(p, acc, i),
            Opened(_) -> count_printed(p, acc, i),
            Sited(_) -> acc,
          },
        },
    }
  }).pr

/// `val` printed by the family whose value it is, its answer into `into`.
fn value_printed(p: Place, pr: Printing, into: Option<Var>, val: Val) -> Printing / {abort.raise} =
  match val {
    Prim(x) -> prim(p, pr, into, x),
    Literal(l) -> literal(p, pr, into, l),
    Static(n) -> statics(p, pr, into, n),
    Make(m) -> match laid_made(m.made) {
      MClosure(_) -> closure_made(p, pr, into, m),
      MList(_) -> contained(p, pr, into, m),
      _ -> made(p, pr, into, m),
    },
    Get(g) -> match g.path {
      PCapture(i) -> capture_got(p, pr, into, g.of, i),
      _ -> got(p, pr, into, g),
    },
    Take(t) -> taken(p, pr, into, t),
    Tag(name) -> tagged(p, pr, into, name),
    Pack(k) -> worded(p, pr, into, k),
    Gathered(g) -> gathered(p, pr, into, g.parts),
    Updated(u) -> updated(p, pr, into, u),
    Call(c) -> call(p, pr, into, c),
    Apply(c) -> applied(p, pr, into, c),
    Native(n) -> native(p, pr, into, n),
    Op(o) -> match o.op {
      OHandle(h) -> effect_op(p, pr, into, h, o.args, o.uses),
      OContainer(x) -> container_op(p, pr, into, x, o.args, o.uses),
      OCalling(x) -> calling_op(p, pr, into, x, o.args, o.uses),
      OStrings(x) -> string_op(p, pr, into, x, o.args),
    },
    LastOf(v) -> last_of(p, pr, into, v),
    Walked(w) -> walked_value(p, pr, into, w.of, w.op),
    Unsettled(_) ->
      unprinted(Data, b"what only a specialisation computes", b"a body its callers settle"),
  }

/// The field held as one word at `t.path`'s offset in the block `t.of`, in the box the case of the
/// sum `t.of` holds, or among the words of a sum held as them, read with a count of its own: moved
/// out of its slot, which is emptied, where the block is held only here, and counted once more where
/// it is shared. A block held in place in another is held only here where the object counting for
/// it is: its own header holds no count. A sum's words are this body's alone.
fn taken(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  t: { of: Var, path: Path },
) -> Printing / {abort.raise} =
  match into {
    None -> unprinted(Spine, b"a field taken that nothing holds", var_said(t.of)),
    // A sum held as its words holds each alone: its word moves out, none left for its release.
    Some(v) -> match match ((t.of.rep, t.path)) {
        (RSum(s), PCase(c)) -> inline_word_at(s.laid, c.case, c.at),
        _ -> None,
      } {
      Some(w) -> {
        let name = name_of(pr, t.of);
        let word = match part_names(name, t.of.rep).at(w) { Some(x) -> x, None -> name };
        let n = named(pr, v);
        line(
          line(n.pr, p.depth, Bytes::concat_all([c_type(v.rep), b" ", n.name, b" = ", word, b";"])),
          p.depth,
          word.concat(b" = 0;"),
        )
      },
      None -> match t.path {
        PPlace(at) -> taken_from_place(p, pr, v, t.of, at),
        _ -> taken_from_block(p, pr, v, t),
      },
    },
  }

/// `v`, the record lying in place at word `at` of the box `of` is, moved out into a box of its
/// own: where `of` is held only here its words move, zeroes left in their place, which no release
/// reads; otherwise they are copied, each counted word counted once more.
fn taken_from_place(p: Place, pr: Printing, v: Var, of: Var, at: Int) -> Printing / {abort.raise} =
  match laid_known(pr.ctors, v.ty) {
    Some(l) -> {
      let m = words(l);
      let block = name_of(pr, of);
      let n = named(pr, v);
      let place = Bytes::concat_all([b"&", slot(block, at + 1)]);
      let bytes = int_lit(8 * m);
      let counted = laid_counted(n.pr, l, Bytes::concat_all([b"ply_words(", n.name, b")"]));
      line(
        counted.pr,
        p.depth,
        Bytes::concat_all([
          b"Word ",
          n.name,
          b" = rt_alloc_bytes_p(ctx, ",
          int_lit(header_bytes() + 8 * m),
          b"); memcpy(ply_words(",
          n.name,
          b"), ",
          place,
          b", ",
          bytes,
          b"); if (ply_obj(",
          block,
          b")->rc == 1) memset(",
          place,
          b", 0, ",
          bytes,
          b"); else { ",
          counted.text,
          b" }",
        ]),
      )
    },
    None -> unprinted(Spine, b"a record taken out of its place at no layout", var_said(v)),
  }

/// `v` taken out of the block a word or a case's box holds, which leaves 0, which no release reads,
/// in its place where the block is held only here and counts it again otherwise.
fn taken_from_block(
  p: Place,
  pr: Printing,
  v: Var,
  t: { of: Var, path: Path },
) -> Printing / {abort.raise} =
  match field_of(name_of(pr, t.of), t.of.rep, t.path) {
    None ->
      unprinted(
        Spine,
        b"a field taken other than out of a block's word or a case's box",
        var_said(t.of),
      ),
    Some(at) -> {
      let n = named(pr, v);
      let read = line(
        n.pr,
        p.depth,
        Bytes::concat_all([c_type(v.rep), b" ", n.name, b" = ", at.field, b";"]),
      );
      let held = Bytes::concat_all([
        b"if (ply_obj(",
        at.block,
        b")->rc == 1) ",
        at.field,
        b" = 0; else",
      ]);
      line(
        count_printed(
          { ..p, depth: p.depth + 1 },
          line(read, p.depth, held.concat(b" {")),
          Inc({ var: v, n: 1 }),
        ),
        p.depth,
        b"}",
      )
    },
  }

/// The block a field `path` reads lies in, out of a value named `name` held as `r`, and the field:
/// a block's word at its offset, or the box a sum's case holds, after its tag, its word masked where
/// the case's tag is in its low bits.
fn field_of(name: Bytes, r: Rep, path: Path) -> Option<{ block: Bytes, field: Bytes }> =
  match ((r, path)) {
    (RWord, PField(f)) -> Some({ block: name, field: slot(name, f.at) }),
    (RWord, PArg(a)) -> Some({ block: name, field: slot(name, a.at) }),
    (RSum(s), PCase(c)) -> match s.laid.cases.at(c.case) {
      Some(x) -> match x.payload {
        Boxed(b) -> {
          let word = match part_names(name, r).at(b.at) { Some(w) -> w, None -> name };
          let block = if b.stripped {
            Bytes::concat_all([
              b"((",
              word,
              b") & ~(Word)",
              ascii_of_int((1 << tag_bits()) - 1),
              b")",
            ])
          } else { word };
          Some({ block: block, field: slot(block, b.skip + c.at) })
        },
        _ -> None,
      },
      None -> None,
    },
    _ -> None,
  }

/// The tag of constructor `name`, which the unit writes in.
fn tagged(p: Place, pr: Printing, into: Option<Var>, name: Bytes) -> Printing =
  match into {
    None -> pr,
    Some(v) -> {
      let n = named(pr, v);
      pieces(n.pr, [
        Text(Bytes::concat_all([pad(p.depth), c_type(v.rep), b" ", n.name, b" = "])),
        Hole(TagOf(name)),
        Text(b";\n"),
      ])
    },
  }

/// A runtime function called by its C name with the context first, its answer a word; one that may
/// fail has its site stored first.
fn native(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  n: { name: Bytes, args: List<Arg>, uses: Uses },
) -> Printing = {
  let call = Bytes::concat_all([
    n.name,
    b"(ctx",
    Bytes::concat_all(n.args.map(|a: Arg| b", ".concat(arg_text(pr, a)))),
    b")",
  ]);
  let sited = if n.uses.fails { site(p, pr) } else { pr };
  let written = match into {
    Some(v) -> assigned(sited, p.depth, v, c_type(v.rep), call),
    None -> line(sited, p.depth, call.concat(b";")),
  };
  if n.uses.fails { check(p, written) } else { written }
}

/// The C a root's function is declared with: what it returns, each parameter's values, and the
/// pointers it writes its answer's other values through.
fn head(name: Bytes, f: Fn) -> Bytes =
  Bytes::concat_all([
    head_types(f.conv).answer,
    b" ",
    name,
    b"(PlyCtx *ctx",
    Bytes::concat_all(head_params(f.conv).map(|p: Bytes| b", ".concat(p))),
    b")",
  ])

/// The C of `m.count(n, acc)`, which answers `acc` where `n` is 0 and otherwise restarts on what
/// `restart` makes of `n - 1` and `acc`, and the part of it from the restart's arm on.
fn restart_printed(
  restart: (Arg, Arg) -> List<Arg>,
) -> { text: Bytes, arm: Bytes } / {abort.raise} = {
  let int = TyCon({ name: b"Int", args: [] });
  let local = |id: Int, rep: Rep| { id: id, ty: int, rep: rep };
  let n = local(0, RInt);
  let acc = local(1, RInt);
  let c = local(2, RBool);
  let j = local(3, RInt);
  let a = local(4, RInt);
  let let_of = |v: Var, val: Val, at: Span| Let({ var: v, val: val, at: at, unwind: [] });
  let f = {
    key: Named(b"m.count"),
    kind: Rooted,
    params: [n, acc],
    conv: {
      params: [Given, Given],
      reps: [RInt, RInt],
      answer: RInt,
      destined: false,
      answered: Owned,
    },
    answer_ty: TyCon({ name: b"Int", args: [] }),
    body: [
      let_of(c, Prim({ op: b"eq", on: RInt, args: [AVar(n), AInt(0)] }), span_between(0, 0)),
      Decl(j),
      If({
        cond: AVar(c),
        then: [Assign({ var: j, arg: AVar(acc) })],
        otherwise: [
          let_of(a, Prim({ op: b"sub", on: RInt, args: [AVar(n), AInt(1)] }), span_between(10, 15)),
          Restart(restart(AVar(a), AVar(acc))),
        ],
      }),
      Return(AVar(j)),
    ],
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  };
  let text = spelled(printed_fn(f, no_ctors()).pieces);
  {
    text: text,
    arm: match text.index_of(b"} else {") { Some(i) -> text.slice(i, text.len()), None -> b"" },
  }
}

test "a restart sets no parameter it hands on as itself" {
  let p = restart_printed(|less: Arg, acc: Arg| [less, acc]);
  assert(
    p.arm.index_of(b"p0 = ") != None && p.arm.index_of(b"p1 = ") == None,
    Some(String::of_bytes_lossy(p.text)),
  )
}

test "a restart takes its arguments into temporaries before it sets the parameters, then loops" {
  let p = restart_printed(|less: Arg, acc: Arg| [acc, less]);
  let text = p.text;
  let arm = p.arm;
  let said = Some(String::of_bytes_lossy(text));
  let in_arm = |s: Bytes| match arm.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  // Every argument is read, the second parameter's old value among them, before either is set.
  let read = in_arm(b" = p1;");
  assert(read >= 0 && read < in_arm(b"p0 = ") && read < in_arm(b"p1 = "), said);
  // Then the restart jumps back to a label the body stands at before the branch.
  let jump = in_arm(b"goto ");
  let label = match arm.slice(jump + 5, arm.len()).index_of(b";") {
    Some(end) -> arm.slice(jump + 5, jump + 5 + end),
    None -> b"",
  };
  let stands = match text.index_of(label.concat(b":")) { Some(i) -> i, None -> 0 - 1 };
  assert(
    jump > in_arm(b"p1 = ") && label.len() > 0 && stands >= 0 && stands < text.len() - arm.len(),
    said,
  )
}

fn word_var(id: Int) -> Var = { id: id, ty: TyCon({ name: b"String", args: [] }), rep: RWord }

/// A `handle` with no clauses running `body`, holding nothing across it, its answer `answer`.
fn handle_over(answer: Var, body: Block) -> Inst =
  Handle({
    body: body,
    args: [],
    uses: { takes: [], owned: false, fails: false, stops: false },
    site: { clauses: [], ret: None, detached: None, instance: None },
    answer: answer,
    unwind: [],
  })

/// The C of a root answering a word, whose body is `body` and then answers `answer`.
fn answering(answer: Var, body: Block) -> Bytes / {abort.raise} =
  spelled(
    printed_fn(
      {
        key: Named(b"m.guarded"),
        kind: Rooted,
        params: [],
        conv: { params: [], reps: [], answer: RWord, destined: false, answered: Owned },
        answer_ty: answer.ty,
        body: body.push(Return(AVar(answer))),
        lambdas: [],
        base: 0,
        members: [],
        links: no_links(),
        statics: [],
      },
      no_ctors(),
    ).pieces,
  )

/// A handle (label 1) inside another's body (label 0), its own body reading a word from a runtime
/// function that fails where `fails` says.
fn nested_handles(fails: Bool) -> Bytes / {abort.raise} = {
  let outer = word_var(0);
  let inner = word_var(1);
  let t = word_var(2);
  let probe = Let({
    var: t,
    val: Native({
      name: b"rt_probe_p",
      args: [],
      uses: { takes: [], owned: true, fails: fails, stops: false },
    }),
    at: span_between(0, 0),
    unwind: [],
  });
  answering(outer, [
    handle_over(outer, [
      handle_over(inner, [probe, Assign({ var: inner, arg: AVar(t) })]),
      Assign({ var: outer, arg: AVar(inner) }),
    ]),
  ])
}

test "a failure inside a handle's body goes to its landing, and the landing leaves by the handle's leave" {
  let failing = nested_handles(true);
  let quiet = nested_handles(false);
  assert_eq(occurrences(failing, landing_jump(1)), occurrences(quiet, landing_jump(1)) + 1);
  assert_eq(occurrences(failing, b"return "), occurrences(quiet, b"return "));
  // The inner handle's own leave is the outer one's landing, wherever its landing reads its answer.
  let after = match failing.index_of(b"ply_h1:") {
    Some(at) -> failing.slice(at, failing.len()),
    None -> b"",
  };
  assert(match after.index_of(b"ply_h0:") {
    Some(end) -> after.slice(0, end).index_of(landing_jump(0)) != None,
    None -> false,
  })
}

test "a fail inside a handle's body goes to its landing, never out of the function" {
  let answer = word_var(0);
  let set = answering(answer, [handle_over(answer, [Assign({ var: answer, arg: AZero(RWord) })])]);
  let failing = answering(answer, [
    handle_over(answer, [Fail({ why: NoArm, at: span_between(0, 0) })]),
  ]);
  assert_eq(occurrences(failing, landing_jump(0)), occurrences(set, landing_jump(0)) + 1);
  assert_eq(occurrences(failing, b"return "), occurrences(set, b"return "))
}

fn occurrences(t: Bytes, s: Bytes) -> Int / {abort.raise} = t.split(s).len() - 1

test "a tail group is one function switching on its member's place, each arm opening its member's words" {
  let int = TyCon({ name: b"Int", args: [] });
  let which = { id: 0, ty: int, rep: RInt };
  let n = { id: 1, ty: int, rep: RInt };
  let m = { id: 2, ty: int, rep: RInt };
  let conv = { params: [Given], reps: [RInt], answer: RInt, destined: false, answered: Owned };
  let text = spelled(
    printed_fn(
      {
        key: Named(b"m.even"),
        kind: Rooted,
        params: [which],
        conv: { params: [Given], reps: [RInt], answer: RWord, destined: false, answered: Owned },
        answer_ty: m.ty,
        body: [
          Case({
            on: which,
            test: TInt([0, 1]),
            arms: [
              { when: 0, body: [Enter({ member: 1, args: [AVar(n)] })] },
              { when: 1, body: [Return(AVar(m))] },
            ],
            rest: [Return(AZero(RWord))],
          }),
        ],
        lambdas: [],
        base: 0,
        members: [
          { key: Named(b"m.even"), base: 0, params: [n], conv: conv },
          { key: Named(b"m.odd"), base: 40, params: [m], conv: conv },
        ],
        links: no_links(),
        statics: [],
      },
      no_ctors(),
    ).pieces,
  );
  let g = symbol_of(b"m.even").concat(b"_group");
  let said = Some(String::of_bytes_lossy(text));
  let at = |s: Bytes| match text.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  // One function, taking the member's place beside the group's words, switching on the place.
  assert(at(g.concat(b"(PlyCtx *ctx, int which")) >= 0 && at(b"switch (which)") >= 0, said);
  // Each member's arm opens its words out of the group's, and the answering one makes its answer
  // the group's word.
  let opened = Bytes::concat_all([b" = ", word_as(b"p0", RInt), b";"]);
  let arm = |k: Int| {
    let from = at(Bytes::concat_all([b"case ", ascii_of_int(k), b":"]));
    if from < 0 { b"" } else { text.slice(from, text.len()) }
  };
  assert(arm(0).index_of(opened) != None && arm(1).index_of(opened) != None, said);
  let param = {
    let a = arm(1);
    match a.index_of(opened) {
      Some(e) -> match a.slice(0, e).split(b" ").last() { Some(p) -> p, None -> b"" },
      None -> b"",
    }
  };
  assert(arm(1).index_of(b"return ".concat(as_word(param, RInt))) != None, said);
  // Each member's entry enters the group at its own place.
  assert(at(g.concat(b"(ctx, ")) >= 0, said)
}

test "a closure's function follows its root's, and its body numbers its temporaries afresh" {
  let int = TyCon({ name: b"Int", args: [] });
  let x = { id: 0, ty: int, rep: RInt };
  let j = { id: 1, ty: int, rep: RInt };
  let body = {
    key: Named(b"m.outer"),
    kind: Rooted,
    params: [x],
    conv: { params: [Given], reps: [RInt], answer: RInt, destined: false, answered: Owned },
    answer_ty: int,
    body: [Decl(j), Assign({ var: j, arg: AVar(x) }), Return(AVar(j))],
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  };
  let l = Closure({ body: body, captures: 0, at: span_between(20, 30), words: no_closure_words() });
  let f = { ..body, lambdas: [l] };
  let name = symbol_of(b"m.outer");
  let inner = closure_printed(name, 0, l, { ..printing(Map::new()), temps: 7, labels: 3 });
  // Its first temporary is `t1`, whatever the root's printing had numbered before it.
  let body = spelled(inner.out);
  assert(body.index_of(b" t1;") != None && body.index_of(b"t8") == None, None);
  let printed = printed_fn(f, no_ctors());
  assert(
    spelled(printed.pieces).ends_with(b"}\n".concat(spelled(lambda_text(f, 0, l, inner).out))),
  );
  // A closure's descriptor names its entries, so it puts none in the code table.
  assert_eq(printed.lambdas, [])
}

test "a plain root counts no fuel or ticks; a drop root nests through the release depth and leaves by it" {
  let ty = TyCon({ name: b"m.T", args: [] });
  let o = { id: 0, ty: ty, rep: RWord };
  let plain = |op: keys::TypeOp|
    {
      key: keys::written(op, ty, b"m"),
      kind: Plain,
      params: [o],
      conv: { params: [Given], reps: [RWord], answer: RWord, destined: false, answered: Owned },
      answer_ty: ty,
      body: [If({ cond: AVar(o), then: [Restart([AVar(o)])], otherwise: [Return(AZero(RWord))] })],
      lambdas: [],
      base: 0,
      members: [],
      links: no_links(),
      statics: [],
    };
  let text_of = |op: keys::TypeOp| {
    let f = plain(op);
    let all = spelled(printed_fn(f, no_ctors()).pieces);
    // The root's own function, its entry after it aside.
    let own = Bytes::concat_all([head(symbol_of(root_text(root_name(f.key))), f), b" {"]);
    match all.index_of(own) {
      Some(i) -> match all.index_of_from(b"\n}\n", i) { Some(j) -> all.slice(i, j), None -> b"" },
      None -> b"",
    }
  };
  let dropped = text_of(keys::Drop);
  let shared = text_of(keys::Share);
  [dropped, shared].fold((), |_: Unit, t: Bytes| {
    assert(t.len() > 0, None);
    assert_eq(t.index_of(b"fuel"), None);
    assert_eq(t.index_of(b"ticks"), None);
    assert(t.index_of(b"ply_loop: ;") != None, None)
  });
  let at = |s: Bytes| match dropped.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  let deep = at(b"if (ply_drop_deep(ctx, p0, ");
  assert(deep >= 0 && deep < at(b"ply_loop:"), None);
  assert_eq(
    occurrences(dropped, b"ply_drop_done(ctx);\n  return "),
    occurrences(dropped, b"return 0;") - 1,
  );
  assert_eq(shared.index_of(b"ply_drop"), None);
  // A drop root of a case's box enters and leaves the same way.
  assert(
    text_of(keys::Cased({ op: keys::Drop, case: 1 })).index_of(b"ply_drop_deep(") != None,
    None,
  )
}

/// A root of `params` answering an `Int`, its text starting at byte 100, whose body is `body`.
fn int_root(params: List<Var>, body: Block) -> Fn =
  {
    key: Named(b"m.sited"),
    kind: Rooted,
    params: params,
    conv: {
      params: params.map(|_: Var| Given),
      reps: params.map(|v: Var| v.rep),
      answer: RInt,
      destined: false,
      answered: Owned,
    },
    answer_ty: TyCon({ name: b"Int", args: [] }),
    body: body,
    lambdas: [],
    base: 100,
    members: [],
    links: no_links(),
    statics: [],
  }

test "a lent run's failure sites name its lender and count from its text, until the run ends" {
  let int = TyCon({ name: b"Int", args: [] });
  let v = |id: Int| { id: id, ty: int, rep: RInt };
  let add = |x: Var, at: Span|
    Let({
      var: { ..x, id: x.id + 1 },
      val: Prim({ op: b"add", on: RInt, args: [AVar(x), AInt(1)] }),
      at: at,
      unwind: [],
    });
  let j = v(20);
  let main = { root: Named(b"app.main"), base: 1000 };
  let other = { root: Named(b"lib.k"), base: 2000 };
  let text = spelled(
    printed_fn(
      int_root([v(0)], [
        add(v(0), span_between(110, 115)),
        Sited(Some(main)),
        add(v(1), span_between(1004, 1009)),
        Decl(j),
        If({
          cond: ABool(true),
          then: [
            Sited(Some(other)),
            add(v(2), span_between(2001, 2003)),
            Assign({ var: j, arg: AVar(v(3)) }),
          ],
          otherwise: [Assign({ var: j, arg: AVar(v(2)) })],
        }),
        add(j, span_between(1020, 1025)),
        Sited(None),
        add(v(21), span_between(130, 135)),
        Return(AVar(v(22))),
      ]),
      no_ctors(),
    ).pieces,
  );
  let sites = text.split(b"\n").filter(|l: Bytes| l.index_of(b"PLY_SITE(") != None).map(
    |l: Bytes| match l.index_of(b"PLY_SITE(") { Some(i) -> l.slice(i, l.len()), None -> l },
  );
  let lent = |n: Bytes, from: Bytes, to: Bytes|
    Bytes::concat_all([b"PLY_SITE(ctx, ", ascii_of_int(root_id(n)), b", ", from, b", ", to, b");"]);
  assert_eq(sites, [
    b"PLY_SITE(ctx, @@r@@, 10, 15);",
    lent(b"app.main", b"4", b"9"),
    lent(b"lib.k", b"1", b"3"),
    lent(b"app.main", b"20", b"25"),
    b"PLY_SITE(ctx, @@r@@, 30, 35);",
  ])
}

test "a field taken moves out of a block held only here, in place in another or not, and is counted once more out of a shared one" {
  let block = { id: 0, ty: TyCon({ name: b"m.Buf", args: [] }), rep: RWord };
  let field = word_var(1);
  let f = {
    ..int_root([block], [Let({ var: field, val: Take({ of: block, path: PField({ name: b"bytes", at: 1 }) }), at: span_between(0, 0), unwind: [] }), Return(AInt(0))]),
    conv: { params: [Given], reps: [RWord], answer: RWord, destined: false, answered: Owned },
  };
  let text = spelled(printed_fn(f, no_ctors()).pieces);
  // Its slot is emptied where the block is held only here, and the field counted once more else.
  assert(
    text.index_of(b"ply_words(p0)[1] = 0;") != None
      && text.index_of(call_text(dup_fn(), [b"t1"])) != None,
    Some(String::of_bytes_lossy(text)),
  )
}

test "a constructor's tag is a hole the unit writes in" {
  let k = { id: 0, ty: TyCon({ name: b"Int", args: [] }), rep: RInt };
  let pr = printed_fn(
    int_root([], [
      Let({ var: k, val: Tag(b"m.Box"), at: span_between(0, 0), unwind: [] }),
      Return(AVar(k)),
    ]),
    no_ctors(),
  );
  assert(pr.pieces.contains(Hole(TagOf(b"m.Box"))))
}

/// A call of `m.g` giving it `args`, answering a word.
fn called(args: List<Arg>) -> Val =
  Call({
    callee: Root(Named(b"m.g")),
    args: args,
    conv: {
      params: args.map(|_: Arg| Given),
      reps: args.map(|_: Arg| RWord),
      answer: RWord,
      destined: false,
      answered: Owned,
    },
    stops: false,
  })

/// `v` bound to `val`, whose failure releases `unwind`.
fn holding(v: Var, val: Val, unwind: List<Var>) -> Inst =
  Let({ var: v, val: val, at: span_between(0, 0), unwind: unwind })

/// The C of a root taking `params`, each given, whose body is `body`, answering a word.
fn word_root(params: List<Var>, body: Block) -> Bytes / {abort.raise} =
  spelled(
    printed_fn(
      {
        ..int_root(params, body),
        conv: {
          params: params.map(|_: Var| Given),
          reps: params.map(|v: Var| v.rep),
          answer: RWord,
          destined: false,
          answered: Owned,
        },
      },
      no_ctors(),
    ).pieces,
  )

/// What letting go of a `String` named `name` prints: a call of its type's drop root, a hole.
fn released_text(name: Bytes) -> Bytes / {abort.raise} =
  call_text(rel_fn(), [
    b"ctx",
    name,
    spelled([Hole(Symbol(Root(drop_of(TyCon({ name: b"String", args: [] })))))]),
  ]).concat(
    b";",
  )

test "each failure releases what it holds through tails that failures holding alike share" {
  let s = word_var(0);
  let a = word_var(1);
  let b = word_var(2);
  let c = word_var(3);
  let text = word_root([s], [
    holding(a, called([]), [s]),
    holding(b, called([]), [s, a]),
    holding(c, called([AVar(a)]), [s, b]),
    Return(AVar(c)),
  ]);
  let said = Some(String::of_bytes_lossy(text));
  let at = |s: Bytes| match text.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  // Three failures holding three different sets jump to three tails.
  let jumps = text.split(b"\n").filter(|l: Bytes| l.index_of(b"if (ctx->failed) goto ") != None);
  let distinct = jumps.fold([], |acc: List<Bytes>, l: Bytes|
    if acc.contains(l) { acc } else { acc.push(l) });
  assert(jumps.len() == 3 && distinct.len() == 3, said);
  // Each value is let go of once on the failure paths, the latest declared first, and the parameter,
  // which every failure holds, by the one tail every path ends with.
  let freed = [b"t2", b"t1", b"p0"].map(|x: Bytes| released_text(x));
  assert(freed.all(|r: Bytes| occurrences(text, r) == 1), said);
  assert(at(b"return t3;") < at(freed.get(0)), said);
  assert(at(freed.get(0)) < at(freed.get(1)) && at(freed.get(1)) < at(freed.get(2)), said)
}

test "a tail stands in the block its value was declared in, and goes on to the tails of the blocks around it" {
  let s = word_var(0);
  let flag = { id: 1, ty: TyCon({ name: b"Bool", args: [] }), rep: RBool };
  let j = word_var(2);
  let a = word_var(3);
  let b = word_var(4);
  let text = word_root([s, flag], [
    Decl(j),
    If({
      cond: AVar(flag),
      then: [
        holding(a, called([]), [s]),
        holding(b, called([]), [s, a]),
        Assign({ var: j, arg: AVar(b) }),
      ],
      otherwise: [Assign({ var: j, arg: AVar(s) })],
    }),
    Return(AVar(j)),
  ]);
  let said = Some(String::of_bytes_lossy(text));
  let at = |s: Bytes| match text.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  // The arm's own value is let go of inside the arm, after its last statement, where only a
  // failure reaches; the parameter's tail stands after the function's answer.
  let arm_tail = at(released_text(b"t2"));
  assert(at(b"t1 = t3;") < arm_tail && arm_tail < at(b"} else {"), said);
  assert(at(b"return t1;") < at(released_text(b"p0")), said)
}

test "a failure inside a handle's body releases what the body holds and goes to the landing, which releases what the handle holds" {
  let s = word_var(0);
  let answer = word_var(1);
  let a = word_var(2);
  let b = word_var(3);
  let text = word_root([s], [
    Handle({
      body: [
        holding(a, called([]), []),
        holding(b, called([]), [a]),
        Assign({ var: answer, arg: AVar(b) }),
      ],
      args: [],
      uses: { takes: [], owned: false, fails: false, stops: false },
      site: { clauses: [], ret: None, detached: None, instance: None },
      answer: answer,
      unwind: [s],
    }),
    Return(AVar(answer)),
  ]);
  // The landing is where the last jump to it is; everything before is the body.
  let jumps = text.split(landing_jump(0));
  let landing = text.len() - (match jumps.last() { Some(rest) -> rest.len(), None -> 0 });
  let body = text.slice(0, landing);
  let after = text.slice(landing, text.len());
  let said = Some(String::of_bytes_lossy(text));
  // A failure in the body lets go of the body's value on its way to the landing, and not of what
  // the handle holds.
  assert(jumps.len() >= 3 && occurrences(body, released_text(b"t4")) == 1, said);
  assert_eq(occurrences(body, released_text(b"p0")), 0);
  // The landing lets go of what the handle holds where no clause answers the failure.
  assert_eq(occurrences(after, released_text(b"p0")), 1)
}

test "a value whose C tests for no failure adds no tail" {
  let s = word_var(0);
  let n = { id: 1, ty: TyCon({ name: b"Int", args: [] }), rep: RInt };
  let half = { ..n, id: 2 };
  let a = word_var(3);
  let quiet = word_root([s, n], [
    holding(half, Prim({ op: b"div", on: RInt, args: [AVar(n), AInt(2)] }), [s]),
    Return(AVar(s)),
  ]);
  assert_eq(quiet.index_of(b"goto ply_u"), None);
  assert_eq(quiet.index_of(b"ply_u0:"), None);
  // A failure after it is the first to add one.
  let then_called = word_root([s, n], [
    holding(half, Prim({ op: b"div", on: RInt, args: [AVar(n), AInt(2)] }), [s]),
    holding(a, called([]), [s]),
    Return(AVar(a)),
  ]);
  assert(then_called.index_of(b"if (ctx->failed) goto ply_u0;") != None);
  assert_eq(occurrences(then_called, b"ply_u0:"), 1)
}
