import compiler.emit.roots (symbol_of, root_id)
import compiler.emit.keys
import compiler.emit.keys (RootKey, Named, Root, Written, root_name, root_text, has_entry)
import compiler.emit.evidence (declared_arity)
import compiler.emit.reps (Ctors, no_ctors, laid_known)
import compiler.emit.layout (Boxed, tag_bits, inline_word_at, words, header_bytes)
import compiler.emit.pieces (Piece, Text, Hole, Symbol, TagOf, InGroup, LentBy, merged, spelled)
import compiler.emit.release (drop_of)
import compiler.emit.tir (no_closure_words, Rep, RInt, RBool, RWord, RFlat, RSum, RUnit, RSlice,
                          Var, Arg, AVar, AInt, ABool, AZero, Val, Prim, Literal, Static, Make,
                          TInt, Get, Take, Tag, Path, PField, PArg, PCapture, PCase, Pack, Gathered,
                          Updated, Call, Apply, Native, Op, OHandle, OContainer, OCalling, OStrings,
                          MClosure, MList, Inst, Let, Do, Decl, Assign, If, Case, Match, Miss, Loop,
                          Next, Done, Return, Restart, Enter, Fail, Handle, Sited, Lender, Inc, Dec,
                          Reset, Free, Opened, Block, Fn, Member, Rooted, Plain, Kept, Crossing,
                          Given, Owned, Lambda, Closure, Uses, NoArm, Spine, LastOf, Walked,
                          Unsettled, Data, no_links, falls_through, var_said, laid_made, PPlace)
import compiler.emit.print.text (Under, Place, Printing, Printed, printing, function_body, line,
                                 text, pieces, pad, named, name_of, arg_text, assigned, label,
                                 check, zero, failing_return, site, slot, part_names, part_name,
                                 unprinted, fuel_returned)
import compiler.emit.print.counts (exit_of, block_opened, block_closed, count_printed, walked_value,
                                   last_of, updated)
import compiler.emit.print.made (c_type, c_types, as_word, word_as, word_parts, made, got, gathered,
                                 statics, join_declared, set_parts, returned, head_types,
                                 head_params, params_opened, laid_dups, placed_write, laid_counted)
