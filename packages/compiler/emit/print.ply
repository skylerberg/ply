pub fn printed_fn(f: Fn, constructors: Constructors) -> PrintOutput / {abort.raise} = {
  let name = own_symbol(None);
  let own = if f.members.len() == 0 { root_printed(name, f, constructors) }
  else { group_printed(name, f, constructors) };
  let closures = range(0, f.lambdas.len()).fold(
    { printing: own.printing, out: [] },
    |acc: { printing: Printing, out: List<Piece> }, k: Int|
      match f.lambdas.at(k) {
        Some(l) -> {
          let t = lambda_text(name, k, l, closure_printed(name, k, l, acc.printing));
          { printing: t.printing, out: acc.out.concat(t.out) }
        },
        None -> acc,
      },
  );
  let tables = closures.printing;
  let declared = Bytes::concat_all(
    range(0, f.lambdas.len()).map(|k: Int| typed_declared(name, k, f.lambdas.get(k))),
  );
  {
    pieces: merged(
      [Text(declared)].concat(each_functions_printed(name, tables)).concat(own.out).concat(
        closures.out,
      ),
    ),
    calls: tables.calls,
    fields: tables.fields,
    lambdas: tables.lambdas,
    performs: tables.performs,
    handles: tables.handles,
    expects: tables.expects,
    shared: tables.shared,
    natives: tables.natives,
  }
}

fn root_printed(
  name: Bytes,
  f: Fn,
  constructors: Constructors,
) -> { printing: Printing, out: List<Piece> } / {abort.raise} = {
  let sited = match definition_of(f.key) {
    Some(d) -> if is_marshalling_function(d) { Some(FromCaller) } else { None },
    None -> None,
  };
  let scheduling = match definition_of(f.key) { Some(d) -> enters_scheduler(d), None -> false };
  let own = if scheduling { name.concat(b"_scheduling") } else { name };
  let body = body_printed(name, f, sited, {
    ..empty_printing(param_names(f)),
    constructors: constructors,
    count_root_type: counted_here(f.key),
  });
  let entered = if !has_entry(f.key, declared_arity(f.params), constructors.stated) {
    { printing: body, out: [] }
  } else { runtime_entry(body, name, entry_signature_of(f)) };
  let opening = match f.kind {
    Metered -> if needs_stack_check(f) { head_probe(f.convention.result) } else { b"" },
    Plain -> if !is_drop_root(f.key) { b"" }
    else { Bytes::concat_all([b"  if (ply_drop_deep(ctx, p0, ", name, b")) return 0;\n"]) },
  };
  {
    printing: entered.printing,
    out: [
      Text(
        Bytes::concat_all([
          if entered.out.len() == 0 { b"" }
          else { Bytes::concat_all([b"Word ", name, b"_entry(PlyCtx *ctx, const Word *args);\n"]) },
          if scheduling { b"static " } else { b"" },
          c_declaration(own, f),
          b" {\n",
          opening,
        ]),
      ),
    ].concat(
      body.out,
    ).push(
      Text(b"}\n"),
    ).concat(if scheduling { [Text(scheduler_entry(name, own, f))] } else { [] }).concat(
      entered.out,
    ),
  }
}

fn enters_scheduler(d: Bytes) -> Bool =
  is_marshalling_function(d) || d == scheduler_module().concat(b".simulated")
    || d == scheduler_module().concat(b".scheduled")
    || d == scheduler_module().concat(b".clocked")

fn scheduler_entry(name: Bytes, own: Bytes, f: Fn) -> Bytes =
  Bytes::concat_all([
    c_declaration(name, f),
    b" {\n  Word was = rt_scheduler_entered_p(ctx);\n  ",
    signature_types(f.convention).result,
    b" r = ",
    own,
    b"(ctx",
    Bytes::concat_all(signature_names(f.convention).map(|p: Bytes| b", ".concat(p))),
    b");\n  rt_scheduler_left_p(ctx, was);\n  return r;\n}\n",
  ])

fn group_printed(
  name: Bytes,
  f: Fn,
  constructors: Constructors,
) -> { printing: Printing, out: List<Piece> } / {abort.raise} = {
  let g = name.concat(b"_group");
  let width = f.members.fold(0, |w: Int, m: Member|
    if m.params.len() > w { m.params.len() } else { w });
  let words = range(0, width).map(|i: Int| b"p".concat(ascii_of_int(i)));
  let u = {
    symbol: name,
    base: f.base,
    result: f.convention.result,
    site: None,
    arm: None,
    looping: None,
    handler_jump: None,
    group: None,
    unwinds: [],
    epilogue: b"",
  };
  let start = {
    ..empty_printing(match f.params.at(0) { Some(which) -> Map::new().insert(which.id, b"which"), None -> Map::new() }),
    constructors: constructors,
  };
  let switched = match f.body {
    [Case(c)] -> {
      let arms = c.arms.fold(start, |pr: Printing, a: { when: Int, body: Block }|
        match f.members.at(a.when) {
          None ->
            unsupported(
              b"an arm of no member of the group",
              Bytes::concat_all([
                b"arm ",
                ascii_of_int(a.when),
                b" of ",
                ascii_of_int(f.members.len()),
                b" members",
              ]),
            ),
          Some(m) -> {
            let armed = {
              ..u,
              base: m.base,
              site: Some(InGroup(a.when)),
              group: Some({ at: a.when, members: f.members, width: width }),
            };
            let opened = range(0, m.params.len()).fold(
              block_opened(
                line(pr, 0, Bytes::concat_all([b"case ", ascii_of_int(a.when), b": {"])),
              ),
              |q: Printing, j: Int| {
                let v = m.params.get(j);
                let word = b"p".concat(ascii_of_int(j));
                if passing(v.representation) == ByReference { member_opened(q, 1, v, word) } else {
                  match v.representation {
                    AsWord -> { ..q, names: q.names.insert(v.id, word) },
                    AsFlattened(_) -> unpacked_from_word(q, v, word),
                    AsSum(_) -> unpacked_from_word(q, v, word),
                    AsUnit -> q,
                    _ ->
                      assigned(q, 1, v, c_type(v.representation), word_as(word, v.representation)),
                  }
                }
              },
            );
            line(
              block_closed(printed(armed, opened, a.body, 1), pr.block, 1, falls_through(a.body)),
              0,
              b"}",
            )
          },
        });
      block_closed(
        printed(u, line(arms, 0, b"}"), c.rest, 0),
        start.block,
        0,
        falls_through(c.rest),
      )
    },
    body ->
      unsupported(
        b"a group whose body is no case on its member's place",
        Bytes::concat_all([ascii_of_int(body.len()), b" instructions"]),
      ),
  };
  let wrappers = range(0, f.members.len()).fold(
    { printing: switched, out: [] },
    |acc: { printing: Printing, out: List<Piece> }, i: Int| {
      let w = group_wrapper(name, f, i, acc.printing);
      { printing: w.printing, out: acc.out.concat(w.out) }
    },
  );
  {
    printing: wrappers.printing,
    out: [
      Text(
        Bytes::concat_all([
          b"static Word ",
          g,
          b"(PlyCtx *ctx, int which",
          Bytes::concat_all(words.map(|w: Bytes| b", Word ".concat(w))),
          b") {\n",
          Bytes::concat_all(group_buffers(f).map(|d: Bytes| Bytes::concat_all([b"  ", d, b"\n"]))),
          record_declared(switched),
          b"  ply_loop: ",
          probe(f.convention.result),
          b"\n  switch (which) {\n",
        ]),
      ),
    ].concat(
      switched.out,
    ).push(
      Text(b"}\n"),
    ).concat(
      wrappers.out,
    ),
  }
}

fn moved_to_destination(
  pr: Printing,
  a: Arg,
) -> { printing: Printing, text: Bytes } / {abort.raise} =
  match a {
    VarOperand(x) -> if !pr.placing.destination_passing || pr.placing.results.contains(x.id) {
      { printing: pr, text: b"" }
    } else {
      match known_layout(pr.constructors, x.ty) {
        Some(l) -> {
          let moved = write_inline(pr, b"*(Word *)d", b"ply_words(d)", name_of(pr, x), l);
          {
            printing: moved.printing,
            text: Bytes::concat_all([b"  if (d) { ", moved.text, b" return d; }\n"]),
          }
        },
        None -> { printing: pr, text: b"" },
      }
    },
    _ -> { printing: pr, text: b"" },
  }

fn unpacked_from_word(pr: Printing, v: Var, word: Bytes) -> Printing = {
  let n = named(pr, v);
  pieces(
    n.printing,
    [Text(pad(1))].concat(
      word_to_parts(word, v.representation, part_names(n.name, v.representation)),
    ).push(
      Text(b"\n"),
    ),
  )
}

fn is_drop_root(k: RootKey) -> Bool =
  match k {
    Generated(w, _) -> match w.op {
      keys::Drop -> true,
      keys::OnCase(c) -> c.op == keys::Drop,
      _ -> false,
    },
    _ -> false,
  }

fn counted_here(k: RootKey) -> Option<Type> =
  match k { Generated(w, _) -> match w.op { keys::Unboxed(_) -> Some(w.ty), _ -> None }, _ -> None }

fn return_epilogue(f: Fn) -> Bytes =
  match f.kind { Plain -> if is_drop_root(f.key) { b"ply_drop_done(ctx);" } else { b"" }, _ -> b"" }

fn param_names(f: Fn) -> Map<Int, Bytes> / {abort.raise} =
  range(0, f.params.len()).fold(Map::new(), |m: Map<Int, Bytes>, i: Int|
    m.insert(f.params.get(i).id, b"p".concat(ascii_of_int(i))))

fn closure_printed(symbol: Bytes, nth: Int, l: Lambda, pr: Printing) -> Printing / {abort.raise} =
  match l {
    Closure(c) -> body_printed(symbol, c.body, None, function_body(pr, lambda_names(l, nth))),
  }

fn body_printed(
  symbol: Bytes,
  f: Fn,
  sited: Option<FailureOwner>,
  given: Printing,
) -> Printing / {abort.raise} = {
  let kept = if sited == Some(FromCaller) {
    line(
      given,
      0,
      b"const int64_t ply_called[3] = { ctx->site_root, ctx->site_start, ctx->site_end };",
    )
  } else { given };
  let pr = { ..kept, placing: destinations_of(f) };
  let u = {
    symbol: symbol,
    base: f.base,
    result: f.convention.result,
    site: sited,
    arm: None,
    looping: None,
    handler_jump: match f.links.pending { Some(_) -> Some(b"goto ply_pending;"), None -> None },
    group: None,
    unwinds: [],
    epilogue: return_epilogue(f),
  };
  let opened = params_opened(f.params.map(|v: Var| name_of(pr, v)), reps_of(f.convention)).fold(
    pr,
    |q: Printing, l: Bytes| line(q, 0, l),
  );
  let viewed = declare_list_views(f, opened);
  let probed = match f.kind { Metered -> probe(f.convention.result), _ -> b";" };
  let looped = if restarts(f.body) {
    text(viewed, Bytes::concat_all([b"  ply_loop: ", probed, b"\n"]))
  } else { viewed };
  let body = block_closed(printed(u, looped, f.body, 0), pr.block, 0, falls_through(f.body));
  let closed = match f.links.pending {
    None -> body,
    Some(pd) ->
      text(
        body,
        Bytes::concat_all([
          b"  ply_pending: ply_pending_raised(ctx, ",
          name_of(body, pd.word),
          b", ",
          ascii_of_int(pd.index),
          b", (Word)(intptr_t)&",
          pd.op,
          b", (Word)(intptr_t)&",
          pd.string,
          b");\n  ",
          failing_return(f.convention.result),
          b"\n",
        ]),
      ),
  };
  let done = { ..closed, placing: given.placing };
  let record = record_declared(done);
  if record.len() == 0 { done } else { { ..done, out: [Text(record)].concat(done.out) } }
}

fn declare_list_views(f: Fn, pr: Printing) -> Printing =
  range(0, f.params.len()).fold(pr, |q: Printing, i: Int|
    match f.params.at(i) {
      Some(v) -> if v.representation != AsListView || param_rep(f.convention, i) != Some(AsWord) {
        q
      } else {
        let word = name_of(q, v);
        line(
          q,
          0,
          Bytes::concat_all([
            b"Word ",
            part_name(word, 0),
            b" = ",
            word,
            b"; int64_t ",
            part_name(word, 1),
            b" = 0;",
          ]),
        )
      },
      None -> q,
    })

fn restarts(b: Block) -> Bool = any_inst(b, |i: Inst| match i { Restart(_) -> true, _ -> false })

fn needs_stack_check(f: Fn) -> Bool =
  !restarts(f.body) && (match f.key { Generated(_, _) -> true, _ -> calls_in(f.body) })

fn failure_target(u: BodyContext) -> Bytes =
  match u.handler_jump { Some(j) -> j, None -> failing_return(u.result) }

fn exiting(
  p: InstructionContext,
  pr: Printing,
  unwind: List<Var>,
  into: Option<Var>,
  value: Rvalue,
) -> Printing / {abort.raise} = {
  let x = failure_exit_through(pr, p.u.unwinds, unwind, failure_target(p.u));
  let l = site_linked({ ..p, exit_statement: x.leave }, x.printing, unwind, value);
  let after = unlinked(
    value_printed({ ..p, exit_statement: l.leave }, l.printing, into, value),
    p.depth,
    l,
  );
  if x.printing.tails.all.len() == pr.tails.all.len()
      || range(pr.out.len(), after.out.len()).any(|i: Int|
        match after.out.at(i) { Some(Text(t)) -> t.index_of(x.leave) != None, _ -> false }) {
    after
  } else { { ..after, tails: pr.tails } }
}

type BlockState = { printing: Printing, context: BodyContext, outer: List<BodyContext> }

fn with_cleanup_scope(s: BlockState, held: Option<List<Unwinding>>) -> BlockState =
  match held {
    Some(xs) -> {
      let id = |x: Unwinding| match operand_var(x.arg) { Some(v) -> v.id, None -> -1 };
      let ids = xs.map(id);
      let around = s.context.unwinds.filter(|x: Unwinding| !ids.contains(id(x)));
      { ..s, context: { ..s.context, unwinds: xs.concat(around) }, outer: s.outer.push(s.context) }
    },
    None -> match s.outer.at(s.outer.len() - 1) {
      Some(o) -> { ..s, context: o, outer: s.outer.take(s.outer.len() - 1) },
      None -> s,
    },
  }

fn with_site_scope(s: BlockState, borrowed: Option<SiteOrigin>) -> BlockState =
  match borrowed {
    Some(l) ->
      {
        ..s,
        context: { ..s.context, site: Some(LambdaOwner(l.root)), base: l.base },
        outer: s.outer.push(s.context),
      },
    None -> match s.outer.at(s.outer.len() - 1) {
      Some(o) -> { ..s, context: o, outer: s.outer.take(s.outer.len() - 1) },
      None -> s,
    },
  }

fn printed(home: BodyContext, pr: Printing, b: Block, depth: Int) -> Printing / {abort.raise} =
  b.fold({ printing: pr, context: home, outer: [] }, |sites: BlockState, i: Inst| {
    let u = sites.context;
    let acc = sites.printing;
    let p = { u: u, at: span_between(0, 0), exit_statement: failure_target(u), depth: depth };
    let inner = depth + 1;
    match i {
      SiteScope(borrowed) -> with_site_scope(sites, borrowed),
      CleanupScope(held) -> with_cleanup_scope(sites, held),
      _ ->
        {
          ..sites,
          printing: match i {
            Let(l) -> exiting({ ..p, at: l.at }, acc, l.unwind, Some(l.var), l.value),
            Do(d) -> exiting({ ..p, at: d.at }, acc, d.unwind, None, d.value),
            Declaration(v) -> join_declared(acc, depth, v),
            Assign(s) -> set_parts(acc, depth, s.var, s.arg),
            If(x) -> {
              let opened = line(
                acc,
                depth,
                Bytes::concat_all([b"if (", arg_text(acc, x.cond), b") {"]),
              );
              let t = block_closed(
                printed(u, block_opened(opened), x.then, inner),
                acc.block,
                inner,
                falls_through(x.then),
              );
              let e = block_closed(
                printed(u, block_opened(line(t, depth, b"} else {")), x.otherwise, inner),
                acc.block,
                inner,
                falls_through(x.otherwise),
              );
              line(e, depth, b"}")
            },
            Case(c) -> {
              let arms = c.arms.fold(
                case_opened(p, acc, c.on, c.test),
                |q: Printing, a: { when: Int, body: Block }|
                  case_arm_closed(
                    p,
                    block_closed(
                      printed(u, block_opened(case_arm(p, q, c.on, c.test, a.when)), a.body, inner),
                      acc.block,
                      inner,
                      falls_through(a.body),
                    ),
                  ),
              );
              case_closed(
                p,
                block_closed(
                  printed(u, block_opened(case_rest(p, arms, c.on, c.test)), c.rest, inner),
                  acc.block,
                  inner,
                  falls_through(c.rest),
                ),
              )
            },
            Match(m) -> {
              let l = label(acc);
              let arms = m.arms.fold(
                { printing: match_opened(p, l.printing, l.n, m.arms.len()), at: 0 },
                |q: { printing: Printing, at: Int }, a: Block| {
                  let armed = printed(
                    { ..u, arm: Some({ label: l.n, at: q.at }) },
                    match_arm(p, q.printing, l.n, q.at),
                    a,
                    depth,
                  );
                  {
                    printing: if falls_through(a) { match_arm_closed(p, armed, l.n, q.at) }
                    else { armed },
                    at: q.at + 1,
                  }
                },
              );
              match_closed(
                p,
                printed(u, match_rest(p, arms.printing, l.n, m.arms.len()), m.rest, depth),
                l.n,
              )
            },
            Miss -> match u.arm {
              Some(a) -> next_arm_jump(p, acc, a.label, a.at),
              None -> unsupported(b"a miss outside a match", b"Miss"),
            },
            Fail(x) -> {
              let out = failure_exit_through(acc, x.resource, x.unwind, failure_target(u));
              failed({ ..p, at: x.at, exit_statement: out.leave }, out.printing, x.reason)
            },
            Loop(lp) -> {
              let l = label(acc);
              let looped = {
                ..u,
                looping: Some({
                  label: l.n,
                  state: carried_variables(lp.state),
                  result: lp.result,
                }),
              };
              loop_closed(
                p,
                block_closed(
                  printed(
                    looped,
                    block_opened(loop_opened(p, l.printing, l.n, lp.state, lp.result)),
                    lp.body,
                    inner,
                  ),
                  acc.block,
                  inner,
                  falls_through(lp.body),
                ),
                l.n,
                lp.result,
              )
            },
            Next(args) -> match u.looping {
              Some(lp) -> next(p, acc, lp.label, lp.state, args),
              None ->
                unsupported(
                  b"a next pass outside a loop",
                  Bytes::concat_all([b"Next of ", ascii_of_int(args.len()), b" values"]),
                ),
            },
            Done(a) -> match u.looping {
              Some(lp) -> loop_done(p, acc, lp.label, lp.result, a),
              None -> unsupported(b"a loop's result outside a loop", b"Done"),
            },
            Return(a) -> match u.group {
              Some(_) -> member_returned(p, acc, a),
              None -> {
                let r = write_return_value(acc, depth, a);
                let leaving = if u.epilogue == b"" { b"" }
                else { Bytes::concat_all([b"  ", u.epilogue, b"\n"]) };
                let moved = moved_to_destination(r.printing, a);
                text(
                  moved.printing,
                  Bytes::concat_all([leaving, moved.text, b"  return ", r.value, b";\n"]),
                )
              },
            },
            Restart(args) -> match u.group {
              Some(g) -> entered_member(p, acc, g.at, args),
              None -> restarted(p, acc, args),
            },
            Jump(e) -> entered_member(p, acc, e.member, e.args),
            Handle(h) -> {
              let l = label(acc);
              let x = failure_exit_through(l.printing, u.unwinds, h.unwind, failure_target(u));
              let f = handle_linked(
                { ..p, exit_statement: x.leave },
                x.printing,
                l.n,
                h.body,
                h.site,
                h.unwind,
              );
              let hp = { ..p, exit_statement: f.leave };
              let inside = { ..u, handler_jump: Some(landing_jump(l.n)), unwinds: [] };
              let opened = handle_opened(hp, f.printing, l.n, h.args, h.uses, h.site, h.result);
              unlinked(
                handle_closed(
                  hp,
                  if h.site.detached != None { printed(inside, opened, h.body, inner) } else {
                    block_closed(
                      printed(inside, block_opened(opened), h.body, inner),
                      acc.block,
                      inner,
                      falls_through(h.body),
                    )
                  },
                  l.n,
                  h.args,
                  h.site,
                  h.result,
                ),
                depth,
                f,
              )
            },
            Inc(_) -> count_printed(p, acc, i),
            Dec(_) -> count_printed(p, acc, i),
            Reset(_) -> count_printed(p, acc, i),
            Free(_) -> count_printed(p, acc, i),
            Destructure(_) -> count_printed(p, acc, i),
            SiteScope(_) -> acc,
            CleanupScope(_) -> acc,
          },
        },
    }
  }).printing

fn value_printed(
  p: InstructionContext,
  pr: Printing,
  into: Option<Var>,
  value: Rvalue,
) -> Printing / {abort.raise} =
  match value {
    Primitive(x) -> primitive(p, pr, into, x),
    Literal(l) -> literal(p, pr, into, l),
    Static(n) -> static_word(p, pr, into, n),
    Allocate(m) -> match base_allocation(m.made) {
      ClosureAllocation(_) -> closure_made(p, pr, into, m),
      ListAllocation(_) -> list_printed(p, pr, into, m),
      _ -> value_printing(p, pr, into, m),
    },
    Get(g) -> match g.path {
      CapturePath(i) -> capture_printed(p, pr, into, g.of, i),
      _ -> get_printed(p, pr, into, g),
    },
    Take(t) -> taken(p, pr, into, t),
    Tag(name) -> tagged(p, pr, into, name),
    Convert(k) -> representation_converted(p, pr, into, k),
    Aggregate(g) -> build_value(p, pr, into, g.parts),
    Update(u) -> updated(p, pr, into, u),
    Call(c) -> call(p, pr, into, c),
    Apply(c) -> applied(p, pr, into, c),
    Native(n) -> native(p, pr, into, n),
    Op(o) -> match o.op {
      OfHandling(h) -> effect_op(p, pr, into, h, o.args, o.uses),
      OfContainers(x) -> container_op(p, pr, into, x, o.args, o.uses),
      OfCalling(x) -> calling_op(p, pr, into, x, o.args, o.uses),
      OfStrings(x) -> string_op(p, pr, into, x, o.args),
    },
    IfUnique(v) -> last_of(p, pr, into, v),
    WalkLoop(w) -> walk_value(p, pr, into, w.of, w.op),
    OperandsOnly(_) ->
      unsupported(b"what only a specialisation computes", b"a body its callers resolve"),
  }

fn taken(
  p: InstructionContext,
  pr: Printing,
  into: Option<Var>,
  t: { of: Var, path: Path },
) -> Printing / {abort.raise} =
  match into {
    None -> unsupported(b"a field taken that nothing holds", var_text(t.of)),
    Some(v) -> match match ((t.of.representation, t.path)) {
        (AsSum(s), CasePath(c)) -> inline_word_at(s.layout, c.case, c.at),
        _ -> None,
      } {
      Some(w) -> {
        let name = name_of(pr, t.of);
        let word = match part_names(name, t.of.representation).at(w) { Some(x) -> x, None -> name };
        let n = named(pr, v);
        line(
          line(
            n.printing,
            p.depth,
            Bytes::concat_all([c_type(v.representation), b" ", n.name, b" = ", word, b";"]),
          ),
          p.depth,
          word.concat(b" = 0;"),
        )
      },
      None -> match t.path {
        InlineRecordPath(at) -> taken_from_inline_record(p, pr, v, t.of, at),
        _ -> taken_from_block(p, pr, v, t),
      },
    },
  }

fn taken_from_inline_record(
  p: InstructionContext,
  pr: Printing,
  v: Var,
  of: Var,
  at: Int,
) -> Printing / {abort.raise} =
  match known_layout(pr.constructors, v.ty) {
    Some(l) -> {
      let m = words(l);
      let block = name_of(pr, of);
      let n = named(pr, v);
      let place = Bytes::concat_all([b"&", slot(block, at + 1)]);
      let bytes = int_literal(8 * m);
      let counted = layout_retain_at(
        n.printing,
        l,
        Bytes::concat_all([b"ply_words(", n.name, b")"]),
      );
      line(
        counted.printing,
        p.depth,
        Bytes::concat_all([
          b"Word ",
          n.name,
          b" = ply_alloc(ctx, ",
          int_literal(header_bytes() + 8 * m),
          b"); memcpy(ply_words(",
          n.name,
          b"), ",
          place,
          b", ",
          bytes,
          b"); if (ply_obj(",
          block,
          b")->rc == 1) memset(",
          place,
          b", 0, ",
          bytes,
          b"); else { ",
          counted.text,
          b" }",
        ]),
      )
    },
    None -> unsupported(b"a record taken out of its place at no layout", var_text(v)),
  }

fn taken_from_block(
  p: InstructionContext,
  pr: Printing,
  v: Var,
  t: { of: Var, path: Path },
) -> Printing / {abort.raise} =
  match field_of(name_of(pr, t.of), t.of.representation, t.path) {
    None ->
      unsupported(
        b"a field taken other than out of a block's word or a case's box",
        var_text(t.of),
      ),
    Some(at) -> {
      let n = named(pr, v);
      let read = line(
        n.printing,
        p.depth,
        Bytes::concat_all([c_type(v.representation), b" ", n.name, b" = ", at.field, b";"]),
      );
      let held = Bytes::concat_all([
        b"if (ply_obj(",
        at.block,
        b")->rc == 1) ",
        at.field,
        b" = 0; else",
      ]);
      line(
        count_printed(
          { ..p, depth: p.depth + 1 },
          line(read, p.depth, held.concat(b" {")),
          Inc({ var: v, n: 1 }),
        ),
        p.depth,
        b"}",
      )
    },
  }

fn field_of(name: Bytes, r: Representation, path: Path) -> Option<{ block: Bytes, field: Bytes }> =
  match ((r, path)) {
    (AsWord, FieldPath(f)) -> Some({ block: name, field: slot(name, f.at) }),
    (AsWord, ArgumentPath(a)) -> Some({ block: name, field: slot(name, a.at) }),
    (AsSum(s), CasePath(c)) -> match s.layout.cases.at(c.case) {
      Some(x) -> match x.payload {
        Boxed(b) -> {
          let word = match part_names(name, r).at(b.at) { Some(w) -> w, None -> name };
          let block = if b.stripped {
            Bytes::concat_all([
              b"((",
              word,
              b") & ~(Word)",
              ascii_of_int((1 << tag_bits()) - 1),
              b")",
            ])
          } else { word };
          Some({ block: block, field: slot(block, b.skip + c.at) })
        },
        _ -> None,
      },
      None -> None,
    },
    _ -> None,
  }

fn tagged(p: InstructionContext, pr: Printing, into: Option<Var>, name: Bytes) -> Printing =
  match into {
    None -> pr,
    Some(v) -> {
      let n = named(pr, v);
      pieces(n.printing, [
        Text(Bytes::concat_all([pad(p.depth), c_type(v.representation), b" ", n.name, b" = "])),
        Hole(ConstructorTag(name)),
        Text(b";\n"),
      ])
    },
  }

fn native(
  p: InstructionContext,
  pr: Printing,
  into: Option<Var>,
  n: { name: Bytes, args: List<Arg>, uses: OperationSignature },
) -> Printing / {abort.raise} = {
  let call = Bytes::concat_all([
    n.name,
    b"(ctx",
    Bytes::concat_all(n.args.map(|a: Arg| b", ".concat(arg_text(pr, a)))),
    b")",
  ]);
  let noted = match builtin_pointed(n.name) { Some(h) -> native_noted(pr, h), None -> pr };
  let sited = if n.uses.fails { source_position(p, noted) } else { noted };
  let written = match into {
    Some(v) -> assigned(sited, p.depth, v, c_type(v.representation), call),
    None -> line(sited, p.depth, call.concat(b";")),
  };
  if n.uses.fails { check(p, written) } else { written }
}

fn c_declaration(name: Bytes, f: Fn) -> Bytes =
  Bytes::concat_all([
    signature_types(f.convention).result,
    b" ",
    name,
    b"(PlyCtx *ctx",
    Bytes::concat_all(signature_parameters(f.convention).map(|p: Bytes| b", ".concat(p))),
    b")",
  ])

fn restart_printed(
  restart: (Arg, Arg) -> List<Arg>,
) -> { text: Bytes, arm: Bytes } / {abort.raise} = {
  let int = int_type();
  let local = |id: Int, rep: Representation| { id: id, ty: int, representation: rep };
  let n = local(0, AsInt);
  let acc = local(1, AsInt);
  let c = local(2, AsBool);
  let j = local(3, AsInt);
  let a = local(4, AsInt);
  let let_of = |v: Var, value: Rvalue, at: Span| Let({ var: v, value: value, at: at, unwind: [] });
  let f = {
    key: Named(b"m.count"),
    kind: Metered,
    params: [n, acc],
    convention: {
      params: [
        { ownership: OwnedParam, representation: AsInt },
        { ownership: OwnedParam, representation: AsInt },
      ],
      result: AsInt,
      destination_passing: false,
      returned: OwnedResult,
    },
    result_type: int_type(),
    body: [
      let_of(
        c,
        Primitive({ op: b"eq", on: AsInt, args: [VarOperand(n), IntOperand(0)] }),
        span_between(0, 0),
      ),
      Declaration(j),
      If({
        cond: VarOperand(c),
        then: [Assign({ var: j, arg: VarOperand(acc) })],
        otherwise: [
          let_of(
            a,
            Primitive({ op: b"sub", on: AsInt, args: [VarOperand(n), IntOperand(1)] }),
            span_between(10, 15),
          ),
          Restart(restart(VarOperand(a), VarOperand(acc))),
        ],
      }),
      Return(VarOperand(j)),
    ],
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  };
  let text = pieces_text(printed_fn(f, no_constructors()).pieces);
  {
    text: text,
    arm: match text.index_of(b"} else {") { Some(i) -> text.slice(i, text.len()), None -> b"" },
  }
}

test "a restart sets no parameter it hands on as itself" {
  let p = restart_printed(|less: Arg, acc: Arg| [less, acc]);
  assert(
    p.arm.index_of(b"p0 = ") != None && p.arm.index_of(b"p1 = ") == None,
    Some(String::of_bytes_lossy(p.text)),
  )
}

test "a restart takes its arguments into temporaries before it sets the parameters, then loops" {
  let p = restart_printed(|less: Arg, acc: Arg| [acc, less]);
  let text = p.text;
  let arm = p.arm;
  let said = Some(String::of_bytes_lossy(text));
  let in_arm = |s: Bytes| match arm.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  let read = in_arm(b" = p1;");
  assert(read >= 0 && read < in_arm(b"p0 = ") && read < in_arm(b"p1 = "), said);
  let jump = in_arm(b"goto ");
  let label = match arm.slice(jump + 5, arm.len()).index_of(b";") {
    Some(end) -> arm.slice(jump + 5, jump + 5 + end),
    None -> b"",
  };
  let stands = match text.index_of(label.concat(b":")) { Some(i) -> i, None -> 0 - 1 };
  assert(
    jump > in_arm(b"p1 = ") && label.len() > 0 && stands >= 0 && stands < text.len() - arm.len(),
    said,
  )
}

fn word_var(id: Int) -> Var = { id: id, ty: string_type(), representation: AsWord }

fn handle_over(result: Var, body: Block) -> Inst =
  Handle({
    body: body,
    args: [],
    uses: { takes: [], owned: false, fails: false, suspends: false },
    site: { clauses: [], ret: None, detached: None, instance: empty_instance(0) },
    result: result,
    unwind: [],
  })

fn returning(result: Var, body: Block) -> Bytes / {abort.raise} =
  pieces_text(
    printed_fn(
      {
        key: Named(b"m.guarded"),
        kind: Metered,
        params: [],
        convention: {
          params: [],
          result: AsWord,
          destination_passing: false,
          returned: OwnedResult,
        },
        result_type: result.ty,
        body: body.push(Return(VarOperand(result))),
        lambdas: [],
        base: 0,
        members: [],
        links: no_links(),
        statics: [],
      },
      no_constructors(),
    ).pieces,
  )

fn nested_handle_text(fails: Bool) -> Bytes / {abort.raise} = {
  let outer = word_var(0);
  let inner = word_var(1);
  let t = word_var(2);
  let probe = Let({
    var: t,
    value: Native({
      name: b"rt_probe_p",
      args: [],
      uses: { takes: [], owned: true, fails: fails, suspends: false },
    }),
    at: span_between(0, 0),
    unwind: [],
  });
  returning(outer, [
    handle_over(outer, [
      handle_over(inner, [probe, Assign({ var: inner, arg: VarOperand(t) })]),
      Assign({ var: outer, arg: VarOperand(inner) }),
    ]),
  ])
}

test "a failure inside a handle's body goes to its landing, and the landing leaves by the handle's leave" {
  let failing = nested_handle_text(true);
  let quiet = nested_handle_text(false);
  assert_eq(occurrences(failing, landing_jump(1)), occurrences(quiet, landing_jump(1)) + 1);
  assert_eq(occurrences(failing, b"return "), occurrences(quiet, b"return "));
  let after = match failing.index_of(b"ply_h1:") {
    Some(at) -> failing.slice(at, failing.len()),
    None -> b"",
  };
  assert(match after.index_of(b"ply_h0:") {
    Some(end) -> after.slice(0, end).index_of(landing_jump(0)) != None,
    None -> false,
  })
}

test "a fail inside a handle's body goes to its landing, never out of the function" {
  let result = word_var(0);
  let set = returning(result, [
    handle_over(result, [Assign({ var: result, arg: ZeroOperand(AsWord) })]),
  ]);
  let failing = returning(result, [
    handle_over(result, [
      Fail({ reason: NoMatchingArm, at: span_between(0, 0), resource: [], unwind: [] }),
    ]),
  ]);
  assert_eq(occurrences(failing, landing_jump(0)), occurrences(set, landing_jump(0)) + 1);
  assert_eq(occurrences(failing, b"return "), occurrences(set, b"return "))
}

fn occurrences(t: Bytes, s: Bytes) -> Int / {abort.raise} = t.split(s).len() - 1

test "a tail group is one function switching on its member's place, each arm opening its member's words" {
  let int = int_type();
  let which = { id: 0, ty: int, representation: AsInt };
  let n = { id: 1, ty: int, representation: AsInt };
  let m = { id: 2, ty: int, representation: AsInt };
  let conv = {
    params: [{ ownership: OwnedParam, representation: AsInt }],
    result: AsInt,
    destination_passing: false,
    returned: OwnedResult,
  };
  let text = pieces_text(
    printed_fn(
      {
        key: Named(b"m.even"),
        kind: Metered,
        params: [which],
        convention: {
          params: [{ ownership: OwnedParam, representation: AsInt }],
          result: AsWord,
          destination_passing: false,
          returned: OwnedResult,
        },
        result_type: m.ty,
        body: [
          Case({
            on: which,
            test: IntTest([0, 1]),
            arms: [
              { when: 0, body: [Jump({ member: 1, args: [VarOperand(n)] })] },
              { when: 1, body: [Return(VarOperand(m))] },
            ],
            rest: [Return(ZeroOperand(AsWord))],
          }),
        ],
        lambdas: [],
        base: 0,
        members: [
          { key: Named(b"m.even"), base: 0, params: [n], convention: conv },
          { key: Named(b"m.odd"), base: 40, params: [m], convention: conv },
        ],
        links: no_links(),
        statics: [],
      },
      no_constructors(),
    ).pieces,
  );
  let g = own_symbol(None).concat(b"_group");
  let said = Some(String::of_bytes_lossy(text));
  let at = |s: Bytes| match text.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  assert(at(g.concat(b"(PlyCtx *ctx, int which")) >= 0 && at(b"switch (which)") >= 0, said);
  let opened = Bytes::concat_all([b" = ", word_as(b"p0", AsInt), b";"]);
  let arm = |k: Int| {
    let from = at(Bytes::concat_all([b"case ", ascii_of_int(k), b":"]));
    if from < 0 { b"" } else { text.slice(from, text.len()) }
  };
  assert(arm(0).index_of(opened) != None && arm(1).index_of(opened) != None, said);
  let param = {
    let a = arm(1);
    match a.index_of(opened) {
      Some(e) -> match a.slice(0, e).split(b" ").last() { Some(p) -> p, None -> b"" },
      None -> b"",
    }
  };
  assert(arm(1).index_of(b"return ".concat(as_word(param, AsInt))) != None, said);
  assert(at(g.concat(b"(ctx, ")) >= 0, said)
}

test "a closure's function follows its root's, and its body numbers its temporaries afresh" {
  let int = int_type();
  let x = { id: 0, ty: int, representation: AsInt };
  let j = { id: 1, ty: int, representation: AsInt };
  let body = {
    key: Named(b"m.outer"),
    kind: Metered,
    params: [x],
    convention: {
      params: [{ ownership: OwnedParam, representation: AsInt }],
      result: AsInt,
      destination_passing: false,
      returned: OwnedResult,
    },
    result_type: int,
    body: [Declaration(j), Assign({ var: j, arg: VarOperand(x) }), Return(VarOperand(j))],
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  };
  let l = Closure({
    body: body,
    captures: 0,
    at: span_between(20, 30),
    words: no_closure_evidence(),
  });
  let f = { ..body, lambdas: [l] };
  let name = own_symbol(None);
  let inner = closure_printed(name, 0, l, { ..empty_printing(Map::new()), temps: 7, labels: 3 });
  let body = pieces_text(inner.out);
  assert(body.index_of(b" t1;") != None && body.index_of(b"t8") == None, None);
  let printed = printed_fn(f, no_constructors());
  assert(
    pieces_text(printed.pieces).ends_with(
      b"}\n".concat(pieces_text(lambda_text(name, 0, l, inner).out)),
    ),
  );
  assert_eq(printed.lambdas, [])
}

test "a plain root never probes the stack; a drop root nests through the release depth and leaves by it" {
  let ty = NamedType({ name: b"m.T", args: [] });
  let o = { id: 0, ty: ty, representation: AsWord };
  let plain = |op: keys::TypeOp|
    {
      key: keys::generated_key(op, ty, b"m"),
      kind: Plain,
      params: [o],
      convention: {
        params: [{ ownership: OwnedParam, representation: AsWord }],
        result: AsWord,
        destination_passing: false,
        returned: OwnedResult,
      },
      result_type: ty,
      body: [
        If({
          cond: VarOperand(o),
          then: [Restart([VarOperand(o)])],
          otherwise: [Return(ZeroOperand(AsWord))],
        }),
      ],
      lambdas: [],
      base: 0,
      members: [],
      links: no_links(),
      statics: [],
    };
  let text_of = |op: keys::TypeOp| {
    let f = plain(op);
    let all = pieces_text(printed_fn(f, no_constructors()).pieces);
    let own = Bytes::concat_all([c_declaration(own_symbol(None), f), b" {"]);
    match all.index_of(own) {
      Some(i) -> match all.index_of_from(b"\n}\n", i) { Some(j) -> all.slice(i, j), None -> b"" },
      None -> b"",
    }
  };
  let dropped = text_of(keys::Drop);
  let shared = text_of(keys::Share);
  [dropped, shared].fold((), |_: Unit, t: Bytes| {
    assert(t.len() > 0, None);
    assert_eq(t.index_of(probed_fn()), None);
    assert(t.index_of(b"ply_loop: ;") != None, None)
  });
  let at = |s: Bytes| match dropped.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  let deep = at(b"if (ply_drop_deep(ctx, p0, ");
  assert(deep >= 0 && deep < at(b"ply_loop:"), None);
  assert_eq(
    occurrences(dropped, b"ply_drop_done(ctx);\n  return "),
    occurrences(dropped, b"return 0;") - 1,
  );
  assert_eq(shared.index_of(b"ply_drop"), None);
  assert(
    text_of(keys::OnCase({ op: keys::Drop, case: 1 })).index_of(b"ply_drop_deep(") != None,
    None,
  )
}

fn int_root(params: List<Var>, body: Block) -> Fn =
  {
    key: Named(b"m.sited"),
    kind: Metered,
    params: params,
    convention: {
      params: owned_params(params.map(|v: Var| v.representation)),
      result: AsInt,
      destination_passing: false,
      returned: OwnedResult,
    },
    result_type: int_type(),
    body: body,
    lambdas: [],
    base: 100,
    members: [],
    links: no_links(),
    statics: [],
  }

test "a borrowed run's failure sites name its lender and count from its text, until the run ends" {
  let int = int_type();
  let v = |id: Int| { id: id, ty: int, representation: AsInt };
  let add = |x: Var, at: Span|
    Let({
      var: { ..x, id: x.id + 1 },
      value: Primitive({ op: b"add", on: AsInt, args: [VarOperand(x), IntOperand(1)] }),
      at: at,
      unwind: [],
    });
  let j = v(20);
  let main = { root: Named(b"app.main"), base: 1000 };
  let other = { root: Named(b"lib.k"), base: 2000 };
  let text = pieces_text(
    printed_fn(
      int_root([v(0)], [
        add(v(0), span_between(110, 115)),
        SiteScope(Some(main)),
        add(v(1), span_between(1004, 1009)),
        Declaration(j),
        If({
          cond: BoolOperand(true),
          then: [
            SiteScope(Some(other)),
            add(v(2), span_between(2001, 2003)),
            Assign({ var: j, arg: VarOperand(v(3)) }),
          ],
          otherwise: [Assign({ var: j, arg: VarOperand(v(2)) })],
        }),
        add(j, span_between(1020, 1025)),
        SiteScope(None),
        add(v(21), span_between(130, 135)),
        Return(VarOperand(v(22))),
      ]),
      no_constructors(),
    ).pieces,
  );
  let sites = text.split(b"\n").filter(|l: Bytes| l.index_of(b"PLY_SITE(") != None).map(
    |l: Bytes| match l.index_of(b"PLY_SITE(") { Some(i) -> l.slice(i, l.len()), None -> l },
  );
  let borrowed = |n: Bytes, from: Bytes, to: Bytes|
    Bytes::concat_all([b"PLY_SITE(ctx, ", ascii_of_int(root_id(n)), b", ", from, b", ", to, b");"]);
  assert_eq(sites, [
    b"PLY_SITE(ctx, @@r@@, 10, 15);",
    borrowed(b"app.main", b"4", b"9"),
    borrowed(b"lib.k", b"1", b"3"),
    borrowed(b"app.main", b"20", b"25"),
    b"PLY_SITE(ctx, @@r@@, 30, 35);",
  ])
}

test "a field taken moves out of a block held only here, in place in another or not, and is counted once more out of a shared one" {
  let block = { id: 0, ty: NamedType({ name: b"m.Buf", args: [] }), representation: AsWord };
  let field = word_var(1);
  let f = {
    ..int_root([block], [Let({ var: field, value: Take({ of: block, path: FieldPath({ name: b"bytes", at: 1 }) }), at: span_between(0, 0), unwind: [] }), Return(IntOperand(0))]),
    convention: {
      params: [{ ownership: OwnedParam, representation: AsWord }],
      result: AsWord,
      destination_passing: false,
      returned: OwnedResult,
    },
  };
  let text = pieces_text(printed_fn(f, no_constructors()).pieces);
  assert(
    text.index_of(b"ply_words(p0)[1] = 0;") != None
      && text.index_of(call_text(dup_fn(), [b"t1"])) != None,
    Some(String::of_bytes_lossy(text)),
  )
}

test "a constructor's tag is a hole the unit writes in" {
  let k = { id: 0, ty: int_type(), representation: AsInt };
  let pr = printed_fn(
    int_root([], [
      Let({ var: k, value: Tag(b"m.Box"), at: span_between(0, 0), unwind: [] }),
      Return(VarOperand(k)),
    ]),
    no_constructors(),
  );
  assert(pr.pieces.contains(Hole(ConstructorTag(b"m.Box"))))
}

fn called(args: List<Arg>) -> Rvalue =
  Call({
    callee: Root(Named(b"m.g")),
    args: args,
    convention: {
      params: owned_params(args.map(|_: Arg| AsWord)),
      result: AsWord,
      destination_passing: false,
      returned: OwnedResult,
    },
    suspends: false,
  })

fn let_unwinding(v: Var, value: Rvalue, unwind: List<Var>) -> Inst =
  Let({ var: v, value: value, at: span_between(0, 0), unwind: unwind })

fn word_root(params: List<Var>, body: Block) -> Bytes / {abort.raise} =
  pieces_text(
    printed_fn(
      {
        ..int_root(params, body),
        convention: {
          params: owned_params(params.map(|v: Var| v.representation)),
          result: AsWord,
          destination_passing: false,
          returned: OwnedResult,
        },
      },
      no_constructors(),
    ).pieces,
  )

fn released_text(name: Bytes) -> Bytes / {abort.raise} =
  call_text(release_fn(), [
    b"ctx",
    name,
    pieces_text([Hole(Symbol(Root(drop_of(string_type()))))]),
  ]).concat(
    b";",
  )

test "each failure releases what it holds through tails that failures holding alike share" {
  let s = word_var(0);
  let a = word_var(1);
  let b = word_var(2);
  let c = word_var(3);
  let text = word_root([s], [
    let_unwinding(a, called([]), [s]),
    let_unwinding(b, called([]), [s, a]),
    let_unwinding(c, called([VarOperand(a)]), [s, b]),
    Return(VarOperand(c)),
  ]);
  let said = Some(String::of_bytes_lossy(text));
  let at = |s: Bytes| match text.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  let jumps = text.split(b"\n").filter(|l: Bytes| l.index_of(b"if (ctx->failed) goto ") != None);
  let distinct = jumps.fold([], |acc: List<Bytes>, l: Bytes|
    if acc.contains(l) { acc } else { acc.push(l) });
  assert(jumps.len() == 3 && distinct.len() == 3, said);
  let freed = [b"t2", b"t1", b"p0"].map(|x: Bytes| released_text(x));
  assert(freed.all(|r: Bytes| occurrences(text, r) == 1), said);
  assert(at(b"return t3;") < at(freed.get(0)), said);
  assert(at(freed.get(0)) < at(freed.get(1)) && at(freed.get(1)) < at(freed.get(2)), said)
}

test "a tail stands in the block its value was declared in, and goes on to the tails of the blocks around it" {
  let s = word_var(0);
  let flag = { id: 1, ty: bool_type(), representation: AsBool };
  let j = word_var(2);
  let a = word_var(3);
  let b = word_var(4);
  let text = word_root([s, flag], [
    Declaration(j),
    If({
      cond: VarOperand(flag),
      then: [
        let_unwinding(a, called([]), [s]),
        let_unwinding(b, called([]), [s, a]),
        Assign({ var: j, arg: VarOperand(b) }),
      ],
      otherwise: [Assign({ var: j, arg: VarOperand(s) })],
    }),
    Return(VarOperand(j)),
  ]);
  let said = Some(String::of_bytes_lossy(text));
  let at = |s: Bytes| match text.index_of(s) { Some(i) -> i, None -> 0 - 1 };
  let arm_tail = at(released_text(b"t2"));
  assert(at(b"t1 = t3;") < arm_tail && arm_tail < at(b"} else {"), said);
  assert(at(b"return t1;") < at(released_text(b"p0")), said)
}

test "a failure inside a handle's body releases what the body holds and goes to the landing, which releases what the handle holds" {
  let s = word_var(0);
  let result = word_var(1);
  let a = word_var(2);
  let b = word_var(3);
  let text = word_root([s], [
    Handle({
      body: [
        let_unwinding(a, called([]), []),
        let_unwinding(b, called([]), [a]),
        Assign({ var: result, arg: VarOperand(b) }),
      ],
      args: [],
      uses: { takes: [], owned: false, fails: false, suspends: false },
      site: { clauses: [], ret: None, detached: None, instance: empty_instance(0) },
      result: result,
      unwind: [s],
    }),
    Return(VarOperand(result)),
  ]);
  let jumps = text.split(landing_jump(0));
  let landing = text.len() - (match jumps.last() { Some(rest) -> rest.len(), None -> 0 });
  let body = text.slice(0, landing);
  let after = text.slice(landing, text.len());
  let said = Some(String::of_bytes_lossy(text));
  assert(jumps.len() >= 3 && occurrences(body, released_text(b"t2")) == 1, said);
  assert_eq(occurrences(body, released_text(b"p0")), 0);
  assert_eq(occurrences(after, released_text(b"p0")), 1)
}

test "a value whose C tests for no failure adds no tail" {
  let s = word_var(0);
  let n = { id: 1, ty: int_type(), representation: AsInt };
  let half = { ..n, id: 2 };
  let a = word_var(3);
  let quiet = word_root([s, n], [
    let_unwinding(
      half,
      Primitive({ op: b"div", on: AsInt, args: [VarOperand(n), IntOperand(2)] }),
      [s],
    ),
    Return(VarOperand(s)),
  ]);
  assert_eq(quiet.index_of(b"goto ply_u"), None);
  assert_eq(quiet.index_of(b"ply_u0:"), None);
  let then_called = word_root([s, n], [
    let_unwinding(
      half,
      Primitive({ op: b"div", on: AsInt, args: [VarOperand(n), IntOperand(2)] }),
      [s],
    ),
    let_unwinding(a, called([]), [s]),
    Return(VarOperand(a)),
  ]);
  assert(then_called.index_of(b"if (ctx->failed) goto ply_u0;") != None);
  assert_eq(occurrences(then_called, b"ply_u0:"), 1)
}
