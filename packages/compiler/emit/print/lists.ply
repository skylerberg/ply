import std.bytes (ascii_of_int)
import compiler.check.types (Type, encode_type)
import compiler.emit.layout (container_layouts, header_bytes, head_field, list_head, node_head,
                             head_words, minimum_list_capacity)
import compiler.emit.release (ListOf, WordAt, Object, block_contents)
import compiler.emit.typed_ir (AsWord)
import compiler.emit.print.count_functions (free_function)
import compiler.emit.print.ownership (dup_of)
import compiler.emit.print.text (word_slot, Printing, temp, line, unsupported)

fn spaced(c: Bytes) -> Bytes = if c.len() == 0 { c } else { c.concat(b" ") }

fn field(x: Bytes, f: Bytes) -> Bytes = head_field(list_head(), x, f)

fn node_field(x: Bytes, f: Bytes) -> Bytes = head_field(node_head(), x, f)

fn int_field(x: Bytes, f: Bytes) -> Bytes = Bytes::concat_all([b"(int64_t)", field(x, f)])

fn items_at() -> Bytes = ascii_of_int(container_layouts().list.items)

pub fn owner_of(x: Bytes) -> Bytes = word_slot(x, ascii_of_int(container_layouts().list.owner))

fn empty_bytes() -> Bytes = ascii_of_int(header_bytes() + 8 * container_layouts().list.items)

pub fn item_read(
  printing: Printing,
  depth: Int,
  into: Bytes,
  xs: Bytes,
  i: Bytes,
  stride: Int,
) -> Printing =
  line(
    printing,
    depth,
    Bytes::concat_all([
      b"Word *",
      into,
      b" = ",
      item_function(),
      b"(",
      xs,
      b", ",
      i,
      b", ",
      ascii_of_int(stride),
      b");",
    ]),
  )

pub fn item_function() -> Bytes = b"ply_list_item"

pub fn empty_list_function() -> Bytes = b"ply_list_room"

pub fn node_function() -> Bytes = b"ply_node"

pub fn writable_list_fn() -> Bytes = b"ply_list_writable"

pub fn opened_list_fn() -> Bytes = b"ply_list_opened"

fn view_fn() -> Bytes = b"ply_list_view"

pub fn empty_list_allocation(room: Bytes, stride: Int) -> Bytes =
  Bytes::concat_all([empty_list_function(), b"(ctx, ", room, b", ", ascii_of_int(stride), b")"])

pub fn node_allocation(kind: Int, words: Int) -> Bytes =
  Bytes::concat_all([
    node_function(),
    b"(ctx, ",
    ascii_of_int(kind),
    b", ",
    ascii_of_int(words),
    b")",
  ])

fn allocation_helpers() -> Bytes =
  Bytes::concat_all([
    b"static inline Word ",
    empty_list_function(),
    b"(PlyCtx *ctx, int64_t room, int64_t stride) {\n",
    b"  if (room < 1) room = 1;\n",
    b"  Word xs = ply_alloc(ctx, ",
    empty_bytes(),
    b" + 8 * room * stride);\n",
    b"  ",
    field(b"xs", b"len"),
    b" = 0; ",
    field(b"xs", b"claimed"),
    b" = 0; ",
    field(b"xs", b"room"),
    b" = (uint32_t)room; ",
    field(b"xs", b"first"),
    b" = ",
    items_at(),
    b"; ",
    owner_of(b"xs"),
    b" = 0;\n",
    b"  return xs;\n",
    b"}\n",
    b"static inline Word ",
    node_function(),
    b"(PlyCtx *ctx, int64_t kind, int64_t words) {\n",
    b"  Word n = ply_alloc(ctx, ",
    ascii_of_int(header_bytes() + 8 * head_words(node_head())),
    b" + 8 * words);\n",
    b"  ",
    node_field(b"n", b"len"),
    b" = 0; ",
    node_field(b"n", b"room"),
    b" = (uint16_t)words; ",
    node_field(b"n", b"kind"),
    b" = (uint16_t)kind;\n",
    b"  return n;\n",
    b"}\n",
  ])

fn grown_list() -> Bytes = {
  let least = ascii_of_int(minimum_list_capacity());
  Bytes::concat_all([
    b"  if (",
    field(b"xs", b"len"),
    b" == ",
    field(b"xs", b"room"),
    b") {\n",
    b"    int64_t n = ",
    int_field(b"xs", b"len"),
    b"; int64_t room = 2 * n > ",
    least,
    b" ? 2 * n : ",
    least,
    b"; if (room > UINT32_MAX) room = UINT32_MAX;\n",
    b"    Word grown = ",
    empty_list_function(),
    b"(ctx, room, stride);\n",
    b"    memcpy(&",
    word_slot(b"grown", items_at()),
    b", &",
    word_slot(b"xs", items_at()),
    b", (size_t)(n * stride) * sizeof(Word));\n",
    b"    ",
    field(b"grown", b"len"),
    b" = (uint32_t)n; ",
    field(b"grown", b"claimed"),
    b" = (uint32_t)n;\n",
    b"    ",
    free_function(),
    b"(ctx, xs, ",
    empty_bytes(),
    b" + 8 * ",
    int_field(b"xs", b"room"),
    b" * stride);\n",
    b"    xs = grown;\n",
    b"  }\n",
  ])
}

pub fn list_helpers() -> Bytes =
  Bytes::concat_all([
    b"static inline Word *",
    item_function(),
    b"(Word xs, int64_t i, int64_t stride) {\n",
    b"  return &",
    word_slot(b"xs", Bytes::concat_all([field(b"xs", b"first"), b" + i * stride"])),
    b";\n",
    b"}\n",
    allocation_helpers(),
    b"static inline int ",
    writable_list_fn(),
    b"(Word xs) {\n",
    b"  Word o = ",
    owner_of(b"xs"),
    b";\n",
    b"  return ply_obj(xs)->rc == 1 && (!o || ply_obj(o)->rc == 1);\n",
    b"}\n",
    b"static inline Word ",
    view_fn(),
    b"(PlyCtx *ctx, Word xs, Word owner, int64_t k, int64_t stride) {\n",
    b"  Word v = ply_alloc(ctx, ",
    empty_bytes(),
    b");\n",
    b"  int64_t n = ",
    int_field(b"xs", b"len"),
    b" - k;\n",
    b"  ",
    field(b"v", b"len"),
    b" = (uint32_t)n; ",
    field(b"v", b"room"),
    b" = 0; ",
    field(b"v", b"claimed"),
    b" = 0;\n",
    b"  ",
    field(b"v", b"first"),
    b" = (xs - v) / 8 + ",
    field(b"xs", b"first"),
    b" + k * stride;\n",
    b"  ",
    owner_of(b"v"),
    b" = owner;\n",
    b"  return v;\n",
    b"}\n",
    b"static inline Word ",
    opened_list_fn(),
    b"(PlyCtx *ctx, Word xs, PlyDrop copy, int64_t stride) {\n",
    b"  Word o = ",
    owner_of(b"xs"),
    b";\n",
    b"  Word b = o ? o : xs;\n",
    b"  int64_t end = (xs - b) / 8 + ",
    field(b"xs", b"first"),
    b" - ",
    items_at(),
    b" + ",
    int_field(b"xs", b"len"),
    b" * stride;\n",
    b"  if (end == ",
    int_field(b"b", b"claimed"),
    b" * stride && ",
    field(b"b", b"claimed"),
    b" < ",
    field(b"b", b"room"),
    b" && ",
    b"ply_obj(xs)->rc < UINT32_C(0x80000000) && ply_obj(b)->rc < UINT32_C(0x80000000)) {\n",
    b"    ",
    field(b"b", b"claimed"),
    b" += 1;\n",
    b"    if (o && ply_obj(xs)->rc == 1) return xs;\n",
    b"    Word v = ",
    view_fn(),
    b"(ctx, xs, b, 0, stride);\n",
    b"    if (o) { ply_obj(o)->rc += 1; ply_obj(xs)->rc -= 1; }\n",
    b"    return v;\n",
    b"  }\n",
    b"  if (o || ply_obj(xs)->rc != 1 || ",
    field(b"xs", b"claimed"),
    b" != ",
    field(b"xs", b"len"),
    b") xs = copy(ctx, xs);\n",
    grown_list(),
    b"  ",
    field(b"xs", b"claimed"),
    b" += 1;\n",
    b"  return xs;\n",
    b"}\n",
  ])

pub fn list_rest(
  printing: Printing,
  depth: Int,
  into: Bytes,
  xs: Bytes,
  k: Bytes,
  ty: Type,
) -> Printing / {abort.raise} = {
  let l = container_layouts().list;
  let list_contents = match block_contents(printing.constructors, ty, AsWord) {
    ListOf(o) -> o,
    _ -> unsupported(b"taking the rest of a value that is not a list", encode_type(ty)),
  };
  let st = list_contents.stride;
  let m = temp(printing);
  let j = temp(m.printing);
  let w = temp(j.printing);
  let o = temp(w.printing);
  let at = |x: Bytes, at: Bytes, s: Int|
    word_slot(x, if st == 1 { Bytes::concat_all([ascii_of_int(l.items), b" + ", at]) } else {
      Bytes::concat_all([ascii_of_int(l.items + s), b" + (", at, b") * ", ascii_of_int(st)])
    });
  let ws = if st == 1 { [w.name] }
  else { range(0, st).map(|s: Int| Bytes::concat_all([w.name, b"_", ascii_of_int(s)])) };
  let from = Bytes::concat_all([b"(", k, b") + ", j.name]);
  line(
    o.printing,
    depth,
    Bytes::concat_all([
      b"if (ply_obj(",
      xs,
      b")->rc == PLY_RC_FRAME) { int64_t ",
      m.name,
      b" = ",
      int_field(xs, b"len"),
      b" - (",
      k,
      b"); ",
      into,
      b" = ",
      empty_list_allocation(m.name, st),
      b"; for (int64_t ",
      j.name,
      b" = 0; ",
      j.name,
      b" < ",
      m.name,
      b"; ",
      j.name,
      b"++) { ",
      Bytes::concat_all(
        range(0, st).map(|s: Int|
          Bytes::concat_all([b"Word ", ws.get(s), b" = ", at(xs, from, s), b"; "])),
      ),
      spaced(dup_of(list_contents.item, ws)),
      Bytes::concat_all(
        range(0, st).map(|s: Int|
          Bytes::concat_all([at(into, j.name, s), b" = ", ws.get(s), b"; "])),
      ),
      b"} ",
      field(into, b"len"),
      b" = (uint32_t)",
      m.name,
      b"; ",
      field(into, b"claimed"),
      b" = (uint32_t)",
      m.name,
      b"; } else { Word ",
      o.name,
      b" = ",
      owner_of(xs),
      b" ? ",
      owner_of(xs),
      b" : ",
      xs,
      b"; ",
      spaced(
        dup_of([WordAt({ at: 0, masked: false, how: Object(list_contents.whole) })], [o.name]),
      ),
      into,
      b" = ",
      view_fn(),
      b"(ctx, ",
      xs,
      b", ",
      o.name,
      b", ",
      k,
      b", ",
      ascii_of_int(st),
      b"); }",
    ]),
  )
}

pub fn stack_list_of_items(
  printing: Printing,
  depth: Int,
  into: Bytes,
  items: List<List<Bytes>>,
  stride: Int,
) -> Printing / {abort.raise} = {
  let l = container_layouts().list;
  let n = items.len();
  let at = into.concat(b"_f");
  line(
    printing,
    depth,
    Bytes::concat_all([
      b"Word ",
      at,
      b"[PLY_HEADER / 8 + ",
      ascii_of_int(l.items + n * stride),
      b"]; ((PlyObj *)",
      at,
      b")->rc = PLY_RC_FRAME; Word ",
      into,
      b" = (Word)(intptr_t)",
      at,
      b"; ",
      field(into, b"len"),
      b" = ",
      ascii_of_int(n),
      b"; ",
      field(into, b"room"),
      b" = ",
      ascii_of_int(n),
      b"; ",
      field(into, b"claimed"),
      b" = ",
      ascii_of_int(n),
      b"; ",
      field(into, b"first"),
      b" = ",
      ascii_of_int(l.items),
      b"; ",
      owner_of(into),
      b" = 0;",
      Bytes::concat_all(
        range(0, n * stride).map(|k: Int|
          Bytes::concat_all([
            b" ",
            word_slot(into, ascii_of_int(l.items + k)),
            b" = ",
            match items.at(k / stride) {
              Some(x) -> match x.at(k % stride) { Some(w) -> w, None -> b"0" },
              None -> b"0",
            },
            b";",
          ])),
      ),
    ]),
  )
}

pub fn list_of_items(
  printing: Printing,
  depth: Int,
  into: Bytes,
  items: List<List<Bytes>>,
  stride: Int,
) -> Printing / {abort.raise} = {
  let l = container_layouts().list;
  let n = items.len();
  let words_of = items.fold([], |accumulator: List<Bytes>, x: List<Bytes>|
    accumulator.concat(
      range(0, stride).map(|j: Int| match x.at(j) { Some(w) -> w, None -> b"0" }),
    ));
  line(
    printing,
    depth,
    Bytes::concat_all([
      b"Word ",
      into,
      b" = ",
      empty_list_allocation(ascii_of_int(n), stride),
      b"; ",
      Bytes::concat_all(
        range(0, words_of.len()).map(|k: Int|
          Bytes::concat_all([
            word_slot(into, ascii_of_int(l.items + k)),
            b" = ",
            words_of.get(k),
            b"; ",
          ])),
      ),
      field(into, b"len"),
      b" = ",
      ascii_of_int(n),
      b"; ",
      field(into, b"claimed"),
      b" = ",
      ascii_of_int(n),
      b";",
    ]),
  )
}
