import std.bytes (ascii_of_int)
import compiler.check.types (Type, encode_type)
import compiler.emit.layout (container_layouts, header_bytes, head_field, list_head, node_head,
                             head_words)
import compiler.emit.typed_ir (AsWord)
import compiler.emit.release (ListOf, WordAt, Object, block_contents)
import compiler.emit.print.ownership (dup_of)
import compiler.emit.print.text (Printing, temp, line, unsupported)

fn spaced(c: Bytes) -> Bytes = if c.len() == 0 { c } else { c.concat(b" ") }

fn field(x: Bytes, f: Bytes) -> Bytes = head_field(list_head(), x, f)

fn node_field(x: Bytes, f: Bytes) -> Bytes = head_field(node_head(), x, f)

fn word(x: Bytes, k: Bytes) -> Bytes = Bytes::concat_all([b"ply_words(", x, b")[", k, b"]"])

fn node_word(x: Bytes, k: Bytes) -> Bytes =
  word(x, Bytes::concat_all([ascii_of_int(container_layouts().trie.first), b" + ", k]))

fn int_field(x: Bytes, f: Bytes) -> Bytes = Bytes::concat_all([b"(int64_t)", field(x, f)])

fn trie_bits() -> Int =
  range(0, 63).fold(0, |b: Int, k: Int|
    if 1 << k == container_layouts().trie.width { k } else { b })

fn tail_from(xs: Bytes) -> Bytes =
  Bytes::concat_all([
    int_field(xs, b"start"),
    b" + ",
    int_field(xs, b"len"),
    b" - ",
    int_field(xs, b"tail_len"),
  ])
pub fn item_read(
  printing: Printing,
  depth: Int,
  into: Bytes,
  xs: Bytes,
  i: Bytes,
  stride: Int,
) -> Printing =
  line(
    printing,
    depth,
    Bytes::concat_all([
      b"Word *",
      into,
      b" = ",
      item_fn(),
      b"(",
      xs,
      b", ",
      i,
      b", ",
      ascii_of_int(stride),
      b");",
    ]),
  )

pub fn leaf_read(printing: Printing, depth: Int, into: Bytes, xs: Bytes, j: Bytes) -> Printing =
  line(
    printing,
    depth,
    Bytes::concat_all([into, b" = ", list_leaf_fn(), b"(", xs, b", ", j, b");"]),
  )

pub fn item_fn() -> Bytes = b"ply_list_item"

pub fn list_leaf_fn() -> Bytes = b"ply_list_leaf"

pub fn empty_list_fn() -> Bytes = b"ply_list_room"

pub fn node_fn() -> Bytes = b"ply_node"

pub fn empty_list_alloc(room: Bytes, stride: Int) -> Bytes =
  Bytes::concat_all([empty_list_fn(), b"(ctx, ", room, b", ", ascii_of_int(stride), b")"])

pub fn trie_node_alloc(kind: Int, stride: Int) -> Bytes =
  node_alloc(kind, container_layouts().trie.width * stride)

pub fn node_alloc(kind: Int, words: Int) -> Bytes =
  Bytes::concat_all([node_fn(), b"(ctx, ", ascii_of_int(kind), b", ", ascii_of_int(words), b")"])

fn alloc_helpers() -> Bytes = {
  let l = container_layouts().list;
  Bytes::concat_all([
    b"static inline Word ",
    empty_list_fn(),
    b"(PlyCtx *ctx, int64_t room, int64_t stride) {\n",
    b"  if (room < 1) room = 1; if (room > ",
    ascii_of_int(container_layouts().trie.width),
    b") room = ",
    ascii_of_int(container_layouts().trie.width),
    b";\n",
    b"  Word xs = ply_alloc(ctx, ",
    ascii_of_int(header_bytes() + 8 * l.tail),
    b" + 8 * room * stride);\n",
    b"  ",
    field(b"xs", b"len"),
    b" = 0; ",
    field(b"xs", b"start"),
    b" = 0; ",
    field(b"xs", b"tail_len"),
    b" = 0; ",
    field(b"xs", b"room"),
    b" = (uint32_t)room; ",
    word(b"xs", ascii_of_int(l.root)),
    b" = 0;\n",
    b"  return xs;\n",
    b"}\n",
    b"static inline Word ",
    node_fn(),
    b"(PlyCtx *ctx, int64_t kind, int64_t words) {\n",
    b"  Word n = ply_alloc(ctx, ",
    ascii_of_int(header_bytes() + 8 * head_words(node_head())),
    b" + 8 * words);\n",
    b"  ",
    node_field(b"n", b"len"),
    b" = 0; ",
    node_field(b"n", b"room"),
    b" = (uint16_t)words; ",
    node_field(b"n", b"kind"),
    b" = (uint16_t)kind;\n",
    b"  return n;\n",
    b"}\n",
  ])
}

pub fn list_helpers() -> Bytes = {
  let l = container_layouts().list;
  let width = ascii_of_int(container_layouts().trie.width);
  let mask = ascii_of_int(container_layouts().trie.width - 1);
  let bits = ascii_of_int(trie_bits());
  let walked = Bytes::concat_all([
    b"int64_t s = 0; while ((INT64_C(",
    width,
    b") << s) < h) s += ",
    bits,
    b"; for (; s > 0; s -= ",
    bits,
    b") n = ",
    node_word(b"n", Bytes::concat_all([b"((p >> s) & ", mask, b")"])),
    b";",
  ]);
  Bytes::concat_all([
    b"static inline Word *",
    item_fn(),
    b"(Word xs, int64_t i, int64_t stride) {\n",
    b"  int64_t p = ",
    int_field(b"xs", b"start"),
    b" + i; int64_t h = ",
    tail_from(b"xs"),
    b";\n",
    b"  if (p >= h) return &",
    word(b"xs", Bytes::concat_all([ascii_of_int(l.tail), b" + (p - h) * stride"])),
    b";\n",
    b"  Word n = ",
    word(b"xs", ascii_of_int(l.root)),
    b"; ",
    walked,
    b"\n",
    b"  return &",
    node_word(b"n", Bytes::concat_all([b"(p & ", mask, b") * stride"])),
    b";\n",
    b"}\n",
    b"static inline Word ",
    list_leaf_fn(),
    b"(Word xs, int64_t j) {\n",
    b"  int64_t h = ",
    tail_from(b"xs"),
    b"; int64_t first = ",
    int_field(b"xs", b"start"),
    b" / ",
    width,
    b"; Word n = ",
    word(b"xs", ascii_of_int(l.root)),
    b";\n",
    b"  if (n == 0 || j < 0 || j >= h / ",
    width,
    b" - first) return 0;\n",
    b"  int64_t p = (first + j) * ",
    width,
    b"; ",
    walked,
    b"\n",
    b"  return n;\n",
    b"}\n",
    alloc_helpers(),
  ])
}
pub fn list_rest(
  printing: Printing,
  depth: Int,
  into: Bytes,
  xs: Bytes,
  k: Bytes,
  ty: Type,
) -> Printing / {abort.raise} = {
  let l = container_layouts().list;
  let held = match block_contents(printing.constructors, ty, AsWord) {
    ListOf(o) -> o,
    _ -> unsupported(b"taking the rest of a value that is not a list", encode_type(ty)),
  };
  let st = held.stride;
  let node_dup = |x: Bytes| dup_of([WordAt({ at: 0, masked: false, how: Object(held.node) })], [x]);
  let f = temp(printing);
  let h = temp(f.printing);
  let m = temp(h.printing);
  let j = temp(m.printing);
  let w = temp(j.printing);
  let at = |x: Bytes, at: Bytes, s: Int|
    word(x, if st == 1 { Bytes::concat_all([ascii_of_int(l.tail), b" + ", at]) }
    else { Bytes::concat_all([ascii_of_int(l.tail + s), b" + (", at, b") * ", ascii_of_int(st)]) });
  let ws = if st == 1 { [w.name] }
  else { range(0, st).map(|s: Int| Bytes::concat_all([w.name, b"_", ascii_of_int(s)])) };
  let copied = |from: Bytes|
    Bytes::concat_all([
      b"for (int64_t ",
      j.name,
      b" = 0; ",
      j.name,
      b" < ",
      m.name,
      b"; ",
      j.name,
      b"++) { ",
      Bytes::concat_all(
        range(0, st).map(|s: Int|
          Bytes::concat_all([b"Word ", ws.get(s), b" = ", at(xs, from.concat(j.name), s), b"; "])),
      ),
      spaced(dup_of(held.item, ws)),
      Bytes::concat_all(
        range(0, st).map(|s: Int|
          Bytes::concat_all([at(into, j.name, s), b" = ", ws.get(s), b"; "])),
      ),
      b"} ",
    ]);
  line(
    w.printing,
    depth,
    Bytes::concat_all([
      b"{ int64_t ",
      f.name,
      b" = ",
      int_field(xs, b"start"),
      b" + (",
      k,
      b"); int64_t ",
      h.name,
      b" = ",
      tail_from(xs),
      b"; int64_t ",
      m.name,
      b"; if (",
      f.name,
      b" >= ",
      h.name,
      b") { ",
      m.name,
      b" = ",
      int_field(xs, b"len"),
      b" - (",
      k,
      b"); ",
      into,
      b" = ",
      empty_list_alloc(m.name, st),
      b"; ",
      copied(Bytes::concat_all([f.name, b" - ", h.name, b" + "])),
      b"} else { ",
      m.name,
      b" = ",
      int_field(xs, b"tail_len"),
      b"; ",
      into,
      b" = ",
      empty_list_alloc(int_field(xs, b"room"), st),
      b"; ",
      word(into, ascii_of_int(l.root)),
      b" = ",
      word(xs, ascii_of_int(l.root)),
      b"; ",
      spaced(node_dup(word(into, ascii_of_int(l.root)))),
      copied(b""),
      field(into, b"start"),
      b" = (uint32_t)",
      f.name,
      b"; } ",
      field(into, b"tail_len"),
      b" = (uint32_t)",
      m.name,
      b"; ",
      field(into, b"len"),
      b" = (uint32_t)(",
      int_field(xs, b"len"),
      b" - (",
      k,
      b")); }",
    ]),
  )
}

pub fn stack_list_of_items(
  printing: Printing,
  depth: Int,
  into: Bytes,
  items: List<List<Bytes>>,
  stride: Int,
) -> Printing / {abort.raise} = {
  let l = container_layouts().list;
  let n = items.len();
  let at = into.concat(b"_f");
  line(
    printing,
    depth,
    Bytes::concat_all([
      b"Word ",
      at,
      b"[PLY_HEADER / 8 + ",
      ascii_of_int(l.tail + n * stride),
      b"]; ((PlyObj *)",
      at,
      b")->rc = PLY_RC_FRAME; Word ",
      into,
      b" = (Word)(intptr_t)",
      at,
      b"; ",
      field(into, b"len"),
      b" = ",
      ascii_of_int(n),
      b"; ",
      field(into, b"start"),
      b" = 0; ",
      field(into, b"tail_len"),
      b" = ",
      ascii_of_int(n),
      b"; ",
      field(into, b"room"),
      b" = ",
      ascii_of_int(n),
      b"; ",
      word(into, ascii_of_int(l.root)),
      b" = 0;",
      Bytes::concat_all(
        range(0, n * stride).map(|k: Int|
          Bytes::concat_all([
            b" ",
            word(into, ascii_of_int(l.tail + k)),
            b" = ",
            match items.at(k / stride) {
              Some(x) -> match x.at(k % stride) { Some(w) -> w, None -> b"0" },
              None -> b"0",
            },
            b";",
          ])),
      ),
    ]),
  )
}

pub fn list_of_items(
  printing: Printing,
  depth: Int,
  into: Bytes,
  items: List<List<Bytes>>,
  stride: Int,
) -> Printing / {abort.raise} = {
  let l = container_layouts().list;
  let width = container_layouts().trie.width;
  let n = items.len();
  let held = if n <= width { 0 } else { n / width * width };
  let set = |b: Bytes, from: Int, xs: List<Bytes>|
    Bytes::concat_all(
      range(0, xs.len()).map(|k: Int|
        Bytes::concat_all([
          word(b, ascii_of_int(from + k)),
          b" = ",
          match xs.at(k) { Some(x) -> x, None -> b"0" },
          b"; ",
        ])),
    );
  let words_of = |xs: List<List<Bytes>>, s: Int|
    xs.fold([], |accumulator: List<Bytes>, x: List<Bytes>|
      accumulator.concat(range(0, s).map(|j: Int| match x.at(j) { Some(w) -> w, None -> b"0" })));
  let node = |q: Printing, kind: Int, xs: List<List<Bytes>>, s: Int| {
    let t = temp(q);
    {
      printing: line(
        t.printing,
        depth,
        Bytes::concat_all([
          b"Word ",
          t.name,
          b" = ",
          trie_node_alloc(kind, s),
          b"; ",
          set(t.name, container_layouts().trie.first, words_of(xs, s)),
          node_field(t.name, b"len"),
          b" = ",
          ascii_of_int(xs.len()),
          b";",
        ]),
      ),
      name: t.name,
    }
  };
  let grouped = |q: Printing, kind: Int, xs: List<List<Bytes>>, s: Int|
    range(0, (xs.len() + width - 1) / width).fold(
      { printing: q, names: [] },
      |accumulator: { printing: Printing, names: List<Bytes> }, k: Int| {
        let made = node(accumulator.printing, kind, xs.drop(k * width).take(width), s);
        { printing: made.printing, names: accumulator.names.push(made.name) }
      },
    );
  let raised = iterate(
    grouped(printing, container_layouts().trie.leaf, items.take(held), stride),
    n + 1,
    |s: { printing: Printing, names: List<Bytes> }|
      if s.names.len() <= 1 { Stop(s) } else {
        Continue(
          grouped(s.printing, container_layouts().trie.branch, s.names.map(|x: Bytes| [x]), 1),
        )
      },
  );
  let root = match raised.names { [r] -> r, _ -> b"0" };
  line(
    raised.printing,
    depth,
    Bytes::concat_all([
      b"Word ",
      into,
      b" = ",
      empty_list_alloc(ascii_of_int(if held == 0 { n } else { width }), stride),
      b"; ",
      if held == 0 { b"" }
      else { Bytes::concat_all([word(into, ascii_of_int(l.root)), b" = ", root, b"; "]) },
      set(into, l.tail, words_of(items.drop(held), stride)),
      field(into, b"len"),
      b" = ",
      ascii_of_int(n),
      b"; ",
      field(into, b"tail_len"),
      b" = ",
      ascii_of_int(n - held),
      b";",
    ]),
  )
}
