//! The C over a list's own block and its trie that list operations share: an item read where the
//! trie or the tail holds it, a list's items from an index on as a list sharing its trie, and a list
//! made of its items. Each block is laid as `layout.layouts` lays a list out, and what a copy counts
//! once more is counted as `emit.release` says its type is.

import std.bytes (ascii_of_int)
import compiler.check.types (Type, spelled_type)
import compiler.emit.layout (layouts, header_bytes, head_field, list_head, node_head, head_words)
import compiler.emit.tir (RWord)
import compiler.emit.release (ListOf, WordAt, Object, opening)
import compiler.emit.print.counts (dup_of)
import compiler.emit.print.text (Printing, temp, line, unprinted)

/// `c`, C a statement or none, followed by a space where it is one.
fn spaced(c: Bytes) -> Bytes = if c.len() == 0 { c } else { c.concat(b" ") }

/// Field `f` of the head of the list `x`.
fn field(x: Bytes, f: Bytes) -> Bytes = head_field(list_head(), x, f)

/// Field `f` of the head of the node `x`.
fn node_field(x: Bytes, f: Bytes) -> Bytes = head_field(node_head(), x, f)

fn word(x: Bytes, k: Bytes) -> Bytes = Bytes::concat_all([b"ply_words(", x, b")[", k, b"]"])

/// Word `k`, a C expression, of what the node `x` holds past its head.
fn node_word(x: Bytes, k: Bytes) -> Bytes =
  word(x, Bytes::concat_all([ascii_of_int(layouts().trie.first), b" + ", k]))

fn int_field(x: Bytes, f: Bytes) -> Bytes = Bytes::concat_all([b"(int64_t)", field(x, f)])

/// How many bits of an item's place pick a child of one of a trie's nodes.
fn trie_bits() -> Int =
  range(0, 63).fold(0, |b: Int, k: Int| if 1 << k == layouts().trie.width { k } else { b })

/// Where the list `xs`'s trie stops holding its items and its tail starts, from the trie's first
/// place.
fn tail_from(xs: Bytes) -> Bytes =
  Bytes::concat_all([
    int_field(xs, b"start"),
    b" + ",
    int_field(xs, b"len"),
    b" - ",
    int_field(xs, b"tail_len"),
  ])
/// The statement declaring `into` the address of item `i`, a C expression within the list `xs`, its
/// items `stride` words apart, borrowed: `item_fn`'s answer.
pub fn item_read(
  pr: Printing,
  depth: Int,
  into: Bytes,
  xs: Bytes,
  i: Bytes,
  stride: Int,
) -> Printing =
  line(
    pr,
    depth,
    Bytes::concat_all([
      b"Word *",
      into,
      b" = ",
      item_fn(),
      b"(",
      xs,
      b", ",
      i,
      b", ",
      ascii_of_int(stride),
      b");",
    ]),
  )

/// The statement setting `into`, declared already, to the leaf of the list `xs`'s trie holding its
/// items from the `j`-th leaf's worth on, `j` a C expression counted from the leaf its first item
/// lies in, borrowed: `leaf_fn`'s answer.
pub fn leaf_read(pr: Printing, depth: Int, into: Bytes, xs: Bytes, j: Bytes) -> Printing =
  line(pr, depth, Bytes::concat_all([into, b" = ", leaf_fn(), b"(", xs, b", ", j, b");"]))

/// The head's C function answering the address of item `i` of a list, its items `stride` words
/// apart, borrowed: in its tail past the places its trie holds, and otherwise in the leaf the trie's
/// levels lead to.
pub fn item_fn() -> Bytes = b"ply_list_item"

/// The head's C function answering the leaf of a list's trie holding its items from the `j`-th
/// leaf's worth on, counted from the leaf its first item lies in, borrowed; zero past its last leaf,
/// and for a list that is its tail.
pub fn leaf_fn() -> Bytes = b"ply_list_leaf"

/// The head's C function answering an empty list with room in its tail for `room` items, between one
/// and a leaf's worth, each `stride` words: a block emitted code lays out.
pub fn room_fn() -> Bytes = b"ply_list_room"

/// The head's C function answering a node of `kind` of a list's trie or a map's tree with room for
/// `words` words past its head, holding nothing yet.
pub fn node_fn() -> Bytes = b"ply_node"

/// The C answering a list with room for `room` items `stride` words apart, `room_fn`'s call.
pub fn room_made(room: Bytes, stride: Int) -> Bytes =
  Bytes::concat_all([room_fn(), b"(ctx, ", room, b", ", ascii_of_int(stride), b")"])

/// The C answering a node of `kind` of a list's trie with room for a leaf's worth of what is `stride`
/// words apart.
pub fn node_made(kind: Int, stride: Int) -> Bytes =
  node_words_made(kind, layouts().trie.width * stride)

/// The C answering a node of `kind` with room for `words` words, `node_fn`'s call.
pub fn node_words_made(kind: Int, words: Int) -> Bytes =
  Bytes::concat_all([node_fn(), b"(ctx, ", ascii_of_int(kind), b", ", ascii_of_int(words), b")"])

/// `room_fn`'s and `node_fn`'s definitions.
fn made_helpers() -> Bytes = {
  let l = layouts().list;
  Bytes::concat_all([
    b"static inline Word ",
    room_fn(),
    b"(PlyCtx *ctx, int64_t room, int64_t stride) {\n",
    b"  if (room < 1) room = 1; if (room > ",
    ascii_of_int(layouts().trie.width),
    b") room = ",
    ascii_of_int(layouts().trie.width),
    b";\n",
    b"  Word xs = rt_alloc_bytes_p(ctx, ",
    ascii_of_int(header_bytes() + 8 * l.tail),
    b" + 8 * room * stride);\n",
    b"  ",
    field(b"xs", b"len"),
    b" = 0; ",
    field(b"xs", b"start"),
    b" = 0; ",
    field(b"xs", b"tail_len"),
    b" = 0; ",
    field(b"xs", b"room"),
    b" = (uint32_t)room; ",
    word(b"xs", ascii_of_int(l.root)),
    b" = 0;\n",
    b"  return xs;\n",
    b"}\n",
    b"static inline Word ",
    node_fn(),
    b"(PlyCtx *ctx, int64_t kind, int64_t words) {\n",
    b"  Word n = rt_alloc_bytes_p(ctx, ",
    ascii_of_int(header_bytes() + 8 * head_words(node_head())),
    b" + 8 * words);\n",
    b"  ",
    node_field(b"n", b"len"),
    b" = 0; ",
    node_field(b"n", b"room"),
    b" = (uint16_t)words; ",
    node_field(b"n", b"kind"),
    b" = (uint16_t)kind;\n",
    b"  return n;\n",
    b"}\n",
  ])
}

/// `item_fn`'s and `leaf_fn`'s definitions, over a list laid as `layout.layouts` lays one out.
pub fn list_helpers() -> Bytes = {
  let l = layouts().list;
  let width = ascii_of_int(layouts().trie.width);
  let mask = ascii_of_int(layouts().trie.width - 1);
  let bits = ascii_of_int(trie_bits());
  // The trie's levels down from its root `n` to the node holding place `p`, below `h` places.
  let walked = Bytes::concat_all([
    b"int64_t s = 0; while ((INT64_C(",
    width,
    b") << s) < h) s += ",
    bits,
    b"; for (; s > 0; s -= ",
    bits,
    b") n = ",
    node_word(b"n", Bytes::concat_all([b"((p >> s) & ", mask, b")"])),
    b";",
  ]);
  Bytes::concat_all([
    b"static inline Word *",
    item_fn(),
    b"(Word xs, int64_t i, int64_t stride) {\n",
    b"  int64_t p = ",
    int_field(b"xs", b"start"),
    b" + i; int64_t h = ",
    tail_from(b"xs"),
    b";\n",
    b"  if (p >= h) return &",
    word(b"xs", Bytes::concat_all([ascii_of_int(l.tail), b" + (p - h) * stride"])),
    b";\n",
    b"  Word n = ",
    word(b"xs", ascii_of_int(l.root)),
    b"; ",
    walked,
    b"\n",
    b"  return &",
    node_word(b"n", Bytes::concat_all([b"(p & ", mask, b") * stride"])),
    b";\n",
    b"}\n",
    b"static inline Word ",
    leaf_fn(),
    b"(Word xs, int64_t j) {\n",
    b"  int64_t h = ",
    tail_from(b"xs"),
    b"; int64_t first = ",
    int_field(b"xs", b"start"),
    b" / ",
    width,
    b"; Word n = ",
    word(b"xs", ascii_of_int(l.root)),
    b";\n",
    b"  if (n == 0 || j < 0 || j >= h / ",
    width,
    b" - first) return 0;\n",
    b"  int64_t p = (first + j) * ",
    width,
    b"; ",
    walked,
    b"\n",
    b"  return n;\n",
    b"}\n",
    made_helpers(),
  ])
}
/// Statements setting `into`, a `Word` declared already, to the items of the list `xs`, of type `ty`,
/// from `k`, a C expression no greater than its length, on: a list of its own that shares `xs`'s
/// trie where the trie still holds some of them, its root and each item copied counted once more as
/// their types count them.
pub fn rest_made(
  pr: Printing,
  depth: Int,
  into: Bytes,
  xs: Bytes,
  k: Bytes,
  ty: Type,
) -> Printing / {abort.raise} = {
  let l = layouts().list;
  let held = match opening(pr.ctors, ty, RWord) {
    ListOf(o) -> o,
    _ -> unprinted(b"a list's rest of what is no list", spelled_type(ty)),
  };
  let st = held.stride;
  let node_dup = |x: Bytes| dup_of([WordAt({ at: 0, masked: false, how: Object(held.node) })], [x]);
  let f = temp(pr);
  let h = temp(f.pr);
  let m = temp(h.pr);
  let j = temp(m.pr);
  let w = temp(j.pr);
  // Word `s` of item `at` of the tail of `x`, its items `st` words apart.
  let at = |x: Bytes, at: Bytes, s: Int|
    word(x, if st == 1 { Bytes::concat_all([ascii_of_int(l.tail), b" + ", at]) }
    else { Bytes::concat_all([ascii_of_int(l.tail + s), b" + (", at, b") * ", ascii_of_int(st)]) });
  let ws = if st == 1 { [w.name] }
  else { range(0, st).map(|s: Int| Bytes::concat_all([w.name, b"_", ascii_of_int(s)])) };
  // `m` items copied from the tail's `from` on, each counted once more.
  let copied = |from: Bytes|
    Bytes::concat_all([
      b"for (int64_t ",
      j.name,
      b" = 0; ",
      j.name,
      b" < ",
      m.name,
      b"; ",
      j.name,
      b"++) { ",
      Bytes::concat_all(
        range(0, st).map(|s: Int|
          Bytes::concat_all([b"Word ", ws.get(s), b" = ", at(xs, from.concat(j.name), s), b"; "])),
      ),
      spaced(dup_of(held.item, ws)),
      Bytes::concat_all(
        range(0, st).map(|s: Int|
          Bytes::concat_all([at(into, j.name, s), b" = ", ws.get(s), b"; "])),
      ),
      b"} ",
    ]);
  line(
    w.pr,
    depth,
    Bytes::concat_all([
      b"{ int64_t ",
      f.name,
      b" = ",
      int_field(xs, b"start"),
      b" + (",
      k,
      b"); int64_t ",
      h.name,
      b" = ",
      tail_from(xs),
      b"; int64_t ",
      m.name,
      b"; if (",
      f.name,
      b" >= ",
      h.name,
      b") { ",
      m.name,
      b" = ",
      int_field(xs, b"len"),
      b" - (",
      k,
      b"); ",
      into,
      b" = ",
      room_made(m.name, st),
      b"; ",
      copied(Bytes::concat_all([f.name, b" - ", h.name, b" + "])),
      b"} else { ",
      m.name,
      b" = ",
      int_field(xs, b"tail_len"),
      b"; ",
      into,
      b" = ",
      room_made(int_field(xs, b"room"), st),
      b"; ",
      word(into, ascii_of_int(l.root)),
      b" = ",
      word(xs, ascii_of_int(l.root)),
      b"; ",
      spaced(node_dup(word(into, ascii_of_int(l.root)))),
      copied(b""),
      field(into, b"start"),
      b" = (uint32_t)",
      f.name,
      b"; } ",
      field(into, b"tail_len"),
      b" = (uint32_t)",
      m.name,
      b"; ",
      field(into, b"len"),
      b" = (uint32_t)(",
      int_field(xs, b"len"),
      b" - (",
      k,
      b")); }",
    ]),
  )
}

/// Statements declaring `into` the list of `items`, each the C words an item is laid as, which the
/// list takes, `stride` words to an item: a list that is its tail where they fit in one, and
/// otherwise their leading whole leaves' worth in leaves under as many levels of branches as they
/// need, and the rest in its tail.
/// The list `into` of `items`, a leaf's at most, `stride` words to each, laid in the frame: a C
/// array of the function holding a block no count is taken of, which borrows its items.
pub fn framed_list_made(
  pr: Printing,
  depth: Int,
  into: Bytes,
  items: List<List<Bytes>>,
  stride: Int,
) -> Printing / {abort.raise} = {
  let l = layouts().list;
  let n = items.len();
  let at = into.concat(b"_f");
  line(
    pr,
    depth,
    Bytes::concat_all([
      b"Word ",
      at,
      b"[PLY_HEADER / 8 + ",
      ascii_of_int(l.tail + n * stride),
      b"]; ((PlyObj *)",
      at,
      b")->rc = PLY_RC_FRAME; Word ",
      into,
      b" = (Word)(intptr_t)",
      at,
      b"; ",
      field(into, b"len"),
      b" = ",
      ascii_of_int(n),
      b"; ",
      field(into, b"start"),
      b" = 0; ",
      field(into, b"tail_len"),
      b" = ",
      ascii_of_int(n),
      b"; ",
      field(into, b"room"),
      b" = ",
      ascii_of_int(n),
      b"; ",
      word(into, ascii_of_int(l.root)),
      b" = 0;",
      Bytes::concat_all(
        range(0, n * stride).map(|k: Int|
          Bytes::concat_all([
            b" ",
            word(into, ascii_of_int(l.tail + k)),
            b" = ",
            match items.at(k / stride) {
              Some(x) -> match x.at(k % stride) { Some(w) -> w, None -> b"0" },
              None -> b"0",
            },
            b";",
          ])),
      ),
    ]),
  )
}

pub fn list_made(
  pr: Printing,
  depth: Int,
  into: Bytes,
  items: List<List<Bytes>>,
  stride: Int,
) -> Printing / {abort.raise} = {
  let l = layouts().list;
  let width = layouts().trie.width;
  let n = items.len();
  let held = if n <= width { 0 } else { n / width * width };
  // Each of `xs` set into the block `b` from its word `from` on.
  let set = |b: Bytes, from: Int, xs: List<Bytes>|
    Bytes::concat_all(
      range(0, xs.len()).map(|k: Int|
        Bytes::concat_all([
          word(b, ascii_of_int(from + k)),
          b" = ",
          match xs.at(k) { Some(x) -> x, None -> b"0" },
          b"; ",
        ])),
    );
  // The words of `xs`, `s` to each, a word one leaves out zero.
  let words_of = |xs: List<List<Bytes>>, s: Int|
    xs.fold([], |acc: List<Bytes>, x: List<Bytes>|
      acc.concat(range(0, s).map(|j: Int| match x.at(j) { Some(w) -> w, None -> b"0" })));
  // A node of `kind` holding `xs`, `s` words to each, as a temporary of its own.
  let node = |q: Printing, kind: Int, xs: List<List<Bytes>>, s: Int| {
    let t = temp(q);
    {
      pr: line(
        t.pr,
        depth,
        Bytes::concat_all([
          b"Word ",
          t.name,
          b" = ",
          node_made(kind, s),
          b"; ",
          set(t.name, layouts().trie.first, words_of(xs, s)),
          node_field(t.name, b"len"),
          b" = ",
          ascii_of_int(xs.len()),
          b";",
        ]),
      ),
      name: t.name,
    }
  };
  // Nodes of `kind`, each holding up to `width` of `xs` in order, `s` words to each.
  let grouped = |q: Printing, kind: Int, xs: List<List<Bytes>>, s: Int|
    range(0, (xs.len() + width - 1) / width).fold(
      { pr: q, names: [] },
      |acc: { pr: Printing, names: List<Bytes> }, k: Int| {
        let made = node(acc.pr, kind, xs.drop(k * width).take(width), s);
        { pr: made.pr, names: acc.names.push(made.name) }
      },
    );
  // The leaves under a level of branches at a time, until one node holds them all.
  let raised = iterate(
    grouped(pr, layouts().trie.leaf, items.take(held), stride),
    n + 1,
    |s: { pr: Printing, names: List<Bytes> }|
      if s.names.len() <= 1 { Stop(s) }
      else { Continue(grouped(s.pr, layouts().trie.branch, s.names.map(|x: Bytes| [x]), 1)) },
  );
  let root = match raised.names { [r] -> r, _ -> b"0" };
  line(
    raised.pr,
    depth,
    Bytes::concat_all([
      b"Word ",
      into,
      b" = ",
      room_made(ascii_of_int(if held == 0 { n } else { width }), stride),
      b"; ",
      if held == 0 { b"" }
      else { Bytes::concat_all([word(into, ascii_of_int(l.root)), b" = ", root, b"; "]) },
      set(into, l.tail, words_of(items.drop(held), stride)),
      field(into, b"len"),
      b" = ",
      ascii_of_int(n),
      b"; ",
      field(into, b"tail_len"),
      b" = ",
      ascii_of_int(n - held),
      b";",
    ]),
  )
}
