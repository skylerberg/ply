//! Calls printed: a root's by its symbol, a function value's through its descriptor, a self tail
//! call as a restart, a tail call into the group and a member's answer through it, each member's
//! wrapper, a loop's passes, closures made, the constants a body reads, and closures' bodies with
//! their entries and descriptors.

import std.bytes (ascii_of_int)
import syntax.parsing (span_between)
import check.types (Type, TyCon, TyFn, TyVar, row_empty)
import emit.c (int_lit, tick_line)
import emit.reps (Ctors, FieldTy, in_place, word_type, resumption)
import emit.roots (symbol_of, root_id)
import emit.keys (Callee, Root, Generic, Named, Share, Keep, TypeOp, root_name)
import emit.layout (header_bytes)
import emit.pieces (Piece, Text, Hole, Symbol, LambdaEntry, placeholder, spelled)
import emit.answer (Expect)
import emit.tir (Rep, RInt, RBool, RNum, RFloat, RDec, RWord, RMaybe, RTagged, RFlat, RCases, RSum,
                 RUnit, Leaf, Var, Arg, AVar, Given, Lent, Owned, Borrowed, Convention, Made,
                 MClosure, Fn, Member, Lambda, Closure, Uses, Calling, Return, Rooted, rep_of_arg,
                 made_said, no_links)
import emit.tir.calling (CallingOp, ConstantRead, Ticked)
import emit.release (Held, Opening, InBox, stored_parts, drop_of)
import emit.lower.held (passing, InWords, ByReference, answer_buffer, value_words, values_of,
                        held_with)
import emit.print.text (Printing, Place, printing, function_body, line, pad, temp, named, name_of,
                        arg_text, site, slot, check, failing_return, part_names, assigned,
                        unprinted)
import emit.print.counts (let_go_of, walked, released, duped)
import emit.print.made (c_type, c_types, zeros, word_as, arg_parts, head_types, head_params,
                        head_names, words_laid, parts_read, answer_parts, entry_opened, entry_outs,
                        entry_answered, entry_answer_values, parts_word, word_parts, declared,
                        set_parts, in_box)
import emit.print.fuel (fuel_head)
import emit.print.counting (last_fn, rel_int_fn, free_fn, dec_fn, call_text)

/// A call of `c.callee` on `c.args`, its answer into `into`, its failure tested after it. The head
/// the call was written to is noted for the unit to hold the callee's own to.
pub fn call(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  c: { callee: Callee, args: List<Arg>, conv: Convention, stops: Bool },
) -> Printing / {abort.raise} =
  invoked(
    p,
    pr,
    into,
    { callee: [Hole(Symbol(c.callee))], first: [] },
    c.args,
    c.conv,
    |q: Printing| call_noted(q, c.callee, c.conv),
  )

/// `pr` noting the root `callee` names, where it names one, and the head a call of it was written to
/// at `conv`.
fn call_noted(pr: Printing, callee: Callee, conv: Convention) -> Printing / {abort.raise} =
  {
    ..called(pr, callee),
    expects: pr.expects.push({
      // The unit holds a root's head to its callers' by the root's name.
      callee: match callee { Root(k) -> root_name(k), Generic(_) -> placeholder(Symbol(callee)) },
      head: head_types(conv),
    }),
  }

/// A call of `to.callee` on `to.first` and then `args`, handed as `conv` holds them, its answer into
/// `into` and its failure tested after it; `noting` notes what the call names once its site is
/// stored.
fn invoked(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  to: { callee: List<Piece>, first: List<Bytes> },
  args: List<Arg>,
  conv: Convention,
  noting: (Printing) -> Printing / {abort.raise},
) -> Printing / {abort.raise} = {
  let handed = handed_as(pr, p.depth, args, conv.reps);
  let answer = conv.answer;
  let named_as = match into { Some(v) -> named(handed.pr, v), None -> temp(handed.pr) };
  let answered = part_names(named_as.name, answer);
  let buffer = answer_buffered(named_as.pr, p.depth, answer);
  let noted = noting(site(p, buffer.pr));
  let handed_args = Bytes::concat_all([
    b"(ctx",
    Bytes::concat_all(
      to.first.concat(handed.args).concat(buffer.args).map(|a: Bytes| b", ".concat(a)),
    ),
    b")",
  ]);
  let checked = check(p, {
    ..noted,
    out: noted.out.push(
      Text(
        Bytes::concat_all([
          pad(p.depth),
          match into {
            Some(_) -> if answered.len() == 0 { b"" }
            else { Bytes::concat_all([c_type(answer), b" ", nth(answered, 0), b" = "]) },
            None -> b"",
          },
        ]),
      ),
    ).concat(
      to.callee,
    ).push(
      Text(handed_args.concat(b";\n")),
    ),
  });
  match into {
    Some(_) -> answer_read(checked, p.depth, answered, answer, buffer.args, true),
    None -> checked,
  }
}

/// `args`, held as `reps` say, as the C arguments a call hands them as: each crossing in its C
/// values as them, and each crossing by reference laid first into a buffer of its own words, handed
/// as the buffer's address.
fn handed_as(
  pr: Printing,
  depth: Int,
  args: List<Arg>,
  reps: List<Rep>,
) -> { pr: Printing, args: List<Bytes> } / {abort.raise} =
  range(0, args.len()).fold(
    { pr: pr, args: [] },
    |acc: { pr: Printing, args: List<Bytes> }, i: Int| {
      let a = args.get(i);
      let r = match reps.at(i) { Some(x) -> x, None -> rep_of_arg(a) };
      let parts = arg_parts(pr, a);
      match passing(r) {
        InWords -> { ..acc, args: acc.args.concat(parts) },
        ByReference -> {
          let t = temp(acc.pr);
          {
            pr: line(
              t.pr,
              depth,
              Bytes::concat_all([
                b"Word ",
                t.name,
                b"[] = {",
                Bytes::join(words_laid(parts, values_of(r)), b", "),
                b"};",
              ]),
            ),
            args: acc.args.push(t.name),
          }
        },
      }
    },
  )

/// The buffer a call's callee writes the C values of an answer held as `r` past its first into, a
/// temporary declared before the call, and the arguments that hand it; nothing where the answer is
/// one C value.
fn answer_buffered(pr: Printing, depth: Int, r: Rep) -> { pr: Printing, args: List<Bytes> } = {
  let n = answer_buffer(r);
  if n == 0 { { pr: pr, args: [] } } else {
    let t = temp(pr);
    {
      pr: line(t.pr, depth, Bytes::concat_all([b"Word ", t.name, b"[", ascii_of_int(n), b"];"])),
      args: [t.name],
    }
  }
}

/// The C values `names` of an answer held as `r` past its first, read out of the buffer `buffer`
/// hands, each declared where `declare` says and set otherwise.
fn answer_read(
  pr: Printing,
  depth: Int,
  names: List<Bytes>,
  r: Rep,
  buffer: List<Bytes>,
  declare: Bool,
) -> Printing =
  match buffer.at(0) {
    None -> pr,
    Some(b) -> {
      let ts = c_types(r);
      let reads = answer_parts(nth(names, 0), b, r);
      range(1, names.len()).fold(pr, |q: Printing, k: Int|
        line(
          q,
          depth,
          Bytes::concat_all([
            if declare { nth(ts, k).concat(b" ") } else { b"" },
            nth(names, k),
            b" = ",
            nth(reads, k),
            b";",
          ]),
        ))
    },
  }

fn nth(xs: List<Bytes>, k: Int) -> Bytes = match xs.at(k) { Some(x) -> x, None -> b"" }

/// A call of the function value `c.f` on `c.args`, which it lends: through the entry its descriptor
/// holds at its function type's convention; a continuation's, which has none, through its uniform
/// entry, each argument and the answer a word.
pub fn applied(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  c: { f: Arg, args: List<Arg>, conv: Convention, stops: Bool },
) -> Printing / {abort.raise} = {
  let f = arg_text(pr, c.f);
  let typed = match c.f { AVar(v) -> match v.ty { TyFn(_) -> true, _ -> false }, _ -> false };
  if typed {
    invoked(
      p,
      pr,
      into,
      { callee: [Text(typed_callee(f, c.conv))], first: [f] },
      c.args,
      c.conv,
      |q: Printing| q,
    )
  } else {
    let names = c.args.map(|a: Arg| arg_text(pr, a));
    let arr = temp(pr);
    let laid = line(
      arr.pr,
      p.depth,
      Bytes::concat_all([
        b"Word ",
        arr.name,
        b"[] = {",
        if names.len() == 0 { b"0" } else { Bytes::join(names, b", ") },
        b"};",
      ]),
    );
    check(
      p,
      valued(p, site(p, laid), into, RWord, [
        Text(Bytes::concat_all([descriptor_of(f), b"->uniform(ctx, ", f, b", ", arr.name, b")"])),
      ]),
    )
  }
}

/// A closure of lambda `nth` of the root `p.u.symbol` names, made of its captures `m.args`: the
/// root's one block of the lambda where it captures nothing; laid out on this frame's stack, counted
/// by no one, where it is `stacked`; and a block of its own otherwise. Its first word names its
/// descriptor, and its captures follow.
pub fn closure_made(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  m: { made: Made, args: List<Arg>, reuse: Option<Var>, kept: List<Int> },
) -> Printing / {abort.raise} =
  match m.made {
    MClosure(c) -> {
      let sub = lambda_symbol(p.u.symbol, c.nth);
      if m.args.len() == 0 {
        let value = sub.concat(b"_value");
        valued(
          p,
          line(pr, p.depth, Bytes::concat_all([b"extern PlyFnBlock ", value, b";"])),
          into,
          RWord,
          [Text(b"(Word)(intptr_t)&".concat(value))],
        )
      } else {
        let desc = sub.concat(b"_desc");
        let words = [b"(Word)(intptr_t)&".concat(desc)].concat(
          m.args.map(|a: Arg| arg_text(pr, a)),
        );
        let described = line(
          pr,
          p.depth,
          Bytes::concat_all([b"extern const PlyFnDesc ", desc, b";"]),
        );
        if c.stacked {
          let arr = temp(described);
          let laid = line(
            arr.pr,
            p.depth,
            Bytes::concat_all([
              b"Word ",
              arr.name,
              b"[] = {0, 0, ",
              Bytes::join(words, b", "),
              b"}; { PlyObj *o = (PlyObj *)",
              arr.name,
              b"; o->rc = UINT32_MAX; o->kind = PLY_KIND_REFUSED; }",
            ]),
          );
          valued(p, laid, into, RWord, [Text(b"(Word)(intptr_t)".concat(arr.name))])
        } else {
          let n = match into { Some(v) -> named(described, v), None -> temp(described) };
          line(
            n.pr,
            p.depth,
            Bytes::concat_all([
              b"Word ",
              n.name,
              b" = rt_alloc_bytes_p(ctx, ",
              ascii_of_int(block_bytes(m.args.len())),
              b");",
              Bytes::concat_all(
                range(0, words.len()).map(|k: Int|
                  Bytes::concat_all([b" ", slot(n.name, k), b" = ", nth(words, k), b";"])),
              ),
            ]),
          )
        }
      }
    },
    other -> unprinted(Calling, b"a value made that is no closure", made_said(other)),
  }

/// The C name of lambda `nth` of the root named `symbol`, which its entries and descriptor are named
/// after.
fn lambda_symbol(symbol: Bytes, nth: Int) -> Bytes =
  Bytes::concat_all([symbol, b"_lambda", ascii_of_int(nth)])

/// The bytes of a closure's block of `captures` captures, its header and its descriptor's word among
/// them.
fn block_bytes(captures: Int) -> Int = header_bytes() + 8 * (1 + captures)

/// Capture `i` of the closure `of`, read where it lies past the closure's descriptor: borrowed, so
/// no count is taken.
pub fn capture_got(p: Place, pr: Printing, into: Option<Var>, of: Var, i: Int) -> Printing =
  match into {
    Some(v) -> assigned(pr, p.depth, v, c_type(v.rep), slot(name_of(pr, of), 1 + i)),
    None -> pr,
  }

/// One of the calling family's operations: what a pure definition answers, or a step counted.
pub fn calling_op(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  op: CallingOp,
  args: List<Arg>,
  uses: Uses,
) -> Printing =
  match op {
    ConstantRead(c) -> {
      let entry = in_code_table(called(site(p, pr), c), [Hole(Symbol(c)), Text(b"_entry")]);
      check(
        p,
        valued(p, entry.pr, into, RWord, [
          Text(b"rt_constant_p(ctx, "),
          Hole(LambdaEntry(entry.at)),
          Text(b")"),
        ]),
      )
    },
    Ticked -> line(pr, p.depth, tick_line(p.leave)),
  }

/// A self tail call: its arguments into temporaries, then the parameters set from them, then the
/// body again.
pub fn restarted(p: Place, pr: Printing, args: List<Arg>) -> Printing = {
  let held = held_parts(p, pr, args);
  let set = range(0, args.len()).fold(held.pr, |q: Printing, k: Int|
    match args.at(k) {
      Some(a) ->
        parts_set(
          q,
          p.depth,
          part_names(b"p".concat(ascii_of_int(k)), rep_of_arg(a)),
          match held.names.at(k) { Some(ns) -> ns, None -> [] },
        ),
      None -> q,
    });
  line(set, p.depth, b"goto ply_loop;")
}

/// Each of `args` held in temporaries of its own, value by value, so none reads a value set after.
fn held_parts(
  p: Place,
  pr: Printing,
  args: List<Arg>,
) -> { pr: Printing, names: List<List<Bytes>> } =
  args.fold({ pr: pr, names: [] }, |h: { pr: Printing, names: List<List<Bytes>> }, a: Arg| {
    let r = rep_of_arg(a);
    let t = temp(h.pr);
    let ns = part_names(t.name, r);
    let ts = c_types(r);
    let xs = arg_parts(h.pr, a);
    {
      pr: range(0, ns.len()).fold(t.pr, |q: Printing, k: Int|
        line(
          q,
          p.depth,
          Bytes::concat_all([nth(ts, k), b" ", nth(ns, k), b" = ", nth(xs, k), b";"]),
        )),
      names: h.names.push(ns),
    }
  })

/// Each of the C values `into` set from its own among `from`.
fn parts_set(pr: Printing, depth: Int, into: List<Bytes>, from: List<Bytes>) -> Printing =
  range(0, into.len()).fold(pr, |q: Printing, k: Int|
    line(q, depth, Bytes::concat_all([nth(into, k), b" = ", nth(from, k), b";"])))

/// A tail call of member `member` of the group `p.u.group` names, `args` held as that member takes
/// them: each made a word, or its values held where it crosses by reference, into temporaries
/// first, so none reads a word already set, then the group's words set from them (by reference the
/// address of the group function's buffer for that place, laid with its words), the rest of its
/// `width` zeroed, and the member's case again.
pub fn entered_member(
  p: Place,
  pr: Printing,
  member: Int,
  args: List<Arg>,
) -> Printing / {abort.raise} =
  match p.u.group {
    None ->
      unprinted(
        Calling,
        b"a tail call into a group outside a group's arm",
        Bytes::concat_all([
          b"member ",
          ascii_of_int(member),
          b" of ",
          ascii_of_int(args.len()),
          b" values",
        ]),
      ),
    Some(g) -> {
      // Every value is held before any `p` is set: an argument may read one, or a buffer one names.
      let held = args.fold(
        { pr: pr, slots: [] },
        |h: { pr: Printing, slots: List<{ buffered: Bool, words: List<Bytes> }> }, a: Arg| {
          let r = rep_of_arg(a);
          match passing(r) {
            InWords -> {
              let w = one_word(p, h.pr, a);
              let t = temp(w.pr);
              {
                pr: line(
                  t.pr,
                  p.depth,
                  Bytes::concat_all([b"Word ", t.name, b" = ", w.word, b";"]),
                ),
                slots: h.slots.push({ buffered: false, words: [t.name] }),
              }
            },
            ByReference -> {
              let parts = held_parts(p, h.pr, [a]);
              let ns = match parts.names.at(0) { Some(x) -> x, None -> [] };
              {
                pr: parts.pr,
                slots: h.slots.push({ buffered: true, words: words_laid(ns, values_of(r)) }),
              }
            },
          }
        },
      );
      // A parameter crossing by reference is laid in the function's buffer for its place, which
      // outlives the jump.
      let set = range(0, g.width).fold(held.pr, |q: Printing, k: Int| {
        let slot = b"p".concat(ascii_of_int(k));
        match held.slots.at(k) {
          None -> line(q, p.depth, slot.concat(b" = 0;")),
          Some(s) -> if !s.buffered {
            line(q, p.depth, Bytes::concat_all([slot, b" = ", nth(s.words, 0), b";"]))
          } else {
            let buffer = entered_buffer(k);
            line(
              range(0, s.words.len()).fold(q, |q2: Printing, w: Int|
                line(
                  q2,
                  p.depth,
                  Bytes::concat_all([
                    buffer,
                    b"[",
                    ascii_of_int(w),
                    b"] = ",
                    nth(s.words, w),
                    b";",
                  ]),
                )),
              p.depth,
              Bytes::concat_all([slot, b" = ", address_word(buffer), b";"]),
            )
          },
        }
      });
      line(
        line(set, p.depth, Bytes::concat_all([b"which = ", ascii_of_int(member), b";"])),
        p.depth,
        b"goto ply_loop;",
      )
    },
  }

/// A member of a tail group answering `a`, held as the member answers, through the word the group's
/// function answers.
pub fn member_returned(p: Place, pr: Printing, a: Arg) -> Printing = {
  let w = one_word(p, pr, a);
  line(
    line(w.pr, p.depth, b"ctx->fuel += 1;"),
    p.depth,
    Bytes::concat_all([b"return ", w.word, b";"]),
  )
}

/// The buffer of the words of member parameter `k` of a tail group's function where a tail call
/// into a member hands it by reference.
fn entered_buffer(k: Int) -> Bytes = b"ply_e".concat(ascii_of_int(k))

/// The address of the buffer `b` as the word a group's function takes in its place.
fn address_word(b: Bytes) -> Bytes = b"(Word)(intptr_t)".concat(b)

/// The buffers tail group `f`'s function declares before its loop: one for each place a member
/// takes a parameter by reference at, as many words as the widest such parameter there takes.
pub fn group_buffers(f: Fn) -> List<Bytes> = {
  let width = f.members.fold(0, |w: Int, m: Member|
    if m.params.len() > w { m.params.len() } else { w });
  range(0, width).fold([], |acc: List<Bytes>, k: Int| {
    let n = f.members.fold(0, |most: Int, m: Member|
      match m.params.at(k) {
        Some(v) -> if passing(v.rep) == InWords { most } else {
          let words = value_words(v.rep);
          if words > most { words } else { most }
        },
        None -> most,
      });
    if n == 0 { acc } else {
      acc.push(Bytes::concat_all([b"Word ", entered_buffer(k), b"[", ascii_of_int(n), b"];"]))
    }
  })
}

/// `v`, a member's parameter of a tail group crossing by reference, bound in the member's arm from
/// the word `word` of the group's function, the address of its words.
pub fn member_opened(pr: Printing, depth: Int, v: Var, word: Bytes) -> Printing = {
  let n = named(pr, v);
  let ts = c_types(v.rep);
  let ns = part_names(n.name, v.rep);
  let reads = parts_read(Bytes::concat_all([b"((Word *)(intptr_t)", word, b")"]), values_of(v.rep));
  line(
    n.pr,
    depth,
    Bytes::join(
      range(0, ns.len()).map(|k: Int|
        Bytes::concat_all([nth(ts, k), b" ", nth(ns, k), b" = ", nth(reads, k), b";"])),
      b" ",
    ),
  )
}

/// `a` as one word: a value held as several made one first.
fn one_word(p: Place, pr: Printing, a: Arg) -> { pr: Printing, word: Bytes } = {
  let made = temp(pr);
  let w = parts_word(made.pr, made.name, arg_parts(pr, a), rep_of_arg(a));
  {
    pr: if w.prep.len() == 0 { w.pr }
    else { { ..w.pr, out: w.pr.out.push(Text(pad(p.depth))).concat(w.prep).push(Text(b"\n")) } },
    word: w.word,
  }
}

/// What opens a `Loop` numbered `label` over `state`, first `init`: each state variable declared
/// holding its first value, value by value, the answer declared, and the loop's C `for`.
pub fn loop_opened(
  p: Place,
  pr: Printing,
  label: Int,
  state: List<Var>,
  init: List<Arg>,
  answer: Var,
) -> Printing = {
  let held = range(0, state.len()).fold(pr, |q: Printing, i: Int|
    match state.at(i) {
      Some(v) -> {
        let n = named(q, v);
        let ns = part_names(n.name, v.rep);
        let ts = c_types(v.rep);
        let xs = match init.at(i) { Some(a) -> arg_parts(pr, a), None -> zeros(v.rep) };
        range(0, ns.len()).fold(n.pr, |r: Printing, k: Int|
          line(
            r,
            p.depth,
            Bytes::concat_all([nth(ts, k), b" ", nth(ns, k), b" = ", nth(xs, k), b";"]),
          ))
      },
      None -> q,
    });
  line(declared(held, p.depth, answer), p.depth, b"for (;;) {")
}

/// What closes `Loop` `label`.
pub fn loop_closed(p: Place, pr: Printing, label: Int, answer: Var) -> Printing =
  line(pr, p.depth, b"}")

/// The loop's next pass with `state` rebound to `args`: each argument held first, so none reads a
/// state variable already rebound.
pub fn next(p: Place, pr: Printing, label: Int, state: List<Var>, args: List<Arg>) -> Printing = {
  let held = held_parts(p, pr, args);
  let set = range(0, state.len()).fold(held.pr, |q: Printing, k: Int|
    match state.at(k) {
      Some(v) ->
        parts_set(q, p.depth, part_names(name_of(q, v), v.rep), match held.names.at(k) {
          Some(ns) -> ns,
          None -> [],
        }),
      None -> q,
    });
  line(set, p.depth, b"continue;")
}

/// The loop left answering `arg` into `answer`, value by value.
pub fn done(p: Place, pr: Printing, label: Int, answer: Var, arg: Arg) -> Printing =
  line(set_parts(pr, p.depth, answer, arg), p.depth, b"break;")

/// The C names a closure body's parameters have: its captures `q<i>`, then its own `p<j>`.
pub fn lambda_names(l: Lambda, nth: Int) -> Map<Int, Bytes> / {abort.raise} =
  match l {
    Closure(c) ->
      range(0, c.body.params.len()).fold(Map::new(), |m: Map<Int, Bytes>, i: Int|
        m.insert(c.body.params.get(i).id, if i < c.captures { b"q".concat(ascii_of_int(i)) }
        else { b"p".concat(ascii_of_int(i - c.captures)) })),
  }

/// The function of closure body `nth` of `root`, its body printed as `pr.out`: its captures, each a
/// word it reads out of the closure, then its own parameters as the closure's convention carries
/// them. Then the closure's entries: by its function type's convention and by words, each lending
/// the captures out of the closure it is handed; its release, share and keep, which walk each
/// capture as its type lays it out; and its descriptor naming them, and where it captures nothing
/// the root's one block of it. The printing after it holds the tables they add to.
pub fn lambda_text(
  root: Fn,
  nth: Int,
  l: Lambda,
  pr: Printing,
) -> { pr: Printing, out: List<Piece> } / {abort.raise} =
  match l {
    Closure(c) -> {
      let name = lambda_symbol(symbol_of(root_name(root.key)), nth);
      // The function's own parameters, as the closure's type takes them past its captures.
      let own = {
        ..c.body.conv,
        params: c.body.conv.params.drop(c.captures),
        reps: c.body.conv.reps.drop(c.captures),
      };
      let answer = own.answer;
      let lent = range(0, c.captures).map(|i: Int| slot(b"self", 1 + i));
      let block = InBox({
        parts: range(0, c.captures).map(|i: Int|
          {
            at: 1 + i,
            ty: match c.body.params.at(i) { Some(v) -> v.ty, None -> word_type() },
            rep: RWord,
          }),
        words: 1 + c.captures,
      });
      let uniform = entry_text(
        pr,
        Bytes::concat_all([
          b"static Word ",
          name,
          b"_uniform(PlyCtx *ctx, Word self, const Word *args)",
        ]),
        name,
        lent,
        {
          conv: own,
          types: c.body.params.drop(c.captures).map(|v: Var| v.ty),
          answer_ty: c.body.answer_ty,
        },
      );
      let freed = release_entry(uniform.pr, name, block);
      let shared = walk_entry(freed.pr, name, Share, block);
      let kept = walk_entry(shared.pr, name, Keep, block);
      {
        pr: kept.pr,
        out: [
          Text(
            Bytes::concat_all([
              c_type(answer),
              b" ",
              name,
              b"(PlyCtx *ctx",
              Bytes::concat_all(
                range(0, c.captures).map(|i: Int| b", Word q".concat(ascii_of_int(i))),
              ),
              Bytes::concat_all(head_params(own).map(|h: Bytes| b", ".concat(h))),
              b") {\n",
              fuel_head(answer),
            ]),
          ),
        ].concat(
          pr.out,
        ).push(
          Text(b"}\n"),
        ).push(
          Text(typed_entry(name, lent, own)),
        ).concat(
          uniform.out,
        ).concat(
          freed.out,
        ).concat(
          shared.out,
        ).concat(
          kept.out,
        ).push(
          Text(descriptor(name, c.captures, own.reps, answer)),
        ),
      }
    },
  }

/// The entry a call by a closure's type enters its function `name` through: the closure lent, its
/// captures `lent` read out of it, and the rest of the head handed on as the function, of convention
/// `own` past its captures, takes it.
fn typed_entry(name: Bytes, lent: List<Bytes>, own: Convention) -> Bytes =
  Bytes::concat_all([
    b"static ",
    c_type(own.answer),
    b" ",
    name,
    b"_typed(PlyCtx *ctx, Word self",
    Bytes::concat_all(head_params(own).map(|h: Bytes| b", ".concat(h))),
    b") {\n  return ",
    name,
    b"(ctx",
    Bytes::concat_all(
      lent.concat(head_names(own.reps, own.answer)).map(|a: Bytes| b", ".concat(a)),
    ),
    b");\n}\n",
  ])

/// The release entry of the closure of function `name`, a block laid as `block` says: each capture
/// let go of as its type counts it, then its memory given back.
fn release_entry(
  pr: Printing,
  name: Bytes,
  block: Opening,
) -> { pr: Printing, out: List<Piece> } / {abort.raise} =
  match block {
    InBox(b) -> {
      let go = b.parts.fold(
        { pr: pr, out: [] },
        |acc: { pr: Printing, out: List<Piece> }, h: Held| {
          let s = let_go_of(acc.pr, stored_parts(pr.ctors, h), [slot(b"self", h.at)]);
          {
            pr: s.pr,
            out: if s.out.len() == 0 { acc.out }
            else { acc.out.push(Text(pad(0))).concat(s.out).push(Text(b"\n")) },
          }
        },
      );
      {
        pr: go.pr,
        out: [
          Text(Bytes::concat_all([b"static Word ", name, b"_release(PlyCtx *ctx, Word self) {\n"])),
        ].concat(
          go.out,
        ).push(
          Text(
            Bytes::concat_all([
              b"  ",
              call_text(free_fn(), [b"ctx", b"self", ascii_of_int(header_bytes() + 8 * b.words)]),
              b";\n  return 0;\n}\n",
            ]),
          ),
        ),
      }
    },
    _ -> unprinted(Calling, b"a closure's block opened as no box", name),
  }

/// The entry of the closure of function `name`, a block laid as `block` says, that walks it as `op`
/// does: shares it, or keeps it for good.
fn walk_entry(
  pr: Printing,
  name: Bytes,
  op: TypeOp,
  block: Opening,
) -> { pr: Printing, out: List<Piece> } / {abort.raise} = {
  let of = { id: 0, ty: word_type(), rep: RWord };
  let into = { id: 1, ty: word_type(), rep: RWord };
  let walk = walked(
    function_body(pr, Map::new().insert(of.id, b"self")),
    0,
    into,
    of,
    op,
    block,
    drop_of(word_type()),
  );
  {
    pr: walk,
    out: [
      Text(
        Bytes::concat_all([
          b"static Word ",
          name,
          if op == Share { b"_share" } else { b"_keep" },
          b"(PlyCtx *ctx, Word self) {\n",
        ]),
      ),
    ].concat(
      walk.out,
    ).push(
      Text(Bytes::concat_all([b"  return ", name_of(walk, into), b";\n}\n"])),
    ),
  }
}

/// The descriptor of the closures of function `name`, naming its entries and its convention; and
/// where it captures nothing, the one block of it the root's closures share, which no one counts.
fn descriptor(name: Bytes, captures: Int, own: List<Rep>, answer: Rep) -> Bytes =
  Bytes::concat_all([
    b"const PlyFnDesc ",
    name,
    b"_desc = { ",
    Bytes::join(
      [
        name.concat(b"_uniform"),
        Bytes::concat_all([b"(void (*)(void))", name, b"_typed"]),
        convention_id(own, answer),
        name.concat(b"_release"),
        name.concat(b"_share"),
        name.concat(b"_keep"),
      ],
      b", ",
    ),
    b" };\n",
    if captures > 0 { b"" } else {
      Bytes::concat_all([
        b"PlyFnBlock ",
        name,
        b"_value = { { UINT32_MAX, PLY_KIND_REFUSED, 0, 0, 0, 0 }, &",
        name,
        b"_desc };\n",
      ])
    },
  ])

/// What an entry by words needs of the function it enters: its convention, each parameter's type,
/// and the type of what it answers.
pub type Entered = { conv: Convention, types: List<Type>, answer_ty: Type }

/// What an entry by words needs of the root `f`.
pub fn entered_of(f: Fn) -> Entered =
  { conv: f.conv, types: f.params.map(|v: Var| v.ty), answer_ty: f.answer_ty }

/// The entry the runtime enters root `name` through, words in and out, as `entry_text` writes one.
pub fn runtime_entry(
  pr: Printing,
  name: Bytes,
  e: Entered,
) -> { pr: Printing, out: List<Piece> } / {abort.raise} =
  entry_text(
    pr,
    Bytes::concat_all([b"Word ", name, b"_entry(PlyCtx *ctx, const Word *args)"]),
    name,
    [],
    e,
  )

/// An entry of function `name` by words, headed `head`, which takes each argument and hands back an
/// answer of its own: `first` handed first, then each parameter's word, from `args`, opened into the
/// values `e.conv` holds it as and handed as the function takes it; the answer made a word. Where
/// the function only borrows a parameter, its values are let go of after the call, and where it
/// answers what it read out of one, the answer is counted once more before.
fn entry_text(
  pr: Printing,
  head: Bytes,
  name: Bytes,
  first: List<Bytes>,
  e: Entered,
) -> { pr: Printing, out: List<Piece> } / {abort.raise} = {
  let c = e.conv;
  let opened = range(0, c.reps.len()).fold(
    { text: [], args: [], values: [] },
    |acc: { text: List<Piece>, args: List<Bytes>, values: List<List<Bytes>> }, j: Int| {
      let o = entry_opened(j, c.reps.get(j));
      {
        text: acc.text.concat(o.text),
        args: acc.args.concat(o.args),
        values: acc.values.push(o.values),
      }
    },
  );
  let call = Bytes::concat_all([
    name,
    b"(ctx",
    Bytes::concat_all(
      first.concat(opened.args).concat(entry_outs(c.answer)).map(|a: Bytes| b", ".concat(a)),
    ),
    b")",
  ]);
  let promoted = match c.answered {
    Owned -> [],
    Borrowed(_) -> {
      let d = duped(pr, e.answer_ty, c.answer, entry_answer_values(c.answer));
      if d.len() == 0 { [] }
      else { [Text(Bytes::concat_all([b"  if (!ctx->failed) { ", d, b" }\n"]))] }
    },
  };
  let let_go = range(0, c.reps.len()).fold(
    { pr: pr, out: [] },
    |acc: { pr: Printing, out: List<Piece> }, j: Int|
      if c.params.at(j) != Some(Lent) { acc } else {
        let s = released(acc.pr, e.types.get(j), c.reps.get(j), opened.values.get(j));
        {
          pr: s.pr,
          out: if s.out.len() == 0 { acc.out }
          else { acc.out.push(Text(b"  ")).concat(s.out).push(Text(b"\n")) },
        }
      },
  );
  let answered = entry_answered(let_go.pr, c.answer, call, promoted.concat(let_go.out));
  {
    pr: answered.pr,
    out: [Text(head.concat(b" {\n"))].concat(opened.text).concat(answered.out).push(Text(b"}\n")),
  }
}

/// Member `i` of the tail group `f` as a root of its own: its head, which hands its parameters to
/// the group's function as words, a value held as several made one first and one crossing by
/// reference as the address of its words, and its answer back as its convention carries it; then
/// its entry. Printed after `pr`, whose tables the words' and the
/// entry's shapes go on into.
pub fn group_wrapper(
  f: Fn,
  i: Int,
  pr: Printing,
) -> { pr: Printing, out: List<Piece> } / {abort.raise} =
  match f.members.at(i) {
    None -> { pr: pr, out: [] },
    Some(m) -> {
      let name = symbol_of(root_name(m.key));
      let answer = m.conv.answer;
      let width = f.members.fold(0, |w: Int, x: Member|
        if x.conv.reps.len() > w { x.conv.reps.len() } else { w });
      let words = range(0, m.conv.reps.len()).fold(
        { pr: pr, prep: [], words: [] },
        |acc: { pr: Printing, prep: List<Piece>, words: List<Bytes> }, j: Int| {
          let r = m.conv.reps.get(j);
          let param = b"p".concat(ascii_of_int(j));
          let made = b"ply_g".concat(ascii_of_int(j));
          match passing(r) {
            InWords -> {
              let w = parts_word(acc.pr, made, part_names(param, r), r);
              {
                pr: w.pr,
                prep: if w.prep.len() == 0 { acc.prep }
                else { acc.prep.push(Text(b"  ")).concat(w.prep).push(Text(b"\n")) },
                words: acc.words.push(w.word),
              }
            },
            // The caller's buffer of the value's words, as the group's function reads a member's
            // parameter crossing by reference.
            ByReference -> { ..acc, words: acc.words.push(address_word(param)) },
          }
        },
      );
      let call = Bytes::concat_all([
        symbol_of(root_name(f.key)),
        b"_group(ctx, ",
        ascii_of_int(i),
        Bytes::concat_all(
          range(0, width).map(|j: Int|
            b", ".concat(match words.words.at(j) { Some(w) -> w, None -> b"0" })),
        ),
        b")",
      ]);
      let entered = runtime_entry(words.pr, name, {
        conv: m.conv,
        types: m.params.map(|v: Var| v.ty),
        answer_ty: f.answer_ty,
      });
      {
        pr: entered.pr,
        out: [
          Text(
            Bytes::concat_all([
              c_type(answer),
              b" ",
              name,
              b"(PlyCtx *ctx",
              Bytes::concat_all(head_params(m.conv).map(|h: Bytes| b", ".concat(h))),
              b") {\n",
            ]),
          ),
        ].concat(
          words.prep,
        ).concat(
          group_answered(call, answer),
        ).push(
          Text(b"}\n"),
        ).concat(
          entered.out,
        ),
      }
    },
  }

/// How a member's wrapper hands back what the group's function `call` answers, a word, as the member
/// answers `answer`: the word itself; an `Option`'s or a `Result`'s object opened; a scalar read out
/// and the word let go; a value held as several opened into them, each past the first written into
/// the caller's buffer `o`.
fn group_answered(call: Bytes, answer: Rep) -> List<Piece> = {
  let got = Bytes::concat_all([b"  Word r = ", call, b";\n  if (ctx->failed) "]);
  match answer {
    RWord -> [Text(Bytes::concat_all([b"  return ", call, b";\n"]))],
    RMaybe ->
      [Text(Bytes::concat_all([got, b"return 0;\n  return ", word_as(b"r", answer), b";\n"]))],
    RTagged ->
      [Text(Bytes::concat_all([got, b"return 0;\n  return ", word_as(b"r", answer), b";\n"]))],
    RFlat(_) -> several_answered(got, answer),
    RCases(_) -> several_answered(got, answer),
    RSum(_) -> if in_box(answer) { several_answered(got, answer) }
    else { [Text(Bytes::concat_all([b"  return ", call, b";\n"]))] },
    RUnit -> [Text(Bytes::concat_all([b"  ", call, b";\n  return 0;\n"]))],
    k ->
      [
        Text(
          Bytes::concat_all([
            got,
            failing_return(k),
            b"\n  ",
            c_type(k),
            b" v = ",
            word_as(b"r", k),
            b";\n  ",
            call_text(dec_fn(), [b"ctx", b"r"]),
            b";\n  return v;\n",
          ]),
        ),
      ],
  }
}

fn several_answered(got: Bytes, answer: Rep) -> List<Piece> = {
  let vs = part_names(b"v", answer);
  let ws = words_laid(vs.drop(1), values_of(answer).drop(1));
  [Text(Bytes::concat_all([got, failing_return(answer), b"\n  "]))].concat(
    word_parts(b"r", answer, vs),
  ).push(
    Text(
      Bytes::concat_all([
        b"\n",
        Bytes::concat_all(
          range(0, ws.len()).map(|k: Int|
            Bytes::concat_all([b"  o[", ascii_of_int(k), b"] = ", nth(ws, k), b";\n"])),
        ),
        b"  return ",
        nth(vs, 0),
        b";\n",
      ]),
    ),
  )
}

/// The descriptor of the function value `f`, which the first word of its block names.
fn descriptor_of(f: Bytes) -> Bytes =
  Bytes::concat_all([b"((const PlyFnDesc *)(intptr_t)", slot(f, 0), b")"])

/// The entry the descriptor of the function value `f` holds at convention `c`, cast to it: what a
/// call of `f` by its type calls, handing `f` first.
pub fn typed_callee(f: Bytes, c: Convention) -> Bytes =
  Bytes::concat_all([b"((", entry_type(c), b")", descriptor_of(f), b"->typed)"])

/// The convention a function of type `t` is called at by its type: each parameter given and the
/// answer owned, each held as a body holds a value of its type over the constructor table `ctors`.
pub fn convention_of(ctors: Ctors, t: { params: List<Type>, ret: Type }) -> Convention = {
  let reps = t.params.map(|x: Type| held_with(ctors, x));
  { params: reps.map(|_: Rep| Given), reps: reps, answer: held_with(ctors, t.ret), answered: Owned }
}

/// The C type of the entry a closure of convention `c` is called through by its type: the closure,
/// then each argument's values, then the pointers the answer's values past its first come back
/// through.
fn entry_type(c: Convention) -> Bytes = {
  let h = head_types(c);
  Bytes::concat_all([
    h.answer,
    b" (*)(PlyCtx *, Word",
    Bytes::concat_all(h.params.map(|t: Bytes| b", ".concat(t))),
    b")",
  ])
}

/// A convention as the C integer a closure's descriptor holds: a digest of how each value crosses.
fn convention_id(params: List<Rep>, answer: Rep) -> Bytes =
  int_lit(root_id(Bytes::join(params.push(answer).map(rep_spelled), b",")))

/// How a convention spells a value crossing as `r`: a scalar by its kind, a record by its leaves.
fn rep_spelled(r: Rep) -> Bytes =
  match r {
    RFlat(ls) ->
      Bytes::concat_all([
        b"{",
        Bytes::join(ls.map(|l: Leaf| Bytes::concat_all([l.name, b":", one_spelled(l.rep)])), b","),
        b"}",
      ]),
    _ -> one_spelled(r),
  }

/// How a convention spells a value crossing as one value held as `r`, a sum by its words.
fn one_spelled(r: Rep) -> Bytes =
  match r {
    RInt -> b"i",
    RBool -> b"b",
    RFloat -> b"f",
    RDec -> b"d",
    RMaybe -> b"m",
    RTagged -> b"t",
    RNum(w) -> Bytes::concat_all([if w.signed { b"s" } else { b"u" }, ascii_of_int(w.bits)]),
    RSum(_) -> Bytes::concat_all([b"s", ascii_of_int(value_words(r))]),
    RUnit -> b"n",
    _ -> b"w",
  }

/// `pr` with `expr` written as a value held as `rep`, into `into` where the value is kept.
fn valued(p: Place, pr: Printing, into: Option<Var>, rep: Rep, expr: List<Piece>) -> Printing =
  match into {
    Some(v) -> {
      let n = named(pr, v);
      {
        ..n.pr,
        out: n.pr.out.push(
          Text(Bytes::concat_all([pad(p.depth), c_type(rep), b" ", n.name, b" = "])),
        ).concat(
          expr,
        ).push(
          Text(b";\n"),
        ),
      }
    },
    None -> { ..pr, out: pr.out.push(Text(pad(p.depth))).concat(expr).push(Text(b";\n")) },
  }

/// `pr` noting that the body calls the root `callee` names, where it names one.
fn called(pr: Printing, callee: Callee) -> Printing =
  match callee {
    Root(k) -> if pr.calls.contains(k) { pr } else { { ..pr, calls: pr.calls.push(k) } },
    _ -> pr,
  }

/// The place among the code table the unit fills `@@l<i>@@` holes from that the entry spelled as
/// `entry` has, added where it is not there yet.
fn in_code_table(pr: Printing, entry: List<Piece>) -> { pr: Printing, at: Int } =
  match range(0, pr.lambdas.len()).fold(None, |acc: Option<Int>, i: Int|
      match acc {
        Some(_) -> acc,
        None -> if pr.lambdas.at(i) == Some(entry) { Some(i) } else { None },
      }) {
    Some(i) -> { pr: pr, at: i },
    None -> { pr: { ..pr, lambdas: pr.lambdas.push(entry) }, at: pr.lambdas.len() },
  }

fn place() -> Place =
  {
    u: {
      symbol: b"f",
      base: 0,
      answer: RWord,
      site: None,
      arm: None,
      looping: None,
      landing: None,
      group: None,
      leaving: b"ctx->fuel += 1;",
    },
    at: span_between(0, 0),
    leave: b"return 0;",
    depth: 0,
  }

test "a call lays a record wider than four words in a buffer it hands, and reads a wide answer out of one it hands last" {
  let wide = RFlat(range(0, 5).map(|i: Int| { name: b"f".concat(ascii_of_int(i)), rep: RInt }));
  let local = |id: Int| { id: id, ty: TyCon({ name: b"T", args: [] }), rep: wide };
  let conv = { params: [Given], reps: [wide], answer: wide, answered: Owned };
  let callee = Root(Named(b"m.g"));
  let pr = call(place(), printing(Map::new().insert(0, b"w")), Some(local(1)), {
    callee: callee,
    args: [AVar(local(0))],
    conv: conv,
    stops: false,
  });
  assert_eq(
    spelled(pr.out),
    Bytes::concat_all([
      b"  Word t1[] = {(Word)(w_0), (Word)(w_1), (Word)(w_2), (Word)(w_3), (Word)(w_4)};\n",
      b"  Word t3[4];\n",
      b"  int64_t t2_0 = ",
      symbol_of(b"m.g"),
      b"(ctx, t1, t3);\n",
      b"  if (ctx->failed) return 0;\n",
      b"  int64_t t2_1 = (int64_t)t3[0];\n",
      b"  int64_t t2_2 = (int64_t)t3[1];\n",
      b"  int64_t t2_3 = (int64_t)t3[2];\n",
      b"  int64_t t2_4 = (int64_t)t3[3];\n",
    ]),
  );
  // The head the call was written to is the one a root of this convention is declared with.
  assert_eq(pr.expects.map(|e: Expect| e.head), [head_types(conv)])
}

fn int() -> Type = TyCon({ name: b"Int", args: [] })

test "a function value is called through its descriptor's entry at its type's convention, and a continuation through its uniform entry" {
  let names = printing(Map::new().insert(0, b"f").insert(1, b"x"));
  let fty = TyFn({ params: [int()], ret: int(), effects: row_empty() });
  let typed = applied(place(), names, Some({ id: 2, ty: int(), rep: RInt }), {
    f: AVar({ id: 0, ty: fty, rep: RWord }),
    args: [AVar({ id: 1, ty: int(), rep: RInt })],
    conv: { params: [Given], reps: [RInt], answer: RInt, answered: Owned },
    stops: false,
  });
  assert_eq(
    spelled(typed.out),
    Bytes::concat_all([
      b"  int64_t t1 = ((int64_t (*)(PlyCtx *, Word, int64_t))((const PlyFnDesc *)(intptr_t)",
      b"ply_words(f)[0])->typed)(ctx, f, x);\n",
      b"  if (ctx->failed) return 0;\n",
    ]),
  );
  let resumed = applied(place(), names, Some({ id: 2, ty: int(), rep: RWord }), {
    f: AVar({ id: 0, ty: resumption(int()), rep: RWord }),
    args: [AVar({ id: 1, ty: int(), rep: RWord })],
    conv: { params: [Given], reps: [RWord], answer: RWord, answered: Owned },
    stops: true,
  });
  assert_eq(
    spelled(resumed.out),
    Bytes::concat_all([
      b"  Word t1[] = {x};\n",
      b"  Word t2 = ((const PlyFnDesc *)(intptr_t)ply_words(f)[0])->uniform(ctx, f, t1);\n",
      b"  if (ctx->failed) return 0;\n",
    ]),
  )
}

test "a closure is a block of its own with its descriptor first, a stacked one counted by no one, and one capturing nothing the root's one block" {
  let names = printing(Map::new().insert(0, b"x"));
  let made = |captures: Int, stacked: Bool|
    spelled(
      closure_made(place(), names, Some({ id: 1, ty: int(), rep: RWord }), {
        made: MClosure({ nth: 2, captures: captures, params: 1, stacked: stacked }),
        args: range(0, captures).map(|_: Int| AVar({ id: 0, ty: int(), rep: RWord })),
        reuse: None,
        kept: [],
      }).out,
    );
  assert_eq(
    made(1, false),
    Bytes::concat_all([
      b"  extern const PlyFnDesc f_lambda2_desc;\n",
      b"  Word t1 = rt_alloc_bytes_p(ctx, 32); ply_words(t1)[0] = (Word)(intptr_t)&f_lambda2_desc;",
      b" ply_words(t1)[1] = x;\n",
    ]),
  );
  assert_eq(
    made(1, true),
    Bytes::concat_all([
      b"  extern const PlyFnDesc f_lambda2_desc;\n",
      b"  Word t1[] = {0, 0, (Word)(intptr_t)&f_lambda2_desc, x}; { PlyObj *o = (PlyObj *)t1;",
      b" o->rc = UINT32_MAX; o->kind = PLY_KIND_REFUSED; }\n",
      b"  Word t2 = (Word)(intptr_t)t1;\n",
    ]),
  );
  assert_eq(
    made(0, true),
    b"  extern PlyFnBlock f_lambda2_value;\n  Word t1 = (Word)(intptr_t)&f_lambda2_value;\n",
  );
  // A capture is read where it lies past the descriptor, borrowed.
  assert_eq(
    spelled(
      capture_got(
        place(),
        printing(Map::new().insert(1, b"c")),
        Some({ id: 0, ty: int(), rep: RWord }),
        { id: 1, ty: word_type(), rep: RWord },
        1,
      ).out,
    ),
    b"  Word t1 = ply_words(c)[2];\n",
  )
}

test "a root's entry lets go of what the root only borrows after the call, a borrowed answer counted once more first" {
  let string = TyCon({ name: b"String", args: [] });
  let lending = {
    params: [Lent, Given],
    reps: [RWord, RInt],
    answer: RWord,
    answered: Borrowed([{ param: 0, whole: true }]),
  };
  let entry = |c: Convention|
    spelled(
      runtime_entry(printing(Map::new()), b"f", {
        conv: c,
        types: [string, int()],
        answer_ty: string,
      }).out,
    );
  let text = entry(lending);
  let pr = printing(Map::new());
  let promoted = duped(pr, string, RWord, [b"r0"]);
  let let_go = spelled(released(pr, string, RWord, [b"a0"]).out);
  assert(
    text.index_of(
        Bytes::concat_all([
          b"  Word r0 = f(ctx, a0, a1);\n  if (!ctx->failed) { ",
          promoted,
          b" }\n  ",
          let_go,
          b"\n  return r0;\n}\n",
        ]),
      )
      != None,
    Some(String::of_bytes_lossy(text)),
  );
  // Given everything and answering a count of its own, the root takes what the entry was handed.
  let given = entry({ ..lending, params: [Given, Given], answered: Owned });
  assert(
    given.index_of(b"  return f(ctx, a0, a1);\n}\n") != None,
    Some(String::of_bytes_lossy(given)),
  )
}

test "a closure's entries lend its captures out of its block, its release lets each go of by its type, a continuation through its descriptor" {
  let k = resumption(TyVar(0));
  let params = [
    { id: 0, ty: int(), rep: RWord },
    { id: 1, ty: k, rep: RWord },
    { id: 2, ty: int(), rep: RInt },
  ];
  let body = {
    key: Named(b"m.outer"),
    kind: Rooted,
    params: params,
    conv: {
      params: [Lent, Lent, Given],
      reps: [RWord, RWord, RInt],
      answer: RInt,
      answered: Owned,
    },
    answer_ty: int(),
    body: [Return(AVar({ id: 2, ty: int(), rep: RInt }))],
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  };
  let l = Closure({ body: body, captures: 2, at: span_between(0, 0) });
  let text = spelled(lambda_text(body, 0, l, printing(Map::new())).out);
  let name = symbol_of(b"m.outer").concat(b"_lambda0");
  let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  has(Bytes::concat_all([b"int64_t ", name, b"(PlyCtx *ctx, Word q0, Word q1, int64_t p0) {\n"]));
  has(
    Bytes::concat_all([
      b"_typed(PlyCtx *ctx, Word self, int64_t p0) {\n  return ",
      name,
      b"(ctx, ply_words(self)[1], ply_words(self)[2], p0);\n}\n",
    ]),
  );
  has(Bytes::concat_all([b"(ctx, ply_words(self)[1], ply_words(self)[2], "]));
  has(Bytes::concat_all([b"  ", call_text(rel_int_fn(), [b"ctx", b"ply_words(self)[1]"]), b";\n"]));
  has(
    Bytes::concat_all([
      b"  if (ply_words(self)[2] && ",
      call_text(last_fn(), [b"ctx", b"ply_words(self)[2]"]),
      b") ((const PlyFnDesc *)(intptr_t)ply_words(ply_words(self)[2])[0])->release(ctx, ply_words(self)[2]);\n",
    ]),
  );
  has(
    Bytes::concat_all([
      b"  ",
      call_text(free_fn(), [b"ctx", b"self", b"40"]),
      b";\n  return 0;\n}\n",
    ]),
  );
  has(b"->share(ctx, ply_words(self)[2]))");
  has(
    Bytes::concat_all([
      name,
      b"_keep(PlyCtx *ctx, Word self) {\n  Word t1 = 0;\n  return t1;\n}\n",
    ]),
  );
  has(
    Bytes::concat_all([
      b"const PlyFnDesc ",
      name,
      b"_desc = { ",
      name,
      b"_uniform, (void (*)(void))",
      name,
      b"_typed, ",
    ]),
  );
  assert(text.index_of(b"PlyFnBlock ") == None, Some(String::of_bytes_lossy(text)))
}
