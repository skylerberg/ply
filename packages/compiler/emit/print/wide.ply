pub const wide_helpers: Bytes =
  Bytes::concat_all([
    b"static inline PlyWide ply_wide(uint64_t lo, uint64_t hi) { PlyWide x; x.lo = (Word)lo; x.hi = (Word)hi; return x; }\n",
    b"static inline PlyWide ply_wide_negated(PlyWide a) {\n",
    b"  uint64_t lo = ~(uint64_t)a.lo + 1;\n",
    b"  return ply_wide(lo, ~(uint64_t)a.hi + (lo == 0));\n",
    b"}\n",
    b"static inline int ply_wide_add(PlyWide a, PlyWide b, int s, PlyWide *r) {\n",
    b"  uint64_t lo = (uint64_t)a.lo + (uint64_t)b.lo, c = lo < (uint64_t)a.lo;\n",
    b"  uint64_t h = (uint64_t)a.hi + (uint64_t)b.hi, hi = h + c;\n",
    b"  *r = ply_wide(lo, hi);\n",
    b"  if (s) return (int64_t)(((uint64_t)a.hi ^ hi) & ((uint64_t)b.hi ^ hi)) < 0;\n",
    b"  return h < (uint64_t)a.hi || hi < h;\n",
    b"}\n",
    b"static inline int ply_wide_sub(PlyWide a, PlyWide b, int s, PlyWide *r) {\n",
    b"  uint64_t lo = (uint64_t)a.lo - (uint64_t)b.lo, c = (uint64_t)a.lo < (uint64_t)b.lo;\n",
    b"  uint64_t h = (uint64_t)a.hi - (uint64_t)b.hi, hi = h - c;\n",
    b"  *r = ply_wide(lo, hi);\n",
    b"  if (s) return (int64_t)(((uint64_t)a.hi ^ (uint64_t)b.hi) & ((uint64_t)a.hi ^ hi)) < 0;\n",
    b"  return (uint64_t)a.hi < (uint64_t)b.hi || h < c;\n",
    b"}\n",
    b"static inline uint64_t ply_mul_words(uint64_t a, uint64_t b, uint64_t *hi) {\n",
    b"  uint64_t a0 = a & 0xFFFFFFFFu, a1 = a >> 32, b0 = b & 0xFFFFFFFFu, b1 = b >> 32;\n",
    b"  uint64_t p00 = a0 * b0, p01 = a0 * b1, p10 = a1 * b0;\n",
    b"  uint64_t mid = (p00 >> 32) + (p01 & 0xFFFFFFFFu) + (p10 & 0xFFFFFFFFu);\n",
    b"  *hi = a1 * b1 + (p01 >> 32) + (p10 >> 32) + (mid >> 32);\n",
    b"  return (mid << 32) | (p00 & 0xFFFFFFFFu);\n",
    b"}\n",
    b"static inline int ply_wide_umul(PlyWide a, PlyWide b, PlyWide *r) {\n",
    b"  uint64_t h, c1h, c2h;\n",
    b"  uint64_t lo = ply_mul_words((uint64_t)a.lo, (uint64_t)b.lo, &h);\n",
    b"  uint64_t c1 = ply_mul_words((uint64_t)a.lo, (uint64_t)b.hi, &c1h);\n",
    b"  uint64_t c2 = ply_mul_words((uint64_t)a.hi, (uint64_t)b.lo, &c2h);\n",
    b"  uint64_t m = h + c1, hi = m + c2;\n",
    b"  *r = ply_wide(lo, hi);\n",
    b"  return m < h || hi < m || c1h != 0 || c2h != 0 || (a.hi != 0 && b.hi != 0);\n",
    b"}\n",
    b"static inline int ply_wide_mul(PlyWide a, PlyWide b, int s, PlyWide *r) {\n",
    b"  if (!s) return ply_wide_umul(a, b, r);\n",
    b"  int na = (int64_t)a.hi < 0, nb = (int64_t)b.hi < 0, neg = na != nb;\n",
    b"  PlyWide m;\n",
    b"  int over = ply_wide_umul(na ? ply_wide_negated(a) : a, nb ? ply_wide_negated(b) : b, &m);\n",
    b"  if (!over && (uint64_t)m.hi >= UINT64_C(0x8000000000000000))\n",
    b"    over = !(neg && (uint64_t)m.hi == UINT64_C(0x8000000000000000) && m.lo == 0);\n",
    b"  *r = neg ? ply_wide_negated(m) : m;\n",
    b"  return over;\n",
    b"}\n",
    b"static inline int ply_wide_neg(PlyWide a, int s, PlyWide *r) {\n",
    b"  *r = ply_wide_negated(a);\n",
    b"  if (s) return (uint64_t)a.hi == UINT64_C(0x8000000000000000) && a.lo == 0;\n",
    b"  return a.lo != 0 || a.hi != 0;\n",
    b"}\n",
    b"static inline void ply_wide_udivrem(PlyWide n, PlyWide d, PlyWide *q, PlyWide *m) {\n",
    b"  uint64_t nl = (uint64_t)n.lo, nh = (uint64_t)n.hi, dl = (uint64_t)d.lo, dh = (uint64_t)d.hi;\n",
    b"  if (nh == 0 && dh == 0) { *q = ply_wide(nl / dl, 0); *m = ply_wide(nl % dl, 0); return; }\n",
    b"  uint64_t ql = 0, qh = 0, rl = 0, rh = 0;\n",
    b"  for (int i = 127; i >= 0; i--) {\n",
    b"    uint64_t top = rh >> 63;\n",
    b"    rh = (rh << 1) | (rl >> 63);\n",
    b"    rl = (rl << 1) | ((i >= 64 ? nh >> (i - 64) : nl >> i) & 1);\n",
    b"    if (top || rh > dh || (rh == dh && rl >= dl)) {\n",
    b"      uint64_t c = rl < dl;\n",
    b"      rl -= dl;\n",
    b"      rh = rh - dh - c;\n",
    b"      if (i >= 64) qh |= (uint64_t)1 << (i - 64); else ql |= (uint64_t)1 << i;\n",
    b"    }\n",
    b"  }\n",
    b"  *q = ply_wide(ql, qh);\n",
    b"  *m = ply_wide(rl, rh);\n",
    b"}\n",
    b"static inline int ply_wide_divrem(PlyWide a, PlyWide b, int s, PlyWide *q, PlyWide *m) {\n",
    b"  if (!s) { ply_wide_udivrem(a, b, q, m); return 0; }\n",
    b"  int na = (int64_t)a.hi < 0, nb = (int64_t)b.hi < 0;\n",
    b"  PlyWide uq, ur;\n",
    b"  ply_wide_udivrem(na ? ply_wide_negated(a) : a, nb ? ply_wide_negated(b) : b, &uq, &ur);\n",
    b"  *q = na != nb ? ply_wide_negated(uq) : uq;\n",
    b"  *m = na ? ply_wide_negated(ur) : ur;\n",
    b"  return (uint64_t)a.hi == UINT64_C(0x8000000000000000) && a.lo == 0 && ~(uint64_t)b.lo == 0 && ~(uint64_t)b.hi == 0;\n",
    b"}\n",
    b"static inline PlyWide ply_wide_shl(PlyWide a, int64_t n) {\n",
    b"  uint64_t lo = (uint64_t)a.lo, hi = (uint64_t)a.hi;\n",
    b"  if (n == 0) return a;\n",
    b"  if (n >= 64) return ply_wide(0, lo << (n - 64));\n",
    b"  return ply_wide(lo << n, (hi << n) | (lo >> (64 - n)));\n",
    b"}\n",
    b"static inline PlyWide ply_wide_shr(PlyWide a, int64_t n, int s) {\n",
    b"  uint64_t lo = (uint64_t)a.lo, hi = (uint64_t)a.hi;\n",
    b"  uint64_t fill = s && (int64_t)hi < 0 ? ~(uint64_t)0 : 0;\n",
    b"  if (n == 0) return a;\n",
    b"  if (n >= 64) return ply_wide(s ? (uint64_t)((int64_t)hi >> (n - 64)) : hi >> (n - 64), fill);\n",
    b"  return ply_wide((lo >> n) | (hi << (64 - n)), s ? (uint64_t)((int64_t)hi >> n) : hi >> n);\n",
    b"}\n",
    b"static inline PlyWide ply_wide_rotr(PlyWide a, int64_t n) {\n",
    b"  int64_t k = (n % 128 + 128) % 128;\n",
    b"  if (k == 0) return a;\n",
    b"  PlyWide x = ply_wide_shr(a, k, 0), y = ply_wide_shl(a, 128 - k);\n",
    b"  return ply_wide((uint64_t)x.lo | (uint64_t)y.lo, (uint64_t)x.hi | (uint64_t)y.hi);\n",
    b"}\n",
    b"static inline PlyWide ply_wide_rotl(PlyWide a, int64_t n) {\n",
    b"  return ply_wide_rotr(a, (128 - (n % 128 + 128) % 128) % 128);\n",
    b"}\n",
    b"static inline PlyWide ply_wide_end(int s, int high) {\n",
    b"  if (high) return ply_wide(~(uint64_t)0, s ? UINT64_C(0x7FFFFFFFFFFFFFFF) : ~(uint64_t)0);\n",
    b"  return ply_wide(0, s ? UINT64_C(0x8000000000000000) : 0);\n",
    b"}\n",
    b"static inline PlyWide ply_wide_sat_add(PlyWide a, PlyWide b, int s) {\n",
    b"  PlyWide r;\n",
    b"  if (!ply_wide_add(a, b, s, &r)) return r;\n",
    b"  return ply_wide_end(s, !s || (int64_t)a.hi >= 0);\n",
    b"}\n",
    b"static inline PlyWide ply_wide_sat_sub(PlyWide a, PlyWide b, int s) {\n",
    b"  PlyWide r;\n",
    b"  if (!ply_wide_sub(a, b, s, &r)) return r;\n",
    b"  return ply_wide_end(s, s && (int64_t)a.hi >= 0);\n",
    b"}\n",
    b"static inline PlyWide ply_wide_sat_mul(PlyWide a, PlyWide b, int s) {\n",
    b"  PlyWide r;\n",
    b"  if (!ply_wide_mul(a, b, s, &r)) return r;\n",
    b"  return ply_wide_end(s, !s || ((int64_t)a.hi < 0) == ((int64_t)b.hi < 0));\n",
    b"}\n",
    b"static inline int ply_wide_fits_int(PlyWide a, int s) {\n",
    b"  if (s) return (int64_t)a.hi == ((int64_t)a.lo >> 63);\n",
    b"  return a.hi == 0 && (int64_t)a.lo >= 0;\n",
    b"}\n",
  ])
