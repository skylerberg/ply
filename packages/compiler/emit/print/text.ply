//! What printing a root's form shares: the lines and tables printed so far, the C names of its
//! variables, and the few spellings every instruction's printing uses.

import compiler.syntax.parsing (Span)
import std.bytes (ascii_of_int)
import compiler.emit.c (SizedIntKind, kind_c_type, int_lit)
import compiler.emit.output (ExpectedPrototype, SharedFn)
import compiler.emit.keys (RootKey)
import compiler.emit.representations (Ctors, no_ctors)
import compiler.check.types (Type)
import compiler.emit.pieces (Piece, Text, Hole, SiteRoot, FailureSiteRoot, FromCaller, FieldName)
import compiler.emit.typed_ir (Representation, AsDecimal, AsWideFixed, AsInt, AsFlattened, AsSum,
                               AsUnit, Var, Arg, VarOperand, IntOperand, BoolOperand, FloatOperand,
                               FixedOperand, CharOperand, ZeroOperand, Member, Unwinding)
import compiler.emit.layout (Pointer)
import compiler.emit.lower.representation (c_values_of)

/// What every line of one function's body is printed under: the C name of the root it belongs to,
/// which the functions of the root's closures are named after (`<symbol>_lambda<nth>`), where the
/// text its failure sites count from starts and the root they name where it is not the body's own
/// (a group's member, a lender), how it answers, the arm of the `Match` being printed and the `Loop`
/// around it, each by the label number that names its C labels, inside a `Handle`'s body the C that
/// goes to its landing, where a failure goes instead of leaving the function, inside a member's arm
/// of a tail group's function, that group, and the C a `Return` runs before it returns.
pub type BodyContext = {
  symbol: Bytes,
  base: Int,
  result: Representation,
  site: Option<FailureSiteRoot>,
  arm: Option<{ label: Int, at: Int }>,
  looping: Option<{ label: Int, state: List<Var>, result: Var }>,
  landing: Option<Bytes>,
  group: Option<TailGroupArm>,
  /// The resources a failure here lets go of before what the failing instruction holds, in order.
  unwinds: List<Unwinding>,
  epilogue: Bytes,
}

/// Inside the arm of member `at` of a tail group's function: the group's members, and how many
/// words, `p0..`, the function takes after `which`, the widest member's parameters.
pub type TailGroupArm = { at: Int, members: List<Member>, width: Int }

/// Where one instruction is printed: under `u`, for the source at `at`, indented `depth`, and going
/// on a failure by `leave`, a jump to the tails that release what the failure path holds and then
/// leave the function, or inside a `Handle`'s body go to its landing.
pub type InstructionContext = { u: BodyContext, at: Span, leave: Bytes, depth: Int }

/// The lines so far, each variable's C name, how many temporaries and labels are named, the roots
/// called, and the tables the unit fills a root's holes from, each in the order its holes number it:
/// the constants read from the pool, the field names it names, its code table
/// (the symbol of each entry a closure or a function value names, `LambdaEntry`), the operations it
/// performs and handles, and the head each root call was written to. Then the function's failure
/// paths: the C block being printed and how many were opened, where each variable named so far was
/// declared, and the tails releasing what a failure holds, each labelled by its place among them.
/// `ctors` is the program's constructor table, which a release reads a sum's cases off. Then its
/// frame records (`emit.print.frames`): how many slots the widest record its sites link holds, and
/// the bodies of the root's `each` functions so far. `count_root_type` is the type whose `Held` count root
/// is printed, which counts a value of it word by word rather than through itself. `placing` is
/// where the body being printed writes records lying in place rather than boxes.
pub type Printing = {
  out: List<Piece>,
  names: Map<Int, Bytes>,
  temps: Int,
  labels: Int,
  calls: List<RootKey>,
  fields: List<Bytes>,
  lambdas: List<List<Piece>>,
  performs: List<Bytes>,
  handles: List<Bytes>,
  expects: List<ExpectedPrototype>,
  shared: List<SharedFn>,
  block: Int,
  blocks: Int,
  declared: Map<Int, Declaration>,
  tails: Cleanups,
  ctors: Ctors,
  widest: Int,
  each_functions: List<List<Piece>>,
  count_root_type: Option<Type>,
  placing: Destinations,
}

/// Where a body writes records lying in place that it would otherwise box, by variable, from
/// `emit.print.placing`: `destination_passing`, whether its root takes a destination `d`; `results`, made,
/// updated or called straight into `d`, each the root's answer and read nowhere else; `slots`, a
/// call's answer written into a slot of the C frame, only read and let go of where it lies;
/// `moving`, a slot's words moved by the one read into a place right before its release, by the
/// variable that read binds; `moved`, the slots a read has moved out of, whose release that follows
/// is nothing.
pub type Destinations = {
  destination_passing: Bool,
  results: Map<Int, Bool>,
  slots: Map<Int, Bool>,
  moving: Map<Int, Int>,
  moved: Map<Int, Bool>,
}

pub fn no_destinations() -> Destinations =
  {
    destination_passing: false,
    results: Map::new(),
    slots: Map::new(),
    moving: Map::new(),
    moved: Map::new(),
  }

/// Whether `a` is a slot whose words the read binding variable `by` moves.
pub fn moves_slot(printing: Printing, a: Arg, by: Int) -> Bool =
  match a { VarOperand(x) -> printing.placing.moving.get(x.id) == Some(by), _ -> false }

/// `printing` with each of `args` that is a slot whose words the read binding `by` moves moved out.
pub fn slots_moved(printing: Printing, args: List<Arg>, by: Int) -> Printing =
  args.fold(printing, |q: Printing, a: Arg|
    match a {
      VarOperand(x) -> if moves_slot(q, a, by) {
        { ..q, placing: { ..q.placing, moved: q.placing.moved.insert(x.id, true) } }
      } else { q },
      _ -> q,
    })

/// Where a variable's C name was declared: the C block, 0 the function's own, and its temporary's
/// number, so one declared later numbers higher. A parameter is declared at 0, 0.
pub type Declaration = { block: Int, at: Int }

/// One release on a failure path: the value named `name`, variable `id`, of type `ty` held as
/// `representation`, let go of, then `then`, the C the path goes on by (the next tail's label, or leaving).
/// `letting` is where the tail lets go of a resource, by its type's `LetGo` root, rather than of a
/// count.
pub type Cleanup = {
  name: Bytes,
  id: Int,
  ty: Type,
  representation: Representation,
  then: Bytes,
  letting: Option<Unwinding>,
}

/// The tails a function's failure paths share, each labelled by its place in `all`: the label of
/// each by its value's name and what it goes on by, and the labels printed at the end of each C
/// block, the one its value was declared in, so every failure path inside that block reaches them.
pub type Cleanups = { all: List<Cleanup>, keyed: Map<Bytes, Int>, held: Map<Int, List<Int>> }

pub fn no_cleanups() -> Cleanups = { all: [], keyed: Map::new(), held: Map::new() }

/// A root printed: its C, its closures' functions after its own, and what its holes and calls name.
pub type PrintOutput = {
  pieces: List<Piece>,
  calls: List<RootKey>,
  fields: List<Bytes>,
  lambdas: List<List<Piece>>,
  performs: List<Bytes>,
  handles: List<Bytes>,
  expects: List<ExpectedPrototype>,
  shared: List<SharedFn>,
}

/// Nothing printed yet, its parameters named by `names`, for a program of no constructors.
pub fn empty_printing(names: Map<Int, Bytes>) -> Printing =
  {
    out: [],
    names: names,
    temps: 0,
    labels: 0,
    calls: [],
    fields: [],
    lambdas: [],
    performs: [],
    handles: [],
    expects: [],
    shared: [],
    block: 0,
    blocks: 0,
    declared: Map::new(),
    tails: no_cleanups(),
    ctors: no_ctors(),
    widest: 0,
    each_functions: [],
    count_root_type: None,
    placing: no_destinations(),
  }

/// What a C function's body is printed from after `printing`, its parameters named by `names`: `printing`'s
/// tables and `each` functions, and nothing of the body `printing` printed, whose temporaries, labels,
/// blocks, tails and frame record were that function's own.
pub fn function_body(printing: Printing, names: Map<Int, Bytes>) -> Printing =
  {
    ..printing,
    out: [],
    names: names,
    temps: 0,
    labels: 0,
    block: 0,
    blocks: 0,
    declared: Map::new(),
    tails: no_cleanups(),
    widest: 0,
  }

/// The `k`th of `xs`, empty past their end.
pub fn nth(xs: List<Bytes>, k: Int) -> Bytes = match xs.at(k) { Some(x) -> x, None -> b"" }

/// Panics over what a printer has no C for, naming the case and what it was handed: the form's
/// check admits only what the printers write, so reaching one is a defect in Ply.
pub fn unsupported<a>(case: Bytes, handed: Bytes) -> a / {abort.raise} =
  panic(String::of_bytes_lossy(Bytes::concat_all([b"unprinted ", case, b": ", handed])))

pub fn line(printing: Printing, depth: Int, t: Bytes) -> Printing =
  { ..printing, out: printing.out.push(Text(Bytes::concat_all([pad(depth), t, b"\n"]))) }

pub fn text(printing: Printing, t: Bytes) -> Printing =
  { ..printing, out: printing.out.push(Text(t)) }

pub fn pieces(printing: Printing, ps: List<Piece>) -> Printing =
  { ..printing, out: printing.out.concat(ps) }

pub fn pad(depth: Int) -> Bytes = Bytes::concat_all(range(0, depth + 1).map(|_: Int| b"  "))

/// A temporary of its own, `t<n>`.
pub fn temp(printing: Printing) -> { printing: Printing, name: Bytes } =
  {
    printing: { ..printing, temps: printing.temps + 1 },
    name: b"t".concat(ascii_of_int(printing.temps + 1)),
  }

/// The next label number, which names the C labels of one `Match`, `Loop` or `Handle`.
pub fn label(printing: Printing) -> { printing: Printing, n: Int } =
  { printing: { ..printing, labels: printing.labels + 1 }, n: printing.labels }

/// `v` given the next temporary as its C name, declared in the block being printed.
pub fn named(printing: Printing, v: Var) -> { printing: Printing, name: Bytes } = {
  let t = temp(printing);
  {
    printing: {
      ..t.printing,
      names: t.printing.names.insert(v.id, t.name),
      declared: t.printing.declared.insert(v.id, { block: printing.block, at: t.printing.temps }),
    },
    name: t.name,
  }
}

/// Where `v`'s C name was declared.
pub fn declared_at(printing: Printing, v: Var) -> Declaration =
  match printing.declared.get(v.id) { Some(d) -> d, None -> { block: 0, at: 0 } }

pub fn name_of(printing: Printing, v: Var) -> Bytes =
  match printing.names.get(v.id) { Some(n) -> n, None -> b"0" }

/// Operand `a` as a C expression.
pub fn arg_text(printing: Printing, a: Arg) -> Bytes =
  match a {
    VarOperand(v) -> name_of(printing, v),
    IntOperand(n) -> int_lit(n),
    BoolOperand(b) -> if b { b"1" } else { b"0" },
    FloatOperand(bits) -> Bytes::concat_all([b"ply_f64(", int_lit(bits), b")"]),
    FixedOperand(n) ->
      Bytes::concat_all([b"((", kind_c_type(SizedIntKind(n.width)), b")", int_lit(n.bits), b")"]),
    CharOperand(c) -> Bytes::concat_all([b"((Word)", int_lit(c * 8 + 2), b")"]),
    ZeroOperand(r) -> zero(r),
  }

/// `v = e`, declaring `v` as a new temporary of C type `c`.
pub fn assigned(printing: Printing, depth: Int, v: Var, c: Bytes, e: Bytes) -> Printing = {
  let n = named(printing, v);
  line(n.printing, depth, Bytes::concat_all([c, b" ", n.name, b" = ", e, b";"]))
}

/// The failure site stored before a checked operation or a call, as bytes from the root's
/// definition, so the C does not change when the definition moves; in a body whose sites are its
/// caller's, the site its caller set.
pub fn site(p: InstructionContext, printing: Printing) -> Printing =
  if p.u.site == Some(FromCaller) {
    text(
      printing,
      pad(p.depth).concat(b"PLY_SITE(ctx, ply_called[0], ply_called[1], ply_called[2]);\n"),
    )
  } else if p.at.end <= p.at.start { printing } else {
    {
      ..printing,
      out: printing.out.concat([
        Text(pad(p.depth).concat(b"PLY_SITE(ctx, ")),
        Hole(SiteRoot(p.u.site)),
        Text(
          Bytes::concat_all([
            b", ",
            ascii_of_int(p.at.start - p.u.base),
            b", ",
            ascii_of_int(p.at.end - p.u.base),
            b");\n",
          ]),
        ),
      ]),
    }
  }

/// Word `at` of the block whose word is the C expression `base`, which a field or a constructor's
/// argument is held in.
pub fn slot(base: Bytes, at: Int) -> Bytes =
  Bytes::concat_all([b"ply_words(", base, b")[", ascii_of_int(at), b"]"])

/// The test after an operation that can fail: leave as `p` says.
pub fn check(p: InstructionContext, printing: Printing) -> Printing =
  line(printing, p.depth, b"if (ctx->failed) ".concat(p.leave))

/// What a variable held as `r` stands at before anything is set into it: its first C value's, `0`
/// for a value of none.
pub fn zero(r: Representation) -> Bytes =
  match c_values_of(r).at(0) {
    Some(AsDecimal) -> b"(PlyDec){0, 0}",
    Some(AsWideFixed(_)) -> b"(PlyWide){0, 0}",
    _ -> b"0",
  }

/// Leaving a function answering as `r` on a failure, holding nothing.
pub fn failing_return(r: Representation) -> Bytes = Bytes::concat_all([b"return ", zero(r), b";"])

/// The C names of the values a value named `name` held as `r` is held in, in `c_values_of`' order: its
/// own name where it is one, and `<name>_<k>` for its `k`th where it is several, none where it is
/// held in none.
pub fn part_names(name: Bytes, r: Representation) -> List<Bytes> = {
  let n = c_values_of(r).len();
  if n == 1 { [name] } else { range(0, n).map(|k: Int| part_name(name, k)) }
}

/// The C name of value `k` of a value named `name` held as several.
pub fn part_name(name: Bytes, k: Int) -> Bytes = Bytes::concat_all([name, b"_", ascii_of_int(k)])

/// `part_names(name, r)`'s `k`th, `0` past them, without naming the others.
pub fn part_named(name: Bytes, r: Representation, k: Int) -> Bytes = {
  let n = c_values_of(r).len();
  if k < 0 || k >= n { b"0" } else if n == 1 { name } else { part_name(name, k) }
}

/// The hole of `name`'s entry in the field table, added to the printing's fields where it is not
/// there yet.
pub fn field_hole(printing: Printing, name: Bytes) -> { printing: Printing, piece: Piece } = {
  let f = interned(printing.fields, name);
  { printing: { ..printing, fields: f.xs }, piece: Hole(FieldName(f.at)) }
}

/// `x`'s place in `xs`, appended where it is not there yet.
pub fn interned(xs: List<Bytes>, x: Bytes) -> { xs: List<Bytes>, at: Int } =
  match range(0, xs.len()).fold(None, |acc: Option<Int>, i: Int|
      match acc { Some(_) -> acc, None -> if xs.at(i) == Some(x) { Some(i) } else { None } }) {
    Some(i) -> { xs: xs, at: i },
    None -> { xs: xs.push(x), at: xs.len() },
  }

test "a value's C values are named as values_of lays them, its own name where it has one" {
  let narrow = AsSum({ layout: { classes: [Pointer], cases: [] }, cases: [b"m.A", b"m.B"] });
  let wide = AsSum({ layout: { classes: [Pointer, Pointer], cases: [] }, cases: [b"m.A", b"m.B"] });
  let flat = AsFlattened([
    { name: b"d", representation: AsDecimal },
    { name: b"s", representation: wide },
  ]);
  let reps = [narrow, wide, flat, AsUnit, AsDecimal, AsInt];
  assert_eq(
    reps.map(|r: Representation| part_names(b"x", r).len()),
    reps.map(|r: Representation| c_values_of(r).len()),
  );
  assert_eq(part_names(b"x", narrow), [b"x"]);
  assert_eq(part_names(b"x", wide), [b"x_0", b"x_1"]);
  assert_eq(part_names(b"x", flat), [b"x_0", b"x_1", b"x_2"]);
  assert_eq(
    reps.map(|r: Representation|
      range(-1, c_values_of(r).len() + 1).map(|k: Int| part_named(b"x", r, k))),
    reps.map(|r: Representation| [b"0"].concat(part_names(b"x", r)).push(b"0")),
  );
  assert_eq(reps.map(zero), [b"0", b"0", b"(PlyDec){0, 0}", b"0", b"(PlyDec){0, 0}", b"0"])
}
