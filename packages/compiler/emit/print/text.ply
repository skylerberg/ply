import compiler.syntax.parsing (Span)
import std.bytes (ascii_of_int)
import compiler.emit.c (SizedIntKind, kind_c_type, int_literal)
import compiler.emit.output (ExpectedPrototype, SharedFunction)
import compiler.emit.keys (RootKey)
import compiler.emit.representations (Constructors, no_constructors)
import compiler.check.types (Type)
import compiler.emit.pieces (Piece, Text, Hole, SiteRoot, FailureOwner, FromCaller, FieldName)
import compiler.emit.typed_ir (Representation, AsDecimal, AsWideFixed, AsInt, AsFlattened, AsSum,
                               AsUnit, Variable, Arg, VariableOperand, IntOperand, BoolOperand,
                               FloatOperand, FixedOperand, CharOperand, ZeroOperand, Member,
                               Unwinding)
import compiler.emit.layout (Pointer)
import compiler.emit.lower.representation (c_values_of)

pub type BodyContext = {
  symbol: Bytes,
  base: Int,
  result: Representation,
  site: Option<FailureOwner>,
  arm: Option<{ label: Int, at: Int }>,
  looping: Option<{ label: Int, state: List<Variable>, result: Variable }>,
  handler_jump: Option<Bytes>,
  group: Option<TailGroupArm>,
  unwinds: List<Unwinding>,
  epilogue: Bytes,
}

pub type TailGroupArm = { at: Int, members: List<Member>, width: Int }

pub type InstructionContext = { u: BodyContext, at: Span, exit_statement: Bytes, depth: Int }

pub type Printing = {
  out: List<Piece>,
  names: Map<Int, Bytes>,
  temps: Int,
  labels: Int,
  calls: List<RootKey>,
  fields: List<Bytes>,
  lambdas: List<List<Piece>>,
  performs: List<Bytes>,
  handles: List<Bytes>,
  expects: List<ExpectedPrototype>,
  shared: List<SharedFunction>,
  natives: List<Bytes>,
  block: Int,
  blocks: Int,
  declared: Map<Int, Declaration>,
  tails: Cleanups,
  constructors: Constructors,
  widest: Int,
  each_functions: List<List<Piece>>,
  count_root_type: Option<Type>,
  placing: Destinations,
}

pub type Destinations = {
  destination_passing: Bool,
  results: Map<Int, Bool>,
  slots: Map<Int, Bool>,
  moving: Map<Int, Int>,
  moved: Map<Int, Bool>,
}

pub fn no_destinations() -> Destinations =
  {
    destination_passing: false,
    results: Map::new(),
    slots: Map::new(),
    moving: Map::new(),
    moved: Map::new(),
  }

pub fn moves_slot(printing: Printing, a: Arg, by: Int) -> Bool =
  match a { VariableOperand(x) -> printing.placing.moving.get(x.id) == Some(by), _ -> false }

pub fn slots_moved(printing: Printing, args: List<Arg>, by: Int) -> Printing =
  args.fold(printing, |q: Printing, a: Arg|
    match a {
      VariableOperand(x) -> if moves_slot(q, a, by) {
        { ..q, placing: { ..q.placing, moved: q.placing.moved.insert(x.id, true) } }
      } else { q },
      _ -> q,
    })

pub type Declaration = { block: Int, at: Int }

pub type Cleanup = {
  name: Bytes,
  id: Int,
  ty: Type,
  representation: Representation,
  then: Bytes,
  resource: Option<Unwinding>,
}

pub type Cleanups = { all: List<Cleanup>, keyed: Map<Bytes, Int>, by_block: Map<Int, List<Int>> }

pub fn no_cleanups() -> Cleanups = { all: [], keyed: Map::new(), by_block: Map::new() }

pub type PrintOutput = {
  pieces: List<Piece>,
  calls: List<RootKey>,
  fields: List<Bytes>,
  lambdas: List<List<Piece>>,
  performs: List<Bytes>,
  handles: List<Bytes>,
  expects: List<ExpectedPrototype>,
  shared: List<SharedFunction>,
  natives: List<Bytes>,
}

pub fn empty_printing(names: Map<Int, Bytes>) -> Printing =
  {
    out: [],
    names: names,
    temps: 0,
    labels: 0,
    calls: [],
    fields: [],
    lambdas: [],
    performs: [],
    handles: [],
    expects: [],
    shared: [],
    natives: [],
    block: 0,
    blocks: 0,
    declared: Map::new(),
    tails: no_cleanups(),
    constructors: no_constructors(),
    widest: 0,
    each_functions: [],
    count_root_type: None,
    placing: no_destinations(),
  }

pub fn function_body(printing: Printing, names: Map<Int, Bytes>) -> Printing =
  {
    ..printing,
    out: [],
    names: names,
    temps: 0,
    labels: 0,
    block: 0,
    blocks: 0,
    declared: Map::new(),
    tails: no_cleanups(),
    widest: 0,
  }

pub fn nth(xs: List<Bytes>, k: Int) -> Bytes = match xs.at(k) { Some(x) -> x, None -> b"" }

pub fn unsupported<a>(case: Bytes, value: Bytes) -> a / {abort.raise} =
  panic(String::of_bytes_lossy(Bytes::concat_all([b"unprinted ", case, b": ", value])))

pub fn line(printing: Printing, depth: Int, t: Bytes) -> Printing =
  { ..printing, out: printing.out.push(Text(Bytes::concat_all([pad(depth), t, b"\n"]))) }

pub fn text(printing: Printing, t: Bytes) -> Printing =
  { ..printing, out: printing.out.push(Text(t)) }

pub fn pieces(printing: Printing, ps: List<Piece>) -> Printing =
  { ..printing, out: printing.out.concat(ps) }

pub fn pad(depth: Int) -> Bytes = Bytes::concat_all(range(0, depth + 1).map(|_: Int| b"  "))

pub fn temp(printing: Printing) -> { printing: Printing, name: Bytes } =
  {
    printing: { ..printing, temps: printing.temps + 1 },
    name: b"t".concat(ascii_of_int(printing.temps + 1)),
  }

pub fn label(printing: Printing) -> { printing: Printing, n: Int } =
  { printing: { ..printing, labels: printing.labels + 1 }, n: printing.labels }

pub fn named(printing: Printing, v: Variable) -> { printing: Printing, name: Bytes } = {
  let t = temp(printing);
  {
    printing: {
      ..t.printing,
      names: t.printing.names.insert(v.id, t.name),
      declared: t.printing.declared.insert(v.id, { block: printing.block, at: t.printing.temps }),
    },
    name: t.name,
  }
}

pub fn declared_at(printing: Printing, v: Variable) -> Declaration =
  match printing.declared.get(v.id) { Some(d) -> d, None -> { block: 0, at: 0 } }

pub fn name_of(printing: Printing, v: Variable) -> Bytes =
  match printing.names.get(v.id) { Some(n) -> n, None -> b"0" }

pub fn arg_text(printing: Printing, a: Arg) -> Bytes =
  match a {
    VariableOperand(v) -> name_of(printing, v),
    IntOperand(n) -> int_literal(n),
    BoolOperand(b) -> if b { b"1" } else { b"0" },
    FloatOperand(bits) -> Bytes::concat_all([b"ply_f64(", int_literal(bits), b")"]),
    FixedOperand(n) ->
      Bytes::concat_all([
        b"((",
        kind_c_type(SizedIntKind(n.width)),
        b")",
        int_literal(n.bits),
        b")",
      ]),
    CharOperand(c) -> Bytes::concat_all([b"((Word)", int_literal(c * 8 + 2), b")"]),
    ZeroOperand(r) -> zero(r),
  }

pub fn assigned(printing: Printing, depth: Int, v: Variable, c: Bytes, e: Bytes) -> Printing = {
  let n = named(printing, v);
  line(n.printing, depth, Bytes::concat_all([c, b" ", n.name, b" = ", e, b";"]))
}

fn stored_site(p: InstructionContext) -> List<Piece> =
  if p.u.site == Some(FromCaller) {
    [Text(b"PLY_SITE(ctx, ply_called[0], ply_called[1], ply_called[2]);")]
  } else if p.at.end <= p.at.start { [] } else {
    [
      Text(b"PLY_SITE(ctx, "),
      Hole(SiteRoot(p.u.site)),
      Text(
        Bytes::concat_all([
          b", ",
          ascii_of_int(p.at.start - p.u.base),
          b", ",
          ascii_of_int(p.at.end - p.u.base),
          b");",
        ]),
      ),
    ]
  }

pub fn source_position(p: InstructionContext, printing: Printing) -> Printing =
  match stored_site(p) {
    [] -> printing,
    site -> pieces(printing, [Text(pad(p.depth))].concat(site).push(Text(b"\n"))),
  }

pub fn fails_when(
  p: InstructionContext,
  printing: Printing,
  condition: Bytes,
  report: Bytes,
) -> Printing =
  pieces(
    printing,
    [Text(Bytes::concat_all([pad(p.depth), b"if (", condition, b") { "]))].concat(
      match stored_site(p) { [] -> [], site -> site.push(Text(b" ")) },
    ).push(
      Text(Bytes::concat_all([report, b" ", p.exit_statement, b" }\n"])),
    ),
  )

pub fn slot(base: Bytes, at: Int) -> Bytes =
  Bytes::concat_all([b"ply_words(", base, b")[", ascii_of_int(at), b"]"])

pub fn check(p: InstructionContext, printing: Printing) -> Printing =
  line(printing, p.depth, b"if (ctx->failed) ".concat(p.exit_statement))

pub fn zero(r: Representation) -> Bytes =
  match c_values_of(r).at(0) {
    Some(AsDecimal) -> b"(PlyDec){0, 0}",
    Some(AsWideFixed(_)) -> b"(PlyWide){0, 0}",
    _ -> b"0",
  }

pub fn failing_return(r: Representation) -> Bytes = Bytes::concat_all([b"return ", zero(r), b";"])

pub fn part_names(name: Bytes, r: Representation) -> List<Bytes> = {
  let n = c_values_of(r).len();
  if n == 1 { [name] } else { range(0, n).map(|k: Int| part_name(name, k)) }
}

pub fn part_name(name: Bytes, k: Int) -> Bytes = Bytes::concat_all([name, b"_", ascii_of_int(k)])

pub fn part_named(name: Bytes, r: Representation, k: Int) -> Bytes = {
  let n = c_values_of(r).len();
  if k < 0 || k >= n { b"0" } else if n == 1 { name } else { part_name(name, k) }
}

pub fn native_noted(printing: Printing, helper: Bytes) -> Printing =
  if printing.natives.contains(helper) { printing }
  else { { ..printing, natives: printing.natives.push(helper) } }

pub fn field_hole(printing: Printing, name: Bytes) -> { printing: Printing, piece: Piece } = {
  let f = interned(printing.fields, name);
  { printing: { ..printing, fields: f.xs }, piece: Hole(FieldName(f.at)) }
}

pub fn interned(xs: List<Bytes>, x: Bytes) -> { xs: List<Bytes>, at: Int } =
  match range(0, xs.len()).fold(None, |accumulator: Option<Int>, i: Int|
      match accumulator {
        Some(_) -> accumulator,
        None -> if xs.at(i) == Some(x) { Some(i) } else { None },
      }) {
    Some(i) -> { xs: xs, at: i },
    None -> { xs: xs.push(x), at: xs.len() },
  }

pub fn word_slot(x: Bytes, at: Bytes) -> Bytes =
  Bytes::concat_all([b"ply_words(", x, b")[", at, b"]"])

pub fn operand(printing: Printing, args: List<Arg>, k: Int) -> Bytes =
  match args.at(k) { Some(a) -> arg_text(printing, a), None -> b"0" }

pub fn nth_or_zero(xs: List<Bytes>, k: Int) -> Bytes = match xs.at(k) { Some(x) -> x, None -> b"0" }

test "a value with one C word is named `x`, one with several is named `x_0`, `x_1` and so on, and an unknown index gives `0`" {
  let narrow = AsSum({ layout: { classes: [Pointer], cases: [] }, cases: [b"m.A", b"m.B"] });
  let wide = AsSum({ layout: { classes: [Pointer, Pointer], cases: [] }, cases: [b"m.A", b"m.B"] });
  let flat = AsFlattened([
    { name: b"d", representation: AsDecimal },
    { name: b"s", representation: wide },
  ]);
  let reps = [narrow, wide, flat, AsUnit, AsDecimal, AsInt];
  assert_eq(
    reps.map(|r: Representation| part_names(b"x", r).len()),
    reps.map(|r: Representation| c_values_of(r).len()),
  );
  assert_eq(part_names(b"x", narrow), [b"x"]);
  assert_eq(part_names(b"x", wide), [b"x_0", b"x_1"]);
  assert_eq(part_names(b"x", flat), [b"x_0", b"x_1", b"x_2"]);
  assert_eq(
    reps.map(|r: Representation|
      range(-1, c_values_of(r).len() + 1).map(|k: Int| part_named(b"x", r, k))),
    reps.map(|r: Representation| [b"0"].concat(part_names(b"x", r)).push(b"0")),
  );
  assert_eq(reps.map(zero), [b"0", b"0", b"(PlyDec){0, 0}", b"0", b"(PlyDec){0, 0}", b"0"])
}
