import compiler.syntax.parsing (span_between)
import compiler.check.types (NamedType, list_type, int_type)
import compiler.check.types (Type)
import compiler.check.known (none_constructor, some_constructor)
import compiler.emit.c (int_literal)
import compiler.emit.layout (PlainWords, RecordFields, InlineRecord, FieldLayout, Pointer,
                             sum_layout, record_layout, any_integer, raw_sum, words, header_bytes)
import compiler.emit.representations (known_layout)
import compiler.emit.typed_ir (placeholder_var, Representation, AsWord, AsFlattened, AsSum, AsUnit,
                               AsListView, Variable, Arg, VariableOperand, operand_representation,
                               representation_text, is_boxed)
import compiler.emit.pieces (Text, pieces_text)
import compiler.emit.print.text (nth_or_zero, Printing, InstructionContext, empty_printing, named,
                                 pad, pieces, line, arg_text, part_names, unsupported, slot)
import compiler.emit.print.value_printing (arg_parts, parts_to_word, word_to_parts, read_box_pieces,
                                           word_as, declared_as, values_as_words, write_inline)
import compiler.emit.lower.representation (c_values_of)
import compiler.emit.print.count_functions (call_text, calls, counts_any, releases_word)
import compiler.emit.print.ownership (released)
import compiler.emit.print.lists (list_rest)

pub fn representation_converted(
  p: InstructionContext,
  printing: Printing,
  into: Option<Variable>,
  k: { arg: Arg, to: Representation },
) -> Printing / {abort.raise} =
  match into {
    None ->
      unsupported(
        b"a conversion between types whose result is never used",
        Bytes::concat_all([
          representation_text(operand_representation(k.arg)),
          b" represented as ",
          representation_text(k.to),
        ]),
      ),
    Some(v) -> {
      let from = operand_representation(k.arg);
      let xs = arg_parts(printing, k.arg);
      if from == k.to { declared_as(p, printing, v, xs) } else {
        match k.to {
          AsWord -> if from == AsListView { list_of_view(p, printing, v, xs) } else {
            match inline_fields(printing, v.ty) {
              Some(fs) ->
                box_with_inline_fields(p, printing, v, values_as_words(xs, c_values_of(from)), fs),
              None -> word_form(p, printing, v, xs, from),
            }
          },
          AsUnit -> declared_as(p, printing, v, []),
          AsFlattened(_) -> unpacked(p, printing, v, from, k),
          AsSum(s) -> if !raw_sum(s.layout) { unpacked(p, printing, v, from, k) }
          else { scalar_borrowed(p, printing, v, from, k) },
          _ -> scalar_borrowed(p, printing, v, from, k),
        }
      }
    },
  }

fn word_form(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  xs: List<Bytes>,
  from: Representation,
) -> Printing = {
  let n = named(printing, v);
  let w = parts_to_word(n.printing, n.name, xs, from);
  if w.word == n.name { pieces(w.printing, [Text(pad(p.depth))].concat(w.prep).push(Text(b"\n"))) }
  else { line(w.printing, p.depth, Bytes::concat_all([b"Word ", n.name, b" = ", w.word, b";"])) }
}

fn inline_fields(printing: Printing, ty: Type) -> Option<List<FieldLayout>> =
  match known_layout(printing.constructors, ty) {
    Some(RecordFields(fs)) -> if fs.any(|f: FieldLayout|
        match f.layout { InlineRecord(_) -> true, _ -> false }) { Some(fs) }
    else { None },
    _ -> None,
  }

fn box_with_inline_fields(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  ws: List<Bytes>,
  fs: List<FieldLayout>,
) -> Printing / {abort.raise} = {
  let n = named(printing, v);
  let made = line(
    n.printing,
    p.depth,
    Bytes::concat_all([
      b"Word ",
      n.name,
      b" = ply_alloc(ctx, ",
      int_literal(header_bytes() + 8 * words(RecordFields(fs))),
      b");",
    ]),
  );
  fs.fold(
    { printing: made, at: 0 },
    |accumulator: { printing: Printing, at: Int }, f: FieldLayout|
      match f.layout {
        InlineRecord(r) -> {
          let moved = write_inline(
            accumulator.printing,
            slot(n.name, f.at),
            Bytes::concat_all([b"&", slot(n.name, f.at + 1)]),
            nth_or_zero(ws, accumulator.at),
            r,
          );
          { printing: line(moved.printing, p.depth, moved.text), at: accumulator.at + 1 }
        },
        other -> {
          let k = words(other);
          {
            printing: range(0, k).fold(accumulator.printing, |q: Printing, j: Int|
              line(
                q,
                p.depth,
                Bytes::concat_all([
                  slot(n.name, f.at + j),
                  b" = ",
                  nth_or_zero(ws, accumulator.at + j),
                  b";",
                ]),
              )),
            at: accumulator.at + k,
          }
        },
      },
  ).printing
}

fn scalar_borrowed(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  from: Representation,
  k: { arg: Arg, to: Representation },
) -> Printing / {abort.raise} =
  if from == AsWord { declared_as(p, printing, v, [word_as(arg_text(printing, k.arg), k.to)]) }
  else { mismatched(from, k.to) }

fn unpacked(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  from: Representation,
  k: { arg: Arg, to: Representation },
) -> Printing / {abort.raise} =
  if from != AsWord { mismatched(from, k.to) } else {
    let n = named(printing, v);
    let word = arg_text(printing, k.arg);
    let names = part_names(n.name, k.to);
    pieces(
      n.printing,
      [Text(pad(p.depth))].concat(if is_boxed(k.to) { read_box_pieces(word, k.to, names) }
      else { word_to_parts(word, k.to, names) }).push(
        Text(b"\n"),
      ),
    )
  }

fn list_of_view(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  xs: List<Bytes>,
) -> Printing / {abort.raise} = {
  let list = nth_or_zero(xs, 0);
  let from_at = nth_or_zero(xs, 1);
  let n = named(printing, v);
  let unpacked = line(
    n.printing,
    p.depth,
    Bytes::concat_all([b"Word ", n.name, b" = ", list, b";"]),
  );
  let cut = line(unpacked, p.depth, Bytes::concat_all([b"if (", from_at, b") {"]));
  let made = list_rest(cut, p.depth + 1, n.name, list, from_at, v.ty);
  let go = released(made, v.ty, AsWord, [list]);
  line(
    pieces(go.printing, [Text(pad(p.depth + 1))].concat(go.out).push(Text(b"\n"))),
    p.depth,
    b"}",
  )
}

fn mismatched(from: Representation, to: Representation) -> Printing / {abort.raise} =
  unsupported(
    b"cannot convert a value between these two types",
    Bytes::concat_all([representation_text(from), b" represented as ", representation_text(to)]),
  )

fn place() -> InstructionContext =
  {
    u: {
      symbol: b"f",
      base: 0,
      result: AsWord,
      site: None,
      arm: None,
      looping: None,
      handler_jump: None,
      group: None,
      unwinds: [],
      epilogue: b"",
    },
    at: span_between(0, 0),
    exit_statement: b"return 0;",
    depth: 0,
  }

fn point() -> Representation =
  AsFlattened([{ name: b"x", representation: AsWord }, { name: b"y", representation: AsWord }])

test "converting a record to a single word allocates a heap block filled with its words, and converting that word back to a record reads the block in place without copying" {
  let printing = { ..empty_printing(Map::new().insert(0, b"p0")), temps: 4 };
  let word_form = representation_converted(place(), printing, Some(placeholder_var(1, AsWord)), {
    arg: VariableOperand(placeholder_var(0, point())),
    to: AsWord,
  });
  let made = pieces_text(word_form.out);
  assert_eq(
    [b"ply_alloc(ctx, INT64_C(24))", b"[0] = p0_0;", b"[1] = p0_1;"].filter(|part: Bytes|
      made.index_of(part) == None),
    [],
  );
  let both = pieces_text(
    representation_converted(place(), word_form, Some(placeholder_var(2, point())), {
      arg: VariableOperand(placeholder_var(1, AsWord)),
      to: point(),
    }).out,
  );
  let opened_back = both.slice(made.len(), both.len());
  assert(
    opened_back.index_of(b"[0]") != None && opened_back.index_of(b"[1]") != None
      && !counts_any(opened_back)
      && opened_back.index_of(b"rt_") == None,
    Some(String::of_bytes_lossy(opened_back)),
  )
}

test "a sum of one word converts to and from a plain word unchanged, and a value of no words converts to the word 0" {
  let one = AsSum({
    layout: sum_layout([
      { args: record_layout([]), indirect: false },
      { args: record_layout([PlainWords([Pointer])]), indirect: false },
    ]),
    cases: [none_constructor(), some_constructor()],
  });
  let printing = empty_printing(Map::new().insert(0, b"p0"));
  let converted_text = |from: Representation, to: Representation|
    pieces_text(
      representation_converted(place(), printing, Some(placeholder_var(1, to)), {
        arg: VariableOperand(placeholder_var(0, from)),
        to: to,
      }).out,
    );
  assert_eq(
    [converted_text(one, AsWord), converted_text(AsWord, one)].map(|c: Bytes|
      c.ends_with(b" = p0;\n")),
    [true, true],
  );
  assert(converted_text(AsUnit, AsWord).ends_with(b" = 0;\n"), None);
  let tagged = AsSum({
    layout: sum_layout([
      { args: record_layout([]), indirect: false },
      { args: record_layout([PlainWords([any_integer()])]), indirect: false },
    ]),
    cases: [none_constructor(), some_constructor()],
  });
  let wide = converted_text(AsWord, tagged);
  assert(
    wide.index_of(b"ply_words(p0)[0]") != None && wide.index_of(b"ply_words(p0)[1]") != None
      && !counts_any(wide),
    Some(String::of_bytes_lossy(wide)),
  );
  let id = AsSum({
    layout: sum_layout([{ args: record_layout([PlainWords([any_integer()])]), indirect: false }]),
    cases: [b"Id"],
  });
  let read = converted_text(AsWord, id);
  assert(!counts_any(read), Some(String::of_bytes_lossy(read)))
}

test "converting a list view (a list plus a start offset) to a list generates inline code for the remaining items, with no `rt_list_rest_p` call, and releases the view's list word" {
  let printing = empty_printing(Map::new().insert(0, b"p0"));
  let listed = { ..placeholder_var(1, AsWord), ty: list_type(int_type()) };
  let text = pieces_text(
    representation_converted(place(), printing, Some(listed), {
      arg: VariableOperand(placeholder_var(0, AsListView)),
      to: AsWord,
    }).out,
  );
  assert(
    text.index_of(b"if (p0_1) {") != None && text.index_of(b"rt_list_rest_p") == None
      && releases_word(text, b"p0_0"),
    Some(String::of_bytes_lossy(text)),
  )
}
