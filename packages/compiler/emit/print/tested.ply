//! A `Case`'s and a `Match`'s framing printed around the blocks the printer's driver prints: the
//! tests, the labels an arm leaves to by `Miss`, and the failure where no arm matched.

import std.bytes (ascii_of_int)
import compiler.emit.c (int_lit)
import compiler.emit.tir (Rep, RNum, RSlice, RSum, Var, ANum, Test, TTag, TInt, TRange, TLength,
                          Failure, NoArm, NoLet, var_said)
import compiler.emit.pieces (Piece, Text)
import compiler.emit.lower.held (case_index)
import compiler.emit.layout (Laid, LWords, LSum, SumLaid, CaseLaid, CaseTest, CaseArgs, Always,
                             WordIs, WordOutside, LowBits, P, S, C, R, pointer_floor, nullary_step,
                             tag_bits, sum_laid, record_laid, raw, head_field, list_head)
import compiler.emit.print.text (Printing, Place, line, text, pad, pieces, name_of, arg_text, site,
                                 part_names, unprinted)

/// What opens a `Case` testing `on` against `t`: its arms are a chain of `if`s, its rest the last
/// `else`.
pub fn case_opened(p: Place, pr: Printing, on: Var, t: Test) -> Printing = text(pr, pad(p.depth))

/// What opens the arm taken where `on` is the `when`th of what `t` lists.
pub fn case_arm(p: Place, pr: Printing, on: Var, t: Test, when: Int) -> Printing / {abort.raise} =
  pieces(pr, [Text(b"if (")].concat(tested(pr, on, t, when)).push(Text(b") {\n")))

/// What closes an arm of a `Case`.
pub fn case_arm_closed(p: Place, pr: Printing) -> Printing =
  text(pr, pad(p.depth).concat(b"} else "))

/// What opens the block taken where no arm of the `Case` is.
pub fn case_rest(p: Place, pr: Printing, on: Var, t: Test) -> Printing = text(pr, b"{\n")

/// What closes a `Case`.
pub fn case_closed(p: Place, pr: Printing) -> Printing = line(pr, p.depth, b"}")

/// Whether `on` is the `when`th of what `t` lists, as C. A constructor is tested by its case's test
/// over the sum's words, as its layout lays them. A length's `when`
/// below `at_least` is a list of exactly that many items, and `at_least` itself one of at least as
/// many; a view's length is its list's past its offset.
fn tested(pr: Printing, on: Var, t: Test, when: Int) -> List<Piece> / {abort.raise} = {
  let x = name_of(pr, on);
  let parts = part_names(x, on.rep);
  let outside = |case: Bytes, of: Int|
    unprinted(
      case,
      Bytes::concat_all([
        b"place ",
        ascii_of_int(when),
        b" of ",
        ascii_of_int(of),
        b", testing ",
        var_said(on),
      ]),
    );
  match t {
    TTag(names) -> match names.at(when) {
      None -> outside(b"a constructor's place outside its sum", names.len()),
      Some(name) -> match on.rep {
        RSum(s) -> match case_index(on.rep, name) {
          Some(i) -> [Text(case_test(s.laid, parts, i))],
          None ->
            unprinted(
              b"a constructor its sum's cases do not hold",
              Bytes::concat_all([name, b", testing ", var_said(on)]),
            ),
        },
        _ -> unprinted(b"a constructor tested on no sum's words", var_said(on)),
      },
    },
    TInt(ns) -> match ns.at(when) {
      Some(n) -> [Text(Bytes::concat_all([b"(", x, b") == ", bound(pr, on.rep, n)]))],
      None -> outside(b"an integer's place outside its test", ns.len()),
    },
    TRange(r) ->
      [
        Text(
          Bytes::concat_all([
            b"(",
            x,
            b") >= ",
            bound(pr, on.rep, r.lo),
            b" && (",
            x,
            b") <= ",
            bound(pr, on.rep, r.hi),
          ]),
        ),
      ],
    TLength(l) ->
      [
        Text(
          Bytes::concat_all([
            if on.rep == RSlice {
              Bytes::concat_all([
                b"((int64_t)",
                head_field(list_head(), nth(parts, 0), b"len"),
                b" - ",
                nth(parts, 1),
                b")",
              ])
            } else { Bytes::concat_all([b"(int64_t)", head_field(list_head(), x, b"len")]) },
            if when < l.at_least { b" == " } else { b" >= " },
            int_lit(when),
          ]),
        ),
      ],
  }
}

fn nth(xs: List<Bytes>, k: Int) -> Bytes = match xs.at(k) { Some(x) -> x, None -> b"0" }

/// Whether a sum laid as `s`, whose words are the C values `ws`, holds case `i`, as C: its word
/// holding the value the case is, a niche's widest case's word holding none of the others' values as
/// that word's class tells, or a tagged pointer's low bits, past the eighth case its box's first word.
pub fn case_test(s: SumLaid, ws: List<Bytes>, i: Int) -> Bytes =
  match s.cases.at(i) {
    None -> b"0",
    Some(c) -> match c.test {
      Always -> b"1",
      WordIs(t) -> Bytes::concat_all([b"(", nth(ws, t.at), b") == ", int_lit(t.value)]),
      WordOutside(t) -> {
        let w = nth(ws, t.at);
        let floor = int_lit(pointer_floor());
        match s.classes.at(t.at) {
          Some(S(m)) -> {
            let held = m - t.values.len();
            if held == 0 { Bytes::concat_all([b"(uint64_t)(", w, b") >= ", floor]) } else {
              Bytes::concat_all([
                b"((uint64_t)(",
                w,
                b") >= ",
                floor,
                b" || (",
                w,
                b") < ",
                int_lit(nullary_step() * held),
                b")",
              ])
            }
          },
          Some(C(m)) -> {
            let held = m - t.values.len();
            if held == 0 { Bytes::concat_all([b"(((", w, b") & 7) == 2)"]) } else {
              Bytes::concat_all([
                b"(((",
                w,
                b") & 7) == 2 || (",
                w,
                b") < ",
                int_lit(nullary_step() * held),
                b")",
              ])
            }
          },
          Some(R(r)) ->
            Bytes::concat_all([
              b"((",
              w,
              b") >= ",
              int_lit(r.lo),
              b" && (",
              w,
              b") <= ",
              int_lit(r.hi - t.values.len()),
              b")",
            ]),
          _ -> b"0",
        }
      },
      LowBits(t) -> {
        let w = nth(ws, t.at);
        Bytes::concat_all([
          b"((uint64_t)(",
          w,
          b") >= ",
          int_lit(pointer_floor()),
          b" && ((",
          w,
          b") & 7) == ",
          int_lit(t.bits),
          match t.block_tag {
            None -> b")",
            Some(tag) ->
              Bytes::concat_all([
                b" && ply_words((",
                w,
                b") & ~(Word)7)[0] == ",
                int_lit(tag),
                b")",
              ]),
          },
        ])
      },
    },
  }

/// What a `switch` telling the case a sum laid as `s` holds switches on, its words the C values `ws`:
/// the word its cases' tests read, as it is, a case laid as a value of it labelled by that value
/// (`case_label`); where cases are pointer tags, the word below the pointer floor and past it its
/// tag bits, or past the eighth case the tag in its box's first word, each above the pointer floor so
/// no small value meets them.
pub fn case_switched(s: SumLaid, ws: List<Bytes>) -> Bytes =
  match s.cases.find(|c: CaseLaid| match c.test { Always -> false, _ -> true }) {
    None -> int_lit(0),
    Some(c) -> {
      let w = nth(ws, tested_word(c.test));
      if !s.cases.any(|k: CaseLaid| match k.test { LowBits(_) -> true, _ -> false }) {
        Bytes::concat_all([b"(int64_t)(", w, b")"])
      } else {
        let mask = ascii_of_int(tag_mask());
        let low = Bytes::concat_all([
          int_lit(pointer_floor()),
          b" + (int64_t)((",
          w,
          b") & ",
          mask,
          b")",
        ]);
        let boxed = s.cases.any(|k: CaseLaid|
          match k.test { LowBits(t) -> t.block_tag != None, _ -> false });
        Bytes::concat_all([
          b"((uint64_t)(",
          w,
          b") >= ",
          int_lit(pointer_floor()),
          b" ? ",
          if boxed {
            Bytes::concat_all([
              b"(((",
              w,
              b") & ",
              mask,
              b") == ",
              mask,
              b" ? ",
              int_lit(block_tags()),
              b" + (int64_t)ply_words((",
              w,
              b") & ~(Word)",
              mask,
              b")[0] : ",
              low,
              b")",
            ])
          } else { low },
          b" : (int64_t)(",
          w,
          b"))",
        ])
      }
    },
  }

/// The label of case `i` of a sum laid as `s` in a `switch` on `case_switched`: the value its test
/// holds the tested word to, else the cases no value tells, the one case a sum leaves untested.
pub fn case_label(s: SumLaid, i: Int) -> Bytes =
  match s.cases.at(i) {
    None -> b"default:",
    Some(c) -> match c.test {
      WordIs(t) -> Bytes::concat_all([b"case ", int_lit(t.value), b":"]),
      LowBits(t) -> match t.block_tag {
        None -> Bytes::concat_all([b"case ", int_lit(pointer_floor() + t.bits), b":"]),
        Some(tag) -> Bytes::concat_all([b"case ", int_lit(block_tags() + tag), b":"]),
      },
      _ -> b"default:",
    },
  }

/// The arms of a `switch` on the case of a sum laid as `s`, armed for the cases `armed` holds, that
/// run nothing for each other case a value labels: where one of `armed` is the `default:` case, every
/// unarmed case would otherwise run its arm.
pub fn unarmed(s: SumLaid, armed: List<Int>) -> Bytes = {
  let defaulted = |i: Int| case_label(s, i) == b"default:";
  if !armed.any(defaulted) { b"" } else {
    Bytes::concat_all(
      range(0, s.cases.len()).filter(|i: Int| !armed.contains(i) && !defaulted(i)).map(|i: Int|
        Bytes::concat_all([case_label(s, i), b" break; "])),
    )
  }
}

/// The word a case's test reads.
fn tested_word(t: CaseTest) -> Int =
  match t { WordIs(x) -> x.at, WordOutside(x) -> x.at, LowBits(x) -> x.at, Always -> 0 }

fn tag_mask() -> Int = (1 << tag_bits()) - 1

/// Where `case_switched` numbers the cases boxed behind the last pointer tag, by the tag in the box:
/// past every tag a pointer's low bits give.
fn block_tags() -> Int = pointer_floor() + tag_mask() + 1

/// The integer `n` as C writes one of a value held as `r`.
fn bound(pr: Printing, r: Rep, n: Int) -> Bytes =
  match r { RNum(w) -> arg_text(pr, ANum({ width: w, bits: n })), _ -> int_lit(n) }

/// What opens a `Match` of `arms` arms, numbered `label`.
pub fn match_opened(p: Place, pr: Printing, label: Int, arms: Int) -> Printing = pr

/// What opens arm `i` of `Match` `label`: where the arm before it leaves to by `Miss`.
pub fn match_arm(p: Place, pr: Printing, label: Int, i: Int) -> Printing =
  if i == 0 { pr } else { line(pr, p.depth, Bytes::concat_all([arm_label(label, i), b": ;"])) }

/// What closes arm `i` of `Match` `label` where control reaches its end: past the other arms.
pub fn match_arm_closed(p: Place, pr: Printing, label: Int, i: Int) -> Printing =
  line(pr, p.depth, Bytes::concat_all([b"goto ", end_label(label), b";"]))

/// What opens the block a `Match` runs where every arm missed.
pub fn match_rest(p: Place, pr: Printing, label: Int, arms: Int) -> Printing =
  line(pr, p.depth, Bytes::concat_all([arm_label(label, arms), b": ;"]))

/// What closes a `Match`.
pub fn match_closed(p: Place, pr: Printing, label: Int) -> Printing =
  line(pr, p.depth, Bytes::concat_all([end_label(label), b": ;"]))

/// Arm `i` of `Match` `label` missing: on to the next arm.
pub fn missed(p: Place, pr: Printing, label: Int, i: Int) -> Printing =
  line(pr, p.depth, Bytes::concat_all([b"goto ", arm_label(label, i + 1), b";"]))

/// The run failing as `why` says, its site `p.at` stored first, then leaving: a `let`'s pattern
/// that did not hold its value raises, and a `match` no arm of which matched fails the run.
pub fn failed(p: Place, pr: Printing, why: Failure) -> Printing =
  line(
    site(p, pr),
    p.depth,
    Bytes::concat_all([
      match why { NoLet -> b"rt_let_no_match_p(ctx); ", NoArm -> b"rt_no_match_p(ctx); " },
      p.leave,
    ]),
  )

fn arm_label(label: Int, i: Int) -> Bytes =
  Bytes::concat_all([b"ply_m", ascii_of_int(label), b"_", ascii_of_int(i)])

fn end_label(label: Int) -> Bytes = Bytes::concat_all([b"ply_m", ascii_of_int(label), b"_end"])

fn case_of(args: List<Laid>) -> CaseArgs = { args: record_laid(args), indirect: false }

fn maybe_of(l: Laid) -> SumLaid = sum_laid([case_of([]), case_of([l])])

test "a sum's case is told by its word's value, a niche word's class, or a pointer's low bits" {
  let x = [b"x"];
  let pointer = LWords([P]);
  let reads = |told: Bytes, parts: List<Bytes>| parts.all(|p: Bytes| told.index_of(p) != None);
  // A niche's nullary case is its value; its widest case a pointer, past the floor.
  assert(case_test(maybe_of(pointer), x, 0).index_of(b"== INT64_C(0)") != None, None);
  let some = case_test(maybe_of(pointer), x, 1);
  assert(reads(some, [b"INT64_C(4096)"]) && some.index_of(b"==") == None, None);
  // A niche over a sum's word: a pointer, or a small value the inner sum holds.
  assert(
    reads(case_test(maybe_of(LSum(maybe_of(pointer))), x, 1), [b"INT64_C(4096)", b"INT64_C(8)"]),
    None,
  );
  // Over a range of values: the values left past the niche's.
  assert(
    reads(case_test(maybe_of(LWords([R({ lo: 0, hi: 1 })])), x, 1), [b"INT64_C(0)", b"INT64_C(1)"]),
    None,
  );
  // Over a character: its tag.
  assert(reads(case_test(maybe_of(LWords([C(0)])), x, 1), [b"& 7) == 2"]), None);
  // Pointer tags: the low bits, and past the eighth case the tag in the box's first word.
  let tags = sum_laid(range(0, 9).map(|_: Int| { args: record_laid([pointer]), indirect: true }));
  assert(reads(case_test(tags, x, 1), [b"INT64_C(4096)", b"& 7) == INT64_C(1)"]), None);
  assert(
    reads(case_test(tags, x, 8), [b"& 7) == INT64_C(7)", b"ply_words(", b"== INT64_C(8)"]),
    None,
  );
  // A tag word's case is its first word, whatever the payload words are named.
  let tagged = case_test(maybe_of(LWords([raw()])), [b"t_0", b"t_1", b"t_2"], 1);
  assert(reads(tagged, [b"t_0", b"INT64_C(1)"]) && tagged.index_of(b"t_1") == None, None);
  assert_eq(case_test(sum_laid([case_of([pointer])]), x, 0), b"1")
}

test "a switch over a sum's case switches on its tested word, each case labelled by its value or tag" {
  let x = [b"x"];
  let pointer = LWords([P]);
  let labels = |s: SumLaid| range(0, s.cases.len()).map(|i: Int| case_label(s, i));
  // An enum's word is its case.
  let ordering = sum_laid([case_of([]), case_of([]), case_of([])]);
  assert_eq(case_switched(ordering, x), b"(int64_t)(x)");
  assert_eq(labels(ordering), [b"case INT64_C(0):", b"case INT64_C(1):", b"case INT64_C(2):"]);
  // A tag word's case is its first word, whatever the payload words are named.
  assert_eq(case_switched(maybe_of(LWords([raw()])), [b"t_0", b"t_1"]), b"(int64_t)(t_0)");
  // A niche's values label the cases that take them, its widest case all the others.
  assert_eq(case_switched(maybe_of(pointer), x), b"(int64_t)(x)");
  assert_eq(labels(maybe_of(pointer)), [b"case INT64_C(0):", b"default:"]);
  // Where the widest case has an arm, every other case has one, so none runs the widest case's.
  assert_eq(unarmed(maybe_of(pointer), [1]), b"case INT64_C(0): break; ");
  assert_eq(unarmed(maybe_of(pointer), [0]), b"");
  // Pointer tags: the word's small values, then its tag bits past the floor, then the tag a box
  // past the last pointer tag holds; one fixed expression, however many cases.
  let tags = sum_laid(
    [case_of([])].concat(
      range(0, 9).map(|_: Int| { args: record_laid([pointer]), indirect: true }),
    ),
  );
  let subject = case_switched(tags, x);
  assert(
    [b"INT64_C(4096)", b"INT64_C(4104)", b"ply_words("].all(|p: Bytes| subject.index_of(p) != None)
      && subject.split(b" ? ").len() == 3,
    Some(String::of_bytes_lossy(subject)),
  );
  assert_eq(labels(tags).take(3), [
    b"case INT64_C(0):",
    b"case INT64_C(4096):",
    b"case INT64_C(4097):",
  ]);
  assert_eq(labels(tags).drop(8), [b"case INT64_C(4112):", b"case INT64_C(4113):"]);
  // No case is told twice, so the labels make one switch.
  [ordering, maybe_of(pointer), tags].fold((), |_: Unit, s: SumLaid|
    assert_eq(
      labels(s).len(),
      labels(s).fold([], |seen: List<Bytes>, l: Bytes|
        if seen.contains(l) { seen } else { seen.push(l) }).len(
      ),
    ));
  // One case is the case, untested.
  let one = sum_laid([case_of([pointer])]);
  assert_eq([case_switched(one, x)].concat(labels(one)), [b"INT64_C(0)", b"default:"])
}
