import std.bytes (ascii_of_int)
import compiler.emit.layout (head_field, head_words, text_block_bytes, text_head)

const hidden: Bytes = b"__attribute__((visibility(\"hidden\"))) "

const scalar_signature: Bytes =
  b"Word ply_scalar_encoded(PlyCtx *ctx, Word kind, Word t, Word lo, Word hi)"

const text_signature: Bytes = b"Word ply_text_encoded(PlyCtx *ctx, Word is_text, Word at, Word n)"

fn declared(signature: Bytes) -> Bytes = Bytes::concat_all([hidden, signature, b";\n"])

pub const encoders_declared: Bytes = declared(scalar_signature).concat(declared(text_signature))

fn payload(block: Bytes) -> Bytes =
  Bytes::concat_all([
    b"((unsigned char *)&ply_words(",
    block,
    b")[",
    ascii_of_int(head_words(text_head)),
    b"])",
  ])

pub const encoders_defined: Bytes =
  Bytes::concat_all([
    b"static Word ply_bytes_block(PlyCtx *ctx, int64_t n) {\n",
    b"  Word o = ply_alloc(ctx, ",
    text_block_bytes(b"n"),
    b");\n  ",
    head_field(text_head, b"o", b"len"),
    b" = (uint32_t)n;\n  ",
    head_field(text_head, b"o", b"room"),
    b" = (uint32_t)n;\n",
    b"  return o;\n",
    b"}\n",
    b"static void ply_little_endian(unsigned char *to, uint64_t value, int bytes) {\n",
    b"  for (int i = 0; i < bytes; i++) to[i] = (unsigned char)(value >> (8 * i));\n",
    b"}\n",
    b"static PlyDec ply_dec_normalized(PlyDec d) {\n",
    b"  PlyBig b = ply_dec_big(d);\n",
    b"  if (ply_big_zero(b.w)) return ply_dec_zero();\n",
    b"  while (b.scale > 0) {\n",
    b"    PlyBig next = b;\n",
    b"    if (ply_big_div_small(next.w, 10) != 0) break;\n",
    b"    b = next;\n",
    b"    b.scale -= 1;\n",
    b"  }\n",
    b"  return ply_dec_packed(b.w, b.scale, b.neg);\n",
    b"}\n",
    scalar_signature,
    b" {\n",
    b"  unsigned char out[18];\n",
    b"  int64_t n = 1;\n",
    b"  if (kind == 0) out[0] = 0;\n",
    b"  else if (kind == 1) out[0] = lo ? 2 : 1;\n",
    b"  else if (kind == 2) {\n",
    b"    out[0] = 3;\n",
    b"    ply_little_endian(out + 1, (uint64_t)lo, 8);\n",
    b"    n = 9;\n",
    b"  } else if (kind == 3) {\n",
    b"    out[0] = 4;\n",
    b"    out[1] = (unsigned char)t;\n",
    b"    ply_little_endian(out + 2, (uint64_t)lo, 8);\n",
    b"    ply_little_endian(out + 10, (uint64_t)hi, 8);\n",
    b"    n = 18;\n",
    b"  } else if (kind == 4) {\n",
    b"    out[0] = 5;\n",
    b"    ply_little_endian(out + 1, (uint64_t)lo, 4);\n",
    b"    n = 5;\n",
    b"  } else {\n",
    b"    PlyDec d;\n",
    b"    d.lo = lo;\n",
    b"    d.hi = hi;\n",
    b"    d = ply_dec_normalized(d);\n",
    b"    out[0] = 6;\n",
    b"    ply_little_endian(out + 1, (uint64_t)d.lo, 8);\n",
    b"    ply_little_endian(out + 9, (uint64_t)d.hi, 8);\n",
    b"    n = 17;\n",
    b"  }\n",
    b"  Word o = ply_bytes_block(ctx, n);\n  memcpy(",
    payload(b"o"),
    b", out, (size_t)n);\n",
    b"  return o;\n",
    b"}\n",
    text_signature,
    b" {\n",
    b"  Word o = ply_bytes_block(ctx, 9 + n);\n",
    b"  unsigned char *to = ",
    payload(b"o"),
    b";\n",
    b"  to[0] = is_text ? 7 : 8;\n",
    b"  ply_little_endian(to + 1, (uint64_t)n, 8);\n",
    b"  if (n > 0) memcpy(to + 9, (const void *)(intptr_t)at, (size_t)n);\n",
    b"  return o;\n",
    b"}\n",
  ])
