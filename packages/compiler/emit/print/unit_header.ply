import std.bytes (ascii_of_int)
import compiler.emit.layout (MachineStruct, MachineField, head_structs, text_head, pointer_floor,
                             tag_bits, header_bytes, frame_count)
import compiler.emit.abi
import compiler.emit.abi (Native, Machine, natives, machine_structs, object_struct, context_struct,
                          release_depth, failed_target, failed_pending, evidence_one_slot,
                          evidence_shared, heap_instance_layout, unwinding_words)
import compiler.emit.typed_ir.handling (raise_offset, task_offset)
import compiler.emit.roots (builtin_helper)
import compiler.cc (runtime_part_mark)
import compiler.emit.print.frames (chain_defined)
import compiler.emit.print.count_functions (dup_fn, last_fn, dup_marked_fn, last_marked_fn,
                                            release_fn, release_sum_fn, release_box_fn, free_fn,
                                            increment_shared_fn, dec_shared_last_fn,
                                            runtime_free_fn, alloc_fn, alloc_block_fn,
                                            release_later_fn, drain_releases_fn, released_twice_fn,
                                            sized_box_release_fn, never_lifted_fn,
                                            never_lifted_runtime_fn, never_shown_fn,
                                            never_shown_rt_fn, call_text, calls)
import compiler.emit.release (uncounted_functions, box_functions, scalar_box_words)
import compiler.emit.print.probe (probed_helper, probed_fn)
import compiler.emit.print.lists (list_helpers, writable_list_fn, opened_list_fn)
import compiler.emit.print.ownership (walk_helpers, persistent_copy_fn, fresh_block_fn, unshared_fn,
                                      mark_shared_fn, kept_list_fn, fresh_list_fn)
import compiler.emit.print.wide (wide_helpers)
import compiler.emit.print.decimal (decimal_helpers)
import compiler.emit.print.failures (failures_declared, failures_defined)
import compiler.emit.print.encoded (encoders_declared, encoders_defined)
import compiler.emit.print.constants (constant_helpers, constant_made)

pub fn unit_header() -> Bytes / {abort.raise} =
  Bytes::concat_all([
    prelude(),
    b"\n",
    Bytes::concat_all(bound_functions().map(pointer_declared)),
    b"\n",
    header_part(),
  ])

pub fn unit_tail(natives: List<Native>) -> Bytes / {abort.raise} = {
  let all = bound_functions().concat(natives);
  Bytes::concat_all([
    runtime_part_mark(),
    b"\n",
    Bytes::concat_all(all.map(|n: Native| pointer(n).concat(b";\n"))),
    b"\nvoid ply_bind(void **fns) {\n",
    Bytes::concat_all(
      range(0, all.len()).map(|i: Int| {
        let n = all.get(i);
        Bytes::concat_all([
          b"  ",
          n.name,
          b"_p = (",
          return_c_type(n),
          b" (*)(",
          parameter_c_types(n),
          b"))fns[",
          ascii_of_int(i),
          b"];\n",
        ])
      }),
    ),
    b"}\n",
    constant_made(),
    tail_part(),
  ])
}

pub fn bound_functions() -> List<Native> / {abort.raise} =
  abi::helpers().concat(natives().map(|n: Native| { ..n, name: builtin_helper(n.name) }))

fn return_c_type(n: Native) -> Bytes = if n.result == None { b"void" } else { b"Word" }

fn parameter_c_types(n: Native) -> Bytes =
  b"PlyCtx*".concat(Bytes::concat_all(n.params.map(|_: Machine| b", Word")))

fn pointer(n: Native) -> Bytes =
  Bytes::concat_all([return_c_type(n), b" (*", n.name, b"_p)(", parameter_c_types(n), b")"])

pub fn pointer_declared(n: Native) -> Bytes = Bytes::concat_all([b"extern ", pointer(n), b";\n"])

fn prelude() -> Bytes =
  Bytes::concat_all([
    b"#include <stdint.h>\n",
    b"#include <string.h>\n",
    b"\n",
    b"typedef int64_t Word;\n",
    declared(object_struct()),
    b"#define PLY_HEADER ",
    ascii_of_int(header_bytes()),
    b"\n#define PLY_RC_FRAME UINT32_C(",
    ascii_of_int(frame_count()),
    b")\n#define PLY_UNWINDING_WORDS ",
    ascii_of_int(unwinding_words()),
    b"\n",
    declared(context_struct()),
    b"#define PLY_SITE(ctx, r, s, e) ((ctx)->site_root = (r), (ctx)->site_start = (s), (ctx)->site_end = (e))\n",
    b"#define ply_words(w) ((Word *)((char *)(intptr_t)(w) + PLY_HEADER))\n",
    b"#define ply_obj(w) ((PlyObj *)(intptr_t)(w))\n",
    b"static inline uint32_t ply_le32(uint32_t v) {\n",
    b"#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__\n",
    b"  return __builtin_bswap32(v);\n",
    b"#else\n",
    b"  return v;\n",
    b"#endif\n",
    b"}\n",
    b"#if defined(__has_builtin) && !defined(PLY_NO_OV_BUILTIN)\n",
    b"#  if __has_builtin(__builtin_add_overflow)\n",
    b"#    define PLY_OV_BUILTIN 1\n",
    b"#  endif\n",
    b"#endif\n",
    b"#ifdef PLY_OV_BUILTIN\n",
    b"static inline int ply_add_ov(int64_t a, int64_t b, int64_t *r) { return __builtin_add_overflow(a, b, r); }\n",
    b"static inline int ply_sub_ov(int64_t a, int64_t b, int64_t *r) { return __builtin_sub_overflow(a, b, r); }\n",
    b"static inline int ply_mul_ov(int64_t a, int64_t b, int64_t *r) { return __builtin_mul_overflow(a, b, r); }\n",
    b"#else\n",
    b"#define ply_add_ov(a, b, r) ({ uint64_t ply_a_ = (uint64_t)(a), ply_b_ = (uint64_t)(b), ply_s_ = ply_a_ + ply_b_; *(r) = (int64_t)ply_s_; (int)(((ply_a_ ^ ply_s_) & (ply_b_ ^ ply_s_)) >> 63); })\n",
    b"#define ply_sub_ov(a, b, r) ({ uint64_t ply_a_ = (uint64_t)(a), ply_b_ = (uint64_t)(b), ply_s_ = ply_a_ - ply_b_; *(r) = (int64_t)ply_s_; (int)(((ply_a_ ^ ply_b_) & (ply_a_ ^ ply_s_)) >> 63); })\n",
    b"static inline int ply_mul_ov(int64_t a, int64_t b, int64_t *r) {\n",
    b"  uint64_t x = a < 0 ? 0 - (uint64_t)a : (uint64_t)a;\n",
    b"  uint64_t y = b < 0 ? 0 - (uint64_t)b : (uint64_t)b;\n",
    b"  uint64_t m = x * y;\n",
    b"  *r = (int64_t)((uint64_t)a * (uint64_t)b);\n",
    b"  if (x != 0 && m / x != y) return 1;\n",
    b"  return m > (uint64_t)INT64_MAX + ((a < 0) != (b < 0));\n",
    b"}\n",
    b"#endif\n",
    b"#if defined(__TINYC__) || !defined(__GNUC__)\n",
    b"#  define ply_observed(x) ((void)(x))\n",
    b"#  define ply_observed_pair(x) ((void)(x))\n",
    b"#elif defined(__clang__)\n",
    b"#  define ply_observed(x) __asm__ __volatile__(\"\" : \"+r,m\"(x) : : \"memory\")\n",
    b"#  define ply_observed_pair(x) __asm__ __volatile__(\"\" : \"+m\"(x) : : \"memory\")\n",
    b"#else\n",
    b"#  define ply_observed(x) __asm__ __volatile__(\"\" : \"+m,r\"(x) : : \"memory\")\n",
    b"#  define ply_observed_pair(x) __asm__ __volatile__(\"\" : \"+m\"(x) : : \"memory\")\n",
    b"#endif\n",
    b"double sqrt(double);\n",
    b"double floor(double);\n",
    b"double ceil(double);\n",
    b"double fmod(double, double);\n",
    b"static inline double ply_f64(int64_t bits) { union { int64_t i; double d; } u; u.i = bits; return u.d; }\n",
    b"static inline int64_t ply_f64_bits(double d) { union { int64_t i; double d; } u; u.d = d; return u.i; }\n",
    b"typedef struct { Word lo, hi; } PlyDec;\n",
    b"static inline PlyDec ply_dec_of(Word w) { PlyDec d; d.lo = ply_words(w)[0]; d.hi = ply_words(w)[1]; return d; }\n",
    b"typedef struct { Word lo, hi; } PlyWide;\n",
    b"static inline PlyWide ply_wide_of(Word w) { PlyWide x; x.lo = ply_words(w)[0]; x.hi = ply_words(w)[1]; return x; }\n",
    b"static inline int64_t ply_wide_order(PlyWide a, PlyWide b, int s) {\n",
    b"  if (a.hi != b.hi) return (s ? (int64_t)a.hi < (int64_t)b.hi : (uint64_t)a.hi < (uint64_t)b.hi) ? -1 : 1;\n",
    b"  return ((uint64_t)a.lo > (uint64_t)b.lo) - ((uint64_t)a.lo < (uint64_t)b.lo);\n",
    b"}\n",
    b"static inline Word ply_imm(int64_t v) { return (Word)(((uint64_t)v << 1) | 1); }\n",
    b"static inline int64_t ply_imm_value(Word w) { return w >> 1; }\n",
  ])

fn header_part() -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\n",
    structs(),
    failures_declared(),
    encoders_declared(),
    helpers(),
    wide_helpers(),
    decimal_helpers(),
    b"\n",
    b"typedef struct { PlyObj h; const PlyFnDesc *desc; } PlyFnBlock;\n",
    words_mapped(),
    entries_defined(),
    byte_texts_declared(),
    chain_defined(),
    drop_helpers(),
    shared_sequences(),
    constant_helpers(),
  ])

fn entries_defined() -> Bytes =
  Bytes::concat_all([
    b"#define PLY_FAILED_TARGET ",
    ascii_of_int(failed_target()),
    b"\n#define PLY_FAILED_PENDING ",
    ascii_of_int(failed_pending()),
    b"\n#define PLY_EVIDENCE_ONE_SLOT ",
    ascii_of_int(evidence_one_slot()),
    b"\n#define PLY_EVIDENCE_SHARED ",
    ascii_of_int(evidence_shared()),
    b"\n",
    b"typedef Word (*PlyEntry)(PlyCtx *, Word, Word, Word, Word, Word);\n",
    b"static inline Word ply_evidence_flags(Word w) { return *(const Word *)(intptr_t)w; }\n",
    b"static inline const Word *ply_slot(Word w, int64_t k) {\n",
    b"  const Word *o = (const Word *)(intptr_t)w;\n",
    b"  return o + 1 + 2 * (o[0] & PLY_EVIDENCE_ONE_SLOT ? 0 : k);\n",
    b"}\n",
    b"static inline Word ply_perform(PlyCtx *ctx, Word w, int64_t k, Word op, Word mode, Word res, Word args) {\n",
    b"  const Word *s = ply_slot(w, k);\n",
    b"  return ((PlyEntry)(intptr_t)s[0])(ctx, s[1], op, mode, res, args);\n",
    b"}\n",
    b"static void ply_held_let_go(PlyCtx *ctx, Word *in) {\n",
    b"  Word held = in[0];\n",
    b"  in[0] = 0;\n",
    b"  if (held == -1) ((const PlyType *)(intptr_t)in[2])->dec(ctx, in[1]);\n",
    b"  else if (held > 0) {\n",
    b"    const PlyOp *o = (const PlyOp *)(intptr_t)in[1];\n",
    b"    for (int64_t i = 0; i < o->params_len; i++) o->params[i]->dec(ctx, in[",
    ascii_of_int(raise_offset()),
    b" + i]);\n",
    b"  }\n",
    b"}\n",
    b"static inline Word ply_uniform(PlyCtx *ctx, Word f, const Word *args) {\n",
    b"  return ((const PlyFnDesc *)(intptr_t)ply_words(f)[0])->uniform(ctx, f, args);\n",
    b"}\n",
    b"static inline void ply_performed_here(PlyCtx *ctx) {\n",
    b"  ctx->performed_root = ctx->site_root; ctx->performed_start = ctx->site_start;\n",
    b"  ctx->performed_end = ctx->site_end;\n",
    b"}\n",
    b"static Word ply_answers(PlyCtx *ctx, Word env, Word op, Word mode, Word res, Word args) {\n",
    b"  const Word *e = (const Word *)(intptr_t)env;\n",
    b"  ply_performed_here(ctx);\n",
    b"  if (ctx->recording) rt_performed_p(ctx, op, res, mode);\n",
    b"  return ply_uniform(ctx, e[0], (const Word *)(intptr_t)args);\n",
    b"}\n",
    b"static Word ply_schedules(PlyCtx *ctx, Word env, Word op, Word mode, Word res, Word args) {\n",
    b"  Word was = rt_scheduler_entered_p(ctx);\n",
    b"  Word r = ply_answers(ctx, env, op, mode, res, args);\n",
    b"  rt_scheduler_left_p(ctx, was);\n",
    b"  return r;\n",
    b"}\n",
    b"static Word ply_answers_labelled(PlyCtx *ctx, Word env, Word op, Word mode, Word res, Word args) {\n",
    b"  const Word *e = (const Word *)(intptr_t)env;\n",
    b"  Word *a = (Word *)(intptr_t)args;\n",
    b"  ply_performed_here(ctx);\n",
    b"  if (ctx->recording) rt_performed_p(ctx, op, res, mode);\n",
    b"  a[((const PlyOp *)(intptr_t)op)->params_len] = rt_label_string_p(ctx, res, e[3]);\n",
    b"  if (ctx->failed) return 0;\n",
    b"  return ply_uniform(ctx, e[0], a);\n",
    b"}\n",
    b"static Word ply_resumed(PlyCtx *ctx, Word self, const Word *args) {\n",
    b"  Word *k = ply_words(self);\n",
    b"  ctx->entering_desc = 0; ctx->entering_words = 0;\n",
    b"  k[1] = args[0]; k[2] = 1;\n",
    b"  return args[0];\n",
    b"}\n",
    b"static Word ply_resumed_kept(PlyCtx *ctx, Word self) { (void)ctx; (void)self; return 0; }\n",
    b"static const PlyFnDesc ply_resumed_desc = { ply_resumed, 0, 0, ply_resumed_kept, ply_resumed_kept, ply_resumed_kept };\n",
    b"static Word ply_answer_abandoned(PlyCtx *ctx, Word op, const Word *in, Word r) {\n",
    b"  ((const PlyType *)(intptr_t)in[2])->dec(ctx, r);\n",
    b"  return rt_task_abandons_p(ctx, op);\n",
    b"}\n",
    b"static Word ply_capture_refused(PlyCtx *ctx, Word op, const Word *a) {\n",
    b"  const PlyOp *o = (const PlyOp *)(intptr_t)op;\n",
    b"  for (int64_t i = 0; i < o->params_len; i++) o->params[i]->dec(ctx, a[i]);\n",
    b"  return rt_task_captures_p(ctx, op);\n",
    b"}\n",
    b"static inline Word ply_resuming(PlyCtx *ctx, Word op, const Word *e, Word *a, int64_t at) {\n",
    b"  Word k[4] = { (Word)PLY_RC_FRAME, (Word)(intptr_t)&ply_resumed_desc, 0, 0 };\n",
    b"  a[at] = (Word)(intptr_t)k;\n",
    b"  Word r = ply_uniform(ctx, e[0], a);\n",
    b"  if (ctx->failed || k[3]) return ctx->failed ? 0 : r;\n",
    b"  Word *in = (Word *)(intptr_t)e[1];\n",
    b"  if (in[",
    ascii_of_int(task_offset()),
    b"] != ctx->task) return ply_answer_abandoned(ctx, op, in, r);\n",
    b"  if (in[0]) ply_held_let_go(ctx, in);\n",
    b"  in[0] = -1; in[1] = r;\n",
    b"  ctx->target = e[1]; ctx->failed = PLY_FAILED_TARGET;\n",
    b"  return 0;\n",
    b"}\n",
    b"static Word ply_resumes(PlyCtx *ctx, Word env, Word op, Word mode, Word res, Word args) {\n",
    b"  ply_performed_here(ctx);\n",
    b"  if (ctx->recording) rt_performed_p(ctx, op, res, mode);\n",
    b"  return ply_resuming(ctx, op, (const Word *)(intptr_t)env, (Word *)(intptr_t)args, ((const PlyOp *)(intptr_t)op)->params_len);\n",
    b"}\n",
    b"static Word ply_resumes_labelled(PlyCtx *ctx, Word env, Word op, Word mode, Word res, Word args) {\n",
    b"  const Word *e = (const Word *)(intptr_t)env;\n",
    b"  Word *a = (Word *)(intptr_t)args;\n",
    b"  int64_t n = ((const PlyOp *)(intptr_t)op)->params_len;\n",
    b"  ply_performed_here(ctx);\n",
    b"  if (ctx->recording) rt_performed_p(ctx, op, res, mode);\n",
    b"  a[n] = rt_label_string_p(ctx, res, e[3]);\n",
    b"  if (ctx->failed) return 0;\n",
    b"  return ply_resuming(ctx, op, e, a, n + 1);\n",
    b"}\n",
    b"static Word ply_raises(PlyCtx *ctx, Word env, Word op, Word mode, Word res, Word args) {\n",
    b"  const Word *e = (const Word *)(intptr_t)env;\n",
    b"  const Word *a = (const Word *)(intptr_t)args;\n",
    b"  Word *in = (Word *)(intptr_t)e[1];\n",
    b"  (void)mode; (void)res;\n",
    b"  if (in[",
    ascii_of_int(task_offset()),
    b"] != ctx->task) return rt_task_raises_p(ctx, op, args);\n",
    b"  if (in[0]) ply_held_let_go(ctx, in);\n",
    b"  in[0] = e[2]; in[1] = op;\n",
    b"  for (int64_t i = 0; i < ((const PlyOp *)(intptr_t)op)->params_len; i++) in[",
    ascii_of_int(raise_offset()),
    b" + i] = a[i];\n",
    b"  ctx->target = e[1]; ctx->failed = PLY_FAILED_TARGET;\n",
    b"  return 0;\n",
    b"}\n",
    b"static Word ply_stops(PlyCtx *ctx, Word env, Word op, Word mode, Word res, Word args) {\n",
    b"  const Word *e = (const Word *)(intptr_t)env;\n",
    b"  const Word *in = (const Word *)(intptr_t)e[1];\n",
    b"  if (in[",
    ascii_of_int(task_offset()),
    b"] != ctx->task) return ply_capture_refused(ctx, op, (const Word *)(intptr_t)args);\n",
    b"  ply_performed_here(ctx);\n",
    b"  if (ctx->recording) rt_performed_p(ctx, op, res, mode);\n",
    b"  return rt_detached_perform_p(ctx, env, op, res, args);\n",
    b"}\n",
    b"static Word ply_forwarded(PlyCtx *ctx, Word env, Word op, Word mode, Word res, Word args) {\n",
    b"  const Word *r = (const Word *)(intptr_t)env;\n",
    b"  const Word *s = ply_slot(*(const Word *)(intptr_t)r[0], r[1]);\n",
    b"  Word task = ctx->task;\n",
    b"  ctx->task = *(const Word *)(intptr_t)r[2];\n",
    b"  Word a = ((PlyEntry)(intptr_t)s[0])(ctx, s[1], op, mode, res, args);\n",
    b"  ctx->task = task;\n",
    b"  return a;\n",
    b"}\n",
    b"static Word ply_keyed(PlyCtx *ctx, Word env, Word op, Word mode, Word res, Word args) {\n",
    b"  const Word *t = (const Word *)(intptr_t)env;\n",
    b"  for (int64_t i = 0; i < t[0]; i++) {\n",
    b"    const Word *r = t + 1 + 3 * i;\n",
    b"    if (r[0] == res || r[0] == -2) return ((PlyEntry)(intptr_t)r[1])(ctx, r[2], op, mode, res, args);\n",
    b"  }\n",
    b"  return ply_perform(ctx, ctx->unserved, 0, op, mode, res, args);\n",
    b"}\n",
    b"static Word ply_instance_called(PlyCtx *ctx, Word self, const Word *args) { (void)ctx; (void)self; (void)args; return 0; }\n",
    b"static Word ply_instance_kept(PlyCtx *ctx, Word self) { (void)ctx; (void)self; return 0; }\n",
    b"static Word ply_instance_released(PlyCtx *ctx, Word self) {\n",
    b"  Word *w = ply_words(self);\n",
    b"  Word *in = w + ",
    ascii_of_int(heap_instance_layout().words),
    b";\n",
    b"  if (in[0]) ply_held_let_go(ctx, in);\n",
    b"  for (int64_t j = 0; j < w[",
    ascii_of_int(heap_instance_layout().vars + 1),
    b"]; j++) { const PlyType *t = (const PlyType *)(intptr_t)in[w[",
    ascii_of_int(heap_instance_layout().vars),
    b"] + 2 * j + 1]; if (t) t->dec(ctx, in[w[",
    ascii_of_int(heap_instance_layout().vars),
    b"] + 2 * j]); }\n",
    b"  for (int64_t j = 0; j < w[3]; j++) { Word f = in[w[2] + 4 * j]; if (f && ply_last(ctx, f)) ((const PlyFnDesc *)(intptr_t)ply_words(f)[0])->release(ctx, f); }\n",
    b"  ply_free(ctx, self, PLY_HEADER + 8 * (",
    ascii_of_int(heap_instance_layout().words),
    b" + w[1]));\n",
    b"  return 0;\n",
    b"}\n",
    b"static const PlyFnDesc ply_instance_desc = { ply_instance_called, 0, 0, ply_instance_released, ply_instance_kept, ply_instance_kept };\n",
    b"static void ply_instance_each(PlyCtx *ctx, Word *s, int64_t d) {\n",
    b"  (void)d;\n",
    b"  const Word *in = s + 2;\n",
    b"  for (int64_t i = 0; i < s[1]; i++) {\n",
    b"    const PlyType *t = (const PlyType *)(intptr_t)in[s[0] + 2 * i + 1];\n",
    b"    if (t) t->dec(ctx, in[s[0] + 2 * i]);\n",
    b"  }\n",
    b"}\n",
    b"static inline void ply_pending_raised(PlyCtx *ctx, Word w, int64_t k, Word op, Word string) {\n",
    b"  if (ctx->failed != PLY_FAILED_PENDING) return;\n",
    b"  Word e = ply_slot(w, k)[0];\n",
    b"  Word bridged = e == ply_slot(ctx->bridge, 0)[0] || e == ply_slot(ctx->unserved, 0)[0];\n",
    b"  Word m[2] = { rt_pending_raised_p(ctx, string, bridged), 0 };\n",
    b"  if (!ctx->failed) ply_perform(ctx, w, k, op, 2, -1, (Word)(intptr_t)m);\n",
    b"}\n",
  ])

fn words_mapped() -> Bytes =
  Bytes::concat_all([
    b"static inline Word ply_row_label(const Word *row, const Word *labels, int64_t i) {\n",
    b"  int64_t left = 0;\n",
    b"  for (int64_t j = 0; j < i; j++) if (row[2 + 2 * j] == -3) left++;\n",
    b"  return row[2 + 2 * i] == -3 ? labels[left] : row[2 + 2 * i];\n",
    b"}\n",
    b"static inline void ply_words_mapped(PlyCtx *ctx, const Word *own, const Word *labels, const Word *site, const Word *words, Word *out) {\n",
    b"  int64_t n = own[0], m = site ? site[0] : 0;\n",
    b"  for (int64_t i = 0; i < n; i++) {\n",
    b"    Word effect = own[1 + 2 * i], label = ply_row_label(own, labels, i);\n",
    b"    int64_t alike = 0;\n",
    b"    for (int64_t j = 0; j < i; j++) if (own[1 + 2 * j] == effect && ply_row_label(own, labels, j) == label) alike++;\n",
    b"    out[i] = ctx->bridge;\n",
    b"    for (int64_t j = 0; j < m; j++) {\n",
    b"      if (site[1 + 2 * j] != effect) continue;\n",
    b"      if (site[2 + 2 * j] != -2 && ply_row_label(site, words + m, j) != label) continue;\n",
    b"      if (alike-- == 0) { out[i] = words[j]; break; }\n",
    b"    }\n",
    b"  }\n",
    b"}\n",
  ])

pub fn byte_text_fn() -> Bytes = b"ply_byte_text"

fn byte_texts_declared() -> Bytes =
  Bytes::concat_all([
    b"typedef struct { PlyObj h; ",
    text_head().name,
    b" head; unsigned char b[8]; } PlyByteText;\n",
    b"extern const PlyByteText ply_byte_texts[256];\n",
    b"static inline Word ",
    byte_text_fn(),
    b"(PlyCtx *ctx, int64_t b) { (void)ctx; return (Word)(intptr_t)&ply_byte_texts[b]; }\n",
  ])

fn tail_part() -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"const PlyByteText ply_byte_texts[256] = {\n",
    Bytes::concat_all(
      range(0, 256).map(|b: Int|
        Bytes::concat_all([
          b"  { { .rc = UINT32_MAX }, { .len = 1, .room = 1 }, { ",
          ascii_of_int(b),
          b" } },\n",
        ])),
    ),
    b"};\n",
    failures_defined(),
    encoders_defined(),
  ])

fn shared_sequences() -> Bytes =
  Bytes::concat_all([probed_helper(), list_helpers(), walk_helpers()])

fn drop_helpers() -> Bytes = {
  let depth = b"ctx->release_depth";
  Bytes::concat_all([
    b"static inline int ply_drop_deep(PlyCtx *ctx, Word o, PlyDrop d) {\n",
    Bytes::concat_all([
      b"  if (",
      depth,
      b" >= ",
      ascii_of_int(release_depth()),
      b") { ",
      call_text(release_later_fn(), [b"ctx", b"o", b"(Word)(intptr_t)d"]),
      b"; return 1; }\n",
    ]),
    Bytes::concat_all([b"  ", depth, b" += 1;\n"]),
    b"  return 0;\n",
    b"}\n",
    b"static inline void ply_drop_done(PlyCtx *ctx) {\n",
    Bytes::concat_all([
      b"  if (--",
      depth,
      b" == 0 && ctx->release_waiting != 0) ",
      call_text(drain_releases_fn(), [b"ctx"]),
      b";\n",
    ]),
    b"}\n",
  ])
}

fn helpers() -> Bytes = {
  let floor = ascii_of_int(pointer_floor());
  let tags = ascii_of_int((1 << tag_bits()) - 1);
  Bytes::concat_all([
    b"#ifdef PLY_CHECKED\n",
    b"#  define ply_released_twice(ctx, o, rc) if (rc == 0) ",
    call_text(released_twice_fn(), [b"ctx", b"o"]),
    b";\n",
    b"#else\n",
    b"#  define ply_released_twice(ctx, o, rc)\n",
    b"#endif\n",
    b"static inline __attribute__((noinline)) void ",
    call_text(dup_marked_fn(), [b"Word o"]),
    b" { if (ply_obj(o)->rc < PLY_RC_FRAME) ",
    call_text(increment_shared_fn(), [b"0", b"o"]),
    b"; }\n",
    b"static inline __attribute__((noinline)) int ",
    call_text(last_marked_fn(), [b"PlyCtx *ctx", b"Word o"]),
    b" { return ply_obj(o)->rc < PLY_RC_FRAME && ",
    call_text(dec_shared_last_fn(), [b"ctx", b"o"]),
    b"; }\n",
    b"#define ",
    call_text(last_fn(), [b"ctx", b"o"]),
    b" ({ \\\n",
    b"  Word ply_last_o = (o); PlyObj *h = ply_obj(ply_last_o); uint32_t rc = h->rc; int ply_last_r = 0; \\\n",
    b"  if (rc >= UINT32_C(0x80000000)) ply_last_r = ",
    call_text(last_marked_fn(), [b"ctx", b"ply_last_o"]),
    b"; \\\n",
    b"  else if (rc > 1) h->rc = rc - 1; \\\n",
    b"  else { ply_released_twice(ctx, ply_last_o, rc) ply_last_r = 1; } \\\n",
    b"  ply_last_r; })\n",
    b"#define ",
    call_text(dup_fn(), [b"o"]),
    b" ({ \\\n",
    b"  Word ply_dup_o = (o); \\\n",
    b"  if (ply_dup_o) { \\\n",
    b"    PlyObj *h = ply_obj(ply_dup_o); uint32_t rc = h->rc; \\\n",
    b"    if (rc < UINT32_C(0x80000000)) h->rc = rc + 1; \\\n",
    b"    else ",
    call_text(dup_marked_fn(), [b"ply_dup_o"]),
    b"; \\\n",
    b"  } })\n",
    b"typedef Word (*PlyDrop)(PlyCtx *, Word);\n",
    b"#define ",
    call_text(release_fn(), [b"ctx", b"o", b"d"]),
    b" ({ Word ply_rel_o = (o); if (ply_rel_o && ",
    call_text(last_fn(), [b"ctx", b"ply_rel_o"]),
    b") (d)(ctx, ply_rel_o); })\n",
    b"static inline void ",
    call_text(release_sum_fn(), [b"PlyCtx *ctx", b"Word w", b"PlyDrop d"]),
    b" {\n",
    Bytes::concat_all([
      b"  if ((uint64_t)w >= ",
      floor,
      b" && ",
      call_text(last_fn(), [b"ctx", b"w & ~(Word)".concat(tags)]),
      b") d(ctx, w);\n",
    ]),
    b"}\n",
    allocation(),
    b"static inline void ",
    call_text(release_box_fn(), [b"PlyCtx *ctx", b"Word o", b"int64_t bytes"]),
    b" {\n",
    Bytes::concat_all([
      b"  if (o && ",
      call_text(last_fn(), [b"ctx", b"o"]),
      b") ",
      call_text(free_fn(), [b"ctx", b"o", b"bytes"]),
      b";\n",
    ]),
    b"}\n",
    descriptor_helpers(tags),
  ])
}

fn descriptor_helpers(tags: Bytes) -> Bytes = {
  let fn_of = |name: Bytes, body: Bytes|
    Bytes::concat_all([b"static inline Word ", name, b"(PlyCtx *ctx, Word w) { ", body, b" }\n"]);
  let immediate = uncounted_functions();
  let dup = call_text(dup_fn(), [b"w"]);
  Bytes::concat_all([
    fn_of(immediate.dup, b"(void)ctx; return w;"),
    fn_of(immediate.release, b"(void)ctx; (void)w; return 0;"),
    fn_of(box_functions(2).dup, Bytes::concat_all([b"(void)ctx; ", dup, b"; return w;"])),
    Bytes::concat_all(
      scalar_box_words().map(|n: Int|
        fn_of(
          box_functions(n).release,
          call_text(release_box_fn(), [b"ctx", b"w", ascii_of_int(header_bytes() + 8 * n)]).concat(
            b"; return 0;",
          ),
        )),
    ),
    Bytes::concat_all([
      b"static inline Word ",
      call_text(never_lifted_fn(), [b"PlyCtx *ctx"]),
      b" { ",
      call_text(never_lifted_runtime_fn(), [b"ctx"]),
      b"; return 0; }\n",
    ]),
    Bytes::concat_all([
      b"static inline Word ",
      call_text(never_shown_fn(), [b"PlyCtx *ctx", b"Word w"]),
      b" { (void)w; ",
      call_text(never_shown_rt_fn(), [b"ctx"]),
      b"; return 0; }\n",
    ]),
  ])
}

fn allocation() -> Bytes = {
  let laid = abi::alloc_layout();
  let link = ascii_of_int(laid.link_at);
  let small = Bytes::concat_all([
    b"size >= ",
    ascii_of_int(laid.link_at + 8),
    b" && size <= ",
    ascii_of_int(8 * laid.word_classes),
    b" && !a->slow",
  ]);
  let segment = ascii_of_int(laid.segment);
  Bytes::concat_all([
    b"static inline Word ",
    call_text(alloc_fn(), [b"PlyCtx *ctx", b"int64_t bytes"]),
    b" {\n",
    b"  int64_t size = (bytes + 7) & ~(int64_t)7;\n",
    b"  PlyAlloc *a = ctx->alloc;\n",
    b"  if (",
    small,
    b") {\n",
    b"    PlyFilling *f = a->blocks;\n",
    b"    PlyPage *p = f->pages[size >> 3];\n",
    b"    unsigned char *b = 0;\n",
    b"    if (p && p->free) { b = p->free; p->free = *(unsigned char **)(b + ",
    link,
    b"); }\n",
    b"    else if (p && (uint64_t)(p->end - p->fresh) >= p->block) { b = p->fresh; p->fresh = b + p->block; }\n",
    b"    if (b) {\n",
    b"      p->live += 1;\n",
    b"      ((PlyObj *)b)->rc = 1;\n",
    b"      ((PlyObj *)b)->made_by_scheduler = 0;\n",
    b"      return (Word)(intptr_t)b;\n",
    b"    }\n",
    b"  }\n",
    b"  return ",
    call_text(alloc_block_fn(), [b"ctx", b"bytes"]),
    b";\n",
    b"}\n",
    b"static inline void ",
    call_text(free_fn(), [b"PlyCtx *ctx", b"Word o", b"int64_t bytes"]),
    b" {\n",
    b"  int64_t size = (bytes + 7) & ~(int64_t)7;\n",
    b"  PlyAlloc *a = ctx->alloc;\n",
    b"  if (",
    small,
    b" && ply_obj(o)->rc == 1) {\n",
    b"    uintptr_t at = (uintptr_t)o;\n",
    Bytes::concat_all([
      b"    PlyPage *p = (PlyPage *)((at & ~(uintptr_t)(",
      segment,
      b" - 1)) + ",
      ascii_of_int(laid.pages_at),
      b") + (at & (",
      segment,
      b" - 1)) / ",
      ascii_of_int(laid.page),
      b";\n",
    ]),
    b"    if (p->owner == a->blocks->name && p->block == (uint32_t)size && p->listed && p->live > 1) {\n",
    b"      ply_obj(o)->rc = 0;\n",
    b"      *(unsigned char **)(at + ",
    link,
    b") = p->free;\n",
    b"      p->free = (unsigned char *)at;\n",
    b"      p->live -= 1;\n",
    b"      return;\n",
    b"    }\n",
    b"  }\n",
    b"  ",
    call_text(runtime_free_fn(), [b"ctx", b"o", b"bytes"]),
    b";\n",
    b"}\n",
    b"static inline Word ply_two_words(PlyCtx *ctx, Word lo, Word hi) {\n",
    b"  Word o = ",
    call_text(alloc_fn(), [b"ctx", b"PLY_HEADER + 16"]),
    b";\n",
    b"  ply_words(o)[0] = lo;\n",
    b"  ply_words(o)[1] = hi;\n",
    b"  return o;\n",
    b"}\n",
  ])
}

fn structs() -> Bytes = Bytes::concat_all(machine_structs().concat(head_structs()).map(declared))

fn declared(s: MachineStruct) -> Bytes = {
  let laid = s.fields.fold(
    { at: 0, text: b"" },
    |acc: { at: Int, text: Bytes }, f: MachineField|
      {
        at: f.offset + f.bytes,
        text: Bytes::concat_all([
          acc.text,
          if f.offset - acc.at >= 8 { reason(acc.at, f.offset) } else { b"" },
          b"  ",
          f.declaration,
          b";\n",
        ]),
      },
  );
  Bytes::concat_all([
    b"typedef struct ",
    s.name,
    b" {\n",
    laid.text,
    reason(laid.at, s.bytes),
    b"} ",
    s.name,
    b";\n",
    b"typedef char ply_sized_",
    s.name,
    b"[sizeof(",
    s.name,
    b") == ",
    ascii_of_int(s.bytes),
    b" ? 1 : -1];\n",
  ])
}

fn naturally_aligned(s: MachineStruct) -> Bool =
  s.fields.fold({ at: 0, layout: true }, |acc: { at: Int, layout: Bool }, f: MachineField|
    {
      at: f.offset + f.bytes,
      layout: acc.layout && f.offset >= acc.at && f.offset - acc.at < 8,
    }).layout

test "every struct the head declares is laid as its fields' alignment lays it, with no hole of its own" {
  assert_eq(
    machine_structs().concat(head_structs()).filter(|s: MachineStruct| !naturally_aligned(s)).map(
      |s: MachineStruct| s.name,
    ),
    [],
  );
  assert(structs().index_of(b"  char ply_gap_20[4];\n  Word (*inc)") == None, None)
}

fn reason(from: Int, to: Int) -> Bytes =
  if to <= from { b"" } else {
    Bytes::concat_all([
      b"  char ply_gap_",
      ascii_of_int(from),
      b"[",
      ascii_of_int(to - from),
      b"];\n",
    ])
  }

fn defined_in(h: Bytes, f: Bytes) -> Bytes / {abort.raise} =
  match h.index_of(Bytes::concat_all([b" ", f, b"("])) {
    Some(i) -> match h.index_of_from(b"}\n", i) { Some(j) -> h.slice(i, j), None -> b"" },
    None -> b"",
  }

test "a release takes the count, the last one dropping the block, and a checked build traps a count already 0" {
  let h = header_part();
  let checked = match h.index_of(b"#ifdef PLY_CHECKED") {
    Some(i) -> match h.index_of_from(b"#endif", i) { Some(j) -> h.slice(i, j), None -> b"" },
    None -> b"",
  };
  assert(checked.index_of(b"rc == 0") != None, None);
  assert_eq(checked.index_of(b"kind"), None);
  [release_fn(), release_sum_fn(), release_box_fn(), free_fn()].fold((), |_: Unit, f: Bytes|
    assert(defined_in(h, f).len() > 0, Some(String::of_bytes_lossy(f))));
  assert(defined_in(h, release_sum_fn()).index_of(ascii_of_int(pointer_floor())) != None, None);
  let boxed = defined_in(h, release_box_fn());
  assert(calls(boxed, last_fn()) && calls(boxed, free_fn()), Some(String::of_bytes_lossy(boxed)));
  let named = [uncounted_functions()].concat(scalar_box_words().map(box_functions)).fold(
    [],
    |acc: List<Bytes>, x: { dup: Bytes, release: Bytes }| acc.push(x.dup).push(x.release),
  );
  assert_eq(named.filter(|n: Bytes| defined_in(h, n).len() == 0), []);
  assert(calls(defined_in(h, sized_box_release_fn(2)), release_box_fn()), None)
}

test "a raise or a stop at an instance lets go of what an unwind it replaces left there, then writes" {
  let h = header_part();
  [b"ply_raises", b"ply_resuming"].fold((), |_: Unit, f: Bytes| {
    let body = defined_in(h, f);
    let first = match ((body.index_of(b"ply_held_let_go(ctx, in)"), body.index_of(b"in[0] = "))) {
      (Some(freed), Some(written)) -> freed < written,
      _ -> false,
    };
    assert(first, Some(String::of_bytes_lossy(body)))
  });
  let let_go = defined_in(h, b"ply_held_let_go");
  assert(
    [b"in[2])->dec(ctx, in[1])", b"o->params[i]->dec(ctx, in[", b"in[0] = 0;"].all(|part: Bytes|
      let_go.index_of(part) != None),
    Some(String::of_bytes_lossy(let_go)),
  )
}

test "a small block is taken from its class's page and given back to its page in place, and any other through the runtime" {
  let h = header_part();
  let body = |f: Bytes|
    match h.index_of(Bytes::concat_all([b" ", f, b"("])) {
      Some(i) -> match h.index_of_from(b"\n}\n", i) { Some(j) -> h.slice(i, j), None -> b"" },
      None -> b"",
    };
  let alloc = body(alloc_fn());
  let free = body(free_fn());
  assert(calls(alloc, alloc_block_fn()) && calls(free, runtime_free_fn()), None);
  assert(
    [b"f->pages[size >> 3]", b"made_by_scheduler = 0;", b"!a->slow"].all(|part: Bytes|
      alloc.index_of(part) != None),
    Some(String::of_bytes_lossy(alloc)),
  );
  assert(
    [b"p->owner == a->blocks->name", b"p->live > 1", b"p->listed", b"rc == 1"].all(|part: Bytes|
      free.index_of(part) != None),
    Some(String::of_bytes_lossy(free)),
  )
}

test "a descriptor lifts and lowers what the runtime never asks it to by the runtime's rejection" {
  assert(calls(defined_in(header_part(), never_lifted_fn()), never_lifted_runtime_fn()), None);
  assert(calls(defined_in(header_part(), never_shown_fn()), never_shown_rt_fn()), None)
}

test "a drop root nests to the release depth, then puts its block off; the outermost drains what was put off" {
  let h = header_part();
  let deep = defined_in(h, b"ply_drop_deep");
  let done = defined_in(h, b"ply_drop_done");
  assert(deep.index_of(b"ctx->release_depth") != None, None);
  assert(deep.index_of(ascii_of_int(release_depth())) != None, None);
  assert(calls(deep, release_later_fn()), None);
  assert(done.index_of(b"ctx->release_depth") != None, None);
  assert(done.index_of(b"ctx->release_waiting") != None, None);
  assert(calls(done, drain_releases_fn()), None)
}

test "the head declares the context and a block's header field by field, at their offsets" {
  let h = unit_header();
  [object_struct(), context_struct()].fold((), |_: Unit, s: MachineStruct| {
    let from = match h.index_of(Bytes::concat_all([b"typedef struct ", s.name, b" {"])) {
      Some(i) -> i,
      None -> panic(String::of_bytes_lossy(b"the head declares no ".concat(s.name))),
    };
    s.fields.fold(from, |last: Int, f: MachineField|
      match h.index_of_from(f.declaration, last) {
        Some(i) -> i,
        None ->
          panic(
            String::of_bytes_lossy(b"a field the head does not declare: ".concat(f.declaration)),
          ),
      });
    assert(
      h.index_of(Bytes::concat_all([b"sizeof(", s.name, b") == ", ascii_of_int(s.bytes)])) != None,
      None,
    )
  });
  assert(
    h.index_of(b"  uint32_t rc;\n  uint8_t made_by_scheduler;\n  char ply_gap_5[3];\n} PlyObj;")
      != None,
    None,
  )
}

test "the head declares a pointer to each function the unit binds once, and the tail defines it and binds it in the unit's order" {
  let h = unit_header();
  let t = unit_tail([]);
  let all = bound_functions();
  assert(all.len() == abi::helpers().len() + natives().len(), None);
  range(0, all.len()).fold((), |_: Unit, i: Int| {
    let n = all.get(i);
    let p = pointer(n);
    assert(
      h.split(Bytes::concat_all([b"extern ", p, b";\n"])).len() == 2,
      Some(String::of_bytes_lossy(p)),
    );
    assert(t.split(p.concat(b";\n")).len() == 2, Some(String::of_bytes_lossy(p)));
    let bind = Bytes::concat_all([
      b"  ",
      n.name,
      b"_p = (",
      return_c_type(n),
      b" (*)(",
      parameter_c_types(n),
      b"))fns[",
      ascii_of_int(i),
      b"];\n",
    ]);
    assert(t.index_of(bind) != None, Some(String::of_bytes_lossy(bind)))
  });
  assert(t.starts_with(runtime_part_mark()), None);
  assert(
    h.index_of(b"extern void (*builtin_elaborated_out_str_p)(PlyCtx*, Word, Word);\n") != None,
    None,
  );
  assert(h.index_of(b"extern Word (*rt_alloc_bytes_p)(PlyCtx*, Word);\n") != None, None)
}

test "a shipped module's native a unit calls is no part of the head, and the tail defines and binds it after the rest" {
  let cpus = { name: b"builtin_os_cpus", params: [], result: Some(abi::I64), raises: false };
  let named = {
    name: b"builtin_os_user_name",
    params: [abi::I64],
    result: Some(abi::Taken),
    raises: false,
  };
  let t = unit_tail([cpus, named]);
  assert(unit_header().index_of(b"builtin_os_cpus") == None, None);
  assert_eq(pointer_declared(cpus), b"extern Word (*builtin_os_cpus_p)(PlyCtx*);\n");
  assert(t.index_of(b"Word (*builtin_os_user_name_p)(PlyCtx*, Word);\n") != None, None);
  let n = bound_functions().len();
  assert(
    t.index_of(
        Bytes::concat_all([
          b"  builtin_os_cpus_p = (Word (*)(PlyCtx*))fns[",
          ascii_of_int(n),
          b"];\n  builtin_os_user_name_p = (Word (*)(PlyCtx*, Word))fns[",
          ascii_of_int(n + 1),
          b"];\n",
        ]),
      )
      != None,
    None,
  )
}

test "each machine struct is declared before one that points at it, its fields in order, its size checked" {
  let h = header_part();
  let at = |s: Bytes|
    match h.index_of(Bytes::concat_all([b"typedef struct ", s, b" {"])) {
      Some(i) -> i,
      None -> 0 - 1,
    };
  let order = machine_structs().map(|s: MachineStruct| at(s.name));
  assert(order.all(|i: Int| i >= 0), None);
  assert_eq(order.sort(), order);
  machine_structs().fold((), |_: Unit, s: MachineStruct| {
    let from = at(s.name);
    let placed = s.fields.fold(from, |last: Int, f: MachineField|
      match h.index_of_from(f.declaration, last) {
        Some(i) -> i,
        None ->
          panic(
            String::of_bytes_lossy(b"a field the head does not declare: ".concat(f.declaration)),
          ),
      });
    assert(placed > from, None);
    assert(
      h.index_of(Bytes::concat_all([b"sizeof(", s.name, b") == ", ascii_of_int(s.bytes)])) != None,
      None,
    )
  })
}

test "each sequence the printers share is defined once in the head, which each use names" {
  let h = header_part();
  let shared = [
    probed_fn(),
    writable_list_fn(),
    opened_list_fn(),
    persistent_copy_fn(),
    fresh_block_fn(),
    kept_list_fn(),
    fresh_list_fn(),
    unshared_fn(),
    mark_shared_fn(),
  ];
  assert_eq(shared.filter(|f: Bytes| h.split(f.concat(b"(")).len() != 2), []);
  assert(
    h.index_of(probed_helper()) != None
      && probed_helper().index_of(b"rt_stack_more_p(ctx)") != None,
    None,
  );
  let kept = defined_in(h, persistent_copy_fn());
  assert(kept.index_of(b"->") == None, Some(String::of_bytes_lossy(kept)))
}
