import std.bytes (first_offset, occurrences, contains_bytes, ascii_of_int)
import compiler.syntax.parsing (span_between)
import compiler.check.types (Type, NamedType, RecordType, fields_sorted, int_type, string_type)
import compiler.emit.pieces (Piece, Text, merged, pieces_text)
import compiler.emit.layout (header_bytes)
import compiler.emit.keys (Root, Named, Unboxed, Release, root_name, root_text)
import compiler.emit.roots (symbol_of)
import compiler.emit.representations (constructors_of)
import compiler.emit.release (root_of)
import compiler.emit.typed_ir (local_var, Representation, AsInt, AsWord, AsFlattened, AsReuseToken,
                               Variable, Rvalue, Call, Primitive, Native, Block, Do, Increment,
                               Decrement, Free, IntOperand, VariableOperand, OwnedResult,
                               is_refcounted, may_suspend, handle_suspends)
import compiler.emit.typed_ir.handling (HandleSite, Clause, empty_instance)
import compiler.emit.print.text (Printing, InstructionContext, empty_printing, function_body, line,
                                 named, name_of, part_names)
import compiler.emit.print.ownership (count_printed)
import compiler.emit.print.value_printing (c_type)
import compiler.emit.lower.representation (c_values_of, representation_with)
import compiler.emit.print.count_functions (free_function, call_text, call_start)

pub type FrameLink = { printing: Printing, leave: Bytes, record: Option<Bytes> }

pub fn chain_defined() -> Bytes = b"#define PLY_FRAMES(c) ((c)->frames)\n"

fn frames_head() -> Bytes = b"PLY_FRAMES(ctx)"

pub fn site_linked(
  p: InstructionContext,
  printing: Printing,
  unwind: List<Variable>,
  value: Rvalue,
) -> FrameLink / {abort.raise} =
  if !may_suspend(value) { { printing: printing, leave: p.exit_statement, record: None } } else {
    let s = slots_of(printing, unwind);
    let l = linked(p, printing, b"ply_fr", s);
    {
      ..l,
      printing: if s.words.len() > l.printing.widest { { ..l.printing, widest: s.words.len() } }
      else { l.printing },
    }
  }

pub fn handle_linked(
  p: InstructionContext,
  printing: Printing,
  label: Int,
  body: Block,
  site: HandleSite,
  unwind: List<Variable>,
) -> FrameLink / {abort.raise} =
  if !handle_suspends(body, site) { { printing: printing, leave: p.exit_statement, record: None } }
  else {
    let record = b"ply_fh".concat(ascii_of_int(label));
    let s = slots_of(printing, unwind);
    linked(
      p,
      if s.words.len() == 0 { printing } else {
        line(
          printing,
          p.depth,
          Bytes::concat_all([
            b"struct { PlyFrame h; Word s[",
            ascii_of_int(s.words.len()),
            b"]; } ",
            record,
            b";",
          ]),
        )
      },
      record,
      s,
    )
  }

pub fn unlinked(printing: Printing, depth: Int, l: FrameLink) -> Printing =
  match l.record { Some(r) -> line(printing, depth, unlink(r)), None -> printing }

pub fn record_declared(printing: Printing) -> Bytes =
  if printing.widest == 0 { b"" } else {
    Bytes::concat_all([
      b"  struct { PlyFrame h; Word s[",
      ascii_of_int(printing.widest),
      b"]; } ply_fr;\n",
    ])
  }

pub fn each_functions_printed(symbol: Bytes, printing: Printing) -> List<Piece> =
  range(0, printing.each_functions.len()).fold([], |accumulator: List<Piece>, i: Int|
    match printing.each_functions.at(i) {
      Some(body) ->
        accumulator.push(
          Text(
            Bytes::concat_all([
              b"static void ",
              each_name(symbol, i),
              b"(PlyCtx *ctx, Word *s, int64_t d) {\n",
            ]),
          ),
        ).concat(
          body,
        ).push(
          Text(b"}\n"),
        ),
      None -> accumulator,
    })

type Slots = { tokens: List<Variable>, refcounted: List<Variable>, words: List<Bytes> }

fn slots_of(printing: Printing, unwind: List<Variable>) -> Slots = {
  let counted_variables = unwind.filter(|v: Variable|
    is_refcounted(v.representation) && !token(v.representation));
  {
    tokens: unwind.filter(|v: Variable| token(v.representation)),
    refcounted: counted_variables,
    words: counted_variables.fold([], |accumulator: List<Bytes>, v: Variable|
      accumulator.concat(
        counted_values(name_of(printing, v), v.representation).map(|c: CValue| c.name),
      )),
  }
}

fn token(r: Representation) -> Bool = match r { AsReuseToken(_) -> true, _ -> false }

type CValue = { name: Bytes, representation: Representation }

fn counted_values(name: Bytes, r: Representation) -> List<CValue> = {
  let reps = c_values_of(r);
  let names = part_names(name, r);
  range(0, reps.len()).fold([], |accumulator: List<CValue>, k: Int|
    match ((reps.at(k), names.at(k))) {
      (Some(c), Some(n)) -> if is_refcounted(c) { accumulator.push({ name: n, representation: c }) }
      else { accumulator },
      _ -> accumulator,
    })
}

fn linked(
  p: InstructionContext,
  printing: Printing,
  record: Bytes,
  s: Slots,
) -> FrameLink / {abort.raise} =
  if s.tokens.len() == 0 && s.words.len() == 0 {
    { printing: printing, leave: p.exit_statement, record: None }
  } else {
    let inner = { ..p, depth: p.depth + 1 };
    let freed = s.tokens.fold(
      line(printing, p.depth, Bytes::concat_all([b"if (", frames_head(), b") {"])),
      |q: Printing, t: Variable| {
        let words = match t.representation { AsReuseToken(n) -> n, _ -> 0 };
        line(
          count_printed(inner, q, Free({ of: t, bytes: IntOperand(header_bytes() + 8 * words) })),
          inner.depth,
          Bytes::concat_all([name_of(q, t), b" = 0;"]),
        )
      },
    );
    if s.words.len() == 0 {
      { printing: line(freed, p.depth, b"}"), leave: p.exit_statement, record: None }
    } else {
      let e = each_named(p, freed, s.refcounted);
      let laid = Bytes::join(
        range(0, s.words.len()).map(|j: Int|
          Bytes::concat_all([record, b".s[", ascii_of_int(j), b"] = ", s.words.get(j), b";"])),
        b" ",
      );
      let head = Bytes::concat_all([
        record,
        b".h.each = ",
        e.name,
        b"; ",
        record,
        b".h.prev = ",
        frames_head(),
        b"; ",
        frames_head(),
        b" = &",
        record,
        b".h;",
      ]);
      {
        printing: line(line(line(e.printing, inner.depth, laid), inner.depth, head), p.depth, b"}"),
        leave: Bytes::concat_all([b"{ ", unlink(record), b" ", p.exit_statement, b" }"]),
        record: Some(record),
      }
    }
  }

fn unlink(record: Bytes) -> Bytes =
  Bytes::concat_all([
    b"if (",
    frames_head(),
    b" == &",
    record,
    b".h) ",
    frames_head(),
    b" = ",
    record,
    b".h.prev;",
  ])

fn each_name(symbol: Bytes, i: Int) -> Bytes =
  Bytes::concat_all([symbol, b"_each", ascii_of_int(i)])

fn each_named(
  p: InstructionContext,
  printing: Printing,
  counted_variables: List<Variable>,
) -> { printing: Printing, name: Bytes } / {abort.raise} = {
  let laid = range(0, counted_variables.len()).fold(
    { at: 0, names: Map::new(), loads: [], vars: [] },
    |accumulator: { at: Int, names: Map<Int, Bytes>, loads: List<Bytes>, vars: List<Variable> }, i: Int| {
      let v = { ..counted_variables.get(i), id: i };
      let x = b"x".concat(ascii_of_int(i));
      let values = counted_values(x, v.representation);
      {
        at: accumulator.at + values.len(),
        names: accumulator.names.insert(i, x),
        loads: accumulator.loads.concat(
          range(0, values.len()).map(|j: Int| {
            let c = values.get(j);
            Bytes::concat_all([
              c_type(c.representation),
              b" ",
              c.name,
              b" = s[",
              ascii_of_int(accumulator.at + j),
              b"];",
            ])
          }),
        ),
        vars: accumulator.vars.push(v),
      }
    },
  );
  let down = laid.vars.fold(
    { ..printing, out: [], names: laid.names },
    |q: Printing, v: Variable| count_printed({ ..p, depth: 0 }, q, Decrement(v)),
  );
  let body = merged(
    [Text(Bytes::concat_all([b"  (void)d; ", Bytes::join(laid.loads, b" "), b"\n"]))].concat(
      down.out,
    ),
  );
  let back = {
    ..down,
    out: printing.out,
    names: printing.names,
    temps: printing.temps,
    declared: printing.declared,
  };
  match range(0, back.each_functions.len()).fold(None, |found: Option<Int>, i: Int|
      match found {
        Some(_) -> found,
        None -> if back.each_functions.at(i) == Some(body) { Some(i) } else { None },
      }) {
    Some(i) -> { printing: back, name: each_name(p.u.symbol, i) },
    None ->
      {
        printing: { ..back, each_functions: back.each_functions.push(body) },
        name: each_name(p.u.symbol, back.each_functions.len()),
      },
  }
}

fn string_int_type() -> Type / {abort.raise} =
  RecordType(fields_sorted([{ name: b"a", ty: string_type() }, { name: b"b", ty: int_type() }]))

fn place() -> InstructionContext =
  {
    u: {
      symbol: b"m_f",
      base: 0,
      result: AsWord,
      site: None,
      arm: None,
      looping: None,
      handler_jump: None,
      group: None,
      unwinds: [],
      epilogue: b"",
    },
    at: span_between(0, 0),
    exit_statement: b"goto ply_u0;",
    depth: 0,
  }

fn call_of(stops: Bool) -> Rvalue =
  Call({
    callee: Root(Named(b"m.g")),
    args: [],
    convention: { params: [], result: AsWord, destination_passing: false, returned: OwnedResult },
    suspends: stops,
  })

fn frame_setup() -> { printing: Printing, s: Variable, flat: Variable, n: Variable, token: Variable } / {abort.raise} = {
  let s = local_var(0, string_type(), AsWord);
  let flat = {
    id: 1,
    ty: string_int_type(),
    representation: AsFlattened([
      { name: b"a", representation: AsWord },
      { name: b"b", representation: AsInt },
    ]),
  };
  let n = local_var(2, int_type(), AsInt);
  let token = { ..flat, id: 3, representation: AsReuseToken(2) };
  let printing = named(
    named(named(empty_printing(Map::new().insert(0, b"p0")), flat).printing, n).printing,
    token,
  ).printing;
  { printing: printing, s: s, flat: flat, n: n, token: token }
}

fn links(text: Bytes, record: Bytes) -> Bool =
  contains_bytes(text, Bytes::concat_all([b"= &", record, b".h;"]))

fn unlinks(text: Bytes, record: Bytes) -> Bool =
  contains_bytes(text, Bytes::concat_all([b"= ", record, b".h.prev;"]))

test "a runtime call that can pause the program but cannot fail still links a frame record into the frame chain, like a call that can fail" {
  let h = frame_setup();
  let quiet = Native({
    name: b"rt_wait_p",
    args: [],
    uses: { takes: [], owned: true, fails: false, suspends: true },
  });
  let l = site_linked(place(), h.printing, [h.s], quiet);
  let r = match l.record { Some(r) -> r, None -> b"" };
  let text = pieces_text(l.printing.out);
  assert(links(text, r) && contains_bytes(text, b"= p0;"), Some(String::of_bytes_lossy(text)));
  assert(unlinks(pieces_text(unlinked({ ..l.printing, out: [] }, 0, l).out), r), None)
}

test "a call that can pause links a frame record of the values still live and counted across it, and the failure exit unlinks that record before jumping out" {
  let h = frame_setup();
  let l = site_linked(place(), h.printing, [h.s, h.flat, h.n], call_of(true));
  let r = match l.record { Some(r) -> r, None -> b"" };
  let text = pieces_text(l.printing.out);
  assert(
    links(text, r) && contains_bytes(text, b"= p0;") && contains_bytes(text, b"= t1_0;"),
    Some(String::of_bytes_lossy(text)),
  );
  assert(!contains_bytes(text, b"= t2;"), None);
  assert(contains_bytes(record_declared(l.printing), b"s[2]"), None);
  assert(
    unlinks(l.leave, r) && first_offset(l.leave, b".h.prev") < first_offset(l.leave, b"goto "),
    Some(String::of_bytes_lossy(l.leave)),
  );
  assert(unlinks(pieces_text(unlinked({ ..l.printing, out: [] }, 0, l).out), r), None)
}

test "a frame record's cleanup function releases every value stored in the record, in the same way as the frame's failure exit" {
  let h = frame_setup();
  let unwind = [h.s, h.flat, h.n];
  let l = site_linked(place(), h.printing, unwind, call_of(true));
  let each = pieces_text(each_functions_printed(b"m_f", l.printing));
  let slots = [{ ..h.s, id: 0 }, { ..h.flat, id: 1 }];
  let named = {
    ..empty_printing(Map::new().insert(0, b"x0").insert(1, b"x1")),
    constructors: h.printing.constructors,
  };
  let down = pieces_text(
    slots.fold(named, |q: Printing, v: Variable| count_printed(place(), q, Decrement(v))).out,
  );
  let up = pieces_text(
    slots.fold(named, |q: Printing, v: Variable|
      count_printed(place(), q, Increment({ var: v, n: 1 }))).out,
  );
  assert(
    contains_bytes(each, b"= s[0];") && contains_bytes(each, b"= s[1];"),
    Some(String::of_bytes_lossy(each)),
  );
  assert(
    contains_bytes(each, down) && !contains_bytes(each, up),
    Some(String::of_bytes_lossy(each)),
  )
}

test "a frame record's cleanup function releases a value through its type's release function, and for wide sums and records with `Int` fields it loads only the counted words" {
  let string = string_type();
  let wide = NamedType({ name: b"m.Wide", args: [] });
  let constructors = constructors_of(
    [],
    [],
    [],
    Map::new().insert(b"m.Wide", [
      {
        name: b"m.Wide",
        index: 0,
        fields: range(0, 6).map(|_: Int| string).concat(range(0, 3).map(|_: Int| int_type())),
        params: [],
      },
    ]),
  );
  let record = RecordType(
    fields_sorted([
      { name: b"s0", ty: string },
      { name: b"s1", ty: string },
      { name: b"n0", ty: int_type() },
    ]),
  );
  [wide, record].fold((), |_: Unit, ty: Type| {
    let representation = representation_with(constructors, ty);
    let flat = { id: 1, ty: ty, representation: representation };
    let printing = named(
      { ..empty_printing(Map::new().insert(0, b"p0")), constructors: constructors },
      flat,
    ).printing;
    let each = pieces_text(
      each_functions_printed(
        b"m_f",
        site_linked(place(), printing, [flat], call_of(true)).printing,
      ),
    );
    let name = |k: Int| b"x0_".concat(ascii_of_int(k));
    let named_at = |k: Int|
      [b",", b")", b"}", b";"].any(|end: Bytes| contains_bytes(each, name(k).concat(end)));
    let loaded = |k: Int| contains_bytes(each, name(k).concat(b" = s["));
    let message = Some(String::of_bytes_lossy(each));
    assert(
      contains_bytes(
        each,
        symbol_of(root_text(root_name(root_of(Unboxed(Release), ty)))).concat(b"(ctx, "),
      ),
      message,
    );
    assert_eq(
      range(0, c_values_of(representation).len()).filter(|k: Int| named_at(k) && !loaded(k)),
      [],
    )
  })
}

test "a call that cannot pause, a value that cannot fail, and a call with no counted value live after it each link no frame record" {
  let h = frame_setup();
  let summed = Primitive({
    operation: b"add",
    on: AsInt,
    args: [VariableOperand(h.n), IntOperand(1)],
  });
  [
    site_linked(place(), h.printing, [h.s, h.flat], call_of(false)),
    site_linked(place(), h.printing, [h.s], summed),
    site_linked(place(), h.printing, [h.n], call_of(true)),
  ].fold((), |_: Unit, l: FrameLink| {
    assert_eq((l.printing.out.len(), l.leave, l.record), (
      h.printing.out.len(),
      place().exit_statement,
      None,
    ));
    assert_eq((record_declared(l.printing), l.printing.each_functions.len()), (b"", 0))
  })
}

test "a reuse token live across a pausing call is freed, if it was not reused, before the frame record is linked, and is never stored in the record" {
  let h = frame_setup();
  let freed = call_start(free_function(), [b"ctx", b"t3"]);
  let l = site_linked(place(), h.printing, [h.s, h.token], call_of(true));
  let r = match l.record { Some(r) -> r, None -> b"" };
  let text = pieces_text(l.printing.out);
  assert(
    contains_bytes(text, freed) && links(text, r)
      && first_offset(text, freed) < first_offset(text, b"= &"),
    Some(String::of_bytes_lossy(text)),
  );
  assert(
    !contains_bytes(text, b"= t3;") && contains_bytes(record_declared(l.printing), b"s[1]"),
    None,
  );
  let alone = site_linked(place(), h.printing, [h.token], call_of(true));
  assert_eq(alone.record, None);
  assert(
    contains_bytes(pieces_text(alone.printing.out), freed)
      && !contains_bytes(pieces_text(alone.printing.out), b"= &"),
    None,
  )
}

test "call sites with identical live values share one cleanup function, and the record is sized for the widest site" {
  let h = frame_setup();
  let first = site_linked(place(), h.printing, [h.s], call_of(true));
  let alike = site_linked(place(), first.printing, [h.s], call_of(true));
  let wider = site_linked(place(), alike.printing, [h.s, h.flat], call_of(true));
  let text = pieces_text(wider.printing.out);
  assert_eq(wider.printing.each_functions.len(), 2);
  assert_eq(
    [occurrences(text, b"h.each = m_f_each0;"), occurrences(text, b"h.each = m_f_each1;")],
    [2, 1],
  );
  assert(contains_bytes(record_declared(wider.printing), b"s[2]"), None);
  assert_eq(
    occurrences(pieces_text(each_functions_printed(b"m_f", wider.printing)), b" m_f_each"),
    2,
  );
  let lambda = function_body(wider.printing, Map::new().insert(0, b"q0"));
  assert_eq(record_declared(lambda), b"");
  assert_eq(site_linked(place(), lambda, [h.s], call_of(true)).printing.each_functions.len(), 2)
}

test "an effect handler whose body can pause links its own frame record of the counted values live across that body" {
  let h = frame_setup();
  let ask_clause = { effect: b"m.ask", operation: b"get", mode: 0, string: None, handler: 0 };
  let site = |clauses: List<Clause>|
    { clauses: clauses, return_clause: None, detached: None, instance: empty_instance(0) };
  let l = handle_linked(place(), h.printing, 2, [], site([ask_clause]), [h.s, h.n]);
  let r = match l.record { Some(r) -> r, None -> b"" };
  let text = pieces_text(l.printing.out);
  assert(
    links(text, r) && contains_bytes(text, b"= p0;") && !contains_bytes(text, b"= t2;")
      && contains_bytes(text, b"s[1]"),
    Some(String::of_bytes_lossy(text)),
  );
  assert_eq(record_declared(l.printing), b"");
  let quiet = handle_linked(place(), h.printing, 2, [], site([]), [h.s]);
  assert_eq((quiet.record, quiet.printing.out.len()), (None, h.printing.out.len()));
  let stopping = [Do({ value: call_of(true), at: span_between(0, 0), unwind: [] })];
  assert(handle_linked(place(), h.printing, 2, stopping, site([]), [h.s]).record != None, None)
}
