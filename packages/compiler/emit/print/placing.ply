//! Where a body writes the records lying in place that it would otherwise box: its root's answer
//! at the destination its caller gives, and a call's answer that is only read in a slot of its C
//! frame. A call handed a destination writes there and nowhere else, so neither can stop: a frame a
//! handler resumes twice would hold the slot's counts once.

import std.map
import compiler.emit.keys (Callee)
import compiler.emit.tir (Carried, Fn, Block, Inst, Val, Var, Arg, AVar, Convention, Let, Do,
                          Assign, If, Case, Match, Loop, Next, Done, Return, Restart, Enter, Handle,
                          Inc, Dec, Reset, Free, Opened, Make, MRecord, Updated, Call, FieldSet,
                          Owned, operands, stops_in)
import compiler.emit.print.text (Placing)

/// Where `f`'s body writes its records lying in place, as `Placing` says.
pub fn placing_of(f: Fn) -> Placing = {
  let m = mentions(f.body, false, no_mentions());
  let destined = f.conv.destined && f.conv.answered == Owned && f.members.len() == 0;
  let answers = if destined { answers_in(f.body, m, Map::new()) } else { Map::new() };
  let slots = if stops_in(f.body) { Map::new() } else { slots_in(f.body, m, answers, Map::new()) };
  {
    destined: destined,
    answers: answers,
    slots: slots,
    moving: moves_in(f.body, slots, Map::new()),
    moved: Map::new(),
  }
}

/// How often each variable is mentioned: other than let go of (`reads`); let go of, by a `Dec` or
/// on a failure path (`held`); taken, counted or handed on by an operand or an instruction
/// (`taken`); and anywhere inside a `Handle`'s body (`handled`), which may run as a function of its
/// own.
type Mentions = {
  reads: Map<Int, Int>,
  held: Map<Int, Int>,
  taken: Map<Int, Int>,
  handled: Map<Int, Int>,
}

fn no_mentions() -> Mentions =
  { reads: Map::new(), held: Map::new(), taken: Map::new(), handled: Map::new() }

fn mentions(b: Block, inside: Bool, m: Mentions) -> Mentions =
  b.fold(m, |acc: Mentions, i: Inst| inst_mentions(acc, inside, i))

fn inst_mentions(m: Mentions, inside: Bool, i: Inst) -> Mentions =
  match i {
    Let(l) -> unwound(val_mentions(m, inside, l.val), inside, l.unwind),
    Do(d) -> unwound(val_mentions(m, inside, d.val), inside, d.unwind),
    Assign(a) -> taken_args(m, inside, [a.arg]),
    If(x) ->
      mentions(
        x.otherwise,
        inside,
        mentions(x.then, inside, read_args(m, inside, [x.cond], false)),
      ),
    Case(c) ->
      mentions(
        c.rest,
        inside,
        c.arms.fold(read(m, inside, c.on, false), |acc: Mentions, a: { when: Int, body: Block }|
          mentions(a.body, inside, acc)),
      ),
    Match(x) ->
      mentions(x.rest, inside, x.arms.fold(m, |acc: Mentions, a: Block| mentions(a, inside, acc))),
    Loop(l) -> mentions(l.body, inside, taken_args(m, inside, l.state.map(|c: Carried| c.init))),
    Next(args) -> taken_args(m, inside, args),
    Done(a) -> taken_args(m, inside, [a]),
    Return(a) -> taken_args(m, inside, [a]),
    Restart(args) -> taken_args(m, inside, args),
    Enter(e) -> taken_args(m, inside, e.args),
    Handle(h) -> unwound(mentions(h.body, true, taken_args(m, inside, h.args)), inside, h.unwind),
    Inc(n) -> read(m, inside, n.var, true),
    Dec(v) -> unwound(m, inside, [v]),
    Reset(r) -> read(m, inside, r.of, true),
    Free(x) -> read_args(read(m, inside, x.of, true), inside, [x.bytes], true),
    Opened(o) -> read(m, inside, o.of, true),
    _ -> m,
  }

fn val_mentions(m: Mentions, inside: Bool, v: Val) -> Mentions =
  operands(v).fold(m, |acc: Mentions, o: { arg: Arg, takes: Bool }|
    read_args(acc, inside, [o.arg], o.takes))

fn taken_args(m: Mentions, inside: Bool, args: List<Arg>) -> Mentions =
  read_args(m, inside, args, true)

fn read_args(m: Mentions, inside: Bool, args: List<Arg>, takes: Bool) -> Mentions =
  args.fold(m, |acc: Mentions, a: Arg| match a { AVar(v) -> read(acc, inside, v, takes), _ -> acc })

fn read(m: Mentions, inside: Bool, v: Var, takes: Bool) -> Mentions =
  {
    reads: counted_once(m.reads, v.id),
    held: m.held,
    taken: if takes { counted_once(m.taken, v.id) } else { m.taken },
    handled: if inside { counted_once(m.handled, v.id) } else { m.handled },
  }

fn unwound(m: Mentions, inside: Bool, vs: List<Var>) -> Mentions =
  vs.fold(m, |acc: Mentions, v: Var|
    {
      ..acc,
      held: counted_once(acc.held, v.id),
      handled: if inside { counted_once(acc.handled, v.id) } else { acc.handled },
    })

fn counted_once(m: Map<Int, Int>, id: Int) -> Map<Int, Int> =
  m.insert(id, match m.get(id) { Some(n) -> n + 1, None -> 1 })

fn mentioned(m: Map<Int, Int>, id: Int) -> Int = match m.get(id) { Some(n) -> n, None -> 0 }

/// The variables of `b`'s blocks a `Return` of its block answers, made by a record `Make`, an
/// `Updated` or a call that can be handed a destination earlier in that block, and mentioned
/// nowhere else: each is written straight into the destination.
fn answers_in(b: Block, m: Mentions, acc: Map<Int, Bool>) -> Map<Int, Bool> = {
  let here = b.fold(acc, |found: Map<Int, Bool>, i: Inst|
    match i {
      Return(AVar(x)) -> if mentioned(m.reads, x.id) == 1 && mentioned(m.held, x.id) == 0
          && made_here(b, x) { found.insert(x.id, true) }
      else { found },
      _ -> found,
    });
  nested(b, here, |inner: Block, a: Map<Int, Bool>| answers_in(inner, m, a))
}

/// Whether `x` is bound in `b` to a value a destination can take.
fn made_here(b: Block, x: Var) -> Bool =
  b.any(|i: Inst| match i { Let(l) -> l.var.id == x.id && destinable(l.val), _ -> false })

fn destinable(v: Val) -> Bool =
  match v {
    Make(k) -> match k.made { MRecord(_) -> true, _ -> false },
    Updated(_) -> true,
    Call(c) -> handed_destination(c),
    _ -> false,
  }

/// Whether a call can be handed a destination: its callee is destined, answers owned and cannot
/// stop.
fn handed_destination(
  c: { callee: Callee, args: List<Arg>, conv: Convention, stops: Bool },
) -> Bool = c.conv.destined && c.conv.answered == Owned && !c.stops

/// The calls of `b`'s blocks that can be handed a destination and whose answer, not the root's, is
/// only read and let go of, never taken, counted or mentioned inside a `Handle`'s body: each is
/// written into a slot of the C frame, which it never outlives.
fn slots_in(b: Block, m: Mentions, answers: Map<Int, Bool>, acc: Map<Int, Bool>) -> Map<Int, Bool> = {
  let here = b.fold(acc, |found: Map<Int, Bool>, i: Inst|
    match i {
      Let(l) -> match l.val {
        Call(c) -> if handed_destination(c) && !answers.contains(l.var.id)
            && mentioned(m.taken, l.var.id) == 0
            && mentioned(m.handled, l.var.id) == 0 { found.insert(l.var.id, true) }
        else { found },
        _ -> found,
      },
      _ -> found,
    });
  nested(b, here, |inner: Block, a: Map<Int, Bool>| slots_in(inner, m, answers, a))
}

/// Each of `slots` a record `Make` or an `Updated` of `b`'s blocks reads once into a place right
/// before the `Dec` that lets it go, past count instructions alone, by the variable that read
/// binds: that read moves its words, and the `Dec` lets go of nothing. Every other read copies.
fn moves_in(b: Block, slots: Map<Int, Bool>, acc: Map<Int, Int>) -> Map<Int, Int> = {
  let here = range(0, b.len()).fold(acc, |found: Map<Int, Int>, k: Int|
    match b.at(k) {
      Some(Let(l)) ->
        placed_reads(l.val).fold(found, |q: Map<Int, Int>, v: Var|
          if slots.contains(v.id) && moved_by(b, k + 1, v) { q.insert(v.id, l.var.id) } else { q }),
      _ -> found,
    });
  nested(b, here, |inner: Block, a: Map<Int, Int>| moves_in(inner, slots, a))
}

/// The variables `val` reads into the places it writes, each read there once.
fn placed_reads(val: Val) -> List<Var> = {
  let once = |args: List<Arg>|
    args.fold([], |acc: List<Var>, a: Arg|
      match a {
        AVar(v) -> if args.filter(|x: Arg| x == a).len() == 1 { acc.push(v) } else { acc },
        _ -> acc,
      });
  match val {
    Make(k) -> match k.made { MRecord(_) -> once(k.args), _ -> [] },
    Updated(u) -> once(u.sets.map(|s: FieldSet| s.arg)).filter(|v: Var| v.id != u.of.id),
    _ -> [],
  }
}

/// Whether `Dec(v)` follows from `k` in `b` past count instructions alone.
fn moved_by(b: Block, k: Int, v: Var) -> Bool =
  match b.at(k) {
    Some(Dec(x)) -> x.id == v.id || moved_by(b, k + 1, v),
    Some(Inc(x)) -> x.var.id != v.id && moved_by(b, k + 1, v),
    Some(Free(_)) -> moved_by(b, k + 1, v),
    _ -> false,
  }

/// `acc` gone on with `each` through every block `b`'s instructions hold.
fn nested<s>(b: Block, acc: s, each: (Block, s) -> s) -> s =
  b.fold(acc, |a: s, i: Inst|
    match i {
      If(x) -> each(x.otherwise, each(x.then, a)),
      Case(c) ->
        each(c.rest, c.arms.fold(a, |q: s, arm: { when: Int, body: Block }| each(arm.body, q))),
      Match(x) -> each(x.rest, x.arms.fold(a, |q: s, arm: Block| each(arm, q))),
      Loop(l) -> each(l.body, a),
      Handle(h) -> each(h.body, a),
      _ -> a,
    })
