//! The C names a count, a release and a block given back are printed under: the head's functions
//! emitted code calls, the runtime's that they and the runtime's own counts call. The printer writes
//! them through these, and every test that looks for one names it through these too, so a spelling
//! that moves moves the tests with it.

import std.bytes (ascii_of_int)

/// The head's: one holder more of an object word.
pub fn dup_fn() -> Bytes = b"ply_dup"

/// The head's: whether a holder of an object word was its last, which takes its count.
pub fn last_fn() -> Bytes = b"ply_last"

/// The head's: one holder fewer of an object word, the last releasing it through a drop root.
pub fn rel_fn() -> Bytes = b"ply_rel"

/// The head's: `rel_fn` of a sum's word, which points at a block only where its tag bits say so.
pub fn rel_sum_fn() -> Bytes = b"ply_rel_sum"

/// The head's: one holder fewer of a scalar's box, which holds nothing counted, the last giving it
/// back by its size in bytes.
pub fn rel_box_fn() -> Bytes = b"ply_rel_box"

/// The head's: a block given back, by its size in bytes.
pub fn free_fn() -> Bytes = b"ply_free"

/// The head's, which a type's descriptor names where its word form holds no block a root lets go
/// of: an immediate counted and let go of, which is nothing.
pub fn same_word_fn() -> Bytes = b"ply_same_word"

pub fn no_word_fn() -> Bytes = b"ply_no_word"

/// The head's, a descriptor's: a scalar's box counted, and let go of as a box of `words` words.
pub fn box_dup_fn() -> Bytes = b"ply_box_dup"

pub fn box_released_fn(words: Int) -> Bytes = b"ply_box_released_".concat(ascii_of_int(words))

/// The head's, a descriptor's lifting of any type but `String`, which the runtime never lifts: the
/// runtime's refusal (`never_lifted_rt_fn`).
pub fn never_lifted_fn() -> Bytes = b"ply_never_lifted"

pub fn never_lifted_rt_fn() -> Bytes = b"rt_never_lifted_p"

/// The head's, a descriptor's lowering of a type no diagnostic shows a value of: the runtime's
/// refusal (`never_shown_rt_fn`).
pub fn never_shown_fn() -> Bytes = b"ply_never_shown"

pub fn never_shown_rt_fn() -> Bytes = b"rt_never_shown_p"

/// The runtime's: a handle's block, which emitted code holds the last of, given back.
pub fn handle_free_fn() -> Bytes = b"rt_handle_free_p"

/// The runtime's, which the head's call: a shared count once more, a shared count's last, a block
/// given back, a release put off and the put-off releases run, and a block released twice.
pub fn inc_shared_fn() -> Bytes = b"rt_inc_shared_p"

pub fn dec_shared_last_fn() -> Bytes = b"rt_dec_shared_last_p"

pub fn free_block_fn() -> Bytes = b"rt_free_p"

/// The head's, which takes a block from the heap; and the runtime's, which it calls for a block it
/// does not take in place.
pub fn alloc_fn() -> Bytes = b"ply_alloc"

pub fn alloc_block_fn() -> Bytes = b"rt_alloc_bytes_p"

/// Whether `text` takes a block anywhere: from the heap, the head's way or the runtime's, or for a
/// value kept for good.
pub fn allocates(text: Bytes) -> Bool =
  calls(text, alloc_fn()) || calls(text, alloc_block_fn()) || calls(text, b"rt_alloc_kept_p")

pub fn release_later_fn() -> Bytes = b"rt_release_later_p"

pub fn release_drain_fn() -> Bytes = b"rt_release_drain_p"

pub fn released_twice_fn() -> Bytes = b"rt_released_twice_p"

/// Every function emitted code counts, releases or gives a block back through.
pub fn count_fns() -> List<Bytes> =
  [dup_fn(), last_fn(), rel_fn(), rel_sum_fn(), rel_box_fn(), free_fn(), handle_free_fn()]

/// The C calling `f` on `args`.
pub fn call_text(f: Bytes, args: List<Bytes>) -> Bytes =
  Bytes::concat_all([f, b"(", Bytes::join(args, b", "), b")"])

/// The C calling `f` on `args` and then on more: up to the next argument.
pub fn call_start(f: Bytes, args: List<Bytes>) -> Bytes =
  Bytes::concat_all([f, b"("].concat(args.map(|a: Bytes| a.concat(b", "))))

/// Whether `text` calls `f`.
pub fn calls(text: Bytes, f: Bytes) -> Bool = text.index_of(f.concat(b"(")) != None

/// Whether `text` counts, releases or gives a block back anywhere.
pub fn counts_any(text: Bytes) -> Bool = count_fns().any(|f: Bytes| calls(text, f))

/// Whether `text` takes a count anywhere.
pub fn takes_count(text: Bytes) -> Bool = calls(text, dup_fn())

/// Whether `text` lets a count go anywhere, the head's way or the runtime's.
pub fn lets_count_go(text: Bytes) -> Bool = letting_go().any(|f: Bytes| calls(text, f))

/// Whether `text` lets a count of the word `w` go, the head's way or the runtime's.
pub fn lets_go_of(text: Bytes, w: Bytes) -> Bool =
  letting_go().any(|f: Bytes|
    text.index_of(call_start(f, [b"ctx", w])) != None
      || text.index_of(call_text(f, [b"ctx", w])) != None)

fn letting_go() -> List<Bytes> = [last_fn(), rel_fn(), rel_sum_fn(), rel_box_fn()]

test "a call is its function's name and its arguments, and a text calls a function only where it holds that" {
  let rel = call_text(rel_fn(), [b"ctx", b"t1", b"d"]);
  assert_eq(rel, rel_fn().concat(b"(ctx, t1, d)"));
  assert_eq(call_start(rel_fn(), [b"ctx"]), rel_fn().concat(b"(ctx, "));
  assert_eq(call_start(free_fn(), []), free_fn().concat(b"("));
  // A name that begins another's is not a call of it.
  let sum = Bytes::concat_all([b"x; ", call_text(rel_sum_fn(), [b"ctx", b"w", b"d"]), b";"]);
  assert(calls(sum, rel_sum_fn()) && !calls(sum, rel_fn()));
  assert(counts_any(call_text(free_fn(), [b"ctx", b"t1", b"32"])));
  assert(!counts_any(b"Word t1 = ply_words(p0)[0];"));
  assert(takes_count(call_text(dup_fn(), [b"t1"])));
  assert(!takes_count(rel) && lets_count_go(rel));
  assert(!lets_count_go(call_text(dup_fn(), [b"t1"])));
  assert(lets_go_of(rel, b"t1"));
  assert(!lets_go_of(call_text(rel_fn(), [b"ctx", b"t12", b"d"]), b"t1"))
}
