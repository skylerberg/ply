//! Values made, read, gathered and held otherwise, static constants, and the C a value of each
//! representation is held in: its C types, the names of its C values, how it crosses a root's head,
//! its entry and a return, and its word form. A value held as several C values is named
//! `<name>_<k>` for its `k`th: a record's leaves' values, a sum's words. A record or a wider sum is
//! made its word form in a box of its words made then, and opened out of one by taking the words,
//! freeing the box where it held its last count and counting each word once more where it did not.

import std.bytes (ascii_of_int)
import syntax.parsing (span_between)
import check.types (TyCon)
import emit.c (KNum, KInt, KBool, KFloat, KDec, ctype, width_index, int_lit)
import emit.pieces (Piece, Text, Hole, ShapeOf, TagOf, spelled)
import emit.tir (Rep, RInt, RBool, RNum, RFloat, RDec, RWord, RFlat, RSlice, RToken, Var, Arg, AVar,
                 AInt, AZero, Made, MRecord, MCtor, MBox, MCase, Path, PField, PNamed, PArg,
                 PCapture, PLeaf, PCase, PPayload, RUnit, RSum, Data, Convention, Given, Lent,
                 Owned, rep_of_arg, rep_said, var_said, made_said)
import emit.layout (Laid, LWords, LRecord, LSum, SumLaid, P, S, U, Nullary, Inline, Boxed, WordIs,
                    LowBits, words, header_bytes, pointer_floor, tag_bits, CaseArgs, sum_laid,
                    record_laid, raw)
import emit.layout
import emit.lower.held (passing, ByReference, InWords, answer_buffer, values_of, words_held,
                        leaf_values)
import emit.print.tested (case_held)
import emit.print.text (Printing, Place, printing, line, pieces, pad, temp, named, name_of,
                        arg_text, check, zero, field_hole, part_names, part_named, shape_at, slot,
                        unprinted)
import emit.print.strings (payload_printed)

/// The C type of the first C value a value held as `r` is held in, which a root answering it
/// returns: `Word` for a value of none, which returns 0.
pub fn c_type(r: Rep) -> Bytes =
  match values_of(r).at(0) { Some(v) -> one_type(v), None -> b"Word" }

/// The C types of the values a value held as `r` is held in and crosses a call in, one per C
/// parameter, as `values_of` says.
pub fn c_types(r: Rep) -> List<Bytes> = values_of(r).map(one_type)

fn one_type(r: Rep) -> Bytes =
  match r {
    RInt -> ctype(KInt),
    RBool -> ctype(KBool),
    RNum(w) -> ctype(KNum(w)),
    RFloat -> ctype(KFloat),
    RDec -> ctype(KDec),
    _ -> b"Word",
  }

/// What each of the C values a value held as `r` is held in stands at before anything is set.
pub fn zeros(r: Rep) -> List<Bytes> = values_of(r).map(zero)

/// Operand `a` as the C expressions of each of its values.
pub fn arg_parts(pr: Printing, a: Arg) -> List<Bytes> =
  match a {
    AVar(v) -> part_names(name_of(pr, v), v.rep),
    AZero(r) -> zeros(r),
    _ -> [arg_text(pr, a)],
  }

/// A scalar held as `r`, named `e`, as the word a value of its type is: an `Int` an immediate or
/// the runtime's box, a `Float`, a `Decimal` or a 64-bit width the runtime's box, a `Bool` 0 or 1's
/// singleton; any value of one word as that word.
pub fn as_word(e: Bytes, r: Rep) -> Bytes =
  match r {
    RInt ->
      Bytes::concat_all([
        b"(ply_fits_imm(",
        e,
        b") ? ply_imm(",
        e,
        b") : rt_box_int_p(ctx, ",
        e,
        b"))",
      ]),
    RBool -> Bytes::concat_all([b"(", e, b" ? ply_true : ply_false)"]),
    RFloat -> Bytes::concat_all([b"rt_box_float_p(ctx, ply_f64_bits(", e, b"))"]),
    RDec -> Bytes::concat_all([b"rt_box_decimal_p(ctx, (", e, b").lo, (", e, b").hi)"]),
    RNum(w) -> if w.bits < 64 { Bytes::concat_all([b"ply_imm((int64_t)", e, b")"]) } else {
      Bytes::concat_all([
        b"rt_box_fixed_p(ctx, (Word)(",
        e,
        b"), ",
        ascii_of_int(width_index(w)),
        b")",
      ])
    },
    _ -> e,
  }

/// The word `w` read as a scalar held as `r`, which leaves the word's count to its holder; a value
/// of one word as that word.
pub fn word_as(w: Bytes, r: Rep) -> Bytes =
  match r {
    RInt ->
      Bytes::concat_all([
        b"(ply_is_imm(",
        w,
        b") ? ply_imm_value(",
        w,
        b") : rt_unbox_int_p(ctx, ",
        w,
        b"))",
      ]),
    RBool -> Bytes::concat_all([b"(", w, b" == ply_true)"]),
    RFloat ->
      Bytes::concat_all([
        b"(ply_is_float(",
        w,
        b") ? ply_f64(",
        slot(w, 0),
        b") : ply_f64(rt_unbox_float_p(ctx, ",
        w,
        b")))",
      ]),
    RDec -> Bytes::concat_all([b"ply_dec_of(", w, b")"]),
    RNum(n) -> if n.bits < 64 {
      Bytes::concat_all([b"(", ctype(KNum(n)), b")ply_imm_value(", w, b")"])
    } else { Bytes::concat_all([b"(", ctype(KNum(n)), b")", slot(w, 0)]) },
    _ -> w,
  }

// What crosses a root's boundary: its head, its entry, its return.

/// The C types a root of convention `c` is declared with: what it returns, then each parameter's
/// values' (for one crossing by reference the address of the caller's copy of its words, which a
/// root it is lent to only reads), then the address of the buffer it writes its answer's other
/// values into, where it has any. The unit holds a call's head to its callee's by these.
pub fn head_types(c: Convention) -> { answer: Bytes, params: List<Bytes> } =
  {
    answer: c_type(c.answer),
    params: range(0, c.reps.len()).fold([], |acc: List<Bytes>, i: Int|
      match c.reps.at(i) {
        Some(r) ->
          acc.concat(match passing(r) {
            ByReference -> if c.params.at(i) == Some(Lent) { [b"const Word*"] } else { [b"Word*"] },
            InWords -> c_types(r),
          }),
        None -> acc,
      }).concat(if answer_buffer(c.answer) > 0 { [b"Word*"] } else { [] }),
  }

/// The C parameters of the head of a root of convention `c`: `head_names`, each declared at its
/// type.
pub fn head_params(c: Convention) -> List<Bytes> = {
  let types = head_types(c).params;
  let names = head_names(c.reps, c.answer);
  range(0, types.len()).map(|k: Int| Bytes::concat_all([nth(types, k), b" ", nth(names, k)]))
}

/// The names of the C parameters of the head of a root whose parameters are held as `params` and
/// which answers as `answer`: each parameter's value `p<i>`, or its values `p<i>_<k>` (for one
/// crossing by reference `p<i>`, the address of its words), then `o`, the answer's buffer.
pub fn head_names(params: List<Rep>, answer: Rep) -> List<Bytes> =
  range(0, params.len()).fold([], |acc: List<Bytes>, i: Int|
    match params.at(i) {
      Some(r) -> {
        let name = b"p".concat(ascii_of_int(i));
        acc.concat(match passing(r) { ByReference -> [name], InWords -> part_names(name, r) })
      },
      None -> acc,
    }).concat(if answer_buffer(answer) > 0 { [b"o"] } else { [] })

/// The statements opening each parameter of `names`, held as `reps`, that crosses by reference:
/// each of its C values declared from the caller's copy of its words, taking the counts that copy
/// held.
pub fn params_opened(names: List<Bytes>, reps: List<Rep>) -> List<Bytes> =
  range(0, reps.len()).fold([], |acc: List<Bytes>, i: Int|
    match reps.at(i) {
      Some(r) -> match passing(r) {
        InWords -> acc,
        ByReference -> {
          let name = nth(names, i);
          let held = values_of(r);
          let ns = part_names(name, r);
          let read = parts_read(name, held);
          acc.push(
            Bytes::join(
              range(0, held.len()).map(|k: Int|
                Bytes::concat_all([
                  one_type(match held.at(k) { Some(h) -> h, None -> RWord }),
                  b" ",
                  nth(ns, k),
                  b" = ",
                  nth(read, k),
                  b";",
                ])),
              b" ",
            ),
          )
        },
      },
      None -> acc,
    })

/// The words a buffer or a box holds of the C values `exprs`, held as `reps`, in order: each value's
/// bits, a `Decimal`'s two words, nothing of a value of no words.
pub fn words_laid(exprs: List<Bytes>, reps: List<Rep>) -> List<Bytes> =
  range(0, reps.len()).fold([], |acc: List<Bytes>, k: Int| {
    let e = nth(exprs, k);
    acc.concat(match reps.at(k) {
      Some(RFloat) -> [Bytes::concat_all([b"ply_f64_bits(", e, b")"])],
      Some(RDec) -> [Bytes::concat_all([b"(", e, b").lo"]), Bytes::concat_all([b"(", e, b").hi"])],
      Some(RUnit) -> [],
      Some(RWord) -> [e],
      _ -> [Bytes::concat_all([b"(Word)(", e, b")"])],
    })
  })

/// The C values, held as `reps`, that the buffer at `base` holds from its first word, as
/// `words_laid` lays them.
pub fn parts_read(base: Bytes, reps: List<Rep>) -> List<Bytes> =
  values_read(|k: Int| Bytes::concat_all([base, b"[", ascii_of_int(k), b"]"]), reps)

/// The C values of an answer held as `r`: `first`, the one its root returns, then those its root
/// wrote into the buffer at `base`.
pub fn answer_parts(first: Bytes, base: Bytes, r: Rep) -> List<Bytes> =
  [first].concat(parts_read(base, values_of(r).drop(1)))

/// A root returning `a`: its values past the first written into the buffer `o` as words, and the C
/// expression the first is returned as.
pub fn returned(pr: Printing, depth: Int, a: Arg) -> { pr: Printing, value: Bytes } = {
  let ps = arg_parts(pr, a);
  let ws = words_laid(ps.drop(1), values_of(rep_of_arg(a)).drop(1));
  {
    pr: range(0, ws.len()).fold(pr, |q: Printing, k: Int|
      line(q, depth, Bytes::concat_all([b"o[", ascii_of_int(k), b"] = ", nth(ws, k), b";"]))),
    value: nth(ps, 0),
  }
}

/// `v` declared, each of its C values at what it stands at before anything is set into it.
pub fn declared(pr: Printing, depth: Int, v: Var) -> Printing = {
  let n = named(pr, v);
  let ts = c_types(v.rep);
  let ns = part_names(n.name, v.rep);
  let zs = zeros(v.rep);
  range(0, ts.len()).fold(n.pr, |q: Printing, k: Int|
    line(q, depth, Bytes::concat_all([nth(ts, k), b" ", nth(ns, k), b" = ", nth(zs, k), b";"])))
}

/// `v`, a join, declared with nothing stored: the check refuses a path that reads it before setting it.
pub fn join_declared(pr: Printing, depth: Int, v: Var) -> Printing = {
  let n = named(pr, v);
  let ts = c_types(v.rep);
  let ns = part_names(n.name, v.rep);
  range(0, ts.len()).fold(n.pr, |q: Printing, k: Int|
    line(q, depth, Bytes::concat_all([nth(ts, k), b" ", nth(ns, k), b";"])))
}

/// `v`, declared, set to `a` value by value.
pub fn set_parts(pr: Printing, depth: Int, v: Var, a: Arg) -> Printing = {
  let ns = part_names(name_of(pr, v), v.rep);
  let xs = arg_parts(pr, a);
  range(0, ns.len()).fold(pr, |q: Printing, k: Int|
    line(q, depth, Bytes::concat_all([nth(ns, k), b" = ", nth(xs, k), b";"])))
}

/// What a root's entry does with `args[i]`, a parameter held as `r`, before it calls the root: the
/// C it runs, and the C expressions it hands the call. The word is opened as `word_parts` opens it;
/// a value crossing by reference is laid in a buffer of its words, whose address is handed on.
/// `values` are the C values it was opened into, which hold its counts.
pub fn entry_opened(
  i: Int,
  r: Rep,
) -> { text: List<Piece>, args: List<Bytes>, values: List<Bytes> } = {
  let arg = Bytes::concat_all([b"args[", ascii_of_int(i), b"]"]);
  let local = b"a".concat(ascii_of_int(i));
  let values = part_names(local, r);
  let opened = [Text(b"  ")].concat(word_parts(arg, r, values)).push(Text(b"\n"));
  match passing(r) {
    InWords -> { text: opened, args: values, values: values },
    ByReference -> {
      let laid = Bytes::concat_all([local, b"_r"]);
      {
        text: opened.push(
          Text(
            Bytes::concat_all([
              b"  Word ",
              laid,
              b"[] = {",
              Bytes::join(words_laid(values, values_of(r)), b", "),
              b"};\n",
            ]),
          ),
        ),
        args: [laid],
        values: values,
      }
    },
  }
}

/// What an entry hands a root answering as `r` to write its answer's values past the first into:
/// its buffer, where it has one.
pub fn entry_outs(r: Rep) -> List<Bytes> = if answer_buffer(r) > 0 { [b"ro"] } else { [] }

/// The entry's C from its call `call` of the root on: how a root answering as `r` hands back its
/// answer as a word, as `parts_word` makes it, each value past the first read out of the answer's
/// buffer. `after` is C the entry runs right after the call, before it tests the call's failure,
/// reading the answer's values as `entry_answer_values` names them.
pub fn entry_answered(
  pr: Printing,
  r: Rep,
  call: Bytes,
  after: List<Piece>,
) -> { pr: Printing, out: List<Piece> } = {
  let rest = values_of(r).drop(1);
  let outs = range(1, rest.len() + 1).map(|k: Int| b"r".concat(ascii_of_int(k)));
  let read = parts_read(b"ro", rest);
  let called = |first: Bytes|
    [
      Text(
        Bytes::concat_all([
          if answer_buffer(r) > 0 {
            Bytes::concat_all([b"  Word ro[", ascii_of_int(answer_buffer(r)), b"];\n"])
          } else { b"" },
          b"  ",
          first,
          b" r0 = ",
          call,
          b";\n",
        ]),
      ),
    ].concat(
      after,
    ).push(
      Text(
        Bytes::concat_all([
          b"  if (ctx->failed) return 0;\n",
          Bytes::concat_all(
            range(0, rest.len()).map(|k: Int|
              Bytes::concat_all([
                b"  ",
                one_type(match rest.at(k) { Some(x) -> x, None -> RWord }),
                b" ",
                nth(outs, k),
                b" = ",
                nth(read, k),
                b";\n",
              ])),
          ),
          b"  ",
        ]),
      ),
    );
  match r {
    RWord -> if after.len() == 0 {
      { pr: pr, out: [Text(Bytes::concat_all([b"  return ", call, b";\n"]))] }
    } else {
      {
        pr: pr,
        out: [Text(Bytes::concat_all([b"  Word r0 = ", call, b";\n"]))].concat(after).push(
          Text(b"  return r0;\n"),
        ),
      }
    },
    _ -> if in_box(r) {
      let w = parts_word(pr, b"rw", [b"r0"].concat(outs), r);
      {
        pr: w.pr,
        out: called(c_type(r)).concat(w.prep).push(
          Text(Bytes::concat_all([b"\n  return ", w.word, b";\n"])),
        ),
      }
    } else {
      {
        pr: pr,
        out: [Text(Bytes::concat_all([b"  ", c_type(r), b" r = ", call, b";\n"]))].concat(
          after,
        ).push(
          Text(
            Bytes::concat_all([
              b"  if (ctx->failed) return 0;\n  return ",
              if r == RUnit { b"0" } else { as_word(b"r", r) },
              b";\n",
            ]),
          ),
        ),
      }
    },
  }
}

/// The C values of an answer held as `r` right after an entry's call of the root, as
/// `entry_answered` names them: its first, and each past it where the root wrote it into the
/// entry's buffer.
pub fn entry_answer_values(r: Rep) -> List<Bytes> =
  if r == RWord { [b"r0"] }
  else if in_box(r) { [b"r0"].concat(parts_read(b"ro", values_of(r).drop(1))) }
  else { [b"r"] }

// The values this family prints.

/// A value made of `m.args`, in the cells `m.reuse` names where it names some: a box of words, a
/// boxed case, a constructor's object of each argument's word, or a record by value.
pub fn made(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  m: { made: Made, args: List<Arg>, reuse: Option<Var> },
) -> Printing / {abort.raise} =
  match into {
    None -> unprinted(Data, b"a value made that nothing holds", made_said(m.made)),
    Some(v) -> match m.made {
      MRecord(r) -> by_value(p, pr, v, r.names, m.args),
      MCtor(c) -> if m.args.len() == 0 { ctor_value(p, pr, v, c.name) }
      else { ctor_built(p, pr, v, c.name, m.args) },
      MBox(b) -> box_made(p, pr, v, None, b.words, m.args, m.reuse),
      MCase(c) ->
        box_made(
          p,
          pr,
          v,
          if c.skip > 0 { Some(c.case) } else { None },
          c.skip + c.words,
          m.args,
          m.reuse,
        ),
      other -> unprinted(Data, b"a value no printer of this family makes", made_said(other)),
    },
  }

/// A block of `n` words holding `args`' words one after another, which it takes, after the case's
/// place in its first word where `tag` gives one: in the cells `reuse` names where they are some,
/// and else allocated by its size.
fn box_made(
  p: Place,
  pr: Printing,
  v: Var,
  tag: Option<Int>,
  n: Int,
  args: List<Arg>,
  reuse: Option<Var>,
) -> Printing = {
  let nm = named(pr, v);
  let allocated = Bytes::concat_all([
    nm.name,
    b" = rt_alloc_bytes_p(ctx, ",
    int_lit(header_bytes() + 8 * n),
    b");",
  ]);
  let first = match tag { Some(_) -> 1, None -> 0 };
  let tagged = match tag {
    Some(c) -> [Bytes::concat_all([slot(nm.name, 0), b" = ", int_lit(c), b";"])],
    None -> [],
  };
  let writes = Bytes::join(
    tagged.concat(
      range(0, args.len()).fold(
        { at: first, out: [] },
        |acc: { at: Int, out: List<Bytes> }, k: Int| {
          let a = match args.at(k) { Some(x) -> x, None -> AZero(RWord) };
          let held = values_of(rep_of_arg(a));
          let ws = words_laid(arg_parts(pr, a), held);
          {
            at: acc.at + words_held(held),
            out: acc.out.concat(
              range(0, ws.len()).map(|j: Int|
                Bytes::concat_all([slot(nm.name, acc.at + j), b" = ", nth(ws, j), b";"])),
            ),
          }
        },
      ).out,
    ),
    b" ",
  );
  line(nm.pr, p.depth, match reuse {
    None -> Bytes::concat_all([b"Word ", allocated, b" ", writes]),
    Some(tok) ->
      Bytes::concat_all([
        b"Word ",
        nm.name,
        b" = ",
        name_of(pr, tok),
        b"; if (!",
        nm.name,
        b") ",
        allocated,
        b" ",
        writes,
      ]),
  })
}

/// A record of `names` holding the words `args`, which it takes, laid out by the runtime as the
/// values they are.
fn by_value(p: Place, pr: Printing, v: Var, names: List<Bytes>, args: List<Arg>) -> Printing = {
  let sh = shape_at(pr, names);
  let arr = temp(sh.pr);
  let n = named(arr.pr, v);
  let listed = line(
    n.pr,
    p.depth,
    Bytes::concat_all([b"Word ", arr.name, b"[] = {", words_of(n.pr, args), b"};"]),
  );
  pieces(listed, [
    Text(Bytes::concat_all([pad(p.depth), b"Word ", n.name, b" = rt_record_p(ctx, "])),
    Hole(ShapeOf(sh.at)),
    Text(
      Bytes::concat_all([
        b", (Word)(intptr_t)",
        arr.name,
        b", ",
        ascii_of_int(args.len()),
        b");\n",
      ]),
    ),
  ])
}

fn words_of(pr: Printing, args: List<Arg>) -> Bytes =
  if args.len() == 0 { b"0" }
  else { Bytes::join(args.map(|a: Arg| as_word(arg_text(pr, a), rep_of_arg(a))), b", ") }

/// A constructor read as a value: a nullary one's singleton, or another a function of its arguments.
fn ctor_value(p: Place, pr: Printing, v: Var, ctor: Bytes) -> Printing = {
  let n = named(pr, v);
  pieces(n.pr, [
    Text(Bytes::concat_all([pad(p.depth), b"Word ", n.name, b" = rt_ctor_value_p(ctx, "])),
    Hole(TagOf(ctor)),
    Text(b");\n"),
  ])
}

/// A constructor's object holding each of `args` as its word.
fn ctor_built(p: Place, pr: Printing, v: Var, ctor: Bytes, args: List<Arg>) -> Printing = {
  let n = named(pr, v);
  let arr = temp(n.pr);
  pieces(
    line(
      arr.pr,
      p.depth,
      Bytes::concat_all([b"Word ", arr.name, b"[] = {", words_of(pr, args), b"};"]),
    ),
    [
      Text(Bytes::concat_all([pad(p.depth), b"Word ", n.name, b" = rt_ctor_p(ctx, "])),
      Hole(TagOf(ctor)),
      Text(
        Bytes::concat_all([
          b", (Word)(intptr_t)",
          arr.name,
          b", ",
          ascii_of_int(args.len()),
          b");\n",
        ]),
      ),
    ],
  )
}

/// What `g.path` reads out of `g.of`, which the value read borrows: a value's leaf, its values where
/// the record's values hold them; a field's words at their offset in the box a record's word is; a
/// case's payload where the sum's layout lays it; a constructor's argument's word in its object. A
/// field read by name is the runtime's, which answers its word with a count of its own.
pub fn got(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  g: { of: Var, path: Path },
) -> Printing / {abort.raise} =
  match into {
    None -> pr,
    Some(v) -> {
      let base = name_of(pr, g.of);
      match g.path {
        PLeaf(k) -> match g.of.rep {
          RFlat(ls) -> {
            let at = leaf_values(ls, k);
            declared_as(p, pr, v, part_names(base, g.of.rep).drop(at.at).take(at.n))
          },
          _ -> declared_as(p, pr, v, [part_named(base, g.of.rep, k)]),
        },
        PField(f) -> if g.of.rep != RWord {
          unprinted(Data, b"a field read at its offset out of no word", var_said(g.of))
        } else { declared_as(p, pr, v, read_from(|k: Int| slot(base, f.at + k), v.rep)) },
        PArg(a) -> if g.of.rep != RWord {
          unprinted(Data, b"a constructor's argument read out of no object", var_said(g.of))
        } else { declared_as(p, pr, v, [word_as(slot(base, a.at), v.rep)]) },
        PNamed(name) -> by_name(p, pr, v, g.of, name),
        PCapture(k) ->
          unprinted(
            Data,
            b"a capture, which a closure's printer reads",
            Bytes::concat_all([b"capture ", ascii_of_int(k), b" of ", var_said(g.of)]),
          ),
        PCase(c) -> match g.of.rep {
          RSum(s) ->
            declared_as(
              p,
              pr,
              v,
              case_read(s.laid, part_names(base, g.of.rep), c.case, c.at, v.rep),
            ),
          _ -> unprinted(Data, b"a case's payload read out of no sum", var_said(g.of)),
        },
        PPayload -> payload_printed(p, pr, v, g.of),
        _ -> unprinted(Data, b"a read no printer of this family makes", var_said(g.of)),
      }
    },
  }

/// `v`, field `name` of the word `of` as the runtime reads it by name, with a count of its own, and
/// read as `v` holds it.
fn by_name(p: Place, pr: Printing, v: Var, of: Var, name: Bytes) -> Printing / {abort.raise} =
  if of.rep != RWord { unprinted(Data, b"a field read by name out of no word", var_said(of)) }
  else {
    let f = field_hole(pr, name);
    let into = if v.rep == RWord { named(f.pr, v) } else { temp(f.pr) };
    let fetched = check(
      p,
      pieces(into.pr, [
        Text(
          Bytes::concat_all([
            pad(p.depth),
            b"Word ",
            into.name,
            b" = rt_field_p(ctx, ",
            name_of(pr, of),
            b", ",
          ]),
        ),
        f.piece,
        Text(b", 0);\n"),
      ]),
    );
    if v.rep == RWord { fetched } else {
      let n = named(fetched, v);
      pieces(
        n.pr,
        [Text(pad(p.depth))].concat(word_parts(into.name, v.rep, part_names(n.name, v.rep))).push(
          Text(b"\n"),
        ),
      )
    }
  }

/// `v` declared holding `exprs`, one per C value.
pub fn declared_as(p: Place, pr: Printing, v: Var, exprs: List<Bytes>) -> Printing = {
  let n = named(pr, v);
  let ts = c_types(v.rep);
  let ns = part_names(n.name, v.rep);
  range(0, ns.len()).fold(n.pr, |q: Printing, k: Int|
    line(
      q,
      p.depth,
      Bytes::concat_all([nth(ts, k), b" ", nth(ns, k), b" = ", nth(exprs, k), b";"]),
    ))
}

/// Whether the word form of a value held as `r` is a box of its words: a record's, and a sum's of
/// more than one word.
pub fn in_box(r: Rep) -> Bool =
  match r { RFlat(_) -> true, RSum(_) -> values_of(r).len() > 1, _ -> false }

/// The word form of a value held as `r` whose C values are named `parts`, made in `name` where it
/// is made: a record's or a wider sum's words laid in a box made of them, which takes their counts;
/// 0 for a value of no words; a scalar boxed; any other value of one word that word.
pub fn parts_word(
  pr: Printing,
  name: Bytes,
  parts: List<Bytes>,
  r: Rep,
) -> { pr: Printing, prep: List<Piece>, word: Bytes } =
  if in_box(r) {
    let ws = words_laid(parts, values_of(r));
    {
      pr: pr,
      prep: [
        Text(
          Bytes::concat_all([
            b"Word ",
            name,
            b" = rt_alloc_bytes_p(ctx, ",
            int_lit(header_bytes() + 8 * ws.len()),
            b");",
            Bytes::concat_all(
              range(0, ws.len()).map(|k: Int|
                Bytes::concat_all([b" ", slot(name, k), b" = ", nth(ws, k), b";"])),
            ),
          ]),
        ),
      ],
      word: name,
    }
  } else if r == RUnit { { pr: pr, prep: [], word: b"0" } }
  else { { pr: pr, prep: [], word: as_word(nth(parts, 0), r) } }

/// C declaring `into`, the names of the C values of a value held as `r`, from the word form `word`,
/// which it takes: a record's or a wider sum's words read out of its box, the box freed where it
/// held its last count and each counted word held once more where it did not; a value of no words
/// nothing; a scalar read out and the word let go; a value of one word that word.
pub fn word_parts(word: Bytes, r: Rep, into: List<Bytes>) -> List<Piece> =
  if in_box(r) {
    let held = values_of(r);
    let read = parts_read(Bytes::concat_all([b"ply_words(", word, b")"]), held);
    let n = words_held(held);
    let dups = dups_of(r, into);
    [
      Text(
        Bytes::concat_all([
          Bytes::concat_all(
            range(0, held.len()).map(|k: Int|
              Bytes::concat_all([
                one_type(match held.at(k) { Some(h) -> h, None -> RWord }),
                b" ",
                nth(into, k),
                b" = ",
                nth(read, k),
                b"; ",
              ])),
          ),
          b"if (ply_last(ctx, ",
          word,
          b")) ply_free(ctx, ",
          word,
          b", ",
          int_lit(header_bytes() + 8 * n),
          b");",
          if dups.len() == 0 { b"" } else { Bytes::concat_all([b" else { ", dups, b" }"]) },
        ]),
      ),
    ]
  } else {
    match r {
      RUnit -> [],
      RInt -> scalar_read(word, r, into),
      RBool -> scalar_read(word, r, into),
      RNum(_) -> scalar_read(word, r, into),
      RFloat -> scalar_read(word, r, into),
      RDec -> scalar_read(word, r, into),
      _ -> [Text(Bytes::concat_all([b"Word ", nth(into, 0), b" = ", word, b";"]))],
    }
  }

fn scalar_read(word: Bytes, r: Rep, into: List<Bytes>) -> List<Piece> =
  [
    Text(
      Bytes::concat_all([
        c_type(r),
        b" ",
        nth(into, 0),
        b" = ",
        word_as(word, r),
        b"; ply_dec(ctx, ",
        word,
        b");",
      ]),
    ),
  ]

/// The C counting once more each counted word of a value held as `r` whose C values are named `ws`:
/// a pointer leaf's word, and a sum's words as the case it holds counts them.
pub fn dups_of(r: Rep, ws: List<Bytes>) -> Bytes =
  match r {
    RFlat(ls) ->
      Bytes::join(
        range(0, ls.len()).fold([], |acc: List<Bytes>, k: Int| {
          let at = leaf_values(ls, k);
          let mine = ws.drop(at.at).take(at.n);
          let d = match ls.at(k) {
            Some(l) -> match l.rep {
              RWord -> Bytes::concat_all([b"ply_dup(", nth(mine, 0), b");"]),
              RSum(s) -> sum_dups(s.laid, mine),
              _ -> b"",
            },
            None -> b"",
          };
          if d.len() == 0 { acc } else { acc.push(d) }
        }),
        b" ",
      ),
    RSum(s) -> sum_dups(s.laid, ws),
    RWord -> Bytes::concat_all([b"ply_dup(", nth(ws, 0), b");"]),
    _ -> b"",
  }

/// The C counting once more each counted word of a sum laid as `s` whose words are `ws`: by their
/// classes where no word's class depends on the case, and otherwise by the case it holds.
fn sum_dups(s: SumLaid, ws: List<Bytes>) -> Bytes =
  if !s.classes.any(|c: layout::WordClass| c == U) { classes_dups(s.classes, ws) } else {
    let arms = range(0, s.cases.len()).fold([], |acc: List<Bytes>, i: Int| {
      let d = match s.cases.at(i) {
        Some(c) -> match c.payload {
          Nullary -> b"",
          Inline(l) -> {
            let own = range(0, words(l.laid)).map(|k: Int| {
              let w = nth(ws, l.offset + k);
              if l.stripped == Some(l.offset + k) { masked(w) } else { w }
            });
            laid_dups(l.laid, own)
          },
          Boxed(b) -> {
            let w = nth(ws, b.at);
            Bytes::concat_all([b"ply_dup(", if b.stripped { masked(w) } else { w }, b");"])
          },
        },
        None -> b"",
      };
      if d.len() == 0 { acc }
      else { acc.push(Bytes::concat_all([b"case ", ascii_of_int(i), b": ", d, b" break;"])) }
    });
    if arms.len() == 0 { b"" } else {
      Bytes::concat_all([b"switch (", case_held(s, ws), b") { ", Bytes::join(arms, b" "), b" }"])
    }
  }

/// The C counting once more each counted word of a value laid as `l` whose words are `ws`.
fn laid_dups(l: Laid, ws: List<Bytes>) -> Bytes =
  match l {
    LWords(cs) -> classes_dups(cs, ws),
    LRecord(fs) ->
      Bytes::join(
        fs.map(|f: layout::FieldLaid| laid_dups(f.laid, ws.drop(f.at).take(words(f.laid)))).filter(
          |d: Bytes| d.len() > 0,
        ),
        b" ",
      ),
    LSum(s) -> sum_dups(s, ws),
  }

/// The C counting once more each word of classes `cs` that holds a count: a pointer, and a sum's
/// word over pointers where it is one.
fn classes_dups(cs: List<layout::WordClass>, ws: List<Bytes>) -> Bytes =
  Bytes::join(
    range(0, cs.len()).fold([], |acc: List<Bytes>, k: Int|
      match cs.at(k) {
        Some(P) -> acc.push(Bytes::concat_all([b"ply_dup(", nth(ws, k), b");"])),
        Some(S(_)) -> {
          let w = nth(ws, k);
          acc.push(
            Bytes::concat_all([
              b"if ((uint64_t)",
              w,
              b" >= ",
              int_lit(pointer_floor()),
              b") ply_dup(",
              masked(w),
              b");",
            ]),
          )
        },
        _ -> acc,
      }),
    b" ",
  )

fn masked(w: Bytes) -> Bytes =
  Bytes::concat_all([b"((", w, b") & ~(Word)", ascii_of_int((1 << tag_bits()) - 1), b")"])

/// `parts`, gathered into `v`: a record's fields' values in order, a sum's case's place and then its
/// arguments, laid as its layout says; any other value's parts value by value.
pub fn gathered(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  parts: List<Arg>,
) -> Printing / {abort.raise} =
  match into {
    None ->
      unprinted(
        Data,
        b"a gathered value that nothing holds",
        Bytes::concat_all([ascii_of_int(parts.len()), b" parts"]),
      ),
    Some(v) -> match v.rep {
      RSum(s) -> match parts.at(0) {
        Some(AInt(i)) -> declared_as(p, pr, v, case_laid(pr, s.laid, i, parts.drop(1))),
        _ -> unprinted(Data, b"a sum gathered from no case's place", var_said(v)),
      },
      RWord ->
        unprinted(
          Data,
          b"a case of a sum whose layout a type variable leaves open, which only its callers' specialisations lay out",
          var_said(v),
        ),
      _ ->
        declared_as(
          p,
          pr,
          v,
          parts.fold([], |acc: List<Bytes>, a: Arg| acc.concat(arg_parts(pr, a))),
        ),
    },
  }

/// The C values of case `i` of a sum laid as `s` holding `payload`, its arguments in order: the
/// value its test reads, the payload's words where the case lays them (a box's word where the case is
/// boxed), the low bits of a tagged pointer set, every other word zero.
fn case_laid(pr: Printing, s: SumLaid, i: Int, payload: List<Arg>) -> List<Bytes> = {
  let n = words(LSum(s));
  let blank = range(0, n).map(|_: Int| b"0");
  let put = |ws: List<Bytes>, at: Int, e: Bytes|
    range(0, ws.len()).map(|k: Int| if k == at { e } else { nth(ws, k) });
  let laid = match s.cases.at(i) {
    None -> blank,
    Some(c) -> {
      let tagged = |e: Bytes|
        match c.test {
          LowBits(t) -> if t.bits == 0 { e }
          else { Bytes::concat_all([b"((Word)(", e, b") | ", int_lit(t.bits), b")"]) },
          _ -> e,
        };
      let tested = match c.test { WordIs(t) -> put(blank, t.at, int_lit(t.value)), _ -> blank };
      match c.payload {
        Nullary -> tested,
        Inline(l) -> {
          let ws = payload.fold([], |acc: List<Bytes>, a: Arg|
            acc.concat(words_laid(arg_parts(pr, a), values_of(rep_of_arg(a)))));
          range(0, n).map(|k: Int| {
            let j = k - l.offset;
            if j < 0 || j >= ws.len() { nth(tested, k) }
            else if l.stripped == Some(k) { tagged(nth(ws, j)) }
            else { nth(ws, j) }
          })
        },
        Boxed(b) -> {
          let w = match payload.at(0) { Some(a) -> nth(arg_parts(pr, a), 0), None -> b"0" };
          put(tested, b.at, if b.stripped { tagged(w) } else { w })
        },
      }
    },
  };
  laid
}

/// The C values of a value held as `r` whose words are `word(0)`, `word(1)`, ..: each read out of its
/// words as `words_laid` lays them.
fn read_from(word: (Int) -> Bytes, r: Rep) -> List<Bytes> = values_read(word, values_of(r))

/// The C values, held as `vs`, whose words are `word(0)`, `word(1)`, .., as `words_laid` lays them.
fn values_read(word: (Int) -> Bytes, vs: List<Rep>) -> List<Bytes> =
  vs.fold({ at: 0, out: [] }, |acc: { at: Int, out: List<Bytes> }, h: Rep|
    {
      at: acc.at + words_held([h]),
      out: acc.out.push(match h {
        RFloat -> Bytes::concat_all([b"ply_f64(", word(acc.at), b")"]),
        RDec -> Bytes::concat_all([b"(PlyDec){", word(acc.at), b", ", word(acc.at + 1), b"}"]),
        RUnit -> b"0",
        RWord -> word(acc.at),
        _ -> Bytes::concat_all([b"(", one_type(h), b")", word(acc.at)]),
      }),
    }).out

/// The C values of a value held as `r` read out of case `case` of the sum laid as `s` whose C values
/// are `ws`, from word `at` of the case's payload: in the sum's own words, a tagged word's pointer
/// masked, or in its box, past the box's tag words.
fn case_read(s: SumLaid, ws: List<Bytes>, case: Int, at: Int, r: Rep) -> List<Bytes> =
  match s.cases.at(case) {
    Some(c) -> match c.payload {
      Inline(l) ->
        read_from(
          |k: Int| {
            let w = l.offset + at + k;
            if l.stripped == Some(w) { masked(nth(ws, w)) } else { nth(ws, w) }
          },
          r,
        ),
      Boxed(b) -> {
        let base = if b.stripped { masked(nth(ws, b.at)) } else { nth(ws, b.at) };
        read_from(|k: Int| slot(base, b.skip + at + k), r)
      },
      Nullary -> read_from(|_: Int| b"0", r),
    },
    None -> read_from(|_: Int| b"0", r),
  }

/// The static constant `name`, its object laid out by the unit, as its word.
pub fn statics(p: Place, pr: Printing, into: Option<Var>, name: Bytes) -> Printing =
  match into {
    None -> pr,
    Some(v) -> declared_as(p, pr, v, [Bytes::concat_all([b"(Word)(intptr_t)&", name])]),
  }

fn nth(xs: List<Bytes>, k: Int) -> Bytes = match xs.at(k) { Some(x) -> x, None -> b"0" }

fn point() -> Rep = RFlat([{ name: b"x", rep: RFloat }, { name: b"y", rep: RFloat }])

fn place() -> Place =
  {
    u: {
      symbol: b"f",
      base: 0,
      answer: RWord,
      site: None,
      arm: None,
      looping: None,
      landing: None,
      group: None,
      leaving: b"ctx->fuel += 1;",
    },
    at: span_between(0, 0),
    leave: b"return 0;",
    depth: 0,
  }

fn local(id: Int, rep: Rep) -> Var = { id: id, ty: TyCon({ name: b"T", args: [] }), rep: rep }

fn sum_args(args: List<Laid>) -> CaseArgs = { args: record_laid(args), indirect: false }

fn pointer_laid() -> Laid = LWords([P])

/// An `Option<Int>`'s layout, a tag word and the payload, and an `Option<String>`'s, its one word.
fn tagged_sum() -> Rep =
  RSum({ laid: sum_laid([sum_args([]), sum_args([LWords([raw()])])]), cases: [b"None", b"Some"] })

fn pointer_sum() -> Rep =
  RSum({ laid: sum_laid([sum_args([]), sum_args([pointer_laid()])]), cases: [b"None", b"Some"] })

fn given(reps: List<Rep>, answer: Rep) -> Convention =
  { params: reps.map(|_: Rep| Given), reps: reps, answer: answer, answered: Owned }

test "a small record crosses a call as its leaves, and answers its first leaf" {
  assert_eq(c_types(point()), [b"double", b"double"]);
  assert_eq(head_types(given([point(), point()], point())), {
    answer: b"double",
    params: [b"double", b"double", b"double", b"double", b"Word*"],
  });
  assert_eq(head_params(given([RInt], point())), [b"int64_t p0", b"Word* o"]);
  // A sum crosses as its words, and a value of no words as none, answering a word of 0.
  assert_eq([tagged_sum(), pointer_sum(), RUnit].map(c_types), [[b"Word", b"Word"], [b"Word"], []]);
  assert_eq(head_types(given([RUnit, RInt], RUnit)), { answer: b"Word", params: [b"int64_t"] })
}

test "a record wider than four words crosses as the address of its words" {
  let reps = [RFloat, RDec, RInt, RWord, RInt];
  let wide = RFlat(reps.map(|r: Rep| { name: b"f", rep: r }));
  assert_eq(head_types(given([wide], RInt)), { answer: b"int64_t", params: [b"Word*"] });
  assert_eq(head_params(given([wide, RInt], RInt)), [b"Word* p0", b"int64_t p1"]);
  // One lent is only read: its words are the caller's.
  assert_eq(head_params({ ..given([wide, RInt], RInt), params: [Lent, Lent] }), [
    b"const Word* p0",
    b"int64_t p1",
  ]);
  // The callee opens the words into its own C values, which take their counts.
  assert_eq(params_opened([b"p0", b"p1"], [wide, RInt]), [
    b"double p0_0 = ply_f64(p0[0]); PlyDec p0_1 = (PlyDec){p0[1], p0[2]}; int64_t p0_2 = (int64_t)p0[3]; Word p0_3 = p0[4]; int64_t p0_4 = (int64_t)p0[5];",
  ]);
  let exprs = [b"e0", b"e1", b"e2", b"e3", b"e4"];
  assert_eq(words_laid(exprs, reps), [
    b"ply_f64_bits(e0)",
    b"(e1).lo",
    b"(e1).hi",
    b"(Word)(e2)",
    b"e3",
    b"(Word)(e4)",
  ]);
  assert_eq(parts_read(b"b", reps).len(), reps.len());
  // The runtime's entry lays the opened values in a buffer and hands its address.
  let entered = entry_opened(0, wide);
  assert(
    spelled(entered.text).index_of(b"Word a0_r[] = {ply_f64_bits(a0_0), (a0_1).lo, (a0_1).hi,")
      != None,
    None,
  );
  assert_eq(entered.args, [b"a0_r"]);
  assert_eq(entry_opened(1, point()).args.len(), 2)
}

test "an answer of several values returns its first and writes the rest into one buffer" {
  let pr = printing(Map::new().insert(0, b"p0"));
  let r = returned(pr, 0, AVar(local(0, point())));
  assert_eq(r.value, b"p0_0");
  let text = spelled(r.pr.out);
  assert(
    text.index_of(b"o[0] = ply_f64_bits(p0_1);") != None && text.index_of(b"o[1]") == None,
    None,
  );
  assert_eq(answer_parts(b"t", b"buf", point()), [b"t", b"ply_f64(buf[0])"]);
  assert_eq(entry_outs(point()), [b"ro"]);
  assert_eq(entry_outs(RInt), []);
  let answered = spelled(entry_answered(pr, point(), b"f(ctx)", []).out);
  assert(
    answered.index_of(
        b"Word ro[1];\n  double r0 = f(ctx);\n  if (ctx->failed) return 0;\n  double r1 = ply_f64(ro[0]);\n",
      )
      != None
      && answered.index_of(b"Word rw = rt_alloc_bytes_p(ctx, INT64_C(32));") != None,
    Some(String::of_bytes_lossy(answered)),
  );
  // An answer of no words is a word of 0.
  assert(spelled(entry_answered(pr, RUnit, b"f(ctx)", []).out).index_of(b"return 0;\n") != None)
}

test "a sum of one word is its word form, and a wider one's words are counted again by its case" {
  assert_eq(spelled(word_parts(b"x", pointer_sum(), [b"o"])), b"Word o = x;");
  assert_eq(parts_word(printing(Map::new()), b"w", [b"o"], pointer_sum()).word, b"o");
  // An `Option<Int>` counts nothing; a `Result` of an `Int` or a string counts its pointer's case.
  assert_eq(dups_of(tagged_sum(), [b"t", b"n"]), b"");
  let either = RSum({
    laid: sum_laid([sum_args([LWords([raw()])]), sum_args([pointer_laid()])]),
    cases: [b"Ok", b"Err"],
  });
  assert_eq(
    dups_of(either, [b"t", b"x"]),
    b"switch (((t) == INT64_C(0) ? INT64_C(0) : INT64_C(1))) { case 1: ply_dup(x); break; }",
  );
  assert_eq(word_parts(b"x", RUnit, []), [])
}

test "a sum's case is gathered as its test's value, its payload where the case lays it, and zero elsewhere" {
  let pr = printing(Map::new().insert(0, b"p0").insert(1, b"p1"));
  let p = AVar(local(0, RWord));
  let maybe = sum_laid([sum_args([]), sum_args([pointer_laid()])]);
  assert_eq([case_laid(pr, maybe, 0, []), case_laid(pr, maybe, 1, [p])], [
    [b"INT64_C(0)"],
    [b"p0"],
  ]);
  // A tagged pointer's case sets its low bits.
  let result = sum_laid([sum_args([pointer_laid()]), sum_args([pointer_laid()])]);
  assert_eq(case_laid(pr, result, 1, [p]), [b"((Word)(p0) | INT64_C(1))"]);
  // A tag word's case is its place, the payload after it.
  let tagged = sum_laid([sum_args([]), sum_args([LWords([raw()])])]);
  assert_eq(case_laid(pr, tagged, 1, [AVar(local(1, RInt))]), [b"INT64_C(1)", b"(Word)(p1)"]);
  assert_eq(case_laid(pr, tagged, 0, []), [b"INT64_C(0)", b"0"]);
  // A boxed case past the eighth holds its box's word, tagged 7.
  let nine = sum_laid(
    range(0, 9).map(|_: Int| { args: record_laid([pointer_laid()]), indirect: true }),
  );
  assert_eq(case_laid(pr, nine, 8, [p]), [b"((Word)(p0) | INT64_C(7))"])
}

test "a record is gathered from its fields' values, a record among them giving its leaves' values" {
  let pr = printing(Map::new().insert(0, b"p0").insert(1, b"p1"));
  let inner = local(0, point());
  let text = spelled(
    gathered(
      place(),
      pr,
      Some(
        local(
          2,
          RFlat([
            { name: b"p.x", rep: RFloat },
            { name: b"p.y", rep: RFloat },
            { name: b"n", rep: RInt },
          ]),
        ),
      ),
      [AVar(inner), AVar(local(1, RInt))],
    ).out,
  );
  assert_eq(text, b"  double t1_0 = p0_0;\n  double t1_1 = p0_1;\n  int64_t t1_2 = p1;\n")
}

test "a case's payload is read where the case lays it: a word masked, after a tag word, or in a box" {
  let result = sum_laid([sum_args([pointer_laid()]), sum_args([pointer_laid()])]);
  assert_eq(case_read(result, [b"x"], 1, 0, RWord), [b"((x) & ~(Word)7)"]);
  let tagged = sum_laid([sum_args([]), sum_args([LWords([raw()]), LWords([raw()])])]);
  assert_eq(case_read(tagged, [b"x_0", b"x_1", b"x_2", b"x_3"], 1, 1, RInt), [b"(int64_t)x_2"]);
  // A field of two words read whole is a projection of them.
  assert_eq(
    case_read(
      tagged,
      [b"x_0", b"x_1", b"x_2", b"x_3"],
      1,
      0,
      RFlat([{ name: b"a", rep: RInt }, { name: b"b", rep: RFloat }]),
    ),
    [b"(int64_t)x_1", b"ply_f64(x_2)"],
  );
  let nine = sum_laid(
    range(0, 9).map(|_: Int| { args: record_laid([pointer_laid()]), indirect: true }),
  );
  assert_eq(case_read(nine, [b"x"], 8, 0, RWord), [b"ply_words(((x) & ~(Word)7))[1]"])
}

test "a box is allocated by its size and its words written, a boxed case's place first past the eighth" {
  let pr = printing(Map::new().insert(0, b"p0").insert(1, b"p1"));
  let m = {
    made: MCase({ case: 8, skip: 1, words: 1 }),
    args: [AVar(local(0, RWord))],
    reuse: None,
  };
  assert_eq(
    spelled(made(place(), pr, Some(local(2, RWord)), m).out),
    b"  Word t1 = rt_alloc_bytes_p(ctx, INT64_C(32)); ply_words(t1)[0] = INT64_C(8); ply_words(t1)[1] = p0;\n",
  );
  // In the cells a reset kept it is written as in a fresh block, which it is where the reset kept none.
  let reused = {
    made: MCase({ case: 1, skip: 0, words: 2 }),
    args: [AVar(local(0, RWord)), AVar(local(1, RInt))],
    reuse: Some(local(3, RToken(2))),
  };
  let text = spelled(
    made(place(), { ..pr, names: pr.names.insert(3, b"p3") }, Some(local(2, RWord)), reused).out,
  );
  assert(
    text.index_of(
        b"Word t1 = p3; if (!t1) t1 = rt_alloc_bytes_p(ctx, INT64_C(32)); ply_words(t1)[0] = p0; ply_words(t1)[1] = (Word)(p1);",
      )
      != None,
    Some(String::of_bytes_lossy(text)),
  )
}
