pub fn c_type(r: Representation) -> Bytes =
  match c_values_of(r).at(0) { Some(v) -> one_type(v), None -> b"Word" }

pub fn c_types(r: Representation) -> List<Bytes> = c_values_of(r).map(one_type)

fn one_type(r: Representation) -> Bytes =
  match r {
    AsInt -> kind_c_type(IntKind),
    AsBool -> kind_c_type(BoolKind),
    AsFixed(w) -> kind_c_type(SizedIntKind(w)),
    AsFloat -> kind_c_type(FloatKind),
    AsDecimal -> kind_c_type(DecimalKind),
    AsWideFixed(w) -> kind_c_type(WideKind(w)),
    _ -> b"Word",
  }

pub fn zeros(r: Representation) -> List<Bytes> = c_values_of(r).map(zero)

pub fn arg_parts(printing: Printing, a: Arg) -> List<Bytes> =
  match a {
    VariableOperand(v) -> part_names(name_of(printing, v), v.representation),
    ZeroOperand(r) -> zeros(r),
    _ -> [arg_text(printing, a)],
  }

fn two_words(e: Bytes) -> Bytes =
  Bytes::concat_all([b"ply_two_words(ctx, (", e, b").lo, (", e, b").hi)"])

pub fn as_word(e: Bytes, r: Representation) -> Bytes =
  match r {
    AsInt -> Bytes::concat_all([b"(Word)(", e, b")"]),
    AsBool -> Bytes::concat_all([b"(Word)(", e, b")"]),
    AsFloat -> Bytes::concat_all([b"(Word)ply_f64_bits(", e, b")"]),
    AsDecimal -> two_words(e),
    AsWideFixed(_) -> two_words(e),
    AsFixed(_) -> Bytes::concat_all([b"(Word)(", e, b")"]),
    AsSum(s) -> if layout::raw_sum(s.layout) { Bytes::concat_all([b"(Word)(", e, b")"]) }
    else { e },
    _ -> e,
  }

pub fn word_as(w: Bytes, r: Representation) -> Bytes =
  match r {
    AsInt -> Bytes::concat_all([b"(int64_t)(", w, b")"]),
    AsBool -> Bytes::concat_all([b"((", w, b") != 0)"]),
    AsFloat -> Bytes::concat_all([b"ply_f64(", w, b")"]),
    AsDecimal -> Bytes::concat_all([b"ply_dec_of(", w, b")"]),
    AsWideFixed(_) -> Bytes::concat_all([b"ply_wide_of(", w, b")"]),
    AsFixed(n) -> Bytes::concat_all([b"(", kind_c_type(SizedIntKind(n)), b")(", w, b")"]),
    _ -> w,
  }

pub fn signature_types(c: Convention) -> { result: Bytes, params: List<Bytes> } =
  {
    result: c_type(c.result),
    params: range(0, c.params.len()).fold([], |accumulator: List<Bytes>, i: Int|
      match param_rep(c, i) {
        Some(r) ->
          accumulator.concat(match passing(r) {
            ByReference -> if param_borrowed(c, i) { [b"const Word*"] } else { [b"Word*"] },
            ByValue -> c_types(r),
          }),
        None -> accumulator,
      }).concat(if return_buffer_words(c.result) > 0 { [b"Word*"] } else { [] }).concat(
      if c.destination_passing { [b"Word"] } else { [] },
    ),
  }

pub fn signature_parameters(c: Convention) -> List<Bytes> = {
  let types = signature_types(c).params;
  let names = signature_names(c);
  range(0, types.len()).map(|k: Int|
    Bytes::concat_all([nth_or_zero(types, k), b" ", nth_or_zero(names, k)]))
}

pub fn signature_names(c: Convention) -> List<Bytes> =
  range(0, c.params.len()).fold([], |accumulator: List<Bytes>, i: Int|
    match param_rep(c, i) {
      Some(r) -> {
        let name = b"p".concat(ascii_of_int(i));
        accumulator.concat(match passing(r) {
          ByReference -> [name],
          ByValue -> part_names(name, r),
        })
      },
      None -> accumulator,
    }).concat(if return_buffer_words(c.result) > 0 { [b"o"] } else { [] }).concat(
    if c.destination_passing { [b"d"] } else { [] },
  )

pub fn params_opened(names: List<Bytes>, reps: List<Representation>) -> List<Bytes> =
  range(0, reps.len()).fold([], |accumulator: List<Bytes>, i: Int|
    match reps.at(i) {
      Some(r) -> match passing(r) {
        ByValue -> accumulator,
        ByReference -> {
          let name = nth_or_zero(names, i);
          let c_values = c_values_of(r);
          let ns = part_names(name, r);
          let read = parts_read(name, c_values);
          accumulator.push(
            Bytes::join(
              range(0, c_values.len()).map(|k: Int|
                Bytes::concat_all([
                  one_type(match c_values.at(k) { Some(h) -> h, None -> AsWord }),
                  b" ",
                  nth_or_zero(ns, k),
                  b" = ",
                  nth_or_zero(read, k),
                  b";",
                ])),
              b" ",
            ),
          )
        },
      },
      None -> accumulator,
    })

pub fn values_as_words(expressions: List<Bytes>, reps: List<Representation>) -> List<Bytes> =
  range(0, reps.len()).fold([], |accumulator: List<Bytes>, k: Int| {
    let e = nth_or_zero(expressions, k);
    accumulator.concat(match reps.at(k) {
      Some(AsFloat) -> [Bytes::concat_all([b"ply_f64_bits(", e, b")"])],
      Some(AsDecimal) ->
        [Bytes::concat_all([b"(", e, b").lo"]), Bytes::concat_all([b"(", e, b").hi"])],
      Some(AsWideFixed(_)) ->
        [Bytes::concat_all([b"(", e, b").lo"]), Bytes::concat_all([b"(", e, b").hi"])],
      Some(AsUnit) -> [],
      Some(AsWord) -> [e],
      _ -> [Bytes::concat_all([b"(Word)(", e, b")"])],
    })
  })

pub fn parts_read(base: Bytes, reps: List<Representation>) -> List<Bytes> =
  values_read(|k: Int| Bytes::concat_all([base, b"[", ascii_of_int(k), b"]"]), reps)

pub fn result_parts(first: Bytes, base: Bytes, r: Representation) -> List<Bytes> =
  [first].concat(parts_read(base, c_values_of(r).drop(1)))

pub fn write_return_value(
  printing: Printing,
  depth: Int,
  a: Arg,
) -> { printing: Printing, value: Bytes } = {
  let ps = arg_parts(printing, a);
  let ws = values_as_words(ps.drop(1), c_values_of(operand_representation(a)).drop(1));
  {
    printing: range(0, ws.len()).fold(printing, |q: Printing, k: Int|
      line(
        q,
        depth,
        Bytes::concat_all([b"o[", ascii_of_int(k), b"] = ", nth_or_zero(ws, k), b";"]),
      )),
    value: nth_or_zero(ps, 0),
  }
}

pub fn declare_zeroed(printing: Printing, depth: Int, v: Variable) -> Printing = {
  let n = named(printing, v);
  let ts = c_types(v.representation);
  let ns = part_names(n.name, v.representation);
  let zs = zeros(v.representation);
  range(0, ts.len()).fold(n.printing, |q: Printing, k: Int|
    line(
      q,
      depth,
      Bytes::concat_all([
        nth_or_zero(ts, k),
        b" ",
        nth_or_zero(ns, k),
        b" = ",
        nth_or_zero(zs, k),
        b";",
      ]),
    ))
}

pub fn join_declared(printing: Printing, depth: Int, v: Variable) -> Printing = {
  let n = named(printing, v);
  let ts = c_types(v.representation);
  let ns = part_names(n.name, v.representation);
  range(0, ts.len()).fold(n.printing, |q: Printing, k: Int|
    line(q, depth, Bytes::concat_all([nth_or_zero(ts, k), b" ", nth_or_zero(ns, k), b";"])))
}

pub fn set_parts(printing: Printing, depth: Int, v: Variable, a: Arg) -> Printing = {
  let ns = part_names(name_of(printing, v), v.representation);
  let xs = arg_parts(printing, a);
  range(0, ns.len()).fold(printing, |q: Printing, k: Int|
    line(q, depth, Bytes::concat_all([nth_or_zero(ns, k), b" = ", nth_or_zero(xs, k), b";"])))
}

pub fn entry_opened(
  i: Int,
  r: Representation,
) -> { text: List<Piece>, args: List<Bytes>, values: List<Bytes> } = {
  let arg = Bytes::concat_all([b"args[", ascii_of_int(i), b"]"]);
  let local = b"a".concat(ascii_of_int(i));
  let values = part_names(local, r);
  let opened = [Text(b"  ")].concat(word_to_parts(arg, r, values)).push(Text(b"\n"));
  match passing(r) {
    ByValue -> { text: opened, args: values, values: values },
    ByReference -> {
      let laid = Bytes::concat_all([local, b"_r"]);
      {
        text: opened.push(
          Text(
            Bytes::concat_all([
              b"  Word ",
              laid,
              b"[] = {",
              Bytes::join(values_as_words(values, c_values_of(r)), b", "),
              b"};\n",
            ]),
          ),
        ),
        args: [laid],
        values: values,
      }
    },
  }
}

pub fn entry_outs(r: Representation) -> List<Bytes> =
  if return_buffer_words(r) > 0 { [b"ro"] } else { [] }

pub fn entry_result(
  printing: Printing,
  r: Representation,
  call: Bytes,
  after: List<Piece>,
) -> { printing: Printing, out: List<Piece> } = {
  let rest = c_values_of(r).drop(1);
  let outs = range(1, rest.len() + 1).map(|k: Int| b"r".concat(ascii_of_int(k)));
  let read = parts_read(b"ro", rest);
  let called = |first: Bytes|
    [
      Text(
        Bytes::concat_all([
          if return_buffer_words(r) > 0 {
            Bytes::concat_all([b"  Word ro[", ascii_of_int(return_buffer_words(r)), b"];\n"])
          } else { b"" },
          b"  ",
          first,
          b" r0 = ",
          call,
          b";\n",
        ]),
      ),
    ].concat(
      after,
    ).push(
      Text(
        Bytes::concat_all([
          b"  if (ctx->failed) return 0;\n",
          Bytes::concat_all(
            range(0, rest.len()).map(|k: Int|
              Bytes::concat_all([
                b"  ",
                one_type(match rest.at(k) { Some(x) -> x, None -> AsWord }),
                b" ",
                nth_or_zero(outs, k),
                b" = ",
                nth_or_zero(read, k),
                b";\n",
              ])),
          ),
          b"  ",
        ]),
      ),
    );
  match r {
    AsWord -> if after.len() == 0 {
      { printing: printing, out: [Text(Bytes::concat_all([b"  return ", call, b";\n"]))] }
    } else {
      {
        printing: printing,
        out: [Text(Bytes::concat_all([b"  Word r0 = ", call, b";\n"]))].concat(after).push(
          Text(b"  return r0;\n"),
        ),
      }
    },
    _ -> if is_boxed(r) {
      let w = parts_to_word(printing, b"rw", [b"r0"].concat(outs), r);
      {
        printing: w.printing,
        out: called(c_type(r)).concat(w.prep).push(
          Text(Bytes::concat_all([b"\n  return ", w.word, b";\n"])),
        ),
      }
    } else {
      {
        printing: printing,
        out: [Text(Bytes::concat_all([b"  ", c_type(r), b" r = ", call, b";\n"]))].concat(
          after,
        ).push(
          Text(
            Bytes::concat_all([
              b"  if (ctx->failed) return 0;\n  return ",
              if r == AsUnit { b"0" } else { as_word(b"r", r) },
              b";\n",
            ]),
          ),
        ),
      }
    },
  }
}

pub fn entry_result_values(r: Representation) -> List<Bytes> =
  if r == AsWord { [b"r0"] }
  else if is_boxed(r) { [b"r0"].concat(parts_read(b"ro", c_values_of(r).drop(1))) }
  else { [b"r"] }

pub fn value_printing(
  p: InstructionContext,
  printing: Printing,
  into: Option<Variable>,
  m: { made: Allocation, args: List<Arg>, reuse: Option<Variable> },
) -> Printing / {abort.raise} =
  match into {
    None ->
      unsupported(b"a value that is created but never stored or released", allocation_text(m.made)),
    Some(v) -> match m.made {
      CaseAllocation(c) ->
        allocate_box(
          p,
          printing,
          v,
          if c.skip > 0 { Some(c.case) } else { None },
          c.skip + c.words,
          m.args,
          m.reuse,
        ),
      RecordAllocation(shape) -> record_boxed(p, printing, v, shape, m.args),
      other ->
        unsupported(b"an allocation of a kind the C printer cannot print", allocation_text(other)),
    },
  }

fn record_boxed(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  shape: List<FieldInitializer>,
  args: List<Arg>,
) -> Printing / {abort.raise} =
  match known_layout(printing.constructors, v.ty) {
    Some(RecordFields(fs)) -> {
      let n = named(printing, v);
      let written = fields_written(n.printing, v.id, n.name, v.ty, fs, 0, shape, args, 0);
      let allocated = Bytes::concat_all([
        b"ply_alloc(ctx, ",
        int_literal(header_bytes + 8 * words(RecordFields(fs))),
        b");",
      ]);
      line(
        slots_moved(written.printing, args, v.id),
        p.depth,
        Bytes::concat_all([
          b"Word ",
          n.name,
          if printing.placing.results.contains(v.id) {
            Bytes::concat_all([
              b"; if (d) { ",
              n.name,
              b" = d; *(Word *)d = (Word)PLY_RC_FRAME; } else ",
              n.name,
              b" = ",
              allocated,
            ])
          } else { b" = ".concat(allocated) },
          b" ",
          Bytes::join(written.out, b" "),
        ]),
      )
    },
    _ -> unsupported(b"a record created without a known layout for its fields", variable_text(v)),
  }

fn fields_written(
  printing: Printing,
  by: Int,
  box: Bytes,
  ty: Type,
  fs: List<FieldLayout>,
  at: Int,
  shape: List<FieldInitializer>,
  args: List<Arg>,
  from: Int,
) -> { printing: Printing, out: List<Bytes>, next: Int } / {abort.raise} = {
  let parts = record_parts(printing.constructors, ty);
  range(0, parts.len()).fold(
    { printing: printing, out: [], next: from },
    |accumulator: { printing: Printing, out: List<Bytes>, next: Int }, k: Int|
      match parts.at(k) {
        Some(part) -> match fs.at(part.field) {
          Some(f) -> match ((shape.at(k), f.layout)) {
            (Some(BuiltInPlace(inner)), InlineRecord(RecordFields(gs))) -> {
              let header = Bytes::concat_all([slot(box, at + f.at), b" = (Word)PLY_RC_FRAME;"]);
              let built = fields_written(
                accumulator.printing,
                by,
                box,
                part.ty,
                gs,
                at + f.at + 1,
                inner,
                args,
                accumulator.next,
              );
              {
                printing: built.printing,
                out: accumulator.out.push(header).concat(built.out),
                next: built.next,
              }
            },
            (_, InlineRecord(r)) -> {
              let a = match args.at(accumulator.next) { Some(x) -> x, None -> ZeroOperand(AsWord) };
              let header = slot(box, at + f.at);
              let first = Bytes::concat_all([b"&", slot(box, at + f.at + 1)]);
              let source_part = nth_or_zero(arg_parts(accumulator.printing, a), 0);
              let copy = if moves_slot(accumulator.printing, a, by) {
                { printing: accumulator.printing, text: move_inline(header, first, source_part, r) }
              } else { copy_inline(accumulator.printing, header, first, source_part, r) };
              {
                printing: copy.printing,
                out: accumulator.out.push(copy.text),
                next: accumulator.next + 1,
              }
            },
            _ -> {
              let a = match args.at(accumulator.next) { Some(x) -> x, None -> ZeroOperand(AsWord) };
              let ws = values_as_words(
                arg_parts(accumulator.printing, a),
                c_values_of(operand_representation(a)),
              );
              {
                ..accumulator,
                out: accumulator.out.concat(
                  range(0, ws.len()).map(|j: Int|
                    Bytes::concat_all([
                      slot(box, at + f.at + j),
                      b" = ",
                      nth_or_zero(ws, j),
                      b";",
                    ])),
                ),
                next: accumulator.next + 1,
              }
            },
          },
          None -> accumulator,
        },
        None -> accumulator,
      },
  )
}

fn allocate_box(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  tag: Option<Int>,
  n: Int,
  args: List<Arg>,
  reuse: Option<Variable>,
) -> Printing = {
  let nm = named(printing, v);
  let allocated = Bytes::concat_all([
    nm.name,
    b" = ply_alloc(ctx, ",
    int_literal(header_bytes + 8 * n),
    b");",
  ]);
  let first = match tag { Some(_) -> 1, None -> 0 };
  let tagged = match tag {
    Some(c) -> [Bytes::concat_all([slot(nm.name, 0), b" = ", int_literal(c), b";"])],
    None -> [],
  };
  let writes = Bytes::join(
    tagged.concat(
      range(0, args.len()).fold(
        { at: first, out: [] },
        |accumulator: { at: Int, out: List<Bytes> }, k: Int| {
          let a = match args.at(k) { Some(x) -> x, None -> ZeroOperand(AsWord) };
          let c_values = c_values_of(operand_representation(a));
          let ws = values_as_words(arg_parts(printing, a), c_values);
          {
            at: accumulator.at + word_count(c_values),
            out: accumulator.out.concat(
              range(0, ws.len()).map(|j: Int|
                Bytes::concat_all([
                  slot(nm.name, accumulator.at + j),
                  b" = ",
                  nth_or_zero(ws, j),
                  b";",
                ])),
            ),
          }
        },
      ).out,
    ),
    b" ",
  );
  line(nm.printing, p.depth, match reuse {
    None -> Bytes::concat_all([b"Word ", allocated, b" ", writes]),
    Some(token) ->
      Bytes::concat_all([
        b"Word ",
        nm.name,
        b" = ",
        name_of(printing, token),
        b"; if (!",
        nm.name,
        b") ",
        allocated,
        b" ",
        writes,
      ]),
  })
}

pub fn get_printed(
  p: InstructionContext,
  printing: Printing,
  into: Option<Variable>,
  g: { of: Variable, path: Path },
) -> Printing / {abort.raise} =
  match into {
    None -> printing,
    Some(v) -> {
      let base = name_of(printing, g.of);
      match g.path {
        LeafPath(k) -> match g.of.representation {
          AsFlattened(ls) -> {
            let at = leaf_values(ls, k);
            declared_as(
              p,
              printing,
              v,
              part_names(base, g.of.representation).drop(at.at).take(at.n),
            )
          },
          _ -> declared_as(p, printing, v, [part_named(base, g.of.representation, k)]),
        },
        FieldPath(f) -> if g.of.representation != AsWord {
          unsupported(
            b"a field read from a variable that is not stored as a single machine word",
            variable_text(g.of),
          )
        } else {
          declared_as(p, printing, v, read_from(|k: Int| slot(base, f.at + k), v.representation))
        },
        InlineRecordPath(at) -> if g.of.representation != AsWord {
          unsupported(
            b"an inline record read from a variable that is not stored as a single machine word",
            variable_text(g.of),
          )
        } else { declared_as(p, printing, v, [Bytes::concat_all([b"(Word)&", slot(base, at)])]) },
        ArgumentPath(a) -> if g.of.representation != AsWord {
          unsupported(
            b"a constructor argument read from a variable that is not stored as a single machine word",
            variable_text(g.of),
          )
        } else { declared_as(p, printing, v, [word_as(slot(base, a.at), v.representation)]) },
        CapturePath(k) ->
          unsupported(
            b"a closure capture read outside the closure's own code",
            Bytes::concat_all([b"capture ", ascii_of_int(k), b" of ", variable_text(g.of)]),
          ),
        CasePath(c) -> match g.of.representation {
          AsSum(s) ->
            declared_as(
              p,
              printing,
              v,
              case_read(
                s.layout,
                part_names(base, g.of.representation),
                c.case,
                c.at,
                v.representation,
              ),
            ),
          _ ->
            unsupported(
              b"a case payload read from a variable that is not a sum",
              variable_text(g.of),
            ),
        },
        PayloadPath -> payload_printed(p, printing, v, g.of),
        _ -> unsupported(b"a kind of read that the C printer cannot print", variable_text(g.of)),
      }
    },
  }

pub fn declared_as(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  expressions: List<Bytes>,
) -> Printing = {
  let n = named(printing, v);
  let ts = c_types(v.representation);
  let ns = part_names(n.name, v.representation);
  range(0, ns.len()).fold(n.printing, |q: Printing, k: Int|
    line(
      q,
      p.depth,
      Bytes::concat_all([
        nth_or_zero(ts, k),
        b" ",
        nth_or_zero(ns, k),
        b" = ",
        nth_or_zero(expressions, k),
        b";",
      ]),
    ))
}

pub fn parts_to_word(
  printing: Printing,
  name: Bytes,
  parts: List<Bytes>,
  r: Representation,
) -> { printing: Printing, prep: List<Piece>, word: Bytes } =
  if is_boxed(r) {
    let ws = values_as_words(parts, c_values_of(r));
    {
      printing: printing,
      prep: [
        Text(
          Bytes::concat_all([
            b"Word ",
            name,
            b" = ply_alloc(ctx, ",
            int_literal(header_bytes + 8 * ws.len()),
            b");",
            Bytes::concat_all(
              range(0, ws.len()).map(|k: Int|
                Bytes::concat_all([b" ", slot(name, k), b" = ", nth_or_zero(ws, k), b";"])),
            ),
          ]),
        ),
      ],
      word: name,
    }
  } else if r == AsUnit { { printing: printing, prep: [], word: b"0" } }
  else { { printing: printing, prep: [], word: as_word(nth_or_zero(parts, 0), r) } }

pub fn word_to_parts(word: Bytes, r: Representation, into: List<Bytes>) -> List<Piece> =
  if is_boxed(r) {
    let n = word_count(c_values_of(r));
    let dups = dups_of(r, into);
    [
      Text(
        Bytes::concat_all([
          box_read(word, r, into),
          b"if (",
          call_text(last_function, [b"ctx", word]),
          b") ",
          call_text(free_function, [b"ctx", word, int_literal(header_bytes + 8 * n)]),
          b";",
          if dups.len() == 0 { b"" } else { Bytes::concat_all([b" else { ", dups, b" }"]) },
        ]),
      ),
    ]
  } else {
    match r {
      AsUnit -> [],
      AsDecimal -> scalar_read(word, r, into),
      AsWideFixed(_) -> scalar_read(word, r, into),
      AsInt -> bits_read(word, r, into),
      AsBool -> bits_read(word, r, into),
      AsFixed(_) -> bits_read(word, r, into),
      AsFloat -> bits_read(word, r, into),
      AsSum(s) -> if layout::raw_sum(s.layout) { bits_read(word, r, into) }
      else { [Text(Bytes::concat_all([b"Word ", nth_or_zero(into, 0), b" = ", word, b";"]))] },
      _ -> [Text(Bytes::concat_all([b"Word ", nth_or_zero(into, 0), b" = ", word, b";"]))],
    }
  }

pub fn read_box_pieces(word: Bytes, r: Representation, into: List<Bytes>) -> List<Piece> =
  [Text(box_read(word, r, into))]

fn box_read(word: Bytes, r: Representation, into: List<Bytes>) -> Bytes = {
  let c_values = c_values_of(r);
  let read = parts_read(Bytes::concat_all([b"ply_words(", word, b")"]), c_values);
  Bytes::concat_all(
    range(0, c_values.len()).map(|k: Int|
      Bytes::concat_all([
        one_type(match c_values.at(k) { Some(h) -> h, None -> AsWord }),
        b" ",
        nth_or_zero(into, k),
        b" = ",
        nth_or_zero(read, k),
        b"; ",
      ])),
  )
}

fn bits_read(word: Bytes, r: Representation, into: List<Bytes>) -> List<Piece> =
  [Text(Bytes::concat_all([c_type(r), b" ", nth_or_zero(into, 0), b" = ", word_as(word, r), b";"]))]

fn scalar_read(word: Bytes, r: Representation, into: List<Bytes>) -> List<Piece> =
  [
    Text(
      Bytes::concat_all([
        c_type(r),
        b" ",
        nth_or_zero(into, 0),
        b" = ",
        word_as(word, r),
        b"; ",
        call_text(release_box_function, [b"ctx", word, ascii_of_int(header_bytes + 16)]),
        b";",
      ]),
    ),
  ]

pub fn dups_of(r: Representation, ws: List<Bytes>) -> Bytes =
  match r {
    AsFlattened(ls) ->
      Bytes::join(
        range(0, ls.len()).fold([], |accumulator: List<Bytes>, k: Int| {
          let at = leaf_values(ls, k);
          let mine = ws.drop(at.at).take(at.n);
          let d = match ls.at(k) {
            Some(l) -> match l.representation {
              AsWord -> dup(nth_or_zero(mine, 0)),
              AsSum(s) -> sum_dups(s.layout, mine),
              _ -> b"",
            },
            None -> b"",
          };
          if d.len() == 0 { accumulator } else { accumulator.push(d) }
        }),
        b" ",
      ),
    AsSum(s) -> sum_dups(s.layout, ws),
    AsWord -> dup(nth_or_zero(ws, 0)),
    _ -> b"",
  }

fn dup(w: Bytes) -> Bytes = call_text(duplicate_function, [w]).concat(b";")

fn sum_dups(s: SumLayout, ws: List<Bytes>) -> Bytes =
  if !s.classes.any(|c: layout::WordClass| c == Mixed) { classes_retain(s.classes, ws) } else {
    let arms = range(0, s.cases.len()).fold(
      [],
      |accumulator: List<{ case: Int, text: Bytes }>, i: Int| {
        let d = match s.cases.at(i) {
          Some(c) -> match c.payload {
            Nullary -> b"",
            Inline(l) -> {
              let own = range(0, words(l.layout)).map(|k: Int| {
                let w = nth_or_zero(ws, l.offset + k);
                if l.stripped == Some(l.offset + k) { masked(w) } else { w }
              });
              layout_dups(l.layout, own)
            },
            Boxed(b) -> {
              let w = nth_or_zero(ws, b.at);
              dup(if b.stripped { masked(w) } else { w })
            },
          },
          None -> b"",
        };
        if d.len() == 0 { accumulator } else {
          accumulator.push({
            case: i,
            text: Bytes::concat_all([case_label(s, i), b" ", d, b" break;"]),
          })
        }
      },
    );
    if arms.len() == 0 { b"" } else {
      Bytes::concat_all([
        b"switch (",
        switch_value(s, ws),
        b") { ",
        Bytes::join(arms.map(|a: { case: Int, text: Bytes }| a.text), b" "),
        b" ",
        empty_arms(s, arms.map(|a: { case: Int, text: Bytes }| a.case)),
        b"}",
      ])
    }
  }

pub fn write_inline(
  printing: Printing,
  header: Bytes,
  first: Bytes,
  source: Bytes,
  l: ValueLayout,
) -> { printing: Printing, text: Bytes } / {abort.raise} = {
  let m = words(l);
  let counted = layout_retain_at(printing, l, first);
  {
    printing: counted.printing,
    text: Bytes::concat_all([
      b"{ Word ply_s = ",
      source,
      b"; ",
      header,
      b" = (Word)PLY_RC_FRAME; memcpy(",
      first,
      b", ply_words(ply_s), ",
      int_literal(8 * m),
      b"); if (ply_last(ctx, ply_s)) ply_free(ctx, ply_s, ",
      int_literal(header_bytes + 8 * m),
      b"); else { ",
      counted.text,
      b" } }",
    ]),
  }
}

pub fn copy_inline(
  printing: Printing,
  header: Bytes,
  first: Bytes,
  source: Bytes,
  l: ValueLayout,
) -> { printing: Printing, text: Bytes } / {abort.raise} = {
  let counted = layout_retain_at(printing, l, first);
  {
    printing: counted.printing,
    text: Bytes::concat_all([
      header,
      b" = (Word)PLY_RC_FRAME; memcpy(",
      first,
      b", ply_words(",
      source,
      b"), ",
      int_literal(8 * words(l)),
      b"); ",
      counted.text,
    ]),
  }
}

pub fn layout_retain_at(
  printing: Printing,
  l: ValueLayout,
  first: Bytes,
) -> { printing: Printing, text: Bytes } / {abort.raise} = {
  let m = words(l);
  let body = layout_dups(
    l,
    range(0, m).map(|k: Int| Bytes::concat_all([b"w[", ascii_of_int(k), b"]"])),
  );
  if body.len() <= inline_dups_limit {
    {
      printing: printing,
      text: layout_dups(
        l,
        range(0, m).map(|k: Int| Bytes::concat_all([b"(", first, b")[", ascii_of_int(k), b"]"])),
      ),
    }
  } else {
    let symbol = b"ply_d_".concat(Bytes::of_string(blake3(body).slice(0, 8).hex_of()));
    {
      printing: if printing.shared.any(|f: SharedFunction| f.symbol == symbol) { printing } else {
        {
          ..printing,
          shared: printing.shared.push({
            symbol: symbol,
            text: Bytes::concat_all([b"static void ", symbol, b"(Word *w) { ", body, b" }\n"]),
          }),
        }
      },
      text: Bytes::concat_all([symbol, b"(", first, b");"]),
    }
  }
}

const inline_dups_limit: Int = 48

pub fn move_inline(header: Bytes, first: Bytes, source: Bytes, l: ValueLayout) -> Bytes =
  Bytes::concat_all([
    header,
    b" = (Word)PLY_RC_FRAME; memcpy(",
    first,
    b", ply_words(",
    source,
    b"), ",
    int_literal(8 * words(l)),
    b");",
  ])

pub fn layout_dups(l: ValueLayout, ws: List<Bytes>) -> Bytes =
  match l {
    PlainWords(cs) -> classes_retain(cs, ws),
    RecordFields(fs) ->
      Bytes::join(
        fs.map(|f: layout::FieldLayout|
          layout_dups(f.layout, ws.drop(f.at).take(words(f.layout)))).filter(|d: Bytes|
          d.len() > 0),
        b" ",
      ),
    SumCases(s) -> sum_dups(s, ws),
    InlineRecord(r) -> layout_dups(r, ws.drop(1)),
  }

fn classes_retain(cs: List<layout::WordClass>, ws: List<Bytes>) -> Bytes =
  Bytes::join(
    range(0, cs.len()).fold([], |accumulator: List<Bytes>, k: Int|
      match cs.at(k) {
        Some(Pointer) -> accumulator.push(dup(nth_or_zero(ws, k))),
        Some(PointerSum(_)) -> {
          let w = nth_or_zero(ws, k);
          accumulator.push(
            Bytes::concat_all([
              b"if ((uint64_t)",
              w,
              b" >= ",
              int_literal(pointer_floor),
              b") ",
              dup(masked(w)),
            ]),
          )
        },
        _ -> accumulator,
      }),
    b" ",
  )

fn masked(w: Bytes) -> Bytes =
  Bytes::concat_all([b"((", w, b") & ~(Word)", ascii_of_int((1 << tag_bits) - 1), b")"])

pub fn build_value(
  p: InstructionContext,
  printing: Printing,
  into: Option<Variable>,
  parts: List<Arg>,
) -> Printing / {abort.raise} =
  match into {
    None ->
      unsupported(
        b"a value built from parts that is not assigned to any variable",
        Bytes::concat_all([ascii_of_int(parts.len()), b" parts"]),
      ),
    Some(v) -> match v.representation {
      AsSum(s) -> match parts.at(0) {
        Some(IntOperand(i)) ->
          declared_as(p, printing, v, case_values(printing, s.layout, i, parts.drop(1))),
        _ ->
          unsupported(
            b"a sum built from a case that has no known storage location",
            variable_text(v),
          ),
      },
      AsWord ->
        unsupported(
          b"a case of a sum whose layout depends on a type parameter, which can only be printed for a specific type",
          variable_text(v),
        ),
      _ ->
        declared_as(
          p,
          printing,
          v,
          parts.fold([], |accumulator: List<Bytes>, a: Arg|
            accumulator.concat(arg_parts(printing, a))),
        ),
    },
  }

fn case_values(printing: Printing, s: SumLayout, i: Int, payload: List<Arg>) -> List<Bytes> = {
  let n = words(SumCases(s));
  let blank = range(0, n).map(|_: Int| b"0");
  let put = |ws: List<Bytes>, at: Int, e: Bytes|
    range(0, ws.len()).map(|k: Int| if k == at { e } else { nth_or_zero(ws, k) });
  let laid = match s.cases.at(i) {
    None -> blank,
    Some(c) -> {
      let tagged = |e: Bytes|
        match c.test {
          LowBits(t) -> if t.bits == 0 { e }
          else { Bytes::concat_all([b"((Word)(", e, b") | ", int_literal(t.bits), b")"]) },
          _ -> e,
        };
      let tested = match c.test { WordIs(t) -> put(blank, t.at, int_literal(t.value)), _ -> blank };
      match c.payload {
        Nullary -> tested,
        Inline(l) -> {
          let ws = payload.fold([], |accumulator: List<Bytes>, a: Arg|
            accumulator.concat(
              values_as_words(arg_parts(printing, a), c_values_of(operand_representation(a))),
            ));
          range(0, n).map(|k: Int| {
            let j = k - l.offset;
            if j < 0 || j >= ws.len() { nth_or_zero(tested, k) }
            else if l.stripped == Some(k) { tagged(nth_or_zero(ws, j)) }
            else { nth_or_zero(ws, j) }
          })
        },
        Boxed(b) -> {
          let w = match payload.at(0) {
            Some(a) -> nth_or_zero(arg_parts(printing, a), 0),
            None -> b"0",
          };
          put(tested, b.at, if b.stripped { tagged(w) } else { w })
        },
      }
    },
  };
  laid
}

pub fn read_from(word: (Int) -> Bytes, r: Representation) -> List<Bytes> =
  values_read(word, c_values_of(r))

pub fn values_read(word: (Int) -> Bytes, vs: List<Representation>) -> List<Bytes> =
  vs.fold({ at: 0, out: [] }, |accumulator: { at: Int, out: List<Bytes> }, h: Representation|
    {
      at: accumulator.at + word_count([h]),
      out: accumulator.out.push(match h {
        AsFloat -> Bytes::concat_all([b"ply_f64(", word(accumulator.at), b")"]),
        AsDecimal ->
          Bytes::concat_all([
            b"(PlyDec){",
            word(accumulator.at),
            b", ",
            word(accumulator.at + 1),
            b"}",
          ]),
        AsWideFixed(_) ->
          Bytes::concat_all([
            b"(PlyWide){",
            word(accumulator.at),
            b", ",
            word(accumulator.at + 1),
            b"}",
          ]),
        AsUnit -> b"0",
        AsWord -> word(accumulator.at),
        _ -> Bytes::concat_all([b"(", one_type(h), b")", word(accumulator.at)]),
      }),
    }).out

fn case_read(s: SumLayout, ws: List<Bytes>, case: Int, at: Int, r: Representation) -> List<Bytes> =
  match s.cases.at(case) {
    Some(c) -> match c.payload {
      Inline(l) ->
        read_from(
          |k: Int| {
            let w = l.offset + at + k;
            if l.stripped == Some(w) { masked(nth_or_zero(ws, w)) } else { nth_or_zero(ws, w) }
          },
          r,
        ),
      Boxed(b) -> {
        let base = if b.stripped { masked(nth_or_zero(ws, b.at)) } else { nth_or_zero(ws, b.at) };
        read_from(|k: Int| slot(base, b.skip + at + k), r)
      },
      Nullary -> read_from(|_: Int| b"0", r),
    },
    None -> read_from(|_: Int| b"0", r),
  }

pub fn static_word(
  p: InstructionContext,
  printing: Printing,
  into: Option<Variable>,
  name: Bytes,
) -> Printing =
  match into {
    None -> printing,
    Some(v) -> declared_as(p, printing, v, [Bytes::concat_all([b"(Word)(intptr_t)&", name])]),
  }

const float_pair: Representation =
  AsFlattened([{ name: b"x", representation: AsFloat }, { name: b"y", representation: AsFloat }])

const place: InstructionContext =
  {
    u: {
      symbol: b"f",
      base: 0,
      result: AsWord,
      site: None,
      arm: None,
      looping: None,
      handler_jump: None,
      group: None,
      unwinds: [],
      epilogue: b"",
    },
    at: span_between(0, 0),
    exit_statement: b"return 0;",
    depth: 0,
  }

const pointer_layout: ValueLayout = PlainWords([Pointer])

const tagged_sum: Representation =
  AsSum({
    layout: sum_layout([of_args([]), of_args([PlainWords([any_integer()])])]),
    cases: [none_constructor, some_constructor],
  })

const optional_pointer: Representation =
  AsSum({
    layout: sum_layout([of_args([]), of_args([pointer_layout])]),
    cases: [none_constructor, some_constructor],
  })

fn owned_convention(reps: List<Representation>, result: Representation) -> Convention =
  {
    params: reps.map(|r: Representation| { ownership: OwnedParam, representation: r }),
    result: result,
    destination_passing: false,
    returned: OwnedResult,
  }

test "a small record is passed to a C function as one argument per field, and a function returning a small record returns its first field" {
  assert_eq(c_types(float_pair), [b"double", b"double"]);
  assert_eq(signature_types(owned_convention([float_pair, float_pair], float_pair)), {
    result: b"double",
    params: [b"double", b"double", b"double", b"double", b"Word*"],
  });
  assert_eq(signature_parameters(owned_convention([AsInt], float_pair)), [
    b"int64_t p0",
    b"Word* o",
  ]);
  assert_eq([tagged_sum, optional_pointer, AsUnit].map(c_types), [
    [b"Word", b"Word"],
    [b"Word"],
    [],
  ]);
  assert_eq(signature_types(owned_convention([AsUnit, AsInt], AsUnit)), {
    result: b"Word",
    params: [b"int64_t"],
  })
}

test "a record too wide for a call's registers is passed as a pointer to its words" {
  let reps = [AsFloat, AsDecimal, AsInt, AsWord, AsInt, AsInt, AsInt, AsInt];
  let wide = AsFlattened(reps.map(|r: Representation| { name: b"f", representation: r }));
  assert_eq(signature_types(owned_convention([wide], AsInt)), {
    result: b"int64_t",
    params: [b"Word*"],
  });
  assert_eq(signature_parameters(owned_convention([wide, AsInt], AsInt)), [
    b"Word* p0",
    b"int64_t p1",
  ]);
  assert_eq(
    signature_parameters({
      ..owned_convention([wide, AsInt], AsInt),
      params: borrowed_where([wide, AsInt], [0, 1]),
    }),
    [b"const Word* p0", b"int64_t p1"],
  );
  let opened = Bytes::join(params_opened([b"p0", b"p1"], [wide, AsInt]), b" ");
  assert(
    opened.index_of(b"p0[8]") != None && opened.index_of(b"p0[9]") == None,
    Some(String::of_bytes_lossy(opened)),
  );
  assert_eq(
    values_as_words([b"e0", b"e1", b"e2", b"e3", b"e4", b"e5", b"e6", b"e7"], reps).len(),
    9,
  );
  assert_eq(parts_read(b"b", reps).len(), reps.len());
  let entered = entry_opened(0, wide);
  assert(pieces_text(entered.text).index_of(b"Word a0_r[] = {") != None, None);
  assert_eq(entered.args, [b"a0_r"]);
  assert_eq(entry_opened(1, float_pair).args.len(), 2)
}

test "a result of several values returns its first and writes the rest into one buffer" {
  let printing = empty_printing(Map::new().insert(0, b"p0"));
  let r = write_return_value(printing, 0, VariableOperand(placeholder_var(0, float_pair)));
  assert_eq(r.value, b"p0_0");
  let text = pieces_text(r.printing.out);
  assert(
    text.index_of(b"o[0] = ply_f64_bits(p0_1);") != None && text.index_of(b"o[1]") == None,
    None,
  );
  assert_eq(result_parts(b"t", b"buf", float_pair), [b"t", b"ply_f64(buf[0])"]);
  assert_eq(entry_outs(float_pair), [b"ro"]);
  assert_eq(entry_outs(AsInt), []);
  let write_return_value = pieces_text(entry_result(printing, float_pair, b"f(ctx)", []).out);
  assert_eq(
    [b"Word ro[1];", b"if (ctx->failed)", b"ro[0]", b"ply_alloc(ctx, INT64_C(24))"].filter(
      |part: Bytes| write_return_value.index_of(part) == None,
    ),
    [],
  );
  assert(
    pieces_text(entry_result(printing, AsUnit, b"f(ctx)", []).out).index_of(b"return 0;\n") != None,
  )
}

test "a sum that fits in one word is passed as that word, and a wider sum is reference-counted by copying only the words its case uses" {
  assert_eq(pieces_text(word_to_parts(b"x", optional_pointer, [b"o"])), b"Word o = x;");
  assert_eq(parts_to_word(empty_printing(Map::new()), b"w", [b"o"], optional_pointer).word, b"o");
  assert_eq(dups_of(tagged_sum, [b"t", b"n"]), b"");
  let either = AsSum({
    layout: sum_layout([of_args([PlainWords([any_integer()])]), of_args([pointer_layout])]),
    cases: [ok_constructor, err_constructor],
  });
  let either_dups = dups_of(either, [b"t", b"x"]);
  assert(
    either_dups.index_of(b"case INT64_C(1):") != None
      && either_dups.index_of(b"case INT64_C(0):") == None
      && either_dups.index_of(dup(b"x")) != None,
    Some(String::of_bytes_lossy(either_dups)),
  );
  assert_eq(word_to_parts(b"x", AsUnit, []), [])
}

test "building a sum case produces the case's tag value, its payload in the position the layout gives, and 0 in any unused word" {
  let printing = empty_printing(Map::new().insert(0, b"p0").insert(1, b"p1"));
  let p = VariableOperand(placeholder_var(0, AsWord));
  let maybe = sum_layout([of_args([]), of_args([pointer_layout])]);
  assert_eq([case_values(printing, maybe, 0, []), case_values(printing, maybe, 1, [p])], [
    [b"INT64_C(0)"],
    [b"p0"],
  ]);
  let result = sum_layout([of_args([pointer_layout]), of_args([pointer_layout])]);
  assert_eq(case_values(printing, result, 1, [p]), [b"((Word)(p0) | INT64_C(1))"]);
  let tagged = sum_layout([of_args([]), of_args([PlainWords([any_integer()])])]);
  assert_eq(case_values(printing, tagged, 1, [VariableOperand(placeholder_var(1, AsInt))]), [
    b"INT64_C(1)",
    b"(Word)(p1)",
  ]);
  assert_eq(case_values(printing, tagged, 0, []), [b"INT64_C(0)", b"0"]);
  let nine = sum_layout(
    range(0, 9).map(|_: Int| { args: record_layout([pointer_layout]), indirect: true }),
  );
  assert_eq(case_values(printing, nine, 8, [p]), [b"((Word)(p0) | INT64_C(7))"])
}

test "a case's payload is read from the position its layout gives: a masked pointer word, a word after the tag word, or a word inside a box" {
  let result = sum_layout([of_args([pointer_layout]), of_args([pointer_layout])]);
  assert_eq(case_read(result, [b"x"], 1, 0, AsWord), [b"((x) & ~(Word)7)"]);
  let tagged = sum_layout([
    of_args([]),
    of_args([PlainWords([any_integer()]), PlainWords([any_integer()])]),
  ]);
  assert_eq(case_read(tagged, [b"x_0", b"x_1", b"x_2", b"x_3"], 1, 1, AsInt), [b"(int64_t)x_2"]);
  assert_eq(
    case_read(
      tagged,
      [b"x_0", b"x_1", b"x_2", b"x_3"],
      1,
      0,
      AsFlattened([{ name: b"a", representation: AsInt }, { name: b"b", representation: AsFloat }]),
    ),
    [b"(int64_t)x_1", b"ply_f64(x_2)"],
  );
  let nine = sum_layout(
    range(0, 9).map(|_: Int| { args: record_layout([pointer_layout]), indirect: true }),
  );
  assert_eq(case_read(nine, [b"x"], 8, 0, AsWord), [b"ply_words(((x) & ~(Word)7))[1]"])
}

test "a sum case with a box is allocated at its size with its words written, and cases past the eighth write the case number into the box's first word" {
  let printing = empty_printing(Map::new().insert(0, b"p0").insert(1, b"p1"));
  let m = {
    made: CaseAllocation({ case: 8, skip: 1, words: 1 }),
    args: [VariableOperand(placeholder_var(0, AsWord))],
    reuse: None,
  };
  let fresh = pieces_text(value_printing(place, printing, Some(placeholder_var(2, AsWord)), m).out);
  assert_eq(
    [b"ply_alloc(ctx, INT64_C(24))", b"[0] = INT64_C(8);", b"[1] = p0;"].filter(|part: Bytes|
      fresh.index_of(part) == None),
    [],
  );
  let reused = {
    made: CaseAllocation({ case: 1, skip: 0, words: 2 }),
    args: [VariableOperand(placeholder_var(0, AsWord)), VariableOperand(placeholder_var(1, AsInt))],
    reuse: Some(placeholder_var(3, AsReuseToken(2))),
  };
  let text = pieces_text(
    value_printing(
      place,
      { ..printing, names: printing.names.insert(3, b"p3") },
      Some(placeholder_var(2, AsWord)),
      reused,
    ).out,
  );
  let reuse_index = match text.index_of(b" = p3;") { Some(i) -> i, None -> 0 - 1 };
  let fresh_only = match text.index_of(b"if (!") { Some(i) -> i, None -> 0 - 1 };
  let allocated = match text.index_of(b"ply_alloc(") { Some(i) -> i, None -> 0 - 1 };
  assert(
    reuse_index >= 0 && fresh_only > reuse_index && allocated > fresh_only
      && text.index_of(b"[1] = ") != None,
    Some(String::of_bytes_lossy(text)),
  )
}
