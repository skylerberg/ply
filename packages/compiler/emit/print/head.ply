//! The emitter's part of the C every part of a unit compiles after, written after the runtime's
//! head: the helpers emitted code counts and releases blocks through, and the structs it lays out
//! and the runtime reads.

import std.bytes (ascii_of_int)
import emit.layout (MachineStruct, MachineField, machine_structs, pointer_floor, tag_bits,
                    refused_kind)

/// The helpers, the machine structs, and a function value's block: its header and its descriptor,
/// its captures after them. `ply_last` answers whether the count it took was a block's last, so the
/// caller drops it; a checked build (`PLY_CHECKED`) traps a block whose count is already 0, which is
/// how a block given back is counted.
pub fn head_part() -> Bytes =
  Bytes::concat_all([
    b"\n",
    helpers(),
    b"\n",
    structs(),
    b"#define PLY_KIND_REFUSED ",
    ascii_of_int(refused_kind()),
    b"\ntypedef struct { PlyObj h; const PlyFnDesc *desc; } PlyFnBlock;\n",
  ])

fn helpers() -> Bytes = {
  let floor = ascii_of_int(pointer_floor());
  let tags = ascii_of_int((1 << tag_bits()) - 1);
  Bytes::concat_all([
    b"static inline int ply_last(PlyCtx *ctx, Word o) {\n",
    b"  PlyObj *h = ply_obj(o);\n",
    b"  uint32_t rc = h->rc;\n",
    b"  if (rc == UINT32_MAX) return 0;\n",
    b"  if (rc >= UINT32_C(0x80000000)) return (int)rt_dec_shared_last_p(ctx, o);\n",
    b"  if (rc > 1) { h->rc = rc - 1; return 0; }\n",
    b"#ifdef PLY_CHECKED\n",
    b"  if (rc == 0) rt_released_twice_p(ctx, o);\n",
    b"#endif\n",
    b"  return 1;\n",
    b"}\n",
    b"static inline void ply_dup(Word o) {\n",
    b"  if (!o) return;\n",
    b"  PlyObj *h = ply_obj(o);\n",
    b"  uint32_t rc = h->rc;\n",
    b"  if (rc < UINT32_C(0x80000000)) h->rc = rc + 1;\n",
    b"  else if (rc != UINT32_MAX) rt_inc_shared_p(0, o);\n",
    b"}\n",
    b"typedef Word (*PlyDrop)(PlyCtx *, Word);\n",
    b"static inline void ply_rel(PlyCtx *ctx, Word o, PlyDrop d) {\n",
    b"  if (o && ply_last(ctx, o)) d(ctx, o);\n",
    b"}\n",
    b"static inline void ply_rel_sum(PlyCtx *ctx, Word w, PlyDrop d) {\n",
    Bytes::concat_all([
      b"  if ((uint64_t)w >= ",
      floor,
      b" && ply_last(ctx, w & ~(Word)",
      tags,
      b")) d(ctx, w);\n",
    ]),
    b"}\n",
    b"static inline void ply_rel_int(PlyCtx *ctx, Word w, PlyDrop d) {\n",
    Bytes::concat_all([b"  if (w && !(w & ", tags, b")) ply_rel(ctx, w, d);\n"]),
    b"}\n",
    b"static inline void ply_free(PlyCtx *ctx, Word o, int64_t bytes) {\n",
    b"  rt_free_p(ctx, o, bytes);\n",
    b"}\n",
  ])
}

/// Each machine struct declared in its order, each field as the head declares it, and its size
/// checked: a C compiler that lays it out otherwise refuses the unit.
fn structs() -> Bytes =
  Bytes::concat_all(
    machine_structs().map(|s: MachineStruct|
      Bytes::concat_all([
        b"typedef struct ",
        s.name,
        b" {\n",
        Bytes::concat_all(
          s.fields.map(|f: MachineField| Bytes::concat_all([b"  ", f.decl, b";\n"])),
        ),
        b"} ",
        s.name,
        b";\n",
        b"typedef char ply_sized_",
        s.name,
        b"[sizeof(",
        s.name,
        b") == ",
        ascii_of_int(s.bytes),
        b" ? 1 : -1];\n",
      ])),
  )

test "a release takes the count, the last one dropping the block, and a checked build traps a count already 0" {
  let h = head_part();
  let between = |from: Bytes, to: Bytes|
    match h.index_of(from) {
      Some(i) -> match h.index_of_from(to, i) { Some(j) -> h.slice(i, j), None -> b"" },
      None -> b"",
    };
  let checked = between(b"#ifdef PLY_CHECKED", b"#endif");
  assert(checked.index_of(b"rc == 0") != None, None);
  // A block given back is counted 0; its kind says nothing a count does not.
  assert_eq(checked.index_of(b"kind"), None);
  // Each release tests the count through `ply_last`, a sum's word only where it points at a block.
  [b"ply_rel(", b"ply_rel_sum(", b"ply_rel_int(", b"ply_free("].fold((), |_: Unit, f: Bytes|
    assert(h.index_of(b"static inline void ".concat(f)) != None, Some(String::of_bytes_lossy(f))));
  assert(between(b"ply_rel_sum(", b"}").index_of(ascii_of_int(pointer_floor())) != None, None)
}

test "each machine struct is declared before one that points at it, its fields in order, its size checked" {
  let h = head_part();
  let at = |s: Bytes|
    match h.index_of(Bytes::concat_all([b"typedef struct ", s, b" {"])) {
      Some(i) -> i,
      None -> 0 - 1,
    };
  let order = machine_structs().map(|s: MachineStruct| at(s.name));
  assert(order.all(|i: Int| i >= 0), None);
  assert_eq(order.sort(), order);
  machine_structs().fold((), |_: Unit, s: MachineStruct| {
    let from = at(s.name);
    let placed = s.fields.fold(from, |last: Int, f: MachineField|
      match h.index_of_from(f.decl, last) {
        Some(i) -> i,
        None ->
          panic(String::of_bytes_lossy(b"a field the head does not declare: ".concat(f.decl))),
      });
    assert(placed > from, None);
    assert(
      h.index_of(Bytes::concat_all([b"sizeof(", s.name, b") == ", ascii_of_int(s.bytes)])) != None,
      None,
    )
  })
}
