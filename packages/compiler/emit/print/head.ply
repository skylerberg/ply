//! The emitter's part of the C every part of a unit compiles after, written after the runtime's
//! head: the helpers emitted code counts and releases blocks through, and the structs it lays out
//! and the runtime reads.

import std.bytes (ascii_of_int)
import emit.layout (MachineStruct, MachineField, machine_structs, pointer_floor, tag_bits, ctx_at,
                    release_depth, refused_kind, header_bytes)
import emit.print.frames (chain_defined)
import emit.print.counting (dup_fn, last_fn, rel_fn, rel_sum_fn, rel_int_fn, rel_box_fn, free_fn,
                            inc_shared_fn, dec_shared_last_fn, free_block_fn, release_later_fn,
                            release_drain_fn, released_twice_fn, box_released_fn, call_text, calls)
import emit.release (immediate_heads, int_heads, box_heads, scalar_box_words)

/// The helpers, the machine structs, a function value's block (its header and its descriptor, its
/// captures after them) and the context's chain of frame records. `ply_last` answers whether the
/// count it took was a block's last, so the caller drops it; a checked build (`PLY_CHECKED`) traps a
/// block whose count is already 0, which is how a block given back is counted. A drop root enters by
/// `ply_drop_deep`, which puts its block off to the runtime where drop roots already nest
/// `release_depth()` deep, and leaves by `ply_drop_done`, the outermost draining what was put off.
pub fn head_part() -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\n",
    helpers(),
    b"\n",
    structs(),
    b"#define PLY_KIND_REFUSED ",
    ascii_of_int(refused_kind()),
    b"\ntypedef struct { PlyObj h; const PlyFnDesc *desc; } PlyFnBlock;\n",
    chain_defined(),
    drops(),
  ])

/// The context's counters a drop root reads and writes, at their offsets past what the runtime's
/// head declares of it, and the drop root's entry and exit.
fn drops() -> Bytes / {abort.raise} = {
  let counter = |name: Bytes|
    Bytes::concat_all([b"(*(int64_t *)((char *)ctx + ", ascii_of_int(ctx_at(name)), b"))"]);
  let depth = counter(b"release_depth");
  Bytes::concat_all([
    b"static inline int ply_drop_deep(PlyCtx *ctx, Word o, PlyDrop d) {\n",
    Bytes::concat_all([
      b"  if (",
      depth,
      b" >= ",
      ascii_of_int(release_depth()),
      b") { ",
      call_text(release_later_fn(), [b"ctx", b"o", b"(Word)(intptr_t)d"]),
      b"; return 1; }\n",
    ]),
    Bytes::concat_all([b"  ", depth, b" += 1;\n"]),
    b"  return 0;\n",
    b"}\n",
    b"static inline void ply_drop_done(PlyCtx *ctx) {\n",
    Bytes::concat_all([
      b"  if (--",
      depth,
      b" == 0 && ",
      counter(b"release_waiting"),
      b" != 0) ",
      call_text(release_drain_fn(), [b"ctx"]),
      b";\n",
    ]),
    b"}\n",
  ])
}

fn helpers() -> Bytes = {
  let floor = ascii_of_int(pointer_floor());
  let tags = ascii_of_int((1 << tag_bits()) - 1);
  Bytes::concat_all([
    b"static inline int ",
    call_text(last_fn(), [b"PlyCtx *ctx", b"Word o"]),
    b" {\n",
    b"  PlyObj *h = ply_obj(o);\n",
    b"  uint32_t rc = h->rc;\n",
    b"  if (rc == UINT32_MAX) return 0;\n",
    b"  if (rc >= UINT32_C(0x80000000)) return (int)",
    call_text(dec_shared_last_fn(), [b"ctx", b"o"]),
    b";\n",
    b"  if (rc > 1) { h->rc = rc - 1; return 0; }\n",
    b"#ifdef PLY_CHECKED\n",
    b"  if (rc == 0) ",
    call_text(released_twice_fn(), [b"ctx", b"o"]),
    b";\n",
    b"#endif\n",
    b"  return 1;\n",
    b"}\n",
    b"static inline void ",
    call_text(dup_fn(), [b"Word o"]),
    b" {\n",
    b"  if (!o) return;\n",
    b"  PlyObj *h = ply_obj(o);\n",
    b"  uint32_t rc = h->rc;\n",
    b"  if (rc < UINT32_C(0x80000000)) h->rc = rc + 1;\n",
    b"  else if (rc != UINT32_MAX) ",
    call_text(inc_shared_fn(), [b"0", b"o"]),
    b";\n",
    b"}\n",
    b"typedef Word (*PlyDrop)(PlyCtx *, Word);\n",
    b"static inline void ",
    call_text(rel_fn(), [b"PlyCtx *ctx", b"Word o", b"PlyDrop d"]),
    b" {\n",
    b"  if (o && ",
    call_text(last_fn(), [b"ctx", b"o"]),
    b") d(ctx, o);\n",
    b"}\n",
    b"static inline void ",
    call_text(rel_sum_fn(), [b"PlyCtx *ctx", b"Word w", b"PlyDrop d"]),
    b" {\n",
    Bytes::concat_all([
      b"  if ((uint64_t)w >= ",
      floor,
      b" && ",
      call_text(last_fn(), [b"ctx", b"w & ~(Word)".concat(tags)]),
      b") d(ctx, w);\n",
    ]),
    b"}\n",
    b"static inline void ",
    call_text(free_fn(), [b"PlyCtx *ctx", b"Word o", b"int64_t bytes"]),
    b" {\n",
    b"  ",
    call_text(free_block_fn(), [b"ctx", b"o", b"bytes"]),
    b";\n",
    b"}\n",
    b"static inline void ",
    call_text(rel_box_fn(), [b"PlyCtx *ctx", b"Word o", b"int64_t bytes"]),
    b" {\n",
    Bytes::concat_all([
      b"  if (o && ",
      call_text(last_fn(), [b"ctx", b"o"]),
      b") ",
      call_text(free_fn(), [b"ctx", b"o", b"bytes"]),
      b";\n",
    ]),
    b"}\n",
    b"static inline void ",
    call_text(rel_int_fn(), [b"PlyCtx *ctx", b"Word w"]),
    b" {\n",
    Bytes::concat_all([
      b"  if (!(w & ",
      tags,
      b")) ",
      call_text(rel_box_fn(), [b"ctx", b"w", ascii_of_int(header_bytes() + 8)]),
      b";\n",
    ]),
    b"}\n",
    described_heads(tags),
  ])
}

/// What a type's descriptor counts and lets go of a word form by, where that form holds no block a
/// root lets go of (`release.word_form_heads`): an immediate's, an `Int`'s, a scalar's box of each
/// size.
fn described_heads(tags: Bytes) -> Bytes = {
  let fn_of = |name: Bytes, body: Bytes|
    Bytes::concat_all([b"static inline Word ", name, b"(PlyCtx *ctx, Word w) { ", body, b" }\n"]);
  let immediate = immediate_heads();
  let int = int_heads();
  let dup = call_text(dup_fn(), [b"w"]);
  Bytes::concat_all([
    fn_of(immediate.dup, b"(void)ctx; return w;"),
    fn_of(immediate.release, b"(void)ctx; (void)w; return 0;"),
    fn_of(
      int.dup,
      Bytes::concat_all([b"(void)ctx; if (!(w & ", tags, b")) ", dup, b"; return w;"]),
    ),
    fn_of(int.release, call_text(rel_int_fn(), [b"ctx", b"w"]).concat(b"; return 0;")),
    fn_of(box_heads(1).dup, Bytes::concat_all([b"(void)ctx; ", dup, b"; return w;"])),
    Bytes::concat_all(
      scalar_box_words().map(|n: Int|
        fn_of(
          box_heads(n).release,
          call_text(rel_box_fn(), [b"ctx", b"w", ascii_of_int(header_bytes() + 8 * n)]).concat(
            b"; return 0;",
          ),
        )),
    ),
  ])
}

/// Each machine struct declared in its order, each field as the head declares it, and its size
/// checked: a C compiler that lays it out otherwise refuses the unit.
fn structs() -> Bytes =
  Bytes::concat_all(
    machine_structs().map(|s: MachineStruct|
      Bytes::concat_all([
        b"typedef struct ",
        s.name,
        b" {\n",
        Bytes::concat_all(
          s.fields.map(|f: MachineField| Bytes::concat_all([b"  ", f.decl, b";\n"])),
        ),
        b"} ",
        s.name,
        b";\n",
        b"typedef char ply_sized_",
        s.name,
        b"[sizeof(",
        s.name,
        b") == ",
        ascii_of_int(s.bytes),
        b" ? 1 : -1];\n",
      ])),
  )

test "a release takes the count, the last one dropping the block, and a checked build traps a count already 0" {
  let h = head_part();
  let between = |from: Bytes, to: Bytes|
    match h.index_of(from) {
      Some(i) -> match h.index_of_from(to, i) { Some(j) -> h.slice(i, j), None -> b"" },
      None -> b"",
    };
  let checked = between(b"#ifdef PLY_CHECKED", b"#endif");
  assert(checked.index_of(b"rc == 0") != None, None);
  // A block given back is counted 0; its kind says nothing a count does not.
  assert_eq(checked.index_of(b"kind"), None);
  // Each release tests the count through `ply_last`, a sum's word only where it points at a block.
  [rel_fn(), rel_sum_fn(), rel_int_fn(), rel_box_fn(), free_fn()].fold((), |_: Unit, f: Bytes|
    assert(
      h.index_of(Bytes::concat_all([b"static inline void ", f, b"("])) != None,
      Some(String::of_bytes_lossy(f)),
    ));
  let defined = |f: Bytes| between(Bytes::concat_all([b" ", f, b"("]), b"}");
  assert(defined(rel_sum_fn()).index_of(ascii_of_int(pointer_floor())) != None, None);
  // A scalar's box holds nothing counted: its last count gives it back by its size, an `Int`'s
  // where its word is no immediate.
  assert(
    defined(rel_box_fn()).index_of(
        Bytes::concat_all([
          call_text(last_fn(), [b"ctx", b"o"]),
          b") ",
          call_text(free_fn(), [b"ctx", b"o", b"bytes"]),
        ]),
      )
      != None,
    None,
  );
  assert(
    defined(rel_int_fn()).index_of(
        call_text(rel_box_fn(), [b"ctx", b"w", ascii_of_int(header_bytes() + 8)]),
      )
      != None,
    None,
  );
  // A descriptor names these where a word form holds no block a root lets go of: each is defined at
  // the type its field holds, a box's release for each size a scalar's box comes in.
  let named = [immediate_heads(), int_heads()].concat(scalar_box_words().map(box_heads)).fold(
    [],
    |acc: List<Bytes>, h: { dup: Bytes, release: Bytes }| acc.push(h.dup).push(h.release),
  );
  assert_eq(
    named.filter(|n: Bytes|
      h.index_of(Bytes::concat_all([b"static inline Word ", n, b"(PlyCtx *ctx, Word w) {"]))
        == None),
    [],
  );
  assert(calls(defined(box_released_fn(2)), rel_box_fn()), None)
}

test "a drop root nests to the release depth, then puts its block off; the outermost drains what was put off" {
  let h = head_part();
  let body = |f: Bytes|
    match h.index_of(f) {
      Some(i) -> match h.index_of_from(b"\n}\n", i) { Some(j) -> h.slice(i, j), None -> b"" },
      None -> b"",
    };
  let at = |name: Bytes| Bytes::concat_all([b"(char *)ctx + ", ascii_of_int(ctx_at(name)), b")"]);
  let deep = body(b"static inline int ply_drop_deep(");
  let done = body(b"static inline void ply_drop_done(");
  assert(deep.index_of(at(b"release_depth")) != None, None);
  assert(deep.index_of(Bytes::concat_all([b" >= ", ascii_of_int(release_depth())])) != None, None);
  assert(calls(deep, release_later_fn()), None);
  assert(done.index_of(at(b"release_depth")) != None, None);
  assert(done.index_of(at(b"release_waiting")) != None, None);
  assert(done.index_of(call_text(release_drain_fn(), [b"ctx"])) != None, None);
  // Both read the counters past the fields the runtime's head declares.
  assert(ctx_at(b"release_depth") > ctx_at(b"next_tick"), None)
}

test "each machine struct is declared before one that points at it, its fields in order, its size checked" {
  let h = head_part();
  let at = |s: Bytes|
    match h.index_of(Bytes::concat_all([b"typedef struct ", s, b" {"])) {
      Some(i) -> i,
      None -> 0 - 1,
    };
  let order = machine_structs().map(|s: MachineStruct| at(s.name));
  assert(order.all(|i: Int| i >= 0), None);
  assert_eq(order.sort(), order);
  machine_structs().fold((), |_: Unit, s: MachineStruct| {
    let from = at(s.name);
    let placed = s.fields.fold(from, |last: Int, f: MachineField|
      match h.index_of_from(f.decl, last) {
        Some(i) -> i,
        None ->
          panic(String::of_bytes_lossy(b"a field the head does not declare: ".concat(f.decl))),
      });
    assert(placed > from, None);
    assert(
      h.index_of(Bytes::concat_all([b"sizeof(", s.name, b") == ", ascii_of_int(s.bytes)])) != None,
      None,
    )
  })
}
