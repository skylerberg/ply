//! The C every part of a unit compiles after, and the C its runtime part opens with: what the C
//! assumes of words, blocks and the context, the pointers to the functions it calls that the unit
//! binds at load, the helpers emitted code counts and releases blocks through, and the structs it
//! lays out and the runtime reads.

import std.bytes (ascii_of_int)
import compiler.emit.layout (MachineStruct, MachineField, head_structs, text_head, pointer_floor,
                             tag_bits, header_bytes, frame_count)
import compiler.emit.abi
import compiler.emit.abi (Native, Machine, natives, machine_structs, obj_struct, ctx_struct,
                          release_depth, failed_target, failed_pending)
import compiler.emit.tir.handling (raised_at)
import compiler.emit.roots (builtin_helper)
import compiler.cc (tail_mark)
import compiler.emit.print.frames (chain_defined)
import compiler.emit.print.counting (dup_fn, last_fn, rel_fn, rel_sum_fn, rel_box_fn, free_fn,
                                     inc_shared_fn, dec_shared_last_fn, free_block_fn,
                                     release_later_fn, release_drain_fn, released_twice_fn,
                                     box_released_fn, never_lifted_fn, never_lifted_rt_fn,
                                     call_text, calls)
import compiler.emit.release (immediate_heads, box_heads, scalar_box_words)
import compiler.emit.print.fuel (entered_helper, entered_fn)
import compiler.emit.print.lists (list_helpers, item_fn, leaf_fn)
import compiler.emit.print.counts (walk_helpers, kept_block_fn, fresh_block_fn, unshared_fn,
                                   mark_fn)

/// What every part of a unit compiles after: the prelude, a pointer to each function the unit
/// binds, declared and not defined so a unit compiled in parts binds one table, then the helpers and
/// structs emitted code shares.
pub fn unit_head() -> Bytes / {abort.raise} =
  Bytes::concat_all([
    prelude(),
    b"\n",
    Bytes::concat_all(bound().map(pointer_declared)),
    b"\n",
    head_part(),
  ])

/// What the unit's runtime part opens with: each pointer the head declares and each of `natives`',
/// the natives of shipped modules its bodies call over machine words, defined, and the `ply_bind`
/// the loader hands the address of each function the unit binds, in `bound`'s order and then
/// `natives`'.
pub fn unit_tail(natives: List<Native>) -> Bytes / {abort.raise} = {
  let all = bound().concat(natives);
  Bytes::concat_all([
    b"\n",
    tail_mark(),
    b"\n",
    Bytes::concat_all(all.map(|n: Native| pointer(n).concat(b";\n"))),
    b"\nvoid ply_bind(void **fns) {\n",
    Bytes::concat_all(
      range(0, all.len()).map(|i: Int| {
        let n = all.get(i);
        Bytes::concat_all([
          b"  ",
          n.name,
          b"_p = (",
          answered_c(n),
          b" (*)(",
          params_c(n),
          b"))fns[",
          ascii_of_int(i),
          b"];\n",
        ])
      }),
    ),
    b"}\n",
    tail_part(),
  ])
}

/// Each function the unit's C calls through a pointer it binds, by the pointer's name less its `_p`:
/// the runtime's helpers, then the natives the compiler calls directly. The unit lists them so, in
/// this order, for the loader, which finds each by name.
pub fn bound() -> List<Native> / {abort.raise} =
  abi::helpers().concat(natives().map(|n: Native| { ..n, name: builtin_helper(n.name) }))

fn answered_c(n: Native) -> Bytes = if n.answer == None { b"void" } else { b"Word" }

/// Every parameter is a `Word` to C: each kind is passed as one `int64_t` is.
fn params_c(n: Native) -> Bytes =
  b"PlyCtx*".concat(Bytes::concat_all(n.params.map(|_: Machine| b", Word")))

fn pointer(n: Native) -> Bytes =
  Bytes::concat_all([answered_c(n), b" (*", n.name, b"_p)(", params_c(n), b")"])

/// The pointer to `n`, declared and not defined, as a part that calls it declares it.
pub fn pointer_declared(n: Native) -> Bytes = Bytes::concat_all([b"extern ", pointer(n), b";\n"])

/// What C the unit's code assumes before anything of its own: the C library's few functions, the
/// word, a block's header and the context as the runtime lays them out, and the inline helpers over
/// words, checked arithmetic, `Float` bits, decimals and wide integers.
fn prelude() -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"#include <stdint.h>\n",
    // tcc's arm64 calls reach 128 MB, silently: under `PLY_FAR` the C library's are defined here.
    b"#if defined(__TINYC__) && defined(__aarch64__)\n",
    b"#  define PLY_FAR 1\n",
    b"#endif\n",
    b"#ifdef PLY_FAR\n",
    b"#include <stddef.h>\n",
    b"static void *memcpy(void *d, const void *s, size_t n) {\n",
    b"  unsigned char *a = d;\n",
    b"  const unsigned char *b = s;\n",
    b"  while (n--) *a++ = *b++;\n",
    b"  return d;\n",
    b"}\n",
    b"static void *memmove(void *d, const void *s, size_t n) {\n",
    b"  unsigned char *a = d;\n",
    b"  const unsigned char *b = s;\n",
    b"  if ((uintptr_t)a < (uintptr_t)b) while (n--) *a++ = *b++;\n",
    b"  else while (n--) a[n] = b[n];\n",
    b"  return d;\n",
    b"}\n",
    b"static void *memset(void *d, int c, size_t n) {\n",
    b"  unsigned char *a = d;\n",
    b"  while (n--) *a++ = (unsigned char)c;\n",
    b"  return d;\n",
    b"}\n",
    b"static int memcmp(const void *x, const void *y, size_t n) {\n",
    b"  const unsigned char *a = x;\n",
    b"  const unsigned char *b = y;\n",
    b"  for (; n; n--, a++, b++) if (*a != *b) return *a < *b ? -1 : 1;\n",
    b"  return 0;\n",
    b"}\n",
    b"#else\n",
    b"#include <string.h>\n",
    b"#endif\n",
    b"\n",
    b"typedef int64_t Word;\n",
    declared(obj_struct()),
    b"#define PLY_HEADER ",
    ascii_of_int(header_bytes()),
    b"\n#define PLY_RC_FRAME UINT32_C(",
    ascii_of_int(frame_count()),
    b")\n",
    declared(ctx_struct()),
    b"#define PLY_SITE(ctx, r, s, e) ((ctx)->site_root = (r), (ctx)->site_start = (s), (ctx)->site_end = (e))\n",
    b"static inline Word *ply_words(Word w) { return (Word *)((char *)(intptr_t)w + PLY_HEADER); }\n",
    b"static inline PlyObj *ply_obj(Word w) { return (PlyObj *)(intptr_t)w; }\n",
    b"static inline uint32_t ply_le32(uint32_t v) {\n",
    b"#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__\n",
    b"  return __builtin_bswap32(v);\n",
    b"#else\n",
    b"  return v;\n",
    b"#endif\n",
    b"}\n",
    // tcc has no overflow builtins: it reads the test written out, unsigned, as `PLY_NO_OV_BUILTIN` asks.
    b"#if defined(__has_builtin) && !defined(PLY_NO_OV_BUILTIN)\n",
    b"#  if __has_builtin(__builtin_add_overflow)\n",
    b"#    define PLY_OV_BUILTIN 1\n",
    b"#  endif\n",
    b"#endif\n",
    b"#ifdef PLY_OV_BUILTIN\n",
    b"static inline int ply_add_ov(int64_t a, int64_t b, int64_t *r) { return __builtin_add_overflow(a, b, r); }\n",
    b"static inline int ply_sub_ov(int64_t a, int64_t b, int64_t *r) { return __builtin_sub_overflow(a, b, r); }\n",
    b"static inline int ply_mul_ov(int64_t a, int64_t b, int64_t *r) { return __builtin_mul_overflow(a, b, r); }\n",
    b"#else\n",
    b"static inline int ply_add_ov(int64_t a, int64_t b, int64_t *r) {\n",
    b"  uint64_t s = (uint64_t)a + (uint64_t)b;\n",
    b"  *r = (int64_t)s;\n",
    b"  return (int)((((uint64_t)a ^ s) & ((uint64_t)b ^ s)) >> 63);\n",
    b"}\n",
    b"static inline int ply_sub_ov(int64_t a, int64_t b, int64_t *r) {\n",
    b"  uint64_t s = (uint64_t)a - (uint64_t)b;\n",
    b"  *r = (int64_t)s;\n",
    b"  return (int)((((uint64_t)a ^ (uint64_t)b) & ((uint64_t)a ^ s)) >> 63);\n",
    b"}\n",
    // A product's magnitude must divide back, then fit the sign's range, one more below zero.
    b"static inline int ply_mul_ov(int64_t a, int64_t b, int64_t *r) {\n",
    b"  uint64_t x = a < 0 ? 0 - (uint64_t)a : (uint64_t)a;\n",
    b"  uint64_t y = b < 0 ? 0 - (uint64_t)b : (uint64_t)b;\n",
    b"  uint64_t m = x * y;\n",
    b"  *r = (int64_t)((uint64_t)a * (uint64_t)b);\n",
    b"  if (x != 0 && m / x != y) return 1;\n",
    b"  return m > (uint64_t)INT64_MAX + ((a < 0) != (b < 0));\n",
    b"}\n",
    b"#endif\n",
    b"static inline double ply_f64(int64_t bits) { union { int64_t i; double d; } u; u.i = bits; return u.d; }\n",
    b"static inline int64_t ply_f64_bits(double d) { union { int64_t i; double d; } u; u.d = d; return u.i; }\n",
    b"typedef struct { Word lo, hi; } PlyDec;\n",
    b"static inline PlyDec ply_dec_of(Word w) { PlyDec d; d.lo = ply_words(w)[0]; d.hi = ply_words(w)[1]; return d; }\n",
    b"typedef struct { Word lo, hi; } PlyWide;\n",
    b"static inline PlyWide ply_wide_of(Word w) { PlyWide x; x.lo = ply_words(w)[0]; x.hi = ply_words(w)[1]; return x; }\n",
    b"static inline int64_t ply_wide_order(PlyWide a, PlyWide b, int s) {\n",
    b"  if (a.hi != b.hi) return (s ? (int64_t)a.hi < (int64_t)b.hi : (uint64_t)a.hi < (uint64_t)b.hi) ? -1 : 1;\n",
    b"  return ((uint64_t)a.lo > (uint64_t)b.lo) - ((uint64_t)a.lo < (uint64_t)b.lo);\n",
    b"}\n",
    b"static inline Word ply_imm(int64_t v) { return (Word)(((uint64_t)v << 1) | 1); }\n",
    b"static inline int64_t ply_imm_value(Word w) { return w >> 1; }\n",
  ])

/// The helpers, the machine structs, a function value's block (its header and its descriptor, its
/// captures after them) and the context's chain of frame records. `ply_last` answers whether the
/// count it took was a block's last, so the caller drops it; a checked build (`PLY_CHECKED`) traps a
/// block whose count is already 0, which is how a block given back is counted. A drop root enters by
/// `ply_drop_deep`, which puts its block off to the runtime where drop roots already nest
/// `release_depth()` deep, and leaves by `ply_drop_done`, the outermost draining what was put off.
fn head_part() -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\n",
    helpers(),
    b"\n",
    structs(),
    b"typedef struct { PlyObj h; const PlyFnDesc *desc; } PlyFnBlock;\n",
    words_mapped(),
    entries_defined(),
    byte_texts_declared(),
    chain_defined(),
    drops(),
    shared_sequences(),
  ])

/// What performs and `handle`s enter evidence objects through. An object is a flags word, then an
/// entry and its environment per operation of its effect; `ply_perform` calls operation `k`'s with
/// the operation's `op#`, its mode, the resource and the array of the arguments' words, which has
/// a word to spare past them. A clause's slot has the clause's record in its `handle`'s instance as
/// its environment: the clause's closure, the instance and the clause's place. `ply_answers` answers
/// the perform with what the clause answers; `ply_resumes` hands the clause a continuation in the
/// spare word, which records what it is resumed with, and a clause that did not resume unwinds to
/// its instance with what it answered; `ply_raises` leaves the raise's arguments in the instance and
/// unwinds to it, whose landing runs the clause. A perform a clause answers is recorded where the
/// context arms recording; the runtime records no raise. `ply_instance_each` is the `each` of the
/// frame record an instance holds its variables in: the place of its first and their count, then
/// the instance. `ply_pending_raised` raises a raise left pending through word `w`.
fn entries_defined() -> Bytes =
  Bytes::concat_all([
    b"#define PLY_FAILED_TARGET ",
    ascii_of_int(failed_target()),
    b"\n#define PLY_FAILED_PENDING ",
    ascii_of_int(failed_pending()),
    b"\n",
    b"typedef Word (*PlyEntry)(PlyCtx *, Word, Word, Word, Word, Word);\n",
    b"static inline Word ply_perform(PlyCtx *ctx, Word w, int64_t k, Word op, Word mode, Word res, Word args) {\n",
    b"  const Word *o = (const Word *)(intptr_t)w;\n",
    b"  return ((PlyEntry)(intptr_t)o[1 + 2 * k])(ctx, o[2 + 2 * k], op, mode, res, args);\n",
    b"}\n",
    b"static inline Word ply_uniform(PlyCtx *ctx, Word f, const Word *args) {\n",
    b"  return ((const PlyFnDesc *)(intptr_t)ply_words(f)[0])->uniform(ctx, f, args);\n",
    b"}\n",
    b"static Word ply_answers(PlyCtx *ctx, Word env, Word op, Word mode, Word res, Word args) {\n",
    b"  const Word *e = (const Word *)(intptr_t)env;\n",
    b"  if (ctx->recording) rt_performed_p(ctx, op, res, mode);\n",
    b"  return ply_uniform(ctx, e[0], (const Word *)(intptr_t)args);\n",
    b"}\n",
    b"static Word ply_resumed(PlyCtx *ctx, Word self, const Word *args) {\n",
    b"  Word *k = ply_words(self);\n",
    b"  (void)ctx;\n",
    b"  k[1] = args[0]; k[2] = 1;\n",
    b"  return args[0];\n",
    b"}\n",
    b"static Word ply_resumed_kept(PlyCtx *ctx, Word self) { (void)ctx; (void)self; return 0; }\n",
    b"static const PlyFnDesc ply_resumed_desc = { ply_resumed, 0, 0, ply_resumed_kept, ply_resumed_kept, ply_resumed_kept };\n",
    b"static Word ply_resumes(PlyCtx *ctx, Word env, Word op, Word mode, Word res, Word args) {\n",
    b"  const Word *e = (const Word *)(intptr_t)env;\n",
    b"  Word *a = (Word *)(intptr_t)args;\n",
    b"  Word k[4] = { (Word)PLY_RC_FRAME, (Word)(intptr_t)&ply_resumed_desc, 0, 0 };\n",
    b"  if (ctx->recording) rt_performed_p(ctx, op, res, mode);\n",
    b"  a[((const PlyOp *)(intptr_t)op)->params_len] = (Word)(intptr_t)k;\n",
    b"  Word r = ply_uniform(ctx, e[0], a);\n",
    b"  if (ctx->failed || k[3]) return ctx->failed ? 0 : r;\n",
    b"  Word *in = (Word *)(intptr_t)e[1];\n",
    b"  in[1] = -1; in[2] = r;\n",
    b"  ctx->target = e[1]; ctx->failed = PLY_FAILED_TARGET;\n",
    b"  return 0;\n",
    b"}\n",
    b"static Word ply_raises(PlyCtx *ctx, Word env, Word op, Word mode, Word res, Word args) {\n",
    b"  const Word *e = (const Word *)(intptr_t)env;\n",
    b"  const Word *a = (const Word *)(intptr_t)args;\n",
    b"  Word *in = (Word *)(intptr_t)e[1];\n",
    b"  (void)mode; (void)res;\n",
    b"  in[1] = e[2];\n",
    b"  for (int64_t i = 0; i < ((const PlyOp *)(intptr_t)op)->params_len; i++) in[",
    ascii_of_int(raised_at()),
    b" + i] = a[i];\n",
    b"  ctx->target = e[1]; ctx->failed = PLY_FAILED_TARGET;\n",
    b"  return 0;\n",
    b"}\n",
    b"static void ply_instance_each(PlyCtx *ctx, Word *s, int64_t d) {\n",
    b"  const Word *in = s + 2;\n",
    b"  for (int64_t i = 0; i < s[1]; i++) {\n",
    b"    const PlyType *t = (const PlyType *)(intptr_t)in[s[0] + 2 * i + 1];\n",
    b"    if (t && d > 0) t->inc(ctx, in[s[0] + 2 * i]); else if (t) t->dec(ctx, in[s[0] + 2 * i]);\n",
    b"  }\n",
    b"}\n",
    b"static inline void ply_pending_raised(PlyCtx *ctx, Word w, int64_t k, Word op, Word string) {\n",
    b"  if (ctx->failed != PLY_FAILED_PENDING) return;\n",
    b"  Word m[2] = { rt_pending_raised_p(ctx, string), 0 };\n",
    b"  if (!ctx->failed) ply_perform(ctx, w, k, op, 2, -1, (Word)(intptr_t)m);\n",
    b"}\n",
  ])

/// How a closure's entry reads its own words off what its caller hands, where the caller names
/// another row: a row's descriptor holds its count, then each word's effect and resource, `-3` for a
/// label handed past the words, in order. Each of the closure's words is the caller's that answers
/// the same effect on a resource covering its own, the `n`th alike for the `n`th, and the frame
/// bridge where the caller names none, as where the runtime calls it handing nothing.
fn words_mapped() -> Bytes =
  Bytes::concat_all([
    b"static inline Word ply_row_label(const Word *row, const Word *labels, int64_t i) {\n",
    b"  int64_t left = 0;\n",
    b"  for (int64_t j = 0; j < i; j++) if (row[2 + 2 * j] == -3) left++;\n",
    b"  return row[2 + 2 * i] == -3 ? labels[left] : row[2 + 2 * i];\n",
    b"}\n",
    b"static inline void ply_words_mapped(PlyCtx *ctx, const Word *own, const Word *labels, const Word *site, const Word *words, Word *out) {\n",
    b"  int64_t n = own[0], m = site ? site[0] : 0;\n",
    b"  for (int64_t i = 0; i < n; i++) {\n",
    b"    Word effect = own[1 + 2 * i], label = ply_row_label(own, labels, i);\n",
    b"    int64_t alike = 0;\n",
    b"    for (int64_t j = 0; j < i; j++) if (own[1 + 2 * j] == effect && ply_row_label(own, labels, j) == label) alike++;\n",
    b"    out[i] = ctx->bridge;\n",
    b"    for (int64_t j = 0; j < m; j++) {\n",
    b"      if (site[1 + 2 * j] != effect) continue;\n",
    b"      if (site[2 + 2 * j] != -2 && ply_row_label(site, words + m, j) != label) continue;\n",
    b"      if (alike-- == 0) { out[i] = words[j]; break; }\n",
    b"    }\n",
    b"  }\n",
    b"}\n",
  ])

/// The head's C function answering the byte string of the one byte `b`, from 0 to 255: an immortal
/// block `tail_part` lays out once for the unit.
pub fn byte_text_fn() -> Bytes = b"ply_byte_text"

/// The type and the table `byte_text_fn` answers from, declared, and `byte_text_fn` defined.
fn byte_texts_declared() -> Bytes =
  Bytes::concat_all([
    b"typedef struct { PlyObj h; ",
    text_head().name,
    b" head; unsigned char b[8]; } PlyByteText;\n",
    b"extern const PlyByteText ply_byte_texts[256];\n",
    b"static inline Word ",
    byte_text_fn(),
    b"(PlyCtx *ctx, int64_t b) { (void)ctx; return (Word)(intptr_t)&ply_byte_texts[b]; }\n",
  ])

/// The emitter's part of a unit's tail, which the unit defines once: the byte string of each byte
/// `byte_text_fn` answers.
fn tail_part() -> Bytes =
  Bytes::concat_all([
    b"const PlyByteText ply_byte_texts[256] = {\n",
    Bytes::concat_all(
      range(0, 256).map(|b: Int|
        Bytes::concat_all([
          b"  { { .rc = UINT32_MAX }, { .len = 1, .room = 1 }, { ",
          ascii_of_int(b),
          b" } },\n",
        ])),
    ),
    b"};\n",
  ])

/// The sequences printers would otherwise write at each use, defined once: a function's entry, a
/// list's item and leaf, a block copied or kept or marked shared, and an object made writable.
fn shared_sequences() -> Bytes =
  Bytes::concat_all([entered_helper(), list_helpers(), walk_helpers(), writable_helper()])

/// The head's C function answering the object `a` held once, copied by `copy` where another holds
/// it too, the write counted as in place or of a copy of `n` words.
pub fn writable_fn() -> Bytes = b"ply_writable"

/// `writable_fn`'s definition. `n` is read off the object before it is copied, which a copy holds
/// alike.
fn writable_helper() -> Bytes =
  Bytes::concat_all([
    b"static inline Word ",
    writable_fn(),
    b"(PlyCtx *ctx, Word a, PlyDrop copy, int64_t n) { int in_place = ply_obj(a)->rc == 1; if (!in_place) a = copy(ctx, a); rt_note_update_p(ctx, in_place, in_place ? 0 : n); return a; }\n",
  ])

/// A drop root's entry and exit, over the context's counters of nested drop roots and of releases
/// put off.
fn drops() -> Bytes / {abort.raise} = {
  let depth = b"ctx->release_depth";
  Bytes::concat_all([
    b"static inline int ply_drop_deep(PlyCtx *ctx, Word o, PlyDrop d) {\n",
    Bytes::concat_all([
      b"  if (",
      depth,
      b" >= ",
      ascii_of_int(release_depth()),
      b") { ",
      call_text(release_later_fn(), [b"ctx", b"o", b"(Word)(intptr_t)d"]),
      b"; return 1; }\n",
    ]),
    Bytes::concat_all([b"  ", depth, b" += 1;\n"]),
    b"  return 0;\n",
    b"}\n",
    b"static inline void ply_drop_done(PlyCtx *ctx) {\n",
    Bytes::concat_all([
      b"  if (--",
      depth,
      b" == 0 && ctx->release_waiting != 0) ",
      call_text(release_drain_fn(), [b"ctx"]),
      b";\n",
    ]),
    b"}\n",
  ])
}

fn helpers() -> Bytes = {
  let floor = ascii_of_int(pointer_floor());
  let tags = ascii_of_int((1 << tag_bits()) - 1);
  Bytes::concat_all([
    b"static inline int ",
    call_text(last_fn(), [b"PlyCtx *ctx", b"Word o"]),
    b" {\n",
    b"  PlyObj *h = ply_obj(o);\n",
    b"  uint32_t rc = h->rc;\n",
    b"  if (rc >= PLY_RC_FRAME) return 0;\n",
    b"  if (rc >= UINT32_C(0x80000000)) return (int)",
    call_text(dec_shared_last_fn(), [b"ctx", b"o"]),
    b";\n",
    b"  if (rc > 1) { h->rc = rc - 1; return 0; }\n",
    b"#ifdef PLY_CHECKED\n",
    b"  if (rc == 0) ",
    call_text(released_twice_fn(), [b"ctx", b"o"]),
    b";\n",
    b"#endif\n",
    b"  return 1;\n",
    b"}\n",
    b"static inline void ",
    call_text(dup_fn(), [b"Word o"]),
    b" {\n",
    b"  if (!o) return;\n",
    b"  PlyObj *h = ply_obj(o);\n",
    b"  uint32_t rc = h->rc;\n",
    b"  if (rc < UINT32_C(0x80000000)) h->rc = rc + 1;\n",
    b"  else if (rc < PLY_RC_FRAME) ",
    call_text(inc_shared_fn(), [b"0", b"o"]),
    b";\n",
    b"}\n",
    b"typedef Word (*PlyDrop)(PlyCtx *, Word);\n",
    b"static inline void ",
    call_text(rel_fn(), [b"PlyCtx *ctx", b"Word o", b"PlyDrop d"]),
    b" {\n",
    b"  if (o && ",
    call_text(last_fn(), [b"ctx", b"o"]),
    b") d(ctx, o);\n",
    b"}\n",
    b"static inline void ",
    call_text(rel_sum_fn(), [b"PlyCtx *ctx", b"Word w", b"PlyDrop d"]),
    b" {\n",
    Bytes::concat_all([
      b"  if ((uint64_t)w >= ",
      floor,
      b" && ",
      call_text(last_fn(), [b"ctx", b"w & ~(Word)".concat(tags)]),
      b") d(ctx, w);\n",
    ]),
    b"}\n",
    b"static inline void ",
    call_text(free_fn(), [b"PlyCtx *ctx", b"Word o", b"int64_t bytes"]),
    b" {\n",
    b"  ",
    call_text(free_block_fn(), [b"ctx", b"o", b"bytes"]),
    b";\n",
    b"}\n",
    b"static inline void ",
    call_text(rel_box_fn(), [b"PlyCtx *ctx", b"Word o", b"int64_t bytes"]),
    b" {\n",
    Bytes::concat_all([
      b"  if (o && ",
      call_text(last_fn(), [b"ctx", b"o"]),
      b") ",
      call_text(free_fn(), [b"ctx", b"o", b"bytes"]),
      b";\n",
    ]),
    b"}\n",
    described_heads(tags),
  ])
}

/// What a type's descriptor counts and lets go of a word form by, where that form holds no block a
/// root lets go of (`release.word_form_heads`): a word of no count's, a scalar's box of each size; and what it lifts by where a value of its type can hold a function, the runtime's refusal.
fn described_heads(tags: Bytes) -> Bytes = {
  let fn_of = |name: Bytes, body: Bytes|
    Bytes::concat_all([b"static inline Word ", name, b"(PlyCtx *ctx, Word w) { ", body, b" }\n"]);
  let immediate = immediate_heads();
  let dup = call_text(dup_fn(), [b"w"]);
  Bytes::concat_all([
    fn_of(immediate.dup, b"(void)ctx; return w;"),
    fn_of(immediate.release, b"(void)ctx; (void)w; return 0;"),
    fn_of(box_heads(2).dup, Bytes::concat_all([b"(void)ctx; ", dup, b"; return w;"])),
    Bytes::concat_all(
      scalar_box_words().map(|n: Int|
        fn_of(
          box_heads(n).release,
          call_text(rel_box_fn(), [b"ctx", b"w", ascii_of_int(header_bytes() + 8 * n)]).concat(
            b"; return 0;",
          ),
        )),
    ),
    Bytes::concat_all([
      b"static inline Word ",
      call_text(never_lifted_fn(), [b"PlyCtx *ctx"]),
      b" { ",
      call_text(never_lifted_rt_fn(), [b"ctx"]),
      b"; return 0; }\n",
    ]),
  ])
}

/// Each machine struct declared in its order, then each head a block keeps its counts in.
fn structs() -> Bytes = Bytes::concat_all(machine_structs().concat(head_structs()).map(declared))

/// `s` declared, each field as it declares it, the C compiler's alignment placing each at its offset
/// (`naturally_laid` holds every struct to that), padded past its last field to its size, and its
/// size checked: a C compiler that lays it out otherwise refuses the unit. A hole between fields is
/// never a member: emitted code initialises these structs by position.
fn declared(s: MachineStruct) -> Bytes = {
  let laid = s.fields.fold(
    { at: 0, text: b"" },
    |acc: { at: Int, text: Bytes }, f: MachineField|
      { at: f.at + f.bytes, text: Bytes::concat_all([acc.text, b"  ", f.decl, b";\n"]) },
  );
  Bytes::concat_all([
    b"typedef struct ",
    s.name,
    b" {\n",
    laid.text,
    gap(laid.at, s.bytes),
    b"} ",
    s.name,
    b";\n",
    b"typedef char ply_sized_",
    s.name,
    b"[sizeof(",
    s.name,
    b") == ",
    ascii_of_int(s.bytes),
    b" ? 1 : -1];\n",
  ])
}

/// Whether every field of `s` starts where the one before it ended, or past it by less than a word:
/// a hole alignment does not make would be laid as nothing, since `declared` writes no member there.
fn naturally_laid(s: MachineStruct) -> Bool =
  s.fields.fold({ at: 0, laid: true }, |acc: { at: Int, laid: Bool }, f: MachineField|
    { at: f.at + f.bytes, laid: acc.laid && f.at >= acc.at && f.at - acc.at < 8 }).laid

test "every struct the head declares is laid as its fields' alignment lays it, with no hole of its own" {
  assert_eq(
    machine_structs().concat(head_structs()).filter(|s: MachineStruct| !naturally_laid(s)).map(
      |s: MachineStruct| s.name,
    ),
    [],
  );
  // A field after a narrower one is placed by the compiler, never by a member standing for the gap.
  assert(structs().index_of(b"  char ply_gap_20[4];\n  Word (*inc)") == None, None)
}

fn gap(from: Int, to: Int) -> Bytes =
  if to <= from { b"" } else {
    Bytes::concat_all([
      b"  char ply_gap_",
      ascii_of_int(from),
      b"[",
      ascii_of_int(to - from),
      b"];\n",
    ])
  }

/// The body of function `f` the head defines: from where its name is first followed by its
/// parameters to the end of its body; empty where the head defines none.
fn defined_in(h: Bytes, f: Bytes) -> Bytes / {abort.raise} =
  match h.index_of(Bytes::concat_all([b" ", f, b"("])) {
    Some(i) -> match h.index_of_from(b"}\n", i) { Some(j) -> h.slice(i, j), None -> b"" },
    None -> b"",
  }

test "a release takes the count, the last one dropping the block, and a checked build traps a count already 0" {
  let h = head_part();
  let checked = match h.index_of(b"#ifdef PLY_CHECKED") {
    Some(i) -> match h.index_of_from(b"#endif", i) { Some(j) -> h.slice(i, j), None -> b"" },
    None -> b"",
  };
  assert(checked.index_of(b"rc == 0") != None, None);
  // A block given back is counted 0; its kind says nothing a count does not.
  assert_eq(checked.index_of(b"kind"), None);
  // Each release is defined, and goes through `ply_last`; a sum's word only where it points at a
  // block.
  [rel_fn(), rel_sum_fn(), rel_box_fn(), free_fn()].fold((), |_: Unit, f: Bytes|
    assert(defined_in(h, f).len() > 0, Some(String::of_bytes_lossy(f))));
  assert(defined_in(h, rel_sum_fn()).index_of(ascii_of_int(pointer_floor())) != None, None);
  // A scalar's box holds nothing counted: its last count gives it back by its size.
  let boxed = defined_in(h, rel_box_fn());
  assert(calls(boxed, last_fn()) && calls(boxed, free_fn()), Some(String::of_bytes_lossy(boxed)));
  // A descriptor names these where a word form holds no block a root lets go of: each is defined,
  // a box's release for each size a scalar's box comes in.
  let named = [immediate_heads()].concat(scalar_box_words().map(box_heads)).fold(
    [],
    |acc: List<Bytes>, x: { dup: Bytes, release: Bytes }| acc.push(x.dup).push(x.release),
  );
  assert_eq(named.filter(|n: Bytes| defined_in(h, n).len() == 0), []);
  assert(calls(defined_in(h, box_released_fn(2)), rel_box_fn()), None)
}

test "a descriptor lifts a type a value of which can hold a function by the runtime's refusal" {
  assert(calls(defined_in(head_part(), never_lifted_fn()), never_lifted_rt_fn()), None)
}

test "a drop root nests to the release depth, then puts its block off; the outermost drains what was put off" {
  let h = head_part();
  let deep = defined_in(h, b"ply_drop_deep");
  let done = defined_in(h, b"ply_drop_done");
  assert(deep.index_of(b"ctx->release_depth") != None, None);
  assert(deep.index_of(ascii_of_int(release_depth())) != None, None);
  assert(calls(deep, release_later_fn()), None);
  assert(done.index_of(b"ctx->release_depth") != None, None);
  assert(done.index_of(b"ctx->release_waiting") != None, None);
  assert(calls(done, release_drain_fn()), None)
}

test "the head declares the context and a block's header field by field, at their offsets" {
  let h = unit_head();
  [obj_struct(), ctx_struct()].fold((), |_: Unit, s: MachineStruct| {
    let from = match h.index_of(Bytes::concat_all([b"typedef struct ", s.name, b" {"])) {
      Some(i) -> i,
      None -> panic(String::of_bytes_lossy(b"the head declares no ".concat(s.name))),
    };
    s.fields.fold(from, |last: Int, f: MachineField|
      match h.index_of_from(f.decl, last) {
        Some(i) -> i,
        None ->
          panic(String::of_bytes_lossy(b"a field the head does not declare: ".concat(f.decl))),
      });
    assert(
      h.index_of(Bytes::concat_all([b"sizeof(", s.name, b") == ", ascii_of_int(s.bytes)])) != None,
      None,
    )
  });
  // The count takes the low half of the header's word; the rest is padding.
  assert(h.index_of(b"  uint32_t rc;\n  char ply_gap_4[4];\n} PlyObj;") != None, None)
}

test "the head declares a pointer to each function the unit binds once, and the tail defines it and binds it in the unit's order" {
  let h = unit_head();
  let t = unit_tail([]);
  let all = bound();
  assert(all.len() == abi::helpers().len() + natives().len(), None);
  range(0, all.len()).fold((), |_: Unit, i: Int| {
    let n = all.get(i);
    let p = pointer(n);
    assert(
      h.split(Bytes::concat_all([b"extern ", p, b";\n"])).len() == 2,
      Some(String::of_bytes_lossy(p)),
    );
    assert(t.split(p.concat(b";\n")).len() == 2, Some(String::of_bytes_lossy(p)));
    let bind = Bytes::concat_all([
      b"  ",
      n.name,
      b"_p = (",
      answered_c(n),
      b" (*)(",
      params_c(n),
      b"))fns[",
      ascii_of_int(i),
      b"];\n",
    ]);
    assert(t.index_of(bind) != None, Some(String::of_bytes_lossy(bind)))
  });
  assert(t.starts_with(b"\n".concat(tail_mark())), None);
  // A native is bound under its helper's name; one that answers nothing is `void`.
  assert(
    h.index_of(b"extern void (*builtin_elaborated_out_str_p)(PlyCtx*, Word, Word);\n") != None,
    None,
  );
  assert(h.index_of(b"extern Word (*rt_alloc_bytes_p)(PlyCtx*, Word);\n") != None, None)
}

test "a shipped module's native a unit calls is no part of the head, and the tail defines and binds it after the rest" {
  let cpus = { name: b"builtin_os_cpus", params: [], answer: Some(abi::I64), raises: false };
  let named = {
    name: b"builtin_os_user_name",
    params: [abi::I64],
    answer: Some(abi::Taken),
    raises: false,
  };
  let t = unit_tail([cpus, named]);
  assert(unit_head().index_of(b"builtin_os_cpus") == None, None);
  assert_eq(pointer_declared(cpus), b"extern Word (*builtin_os_cpus_p)(PlyCtx*);\n");
  assert(t.index_of(b"Word (*builtin_os_user_name_p)(PlyCtx*, Word);\n") != None, None);
  let n = bound().len();
  assert(
    t.index_of(
        Bytes::concat_all([
          b"  builtin_os_cpus_p = (Word (*)(PlyCtx*))fns[",
          ascii_of_int(n),
          b"];\n  builtin_os_user_name_p = (Word (*)(PlyCtx*, Word))fns[",
          ascii_of_int(n + 1),
          b"];\n",
        ]),
      )
      != None,
    None,
  )
}

test "each machine struct is declared before one that points at it, its fields in order, its size checked" {
  let h = head_part();
  let at = |s: Bytes|
    match h.index_of(Bytes::concat_all([b"typedef struct ", s, b" {"])) {
      Some(i) -> i,
      None -> 0 - 1,
    };
  let order = machine_structs().map(|s: MachineStruct| at(s.name));
  assert(order.all(|i: Int| i >= 0), None);
  assert_eq(order.sort(), order);
  machine_structs().fold((), |_: Unit, s: MachineStruct| {
    let from = at(s.name);
    let placed = s.fields.fold(from, |last: Int, f: MachineField|
      match h.index_of_from(f.decl, last) {
        Some(i) -> i,
        None ->
          panic(String::of_bytes_lossy(b"a field the head does not declare: ".concat(f.decl))),
      });
    assert(placed > from, None);
    assert(
      h.index_of(Bytes::concat_all([b"sizeof(", s.name, b") == ", ascii_of_int(s.bytes)])) != None,
      None,
    )
  })
}

test "each sequence the printers share is defined once in the head, as a function a use calls" {
  let h = head_part();
  let shared = [
    entered_fn(),
    item_fn(),
    leaf_fn(),
    kept_block_fn(),
    fresh_block_fn(),
    unshared_fn(),
    mark_fn(),
    writable_fn(),
  ];
  assert_eq(shared.filter(|f: Bytes| h.split(f.concat(b"(")).len() != 2), []);
  // A function's entry spends its fuel, makes room below the stack and counts a tick.
  assert(
    h.index_of(entered_helper()) != None
      && [b"ctx->fuel", b"rt_stack_more_p(ctx)", b"rt_tick_p(ctx)"].all(|part: Bytes|
        entered_helper().index_of(part) != None),
    None,
  );
  // A block copied takes its payload alone: its allocation sets its count.
  let kept = defined_in(h, kept_block_fn());
  assert(kept.index_of(b"->") == None, Some(String::of_bytes_lossy(kept)))
}
