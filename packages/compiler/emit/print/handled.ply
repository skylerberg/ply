//! A `handle`'s framing printed around the body the printer's driver prints, and the operations on
//! effects: a perform, a label, a `parallel` block, a `simulate`, and an extern the runtime answers
//! over its arguments' encoding. Each hands the runtime its operands in an array of words and names
//! effects, operations and resources by their field-table entries, and a builtin by its place in the
//! unit's table of them.

import std.bytes (ascii_of_int)
import compiler.emit.pieces (Piece, Text, Hole, BuiltinAt)
import compiler.emit.tir (Var, Arg, Uses, Handling)
import compiler.emit.tir.handling (HandleOp, Perform, Label, Parallel, Simulate, Encoded, Unsettled,
                                   WordsLaid, WordAt, Bridge, Instance, ObjectLaid, VarInit,
                                   VarRead, VarWrite, Entering, Slot, Answering, Forwarding, Entry,
                                   Answers, Resumes, Raises, Clause, HandleSite, HandleInstance,
                                   Reached, raised_at)
import compiler.emit.print.text (Printing, Place, line, pad, temp, named, name_of, arg_text,
                                 assigned, site, check, field_hole, interned, unprinted)
import compiler.emit.print.made (c_type)
import compiler.emit.layout (header_bytes)

/// What opens `Handle` `label` laying out `site` over `args`. In place: its answer declared, its
/// clauses' table, the frame pushed, and the block its body runs in; over an instance, the instance
/// set up instead of a frame. Detached: the whole handle, its answer into `answer`.
pub fn handle_opened(
  p: Place,
  pr: Printing,
  label: Int,
  args: List<Arg>,
  uses: Uses,
  site: HandleSite,
  answer: Var,
) -> Printing =
  match site.instance {
    Some(i) -> instance_opened(p, pr, args, site, i, answer),
    None -> framed_opened(p, pr, label, args, site, answer),
  }

/// What opens a `handle` that answers through evidence objects over instance `i`: its answer
/// declared, the fuel it stands at, the descriptor of what it answers where a clause may stop it,
/// and each clause's record set in the instance, and the block its body runs in. A record's place
/// is the clause's, counted from 1, as word 1 of the instance names a raise clause.
fn instance_opened(
  p: Place,
  pr: Printing,
  args: List<Arg>,
  site: HandleSite,
  i: HandleInstance,
  answer: Var,
) -> Printing = {
  let a = named(
    {
      ..pr,
      handles: pr.handles.concat(
        site.clauses.map(|c: Clause| Bytes::concat_all([c.effect, b"#", c.op])),
      ),
    },
    answer,
  );
  let inst = |at: Int| instance_word(pr, args, i.operand, at);
  let set = |q: Printing, lhs: Bytes, rhs: Bytes|
    line(q, p.depth, Bytes::concat_all([lhs, b" = ", rhs, b";"]));
  let fueled = set(
    line(a.pr, p.depth, Bytes::concat_all([c_type(answer.rep), b" ", a.name, b" = 0;"])),
    inst(0),
    b"ctx->fuel",
  );
  let described = match i.answer {
    Some(d) -> set(fueled, inst(3), operand(pr, args, d)),
    None -> fueled,
  };
  let recorded = range(0, site.clauses.len()).fold(described, |q: Printing, k: Int|
    match ((site.clauses.at(k), i.records.at(k))) {
      (Some(c), Some(at)) ->
        set(
          set(
            set(q, inst(at), operand(pr, args, c.handler)),
            inst(at + 1),
            operand(pr, args, i.operand),
          ),
          inst(at + 2),
          ascii_of_int(k + 1),
        ),
      _ -> q,
    });
  line(vars_linked(p, recorded, inst(0), i), p.depth, b"{")
}

/// What opens a `handle` the runtime's frames hold, as `handle_opened` says.
fn framed_opened(
  p: Place,
  pr: Printing,
  label: Int,
  args: List<Arg>,
  site: HandleSite,
  answer: Var,
) -> Printing =
  match site.detached {
    Some(body) -> {
      let t = table(p, pr, args, site);
      check(
        p,
        assigned(
          t.pr,
          p.depth,
          answer,
          c_type(answer.rep),
          Bytes::concat_all([
            b"rt_handle_install_detached_p(ctx, (Word)(intptr_t)",
            t.name,
            b", ",
            ascii_of_int(site.clauses.len()),
            b", ",
            returned(site, args, t.pr),
            b", ",
            operand(t.pr, args, body),
            b")",
          ]),
        ),
      )
    },
    None -> {
      let a = named(pr, answer);
      let t = table(
        p,
        line(a.pr, p.depth, Bytes::concat_all([c_type(answer.rep), b" ", a.name, b" = 0;"])),
        args,
        site,
      );
      let d = temp(t.pr);
      let pushed = line(
        d.pr,
        p.depth,
        Bytes::concat_all([
          b"int64_t ",
          d.name,
          b" = rt_handle_install_p(ctx, (Word)(intptr_t)",
          t.name,
          b", ",
          ascii_of_int(site.clauses.len()),
          b", ",
          returned(site, args, d.pr),
          b");",
        ]),
      );
      line({ ..pushed, names: pushed.names.insert(depth_key(label), d.name) }, p.depth, b"{")
    },
  }

/// The C a failure inside the body of `Handle` `label` runs, after its own releases, to reach the
/// handle's landing.
pub fn landing_jump(label: Int) -> Bytes =
  Bytes::concat_all([b"goto ply_h", ascii_of_int(label), b";"])

/// What closes `Handle` `label`: the body's block, then its landing, where the frame is popped and
/// what the handle answers is read, a failure a clause answers carrying on from there and any other
/// leaving by `p.leave`, releasing what the handle holds across its body. A detached handle was
/// whole when it opened.
pub fn handle_closed(
  p: Place,
  pr: Printing,
  label: Int,
  args: List<Arg>,
  site: HandleSite,
  answer: Var,
) -> Printing =
  match ((site.instance, site.detached)) {
    (Some(i), _) -> instance_landed(p, pr, label, args, site, i, answer),
    (None, Some(_)) -> pr,
    (None, None) -> {
      let landed = line(
        line(pr, p.depth, b"}"),
        p.depth,
        Bytes::concat_all([b"ply_h", ascii_of_int(label), b": ;"]),
      );
      check(
        p,
        assigned(
          landed,
          p.depth,
          answer,
          c_type(answer.rep),
          Bytes::concat_all([
            b"rt_handle_land_p(ctx, ",
            match pr.names.get(depth_key(label)) { Some(d) -> d, None -> b"0" },
            b", ",
            name_of(pr, answer),
            b")",
          ]),
        ),
      )
    },
  }

/// What closes `Handle` `label` answering through evidence objects over instance `i`: the body's
/// block, then its landing. An unwind to this instance answers what its clause left, or runs the
/// raise clause it names on the arguments it left; a raise pending where an `abort.raise` clause
/// is runs that clause on its message; a body that answered goes through the return clause. Then
/// what the instance holds of an unwind another failure replaced is let go, then the variables by
/// their types, and any other failure leaves by `p.leave`.
fn instance_landed(
  p: Place,
  pr: Printing,
  label: Int,
  args: List<Arg>,
  site: HandleSite,
  i: HandleInstance,
  answer: Var,
) -> Printing = {
  let d = p.depth;
  let inst = |at: Int| instance_word(pr, args, i.operand, at);
  let ans = name_of(pr, answer);
  let landed = line(
    line(pr, d, b"}"),
    d,
    Bytes::concat_all([b"ply_h", ascii_of_int(label), b": ;"]),
  );
  let raises = range(0, site.clauses.len()).fold([], |acc: List<Bytes>, k: Int|
    match site.clauses.at(k) {
      Some(c) -> if c.mode != 3 { acc } else {
        acc.push(
          Bytes::concat_all([
            b"  else if (ply_held == ",
            ascii_of_int(k + 1),
            b") ",
            ans,
            b" = ply_uniform(ctx, ",
            operand(pr, args, c.handler),
            b", &",
            inst(raised_at()),
            b");",
          ]),
        )
      },
      None -> acc,
    });
  // What the unwind carries is the clause's now, so the instance holds nothing past it.
  let unwound = Bytes::concat_all([
    b"if (ctx->failed == PLY_FAILED_TARGET && ctx->target == ",
    operand(pr, args, i.operand),
    b") {\n",
    pad(d + 1),
    b"Word ply_held = ",
    inst(1),
    b"; ",
    inst(1),
    b" = 0; ctx->failed = 0; ctx->fuel = ",
    inst(0),
    b";\n",
    pad(d + 1),
    b"if (ply_held == -1) ",
    ans,
    b" = ",
    inst(2),
    b";\n",
    Bytes::concat_all(raises.map(|r: Bytes| Bytes::concat_all([pad(d), r, b"\n"]))),
    pad(d),
    b"}",
  ]);
  // A pending raise gives back the calls it unwound as a raise to the instance does.
  let pending = match i.pending {
    None -> b"",
    Some(k) -> match site.clauses.at(k) {
      Some(c) ->
        Bytes::concat_all([
          b" else if (ctx->failed == PLY_FAILED_PENDING) {\n",
          pad(d + 1),
          b"ctx->fuel = ",
          inst(0),
          b";\n",
          pad(d + 1),
          b"Word m[2] = { rt_pending_raised_p(ctx, ",
          match c.string { Some(s) -> operand(pr, args, s), None -> b"0" },
          b", 0), 0 };\n",
          pad(d + 1),
          b"if (!ctx->failed) ",
          ans,
          b" = ply_uniform(ctx, ",
          operand(pr, args, c.handler),
          b", m);\n",
          pad(d),
          b"}",
        ]),
      None -> b"",
    },
  };
  let returned = match site.ret {
    None -> b"",
    Some(r) ->
      Bytes::concat_all([
        b" else if (!ctx->failed) ",
        ans,
        b" = ply_uniform(ctx, ",
        operand(pr, args, r),
        b", &",
        ans,
        b");",
      ]),
  };
  // What an unwind left here that another replaced, or that leaves past it, is let go.
  let answered = line(
    line(landed, d, Bytes::concat_all([unwound, pending, returned])),
    d,
    Bytes::concat_all([
      b"if (",
      inst(1),
      b") ply_held_let_go(ctx, (Word *)(intptr_t)",
      operand(pr, args, i.operand),
      b");",
    ]),
  );
  let released = range(0, i.count).fold(
    vars_unlinked(p, answered, inst(0), i),
    |q: Printing, j: Int| {
      let at = i.vars + 2 * j;
      line(
        q,
        d,
        Bytes::concat_all([
          b"if (",
          inst(at + 1),
          b") ((const PlyType *)(intptr_t)",
          inst(at + 1),
          b")->dec(ctx, ",
          inst(at),
          b");",
        ]),
      )
    },
  );
  check(p, released)
}

/// Operation `op` on effects over `args`, its answer into `into`.
pub fn effect_op(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  op: HandleOp,
  args: List<Arg>,
  uses: Uses,
) -> Printing / {abort.raise} =
  match op {
    Perform(x) -> performed(p, pr, into, x, args),
    Label(name) -> match into {
      None -> pr,
      Some(v) -> {
        let f = field_hole(pr, name);
        let n = named(f.pr, v);
        spliced(n.pr, p.depth, [
          Text(Bytes::concat_all([c_type(v.rep), b" ", n.name, b" = "])),
          f.piece,
          Text(b";"),
        ])
      },
    },
    Parallel(x) -> ran(p, pr, into, x.reach, args),
    Simulate ->
      check(
        p,
        answered(site(p, { ..pr, handles: pr.handles.concat(scheduled_ops()) }), p.depth, into, [
          Text(
            Bytes::concat_all([
              b"rt_region_p(ctx, ",
              operand(pr, args, 0),
              b", ",
              operand(pr, args, 1),
              b")",
            ]),
          ),
        ]),
      ),
    // Bound, it answers a word nothing reads: its builtin only raises.
    Encoded(name) -> {
      let b = interned(pr.builtins, name);
      let sited = site(p, { ..pr, builtins: b.xs });
      check(p, match into {
        None ->
          spliced(sited, p.depth, [
            Text(b"rt_builtin_encoded_p(ctx, "),
            Hole(BuiltinAt(b.at)),
            Text(b");"),
          ]),
        Some(_) ->
          answered(sited, p.depth, into, [
            Text(b"(rt_builtin_encoded_p(ctx, "),
            Hole(BuiltinAt(b.at)),
            Text(b"), 0)"),
          ]),
      })
    },
    Unsettled(name) -> unprinted(Handling, b"a crossing settled by its callers only", name),
    WordsLaid -> match into {
      None -> pr,
      Some(v) -> {
        let arr = temp(pr);
        let laid = line(
          arr.pr,
          p.depth,
          Bytes::concat_all([
            b"Word ",
            arr.name,
            b"[] = {",
            Bytes::join(args.map(|a: Arg| arg_text(pr, a)), b", "),
            b"};",
          ]),
        );
        let n = named(laid, v);
        line(
          n.pr,
          p.depth,
          Bytes::concat_all([b"Word ", n.name, b" = (Word)(intptr_t)", arr.name, b";"]),
        )
      },
    },
    WordAt(i) -> match into {
      None -> pr,
      Some(v) -> {
        let n = named(pr, v);
        line(
          n.pr,
          p.depth,
          Bytes::concat_all([
            b"Word ",
            n.name,
            b" = ((const Word *)(intptr_t)",
            operand(pr, args, 0),
            b")[",
            ascii_of_int(i),
            b"];",
          ]),
        )
      },
    },
    Bridge -> word_set(p, pr, into, b"ctx->bridge"),
    Entering ->
      line(
        pr,
        p.depth,
        Bytes::concat_all([
          b"ctx->entering_desc = ",
          operand(pr, args, 0),
          b"; ctx->entering_words = ",
          operand(pr, args, 1),
          b";",
        ]),
      ),
    Instance(n) -> instance_laid(p, pr, into, n),
    ObjectLaid(slots) ->
      laid_set(
        p,
        pr,
        into,
        ascii_of_int(1 + 2 * slots.len()),
        [b"0"].concat(
          slots.fold([], |acc: List<Bytes>, s: Slot|
            match s {
              Answering(a) ->
                acc.push(Bytes::concat_all([b"(Word)(intptr_t)&", entry_fn(a.entry)])).push(
                  Bytes::concat_all([
                    b"(Word)(intptr_t)((Word *)(intptr_t)",
                    operand(pr, args, 0),
                    b" + ",
                    ascii_of_int(a.record),
                    b")",
                  ]),
                ),
              Forwarding(f) -> {
                let slot = Bytes::concat_all([
                  b"ply_slot(",
                  operand(pr, args, f.operand),
                  b", ",
                  ascii_of_int(f.op),
                  b")",
                ]);
                acc.push(slot.concat(b"[0]")).push(slot.concat(b"[1]"))
              },
            }),
        ),
      ),
    VarInit(at) ->
      line(
        line(
          pr,
          p.depth,
          Bytes::concat_all([instance_word(pr, args, 0, at), b" = ", operand(pr, args, 1), b";"]),
        ),
        p.depth,
        Bytes::concat_all([instance_word(pr, args, 0, at + 1), b" = ", operand(pr, args, 2), b";"]),
      ),
    VarRead(at) -> match into {
      None -> pr,
      Some(v) -> {
        let n = named(pr, v);
        line(
          n.pr,
          p.depth,
          Bytes::concat_all([
            b"Word ",
            n.name,
            b" = ",
            instance_word(pr, args, 0, at),
            b"; ((const PlyType *)(intptr_t)",
            instance_word(pr, args, 0, at + 1),
            b")->inc(ctx, ",
            n.name,
            b");",
          ]),
        )
      },
    },
    VarWrite(at) ->
      line(
        pr,
        p.depth,
        Bytes::concat_all([
          b"((const PlyType *)(intptr_t)",
          instance_word(pr, args, 0, at + 1),
          b")->dec(ctx, ",
          instance_word(pr, args, 0, at),
          b"); ",
          instance_word(pr, args, 0, at),
          b" = ",
          operand(pr, args, 1),
          b";",
        ]),
      ),
  }

/// Word `at` of the instance operand `instance` of `args` is, as C that reads or sets it: a
/// `handle`'s instance follows its closures, an operation on the instance's words takes it first.
fn instance_word(pr: Printing, args: List<Arg>, instance: Int, at: Int) -> Bytes =
  Bytes::concat_all([
    b"((Word *)(intptr_t)",
    operand(pr, args, instance),
    b")[",
    ascii_of_int(at),
    b"]",
  ])

/// `into` declared the address of an instance of `n` words laid out zeroed in the frame, behind the
/// four words of the frame record that holds its variables: the record's two, then the place of
/// the first variable and how many there are.
fn instance_laid(p: Place, pr: Printing, into: Option<Var>, n: Int) -> Printing =
  match into {
    None -> pr,
    Some(_) -> {
      let arr = temp(pr);
      let laid = line(
        arr.pr,
        p.depth,
        Bytes::concat_all([b"Word ", arr.name, b"[", ascii_of_int(4 + n), b"] = {0};"]),
      );
      word_set(p, laid, into, Bytes::concat_all([b"(Word)(intptr_t)(", arr.name, b" + 4)"]))
    },
  }

/// The frame record instance `i`, whose word 0 is `first`, holds its variables in, as C.
fn vars_record(first: Bytes) -> Bytes =
  Bytes::concat_all([b"((PlyFrame *)(intptr_t)(&", first, b" - 4))"])

/// Where instance `i` holds variables and the chain records, its record linked over them, so a
/// snapshot of a stop under its `handle` holds them once more and a body never resumed lets them
/// go.
fn vars_linked(p: Place, pr: Printing, first: Bytes, i: HandleInstance) -> Printing =
  if i.count == 0 { pr } else {
    let r = vars_record(first);
    line(
      pr,
      p.depth,
      Bytes::concat_all([
        b"if (PLY_FRAMES(ctx)) { ((Word *)",
        r,
        b")[2] = ",
        ascii_of_int(i.vars),
        b"; ((Word *)",
        r,
        b")[3] = ",
        ascii_of_int(i.count),
        b"; ",
        r,
        b"->each = ply_instance_each; ",
        r,
        b"->prev = PLY_FRAMES(ctx); PLY_FRAMES(ctx) = ",
        r,
        b"; }",
      ]),
    )
  }

/// Instance `i`'s record unlinked where it is the chain's head, before its variables go.
fn vars_unlinked(p: Place, pr: Printing, first: Bytes, i: HandleInstance) -> Printing =
  if i.count == 0 { pr } else {
    let r = vars_record(first);
    line(
      pr,
      p.depth,
      Bytes::concat_all([b"if (PLY_FRAMES(ctx) == ", r, b") PLY_FRAMES(ctx) = ", r, b"->prev;"]),
    )
  }

/// The head's function a clause's slot enters it through.
pub fn entry_fn(e: Entry) -> Bytes =
  match e { Answers -> b"ply_answers", Resumes -> b"ply_resumes", Raises -> b"ply_raises" }

/// `into` declared a word set to the C `value`.
fn word_set(p: Place, pr: Printing, into: Option<Var>, value: Bytes) -> Printing =
  match into {
    None -> pr,
    Some(v) -> {
      let n = named(pr, v);
      line(n.pr, p.depth, Bytes::concat_all([b"Word ", n.name, b" = ", value, b";"]))
    },
  }

/// An array of `count` words laid in the frame, `words` its first, the rest zero, and `into` its
/// address.
fn laid_set(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  count: Bytes,
  words: List<Bytes>,
) -> Printing =
  match into {
    None -> pr,
    Some(v) -> {
      let arr = temp(pr);
      let laid = line(
        arr.pr,
        p.depth,
        Bytes::concat_all([
          b"Word ",
          arr.name,
          b"[",
          count,
          b"] = {",
          Bytes::join(words, b", "),
          b"};",
        ]),
      );
      word_set(p, laid, into, b"(Word)(intptr_t)".concat(arr.name))
    },
  }

/// The key a handle's depth is named under among the printing's names, apart from every variable's.
fn depth_key(label: Int) -> Int = 0 - 1 - label

/// The table a `handle`'s clauses lay out: per clause its effect, its resource (or the label it keys
/// on, or none), its operation, its closure, its mode, and the descriptor of the bound label's type
/// where it binds the label, 0 where it does not.
fn table(
  p: Place,
  pr: Printing,
  args: List<Arg>,
  site: HandleSite,
) -> { pr: Printing, name: Bytes } = {
  let arr = temp(pr);
  let entries = site.clauses.fold(
    { pr: arr.pr, pieces: [] },
    |acc: { pr: Printing, pieces: List<Piece> }, c: Clause| {
      let ef = field_hole(acc.pr, c.effect);
      let res = match c.label {
        Some(i) -> { pr: ef.pr, piece: Text(operand(pr, args, i)) },
        None -> if c.resource == b"" { { pr: ef.pr, piece: Text(b"-1") } }
        else { field_hole(ef.pr, c.resource) },
      };
      let op = field_hole(res.pr, c.op);
      {
        pr: { ..op.pr, handles: op.pr.handles.push(Bytes::concat_all([c.effect, b"#", c.op])) },
        pieces: acc.pieces.concat(if acc.pieces.len() == 0 { [] } else { [Text(b", ")] }).concat([
          ef.piece,
          Text(b", "),
          res.piece,
          Text(b", "),
          op.piece,
          Text(
            Bytes::concat_all([
              b", ",
              operand(pr, args, c.handler),
              b", ",
              ascii_of_int(c.mode),
              b", ",
              match c.string { Some(i) -> operand(pr, args, i), None -> b"0" },
            ]),
          ),
        ]),
      }
    },
  );
  {
    pr: spliced(
      entries.pr,
      p.depth,
      [Text(Bytes::concat_all([b"Word ", arr.name, b"[] = {"]))].concat(entries.pieces).push(
        Text(b"};"),
      ),
    ),
    name: arr.name,
  }
}

fn returned(site: HandleSite, args: List<Arg>, pr: Printing) -> Bytes =
  match site.ret { Some(i) -> operand(pr, args, i), None -> b"0" }

/// A perform: its words in an array with a word to spare past them, which an entry resuming in its
/// tail hands its continuation in, then the entry of the operation in the evidence object, which
/// reads the operation's types from its `op#`.
fn performed(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  x: { effect: Bytes, op: Bytes, index: Int, resource: Bytes, labelled: Bool, mode: Int, described: Bytes },
  args: List<Arg>,
) -> Printing = {
  let words = if x.labelled { args.drop(2) } else { args.drop(1) };
  let arr = temp(pr);
  let held = line(
    arr.pr,
    p.depth,
    Bytes::concat_all([
      b"Word ",
      arr.name,
      b"[] = {",
      Bytes::join(words.map(|a: Arg| arg_text(pr, a)).push(b"0"), b", "),
      b"};",
    ]),
  );
  let sited = site(p, {
    ..held,
    performs: held.performs.push(Bytes::concat_all([x.effect, b"#", x.op])),
  });
  let res = if x.labelled { { pr: sited, piece: Text(operand(pr, args, 1)) } }
  else if x.resource == b"" { { pr: sited, piece: Text(b"-1") } }
  else { field_hole(sited, x.resource) };
  check(
    p,
    answered(res.pr, p.depth, into, [
      Text(
        Bytes::concat_all([
          b"ply_perform(ctx, ",
          operand(pr, args, 0),
          b", ",
          ascii_of_int(x.index),
          b", (Word)(intptr_t)&",
          x.described,
          b", ",
          ascii_of_int(x.mode),
          b", ",
        ]),
      ),
      res.piece,
      Text(Bytes::concat_all([b", (Word)(intptr_t)", arr.name, b")"])),
    ]),
  )
}

/// A `parallel` block: the branches' closures in an array the runtime takes them from and writes
/// each one's answer over; where a branch failed, each slot an answer is in let go by the descriptor
/// of its branch's type before the failure leaves; then those answers moved into a box of
/// their own, in the branches' order (`reps.gathered_of`).
fn ran(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  reach: Option<List<Reached>>,
  args: List<Arg>,
) -> Printing = {
  let n = args.len() / 2;
  let arr = temp(pr);
  let held = line(
    arr.pr,
    p.depth,
    Bytes::concat_all([
      b"Word ",
      arr.name,
      b"[] = {",
      if n == 0 { b"0" } else { Bytes::join(args.take(n).map(|a: Arg| arg_text(pr, a)), b", ") },
      b"};",
    ]),
  );
  let run = match reach {
    None ->
      line(
        site(p, held),
        p.depth,
        Bytes::concat_all([
          b"rt_branches_p(ctx, (Word)(intptr_t)",
          arr.name,
          b", ",
          ascii_of_int(n),
          b");",
        ]),
      ),
    Some(rs) -> {
      let reached = rs.fold(
        { pr: held, pieces: [] },
        |acc: { pr: Printing, pieces: List<Piece> }, r: Reached| {
          let ef = field_hole(acc.pr, r.effect);
          let res = match r.resource {
            None -> { pr: ef.pr, piece: Text(b"-1") },
            Some(name) -> field_hole(ef.pr, name),
          };
          {
            pr: res.pr,
            pieces: acc.pieces.concat(if acc.pieces.len() == 0 { [] }
            else { [Text(b", ")] }).concat([ef.piece, Text(b", "), res.piece]),
          }
        },
      );
      let listing = temp(reached.pr);
      let listed = spliced(
        listing.pr,
        p.depth,
        [Text(Bytes::concat_all([b"Word ", listing.name, b"[] = {"]))].concat(
          if rs.len() == 0 { [Text(b"0")] } else { reached.pieces },
        ).push(
          Text(b"};"),
        ),
      );
      line(
        site(p, listed),
        p.depth,
        Bytes::concat_all([
          b"rt_branches_past_p(ctx, (Word)(intptr_t)",
          arr.name,
          b", ",
          ascii_of_int(n),
          b", (Word)(intptr_t)",
          listing.name,
          b", ",
          ascii_of_int(rs.len()),
          b");",
        ]),
      )
    },
  };
  // A slot is 0 where its branch failed or never ran, and holds the answer of one that ran.
  let released = line(
    run,
    p.depth,
    Bytes::concat_all(
      [b"if (ctx->failed) { "].concat(
        range(0, n).map(|i: Int| {
          let slot = Bytes::concat_all([arr.name, b"[", ascii_of_int(i), b"]"]);
          Bytes::concat_all([
            b"if (",
            slot,
            b") ((const PlyType *)(intptr_t)",
            operand(pr, args, n + i),
            b")->dec(ctx, ",
            slot,
            b"); ",
          ])
        }),
      ).push(
        p.leave,
      ).push(
        b" }",
      ),
    ),
  );
  match into {
    None -> released,
    Some(v) -> {
      let box = named(released, v);
      line(
        box.pr,
        p.depth,
        Bytes::concat_all([
          b"Word ",
          box.name,
          b" = rt_alloc_bytes_p(ctx, ",
          ascii_of_int(header_bytes() + 8 * n),
          b");",
          Bytes::concat_all(
            range(0, n).map(|i: Int|
              Bytes::concat_all([
                b" ply_words(",
                box.name,
                b")[",
                ascii_of_int(i),
                b"] = ",
                arr.name,
                b"[",
                ascii_of_int(i),
                b"];",
              ])),
          ),
        ]),
      )
    },
  }
}

/// Operand `i` of `args` as C.
fn operand(pr: Printing, args: List<Arg>, i: Int) -> Bytes =
  match args.at(i) { Some(a) -> arg_text(pr, a), None -> b"0" }

/// A runtime call answering a word, into a new temporary of `into`'s where it has one.
fn answered(pr: Printing, depth: Int, into: Option<Var>, call: List<Piece>) -> Printing =
  match into {
    Some(v) -> {
      let n = named(pr, v);
      spliced(
        n.pr,
        depth,
        [Text(Bytes::concat_all([c_type(v.rep), b" ", n.name, b" = "]))].concat(call).push(
          Text(b";"),
        ),
      )
    },
    None -> spliced(pr, depth, call.push(Text(b";"))),
  }

/// A line of pieces.
fn spliced(pr: Printing, depth: Int, ps: List<Piece>) -> Printing =
  { ..pr, out: pr.out.push(Text(pad(depth))).concat(ps).push(Text(b"\n")) }

/// The operations a `simulate` region answers, named as the fixpoint names a handled operation.
pub fn scheduled_ops() -> List<Bytes> =
  [
    b"task#spawn",
    b"task#join",
    b"task#yield",
    b"clock#now",
    b"clock#sleep",
    b"random#next",
    b"random#below",
    b"sim#seed",
  ]
