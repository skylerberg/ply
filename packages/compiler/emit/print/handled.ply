//! A `handle`'s instance and landing printed around the body the printer's driver prints, and the
//! operations on effects: a perform, a label, a `parallel` block, a `simulate`, and an extern the
//! runtime answers over its arguments' encoding. Each hands the runtime its operands in an array of words and names
//! effects, operations and resources by their field-table entries, and a builtin by its place in the
//! unit's table of them.

import std.bytes (ascii_of_int)
import compiler.emit.pieces (Piece, Text, Hole, BuiltinAt)
import compiler.emit.tir (Var, Arg, Uses, Handling)
import compiler.emit.tir.handling (HandleOp, Perform, Label, Parallel, Simulate, Encoded, Unsettled,
                                   WordsLaid, WordAt, Bridge, Hosted, Unserved, Instance,
                                   ObjectLaid, VarInit, VarRead, VarWrite, Entering, ForwardsLaid,
                                   ForwardsSet, ObjectAt, Mapped, Slot, Answering, Forwarding,
                                   Forwarded, Keyed, KeyedRow, Entry, Answers, Resumes, Stops,
                                   Raises, Clause, HandleSite, HandleInstance, Detached, Reached,
                                   InstanceHeap, InstanceIn, raised_at, task_at)
import compiler.emit.abi (instance_head)
import compiler.emit.print.text (Printing, Place, line, pad, temp, named, name_of, arg_text,
                                 assigned, site, check, field_hole, interned, unprinted)
import compiler.emit.print.made (c_type)
import compiler.emit.layout (header_bytes)

/// What opens `Handle` `label` laying out `site` over `args`: its answer declared, its instance set
/// up and the block its body runs in. Detached: the whole handle, its answer into `answer`.
pub fn handle_opened(
  p: Place,
  pr: Printing,
  label: Int,
  args: List<Arg>,
  uses: Uses,
  site: HandleSite,
  answer: Var,
) -> Printing =
  match site.detached {
    Some(d) -> detached_opened(p, pr, args, site, d, answer),
    None -> instance_opened(p, pr, args, site, answer),
  }

/// The `handle`s its clauses answer named in `pr`, and its answer declared.
fn answer_declared(pr: Printing, site: HandleSite, answer: Var) -> { pr: Printing, name: Bytes } = {
  let a = named(
    {
      ..pr,
      handles: pr.handles.concat(
        site.clauses.map(|c: Clause| Bytes::concat_all([c.effect, b"#", c.op])),
      ),
    },
    answer,
  );
  { pr: a.pr, name: a.name }
}

/// What opens a `handle` over its instance: its answer declared, the fuel it stands at, its
/// records set unless they are already, and the block its body runs in.
fn instance_opened(
  p: Place,
  pr: Printing,
  args: List<Arg>,
  site: HandleSite,
  answer: Var,
) -> Printing = {
  let i = site.instance;
  let a = answer_declared(pr, site, answer);
  let fueled = line(
    line(a.pr, p.depth, Bytes::concat_all([c_type(answer.rep), b" ", a.name, b" = 0;"])),
    p.depth,
    Bytes::concat_all([instance_word(pr, args, i.operand, 0), b" = ctx->fuel;"]),
  );
  let recorded = if i.preset { fueled } else { records_set(p, fueled, args, site) };
  line(vars_linked(p, recorded, instance_word(pr, args, i.operand, 0), i), p.depth, b"{")
}

/// What opens a detached `handle`: its records set, then its body, run on a stack of its own until
/// it stops or ends, its answer into `answer`.
fn detached_opened(
  p: Place,
  pr: Printing,
  args: List<Arg>,
  site: HandleSite,
  d: Detached,
  answer: Var,
) -> Printing = {
  let a = answer_declared(pr, site, answer);
  let recorded = records_set(p, a.pr, args, site);
  let heap = match site.instance.heap { Some(o) -> operand(pr, args, o), None -> b"0" };
  check(
    p,
    assigned(
      recorded,
      p.depth,
      answer,
      c_type(answer.rep),
      Bytes::concat_all([
        b"rt_detached_open_p(ctx, ",
        operand(pr, args, d.body),
        b", (Word)(intptr_t)((char *)(intptr_t)",
        operand(pr, args, d.forwards),
        b" - PLY_HEADER), ",
        heap,
        b")",
      ]),
    ),
  )
}

/// Instance `i` set as its `handle` opens: the descriptor of what it answers where a clause may stop
/// it, the task opening it, which alone may leave it, and each clause's record, then the return
/// clause's: the closure, the instance, the clause's place counted from 1, as word 1 of the
/// instance names a raise clause, and the descriptor of `String` where the clause is handed one. A
/// heap instance's head names its records and variables, which its block's release lets go of,
/// holding each closure once more.
fn records_set(p: Place, pr: Printing, args: List<Arg>, site: HandleSite) -> Printing = {
  let i = site.instance;
  let inst = |at: Int| instance_word(pr, args, i.operand, at);
  let set = |q: Printing, lhs: Bytes, rhs: Bytes|
    line(q, p.depth, Bytes::concat_all([lhs, b" = ", rhs, b";"]));
  let described = match i.answer { Some(d) -> set(pr, inst(3), operand(pr, args, d)), None -> pr };
  let tasked = set(described, inst(task_at()), b"ctx->task");
  let record = |q: Printing, at: Int, closure: Int, place: Int|
    set(
      set(set(q, inst(at), operand(pr, args, closure)), inst(at + 1), operand(pr, args, i.operand)),
      inst(at + 2),
      ascii_of_int(place),
    );
  let recorded = range(0, site.clauses.len()).fold(tasked, |q: Printing, k: Int|
    match ((site.clauses.at(k), i.records.at(k))) {
      (Some(c), Some(at)) -> {
        let placed = record(q, at, c.handler, k + 1);
        match c.string {
          Some(d) -> set(placed, inst(at + 3), operand(pr, args, d)),
          None -> placed,
        }
      },
      _ -> q,
    });
  let returned = match ((i.ret, site.ret)) {
    (Some(at), Some(r)) -> record(recorded, at, r, 0),
    _ -> recorded,
  };
  let closures = site.clauses.map(|c: Clause| c.handler).concat(match site.ret {
    Some(r) -> [r],
    None -> [],
  });
  match i.heap {
    None -> returned,
    Some(_) -> {
      let first = match i.records.at(0) {
        Some(r) -> r,
        None -> match i.ret { Some(r) -> r, None -> 0 },
      };
      let head = instance_head();
      let counted = set(
        set(
          set(
            set(returned, inst(2 - head.words), ascii_of_int(first)),
            inst(3 - head.words),
            ascii_of_int(closures.len()),
          ),
          inst(head.vars - head.words),
          ascii_of_int(i.vars),
        ),
        inst(head.vars + 1 - head.words),
        ascii_of_int(i.count),
      );
      closures.fold(counted, |q: Printing, c: Int|
        line(q, p.depth, Bytes::concat_all([b"ply_dup(", operand(pr, args, c), b");"])))
    },
  }
}

/// The C a failure inside the body of `Handle` `label` runs, after its own releases, to reach the
/// handle's landing.
pub fn landing_jump(label: Int) -> Bytes =
  Bytes::concat_all([b"goto ply_h", ascii_of_int(label), b";"])

/// What closes `Handle` `label`: the body's block, then its landing, as `instance_landed` says. A
/// detached handle was whole when it opened.
pub fn handle_closed(
  p: Place,
  pr: Printing,
  label: Int,
  args: List<Arg>,
  site: HandleSite,
  answer: Var,
) -> Printing =
  match site.detached { Some(_) -> pr, None -> instance_landed(p, pr, label, args, site, answer) }

/// What closes `Handle` `label` over its instance: the body's block, then its landing. An unwind to this instance answers what its clause left, or runs the
/// raise clause it names on the arguments it left; a raise pending where an `abort.raise` clause
/// is runs that clause on its message, and one of another raise a clause answers that clause on
/// what it carried; a body that answered goes through the return clause. Then
/// what the instance holds of an unwind another failure replaced is let go, then the variables by
/// their types, and any other failure leaves by `p.leave`.
fn instance_landed(
  p: Place,
  pr: Printing,
  label: Int,
  args: List<Arg>,
  site: HandleSite,
  answer: Var,
) -> Printing = {
  let i = site.instance;
  let d = p.depth;
  let inst = |at: Int| instance_word(pr, args, i.operand, at);
  let ans = name_of(pr, answer);
  let landed = line(
    line(pr, d, b"}"),
    d,
    Bytes::concat_all([b"ply_h", ascii_of_int(label), b": ;"]),
  );
  // The clauses are entered through their records, which hold their closures wherever the
  // landing runs.
  let closure = |k: Int| match i.records.at(k) { Some(at) -> inst(at), None -> b"0" };
  let raises = range(0, site.clauses.len()).fold([], |acc: List<Bytes>, k: Int|
    match site.clauses.at(k) {
      Some(c) -> if c.mode != 3 { acc } else {
        acc.push(
          Bytes::concat_all([
            b"  else if (ply_held == ",
            ascii_of_int(k + 1),
            b") ",
            ans,
            b" = ply_uniform(ctx, ",
            closure(k),
            b", &",
            inst(raised_at()),
            b");",
          ]),
        )
      },
      None -> acc,
    });
  // What the unwind carries is the clause's now, so the instance holds nothing past it.
  let unwound = Bytes::concat_all([
    b"if (ctx->failed == PLY_FAILED_TARGET && ctx->target == ",
    operand(pr, args, i.operand),
    b") {\n",
    pad(d + 1),
    b"Word ply_held = ",
    inst(1),
    b"; ",
    inst(1),
    b" = 0; ctx->failed = 0; ctx->fuel = ",
    inst(0),
    b";\n",
    pad(d + 1),
    b"if (ply_held == -1) ",
    ans,
    b" = ",
    inst(2),
    b";\n",
    Bytes::concat_all(raises.map(|r: Bytes| Bytes::concat_all([pad(d), r, b"\n"]))),
    pad(d),
    b"}",
  ]);
  // A pending raise gives back the calls it unwound as a raise to the instance does.
  let pending = match i.pending {
    None -> b"",
    Some(k) -> match site.clauses.at(k) {
      Some(c) ->
        Bytes::concat_all([
          b" else if (ctx->failed == PLY_FAILED_PENDING) {\n",
          pad(d + 1),
          b"ctx->fuel = ",
          inst(0),
          b";\n",
          pad(d + 1),
          b"Word m[2] = { rt_pending_raised_p(ctx, ",
          match i.records.at(k) { Some(at) -> inst(at + 3), None -> b"0" },
          b", 0), 0 };\n",
          pad(d + 1),
          b"if (!ctx->failed) ",
          ans,
          b" = ply_uniform(ctx, ",
          closure(k),
          b", m);\n",
          pad(d),
          b"}",
        ]),
      None -> b"",
    },
  };
  let returned = match i.ret {
    None -> b"",
    Some(at) ->
      Bytes::concat_all([
        b" else if (!ctx->failed) ",
        ans,
        b" = ply_uniform(ctx, ",
        inst(at),
        b", &",
        ans,
        b");",
      ]),
  };
  // A raise other than `abort.raise` left pending runs the clause that answers it.
  let words = Bytes::concat_all([b"ply_pw", ascii_of_int(label)]);
  let raised = i.raised.fold(
    { pr: landed, pieces: [] },
    |acc: { pr: Printing, pieces: List<Piece> }, k: Int|
      match site.clauses.at(k) {
        None -> acc,
        Some(c) -> {
          let e = field_hole(acc.pr, c.effect);
          let o = field_hole(e.pr, c.op);
          {
            pr: o.pr,
            pieces: acc.pieces.concat([
              Text(
                Bytes::concat_all([
                  b" else if (ctx->failed == PLY_FAILED_PENDING && (",
                  words,
                  b" = rt_pending_raised_at_p(ctx, ",
                ]),
              ),
              e.piece,
              Text(b", "),
              o.piece,
              Text(
                Bytes::concat_all([
                  b"))) {\n",
                  pad(d + 1),
                  b"ctx->fuel = ",
                  inst(0),
                  b";\n",
                  pad(d + 1),
                  ans,
                  b" = ply_uniform(ctx, ",
                  closure(k),
                  b", (const Word *)(intptr_t)",
                  words,
                  b");\n",
                  pad(d),
                  b"}",
                ]),
              ),
            ]),
          }
        },
      },
  );
  let declared = if i.raised.len() == 0 { raised.pr }
  else { line(raised.pr, d, Bytes::concat_all([b"Word ", words, b" = 0;"])) };
  // What an unwind left here that another replaced, or that leaves past it, is let go.
  let answered = line(
    spliced(
      declared,
      d,
      [Text(Bytes::concat_all([unwound, pending]))].concat(raised.pieces).push(Text(returned)),
    ),
    d,
    Bytes::concat_all([
      b"if (",
      inst(1),
      b") ply_held_let_go(ctx, (Word *)(intptr_t)",
      operand(pr, args, i.operand),
      b");",
    ]),
  );
  // A heap instance's variables go with its block, which tasks under the `handle` may still hold.
  let released = if i.heap != None { vars_unlinked(p, answered, inst(0), i) } else {
    range(0, i.count).fold(vars_unlinked(p, answered, inst(0), i), |q: Printing, j: Int| {
      let at = i.vars + 2 * j;
      line(
        q,
        d,
        Bytes::concat_all([
          b"if (",
          inst(at + 1),
          b") ((const PlyType *)(intptr_t)",
          inst(at + 1),
          b")->dec(ctx, ",
          inst(at),
          b");",
        ]),
      )
    })
  };
  check(p, released)
}

/// Operation `op` on effects over `args`, its answer into `into`.
pub fn effect_op(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  op: HandleOp,
  args: List<Arg>,
  uses: Uses,
) -> Printing / {abort.raise} =
  match op {
    Perform(x) -> performed(p, pr, into, x, args),
    Label(name) -> match into {
      None -> pr,
      Some(v) -> {
        let f = field_hole(pr, name);
        let n = named(f.pr, v);
        spliced(n.pr, p.depth, [
          Text(Bytes::concat_all([c_type(v.rep), b" ", n.name, b" = "])),
          f.piece,
          Text(b";"),
        ])
      },
    },
    Parallel(x) -> ran(p, pr, into, x.reach, args),
    Simulate ->
      check(
        p,
        answered(site(p, { ..pr, handles: pr.handles.concat(scheduled_ops()) }), p.depth, into, [
          Text(
            Bytes::concat_all([
              b"rt_region_p(ctx, ",
              operand(pr, args, 0),
              b", ",
              operand(pr, args, 1),
              b")",
            ]),
          ),
        ]),
      ),
    // Bound, it answers a word nothing reads: its builtin only raises.
    Encoded(name) -> {
      let b = interned(pr.builtins, name);
      let sited = site(p, { ..pr, builtins: b.xs });
      check(p, match into {
        None ->
          spliced(sited, p.depth, [
            Text(b"rt_builtin_encoded_p(ctx, "),
            Hole(BuiltinAt(b.at)),
            Text(b");"),
          ]),
        Some(_) ->
          answered(sited, p.depth, into, [
            Text(b"(rt_builtin_encoded_p(ctx, "),
            Hole(BuiltinAt(b.at)),
            Text(b"), 0)"),
          ]),
      })
    },
    Unsettled(name) -> unprinted(Handling, b"a crossing settled by its callers only", name),
    WordsLaid -> match into {
      None -> pr,
      Some(v) -> {
        let arr = temp(pr);
        let laid = line(
          arr.pr,
          p.depth,
          Bytes::concat_all([
            b"Word ",
            arr.name,
            b"[] = {",
            Bytes::join(args.map(|a: Arg| arg_text(pr, a)), b", "),
            b"};",
          ]),
        );
        let n = named(laid, v);
        line(
          n.pr,
          p.depth,
          Bytes::concat_all([b"Word ", n.name, b" = (Word)(intptr_t)", arr.name, b";"]),
        )
      },
    },
    WordAt(i) -> match into {
      None -> pr,
      Some(v) -> {
        let n = named(pr, v);
        line(
          n.pr,
          p.depth,
          Bytes::concat_all([
            b"Word ",
            n.name,
            b" = ((const Word *)(intptr_t)",
            operand(pr, args, 0),
            b")[",
            ascii_of_int(i),
            b"];",
          ]),
        )
      },
    },
    Bridge -> word_set(p, pr, into, b"ctx->bridge"),
    Hosted -> word_set(p, pr, into, b"ctx->hosted"),
    Unserved -> word_set(p, pr, into, b"ctx->unserved"),
    Entering ->
      line(
        pr,
        p.depth,
        Bytes::concat_all([
          b"ctx->entering_desc = ",
          operand(pr, args, 0),
          b"; ctx->entering_words = ",
          operand(pr, args, 1),
          b";",
        ]),
      ),
    Instance(n) -> instance_laid(p, pr, into, n),
    InstanceHeap(n) -> instance_block_laid(p, pr, into, n),
    InstanceIn ->
      word_set(
        p,
        pr,
        into,
        Bytes::concat_all([
          b"(Word)(intptr_t)(ply_words(",
          operand(pr, args, 0),
          b") + ",
          ascii_of_int(instance_block_head()),
          b")",
        ]),
      ),
    ObjectLaid(slots) ->
      laid_set(
        p,
        tables_set(p, pr, args, slots),
        into,
        ascii_of_int(1 + 2 * slots.len()),
        [b"0"].concat(
          slots.fold([], |acc: List<Bytes>, s: Slot| acc.concat(slot_words(pr, args, s))),
        ),
      ),
    ForwardsLaid(words) -> forwards_laid(p, pr, into, words),
    ForwardsSet(at) ->
      line(
        pr,
        p.depth,
        Bytes::concat_all([instance_word(pr, args, 0, at), b" = ", operand(pr, args, 1), b";"]),
      ),
    ObjectAt(o) -> object_at(p, pr, into, args, o.at, o.slots),
    Mapped -> word_set(p, pr, into, b"(Word)(intptr_t)&ply_words_mapped"),
    VarInit(at) ->
      line(
        line(
          pr,
          p.depth,
          Bytes::concat_all([instance_word(pr, args, 0, at), b" = ", operand(pr, args, 1), b";"]),
        ),
        p.depth,
        Bytes::concat_all([instance_word(pr, args, 0, at + 1), b" = ", operand(pr, args, 2), b";"]),
      ),
    VarRead(at) -> match into {
      None -> pr,
      Some(v) -> {
        let n = named(pr, v);
        line(
          n.pr,
          p.depth,
          Bytes::concat_all([
            b"Word ",
            n.name,
            b" = ",
            instance_word(pr, args, 0, at),
            b"; ((const PlyType *)(intptr_t)",
            instance_word(pr, args, 0, at + 1),
            b")->inc(ctx, ",
            n.name,
            b");",
          ]),
        )
      },
    },
    VarWrite(at) ->
      line(
        pr,
        p.depth,
        Bytes::concat_all([
          b"((const PlyType *)(intptr_t)",
          instance_word(pr, args, 0, at + 1),
          b")->dec(ctx, ",
          instance_word(pr, args, 0, at),
          b"); ",
          instance_word(pr, args, 0, at),
          b" = ",
          operand(pr, args, 1),
          b";",
        ]),
      ),
  }

/// Word `at` of the instance operand `instance` of `args` is, as C that reads or sets it: a
/// `handle`'s instance follows its closures, an operation on the instance's words takes it first.
fn instance_word(pr: Printing, args: List<Arg>, instance: Int, at: Int) -> Bytes =
  Bytes::concat_all([
    b"((Word *)(intptr_t)",
    operand(pr, args, instance),
    b")[",
    ascii_of_int(at),
    b"]",
  ])

/// `into` declared the address of an instance of `n` words laid out zeroed in the frame, behind the
/// four words of the frame record that holds its variables: the record's two, then the place of
/// the first variable and how many there are.
fn instance_laid(p: Place, pr: Printing, into: Option<Var>, n: Int) -> Printing =
  match into {
    None -> pr,
    Some(_) -> {
      let arr = temp(pr);
      let laid = line(
        arr.pr,
        p.depth,
        Bytes::concat_all([b"Word ", arr.name, b"[", ascii_of_int(4 + n), b"] = {0};"]),
      );
      word_set(p, laid, into, Bytes::concat_all([b"(Word)(intptr_t)(", arr.name, b" + 4)"]))
    },
  }

/// The words of a heap instance's block before the instance: its descriptor, how many words the
/// instance has, the place of its first record and how many there are, the detached body it is the
/// `handle` of (the runtime's to set), then the frame record its variables are held in, as an
/// instance in the frame has it.
fn instance_block_head() -> Int = instance_head().words

/// `into` declared a counted block on the heap holding a zeroed instance of `n` words, behind the
/// head `instance_block_head` lays out, its descriptor `ply_instance_desc`, whose release lets go of
/// what the instance holds.
fn instance_block_laid(p: Place, pr: Printing, into: Option<Var>, n: Int) -> Printing =
  match into {
    None -> pr,
    Some(_) -> {
      let b = temp(pr);
      let size = ascii_of_int(8 * (instance_block_head() + n));
      let laid = line(
        b.pr,
        p.depth,
        Bytes::concat_all([
          b"Word ",
          b.name,
          b" = rt_alloc_bytes_p(ctx, PLY_HEADER + ",
          size,
          b"); memset(ply_words(",
          b.name,
          b"), 0, ",
          size,
          b"); ply_words(",
          b.name,
          b")[0] = (Word)(intptr_t)&ply_instance_desc; ply_words(",
          b.name,
          b")[1] = ",
          ascii_of_int(n),
          b";",
        ]),
      );
      word_set(p, laid, into, b.name)
    },
  }

/// The frame record instance `i`, whose word 0 is `first`, holds its variables in, as C.
fn vars_record(first: Bytes) -> Bytes =
  Bytes::concat_all([b"((PlyFrame *)(intptr_t)(&", first, b" - 4))"])

/// Where instance `i` holds variables and the chain records, its record linked over them, so a
/// snapshot of a stop under its `handle` holds them once more and a body never resumed lets them
/// go.
fn vars_linked(p: Place, pr: Printing, first: Bytes, i: HandleInstance) -> Printing =
  if i.count == 0 { pr } else {
    let r = vars_record(first);
    line(
      pr,
      p.depth,
      Bytes::concat_all([
        b"if (PLY_FRAMES(ctx)) { ((Word *)",
        r,
        b")[2] = ",
        ascii_of_int(i.vars),
        b"; ((Word *)",
        r,
        b")[3] = ",
        ascii_of_int(i.count),
        b"; ",
        r,
        b"->each = ply_instance_each; ",
        r,
        b"->prev = PLY_FRAMES(ctx); PLY_FRAMES(ctx) = ",
        r,
        b"; }",
      ]),
    )
  }

/// Instance `i`'s record unlinked where it is the chain's head, before its variables go.
fn vars_unlinked(p: Place, pr: Printing, first: Bytes, i: HandleInstance) -> Printing =
  if i.count == 0 { pr } else {
    let r = vars_record(first);
    line(
      pr,
      p.depth,
      Bytes::concat_all([b"if (PLY_FRAMES(ctx) == ", r, b") PLY_FRAMES(ctx) = ", r, b"->prev;"]),
    )
  }

/// The entry and environment of slot `s` of an object over `args`, whose first is the instance or
/// block the object is laid over, as C.
fn slot_words(pr: Printing, args: List<Arg>, s: Slot) -> List<Bytes> = {
  let within = |at: Int|
    Bytes::concat_all([
      b"(Word)(intptr_t)((Word *)(intptr_t)",
      operand(pr, args, 0),
      b" + ",
      ascii_of_int(at),
      b")",
    ]);
  match s {
    Answering(a) ->
      [Bytes::concat_all([b"(Word)(intptr_t)&", entry_fn(a.entry, a.labelled)]), within(a.record)],
    Forwarding(f) -> {
      let slot = Bytes::concat_all([
        b"ply_slot(",
        operand(pr, args, f.operand),
        b", ",
        ascii_of_int(f.op),
        b")",
      ]);
      [slot.concat(b"[0]"), slot.concat(b"[1]")]
    },
    Forwarded(f) -> [b"(Word)(intptr_t)&ply_forwarded", within(f.record)],
    Keyed(k) -> [b"(Word)(intptr_t)&ply_keyed", within(k.table)],
  }
}

/// The tables of the keyed slots among `slots` written into the instance `args` hands first: each
/// one's count of rows, then per row its label (`-2` for every label), its entry and environment.
fn tables_set(
  p: Place,
  pr: Printing,
  args: List<Arg>,
  slots: List<Slot>,
) -> Printing / {abort.raise} =
  slots.fold(pr, |q: Printing, s: Slot|
    match s {
      Keyed(k) -> {
        let word = |at: Int| instance_word(pr, args, 0, at);
        let set = |lhs: Bytes, rhs: Bytes| Bytes::concat_all([lhs, b" = ", rhs, b";"]);
        range(0, k.rows.len()).fold(
          line(q, p.depth, set(word(k.table), ascii_of_int(k.rows.len()))),
          |r: Printing, i: Int| {
            let row = k.rows.get(i);
            let at = k.table + 1 + 3 * i;
            let ws = slot_words(pr, args, row.enters);
            line(
              r,
              p.depth,
              Bytes::concat_all([
                set(word(at), match row.label { Some(l) -> operand(pr, args, l), None -> b"-2" }),
                b" ",
                set(word(at + 1), ws.get(0)),
                b" ",
                set(word(at + 2), ws.get(1)),
              ]),
            )
          },
        )
      },
      _ -> q,
    })

/// `into` declared the address of the first word of a detached body's forwarding block of `words`
/// words, zeroed, laid out on the heap behind a block's header.
fn forwards_laid(p: Place, pr: Printing, into: Option<Var>, words: Int) -> Printing =
  match into {
    None -> pr,
    Some(_) -> {
      let b = temp(pr);
      let size = ascii_of_int(8 * words);
      let laid = line(
        b.pr,
        p.depth,
        Bytes::concat_all([
          b"Word ",
          b.name,
          b" = rt_alloc_bytes_p(ctx, PLY_HEADER + ",
          size,
          b"); memset(ply_words(",
          b.name,
          b"), 0, ",
          size,
          b");",
        ]),
      );
      word_set(p, laid, into, Bytes::concat_all([b"(Word)(intptr_t)ply_words(", b.name, b")"]))
    },
  }

/// `into` declared the address of an evidence object laid out at word `at` of the block `args`
/// hands first, with `slots`: its flags, clear; then each slot's entry and environment, and for a
/// slot that forwards, its pair of the address of the word it forwards to and the operation's
/// place.
fn object_at(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  args: List<Arg>,
  at: Int,
  slots: List<Slot>,
) -> Printing / {abort.raise} = {
  let word = |k: Int| instance_word(pr, args, 0, k);
  let set = |lhs: Bytes, rhs: Bytes| Bytes::concat_all([lhs, b" = ", rhs, b";"]);
  let laid = range(0, slots.len()).fold(
    line(pr, p.depth, set(word(at), b"0")),
    |q: Printing, j: Int| {
      let s = slots.get(j);
      let ws = slot_words(pr, args, s);
      let entered = line(
        q,
        p.depth,
        Bytes::concat_all([
          set(word(at + 1 + 2 * j), ws.get(0)),
          b" ",
          set(word(at + 2 + 2 * j), ws.get(1)),
        ]),
      );
      match s {
        Forwarded(f) ->
          line(
            entered,
            p.depth,
            Bytes::concat_all([
              set(
                word(f.record),
                Bytes::concat_all([
                  b"(Word)(intptr_t)((Word *)(intptr_t)",
                  operand(pr, args, 0),
                  b" + ",
                  ascii_of_int(f.target),
                  b")",
                ]),
              ),
              b" ",
              set(word(f.record + 1), ascii_of_int(j)),
            ]),
          ),
        _ -> entered,
      }
    },
  );
  word_set(
    p,
    laid,
    into,
    Bytes::concat_all([
      b"(Word)(intptr_t)((Word *)(intptr_t)",
      operand(pr, args, 0),
      b" + ",
      ascii_of_int(at),
      b")",
    ]),
  )
}

/// The head's function a clause's slot enters it through, handing it the perform's label where
/// `labelled`.
pub fn entry_fn(e: Entry, labelled: Bool) -> Bytes =
  match e {
    Answers -> if labelled { b"ply_answers_labelled" } else { b"ply_answers" },
    Resumes -> if labelled { b"ply_resumes_labelled" } else { b"ply_resumes" },
    Raises -> b"ply_raises",
    Stops(again) -> if again { b"ply_stops_again" } else { b"ply_stops" },
  }

/// `into` declared a word set to the C `value`.
fn word_set(p: Place, pr: Printing, into: Option<Var>, value: Bytes) -> Printing =
  match into {
    None -> pr,
    Some(v) -> {
      let n = named(pr, v);
      line(n.pr, p.depth, Bytes::concat_all([b"Word ", n.name, b" = ", value, b";"]))
    },
  }

/// An array of `count` words laid in the frame, `words` its first, the rest zero, and `into` its
/// address.
fn laid_set(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  count: Bytes,
  words: List<Bytes>,
) -> Printing =
  match into {
    None -> pr,
    Some(v) -> {
      let arr = temp(pr);
      let laid = line(
        arr.pr,
        p.depth,
        Bytes::concat_all([
          b"Word ",
          arr.name,
          b"[",
          count,
          b"] = {",
          Bytes::join(words, b", "),
          b"};",
        ]),
      );
      word_set(p, laid, into, b"(Word)(intptr_t)".concat(arr.name))
    },
  }

/// A perform: its words in an array with a word to spare past them, which an entry resuming in its
/// tail hands its continuation in, then the entry of the operation in the evidence object, which
/// reads the operation's types from its `op#`.
fn performed(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  x: { effect: Bytes, op: Bytes, index: Int, resource: Bytes, labelled: Bool, mode: Int, described: Bytes },
  args: List<Arg>,
) -> Printing = {
  let words = if x.labelled { args.drop(2) } else { args.drop(1) };
  let arr = temp(pr);
  let held = line(
    arr.pr,
    p.depth,
    Bytes::concat_all([
      b"Word ",
      arr.name,
      b"[] = {",
      Bytes::join(words.map(|a: Arg| arg_text(pr, a)).push(b"0").push(b"0"), b", "),
      b"};",
    ]),
  );
  let sited = site(p, {
    ..held,
    performs: held.performs.push(Bytes::concat_all([x.effect, b"#", x.op])),
  });
  let res = if x.labelled { { pr: sited, piece: Text(operand(pr, args, 1)) } }
  else if x.resource == b"" { { pr: sited, piece: Text(b"-1") } }
  else { field_hole(sited, x.resource) };
  check(
    p,
    answered(res.pr, p.depth, into, [
      Text(
        Bytes::concat_all([
          b"ply_perform(ctx, ",
          operand(pr, args, 0),
          b", ",
          ascii_of_int(x.index),
          b", (Word)(intptr_t)&",
          x.described,
          b", ",
          ascii_of_int(x.mode),
          b", ",
        ]),
      ),
      res.piece,
      Text(Bytes::concat_all([b", (Word)(intptr_t)", arr.name, b")"])),
    ]),
  )
}

/// A `parallel` block: the branches' closures in an array the runtime takes them from and writes
/// each one's answer over; where a branch failed, each slot an answer is in let go by the descriptor
/// of its branch's type before the failure leaves; then those answers moved into a box of
/// their own, in the branches' order (`reps.gathered_of`).
fn ran(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  reach: Option<List<Reached>>,
  args: List<Arg>,
) -> Printing = {
  let n = args.len() / 2;
  let arr = temp(pr);
  let held = line(
    arr.pr,
    p.depth,
    Bytes::concat_all([
      b"Word ",
      arr.name,
      b"[] = {",
      if n == 0 { b"0" } else { Bytes::join(args.take(n).map(|a: Arg| arg_text(pr, a)), b", ") },
      b"};",
    ]),
  );
  let run = match reach {
    None ->
      line(
        site(p, held),
        p.depth,
        Bytes::concat_all([
          b"rt_branches_p(ctx, (Word)(intptr_t)",
          arr.name,
          b", ",
          ascii_of_int(n),
          b");",
        ]),
      ),
    Some(rs) -> {
      let reached = rs.fold(
        { pr: held, pieces: [] },
        |acc: { pr: Printing, pieces: List<Piece> }, r: Reached| {
          let ef = field_hole(acc.pr, r.effect);
          let res = match r.resource {
            None -> { pr: ef.pr, piece: Text(b"-1") },
            Some(name) -> field_hole(ef.pr, name),
          };
          {
            pr: res.pr,
            pieces: acc.pieces.concat(if acc.pieces.len() == 0 { [] }
            else { [Text(b", ")] }).concat([ef.piece, Text(b", "), res.piece]),
          }
        },
      );
      let listing = temp(reached.pr);
      let listed = spliced(
        listing.pr,
        p.depth,
        [Text(Bytes::concat_all([b"Word ", listing.name, b"[] = {"]))].concat(
          if rs.len() == 0 { [Text(b"0")] } else { reached.pieces },
        ).push(
          Text(b"};"),
        ),
      );
      line(
        site(p, listed),
        p.depth,
        Bytes::concat_all([
          b"rt_branches_past_p(ctx, (Word)(intptr_t)",
          arr.name,
          b", ",
          ascii_of_int(n),
          b", (Word)(intptr_t)",
          listing.name,
          b", ",
          ascii_of_int(rs.len()),
          b");",
        ]),
      )
    },
  };
  // A slot is 0 where its branch failed or never ran, and holds the answer of one that ran.
  let released = line(
    run,
    p.depth,
    Bytes::concat_all(
      [b"if (ctx->failed) { "].concat(
        range(0, n).map(|i: Int| {
          let slot = Bytes::concat_all([arr.name, b"[", ascii_of_int(i), b"]"]);
          Bytes::concat_all([
            b"if (",
            slot,
            b") ((const PlyType *)(intptr_t)",
            operand(pr, args, n + i),
            b")->dec(ctx, ",
            slot,
            b"); ",
          ])
        }),
      ).push(
        p.leave,
      ).push(
        b" }",
      ),
    ),
  );
  match into {
    None -> released,
    Some(v) -> {
      let box = named(released, v);
      line(
        box.pr,
        p.depth,
        Bytes::concat_all([
          b"Word ",
          box.name,
          b" = rt_alloc_bytes_p(ctx, ",
          ascii_of_int(header_bytes() + 8 * n),
          b");",
          Bytes::concat_all(
            range(0, n).map(|i: Int|
              Bytes::concat_all([
                b" ply_words(",
                box.name,
                b")[",
                ascii_of_int(i),
                b"] = ",
                arr.name,
                b"[",
                ascii_of_int(i),
                b"];",
              ])),
          ),
        ]),
      )
    },
  }
}

/// Operand `i` of `args` as C.
fn operand(pr: Printing, args: List<Arg>, i: Int) -> Bytes =
  match args.at(i) { Some(a) -> arg_text(pr, a), None -> b"0" }

/// A runtime call answering a word, into a new temporary of `into`'s where it has one.
fn answered(pr: Printing, depth: Int, into: Option<Var>, call: List<Piece>) -> Printing =
  match into {
    Some(v) -> {
      let n = named(pr, v);
      spliced(
        n.pr,
        depth,
        [Text(Bytes::concat_all([c_type(v.rep), b" ", n.name, b" = "]))].concat(call).push(
          Text(b";"),
        ),
      )
    },
    None -> spliced(pr, depth, call.push(Text(b";"))),
  }

/// A line of pieces.
fn spliced(pr: Printing, depth: Int, ps: List<Piece>) -> Printing =
  { ..pr, out: pr.out.push(Text(pad(depth))).concat(ps).push(Text(b"\n")) }

/// The operations a `simulate` region answers, named as the fixpoint names a handled operation.
pub fn scheduled_ops() -> List<Bytes> =
  [
    b"task#spawn",
    b"task#join",
    b"task#yield",
    b"clock#now",
    b"clock#sleep",
    b"random#next",
    b"random#below",
    b"sim#seed",
  ]
