import std.bytes (ascii_of_int)
import compiler.emit.c (int_literal)
import compiler.emit.typed_ir (Representation, AsFixed, AsListView, AsSum, Variable, FixedOperand,
                               Test, TagTest, IntTest, RangeTest, LengthTest, MatchFailure,
                               NoMatchingArm, LetMismatch, variable_text)
import compiler.emit.pieces (Piece, Text)
import compiler.emit.lower.representation (case_index)
import compiler.emit.layout (maybe, of_args, ValueLayout, PlainWords, SumCases, SumLayout,
                             CaseLayout, CaseTest, CaseArgs, Always, WordIs, WordOutside, LowBits,
                             Pointer, PointerSum, CharImmediate, RawRange, pointer_floor,
                             nullary_step, tag_bits, sum_layout, record_layout, any_integer,
                             head_field, list_head)
import compiler.emit.print.text (nth_or_zero, Printing, InstructionContext, line, text, pad, pieces,
                                 name_of, arg_text, source_position, part_names, unsupported)

pub fn case_opened(p: InstructionContext, printing: Printing, on: Variable, t: Test) -> Printing =
  text(printing, pad(p.depth))

pub fn case_arm(
  p: InstructionContext,
  printing: Printing,
  on: Variable,
  t: Test,
  when: Int,
) -> Printing / {abort.raise} =
  pieces(
    printing,
    [Text(b"if (")].concat(case_condition(printing, on, t, when)).push(Text(b") {\n")),
  )

pub fn case_arm_closed(p: InstructionContext, printing: Printing) -> Printing =
  text(printing, pad(p.depth).concat(b"} else "))

pub fn case_rest(p: InstructionContext, printing: Printing, on: Variable, t: Test) -> Printing =
  text(printing, b"{\n")

pub fn case_closed(p: InstructionContext, printing: Printing) -> Printing =
  line(printing, p.depth, b"}")

fn case_condition(
  printing: Printing,
  on: Variable,
  t: Test,
  when: Int,
) -> List<Piece> / {abort.raise} = {
  let x = name_of(printing, on);
  let parts = part_names(x, on.representation);
  let outside = |case: Bytes, of: Int|
    unsupported(
      case,
      Bytes::concat_all([
        b"place ",
        ascii_of_int(when),
        b" of ",
        ascii_of_int(of),
        b", testing ",
        variable_text(on),
      ]),
    );
  match t {
    TagTest(names) -> match names.at(when) {
      None ->
        outside(
          b"a pattern tests a constructor position beyond the constructors of its type; the type has this many constructors",
          names.len(),
        ),
      Some(name) -> match on.representation {
        AsSum(s) -> match case_index(on.representation, name) {
          Some(i) -> [Text(case_test(s.layout, parts, i))],
          None ->
            unsupported(
              b"the sum type has no case named like this constructor",
              Bytes::concat_all([name, b", testing ", variable_text(on)]),
            ),
        },
        _ -> unsupported(b"a constructor test on a value that is not a sum", variable_text(on)),
      },
    },
    IntTest(ns) -> match ns.at(when) {
      Some(n) ->
        [Text(Bytes::concat_all([b"(", x, b") == ", typed_int(printing, on.representation, n)]))],
      None ->
        outside(
          b"a pattern tests an integer position beyond the integers it lists; it lists this many",
          ns.len(),
        ),
    },
    RangeTest(r) ->
      [
        Text(
          Bytes::concat_all([
            b"(",
            x,
            b") >= ",
            typed_int(printing, on.representation, r.lo),
            b" && (",
            x,
            b") <= ",
            typed_int(printing, on.representation, r.hi),
          ]),
        ),
      ],
    LengthTest(l) ->
      [
        Text(
          Bytes::concat_all([
            if on.representation == AsListView {
              Bytes::concat_all([
                b"((int64_t)",
                head_field(list_head(), nth_or_zero(parts, 0), b"len"),
                b" - ",
                nth_or_zero(parts, 1),
                b")",
              ])
            } else { Bytes::concat_all([b"(int64_t)", head_field(list_head(), x, b"len")]) },
            if when < l.at_least { b" == " } else { b" >= " },
            int_literal(when),
          ]),
        ),
      ],
  }
}

pub fn case_test(s: SumLayout, ws: List<Bytes>, i: Int) -> Bytes =
  match s.cases.at(i) {
    None -> b"0",
    Some(c) -> match c.test {
      Always -> b"1",
      WordIs(t) -> Bytes::concat_all([b"(", nth_or_zero(ws, t.at), b") == ", int_literal(t.value)]),
      WordOutside(t) -> {
        let w = nth_or_zero(ws, t.at);
        let floor = int_literal(pointer_floor());
        match s.classes.at(t.at) {
          Some(PointerSum(m)) -> {
            let remaining_values = m - t.values.len();
            if remaining_values == 0 { Bytes::concat_all([b"(uint64_t)(", w, b") >= ", floor]) }
            else {
              Bytes::concat_all([
                b"((uint64_t)(",
                w,
                b") >= ",
                floor,
                b" || (",
                w,
                b") < ",
                int_literal(nullary_step() * remaining_values),
                b")",
              ])
            }
          },
          Some(CharImmediate(m)) -> {
            let remaining_values = m - t.values.len();
            if remaining_values == 0 { Bytes::concat_all([b"(((", w, b") & 7) == 2)"]) } else {
              Bytes::concat_all([
                b"(((",
                w,
                b") & 7) == 2 || (",
                w,
                b") < ",
                int_literal(nullary_step() * remaining_values),
                b")",
              ])
            }
          },
          Some(RawRange(r)) ->
            Bytes::concat_all([
              b"((",
              w,
              b") >= ",
              int_literal(r.lo),
              b" && (",
              w,
              b") <= ",
              int_literal(r.hi - t.values.len()),
              b")",
            ]),
          _ -> b"0",
        }
      },
      LowBits(t) -> {
        let w = nth_or_zero(ws, t.at);
        Bytes::concat_all([
          b"((uint64_t)(",
          w,
          b") >= ",
          int_literal(pointer_floor()),
          b" && ((",
          w,
          b") & 7) == ",
          int_literal(t.bits),
          match t.block_tag {
            None -> b")",
            Some(tag) ->
              Bytes::concat_all([
                b" && ply_words((",
                w,
                b") & ~(Word)7)[0] == ",
                int_literal(tag),
                b")",
              ]),
          },
        ])
      },
    },
  }

pub fn switch_value(s: SumLayout, ws: List<Bytes>) -> Bytes =
  match s.cases.find(|c: CaseLayout| match c.test { Always -> false, _ -> true }) {
    None -> int_literal(0),
    Some(c) -> {
      let w = nth_or_zero(ws, tested_word(c.test));
      if !s.cases.any(|k: CaseLayout| match k.test { LowBits(_) -> true, _ -> false }) {
        Bytes::concat_all([b"(int64_t)(", w, b")"])
      } else {
        let mask = ascii_of_int(tag_mask());
        let low = Bytes::concat_all([
          int_literal(pointer_floor()),
          b" + (int64_t)((",
          w,
          b") & ",
          mask,
          b")",
        ]);
        let boxed = s.cases.any(|k: CaseLayout|
          match k.test { LowBits(t) -> t.block_tag != None, _ -> false });
        Bytes::concat_all([
          b"((uint64_t)(",
          w,
          b") >= ",
          int_literal(pointer_floor()),
          b" ? ",
          if boxed {
            Bytes::concat_all([
              b"(((",
              w,
              b") & ",
              mask,
              b") == ",
              mask,
              b" ? ",
              int_literal(first_boxed_tag()),
              b" + (int64_t)ply_words((",
              w,
              b") & ~(Word)",
              mask,
              b")[0] : ",
              low,
              b")",
            ])
          } else { low },
          b" : (int64_t)(",
          w,
          b"))",
        ])
      }
    },
  }

pub fn case_label(s: SumLayout, i: Int) -> Bytes =
  match s.cases.at(i) {
    None -> b"default:",
    Some(c) -> match c.test {
      WordIs(t) -> Bytes::concat_all([b"case ", int_literal(t.value), b":"]),
      LowBits(t) -> match t.block_tag {
        None -> Bytes::concat_all([b"case ", int_literal(pointer_floor() + t.bits), b":"]),
        Some(tag) -> Bytes::concat_all([b"case ", int_literal(first_boxed_tag() + tag), b":"]),
      },
      _ -> b"default:",
    },
  }

pub fn empty_arms(s: SumLayout, armed: List<Int>) -> Bytes = {
  let defaulted = |i: Int| case_label(s, i) == b"default:";
  if !armed.any(defaulted) { b"" } else {
    Bytes::concat_all(
      range(0, s.cases.len()).filter(|i: Int| !armed.contains(i) && !defaulted(i)).map(|i: Int|
        Bytes::concat_all([case_label(s, i), b" break; "])),
    )
  }
}

fn tested_word(t: CaseTest) -> Int =
  match t { WordIs(x) -> x.at, WordOutside(x) -> x.at, LowBits(x) -> x.at, Always -> 0 }

fn tag_mask() -> Int = (1 << tag_bits()) - 1

fn first_boxed_tag() -> Int = pointer_floor() + tag_mask() + 1

fn typed_int(printing: Printing, r: Representation, n: Int) -> Bytes =
  match r {
    AsFixed(w) -> arg_text(printing, FixedOperand({ width: w, bits: n })),
    _ -> int_literal(n),
  }

pub fn match_opened(p: InstructionContext, printing: Printing, label: Int, arms: Int) -> Printing =
  printing

pub fn match_arm(p: InstructionContext, printing: Printing, label: Int, i: Int) -> Printing =
  if i == 0 { printing }
  else { line(printing, p.depth, Bytes::concat_all([arm_label(label, i), b": ;"])) }

pub fn match_arm_closed(p: InstructionContext, printing: Printing, label: Int, i: Int) -> Printing =
  line(printing, p.depth, Bytes::concat_all([b"goto ", end_label(label), b";"]))

pub fn match_rest(p: InstructionContext, printing: Printing, label: Int, arms: Int) -> Printing =
  line(printing, p.depth, Bytes::concat_all([arm_label(label, arms), b": ;"]))

pub fn match_closed(p: InstructionContext, printing: Printing, label: Int) -> Printing =
  line(printing, p.depth, Bytes::concat_all([end_label(label), b": ;"]))

pub fn next_arm_jump(p: InstructionContext, printing: Printing, label: Int, i: Int) -> Printing =
  line(printing, p.depth, Bytes::concat_all([b"goto ", arm_label(label, i + 1), b";"]))

pub fn failed(p: InstructionContext, printing: Printing, reason: MatchFailure) -> Printing =
  line(
    source_position(p, printing),
    p.depth,
    Bytes::concat_all([
      match reason {
        LetMismatch -> b"ply_let_no_match(ctx); ",
        NoMatchingArm -> b"ply_no_match(ctx); ",
      },
      p.exit_statement,
    ]),
  )

fn arm_label(label: Int, i: Int) -> Bytes =
  Bytes::concat_all([b"ply_m", ascii_of_int(label), b"_", ascii_of_int(i)])

fn end_label(label: Int) -> Bytes = Bytes::concat_all([b"ply_m", ascii_of_int(label), b"_end"])

test "a sum's case is identified by the value of its word, by a range check on a reserved word value, or by a pointer's low bits" {
  let x = [b"x"];
  let pointer = PlainWords([Pointer]);
  let reads = |text: Bytes, parts: List<Bytes>| parts.all(|p: Bytes| text.index_of(p) != None);
  assert(case_test(maybe(pointer), x, 0).index_of(b"== INT64_C(0)") != None, None);
  let some = case_test(maybe(pointer), x, 1);
  assert(reads(some, [b"INT64_C(4096)"]) && some.index_of(b"==") == None, None);
  assert(
    reads(case_test(maybe(SumCases(maybe(pointer))), x, 1), [b"INT64_C(4096)", b"INT64_C(8)"]),
    None,
  );
  assert(
    reads(case_test(maybe(PlainWords([RawRange({ lo: 0, hi: 1 })])), x, 1), [
      b"INT64_C(0)",
      b"INT64_C(1)",
    ]),
    None,
  );
  assert(reads(case_test(maybe(PlainWords([CharImmediate(0)])), x, 1), [b"& 7) == 2"]), None);
  let tags = sum_layout(
    range(0, 9).map(|_: Int| { args: record_layout([pointer]), indirect: true }),
  );
  assert(reads(case_test(tags, x, 1), [b"INT64_C(4096)", b"& 7) == INT64_C(1)"]), None);
  assert(
    reads(case_test(tags, x, 8), [b"& 7) == INT64_C(7)", b"ply_words(", b"== INT64_C(8)"]),
    None,
  );
  let tagged = case_test(maybe(PlainWords([any_integer()])), [b"t_0", b"t_1", b"t_2"], 1);
  assert(reads(tagged, [b"t_0", b"INT64_C(1)"]) && tagged.index_of(b"t_1") == None, None);
  assert_eq(case_test(sum_layout([of_args([pointer])]), x, 0), b"1")
}

test "a switch over a sum's case switches on the word that identifies the case, and labels each case by its value or tag" {
  let x = [b"x"];
  let pointer = PlainWords([Pointer]);
  let labels = |s: SumLayout| range(0, s.cases.len()).map(|i: Int| case_label(s, i));
  let ordering = sum_layout([of_args([]), of_args([]), of_args([])]);
  assert_eq(switch_value(ordering, x), b"(int64_t)(x)");
  assert_eq(labels(ordering), [b"case INT64_C(0):", b"case INT64_C(1):", b"case INT64_C(2):"]);
  assert_eq(switch_value(maybe(PlainWords([any_integer()])), [b"t_0", b"t_1"]), b"(int64_t)(t_0)");
  assert_eq(switch_value(maybe(pointer), x), b"(int64_t)(x)");
  assert_eq(labels(maybe(pointer)), [b"case INT64_C(0):", b"default:"]);
  assert_eq(empty_arms(maybe(pointer), [1]), b"case INT64_C(0): break; ");
  assert_eq(empty_arms(maybe(pointer), [0]), b"");
  let tags = sum_layout(
    [of_args([])].concat(
      range(0, 9).map(|_: Int| { args: record_layout([pointer]), indirect: true }),
    ),
  );
  let subject = switch_value(tags, x);
  assert(
    [b"INT64_C(4096)", b"INT64_C(4104)", b"ply_words("].all(|p: Bytes| subject.index_of(p) != None)
      && subject.split(b" ? ").len() == 3,
    Some(String::of_bytes_lossy(subject)),
  );
  assert_eq(labels(tags).take(3), [
    b"case INT64_C(0):",
    b"case INT64_C(4096):",
    b"case INT64_C(4097):",
  ]);
  assert_eq(labels(tags).drop(8), [b"case INT64_C(4112):", b"case INT64_C(4113):"]);
  [ordering, maybe(pointer), tags].fold((), |_: Unit, s: SumLayout|
    assert_eq(
      labels(s).len(),
      labels(s).fold([], |seen: List<Bytes>, l: Bytes|
        if seen.contains(l) { seen } else { seen.push(l) }).len(
      ),
    ));
  let one = sum_layout([of_args([pointer])]);
  assert_eq([switch_value(one, x)].concat(labels(one)), [b"INT64_C(0)", b"default:"])
}
