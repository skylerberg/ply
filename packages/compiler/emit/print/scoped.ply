import std.bytes (ascii_of_int)
import compiler.emit.abi (scoped_layout)
import compiler.emit.print.marshalling (declared, lines)

fn signatures() -> List<Bytes> =
  [
    b"Word ply_hold_made(PlyCtx *ctx, Word held)",
    b"Word ply_hold_read(PlyCtx *ctx, Word h)",
    b"Word ply_hold_taken(PlyCtx *ctx, Word h)",
    b"void ply_handle_free(PlyCtx *ctx, Word h)",
  ]

pub fn scoped_declared() -> Bytes = Bytes::concat_all(signatures().map(declared))

fn layout() -> Bytes = {
  let value = scoped_layout().value;
  Bytes::concat_all([
    b"#define PLY_HOLD_VALUE ",
    ascii_of_int(value),
    b"\n#define PLY_HOLD_NUMBER ",
    ascii_of_int(value + 1),
    b"\n#define PLY_HOLD_RELEASED ",
    ascii_of_int(value + 2),
    b"\n#define PLY_HOLD_BYTES (PLY_HEADER + 8 * ",
    ascii_of_int(value + 3),
    b")\n",
  ])
}

fn functions() -> Bytes =
  lines([
    b"static const char ply_hold_mark = 0;",
    b"Word ply_hold_made(PlyCtx *ctx, Word held) {",
    b"  Word h = ply_alloc(ctx, PLY_HOLD_BYTES);",
    b"  Word *o = ply_words(h);",
    b"  o[0] = (Word)(intptr_t)&ply_hold_mark;",
    b"  o[PLY_HOLD_VALUE] = held;",
    b"  o[PLY_HOLD_NUMBER] = builtin_elaborated_scoped_number_p(ctx);",
    b"  o[PLY_HOLD_RELEASED] = 0;",
    b"  return h;",
    b"}",
    b"static int ply_hold_is(Word h) {",
    b"  return (h & 7) == 0 && h >= PLY_POINTER_FLOOR && ply_words(h)[0] == (Word)(intptr_t)&ply_hold_mark;",
    b"}",
    b"static Word *ply_hold_live(PlyCtx *ctx, Word h, int writes, const char *doing) {",
    b"  if (!ply_hold_is(h)) {",
    b"    ply_fail(ctx, 0, \"E0502\", \"a scoped value that is no runtime scoped value\", \"in compiled code\", \"this is Ply's fault, not the program's\", 0);",
    b"    return 0;",
    b"  }",
    b"  Word *o = ply_words(h);",
    b"  if (ctx->recording) builtin_elaborated_scoped_touched_p(ctx, o[PLY_HOLD_NUMBER], writes);",
    b"  if (o[PLY_HOLD_RELEASED] == 0) return o;",
    b"  char text[128];",
    b"  snprintf(text, sizeof text, \"a scoped value is %s after its scope released what it held\", doing);",
    b"  ply_fail(ctx, 0, \"E0331\", text, \"the scoped value holds nothing now\", \"a `with_scope` releases its value once, when its body first ends; a continuation captured inside the body and resumed after that runs the rest of the body against a value already released\", \"resume a continuation captured inside a `with_scope` at most once, or open the `with_scope` after the choice the continuation replays\");",
    b"  return 0;",
    b"}",
    b"Word ply_hold_read(PlyCtx *ctx, Word h) {",
    b"  Word *o = ply_hold_live(ctx, h, 0, \"read\");",
    b"  return o ? o[PLY_HOLD_VALUE] : 0;",
    b"}",
    b"Word ply_hold_taken(PlyCtx *ctx, Word h) {",
    b"  Word *o = ply_hold_live(ctx, h, 1, \"let go\");",
    b"  if (!o) return 0;",
    b"  Word held = o[PLY_HOLD_VALUE];",
    b"  o[PLY_HOLD_VALUE] = 0;",
    b"  o[PLY_HOLD_RELEASED] = 1;",
    b"  return held;",
    b"}",
    b"void ply_handle_free(PlyCtx *ctx, Word h) {",
    b"  if (ply_words(h)[0] == (Word)(intptr_t)&ply_hold_mark) ply_free(ctx, h, PLY_HOLD_BYTES);",
    b"  else rt_handle_free_p(ctx, h);",
    b"}",
  ])

pub fn scoped_defined() -> Bytes = layout().concat(functions())
