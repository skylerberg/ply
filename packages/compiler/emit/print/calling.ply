                                           signature_parameters, signature_names, values_as_words,
                                           parts_read, result_parts, entry_opened, entry_outs,
                                           entry_result, entry_result_values, parts_to_word,
                                           word_to_parts, declared, set_parts, read_from,
                                           declared_as, write_inline)
