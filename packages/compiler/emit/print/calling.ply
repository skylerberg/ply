                               no_closure_evidence, Representation, AsInt, AsBool, AsFixed, AsFloat,
                               AsDecimal, AsWideFixed, AsWord, AsFlattened, AsSum, AsUnit,
                               AsImmediate, Leaf, Var, Arg, VarOperand, OwnedParam, BorrowedParam,
                               OwnedResult, BorrowedResult, Convention, Allocation,
                               ClosureAllocation, Fn, Member, Lambda, Closure, ClosureEvidence,
                               OperationSignature, Return, Metered, operand_representation,
