import compiler.check.types (int_type)
import compiler.emit.pieces (FailureOwner, FromCaller, SiteRoot, placeholder)
import compiler.emit.keys (RootKey, Named, Equal, generated_key)
import compiler.emit.typed_ir (Representation, AsInt)
import compiler.emit.print.text (failing_return, has_place)
import compiler.emit.print.count_functions (call_text)

pub fn probed_fn() -> Bytes = b"ply_probed"

pub fn placed_probe_fn() -> Bytes = b"ply_probed_in"

fn room_left() -> Bytes = b"(uintptr_t)&ply_probe >= ctx->stack_floor"

pub fn probed_helper() -> Bytes =
  Bytes::concat_all([
    b"#define ",
    probed_fn(),
    b"(ctx) ({ \\\n",
    b"  char ply_probe; \\\n",
    b"  ",
    room_left(),
    b" || rt_stack_more_p(ctx); })\n",
    b"#define ",
    placed_probe_fn(),
    b"(ctx, root) ({ \\\n",
    b"  char ply_probe; \\\n",
    b"  ",
    room_left(),
    b" || (PLY_SITE(ctx, root, 0, 0), rt_stack_more_p(ctx)); })\n",
  ])

pub fn probe(
  result: Representation,
  key: RootKey,
  site: Option<FailureOwner>,
) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"if (!",
    if has_place(key) { call_text(placed_probe_fn(), [b"ctx", placeholder(SiteRoot(site))]) }
    else { call_text(probed_fn(), [b"ctx"]) },
    b") ",
    failing_return(result),
  ])

pub fn head_probe(
  result: Representation,
  key: RootKey,
  site: Option<FailureOwner>,
) -> Bytes / {abort.raise} = Bytes::concat_all([b"  ", probe(result, key, site), b"\n"])

test "a stack check stores its function's root on its rare path, unless no person can be pointed at the function" {
  let plain = b"if (!ply_probed(ctx)) return 0;";
  assert_eq(probe(AsInt, Named(b"m.f"), None), b"if (!ply_probed_in(ctx, @@r@@)) return 0;");
  assert_eq(probe(AsInt, generated_key(Equal, int_type(), b"m"), None), plain);
  assert_eq(probe(AsInt, Named(b"std.list.take"), None), plain);
  assert_eq(probe(AsInt, Named(b"std.internal.schedule.crossing_recv"), Some(FromCaller)), plain)
}
