//! The stack probe a C function the form prints makes as it starts, or at its loop's label, which
//! its start and every restart pass: room asked for below the running stack where the frame is near
//! the floor. The runtime raises the floor past every frame once the entry's clock runs out, so a
//! probe also ends a run whose time is up.

import compiler.emit.typed_ir (Representation)
import compiler.emit.print.text (failing_return)

/// The head's C macro a probe calls: answers 1 where the frame stands above the floor or room was
/// made below it, and 0 with the context failed.
pub fn probed_fn() -> Bytes = b"ply_probed"

/// `probed_fn`'s definition, as a macro, which tcc inlines as it inlines no function: the probe
/// stands in the caller's frame. It reads `ctx`, which every use names.
pub fn probed_helper() -> Bytes =
  Bytes::concat_all([
    b"#define ",
    probed_fn(),
    b"(ctx) ({ \\\n",
    b"  char ply_probe; \\\n",
    b"  (uintptr_t)&ply_probe >= ctx->stack_floor || rt_stack_more_p(ctx); })\n",
  ])

/// The probe of a function answering as `answer`: leaves as failed where `probed_fn` says so.
pub fn probe(answer: Representation) -> Bytes =
  Bytes::concat_all([b"if (!", probed_fn(), b"(ctx)) ", failing_return(answer)])

/// `probe` as the first line of a function's body.
pub fn head_probe(answer: Representation) -> Bytes =
  Bytes::concat_all([b"  ", probe(answer), b"\n"])
