import compiler.emit.typed_ir (Representation)
import compiler.emit.print.text (failing_return)

pub const probed_fn: Bytes = b"ply_probed"

pub const probed_helper: Bytes =
  Bytes::concat_all([
    b"#define ",
    probed_fn,
    b"(ctx) ({ \\\n",
    b"  char ply_probe; \\\n",
    b"  (uintptr_t)&ply_probe >= ctx->stack_floor || rt_stack_more_p(ctx); })\n",
  ])

pub fn probe(result: Representation) -> Bytes =
  Bytes::concat_all([b"if (!", probed_fn, b"(ctx)) ", failing_return(result)])

pub fn head_probe(result: Representation) -> Bytes =
  Bytes::concat_all([b"  ", probe(result), b"\n"])
