import std.bytes (ascii_of_int)
import compiler.emit.layout (head_words, pointer_floor, text_head)
import compiler.emit.abi (immortal_count)
import compiler.emit.plv1
import compiler.syntax.type_syntax (RaiseMode, mode_code)

pub fn declared(signature: Bytes) -> Bytes =
  Bytes::concat_all([b"__attribute__((visibility(\"hidden\"))) ", signature, b";\n"])

pub fn lines(text: List<Bytes>) -> Bytes = Bytes::concat_all(text.map(|l: Bytes| l.concat(b"\n")))

fn signatures() -> List<Bytes> =
  [
    b"void ply_out_tag(PlyCtx *ctx, Word t)",
    b"void ply_out_int(PlyCtx *ctx, Word v)",
    b"void ply_out_float(PlyCtx *ctx, Word bits)",
    b"void ply_out_decimal(PlyCtx *ctx, Word lo, Word hi)",
    b"void ply_out_fixed(PlyCtx *ctx, Word width, Word lo, Word hi)",
    b"void ply_out_char(PlyCtx *ctx, Word c)",
    b"void ply_out_str(PlyCtx *ctx, Word at, Word n)",
    b"void ply_out_bytes(PlyCtx *ctx, Word at, Word n)",
    b"void ply_out_count(PlyCtx *ctx, Word t, Word n)",
    b"void ply_out_ctor(PlyCtx *ctx, Word at, Word len, Word n)",
    b"void ply_out_name(PlyCtx *ctx, Word at, Word n)",
    b"void ply_out_handle(PlyCtx *ctx, Word kind)",
    b"void ply_out_carried(PlyCtx *ctx, Word w, Word ty)",
    b"void ply_out_fun(PlyCtx *ctx, Word f, Word at, Word n)",
    b"Word ply_out_again(PlyCtx *ctx, Word w)",
    b"Word ply_in_tag(PlyCtx *ctx)",
    b"Word ply_in_int(PlyCtx *ctx)",
    b"Word ply_in_float(PlyCtx *ctx)",
    b"Word ply_in_decimal(PlyCtx *ctx)",
    b"Word ply_in_fixed(PlyCtx *ctx, Word width)",
    b"Word ply_in_high(PlyCtx *ctx)",
    b"Word ply_in_char(PlyCtx *ctx)",
    b"Word ply_in_str(PlyCtx *ctx)",
    b"Word ply_in_bytes(PlyCtx *ctx)",
    b"Word ply_in_count(PlyCtx *ctx, Word t)",
    b"void ply_in_field(PlyCtx *ctx, Word at, Word n)",
    b"Word ply_in_name_is(PlyCtx *ctx, Word at, Word n)",
    b"void ply_shown_open(PlyCtx *ctx)",
    b"Word ply_lower_close(PlyCtx *ctx)",
    b"void ply_lift_close(PlyCtx *ctx)",
    b"void ply_entry_open(PlyCtx *ctx)",
    b"void ply_entry_close(PlyCtx *ctx, Word at, Word n)",
    b"Word ply_string_taken(PlyCtx *ctx)",
    b"Word ply_raised(PlyCtx *ctx, Word op, Word mode, Word args)",
    b"Word ply_task_raises(PlyCtx *ctx, Word op, Word args)",
  ]

pub fn marshalling_declared() -> Bytes = Bytes::concat_all(signatures().map(declared))

fn enumerated(prefix: Bytes, rows: List<{ name: Bytes, value: Int }>) -> Bytes =
  Bytes::concat_all([
    b"enum { ",
    Bytes::join(
      rows.map(|r: { name: Bytes, value: Int }|
        Bytes::concat_all([prefix, r.name, b" = ", ascii_of_int(r.value)])),
      b", ",
    ),
    b" };\n",
  ])

fn tags() -> List<{ name: Bytes, value: Int }> =
  [
    { name: b"UNIT", value: plv1::tag_unit() },
    { name: b"FALSE", value: plv1::tag_false() },
    { name: b"TRUE", value: plv1::tag_true() },
    { name: b"INT", value: plv1::tag_int() },
    { name: b"FLOAT", value: plv1::tag_float() },
    { name: b"DECIMAL", value: plv1::tag_decimal() },
    { name: b"FIXED", value: plv1::tag_fixed() },
    { name: b"STR", value: plv1::tag_string() },
    { name: b"BYTES", value: plv1::tag_bytes() },
    { name: b"LIST", value: plv1::tag_list() },
    { name: b"MAP", value: plv1::tag_map() },
    { name: b"RECORD", value: plv1::tag_record() },
    { name: b"CTOR", value: plv1::tag_constructor() },
    { name: b"CHAR", value: plv1::tag_char() },
    { name: b"ARRAY", value: plv1::tag_array() },
    { name: b"HANDLE", value: plv1::tag_handle() },
    { name: b"FUN", value: plv1::tag_function() },
    { name: b"AGAIN", value: plv1::tag_again() },
  ]

fn function_cases() -> List<{ name: Bytes, value: Int }> =
  [
    { name: b"NAMED", value: plv1::function_named() },
    { name: b"ANON", value: plv1::function_anonymous() },
    { name: b"CONST", value: plv1::function_constant() },
    { name: b"PROJECT", value: plv1::function_projection() },
    { name: b"TABLE", value: plv1::function_table() },
    { name: b"RESUMES", value: plv1::function_resumes() },
  ]

fn handle_kinds() -> List<{ name: Bytes, value: Int }> =
  [
    { name: b"PLAIN", value: plv1::handle_plain() },
    { name: b"TASK", value: plv1::handle_task() },
    { name: b"CHANNEL", value: plv1::handle_channel() },
    { name: b"SCOPED", value: plv1::handle_scoped() },
  ]

fn shown_kinds() -> List<{ name: Bytes, value: Int }> =
  [
    { name: b"SEALED", value: plv1::shown_sealed() },
    { name: b"SCOPED", value: plv1::shown_scoped() },
  ]

fn constants() -> Bytes =
  Bytes::concat_all([
    enumerated(b"PLY_TAG_", tags()),
    enumerated(b"PLY_FUN_", function_cases()),
    enumerated(b"PLY_HANDLE_", handle_kinds()),
    enumerated(b"PLY_SHOWN_", shown_kinds()),
    b"#define PLY_MARSHAL_IMMORTAL UINT32_C(",
    ascii_of_int(immortal_count()),
    b")\n#define PLY_POINTER_FLOOR ",
    ascii_of_int(pointer_floor()),
    b"\n#define PLY_MODE_RAISE ",
    ascii_of_int(mode_code(RaiseMode)),
    b"\n",
    b"#define PLY_FORMAT \"",
    plv1::format_mark(),
    b"\"\n#define PLY_FORMAT_BYTES ",
    ascii_of_int(plv1::format_mark().len()),
    b"\n",
  ])

fn frames() -> Bytes =
  lines([
    b"typedef struct { const unsigned char *at; int64_t n; int64_t number; } PlyName;",
    b"typedef struct { Word word; int64_t number; } PlyNumbered;",
    b"typedef struct PlyMarshal {",
    b"  struct PlyMarshal *outer;",
    b"  int lifting;",
    b"  unsigned char *bytes;",
    b"  int64_t len;",
    b"  int64_t room;",
    b"  int64_t at;",
    b"  PlyName *names;",
    b"  int64_t names_held;",
    b"  int64_t names_room;",
    b"  PlyNumbered *numbered;",
    b"  int64_t numbered_held;",
    b"  int64_t numbered_room;",
    b"  int sharing;",
    b"  int has_next;",
    b"  Word next;",
    b"  int64_t shareables;",
    b"  int64_t handles;",
    b"  int functions;",
    b"  int resumes;",
    b"  int results_entry;",
    b"  int escaping;",
    b"  int shown;",
    b"  const unsigned char *name;",
    b"  int64_t name_len;",
    b"  int has_name;",
    b"  int has_high;",
    b"  Word high;",
    b"} PlyMarshal;",
    b"static int64_t ply_scratch_bytes(int64_t bytes) {",
    b"  return PLY_HEADER + ((bytes + 7) & ~(int64_t)7);",
    b"}",
    b"static void *ply_scratch(PlyCtx *ctx, int64_t bytes) {",
    b"  return ply_words(ply_alloc(ctx, ply_scratch_bytes(bytes)));",
    b"}",
    b"static void ply_scratch_free(PlyCtx *ctx, void *at, int64_t bytes) {",
    b"  if (at) ply_free(ctx, (Word)(intptr_t)((char *)at - PLY_HEADER), ply_scratch_bytes(bytes));",
    b"}",
    b"static PlyMarshal *ply_frame(PlyCtx *ctx, int lifting) {",
    b"  PlyMarshal *m = (PlyMarshal *)ply_scratch(ctx, sizeof(PlyMarshal));",
    b"  memset(m, 0, sizeof(PlyMarshal));",
    b"  m->outer = (PlyMarshal *)(intptr_t)ctx->marshal;",
    b"  m->lifting = lifting;",
    b"  ctx->marshal = (Word)(intptr_t)m;",
    b"  return m;",
    b"}",
    b"static void ply_frame_free(PlyCtx *ctx, PlyMarshal *m) {",
    b"  ply_scratch_free(ctx, m->bytes, m->room);",
    b"  ply_scratch_free(ctx, m->names, m->names_room * (int64_t)sizeof(PlyName));",
    b"  ply_scratch_free(ctx, m->numbered, m->numbered_room * (int64_t)sizeof(PlyNumbered));",
    b"  ply_scratch_free(ctx, m, sizeof(PlyMarshal));",
    b"}",
    b"static void ply_marshal_failed(PlyCtx *ctx, const char *reason) {",
    b"  char text[1024];",
    b"  snprintf(text, sizeof text, \"a value marshalled between compiled code and the runtime: %s\", reason);",
    b"  ply_fail(ctx, 0, \"E0505\", text, \"in compiled code\", \"this is Ply's fault, not the program's\", 0);",
    b"}",
    b"static PlyMarshal *ply_writing(PlyCtx *ctx) {",
    b"  PlyMarshal *m = (PlyMarshal *)(intptr_t)ctx->marshal;",
    b"  if (m && !m->lifting) return m;",
    b"  ply_marshal_failed(ctx, \"a value written with no lowering open\");",
    b"  return 0;",
    b"}",
    b"static PlyMarshal *ply_reading(PlyCtx *ctx) {",
    b"  PlyMarshal *m = (PlyMarshal *)(intptr_t)ctx->marshal;",
    b"  if (m && m->lifting) return m;",
    b"  ply_marshal_failed(ctx, \"a value read with no lifting open\");",
    b"  return 0;",
    b"}",
  ])

fn writer() -> Bytes =
  lines([
    b"static void ply_put_room(PlyCtx *ctx, PlyMarshal *m, int64_t more) {",
    b"  if (m->len + more <= m->room) return;",
    b"  int64_t room = m->room * 2;",
    b"  if (room < m->len + more) room = m->len + more;",
    b"  if (room < 64) room = 64;",
    b"  unsigned char *bytes = (unsigned char *)ply_scratch(ctx, room);",
    b"  if (m->len) memcpy(bytes, m->bytes, (size_t)m->len);",
    b"  ply_scratch_free(ctx, m->bytes, m->room);",
    b"  m->bytes = bytes;",
    b"  m->room = room;",
    b"}",
    b"static void ply_put_byte(PlyCtx *ctx, PlyMarshal *m, int b) {",
    b"  ply_put_room(ctx, m, 1);",
    b"  m->bytes[m->len] = (unsigned char)b;",
    b"  m->len += 1;",
    b"}",
    b"static void ply_put_all(PlyCtx *ctx, PlyMarshal *m, const unsigned char *at, int64_t n) {",
    b"  if (n <= 0) return;",
    b"  ply_put_room(ctx, m, n);",
    b"  memcpy(m->bytes + m->len, at, (size_t)n);",
    b"  m->len += n;",
    b"}",
    b"static void ply_put_varint(PlyCtx *ctx, PlyMarshal *m, uint64_t n) {",
    b"  while (n >= 0x80) {",
    b"    ply_put_byte(ctx, m, (int)(n & 0xFF) | 0x80);",
    b"    n >>= 7;",
    b"  }",
    b"  ply_put_byte(ctx, m, (int)n);",
    b"}",
    b"static void ply_put_blob(PlyCtx *ctx, PlyMarshal *m, const unsigned char *at, int64_t n) {",
    b"  ply_put_varint(ctx, m, (uint64_t)n);",
    b"  ply_put_all(ctx, m, at, n);",
    b"}",
    b"static uint64_t ply_name_hash(const unsigned char *at, int64_t n) {",
    b"  uint64_t h = UINT64_C(14695981039346656037);",
    b"  for (int64_t i = 0; i < n; i++) h = (h ^ at[i]) * UINT64_C(1099511628211);",
    b"  return h;",
    b"}",
    b"static void ply_names_place(PlyName *table, int64_t room, PlyName name) {",
    b"  int64_t i = (int64_t)(ply_name_hash(name.at, name.n) & (uint64_t)(room - 1));",
    b"  while (table[i].number) i = (i + 1) & (room - 1);",
    b"  table[i] = name;",
    b"}",
    b"static void ply_names_grow(PlyCtx *ctx, PlyMarshal *m) {",
    b"  int64_t room = m->names_room ? m->names_room * 2 : 16;",
    b"  PlyName *table = (PlyName *)ply_scratch(ctx, room * (int64_t)sizeof(PlyName));",
    b"  memset(table, 0, (size_t)room * sizeof(PlyName));",
    b"  for (int64_t i = 0; i < m->names_room; i++) {",
    b"    if (m->names[i].number) ply_names_place(table, room, m->names[i]);",
    b"  }",
    b"  ply_scratch_free(ctx, m->names, m->names_room * (int64_t)sizeof(PlyName));",
    b"  m->names = table;",
    b"  m->names_room = room;",
    b"}",
    b"static void ply_put_name(PlyCtx *ctx, PlyMarshal *m, const unsigned char *at, int64_t n) {",
    b"  if ((m->names_held + 1) * 4 > m->names_room * 3) ply_names_grow(ctx, m);",
    b"  int64_t i = (int64_t)(ply_name_hash(at, n) & (uint64_t)(m->names_room - 1));",
    b"  while (m->names[i].number) {",
    b"    if (m->names[i].n == n && (n == 0 || memcmp(m->names[i].at, at, (size_t)n) == 0)) {",
    b"      ply_put_varint(ctx, m, (uint64_t)m->names[i].number);",
    b"      return;",
    b"    }",
    b"    i = (i + 1) & (m->names_room - 1);",
    b"  }",
    b"  m->names_held += 1;",
    b"  m->names[i].at = at;",
    b"  m->names[i].n = n;",
    b"  m->names[i].number = m->names_held;",
    b"  ply_put_varint(ctx, m, 0);",
    b"  ply_put_blob(ctx, m, at, n);",
    b"}",
    b"static uint64_t ply_word_hash(Word w) {",
    b"  uint64_t h = (uint64_t)w * UINT64_C(11400714819323198485);",
    b"  return h ^ (h >> 32);",
    b"}",
    b"static void ply_numbered_place(PlyNumbered *table, int64_t room, PlyNumbered row) {",
    b"  int64_t i = (int64_t)(ply_word_hash(row.word) & (uint64_t)(room - 1));",
    b"  while (table[i].number) i = (i + 1) & (room - 1);",
    b"  table[i] = row;",
    b"}",
    b"static void ply_numbered_grow(PlyCtx *ctx, PlyMarshal *m) {",
    b"  int64_t room = m->numbered_room ? m->numbered_room * 2 : 16;",
    b"  PlyNumbered *table = (PlyNumbered *)ply_scratch(ctx, room * (int64_t)sizeof(PlyNumbered));",
    b"  memset(table, 0, (size_t)room * sizeof(PlyNumbered));",
    b"  for (int64_t i = 0; i < m->numbered_room; i++) {",
    b"    if (m->numbered[i].number) ply_numbered_place(table, room, m->numbered[i]);",
    b"  }",
    b"  ply_scratch_free(ctx, m->numbered, m->numbered_room * (int64_t)sizeof(PlyNumbered));",
    b"  m->numbered = table;",
    b"  m->numbered_room = room;",
    b"}",
    b"static int64_t ply_numbered_of(PlyMarshal *m, Word w) {",
    b"  if (m->numbered_room == 0) return 0;",
    b"  int64_t i = (int64_t)(ply_word_hash(w) & (uint64_t)(m->numbered_room - 1));",
    b"  while (m->numbered[i].number) {",
    b"    if (m->numbered[i].word == w) return m->numbered[i].number;",
    b"    i = (i + 1) & (m->numbered_room - 1);",
    b"  }",
    b"  return 0;",
    b"}",
    b"static void ply_opens_shareable(PlyCtx *ctx, PlyMarshal *m) {",
    b"  int64_t n = m->shareables;",
    b"  m->shareables += 1;",
    b"  if (!m->sharing || !m->has_next) return;",
    b"  m->has_next = 0;",
    b"  if ((m->numbered_held + 1) * 4 > m->numbered_room * 3) ply_numbered_grow(ctx, m);",
    b"  PlyNumbered row;",
    b"  row.word = m->next;",
    b"  row.number = n + 1;",
    b"  ply_numbered_place(m->numbered, m->numbered_room, row);",
    b"  m->numbered_held += 1;",
    b"}",
    b"static void ply_put_handle(PlyCtx *ctx, PlyMarshal *m, uint64_t at) {",
    b"  ply_put_byte(ctx, m, PLY_TAG_HANDLE);",
    b"  ply_put_varint(ctx, m, at);",
    b"}",
    b"static int ply_width_known(Word width) {",
    b"  return width >= 0 && width < (Word)(sizeof ply_width_bits / sizeof ply_width_bits[0]);",
    b"}",
    b"static void ply_width_of(Word width, int *bits, int *is_signed) {",
    b"  *bits = ply_width_bits[width];",
    b"  *is_signed = ply_width_names[width][0] == 'I';",
    b"}",
    b"static uint64_t ply_width_low(uint64_t lo, int bits, int is_signed) {",
    b"  if (bits >= 64) return lo;",
    b"  uint64_t mask = (UINT64_C(1) << bits) - 1;",
    b"  uint64_t low = lo & mask;",
    b"  if (is_signed && (low >> (bits - 1)) != 0) return low | ~mask;",
    b"  return low;",
    b"}",
    b"void ply_out_tag(PlyCtx *ctx, Word t) {",
    b"  if (t != PLY_TAG_UNIT && t != PLY_TAG_FALSE && t != PLY_TAG_TRUE) {",
    b"    char text[64];",
    b"    snprintf(text, sizeof text, \"tag %lld is not a value alone\", (long long)t);",
    b"    ply_marshal_failed(ctx, text);",
    b"    return;",
    b"  }",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (m) ply_put_byte(ctx, m, (int)t);",
    b"}",
    b"void ply_out_int(PlyCtx *ctx, Word v) {",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (!m) return;",
    b"  ply_put_byte(ctx, m, PLY_TAG_INT);",
    b"  ply_put_varint(ctx, m, ((uint64_t)v << 1) ^ (uint64_t)(v >> 63));",
    b"}",
    b"void ply_out_float(PlyCtx *ctx, Word bits) {",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (!m) return;",
    b"  uint64_t b = (uint64_t)bits;",
    b"  uint64_t exponent = UINT64_C(0x7FF0000000000000);",
    b"  uint64_t mantissa = UINT64_C(0x000FFFFFFFFFFFFF);",
    b"  if ((b & exponent) == exponent && (b & mantissa) != 0) b = UINT64_C(0x7FF8000000000000);",
    b"  ply_put_byte(ctx, m, PLY_TAG_FLOAT);",
    b"  for (int i = 0; i < 8; i++) ply_put_byte(ctx, m, (int)((b >> (8 * i)) & 0xFF));",
    b"}",
    b"void ply_out_decimal(PlyCtx *ctx, Word lo, Word hi) {",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (!m) return;",
    b"  ply_put_byte(ctx, m, PLY_TAG_DECIMAL);",
    b"  for (int i = 0; i < 8; i++) ply_put_byte(ctx, m, (int)(((uint64_t)lo >> (8 * i)) & 0xFF));",
    b"  for (int i = 0; i < 8; i++) ply_put_byte(ctx, m, (int)(((uint64_t)hi >> (8 * i)) & 0xFF));",
    b"}",
    b"void ply_out_fixed(PlyCtx *ctx, Word width, Word lo, Word hi) {",
    b"  int bits, is_signed;",
    b"  if (!ply_width_known(width)) {",
    b"    char text[64];",
    b"    snprintf(text, sizeof text, \"width %lld is no width\", (long long)width);",
    b"    ply_marshal_failed(ctx, text);",
    b"    return;",
    b"  }",
    b"  ply_width_of(width, &bits, &is_signed);",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (!m) return;",
    b"  ply_put_byte(ctx, m, PLY_TAG_FIXED);",
    b"  ply_put_byte(ctx, m, (int)width);",
    b"  ply_put_varint(ctx, m, ply_width_low((uint64_t)lo, bits, is_signed));",
    b"  if (bits == 128) ply_put_varint(ctx, m, (uint64_t)hi);",
    b"}",
    b"void ply_out_char(PlyCtx *ctx, Word c) {",
    b"  if (c < 0 || c > 0x10FFFF || (c >= 0xD800 && c <= 0xDFFF)) {",
    b"    char text[64];",
    b"    snprintf(text, sizeof text, \"%lld is no character\", (long long)c);",
    b"    ply_marshal_failed(ctx, text);",
    b"    return;",
    b"  }",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (!m) return;",
    b"  ply_put_byte(ctx, m, PLY_TAG_CHAR);",
    b"  ply_put_varint(ctx, m, (uint64_t)c);",
    b"}",
    b"static void ply_out_blob(PlyCtx *ctx, int t, Word at, Word n) {",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (!m) return;",
    b"  ply_opens_shareable(ctx, m);",
    b"  ply_put_byte(ctx, m, t);",
    b"  ply_put_blob(ctx, m, (const unsigned char *)(intptr_t)at, n);",
    b"}",
    b"void ply_out_str(PlyCtx *ctx, Word at, Word n) { ply_out_blob(ctx, PLY_TAG_STR, at, n); }",
    b"void ply_out_bytes(PlyCtx *ctx, Word at, Word n) { ply_out_blob(ctx, PLY_TAG_BYTES, at, n); }",
    b"void ply_out_count(PlyCtx *ctx, Word t, Word n) {",
    b"  int heads = t == PLY_TAG_LIST || t == PLY_TAG_ARRAY || t == PLY_TAG_MAP || t == PLY_TAG_RECORD;",
    b"  if (!heads || n < 0) {",
    b"    char text[96];",
    b"    snprintf(text, sizeof text, \"tag %lld counting %lld\", (long long)t, (long long)n);",
    b"    ply_marshal_failed(ctx, text);",
    b"    return;",
    b"  }",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (!m) return;",
    b"  if (t != PLY_TAG_RECORD) ply_opens_shareable(ctx, m);",
    b"  ply_put_byte(ctx, m, (int)t);",
    b"  ply_put_varint(ctx, m, (uint64_t)n);",
    b"}",
    b"void ply_out_ctor(PlyCtx *ctx, Word at, Word len, Word n) {",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (!m) return;",
    b"  ply_put_byte(ctx, m, PLY_TAG_CTOR);",
    b"  ply_put_name(ctx, m, (const unsigned char *)(intptr_t)at, len);",
    b"  ply_put_varint(ctx, m, n < 0 ? 0 : (uint64_t)n);",
    b"}",
    b"void ply_out_name(PlyCtx *ctx, Word at, Word n) {",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (m) ply_put_name(ctx, m, (const unsigned char *)(intptr_t)at, n);",
    b"}",
    b"void ply_out_handle(PlyCtx *ctx, Word kind) {",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (!m) return;",
    b"  if (m->shown) {",
    b"    ply_put_handle(ctx, m, kind == PLY_HANDLE_SCOPED ? PLY_SHOWN_SCOPED : PLY_SHOWN_SEALED);",
    b"    return;",
    b"  }",
    b"  if (m->results_entry && !m->escaping && (kind == PLY_HANDLE_TASK || kind == PLY_HANDLE_CHANNEL)) {",
    b"    m->escaping = (int)kind;",
    b"  }",
    b"  ply_put_handle(ctx, m, (uint64_t)m->handles);",
    b"  m->handles += 1;",
    b"}",
    b"void ply_out_carried(PlyCtx *ctx, Word w, Word ty) {",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (!m) return;",
    b"  if (m->shown) {",
    b"    ((const PlyType *)(intptr_t)ty)->lower(ctx, w);",
    b"    return;",
    b"  }",
    b"  ply_put_handle(ctx, m, (uint64_t)m->handles);",
    b"  m->handles += 1;",
    b"}",
    b"void ply_out_fun(PlyCtx *ctx, Word f, Word at, Word n) {",
    b"  int leaves = n > 0 || ((const PlyFnDesc *)(intptr_t)ply_words(f)[0])->share(ctx, f) != 0;",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (!m) return;",
    b"  ply_put_byte(ctx, m, PLY_TAG_FUN);",
    b"  if (!leaves) {",
    b"    m->resumes = 1;",
    b"    ply_put_byte(ctx, m, PLY_FUN_RESUMES);",
    b"    return;",
    b"  }",
    b"  m->functions = 1;",
    b"  if (n <= 0) {",
    b"    ply_put_byte(ctx, m, PLY_FUN_ANON);",
    b"    return;",
    b"  }",
    b"  ply_put_byte(ctx, m, PLY_FUN_NAMED);",
    b"  ply_put_name(ctx, m, (const unsigned char *)(intptr_t)at, n);",
    b"}",
    b"Word ply_out_again(PlyCtx *ctx, Word w) {",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (!m || !m->sharing) return 0;",
    b"  if ((w & 7) == 0 && w >= PLY_POINTER_FLOOR && ply_obj(w)->rc == PLY_MARSHAL_IMMORTAL) {",
    b"    m->has_next = 0;",
    b"    return 0;",
    b"  }",
    b"  int64_t number = ply_numbered_of(m, w);",
    b"  if (number) {",
    b"    ply_put_byte(ctx, m, PLY_TAG_AGAIN);",
    b"    ply_put_varint(ctx, m, (uint64_t)(number - 1));",
    b"    return 1;",
    b"  }",
    b"  m->has_next = 1;",
    b"  m->next = w;",
    b"  return 0;",
    b"}",
  ])

fn reader() -> Bytes =
  lines([
    b"static int ply_utf8_valid(const unsigned char *s, int64_t n) {",
    b"  int64_t i = 0;",
    b"  while (i < n) {",
    b"    unsigned char b = s[i];",
    b"    if (b < 0x80) {",
    b"      i += 1;",
    b"      continue;",
    b"    }",
    b"    int more;",
    b"    unsigned char low = 0x80, high = 0xBF;",
    b"    if (b >= 0xC2 && b <= 0xDF) more = 1;",
    b"    else if (b >= 0xE0 && b <= 0xEF) {",
    b"      more = 2;",
    b"      if (b == 0xE0) low = 0xA0;",
    b"      if (b == 0xED) high = 0x9F;",
    b"    } else if (b >= 0xF0 && b <= 0xF4) {",
    b"      more = 3;",
    b"      if (b == 0xF0) low = 0x90;",
    b"      if (b == 0xF4) high = 0x8F;",
    b"    } else return 0;",
    b"    if (n - i <= more) return 0;",
    b"    if (s[i + 1] < low || s[i + 1] > high) return 0;",
    b"    for (int k = 2; k <= more; k++) {",
    b"      if ((s[i + k] & 0xC0) != 0x80) return 0;",
    b"    }",
    b"    i += more + 1;",
    b"  }",
    b"  return 1;",
    b"}",
    b"static int ply_get_byte(PlyCtx *ctx, PlyMarshal *m, unsigned char *b) {",
    b"  if (m->at >= m->len) {",
    b"    ply_marshal_failed(ctx, \"the value ends early\");",
    b"    return 0;",
    b"  }",
    b"  *b = m->bytes[m->at];",
    b"  m->at += 1;",
    b"  return 1;",
    b"}",
    b"static int ply_get_tag(PlyCtx *ctx, PlyMarshal *m, int t) {",
    b"  unsigned char found;",
    b"  if (!ply_get_byte(ctx, m, &found)) return 0;",
    b"  if (found == t) return 1;",
    b"  char text[96];",
    b"  snprintf(text, sizeof text, \"a value tagged %d where one tagged %d was read\", (int)found, t);",
    b"  ply_marshal_failed(ctx, text);",
    b"  return 0;",
    b"}",
    b"static int ply_get_varint(PlyCtx *ctx, PlyMarshal *m, uint64_t *out) {",
    b"  uint64_t n = 0;",
    b"  for (int shift = 0; shift < 64; shift += 7) {",
    b"    unsigned char b;",
    b"    if (!ply_get_byte(ctx, m, &b)) return 0;",
    b"    n |= (uint64_t)(b & 0x7F) << shift;",
    b"    if ((b & 0x80) == 0) {",
    b"      *out = n;",
    b"      return 1;",
    b"    }",
    b"  }",
    b"  ply_marshal_failed(ctx, \"a number longer than 64 bits\");",
    b"  return 0;",
    b"}",
    b"static int ply_get_count(PlyCtx *ctx, PlyMarshal *m, int64_t *out) {",
    b"  uint64_t n;",
    b"  if (!ply_get_varint(ctx, m, &n)) return 0;",
    b"  if (n > (uint64_t)(m->len - m->at)) {",
    b"    char text[96];",
    b"    snprintf(text, sizeof text, \"a count of %llu with fewer bytes left\", (unsigned long long)n);",
    b"    ply_marshal_failed(ctx, text);",
    b"    return 0;",
    b"  }",
    b"  *out = (int64_t)n;",
    b"  return 1;",
    b"}",
    b"static int ply_get_blob(PlyCtx *ctx, PlyMarshal *m, const unsigned char **at, int64_t *n) {",
    b"  if (!ply_get_count(ctx, m, n)) return 0;",
    b"  *at = m->bytes + m->at;",
    b"  m->at += *n;",
    b"  return 1;",
    b"}",
    b"static int ply_get_symbol(PlyCtx *ctx, PlyMarshal *m, const unsigned char **at, int64_t *n) {",
    b"  uint64_t number;",
    b"  if (!ply_get_varint(ctx, m, &number)) return 0;",
    b"  if (number == 0) {",
    b"    if (!ply_get_blob(ctx, m, at, n)) return 0;",
    b"    if (!ply_utf8_valid(*at, *n)) {",
    b"      ply_marshal_failed(ctx, \"a name that is not UTF-8\");",
    b"      return 0;",
    b"    }",
    b"    if (m->names_held == m->names_room) {",
    b"      int64_t room = m->names_room ? m->names_room * 2 : 16;",
    b"      PlyName *names = (PlyName *)ply_scratch(ctx, room * (int64_t)sizeof(PlyName));",
    b"      if (m->names_held) memcpy(names, m->names, (size_t)m->names_held * sizeof(PlyName));",
    b"      ply_scratch_free(ctx, m->names, m->names_room * (int64_t)sizeof(PlyName));",
    b"      m->names = names;",
    b"      m->names_room = room;",
    b"    }",
    b"    m->names[m->names_held].at = *at;",
    b"    m->names[m->names_held].n = *n;",
    b"    m->names[m->names_held].number = m->names_held + 1;",
    b"    m->names_held += 1;",
    b"    return 1;",
    b"  }",
    b"  if (number > (uint64_t)m->names_held) {",
    b"    char text[96];",
    b"    snprintf(text, sizeof text, \"name %llu before it was written\", (unsigned long long)number);",
    b"    ply_marshal_failed(ctx, text);",
    b"    return 0;",
    b"  }",
    b"  *at = m->names[number - 1].at;",
    b"  *n = m->names[number - 1].n;",
    b"  return 1;",
    b"}",
    b"static Word ply_keep_high(PlyMarshal *m, Word lo, Word hi) {",
    b"  m->high = hi;",
    b"  m->has_high = 1;",
    b"  return lo;",
    b"}",
    b"Word ply_in_tag(PlyCtx *ctx) {",
    b"  PlyMarshal *m = ply_reading(ctx);",
    b"  unsigned char t;",
    b"  if (!m || !ply_get_byte(ctx, m, &t)) return 0;",
    b"  if (t == PLY_TAG_UNIT || t == PLY_TAG_FALSE || t == PLY_TAG_TRUE) return t;",
    b"  char text[96];",
    b"  snprintf(text, sizeof text, \"a value tagged %d where one that is its tag alone was read\", (int)t);",
    b"  ply_marshal_failed(ctx, text);",
    b"  return 0;",
    b"}",
    b"Word ply_in_int(PlyCtx *ctx) {",
    b"  PlyMarshal *m = ply_reading(ctx);",
    b"  uint64_t z;",
    b"  if (!m || !ply_get_tag(ctx, m, PLY_TAG_INT) || !ply_get_varint(ctx, m, &z)) return 0;",
    b"  return (Word)(z >> 1) ^ -(Word)(z & 1);",
    b"}",
    b"static int ply_get_word(PlyCtx *ctx, PlyMarshal *m, uint64_t *out) {",
    b"  if (m->len - m->at < 8) {",
    b"    ply_marshal_failed(ctx, \"the value ends early\");",
    b"    return 0;",
    b"  }",
    b"  uint64_t w = 0;",
    b"  for (int i = 0; i < 8; i++) w |= (uint64_t)m->bytes[m->at + i] << (8 * i);",
    b"  m->at += 8;",
    b"  *out = w;",
    b"  return 1;",
    b"}",
    b"Word ply_in_float(PlyCtx *ctx) {",
    b"  PlyMarshal *m = ply_reading(ctx);",
    b"  uint64_t bits;",
    b"  if (!m || !ply_get_tag(ctx, m, PLY_TAG_FLOAT) || !ply_get_word(ctx, m, &bits)) return 0;",
    b"  return (Word)bits;",
    b"}",
    b"Word ply_in_decimal(PlyCtx *ctx) {",
    b"  PlyMarshal *m = ply_reading(ctx);",
    b"  uint64_t lo, hi;",
    b"  if (!m || !ply_get_tag(ctx, m, PLY_TAG_DECIMAL)) return 0;",
    b"  if (!ply_get_word(ctx, m, &lo) || !ply_get_word(ctx, m, &hi)) return 0;",
    b"  return ply_keep_high(m, (Word)lo, (Word)hi);",
    b"}",
    b"Word ply_in_fixed(PlyCtx *ctx, Word width) {",
    b"  PlyMarshal *m = ply_reading(ctx);",
    b"  unsigned char found;",
    b"  uint64_t low, high = 0;",
    b"  int bits, is_signed;",
    b"  if (!m || !ply_get_tag(ctx, m, PLY_TAG_FIXED) || !ply_get_byte(ctx, m, &found)) return 0;",
    b"  if (!ply_width_known(found)) {",
    b"    ply_marshal_failed(ctx, \"a fixed width this format does not have\");",
    b"    return 0;",
    b"  }",
    b"  ply_width_of(found, &bits, &is_signed);",
    b"  if (!ply_get_varint(ctx, m, &low)) return 0;",
    b"  if (bits == 128 && !ply_get_varint(ctx, m, &high)) return 0;",
    b"  if ((Word)found != width) {",
    b"    char text[96];",
    b"    snprintf(text, sizeof text, \"a %s where width %lld was read\", ply_width_names[found], (long long)width);",
    b"    ply_marshal_failed(ctx, text);",
    b"    return 0;",
    b"  }",
    b"  uint64_t lo = ply_width_low(low, bits, is_signed);",
    b"  if (bits < 128) high = is_signed && (int64_t)lo < 0 ? UINT64_MAX : 0;",
    b"  return ply_keep_high(m, (Word)lo, (Word)high);",
    b"}",
    b"Word ply_in_high(PlyCtx *ctx) {",
    b"  PlyMarshal *m = ply_reading(ctx);",
    b"  if (!m) return 0;",
    b"  if (!m->has_high) {",
    b"    ply_marshal_failed(ctx, \"a high word asked where no wide value was read\");",
    b"    return 0;",
    b"  }",
    b"  m->has_high = 0;",
    b"  return m->high;",
    b"}",
    b"Word ply_in_char(PlyCtx *ctx) {",
    b"  PlyMarshal *m = ply_reading(ctx);",
    b"  uint64_t c;",
    b"  if (!m || !ply_get_tag(ctx, m, PLY_TAG_CHAR) || !ply_get_varint(ctx, m, &c)) return 0;",
    b"  if (c > 0x10FFFF || (c >= 0xD800 && c <= 0xDFFF)) {",
    b"    ply_marshal_failed(ctx, \"a character that is not a Unicode scalar value\");",
    b"    return 0;",
    b"  }",
    b"  return (Word)c;",
    b"}",
    b"static Word ply_text_block(PlyCtx *ctx, const unsigned char *at, int64_t n) {",
    b"  Word o = ply_bytes_block(ctx, n);",
    b"  if (n > 0) memcpy(ply_text_payload(o), at, (size_t)n);",
    b"  return o;",
    b"}",
    b"Word ply_in_str(PlyCtx *ctx) {",
    b"  PlyMarshal *m = ply_reading(ctx);",
    b"  const unsigned char *at;",
    b"  int64_t n;",
    b"  if (!m || !ply_get_tag(ctx, m, PLY_TAG_STR) || !ply_get_blob(ctx, m, &at, &n)) return 0;",
    b"  if (!ply_utf8_valid(at, n)) {",
    b"    ply_marshal_failed(ctx, \"a string that is not UTF-8\");",
    b"    return 0;",
    b"  }",
    b"  return ply_text_block(ctx, at, n);",
    b"}",
    b"Word ply_in_bytes(PlyCtx *ctx) {",
    b"  PlyMarshal *m = ply_reading(ctx);",
    b"  const unsigned char *at;",
    b"  int64_t n;",
    b"  if (!m || !ply_get_tag(ctx, m, PLY_TAG_BYTES) || !ply_get_blob(ctx, m, &at, &n)) return 0;",
    b"  return ply_text_block(ctx, at, n);",
    b"}",
    b"Word ply_in_count(PlyCtx *ctx, Word t) {",
    b"  PlyMarshal *m = ply_reading(ctx);",
    b"  if (!m) return 0;",
    b"  int heads = t == PLY_TAG_LIST || t == PLY_TAG_ARRAY || t == PLY_TAG_MAP || t == PLY_TAG_RECORD || t == PLY_TAG_CTOR;",
    b"  if (!heads) {",
    b"    char text[64];",
    b"    snprintf(text, sizeof text, \"tag %lld heads no items\", (long long)t);",
    b"    ply_marshal_failed(ctx, text);",
    b"    return 0;",
    b"  }",
    b"  if (!ply_get_tag(ctx, m, (int)t)) return 0;",
    b"  if (t == PLY_TAG_CTOR) {",
    b"    if (!ply_get_symbol(ctx, m, &m->name, &m->name_len)) return 0;",
    b"    m->has_name = 1;",
    b"  }",
    b"  int64_t n;",
    b"  if (!ply_get_count(ctx, m, &n)) return 0;",
    b"  return n;",
    b"}",
    b"void ply_in_field(PlyCtx *ctx, Word at, Word n) {",
    b"  PlyMarshal *m = ply_reading(ctx);",
    b"  const unsigned char *name;",
    b"  int64_t len;",
    b"  if (!m || !ply_get_symbol(ctx, m, &name, &len)) return;",
    b"  if (len == n && (n == 0 || memcmp(name, (const void *)(intptr_t)at, (size_t)n) == 0)) return;",
    b"  char text[512];",
    b"  snprintf(text, sizeof text, \"field `%.*s` where `%.*s` was read\", (int)len, (const char *)name, (int)n, (const char *)(intptr_t)at);",
    b"  ply_marshal_failed(ctx, text);",
    b"}",
    b"Word ply_in_name_is(PlyCtx *ctx, Word at, Word n) {",
    b"  PlyMarshal *m = ply_reading(ctx);",
    b"  if (!m) return 0;",
    b"  if (!m->has_name) {",
    b"    ply_marshal_failed(ctx, \"a constructor's name asked before one was read\");",
    b"    return 0;",
    b"  }",
    b"  return m->name_len == n && (n == 0 || memcmp(m->name, (const void *)(intptr_t)at, (size_t)n) == 0);",
    b"}",
  ])

fn closing() -> Bytes =
  lines([
    b"void ply_shown_open(PlyCtx *ctx) {",
    b"  PlyMarshal *m = ply_frame(ctx, 0);",
    b"  m->shown = 1;",
    b"  m->sharing = 1;",
    b"  ply_put_all(ctx, m, (const unsigned char *)PLY_FORMAT, PLY_FORMAT_BYTES);",
    b"}",
    b"Word ply_lower_close(PlyCtx *ctx) {",
    b"  PlyMarshal *m = ply_writing(ctx);",
    b"  if (!m) return 0;",
    b"  ctx->marshal = (Word)(intptr_t)m->outer;",
    b"  if (m->handles > 0) {",
    b"    ply_frame_free(ctx, m);",
    b"    ply_marshal_failed(ctx, \"a value the bytes hold only a handle of\");",
    b"    return 0;",
    b"  }",
    b"  Word o = ply_text_block(ctx, m->bytes, m->len);",
    b"  ply_frame_free(ctx, m);",
    b"  return o;",
    b"}",
    b"void ply_lift_close(PlyCtx *ctx) {",
    b"  PlyMarshal *m = ply_reading(ctx);",
    b"  if (!m) return;",
    b"  ctx->marshal = (Word)(intptr_t)m->outer;",
    b"  int64_t left = m->len - m->at;",
    b"  ply_frame_free(ctx, m);",
    b"  if (left == 0) return;",
    b"  char text[96];",
    b"  snprintf(text, sizeof text, \"%lld bytes follow the value\", (long long)left);",
    b"  ply_marshal_failed(ctx, text);",
    b"}",
    b"Word ply_string_taken(PlyCtx *ctx) {",
    b"  Word n = builtin_elaborated_taken_count_p(ctx);",
    b"  Word o = ply_bytes_block(ctx, n);",
    b"  builtin_elaborated_taken_p(ctx, (Word)(intptr_t)ply_text_payload(o), n);",
    b"  return o;",
    b"}",
    b"static const char *ply_told(Word at, Word n) {",
    b"  const unsigned char *b = (const unsigned char *)(intptr_t)at;",
    b"  if (n <= PLY_FORMAT_BYTES) return \"a value\";",
    b"  switch (b[PLY_FORMAT_BYTES]) {",
    b"    case PLY_TAG_UNIT: return \"`()`\";",
    b"    case PLY_TAG_FALSE: case PLY_TAG_TRUE: return \"a `Bool`\";",
    b"    case PLY_TAG_INT: return \"an `Int`\";",
    b"    case PLY_TAG_FLOAT: return \"a `Float`\";",
    b"    case PLY_TAG_DECIMAL: return \"a `Decimal`\";",
    b"    case PLY_TAG_FIXED: return \"a fixed-width integer\";",
    b"    case PLY_TAG_CHAR: return \"a `Char`\";",
    b"    case PLY_TAG_STR: return \"a `String`\";",
    b"    case PLY_TAG_BYTES: return \"a `Bytes`\";",
    b"    case PLY_TAG_LIST: return \"a `List`\";",
    b"    case PLY_TAG_ARRAY: return \"an `Array`\";",
    b"    case PLY_TAG_RECORD: return \"a record\";",
    b"    case PLY_TAG_CTOR: return \"a variant\";",
    b"    case PLY_TAG_MAP: return \"a `Map`\";",
    b"    case PLY_TAG_FUN: return \"a function\";",
    b"    case PLY_TAG_HANDLE:",
    b"      if (n > PLY_FORMAT_BYTES + 1 && b[PLY_FORMAT_BYTES + 1] == PLY_SHOWN_SCOPED) return \"a `Scoped`\";",
    b"      return \"a `Secret`\";",
    b"    default: return \"a value\";",
    b"  }",
    b"}",
    b"static PlyText ply_shown_text(PlyCtx *ctx, Word at, Word len) {",
    b"  ply_shown_open(ctx);",
    b"  PlyMarshal *m = (PlyMarshal *)(intptr_t)ctx->marshal;",
    b"  ply_out_str(ctx, at, len);",
    b"  ctx->marshal = (Word)(intptr_t)m->outer;",
    b"  void *copy = malloc((size_t)m->len + 1);",
    b"  memcpy(copy, m->bytes, (size_t)m->len);",
    b"  PlyText shown = ply_text_of((Word)(intptr_t)copy, m->len);",
    b"  ply_frame_free(ctx, m);",
    b"  return shown;",
    b"}",
  ])

fn route_walked() -> Bytes =
  lines([
    b"static char *ply_stepped(char *route, const char *step) {",
    b"  size_t n = strlen(step);",
    b"  size_t held = route ? strlen(route) : 0;",
    b"  char *grown = (char *)malloc(n + held + 8);",
    b"  memcpy(grown, step, n);",
    b"  if (route) {",
    b"    memcpy(grown + n, \" \\xE2\\x86\\x92 \", 5);",
    b"    memcpy(grown + n + 5, route, held);",
    b"    n += held + 5;",
    b"    free(route);",
    b"  }",
    b"  grown[n] = 0;",
    b"  return grown;",
    b"}",
    b"static int ply_reaches_continuation(PlyCtx *ctx, PlyMarshal *m, char **route) {",
    b"  unsigned char t;",
    b"  uint64_t n;",
    b"  int64_t count;",
    b"  const unsigned char *at;",
    b"  int64_t len;",
    b"  char step[512];",
    b"  if (!ply_get_byte(ctx, m, &t)) return 0;",
    b"  switch (t) {",
    b"    case PLY_TAG_UNIT: case PLY_TAG_FALSE: case PLY_TAG_TRUE:",
    b"      return 0;",
    b"    case PLY_TAG_INT: case PLY_TAG_CHAR: case PLY_TAG_HANDLE: case PLY_TAG_AGAIN:",
    b"      ply_get_varint(ctx, m, &n);",
    b"      return 0;",
    b"    case PLY_TAG_FLOAT:",
    b"      m->at += 8;",
    b"      return 0;",
    b"    case PLY_TAG_DECIMAL:",
    b"      m->at += 16;",
    b"      return 0;",
    b"    case PLY_TAG_FIXED: {",
    b"      unsigned char width;",
    b"      int bits, is_signed;",
    b"      if (!ply_get_byte(ctx, m, &width)) return 0;",
    b"      if (!ply_width_known(width)) return 0;",
    b"      ply_width_of(width, &bits, &is_signed);",
    b"      ply_get_varint(ctx, m, &n);",
    b"      if (bits == 128) ply_get_varint(ctx, m, &n);",
    b"      return 0;",
    b"    }",
    b"    case PLY_TAG_STR: case PLY_TAG_BYTES:",
    b"      ply_get_blob(ctx, m, &at, &len);",
    b"      return 0;",
    b"    case PLY_TAG_LIST: case PLY_TAG_ARRAY:",
    b"      if (!ply_get_count(ctx, m, &count)) return 0;",
    b"      for (int64_t i = 0; i < count && ctx->failed == 0; i++) {",
    b"        if (ply_reaches_continuation(ctx, m, route)) {",
    b"          snprintf(step, sizeof step, \"%s %lld\", t == PLY_TAG_LIST ? \"item\" : \"element\", (long long)i);",
    b"          *route = ply_stepped(*route, step);",
    b"          return 1;",
    b"        }",
    b"      }",
    b"      return 0;",
    b"    case PLY_TAG_MAP:",
    b"      if (!ply_get_count(ctx, m, &count)) return 0;",
    b"      for (int64_t i = 0; i < count && ctx->failed == 0; i++) {",
    b"        if (ply_reaches_continuation(ctx, m, route)) {",
    b"          *route = ply_stepped(*route, \"a key\");",
    b"          return 1;",
    b"        }",
    b"        if (ply_reaches_continuation(ctx, m, route)) {",
    b"          *route = ply_stepped(*route, \"a map entry\");",
    b"          return 1;",
    b"        }",
    b"      }",
    b"      return 0;",
    b"    case PLY_TAG_RECORD:",
    b"      if (!ply_get_count(ctx, m, &count)) return 0;",
    b"      for (int64_t i = 0; i < count && ctx->failed == 0; i++) {",
    b"        if (!ply_get_symbol(ctx, m, &at, &len)) return 0;",
    b"        if (ply_reaches_continuation(ctx, m, route)) {",
    b"          snprintf(step, sizeof step, \"field `%.*s`\", (int)len, (const char *)at);",
    b"          *route = ply_stepped(*route, step);",
    b"          return 1;",
    b"        }",
    b"      }",
    b"      return 0;",
    b"    case PLY_TAG_CTOR:",
    b"      if (!ply_get_symbol(ctx, m, &at, &len)) return 0;",
    b"      if (!ply_get_varint(ctx, m, &n)) return 0;",
    b"      for (uint64_t i = 0; i < n && ctx->failed == 0; i++) {",
    b"        if (ply_reaches_continuation(ctx, m, route)) {",
    b"          snprintf(step, sizeof step, \"`%.*s`'s argument %llu\", (int)len, (const char *)at, (unsigned long long)(i + 1));",
    b"          *route = ply_stepped(*route, step);",
    b"          return 1;",
    b"        }",
    b"      }",
    b"      return 0;",
    b"    case PLY_TAG_FUN: {",
    b"      unsigned char kind;",
    b"      if (!ply_get_byte(ctx, m, &kind)) return 0;",
    b"      switch (kind) {",
    b"        case PLY_FUN_RESUMES:",
    b"          return 1;",
    b"        case PLY_FUN_NAMED:",
    b"          ply_get_symbol(ctx, m, &at, &len);",
    b"          return 0;",
    b"        case PLY_FUN_ANON:",
    b"          return 0;",
    b"        case PLY_FUN_CONST:",
    b"          ply_get_varint(ctx, m, &n);",
    b"          return ply_reaches_continuation(ctx, m, route);",
    b"        case PLY_FUN_PROJECT:",
    b"          ply_get_varint(ctx, m, &n);",
    b"          ply_get_varint(ctx, m, &n);",
    b"          return 0;",
    b"        case PLY_FUN_TABLE:",
    b"          ply_get_varint(ctx, m, &n);",
    b"          if (!ply_get_varint(ctx, m, &n)) return 0;",
    b"          for (uint64_t i = 0; i < n && ctx->failed == 0; i++) {",
    b"            if (ply_reaches_continuation(ctx, m, route) || ply_reaches_continuation(ctx, m, route)) return 1;",
    b"          }",
    b"          return ply_reaches_continuation(ctx, m, route);",
    b"        default:",
    b"          snprintf(step, sizeof step, \"a function of case %d\", (int)kind);",
    b"          ply_marshal_failed(ctx, step);",
    b"          return 0;",
    b"      }",
    b"    }",
    b"    default:",
    b"      snprintf(step, sizeof step, \"a value tagged %d\", (int)t);",
    b"      ply_marshal_failed(ctx, step);",
    b"      return 0;",
    b"  }",
    b"}",
  ])

fn entries() -> Bytes =
  lines([
    b"static void ply_lift_over(PlyCtx *ctx, unsigned char *bytes, int64_t n) {",
    b"  PlyMarshal *m = ply_frame(ctx, 1);",
    b"  m->bytes = bytes;",
    b"  m->room = n;",
    b"  m->len = n;",
    b"  m->at = n;",
    b"  if (n >= PLY_FORMAT_BYTES && memcmp(bytes, PLY_FORMAT, PLY_FORMAT_BYTES) == 0) {",
    b"    m->at = PLY_FORMAT_BYTES;",
    b"    return;",
    b"  }",
    b"  ply_marshal_failed(ctx, \"not an encoded value\");",
    b"}",
    b"void ply_entry_open(PlyCtx *ctx) {",
    b"  Word n = builtin_elaborated_entry_arguments_p(ctx);",
    b"  unsigned char *bytes = (unsigned char *)ply_scratch(ctx, n);",
    b"  builtin_elaborated_taken_p(ctx, (Word)(intptr_t)bytes, n);",
    b"  PlyMarshal *result = ply_frame(ctx, 0);",
    b"  result->results_entry = 1;",
    b"  ply_put_all(ctx, result, (const unsigned char *)PLY_FORMAT, PLY_FORMAT_BYTES);",
    b"  ply_lift_over(ctx, bytes, n);",
    b"}",
    b"static void ply_escaped(PlyCtx *ctx, Word at, Word n, int kind, const char *route) {",
    b"  const char *noun = kind == PLY_HANDLE_TASK ? \"a `Task`\" : kind == PLY_HANDLE_CHANNEL ? \"a `Chan`\" : \"a continuation\";",
    b"  int task = kind == PLY_HANDLE_TASK || kind == PLY_HANDLE_CHANNEL;",
    b"  size_t room = (size_t)n + strlen(noun) + (route ? strlen(route) : 0) + 64;",
    b"  char *message = (char *)malloc(room);",
    b"  snprintf(message, room, \"`%.*s` returned %s%s%s\", (int)n, (const char *)(intptr_t)at, noun, route ? \", reached through \" : \"\", route ? route : \"\");",
    b"  PlyText texts[7];",
    b"  texts[0] = ply_text(\"E0449\");",
    b"  texts[1] = ply_text(message);",
    b"  texts[2] = ply_text(\"returned here\");",
    b"  texts[3] = ply_text(task ? \"a task or a channel is a key into the scheduler that made it, which ends before the entry does\" : \"a continuation resumes a body that lives only as long as the entry that captured it\");",
    b"  texts[4] = ply_text(\"an entry point's result goes to its caller, which keeps it after the entry has ended and closed every scheduler it opened\");",
    b"  texts[5] = ply_text(task ? \"a value may carry it out of its scheduler, which no check stops, so it is rejected at the boundary instead of wherever it would be joined\" : \"no type records that a function is a continuation, so it is rejected at the boundary instead of wherever it would be resumed\");",
    b"  texts[6] = ply_text(task ? \"join the task, or drain the channel, inside the scheduler that made it, and return what that gives\" : \"resume the continuation before the entry returns, and return what it returns\");",
    b"  rt_failed_p(ctx, 0, (Word)(intptr_t)texts, 4, 0);",
    b"  free(message);",
    b"}",
    b"void ply_entry_close(PlyCtx *ctx, Word at, Word n) {",
    b"  PlyMarshal *m = (PlyMarshal *)(intptr_t)ctx->marshal;",
    b"  int64_t open = 0;",
    b"  for (PlyMarshal *p = m; p; p = p->outer) open += 1;",
    b"  ctx->marshal = 0;",
    b"  if (open != 1 || m->lifting) {",
    b"    char text[128];",
    b"    if (open > 1) snprintf(text, sizeof text, \"the entry left %lld marshallings open past its result's\", (long long)(open - 1));",
    b"    else snprintf(text, sizeof text, \"the entry ended the lowering its result was to be written into\");",
    b"    ply_marshal_failed(ctx, text);",
    b"    return;",
    b"  }",
    b"  int reached = 0;",
    b"  char *route = 0;",
    b"  if (!m->escaping && !m->functions && m->resumes) {",
    b"    PlyMarshal walking;",
    b"    memset(&walking, 0, sizeof walking);",
    b"    walking.lifting = 1;",
    b"    walking.bytes = m->bytes;",
    b"    walking.len = m->len;",
    b"    walking.at = PLY_FORMAT_BYTES;",
    b"    reached = ply_reaches_continuation(ctx, &walking, &route);",
    b"    ply_scratch_free(ctx, walking.names, walking.names_room * (int64_t)sizeof(PlyName));",
    b"  }",
    b"  if (ctx->failed) {",
    b"  } else if (m->escaping) {",
    b"    ply_escaped(ctx, at, n, m->escaping, 0);",
    b"  } else if (m->functions) {",
    b"    rt_entry_returned_p(ctx, 1, 0, 0);",
    b"  } else if (reached) {",
    b"    ply_escaped(ctx, at, n, PLY_HANDLE_PLAIN, route);",
    b"  } else if (m->handles > 0 || m->resumes) {",
    b"    rt_entry_returned_p(ctx, 2, 0, 0);",
    b"  } else {",
    b"    rt_entry_returned_p(ctx, 0, (Word)(intptr_t)m->bytes, m->len);",
    b"  }",
    b"  free(route);",
    b"  ply_frame_free(ctx, m);",
    b"}",
  ])

fn raises() -> Bytes =
  lines([
    b"static char *ply_field_text(PlyCtx *ctx, Word i) {",
    b"  Word n = builtin_elaborated_field_text_p(ctx, i);",
    b"  char *text = (char *)malloc((size_t)n + 1);",
    b"  builtin_elaborated_taken_p(ctx, (Word)(intptr_t)text, n);",
    b"  text[n] = 0;",
    b"  return text;",
    b"}",
    b"static PlyMarshal *ply_shown_of(PlyCtx *ctx, Word w, const PlyType *ty) {",
    b"  ply_shown_open(ctx);",
    b"  PlyMarshal *m = (PlyMarshal *)(intptr_t)ctx->marshal;",
    b"  ty->lower(ctx, w);",
    b"  if ((PlyMarshal *)(intptr_t)ctx->marshal != m) {",
    b"    ctx->marshal = (Word)(intptr_t)m->outer;",
    b"    ply_marshal_failed(ctx, \"a lowering left a marshalling of its own open\");",
    b"    return m;",
    b"  }",
    b"  ctx->marshal = (Word)(intptr_t)m->outer;",
    b"  return m;",
    b"}",
    b"static void ply_raised_let_go(PlyCtx *ctx, const PlyOp *op, const Word *args) {",
    b"  const PlyType *const *types = (const PlyType *const *)op->params;",
    b"  for (int64_t i = 0; i < op->params_len; i++) types[i]->dec(ctx, args[i]);",
    b"}",
    b"static void ply_abort_left(PlyCtx *ctx, const PlyOp *op, const Word *args) {",
    b"  const unsigned char *at = (const unsigned char *)\"\";",
    b"  int64_t n = 0;",
    b"  PlyMarshal *m = 0;",
    b"  if (op->params_len > 0) {",
    b"    const PlyType *const *types = (const PlyType *const *)op->params;",
    b"    m = ply_shown_of(ctx, args[0], types[0]);",
    b"    PlyMarshal reading;",
    b"    memset(&reading, 0, sizeof reading);",
    b"    reading.lifting = 1;",
    b"    reading.bytes = m->bytes;",
    b"    reading.len = m->len;",
    b"    reading.at = PLY_FORMAT_BYTES;",
    b"    const unsigned char *found;",
    b"    int64_t len;",
    b"    if (ctx->failed == 0 && m->len > PLY_FORMAT_BYTES && m->bytes[PLY_FORMAT_BYTES] == PLY_TAG_STR) {",
    b"      reading.at += 1;",
    b"      if (ply_get_blob(ctx, &reading, &found, &len) && reading.at == reading.len) {",
    b"        at = found;",
    b"        n = len;",
    b"      }",
    b"    }",
    b"  }",
    b"  char *message = (char *)malloc((size_t)n + 8);",
    b"  memcpy(message, \"panic: \", 7);",
    b"  if (n > 0) memcpy(message + 7, at, (size_t)n);",
    b"  PlyText texts[4];",
    b"  texts[0] = ply_text(\"E0502\");",
    b"  texts[1] = ply_text_of((Word)(intptr_t)message, n + 7);",
    b"  texts[2] = ply_text(\"raised here\");",
    b"  texts[3] = ply_text_of((Word)(intptr_t)at, n);",
    b"  ply_raised_let_go(ctx, op, args);",
    b"  rt_pended_p(ctx, 0, 0, (Word)(intptr_t)texts, 0, 0);",
    b"  free(message);",
    b"  if (m) ply_frame_free(ctx, m);",
    b"}",
    b"static void ply_raise_left(PlyCtx *ctx, const PlyOp *op, const char *effect, const char *name, const Word *args) {",
    b"  int64_t count = op->params_len;",
    b"  const PlyType *const *types = (const PlyType *const *)op->params;",
    b"  PlyMarshal **shown = (PlyMarshal **)malloc(sizeof(PlyMarshal *) * (size_t)(count + 1));",
    b"  PlyText *texts = (PlyText *)malloc(sizeof(PlyText) * (size_t)(count + 5));",
    b"  size_t room = strlen(effect) + strlen(name) + 32 * (size_t)count + 64;",
    b"  char *message = (char *)malloc(room);",
    b"  size_t at = (size_t)snprintf(message, room, \"`%s.%s` was raised\", effect, name);",
    b"  for (int64_t i = 0; i < count; i++) {",
    b"    shown[i] = ply_shown_of(ctx, args[i], types[i]);",
    b"    at += (size_t)snprintf(message + at, room - at, \"%s\\x01%lld\\x02\", i == 0 ? \" with \" : \", \", (long long)i);",
    b"    texts[5 + i] = ply_text_of((Word)(intptr_t)shown[i]->bytes, shown[i]->len);",
    b"  }",
    b"  snprintf(message + at, room - at, \", and nothing handles it\");",
    b"  if (ctx->failed) {",
    b"    ply_raised_let_go(ctx, op, args);",
    b"  } else {",
    b"    texts[0] = ply_text(\"E0502\");",
    b"    texts[1] = ply_text(message);",
    b"    texts[2] = ply_text(\"raised here\");",
    b"    texts[3] = ply_text(\"\");",
    b"    texts[4] = ply_text(\"a `try` around the call handles it as an `Err`, and a `handle` clause as it likes\");",
    b"    rt_pended_p(ctx, (Word)(intptr_t)op, (Word)(intptr_t)args, (Word)(intptr_t)texts, 1, count);",
    b"  }",
    b"  for (int64_t i = 0; i < count; i++) ply_frame_free(ctx, shown[i]);",
    b"  free(message);",
    b"  free(texts);",
    b"  free(shown);",
    b"}",
    b"Word ply_raised(PlyCtx *ctx, Word op, Word mode, Word args) {",
    b"  const PlyOp *described = (const PlyOp *)(intptr_t)op;",
    b"  const Word *words = (const Word *)(intptr_t)args;",
    b"  char *effect = ply_field_text(ctx, described->effect);",
    b"  char *name = ply_field_text(ctx, described->op);",
    b"  int aborting = strcmp(effect, \"abort\") == 0 && strcmp(name, \"raise\") == 0;",
    b"  int taken = mode == PLY_MODE_RAISE || aborting;",
    b"  if (taken && ctx->failed != 0) ply_raised_let_go(ctx, described, words);",
    b"  else if (aborting) ply_abort_left(ctx, described, words);",
    b"  else if (taken) ply_raise_left(ctx, described, effect, name, words);",
    b"  free(effect);",
    b"  free(name);",
    b"  return taken;",
    b"}",
    b"Word ply_task_raises(PlyCtx *ctx, Word op, Word args) {",
    b"  ply_raised(ctx, op, PLY_MODE_RAISE, args);",
    b"  return 0;",
    b"}",
    b"void *const ply_callbacks[] = { (void *)ply_raised };",
  ])

pub fn marshalling_defined() -> Bytes =
  Bytes::concat_all([
    constants(),
    frames(),
    b"static unsigned char *ply_text_payload(Word o) {\n  return ((unsigned char *)&ply_words(o)[",
    ascii_of_int(head_words(text_head())),
    b"]);\n}\n",
    writer(),
    reader(),
    closing(),
    route_walked(),
    entries(),
    raises(),
  ])
