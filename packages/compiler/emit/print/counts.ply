//! The ownership pass's instructions printed: counts taken and let go, cells kept for reuse and
//! freed, a flat value opened into its parts, and what a failure path releases before it leaves.
//!
//! A failure path releases what it holds through a chain of tails, Rust's drop elaboration on the
//! unwind path: each tail lets go of one value and goes on to the next, the latest declared first,
//! and each is printed once at the end of the C block its value was declared in, so failures whose
//! releases end alike share their ends.

import std.bytes (ascii_of_int)
import syntax.parsing (span_between)
import check.types (Type, TyCon, TyRecord)
import emit.keys (RootKey, Root, Written, TypeOp, Drop, Share, Keep, Copy, root_name, op_name)
import emit.roots (symbol_of)
import emit.layout (SumLaid, WordIs, LowBits, Nullary, Inline, Boxed, LWords, P, R, S, U, LSum,
                    words, pointer_floor, tag_bits, header_bytes, str_laid, layouts, columns_laid,
                    block_sizes)
import emit.lower.held (values_of, leaf_values)
import emit.tir (Rep, RInt, RWord, RFlat, RToken, RSum, Leaf, Var, Inst, Inc, Dec, Reset, Free,
                 Opened, AInt, AVar, Spine, RUnit, counted, parts_of, var_said)
import emit.print.tested (case_held)
import emit.pieces (Piece, Text, Hole, Symbol, spelled)
import emit.release (Part, WordAt, ByCase, Counted, Object, CaseBox, SumWord, IntWord, Through,
                     RuntimeHandle, Opening, InBox, Holding, StrBlock, ListOf, NodeOf, MapOf,
                     PairsOf, ArrayOf, ColumnsOf, ScalarBox, FnBlock, HandleBlock, Held, held_parts,
                     opening, stored_parts, held_root, case_root, boxed_alone, drop_of, root_of,
                     case_blocks, list_node_name)
import emit.print.text (Printing, Place, line, name_of, named, printing, part_names, declared_at,
                        pad, slot, assigned, arg_text, unprinted)
import emit.print.made (head_types)

/// The C a failure holding `unwind` runs: a jump to the chain of tails that lets go of each count it
/// holds (a reuse token's block, which holds nothing, freed) and then goes by `root`, the tails it
/// lacks added; `root` itself where it holds nothing.
pub fn exit_of(pr: Printing, unwind: List<Var>, root: Bytes) -> { pr: Printing, leave: Bytes } =
  by_declaration(pr, unwind.filter(|v: Var| counted(v.rep))).fold(
    { pr: pr, leave: root },
    |acc: { pr: Printing, leave: Bytes }, _: Int, vs: List<Var>|
      vs.fold(acc, |a: { pr: Printing, leave: Bytes }, v: Var| tailed(a.pr, v, a.leave)),
  )

/// `vs` keyed by when each was declared, so a chain built from the first lets go of what an inner
/// block declared before what the blocks around it did. A value held twice is listed twice.
fn by_declaration(pr: Printing, vs: List<Var>) -> Map<Int, List<Var>> =
  vs.fold(Map::new(), |m: Map<Int, List<Var>>, v: Var| {
    let k = declared_at(pr, v).at * 4294967296 + v.id;
    m.insert(k, match m.get(k) { Some(same) -> same.push(v), None -> [v] })
  })

/// The jump to the tail letting go of `v` and going on by `then`, added where there is none.
fn tailed(pr: Printing, v: Var, then: Bytes) -> { pr: Printing, leave: Bytes } = {
  let name = name_of(pr, v);
  let key = Bytes::concat_all([name, b" ", then]);
  let ts = pr.tails;
  match ts.keyed.get(key) {
    Some(k) -> { pr: pr, leave: tail_jump(k) },
    None -> {
      let k = ts.all.len();
      let block = declared_at(pr, v).block;
      {
        pr: {
          ..pr,
          tails: {
            all: ts.all.push({ name: name, ty: v.ty, rep: v.rep, then: then }),
            keyed: ts.keyed.insert(key, k),
            held: ts.held.insert(block, match ts.held.get(block) {
              Some(ks) -> ks.push(k),
              None -> [k],
            }),
          },
        },
        leave: tail_jump(k),
      }
    },
  }
}

fn tail_jump(k: Int) -> Bytes = Bytes::concat_all([b"goto ply_u", ascii_of_int(k), b";"])

/// `pr` inside a C block of its own, which what it names is declared in.
pub fn block_opened(pr: Printing) -> Printing =
  { ..pr, block: pr.blocks + 1, blocks: pr.blocks + 1 }

/// `pr` at the end of the C block it is in, indented `depth`, then back in block `outer`: the tails
/// of the values declared in the block printed there, the last added first so each falls into the
/// next where it goes on to it, and out of the way of a block that `falls` off its end. Each tail
/// lets go of its value by what the value's type lays out.
pub fn block_closed(pr: Printing, outer: Int, depth: Int, falls: Bool) -> Printing / {abort.raise} = {
  let here = match pr.tails.held.get(pr.block) { Some(ks) -> ks.reverse(), None -> [] };
  let lines = range(0, here.len()).fold(
    { pr: pr, out: [] },
    |acc: { pr: Printing, out: List<List<Piece>> }, i: Int|
      match here.at(i) {
        None -> acc,
        Some(k) -> match acc.pr.tails.all.at(k) {
          None -> acc,
          Some(t) -> {
            let falls_on = match here.at(i + 1) {
              Some(next) -> tail_jump(next) == t.then,
              None -> false,
            };
            let let_go = released(acc.pr, t.ty, t.rep, part_names(t.name, t.rep));
            {
              pr: let_go.pr,
              out: acc.out.push(
                [Text(Bytes::concat_all([b"ply_u", ascii_of_int(k), b": "]))].concat(
                  if let_go.out.len() == 0 { [Text(b";")] } else { let_go.out },
                ).push(
                  Text(if falls_on { b"" } else { b" ".concat(t.then) }),
                ),
              ),
            }
          },
        },
      },
  );
  let tailed_line = |q: Printing, at: Int, ps: List<Piece>|
    { ..q, out: q.out.push(Text(pad(at))).concat(ps).push(Text(b"\n")) };
  let closed = if lines.out.len() == 0 { lines.pr } else if falls {
    line(
      lines.out.fold(line(lines.pr, depth, b"if (0) {"), |q: Printing, ps: List<Piece>|
        tailed_line(q, depth + 1, ps)),
      depth,
      b"}",
    )
  } else { lines.out.fold(lines.pr, |q: Printing, ps: List<Piece>| tailed_line(q, depth, ps)) };
  { ..closed, block: outer }
}

// --- Counts by what a type lays out -------------------------------------------------------------

/// C printed so far and the printing it leaves.
pub type Said = { pr: Printing, out: List<Piece> }

/// `i`, one of `Inc`, `Dec`, `Reset`, `Free` and `Opened`, printed by what its value's type lays out.
pub fn count_printed(p: Place, pr: Printing, i: Inst) -> Printing / {abort.raise} =
  match i {
    Inc(n) -> {
      let once = duped(pr, n.var.ty, n.var.rep, part_names(name_of(pr, n.var), n.var.rep));
      if once.len() == 0 { pr }
      else { line(pr, p.depth, Bytes::join(range(0, n.n).map(|_: Int| once), b" ")) }
    },
    Dec(v) -> stated(p.depth, released(pr, v.ty, v.rep, part_names(name_of(pr, v), v.rep))),
    Reset(r) ->
      reset_boxed(
        pr,
        p.depth,
        r.token,
        r.of,
        opening(pr.ctors, r.of.ty, r.of.rep),
        held_root(Drop, pr.ctors, r.of.ty, r.of.rep),
      ),
    Free(r) -> {
      let t = name_of(pr, r.of);
      line(
        pr,
        p.depth,
        Bytes::concat_all([
          b"if (",
          t,
          b") ply_free(ctx, ",
          t,
          b", ",
          arg_text(pr, r.bytes),
          b");",
        ]),
      )
    },
    Opened(o) -> match o.of.rep {
      RFlat(ls) -> flat_opened(pr, p.depth, o.of, ls, o.words),
      RSum(s) -> match boxed_alone(s.laid) {
        Some(_) -> opened_block(pr, p.depth, o.of, o.words, opening(pr.ctors, o.of.ty, o.of.rep)),
        None -> opened_sum(pr, p.depth, o.of, o.words),
      },
      _ -> opened_block(pr, p.depth, o.of, o.words, opening(pr.ctors, o.of.ty, o.of.rep)),
    },
    _ -> pr,
  }

/// A flat value `of` of leaves `ls` opened into `words`, one per leaf: a leaf's word named as the
/// record's value it was and declared where `of` was, so it writes no C; a sum leaf's word declared
/// afresh as a copy of its run of the record's values, the counts they held now its; a leaf of no
/// words needs nothing.
fn flat_opened(pr: Printing, depth: Int, of: Var, ls: List<Leaf>, words: List<Var>) -> Printing = {
  let values = part_names(name_of(pr, of), of.rep);
  let at = declared_at(pr, of);
  let renamed = |q: Printing, w: Var, k: Int|
    match values.at(k) {
      Some(n) -> { ..q, names: q.names.insert(w.id, n), declared: q.declared.insert(w.id, at) },
      None -> q,
    };
  range(0, words.len()).fold(pr, |q: Printing, k: Int|
    match ((words.at(k), ls.at(k))) {
      (Some(w), Some(l)) -> {
        let run = leaf_values(ls, k);
        match l.rep {
          RUnit -> q,
          RSum(_) -> {
            let n = named(q, w);
            let into = part_names(n.name, w.rep);
            line(
              n.pr,
              depth,
              Bytes::join(
                range(0, into.len()).map(|j: Int|
                  Bytes::concat_all([
                    b"Word ",
                    nth(into, j),
                    b" = ",
                    nth(values, run.at + j),
                    b";",
                  ])),
                b" ",
              ),
            )
          },
          _ -> renamed(q, w, run.at),
        }
      },
      _ -> q,
    })
}

/// `s`'s C as one line indented `depth`, where it says anything.
fn stated(depth: Int, s: Said) -> Printing =
  if s.out.len() == 0 { s.pr }
  else { { ..s.pr, out: s.pr.out.push(Text(pad(depth))).concat(s.out).push(Text(b"\n")) } }

/// `a` then `b`, a space between where both say something.
fn spaced(a: List<Piece>, b: List<Piece>) -> List<Piece> =
  if a.len() == 0 { b } else if b.len() == 0 { a } else { a.push(Text(b" ")).concat(b) }

/// How many C values each part of a value held as `r` takes, in `parts_of(r)`'s order, as
/// `values_of(r)` lays them: a sum its words, a flat record's leaf its values.
fn part_widths(r: Rep) -> List<Int> =
  match r {
    RFlat(ls) -> ls.map(|l: Leaf| values_of(l.rep).len()),
    RSum(_) -> [values_of(r).len()],
    RUnit -> [0],
    _ -> parts_of(r).map(|_: Rep| 1),
  }

/// `values`, a value's C values held as `r` in `values_of(r)`'s order, as each part's.
fn per_part(r: Rep, values: List<Bytes>) -> List<List<Bytes>> =
  part_widths(r).fold({ at: 0, out: [] }, |acc: { at: Int, out: List<List<Bytes>> }, n: Int|
    { at: acc.at + n, out: acc.out.push(values.drop(acc.at).take(n)) }).out

/// The C letting go of a value of `ty` held as `r` whose C values are `values`, as `values_of(r)`
/// lays them: each counted word of each part, each drop root it names a hole noted among `pr`'s
/// calls; a reuse token's block freed by its size. A value spelled `0`, a word another holds now,
/// is passed over.
pub fn released(pr: Printing, ty: Type, r: Rep, values: List<Bytes>) -> Said / {abort.raise} =
  match r {
    RToken(n) -> {
      let t = nth(values, 0);
      {
        pr: pr,
        out: [
          Text(
            Bytes::concat_all([
              b"if (",
              t,
              b") ply_free(ctx, ",
              t,
              b", ",
              ascii_of_int(header_bytes() + 8 * n),
              b");",
            ]),
          ),
        ],
      }
    },
    _ -> {
      let each = held_parts(pr.ctors, ty, r);
      let vs = per_part(r, values);
      range(0, each.len()).fold({ pr: pr, out: [] }, |acc: Said, k: Int|
        match ((each.at(k), vs.at(k))) {
          (Some(parts), Some(ws)) -> {
            let s = let_go_of(acc.pr, parts, ws);
            { pr: s.pr, out: spaced(acc.out, s.out) }
          },
          _ -> acc,
        })
    },
  }

/// The C counting once more a value of `ty` held as `r` whose C values are `values`, as
/// `released` takes them: each counted word of each part, but a value spelled `0`.
pub fn duped(pr: Printing, ty: Type, r: Rep, values: List<Bytes>) -> Bytes / {abort.raise} = {
  let each = held_parts(pr.ctors, ty, r);
  let vs = per_part(r, values);
  Bytes::join(
    range(0, each.len()).fold([], |acc: List<Bytes>, k: Int|
      match ((each.at(k), vs.at(k))) {
        (Some(parts), Some(ws)) -> {
          let d = dup_of(parts, ws);
          if d.len() == 0 { acc } else { acc.push(d) }
        },
        _ -> acc,
      }),
    b" ",
  )
}

/// The C letting go of the counted `parts` of a value whose C words are `ws`: each drop root it
/// names a hole, noted among the root's calls with the head it is called at.
pub fn let_go_of(pr: Printing, parts: List<Part>, ws: List<Bytes>) -> Said / {abort.raise} =
  parts.fold({ pr: pr, out: [] }, |acc: Said, p: Part| {
    let s = part_let_go(acc.pr, p, ws);
    { pr: s.pr, out: spaced(acc.out, s.out) }
  })

fn part_let_go(pr: Printing, p: Part, ws: List<Bytes>) -> Said / {abort.raise} =
  match p {
    WordAt(w) -> if nth(ws, w.at) == b"0" { { pr: pr, out: [] } }
    else { word_let_go(pr, word_of(ws, w.at, w.masked), w.how) },
    ByCase(c) -> {
      let sws = sum_ws(ws, c.at, c.sum);
      let arms = c.cases.fold(
        { pr: pr, out: [] },
        |acc: Said, k: { case: Int, parts: List<Part> }| {
          let inner = let_go_of(acc.pr, k.parts, sws);
          {
            pr: inner.pr,
            out: acc.out.push(
              Text(Bytes::concat_all([b"case ", ascii_of_int(k.case), b": "])),
            ).concat(
              inner.out,
            ).push(
              Text(b" break; "),
            ),
          }
        },
      );
      {
        pr: arms.pr,
        out: [Text(Bytes::concat_all([b"switch (", case_held(c.sum, sws), b") { "]))].concat(
          arms.out,
        ).push(
          Text(b"}"),
        ),
      }
    },
  }

/// The C letting go of the word `x`, counted as `how` says.
fn word_let_go(pr: Printing, x: Bytes, how: Counted) -> Said / {abort.raise} =
  match how {
    Object(k) -> rooted(pr, k, b"ply_rel(ctx, ", x),
    CaseBox(c) -> rooted(pr, case_root(Drop, c.sum, c.case), b"ply_rel(ctx, ", x),
    SumWord(k) -> rooted(pr, k, b"ply_rel_sum(ctx, ", x),
    IntWord(k) -> rooted(pr, k, b"ply_rel_int(ctx, ", x),
    Through ->
      {
        pr: pr,
        out: [
          Text(
            Bytes::concat_all([
              b"if (",
              x,
              b" && ply_last(ctx, ",
              x,
              b")) ",
              described(x),
              b"->release(ctx, ",
              x,
              b");",
            ]),
          ),
        ],
      },
    RuntimeHandle ->
      {
        pr: pr,
        out: [
          Text(
            Bytes::concat_all([
              b"if (",
              x,
              b" && ply_last(ctx, ",
              x,
              b")) rt_handle_free_p(ctx, ",
              x,
              b");",
            ]),
          ),
        ],
      },
  }

/// The descriptor of the function value whose block is `x`, which its first word names.
fn described(x: Bytes) -> Bytes =
  Bytes::concat_all([b"((const PlyFnDesc *)(intptr_t)", slot(x, 0), b")"])

/// `call` of `x` and then drop root `k`, noted.
fn rooted(pr: Printing, k: RootKey, call: Bytes, x: Bytes) -> Said =
  {
    pr: noted(pr, k, RWord),
    out: [Text(Bytes::concat_all([call, x, b", "])), Hole(Symbol(Root(k))), Text(b");")],
  }

/// `pr` noting that its body names root `k`, a plain root of one word answering as `answer`, and the
/// head it names it at.
fn noted(pr: Printing, k: RootKey, answer: Rep) -> Printing =
  if pr.calls.contains(k) { pr } else {
    {
      ..pr,
      calls: pr.calls.push(k),
      expects: pr.expects.push({ callee: root_name(k), head: head_types([RWord], answer) }),
    }
  }

/// Word `at` of `ws`, with its tag bits clear where `masked`.
fn word_of(ws: List<Bytes>, at: Int, masked: Bool) -> Bytes = {
  let w = nth(ws, at);
  if masked { Bytes::concat_all([b"(", w, b" & ~(Word)", ascii_of_int(tag_mask()), b")"]) }
  else { w }
}

fn nth(ws: List<Bytes>, k: Int) -> Bytes = match ws.at(k) { Some(w) -> w, None -> b"0" }

fn tag_mask() -> Int = (1 << tag_bits()) - 1

/// The C words of a sum laid as `s` from word `at` of `ws`.
fn sum_ws(ws: List<Bytes>, at: Int, s: SumLaid) -> List<Bytes> =
  range(at, at + words(LSum(s))).map(|k: Int| nth(ws, k))

/// The C counting once more the counted `parts` of a value whose C words are `ws`.
pub fn dup_of(parts: List<Part>, ws: List<Bytes>) -> Bytes =
  Bytes::join(parts.map(|p: Part| part_dup(p, ws)).filter(|d: Bytes| d.len() > 0), b" ")

fn part_dup(p: Part, ws: List<Bytes>) -> Bytes =
  match p {
    WordAt(w) -> if nth(ws, w.at) == b"0" { b"" }
    else { word_dup(word_of(ws, w.at, w.masked), w.how) },
    ByCase(c) -> {
      let sws = sum_ws(ws, c.at, c.sum);
      Bytes::concat_all(
        [Bytes::concat_all([b"switch (", case_held(c.sum, sws), b") { "])].concat(
          c.cases.map(|k: { case: Int, parts: List<Part> }|
            Bytes::concat_all([
              b"case ",
              ascii_of_int(k.case),
              b": ",
              dup_of(k.parts, sws),
              b" break; ",
            ])),
        ).push(
          b"}",
        ),
      )
    },
  }

/// The C counting once more the word `x`, counted as `how` says: past the floor for a sum's word,
/// and only where it is no immediate for an `Int`'s.
fn word_dup(x: Bytes, how: Counted) -> Bytes =
  match how {
    SumWord(_) ->
      Bytes::concat_all([
        b"if ((uint64_t)",
        x,
        b" >= ",
        ascii_of_int(pointer_floor()),
        b") ply_dup(",
        x,
        b" & ~(Word)",
        ascii_of_int(tag_mask()),
        b");",
      ]),
    IntWord(_) ->
      Bytes::concat_all([b"if (!(", x, b" & ", ascii_of_int(tag_mask()), b")) ply_dup(", x, b");"]),
    _ -> Bytes::concat_all([b"ply_dup(", x, b");"]),
  }

/// The C words a block named `x` holds a part held as `r` in from word `at`: a sum's words.
fn slots_of(x: Bytes, at: Int, r: Rep) -> List<Bytes> =
  match r {
    RSum(s) -> range(at, at + words(LSum(s.laid))).map(|k: Int| slot(x, k)),
    _ -> [slot(x, at)],
  }

/// The block `o`, held only here, opened as `opening` says: its counted words read into `ws`, what a
/// container holds let go of, and its memory given back.
pub fn opened_block(
  pr: Printing,
  depth: Int,
  o: Var,
  ws: List<Var>,
  opening: Opening,
) -> Printing / {abort.raise} = {
  let x = name_of(pr, o);
  let read = |held: List<Held>|
    range(0, ws.len()).fold(pr, |q: Printing, i: Int|
      match ((ws.at(i), held.at(i))) {
        (Some(w), Some(h)) -> {
          let n = named(q, w);
          let from = slots_of(x, h.at, w.rep);
          let into = part_names(n.name, w.rep);
          line(
            n.pr,
            depth,
            Bytes::join(
              range(0, into.len()).map(|k: Int|
                Bytes::concat_all([b"Word ", nth(into, k), b" = ", nth(from, k), b";"])),
              b" ",
            ),
          )
        },
        _ -> q,
      });
  match opening {
    InBox(b) -> line(read(b.parts), depth, freed(x, b.words)),
    Holding(h) -> line(read([h]), depth, Bytes::concat_all([b"rt_handle_free_p(ctx, ", x, b");"])),
    ScalarBox(n) -> line(pr, depth, freed(x, n)),
    FnBlock -> line(pr, depth, Bytes::concat_all([described(x), b"->release(ctx, ", x, b");"])),
    HandleBlock -> line(pr, depth, Bytes::concat_all([b"rt_handle_free_p(ctx, ", x, b");"])),
    _ -> stated(depth, contents_let_go(pr, x, opening)),
  }
}

/// `ply_free` of the block `x` of `n` payload words.
fn freed(x: Bytes, n: Int) -> Bytes =
  Bytes::concat_all([b"ply_free(ctx, ", x, b", ", ascii_of_int(header_bytes() + 8 * n), b");"])

/// A header field of the block `x`.
fn field(x: Bytes, name: Bytes) -> Bytes = Bytes::concat_all([b"ply_obj(", x, b")->", name])

/// A loop over the first `n` of a block's slots, `ply_i` the place, its body `body`.
fn looped(n: Bytes, body: List<Piece>) -> List<Piece> =
  if body.len() == 0 { [] } else {
    [Text(Bytes::concat_all([b"for (int64_t ply_i = 0; ply_i < ", n, b"; ply_i++) { "]))].concat(
      body,
    ).push(
      Text(b" }"),
    )
  }

/// What a container `x`, held only here, holds let go of, as `opening` lays it, and its memory given
/// back. A list node's and a map node's room are their header's `layout`, a map branch's words its
/// keys' and sizes' runs.
fn contents_let_go(pr: Printing, x: Bytes, opening: Opening) -> Said / {abort.raise} =
  match opening {
    StrBlock(s) -> {
      let laid = str_laid();
      let v = rooted(pr, s.viewed, b"ply_rel(ctx, ", b"ply_v");
      {
        pr: v.pr,
        out: [
          Text(
            Bytes::concat_all([
              b"if (",
              field(x, laid.flags),
              b" & ",
              ascii_of_int(laid.view),
              b") { Word ply_v = ",
              slot(x, laid.viewed),
              b"; PlyObj *ply_h = ply_obj(ply_v); if (ply_h->rc < UINT32_C(0x80000000) && ply_h->",
              laid.views,
              b" != 0 && ply_h->",
              laid.views,
              b" != UINT16_MAX) ply_h->",
              laid.views,
              b" -= 1; ",
            ]),
          ),
        ].concat(
          v.out,
        ).push(
          Text(
            Bytes::concat_all([
              b" ",
              freed(x, laid.view_words),
              b" } else ply_free(ctx, ",
              x,
              b", ",
              ascii_of_int(header_bytes()),
              b" + (int64_t)",
              field(x, laid.room),
              b");",
            ]),
          ),
        ),
      }
    },
    ListOf(l) -> {
      let laid = layouts().list;
      let items = let_go_of(pr, l.item, [b"ply_w"]);
      let root = rooted(items.pr, l.node, b"ply_rel(ctx, ", slot(x, laid.root));
      let tail = if items.out.len() == 0 { [] } else {
        [
          Text(
            Bytes::concat_all([
              b"Word ply_w = ply_words(",
              x,
              b")[",
              ascii_of_int(laid.tail),
              b" + ply_i]; ",
            ]),
          ),
        ].concat(
          items.out,
        )
      };
      {
        pr: root.pr,
        out: [Text(b"{ ")].concat(looped(field(x, laid.tail_len), tail)).push(Text(b" ")).concat(
          root.out,
        ).push(
          Text(
            Bytes::concat_all([
              b" ply_free(ctx, ",
              x,
              b", ",
              ascii_of_int(header_bytes()),
              b" + 8 * (",
              ascii_of_int(laid.tail),
              b" + (int64_t)",
              field(x, laid.room),
              b")); }",
            ]),
          ),
        ),
      }
    },
    NodeOf(n) -> {
      let trie = layouts().trie;
      let kids = rooted(pr, n.node, b"ply_rel(ctx, ", slot_at(x, b"ply_i"));
      let items = let_go_of(kids.pr, n.item, [b"ply_w"]);
      let leaves = if items.out.len() == 0 { [] } else {
        [Text(Bytes::concat_all([b"Word ply_w = ", slot_at(x, b"ply_i"), b"; "]))].concat(items.out)
      };
      {
        pr: items.pr,
        out: [
          Text(
            Bytes::concat_all([
              b"if (",
              field(x, b"kind"),
              b" == ",
              ascii_of_int(trie.branch),
              b") { ",
            ]),
          ),
        ].concat(
          looped(field(x, b"len"), kids.out),
        ).push(
          Text(b" } else { "),
        ).concat(
          looped(field(x, b"len"), leaves),
        ).push(
          Text(
            Bytes::concat_all([
              b" } ply_free(ctx, ",
              x,
              b", ",
              ascii_of_int(header_bytes()),
              b" + 8 * (int64_t)",
              field(x, block_sizes().node_room),
              b");",
            ]),
          ),
        ),
      }
    },
    MapOf(k) -> {
      let root = rooted(pr, k, b"ply_rel(ctx, ", slot(x, layouts().map.root));
      { pr: root.pr, out: root.out.push(Text(b" ".concat(freed(x, block_sizes().map_words)))) }
    },
    PairsOf(m) -> {
      let tree = layouts().tree;
      let kid = rooted(pr, m.node, b"ply_rel(ctx, ", slot_at(x, b"ply_i"));
      let max = let_go_of(kid.pr, m.key, [b"ply_k"]);
      let keys = let_go_of(max.pr, m.key, [b"ply_k"]);
      let values = let_go_of(keys.pr, m.value, [b"ply_v"]);
      let read = |into: Bytes, at: Bytes, s: Said|
        if s.out.len() == 0 { [] } else {
          [Text(Bytes::concat_all([b"Word ", into, b" = ", slot_at(x, at), b"; "]))].concat(s.out)
        };
      let branch = kid.out.push(Text(b" ")).concat(
        read(b"ply_k", Bytes::concat_all([ascii_of_int(tree.keys), b" + ply_i"]), max),
      );
      let leaf = spaced(
        read(b"ply_k", b"2 * ply_i", keys),
        read(b"ply_v", b"2 * ply_i + 1", values),
      );
      {
        pr: values.pr,
        out: [
          Text(
            Bytes::concat_all([
              b"if (",
              field(x, b"kind"),
              b" == ",
              ascii_of_int(tree.branch),
              b") { ",
            ]),
          ),
        ].concat(
          looped(field(x, b"len"), branch),
        ).push(
          Text(Bytes::concat_all([b" ", freed(x, block_sizes().branch_words), b" } else { "])),
        ).concat(
          looped(field(x, b"len"), leaf),
        ).push(
          Text(
            Bytes::concat_all([
              b" ply_free(ctx, ",
              x,
              b", ",
              ascii_of_int(header_bytes()),
              b" + 16 * (int64_t)",
              field(x, block_sizes().leaf_room),
              b"); }",
            ]),
          ),
        ),
      }
    },
    ArrayOf(a) -> {
      let at = |j: Int|
        slot_at(
          x,
          Bytes::concat_all([b"ply_i * ", ascii_of_int(a.stride), b" + ", ascii_of_int(j)]),
        );
      let each = let_go_of(pr, a.element, range(0, a.stride).map(at));
      {
        pr: each.pr,
        out: [Text(b"{ ")].concat(looped(field(x, b"len"), each.out)).push(
          Text(
            Bytes::concat_all([
              b" ply_free(ctx, ",
              x,
              b", ",
              ascii_of_int(header_bytes()),
              b" + 8 * ",
              ascii_of_int(a.stride),
              b" * (int64_t)",
              field(x, b"len"),
              b"); }",
            ]),
          ),
        ),
      }
    },
    ColumnsOf(ks) -> {
      let first = columns_laid().first;
      let each = range(0, ks.len()).fold({ pr: pr, out: [] }, |acc: Said, i: Int|
        match ks.at(i) {
          Some(k) -> {
            let c = rooted(acc.pr, k, b"ply_rel(ctx, ", slot(x, first + i));
            { pr: c.pr, out: spaced(acc.out, c.out) }
          },
          None -> acc,
        });
      { pr: each.pr, out: spaced(each.out, [Text(freed(x, ks.len()))]) }
    },
    _ -> { pr: pr, out: [] },
  }

/// Word `at`, a C expression, of the block `x`.
fn slot_at(x: Bytes, at: Bytes) -> Bytes = Bytes::concat_all([b"ply_words(", x, b")[", at, b"]"])

/// `Walked({ of, op })` into `into`: a sum of one word through the block its case holds, anything
/// else through the block its word names.
pub fn walked_value(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  of: Var,
  op: TypeOp,
) -> Printing / {abort.raise} =
  match into {
    None -> unprinted(Spine, b"a value walked that nothing holds", var_said(of)),
    Some(n) -> {
      let whole = |q: Printing|
        walked(
          q,
          p.depth,
          n,
          of,
          op,
          opening(q.ctors, of.ty, of.rep),
          held_root(Drop, q.ctors, of.ty, of.rep),
        );
      match of.rep {
        RSum(s) -> match boxed_alone(s.laid) {
          Some(_) -> whole(pr),
          None -> walked_sum(pr, p.depth, n, of, op, case_blocks(pr.ctors, of.ty, s.laid)),
        },
        _ -> whole(pr),
      }
    },
  }

/// `Walked`: the block `of`, laid as `opening` says, walked as `op` does, its answer into `into`.
/// `Copy` answers a copy of it, each counted word counted once more, and lets go of `of` at
/// `dropped`; `Keep` answers it kept for good, a copy on the unit's persistent heap each counted word
/// of which is kept too, or `of` itself where it is kept already; `Share` marks it, and each block it
/// reaches, shared, answering 0 where a function value's capture or a runtime handle may not cross
/// and 1 otherwise.
pub fn walked(
  pr: Printing,
  depth: Int,
  into: Var,
  of: Var,
  op: TypeOp,
  opening: Opening,
  dropped: RootKey,
) -> Printing / {abort.raise} = {
  let x = name_of(pr, of);
  let n = named(pr, into);
  let a = n.name;
  match op {
    Share -> {
      let marked = match opening {
        FnBlock ->
          {
            pr: n.pr,
            out: [
              Text(
                Bytes::concat_all([
                  b"if (",
                  x,
                  b") ",
                  a,
                  b" = ",
                  described(x),
                  b"->share(ctx, ",
                  x,
                  b");",
                ]),
              ),
            ],
          },
        HandleBlock ->
          { pr: n.pr, out: [Text(Bytes::concat_all([b"if (", x, b") ", a, b" = 0;"]))] },
        Holding(_) ->
          { pr: n.pr, out: [Text(Bytes::concat_all([b"if (", x, b") ", a, b" = 0;"]))] },
        _ -> {
          let parts = slots_walked(
            n.pr,
            x,
            opening,
            |q: Printing, ps: List<Part>, ws: List<Bytes>| shared_parts(q, a, ps, ws),
          );
          {
            pr: parts.pr,
            out: [
              Text(
                Bytes::concat_all([
                  b"if (",
                  x,
                  b" && ",
                  field(x, b"rc"),
                  b" < UINT32_C(0x80000000)) { ",
                  field(x, b"rc"),
                  b" |= UINT32_C(0x80000000); ",
                ]),
              ),
            ].concat(
              parts.out,
            ).push(
              Text(b" }"),
            ),
          }
        },
      };
      stated(depth, {
        pr: marked.pr,
        out: [Text(Bytes::concat_all([b"Word ", a, b" = 1; "]))].concat(marked.out),
      })
    },
    Keep -> match opening {
      FnBlock ->
        line(
          n.pr,
          depth,
          Bytes::concat_all([
            b"Word ",
            a,
            b" = ",
            x,
            b" ? ",
            described(x),
            b"->keep(ctx, ",
            x,
            b") : 0;",
          ]),
        ),
      HandleBlock -> unprinted(Spine, b"a runtime handle kept for good", var_said(of)),
      Holding(_) -> unprinted(Spine, b"a hold kept for good", var_said(of)),
      _ -> {
        let size = block_size(x, opening);
        let parts = slots_walked(
          n.pr,
          a,
          opening,
          |q: Printing, ps: List<Part>, ws: List<Bytes>| kept_parts(q, ps, ws),
        );
        stated(depth, {
          pr: parts.pr,
          out: [
            Text(
              Bytes::concat_all([
                b"Word ",
                a,
                b" = ",
                x,
                b"; if (",
                x,
                b" && ",
                field(x, b"rc"),
                b" != UINT32_MAX) { ",
                a,
                b" = rt_alloc_kept_p(ctx, ",
                size,
                b"); ",
                copied_block(a, x, size),
                b" ",
              ]),
            ),
          ].concat(
            parts.out,
          ).push(
            Text(b" }"),
          ),
        })
      },
    },
    Copy -> match opening {
      FnBlock -> unprinted(Spine, b"a function value copied", var_said(of)),
      HandleBlock -> unprinted(Spine, b"a runtime handle copied", var_said(of)),
      Holding(_) -> unprinted(Spine, b"a hold copied", var_said(of)),
      _ -> {
        let size = block_size(x, opening);
        let duped_slots = slots_walked(
          n.pr,
          a,
          opening,
          |q: Printing, ps: List<Part>, ws: List<Bytes>| {
            let d = dup_of(ps, ws);
            { pr: q, out: if d.len() == 0 { [] } else { [Text(d)] } }
          },
        );
        let let_go = rooted(duped_slots.pr, dropped, b"ply_rel(ctx, ", x);
        stated(depth, {
          pr: let_go.pr,
          out: [
            Text(
              Bytes::concat_all([
                b"Word ",
                a,
                b" = rt_alloc_bytes_p(ctx, ",
                size,
                b"); ",
                copied_block(a, x, size),
                b" ",
              ]),
            ),
          ].concat(
            spaced(duped_slots.out, let_go.out),
          ),
        })
      },
    },
    _ -> unprinted(Spine, b"a block walked by no walk", var_said(of)),
  }
}

/// `Walked` of a sum of one word, `of`: the block the case it holds holds, of those `blocks` lists,
/// walked as `op` does, its answer into `into`. `Keep` answers the word kept, its tag kept with it,
/// and `Share` 0 where a block it reaches may not cross; a case holding no block walks nothing. A box
/// holding a sum of `of`'s own type goes on to that sum in a loop, so a chain of them is walked
/// without calls nesting; a kept chain is written into the box kept before it.
pub fn walked_sum(
  pr: Printing,
  depth: Int,
  into: Var,
  of: Var,
  op: TypeOp,
  blocks: List<{ case: Int, ty: Type, rep: Rep, opening: Opening }>,
) -> Printing / {abort.raise} =
  match of.rep {
    RSum(s) -> {
      let x = name_of(pr, of);
      let n = named(pr, into);
      let a = n.name;
      let untagged = match s.laid.classes { [P] -> true, _ -> false };
      let held = if op == Keep { b"*ply_into" } else { a };
      let tag = if untagged { b"" }
      else { Bytes::concat_all([b" | (ply_x & ", ascii_of_int(tag_mask()), b")"]) };
      let arms = blocks.fold(
        { pr: n.pr, out: [] },
        |acc: Said, b: { case: Int, ty: Type, rep: Rep, opening: Opening }| {
          let body = case_walked(acc.pr, held, tag, op, of, b.ty, b.rep, b.opening);
          {
            pr: body.pr,
            out: acc.out.push(
              Text(
                Bytes::concat_all([
                  b"case ",
                  ascii_of_int(b.case),
                  b": { Word ply_b = ",
                  if untagged { b"ply_x" }
                  else { Bytes::concat_all([b"(ply_x & ~(Word)", ascii_of_int(tag_mask()), b")"]) },
                  b"; ",
                ]),
              ),
            ).concat(
              body.out,
            ).push(
              Text(b" } break; "),
            ),
          }
        },
      );
      stated(depth, {
        pr: arms.pr,
        out: [
          Text(
            Bytes::concat_all([
              b"Word ",
              a,
              b" = ",
              if op == Keep { x } else { b"1" },
              b"; ",
              if op == Keep { Bytes::concat_all([b"Word *ply_into = &", a, b"; "]) } else { b"" },
              b"Word ply_x = ",
              x,
              b"; for (;;) { Word ply_n = 0; switch (",
              case_held(s.laid, [b"ply_x"]),
              b") { ",
            ]),
          ),
        ].concat(
          arms.out,
        ).push(
          Text(b"} if (!ply_n) break; ply_x = ply_n; }"),
        ),
      })
    },
    _ -> unprinted(Spine, b"a sum of one word walked that is no sum", var_said(of)),
  }

/// The block `ply_b` a sum's case holds, of type `ty` held as `rep` and laid as `o` says, walked as
/// `op` does, into `held`: the object of a pointer laid in place through its type's root, or a box
/// in place, whose last part of `own`'s type the loop around goes on to as `ply_n`.
fn case_walked(
  pr: Printing,
  held: Bytes,
  tag: Bytes,
  op: TypeOp,
  own: Var,
  ty: Type,
  rep: Rep,
  o: Opening,
) -> Said / {abort.raise} =
  match ((op, rep)) {
    (Keep, RWord) -> {
      let c = rooted_call(pr, root_of(Keep, ty), RWord, b"ply_b");
      {
        pr: c.pr,
        out: [Text(Bytes::concat_all([held, b" = "]))].concat(c.out).push(
          Text(Bytes::concat_all([tag, b";"])),
        ),
      }
    },
    (Share, RWord) -> {
      let c = rooted_call(pr, root_of(Share, ty), RInt, b"ply_b");
      {
        pr: c.pr,
        out: [Text(b"if (!")].concat(c.out).push(Text(Bytes::concat_all([b") ", held, b" = 0;"]))),
      }
    },
    _ -> {
      let split = chained(o, own);
      match op {
        Keep -> {
          let size = block_size(b"ply_b", o);
          let slots = slots_walked(
            pr,
            b"ply_k",
            split.rest,
            |q: Printing, ps: List<Part>, ws: List<Bytes>| kept_parts(q, ps, ws),
          );
          let on = match split.next {
            Some(at) ->
              Bytes::concat_all([b" ply_into = &", slot(b"ply_k", at), b"; ply_n = *ply_into;"]),
            None -> b"",
          };
          {
            pr: slots.pr,
            out: [
              Text(
                Bytes::concat_all([
                  b"if (",
                  field(b"ply_b", b"rc"),
                  b" != UINT32_MAX) { Word ply_k = rt_alloc_kept_p(ctx, ",
                  size,
                  b"); ",
                  copied_block(b"ply_k", b"ply_b", size),
                  b" ",
                ]),
              ),
            ].concat(
              slots.out,
            ).push(
              Text(Bytes::concat_all([b" ", held, b" = ply_k", tag, b";", on, b" }"])),
            ),
          }
        },
        Share -> {
          let slots = slots_walked(
            pr,
            b"ply_b",
            split.rest,
            |q: Printing, ps: List<Part>, ws: List<Bytes>| shared_parts(q, held, ps, ws),
          );
          let on = match split.next {
            Some(at) -> Bytes::concat_all([b" ply_n = ", slot(b"ply_b", at), b";"]),
            None -> b"",
          };
          {
            pr: slots.pr,
            out: [
              Text(
                Bytes::concat_all([
                  b"if (",
                  field(b"ply_b", b"rc"),
                  b" < UINT32_C(0x80000000)) { ",
                  field(b"ply_b", b"rc"),
                  b" |= UINT32_C(0x80000000); ",
                ]),
              ),
            ].concat(
              slots.out,
            ).push(
              Text(Bytes::concat_all([on, b" }"])),
            ),
          }
        },
        _ -> unprinted(Spine, b"a sum of one word walked by no walk", op_name(op)),
      }
    },
  }

/// A box opened as `o` without the last part held as `own` is, a sum of its own type, and the word
/// that part lies at, which a walk goes on to in a loop.
fn chained(o: Opening, own: Var) -> { rest: Opening, next: Option<Int> } =
  match o {
    InBox(b) -> {
      let last = range(0, b.parts.len()).fold(None, |found: Option<Int>, i: Int|
        match b.parts.at(i) {
          Some(h) -> if h.ty == own.ty && h.rep == own.rep { Some(i) } else { found },
          None -> found,
        });
      match last {
        Some(i) ->
          {
            rest: InBox({ ..b, parts: b.parts.take(i).concat(b.parts.drop(i + 1)) }),
            next: match b.parts.at(i) { Some(h) -> Some(h.at), None -> None },
          },
        None -> { rest: o, next: None },
      }
    },
    _ -> { rest: o, next: None },
  }

/// The bytes of the block `x`, laid as `o` says, its header among them, as a C expression.
fn block_size(x: Bytes, o: Opening) -> Bytes =
  match o {
    InBox(b) -> ascii_of_int(header_bytes() + 8 * b.words),
    StrBlock(_) ->
      Bytes::concat_all([
        b"(",
        field(x, str_laid().flags),
        b" & ",
        ascii_of_int(str_laid().view),
        b" ? ",
        ascii_of_int(header_bytes() + 8 * str_laid().view_words),
        b" : ",
        ascii_of_int(header_bytes()),
        b" + (((int64_t)",
        field(x, str_laid().room),
        b" + 7) & ~(int64_t)7))",
      ]),
    ListOf(_) ->
      Bytes::concat_all([
        ascii_of_int(header_bytes()),
        b" + 8 * (",
        ascii_of_int(layouts().list.tail),
        b" + (int64_t)",
        field(x, layouts().list.room),
        b")",
      ]),
    NodeOf(_) ->
      Bytes::concat_all([
        ascii_of_int(header_bytes()),
        b" + 8 * (int64_t)",
        field(x, block_sizes().node_room),
      ]),
    MapOf(_) -> ascii_of_int(header_bytes() + 8 * block_sizes().map_words),
    PairsOf(_) ->
      Bytes::concat_all([
        b"(",
        field(x, b"kind"),
        b" == ",
        ascii_of_int(layouts().tree.branch),
        b" ? ",
        ascii_of_int(header_bytes() + 8 * block_sizes().branch_words),
        b" : ",
        ascii_of_int(header_bytes()),
        b" + 16 * (int64_t)",
        field(x, block_sizes().leaf_room),
        b")",
      ]),
    ArrayOf(a) ->
      Bytes::concat_all([
        ascii_of_int(header_bytes()),
        b" + 8 * ",
        ascii_of_int(a.stride),
        b" * (int64_t)",
        field(x, b"len"),
      ]),
    ColumnsOf(ks) -> ascii_of_int(header_bytes() + 8 * ks.len()),
    ScalarBox(w) -> ascii_of_int(header_bytes() + 8 * w),
    _ -> ascii_of_int(header_bytes()),
  }

/// The C copying into the fresh block `c` of `size` bytes the header fields and payload words of
/// the block `x`, its count apart.
fn copied_block(c: Bytes, x: Bytes, size: Bytes) -> Bytes =
  Bytes::concat_all([
    Bytes::join(
      [b"kind", b"flags", b"aux", b"len", b"layout"].map(|f: Bytes|
        Bytes::concat_all([field(c, f), b" = ", field(x, f), b";"])),
      b" ",
    ),
    b" for (int64_t ply_i = 0; ply_i < ((",
    size,
    b") - ",
    ascii_of_int(header_bytes()),
    b") / 8; ply_i++) ",
    slot_at(c, b"ply_i"),
    b" = ",
    slot_at(x, b"ply_i"),
    b";",
  ])

/// Each counted slot of the block `b`, laid as `o` says, handed to `act` with its counted parts and
/// its words, as C expressions it may read and write: a box's parts, a hold's value, a view's viewed
/// value, a container's items and nodes, an array's elements, a `Columns`' columns.
fn slots_walked(
  pr: Printing,
  b: Bytes,
  o: Opening,
  act: (Printing, List<Part>, List<Bytes>) -> Said / {abort.raise},
) -> Said / {abort.raise} = {
  let node = |k: RootKey| [WordAt({ at: 0, masked: false, how: Object(k) })];
  let each = |q: Printing, parts: List<{ ps: List<Part>, ws: List<Bytes> }>|
    parts.fold({ pr: q, out: [] }, |acc: Said, x: { ps: List<Part>, ws: List<Bytes> }| {
      let s = act(acc.pr, x.ps, x.ws);
      { pr: s.pr, out: spaced(acc.out, s.out) }
    });
  match o {
    InBox(x) ->
      each(
        pr,
        x.parts.map(|h: Held| { ps: stored_parts(pr.ctors, h), ws: slots_of(b, h.at, h.rep) }),
      ),
    Holding(h) -> each(pr, [{ ps: stored_parts(pr.ctors, h), ws: [slot(b, h.at)] }]),
    StrBlock(s) -> {
      let v = act(pr, node(s.viewed), [slot(b, str_laid().viewed)]);
      {
        pr: v.pr,
        out: [
          Text(
            Bytes::concat_all([
              b"if (",
              field(b, str_laid().flags),
              b" & ",
              ascii_of_int(str_laid().view),
              b") { ",
            ]),
          ),
        ].concat(
          v.out,
        ).push(
          Text(b" }"),
        ),
      }
    },
    ListOf(l) -> {
      let items = act(pr, l.item, [
        slot_at(b, Bytes::concat_all([ascii_of_int(layouts().list.tail), b" + ply_i"])),
      ]);
      let root = act(items.pr, node(l.node), [slot(b, layouts().list.root)]);
      { pr: root.pr, out: spaced(looped(field(b, layouts().list.tail_len), items.out), root.out) }
    },
    NodeOf(n) -> {
      let kids = act(pr, node(n.node), [slot_at(b, b"ply_i")]);
      let items = act(kids.pr, n.item, [slot_at(b, b"ply_i")]);
      {
        pr: items.pr,
        out: [
          Text(
            Bytes::concat_all([
              b"if (",
              field(b, b"kind"),
              b" == ",
              ascii_of_int(layouts().trie.branch),
              b") { ",
            ]),
          ),
        ].concat(
          looped(field(b, b"len"), kids.out),
        ).push(
          Text(b" } else { "),
        ).concat(
          looped(field(b, b"len"), items.out),
        ).push(
          Text(b" }"),
        ),
      }
    },
    MapOf(k) -> act(pr, node(k), [slot(b, layouts().map.root)]),
    PairsOf(m) -> {
      let tree = layouts().tree;
      let kid = act(pr, node(m.node), [slot_at(b, b"ply_i")]);
      let greatest = act(kid.pr, m.key, [
        slot_at(b, Bytes::concat_all([ascii_of_int(tree.keys), b" + ply_i"])),
      ]);
      let keys = act(greatest.pr, m.key, [slot_at(b, b"2 * ply_i")]);
      let values = act(keys.pr, m.value, [slot_at(b, b"2 * ply_i + 1")]);
      {
        pr: values.pr,
        out: [
          Text(
            Bytes::concat_all([
              b"if (",
              field(b, b"kind"),
              b" == ",
              ascii_of_int(tree.branch),
              b") { ",
            ]),
          ),
        ].concat(
          looped(field(b, b"len"), spaced(kid.out, greatest.out)),
        ).push(
          Text(b" } else { "),
        ).concat(
          looped(field(b, b"len"), spaced(keys.out, values.out)),
        ).push(
          Text(b" }"),
        ),
      }
    },
    ArrayOf(a) -> {
      let at = |j: Int|
        slot_at(
          b,
          Bytes::concat_all([b"ply_i * ", ascii_of_int(a.stride), b" + ", ascii_of_int(j)]),
        );
      let es = act(pr, a.element, range(0, a.stride).map(at));
      { pr: es.pr, out: looped(field(b, b"len"), es.out) }
    },
    ColumnsOf(ks) ->
      each(
        pr,
        range(0, ks.len()).fold([], |acc: List<{ ps: List<Part>, ws: List<Bytes> }>, i: Int|
          match ks.at(i) {
            Some(k) -> acc.push({ ps: node(k), ws: [slot(b, columns_laid().first + i)] }),
            None -> acc,
          }),
      ),
    _ -> { pr: pr, out: [] },
  }
}

/// The C sharing each counted word of `parts` laid in `ws`, `a` set to 0 where one may not cross.
fn shared_parts(
  pr: Printing,
  a: Bytes,
  parts: List<Part>,
  ws: List<Bytes>,
) -> Said / {abort.raise} =
  each_word(pr, parts, ws, |q: Printing, w: Bytes, how: Counted| {
    let refused = Bytes::concat_all([b") ", a, b" = 0;"]);
    match how {
      Through ->
        {
          pr: q,
          out: [
            Text(
              Bytes::concat_all([
                b"if (",
                w,
                b" && !",
                described(w),
                b"->share(ctx, ",
                w,
                b"))",
                refused,
              ]),
            ),
          ],
        },
      RuntimeHandle -> { pr: q, out: [Text(Bytes::concat_all([b"if (", w, refused]))] },
      IntWord(_) ->
        {
          pr: q,
          out: [
            Text(
              Bytes::concat_all([
                b"if (",
                w,
                b" && !(",
                w,
                b" & 7) && ",
                field(w, b"rc"),
                b" < UINT32_C(0x80000000)) ",
                field(w, b"rc"),
                b" |= UINT32_C(0x80000000);",
              ]),
            ),
          ],
        },
      _ -> {
        let s = rooted_call(q, walking(Share, how), RInt, w);
        {
          pr: s.pr,
          out: [Text(Bytes::concat_all([b"if (", pointing(w, how), b" && !"]))].concat(s.out).push(
            Text(refused),
          ),
        }
      },
    }
  })

/// The C test that a word `w` counted as `how` points at a block: past the floor for a sum's word,
/// nonzero for any other.
fn pointing(w: Bytes, how: Counted) -> Bytes =
  match how {
    SumWord(_) -> Bytes::concat_all([b"(uint64_t)", w, b" >= ", ascii_of_int(pointer_floor())]),
    _ -> w,
  }

/// The C replacing each counted word of `parts` laid in `ws` by its value kept for good.
fn kept_parts(pr: Printing, parts: List<Part>, ws: List<Bytes>) -> Said / {abort.raise} =
  each_word(pr, parts, ws, |q: Printing, w: Bytes, how: Counted|
    match how {
      Through ->
        {
          pr: q,
          out: [
            Text(
              Bytes::concat_all([
                b"if (",
                w,
                b") ",
                w,
                b" = ",
                described(w),
                b"->keep(ctx, ",
                w,
                b");",
              ]),
            ),
          ],
        },
      RuntimeHandle -> unprinted(Spine, b"a runtime handle kept for good", w),
      IntWord(k) -> {
        let s = rooted_call(q, walking(Keep, Object(k)), RWord, w);
        {
          pr: s.pr,
          out: [Text(Bytes::concat_all([b"if (", w, b" && !(", w, b" & 7)) ", w, b" = "]))].concat(
            s.out,
          ).push(
            Text(b";"),
          ),
        }
      },
      _ -> {
        let s = rooted_call(q, walking(Keep, how), RWord, w);
        {
          pr: s.pr,
          out: [Text(Bytes::concat_all([b"if (", pointing(w, how), b") ", w, b" = "]))].concat(
            s.out,
          ).push(
            Text(b";"),
          ),
        }
      },
    })

/// `act` over each counted word of `parts` laid in `ws`, a sum's words by the case it holds; a
/// masked word handed as it lies, its tag bits kept.
fn each_word(
  pr: Printing,
  parts: List<Part>,
  ws: List<Bytes>,
  act: (Printing, Bytes, Counted) -> Said / {abort.raise},
) -> Said / {abort.raise} =
  parts.fold({ pr: pr, out: [] }, |acc: Said, p: Part| {
    let s = match p {
      WordAt(w) -> if w.masked { refused_walk(nth(ws, w.at)) }
      else { act(acc.pr, nth(ws, w.at), w.how) },
      ByCase(c) -> {
        let sws = sum_ws(ws, c.at, c.sum);
        let arms = c.cases.fold(
          { pr: acc.pr, out: [] },
          |a: Said, k: { case: Int, parts: List<Part> }| {
            let inner = each_word(a.pr, k.parts, sws, act);
            {
              pr: inner.pr,
              out: a.out.push(
                Text(Bytes::concat_all([b"case ", ascii_of_int(k.case), b": "])),
              ).concat(
                inner.out,
              ).push(
                Text(b" break; "),
              ),
            }
          },
        );
        {
          pr: arms.pr,
          out: [Text(Bytes::concat_all([b"switch (", case_held(c.sum, sws), b") { "]))].concat(
            arms.out,
          ).push(
            Text(b"}"),
          ),
        }
      },
    };
    { pr: s.pr, out: spaced(acc.out, s.out) }
  })

/// A tagged pointer walked whole is not yet written: its tag would need keeping across the walk.
fn refused_walk(w: Bytes) -> Said / {abort.raise} =
  unprinted(Spine, b"not yet: a word holding a case's tag in its pointer walked", w)

/// The root doing `op` to the block `how` counts a word of.
fn walking(op: TypeOp, how: Counted) -> RootKey / {abort.raise} =
  match how {
    Object(k) -> retargeted(k, op),
    SumWord(k) -> retargeted(k, op),
    IntWord(k) -> retargeted(k, op),
    CaseBox(c) -> case_root(op, c.sum, c.case),
    _ -> unprinted(Spine, b"a word walked through no root", op_name(op)),
  }

/// `k`, a root written for a type, written for the same type doing `op`.
fn retargeted(k: RootKey, op: TypeOp) -> RootKey / {abort.raise} =
  match k {
    Written(w) -> Written({ ..w, op: op }),
    _ -> unprinted(Spine, b"a root of no type walked", root_name(k)),
  }

/// A call of root `k` on `w` as an expression, answering as `answer`: the root's name a hole, noted
/// among `pr`'s calls with the head it is called at.
pub fn rooted_call(pr: Printing, k: RootKey, answer: Rep, w: Bytes) -> Said =
  {
    pr: noted(pr, k, answer),
    out: [Hole(Symbol(Root(k))), Text(Bytes::concat_all([b"(ctx, ", w, b")"]))],
  }

/// A sum of one word, `o`, renamed as the block the case a `Case` around has found it to hold: its
/// word with its tag bits clear.
pub fn opened_sum(pr: Printing, depth: Int, o: Var, ws: List<Var>) -> Printing / {abort.raise} =
  match ((o.rep, ws)) {
    (RSum(s), [b]) -> {
      let x = name_of(pr, o);
      assigned(pr, depth, b, b"Word", match s.laid.classes {
        [P] -> x,
        _ -> Bytes::concat_all([b"(", x, b" & ~(Word)", ascii_of_int(tag_mask()), b")"]),
      })
    },
    _ -> unprinted(Spine, b"a sum opened other than into the block its case holds", var_said(o)),
  }

/// `Reset`: where `of`, a box laid as `opening` says, is held only here, what it holds let go of
/// and its cells kept as `token`; else one count of it let go of, at its drop root `dropped`, and no
/// cells kept.
pub fn reset_boxed(
  pr: Printing,
  depth: Int,
  token: Var,
  of: Var,
  opening: Opening,
  dropped: RootKey,
) -> Printing / {abort.raise} =
  match opening {
    InBox(b) -> {
      let x = name_of(pr, of);
      let t = named(pr, token);
      let held = b.parts.fold({ pr: t.pr, out: [] }, |acc: Said, h: Held| {
        let s = let_go_of(acc.pr, stored_parts(pr.ctors, h), slots_of(x, h.at, h.rep));
        { pr: s.pr, out: spaced(acc.out, s.out) }
      });
      let shared = rooted(held.pr, dropped, b"ply_rel(ctx, ", x);
      stated(depth, {
        pr: shared.pr,
        out: [
          Text(
            Bytes::concat_all([
              b"Word ",
              t.name,
              b" = 0; if (",
              x,
              b" && ",
              field(x, b"rc"),
              b" == 1) { ",
            ]),
          ),
        ].concat(
          spaced(held.out, [Text(Bytes::concat_all([t.name, b" = ", x, b";"]))]),
        ).push(
          Text(b" } else "),
        ).concat(
          shared.out,
        ),
      })
    },
    _ -> unprinted(Spine, b"cells kept of other than a box", var_said(of)),
  }

/// `Val.LastOf(v)` into `into`: `v` where its count was the last, which this takes, and 0 otherwise.
/// A sum's word is counted past the floor, its block its word with its tag bits clear.
pub fn last_of(p: Place, pr: Printing, into: Option<Var>, v: Var) -> Printing / {abort.raise} =
  match into {
    None -> unprinted(Spine, b"a last holder's test nothing holds", var_said(v)),
    Some(n) -> {
      let x = name_of(pr, v);
      let tagged = match v.rep {
        RSum(s) -> match s.laid.classes { [P] -> false, _ -> true },
        _ -> false,
      };
      let tested = if tagged {
        Bytes::concat_all([
          b"(uint64_t)",
          x,
          b" >= ",
          ascii_of_int(pointer_floor()),
          b" && ply_last(ctx, ",
          x,
          b" & ~(Word)",
          ascii_of_int(tag_mask()),
          b")",
        ])
      } else { Bytes::concat_all([x, b" && ply_last(ctx, ", x, b")"]) };
      assigned(pr, p.depth, n, b"Word", Bytes::concat_all([b"(", tested, b") ? ", x, b" : 0"]))
    },
  }

fn local(id: Int, rep: Rep) -> Var = { id: id, ty: TyCon({ name: b"T", args: [] }), rep: rep }

fn place() -> Place =
  {
    u: {
      symbol: b"m_f",
      base: 0,
      answer: RWord,
      site: None,
      arm: None,
      looping: None,
      landing: None,
      group: None,
      leaving: b"ctx->fuel += 1;",
    },
    at: span_between(0, 0),
    leave: b"return 0;",
    depth: 0,
  }

fn printed(pr: Printing, i: Inst) -> Bytes / {abort.raise} =
  spelled(count_printed(place(), pr, i).out)

/// What a failure holding `unwind` runs after what `pr` named, in a function whose blocks are all
/// closed: its jump, then the tails the function's end prints.
fn unwound(pr: Printing, unwind: List<Var>) -> Bytes / {abort.raise} = {
  let x = exit_of({ ..pr, out: [] }, unwind, b"return 0;");
  Bytes::concat_all([x.leave, b"\n", spelled(block_closed(x.pr, 0, 0, false).out)])
}

fn lets_go(text: Bytes, name: Bytes) -> Bool =
  text.index_of(Bytes::concat_all([b"ply_rel(ctx, ", name, b", "])) != None

fn occurrences(t: Bytes, s: Bytes) -> Int / {abort.raise} = t.split(s).len() - 1

fn string() -> Type = TyCon({ name: b"String", args: [] })

fn int() -> Type = TyCon({ name: b"Int", args: [] })

/// A local of type `String`, held as its word.
fn text_local(id: Int) -> Var = { id: id, ty: string(), rep: RWord }

/// What a drop root's name prints as where a body lets go of a value of `ty`.
fn drop_spelled(ty: Type) -> Bytes / {abort.raise} = root_spelled(drop_of(ty))

test "a count is taken or let go of each part of a value that holds one, as many times as it is taken" {
  let rec = TyRecord([{ name: b"a", ty: int() }, { name: b"b", ty: string() }]);
  let x = text_local(0);
  let flat = {
    id: 1,
    ty: rec,
    rep: RFlat([{ name: b"a", rep: RInt }, { name: b"b", rep: RWord }]),
  };
  let k = { id: 2, ty: int(), rep: RInt };
  let d = drop_spelled(string());
  let pr = printing(Map::new().insert(0, b"p0").insert(1, b"t1").insert(2, b"t2"));
  assert_eq(printed(pr, Inc({ var: x, n: 2 })), b"  ply_dup(p0); ply_dup(p0);\n");
  assert_eq(printed(pr, Dec(x)), Bytes::concat_all([b"  ply_rel(ctx, p0, ", d, b");\n"]));
  // A flat value's counted leaf holds a count; its scalar leaf holds none.
  let flat_let_go = Bytes::concat_all([b"ply_rel(ctx, t1_1, ", d, b");"]);
  assert_eq(printed(pr, Dec(flat)), Bytes::concat_all([b"  ", flat_let_go, b"\n"]));
  assert_eq(
    unwound(pr, [x, k, flat]),
    Bytes::concat_all([
      b"goto ply_u1;\n  ply_u1: ",
      flat_let_go,
      b"\n  ply_u0: ply_rel(ctx, p0, ",
      d,
      b"); return 0;\n",
    ]),
  );
  // A failure that holds no count leaves at once.
  assert_eq(unwound(pr, [k]), b"return 0;\n")
}

test "a reset keeps a box held only here as its token, and a token no make took is freed by its size" {
  let rec = TyRecord([{ name: b"a", ty: int() }, { name: b"b", ty: string() }]);
  let x = { id: 0, ty: rec, rep: RWord };
  let token = { id: 1, ty: rec, rep: RToken(2) };
  let pr = printing(Map::new().insert(0, b"p0"));
  let reset = count_printed(place(), pr, Reset({ token: token, of: x }));
  assert_eq(name_of(reset, token), b"t1");
  assert_eq(
    spelled(reset.out),
    Bytes::concat_all([
      b"  Word t1 = 0; if (p0 && ply_obj(p0)->rc == 1) { ply_rel(ctx, ply_words(p0)[1], ",
      drop_spelled(string()),
      b"); t1 = p0; } else ply_rel(ctx, p0, ",
      drop_spelled(rec),
      b");\n",
    ]),
  );
  // A failure holding the token frees it before it lets go of what was declared before it.
  assert_eq(
    unwound(reset, [x, token]),
    Bytes::concat_all([
      b"goto ply_u1;\n  ply_u1: if (t1) ply_free(ctx, t1, 32);\n  ply_u0: ply_rel(ctx, p0, ",
      drop_spelled(rec),
      b"); return 0;\n",
    ]),
  )
}

test "a flat value opened writes no C, and each word is the part it was" {
  let rec = TyRecord([{ name: b"a", ty: string() }, { name: b"b", ty: int() }]);
  let flat = {
    id: 0,
    ty: rec,
    rep: RFlat([{ name: b"a", rep: RWord }, { name: b"b", rep: RInt }]),
  };
  let words = [text_local(1), { id: 2, ty: int(), rep: RInt }];
  let pr = printing(Map::new().insert(0, b"p0"));
  let opened = count_printed(place(), pr, Opened({ of: flat, words: words }));
  assert_eq(opened.out, []);
  assert_eq(words.map(|w: Var| name_of(opened, w)), [b"p0_0", b"p0_1"]);
  // Letting go of the first word lets go of what the value held.
  let by_words = unwound(opened, [words.get(0)]);
  let whole = unwound(pr, [flat]);
  assert(lets_go(by_words, b"p0_0") && lets_go(whole, b"p0_0"));
  assert(!lets_go(by_words, b"p0_1") && !lets_go(whole, b"p0_1"))
}

test "a flat value's sum leaf opened is a copy of its run of the record's words" {
  let sum = TyCon({ name: b"m.T", args: [] });
  let s = RSum({ laid: tagged_laid(), cases: [b"m.N", b"m.S", b"m.E"] });
  let rec = TyRecord([
    { name: b"a", ty: sum },
    { name: b"u", ty: TyRecord([]) },
    { name: b"n", ty: int() },
  ]);
  let flat = {
    id: 0,
    ty: rec,
    rep: RFlat([{ name: b"a", rep: s }, { name: b"u", rep: RUnit }, { name: b"n", rep: RInt }]),
  };
  let words = [
    { id: 1, ty: sum, rep: s },
    { id: 2, ty: TyRecord([]), rep: RUnit },
    { id: 3, ty: int(), rep: RInt },
  ];
  let opened = count_printed(
    place(),
    printing(Map::new().insert(0, b"p0")),
    Opened({ of: flat, words: words }),
  );
  assert_eq(spelled(opened.out), b"  Word t1_0 = p0_0; Word t1_1 = p0_1;\n");
  assert_eq(part_names(name_of(opened, words.get(0)), s), [b"t1_0", b"t1_1"]);
  assert_eq(name_of(opened, words.get(2)), b"p0_2")
}

test "failures whose releases end alike share that end, each release printed once" {
  let a = text_local(0);
  let b = text_local(1);
  let c = text_local(2);
  let rel = |n: Bytes|
    Bytes::concat_all([b"ply_rel(ctx, ", n, b", ", drop_spelled(string()), b");"]);
  let declared = |pr: Printing, v: Var| named(pr, v).pr;
  let pr = declared(declared(printing(Map::new().insert(0, b"p0")), b), c);
  let first = exit_of(pr, [a, b], b"return 0;");
  let second = exit_of(first.pr, [b, c, a], b"return 0;");
  let third = exit_of(second.pr, [a, c], b"return 0;");
  // The same holding takes the same path.
  assert_eq(exit_of(third.pr, [b, a], b"return 0;").leave, first.leave);
  assert_eq([first.leave, second.leave, third.leave], [
    b"goto ply_u1;",
    b"goto ply_u2;",
    b"goto ply_u3;",
  ]);
  let closed = block_closed(third.pr, 0, 0, false);
  let tails = spelled(closed.out);
  assert_eq(
    tails,
    Bytes::concat_all([
      b"  ply_u3: ",
      rel(b"t2"),
      b" goto ply_u0;\n  ply_u2: ",
      rel(b"t2"),
      b"\n  ply_u1: ",
      rel(b"t1"),
      b"\n  ply_u0: ",
      rel(b"p0"),
      b" return 0;\n",
    ]),
  );
  assert_eq(occurrences(tails, rel(b"p0")), 1);
  assert_eq(occurrences(tails, rel(b"t1")), 1);
  // The tails' drop root is noted once among the root's calls.
  assert_eq(closed.calls, [drop_of(string())])
}

test "a tail stands at the end of the block its value was declared in, out of the way where the block goes on" {
  let a = text_local(0);
  let b = text_local(1);
  let d = drop_spelled(string());
  let pr = printing(Map::new().insert(0, b"p0"));
  let inner = named(block_opened(pr), b);
  let x = exit_of(inner.pr, [a, b], b"goto ply_h0;");
  assert_eq(x.leave, b"goto ply_u1;");
  let closed = block_closed(x.pr, pr.block, 1, true);
  assert_eq(
    spelled(closed.out),
    Bytes::concat_all([
      b"    if (0) {\n      ply_u1: ply_rel(ctx, t1, ",
      d,
      b"); goto ply_u0;\n    }\n",
    ]),
  );
  assert_eq(closed.block, pr.block);
  // The parameter's release waits for the function's own block, which the inner one's jumps to.
  assert_eq(
    spelled(block_closed({ ..closed, out: [] }, 0, 0, false).out),
    Bytes::concat_all([b"  ply_u0: ply_rel(ctx, p0, ", d, b"); goto ply_h0;\n"]),
  );
  // A block no failure path released anything of ends as it was.
  let quiet = block_opened(pr);
  assert_eq(block_closed(quiet, 0, 1, true).out, [])
}

fn dropping_of(name: Bytes) -> RootKey = drop_of(TyCon({ name: name, args: [] }))

fn root_spelled(k: RootKey) -> Bytes / {abort.raise} = spelled([Hole(Symbol(Root(k)))])

/// What letting go of `parts` laid in `ws` prints, the roots it notes, and how many heads it notes.
fn let_go_said(
  parts: List<Part>,
  ws: List<Bytes>,
) -> { text: Bytes, calls: List<RootKey>, expects: Int } / {abort.raise} = {
  let s = let_go_of(printing(Map::new()), parts, ws);
  { text: spelled(s.out), calls: s.pr.calls, expects: s.pr.expects.len() }
}

fn word(at: Int, how: Counted) -> Part = WordAt({ at: at, masked: false, how: how })

/// A sum of a tag word and a word its cases lay apart: an `Int`, a pointer, nothing.
fn tagged_laid() -> SumLaid =
  {
    classes: [R({ lo: 0, hi: 2 }), U],
    cases: [
      {
        test: WordIs({ at: 0, value: 0 }),
        payload: Inline({ offset: 1, laid: LWords([R({ lo: 0, hi: 1 })]), stripped: None }),
      },
      {
        test: WordIs({ at: 0, value: 1 }),
        payload: Inline({ offset: 1, laid: LWords([P]), stripped: None }),
      },
      { test: WordIs({ at: 0, value: 2 }), payload: Nullary },
    ],
  }

test "a counted word is let go of at its type's drop root, a hole the root's calls note once" {
  let k = dropping_of(b"String");
  let d = root_spelled(k);
  let one = let_go_said([word(0, Object(k))], [b"t1"]);
  assert_eq(one.text, Bytes::concat_all([b"ply_rel(ctx, t1, ", d, b");"]));
  assert_eq(one.calls, [k]);
  assert_eq(one.expects, 1);
  let twice = let_go_said([word(0, Object(k)), WordAt({ at: 1, masked: true, how: Object(k) })], [
    b"a",
    b"b",
  ]);
  assert_eq(
    twice.text,
    Bytes::concat_all([b"ply_rel(ctx, a, ", d, b"); ply_rel(ctx, (b & ~(Word)7), ", d, b");"]),
  );
  assert_eq([twice.calls.len(), twice.expects], [1, 1]);
  assert_eq(
    let_go_said([word(0, SumWord(k))], [b"w"]).text,
    Bytes::concat_all([b"ply_rel_sum(ctx, w, ", d, b");"]),
  );
  assert_eq(
    let_go_said([word(0, IntWord(k))], [b"w"]).text,
    Bytes::concat_all([b"ply_rel_int(ctx, w, ", d, b");"]),
  );
  // A function value goes through its descriptor and a handle to the runtime, naming no root.
  let through = let_go_said([word(0, Through)], [b"w"]);
  assert_eq(
    through.text,
    b"if (w && ply_last(ctx, w)) ((const PlyFnDesc *)(intptr_t)ply_words(w)[0])->release(ctx, w);",
  );
  assert_eq(through.calls, []);
  assert_eq(
    let_go_said([word(0, RuntimeHandle)], [b"w"]).text,
    b"if (w && ply_last(ctx, w)) rt_handle_free_p(ctx, w);",
  );
  // A value spelled 0, a word another now holds, is neither let go of nor counted again.
  let gone = let_go_said([word(0, Object(k)), word(1, SumWord(k))], [b"0", b"0"]);
  assert_eq([gone.text, dup_of([word(0, Object(k)), word(1, Object(k))], [b"0", b"b"])], [
    b"",
    b"ply_dup(b);",
  ]);
  assert_eq(gone.calls, [])
}

test "a sum of several words is let go of by the case it holds, switching on its place" {
  let k = dropping_of(b"String");
  let parts = [
    ByCase({ at: 0, sum: tagged_laid(), cases: [{ case: 1, parts: [word(1, Object(k))] }] }),
  ];
  let held = case_held(tagged_laid(), [b"t1_0", b"t1_1"]);
  assert_eq(
    let_go_said(parts, [b"t1_0", b"t1_1", b"t1_2"]).text,
    Bytes::concat_all([
      b"switch (",
      held,
      b") { case 1: ply_rel(ctx, t1_1, ",
      root_spelled(k),
      b"); break; }",
    ]),
  );
  assert_eq(
    dup_of(parts, [b"t1_0", b"t1_1", b"t1_2"]),
    Bytes::concat_all([b"switch (", held, b") { case 1: ply_dup(t1_1); break; }"]),
  )
}

test "counting once more tests a sum's word past the floor and an Int's for its box" {
  let k = dropping_of(b"T");
  assert_eq(
    dup_of([word(0, SumWord(k))], [b"w"]),
    b"if ((uint64_t)w >= 4096) ply_dup(w & ~(Word)7);",
  );
  assert_eq(dup_of([word(0, IntWord(k))], [b"w"]), b"if (!(w & 7)) ply_dup(w);");
  assert_eq(
    dup_of([word(0, Object(k)), word(1, Through)], [b"a", b"b"]),
    b"ply_dup(a); ply_dup(b);",
  )
}

test "a box opened reads its counted words, a wide sum's every word, and gives the box back" {
  let s = RSum({ laid: tagged_laid(), cases: [b"m.N", b"m.S", b"m.E"] });
  let o = local(0, RWord);
  let a = local(1, RWord);
  let b = local(2, s);
  let ty = TyCon({ name: b"T", args: [] });
  let opened = opened_block(
    printing(Map::new().insert(0, b"p0")),
    0,
    o,
    [a, b],
    InBox({ parts: [{ at: 0, ty: ty, rep: RWord }, { at: 2, ty: ty, rep: s }], words: 4 }),
  );
  assert_eq(
    spelled(opened.out),
    b"  Word t1 = ply_words(p0)[0];\n  Word t2_0 = ply_words(p0)[2]; Word t2_1 = ply_words(p0)[3];\n  ply_free(ctx, p0, 48);\n",
  );
  assert_eq(name_of(opened, b), b"t2");
  assert_eq(part_names(b"t2", s), [b"t2_0", b"t2_1"]);
  // Inside a flat record a sum's words are its own.
  let flat = RFlat([{ name: b"a", rep: s }, { name: b"n", rep: RInt }]);
  let names = part_names(b"t3", flat);
  assert_eq(names, [b"t3_0", b"t3_1", b"t3_2"]);
  assert_eq(per_part(flat, names), [[b"t3_0", b"t3_1"], [b"t3_2"]]);
  assert_eq(per_part(s, part_names(b"t2", s)), [[b"t2_0", b"t2_1"]])
}

test "a list opened lets go of its tail's items and its trie, and gives itself back by its room" {
  let item = dropping_of(b"String");
  let node = drop_of(TyCon({ name: list_node_name(), args: [string()] }));
  let opened = opened_block(
    printing(Map::new().insert(0, b"p0")),
    0,
    local(0, RWord),
    [],
    ListOf({ node: node, item: [word(0, Object(item))] }),
  );
  assert_eq(
    spelled(opened.out),
    Bytes::concat_all([
      b"  { for (int64_t ply_i = 0; ply_i < ply_obj(p0)->flags; ply_i++) { Word ply_w = ply_words(p0)[1 + ply_i]; ply_rel(ctx, ply_w, ",
      root_spelled(item),
      b"); } ply_rel(ctx, ply_words(p0)[0], ",
      root_spelled(node),
      b"); ply_free(ctx, p0, 16 + 8 * (1 + (int64_t)ply_obj(p0)->aux)); }\n",
    ]),
  );
  assert_eq(opened.calls, [item, node])
}

test "a reset keeps a box held only here as its token, its words let go of, and else lets one count go" {
  let item = dropping_of(b"String");
  let boxed = dropping_of(b"m.R");
  let pr = printing(Map::new().insert(0, b"p0"));
  let reset = reset_boxed(
    pr,
    0,
    local(1, RToken(2)),
    local(0, RWord),
    InBox({ parts: [{ at: 0, ty: TyCon({ name: b"String", args: [] }), rep: RWord }], words: 2 }),
    boxed,
  );
  assert_eq(
    spelled(reset.out),
    Bytes::concat_all([
      b"  Word t1 = 0; if (p0 && ply_obj(p0)->rc == 1) { ply_rel(ctx, ply_words(p0)[0], ",
      root_spelled(item),
      b"); t1 = p0; } else ply_rel(ctx, p0, ",
      root_spelled(boxed),
      b");\n",
    ]),
  );
  let token = local(1, RToken(2));
  let freed = count_printed(place(), { ..reset, out: [] }, Free({ of: token, bytes: AInt(32) }));
  assert_eq(spelled(freed.out), b"  if (t1) ply_free(ctx, t1, INT64_C(32));\n");
  assert_eq(
    spelled(released(reset, token.ty, token.rep, [b"t1"]).out),
    b"if (t1) ply_free(ctx, t1, 32);",
  )
}

test "a value's counts read its type's own layout and word form" {
  let string = TyCon({ name: b"String", args: [] });
  let pair = TyRecord([{ name: b"a", ty: string }, { name: b"b", ty: string }]);
  let pr = printing(Map::new());
  let let_go = released(pr, string, RWord, [b"t1"]);
  assert_eq(
    spelled(let_go.out),
    Bytes::concat_all([b"ply_rel(ctx, t1, ", root_spelled(dropping_of(b"String")), b");"]),
  );
  // A record's word form is its box; an `Int`'s an immediate or the runtime's box.
  assert_eq(duped(pr, pair, RWord, [b"t2"]), b"ply_dup(t2);");
  assert_eq(
    duped(pr, TyCon({ name: b"Int", args: [] }), RWord, [b"t3"]),
    b"if (!(t3 & 7)) ply_dup(t3);",
  );
  assert_eq(part_names(b"t4", RWord), [b"t4"])
}

test "a last holder's test takes the count and answers the value only where it was the last" {
  let one_word = RSum({
    laid: { classes: [S(1)], cases: [{ test: WordIs({ at: 0, value: 0 }), payload: Nullary }] },
    cases: [b"m.Nil"],
  });
  let pr = printing(Map::new().insert(0, b"p0"));
  let at = |r: Rep| spelled(last_of(place(), pr, Some(local(1, RWord)), local(0, r)).out);
  assert_eq(at(RWord), b"  Word t1 = (p0 && ply_last(ctx, p0)) ? p0 : 0;\n");
  assert_eq(
    at(one_word),
    b"  Word t1 = ((uint64_t)p0 >= 4096 && ply_last(ctx, p0 & ~(Word)7)) ? p0 : 0;\n",
  );
  // Renamed as the block its case holds, a sum's word drops its tag.
  assert_eq(
    spelled(opened_sum(pr, 0, local(0, one_word), [local(1, RWord)]).out),
    b"  Word t1 = (p0 & ~(Word)7);\n",
  )
}

/// What walking a block named `p0` laid as `o` by `op` into `t1` prints, and the roots it notes.
fn walked_said(
  op: TypeOp,
  o: Opening,
  dropped: RootKey,
) -> { text: Bytes, calls: List<RootKey> } / {abort.raise} = {
  let pr = printing(Map::new().insert(0, b"p0"));
  let w = walked(pr, 0, local(1, RWord), local(0, RWord), op, o, dropped);
  { text: spelled(w.out), calls: w.calls }
}

test "a node copied is a fresh block of its header and words, each counted once more, the original let go" {
  let item = dropping_of(b"String");
  let node = drop_of(TyCon({ name: list_node_name(), args: [string()] }));
  let copy = walked_said(Copy, NodeOf({ node: node, item: [word(0, Object(item))] }), node);
  [
    b"Word t1 = rt_alloc_bytes_p(ctx, 16 + 8 * (int64_t)ply_obj(p0)->layout);",
    b"ply_obj(t1)->kind = ply_obj(p0)->kind;",
    b"ply_words(t1)[ply_i] = ply_words(p0)[ply_i];",
    b"if (ply_obj(t1)->kind == 12) { for (int64_t ply_i = 0; ply_i < ply_obj(t1)->len; ply_i++) { ply_dup(ply_words(t1)[ply_i]); } }",
    Bytes::concat_all([b"ply_rel(ctx, p0, ", root_spelled(node), b");\n"]),
  ].fold((), |_: Unit, part: Bytes| assert(copy.text.contains(part), None));
  assert_eq(copy.calls, [node])
}

test "a sum of one word walks the block its case holds, a chain of its own type in a loop" {
  let string = TyCon({ name: b"String", args: [] });
  let own = TyCon({ name: b"T", args: [] });
  let tagged = RSum({
    laid: {
      classes: [S(1)],
      cases: [
        { test: WordIs({ at: 0, value: 0 }), payload: Nullary },
        { test: LowBits({ at: 0, bits: 1, block_tag: None }), payload: Nullary },
        { test: LowBits({ at: 0, bits: 2, block_tag: None }), payload: Nullary },
      ],
    },
    cases: [b"m.N", b"m.B", b"m.S"],
  });
  let blocks = [
    {
      case: 1,
      ty: TyCon({ name: b"m.T", args: [] }),
      rep: RSum({ laid: { classes: [P], cases: [] }, cases: [b"m.B"] }),
      // Case 1's box holds a string, then the rest of the chain: a sum of the walked one's type.
      opening: InBox({
        parts: [{ at: 0, ty: string, rep: RWord }, { at: 1, ty: own, rep: tagged }],
        words: 2,
      }),
    },
    { case: 2, ty: string, rep: RWord, opening: StrBlock({ viewed: dropping_of(b"String") }) },
  ];
  let pr = printing(Map::new().insert(0, b"p0"));
  let walk = |op: TypeOp|
    spelled(walked_sum(pr, 0, local(1, RWord), local(0, tagged), op, blocks).out);
  let kept = walk(Keep);
  [
    b"Word t1 = p0; Word *ply_into = &t1; Word ply_x = p0; for (;;) { Word ply_n = 0; switch (",
    b"case 1: { Word ply_b = (ply_x & ~(Word)7); if (ply_obj(ply_b)->rc != UINT32_MAX) { Word ply_k = rt_alloc_kept_p(ctx, 32);",
    b" *ply_into = ply_k | (ply_x & 7); ply_into = &ply_words(ply_k)[1]; ply_n = *ply_into; }",
    Bytes::concat_all([
      b"case 2: { Word ply_b = (ply_x & ~(Word)7); *ply_into = ",
      root_spelled(root_of(Keep, string)),
      b"(ctx, ply_b) | (ply_x & 7); } break; ",
    ]),
    b"} if (!ply_n) break; ply_x = ply_n; }",
  ].fold((), |_: Unit, part: Bytes| assert(kept.contains(part), None));
  let shared = walk(Share);
  [
    b"Word t1 = 1; Word ply_x = p0; for (;;) { Word ply_n = 0; switch (",
    b"if (ply_obj(ply_b)->rc < UINT32_C(0x80000000)) { ply_obj(ply_b)->rc |= UINT32_C(0x80000000);",
    b" ply_n = ply_words(ply_b)[1]; }",
    Bytes::concat_all([b"if (!", root_spelled(root_of(Share, string)), b"(ctx, ply_b)) t1 = 0;"]),
  ].fold((), |_: Unit, part: Bytes| assert(shared.contains(part), None));
  // However long the chain, no walk calls its own root: the loop goes on to the rest.
  assert(!kept.contains(root_spelled(root_of(Keep, own))), None);
  assert(!shared.contains(root_spelled(root_of(Share, own))), None)
}

test "a box shared marks it and shares each block it holds; kept, it is copied for good, each word kept" {
  let string = TyCon({ name: b"String", args: [] });
  let boxed = InBox({ parts: [{ at: 0, ty: string, rep: RWord }], words: 2 });
  let share = Written({ op: Share, ty: string, home: b"std.prelude", marks: [] });
  let keep = Written({ op: Keep, ty: string, home: b"std.prelude", marks: [] });
  let shared = walked_said(Share, boxed, dropping_of(b"m.R"));
  assert_eq(
    shared.text,
    Bytes::concat_all([
      b"  Word t1 = 1; if (p0 && ply_obj(p0)->rc < UINT32_C(0x80000000)) { ply_obj(p0)->rc |= UINT32_C(0x80000000); if (ply_words(p0)[0] && !",
      root_spelled(share),
      b"(ctx, ply_words(p0)[0])) t1 = 0; }\n",
    ]),
  );
  assert_eq(shared.calls, [share]);
  let kept = walked_said(Keep, boxed, dropping_of(b"m.R"));
  [
    b"Word t1 = p0; if (p0 && ply_obj(p0)->rc != UINT32_MAX) { t1 = rt_alloc_kept_p(ctx, 32);",
    Bytes::concat_all([
      b"if (ply_words(t1)[0]) ply_words(t1)[0] = ",
      root_spelled(keep),
      b"(ctx, ply_words(t1)[0]);",
    ]),
  ].fold((), |_: Unit, part: Bytes| assert(kept.text.contains(part), None));
  // A function value is shared through its descriptor, a handle not at all.
  assert(walked_said(Share, FnBlock, dropping_of(b"m.R")).text.contains(b"->share(ctx, p0)"), None);
  assert(
    walked_said(Share, HandleBlock, dropping_of(b"m.R")).text.contains(b"if (p0) t1 = 0;"),
    None,
  )
}
