/// A list made of `m.args`, items it lays as their type lays them: taken into a block of its own,
/// or borrowed by one laid in the frame.
pub fn contained(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  m: { made: Made, args: List<Arg>, reuse: Option<Var> },
) -> Printing / {abort.raise} =
  match laid_made(m.made) {
    MList(_) -> match into {
      Some(v) -> {
        let n = named(pr, v);
        let items = m.args.map(|a: Arg| words_laid(arg_parts(pr, a), values_of(rep_of_arg(a))));
        // An empty list's room is its type's items too; one of no known layout holds none ever.
        let stride = match laid_by_pointer(pr.ctors, held_type(v.ty)) {
          Some(l) -> max(1, words(l)),
          None -> if m.args.len() == 0 { 1 } else { item_element(pr, held_type(v.ty)).stride },
        };
        if laid_made(m.made) == m.made { list_made(n.pr, p.depth, n.name, items, stride) }
        else { framed_list_made(n.pr, p.depth, n.name, items, stride) }
      },
      None -> unprinted(b"a list made that nothing holds", made_said(m.made)),
    },
    other -> unprinted(b"a value made other than a list", made_said(other)),
  }

/// `v`, the record held as the word `object`, with a count of its own: a record in place, whose
/// header holds the count no code takes, copied into a box of its own, its words copied from past
/// its header and each counted word counted once more; a box counted once more.
fn retained_printed(p: Place, pr: Printing, v: Var, object: Bytes) -> Printing / {abort.raise} =
  match laid_known(pr.ctors, v.ty) {
    Some(l) -> {
      let m = words(l);
      let n = named(pr, v);
      let counted = laid_counted(n.pr, l, Bytes::concat_all([b"ply_words(", n.name, b")"]));
      line(
        counted.pr,
        p.depth,
        Bytes::concat_all([
          b"Word ",
          n.name,
          b"; if (ply_obj(",
          object,
          b")->rc == PLY_RC_FRAME) { ",
          n.name,
          b" = rt_alloc_bytes_p(ctx, ",
          int_lit(header_bytes() + 8 * m),
          b"); memcpy(ply_words(",
          n.name,
          b"), ply_words(",
          object,
          b"), ",
          int_lit(8 * m),
          b"); ",
          counted.text,
          b" } else { ",
          call_text(dup_fn(), [object]),
          b"; ",
          n.name,
          b" = ",
          object,
          b"; }",
        ]),
      )
    },
    None -> unprinted(b"a record kept at no layout", var_said(v)),
  }

/// Operation `op` on a container's cells over `args`.
pub fn container_op(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  op: ContainerOp,
  args: List<Arg>,
  uses: Uses,
) -> Printing / {abort.raise} = {
  let object = operand(pr, args, 0);
  let index = operand(pr, args, 1);
  match into {
    None ->
      unprinted(
        b"a container's operation whose answer goes unread",
        Bytes::concat_all([ascii_of_int(args.len()), b" operands"]),
      ),
    Some(v) -> match op {
      Length ->
        assigned(
          site(p, pr),
          p.depth,
          v,
          c_type(v.rep),
          Bytes::concat_all([b"(int64_t)", head_field(length_head(), object, b"len")]),
        ),
      Elements -> assigned(site(p, pr), p.depth, v, c_type(v.rep), array_len(object)),
      Within ->
        assigned(
          pr,
          p.depth,
          v,
          c_type(v.rep),
          Bytes::concat_all([b"(uint64_t)", index, b" < (uint64_t)", array_len(object)]),
        ),
      Laid(i) -> laid_printed(p, pr, v, i, args),
      Retained -> retained_printed(p, pr, v, object),
      ArrayNew(e) -> array_new(p, pr, v, e, args),
      ArraySet(e) -> array_set(p, pr, v, e, args),
      ArrayOfList(e) -> array_of_list(p, pr, v, e, args),
      ArrayGet(e) -> array_get(p, pr, v, e, args),
      ColumnsNew(es) -> columns_new(p, pr, v, es, args),
      ColumnsSet(es) -> columns_set(p, pr, v, es, args),
      ColumnsOfList(es) -> columns_of_list(p, pr, v, es, args),
      ColumnsGet(es) -> columns_get(p, pr, v, es, args),
      ColumnField(c) -> column_printed(p, pr, v, c.k, c.column, args),
      ColumnOf(k) -> assigned(pr, p.depth, v, c_type(v.rep), slot_of(object, ascii_of_int(k))),
      ItemAt -> {
        let e = item_element(pr, v.ty);
        let w = temp(pr);
        parts_declared(
          p,
          item_read(w.pr, p.depth, w.name, object, index, e.stride),
          v,
          values_read(|j: Int| slot_at(w.name, j), values_of(v.rep)),
        )
      },
      LeafOf -> {
        let n = named(pr, v);
        leaf_read(
          line(n.pr, p.depth, Bytes::concat_all([c_type(v.rep), b" ", n.name, b";"])),
          p.depth,
          n.name,
          object,
          index,
        )
      },
      Room ->
        assigned(
          pr,
          p.depth,
          v,
          c_type(v.rep),
          room_made(object, item_element(pr, held_type(v.ty)).stride),
        ),
      Rest -> {
        let n = named(pr, v);
        rest_made(
          line(n.pr, p.depth, Bytes::concat_all([b"Word ", n.name, b";"])),
          p.depth,
          n.name,
          object,
          index,
          v.ty,
        )
      },
      Position -> position_printed(p, pr, v, args),
      Taken -> match args.at(0) {
        Some(n) -> taken_printed(p, pr, v, n),
        None -> unprinted(b"bytes taken out of the crossing buffer, none counted", var_said(v)),
      },
    },
  }
}

/// How an item of type `ty` lies in a list's node: as a container lays it (`reps.laid_by_pointer`), a
/// word apart at least.
pub fn item_element(pr: Printing, ty: Type) -> Element / {abort.raise} =
  match laid_by_pointer(pr.ctors, ty) {
    Some(l) -> { laid: l, stride: max(1, words(l)) },
    None -> unprinted(b"an item of a layout a type variable leaves open", spelled_type(ty)),
  }

/// Word `j` of the item at place `k`, a C expression, among those lying `e.stride` words apart from
/// word `from` of the block `obj`.
pub fn item_slot(obj: Bytes, from: Int, k: Bytes, e: Element, j: Int) -> Bytes =
  strided_slot(obj, from, k, e.stride, j)

/// Word `j` past word `from` of the `k`-th run of `stride` words of the block `obj`.
fn strided_slot(obj: Bytes, from: Int, k: Bytes, stride: Int, j: Int) -> Bytes =
  slot_of(obj, run(from + j, k, stride))

/// The word the `k`-th run of `stride` words from word `from` starts at, as C.
fn run(from: Int, k: Bytes, stride: Int) -> Bytes =
  if stride == 1 { past(from, k) }
  else { Bytes::concat_all([ascii_of_int(from), b" + (", k, b") * ", ascii_of_int(stride)]) }

/// How a map's node lays the keys and values of the map node type `node`: a leaf's pairs `pair`
/// words apart, each the key's words and then the value's; a branch's greatest keys as `branch`
/// says.
type PairLaid = { key: Element, value: Element, pair: Int, branch: BranchLaid }

fn pair_laid(pr: Printing, node: Type) -> PairLaid / {abort.raise} = {
  let k = item_element(pr, type_arg(node, 0));
  let v = item_element(pr, type_arg(node, 1));
  { key: k, value: v, pair: k.stride + v.stride, branch: branch_laid(k.stride) }
}

/// The C values, held as `r`, of the `k`-th run of `stride` words of `obj` from its word `from`.
fn strided_values(obj: Bytes, from: Int, k: Bytes, stride: Int, r: Rep) -> List<Bytes> =
  values_read(|j: Int| strided_slot(obj, from, k, stride, j), values_of(r))

/// The C setting the `e.stride` words from word `from` of the `k`-th run of `stride` words of `obj`
/// to `x`, as its type lays it: each word `x` leaves out zero.
fn strided_set(
  pr: Printing,
  obj: Bytes,
  from: Int,
  k: Bytes,
  stride: Int,
  e: Element,
  x: Arg,
) -> Bytes = {
  let ws = words_laid(arg_parts(pr, x), values_of(rep_of_arg(x)));
  Bytes::join(
    range(0, e.stride).map(|j: Int|
      Bytes::concat_all([
        strided_slot(obj, from, k, stride, j),
        b" = ",
        match ws.at(j) { Some(w) -> w, None -> b"0" },
        b";",
      ])),
    b" ",
  )
}

/// Each word of the item at place `k` among those from word `from` of `obj`, `item_slot`'s.
pub fn item_slots(obj: Bytes, from: Int, k: Bytes, e: Element) -> List<Bytes> =
  range(0, e.stride).map(|j: Int| item_slot(obj, from, k, e, j))

/// The C values of the item at place `k` among those from word `from` of `obj`, held as `r`.
fn item_values(obj: Bytes, from: Int, k: Bytes, e: Element, r: Rep) -> List<Bytes> =
  values_read(|j: Int| item_slot(obj, from, k, e, j), values_of(r))

/// The C setting the item at place `k` among those from word `from` of `obj` to `x`, as its type lays
/// it: each word of the stride `x` leaves out zero.
fn item_set(pr: Printing, obj: Bytes, from: Int, k: Bytes, e: Element, x: Arg) -> Bytes =
  strided_set(pr, obj, from, k, e.stride, e, x)

/// `n` items' words, `e.stride` to an item, as C counting them.
fn item_words(n: Bytes, e: Element) -> Bytes =
  if e.stride == 1 { n } else { Bytes::concat_all([n, b" * ", ascii_of_int(e.stride)]) }

/// Extern `op` written over the objects `layouts` lays out, answering into `v`. A read answers
/// what the object holds without a count of its own, an item as `v` holds it; a write takes the
/// object into `v`, made writable where another holds it too, and answers it.
fn laid_printed(
  p: Place,
  pr: Printing,
  v: Var,
  op: Intrinsic,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let laid = layouts();
  let o = operand(pr, args, 0);
  let i = operand(pr, args, 1);
  let raw = |e: Bytes| assigned(pr, p.depth, v, c_type(v.rep), e);
  // An item is a word in the object, read as the scalar it is where `v` holds one.
  let read = |slot: Bytes| raw(word_as(slot, v.rep));
  let lh = |w: Bytes, f: Bytes| head_field(list_head(), w, f);
  let nh = |w: Bytes, f: Bytes| head_field(node_head(), w, f);
  let int_of = |field: Bytes| raw(Bytes::concat_all([b"(int64_t)", field]));
  // What a node holds lies past its head: its kids, items or pairs from word `first`.
  let first = laid.trie.first;
  let made = |kind: Int, words: Int|
    assigned(pr, p.depth, v, c_type(v.rep), node_words_made(kind, words));
  let held = assigned(pr, p.depth, v, c_type(v.rep), o);
  let a = name_of(held, v);
  let at = |k: Bytes| slot_of(a, k);
  let written = |text: Bytes| line(held, p.depth, text);
  // `a` held once before a write, the write counted where `copied` says how many words a copy took.
  let owned = |copied: Option<Bytes>| writable(held, p.depth, a, operand_type(args, 0), copied);
  let shifted = |from: Bytes, n: Bytes, by: Bytes|
    Bytes::concat_all([
      b"memmove(&",
      at(Bytes::concat_all([from, b" + ", by])),
      b", &",
      at(from),
      b", (size_t)(",
      n,
      b") * sizeof(Word)); ",
    ]);
  // A map's index is parenthesised where it is written into a larger index.
  let index = Bytes::concat_all([b"(", i, b")"]);
  let after = |less: Bytes| Bytes::concat_all([b"(int64_t)", nh(a, b"len"), b" - ", index, less]);
  let node = operand_type(args, 0);
  // The value of type `ty` laid as `e` from word `from` of the `k`-th run of `stride` words of `a`
  // written over by `x`, what it held let go of as its type lays it.
  let replaced = |q: Printing, from: Int, k: Bytes, stride: Int, e: Element, ty: Type, x: Arg| {
    let olds = range(0, e.stride).fold(
      { pr: q, names: [] },
      |acc: { pr: Printing, names: List<Bytes> }, j: Int| {
        let t = temp(acc.pr);
        { pr: t.pr, names: acc.names.push(t.name) }
      },
    );
    let set = line(
      olds.pr,
      p.depth,
      Bytes::concat_all(
        range(0, e.stride).map(|j: Int|
          Bytes::concat_all([
            b"Word ",
            nth(olds.names, j),
            b" = ",
            strided_slot(a, from, k, stride, j),
            b"; ",
          ])),
      ).concat(
        strided_set(pr, a, from, k, stride, e, x),
      ),
    );
    said_line(let_go_of(set, laid_parts(pr.ctors, ty, e.laid, 0), olds.names), p.depth)
  };
  // A list's item is laid at its place as its type lays it, `e.stride` words to an item.
  let item = || item_element(pr, held_type(node));
  let item_replaced = |q: Printing, from: Int, k: Bytes, x: Arg| {
    let e = item();
    replaced(q, from, k, e.stride, e, held_type(node), x)
  };
  // A map node's pairs and greatest keys, laid as its key and value types lay them.
  let pl = || pair_laid(pr, if args.len() == 0 { v.ty } else { node });
  // How many words a copy of a leaf's pairs takes.
  let pairs = || Some(Bytes::concat_all([ascii_of_int(pl().pair), b" * (int64_t)", nh(a, b"len")]));
  match op {
    OfList(ListStart) -> int_of(lh(o, b"start")),
    OfList(TailLen) -> int_of(lh(o, b"tail_len")),
    OfList(NodeLen) -> int_of(nh(o, b"len")),
    // The slot holds the root as an `Option`'s payload's word, the node or zero.
    OfList(ListRoot) -> raw(slot_of(o, ascii_of_int(laid.list.root))),
    OfList(TailAt) ->
      parts_declared(p, pr, v, item_values(o, laid.list.tail, i, item_element(pr, v.ty), v.rep)),
    OfList(LeafAt) ->
      parts_declared(p, pr, v, item_values(o, first, i, item_element(pr, v.ty), v.rep)),
    OfList(KidAt) -> read(slot_of(o, past(first, i))),
    OfList(NewBranch) -> assigned(pr, p.depth, v, c_type(v.rep), node_made(laid.trie.branch, 1)),
    OfList(TailPush) -> {
      let e = item();
      let g = temp(held);
      let opened = line(
        g.pr,
        p.depth,
        Bytes::concat_all([
          b"{ int in_place = ply_obj(",
          a,
          b")->rc == 1; int64_t n = (int64_t)",
          lh(a, b"tail_len"),
          b";",
        ]),
      );
      let copy = copied(opened, p.depth + 1, a, operand_type(args, 0));
      // A full tail moves into a block of twice the room, `first_room` at least, the list held once
      // by then.
      let moved = Bytes::concat_all([
        b"if (n == (int64_t)",
        lh(a, b"room"),
        b") { Word ",
        g.name,
        b" = ",
        room_made(
          Bytes::concat_all([
            b"(2 * n > ",
            ascii_of_int(first_room()),
            b" ? 2 * n : ",
            ascii_of_int(first_room()),
            b")",
          ]),
          e.stride,
        ),
        b"; ",
        slot_of(g.name, ascii_of_int(laid.list.root)),
        b" = ",
        slot_of(a, ascii_of_int(laid.list.root)),
        b"; ",
        Bytes::concat_all(
          [b"start", b"len", b"tail_len"].map(|f: Bytes|
            Bytes::concat_all([lh(g.name, f), b" = ", lh(a, f), b"; "])),
        ),
        b"memcpy(&",
        slot_of(g.name, ascii_of_int(laid.list.tail)),
        b", &",
        slot_of(a, ascii_of_int(laid.list.tail)),
        b", (size_t)",
        item_words(b"n", e),
        b" * sizeof(Word)); ",
        call_text(free_fn(), [
          b"ctx",
          a,
          ascii_of_int(header_bytes() + 8 * laid.list.tail).concat(b" + 8 * ").concat(
            item_words(b"n", e),
          ),
        ]),
        b"; ",
        a,
        b" = ",
        g.name,
        b"; }",
      ]);
      let grown = line(
        line(copy, p.depth + 1, moved),
        p.depth + 1,
        b"rt_note_update_p(ctx, in_place, in_place ? 0 : n); }",
      );
      line(
        grown,
        p.depth,
        Bytes::concat_all([
          item_set(pr, a, laid.list.tail, lh(a, b"tail_len"), e, operand_arg(args, 1)),
          b" ",
          lh(a, b"tail_len"),
          b" += 1; ",
          lh(a, b"len"),
          b" += 1;",
        ]),
      )
    },
    OfList(TailStart) ->
      written(
        Bytes::concat_all([
          item_set(pr, a, laid.list.tail, b"0", item(), operand_arg(args, 1)),
          b" ",
          lh(a, b"tail_len"),
          b" = 1; ",
          lh(a, b"len"),
          b" += 1;",
        ]),
      ),
    OfList(TailSet) ->
      item_replaced(owned(Some(lh(a, b"tail_len"))), laid.list.tail, i, operand_arg(args, 2)),
    OfList(LeafSet) -> item_replaced(owned(Some(nh(a, b"len"))), first, i, operand_arg(args, 2)),
    OfMap(MapRoot) -> raw(slot_of(o, ascii_of_int(laid.map.root))),
    OfMap(MapHeight) -> int_of(head_field(map_head(), o, b"height")),
    OfMap(NodeCount) -> int_of(nh(o, b"len")),
    OfMap(NodeKey) -> parts_declared(p, pr, v, strided_values(o, first, i, pl().pair, v.rep)),
    OfMap(NodeValue) -> {
      let l = pl();
      parts_declared(p, pr, v, strided_values(o, first + l.key.stride, i, l.pair, v.rep))
    },
    OfMap(NodeKid) -> read(slot_of(o, past(first, i))),
    OfMap(KidMax) -> {
      let l = pl();
      parts_declared(p, pr, v, strided_values(o, l.branch.keys, i, l.key.stride, v.rep))
    },
    OfMap(KidSize) ->
      raw(Bytes::concat_all([b"ply_imm_value(", slot_of(o, past(pl().branch.sizes, i)), b")"])),
    OfMap(NewLeaf) -> made(laid.tree.leaf, laid.tree.width * pl().pair),
    OfMap(NewMapBranch) -> made(laid.tree.branch, pl().branch.words),
    OfMap(PairPut) -> {
      let l = pl();
      let ps = ascii_of_int(l.pair);
      line(
        owned(pairs()),
        p.depth,
        Bytes::concat_all([
          shifted(
            past(first, Bytes::concat_all([index, b" * ", ps])),
            Bytes::concat_all([b"(", after(b""), b") * ", ps]),
            ps,
          ),
          strided_set(pr, a, first, i, l.pair, l.key, operand_arg(args, 2)),
          b" ",
          strided_set(pr, a, first + l.key.stride, i, l.pair, l.value, operand_arg(args, 3)),
          b" ",
          nh(a, b"len"),
          b" += 1;",
        ]),
      )
    },
    OfMap(PairSet) -> {
      let l = pl();
      let keyed = replaced(
        owned(pairs()),
        first,
        i,
        l.pair,
        l.key,
        type_arg(node, 0),
        operand_arg(args, 2),
      );
      replaced(
        keyed,
        first + l.key.stride,
        i,
        l.pair,
        l.value,
        type_arg(node, 1),
        operand_arg(args, 3),
      )
    },
    OfMap(KidBack) -> {
      let l = pl();
      let maxed = replaced(
        owned(None),
        l.branch.keys,
        i,
        l.key.stride,
        l.key,
        type_arg(node, 0),
        operand_arg(args, 3),
      );
      line(
        maxed,
        p.depth,
        Bytes::concat_all([
          at(past(first, i)),
          b" = ",
          operand(pr, args, 2),
          b"; ",
          at(past(l.branch.sizes, i)),
          b" = ply_imm(",
          operand(pr, args, 4),
          b");",
        ]),
      )
    },
    OfMap(KidPut) -> {
      let l = pl();
      let ks = l.key.stride;
      let n = after(b"");
      line(
        owned(None),
        p.depth,
        Bytes::concat_all([
          shifted(past(first, i), n, b"1"),
          shifted(
            run(l.branch.keys, index, ks),
            Bytes::concat_all([b"(", n, b") * ", ascii_of_int(ks)]),
            ascii_of_int(ks),
          ),
          shifted(past(l.branch.sizes, i), n, b"1"),
          at(past(first, i)),
          b" = ",
          operand(pr, args, 2),
          b"; ",
          strided_set(pr, a, l.branch.keys, i, ks, l.key, operand_arg(args, 3)),
          b" ",
          at(past(l.branch.sizes, i)),
          b" = ply_imm(",
          operand(pr, args, 4),
          b"); ",
          nh(a, b"len"),
          b" += 1;",
        ]),
      )
    },
    OfMap(KidDrop) -> {
      let l = pl();
      let ks = l.key.stride;
      let n = after(b" - 1");
      let next = index.concat(b" + 1");
      // The kid dropped goes to its node's drop, the greatest key under it as its type lays it.
      let kid = said_line(released(owned(None), node, RWord, [at(past(first, i))]), p.depth);
      let key = said_line(
        let_go_of(
          kid,
          laid_parts(pr.ctors, type_arg(node, 0), l.key.laid, 0),
          range(0, ks).map(|j: Int| strided_slot(a, l.branch.keys, i, ks, j)),
        ),
        p.depth,
      );
      line(
        key,
        p.depth,
        Bytes::concat_all([
          shifted(past(first, next), n, b"-1"),
          shifted(
            run(l.branch.keys, next, ks),
            Bytes::concat_all([b"(", n, b") * ", ascii_of_int(ks)]),
            Bytes::concat_all([b"-", ascii_of_int(ks)]),
          ),
          shifted(past(l.branch.sizes, next), n, b"-1"),
          nh(a, b"len"),
          b" -= 1;",
        ]),
      )
    },
    Recast -> held,
    _ -> record_printed(p, pr, v, op, args),
  }
}

/// The words an extern answering a record sets field `name` from, and whether they are an item's,
/// laid as its type lays it and read as the record holds the field, or a word held as the field
/// already is.
type Answered = { name: Bytes, words: List<Bytes>, item: Bool }

/// Extern `op`, which answers a record of what it wrote and what it took out, into `v`, held as the
/// record's fields: the object it takes written in a temporary of its own, made writable where
/// another holds it too, and each field set from the word that holds it, the record's word none.
fn record_printed(
  p: Place,
  pr: Printing,
  v: Var,
  op: Intrinsic,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let laid = layouts();
  let d = p.depth;
  let held = temp(pr);
  let a = held.name;
  let i = operand(pr, args, 1);
  let index = Bytes::concat_all([b"(", i, b")"]);
  let lh = |f: Bytes| head_field(list_head(), a, f);
  let nh = |w: Bytes, f: Bytes| head_field(node_head(), w, f);
  let at = |k: Bytes| slot_of(a, k);
  // What a node holds lies past its head: its kids, items or pairs from word `first`.
  let first = laid.trie.first;
  // A map node's pairs and greatest keys, laid as its key and value types lay them.
  let pairs = || pair_laid(pr, operand_type(args, 0));
  // Every one of them writes the object, held once first; a spill and a pair taken out count it.
  let started = writable(
    line(held.pr, d, Bytes::concat_all([b"Word ", a, b" = ", operand(pr, args, 0), b";"])),
    d,
    a,
    operand_type(args, 0),
    match op {
      OfList(Spill) -> Some(lh(b"tail_len")),
      OfMap(PairTake) ->
        Some(Bytes::concat_all([ascii_of_int(pairs().pair), b" * (int64_t)", nh(a, b"len")])),
      _ -> None,
    },
  );
  let whole = |name: Bytes, word: Bytes| { name: name, words: [word], item: false };
  // A word taken out of the object, and the record set from it and the object.
  let took = |text: (Bytes) -> Bytes, fields: (Bytes) -> List<Answered>| {
    let t = temp(started);
    fields_set(p, line(t.pr, d, text(t.name)), v, fields(t.name))
  };
  let cut = |kind: Int, words: Int, runs: List<{ from: Int, width: Int }>|
    took(
      |r: Bytes| {
        let rest = Bytes::concat_all([b"((int64_t)", nh(a, b"len"), b" - ", index, b")"]);
        Bytes::concat_all([
          b"Word ",
          r,
          b" = ",
          node_words_made(kind, words),
          b"; ",
          Bytes::concat_all(
            runs.map(|run: { from: Int, width: Int }|
              Bytes::concat_all([
                b"memcpy(&",
                slot_of(r, ascii_of_int(run.from)),
                b", &",
                at(
                  Bytes::concat_all([
                    ascii_of_int(run.from),
                    b" + ",
                    ascii_of_int(run.width),
                    b" * ",
                    index,
                  ]),
                ),
                b", (size_t)(",
                ascii_of_int(run.width),
                b" * ",
                rest,
                b") * sizeof(Word)); ",
              ])),
          ),
          nh(r, b"len"),
          b" = (uint32_t)",
          rest,
          b"; ",
          nh(a, b"len"),
          b" = (uint32_t)",
          index,
          b";",
        ])
      },
      |r: Bytes| [whole(b"left", a), whole(b"right", r)],
    );
  match op {
    OfList(RootSwap) -> {
      let root = at(ascii_of_int(laid.list.root));
      took(
        |old: Bytes| Bytes::concat_all([b"Word ", old, b" = ", root, b"; ", root, b" = ", i, b";"]),
        |old: Bytes| [whole(b"list", a), whole(b"old", old)],
      )
    },
    OfList(KidSwap) ->
      took(
        |old: Bytes|
          Bytes::concat_all([
            b"Word ",
            old,
            b" = 0; if (",
            i,
            b" < (int64_t)",
            nh(a, b"len"),
            b") ",
            old,
            b" = ",
            at(past(first, i)),
            b"; else ",
            nh(a, b"len"),
            b" = (uint32_t)(",
            i,
            b") + 1; ",
            at(past(first, i)),
            b" = ",
            operand(pr, args, 2),
            b";",
          ]),
        |old: Bytes| [whole(b"node", a), whole(b"old", old)],
      ),
    OfList(Spill) -> {
      let width = ascii_of_int(laid.trie.width);
      let e = item_element(pr, held_type(operand_type(args, 0)));
      took(
        |leaf: Bytes|
          Bytes::concat_all([
            b"Word ",
            leaf,
            b" = ",
            node_made(laid.trie.leaf, e.stride),
            b"; memcpy(&",
            slot_of(leaf, ascii_of_int(first)),
            b", &",
            at(ascii_of_int(laid.list.tail)),
            b", ",
            item_words(width, e),
            b" * sizeof(Word)); ",
            nh(leaf, b"len"),
            b" = ",
            width,
            b"; ",
            lh(b"tail_len"),
            b" = 0;",
          ]),
        |leaf: Bytes| [whole(b"leaf", leaf), whole(b"list", a)],
      )
    },
    OfMap(PairTake) -> {
      let l = pairs();
      let ps = ascii_of_int(l.pair);
      let start = past(first, Bytes::concat_all([index, b" * ", ps]));
      // The pair's words, each into a temporary of its own, the key's and then the value's.
      let words = range(0, l.pair).fold(
        { pr: started, names: [] },
        |acc: { pr: Printing, names: List<Bytes> }, j: Int| {
          let t = temp(acc.pr);
          { pr: t.pr, names: acc.names.push(t.name) }
        },
      );
      let taken = line(
        words.pr,
        d,
        Bytes::concat_all(
          range(0, l.pair).map(|j: Int|
            Bytes::concat_all([
              b"Word ",
              nth(words.names, j),
              b" = ",
              slot_of(a, run(first + j, index, l.pair)),
              b"; ",
            ])),
        ).concat(
          Bytes::concat_all([
            b"memmove(&",
            at(start),
            b", &",
            at(Bytes::concat_all([start, b" + ", ps])),
            b", (size_t)(",
            ps,
            b" * ((int64_t)",
            nh(a, b"len"),
            b" - ",
            index,
            b" - 1)) * sizeof(Word)); ",
            nh(a, b"len"),
            b" -= 1;",
          ]),
        ),
      );
      fields_set(p, taken, v, [
        { name: b"key", words: words.names.take(l.key.stride), item: true },
        whole(b"node", a),
        { name: b"value", words: words.names.drop(l.key.stride), item: true },
      ])
    },
    OfMap(LeafCut) -> {
      let l = pairs();
      cut(laid.tree.leaf, laid.tree.width * l.pair, [{ from: first, width: l.pair }])
    },
    OfMap(BranchCut) -> {
      let l = pairs();
      cut(laid.tree.branch, l.branch.words, [
        { from: first, width: 1 },
        { from: l.branch.keys, width: l.key.stride },
        { from: l.branch.sizes, width: 1 },
      ])
    },
    OfMap(KidOut) ->
      took(
        |kid: Bytes|
          Bytes::concat_all([
            b"Word ",
            kid,
            b" = ",
            at(past(first, i)),
            b"; ",
            at(past(first, i)),
            b" = 0;",
          ]),
        |kid: Bytes| [whole(b"kid", kid), whole(b"node", a)],
      ),
    OfMap(MapSwap) -> {
      let root = at(ascii_of_int(laid.map.root));
      took(
        |old: Bytes|
          Bytes::concat_all([
            b"Word ",
            old,
            b" = ",
            root,
            b"; ",
            root,
            b" = ",
            i,
            b"; ",
            head_field(map_head(), a, b"height"),
            b" = (uint32_t)(",
            operand(pr, args, 2),
            b"); ",
            head_field(map_head(), a, b"len"),
            b" = (uint32_t)(",
            operand(pr, args, 3),
            b");",
          ]),
        |old: Bytes| [whole(b"map", a), whole(b"old", old)],
      )
    },
    _ ->
      unprinted(
        b"an extern answering no record, printed as one that does",
        Bytes::concat_all([b"into ", var_said(v), b" of ", ascii_of_int(args.len()), b" operands"]),
      ),
  }
}

/// `v`, a record held as its fields, each set from the word `fields` names for it: an item read as
/// the field holds it, its word let go where a scalar is read out of it; a record or a sum wider than
/// a word opened out of that word, its word form, which it takes.
fn fields_set(p: Place, pr: Printing, v: Var, fields: List<Answered>) -> Printing / {abort.raise} = {
  let n = named(pr, v);
  let ns = part_names(n.name, v.rep);
  let ls = match v.rep { RFlat(x) -> x, _ -> [] };
  fields.fold(n.pr, |q: Printing, x: Answered|
    match leaf_span(ls, x.name) {
      None -> q,
      Some(sp) -> {
        let one = match ls.at(sp.at) {
          Some(l) -> if sp.n == 1 && l.name == x.name { Some(l.rep) } else { None },
          None -> None,
        };
        let r = match one { Some(lr) -> lr, None -> RFlat(leaves_within(ls, sp)) };
        let first = leaf_values(ls, sp.at).at;
        let mine = ns.drop(first).take(values_of(r).len());
        if x.item {
          // An item's words are laid as its type lays it, read into the field's values.
          let values = values_read(|j: Int| nth(x.words, j), values_of(r));
          let ts = c_types(r);
          range(0, mine.len()).fold(q, |s: Printing, k: Int|
            line(
              s,
              p.depth,
              Bytes::concat_all([nth(ts, k), b" ", nth(mine, k), b" = ", nth(values, k), b";"]),
            ))
        } else if in_box(r) {
          pieces(
            q,
            [Text(pad(p.depth))].concat(word_parts(nth(x.words, 0), r, mine)).push(Text(b"\n")),
          )
        } else {
          line(
            q,
            p.depth,
            Bytes::concat_all([c_type(r), b" ", nth(mine, 0), b" = ", nth(x.words, 0), b";"]),
          )
        }
      },
    })
}

fn slot_of(w: Bytes, at: Bytes) -> Bytes = Bytes::concat_all([b"ply_words(", w, b")[", at, b"]"])

/// `at` words past the word `from`, as C reads it.
fn past(from: Int, at: Bytes) -> Bytes = Bytes::concat_all([ascii_of_int(from), b" + (", at, b")"])

/// The line written ahead of a write of the object `a`, of type `ty`: `a` held once, copied by the
/// root written for its type where another holds it too, and where `counted` says how many words a
/// copy takes, the write counted as in place or of a copy of those.
fn writable(pr: Printing, depth: Int, a: Bytes, ty: Type, counted: Option<Bytes>) -> Printing = {
  let c = copy_called(pr, a, ty);
  match counted {
    None ->
      pieces(
        c.pr,
        [Text(Bytes::concat_all([pad(depth), b"if (ply_obj(", a, b")->rc != 1) "]))].concat(
          c.out,
        ).push(
          Text(b"\n"),
        ),
      ),
    Some(n) ->
      pieces(c.pr, [
        Text(Bytes::concat_all([pad(depth), a, b" = ", writable_fn(), b"(ctx, ", a, b", "])),
        Hole(Symbol(Root(root_of(Copy, ty)))),
        Text(Bytes::concat_all([b", ", n, b");\n"])),
      ]),
  }
}

/// The line copying `a`, of type `ty`, by the root written for its type where the C local
/// `in_place`, which the line's block declares, says another holds it too.
fn copied(pr: Printing, depth: Int, a: Bytes, ty: Type) -> Printing = {
  let c = copy_called(pr, a, ty);
  pieces(c.pr, [Text(pad(depth).concat(b"if (!in_place) "))].concat(c.out).push(Text(b"\n")))
}

/// `a = copy(ctx, a);`, the copy the root written to copy a block of type `ty`, which takes the block
/// and answers a copy held once, noted among the root's calls with the head it is called at.
fn copy_called(pr: Printing, a: Bytes, ty: Type) -> { pr: Printing, out: List<Piece> } = {
  let k = root_of(Copy, ty);
  {
    pr: if pr.calls.contains(k) { pr } else {
      {
        ..pr,
        calls: pr.calls.push(k),
        expects: pr.expects.push({
          callee: CallAt(pr.calls.len()),
          head: head_types({
            params: [{ handed: Given, rep: RWord }],
            answer: RWord,
            destined: false,
            answered: Owned,
          }),
        }),
      }
    },
    out: [
      Text(Bytes::concat_all([a, b" = "])),
      Hole(Symbol(Root(k))),
      Text(Bytes::concat_all([b"(ctx, ", a, b");"])),
    ],
  }
}

/// The type of operand `k`, unknown where it is no variable.
fn operand_type(args: List<Arg>, k: Int) -> Type =
  match args.at(k) { Some(AVar(x)) -> x.ty, _ -> unknown_type() }

/// `Array::new(n, x)` into `v`: `n` elements laid out as `e` says, each `x`, which it takes and
/// counts once more for each element past the first, or lets go of where there is none. A length
/// below zero or past what an array holds raises, `x` let go of.
fn array_new(
  p: Place,
  pr: Printing,
  v: Var,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = held_type(v.ty);
  let n = operand(pr, args, 0);
  let x = operand_arg(args, 1);
  let xs = arg_parts(pr, x);
  let r = rep_of_arg(x);
  let d = p.depth;
  let started = assigned(site(p, pr), d, v, c_type(v.rep), b"0");
  let a = name_of(started, v);
  let opened = line(
    started,
    d,
    Bytes::concat_all([b"if (", n, b" < 0 || ", n, b" > ", ascii_of_int(most(e)), b") {"]),
  );
  let raised = line(
    said_line(released(opened, ty, r, xs), d + 1),
    d + 1,
    refused(b"Array::new", n, b"0"),
  );
  let made = line(line(raised, d, b"} else {"), d + 1, array_alloc(a, n, e));
  let i = temp(made);
  let counted = copies_counted(i.pr, d + 1, n, i.name, ty, r, xs);
  let filled = line(
    counted,
    d + 1,
    Bytes::concat_all([
      for_each(i.name, b"0", n),
      element_set(a, i.name, e, words_laid(xs, values_of(r))),
      b" }",
    ]),
  );
  check(p, line(filled, d, b"}"))
}

/// The C counting the value `xs`, of type `ty` held as `r`, once for each of `n` holders past the
/// first, and letting it go where `n` is none, a loop over `i`.
fn copies_counted(
  pr: Printing,
  depth: Int,
  n: Bytes,
  i: Bytes,
  ty: Type,
  r: Rep,
  xs: List<Bytes>,
) -> Printing / {abort.raise} = {
  let dups = duped(pr, ty, r, xs);
  let none = released(dups.pr, ty, r, xs);
  if dups.out.len() == 0 { none.pr } else {
    pieces(
      none.pr,
      [Text(Bytes::concat_all([pad(depth), b"if (", n, b" == 0) { "]))].concat(none.out).push(
        Text(Bytes::concat_all([b" } else { ", for_each(i, b"1", n)])),
      ).concat(
        dups.out,
      ).push(
        Text(b" } }\n"),
      ),
    )
  }
}

/// `Array::set(xs, i, x)` into `v`: written in place where `xs` is held once and into a copy
/// otherwise, each element of which is counted once more and `xs` let go of; the element it
/// replaces is let go of by its type. Takes `xs` and `x`; an index out of range raises, both let go
/// of.
fn array_set(
  p: Place,
  pr: Printing,
  v: Var,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = held_type(v.ty);
  let i = operand(pr, args, 1);
  let x = operand_arg(args, 2);
  let xs = arg_parts(pr, x);
  let r = rep_of_arg(x);
  let d = p.depth;
  let started = assigned(site(p, pr), d, v, c_type(v.rep), operand(pr, args, 0));
  let a = name_of(started, v);
  let n = temp(started);
  let opened = line(
    line(n.pr, d, Bytes::concat_all([b"int64_t ", n.name, b" = ", array_len(a), b";"])),
    d,
    Bytes::concat_all([b"if ((uint64_t)", i, b" >= (uint64_t)", n.name, b") {"]),
  );
  let x_go = said_line(released(opened, ty, r, xs), d + 1);
  let raised = line(
    said_line(released(x_go, v.ty, RWord, [a]), d + 1),
    d + 1,
    Bytes::concat_all([a, b" = 0; ", refused(b"Array::set", i, n.name)]),
  );
  let writable = array_writable(line(raised, d, b"} else {"), d + 1, a, n.name, e, v.ty);
  let replaced = let_go_of(writable, laid_parts(pr.ctors, ty, e.laid, 0), element_slots(a, i, e));
  let written = line(
    said_line(replaced, d + 1),
    d + 1,
    element_set(a, i, e, words_laid(xs, values_of(r))),
  );
  check(p, line(written, d, b"}"))
}

/// The lines making the array `a`, of type `ty`, of `n` elements laid out as `e`, held once: copied
/// where another holds it too, each element of the copy counted once more and `a` let go of, and
/// the write counted as in place or of a copy of `n`.
fn array_writable(
  pr: Printing,
  depth: Int,
  a: Bytes,
  n: Bytes,
  e: Element,
  ty: Type,
) -> Printing / {abort.raise} = {
  let c = temp(pr);
  let j = temp(c.pr);
  let dups = dup_of(
    laid_parts(pr.ctors, held_type(ty), e.laid, 0),
    element_slots(c.name, j.name, e),
  );
  let old = released(j.pr, ty, RWord, [a]);
  let copied = pieces(
    old.pr,
    [
      Text(
        Bytes::concat_all([
          pad(depth),
          b"int in_place = ply_obj(",
          a,
          b")->rc == 1;\n",
          pad(depth),
          b"if (!in_place) { Word ",
          c.name,
          b" = rt_alloc_bytes_p(ctx, ",
          array_bytes(n, e),
          b"); memcpy(ply_words(",
          c.name,
          b"), ply_words(",
          a,
          b"), (size_t)(",
          array_bytes(n, e),
          b" - ",
          ascii_of_int(header_bytes()),
          b")); ",
          if dups.len() == 0 { b"" }
          else { Bytes::concat_all([for_each(j.name, b"0", n), dups, b" } "]) },
        ]),
      ),
    ].concat(
      old.out,
    ).push(
      Text(Bytes::concat_all([b" ", a, b" = ", c.name, b"; }\n"])),
    ),
  );
  line(
    copied,
    depth,
    Bytes::concat_all([b"rt_note_update_p(ctx, in_place, in_place ? 0 : ", n, b");"]),
  )
}

/// `Array::of_list(xs)` into `v`: each item of the list, borrowed as the word a list holds it as,
/// counted once more and written as the array lays out an element, and the list let go of. Takes
/// `xs`; a list longer than an array holds raises.
fn array_of_list(
  p: Place,
  pr: Printing,
  v: Var,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = held_type(v.ty);
  let l = operand(pr, args, 0);
  let listed = list_type(ty);
  let d = p.depth;
  let count = temp(site(p, pr));
  let n = count.name;
  let started = assigned(
    line(
      count.pr,
      d,
      Bytes::concat_all([
        b"int64_t ",
        n,
        b" = (int64_t)",
        head_field(list_head(), l, b"len"),
        b";",
      ]),
    ),
    d,
    v,
    c_type(v.rep),
    b"0",
  );
  let a = name_of(started, v);
  let opened = line(
    started,
    d,
    Bytes::concat_all([b"if (", n, b" > ", ascii_of_int(most(e)), b") {"]),
  );
  let raised = line(
    said_line(released(opened, listed, RWord, [l]), d + 1),
    d + 1,
    refused(b"Array::of_list", n, b"0"),
  );
  let made = line(line(raised, d, b"} else {"), d + 1, array_alloc(a, n, e));
  let i = temp(made);
  let item = items_held(i.pr, d + 1, l, n, i.name, ty);
  let stored = line(
    item.pr,
    d + 2,
    element_set(a, i.name, e, words_laid(item.values, values_of(item.rep))),
  );
  let released_list = released(line(stored, d + 1, b"}"), listed, RWord, [l]);
  check(p, line(said_line(released_list, d + 1), d, b"}"))
}

/// The C opening a loop over the `n` items of the list `l`, each item of type `ty` read where it
/// lies, counted once more and taken into the C values `values`, held as `rep`, for the loop's body,
/// which the caller writes at `depth + 1` and closes.
fn items_held(
  pr: Printing,
  depth: Int,
  l: Bytes,
  n: Bytes,
  i: Bytes,
  ty: Type,
) -> { pr: Printing, values: List<Bytes>, rep: Rep } / {abort.raise} = {
  let rep = held_with(pr.ctors, ty);
  let e = item_element(pr, ty);
  let w = temp(pr);
  let x = temp(w.pr);
  let names = part_names(x.name, rep);
  let opened = line(x.pr, depth, for_each(i, b"0", n));
  let read = item_read(opened, depth + 1, w.name, l, i, e.stride);
  let words = range(0, e.stride).map(|j: Int| slot_at(w.name, j));
  let dup = dup_of(laid_parts(pr.ctors, ty, e.laid, 0), words);
  let counted = if dup.len() == 0 { read } else { line(read, depth + 1, dup) };
  let values = values_read(|j: Int| slot_at(w.name, j), values_of(rep));
  {
    pr: range(0, names.len()).fold(counted, |q: Printing, k: Int|
      line(
        q,
        depth + 1,
        Bytes::concat_all([
          nth(c_types(rep), k),
          b" ",
          nth(names, k),
          b" = ",
          nth(values, k),
          b";",
        ]),
      )),
    values: names,
    rep: rep,
  }
}

/// Word `j` of the words at the address `w`, as C.
fn slot_at(w: Bytes, j: Int) -> Bytes = Bytes::concat_all([w, b"[", ascii_of_int(j), b"]"])

/// `Array::get(xs, i)` into `v`: element `i` read as `v` holds it, borrowed from the array. An index
/// out of range raises.
fn array_get(
  p: Place,
  pr: Printing,
  v: Var,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let a = operand(pr, args, 0);
  let i = operand(pr, args, 1);
  parts_declared(p, outside_refused(p, pr, b"Array::get", a, i), v, element_values(a, i, e, v.rep))
}

/// The line raising, as builtin `what` does, where `i` names no element of the array `a`.
fn outside_refused(
  p: Place,
  pr: Printing,
  what: Bytes,
  a: Bytes,
  i: Bytes,
) -> Printing / {abort.raise} = {
  let length = array_len(a);
  line(
    site(p, pr),
    p.depth,
    Bytes::concat_all([
      b"if ((uint64_t)",
      i,
      b" >= (uint64_t)",
      length,
      b") { ",
      refused(what, i, length),
      b" ",
      p.leave,
      b" }",
    ]),
  )
}

/// `Bytes::position(b, from, f)` into `v` as a loop in the body: the first index from `from` whose
/// byte `f` holds of, `-1` where it holds of none, raising for a start past the end. `f` is called by
/// its type, which takes it, so each call is handed a count of its own, and the row's descriptor
/// and words, the last two operands. Reads `b` and `f`.
fn position_printed(p: Place, pr: Printing, v: Var, args: List<Arg>) -> Printing / {abort.raise} = {
  let b = operand(pr, args, 0);
  let from = operand(pr, args, 1);
  let f = operand(pr, args, 2);
  let described = operand(pr, args, 3);
  let words = operand(pr, args, 4);
  let d = p.depth;
  let len = Bytes::concat_all([b"(int64_t)", head_field(text_head(), b, b"len")]);
  let guarded = line(
    site(p, pr),
    d,
    Bytes::concat_all([
      b"if ((uint64_t)",
      from,
      b" > (uint64_t)",
      len,
      b") { ",
      refused(b"Bytes::position", from, len),
      b" ",
      p.leave,
      b" }",
    ]),
  );
  let found = assigned(guarded, d, v, c_type(v.rep), b"-1");
  let n = name_of(found, v);
  let i = temp(found);
  let opened = line(
    i.pr,
    d,
    Bytes::concat_all([
      b"for (int64_t ",
      i.name,
      b" = ",
      from,
      b"; ",
      i.name,
      b" < ",
      len,
      b"; ",
      i.name,
      b" += 1) {",
    ]),
  );
  let conv = typed_convention(predicate_convention(pr, args));
  let called = temp(opened);
  let inside = { ..p, depth: d + 1 };
  let asked = line(
    site(inside, called.pr),
    d + 1,
    Bytes::concat_all([
      call_text(dup_fn(), [f]),
      b"; ",
      c_type(conv.answer),
      b" ",
      called.name,
      b" = ",
      typed_callee(f, conv),
      b"(ctx, ",
      f,
      b", (int64_t)(",
      bytes_of(b),
      b")[",
      i.name,
      b"], ",
      described,
      b", ",
      words,
      b");",
    ]),
  );
  let hit = line(
    check(inside, asked),
    d + 1,
    Bytes::concat_all([b"if (", called.name, b") { ", n, b" = ", i.name, b"; break; }"]),
  );
  line(hit, d, b"}")
}

/// The convention `Bytes::position`'s predicate, its third operand, is called at by its type: an
/// `Int` in and a `Bool` out, as the builtin's signature says.
fn predicate_convention(pr: Printing, args: List<Arg>) -> Convention / {abort.raise} =
  match args.at(2) {
    Some(AVar(v)) -> match v.ty {
      TyFn(t) -> {
        let c = convention_of(pr.ctors, { params: t.params, ret: t.ret });
        if reps_of(c) == [RInt] && c.answer == RBool { c } else {
          unprinted(b"a byte string's position whose predicate is held otherwise", var_said(v))
        }
      },
      _ -> unprinted(b"a byte string's position on no function", var_said(v)),
    },
    _ -> unprinted(b"a byte string's position on no predicate", ascii_of_int(args.len())),
  }

/// Field `k` of record `i` of the `Columns` `xs` into `v`: element `i` of the field's column, read
/// as `v` holds it, borrowed. An index naming no record raises as `Columns::get` does.
fn column_printed(
  p: Place,
  pr: Printing,
  v: Var,
  k: Int,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let column = slot_of(operand(pr, args, 0), ascii_of_int(k));
  let i = operand(pr, args, 1);
  parts_declared(
    p,
    outside_refused(p, pr, b"Columns::get", column, i),
    v,
    element_values(column, i, e, v.rep),
  )
}

/// `Columns::new(n, x)` into `v`: a column per field of `x`, each of `n` elements laid out as its
/// element in `es` says, each the field; `x` taken, counted once more for each record past the
/// first, or let go of where there is none. A length below zero or past what a column holds raises,
/// `x` let go of.
fn columns_new(
  p: Place,
  pr: Printing,
  v: Var,
  es: List<Element>,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = held_type(v.ty);
  let n = operand(pr, args, 0);
  let x = operand_arg(args, 1);
  let xs = arg_parts(pr, x);
  let r = rep_of_arg(x);
  let ws = words_laid(xs, values_of(r));
  let d = p.depth;
  let started = assigned(site(p, pr), d, v, c_type(v.rep), b"0");
  let c = name_of(started, v);
  let opened = line(
    started,
    d,
    Bytes::concat_all([b"if (", n, b" < 0 || ", n, b" > ", ascii_of_int(most_of(es)), b") {"]),
  );
  let raised = line(
    said_line(released(opened, ty, r, xs), d + 1),
    d + 1,
    refused(b"Columns::new", n, b"0"),
  );
  let made = line(line(raised, d, b"} else {"), d + 1, columns_alloc(c, es.len()));
  let i = temp(made);
  let filled = range(0, es.len()).fold(i.pr, |q: Printing, f: Int| {
    let e = es.get(f);
    let col = temp(q);
    line(
      line(
        col.pr,
        d + 1,
        Bytes::concat_all([
          b"Word ",
          col.name,
          b"; ",
          array_alloc(col.name, n, e),
          b" ",
          slot_of(c, ascii_of_int(f)),
          b" = ",
          col.name,
          b";",
        ]),
      ),
      d + 1,
      Bytes::concat_all([
        for_each(i.name, b"0", n),
        element_set(col.name, i.name, e, field_words(ws, es, f)),
        b" }",
      ]),
    )
  });
  check(p, line(copies_counted(filled, d + 1, n, i.name, ty, r, xs), d, b"}"))
}

/// `Columns::of_list(xs)` into `v`: a column per field of the list's records, each of as many
/// elements as the list has items laid out as its element in `es` says. Each item, borrowed as the
/// word a list holds it as, is counted once more and its fields written into their columns, and the
/// list is let go of. Takes `xs`; a list longer than a column holds raises.
fn columns_of_list(
  p: Place,
  pr: Printing,
  v: Var,
  es: List<Element>,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = held_type(v.ty);
  let l = operand(pr, args, 0);
  let listed = list_type(ty);
  let d = p.depth;
  let count = temp(site(p, pr));
  let n = count.name;
  let started = assigned(
    line(
      count.pr,
      d,
      Bytes::concat_all([
        b"int64_t ",
        n,
        b" = (int64_t)",
        head_field(list_head(), l, b"len"),
        b";",
      ]),
    ),
    d,
    v,
    c_type(v.rep),
    b"0",
  );
  let c = name_of(started, v);
  let opened = line(
    started,
    d,
    Bytes::concat_all([b"if (", n, b" > ", ascii_of_int(most_of(es)), b") {"]),
  );
  let raised = line(
    said_line(released(opened, listed, RWord, [l]), d + 1),
    d + 1,
    refused(b"Columns::of_list", n, b"0"),
  );
  let made = line(line(raised, d, b"} else {"), d + 1, columns_alloc(c, es.len()));
  let cols = range(0, es.len()).fold(
    { pr: made, names: [] },
    |acc: { pr: Printing, names: List<Bytes> }, f: Int| {
      let col = temp(acc.pr);
      {
        pr: line(
          col.pr,
          d + 1,
          Bytes::concat_all([
            b"Word ",
            col.name,
            b"; ",
            array_alloc(col.name, n, es.get(f)),
            b" ",
            slot_of(c, ascii_of_int(f)),
            b" = ",
            col.name,
            b";",
          ]),
        ),
        names: acc.names.push(col.name),
      }
    },
  );
  let i = temp(cols.pr);
  let item = items_held(i.pr, d + 1, l, n, i.name, ty);
  let ws = words_laid(item.values, values_of(item.rep));
  let stored = range(0, es.len()).fold(item.pr, |q: Printing, f: Int|
    line(q, d + 2, element_set(cols.names.get(f), i.name, es.get(f), field_words(ws, es, f))));
  let released_list = released(line(stored, d + 1, b"}"), listed, RWord, [l]);
  check(p, line(said_line(released_list, d + 1), d, b"}"))
}

/// `Columns::get(xs, i)` into `v`: record `i`, each field read out of its column, borrowed. An index
/// naming no record raises.
fn columns_get(
  p: Place,
  pr: Printing,
  v: Var,
  es: List<Element>,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let c = operand(pr, args, 0);
  let i = operand(pr, args, 1);
  let tested = outside_refused(p, pr, b"Columns::get", slot_of(c, b"0"), i);
  let ws = range(0, es.len()).fold([], |acc: List<Bytes>, f: Int| {
    let e = es.get(f);
    acc.concat(element_slots(slot_of(c, ascii_of_int(f)), i, e).take(words(e.laid)))
  });
  let record = temp(tested);
  let held = line(
    record.pr,
    p.depth,
    Bytes::concat_all([
      b"Word ",
      record.name,
      b"[",
      ascii_of_int(max(1, ws.len())),
      b"] = {",
      if ws.len() == 0 { b"0" } else { Bytes::join(ws, b", ") },
      b"};",
    ]),
  );
  parts_declared(p, held, v, parts_read(record.name, values_of(v.rep)))
}

/// `Columns::set(xs, i, x)` into `v`: the `Columns` held once, copied where another holds it too
/// with each column counted once more and `xs` let go of; then each field written into its column
/// as `Array::set` writes an element, the element it replaces let go of by its type. Takes `xs`
/// and `x`; an index naming no record raises, both let go of.
fn columns_set(
  p: Place,
  pr: Printing,
  v: Var,
  es: List<Element>,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = held_type(v.ty);
  let fields = field_types(ty);
  let i = operand(pr, args, 1);
  let x = operand_arg(args, 2);
  let xs = arg_parts(pr, x);
  let r = rep_of_arg(x);
  let ws = words_laid(xs, values_of(r));
  let d = p.depth;
  let started = assigned(site(p, pr), d, v, c_type(v.rep), operand(pr, args, 0));
  let c = name_of(started, v);
  let n = temp(started);
  let opened = line(
    line(
      n.pr,
      d,
      Bytes::concat_all([b"int64_t ", n.name, b" = ", array_len(slot_of(c, b"0")), b";"]),
    ),
    d,
    Bytes::concat_all([b"if ((uint64_t)", i, b" >= (uint64_t)", n.name, b") {"]),
  );
  let x_go = said_line(released(opened, ty, r, xs), d + 1);
  let raised = line(
    said_line(released(x_go, v.ty, RWord, [c]), d + 1),
    d + 1,
    Bytes::concat_all([c, b" = 0; ", refused(b"Columns::set", i, n.name)]),
  );
  let b = temp(line(raised, d, b"} else {"));
  let column_type = |f: Int|
    array_type(match fields.at(f) { Some(t) -> t, None -> unknown_type() });
  let dups = Bytes::join(
    range(0, es.len()).map(|f: Int|
      spelled(duped(b.pr, column_type(f), RWord, [slot_of(b.name, ascii_of_int(f))]).out)).filter(
      |t: Bytes| t.len() > 0,
    ),
    b" ",
  );
  let old = released(b.pr, v.ty, RWord, [c]);
  let block = pieces(
    old.pr,
    [
      Text(
        Bytes::concat_all([
          pad(d + 1),
          b"if (ply_obj(",
          c,
          b")->rc != 1) { Word ",
          b.name,
          b" = ",
          columns_made(es.len()),
          b"; memcpy(ply_words(",
          b.name,
          b"), ply_words(",
          c,
          b"), ",
          ascii_of_int(8 * es.len()),
          b"); ",
          dups,
          b" ",
        ]),
      ),
    ].concat(
      old.out,
    ).push(
      Text(Bytes::concat_all([b" ", c, b" = ", b.name, b"; }\n"])),
    ),
  );
  let written = range(0, es.len()).fold(block, |q: Printing, f: Int| {
    let e = es.get(f);
    let col = temp(q);
    let held = line(
      col.pr,
      d + 1,
      Bytes::concat_all([b"{ Word ", col.name, b" = ", slot_of(c, ascii_of_int(f)), b";"]),
    );
    let writable = array_writable(held, d + 2, col.name, n.name, e, column_type(f));
    let replaced = let_go_of(
      writable,
      laid_parts(pr.ctors, held_type(column_type(f)), e.laid, 0),
      element_slots(col.name, i, e),
    );
    line(
      line(
        said_line(replaced, d + 2),
        d + 2,
        Bytes::concat_all([
          element_set(col.name, i, e, field_words(ws, es, f)),
          b" ",
          slot_of(c, ascii_of_int(f)),
          b" = ",
          col.name,
          b";",
        ]),
      ),
      d + 1,
      b"}",
    )
  });
  check(p, line(written, d, b"}"))
}

/// The type a container of type `ty` holds, its first argument.
fn held_type(ty: Type) -> Type = type_arg(ty, 0)

/// Type argument `k` of the container type `ty`.
fn type_arg(ty: Type, k: Int) -> Type =
  match ty {
    TyCon(c) -> match c.args.at(k) { Some(t) -> t, None -> unknown_type() },
    _ -> unknown_type(),
  }

/// The types of the fields of a record of type `ty`, in its order.
fn field_types(ty: Type) -> List<Type> =
  match record_fields(ty) { Some(fs) -> fs.map(|f: Field| f.ty), None -> [] }

/// Operand `k`, or a zero word where there is none.
fn operand_arg(args: List<Arg>, k: Int) -> Arg =
  match args.at(k) { Some(a) -> a, None -> AZero(RWord) }

/// The C opening a loop of `i` from `from` up to `n`, its body the caller's to write and close.
fn for_each(i: Bytes, from: Bytes, n: Bytes) -> Bytes =
  Bytes::concat_all([b"for (int64_t ", i, b" = ", from, b"; ", i, b" < ", n, b"; ", i, b"++) { "])

/// Word `j` of element `i` of the array `a`, its elements `stride` words apart past its head.
fn element_slot(a: Bytes, i: Bytes, stride: Int, j: Int) -> Bytes =
  Bytes::concat_all([
    b"ply_words(",
    a,
    b")[(",
    i,
    b") * ",
    ascii_of_int(stride),
    b" + ",
    ascii_of_int(head_words(array_head()) + j),
    b"]",
  ])

/// The words element `i` of the array `a`, laid out as `e`, takes.
fn element_slots(a: Bytes, i: Bytes, e: Element) -> List<Bytes> =
  range(0, e.stride).map(|j: Int| element_slot(a, i, e.stride, j))

/// The C setting element `i` of the array `a` to the words `ws`, as `e` lays it out: each word of
/// its stride `ws` leaves out zero.
fn element_set(a: Bytes, i: Bytes, e: Element, ws: List<Bytes>) -> Bytes =
  Bytes::join(
    range(0, e.stride).map(|j: Int|
      Bytes::concat_all([
        element_slot(a, i, e.stride, j),
        b" = ",
        match ws.at(j) { Some(w) -> w, None -> b"0" },
        b";",
      ])),
    b" ",
  )

/// The C values of element `i` of the array `a`, laid out as `e`, held as `r`.
fn element_values(a: Bytes, i: Bytes, e: Element, r: Rep) -> List<Bytes> =
  parts_read(
    Bytes::concat_all([
      b"(ply_words(",
      a,
      b") + ",
      ascii_of_int(head_words(array_head())),
      b" + (",
      i,
      b") * ",
      ascii_of_int(e.stride),
      b")",
    ]),
    values_of(r),
  )

/// The words of field `f` of a record whose words are `ws`, its fields laid out as `es` says one
/// after another.
fn field_words(ws: List<Bytes>, es: List<Element>, f: Int) -> List<Bytes> / {abort.raise} =
  ws.drop(es.take(f).fold(0, |n: Int, e: Element| n + words(e.laid))).take(words(es.get(f).laid))

/// The C making `a` an array of `n` elements laid out as `e`, its head counting them, each element
/// the caller's to write.
fn array_alloc(a: Bytes, n: Bytes, e: Element) -> Bytes =
  Bytes::concat_all([
    a,
    b" = rt_alloc_bytes_p(ctx, ",
    array_bytes(n, e),
    b"); ",
    array_len(a),
    b" = ",
    n,
    b";",
  ])

/// The bytes of an array of `n` elements laid out as `e`: its header, its head and their words.
fn array_bytes(n: Bytes, e: Element) -> Bytes =
  Bytes::concat_all([
    ascii_of_int(header_bytes() + 8 * head_words(array_head())),
    b" + 8 * (",
    n,
    b") * ",
    ascii_of_int(e.stride),
  ])

/// How many elements the array `a` holds, as its head says.
fn array_len(a: Bytes) -> Bytes = head_field(array_head(), a, b"len")

/// The C making `c` a `Columns` of `k` columns, each the caller's to write.
fn columns_alloc(c: Bytes, k: Int) -> Bytes = Bytes::concat_all([c, b" = ", columns_made(k), b";"])

/// The C allocating a `Columns` of `k` columns, its words the caller's to write.
fn columns_made(k: Int) -> Bytes =
  Bytes::concat_all([b"rt_alloc_bytes_p(ctx, ", ascii_of_int(header_bytes() + 8 * k), b")"])

/// The most elements laid out as `e` an array holds: 2^26, fewer where their words would pass 2^32.
fn most(e: Element) -> Int / {abort.raise} = min(67108864, 4294967295 / e.stride)

/// The most records a `Columns` whose columns are laid out as `es` holds.
fn most_of(es: List<Element>) -> Int / {abort.raise} =
  es.fold(67108864, |m: Int, e: Element| min(m, most(e)))

/// The C raising as builtin `what` does over `n` and `len`.
fn refused(what: Bytes, n: Bytes, len: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    builtin_helper(b"?refused"),
    b"_p(ctx, ",
    ascii_of_int(refusal(what)),
    b", ",
    n,
    b", ",
    len,
    b", 0);",
  ])

/// What `s` says printed as one line at `depth`; nothing where it says nothing.
fn said_line(s: Said, depth: Int) -> Printing =
  if s.out.len() == 0 { s.pr }
  else { pieces(s.pr, [Text(pad(depth))].concat(s.out).push(Text(b"\n"))) }

/// `v` declared holding `exprs`, one per C value it is held as.
fn parts_declared(p: Place, pr: Printing, v: Var, exprs: List<Bytes>) -> Printing = {
  let n = named(pr, v);
  let ts = c_types(v.rep);
  let ns = part_names(n.name, v.rep);
  range(0, ns.len()).fold(n.pr, |q: Printing, k: Int|
    line(
      q,
      p.depth,
      Bytes::concat_all([nth(ts, k), b" ", nth(ns, k), b" = ", nth(exprs, k), b";"]),
    ))
}

fn operand(pr: Printing, args: List<Arg>, k: Int) -> Bytes =
  match args.at(k) { Some(a) -> arg_text(pr, a), None -> b"0" }

/// Where an instruction of a root answering a word is printed, at the body's own depth.
fn at_top() -> Place =
  {
    u: {
      symbol: b"ply_m_1f_1",
      base: 0,
      answer: RWord,
      site: None,
      arm: None,
      looping: None,
      landing: None,
      group: None,
      unwinds: [],
      leaving: b"ctx->fuel += 1;",
    },
    at: span_between(10, 20),
    leave: b"return 0;",
    depth: 0,
  }

fn local(id: Int, ty: Type, rep: Rep) -> Var = { id: id, ty: ty, rep: rep }

test "a list literal is laid out by the emitted code, its tail holding what fits in one" {
  let made_of = |item: Type, args: List<Arg>|
    spelled(
      contained(
        at_top(),
        printing(Map::new().insert(0, b"p0")),
        Some({ id: 1, ty: list_type(item), rep: RWord }),
        { made: MList(args.len()), args: args, reuse: None },
      ).out,
    );
  let made = |args: List<Arg>| made_of(string_type(), args);
  let laid = layouts().list;
  let tail = |k: Int| Bytes::concat_all([b"[", ascii_of_int(laid.tail + k), b"] = "]);
  let two = made([AVar(local(0, string_type(), RWord)), AZero(RWord)]);
  let has = |text: Bytes, t: Bytes|
    assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  // Room for the two items, each in its tail slot, the tail's length two.
  has(two, b"ply_list_room(ctx, 2, 1)");
  has(two, tail(0).concat(b"p0;"));
  has(two, tail(1).concat(b"0;"));
  has(two, b"))->tail_len = 2;");
  assert_eq(made([]).index_of(b")["), None);
  // A `Decimal` lies in the tail as its two words.
  let dec = made_of(decimal_type(), [AZero(RDec)]);
  has(dec, b"ply_list_room(ctx, 1, 2)");
  has(dec, tail(1).concat(b"("));
  // Making a list cannot fail.
  [made([]), two].fold((), |_: Unit, text: Bytes| assert_eq(text.index_of(b"ctx->failed"), None))
}

test "a list literal past a tail's room lays its whole leaves under a branch and the rest in its tail" {
  let width = layouts().trie.width;
  let n = 2 * width + 3;
  let text = spelled(
    contained(
      at_top(),
      printing(Map::new()),
      Some({ id: 1, ty: list_type(int_type()), rep: RWord }),
      { made: MList(n), args: range(0, n).map(AInt), reuse: None },
    ).out,
  );
  let count = |t: Bytes|
    range(0, text.len()).fold(0, |c: Int, i: Int|
      if text.slice(i, text.len()).starts_with(t) { c + 1 } else { c });
  assert_eq(
    count(Bytes::concat_all([b"ply_node(ctx, ", ascii_of_int(layouts().trie.leaf), b", "])),
    2,
  );
  assert_eq(
    count(Bytes::concat_all([b"ply_node(ctx, ", ascii_of_int(layouts().trie.branch), b", "])),
    1,
  );
  // The branch holds both leaves, and the list the branch as its root and the last three in its tail.
  let laid = layouts().list;
  let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  has(b"->len = 2;");
  has(Bytes::concat_all([b"[", ascii_of_int(laid.root), b"] = t"]));
  has(b"))->tail_len = 3;")
}

test "a list's item is read where it lies and its rest shares its trie, neither through the runtime" {
  let op = |c: ContainerOp, item: Type, into: Var|
    spelled(
      container_op(
        at_top(),
        printing(Map::new().insert(0, b"p0")),
        Some(into),
        c,
        [AVar({ id: 0, ty: list_type(item), rep: RWord }), AInt(2)],
        { takes: [false, false], owned: c == Rest, fails: false, stops: false },
      ).out,
    );
  let item = op(ItemAt, string_type(), local(1, string_type(), RWord));
  let scalar = op(ItemAt, int_type(), local(1, int_type(), RInt));
  let rest = op(Rest, string_type(), { id: 1, ty: list_type(string_type()), rep: RWord });
  let ints = op(Rest, int_type(), { id: 1, ty: list_type(int_type()), rep: RWord });
  [item, scalar, rest, ints].fold((), |_: Unit, text: Bytes| {
    assert_eq([text.index_of(b"rt_list_at_p"), text.index_of(b"rt_list_rest_p")], [None, None]);
    assert_eq(text.index_of(b"ctx->failed"), None)
  });
  // A read counts nothing; a rest counts the root it shares and each item it copies, as the item's
  // type counts it: an `Int`'s bits not at all.
  [item, scalar].fold((), |_: Unit, text: Bytes|
    assert(!counts_any(text), Some(String::of_bytes_lossy(text))));
  assert(rest.split(call_start(dup_fn(), [])).len() > 2, Some(String::of_bytes_lossy(rest)));
  assert_eq(ints.split(call_start(dup_fn(), [])).len(), 2);
  // A scalar is read out of the item's word.
  assert(scalar.index_of(b"int64_t ") != None, Some(String::of_bytes_lossy(scalar)))
}

test "an array of `Int`s holds each as its bits a word apart, with no shape, and a bad length raises" {
  let int = int_type();
  let pr = container_op(
    at_top(),
    printing(Map::new().insert(0, b"p0")),
    Some({ id: 1, ty: array_type(int), rep: RWord }),
    ArrayNew({ laid: laid(no_ctors(), int), stride: 1 }),
    [AVar({ id: 0, ty: int, rep: RInt }), AInt(7)],
    { takes: [false, true], owned: true, fails: true, stops: false },
  );
  let text = spelled(pr.out);
  let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  let ints = { laid: laid(no_ctors(), int), stride: 1 };
  has(Bytes::concat_all([b" = rt_alloc_bytes_p(ctx, ", array_bytes(b"p0", ints), b");"]));
  has(Bytes::concat_all([array_len(b"t1"), b" = p0;"]));
  has(b" * 1 + 1] = (Word)(INT64_C(7));");
  has(b"builtin_elaborated_refused_p(ctx, 0, p0, 0, 0);");
  assert_eq([text.index_of(b"builtin_array_"), text.index_of(b"->aux")], [None, None])
}

test "an array of records holds each record's words in place, and a write lets go of the one it replaces by its type" {
  let int = int_type();
  let rec = TyRecord([{ name: b"s", ty: string_type() }, { name: b"x", ty: float_type() }]);
  let array = array_type(rec);
  let pr = container_op(
    at_top(),
    printing(Map::new().insert(0, b"p0").insert(1, b"p1").insert(2, b"p2")),
    Some({ id: 3, ty: array, rep: RWord }),
    ArraySet({ laid: laid(no_ctors(), rec), stride: 2 }),
    [
      AVar({ id: 0, ty: array, rep: RWord }),
      AVar({ id: 1, ty: int, rep: RInt }),
      AVar({
        id: 2,
        ty: rec,
        rep: RFlat([{ name: b"s", rep: RWord }, { name: b"x", rep: RFloat }]),
      }),
    ],
    { takes: [true, false, true], owned: true, fails: true, stops: false },
  );
  let text = spelled(pr.out);
  let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  // A copy takes the head and every element's words, and its strings are counted where it copies
  // them.
  has(b") * 2); memcpy(ply_words(");
  has(b"rt_note_update_p(ctx, in_place, in_place ? 0 : ");
  // The string of the record replaced goes to its drop root, never to the runtime's; the float is bits.
  has(call_start(rel_fn(), [b"ctx", b"ply_words(t1)[(p1) * 2 + 1]"]));
  has(b"ply_words(t1)[(p1) * 2 + 2] = ply_f64_bits(");
  has(b"builtin_elaborated_refused_p(ctx, 5, p1, ")
}

test "a field of a Columns' record is read from its column in place, an index naming no record raising" {
  let float = float_type();
  let pr = container_op(
    at_top(),
    printing(Map::new().insert(0, b"p0").insert(1, b"p1")),
    Some({ id: 2, ty: float, rep: RFloat }),
    ColumnField({ k: 2, column: { laid: laid(no_ctors(), float), stride: 1 } }),
    [
      AVar({ id: 0, ty: columns_type(TyRecord([])), rep: RWord }),
      AVar({ id: 1, ty: int_type(), rep: RInt }),
    ],
    { takes: [false, false], owned: false, fails: true, stops: false },
  );
  let text = spelled(pr.out);
  let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  has(Bytes::concat_all([b"(uint64_t)p1 >= (uint64_t)", array_len(b"ply_words(p0)[2]")]));
  has(b"builtin_elaborated_refused_p(ctx, 6, p1, ");
  has(b"(ply_words(ply_words(p0)[2]) + 1 + (p1) * 1)[0]");
  assert_eq(text.index_of(b"rt_alloc"), None)
}
