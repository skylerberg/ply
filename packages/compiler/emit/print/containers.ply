//! Lists and arrays made, and the operations on a container's cells, printed.

import std.bytes (ascii_of_int)
import syntax.parsing (span_between)
import check.types (Type, TyCon, TyFn, TyRecord, Field, record_fields)
import emit.reps (laid, no_ctors)
import emit.typing (unknown_type)
import emit.layout (Intrinsic, OfList, OfMap, ListStart, TailLen, ListRoot, TailAt, NodeLen, LeafAt,
                    KidAt, TailPush, TailSet, LeafSet, RootSwap, KidSwap, TailStart, Spill,
                    NewBranch, MapRoot, NodeCount, MapHeight, NodeKey, NodeValue, NodeKid, KidMax,
                    KidSize, NewLeaf, NewMapBranch, PairPut, PairSet, PairTake, LeafCut, BranchCut,
                    KidOut, KidBack, KidPut, KidDrop, MapSwap, layouts, header_bytes, words)
import emit.roots (builtin_helper)
import emit.keys (Root, Copy)
import emit.answer (CallAt)
import emit.release (root_of, laid_parts, form_parts)
import emit.pieces (Piece, Text, Hole, Symbol, ShapeOf, spelled)
import emit.tir (Rep, RInt, RBool, RNum, RFloat, RDec, RWord, RFlat, RSum, Leaf, Var, Arg, AVar,
                 AInt, AZero, Made, MList, Uses, Containers, Convention, Given, Owned, counted,
                 var_said, made_said, rep_of_arg, in_box)
import emit.tir.statics (array_kind, columns_kind, flat_flag)
import emit.tir.containers (ContainerOp, Laid, Length, Elements, Within, ArrayNew, ArraySet,
                            ArrayOfList, ArrayGet, ColumnsNew, ColumnsSet, ColumnsOfList,
                            ColumnsGet, ColumnField, ColumnOf, ItemAt, Rest, LeafOf, Room, Position,
                            Taken, Element)
import emit.print.text (Printing, Place, printing, line, pad, pieces, temp, named, name_of,
                        arg_text, assigned, site, check, shape_at, zero, part_names, unprinted)
import emit.lower.held (leaf_span, leaves_within, leaf_values, values_of, held_with)
import emit.print.made (c_type, c_types, as_word, word_as, word_parts, head_types, arg_parts,
                        words_laid, parts_read)
import emit.print.counts (Said, released, duped, let_go_of, dup_of)
import emit.print.lists (item_read, leaf_read, rest_made, list_made)
import emit.print.strings (taken_printed)
import emit.print.invoked (typed_callee, convention_of)
import emit.print.head (writable_fn)
import emit.print.counting (dup_fn, rel_fn, free_fn, inc_fn, dec_fn, call_text, call_start, calls,
                            counts_any)

/// A list made of `m.args`, words it takes.
pub fn contained(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  m: { made: Made, args: List<Arg>, reuse: Option<Var> },
) -> Printing / {abort.raise} =
  match m.made {
    MList(_) -> match into {
      Some(v) -> {
        let n = named(pr, v);
        list_made(n.pr, p.depth, n.name, m.args.map(|a: Arg| arg_text(pr, a)))
      },
      None -> unprinted(Containers, b"a list made that nothing holds", made_said(m.made)),
    },
    other -> unprinted(Containers, b"a value made other than a list", made_said(other)),
  }

/// Operation `op` on a container's cells over `args`.
pub fn container_op(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  op: ContainerOp,
  args: List<Arg>,
  uses: Uses,
) -> Printing / {abort.raise} = {
  let object = operand(pr, args, 0);
  let index = operand(pr, args, 1);
  match into {
    None ->
      unprinted(
        Containers,
        b"a container's operation whose answer goes unread",
        Bytes::concat_all([ascii_of_int(args.len()), b" operands"]),
      ),
    Some(v) -> match op {
      Length ->
        assigned(
          site(p, pr),
          p.depth,
          v,
          c_type(v.rep),
          Bytes::concat_all([b"(int64_t)ply_obj(", object, b")->len"]),
        ),
      Elements ->
        assigned(
          site(p, pr),
          p.depth,
          v,
          c_type(v.rep),
          Bytes::concat_all([b"ply_array_len(", object, b")"]),
        ),
      Within ->
        assigned(
          pr,
          p.depth,
          v,
          c_type(v.rep),
          Bytes::concat_all([b"(uint64_t)", index, b" < (uint64_t)ply_array_len(", object, b")"]),
        ),
      Laid(i) -> laid_printed(p, pr, v, i, args),
      ArrayNew(e) -> array_new(p, pr, v, e, args),
      ArraySet(e) -> array_set(p, pr, v, e, args),
      ArrayOfList(e) -> array_of_list(p, pr, v, e, args),
      ArrayGet(e) -> array_get(p, pr, v, e, args),
      ColumnsNew(es) -> columns_new(p, pr, v, es, args),
      ColumnsSet(es) -> columns_set(p, pr, v, es, args),
      ColumnsOfList(es) -> columns_of_list(p, pr, v, es, args),
      ColumnsGet(es) -> columns_get(p, pr, v, es, args),
      ColumnField(c) -> column_printed(p, pr, v, c.k, c.column, args),
      ColumnOf(k) -> assigned(pr, p.depth, v, c_type(v.rep), slot_of(object, ascii_of_int(k))),
      ItemAt -> if v.rep == RWord {
        let n = named(pr, v);
        item_read(
          line(n.pr, p.depth, Bytes::concat_all([b"Word ", n.name, b";"])),
          p.depth,
          n.name,
          object,
          index,
        )
      } else {
        let w = temp(pr);
        let read = item_read(
          line(w.pr, p.depth, Bytes::concat_all([b"Word ", w.name, b";"])),
          p.depth,
          w.name,
          object,
          index,
        );
        assigned(read, p.depth, v, c_type(v.rep), word_as(w.name, v.rep))
      },
      LeafOf -> {
        let n = named(pr, v);
        leaf_read(
          line(n.pr, p.depth, Bytes::concat_all([c_type(v.rep), b" ", n.name, b";"])),
          p.depth,
          n.name,
          object,
          index,
        )
      },
      Room ->
        assigned(
          pr,
          p.depth,
          v,
          c_type(v.rep),
          Bytes::concat_all([b"rt_list_room_p(ctx, ", object, b")"]),
        ),
      Rest -> {
        let n = named(pr, v);
        rest_made(
          line(n.pr, p.depth, Bytes::concat_all([b"Word ", n.name, b";"])),
          p.depth,
          n.name,
          object,
          index,
          v.ty,
        )
      },
      Position -> position_printed(p, pr, v, args),
      Taken -> match args.at(0) {
        Some(n) -> taken_printed(p, pr, v, n),
        None ->
          unprinted(
            Containers,
            b"bytes taken out of the crossing buffer, none counted",
            var_said(v),
          ),
      },
    },
  }
}

/// Extern `op` written over the objects `layouts` lays out, answering into `v`. A read answers
/// what the object holds without a count of its own, an item as `v` holds it; a write takes the
/// object into `v`, made writable where another holds it too, and answers it.
fn laid_printed(
  p: Place,
  pr: Printing,
  v: Var,
  op: Intrinsic,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let laid = layouts();
  let o = operand(pr, args, 0);
  let i = operand(pr, args, 1);
  let raw = |e: Bytes| assigned(pr, p.depth, v, c_type(v.rep), e);
  // An item is a word in the object, read as the scalar it is where `v` holds one.
  let read = |slot: Bytes| raw(word_as(slot, v.rep));
  let header = |w: Bytes, field: Bytes| Bytes::concat_all([b"ply_obj(", w, b")->", field]);
  let header_int = |field: Bytes| raw(Bytes::concat_all([b"(int64_t)", header(o, field)]));
  let made = |kind: Int|
    assigned(
      pr,
      p.depth,
      v,
      c_type(v.rep),
      Bytes::concat_all([b"rt_node_p(ctx, ", ascii_of_int(kind), b")"]),
    );
  let held = assigned(pr, p.depth, v, c_type(v.rep), o);
  let a = name_of(held, v);
  let at = |k: Bytes| slot_of(a, k);
  let written = |text: Bytes| line(held, p.depth, text);
  // `a` held once before a write, the write counted where `copied` says how many words a copy took.
  let owned = |copied: Option<Bytes>| writable(held, p.depth, a, operand_type(args, 0), copied);
  let shifted = |from: Bytes, n: Bytes, by: Bytes|
    Bytes::concat_all([
      b"memmove(&",
      at(Bytes::concat_all([from, b" + ", by])),
      b", &",
      at(from),
      b", (size_t)(",
      n,
      b") * sizeof(Word)); ",
    ]);
  let tail = |k: Bytes| at(past(laid.list.tail, k));
  // A map's index is parenthesised where it is written into a larger index.
  let index = Bytes::concat_all([b"(", i, b")"]);
  let keys = |k: Bytes| past(laid.tree.keys, k);
  let sizes = |k: Bytes| past(laid.tree.sizes, k);
  let after = |less: Bytes|
    Bytes::concat_all([b"(int64_t)", header(a, b"len"), b" - ", index, less]);
  let pairs = Some(Bytes::concat_all([b"2 * (int64_t)", header(a, b"len")]));
  let node = operand_type(args, 0);
  // An item written over is let go of as the word form of its type is counted.
  let replaced = |q: Printing, slot: Bytes, x: Bytes, ty: Type| {
    let old = temp(q);
    let set = line(
      old.pr,
      p.depth,
      Bytes::concat_all([b"Word ", old.name, b" = ", slot, b"; ", slot, b" = ", x, b";"]),
    );
    said_line(let_go_of(set, form_parts(pr.ctors, ty), [old.name]), p.depth)
  };
  match op {
    OfList(ListStart) -> header_int(laid.list.start),
    OfList(TailLen) -> header_int(laid.list.tail_len),
    OfList(NodeLen) -> header_int(b"len"),
    // The slot holds the root as an `Option`'s payload's word, the node or zero.
    OfList(ListRoot) -> raw(slot_of(o, ascii_of_int(laid.list.root))),
    OfList(TailAt) -> read(slot_of(o, past(laid.list.tail, i))),
    OfList(LeafAt) -> read(slot_of(o, past(0, i))),
    OfList(KidAt) -> read(slot_of(o, past(0, i))),
    OfList(NewBranch) -> made(laid.trie.branch),
    OfList(TailPush) -> {
      let g = temp(held);
      let opened = line(
        g.pr,
        p.depth,
        Bytes::concat_all([
          b"{ int in_place = ",
          header(a, b"rc"),
          b" == 1; int64_t n = (int64_t)",
          header(a, laid.list.tail_len),
          b";",
        ]),
      );
      let copy = copied(opened, p.depth + 1, a, operand_type(args, 0));
      // A full tail moves into a block of twice the room, the list held once by then.
      let moved = Bytes::concat_all([
        b"if (n == (int64_t)",
        header(a, laid.list.room),
        b") { Word ",
        g.name,
        b" = rt_list_room_p(ctx, 2 * n); ",
        slot_of(g.name, ascii_of_int(laid.list.root)),
        b" = ",
        slot_of(a, ascii_of_int(laid.list.root)),
        b"; ",
        Bytes::concat_all(
          [laid.list.start, b"len", laid.list.tail_len].map(|f: Bytes|
            Bytes::concat_all([header(g.name, f), b" = ", header(a, f), b"; "])),
        ),
        b"memcpy(&",
        slot_of(g.name, ascii_of_int(laid.list.tail)),
        b", &",
        slot_of(a, ascii_of_int(laid.list.tail)),
        b", (size_t)n * sizeof(Word)); ",
        call_text(free_fn(), [
          b"ctx",
          a,
          ascii_of_int(header_bytes() + 8 * laid.list.tail).concat(b" + 8 * n"),
        ]),
        b"; ",
        a,
        b" = ",
        g.name,
        b"; }",
      ]);
      let grown = line(
        line(copy, p.depth + 1, moved),
        p.depth + 1,
        b"rt_note_update_p(ctx, in_place, in_place ? 0 : n); }",
      );
      line(
        grown,
        p.depth,
        Bytes::concat_all([
          tail(header(a, laid.list.tail_len)),
          b" = ",
          operand(pr, args, 1),
          b"; ",
          header(a, laid.list.tail_len),
          b" += 1; ",
          header(a, b"len"),
          b" += 1;",
        ]),
      )
    },
    OfList(TailStart) ->
      written(
        Bytes::concat_all([
          tail(b"0"),
          b" = ",
          operand(pr, args, 1),
          b"; ",
          header(a, laid.list.tail_len),
          b" = 1; ",
          header(a, b"len"),
          b" += 1;",
        ]),
      ),
    OfList(TailSet) ->
      replaced(
        owned(Some(header(a, laid.list.tail_len))),
        tail(i),
        operand(pr, args, 2),
        held_type(node),
      ),
    OfList(LeafSet) ->
      replaced(owned(Some(header(a, b"len"))), at(i), operand(pr, args, 2), held_type(node)),
    OfMap(MapRoot) -> raw(slot_of(o, ascii_of_int(laid.map.root))),
    OfMap(MapHeight) -> header_int(laid.map.height),
    OfMap(NodeCount) -> header_int(b"len"),
    OfMap(NodeKey) -> read(slot_of(o, Bytes::concat_all([b"2 * (", i, b")"]))),
    OfMap(NodeValue) -> read(slot_of(o, Bytes::concat_all([b"2 * (", i, b") + 1"]))),
    OfMap(NodeKid) -> read(slot_of(o, past(0, i))),
    OfMap(KidMax) -> read(slot_of(o, past(laid.tree.keys, i))),
    OfMap(KidSize) ->
      raw(Bytes::concat_all([b"ply_imm_value(", slot_of(o, past(laid.tree.sizes, i)), b")"])),
    OfMap(NewLeaf) -> made(laid.tree.leaf),
    OfMap(NewMapBranch) -> made(laid.tree.branch),
    OfMap(PairPut) -> {
      let pair = Bytes::concat_all([b"2 * ", index]);
      line(
        owned(pairs),
        p.depth,
        Bytes::concat_all([
          shifted(pair, Bytes::concat_all([b"2 * (", after(b""), b")"]), b"2"),
          at(pair),
          b" = ",
          operand(pr, args, 2),
          b"; ",
          at(pair.concat(b" + 1")),
          b" = ",
          operand(pr, args, 3),
          b"; ",
          header(a, b"len"),
          b" += 1;",
        ]),
      )
    },
    OfMap(PairSet) -> {
      let pair = Bytes::concat_all([b"2 * ", index]);
      let keyed = replaced(owned(pairs), at(pair), operand(pr, args, 2), type_arg(node, 0));
      replaced(keyed, at(pair.concat(b" + 1")), operand(pr, args, 3), type_arg(node, 1))
    },
    OfMap(KidBack) -> {
      let maxed = replaced(owned(None), at(keys(index)), operand(pr, args, 3), type_arg(node, 0));
      line(
        maxed,
        p.depth,
        Bytes::concat_all([
          at(index),
          b" = ",
          operand(pr, args, 2),
          b"; ",
          at(sizes(index)),
          b" = ply_imm(",
          operand(pr, args, 4),
          b");",
        ]),
      )
    },
    OfMap(KidPut) -> {
      let n = after(b"");
      line(
        owned(None),
        p.depth,
        Bytes::concat_all([
          shifted(index, n, b"1"),
          shifted(keys(index), n, b"1"),
          shifted(sizes(index), n, b"1"),
          at(index),
          b" = ",
          operand(pr, args, 2),
          b"; ",
          at(keys(index)),
          b" = ",
          operand(pr, args, 3),
          b"; ",
          at(sizes(index)),
          b" = ply_imm(",
          operand(pr, args, 4),
          b"); ",
          header(a, b"len"),
          b" += 1;",
        ]),
      )
    },
    OfMap(KidDrop) -> {
      let n = after(b" - 1");
      let next = index.concat(b" + 1");
      // The kid dropped goes to its node's drop, the greatest key under it as its type counts it.
      let kid = said_line(released(owned(None), node, RWord, [at(index)]), p.depth);
      let key = said_line(
        let_go_of(kid, form_parts(pr.ctors, type_arg(node, 0)), [at(keys(index))]),
        p.depth,
      );
      line(
        key,
        p.depth,
        Bytes::concat_all([
          shifted(next, n, b"-1"),
          shifted(keys(next), n, b"-1"),
          shifted(sizes(next), n, b"-1"),
          header(a, b"len"),
          b" -= 1;",
        ]),
      )
    },
    _ -> record_printed(p, pr, v, op, args),
  }
}

/// A word an extern answering a record sets field `name` from, and whether it is an item, read as
/// the record holds the field's type, or a word held as the field already is.
type Answered = { name: Bytes, word: Bytes, item: Bool }

/// Extern `op`, which answers a record of what it wrote and what it took out, into `v`, held as the
/// record's fields: the object it takes written in a temporary of its own, made writable where
/// another holds it too, and each field set from the word that holds it, the record's word none.
fn record_printed(
  p: Place,
  pr: Printing,
  v: Var,
  op: Intrinsic,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let laid = layouts();
  let d = p.depth;
  let held = temp(pr);
  let a = held.name;
  let i = operand(pr, args, 1);
  let index = Bytes::concat_all([b"(", i, b")"]);
  let header = |field: Bytes| Bytes::concat_all([b"ply_obj(", a, b")->", field]);
  let at = |k: Bytes| slot_of(a, k);
  // Every one of them writes the object, held once first; a spill and a pair taken out count it.
  let started = writable(
    line(held.pr, d, Bytes::concat_all([b"Word ", a, b" = ", operand(pr, args, 0), b";"])),
    d,
    a,
    operand_type(args, 0),
    match op {
      OfList(Spill) -> Some(header(laid.list.tail_len)),
      OfMap(PairTake) -> Some(Bytes::concat_all([b"2 * (int64_t)", header(b"len")])),
      _ -> None,
    },
  );
  let whole = |name: Bytes, word: Bytes| { name: name, word: word, item: false };
  // A word taken out of the object, and the record set from it and the object.
  let took = |text: (Bytes) -> Bytes, fields: (Bytes) -> List<Answered>| {
    let t = temp(started);
    fields_set(p, line(t.pr, d, text(t.name)), v, fields(t.name))
  };
  let cut = |kind: Int, runs: List<{ from: Int, width: Int }>|
    took(
      |r: Bytes| {
        let rest = Bytes::concat_all([b"((int64_t)", header(b"len"), b" - ", index, b")"]);
        Bytes::concat_all([
          b"Word ",
          r,
          b" = rt_node_p(ctx, ",
          ascii_of_int(kind),
          b"); ",
          Bytes::concat_all(
            runs.map(|run: { from: Int, width: Int }|
              Bytes::concat_all([
                b"memcpy(&",
                slot_of(r, ascii_of_int(run.from)),
                b", &",
                at(
                  Bytes::concat_all([
                    ascii_of_int(run.from),
                    b" + ",
                    ascii_of_int(run.width),
                    b" * ",
                    index,
                  ]),
                ),
                b", (size_t)(",
                ascii_of_int(run.width),
                b" * ",
                rest,
                b") * sizeof(Word)); ",
              ])),
          ),
          b"ply_obj(",
          r,
          b")->len = (uint32_t)",
          rest,
          b"; ",
          header(b"len"),
          b" = (uint32_t)",
          index,
          b";",
        ])
      },
      |r: Bytes| [whole(b"left", a), whole(b"right", r)],
    );
  match op {
    OfList(RootSwap) -> {
      let root = at(ascii_of_int(laid.list.root));
      took(
        |old: Bytes| Bytes::concat_all([b"Word ", old, b" = ", root, b"; ", root, b" = ", i, b";"]),
        |old: Bytes| [whole(b"list", a), whole(b"old", old)],
      )
    },
    OfList(KidSwap) ->
      took(
        |old: Bytes|
          Bytes::concat_all([
            b"Word ",
            old,
            b" = 0; if (",
            i,
            b" < (int64_t)",
            header(b"len"),
            b") ",
            old,
            b" = ",
            at(i),
            b"; else ",
            header(b"len"),
            b" = (uint32_t)(",
            i,
            b") + 1; ",
            at(i),
            b" = ",
            operand(pr, args, 2),
            b";",
          ]),
        |old: Bytes| [whole(b"node", a), whole(b"old", old)],
      ),
    OfList(Spill) -> {
      let width = ascii_of_int(laid.trie.width);
      took(
        |leaf: Bytes|
          Bytes::concat_all([
            b"Word ",
            leaf,
            b" = rt_node_p(ctx, ",
            ascii_of_int(laid.trie.leaf),
            b"); memcpy(ply_words(",
            leaf,
            b"), &",
            at(past(laid.list.tail, b"0")),
            b", ",
            width,
            b" * sizeof(Word)); ply_obj(",
            leaf,
            b")->len = ",
            width,
            b"; ",
            header(laid.list.tail_len),
            b" = 0;",
          ]),
        |leaf: Bytes| [whole(b"leaf", leaf), whole(b"list", a)],
      )
    },
    OfMap(PairTake) -> {
      let pair = Bytes::concat_all([b"2 * ", index]);
      let key = temp(started);
      let value = temp(key.pr);
      let taken = line(
        value.pr,
        d,
        Bytes::concat_all([
          b"Word ",
          key.name,
          b" = ",
          at(pair),
          b"; Word ",
          value.name,
          b" = ",
          at(pair.concat(b" + 1")),
          b"; memmove(&",
          at(Bytes::concat_all([pair, b" + 2 + -2"])),
          b", &",
          at(Bytes::concat_all([pair, b" + 2"])),
          b", (size_t)(2 * ((int64_t)",
          header(b"len"),
          b" - ",
          index,
          b" - 1)) * sizeof(Word)); ",
          header(b"len"),
          b" -= 1;",
        ]),
      );
      fields_set(p, taken, v, [
        { name: b"key", word: key.name, item: true },
        whole(b"node", a),
        { name: b"value", word: value.name, item: true },
      ])
    },
    OfMap(LeafCut) -> cut(laid.tree.leaf, [{ from: 0, width: 2 }]),
    OfMap(BranchCut) ->
      cut(laid.tree.branch, [
        { from: 0, width: 1 },
        { from: laid.tree.keys, width: 1 },
        { from: laid.tree.sizes, width: 1 },
      ]),
    OfMap(KidOut) ->
      took(
        |kid: Bytes|
          Bytes::concat_all([b"Word ", kid, b" = ", at(index), b"; ", at(index), b" = 0;"]),
        |kid: Bytes| [whole(b"kid", kid), whole(b"node", a)],
      ),
    OfMap(MapSwap) -> {
      let root = at(ascii_of_int(laid.map.root));
      took(
        |old: Bytes|
          Bytes::concat_all([
            b"Word ",
            old,
            b" = ",
            root,
            b"; ",
            root,
            b" = ",
            i,
            b"; ",
            header(laid.map.height),
            b" = (uint32_t)(",
            operand(pr, args, 2),
            b"); ",
            header(b"len"),
            b" = (uint32_t)(",
            operand(pr, args, 3),
            b");",
          ]),
        |old: Bytes| [whole(b"map", a), whole(b"old", old)],
      )
    },
    _ ->
      unprinted(
        Containers,
        b"an extern answering no record, printed as one that does",
        Bytes::concat_all([b"into ", var_said(v), b" of ", ascii_of_int(args.len()), b" operands"]),
      ),
  }
}

/// `v`, a record held as its fields, each set from the word `fields` names for it: an item read as
/// the field holds it, its word let go where a scalar is read out of it; a record or a sum wider than
/// a word opened out of that word, its word form, which it takes.
fn fields_set(p: Place, pr: Printing, v: Var, fields: List<Answered>) -> Printing / {abort.raise} = {
  let n = named(pr, v);
  let ns = part_names(n.name, v.rep);
  let ls = match v.rep { RFlat(x) -> x, _ -> [] };
  fields.fold(n.pr, |q: Printing, x: Answered|
    match leaf_span(ls, x.name) {
      None -> q,
      Some(sp) -> {
        let one = match ls.at(sp.at) {
          Some(l) -> if sp.n == 1 && l.name == x.name { Some(l.rep) } else { None },
          None -> None,
        };
        let r = match one { Some(lr) -> lr, None -> RFlat(leaves_within(ls, sp)) };
        let first = leaf_values(ls, sp.at).at;
        let mine = ns.drop(first).take(values_of(r).len());
        if in_box(r) {
          pieces(q, [Text(pad(p.depth))].concat(word_parts(x.word, r, mine)).push(Text(b"\n")))
        } else {
          // A sum's word form is the sum itself, whatever it counts.
          let value = if !x.item { x.word }
          else if counted(r) || (match r { RSum(_) -> true, _ -> false }) { word_as(x.word, r) }
          else {
            Bytes::concat_all([word_as(x.word, r), b"; ", call_text(dec_fn(), [b"ctx", x.word])])
          };
          line(q, p.depth, Bytes::concat_all([c_type(r), b" ", nth(mine, 0), b" = ", value, b";"]))
        }
      },
    })
}

fn nth(xs: List<Bytes>, k: Int) -> Bytes = match xs.at(k) { Some(x) -> x, None -> b"" }

fn slot_of(w: Bytes, at: Bytes) -> Bytes = Bytes::concat_all([b"ply_words(", w, b")[", at, b"]"])

/// `at` words past the word `from`, as C reads it.
fn past(from: Int, at: Bytes) -> Bytes = Bytes::concat_all([ascii_of_int(from), b" + (", at, b")"])

/// The line written ahead of a write of the object `a`, of type `ty`: `a` held once, copied by the
/// root written for its type where another holds it too, and where `counted` says how many words a
/// copy takes, the write counted as in place or of a copy of those.
fn writable(pr: Printing, depth: Int, a: Bytes, ty: Type, counted: Option<Bytes>) -> Printing = {
  let c = copy_called(pr, a, ty);
  match counted {
    None ->
      pieces(
        c.pr,
        [Text(Bytes::concat_all([pad(depth), b"if (ply_obj(", a, b")->rc != 1) "]))].concat(
          c.out,
        ).push(
          Text(b"\n"),
        ),
      ),
    Some(n) ->
      pieces(c.pr, [
        Text(Bytes::concat_all([pad(depth), a, b" = ", writable_fn(), b"(ctx, ", a, b", "])),
        Hole(Symbol(Root(root_of(Copy, ty)))),
        Text(Bytes::concat_all([b", ", n, b");\n"])),
      ]),
  }
}

/// The line copying `a`, of type `ty`, by the root written for its type where the C local
/// `in_place`, which the line's block declares, says another holds it too.
fn copied(pr: Printing, depth: Int, a: Bytes, ty: Type) -> Printing = {
  let c = copy_called(pr, a, ty);
  pieces(c.pr, [Text(pad(depth).concat(b"if (!in_place) "))].concat(c.out).push(Text(b"\n")))
}

/// `a = copy(ctx, a);`, the copy the root written to copy a block of type `ty`, which takes the block
/// and answers a copy held once, noted among the root's calls with the head it is called at.
fn copy_called(pr: Printing, a: Bytes, ty: Type) -> { pr: Printing, out: List<Piece> } = {
  let k = root_of(Copy, ty);
  {
    pr: if pr.calls.contains(k) { pr } else {
      {
        ..pr,
        calls: pr.calls.push(k),
        expects: pr.expects.push({
          callee: CallAt(pr.calls.len()),
          head: head_types({ params: [Given], reps: [RWord], answer: RWord, answered: Owned }),
        }),
      }
    },
    out: [
      Text(Bytes::concat_all([a, b" = "])),
      Hole(Symbol(Root(k))),
      Text(Bytes::concat_all([b"(ctx, ", a, b");"])),
    ],
  }
}

/// The type of operand `k`, unknown where it is no variable.
fn operand_type(args: List<Arg>, k: Int) -> Type =
  match args.at(k) { Some(AVar(x)) -> x.ty, _ -> unknown_type() }

/// `Array::new(n, x)` into `v`: `n` elements laid out as `e` says, each `x`, which it takes and
/// counts once more for each element past the first, or lets go of where there is none. A length
/// below zero or past what an array holds raises, `x` let go of.
fn array_new(
  p: Place,
  pr: Printing,
  v: Var,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = held_type(v.ty);
  let n = operand(pr, args, 0);
  let x = operand_arg(args, 1);
  let xs = arg_parts(pr, x);
  let r = rep_of_arg(x);
  let d = p.depth;
  let started = assigned(site(p, pr), d, v, c_type(v.rep), b"0");
  let a = name_of(started, v);
  let opened = line(
    started,
    d,
    Bytes::concat_all([b"if (", n, b" < 0 || ", n, b" > ", ascii_of_int(most(e)), b") {"]),
  );
  let raised = line(said_line(released(opened, ty, r, xs), d + 1), d + 1, refused(0, n, b"0"));
  let made = line(line(raised, d, b"} else {"), d + 1, array_alloc(a, n, e));
  let i = temp(made);
  let counted = copies_counted(i.pr, d + 1, n, i.name, ty, r, xs);
  let filled = line(
    counted,
    d + 1,
    Bytes::concat_all([
      for_each(i.name, b"0", n),
      element_set(a, i.name, e, words_laid(xs, values_of(r))),
      b" }",
    ]),
  );
  check(p, line(filled, d, b"}"))
}

/// The C counting the value `xs`, of type `ty` held as `r`, once for each of `n` holders past the
/// first, and letting it go where `n` is none, a loop over `i`.
fn copies_counted(
  pr: Printing,
  depth: Int,
  n: Bytes,
  i: Bytes,
  ty: Type,
  r: Rep,
  xs: List<Bytes>,
) -> Printing / {abort.raise} = {
  let dups = duped(pr, ty, r, xs);
  let none = released(dups.pr, ty, r, xs);
  if dups.out.len() == 0 { none.pr } else {
    pieces(
      none.pr,
      [Text(Bytes::concat_all([pad(depth), b"if (", n, b" == 0) { "]))].concat(none.out).push(
        Text(Bytes::concat_all([b" } else { ", for_each(i, b"1", n)])),
      ).concat(
        dups.out,
      ).push(
        Text(b" } }\n"),
      ),
    )
  }
}

/// `Array::set(xs, i, x)` into `v`: written in place where `xs` is held once and into a copy
/// otherwise, each element of which is counted once more and `xs` let go of; the element it
/// replaces is let go of by its type. Takes `xs` and `x`; an index out of range raises, both let go
/// of.
fn array_set(
  p: Place,
  pr: Printing,
  v: Var,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = held_type(v.ty);
  let i = operand(pr, args, 1);
  let x = operand_arg(args, 2);
  let xs = arg_parts(pr, x);
  let r = rep_of_arg(x);
  let d = p.depth;
  let started = assigned(site(p, pr), d, v, c_type(v.rep), operand(pr, args, 0));
  let a = name_of(started, v);
  let n = temp(started);
  let opened = line(
    line(n.pr, d, Bytes::concat_all([b"int64_t ", n.name, b" = ply_array_len(", a, b");"])),
    d,
    Bytes::concat_all([b"if ((uint64_t)", i, b" >= (uint64_t)", n.name, b") {"]),
  );
  let x_go = said_line(released(opened, ty, r, xs), d + 1);
  let raised = line(
    said_line(released(x_go, v.ty, RWord, [a]), d + 1),
    d + 1,
    Bytes::concat_all([a, b" = 0; ", refused(5, i, n.name)]),
  );
  let writable = array_writable(line(raised, d, b"} else {"), d + 1, a, n.name, e, v.ty);
  let replaced = let_go_of(writable, laid_parts(pr.ctors, ty, e.laid, 0), element_slots(a, i, e));
  let written = line(
    said_line(replaced, d + 1),
    d + 1,
    element_set(a, i, e, words_laid(xs, values_of(r))),
  );
  check(p, line(written, d, b"}"))
}

/// The lines making the array `a`, of type `ty`, of `n` elements laid out as `e`, held once: copied
/// where another holds it too, each element of the copy counted once more and `a` let go of, and
/// the write counted as in place or of a copy of `n`.
fn array_writable(
  pr: Printing,
  depth: Int,
  a: Bytes,
  n: Bytes,
  e: Element,
  ty: Type,
) -> Printing / {abort.raise} = {
  let c = temp(pr);
  let j = temp(c.pr);
  let dups = dup_of(
    laid_parts(pr.ctors, held_type(ty), e.laid, 0),
    element_slots(c.name, j.name, e),
  );
  let old = released(j.pr, ty, RWord, [a]);
  let copied = pieces(
    old.pr,
    [
      Text(
        Bytes::concat_all([
          pad(depth),
          b"int in_place = ply_obj(",
          a,
          b")->rc == 1;\n",
          pad(depth),
          b"if (!in_place) { Word ",
          c.name,
          b" = ",
          allocated(array_kind(), Bytes::concat_all([b"ply_obj(", a, b")->len"])),
          b"; ply_obj(",
          c.name,
          b")->aux = ply_obj(",
          a,
          b")->aux; memcpy(ply_words(",
          c.name,
          b"), ply_words(",
          a,
          b"), (size_t)ply_obj(",
          a,
          b")->len * 8); ",
          if dups.len() == 0 { b"" }
          else { Bytes::concat_all([for_each(j.name, b"0", n), dups, b" } "]) },
        ]),
      ),
    ].concat(
      old.out,
    ).push(
      Text(Bytes::concat_all([b" ", a, b" = ", c.name, b"; }\n"])),
    ),
  );
  line(
    copied,
    depth,
    Bytes::concat_all([b"rt_note_update_p(ctx, in_place, in_place ? 0 : ", n, b");"]),
  )
}

/// `Array::of_list(xs)` into `v`: each item of the list, borrowed as the word a list holds it as,
/// counted once more and written as the array lays out an element, and the list let go of. Takes
/// `xs`; a list longer than an array holds raises.
fn array_of_list(
  p: Place,
  pr: Printing,
  v: Var,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = held_type(v.ty);
  let l = operand(pr, args, 0);
  let listed = TyCon({ name: b"List", args: [ty] });
  let d = p.depth;
  let count = temp(site(p, pr));
  let n = count.name;
  let started = assigned(
    line(count.pr, d, Bytes::concat_all([b"int64_t ", n, b" = (int64_t)ply_obj(", l, b")->len;"])),
    d,
    v,
    c_type(v.rep),
    b"0",
  );
  let a = name_of(started, v);
  let opened = line(
    started,
    d,
    Bytes::concat_all([b"if (", n, b" > ", ascii_of_int(most(e)), b") {"]),
  );
  let raised = line(
    said_line(released(opened, listed, RWord, [l]), d + 1),
    d + 1,
    refused(2, n, b"0"),
  );
  let made = line(line(raised, d, b"} else {"), d + 1, array_alloc(a, n, e));
  let i = temp(made);
  let item = items_held(i.pr, d + 1, l, n, i.name, ty);
  let stored = line(
    item.pr,
    d + 2,
    element_set(a, i.name, e, words_laid(item.values, values_of(item.rep))),
  );
  let released_list = released(line(stored, d + 1, b"}"), listed, RWord, [l]);
  check(p, line(said_line(released_list, d + 1), d, b"}"))
}

/// The C opening a loop over the `n` items of the list `l`, each item of type `ty` read as the
/// word the list holds it as, counted once more and taken into the C values `values`, held as `rep`,
/// for the loop's body, which the caller writes at `depth + 1` and closes.
fn items_held(
  pr: Printing,
  depth: Int,
  l: Bytes,
  n: Bytes,
  i: Bytes,
  ty: Type,
) -> { pr: Printing, values: List<Bytes>, rep: Rep } / {abort.raise} = {
  let rep = held_with(pr.ctors, ty);
  let w = temp(pr);
  let x = temp(w.pr);
  let names = part_names(x.name, rep);
  let opened = line(x.pr, depth, Bytes::concat_all([for_each(i, b"0", n), b"Word ", w.name, b";"]));
  let read = item_read(opened, depth + 1, w.name, l, i);
  let dup = dup_of(form_parts(pr.ctors, ty), [w.name]);
  let counted = if dup.len() == 0 { read } else { line(read, depth + 1, dup) };
  {
    pr: pieces(
      counted,
      [Text(pad(depth + 1))].concat(word_parts(w.name, rep, names)).push(Text(b"\n")),
    ),
    values: names,
    rep: rep,
  }
}

/// `Array::get(xs, i)` into `v`: element `i` read as `v` holds it, borrowed from the array. An index
/// out of range raises.
fn array_get(
  p: Place,
  pr: Printing,
  v: Var,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let a = operand(pr, args, 0);
  let i = operand(pr, args, 1);
  parts_declared(p, outside_refused(p, pr, 4, a, i), v, element_values(a, i, e, v.rep))
}

/// The line raising, as builtin `what` does, where `i` names no element of the array `a`.
fn outside_refused(
  p: Place,
  pr: Printing,
  what: Int,
  a: Bytes,
  i: Bytes,
) -> Printing / {abort.raise} = {
  let length = Bytes::concat_all([b"ply_array_len(", a, b")"]);
  line(
    site(p, pr),
    p.depth,
    Bytes::concat_all([
      b"if ((uint64_t)",
      i,
      b" >= (uint64_t)",
      length,
      b") { ",
      refused(what, i, length),
      b" ",
      p.leave,
      b" }",
    ]),
  )
}

/// `Bytes::position(b, from, f)` into `v` as a loop in the body: the first index from `from` whose
/// byte `f` holds of, `-1` where it holds of none. Bytes of another kind or a start past their end
/// are the runtime's call to refuse, handed `b` once more and no function; `f` is called by its type,
/// which takes it, so each call is handed a count of its own. Reads `b` and `f`.
fn position_printed(p: Place, pr: Printing, v: Var, args: List<Arg>) -> Printing / {abort.raise} = {
  let b = operand(pr, args, 0);
  let from = operand(pr, args, 1);
  let f = operand(pr, args, 2);
  let d = p.depth;
  let guarded = line(
    site(p, pr),
    d,
    Bytes::concat_all([
      b"if (ply_is_imm(",
      b,
      b") || ply_obj(",
      b,
      b")->kind != 10 || (uint64_t)",
      from,
      b" > (uint64_t)ply_obj(",
      b,
      b")->len) { ",
      call_text(inc_fn(), [b]),
      b"; ",
      builtin_helper(b"Bytes::position"),
      b"_p(ctx, ",
      b,
      b", ",
      as_word(from, RInt),
      b", 0); ",
      p.leave,
      b" }",
    ]),
  );
  let found = assigned(guarded, d, v, c_type(v.rep), b"-1");
  let n = name_of(found, v);
  let i = temp(found);
  let opened = line(
    i.pr,
    d,
    Bytes::concat_all([
      b"for (int64_t ",
      i.name,
      b" = ",
      from,
      b"; ",
      i.name,
      b" < (int64_t)ply_obj(",
      b,
      b")->len; ",
      i.name,
      b" += 1) {",
    ]),
  );
  let conv = predicate_convention(pr, args);
  let called = temp(opened);
  let inside = { ..p, depth: d + 1 };
  let asked = line(
    site(inside, called.pr),
    d + 1,
    Bytes::concat_all([
      call_text(inc_fn(), [f]),
      b"; ",
      c_type(conv.answer),
      b" ",
      called.name,
      b" = ",
      typed_callee(f, conv),
      b"(ctx, ",
      f,
      b", (int64_t)(ply_bytes(",
      b,
      b"))[",
      i.name,
      b"]);",
    ]),
  );
  let hit = line(
    check(inside, asked),
    d + 1,
    Bytes::concat_all([b"if (", called.name, b") { ", n, b" = ", i.name, b"; break; }"]),
  );
  line(hit, d, b"}")
}

/// The convention `Bytes::position`'s predicate, its third operand, is called at by its type: an
/// `Int` in and a `Bool` out, as the builtin's signature says.
fn predicate_convention(pr: Printing, args: List<Arg>) -> Convention / {abort.raise} =
  match args.at(2) {
    Some(AVar(v)) -> match v.ty {
      TyFn(t) -> {
        let c = convention_of(pr.ctors, { params: t.params, ret: t.ret });
        if c.reps == [RInt] && c.answer == RBool { c } else {
          unprinted(
            Containers,
            b"a byte string's position whose predicate is held otherwise",
            var_said(v),
          )
        }
      },
      _ -> unprinted(Containers, b"a byte string's position on no function", var_said(v)),
    },
    _ ->
      unprinted(Containers, b"a byte string's position on no predicate", ascii_of_int(args.len())),
  }

/// Field `k` of record `i` of the `Columns` `xs` into `v`: element `i` of the field's column, read
/// as `v` holds it, borrowed. An index naming no record raises as `Columns::get` does.
fn column_printed(
  p: Place,
  pr: Printing,
  v: Var,
  k: Int,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let column = slot_of(operand(pr, args, 0), ascii_of_int(k));
  let i = operand(pr, args, 1);
  parts_declared(p, outside_refused(p, pr, 6, column, i), v, element_values(column, i, e, v.rep))
}

/// `Columns::new(n, x)` into `v`: a column per field of `x`, each of `n` elements laid out as its
/// element in `es` says, each the field; `x` taken, counted once more for each record past the
/// first, or let go of where there is none. A length below zero or past what a column holds raises,
/// `x` let go of.
fn columns_new(
  p: Place,
  pr: Printing,
  v: Var,
  es: List<Element>,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = held_type(v.ty);
  let n = operand(pr, args, 0);
  let x = operand_arg(args, 1);
  let xs = arg_parts(pr, x);
  let r = rep_of_arg(x);
  let ws = words_laid(xs, values_of(r));
  let d = p.depth;
  let started = assigned(site(p, pr), d, v, c_type(v.rep), b"0");
  let c = name_of(started, v);
  let opened = line(
    started,
    d,
    Bytes::concat_all([b"if (", n, b" < 0 || ", n, b" > ", ascii_of_int(most_of(es)), b") {"]),
  );
  let raised = line(said_line(released(opened, ty, r, xs), d + 1), d + 1, refused(1, n, b"0"));
  let made = line(line(raised, d, b"} else {"), d + 1, columns_alloc(c, es.len()));
  let i = temp(made);
  let filled = range(0, es.len()).fold(i.pr, |q: Printing, f: Int| {
    let e = es.get(f);
    let col = temp(q);
    line(
      line(
        col.pr,
        d + 1,
        Bytes::concat_all([
          b"Word ",
          col.name,
          b"; ",
          array_alloc(col.name, n, e),
          b" ",
          slot_of(c, ascii_of_int(f)),
          b" = ",
          col.name,
          b";",
        ]),
      ),
      d + 1,
      Bytes::concat_all([
        for_each(i.name, b"0", n),
        element_set(col.name, i.name, e, field_words(ws, es, f)),
        b" }",
      ]),
    )
  });
  check(p, line(copies_counted(filled, d + 1, n, i.name, ty, r, xs), d, b"}"))
}

/// `Columns::of_list(xs)` into `v`: a column per field of the list's records, each of as many
/// elements as the list has items laid out as its element in `es` says. Each item, borrowed as the
/// word a list holds it as, is counted once more and its fields written into their columns, and the
/// list is let go of. Takes `xs`; a list longer than a column holds raises.
fn columns_of_list(
  p: Place,
  pr: Printing,
  v: Var,
  es: List<Element>,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = held_type(v.ty);
  let l = operand(pr, args, 0);
  let listed = TyCon({ name: b"List", args: [ty] });
  let d = p.depth;
  let count = temp(site(p, pr));
  let n = count.name;
  let started = assigned(
    line(count.pr, d, Bytes::concat_all([b"int64_t ", n, b" = (int64_t)ply_obj(", l, b")->len;"])),
    d,
    v,
    c_type(v.rep),
    b"0",
  );
  let c = name_of(started, v);
  let opened = line(
    started,
    d,
    Bytes::concat_all([b"if (", n, b" > ", ascii_of_int(most_of(es)), b") {"]),
  );
  let raised = line(
    said_line(released(opened, listed, RWord, [l]), d + 1),
    d + 1,
    refused(3, n, b"0"),
  );
  let made = line(line(raised, d, b"} else {"), d + 1, columns_alloc(c, es.len()));
  let cols = range(0, es.len()).fold(
    { pr: made, names: [] },
    |acc: { pr: Printing, names: List<Bytes> }, f: Int| {
      let col = temp(acc.pr);
      {
        pr: line(
          col.pr,
          d + 1,
          Bytes::concat_all([
            b"Word ",
            col.name,
            b"; ",
            array_alloc(col.name, n, es.get(f)),
            b" ",
            slot_of(c, ascii_of_int(f)),
            b" = ",
            col.name,
            b";",
          ]),
        ),
        names: acc.names.push(col.name),
      }
    },
  );
  let i = temp(cols.pr);
  let item = items_held(i.pr, d + 1, l, n, i.name, ty);
  let ws = words_laid(item.values, values_of(item.rep));
  let stored = range(0, es.len()).fold(item.pr, |q: Printing, f: Int|
    line(q, d + 2, element_set(cols.names.get(f), i.name, es.get(f), field_words(ws, es, f))));
  let released_list = released(line(stored, d + 1, b"}"), listed, RWord, [l]);
  check(p, line(said_line(released_list, d + 1), d, b"}"))
}

/// `Columns::get(xs, i)` into `v`: record `i`, each field read out of its column, borrowed. An index
/// naming no record raises.
fn columns_get(
  p: Place,
  pr: Printing,
  v: Var,
  es: List<Element>,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let c = operand(pr, args, 0);
  let i = operand(pr, args, 1);
  let tested = outside_refused(p, pr, 6, slot_of(c, b"0"), i);
  let ws = range(0, es.len()).fold([], |acc: List<Bytes>, f: Int| {
    let e = es.get(f);
    acc.concat(element_slots(slot_of(c, ascii_of_int(f)), i, e).take(words(e.laid)))
  });
  let record = temp(tested);
  let held = line(
    record.pr,
    p.depth,
    Bytes::concat_all([
      b"Word ",
      record.name,
      b"[",
      ascii_of_int(max(1, ws.len())),
      b"] = {",
      if ws.len() == 0 { b"0" } else { Bytes::join(ws, b", ") },
      b"};",
    ]),
  );
  parts_declared(p, held, v, parts_read(record.name, values_of(v.rep)))
}

/// `Columns::set(xs, i, x)` into `v`: the `Columns` held once, copied where another holds it too
/// with each column counted once more and `xs` let go of; then each field written into its column
/// as `Array::set` writes an element, the element it replaces let go of by its type. Takes `xs`
/// and `x`; an index naming no record raises, both let go of.
fn columns_set(
  p: Place,
  pr: Printing,
  v: Var,
  es: List<Element>,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = held_type(v.ty);
  let fields = field_types(ty);
  let i = operand(pr, args, 1);
  let x = operand_arg(args, 2);
  let xs = arg_parts(pr, x);
  let r = rep_of_arg(x);
  let ws = words_laid(xs, values_of(r));
  let d = p.depth;
  let started = assigned(site(p, pr), d, v, c_type(v.rep), operand(pr, args, 0));
  let c = name_of(started, v);
  let n = temp(started);
  let opened = line(
    line(
      n.pr,
      d,
      Bytes::concat_all([b"int64_t ", n.name, b" = ply_array_len(", slot_of(c, b"0"), b");"]),
    ),
    d,
    Bytes::concat_all([b"if ((uint64_t)", i, b" >= (uint64_t)", n.name, b") {"]),
  );
  let x_go = said_line(released(opened, ty, r, xs), d + 1);
  let raised = line(
    said_line(released(x_go, v.ty, RWord, [c]), d + 1),
    d + 1,
    Bytes::concat_all([c, b" = 0; ", refused(7, i, n.name)]),
  );
  let b = temp(line(raised, d, b"} else {"));
  let column_type = |f: Int|
    TyCon({ name: b"Array", args: [match fields.at(f) { Some(t) -> t, None -> unknown_type() }] });
  let dups = Bytes::join(
    range(0, es.len()).map(|f: Int|
      spelled(duped(b.pr, column_type(f), RWord, [slot_of(b.name, ascii_of_int(f))]).out)).filter(
      |t: Bytes| t.len() > 0,
    ),
    b" ",
  );
  let old = released(b.pr, v.ty, RWord, [c]);
  let block = pieces(
    old.pr,
    [
      Text(
        Bytes::concat_all([
          pad(d + 1),
          b"if (ply_obj(",
          c,
          b")->rc != 1) { Word ",
          b.name,
          b" = ",
          allocated(columns_kind(), ascii_of_int(es.len())),
          b"; memcpy(ply_words(",
          b.name,
          b"), ply_words(",
          c,
          b"), ",
          ascii_of_int(8 * es.len()),
          b"); ",
          dups,
          b" ",
        ]),
      ),
    ].concat(
      old.out,
    ).push(
      Text(Bytes::concat_all([b" ", c, b" = ", b.name, b"; }\n"])),
    ),
  );
  let written = range(0, es.len()).fold(block, |q: Printing, f: Int| {
    let e = es.get(f);
    let col = temp(q);
    let held = line(
      col.pr,
      d + 1,
      Bytes::concat_all([b"{ Word ", col.name, b" = ", slot_of(c, ascii_of_int(f)), b";"]),
    );
    let writable = array_writable(held, d + 2, col.name, n.name, e, column_type(f));
    let replaced = let_go_of(
      writable,
      laid_parts(pr.ctors, held_type(column_type(f)), e.laid, 0),
      element_slots(col.name, i, e),
    );
    line(
      line(
        said_line(replaced, d + 2),
        d + 2,
        Bytes::concat_all([
          element_set(col.name, i, e, field_words(ws, es, f)),
          b" ",
          slot_of(c, ascii_of_int(f)),
          b" = ",
          col.name,
          b";",
        ]),
      ),
      d + 1,
      b"}",
    )
  });
  check(p, line(written, d, b"}"))
}

/// The type a container of type `ty` holds, its first argument.
fn held_type(ty: Type) -> Type = type_arg(ty, 0)

/// Type argument `k` of the container type `ty`.
fn type_arg(ty: Type, k: Int) -> Type =
  match ty {
    TyCon(c) -> match c.args.at(k) { Some(t) -> t, None -> unknown_type() },
    _ -> unknown_type(),
  }

/// The types of the fields of a record of type `ty`, in its order.
fn field_types(ty: Type) -> List<Type> =
  match record_fields(ty) { Some(fs) -> fs.map(|f: Field| f.ty), None -> [] }

/// Operand `k`, or a zero word where there is none.
fn operand_arg(args: List<Arg>, k: Int) -> Arg =
  match args.at(k) { Some(a) -> a, None -> AZero(RWord) }

/// The C opening a loop of `i` from `from` up to `n`, its body the caller's to write and close.
fn for_each(i: Bytes, from: Bytes, n: Bytes) -> Bytes =
  Bytes::concat_all([b"for (int64_t ", i, b" = ", from, b"; ", i, b" < ", n, b"; ", i, b"++) { "])

/// Word `j` of element `i` of the array `a`, its elements `stride` words apart.
fn element_slot(a: Bytes, i: Bytes, stride: Int, j: Int) -> Bytes =
  Bytes::concat_all([
    b"ply_words(",
    a,
    b")[(",
    i,
    b") * ",
    ascii_of_int(stride),
    b" + ",
    ascii_of_int(j),
    b"]",
  ])

/// The words element `i` of the array `a`, laid out as `e`, takes.
fn element_slots(a: Bytes, i: Bytes, e: Element) -> List<Bytes> =
  range(0, e.stride).map(|j: Int| element_slot(a, i, e.stride, j))

/// The C setting element `i` of the array `a` to the words `ws`, as `e` lays it out: each word of
/// its stride `ws` leaves out zero.
fn element_set(a: Bytes, i: Bytes, e: Element, ws: List<Bytes>) -> Bytes =
  Bytes::join(
    range(0, e.stride).map(|j: Int|
      Bytes::concat_all([
        element_slot(a, i, e.stride, j),
        b" = ",
        match ws.at(j) { Some(w) -> w, None -> b"0" },
        b";",
      ])),
    b" ",
  )

/// The C values of element `i` of the array `a`, laid out as `e`, held as `r`.
fn element_values(a: Bytes, i: Bytes, e: Element, r: Rep) -> List<Bytes> =
  parts_read(
    Bytes::concat_all([b"(ply_words(", a, b") + (", i, b") * ", ascii_of_int(e.stride), b")"]),
    values_of(r),
  )

/// The words of field `f` of a record whose words are `ws`, its fields laid out as `es` says one
/// after another.
fn field_words(ws: List<Bytes>, es: List<Element>, f: Int) -> List<Bytes> / {abort.raise} =
  ws.drop(es.take(f).fold(0, |n: Int, e: Element| n + words(e.laid))).take(words(es.get(f).laid))

/// The C making `a` an array of `n` elements laid out as `e`: its header's `len` their words, and
/// its `aux` their stride where that is past one.
fn array_alloc(a: Bytes, n: Bytes, e: Element) -> Bytes =
  Bytes::concat_all([
    a,
    b" = ",
    allocated(array_kind(), Bytes::concat_all([b"(", n, b") * ", ascii_of_int(e.stride)])),
    b";",
    if e.stride > 1 {
      Bytes::concat_all([b" ply_obj(", a, b")->aux = ", ascii_of_int(e.stride), b";"])
    } else { b"" },
  ])

/// The C making `c` a `Columns` of `k` columns, each the caller's to write.
fn columns_alloc(c: Bytes, k: Int) -> Bytes =
  Bytes::concat_all([c, b" = ", allocated(columns_kind(), ascii_of_int(k)), b";"])

/// The C allocating a flat object of `kind` whose header's `len` is `len`, as a static of it is laid:
/// the kind and the flag `emit.tir.statics` gives both.
pub fn allocated(kind: Int, len: Bytes) -> Bytes =
  Bytes::concat_all([allocating(kind), len, b", 0, ", ascii_of_int(flat_flag()), b")"])

/// The C `allocated` starts with, up to the header's `len`.
pub fn allocating(kind: Int) -> Bytes =
  Bytes::concat_all([b"rt_alloc_p(ctx, ", ascii_of_int(kind), b", "])

/// The most elements laid out as `e` an array holds: as many as its header's `len` counts the
/// words of, and 2^26 at most.
fn most(e: Element) -> Int / {abort.raise} = min(67108864, 4294967295 / e.stride)

/// The most records a `Columns` whose columns are laid out as `es` holds.
fn most_of(es: List<Element>) -> Int / {abort.raise} =
  es.fold(67108864, |m: Int, e: Element| min(m, most(e)))

/// The C raising as builtin `what` (as `?refused` numbers them) does over `n` and `len`.
fn refused(what: Int, n: Bytes, len: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    builtin_helper(b"?refused"),
    b"_p(ctx, ",
    ascii_of_int(what),
    b", ",
    n,
    b", ",
    len,
    b", 0);",
  ])

/// What `s` says printed as one line at `depth`; nothing where it says nothing.
fn said_line(s: Said, depth: Int) -> Printing =
  if s.out.len() == 0 { s.pr }
  else { pieces(s.pr, [Text(pad(depth))].concat(s.out).push(Text(b"\n"))) }

/// `v` declared holding `exprs`, one per C value it is held as.
fn parts_declared(p: Place, pr: Printing, v: Var, exprs: List<Bytes>) -> Printing = {
  let n = named(pr, v);
  let ts = c_types(v.rep);
  let ns = part_names(n.name, v.rep);
  range(0, ns.len()).fold(n.pr, |q: Printing, k: Int|
    line(
      q,
      p.depth,
      Bytes::concat_all([nth(ts, k), b" ", nth(ns, k), b" = ", nth(exprs, k), b";"]),
    ))
}

fn operand(pr: Printing, args: List<Arg>, k: Int) -> Bytes =
  match args.at(k) { Some(a) -> arg_text(pr, a), None -> b"0" }

/// Where an instruction of a root answering a word is printed, at the body's own depth.
fn at_top() -> Place =
  {
    u: {
      symbol: b"ply_m_1f_1",
      base: 0,
      answer: RWord,
      site: None,
      arm: None,
      looping: None,
      landing: None,
      group: None,
      leaving: b"ctx->fuel += 1;",
    },
    at: span_between(10, 20),
    leave: b"return 0;",
    depth: 0,
  }

fn local(id: Int, ty: Bytes, rep: Rep) -> Var =
  { id: id, ty: TyCon({ name: ty, args: [] }), rep: rep }

test "a list literal is laid out by the emitted code, its tail holding what fits in one" {
  let made = |args: List<Arg>|
    spelled(
      contained(
        at_top(),
        printing(Map::new().insert(0, b"p0")),
        Some(local(1, b"List", RWord)),
        { made: MList(args.len()), args: args, reuse: None },
      ).out,
    );
  let laid = layouts().list;
  let tail = |k: Int| Bytes::concat_all([b"[", ascii_of_int(laid.tail + k), b"] = "]);
  let two = made([AVar(local(0, b"String", RWord)), AZero(RWord)]);
  let has = |text: Bytes, t: Bytes|
    assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  // Room for the two items, each in its tail slot, the tail's length two.
  has(two, b"rt_list_room_p(ctx, 2)");
  has(two, tail(0).concat(b"p0;"));
  has(two, tail(1).concat(b"0;"));
  has(two, Bytes::concat_all([b"->", laid.tail_len, b" = 2;"]));
  assert_eq(made([]).index_of(b"ply_words("), None);
  // The runtime's list builder is never called, and making a list cannot fail.
  [made([]), two].fold((), |_: Unit, text: Bytes| {
    assert_eq(text.index_of(b"rt_list_p"), None);
    assert_eq(text.index_of(b"ctx->failed"), None)
  })
}

test "a list literal past a tail's room lays its whole leaves under a branch and the rest in its tail" {
  let width = layouts().trie.width;
  let n = 2 * width + 3;
  let text = spelled(
    contained(at_top(), printing(Map::new()), Some(local(1, b"List", RWord)), {
      made: MList(n),
      args: range(0, n).map(AInt),
      reuse: None,
    }).out,
  );
  let count = |t: Bytes|
    range(0, text.len()).fold(0, |c: Int, i: Int|
      if text.slice(i, text.len()).starts_with(t) { c + 1 } else { c });
  assert_eq(
    count(Bytes::concat_all([b"rt_node_p(ctx, ", ascii_of_int(layouts().trie.leaf), b")"])),
    2,
  );
  assert_eq(
    count(Bytes::concat_all([b"rt_node_p(ctx, ", ascii_of_int(layouts().trie.branch), b")"])),
    1,
  );
  // The branch holds both leaves, and the list the branch as its root and the last three in its tail.
  let laid = layouts().list;
  let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  has(b"->len = 2;");
  has(Bytes::concat_all([b"[", ascii_of_int(laid.root), b"] = t"]));
  has(Bytes::concat_all([b"->", laid.tail_len, b" = 3;"]))
}

test "a list's item is read where it lies and its rest shares its trie, neither through the runtime" {
  let of = |item: Bytes| TyCon({ name: b"List", args: [TyCon({ name: item, args: [] })] });
  let op = |c: ContainerOp, item: Bytes, into: Var|
    spelled(
      container_op(
        at_top(),
        printing(Map::new().insert(0, b"p0")),
        Some(into),
        c,
        [AVar({ id: 0, ty: of(item), rep: RWord }), AInt(2)],
        { takes: [false, false], owned: c == Rest, fails: false, stops: false },
      ).out,
    );
  let item = op(ItemAt, b"String", local(1, b"String", RWord));
  let scalar = op(ItemAt, b"Int", local(1, b"Int", RInt));
  let rest = op(Rest, b"String", { id: 1, ty: of(b"String"), rep: RWord });
  let ints = op(Rest, b"Int", { id: 1, ty: of(b"Int"), rep: RWord });
  [item, scalar, rest, ints].fold((), |_: Unit, text: Bytes| {
    assert_eq([text.index_of(b"rt_list_at_p"), text.index_of(b"rt_list_rest_p")], [None, None]);
    assert_eq(text.index_of(b"ctx->failed"), None)
  });
  // A read counts nothing; a rest counts the root it shares and each item it copies, as the item's
  // type counts it: an `Int`'s word only where it is the runtime's box.
  [item, scalar].fold((), |_: Unit, text: Bytes|
    assert(!counts_any(text), Some(String::of_bytes_lossy(text))));
  assert(rest.split(call_start(dup_fn(), [])).len() > 2, Some(String::of_bytes_lossy(rest)));
  assert(
    ints.index_of(Bytes::concat_all([b" & 7)) ", call_start(dup_fn(), [])])) != None,
    Some(String::of_bytes_lossy(ints)),
  );
  // A scalar is read out of the item's word.
  assert(scalar.index_of(b"int64_t ") != None, Some(String::of_bytes_lossy(scalar)))
}

fn con(name: Bytes, args: List<Type>) -> Type = TyCon({ name: name, args: args })

test "an array of `Int`s holds each as its bits a word apart, with no shape, and a bad length raises" {
  let int = con(b"Int", []);
  let pr = container_op(
    at_top(),
    printing(Map::new().insert(0, b"p0")),
    Some({ id: 1, ty: con(b"Array", [int]), rep: RWord }),
    ArrayNew({ laid: laid(no_ctors(), int), stride: 1 }),
    [AVar({ id: 0, ty: int, rep: RInt }), AInt(7)],
    { takes: [false, true], owned: true, fails: true, stops: false },
  );
  let text = spelled(pr.out);
  let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  assert_eq(pr.shapes, []);
  has(Bytes::concat_all([b" = ", allocated(array_kind(), b"(p0) * 1"), b";"]));
  has(b" * 1 + 0] = (Word)(INT64_C(7));");
  has(b"builtin_elaborated_refused_p(ctx, 0, p0, 0, 0);");
  assert_eq([text.index_of(b"builtin_array_"), text.index_of(b"->aux")], [None, None])
}

test "an array of records holds each record's words in place, and a write lets go of the one it replaces by its type" {
  let int = con(b"Int", []);
  let rec = TyRecord([
    { name: b"s", ty: con(b"String", []) },
    { name: b"x", ty: con(b"Float", []) },
  ]);
  let array = con(b"Array", [rec]);
  let pr = container_op(
    at_top(),
    printing(Map::new().insert(0, b"p0").insert(1, b"p1").insert(2, b"p2")),
    Some({ id: 3, ty: array, rep: RWord }),
    ArraySet({ laid: laid(no_ctors(), rec), stride: 2 }),
    [
      AVar({ id: 0, ty: array, rep: RWord }),
      AVar({ id: 1, ty: int, rep: RInt }),
      AVar({
        id: 2,
        ty: rec,
        rep: RFlat([{ name: b"s", rep: RWord }, { name: b"x", rep: RFloat }]),
      }),
    ],
    { takes: [true, false, true], owned: true, fails: true, stops: false },
  );
  let text = spelled(pr.out);
  let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  // A copy keeps the stride, and its strings are counted where it copies them.
  has(b")->aux = ply_obj(");
  has(b"rt_note_update_p(ctx, in_place, in_place ? 0 : ");
  // The string of the record replaced goes to its drop root, never to the runtime's; the float is bits.
  has(call_start(rel_fn(), [b"ctx", b"ply_words(t1)[(p1) * 2 + 0]"]));
  has(b"ply_words(t1)[(p1) * 2 + 1] = ply_f64_bits(");
  has(b"builtin_elaborated_refused_p(ctx, 5, p1, ");
  assert(!calls(text, dec_fn()), Some(String::of_bytes_lossy(text)))
}

test "a field of a Columns' record is read from its column in place, an index naming no record raising" {
  let float = con(b"Float", []);
  let pr = container_op(
    at_top(),
    printing(Map::new().insert(0, b"p0").insert(1, b"p1")),
    Some({ id: 2, ty: float, rep: RFloat }),
    ColumnField({ k: 2, column: { laid: laid(no_ctors(), float), stride: 1 } }),
    [
      AVar({ id: 0, ty: con(b"Columns", []), rep: RWord }),
      AVar({ id: 1, ty: con(b"Int", []), rep: RInt }),
    ],
    { takes: [false, false], owned: false, fails: true, stops: false },
  );
  let text = spelled(pr.out);
  let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  has(b"(uint64_t)p1 >= (uint64_t)ply_array_len(ply_words(p0)[2])");
  has(b"builtin_elaborated_refused_p(ctx, 6, p1, ");
  has(b"(ply_words(ply_words(p0)[2]) + (p1) * 1)[0]");
  assert_eq(text.index_of(allocating(columns_kind())), None)
}
