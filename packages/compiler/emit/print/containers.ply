pub fn list_printed(
  p: InstructionContext,
  printing: Printing,
  into: Option<Var>,
  m: { made: Allocation, args: List<Arg>, reuse: Option<Var> },
) -> Printing / {abort.raise} =
  match base_allocation(m.made) {
    ListAllocation(_) -> match into {
      Some(v) -> {
        let n = named(printing, v);
        let items = m.args.map(|a: Arg|
          values_as_words(arg_parts(printing, a), c_values_of(operand_representation(a))));
        let stride = match pointer_layout(printing.constructors, element_type(v.ty)) {
          Some(l) -> max(1, words(l)),
          None -> if m.args.len() == 0 { 1 }
          else { item_element(printing, element_type(v.ty)).stride },
        };
        if base_allocation(m.made) == m.made {
          list_of_items(n.printing, p.depth, n.name, items, stride)
        } else { stack_list_of_items(n.printing, p.depth, n.name, items, stride) }
      },
      None -> unsupported(b"a list made that nothing holds", allocation_text(m.made)),
    },
    other -> unsupported(b"a value made other than a list", allocation_text(other)),
  }

fn retained_printed(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  object: Bytes,
) -> Printing / {abort.raise} =
  match known_layout(printing.constructors, v.ty) {
    Some(l) -> {
      let m = words(l);
      let n = named(printing, v);
      let counted = layout_retain_at(
        n.printing,
        l,
        Bytes::concat_all([b"ply_words(", n.name, b")"]),
      );
      line(
        counted.printing,
        p.depth,
        Bytes::concat_all([
          b"Word ",
          n.name,
          b"; if (ply_obj(",
          object,
          b")->rc == PLY_RC_FRAME) { ",
          n.name,
          b" = ply_alloc(ctx, ",
          int_literal(header_bytes() + 8 * m),
          b"); memcpy(ply_words(",
          n.name,
          b"), ply_words(",
          object,
          b"), ",
          int_literal(8 * m),
          b"); ",
          counted.text,
          b" } else { ",
          call_text(dup_fn(), [object]),
          b"; ",
          n.name,
          b" = ",
          object,
          b"; }",
        ]),
      )
    },
    None -> unsupported(b"a record kept at no layout", var_text(v)),
  }

pub fn container_op(
  p: InstructionContext,
  printing: Printing,
  into: Option<Var>,
  op: ContainerOp,
  args: List<Arg>,
  uses: OperationSignature,
) -> Printing / {abort.raise} = {
  let object = operand(printing, args, 0);
  let index = operand(printing, args, 1);
  match into {
    None ->
      unsupported(
        b"a container's operation whose result goes unread",
        Bytes::concat_all([ascii_of_int(args.len()), b" operands"]),
      ),
    Some(v) -> match op {
      Length ->
        assigned(
          source_position(p, printing),
          p.depth,
          v,
          c_type(v.representation),
          Bytes::concat_all([b"(int64_t)", head_field(length_head(), object, b"len")]),
        ),
      ArrayLength ->
        assigned(
          source_position(p, printing),
          p.depth,
          v,
          c_type(v.representation),
          array_len(object),
        ),
      InBounds ->
        assigned(
          printing,
          p.depth,
          v,
          c_type(v.representation),
          Bytes::concat_all([b"(uint64_t)", index, b" < (uint64_t)", array_len(object)]),
        ),
      NodeIntrinsic(i) -> intrinsic_printed(p, printing, v, i, args),
      Retain -> retained_printed(p, printing, v, object),
      ArrayNew(e) -> array_new(p, printing, v, e, args),
      ArraySet(e) -> array_set(p, printing, v, e, args),
      ArrayOfList(e) -> array_of_list(p, printing, v, e, args),
      ArrayGet(e) -> array_get(p, printing, v, e, args),
      ColumnsNew(es) -> columns_new(p, printing, v, es, args),
      ColumnsSet(es) -> columns_set(p, printing, v, es, args),
      ColumnsOfList(es) -> columns_of_list(p, printing, v, es, args),
      ColumnsGet(es) -> columns_get(p, printing, v, es, args),
      ColumnField(c) -> column_printed(p, printing, v, c.k, c.column, args),
      ColumnOf(k) ->
        assigned(
          printing,
          p.depth,
          v,
          c_type(v.representation),
          word_slot(object, ascii_of_int(k)),
        ),
      ItemAt -> {
        let e = item_element(printing, v.ty);
        let w = temp(printing);
        parts_declared(
          p,
          item_read(w.printing, p.depth, w.name, object, index, e.stride),
          v,
          values_read(|j: Int| slot_at(w.name, j), c_values_of(v.representation)),
        )
      },
      LeafOf -> {
        let n = named(printing, v);
        leaf_read(
          line(
            n.printing,
            p.depth,
            Bytes::concat_all([c_type(v.representation), b" ", n.name, b";"]),
          ),
          p.depth,
          n.name,
          object,
          index,
        )
      },
      WithCapacity ->
        assigned(
          printing,
          p.depth,
          v,
          c_type(v.representation),
          empty_list_alloc(object, item_element(printing, element_type(v.ty)).stride),
        ),
      Rest -> {
        let n = named(printing, v);
        list_rest(
          line(n.printing, p.depth, Bytes::concat_all([b"Word ", n.name, b";"])),
          p.depth,
          n.name,
          object,
          index,
          v.ty,
        )
      },
      Position -> find_bytes_printed(p, printing, v, args),
      CopyOut -> match args.at(0) {
        Some(n) -> taken_printed(p, printing, v, n),
        None ->
          unsupported(b"bytes taken out of the marshalling buffer, none counted", var_text(v)),
      },
    },
  }
}

pub fn item_element(printing: Printing, ty: Type) -> Element / {abort.raise} =
  match pointer_layout(printing.constructors, ty) {
    Some(l) -> { layout: l, stride: max(1, words(l)) },
    None -> unsupported(b"an item of a layout a type variable leaves open", encode_type(ty)),
  }

pub fn item_slot(obj: Bytes, from: Int, k: Bytes, e: Element, j: Int) -> Bytes =
  strided_slot(obj, from, k, e.stride, j)

fn strided_slot(obj: Bytes, from: Int, k: Bytes, stride: Int, j: Int) -> Bytes =
  word_slot(obj, run_start(from + j, k, stride))

fn run_start(from: Int, k: Bytes, stride: Int) -> Bytes =
  if stride == 1 { offset_by(from, k) }
  else { Bytes::concat_all([ascii_of_int(from), b" + (", k, b") * ", ascii_of_int(stride)]) }

type PairLayout = { key: Element, value: Element, pair: Int, branch: BranchLayout }

fn pair_layout(printing: Printing, node: Type) -> PairLayout / {abort.raise} = {
  let k = item_element(printing, type_arg(node, 0));
  let v = item_element(printing, type_arg(node, 1));
  { key: k, value: v, pair: k.stride + v.stride, branch: branch_layout(k.stride) }
}

fn strided_values(obj: Bytes, from: Int, k: Bytes, stride: Int, r: Representation) -> List<Bytes> =
  values_read(|j: Int| strided_slot(obj, from, k, stride, j), c_values_of(r))

fn strided_set(
  printing: Printing,
  obj: Bytes,
  from: Int,
  k: Bytes,
  stride: Int,
  e: Element,
  x: Arg,
) -> Bytes = {
  let ws = values_as_words(arg_parts(printing, x), c_values_of(operand_representation(x)));
  Bytes::join(
    range(0, e.stride).map(|j: Int|
      Bytes::concat_all([
        strided_slot(obj, from, k, stride, j),
        b" = ",
        match ws.at(j) { Some(w) -> w, None -> b"0" },
        b";",
      ])),
    b" ",
  )
}

pub fn item_slots(obj: Bytes, from: Int, k: Bytes, e: Element) -> List<Bytes> =
  range(0, e.stride).map(|j: Int| item_slot(obj, from, k, e, j))

fn item_values(obj: Bytes, from: Int, k: Bytes, e: Element, r: Representation) -> List<Bytes> =
  values_read(|j: Int| item_slot(obj, from, k, e, j), c_values_of(r))

fn item_set(printing: Printing, obj: Bytes, from: Int, k: Bytes, e: Element, x: Arg) -> Bytes =
  strided_set(printing, obj, from, k, e.stride, e, x)

fn item_words(n: Bytes, e: Element) -> Bytes =
  if e.stride == 1 { n } else { Bytes::concat_all([n, b" * ", ascii_of_int(e.stride)]) }

fn intrinsic_printed(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  op: Intrinsic,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let laid = container_layouts();
  let o = operand(printing, args, 0);
  let i = operand(printing, args, 1);
  let raw = |e: Bytes| assigned(printing, p.depth, v, c_type(v.representation), e);
  let read = |slot: Bytes| raw(word_as(slot, v.representation));
  let lh = |w: Bytes, f: Bytes| head_field(list_head(), w, f);
  let nh = |w: Bytes, f: Bytes| head_field(node_head(), w, f);
  let int_of = |field: Bytes| raw(Bytes::concat_all([b"(int64_t)", field]));
  let first = laid.trie.first;
  let made = |kind: Int, words: Int|
    assigned(printing, p.depth, v, c_type(v.representation), node_alloc(kind, words));
  let held = assigned(printing, p.depth, v, c_type(v.representation), o);
  let a = name_of(held, v);
  let at = |k: Bytes| word_slot(a, k);
  let written = |text: Bytes| line(held, p.depth, text);
  let owned = |copied: Option<Bytes>|
    copy_unless_unique(held, p.depth, a, operand_type(args, 0), copied);
  let shifted = |from: Bytes, n: Bytes, by: Bytes|
    Bytes::concat_all([
      b"memmove(&",
      at(Bytes::concat_all([from, b" + ", by])),
      b", &",
      at(from),
      b", (size_t)(",
      n,
      b") * sizeof(Word)); ",
    ]);
  let index = Bytes::concat_all([b"(", i, b")"]);
  let after = |less: Bytes| Bytes::concat_all([b"(int64_t)", nh(a, b"len"), b" - ", index, less]);
  let node = operand_type(args, 0);
  let replaced = |q: Printing, from: Int, k: Bytes, stride: Int, e: Element, ty: Type, x: Arg| {
    let olds = range(0, e.stride).fold(
      { printing: q, names: [] },
      |acc: { printing: Printing, names: List<Bytes> }, j: Int| {
        let t = temp(acc.printing);
        { printing: t.printing, names: acc.names.push(t.name) }
      },
    );
    let set = line(
      olds.printing,
      p.depth,
      Bytes::concat_all(
        range(0, e.stride).map(|j: Int|
          Bytes::concat_all([
            b"Word ",
            nth(olds.names, j),
            b" = ",
            strided_slot(a, from, k, stride, j),
            b"; ",
          ])),
      ).concat(
        strided_set(printing, a, from, k, stride, e, x),
      ),
    );
    fragment_line(
      p.depth,
      parts_released(set, layout_parts(printing.constructors, ty, e.layout, 0), olds.names),
    )
  };
  let item = || item_element(printing, element_type(node));
  let item_replaced = |q: Printing, from: Int, k: Bytes, x: Arg| {
    let e = item();
    replaced(q, from, k, e.stride, e, element_type(node), x)
  };
  let pl = || pair_layout(printing, if args.len() == 0 { v.ty } else { node });
  let pairs = || Some(Bytes::concat_all([ascii_of_int(pl().pair), b" * (int64_t)", nh(a, b"len")]));
  match op {
    OfList(ListStart) -> int_of(lh(o, b"start")),
    OfList(TailLen) -> int_of(lh(o, b"tail_len")),
    OfList(NodeLen) -> int_of(nh(o, b"len")),
    OfList(ListRoot) -> raw(word_slot(o, ascii_of_int(laid.list.root))),
    OfList(TailAt) ->
      parts_declared(
        p,
        printing,
        v,
        item_values(o, laid.list.tail, i, item_element(printing, v.ty), v.representation),
      ),
    OfList(LeafAt) ->
      parts_declared(
        p,
        printing,
        v,
        item_values(o, first, i, item_element(printing, v.ty), v.representation),
      ),
    OfList(KidAt) -> read(word_slot(o, offset_by(first, i))),
    OfList(NewBranch) ->
      assigned(
        printing,
        p.depth,
        v,
        c_type(v.representation),
        trie_node_alloc(laid.trie.branch, 1),
      ),
    OfList(TailPush) -> {
      let e = item();
      let g = temp(held);
      let opened = line(
        g.printing,
        p.depth,
        Bytes::concat_all([
          b"{ int in_place = ply_obj(",
          a,
          b")->rc == 1; int64_t n = (int64_t)",
          lh(a, b"tail_len"),
          b";",
        ]),
      );
      let copy = copied(opened, p.depth + 1, a, operand_type(args, 0));
      let moved = Bytes::concat_all([
        b"if (n == (int64_t)",
        lh(a, b"room"),
        b") { Word ",
        g.name,
        b" = ",
        empty_list_alloc(
          Bytes::concat_all([
            b"(2 * n > ",
            ascii_of_int(minimum_list_capacity()),
            b" ? 2 * n : ",
            ascii_of_int(minimum_list_capacity()),
            b")",
          ]),
          e.stride,
        ),
        b"; ",
        word_slot(g.name, ascii_of_int(laid.list.root)),
        b" = ",
        word_slot(a, ascii_of_int(laid.list.root)),
        b"; ",
        Bytes::concat_all(
          [b"start", b"len", b"tail_len"].map(|f: Bytes|
            Bytes::concat_all([lh(g.name, f), b" = ", lh(a, f), b"; "])),
        ),
        b"memcpy(&",
        word_slot(g.name, ascii_of_int(laid.list.tail)),
        b", &",
        word_slot(a, ascii_of_int(laid.list.tail)),
        b", (size_t)",
        item_words(b"n", e),
        b" * sizeof(Word)); ",
        call_text(free_fn(), [
          b"ctx",
          a,
          ascii_of_int(header_bytes() + 8 * laid.list.tail).concat(b" + 8 * ").concat(
            item_words(b"n", e),
          ),
        ]),
        b"; ",
        a,
        b" = ",
        g.name,
        b"; }",
      ]);
      let grown = line(
        line(copy, p.depth + 1, moved),
        p.depth + 1,
        b"rt_note_update_p(ctx, in_place, in_place ? 0 : n); }",
      );
      line(
        grown,
        p.depth,
        Bytes::concat_all([
          item_set(printing, a, laid.list.tail, lh(a, b"tail_len"), e, operand_arg(args, 1)),
          b" ",
          lh(a, b"tail_len"),
          b" += 1; ",
          lh(a, b"len"),
          b" += 1;",
        ]),
      )
    },
    OfList(TailStart) ->
      written(
        Bytes::concat_all([
          item_set(printing, a, laid.list.tail, b"0", item(), operand_arg(args, 1)),
          b" ",
          lh(a, b"tail_len"),
          b" = 1; ",
          lh(a, b"len"),
          b" += 1;",
        ]),
      ),
    OfList(TailSet) ->
      item_replaced(owned(Some(lh(a, b"tail_len"))), laid.list.tail, i, operand_arg(args, 2)),
    OfList(LeafSet) -> item_replaced(owned(Some(nh(a, b"len"))), first, i, operand_arg(args, 2)),
    OfMap(MapRoot) -> raw(word_slot(o, ascii_of_int(laid.map.root))),
    OfMap(MapHeight) -> int_of(head_field(map_head(), o, b"height")),
    OfMap(NodeCount) -> int_of(nh(o, b"len")),
    OfMap(NodeKey) ->
      parts_declared(p, printing, v, strided_values(o, first, i, pl().pair, v.representation)),
    OfMap(NodeValue) -> {
      let l = pl();
      parts_declared(
        p,
        printing,
        v,
        strided_values(o, first + l.key.stride, i, l.pair, v.representation),
      )
    },
    OfMap(NodeKid) -> read(word_slot(o, offset_by(first, i))),
    OfMap(ChildMaxKey) -> {
      let l = pl();
      parts_declared(
        p,
        printing,
        v,
        strided_values(o, l.branch.keys, i, l.key.stride, v.representation),
      )
    },
    OfMap(KidSize) ->
      raw(
        Bytes::concat_all([b"ply_imm_value(", word_slot(o, offset_by(pl().branch.sizes, i)), b")"]),
      ),
    OfMap(NewLeaf) -> made(laid.tree.leaf, laid.tree.width * pl().pair),
    OfMap(NewMapBranch) -> made(laid.tree.branch, pl().branch.words),
    OfMap(PairPut) -> {
      let l = pl();
      let ps = ascii_of_int(l.pair);
      line(
        owned(pairs()),
        p.depth,
        Bytes::concat_all([
          shifted(
            offset_by(first, Bytes::concat_all([index, b" * ", ps])),
            Bytes::concat_all([b"(", after(b""), b") * ", ps]),
            ps,
          ),
          strided_set(printing, a, first, i, l.pair, l.key, operand_arg(args, 2)),
          b" ",
          strided_set(printing, a, first + l.key.stride, i, l.pair, l.value, operand_arg(args, 3)),
          b" ",
          nh(a, b"len"),
          b" += 1;",
        ]),
      )
    },
    OfMap(PairSet) -> {
      let l = pl();
      let keyed = replaced(
        owned(pairs()),
        first,
        i,
        l.pair,
        l.key,
        type_arg(node, 0),
        operand_arg(args, 2),
      );
      replaced(
        keyed,
        first + l.key.stride,
        i,
        l.pair,
        l.value,
        type_arg(node, 1),
        operand_arg(args, 3),
      )
    },
    OfMap(KidRestore) -> {
      let l = pl();
      let maxed = replaced(
        owned(None),
        l.branch.keys,
        i,
        l.key.stride,
        l.key,
        type_arg(node, 0),
        operand_arg(args, 3),
      );
      line(
        maxed,
        p.depth,
        Bytes::concat_all([
          at(offset_by(first, i)),
          b" = ",
          operand(printing, args, 2),
          b"; ",
          at(offset_by(l.branch.sizes, i)),
          b" = ply_imm(",
          operand(printing, args, 4),
          b");",
        ]),
      )
    },
    OfMap(KidPut) -> {
      let l = pl();
      let ks = l.key.stride;
      let n = after(b"");
      line(
        owned(None),
        p.depth,
        Bytes::concat_all([
          shifted(offset_by(first, i), n, b"1"),
          shifted(
            run_start(l.branch.keys, index, ks),
            Bytes::concat_all([b"(", n, b") * ", ascii_of_int(ks)]),
            ascii_of_int(ks),
          ),
          shifted(offset_by(l.branch.sizes, i), n, b"1"),
          at(offset_by(first, i)),
          b" = ",
          operand(printing, args, 2),
          b"; ",
          strided_set(printing, a, l.branch.keys, i, ks, l.key, operand_arg(args, 3)),
          b" ",
          at(offset_by(l.branch.sizes, i)),
          b" = ply_imm(",
          operand(printing, args, 4),
          b"); ",
          nh(a, b"len"),
          b" += 1;",
        ]),
      )
    },
    OfMap(KidDrop) -> {
      let l = pl();
      let ks = l.key.stride;
      let n = after(b" - 1");
      let next = index.concat(b" + 1");
      let kid = fragment_line(
        p.depth,
        released(owned(None), node, AsWord, [at(offset_by(first, i))]),
      );
      let key = fragment_line(
        p.depth,
        parts_released(
          kid,
          layout_parts(printing.constructors, type_arg(node, 0), l.key.layout, 0),
          range(0, ks).map(|j: Int| strided_slot(a, l.branch.keys, i, ks, j)),
        ),
      );
      line(
        key,
        p.depth,
        Bytes::concat_all([
          shifted(offset_by(first, next), n, b"-1"),
          shifted(
            run_start(l.branch.keys, next, ks),
            Bytes::concat_all([b"(", n, b") * ", ascii_of_int(ks)]),
            Bytes::concat_all([b"-", ascii_of_int(ks)]),
          ),
          shifted(offset_by(l.branch.sizes, next), n, b"-1"),
          nh(a, b"len"),
          b" -= 1;",
        ]),
      )
    },
    Recast -> held,
    _ -> record_printed(p, printing, v, op, args),
  }
}

type ResultField = { name: Bytes, words: List<Bytes>, item: Bool }

fn record_printed(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  op: Intrinsic,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let laid = container_layouts();
  let d = p.depth;
  let held = temp(printing);
  let a = held.name;
  let i = operand(printing, args, 1);
  let index = Bytes::concat_all([b"(", i, b")"]);
  let lh = |f: Bytes| head_field(list_head(), a, f);
  let nh = |w: Bytes, f: Bytes| head_field(node_head(), w, f);
  let at = |k: Bytes| word_slot(a, k);
  let first = laid.trie.first;
  let pairs = || pair_layout(printing, operand_type(args, 0));
  let started = copy_unless_unique(
    line(
      held.printing,
      d,
      Bytes::concat_all([b"Word ", a, b" = ", operand(printing, args, 0), b";"]),
    ),
    d,
    a,
    operand_type(args, 0),
    match op {
      OfList(Spill) -> Some(lh(b"tail_len")),
      OfMap(PairTake) ->
        Some(Bytes::concat_all([ascii_of_int(pairs().pair), b" * (int64_t)", nh(a, b"len")])),
      _ -> None,
    },
  );
  let whole = |name: Bytes, word: Bytes| { name: name, words: [word], item: false };
  let took = |text: (Bytes) -> Bytes, fields: (Bytes) -> List<ResultField>| {
    let t = temp(started);
    fields_set(p, line(t.printing, d, text(t.name)), v, fields(t.name))
  };
  let cut = |kind: Int, words: Int, runs: List<{ from: Int, width: Int }>|
    took(
      |r: Bytes| {
        let rest = Bytes::concat_all([b"((int64_t)", nh(a, b"len"), b" - ", index, b")"]);
        Bytes::concat_all([
          b"Word ",
          r,
          b" = ",
          node_alloc(kind, words),
          b"; ",
          Bytes::concat_all(
            runs.map(|run_start: { from: Int, width: Int }|
              Bytes::concat_all([
                b"memcpy(&",
                word_slot(r, ascii_of_int(run_start.from)),
                b", &",
                at(
                  Bytes::concat_all([
                    ascii_of_int(run_start.from),
                    b" + ",
                    ascii_of_int(run_start.width),
                    b" * ",
                    index,
                  ]),
                ),
                b", (size_t)(",
                ascii_of_int(run_start.width),
                b" * ",
                rest,
                b") * sizeof(Word)); ",
              ])),
          ),
          nh(r, b"len"),
          b" = (uint32_t)",
          rest,
          b"; ",
          nh(a, b"len"),
          b" = (uint32_t)",
          index,
          b";",
        ])
      },
      |r: Bytes| [whole(b"left", a), whole(b"right", r)],
    );
  match op {
    OfList(RootSwap) -> {
      let root = at(ascii_of_int(laid.list.root));
      took(
        |old: Bytes| Bytes::concat_all([b"Word ", old, b" = ", root, b"; ", root, b" = ", i, b";"]),
        |old: Bytes| [whole(b"list", a), whole(b"old", old)],
      )
    },
    OfList(ChildSwap) ->
      took(
        |old: Bytes|
          Bytes::concat_all([
            b"Word ",
            old,
            b" = 0; if (",
            i,
            b" < (int64_t)",
            nh(a, b"len"),
            b") ",
            old,
            b" = ",
            at(offset_by(first, i)),
            b"; else ",
            nh(a, b"len"),
            b" = (uint32_t)(",
            i,
            b") + 1; ",
            at(offset_by(first, i)),
            b" = ",
            operand(printing, args, 2),
            b";",
          ]),
        |old: Bytes| [whole(b"node", a), whole(b"old", old)],
      ),
    OfList(Spill) -> {
      let width = ascii_of_int(laid.trie.width);
      let e = item_element(printing, element_type(operand_type(args, 0)));
      took(
        |leaf: Bytes|
          Bytes::concat_all([
            b"Word ",
            leaf,
            b" = ",
            trie_node_alloc(laid.trie.leaf, e.stride),
            b"; memcpy(&",
            word_slot(leaf, ascii_of_int(first)),
            b", &",
            at(ascii_of_int(laid.list.tail)),
            b", ",
            item_words(width, e),
            b" * sizeof(Word)); ",
            nh(leaf, b"len"),
            b" = ",
            width,
            b"; ",
            lh(b"tail_len"),
            b" = 0;",
          ]),
        |leaf: Bytes| [whole(b"leaf", leaf), whole(b"list", a)],
      )
    },
    OfMap(PairTake) -> {
      let l = pairs();
      let ps = ascii_of_int(l.pair);
      let start = offset_by(first, Bytes::concat_all([index, b" * ", ps]));
      let words = range(0, l.pair).fold(
        { printing: started, names: [] },
        |acc: { printing: Printing, names: List<Bytes> }, j: Int| {
          let t = temp(acc.printing);
          { printing: t.printing, names: acc.names.push(t.name) }
        },
      );
      let taken = line(
        words.printing,
        d,
        Bytes::concat_all(
          range(0, l.pair).map(|j: Int|
            Bytes::concat_all([
              b"Word ",
              nth(words.names, j),
              b" = ",
              word_slot(a, run_start(first + j, index, l.pair)),
              b"; ",
            ])),
        ).concat(
          Bytes::concat_all([
            b"memmove(&",
            at(start),
            b", &",
            at(Bytes::concat_all([start, b" + ", ps])),
            b", (size_t)(",
            ps,
            b" * ((int64_t)",
            nh(a, b"len"),
            b" - ",
            index,
            b" - 1)) * sizeof(Word)); ",
            nh(a, b"len"),
            b" -= 1;",
          ]),
        ),
      );
      fields_set(p, taken, v, [
        { name: b"key", words: words.names.take(l.key.stride), item: true },
        whole(b"node", a),
        { name: b"value", words: words.names.drop(l.key.stride), item: true },
      ])
    },
    OfMap(LeafSplit) -> {
      let l = pairs();
      cut(laid.tree.leaf, laid.tree.width * l.pair, [{ from: first, width: l.pair }])
    },
    OfMap(BranchSplit) -> {
      let l = pairs();
      cut(laid.tree.branch, l.branch.words, [
        { from: first, width: 1 },
        { from: l.branch.keys, width: l.key.stride },
        { from: l.branch.sizes, width: 1 },
      ])
    },
    OfMap(KidOut) ->
      took(
        |kid: Bytes|
          Bytes::concat_all([
            b"Word ",
            kid,
            b" = ",
            at(offset_by(first, i)),
            b"; ",
            at(offset_by(first, i)),
            b" = 0;",
          ]),
        |kid: Bytes| [whole(b"kid", kid), whole(b"node", a)],
      ),
    OfMap(MapSwap) -> {
      let root = at(ascii_of_int(laid.map.root));
      took(
        |old: Bytes|
          Bytes::concat_all([
            b"Word ",
            old,
            b" = ",
            root,
            b"; ",
            root,
            b" = ",
            i,
            b"; ",
            head_field(map_head(), a, b"height"),
            b" = (uint32_t)(",
            operand(printing, args, 2),
            b"); ",
            head_field(map_head(), a, b"len"),
            b" = (uint32_t)(",
            operand(printing, args, 3),
            b");",
          ]),
        |old: Bytes| [whole(b"map", a), whole(b"old", old)],
      )
    },
    _ ->
      unsupported(
        b"an extern returning no record, printed as one that does",
        Bytes::concat_all([b"into ", var_text(v), b" of ", ascii_of_int(args.len()), b" operands"]),
      ),
  }
}

fn fields_set(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  fields: List<ResultField>,
) -> Printing / {abort.raise} = {
  let n = named(printing, v);
  let ns = part_names(n.name, v.representation);
  let ls = match v.representation { AsFlattened(x) -> x, _ -> [] };
  fields.fold(n.printing, |q: Printing, x: ResultField|
    match leaf_span(ls, x.name) {
      None -> q,
      Some(sp) -> {
        let one = match ls.at(sp.at) {
          Some(l) -> if sp.n == 1 && l.name == x.name { Some(l.representation) } else { None },
          None -> None,
        };
        let r = match one { Some(lr) -> lr, None -> AsFlattened(leaves_within(ls, sp)) };
        let first = leaf_values(ls, sp.at).at;
        let mine = ns.drop(first).take(c_values_of(r).len());
        if x.item {
          let values = values_read(|j: Int| nth(x.words, j), c_values_of(r));
          let ts = c_types(r);
          range(0, mine.len()).fold(q, |s: Printing, k: Int|
            line(
              s,
              p.depth,
              Bytes::concat_all([nth(ts, k), b" ", nth(mine, k), b" = ", nth(values, k), b";"]),
            ))
        } else if is_boxed(r) {
          pieces(
            q,
            [Text(pad(p.depth))].concat(word_to_parts(nth(x.words, 0), r, mine)).push(Text(b"\n")),
          )
        } else {
          line(
            q,
            p.depth,
            Bytes::concat_all([c_type(r), b" ", nth(mine, 0), b" = ", nth(x.words, 0), b";"]),
          )
        }
      },
    })
}

fn offset_by(from: Int, at: Bytes) -> Bytes =
  Bytes::concat_all([ascii_of_int(from), b" + (", at, b")"])

fn copy_unless_unique(
  printing: Printing,
  depth: Int,
  a: Bytes,
  ty: Type,
  counted: Option<Bytes>,
) -> Printing = {
  let c = copy_called(printing, a, ty);
  match counted {
    None ->
      pieces(
        c.printing,
        [Text(Bytes::concat_all([pad(depth), b"if (ply_obj(", a, b")->rc != 1) "]))].concat(
          c.out,
        ).push(
          Text(b"\n"),
        ),
      ),
    Some(n) ->
      pieces(c.printing, [
        Text(Bytes::concat_all([pad(depth), a, b" = ", writable_fn(), b"(ctx, ", a, b", "])),
        Hole(Symbol(Root(root_of(Copy, ty)))),
        Text(Bytes::concat_all([b", ", n, b");\n"])),
      ]),
  }
}

fn copied(printing: Printing, depth: Int, a: Bytes, ty: Type) -> Printing = {
  let c = copy_called(printing, a, ty);
  pieces(c.printing, [Text(pad(depth).concat(b"if (!in_place) "))].concat(c.out).push(Text(b"\n")))
}

fn copy_called(printing: Printing, a: Bytes, ty: Type) -> { printing: Printing, out: List<Piece> } = {
  let k = root_of(Copy, ty);
  {
    printing: if printing.calls.contains(k) { printing } else {
      {
        ..printing,
        calls: printing.calls.push(k),
        expects: printing.expects.push({
          callee: CallAt(printing.calls.len()),
          head: signature_types({
            params: [{ ownership: OwnedParam, representation: AsWord }],
            result: AsWord,
            destination_passing: false,
            returned: OwnedResult,
          }),
        }),
      }
    },
    out: [
      Text(Bytes::concat_all([a, b" = "])),
      Hole(Symbol(Root(k))),
      Text(Bytes::concat_all([b"(ctx, ", a, b");"])),
    ],
  }
}

fn operand_type(args: List<Arg>, k: Int) -> Type =
  match args.at(k) { Some(VarOperand(x)) -> x.ty, _ -> unknown_type() }

fn array_new(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = element_type(v.ty);
  let n = operand(printing, args, 0);
  let x = operand_arg(args, 1);
  let xs = arg_parts(printing, x);
  let r = operand_representation(x);
  let d = p.depth;
  let started = assigned(source_position(p, printing), d, v, c_type(v.representation), b"0");
  let a = name_of(started, v);
  let opened = line(
    started,
    d,
    Bytes::concat_all([b"if (", n, b" < 0 || ", n, b" > ", ascii_of_int(max_elements(e)), b") {"]),
  );
  let raising = rejected(fragment_line(d + 1, released(opened, ty, r, xs)), b"Array::new", n, b"0");
  let raised = line(raising.printing, d + 1, raising.text);
  let made = line(line(raised, d, b"} else {"), d + 1, array_alloc(a, n, e));
  let i = temp(made);
  let counted = copies_counted(i.printing, d + 1, n, i.name, ty, r, xs);
  let filled = line(
    counted,
    d + 1,
    Bytes::concat_all([
      for_each(i.name, b"0", n),
      element_set(a, i.name, e, values_as_words(xs, c_values_of(r))),
      b" }",
    ]),
  );
  check(p, line(filled, d, b"}"))
}

fn copies_counted(
  printing: Printing,
  depth: Int,
  n: Bytes,
  i: Bytes,
  ty: Type,
  r: Representation,
  xs: List<Bytes>,
) -> Printing / {abort.raise} = {
  let dups = duped(printing, ty, r, xs);
  let none = released(dups.printing, ty, r, xs);
  if dups.out.len() == 0 { none.printing } else {
    pieces(
      none.printing,
      [Text(Bytes::concat_all([pad(depth), b"if (", n, b" == 0) { "]))].concat(none.out).push(
        Text(Bytes::concat_all([b" } else { ", for_each(i, b"1", n)])),
      ).concat(
        dups.out,
      ).push(
        Text(b" } }\n"),
      ),
    )
  }
}

fn array_set(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = element_type(v.ty);
  let i = operand(printing, args, 1);
  let x = operand_arg(args, 2);
  let xs = arg_parts(printing, x);
  let r = operand_representation(x);
  let d = p.depth;
  let started = assigned(
    source_position(p, printing),
    d,
    v,
    c_type(v.representation),
    operand(printing, args, 0),
  );
  let a = name_of(started, v);
  let n = temp(started);
  let opened = line(
    line(n.printing, d, Bytes::concat_all([b"int64_t ", n.name, b" = ", array_len(a), b";"])),
    d,
    Bytes::concat_all([b"if ((uint64_t)", i, b" >= (uint64_t)", n.name, b") {"]),
  );
  let x_go = fragment_line(d + 1, released(opened, ty, r, xs));
  let raising = rejected(
    fragment_line(d + 1, released(x_go, v.ty, AsWord, [a])),
    b"Array::set",
    i,
    n.name,
  );
  let raised = line(raising.printing, d + 1, Bytes::concat_all([a, b" = 0; ", raising.text]));
  let copy_unless_unique = array_writable(line(raised, d, b"} else {"), d + 1, a, n.name, e, v.ty);
  let replaced = parts_released(
    copy_unless_unique,
    layout_parts(printing.constructors, ty, e.layout, 0),
    element_slots(a, i, e),
  );
  let written = line(
    fragment_line(d + 1, replaced),
    d + 1,
    element_set(a, i, e, values_as_words(xs, c_values_of(r))),
  );
  check(p, line(written, d, b"}"))
}

fn array_writable(
  printing: Printing,
  depth: Int,
  a: Bytes,
  n: Bytes,
  e: Element,
  ty: Type,
) -> Printing / {abort.raise} = {
  let c = temp(printing);
  let j = temp(c.printing);
  let dups = dup_of(
    layout_parts(printing.constructors, element_type(ty), e.layout, 0),
    element_slots(c.name, j.name, e),
  );
  let old = released(j.printing, ty, AsWord, [a]);
  let copied = pieces(
    old.printing,
    [
      Text(
        Bytes::concat_all([
          pad(depth),
          b"int in_place = ply_obj(",
          a,
          b")->rc == 1;\n",
          pad(depth),
          b"if (!in_place) { Word ",
          c.name,
          b" = ply_alloc(ctx, ",
          array_bytes(n, e),
          b"); memcpy(ply_words(",
          c.name,
          b"), ply_words(",
          a,
          b"), (size_t)(",
          array_bytes(n, e),
          b" - ",
          ascii_of_int(header_bytes()),
          b")); ",
          if dups.len() == 0 { b"" }
          else { Bytes::concat_all([for_each(j.name, b"0", n), dups, b" } "]) },
        ]),
      ),
    ].concat(
      old.out,
    ).push(
      Text(Bytes::concat_all([b" ", a, b" = ", c.name, b"; }\n"])),
    ),
  );
  line(
    copied,
    depth,
    Bytes::concat_all([b"rt_note_update_p(ctx, in_place, in_place ? 0 : ", n, b");"]),
  )
}

fn array_of_list(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = element_type(v.ty);
  let l = operand(printing, args, 0);
  let listed = list_type(ty);
  let d = p.depth;
  let count = temp(source_position(p, printing));
  let n = count.name;
  let started = assigned(
    line(
      count.printing,
      d,
      Bytes::concat_all([
        b"int64_t ",
        n,
        b" = (int64_t)",
        head_field(list_head(), l, b"len"),
        b";",
      ]),
    ),
    d,
    v,
    c_type(v.representation),
    b"0",
  );
  let a = name_of(started, v);
  let opened = line(
    started,
    d,
    Bytes::concat_all([b"if (", n, b" > ", ascii_of_int(max_elements(e)), b") {"]),
  );
  let raising = rejected(
    fragment_line(d + 1, released(opened, listed, AsWord, [l])),
    b"Array::of_list",
    n,
    b"0",
  );
  let raised = line(raising.printing, d + 1, raising.text);
  let made = line(line(raised, d, b"} else {"), d + 1, array_alloc(a, n, e));
  let i = temp(made);
  let item = item_loop(i.printing, d + 1, l, n, i.name, ty);
  let stored = line(
    item.printing,
    d + 2,
    element_set(a, i.name, e, values_as_words(item.values, c_values_of(item.representation))),
  );
  let released_list = released(line(stored, d + 1, b"}"), listed, AsWord, [l]);
  check(p, line(fragment_line(d + 1, released_list), d, b"}"))
}

fn item_loop(
  printing: Printing,
  depth: Int,
  l: Bytes,
  n: Bytes,
  i: Bytes,
  ty: Type,
) -> { printing: Printing, values: List<Bytes>, representation: Representation } / {abort.raise} = {
  let rep = representation_with(printing.constructors, ty);
  let e = item_element(printing, ty);
  let w = temp(printing);
  let x = temp(w.printing);
  let names = part_names(x.name, rep);
  let opened = line(x.printing, depth, for_each(i, b"0", n));
  let read = item_read(opened, depth + 1, w.name, l, i, e.stride);
  let words = range(0, e.stride).map(|j: Int| slot_at(w.name, j));
  let dup = dup_of(layout_parts(printing.constructors, ty, e.layout, 0), words);
  let counted = if dup.len() == 0 { read } else { line(read, depth + 1, dup) };
  let values = values_read(|j: Int| slot_at(w.name, j), c_values_of(rep));
  {
    printing: range(0, names.len()).fold(counted, |q: Printing, k: Int|
      line(
        q,
        depth + 1,
        Bytes::concat_all([
          nth(c_types(rep), k),
          b" ",
          nth(names, k),
          b" = ",
          nth(values, k),
          b";",
        ]),
      )),
    values: names,
    representation: rep,
  }
}

fn slot_at(w: Bytes, j: Int) -> Bytes = Bytes::concat_all([w, b"[", ascii_of_int(j), b"]"])

fn array_get(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let a = operand(printing, args, 0);
  let i = operand(printing, args, 1);
  parts_declared(
    p,
    index_check(p, printing, b"Array::get", a, i),
    v,
    element_values(a, i, e, v.representation),
  )
}

fn index_check(
  p: InstructionContext,
  printing: Printing,
  what: Bytes,
  a: Bytes,
  i: Bytes,
) -> Printing / {abort.raise} = {
  let length = array_len(a);
  let raising = rejected(source_position(p, printing), what, i, length);
  line(
    raising.printing,
    p.depth,
    Bytes::concat_all([
      b"if ((uint64_t)",
      i,
      b" >= (uint64_t)",
      length,
      b") { ",
      raising.text,
      b" ",
      p.exit_statement,
      b" }",
    ]),
  )
}

fn find_bytes_printed(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let b = operand(printing, args, 0);
  let from = operand(printing, args, 1);
  let f = operand(printing, args, 2);
  let described = operand(printing, args, 3);
  let words = operand(printing, args, 4);
  let d = p.depth;
  let len = Bytes::concat_all([b"(int64_t)", head_field(text_head(), b, b"len")]);
  let raising = rejected(source_position(p, printing), b"Bytes::position", from, len);
  let guarded = line(
    raising.printing,
    d,
    Bytes::concat_all([
      b"if ((uint64_t)",
      from,
      b" > (uint64_t)",
      len,
      b") { ",
      raising.text,
      b" ",
      p.exit_statement,
      b" }",
    ]),
  );
  let found = assigned(guarded, d, v, c_type(v.representation), b"-1");
  let n = name_of(found, v);
  let i = temp(found);
  let opened = line(
    i.printing,
    d,
    Bytes::concat_all([
      b"for (int64_t ",
      i.name,
      b" = ",
      from,
      b"; ",
      i.name,
      b" < ",
      len,
      b"; ",
      i.name,
      b" += 1) {",
    ]),
  );
  let conv = typed_convention(predicate_convention(printing, args));
  let called = temp(opened);
  let inside = { ..p, depth: d + 1 };
  let asked = line(
    source_position(inside, called.printing),
    d + 1,
    Bytes::concat_all([
      call_text(dup_fn(), [f]),
      b"; ",
      c_type(conv.result),
      b" ",
      called.name,
      b" = ",
      typed_callee(f, conv),
      b"(ctx, ",
      f,
      b", (int64_t)(",
      bytes_of(b),
      b")[",
      i.name,
      b"], ",
      described,
      b", ",
      words,
      b");",
    ]),
  );
  let hit = line(
    check(inside, asked),
    d + 1,
    Bytes::concat_all([b"if (", called.name, b") { ", n, b" = ", i.name, b"; break; }"]),
  );
  line(hit, d, b"}")
}

fn predicate_convention(printing: Printing, args: List<Arg>) -> Convention / {abort.raise} =
  match args.at(2) {
    Some(VarOperand(v)) -> match v.ty {
      FunctionType(t) -> {
        let c = convention_of(printing.constructors, { params: t.params, ret: t.ret });
        if reps_of(c) == [AsInt] && c.result == AsBool { c } else {
          unsupported(
            b"a byte string's position whose predicate is represented otherwise",
            var_text(v),
          )
        }
      },
      _ -> unsupported(b"a byte string's position on no function", var_text(v)),
    },
    _ -> unsupported(b"a byte string's position on no predicate", ascii_of_int(args.len())),
  }

fn column_printed(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  k: Int,
  e: Element,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let column = word_slot(operand(printing, args, 0), ascii_of_int(k));
  let i = operand(printing, args, 1);
  parts_declared(
    p,
    index_check(p, printing, b"Columns::get", column, i),
    v,
    element_values(column, i, e, v.representation),
  )
}

fn columns_new(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  es: List<Element>,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = element_type(v.ty);
  let n = operand(printing, args, 0);
  let x = operand_arg(args, 1);
  let xs = arg_parts(printing, x);
  let r = operand_representation(x);
  let ws = values_as_words(xs, c_values_of(r));
  let d = p.depth;
  let started = assigned(source_position(p, printing), d, v, c_type(v.representation), b"0");
  let c = name_of(started, v);
  let opened = line(
    started,
    d,
    Bytes::concat_all([b"if (", n, b" < 0 || ", n, b" > ", ascii_of_int(max_records(es)), b") {"]),
  );
  let raising = rejected(
    fragment_line(d + 1, released(opened, ty, r, xs)),
    b"Columns::new",
    n,
    b"0",
  );
  let raised = line(raising.printing, d + 1, raising.text);
  let made = line(line(raised, d, b"} else {"), d + 1, columns_alloc(c, es.len()));
  let i = temp(made);
  let filled = range(0, es.len()).fold(i.printing, |q: Printing, f: Int| {
    let e = es.get(f);
    let col = temp(q);
    line(
      line(
        col.printing,
        d + 1,
        Bytes::concat_all([
          b"Word ",
          col.name,
          b"; ",
          array_alloc(col.name, n, e),
          b" ",
          word_slot(c, ascii_of_int(f)),
          b" = ",
          col.name,
          b";",
        ]),
      ),
      d + 1,
      Bytes::concat_all([
        for_each(i.name, b"0", n),
        element_set(col.name, i.name, e, field_words(ws, es, f)),
        b" }",
      ]),
    )
  });
  check(p, line(copies_counted(filled, d + 1, n, i.name, ty, r, xs), d, b"}"))
}

fn columns_of_list(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  es: List<Element>,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = element_type(v.ty);
  let l = operand(printing, args, 0);
  let listed = list_type(ty);
  let d = p.depth;
  let count = temp(source_position(p, printing));
  let n = count.name;
  let started = assigned(
    line(
      count.printing,
      d,
      Bytes::concat_all([
        b"int64_t ",
        n,
        b" = (int64_t)",
        head_field(list_head(), l, b"len"),
        b";",
      ]),
    ),
    d,
    v,
    c_type(v.representation),
    b"0",
  );
  let c = name_of(started, v);
  let opened = line(
    started,
    d,
    Bytes::concat_all([b"if (", n, b" > ", ascii_of_int(max_records(es)), b") {"]),
  );
  let raising = rejected(
    fragment_line(d + 1, released(opened, listed, AsWord, [l])),
    b"Columns::of_list",
    n,
    b"0",
  );
  let raised = line(raising.printing, d + 1, raising.text);
  let made = line(line(raised, d, b"} else {"), d + 1, columns_alloc(c, es.len()));
  let cols = range(0, es.len()).fold(
    { printing: made, names: [] },
    |acc: { printing: Printing, names: List<Bytes> }, f: Int| {
      let col = temp(acc.printing);
      {
        printing: line(
          col.printing,
          d + 1,
          Bytes::concat_all([
            b"Word ",
            col.name,
            b"; ",
            array_alloc(col.name, n, es.get(f)),
            b" ",
            word_slot(c, ascii_of_int(f)),
            b" = ",
            col.name,
            b";",
          ]),
        ),
        names: acc.names.push(col.name),
      }
    },
  );
  let i = temp(cols.printing);
  let item = item_loop(i.printing, d + 1, l, n, i.name, ty);
  let ws = values_as_words(item.values, c_values_of(item.representation));
  let stored = range(0, es.len()).fold(item.printing, |q: Printing, f: Int|
    line(q, d + 2, element_set(cols.names.get(f), i.name, es.get(f), field_words(ws, es, f))));
  let released_list = released(line(stored, d + 1, b"}"), listed, AsWord, [l]);
  check(p, line(fragment_line(d + 1, released_list), d, b"}"))
}

fn columns_get(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  es: List<Element>,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let c = operand(printing, args, 0);
  let i = operand(printing, args, 1);
  let tested = index_check(p, printing, b"Columns::get", word_slot(c, b"0"), i);
  let ws = range(0, es.len()).fold([], |acc: List<Bytes>, f: Int| {
    let e = es.get(f);
    acc.concat(element_slots(word_slot(c, ascii_of_int(f)), i, e).take(words(e.layout)))
  });
  let record = temp(tested);
  let held = line(
    record.printing,
    p.depth,
    Bytes::concat_all([
      b"Word ",
      record.name,
      b"[",
      ascii_of_int(max(1, ws.len())),
      b"] = {",
      if ws.len() == 0 { b"0" } else { Bytes::join(ws, b", ") },
      b"};",
    ]),
  );
  parts_declared(p, held, v, parts_read(record.name, c_values_of(v.representation)))
}

fn columns_set(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  es: List<Element>,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let ty = element_type(v.ty);
  let fields = field_types(ty);
  let i = operand(printing, args, 1);
  let x = operand_arg(args, 2);
  let xs = arg_parts(printing, x);
  let r = operand_representation(x);
  let ws = values_as_words(xs, c_values_of(r));
  let d = p.depth;
  let started = assigned(
    source_position(p, printing),
    d,
    v,
    c_type(v.representation),
    operand(printing, args, 0),
  );
  let c = name_of(started, v);
  let n = temp(started);
  let opened = line(
    line(
      n.printing,
      d,
      Bytes::concat_all([b"int64_t ", n.name, b" = ", array_len(word_slot(c, b"0")), b";"]),
    ),
    d,
    Bytes::concat_all([b"if ((uint64_t)", i, b" >= (uint64_t)", n.name, b") {"]),
  );
  let x_go = fragment_line(d + 1, released(opened, ty, r, xs));
  let raising = rejected(
    fragment_line(d + 1, released(x_go, v.ty, AsWord, [c])),
    b"Columns::set",
    i,
    n.name,
  );
  let raised = line(raising.printing, d + 1, Bytes::concat_all([c, b" = 0; ", raising.text]));
  let b = temp(line(raised, d, b"} else {"));
  let column_type = |f: Int|
    array_type(match fields.at(f) { Some(t) -> t, None -> unknown_type() });
  let dups = Bytes::join(
    range(0, es.len()).map(|f: Int|
      pieces_text(
        duped(b.printing, column_type(f), AsWord, [word_slot(b.name, ascii_of_int(f))]).out,
      )).filter(|t: Bytes| t.len() > 0),
    b" ",
  );
  let old = released(b.printing, v.ty, AsWord, [c]);
  let block = pieces(
    old.printing,
    [
      Text(
        Bytes::concat_all([
          pad(d + 1),
          b"if (ply_obj(",
          c,
          b")->rc != 1) { Word ",
          b.name,
          b" = ",
          columns_allocation(es.len()),
          b"; memcpy(ply_words(",
          b.name,
          b"), ply_words(",
          c,
          b"), ",
          ascii_of_int(8 * es.len()),
          b"); ",
          dups,
          b" ",
        ]),
      ),
    ].concat(
      old.out,
    ).push(
      Text(Bytes::concat_all([b" ", c, b" = ", b.name, b"; }\n"])),
    ),
  );
  let written = range(0, es.len()).fold(block, |q: Printing, f: Int| {
    let e = es.get(f);
    let col = temp(q);
    let held = line(
      col.printing,
      d + 1,
      Bytes::concat_all([b"{ Word ", col.name, b" = ", word_slot(c, ascii_of_int(f)), b";"]),
    );
    let copy_unless_unique = array_writable(held, d + 2, col.name, n.name, e, column_type(f));
    let replaced = parts_released(
      copy_unless_unique,
      layout_parts(printing.constructors, element_type(column_type(f)), e.layout, 0),
      element_slots(col.name, i, e),
    );
    line(
      line(
        fragment_line(d + 2, replaced),
        d + 2,
        Bytes::concat_all([
          element_set(col.name, i, e, field_words(ws, es, f)),
          b" ",
          word_slot(c, ascii_of_int(f)),
          b" = ",
          col.name,
          b";",
        ]),
      ),
      d + 1,
      b"}",
    )
  });
  check(p, line(written, d, b"}"))
}

fn element_type(ty: Type) -> Type = type_arg(ty, 0)

fn type_arg(ty: Type, k: Int) -> Type =
  match ty {
    NamedType(c) -> match c.args.at(k) { Some(t) -> t, None -> unknown_type() },
    _ -> unknown_type(),
  }

fn operand_arg(args: List<Arg>, k: Int) -> Arg =
  match args.at(k) { Some(a) -> a, None -> ZeroOperand(AsWord) }

fn for_each(i: Bytes, from: Bytes, n: Bytes) -> Bytes =
  Bytes::concat_all([b"for (int64_t ", i, b" = ", from, b"; ", i, b" < ", n, b"; ", i, b"++) { "])

fn element_slot(a: Bytes, i: Bytes, stride: Int, j: Int) -> Bytes =
  Bytes::concat_all([
    b"ply_words(",
    a,
    b")[(",
    i,
    b") * ",
    ascii_of_int(stride),
    b" + ",
    ascii_of_int(head_words(array_head()) + j),
    b"]",
  ])

fn element_slots(a: Bytes, i: Bytes, e: Element) -> List<Bytes> =
  range(0, e.stride).map(|j: Int| element_slot(a, i, e.stride, j))

fn element_set(a: Bytes, i: Bytes, e: Element, ws: List<Bytes>) -> Bytes =
  Bytes::join(
    range(0, e.stride).map(|j: Int|
      Bytes::concat_all([
        element_slot(a, i, e.stride, j),
        b" = ",
        match ws.at(j) { Some(w) -> w, None -> b"0" },
        b";",
      ])),
    b" ",
  )

fn element_values(a: Bytes, i: Bytes, e: Element, r: Representation) -> List<Bytes> =
  parts_read(
    Bytes::concat_all([
      b"(ply_words(",
      a,
      b") + ",
      ascii_of_int(head_words(array_head())),
      b" + (",
      i,
      b") * ",
      ascii_of_int(e.stride),
      b")",
    ]),
    c_values_of(r),
  )

fn field_words(ws: List<Bytes>, es: List<Element>, f: Int) -> List<Bytes> / {abort.raise} =
  ws.drop(es.take(f).fold(0, |n: Int, e: Element| n + words(e.layout))).take(
    words(es.get(f).layout),
  )

fn array_alloc(a: Bytes, n: Bytes, e: Element) -> Bytes =
  Bytes::concat_all([
    a,
    b" = ply_alloc(ctx, ",
    array_bytes(n, e),
    b"); ",
    array_len(a),
    b" = ",
    n,
    b";",
  ])

fn array_bytes(n: Bytes, e: Element) -> Bytes =
  Bytes::concat_all([
    ascii_of_int(header_bytes() + 8 * head_words(array_head())),
    b" + 8 * (",
    n,
    b") * ",
    ascii_of_int(e.stride),
  ])

fn array_len(a: Bytes) -> Bytes = head_field(array_head(), a, b"len")

fn columns_alloc(c: Bytes, k: Int) -> Bytes =
  Bytes::concat_all([c, b" = ", columns_allocation(k), b";"])

fn columns_allocation(k: Int) -> Bytes =
  Bytes::concat_all([b"ply_alloc(ctx, ", ascii_of_int(header_bytes() + 8 * k), b")"])

fn max_elements(e: Element) -> Int / {abort.raise} = min(67108864, 4294967295 / e.stride)

fn max_records(es: List<Element>) -> Int / {abort.raise} =
  es.fold(67108864, |m: Int, e: Element| min(m, max_elements(e)))

fn rejected(
  printing: Printing,
  what: Bytes,
  n: Bytes,
  len: Bytes,
) -> { printing: Printing, text: Bytes } / {abort.raise} = {
  let helper = builtin_helper(b"?refused");
  {
    printing: native_noted(printing, helper),
    text: Bytes::concat_all([
      helper,
      b"_p(ctx, ",
      ascii_of_int(rejection(what)),
      b", ",
      n,
      b", ",
      len,
      b", 0);",
    ]),
  }
}

fn parts_declared(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  expressions: List<Bytes>,
) -> Printing = {
  let n = named(printing, v);
  let ts = c_types(v.representation);
  let ns = part_names(n.name, v.representation);
  range(0, ns.len()).fold(n.printing, |q: Printing, k: Int|
    line(
      q,
      p.depth,
      Bytes::concat_all([nth(ts, k), b" ", nth(ns, k), b" = ", nth(expressions, k), b";"]),
    ))
}

fn at_top() -> InstructionContext =
  {
    u: {
      symbol: b"ply_m_1f_1",
      base: 0,
      result: AsWord,
      site: None,
      arm: None,
      looping: None,
      handler_jump: None,
      group: None,
      unwinds: [],
      epilogue: b"",
    },
    at: span_between(10, 20),
    exit_statement: b"return 0;",
    depth: 0,
  }

test "a list literal is laid out by the emitted code, its tail holding what fits in one" {
  let made_of = |item: Type, args: List<Arg>|
    pieces_text(
      list_printed(
        at_top(),
        empty_printing(Map::new().insert(0, b"p0")),
        Some({ id: 1, ty: list_type(item), representation: AsWord }),
        { made: ListAllocation(args.len()), args: args, reuse: None },
      ).out,
    );
  let made = |args: List<Arg>| made_of(string_type(), args);
  let laid = container_layouts().list;
  let tail = |k: Int| Bytes::concat_all([b"[", ascii_of_int(laid.tail + k), b"] = "]);
  let two = made([VarOperand(local_var(0, string_type(), AsWord)), ZeroOperand(AsWord)]);
  let has = |text: Bytes, t: Bytes|
    assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  has(two, b"ply_list_room(ctx, 2, 1)");
  has(two, tail(0).concat(b"p0;"));
  has(two, tail(1).concat(b"0;"));
  has(two, b"))->tail_len = 2;");
  assert_eq(made([]).index_of(b")["), None);
  let dec = made_of(decimal_type(), [ZeroOperand(AsDecimal)]);
  has(dec, b"ply_list_room(ctx, 1, 2)");
  has(dec, tail(1).concat(b"("));
  [made([]), two].fold((), |_: Unit, text: Bytes| assert_eq(text.index_of(b"ctx->failed"), None))
}

test "a list literal past a tail's room lays its whole leaves under a branch and the rest in its tail" {
  let width = container_layouts().trie.width;
  let n = 2 * width + 3;
  let text = pieces_text(
    list_printed(
      at_top(),
      empty_printing(Map::new()),
      Some({ id: 1, ty: list_type(int_type()), representation: AsWord }),
      { made: ListAllocation(n), args: range(0, n).map(IntOperand), reuse: None },
    ).out,
  );
  let count = |t: Bytes|
    range(0, text.len()).fold(0, |c: Int, i: Int|
      if text.slice(i, text.len()).starts_with(t) { c + 1 } else { c });
  assert_eq(
    count(
      Bytes::concat_all([b"ply_node(ctx, ", ascii_of_int(container_layouts().trie.leaf), b", "]),
    ),
    2,
  );
  assert_eq(
    count(
      Bytes::concat_all([b"ply_node(ctx, ", ascii_of_int(container_layouts().trie.branch), b", "]),
    ),
    1,
  );
  let laid = container_layouts().list;
  let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  has(b"->len = 2;");
  has(Bytes::concat_all([b"[", ascii_of_int(laid.root), b"] = t"]));
  has(b"))->tail_len = 3;")
}

test "a list's item is read where it lies and its rest shares its trie, neither through the runtime" {
  let op = |c: ContainerOp, item: Type, into: Var|
    pieces_text(
      container_op(
        at_top(),
        empty_printing(Map::new().insert(0, b"p0")),
        Some(into),
        c,
        [VarOperand({ id: 0, ty: list_type(item), representation: AsWord }), IntOperand(2)],
        { takes: [false, false], owned: c == Rest, fails: false, suspends: false },
      ).out,
    );
  let item = op(ItemAt, string_type(), local_var(1, string_type(), AsWord));
  let scalar = op(ItemAt, int_type(), local_var(1, int_type(), AsInt));
  let rest = op(Rest, string_type(), {
    id: 1,
    ty: list_type(string_type()),
    representation: AsWord,
  });
  let ints = op(Rest, int_type(), { id: 1, ty: list_type(int_type()), representation: AsWord });
  [item, scalar, rest, ints].fold((), |_: Unit, text: Bytes| {
    assert_eq([text.index_of(b"rt_list_at_p"), text.index_of(b"rt_list_rest_p")], [None, None]);
    assert_eq(text.index_of(b"ctx->failed"), None)
  });
  [item, scalar].fold((), |_: Unit, text: Bytes|
    assert(!counts_any(text), Some(String::of_bytes_lossy(text))));
  assert(rest.split(call_start(dup_fn(), [])).len() > 2, Some(String::of_bytes_lossy(rest)));
  assert_eq(ints.split(call_start(dup_fn(), [])).len(), 2);
  assert(scalar.index_of(b"int64_t ") != None, Some(String::of_bytes_lossy(scalar)))
}

test "an array of `Int`s holds each as its bits a word apart, with no shape, and a bad length raises" {
  let int = int_type();
  let printing = container_op(
    at_top(),
    empty_printing(Map::new().insert(0, b"p0")),
    Some({ id: 1, ty: array_type(int), representation: AsWord }),
    ArrayNew({ layout: layout_of(no_constructors(), int), stride: 1 }),
    [VarOperand({ id: 0, ty: int, representation: AsInt }), IntOperand(7)],
    { takes: [false, true], owned: true, fails: true, suspends: false },
  );
  let text = pieces_text(printing.out);
  let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  let ints = { layout: layout_of(no_constructors(), int), stride: 1 };
  has(Bytes::concat_all([b" = ply_alloc(ctx, ", array_bytes(b"p0", ints), b");"]));
  has(Bytes::concat_all([array_len(b"t1"), b" = p0;"]));
  has(b" * 1 + 1] = (Word)(INT64_C(7));");
  has(b"builtin_elaborated_refused_p(ctx, 0, p0, 0, 0);");
  assert_eq([text.index_of(b"builtin_array_"), text.index_of(b"->aux")], [None, None])
}

test "an array of records holds each record's words in place, and a write lets go of the one it replaces by its type" {
  let int = int_type();
  let rec = RecordType([{ name: b"s", ty: string_type() }, { name: b"x", ty: float_type() }]);
  let array = array_type(rec);
  let printing = container_op(
    at_top(),
    empty_printing(Map::new().insert(0, b"p0").insert(1, b"p1").insert(2, b"p2")),
    Some({ id: 3, ty: array, representation: AsWord }),
    ArraySet({ layout: layout_of(no_constructors(), rec), stride: 2 }),
    [
      VarOperand({ id: 0, ty: array, representation: AsWord }),
      VarOperand({ id: 1, ty: int, representation: AsInt }),
      VarOperand({
        id: 2,
        ty: rec,
        representation: AsFlattened([
          { name: b"s", representation: AsWord },
          { name: b"x", representation: AsFloat },
        ]),
      }),
    ],
    { takes: [true, false, true], owned: true, fails: true, suspends: false },
  );
  let text = pieces_text(printing.out);
  let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  has(b") * 2); memcpy(ply_words(");
  has(b"rt_note_update_p(ctx, in_place, in_place ? 0 : ");
  has(call_start(release_fn(), [b"ctx", b"ply_words(t1)[(p1) * 2 + 1]"]));
  has(b"ply_words(t1)[(p1) * 2 + 2] = ply_f64_bits(");
  has(b"builtin_elaborated_refused_p(ctx, 5, p1, ")
}

test "a field of a Columns' record is read from its column in place, an index naming no record raising" {
  let float = float_type();
  let printing = container_op(
    at_top(),
    empty_printing(Map::new().insert(0, b"p0").insert(1, b"p1")),
    Some({ id: 2, ty: float, representation: AsFloat }),
    ColumnField({ k: 2, column: { layout: layout_of(no_constructors(), float), stride: 1 } }),
    [
      VarOperand({ id: 0, ty: columns_type(RecordType([])), representation: AsWord }),
      VarOperand({ id: 1, ty: int_type(), representation: AsInt }),
    ],
    { takes: [false, false], owned: false, fails: true, suspends: false },
  );
  let text = pieces_text(printing.out);
  let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
  has(Bytes::concat_all([b"(uint64_t)p1 >= (uint64_t)", array_len(b"ply_words(p0)[2]")]));
  has(b"builtin_elaborated_refused_p(ctx, 6, p1, ");
  has(b"(ply_words(ply_words(p0)[2]) + 1 + (p1) * 1)[0]");
  assert(!allocates(text), Some(String::of_bytes_lossy(text)))
}
