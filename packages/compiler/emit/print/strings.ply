import std.bytes (first_offset, contains_bytes, ascii_of_int)
import compiler.syntax.parsing (span_between)
import compiler.check.types (Type, encode_type, int_type, string_type, bytes_type)
import compiler.emit.layout (header_bytes, head_field, head_words, text_head, text_block_bytes)
import compiler.emit.typed_ir.statics (is_text)
import compiler.emit.roots (builtin_helper)
import compiler.emit.pieces (pieces_text)
import compiler.emit.typed_ir (local_var, Representation, AsInt, AsBool, AsFixed, AsWord, AsAddress,
                               Variable, Arg, VariableOperand, IntOperand, variable_text)
import compiler.emit.typed_ir.strings (StringOperation, AllocateBytes, CopyBytes, ByteSet, ByteRead,
                                       U32Read, AppendBytes, BytesEqual, FindBytes, CharCount,
                                       CharStart, ScanBytes)
import compiler.emit.print.text (Printing, InstructionContext, empty_printing, line, named, name_of,
                                 arg_text, assigned, check, unsupported, native_noted)
import compiler.emit.c (IntKind, SizedIntKind, kind_c_type)
import compiler.emit.print.count_functions (last_function, free_function, call_text, call_start)

pub fn string_operation(
  p: InstructionContext,
  printing: Printing,
  into: Option<Variable>,
  operation: StringOperation,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let a = |k: Int| match args.at(k) { Some(x) -> arg_text(printing, x), None -> b"0" };
  match operation {
    CopyBytes ->
      line(
        printing,
        p.depth,
        Bytes::concat_all([
          b"memcpy(",
          bytes_of(a(0)),
          b" + ",
          a(1),
          b", ",
          at_address(a(2)),
          b" + ",
          a(3),
          b", (size_t)",
          a(4),
          b");",
        ]),
      ),
    ByteSet ->
      line(
        printing,
        p.depth,
        Bytes::concat_all([bytes_of(a(0)), b"[", a(1), b"] = (unsigned char)", a(2), b";"]),
      ),
    _ -> match into {
      None ->
        unsupported(
          b"an operation over a string's bytes whose result goes unread",
          ascii_of_int(args.len()),
        ),
      Some(v) ->
        operation_with_result(p, printing, v, operation, args.map(|x: Arg| arg_text(printing, x))),
    },
  }
}

fn operation_with_result(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  operation: StringOperation,
  operands: List<Bytes>,
) -> Printing / {abort.raise} = {
  let a = |k: Int| match operands.at(k) { Some(x) -> x, None -> b"0" };
  let d = p.depth;
  let set = |e: Bytes| assigned(printing, d, v, c_type(v.representation), e);
  let computed = |start: Bytes, body: (Bytes) -> Bytes| {
    let declared = assigned(printing, d, v, c_type(v.representation), start);
    line(declared, d, body(name_of(declared, v)))
  };
  match operation {
    AllocateBytes -> {
      let n = named(printing, v);
      allocate_text(
        p,
        line(n.printing, d, Bytes::concat_all([b"Word ", n.name, b";"])),
        n.name,
        v.ty,
        a(0),
        a(0),
      )
    },
    AppendBytes -> grown(p, printing, v, a(0), a(1), a(2)),
    ByteRead -> set(Bytes::concat_all([b"(int64_t)", at_address(a(0)), b"[", a(1), b"]"])),
    U32Read ->
      computed(b"0", |x: Bytes|
        Bytes::concat_all([
          b"{ uint32_t sw; memcpy(&sw, ",
          at_address(a(0)),
          b" + ",
          a(1),
          b", 4); ",
          x,
          b" = ply_le32(sw); }",
        ])),
    BytesEqual ->
      set(
        Bytes::concat_all([
          b"memcmp(",
          at_address(a(0)),
          b" + ",
          a(1),
          b", ",
          at_address(a(2)),
          b" + ",
          a(3),
          b", (size_t)",
          a(4),
          b") == 0",
        ]),
      ),
    FindBytes ->
      computed(b"-1", |x: Bytes|
        Bytes::concat_all([
          b"{ const unsigned char *sh = ",
          at_address(a(0)),
          b", *sd = ",
          at_address(a(2)),
          b"; int64_t sn = ",
          a(3),
          b"; for (int64_t si = ",
          a(4),
          b"; si + sn <= ",
          a(1),
          b"; si++) if (sn == 0 || (sh[si] == sd[0] && memcmp(sh + si, sd, (size_t)sn) == 0)) { ",
          x,
          b" = si; break; } }",
        ])),
    CharCount ->
      computed(b"0", |x: Bytes|
        Bytes::concat_all([
          b"{ const unsigned char *sh = ",
          at_address(a(0)),
          b"; for (int64_t si = 0; si < ",
          a(1),
          b"; si++) ",
          x,
          b" += (sh[si] & 0xC0) != 0x80; }",
        ])),
    CharStart ->
      computed(b"-1", |x: Bytes|
        Bytes::concat_all([
          b"{ const unsigned char *sh = ",
          at_address(a(0)),
          b"; int64_t sk = ",
          a(2),
          b", sc = 0, si = 0; if (sk >= 0) { for (; si < ",
          a(1),
          b"; si++) if ((sh[si] & 0xC0) != 0x80) { if (sc == sk) break; sc++; } if (si < ",
          a(1),
          b" || sc == sk) ",
          x,
          b" = si; } }",
        ])),
    ScanBytes(s) ->
      computed(b"0", |x: Bytes|
        Bytes::concat_all([
          b"{ const unsigned char *sh = ",
          at_address(a(0)),
          b", *sd = ",
          at_address(a(3)),
          b"; uint64_t set[4] = {0, 0, 0, 0}; for (int64_t si = 0; si < ",
          a(4),
          b"; si++) set[sd[si] >> 6] |= (uint64_t)1 << (sd[si] & 63); int64_t se = ",
          a(1),
          b" - ",
          a(2),
          b" < ",
          a(5),
          b" ? ",
          a(1),
          b" : ",
          a(2),
          b" + ",
          a(5),
          b"; ",
          x,
          b" = se; for (int64_t si = ",
          a(2),
          b"; si < se; si++) if ((int)((set[sh[si] >> 6] >> (sh[si] & 63)) & 1) == ",
          if s.until { b"1" } else { b"0" },
          b") { ",
          x,
          b" = si; break; } }",
        ])),
    _ ->
      unsupported(
        b"a variable that is used as text but is the result of an operation that returns nothing",
        variable_text(v),
      ),
  }
}

fn grown(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  x: Bytes,
  source: Bytes,
  n: Bytes,
) -> Printing / {abort.raise} = {
  let declared = named(printing, v);
  let o = declared.name;
  let d = p.depth;
  let opened = line(
    declared.printing,
    d,
    Bytes::concat_all([
      b"Word ",
      o,
      b"; { int64_t sl = (int64_t)",
      text_field(x, b"len"),
      b", sn = ",
      n,
      b"; if (ply_obj(",
      x,
      b")->rc == 1 && (int64_t)",
      text_field(x, b"room"),
      b" >= sl + sn) { memcpy(",
      bytes_of(x),
      b" + sl, ",
      at_address(source),
      b", (size_t)sn); ",
      text_field(x, b"len"),
      b" = (uint32_t)(sl + sn); ",
      o,
      b" = ",
      x,
      b"; } else {",
    ]),
  );
  let made = allocate_text(
    { ..p, depth: d + 1 },
    opened,
    o,
    v.ty,
    b"sl + sn",
    b"(sl + sn < 8 ? 8 : sl + sn > 0x7fffffff ? sl + sn : 2 * (sl + sn))",
  );
  line(
    made,
    d,
    Bytes::concat_all([
      b"  memcpy(",
      bytes_of(o),
      b", ",
      bytes_of(x),
      b", (size_t)sl); memcpy(",
      bytes_of(o),
      b" + sl, ",
      at_address(source),
      b", (size_t)sn); if (",
      call_text(last_function(), [b"ctx", x]),
      b") ",
      call_text(free_function(), [b"ctx", x, text_block_bytes(text_field(x, b"room"))]),
      b"; } }",
    ]),
  )
}

fn allocate_text(
  p: InstructionContext,
  printing: Printing,
  o: Bytes,
  ty: Type,
  len: Bytes,
  room: Bytes,
) -> Printing / {abort.raise} =
  if !is_text(ty) { unsupported(b"a text value whose type is not a text type", encode_type(ty)) }
  else {
    line(
      printing,
      p.depth,
      Bytes::concat_all([
        b"{ int64_t sr = ",
        room,
        b"; ",
        o,
        b" = (Word)ply_alloc(ctx, ",
        text_block_bytes(b"sr"),
        b"); ",
        text_field(o, b"len"),
        b" = (uint32_t)(",
        len,
        b"); ",
        text_field(o, b"room"),
        b" = (uint32_t)sr; }",
      ]),
    )
  }

pub fn taken_printed(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  n: Arg,
) -> Printing / {abort.raise} = {
  let count = arg_text(printing, n);
  let declared = named(printing, v);
  let o = declared.name;
  let made = allocate_text(
    p,
    line(declared.printing, p.depth, Bytes::concat_all([b"Word ", o, b";"])),
    o,
    v.ty,
    count,
    count,
  );
  let helper = builtin_helper(b"?taken");
  check(
    p,
    line(
      native_noted(made, helper),
      p.depth,
      Bytes::concat_all([helper, b"_p(ctx, (Word)(intptr_t)", bytes_of(o), b", ", count, b");"]),
    ),
  )
}

pub fn payload_printed(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  of: Variable,
) -> Printing =
  assigned(
    printing,
    p.depth,
    v,
    c_type(v.representation),
    b"(Word)(intptr_t)".concat(bytes_of(name_of(printing, of))),
  )

pub fn bytes_of(x: Bytes) -> Bytes =
  Bytes::concat_all([
    b"((unsigned char *)&ply_words(",
    x,
    b")[",
    ascii_of_int(head_words(text_head())),
    b"])",
  ])

fn at_address(a: Bytes) -> Bytes = Bytes::concat_all([b"((unsigned char *)(intptr_t)", a, b")"])

pub fn text_field(x: Bytes, f: Bytes) -> Bytes = head_field(text_head(), x, f)

fn c_type(r: Representation) -> Bytes =
  match r {
    AsInt -> kind_c_type(IntKind),
    AsBool -> kind_c_type(IntKind),
    AsFixed(w) -> kind_c_type(SizedIntKind(w)),
    _ -> b"Word",
  }

fn at_top() -> InstructionContext =
  {
    u: {
      symbol: b"ply_m_1f_1",
      base: 0,
      result: AsWord,
      site: None,
      arm: None,
      looping: None,
      handler_jump: None,
      group: None,
      unwinds: [],
      epilogue: b"",
    },
    at: span_between(10, 20),
    exit_statement: b"return 0;",
    depth: 0,
  }

fn printed(
  operation: StringOperation,
  into: Option<Variable>,
  args: List<Arg>,
) -> Bytes / {abort.raise} =
  pieces_text(
    string_operation(
      at_top(),
      empty_printing(
        range(0, 6).fold(Map::new(), |m: Map<Int, Bytes>, i: Int|
          m.insert(i, b"p".concat(ascii_of_int(i)))),
      ),
      into,
      operation,
      args,
    ).out,
  )

test "allocating a new string block requests the block header, the length-and-capacity struct and the capacity rounded up to a whole word, then writes the length and capacity" {
  let made = |ty: Type|
    printed(AllocateBytes, Some(local_var(9, ty, AsWord)), [
      VariableOperand(local_var(0, int_type(), AsInt)),
    ]);
  let string = made(string_type());
  assert_eq(
    [
      Bytes::concat_all([b"ply_alloc(ctx, ", text_block_bytes(b"sr")]),
      Bytes::concat_all([b"((", text_head().name, b" *)ply_words("]),
      b"))->len = ",
      b"))->room = ",
    ].filter(|part: Bytes| !contains_bytes(string, part)),
    [],
  );
  assert_eq(made(bytes_type()), string)
}

test "appending to a block writes in place only when its reference count is 1 and its capacity suffices, and otherwise copies and frees the old block by its size" {
  let grown = printed(AppendBytes, Some(local_var(9, bytes_type(), AsWord)), [
    VariableOperand(local_var(0, bytes_type(), AsWord)),
    VariableOperand(local_var(1, int_type(), AsAddress)),
    VariableOperand(local_var(2, int_type(), AsInt)),
  ]);
  assert(contains_bytes(grown, b"ply_obj(p0)->rc == 1"), None);
  assert(contains_bytes(grown, Bytes::concat_all([text_field(b"p0", b"room"), b" >= "])), None);
  let out = match grown.index_of(b"} else {") {
    Some(i) -> grown.slice(i, grown.len()),
    None -> b"",
  };
  let copy = first_offset(out, b"memcpy(");
  assert(copy >= 0 && first_offset(out, call_start(free_function(), [b"ctx", b"p0"])) > copy, None)
}

test "bytes returned by a marshalling call are copied into a newly allocated block of the same length, and the copy can fail" {
  let printing = taken_printed(
    at_top(),
    empty_printing(Map::new().insert(0, b"p0")),
    local_var(9, string_type(), AsWord),
    VariableOperand(local_var(0, int_type(), AsInt)),
  );
  let t = pieces_text(printing.out);
  let made = first_offset(t, b"ply_alloc");
  let copied = first_offset(t, b"builtin_elaborated_taken_p(ctx, ");
  assert(made > 0 && copied > made, None);
  assert(contains_bytes(t, b"if (ctx->failed)"), None)
}
