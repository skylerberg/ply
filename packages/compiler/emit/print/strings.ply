//! The operations over the bytes of strings and byte strings printed, every block laid with its head
//! (`layout.text_head`) and then its bytes: its head's `len` of them, room for its `room`.

import std.bytes (ascii_of_int)
import compiler.syntax.parsing (span_between)
import compiler.check.types (Type, encode_type, int_type, string_type, bytes_type)
import compiler.emit.layout (header_bytes, head_field, head_words, text_head, text_bytes)
import compiler.emit.typed_ir.statics (is_text)
import compiler.emit.roots (builtin_helper)
import compiler.emit.pieces (pieces_text)
import compiler.emit.typed_ir (Representation, AsInt, AsBool, AsFixed, AsWord, AsAddress, Var, Arg,
                               VarOperand, IntOperand, var_text)
import compiler.emit.typed_ir.strings (StringOp, AllocateBytes, CopyBytes, ByteSet, ByteRead,
                                       U32Read, AppendBytes, BytesEqual, FindBytes, CharCount,
                                       CharStart, ScanBytes)
import compiler.emit.print.text (Printing, InstructionContext, empty_printing, line, named, name_of,
                                 arg_text, assigned, check, unsupported)
import compiler.emit.c (IntKind, SizedIntKind, kind_c_type)
import compiler.emit.print.count_functions (last_fn, free_fn, call_text, call_start)

/// Operation `op` over `args`, answering into `into` where it answers.
pub fn string_op(
  p: InstructionContext,
  printing: Printing,
  into: Option<Var>,
  op: StringOp,
  args: List<Arg>,
) -> Printing / {abort.raise} = {
  let a = |k: Int| match args.at(k) { Some(x) -> arg_text(printing, x), None -> b"0" };
  match op {
    CopyBytes ->
      line(
        printing,
        p.depth,
        Bytes::concat_all([
          b"memcpy(",
          bytes_of(a(0)),
          b" + ",
          a(1),
          b", ",
          at_address(a(2)),
          b" + ",
          a(3),
          b", (size_t)",
          a(4),
          b");",
        ]),
      ),
    ByteSet ->
      line(
        printing,
        p.depth,
        Bytes::concat_all([bytes_of(a(0)), b"[", a(1), b"] = (unsigned char)", a(2), b";"]),
      ),
    _ -> match into {
      None ->
        unsupported(
          b"an operation over a string's bytes whose answer goes unread",
          ascii_of_int(args.len()),
        ),
      Some(v) -> op_with_result(p, printing, v, op, args.map(|x: Arg| arg_text(printing, x))),
    },
  }
}

fn op_with_result(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  op: StringOp,
  operands: List<Bytes>,
) -> Printing / {abort.raise} = {
  let a = |k: Int| match operands.at(k) { Some(x) -> x, None -> b"0" };
  let d = p.depth;
  let set = |e: Bytes| assigned(printing, d, v, c_type(v.representation), e);
  // `v` declared at `start`, then set by the C `body` writes of its name.
  let computed = |start: Bytes, body: (Bytes) -> Bytes| {
    let declared = assigned(printing, d, v, c_type(v.representation), start);
    line(declared, d, body(name_of(declared, v)))
  };
  match op {
    AllocateBytes -> {
      let n = named(printing, v);
      text_alloc(
        p,
        line(n.printing, d, Bytes::concat_all([b"Word ", n.name, b";"])),
        n.name,
        v.ty,
        a(0),
        a(0),
      )
    },
    AppendBytes -> grown(p, printing, v, a(0), a(1), a(2)),
    ByteRead -> set(Bytes::concat_all([b"(int64_t)", at_address(a(0)), b"[", a(1), b"]"])),
    U32Read ->
      computed(b"0", |x: Bytes|
        Bytes::concat_all([
          b"{ uint32_t sw; memcpy(&sw, ",
          at_address(a(0)),
          b" + ",
          a(1),
          b", 4); ",
          x,
          b" = ply_le32(sw); }",
        ])),
    BytesEqual ->
      set(
        Bytes::concat_all([
          b"memcmp(",
          at_address(a(0)),
          b" + ",
          a(1),
          b", ",
          at_address(a(2)),
          b" + ",
          a(3),
          b", (size_t)",
          a(4),
          b") == 0",
        ]),
      ),
    FindBytes ->
      computed(b"-1", |x: Bytes|
        Bytes::concat_all([
          b"{ const unsigned char *sh = ",
          at_address(a(0)),
          b", *sd = ",
          at_address(a(2)),
          b"; int64_t sn = ",
          a(3),
          b"; for (int64_t si = ",
          a(4),
          b"; si + sn <= ",
          a(1),
          b"; si++) if (sn == 0 || (sh[si] == sd[0] && memcmp(sh + si, sd, (size_t)sn) == 0)) { ",
          x,
          b" = si; break; } }",
        ])),
    CharCount ->
      computed(b"0", |x: Bytes|
        Bytes::concat_all([
          b"{ const unsigned char *sh = ",
          at_address(a(0)),
          b"; for (int64_t si = 0; si < ",
          a(1),
          b"; si++) ",
          x,
          b" += (sh[si] & 0xC0) != 0x80; }",
        ])),
    CharStart ->
      computed(b"-1", |x: Bytes|
        Bytes::concat_all([
          b"{ const unsigned char *sh = ",
          at_address(a(0)),
          b"; int64_t sk = ",
          a(2),
          b", sc = 0, si = 0; if (sk >= 0) { for (; si < ",
          a(1),
          b"; si++) if ((sh[si] & 0xC0) != 0x80) { if (sc == sk) break; sc++; } if (si < ",
          a(1),
          b" || sc == sk) ",
          x,
          b" = si; } }",
        ])),
    ScanBytes(s) ->
      computed(b"0", |x: Bytes|
        Bytes::concat_all([
          b"{ const unsigned char *sh = ",
          at_address(a(0)),
          b", *sd = ",
          at_address(a(3)),
          b"; uint64_t set[4] = {0, 0, 0, 0}; for (int64_t si = 0; si < ",
          a(4),
          b"; si++) set[sd[si] >> 6] |= (uint64_t)1 << (sd[si] & 63); int64_t se = ",
          a(1),
          b" - ",
          a(2),
          b" < ",
          a(5),
          b" ? ",
          a(1),
          b" : ",
          a(2),
          b" + ",
          a(5),
          b"; ",
          x,
          b" = se; for (int64_t si = ",
          a(2),
          b"; si < se; si++) if ((int)((set[sh[si] >> 6] >> (sh[si] & 63)) & 1) == ",
          if s.until { b"1" } else { b"0" },
          b") { ",
          x,
          b" = si; break; } }",
        ])),
    _ -> unsupported(b"an operation that answers nothing, answering", var_text(v)),
  }
}

/// `x` with `n` bytes from `src` appended, into `v`: in place where `x`'s one count was handed over
/// and its room holds them, else a fresh block of twice the room needed, `x` let go of.
fn grown(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  x: Bytes,
  src: Bytes,
  n: Bytes,
) -> Printing / {abort.raise} = {
  let declared = named(printing, v);
  let o = declared.name;
  let d = p.depth;
  let opened = line(
    declared.printing,
    d,
    Bytes::concat_all([
      b"Word ",
      o,
      b"; { int64_t sl = (int64_t)",
      text_field(x, b"len"),
      b", sn = ",
      n,
      b"; if (ply_obj(",
      x,
      b")->rc == 1 && (int64_t)",
      text_field(x, b"room"),
      b" >= sl + sn) { memcpy(",
      bytes_of(x),
      b" + sl, ",
      at_address(src),
      b", (size_t)sn); ",
      text_field(x, b"len"),
      b" = (uint32_t)(sl + sn); ",
      o,
      b" = ",
      x,
      b"; } else {",
    ]),
  );
  let made = text_alloc(
    { ..p, depth: d + 1 },
    opened,
    o,
    v.ty,
    b"sl + sn",
    b"(sl + sn < 8 ? 8 : sl + sn > 0x7fffffff ? sl + sn : 2 * (sl + sn))",
  );
  line(
    made,
    d,
    Bytes::concat_all([
      b"  memcpy(",
      bytes_of(o),
      b", ",
      bytes_of(x),
      b", (size_t)sl); memcpy(",
      bytes_of(o),
      b" + sl, ",
      at_address(src),
      b", (size_t)sn); if (",
      call_text(last_fn(), [b"ctx", x]),
      b") ",
      call_text(free_fn(), [b"ctx", x, text_bytes(text_field(x, b"room"))]),
      b"; } }",
    ]),
  )
}

/// `o`, declared already, set to a fresh block of `len` bytes with room for `room`; unprinted where
/// `ty` is no text's type.
fn text_alloc(
  p: InstructionContext,
  printing: Printing,
  o: Bytes,
  ty: Type,
  len: Bytes,
  room: Bytes,
) -> Printing / {abort.raise} =
  if !is_text(ty) { unsupported(b"text made at a type no text has", encode_type(ty)) } else {
    line(
      printing,
      p.depth,
      Bytes::concat_all([
        b"{ int64_t sr = ",
        room,
        b"; ",
        o,
        b" = (Word)ply_alloc(ctx, ",
        text_bytes(b"sr"),
        b"); ",
        text_field(o, b"len"),
        b" = (uint32_t)(",
        len,
        b"); ",
        text_field(o, b"room"),
        b" = (uint32_t)sr; }",
      ]),
    )
  }

/// The bytes `n` taken bytes of the context's crossing are copied into, a fresh block, into `v`.
pub fn taken_printed(
  p: InstructionContext,
  printing: Printing,
  v: Var,
  n: Arg,
) -> Printing / {abort.raise} = {
  let count = arg_text(printing, n);
  let declared = named(printing, v);
  let o = declared.name;
  let made = text_alloc(
    p,
    line(declared.printing, p.depth, Bytes::concat_all([b"Word ", o, b";"])),
    o,
    v.ty,
    count,
    count,
  );
  check(
    p,
    line(
      made,
      p.depth,
      Bytes::concat_all([
        builtin_helper(b"?taken"),
        b"_p(ctx, (Word)(intptr_t)",
        bytes_of(o),
        b", ",
        count,
        b");",
      ]),
    ),
  )
}

/// The address of the bytes the block `of` holds, into `v`.
pub fn payload_printed(p: InstructionContext, printing: Printing, v: Var, of: Var) -> Printing =
  assigned(
    printing,
    p.depth,
    v,
    c_type(v.representation),
    b"(Word)(intptr_t)".concat(bytes_of(name_of(printing, of))),
  )

/// The bytes of the block `x`, past its head, as an `unsigned char *`.
pub fn bytes_of(x: Bytes) -> Bytes =
  Bytes::concat_all([
    b"((unsigned char *)&ply_words(",
    x,
    b")[",
    ascii_of_int(head_words(text_head())),
    b"])",
  ])

/// The address an `AsAddress` holds, as an `unsigned char *`.
fn at_address(a: Bytes) -> Bytes = Bytes::concat_all([b"((unsigned char *)(intptr_t)", a, b")"])

/// Field `f` of the head of the string or byte string `x`.
pub fn text_field(x: Bytes, f: Bytes) -> Bytes = head_field(text_head(), x, f)

/// The C type of what an operation here answers: an integer's, a width's, else a word, an address
/// among them. `print.made` imports this module, so its `c_type` is not read here.
fn c_type(r: Representation) -> Bytes =
  match r {
    AsInt -> kind_c_type(IntKind),
    AsBool -> kind_c_type(IntKind),
    AsFixed(w) -> kind_c_type(SizedIntKind(w)),
    _ -> b"Word",
  }

/// Where an instruction of a root answering a word is printed, at the body's own depth.
fn at_top() -> InstructionContext =
  {
    u: {
      symbol: b"ply_m_1f_1",
      base: 0,
      result: AsWord,
      site: None,
      arm: None,
      looping: None,
      landing: None,
      group: None,
      unwinds: [],
      epilogue: b"",
    },
    at: span_between(10, 20),
    leave: b"return 0;",
    depth: 0,
  }

fn local(id: Int, ty: Type, rep: Representation) -> Var = { id: id, ty: ty, representation: rep }

/// What `op` over `args` prints, its operands' variables named `p0`, `p1`, ...
fn printed(op: StringOp, into: Option<Var>, args: List<Arg>) -> Bytes / {abort.raise} =
  pieces_text(
    string_op(
      at_top(),
      empty_printing(
        range(0, 6).fold(Map::new(), |m: Map<Int, Bytes>, i: Int|
          m.insert(i, b"p".concat(ascii_of_int(i)))),
      ),
      into,
      op,
      args,
    ).out,
  )

fn has(text: Bytes, part: Bytes) -> Bool = text.index_of(part) != None

/// Where `part` first stands in `text`, or -1.
fn place(text: Bytes, part: Bytes) -> Int =
  match text.index_of(part) { Some(i) -> i, None -> 0 - 1 }

test "a fresh block takes its header, its head and its room rounded up to a word, and holds its length and room" {
  let made = |ty: Type|
    printed(AllocateBytes, Some(local(9, ty, AsWord)), [VarOperand(local(0, int_type(), AsInt))]);
  let string = made(string_type());
  assert_eq(
    [
      Bytes::concat_all([b"ply_alloc(ctx, ", text_bytes(b"sr")]),
      Bytes::concat_all([b"((", text_head().name, b" *)ply_words("]),
      b"))->len = ",
      b"))->room = ",
    ].filter(|part: Bytes| !has(string, part)),
    [],
  );
  // A string's block and a byte string's are laid alike: no header field tells them apart.
  assert_eq(made(bytes_type()), string)
}

test "a block grows in place only through its one count and its room, and is let go of by its size else" {
  let grown = printed(AppendBytes, Some(local(9, bytes_type(), AsWord)), [
    VarOperand(local(0, bytes_type(), AsWord)),
    VarOperand(local(1, int_type(), AsAddress)),
    VarOperand(local(2, int_type(), AsInt)),
  ]);
  assert(has(grown, b"ply_obj(p0)->rc == 1"), None);
  assert(has(grown, Bytes::concat_all([text_field(b"p0", b"room"), b" >= "])), None);
  // Out of place, the old bytes are copied before the block is let go of.
  let out = match grown.index_of(b"} else {") {
    Some(i) -> grown.slice(i, grown.len()),
    None -> b"",
  };
  let copy = place(out, b"memcpy(");
  assert(copy >= 0 && place(out, call_start(free_fn(), [b"ctx", b"p0"])) > copy, None)
}

test "bytes a crossing answered are copied into a fresh block of as many, and the copy can fail" {
  let printing = taken_printed(
    at_top(),
    empty_printing(Map::new().insert(0, b"p0")),
    local(9, string_type(), AsWord),
    VarOperand(local(0, int_type(), AsInt)),
  );
  let t = pieces_text(printing.out);
  let made = place(t, b"ply_alloc");
  let copied = place(t, b"builtin_elaborated_taken_p(ctx, ");
  assert(made > 0 && copied > made, None);
  assert(has(t, b"if (ctx->failed)"), None)
}
