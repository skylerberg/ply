pub const decimal_helpers: Bytes =
  Bytes::concat_all([
    b"static const uint32_t ply_pow10[10] = { 1u, 10u, 100u, 1000u, 10000u, 100000u, 1000000u, 10000000u, 100000000u, 1000000000u };\n",
    b"typedef struct { uint32_t w[6]; int scale, neg; } PlyBig;\n",
    b"static inline PlyBig ply_dec_big(PlyDec d) {\n",
    b"  PlyBig b; uint64_t f = (uint64_t)d.lo, m = (uint64_t)d.hi;\n",
    b"  b.w[0] = (uint32_t)(f >> 32); b.w[1] = (uint32_t)m; b.w[2] = (uint32_t)(m >> 32);\n",
    b"  b.w[3] = 0; b.w[4] = 0; b.w[5] = 0;\n",
    b"  b.scale = (int)((f >> 16) & 0xFF); b.neg = (int)((f >> 31) & 1);\n",
    b"  return b;\n",
    b"}\n",
    b"static inline int ply_big_zero(const uint32_t *w) { return (w[0] | w[1] | w[2] | w[3] | w[4] | w[5]) == 0; }\n",
    b"static inline int ply_big_cmp(const uint32_t *a, const uint32_t *b) {\n",
    b"  for (int i = 5; i >= 0; i--) if (a[i] != b[i]) return a[i] < b[i] ? -1 : 1;\n",
    b"  return 0;\n",
    b"}\n",
    b"static inline void ply_big_add(const uint32_t *a, const uint32_t *b, uint32_t *r) {\n",
    b"  uint64_t c = 0;\n",
    b"  for (int i = 0; i < 6; i++) { uint64_t t = (uint64_t)a[i] + b[i] + c; r[i] = (uint32_t)t; c = t >> 32; }\n",
    b"}\n",
    b"static inline void ply_big_sub(const uint32_t *a, const uint32_t *b, uint32_t *r) {\n",
    b"  uint64_t c = 0;\n",
    b"  for (int i = 0; i < 6; i++) { uint64_t t = (uint64_t)a[i] - b[i] - c; r[i] = (uint32_t)t; c = (t >> 32) & 1; }\n",
    b"}\n",
    b"static inline void ply_big_mul_small(uint32_t *w, uint32_t k) {\n",
    b"  uint64_t c = 0;\n",
    b"  for (int i = 0; i < 6; i++) { uint64_t t = (uint64_t)w[i] * k + c; w[i] = (uint32_t)t; c = t >> 32; }\n",
    b"}\n",
    b"static inline uint32_t ply_big_div_small(uint32_t *w, uint32_t k) {\n",
    b"  uint64_t r = 0;\n",
    b"  for (int i = 5; i >= 0; i--) { uint64_t t = (r << 32) | w[i]; w[i] = (uint32_t)(t / k); r = t % k; }\n",
    b"  return (uint32_t)r;\n",
    b"}\n",
    b"static inline void ply_big_scaled(uint32_t *w, int k) {\n",
    b"  while (k > 0) { int s = k > 9 ? 9 : k; ply_big_mul_small(w, ply_pow10[s]); k -= s; }\n",
    b"}\n",
    b"static inline int ply_dec_fit(uint32_t *w, int *scale) {\n",
    b"  int upper = 5;\n",
    b"  while (upper > 0 && w[upper] == 0) upper--;\n",
    b"  if (upper <= 2 && *scale <= 28) return 0;\n",
    b"  int target = 0;\n",
    b"  if (upper > 2) {\n",
    b"    int lz = 0; uint32_t top = w[upper];\n",
    b"    while (!(top & 0x80000000u)) { top <<= 1; lz++; }\n",
    b"    target = (((upper * 32 - 64 - 1 - lz) * 77) >> 8) + 1;\n",
    b"    if (target > *scale) return 1;\n",
    b"  }\n",
    b"  if (target < *scale - 28) target = *scale - 28;\n",
    b"  *scale -= target;\n",
    b"  while (target > 0) {\n",
    b"    int s = target > 9 ? 9 : target;\n",
    b"    if (ply_big_div_small(w, ply_pow10[s]) != 0) return 1;\n",
    b"    target -= s;\n",
    b"  }\n",
    b"  while (w[3] | w[4] | w[5]) {\n",
    b"    if (*scale == 0 || ply_big_div_small(w, 10) != 0) return 1;\n",
    b"    *scale -= 1;\n",
    b"  }\n",
    b"  return 0;\n",
    b"}\n",
    b"static inline PlyDec ply_dec_packed(const uint32_t *w, int scale, int neg) {\n",
    b"  int zero = (w[0] | w[1] | w[2]) == 0;\n",
    b"  uint64_t flags = ((uint64_t)scale << 16) | (neg && !zero ? (uint64_t)1 << 31 : 0);\n",
    b"  PlyDec d; d.lo = (Word)(flags | ((uint64_t)w[0] << 32)); d.hi = (Word)((uint64_t)w[1] | ((uint64_t)w[2] << 32));\n",
    b"  return d;\n",
    b"}\n",
    b"static inline PlyDec ply_dec_zero(void) { PlyDec d; d.lo = 0; d.hi = 0; return d; }\n",
    b"static inline int ply_dec_add(PlyDec x, PlyDec y, int sub, PlyDec *r) {\n",
    b"  PlyBig a = ply_dec_big(x), b = ply_dec_big(y);\n",
    b"  if (ply_big_zero(a.w)) {\n",
    b"    *r = y;\n",
    b"    if (sub && !ply_big_zero(b.w)) r->lo = (Word)((uint64_t)r->lo ^ ((uint64_t)1 << 31));\n",
    b"    return 0;\n",
    b"  }\n",
    b"  if (ply_big_zero(b.w)) { *r = x; return 0; }\n",
    b"  int bneg = b.neg ^ sub, scale = a.scale > b.scale ? a.scale : b.scale, neg;\n",
    b"  uint32_t m[6];\n",
    b"  ply_big_scaled(a.w, scale - a.scale);\n",
    b"  ply_big_scaled(b.w, scale - b.scale);\n",
    b"  if (a.neg == bneg) { ply_big_add(a.w, b.w, m); neg = a.neg; }\n",
    b"  else if (ply_big_cmp(a.w, b.w) >= 0) { ply_big_sub(a.w, b.w, m); neg = a.neg; }\n",
    b"  else { ply_big_sub(b.w, a.w, m); neg = bneg; }\n",
    b"  if (ply_dec_fit(m, &scale)) return 1;\n",
    b"  *r = ply_dec_packed(m, scale, neg);\n",
    b"  return 0;\n",
    b"}\n",
    b"static inline int ply_dec_mul(PlyDec x, PlyDec y, PlyDec *r) {\n",
    b"  PlyBig a = ply_dec_big(x), b = ply_dec_big(y);\n",
    b"  if (ply_big_zero(a.w) || ply_big_zero(b.w)) { *r = ply_dec_zero(); return 0; }\n",
    b"  uint32_t m[6] = { 0, 0, 0, 0, 0, 0 };\n",
    b"  for (int i = 0; i < 3; i++) {\n",
    b"    uint64_t c = 0;\n",
    b"    for (int j = 0; j < 3; j++) { uint64_t t = (uint64_t)a.w[i] * b.w[j] + m[i + j] + c; m[i + j] = (uint32_t)t; c = t >> 32; }\n",
    b"    m[i + 3] = (uint32_t)c;\n",
    b"  }\n",
    b"  int scale = a.scale + b.scale;\n",
    b"  if (ply_dec_fit(m, &scale)) return 1;\n",
    b"  *r = ply_dec_packed(m, scale, a.neg ^ b.neg);\n",
    b"  return 0;\n",
    b"}\n",
    b"static inline PlyDec ply_dec_rem(PlyDec x, PlyDec y) {\n",
    b"  PlyBig a = ply_dec_big(x), b = ply_dec_big(y);\n",
    b"  if (ply_big_zero(a.w)) return ply_dec_zero();\n",
    b"  int scale = a.scale > b.scale ? a.scale : b.scale;\n",
    b"  ply_big_scaled(a.w, scale - a.scale);\n",
    b"  ply_big_scaled(b.w, scale - b.scale);\n",
    b"  int c = ply_big_cmp(a.w, b.w);\n",
    b"  if (c == 0) return ply_dec_zero();\n",
    b"  if (c < 0) return x;\n",
    b"  uint32_t r[6] = { 0, 0, 0, 0, 0, 0 };\n",
    b"  for (int i = 191; i >= 0; i--) {\n",
    b"    for (int k = 5; k > 0; k--) r[k] = (r[k] << 1) | (r[k - 1] >> 31);\n",
    b"    r[0] = (r[0] << 1) | ((a.w[i / 32] >> (i % 32)) & 1);\n",
    b"    if (ply_big_cmp(r, b.w) >= 0) ply_big_sub(r, b.w, r);\n",
    b"  }\n",
    b"  return ply_dec_packed(r, scale, a.neg);\n",
    b"}\n",
    b"static inline int64_t ply_dec_order(PlyDec x, PlyDec y) {\n",
    b"  PlyBig a = ply_dec_big(x), b = ply_dec_big(y);\n",
    b"  int za = ply_big_zero(a.w), zb = ply_big_zero(b.w);\n",
    b"  if (zb) return za ? 0 : (a.neg ? -1 : 1);\n",
    b"  if (za) return b.neg ? 1 : -1;\n",
    b"  if (a.neg != b.neg) return a.neg ? -1 : 1;\n",
    b"  int scale = a.scale > b.scale ? a.scale : b.scale;\n",
    b"  ply_big_scaled(a.w, scale - a.scale);\n",
    b"  ply_big_scaled(b.w, scale - b.scale);\n",
    b"  int c = ply_big_cmp(a.w, b.w);\n",
    b"  return a.neg ? -c : c;\n",
    b"}\n",
    b"static inline PlyDec ply_dec_negated(PlyDec a) { a.lo = (Word)((uint64_t)a.lo ^ ((uint64_t)1 << 31)); return a; }\n",
  ])
