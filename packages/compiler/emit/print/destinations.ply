import std.map
import compiler.emit.keys (Callee)
import compiler.emit.typed_ir (LoopVariable, Function, Block, Instruction, Rvalue, Variable, Arg,
                               VariableOperand, Convention, Let, Do, Assign, If, Case, Match, Loop,
                               Next, Done, Return, Restart, Jump, Handle, Increment, Decrement,
                               Reset, Free, Destructure, Allocate, RecordAllocation, Update, Call,
                               FieldWrite, OwnedResult, operands, suspends_in)
import compiler.emit.print.text (Destinations)

pub fn destinations_of(f: Function) -> Destinations = {
  let m = mentions(f.body, false, no_mentions());
  let destined = f.convention.destination_passing && f.convention.returned == OwnedResult
    && f.members.len() == 0;
  let results = if destined { results_in(f.body, m, Map::new()) } else { Map::new() };
  let slots = if suspends_in(f.body) { Map::new() }
  else { slots_in(f.body, m, results, Map::new()) };
  {
    destination_passing: destined,
    results: results,
    slots: slots,
    moving: moves_in(f.body, slots, Map::new()),
    moved: Map::new(),
  }
}

type Mentions = {
  reads: Map<Int, Int>,
  releases: Map<Int, Int>,
  taken: Map<Int, Int>,
  inside_handle: Map<Int, Int>,
}

fn no_mentions() -> Mentions =
  { reads: Map::new(), releases: Map::new(), taken: Map::new(), inside_handle: Map::new() }

fn mentions(b: Block, inside: Bool, m: Mentions) -> Mentions =
  b.fold(m, |accumulator: Mentions, i: Instruction| instruction_mentions(accumulator, inside, i))

fn instruction_mentions(m: Mentions, inside: Bool, i: Instruction) -> Mentions =
  match i {
    Let(l) -> released(value_mentions(m, inside, l.value), inside, l.unwind),
    Do(d) -> released(value_mentions(m, inside, d.value), inside, d.unwind),
    Assign(a) -> consumed_arguments(m, inside, [a.arg]),
    If(x) ->
      mentions(
        x.otherwise,
        inside,
        mentions(x.then, inside, read_args(m, inside, [x.cond], false)),
      ),
    Case(c) ->
      mentions(
        c.rest,
        inside,
        c.arms.fold(
          read(m, inside, c.on, false),
          |accumulator: Mentions, a: { when: Int, body: Block }|
            mentions(a.body, inside, accumulator),
        ),
      ),
    Match(x) ->
      mentions(
        x.rest,
        inside,
        x.arms.fold(m, |accumulator: Mentions, a: Block| mentions(a, inside, accumulator)),
      ),
    Loop(l) ->
      mentions(
        l.body,
        inside,
        consumed_arguments(m, inside, l.state.map(|c: LoopVariable| c.init)),
      ),
    Next(args) -> consumed_arguments(m, inside, args),
    Done(a) -> consumed_arguments(m, inside, [a]),
    Return(a) -> consumed_arguments(m, inside, [a]),
    Restart(args) -> consumed_arguments(m, inside, args),
    Jump(e) -> consumed_arguments(m, inside, e.args),
    Handle(h) ->
      released(mentions(h.body, true, consumed_arguments(m, inside, h.args)), inside, h.unwind),
    Increment(n) -> read(m, inside, n.var, true),
    Decrement(v) -> released(m, inside, [v]),
    Reset(r) -> read(m, inside, r.of, true),
    Free(x) -> read_args(read(m, inside, x.of, true), inside, [x.bytes], true),
    Destructure(o) -> read(m, inside, o.of, true),
    _ -> m,
  }

fn value_mentions(m: Mentions, inside: Bool, v: Rvalue) -> Mentions =
  operands(v).fold(m, |accumulator: Mentions, o: { arg: Arg, takes: Bool }|
    read_args(accumulator, inside, [o.arg], o.takes))

fn consumed_arguments(m: Mentions, inside: Bool, args: List<Arg>) -> Mentions =
  read_args(m, inside, args, true)

fn read_args(m: Mentions, inside: Bool, args: List<Arg>, takes: Bool) -> Mentions =
  args.fold(m, |accumulator: Mentions, a: Arg|
    match a { VariableOperand(v) -> read(accumulator, inside, v, takes), _ -> accumulator })

fn read(m: Mentions, inside: Bool, v: Variable, takes: Bool) -> Mentions =
  {
    reads: incremented(m.reads, v.id),
    releases: m.releases,
    taken: if takes { incremented(m.taken, v.id) } else { m.taken },
    inside_handle: if inside { incremented(m.inside_handle, v.id) } else { m.inside_handle },
  }

fn released(m: Mentions, inside: Bool, vs: List<Variable>) -> Mentions =
  vs.fold(m, |accumulator: Mentions, v: Variable|
    {
      ..accumulator,
      releases: incremented(accumulator.releases, v.id),
      inside_handle: if inside { incremented(accumulator.inside_handle, v.id) }
      else { accumulator.inside_handle },
    })

fn incremented(m: Map<Int, Int>, id: Int) -> Map<Int, Int> =
  m.insert(id, match m.get(id) { Some(n) -> n + 1, None -> 1 })

fn results_in(b: Block, m: Mentions, accumulator: Map<Int, Bool>) -> Map<Int, Bool> = {
  let here = b.fold(accumulator, |found: Map<Int, Bool>, i: Instruction|
    match i {
      Return(VariableOperand(x)) -> if m.reads.get_or(x.id, 0) == 1
          && m.releases.get_or(x.id, 0) == 0
          && built_for_destination(b, x) { found.insert(x.id, true) }
      else { found },
      _ -> found,
    });
  fold_nested(b, here, |inner: Block, a: Map<Int, Bool>| results_in(inner, m, a))
}

fn built_for_destination(b: Block, x: Variable) -> Bool =
  b.any(|i: Instruction|
    match i { Let(l) -> l.var.id == x.id && can_take_destination(l.value), _ -> false })

fn can_take_destination(v: Rvalue) -> Bool =
  match v {
    Allocate(k) -> match k.made { RecordAllocation(_) -> true, _ -> false },
    Update(_) -> true,
    Call(c) -> call_takes_destination(c),
    _ -> false,
  }

fn call_takes_destination(
  c: { callee: Callee, args: List<Arg>, convention: Convention, suspends: Bool },
) -> Bool = c.convention.destination_passing && c.convention.returned == OwnedResult && !c.suspends

fn slots_in(
  b: Block,
  m: Mentions,
  results: Map<Int, Bool>,
  accumulator: Map<Int, Bool>,
) -> Map<Int, Bool> = {
  let here = b.fold(accumulator, |found: Map<Int, Bool>, i: Instruction|
    match i {
      Let(l) -> match l.value {
        Call(c) -> if call_takes_destination(c) && !results.contains(l.var.id)
            && m.taken.get_or(l.var.id, 0) == 0
            && m.inside_handle.get_or(l.var.id, 0) == 0 { found.insert(l.var.id, true) }
        else { found },
        _ -> found,
      },
      _ -> found,
    });
  fold_nested(b, here, |inner: Block, a: Map<Int, Bool>| slots_in(inner, m, results, a))
}

fn moves_in(b: Block, slots: Map<Int, Bool>, accumulator: Map<Int, Int>) -> Map<Int, Int> = {
  let here = range(0, b.len()).fold(accumulator, |found: Map<Int, Int>, k: Int|
    match b.at(k) {
      Some(Let(l)) ->
        field_reads(l.value).fold(found, |q: Map<Int, Int>, v: Variable|
          if slots.contains(v.id) && released_next(b, k + 1, v) { q.insert(v.id, l.var.id) }
          else { q }),
      _ -> found,
    });
  fold_nested(b, here, |inner: Block, a: Map<Int, Int>| moves_in(inner, slots, a))
}

fn field_reads(value: Rvalue) -> List<Variable> = {
  let once = |args: List<Arg>|
    args.fold([], |accumulator: List<Variable>, a: Arg|
      match a {
        VariableOperand(v) -> if args.filter(|x: Arg| x == a).len() == 1 { accumulator.push(v) }
        else { accumulator },
        _ -> accumulator,
      });
  match value {
    Allocate(k) -> match k.made { RecordAllocation(_) -> once(k.args), _ -> [] },
    Update(u) -> once(u.sets.map(|s: FieldWrite| s.arg)).filter(|v: Variable| v.id != u.of.id),
    _ -> [],
  }
}

fn released_next(b: Block, k: Int, v: Variable) -> Bool =
  match b.at(k) {
    Some(Decrement(x)) -> x.id == v.id || released_next(b, k + 1, v),
    Some(Increment(x)) -> x.var.id != v.id && released_next(b, k + 1, v),
    Some(Free(_)) -> released_next(b, k + 1, v),
    _ -> false,
  }

fn fold_nested<s>(b: Block, accumulator: s, each: (Block, s) -> s) -> s =
  b.fold(accumulator, |a: s, i: Instruction|
    match i {
      If(x) -> each(x.otherwise, each(x.then, a)),
      Case(c) ->
        each(c.rest, c.arms.fold(a, |q: s, arm: { when: Int, body: Block }| each(arm.body, q))),
      Match(x) -> each(x.rest, x.arms.fold(a, |q: s, arm: Block| each(arm, q))),
      Loop(l) -> each(l.body, a),
      Handle(h) -> each(h.body, a),
      _ -> a,
    })
