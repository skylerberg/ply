import std.bytes (ascii_of_int)
import compiler.syntax.patterns (SourceLiteral, LiteralUnit, LiteralString)
import compiler.check.types (Type, int_type, decimal_type, unit_type, string_type, bool_type)
import compiler.check.known (less_constructor, equal_constructor, greater_constructor,
                             ordering_type, char_type)
import compiler.syntax.parsing (span_between)
import compiler.emit.c (Width, SizedIntKind, kind_c_type, int_literal, is_bitwise,
                        bitwise_c_operator, unsigned_c_type, width_index, width_min, width_max,
                        overflow_code)
import compiler.emit.pieces (pieces_text)
import compiler.emit.typed_ir (local_var, Representation, AsInt, AsBool, AsFixed, AsFloat,
                               AsDecimal, AsWideFixed, AsWord, AsSum, AsImmediate, Variable, Arg,
                               VariableOperand, IntOperand, FixedOperand, operand_representation,
                               comparison, shift)
import compiler.emit.print.text (Printing, InstructionContext, empty_printing, line, temp, named,
                                 arg_text, assigned, fails_when, unsupported)
import compiler.emit.print.value_printing (c_type)
import compiler.emit.layout (sum_layout, record_layout)
import compiler.emit.print.strings (bytes_of, text_field)
import compiler.syntax.expressions (is_arithmetic)

pub fn literal(
  p: InstructionContext,
  printing: Printing,
  into: Option<Variable>,
  l: SourceLiteral,
) -> Printing / {abort.raise} =
  match into {
    None -> printing,
    Some(v) -> match l {
      LiteralUnit -> typed_assigned(p, printing, v, b"0"),
      _ ->
        unsupported(
          b"a literal that an earlier compiler pass should have replaced",
          c_type(v.representation),
        ),
    },
  }

pub fn primitive(
  p: InstructionContext,
  printing: Printing,
  into: Option<Variable>,
  x: { operation: Bytes, on: Representation, args: List<Arg> },
) -> Printing / {abort.raise} =
  match into {
    None -> printing,
    Some(v) -> {
      let a = match x.args.at(0) { Some(y) -> arg_text(printing, y), None -> b"0" };
      let b = match x.args.at(1) { Some(y) -> arg_text(printing, y), None -> b"0" };
      let count = match x.args.at(1) { Some(y) -> int_text(printing, y), None -> b"0" };
      if x.operation == b"sign" { sign_printed(p, printing, v, x.on, a) }
      else if x.operation == b"narrow" {
        typed_assigned(p, printing, v, Bytes::concat_all([b"(", c_type(v.representation), b")", a]))
      } else if x.operation == b"within" {
        let c = match x.args.at(2) { Some(y) -> arg_text(printing, y), None -> b"0" };
        typed_assigned(
          p,
          printing,
          v,
          Bytes::concat_all([b"((", a, b") >= (", b, b") && (", a, b") <= (", c, b"))"]),
        )
      } else if x.operation == b"decimal" {
        typed_assigned(p, printing, v, Bytes::concat_all([b"((PlyDec){ ", a, b", ", b, b" })"]))
      } else if x.operation == b"wide" {
        typed_assigned(
          p,
          printing,
          v,
          Bytes::concat_all([b"((PlyWide){ (Word)(", a, b"), (Word)(", b, b") })"]),
        )
      } else {
        match x.on {
          AsInt ->
            int_printed(p, printing, v, x.operation, a, b, count, literal_divisor(x.args.at(1))),
          AsBool -> bool_printed(p, printing, v, x.operation, a, b),
          AsFloat -> float_printed(p, printing, v, x.operation, a, b),
          AsDecimal -> decimal_printed(p, printing, v, x.operation, a, b),
          AsWideFixed(w) -> wide_printed(p, printing, v, x.operation, w, a, b, count),
          AsFixed(w) -> width_printed(p, printing, v, x.operation, w, a, b, count),
          AsWord -> word_printed(p, printing, v, x.operation, a, b),
          AsImmediate -> word_printed(p, printing, v, x.operation, a, b),
          AsSum(_) -> if x.operation == b"eq" || x.operation == b"ne" {
            typed_assigned(p, printing, v, infix(a, compare_c(x.operation), b))
          } else { unsupported_operator(p, printing, x.operation) },
          _ -> unsupported_operator(p, printing, x.operation),
        }
      }
    },
  }

fn typed_assigned(p: InstructionContext, printing: Printing, v: Variable, e: Bytes) -> Printing =
  assigned(printing, p.depth, v, c_type(v.representation), e)

fn infix(a: Bytes, c: Bytes, b: Bytes) -> Bytes =
  Bytes::concat_all([b"(", a, b") ", c, b" (", b, b")"])

fn unsupported_operator(
  p: InstructionContext,
  printing: Printing,
  operator: Bytes,
) -> Printing / {abort.raise} =
  unsupported(b"an operator the C code generator does not support", operator)

fn overflowed(operation: Bytes) -> Bytes =
  Bytes::concat_all([b"ply_overflow(ctx, ", ascii_of_int(overflow_code(operation)), b");"])

fn by_zero(operation: Bytes) -> Bytes =
  if operation == b"div" { b"ply_by_zero(ctx, 0);" } else { b"ply_by_zero(ctx, 1);" }

fn int_printed(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  operation: Bytes,
  a: Bytes,
  b: Bytes,
  count: Bytes,
  by_literal: Bool,
) -> Printing / {abort.raise} =
  if operation == b"ne" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"!((", a, b") == (", b, b"))"]))
  } else if comparison(operation) {
    typed_assigned(p, printing, v, infix(a, compare_c(operation), b))
  } else if is_bitwise(operation) {
    typed_assigned(p, printing, v, infix(a, bitwise_c_operator(operation), b))
  } else if operation == b"add" || operation == b"sub" || operation == b"mul" {
    let n = named(printing, v);
    fails_when(
      p,
      line(n.printing, p.depth, Bytes::concat_all([b"int64_t ", n.name, b";"])),
      Bytes::concat_all([b"ply_", operation, b"_ov(", a, b", ", b, b", &", n.name, b")"]),
      overflowed(operation),
    )
  } else if (operation == b"div" || operation == b"rem") && by_literal {
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([b"(", a, if operation == b"div" { b") / " } else { b") % " }, b]),
    )
  } else if operation == b"div" || operation == b"rem" {
    let zero = fails_when(p, printing, Bytes::concat_all([b"(", b, b") == 0"]), by_zero(operation));
    let past = fails_when(
      p,
      zero,
      Bytes::concat_all([b"(", b, b") == -1 && (", a, b") == INT64_MIN"]),
      overflowed(operation),
    );
    typed_assigned(
      p,
      past,
      v,
      Bytes::concat_all([b"(", a, if operation == b"div" { b") / (" } else { b") % (" }, b, b")"]),
    )
  } else if shift(operation) { shifted(p, printing, v, operation, None, a, count) }
  else if operation == b"to_decimal" {
    let magnitude = Bytes::concat_all([
      b"((",
      a,
      b") < 0 ? 0 - (uint64_t)(",
      a,
      b") : (uint64_t)(",
      a,
      b"))",
    ]);
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([
        b"((PlyDec){ (Word)(((",
        a,
        b") < 0 ? (uint64_t)1 << 31 : 0) | ((",
        magnitude,
        b" & 0xFFFFFFFF) << 32)), (Word)(",
        magnitude,
        b" >> 32) })",
      ]),
    )
  } else if operation == b"neg" {
    let guarded = fails_when(p, printing, a.concat(b" == INT64_MIN"), overflowed(operation));
    typed_assigned(p, guarded, v, Bytes::concat_all([b"-(", a, b")"]))
  } else if operation == b"bitnot" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"~(", a, b")"]))
  } else if operation == b"order" { typed_assigned(p, printing, v, signed_order(a, b)) }
  else if operation == b"ordering" { ordering(p, printing, v, a) }
  else if operation == b"to_float" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"(double)(", a, b")"]))
  } else if operation == b"of_bits" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"ply_f64(", a, b")"]))
  } else if operation == b"decimal_flags" {
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([
        b"((((uint64_t)(",
        a,
        b") & 0x7F00FFFFull) != 0 || ((((uint64_t)(",
        a,
        b")) >> 16) & 0xFF) > 28) ? INT64_C(-1) : INT64_C(0))",
      ]),
    )
  } else if operation == b"scalar_value" {
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([
        b"((",
        a,
        b") >= 0 && (",
        a,
        b") <= 0x10FFFF && !((",
        a,
        b") >= 0xD800 && (",
        a,
        b") <= 0xDFFF) ? (",
        a,
        b") : -1)",
      ]),
    )
  } else if operation == b"char_of" {
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([b"((((Word)(uint64_t)(", a, b")) << 3) | 2)"]),
    )
  } else if operation == b"witness" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"(13 + ", a, b")"]))
  } else if operation == b"of_int" {
    let rejected = |w: Width|
      Bytes::concat_all([
        b"ply_not_that_width(ctx, ",
        ascii_of_int(width_index(w)),
        b", ",
        a,
        b");",
      ]);
    match v.representation {
      AsWideFixed(w) -> {
        let guarded = if w.signed { printing }
        else { fails_when(p, printing, a.concat(b" < 0"), rejected(w)) };
        typed_assigned(
          p,
          guarded,
          v,
          Bytes::concat_all([b"((PlyWide){ (Word)(", a, b"), (Word)((", a, b") < 0 ? -1 : 0) })"]),
        )
      },
      AsFixed(w) -> {
        let guarded = if w.bits == 64 && w.signed { printing }
        else if w.bits == 64 { fails_when(p, printing, a.concat(b" < 0"), rejected(w)) } else {
          fails_when(
            p,
            printing,
            Bytes::concat_all([
              a,
              b" < ",
              int_literal(width_min(w)),
              b" || ",
              a,
              b" > ",
              int_literal(width_max(w)),
            ]),
            rejected(w),
          )
        };
        typed_assigned(
          p,
          guarded,
          v,
          Bytes::concat_all([b"(", kind_c_type(SizedIntKind(w)), b")", a]),
        )
      },
      _ -> unsupported_operator(p, printing, operation),
    }
  } else { unsupported_operator(p, printing, operation) }

fn bool_printed(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  operation: Bytes,
  a: Bytes,
  b: Bytes,
) -> Printing / {abort.raise} =
  if operation == b"not" { typed_assigned(p, printing, v, Bytes::concat_all([b"!(", a, b")"])) }
  else if operation == b"eq" || operation == b"ne" {
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([if operation == b"ne" { b"!((" } else { b"((" }, a, b") == (", b, b"))"]),
    )
  } else if operation == b"order" { typed_assigned(p, printing, v, signed_order(a, b)) }
  else { unsupported_operator(p, printing, operation) }

fn float_printed(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  operation: Bytes,
  a: Bytes,
  b: Bytes,
) -> Printing / {abort.raise} =
  if comparison(operation) { typed_assigned(p, printing, v, infix(a, compare_c(operation), b)) }
  else if operation == b"neg" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"-(", a, b")"]))
  } else if operation == b"rem" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"fmod(", a, b", ", b, b")"]))
  } else if operation == b"sqrt" || operation == b"floor" || operation == b"ceil" {
    typed_assigned(p, printing, v, Bytes::concat_all([operation, b"(", a, b")"]))
  } else if is_arithmetic(operation) {
    typed_assigned(p, printing, v, infix(a, float_c(operation), b))
  } else if operation == b"bits" {
    let t = temp(printing);
    let read = line(
      t.printing,
      p.depth,
      Bytes::concat_all([b"int64_t ", t.name, b" = ply_f64_bits(", a, b");"]),
    );
    typed_assigned(
      p,
      read,
      v,
      Bytes::concat_all([
        b"((((uint64_t)",
        t.name,
        b" & UINT64_C(0x7FF0000000000000)) == UINT64_C(0x7FF0000000000000) && ((uint64_t)",
        t.name,
        b" & UINT64_C(0x000FFFFFFFFFFFFF)) != 0) ? INT64_C(0x7FF8000000000000) : ",
        t.name,
        b")",
      ]),
    )
  } else { unsupported_operator(p, printing, operation) }

fn decimal_printed(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  operation: Bytes,
  a: Bytes,
  b: Bytes,
) -> Printing / {abort.raise} =
  if operation == b"lo" || operation == b"hi" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"(int64_t)(", a, b").", operation]))
  } else if operation == b"scale" {
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([b"(int64_t)(((uint64_t)(", a, b").lo >> 16) & 0xFF)"]),
    )
  } else if comparison(operation) {
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([b"(ply_dec_order(", a, b", ", b, b") ", compare_c(operation), b" 0)"]),
    )
  } else if operation == b"order" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"ply_dec_order(", a, b", ", b, b")"]))
  } else if operation == b"add" || operation == b"sub" || operation == b"mul" {
    let n = named(printing, v);
    let call = if operation == b"mul" { Bytes::concat_all([b"ply_dec_mul(", a, b", ", b]) } else {
      Bytes::concat_all([
        b"ply_dec_add(",
        a,
        b", ",
        b,
        if operation == b"sub" { b", 1" } else { b", 0" },
      ])
    };
    fails_when(
      p,
      line(n.printing, p.depth, Bytes::concat_all([b"PlyDec ", n.name, b";"])),
      Bytes::concat_all([call, b", &", n.name, b")"]),
      Bytes::concat_all([
        b"ply_decimal_overflow(ctx, ",
        ascii_of_int(overflow_code(operation)),
        b");",
      ]),
    )
  } else if operation == b"rem" {
    let zero = fails_when(
      p,
      printing,
      Bytes::concat_all([b"((uint64_t)(", b, b").lo >> 32) == 0 && (", b, b").hi == 0"]),
      by_zero(operation),
    );
    typed_assigned(p, zero, v, Bytes::concat_all([b"ply_dec_rem(", a, b", ", b, b")"]))
  } else if operation == b"neg" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"ply_dec_negated(", a, b")"]))
  } else { unsupported_operator(p, printing, operation) }

fn wide_printed(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  operation: Bytes,
  w: Width,
  a: Bytes,
  b: Bytes,
  count: Bytes,
) -> Printing / {abort.raise} = {
  let part = |x: Bytes, half: Bytes| Bytes::concat_all([b"(", x, b").", half]);
  let pairwise = |c: Bytes|
    Bytes::concat_all([
      b"((PlyWide){ ",
      part(a, b"lo"),
      b" ",
      c,
      b" ",
      part(b, b"lo"),
      b", ",
      part(a, b"hi"),
      b" ",
      c,
      b" ",
      part(b, b"hi"),
      b" })",
    ]);
  let order = Bytes::concat_all([
    b"ply_wide_order(",
    a,
    b", ",
    b,
    b", ",
    if w.signed { b"1" } else { b"0" },
    b")",
  ]);
  let same = Bytes::concat_all([
    b"(",
    part(a, b"lo"),
    b" == ",
    part(b, b"lo"),
    b" && ",
    part(a, b"hi"),
    b" == ",
    part(b, b"hi"),
    b")",
  ]);
  if operation == b"lo" || operation == b"hi" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"(int64_t)", part(a, operation)]))
  } else if operation == b"fits_int" {
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([
        b"ply_wide_fits_int(",
        a,
        b", ",
        if w.signed { b"1" } else { b"0" },
        b")",
      ]),
    )
  } else if operation == b"eq" { typed_assigned(p, printing, v, same) }
  else if operation == b"ne" { typed_assigned(p, printing, v, b"!".concat(same)) }
  else if comparison(operation) {
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([b"(", order, b" ", compare_c(operation), b" 0)"]),
    )
  } else if operation == b"order" { typed_assigned(p, printing, v, order) }
  else if is_bitwise(operation) {
    typed_assigned(p, printing, v, pairwise(bitwise_c_operator(operation)))
  } else if operation == b"bitnot" {
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([b"((PlyWide){ ~", part(a, b"lo"), b", ~", part(a, b"hi"), b" })"]),
    )
  } else { wide_arithmetic(p, printing, v, operation, w, a, b, count) }
}

fn wide_arithmetic(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  operation: Bytes,
  w: Width,
  a: Bytes,
  b: Bytes,
  count: Bytes,
) -> Printing / {abort.raise} = {
  let s = if w.signed { b"1" } else { b"0" };
  let part = |x: Bytes, half: Bytes| Bytes::concat_all([b"(", x, b").", half]);
  let operands = if operation == b"neg" || operation == b"checked_neg" {
    Bytes::concat_all([a, b", ", s])
  } else { Bytes::concat_all([a, b", ", b, b", ", s]) };
  let declared = |at: Printing, names: Bytes|
    line(at, p.depth, Bytes::concat_all([b"PlyWide ", names, b";"]));
  if operation == b"add" || operation == b"sub" || operation == b"mul" || operation == b"neg" {
    let n = named(printing, v);
    fails_when(
      p,
      declared(n.printing, n.name),
      Bytes::concat_all([b"ply_wide_", operation, b"(", operands, b", &", n.name, b")"]),
      overflowed(operation),
    )
  } else if operation == b"div" || operation == b"rem" {
    let n = named(printing, v);
    let t = temp(n.printing);
    let zero = fails_when(
      p,
      declared(t.printing, Bytes::concat_all([n.name, b", ", t.name])),
      Bytes::concat_all([part(b, b"lo"), b" == 0 && ", part(b, b"hi"), b" == 0"]),
      by_zero(operation),
    );
    let quotient = if operation == b"div" { n.name } else { t.name };
    let remainder = if operation == b"div" { t.name } else { n.name };
    fails_when(
      p,
      zero,
      Bytes::concat_all([b"ply_wide_divrem(", operands, b", &", quotient, b", &", remainder, b")"]),
      overflowed(operation),
    )
  } else if shift(operation) {
    let c = temp(printing);
    let count_declaration = line(
      c.printing,
      p.depth,
      Bytes::concat_all([b"int64_t ", c.name, b" = ", count, b";"]),
    );
    let guarded = fails_when(
      p,
      count_declaration,
      Bytes::concat_all([b"(uint64_t)", c.name, b" >= 128"]),
      Bytes::concat_all([
        b"ply_shift_count(ctx, ",
        c.name,
        b", ",
        ascii_of_int(width_index(w)),
        b");",
      ]),
    );
    typed_assigned(p, guarded, v, if operation == b"shl" {
      Bytes::concat_all([b"ply_wide_shl(", a, b", ", c.name, b")"])
    } else {
      Bytes::concat_all([
        b"ply_wide_shr(",
        a,
        b", ",
        c.name,
        if operation == b"shr" { Bytes::concat_all([b", ", s, b")"]) } else { b", 0)" },
      ])
    })
  } else if operation == b"wrap_add" || operation == b"wrap_sub" || operation == b"wrap_mul" {
    let n = named(printing, v);
    line(
      declared(n.printing, n.name),
      p.depth,
      Bytes::concat_all([
        b"(void)ply_wide_",
        operation.slice(5, operation.len()),
        b"(",
        operands,
        b", &",
        n.name,
        b");",
      ]),
    )
  } else if operation == b"saturating_add" || operation == b"saturating_sub"
      || operation == b"saturating_mul" {
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([
        b"ply_wide_sat_",
        operation.slice(11, operation.len()),
        b"(",
        operands,
        b")",
      ]),
    )
  } else if operation.starts_with(b"checked_") {
    let t = temp(printing);
    typed_assigned(
      p,
      declared(t.printing, t.name),
      v,
      Bytes::concat_all([
        b"!ply_wide_",
        operation.slice(8, operation.len()),
        b"(",
        operands,
        b", &",
        t.name,
        b")",
      ]),
    )
  } else if operation == b"rotl" || operation == b"rotr" {
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([b"ply_wide_", operation, b"(", a, b", ", count, b")"]),
    )
  } else if operation == b"to_int" {
    let fit_check = fails_when(
      p,
      printing,
      Bytes::concat_all([b"!ply_wide_fits_int(", a, b", ", s, b")"]),
      Bytes::concat_all([
        b"ply_not_an_int_wide(ctx, (int64_t)",
        part(a, b"lo"),
        b", (int64_t)",
        part(a, b"hi"),
        b", ",
        s,
        b");",
      ]),
    );
    typed_assigned(p, fit_check, v, Bytes::concat_all([b"(int64_t)", part(a, b"lo")]))
  } else { unsupported_operator(p, printing, operation) }
}

fn fits_printed(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  operation: Bytes,
  w: Width,
  a: Bytes,
  b: Bytes,
) -> Printing = {
  let u = |x: Bytes| Bytes::concat_all([b"(uint64_t)(", x, b")"]);
  if operation == b"checked_neg" {
    typed_assigned(p, printing, v, if w.signed { Bytes::concat_all([b"((", a, b") != INT64_MIN)"]) }
    else { Bytes::concat_all([b"(", u(a), b" == 0)"]) })
  } else if w.signed {
    let t = temp(printing);
    let declaration = line(t.printing, p.depth, Bytes::concat_all([b"int64_t ", t.name, b";"]));
    let f = if operation == b"checked_add" { b"ply_add_ov" }
    else if operation == b"checked_sub" { b"ply_sub_ov" }
    else { b"ply_mul_ov" };
    typed_assigned(
      p,
      declaration,
      v,
      Bytes::concat_all([b"!", f, b"((int64_t)(", a, b"), (int64_t)(", b, b"), &", t.name, b")"]),
    )
  } else if operation == b"checked_add" {
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([b"(", u(a), b" + ", u(b), b" >= ", u(a), b")"]),
    )
  } else if operation == b"checked_sub" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"(", u(a), b" >= ", u(b), b")"]))
  } else {
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([
        b"(",
        u(a),
        b" == 0 || ",
        u(a),
        b" * ",
        u(b),
        b" / ",
        u(a),
        b" == ",
        u(b),
        b")",
      ]),
    )
  }
}

fn word_printed(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  operation: Bytes,
  a: Bytes,
  b: Bytes,
) -> Printing / {abort.raise} =
  if comparison(operation) { typed_assigned(p, printing, v, infix(a, compare_c(operation), b)) }
  else if operation == b"char_code" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"((int64_t)((uint64_t)(", a, b") >> 3))"]))
  } else if operation == b"bytes_eq" { typed_assigned(p, printing, v, bytes_equal(a, b)) }
  else if operation == b"bytes_ne" {
    typed_assigned(p, printing, v, b"!".concat(bytes_equal(a, b)))
  } else if operation == b"order" { typed_assigned(p, printing, v, signed_order(a, b)) }
  else if operation == b"bytes_order" {
    let lx = temp(printing);
    let ly = temp(
      line(
        lx.printing,
        p.depth,
        Bytes::concat_all([b"int64_t ", lx.name, b" = (int64_t)", text_field(a, b"len"), b";"]),
      ),
    );
    let n = named(
      line(
        ly.printing,
        p.depth,
        Bytes::concat_all([b"int64_t ", ly.name, b" = (int64_t)", text_field(b, b"len"), b";"]),
      ),
      v,
    );
    let x = lx.name;
    let y = ly.name;
    line(
      line(
        n.printing,
        p.depth,
        Bytes::concat_all([
          b"int64_t ",
          n.name,
          b" = (int64_t)memcmp(",
          bytes_of(a),
          b", ",
          bytes_of(b),
          b", (size_t)(",
          x,
          b" < ",
          y,
          b" ? ",
          x,
          b" : ",
          y,
          b"));",
        ]),
      ),
      p.depth,
      Bytes::concat_all([
        b"if (",
        n.name,
        b" == 0) ",
        n.name,
        b" = (",
        x,
        b" > ",
        y,
        b") - (",
        x,
        b" < ",
        y,
        b");",
      ]),
    )
  } else { unsupported_operator(p, printing, operation) }

fn width_printed(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  operation: Bytes,
  w: Width,
  a: Bytes,
  b: Bytes,
  count: Bytes,
) -> Printing / {abort.raise} = {
  let t_c = kind_c_type(SizedIntKind(w));
  let narrowed = |q: Printing, wide: Bytes| {
    let g = fails_when(
      p,
      q,
      Bytes::concat_all([
        wide,
        b" < ",
        int_literal(width_min(w)),
        b" || ",
        wide,
        b" > ",
        int_literal(width_max(w)),
      ]),
      overflowed(operation),
    );
    typed_assigned(p, g, v, Bytes::concat_all([b"(", t_c, b")", wide]))
  };
  if operation.starts_with(b"checked_") { fits_printed(p, printing, v, operation, w, a, b) }
  else if is_arithmetic(operation) && w.bits < 64 {
    let t = temp(printing);
    if operation == b"add" || operation == b"sub" {
      narrowed(
        line(
          t.printing,
          p.depth,
          Bytes::concat_all([
            b"int64_t ",
            t.name,
            b" = (int64_t)(",
            a,
            if operation == b"add" { b") + (int64_t)(" } else { b") - (int64_t)(" },
            b,
            b");",
          ]),
        ),
        t.name,
      )
    } else if operation == b"mul" {
      let declared = line(t.printing, p.depth, Bytes::concat_all([b"int64_t ", t.name, b";"]));
      narrowed(
        fails_when(
          p,
          declared,
          Bytes::concat_all([
            b"ply_mul_ov((int64_t)(",
            a,
            b"), (int64_t)(",
            b,
            b"), &",
            t.name,
            b")",
          ]),
          overflowed(operation),
        ),
        t.name,
      )
    } else {
      let zero = fails_when(
        p,
        t.printing,
        Bytes::concat_all([b"(int64_t)(", b, b") == 0"]),
        by_zero(operation),
      );
      narrowed(
        line(
          zero,
          p.depth,
          Bytes::concat_all([
            b"int64_t ",
            t.name,
            b" = (int64_t)(",
            a,
            if operation == b"div" { b") / (int64_t)(" } else { b") % (int64_t)(" },
            b,
            b");",
          ]),
        ),
        t.name,
      )
    }
  } else if operation == b"add" || operation == b"sub" {
    let n = named(printing, v);
    let over = if w.signed {
      Bytes::concat_all([
        if operation == b"add" { b"ply_add_ov(" } else { b"ply_sub_ov(" },
        a,
        b", ",
        b,
        b", &",
        n.name,
        b")",
      ])
    } else {
      Bytes::concat_all([
        b"(",
        n.name,
        b" = (uint64_t)(",
        a,
        if operation == b"add" { b") + (uint64_t)(" } else { b") - (uint64_t)(" },
        b,
        b"), ",
        if operation == b"add" { Bytes::concat_all([n.name, b" < (uint64_t)(", a, b"))"]) }
        else { Bytes::concat_all([b"(uint64_t)(", a, b") < (uint64_t)(", b, b"))"]) },
      ])
    };
    fails_when(
      p,
      line(n.printing, p.depth, Bytes::concat_all([t_c, b" ", n.name, b";"])),
      over,
      overflowed(operation),
    )
  } else if operation == b"mul" {
    let n = named(printing, v);
    let u = |x: Bytes| Bytes::concat_all([b"(uint64_t)(", x, b")"]);
    let over = if w.signed {
      Bytes::concat_all([b"ply_mul_ov((int64_t)(", a, b"), (int64_t)(", b, b"), &", n.name, b")"])
    } else {
      Bytes::concat_all([
        b"(",
        n.name,
        b" = ",
        u(a),
        b" * ",
        u(b),
        b", ",
        u(a),
        b" != 0 && ",
        n.name,
        b" / ",
        u(a),
        b" != ",
        u(b),
        b")",
      ])
    };
    fails_when(
      p,
      line(n.printing, p.depth, Bytes::concat_all([t_c, b" ", n.name, b";"])),
      over,
      overflowed(operation),
    )
  } else if operation == b"div" || operation == b"rem" {
    let zero = fails_when(
      p,
      printing,
      Bytes::concat_all([b"(", t_c, b")(", b, b") == 0"]),
      by_zero(operation),
    );
    let past = if !w.signed { zero } else {
      fails_when(
        p,
        zero,
        Bytes::concat_all([b"(int64_t)(", b, b") == -1 && (int64_t)(", a, b") == INT64_MIN"]),
        overflowed(operation),
      )
    };
    typed_assigned(
      p,
      past,
      v,
      Bytes::concat_all([
        b"(",
        t_c,
        b")((",
        t_c,
        b")(",
        a,
        if operation == b"div" { b") / (" } else { b") % (" },
        t_c,
        b")(",
        b,
        b"))",
      ]),
    )
  } else if is_bitwise(operation) {
    typed_assigned(p, printing, v, infix(a, bitwise_c_operator(operation), b))
  } else if shift(operation) { shifted(p, printing, v, operation, Some(w), a, count) }
  else if operation == b"bitnot" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"(", t_c, b") ~(", a, b")"]))
  } else if operation == b"ne" {
    typed_assigned(p, printing, v, Bytes::concat_all([b"!((", a, b") == (", b, b"))"]))
  } else if comparison(operation) {
    typed_assigned(p, printing, v, infix(a, compare_c(operation), b))
  } else if operation == b"order" { typed_assigned(p, printing, v, signed_order(a, b)) }
  else if operation == b"neg" && w.bits < 64 {
    let t = temp(printing);
    narrowed(
      line(
        t.printing,
        p.depth,
        Bytes::concat_all([b"int64_t ", t.name, b" = -(int64_t)(", a, b");"]),
      ),
      t.name,
    )
  } else if operation == b"neg" {
    let guarded = fails_when(
      p,
      printing,
      a.concat(if w.signed { b" == INT64_MIN" } else { b" != 0" }),
      overflowed(operation),
    );
    typed_assigned(p, guarded, v, Bytes::concat_all([b"-(", a, b")"]))
  } else if operation == b"wrap_add" || operation == b"wrap_sub" || operation == b"wrap_mul" {
    let u = unsigned_c_type(w);
    typed_assigned(
      p,
      printing,
      v,
      Bytes::concat_all([
        b"(",
        u,
        b")((uint64_t)(",
        u,
        b")(",
        a,
        b") ",
        if operation == b"wrap_add" { b"+" }
        else if operation == b"wrap_sub" { b"-" }
        else { b"*" },
        b" (uint64_t)(",
        u,
        b")(",
        b,
        b"))",
      ]),
    )
  } else if operation == b"rotl" || operation == b"rotr" {
    rotated(p, printing, v, operation, w, a, count)
  } else if operation == b"saturating_add" || operation == b"saturating_sub"
      || operation == b"saturating_mul" {
    if w.bits == 64 { saturating_64_bit(p, printing, v, operation, w, a, b) }
    else { saturating_narrow(p, printing, v, operation, w, a, b) }
  } else if operation == b"to_int" {
    let guarded = if w.signed || w.bits < 64 { printing } else {
      fails_when(
        p,
        printing,
        Bytes::concat_all([b"(uint64_t)(", a, b") > (uint64_t)INT64_MAX"]),
        Bytes::concat_all([b"ply_not_an_int(ctx, (int64_t)(", a, b"));"]),
      )
    };
    typed_assigned(p, guarded, v, Bytes::concat_all([b"(int64_t)(", a, b")"]))
  } else if operation == b"exact_add" || operation == b"exact_sub" || operation == b"exact_mul"
      || operation == b"exact_neg" {
    let wide = |e: Bytes| Bytes::concat_all([b"(", c_type(v.representation), b")(", e, b")"]);
    typed_assigned(p, printing, v, if operation == b"exact_neg" { b"-".concat(wide(a)) } else {
      Bytes::concat_all([
        wide(a),
        if operation == b"exact_add" { b" + " }
        else if operation == b"exact_sub" { b" - " }
        else { b" * " },
        wide(b),
      ])
    })
  } else { unsupported_operator(p, printing, operation) }
}

fn rotated(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  operation: Bytes,
  w: Width,
  a: Bytes,
  count: Bytes,
) -> Printing = {
  let u = unsigned_c_type(w);
  let bits = ascii_of_int(w.bits);
  let k = temp(printing);
  let turned = line(
    k.printing,
    p.depth,
    Bytes::concat_all([
      b"int64_t ",
      k.name,
      b" = ((",
      if operation == b"rotl" { b"-" } else { b"" },
      b"((",
      count,
      b") % ",
      bits,
      b")) % ",
      bits,
      b" + ",
      bits,
      b") % ",
      bits,
      b";",
    ]),
  );
  typed_assigned(
    p,
    turned,
    v,
    Bytes::concat_all([
      b"(",
      u,
      b")(",
      k.name,
      b" == 0 ? (",
      u,
      b")(",
      a,
      b") : ((",
      u,
      b")(",
      a,
      b") >> ",
      k.name,
      b") | ((",
      u,
      b")(",
      a,
      b") << (",
      bits,
      b" - ",
      k.name,
      b")))",
    ]),
  )
}

fn saturating_64_bit(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  operation: Bytes,
  w: Width,
  a: Bytes,
  b: Bytes,
) -> Printing = {
  let r = temp(printing);
  let statement = if w.signed {
    let past = if operation == b"saturating_add" { Bytes::concat_all([b"(", b, b") > 0"]) }
    else if operation == b"saturating_sub" { Bytes::concat_all([b"(", b, b") < 0"]) }
    else { Bytes::concat_all([b"((", a, b") < 0) == ((", b, b") < 0)"]) };
    Bytes::concat_all([
      b"int64_t ",
      r.name,
      b"; if (",
      if operation == b"saturating_add" { b"ply_add_ov" }
      else if operation == b"saturating_sub" { b"ply_sub_ov" }
      else { b"ply_mul_ov" },
      b"(",
      a,
      b", ",
      b,
      b", &",
      r.name,
      b")) ",
      r.name,
      b" = ",
      past,
      b" ? INT64_MAX : INT64_MIN;",
    ])
  } else {
    let x = Bytes::concat_all([b"(uint64_t)(", a, b")"]);
    let y = Bytes::concat_all([b"(uint64_t)(", b, b")"]);
    if operation == b"saturating_sub" {
      Bytes::concat_all([
        b"uint64_t ",
        r.name,
        b" = ",
        x,
        b" < ",
        y,
        b" ? 0 : ",
        x,
        b" - ",
        y,
        b";",
      ])
    } else if operation == b"saturating_add" {
      Bytes::concat_all([
        b"uint64_t ",
        r.name,
        b" = ",
        x,
        b" + ",
        y,
        b"; if (",
        r.name,
        b" < ",
        x,
        b") ",
        r.name,
        b" = UINT64_MAX;",
      ])
    } else {
      Bytes::concat_all([
        b"uint64_t ",
        r.name,
        b" = ",
        x,
        b" * ",
        y,
        b"; if (",
        x,
        b" != 0 && ",
        r.name,
        b" / ",
        x,
        b" != ",
        y,
        b") ",
        r.name,
        b" = UINT64_MAX;",
      ])
    }
  };
  typed_assigned(p, line(r.printing, p.depth, statement), v, r.name)
}

fn saturating_narrow(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  operation: Bytes,
  w: Width,
  a: Bytes,
  b: Bytes,
) -> Printing = {
  let unsigned = !w.signed && operation == b"saturating_mul";
  let wide = if unsigned { b"uint64_t" } else { b"int64_t" };
  let r = temp(printing);
  let exact = line(
    r.printing,
    p.depth,
    Bytes::concat_all([
      wide,
      b" ",
      r.name,
      b" = (",
      wide,
      b")(",
      a,
      b")",
      if operation == b"saturating_add" { b" + " }
      else if operation == b"saturating_sub" { b" - " }
      else { b" * " },
      b"(",
      wide,
      b")(",
      b,
      b");",
    ]),
  );
  let top = Bytes::concat_all([
    r.name,
    b" > ",
    if unsigned { b"(uint64_t)" } else { b"" },
    int_literal(width_max(w)),
    b" ? ",
    int_literal(width_max(w)),
    b" : ",
    r.name,
  ]);
  typed_assigned(
    p,
    exact,
    v,
    Bytes::concat_all([
      b"(",
      kind_c_type(SizedIntKind(w)),
      b")(",
      if unsigned { top } else {
        Bytes::concat_all([
          r.name,
          b" < ",
          int_literal(width_min(w)),
          b" ? ",
          int_literal(width_min(w)),
          b" : (",
          top,
          b")",
        ])
      },
      b")",
    ]),
  )
}

fn shifted(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  operation: Bytes,
  width: Option<Width>,
  a: Bytes,
  count: Bytes,
) -> Printing = {
  let c = temp(printing);
  let count_declared = line(
    c.printing,
    p.depth,
    Bytes::concat_all([b"int64_t ", c.name, b" = ", count, b";"]),
  );
  let guarded = fails_when(
    p,
    count_declared,
    Bytes::concat_all([
      b"(uint64_t)",
      c.name,
      b" >= (uint64_t)",
      ascii_of_int(match width { Some(w) -> w.bits, None -> 64 }),
    ]),
    Bytes::concat_all([
      b"ply_shift_count(ctx, ",
      c.name,
      b", ",
      match width { Some(w) -> ascii_of_int(width_index(w)), None -> b"-1" },
      b");",
    ]),
  );
  let n = c.name;
  typed_assigned(p, guarded, v, match width {
    Some(w) -> {
      let u = unsigned_c_type(w);
      if operation == b"shl" {
        Bytes::concat_all([b"(", u, b")((", u, b")(", a, b") << ", n, b")"])
      } else if operation == b"shr" && w.signed { Bytes::concat_all([b"(", a, b") >> ", n]) }
      else { Bytes::concat_all([b"(", u, b")((", u, b")(", a, b") >> ", n, b")"]) }
    },
    None -> if operation == b"shl" {
      Bytes::concat_all([b"(int64_t)((uint64_t)(", a, b") << ", n, b")"])
    } else if operation == b"shr" { Bytes::concat_all([b"(", a, b") >> ", n]) }
    else { Bytes::concat_all([b"(int64_t)((uint64_t)(", a, b") >> ", n, b")"]) },
  })
}

fn ordering(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  s: Bytes,
) -> Printing / {abort.raise} =
  match v.representation {
    AsSum(c) ->
      typed_assigned(
        p,
        printing,
        v,
        Bytes::concat_all([
          s,
          b" < 0 ? ",
          case_at(c.cases, less_constructor),
          b" : ",
          s,
          b" == 0 ? ",
          case_at(c.cases, equal_constructor),
          b" : ",
          case_at(c.cases, greater_constructor),
        ]),
      ),
    _ ->
      unsupported(b"an `Ordering` whose type is not a sum of its cases", c_type(v.representation)),
  }

fn sign_printed(
  p: InstructionContext,
  printing: Printing,
  v: Variable,
  on: Representation,
  o: Bytes,
) -> Printing / {abort.raise} =
  match on {
    AsSum(c) ->
      typed_assigned(
        p,
        printing,
        v,
        Bytes::concat_all([
          b"(",
          o,
          b" == ",
          case_at(c.cases, less_constructor),
          b" ? -1 : ",
          o,
          b" == ",
          case_at(c.cases, equal_constructor),
          b" ? 0 : 1)",
        ]),
      ),
    _ -> unsupported(b"an `Ordering` whose type is not a sum of its cases", c_type(on)),
  }

fn case_at(cases: List<Bytes>, name: Bytes) -> Bytes =
  ascii_of_int(
    range(0, cases.len()).fold(0, |k: Int, i: Int| if cases.at(i) == Some(name) { i } else { k }),
  )

fn signed_order(x: Bytes, y: Bytes) -> Bytes =
  Bytes::concat_all([b"(int64_t)((", x, b") > (", y, b")) - (int64_t)((", x, b") < (", y, b"))"])

fn bytes_equal(x: Bytes, y: Bytes) -> Bytes =
  Bytes::concat_all([
    b"(",
    x,
    b" == ",
    y,
    b" || (",
    text_field(x, b"len"),
    b" == ",
    text_field(y, b"len"),
    b" && memcmp(",
    bytes_of(x),
    b", ",
    bytes_of(y),
    b", ",
    text_field(x, b"len"),
    b") == 0))",
  ])

fn int_text(printing: Printing, a: Arg) -> Bytes =
  match operand_representation(a) {
    AsFixed(_) -> Bytes::concat_all([b"(int64_t)(", arg_text(printing, a), b")"]),
    _ -> arg_text(printing, a),
  }

fn literal_divisor(d: Option<Arg>) -> Bool =
  match d { Some(IntOperand(n)) -> n != 0 && n != 0 - 1, _ -> false }

fn compare_c(operation: Bytes) -> Bytes =
  if operation == b"lt" { b"<" }
  else if operation == b"le" { b"<=" }
  else if operation == b"gt" { b">" }
  else if operation == b"ge" { b">=" }
  else if operation == b"eq" { b"==" }
  else { b"!=" }

fn float_c(operation: Bytes) -> Bytes =
  if operation == b"add" { b"+" }
  else if operation == b"sub" { b"-" }
  else if operation == b"mul" { b"*" }
  else { b"/" }

const fake_instruction_context: InstructionContext =
  {
    u: {
      base: 0,
      result: AsInt,
      site: None,
      arm: None,
      looping: None,
      handler_jump: None,
      group: None,
      unwinds: [],
      symbol: b"f",
      epilogue: b"",
    },
    at: span_between(0, 4),
    exit_statement: b"return 0;",
    depth: 0,
  }

fn printed_primitive(
  names: Map<Int, Bytes>,
  v: Variable,
  operation: Bytes,
  on: Representation,
  args: List<Arg>,
) -> Bytes / {abort.raise} =
  pieces_text(
    primitive(fake_instruction_context, empty_printing(names), Some(v), {
      operation: operation,
      on: on,
      args: args,
    }).out,
  )

test "an order's sign becomes the `Ordering` case it names, the sign is read back from that case, and `Ordering` has no other representation" {
  let index = AsSum({
    layout: sum_layout(range(0, 3).map(|_: Int| { args: record_layout([]), indirect: false })),
    cases: [b"Less", b"Equal", b"Greater"],
  });
  let made = printed_primitive(
    Map::new().insert(0, b"p0"),
    local_var(1, ordering_type, index),
    b"ordering",
    AsInt,
    [VariableOperand(local_var(0, int_type, AsInt))],
  );
  let sign = |rep: Representation|
    printed_primitive(Map::new().insert(0, b"p0"), local_var(1, int_type, AsInt), b"sign", rep, [
      VariableOperand(local_var(0, ordering_type, rep)),
    ]);
  assert_eq(
    [made, sign(index)].map(|c: Bytes|
      c.index_of(b"rt_") == None && c.index_of(b"ply_obj") == None),
    [true, true],
  );
  let word = b"unprinted an `Ordering` whose type is not a sum of its cases";
  let word_made = handle {
    printed_primitive(
      Map::new().insert(0, b"p0"),
      local_var(1, ordering_type, AsWord),
      b"ordering",
      AsInt,
      [VariableOperand(local_var(0, int_type, AsInt))],
    )
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  let read = handle { sign(AsWord) } with { abort.raise(m) -> Bytes::of_string(m) };
  assert_eq([word_made.starts_with(word), read.starts_with(word)], [true, true])
}

test "a decimal constant is written as its two words directly, `()` is written as the word 0, and no constant is loaded at run time" {
  let decimal = printed_primitive(
    Map::new(),
    local_var(0, decimal_type, AsDecimal),
    b"decimal",
    AsInt,
    [IntOperand(65536), IntOperand(0)],
  );
  assert(
    decimal.index_of(b"INT64_C(65536)") != None && decimal.index_of(b"rt_") == None,
    Some(String::of_bytes_lossy(decimal)),
  );
  let unit = literal(
    fake_instruction_context,
    empty_printing(Map::new()),
    Some(local_var(0, unit_type, AsWord)),
    LiteralUnit,
  );
  assert(
    pieces_text(unit.out).index_of(b" = 0;") != None,
    Some(String::of_bytes_lossy(pieces_text(unit.out))),
  );
  let abort_message = handle {
    literal(
      fake_instruction_context,
      empty_printing(Map::new()),
      Some(local_var(1, string_type, AsWord)),
      LiteralString(b"a"),
    );
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert(
    abort_message.starts_with(
      b"unprinted a literal that an earlier compiler pass should have replaced",
    ),
    None,
  )
}

test "two strings are equal when their bytes are equal, and two characters are compared with C's operators on their words" {
  let names = Map::new().insert(0, b"p0").insert(1, b"p1");
  let s = |id: Int| VariableOperand(local_var(id, string_type, AsWord));
  let strings = printed_primitive(names, local_var(2, bool_type, AsBool), b"bytes_ne", AsWord, [
    s(0),
    s(1),
  ]);
  assert(
    strings.index_of(b"memcmp(") != None && strings.index_of(b"rt_") == None,
    Some(String::of_bytes_lossy(strings)),
  );
  let c = |id: Int| VariableOperand(local_var(id, char_type, AsWord));
  let chars = printed_primitive(names, local_var(2, bool_type, AsBool), b"le", AsWord, [
    c(0),
    c(1),
  ]);
  assert(
    chars.index_of(b"<=") != None && chars.index_of(b"rt_") == None,
    Some(String::of_bytes_lossy(chars)),
  )
}

test "an operation stores its site on the branch that fails, and one that cannot fail stores none" {
  let names = Map::new().insert(0, b"p0").insert(1, b"p1");
  let printed_on = |operation: Bytes, on: Representation|
    printed_primitive(names, local_var(2, int_type, on), operation, on, [
      VariableOperand(local_var(0, int_type, on)),
      VariableOperand(local_var(1, int_type, on)),
    ]);
  let narrow = AsFixed({ bits: 32, signed: true });
  let full = AsFixed({ bits: 64, signed: false });
  let wide = AsWideFixed({ bits: 128, signed: true });
  let on_its_branch = |c: Bytes| {
    let sited = c.split(b"\n").filter(|l: Bytes| l.index_of(b"PLY_SITE(") != None);
    sited != [] && sited.all(|l: Bytes| l.index_of(b") { PLY_SITE(") != None)
  };
  let failing = [
    printed_on(b"add", AsInt),
    printed_on(b"rem", AsInt),
    printed_on(b"shl", AsInt),
    printed_on(b"mul", narrow),
    printed_on(b"div", full),
    printed_on(b"neg", full),
    printed_on(b"sub", AsDecimal),
    printed_on(b"rem", AsDecimal),
    printed_on(b"add", wide),
    printed_on(b"div", wide),
  ];
  assert_eq(failing.filter(|c: Bytes| !on_its_branch(c)), []);
  let safe = [
    printed_on(b"lt", AsInt),
    printed_on(b"add", AsFloat),
    printed_on(b"wrap_add", narrow),
    printed_on(b"rotl", narrow),
    printed_on(b"saturating_add", narrow),
    printed_on(b"saturating_add", full),
    printed_on(b"exact_mul", narrow),
  ];
  assert_eq(safe.filter(|c: Bytes| c.index_of(b"PLY_SITE(") != None), [])
}
