pub fn failure_exit(
  printing: Printing,
  unwind: List<Var>,
  root: Bytes,
) -> { printing: Printing, leave: Bytes } =
  by_declaration(printing, unwind.filter(|v: Var| is_refcounted(v.representation))).fold(
    { printing: printing, leave: root },
    |acc: { printing: Printing, leave: Bytes }, _: Int, vs: List<Var>|
      vs.fold(acc, |a: { printing: Printing, leave: Bytes }, v: Var|
        cleanup_jump(a.printing, v, a.leave)),
  )

fn by_declaration(printing: Printing, vs: List<Var>) -> Map<Int, List<Var>> =
  vs.fold(Map::new(), |m: Map<Int, List<Var>>, v: Var| {
    let k = declared_at(printing, v).at * 4294967296 + v.id;
    m.insert(k, match m.get(k) { Some(same) -> same.push(v), None -> [v] })
  })

fn cleanup_jump(printing: Printing, v: Var, then: Bytes) -> { printing: Printing, leave: Bytes } = {
  let name = name_of(printing, v);
  let key = Bytes::concat_all([name, b" ", then]);
  let ts = printing.tails;
  match ts.keyed.get(key) {
    Some(k) -> { printing: printing, leave: cleanup_goto(k) },
    None -> {
      let k = ts.all.len();
      let block = declared_at(printing, v).block;
      {
        printing: {
          ..printing,
          tails: {
            all: ts.all.push({
              name: name,
              id: v.id,
              ty: v.ty,
              representation: v.representation,
              then: then,
              resource: None,
            }),
            keyed: ts.keyed.insert(key, k),
            by_block: ts.by_block.insert(block, match ts.by_block.get(block) {
              Some(ks) -> ks.push(k),
              None -> [k],
            }),
          },
        },
        leave: cleanup_goto(k),
      }
    },
  }
}

fn cleanup_goto(k: Int) -> Bytes = Bytes::concat_all([b"goto ply_u", ascii_of_int(k), b";"])

pub fn failure_exit_through(
  printing: Printing,
  unwinds: List<Unwinding>,
  unwind: List<Var>,
  root: Bytes,
) -> { printing: Printing, leave: Bytes } =
  unwinds.reverse().fold(
    failure_exit(printing, unwind, root),
    |acc: { printing: Printing, leave: Bytes }, u: Unwinding|
      resource_cleanup_jump(acc.printing, u, acc.leave),
  )

fn resource_cleanup_jump(
  printing: Printing,
  u: Unwinding,
  then: Bytes,
) -> { printing: Printing, leave: Bytes } = {
  let name = Bytes::join(arg_parts(printing, u.arg), b", ");
  let key = Bytes::concat_all([b"let go ", ascii_of_int(printing.block), b" ", name, b" ", then]);
  let ts = printing.tails;
  match ts.keyed.get(key) {
    Some(k) -> { printing: printing, leave: cleanup_goto(k) },
    None -> {
      let k = ts.all.len();
      let held = match u.arg {
        VarOperand(v) -> { id: v.id, ty: v.ty },
        _ -> { id: -1, ty: unit_type() },
      };
      {
        printing: {
          ..printing,
          tails: {
            all: ts.all.push({
              name: name,
              id: held.id,
              ty: held.ty,
              representation: operand_representation(u.arg),
              then: then,
              resource: Some(u),
            }),
            keyed: ts.keyed.insert(key, k),
            by_block: ts.by_block.insert(printing.block, match ts.by_block.get(printing.block) {
              Some(ks) -> ks.push(k),
              None -> [k],
            }),
          },
        },
        leave: cleanup_goto(k),
      }
    },
  }
}

fn resource_released(printing: Printing, u: Unwinding) -> Fragment / {abort.raise} = {
  let k = u.callee;
  let noted = if printing.calls.contains(k) { printing } else {
    {
      ..printing,
      calls: printing.calls.push(k),
      expects: printing.expects.push({
        callee: CallAt(printing.calls.len()),
        head: signature_types(u.convention),
      }),
    }
  };
  let parts = arg_parts(noted, u.arg);
  let words = u.words.fold([], |acc: List<Bytes>, w: Arg| acc.concat(arg_parts(noted, w)));
  let r = match param_rep(u.convention, 0) { Some(x) -> x, None -> operand_representation(u.arg) };
  let ty = match u.arg { VarOperand(v) -> v.ty, _ -> unit_type() };
  let given = param_ownerships(u.convention).at(0) == Some(OwnedParam);
  let dup = if given { duped(noted, ty, operand_representation(u.arg), parts) }
  else { { printing: noted, out: [] } };
  let handed = match passing(r) {
    ByValue -> { first: b"", args: parts },
    ByReference ->
      {
        first: Bytes::concat_all([
          b"Word ply_b[] = {",
          Bytes::join(values_as_words(parts, c_values_of(r)), b", "),
          b"}; ",
        ]),
        args: [b"ply_b"],
      },
  };
  {
    printing: dup.printing,
    out: [
      Text(
        b"{ Word ply_h[PLY_UNWINDING_WORDS]; if (rt_unwind_hold_p(ctx, (Word)(intptr_t)ply_h)) { ",
      ),
    ].concat(
      dup.out,
    ).push(
      Text(handed.first),
    ).push(
      Hole(Symbol(Root(k))),
    ).push(
      Text(
        Bytes::concat_all([
          b"(ctx",
          Bytes::concat_all(handed.args.concat(words).map(|a: Bytes| b", ".concat(a))),
          b"); rt_unwind_resume_p(ctx, (Word)(intptr_t)ply_h); } }",
        ]),
      ),
    ),
  }
}

pub fn block_opened(printing: Printing) -> Printing =
  { ..printing, block: printing.blocks + 1, blocks: printing.blocks + 1 }

pub fn block_closed(
  printing: Printing,
  outer: Int,
  depth: Int,
  falls: Bool,
) -> Printing / {abort.raise} = {
  let here = match printing.tails.by_block.get(printing.block) {
    Some(ks) -> ks.reverse(),
    None -> [],
  };
  let lines = range(0, here.len()).fold(
    { printing: printing, out: [] },
    |acc: { printing: Printing, out: List<List<Piece>> }, i: Int|
      match here.at(i) {
        None -> acc,
        Some(k) -> match acc.printing.tails.all.at(k) {
          None -> acc,
          Some(t) -> {
            let falls_on = match here.at(i + 1) {
              Some(next) -> cleanup_goto(next) == t.then,
              None -> false,
            };
            let let_go = match t.resource {
              Some(u) -> resource_released(acc.printing, u),
              None -> if acc.printing.placing.slots.contains(t.id) {
                slot_released(acc.printing, t.name, t.ty)
              } else {
                released(acc.printing, t.ty, t.representation, part_names(t.name, t.representation))
              },
            };
            {
              printing: let_go.printing,
              out: acc.out.push(
                [Text(Bytes::concat_all([b"ply_u", ascii_of_int(k), b": "]))].concat(
                  if let_go.out.len() == 0 { [Text(b";")] } else { let_go.out },
                ).push(
                  Text(if falls_on { b"" } else { b" ".concat(t.then) }),
                ),
              ),
            }
          },
        },
      },
  );
  let tailed_line = |q: Printing, at: Int, ps: List<Piece>|
    { ..q, out: q.out.push(Text(pad(at))).concat(ps).push(Text(b"\n")) };
  let closed = if lines.out.len() == 0 { lines.printing } else if falls {
    line(
      lines.out.fold(line(lines.printing, depth, b"if (0) {"), |q: Printing, ps: List<Piece>|
        tailed_line(q, depth + 1, ps)),
      depth,
      b"}",
    )
  } else {
    lines.out.fold(lines.printing, |q: Printing, ps: List<Piece>| tailed_line(q, depth, ps))
  };
  { ..closed, block: outer }
}

pub type Fragment = { printing: Printing, out: List<Piece> }

fn slot_released(printing: Printing, name: Bytes, ty: Type) -> Fragment / {abort.raise} =
  match known_layout(printing.constructors, ty) {
    Some(l) ->
      parts_released(
        printing,
        layout_parts(printing.constructors, ty, l, 0),
        range(0, words(l)).map(|k: Int| slot(name, k)),
      ),
    None -> unsupported(b"a slot of a record laid out at no layout", name),
  }

pub fn count_printed(
  p: InstructionContext,
  printing: Printing,
  i: Inst,
) -> Printing / {abort.raise} =
  match i {
    Inc(n) -> {
      let once = duped(
        printing,
        n.var.ty,
        n.var.representation,
        part_names(name_of(printing, n.var), n.var.representation),
      );
      fragment_line(p.depth, {
        printing: once.printing,
        out: range(0, n.n).fold([], |acc: List<Piece>, _: Int| spaced(acc, once.out)),
      })
    },
    Dec(v) -> match printing.placing.slots.get(v.id) {
      None ->
        fragment_line(
          p.depth,
          released(
            printing,
            v.ty,
            v.representation,
            part_names(name_of(printing, v), v.representation),
          ),
        ),
      Some(_) -> if printing.placing.moved.contains(v.id) {
        { ..printing, placing: { ..printing.placing, moved: printing.placing.moved.remove(v.id) } }
      } else { fragment_line(p.depth, slot_released(printing, name_of(printing, v), v.ty)) },
    },
    Reset(r) ->
      reset_boxed(
        printing,
        p.depth,
        r.token,
        r.of,
        block_contents(printing.constructors, r.of.ty, r.of.representation),
        root_of_representation(Drop, printing.constructors, r.of.ty, r.of.representation),
      ),
    Free(r) -> {
      let t = name_of(printing, r.of);
      line(
        printing,
        p.depth,
        Bytes::concat_all([
          b"if (",
          t,
          b") ",
          call_text(free_fn(), [b"ctx", t, arg_text(printing, r.bytes)]),
          b";",
        ]),
      )
    },
    Destructure(o) -> match o.of.representation {
      AsFlattened(ls) -> flat_opened(printing, p.depth, o.of, ls, o.words),
      AsSum(s) -> match sole_boxed_payload(s.layout) {
        Some(_) ->
          opened_block(
            printing,
            p.depth,
            o.of,
            o.words,
            block_contents(printing.constructors, o.of.ty, o.of.representation),
          ),
        None -> opened_sum(printing, p.depth, o.of, o.words),
      },
      _ ->
        opened_block(
          printing,
          p.depth,
          o.of,
          o.words,
          block_contents(printing.constructors, o.of.ty, o.of.representation),
        ),
    },
    _ -> printing,
  }

fn flat_opened(
  printing: Printing,
  depth: Int,
  of: Var,
  ls: List<Leaf>,
  words: List<Var>,
) -> Printing = {
  let values = part_names(name_of(printing, of), of.representation);
  let at = declared_at(printing, of);
  let renamed = |q: Printing, w: Var, k: Int|
    match values.at(k) {
      Some(n) -> { ..q, names: q.names.insert(w.id, n), declared: q.declared.insert(w.id, at) },
      None -> q,
    };
  range(0, words.len()).fold(printing, |q: Printing, k: Int|
    match ((words.at(k), ls.at(k))) {
      (Some(w), Some(l)) -> {
        let run = leaf_values(ls, k);
        match l.representation {
          AsUnit -> q,
          AsSum(_) -> {
            let n = named(q, w);
            let into = part_names(n.name, w.representation);
            line(
              n.printing,
              depth,
              Bytes::join(
                range(0, into.len()).map(|j: Int|
                  Bytes::concat_all([
                    b"Word ",
                    nth_or_zero(into, j),
                    b" = ",
                    nth_or_zero(values, run.at + j),
                    b";",
                  ])),
                b" ",
              ),
            )
          },
          _ -> renamed(q, w, run.at),
        }
      },
      _ -> q,
    })
}

pub fn fragment_line(depth: Int, s: Fragment) -> Printing =
  if s.out.len() == 0 { s.printing } else {
    { ..s.printing, out: s.printing.out.push(Text(pad(depth))).concat(s.out).push(Text(b"\n")) }
  }

fn spaced(a: List<Piece>, b: List<Piece>) -> List<Piece> =
  if a.len() == 0 { b } else if b.len() == 0 { a } else { a.push(Text(b" ")).concat(b) }

fn part_widths(r: Representation) -> List<Int> =
  match r {
    AsFlattened(ls) -> ls.map(|l: Leaf| c_values_of(l.representation).len()),
    AsSum(_) -> [c_values_of(r).len()],
    AsUnit -> [0],
    _ -> parts_of(r).map(|_: Representation| 1),
  }

fn per_part(r: Representation, values: List<Bytes>) -> List<List<Bytes>> =
  part_widths(r).fold({ at: 0, out: [] }, |acc: { at: Int, out: List<List<Bytes>> }, n: Int|
    { at: acc.at + n, out: acc.out.push(values.drop(acc.at).take(n)) }).out

pub fn released(
  printing: Printing,
  ty: Type,
  r: Representation,
  values: List<Bytes>,
) -> Fragment / {abort.raise} =
  match r {
    AsReuseToken(n) -> {
      let t = nth_or_zero(values, 0);
      { printing: printing, out: [Text(Bytes::concat_all([b"if (", t, b") ", freed(t, n)]))] }
    },
    _ -> {
      let each = counted_parts(printing.constructors, ty, r);
      let vs = per_part(r, values);
      let by_word = range(0, each.len()).fold(
        { printing: printing, out: [] },
        |acc: Fragment, k: Int|
          match ((each.at(k), vs.at(k))) {
            (Some(parts), Some(ws)) -> {
              let s = parts_released(acc.printing, parts, ws);
              { printing: s.printing, out: spaced(acc.out, s.out) }
            },
            _ -> acc,
          },
      );
      match count_root(printing, keys::Release, ty, r, values) {
        Some(k) ->
          shorter(
            by_word,
            count_root_call(
              printing,
              k,
              {
                params: [{ ownership: OwnedParam, representation: r }],
                result: AsWord,
                destination_passing: false,
                returned: OwnedResult,
              },
              values,
            ),
          ),
        None -> by_word,
      }
    },
  }

pub fn duped(
  printing: Printing,
  ty: Type,
  r: Representation,
  values: List<Bytes>,
) -> Fragment / {abort.raise} = {
  let each = counted_parts(printing.constructors, ty, r);
  let vs = per_part(r, values);
  let d = Bytes::join(
    range(0, each.len()).fold([], |acc: List<Bytes>, k: Int|
      match ((each.at(k), vs.at(k))) {
        (Some(parts), Some(ws)) -> {
          let d = dup_of(parts, ws);
          if d.len() == 0 { acc } else { acc.push(d) }
        },
        _ -> acc,
      }),
    b" ",
  );
  let by_word = { printing: printing, out: if d.len() == 0 { [] } else { [Text(d)] } };
  match count_root(printing, Dup, ty, r, values) {
    Some(k) ->
      shorter(
        by_word,
        count_root_call(
          printing,
          k,
          {
            params: [{ ownership: BorrowedParam, representation: r }],
            result: r,
            destination_passing: false,
            returned: OwnedResult,
          },
          values,
        ),
      ),
    None -> by_word,
  }
}

fn count_root(
  printing: Printing,
  op: TypeOp,
  ty: Type,
  r: Representation,
  values: List<Bytes>,
) -> Option<RootKey> / {abort.raise} =
  if printing.count_root_type == Some(ty) || values.all(|v: Bytes| v == b"0") { None }
  else { counted_through(op, printing.constructors, ty, r) }

fn shorter(by_word: Fragment, call: Fragment) -> Fragment / {abort.raise} =
  if pieces_text(call.out).len() < pieces_text(by_word.out).len() { call } else { by_word }

fn count_root_call(
  printing: Printing,
  k: RootKey,
  conv: Convention,
  values: List<Bytes>,
) -> Fragment = {
  let r = match param_rep(conv, 0) { Some(x) -> x, None -> AsWord };
  let reps = c_values_of(r);
  let read = range(0, reps.len()).map(|j: Int|
    match reps.at(j) {
      Some(c) -> if is_refcounted(c) { nth_or_zero(values, j) } else { zero(c) },
      None -> b"0",
    });
  let args = match passing(r) {
    ByValue -> read,
    ByReference ->
      [Bytes::concat_all([b"(Word[]){", Bytes::join(values_as_words(read, reps), b", "), b"}"])],
  };
  let n = return_buffer_words(conv.result);
  let buffer = if n == 0 { [] }
  else { [Bytes::concat_all([b"(Word[", ascii_of_int(n), b"]){0}"])] };
  {
    printing: noted_at(printing, k, conv),
    out: [
      Hole(Symbol(Root(k))),
      Text(Bytes::concat_all([b"(ctx, ", Bytes::join(args.concat(buffer), b", "), b");"])),
    ],
  }
}

pub fn parts_released(printing: Printing, parts: List<Part>, ws: List<Bytes>) -> Fragment =
  parts.fold({ printing: printing, out: [] }, |acc: Fragment, p: Part| {
    let s = part_released(acc.printing, p, ws);
    { printing: s.printing, out: spaced(acc.out, s.out) }
  })

fn part_released(printing: Printing, p: Part, ws: List<Bytes>) -> Fragment =
  match p {
    WordAt(w) -> if nth_or_zero(ws, w.at) == b"0" { { printing: printing, out: [] } }
    else { word_released(printing, word_of(ws, w.at, w.masked), w.how) },
    ByCase(c) -> {
      let sws = sum_words(ws, c.at, c.sum);
      let arms = c.cases.fold(
        { printing: printing, out: [] },
        |acc: Fragment, k: { case: Int, parts: List<Part> }| {
          let inner = parts_released(acc.printing, k.parts, sws);
          {
            printing: inner.printing,
            out: acc.out.push(Text(Bytes::concat_all([case_label(c.sum, k.case), b" "]))).concat(
              inner.out,
            ).push(
              Text(b" break; "),
            ),
          }
        },
      );
      {
        printing: arms.printing,
        out: [Text(Bytes::concat_all([b"switch (", switch_value(c.sum, sws), b") { "]))].concat(
          arms.out,
        ).push(
          Text(
            empty_arms(c.sum, c.cases.map(|k: { case: Int, parts: List<Part> }| k.case)).concat(
              b"}",
            ),
          ),
        ),
      }
    },
  }

fn word_released(printing: Printing, x: Bytes, how: CountedWord) -> Fragment =
  match how {
    Object(k) -> drop_root_call(printing, k, release_fn(), x),
    CaseBox(c) -> drop_root_call(printing, case_root(Drop, c.sum, c.case), release_fn(), x),
    SumWord(k) -> drop_root_call(printing, k, release_sum_fn(), x),
    ScalarWord(s) ->
      {
        printing: printing,
        out: [
          Text(
            call_text(release_box_fn(), [
              b"ctx",
              x,
              ascii_of_int(header_bytes() + 8 * s.words),
            ]).concat(
              b";",
            ),
          ),
        ],
      },
    ThroughDescriptor ->
      {
        printing: printing,
        out: [
          Text(
            Bytes::concat_all([
              b"if (",
              x,
              b" && ",
              call_text(last_fn(), [b"ctx", x]),
              b") ",
              descriptor_of(x),
              b"->release(ctx, ",
              x,
              b");",
            ]),
          ),
        ],
      },
    RuntimeHandle ->
      {
        printing: printing,
        out: [
          Text(
            Bytes::concat_all([
              b"if (",
              x,
              b" && ",
              call_text(last_fn(), [b"ctx", x]),
              b") ",
              call_text(handle_free_fn(), [b"ctx", x]),
              b";",
            ]),
          ),
        ],
      },
  }

pub fn descriptor_of(x: Bytes) -> Bytes =
  Bytes::concat_all([b"((const PlyFnDesc *)(intptr_t)", slot(x, 0), b")"])

fn drop_root_call(printing: Printing, k: RootKey, f: Bytes, x: Bytes) -> Fragment =
  {
    printing: noted(printing, k, AsWord),
    out: [Text(call_start(f, [b"ctx", x])), Hole(Symbol(Root(k))), Text(b");")],
  }

fn noted(printing: Printing, k: RootKey, result: Representation) -> Printing =
  noted_at(printing, k, {
    params: [{ ownership: OwnedParam, representation: AsWord }],
    result: result,
    destination_passing: false,
    returned: OwnedResult,
  })

fn noted_at(printing: Printing, k: RootKey, conv: Convention) -> Printing =
  if printing.calls.contains(k) { printing } else {
    {
      ..printing,
      calls: printing.calls.push(k),
      expects: printing.expects.push({
        callee: CallAt(printing.calls.len()),
        head: signature_types(conv),
      }),
    }
  }

fn word_of(ws: List<Bytes>, at: Int, masked: Bool) -> Bytes = {
  let w = nth_or_zero(ws, at);
  if masked { Bytes::concat_all([b"(", w, b" & ~(Word)", ascii_of_int(tag_mask()), b")"]) }
  else { w }
}

fn tag_mask() -> Int = (1 << tag_bits()) - 1

fn sum_words(ws: List<Bytes>, at: Int, s: SumLayout) -> List<Bytes> =
  range(at, at + words(SumCases(s))).map(|k: Int| nth_or_zero(ws, k))

pub fn dup_of(parts: List<Part>, ws: List<Bytes>) -> Bytes =
  Bytes::join(parts.map(|p: Part| part_dup(p, ws)).filter(|d: Bytes| d.len() > 0), b" ")

fn part_dup(p: Part, ws: List<Bytes>) -> Bytes =
  match p {
    WordAt(w) -> if nth_or_zero(ws, w.at) == b"0" { b"" }
    else { word_dup(word_of(ws, w.at, w.masked), w.how) },
    ByCase(c) -> {
      let sws = sum_words(ws, c.at, c.sum);
      Bytes::concat_all(
        [Bytes::concat_all([b"switch (", switch_value(c.sum, sws), b") { "])].concat(
          c.cases.map(|k: { case: Int, parts: List<Part> }|
            Bytes::concat_all([
              case_label(c.sum, k.case),
              b" ",
              dup_of(k.parts, sws),
              b" break; ",
            ])),
        ).push(
          empty_arms(c.sum, c.cases.map(|k: { case: Int, parts: List<Part> }| k.case)).concat(b"}"),
        ),
      )
    },
  }

fn word_dup(x: Bytes, how: CountedWord) -> Bytes =
  match how {
    SumWord(_) ->
      Bytes::concat_all([
        b"if ((uint64_t)",
        x,
        b" >= ",
        ascii_of_int(pointer_floor()),
        b") ",
        call_text(dup_fn(), [Bytes::concat_all([x, b" & ~(Word)", ascii_of_int(tag_mask())])]),
        b";",
      ]),
    _ -> call_text(dup_fn(), [x]).concat(b";"),
  }

fn slots_of(x: Bytes, at: Int, r: Representation) -> List<Bytes> =
  match r {
    AsSum(s) -> range(at, at + words(SumCases(s.layout))).map(|k: Int| slot(x, k)),
    _ -> [slot(x, at)],
  }

pub fn opened_block(
  printing: Printing,
  depth: Int,
  o: Var,
  ws: List<Var>,
  opening: BlockContents,
) -> Printing / {abort.raise} = {
  let x = name_of(printing, o);
  let read = |held: List<BlockPart>|
    range(0, ws.len()).fold(printing, |q: Printing, i: Int|
      match ((ws.at(i), held.at(i))) {
        (Some(w), Some(h)) -> {
          let n = named(q, w);
          let from = slots_of(x, h.at, w.representation);
          let into = part_names(n.name, w.representation);
          line(
            n.printing,
            depth,
            Bytes::join(
              range(0, into.len()).map(|k: Int|
                Bytes::concat_all([
                  b"Word ",
                  nth_or_zero(into, k),
                  b" = ",
                  nth_or_zero(from, k),
                  b";",
                ])),
              b" ",
            ),
          )
        },
        _ -> q,
      });
  match opening {
    WordBlock(b) -> line(read(b.parts), depth, freed(x, b.words)),
    ScopedContents(h) ->
      line(read([h]), depth, call_text(handle_free_fn(), [b"ctx", x]).concat(b";")),
    ScalarBox(_) -> fragment_line(depth, released(printing, o.ty, o.representation, [x])),
    ClosureBlock ->
      line(printing, depth, Bytes::concat_all([descriptor_of(x), b"->release(ctx, ", x, b");"])),
    HandleBlock -> line(printing, depth, call_text(handle_free_fn(), [b"ctx", x]).concat(b";")),
    _ -> fragment_line(depth, contents_released(printing, x, opening)),
  }
}

fn freed(x: Bytes, n: Int) -> Bytes = freed_bytes(x, ascii_of_int(header_bytes() + 8 * n))

fn freed_bytes(x: Bytes, bytes: Bytes) -> Bytes =
  call_text(free_fn(), [b"ctx", x, bytes]).concat(b";")

fn field(s: MachineStruct, x: Bytes, f: Bytes) -> Bytes = head_field(s, x, f)

fn reference_count_of(x: Bytes) -> Bytes = Bytes::concat_all([b"ply_obj(", x, b")->rc"])

fn looped(n: Bytes, body: List<Piece>) -> List<Piece> =
  if body.len() == 0 { [] } else {
    [Text(Bytes::concat_all([b"for (int64_t ply_i = 0; ply_i < ", n, b"; ply_i++) { "]))].concat(
      body,
    ).push(
      Text(b" }"),
    )
  }

fn contents_released(
  printing: Printing,
  x: Bytes,
  opening: BlockContents,
) -> Fragment / {abort.raise} =
  match opening {
    BytesBlock ->
      {
        printing: printing,
        out: [Text(freed_bytes(x, text_block_bytes(field(text_head(), x, b"room"))))],
      },
    ListOf(l) -> {
      let laid = container_layouts().list;
      let w = item_read_at(x, laid.items, l.stride);
      let items = parts_released(printing, l.item, w.names);
      let owner = drop_root_call(items.printing, l.whole, release_fn(), slot(x, laid.owner));
      let each = if items.out.len() == 0 { [] } else { [Text(w.read)].concat(items.out) };
      {
        printing: owner.printing,
        out: [Text(Bytes::concat_all([b"if (", slot(x, laid.owner), b") { "]))].concat(
          owner.out,
        ).push(
          Text(b" } else { "),
        ).concat(
          looped(field(list_head(), x, b"claimed"), each),
        ).push(
          Text(Bytes::concat_all([b" } ", freed_bytes(x, block_size(x, opening))])),
        ),
      }
    },
    MapOf(k) -> {
      let root = drop_root_call(printing, k, release_fn(), slot(x, container_layouts().map.root));
      {
        printing: root.printing,
        out: root.out.push(Text(b" ".concat(freed(x, container_layouts().map.words)))),
      }
    },
    MapNodeOf(m) -> {
      let tree = container_layouts().tree;
      let br = branch_layout(m.key_words);
      let pair = m.key_words + m.value_words;
      let kid = drop_root_call(
        printing,
        m.node,
        release_fn(),
        word_slot(x, offset_index(tree.first, b"ply_i")),
      );
      let greatest = run_read(x, b"ply_k", br.keys, m.key_words, m.key_words);
      let max = parts_released(kid.printing, m.key, greatest.names);
      let leaf_keys = run_read(x, b"ply_k", tree.first, pair, m.key_words);
      let keys = parts_released(max.printing, m.key, leaf_keys.names);
      let leaf_values = run_read(x, b"ply_v", tree.first + m.key_words, pair, m.value_words);
      let values = parts_released(keys.printing, m.value, leaf_values.names);
      let read = |r: { names: List<Bytes>, read: Bytes }, s: Fragment|
        if s.out.len() == 0 { [] } else { [Text(r.read)].concat(s.out) };
      let branch = kid.out.push(Text(b" ")).concat(read(greatest, max));
      let leaf = spaced(read(leaf_keys, keys), read(leaf_values, values));
      {
        printing: values.printing,
        out: [Text(Bytes::concat_all([b"if (", node_is(x, tree.branch), b") { "]))].concat(
          looped(field(node_head(), x, b"len"), branch),
        ).push(
          Text(b" } else { "),
        ).concat(
          looped(field(node_head(), x, b"len"), leaf),
        ).push(
          Text(Bytes::concat_all([b" } ", freed_bytes(x, block_size(x, opening))])),
        ),
      }
    },
    ArrayOf(a) -> {
      let first = head_words(array_head());
      let at = |j: Int|
        word_slot(
          x,
          Bytes::concat_all([ascii_of_int(first + j), b" + ply_i * ", ascii_of_int(a.stride)]),
        );
      let each = parts_released(printing, a.element, range(0, a.stride).map(at));
      {
        printing: each.printing,
        out: [Text(b"{ ")].concat(
          spaced(looped(field(array_head(), x, b"len"), each.out), [
            Text(freed_bytes(x, block_size(x, ArrayOf(a)))),
          ]),
        ).push(
          Text(b" }"),
        ),
      }
    },
    ColumnsOf(ks) -> {
      let first = columns_layout().first;
      let each = range(0, ks.len()).fold(
        { printing: printing, out: [] },
        |acc: Fragment, i: Int|
          match ks.at(i) {
            Some(k) -> {
              let c = drop_root_call(acc.printing, k, release_fn(), slot(x, first + i));
              { printing: c.printing, out: spaced(acc.out, c.out) }
            },
            None -> acc,
          },
      );
      { printing: each.printing, out: spaced(each.out, [Text(freed(x, ks.len()))]) }
    },
    _ -> { printing: printing, out: [] },
  }

fn node_is(x: Bytes, kind: Int) -> Bytes =
  Bytes::concat_all([field(node_head(), x, b"kind"), b" == ", ascii_of_int(kind)])

fn offset_index(first: Int, at: Bytes) -> Bytes =
  if first == 0 { at } else { Bytes::concat_all([ascii_of_int(first), b" + ", at]) }

fn item_read_at(
  x: Bytes,
  from: Int,
  stride: Int,
) -> { names: List<Bytes>, read: Bytes } / {abort.raise} =
  run_read(x, b"ply_w", from, stride, stride)

fn run_read(
  x: Bytes,
  prefix: Bytes,
  from: Int,
  stride: Int,
  count: Int,
) -> { names: List<Bytes>, read: Bytes } / {abort.raise} = {
  let slots = run_slots(x, from, stride, count);
  let names = if count == 1 { [prefix] }
  else { range(0, count).map(|j: Int| prefix.concat(ascii_of_int(j))) };
  {
    names: names,
    read: Bytes::concat_all(
      range(0, count).map(|j: Int|
        Bytes::concat_all([b"Word ", names.get(j), b" = ", slots.get(j), b"; "])),
    ),
  }
}

fn item_slots_at(x: Bytes, from: Int, stride: Int) -> List<Bytes> =
  run_slots(x, from, stride, stride)

fn run_slots(x: Bytes, from: Int, stride: Int, count: Int) -> List<Bytes> =
  range(0, count).map(|j: Int|
    word_slot(x, if stride != 1 {
      Bytes::concat_all([ascii_of_int(from + j), b" + ply_i * ", ascii_of_int(stride)])
    } else if from + j == 0 { b"ply_i" }
    else { ascii_of_int(from + j).concat(b" + ply_i") }))

fn items_words(n: Bytes, stride: Int) -> Bytes =
  if stride == 1 { n } else { Bytes::concat_all([n, b" * ", ascii_of_int(stride)]) }

pub fn walk_value(
  p: InstructionContext,
  printing: Printing,
  into: Option<Var>,
  of: Var,
  op: TypeOp,
) -> Printing / {abort.raise} =
  match into {
    None -> unsupported(b"a value walked that nothing holds", var_text(of)),
    Some(n) -> {
      let whole = |q: Printing|
        walk_block(
          q,
          p.depth,
          n,
          of,
          op,
          block_contents(q.constructors, of.ty, of.representation),
          root_of_representation(Drop, q.constructors, of.ty, of.representation),
        );
      match of.representation {
        AsSum(s) -> match sole_boxed_payload(s.layout) {
          Some(_) -> whole(printing),
          None ->
            walk_sum(
              printing,
              p.depth,
              n,
              of,
              op,
              case_blocks(printing.constructors, of.ty, s.layout),
            ),
        },
        _ -> whole(printing),
      }
    },
  }

pub fn walk_block(
  printing: Printing,
  depth: Int,
  into: Var,
  of: Var,
  op: TypeOp,
  opening: BlockContents,
  dropped: RootKey,
) -> Printing / {abort.raise} = {
  let x = name_of(printing, of);
  let n = named(printing, into);
  let a = n.name;
  match op {
    Share -> {
      let marked = match opening {
        ClosureBlock ->
          {
            printing: n.printing,
            out: [
              Text(
                Bytes::concat_all([
                  b"if (",
                  x,
                  b") ",
                  a,
                  b" = ",
                  descriptor_of(x),
                  b"->share(ctx, ",
                  x,
                  b");",
                ]),
              ),
            ],
          },
        HandleBlock ->
          {
            printing: n.printing,
            out: [Text(Bytes::concat_all([b"if (", x, b") ", a, b" = 0;"]))],
          },
        ScopedContents(_) ->
          {
            printing: n.printing,
            out: [Text(Bytes::concat_all([b"if (", x, b") ", a, b" = 0;"]))],
          },
        _ -> {
          let parts = each_counted_slot(
            n.printing,
            x,
            opening,
            |q: Printing, ps: List<Part>, ws: List<Bytes>| shared_parts(q, a, ps, ws),
          );
          {
            printing: parts.printing,
            out: [Text(Bytes::concat_all([b"if (", unshared_fn(), b"(", x, b")) { "]))].concat(
              parts.out,
            ).push(
              Text(
                Bytes::concat_all([b" if (", a, b") ", call_text(mark_shared_fn(), [x]), b"; }"]),
              ),
            ),
          }
        },
      };
      fragment_line(depth, {
        printing: marked.printing,
        out: [Text(Bytes::concat_all([b"Word ", a, b" = 1; "]))].concat(marked.out),
      })
    },
    Keep -> if holds_unkeepable_value(n.printing.constructors, opening) {
      line(n.printing, depth, Bytes::concat_all([b"Word ", a, b" = 0;"]))
    } else {
      match opening {
        ClosureBlock ->
          line(
            n.printing,
            depth,
            Bytes::concat_all([
              b"Word ",
              a,
              b" = ",
              x,
              b" ? ",
              descriptor_of(x),
              b"->keep(ctx, ",
              x,
              b") : 0;",
            ]),
          ),
        _ -> {
          let parts = each_counted_slot(
            n.printing,
            a,
            opening,
            |q: Printing, ps: List<Part>, ws: List<Bytes>| persisted_parts(q, ps, ws),
          );
          fragment_line(depth, {
            printing: parts.printing,
            out: [
              Text(
                Bytes::concat_all([
                  b"Word ",
                  a,
                  b" = ",
                  x,
                  b"; if (",
                  x,
                  b" && ",
                  reference_count_of(x),
                  b" != UINT32_MAX) { ",
                  a,
                  b" = ",
                  kept_copy(x, opening),
                  b"; ",
                ]),
              ),
            ].concat(
              parts.out,
            ).push(
              Text(b" }"),
            ),
          })
        },
      }
    },
    Copy -> match opening {
      ClosureBlock -> unsupported(b"a function value copied", var_text(of)),
      HandleBlock -> unsupported(b"a runtime handle copied", var_text(of)),
      ScopedContents(_) -> unsupported(b"a scoped value copied", var_text(of)),
      _ -> {
        let duped_slots = each_counted_slot(
          n.printing,
          a,
          opening,
          |q: Printing, ps: List<Part>, ws: List<Bytes>| {
            let d = dup_of(ps, ws);
            { printing: q, out: if d.len() == 0 { [] } else { [Text(d)] } }
          },
        );
        let let_go = drop_root_call(duped_slots.printing, dropped, release_fn(), x);
        fragment_line(depth, {
          printing: let_go.printing,
          out: [
            Text(Bytes::concat_all([b"Word ", a, b" = ", fresh_copy(x, opening), b"; "])),
          ].concat(
            spaced(duped_slots.out, let_go.out),
          ),
        })
      },
    },
    _ -> unsupported(b"a block walked by no walk", var_text(of)),
  }
}

pub fn walk_sum(
  printing: Printing,
  depth: Int,
  into: Var,
  of: Var,
  op: TypeOp,
  blocks: List<{ case: Int, ty: Type, representation: Representation, opening: BlockContents }>,
) -> Printing / {abort.raise} =
  match of.representation {
    AsSum(s) -> {
      let n = named(printing, into);
      let a = n.name;
      if op == Keep
          && blocks.fold(
            false,
            |any: Bool, b: { case: Int, ty: Type, representation: Representation, opening: BlockContents }|
              any || holds_unkeepable_value(printing.constructors, b.opening),
          ) { line(n.printing, depth, Bytes::concat_all([b"Word ", a, b" = 0;"])) }
      else { walk_sum_cases(n.printing, depth, a, of, s, op, blocks) }
    },
    _ -> unsupported(b"a sum of one word walked that is no sum", var_text(of)),
  }

fn walk_sum_cases(
  printing: Printing,
  depth: Int,
  a: Bytes,
  of: Var,
  s: { layout: SumLayout, cases: List<Bytes> },
  op: TypeOp,
  blocks: List<{ case: Int, ty: Type, representation: Representation, opening: BlockContents }>,
) -> Printing / {abort.raise} = {
  let x = name_of(printing, of);
  let untagged = match s.layout.classes { [Pointer] -> true, _ -> false };
  let held = if op == Keep { b"*ply_into" } else { a };
  let tag = if untagged { b"" }
  else { Bytes::concat_all([b" | (ply_x & ", ascii_of_int(tag_mask()), b")"]) };
  let opened = |b: { case: Int, ty: Type, representation: Representation, opening: BlockContents }|
    Bytes::concat_all([
      case_label(s.layout, b.case),
      b" { Word ply_b = ",
      if payload_is_word(s.layout, b.representation) { b"ply_x" }
      else { Bytes::concat_all([b"(ply_x & ~(Word)", ascii_of_int(tag_mask()), b")"]) },
      b"; ",
    ]);
  let looped = |armed: List<Int>, arms: List<Piece>|
    [
      Text(
        Bytes::concat_all([
          b"Word ply_x = ",
          x,
          b"; for (;;) { Word ply_n = 0; switch (",
          switch_value(s.layout, [b"ply_x"]),
          b") { ",
        ]),
      ),
    ].concat(
      arms,
    ).push(
      Text(empty_arms(s.layout, armed).concat(b"} if (!ply_n) break; ply_x = ply_n; }")),
    );
  let arms = blocks.fold(
    { printing: printing, out: [] },
    |acc: Fragment, b: { case: Int, ty: Type, representation: Representation, opening: BlockContents }| {
      let body = walk_case(acc.printing, held, tag, op, of, b.ty, b.representation, b.opening);
      {
        printing: body.printing,
        out: acc.out.push(Text(opened(b))).concat(body.out).push(Text(b" } break; ")),
      }
    },
  );
  let boxes = if op == Share {
    blocks.filter(
      |b: { case: Int, ty: Type, representation: Representation, opening: BlockContents }|
        !uses_root_call(b.representation, b.opening),
    )
  } else { [] };
  let marking = if boxes.len() == 0 { [] } else {
    [Text(Bytes::concat_all([b" if (", a, b") { "]))].concat(
      looped(
        boxes.map(
          |b: { case: Int, ty: Type, representation: Representation, opening: BlockContents }|
            b.case,
        ),
        boxes.map(
          |b: { case: Int, ty: Type, representation: Representation, opening: BlockContents }|
            Text(
              Bytes::concat_all([
                opened(b),
                b"if (",
                unshared_fn(),
                b"(ply_b)) { ",
                call_text(mark_shared_fn(), [b"ply_b"]),
                b";",
                match split_chain(b.opening, of).next {
                  Some(at) -> Bytes::concat_all([b" ply_n = ", slot(b"ply_b", at), b";"]),
                  None -> b"",
                },
                b" } } break; ",
              ]),
            ),
        ),
      ),
    ).push(
      Text(b" }"),
    )
  };
  fragment_line(depth, {
    printing: arms.printing,
    out: [
      Text(
        Bytes::concat_all([
          b"Word ",
          a,
          b" = ",
          if op == Keep { x } else { b"1" },
          b"; ",
          if op == Keep { Bytes::concat_all([b"Word *ply_into = &", a, b"; "]) } else { b"" },
        ]),
      ),
    ].concat(
      looped(
        blocks.map(
          |b: { case: Int, ty: Type, representation: Representation, opening: BlockContents }|
            b.case,
        ),
        arms.out,
      ),
    ).concat(
      marking,
    ),
  })
}

fn uses_root_call(rep: Representation, o: BlockContents) -> Bool =
  rep == AsWord || (match o { InlineSum(_) -> true, _ -> false })

fn walk_case(
  printing: Printing,
  held: Bytes,
  tag: Bytes,
  op: TypeOp,
  own: Var,
  ty: Type,
  rep: Representation,
  o: BlockContents,
) -> Fragment / {abort.raise} =
  match ((op, uses_root_call(rep, o))) {
    (Keep, true) -> {
      let c = root_call(printing, root_of(Keep, ty), AsWord, b"ply_b");
      {
        printing: c.printing,
        out: [Text(Bytes::concat_all([held, b" = "]))].concat(c.out).push(
          Text(Bytes::concat_all([tag, b";"])),
        ),
      }
    },
    (Share, true) -> {
      let c = root_call(printing, root_of(Share, ty), AsInt, b"ply_b");
      {
        printing: c.printing,
        out: [Text(b"if (!")].concat(c.out).push(Text(Bytes::concat_all([b") ", held, b" = 0;"]))),
      }
    },
    _ -> {
      let split = split_chain(o, own);
      match op {
        Keep -> {
          let size = block_size(b"ply_b", o);
          let slots = each_counted_slot(
            printing,
            b"ply_k",
            split.rest,
            |q: Printing, ps: List<Part>, ws: List<Bytes>| persisted_parts(q, ps, ws),
          );
          let on = match split.next {
            Some(at) ->
              Bytes::concat_all([b" ply_into = &", slot(b"ply_k", at), b"; ply_n = *ply_into;"]),
            None -> b"",
          };
          {
            printing: slots.printing,
            out: [
              Text(
                Bytes::concat_all([
                  b"if (",
                  reference_count_of(b"ply_b"),
                  b" != UINT32_MAX) { Word ply_k = ",
                  call_text(persistent_copy_fn(), [b"ctx", b"ply_b", size]),
                  b"; ",
                ]),
              ),
            ].concat(
              slots.out,
            ).push(
              Text(Bytes::concat_all([b" ", held, b" = ply_k", tag, b";", on, b" }"])),
            ),
          }
        },
        Share -> {
          let slots = each_counted_slot(
            printing,
            b"ply_b",
            split.rest,
            |q: Printing, ps: List<Part>, ws: List<Bytes>| shared_parts(q, held, ps, ws),
          );
          let on = match split.next {
            Some(at) -> Bytes::concat_all([b" ply_n = ", slot(b"ply_b", at), b";"]),
            None -> b"",
          };
          {
            printing: slots.printing,
            out: [Text(Bytes::concat_all([b"if (", unshared_fn(), b"(ply_b)) { "]))].concat(
              slots.out,
            ).push(
              Text(Bytes::concat_all([on, b" }"])),
            ),
          }
        },
        _ -> unsupported(b"a sum of one word walked by no walk", op_name(op)),
      }
    },
  }

fn split_chain(o: BlockContents, own: Var) -> { rest: BlockContents, next: Option<Int> } =
  match o {
    WordBlock(b) -> {
      let last = range(0, b.parts.len()).fold(None, |found: Option<Int>, i: Int|
        match b.parts.at(i) {
          Some(h) -> if h.ty == own.ty && h.representation == own.representation { Some(i) }
          else { found },
          None -> found,
        });
      match last {
        Some(i) ->
          {
            rest: WordBlock({ ..b, parts: b.parts.take(i).concat(b.parts.drop(i + 1)) }),
            next: match b.parts.at(i) { Some(h) -> Some(h.at), None -> None },
          },
        None -> { rest: o, next: None },
      }
    },
    _ -> { rest: o, next: None },
  }

fn block_size(x: Bytes, o: BlockContents) -> Bytes =
  match o {
    WordBlock(b) -> ascii_of_int(header_bytes() + 8 * b.words),
    BytesBlock -> text_block_bytes(field(text_head(), x, b"room")),
    ListOf(l) ->
      Bytes::concat_all([
        ascii_of_int(header_bytes()),
        b" + 8 * (",
        ascii_of_int(container_layouts().list.items),
        b" + (",
        slot(x, container_layouts().list.owner),
        b" ? 0 : ",
        items_words(Bytes::concat_all([b"(int64_t)", field(list_head(), x, b"room")]), l.stride),
        b"))",
      ]),
    MapOf(_) -> ascii_of_int(header_bytes() + 8 * container_layouts().map.words),
    MapNodeOf(_) -> node_bytes(x),
    ArrayOf(a) ->
      Bytes::concat_all([
        ascii_of_int(header_bytes() + 8 * head_words(array_head())),
        b" + 8 * ",
        items_words(field(array_head(), x, b"len"), a.stride),
      ]),
    ColumnsOf(ks) -> ascii_of_int(header_bytes() + 8 * ks.len()),
    ScalarBox(w) -> ascii_of_int(header_bytes() + 8 * w),
    _ -> ascii_of_int(header_bytes()),
  }

fn node_bytes(x: Bytes) -> Bytes =
  Bytes::concat_all([
    ascii_of_int(header_bytes() + 8 * head_words(node_head())),
    b" + 8 * (int64_t)",
    field(node_head(), x, b"room"),
  ])

fn kept_copy(x: Bytes, o: BlockContents) -> Bytes =
  match o {
    ListOf(l) -> call_text(kept_list_fn(), [b"ctx", x, ascii_of_int(l.stride)]),
    _ -> call_text(persistent_copy_fn(), [b"ctx", x, block_size(x, o)]),
  }

fn fresh_copy(x: Bytes, o: BlockContents) -> Bytes =
  match o {
    ListOf(l) -> call_text(fresh_list_fn(), [b"ctx", x, ascii_of_int(l.stride)]),
    _ -> call_text(fresh_block_fn(), [b"ctx", x, block_size(x, o)]),
  }

pub fn persistent_copy_fn() -> Bytes = b"ply_kept_block"

pub fn fresh_block_fn() -> Bytes = b"ply_fresh_block"

pub fn kept_list_fn() -> Bytes = b"ply_kept_list"

pub fn fresh_list_fn() -> Bytes = b"ply_fresh_list"

pub fn unshared_fn() -> Bytes = b"ply_unshared"

pub fn mark_shared_fn() -> Bytes = b"ply_mark_shared"

fn list_copy_helpers() -> Bytes = {
  let laid = container_layouts().list;
  let lh = |x: Bytes, f: Bytes| field(list_head(), x, f);
  let items_at = ascii_of_int(laid.items);
  let moved = Bytes::concat_all([
    b"  memcpy(&",
    word_slot(b"c", items_at),
    b", ply_list_item(x, 0, stride), (size_t)(n * stride) * sizeof(Word));\n",
    b"  return c;\n}\n",
  ]);
  let count = Bytes::concat_all([b"  int64_t n = (int64_t)", lh(b"x", b"len"), b";\n"]);
  Bytes::concat_all([
    b"static inline Word ",
    kept_list_fn(),
    b"(PlyCtx *ctx, Word x, int64_t stride) {\n",
    count,
    b"  Word c = rt_alloc_kept_p(ctx, ",
    ascii_of_int(header_bytes() + 8 * laid.items),
    b" + 8 * n * stride);\n  ",
    lh(b"c", b"len"),
    b" = (uint32_t)n; ",
    lh(b"c", b"room"),
    b" = (uint32_t)n; ",
    lh(b"c", b"claimed"),
    b" = (uint32_t)n; ",
    lh(b"c", b"first"),
    b" = ",
    items_at,
    b"; ",
    slot(b"c", laid.owner),
    b" = 0;\n",
    moved,
    b"static inline Word ",
    fresh_list_fn(),
    b"(PlyCtx *ctx, Word x, int64_t stride) {\n",
    count,
    b"  Word c = ply_list_room(ctx, ",
    slot(b"x", laid.owner),
    b" ? n : (int64_t)",
    lh(b"x", b"room"),
    b", stride);\n  ",
    lh(b"c", b"len"),
    b" = (uint32_t)n; ",
    lh(b"c", b"claimed"),
    b" = (uint32_t)n;\n",
    moved,
  ])
}

pub fn walk_helpers() -> Bytes = {
  let copied = |made: Bytes|
    Bytes::concat_all([
      b"(PlyCtx *ctx, Word x, int64_t size) { Word c = ",
      made,
      b"(ctx, size); for (int64_t i = 0; i < (size - ",
      ascii_of_int(header_bytes()),
      b") / 8; i++) ",
      word_slot(b"c", b"i"),
      b" = ",
      word_slot(b"x", b"i"),
      b"; return c; }\n",
    ]);
  Bytes::concat_all([
    b"static inline Word ",
    persistent_copy_fn(),
    copied(b"rt_alloc_kept_p"),
    b"static inline Word ",
    fresh_block_fn(),
    copied(b"ply_alloc"),
    list_copy_helpers(),
    b"static inline int ",
    unshared_fn(),
    b"(Word x) { return x && ",
    reference_count_of(b"x"),
    b" < UINT32_C(0x80000000); }\n",
    b"static inline void ",
    mark_shared_fn(),
    b"(Word x) { ",
    reference_count_of(b"x"),
    b" |= UINT32_C(0x80000000); }\n",
  ])
}

pub fn each_counted_slot(
  printing: Printing,
  b: Bytes,
  o: BlockContents,
  act: (Printing, List<Part>, List<Bytes>) -> Fragment / {abort.raise},
) -> Fragment / {abort.raise} = {
  let node = |k: RootKey| [WordAt({ at: 0, masked: false, how: Object(k) })];
  let each = |q: Printing, parts: List<{ ps: List<Part>, ws: List<Bytes> }>|
    parts.fold({ printing: q, out: [] }, |acc: Fragment, x: { ps: List<Part>, ws: List<Bytes> }| {
      let s = act(acc.printing, x.ps, x.ws);
      { printing: s.printing, out: spaced(acc.out, s.out) }
    });
  match o {
    WordBlock(x) ->
      each(
        printing,
        x.parts.map(|h: BlockPart|
          { ps: stored_parts(printing.constructors, h), ws: slots_of(b, h.at, h.representation) }),
      ),
    ScopedContents(h) ->
      each(printing, [{ ps: stored_parts(printing.constructors, h), ws: [slot(b, h.at)] }]),
    ListOf(l) -> {
      let laid = container_layouts().list;
      let items = act(printing, l.item, item_slots_at(b, laid.items, l.stride));
      let owner = act(items.printing, node(l.whole), [slot(b, laid.owner)]);
      {
        printing: owner.printing,
        out: [Text(Bytes::concat_all([b"if (", slot(b, laid.owner), b") { "]))].concat(
          owner.out,
        ).push(
          Text(b" } else { "),
        ).concat(
          looped(field(list_head(), b, b"claimed"), items.out),
        ).push(
          Text(b" }"),
        ),
      }
    },
    MapOf(k) -> act(printing, node(k), [slot(b, container_layouts().map.root)]),
    MapNodeOf(m) -> {
      let tree = container_layouts().tree;
      let pair = m.key_words + m.value_words;
      let kid = act(printing, node(m.node), [word_slot(b, offset_index(tree.first, b"ply_i"))]);
      let greatest = act(
        kid.printing,
        m.key,
        run_slots(b, branch_layout(m.key_words).keys, m.key_words, m.key_words),
      );
      let keys = act(greatest.printing, m.key, run_slots(b, tree.first, pair, m.key_words));
      let values = act(
        keys.printing,
        m.value,
        run_slots(b, tree.first + m.key_words, pair, m.value_words),
      );
      {
        printing: values.printing,
        out: [Text(Bytes::concat_all([b"if (", node_is(b, tree.branch), b") { "]))].concat(
          looped(field(node_head(), b, b"len"), spaced(kid.out, greatest.out)),
        ).push(
          Text(b" } else { "),
        ).concat(
          looped(field(node_head(), b, b"len"), spaced(keys.out, values.out)),
        ).push(
          Text(b" }"),
        ),
      }
    },
    ArrayOf(a) -> {
      let first = head_words(array_head());
      let at = |j: Int|
        word_slot(
          b,
          Bytes::concat_all([ascii_of_int(first + j), b" + ply_i * ", ascii_of_int(a.stride)]),
        );
      let es = act(printing, a.element, range(0, a.stride).map(at));
      { printing: es.printing, out: looped(field(array_head(), b, b"len"), es.out) }
    },
    ColumnsOf(ks) ->
      each(
        printing,
        range(0, ks.len()).fold([], |acc: List<{ ps: List<Part>, ws: List<Bytes> }>, i: Int|
          match ks.at(i) {
            Some(k) -> acc.push({ ps: node(k), ws: [slot(b, columns_layout().first + i)] }),
            None -> acc,
          }),
      ),
    _ -> { printing: printing, out: [] },
  }
}
fn shared_parts(
  printing: Printing,
  a: Bytes,
  parts: List<Part>,
  ws: List<Bytes>,
) -> Fragment / {abort.raise} =
  each_word(printing, parts, ws, |q: Printing, w: Bytes, how: CountedWord| {
    let rejected = Bytes::concat_all([b") ", a, b" = 0;"]);
    match how {
      ThroughDescriptor ->
        {
          printing: q,
          out: [
            Text(
              Bytes::concat_all([
                b"if (",
                w,
                b" && !",
                descriptor_of(w),
                b"->share(ctx, ",
                w,
                b")",
                rejected,
              ]),
            ),
          ],
        },
      RuntimeHandle -> { printing: q, out: [Text(Bytes::concat_all([b"if (", w, rejected]))] },
      _ -> {
        let s = root_call(q, walk_root(Share, how), AsInt, w);
        {
          printing: s.printing,
          out: [Text(Bytes::concat_all([b"if (", points_to_block(w, how), b" && !"]))].concat(
            s.out,
          ).push(
            Text(rejected),
          ),
        }
      },
    }
  })

fn points_to_block(w: Bytes, how: CountedWord) -> Bytes =
  match how {
    SumWord(_) -> Bytes::concat_all([b"(uint64_t)", w, b" >= ", ascii_of_int(pointer_floor())]),
    _ -> w,
  }

fn persisted_parts(
  printing: Printing,
  parts: List<Part>,
  ws: List<Bytes>,
) -> Fragment / {abort.raise} =
  each_word(printing, parts, ws, |q: Printing, w: Bytes, how: CountedWord|
    match how {
      ThroughDescriptor -> unsupported(b"a function value kept inside another value", w),
      RuntimeHandle -> unsupported(b"a runtime handle kept for good", w),
      _ -> {
        let s = root_call(q, walk_root(Keep, how), AsWord, w);
        {
          printing: s.printing,
          out: [
            Text(Bytes::concat_all([b"if (", points_to_block(w, how), b") ", w, b" = "])),
          ].concat(
            s.out,
          ).push(
            Text(b";"),
          ),
        }
      },
    })

fn each_word(
  printing: Printing,
  parts: List<Part>,
  ws: List<Bytes>,
  act: (Printing, Bytes, CountedWord) -> Fragment / {abort.raise},
) -> Fragment / {abort.raise} =
  parts.fold({ printing: printing, out: [] }, |acc: Fragment, p: Part| {
    let s = match p {
      WordAt(w) -> if w.masked { unsupported_walk(nth_or_zero(ws, w.at)) }
      else { act(acc.printing, nth_or_zero(ws, w.at), w.how) },
      ByCase(c) -> {
        let sws = sum_words(ws, c.at, c.sum);
        let arms = c.cases.fold(
          { printing: acc.printing, out: [] },
          |a: Fragment, k: { case: Int, parts: List<Part> }| {
            let inner = each_word(a.printing, k.parts, sws, act);
            {
              printing: inner.printing,
              out: a.out.push(Text(Bytes::concat_all([case_label(c.sum, k.case), b" "]))).concat(
                inner.out,
              ).push(
                Text(b" break; "),
              ),
            }
          },
        );
        {
          printing: arms.printing,
          out: [Text(Bytes::concat_all([b"switch (", switch_value(c.sum, sws), b") { "]))].concat(
            arms.out,
          ).push(
            Text(
              empty_arms(c.sum, c.cases.map(|k: { case: Int, parts: List<Part> }| k.case)).concat(
                b"}",
              ),
            ),
          ),
        }
      },
    };
    { printing: s.printing, out: spaced(acc.out, s.out) }
  })

fn unsupported_walk(w: Bytes) -> Fragment / {abort.raise} =
  unsupported(b"not yet: a word holding a case's tag in its pointer walked", w)

fn walk_root(op: TypeOp, how: CountedWord) -> RootKey / {abort.raise} =
  match how {
    Object(k) -> retargeted(k, op),
    SumWord(k) -> retargeted(k, op),
    ScalarWord(s) -> root_of(op, s.ty),
    CaseBox(c) -> case_root(op, c.sum, c.case),
    _ -> unsupported(b"a word walked through no root", op_name(op)),
  }

fn retargeted(k: RootKey, op: TypeOp) -> RootKey / {abort.raise} =
  match k {
    Generated(_, _) -> keys::as_op(k, op),
    _ -> unsupported(b"a root of no type walked", root_text(root_name(k))),
  }

pub fn root_call(printing: Printing, k: RootKey, result: Representation, w: Bytes) -> Fragment =
  {
    printing: noted(printing, k, result),
    out: [Hole(Symbol(Root(k))), Text(Bytes::concat_all([b"(ctx, ", w, b")"]))],
  }

pub fn root_function(printing: Printing, k: RootKey, result: Representation) -> Fragment =
  { printing: noted(printing, k, result), out: [Hole(Symbol(Root(k)))] }

pub fn opened_sum(
  printing: Printing,
  depth: Int,
  o: Var,
  ws: List<Var>,
) -> Printing / {abort.raise} =
  match ((o.representation, ws)) {
    (AsSum(s), [b]) -> {
      let x = name_of(printing, o);
      assigned(printing, depth, b, b"Word", if payload_is_word(s.layout, b.representation) { x }
      else { Bytes::concat_all([b"(", x, b" & ~(Word)", ascii_of_int(tag_mask()), b")"]) })
    },
    _ -> unsupported(b"a sum opened other than into the block its case holds", var_text(o)),
  }

fn payload_is_word(s: SumLayout, r: Representation) -> Bool =
  s.classes == [Pointer] || (match r { AsSum(n) -> n.layout.classes != [Pointer], _ -> false })

pub fn reset_boxed(
  printing: Printing,
  depth: Int,
  token: Var,
  of: Var,
  opening: BlockContents,
  dropped: RootKey,
) -> Printing / {abort.raise} =
  match opening {
    WordBlock(b) -> {
      let x = name_of(printing, of);
      let t = named(printing, token);
      let held = b.parts.fold({ printing: t.printing, out: [] }, |acc: Fragment, h: BlockPart| {
        let s = parts_released(
          acc.printing,
          stored_parts(printing.constructors, h),
          slots_of(x, h.at, h.representation),
        );
        { printing: s.printing, out: spaced(acc.out, s.out) }
      });
      let shared = drop_root_call(held.printing, dropped, release_fn(), x);
      fragment_line(depth, {
        printing: shared.printing,
        out: [
          Text(
            Bytes::concat_all([
              b"Word ",
              t.name,
              b" = 0; if (",
              x,
              b" && ",
              reference_count_of(x),
              b" == 1) { ",
            ]),
          ),
        ].concat(
          spaced(held.out, [Text(Bytes::concat_all([t.name, b" = ", x, b";"]))]),
        ).push(
          Text(b" } else "),
        ).concat(
          shared.out,
        ),
      })
    },
    _ -> unsupported(b"cells kept of other than a box", var_text(of)),
  }

pub fn updated(
  p: InstructionContext,
  printing: Printing,
  into: Option<Var>,
  u: { of: Var, sets: List<FieldWrite> },
) -> Printing / {abort.raise} =
  match ((into, block_contents(printing.constructors, u.of.ty, u.of.representation))) {
    (Some(v), WordBlock(_)) -> {
      let x = name_of(printing, u.of);
      let n = named(printing, v);
      let o = n.name;
      let shared = root_call(n.printing, root_of(Copy, u.of.ty), AsWord, x);
      let written = u.sets.fold(
        { printing: shared.printing, out: [] },
        |acc: Fragment, s: FieldWrite|
          match inline_layout(printing, s.ty) {
            Some(l) -> {
              let first = Bytes::concat_all([b"&", slot(o, s.at + 1)]);
              let old = parts_released(
                acc.printing,
                layout_parts(printing.constructors, s.ty, l, 0),
                range(0, words(l)).map(|k: Int| slot(o, s.at + 1 + k)),
              );
              let src = nth_or_zero(arg_parts(old.printing, s.arg), 0);
              let write = if moves_slot(printing, s.arg, v.id) {
                { printing: old.printing, text: move_inline(slot(o, s.at), first, src, l) }
              } else { copy_inline(old.printing, slot(o, s.at), first, src, l) };
              {
                printing: write.printing,
                out: spaced(spaced(acc.out, old.out), [Text(write.text)]),
              }
            },
            None -> {
              let r = operand_representation(s.arg);
              let field_at = Bytes::concat_all([
                b"(ply_words(",
                o,
                b") + ",
                ascii_of_int(s.at),
                b")",
              ]);
              let old = released(acc.printing, s.ty, r, parts_read(field_at, c_values_of(r)));
              let ws = values_as_words(arg_parts(old.printing, s.arg), c_values_of(r));
              let writes = range(0, ws.len()).map(|k: Int|
                Bytes::concat_all([slot(o, s.at + k), b" = ", nth_or_zero(ws, k), b";"]));
              {
                printing: old.printing,
                out: spaced(spaced(acc.out, old.out), [Text(Bytes::join(writes, b" "))]),
              }
            },
          },
      );
      let reused = [
        Text(
          Bytes::concat_all([b"Word ", o, b" = ", reference_count_of(x), b" == 1 ? ", x, b" : "]),
        ),
      ].concat(
        shared.out,
      ).push(
        Text(b"; "),
      );
      let opened = if !printing.placing.results.contains(v.id) {
        { printing: written.printing, out: reused }
      } else {
        match known_layout(printing.constructors, u.of.ty) {
          Some(l) -> {
            let moved = write_inline(written.printing, b"*(Word *)d", b"ply_words(d)", x, l);
            {
              printing: moved.printing,
              out: [
                Text(
                  Bytes::concat_all([
                    b"Word ",
                    o,
                    b" = d; if (d) { ",
                    moved.text,
                    b" } else { ",
                    o,
                    b" = ",
                    reference_count_of(x),
                    b" == 1 ? ",
                    x,
                    b" : ",
                  ]),
                ),
              ].concat(
                shared.out,
              ).push(
                Text(b"; } "),
              ),
            }
          },
          None -> { printing: written.printing, out: reused },
        }
      };
      fragment_line(p.depth, {
        printing: slots_moved(opened.printing, u.sets.map(|s: FieldWrite| s.arg), v.id),
        out: opened.out.concat(written.out),
      })
    },
    (None, _) -> unsupported(b"a record updated that nothing holds", var_text(u.of)),
    _ -> unsupported(b"a record updated in other than its box", var_text(u.of)),
  }

fn inline_layout(printing: Printing, ty: Type) -> Option<ValueLayout> =
  match inside_layout(printing.constructors, ty) { Some(InlineRecord(l)) -> Some(l), _ -> None }

pub fn last_of(
  p: InstructionContext,
  printing: Printing,
  into: Option<Var>,
  v: Var,
) -> Printing / {abort.raise} =
  match into {
    None -> unsupported(b"a last holder's test nothing holds", var_text(v)),
    Some(n) -> {
      let x = name_of(printing, v);
      let tagged = match v.representation {
        AsSum(s) -> match s.layout.classes { [Pointer] -> false, _ -> true },
        _ -> false,
      };
      let tested = if tagged {
        Bytes::concat_all([
          b"(uint64_t)",
          x,
          b" >= ",
          ascii_of_int(pointer_floor()),
          b" && ",
          call_text(last_fn(), [
            b"ctx",
            Bytes::concat_all([x, b" & ~(Word)", ascii_of_int(tag_mask())]),
          ]),
        ])
      } else { Bytes::concat_all([x, b" && ", call_text(last_fn(), [b"ctx", x])]) };
      assigned(
        printing,
        p.depth,
        n,
        b"Word",
        Bytes::concat_all([b"(", tested, b") ? ", x, b" : 0"]),
      )
    },
  }

fn fake_instruction_context() -> InstructionContext =
  {
    u: {
      symbol: b"m_f",
      base: 0,
      result: AsWord,
      site: None,
      arm: None,
      looping: None,
      handler_jump: None,
      group: None,
      unwinds: [],
      epilogue: b"",
    },
    at: span_between(0, 0),
    exit_statement: b"return 0;",
    depth: 0,
  }

fn printed(printing: Printing, i: Inst) -> Bytes / {abort.raise} =
  pieces_text(count_printed(fake_instruction_context(), printing, i).out)

fn failure_exit_text(printing: Printing, unwind: List<Var>) -> Bytes / {abort.raise} = {
  let x = failure_exit({ ..printing, out: [] }, unwind, b"return 0;");
  Bytes::concat_all([x.leave, b"\n", pieces_text(block_closed(x.printing, 0, 0, false).out)])
}

fn releases(text: Bytes, name: Bytes) -> Bool =
  text.index_of(call_start(release_fn(), [b"ctx", name])) != None

fn called(f: Bytes, args: List<Bytes>) -> Bytes = call_text(f, args).concat(b";")

fn string() -> Type = string_type()

fn int() -> Type = int_type()

fn text_local(id: Int) -> Var = { id: id, ty: string(), representation: AsWord }

fn drop_symbol_text(ty: Type) -> Bytes / {abort.raise} = root_symbol_text(drop_of(ty))

test "a count is taken or let go of each part of a value that holds one, as many times as it is taken" {
  let rec = RecordType([{ name: b"a", ty: int() }, { name: b"b", ty: string() }]);
  let x = text_local(0);
  let flat = {
    id: 1,
    ty: rec,
    representation: AsFlattened([
      { name: b"a", representation: AsInt },
      { name: b"b", representation: AsWord },
    ]),
  };
  let k = { id: 2, ty: int(), representation: AsInt };
  let d = drop_symbol_text(string());
  let printing = empty_printing(Map::new().insert(0, b"p0").insert(1, b"t1").insert(2, b"t2"));
  let dup = called(dup_fn(), [b"p0"]);
  let let_go = called(release_fn(), [b"ctx", b"p0", d]);
  assert_eq(occurrences(printed(printing, Inc({ var: x, n: 2 })), dup), 2);
  assert(printed(printing, Dec(x)).contains(let_go), None);
  let flat_let_go = called(release_fn(), [b"ctx", b"t1_1", d]);
  let flat_dec = printed(printing, Dec(flat));
  assert(flat_dec.contains(flat_let_go) && !releases(flat_dec, b"t1_0"), None);
  let unwinding = failure_exit_text(printing, [x, k, flat]);
  let at = |part: Bytes| match unwinding.index_of(part) { Some(i) -> i, None -> 0 - 1 };
  assert(
    at(flat_let_go) >= 0 && at(let_go) > at(flat_let_go),
    Some(String::of_bytes_lossy(unwinding)),
  );
  assert_eq(failure_exit_text(printing, [k]), b"return 0;\n")
}

test "a reset keeps a box held only here as its token, and a token no make took is freed by its size" {
  let rec = RecordType([{ name: b"a", ty: int() }, { name: b"b", ty: string() }]);
  let x = { id: 0, ty: rec, representation: AsWord };
  let token = { id: 1, ty: rec, representation: AsReuseToken(2) };
  let printing = empty_printing(Map::new().insert(0, b"p0"));
  let reset = count_printed(fake_instruction_context(), printing, Reset({ token: token, of: x }));
  assert_eq(name_of(reset, token), b"t1");
  let let_go = called(release_fn(), [b"ctx", b"p0", drop_symbol_text(rec)]);
  let text = pieces_text(reset.out);
  assert(
    [
      b"->rc == 1",
      called(release_fn(), [b"ctx", b"ply_words(p0)[1]", drop_symbol_text(string())]),
      b"t1 = p0;",
      let_go,
    ].all(|part: Bytes| text.contains(part)),
    Some(String::of_bytes_lossy(text)),
  );
  let unwinding = failure_exit_text(reset, [x, token]);
  let at = |part: Bytes| match unwinding.index_of(part) { Some(i) -> i, None -> 0 - 1 };
  let freed = called(free_fn(), [b"ctx", b"t1", b"24"]);
  assert(at(freed) >= 0 && at(let_go) > at(freed), Some(String::of_bytes_lossy(unwinding)))
}

test "a flat value opened writes no C, and each word is the part it was" {
  let rec = RecordType([{ name: b"a", ty: string() }, { name: b"b", ty: int() }]);
  let flat = {
    id: 0,
    ty: rec,
    representation: AsFlattened([
      { name: b"a", representation: AsWord },
      { name: b"b", representation: AsInt },
    ]),
  };
  let words = [text_local(1), { id: 2, ty: int(), representation: AsInt }];
  let printing = empty_printing(Map::new().insert(0, b"p0"));
  let opened = count_printed(
    fake_instruction_context(),
    printing,
    Destructure({ of: flat, words: words }),
  );
  assert_eq(opened.out, []);
  assert_eq(words.map(|w: Var| name_of(opened, w)), [b"p0_0", b"p0_1"]);
  let by_words = failure_exit_text(opened, [words.get(0)]);
  let whole = failure_exit_text(printing, [flat]);
  assert(releases(by_words, b"p0_0") && releases(whole, b"p0_0"));
  assert(!releases(by_words, b"p0_1") && !releases(whole, b"p0_1"))
}

test "a flat value's sum leaf opened is a copy of its run of the record's words" {
  let sum = NamedType({ name: b"m.T", args: [] });
  let s = AsSum({ layout: tagged_layout(), cases: [b"m.N", b"m.S", b"m.E"] });
  let rec = RecordType([
    { name: b"a", ty: sum },
    { name: b"u", ty: RecordType([]) },
    { name: b"n", ty: int() },
  ]);
  let flat = {
    id: 0,
    ty: rec,
    representation: AsFlattened([
      { name: b"a", representation: s },
      { name: b"u", representation: AsUnit },
      { name: b"n", representation: AsInt },
    ]),
  };
  let words = [
    { id: 1, ty: sum, representation: s },
    { id: 2, ty: RecordType([]), representation: AsUnit },
    { id: 3, ty: int(), representation: AsInt },
  ];
  let opened = count_printed(
    fake_instruction_context(),
    empty_printing(Map::new().insert(0, b"p0")),
    Destructure({ of: flat, words: words }),
  );
  let copied = pieces_text(opened.out);
  assert(
    copied.contains(b"= p0_0;") && copied.contains(b"= p0_1;") && !copied.contains(b"p0_2"),
    None,
  );
  assert_eq(part_names(name_of(opened, words.get(0)), s), [b"t1_0", b"t1_1"]);
  assert_eq(name_of(opened, words.get(2)), b"p0_2")
}

test "failures whose releases end alike share that end, each release printed once" {
  let a = text_local(0);
  let b = text_local(1);
  let c = text_local(2);
  let rel = |n: Bytes| called(release_fn(), [b"ctx", n, drop_symbol_text(string())]);
  let declared = |printing: Printing, v: Var| named(printing, v).printing;
  let printing = declared(declared(empty_printing(Map::new().insert(0, b"p0")), b), c);
  let first = failure_exit(printing, [a, b], b"return 0;");
  let second = failure_exit(first.printing, [b, c, a], b"return 0;");
  let third = failure_exit(second.printing, [a, c], b"return 0;");
  assert_eq(failure_exit(third.printing, [b, a], b"return 0;").leave, first.leave);
  assert_eq([first.leave, second.leave, third.leave], [
    b"goto ply_u1;",
    b"goto ply_u2;",
    b"goto ply_u3;",
  ]);
  let closed = block_closed(third.printing, 0, 0, false);
  let tails = pieces_text(closed.out);
  assert_eq(occurrences(tails, rel(b"p0")), 1);
  assert_eq(occurrences(tails, rel(b"t1")), 1);
  assert_eq(closed.calls, [drop_of(string())])
}

test "a tail stands at the end of the block its value was declared in, out of the way where the block goes on" {
  let a = text_local(0);
  let b = text_local(1);
  let d = drop_symbol_text(string());
  let printing = empty_printing(Map::new().insert(0, b"p0"));
  let inner = named(block_opened(printing), b);
  let x = failure_exit(inner.printing, [a, b], b"goto ply_h0;");
  assert_eq(x.leave, b"goto ply_u1;");
  let closed = block_closed(x.printing, printing.block, 1, true);
  let inner_tail = pieces_text(closed.out);
  assert(
    inner_tail.contains(b"if (0) {")
      && inner_tail.contains(called(release_fn(), [b"ctx", b"t1", d]))
      && !releases(inner_tail, b"p0"),
    Some(String::of_bytes_lossy(inner_tail)),
  );
  assert_eq(closed.block, printing.block);
  let outer_tail = pieces_text(block_closed({ ..closed, out: [] }, 0, 0, false).out);
  assert(
    outer_tail.contains(called(release_fn(), [b"ctx", b"p0", d]))
      && outer_tail.contains(b"goto ply_h0;"),
    Some(String::of_bytes_lossy(outer_tail)),
  );
  let quiet = block_opened(printing);
  assert_eq(block_closed(quiet, 0, 1, true).out, [])
}

fn dropping_of(name: Bytes) -> RootKey = drop_of(NamedType({ name: name, args: [] }))

fn root_symbol_text(k: RootKey) -> Bytes / {abort.raise} = pieces_text([Hole(Symbol(Root(k)))])

fn released_fragment(
  parts: List<Part>,
  ws: List<Bytes>,
) -> { text: Bytes, calls: List<RootKey>, expects: Int } / {abort.raise} = {
  let s = parts_released(empty_printing(Map::new()), parts, ws);
  { text: paired(pieces_text(s.out)), calls: s.printing.calls, expects: s.printing.expects.len() }
}

fn paired(text: Bytes) -> Bytes / {abort.raise} = {
  assert(
    text.split(b"(").len() == text.split(b")").len()
      && text.split(b"{").len() == text.split(b"}").len(),
    Some(String::of_bytes_lossy(text)),
  );
  text
}

fn word(at: Int, how: CountedWord) -> Part = WordAt({ at: at, masked: false, how: how })

fn tagged_layout() -> SumLayout =
  {
    classes: [RawRange({ lo: 0, hi: 2 }), Mixed],
    cases: [
      {
        test: WordIs({ at: 0, value: 0 }),
        payload: Inline({
          offset: 1,
          layout: PlainWords([RawRange({ lo: 0, hi: 1 })]),
          stripped: None,
        }),
      },
      {
        test: WordIs({ at: 0, value: 1 }),
        payload: Inline({ offset: 1, layout: PlainWords([Pointer]), stripped: None }),
      },
      { test: WordIs({ at: 0, value: 2 }), payload: Nullary },
    ],
  }

test "a counted word is let go of at its type's drop root, a hole the root's calls note once" {
  let k = drop_of(string_type());
  let d = root_symbol_text(k);
  let one = released_fragment([word(0, Object(k))], [b"t1"]);
  assert_eq(one.text, called(release_fn(), [b"ctx", b"t1", d]));
  assert_eq(one.calls, [k]);
  assert_eq(one.expects, 1);
  let twice = released_fragment(
    [word(0, Object(k)), WordAt({ at: 1, masked: true, how: Object(k) })],
    [b"a", b"b"],
  );
  assert_eq(
    twice.text,
    Bytes::concat_all([
      called(release_fn(), [b"ctx", b"a", d]),
      b" ",
      called(release_fn(), [b"ctx", b"(b & ~(Word)7)", d]),
    ]),
  );
  assert_eq([twice.calls.len(), twice.expects], [1, 1]);
  assert_eq(
    released_fragment([word(0, SumWord(k))], [b"w"]).text,
    called(release_sum_fn(), [b"ctx", b"w", d]),
  );
  let decimal_box = released_fragment([word(0, ScalarWord({ ty: decimal_type(), words: 2 }))], [
    b"w",
  ]);
  assert_eq(
    decimal_box.text,
    called(release_box_fn(), [b"ctx", b"w", ascii_of_int(header_bytes() + 16)]),
  );
  assert_eq(decimal_box.calls, []);
  let last = Bytes::concat_all([b"if (w && ", call_text(last_fn(), [b"ctx", b"w"]), b") "]);
  let count_root = released_fragment([word(0, ThroughDescriptor)], [b"w"]);
  assert_eq(
    count_root.text,
    last.concat(b"((const PlyFnDesc *)(intptr_t)ply_words(w)[0])->release(ctx, w);"),
  );
  assert_eq(count_root.calls, []);
  assert_eq(
    released_fragment([word(0, RuntimeHandle)], [b"w"]).text,
    last.concat(called(handle_free_fn(), [b"ctx", b"w"])),
  );
  let gone = released_fragment([word(0, Object(k)), word(1, SumWord(k))], [b"0", b"0"]);
  assert_eq([gone.text, dup_of([word(0, Object(k)), word(1, Object(k))], [b"0", b"b"])], [
    b"",
    called(dup_fn(), [b"b"]),
  ]);
  assert_eq(gone.calls, [])
}

test "a sum of several words is let go of by the case it holds, switching on its tag word" {
  let k = drop_of(string_type());
  let parts = [
    ByCase({ at: 0, sum: tagged_layout(), cases: [{ case: 1, parts: [word(1, Object(k))] }] }),
  ];
  let by_case = |text: Bytes, counted: Bytes|
    [b"switch ((int64_t)(t1_0))", b"case INT64_C(1):", counted].all(|part: Bytes|
        text.contains(part))
      && !text.contains(b"case INT64_C(0):");
  assert(
    by_case(
      released_fragment(parts, [b"t1_0", b"t1_1", b"t1_2"]).text,
      called(release_fn(), [b"ctx", b"t1_1", root_symbol_text(k)]),
    ),
    None,
  );
  assert(by_case(dup_of(parts, [b"t1_0", b"t1_1", b"t1_2"]), called(dup_fn(), [b"t1_1"])), None);
  let boxed = {
    ..tagged_layout(),
    cases: tagged_layout().cases.take(2).push({
      test: WordOutside({ at: 0, values: [0, 1] }),
      payload: Boxed({ at: 0, stripped: false, skip: 0, layout: PlainWords([Pointer]) }),
    }),
  };
  let in_box = [ByCase({ at: 0, sum: boxed, cases: [{ case: 2, parts: [word(0, Object(k))] }] })];
  let ws = [b"t1_0", b"t1_1", b"t1_2"];
  [released_fragment(in_box, ws).text, dup_of(in_box, ws)].fold((), |_: Unit, text: Bytes|
    assert(
      [b"default:", b"case INT64_C(0): break; ", b"case INT64_C(1): break; "].all(|part: Bytes|
        text.contains(part)),
      Some(String::of_bytes_lossy(text)),
    ))
}

test "counting once more tests a sum's word past the floor" {
  let k = dropping_of(b"T");
  assert_eq(
    dup_of([word(0, SumWord(k))], [b"w"]),
    b"if ((uint64_t)w >= 4096) ".concat(called(dup_fn(), [b"w & ~(Word)7"])),
  );
  assert_eq(
    dup_of([word(0, Object(k)), word(1, ThroughDescriptor)], [b"a", b"b"]),
    Bytes::concat_all([called(dup_fn(), [b"a"]), b" ", called(dup_fn(), [b"b"])]),
  )
}

test "a box opened reads its counted words, a wide sum's every word, and gives the box back" {
  let s = AsSum({ layout: tagged_layout(), cases: [b"m.N", b"m.S", b"m.E"] });
  let o = placeholder_var(0, AsWord);
  let a = placeholder_var(1, AsWord);
  let b = placeholder_var(2, s);
  let ty = NamedType({ name: b"T", args: [] });
  let opened = opened_block(
    empty_printing(Map::new().insert(0, b"p0")),
    0,
    o,
    [a, b],
    WordBlock({
      parts: [{ at: 0, ty: ty, representation: AsWord }, { at: 2, ty: ty, representation: s }],
      words: 4,
    }),
  );
  let text = pieces_text(opened.out);
  assert(
    [
        b"ply_words(p0)[0]",
        b"ply_words(p0)[2]",
        b"ply_words(p0)[3]",
        called(free_fn(), [b"ctx", b"p0", b"40"]),
      ].all(|part: Bytes| text.contains(part))
      && !text.contains(b"ply_words(p0)[1]"),
    Some(String::of_bytes_lossy(text)),
  );
  assert_eq(name_of(opened, b), b"t2");
  assert_eq(part_names(b"t2", s), [b"t2_0", b"t2_1"]);
  let flat = AsFlattened([
    { name: b"a", representation: s },
    { name: b"n", representation: AsInt },
  ]);
  let names = part_names(b"t3", flat);
  assert_eq(names, [b"t3_0", b"t3_1", b"t3_2"]);
  assert_eq(per_part(flat, names), [[b"t3_0", b"t3_1"], [b"t3_2"]]);
  assert_eq(per_part(s, part_names(b"t2", s)), [[b"t2_0", b"t2_1"]])
}

test "a list opened lets go of its owner or else its items, and gives itself back by its room" {
  let item = drop_of(string_type());
  let whole = drop_of(list_type(string()));
  let opened = opened_block(
    empty_printing(Map::new().insert(0, b"p0")),
    0,
    placeholder_var(0, AsWord),
    [],
    ListOf({ whole: whole, item: [word(0, Object(item))], stride: 1 }),
  );
  let text = pieces_text(opened.out);
  let owner = Bytes::concat_all([
    b"ply_words(p0)[",
    ascii_of_int(container_layouts().list.owner),
    b"]",
  ]);
  assert(
    [
      Bytes::concat_all([b"if (", owner, b") { "]),
      head_field(list_head(), b"p0", b"claimed"),
      root_symbol_text(item),
      called(release_fn(), [b"ctx", owner, root_symbol_text(whole)]),
      call_start(free_fn(), [b"ctx", b"p0"]),
      head_field(list_head(), b"p0", b"room"),
    ].all(|part: Bytes| text.contains(part)),
    Some(String::of_bytes_lossy(text)),
  );
  assert_eq(opened.calls, [item, whole])
}

test "an array let go of loops over its elements, its head counting them, and gives back their words" {
  let item = drop_of(string_type());
  let len = head_field(array_head(), b"p0", b"len");
  let given = |stride: Int|
    called(free_fn(), [
      b"ctx",
      b"p0",
      Bytes::concat_all([
        ascii_of_int(header_bytes() + 8 * head_words(array_head())),
        b" + 8 * ",
        len,
        if stride == 1 { b"" } else { b" * ".concat(ascii_of_int(stride)) },
      ]),
    ]);
  let opened = opened_block(
    empty_printing(Map::new().insert(0, b"p0")),
    0,
    placeholder_var(0, AsWord),
    [],
    ArrayOf({ element: [word(1, Object(item))], stride: 2 }),
  );
  let text = pieces_text(opened.out);
  assert(
    [
      Bytes::concat_all([b"ply_i < ", len]),
      called(release_fn(), [b"ctx", b"ply_words(p0)[2 + ply_i * 2]", root_symbol_text(item)]),
      given(2),
    ].all(|part: Bytes| text.contains(part)),
    Some(String::of_bytes_lossy(text)),
  );
  assert_eq(opened.calls, [item]);
  let units = block_contents(
    empty_printing(Map::new()).constructors,
    array_type(unit_type()),
    AsWord,
  );
  assert_eq(units, ArrayOf({ element: [], stride: 1 }));
  let none_counted = pieces_text(
    opened_block(
      empty_printing(Map::new().insert(0, b"p0")),
      0,
      placeholder_var(0, AsWord),
      [],
      units,
    ).out,
  );
  assert(none_counted.contains(given(1)) && !none_counted.contains(b"for ("), None)
}

test "a wide scalar's box opened is let go of as its type lets go of its word" {
  let wide = { ..placeholder_var(0, AsWord), ty: width_type({ bits: 128, signed: false }) };
  let printing = empty_printing(Map::new().insert(0, b"p0"));
  let text = pieces_text(
    opened_block(printing, 0, wide, [], block_contents(printing.constructors, wide.ty, AsWord)).out,
  );
  assert(
    text.contains(call_text(release_box_fn(), [b"ctx", b"p0", ascii_of_int(header_bytes() + 16)])),
    Some(String::of_bytes_lossy(text)),
  )
}

test "a reset keeps a box held only here as its token, its words let go of, and else lets one count go" {
  let item = drop_of(string_type());
  let boxed = dropping_of(b"m.R");
  let printing = empty_printing(Map::new().insert(0, b"p0"));
  let reset = reset_boxed(
    printing,
    0,
    placeholder_var(1, AsReuseToken(2)),
    placeholder_var(0, AsWord),
    WordBlock({ parts: [{ at: 0, ty: string_type(), representation: AsWord }], words: 2 }),
    boxed,
  );
  let text = pieces_text(reset.out);
  assert(
    [
      b"->rc == 1",
      called(release_fn(), [b"ctx", b"ply_words(p0)[0]", root_symbol_text(item)]),
      b"t1 = p0;",
      called(release_fn(), [b"ctx", b"p0", root_symbol_text(boxed)]),
    ].all(|part: Bytes| text.contains(part)),
    Some(String::of_bytes_lossy(text)),
  );
  let token = placeholder_var(1, AsReuseToken(2));
  let freed = count_printed(
    fake_instruction_context(),
    { ..reset, out: [] },
    Free({ of: token, bytes: IntOperand(24) }),
  );
  assert(pieces_text(freed.out).contains(called(free_fn(), [b"ctx", b"t1", b"INT64_C(24)"])), None);
  assert_eq(
    pieces_text(released(reset, token.ty, token.representation, [b"t1"]).out),
    b"if (t1) ".concat(called(free_fn(), [b"ctx", b"t1", b"24"])),
  )
}

test "a value's counts read its type's own layout and word form" {
  let string = string_type();
  let pair = RecordType([{ name: b"a", ty: string }, { name: b"b", ty: string }]);
  let printing = empty_printing(Map::new());
  let let_go = released(printing, string, AsWord, [b"t1"]);
  assert_eq(
    pieces_text(let_go.out),
    called(release_fn(), [b"ctx", b"t1", root_symbol_text(drop_of(string_type()))]),
  );
  assert_eq(pieces_text(duped(printing, pair, AsWord, [b"t2"]).out), called(dup_fn(), [b"t2"]));
  assert_eq(pieces_text(duped(printing, int_type(), AsWord, [b"t3"]).out), b"");
  assert_eq(part_names(b"t4", AsWord), [b"t4"])
}

fn strings_record(n: Int) -> Type =
  RecordType(
    range(0, n).map(|i: Int| { name: b"s".concat(ascii_of_int(i)), ty: string() }).push({
      name: b"z",
      ty: int(),
    }),
  )

fn wide_sums(n: Int) -> Constructors =
  constructors_of(
    [],
    [],
    [],
    Map::new().insert(b"m.Many", [
      {
        name: b"m.Many",
        index: 0,
        fields: range(0, n).map(|_: Int| string()).push(int()),
        params: [],
      },
    ]).insert(b"m.Sparse", [
      {
        name: b"m.Sparse",
        index: 0,
        fields: [string(), string()].concat(range(0, 20).map(|_: Int| int())),
        params: [],
      },
    ]),
  )

test "a value of many counted words is counted through one call of its type's root, which counts each word itself" {
  let rec = NamedType({ name: b"m.Many", args: [] });
  let printing = { ..empty_printing(Map::new()), constructors: wide_sums(24) };
  let held = representation_with(printing.constructors, rec);
  let values = part_names(b"t1", held);
  let release = root_of(keys::Unboxed(keys::Release), rec);
  let dup = root_of(keys::Unboxed(Dup), rec);
  let let_go = released(printing, rec, held, values);
  let more = duped(printing, rec, held, values);
  let one_call = |s: Fragment, k: RootKey| {
    let text = pieces_text(s.out);
    occurrences(text, root_symbol_text(k)) == 1
      && values.take(24).all(|v: Bytes| text.contains(v.concat(b",")))
      && !releases(text, b"t1_0")
      && !text.contains(dup_fn().concat(b"("))
  };
  assert(
    one_call(let_go, release) && one_call(more, dup),
    Some(String::of_bytes_lossy(pieces_text(let_go.out.concat(more.out)))),
  );
  assert_eq([let_go.printing.calls, more.printing.calls], [[release], [dup]]);
  let head_of = |k: RootKey| [signature_types(generated(printing.constructors, k).convention)];
  assert_eq(let_go.printing.expects.map(|e: ExpectedPrototype| e.head), head_of(release));
  assert_eq(more.printing.expects.map(|e: ExpectedPrototype| e.head), head_of(dup));
  let inside = { ..printing, count_root_type: Some(rec) };
  let own = pieces_text(released(inside, rec, held, values).out);
  let own_more = pieces_text(duped(inside, rec, held, values).out);
  assert(
    releases(own, b"t1_0") && releases(own, b"t1_23") && !own.contains(b"t1_24")
      && own_more.contains(called(dup_fn(), [b"t1_0"]))
      && own_more.contains(called(dup_fn(), [b"t1_23"]))
      && !own_more.contains(b"t1_24"),
    Some(String::of_bytes_lossy(own.concat(own_more))),
  );
  let pair = strings_record(2);
  let pair_held = representation_with(printing.constructors, pair);
  let pair_values = part_names(b"t4", pair_held);
  assert(
    released(printing, pair, pair_held, pair_values).printing.calls
      == [root_of(keys::Unboxed(keys::Release), pair)]
      && duped(printing, pair, pair_held, pair_values).printing.calls == [],
    None,
  );
  let single = strings_record(1);
  let lone = released(printing, single, representation_with(printing.constructors, single), [
    b"t2_0",
    b"t2_1",
  ]);
  assert(
    releases(pieces_text(lone.out), b"t2_0") && lone.printing.calls == [drop_of(string())],
    None,
  );
  let sparse = NamedType({ name: b"m.Sparse", args: [] });
  let thin_held = representation_with(printing.constructors, sparse);
  let thin = released(printing, sparse, thin_held, part_names(b"t3", thin_held));
  assert(
    releases(pieces_text(thin.out), b"t3_0") && releases(pieces_text(thin.out), b"t3_1")
      && thin.printing.calls == [drop_of(string())],
    Some(String::of_bytes_lossy(pieces_text(thin.out))),
  )
}

test "a failure lets go of a value of several counted words by one call of its type's root" {
  let rec = strings_record(3);
  let printing = empty_printing(Map::new().insert(0, b"p0").insert(1, b"t1"));
  let flat = { id: 1, ty: rec, representation: representation_with(printing.constructors, rec) };
  let unwinding = failure_exit_text(printing, [text_local(0), flat]);
  let release = root_symbol_text(root_of(keys::Unboxed(keys::Release), rec));
  assert(
    occurrences(unwinding, release) == 1 && releases(unwinding, b"p0")
      && !releases(unwinding, b"t1_0"),
    Some(String::of_bytes_lossy(unwinding)),
  )
}

test "letting go of a value of several counted words grows by a mention of each, not a count's call" {
  let site = |n: Int| {
    let rec = strings_record(n);
    let printing = empty_printing(Map::new());
    let held = representation_with(printing.constructors, rec);
    let s = released(printing, rec, held, part_names(b"t1", held));
    pieces_text(s.out).len() - root_symbol_text(root_of(keys::Unboxed(keys::Release), rec)).len()
  };
  let sites = [4, 8, 16, 32, 64].map(|n: Int| { leaves: n, bytes: site(n) });
  let said = Some(
    String::of_bytes_lossy(
      Bytes::join(
        sites.map(|s: { leaves: Int, bytes: Int }|
          Bytes::concat_all([
            ascii_of_int(s.leaves),
            b" leaves: ",
            ascii_of_int(s.bytes),
            b" bytes",
          ])),
        b", ",
      ),
    ),
  );
  assert(sites.all(|s: { leaves: Int, bytes: Int }| s.bytes <= 12 * s.leaves + 40), said)
}

test "a last holder's test takes the count and returns the value only where it was the last" {
  let one_word = AsSum({
    layout: {
      classes: [PointerSum(1)],
      cases: [{ test: WordIs({ at: 0, value: 0 }), payload: Nullary }],
    },
    cases: [b"m.Nil"],
  });
  let printing = empty_printing(Map::new().insert(0, b"p0"));
  let at = |r: Representation|
    pieces_text(
      last_of(
        fake_instruction_context(),
        printing,
        Some(placeholder_var(1, AsWord)),
        placeholder_var(0, r),
      ).out,
    );
  assert(
    at(AsWord).contains(call_text(last_fn(), [b"ctx", b"p0"])) && at(AsWord).contains(b"? p0 : 0"),
    None,
  );
  assert(
    at(one_word).contains(b"4096")
      && at(one_word).contains(call_text(last_fn(), [b"ctx", b"p0 & ~(Word)7"])),
    None,
  );
  assert_eq(
    pieces_text(
      opened_sum(printing, 0, placeholder_var(0, one_word), [placeholder_var(1, AsWord)]).out,
    ),
    b"  Word t1 = (p0 & ~(Word)7);\n",
  )
}

fn walk_fragment(
  op: TypeOp,
  o: BlockContents,
  dropped: RootKey,
) -> { text: Bytes, calls: List<RootKey> } / {abort.raise} = {
  let printing = empty_printing(Map::new().insert(0, b"p0"));
  let w = walk_block(
    printing,
    0,
    placeholder_var(1, AsWord),
    placeholder_var(0, AsWord),
    op,
    o,
    dropped,
  );
  { text: paired(pieces_text(w.out)), calls: w.calls }
}

test "a list copied is a fresh list of its items, each counted once more, the original let go" {
  let item = drop_of(string_type());
  let whole = drop_of(list_type(string()));
  let copy = walk_fragment(
    Copy,
    ListOf({ whole: whole, item: [word(0, Object(item))], stride: 1 }),
    whole,
  );
  [
    call_text(fresh_list_fn(), [b"ctx", b"p0", b"1"]),
    Bytes::concat_all([
      b"for (int64_t ply_i = 0; ply_i < ",
      field(list_head(), b"t1", b"claimed"),
      b"; ply_i++) { ",
      called(dup_fn(), [b"ply_words(t1)[4 + ply_i]"]),
      b" }",
    ]),
    called(release_fn(), [b"ctx", b"p0", root_symbol_text(whole)]).concat(b"\n"),
  ].fold((), |_: Unit, part: Bytes| assert(copy.text.contains(part), None));
  assert_eq(copy.calls, [whole])
}

test "a sum of one word walks the block its case holds, a chain of its own type in a loop" {
  let string = string_type();
  let own = NamedType({ name: b"T", args: [] });
  let tagged = AsSum({
    layout: {
      classes: [PointerSum(1)],
      cases: [
        { test: WordIs({ at: 0, value: 0 }), payload: Nullary },
        { test: LowBits({ at: 0, bits: 1, block_tag: None }), payload: Nullary },
        { test: LowBits({ at: 0, bits: 2, block_tag: None }), payload: Nullary },
      ],
    },
    cases: [b"m.N", b"m.B", b"m.S"],
  });
  let blocks = [
    {
      case: 1,
      ty: NamedType({ name: b"m.T", args: [] }),
      representation: AsSum({ layout: { classes: [Pointer], cases: [] }, cases: [b"m.B"] }),
      opening: WordBlock({
        parts: [
          { at: 0, ty: string, representation: AsWord },
          { at: 1, ty: own, representation: tagged },
        ],
        words: 2,
      }),
    },
    { case: 2, ty: string, representation: AsWord, opening: BytesBlock },
  ];
  let printing = empty_printing(Map::new().insert(0, b"p0"));
  let walk = |op: TypeOp|
    pieces_text(
      walk_sum(printing, 0, placeholder_var(1, AsWord), placeholder_var(0, tagged), op, blocks).out,
    );
  let kept = walk(Keep);
  [
    b"Word t1 = p0; Word *ply_into = &t1; Word ply_x = p0; for (;;) { Word ply_n = 0; switch (",
    Bytes::concat_all([
      b"case INT64_C(4097): { Word ply_b = (ply_x & ~(Word)7); if (ply_obj(ply_b)->rc != UINT32_MAX) { Word ply_k = ",
      call_text(persistent_copy_fn(), [b"ctx", b"ply_b", b"24"]),
    ]),
    b" *ply_into = ply_k | (ply_x & 7); ply_into = &ply_words(ply_k)[1]; ply_n = *ply_into; }",
    Bytes::concat_all([
      b"case INT64_C(4098): { Word ply_b = (ply_x & ~(Word)7); *ply_into = ",
      root_symbol_text(root_of(Keep, string)),
      b"(ctx, ply_b) | (ply_x & 7); } break; ",
    ]),
    b"} if (!ply_n) break; ply_x = ply_n; }",
  ].fold((), |_: Unit, part: Bytes| assert(kept.contains(part), None));
  let chans = [{ case: 2, ty: chan_type(string), representation: AsWord, opening: HandleBlock }];
  assert_eq(
    pieces_text(
      walk_sum(
        printing,
        0,
        placeholder_var(1, AsWord),
        placeholder_var(0, tagged),
        Keep,
        blocks.take(1).concat(chans),
      ).out,
    ),
    b"  Word t1 = 0;\n",
  );
  let shared = walk(Share);
  [
    b"Word t1 = 1; Word ply_x = p0; for (;;) { Word ply_n = 0; switch (",
    Bytes::concat_all([b"if (", unshared_fn(), b"(ply_b)) {"]),
    b" ply_n = ply_words(ply_b)[1]; }",
    Bytes::concat_all([
      b"if (!",
      root_symbol_text(root_of(Share, string)),
      b"(ctx, ply_b)) t1 = 0;",
    ]),
    b" if (t1) { Word ply_x = p0; for (;;) {",
    Bytes::concat_all([
      b"if (",
      unshared_fn(),
      b"(ply_b)) { ",
      call_text(mark_shared_fn(), [b"ply_b"]),
      b"; ply_n = ply_words(ply_b)[1]; } } break;",
    ]),
  ].fold((), |_: Unit, part: Bytes|
    assert(shared.contains(part), Some(String::of_bytes_lossy(shared))));
  assert(!kept.contains(root_symbol_text(root_of(Keep, own))), None);
  assert(!shared.contains(root_symbol_text(root_of(Share, own))), None)
}

test "a box shared marks it and shares each block it holds; kept, it is copied for good, each word kept" {
  let string = string_type();
  let boxed = WordBlock({ parts: [{ at: 0, ty: string, representation: AsWord }], words: 2 });
  let share = keys::generated_key(Share, string, b"std.prelude");
  let keep = keys::generated_key(Keep, string, b"std.prelude");
  let shared = walk_fragment(Share, boxed, dropping_of(b"m.R"));
  assert(
    shared.text.contains(
      Bytes::concat_all([
        b"if (",
        call_text(unshared_fn(), [b"p0"]),
        b") { if (ply_words(p0)[0] && !",
        root_symbol_text(share),
        b"(ctx, ply_words(p0)[0])) t1 = 0; if (t1) ",
        call_text(mark_shared_fn(), [b"p0"]),
        b"; }",
      ]),
    ),
    Some(String::of_bytes_lossy(shared.text)),
  );
  assert_eq(shared.calls, [share]);
  let kept = walk_fragment(Keep, boxed, dropping_of(b"m.R"));
  [
    Bytes::concat_all([
      b"Word t1 = p0; if (p0 && ply_obj(p0)->rc != UINT32_MAX) { t1 = ",
      call_text(persistent_copy_fn(), [b"ctx", b"p0", b"24"]),
    ]),
    Bytes::concat_all([
      b"if (ply_words(t1)[0]) ply_words(t1)[0] = ",
      root_symbol_text(keep),
      b"(ctx, ply_words(t1)[0]);",
    ]),
  ].fold((), |_: Unit, part: Bytes| assert(kept.text.contains(part), None));
  assert(
    walk_fragment(Share, ClosureBlock, dropping_of(b"m.R")).text.contains(b"->share(ctx, p0)"),
    None,
  );
  let fun = FunctionType({
    kept: [],
    once: false,
    params: [string],
    ret: string,
    effects: no_effects(),
  });
  let capturing = WordBlock({ parts: [{ at: 1, ty: fun, representation: AsWord }], words: 2 });
  assert(
    walk_fragment(Share, capturing, dropping_of(b"m.R")).text.contains(
      b"->share(ctx, ply_words(p0)[1])) t1 = 0;",
    ),
    None,
  );
  assert(
    walk_fragment(Share, HandleBlock, dropping_of(b"m.R")).text.contains(b"if (p0) t1 = 0;"),
    None,
  )
}

test "an `Int` kept for good is its own bits, and a `Decimal` is the runtime's box kept whole" {
  let int = int_type();
  let kept = walk_fragment(
    Keep,
    WordBlock({ parts: [{ at: 0, ty: int, representation: AsWord }], words: 1 }),
    dropping_of(b"m.R"),
  );
  assert_eq(kept.calls, []);
  let root = walk_fragment(Keep, ScalarBox(2), drop_of(decimal_type())).text;
  assert(
    root.contains(b"Word t1 = p0; if (p0 && ply_obj(p0)->rc != UINT32_MAX) {"),
    Some(String::of_bytes_lossy(root)),
  )
}

test "what is or reaches a runtime handle, a scoped value or a function value is kept as 0 at once, nothing walked or copied" {
  let int = int_type();
  let string = string_type();
  let chan = chan_type(int);
  let hold = scoped_type(label_type(b"r"), string);
  let captured = |ty: Type|
    WordBlock({ parts: [{ at: 1, ty: ty, representation: AsWord }], words: 2 });
  let inner = RecordType([{ name: b"c", ty: chan }, { name: b"n", ty: int }]);
  let outer = RecordType([{ name: b"r", ty: inner }, { name: b"s", ty: string }]);
  let closures = ListOf({
    whole: drop_of(list_type(int)),
    item: [word(0, ThroughDescriptor)],
    stride: 1,
  });
  let dropped = dropping_of(b"m.R");
  [
    captured(chan),
    captured(hold),
    HandleBlock,
    ScopedContents({ at: 1, ty: chan, representation: AsWord }),
    WordBlock({
      parts: [
        { at: 0, ty: inner, representation: AsWord },
        { at: 1, ty: string, representation: AsWord },
      ],
      words: 2,
    }),
    block_contents(empty_printing(Map::new()).constructors, outer, AsWord),
    closures,
  ].fold((), |_: Unit, o: BlockContents| {
    let kept = walk_fragment(Keep, o, dropped);
    assert(kept.text.contains(b" = 0;") && !kept.text.contains(persistent_copy_fn()), None);
    assert_eq(kept.calls, [])
  });
  let plain = walk_fragment(
    Keep,
    WordBlock({
      parts: [
        { at: 0, ty: int, representation: AsWord },
        { at: 1, ty: string, representation: AsWord },
      ],
      words: 2,
    }),
    dropped,
  );
  assert(plain.text.contains(call_text(persistent_copy_fn(), [b"ctx", b"p0", b"24"])), None);
  assert_eq(plain.calls, [root_of(Keep, string)]);
  assert(
    walk_fragment(Share, captured(chan), dropped).text.contains(
      Bytes::concat_all([
        call_text(unshared_fn(), [b"p0"]),
        b") { if (ply_words(p0)[1]) t1 = 0; if (t1) ",
        call_text(mark_shared_fn(), [b"p0"]),
        b"; }",
      ]),
    ),
    None,
  )
}
