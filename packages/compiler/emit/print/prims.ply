//! Operators, conversions and constants printed: an integer's, a width's, a float's and a decimal's
//! operators as C does them under the runtime's overflow and division tests, a character's, a
//! string's and a constructor's words compared where they lie, an order made its `Ordering`'s case, and a
//! decimal's constant from its words.

import std.bytes (ascii_of_int)
import compiler.syntax.patterns (Lit, LUnit, LStr)
import compiler.check.types (TyCon)
import compiler.syntax.parsing (span_between)
import compiler.emit.c (Width, KNum, ctype, int_lit, is_bitop, bitop_c, unsigned_ctype, width_index,
                        width_min, width_max, overflow_code)
import compiler.emit.pieces (spelled)
import compiler.emit.tir (Rep, RInt, RBool, RNum, RFloat, RDec, RWide, RWord, RSum, RImm, Var, Arg,
                          AVar, AInt, ANum, Scalars, rep_of_arg, arithmetic, comparison, shift)
import compiler.emit.print.text (Printing, Place, printing, line, temp, named, arg_text, assigned,
                                 site, unprinted)
import compiler.emit.print.made (c_type)
import compiler.emit.layout (sum_laid, record_laid)
import compiler.emit.print.strings (bytes_of, text_field)

/// `()` into `into`, the word 0 a value of no words is held as: the one literal `emit.statics.folded`
/// leaves, which lays out every other as static data or writes it as a C literal. Raises on any other.
pub fn literal(p: Place, pr: Printing, into: Option<Var>, l: Lit) -> Printing / {abort.raise} =
  match into {
    None -> pr,
    Some(v) -> match l {
      LUnit -> bound(p, pr, v, b"0"),
      _ -> unprinted(Scalars, b"a literal the folded pass did not lay out", c_type(v.rep)),
    },
  }

/// An operator over operands held as `x.on`, as C does it: an integer's sum or difference under an
/// overflow test, its other arithmetic through the runtime but for a literal divisor, a width's
/// arithmetic wide and narrowed back under the same test, a float's as C's own, a decimal's by the
/// runtime over its two words, a 128-bit width's as `wide_printed` says, and words compared where
/// they lie. `decimal` makes the `Decimal` whose two words are its two `Int`s, and `wide` the
/// 128-bit width.
pub fn prim(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  x: { op: Bytes, on: Rep, args: List<Arg> },
) -> Printing / {abort.raise} =
  match into {
    None -> pr,
    Some(v) -> {
      let a = match x.args.at(0) { Some(y) -> arg_text(pr, y), None -> b"0" };
      let b = match x.args.at(1) { Some(y) -> arg_text(pr, y), None -> b"0" };
      let count = match x.args.at(1) { Some(y) -> int_text(pr, y), None -> b"0" };
      if x.op == b"sign" { sign_printed(p, pr, v, x.on, a) } else if x.op == b"narrow" {
        bound(p, pr, v, Bytes::concat_all([b"(", c_type(v.rep), b")", a]))
      } else if x.op == b"within" {
        let c = match x.args.at(2) { Some(y) -> arg_text(pr, y), None -> b"0" };
        bound(
          p,
          pr,
          v,
          Bytes::concat_all([b"((", a, b") >= (", b, b") && (", a, b") <= (", c, b"))"]),
        )
      } else if x.op == b"decimal" {
        bound(p, pr, v, Bytes::concat_all([b"((PlyDec){ ", a, b", ", b, b" })"]))
      } else if x.op == b"wide" {
        bound(p, pr, v, Bytes::concat_all([b"((PlyWide){ (Word)(", a, b"), (Word)(", b, b") })"]))
      } else {
        match x.on {
          RInt -> int_printed(p, pr, v, x.op, a, b, count, literal_divisor(x.args.at(1))),
          RBool -> bool_printed(p, pr, v, x.op, a, b),
          RFloat -> float_printed(p, pr, v, x.op, a, b),
          RDec -> dec_printed(p, pr, v, x.op, a, b),
          RWide(w) -> wide_printed(p, pr, v, x.op, w, a, b, count),
          RNum(w) -> width_printed(p, pr, v, x.op, w, a, b, count),
          RWord -> word_printed(p, pr, v, x.op, a, b),
          RImm -> word_printed(p, pr, v, x.op, a, b),
          // A sum of constructors taking nothing, held as its case's word.
          RSum(_) -> if x.op == b"eq" || x.op == b"ne" {
            bound(p, pr, v, infix(a, compare_c(x.op), b))
          } else { unwritten(p, pr, x.op) },
          _ -> unwritten(p, pr, x.op),
        }
      }
    },
  }

/// `v` set to `e` in the C type its representation is held in.
fn bound(p: Place, pr: Printing, v: Var, e: Bytes) -> Printing =
  assigned(pr, p.depth, v, c_type(v.rep), e)

fn infix(a: Bytes, c: Bytes, b: Bytes) -> Bytes =
  Bytes::concat_all([b"(", a, b") ", c, b" (", b, b")"])

fn unwritten(p: Place, pr: Printing, op: Bytes) -> Printing / {abort.raise} =
  unprinted(Scalars, b"an operator this printer does not write", op)

fn int_printed(
  p: Place,
  pr: Printing,
  v: Var,
  op: Bytes,
  a: Bytes,
  b: Bytes,
  count: Bytes,
  by_literal: Bool,
) -> Printing / {abort.raise} =
  if op == b"ne" { bound(p, pr, v, Bytes::concat_all([b"!((", a, b") == (", b, b"))"])) }
  else if comparison(op) { bound(p, pr, v, infix(a, compare_c(op), b)) }
  else if is_bitop(op) { bound(p, pr, v, infix(a, bitop_c(op), b)) }
  else if op == b"add" || op == b"sub" || op == b"mul" {
    let n = named(site(p, pr), v);
    line(
      line(n.pr, p.depth, Bytes::concat_all([b"int64_t ", n.name, b";"])),
      p.depth,
      Bytes::concat_all([
        b"if (ply_",
        op,
        b"_ov(",
        a,
        b", ",
        b,
        b", &",
        n.name,
        b")) { rt_overflow_p(ctx, ",
        ascii_of_int(overflow_code(op)),
        b"); ",
        p.leave,
        b" }",
      ]),
    )
  } else if (op == b"div" || op == b"rem") && by_literal {
    bound(p, pr, v, Bytes::concat_all([b"(", a, if op == b"div" { b") / " } else { b") % " }, b]))
  } else if op == b"div" || op == b"rem" {
    // By zero is the program's to catch; the one quotient past the range is a fault, as `+`'s is.
    let s = site(p, pr);
    let zero = line(
      s,
      p.depth,
      Bytes::concat_all([
        b"if ((",
        b,
        b") == 0) { rt_by_zero_p(ctx, ",
        if op == b"div" { b"0" } else { b"1" },
        b"); ",
        p.leave,
        b" }",
      ]),
    );
    let past = line(
      zero,
      p.depth,
      Bytes::concat_all([
        b"if ((",
        b,
        b") == -1 && (",
        a,
        b") == INT64_MIN) { rt_overflow_p(ctx, ",
        ascii_of_int(overflow_code(op)),
        b"); ",
        p.leave,
        b" }",
      ]),
    );
    bound(
      p,
      past,
      v,
      Bytes::concat_all([b"(", a, if op == b"div" { b") / (" } else { b") % (" }, b, b")"]),
    )
  } else if shift(op) { shifted(p, pr, v, op, None, a, count) } else if op == b"to_decimal" {
    let magnitude = Bytes::concat_all([
      b"((",
      a,
      b") < 0 ? 0 - (uint64_t)(",
      a,
      b") : (uint64_t)(",
      a,
      b"))",
    ]);
    bound(
      p,
      pr,
      v,
      Bytes::concat_all([
        b"((PlyDec){ (Word)(((",
        a,
        b") < 0 ? (uint64_t)1 << 31 : 0) | ((",
        magnitude,
        b" & 0xFFFFFFFF) << 32)), (Word)(",
        magnitude,
        b" >> 32) })",
      ]),
    )
  } else if op == b"neg" {
    let guarded = line(
      site(p, pr),
      p.depth,
      Bytes::concat_all([
        b"if (",
        a,
        b" == INT64_MIN) { rt_overflow_p(ctx, ",
        ascii_of_int(overflow_code(op)),
        b"); ",
        p.leave,
        b" }",
      ]),
    );
    bound(p, guarded, v, Bytes::concat_all([b"-(", a, b")"]))
  } else if op == b"bitnot" { bound(p, pr, v, Bytes::concat_all([b"~(", a, b")"])) }
  else if op == b"order" { bound(p, pr, v, signed_order(a, b)) }
  else if op == b"ordering" { ordering(p, pr, v, a) }
  else if op == b"to_float" { bound(p, pr, v, Bytes::concat_all([b"(double)(", a, b")"])) }
  else if op == b"of_bits" { bound(p, pr, v, Bytes::concat_all([b"ply_f64(", a, b")"])) }
  // 0 where `a` is a `Decimal`'s flags word, and -1 where its scale is past 28 or it sets a bit
  // other than the scale's and the sign's.
  else if op == b"decimal_flags" {
    bound(
      p,
      pr,
      v,
      Bytes::concat_all([
        b"((((uint64_t)(",
        a,
        b") & 0x7F00FFFFull) != 0 || ((((uint64_t)(",
        a,
        b")) >> 16) & 0xFF) > 28) ? INT64_C(-1) : INT64_C(0))",
      ]),
    )
  }
  // The Unicode scalar value `a` is, or -1 where it is a surrogate or past the last code point.
  else if op == b"scalar_value" {
    bound(
      p,
      pr,
      v,
      Bytes::concat_all([
        b"((",
        a,
        b") >= 0 && (",
        a,
        b") <= 0x10FFFF && !((",
        a,
        b") >= 0xD800 && (",
        a,
        b") <= 0xDFFF) ? (",
        a,
        b") : -1)",
      ]),
    )
  }
  // A character's word holds its scalar value above the tag `010`, as a literal's does.
  else if op == b"char_of" {
    bound(p, pr, v, Bytes::concat_all([b"((((Word)(uint64_t)(", a, b")) << 3) | 2)"]))
  }
  // The runtime numbers a type's stated witnesses from 13 past its constructor's tag.
  else if op == b"witness" { bound(p, pr, v, Bytes::concat_all([b"(13 + ", a, b")"])) }
  else if op == b"of_int" {
    let refused = |w: Width|
      Bytes::concat_all([
        b") { rt_not_that_width_p(ctx, ",
        ascii_of_int(width_index(w)),
        b", ",
        a,
        b"); ",
        p.leave,
        b" }",
      ]);
    match v.rep {
      // A 128-bit width holds every `Int` but an unsigned one the negative ones, its high word the
      // sign's.
      RWide(w) -> {
        let s = site(p, pr);
        let guarded = if w.signed { s }
        else { line(s, p.depth, Bytes::concat_all([b"if (", a, b" < 0", refused(w)])) };
        bound(
          p,
          guarded,
          v,
          Bytes::concat_all([b"((PlyWide){ (Word)(", a, b"), (Word)((", a, b") < 0 ? -1 : 0) })"]),
        )
      },
      RNum(w) -> {
        let s = site(p, pr);
        let guarded = if w.bits == 64 && w.signed { s } else if w.bits == 64 {
          line(s, p.depth, Bytes::concat_all([b"if (", a, b" < 0", refused(w)]))
        } else {
          line(
            s,
            p.depth,
            Bytes::concat_all([
              b"if (",
              a,
              b" < ",
              int_lit(width_min(w)),
              b" || ",
              a,
              b" > ",
              int_lit(width_max(w)),
              refused(w),
            ]),
          )
        };
        bound(p, guarded, v, Bytes::concat_all([b"(", ctype(KNum(w)), b")", a]))
      },
      _ -> unwritten(p, pr, op),
    }
  } else { unwritten(p, pr, op) }

fn bool_printed(
  p: Place,
  pr: Printing,
  v: Var,
  op: Bytes,
  a: Bytes,
  b: Bytes,
) -> Printing / {abort.raise} =
  if op == b"not" { bound(p, pr, v, Bytes::concat_all([b"!(", a, b")"])) }
  else if op == b"eq" || op == b"ne" {
    bound(
      p,
      pr,
      v,
      Bytes::concat_all([if op == b"ne" { b"!((" } else { b"((" }, a, b") == (", b, b"))"]),
    )
  } else if op == b"order" { bound(p, pr, v, signed_order(a, b)) }
  else { unwritten(p, pr, op) }

fn float_printed(
  p: Place,
  pr: Printing,
  v: Var,
  op: Bytes,
  a: Bytes,
  b: Bytes,
) -> Printing / {abort.raise} =
  if comparison(op) { bound(p, pr, v, infix(a, compare_c(op), b)) }
  else if op == b"neg" { bound(p, pr, v, Bytes::concat_all([b"-(", a, b")"])) }
  else if op == b"rem" {
    bound(
      p,
      site(p, pr),
      v,
      Bytes::concat_all([
        b"ply_f64(rt_float_rem_p(ctx, ply_f64_bits(",
        a,
        b"), ply_f64_bits(",
        b,
        b")))",
      ]),
    )
  } else if arithmetic(op) { bound(p, site(p, pr), v, infix(a, float_c(op), b)) }
  else if op == b"bits" {
    // Every NaN reads as the one `float::bits` names.
    let t = temp(pr);
    let read = line(
      t.pr,
      p.depth,
      Bytes::concat_all([b"int64_t ", t.name, b" = ply_f64_bits(", a, b");"]),
    );
    bound(
      p,
      read,
      v,
      Bytes::concat_all([
        b"((((uint64_t)",
        t.name,
        b" & UINT64_C(0x7FF0000000000000)) == UINT64_C(0x7FF0000000000000) && ((uint64_t)",
        t.name,
        b" & UINT64_C(0x000FFFFFFFFFFFFF)) != 0) ? INT64_C(0x7FF8000000000000) : ",
        t.name,
        b")",
      ]),
    )
  } else { unwritten(p, pr, op) }

/// A `Decimal`'s operator over each operand's two words, in place by the head's `print.decimal`
/// helpers, which allocate nothing: an answer past what a `Decimal` holds exactly fails the run, and
/// a remainder by zero raises.
fn dec_printed(
  p: Place,
  pr: Printing,
  v: Var,
  op: Bytes,
  a: Bytes,
  b: Bytes,
) -> Printing / {abort.raise} =
  if op == b"lo" || op == b"hi" {
    bound(p, pr, v, Bytes::concat_all([b"(int64_t)(", a, b").", op]))
  } else if op == b"scale" {
    bound(p, pr, v, Bytes::concat_all([b"(int64_t)(((uint64_t)(", a, b").lo >> 16) & 0xFF)"]))
  } else if comparison(op) {
    bound(
      p,
      pr,
      v,
      Bytes::concat_all([b"(ply_dec_order(", a, b", ", b, b") ", compare_c(op), b" 0)"]),
    )
  } else if op == b"order" {
    bound(p, pr, v, Bytes::concat_all([b"ply_dec_order(", a, b", ", b, b")"]))
  } else if op == b"add" || op == b"sub" || op == b"mul" {
    let n = named(site(p, pr), v);
    let call = if op == b"mul" { Bytes::concat_all([b"ply_dec_mul(", a, b", ", b]) } else {
      Bytes::concat_all([b"ply_dec_add(", a, b", ", b, if op == b"sub" { b", 1" } else { b", 0" }])
    };
    line(
      line(n.pr, p.depth, Bytes::concat_all([b"PlyDec ", n.name, b";"])),
      p.depth,
      Bytes::concat_all([
        b"if (",
        call,
        b", &",
        n.name,
        b")) { rt_decimal_overflow_p(ctx, ",
        ascii_of_int(overflow_code(op)),
        b"); ",
        p.leave,
        b" }",
      ]),
    )
  } else if op == b"rem" {
    let zero = line(
      site(p, pr),
      p.depth,
      Bytes::concat_all([
        b"if (((uint64_t)(",
        b,
        b").lo >> 32) == 0 && (",
        b,
        b").hi == 0) { rt_by_zero_p(ctx, 1); ",
        p.leave,
        b" }",
      ]),
    );
    bound(p, zero, v, Bytes::concat_all([b"ply_dec_rem(", a, b", ", b, b")"]))
  } else if op == b"neg" { bound(p, pr, v, Bytes::concat_all([b"ply_dec_negated(", a, b")"])) }
  else { unwritten(p, pr, op) }

/// An operator over a 128-bit width held as its two words: compared, ordered, masked, read and
/// tested for whether an `Int` holds it (`fits_int`) here, and the rest by the head's helpers
/// (`wide_called`).
fn wide_printed(
  p: Place,
  pr: Printing,
  v: Var,
  op: Bytes,
  w: Width,
  a: Bytes,
  b: Bytes,
  count: Bytes,
) -> Printing / {abort.raise} = {
  let part = |x: Bytes, half: Bytes| Bytes::concat_all([b"(", x, b").", half]);
  let pairwise = |c: Bytes|
    Bytes::concat_all([
      b"((PlyWide){ ",
      part(a, b"lo"),
      b" ",
      c,
      b" ",
      part(b, b"lo"),
      b", ",
      part(a, b"hi"),
      b" ",
      c,
      b" ",
      part(b, b"hi"),
      b" })",
    ]);
  let order = Bytes::concat_all([
    b"ply_wide_order(",
    a,
    b", ",
    b,
    b", ",
    if w.signed { b"1" } else { b"0" },
    b")",
  ]);
  let same = Bytes::concat_all([
    b"(",
    part(a, b"lo"),
    b" == ",
    part(b, b"lo"),
    b" && ",
    part(a, b"hi"),
    b" == ",
    part(b, b"hi"),
    b")",
  ]);
  if op == b"lo" || op == b"hi" { bound(p, pr, v, Bytes::concat_all([b"(int64_t)", part(a, op)])) }
  else if op == b"fits_int" {
    bound(
      p,
      pr,
      v,
      Bytes::concat_all([
        b"ply_wide_fits_int(",
        a,
        b", ",
        if w.signed { b"1" } else { b"0" },
        b")",
      ]),
    )
  } else if op == b"eq" { bound(p, pr, v, same) }
  else if op == b"ne" { bound(p, pr, v, b"!".concat(same)) } else if comparison(op) {
    bound(p, pr, v, Bytes::concat_all([b"(", order, b" ", compare_c(op), b" 0)"]))
  } else if op == b"order" { bound(p, pr, v, order) }
  else if is_bitop(op) { bound(p, pr, v, pairwise(bitop_c(op))) } else if op == b"bitnot" {
    bound(
      p,
      pr,
      v,
      Bytes::concat_all([b"((PlyWide){ ~", part(a, b"lo"), b", ~", part(a, b"hi"), b" })"]),
    )
  } else { wide_called(p, pr, v, op, w, a, b, count) }
}

/// An operation over a 128-bit width the head's `print.wide` helpers do in place, each failure
/// reported as a 64-bit operation's is, a checked one answering whether the exact answer fits.
fn wide_called(
  p: Place,
  pr: Printing,
  v: Var,
  op: Bytes,
  w: Width,
  a: Bytes,
  b: Bytes,
  count: Bytes,
) -> Printing / {abort.raise} = {
  let s = if w.signed { b"1" } else { b"0" };
  let part = |x: Bytes, half: Bytes| Bytes::concat_all([b"(", x, b").", half]);
  let failing = |at: Printing, condition: Bytes, report: Bytes|
    line(
      at,
      p.depth,
      Bytes::concat_all([b"if (", condition, b") { ", report, b"; ", p.leave, b" }"]),
    );
  let overflow = Bytes::concat_all([b"rt_overflow_p(ctx, ", ascii_of_int(overflow_code(op)), b")"]);
  let operands = if op == b"neg" || op == b"checked_neg" { Bytes::concat_all([a, b", ", s]) }
  else { Bytes::concat_all([a, b", ", b, b", ", s]) };
  let declared = |at: Printing, names: Bytes|
    line(at, p.depth, Bytes::concat_all([b"PlyWide ", names, b";"]));
  if op == b"add" || op == b"sub" || op == b"mul" || op == b"neg" {
    let n = named(site(p, pr), v);
    failing(
      declared(n.pr, n.name),
      Bytes::concat_all([b"ply_wide_", op, b"(", operands, b", &", n.name, b")"]),
      overflow,
    )
  } else if op == b"div" || op == b"rem" {
    let n = named(site(p, pr), v);
    let t = temp(n.pr);
    let zero = failing(
      declared(t.pr, Bytes::concat_all([n.name, b", ", t.name])),
      Bytes::concat_all([part(b, b"lo"), b" == 0 && ", part(b, b"hi"), b" == 0"]),
      if op == b"div" { b"rt_by_zero_p(ctx, 0)" } else { b"rt_by_zero_p(ctx, 1)" },
    );
    let quotient = if op == b"div" { n.name } else { t.name };
    let remainder = if op == b"div" { t.name } else { n.name };
    failing(
      zero,
      Bytes::concat_all([b"ply_wide_divrem(", operands, b", &", quotient, b", &", remainder, b")"]),
      overflow,
    )
  } else if shift(op) {
    let c = temp(site(p, pr));
    let held = line(c.pr, p.depth, Bytes::concat_all([b"int64_t ", c.name, b" = ", count, b";"]));
    let guarded = failing(
      held,
      Bytes::concat_all([b"(uint64_t)", c.name, b" >= 128"]),
      Bytes::concat_all([
        b"rt_shift_count_p(ctx, ",
        c.name,
        b", ",
        ascii_of_int(width_index(w)),
        b")",
      ]),
    );
    bound(p, guarded, v, if op == b"shl" {
      Bytes::concat_all([b"ply_wide_shl(", a, b", ", c.name, b")"])
    } else {
      Bytes::concat_all([
        b"ply_wide_shr(",
        a,
        b", ",
        c.name,
        if op == b"shr" { Bytes::concat_all([b", ", s, b")"]) } else { b", 0)" },
      ])
    })
  } else if op == b"wrap_add" || op == b"wrap_sub" || op == b"wrap_mul" {
    let n = named(pr, v);
    line(
      declared(n.pr, n.name),
      p.depth,
      Bytes::concat_all([
        b"(void)ply_wide_",
        op.slice(5, op.len()),
        b"(",
        operands,
        b", &",
        n.name,
        b");",
      ]),
    )
  } else if op == b"saturating_add" || op == b"saturating_sub" || op == b"saturating_mul" {
    bound(
      p,
      pr,
      v,
      Bytes::concat_all([b"ply_wide_sat_", op.slice(11, op.len()), b"(", operands, b")"]),
    )
  } else if op.starts_with(b"checked_") {
    let t = temp(pr);
    bound(
      p,
      declared(t.pr, t.name),
      v,
      Bytes::concat_all([
        b"!ply_wide_",
        op.slice(8, op.len()),
        b"(",
        operands,
        b", &",
        t.name,
        b")",
      ]),
    )
  } else if op == b"rotl" || op == b"rotr" {
    bound(p, pr, v, Bytes::concat_all([b"ply_wide_", op, b"(", a, b", ", count, b")"]))
  } else if op == b"to_int" {
    let held = failing(
      site(p, pr),
      Bytes::concat_all([b"!ply_wide_fits_int(", a, b", ", s, b")"]),
      Bytes::concat_all([
        b"rt_not_an_int_wide_p(ctx, (int64_t)",
        part(a, b"lo"),
        b", (int64_t)",
        part(a, b"hi"),
        b", ",
        s,
        b")",
      ]),
    );
    bound(p, held, v, Bytes::concat_all([b"(int64_t)", part(a, b"lo")]))
  } else { unwritten(p, pr, op) }
}

/// Whether checked operation `op` over 64-bit operands `a` and `b` (`a` alone for a negation) of
/// width `w` gives an answer the width holds, as C tests it.
fn fits_printed(
  p: Place,
  pr: Printing,
  v: Var,
  op: Bytes,
  w: Width,
  a: Bytes,
  b: Bytes,
) -> Printing / {abort.raise} = {
  let u = |x: Bytes| Bytes::concat_all([b"(uint64_t)(", x, b")"]);
  if op == b"checked_neg" {
    bound(p, pr, v, if w.signed { Bytes::concat_all([b"((", a, b") != INT64_MIN)"]) }
    else { Bytes::concat_all([b"(", u(a), b" == 0)"]) })
  } else if w.signed {
    let t = temp(pr);
    let held = line(t.pr, p.depth, Bytes::concat_all([b"int64_t ", t.name, b";"]));
    let f = if op == b"checked_add" { b"ply_add_ov" }
    else if op == b"checked_sub" { b"ply_sub_ov" }
    else { b"ply_mul_ov" };
    bound(
      p,
      held,
      v,
      Bytes::concat_all([b"!", f, b"((int64_t)(", a, b"), (int64_t)(", b, b"), &", t.name, b")"]),
    )
  } else if op == b"checked_add" {
    bound(p, pr, v, Bytes::concat_all([b"(", u(a), b" + ", u(b), b" >= ", u(a), b")"]))
  } else if op == b"checked_sub" {
    bound(p, pr, v, Bytes::concat_all([b"(", u(a), b" >= ", u(b), b")"]))
  } else {
    bound(
      p,
      pr,
      v,
      Bytes::concat_all([
        b"(",
        u(a),
        b" == 0 || ",
        u(a),
        b" * ",
        u(b),
        b" / ",
        u(a),
        b" == ",
        u(b),
        b")",
      ]),
    )
  }
}

/// Words compared where they lie: a character's as its scalar value, two strings' or byte
/// strings' by their bytes, two values of a sum of no constructor's argument by the constructor
/// each header names, and the sign of two characters' or strings' order.
fn word_printed(
  p: Place,
  pr: Printing,
  v: Var,
  op: Bytes,
  a: Bytes,
  b: Bytes,
) -> Printing / {abort.raise} =
  if comparison(op) { bound(p, pr, v, infix(a, compare_c(op), b)) }
  // A character's scalar value: its word above the character's tag.
  else if op == b"char_code" {
    bound(p, pr, v, Bytes::concat_all([b"((int64_t)((uint64_t)(", a, b") >> 3))"]))
  } else if op == b"bytes_eq" { bound(p, pr, v, bytes_equal(a, b)) }
  else if op == b"bytes_ne" { bound(p, pr, v, b"!".concat(bytes_equal(a, b))) }
  else if op == b"order" { bound(p, pr, v, signed_order(a, b)) } else if op == b"bytes_order" {
    let lx = temp(pr);
    let ly = temp(
      line(
        lx.pr,
        p.depth,
        Bytes::concat_all([b"int64_t ", lx.name, b" = (int64_t)", text_field(a, b"len"), b";"]),
      ),
    );
    let n = named(
      line(
        ly.pr,
        p.depth,
        Bytes::concat_all([b"int64_t ", ly.name, b" = (int64_t)", text_field(b, b"len"), b";"]),
      ),
      v,
    );
    let x = lx.name;
    let y = ly.name;
    line(
      line(
        n.pr,
        p.depth,
        Bytes::concat_all([
          b"int64_t ",
          n.name,
          b" = (int64_t)memcmp(",
          bytes_of(a),
          b", ",
          bytes_of(b),
          b", (size_t)(",
          x,
          b" < ",
          y,
          b" ? ",
          x,
          b" : ",
          y,
          b"));",
        ]),
      ),
      p.depth,
      Bytes::concat_all([
        b"if (",
        n.name,
        b" == 0) ",
        n.name,
        b" = (",
        x,
        b" > ",
        y,
        b") - (",
        x,
        b" < ",
        y,
        b");",
      ]),
    )
  } else { unwritten(p, pr, op) }

/// An operator over a width held in its own C type: arithmetic below 64 bits done wide and narrowed
/// back under an overflow test, at 64 bits a sum or difference tested as it is formed and the rest
/// through the runtime; bit operators, shifts, comparisons, wrapping and saturating arithmetic and
/// rotations in the width itself.
fn width_printed(
  p: Place,
  pr: Printing,
  v: Var,
  op: Bytes,
  w: Width,
  a: Bytes,
  b: Bytes,
  count: Bytes,
) -> Printing / {abort.raise} = {
  let t_c = ctype(KNum(w));
  let narrowed = |q: Printing, wide: Bytes| {
    let g = line(
      q,
      p.depth,
      Bytes::concat_all([
        b"if (",
        wide,
        b" < ",
        int_lit(width_min(w)),
        b" || ",
        wide,
        b" > ",
        int_lit(width_max(w)),
        b") { rt_overflow_p(ctx, ",
        ascii_of_int(overflow_code(op)),
        b"); ",
        p.leave,
        b" }",
      ]),
    );
    bound(p, g, v, Bytes::concat_all([b"(", t_c, b")", wide]))
  };
  if op.starts_with(b"checked_") { fits_printed(p, pr, v, op, w, a, b) }
  else if arithmetic(op) && w.bits < 64 {
    let t = temp(site(p, pr));
    if op == b"add" || op == b"sub" {
      narrowed(
        line(
          t.pr,
          p.depth,
          Bytes::concat_all([
            b"int64_t ",
            t.name,
            b" = (int64_t)(",
            a,
            if op == b"add" { b") + (int64_t)(" } else { b") - (int64_t)(" },
            b,
            b");",
          ]),
        ),
        t.name,
      )
    } else if op == b"mul" {
      let declared = line(t.pr, p.depth, Bytes::concat_all([b"int64_t ", t.name, b";"]));
      narrowed(
        line(
          declared,
          p.depth,
          Bytes::concat_all([
            b"if (ply_mul_ov((int64_t)(",
            a,
            b"), (int64_t)(",
            b,
            b"), &",
            t.name,
            b")) { rt_overflow_p(ctx, ",
            ascii_of_int(overflow_code(op)),
            b"); ",
            p.leave,
            b" }",
          ]),
        ),
        t.name,
      )
    } else {
      // Below 64 bits the quotient is exact in an `int64_t`, and the width's ends are checked after.
      let zero = line(
        t.pr,
        p.depth,
        Bytes::concat_all([
          b"if ((int64_t)(",
          b,
          b") == 0) { rt_by_zero_p(ctx, ",
          if op == b"div" { b"0" } else { b"1" },
          b"); ",
          p.leave,
          b" }",
        ]),
      );
      narrowed(
        line(
          zero,
          p.depth,
          Bytes::concat_all([
            b"int64_t ",
            t.name,
            b" = (int64_t)(",
            a,
            if op == b"div" { b") / (int64_t)(" } else { b") % (int64_t)(" },
            b,
            b");",
          ]),
        ),
        t.name,
      )
    }
  } else if op == b"add" || op == b"sub" {
    let n = named(site(p, pr), v);
    let over = if w.signed {
      Bytes::concat_all([
        if op == b"add" { b"ply_add_ov(" } else { b"ply_sub_ov(" },
        a,
        b", ",
        b,
        b", &",
        n.name,
        b")",
      ])
    } else {
      Bytes::concat_all([
        b"(",
        n.name,
        b" = (uint64_t)(",
        a,
        if op == b"add" { b") + (uint64_t)(" } else { b") - (uint64_t)(" },
        b,
        b"), ",
        if op == b"add" { Bytes::concat_all([n.name, b" < (uint64_t)(", a, b"))"]) }
        else { Bytes::concat_all([b"(uint64_t)(", a, b") < (uint64_t)(", b, b"))"]) },
      ])
    };
    line(
      line(n.pr, p.depth, Bytes::concat_all([t_c, b" ", n.name, b";"])),
      p.depth,
      Bytes::concat_all([
        b"if (",
        over,
        b") { rt_overflow_p(ctx, ",
        ascii_of_int(overflow_code(op)),
        b"); ",
        p.leave,
        b" }",
      ]),
    )
  } else if op == b"mul" {
    // An unsigned product overflowed where dividing it back does not give the other operand.
    let n = named(site(p, pr), v);
    let u = |x: Bytes| Bytes::concat_all([b"(uint64_t)(", x, b")"]);
    let over = if w.signed {
      Bytes::concat_all([b"ply_mul_ov((int64_t)(", a, b"), (int64_t)(", b, b"), &", n.name, b")"])
    } else {
      Bytes::concat_all([
        b"(",
        n.name,
        b" = ",
        u(a),
        b" * ",
        u(b),
        b", ",
        u(a),
        b" != 0 && ",
        n.name,
        b" / ",
        u(a),
        b" != ",
        u(b),
        b")",
      ])
    };
    line(
      line(n.pr, p.depth, Bytes::concat_all([t_c, b" ", n.name, b";"])),
      p.depth,
      Bytes::concat_all([
        b"if (",
        over,
        b") { rt_overflow_p(ctx, ",
        ascii_of_int(overflow_code(op)),
        b"); ",
        p.leave,
        b" }",
      ]),
    )
  } else if op == b"div" || op == b"rem" {
    let zero = line(
      site(p, pr),
      p.depth,
      Bytes::concat_all([
        b"if ((",
        t_c,
        b")(",
        b,
        b") == 0) { rt_by_zero_p(ctx, ",
        if op == b"div" { b"0" } else { b"1" },
        b"); ",
        p.leave,
        b" }",
      ]),
    );
    let past = if !w.signed { zero } else {
      line(
        zero,
        p.depth,
        Bytes::concat_all([
          b"if ((int64_t)(",
          b,
          b") == -1 && (int64_t)(",
          a,
          b") == INT64_MIN) { rt_overflow_p(ctx, ",
          ascii_of_int(overflow_code(op)),
          b"); ",
          p.leave,
          b" }",
        ]),
      )
    };
    bound(
      p,
      past,
      v,
      Bytes::concat_all([
        b"(",
        t_c,
        b")((",
        t_c,
        b")(",
        a,
        if op == b"div" { b") / (" } else { b") % (" },
        t_c,
        b")(",
        b,
        b"))",
      ]),
    )
  } else if is_bitop(op) { bound(p, pr, v, infix(a, bitop_c(op), b)) }
  else if shift(op) { shifted(p, pr, v, op, Some(w), a, count) }
  else if op == b"bitnot" { bound(p, pr, v, Bytes::concat_all([b"(", t_c, b") ~(", a, b")"])) }
  else if op == b"ne" { bound(p, pr, v, Bytes::concat_all([b"!((", a, b") == (", b, b"))"])) }
  else if comparison(op) { bound(p, pr, v, infix(a, compare_c(op), b)) }
  else if op == b"order" { bound(p, pr, v, signed_order(a, b)) }
  else if op == b"neg" && w.bits < 64 {
    let t = temp(site(p, pr));
    narrowed(
      line(t.pr, p.depth, Bytes::concat_all([b"int64_t ", t.name, b" = -(int64_t)(", a, b");"])),
      t.name,
    )
  } else if op == b"neg" {
    // Only the least signed value, or an unsigned one past zero, has no negation: the guard runs
    // before the value exists.
    let guarded = line(
      site(p, pr),
      p.depth,
      Bytes::concat_all([
        b"if (",
        a,
        if w.signed { b" == INT64_MIN" } else { b" != 0" },
        b") { rt_overflow_p(ctx, ",
        ascii_of_int(overflow_code(op)),
        b"); ",
        p.leave,
        b" }",
      ]),
    );
    bound(p, guarded, v, Bytes::concat_all([b"-(", a, b")"]))
  } else if op == b"wrap_add" || op == b"wrap_sub" || op == b"wrap_mul" {
    // Below 32 bits C would promote the operands to `int`, where a product can overflow.
    let u = unsigned_ctype(w);
    bound(
      p,
      site(p, pr),
      v,
      Bytes::concat_all([
        b"(",
        u,
        b")((uint64_t)(",
        u,
        b")(",
        a,
        b") ",
        if op == b"wrap_add" { b"+" } else if op == b"wrap_sub" { b"-" } else { b"*" },
        b" (uint64_t)(",
        u,
        b")(",
        b,
        b"))",
      ]),
    )
  } else if op == b"rotl" || op == b"rotr" { rotated(p, pr, v, op, w, a, count) }
  else if op == b"saturating_add" || op == b"saturating_sub" || op == b"saturating_mul" {
    if w.bits == 64 { saturated_word(p, pr, v, op, w, a, b) }
    else { saturated(p, pr, v, op, w, a, b) }
  } else if op == b"to_int" {
    let s = site(p, pr);
    let held = if w.signed || w.bits < 64 { s } else {
      line(
        s,
        p.depth,
        Bytes::concat_all([
          b"if ((uint64_t)(",
          a,
          b") > (uint64_t)INT64_MAX) { rt_not_an_int_p(ctx, (int64_t)(",
          a,
          b")); ",
          p.leave,
          b" }",
        ]),
      )
    };
    bound(p, held, v, Bytes::concat_all([b"(int64_t)(", a, b")"]))
  } else if op == b"exact_add" || op == b"exact_sub" || op == b"exact_mul" || op == b"exact_neg" {
    // Exact in the 64 bits the answer is held in, which the width's operands cannot overflow.
    let wide = |e: Bytes| Bytes::concat_all([b"(", c_type(v.rep), b")(", e, b")"]);
    bound(p, site(p, pr), v, if op == b"exact_neg" { b"-".concat(wide(a)) } else {
      Bytes::concat_all([
        wide(a),
        if op == b"exact_add" { b" + " } else if op == b"exact_sub" { b" - " } else { b" * " },
        wide(b),
      ])
    })
  } else { unwritten(p, pr, op) }
}

/// A rotation right by the count, or left as one right by the rest of the width.
fn rotated(
  p: Place,
  pr: Printing,
  v: Var,
  op: Bytes,
  w: Width,
  a: Bytes,
  count: Bytes,
) -> Printing = {
  let u = unsigned_ctype(w);
  let bits = ascii_of_int(w.bits);
  let k = temp(site(p, pr));
  let turned = line(
    k.pr,
    p.depth,
    Bytes::concat_all([
      b"int64_t ",
      k.name,
      b" = ((",
      if op == b"rotl" { b"-" } else { b"" },
      b"((",
      count,
      b") % ",
      bits,
      b")) % ",
      bits,
      b" + ",
      bits,
      b") % ",
      bits,
      b";",
    ]),
  );
  bound(
    p,
    turned,
    v,
    Bytes::concat_all([
      b"(",
      u,
      b")(",
      k.name,
      b" == 0 ? (",
      u,
      b")(",
      a,
      b") : ((",
      u,
      b")(",
      a,
      b") >> ",
      k.name,
      b") | ((",
      u,
      b")(",
      a,
      b") << (",
      bits,
      b" - ",
      k.name,
      b")))",
    ]),
  )
}

/// At 64 bits, where nothing wider holds the exact answer: the wrapped answer where the operation
/// does not overflow, else the end the exact one lies past.
fn saturated_word(
  p: Place,
  pr: Printing,
  v: Var,
  op: Bytes,
  w: Width,
  a: Bytes,
  b: Bytes,
) -> Printing = {
  let r = temp(site(p, pr));
  let held = if w.signed {
    let past = if op == b"saturating_add" { Bytes::concat_all([b"(", b, b") > 0"]) }
    else if op == b"saturating_sub" { Bytes::concat_all([b"(", b, b") < 0"]) }
    else { Bytes::concat_all([b"((", a, b") < 0) == ((", b, b") < 0)"]) };
    Bytes::concat_all([
      b"int64_t ",
      r.name,
      b"; if (",
      if op == b"saturating_add" { b"ply_add_ov" }
      else if op == b"saturating_sub" { b"ply_sub_ov" }
      else { b"ply_mul_ov" },
      b"(",
      a,
      b", ",
      b,
      b", &",
      r.name,
      b")) ",
      r.name,
      b" = ",
      past,
      b" ? INT64_MAX : INT64_MIN;",
    ])
  } else {
    let x = Bytes::concat_all([b"(uint64_t)(", a, b")"]);
    let y = Bytes::concat_all([b"(uint64_t)(", b, b")"]);
    if op == b"saturating_sub" {
      Bytes::concat_all([
        b"uint64_t ",
        r.name,
        b" = ",
        x,
        b" < ",
        y,
        b" ? 0 : ",
        x,
        b" - ",
        y,
        b";",
      ])
    } else if op == b"saturating_add" {
      Bytes::concat_all([
        b"uint64_t ",
        r.name,
        b" = ",
        x,
        b" + ",
        y,
        b"; if (",
        r.name,
        b" < ",
        x,
        b") ",
        r.name,
        b" = UINT64_MAX;",
      ])
    } else {
      Bytes::concat_all([
        b"uint64_t ",
        r.name,
        b" = ",
        x,
        b" * ",
        y,
        b"; if (",
        x,
        b" != 0 && ",
        r.name,
        b" / ",
        x,
        b" != ",
        y,
        b") ",
        r.name,
        b" = UINT64_MAX;",
      ])
    }
  };
  bound(p, line(r.pr, p.depth, held), v, r.name)
}

/// Exact in 64 bits, then held to the width's ends; only an unsigned 32-bit product needs the
/// unsigned word, and it can only pass the greatest value.
fn saturated(p: Place, pr: Printing, v: Var, op: Bytes, w: Width, a: Bytes, b: Bytes) -> Printing = {
  let unsigned = !w.signed && op == b"saturating_mul";
  let wide = if unsigned { b"uint64_t" } else { b"int64_t" };
  let r = temp(site(p, pr));
  let exact = line(
    r.pr,
    p.depth,
    Bytes::concat_all([
      wide,
      b" ",
      r.name,
      b" = (",
      wide,
      b")(",
      a,
      b")",
      if op == b"saturating_add" { b" + " }
      else if op == b"saturating_sub" { b" - " }
      else { b" * " },
      b"(",
      wide,
      b")(",
      b,
      b");",
    ]),
  );
  let top = Bytes::concat_all([
    r.name,
    b" > ",
    if unsigned { b"(uint64_t)" } else { b"" },
    int_lit(width_max(w)),
    b" ? ",
    int_lit(width_max(w)),
    b" : ",
    r.name,
  ]);
  bound(
    p,
    exact,
    v,
    Bytes::concat_all([
      b"(",
      ctype(KNum(w)),
      b")(",
      if unsigned { top } else {
        Bytes::concat_all([
          r.name,
          b" < ",
          int_lit(width_min(w)),
          b" ? ",
          int_lit(width_min(w)),
          b" : (",
          top,
          b")",
        ])
      },
      b")",
    ]),
  )
}

/// A shift by a count tested against the width (64 for an `Int`), done unsigned where C would leave
/// it undefined.
fn shifted(
  p: Place,
  pr: Printing,
  v: Var,
  op: Bytes,
  width: Option<Width>,
  a: Bytes,
  count: Bytes,
) -> Printing = {
  let c = temp(site(p, pr));
  let held = line(c.pr, p.depth, Bytes::concat_all([b"int64_t ", c.name, b" = ", count, b";"]));
  let guarded = line(
    held,
    p.depth,
    Bytes::concat_all([
      b"if ((uint64_t)",
      c.name,
      b" >= (uint64_t)",
      ascii_of_int(match width { Some(w) -> w.bits, None -> 64 }),
      b") { rt_shift_count_p(ctx, ",
      c.name,
      b", ",
      match width { Some(w) -> ascii_of_int(width_index(w)), None -> b"-1" },
      b"); ",
      p.leave,
      b" }",
    ]),
  );
  let n = c.name;
  bound(p, guarded, v, match width {
    Some(w) -> {
      let u = unsigned_ctype(w);
      if op == b"shl" { Bytes::concat_all([b"(", u, b")((", u, b")(", a, b") << ", n, b")"]) }
      else if op == b"shr" && w.signed { Bytes::concat_all([b"(", a, b") >> ", n]) }
      else { Bytes::concat_all([b"(", u, b")((", u, b")(", a, b") >> ", n, b")"]) }
    },
    None -> if op == b"shl" { Bytes::concat_all([b"(int64_t)((uint64_t)(", a, b") << ", n, b")"]) }
    else if op == b"shr" { Bytes::concat_all([b"(", a, b") >> ", n]) }
    else { Bytes::concat_all([b"(int64_t)((uint64_t)(", a, b") >> ", n, b")"]) },
  })
}

/// The case of `Ordering` the sign `s` names, held as its case's index. Raises for an `Ordering`
/// held otherwise, which a body never holds.
fn ordering(p: Place, pr: Printing, v: Var, s: Bytes) -> Printing / {abort.raise} =
  match v.rep {
    RSum(c) ->
      bound(
        p,
        pr,
        v,
        Bytes::concat_all([
          s,
          b" < 0 ? ",
          case_at(c.cases, b"Less"),
          b" : ",
          s,
          b" == 0 ? ",
          case_at(c.cases, b"Equal"),
          b" : ",
          case_at(c.cases, b"Greater"),
        ]),
      ),
    _ -> unprinted(Scalars, b"an `Ordering` held other than as its cases", c_type(v.rep)),
  }

/// The sign an `Ordering` held as its cases stands for: below, at or above zero as it is `Less`,
/// `Equal` or `Greater`. Raises for one held otherwise.
fn sign_printed(p: Place, pr: Printing, v: Var, on: Rep, o: Bytes) -> Printing / {abort.raise} =
  match on {
    RSum(c) ->
      bound(
        p,
        pr,
        v,
        Bytes::concat_all([
          b"(",
          o,
          b" == ",
          case_at(c.cases, b"Less"),
          b" ? -1 : ",
          o,
          b" == ",
          case_at(c.cases, b"Equal"),
          b" ? 0 : 1)",
        ]),
      ),
    _ -> unprinted(Scalars, b"an `Ordering` held other than as its cases", c_type(on)),
  }

/// The index of case `name` among `cases`, as C writes it.
fn case_at(cases: List<Bytes>, name: Bytes) -> Bytes =
  ascii_of_int(
    range(0, cases.len()).fold(0, |k: Int, i: Int| if cases.at(i) == Some(name) { i } else { k }),
  )

/// Below zero, zero or above zero as `x` and `y`, C values of one ordered type, order.
fn signed_order(x: Bytes, y: Bytes) -> Bytes =
  Bytes::concat_all([b"(int64_t)((", x, b") > (", y, b")) - (int64_t)((", x, b") < (", y, b"))"])

/// Whether the strings or byte strings `x` and `y` hold the same bytes, read where they lie.
fn bytes_equal(x: Bytes, y: Bytes) -> Bytes =
  Bytes::concat_all([
    b"(",
    x,
    b" == ",
    y,
    b" || (",
    text_field(x, b"len"),
    b" == ",
    text_field(y, b"len"),
    b" && memcmp(",
    bytes_of(x),
    b", ",
    bytes_of(y),
    b", ",
    text_field(x, b"len"),
    b") == 0))",
  ])

/// A shift's or rotation's count as an `Int`, whatever width holds it.
fn int_text(pr: Printing, a: Arg) -> Bytes =
  match rep_of_arg(a) {
    RNum(_) -> Bytes::concat_all([b"(int64_t)(", arg_text(pr, a), b")"]),
    _ -> arg_text(pr, a),
  }

/// Where a literal divides, C's own operator does it: any but zero and minus one.
fn literal_divisor(d: Option<Arg>) -> Bool =
  match d { Some(AInt(n)) -> n != 0 && n != 0 - 1, _ -> false }

fn compare_c(op: Bytes) -> Bytes =
  if op == b"lt" { b"<" }
  else if op == b"le" { b"<=" }
  else if op == b"gt" { b">" }
  else if op == b"ge" { b">=" }
  else if op == b"eq" { b"==" }
  else { b"!=" }

fn float_c(op: Bytes) -> Bytes =
  if op == b"add" { b"+" } else if op == b"sub" { b"-" } else if op == b"mul" { b"*" } else { b"/" }

fn place() -> Place =
  {
    u: {
      base: 0,
      answer: RInt,
      site: None,
      arm: None,
      looping: None,
      landing: None,
      group: None,
      unwinds: [],
      symbol: b"f",
      leaving: b"ctx->fuel += 1;",
    },
    at: span_between(0, 4),
    leave: b"return 0;",
    depth: 0,
  }

fn local(id: Int, ty: Bytes, rep: Rep) -> Var =
  { id: id, ty: TyCon({ name: ty, args: [] }), rep: rep }

/// `op` over `args` held as `on` printed into `v`, the parameters named as `names` says.
fn printed_prim(
  names: Map<Int, Bytes>,
  v: Var,
  op: Bytes,
  on: Rep,
  args: List<Arg>,
) -> Bytes / {abort.raise} =
  spelled(prim(place(), printing(names), Some(v), { op: op, on: on, args: args }).out)

test "an order's sign is made the case of `Ordering` it names, read back off it, and an `Ordering` is held as nothing else" {
  let index = RSum({
    laid: sum_laid(range(0, 3).map(|_: Int| { args: record_laid([]), indirect: false })),
    cases: [b"Less", b"Equal", b"Greater"],
  });
  let made = printed_prim(
    Map::new().insert(0, b"p0"),
    local(1, b"Ordering", index),
    b"ordering",
    RInt,
    [AVar(local(0, b"Int", RInt))],
  );
  let sign = |rep: Rep|
    printed_prim(Map::new().insert(0, b"p0"), local(1, b"Int", RInt), b"sign", rep, [
      AVar(local(0, b"Ordering", rep)),
    ]);
  // Both ways in C over the case's index: no object made or read, no runtime asked.
  assert_eq(
    [made, sign(index)].map(|c: Bytes|
      c.index_of(b"rt_") == None && c.index_of(b"ply_obj") == None),
    [true, true],
  );
  let word = b"unprinted Scalars: an `Ordering` held other than as its cases";
  let word_made = handle {
    printed_prim(Map::new().insert(0, b"p0"), local(1, b"Ordering", RWord), b"ordering", RInt, [
      AVar(local(0, b"Int", RInt)),
    ])
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  let read = handle { sign(RWord) } with { abort.raise(m) -> Bytes::of_string(m) };
  assert_eq([word_made.starts_with(word), read.starts_with(word)], [true, true])
}

test "a decimal's constant is its two words in place, `()` the word 0, and no constant is read at run time" {
  let decimal = printed_prim(Map::new(), local(0, b"Decimal", RDec), b"decimal", RInt, [
    AInt(65536),
    AInt(0),
  ]);
  assert(
    decimal.index_of(b"INT64_C(65536)") != None && decimal.index_of(b"rt_") == None,
    Some(String::of_bytes_lossy(decimal)),
  );
  // A value of no words, held as the word 0.
  let unit = literal(place(), printing(Map::new()), Some(local(0, b"Unit", RWord)), LUnit);
  assert(
    spelled(unit.out).index_of(b" = 0;") != None,
    Some(String::of_bytes_lossy(spelled(unit.out))),
  );
  let said = handle {
    literal(place(), printing(Map::new()), Some(local(1, b"String", RWord)), LStr(b"a"));
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert(said.starts_with(b"unprinted Scalars: a literal the folded pass did not lay out"), None)
}

test "two strings are equal where their bytes are, and two characters as C compares their words" {
  let names = Map::new().insert(0, b"p0").insert(1, b"p1");
  let s = |id: Int| AVar(local(id, b"String", RWord));
  let strings = printed_prim(names, local(2, b"Bool", RBool), b"bytes_ne", RWord, [s(0), s(1)]);
  assert(
    strings.index_of(b"memcmp(") != None && strings.index_of(b"rt_") == None,
    Some(String::of_bytes_lossy(strings)),
  );
  let c = |id: Int| AVar(local(id, b"Char", RWord));
  let chars = printed_prim(names, local(2, b"Bool", RBool), b"le", RWord, [c(0), c(1)]);
  assert(
    chars.index_of(b"<=") != None && chars.index_of(b"rt_") == None,
    Some(String::of_bytes_lossy(chars)),
  )
}
