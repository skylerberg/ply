//! Values held otherwise: a scalar boxed or read out of its word, a record or a sum made its word
//! form or opened out of it, a value of no words its word 0, a view of a list its list.

import compiler.syntax.parsing (span_between)
import compiler.check.types (TyCon, list_type, int_type)
import compiler.check.types (Type)
import compiler.check.known (none_ctor, some_ctor)
import compiler.emit.c (int_lit)
import compiler.emit.layout (LWords, LRecord, LPlaced, FieldLaid, P, sum_laid, record_laid, raw,
                             raw_sum, words, header_bytes)
import compiler.emit.reps (laid_known)
import compiler.emit.tir (Rep, RWord, RFlat, RSum, RUnit, RSlice, Var, Arg, AVar, rep_of_arg,
                          rep_said, in_box)
import compiler.emit.pieces (Text, spelled)
import compiler.emit.print.text (Printing, Place, printing, named, pad, pieces, line, arg_text,
                                 part_names, unprinted, slot)
import compiler.emit.print.made (arg_parts, parts_word, word_parts, word_viewed, word_as,
                                 declared_as, words_laid, placed_write)
import compiler.emit.lower.held (values_of)
import compiler.emit.print.counting (call_text, calls, counts_any, lets_go_of)
import compiler.emit.print.counts (released)
import compiler.emit.print.lists (rest_made)

/// `k.arg` held as `k.to`: a scalar boxed, which takes it, or read out of its word, which borrows
/// it; a record or a sum made its word form, as `made.parts_word` makes it, which takes it, or read
/// out of it in place, which borrows it; a value of no words no value, or its word 0; a view of a
/// list its list from the view's offset.
pub fn worded(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  k: { arg: Arg, to: Rep },
) -> Printing / {abort.raise} =
  match into {
    None ->
      unprinted(
        b"a value held otherwise that nothing holds",
        Bytes::concat_all([rep_said(rep_of_arg(k.arg)), b" held as ", rep_said(k.to)]),
      ),
    Some(v) -> {
      let from = rep_of_arg(k.arg);
      let xs = arg_parts(pr, k.arg);
      if from == k.to { declared_as(p, pr, v, xs) } else {
        match k.to {
          RWord -> if from == RSlice { list_of_view(p, pr, v, xs) } else {
            match placed_fields(pr, v.ty) {
              Some(fs) -> placed_box(p, pr, v, words_laid(xs, values_of(from)), fs),
              None -> made_word(p, pr, v, xs, from),
            }
          },
          RUnit -> declared_as(p, pr, v, []),
          RFlat(_) -> opened(p, pr, v, from, k),
          // A sum whose one word is a raw scalar is read out as that scalar is.
          RSum(s) -> if !raw_sum(s.laid) { opened(p, pr, v, from, k) }
          else { scalar_borrowed(p, pr, v, from, k) },
          _ -> scalar_borrowed(p, pr, v, from, k),
        }
      }
    },
  }

/// `v`, the word form of a value of C values `xs` held as `from`, as `made.parts_word` makes it.
fn made_word(p: Place, pr: Printing, v: Var, xs: List<Bytes>, from: Rep) -> Printing = {
  let n = named(pr, v);
  let w = parts_word(n.pr, n.name, xs, from);
  if w.word == n.name { pieces(w.pr, [Text(pad(p.depth))].concat(w.prep).push(Text(b"\n"))) }
  else { line(w.pr, p.depth, Bytes::concat_all([b"Word ", n.name, b" = ", w.word, b";"])) }
}

/// The fields of the record type `ty`, where one of them lies in place behind a header.
fn placed_fields(pr: Printing, ty: Type) -> Option<List<FieldLaid>> =
  match laid_known(pr.ctors, ty) {
    Some(LRecord(fs)) -> if fs.any(|f: FieldLaid| match f.laid { LPlaced(_) -> true, _ -> false }) {
      Some(fs)
    } else { None },
    _ -> None,
  }

/// `v`, the box of a record laid as `fs`, made of `ws`, its words in order but each field in
/// place given as its own record's word: that record's words copied behind a header, its box freed
/// where this took its last count, and each counted word it holds counted once more where not.
fn placed_box(
  p: Place,
  pr: Printing,
  v: Var,
  ws: List<Bytes>,
  fs: List<FieldLaid>,
) -> Printing / {abort.raise} = {
  let n = named(pr, v);
  let made = line(
    n.pr,
    p.depth,
    Bytes::concat_all([
      b"Word ",
      n.name,
      b" = rt_alloc_bytes_p(ctx, ",
      int_lit(header_bytes() + 8 * words(LRecord(fs))),
      b");",
    ]),
  );
  fs.fold({ pr: made, at: 0 }, |acc: { pr: Printing, at: Int }, f: FieldLaid|
    match f.laid {
      LPlaced(r) -> {
        let moved = placed_write(
          acc.pr,
          slot(n.name, f.at),
          Bytes::concat_all([b"&", slot(n.name, f.at + 1)]),
          nth(ws, acc.at),
          r,
        );
        { pr: line(moved.pr, p.depth, moved.text), at: acc.at + 1 }
      },
      other -> {
        let k = words(other);
        {
          pr: range(0, k).fold(acc.pr, |q: Printing, j: Int|
            line(
              q,
              p.depth,
              Bytes::concat_all([slot(n.name, f.at + j), b" = ", nth(ws, acc.at + j), b";"]),
            )),
          at: acc.at + k,
        }
      },
    }).pr
}

/// `v`, a scalar read out of the word form `k.arg`, which it borrows: what holds the word lets it go.
fn scalar_borrowed(
  p: Place,
  pr: Printing,
  v: Var,
  from: Rep,
  k: { arg: Arg, to: Rep },
) -> Printing / {abort.raise} =
  if from == RWord { declared_as(p, pr, v, [word_as(arg_text(pr, k.arg), k.to)]) }
  else { mismatched(from, k.to) }

/// `v`, a record or a sum, read out of the word form `k.arg`: a box of its words viewed in place,
/// which takes nothing (`tir.unpacks`), and a sum of one word the word held again.
fn opened(
  p: Place,
  pr: Printing,
  v: Var,
  from: Rep,
  k: { arg: Arg, to: Rep },
) -> Printing / {abort.raise} =
  if from != RWord { mismatched(from, k.to) } else {
    let n = named(pr, v);
    let word = arg_text(pr, k.arg);
    let names = part_names(n.name, k.to);
    pieces(
      n.pr,
      [Text(pad(p.depth))].concat(if in_box(k.to) { word_viewed(word, k.to, names) }
      else { word_parts(word, k.to, names) }).push(
        Text(b"\n"),
      ),
    )
  }

/// `v`, a view's list from its offset on, sharing the list's trie: the list itself where the offset
/// is zero, whose count the view hands over, and otherwise a list of its own whose root and copied
/// items are counted as their types count them, the view's list then let go of by its type.
fn list_of_view(p: Place, pr: Printing, v: Var, xs: List<Bytes>) -> Printing / {abort.raise} = {
  let list = nth(xs, 0);
  let from_at = nth(xs, 1);
  let n = named(pr, v);
  let opened = line(n.pr, p.depth, Bytes::concat_all([b"Word ", n.name, b" = ", list, b";"]));
  let cut = line(opened, p.depth, Bytes::concat_all([b"if (", from_at, b") {"]));
  let made = rest_made(cut, p.depth + 1, n.name, list, from_at, v.ty);
  let go = released(made, v.ty, RWord, [list]);
  line(pieces(go.pr, [Text(pad(p.depth + 1))].concat(go.out).push(Text(b"\n"))), p.depth, b"}")
}

fn mismatched(from: Rep, to: Rep) -> Printing / {abort.raise} =
  unprinted(
    b"a value held as no type holds both, which the form never packs",
    Bytes::concat_all([rep_said(from), b" held as ", rep_said(to)]),
  )

fn nth(xs: List<Bytes>, k: Int) -> Bytes = match xs.at(k) { Some(x) -> x, None -> b"0" }

fn place() -> Place =
  {
    u: {
      symbol: b"f",
      base: 0,
      answer: RWord,
      site: None,
      arm: None,
      looping: None,
      landing: None,
      group: None,
      unwinds: [],
      leaving: b"ctx->fuel += 1;",
    },
    at: span_between(0, 0),
    leave: b"return 0;",
    depth: 0,
  }

fn local(id: Int, rep: Rep) -> Var = { id: id, ty: TyCon({ name: b"T", args: [] }), rep: rep }

fn point() -> Rep = RFlat([{ name: b"x", rep: RWord }, { name: b"y", rep: RWord }])

test "a record's word form is a box made of its words, and a box read back is viewed in place, taken nowhere" {
  let pr = { ..printing(Map::new().insert(0, b"p0")), temps: 4 };
  let made_word = worded(place(), pr, Some(local(1, RWord)), {
    arg: AVar(local(0, point())),
    to: RWord,
  });
  let made = spelled(made_word.out);
  // A header and the record's two words; each leaf written to its word.
  assert_eq(
    [b"rt_alloc_bytes_p(ctx, INT64_C(24))", b"[0] = p0_0;", b"[1] = p0_1;"].filter(|part: Bytes|
      made.index_of(part) == None),
    [],
  );
  let both = spelled(
    worded(place(), made_word, Some(local(2, point())), {
      arg: AVar(local(1, RWord)),
      to: point(),
    }).out,
  );
  let opened_back = both.slice(made.len(), both.len());
  assert(
    opened_back.index_of(b"[0]") != None && opened_back.index_of(b"[1]") != None
      && !counts_any(opened_back)
      && opened_back.index_of(b"rt_") == None,
    Some(String::of_bytes_lossy(opened_back)),
  )
}

test "a sum of one word is its word either way, and a value of no words is its word 0" {
  let one = RSum({
    laid: sum_laid([
      { args: record_laid([]), indirect: false },
      { args: record_laid([LWords([P])]), indirect: false },
    ]),
    cases: [none_ctor(), some_ctor()],
  });
  let pr = printing(Map::new().insert(0, b"p0"));
  let said = |from: Rep, to: Rep|
    spelled(worded(place(), pr, Some(local(1, to)), { arg: AVar(local(0, from)), to: to }).out);
  // The word itself, nothing called.
  assert_eq([said(one, RWord), said(RWord, one)].map(|c: Bytes| c.ends_with(b" = p0;\n")), [
    true,
    true,
  ]);
  assert(said(RUnit, RWord).ends_with(b" = 0;\n"), None);
  // A sum wider than a word read out of its box: its words, viewed in place.
  let tagged = RSum({
    laid: sum_laid([
      { args: record_laid([]), indirect: false },
      { args: record_laid([LWords([raw()])]), indirect: false },
    ]),
    cases: [none_ctor(), some_ctor()],
  });
  let wide = said(RWord, tagged);
  assert(
    wide.index_of(b"ply_words(p0)[0]") != None && wide.index_of(b"ply_words(p0)[1]") != None
      && !counts_any(wide),
    Some(String::of_bytes_lossy(wide)),
  );
  // A sum of one case holding a raw scalar is read out of its word as the scalar is, borrowing it:
  // what holds the word lets its box go.
  let id = RSum({
    laid: sum_laid([{ args: record_laid([LWords([raw()])]), indirect: false }]),
    cases: [b"Id"],
  });
  let read = said(RWord, id);
  assert(!counts_any(read), Some(String::of_bytes_lossy(read)))
}

test "a view of a list from an offset is made the list of its rest where it leaves" {
  let pr = printing(Map::new().insert(0, b"p0"));
  let listed = { ..local(1, RWord), ty: list_type(int_type()) };
  let text = spelled(
    worded(place(), pr, Some(listed), { arg: AVar(local(0, RSlice)), to: RWord }).out,
  );
  // The rest made in place where the view starts past the list's first item, sharing its trie and
  // counting what it copies by the items' type, the list then let go of by its type: nothing walks
  // the items by their header.
  assert(
    text.index_of(b"if (p0_1) {") != None && text.index_of(b"rt_list_rest_p") == None
      && lets_go_of(text, b"p0_0"),
    Some(String::of_bytes_lossy(text)),
  )
}
