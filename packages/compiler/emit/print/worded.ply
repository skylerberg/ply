//! Values held otherwise: a scalar boxed or read out of its word, a record or a sum made its word
//! form or opened out of it, a value of no words its word 0, a view of a list its list.

import syntax.parsing (span_between)
import check.types (TyCon)
import emit.layout (LWords, P, sum_laid, record_laid, raw)
import emit.tir (Rep, RWord, RFlat, RSum, RUnit, RSlice, Var, Arg, AVar, Data, rep_of_arg, rep_said)
import emit.pieces (Text, spelled)
import emit.print.text (Printing, Place, printing, named, pad, pieces, line, arg_text, part_names,
                        unprinted)
import emit.print.made (arg_parts, parts_word, word_parts, word_as, declared_as)

/// `k.arg` held as `k.to`: a scalar boxed, which takes it, or read out of its word, which borrows
/// it; a record or a sum made its word form, as `made.parts_word` makes it, or opened out of it, as
/// `made.word_parts` opens it, each taking it; a value of no words no value, or its word 0; a view of
/// a list its list from the view's offset.
pub fn worded(
  p: Place,
  pr: Printing,
  into: Option<Var>,
  k: { arg: Arg, to: Rep },
) -> Printing / {abort.raise} =
  match into {
    None ->
      unprinted(
        Data,
        b"a value held otherwise that nothing holds",
        Bytes::concat_all([rep_said(rep_of_arg(k.arg)), b" held as ", rep_said(k.to)]),
      ),
    Some(v) -> {
      let from = rep_of_arg(k.arg);
      let xs = arg_parts(pr, k.arg);
      if from == k.to { declared_as(p, pr, v, xs) } else {
        match k.to {
          RWord -> if from == RSlice { list_of_view(p, pr, v, xs) } else {
            let n = named(pr, v);
            let w = parts_word(n.pr, n.name, xs, from);
            if w.word == n.name {
              pieces(w.pr, [Text(pad(p.depth))].concat(w.prep).push(Text(b"\n")))
            } else {
              line(w.pr, p.depth, Bytes::concat_all([b"Word ", n.name, b" = ", w.word, b";"]))
            }
          },
          RUnit -> declared_as(p, pr, v, []),
          RFlat(_) -> opened(p, pr, v, from, k),
          RSum(_) -> opened(p, pr, v, from, k),
          // A scalar read out of a word borrows it: what holds the word lets it go.
          _ -> if from == RWord { declared_as(p, pr, v, [word_as(arg_text(pr, k.arg), k.to)]) }
          else { mismatched(from, k.to) },
        }
      }
    },
  }

/// `v`, a record or a sum, opened out of the word form `k.arg`, which it takes.
fn opened(
  p: Place,
  pr: Printing,
  v: Var,
  from: Rep,
  k: { arg: Arg, to: Rep },
) -> Printing / {abort.raise} =
  if from != RWord { mismatched(from, k.to) } else {
    let n = named(pr, v);
    pieces(
      n.pr,
      [Text(pad(p.depth))].concat(
        word_parts(arg_text(pr, k.arg), k.to, part_names(n.name, k.to)),
      ).push(
        Text(b"\n"),
      ),
    )
  }

/// `v`, a view's list from its offset on, sharing the list's trie: the list itself where the offset
/// is zero, whose count the view hands over, and otherwise a list of its own.
fn list_of_view(p: Place, pr: Printing, v: Var, xs: List<Bytes>) -> Printing = {
  let list = nth(xs, 0);
  let from_at = nth(xs, 1);
  let n = named(pr, v);
  line(
    n.pr,
    p.depth,
    Bytes::concat_all([
      b"Word ",
      n.name,
      b" = ",
      from_at,
      b" ? rt_list_rest_p(ctx, ",
      list,
      b", ",
      from_at,
      b") : ",
      list,
      b"; if (",
      from_at,
      b") ply_dec(ctx, ",
      list,
      b");",
    ]),
  )
}

fn mismatched(from: Rep, to: Rep) -> Printing / {abort.raise} =
  unprinted(
    Data,
    b"a value held as no type holds both, which the form never packs",
    Bytes::concat_all([rep_said(from), b" held as ", rep_said(to)]),
  )

fn nth(xs: List<Bytes>, k: Int) -> Bytes = match xs.at(k) { Some(x) -> x, None -> b"0" }

fn place() -> Place =
  {
    u: {
      symbol: b"f",
      base: 0,
      answer: RWord,
      site: None,
      arm: None,
      looping: None,
      landing: None,
      group: None,
    },
    at: span_between(0, 0),
    leave: b"return 0;",
    depth: 0,
  }

fn local(id: Int, rep: Rep) -> Var = { id: id, ty: TyCon({ name: b"T", args: [] }), rep: rep }

fn point() -> Rep = RFlat([{ name: b"x", rep: RWord }, { name: b"y", rep: RWord }])

test "a record's word form is a box made of its words, and a box opened is taken or its words counted again" {
  let pr = { ..printing(Map::new().insert(0, b"p0")), temps: 4 };
  let made_word = worded(place(), pr, Some(local(1, RWord)), {
    arg: AVar(local(0, point())),
    to: RWord,
  });
  assert_eq(
    spelled(made_word.out),
    b"  Word t5 = rt_alloc_bytes_p(ctx, INT64_C(32)); ply_words(t5)[0] = p0_0; ply_words(t5)[1] = p0_1;\n",
  );
  let opened_back = spelled(
    worded(place(), made_word, Some(local(2, point())), {
      arg: AVar(local(1, RWord)),
      to: point(),
    }).out,
  );
  assert(
    opened_back.index_of(
        b"Word t6_0 = ply_words(t5)[0]; Word t6_1 = ply_words(t5)[1]; Word t6_2 = 0; if (ply_last(ctx, t5)) ply_free(ctx, t5, INT64_C(32)); else { ply_dup(t6_0); ply_dup(t6_1); }\n",
      )
      != None,
    Some(String::of_bytes_lossy(opened_back)),
  )
}

test "a sum of one word is its word either way, and a value of no words is its word 0" {
  let one = RSum({
    laid: sum_laid([
      { args: record_laid([]), indirect: false },
      { args: record_laid([LWords([P])]), indirect: false },
    ]),
    cases: [b"None", b"Some"],
  });
  let pr = printing(Map::new().insert(0, b"p0"));
  assert_eq(
    spelled(
      worded(place(), pr, Some(local(1, RWord)), { arg: AVar(local(0, one)), to: RWord }).out,
    ),
    b"  Word t1 = p0;\n",
  );
  assert_eq(
    spelled(worded(place(), pr, Some(local(1, one)), { arg: AVar(local(0, RWord)), to: one }).out),
    b"  Word t1 = p0;\n",
  );
  assert_eq(
    spelled(
      worded(place(), pr, Some(local(1, RWord)), { arg: AVar(local(0, RUnit)), to: RWord }).out,
    ),
    b"  Word t1 = 0;\n",
  );
  // A sum wider than a word opened out of its box: its words, and no count where none is counted.
  let tagged = RSum({
    laid: sum_laid([
      { args: record_laid([]), indirect: false },
      { args: record_laid([LWords([raw()])]), indirect: false },
    ]),
    cases: [b"None", b"Some"],
  });
  assert_eq(
    spelled(
      worded(place(), pr, Some(local(1, tagged)), { arg: AVar(local(0, RWord)), to: tagged }).out,
    ),
    b"  Word t1_0 = ply_words(p0)[0]; Word t1_1 = ply_words(p0)[1]; Word t1_2 = 0; if (ply_last(ctx, p0)) ply_free(ctx, p0, INT64_C(32));\n",
  )
}

test "a view of a list from an offset is made the list of its rest where it leaves" {
  let pr = printing(Map::new().insert(0, b"p0"));
  assert_eq(
    spelled(
      worded(place(), pr, Some(local(1, RWord)), { arg: AVar(local(0, RSlice)), to: RWord }).out,
    ),
    b"  Word t1 = p0_1 ? rt_list_rest_p(ctx, p0_0, p0_1) : p0_0; if (p0_1) ply_dec(ctx, p0_0);\n",
  )
}
