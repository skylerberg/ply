//! What every C function the form prints does as it starts: spend a unit of fuel, make room below
//! the running stack where its frame is near the floor, and count a tick, through one helper the
//! head defines.

import emit.c (tick_line)
import emit.tir (Rep)
import emit.print.text (failing_return)

/// The head's C function a function's head calls: answers 0 where the function is to leave failed,
/// past its fuel, with no room to be had below the running stack or failed at a tick; otherwise
/// spends a unit of fuel and answers 1.
pub fn entered_fn() -> Bytes = b"ply_entered"

/// `entered_fn` for code crossing values to and from the runtime, which counts no tick: a program's
/// steps are the calls it makes, not the calls its values' crossing makes.
pub fn crossed_fn() -> Bytes = b"ply_crossed"

/// `entered_fn`'s and `crossed_fn`'s definitions. Inlined, its probe stands in the caller's frame;
/// called, one frame deeper, which only asks for room a frame sooner.
pub fn entered_helper() -> Bytes = {
  let defined = |name: Bytes, ticked: Bytes|
    Bytes::concat_all([
      b"static inline int ",
      name,
      b"(PlyCtx *ctx) {\n",
      b"  if (ctx->fuel <= 0) { rt_no_fuel_p(ctx); return 0; }\n",
      b"  { char probe; if ((uintptr_t)&probe < ctx->stack_floor && !rt_stack_more_p(ctx)) return 0; }\n",
      ticked,
      b"  ctx->fuel -= 1;\n",
      b"  return 1;\n",
      b"}\n",
    ]);
  defined(entered_fn(), Bytes::concat_all([b"  ", tick_line(b"return 0;"), b"\n"])).concat(
    defined(crossed_fn(), b""),
  )
}

/// The head of a function answering as `answer`: leaves as failed where `entered_fn` says so. The
/// call goes on in its own frame on the same stack.
pub fn fuel_head(answer: Rep) -> Bytes = head_through(entered_fn(), answer)

/// `fuel_head` of a function crossing values, which counts no tick.
pub fn crossed_head(answer: Rep) -> Bytes = head_through(crossed_fn(), answer)

fn head_through(f: Bytes, answer: Rep) -> Bytes =
  Bytes::concat_all([b"  if (!", f, b"(ctx)) ", failing_return(answer), b"\n"])
