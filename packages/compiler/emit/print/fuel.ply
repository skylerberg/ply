//! What every C function the form prints does as it starts: spend a unit of fuel and make room
//! below the running stack where its frame is near the floor. And what a loop does as it restarts:
//! probe the floor, which the runtime raises past every frame once the entry's clock runs out. Both
//! go through helpers the head defines.

import compiler.emit.tir (Rep)
import compiler.emit.print.text (failing_return)

/// The head's C function a function's head calls: answers 0 where the function is to leave failed,
/// past its fuel or with no room to be had below the running stack; otherwise spends a unit of fuel
/// and answers 1.
pub fn entered_fn() -> Bytes = b"ply_entered"

/// The head's C function a loop's restart calls: answers 0 where the loop is to leave failed, its
/// entry's clock spent; otherwise 1.
pub fn restarted_fn() -> Bytes = b"ply_restarted"

/// `entered_fn`'s and `restarted_fn`'s definitions, as macros, which tcc inlines as it inlines no
/// function: the probe stands in the caller's frame. Each reads `ctx`, which every use names.
pub fn entered_helper() -> Bytes =
  Bytes::concat_all([
    b"#define ",
    entered_fn(),
    b"(ctx) ({ \\\n",
    b"  char ply_probe; int ply_in = 0; \\\n",
    b"  do { \\\n",
    b"    if (ctx->fuel <= 0) { rt_no_fuel_p(ctx); break; } \\\n",
    b"    if ((uintptr_t)&ply_probe < ctx->stack_floor && !rt_stack_more_p(ctx)) break; \\\n",
    b"    ctx->fuel -= 1; ply_in = 1; \\\n",
    b"  } while (0); \\\n",
    b"  ply_in; })\n",
    b"#define ",
    restarted_fn(),
    b"(ctx) ({ \\\n",
    b"  char ply_probe; \\\n",
    b"  (uintptr_t)&ply_probe >= ctx->stack_floor || rt_stack_more_p(ctx); })\n",
  ])

/// The head of a function answering as `answer`: leaves as failed where `entered_fn` says so. The
/// call goes on in its own frame on the same stack.
pub fn fuel_head(answer: Rep) -> Bytes =
  Bytes::concat_all([b"  if (!", entered_fn(), b"(ctx)) ", failing_return(answer), b"\n"])

/// What a loop of a function answering as `answer` does as it restarts: leaves as failed where
/// `restarted_fn` says so.
pub fn restart_probe(answer: Rep) -> Bytes =
  Bytes::concat_all([b"if (!", restarted_fn(), b"(ctx)) ", failing_return(answer)])
