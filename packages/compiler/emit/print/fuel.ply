//! What every C function the form prints does as it starts: spend a unit of fuel, make room below
//! the running stack where its frame is near the floor, and count a tick, through one helper the
//! head defines.

import emit.c (tick_line)
import emit.tir (Rep)
import emit.print.text (failing_return)

/// The head's C function a function's head calls: answers 0 where the function is to leave failed,
/// past its fuel, with no room to be had below the running stack or failed at a tick; otherwise
/// spends a unit of fuel and answers 1.
pub fn entered_fn() -> Bytes = b"ply_entered"

/// `entered_fn`'s definition. Inlined, its probe stands in the caller's frame; called, one frame
/// deeper, which only asks for room a frame sooner.
pub fn entered_helper() -> Bytes =
  Bytes::concat_all([
    b"static inline int ",
    entered_fn(),
    b"(PlyCtx *ctx) {\n",
    b"  if (ctx->fuel <= 0) { rt_no_fuel_p(ctx); return 0; }\n",
    b"  { char probe; if ((uintptr_t)&probe < ctx->stack_floor && !rt_stack_more_p(ctx)) return 0; }\n",
    b"  ",
    tick_line(b"return 0;"),
    b"\n",
    b"  ctx->fuel -= 1;\n",
    b"  return 1;\n",
    b"}\n",
  ])

/// The head of a function answering as `answer`: leaves as failed where `entered_fn` says so. The
/// call goes on in its own frame on the same stack.
pub fn fuel_head(answer: Rep) -> Bytes =
  Bytes::concat_all([b"  if (!", entered_fn(), b"(ctx)) ", failing_return(answer), b"\n"])
