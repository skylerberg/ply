//! What every C function the form prints does as it starts: spend a unit of fuel, make room below
//! the running stack where its frame is near the floor, and count a tick.

import emit.c (tick_line)
import emit.tir (Rep)
import emit.print.text (failing_return)

/// The head of a function answering as `answer`: refuses a call past the fuel, has the runtime make
/// room below the running stack where this frame is near its floor and leaves as failed where none
/// is to be had, counts a tick and spends a unit of fuel. The call goes on in its own frame on the
/// same stack.
pub fn fuel_head(answer: Rep) -> Bytes =
  Bytes::concat_all([
    b"  if (ctx->fuel <= 0) { rt_no_fuel_p(ctx); ",
    failing_return(answer),
    b" }\n",
    b"  { char probe; if ((uintptr_t)&probe < ctx->stack_floor && !rt_stack_more_p(ctx)) ",
    failing_return(answer),
    b" }\n",
    b"  ",
    tick_line(failing_return(answer)),
    b"\n",
    b"  ctx->fuel -= 1;\n",
  ])
