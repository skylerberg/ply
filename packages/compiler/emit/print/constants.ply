pub const constant_read_fn: Bytes = b"ply_constant"

pub const const_read_fn: Bytes = b"ply_const"

pub const constant_helpers: Bytes =
  Bytes::concat_all([
    b"#if defined(__TINYC__) || !defined(__GNUC__)\n",
    b"#  define ply_load_acquire(p) (*(const volatile Word *)(p))\n",
    b"#else\n",
    b"#  define ply_load_acquire(p) __atomic_load_n((p), __ATOMIC_ACQUIRE)\n",
    b"#endif\n",
    b"extern void *const ply_code[];\n",
    b"Word ply_constant_made(PlyCtx *ctx, int64_t index, Word keep);\n",
    b"static inline Word ",
    constant_read_fn,
    b"(PlyCtx *ctx, int64_t index, Word keep) {\n",
    b"  Word kept = ply_load_acquire(&ctx->constants[index]);\n",
    b"  return kept ? kept : ply_constant_made(ctx, index, keep);\n",
    b"}\n",
    b"static inline Word ",
    const_read_fn,
    b"(PlyCtx *ctx, int64_t index, Word keep) {\n",
    b"  Word value = ",
    constant_read_fn,
    b"(ctx, index, keep);\n",
    b"  if (ctx->failed) rt_const_failed_p(ctx);\n",
    b"  return value;\n",
    b"}\n",
  ])

pub const constant_made: Bytes =
  Bytes::concat_all([
    b"Word ply_constant_made(PlyCtx *ctx, int64_t index, Word keep) {\n",
    b"  Word made = ((Word (*)(PlyCtx *, const Word *))ply_code[index])(ctx, 0);\n",
    b"  if (ctx->failed) return 0;\n",
    b"  Word kept = ((Word (*)(PlyCtx *, Word))(intptr_t)keep)(ctx, made);\n",
    b"  if (kept != 0 && !ctx->failed) rt_keep_constant_p(ctx, index, kept);\n",
    b"  return made;\n",
    b"}\n",
  ])
