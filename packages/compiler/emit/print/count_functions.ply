import std.bytes (ascii_of_int)

pub fn duplicate_function() -> Bytes = b"ply_dup"

pub fn last_function() -> Bytes = b"ply_last"

pub fn dup_marked_fn() -> Bytes = b"ply_dup_marked"

pub fn last_marked_fn() -> Bytes = b"ply_last_marked"

pub fn release_function() -> Bytes = b"ply_rel"

pub fn release_sum_function() -> Bytes = b"ply_rel_sum"

pub fn release_box_function() -> Bytes = b"ply_rel_box"

pub fn free_function() -> Bytes = b"ply_free"

pub fn identity_function() -> Bytes = b"ply_same_word"

pub fn empty_release_function() -> Bytes = b"ply_no_word"

pub fn box_duplicate_function() -> Bytes = b"ply_box_dup"

pub fn sized_box_release_function(words: Int) -> Bytes =
  b"ply_box_released_".concat(ascii_of_int(words))

pub fn never_lifted_function() -> Bytes = b"ply_never_lifted"

pub fn never_lifted_runtime_function() -> Bytes = b"rt_never_lifted_p"

pub fn never_shown_function() -> Bytes = b"ply_never_shown"

pub fn never_shown_runtime_function() -> Bytes = b"rt_never_shown_p"

pub fn handle_free_function() -> Bytes = b"rt_handle_free_p"

pub fn increment_shared_function() -> Bytes = b"rt_inc_shared_p"

pub fn decrement_shared_last_function() -> Bytes = b"rt_dec_shared_last_p"

pub fn runtime_free_function() -> Bytes = b"rt_free_p"

pub fn allocate_function() -> Bytes = b"ply_alloc"

pub fn allocate_block_function() -> Bytes = b"rt_alloc_bytes_p"

pub fn allocates(text: Bytes) -> Bool =
  calls(text, allocate_function()) || calls(text, allocate_block_function())
    || calls(text, b"rt_alloc_kept_p")

pub fn release_later_function() -> Bytes = b"rt_release_later_p"

pub fn drain_releases_function() -> Bytes = b"rt_release_drain_p"

pub fn released_twice_function() -> Bytes = b"rt_released_twice_p"

pub fn count_functions() -> List<Bytes> =
  [
    duplicate_function(),
    last_function(),
    release_function(),
    release_sum_function(),
    release_box_function(),
    free_function(),
    handle_free_function(),
  ]

pub fn call_text(f: Bytes, args: List<Bytes>) -> Bytes =
  Bytes::concat_all([f, b"(", Bytes::join(args, b", "), b")"])

pub fn call_start(f: Bytes, args: List<Bytes>) -> Bytes =
  Bytes::concat_all([f, b"("].concat(args.map(|a: Bytes| a.concat(b", "))))

pub fn calls(text: Bytes, f: Bytes) -> Bool = text.index_of(f.concat(b"(")) != None

pub fn counts_any(text: Bytes) -> Bool = count_functions().any(|f: Bytes| calls(text, f))

pub fn increments_count(text: Bytes) -> Bool = calls(text, duplicate_function())

pub fn calls_release(text: Bytes) -> Bool = release_functions().any(|f: Bytes| calls(text, f))

pub fn releases_word(text: Bytes, w: Bytes) -> Bool =
  release_functions().any(|f: Bytes|
    text.index_of(call_start(f, [b"ctx", w])) != None
      || text.index_of(call_text(f, [b"ctx", w])) != None)

fn release_functions() -> List<Bytes> =
  [last_function(), release_function(), release_sum_function(), release_box_function()]

test "a call is written as the function's name followed by its arguments, and generated C is recognized as calling a function only if it contains that exact call" {
  let rel = call_text(release_function(), [b"ctx", b"t1", b"d"]);
  assert_eq(rel, release_function().concat(b"(ctx, t1, d)"));
  assert_eq(call_start(release_function(), [b"ctx"]), release_function().concat(b"(ctx, "));
  assert_eq(call_start(free_function(), []), free_function().concat(b"("));
  let sum = Bytes::concat_all([
    b"x; ",
    call_text(release_sum_function(), [b"ctx", b"w", b"d"]),
    b";",
  ]);
  assert(calls(sum, release_sum_function()) && !calls(sum, release_function()));
  assert(counts_any(call_text(free_function(), [b"ctx", b"t1", b"32"])));
  assert(!counts_any(b"Word t1 = ply_words(p0)[0];"));
  assert(increments_count(call_text(duplicate_function(), [b"t1"])));
  assert(!increments_count(rel) && calls_release(rel));
  assert(!calls_release(call_text(duplicate_function(), [b"t1"])));
  assert(releases_word(rel, b"t1"));
  assert(!releases_word(call_text(release_function(), [b"ctx", b"t12", b"d"]), b"t1"))
}
