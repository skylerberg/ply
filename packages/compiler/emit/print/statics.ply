import std.bytes (first_offset, contains_bytes, ascii_of_int)
import compiler.emit.c (int_literal, c_string, escaped)
import compiler.emit.keys (RootKey, Named)
import compiler.emit.layout (MachineStruct, MachineField, head_structs)
import compiler.emit.abi (machine_structs)
import compiler.emit.print.unit_header (unit_header)
import compiler.emit.print.count_functions (duplicate_function, last_function, dup_marked_fn,
                                            last_marked_fn, increment_shared_function,
                                            decrement_shared_last_function)
import compiler.emit.typed_ir.statics (StaticDefinition, StaticHead, StaticBlock, StaticWords,
                                       StaticStruct, StaticFile, StaticWord, RawWord, AddressWord,
                                       EntryWord, BytesWord, FieldWord, PreludeWord, text_block,
                                       named_by_content)

pub fn static_extern(name: Bytes) -> Bytes =
  Bytes::concat_all([b"extern const struct ", name, b" ", name, b";\n"])

pub fn static_c(
  definition: StaticDefinition,
  field: (Bytes) -> Int / {abort.raise},
  entry: (RootKey) -> Bytes / {abort.raise},
  file: (Bytes) -> Bytes / {abort.raise},
) -> Bytes / {abort.raise} =
  match definition.layout {
    StaticBlock(b) ->
      object_definition(definition.name, header_members(definition.name, b.head), b.words, field),
    StaticWords(ws) -> object_definition(definition.name, [], ws, field),
    StaticStruct(s) -> struct_definition(definition.name, s.of, s.fields, field, entry),
    StaticFile(digest) -> {
      let t = text_block(file(digest));
      object_definition(definition.name, header_members(definition.name, t.head), t.words, field)
    },
  }

type Member = { declaration: Bytes, init: Bytes }

fn header_members(name: Bytes, head: Option<StaticHead>) -> List<Member> / {abort.raise} =
  [{ declaration: b"PlyObj h", init: b"{ .rc = UINT32_MAX }" }].concat(match head {
    None -> [],
    Some(h) -> [head_member(name, h)],
  })

fn head_member(name: Bytes, h: StaticHead) -> Member / {abort.raise} =
  match head_structs().find(|s: MachineStruct| s.name == h.of) {
    None -> rejected(name, b"has a header type that is not declared: ".concat(h.of)),
    Some(s) -> {
      h.fields.fold((), |_: Unit, f: { field: Bytes, value: Int }|
        if s.fields.any(|m: MachineField| m.name == f.field) { () } else {
          rejected(name, Bytes::concat_all([b"sets a field ", h.of, b" has not: ", f.field]))
        });
      {
        declaration: Bytes::concat_all([h.of, b" head"]),
        init: Bytes::concat_all([
          b"{ ",
          Bytes::join(
            h.fields.map(|f: { field: Bytes, value: Int }|
              Bytes::concat_all([b".", f.field, b" = ", ascii_of_int(f.value)])),
            b", ",
          ),
          b" }",
        ]),
      }
    },
  }

fn object_definition(
  name: Bytes,
  header: List<Member>,
  words: List<StaticWord>,
  field: (Bytes) -> Int / {abort.raise},
) -> Bytes / {abort.raise} = {
  let members = range(0, words.len()).fold(header, |accumulator: List<Member>, i: Int|
    match word_member(i, words.get(i), field) {
      Some(m) -> accumulator.push(m),
      None -> accumulator,
    });
  if members.len() == 0 { rejected(name, b"has no members") } else {
    static_struct(
      name,
      Bytes::join(members.map(|m: Member| m.declaration.concat(b";")), b" "),
      members.map(|m: Member| m.init),
    )
  }
}

fn word_member(
  i: Int,
  w: StaticWord,
  field: (Bytes) -> Int / {abort.raise},
) -> Option<Member> / {abort.raise} = {
  let named_w = b"w".concat(ascii_of_int(i));
  match w {
    RawWord(n) -> Some({ declaration: b"int64_t ".concat(named_w), init: int_literal(n) }),
    FieldWord(f) -> Some({ declaration: b"int64_t ".concat(named_w), init: int_literal(field(f)) }),
    AddressWord(a) ->
      Some({ declaration: b"const void *".concat(named_w), init: address(a.name, a.tag) }),
    BytesWord(b) -> if b.len() == 0 { None } else {
      Some({
        declaration: Bytes::concat_all([
          b"unsigned char ",
          named_w,
          b"[",
          ascii_of_int((b.len() + 7) / 8 * 8),
          b"]",
        ]),
        init: c_string(b),
      })
    },
    EntryWord(_) ->
      panic(
        "a static field cannot hold a program entry function, because no struct field has a function type",
      ),
    PreludeWord(_) ->
      panic(
        "a static field cannot hold a prelude function, because no struct field has a function type",
      ),
  }
}

pub fn word_c(w: StaticWord) -> Bytes / {abort.raise} =
  match w {
    RawWord(n) -> Bytes::concat_all([b"(Word)", int_literal(n)]),
    AddressWord(a) -> Bytes::concat_all([b"(Word)(intptr_t)(", address(a.name, a.tag), b")"]),
    _ -> panic("only an integer or an address can be written as a C expression in a static"),
  }

fn address(name: Bytes, tag: Int) -> Bytes =
  if tag == 0 { b"&".concat(name) }
  else { Bytes::concat_all([b"(const char *)&", name, b" + ", ascii_of_int(tag)]) }

fn struct_definition(
  name: Bytes,
  of: Bytes,
  values: List<StaticWord>,
  field: (Bytes) -> Int / {abort.raise},
  entry: (RootKey) -> Bytes / {abort.raise},
) -> Bytes / {abort.raise} =
  match machine_structs().find(|s: MachineStruct| s.name == of) {
    None -> rejected(name, b"the static uses a struct that has no declared layout: ".concat(of)),
    Some(s) -> if s.fields.len() != values.len() {
      rejected(name, b"the static does not have exactly one value per field of ".concat(of))
    } else {
      let parts = range(0, values.len()).map(|i: Int|
        field_value(name, s.fields.get(i), values.get(i), field, entry));
      Bytes::concat_all(
        parts.map(|p: { declared: Bytes, init: Bytes }| p.declared).push(
          Bytes::concat_all([
            b"const struct ",
            name,
            b" { ",
            s.name,
            b" s; } ",
            name,
            aligned(),
            b" = { {\n",
            Bytes::concat_all(
              parts.map(|p: { declared: Bytes, init: Bytes }|
                Bytes::concat_all([b"  ", p.init, b",\n"])),
            ),
            b"} };\n",
          ]),
        ),
      )
    },
  }

fn field_value(
  name: Bytes,
  f: MachineField,
  w: StaticWord,
  field: (Bytes) -> Int / {abort.raise},
  entry: (RootKey) -> Bytes / {abort.raise},
) -> { declared: Bytes, init: Bytes } / {abort.raise} = {
  let pointed = Bytes::concat_all([b"(*", f.name, b")"]);
  let cast = |e: Bytes| Bytes::concat_all([b"(", type_of_field(name, f), b")", e]);
  match w {
    RawWord(n) -> { declared: b"", init: cast(int_literal(n)) },
    FieldWord(x) -> { declared: b"", init: cast(int_literal(field(x))) },
    AddressWord(a) ->
      {
        declared: b"",
        init: cast(if a.tag == 0 { address(a.name, 0) }
        else { Bytes::concat_all([b"(", address(a.name, a.tag), b")"]) }),
      },
    EntryWord(k) -> match f.declaration.index_of(pointed) {
      None ->
        rejected(
          name,
          b"the static stores a program entry function in a field that is not a function type: ".concat(
            f.name,
          ),
        ),
      Some(at) -> {
        let symbol = entry(k);
        {
          declared: Bytes::concat_all([
            f.declaration.slice(0, at),
            symbol,
            f.declaration.slice(at + pointed.len(), f.declaration.len()),
            b";\n",
          ]),
          init: symbol,
        }
      },
    },
    PreludeWord(h) -> match f.declaration.index_of(pointed) {
      None ->
        rejected(
          name,
          b"the static stores a prelude function in a field that is not a function type: ".concat(
            f.name,
          ),
        ),
      Some(_) -> { declared: b"", init: h },
    },
    BytesWord(_) ->
      rejected(
        name,
        b"the static stores bytes in a struct field, which is not supported: ".concat(f.name),
      ),
  }
}

fn type_of_field(name: Bytes, f: MachineField) -> Bytes / {abort.raise} = {
  let pointed = Bytes::concat_all([b"(*", f.name, b")"]);
  match f.declaration.index_of(pointed) {
    Some(at) ->
      Bytes::concat_all([
        f.declaration.slice(0, at),
        b"(*)",
        f.declaration.slice(at + pointed.len(), f.declaration.len()),
      ]),
    None -> if f.declaration.ends_with(f.name) {
      let t = f.declaration.slice(0, f.declaration.len() - f.name.len());
      if t.ends_with(b" ") { t.slice(0, t.len() - 1) } else { t }
    } else {
      rejected(
        name,
        b"the static has a field that is not in the same order as the struct declaration: ".concat(
          f.name,
        ),
      )
    },
  }
}

fn aligned() -> Bytes = b" __attribute__((aligned(8)))"

fn static_struct(name: Bytes, declarations: Bytes, inits: List<Bytes>) -> Bytes =
  Bytes::concat_all([
    b"const struct ",
    name,
    b" { ",
    declarations,
    b" } ",
    name,
    aligned(),
    b" = {\n",
    Bytes::concat_all(inits.map(|i: Bytes| Bytes::concat_all([b"  ", i, b",\n"]))),
    b"};\n",
  ])

fn rejected<a>(name: Bytes, reason: Bytes) -> a / {abort.raise} =
  panic(String::of_bytes_lossy(Bytes::concat_all([b"static ", name, b" ", reason])))

fn no_fields(_: Bytes) -> Int = 0

fn no_entries(_: RootKey) -> Bytes = b""

fn no_files(_: Bytes) -> Bytes = b""

test "a static block starts with a reference count that is never freed, followed by its typed header struct with each field the struct names" {
  let s = static_c(
    named_by_content(StaticBlock(text_block(b"say \"hi\"?\n"))),
    no_fields,
    no_entries,
    no_files,
  );
  let output_text = Some(String::of_bytes_lossy(s));
  assert(
    contains_bytes(s, b"PlyObj h;") && contains_bytes(s, b"{ .rc = UINT32_MAX }"),
    output_text,
  );
  assert(
    contains_bytes(s, b"PlyTextHead head;") && contains_bytes(s, b"{ .len = 10, .room = 10 }"),
    output_text,
  );
  let unescaped_bytes = static_c(
    named_by_content(StaticWords([RawWord(7)])),
    no_fields,
    no_entries,
    no_files,
  );
  assert(
    !contains_bytes(unescaped_bytes, b"PlyObj"),
    Some(String::of_bytes_lossy(unescaped_bytes)),
  );
  let headless = static_c(
    named_by_content(StaticBlock({ head: None, words: [RawWord(7)] })),
    no_fields,
    no_entries,
    no_files,
  );
  assert(
    contains_bytes(headless, b"{ .rc = UINT32_MAX }") && !contains_bytes(headless, b" head;"),
    Some(String::of_bytes_lossy(headless)),
  );
  assert(contains_bytes(s, b"w0[16]") && contains_bytes(s, b"aligned(8)"), output_text);
  assert(
    !contains_bytes(
      static_c(named_by_content(StaticBlock(text_block(b""))), no_fields, no_entries, no_files),
      b"w0",
    ),
    None,
  )
}

test "a static's extern declaration includes its name, so other parts of the output can take its address" {
  let s = named_by_content(StaticBlock(text_block(b"x")));
  let e = static_extern(s.name);
  assert(
    contains_bytes(e, b"extern ") && contains_bytes(e, s.name),
    Some(String::of_bytes_lossy(e)),
  )
}

test "a C string literal leaves printable bytes unchanged and escapes quotes, backslashes, `?` and control bytes" {
  let e = escaped(b"a\"b\\c?\n\x01z");
  assert(contains_bytes(e, b"a") && contains_bytes(e, b"z"), Some(String::of_bytes_lossy(e)));
  let bare = range(0, e.len()).filter(|i: Int| {
    let b = e.at(i);
    let escaped_here = i > 0 && e.at(i - 1) == 92;
    b < 32 || b == 63 || (b == 34 && !escaped_here)
  });
  assert_eq(bare, []);
  assert(!contains_bytes(e, b"?"), None);
  assert_eq(c_string(b""), b"\"\"")
}

test "a word in a static is an integer, a field's value or an address, and an address with a tag is written as an offset from the static's address" {
  let c = static_c(
    named_by_content(
      StaticWords([
        RawWord(7),
        AddressWord({ name: b"ply_k_a", tag: 0 }),
        AddressWord({ name: b"ply_k_a", tag: 1 }),
        FieldWord(b"op"),
        RawWord(0 - 9223372036854775807 - 1),
      ]),
    ),
    |f: Bytes| if f == b"op" { 12 } else { 0 },
    no_entries,
    no_files,
  );
  let output_text = Some(String::of_bytes_lossy(c));
  assert(!contains_bytes(c, b"PlyObj"), output_text);
  assert(contains_bytes(c, b"int64_t w0;") && contains_bytes(c, b"const void *w1;"), output_text);
  assert(
    contains_bytes(c, int_literal(7)) && contains_bytes(c, b"&ply_k_a,")
      && contains_bytes(c, b"(const char *)&ply_k_a + 1"),
    output_text,
  );
  assert(
    contains_bytes(c, int_literal(12))
      && contains_bytes(c, int_literal(0 - 9223372036854775807 - 1)),
    output_text,
  )
}

test "an embedded file becomes a static byte string holding the file's contents, written as several C string literals" {
  let big = Bytes::concat_all(range(0, 4100).map(|i: Int| byte_of_int(97 + i % 26)));
  let c = static_c(
    { name: b"ply_k_f", layout: StaticFile(b"d1") },
    no_fields,
    no_entries,
    |d: Bytes| if d == b"d1" { big } else { b"" },
  );
  assert(contains_bytes(c, b".len = 4100, .room = 4100") && contains_bytes(c, b"w0[4104]"), None);
  assert_eq(c.split(b"\"\n  \"").len(), 3)
}

test "a static struct's fields are cast to their field types, and each function it points to is declared with its field's function type before the struct" {
  let c = static_c(
    named_by_content(
      StaticStruct({
        of: b"PlyType",
        fields: [
          RawWord(5),
          AddressWord({ name: b"ply_k_s", tag: 0 }),
          RawWord(3),
          EntryWord(Named(b"m.dup#T")),
          RawWord(0),
          RawWord(0),
          RawWord(0),
        ],
      }),
    ),
    no_fields,
    |_: RootKey| b"m_dup_T",
    no_files,
  );
  let output_text = Some(String::of_bytes_lossy(c));
  let declared = match c.index_of(b"m_dup_T(PlyCtx *, Word);") { Some(i) -> i, None -> 0 - 1 };
  let static_struct = match c.index_of(b"const struct ") { Some(i) -> i, None -> 0 - 1 };
  assert(
    declared >= 0 && declared < static_struct && contains_bytes(c, b"PlyType s;"),
    output_text,
  );
  assert(
    contains_bytes(c, b"(const uint8_t *)&ply_k_s")
      && contains_bytes(c, b"(Word (*)(PlyCtx *, Word))"),
    output_text,
  )
}

test "a static block whose words or header fields do not fit the declared struct layout is rejected with an error" {
  let abort_message = |d: StaticDefinition|
    handle {
      static_c(d, no_fields, no_entries, no_files);
      b""
    } with {
      abort.raise(m) -> Bytes::of_string(m),
    };
  assert(
    abort_message(
        named_by_content(
          StaticBlock({
            head: Some({ of: b"PlyTextHead", fields: [{ field: b"rc", value: 1 }] }),
            words: [RawWord(0)],
          }),
        ),
      ).len(
      )
      > 0,
    None,
  );
  assert(
    abort_message(
        named_by_content(
          StaticBlock({ head: Some({ of: b"PlyObj", fields: [] }), words: [RawWord(0)] }),
        ),
      ).len(
      )
      > 0,
    None,
  );
  assert(
    abort_message(named_by_content(StaticStruct({ of: b"PlyType", fields: [RawWord(0)] }))).len()
      > 0,
    None,
  );
  assert(abort_message(named_by_content(StaticWords([EntryWord(Named(b"m.f"))]))).len() > 0, None);
  assert(abort_message(named_by_content(StaticWords([]))).len() > 0, None)
}

test "the generated count functions never write the count of a static or frame block, so incrementing or releasing such a block does nothing" {
  let h = unit_header();
  let body = |name: Bytes| {
    let from = first_offset(h, Bytes::concat_all([b" ", name, b"("]));
    if from < 0 { b"" }
    else { match h.index_of_from(b"\n}\n", from) { Some(to) -> h.slice(from, to), None -> b"" } }
  };
  let leaves_marked = |name: Bytes, marked: Bytes, runtime: Bytes| {
    let plain = body(name);
    let rare = body(marked);
    let frame = first_offset(rare, b"PLY_RC_FRAME");
    contains_bytes(plain, marked) && first_offset(plain, b"UINT32_C(0x80000000)") > 0
      && first_offset(plain, b"UINT32_C(0x80000000)") < first_offset(plain, b"h->rc = ")
      && frame > 0
      && frame < first_offset(rare, runtime)
  };
  assert(leaves_marked(duplicate_function(), dup_marked_fn(), increment_shared_function()), None);
  assert(leaves_marked(last_function(), last_marked_fn(), decrement_shared_last_function()), None)
}

test "a word that a generated function returns is written as an integer, or as a static's address plus its tag" {
  assert(contains_bytes(word_c(RawWord(7)), int_literal(7)), None);
  assert(contains_bytes(word_c(AddressWord({ name: b"ply_k_a", tag: 0 })), b"&ply_k_a"), None);
  assert(contains_bytes(word_c(AddressWord({ name: b"ply_k_a", tag: 1 })), b"&ply_k_a + 1"), None)
}
