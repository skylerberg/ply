//! The words a body is handed for what its row says it performs, and how one body's words are made
//! of another's. A word answers an effect on one resource: one object of the effect answers every
//! operation of it there, so a row's atoms of one effect and resource take one word between them.
//! A row filled through a row variable keeps its own words apart from those written beside the
//! variable, even of one effect and resource: they may be answered by different objects.

import compiler.check.types (Atom, Row, Resource, NamedResource, SingletonResource,
                             ResourceVariable, AnyResource, Scheme, Type, FunctionType, NamedType,
                             atom_lt, resource_covers, fn_type, unit_type, row_empty)
import compiler.syntax.type_syntax (ReadMode)
import compiler.emit.keys (Evidence)
import compiler.emit.typed_ir (Var)
import std.bytes (ascii_of_int)

/// The type an evidence word is held at: an object's address, which holds no count.
pub fn evidence_type() -> Type = NamedType({ name: b"?evidence", args: [] })

/// The type the counted block of a heap instance is held at: a function's, whose descriptor's
/// release lets go of what the instance holds, so it is counted and let go as any closure is.
pub fn instance_block_type() -> Type = fn_type([], unit_type(), row_empty())

/// The type the array of a function's words is held at, where it takes them as one.
pub fn evidence_array_type() -> Type = NamedType({ name: evidence_array_name(), args: [] })

/// The type a root's array of its `n` words is held at, which says how many it reads.
pub fn evidence_array_of(n: Int) -> Type =
  NamedType({ name: evidence_array_name(), args: [NamedType({ name: ascii_of_int(n), args: [] })] })

/// How many words a root's array of type `t` holds, where `evidence_array_of` made it.
pub fn evidence_array_length(t: Type) -> Option<Int> / {abort.raise} =
  match t {
    NamedType(c) -> if c.name != evidence_array_name() { None }
    else { match c.args.at(0) { Some(NamedType(n)) -> n.name.int_of_ascii(), _ -> None } },
    _ -> None,
  }

fn evidence_array_name() -> Bytes = b"?evidence_words"

/// The type a row's static descriptor is held at, which a call by a function value's type hands it.
pub fn row_descriptor_type() -> Type = NamedType({ name: b"?row", args: [] })

/// Whether a value of type `t` is an evidence word, an array of them or a row's descriptor: what a
/// function is handed past its parameters for its row, which holds no count.
pub fn is_evidence(t: Type) -> Bool =
  t == evidence_type() || t == row_descriptor_type()
    || (match t { NamedType(c) -> c.name == evidence_array_name(), _ -> false })

/// How many of a root's `params` its definition declares: all but the words handed for its row,
/// which no caller by words, the runtime among them, hands.
pub fn declared_arity(params: List<Var>) -> Int = params.filter(|v: Var| !is_evidence(v.ty)).len()

/// How many words a function takes as parameters of their own; past that, it takes them as one
/// array.
pub fn max_evidence_params() -> Int = 4

/// How many parameters `n` words take.
pub fn evidence_param_count(n: Int) -> Int = if n <= max_evidence_params() { n } else { 1 }

/// Whether an object answers operations of effect `name`: divergence and a hold's region name none.
pub fn needs_evidence(name: Bytes) -> Bool = name != b"diverges" && name != b"hold"

fn as_atom(w: Evidence) -> Atom =
  { effect: w.effect, resource: w.resource, mode: ReadMode, op: None }

/// Whether `a` stands before `b` among a row's words.
pub fn precedes(a: Evidence, b: Evidence) -> Bool = atom_lt(as_atom(a), as_atom(b))

/// `xs` in the order of what `by` says each answers, those alike in the order they stand.
pub fn sorted_by_evidence<a>(xs: List<a>, by: (a) -> Evidence) -> List<a> =
  xs.fold([], |out: List<a>, x: a| {
    let at = out.filter(|y: a| !precedes(by(x), by(y))).len();
    out.take(at).push(x).concat(out.drop(at))
  })

/// The words the atoms `atoms` take: one for each effect and resource an atom of an answered effect
/// names, in order.
pub fn evidence_for_atoms(atoms: List<Atom>) -> List<Evidence> =
  sorted_by_evidence(
    atoms.fold([], |ws: List<Evidence>, a: Atom|
      if !needs_evidence(a.effect) { ws } else {
        let w = { effect: a.effect, resource: a.resource };
        if ws.contains(w) { ws } else { ws.push(w) }
      }),
    |w: Evidence| w,
  )

/// Whether a word answering `have` answers what `want` stands for: one effect, on a resource it
/// covers.
pub fn covers(have: Evidence, want: Evidence) -> Bool =
  have.effect == want.effect && resource_covers(have.resource, want.resource)

/// A key's row read in the numbering of the definition it specialises, which has `labels` label
/// parameters of its own: the key's `k`th label is that definition's label `labels + k`.
pub fn offset_labels(row: List<Evidence>, labels: Int) -> List<Evidence> =
  row.map(|w: Evidence|
    match w.resource {
      ResourceVariable(k) -> { ..w, resource: ResourceVariable(labels + k) },
      _ -> w,
    })

/// How many labels of its caller's a specialisation at `rows` is handed beside its words.
pub fn passed_label_count(rows: List<List<Evidence>>) -> Int =
  rows.fold(0, |n: Int, r: List<Evidence>|
    r.fold(n, |m: Int, w: Evidence|
      match w.resource { ResourceVariable(k) -> if k + 1 > m { k + 1 } else { m }, _ -> m }))

/// A word of a key's row, and its place in the row it was keyed from.
pub type KeyedEvidence = { key: Evidence, from: Int }

/// Rows a caller hands a callee words for, in the caller's numbering, as the callee's key holds
/// them: each label variable of the caller's the `k`th label it hands, in the order they first
/// stand, each row then in order; and which of the caller's label variables each label is.
pub fn renumber_labels(
  rows: List<List<Evidence>>,
) -> { rows: List<List<KeyedEvidence>>, sources: List<Int> } / {abort.raise} =
  rows.fold(
    { rows: [], sources: [] },
    |acc: { rows: List<List<KeyedEvidence>>, sources: List<Int> }, r: List<Evidence>| {
      let done = range(0, r.len()).fold(
        { row: [], sources: acc.sources },
        |inner: { row: List<KeyedEvidence>, sources: List<Int> }, i: Int| {
          let w = r.get(i);
          match w.resource {
            ResourceVariable(p) -> {
              let had = range(0, inner.sources.len()).fold(None, |found: Option<Int>, j: Int|
                if found == None && inner.sources.at(j) == Some(p) { Some(j) } else { found });
              match had {
                Some(k) ->
                  {
                    ..inner,
                    row: inner.row.push({ key: { ..w, resource: ResourceVariable(k) }, from: i }),
                  },
                None ->
                  {
                    row: inner.row.push({
                      key: { ..w, resource: ResourceVariable(inner.sources.len()) },
                      from: i,
                    }),
                    sources: inner.sources.push(p),
                  },
              }
            },
            _ -> { ..inner, row: inner.row.push({ key: w, from: i }) },
          }
        },
      );
      {
        rows: acc.rows.push(sorted_by_evidence(done.row, |k: KeyedEvidence| k.key)),
        sources: done.sources,
      }
    },
  )

/// The rows of a key `renumber_labels` made.
pub fn key_rows_of(rows: List<List<KeyedEvidence>>) -> List<List<Evidence>> =
  rows.map(|r: List<KeyedEvidence>| r.map(|k: KeyedEvidence| k.key))

/// The row scheme `s` says its definition performs, as `in_scheme` reads it.
pub fn declared_row(s: Scheme) -> Row =
  match s.ty { FunctionType(f) -> in_scheme(s, f.effects), _ -> { atoms: [], tail: None } }

/// `row`, written in scheme `s`, read as the checker files a row in the definition's own numbering:
/// a label variable as its place among the scheme's label variables, the row variable it ends in as
/// its place among its row variables.
pub fn in_scheme(s: Scheme, row: Row) -> Row =
  {
    atoms: row.atoms.map(|a: Atom|
      match a.resource {
        ResourceVariable(v) -> { ..a, resource: ResourceVariable(index_in(s.label_vars, v)) },
        _ -> a,
      }),
    tail: match row.tail { Some(v) -> Some(index_in(s.row_vars, v)), None -> None },
  }

/// `v`'s place among `vs`, or `-1`.
fn index_in(vs: List<Int>, v: Int) -> Int =
  range(0, vs.len()).fold(0 - 1, |found: Int, i: Int|
    if found < 0 && vs.at(i) == Some(v) { i } else { found })

/// A word of a row and whether it came through the row variable the row ends in, which no `handle`
/// of the body answers.
pub type RowEvidence = { evidence: Evidence, through: Bool }

/// The words a row in a body's numbering takes, the body's row variables at `rows` and with
/// `labels` label parameters of its own, in the order a body of that row takes them: its atoms',
/// and those its row variable holds, through it, each apart from its atoms' alike ones and after.
pub fn row_evidence(row: Row, rows: List<List<Evidence>>, labels: Int) -> List<RowEvidence> =
  sorted_by_evidence(
    evidence_for_atoms(row.atoms).map(|e: Evidence| { evidence: e, through: false }).concat(
      match row.tail {
        Some(t) -> match rows.at(t) {
          Some(r) -> offset_labels(r, labels).map(|e: Evidence| { evidence: e, through: true }),
          None -> [],
        },
        None -> [],
      },
    ),
    |o: RowEvidence| o.evidence,
  )

test "a row's words are one per effect and resource of an answered effect, in order" {
  let atom = |e: Bytes, op: Bytes, r: Resource|
    { effect: e, resource: r, mode: ReadMode, op: Some(op) };
  let ws = evidence_for_atoms([
    atom(b"m.log", b"note", SingletonResource),
    atom(b"diverges", b"x", SingletonResource),
    atom(b"m.log", b"put", SingletonResource),
    atom(b"m.net", b"send", NamedResource(b"conn")),
    atom(b"abort", b"raise", SingletonResource),
    atom(b"m.net", b"send", ResourceVariable(0)),
  ]);
  assert_eq(ws, [
    { effect: b"abort", resource: SingletonResource },
    { effect: b"m.log", resource: SingletonResource },
    { effect: b"m.net", resource: NamedResource(b"conn") },
    { effect: b"m.net", resource: ResourceVariable(0) },
  ])
}

test "a caller's labels are numbered as the callee's key holds them, once each, in the order they stand" {
  let w = |r: Resource| { effect: b"m.net", resource: r };
  let k = renumber_labels([
    [w(NamedResource(b"a")), w(ResourceVariable(3))],
    [w(ResourceVariable(1)), w(ResourceVariable(3))],
  ]);
  // Each row is in its key's order, which names a label by when it first stood.
  assert_eq(key_rows_of(k.rows), [
    [w(NamedResource(b"a")), w(ResourceVariable(0))],
    [w(ResourceVariable(0)), w(ResourceVariable(1))],
  ]);
  assert_eq(k.rows.map(|r: List<KeyedEvidence>| r.map(|x: KeyedEvidence| x.from)), [
    [0, 1],
    [1, 0],
  ]);
  assert_eq(k.sources, [3, 1]);
  assert_eq(passed_label_count(key_rows_of(k.rows)), 2);
  // Opened in a callee of one label of its own, the key's labels follow it.
  assert_eq(offset_labels([w(ResourceVariable(1))], 1), [w(ResourceVariable(2))])
}

test "words through a row variable stand apart from the row's own, alike ones in the order they came" {
  let log = { effect: b"m.log", resource: SingletonResource };
  let row = {
    atoms: [{ effect: b"m.log", resource: SingletonResource, mode: ReadMode, op: Some(b"note") }],
    tail: Some(0),
  };
  assert_eq(row_evidence(row, [[log, { effect: b"abort", resource: SingletonResource }]], 0), [
    { evidence: { effect: b"abort", resource: SingletonResource }, through: true },
    { evidence: log, through: false },
    { evidence: log, through: true },
  ]);
  assert_eq(
    covers({ effect: b"m.net", resource: AnyResource }, {
      effect: b"m.net",
      resource: ResourceVariable(0),
    }),
    true,
  );
  assert_eq(
    covers({ effect: b"m.net", resource: NamedResource(b"a") }, {
      effect: b"m.net",
      resource: ResourceVariable(0),
    }),
    false,
  )
}
