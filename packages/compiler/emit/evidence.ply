import compiler.check.types (Effect, Effects, Resource, NamedResource, SingletonResource,
                             ResourceVariable, AnyResource, Scheme, Type, FunctionType, NamedType,
                             effect_lt, resource_covers, function_type, unit_type, no_effects)
import compiler.syntax.type_syntax (ReadMode)
import compiler.emit.keys (Evidence)
import compiler.emit.typed_ir (Variable)
import std.bytes (ascii_of_int)

pub fn evidence_type() -> Type = NamedType({ name: b"?evidence", args: [] })

pub fn instance_block_type() -> Type = function_type([], unit_type(), no_effects())

pub fn evidence_array_type() -> Type = NamedType({ name: evidence_array_name(), args: [] })

pub fn evidence_array_of(n: Int) -> Type =
  NamedType({ name: evidence_array_name(), args: [NamedType({ name: ascii_of_int(n), args: [] })] })

pub fn evidence_array_length(t: Type) -> Option<Int> / {abort.raise} =
  match t {
    NamedType(c) -> if c.name != evidence_array_name() { None }
    else { match c.args.at(0) { Some(NamedType(n)) -> n.name.int_of_ascii(), _ -> None } },
    _ -> None,
  }

fn evidence_array_name() -> Bytes = b"?evidence_words"

pub fn effects_descriptor_type() -> Type = NamedType({ name: b"?row", args: [] })

pub fn is_evidence(t: Type) -> Bool =
  t == evidence_type() || t == effects_descriptor_type()
    || (match t { NamedType(c) -> c.name == evidence_array_name(), _ -> false })

pub fn declared_arity(params: List<Variable>) -> Int =
  params.filter(|v: Variable| !is_evidence(v.ty)).len()

pub fn max_evidence_params() -> Int = 4

pub fn evidence_param_count(n: Int) -> Int = if n <= max_evidence_params() { n } else { 1 }

pub fn needs_evidence(name: Bytes) -> Bool = name != b"diverges" && name != b"scoped"

fn as_effect(w: Evidence) -> Effect =
  { effect: w.effect, resource: w.resource, mode: ReadMode, operation: None }

pub fn precedes(a: Evidence, b: Evidence) -> Bool = effect_lt(as_effect(a), as_effect(b))

pub fn sorted_by_evidence<a>(xs: List<a>, by: (a) -> Evidence) -> List<a> =
  xs.fold([], |out: List<a>, x: a| {
    let at = out.filter(|y: a| !precedes(by(x), by(y))).len();
    out.take(at).push(x).concat(out.drop(at))
  })

pub fn evidence_for_effects(effects: List<Effect>) -> List<Evidence> =
  sorted_by_evidence(
    effects.fold([], |ws: List<Evidence>, a: Effect|
      if !needs_evidence(a.effect) { ws } else {
        let w = { effect: a.effect, resource: a.resource };
        if ws.contains(w) { ws } else { ws.push(w) }
      }),
    |w: Evidence| w,
  )

pub fn covers(have: Evidence, want: Evidence) -> Bool =
  have.effect == want.effect && resource_covers(have.resource, want.resource)

pub fn offset_labels(effects: List<Evidence>, labels: Int) -> List<Evidence> =
  effects.map(|w: Evidence|
    match w.resource {
      ResourceVariable(k) -> { ..w, resource: ResourceVariable(labels + k) },
      _ -> w,
    })

pub fn passed_label_count(effect_evidence: List<List<Evidence>>) -> Int =
  effect_evidence.fold(0, |n: Int, r: List<Evidence>|
    r.fold(n, |m: Int, w: Evidence|
      match w.resource { ResourceVariable(k) -> if k + 1 > m { k + 1 } else { m }, _ -> m }))

pub type KeyedEvidence = { key: Evidence, from: Int }

pub fn renumber_labels(
  effect_evidence: List<List<Evidence>>,
) -> { effect_evidence: List<List<KeyedEvidence>>, sources: List<Int> } / {abort.raise} =
  effect_evidence.fold(
    { effect_evidence: [], sources: [] },
    |accumulator: { effect_evidence: List<List<KeyedEvidence>>, sources: List<Int> }, r: List<Evidence>| {
      let done = range(0, r.len()).fold(
        { evidence: [], sources: accumulator.sources },
        |inner: { evidence: List<KeyedEvidence>, sources: List<Int> }, i: Int| {
          let w = r.get(i);
          match w.resource {
            ResourceVariable(p) -> {
              let had = range(0, inner.sources.len()).fold(None, |found: Option<Int>, j: Int|
                if found == None && inner.sources.at(j) == Some(p) { Some(j) } else { found });
              match had {
                Some(k) ->
                  {
                    ..inner,
                    evidence: inner.evidence.push({
                      key: { ..w, resource: ResourceVariable(k) },
                      from: i,
                    }),
                  },
                None ->
                  {
                    evidence: inner.evidence.push({
                      key: { ..w, resource: ResourceVariable(inner.sources.len()) },
                      from: i,
                    }),
                    sources: inner.sources.push(p),
                  },
              }
            },
            _ -> { ..inner, evidence: inner.evidence.push({ key: w, from: i }) },
          }
        },
      );
      {
        effect_evidence: accumulator.effect_evidence.push(
          sorted_by_evidence(done.evidence, |k: KeyedEvidence| k.key),
        ),
        sources: done.sources,
      }
    },
  )

pub fn key_effects_of(effect_evidence: List<List<KeyedEvidence>>) -> List<List<Evidence>> =
  effect_evidence.map(|r: List<KeyedEvidence>| r.map(|k: KeyedEvidence| k.key))

pub fn declared_effects(s: Scheme) -> Effects =
  match s.ty { FunctionType(f) -> in_scheme(s, f.effects), _ -> { listed: [], variable: None } }

pub fn in_scheme(s: Scheme, effects: Effects) -> Effects =
  {
    listed: effects.listed.map(|a: Effect|
      match a.resource {
        ResourceVariable(v) -> { ..a, resource: ResourceVariable(index_in(s.label_variables, v)) },
        _ -> a,
      }),
    variable: match effects.variable {
      Some(v) -> Some(index_in(s.effect_variables, v)),
      None -> None,
    },
  }

fn index_in(vs: List<Int>, v: Int) -> Int =
  range(0, vs.len()).fold(0 - 1, |found: Int, i: Int|
    if found < 0 && vs.at(i) == Some(v) { i } else { found })

pub type EffectsEvidence = { evidence: Evidence, from_variable: Bool }

pub fn effects_evidence(
  effects: Effects,
  effect_evidence: List<List<Evidence>>,
  labels: Int,
) -> List<EffectsEvidence> =
  sorted_by_evidence(
    evidence_for_effects(effects.listed).map(|e: Evidence|
      { evidence: e, from_variable: false }).concat(match effects.variable {
      Some(t) -> match effect_evidence.at(t) {
        Some(r) -> offset_labels(r, labels).map(|e: Evidence| { evidence: e, from_variable: true }),
        None -> [],
      },
      None -> [],
    }),
    |o: EffectsEvidence| o.evidence,
  )

test "effect evidence has one entry per effect and resource of the handled effects, each listed once, in sorted order" {
  let entry = |e: Bytes, operation: Bytes, r: Resource|
    { effect: e, resource: r, mode: ReadMode, operation: Some(operation) };
  let ws = evidence_for_effects([
    entry(b"m.log", b"note", SingletonResource),
    entry(b"diverges", b"x", SingletonResource),
    entry(b"m.log", b"put", SingletonResource),
    entry(b"m.net", b"send", NamedResource(b"conn")),
    entry(b"abort", b"raise", SingletonResource),
    entry(b"m.net", b"send", ResourceVariable(0)),
  ]);
  assert_eq(ws, [
    { effect: b"abort", resource: SingletonResource },
    { effect: b"m.log", resource: SingletonResource },
    { effect: b"m.net", resource: NamedResource(b"conn") },
    { effect: b"m.net", resource: ResourceVariable(0) },
  ])
}

test "`renumber_labels` renumbers a caller's resource variables from 0, in order of first appearance, giving each distinct label one number" {
  let w = |r: Resource| { effect: b"m.net", resource: r };
  let k = renumber_labels([
    [w(NamedResource(b"a")), w(ResourceVariable(3))],
    [w(ResourceVariable(1)), w(ResourceVariable(3))],
  ]);
  assert_eq(key_effects_of(k.effect_evidence), [
    [w(NamedResource(b"a")), w(ResourceVariable(0))],
    [w(ResourceVariable(0)), w(ResourceVariable(1))],
  ]);
  assert_eq(k.effect_evidence.map(|r: List<KeyedEvidence>| r.map(|x: KeyedEvidence| x.from)), [
    [0, 1],
    [1, 0],
  ]);
  assert_eq(k.sources, [3, 1]);
  assert_eq(passed_label_count(key_effects_of(k.effect_evidence)), 2);
  assert_eq(offset_labels([w(ResourceVariable(1))], 1), [w(ResourceVariable(2))])
}

test "`effects_evidence` marks entries that come from the effect variable separately from the listed effects, and equal entries keep their order" {
  let log = { effect: b"m.log", resource: SingletonResource };
  let effects = {
    listed: [
      { effect: b"m.log", resource: SingletonResource, mode: ReadMode, operation: Some(b"note") },
    ],
    variable: Some(0),
  };
  assert_eq(
    effects_evidence(effects, [[log, { effect: b"abort", resource: SingletonResource }]], 0),
    [
      { evidence: { effect: b"abort", resource: SingletonResource }, from_variable: true },
      { evidence: log, from_variable: false },
      { evidence: log, from_variable: true },
    ],
  );
  assert_eq(
    covers({ effect: b"m.net", resource: AnyResource }, {
      effect: b"m.net",
      resource: ResourceVariable(0),
    }),
    true,
  );
  assert_eq(
    covers({ effect: b"m.net", resource: NamedResource(b"a") }, {
      effect: b"m.net",
      resource: ResourceVariable(0),
    }),
    false,
  )
}
