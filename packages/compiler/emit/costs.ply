import compiler.syntax.parsing (Span, span_bin, span_between)
import compiler.emit.code (Code, CodeLiteral, CodeVariable, NDefinition, NConstructor, NBuiltin,
                           CodeUnary, CodeBinary, CodeApply, CodeIf, CodeBlock, CodeList,
                           CodeRecord, CodeMatch, CodePerform, CodeLambda, CodeSimulate,
                           CodeParallel, CodeHandle, CodeFieldRead, CodeUpdate, CodeKnownLambda,
                           CodeLabel, CodeStatement, CodeLet, CodeLetDestructure, CodeDo, CodeArm,
                           CodeField, CodeClause, Capture, pattern_slots)
import compiler.emit.moves (Moves, no_moves, read_moved, capture_moved, field_moved, root_moves)
import compiler.emit.lower.module_context (ModuleContext, ItemRoot, module_contexts_in)
import compiler.check.infer.definitions (Extern, parsed_natives)
import compiler.syntax.items (Item, FunctionItem, TestItem, LawItem, FnDefinition, ReturnsFresh,
                              ReturnsParam)
import compiler.syntax.expressions (Param, prelude_own)
import compiler.expand.embed (ModuleEmbed, embed_tables, inline_embeds_by_name)
import compiler.check.resolve.tables (ParsedModule, Resolution, qualify)
import compiler.check.infer.checker (Builtin, builtins, WitnessOrder)
import compiler.check.infer (CheckOutput)
import compiler.check.typed (witness_param_name)
import compiler.front.facts (Analysis)
import compiler.front.rows (Rows)
import compiler.front.emitter_input (InferredFacts, Analysed, Rejected)
import compiler.front.published (analyse, rows_of, inferred_facts)
import compiler.front.exports (ItemAt)
import compiler.check.callbacks (CallbackArgument, Element, Accumulator, ExtractedFrom, Number,
                                 UnknownArgument, Folded, prelude_callback_use)
import compiler.front.diagnostics (parse_all)
import std.bin
import std.list
import std.bytes (ascii_of_int)

pub type Cause =
  | ReadAgain
  | MapEntry
  | CapturedValue
  | CallerRetains
  | ContainerElement
  | TopLevelValue
  | CallResult
  | HandlerResult
  | ClosureParam

pub type Reason = { cause: Cause, text: Bytes }

pub type Owner = | FreshOwner | ParamOwner(Int) | SharedOwner(Reason) | UnknownOwner(Reason)

pub type ParamSharing = | SoleParam | UnsureParam(Reason) | SharedParam(Reason)

pub type ReturnOwnership =
  | FreshReturn
  | ReturnOfParam(Int)
  | SharedReturn(Reason)
  | UnsureReturn(Reason)

type Tables = { rets: List<ReturnOwnership> }

type Bind = { slot: Int, owner: Owner }

type PassedArgument = { callee: Int, param: Int, owner: Owner }

pub type RawSite = { span: Span, builtin_name: Bytes, owner: Owner }

type ReturnRead = { callee: Int, return_ownership: ReturnOwnership }

type CostState = {
  chain: List<Bind>,
  sites: List<RawSite>,
  demands: List<PassedArgument>,
  escaped: List<Int>,
  reads: List<ReturnRead>,
}

pub type Demand = { callee: Bytes, param: Int, owner: Owner }

pub type Escape = { callee: Bytes, arity: Int }

pub type WalkedBody = {
  item_kind: Bytes,
  module_name: Bytes,
  name: Bytes,
  label: Bytes,
  definition: Option<Bytes>,
  reuse: Option<Span>,
  sites: List<RawSite>,
  demands: List<Demand>,
  escaped: List<Escape>,
  returned: ReturnOwnership,
}

pub type DeclaredReturn = {
  module_name: Bytes,
  definition: Bytes,
  params: List<Bytes>,
  declared: ReturnOwnership,
  span: Span,
}

pub type GroupWalk = { ok: Bool, bodies: List<WalkedBody>, declared: List<DeclaredReturn> }

pub type BodyDemands = {
  caller: Option<Bytes>,
  label: Bytes,
  escaped: List<Escape>,
  demands: List<Demand>,
}

pub type ModuleDemands = { ok: Bool, bodies: List<BodyDemands> }

pub type ParamTable = Map<Bytes, Map<Int, ParamSharing>>

pub type Parameters = { table: Map<Bytes, Map<Int, ParamSharing>>, rounds: Int }

derive bin for Cause
derive bin for Reason
derive bin for Owner
derive bin for ParamSharing
derive bin for ReturnOwnership
derive bin for RawSite
derive bin for Demand
derive bin for Escape
derive bin for WalkedBody
derive bin for DeclaredReturn
derive bin for GroupWalk
derive bin for BodyDemands
derive bin for ModuleDemands
derive bin for Parameters

type WithOwner = { state: CostState, owner: Owner }

type Arms = { state: CostState, owner: Option<Owner> }

type Args = { state: CostState, owners: List<Owner> }

type Definition = {
  name: Bytes,
  module_name: Bytes,
  params: List<Bytes>,
  arity: Int,
  own: Bool,
  declared_return: Option<{ return_type: ReturnOwnership, span: Span }>,
}

type Body = {
  item_kind: Bytes,
  module: Int,
  module_name: Bytes,
  name: Bytes,
  label: Bytes,
  definition_index: Int,
  arity: Int,
  code: Code,
  moves: Moves,
  reuse: Option<Span>,
}

type WalkResult = {
  sites: List<RawSite>,
  demands: List<PassedArgument>,
  used_as_values: List<Int>,
  return_owner: Owner,
  reads: List<ReturnRead>,
}

type Program = {
  index: Map<Bytes, Int>,
  builtins: Map<Bytes, Bool>,
  definitions: List<Definition>,
  bodies: List<Body>,
}

type Env = { prog: Program, module: Int, tables: Tables, moves: Moves }

fn blocked(cause: Cause, text: Bytes) -> Owner = SharedOwner({ cause: cause, text: text })

fn unknown(cause: Cause, text: Bytes) -> Owner = UnknownOwner({ cause: cause, text: text })

fn reworded(reason: Reason, text: Bytes) -> Reason = { cause: reason.cause, text: text }

fn fresh(state: CostState) -> WithOwner = { state: state, owner: FreshOwner }

fn element_owner() -> Owner =
  blocked(
    ContainerElement,
    b"an element of the list being iterated over, which the list still owns",
  )

fn owner_at(xs: List<Owner>, i: Int) -> Owner = match xs.at(i) { Some(o) -> o, None -> FreshOwner }

fn owner_of(state: CostState, slot: Int) -> Option<Owner> =
  state.chain.fold(None, |accumulator: Option<Owner>, b: Bind|
    if b.slot == slot { Some(b.owner) } else { accumulator })

fn bind(state: CostState, slot: Int, owner: Owner) -> CostState =
  { ..state, chain: state.chain.push({ slot: slot, owner: owner }) }

fn rebind(state: CostState, slot: Int, owner: Owner) -> CostState =
  {
    ..state,
    chain: state.chain.map(|b: Bind| if b.slot == slot { { slot: slot, owner: owner } } else { b }),
  }

fn add_site(state: CostState, span: Span, operation: Bytes, owner: Owner) -> CostState =
  { ..state, sites: state.sites.push({ span: span, builtin_name: operation, owner: owner }) }

fn add_demand(state: CostState, d: PassedArgument) -> CostState =
  { ..state, demands: state.demands.push(d) }

fn add_escaped(state: CostState, d: Int) -> CostState = { ..state, escaped: state.escaped.push(d) }

fn with_chain(state: CostState, chain: List<Bind>) -> CostState = { ..state, chain: chain }

fn walk(env: Env, c: Code, state: CostState) -> WithOwner / {abort.raise} =
  match c.node {
    CodeLiteral(_) -> fresh(state),
    CodeLabel(_) -> fresh(state),
    CodeVariable(v) -> variable_owner(env, v.name, v.slot, read_moved(env.moves, c.span), state),
    NDefinition(_) -> global_read(env, c, state),
    NConstructor(_) -> global_read(env, c, state),
    NBuiltin(_) -> global_read(env, c, state),
    CodeUnary(u) -> fresh(walk(env, u.operand, state).state),
    CodeBinary(b) ->
      fresh(walk(env, b.right_operand, walk(env, b.left_operand, state).state).state),
    CodeLambda(l) ->
      fresh(
        mark_captured_shared(
          env,
          walk_nested_body(env, l.params, [], l.body, state),
          l.captures,
          l.body,
          l.at,
        ),
      ),
    CodeParallel(parallel_code) ->
      fresh(parallel_code.branches.fold(state, |s: CostState, b: Code| walk(env, b, s).state)),
    CodeApply(a) -> app(env, c.span, a.function, a.args, state),
    CodeKnownLambda(k) -> variable_owner(env, k.name, k.slot, read_moved(env.moves, c.span), state),
    CodeIf(i) -> {
      let t = walk(env, i.then_branch, walk(env, i.cond, state).state);
      let e = walk(env, i.else_branch, t.state);
      { state: e.state, owner: join(t.owner, e.owner) }
    },
    CodeMatch(m) -> {
      let scrutinee = walk(env, m.scrutinee, state);
      let arms = m.arms.fold(
        { state: scrutinee.state, owner: None },
        |accumulator: Arms, a: CodeArm| {
          let bound = pattern_slots(a.pattern).fold(accumulator.state, |s: CostState, slot: Int|
            bind(s, slot, scrutinee.owner));
          let guarded = match a.guard { Some(g) -> walk(env, g, bound).state, None -> bound };
          let w = walk(env, a.body, guarded);
          {
            state: w.state,
            owner: Some(match accumulator.owner {
              None -> w.owner,
              Some(previous_owner) -> join(previous_owner, w.owner),
            }),
          }
        },
      );
      { state: arms.state, owner: match arms.owner { Some(o) -> o, None -> FreshOwner } }
    },
    CodeBlock(b) -> {
      let s = b.statements.fold(state, |accumulator: CostState, statement: CodeStatement|
        match statement {
          CodeLet(l) -> {
            let w = walk(env, l.value, accumulator);
            bind(w.state, l.slot, w.owner)
          },
          CodeLetDestructure(l) -> {
            let w = walk(env, l.value, accumulator);
            pattern_slots(l.pattern).fold(w.state, |s2: CostState, slot: Int|
              bind(s2, slot, w.owner))
          },
          CodeDo(d) -> walk(env, d.code, accumulator).state,
        });
      match b.tail { Some(t) -> walk(env, t, s), None -> fresh(s) }
    },
    CodeRecord(r) ->
      fresh(
        r.fields.fold(state, |accumulator: CostState, f: CodeField|
          walk(env, f.value, accumulator).state),
      ),
    CodeUpdate(u) ->
      fresh(
        walk(
          env,
          u.base,
          u.sets.fold(state, |accumulator: CostState, f: CodeField|
            walk(env, f.value, accumulator).state),
        ).state,
      ),
    CodeFieldRead(f) -> {
      let b = match f.base.node {
        CodeVariable(v) -> if field_moved(env.moves, c.span) {
          variable_owner(env, v.name, v.slot, true, state)
        } else { walk(env, f.base, state) },
        _ -> walk(env, f.base, state),
      };
      match b.owner {
        SharedOwner(reason) ->
          {
            state: b.state,
            owner: blocked(
              reason.cause,
              Bytes::concat_all([
                b"`.",
                f.field,
                b"` was read from a record that another value still owns: ",
                reason.text,
              ]),
            ),
          },
        _ -> b,
      }
    },
    CodeList(l) ->
      fresh(l.items.fold(state, |accumulator: CostState, x: Code| walk(env, x, accumulator).state)),
    CodePerform(p) ->
      {
        state: p.args.fold(
          match p.label { Some(x) -> walk(env, x, state).state, None -> state },
          |accumulator: CostState, x: Code| walk(env, x, accumulator).state,
        ),
        owner: unknown(
          HandlerResult,
          b"the value a handler returned, which the handler may still reference",
        ),
      },
    CodeHandle(h) -> {
      let caught = h.clauses.fold(state, |accumulator: CostState, clause: CodeClause|
        mark_captured_shared(env, accumulator, clause.captures, clause.body, clause.at));
      let armed = match h.return_clause {
        Some(r) -> mark_captured_shared(env, caught, r.captures, r.body, r.at),
        None -> caught,
      };
      let ran = walk(env, h.body, armed).state;
      let clauses = h.clauses.fold(ran, |accumulator: CostState, clause: CodeClause|
        walk_nested_body(
          env,
          clause.params + (if clause.resume { 1 } else { 0 }),
          [],
          clause.body,
          accumulator,
        ));
      {
        state: match h.return_clause {
          Some(r) -> walk_nested_body(env, 1, [], r.body, clauses),
          None -> clauses,
        },
        owner: unknown(HandlerResult, b"the value a `handle` returned"),
      }
    },
    CodeSimulate(x) ->
      {
        state: walk_nested_body(
          env,
          0,
          [],
          x.body,
          mark_captured_shared(env, state, x.captures, x.body, x.at),
        ),
        owner: unknown(HandlerResult, b"the value a `simulate` returned"),
      },
  }

fn join(a: Owner, b: Owner) -> Owner =
  match a {
    SharedOwner(_) -> a,
    _ -> match b {
      SharedOwner(_) -> b,
      _ -> match a {
        UnknownOwner(_) -> a,
        _ -> match b { UnknownOwner(_) -> b, _ -> match a { ParamOwner(_) -> a, _ -> b } },
      },
    },
  }

fn walk_nested_body(
  env: Env,
  n: Int,
  owners: List<Owner>,
  body: Code,
  state: CostState,
) -> CostState / {abort.raise} = {
  let inner = with_chain(
    state,
    range(0, n).map(|i: Int|
      {
        slot: i,
        owner: match owners.at(i) {
          Some(o) -> o,
          None ->
            unknown(
              ClosureParam,
              b"a parameter of a closure whose callers this body cannot identify",
            ),
        },
      }),
  );
  with_chain(walk(env, body, inner).state, state.chain)
}

fn mark_captured_shared(
  env: Env,
  state: CostState,
  caps: List<Capture>,
  body: Code,
  at: Span,
) -> CostState =
  caps.fold(state, |accumulator: CostState, capture: Capture|
    if capture_moved(env.moves, at, capture.source) { accumulator } else {
      match owner_of(accumulator, capture.source) {
        None -> accumulator,
        Some(SharedOwner(_)) -> accumulator,
        Some(_) ->
          rebind(
            accumulator,
            capture.source,
            blocked(
              CapturedValue,
              Bytes::concat_all([
                b"a closure captured `",
                match first_name(body, capture.destination) { Some(n) -> n, None -> b"" },
                b"`, so the closure owns its own copy of the value",
              ]),
            ),
          ),
      }
    })

fn first_name(c: Code, slot: Int) -> Option<Bytes> =
  match c.node {
    CodeVariable(v) -> if v.slot == slot { Some(v.name) } else { None },
    CodeLambda(l) -> through(l.captures, l.body, slot),
    CodeSimulate(x) -> through(x.captures, x.body, slot),
    CodeHandle(h) -> {
      let found = h.clauses.fold(
        first_name(h.body, slot),
        |accumulator: Option<Bytes>, clause: CodeClause|
          match accumulator {
            Some(_) -> accumulator,
            None -> through(clause.captures, clause.body, slot),
          },
      );
      match found {
        Some(_) -> found,
        None -> match h.return_clause {
          Some(r) -> through(r.captures, r.body, slot),
          None -> None,
        },
      }
    },
    _ ->
      children(c).fold(None, |accumulator: Option<Bytes>, x: Code|
        match accumulator { Some(_) -> accumulator, None -> first_name(x, slot) }),
  }

fn through(caps: List<Capture>, body: Code, slot: Int) -> Option<Bytes> =
  caps.fold(None, |accumulator: Option<Bytes>, capture: Capture|
    match accumulator {
      Some(_) -> accumulator,
      None -> if capture.source == slot { first_name(body, capture.destination) } else { None },
    })

fn children(c: Code) -> List<Code> =
  match c.node {
    CodeUnary(u) -> [u.operand],
    CodeBinary(b) -> [b.left_operand, b.right_operand],
    CodeApply(a) ->
      a.args.fold([a.function], |accumulator: List<Code>, x: Code| accumulator.push(x)),
    CodeKnownLambda(_) -> [],
    CodeIf(i) -> [i.cond, i.then_branch, i.else_branch],
    CodeBlock(b) -> {
      let statements = b.statements.map(|statement: CodeStatement|
        match statement {
          CodeLet(l) -> l.value,
          CodeLetDestructure(l) -> l.value,
          CodeDo(d) -> d.code,
        });
      match b.tail { Some(t) -> statements.push(t), None -> statements }
    },
    CodeList(l) -> l.items,
    CodeRecord(r) -> r.fields.map(|f: CodeField| f.value),
    CodeUpdate(u) -> u.sets.map(|f: CodeField| f.value).push(u.base),
    CodeFieldRead(f) -> [f.base],
    CodeMatch(m) ->
      m.arms.fold([m.scrutinee], |accumulator: List<Code>, a: CodeArm|
        List::push(match a.guard { Some(g) -> accumulator.push(g), None -> accumulator }, a.body)),
    CodePerform(p) -> p.args,
    CodeParallel(parallel_code) -> parallel_code.branches,
    _ -> [],
  }

fn unbound_owner(name: Bytes) -> Owner =
  unknown(
    ClosureParam,
    Bytes::concat_all([
      b"`",
      name,
      b"` is free in this closure; whether the closure's copy is the only other owner when the update runs is not a property of this body",
    ]),
  )

fn variable_owner(env: Env, name: Bytes, slot: Int, moved: Bool, state: CostState) -> WithOwner =
  match owner_of(state, slot) {
    Some(o) ->
      {
        state: state,
        owner: if moved { o } else {
          blocked(
            ReadAgain,
            Bytes::concat_all([
              b"`",
              name,
              b"` is read again after this point, so this use clones it",
            ]),
          )
        },
      },
    None -> { state: state, owner: unbound_owner(name) },
  }

type NamedGlobal = { name: Bytes, definition: Option<Int> }

fn global_named(prog: Program, c: Code) -> Option<NamedGlobal> =
  match c.node {
    NDefinition(d) -> match prelude_own(d.full) {
      Some(name) -> Some({ name: name, definition: None }),
      None -> Some({ name: d.full, definition: prog.index.get(d.full) }),
    },
    NConstructor(k) -> Some({ name: k.name, definition: None }),
    NBuiltin(b) -> Some({ name: b.name, definition: None }),
    _ -> None,
  }

fn global_read(env: Env, c: Code, state: CostState) -> WithOwner =
  match global_named(env.prog, c) { Some(n) -> global_owner(n, state), None -> fresh(state) }

fn global_owner(named: NamedGlobal, state: CostState) -> WithOwner =
  match named.definition {
    Some(d) ->
      {
        state: add_escaped(state, d),
        owner: blocked(
          TopLevelValue,
          b"a top-level definition, which stays alive for the whole program",
        ),
      },
    None -> { state: state, owner: unbound_owner(named.name) },
  }

fn app(
  env: Env,
  span: Span,
  function: Code,
  args: List<Code>,
  state: CostState,
) -> WithOwner / {abort.raise} = {
  let named = global_named(env.prog, function);
  let callee = match named { Some(x) -> x.definition, None -> None };
  let builtin = match named {
    Some(x) -> if x.definition != None || !env.prog.builtins.contains(x.name) { None }
    else { Some(x.name) },
    None -> None,
  };
  let n = args.len();
  let before = match named {
    Some(_) -> state,
    None -> match function.node { CodeVariable(_) -> state, _ -> walk(env, function, state).state },
  };
  let walked: Args = args.fold({ state: before, owners: [] }, |accumulator: Args, arg: Code| {
    let w = match callback_owners(builtin, accumulator.owners.len(), accumulator.owners) {
      Some(owners) -> callback(env, owners, arg, accumulator.state),
      None -> walk(env, arg, accumulator.state),
    };
    { state: w.state, owners: accumulator.owners.push(w.owner) }
  });
  let sited = match update_of(builtin, n) {
    Some(operation) -> add_site(walked.state, span, operation, owner_at(walked.owners, 0)),
    None -> walked.state,
  };
  let demanded = match callee {
    None -> sited,
    Some(d) ->
      range(0, n).fold(sited, |accumulator: CostState, j: Int|
        match owner_at(walked.owners, j) {
          FreshOwner -> accumulator,
          o -> add_demand(accumulator, { callee: d, param: j, owner: o }),
        }),
  };
  let read = match ((builtin, callee)) {
    (None, Some(d)) -> match env.tables.rets.at(d) {
      Some(r) -> { ..demanded, reads: demanded.reads.push({ callee: d, return_ownership: r }) },
      None -> demanded,
    },
    _ -> demanded,
  };
  { state: read, owner: result_owner(env, builtin, callee, walked.owners) }
}

fn update_of(builtin: Option<Bytes>, n: Int) -> Option<Bytes> =
  match builtin {
    Some(b) -> if (b == b"List::push" && n == 2)
        || ((b == b"List::set" || b == b"Array::set") && n == 3) { Some(b) }
    else { None },
    None -> None,
  }

fn container_name(operation: Bytes) -> Bytes =
  if operation == b"Array::set" { b"array" } else { b"list" }

fn result_owner(env: Env, builtin: Option<Bytes>, callee: Option<Int>, args: List<Owner>) -> Owner =
  match builtin {
    None -> match callee {
      None ->
        unknown(CallResult, b"the value a call returned, which the callee may still reference"),
      Some(d) -> match env.tables.rets.at(d) {
        Some(ReturnOfParam(k)) -> match args.at(k) {
          Some(o) -> o,
          None -> unknown(CallResult, b"a call returning an argument it was not given"),
        },
        Some(SharedReturn(reason)) -> SharedOwner(reason),
        Some(UnsureReturn(reason)) -> UnknownOwner(reason),
        _ -> FreshOwner,
      },
    },
    Some(b) -> if b == b"Scoped::get" {
      blocked(ContainerElement, b"`Scoped::get` returns a copy of a value the scope still owns")
    } else if b == b"Map::get" || reads_entries(b) {
      blocked(MapEntry, Bytes::concat_all([b"`", b, b"` returns a clone the map still contains"]))
    } else if b == b"Map::pop_first" || b == b"Map::pop_last" || b == b"Map::split" {
      owner_at(args, 0)
    } else if b == b"List::at" {
      blocked(ContainerElement, b"`List::at` returns a clone of an element the list still owns")
    } else if b == b"Array::at" || b == b"Array::get" {
      blocked(
        ContainerElement,
        Bytes::concat_all([b"`", b, b"` returns a clone the array still contains"]),
      )
    } else if b == b"bracket" {
      unknown(CallResult, b"`bracket` returns whatever its body returned")
    } else {
      match prelude_callback_use(b) {
        Some(it) -> if it.result == Folded {
          unknown(
            CallResult,
            Bytes::concat_all([b"`", b, b"` returns whatever its callback returned"]),
          )
        } else { FreshOwner },
        None -> FreshOwner,
      }
    },
  }

fn reads_entries(b: Bytes) -> Bool =
  b == b"Map::first" || b == b"Map::last" || b == b"Map::floor" || b == b"Map::ceiling"
    || b == b"Map::below"
    || b == b"Map::above"
    || b == b"Map::range"

fn callback_owners(
  builtin: Option<Bytes>,
  position: Int,
  done: List<Owner>,
) -> Option<List<Owner>> =
  match builtin {
    None -> None,
    Some(b) -> match prelude_callback_use(b) {
      None -> None,
      Some(it) -> if it.callback != position { None } else {
        let given = |k: Int|
          match done.at(k) {
            Some(o) -> o,
            None ->
              unknown(
                CallResult,
                b"an argument written after the callback in the call's argument list",
              ),
          };
        Some(
          it.params.map(|h: CallbackArgument|
            match h {
              Element -> element_owner(),
              Accumulator(k) -> given(k),
              ExtractedFrom(k) -> given(k),
              Number -> FreshOwner,
              UnknownArgument ->
                unknown(
                  ClosureParam,
                  b"a parameter of a closure whose callers this body cannot identify",
                ),
            }),
        )
      },
    },
  }

fn callback(
  env: Env,
  owners: List<Owner>,
  arg: Code,
  state: CostState,
) -> WithOwner / {abort.raise} =
  match arg.node {
    CodeLambda(l) ->
      fresh(
        mark_captured_shared(
          env,
          walk_nested_body(env, l.params, owners, l.body, state),
          l.captures,
          l.body,
          l.at,
        ),
      ),
    _ -> walk(env, arg, state),
  }

fn sharing_rank(p: ParamSharing) -> Int =
  match p { SoleParam -> 2, UnsureParam(_) -> 1, SharedParam(_) -> 0 }

fn meet(a: ParamSharing, b: ParamSharing) -> ParamSharing =
  if sharing_rank(b) < sharing_rank(a) { b } else { a }

fn param_at(table: ParamTable, name: Option<Bytes>, k: Int) -> Option<ParamSharing> =
  match name {
    None -> None,
    Some(n) -> match table.get(n) {
      None -> Some(SoleParam),
      Some(slots) -> match slots.get(k) { Some(p) -> Some(p), None -> Some(SoleParam) },
    },
  }

fn combine_param(table: ParamTable, callee: Bytes, param: Int, p: ParamSharing) -> ParamTable = {
  let slots = match table.get(callee) { Some(s) -> s, None -> Map::new() };
  let met = meet(match slots.get(param) { Some(s) -> s, None -> SoleParam }, p);
  match met { SoleParam -> table, _ -> table.insert(callee, slots.insert(param, met)) }
}

fn return_of(owner: Owner) -> ReturnOwnership =
  match owner {
    FreshOwner -> FreshReturn,
    ParamOwner(k) -> ReturnOfParam(k),
    SharedOwner(reason) -> SharedReturn(reason),
    UnknownOwner(reason) -> UnsureReturn(reason),
  }

fn interpret(owner: Owner, caller: Option<Bytes>, table: ParamTable, label: Bytes) -> ParamSharing =
  match owner {
    FreshOwner -> SoleParam,
    SharedOwner(reason) ->
      SharedParam(
        reworded(reason, Bytes::concat_all([label, b" passes a value; reason: ", reason.text])),
      ),
    UnknownOwner(reason) ->
      UnsureParam(
        reworded(reason, Bytes::concat_all([label, b" passes a value; reason: ", reason.text])),
      ),
    ParamOwner(k) -> match param_at(table, caller, k) {
      Some(SoleParam) -> SoleParam,
      Some(UnsureParam(reason)) ->
        UnsureParam(
          reworded(
            reason,
            Bytes::concat_all([
              label,
              b" passes its own parameter ",
              ascii_of_int(k),
              b", whose ownership is not yet known",
            ]),
          ),
        ),
      Some(SharedParam(reason)) ->
        SharedParam(
          reworded(
            reason,
            Bytes::concat_all([
              label,
              b" passes its own parameter ",
              ascii_of_int(k),
              b", which the function's callers may still use after the call",
            ]),
          ),
        ),
      None ->
        UnsureParam({
          cause: CallerRetains,
          text: Bytes::concat_all([label, b" passes a parameter this analysis cannot identify"]),
        }),
    },
  }

fn start_returns(definitions: List<Definition>) -> Tables =
  {
    rets: definitions.map(|d: Definition|
      if d.own { FreshReturn } else {
        match d.declared_return {
          Some(x) -> x.return_type,
          None ->
            UnsureReturn({
              cause: CallResult,
              text: Bytes::concat_all([
                b"`",
                d.name,
                b"` is another package's, and its signature writes no `returns`",
              ]),
            }),
        }
      }),
  }

fn walk_body(env: Env, b: Body) -> WalkResult / {abort.raise} = {
  let chain = range(0, b.arity).map(|k: Int|
    { slot: k, owner: if b.definition_index < 0 { FreshOwner } else { ParamOwner(k) } });
  let w = walk({ ..env, moves: b.moves }, b.code, {
    chain: chain,
    sites: [],
    demands: [],
    escaped: [],
    reads: [],
  });
  {
    sites: w.state.sites,
    demands: w.state.demands,
    used_as_values: w.state.escaped,
    return_owner: w.owner,
    reads: w.state.reads,
  }
}

fn walks(prog: Program, tables: Tables) -> List<WalkResult> / {abort.raise} =
  prog.bodies.map(|b: Body|
    walk_body({ prog: prog, module: b.module, tables: tables, moves: no_moves() }, b))

fn with_returns(prog: Program, found: List<WalkResult>, tables: Tables) -> Tables / {abort.raise} =
  range(0, prog.bodies.len()).fold(tables, |accumulator: Tables, i: Int| {
    let b: Body = prog.bodies.get(i);
    if b.definition_index < 0 { accumulator } else {
      { rets: accumulator.rets.set(b.definition_index, return_of(found.get(i).return_owner)) }
    }
  })

type Settled = { found: List<WalkResult>, tables: Tables }

fn settled_walks(prog: Program, tables: Tables, rounds: Int) -> Settled / {abort.raise} = {
  let found = walks(prog, tables);
  let next = with_returns(prog, found, tables);
  if next == tables || rounds + 1 >= 24 { { found: found, tables: next } }
  else { settled_walks(prog, next, rounds + 1) }
}

fn called_outside(prog: Program, found: List<WalkResult>) -> List<Int> = {
  let inside = prog.bodies.fold(Map::new(), |accumulator: Map<Int, Bool>, b: Body|
    accumulator.insert(b.definition_index, true));
  found.fold(Map::new(), |accumulator: Map<Int, Bool>, f: WalkResult|
    f.reads.fold(accumulator, |m: Map<Int, Bool>, r: ReturnRead|
      if inside.contains(r.callee) { m } else { m.insert(r.callee, true) })).keys(
  )
}

fn relative(p: CostInput, span: Span) -> Span =
  { ..span, start: span.start - p.origin, end: span.end - p.origin }

fn walked_body(p: CostInput, prog: Program, b: Body, f: WalkResult) -> WalkedBody / {abort.raise} = {
  let own = |d: Int| prog.definitions.get(d).own;
  let name = |d: Int| prog.definitions.get(d).name;
  {
    item_kind: b.item_kind,
    module_name: b.module_name,
    name: b.name,
    label: b.label,
    definition: if b.definition_index < 0 { None } else { Some(name(b.definition_index)) },
    reuse: match b.reuse { Some(s) -> Some(relative(p, s)), None -> None },
    sites: f.sites.map(|s: RawSite| { ..s, span: relative(p, s.span) }),
    demands: f.demands.filter(|d: PassedArgument| own(d.callee)).map(|d: PassedArgument|
      { callee: name(d.callee), param: d.param, owner: d.owner }),
    escaped: f.used_as_values.filter(own).map(|d: Int|
      { callee: name(d), arity: prog.definitions.get(d).arity }),
    returned: return_of(f.return_owner),
  }
}

fn declared_in(p: CostInput, prog: Program) -> List<DeclaredReturn> / {abort.raise} =
  prog.bodies.fold([], |accumulator: List<DeclaredReturn>, b: Body|
    if b.definition_index < 0 { accumulator } else {
      let d: Definition = prog.definitions.get(b.definition_index);
      match d.declared_return {
        None -> accumulator,
        Some(x) ->
          accumulator.push({
            module_name: d.module_name,
            definition: d.name,
            params: d.params,
            declared: x.return_type,
            span: relative(p, x.span),
          }),
      }
    })

pub fn walked_group<| e>(
  p: CostInput,
  returned: (Bytes) -> ReturnOwnership / {abort.raise | e},
) -> GroupWalk / {abort.raise | e} =
  match program_of(p) {
    None -> { ok: false, bodies: [], declared: [] },
    Some(prog) -> {
      let start = start_returns(prog.definitions);
      let outside = called_outside(prog, walks(prog, start)).filter(|d: Int|
        prog.definitions.get(d).own);
      let tables = outside.fold(start, |accumulator: Tables, d: Int|
        { rets: accumulator.rets.set(d, returned(prog.definitions.get(d).name)) });
      let settled = settled_walks(prog, tables, 0);
      {
        ok: true,
        bodies: range(0, prog.bodies.len()).map(|i: Int|
          walked_body(p, prog, prog.bodies.get(i), settled.found.get(i))),
        declared: declared_in(p, prog),
      }
    },
  }

pub fn demands_of(walked: List<GroupWalk>) -> ModuleDemands =
  {
    ok: walked.all(|w: GroupWalk| w.ok),
    bodies: walked.fold([], |accumulator: List<BodyDemands>, w: GroupWalk|
      w.bodies.fold(accumulator, |a: List<BodyDemands>, b: WalkedBody|
        if b.demands.len() == 0 && b.escaped.len() == 0 { a } else {
          a.push({ caller: b.definition, label: b.label, escaped: b.escaped, demands: b.demands })
        })),
  }

fn escaped_from(table: ParamTable, label: Bytes, e: Escape) -> ParamTable / {abort.raise} =
  range(0, e.arity).fold(table, |accumulator: ParamTable, k: Int|
    combine_param(
      accumulator,
      e.callee,
      k,
      UnsureParam({
        cause: TopLevelValue,
        text: Bytes::concat_all([
          b"`",
          e.callee,
          b"` is used as a value in ",
          label,
          b", so not every caller of it is known",
        ]),
      }),
    ))

fn parameters_round(rollups: List<ModuleDemands>, table: ParamTable) -> ParamTable / {abort.raise} =
  rollups.fold(Map::new(), |accumulator: ParamTable, m: ModuleDemands|
    m.bodies.fold(accumulator, |round: ParamTable, b: BodyDemands| {
      let escaped = b.escaped.fold(round, |s: ParamTable, e: Escape| escaped_from(s, b.label, e));
      b.demands.fold(escaped, |s: ParamTable, d: Demand|
        combine_param(s, d.callee, d.param, interpret(d.owner, b.caller, table, b.label)))
    }))

fn settled_parameters(
  rollups: List<ModuleDemands>,
  table: ParamTable,
  rounds: Int,
) -> Parameters / {abort.raise} = {
  let next = parameters_round(rollups, table);
  if next == table || rounds + 1 >= 24 { { table: next, rounds: rounds + 1 } }
  else { settled_parameters(rollups, next, rounds + 1) }
}

pub fn parameters_of(rollups: List<ModuleDemands>) -> Parameters / {abort.raise} =
  settled_parameters(rollups, Map::new(), 0)

fn suggestion_for(cause: Option<Cause>) -> Bytes =
  match cause {
    Some(ReadAgain) ->
      b"make the update the last use of the variable: first bind anything else you need from the variable to new names",
    Some(MapEntry) -> b"`Map::update`",
    Some(CapturedValue) -> b"bind the value before the closure captures it, or capture less",
    Some(CallerRetains) ->
      b"change the call site: the caller uses the value it passes again after the call",
    _ -> b"",
  }

pub type Site = {
  start: Int,
  end: Int,
  operation: Bytes,
  verdict: Bytes,
  reason: Bytes,
  suggestion: Bytes,
  param: Int,
}

pub type Costed = {
  item_kind: Bytes,
  module: Int,
  module_name: Bytes,
  name: Bytes,
  label: Bytes,
  reuse_keyword: Option<Span>,
  sites: List<Site>,
}

pub type ReturnMismatch = {
  module: Int,
  module_name: Bytes,
  name: Bytes,
  start: Int,
  end: Int,
  declared: Bytes,
  actual: Bytes,
}

pub type Report = {
  ok: Bool,
  rounds: Int,
  definitions: List<Costed>,
  return_mismatches: List<ReturnMismatch>,
}

derive bin for Site
derive bin for Costed
derive bin for ReturnMismatch
derive bin for Report

fn placed_at(items: List<ItemAt>, relative_position: Int) -> Int =
  match items.find(|x: ItemAt| x.from <= relative_position && relative_position <= x.from + x.len) {
    Some(x) -> x.to + relative_position - x.from,
    None -> relative_position,
  }

pub fn placed_span(items: List<ItemAt>, span: Span) -> Span =
  { ..span, start: placed_at(items, span.start), end: placed_at(items, span.end) }

fn finish(raw: RawSite, definition: Option<Bytes>, table: ParamTable) -> Site = {
  let sited = |verdict: Bytes, reason: Bytes, cause: Option<Cause>, param: Int|
    {
      start: raw.span.start,
      end: raw.span.end,
      operation: raw.builtin_name,
      verdict: verdict,
      reason: reason,
      suggestion: suggestion_for(cause),
      param: param,
    };
  match raw.owner {
    FreshOwner ->
      sited(
        b"reuses",
        Bytes::concat_all([
          b"the ",
          container_name(raw.builtin_name),
          b" reaches `",
          raw.builtin_name,
          b"` with a single reference",
        ]),
        None,
        0 - 1,
      ),
    SharedOwner(reason) -> sited(b"copies", reason.text, Some(reason.cause), 0 - 1),
    UnknownOwner(reason) -> sited(b"unknown", reason.text, Some(reason.cause), 0 - 1),
    ParamOwner(k) -> {
      let head = Bytes::concat_all([
        b"the ",
        container_name(raw.builtin_name),
        b" is parameter ",
        ascii_of_int(k),
      ]);
      match param_at(table, definition, k) {
        Some(SoleParam) ->
          sited(
            b"reuses",
            head.concat(b", and every call site passes it and never uses it again"),
            None,
            k,
          ),
        Some(SharedParam(reason)) ->
          sited(
            b"copies",
            Bytes::concat_all([
              head,
              b", and a caller uses it again after the call: ",
              reason.text,
            ]),
            Some(CallerRetains),
            k,
          ),
        Some(UnsureParam(reason)) ->
          sited(
            b"unknown",
            Bytes::concat_all([
              head,
              b", and it is unclear whether a call site uses it again: ",
              reason.text,
            ]),
            Some(reason.cause),
            k,
          ),
        None ->
          sited(
            b"unknown",
            head.concat(b" of a definition the compiler cannot find"),
            Some(CallerRetains),
            k,
          ),
      }
    },
  }
}

fn quoted(s: Bytes) -> Bytes =
  Bytes::concat_all([
    b"\"",
    Bytes::concat_all(
      range(0, s.len()).map(|i: Int| {
        let c = s.at(i);
        if c == 34 { b"\\\"" }
        else if c == 92 { b"\\\\" }
        else if c == 10 { b"\\n" }
        else if c == 13 { b"\\r" }
        else if c == 9 { b"\\t" }
        else { s.slice(i, i + 1) }
      }),
    ),
    b"\"",
  ])

fn module_bodies(
  i: Int,
  setting: ModuleContext,
  roots: List<ItemRoot>,
  natives: List<Bytes>,
  index: Map<Bytes, Int>,
) -> List<Body> / {abort.raise} = {
  let s = { ..setting, builtins: natives };
  let m = setting.module;
  roots.fold([], |a: List<Body>, ir: ItemRoot| {
    let moves = root_moves(s, ir.root);
    let body = |kind: Bytes, name: Bytes, label: Bytes, definition: Int, reuse: Option<Span>|
      {
        item_kind: kind,
        module: i,
        module_name: m,
        name: name,
        label: label,
        definition_index: definition,
        arity: ir.root.params.len(),
        code: ir.root.code,
        moves: moves,
        reuse: reuse,
      };
    match ir.item {
      FunctionItem(d) ->
        a.push(
          body(
            b"fn",
            d.name.name,
            Bytes::concat_all([m, b".", d.name.name]),
            match index.get(qualify(m, d.name.name)) { Some(k) -> k, None -> 0 - 1 },
            d.reuse,
          ),
        ),
      TestItem(t) ->
        a.push(
          body(b"test", t.name, Bytes::concat_all([m, b": test ", quoted(t.name)]), 0 - 1, None),
        ),
      LawItem(l) ->
        a.push(
          body(b"law", l.name, Bytes::concat_all([m, b": law ", quoted(l.name)]), 0 - 1, None),
        ),
      _ -> a,
    }
  })
}

fn definition_of_function(
  module: Bytes,
  own: Bool,
  definition: FnDefinition,
  witnesses: List<Bytes>,
) -> Definition / {abort.raise} = {
  let params = witnesses.concat(definition.params.map(|param: Param| param.name.name));
  {
    name: qualify(module, definition.name.name),
    module_name: module,
    params: params,
    arity: params.len(),
    own: own,
    declared_return: match definition.returns {
      None -> None,
      Some(ReturnsFresh(return_span)) -> Some({ return_type: FreshReturn, span: return_span }),
      Some(ReturnsParam(x)) ->
        Some({
          return_type: ReturnOfParam(
            range(0, params.len()).fold(0, |accumulator: Int, k: Int|
              if params.get(k) == x.name { k } else { accumulator }),
          ),
          span: x.span,
        }),
    },
  }
}

fn violates(declared: ReturnOwnership, got: ReturnOwnership) -> Bool =
  match got {
    FreshReturn -> false,
    ReturnOfParam(k) -> match declared { ReturnOfParam(j) -> j != k, _ -> true },
    _ -> true,
  }

fn return_text(params: List<Bytes>, r: ReturnOwnership) -> Bytes =
  match r {
    FreshReturn -> b"fresh",
    ReturnOfParam(k) ->
      Bytes::concat_all([
        b"its parameter `",
        match params.at(k) { Some(n) -> n, None -> ascii_of_int(k) },
        b"`",
      ]),
    SharedReturn(reason) -> reason.text,
    UnsureReturn(reason) -> reason.text,
  }

fn builtin_names() -> List<Bytes> / {abort.raise} = builtins().map(|b: Builtin| b.name)

pub type CostInput = {
  modules: List<ParsedModule>,
  r: Resolution,
  checked: CheckOutput,
  module_packages: List<Int>,
  embeds: List<ModuleEmbed>,
  rows: Rows,
  facts: InferredFacts,
  walked: List<Int>,
  roots: Option<Map<Bytes, Bool>>,
  origin: Int,
}

pub fn cost_input_of(analysis: Analysis) -> CostInput / {abort.raise} =
  {
    modules: analysis.modules,
    r: analysis.r,
    checked: analysis.checked,
    module_packages: analysis.module_packages,
    embeds: analysis.embeds,
    rows: rows_of(analysis),
    facts: inferred_facts(analysis),
    walked: range(0, analysis.modules.len()).filter(|i: Int|
      own_module(analysis.module_packages, i)),
    roots: None,
    origin: 0,
  }

fn own_module(module_packages: List<Int>, i: Int) -> Bool =
  match module_packages.at(i) { Some(k) -> k == 0, None -> true }

fn places(modules: List<ParsedModule>) -> Map<Bytes, Int> / {abort.raise} =
  range(0, modules.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
    accumulator.insert(modules.get(i).name, i))

fn placed(here: Map<Bytes, Int>, names: List<Bytes>, k: Int) -> Option<Int> =
  match names.at(k) { Some(n) -> here.get(n), None -> None }

fn orders_by_module(
  w: InferredFacts,
  modules: List<ParsedModule>,
) -> Map<Int, Map<Bytes, List<Bytes>>> / {abort.raise} = {
  let here = places(modules);
  w.orders.fold(Map::new(), |accumulator: Map<Int, Map<Bytes, List<Bytes>>>, o: WitnessOrder|
    match placed(here, w.modules, o.module) {
      None -> accumulator,
      Some(i) -> {
        let was = match accumulator.get(i) { Some(m) -> m, None -> Map::new() };
        accumulator.insert(i, was.insert(o.name, o.params))
      },
    })
}

fn definitions_of(p: CostInput) -> List<Definition> / {abort.raise} = {
  let orders = orders_by_module(p.facts, p.modules);
  range(0, p.modules.len()).fold([], |accumulator: List<Definition>, i: Int| {
    let m: ParsedModule = p.modules.get(i);
    let ws = match orders.get(i) { Some(o) -> o, None -> Map::new() };
    m.module.items.fold(accumulator, |xs: List<Definition>, item: Item|
      match item {
        FunctionItem(d) ->
          xs.push(
            definition_of_function(
              m.name,
              own_module(p.module_packages, i),
              d,
              match ws.get(d.name.name) { Some(w) -> w.map(witness_param_name), None -> [] },
            ),
          ),
        _ -> xs,
      })
  })
}

fn lowered_bodies(p: CostInput, index: Map<Bytes, Int>) -> Option<List<Body>> / {abort.raise} = {
  let tables = embed_tables(p.embeds);
  let wants = p.walked.fold(Map::new(), |m: Map<Int, Bool>, i: Int| m.insert(i, true));
  let read = range(0, p.modules.len()).fold(
    { modules: [], bad: false },
    |accumulator: { modules: List<ParsedModule>, bad: Bool }, i: Int| {
      let m: ParsedModule = p.modules.get(i);
      if !wants.contains(i) { { ..accumulator, modules: accumulator.modules.push(m) } } else {
        let e = inline_embeds_by_name(tables, m.name, m.module);
        {
          modules: accumulator.modules.push({ ..m, module: e.module }),
          bad: accumulator.bad || e.diagnostics.len() > 0,
        }
      }
    },
  );
  if read.bad { None } else {
    let natives = parsed_natives(p.modules).map(|e: Extern| e.name);
    match module_contexts_in(
        p.r,
        p.checked,
        p.rows,
        p.facts,
        read.modules,
        p.walked,
        |i: Int, s: ModuleContext, roots: List<ItemRoot>|
          module_bodies(i, s, roots, natives, index),
        match p.roots {
          None -> None,
          Some(roots) ->
            Some({
              roots: roots,
              modules: p.walked.fold(Map::new(), |m: Map<Bytes, Bool>, i: Int|
                m.insert(p.modules.get(i).name, true)),
            }),
        },
      ) {
      Err(_) -> None,
      Ok(bodies) -> Some(bodies.fold([], |a: List<Body>, b: List<Body>| a.concat(b))),
    }
  }
}

fn program_of(p: CostInput) -> Option<Program> / {abort.raise} = {
  let definitions = definitions_of(p);
  let index = range(0, definitions.len()).fold(
    Map::new(),
    |accumulator: Map<Bytes, Int>, i: Int| accumulator.insert(definitions.get(i).name, i),
  );
  match lowered_bodies(p, index) {
    None -> None,
    Some(bodies) ->
      Some({
        index: index,
        builtins: builtin_names().fold(Map::new(), |accumulator: Map<Bytes, Bool>, b: Bytes|
          accumulator.insert(b, true)),
        definitions: definitions,
        bodies: bodies,
      }),
  }
}

pub type PlacedWalk = { items: List<ItemAt>, walk: GroupWalk }

fn costed_in(table: ParamTable, placed: PlacedWalk) -> List<Costed> =
  placed.walk.bodies.fold([], |accumulator: List<Costed>, b: WalkedBody|
    if b.sites.len() == 0 { accumulator } else {
      accumulator.push({
        item_kind: b.item_kind,
        module: 0,
        module_name: b.module_name,
        name: b.name,
        label: b.label,
        reuse_keyword: match b.reuse {
          Some(s) -> Some(placed_span(placed.items, s)),
          None -> None,
        },
        sites: b.sites.map(|raw: RawSite|
          finish({ ..raw, span: placed_span(placed.items, raw.span) }, b.definition, table)),
      })
    })

fn mismatches_in(placed: PlacedWalk) -> List<ReturnMismatch> =
  placed.walk.declared.fold([], |accumulator: List<ReturnMismatch>, d: DeclaredReturn|
    match placed.walk.bodies.find(|b: WalkedBody| b.definition == Some(d.definition)) {
      None -> accumulator,
      Some(b) -> if !violates(d.declared, b.returned) { accumulator } else {
        let at = placed_span(placed.items, d.span);
        accumulator.push({
          module: 0,
          module_name: d.module_name,
          name: d.definition,
          start: at.start,
          end: at.end,
          declared: return_text(d.params, d.declared),
          actual: return_text(d.params, b.returned),
        })
      },
    })

fn first_site(c: Costed) -> Int = match c.sites.at(0) { Some(s) -> s.start, None -> 0 }

pub fn module_costs(walks: List<PlacedWalk>, parameters: Parameters) -> Report =
  {
    ok: walks.all(|w: PlacedWalk| w.walk.ok),
    rounds: parameters.rounds,
    definitions: walks.fold([], |accumulator: List<Costed>, w: PlacedWalk|
      accumulator.concat(costed_in(parameters.table, w))).sort_by(|a: Costed, b: Costed|
      first_site(a) <= first_site(b)),
    return_mismatches: walks.fold([], |accumulator: List<ReturnMismatch>, w: PlacedWalk|
      accumulator.concat(mismatches_in(w))).sort_by(|a: ReturnMismatch, b: ReturnMismatch|
      a.start <= b.start),
  }

pub fn report_of(modules: List<Report>) -> Report =
  {
    ok: modules.all(|m: Report| m.ok),
    rounds: match modules.at(0) { Some(m) -> m.rounds, None -> 0 },
    definitions: modules.fold([], |accumulator: List<Costed>, m: Report|
      accumulator.concat(m.definitions)),
    return_mismatches: modules.fold([], |accumulator: List<ReturnMismatch>, m: Report|
      accumulator.concat(m.return_mismatches)),
  }

fn checked_cost_input(
  names: List<Bytes>,
  sources: List<Bytes>,
  module_packages: List<Int> = [],
) -> CostInput / {abort.raise} =
  match analyse(
      parse_all(
        range(0, names.len()).map(|i: Int| { name: names.get(i), source_text: sources.get(i) }),
      ),
    ) {
    Rejected(_) -> panic("the checker rejected a program that should be valid"),
    Analysed(w) ->
      cost_input_of({
        ..w,
        module_packages: module_packages.concat(w.module_packages.drop(module_packages.len())),
      }),
  }

pub fn report_over_one_walk(p: CostInput) -> Report / {abort.raise} = {
  let walked = walked_group(p, |_: Bytes| FreshReturn);
  report_of([module_costs([{ items: [], walk: walked }], parameters_of([demands_of([walked])]))])
}

fn reported(
  names: List<Bytes>,
  sources: List<Bytes>,
  module_packages: List<Int> = [],
) -> Report / {abort.raise} =
  report_over_one_walk(checked_cost_input(names, sources, module_packages))

test "a cost report gives each update's source location, whether it copies or reuses, the reason, and an edit that would avoid the copy" {
  let source = b"reuse fn grow(m: Map<Int, List<Int>>, n: Int) -> List<Int> =\n  match m.get(0) { Some(xs) -> xs.push(n), None -> [] }\n";
  let r = reported([b"m"], [source]);
  assert(r.ok);
  assert_eq(r.definitions.len(), 1);
  let d = r.definitions.get(0);
  assert_eq([d.item_kind, d.module_name, d.name], [b"fn", b"m", b"grow"]);
  assert_eq(d.reuse_keyword, Some(span_between(0, 5)));
  assert_eq(d.sites.len(), 1);
  let s = d.sites.get(0);
  assert_eq(source.slice(s.start, s.end), b"xs.push(n)");
  assert_eq(s.operation, b"List::push");
  assert_eq(s.verdict, b"copies");
  assert_eq(s.reason, b"`Map::get` returns a clone the map still contains");
  assert_eq(s.suggestion, b"`Map::update`");
  assert_eq(s.param, 0 - 1)
}

test "updating a map entry read with `first` or `floor` copies it, but an entry removed with `pop_first` or `split` is reused" {
  let source = b"fn peek(m: Map<Int, List<Int>>, n: Int) -> List<Int> = match m.first() { Some(e) -> e.value.push(n), None -> [] }\nfn near(m: Map<Int, List<Int>>, n: Int) -> List<Int> = match m.floor(n) { Some(e) -> e.value.push(n), None -> [] }\nfn take(m: Map<Int, List<Int>>, n: Int) -> List<Int> = match m.pop_first() { Some(p) -> p.value.push(n), None -> [] }\nfn cut(m: Map<Int, List<Int>>, n: Int) -> List<Int> = match m.split(n).at { Some(xs) -> xs.push(n), None -> [] }\ntest \"fresh\" { assert_eq(take(Map::new().insert(1, [1]), 2), [1, 2]); assert_eq(cut(Map::new().insert(1, [1]), 1), [1, 1]) }\n";
  let r = reported([b"m"], [source]);
  assert(r.ok);
  let site_of = |name: Bytes| r.definitions.filter(|d: Costed| d.name == name).get(0).sites.get(0);
  let peeked = site_of(b"peek");
  assert_eq([peeked.verdict, peeked.reason, peeked.suggestion], [
    b"copies",
    b"`.value` was read from a record that another value still owns: `Map::first` returns a clone the map still contains",
    b"`Map::update`",
  ]);
  assert_eq(
    site_of(b"near").reason,
    b"`.value` was read from a record that another value still owns: `Map::floor` returns a clone the map still contains",
  );
  let taken = site_of(b"take");
  assert_eq([taken.verdict, taken.reason], [
    b"reuses",
    b"the list is parameter 0, and every call site passes it and never uses it again",
  ]);
  assert_eq(site_of(b"cut").verdict, b"reuses")
}

test "an array or list element replaced in place is an update, and one read out first is a copy" {
  let source = b"fn fill(xs: Array<Int>, i: Int) -> Array<Int> / {abort.raise} = if i <= 0 { xs } else { fill(xs.set(i - 1, i), i - 1) }\nfn twice(xs: Array<Int>) -> Array<Int> / {abort.raise} = { let n = xs.get(0) + xs.len(); xs.set(0, n) }\nfn again(xs: Array<Int>) -> Int / {abort.raise} = xs.set(0, 1).len() + xs.len()\nfn sized(xs: Array<Int>) -> Array<Int> / {abort.raise} = xs.set(0, xs.len())\nfn first(ys: List<Array<Int>>) -> Array<Int> / {abort.raise} = match ys.at(0) { Some(a) -> a.set(0, 1), None -> Array::new(1, 0) }\nfn bump(zs: List<Int>) -> List<Int> / {abort.raise} = zs.set(0, 1)\ntest \"fresh\" { assert_eq(fill(Array::new(3, 0), 3).len(), 3); assert_eq(bump([0]), [1]) }\n";
  let r = reported([b"m"], [source]);
  assert(r.ok);
  let site_of = |name: Bytes| r.definitions.filter(|d: Costed| d.name == name).get(0).sites.get(0);
  let filled = site_of(b"fill");
  assert_eq([filled.operation, filled.verdict, filled.reason], [
    b"Array::set",
    b"reuses",
    b"the array is parameter 0, and every call site passes it and never uses it again",
  ]);
  let twiced = site_of(b"twice");
  assert_eq([twiced.operation, twiced.verdict], [b"Array::set", b"reuses"]);
  let again = site_of(b"again");
  assert_eq([again.verdict, again.reason, again.suggestion], [
    b"copies",
    b"`xs` is read again after this point, so this use clones it",
    b"make the update the last use of the variable: first bind anything else you need from the variable to new names",
  ]);
  assert_eq(site_of(b"sized").verdict, b"reuses");
  let read = site_of(b"first");
  assert_eq([read.operation, read.verdict, read.reason], [
    b"Array::set",
    b"copies",
    b"`List::at` returns a clone of an element the list still owns",
  ]);
  let bumped = site_of(b"bump");
  assert_eq([bumped.operation, bumped.verdict], [b"List::set", b"reuses"])
}

test "updating a value read from a scope reports a copy, and updating one the scope's callback returns or ends up using reports an unknown cost" {
  let source = b"fn read(xs: List<Int>, n: Int) -> List<Int> = with_scope[r](xs, |l: List<Int>| ()) { h -> h.get().push(n) }\nfn answered(xs: List<Int>, n: Int) -> List<Int> = List::push(with_scope[r](n, |k: Int| ()) { h -> xs }, n)\nfn released(xs: List<Int>, n: Int) -> Int = with_scope[r](xs, |l: List<Int>| { let grown = l.push(n); () }) { h -> n }\n";
  let r = reported([b"m"], [source]);
  assert(r.ok);
  let site_of = |name: Bytes| r.definitions.filter(|d: Costed| d.name == name).get(0).sites.get(0);
  let read = site_of(b"read");
  assert_eq([read.verdict, read.reason, read.suggestion], [
    b"copies",
    b"`Scoped::get` returns a copy of a value the scope still owns",
    b"",
  ]);
  assert_eq(site_of(b"answered").verdict, b"unknown");
  assert_eq(site_of(b"released").verdict, b"unknown")
}

fn verdicts(r: Report) -> List<Bytes> =
  r.definitions.fold([], |accumulator: List<Bytes>, d: Costed|
    d.sites.fold(accumulator, |a: List<Bytes>, s: Site|
      a.push(Bytes::concat_all([d.name, b" ", s.verdict]))))

test "a `returns` clause is checked against the function body, and a mismatch reports the declared and actual return origin" {
  let source = Bytes::concat_all([
    b"fn mk(n: Int) -> List<Int> returns fresh = range(0, n)\n",
    b"fn pick(xs: List<Int>, ys: List<Int>) -> List<Int> returns ys = xs\n",
    b"fn same(xs: List<Int>) -> List<Int> returns xs = xs\n",
    b"fn folded(xs: List<Int>) -> List<Int> returns fresh = xs.fold([], |acc: List<Int>, x: Int| acc.push(x))\n",
  ]);
  let r = reported([b"m"], [source]);
  assert(r.ok);
  assert_eq(r.return_mismatches.map(|u: ReturnMismatch| (u.name, u.declared, u.actual)), [
    (b"m.pick", b"its parameter `ys`", b"its parameter `xs`"),
    (b"m.folded", b"fresh", b"`List::fold` returns whatever its callback returned"),
  ]);
  assert_eq(source.slice(r.return_mismatches.get(0).start, r.return_mismatches.get(0).end), b"ys")
}

test "an update inside a callback passed to a builtin reports a copy or reuse by what the builtin passes in" {
  let source = Bytes::concat_all([
    b"fn grown(xs: List<Int>) -> List<Int> = xs.fold([], |acc: List<Int>, x: Int| acc.push(x))\n",
    b"fn each(xss: List<List<Int>>) -> List<List<Int>> = xss.map(|ys: List<Int>| ys.push(1))\n",
    b"fn values(m: Map<Int, Int>) -> List<Int> returns fresh = m.fold([], |acc: List<Int>, k: Int, v: Int| acc.push(v))\n",
  ]);
  let r = reported([b"m"], [source]);
  assert(r.ok);
  let site_of = |name: Bytes| r.definitions.filter(|d: Costed| d.name == name).get(0).sites.get(0);
  assert_eq(site_of(b"grown").verdict, b"reuses");
  let each = site_of(b"each");
  assert_eq([each.verdict, each.reason], [
    b"copies",
    b"an element of the list being iterated over, which the list still owns",
  ]);
  assert_eq(r.return_mismatches.map(|u: ReturnMismatch| (u.name, u.actual)), [
    (b"m.values", b"`Map::fold` returns whatever its callback returned"),
  ])
}

test "`fold` is treated as returning whatever its callback returns" {
  let lib = Bytes::concat_all([
    b"pub fn made(n: Int) -> List<Int> returns fresh = range(0, n).fold([], |acc: List<Int>, x: Int| acc.push(x))\n",
    b"pub fn plain(n: Int) -> List<Int> = range(0, n)\n",
  ]);
  let app = b"import lib.more\nreuse fn grow(n: Int) -> List<Int> = more::made(n).push(n)\nreuse fn other(n: Int) -> List<Int> = more::plain(n).push(n)\n";
  let r = reported([b"app", b"lib.more"], [app, lib], [0, 1]);
  assert(r.ok);
  assert_eq(verdicts(r), [b"grow reuses", b"other unknown"]);
  assert_eq(r.return_mismatches, [])
}

test "a callee in another body is read through the given return, and a demand names the callee" {
  let source = b"pub fn kept(xs: List<Int>) -> List<Int> = xs\nfn grow(xs: List<Int>, n: Int) -> List<Int> = kept(xs).push(n)\n";
  let p = checked_cost_input([b"m"], [source]);
  let only_grow = { ..p, roots: Some(Map::new().insert(b"m.grow", true)) };
  let walked = walked_group(only_grow, |name: Bytes|
    if name == b"m.kept" { ReturnOfParam(0) } else { FreshReturn });
  assert_eq(walked.bodies.map(|b: WalkedBody| b.definition), [Some(b"m.grow")]);
  assert_eq(walked.bodies.get(0).demands, [{ callee: b"m.kept", param: 0, owner: ParamOwner(0) }])
}

test "parameters stay sole until a caller's demand reaches them through its own parameter" {
  let rollup: ModuleDemands = {
    ok: true,
    bodies: [
      {
        caller: Some(b"m.outer"),
        label: b"m.outer",
        escaped: [],
        demands: [{ callee: b"m.inner", param: 0, owner: ParamOwner(0) }],
      },
      {
        caller: None,
        label: b"m: test",
        escaped: [],
        demands: [
          {
            callee: b"m.outer",
            param: 0,
            owner: SharedOwner({ cause: ReadAgain, text: b"read again" }),
          },
        ],
      },
    ],
  };
  let settled = parameters_of([rollup]);
  assert(settled.rounds > 1);
  assert(match param_at(settled.table, Some(b"m.inner"), 0) {
    Some(SharedParam(_)) -> true,
    _ -> false,
  });
  assert_eq(param_at(settled.table, Some(b"m.other"), 0), Some(SoleParam))
}
