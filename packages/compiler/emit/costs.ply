import compiler.syntax.parsing (Span, dummy_span, span_bin, span_between)
import compiler.emit.code (Code, CodeLiteral, CodeVar, NDefinition, NConstructor, NBuiltin,
                           CodeUnary, CodeBinary, CodeApply, CodeIf, CodeBlock, CodeList,
                           CodeRecord, CodeMatch, CodePerform, CodeLambda, CodeSimulate,
                           CodeParallel, CodeHandle, CodeFieldRead, CodeUpdate, CodeKnownLambda,
                           CodeLabel, CodeStatement, CodeLet, CodeLetDestructure, CodeDo, CodeArm,
                           CodeField, CodeClause, Capture, pattern_slots)
import compiler.emit.moves (Moves, no_moves, read_moved, capture_moved, field_moved, root_moves)
import compiler.emit.lower.module_context (ModuleContext, ItemRoot, module_contexts_in)
import compiler.check.infer.definitions (Extern, parsed_natives)
import compiler.syntax.items (Module, DeriveOrigin, Item, FunctionItem, TestItem, LawItem,
                              FnDefinition, ReturnsFresh, ReturnsParam, parse)
import compiler.expand.derive (derivation_of)
import compiler.syntax.expressions (Param, prelude_module, prelude_own)
import compiler.expand.embed (ModuleEmbed, EmbedFile, embed_tables, inline_embeds_by_name)
import compiler.check.resolve.tables (ParsedModule, Resolution, Source, qualify)
import compiler.check.resolve (ResolveOutcome, ResolveSucceeded, ResolveFailed, resolve_packaged)
import compiler.check.resolve.scopes (no_packages)
import compiler.check.infer.checker (Builtin, builtins, WitnessOrder, MemberSite)
import compiler.emit.keys (test_owner, law_owner)
import compiler.check.infer (BodyFacts, body_facts_bin, types_named)
import compiler.check.typed (TypedBody, witness_param_name)
import compiler.front.facts (Analysis, cuts_of)
import compiler.front.rows (Rows, KnownDefinitionRow, KnownTestRow, Cut)
import compiler.front.emitter_input (InferredFacts, Analysed, Rejected)
import compiler.front.published (analyse, rows_of, inferred_facts)
import compiler.front (analyse_pulling_std)
import compiler.store.hash.encoding (hex)
import compiler.front.interface (blank_cuts)
import compiler.check.callbacks (CallbackArgument, Element, Accumulator, ExtractedFrom, Number,
                                 UnknownArgument, Folded, prelude_callback_use)
import compiler.front.diagnostics (parse_all, parse_at, parse_from)
import std.bin
import std.hash (blake3)
import std.list
import std.bytes (ascii_of_int)
import compiler.prelude_source

type Cause =
  | ReadAgain
  | MapEntry
  | CapturedValue
  | CallerKeeps
  | ContainerElement
  | TopLevelValue
  | CallResult
  | HandlerResult
  | ClosureParam

type Reason = { cause: Cause, text: Bytes }

type Owner = | FreshOwner | ParamOwner(Int) | SharedOwner(Reason) | UnknownOwner(Reason)

type ParamSharing = | SoleParam | UnsureParam(Reason) | SharedParam(Reason)

type ReturnOwnership =
  | FreshReturn
  | ReturnOfParam(Int)
  | SharedReturn(Reason)
  | UnsureReturn(Reason)

type Tables = { params: List<List<ParamSharing>>, rets: List<ReturnOwnership> }

type Bind = { slot: Int, owner: Owner }

type PassedArgument = { callee: Int, param: Int, owner: Owner }

type RawSite = { span: Span, builtin_name: Bytes, owner: Owner }

type ReturnRead = { callee: Int, ret: ReturnOwnership }

type NameLookup = { name: Bytes, bound: Option<Bytes>, definition: Option<Int> }

type CostState = {
  chain: List<Bind>,
  sites: List<RawSite>,
  demands: List<PassedArgument>,
  escaped: List<Int>,
  reads: List<ReturnRead>,
  lookups: List<NameLookup>,
}

type CachedLookup = { name: Bytes, bound: Option<Bytes>, definition: Bool }

type CachedRead = { callee: Bytes, ret: ReturnOwnership }

type CachedDemand = { callee: Bytes, param: Int, owner: Owner }

type CachedWalk = {
  reads: List<CachedRead>,
  sites: List<RawSite>,
  demands: List<CachedDemand>,
  escaped: List<Bytes>,
  ret: Owner,
}

type CachedBody = {
  kind: Bytes,
  name: Bytes,
  label: Bytes,
  definition: Option<Bytes>,
  arity: Int,
  reuse: Option<Span>,
  lookups: List<CachedLookup>,
  walks: List<CachedWalk>,
}

type CachedModule = { bodies: List<CachedBody> }

derive bin for Cause
derive bin for Reason
derive bin for Owner
derive bin for ReturnOwnership
derive bin for RawSite
derive bin for CachedLookup
derive bin for CachedRead
derive bin for CachedDemand
derive bin for CachedWalk
derive bin for CachedBody
derive bin for CachedModule

type WithOwner = { state: CostState, owner: Owner }

type Arms = { state: CostState, owner: Option<Owner> }

type Args = { state: CostState, owners: List<Owner> }

type Definition = {
  name: Bytes,
  module_index: Int,
  module_name: Bytes,
  params: List<Bytes>,
  arity: Int,
  own: Bool,
  declared_return: Option<{ ret: ReturnOwnership, span: Span }>,
}

type Body = {
  item_kind: Bytes,
  module: Int,
  module_name: Bytes,
  name: Bytes,
  label: Bytes,
  definition_index: Int,
  arity: Int,
  span: Span,
  code: Option<Code>,
  moves: Moves,
  lowered: Bool,
  reuse: Option<Span>,
  looked: List<CachedLookup>,
  cached_walks: List<WalkResult>,
}

type WalkResult = {
  sites: List<RawSite>,
  demands: List<PassedArgument>,
  used_as_values: List<Int>,
  ret: Owner,
  reads: List<ReturnRead>,
  lookups: List<NameLookup>,
}

type Program = {
  r: Resolution,
  index: Map<Bytes, Int>,
  builtins: Map<Bytes, Bool>,
  definitions: List<Definition>,
  bodies: List<Body>,
}

type Env = { prog: Program, module: Int, tables: Tables, moves: Moves }

type Parsed = { name: Bytes, module: Module, derived: List<DeriveOrigin>, bad: Bool }

fn blocked(cause: Cause, text: Bytes) -> Owner = SharedOwner({ cause: cause, text: text })

fn unknown(cause: Cause, text: Bytes) -> Owner = UnknownOwner({ cause: cause, text: text })

fn reworded(reason: Reason, text: Bytes) -> Reason = { cause: reason.cause, text: text }

fn fresh(state: CostState) -> WithOwner = { state: state, owner: FreshOwner }

fn element_owner() -> Owner =
  blocked(ContainerElement, b"an element of the list being iterated over, which the list still owns")

fn owner_at(xs: List<Owner>, i: Int) -> Owner = match xs.at(i) { Some(o) -> o, None -> FreshOwner }

fn owner_of(state: CostState, slot: Int) -> Option<Owner> =
  state.chain.fold(None, |acc: Option<Owner>, b: Bind|
    if b.slot == slot { Some(b.owner) } else { acc })

fn bind(state: CostState, slot: Int, owner: Owner) -> CostState =
  { ..state, chain: state.chain.push({ slot: slot, owner: owner }) }

fn rebind(state: CostState, slot: Int, owner: Owner) -> CostState =
  {
    ..state,
    chain: state.chain.map(|b: Bind| if b.slot == slot { { slot: slot, owner: owner } } else { b }),
  }

fn add_site(state: CostState, span: Span, op: Bytes, owner: Owner) -> CostState =
  { ..state, sites: state.sites.push({ span: span, builtin_name: op, owner: owner }) }

fn add_demand(state: CostState, d: PassedArgument) -> CostState =
  { ..state, demands: state.demands.push(d) }

fn add_escaped(state: CostState, d: Int) -> CostState = { ..state, escaped: state.escaped.push(d) }

fn look(state: CostState, name: Bytes, found: Bound) -> CostState =
  {
    ..state,
    lookups: state.lookups.push({ name: name, bound: found.bound, definition: found.definition }),
  }

fn with_chain(state: CostState, chain: List<Bind>) -> CostState = { ..state, chain: chain }

fn walk(env: Env, c: Code, state: CostState) -> WithOwner / {abort.raise} =
  match c.node {
    CodeLiteral(_) -> fresh(state),
    CodeLabel(_) -> fresh(state),
    CodeVar(v) -> var_owner(env, v.name, v.slot, read_moved(env.moves, c.span), state),
    NDefinition(_) -> global_read(env, c, state),
    NConstructor(_) -> global_read(env, c, state),
    NBuiltin(_) -> global_read(env, c, state),
    CodeUnary(u) -> fresh(walk(env, u.operand, state).state),
    CodeBinary(b) -> fresh(walk(env, b.rhs, walk(env, b.lhs, state).state).state),
    CodeLambda(l) ->
      fresh(
        mark_captured_shared(
          env,
          walk_nested_body(env, l.params, [], l.body, state),
          l.captures,
          l.body,
          l.at,
        ),
      ),
    CodeParallel(pr) ->
      fresh(pr.branches.fold(state, |s: CostState, b: Code| walk(env, b, s).state)),
    CodeApply(a) -> app(env, c.span, a.function, a.args, state),
    CodeKnownLambda(k) -> var_owner(env, k.name, k.slot, read_moved(env.moves, c.span), state),
    CodeIf(i) -> {
      let t = walk(env, i.then_branch, walk(env, i.cond, state).state);
      let e = walk(env, i.else_branch, t.state);
      { state: e.state, owner: join(t.owner, e.owner) }
    },
    CodeMatch(m) -> {
      let sc = walk(env, m.scrutinee, state);
      let arms = m.arms.fold({ state: sc.state, owner: None }, |acc: Arms, a: CodeArm| {
        let bound = pattern_slots(a.pattern).fold(acc.state, |s: CostState, slot: Int|
          bind(s, slot, sc.owner));
        let guarded = match a.guard { Some(g) -> walk(env, g, bound).state, None -> bound };
        let w = walk(env, a.body, guarded);
        {
          state: w.state,
          owner: Some(match acc.owner { None -> w.owner, Some(prev) -> join(prev, w.owner) }),
        }
      });
      { state: arms.state, owner: match arms.owner { Some(o) -> o, None -> FreshOwner } }
    },
    CodeBlock(b) -> {
      let s = b.statements.fold(state, |acc: CostState, stmt: CodeStatement|
        match stmt {
          CodeLet(l) -> {
            let w = walk(env, l.value, acc);
            bind(w.state, l.slot, w.owner)
          },
          CodeLetDestructure(l) -> {
            let w = walk(env, l.value, acc);
            pattern_slots(l.pattern).fold(w.state, |s2: CostState, slot: Int|
              bind(s2, slot, w.owner))
          },
          CodeDo(d) -> walk(env, d.code, acc).state,
        });
      match b.tail { Some(t) -> walk(env, t, s), None -> fresh(s) }
    },
    CodeRecord(r) ->
      fresh(r.fields.fold(state, |acc: CostState, f: CodeField| walk(env, f.value, acc).state)),
    CodeUpdate(u) ->
      fresh(
        walk(
          env,
          u.base,
          u.sets.fold(state, |acc: CostState, f: CodeField| walk(env, f.value, acc).state),
        ).state,
      ),
    CodeFieldRead(f) -> {
      let b = match f.base.node {
        CodeVar(v) -> if field_moved(env.moves, c.span) {
          var_owner(env, v.name, v.slot, true, state)
        } else { walk(env, f.base, state) },
        _ -> walk(env, f.base, state),
      };
      match b.owner {
        SharedOwner(reason) ->
          {
            state: b.state,
            owner: blocked(
              reason.cause,
              Bytes::concat_all([
                b"`.",
                f.field,
                b"` was read from a record that another value still owns: ",
                reason.text,
              ]),
            ),
          },
        _ -> b,
      }
    },
    CodeList(l) -> fresh(l.items.fold(state, |acc: CostState, x: Code| walk(env, x, acc).state)),
    CodePerform(p) ->
      {
        state: p.args.fold(
          match p.label { Some(x) -> walk(env, x, state).state, None -> state },
          |acc: CostState, x: Code| walk(env, x, acc).state,
        ),
        owner: unknown(
          HandlerResult,
          b"the value a handler returned, which the handler may still reference",
        ),
      },
    CodeHandle(h) -> {
      let caught = h.clauses.fold(state, |acc: CostState, cl: CodeClause|
        mark_captured_shared(env, acc, cl.captures, cl.body, cl.at));
      let armed = match h.ret {
        Some(r) -> mark_captured_shared(env, caught, r.captures, r.body, r.at),
        None -> caught,
      };
      let ran = walk(env, h.body, armed).state;
      let clauses = h.clauses.fold(ran, |acc: CostState, cl: CodeClause|
        walk_nested_body(env, cl.params + (if cl.resume { 1 } else { 0 }), [], cl.body, acc));
      {
        state: match h.ret {
          Some(r) -> walk_nested_body(env, 1, [], r.body, clauses),
          None -> clauses,
        },
        owner: unknown(HandlerResult, b"the value a `handle` returned"),
      }
    },
    CodeSimulate(x) ->
      {
        state: walk_nested_body(
          env,
          0,
          [],
          x.body,
          mark_captured_shared(env, state, x.captures, x.body, x.at),
        ),
        owner: unknown(HandlerResult, b"the value a `simulate` returned"),
      },
  }

fn join(a: Owner, b: Owner) -> Owner =
  match a {
    SharedOwner(_) -> a,
    _ -> match b {
      SharedOwner(_) -> b,
      _ -> match a {
        UnknownOwner(_) -> a,
        _ -> match b { UnknownOwner(_) -> b, _ -> match a { ParamOwner(_) -> a, _ -> b } },
      },
    },
  }

fn walk_nested_body(
  env: Env,
  n: Int,
  owners: List<Owner>,
  body: Code,
  state: CostState,
) -> CostState / {abort.raise} = {
  let inner = with_chain(
    state,
    range(0, n).map(|i: Int|
      {
        slot: i,
        owner: match owners.at(i) {
          Some(o) -> o,
          None ->
            unknown(ClosureParam, b"a parameter of a closure whose callers this body cannot identify"),
        },
      }),
  );
  with_chain(walk(env, body, inner).state, state.chain)
}

fn mark_captured_shared(
  env: Env,
  state: CostState,
  caps: List<Capture>,
  body: Code,
  at: Span,
) -> CostState =
  caps.fold(state, |acc: CostState, capture: Capture|
    if capture_moved(env.moves, at, capture.src) { acc } else {
      match owner_of(acc, capture.src) {
        None -> acc,
        Some(SharedOwner(_)) -> acc,
        Some(_) ->
          rebind(
            acc,
            capture.src,
            blocked(
              CapturedValue,
              Bytes::concat_all([
                b"a closure captured `",
                match first_name(body, capture.destination) { Some(n) -> n, None -> b"" },
                b"`, so the closure owns its own copy of the value",
              ]),
            ),
          ),
      }
    })

fn first_name(c: Code, slot: Int) -> Option<Bytes> =
  match c.node {
    CodeVar(v) -> if v.slot == slot { Some(v.name) } else { None },
    CodeLambda(l) -> through(l.captures, l.body, slot),
    CodeSimulate(x) -> through(x.captures, x.body, slot),
    CodeHandle(h) -> {
      let found = h.clauses.fold(
        first_name(h.body, slot),
        |acc: Option<Bytes>, clause: CodeClause|
          match acc { Some(_) -> acc, None -> through(clause.captures, clause.body, slot) },
      );
      match found {
        Some(_) -> found,
        None -> match h.ret { Some(r) -> through(r.captures, r.body, slot), None -> None },
      }
    },
    _ ->
      children(c).fold(None, |acc: Option<Bytes>, x: Code|
        match acc { Some(_) -> acc, None -> first_name(x, slot) }),
  }

fn through(caps: List<Capture>, body: Code, slot: Int) -> Option<Bytes> =
  caps.fold(None, |acc: Option<Bytes>, capture: Capture|
    match acc {
      Some(_) -> acc,
      None -> if capture.src == slot { first_name(body, capture.destination) } else { None },
    })

fn children(c: Code) -> List<Code> =
  match c.node {
    CodeUnary(u) -> [u.operand],
    CodeBinary(b) -> [b.lhs, b.rhs],
    CodeApply(a) -> a.args.fold([a.function], |acc: List<Code>, x: Code| acc.push(x)),
    CodeKnownLambda(_) -> [],
    CodeIf(i) -> [i.cond, i.then_branch, i.else_branch],
    CodeBlock(b) -> {
      let statements = b.statements.map(|stmt: CodeStatement|
        match stmt {
          CodeLet(l) -> l.value,
          CodeLetDestructure(l) -> l.value,
          CodeDo(d) -> d.code,
        });
      match b.tail { Some(t) -> statements.push(t), None -> statements }
    },
    CodeList(l) -> l.items,
    CodeRecord(r) -> r.fields.map(|f: CodeField| f.value),
    CodeUpdate(u) -> u.sets.map(|f: CodeField| f.value).push(u.base),
    CodeFieldRead(f) -> [f.base],
    CodeMatch(m) ->
      m.arms.fold([m.scrutinee], |acc: List<Code>, a: CodeArm|
        List::push(match a.guard { Some(g) -> acc.push(g), None -> acc }, a.body)),
    CodePerform(p) -> p.args,
    CodeParallel(pr) -> pr.branches,
    _ -> [],
  }

fn unbound_owner(name: Bytes) -> Owner =
  unknown(
    ClosureParam,
    Bytes::concat_all([
      b"`",
      name,
      b"` is free in this closure; whether the closure's copy is the only other owner when the update runs is not a property of this body",
    ]),
  )

fn var_owner(env: Env, name: Bytes, slot: Int, moved: Bool, state: CostState) -> WithOwner =
  match owner_of(state, slot) {
    Some(o) ->
      {
        state: state,
        owner: if moved { o } else {
          blocked(
            ReadAgain,
            Bytes::concat_all([
              b"`",
              name,
              b"` is read again after this point, so this use clones it",
            ]),
          )
        },
      },
    None -> { state: state, owner: unbound_owner(name) },
  }

fn global_named(prog: Program, c: Code) -> Option<{ name: Bytes, found: Bound }> =
  match c.node {
    NDefinition(d) -> match prelude_own(d.full) {
      Some(name) -> Some({ name: name, found: { bound: None, definition: None } }),
      None ->
        Some({ name: d.full, found: { bound: Some(d.full), definition: prog.index.get(d.full) } }),
    },
    NConstructor(k) -> Some({ name: k.name, found: { bound: Some(k.name), definition: None } }),
    NBuiltin(b) -> Some({ name: b.name, found: { bound: None, definition: None } }),
    _ -> None,
  }

fn global_read(env: Env, c: Code, state: CostState) -> WithOwner =
  match global_named(env.prog, c) { Some(n) -> global_owner(n, state), None -> fresh(state) }

fn global_owner(named: { name: Bytes, found: Bound }, state: CostState) -> WithOwner = {
  let looked = look(state, named.name, named.found);
  match named.found.definition {
    Some(d) ->
      {
        state: add_escaped(looked, d),
        owner: blocked(TopLevelValue, b"a top-level definition, which stays alive for the whole program"),
      },
    None -> { state: looked, owner: unbound_owner(named.name) },
  }
}

type Bound = { bound: Option<Bytes>, definition: Option<Int> }

fn app(
  env: Env,
  span: Span,
  function: Code,
  args: List<Code>,
  state: CostState,
) -> WithOwner / {abort.raise} = {
  let named = global_named(env.prog, function);
  let callee = match named { Some(x) -> x.found.definition, None -> None };
  let builtin = match named {
    Some(x) -> if x.found.definition != None || !env.prog.builtins.contains(x.name) { None }
    else { Some(x.name) },
    None -> None,
  };
  let n = args.len();
  let before = match named {
    Some(x) -> look(state, x.name, x.found),
    None -> match function.node { CodeVar(_) -> state, _ -> walk(env, function, state).state },
  };
  let walked: Args = args.fold({ state: before, owners: [] }, |acc: Args, arg: Code| {
    let w = match callback_owners(builtin, acc.owners.len(), acc.owners) {
      Some(owners) -> callback(env, owners, arg, acc.state),
      None -> walk(env, arg, acc.state),
    };
    { state: w.state, owners: acc.owners.push(w.owner) }
  });
  let sited = match update_of(builtin, n) {
    Some(op) -> add_site(walked.state, span, op, owner_at(walked.owners, 0)),
    None -> walked.state,
  };
  let demanded = match callee {
    None -> sited,
    Some(d) ->
      range(0, n).fold(sited, |acc: CostState, j: Int|
        match owner_at(walked.owners, j) {
          FreshOwner -> acc,
          o -> add_demand(acc, { callee: d, param: j, owner: o }),
        }),
  };
  let read = match ((builtin, callee)) {
    (None, Some(d)) -> match env.tables.rets.at(d) {
      Some(r) -> { ..demanded, reads: demanded.reads.push({ callee: d, ret: r }) },
      None -> demanded,
    },
    _ -> demanded,
  };
  { state: read, owner: result_owner(env, builtin, callee, walked.owners) }
}

fn update_of(builtin: Option<Bytes>, n: Int) -> Option<Bytes> =
  match builtin {
    Some(b) -> if (b == b"List::push" && n == 2)
        || ((b == b"List::set" || b == b"Array::set") && n == 3) { Some(b) }
    else { None },
    None -> None,
  }

fn container_name(op: Bytes) -> Bytes = if op == b"Array::set" { b"array" } else { b"list" }

fn result_owner(env: Env, builtin: Option<Bytes>, callee: Option<Int>, args: List<Owner>) -> Owner =
  match builtin {
    None -> match callee {
      None -> unknown(CallResult, b"the value a call returned, which the callee may still reference"),
      Some(d) -> match env.tables.rets.at(d) {
        Some(ReturnOfParam(k)) -> match args.at(k) {
          Some(o) -> o,
          None -> unknown(CallResult, b"a call returning an argument it was not given"),
        },
        Some(SharedReturn(reason)) -> SharedOwner(reason),
        Some(UnsureReturn(reason)) -> UnknownOwner(reason),
        _ -> FreshOwner,
      },
    },
    Some(b) -> if b == b"Scoped::get" {
      blocked(ContainerElement, b"`Scoped::get` returns a copy of a value the scope still owns")
    } else if b == b"Map::get" || reads_entries(b) {
      blocked(MapEntry, Bytes::concat_all([b"`", b, b"` returns a clone the map still contains"]))
    } else if b == b"Map::pop_first" || b == b"Map::pop_last" || b == b"Map::split" {
      owner_at(args, 0)
    } else if b == b"List::at" {
      blocked(ContainerElement, b"`List::at` returns a clone of an element the list still owns")
    } else if b == b"Array::at" || b == b"Array::get" {
      blocked(
        ContainerElement,
        Bytes::concat_all([b"`", b, b"` returns a clone the array still contains"]),
      )
    } else if b == b"bracket" {
      unknown(CallResult, b"`bracket` returns whatever its body returned")
    } else {
      match prelude_callback_use(b) {
        Some(it) -> if it.result == Folded {
          unknown(
            CallResult,
            Bytes::concat_all([b"`", b, b"` returns whatever its callback returned"]),
          )
        } else { FreshOwner },
        None -> FreshOwner,
      }
    },
  }

fn reads_entries(b: Bytes) -> Bool =
  b == b"Map::first" || b == b"Map::last" || b == b"Map::floor" || b == b"Map::ceiling"
    || b == b"Map::below"
    || b == b"Map::above"
    || b == b"Map::range"

fn callback_owners(
  builtin: Option<Bytes>,
  position: Int,
  done: List<Owner>,
) -> Option<List<Owner>> =
  match builtin {
    None -> None,
    Some(b) -> match prelude_callback_use(b) {
      None -> None,
      Some(it) -> if it.callback != position { None } else {
        let given = |k: Int|
          match done.at(k) {
            Some(o) -> o,
            None -> unknown(CallResult, b"an argument written after the callback in the call's argument list"),
          };
        Some(
          it.params.map(|h: CallbackArgument|
            match h {
              Element -> element_owner(),
              Accumulator(k) -> given(k),
              ExtractedFrom(k) -> given(k),
              Number -> FreshOwner,
              UnknownArgument ->
                unknown(
                  ClosureParam,
                  b"a parameter of a closure whose callers this body cannot identify",
                ),
            }),
        )
      },
    },
  }

fn callback(
  env: Env,
  owners: List<Owner>,
  arg: Code,
  state: CostState,
) -> WithOwner / {abort.raise} =
  match arg.node {
    CodeLambda(l) ->
      fresh(
        mark_captured_shared(
          env,
          walk_nested_body(env, l.params, owners, l.body, state),
          l.captures,
          l.body,
          l.at,
        ),
      ),
    _ -> walk(env, arg, state),
  }

fn sharing_rank(p: ParamSharing) -> Int =
  match p { SoleParam -> 2, UnsureParam(_) -> 1, SharedParam(_) -> 0 }

fn meet(a: ParamSharing, b: ParamSharing) -> ParamSharing =
  if sharing_rank(b) < sharing_rank(a) { b } else { a }

fn param_at(tables: Tables, d: Int, k: Int) -> Option<ParamSharing> =
  match tables.params.at(d) { Some(slots) -> slots.at(k), None -> None }

fn combine_all_params(tables: Tables, d: Int, p: ParamSharing) -> Tables =
  match tables.params.at(d) {
    None -> tables,
    Some(slots) ->
      { ..tables, params: tables.params.set(d, slots.map(|s: ParamSharing| meet(s, p))) },
  }

fn combine_param(tables: Tables, d: Int, j: Int, p: ParamSharing) -> Tables =
  match tables.params.at(d) {
    None -> tables,
    Some(slots) -> match slots.at(j) {
      None -> tables,
      Some(s) -> { ..tables, params: tables.params.set(d, slots.set(j, meet(s, p))) },
    },
  }

fn with_return(tables: Tables, d: Int, r: ReturnOwnership) -> Tables / {abort.raise} =
  { ..tables, rets: tables.rets.set(d, r) }

fn return_of(owner: Owner) -> ReturnOwnership =
  match owner {
    FreshOwner -> FreshReturn,
    ParamOwner(k) -> ReturnOfParam(k),
    SharedOwner(reason) -> SharedReturn(reason),
    UnknownOwner(reason) -> UnsureReturn(reason),
  }

fn interpret(owner: Owner, caller: Int, tables: Tables, label: Bytes) -> ParamSharing =
  match owner {
    FreshOwner -> SoleParam,
    SharedOwner(reason) ->
      SharedParam(
        reworded(reason, Bytes::concat_all([label, b" passes a value; reason: ", reason.text])),
      ),
    UnknownOwner(reason) ->
      UnsureParam(
        reworded(reason, Bytes::concat_all([label, b" passes a value; reason: ", reason.text])),
      ),
    ParamOwner(k) -> match param_at(tables, caller, k) {
      Some(SoleParam) -> SoleParam,
      Some(UnsureParam(reason)) ->
        UnsureParam(
          reworded(
            reason,
            Bytes::concat_all([
              label,
              b" passes its own parameter ",
              ascii_of_int(k),
              b", whose ownership is not yet known",
            ]),
          ),
        ),
      Some(SharedParam(reason)) ->
        SharedParam(
          reworded(
            reason,
            Bytes::concat_all([
              label,
              b" passes its own parameter ",
              ascii_of_int(k),
              b", which the function's callers may still use after the call",
            ]),
          ),
        ),
      None ->
        UnsureParam({
          cause: CallerKeeps,
          text: Bytes::concat_all([label, b" passes a parameter this analysis cannot identify"]),
        }),
    },
  }

fn start_tables(definitions: List<Definition>) -> Tables =
  {
    params: definitions.map(|d: Definition| range(0, d.arity).map(|_: Int| SoleParam)),
    rets: definitions.map(|d: Definition|
      if d.own { FreshReturn } else {
        match d.declared_return {
          Some(x) -> x.ret,
          None ->
            UnsureReturn({
              cause: CallResult,
              text: Bytes::concat_all([
                b"`",
                d.name,
                b"` is another package's, and its signature writes no `returns`",
              ]),
            }),
        }
      }),
  }

fn walk_body(env: Env, b: Body) -> WalkResult / {abort.raise} =
  match b.code {
    None ->
      {
        sites: [],
        demands: [],
        used_as_values: [],
        ret: unknown(CallResult, b"the value a call returned, which the callee may still reference"),
        reads: [],
        lookups: [],
      },
    Some(c) -> {
      let chain = range(0, b.arity).map(|k: Int|
        { slot: k, owner: if b.definition_index < 0 { FreshOwner } else { ParamOwner(k) } });
      let w = walk({ ..env, moves: b.moves }, c, {
        chain: chain,
        sites: [],
        demands: [],
        escaped: [],
        reads: [],
        lookups: [],
      });
      {
        sites: w.state.sites,
        demands: w.state.demands,
        used_as_values: w.state.escaped,
        ret: w.owner,
        reads: w.state.reads,
        lookups: w.state.lookups,
      }
    },
  }

fn resolve(program: Program, found: List<WalkResult>, tables: Tables) -> Tables / {abort.raise} =
  range(0, program.bodies.len()).fold(start_tables(program.definitions), |acc: Tables, i: Int| {
    let b: Body = program.bodies.get(i);
    let f: WalkResult = found.get(i);
    let escaped = f.used_as_values.fold(acc, |s: Tables, d: Int|
      combine_all_params(
        s,
        d,
        UnsureParam({
          cause: TopLevelValue,
          text: Bytes::concat_all([
            b"`",
            program.definitions.get(d).name,
            b"` is used as a value in ",
            b.label,
            b", so not every caller of it is known",
          ]),
        }),
      ));
    let demanded = f.demands.fold(escaped, |s: Tables, dm: PassedArgument|
      combine_param(
        s,
        dm.callee,
        dm.param,
        interpret(dm.owner, b.definition_index, tables, b.label),
      ));
    if b.definition_index < 0 { demanded }
    else { with_return(demanded, b.definition_index, return_of(f.ret)) }
  })

fn no_walk_result() -> WalkResult =
  { sites: [], demands: [], used_as_values: [], ret: FreshOwner, reads: [], lookups: [] }

type WalkSource = | Unchanged | MadeThisRun(Int) | Cached(Int) | NeedsWalk

type Run = {
  prog: Program,
  found: List<WalkResult>,
  used_cached: List<List<Int>>,
  made: List<List<WalkResult>>,
  whole_program: Option<WholeProgram>,
  fresh: Map<Int, Bool>,
  lowered_count: Int,
  failed: Bool,
}

type Resolved = { run: Run, tables: Tables, rounds: Int }

fn reads_unchanged(f: WalkResult, rets: List<ReturnOwnership>) -> Bool =
  f.reads.fold(true, |acc: Bool, r: ReturnRead| acc && rets.at(r.callee) == Some(r.ret))

fn first_valid(
  walks: List<WalkResult>,
  rets: List<ReturnOwnership>,
) -> Option<Int> / {abort.raise} =
  range(0, walks.len()).fold(None, |acc: Option<Int>, j: Int|
    match acc {
      Some(_) -> acc,
      None -> if reads_unchanged(walks.get(j), rets) { Some(j) } else { None },
    })

fn keys_of(m: Map<Int, Bool>) -> List<Int> =
  m.fold([], |acc: List<Int>, k: Int, _: Bool| acc.push(k))

fn evaluate(p: CostInput, run: Run, which: (Int) -> Bool, tables: Tables) -> Run / {abort.raise} =
  if run.failed { run } else {
    let n = run.prog.bodies.len();
    let tried = range(0, n).map(|i: Int|
      if !which(i) { Unchanged } else {
        match first_valid(run.made.get(i), tables.rets) {
          Some(j) -> MadeThisRun(j),
          None -> match first_valid(run.prog.bodies.get(i).cached_walks, tables.rets) {
            Some(j) -> Cached(j),
            None -> NeedsWalk,
          },
        }
      });
    let unlowered = range(0, n).fold(Map::new(), |acc: Map<Int, Bool>, i: Int|
      match tried.get(i) {
        NeedsWalk -> {
          let b: Body = run.prog.bodies.get(i);
          if b.lowered { acc } else { acc.insert(b.module, true) }
        },
        _ -> acc,
      });
    let ready = if unlowered.len() == 0 { run } else { relowered(p, run, keys_of(unlowered)) };
    if ready.failed { ready } else {
      let which = range(0, n).filter(|i: Int| match tried.get(i) { NeedsWalk -> true, _ -> false });
      let found = walks_at_once(
        { prog: ready.prog, tables: tables, body_indexes: which },
        0,
        which.len(),
        64,
      );
      let walks = range(0, which.len()).fold(Map::new(), |acc: Map<Int, WalkResult>, k: Int|
        acc.insert(which.get(k), found.get(k)));
      let walked = |i: Int| match walks.get(i) { Some(f) -> f, None -> no_walk_result() };
      {
        ..ready,
        found: range(0, n).map(|i: Int|
          match tried.get(i) {
            Unchanged -> ready.found.get(i),
            MadeThisRun(j) -> ready.made.get(i).get(j),
            Cached(j) -> ready.prog.bodies.get(i).cached_walks.get(j),
            NeedsWalk -> walked(i),
          }),
        used_cached: range(0, n).map(|i: Int| {
          let took: List<Int> = ready.used_cached.get(i);
          match tried.get(i) {
            Cached(j) -> if took.contains(j) { took } else { took.push(j) },
            _ -> took,
          }
        }),
        made: range(0, n).map(|i: Int|
          match tried.get(i) {
            NeedsWalk -> ready.made.get(i).push(walked(i)),
            _ -> ready.made.get(i),
          }),
      }
    }
  }

type WalkBatch = { prog: Program, tables: Tables, body_indexes: List<Int> }

fn walks_at_once(x: WalkBatch, lo: Int, hi: Int, room: Int) -> List<WalkResult> / {abort.raise} =
  if hi - lo <= 16 {
    range(lo, hi).map(|k: Int| {
      let b: Body = x.prog.bodies.get(x.body_indexes.get(k));
      walk_body({ prog: x.prog, module: b.module, tables: x.tables, moves: no_moves() }, b)
    })
  } else if room <= 0 { panic("the list of bodies was split in half more times than its length allows") } else {
    let mid = lo + (hi - lo) / 2;
    let both = parallel {
      walks_at_once(x, lo, mid, room - 1),
      walks_at_once(x, mid, hi, room - 1),
    };
    both._0.concat(both._1)
  }

fn relowered(p: CostInput, run: Run, modules: List<Int>) -> Run / {abort.raise} =
  match lower(p, run.whole_program, modules, run.prog.index) {
    None -> { ..run, failed: true },
    Some(l) -> {
      let made = range(0, modules.len()).fold(Map::new(), |acc: Map<Int, List<Body>>, k: Int|
        acc.insert(modules.get(k), l.bodies.get(k)));
      let placed = run.prog.bodies.fold(
        { bodies: [], seen: Map::new() },
        |acc: { bodies: List<Body>, seen: Map<Int, Int> }, b: Body|
          match made.get(b.module) {
            None -> { ..acc, bodies: acc.bodies.push(b) },
            Some(lowered) -> {
              let k = match acc.seen.get(b.module) { Some(x) -> x, None -> 0 };
              match lowered.at(k) {
                Some(m) -> if m.label != b.label || m.item_kind != b.item_kind {
                  panic("recompiling a module produced different function bodies than the module had before")
                } else {
                  {
                    bodies: acc.bodies.push({
                      ..b,
                      code: m.code,
                      span: m.span,
                      moves: m.moves,
                      lowered: true,
                    }),
                    seen: acc.seen.insert(b.module, k + 1),
                  }
                },
                None -> panic("a module was lowered to fewer function bodies than the program already contained for it"),
              }
            },
          },
      );
      {
        ..run,
        prog: { ..run.prog, r: prefer_whole(l.whole, run.prog.r), bodies: placed.bodies },
        whole_program: l.whole,
        lowered_count: run.lowered_count + modules.len(),
      }
    },
  }

fn readers_of(found: List<WalkResult>) -> Map<Int, List<Int>> / {abort.raise} =
  range(0, found.len()).fold(Map::new(), |acc: Map<Int, List<Int>>, i: Int|
    found.get(i).reads.fold(acc, |m: Map<Int, List<Int>>, r: ReturnRead| {
      let was = match m.get(r.callee) { Some(xs) -> xs, None -> [] };
      if was.len() > 0 && was.get(was.len() - 1) == i { m } else { m.insert(r.callee, was.push(i)) }
    }))

fn moved_readers(readers: Map<Int, List<Int>>, before: Tables, after: Tables) -> Map<Int, Bool> =
  range(0, after.rets.len()).fold(Map::new(), |acc: Map<Int, Bool>, d: Int|
    if before.rets.at(d) == after.rets.at(d) { acc } else {
      match readers.get(d) {
        None -> acc,
        Some(xs) -> xs.fold(acc, |m: Map<Int, Bool>, i: Int| m.insert(i, true)),
      }
    })

fn iterate(
  p: CostInput,
  run: Run,
  readers: Map<Int, List<Int>>,
  tables: Tables,
  rounds: Int,
) -> Resolved / {abort.raise} = {
  let next = resolve(run.prog, run.found, tables);
  let moved = moved_readers(readers, tables, next);
  let walked = evaluate(p, run, |i: Int| moved.contains(i), next);
  if walked.failed || next == tables || rounds + 1 >= 24 {
    { run: walked, tables: next, rounds: rounds + 1 }
  } else { iterate(p, walked, readers, next, rounds + 1) }
}

fn suggestion_for(cause: Option<Cause>) -> Bytes =
  match cause {
    Some(ReadAgain) ->
      b"make the update the last use of the variable: first bind anything else you need from the variable to new names",
    Some(MapEntry) -> b"`Map::update`",
    Some(CapturedValue) -> b"bind the value before the closure captures it, or capture less",
    Some(CallerKeeps) -> b"change the call site: the caller uses the value it passes again after the call",
    _ -> b"",
  }

pub type Site = {
  start: Int,
  end: Int,
  op: Bytes,
  verdict: Bytes,
  reason: Bytes,
  suggestion: Bytes,
  param: Int,
}

pub type Costed = {
  item_kind: Bytes,
  module: Int,
  module_name: Bytes,
  name: Bytes,
  label: Bytes,
  reuse_keyword: Option<Span>,
  sites: List<Site>,
}

pub type ReturnMismatch = {
  module: Int,
  module_name: Bytes,
  name: Bytes,
  start: Int,
  end: Int,
  declared: Bytes,
  actual: Bytes,
}

pub type Report = {
  ok: Bool,
  rounds: Int,
  definitions: List<Costed>,
  return_mismatches: List<ReturnMismatch>,
}

derive bin for Site
derive bin for Costed
derive bin for ReturnMismatch
derive bin for Report

fn finish(raw: RawSite, definition: Int, tables: Tables) -> Site = {
  let sited = |verdict: Bytes, reason: Bytes, cause: Option<Cause>, param: Int|
    {
      start: raw.span.start,
      end: raw.span.end,
      op: raw.builtin_name,
      verdict: verdict,
      reason: reason,
      suggestion: suggestion_for(cause),
      param: param,
    };
  match raw.owner {
    FreshOwner ->
      sited(
        b"reuses",
        Bytes::concat_all([
          b"the ",
          container_name(raw.builtin_name),
          b" reaches `",
          raw.builtin_name,
          b"` with a single reference",
        ]),
        None,
        0 - 1,
      ),
    SharedOwner(reason) -> sited(b"copies", reason.text, Some(reason.cause), 0 - 1),
    UnknownOwner(reason) -> sited(b"unknown", reason.text, Some(reason.cause), 0 - 1),
    ParamOwner(k) -> {
      let head = Bytes::concat_all([
        b"the ",
        container_name(raw.builtin_name),
        b" is parameter ",
        ascii_of_int(k),
      ]);
      match param_at(tables, definition, k) {
        Some(SoleParam) ->
          sited(
            b"reuses",
            head.concat(b", and every call site passes it and never uses it again"),
            None,
            k,
          ),
        Some(SharedParam(reason)) ->
          sited(
            b"copies",
            Bytes::concat_all([head, b", and a caller uses it again after the call: ", reason.text]),
            Some(CallerKeeps),
            k,
          ),
        Some(UnsureParam(reason)) ->
          sited(
            b"unknown",
            Bytes::concat_all([head, b", and it is unclear whether a call site uses it again: ", reason.text]),
            Some(reason.cause),
            k,
          ),
        None ->
          sited(
            b"unknown",
            head.concat(b" of a definition the compiler cannot find"),
            Some(CallerKeeps),
            k,
          ),
      }
    },
  }
}

fn quoted(s: Bytes) -> Bytes =
  Bytes::concat_all([
    b"\"",
    Bytes::concat_all(
      range(0, s.len()).map(|i: Int| {
        let c = s.at(i);
        if c == 34 { b"\\\"" }
        else if c == 92 { b"\\\\" }
        else if c == 10 { b"\\n" }
        else if c == 13 { b"\\r" }
        else if c == 9 { b"\\t" }
        else { s.slice(i, i + 1) }
      }),
    ),
    b"\"",
  ])

fn module_bodies(
  i: Int,
  setting: ModuleContext,
  roots: List<ItemRoot>,
  natives: List<Bytes>,
  index: Map<Bytes, Int>,
) -> List<Body> / {abort.raise} = {
  let s = { ..setting, builtins: natives };
  let m = setting.module;
  roots.fold([], |a: List<Body>, ir: ItemRoot| {
    let moves = root_moves(s, ir.root);
    let body = |kind: Bytes, name: Bytes, label: Bytes, definition: Int, span: Span, reuse: Option<Span>|
      {
        item_kind: kind,
        module: i,
        module_name: m,
        name: name,
        label: label,
        definition_index: definition,
        arity: ir.root.params.len(),
        span: span,
        code: Some(ir.root.code),
        moves: moves,
        lowered: true,
        reuse: reuse,
        looked: [],
        cached_walks: [],
      };
    match ir.item {
      FunctionItem(d) ->
        a.push(
          body(
            b"fn",
            d.name.name,
            Bytes::concat_all([m, b".", d.name.name]),
            match index.get(qualify(m, d.name.name)) { Some(k) -> k, None -> 0 - 1 },
            d.span,
            d.reuse,
          ),
        ),
      TestItem(t) ->
        a.push(
          body(
            b"test",
            t.name,
            Bytes::concat_all([m, b": test ", quoted(t.name)]),
            0 - 1,
            t.span,
            None,
          ),
        ),
      LawItem(l) ->
        a.push(
          body(
            b"law",
            l.name,
            Bytes::concat_all([m, b": law ", quoted(l.name)]),
            0 - 1,
            l.span,
            None,
          ),
        ),
      _ -> a,
    }
  })
}

fn definition_of_fn(
  module: Bytes,
  i: Int,
  own: Bool,
  definition: FnDefinition,
  witnesses: List<Bytes>,
) -> Definition / {abort.raise} = {
  let params = witnesses.concat(definition.params.map(|param: Param| param.name.name));
  {
    name: qualify(module, definition.name.name),
    module_index: i,
    module_name: module,
    params: params,
    arity: params.len(),
    own: own,
    declared_return: match definition.returns {
      None -> None,
      Some(ReturnsFresh(sp)) -> Some({ ret: FreshReturn, span: sp }),
      Some(ReturnsParam(x)) ->
        Some({
          ret: ReturnOfParam(
            range(0, params.len()).fold(0, |acc: Int, k: Int|
              if params.get(k) == x.name { k } else { acc }),
          ),
          span: x.span,
        }),
    },
  }
}

fn violates(said: ReturnOwnership, got: ReturnOwnership) -> Bool =
  match got {
    FreshReturn -> false,
    ReturnOfParam(k) -> match said { ReturnOfParam(j) -> j != k, _ -> true },
    _ -> true,
  }

fn return_text(d: Definition, r: ReturnOwnership) -> Bytes =
  match r {
    FreshReturn -> b"fresh",
    ReturnOfParam(k) ->
      Bytes::concat_all([
        b"its parameter `",
        match d.params.at(k) { Some(n) -> n, None -> ascii_of_int(k) },
        b"`",
      ]),
    SharedReturn(reason) -> reason.text,
    UnsureReturn(reason) -> reason.text,
  }

fn return_mismatches_of(program: Program, tables: Tables) -> List<ReturnMismatch> / {abort.raise} =
  range(0, program.definitions.len()).fold([], |acc: List<ReturnMismatch>, i: Int| {
    let d: Definition = program.definitions.get(i);
    match d.declared_return {
      None -> acc,
      Some(x) -> if !d.own { acc } else {
        match tables.rets.at(i) {
          Some(got) -> if !violates(x.ret, got) { acc } else {
            acc.push({
              module: d.module_index,
              module_name: d.module_name,
              name: d.name,
              start: x.span.start,
              end: x.span.end,
              declared: return_text(d, x.ret),
              actual: return_text(d, got),
            })
          },
          None -> acc,
        }
      },
    }
  })

fn builtin_names() -> List<Bytes> / {abort.raise} = builtins().map(|b: Builtin| b.name)

pub type CostInput = { analysis: Analysis, sources: List<Bytes>, rows: Rows, facts: InferredFacts }

pub fn cost_input_of(analysis: Analysis, sources: List<Bytes>) -> CostInput / {abort.raise} =
  { analysis: analysis, sources: sources, rows: rows_of(analysis), facts: inferred_facts(analysis) }

fn own_module(a: Analysis, i: Int) -> Bool =
  match a.module_packages.at(i) { Some(k) -> k == 0, None -> true }

fn places(modules: List<ParsedModule>) -> Map<Bytes, Int> / {abort.raise} =
  range(0, modules.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int|
    acc.insert(modules.get(i).name, i))

fn placed(here: Map<Bytes, Int>, names: List<Bytes>, k: Int) -> Option<Int> =
  match names.at(k) { Some(n) -> here.get(n), None -> None }

fn orders_by_module(
  w: InferredFacts,
  modules: List<ParsedModule>,
) -> Map<Int, Map<Bytes, List<Bytes>>> / {abort.raise} = {
  let here = places(modules);
  w.orders.fold(Map::new(), |acc: Map<Int, Map<Bytes, List<Bytes>>>, o: WitnessOrder|
    match placed(here, w.modules, o.module) {
      None -> acc,
      Some(i) -> {
        let was = match acc.get(i) { Some(m) -> m, None -> Map::new() };
        acc.insert(i, was.insert(o.name, o.params))
      },
    })
}

fn definitions_of(a: Analysis, walked: InferredFacts) -> List<Definition> / {abort.raise} = {
  let orders = orders_by_module(walked, a.modules);
  range(0, a.modules.len()).fold([], |acc: List<Definition>, i: Int| {
    let m: ParsedModule = a.modules.get(i);
    let ws = match orders.get(i) { Some(o) -> o, None -> Map::new() };
    m.module.items.fold(acc, |xs: List<Definition>, item: Item|
      match item {
        FunctionItem(d) ->
          xs.push(
            definition_of_fn(m.name, i, own_module(a, i), d, match ws.get(d.name.name) {
              Some(w) -> w.map(witness_param_name),
              None -> [],
            }),
          ),
        _ -> xs,
      })
  })
}

type WholeProgram = { modules: List<ParsedModule>, r: Resolution }

fn whole_program_of(p: CostInput) -> Option<WholeProgram> / {abort.raise} = {
  let a = p.analysis;
  let tables = embed_tables(a.embeds);
  let parsed = range(0, a.modules.len()).map(|i: Int| {
    let name = a.modules.get(i).name;
    let source = { name: name, src: match p.sources.at(i) { Some(src) -> src, None -> b"" } };
    let x = parse_from(
      i,
      source,
      parse(source.src),
      derivations: a.modules.get(i).derived.map(derivation_of),
    );
    let e = inline_embeds_by_name(tables, name, x.module.module);
    {
      name: name,
      module: e.module,
      derived: x.module.derived,
      bad: x.diagnostics.len() > 0 || e.diagnostics.len() > 0,
    }
  });
  if parsed.fold(false, |acc: Bool, x: Parsed| acc || x.bad) { None } else {
    match resolved_as(
        a,
        parsed.map(|x: Parsed| { name: x.name, module: x.module, derived: x.derived }),
      ) {
      ResolveFailed(_) -> None,
      ResolveSucceeded(x) -> Some({ modules: x.modules, r: x.resolution }),
    }
  }
}

fn resolved_as(a: Analysis, modules: List<ParsedModule>) -> ResolveOutcome / {abort.raise} = {
  let shipped = a.packages.len();
  let packaged = if shipped == 0 { no_packages(modules) } else {
    {
      packages: a.packages,
      module_packages: a.module_packages,
      std: shipped - 2,
      compiler: shipped - 1,
      other_shipped_package: shipped,
    }
  };
  resolve_packaged(
    modules,
    packaged.packages,
    packaged.module_packages,
    packaged.std,
    packaged.compiler,
    packaged.other_shipped_package,
  )
}

type Lowered = { bodies: List<List<Body>>, whole: Option<WholeProgram> }

fn lower(
  p: CostInput,
  whole: Option<WholeProgram>,
  wanted: List<Int>,
  index: Map<Bytes, Int>,
) -> Option<Lowered> / {abort.raise} =
  if wanted.len() == 0 { Some({ bodies: [], whole: whole }) } else {
    let a = p.analysis;
    let cut = |i: Int| a.stub_cuts.contains(a.modules.get(i).name);
    let needs = wanted.fold(false, |acc: Bool, i: Int| acc || cut(i));
    let taken = match whole {
      Some(_) -> whole,
      None -> if needs { whole_program_of(p) } else { None },
    };
    let missing = match taken { Some(_) -> false, None -> needs };
    if missing { None } else {
      let tables = embed_tables(a.embeds);
      let wants = wanted.fold(Map::new(), |m: Map<Int, Bool>, i: Int| m.insert(i, true));
      let read = range(0, a.modules.len()).fold(
        { modules: [], bad: false },
        |acc: { modules: List<ParsedModule>, bad: Bool }, i: Int|
          if !wants.contains(i) { { ..acc, modules: acc.modules.push(a.modules.get(i)) } }
          else if cut(i) {
            {
              ..acc,
              modules: acc.modules.push(match taken {
                Some(w) -> w.modules.get(i),
                None -> a.modules.get(i),
              }),
            }
          } else {
            let m: ParsedModule = a.modules.get(i);
            let e = inline_embeds_by_name(tables, m.name, m.module);
            {
              modules: acc.modules.push({ ..m, module: e.module }),
              bad: acc.bad || e.diagnostics.len() > 0,
            }
          },
      );
      if read.bad { None } else {
        let natives = parsed_natives(a.modules).map(|e: Extern| e.name);
        let resolved = match taken { Some(w) -> { ..a, r: w.r }, None -> a };
        match module_contexts_in(
            resolved,
            p.rows,
            p.facts,
            read.modules,
            wanted,
            |i: Int, s: ModuleContext, roots: List<ItemRoot>|
              module_bodies(i, s, roots, natives, index),
          ) {
          Err(_) -> None,
          Ok(bodies) -> Some({ bodies: bodies, whole: taken }),
        }
      }
    }
  }

fn found_of(index: Map<Bytes, Int>, w: CachedWalk) -> Option<WalkResult> = {
  let reads = w.reads.fold(Some([]), |acc: Option<List<ReturnRead>>, r: CachedRead|
    match ((acc, index.get(r.callee))) {
      (Some(xs), Some(d)) -> Some(xs.push({ callee: d, ret: r.ret })),
      _ -> None,
    });
  let demands = w.demands.fold(Some([]), |acc: Option<List<PassedArgument>>, x: CachedDemand|
    match ((acc, index.get(x.callee))) {
      (Some(xs), Some(d)) -> Some(xs.push({ callee: d, param: x.param, owner: x.owner })),
      _ -> None,
    });
  let escaped = w.escaped.fold(Some([]), |acc: Option<List<Int>>, name: Bytes|
    match ((acc, index.get(name))) { (Some(xs), Some(d)) -> Some(xs.push(d)), _ -> None });
  match ((reads, demands, escaped)) {
    (Some(r), Some(d), Some(e)) ->
      Some({ sites: w.sites, demands: d, used_as_values: e, ret: w.ret, reads: r, lookups: [] }),
    _ -> None,
  }
}

fn cached_body(prog: Program, i: Int, module_name: Bytes, k: CachedBody) -> Option<Body> = {
  let definition = match k.definition { None -> Some(0 - 1), Some(name) -> prog.index.get(name) };
  match definition {
    None -> None,
    Some(d) -> {
      let stands = k.lookups.fold(true, |acc: Bool, l: CachedLookup|
        acc && (match l.bound { None -> true, Some(q) -> prog.index.contains(q) == l.definition }));
      Some({
        item_kind: k.kind,
        module: i,
        module_name: module_name,
        name: k.name,
        label: k.label,
        definition_index: d,
        arity: k.arity,
        span: dummy_span(),
        code: None,
        moves: no_moves(),
        lowered: false,
        reuse: k.reuse,
        looked: k.lookups,
        cached_walks: if !stands { [] } else {
          k.walks.fold([], |acc: List<WalkResult>, w: CachedWalk|
            match found_of(prog.index, w) { Some(f) -> acc.push(f), None -> acc })
        },
      })
    },
  }
}

fn cached_bodies(
  prog: Program,
  i: Int,
  module_name: Bytes,
  bytes: Bytes,
) -> Option<List<Body>> / {abort.raise} =
  match bin::decode(bytes, cached_module_bin()) {
    Err(_) -> None,
    Ok(m) ->
      m.bodies.fold(Some([]), |acc: Option<List<Body>>, k: CachedBody|
        match acc {
          None -> None,
          Some(bs) -> match cached_body(prog, i, module_name, k) {
            Some(b) -> Some(bs.push(b)),
            None -> None,
          },
        }),
  }

fn prefer_whole(whole: Option<WholeProgram>, r: Resolution) -> Resolution =
  match whole { Some(w) -> w.r, None -> r }

fn failed_run(prog: Program) -> Run =
  {
    prog: prog,
    found: [],
    used_cached: [],
    made: [],
    whole_program: None,
    fresh: Map::new(),
    lowered_count: 0,
    failed: true,
  }

fn initial_run(p: CostInput, kept: List<Option<Bytes>>) -> Run / {abort.raise} = {
  let a = p.analysis;
  let definitions = definitions_of(a, p.facts);
  let base = {
    r: a.r,
    index: range(0, definitions.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int|
      acc.insert(definitions.get(i).name, i)),
    builtins: builtin_names().fold(Map::new(), |acc: Map<Bytes, Bool>, b: Bytes|
      acc.insert(b, true)),
    definitions: definitions,
    bodies: [],
  };
  let container_name = range(0, a.modules.len()).map(|i: Int|
    if !own_module(a, i) { None } else {
      match kept.at(i) {
        Some(Some(bytes)) -> cached_bodies(base, i, a.modules.get(i).name, bytes),
        _ -> None,
      }
    });
  let missed = range(0, a.modules.len()).filter(|i: Int|
    own_module(a, i) && (match container_name.get(i) { Some(_) -> false, None -> true }));
  match lower(p, None, missed, base.index) {
    None -> failed_run(base),
    Some(l) -> {
      let fresh = range(0, missed.len()).fold(Map::new(), |acc: Map<Int, List<Body>>, k: Int|
        acc.insert(missed.get(k), l.bodies.get(k)));
      let bodies = range(0, a.modules.len()).fold([], |acc: List<Body>, i: Int|
        match container_name.get(i) {
          Some(bs) -> acc.concat(bs),
          None -> match fresh.get(i) { Some(bs) -> acc.concat(bs), None -> acc },
        });
      let none: List<Int> = [];
      let unmade: List<WalkResult> = [];
      {
        prog: { ..base, r: prefer_whole(l.whole, base.r), bodies: bodies },
        found: bodies.map(|_: Body| no_walk_result()),
        used_cached: bodies.map(|_: Body| none),
        made: bodies.map(|_: Body| unmade),
        whole_program: l.whole,
        fresh: missed.fold(Map::new(), |acc: Map<Int, Bool>, i: Int| acc.insert(i, true)),
        lowered_count: missed.len(),
        failed: false,
      }
    },
  }
}

fn to_cached_walk(prog: Program, f: WalkResult) -> CachedWalk / {abort.raise} = {
  let name = |d: Int| prog.definitions.get(d).name;
  {
    reads: f.reads.map(|r: ReturnRead| { callee: name(r.callee), ret: r.ret }),
    sites: f.sites,
    demands: f.demands.map(|x: PassedArgument|
      { callee: name(x.callee), param: x.param, owner: x.owner }),
    escaped: f.used_as_values.map(|d: Int| name(d)),
    ret: f.ret,
  }
}

fn looked_of(f: WalkResult) -> List<CachedLookup> =
  f.lookups.fold(Map::new(), |acc: Map<Bytes, CachedLookup>, l: NameLookup|
    acc.insert(l.name, { name: l.name, bound: l.bound, definition: l.definition != None })).fold(
    [],
    |acc: List<CachedLookup>, _: Bytes, l: CachedLookup| acc.push(l),
  )

fn to_cached_body(run: Run, i: Int) -> CachedBody / {abort.raise} = {
  let b: Body = run.prog.bodies.get(i);
  let made: List<WalkResult> = run.made.get(i);
  {
    kind: b.item_kind,
    name: b.name,
    label: b.label,
    definition: if b.definition_index < 0 { None }
    else { Some(run.prog.definitions.get(b.definition_index).name) },
    arity: b.arity,
    reuse: b.reuse,
    lookups: match made.at(0) { Some(f) -> looked_of(f), None -> b.looked },
    walks: run.used_cached.get(i).map(|j: Int|
      to_cached_walk(run.prog, b.cached_walks.get(j))).concat(
      made.map(|f: WalkResult| to_cached_walk(run.prog, f)),
    ),
  }
}

fn own_sites(f: WalkResult, span: Span) -> Bool =
  f.sites.fold(true, |acc: Bool, s: RawSite|
    acc && s.span.start >= span.start && s.span.end <= span.end)

fn cache_entries(run: Run, n: Int) -> List<Option<Bytes>> / {abort.raise} = {
  let prog = run.prog;
  let by_module = range(0, prog.bodies.len()).fold(
    Map::new(),
    |acc: Map<Int, List<Int>>, i: Int| {
      let m = prog.bodies.get(i).module;
      acc.insert(m, List::push(match acc.get(m) { Some(xs) -> xs, None -> [] }, i))
    },
  );
  range(0, n).map(|m: Int| {
    let xs = match by_module.get(m) { Some(xs) -> xs, None -> [] };
    let moved = run.fresh.contains(m)
      || xs.fold(false, |acc: Bool, i: Int|
        acc || run.made.get(i).len() > 0
          || run.used_cached.get(i).len() < prog.bodies.get(i).cached_walks.len());
    let own = xs.fold(true, |acc: Bool, i: Int|
      acc
        && run.made.get(i).fold(true, |ok: Bool, f: WalkResult|
          ok && own_sites(f, prog.bodies.get(i).span)));
    if !moved || !own { None } else {
      Some(bin::encode({ bodies: xs.map(|i: Int| to_cached_body(run, i)) }, cached_module_bin()))
    }
  })
}

fn report_of(run: Run, tables: Tables, rounds: Int) -> Report / {abort.raise} = {
  let prog = run.prog;
  {
    ok: true,
    rounds: rounds,
    definitions: range(0, prog.bodies.len()).fold([], |acc: List<Costed>, i: Int| {
      let b: Body = prog.bodies.get(i);
      let f: WalkResult = run.found.get(i);
      if f.sites.len() == 0 { acc } else {
        acc.push({
          item_kind: b.item_kind,
          module: b.module,
          module_name: b.module_name,
          name: b.name,
          label: b.label,
          reuse_keyword: b.reuse,
          sites: f.sites.map(|raw: RawSite| finish(raw, b.definition_index, tables)),
        })
      }
    }),
    return_mismatches: return_mismatches_of(prog, tables),
  }
}

pub type Costing = {
  report: Report,
  cached: List<Option<Bytes>>,
  walked_modules: Int,
  lowered: Int,
}

pub fn costs(p: CostInput, kept: List<Option<Bytes>> = []) -> Costing / {abort.raise} = {
  let n = p.analysis.modules.len();
  let rejected = {
    report: { ok: false, rounds: 0, definitions: [], return_mismatches: [] },
    cached: range(0, n).map(|_: Int| None),
    walked_modules: 0,
    lowered: 0,
  };
  let start = initial_run(p, kept);
  let tables = start_tables(start.prog.definitions);
  let first = evaluate(p, start, |_: Int| true, tables);
  if first.failed { rejected } else {
    let resolved = iterate(p, first, readers_of(first.found), tables, 0);
    if resolved.run.failed { rejected } else {
      {
        report: report_of(resolved.run, resolved.tables, resolved.rounds),
        cached: cache_entries(resolved.run, n),
        walked_modules: resolved.run.made.fold(0, |acc: Int, xs: List<WalkResult>|
          if xs.len() > 0 { acc + 1 } else { acc }),
        lowered: resolved.run.lowered_count,
      }
    }
  }
}

pub fn cost_keys(p: CostInput, identity: Bytes) -> List<Bytes> / {abort.raise} = {
  let a = p.analysis;
  let owns = a.hashes.own.fold(
    Map::new(),
    |acc: Map<Bytes, Bytes>, o: { name: Bytes, hash: Bytes }| acc.insert(o.name, o.hash),
  );
  let definitions = p.rows.definitions.fold(
    Map::new(),
    |acc: Map<Bytes, Bytes>, r: KnownDefinitionRow| acc.insert(r.name, blake3(r.facts)),
  );
  let tests = p.rows.tests.fold(Map::new(), |acc: Map<Bytes, Bytes>, r: KnownTestRow|
    acc.insert(r.owner, blake3(r.body_facts)));
  let embeds = embeds_by_module(a.embeds);
  let loose = laws_by_module(p.facts, a.modules);
  let orders = orders_by_module(p.facts, a.modules);
  let head = Bytes::concat_all([
    b"ply.costs.module.1\x00",
    hex(bin::shape_digest(cached_module_bin())),
    b"\x00",
    identity,
    b"\x00",
  ]);
  let entry = |m: Map<Bytes, Bytes>, k: Bytes| match m.get(k) { Some(x) -> x, None -> b"!" };
  range(0, a.modules.len()).map(|i: Int| {
    let m: ParsedModule = a.modules.get(i);
    let items = m.module.items.fold(
      { parts: [], formless: false },
      |x: { parts: List<Bytes>, formless: Bool }, item: Item|
        match item {
          FunctionItem(d) -> {
            let name = qualify(m.name, d.name.name);
            match owns.get(name) {
              None -> { ..x, formless: true },
              Some(own) ->
                {
                  ..x,
                  parts: x.parts.push(
                    Bytes::concat_all([
                      b"f",
                      name,
                      b"\x00",
                      own,
                      b"\x00",
                      entry(definitions, name),
                    ]),
                  ),
                },
            }
          },
          TestItem(d) -> {
            let owner = test_owner(m.name, d.name);
            match a.hashes.test_texts.get(qualify(m.name, d.name)) {
              None -> { ..x, formless: true },
              Some(own) ->
                {
                  ..x,
                  parts: x.parts.push(
                    Bytes::concat_all([b"t", owner, b"\x00", own, b"\x00", entry(tests, owner)]),
                  ),
                },
            }
          },
          LawItem(d) -> match a.hashes.law_texts.get(qualify(m.name, d.name)) {
            None -> { ..x, formless: true },
            Some(own) -> { ..x, parts: x.parts.push(b"l".concat(own)) },
          },
          _ -> x,
        },
    );
    if !own_module(a, i) || items.formless { b"" } else {
      hex(
        blake3(
          Bytes::concat_all([
            head,
            m.name,
            b"\x00",
            blake3(match p.sources.at(i) { Some(src) -> src, None -> b"" }),
            b"\x00",
            match embeds.get(m.name) { Some(e) -> e, None -> b"" },
            b"\x00",
            Bytes::concat_all(items.parts.map(|part: Bytes| part.concat(b"\x00"))),
            b"\x00",
            match loose.get(i) { Some(l) -> l, None -> b"" },
            b"\x00",
            match orders.get(i) {
              Some(o) ->
                o.fold(b"", |accumulator2: Bytes, name: Bytes, params: List<Bytes>|
                  Bytes::concat_all([
                    accumulator2,
                    name,
                    b"(",
                    Bytes::concat_all(params.map(|q: Bytes| q.concat(b","))),
                    b")",
                  ])),
              None -> b"",
            },
          ]),
        ),
      )
    }
  })
}

fn embeds_by_module(embeds: List<ModuleEmbed>) -> Map<Bytes, Bytes> =
  embeds.fold(Map::new(), |acc: Map<Bytes, Bytes>, e: ModuleEmbed|
    acc.insert(
      e.module,
      Bytes::concat_all([
        match acc.get(e.module) { Some(was) -> was, None -> b"" },
        e.key,
        b"\x00",
        match e.read {
          Ok(files) ->
            Bytes::concat_all(
              files.map(|f: EmbedFile| Bytes::concat_all([f.name, b"\x00", f.digest, b"\x00"])),
            ),
          Err(reason) -> b"!".concat(reason),
        },
        b"\x00",
      ]),
    ))

fn laws_by_module(
  w: InferredFacts,
  modules: List<ParsedModule>,
) -> Map<Int, Bytes> / {abort.raise} = {
  let here = range(0, modules.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int| {
    let m = modules.get(i);
    m.module.items.fold(acc, |a: Map<Bytes, Int>, item: Item|
      match item { LawItem(l) -> a.insert(law_owner(m.name, l.name), i), _ -> a })
  });
  w.law_facts.fold(Map::new(), |acc: Map<Int, Bytes>, l: { owner: Bytes, facts: BodyFacts }|
    match here.get(l.owner) {
      None -> acc,
      Some(i) ->
        acc.insert(
          i,
          Bytes::concat_all([
            match acc.get(i) { Some(was) -> was, None -> b"" },
            l.owner,
            b"\x00",
            bin::encode(recorded_facts_of(l.facts), body_facts_bin()),
          ]),
        ),
    })
}

fn recorded_facts_of(f: BodyFacts) -> BodyFacts / {abort.raise} =
  {
    members: f.members.map(|x: MemberSite| { ..x, module: 0 }),
    types: types_named(f.types, f.bodies),
    bodies: f.bodies.map(|x: TypedBody<Bytes>| { ..x, module: 0 }),
  }

fn checked_cost_input(
  names: List<Bytes>,
  sources: List<Bytes>,
  module_packages: List<Int> = [],
) -> CostInput / {abort.raise} =
  match analyse(
      parse_all(range(0, names.len()).map(|i: Int| { name: names.get(i), src: sources.get(i) })),
    ) {
    Rejected(_) -> panic("the checker rejected a program that should be valid"),
    Analysed(w) ->
      cost_input_of(
        {
          ..w,
          module_packages: module_packages.concat(w.module_packages.drop(module_packages.len())),
        },
        sources,
      ),
  }

fn reported(
  names: List<Bytes>,
  sources: List<Bytes>,
  module_packages: List<Int> = [],
) -> Report / {abort.raise} = costs(checked_cost_input(names, sources, module_packages)).report

test "a cost report gives each update's source location, whether it copies or reuses, the reason, and an edit that would avoid the copy" {
  let src = b"reuse fn grow(m: Map<Int, List<Int>>, n: Int) -> List<Int> =\n  match m.get(0) { Some(xs) -> xs.push(n), None -> [] }\n";
  let r = reported([b"m"], [src]);
  assert(r.ok);
  assert_eq(r.definitions.len(), 1);
  let d = r.definitions.get(0);
  assert_eq([d.item_kind, d.module_name, d.name], [b"fn", b"m", b"grow"]);
  assert_eq(d.reuse_keyword, Some(span_between(0, 5)));
  assert_eq(d.sites.len(), 1);
  let s = d.sites.get(0);
  assert_eq(src.slice(s.start, s.end), b"xs.push(n)");
  assert_eq(s.op, b"List::push");
  assert_eq(s.verdict, b"copies");
  assert_eq(s.reason, b"`Map::get` returns a clone the map still contains");
  assert_eq(s.suggestion, b"`Map::update`");
  assert_eq(s.param, 0 - 1)
}

test "updating a map entry read with `first` or `floor` copies it, but an entry removed with `pop_first` or `split` is reused" {
  let src = b"fn peek(m: Map<Int, List<Int>>, n: Int) -> List<Int> = match m.first() { Some(e) -> e.value.push(n), None -> [] }\nfn near(m: Map<Int, List<Int>>, n: Int) -> List<Int> = match m.floor(n) { Some(e) -> e.value.push(n), None -> [] }\nfn take(m: Map<Int, List<Int>>, n: Int) -> List<Int> = match m.pop_first() { Some(p) -> p.value.push(n), None -> [] }\nfn cut(m: Map<Int, List<Int>>, n: Int) -> List<Int> = match m.split(n).at { Some(xs) -> xs.push(n), None -> [] }\ntest \"fresh\" { assert_eq(take(Map::new().insert(1, [1]), 2), [1, 2]); assert_eq(cut(Map::new().insert(1, [1]), 1), [1, 1]) }\n";
  let r = reported([b"m"], [src]);
  assert(r.ok);
  let site_of = |name: Bytes| r.definitions.filter(|d: Costed| d.name == name).get(0).sites.get(0);
  let peeked = site_of(b"peek");
  assert_eq([peeked.verdict, peeked.reason, peeked.suggestion], [
    b"copies",
    b"`.value` was read from a record that another value still owns: `Map::first` returns a clone the map still contains",
    b"`Map::update`",
  ]);
  assert_eq(
    site_of(b"near").reason,
    b"`.value` was read from a record that another value still owns: `Map::floor` returns a clone the map still contains",
  );
  let taken = site_of(b"take");
  assert_eq([taken.verdict, taken.reason], [
    b"reuses",
    b"the list is parameter 0, and every call site passes it and never uses it again",
  ]);
  assert_eq(site_of(b"cut").verdict, b"reuses")
}

test "an array or list element replaced in place is an update, and one read out first is a copy" {
  let src = b"fn fill(xs: Array<Int>, i: Int) -> Array<Int> / {abort.raise} = if i <= 0 { xs } else { fill(xs.set(i - 1, i), i - 1) }\nfn twice(xs: Array<Int>) -> Array<Int> / {abort.raise} = { let n = xs.get(0) + xs.len(); xs.set(0, n) }\nfn again(xs: Array<Int>) -> Int / {abort.raise} = xs.set(0, 1).len() + xs.len()\nfn sized(xs: Array<Int>) -> Array<Int> / {abort.raise} = xs.set(0, xs.len())\nfn first(ys: List<Array<Int>>) -> Array<Int> / {abort.raise} = match ys.at(0) { Some(a) -> a.set(0, 1), None -> Array::new(1, 0) }\nfn bump(zs: List<Int>) -> List<Int> / {abort.raise} = zs.set(0, 1)\ntest \"fresh\" { assert_eq(fill(Array::new(3, 0), 3).len(), 3); assert_eq(bump([0]), [1]) }\n";
  let r = reported([b"m"], [src]);
  assert(r.ok);
  let site_of = |name: Bytes| r.definitions.filter(|d: Costed| d.name == name).get(0).sites.get(0);
  let filled = site_of(b"fill");
  assert_eq([filled.op, filled.verdict, filled.reason], [
    b"Array::set",
    b"reuses",
    b"the array is parameter 0, and every call site passes it and never uses it again",
  ]);
  let twiced = site_of(b"twice");
  assert_eq([twiced.op, twiced.verdict], [b"Array::set", b"reuses"]);
  let again = site_of(b"again");
  assert_eq([again.verdict, again.reason, again.suggestion], [
    b"copies",
    b"`xs` is read again after this point, so this use clones it",
    b"make the update the last use of the variable: first bind anything else you need from the variable to new names",
  ]);
  assert_eq(site_of(b"sized").verdict, b"reuses");
  let read = site_of(b"first");
  assert_eq([read.op, read.verdict, read.reason], [
    b"Array::set",
    b"copies",
    b"`List::at` returns a clone of an element the list still owns",
  ]);
  let bumped = site_of(b"bump");
  assert_eq([bumped.op, bumped.verdict], [b"List::set", b"reuses"])
}

test "updating a value read from a scope reports a copy, and updating one the scope's callback returns or ends up using reports an unknown cost" {
  let src = b"fn read(xs: List<Int>, n: Int) -> List<Int> = with_scope[r](xs, |l: List<Int>| ()) { h -> h.get().push(n) }\nfn answered(xs: List<Int>, n: Int) -> List<Int> = List::push(with_scope[r](n, |k: Int| ()) { h -> xs }, n)\nfn released(xs: List<Int>, n: Int) -> Int = with_scope[r](xs, |l: List<Int>| { let grown = l.push(n); () }) { h -> n }\n";
  let r = reported([b"m"], [src]);
  assert(r.ok);
  let site_of = |name: Bytes| r.definitions.filter(|d: Costed| d.name == name).get(0).sites.get(0);
  let read = site_of(b"read");
  assert_eq([read.verdict, read.reason, read.suggestion], [
    b"copies",
    b"`Scoped::get` returns a copy of a value the scope still owns",
    b"",
  ]);
  assert_eq(site_of(b"answered").verdict, b"unknown");
  assert_eq(site_of(b"released").verdict, b"unknown")
}

fn verdicts(r: Report) -> List<Bytes> =
  r.definitions.fold([], |acc: List<Bytes>, d: Costed|
    d.sites.fold(acc, |a: List<Bytes>, s: Site|
      a.push(Bytes::concat_all([d.name, b" ", s.verdict]))))

test "a `returns` clause is checked against the function body, and a mismatch reports the declared and actual return origin" {
  let src = Bytes::concat_all([
    b"fn mk(n: Int) -> List<Int> returns fresh = range(0, n)\n",
    b"fn pick(xs: List<Int>, ys: List<Int>) -> List<Int> returns ys = xs\n",
    b"fn same(xs: List<Int>) -> List<Int> returns xs = xs\n",
    b"fn folded(xs: List<Int>) -> List<Int> returns fresh = xs.fold([], |acc: List<Int>, x: Int| acc.push(x))\n",
  ]);
  let r = reported([b"m"], [src]);
  assert(r.ok);
  assert_eq(r.return_mismatches.map(|u: ReturnMismatch| (u.name, u.declared, u.actual)), [
    (b"m.pick", b"its parameter `ys`", b"its parameter `xs`"),
    (b"m.folded", b"fresh", b"`List::fold` returns whatever its callback returned"),
  ]);
  assert_eq(src.slice(r.return_mismatches.get(0).start, r.return_mismatches.get(0).end), b"ys")
}

test "an update inside a callback passed to a builtin reports a copy or reuse by what the builtin passes in" {
  let src = Bytes::concat_all([
    b"fn grown(xs: List<Int>) -> List<Int> = xs.fold([], |acc: List<Int>, x: Int| acc.push(x))\n",
    b"fn each(xss: List<List<Int>>) -> List<List<Int>> = xss.map(|ys: List<Int>| ys.push(1))\n",
    b"fn values(m: Map<Int, Int>) -> List<Int> returns fresh = m.fold([], |acc: List<Int>, k: Int, v: Int| acc.push(v))\n",
  ]);
  let r = reported([b"m"], [src]);
  assert(r.ok);
  let site_of = |name: Bytes| r.definitions.filter(|d: Costed| d.name == name).get(0).sites.get(0);
  assert_eq(site_of(b"grown").verdict, b"reuses");
  let each = site_of(b"each");
  assert_eq([each.verdict, each.reason], [
    b"copies",
    b"an element of the list being iterated over, which the list still owns",
  ]);
  assert_eq(r.return_mismatches.map(|u: ReturnMismatch| (u.name, u.actual)), [
    (b"m.values", b"`Map::fold` returns whatever its callback returned"),
  ])
}

test "`fold` is treated as returning whatever its callback returns" {
  let lib = Bytes::concat_all([
    b"pub fn made(n: Int) -> List<Int> returns fresh = range(0, n).fold([], |acc: List<Int>, x: Int| acc.push(x))\n",
    b"pub fn plain(n: Int) -> List<Int> = range(0, n)\n",
  ]);
  let app = b"import lib.more\nreuse fn grow(n: Int) -> List<Int> = more::made(n).push(n)\nreuse fn other(n: Int) -> List<Int> = more::plain(n).push(n)\n";
  let r = reported([b"app", b"lib.more"], [app, lib], [0, 1]);
  assert(r.ok);
  assert_eq(verdicts(r), [b"grow reuses", b"other unknown"]);
  assert_eq(r.return_mismatches, [])
}

fn costed_over(
  store: Map<Bytes, Bytes>,
  p: CostInput,
) -> { costing: Costing, store: Map<Bytes, Bytes> } / {abort.raise} = {
  let keys = cost_keys(p, b"checker");
  let c = costs(p, keys.map(|k: Bytes| if k.len() == 0 { None } else { store.get(k) }));
  {
    costing: c,
    store: range(0, keys.len()).fold(store, |acc: Map<Bytes, Bytes>, i: Int|
      match c.cached.at(i) { Some(Some(bytes)) -> acc.insert(keys.get(i), bytes), _ -> acc }),
  }
}

fn three_module_program(mk: Bytes) -> CostInput / {abort.raise} =
  checked_cost_input([b"a", b"b", b"c"], [
    b"pub fn table() -> Map<Int, List<Int>> = Map::new()\npub fn keep(xs: List<Int>) -> List<Int> = xs\n".concat(
      mk,
    ),
    b"import a (mk, keep)\nfn grow(n: Int) -> List<Int> = mk(n).push(n)\nfn hold(xs: List<Int>, n: Int) -> List<Int> = keep(xs).push(n)\ntest \"grows\" { assert_eq(grow(1), [0, 1]) }\n",
    b"fn solo(xs: List<Int>) -> List<Int> = xs.push(1)\n",
  ])

fn made_fresh() -> Bytes = b"pub fn mk(n: Int) -> List<Int> = range(0, n)\n"

fn made_shared() -> Bytes =
  b"pub fn mk(n: Int) -> List<Int> = match table().get(0) { Some(xs) -> xs, None -> range(0, n) }\n"

test "a cost run that reuses stored results from earlier runs gives the same report as a fresh run and reanalyzes only the changed modules" {
  let first = costed_over(Map::new(), three_module_program(made_fresh()));
  assert(first.costing.walked_modules > 0 && first.costing.lowered > 0);
  let again = costed_over(first.store, three_module_program(made_fresh()));
  assert_eq(again.costing.report, first.costing.report);
  assert_eq([again.costing.walked_modules, again.costing.lowered], [0, 0]);
  let shared = three_module_program(made_shared());
  let moved = costed_over(again.store, shared);
  assert_eq(moved.costing.report, costs(shared).report);
  assert_eq(verdicts(moved.costing.report), [b"grow copies", b"hold reuses", b"solo reuses"]);
  assert(
    moved.costing.walked_modules > 0 && moved.costing.walked_modules < first.costing.walked_modules,
  );
  assert(moved.costing.lowered < first.costing.lowered);
  let back = costed_over(moved.store, three_module_program(made_fresh()));
  assert_eq(back.costing.report, first.costing.report);
  assert_eq([back.costing.walked_modules, back.costing.lowered], [0, 0])
}

fn std_cost_input(user: List<Source>, shipped: List<Source>) -> CostInput / {abort.raise} = {
  let texts = user.concat(shipped).fold(
    Map::new().insert(prelude_module(), prelude_source::text()),
    |acc: Map<Bytes, Bytes>, x: Source| acc.insert(x.name, x.src),
  );
  match analyse_pulling_std(user, shipped).out {
    Rejected(_) -> panic("the checker rejected a program that should be valid"),
    Analysed(w) ->
      cost_input_of(
        w,
        w.modules.map(|m: ParsedModule| match texts.get(m.name) { Some(src) -> src, None -> b"" }),
      ),
  }
}

fn as_stub(whole: CostInput, name: Bytes) -> CostInput / {abort.raise} = {
  let a = whole.analysis;
  let i = range(0, a.modules.len()).fold(0, |acc: Int, k: Int|
    if a.modules.get(k).name == name { k } else { acc });
  let cuts = cuts_of(a.modules.get(i)).filter(|c: Cut| c.name.len() > 0);
  let stub = parse_at(i, { name: name, src: blank_cuts(whole.sources.get(i), cuts) }).module;
  match resolved_as(
      a,
      range(0, a.modules.len()).map(|k: Int| if k == i { stub } else { a.modules.get(k) }),
    ) {
    ResolveFailed(_) -> panic("name resolution failed after replacing the module with its stub"),
    ResolveSucceeded(x) ->
      {
        ..whole,
        analysis: {
          ..a,
          modules: x.modules,
          r: x.resolution,
          stub_cuts: Map::new().insert(name, cuts),
        },
      },
  }
}

fn interpolating(mk: Bytes) -> CostInput / {abort.raise} =
  std_cost_input(
    [
      { name: b"a", src: b"pub fn table() -> Map<Int, List<Int>> = Map::new()\n".concat(mk) },
      {
        name: b"b",
        src: b"import a (mk)\nfn grow(n: Int) -> List<Int> = mk(String::len(f\"{n}\")).push(n)\nfn told(xs: List<Int>, n: Int) -> List<Int> = xs.push(String::len(f\"{n}\"))\n",
      },
    ],
    [{ name: b"std.show", src: b"pub fn display(n: Int) -> String = n.to_string()\n" }],
  )

test "a module supplied only as a stub is lowered from its source and analyzed in full, like a module supplied whole" {
  let first = costed_over(Map::new(), interpolating(made_fresh()));
  let shared = interpolating(made_shared());
  let stubbed_b = as_stub(shared, b"b");
  assert_eq(costs(stubbed_b).report, costs(shared).report);
  let moved = costed_over(first.store, stubbed_b);
  assert_eq(moved.costing.report, costs(shared).report);
  assert_eq([moved.costing.walked_modules, moved.costing.lowered], [3, 2]);
  let key = cost_keys(shared, b"checker").get(1);
  assert_eq(moved.store.get(key), costed_over(first.store, shared).store.get(key))
}

test "a stored analysis of a module is discarded when a name its body looks up no longer refers to a definition" {
  let p = three_module_program(made_fresh());
  let first = costed_over(Map::new(), p);
  let key = cost_keys(p, b"checker").get(1);
  let kept = match first.store.get(key) {
    Some(bytes) -> match bin::decode(bytes, cached_module_bin()) {
      Ok(m) -> m,
      Err(_) -> panic("a kept entry decodes"),
    },
    None -> panic("the module's entry is kept"),
  };
  let renamed = {
    bodies: kept.bodies.map(|k: CachedBody|
      {
        ..k,
        lookups: k.lookups.map(|l: CachedLookup|
          if l.name == b"a.mk" { { ..l, definition: false } } else { l }),
      }),
  };
  let again = costed_over(first.store.insert(key, bin::encode(renamed, cached_module_bin())), p);
  assert_eq(again.costing.report, first.costing.report);
  assert_eq([again.costing.walked_modules, again.costing.lowered], [1, 1])
}
