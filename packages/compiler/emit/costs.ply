                                     StatedParameter, call_shape)
import compiler.emit.representations
import compiler.check.infer (CheckOutput)
import compiler.check.typed (witness_param_name)
import compiler.front.facts (Analysis)
import compiler.front.rows (Rows)
import compiler.front.emitter_input (InferredFacts, Analysed, Rejected)
import compiler.front.published (rows_of, inferred_facts)
import compiler.front.exports (ItemAt, placed_position)
import compiler.check.callbacks (CallbackArgument, Element, Accumulator, ExtractedFrom, Number,
                                 UnknownArgument, Folded, prelude_callback_use)
import compiler.front.diagnostics (parse_all)
import std.bin
import std.list
import std.bytes (ascii_of_int)

pub type Cause =
  | ReadAgain
  | MapEntry
  | CapturedValue
  | CallerRetains
  | ContainerElement
  | TopLevelValue
  | CallResult
  | HandlerResult
  | ClosureParam

pub type Reason = { cause: Cause, text: Bytes }

pub type DefinitionParameter = { definition: Bytes, index: Int }

pub type Owner =
  | FreshOwner
  | ParamOwner(DefinitionParameter)
  | SharedOwner(Reason)
  | UnknownOwner(Reason)

pub type ParamSharing = | SoleParam | UnsureParam(Reason) | SharedParam(Reason)

pub type ReturnOwnership =
  | FreshReturn
  | ReturnOfParam(Int)
  | SharedReturn(Reason)
  | UnsureReturn(Reason)

type Tables = { rets: List<ReturnOwnership> }

type Bind = { slot: Int, owner: Owner }

type PassedArgument = { callee: Int, param: Int, owner: Owner }

pub type RawSite = { span: Span, builtin_name: Bytes, owner: Owner }

type ReturnRead = { callee: Int, return_ownership: ReturnOwnership }

type CostState = {
  chain: List<Bind>,
  sites: List<RawSite>,
  demands: List<PassedArgument>,
  escaped: List<Int>,
  reads: List<ReturnRead>,
}

pub type Demand = { callee: Bytes, param: Int, owner: Owner }

pub type Escape = { callee: Bytes, arity: Int }

pub type CostedKind<a> = | CostedFunction(a) | CostedTest | CostedLaw

pub type Origin = | Local | Parameter(Int)

pub type Verdict = | Reuses(Bytes) | Copies(Reason, Origin) | Undecided(Reason, Origin)

pub fn site_reason(verdict: Verdict) -> Bytes =
  match verdict {
    Reuses(text) -> text,
    Copies(reason, _) -> reason.text,
    Undecided(reason, _) -> reason.text,
  }

pub fn suggestion(verdict: Verdict) -> Option<Bytes> =
  match verdict {
    Reuses(_) -> None,
    Copies(reason, _) -> suggestion_for(reason.cause),
    Undecided(reason, _) -> suggestion_for(reason.cause),
  }

pub fn breaks_reuse(verdict: Verdict) -> Bool =
  match verdict { Copies(_, Local) -> true, Undecided(_, Local) -> true, _ -> false }

pub type WalkedBody = {
  item_kind: CostedKind<Bytes>,
  module_name: Bytes,
  name: Bytes,
  label: Bytes,
  reuse: Option<Span>,
  sites: List<RawSite>,
  demands: List<Demand>,
  escaped: List<Escape>,
  returned: ReturnOwnership,
}

pub type DeclaredReturn = {
  module_name: Bytes,
  definition: Bytes,
  params: List<Bytes>,
  declared: ReturnOwnership,
  span: Span,
}

pub type GroupWalk = {
  unfinished: List<Bytes>,
  bodies: List<WalkedBody>,
  declared: List<DeclaredReturn>,
}

pub type BodyDemands = { label: Bytes, escaped: List<Escape>, demands: List<Demand> }

pub type ModuleDemands = { unfinished: List<Bytes>, bodies: List<BodyDemands> }

pub type ParamTable = Map<Bytes, Map<Int, ParamSharing>>

pub type Parameters = { table: Map<Bytes, Map<Int, ParamSharing>> }

derive bin for CostedKind
derive bin for Verdict
derive bin for Origin
derive bin for Cause
derive bin for Reason
derive bin for DefinitionParameter
derive bin for Owner
derive bin for ParamSharing
derive bin for ReturnOwnership
derive bin for RawSite
derive bin for Demand
derive bin for Escape
derive bin for WalkedBody
derive bin for DeclaredReturn
derive bin for GroupWalk
derive bin for BodyDemands
derive bin for ModuleDemands
derive bin for Parameters

type WithOwner = { state: CostState, owner: Owner }

type Arms = { state: CostState, owner: Option<Owner> }

type Args = { state: CostState, owners: List<Owner> }

type DeclaredAt = { return_type: ReturnOwnership, span: Span }

type Definition = {
  name: Bytes,
  module_name: Bytes,
  params: List<Bytes>,
  arity: Int,
  own: Bool,
  declared_return: Option<DeclaredAt>,
}

type Body = {
  item_kind: CostedKind<Int>,
  module: Int,
  module_name: Bytes,
  name: Bytes,
  label: Bytes,
  arity: Int,
  code: Code,
  moves: Moves,
  reuse: Option<Span>,
}

type WalkResult = {
  sites: List<RawSite>,
  demands: List<PassedArgument>,
  used_as_values: List<Int>,
  return_owner: Owner,
  reads: List<ReturnRead>,
}

type Program = {
  index: Map<Bytes, Int>,
  builtins: Set<Bytes>,
  definitions: List<Definition>,
  bodies: List<Body>,
}

type Env = { prog: Program, module: Int, tables: Tables, moves: Moves }

fn blocked(cause: Cause, text: Bytes) -> Owner = SharedOwner({ cause: cause, text: text })

fn unknown(cause: Cause, text: Bytes) -> Owner = UnknownOwner({ cause: cause, text: text })

fn reworded(reason: Reason, text: Bytes) -> Reason = { cause: reason.cause, text: text }

fn fresh(state: CostState) -> WithOwner = { state: state, owner: FreshOwner }

const element_owner: Owner =
  blocked(
    ContainerElement,
    b"an element of the list being iterated over, which the list still owns",
  )

fn owner_at(xs: List<Owner>, i: Int) -> Owner = match xs.at(i) { Some(o) -> o, None -> FreshOwner }

fn owner_of(state: CostState, slot: Int) -> Option<Owner> =
  state.chain.fold(None, |accumulator: Option<Owner>, b: Bind|
    if b.slot == slot { Some(b.owner) } else { accumulator })

fn bind(state: CostState, slot: Int, owner: Owner) -> CostState =
  { ..state, chain: state.chain.push({ slot: slot, owner: owner }) }

fn rebind(state: CostState, slot: Int, owner: Owner) -> CostState =
  {
    ..state,
    chain: state.chain.map(|b: Bind| if b.slot == slot { { slot: slot, owner: owner } } else { b }),
  }

fn add_site(state: CostState, span: Span, operation: Bytes, owner: Owner) -> CostState =
  { ..state, sites: state.sites.push({ span: span, builtin_name: operation, owner: owner }) }

fn add_demand(state: CostState, d: PassedArgument) -> CostState =
  { ..state, demands: state.demands.push(d) }

fn add_escaped(state: CostState, d: Int) -> CostState = { ..state, escaped: state.escaped.push(d) }

fn with_chain(state: CostState, chain: List<Bind>) -> CostState = { ..state, chain: chain }

fn walk(env: Env, c: Code, state: CostState) -> WithOwner / {abort.raise} =
  match c.node {
    CodeLiteral(_) -> fresh(state),
    CodeLabel(_) -> fresh(state),
    CodeVariable(v) -> variable_owner(env, v.name, v.slot, read_moved(env.moves, c.span), state),
    NDefinition(_) -> global_read(env, c, state),
    NConstructor(_) -> global_read(env, c, state),
    NBuiltin(_) -> global_read(env, c, state),
    CodeUnary(u) -> fresh(walk(env, u.operand, state).state),
    CodeBinary(b) ->
      fresh(walk(env, b.right_operand, walk(env, b.left_operand, state).state).state),
    CodeLambda(l) ->
      fresh(
        mark_captured_shared(
          env,
          walk_nested_body(env, l.params, [], l.body, state),
          l.captures,
          l.body,
          l.at,
        ),
      ),
    CodeParallel(parallel_code) ->
      fresh(parallel_code.branches.fold(state, |s: CostState, b: Code| walk(env, b, s).state)),
    CodeApply(a) -> app(env, c.span, a.function, a.args, state),
    CodeKnownLambda(k) -> variable_owner(env, k.name, k.slot, read_moved(env.moves, c.span), state),
    CodeIf(i) -> {
      let t = walk(env, i.then_branch, walk(env, i.cond, state).state);
      let e = walk(env, i.else_branch, t.state);
      { state: e.state, owner: join(t.owner, e.owner) }
    },
    CodeMatch(m) -> {
      let scrutinee = walk(env, m.scrutinee, state);
      let arms = m.arms.fold(
        { state: scrutinee.state, owner: None },
        |accumulator: Arms, a: CodeArm| {
          let bound = pattern_slots(a.pattern).fold(accumulator.state, |s: CostState, slot: Int|
            bind(s, slot, scrutinee.owner));
          let guarded = match a.guard { Some(g) -> walk(env, g, bound).state, None -> bound };
          let w = walk(env, a.body, guarded);
          {
            state: w.state,
            owner: Some(match accumulator.owner {
              None -> w.owner,
              Some(previous_owner) -> join(previous_owner, w.owner),
            }),
          }
        },
      );
      { state: arms.state, owner: match arms.owner { Some(o) -> o, None -> FreshOwner } }
    },
    CodeBlock(b) -> {
      let s = b.statements.fold(state, |accumulator: CostState, statement: CodeStatement|
        match statement {
          CodeLet(l) -> {
            let w = walk(env, l.value, accumulator);
            bind(w.state, l.slot, w.owner)
          },
          CodeLetDestructure(l) -> {
            let w = walk(env, l.value, accumulator);
            pattern_slots(l.pattern).fold(w.state, |s2: CostState, slot: Int|
              bind(s2, slot, w.owner))
          },
          CodeDo(d) -> walk(env, d.code, accumulator).state,
        });
      match b.tail { Some(t) -> walk(env, t, s), None -> fresh(s) }
    },
    CodeRecord(r) ->
      fresh(
        r.fields.fold(state, |accumulator: CostState, f: CodeField|
          walk(env, f.value, accumulator).state),
      ),
    CodeUpdate(_) ->
      fresh(
        code_children(c).fold(state, |accumulator: CostState, x: Code|
          walk(env, x, accumulator).state),
      ),
    CodeFieldRead(f) -> {
      let b = match f.base.node {
        CodeVariable(v) -> if field_moved(env.moves, c.span) {
          variable_owner(env, v.name, v.slot, true, state)
        } else { walk(env, f.base, state) },
        _ -> walk(env, f.base, state),
      };
      match b.owner {
        SharedOwner(reason) ->
          {
            state: b.state,
            owner: blocked(
              reason.cause,
              Bytes::concat_all([
                b"`.",
                f.field,
                b"` was read from a record that another value still owns: ",
                reason.text,
              ]),
            ),
          },
        _ -> b,
      }
    },
    CodeList(l) ->
      fresh(l.items.fold(state, |accumulator: CostState, x: Code| walk(env, x, accumulator).state)),
    CodePerform(p) ->
      {
        state: p.args.fold(
          match p.label { Some(x) -> walk(env, x, state).state, None -> state },
          |accumulator: CostState, x: Code| walk(env, x, accumulator).state,
        ),
        owner: unknown(
          HandlerResult,
          b"the value a handler returned, which the handler may still reference",
        ),
      },
    CodeHandle(h) -> {
      let caught = h.clauses.fold(state, |accumulator: CostState, clause: CodeClause|
        mark_captured_shared(env, accumulator, clause.captures, clause.body, clause.at));
      let armed = match h.return_clause {
        Some(r) -> mark_captured_shared(env, caught, r.captures, r.body, r.at),
        None -> caught,
      };
      let ran = walk(env, h.body, armed).state;
      let clauses = h.clauses.fold(ran, |accumulator: CostState, clause: CodeClause|
        walk_nested_body(
          env,
          clause.params + (if clause.resume { 1 } else { 0 }),
          [],
          clause.body,
          accumulator,
        ));
      {
        state: match h.return_clause {
          Some(r) -> walk_nested_body(env, 1, [], r.body, clauses),
          None -> clauses,
        },
        owner: unknown(HandlerResult, b"the value a `handle` returned"),
      }
    },
    CodeSimulate(x) ->
      {
        state: walk_nested_body(
          env,
          0,
          [],
          x.body,
          mark_captured_shared(env, state, x.captures, x.body, x.at),
        ),
        owner: unknown(HandlerResult, b"the value a `simulate` returned"),
      },
  }

fn join(a: Owner, b: Owner) -> Owner =
  match a {
    SharedOwner(_) -> a,
    _ -> match b {
      SharedOwner(_) -> b,
      _ -> match a {
        UnknownOwner(_) -> a,
        _ -> match b { UnknownOwner(_) -> b, _ -> match a { ParamOwner(_) -> a, _ -> b } },
      },
    },
  }

fn walk_nested_body(
  env: Env,
  n: Int,
  owners: List<Owner>,
  body: Code,
  state: CostState,
) -> CostState / {abort.raise} = {
  let inner = with_chain(
    state,
    range(0, n).map(|i: Int|
      {
        slot: i,
        owner: match owners.at(i) {
          Some(o) -> o,
          None ->
            unknown(
              ClosureParam,
              b"a parameter of a closure whose callers this body cannot identify",
            ),
        },
      }),
  );
  with_chain(walk(env, body, inner).state, state.chain)
}

fn mark_captured_shared(
  env: Env,
  state: CostState,
  caps: List<Capture>,
  body: Code,
  at: Span,
) -> CostState =
  caps.fold(state, |accumulator: CostState, capture: Capture|
    if capture_moved(env.moves, at, capture.source) { accumulator } else {
      match owner_of(accumulator, capture.source) {
        None -> accumulator,
        Some(SharedOwner(_)) -> accumulator,
        Some(_) ->
          rebind(
            accumulator,
            capture.source,
            blocked(
              CapturedValue,
              Bytes::concat_all([
                b"a closure captured `",
                match first_name(body, capture.destination) { Some(n) -> n, None -> b"" },
                b"`, so the closure owns its own copy of the value",
              ]),
            ),
          ),
      }
    })

fn first_name(c: Code, slot: Int) -> Option<Bytes> =
  match c.node {
    CodeVariable(v) -> if v.slot == slot { Some(v.name) } else { None },
    CodeLambda(l) -> through(l.captures, l.body, slot),
    CodeSimulate(x) -> through(x.captures, x.body, slot),
    CodeHandle(h) -> {
      let found = h.clauses.fold(
        first_name(h.body, slot),
        |accumulator: Option<Bytes>, clause: CodeClause|
          match accumulator {
            Some(_) -> accumulator,
            None -> through(clause.captures, clause.body, slot),
          },
      );
      match found {
        Some(_) -> found,
        None -> match h.return_clause {
          Some(r) -> through(r.captures, r.body, slot),
          None -> None,
        },
      }
    },
    _ ->
      children(c).fold(None, |accumulator: Option<Bytes>, x: Code|
        match accumulator { Some(_) -> accumulator, None -> first_name(x, slot) }),
  }

fn through(caps: List<Capture>, body: Code, slot: Int) -> Option<Bytes> =
  caps.fold(None, |accumulator: Option<Bytes>, capture: Capture|
    match accumulator {
      Some(_) -> accumulator,
      None -> if capture.source == slot { first_name(body, capture.destination) } else { None },
    })

fn children(c: Code) -> List<Code> =
  match c.node {
    CodeUnary(u) -> [u.operand],
    CodeBinary(b) -> [b.left_operand, b.right_operand],
    CodeApply(a) ->
      a.args.fold([a.function], |accumulator: List<Code>, x: Code| accumulator.push(x)),
    CodeKnownLambda(_) -> [],
    CodeIf(i) -> [i.cond, i.then_branch, i.else_branch],
    CodeBlock(b) -> {
      let statements = b.statements.map(|statement: CodeStatement|
        match statement {
          CodeLet(l) -> l.value,
          CodeLetDestructure(l) -> l.value,
          CodeDo(d) -> d.code,
        });
      match b.tail { Some(t) -> statements.push(t), None -> statements }
    },
    CodeList(l) -> l.items,
    CodeRecord(r) -> r.fields.map(|f: CodeField| f.value),
    CodeUpdate(_) -> code_children(c),
    CodeFieldRead(f) -> [f.base],
    CodeMatch(m) ->
      m.arms.fold([m.scrutinee], |accumulator: List<Code>, a: CodeArm|
        List::push(match a.guard { Some(g) -> accumulator.push(g), None -> accumulator }, a.body)),
    CodePerform(p) -> p.args,
    CodeParallel(parallel_code) -> parallel_code.branches,
    _ -> [],
  }

fn unbound_owner(name: Bytes) -> Owner =
  unknown(
    ClosureParam,
    Bytes::concat_all([
      b"`",
      name,
      b"` is free in this closure; whether the closure's copy is the only other owner when the update runs is not a property of this body",
    ]),
  )

fn variable_owner(env: Env, name: Bytes, slot: Int, moved: Bool, state: CostState) -> WithOwner =
  match owner_of(state, slot) {
    Some(o) ->
      {
        state: state,
        owner: if moved { o } else {
          blocked(
            ReadAgain,
            Bytes::concat_all([
              b"`",
              name,
              b"` is read again after this point, so this use clones it",
            ]),
          )
        },
      },
    None -> { state: state, owner: unbound_owner(name) },
  }

type NamedGlobal = { name: Bytes, definition: Option<Int> }

fn global_named(prog: Program, c: Code) -> Option<NamedGlobal> =
  match c.node {
    NDefinition(d) -> match prelude_own(d.full) {
      Some(name) -> Some({ name: name, definition: None }),
      None -> Some({ name: d.full, definition: prog.index.get(d.full) }),
    },
    NConstructor(k) -> Some({ name: k.name, definition: None }),
    NBuiltin(b) -> Some({ name: b.name, definition: None }),
    _ -> None,
  }

fn global_read(env: Env, c: Code, state: CostState) -> WithOwner =
  match global_named(env.prog, c) { Some(n) -> global_owner(n, state), None -> fresh(state) }

fn global_owner(named: NamedGlobal, state: CostState) -> WithOwner =
  match named.definition {
    Some(d) ->
      {
        state: add_escaped(state, d),
        owner: blocked(
          TopLevelValue,
          b"a top-level definition, which stays alive for the whole program",
        ),
      },
    None -> { state: state, owner: unbound_owner(named.name) },
  }

fn app(
  env: Env,
  span: Span,
  function: Code,
  args: List<Code>,
  state: CostState,
) -> WithOwner / {abort.raise} = {
  let named = global_named(env.prog, function);
  let callee = match named { Some(x) -> x.definition, None -> None };
  let builtin = match named {
    Some(x) -> if x.definition != None || !env.prog.builtins.contains(x.name) { None }
    else { Some(x.name) },
    None -> None,
  };
  let n = args.len();
  let before = match named {
    Some(_) -> state,
    None -> match function.node { CodeVariable(_) -> state, _ -> walk(env, function, state).state },
  };
  let walked: Args = args.fold({ state: before, owners: [] }, |accumulator: Args, arg: Code| {
    let w = match callback_owners(builtin, accumulator.owners.len(), accumulator.owners) {
      Some(owners) -> callback(env, owners, arg, accumulator.state),
      None -> walk(env, arg, accumulator.state),
    };
    { state: w.state, owners: accumulator.owners.push(w.owner) }
  });
  let sited = match update_of(builtin, n) {
    Some(operation) -> add_site(walked.state, span, operation, owner_at(walked.owners, 0)),
    None -> walked.state,
  };
  let demanded = match callee {
    None -> sited,
    Some(d) ->
      range(0, n).fold(sited, |accumulator: CostState, j: Int|
        match owner_at(walked.owners, j) {
          FreshOwner -> accumulator,
          o -> add_demand(accumulator, { callee: d, param: j, owner: o }),
        }),
  };
  let read = match ((builtin, callee)) {
    (None, Some(d)) -> match env.tables.rets.at(d) {
      Some(r) -> { ..demanded, reads: demanded.reads.push({ callee: d, return_ownership: r }) },
      None -> demanded,
    },
    _ -> demanded,
  };
  { state: read, owner: result_owner(env, builtin, callee, walked.owners) }
}

fn update_of(builtin: Option<Bytes>, n: Int) -> Option<Bytes> =
  match builtin {
    Some(b) -> if (b == b"List::push" && n == 2)
        || ((b == b"List::set" || b == b"Array::set") && n == 3) { Some(b) }
    else { None },
    None -> None,
  }

fn container_name(operation: Bytes) -> Bytes =
  if operation == b"Array::set" { b"array" } else { b"list" }

fn result_owner(env: Env, builtin: Option<Bytes>, callee: Option<Int>, args: List<Owner>) -> Owner =
  match builtin {
    None -> match callee {
      None ->
        unknown(CallResult, b"the value a call returned, which the callee may still reference"),
      Some(d) -> match env.tables.rets.at(d) {
        Some(ReturnOfParam(k)) -> match args.at(k) {
          Some(o) -> o,
          None -> unknown(CallResult, b"a call returning an argument it was not given"),
        },
        Some(SharedReturn(reason)) -> SharedOwner(reason),
        Some(UnsureReturn(reason)) -> UnknownOwner(reason),
        _ -> FreshOwner,
      },
    },
    Some(b) -> if b == b"Scoped::get" {
      blocked(ContainerElement, b"`Scoped::get` returns a copy of a value the scope still owns")
    } else if b == b"Map::get" || reads_entries(b) {
      blocked(MapEntry, Bytes::concat_all([b"`", b, b"` returns a clone the map still contains"]))
    } else if b == b"Map::pop_first" || b == b"Map::pop_last" || b == b"Map::split" {
      owner_at(args, 0)
    } else if b == b"List::at" {
      blocked(ContainerElement, b"`List::at` returns a clone of an element the list still owns")
    } else if b == b"Array::at" || b == b"Array::get" {
      blocked(
        ContainerElement,
        Bytes::concat_all([b"`", b, b"` returns a clone the array still contains"]),
      )
    } else if b == b"bracket" {
      unknown(CallResult, b"`bracket` returns whatever its body returned")
    } else {
      match prelude_callback_use(b) {
        Some(it) -> if it.result == Folded {
          unknown(
            CallResult,
            Bytes::concat_all([b"`", b, b"` returns whatever its callback returned"]),
          )
        } else { FreshOwner },
        None -> FreshOwner,
      }
    },
  }

fn reads_entries(b: Bytes) -> Bool =
  b == b"Map::first" || b == b"Map::last" || b == b"Map::floor" || b == b"Map::ceiling"
    || b == b"Map::below"
    || b == b"Map::above"
    || b == b"Map::range"

fn callback_owners(
  builtin: Option<Bytes>,
  position: Int,
  done: List<Owner>,
) -> Option<List<Owner>> =
  match builtin {
    None -> None,
    Some(b) -> match prelude_callback_use(b) {
      None -> None,
      Some(it) -> if it.callback != position { None } else {
        let given = |k: Int|
          match done.at(k) {
            Some(o) -> o,
            None ->
              unknown(
                CallResult,
                b"an argument written after the callback in the call's argument list",
              ),
          };
        Some(
          it.params.map(|h: CallbackArgument|
            match h {
              Element -> element_owner,
              Accumulator(k) -> given(k),
              ExtractedFrom(k) -> given(k),
              Number -> FreshOwner,
              UnknownArgument ->
                unknown(
                  ClosureParam,
                  b"a parameter of a closure whose callers this body cannot identify",
                ),
            }),
        )
      },
    },
  }

fn callback(
  env: Env,
  owners: List<Owner>,
  arg: Code,
  state: CostState,
) -> WithOwner / {abort.raise} =
  match arg.node {
    CodeLambda(l) ->
      fresh(
        mark_captured_shared(
          env,
          walk_nested_body(env, l.params, owners, l.body, state),
          l.captures,
          l.body,
          l.at,
        ),
      ),
    _ -> walk(env, arg, state),
  }

fn later_reason(a: Reason, b: Reason) -> Reason =
  match compare(a.cause, b.cause) {
    Less -> b,
    Greater -> a,
    Equal -> match compare(a.text, b.text) { Less -> b, _ -> a },
  }

fn worse(a: ParamSharing, b: ParamSharing) -> ParamSharing =
  match ((a, b)) {
    (SharedParam(x), SharedParam(y)) -> SharedParam(later_reason(x, y)),
    (SharedParam(_), _) -> a,
    (_, SharedParam(_)) -> b,
    (UnsureParam(x), UnsureParam(y)) -> UnsureParam(later_reason(x, y)),
    (UnsureParam(_), _) -> a,
    (_, UnsureParam(_)) -> b,
    _ -> a,
  }

fn slot_sharing(slots: Map<Int, ParamSharing>, index: Int) -> ParamSharing =
  match slots.get(index) { Some(p) -> p, None -> SoleParam }

fn sharing_of(table: ParamTable, parameter: DefinitionParameter) -> ParamSharing =
  match table.get(parameter.definition) {
    None -> SoleParam,
    Some(slots) -> slot_sharing(slots, parameter.index),
  }

fn combine_param(table: ParamTable, callee: Bytes, param: Int, p: ParamSharing) -> ParamTable = {
  let slots = match table.get(callee) { Some(s) -> s, None -> Map::new() };
  let met = worse(slot_sharing(slots, param), p);
  match met { SoleParam -> table, _ -> table.insert(callee, slots.insert(param, met)) }
}

fn return_of(owner: Owner) -> ReturnOwnership =
  match owner {
    FreshOwner -> FreshReturn,
    ParamOwner(p) -> ReturnOfParam(p.index),
    SharedOwner(reason) -> SharedReturn(reason),
    UnknownOwner(reason) -> UnsureReturn(reason),
  }

fn interpret(owner: Owner, table: ParamTable, label: Bytes) -> ParamSharing =
  match owner {
    FreshOwner -> SoleParam,
    SharedOwner(reason) ->
      SharedParam(
        reworded(reason, Bytes::concat_all([label, b" passes a value; reason: ", reason.text])),
      ),
    UnknownOwner(reason) ->
      UnsureParam(
        reworded(reason, Bytes::concat_all([label, b" passes a value; reason: ", reason.text])),
      ),
    ParamOwner(p) -> match sharing_of(table, p) {
      SoleParam -> SoleParam,
      UnsureParam(reason) ->
        UnsureParam(
          reworded(
            reason,
            Bytes::concat_all([
              label,
              b" passes its own parameter ",
              ascii_of_int(p.index),
              b", whose ownership is not yet known",
            ]),
          ),
        ),
      SharedParam(reason) ->
        SharedParam(
          reworded(
            reason,
            Bytes::concat_all([
              label,
              b" passes its own parameter ",
              ascii_of_int(p.index),
              b", which the function's callers may still use after the call",
            ]),
          ),
        ),
    },
  }

fn start_returns(definitions: List<Definition>) -> Tables =
  {
    rets: definitions.map(|d: Definition|
      if d.own { FreshReturn } else {
        match d.declared_return {
          Some(x) -> x.return_type,
          None ->
            UnsureReturn({
              cause: CallResult,
              text: Bytes::concat_all([
                b"`",
                d.name,
                b"` is another package's, and its signature writes no `returns`",
              ]),
            }),
        }
      }),
  }

fn walk_body(env: Env, b: Body) -> WalkResult / {abort.raise} = {
  let owner_of_parameter = |k: Int|
    match b.item_kind {
      CostedFunction(d) -> ParamOwner({ definition: env.prog.definitions.get(d).name, index: k }),
      _ -> FreshOwner,
    };
  let chain = range(0, b.arity).map(|k: Int| { slot: k, owner: owner_of_parameter(k) });
  let w = walk({ ..env, moves: b.moves }, b.code, {
    chain: chain,
    sites: [],
    demands: [],
    escaped: [],
    reads: [],
  });
  {
    sites: w.state.sites,
    demands: w.state.demands,
    used_as_values: w.state.escaped,
    return_owner: w.owner,
    reads: w.state.reads,
  }
}

fn walks(prog: Program, tables: Tables) -> List<WalkResult> / {abort.raise} =
  prog.bodies.map(|b: Body|
    walk_body({ prog: prog, module: b.module, tables: tables, moves: no_moves }, b))

fn return_rank(r: ReturnOwnership) -> Int =
  match r { FreshReturn -> 0, ReturnOfParam(_) -> 1, UnsureReturn(_) -> 2, SharedReturn(_) -> 3 }

fn raised(held: ReturnOwnership, found: ReturnOwnership) -> ReturnOwnership =
  if return_rank(found) > return_rank(held) { found } else { held }

fn with_returns(prog: Program, found: List<WalkResult>, tables: Tables) -> Tables / {abort.raise} =
  range(0, prog.bodies.len()).fold(tables, |accumulator: Tables, i: Int| {
    let b: Body = prog.bodies.get(i);
    match b.item_kind {
      CostedFunction(d) ->
        {
          rets: accumulator.rets.set(
            d,
            raised(accumulator.rets.get(d), return_of(found.get(i).return_owner)),
          ),
        },
      _ -> accumulator,
    }
  })

type Settled = { found: List<WalkResult>, tables: Tables }

fn defined_bodies(prog: Program) -> Int =
  prog.bodies.filter(|b: Body| match b.item_kind { CostedFunction(_) -> true, _ -> false }).len()

fn settled_walks(prog: Program, tables: Tables) -> Settled / {abort.raise} =
  iterate(tables, 3 * defined_bodies(prog) + 1, |held: Tables| {
    let found = walks(prog, held);
    let next = with_returns(prog, found, held);
    if next == held { Stop({ found: found, tables: held }) } else { Continue(next) }
  })

fn called_outside(prog: Program, found: List<WalkResult>) -> List<Int> = {
  let inside = prog.bodies.fold(Set::empty(), |accumulator: Set<Int>, b: Body|
    match b.item_kind { CostedFunction(d) -> accumulator.insert(d), _ -> accumulator });
  found.fold(Set::empty(), |accumulator: Set<Int>, f: WalkResult|
    f.reads.fold(accumulator, |m: Set<Int>, r: ReturnRead|
      if inside.contains(r.callee) { m } else { m.insert(r.callee) })).elements(
  )
}

fn relative(p: CostInput, span: Span) -> Span =
  { ..span, start: span.start - p.origin, end: span.end - p.origin }

fn walked_body(
  p: CostInput,
  prog: Program,
  settled: Settled,
  b: Body,
  f: WalkResult,
) -> WalkedBody / {abort.raise} = {
  let own = |d: Int| prog.definitions.get(d).own;
  let name = |d: Int| prog.definitions.get(d).name;
  {
    item_kind: match b.item_kind {
      CostedFunction(d) -> CostedFunction(name(d)),
      CostedTest -> CostedTest,
      CostedLaw -> CostedLaw,
    },
    module_name: b.module_name,
    name: b.name,
    label: b.label,
    reuse: match b.reuse { Some(s) -> Some(relative(p, s)), None -> None },
    sites: f.sites.map(|s: RawSite| { ..s, span: relative(p, s.span) }),
    demands: f.demands.filter(|d: PassedArgument| own(d.callee)).map(|d: PassedArgument|
      { callee: name(d.callee), param: d.param, owner: d.owner }),
    escaped: f.used_as_values.filter(own).map(|d: Int|
      { callee: name(d), arity: prog.definitions.get(d).arity }),
    returned: match b.item_kind {
      CostedFunction(d) -> settled.tables.rets.get(d),
      _ -> return_of(f.return_owner),
    },
  }
}

fn declared_in(p: CostInput, prog: Program) -> List<DeclaredReturn> / {abort.raise} =
  prog.bodies.fold([], |accumulator: List<DeclaredReturn>, b: Body|
    match b.item_kind {
      CostedFunction(index) -> {
        let d: Definition = prog.definitions.get(index);
        match d.declared_return {
          None -> accumulator,
          Some(x) ->
            accumulator.push({
              module_name: d.module_name,
              definition: d.name,
              params: d.params,
              declared: x.return_type,
              span: relative(p, x.span),
            }),
        }
      },
      _ -> accumulator,
    })

pub fn walked_group<| e>(
  p: CostInput,
  returned: (Bytes) -> ReturnOwnership / {abort.raise | e},
) -> GroupWalk / {EmitReads | e} =
  match program_of(p) {
    Err(reason) -> { unfinished: [reason], bodies: [], declared: [] },
    Ok(prog) -> {
      let start = start_returns(prog.definitions);
      let outside = called_outside(prog, walks(prog, start)).filter(|d: Int|
        prog.definitions.get(d).own);
      let tables = outside.fold(start, |accumulator: Tables, d: Int|
        { rets: accumulator.rets.set(d, returned(prog.definitions.get(d).name)) });
      let settled = settled_walks(prog, tables);
      {
        unfinished: [],
        bodies: range(0, prog.bodies.len()).map(|i: Int|
          walked_body(p, prog, settled, prog.bodies.get(i), settled.found.get(i))),
        declared: declared_in(p, prog),
      }
    },
  }

pub fn demands_of(walked: List<GroupWalk>) -> ModuleDemands =
  {
    unfinished: walked.flat_map(|w: GroupWalk| w.unfinished),
    bodies: walked.fold([], |accumulator: List<BodyDemands>, w: GroupWalk|
      w.bodies.fold(accumulator, |a: List<BodyDemands>, b: WalkedBody|
        if b.demands.len() == 0 && b.escaped.len() == 0 { a }
        else { a.push({ label: b.label, escaped: b.escaped, demands: b.demands }) })),
  }

fn escaped_from(table: ParamTable, label: Bytes, e: Escape) -> ParamTable =
  range(0, e.arity).fold(table, |accumulator: ParamTable, k: Int|
    combine_param(
      accumulator,
      e.callee,
      k,
      UnsureParam({
        cause: TopLevelValue,
        text: Bytes::concat_all([
          b"`",
          e.callee,
          b"` is used as a value in ",
          label,
          b", so not every caller of it is known",
        ]),
      }),
    ))

fn parameters_round(rollups: List<ModuleDemands>, table: ParamTable) -> ParamTable =
  rollups.fold(Map::new(), |accumulator: ParamTable, m: ModuleDemands|
    m.bodies.fold(accumulator, |round: ParamTable, b: BodyDemands| {
      let escaped = b.escaped.fold(round, |s: ParamTable, e: Escape| escaped_from(s, b.label, e));
      b.demands.fold(escaped, |s: ParamTable, d: Demand|
        combine_param(s, d.callee, d.param, interpret(d.owner, table, b.label)))
    }))

fn demanded_parameters(rollups: List<ModuleDemands>) -> Int =
  rollups.fold(Set::empty(), |found: Set<DefinitionParameter>, m: ModuleDemands|
    m.bodies.fold(found, |in_module: Set<DefinitionParameter>, b: BodyDemands| {
      let escaped = b.escaped.fold(in_module, |s: Set<DefinitionParameter>, e: Escape|
        range(0, e.arity).fold(s, |t: Set<DefinitionParameter>, k: Int|
          t.insert({ definition: e.callee, index: k })));
      b.demands.fold(escaped, |s: Set<DefinitionParameter>, d: Demand|
        s.insert({ definition: d.callee, index: d.param }))
    })).size(
  )

pub fn parameters_of(rollups: List<ModuleDemands>) -> Parameters / {abort.raise} =
  {
    table: iterate(Map::new(), demanded_parameters(rollups) + 2, |table: ParamTable| {
      let next = parameters_round(rollups, table);
      if next == table { Stop(table) } else { Continue(next) }
    }),
  }

fn suggestion_for(cause: Cause) -> Option<Bytes> =
  match cause {
    ReadAgain ->
      Some(
        b"make the update the last use of the variable: first bind anything else you need from the variable to new names",
      ),
    MapEntry -> Some(b"`Map::update`"),
    CapturedValue -> Some(b"bind the value before the closure captures it, or capture less"),
    CallerRetains ->
      Some(b"change the call site: the caller uses the value it passes again after the call"),
    _ -> None,
  }

pub type Site = { start: Int, end: Int, operation: Bytes, verdict: Verdict }

pub type Costed = {
  item_kind: CostedKind<Bytes>,
  module: Int,
  module_name: Bytes,
  name: Bytes,
  label: Bytes,
  reuse_keyword: Option<Span>,
  sites: List<Site>,
}

pub type ReturnMismatch = {
  module: Int,
  module_name: Bytes,
  name: Bytes,
  start: Int,
  end: Int,
  declared: Bytes,
  actual: Bytes,
}

pub type Report = {
  unfinished: List<Bytes>,
  definitions: List<Costed>,
  return_mismatches: List<ReturnMismatch>,
}

derive bin for Site
derive bin for Costed
derive bin for ReturnMismatch
derive bin for Report

pub fn placed_span(items: List<ItemAt>, span: Span) -> Span =
  { ..span, start: placed_position(items, span.start), end: placed_position(items, span.end) }

fn finish(raw: RawSite, table: ParamTable) -> Site = {
  let sited = |verdict: Verdict|
    { start: raw.span.start, end: raw.span.end, operation: raw.builtin_name, verdict: verdict };
  match raw.owner {
    FreshOwner ->
      sited(
        Reuses(
          Bytes::concat_all([
            b"the ",
            container_name(raw.builtin_name),
            b" reaches `",
            raw.builtin_name,
            b"` with a single reference",
          ]),
        ),
      ),
    SharedOwner(reason) -> sited(Copies(reason, Local)),
    UnknownOwner(reason) -> sited(Undecided(reason, Local)),
    ParamOwner(p) -> {
      let head = Bytes::concat_all([
        b"the ",
        container_name(raw.builtin_name),
        b" is parameter ",
        ascii_of_int(p.index),
      ]);
      let origin = Parameter(p.index);
      match sharing_of(table, p) {
        SoleParam ->
          sited(Reuses(head.concat(b", and every call site passes it and never uses it again"))),
        SharedParam(reason) ->
          sited(
            Copies(
              {
                cause: CallerRetains,
                text: Bytes::concat_all([
                  head,
                  b", and a caller uses it again after the call: ",
                  reason.text,
                ]),
              },
              origin,
            ),
          ),
        UnsureParam(reason) ->
          sited(
            Undecided(
              {
                cause: reason.cause,
                text: Bytes::concat_all([
                  head,
                  b", and it is unclear whether a call site uses it again: ",
                  reason.text,
                ]),
              },
              origin,
            ),
          ),
      }
    },
  }
}

fn quoted(s: Bytes) -> Bytes =
  Bytes::concat_all([
    b"\"",
    Bytes::concat_all(
      range(0, s.len()).map(|i: Int| {
        let c = s.at(i);
        if c == 34 { b"\\\"" }
        else if c == 92 { b"\\\\" }
        else if c == 10 { b"\\n" }
        else if c == 13 { b"\\r" }
        else if c == 9 { b"\\t" }
        else { s.slice(i, i + 1) }
      }),
    ),
    b"\"",
  ])

fn module_bodies(
  i: Int,
  setting: ModuleContext,
  roots: List<ItemRoot>,
  index: Map<Bytes, Int>,
) -> List<Body> / {EmitReads} = {
  let s = setting;
  let m = setting.module;
  roots.fold([], |a: List<Body>, ir: ItemRoot| {
    let moves = root_moves(s, ir.root);
    let body = |kind: CostedKind<Int>, name: Bytes, label: Bytes, reuse: Option<Span>|
      {
        item_kind: kind,
        module: i,
        module_name: m,
        name: name,
        label: label,
        arity: ir.root.params.len(),
        code: ir.root.code,
        moves: moves,
        reuse: reuse,
      };
    match ir.item {
      FunctionItem(d) ->
        a.push(
          body(
            CostedFunction(match index.get(qualify(m, d.name.name)) {
              Some(definition) -> definition,
              None -> panic("a function body has no definition among the program's definitions"),
            }),
            d.name.name,
            Bytes::concat_all([m, b".", d.name.name]),
            d.reuse,
          ),
        ),
      TestItem(t) ->
        a.push(body(CostedTest, t.name, Bytes::concat_all([m, b": test ", quoted(t.name)]), None)),
      LawItem(l) ->
        a.push(body(CostedLaw, l.name, Bytes::concat_all([m, b": law ", quoted(l.name)]), None)),
      _ -> a,
    }
  })
}

fn definition_of_function(
  module: Bytes,
  own: Bool,
  definition: FnDefinition,
  witnesses: List<Bytes>,
) -> Definition = {
  let params = witnesses.concat(definition.params.map(|param: Param| param.name.name));
  {
    name: qualify(module, definition.name.name),
    module_name: module,
    params: params,
    arity: params.len(),
    own: own,
    declared_return: declared_at(call_shape(definition).returned, match definition.returns {
      Some(ReturnsFresh(return_span)) -> return_span,
      Some(ReturnsParam(x)) -> x.span,
      None -> generated_span,
    }),
  }
}

fn declared_at(stated: Option<StatedReturn>, span: Span) -> Option<DeclaredAt> =
  match stated {
    None -> None,
    Some(StatedFresh) -> Some({ return_type: FreshReturn, span: span }),
    Some(StatedParameter(k)) -> Some({ return_type: ReturnOfParam(k), span: span }),
  }

fn definition_elsewhere(
  module: Bytes,
  own: Bool,
  d: representations::Definition,
) -> Definition / {EmitReads} =
  {
    name: qualify(module, d.name),
    module_name: module,
    params: [],
    arity: d.arity,
    own: own,
    declared_return: declared_at(returned_called(qualify(module, d.name)), generated_span),
  }

fn violates(declared: ReturnOwnership, got: ReturnOwnership) -> Bool =
  match got {
    FreshReturn -> false,
    ReturnOfParam(k) -> match declared { ReturnOfParam(j) -> j != k, _ -> true },
    _ -> true,
  }

fn return_text(params: List<Bytes>, r: ReturnOwnership) -> Bytes =
  match r {
    FreshReturn -> b"fresh",
    ReturnOfParam(k) ->
      Bytes::concat_all([
        b"its parameter `",
        match params.at(k) { Some(n) -> n, None -> ascii_of_int(k) },
        b"`",
      ]),
    SharedReturn(reason) -> reason.text,
    UnsureReturn(reason) -> reason.text,
  }

const builtin_names: List<Bytes> = builtins.map(|b: Builtin| b.name)

pub type CostInput = {
  modules: List<ParsedModule>,
  r: Resolution,
  checked: CheckOutput,
  module_packages: List<Int>,
  embeds: List<ModuleEmbed>,
  rows: Rows,
  facts: InferredFacts,
  walked: List<Int>,
  roots: Option<Set<Bytes>>,
  origin: Int,
}

pub fn cost_input_of(analysis: Analysis) -> CostInput / {abort.raise} =
  {
    modules: analysis.modules,
    r: analysis.r,
    checked: analysis.checked,
    module_packages: analysis.module_packages,
    embeds: analysis.embeds,
    rows: rows_of(analysis),
    facts: inferred_facts(analysis),
    walked: range(0, analysis.modules.len()).filter(|i: Int|
      own_module(analysis.module_packages, i)),
    roots: None,
    origin: 0,
  }

fn own_module(module_packages: List<Int>, i: Int) -> Bool =
  match module_packages.at(i) { Some(k) -> k == 0, None -> true }

fn places(modules: List<ParsedModule>) -> Map<Bytes, Int> / {abort.raise} =
  range(0, modules.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
    accumulator.insert(modules.get(i).name, i))

fn placed(here: Map<Bytes, Int>, names: List<Bytes>, k: Int) -> Option<Int> =
  match names.at(k) { Some(n) -> here.get(n), None -> None }

fn orders_by_module(
  w: InferredFacts,
  modules: List<ParsedModule>,
) -> Map<Int, Map<Bytes, List<Bytes>>> / {abort.raise} = {
  let here = places(modules);
  w.orders.fold(Map::new(), |accumulator: Map<Int, Map<Bytes, List<Bytes>>>, o: WitnessOrder|
    match placed(here, w.modules, o.module) {
      None -> accumulator,
      Some(i) -> {
        let was = match accumulator.get(i) { Some(m) -> m, None -> Map::new() };
        accumulator.insert(i, was.insert(o.name, o.params))
      },
    })
}

fn definitions_of(p: CostInput) -> List<Definition> / {abort.raise} = {
  let orders = orders_by_module(p.facts, p.modules);
  range(0, p.modules.len()).fold([], |accumulator: List<Definition>, i: Int| {
    let m: ParsedModule = p.modules.get(i);
    let ws = match orders.get(i) { Some(o) -> o, None -> Map::new() };
    let own = own_module(p.module_packages, i);
    let written = m.module.items.fold(accumulator, |xs: List<Definition>, item: Item|
      match item {
        FunctionItem(d) ->
          xs.push(
            definition_of_function(m.name, own, d, match ws.get(d.name.name) {
              Some(w) -> w.map(witness_param_name),
              None -> [],
            }),
          ),
        _ -> xs,
      });
    written
  })
}

fn called_names(found: List<Bytes>, c: Code) -> List<Bytes> / {abort.raise} =
  code_children(c).fold(
    match c.node {
      NDefinition(d) -> if found.contains(d.full) { found } else { found.push(d.full) },
      _ -> found,
    },
    called_names,
  )

fn with_definitions_elsewhere(
  p: CostInput,
  definitions: List<Definition>,
  bodies: List<Body>,
) -> List<Definition> / {EmitReads} = {
  let places = places(p.modules);
  bodies.fold([], |found: List<Bytes>, b: Body| called_names(found, b.code)).fold(
    definitions,
    |all: List<Definition>, full: Bytes|
      if all.any(|d: Definition| d.name == full) { all } else {
        let module = module_of_name(full);
        match places.get(module) {
          None -> all,
          Some(i) -> match definition_called(full) {
            Some(d) -> all.push(definition_elsewhere(module, own_module(p.module_packages, i), d)),
            None -> all,
          },
        }
      },
  )
}

fn lowered_bodies(
  p: CostInput,
  index: Map<Bytes, Int>,
) -> Result<List<Body>, Bytes> / {EmitReads} = {
  let tables = embed_tables(p.embeds);
  let wants = p.walked.fold(Set::empty(), |m: Set<Int>, i: Int| m.insert(i));
  let read = range(0, p.modules.len()).fold(
    { modules: [], rejected: [] },
    |accumulator: { modules: List<ParsedModule>, rejected: List<ParseDiagnostic> }, i: Int| {
      let m: ParsedModule = p.modules.get(i);
      if !wants.contains(i) { { ..accumulator, modules: accumulator.modules.push(m) } } else {
        let e = inline_embeds_by_name(tables, m.name, m.module);
        {
          modules: accumulator.modules.push({ ..m, module: e.module }),
          rejected: accumulator.rejected.concat(e.diagnostics),
        }
      }
    },
  );
  if read.rejected.len() > 0 {
    Err(Bytes::join(read.rejected.map(|d: ParseDiagnostic| d.message), b"; "))
  } else {
    match module_contexts_in(
        p.r,
        p.rows,
        p.facts,
        read.modules,
        p.walked,
        |i: Int, s: ModuleContext, roots: List<ItemRoot>| module_bodies(i, s, roots, index),
        match p.roots {
          None -> None,
          Some(roots) ->
            Some({
              roots: roots,
              modules: p.walked.fold(Set::empty(), |m: Set<Bytes>, i: Int|
                m.insert(p.modules.get(i).name)),
            }),
        },
      ) {
      Err(reason) -> Err(reason),
      Ok(bodies) -> Ok(bodies.fold([], |a: List<Body>, b: List<Body>| a.concat(b))),
    }
  }
}

fn indexed(definitions: List<Definition>) -> Map<Bytes, Int> / {abort.raise} =
  range(0, definitions.len()).fold(Map::new(), |accumulator: Map<Bytes, Int>, i: Int|
    accumulator.insert(definitions.get(i).name, i))

fn program_of(p: CostInput) -> Result<Program, Bytes> / {EmitReads} = {
  let written = definitions_of(p);
  match lowered_bodies(p, indexed(written)) {
    Err(reason) -> Err(reason),
    Ok(bodies) -> {
      let definitions = with_definitions_elsewhere(p, written, bodies);
      Ok({
        index: indexed(definitions),
        builtins: builtin_names.fold(Set::empty(), |accumulator: Set<Bytes>, b: Bytes|
          accumulator.insert(b)),
        definitions: definitions,
        bodies: bodies,
      })
    },
  }
}

pub type PlacedWalk = { items: List<ItemAt>, walk: GroupWalk }

fn costed_in(table: ParamTable, placed: PlacedWalk) -> List<Costed> =
  placed.walk.bodies.fold([], |accumulator: List<Costed>, b: WalkedBody|
    if b.sites.len() == 0 { accumulator } else {
      accumulator.push({
        item_kind: b.item_kind,
        module: 0,
        module_name: b.module_name,
        name: b.name,
        label: b.label,
        reuse_keyword: match b.reuse {
          Some(s) -> Some(placed_span(placed.items, s)),
          None -> None,
        },
        sites: b.sites.map(|raw: RawSite|
          finish({ ..raw, span: placed_span(placed.items, raw.span) }, table)),
      })
    })

fn mismatches_in(placed: PlacedWalk) -> List<ReturnMismatch> =
  placed.walk.declared.fold([], |accumulator: List<ReturnMismatch>, d: DeclaredReturn|
    match placed.walk.bodies.find(|b: WalkedBody| b.item_kind == CostedFunction(d.definition)) {
      None -> accumulator,
      Some(b) -> if !violates(d.declared, b.returned) { accumulator } else {
        let at = placed_span(placed.items, d.span);
        accumulator.push({
          module: 0,
          module_name: d.module_name,
          name: d.definition,
          start: at.start,
          end: at.end,
          declared: return_text(d.params, d.declared),
          actual: return_text(d.params, b.returned),
        })
      },
    })

fn first_site(c: Costed) -> Int = match c.sites.at(0) { Some(s) -> s.start, None -> 0 }

pub fn module_costs(walks: List<PlacedWalk>, parameters: Parameters) -> Report =
  {
    unfinished: walks.flat_map(|w: PlacedWalk| w.walk.unfinished),
    definitions: walks.fold([], |accumulator: List<Costed>, w: PlacedWalk|
      accumulator.concat(costed_in(parameters.table, w))).sort_by(|a: Costed, b: Costed|
      first_site(a) <= first_site(b)),
    return_mismatches: walks.fold([], |accumulator: List<ReturnMismatch>, w: PlacedWalk|
      accumulator.concat(mismatches_in(w))).sort_by(|a: ReturnMismatch, b: ReturnMismatch|
      a.start <= b.start),
  }

pub fn report_of(modules: List<Report>) -> Report =
  {
    unfinished: modules.flat_map(|m: Report| m.unfinished),
    definitions: modules.fold([], |accumulator: List<Costed>, m: Report|
      accumulator.concat(m.definitions)),
    return_mismatches: modules.fold([], |accumulator: List<ReturnMismatch>, m: Report|
      accumulator.concat(m.return_mismatches)),
  }

pub fn report_over_one_walk(p: CostInput) -> Report / {EmitReads} = {
  let walked = walked_group(p, |_: Bytes| FreshReturn);
  report_of([module_costs([{ items: [], walk: walked }], parameters_of([demands_of([walked])]))])
}

test "parameters stay sole until a caller's demand reaches them through its own parameter" {
  let rollup: ModuleDemands = {
    unfinished: [],
    bodies: [
      {
        label: b"m.outer",
        escaped: [],
        demands: [
          { callee: b"m.inner", param: 0, owner: ParamOwner({ definition: b"m.outer", index: 0 }) },
        ],
      },
      {
        label: b"m: test",
        escaped: [],
        demands: [
          {
            callee: b"m.outer",
            param: 0,
            owner: SharedOwner({ cause: ReadAgain, text: b"read again" }),
          },
        ],
      },
    ],
  };
  let settled = parameters_of([rollup]);
  assert(match sharing_of(settled.table, { definition: b"m.inner", index: 0 }) {
    SharedParam(_) -> true,
    _ -> false,
  });
  assert_eq(sharing_of(settled.table, { definition: b"m.other", index: 0 }), SoleParam)
}

fn passes_on(caller: Bytes, callee: Bytes, cause: Cause) -> BodyDemands =
  {
    label: caller,
    escaped: [],
    demands: [
      { callee: callee, param: 0, owner: ParamOwner({ definition: caller, index: 0 }) },
      { callee: callee, param: 0, owner: UnknownOwner({ cause: cause, text: caller }) },
    ],
  }

test "parameters that pass each other's values settle to one table, whatever order the demands come in" {
  let f = passes_on(b"m.f", b"m.g", ReadAgain);
  let g = passes_on(b"m.g", b"m.f", MapEntry);
  let reversed = |b: BodyDemands| { ..b, demands: b.demands.reverse() };
  let settled = parameters_of([{ unfinished: [], bodies: [f, g] }]);
  assert_eq(parameters_of([{ unfinished: [], bodies: [g, f] }]), settled);
  assert_eq(parameters_of([{ unfinished: [], bodies: [reversed(f), reversed(g)] }]), settled)
}
