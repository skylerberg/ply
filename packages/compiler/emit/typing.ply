//! What the checker filed of the nodes of a lowered body, which a value's type is read off.

import compiler.check.types (Type, TyVar, type_at, type_text)
import compiler.check.infer (RootFacts)
import compiler.check.infer.checker (TypedSite, LabelSite, MemberSite, UpdateShape, TrySite,
                                     WitnessOp, WitnessRef, RowSite, FiledRows, filed_rows_text,
                                     ReleaseSite)
import compiler.syntax.parsing (minted_too_deep)
import std.bytes (ascii_of_int)

/// What is known at a node: `ty` is the type the checker filed there, unknown where it settled none,
/// and `args` the type arguments it filled where the node names a generic definition.
pub type Typed = { ty: Type, args: List<Type> }

/// No type: what a node holds where nothing is known of it.
pub fn unknown_type() -> Type = TyVar(0 - 1)

/// What the checker filed at a node.
pub fn filed_as(ty: Type, args: List<Type>) -> Typed = { ty: ty, args: args }

/// What the checker filed for one item's nodes, by site: the types, the labels each call fills,
/// what writing the item out reads of its calls on values, updates, `try`s and witnesses, and the
/// rows evidence is handed by.
pub type Filings = {
  typed: Map<Int, Typed>,
  labels: Map<Int, List<Bytes>>,
  members: Map<Int, MemberSite>,
  updates: Map<Int, UpdateShape>,
  tries: Map<Int, TrySite>,
  ops: Map<Int, WitnessOp>,
  refs: Map<Int, WitnessRef>,
  rows: Map<Int, FiledRows>,
  /// Where the item's body lets go of each resource it owns.
  releases: List<ReleaseSite>,
}

/// What an item with nothing filed of it reads.
pub fn no_filings() -> Filings =
  {
    typed: Map::new(),
    labels: Map::new(),
    members: Map::new(),
    updates: Map::new(),
    tries: Map::new(),
    ops: Map::new(),
    refs: Map::new(),
    rows: Map::new(),
    releases: [],
  }

/// The rows the checker filed at `site`, in the item's own numbering; none where it filed none.
pub fn rows_filed_at(filed: Filings, site: Int) -> Option<FiledRows> = filed.rows.get(site)

/// `facts`, one item's, by site. Two equal filings at one site, a node both of a test's trees hold,
/// are one. Panics on two different filings at one site, or a site minted deeper than a site holds,
/// which the checker never files.
pub fn filings(facts: RootFacts) -> Filings / {abort.raise} = {
  let read = facts.typed.fold(
    { typed: [], read: Map::new() },
    |acc: { typed: List<{ site: Int, t: Typed }>, read: Map<Bytes, Type> }, s: TypedSite| {
      let own = type_at(facts.types, s.ty, acc.read);
      let args = s.args.fold(
        { tys: [], read: own.read },
        |a: { tys: List<Type>, read: Map<Bytes, Type> }, k: Bytes| {
          let t = type_at(facts.types, k, a.read);
          { tys: a.tys.push(t.ty), read: t.read }
        },
      );
      { typed: acc.typed.push({ site: s.site, t: filed_as(own.ty, args.tys) }), read: args.read }
    },
  );
  {
    typed: by_site(
      read.typed,
      |x: { site: Int, t: Typed }| x.site,
      |x: { site: Int, t: Typed }| x.t,
      typed_text,
      b"types",
    ),
    labels: by_site(
      facts.label_sites,
      |x: LabelSite| x.site,
      |x: LabelSite| x.labels,
      |ls: List<Bytes>| Bytes::join(ls, b", "),
      b"labels",
    ),
    members: by_site(
      facts.members,
      |x: MemberSite| x.site,
      |x: MemberSite| x,
      |x: MemberSite| Bytes::concat_all([x.qualifier, b".", x.name]),
      b"callees",
    ),
    updates: by_site(
      facts.updates,
      |x: UpdateShape| x.site,
      |x: UpdateShape| x,
      |x: UpdateShape| Bytes::join(x.names, b", "),
      b"updates",
    ),
    tries: by_site(
      facts.tries,
      |x: TrySite| x.site,
      |x: TrySite| x,
      |x: TrySite| Bytes::concat_all([x.effect, b".", x.op]),
      b"raises",
    ),
    ops: by_site(
      facts.ops,
      |x: WitnessOp| x.site,
      |x: WitnessOp| x,
      |x: WitnessOp| x.param,
      b"witnesses",
    ),
    refs: by_site(
      facts.refs,
      |x: WitnessRef| x.site,
      |x: WitnessRef| x,
      |x: WitnessRef| ascii_of_int(x.witnesses.len()).concat(b" witnesses"),
      b"witnesses passed",
    ),
    rows: by_site(facts.rows, |x: RowSite| x.site, |x: RowSite| x.filed, filed_rows_text, b"rows"),
    releases: facts.releases,
  }
}

/// `xs`, `what` was filed, each as `of` reads it at its `site`, two filings at one site named as
/// `shown` writes each where they differ.
fn by_site<a, b>(
  xs: List<a>,
  site: (a) -> Int,
  of: (a) -> b,
  shown: (b) -> Bytes / {abort.raise},
  what: Bytes,
) -> Map<Int, b> / {abort.raise} =
  xs.fold(Map::new(), |m: Map<Int, b>, x: a| {
    let k = site(x);
    let here = of(x);
    if minted_too_deep(k) {
      panic(
        String::of_bytes_lossy(b"a site minted deeper than a site holds: ".concat(ascii_of_int(k))),
      )
    } else {
      match m.get(k) {
        Some(was) -> if was == here { m } else {
          panic(
            String::of_bytes_lossy(
              Bytes::concat_all([
                b"two different ",
                what,
                b" filed at site ",
                ascii_of_int(k),
                b": ",
                shown(was),
                b" and ",
                shown(here),
              ]),
            ),
          )
        },
        None -> m.insert(k, here),
      }
    }
  })

/// What the checker filed at a node, as a reader writes it: its type, then any type arguments.
fn typed_text(t: Typed) -> Bytes / {abort.raise} =
  if t.args.len() == 0 { type_text(t.ty) } else {
    Bytes::concat_all([type_text(t.ty), b" at [", Bytes::join(t.args.map(type_text), b", "), b"]"])
  }
