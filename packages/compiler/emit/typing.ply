//! What the checker filed of the items a build lowers: each body as it settled it, and where each
//! lets go of what it owns.

import compiler.check.types (Type, TyVar, Row, Atom)
import compiler.check.infer (RootFacts, bodies_read)
import compiler.check.infer.checker (ReleaseSite)
import compiler.syntax.parsing (Span)
import compiler.check.typed (TypedBody, BodyPart, body_retyped)

/// What is known at a node: `ty` is its type, and `args` the type arguments it fills where it names
/// a generic definition.
pub type Typed = { ty: Type, args: List<Type> }

/// No type: what a node holds where nothing is known of it.
pub fn unknown_type() -> Type = TyVar(0 - 1)

pub fn filed_as(ty: Type, args: List<Type>) -> Typed = { ty: ty, args: args }

/// What the checker filed for one item: where its bodies let go of each resource they own, and
/// its bodies as it settled them, each place counted from where its text starts.
pub type Filings = { releases: List<ReleaseSite>, bodies: List<TypedBody<Type>> }

/// What an item with nothing filed of it reads.
pub fn no_filings() -> Filings = { releases: [], bodies: [] }

/// `facts`, one item's, as a build reads them.
pub fn filings(facts: RootFacts) -> Filings / {abort.raise} =
  { releases: facts.releases, bodies: bodies_read(facts.bodies, facts.types) }

/// The body `part` of the item `filed` is of, each place counted from the start of the program's
/// text, the item's being at `base`; none where the check settled none.
pub fn body_at(filed: Filings, part: BodyPart, base: Int) -> Option<TypedBody<Type>> / {abort.raise} =
  match filed.bodies.find(|b: TypedBody<Type>| b.part == part) {
    None -> None,
    Some(b) ->
      Some(
        body_retyped(b, (), {
          ty: |t: Type, u: Unit| { ty: t, state: u },
          row: |r: Row| r,
          atom: |a: Atom| a,
          span: |sp: Span| { ..sp, start: sp.start + base, end: sp.end + base },
        }).out,
      ),
  }
