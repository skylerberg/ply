//! What the checker filed of the items a build lowers: each body as it settled it, and where each
//! lets go of what it owns.

import compiler.check.types (Type, VariableType, Row, Atom)
import compiler.check.infer (BodyFacts, bodies_read)
import compiler.syntax.parsing (Span, moved_by)
import compiler.check.typed (TypedBody, BodyPart, body_retyped)

/// What is known at a node: `ty` is its type, and `args` the type arguments it fills where it names
/// a generic definition.
pub type SiteType = { ty: Type, args: List<Type> }

/// No type: what a node holds where nothing is known of it.
pub fn unknown_type() -> Type = VariableType(0 - 1)

pub fn site_type(ty: Type, args: List<Type>) -> SiteType = { ty: ty, args: args }

/// What the checker filed for one item: its bodies as it settled them, each place counted from where
/// its text starts.
pub type SiteAnnotations = { bodies: List<TypedBody<Type>> }

/// What an item with nothing filed of it reads.
pub fn no_annotations() -> SiteAnnotations = { bodies: [] }

/// `facts`, one item's, as a build reads them.
pub fn annotations_of(facts: BodyFacts) -> SiteAnnotations / {abort.raise} =
  { bodies: bodies_read(facts.bodies, facts.types) }

/// The body `part` of the item `filed` is of, each place counted from the start of the program's
/// text, the item's being at `base`; none where the check settled none.
pub fn body_at(
  filed: SiteAnnotations,
  part: BodyPart,
  base: Int,
) -> Option<TypedBody<Type>> / {abort.raise} =
  match filed.bodies.find(|b: TypedBody<Type>| b.part == part) {
    None -> None,
    Some(b) ->
      Some(
        body_retyped(b, (), {
          ty: |t: Type, u: Unit| { ty: t, state: u },
          row: |r: Row| r,
          atom: |a: Atom| a,
          span: |sp: Span| moved_by(sp, base),
        }).out,
      ),
  }
