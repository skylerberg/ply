//! What the checker filed at a site of a lowered body, which a value's type is read off.

import check.types (Type, TyVar)

/// What is known at a span: `ty` is the type the checker filed there, unknown where it filed none,
/// and `args` the type arguments it filled where the site names a generic definition.
pub type Typed = { ty: Type, args: List<Type> }

/// No type: what a site holds where nothing is known of it.
pub fn unknown_type() -> Type = TyVar(0 - 1)

/// What the checker filed at a site.
pub fn filed_as(ty: Type, args: List<Type>) -> Typed = { ty: ty, args: args }
