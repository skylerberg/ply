//! Effects as the emitter names them: clause rules, and the handles a body walks.

import syntax.parsing (qname_text)
import emit.code (Code, NVar, NBinary, NIf, NBlock, NList, NUnary, NField, NUpdate, NApp, NRecord,
                  NMatch, NPerform, NLambda, NSimulate, NParallel, NHandle, CodeStmt, CLet, CLetPat,
                  CDo, CodeField, CodeArm, CodeClause, slots_read, all_read)
import syntax.items (IEffect, OpDef, Item)
import check.resolve.tables (ParsedModule, Resolved, Binding, ModuleBinding, qualify)
import check.infer.checker (prelude_effects, EffectInfo, OpInfo)
import check.types (TyFn, Scheme, Atom, RNamed, is_diverges)
import std.list
import syntax.exprs (Expr, EHandle, ESimulate, EUnary, EBinary, ELambda, EApp, EIf, EMatch, EBlock,
                     ERecord, ERecordUpdate, ETry, ETryBlock, EField, EList, EPerform, EWithHold,
                     HandleClause, HandlerVar, MatchArm, RecField, Stmt, SLet, SLetElse, SExpr,
                     SAssign)
import syntax.type_syntax (Mode, MRead, MWrite, MRaise, MBad, is_raise)
import expand.rewrite (named_program_wide)
import std.bytes (ascii_of_int)
import emit.c (Kind)
import emit.reps (Ty, FieldTy, Def)
import emit.state (CValue, Emitter, EffectName, OpMode)

// --- Externs written in place -----------------------------------------------------

/// What a `parallel` block's branches may perform of one effect, by its program-wide name: on the
/// resource named, or on any.
pub type Reached = { effect: Bytes, resource: Option<Bytes> }

/// Every operation the definition being emitted may perform and does not answer, as its row has
/// it: what a block in its own body may reach of the handlers its callers installed. `None` where
/// the row does not say: a root that is no definition, a group's shared function and a row left
/// open. A row names an effect program-wide, as a frame's clause does.
pub fn owner_reach(emitter: Emitter) -> Option<List<Reached>> =
  if emitter.group.len() > 0 { None } else {
    match emitter.here.fold(None, |found: Option<Scheme>, d: Def| {
        let full = qualify(emitter.module, d.name);
        if full == emitter.owner || emitter.owner.starts_with(full.concat(b"@")) { d.scheme }
        else { found }
      }) {
      None -> None,
      Some(s) -> match s.ty {
        TyFn(f) -> match f.effects.tail {
          Some(_) -> None,
          None ->
            Some(
              // Nothing performs `diverges`: it says only that the body may not return.
              f.effects.atoms.filter(|atom: Atom| !is_diverges(atom)).map(|atom: Atom|
                {
                  effect: atom.effect,
                  resource: match atom.resource { RNamed(name) -> Some(name), _ -> None },
                }),
            ),
        },
        _ -> None,
      },
    }
  }

/// The operations a `simulate` region answers, named as the fixpoint names a handled operation.
pub fn scheduled_ops() -> List<Bytes> =
  [
    b"task#spawn",
    b"task#join",
    b"task#yield",
    b"clock#now",
    b"clock#sleep",
    b"random#next",
    b"random#below",
    b"sim#seed",
  ]

/// A field-table placeholder the unit resolves; the runtime reads effect, operation and resource names from it.
pub fn field_ref(i: Int) -> Bytes = Bytes::concat_all([b"@@f", ascii_of_int(i), b"@@"])

/// `None` for a name the module's scope does not bind.
pub fn effect_global(emitter: Emitter, written: Bytes) -> Option<Bytes> / {abort.raise} =
  match effect_named(emitter, written) { Some(e) -> Some(e.global), None -> None }

pub fn effect_named(emitter: Emitter, written: Bytes) -> Option<EffectName> / {abort.raise} =
  effect_among(emitter.effects, written)

/// A `try`'s clause names its effect program-wide, and only a raise is answered by one.
fn effect_among(effects: List<EffectName>, written: Bytes) -> Option<EffectName> / {abort.raise} =
  match named_program_wide(written) {
    Some(global) -> Some({ written: written, global: global, ops: [] }),
    None -> match effects.fold(None, |acc: Option<EffectName>, e: EffectName|
        if e.written == written { Some(e) } else { acc }) {
      Some(e) -> Some(e),
      // The prelude's effects are declared nowhere and known program-wide by their bare names.
      None ->
        prelude_effects_here().fold(None, |acc: Option<EffectName>, e: EffectName|
          if e.written == written { Some(e) } else { acc }),
    },
  }

fn prelude_effects_here() -> List<EffectName> =
  prelude_effects().map(|effect_info: EffectInfo|
    {
      written: effect_info.name,
      global: effect_info.name,
      ops: effect_info.ops.map(|op_info: OpInfo| { name: op_info.name, mode: op_info.mode }),
    })

/// An operation's declared mode: a `perform`'s recorded atom carries it.
pub fn op_mode(e: EffectName, op: Bytes) -> Mode =
  e.ops.fold(MRead, |acc: Mode, o: OpMode| if o.name == op { o.mode } else { acc })

/// As the runtime reads it.
pub fn mode_code(mode: Mode) -> Bytes =
  match mode { MRead -> b"0", MWrite -> b"1", MRaise -> b"2", MBad -> b"0" }

/// A clause for a raise is run once its `handle`'s body is abandoned, and no task inherits it.
pub fn clause_raises(emitter: Emitter, clause: CodeClause) -> Bool / {abort.raise} =
  named_program_wide(clause.effect) != None
    || (match effect_named(emitter, clause.effect) {
      Some(e) -> is_raise(op_mode(e, clause.op)),
      None -> false,
    })

/// Every effect name a module's scope binds, bare or through a module binder, with its program-wide name.
pub fn effects_in(resolved: Resolved, i: Int, mods: List<ParsedModule>) -> List<EffectName> =
  match resolved.scopes.at(i) {
    None -> [],
    Some(scope) -> {
      let bare = scope.bound.effects.map(|b: Binding|
        { written: b.name, global: b.qualified, ops: ops_of(mods, b.owner, b.name) });
      scope.modules.fold(bare, |acc: List<EffectName>, mb: ModuleBinding|
        match resolved.declared.at(mb.target) {
          None -> acc,
          Some(theirs) ->
            theirs.effects.fold(acc, |a: List<EffectName>, b: Binding|
              a.push({
                written: Bytes::concat_all([mb.binder, b"::", b.name]),
                global: b.qualified,
                ops: ops_of(mods, mb.target, b.name),
              })),
        })
    },
  }

fn ops_of(mods: List<ParsedModule>, owner: Int, name: Bytes) -> List<OpMode> =
  match mods.at(owner) {
    None -> [],
    Some(m) ->
      m.module.items.fold([], |acc: List<OpMode>, item: Item|
        match item {
          IEffect(e) -> if e.name.name == name {
            e.ops.map(|op: OpDef| { name: op.name.name, mode: op.mode })
          } else { acc },
          _ -> acc,
        }),
  }

/// A clause may call `resume` only in tail position, once per path; every read of the binder must be such a call.
pub fn resume_in_tail_only(body: Code, k: Int) -> Bool =
  slots_read(body).count(|y: Int| y == k) == tail_calls_of(body, k)

fn tail_calls_of(code: Code, k: Int) -> Int =
  match code.node {
    NApp(a) -> match a.func.node {
      NVar(v) -> if v.slot == Some(k) && a.args.len() == 1
          && all_read(a.args).count(|y: Int| y == k) == 0 { 1 }
      else { 0 },
      _ -> 0,
    },
    NIf(i) -> tail_calls_of(i.then_branch, k) + tail_calls_of(i.else_branch, k),
    NBlock(b) -> match b.tail { Some(t) -> tail_calls_of(t, k), None -> 0 },
    NMatch(m) -> m.arms.fold(0, |acc: Int, a: CodeArm| acc + tail_calls_of(a.body, k)),
    _ -> 0,
  }

/// What an update gathers its new record of: each field's word, kind and value, and whether every
/// value is known, which holds the record back.
pub type Filled = {
  emitter: Emitter,
  ws: List<Bytes>,
  kinds: List<Kind>,
  vals: List<CValue>,
  known: Bool,
}

/// An update to the fields `names`: `copies` read from `base`, of type `base_ty`, and `sets` written,
/// their values `vals`, words the record takes as they are where `owned`; laid out as `laid` where
/// the new record's layout is known.
pub type UpdateOf = {
  copies: List<Bytes>,
  sets: List<CodeField>,
  names: List<Bytes>,
  laid: Option<List<FieldTy>>,
  base: CValue,
  base_ty: Ty,
  vals: List<CValue>,
  owned: Bool,
}

// --- the emitter's entry ----------------------------------------------------

fn concat_effects(a: List<EffectName>, b: List<EffectName>) -> List<EffectName> =
  b.fold(a, |acc: List<EffectName>, x: EffectName| acc.push(x))

/// The effect a clause names, program-wide: one a `try` wrote, the scope's, or the prelude's.
fn handled_effect(effects: List<EffectName>, written: Bytes) -> Option<Bytes> / {abort.raise} =
  match named_program_wide(written) {
    Some(global) -> Some(global),
    None ->
      concat_effects(effects, prelude_effects_here()).fold(
        None,
        |f: Option<Bytes>, en: EffectName| if en.written == written { Some(en.global) } else { f },
      ),
  }

/// The operations a body handles, read off its source, so a body the lowering did not reach still names them.
pub fn ast_handles(e: Expr, effects: List<EffectName>) -> List<Bytes> / {abort.raise} = {
  let here = |acc: List<Bytes>, x: Expr| acc.concat(ast_handles(x, effects));
  let all = |exprs: List<Expr>| exprs.fold([], here);
  match e {
    EHandle(h) -> {
      let inits = h.vars.fold([], |acc: List<Bytes>, v: HandlerVar| here(acc, v.init));
      let inner = h.clauses.fold(here(inits, h.body), |acc: List<Bytes>, clause: HandleClause|
        List::concat(
          match handled_effect(effects, qname_text(clause.eff)) {
            Some(g) -> acc.push(Bytes::concat_all([g, b"#", clause.op.name])),
            None -> acc,
          },
          ast_handles(clause.body, effects),
        ));
      match h.ret { Some(r) -> here(inner, r.body), None -> inner }
    },
    ESimulate(x) -> scheduled_ops().concat(ast_handles(x.body, effects)),
    EUnary(x) -> ast_handles(x.operand, effects),
    EBinary(x) -> all([x.lhs, x.rhs]),
    ELambda(x) -> ast_handles(x.body, effects),
    EApp(x) -> here(all(x.args), x.func),
    EIf(x) -> all([x.cond, x.then_branch, x.else_branch]),
    EMatch(x) ->
      x.arms.fold(ast_handles(x.scrutinee, effects), |acc: List<Bytes>, arm: MatchArm|
        here(match arm.guard { Some(g) -> here(acc, g), None -> acc }, arm.body)),
    EBlock(x) -> {
      let stmts = x.stmts.fold([], |acc: List<Bytes>, stmt: Stmt|
        match stmt {
          SLet(l) -> here(acc, l.value),
          SLetElse(l) -> here(here(acc, l.value), l.fallback),
          SExpr(v) -> here(acc, v),
          SAssign(v) -> here(acc, v.value),
        });
      match x.tail { Some(t) -> here(stmts, t), None -> stmts }
    },
    ERecord(x) -> all(x.fields.map(|f: RecField| f.value)),
    ERecordUpdate(x) -> here(all(x.fields.map(|f: RecField| f.value)), x.base),
    ETry(x) -> ast_handles(x.operand, effects),
    EField(x) -> ast_handles(x.base, effects),
    EList(x) -> all(x.items),
    EPerform(x) -> all(x.args),
    EWithHold(x) -> all([x.acquire, x.release, x.body]),
    ETryBlock(x) -> ast_handles(x.body, effects),
    _ -> [],
  }
}

pub fn walk_handles(c: Code, effects: List<EffectName>) -> List<Bytes> / {abort.raise} = {
  let here = |acc: List<Bytes>, x: Code| acc.concat(walk_handles(x, effects));
  match c.node {
    NHandle(h) ->
      h.clauses.fold(walk_handles(h.body, effects), |acc: List<Bytes>, clause: CodeClause|
        List::concat(
          match handled_effect(effects, clause.effect) {
            Some(g) -> acc.push(Bytes::concat_all([g, b"#", clause.op])),
            None -> acc,
          },
          walk_handles(clause.body, effects),
        )),
    NUnary(u) -> walk_handles(u.operand, effects),
    NBinary(b) -> here(walk_handles(b.lhs, effects), b.rhs),
    NField(f) -> walk_handles(f.base, effects),
    NApp(a) -> a.args.fold(walk_handles(a.func, effects), here),
    NIf(i) -> here(here(walk_handles(i.cond, effects), i.then_branch), i.else_branch),
    NBlock(b) -> {
      let stmts = b.stmts.fold([], |acc: List<Bytes>, stmt: CodeStmt|
        match stmt {
          CLet(l) -> here(acc, l.value),
          CLetPat(l) -> here(acc, l.value),
          CDo(d) -> here(acc, d.code),
        });
      match b.tail { Some(t) -> here(stmts, t), None -> stmts }
    },
    NList(l) -> l.items.fold([], here),
    NRecord(r) -> r.fields.fold([], |acc: List<Bytes>, f: CodeField| here(acc, f.value)),
    NUpdate(u) ->
      u.sets.fold(walk_handles(u.base, effects), |acc: List<Bytes>, f: CodeField|
        here(acc, f.value)),
    NMatch(m) ->
      m.arms.fold(walk_handles(m.scrutinee, effects), |acc: List<Bytes>, a: CodeArm|
        here(match a.guard { Some(g) -> here(acc, g), None -> acc }, a.body)),
    NPerform(p) -> p.args.fold([], here),
    NLambda(l) -> walk_handles(l.body, effects),
    NSimulate(x) -> scheduled_ops().concat(walk_handles(x.body, effects)),
    NParallel(pr) -> pr.branches.fold([], here),
    _ -> [],
  }
}
