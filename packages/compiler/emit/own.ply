import compiler.emit.lower.representation (leaf_type)
import compiler.emit.lower.base (unread_packs_dropped)
import compiler.emit.release (boxed_case_of)
import compiler.emit.typing (unknown_type)
import compiler.syntax.parsing (dummy_span)
import compiler.emit.keys (Named, Root)
import compiler.emit.typed_ir.containers (Retain)
import compiler.emit.typed_ir.handling (empty_instance)
import compiler.emit.representations (RecordShape, kind_of)
import compiler.emit.typed_ir (param_lent, handed_of, lent_where, no_closure_evidence,
                               Representation, AsWord, AsInt, AsBool, AsFloat, AsFlattened,
                               AsReuseToken, AsSum, CaseAllocation, Var, Arg, VarOperand,
                               IntOperand, BoolOperand, FloatOperand, ZeroOperand, Rvalue,
                               Primitive, Allocate, Get, Take, Convert, Call, Apply, Native,
                               Aggregate, Update, FieldWrite, Path, FieldPath, ArgumentPath,
                               LeafPath, CasePath, Allocation, ListAllocation, ClosureAllocation,
                               LengthTest, Inst, Let, Do, Decl, Assign, If, Case, Match, Miss, Loop,
                               Next, Done, Return, Restart, Jump, Fail, NoMatchingArm, Handle,
                               SiteScope, Inc, Dec, Reset, Free, Destructure, Block, Fn, Member,
                               Convention, Metered, Lambda, Closure, ParamOwnership, OwnedParam,
                               BorrowedParam, Carried, carried_vars, carried_inits, OwnedResult,
                               BorrowedResult, ResultOwnership, Test, TagTest, Owns, BorrowSources,
                               Immortal, Static, Op, OfStrings, AsAddress, PayloadPath, no_links,
                               is_refcounted, operands, fails, by_signature, operand_var,
                               operand_representation, parts_of, is_terminator, string_signature,
                               StackAllocation, OfContainers, WalkLoop, Unspecialised, IfUnique,
                               InlineRecordPath, is_record_word, read_records, RecordAllocation,
                               FieldInitializer, FromArgument, BuiltInPlace, CleanupScope,
                               Unwinding)
import compiler.emit.typed_ir.strings (ByteRead)
import compiler.emit.verify (ownership_fault, stack_captures, payload_of, takeable,
                             is_inline_record, reuses_cells, allocation_words, count_shared_with,
                             may_leave, result_ownership, is_counted_word, immortals, points_into)

/// How a counted variable is held: a count of its own, or read without one out of the owned
/// variables `bases` names, each live while it is (none where nothing the body lets go of holds
/// it: a constant, a lent parameter).
type Ownership = | OwnsCount | BorrowsFrom(List<Int>)

/// What the pass knows of a root's variables before it places counts: how each counted one is
/// held, each variable by number, what each `Get` read out of and where, what each variable read
/// out of another was read out of directly, which hold a count made where they are bound (a `Let`
/// of an owned answer, a given parameter, a loop's state), and the first free number. A flat value made or handed
/// in so is `opened` into words where it is bound, each part a variable counted on its own, and a
/// `Get` of one of its counted leaves is an `alias` of that word, as a payload read out of a sum
/// held as one word is of that sum. A block laid in the frame
/// `stacks` what it borrows (a closure's captures, a list's items): it holds no count of them, so a
/// use of it reads each. A `promoted`
/// value read out of another takes a count of its own where it is bound. The `immortal` values hold
/// no count at all (`verify.immortals`, the set the check reads): none is taken or let go of them.
type Facts = {
  held: Map<Int, Ownership>,
  vars: Map<Int, Var>,
  gets: Map<Int, { of: Int, path: Path }>,
  direct: Map<Int, List<Int>>,
  made: Map<Int, Bool>,
  next: Int,
  opened: Map<Int, List<Var>>,
  alias: Map<Int, Var>,
  stacks: Map<Int, List<Var>>,
  promoted: Map<Int, Bool>,
  immortal: Map<Int, Bool>,
}

/// The counted variables live at a point, by number: each is read, consumed or let go of on some
/// path from there.
type Live = Map<Int, Var>

/// Where control leaves a block other than by its end, and what is live there: a loop's `Next`
/// and `Done` (what the loop holds across its passes), a match arm's `Miss` (the next arm's entry),
/// and a `Fail` (what an enclosing `handle` holds across its body, which a failure inside the body
/// leaves to the handle's landing). `known` is the constructor each variable a case arm tested
/// holds there. `restart` is how the body's own parameters are handed, which a `Restart` hands them
/// again, `enters` how each member of its tail group takes its own, and `answered` how the body
/// hands back its answer: one it borrows is only read.
type Exits = {
  looped: Option<Live>,
  miss: Live,
  landing: Live,
  known: Map<Int, Bytes>,
  restart: List<ParamOwnership>,
  enters: List<List<ParamOwnership>>,
  answered: ResultOwnership,
}

/// A `Allocate` the cells of a box let go of above it could go to: its place in the block it is in,
/// counted from that block's end; the branches on the way to that block, each by its place, so
/// counted, and the arm taken; and what it makes.
type ReuseCandidate = { at: Int, route: List<{ at: Int, arm: Int }>, made: Allocation }

/// A block walked from its end back to a point: its instructions after the point, last first;
/// what is live at the point; the first free variable number; and the `Allocate`s reached from the
/// point, on its straight line or in the arms of the branch that ends it.
type BackwardState = { rev: List<Inst>, live: Live, next: Int, takers: List<ReuseCandidate> }

/// What one instruction's operands need: the `Inc`s before it, the owned values that die before
/// it and after it, and what is live before it.
type Plan = {
  incs: List<Inst>,
  keeps: List<{ of: Var, n: Int }>,
  before: List<Var>,
  after: List<Var>,
  live: Live,
}

type Operand = { arg: Arg, takes: Bool }

/// `f` and the closures it makes with every count placed. The form handed in holds none. A tail
/// group's arm `i` is counted as a body of its own holding member `i`'s parameters.
pub fn insert_reference_counts(given: Fn) -> Fn = {
  let f = insert_takes(built_in_place({ ..given, body: unread_packs_dropped(given.body) }));
  let facts = facts_of(f);
  let top = {
    looped: None,
    miss: Map::new(),
    landing: Map::new(),
    known: Map::new(),
    restart: handed_of(f.convention),
    enters: f.members.map(|m: Member| handed_of(m.convention)),
    answered: f.convention.answered,
  };
  let counted = if f.members.len() == 0 {
    counted_block(facts, top, f.params, f.body, Map::new(), facts.next)
  } else {
    match f.body {
      [Case(c)] -> {
        let arms = c.arms.fold(
          { arms: [], next: facts.next },
          |s: { arms: List<{ when: Int, body: Block }>, next: Int }, a: { when: Int, body: Block }| {
            let member = f.members.at(a.when);
            let h = counted_block(
              facts,
              match member {
                Some(m) ->
                  { ..top, restart: handed_of(m.convention), answered: m.convention.answered },
                None -> { ..top, restart: [] },
              },
              match member { Some(m) -> m.params, None -> [] },
              a.body,
              Map::new(),
              s.next,
            );
            { arms: s.arms.push({ when: a.when, body: h.block }), next: h.next }
          },
        );
        let rest = counted_block(facts, top, [], c.rest, Map::new(), arms.next);
        { block: [Case({ ..c, arms: arms.arms, rest: rest.block })], next: rest.next }
      },
      _ -> counted_block(facts, top, f.params, f.body, Map::new(), facts.next),
    }
  };
  {
    ..f,
    body: counted.block,
    lambdas: f.lambdas.map(|l: Lambda|
      match l { Closure(c) -> Closure({ ..c, body: insert_reference_counts(c.body) }) }),
  }
}

/// A keep of `v`: a place copied out into a box of its own, a box counted once more.
fn retain(v: Var) -> Rvalue =
  Op({
    op: OfContainers(Retain),
    args: [VarOperand(v)],
    uses: { takes: [false], owned: true, fails: false, suspends: false },
  })

fn increments(v: Var, n: Int) -> List<Inst> = if n > 0 { [Inc({ var: v, n: n })] } else { [] }

/// `i` with each operand it names that `renames` maps read as what it maps it to, the blocks it
/// holds as they are.
fn renamed(i: Inst, renames: Map<Int, Var>) -> Inst =
  if renames.len() == 0 { i } else {
    let arg = |a: Arg|
      match a {
        VarOperand(v) -> match renames.get(v.id) { Some(k) -> VarOperand(k), None -> a },
        _ -> a,
      };
    let var = |v: Var| match renames.get(v.id) { Some(k) -> k, None -> v };
    match i {
      Let(l) -> Let({ ..l, val: val_renamed(l.val, arg, var) }),
      Do(d) -> Do({ ..d, val: val_renamed(d.val, arg, var) }),
      Assign(x) -> Assign({ ..x, arg: arg(x.arg) }),
      Loop(l) -> Loop({ ..l, state: l.state.map(|c: Carried| { var: c.var, init: arg(c.init) }) }),
      Next(args) -> Next(args.map(arg)),
      Done(a) -> Done(arg(a)),
      Return(a) -> Return(arg(a)),
      Restart(args) -> Restart(args.map(arg)),
      Jump(e) -> Jump({ ..e, args: e.args.map(arg) }),
      Handle(h) -> Handle({ ..h, args: h.args.map(arg) }),
      _ -> i,
    }
  }

fn val_renamed(v: Rvalue, arg: (Arg) -> Arg, var: (Var) -> Var) -> Rvalue =
  match v {
    Primitive(p) -> Primitive({ ..p, args: p.args.map(arg) }),
    Allocate(m) -> Allocate({ ..m, args: m.args.map(arg) }),
    Get(g) -> Get({ ..g, of: var(g.of) }),
    Take(t) -> Take({ ..t, of: var(t.of) }),
    Convert(p) -> Convert({ ..p, arg: arg(p.arg) }),
    Aggregate(g) -> Aggregate({ parts: g.parts.map(arg) }),
    Update(u) ->
      Update({ of: var(u.of), sets: u.sets.map(|s: FieldWrite| { ..s, arg: arg(s.arg) }) }),
    Call(c) -> Call({ ..c, args: c.args.map(arg) }),
    Apply(c) -> Apply({ ..c, f: arg(c.f), args: c.args.map(arg) }),
    Native(n) -> Native({ ..n, args: n.args.map(arg) }),
    Op(o) -> Op({ ..o, args: o.args.map(arg) }),
    IfUnique(x) -> IfUnique(var(x)),
    WalkLoop(w) -> WalkLoop({ ..w, of: var(w.of) }),
    Unspecialised(ops) ->
      Unspecialised(ops.map(|o: { arg: Arg, takes: Bool }| { ..o, arg: arg(o.arg) })),
    _ -> v,
  }

/// Body `b` with every count placed, `across` held through it and its `params` held at its head:
/// each flat one opened, each owned one nothing reads let go of there.
fn counted_block(
  facts: Facts,
  top: Exits,
  params: List<Var>,
  b: Block,
  across: Live,
  next: Int,
) -> { block: Block, next: Int } = {
  let back = walked_back(facts, top, b, across, next);
  let held = params.fold(across, |m: Live, p: Var|
    resolved(facts, p).fold(m, |n: Live, w: Var|
      if owns(facts, w) { n.insert(w.id, w) } else { n }));
  let opens = params.fold([], |acc: List<Inst>, p: Var|
    match facts.opened.get(p.id) {
      Some(ws) -> acc.push(Destructure({ of: p, words: ws })),
      None -> acc,
    });
  let e = entered(facts, top, back, held);
  { block: opens.concat(e.block), next: e.next }
}

/// What `insert_takes` reads off a body: each `Get` and the loop pass it runs in (`-1` outside any loop), the
/// variables used other than to read a field, test a constructor or be updated, those an operation
/// consumes, those holding a count made where they are bound, with the pass that binds them, how
/// often each block's field is read on the way through the body that reads it most, the reads of
/// each block on the way to where the walk stands, and the reads an update after them on their way
/// makes a record without writing their field.
type FieldReadScan = {
  gets: List<{ var: Var, of: Var, path: Path, pass: Int }>,
  whole: Map<Int, Bool>,
  handed: Map<Int, Bool>,
  bound: Map<Int, Int>,
  reads: Map<Int, Map<Path, Int>>,
  passed: Map<Int, List<{ id: Int, path: Path }>>,
  unwritten: Map<Int, Bool>,
}

/// `f` with each wide record made only to be laid in place in another made after it in the same
/// block built there instead: its `Allocate` gone, and the other's field `BuiltInPlace` of its arguments, so
/// no box of it is made.
fn built_in_place(f: Fn) -> Fn = {
  let uses = uses_in(f.body, Map::new());
  { ..f, body: built_into(f.body, uses) }
}

/// How many times `b` and the blocks it holds name each variable as an operand or an argument.
fn uses_in(b: Block, m: Map<Int, Int>) -> Map<Int, Int> = {
  let named = |acc: Map<Int, Int>, args: List<Arg>|
    args.fold(acc, |n: Map<Int, Int>, a: Arg|
      match operand_var(a) {
        Some(v) -> n.insert(v.id, match n.get(v.id) { Some(k) -> k + 1, None -> 1 }),
        None -> n,
      });
  let operated = |acc: Map<Int, Int>, v: Rvalue|
    named(acc, operands(v).map(|o: { arg: Arg, takes: Bool }| o.arg));
  b.fold(m, |acc: Map<Int, Int>, i: Inst|
    match i {
      Let(l) -> operated(acc, l.val),
      Do(d) -> operated(acc, d.val),
      Assign(x) -> named(acc, [x.arg]),
      If(x) -> uses_in(x.otherwise, uses_in(x.then, named(acc, [x.cond]))),
      Case(c) ->
        c.arms.fold(
          uses_in(c.rest, named(acc, [VarOperand(c.on)])),
          |n: Map<Int, Int>, a: { when: Int, body: Block }| uses_in(a.body, n),
        ),
      Match(x) -> x.arms.fold(uses_in(x.rest, acc), |n: Map<Int, Int>, a: Block| uses_in(a, n)),
      Loop(l) -> uses_in(l.body, named(acc, carried_inits(l.state))),
      Next(args) -> named(acc, args),
      Done(a) -> named(acc, [a]),
      Return(a) -> named(acc, [a]),
      Restart(args) -> named(acc, args),
      Jump(e) -> named(acc, e.args),
      Handle(h) -> uses_in(h.body, named(acc, h.args)),
      // A failure path lets go of what it names, so a record it names is no record made only to be
      // laid in another.
      CleanupScope(Some(xs)) -> named(acc, xs.map(|x: Unwinding| x.arg)),
      Fail(x) -> named(acc, x.letting.map(|u: Unwinding| u.arg)),
      _ -> acc,
    })
}

/// A wide record made earlier in a block and named once, as `built_into` may lay it in place.
type Pending = { shape: List<FieldInitializer>, args: List<Arg> }

/// A record read in place once, as the base of an update: the box it lies in at last, the word of
/// its header there, and the reads on the way to it.
type InPlaceRead = { root: Var, at: Int, reads: List<Int> }

/// An update named once of a record read in place once: the box it lies in and its header's word,
/// each write at its word in that box, and the instructions it leaves behind once folded in.
type NestedUpdate = { root: Var, at: Int, sets: List<FieldWrite>, gone: List<Int> }

/// What `built_into` knows walking a block: what it has written, the records it may yet build in
/// place, the reads in place and updates of them it may yet fold, and the instructions folded away.
type BuildState = {
  out: Block,
  pending: Map<Int, Pending>,
  spots: Map<Int, InPlaceRead>,
  nested: Map<Int, NestedUpdate>,
  gone: Map<Int, Bool>,
}

/// `b` with each record `Allocate` that `uses` names once, as a field in place of a record `Allocate`
/// after it in `b`, built in that one's place; each update named once of a record read in place
/// once, the field it makes written by an update of the box the record lies in, folded into that
/// update as its own writes at their words; and the blocks `b` holds alike.
fn built_into(b: Block, uses: Map<Int, Int>) -> Block = {
  let once = |id: Int| uses.get(id) == Some(1);
  let walked = b.fold(
    { out: [], pending: Map::new(), spots: Map::new(), nested: Map::new(), gone: Map::new() },
    |s: BuildState, i: Inst|
      match i {
        Let(l) -> match l.val {
          Get(g) -> match g.path {
            InlineRecordPath(o) -> if !once(l.var.id) { { ..s, out: s.out.push(i) } } else {
              let spot = match s.spots.get(g.of.id) {
                Some(q) -> { root: q.root, at: q.at + 1 + o, reads: q.reads.push(l.var.id) },
                None -> { root: g.of, at: o, reads: [l.var.id] },
              };
              { ..s, out: s.out.push(i), spots: s.spots.insert(l.var.id, spot) }
            },
            _ -> { ..s, out: s.out.push(i) },
          },
          Update(u) -> {
            let folded = updates_folded(s, u.of, u.sets);
            let made = Let({ ..l, val: Update({ of: u.of, sets: folded.sets }) });
            let base = match s.spots.get(u.of.id) { Some(q) -> Some(q), None -> None };
            {
              ..s,
              out: s.out.push(made),
              nested: match base {
                Some(q) -> if once(l.var.id) {
                  s.nested.insert(l.var.id, {
                    root: q.root,
                    at: q.at,
                    sets: folded.sets.map(|x: FieldWrite| { ..x, at: q.at + 1 + x.at }),
                    gone: q.reads.push(l.var.id),
                  })
                } else { s.nested },
                None -> s.nested,
              },
              gone: folded.gone.fold(s.gone, |g: Map<Int, Bool>, id: Int| g.insert(id, true)),
            }
          },
          Allocate(m) -> match m.made {
            RecordAllocation(shape) -> {
              let spliced = spliced_in(shape, m.args, 0, s.pending);
              let made = Let({
                ..l,
                val: Allocate({ ..m, made: RecordAllocation(spliced.shape), args: spliced.args }),
              });
              {
                ..s,
                out: s.out.push(made),
                pending: if uses.get(l.var.id) == Some(1) {
                  s.pending.insert(l.var.id, { shape: spliced.shape, args: spliced.args })
                } else { s.pending },
                gone: spliced.used.fold(s.gone, |g: Map<Int, Bool>, id: Int| g.insert(id, true)),
              }
            },
            _ -> { ..s, out: s.out.push(i) },
          },
          _ -> { ..s, out: s.out.push(i) },
        },
        _ -> { ..s, out: s.out.push(nested_built(i, uses)) },
      },
  );
  walked.out.filter(|i: Inst| match i { Let(l) -> !walked.gone.contains(l.var.id), _ -> true })
}

/// `sets`, the writes of an update of `of`, with each that writes the record a pending update of
/// the same record makes replaced by that update's own writes, at their words in `of`; and the
/// instructions so folded away.
fn updates_folded(
  s: BuildState,
  of: Var,
  sets: List<FieldWrite>,
) -> { sets: List<FieldWrite>, gone: List<Int> } = {
  // The word in the root box where `of`'s words start, and that root.
  let start = match s.spots.get(of.id) { Some(q) -> q.at + 1, None -> 0 };
  let root = match s.spots.get(of.id) { Some(q) -> q.root.id, None -> of.id };
  sets.fold(
    { sets: [], gone: [] },
    |acc: { sets: List<FieldWrite>, gone: List<Int> }, x: FieldWrite|
      match operand_var(x.arg) {
        Some(v) -> match s.nested.get(v.id) {
          Some(n) -> if n.root.id == root && n.at == start + x.at {
            {
              sets: acc.sets.concat(n.sets.map(|y: FieldWrite| { ..y, at: y.at - start })),
              gone: acc.gone.concat(n.gone),
            }
          } else { { ..acc, sets: acc.sets.push(x) } },
          None -> { ..acc, sets: acc.sets.push(x) },
        },
        None -> { ..acc, sets: acc.sets.push(x) },
      },
  )
}

/// `shape` and `args` from argument `at` on with each field `FromArgument` by a record `pending`
/// holds `BuiltInPlace` of its arguments instead; and the records so built.
fn spliced_in(
  shape: List<FieldInitializer>,
  args: List<Arg>,
  at: Int,
  pending: Map<Int, Pending>,
) -> { shape: List<FieldInitializer>, args: List<Arg>, used: List<Int> } = {
  let s = shape.fold(
    { shape: [], args: [], used: [], at: at },
    |s: { shape: List<FieldInitializer>, args: List<Arg>, used: List<Int>, at: Int }, field: FieldInitializer|
      match field {
        BuiltInPlace(inner) -> {
          let n = supplied(inner);
          {
            ..s,
            shape: s.shape.push(field),
            args: s.args.concat(args.drop(s.at).take(n)),
            at: s.at + n,
          }
        },
        FromArgument -> match args.at(s.at) {
          Some(VarOperand(v)) -> match pending.get(v.id) {
            Some(p) ->
              {
                shape: s.shape.push(BuiltInPlace(p.shape)),
                args: s.args.concat(p.args),
                used: s.used.push(v.id),
                at: s.at + 1,
              },
            None ->
              { ..s, shape: s.shape.push(field), args: s.args.push(VarOperand(v)), at: s.at + 1 },
          },
          Some(a) -> { ..s, shape: s.shape.push(field), args: s.args.push(a), at: s.at + 1 },
          None -> { ..s, shape: s.shape.push(field), at: s.at + 1 },
        },
      },
  );
  { shape: s.shape, args: s.args, used: s.used }
}

/// How many arguments a record made as `shape` takes.
fn supplied(shape: List<FieldInitializer>) -> Int =
  shape.fold(0, |n: Int, f: FieldInitializer|
    match f { FromArgument -> n + 1, BuiltInPlace(inner) -> n + supplied(inner) })

/// `i` with the blocks it holds walked by `built_into`.
fn nested_built(i: Inst, uses: Map<Int, Int>) -> Inst =
  match i {
    If(x) -> If({ ..x, then: built_into(x.then, uses), otherwise: built_into(x.otherwise, uses) }),
    Case(c) ->
      Case({
        ..c,
        arms: c.arms.map(|a: { when: Int, body: Block }|
          { when: a.when, body: built_into(a.body, uses) }),
        rest: built_into(c.rest, uses),
      }),
    Match(x) ->
      Match({ arms: x.arms.map(|a: Block| built_into(a, uses)), rest: built_into(x.rest, uses) }),
    Loop(l) -> Loop({ ..l, body: built_into(l.body, uses) }),
    Handle(h) -> Handle({ ..h, body: built_into(h.body, uses) }),
    _ -> i,
  }

/// `f` with a `Take` for each `Get` that is the one read, on any way through the body, of a counted
/// one-word field, not a record held in place, out of a block this body holds a count of as a word,
/// the box a sum's case holds or the words of a sum held as them (`verify.takeable`), where the field
/// is handed on: where the block is held only here, the field's count moves to its reader instead of
/// being taken again. The block must be used otherwise
/// only to read its other fields, test its constructor or be updated, past the read, with a new value
/// of that field, in the pass that bound it, so nothing reads the field after it is taken. Whether
/// the body holds the block's count is what `facts_of` says, as the counts are placed: a join set
/// only from borrowed reads holds none.
fn insert_takes(f: Fn) -> Fn = {
  let start = f.members.fold(
    given_bound(f.params, f.convention, Map::new()),
    |m: Map<Int, Int>, x: Member| given_bound(x.params, x.convention, m),
  );
  let s = scan_field_reads(
    {
      gets: [],
      whole: Map::new(),
      handed: Map::new(),
      bound: start,
      reads: Map::new(),
      passed: Map::new(),
      unwritten: Map::new(),
    },
    f.body,
    0 - 1,
  );
  let taking = s.gets.fold(
    Map::new(),
    |m: Map<Int, Var>, g: { var: Var, of: Var, path: Path, pass: Int }|
      if s.bound.get(g.of.id) == Some(g.pass) && takeable(g.of.representation, g.path)
          && payload_of(Get({ of: g.of, path: g.path }), g.var) == None
          && is_counted_word(g.var.representation)
          && !is_inline_record(g.of, g.path, g.var)
          && !s.whole.contains(g.of.id)
          && !s.unwritten.contains(g.var.id)
          && s.handed.contains(g.var.id)
          && (match s.reads.get(g.of.id) { Some(ps) -> ps.get(g.path), None -> None }) == Some(1) {
        m.insert(g.var.id, g.of)
      } else { m },
  );
  if taking.len() == 0 { f } else {
    let facts = facts_of(f);
    let held = taking.fold(Map::new(), |m: Map<Int, Bool>, id: Int, of: Var|
      if owns(facts, of) { m.insert(id, true) } else { m });
    if held.len() == 0 { f } else { { ..f, body: with_takes(f.body, held) } }
  }
}

/// `s` past update `u`: each read of `u.of` on the way here whose field `u` does not write is one
/// a take would leave a hole in the record `u` makes.
fn updated_past(s: FieldReadScan, u: { of: Var, sets: List<FieldWrite> }) -> FieldReadScan =
  match s.passed.get(u.of.id) {
    None -> s,
    Some(rs) ->
      {
        ..s,
        unwritten: rs.fold(s.unwritten, |m: Map<Int, Bool>, r: { id: Int, path: Path }|
          match r.path {
            FieldPath(p) -> if u.sets.any(|x: FieldWrite| x.at == p.at) { m }
            else { m.insert(r.id, true) },
            InlineRecordPath(at) -> if u.sets.any(|x: FieldWrite| x.at == at) { m }
            else { m.insert(r.id, true) },
            _ -> m.insert(r.id, true),
          }),
      },
  }

/// The reads on the way to after a branch: those on the way through `a` and those through `b`, both
/// walked from one start.
fn passed_joined(
  a: Map<Int, List<{ id: Int, path: Path }>>,
  b: Map<Int, List<{ id: Int, path: Path }>>,
) -> Map<Int, List<{ id: Int, path: Path }>> =
  b.fold(
    a,
    |m: Map<Int, List<{ id: Int, path: Path }>>, of: Int, rs: List<{ id: Int, path: Path }>| {
      let into = match m.get(of) { Some(x) -> x, None -> [] };
      m.insert(
        of,
        rs.fold(into, |acc: List<{ id: Int, path: Path }>, r: { id: Int, path: Path }|
          if acc.any(|x: { id: Int, path: Path }| x.id == r.id) { acc } else { acc.push(r) }),
      )
    },
  )

fn given_bound(params: List<Var>, conv: Convention, m: Map<Int, Int>) -> Map<Int, Int> =
  range(0, params.len()).fold(m, |acc: Map<Int, Int>, i: Int|
    match params.at(i) {
      Some(p) -> if param_lent(conv, i) { acc } else { acc.insert(p.id, 0 - 1) },
      None -> acc,
    })

/// `r` counting one more read of block `of`'s field at `path`.
fn read_once_more(r: Map<Int, Map<Path, Int>>, of: Int, path: Path) -> Map<Int, Map<Path, Int>> = {
  let ps = match r.get(of) { Some(x) -> x, None -> Map::new() };
  r.insert(of, ps.insert(path, match ps.get(path) { Some(n) -> n + 1, None -> 1 }))
}

/// The reads of `a` and of `b`, field by field: those of one run after the other where `summed`, and
/// otherwise those of whichever reads it more. The smaller is walked into the larger, so reads nested
/// in branches are joined in time near their number.
fn reads_joined(
  a: Map<Int, Map<Path, Int>>,
  b: Map<Int, Map<Path, Int>>,
  summed: Bool,
) -> Map<Int, Map<Path, Int>> = {
  let a_smaller = a.len() < b.len();
  let small = if a_smaller { a } else { b };
  small.fold(
    if a_smaller { b } else { a },
    |m: Map<Int, Map<Path, Int>>, of: Int, ps: Map<Path, Int>| {
      let into = match m.get(of) { Some(x) -> x, None -> Map::new() };
      m.insert(
        of,
        ps.fold(into, |q: Map<Path, Int>, p: Path, n: Int|
          q.insert(p, match q.get(p) {
            Some(k) -> if summed { k + n } else if k > n { k } else { n },
            None -> n,
          })),
      )
    },
  )
}

/// `s` with what `b`, run in loop pass `pass`, reads, consumes and binds. The arms of an `If` or a
/// `Case` run one at a time, so a field read once in each is read once; a `Match`'s arm may miss to
/// the next after its reads.
fn scan_field_reads(s: FieldReadScan, b: Block, pass: Int) -> FieldReadScan =
  b.fold(s, |acc: FieldReadScan, i: Inst|
    match i {
      Let(l) -> {
        let read = match l.val {
          Get(g) ->
            {
              ..acc,
              gets: acc.gets.push({ var: l.var, of: g.of, path: g.path, pass: pass }),
              reads: read_once_more(acc.reads, g.of.id, g.path),
              passed: acc.passed.insert(
                g.of.id,
                (match acc.passed.get(g.of.id) { Some(rs) -> rs, None -> [] }).push({
                  id: l.var.id,
                  path: g.path,
                }),
              ),
            },
          // An update hands its record on, the fields it does not write read where they lie.
          Update(u) -> {
            let sets = used_in(acc, read_records(u.sets.map(|x: FieldWrite| x.arg)));
            updated_past({ ..sets, handed: sets.handed.insert(u.of.id, true) }, u)
          },
          _ -> used_in(acc, operands(l.val)),
        };
        if result_ownership(l.val) == Owns && stack_captures(l.val) == None {
          { ..read, bound: read.bound.insert(l.var.id, pass) }
        } else { read }
      },
      Do(d) -> used_in(acc, operands(d.val)),
      Decl(v) -> { ..acc, bound: acc.bound.insert(v.id, pass) },
      Assign(x) -> handed_in(acc, [x.arg]),
      If(x) -> {
        let c = used_in(acc, [{ arg: x.cond, takes: false }]);
        let t = scan_field_reads({ ..c, reads: Map::new() }, x.then, pass);
        let o = scan_field_reads({ ..t, reads: Map::new(), passed: c.passed }, x.otherwise, pass);
        {
          ..o,
          reads: reads_joined(c.reads, reads_joined(t.reads, o.reads, false), true),
          passed: passed_joined(t.passed, o.passed),
        }
      },
      Case(c) -> {
        let rest = scan_field_reads({ ..acc, reads: Map::new() }, c.rest, pass);
        let arms = c.arms.fold(rest, |a: FieldReadScan, arm: { when: Int, body: Block }| {
          let s = scan_field_reads({ ..a, reads: Map::new(), passed: acc.passed }, arm.body, pass);
          {
            ..s,
            reads: reads_joined(a.reads, s.reads, false),
            passed: passed_joined(a.passed, s.passed),
          }
        });
        { ..arms, reads: reads_joined(acc.reads, arms.reads, true) }
      },
      // Each arm may miss to the next, and `rest` runs when every one has.
      Match(m) ->
        scan_field_reads(
          m.arms.fold(acc, |a: FieldReadScan, arm: Block| scan_field_reads(a, arm, pass)),
          m.rest,
          pass,
        ),
      Loop(l) -> {
        let looped = carried_vars(l.state).fold(
          handed_in(acc, l.state.map(|c: Carried| c.init)),
          |a: FieldReadScan, v: Var| { ..a, bound: a.bound.insert(v.id, l.result.id) },
        );
        let after = scan_field_reads(looped, l.body, l.result.id);
        { ..after, bound: after.bound.insert(l.result.id, pass) }
      },
      Next(args) -> handed_in(acc, args),
      Done(a) -> handed_in(acc, [a]),
      Return(a) -> handed_in(acc, [a]),
      Restart(args) -> handed_in(acc, args),
      Jump(e) -> handed_in(acc, e.args),
      Handle(h) ->
        scan_field_reads(used_in(acc, by_signature(h.args, h.uses)), h.body, h.result.id),
      // A failure's release reads each value it names whole, so no field of one is taken.
      CleanupScope(Some(xs)) -> used_in(acc, xs.map(|u: Unwinding| { arg: u.arg, takes: false })),
      Fail(x) -> used_in(acc, x.letting.map(|u: Unwinding| { arg: u.arg, takes: false })),
      _ -> acc,
    })

fn used_in(s: FieldReadScan, ops: List<Operand>) -> FieldReadScan =
  ops.fold(s, |acc: FieldReadScan, o: Operand|
    match operand_var(o.arg) {
      Some(v) ->
        {
          ..acc,
          whole: acc.whole.insert(v.id, true),
          handed: if o.takes { acc.handed.insert(v.id, true) } else { acc.handed },
        },
      None -> acc,
    })

fn handed_in(s: FieldReadScan, args: List<Arg>) -> FieldReadScan =
  used_in(s, args.map(|a: Arg| { arg: a, takes: true }))

/// `b` with each `Get` binding a variable `taking` names made a `Take`.
fn with_takes(b: Block, taking: Map<Int, Bool>) -> Block =
  b.map(|i: Inst|
    match i {
      Let(l) -> match l.val {
        Get(g) -> if taking.contains(l.var.id) {
          Let({ ..l, val: Take({ of: g.of, path: g.path }) })
        } else { i },
        _ -> i,
      },
      If(x) ->
        If({ ..x, then: with_takes(x.then, taking), otherwise: with_takes(x.otherwise, taking) }),
      Case(c) ->
        Case({
          ..c,
          arms: c.arms.map(|a: { when: Int, body: Block }|
            { when: a.when, body: with_takes(a.body, taking) }),
          rest: with_takes(c.rest, taking),
        }),
      Match(m) ->
        Match({
          arms: m.arms.map(|a: Block| with_takes(a, taking)),
          rest: with_takes(m.rest, taking),
        }),
      Loop(l) -> Loop({ ..l, body: with_takes(l.body, taking) }),
      Handle(h) -> Handle({ ..h, body: with_takes(h.body, taking) }),
      _ -> i,
    })

/// `f`'s variables read twice: once to learn which flat values can be opened, every read out of
/// them a `Get` of a leaf; then again with those values' words, so what is read out of a word is
/// held through it.
fn facts_of(f: Fn) -> Facts = {
  let empty = {
    held: Map::new(),
    vars: Map::new(),
    gets: Map::new(),
    direct: Map::new(),
    made: Map::new(),
    next: 0,
    opened: Map::new(),
    alias: Map::new(),
    stacks: Map::new(),
    promoted: Map::new(),
    immortal: immortals(f),
  };
  let first = collect_definitions(params_defined(f, empty), f.body);
  let got = first.gets.fold(
    Map::new(),
    |m: Map<Int, List<Int>>, id: Int, g: { of: Int, path: Path }| read_by(m, g.of, id),
  );
  let borrowed = first.direct.fold(
    Map::new(),
    |m: Map<Int, List<Int>>, id: Int, from: List<Int>|
      from.fold(m, |n: Map<Int, List<Int>>, x: Int| read_by(n, x, id)),
  );
  let words = first.made.fold(
    { opened: Map::new(), next: first.next },
    |acc: { opened: Map<Int, List<Var>>, next: Int }, id: Int, _: Bool|
      match first.vars.get(id) {
        Some(s) -> if !openable(first, got, borrowed, s) { acc } else {
          let parts = parts_of(s.representation);
          let typed = parts_typed(s, word_types(first, got, id));
          {
            opened: acc.opened.insert(
              id,
              range(0, parts.len()).map(|k: Int|
                {
                  id: acc.next + k,
                  ty: match typed.at(k) { Some(t) -> t, None -> unknown_type() },
                  representation: match parts.at(k) { Some(r) -> r, None -> AsInt },
                }),
            ),
            next: acc.next + parts.len(),
          }
        },
        None -> acc,
      },
  );
  let direct = first.gets.fold(
    Map::new(),
    |m: Map<Int, Var>, id: Int, g: { of: Int, path: Path }|
      match words.opened.get(g.of) {
        Some(ws) -> match g.path {
          LeafPath(k) -> match ws.at(k) {
            Some(w) -> if is_refcounted(w.representation) { m.insert(id, w) } else { m },
            None -> m,
          },
          _ -> m,
        },
        None -> match first.vars.get(g.of) {
          Some(x) -> match first.vars.get(id) {
            Some(y) -> match payload_of(Get({ of: x, path: g.path }), y) {
              Some(_) -> m.insert(id, x),
              None -> m,
            },
            None -> m,
          },
          None -> m,
        },
      },
  );
  let alias = direct.fold(Map::new(), |m: Map<Int, Var>, id: Int, v: Var|
    m.insert(id, aliased(direct, v, direct.len())));
  let read = if words.opened.len() == 0 && alias.len() == 0 { first } else {
    // The words first, so what is read out of a word's alias is read out of the word.
    let start = words.opened.fold(
      params_defined(f, { ..empty, opened: words.opened, alias: alias }),
      |facts: Facts, _: Int, ws: List<Var>|
        ws.fold(facts, |x: Facts, w: Var| defined(x, w, OwnsCount)),
    );
    { ..collect_definitions(start, f.body), next: words.next }
  };
  let joined = joins_held(read, f.body);
  let scan_promotions = promoted(joined, f.body);
  {
    ..joined,
    held: scan_promotions.fold(joined.held, |h: Map<Int, Ownership>, id: Int, _: Bool|
      h.insert(id, OwnsCount)),
    promoted: scan_promotions,
  }
}

/// `fx` with each join held as the values set to it are: read out of what each was read out of
/// where every one is borrowed of values that live where its paths meet, and owned where any holds
/// a count of its own, is a constant, or is read out of a value bound inside a branch that sets it.
fn joins_held(facts: Facts, b: Block) -> Facts = {
  let sets = assigned(Map::new(), b);
  let bound = opened_levels(facts, levels(Map::new(), b, 0));
  sets.fold({ fx: facts, done: Map::new() }, |s: JoinState, j: Int, _: List<Arg>|
    join_held(s, sets, bound, j, sets.len())).fx
}

/// `joins_held` so far: the facts, and the joins decided.
type JoinState = { fx: Facts, done: Map<Int, Bool> }

/// How many blocks deep each variable `b` binds is bound, by number, `b` being `level` deep: a
/// join where it is declared, a loop's or a handle's answer where it stands, a loop's state in its
/// body. A value read where a join is set was bound in a block around it, so one bound deeper than
/// the join is declared is gone where the join's paths meet.
fn levels(m: Map<Int, Int>, b: Block, level: Int) -> Map<Int, Int> =
  b.fold(m, |acc: Map<Int, Int>, i: Inst|
    match i {
      Let(l) -> acc.insert(l.var.id, level),
      Decl(v) -> acc.insert(v.id, level),
      Reset(r) -> acc.insert(r.token.id, level),
      Destructure(o) -> o.words.fold(acc, |n: Map<Int, Int>, w: Var| n.insert(w.id, level)),
      If(x) -> levels(levels(acc, x.then, level + 1), x.otherwise, level + 1),
      Case(c) ->
        c.arms.fold(
          levels(acc, c.rest, level + 1),
          |n: Map<Int, Int>, a: { when: Int, body: Block }| levels(n, a.body, level + 1),
        ),
      Match(x) ->
        x.arms.fold(levels(acc, x.rest, level + 1), |n: Map<Int, Int>, a: Block|
          levels(n, a, level + 1)),
      Loop(l) ->
        levels(
          carried_vars(l.state).fold(acc.insert(l.result.id, level), |n: Map<Int, Int>, s: Var|
            n.insert(s.id, level + 1)),
          l.body,
          level + 1,
        ),
      Handle(h) -> levels(acc.insert(h.result.id, level), h.body, level + 1),
      _ -> acc,
    })

/// `bound` with each opened value's words bound where the value is; a parameter is bound at 0.
fn opened_levels(facts: Facts, bound: Map<Int, Int>) -> Map<Int, Int> =
  facts.opened.fold(bound, |m: Map<Int, Int>, id: Int, ws: List<Var>| {
    let level = match bound.get(id) { Some(n) -> n, None -> 0 };
    ws.fold(m, |n: Map<Int, Int>, w: Var| n.insert(w.id, level))
  })

/// `s` with join `j` decided, each join it is set from first; `depth` bounds how many joins deep a
/// join is set from another, which their number does.
fn join_held(
  s: JoinState,
  sets: Map<Int, List<Arg>>,
  bound: Map<Int, Int>,
  j: Int,
  depth: Int,
) -> JoinState =
  if depth <= 0 || s.done.contains(j) || s.fx.immortal.contains(j) { s } else {
    match sets.get(j) {
      None -> s,
      Some(args) -> {
        let first = args.fold(s, |acc: JoinState, a: Arg|
          match operand_var(a) {
            Some(v) -> if sets.contains(v.id) { join_held(acc, sets, bound, v.id, depth - 1) }
            else { acc },
            None -> acc,
          });
        let level = |id: Int| match bound.get(id) { Some(n) -> n, None -> 0 };
        let bases = args.fold(Some([]), |bs: Option<List<Int>>, a: Arg|
          match bs {
            None -> None,
            Some(xs) -> match operand_var(a) {
              Some(v) -> if !is_refcounted(v.representation) || first.fx.immortal.contains(v.id) {
                bs
              } else {
                match held_through(first.fx, v) {
                  Some(BorrowsFrom(ys)) -> {
                    let from = flattened(first.fx, ys);
                    if from.any(|x: Int| level(x) > level(j)) { None }
                    else { Some(ints_joined(xs, from)) }
                  },
                  _ -> None,
                }
              },
              // A constant set to a counted join is held as that join's count, released as nothing.
              None -> if is_refcounted(operand_representation(a)) { None } else { bs },
            },
          });
        {
          fx: {
            ..first.fx,
            held: first.fx.held.insert(j, match bases {
              Some(xs) -> BorrowsFrom(xs),
              None -> OwnsCount,
            }),
          },
          done: first.done.insert(j, true),
        }
      },
    }
  }

/// `m` with the values each join `b` declares is set to, by the join's number. A handle's answer is
/// no such join: it holds a count of its own.
fn assigned(m: Map<Int, List<Arg>>, b: Block) -> Map<Int, List<Arg>> =
  b.fold(m, |acc: Map<Int, List<Arg>>, i: Inst|
    match i {
      Decl(v) -> if acc.contains(v.id) { acc } else { acc.insert(v.id, []) },
      Assign(x) -> match acc.get(x.var.id) {
        Some(xs) -> acc.insert(x.var.id, xs.push(x.arg)),
        None -> acc,
      },
      If(x) -> assigned(assigned(acc, x.then), x.otherwise),
      Case(c) ->
        c.arms.fold(
          assigned(acc, c.rest),
          |a: Map<Int, List<Arg>>, arm: { when: Int, body: Block }| assigned(a, arm.body),
        ),
      Match(x) -> x.arms.fold(assigned(acc, x.rest), assigned),
      Loop(l) -> assigned(acc, l.body),
      Handle(h) -> assigned(acc, h.body),
      _ -> acc,
    })

/// The borrowed variables used on a path past the last use of something they were read out of where
/// that use consumes it, or where a value made after it could take its cells: each takes a count of
/// its own where it is bound, so the value it was read out of moves or is reset there rather than
/// being held, and so copied or kept from reuse, for it.
fn promoted(facts: Facts, b: Block) -> Map<Int, Bool> =
  scan_promotions(
    facts,
    scan_last_uses(facts, { at: 0, last: Map::new(), taken: Map::new() }, b),
    { at: 0, gone: Map::new(), dying: Map::new(), up: Map::new() },
    b,
  ).up

/// A body read in order, each instruction numbered as it is reached and a branch's blocks after
/// it: where each variable is used last, and where it is consumed last.
type LastUses = { at: Int, last: Map<Int, Int>, taken: Map<Int, Int> }

fn scan_last_uses(facts: Facts, s: LastUses, b: Block) -> LastUses =
  b.fold(s, |acc: LastUses, i: Inst| {
    let k = acc.at;
    let here = { ..acc, at: k + 1 };
    match i {
      Let(l) -> used_at(facts, here, k, uses_of(facts, l.val)),
      Do(d) -> used_at(facts, here, k, uses_of(facts, d.val)),
      Assign(x) -> used_at(facts, here, k, all_taken([x.arg])),
      If(x) ->
        scan_last_uses(
          facts,
          scan_last_uses(facts, used_at(facts, here, k, [{ arg: x.cond, takes: false }]), x.then),
          x.otherwise,
        ),
      Case(c) ->
        scan_last_uses(
          facts,
          c.arms.fold(
            used_at(facts, here, k, [{ arg: VarOperand(c.on), takes: false }]),
            |a: LastUses, arm: { when: Int, body: Block }| scan_last_uses(facts, a, arm.body),
          ),
          c.rest,
        ),
      Match(m) ->
        scan_last_uses(
          facts,
          m.arms.fold(here, |a: LastUses, arm: Block| scan_last_uses(facts, a, arm)),
          m.rest,
        ),
      Loop(l) ->
        scan_last_uses(facts, used_at(facts, here, k, all_taken(carried_inits(l.state))), l.body),
      Next(args) -> used_at(facts, here, k, all_taken(args)),
      Done(a) -> used_at(facts, here, k, all_taken([a])),
      Return(a) -> used_at(facts, here, k, all_taken([a])),
      Restart(args) -> used_at(facts, here, k, all_taken(args)),
      Jump(e) -> used_at(facts, here, k, all_taken(e.args)),
      Handle(h) ->
        scan_last_uses(facts, used_at(facts, here, k, by_signature(h.args, h.uses)), h.body),
      _ -> here,
    }
  })

fn used_at(facts: Facts, s: LastUses, k: Int, ops: List<Operand>) -> LastUses =
  expanded(facts, ops).fold(s, |acc: LastUses, o: Operand|
    match operand_var(o.arg) {
      Some(v) ->
        {
          ..acc,
          last: acc.last.insert(v.id, k),
          taken: if o.takes { acc.taken.insert(v.id, k) } else { acc.taken },
        },
      None -> acc,
    })

/// A body read in `scan_last_uses`'s order, holding what each path has consumed at its last use or could
/// hand its cells to a value made since (`gone`), what it has used for the last time (`dying`), and
/// the borrowed variables used past a use that made something they were read out of gone (`up`).
/// The paths through a branch's blocks each start from what was gone and dying before it.
type PromotionScan = { at: Int, gone: Map<Int, Bool>, dying: Map<Int, Bool>, up: Map<Int, Bool> }

fn scan_promotions(facts: Facts, s: LastUses, r: PromotionScan, b: Block) -> PromotionScan =
  b.fold(r, |acc: PromotionScan, i: Inst| {
    let k = acc.at;
    let here = { ..acc, at: k + 1 };
    match i {
      Let(l) -> {
        let past = passed_at(facts, s, here, k, uses_of(facts, l.val));
        match l.val {
          // Cells a value used for the last time could hand to what this makes.
          Allocate(m) -> if takes_cells(l.var, m.made, m.reuse) {
            {
              ..past,
              gone: past.dying.fold(past.gone, |g: Map<Int, Bool>, id: Int, _: Bool|
                match facts.vars.get(id) {
                  Some(v) -> if v.ty == l.var.ty && owns(facts, v) { g.insert(id, true) }
                  else { g },
                  None -> g,
                }),
            }
          } else { past },
          _ -> past,
        }
      },
      Do(d) -> passed_at(facts, s, here, k, uses_of(facts, d.val)),
      Assign(x) -> passed_at(facts, s, here, k, all_taken([x.arg])),
      If(x) ->
        branches(facts, s, passed_at(facts, s, here, k, [{ arg: x.cond, takes: false }]), [
          x.then,
          x.otherwise,
        ]),
      Case(c) ->
        branches(
          facts,
          s,
          passed_at(facts, s, here, k, [{ arg: VarOperand(c.on), takes: false }]),
          c.arms.map(|a: { when: Int, body: Block }| a.body).push(c.rest),
        ),
      Match(m) -> branches(facts, s, here, m.arms.push(m.rest)),
      Loop(l) ->
        branches(facts, s, passed_at(facts, s, here, k, all_taken(carried_inits(l.state))), [
          l.body,
        ]),
      Next(args) -> passed_at(facts, s, here, k, all_taken(args)),
      Done(a) -> passed_at(facts, s, here, k, all_taken([a])),
      Return(a) -> passed_at(facts, s, here, k, all_taken([a])),
      Restart(args) -> passed_at(facts, s, here, k, all_taken(args)),
      Jump(e) -> passed_at(facts, s, here, k, all_taken(e.args)),
      Handle(h) ->
        branches(facts, s, passed_at(facts, s, here, k, by_signature(h.args, h.uses)), [h.body]),
      _ -> here,
    }
  })

/// `blocks` read in order from `r`, each from what was gone at `r`, and what any of them made gone
/// gone after them.
fn branches(facts: Facts, s: LastUses, r: PromotionScan, blocks: List<Block>) -> PromotionScan =
  blocks.fold(r, |acc: PromotionScan, b: Block| {
    let w = scan_promotions(facts, s, { ..acc, gone: r.gone, dying: r.dying }, b);
    { ..w, gone: Map::merge(acc.gone, w.gone), dying: Map::merge(acc.dying, w.dying) }
  })

/// `r` past instruction `k` using `ops`: each borrowed variable used there that was read out of
/// something gone raised, then each value consumed there at its last use gone.
fn passed_at(
  facts: Facts,
  s: LastUses,
  r: PromotionScan,
  k: Int,
  ops: List<Operand>,
) -> PromotionScan = {
  let used = expanded(facts, ops);
  {
    ..r,
    // An address takes no count of its own: its block stays live through it instead.
    up: used.fold(r.up, |u: Map<Int, Bool>, o: Operand|
      match operand_var(o.arg) {
        Some(v) -> if points_into(v.representation) { u } else {
          match facts.held.get(v.id) {
            Some(BorrowsFrom(bs)) -> if flattened(facts, bs).any(|x: Int| r.gone.contains(x)) {
              u.insert(v.id, true)
            } else { u },
            _ -> u,
          }
        },
        None -> u,
      }),
    gone: used.fold(r.gone, |g: Map<Int, Bool>, o: Operand|
      match operand_var(o.arg) {
        Some(v) -> if o.takes && s.last.get(v.id) == Some(k) && s.taken.get(v.id) == Some(k) {
          g.insert(v.id, true)
        } else { g },
        None -> g,
      }),
    dying: used.fold(r.dying, |d: Map<Int, Bool>, o: Operand|
      match operand_var(o.arg) {
        Some(v) -> if s.last.get(v.id) == Some(k) { d.insert(v.id, true) } else { d },
        None -> d,
      }),
  }
}

/// `fx` with `f`'s parameters defined, and each tail group member's: given ones owned, lent ones
/// outlasting the body.
fn params_defined(f: Fn, facts: Facts) -> Facts =
  f.members.fold(given_defined(f.params, f.convention, facts), |acc: Facts, m: Member|
    given_defined(m.params, m.convention, acc))

fn given_defined(params: List<Var>, conv: Convention, facts: Facts) -> Facts =
  range(0, params.len()).fold(facts, |acc: Facts, i: Int|
    match params.at(i) {
      None -> acc,
      Some(p) -> if param_lent(conv, i) { defined(acc, p, BorrowsFrom([])) }
      else { { ..defined(acc, p, OwnsCount), made: acc.made.insert(p.id, true) } },
    })

/// `by` with `id` among the variables read out of `of`, in ascending order where they are added so.
fn read_by(by: Map<Int, List<Int>>, of: Int, id: Int) -> Map<Int, List<Int>> =
  by.insert(of, match by.get(of) { Some(ids) -> ids.push(id), None -> [id] })

fn reads_of(by: Map<Int, List<Int>>, of: Int) -> List<Int> =
  match by.get(of) { Some(ids) -> ids, None -> [] }

/// Whether `s`, a value holding a count made where it is bound, is flat and read out of only by
/// `Get`s of its leaves, each held as that part is. `got` and `borrowed` are the variables each
/// `Get` and each borrowing read binds, by what they read out of.
fn openable(facts: Facts, got: Map<Int, List<Int>>, borrowed: Map<Int, List<Int>>, s: Var) -> Bool =
  match s.representation { AsFlattened(_) -> leaves_only(facts, got, borrowed, s), _ -> false }

fn leaves_only(
  facts: Facts,
  got: Map<Int, List<Int>>,
  borrowed: Map<Int, List<Int>>,
  s: Var,
) -> Bool = {
  let parts = parts_of(s.representation);
  let leaf = |id: Int|
    match facts.gets.get(id) {
      Some(g) -> match g.path {
        LeafPath(k) ->
          k >= 0
            && (match facts.vars.get(id) {
              Some(v) -> parts.at(k) == Some(v.representation),
              None -> false,
            }),
        _ -> false,
      },
      None -> false,
    };
  // Every read out of `s`: those that borrow from it, and every `Get`, a read by name among them,
  // which answers a count of its own.
  reads_of(borrowed, s.id).all(leaf) && reads_of(got, s.id).all(leaf)
}

/// The type of each part of `s`, by its place: a record's leaf the type of the field its name
/// leads to, through each record held in place; any other part what `read` says it is read as.
fn parts_typed(s: Var, read: Map<Int, Type>) -> List<Type> = {
  let parts = parts_of(s.representation);
  let by_read = |k: Int| match read.get(k) { Some(t) -> t, None -> unknown_type() };
  match s.representation {
    AsFlattened(leaves) ->
      range(0, leaves.len()).map(|k: Int|
        match leaves.at(k) {
          Some(l) -> match leaf_type(s.ty, l.name) { Some(t) -> t, None -> by_read(k) },
          None -> by_read(k),
        }),
    _ -> range(0, parts.len()).map(by_read),
  }
}

/// The type each word of the value numbered `s` is read as, by its place: what the last `Get` of
/// that leaf reads.
fn word_types(facts: Facts, got: Map<Int, List<Int>>, s: Int) -> Map<Int, Type> =
  reads_of(got, s).fold(Map::new(), |m: Map<Int, Type>, id: Int|
    match facts.gets.get(id) {
      Some(g) -> match g.path {
        LeafPath(k) -> match facts.vars.get(id) { Some(v) -> m.insert(k, v.ty), None -> m },
        _ -> m,
      },
      None -> m,
    })

fn defined(facts: Facts, v: Var, h: Ownership) -> Facts =
  {
    ..facts,
    held: if is_refcounted(v.representation) || points_into(v.representation) {
      facts.held.insert(v.id, h)
    } else { facts.held },
    vars: facts.vars.insert(v.id, v),
    next: if v.id >= facts.next { v.id + 1 } else { facts.next },
  }

/// `v`, one of the body's values that hold no count (`verify.immortals`): known, never counted.
fn holding_none(facts: Facts, v: Var) -> Facts =
  { ..defined(facts, v, OwnsCount), held: facts.held }

/// Every variable `b` defines, with how it is held: a `Let` as its value answers, a join, a loop's
/// state and answer and a handle's answer owned; an alias of a word as nothing of its own.
fn collect_definitions(facts: Facts, b: Block) -> Facts =
  b.fold(facts, |acc: Facts, i: Inst|
    match i {
      // A block laid in the frame holds no count to promote: what it borrows stays held through
      // each use of it (`stacks`), never through a value read out of it, which `lend` rules out.
      Let(l) -> match stack_captures(l.val) {
        Some(caps) ->
          {
            ..defined(acc, l.var, BorrowsFrom([])),
            stacks: acc.stacks.insert(
              l.var.id,
              caps.fold([], |vs: List<Var>, c: Arg|
                match operand_var(c) {
                  Some(v) -> if is_refcounted(v.representation) { vs.push(v) } else { vs },
                  None -> vs,
                }),
            ),
          },
        None -> if acc.immortal.contains(l.var.id) { holding_none(acc, l.var) } else {
          // A borrowed value held again as another is read, and holds as that one does.
          let a = match count_shared_with(l.var, l.val) {
            Some(x) -> match held_through(acc, x) {
              Some(BorrowsFrom(_)) -> BorrowSources([x]),
              _ -> result_ownership(l.val),
            },
            None -> result_ownership(l.val),
          };
          let d = if acc.alias.contains(l.var.id) {
            { ..acc, vars: acc.vars.insert(l.var.id, l.var) }
          } else {
            defined(acc, l.var, match a {
              Owns -> OwnsCount,
              BorrowSources(xs) ->
                BorrowsFrom(xs.fold([], |bs: List<Int>, x: Var| ints_joined(bs, base_of(acc, x)))),
              Immortal -> BorrowsFrom([]),
            })
          };
          let traced = match a {
            Owns -> { ..d, made: d.made.insert(l.var.id, true) },
            BorrowSources(xs) -> if xs.len() == 0 { d }
            else { { ..d, direct: d.direct.insert(l.var.id, xs.map(|x: Var| x.id)) } },
            Immortal -> d,
          };
          match l.val {
            Get(g) ->
              { ..traced, gets: traced.gets.insert(l.var.id, { of: g.of.id, path: g.path }) },
            _ -> traced,
          }
        },
      },
      Decl(v) -> if acc.immortal.contains(v.id) { holding_none(acc, v) }
      else { defined(acc, v, OwnsCount) },
      If(x) -> collect_definitions(collect_definitions(acc, x.then), x.otherwise),
      Case(c) ->
        c.arms.fold(
          collect_definitions(acc, c.rest),
          |a: Facts, arm: { when: Int, body: Block }| collect_definitions(a, arm.body),
        ),
      Match(m) ->
        m.arms.fold(collect_definitions(acc, m.rest), |a: Facts, arm: Block|
          collect_definitions(a, arm)),
      Loop(l) ->
        collect_definitions(
          defined(
            carried_vars(l.state).fold(acc, |a: Facts, s: Var|
              { ..defined(a, s, OwnsCount), made: a.made.insert(s.id, true) }),
            l.result,
            OwnsCount,
          ),
          l.body,
        ),
      Handle(h) -> collect_definitions(defined(acc, h.result, OwnsCount), h.body),
      Reset(r) -> defined(acc, r.token, OwnsCount),
      Destructure(o) -> o.words.fold(acc, |a: Facts, w: Var| defined(a, w, OwnsCount)),
      _ -> acc,
    })

/// What `v` is read out of, as the body holds it: `v`'s own number where it holds a count, through
/// the value an alias stands for, which may itself be read out of others.
fn base_of(facts: Facts, v: Var) -> List<Int> = {
  let x = match facts.alias.get(v.id) { Some(w) -> w, None -> v };
  match facts.held.get(x.id) {
    Some(OwnsCount) -> [x.id],
    Some(BorrowsFrom(bs)) -> flattened(facts, bs),
    None -> [],
  }
}

/// How `v` is held: an alias, a sum's payload that is its one count, as the sum it is read out of is.
fn held_through(facts: Facts, v: Var) -> Option<Ownership> =
  match facts.alias.get(v.id) { Some(t) -> facts.held.get(t.id), None -> facts.held.get(v.id) }

/// What `v` stands for through the aliases `direct` names, each the value it was read out of: a
/// payload's payload is the outermost sum's count, however the two are numbered. `depth` bounds the
/// chain, which `direct`'s size does.
fn aliased(direct: Map<Int, Var>, v: Var, depth: Int) -> Var =
  if depth <= 0 { v }
  else { match direct.get(v.id) { Some(t) -> aliased(direct, t, depth - 1), None -> v } }

/// `bs` with each borrowed join among them as what it was read out of: a join's holding is settled
/// after the values read out of it took it as their base.
fn flattened(facts: Facts, bs: List<Int>) -> List<Int> =
  bs.fold([], |acc: List<Int>, b: Int|
    ints_joined(acc, match facts.held.get(b) { Some(BorrowsFrom(cs)) -> cs, _ -> [b] }))

/// The owned variables `v` was read out of, each live while it is.
fn base_vars(facts: Facts, v: Var) -> List<Var> =
  match facts.held.get(v.id) {
    Some(BorrowsFrom(bs)) ->
      flattened(facts, bs).fold([], |vs: List<Var>, b: Int|
        match facts.vars.get(b) { Some(x) -> vs.push(x), None -> vs }),
    _ -> [],
  }

fn ints_joined(a: List<Int>, b: List<Int>) -> List<Int> =
  b.fold(a, |acc: List<Int>, x: Int| if acc.contains(x) { acc } else { acc.push(x) })

fn owns(facts: Facts, v: Var) -> Bool =
  is_refcounted(v.representation) && facts.held.get(v.id) == Some(OwnsCount)

/// What a use of `v` is a use of: an opened value's counted words, a word's alias that word, any
/// other variable itself.
fn resolved(facts: Facts, v: Var) -> List<Var> =
  match facts.stacks.get(v.id) {
    Some(caps) -> caps.fold([], |acc: List<Var>, c: Var| acc.concat(word_of(facts, c))),
    None -> word_of(facts, v),
  }

fn word_of(facts: Facts, v: Var) -> List<Var> =
  match facts.opened.get(v.id) {
    Some(ws) -> ws.filter(|w: Var| is_refcounted(w.representation)),
    None -> match facts.alias.get(v.id) { Some(w) -> [w], None -> [v] },
  }

/// `ops` with each operand that is an opened value or an alias as the words it uses, and a closure
/// on this frame's stack as a read of each capture.
fn expanded(facts: Facts, ops: List<Operand>) -> List<Operand> =
  ops.fold([], |acc: List<Operand>, o: Operand|
    match operand_var(o.arg) {
      Some(v) -> {
        let takes = o.takes && !facts.stacks.contains(v.id);
        acc.concat(resolved(facts, v).map(|w: Var| { arg: VarOperand(w), takes: takes }))
      },
      None -> acc.push(o),
    })

/// What `val` uses: its operands, but a `Get` of an opened value's leaf reads only that word.
fn uses_of(facts: Facts, val: Rvalue) -> List<Operand> =
  match val {
    Get(g) -> match facts.opened.get(g.of.id) {
      Some(ws) -> match g.path {
        LeafPath(k) -> match ws.at(k) {
          Some(w) -> if is_refcounted(w.representation) { [{ arg: VarOperand(w), takes: false }] }
          else { [] },
          None -> [],
        },
        _ -> operands(val),
      },
      None -> operands(val),
    },
    _ -> operands(val),
  }

/// `live` with `v` live, and what `v` is read out of; an address only keeps its block live.
fn alive(facts: Facts, live: Live, v: Var) -> Live =
  resolved(facts, v).fold(live, |l: Live, x: Var|
    if points_into(x.representation) {
      base_vars(facts, x).fold(l, |m: Live, b: Var| m.insert(b.id, b))
    } else if !is_refcounted(x.representation) { l }
    else { base_vars(facts, x).fold(l.insert(x.id, x), |m: Live, b: Var| m.insert(b.id, b)) })

fn arg_live(facts: Facts, live: Live, a: Arg) -> Live =
  match operand_var(a) { Some(v) -> alive(facts, live, v), None -> live }

/// The one recursion: `b` walked from its end, `out` live after it, each instruction given the
/// counts its operands need; a branch's blocks walked from the live set after the branch and
/// opened by letting go of what is live into the branch but not into them.
fn walked_back(facts: Facts, ex: Exits, b: Block, out: Live, next: Int) -> BackwardState =
  b.fold_right({ rev: [], live: out, next: next, takers: [] }, |i: Inst, acc: BackwardState|
    match i {
      Let(l) -> {
        let words = match facts.opened.get(l.var.id) { Some(ws) -> ws, None -> [] };
        let after = words.fold(acc.live.remove(l.var.id), |m: Live, w: Var| m.remove(w.id));
        // A value held again as another reads it where that one is borrowed, and takes it, with a
        // count first where it is borrowed, where that one holds a count of its own.
        let again = count_shared_with(l.var, l.val);
        let held_again = again != None;
        let p = planned(
          facts,
          match again {
            Some(x) -> if owns(facts, l.var) { uses_of(facts, l.val) }
            else { [{ arg: VarOperand(x), takes: false }] },
            None -> uses_of(facts, l.val),
          },
          after,
        );
        let unwind = if may_leave(l.val) { unwind_of(facts, ex, after, p.after) } else { [] };
        let made = Let({ ..l, unwind: unwind });
        // A promoted record held as a word may be read out of a place: it is kept where it is bound.
        let promoting = facts.promoted.contains(l.var.id) && !held_again;
        let keeping = promoting && is_record_word(l.var);
        let read = { ..l.var, id: acc.next };
        match facts.opened.get(l.var.id) {
          // A flat value opened where it is made: each word nothing reads is let go of at once.
          Some(ws) ->
            with_counts(
              ex,
              acc,
              p,
              made,
              [Destructure({ of: l.var, words: ws })],
              ws.filter(|w: Var| owns(facts, w) && !acc.live.contains(w.id)),
            ),
          None -> if keeping {
            with_counts(
              ex,
              { ..acc, next: acc.next + 1 },
              p,
              Let({ ..l, var: read, unwind: unwind }),
              [Let({ var: l.var, val: retain(read), at: l.at, unwind: [] })],
              if !acc.live.contains(l.var.id) { [l.var] } else { [] },
            )
          } else {
            with_counts(
              ex,
              acc,
              p,
              made,
              if promoting { [Inc({ var: l.var, n: 1 })] } else { [] },
              if owns(facts, l.var) && !acc.live.contains(l.var.id) { [l.var] } else { [] },
            )
          },
        }
      },
      Do(d) -> {
        let p = planned(facts, uses_of(facts, d.val), acc.live);
        let unwind = if may_leave(d.val) { unwind_of(facts, ex, acc.live, p.after) } else { [] };
        with_counts(ex, acc, p, Do({ ..d, unwind: unwind }), [], [])
      },
      Decl(v) -> { ..acc, rev: acc.rev.push(i), live: acc.live.remove(v.id) },
      Assign(s) -> {
        let dead = if owns(facts, s.var) && !acc.live.contains(s.var.id) { [s.var] } else { [] };
        with_counts(
          ex,
          acc,
          // A join held as what it is set to only reads it.
          planned(
            facts,
            [{ arg: s.arg, takes: owns(facts, s.var) || !is_refcounted(s.var.representation) }],
            acc.live.remove(s.var.id),
          ),
          i,
          [],
          dead,
        )
      },
      If(x) -> {
        let t = walked_back(facts, ex, x.then, acc.live, acc.next);
        let e = walked_back(facts, ex, x.otherwise, acc.live, t.next);
        let live = arg_live(facts, Map::merge(t.live, e.live), x.cond);
        let tb = entered(facts, ex, { ..t, next: e.next }, live);
        let eb = entered(facts, ex, { ..e, next: tb.next }, live);
        let at = acc.rev.len();
        branched(
          acc,
          If({ cond: x.cond, then: tb.block, otherwise: eb.block }),
          live,
          eb.next,
          stepped(tb.takers, at, 0).concat(stepped(eb.takers, at, 1)),
        )
      },
      Case(c) -> {
        let rest = walked_back(facts, ex, c.rest, acc.live, acc.next);
        let arms = c.arms.fold(
          { walks: [], next: rest.next },
          |s: Arms, a: { when: Int, body: Block }| {
            let k = { ..ex, known: known_at(ex.known, c.on, c.test, a.when) };
            let w = walked_back(facts, k, a.body, acc.live, s.next);
            { walks: s.walks.push({ when: a.when, back: w, exits: k }), next: w.next }
          },
        );
        let live = arms.walks.fold(alive(facts, rest.live, c.on), |l: Live, w: ArmWalk|
          Map::merge(l, w.back.live));
        let r = entered(facts, ex, { ..rest, next: arms.next }, live);
        let at = acc.rev.len();
        let opened = arms.walks.fold(
          { arms: [], next: r.next, takers: stepped(r.takers, at, c.arms.len()) },
          |s: { arms: List<{ when: Int, body: Block }>, next: Int, takers: List<ReuseCandidate> }, w: ArmWalk| {
            let e = entered(facts, w.exits, { ..w.back, next: s.next }, live);
            {
              arms: s.arms.push({ when: w.when, body: e.block }),
              next: e.next,
              takers: s.takers.concat(stepped(e.takers, at, s.arms.len())),
            }
          },
        );
        branched(
          acc,
          Case({ ..c, arms: opened.arms, rest: r.block }),
          live,
          opened.next,
          opened.takers,
        )
      },
      Match(m) -> {
        let rest = walked_back(facts, ex, m.rest, acc.live, acc.next);
        let arms = m.arms.fold_right(
          { blocks: [], entry: rest.live, next: rest.next },
          |a: Block, s: { blocks: List<Block>, entry: Live, next: Int }| {
            let w = walked_back(facts, { ..ex, miss: s.entry }, a, acc.live, s.next);
            { blocks: s.blocks.push(w.rev.reverse()), entry: w.live, next: w.next }
          },
        );
        branched(
          acc,
          Match({ arms: arms.blocks.reverse(), rest: rest.rev.reverse() }),
          arms.entry,
          arms.next,
          [],
        )
      },
      Loop(l) -> {
        // A flat state is opened at the head of each pass, so what a pass reads of it moves on.
        let vars = carried_vars(l.state);
        let words = vars.fold([], |ws: List<Var>, s: Var|
          match facts.opened.get(s.id) { Some(x) -> ws.concat(x), None -> ws });
        let inner = outer_reads(facts, l.body, vars.concat(words));
        let carry_token = Map::merge(acc.live.remove(l.result.id), inner);
        let k = { ..ex, looped: Some(carry_token), miss: Map::new() };
        let e = counted_block(facts, k, vars, l.body, carry_token, acc.next);
        let p = planned(facts, all_taken(carried_inits(l.state)), carry_token);
        let gone = inner.values().filter(|v: Var| owns(facts, v) && !acc.live.contains(v.id));
        with_counts(
          ex,
          { ..acc, next: e.next },
          { ..p, after: p.after.concat(gone) },
          Loop({ ..l, body: e.block }),
          [],
          dead_result(facts, acc.live, l.result),
        )
      },
      Handle(h) -> {
        let ops = by_signature(h.args, h.uses);
        let lent = ops.filter(|o: Operand| !o.takes).fold(Map::new(), |l: Live, o: Operand|
          arg_live(facts, l, o.arg));
        let inner = Map::merge(outer_reads(facts, h.body, [h.result]), lent);
        let across = Map::merge(acc.live.remove(h.result.id), inner);
        let k = { ..ex, looped: None, miss: Map::new(), landing: across };
        // A body under a `return` clause leaves its value to the landing, which sets the answer.
        let ends = if h.site.ret == None { across.insert(h.result.id, h.result) } else { across };
        let body = walked_back(facts, k, h.body, ends, acc.next);
        let e = entered(facts, k, body, across);
        let p = planned(facts, ops, across);
        let gone = inner.values().filter(|v: Var| owns(facts, v) && !acc.live.contains(v.id));
        let unwind = across.values().filter(|v: Var| owns(facts, v) && !ex.landing.contains(v.id));
        with_counts(
          ex,
          { ..acc, next: e.next },
          { ..p, after: p.after.concat(gone) },
          Handle({ ..h, body: e.block, unwind: unwind }),
          [],
          dead_result(facts, acc.live, h.result),
        )
      },
      Next(args) -> ended_back(facts, ex, acc, i, all_taken(args), looped_live(ex)),
      Done(a) -> ended_back(facts, ex, acc, i, all_taken([a]), looped_live(ex)),
      Return(a) ->
        ended_back(
          facts,
          ex,
          acc,
          i,
          match ex.answered {
            OwnedResult -> all_taken([a]),
            BorrowedResult(_) -> [{ arg: a, takes: false }],
          },
          Map::new(),
        ),
      Restart(args) -> ended_back(facts, ex, acc, i, handed_as(args, ex.restart), Map::new()),
      Jump(e) ->
        ended_back(
          facts,
          ex,
          acc,
          i,
          handed_as(e.args, match ex.enters.at(e.member) { Some(h) -> h, None -> [] }),
          Map::new(),
        ),
      // What a failure lets go of it holds until it fails, and lets go of the counts the landing
      // does not on the way out.
      Fail(x) -> {
        let live = x.letting.fold(ex.landing, |l: Live, u: Unwinding| arg_live(facts, l, u.arg));
        let unwind = live.values().filter(|v: Var| owns(facts, v) && !ex.landing.contains(v.id));
        { ..acc, rev: acc.rev.push(Fail({ ..x, unwind: unwind })), live: live, takers: [] }
      },
      Miss -> { ..acc, rev: acc.rev.push(i), live: ex.miss, takers: [] },
      _ -> { ..acc, rev: acc.rev.push(i) },
    })

type ArmWalk = { when: Int, back: BackwardState, exits: Exits }

type Arms = { walks: List<ArmWalk>, next: Int }

/// The constructor a case arm knows its subject holds: the one its tag test names at the arm's
/// place.
fn known_at(known: Map<Int, Bytes>, on: Var, tested: Test, when: Int) -> Map<Int, Bytes> =
  match tested {
    TagTest(names) -> match names.at(when) { Some(n) -> known.insert(on.id, n), None -> known },
    _ -> known,
  }

fn looped_live(ex: Exits) -> Live = match ex.looped { Some(l) -> l, None -> Map::new() }

/// `answer`, a loop's or a handle's, let go of right after it where nothing reads it.
fn dead_result(facts: Facts, live: Live, answer: Var) -> List<Var> =
  if owns(facts, answer) && !live.contains(answer.id) { [answer] } else { [] }

/// The counted variables `b` reads that it does not define, nor `bound` names, and what they are
/// read out of: what a loop or a handle around `b` holds across it.
fn outer_reads(facts: Facts, b: Block, bound: List<Var>) -> Live = {
  let m = mentioned(facts, { used: Map::new(), bound: Map::new() }, b);
  m.used.fold(Map::new(), |l: Live, id: Int, v: Var|
    if m.bound.contains(id) || bound.any(|s: Var| s.id == id) { l } else { alive(facts, l, v) })
}

type Mentions = { used: Map<Int, Var>, bound: Map<Int, Bool> }

/// The variables `b` names as operands and those it defines, an opened value's words with it.
fn mentioned(facts: Facts, m: Mentions, b: Block) -> Mentions =
  b.fold(m, |acc: Mentions, i: Inst|
    match i {
      Let(l) -> {
        let read = bound_in(args_in(acc, uses_of(facts, l.val).map(|o: Operand| o.arg)), l.var);
        match facts.opened.get(l.var.id) { Some(ws) -> ws.fold(read, bound_in), None -> read }
      },
      Do(d) -> args_in(acc, uses_of(facts, d.val).map(|o: Operand| o.arg)),
      Decl(v) -> bound_in(acc, v),
      Assign(s) -> args_in(acc, [s.arg]),
      If(x) -> mentioned(facts, mentioned(facts, args_in(acc, [x.cond]), x.then), x.otherwise),
      Case(c) ->
        c.arms.fold(
          mentioned(facts, args_in(acc, [VarOperand(c.on)]), c.rest),
          |a: Mentions, arm: { when: Int, body: Block }| mentioned(facts, a, arm.body),
        ),
      Match(x) ->
        x.arms.fold(mentioned(facts, acc, x.rest), |a: Mentions, arm: Block|
          mentioned(facts, a, arm)),
      Loop(l) -> {
        let state = carried_vars(l.state).fold(
          args_in(acc, l.state.map(|c: Carried| c.init)),
          |a: Mentions, s: Var|
            match facts.opened.get(s.id) {
              Some(ws) -> ws.fold(bound_in(a, s), bound_in),
              None -> bound_in(a, s),
            },
        );
        mentioned(facts, bound_in(state, l.result), l.body)
      },
      Next(args) -> args_in(acc, args),
      Done(a) -> args_in(acc, [a]),
      Return(a) -> args_in(acc, [a]),
      Restart(args) -> args_in(acc, args),
      Jump(e) -> args_in(acc, e.args),
      Handle(h) -> mentioned(facts, bound_in(args_in(acc, h.args), h.result), h.body),
      Inc(n) -> args_in(acc, [VarOperand(n.var)]),
      Dec(v) -> args_in(acc, [VarOperand(v)]),
      Reset(r) -> bound_in(args_in(acc, [VarOperand(r.of)]), r.token),
      Free(r) -> args_in(acc, [VarOperand(r.of)]),
      Destructure(o) -> o.words.fold(args_in(acc, [VarOperand(o.of)]), bound_in),
      Fail(x) -> args_in(acc, x.letting.map(|u: Unwinding| u.arg)),
      Miss -> acc,
      SiteScope(_) -> acc,
      CleanupScope(_) -> acc,
    })

fn args_in(m: Mentions, args: List<Arg>) -> Mentions =
  args.fold(m, |acc: Mentions, a: Arg|
    match operand_var(a) {
      Some(v) -> if is_refcounted(v.representation) { { ..acc, used: acc.used.insert(v.id, v) } }
      else { acc },
      None -> acc,
    })

fn bound_in(m: Mentions, v: Var) -> Mentions = { ..m, bound: m.bound.insert(v.id, true) }

/// What an instruction consuming or reading `ops` needs, `after` live after it. A value consumed
/// while it stays live, or read by the instruction too, takes an `Inc` for each consuming use; one
/// consumed for the last time moves; a borrowed one always takes an `Inc`. An owned value the
/// instruction reads and nothing reads after dies after it; one it does not read, which only
/// something consumed was read out of, dies before it.
fn planned(facts: Facts, uses: List<Operand>, after: Live) -> Plan = {
  let t = expanded(facts, uses).fold(
    { order: [], listed: Map::new(), taken: Map::new(), read: Map::new() },
    |acc: OperandUses, o: Operand|
      match operand_var(o.arg) {
        Some(v) -> {
          let used = if o.takes {
            { ..acc, taken: acc.taken.insert(v.id, consumed(acc, v.id) + 1) }
          } else {
            {
              ..acc,
              read: base_of(facts, v).fold(
                acc.read.insert(v.id, true),
                |r: Map<Int, Bool>, b: Int| r.insert(b, true),
              ),
            }
          };
          if points_into(v.representation) { base_vars(facts, v).fold(used, listed) }
          else if !is_refcounted(v.representation) || facts.immortal.contains(v.id) { used }
          else { base_vars(facts, v).fold(listed(used, v), listed) }
        },
        None -> acc,
      },
  );
  t.order.fold({ incs: [], keeps: [], before: [], after: [], live: after }, |p: Plan, x: Var| {
    let taken = consumed(t, x.id);
    let live = after.contains(x.id);
    let held = { ..p, live: p.live.insert(x.id, x) };
    if !owns(facts, x) {
      if taken > 0 && is_record_word(x) { { ..held, keeps: held.keeps.push({ of: x, n: taken }) } }
      else { counts_for(held, x, taken) }
    } else if live || t.read.contains(x.id) {
      counts_for({ ..held, after: if live { held.after } else { held.after.push(x) } }, x, taken)
    } else if taken > 0 { counts_for(held, x, taken - 1) }
    else { { ..held, before: held.before.push(x) } }
  })
}

/// An instruction's operands read once: the counted variables they use, each first in the order
/// they are named and followed by what it is read out of (`listed` holding the same as a set), how
/// many times each operand is consumed, and which are read without being consumed, directly or
/// through a value read out of them.
type OperandUses = {
  order: List<Var>,
  listed: Map<Int, Bool>,
  taken: Map<Int, Int>,
  read: Map<Int, Bool>,
}

fn consumed(t: OperandUses, id: Int) -> Int = match t.taken.get(id) { Some(n) -> n, None -> 0 }

/// `t` with `v` last in its order, unless it is there already.
fn listed(t: OperandUses, v: Var) -> OperandUses =
  if t.listed.contains(v.id) { t }
  else { { ..t, order: t.order.push(v), listed: t.listed.insert(v.id, true) } }

fn counts_for(p: Plan, v: Var, n: Int) -> Plan =
  if n > 0 { { ..p, incs: p.incs.push(Inc({ var: v, n: n })) } } else { p }

/// What the failure path of an instruction releases: the owned values live after it and those it
/// reads that die after it, but what a `handle` around it holds across its body.
fn unwind_of(facts: Facts, ex: Exits, after: Live, dying: List<Var>) -> List<Var> =
  after.values().concat(dying).filter(|v: Var| owns(facts, v) && !ex.landing.contains(v.id))

/// `inst` placed with the counts `p` says, `then` right after it, `dead` let go of after that, and
/// `p.after` after those.
fn with_counts(
  ex: Exits,
  at: BackwardState,
  p: Plan,
  given: Inst,
  then: List<Inst>,
  dead: List<Var>,
) -> BackwardState = {
  // A borrowed record held as a word may be a place, whose count no code takes: a keep stands in
  // for its count, and the instruction reads the keep.
  let kept = p.keeps.fold(
    { incs: [], renames: Map::new(), next: at.next },
    |k: { incs: List<Inst>, renames: Map<Int, Var>, next: Int }, x: { of: Var, n: Int }| {
      let v = { ..x.of, id: k.next };
      {
        incs: k.incs.push(Let({ var: v, val: retain(x.of), at: dummy_span(), unwind: [] })).concat(
          increments(v, x.n - 1),
        ),
        renames: k.renames.insert(x.of.id, v),
        next: k.next + 1,
      }
    },
  );
  let acc = { ..at, next: kept.next };
  let inst = renamed(given, kept.renames);
  let tail = dead.concat(p.after).reverse().fold(acc, |b: BackwardState, v: Var|
    release_var(ex, b, v));
  let followed = then.reverse().fold(tail.rev, |r: List<Inst>, n: Inst| r.push(n));
  let put = {
    ..tail,
    rev: followed.push(inst),
    // A token held across a stop is freed where its frame links a record, as a body abandoned
    // there would never free it, so the cells reach the taker only where nothing can stop.
    takers: if nests(inst) { [] } else { taking(tail.takers, inst, followed.len()) },
  };
  let freed = p.before.reverse().fold(put, |b: BackwardState, v: Var| release_var(ex, b, v));
  {
    ..freed,
    rev: p.incs.concat(kept.incs).reverse().fold(freed.rev, |r: List<Inst>, n: Inst| r.push(n)),
    live: p.live,
  }
}

fn nests(i: Inst) -> Bool =
  match i {
    If(_) -> true,
    Case(_) -> true,
    Match(_) -> true,
    Loop(_) -> true,
    Handle(_) -> true,
    _ -> false,
  }

/// A leaving instruction: what it hands on consumed, `after` what stays held past it.
fn ended_back(
  facts: Facts,
  ex: Exits,
  acc: BackwardState,
  inst: Inst,
  ops: List<Operand>,
  after: Live,
) -> BackwardState =
  with_counts(ex, { ..acc, takers: [] }, planned(facts, ops, after), inst, [], [])

fn all_taken(args: List<Arg>) -> List<Operand> = args.map(|a: Arg| { arg: a, takes: true })

/// `args` handed to parameters taken as `handed`: one lent is only read, as it was handed in.
fn handed_as(args: List<Arg>, handed: List<ParamOwnership>) -> List<Operand> =
  range(0, args.len()).fold([], |acc: List<Operand>, i: Int|
    match args.at(i) {
      Some(a) -> acc.push({ arg: a, takes: handed.at(i) != Some(BorrowedParam) }),
      None -> acc,
    })

/// A branch placed, the `Allocate`s its arms reach from their heads as what a value let go of before it
/// may reuse, and those after it where a token can be carried through it.
fn branched(
  acc: BackwardState,
  inst: Inst,
  live: Live,
  next: Int,
  takers: List<ReuseCandidate>,
) -> BackwardState =
  {
    rev: acc.rev.push(inst),
    live: live,
    next: next,
    takers: if carries([inst]) { takers.concat(acc.takers) } else { takers },
  }

/// Whether a reuse token can be carried through `b`: no loop or handle, which hold what they
/// read across passes and landings.
fn carries(b: Block) -> Bool =
  b.all(|i: Inst|
    match i {
      If(x) -> carries(x.then) && carries(x.otherwise),
      Case(c) -> carries(c.rest) && c.arms.all(|a: { when: Int, body: Block }| carries(a.body)),
      Match(m) -> carries(m.rest) && m.arms.all(carries),
      Loop(_) -> false,
      Handle(_) -> false,
      _ -> true,
    })

/// `takers` an arm reaches, as reached from before the branch at `at`, through arm `arm`.
fn stepped(takers: List<ReuseCandidate>, at: Int, arm: Int) -> List<ReuseCandidate> =
  takers.map(|t: ReuseCandidate| { ..t, route: [{ at: at, arm: arm }].concat(t.route) })

/// A branch's block, opened by letting go of what `held` holds that it does not read, and the
/// `Allocate`s still reached from its head.
fn entered(
  facts: Facts,
  ex: Exits,
  w: BackwardState,
  held: Live,
) -> { block: Block, next: Int, takers: List<ReuseCandidate> } = {
  let gone = held.values().filter(|v: Var| owns(facts, v) && !w.live.contains(v.id));
  let b = gone.reverse().fold(w, |acc: BackwardState, v: Var| release_var(ex, acc, v));
  { block: b.rev.reverse(), next: b.next, takers: b.takers }
}

/// `takers` with `inst` among them where it takes cells.
fn taking(takers: List<ReuseCandidate>, inst: Inst, at: Int) -> List<ReuseCandidate> =
  match inst {
    Let(l) -> match l.val {
      Allocate(m) -> if takes_cells(l.var, m.made, m.reuse) {
        takers.push({ at: at, route: [], made: m.made })
      } else { takers },
      _ -> takers,
    },
    _ -> takers,
  }

/// Whether `v` bound to a `Allocate` of `made` reusing `reuse` takes the cells of a box let go of before
/// it where they fit: it makes a block of words afresh. A record the runtime lays out is made by
/// value, and takes none.
fn takes_cells(v: Var, made: Allocation, reuse: Option<Var>) -> Bool =
  reuse == None && v.representation == AsWord && reuses_cells(made) && allocation_words(made) > 0

/// Whether the ownership pass may reset anything in `f`'s body, its tail group's arms among it: some
/// `Allocate` there takes cells. Its closures' bodies are counted as roots of their own.
pub fn may_reuse(f: Fn) -> Bool = reuses_within(f.body)

fn reuses_within(b: Block) -> Bool =
  b.fold(false, |any: Bool, i: Inst|
    any
      || (match i {
        Let(l) -> match l.val { Allocate(m) -> takes_cells(l.var, m.made, m.reuse), _ -> false },
        If(x) -> reuses_within(x.then) || reuses_within(x.otherwise),
        Case(c) ->
          c.arms.fold(reuses_within(c.rest), |a: Bool, arm: { when: Int, body: Block }|
            a || reuses_within(arm.body)),
        Match(m) ->
          m.arms.fold(reuses_within(m.rest), |a: Bool, arm: Block| a || reuses_within(arm)),
        Loop(l) -> reuses_within(l.body),
        Handle(h) -> reuses_within(h.body),
        _ -> false,
      }))

/// Where `t` is first reached in the block it was found from: its own place, or the branch it is in.
fn first_at(t: ReuseCandidate) -> Int = match t.route.at(0) { Some(s) -> s.at, None -> t.at }

/// The place of the nearest of `takers`: the one first reached from the block's head.
fn nearest(takers: List<ReuseCandidate>) -> Option<Int> =
  takers.fold(None, |best: Option<Int>, t: ReuseCandidate|
    match best {
      Some(b) -> if first_at(t) > b { Some(first_at(t)) } else { best },
      None -> Some(first_at(t)),
    })

/// `v` let go of: where it is a sum known to hold a boxed case and `Allocate`s below take cells of that
/// box's size (the nearest, or in each arm of the nearest branch that makes one, the arms that make
/// none freeing it), opened into its box, which is reset into a token they take; else released.
fn release_var(ex: Exits, b: BackwardState, v: Var) -> BackwardState = {
  let released = { ..b, rev: b.rev.push(Dec(v)) };
  match boxed_known(ex, v) {
    None -> released,
    Some(r) -> {
      let fitting = b.takers.filter(|t: ReuseCandidate| fits(r, t));
      match nearest(fitting) {
        None -> released,
        Some(at) -> {
          let chosen = fitting.filter(|t: ReuseCandidate| first_at(t) == at);
          let made = match chosen.at(0) { Some(t) -> t.made, None -> ListAllocation(0) };
          let box = { id: b.next, ty: v.ty, representation: r };
          let token = token_of(b.next + 1, box, made);
          {
            ..b,
            rev: taken_in(b.rev.reverse(), chosen, token).reverse().push(
              Reset({ token: token, of: box }),
            ).push(
              Destructure({ of: v, words: [box] }),
            ),
            next: b.next + 2,
            takers: b.takers.filter(|x: ReuseCandidate| !chosen.contains(x)),
          }
        },
      }
    },
  }
}

/// The box a sum of one word `v` holds where the case arm around knows it to hold a boxed case:
/// that case alone, boxed at its word.
fn boxed_known(ex: Exits, v: Var) -> Option<Representation> =
  match v.representation {
    AsSum(s) -> if s.layout.classes.len() != 1 { None } else {
      match ex.known.get(v.id) {
        Some(name) -> match range(0, s.cases.len()).find(|k: Int| s.cases.at(k) == Some(name)) {
          Some(k) -> boxed_case_of(v.representation, k),
          None -> None,
        },
        None -> None,
      }
    },
    _ -> None,
  }

/// The words of the block a sum boxed alone, as `boxed_case_of` holds it, has: its tag's and its
/// payload's.
fn box_words(r: Representation) -> Int =
  match r {
    AsSum(s) -> match s.layout.cases.at(0) {
      Some(c) -> match c.payload { Boxed(x) -> x.skip + layout::words(x.layout), _ -> 0 },
      None -> 0,
    },
    _ -> 0,
  }

/// The token numbered `id` holding `of`'s cells for `made`, a block of as many payload words.
fn token_of(id: Int, of: Var, made: Allocation) -> Var =
  { id: id, ty: of.ty, representation: AsReuseToken(allocation_words(made)) }

/// Whether `t` may take the cells of a box held as `r`: a boxed case of as many words.
fn fits(r: Representation, t: ReuseCandidate) -> Bool =
  (match t.made { CaseAllocation(_) -> true, _ -> false })
    && allocation_words(t.made) == box_words(r)

/// `block` with the nearest of `takers` taking `token`, and every instruction before it that can
/// fail releasing it. A taker's place counts from the block's end.
fn taken_in(block: Block, takers: List<ReuseCandidate>, token: Var) -> Block =
  match nearest(takers) {
    None -> block,
    Some(at) -> {
      let here = takers.filter(|t: ReuseCandidate| first_at(t) == at);
      let last = block.len() - 1;
      block.fold({ k: 0, out: [] }, |s: { k: Int, out: List<Inst> }, i: Inst|
        {
          k: s.k + 1,
          out: s.out.push(if last - s.k == at { taking_at(i, here, token) }
          else if last - s.k > at { held_across(i, token) }
          else { i }),
        }).out
    },
  }

/// `i` taking `token`: the `Allocate` it is, or in each arm of the branch it is, the nearest `Allocate`
/// `takers` names there, an arm with none freeing it.
fn taking_at(i: Inst, takers: List<ReuseCandidate>, token: Var) -> Inst =
  if takers.any(|t: ReuseCandidate| t.route.len() == 0) { taken_by(i, token) } else {
    match i {
      If(x) ->
        If({
          ..x,
          then: arm_taking(x.then, 0, takers, token),
          otherwise: arm_taking(x.otherwise, 1, takers, token),
        }),
      Case(c) ->
        Case({
          ..c,
          arms: c.arms.fold(
            [],
            |arms: List<{ when: Int, body: Block }>, a: { when: Int, body: Block }|
              arms.push({ when: a.when, body: arm_taking(a.body, arms.len(), takers, token) }),
          ),
          rest: arm_taking(c.rest, c.arms.len(), takers, token),
        }),
      _ -> i,
    }
  }

/// Arm `arm`'s block taking `token` where `takers` reach a `Allocate` in it, else freeing it first.
fn arm_taking(block: Block, arm: Int, takers: List<ReuseCandidate>, token: Var) -> Block = {
  let inner = takers.fold([], |acc: List<ReuseCandidate>, t: ReuseCandidate|
    match t.route.at(0) {
      Some(s) -> if s.arm == arm { acc.push({ ..t, route: t.route.drop(1) }) } else { acc },
      None -> acc,
    });
  if inner.len() == 0 { [freed(token)].concat(block) } else { taken_in(block, inner, token) }
}

/// `token`'s cells given back: the whole block, its header among it.
fn freed(token: Var) -> Inst =
  Free({
    of: token,
    bytes: IntOperand(
      header_bytes() + 8 * (match token.representation { AsReuseToken(n) -> n, _ -> 0 }),
    ),
  })

fn taken_by(i: Inst, token: Var) -> Inst =
  match i {
    Let(l) -> match l.val {
      Allocate(m) -> Let({ ..l, val: Allocate({ ..m, reuse: Some(token) }) }),
      _ -> i,
    },
    _ -> i,
  }

fn held_across(i: Inst, token: Var) -> Inst = carry_token(i, token, false)

/// `i`, between a reset and the `Allocate` its token goes to, carrying the token: each instruction that
/// can fail releasing it, and in a branch's arms, each way out of the body freeing it first. A miss
/// keeps it where the match it leaves for its next arm (`matched`) is carried too.
fn carry_token(i: Inst, token: Var, matched: Bool) -> Inst =
  match i {
    Let(l) -> if may_leave(l.val) { Let({ ..l, unwind: l.unwind.push(token) }) } else { i },
    Do(d) -> if may_leave(d.val) { Do({ ..d, unwind: d.unwind.push(token) }) } else { i },
    If(x) ->
      If({
        ..x,
        then: carry_token_in(x.then, token, matched),
        otherwise: carry_token_in(x.otherwise, token, matched),
      }),
    Case(c) ->
      Case({
        ..c,
        arms: c.arms.map(|a: { when: Int, body: Block }|
          { when: a.when, body: carry_token_in(a.body, token, matched) }),
        rest: carry_token_in(c.rest, token, matched),
      }),
    Match(m) ->
      Match({
        arms: m.arms.map(|a: Block| carry_token_in(a, token, true)),
        rest: carry_token_in(m.rest, token, matched),
      }),
    _ -> i,
  }

fn carry_token_in(b: Block, token: Var, matched: Bool) -> Block =
  b.fold([], |out: List<Inst>, i: Inst|
    if leaves_with(i, matched) { out.push(freed(token)).push(i) }
    else { out.push(carry_token(i, token, matched)) })

/// Whether `i` leaves where a carried token is held: the body or a loop's pass, or the match a miss
/// leaves for the next arm of, where that match is not carried.
fn leaves_with(i: Inst, matched: Bool) -> Bool = match i { Miss -> !matched, _ -> is_terminator(i) }

/// An `Option` of a pointer as M2 lays it: one word, `None` its zero.
fn maybe_word() -> Representation =
  AsSum({
    layout: {
      classes: [Pointer],
      cases: [
        { test: WordIs({ at: 0, value: 0 }), payload: Nullary },
        {
          test: WordOutside({ at: 0, values: [0] }),
          payload: Inline({ offset: 0, layout: PlainWords([Pointer]), stripped: None }),
        },
      ],
    },
    cases: [none_ctor(), some_ctor()],
  })

fn of_type(id: Int, ty: Bytes) -> Var =
  { id: id, ty: NamedType({ name: ty, args: [] }), representation: AsWord }

fn word(id: Int) -> Var = of_type(id, b"String")

fn flag(id: Int) -> Var = { id: id, ty: bool_type(), representation: AsBool }

/// A root over `params`, each given unless `lent` names it, answering as `answer`.
fn root_of(params: List<Var>, lent: List<Int>, answer: Representation, body: Block) -> Fn =
  {
    key: Named(b"m.f"),
    kind: Metered,
    params: params,
    convention: {
      params: lent_where(params.map(|p: Var| p.representation), lent),
      result: answer,
      destination_passing: false,
      answered: OwnedResult,
    },
    result_type: NamedType({ name: b"T", args: [] }),
    body: body,
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  }

/// A call of `m.g` handing `args`, each given unless `lent` names it, answering a word.
fn call_of(args: List<Arg>, lent: List<Int>) -> Rvalue =
  Call({
    callee: Root(Named(b"m.g")),
    args: args,
    convention: {
      params: lent_where(args.map(operand_representation), lent),
      result: AsWord,
      destination_passing: false,
      answered: OwnedResult,
    },
    suspends: false,
  })

fn bind(v: Var, val: Rvalue, unwind: List<Var>) -> Inst =
  Let({ var: v, val: val, at: dummy_span(), unwind: unwind })

/// What the pass makes of `f`'s body, and why the check refuses the result, if it does.
fn counted_body(f: Fn) -> { body: Block, refused: Option<Bytes> } = {
  let o = insert_reference_counts(f);
  { body: o.body, refused: ownership_fault(o) }
}

/// `f` with `body`, as the check reads it.
fn refused_with(f: Fn, body: Block) -> Option<Bytes> = ownership_fault({ ..f, body: body })

test "a word read as the box it is views its words, taking nothing, and a leaf is read out of the word" {
  let scalars = AsFlattened([
    { name: b"h", representation: AsFloat },
    { name: b"w", representation: AsInt },
  ]);
  let p = word(0);
  let x = { id: 1, ty: p.ty, representation: scalars };
  let viewed = bind(x, Convert({ arg: VarOperand(p), to: scalars }), []);
  let leaf = bind({ id: 3, ty: p.ty, representation: AsInt }, Get({ of: x, path: LeafPath(1) }), [
  ]);
  // Neither a word the body holds nor one it is lent is counted to be viewed.
  let held = root_of([p], [], AsWord, [viewed, leaf, Return(VarOperand(p))]);
  assert_eq(counted_body(held), { body: [viewed, leaf, Return(VarOperand(p))], refused: None });
  let lent = root_of([p], [0], AsInt, [viewed, leaf, Return(IntOperand(0))]);
  assert_eq(counted_body(lent), { body: [viewed, leaf, Return(IntOperand(0))], refused: None });
  // A view nothing reads is not made.
  assert_eq(counted_body(root_of([p], [], AsWord, [viewed, Return(VarOperand(p))])).body, [
    Return(VarOperand(p)),
  ]);
  // A leaf of a lent word's view is the word's to hand back borrowed, as a field read off it is.
  let named = AsFlattened([
    { name: b"data", representation: AsInt },
    { name: b"name", representation: AsWord },
  ]);
  let r = { id: 1, ty: p.ty, representation: named };
  let s = { id: 2, ty: p.ty, representation: AsWord };
  let reader = root_of([p], [0], AsWord, [
    bind(r, Convert({ arg: VarOperand(p), to: named }), []),
    bind(s, Get({ of: r, path: LeafPath(1) }), []),
    Return(VarOperand(s)),
  ]);
  assert_eq(
    counted_body({
      ..reader,
      convention: { ..reader.convention, answered: BorrowedResult([{ param: 0, whole: false }]) },
    }).refused,
    None,
  )
}

test "a value consumed again later takes a count first, and its last use moves" {
  let p = word(0);
  let r = word(1);
  let s = word(2);
  let f = root_of([p], [], AsWord, [
    bind(r, call_of([VarOperand(p)], []), []),
    bind(s, call_of([VarOperand(p), VarOperand(r)], []), []),
    Return(VarOperand(s)),
  ]);
  let counts = [
    Inc({ var: p, n: 1 }),
    bind(r, call_of([VarOperand(p)], []), [p]),
    bind(s, call_of([VarOperand(p), VarOperand(r)], []), []),
    Return(VarOperand(s)),
  ];
  assert_eq(counted_body(f), { body: counts, refused: None });
  // The first call can fail holding the count the second call takes, which its path releases.
  assert_eq(
    refused_with(f, counts.set(1, bind(r, call_of([VarOperand(p)], []), []))),
    Some(b"a failure path that releases other than what it holds"),
  )
}

test "a value one instruction both consumes and reads takes a count for the consuming use, and dies after it" {
  let p = word(0);
  let q = word(1);
  let r = word(2);
  let both = call_of([VarOperand(p), VarOperand(p)], [1]);
  assert_eq(counted_body(root_of([p], [], AsWord, [bind(r, both, []), Return(VarOperand(r))])), {
    body: [Inc({ var: p, n: 1 }), bind(r, both, [p]), Dec(p), Return(VarOperand(r))],
    refused: None,
  });
  // A restart hands on what it passes and lets go of the rest first.
  assert_eq(counted_body(root_of([p, q], [], AsWord, [Restart([VarOperand(p), VarOperand(p)])])), {
    body: [Dec(q), Inc({ var: p, n: 1 }), Restart([VarOperand(p), VarOperand(p)])],
    refused: None,
  })
}

test "a function value applied is lent to the call, held across each and let go of after the last" {
  let f = word(0);
  let x = word(1);
  let r = word(2);
  let r2 = word(3);
  let applied = |arg: Var|
    Apply({
      f: VarOperand(f),
      args: [VarOperand(arg)],
      convention: {
        params: [{ handed: OwnedParam, representation: AsWord }],
        result: AsWord,
        destination_passing: false,
        answered: OwnedResult,
      },
      suspends: false,
      closure: None,
    });
  assert_eq(
    counted_body(
      root_of([f, x], [], AsWord, [
        bind(r, applied(x), []),
        bind(r2, applied(r), []),
        Return(VarOperand(r2)),
      ]),
    ),
    {
      body: [bind(r, applied(x), [f]), bind(r2, applied(r), [f]), Dec(f), Return(VarOperand(r2))],
      refused: None,
    },
  )
}

test "a closure laid on this frame's stack reads its captures, which are let go of after the call" {
  let cap = word(0);
  let c = word(1);
  let r = word(2);
  let laid = |unwind: List<Var>|
    bind(
      c,
      Allocate({
        made: StackAllocation(ClosureAllocation({ nth: 0, captures: 1, params: 1 })),
        args: [VarOperand(cap)],
        reuse: None,
      }),
      unwind,
    );
  let f = root_of([cap], [], AsWord, [
    laid([]),
    bind(r, call_of([VarOperand(c)], []), []),
    Return(VarOperand(r)),
  ]);
  assert_eq(counted_body(f), {
    body: [laid([]), bind(r, call_of([VarOperand(c)], []), [cap]), Dec(cap), Return(VarOperand(r))],
    refused: None,
  });
  // Handed on whole, the closure would outlive the frame it lies on.
  assert_eq(
    refused_with(f, [laid([]), Return(VarOperand(c))]),
    Some(b"a closure on this frame's stack handed beyond the call it is lent to: v1"),
  )
}

test "the closures a root makes are counted as roots of their own" {
  let p = word(0);
  let q = word(1);
  let lambda = { ..root_of([p, q], [], AsWord, [Return(VarOperand(q))]), key: Named(b"m.f#0") };
  let closure = |body: Fn|
    Closure({ body: body, captures: 0, at: dummy_span(), words: no_closure_evidence() });
  let f = { ..root_of([], [], AsInt, [Return(IntOperand(0))]), lambdas: [closure(lambda)] };
  let o = insert_reference_counts(f);
  assert_eq(o.lambdas, [closure({ ..lambda, body: [Dec(p), Return(VarOperand(q))] })]);
  assert_eq(ownership_fault(o), None);
  assert_eq(ownership_fault(f), Some(b"in closure 0: a count left held where the body answers: v0"))
}

test "an owned value nothing reads is let go of where it is made, an unread parameter at the head" {
  let p = word(0);
  let q = word(1);
  let r = word(2);
  let f = root_of([p, q], [], AsInt, [
    bind(r, call_of([VarOperand(q)], []), []),
    Return(IntOperand(0)),
  ]);
  let counts = [Dec(p), bind(r, call_of([VarOperand(q)], []), []), Dec(r), Return(IntOperand(0))];
  assert_eq(counted_body(f), { body: counts, refused: None });
  // Without its release the answer's count is never let go of.
  assert_eq(
    refused_with(f, counts.remove_at(2)),
    Some(b"a count left held where the body answers: v2"),
  )
}

test "a branch lets go first of what only the other branch reads" {
  let c = flag(0);
  let p = word(1);
  let q = word(2);
  let f = root_of([c, p, q], [], AsWord, [
    If({ cond: VarOperand(c), then: [Return(VarOperand(p))], otherwise: [Return(VarOperand(q))] }),
  ]);
  let branch = |then: List<Inst>|
    [If({ cond: VarOperand(c), then: then, otherwise: [Dec(p), Return(VarOperand(q))] })];
  assert_eq(counted_body(f), { body: branch([Dec(q), Return(VarOperand(p))]), refused: None });
  // Letting go twice of one count.
  assert_eq(
    refused_with(f, branch([Dec(q), Dec(q), Return(VarOperand(p))])),
    Some(b"a value consumed with no count left: v2"),
  )
}

test "a record held in place is never taken out of its block, however its reader is held" {
  let inner = RecordType([{ name: b"a", ty: int_type() }, { name: b"s", ty: string_type() }]);
  let r = {
    id: 0,
    ty: RecordType([{ name: b"in", ty: inner }, { name: b"t", ty: string_type() }]),
    representation: AsWord,
  };
  let x = { id: 1, ty: inner, representation: AsWord };
  let get = bind(x, Get({ of: r, path: FieldPath({ name: b"in", at: 0 }) }), []);
  // Handed on, it is kept: copied out where it is a place, counted where it is a box.
  let k = { ..x, id: 2 };
  assert_eq(counted_body(root_of([r], [], AsWord, [get, Return(VarOperand(x))])), {
    body: [get, bind(k, retain(x), []), Dec(r), Return(VarOperand(k))],
    refused: None,
  });
  // A field held as its word beside it is taken.
  let y = word(1);
  let t = bind(y, Get({ of: r, path: FieldPath({ name: b"t", at: 4 }) }), []);
  assert_eq(counted_body(root_of([r], [], AsWord, [t, Return(VarOperand(y))])), {
    body: [
      bind(y, Take({ of: r, path: FieldPath({ name: b"t", at: 4 }) }), []),
      Dec(r),
      Return(VarOperand(y)),
    ],
    refused: None,
  })
}

test "a field of a sum's payload, the sum read out of a record, keeps the record held until it is read" {
  let t = of_type(0, b"m.T");
  let o = { id: 1, ty: option_type(named_type(b"m.C")), representation: maybe_word() };
  let c = of_type(2, b"m.C");
  let b = word(3);
  let r = word(4);
  let reads = [
    bind(c, Get({ of: o, path: CasePath({ case: 1, at: 0 }) }), []),
    bind(b, Get({ of: c, path: FieldPath({ name: b"binder", at: 0 }) }), []),
  ];
  let cased = |arm: List<Inst>, rest: List<Inst>|
    [
      bind(o, Get({ of: t, path: FieldPath({ name: b"cases", at: 1 }) }), []),
      Case({
        on: o,
        test: TagTest([none_ctor(), some_ctor()]),
        arms: [{ when: 1, body: reads.concat(arm) }],
        rest: rest.push(Return(ZeroOperand(AsWord))),
      }),
    ];
  let f = root_of(
    [t],
    [],
    AsWord,
    cased([bind(r, call_of([VarOperand(b)], [0]), []), Return(VarOperand(r))], []),
  );
  assert_eq(counted_body(f), {
    body: cased([bind(r, call_of([VarOperand(b)], [0]), [t]), Dec(t), Return(VarOperand(r))], [
      Dec(t),
    ]),
    refused: None,
  });
  // The record let go of before the payload's field is read.
  assert_eq(
    refused_with(
      f,
      cased([Dec(t), bind(r, call_of([VarOperand(b)], [0]), []), Return(VarOperand(r))], [Dec(t)]),
    ),
    Some(b"a value read after what it was read out of was let go: v3"),
  )
}

test "a value read out of a value read out of another keeps the first one live" {
  let p = word(0);
  let y = word(1);
  let z = word(2);
  let r = word(3);
  let reads = [
    bind(y, Get({ of: p, path: FieldPath({ name: b"a", at: 0 }) }), []),
    bind(z, Get({ of: y, path: FieldPath({ name: b"b", at: 0 }) }), []),
  ];
  let f = root_of(
    [p],
    [],
    AsWord,
    reads.concat([bind(r, call_of([VarOperand(z)], [0]), []), Return(VarOperand(r))]),
  );
  assert_eq(counted_body(f), {
    body: reads.concat([
      bind(r, call_of([VarOperand(z)], [0]), [p]),
      Dec(p),
      Return(VarOperand(r)),
    ]),
    refused: None,
  });
  assert_eq(
    refused_with(
      f,
      reads.concat([Dec(p), bind(r, call_of([VarOperand(z)], [0]), []), Return(VarOperand(r))]),
    ),
    Some(b"a value read after what it was read out of was let go: v2"),
  )
}

test "an address into a block's bytes keeps the block held until it is read through, and takes no count" {
  let b = word(0);
  let a = { ..int(1), representation: AsAddress };
  let n = int(2);
  let r = word(3);
  let addressed = bind(a, Get({ of: b, path: PayloadPath }), []);
  let byte = bind(
    n,
    Op({
      op: OfStrings(ByteRead),
      args: [VarOperand(a), IntOperand(0)],
      uses: string_signature(ByteRead),
    }),
    [],
  );
  assert_eq(counted_body(root_of([b], [], AsInt, [addressed, byte, Return(VarOperand(n))])), {
    body: [addressed, byte, Dec(b), Return(VarOperand(n))],
    refused: None,
  });
  // Handed on before it is read through, the block is counted once more to outlive the read.
  let handed = counted_body(
    root_of([b], [], AsInt, [
      addressed,
      bind(r, call_of([VarOperand(b)], []), []),
      byte,
      Return(VarOperand(n)),
    ]),
  );
  assert_eq(handed.refused, None);
  assert_eq([Inc({ var: b, n: 1 }), Dec(b)].map(|i: Inst| handed.body.contains(i)), [true, true])
}

test "a value read out of another keeps that one live until its last read" {
  let p = word(0);
  let x = word(1);
  let r = word(2);
  let get = bind(x, Get({ of: p, path: FieldPath({ name: b"f", at: 0 }) }), []);
  let read = root_of([p], [], AsWord, [
    get,
    bind(r, call_of([VarOperand(x)], [0]), []),
    Return(VarOperand(r)),
  ]);
  let counts = [get, bind(r, call_of([VarOperand(x)], [0]), [p]), Dec(p), Return(VarOperand(r))];
  assert_eq(counted_body(read), { body: counts, refused: None });
  // The record let go of before the read of its field.
  assert_eq(
    refused_with(read, [
      get,
      Dec(p),
      bind(r, call_of([VarOperand(x)], [0]), []),
      Return(VarOperand(r)),
    ]),
    Some(b"a value read after what it was read out of was let go: v1"),
  );
  // A field handed on is taken out of the record, which then holds no count of it.
  let take = bind(x, Take({ of: p, path: FieldPath({ name: b"f", at: 0 }) }), []);
  assert_eq(counted_body(root_of([p], [], AsWord, [get, Return(VarOperand(x))])), {
    body: [take, Dec(p), Return(VarOperand(x))],
    refused: None,
  });
  // A record handed on whole too keeps its field, which the field's reader then counts again.
  let c = flag(3);
  let both = |then: List<Inst>, otherwise: List<Inst>|
    [
      get,
      If({
        cond: VarOperand(c),
        then: then.push(Return(VarOperand(p))),
        otherwise: otherwise.push(Return(VarOperand(x))),
      }),
    ];
  assert_eq(counted_body(root_of([p, c], [], AsWord, both([], []))), {
    body: both([], [Inc({ var: x, n: 1 }), Dec(p)]),
    refused: None,
  })
}

/// A list of `m.Nil`, the zero word, and `m.Cons`, a box of two words.
fn boxed_list() -> Representation =
  AsSum({
    layout: {
      classes: [Pointer],
      cases: [
        { test: WordIs({ at: 0, value: 0 }), payload: Nullary },
        {
          test: WordOutside({ at: 0, values: [0] }),
          payload: Boxed({
            at: 0,
            stripped: false,
            skip: 0,
            layout: PlainWords([Pointer, Pointer]),
          }),
        },
      ],
    },
    cases: [b"m.Nil", b"m.Cons"],
  })

/// The box an `m.Cons` of `boxed_list` is held in, numbered `id`.
fn cons_box(id: Int) -> Var =
  {
    id: id,
    ty: of_type(0, b"m.L").ty,
    representation: match boxed_case_of(boxed_list(), 1) { Some(r) -> r, None -> AsWord },
  }

test "a value read out of a node, used past the case made in the node's box, takes a count of its own so the box is reused" {
  let t = { ..of_type(0, b"m.L"), representation: boxed_list() };
  let y = word(1);
  let n = of_type(2, b"m.L");
  let r = word(3);
  let box = cons_box(4);
  let token = { id: 5, ty: t.ty, representation: AsReuseToken(2) };
  let read = bind(y, Get({ of: t, path: CasePath({ case: 1, at: 1 }) }), []);
  let made = |reuse: Option<Var>|
    bind(
      n,
      Allocate({
        made: CaseAllocation({ case: 1, skip: 0, words: 2 }),
        args: [IntOperand(1), IntOperand(2)],
        reuse: reuse,
      }),
      [],
    );
  let on = |arm: List<Inst>, rest: List<Inst>|
    [
      Case({
        on: t,
        test: TagTest([b"m.Nil", b"m.Cons"]),
        arms: [{ when: 1, body: arm }],
        rest: rest.push(Return(ZeroOperand(AsWord))),
      }),
    ];
  let f = root_of(
    [t],
    [],
    AsWord,
    on([read, made(None), bind(r, call_of([VarOperand(y)], [0]), []), Return(VarOperand(n))], []),
  );
  assert_eq(counted_body(f), {
    body: on(
      [
        read,
        Inc({ var: y, n: 1 }),
        Destructure({ of: t, words: [box] }),
        Reset({ token: token, of: box }),
        made(Some(token)),
        bind(r, call_of([VarOperand(y)], [0]), [n, y]),
        Dec(r),
        Dec(y),
        Return(VarOperand(n)),
      ],
      [Dec(t)],
    ),
    refused: None,
  })
}

test "a value read out of another, used past the other's last use where that use consumes it, takes a count of its own where it is bound" {
  let p = word(0);
  let y = word(1);
  let r = word(2);
  let s = word(3);
  let read = bind(y, Get({ of: p, path: FieldPath({ name: b"f", at: 0 }) }), []);
  let after = |lent: List<Int>|
    root_of([p], [], AsWord, [
      read,
      bind(r, call_of([VarOperand(p)], lent), []),
      bind(s, call_of([VarOperand(r), VarOperand(y)], [1]), []),
      Return(VarOperand(s)),
    ]);
  // The record moves into the first call; the field read out of it is counted where it is read.
  assert_eq(counted_body(after([])), {
    body: [
      read,
      Inc({ var: y, n: 1 }),
      bind(r, call_of([VarOperand(p)], []), [y]),
      bind(s, call_of([VarOperand(r), VarOperand(y)], [1]), [y]),
      Dec(y),
      Return(VarOperand(s)),
    ],
    refused: None,
  });
  // Only lent to the first call, the record is held until the field's last read.
  assert_eq(counted_body(after([0])), {
    body: [
      read,
      bind(r, call_of([VarOperand(p)], [0]), [p]),
      bind(s, call_of([VarOperand(r), VarOperand(y)], [1]), [p]),
      Dec(p),
      Return(VarOperand(s)),
    ],
    refused: None,
  })
}

test "a join is set from a value held as the join is, on every path" {
  let c = flag(0);
  let p = word(1);
  let q = word(2);
  let j = word(3);
  let f = root_of([c, p, q], [], AsWord, [
    Decl(j),
    If({
      cond: VarOperand(c),
      then: [Assign({ var: j, arg: VarOperand(p) })],
      otherwise: [Assign({ var: j, arg: VarOperand(q) })],
    }),
    Return(VarOperand(j)),
  ]);
  let joined = |then: List<Inst>|
    [
      Decl(j),
      If({
        cond: VarOperand(c),
        then: [Dec(q)].concat(then),
        otherwise: [Dec(p), Assign({ var: j, arg: VarOperand(q) })],
      }),
      Return(VarOperand(j)),
    ];
  assert_eq(counted_body(f), {
    body: joined([Assign({ var: j, arg: VarOperand(p) })]),
    refused: None,
  });
  let x = { id: 4, ty: float_type(), representation: AsFloat };
  let sum = Primitive({ op: b"add", on: AsFloat, args: [FloatOperand(0), FloatOperand(0)] });
  assert_eq(
    refused_with(f, joined([bind(x, sum, []), Assign({ var: j, arg: VarOperand(x) })])),
    Some(b"a join set from a value held otherwise: v3"),
  )
}

test "a word read out of a sum whose case lays it as its one counted word holds the sum's count, which moves on with it" {
  let laid = |classes: List<WordClass>|
    AsSum({
      layout: {
        classes: classes,
        cases: [
          {
            test: Always,
            payload: Inline({ offset: 0, layout: PlainWords(classes), stripped: None }),
          },
        ],
      },
      cases: [b"m.T"],
    });
  let t = { ..of_type(0, b"m.T"), representation: laid([Pointer, layout::raw()]) };
  let out = word(1);
  let n = int(2);
  let reads = [
    bind(out, Get({ of: t, path: CasePath({ case: 0, at: 0 }) }), []),
    bind(n, Get({ of: t, path: CasePath({ case: 0, at: 1 }) }), []),
  ];
  assert_eq(counted_body(root_of([t], [], AsWord, reads.push(Return(VarOperand(out))))), {
    body: reads.push(Return(VarOperand(out))),
    refused: None,
  });
  // Where the case lays two counted words, a read moves its word out of the sum this body holds, and
  // the sum's release lets go of the other.
  let u = { ..t, representation: laid([Pointer, Pointer]) };
  let at_first = CasePath({ case: 0, at: 0 });
  assert_eq(
    counted_body(
      root_of([u], [], AsWord, [
        bind(out, Get({ of: u, path: at_first }), []),
        Return(VarOperand(out)),
      ]),
    ),
    {
      body: [bind(out, Take({ of: u, path: at_first }), []), Dec(u), Return(VarOperand(out))],
      refused: None,
    },
  );
  // A word of the box a case holds is taken out of the box where the sum is held only here.
  let boxed = AsSum({
    layout: {
      classes: [Pointer],
      cases: [
        {
          test: Always,
          payload: Boxed({
            at: 0,
            stripped: false,
            skip: 0,
            layout: PlainWords([Pointer, Pointer]),
          }),
        },
      ],
    },
    cases: [b"m.B"],
  });
  let b = { ..of_type(0, b"m.B"), representation: boxed };
  let read = |val: Rvalue| bind(out, val, []);
  assert_eq(
    counted_body(
      root_of([b], [], AsWord, [
        read(Get({ of: b, path: CasePath({ case: 0, at: 1 }) })),
        Return(VarOperand(out)),
      ]),
    ),
    {
      body: [
        read(Take({ of: b, path: CasePath({ case: 0, at: 1 }) })),
        Dec(b),
        Return(VarOperand(out)),
      ],
      refused: None,
    },
  )
}

test "a value that holds no count, a static or a case gathered from constants, is given, returned, joined and stored with none" {
  let c = flag(0);
  let p = word(1);
  let s = word(2);
  let r = word(3);
  let q = word(4);
  let j = word(5);
  let none = {
    id: 6,
    ty: option_type(string_type()),
    representation: AsSum({
      layout: layout::sum_layout([
        { args: layout::record_layout([]), indirect: false },
        { args: layout::record_layout([PlainWords([Pointer])]), indirect: false },
      ]),
      cases: [none_ctor(), some_ctor()],
    }),
  };
  let lit = bind(s, Static(b"ply_k_0"), []);
  let unchanged = |f: Fn| assert_eq(counted_body(f), { body: f.body, refused: None });
  // Given to two calls, the second taking the first's answer too.
  unchanged(
    root_of([], [], AsWord, [
      lit,
      bind(r, call_of([VarOperand(s)], []), []),
      bind(q, call_of([VarOperand(s), VarOperand(r)], []), []),
      Return(VarOperand(q)),
    ]),
  );
  // Returned.
  unchanged(root_of([], [], AsWord, [lit, Return(VarOperand(s))]));
  // Stored twice in what a body makes.
  unchanged(
    root_of([], [], AsWord, [
      lit,
      bind(
        q,
        Allocate({
          made: CaseAllocation({ case: 0, skip: 0, words: 2 }),
          args: [VarOperand(s), VarOperand(s)],
          reuse: None,
        }),
        [],
      ),
      Return(VarOperand(q)),
    ]),
  );
  // A join set from it on one path and from a given parameter on the other holds the parameter's
  // count, and on the static's path it holds the static, which needs none; the parameter is let go of
  // where the path does not read it. Set beside only borrowed values, the join is borrowed, read out
  // of nothing for the static.
  assert_eq(
    counted_body(
      root_of([c, p], [], AsWord, [
        lit,
        Decl(j),
        If({
          cond: VarOperand(c),
          then: [Assign({ var: j, arg: VarOperand(s) })],
          otherwise: [Assign({ var: j, arg: VarOperand(p) })],
        }),
        Return(VarOperand(j)),
      ]),
    ),
    {
      body: [
        lit,
        Decl(j),
        If({
          cond: VarOperand(c),
          then: [Dec(p), Assign({ var: j, arg: VarOperand(s) })],
          otherwise: [Assign({ var: j, arg: VarOperand(p) })],
        }),
        Return(VarOperand(j)),
      ],
      refused: None,
    },
  );
  let lent = root_of([c, p], [1], AsWord, [
    lit,
    Decl(j),
    If({
      cond: VarOperand(c),
      then: [Assign({ var: j, arg: VarOperand(s) })],
      otherwise: [Assign({ var: j, arg: VarOperand(p) })],
    }),
    Return(VarOperand(j)),
  ]);
  unchanged({
    ..lent,
    convention: { ..lent.convention, answered: BorrowedResult([{ param: 1, whole: true }]) },
  });
  // A `None` gathered from its constant word, given twice.
  unchanged(
    root_of([], [], AsWord, [
      bind(none, Aggregate({ parts: [IntOperand(0)] }), []),
      bind(r, call_of([VarOperand(none), VarOperand(none)], []), []),
      Return(VarOperand(r)),
    ]),
  )
}

test "a join set from a value read out of one bound inside its branch holds a count of its own" {
  let c = flag(0);
  let p = word(1);
  let s = word(2);
  let t = word(3);
  let r = of_type(4, b"m.T");
  let y = word(5);
  let z = word(6);
  let j = word(7);
  let field = FieldPath({ name: b"f", at: 0 });
  // The field is read twice, so it is not taken out of `r`.
  let read = [
    bind(r, call_of([VarOperand(p)], [0]), []),
    bind(y, Get({ of: r, path: field }), []),
    bind(z, Get({ of: r, path: field }), []),
  ];
  let joined = |then: Block|
    counted_body(
      root_of([c, p], [1], AsWord, [
        Decl(j),
        If({
          cond: VarOperand(c),
          then: then,
          otherwise: read.push(Assign({ var: j, arg: VarOperand(y) })),
        }),
        Return(VarOperand(j)),
      ]),
    );
  let after = |then: Block|
    [
      Decl(j),
      If({
        cond: VarOperand(c),
        then: then,
        otherwise: read.concat([
          Inc({ var: y, n: 1 }),
          Dec(r),
          Assign({ var: j, arg: VarOperand(y) }),
        ]),
      }),
      Return(VarOperand(j)),
    ];
  // Beside a static or a read out of a lent parameter, either of which outlives the branch.
  let lit = [bind(s, Static(b"ply_k_0"), []), Assign({ var: j, arg: VarOperand(s) })];
  assert_eq(joined(lit), { body: after(lit), refused: None });
  let lent = [bind(t, Get({ of: p, path: field }), []), Assign({ var: j, arg: VarOperand(t) })];
  assert_eq(joined(lent), {
    body: after([
      bind(t, Get({ of: p, path: field }), []),
      Inc({ var: t, n: 1 }),
      Assign({ var: j, arg: VarOperand(t) }),
    ]),
    refused: None,
  })
}

test "an answer handed back borrowed takes no count, and a join of borrowed values is borrowed of each" {
  let p = word(0);
  let y = word(1);
  let read = bind(y, Get({ of: p, path: FieldPath({ name: b"f", at: 0 }) }), []);
  let getter = |answered: ResultOwnership| {
    let f = root_of([p], [0], AsWord, [read, Return(VarOperand(y))]);
    { ..f, convention: { ..f.convention, answered: answered } }
  };
  assert_eq(counted_body(getter(BorrowedResult([{ param: 0, whole: false }]))), {
    body: [read, Return(VarOperand(y))],
    refused: None,
  });
  assert_eq(counted_body(getter(OwnedResult)), {
    body: [read, Inc({ var: y, n: 1 }), Return(VarOperand(y))],
    refused: None,
  });
  let c = flag(2);
  let q = word(3);
  let j = word(4);
  let set = |x: Var| [Assign({ var: j, arg: VarOperand(x) })];
  let branch = If({ cond: VarOperand(c), then: set(p), otherwise: set(q) });
  let pick = |answered: ResultOwnership| {
    let f = root_of([c, p, q], [1, 2], AsWord, [Decl(j), branch, Return(VarOperand(j))]);
    { ..f, convention: { ..f.convention, answered: answered } }
  };
  assert_eq(
    counted_body(pick(BorrowedResult([{ param: 1, whole: true }, { param: 2, whole: true }]))),
    { body: [Decl(j), branch, Return(VarOperand(j))], refused: None },
  );
  // Answered owned, the join takes one count where it is handed back, not one on each path.
  assert_eq(counted_body(pick(OwnedResult)), {
    body: [Decl(j), branch, Inc({ var: j, n: 1 }), Return(VarOperand(j))],
    refused: None,
  });
  // A value held again as an `Option`'s word, packed or gathered, is borrowed as the value is.
  let o = { id: 5, ty: option_type(string_type()), representation: maybe_word() };
  let some = |val: Rvalue, answered: ResultOwnership| {
    let f = root_of([p], [0], maybe_word(), [bind(o, val, []), Return(VarOperand(o))]);
    { ..f, convention: { ..f.convention, answered: answered } }
  };
  [
    Convert({ arg: VarOperand(p), to: maybe_word() }),
    Aggregate({ parts: [IntOperand(1), VarOperand(p)] }),
  ].fold((), |_: Unit, val: Rvalue| {
    assert_eq(counted_body(some(val, BorrowedResult([{ param: 0, whole: true }]))), {
      body: [bind(o, val, []), Return(VarOperand(o))],
      refused: None,
    });
    assert_eq(counted_body(some(val, OwnedResult)), {
      body: [bind(o, val, []), Inc({ var: o, n: 1 }), Return(VarOperand(o))],
      refused: None,
    })
  });
  // A case gathered from no counted word holds nothing, so either path answers borrowed.
  let none = { ..o, id: 6 };
  let either = { ..o, id: 7 };
  let maybe = If({
    cond: VarOperand(c),
    then: [
      bind(o, Aggregate({ parts: [IntOperand(1), VarOperand(p)] }), []),
      Assign({ var: either, arg: VarOperand(o) }),
    ],
    otherwise: [
      bind(none, Aggregate({ parts: [IntOperand(0)] }), []),
      Assign({ var: either, arg: VarOperand(none) }),
    ],
  });
  let found = root_of([c, p], [0, 1], maybe_word(), [
    Decl(either),
    maybe,
    Return(VarOperand(either)),
  ]);
  assert_eq(
    counted_body({
      ..found,
      convention: { ..found.convention, answered: BorrowedResult([{ param: 1, whole: true }]) },
    }),
    { body: [Decl(either), maybe, Return(VarOperand(either))], refused: None },
  )
}

test "a sum's payload that is its one count, held again as another sum's word, is borrowed as the sum is" {
  let text = string_type();
  let opt = |inner: Type| option_type(inner);
  let m = { id: 0, ty: opt(text), representation: maybe_word() };
  let s = word(1);
  let y = { id: 2, ty: opt(text), representation: maybe_word() };
  let some_of = |of: Var| bind(s, Get({ of: of, path: CasePath({ case: 1, at: 0 }) }), []);
  let answering = |p: Var, body: Block, answered: ResultOwnership| {
    let f = root_of([p], [0], maybe_word(), body);
    { ..f, convention: { ..f.convention, answered: answered } }
  };
  let whole = BorrowedResult([{ param: 0, whole: true }]);
  // `Some(x) -> Some(x)`, packed or gathered.
  [
    Convert({ arg: VarOperand(s), to: maybe_word() }),
    Aggregate({ parts: [IntOperand(1), VarOperand(s)] }),
  ].fold((), |_: Unit, val: Rvalue| {
    let body = [some_of(m), bind(y, val, []), Return(VarOperand(y))];
    assert_eq(counted_body(answering(m, body, whole)), { body: body, refused: None });
    assert_eq(counted_body(answering(m, body, OwnedResult)), {
      body: [some_of(m), bind(y, val, []), Inc({ var: y, n: 1 }), Return(VarOperand(y))],
      refused: None,
    })
  });
  let again = bind(y, Aggregate({ parts: [IntOperand(1), VarOperand(s)] }), []);
  // `Some(V(x)) -> Some(x)`: a payload's payload is the outer sum's count.
  let v = NamedType({ name: b"m.V", args: [] });
  let n = { id: 0, ty: opt(v), representation: maybe_word() };
  let inner = {
    id: 3,
    ty: v,
    representation: AsSum({
      layout: {
        classes: [Pointer],
        cases: [
          {
            test: Always,
            payload: Inline({ offset: 0, layout: PlainWords([Pointer]), stripped: None }),
          },
        ],
      },
      cases: [b"m.V"],
    }),
  };
  let nested = [
    bind(inner, Get({ of: n, path: CasePath({ case: 1, at: 0 }) }), []),
    bind(s, Get({ of: inner, path: CasePath({ case: 0, at: 0 }) }), []),
    again,
    Return(VarOperand(y)),
  ];
  assert_eq(counted_body(answering(n, nested, whole)), { body: nested, refused: None });
  // `match r.f { Some(x) -> Some(x) }`: the sum read out of what the root is lent.
  let r = word(0);
  let f = { ..m, id: 3 };
  let field = [
    bind(f, Get({ of: r, path: FieldPath({ name: b"f", at: 0 }) }), []),
    some_of(f),
    again,
    Return(VarOperand(y)),
  ];
  assert_eq(counted_body(answering(r, field, BorrowedResult([{ param: 0, whole: false }]))), {
    body: field,
    refused: None,
  })
}

test "a boxed case takes the cells of a sum let go of in an arm that knows it holds a box of as many words" {
  let list = AsSum({
    layout: {
      classes: [Pointer],
      cases: [
        { test: WordIs({ at: 0, value: 0 }), payload: Nullary },
        {
          test: WordOutside({ at: 0, values: [0] }),
          payload: Boxed({
            at: 0,
            stripped: false,
            skip: 0,
            layout: PlainWords([Pointer, Pointer]),
          }),
        },
      ],
    },
    cases: [b"m.Nil", b"m.Cons"],
  });
  let t = { ..of_type(0, b"m.L"), representation: list };
  let n = of_type(1, b"m.L");
  let made = |words: Int, reuse: Option<Var>|
    bind(
      n,
      Allocate({
        made: CaseAllocation({ case: 1, skip: 0, words: words }),
        args: [IntOperand(1), IntOperand(2)],
        reuse: reuse,
      }),
      [],
    );
  let on = |arm: List<Inst>, rest: List<Inst>|
    [
      Case({
        on: t,
        test: TagTest([b"m.Nil", b"m.Cons"]),
        arms: [{ when: 1, body: arm }],
        rest: rest.push(Return(ZeroOperand(AsWord))),
      }),
    ];
  let cased = |arm: List<Inst>| on(arm, [Dec(t)]);
  let f = |words: Int| root_of([t], [], AsWord, on([made(words, None), Return(VarOperand(n))], []));
  let box = {
    id: 2,
    ty: t.ty,
    representation: match boxed_case_of(list, 1) { Some(r) -> r, None -> AsWord },
  };
  let token = { id: 3, ty: t.ty, representation: AsReuseToken(2) };
  assert_eq(
    insert_reference_counts(f(2)).body,
    cased([
      Destructure({ of: t, words: [box] }),
      Reset({ token: token, of: box }),
      made(2, Some(token)),
      Return(VarOperand(n)),
    ]),
  );
  // A box of another size lays its words otherwise.
  assert_eq(
    insert_reference_counts(f(3)).body,
    cased([Dec(t), made(3, None), Return(VarOperand(n))]),
  )
}

test "a token held across a call that can fail or stop is released on its way out" {
  let r = { ..of_type(0, b"m.L"), representation: boxed_list() };
  let v = word(1);
  let a = word(2);
  let w = word(3);
  let n = of_type(4, b"m.L");
  let box = cons_box(5);
  let token = { id: 6, ty: r.ty, representation: AsReuseToken(2) };
  let get = bind(a, Get({ of: r, path: CasePath({ case: 1, at: 0 }) }), []);
  let take = bind(a, Take({ of: r, path: CasePath({ case: 1, at: 0 }) }), []);
  let make = |reuse: Option<Var>|
    Allocate({
      made: CaseAllocation({ case: 1, skip: 0, words: 2 }),
      args: [VarOperand(w), VarOperand(v)],
      reuse: reuse,
    });
  let called = |stops: Bool|
    match call_of([VarOperand(a)], []) {
      Call(c) -> Call({ ..c, suspends: stops }),
      other -> other,
    };
  let consed = |arm: List<Inst>, rest: List<Inst>|
    [
      Case({
        on: r,
        test: TagTest([b"m.Nil", b"m.Cons"]),
        arms: [{ when: 1, body: arm }],
        rest: rest.push(Return(VarOperand(v))),
      }),
    ];
  let f = |stops: Bool|
    root_of(
      [r, v],
      [],
      AsWord,
      consed([get, bind(w, called(stops), []), bind(n, make(None), []), Return(VarOperand(n))], []),
    );
  let counts = |stops: Bool, unwind: List<Var>|
    consed(
      [
        take,
        Destructure({ of: r, words: [box] }),
        Reset({ token: token, of: box }),
        bind(w, called(stops), unwind),
        bind(n, make(Some(token)), []),
        Return(VarOperand(n)),
      ],
      [Dec(r)],
    );
  assert_eq(counted_body(f(false)), { body: counts(false, [v, token]), refused: None });
  assert_eq(
    refused_with(f(false), counts(false, [v])),
    Some(b"a failure path that releases other than what it holds"),
  );
  // Across a call that may stop the token is held as across one that fails: the frame record that
  // holds the path frees it, as a body abandoned at the stop would never free it, and the make
  // allocates.
  assert_eq(counted_body(f(true)), { body: counts(true, [v, token]), refused: None })
}

test "a value that may stop but cannot fail names what the path holds, which its frame record holds" {
  let p = word(0);
  let y = word(1);
  let stop = Native({
    name: b"m.yield",
    args: [],
    uses: { takes: [], owned: true, fails: false, suspends: true },
  });
  assert_eq(counted_body(root_of([p], [], AsWord, [bind(y, stop, []), Return(VarOperand(p))])), {
    body: [bind(y, stop, [p]), Dec(y), Return(VarOperand(p))],
    refused: None,
  })
}

test "an arm lets go before it misses of what only it reads" {
  let p = word(0);
  let q = word(1);
  let matched = |then: List<Inst>, miss: List<Inst>|
    [
      Match({
        arms: [
          [If({ cond: BoolOperand(true), then: then, otherwise: miss })],
          [Return(VarOperand(q))],
        ],
        rest: [Fail({ reason: NoMatchingArm, at: dummy_span(), letting: [], unwind: [] })],
      }),
    ];
  let f = root_of([p, q], [], AsWord, matched([Return(VarOperand(p))], [Miss]));
  assert_eq(counted_body(f), {
    body: matched([Dec(q), Return(VarOperand(p))], [Dec(p), Miss]),
    refused: None,
  });
  assert_eq(
    refused_with(f, matched([Dec(q), Return(VarOperand(p))], [Miss])),
    Some(b"a count left held where the body answers: v0"),
  )
}

test "an arm lets go before a miss however deep of what it read with a count of its own" {
  let xs = word(0);
  let q = word(1);
  let x = word(2);
  let y = word(3);
  let item = |of: Var|
    Native({
      name: b"rt_list_at_p",
      args: [VarOperand(of), IntOperand(0)],
      uses: { takes: [false, false], owned: true, fails: false, suspends: false },
    });
  let cased = |on: Var, arm: List<Inst>, rest: List<Inst>|
    Case({ on: on, test: LengthTest({ at_least: 1 }), arms: [{ when: 0, body: arm }], rest: rest });
  let matched = |first: List<Inst>|
    [
      Match({
        arms: [first, [Return(VarOperand(xs))]],
        rest: [Fail({ reason: NoMatchingArm, at: dummy_span(), letting: [], unwind: [] })],
      }),
    ];
  let f = root_of(
    [xs, q],
    [],
    AsWord,
    matched([
      bind(x, item(xs), []),
      cased(x, [bind(y, item(x), []), cased(y, [Return(VarOperand(q))], [Miss])], [Miss]),
    ]),
  );
  assert_eq(counted_body(f), {
    body: matched([
      bind(x, item(xs), []),
      cased(
        x,
        [
          bind(y, item(x), []),
          Dec(x),
          cased(y, [Dec(xs), Dec(y), Return(VarOperand(q))], [Dec(q), Dec(y), Miss]),
        ],
        [Dec(q), Dec(x), Miss],
      ),
    ]),
    refused: None,
  })
}

test "a sum let go of before a branch lends its box to the arms that make a case of its size" {
  let r = { ..of_type(0, b"m.L"), representation: boxed_list() };
  let c = flag(1);
  let v = word(2);
  let n = of_type(3, b"m.L");
  let box = cons_box(4);
  let token = { id: 5, ty: r.ty, representation: AsReuseToken(2) };
  let make = |reuse: Option<Var>|
    bind(
      n,
      Allocate({
        made: CaseAllocation({ case: 1, skip: 0, words: 2 }),
        args: [IntOperand(1), VarOperand(v)],
        reuse: reuse,
      }),
      [],
    );
  let branch = |then: Inst, otherwise: List<Inst>|
    If({
      cond: VarOperand(c),
      then: [then, Return(VarOperand(n))],
      otherwise: otherwise.push(Return(VarOperand(v))),
    });
  let consed = |arm: List<Inst>, rest: List<Inst>|
    [
      Case({
        on: r,
        test: TagTest([b"m.Nil", b"m.Cons"]),
        arms: [{ when: 1, body: arm }],
        rest: rest.push(Return(VarOperand(v))),
      }),
    ];
  let f = root_of([r, c, v], [], AsWord, consed([branch(make(None), [])], []));
  let free = Free({ of: token, bytes: IntOperand(24) });
  let counts = |otherwise: List<Inst>|
    consed(
      [
        Destructure({ of: r, words: [box] }),
        Reset({ token: token, of: box }),
        branch(make(Some(token)), otherwise),
      ],
      [Dec(r)],
    );
  // The arm that makes none frees the cells.
  assert_eq(counted_body(f), { body: counts([free]), refused: None });
  assert_eq(refused_with(f, counts([])), Some(b"a count left held where the body answers: v5"))
}

test "a sum let go of before a branch lends its box to a case made after it, carried through the branch" {
  let r = { ..of_type(0, b"m.L"), representation: boxed_list() };
  let c = flag(1);
  let v = word(2);
  let n = of_type(3, b"m.L");
  let w = word(4);
  let box = cons_box(5);
  let token = { id: 6, ty: r.ty, representation: AsReuseToken(2) };
  let make = |reuse: Option<Var>|
    bind(
      n,
      Allocate({
        made: CaseAllocation({ case: 1, skip: 0, words: 2 }),
        args: [IntOperand(1), VarOperand(v)],
        reuse: reuse,
      }),
      [],
    );
  let branch = |then: List<Inst>, otherwise: List<Inst>|
    If({ cond: VarOperand(c), then: then.push(Return(VarOperand(v))), otherwise: otherwise });
  let consed = |arm: List<Inst>, rest: List<Inst>|
    [
      Case({
        on: r,
        test: TagTest([b"m.Nil", b"m.Cons"]),
        arms: [{ when: 1, body: arm.push(Return(VarOperand(n))) }],
        rest: rest.push(Return(VarOperand(v))),
      }),
    ];
  let f = root_of(
    [r, c, v],
    [],
    AsWord,
    consed([branch([], [bind(w, call_of([], []), [])]), make(None)], []),
  );
  let counts = |then: List<Inst>, unwind: List<Var>|
    consed(
      [
        Destructure({ of: r, words: [box] }),
        Reset({ token: token, of: box }),
        branch(then, [bind(w, call_of([], []), unwind), Dec(w)]),
        make(Some(token)),
      ],
      [Dec(r)],
    );
  let free = Free({ of: token, bytes: IntOperand(24) });
  // The arm that leaves the body frees the cells first; the call that can fail releases them on its
  // failure path.
  assert_eq(counted_body(f), { body: counts([free], [v, token]), refused: None });
  assert_eq(
    refused_with(f, counts([], [v, token])),
    Some(b"a count left held where the body answers: v6"),
  );
  assert_eq(
    refused_with(f, counts([free], [v])),
    Some(b"a failure path that releases other than what it holds"),
  )
}

test "a loop holds what its body reads across its passes, and lets it go after" {
  let p = word(0);
  let q = word(1);
  let s = word(2);
  let c = flag(3);
  let n = word(4);
  let a = word(5);
  let cond = bind(c, Primitive({ op: b"eq", on: AsInt, args: [IntOperand(1), IntOperand(2)] }), []);
  let looped = |pass: List<Inst>, after: List<Inst>|
    [
      Loop({
        state: [{ var: s, init: VarOperand(q) }],
        body: [
          cond,
          If({
            cond: VarOperand(c),
            then: [Done(VarOperand(s))],
            otherwise: pass.push(Next([VarOperand(n)])),
          }),
        ],
        result: a,
      }),
    ].concat(
      after,
    ).push(
      Return(VarOperand(a)),
    );
  let f = root_of(
    [p, q],
    [],
    AsWord,
    looped([bind(n, call_of([VarOperand(p), VarOperand(s)], []), [])], []),
  );
  assert_eq(counted_body(f), {
    body: looped(
      [Inc({ var: p, n: 1 }), bind(n, call_of([VarOperand(p), VarOperand(s)], []), [p])],
      [Dec(p)],
    ),
    refused: None,
  });
  // A pass that consumes the count the loop holds across its passes.
  assert_eq(
    refused_with(f, looped([bind(n, call_of([VarOperand(p), VarOperand(s)], []), [])], [Dec(p)])),
    Some(b"a count held otherwise than the loop holds where it passes again: v0"),
  )
}

test "a pass that leaves the root lets go first of what the loop holds across its passes" {
  let p = word(0);
  let q = word(1);
  let s = word(2);
  let c = flag(3);
  let n = word(4);
  let a = word(5);
  let cond = bind(c, Primitive({ op: b"eq", on: AsInt, args: [IntOperand(1), IntOperand(2)] }), []);
  let looped = |leaving: List<Inst>, unwind: List<Var>, after: List<Inst>|
    [
      Loop({
        state: [{ var: s, init: VarOperand(q) }],
        body: [
          cond,
          If({
            cond: VarOperand(c),
            then: leaving.push(Return(VarOperand(s))),
            otherwise: [
              bind(n, call_of([VarOperand(p), VarOperand(s)], [0]), unwind),
              Next([VarOperand(n)]),
            ],
          }),
        ],
        result: a,
      }),
    ].concat(
      after,
    ).push(
      Return(VarOperand(a)),
    );
  let f = root_of([p, q], [], AsWord, looped([], [], []));
  assert_eq(counted_body(f), { body: looped([Dec(p)], [p], [Dec(p)]), refused: None });
  assert_eq(
    refused_with(f, looped([], [p], [Dec(p)])),
    Some(b"a count left held where the body answers: v0"),
  )
}

test "a handle holds across its body what the body reads, which its landing releases" {
  let p = word(0);
  let r = word(1);
  let a = word(2);
  let c = flag(3);
  let site = { clauses: [], ret: None, detached: None, instance: empty_instance(0) };
  let uses = { takes: [], owned: false, fails: true, suspends: false };
  let inside = [
    If({
      cond: VarOperand(c),
      then: [Fail({ reason: NoMatchingArm, at: dummy_span(), letting: [], unwind: [] })],
      otherwise: [],
    }),
    bind(r, call_of([VarOperand(p)], [0]), []),
    Assign({ var: a, arg: VarOperand(r) }),
  ];
  let around = |unwind: List<Var>|
    Handle({ body: inside, args: [], uses: uses, site: site, result: a, unwind: unwind });
  let f = root_of([p, c], [], AsWord, [around([]), Return(VarOperand(a))]);
  assert_eq(counted_body(f), { body: [around([p]), Dec(p), Return(VarOperand(a))], refused: None });
  assert_eq(
    refused_with(f, [around([]), Dec(p), Return(VarOperand(a))]),
    Some(b"a handle whose landing releases other than what it holds across its body"),
  );
  // An answer nothing reads is let go of after the handle, where a clause's answer arrives too.
  assert_eq(counted_body(root_of([p, c], [], AsInt, [around([]), Return(IntOperand(0))])), {
    body: [around([p]), Dec(a), Dec(p), Return(IntOperand(0))],
    refused: None,
  });
  // A body run detached is a closure the handle reads: its landing releases it.
  let detached = |unwind: List<Var>|
    Handle({
      body: [],
      args: [VarOperand(p)],
      uses: { ..uses, takes: [false] },
      site: { ..site, detached: Some({ body: 0, forwards: 0 }) },
      result: a,
      unwind: unwind,
    });
  assert_eq(counted_body(root_of([p, c], [], AsWord, [detached([]), Return(VarOperand(a))])), {
    body: [detached([p]), Dec(p), Return(VarOperand(a))],
    refused: None,
  })
}

/// A record held flat whose fields `f0`, `f1`, .. are a `String` held as its word or, where `leaves`
/// says `AsInt`, an `Int`.
fn flat(id: Int, leaves: List<Representation>) -> Var =
  flat_of(id, leaves.map(|r: Representation| if r == AsInt { int(0) } else { word(0) }))

/// A record held flat whose fields `f0`, `f1`, .. are of the types of `fields` and held as they are.
fn flat_of(id: Int, fields: List<Var>) -> Var = {
  let named = |k: Int| b"f".concat(ascii_of_int(k));
  {
    id: id,
    ty: RecordType(
      range(0, fields.len()).map(|k: Int|
        { name: named(k), ty: match fields.at(k) { Some(v) -> v.ty, None -> int(0).ty } }),
    ),
    representation: AsFlattened(
      range(0, fields.len()).map(|k: Int|
        {
          name: named(k),
          representation: match fields.at(k) { Some(v) -> v.representation, None -> AsInt },
        }),
    ),
  }
}

fn int(id: Int) -> Var = { id: id, ty: int_type(), representation: AsInt }

fn leaf(v: Var, of: Var, k: Int) -> Inst = bind(v, Get({ of: of, path: LeafPath(k) }), [])

test "a flat parameter is opened into its parts, and a leaf consumed at its last use moves" {
  let s = flat(0, [AsWord, AsInt]);
  let c = flag(1);
  let y = word(2);
  let k = int(3);
  let r = word(4);
  let r2 = word(5);
  let words = [{ ..y, id: 6 }, { ..k, id: 7 }];
  let branch = |otherwise: List<Inst>|
    If({
      cond: VarOperand(c),
      then: [bind(r, call_of([VarOperand(s)], []), []), Return(VarOperand(r))],
      otherwise: otherwise.concat([
        bind(r2, call_of([VarOperand(y)], []), []),
        Return(VarOperand(r2)),
      ]),
    });
  let f = root_of([s, c], [], AsWord, [leaf(y, s, 0), leaf(k, s, 1), branch([])]);
  // The branch that hands the value on whole moves each word; the other moves the leaf it reads.
  assert_eq(counted_body(f), {
    body: [Destructure({ of: s, words: words }), leaf(y, s, 0), leaf(k, s, 1), branch([])],
    refused: None,
  });
  // Read out of otherwise than by a leaf, the value stays whole and the read takes a count.
  let field = bind(y, Get({ of: s, path: FieldPath({ name: b"f0", at: 0 }) }), []);
  assert_eq(counted_body(root_of([s], [], AsWord, [field, Return(VarOperand(y))])), {
    body: [field, Inc({ var: y, n: 1 }), Dec(s), Return(VarOperand(y))],
    refused: None,
  })
}

test "a read out of an opened leaf keeps the leaf's word held until it is read" {
  let x = of_type(1, b"m.Shape");
  let s = flat_of(0, [x, int(0)]);
  let name = word(2);
  let r = word(3);
  let w0 = { ..x, id: 4 };
  let words = [w0, int(5)];
  let named = bind(name, Get({ of: x, path: ArgumentPath({ ctor: b"Circle", at: 0 }) }), []);
  let cased = |arm: List<Inst>, rest: List<Inst>|
    Case({
      on: x,
      test: TagTest([b"Circle", b"Square"]),
      arms: [{ when: 0, body: [named].concat(arm) }],
      rest: rest.push(Return(ZeroOperand(AsWord))),
    });
  let f = root_of([s], [], AsWord, [
    leaf(x, s, 0),
    cased([bind(r, call_of([VarOperand(name)], [0]), []), Return(VarOperand(r))], []),
  ]);
  assert_eq(counted_body(f), {
    body: [
      Destructure({ of: s, words: words }),
      leaf(x, s, 0),
      cased([bind(r, call_of([VarOperand(name)], [0]), [w0]), Dec(w0), Return(VarOperand(r))], [
        Dec(w0),
      ]),
    ],
    refused: None,
  })
}

test "a lent parameter handed back to a restart is only read" {
  let p = word(0);
  let f = word(1);
  assert_eq(
    counted_body(root_of([p, f], [1], AsWord, [Restart([VarOperand(p), VarOperand(f)])])),
    { body: [Restart([VarOperand(p), VarOperand(f)])], refused: None },
  );
  // A value this body holds, lent to the body started again, would die under it.
  assert_eq(
    refused_with(root_of([p, f], [1], AsWord, []), [
      Inc({ var: f, n: 1 }),
      Restart([VarOperand(f), VarOperand(p)]),
    ]),
    Some(b"a value lent to a body started again that does not outlast it: v0"),
  )
}

test "a flat value made in the body is opened where it is made, and a word nothing reads is let go" {
  let a = word(0);
  let b = word(1);
  let s = flat(2, [AsWord, AsWord]);
  let y = word(3);
  let r = word(4);
  let made = bind(s, Aggregate({ parts: [VarOperand(a), VarOperand(b)] }), []);
  let f = root_of([a, b], [], AsWord, [
    made,
    leaf(y, s, 1),
    bind(r, call_of([VarOperand(y)], []), []),
    Return(VarOperand(r)),
  ]);
  let w0 = word(5);
  let w1 = { ..y, id: 6 };
  assert_eq(counted_body(f), {
    body: [
      made,
      Destructure({ of: s, words: [w0, w1] }),
      Dec(w0),
      leaf(y, s, 1),
      bind(r, call_of([VarOperand(y)], []), []),
      Return(VarOperand(r)),
    ],
    refused: None,
  });
  // The leaf read again after the call takes a count for the call, and its word dies after the read.
  let twice = root_of([a, b], [], AsWord, [
    made,
    leaf(y, s, 1),
    bind(r, call_of([VarOperand(y), VarOperand(y)], [1]), []),
    Return(VarOperand(r)),
  ]);
  assert_eq(counted_body(twice), {
    body: [
      made,
      Destructure({ of: s, words: [w0, w1] }),
      Dec(w0),
      leaf(y, s, 1),
      Inc({ var: w1, n: 1 }),
      bind(r, call_of([VarOperand(y), VarOperand(y)], [1]), [w1]),
      Dec(w1),
      Return(VarOperand(r)),
    ],
    refused: None,
  })
}

test "a loop's flat state is opened at the head of each pass, so a leaf consumed in the pass moves" {
  let p = flat(0, [AsWord, AsInt]);
  let s = flat(1, [AsWord, AsInt]);
  let y = word(2);
  let k = int(3);
  let c = flag(4);
  let z = word(5);
  let s2 = flat(6, [AsWord, AsInt]);
  let a = word(7);
  let state = [{ ..y, id: 10 }, { ..k, id: 11 }];
  let looped = |head: List<Inst>, made: List<Inst>|
    Loop({
      state: [{ var: s, init: VarOperand(p) }],
      body: head.concat([
        leaf(y, s, 0),
        leaf(k, s, 1),
        bind(c, Primitive({ op: b"eq", on: AsInt, args: [VarOperand(k), IntOperand(0)] }), []),
        If({
          cond: VarOperand(c),
          then: [Done(VarOperand(y))],
          otherwise: [
            bind(z, call_of([VarOperand(y)], []), []),
            bind(s2, Aggregate({ parts: [VarOperand(z), VarOperand(k)] }), []),
          ].concat(
            made,
          ).push(
            Next([VarOperand(s2)]),
          ),
        }),
      ]),
      result: a,
    });
  let f = root_of([p], [], AsWord, [looped([], []), Return(VarOperand(a))]);
  // The buffer read out of the state is handed on with no count taken.
  assert_eq(counted_body(f), {
    body: [
      Destructure({ of: p, words: [word(8), int(9)] }),
      looped([Destructure({ of: s, words: state })], [
        Destructure({ of: s2, words: [word(12), int(13)] }),
      ]),
      Return(VarOperand(a)),
    ],
    refused: None,
  })
}

test "a handle inside another's body releases at its landing only what the outer one does not" {
  let p = word(0);
  let r = word(1);
  let a = word(2);
  let t = word(3);
  let b = word(4);
  let s = word(5);
  let site = { clauses: [], ret: None, detached: None, instance: empty_instance(0) };
  let uses = { takes: [], owned: false, fails: true, suspends: false };
  let inner = |unwind: List<Var>|
    Handle({
      body: [bind(r, call_of([VarOperand(p)], [0]), []), Assign({ var: b, arg: VarOperand(r) })],
      args: [],
      uses: uses,
      site: site,
      result: b,
      unwind: unwind,
    });
  let outer = |inner_unwind: List<Var>, unwind: List<Var>|
    Handle({
      body: [
        bind(t, call_of([VarOperand(p)], [0]), []),
        inner(inner_unwind),
        bind(s, call_of([VarOperand(t), VarOperand(b)], []), []),
        Assign({ var: a, arg: VarOperand(s) }),
      ],
      args: [],
      uses: uses,
      site: site,
      result: a,
      unwind: unwind,
    });
  let f = root_of([p], [], AsWord, [outer([], []), Return(VarOperand(a))]);
  assert_eq(counted_body(f), {
    body: [outer([t], [p]), Dec(p), Return(VarOperand(a))],
    refused: None,
  });
  // The inner landing leaves to the outer one, which releases `p`: releasing it at both lets it go twice.
  assert_eq(
    refused_with(f, [outer([t, p], [p]), Dec(p), Return(VarOperand(a))]),
    Some(b"a handle whose landing releases other than what it holds across its body"),
  )
}

test "the words of a flat value are typed by its fields" {
  let p = word(0);
  let s = flat(1, [AsWord, AsWord]);
  let f = root_of([p], [], AsWord, [
    bind(s, Aggregate({ parts: [VarOperand(p), VarOperand(p)] }), []),
    leaf(word(2), s, 0),
    leaf(word(3), s, 1),
    Return(VarOperand(p)),
  ]);
  assert_eq(match facts_of(f).opened.get(1) { Some(ws) -> ws.map(|w: Var| w.ty), None -> [] }, [
    word(2).ty,
    word(3).ty,
  ])
}

test "a field read once in each arm of a branch is taken in each, and in neither where it is read before" {
  let o = word(0);
  let c = flag(1);
  let p = word(2);
  let at = FieldPath({ name: b"f", at: 0 });
  let branch = |read: Rvalue|
    If({
      cond: VarOperand(c),
      then: [bind(word(3), read, []), Return(VarOperand(word(3)))],
      otherwise: [
        bind(word(4), read, []),
        bind(word(5), call_of([VarOperand(word(4))], []), []),
        Return(VarOperand(p)),
      ],
    });
  let f = |before: List<Inst>|
    root_of([o, c, p], [], AsWord, before.push(branch(Get({ of: o, path: at }))));
  assert_eq(insert_takes(f([])).body, [branch(Take({ of: o, path: at }))]);
  let first = bind(word(6), Get({ of: o, path: at }), []);
  assert_eq(insert_takes(f([first])).body, [first, branch(Get({ of: o, path: at }))])
}

test "a field is taken out of a join only where the join holds a count, never out of one set from borrowed reads" {
  let o = word(0);
  let c = flag(1);
  let j = word(2);
  let set = |val: Rvalue, at: Int|
    [bind(word(at), val, []), Assign({ var: j, arg: VarOperand(word(at)) })];
  let f = |val: Rvalue|
    root_of([o, c], [0], AsWord, [
      Decl(j),
      If({ cond: VarOperand(c), then: set(val, 3), otherwise: set(val, 4) }),
      bind(word(5), Get({ of: j, path: FieldPath({ name: b"f", at: 0 }) }), []),
      bind(word(6), call_of([VarOperand(word(5))], []), []),
      Return(VarOperand(word(6))),
    ]);
  let taken = |g: Fn|
    insert_reference_counts(g).body.any(|i: Inst|
      match i { Let(l) -> match l.val { Take(_) -> true, _ -> false }, _ -> false });
  // Read out of a borrowed block, the join borrows it too, and holds no count to move a field out of.
  let read = f(Get({ of: o, path: FieldPath({ name: b"g", at: 1 }) }));
  assert(!taken(read), None);
  assert_eq(counted_body(read).refused, None);
  // Answered by a call, the join holds the count the call answered.
  let made = f(call_of([], []));
  assert(taken(made), None);
  assert_eq(counted_body(made).refused, None)
}
