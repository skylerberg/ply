//! The ownership pass: every count a root's typed form holds, placed by one walk from each block's
//! end (Perceus over Lean's λRC). An owned value is let go of where it dies: after the instruction
//! that last reads it, before the one that last consumes something read out of it, or at the head
//! of a branch that does not read it. A use that consumes a value still live after it takes an
//! `Inc` first; a last use moves. A value read out of another keeps that one live until its own
//! last read, but where the other's last use consumes it before then: the value read out of it then
//! takes a count of its own where it is bound, so the other moves. A sum let go of where the case
//! around knows it to hold a boxed case, whose box a later boxed case of as many words is made in,
//! in the arms of the branch that follows or after it, with no stop, loop or handle between, is
//! opened into that box, which is reset into a token the make takes; a way out of the body between
//! frees it.
//! A flat value made or handed in whole, a loop's state at each pass among them, is opened into its
//! parts where it is bound, each part then counted on its own, so a leaf read out and consumed at
//! its last use moves; a field handed on out of a block this body holds is taken out of it, so
//! its count moves where the block is held only here. Each instruction that can fail names the
//! owned values held across it, which its failure path releases.
//!
//! Every `Inc` stands right before the instruction whose use it pays for, so an operand consumed
//! with no `Inc` of it just before is moved: a reader tells a move from a copy by the instruction
//! before it.

import std.bytes (ascii_of_int)
import std.math (ilog2)
import std.pace (paced)
import check.types (Type, TyCon, TyRecord)
import emit.layout
import emit.layout (WordClass, header_bytes, P, Always, WordIs, WordOutside, Nullary, Inline, Boxed,
                    LWords)
import emit.lower.held (leaf_type)
import emit.lower.base (unread_packs_dropped)
import emit.release (boxed_case_of)
import emit.typing (unknown_type)
import syntax.parsing (dummy_span)
import emit.keys (Named, Root)
import emit.tir (Rep, RWord, RInt, RBool, RFloat, RFlat, RToken, RSum, MCase, Var, Arg, AVar, AInt,
                 ABool, AFloat, AZero, Val, Prim, Make, Get, Take, Pack, Call, Apply, Native,
                 Gathered, Updated, FieldSet, Path, PField, PArg, PLeaf, PNamed, PCase, Made,
                 MRecord, MList, MClosure, TLength, Inst, Let, Do, Decl, Assign, If, Case, Match,
                 Miss, Loop, Next, Done, Return, Restart, Enter, Fail, NoArm, Handle, Sited, Inc,
                 Dec, Reset, Free, Opened, Block, Fn, Member, Convention, Rooted, Lambda, Closure,
                 Handed, Given, Lent, Owned, Borrowed, Returned, Test, TTag, Owns, ReadsOf, Lasts,
                 Static, Op, OStrings, RAddr, PPayload, no_links, counted, operands, fails, used_as,
                 var_of, rep_of_arg, parts_of, ends, string_uses)
import emit.tir.strings (ByteRead)
import emit.verify (verified, stacked_captures, payload_of, field_path, held_in_place, reuses_cells,
                    made_width, re_held, leaves, answer_held, boxed_read, word_held, immortals,
                    points_into)

/// How a counted variable is held: a count of its own, or read without one out of the owned
/// variables `bases` names, each live while it is (none where nothing the body lets go of holds
/// it: a constant, a lent parameter).
type Held = | Own | ReadOf(List<Int>)

/// What the pass knows of a root's variables before it places counts: how each counted one is
/// held, each variable by number, what each `Get` read out of and where, what each variable read
/// out of another was read out of directly, which hold a count made where they are bound (a `Let`
/// of an owned answer, a given parameter, a loop's state), and the first free number. A flat value made or handed
/// in so is `opened` into words where it is bound, each part a variable counted on its own, and a
/// `Get` of one of its counted leaves is an `alias` of that word, as a payload read out of a sum
/// held as one word is of that sum. A closure laid on this frame's
/// stack `stacks` its captures: it holds no count of them, so a use of it reads each. A `promoted`
/// value read out of another takes a count of its own where it is bound. The `immortal` values hold
/// no count at all (`verify.immortals`, the set the check reads): none is taken or let go of them.
type Facts = {
  held: Map<Int, Held>,
  vars: Map<Int, Var>,
  gets: Map<Int, { of: Int, path: Path }>,
  direct: Map<Int, List<Int>>,
  made: Map<Int, Bool>,
  next: Int,
  opened: Map<Int, List<Var>>,
  alias: Map<Int, Var>,
  stacks: Map<Int, List<Var>>,
  promoted: Map<Int, Bool>,
  immortal: Map<Int, Bool>,
}

/// The counted variables live at a point, by number: each is read, consumed or let go of on some
/// path from there.
type Live = Map<Int, Var>

/// Where control leaves a block other than by its end, and what is live there: a loop's `Next`
/// and `Done` (what the loop holds across its passes), a match arm's `Miss` (the next arm's entry),
/// and a `Fail` (what an enclosing `handle` holds across its body, which a failure inside the body
/// leaves to the handle's landing). `known` is the constructor each variable a case arm tested
/// holds there. `restart` is how the body's own parameters are handed, which a `Restart` hands them
/// again, `enters` how each member of its tail group takes its own, and `answered` how the body
/// hands back its answer: one it borrows is only read.
type Exits = {
  looped: Option<Live>,
  miss: Live,
  landing: Live,
  known: Map<Int, Bytes>,
  restart: List<Handed>,
  enters: List<List<Handed>>,
  answered: Returned,
}

/// A `Make` the cells of a box let go of above it could go to: its place in the block it is in,
/// counted from that block's end; the branches on the way to that block, each by its place, so
/// counted, and the arm taken; and what it makes.
type Taker = { at: Int, route: List<{ at: Int, arm: Int }>, made: Made }

/// A block walked from its end back to a point: its instructions after the point, last first;
/// what is live at the point; the first free variable number; and the `Make`s reached from the
/// point, on its straight line or in the arms of the branch that ends it.
type Back = { rev: List<Inst>, live: Live, next: Int, takers: List<Taker> }

/// What one instruction's operands need: the `Inc`s before it, the owned values that die before
/// it and after it, and what is live before it.
type Plan = { incs: List<Inst>, before: List<Var>, after: List<Var>, live: Live }

type Operand = { arg: Arg, takes: Bool }

/// `f` and the closures it makes with every count placed. The form handed in holds none. A tail
/// group's arm `i` is counted as a body of its own holding member `i`'s parameters.
pub fn owned(given: Fn) -> Fn = {
  let f = took({ ..given, body: unread_packs_dropped(given.body) });
  let fx = facts_of(f);
  let top = {
    looped: None,
    miss: Map::new(),
    landing: Map::new(),
    known: Map::new(),
    restart: f.conv.params,
    enters: f.members.map(|m: Member| m.conv.params),
    answered: f.conv.answered,
  };
  let body = if f.members.len() == 0 {
    headed(fx, top, f.params, f.body, Map::new(), fx.next).block
  } else {
    match f.body {
      [Case(c)] -> {
        let arms = c.arms.fold(
          { arms: [], next: fx.next },
          |s: { arms: List<{ when: Int, body: Block }>, next: Int }, a: { when: Int, body: Block }| {
            let member = f.members.at(a.when);
            let h = headed(
              fx,
              match member {
                Some(m) -> { ..top, restart: m.conv.params, answered: m.conv.answered },
                None -> { ..top, restart: [] },
              },
              match member { Some(m) -> m.params, None -> [] },
              a.body,
              Map::new(),
              s.next,
            );
            { arms: s.arms.push({ when: a.when, body: h.block }), next: h.next }
          },
        );
        [
          Case({
            ..c,
            arms: arms.arms,
            rest: headed(fx, top, [], c.rest, Map::new(), arms.next).block,
          }),
        ]
      },
      _ -> headed(fx, top, f.params, f.body, Map::new(), fx.next).block,
    }
  };
  {
    ..f,
    body: body,
    lambdas: f.lambdas.map(|l: Lambda|
      match l { Closure(c) -> Closure({ ..c, body: owned(c.body) }) }),
  }
}

/// Body `b` with every count placed, `across` held through it and its `params` held at its head:
/// each flat one opened, each owned one nothing reads let go of there.
fn headed(
  fx: Facts,
  top: Exits,
  params: List<Var>,
  b: Block,
  across: Live,
  next: Int,
) -> { block: Block, next: Int } = {
  let back = walked_back(fx, top, b, across, next);
  let held = params.fold(across, |m: Live, p: Var|
    resolved(fx, p).fold(m, |n: Live, w: Var| if owns(fx, w) { n.insert(w.id, w) } else { n }));
  let opens = params.fold([], |acc: List<Inst>, p: Var|
    match fx.opened.get(p.id) { Some(ws) -> acc.push(Opened({ of: p, words: ws })), None -> acc });
  let e = entered(fx, top, back, held);
  { block: opens.concat(e.block), next: e.next }
}

/// What `took` reads off a body: each `Get` and the loop pass it runs in (`-1` outside any loop), the
/// variables used other than to read a field, test a constructor or be updated, those an operation
/// consumes, those holding a count made where they are bound, with the pass that binds them, how
/// often each block's field is read on the way through the body that reads it most, the reads of
/// each block on the way to where the walk stands, and the reads an update after them on their way
/// makes a record without writing their field.
type Sight = {
  gets: List<{ var: Var, of: Var, path: Path, pass: Int }>,
  whole: Map<Int, Bool>,
  handed: Map<Int, Bool>,
  bound: Map<Int, Int>,
  reads: Map<Int, Map<Path, Int>>,
  passed: Map<Int, List<{ id: Int, path: Path }>>,
  unwritten: Map<Int, Bool>,
}

/// `f` with a `Take` for each `Get` that is the one read, on any way through the body, of a counted
/// one-word field, not a record held in place, out of a block this body holds a count of as a word or
/// the box a sum's case holds, where the field is handed on: where the block is held only here, the
/// field's count moves to its reader instead of being taken again. The block must be used otherwise
/// only to read its other fields, test its constructor or be updated, past the read, with a new value
/// of that field, in the pass that bound it, so nothing reads the field after it is taken. Whether
/// the body holds the block's count is what `facts_of` says, as the counts are placed: a join set
/// only from borrowed reads holds none.
fn took(f: Fn) -> Fn = {
  let start = f.members.fold(
    given_bound(f.params, f.conv, Map::new()),
    |m: Map<Int, Int>, x: Member| given_bound(x.params, x.conv, m),
  );
  let s = sighted(
    {
      gets: [],
      whole: Map::new(),
      handed: Map::new(),
      bound: start,
      reads: Map::new(),
      passed: Map::new(),
      unwritten: Map::new(),
    },
    f.body,
    0 - 1,
  );
  let taking = s.gets.fold(
    Map::new(),
    |m: Map<Int, Var>, g: { var: Var, of: Var, path: Path, pass: Int }|
      if s.bound.get(g.of.id) == Some(g.pass)
          && ((g.of.rep == RWord && field_path(g.path)) || boxed_read(g.of.rep, g.path))
          && word_held(g.var.rep)
          && !held_in_place(g.of, g.path, g.var)
          && !s.whole.contains(g.of.id)
          && !s.unwritten.contains(g.var.id)
          && s.handed.contains(g.var.id)
          && (match s.reads.get(g.of.id) { Some(ps) -> ps.get(g.path), None -> None }) == Some(1) {
        m.insert(g.var.id, g.of)
      } else { m },
  );
  if taking.len() == 0 { f } else {
    let fx = facts_of(f);
    let held = taking.fold(Map::new(), |m: Map<Int, Bool>, id: Int, of: Var|
      if owns(fx, of) { m.insert(id, true) } else { m });
    if held.len() == 0 { f } else { { ..f, body: retaken(f.body, held) } }
  }
}

/// `s` past update `u`: each read of `u.of` on the way here whose field `u` does not write is one
/// a take would leave a hole in the record `u` makes.
fn updated_past(s: Sight, u: { of: Var, sets: List<FieldSet> }) -> Sight =
  match s.passed.get(u.of.id) {
    None -> s,
    Some(rs) ->
      {
        ..s,
        unwritten: rs.fold(s.unwritten, |m: Map<Int, Bool>, r: { id: Int, path: Path }|
          match r.path {
            PField(p) -> if u.sets.any(|x: FieldSet| x.at == p.at) { m }
            else { m.insert(r.id, true) },
            _ -> m.insert(r.id, true),
          }),
      },
  }

/// The reads on the way to after a branch: those on the way through `a` and those through `b`, both
/// walked from one start.
fn passed_joined(
  a: Map<Int, List<{ id: Int, path: Path }>>,
  b: Map<Int, List<{ id: Int, path: Path }>>,
) -> Map<Int, List<{ id: Int, path: Path }>> =
  b.fold(
    a,
    |m: Map<Int, List<{ id: Int, path: Path }>>, of: Int, rs: List<{ id: Int, path: Path }>| {
      let into = match m.get(of) { Some(x) -> x, None -> [] };
      m.insert(
        of,
        rs.fold(into, |acc: List<{ id: Int, path: Path }>, r: { id: Int, path: Path }|
          if acc.any(|x: { id: Int, path: Path }| x.id == r.id) { acc } else { acc.push(r) }),
      )
    },
  )

fn given_bound(params: List<Var>, conv: Convention, m: Map<Int, Int>) -> Map<Int, Int> =
  range(0, params.len()).fold(m, |acc: Map<Int, Int>, i: Int|
    match params.at(i) {
      Some(p) -> if conv.params.at(i) == Some(Lent) { acc } else { acc.insert(p.id, 0 - 1) },
      None -> acc,
    })

/// `r` counting one more read of block `of`'s field at `path`.
fn read_once_more(r: Map<Int, Map<Path, Int>>, of: Int, path: Path) -> Map<Int, Map<Path, Int>> = {
  let ps = match r.get(of) { Some(x) -> x, None -> Map::new() };
  r.insert(of, ps.insert(path, match ps.get(path) { Some(n) -> n + 1, None -> 1 }))
}

/// The reads of `a` and of `b`, field by field: those of one run after the other where `summed`, and
/// otherwise those of whichever reads it more. The smaller is walked into the larger, so reads nested
/// in branches are joined in time near their number.
fn reads_joined(
  a: Map<Int, Map<Path, Int>>,
  b: Map<Int, Map<Path, Int>>,
  summed: Bool,
) -> Map<Int, Map<Path, Int>> = {
  let a_smaller = a.len() < b.len();
  let small = if a_smaller { a } else { b };
  small.fold(
    if a_smaller { b } else { a },
    |m: Map<Int, Map<Path, Int>>, of: Int, ps: Map<Path, Int>| {
      let into = match m.get(of) { Some(x) -> x, None -> Map::new() };
      m.insert(
        of,
        ps.fold(into, |q: Map<Path, Int>, p: Path, n: Int|
          q.insert(p, match q.get(p) {
            Some(k) -> if summed { k + n } else if k > n { k } else { n },
            None -> n,
          })),
      )
    },
  )
}

/// `s` with what `b`, run in loop pass `pass`, reads, consumes and binds. The arms of an `If` or a
/// `Case` run one at a time, so a field read once in each is read once; a `Match`'s arm may miss to
/// the next after its reads.
fn sighted(s: Sight, b: Block, pass: Int) -> Sight =
  b.fold(s, |acc: Sight, i: Inst|
    match i {
      Let(l) -> {
        let read = match l.val {
          Get(g) ->
            {
              ..acc,
              gets: acc.gets.push({ var: l.var, of: g.of, path: g.path, pass: pass }),
              reads: read_once_more(acc.reads, g.of.id, g.path),
              passed: acc.passed.insert(
                g.of.id,
                (match acc.passed.get(g.of.id) { Some(rs) -> rs, None -> [] }).push({
                  id: l.var.id,
                  path: g.path,
                }),
              ),
            },
          // An update hands its record on, the fields it does not write read where they lie.
          Updated(u) -> {
            let sets = used_in(acc, u.sets.map(|x: FieldSet| { arg: x.arg, takes: true }));
            updated_past({ ..sets, handed: sets.handed.insert(u.of.id, true) }, u)
          },
          _ -> used_in(acc, operands(l.val)),
        };
        if answer_held(l.val) == Owns && stacked_captures(l.val) == None {
          { ..read, bound: read.bound.insert(l.var.id, pass) }
        } else { read }
      },
      Do(d) -> used_in(acc, operands(d.val)),
      Decl(v) -> { ..acc, bound: acc.bound.insert(v.id, pass) },
      Assign(x) -> handed_in(acc, [x.arg]),
      If(x) -> {
        let c = used_in(acc, [{ arg: x.cond, takes: false }]);
        let t = sighted({ ..c, reads: Map::new() }, x.then, pass);
        let o = sighted({ ..t, reads: Map::new(), passed: c.passed }, x.otherwise, pass);
        {
          ..o,
          reads: reads_joined(c.reads, reads_joined(t.reads, o.reads, false), true),
          passed: passed_joined(t.passed, o.passed),
        }
      },
      Case(c) -> {
        let rest = sighted({ ..acc, reads: Map::new() }, c.rest, pass);
        let arms = c.arms.fold(rest, |a: Sight, arm: { when: Int, body: Block }| {
          let s = sighted({ ..a, reads: Map::new(), passed: acc.passed }, arm.body, pass);
          {
            ..s,
            reads: reads_joined(a.reads, s.reads, false),
            passed: passed_joined(a.passed, s.passed),
          }
        });
        { ..arms, reads: reads_joined(acc.reads, arms.reads, true) }
      },
      // Each arm may miss to the next, and `rest` runs when every one has.
      Match(m) ->
        sighted(m.arms.fold(acc, |a: Sight, arm: Block| sighted(a, arm, pass)), m.rest, pass),
      Loop(l) -> {
        let looped = l.state.fold(handed_in(acc, l.init), |a: Sight, v: Var|
          { ..a, bound: a.bound.insert(v.id, l.answer.id) });
        let after = sighted(looped, l.body, l.answer.id);
        { ..after, bound: after.bound.insert(l.answer.id, pass) }
      },
      Next(args) -> handed_in(acc, args),
      Done(a) -> handed_in(acc, [a]),
      Return(a) -> handed_in(acc, [a]),
      Restart(args) -> handed_in(acc, args),
      Enter(e) -> handed_in(acc, e.args),
      // A clause may resume the body more than once, so it reads as a pass of its own.
      Handle(h) -> sighted(used_in(acc, used_as(h.args, h.uses)), h.body, h.answer.id),
      _ -> acc,
    })

fn used_in(s: Sight, ops: List<Operand>) -> Sight =
  ops.fold(s, |acc: Sight, o: Operand|
    match var_of(o.arg) {
      Some(v) ->
        {
          ..acc,
          whole: acc.whole.insert(v.id, true),
          handed: if o.takes { acc.handed.insert(v.id, true) } else { acc.handed },
        },
      None -> acc,
    })

fn handed_in(s: Sight, args: List<Arg>) -> Sight =
  used_in(s, args.map(|a: Arg| { arg: a, takes: true }))

/// `b` with each `Get` binding a variable `taking` names made a `Take`.
fn retaken(b: Block, taking: Map<Int, Bool>) -> Block =
  b.map(|i: Inst|
    match i {
      Let(l) -> match l.val {
        Get(g) -> if taking.contains(l.var.id) {
          Let({ ..l, val: Take({ of: g.of, path: g.path }) })
        } else { i },
        _ -> i,
      },
      If(x) -> If({ ..x, then: retaken(x.then, taking), otherwise: retaken(x.otherwise, taking) }),
      Case(c) ->
        Case({
          ..c,
          arms: c.arms.map(|a: { when: Int, body: Block }|
            { when: a.when, body: retaken(a.body, taking) }),
          rest: retaken(c.rest, taking),
        }),
      Match(m) ->
        Match({ arms: m.arms.map(|a: Block| retaken(a, taking)), rest: retaken(m.rest, taking) }),
      Loop(l) -> Loop({ ..l, body: retaken(l.body, taking) }),
      Handle(h) -> Handle({ ..h, body: retaken(h.body, taking) }),
      _ -> i,
    })

/// `f`'s variables read twice: once to learn which flat values can be opened, every read out of
/// them a `Get` of a leaf; then again with those values' words, so what is read out of a word is
/// held through it.
fn facts_of(f: Fn) -> Facts = {
  let empty = {
    held: Map::new(),
    vars: Map::new(),
    gets: Map::new(),
    direct: Map::new(),
    made: Map::new(),
    next: 0,
    opened: Map::new(),
    alias: Map::new(),
    stacks: Map::new(),
    promoted: Map::new(),
    immortal: immortals(f),
  };
  let first = gathered(params_defined(f, empty), f.body);
  let got = first.gets.fold(
    Map::new(),
    |m: Map<Int, List<Int>>, id: Int, g: { of: Int, path: Path }| read_by(m, g.of, id),
  );
  let borrowed = first.direct.fold(
    Map::new(),
    |m: Map<Int, List<Int>>, id: Int, from: List<Int>|
      from.fold(m, |n: Map<Int, List<Int>>, x: Int| read_by(n, x, id)),
  );
  let words = first.made.fold(
    { opened: Map::new(), next: first.next },
    |acc: { opened: Map<Int, List<Var>>, next: Int }, id: Int, _: Bool|
      match first.vars.get(id) {
        Some(s) -> if !openable(first, got, borrowed, s) { acc } else {
          let parts = parts_of(s.rep);
          let typed = parts_typed(s, word_types(first, got, id));
          {
            opened: acc.opened.insert(
              id,
              range(0, parts.len()).map(|k: Int|
                {
                  id: acc.next + k,
                  ty: match typed.at(k) { Some(t) -> t, None -> unknown_type() },
                  rep: match parts.at(k) { Some(r) -> r, None -> RInt },
                }),
            ),
            next: acc.next + parts.len(),
          }
        },
        None -> acc,
      },
  );
  let direct = first.gets.fold(
    Map::new(),
    |m: Map<Int, Var>, id: Int, g: { of: Int, path: Path }|
      match words.opened.get(g.of) {
        Some(ws) -> match g.path {
          PLeaf(k) -> match ws.at(k) {
            Some(w) -> if counted(w.rep) { m.insert(id, w) } else { m },
            None -> m,
          },
          _ -> m,
        },
        None -> match first.vars.get(g.of) {
          Some(x) -> match first.vars.get(id) {
            Some(y) -> match payload_of(Get({ of: x, path: g.path }), y) {
              Some(_) -> m.insert(id, x),
              None -> m,
            },
            None -> m,
          },
          None -> m,
        },
      },
  );
  let alias = direct.fold(Map::new(), |m: Map<Int, Var>, id: Int, v: Var|
    m.insert(id, aliased(direct, v, direct.len())));
  let read = if words.opened.len() == 0 && alias.len() == 0 { first } else {
    // The words first, so what is read out of a word's alias is read out of the word.
    let start = words.opened.fold(
      params_defined(f, { ..empty, opened: words.opened, alias: alias }),
      |fx: Facts, _: Int, ws: List<Var>| ws.fold(fx, |x: Facts, w: Var| defined(x, w, Own)),
    );
    { ..gathered(start, f.body), next: words.next }
  };
  let joined = joins_held(read, f.body);
  let raised = promoted(joined, f.body);
  {
    ..joined,
    held: raised.fold(joined.held, |h: Map<Int, Held>, id: Int, _: Bool| h.insert(id, Own)),
    promoted: raised,
  }
}

/// `fx` with each join held as the values set to it are: read out of what each was read out of
/// where every one is borrowed of values that live where its paths meet, and owned where any holds
/// a count of its own, is a constant, or is read out of a value bound inside a branch that sets it.
fn joins_held(fx: Facts, b: Block) -> Facts = {
  let sets = assigned(Map::new(), b);
  let bound = opened_levels(fx, levels(Map::new(), b, 0));
  sets.fold({ fx: fx, done: Map::new() }, |s: Joined, j: Int, _: List<Arg>|
    join_held(s, sets, bound, j, sets.len())).fx
}

/// `joins_held` so far: the facts, and the joins decided.
type Joined = { fx: Facts, done: Map<Int, Bool> }

/// How many blocks deep each variable `b` binds is bound, by number, `b` being `level` deep: a
/// join where it is declared, a loop's or a handle's answer where it stands, a loop's state in its
/// body. A value read where a join is set was bound in a block around it, so one bound deeper than
/// the join is declared is gone where the join's paths meet.
fn levels(m: Map<Int, Int>, b: Block, level: Int) -> Map<Int, Int> =
  b.fold(m, |acc: Map<Int, Int>, i: Inst|
    match i {
      Let(l) -> acc.insert(l.var.id, level),
      Decl(v) -> acc.insert(v.id, level),
      Reset(r) -> acc.insert(r.token.id, level),
      Opened(o) -> o.words.fold(acc, |n: Map<Int, Int>, w: Var| n.insert(w.id, level)),
      If(x) -> levels(levels(acc, x.then, level + 1), x.otherwise, level + 1),
      Case(c) ->
        c.arms.fold(
          levels(acc, c.rest, level + 1),
          |n: Map<Int, Int>, a: { when: Int, body: Block }| levels(n, a.body, level + 1),
        ),
      Match(x) ->
        x.arms.fold(levels(acc, x.rest, level + 1), |n: Map<Int, Int>, a: Block|
          levels(n, a, level + 1)),
      Loop(l) ->
        levels(
          l.state.fold(acc.insert(l.answer.id, level), |n: Map<Int, Int>, s: Var|
            n.insert(s.id, level + 1)),
          l.body,
          level + 1,
        ),
      Handle(h) -> levels(acc.insert(h.answer.id, level), h.body, level + 1),
      _ -> acc,
    })

/// `bound` with each opened value's words bound where the value is; a parameter is bound at 0.
fn opened_levels(fx: Facts, bound: Map<Int, Int>) -> Map<Int, Int> =
  fx.opened.fold(bound, |m: Map<Int, Int>, id: Int, ws: List<Var>| {
    let level = match bound.get(id) { Some(n) -> n, None -> 0 };
    ws.fold(m, |n: Map<Int, Int>, w: Var| n.insert(w.id, level))
  })

/// `s` with join `j` decided, each join it is set from first; `depth` bounds how many joins deep a
/// join is set from another, which their number does.
fn join_held(
  s: Joined,
  sets: Map<Int, List<Arg>>,
  bound: Map<Int, Int>,
  j: Int,
  depth: Int,
) -> Joined =
  if depth <= 0 || s.done.contains(j) || s.fx.immortal.contains(j) { s } else {
    match sets.get(j) {
      None -> s,
      Some(args) -> {
        let first = args.fold(s, |acc: Joined, a: Arg|
          match var_of(a) {
            Some(v) -> if sets.contains(v.id) { join_held(acc, sets, bound, v.id, depth - 1) }
            else { acc },
            None -> acc,
          });
        let level = |id: Int| match bound.get(id) { Some(n) -> n, None -> 0 };
        let bases = args.fold(Some([]), |bs: Option<List<Int>>, a: Arg|
          match bs {
            None -> None,
            Some(xs) -> match var_of(a) {
              Some(v) -> if !counted(v.rep) || first.fx.immortal.contains(v.id) { bs } else {
                match held_through(first.fx, v) {
                  Some(ReadOf(ys)) -> {
                    let from = flattened(first.fx, ys);
                    if from.any(|x: Int| level(x) > level(j)) { None }
                    else { Some(ints_joined(xs, from)) }
                  },
                  _ -> None,
                }
              },
              // A constant set to a counted join is held as that join's count, released as nothing.
              None -> if counted(rep_of_arg(a)) { None } else { bs },
            },
          });
        {
          fx: {
            ..first.fx,
            held: first.fx.held.insert(j, match bases { Some(xs) -> ReadOf(xs), None -> Own }),
          },
          done: first.done.insert(j, true),
        }
      },
    }
  }

/// `m` with the values each join `b` declares is set to, by the join's number. A handle's answer is
/// no such join: it holds a count of its own.
fn assigned(m: Map<Int, List<Arg>>, b: Block) -> Map<Int, List<Arg>> =
  b.fold(m, |acc: Map<Int, List<Arg>>, i: Inst|
    match i {
      Decl(v) -> if acc.contains(v.id) { acc } else { acc.insert(v.id, []) },
      Assign(x) -> match acc.get(x.var.id) {
        Some(xs) -> acc.insert(x.var.id, xs.push(x.arg)),
        None -> acc,
      },
      If(x) -> assigned(assigned(acc, x.then), x.otherwise),
      Case(c) ->
        c.arms.fold(
          assigned(acc, c.rest),
          |a: Map<Int, List<Arg>>, arm: { when: Int, body: Block }| assigned(a, arm.body),
        ),
      Match(x) -> x.arms.fold(assigned(acc, x.rest), assigned),
      Loop(l) -> assigned(acc, l.body),
      Handle(h) -> assigned(acc, h.body),
      _ -> acc,
    })

/// The borrowed variables used on a path past the last use of something they were read out of where
/// that use consumes it, or where a value made after it could take its cells: each takes a count of
/// its own where it is bound, so the value it was read out of moves or is reset there rather than
/// being held, and so copied or kept from reuse, for it.
fn promoted(fx: Facts, b: Block) -> Map<Int, Bool> =
  raised(
    fx,
    seen(fx, { at: 0, last: Map::new(), taken: Map::new() }, b),
    { at: 0, gone: Map::new(), dying: Map::new(), up: Map::new() },
    b,
  ).up

/// A body read in order, each instruction numbered as it is reached and a branch's blocks after
/// it: where each variable is used last, and where it is consumed last.
type Seen = { at: Int, last: Map<Int, Int>, taken: Map<Int, Int> }

fn seen(fx: Facts, s: Seen, b: Block) -> Seen =
  b.fold(s, |acc: Seen, i: Inst| {
    let k = acc.at;
    let here = { ..acc, at: k + 1 };
    match i {
      Let(l) -> used_at(fx, here, k, uses_of(fx, l.val)),
      Do(d) -> used_at(fx, here, k, uses_of(fx, d.val)),
      Assign(x) -> used_at(fx, here, k, all_taken([x.arg])),
      If(x) ->
        seen(
          fx,
          seen(fx, used_at(fx, here, k, [{ arg: x.cond, takes: false }]), x.then),
          x.otherwise,
        ),
      Case(c) ->
        seen(
          fx,
          c.arms.fold(
            used_at(fx, here, k, [{ arg: AVar(c.on), takes: false }]),
            |a: Seen, arm: { when: Int, body: Block }| seen(fx, a, arm.body),
          ),
          c.rest,
        ),
      Match(m) -> seen(fx, m.arms.fold(here, |a: Seen, arm: Block| seen(fx, a, arm)), m.rest),
      Loop(l) -> seen(fx, used_at(fx, here, k, all_taken(l.init)), l.body),
      Next(args) -> used_at(fx, here, k, all_taken(args)),
      Done(a) -> used_at(fx, here, k, all_taken([a])),
      Return(a) -> used_at(fx, here, k, all_taken([a])),
      Restart(args) -> used_at(fx, here, k, all_taken(args)),
      Enter(e) -> used_at(fx, here, k, all_taken(e.args)),
      Handle(h) -> seen(fx, used_at(fx, here, k, used_as(h.args, h.uses)), h.body),
      _ -> here,
    }
  })

fn used_at(fx: Facts, s: Seen, k: Int, ops: List<Operand>) -> Seen =
  expanded(fx, ops).fold(s, |acc: Seen, o: Operand|
    match var_of(o.arg) {
      Some(v) ->
        {
          ..acc,
          last: acc.last.insert(v.id, k),
          taken: if o.takes { acc.taken.insert(v.id, k) } else { acc.taken },
        },
      None -> acc,
    })

/// A body read in `seen`'s order, holding what each path has consumed at its last use or could
/// hand its cells to a value made since (`gone`), what it has used for the last time (`dying`), and
/// the borrowed variables used past a use that made something they were read out of gone (`up`).
/// The paths through a branch's blocks each start from what was gone and dying before it.
type Raise = { at: Int, gone: Map<Int, Bool>, dying: Map<Int, Bool>, up: Map<Int, Bool> }

fn raised(fx: Facts, s: Seen, r: Raise, b: Block) -> Raise =
  b.fold(r, |acc: Raise, i: Inst| {
    let k = acc.at;
    let here = { ..acc, at: k + 1 };
    match i {
      Let(l) -> {
        let past = passed_at(fx, s, here, k, uses_of(fx, l.val));
        match l.val {
          // Cells a value used for the last time could hand to what this makes.
          Make(m) -> if takes_cells(l.var, m.made, m.reuse) {
            {
              ..past,
              gone: past.dying.fold(past.gone, |g: Map<Int, Bool>, id: Int, _: Bool|
                match fx.vars.get(id) {
                  Some(v) -> if v.ty == l.var.ty && owns(fx, v) { g.insert(id, true) } else { g },
                  None -> g,
                }),
            }
          } else { past },
          _ -> past,
        }
      },
      Do(d) -> passed_at(fx, s, here, k, uses_of(fx, d.val)),
      Assign(x) -> passed_at(fx, s, here, k, all_taken([x.arg])),
      If(x) ->
        branches(fx, s, passed_at(fx, s, here, k, [{ arg: x.cond, takes: false }]), [
          x.then,
          x.otherwise,
        ]),
      Case(c) ->
        branches(
          fx,
          s,
          passed_at(fx, s, here, k, [{ arg: AVar(c.on), takes: false }]),
          c.arms.map(|a: { when: Int, body: Block }| a.body).push(c.rest),
        ),
      Match(m) -> branches(fx, s, here, m.arms.push(m.rest)),
      Loop(l) -> branches(fx, s, passed_at(fx, s, here, k, all_taken(l.init)), [l.body]),
      Next(args) -> passed_at(fx, s, here, k, all_taken(args)),
      Done(a) -> passed_at(fx, s, here, k, all_taken([a])),
      Return(a) -> passed_at(fx, s, here, k, all_taken([a])),
      Restart(args) -> passed_at(fx, s, here, k, all_taken(args)),
      Enter(e) -> passed_at(fx, s, here, k, all_taken(e.args)),
      Handle(h) -> branches(fx, s, passed_at(fx, s, here, k, used_as(h.args, h.uses)), [h.body]),
      _ -> here,
    }
  })

/// `blocks` read in order from `r`, each from what was gone at `r`, and what any of them made gone
/// gone after them.
fn branches(fx: Facts, s: Seen, r: Raise, blocks: List<Block>) -> Raise =
  blocks.fold(r, |acc: Raise, b: Block| {
    let w = raised(fx, s, { ..acc, gone: r.gone, dying: r.dying }, b);
    { ..w, gone: Map::merge(acc.gone, w.gone), dying: Map::merge(acc.dying, w.dying) }
  })

/// `r` past instruction `k` using `ops`: each borrowed variable used there that was read out of
/// something gone raised, then each value consumed there at its last use gone.
fn passed_at(fx: Facts, s: Seen, r: Raise, k: Int, ops: List<Operand>) -> Raise = {
  let used = expanded(fx, ops);
  {
    ..r,
    // An address takes no count of its own: its block stays live through it instead.
    up: used.fold(r.up, |u: Map<Int, Bool>, o: Operand|
      match var_of(o.arg) {
        Some(v) -> if points_into(v.rep) { u } else {
          match fx.held.get(v.id) {
            Some(ReadOf(bs)) -> if flattened(fx, bs).any(|x: Int| r.gone.contains(x)) {
              u.insert(v.id, true)
            } else { u },
            _ -> u,
          }
        },
        None -> u,
      }),
    gone: used.fold(r.gone, |g: Map<Int, Bool>, o: Operand|
      match var_of(o.arg) {
        Some(v) -> if o.takes && s.last.get(v.id) == Some(k) && s.taken.get(v.id) == Some(k) {
          g.insert(v.id, true)
        } else { g },
        None -> g,
      }),
    dying: used.fold(r.dying, |d: Map<Int, Bool>, o: Operand|
      match var_of(o.arg) {
        Some(v) -> if s.last.get(v.id) == Some(k) { d.insert(v.id, true) } else { d },
        None -> d,
      }),
  }
}

/// `fx` with `f`'s parameters defined, and each tail group member's: given ones owned, lent ones
/// outlasting the body.
fn params_defined(f: Fn, fx: Facts) -> Facts =
  f.members.fold(given_defined(f.params, f.conv, fx), |acc: Facts, m: Member|
    given_defined(m.params, m.conv, acc))

fn given_defined(params: List<Var>, conv: Convention, fx: Facts) -> Facts =
  range(0, params.len()).fold(fx, |acc: Facts, i: Int|
    match params.at(i) {
      None -> acc,
      Some(p) -> if conv.params.at(i) == Some(Lent) { defined(acc, p, ReadOf([])) }
      else { { ..defined(acc, p, Own), made: acc.made.insert(p.id, true) } },
    })

/// `by` with `id` among the variables read out of `of`, in ascending order where they are added so.
fn read_by(by: Map<Int, List<Int>>, of: Int, id: Int) -> Map<Int, List<Int>> =
  by.insert(of, match by.get(of) { Some(ids) -> ids.push(id), None -> [id] })

fn reads_of(by: Map<Int, List<Int>>, of: Int) -> List<Int> =
  match by.get(of) { Some(ids) -> ids, None -> [] }

/// Whether `s`, a value holding a count made where it is bound, is flat and read out of only by
/// `Get`s of its leaves, each held as that part is. `got` and `borrowed` are the variables each
/// `Get` and each borrowing read binds, by what they read out of.
fn openable(fx: Facts, got: Map<Int, List<Int>>, borrowed: Map<Int, List<Int>>, s: Var) -> Bool =
  match s.rep { RFlat(_) -> leaves_only(fx, got, borrowed, s), _ -> false }

fn leaves_only(fx: Facts, got: Map<Int, List<Int>>, borrowed: Map<Int, List<Int>>, s: Var) -> Bool = {
  let parts = parts_of(s.rep);
  let leaf = |id: Int|
    match fx.gets.get(id) {
      Some(g) -> match g.path {
        PLeaf(k) ->
          k >= 0
            && (match fx.vars.get(id) { Some(v) -> parts.at(k) == Some(v.rep), None -> false }),
        _ -> false,
      },
      None -> false,
    };
  // Every read out of `s`: those that borrow from it, and every `Get`, a read by name among them,
  // which answers a count of its own.
  reads_of(borrowed, s.id).all(leaf) && reads_of(got, s.id).all(leaf)
}

/// The type of each part of `s`, by its place: a record's leaf the type of the field its name
/// leads to, through each record held in place; any other part what `read` says it is read as.
fn parts_typed(s: Var, read: Map<Int, Type>) -> List<Type> = {
  let parts = parts_of(s.rep);
  let by_read = |k: Int| match read.get(k) { Some(t) -> t, None -> unknown_type() };
  match s.rep {
    RFlat(leaves) ->
      range(0, leaves.len()).map(|k: Int|
        match leaves.at(k) {
          Some(l) -> match leaf_type(s.ty, l.name) { Some(t) -> t, None -> by_read(k) },
          None -> by_read(k),
        }),
    _ -> range(0, parts.len()).map(by_read),
  }
}

/// The type each word of the value numbered `s` is read as, by its place: what the last `Get` of
/// that leaf reads.
fn word_types(fx: Facts, got: Map<Int, List<Int>>, s: Int) -> Map<Int, Type> =
  reads_of(got, s).fold(Map::new(), |m: Map<Int, Type>, id: Int|
    match fx.gets.get(id) {
      Some(g) -> match g.path {
        PLeaf(k) -> match fx.vars.get(id) { Some(v) -> m.insert(k, v.ty), None -> m },
        _ -> m,
      },
      None -> m,
    })

fn defined(fx: Facts, v: Var, h: Held) -> Facts =
  {
    ..fx,
    held: if counted(v.rep) || points_into(v.rep) { fx.held.insert(v.id, h) } else { fx.held },
    vars: fx.vars.insert(v.id, v),
    next: if v.id >= fx.next { v.id + 1 } else { fx.next },
  }

/// `v`, one of the body's values that hold no count (`verify.immortals`): known, never counted.
fn holding_none(fx: Facts, v: Var) -> Facts = { ..defined(fx, v, Own), held: fx.held }

/// Every variable `b` defines, with how it is held: a `Let` as its value answers, a join, a loop's
/// state and answer and a handle's answer owned; an alias of a word as nothing of its own.
fn gathered(fx: Facts, b: Block) -> Facts =
  b.fold(fx, |acc: Facts, i: Inst|
    match i {
      Let(l) -> match stacked_captures(l.val) {
        Some(caps) ->
          {
            ..defined(acc, l.var, ReadOf([])),
            stacks: acc.stacks.insert(
              l.var.id,
              caps.fold([], |vs: List<Var>, c: Arg|
                match var_of(c) {
                  Some(v) -> if counted(v.rep) { vs.push(v) } else { vs },
                  None -> vs,
                }),
            ),
          },
        None -> if acc.immortal.contains(l.var.id) { holding_none(acc, l.var) } else {
          // A borrowed value held again as another is read, and holds as that one does.
          let a = match re_held(l.var, l.val) {
            Some(x) -> match held_through(acc, x) {
              Some(ReadOf(_)) -> ReadsOf([x]),
              _ -> answer_held(l.val),
            },
            None -> answer_held(l.val),
          };
          let d = if acc.alias.contains(l.var.id) {
            { ..acc, vars: acc.vars.insert(l.var.id, l.var) }
          } else {
            defined(acc, l.var, match a {
              Owns -> Own,
              ReadsOf(xs) ->
                ReadOf(xs.fold([], |bs: List<Int>, x: Var| ints_joined(bs, base_of(acc, x)))),
              Lasts -> ReadOf([]),
            })
          };
          let traced = match a {
            Owns -> { ..d, made: d.made.insert(l.var.id, true) },
            ReadsOf(xs) -> if xs.len() == 0 { d }
            else { { ..d, direct: d.direct.insert(l.var.id, xs.map(|x: Var| x.id)) } },
            Lasts -> d,
          };
          match l.val {
            Get(g) ->
              { ..traced, gets: traced.gets.insert(l.var.id, { of: g.of.id, path: g.path }) },
            _ -> traced,
          }
        },
      },
      Decl(v) -> if acc.immortal.contains(v.id) { holding_none(acc, v) }
      else { defined(acc, v, Own) },
      If(x) -> gathered(gathered(acc, x.then), x.otherwise),
      Case(c) ->
        c.arms.fold(gathered(acc, c.rest), |a: Facts, arm: { when: Int, body: Block }|
          gathered(a, arm.body)),
      Match(m) -> m.arms.fold(gathered(acc, m.rest), |a: Facts, arm: Block| gathered(a, arm)),
      Loop(l) ->
        gathered(
          defined(
            l.state.fold(acc, |a: Facts, s: Var|
              { ..defined(a, s, Own), made: a.made.insert(s.id, true) }),
            l.answer,
            Own,
          ),
          l.body,
        ),
      Handle(h) -> gathered(defined(acc, h.answer, Own), h.body),
      Reset(r) -> defined(acc, r.token, Own),
      Opened(o) -> o.words.fold(acc, |a: Facts, w: Var| defined(a, w, Own)),
      _ -> acc,
    })

/// What `v` is read out of, as the body holds it: `v`'s own number where it holds a count, through
/// the value an alias stands for, which may itself be read out of others.
fn base_of(fx: Facts, v: Var) -> List<Int> = {
  let x = match fx.alias.get(v.id) { Some(w) -> w, None -> v };
  match fx.held.get(x.id) { Some(Own) -> [x.id], Some(ReadOf(bs)) -> flattened(fx, bs), None -> [] }
}

/// How `v` is held: an alias, a sum's payload that is its one count, as the sum it is read out of is.
fn held_through(fx: Facts, v: Var) -> Option<Held> =
  match fx.alias.get(v.id) { Some(t) -> fx.held.get(t.id), None -> fx.held.get(v.id) }

/// What `v` stands for through the aliases `direct` names, each the value it was read out of: a
/// payload's payload is the outermost sum's count, however the two are numbered. `depth` bounds the
/// chain, which `direct`'s size does.
fn aliased(direct: Map<Int, Var>, v: Var, depth: Int) -> Var =
  if depth <= 0 { v }
  else { match direct.get(v.id) { Some(t) -> aliased(direct, t, depth - 1), None -> v } }

/// `bs` with each borrowed join among them as what it was read out of: a join's holding is settled
/// after the values read out of it took it as their base.
fn flattened(fx: Facts, bs: List<Int>) -> List<Int> =
  bs.fold([], |acc: List<Int>, b: Int|
    ints_joined(acc, match fx.held.get(b) { Some(ReadOf(cs)) -> cs, _ -> [b] }))

/// The owned variables `v` was read out of, each live while it is.
fn base_vars(fx: Facts, v: Var) -> List<Var> =
  match fx.held.get(v.id) {
    Some(ReadOf(bs)) ->
      flattened(fx, bs).fold([], |vs: List<Var>, b: Int|
        match fx.vars.get(b) { Some(x) -> vs.push(x), None -> vs }),
    _ -> [],
  }

fn ints_joined(a: List<Int>, b: List<Int>) -> List<Int> =
  b.fold(a, |acc: List<Int>, x: Int| if acc.contains(x) { acc } else { acc.push(x) })

fn owns(fx: Facts, v: Var) -> Bool = counted(v.rep) && fx.held.get(v.id) == Some(Own)

/// What a use of `v` is a use of: an opened value's counted words, a word's alias that word, any
/// other variable itself.
fn resolved(fx: Facts, v: Var) -> List<Var> =
  match fx.stacks.get(v.id) {
    Some(caps) -> caps.fold([], |acc: List<Var>, c: Var| acc.concat(word_of(fx, c))),
    None -> word_of(fx, v),
  }

fn word_of(fx: Facts, v: Var) -> List<Var> =
  match fx.opened.get(v.id) {
    Some(ws) -> ws.filter(|w: Var| counted(w.rep)),
    None -> match fx.alias.get(v.id) { Some(w) -> [w], None -> [v] },
  }

/// `ops` with each operand that is an opened value or an alias as the words it uses, and a closure
/// on this frame's stack as a read of each capture.
fn expanded(fx: Facts, ops: List<Operand>) -> List<Operand> =
  ops.fold([], |acc: List<Operand>, o: Operand|
    match var_of(o.arg) {
      Some(v) -> {
        let takes = o.takes && !fx.stacks.contains(v.id);
        acc.concat(resolved(fx, v).map(|w: Var| { arg: AVar(w), takes: takes }))
      },
      None -> acc.push(o),
    })

/// What `val` uses: its operands, but a `Get` of an opened value's leaf reads only that word.
fn uses_of(fx: Facts, val: Val) -> List<Operand> =
  match val {
    Get(g) -> match fx.opened.get(g.of.id) {
      Some(ws) -> match g.path {
        PLeaf(k) -> match ws.at(k) {
          Some(w) -> if counted(w.rep) { [{ arg: AVar(w), takes: false }] } else { [] },
          None -> [],
        },
        _ -> operands(val),
      },
      None -> operands(val),
    },
    _ -> operands(val),
  }

/// `live` with `v` live, and what `v` is read out of; an address only keeps its block live.
fn alive(fx: Facts, live: Live, v: Var) -> Live =
  resolved(fx, v).fold(live, |l: Live, x: Var|
    if points_into(x.rep) { base_vars(fx, x).fold(l, |m: Live, b: Var| m.insert(b.id, b)) }
    else if !counted(x.rep) { l }
    else { base_vars(fx, x).fold(l.insert(x.id, x), |m: Live, b: Var| m.insert(b.id, b)) })

fn arg_live(fx: Facts, live: Live, a: Arg) -> Live =
  match var_of(a) { Some(v) -> alive(fx, live, v), None -> live }

/// The one recursion: `b` walked from its end, `out` live after it, each instruction given the
/// counts its operands need; a branch's blocks walked from the live set after the branch and
/// opened by letting go of what is live into the branch but not into them.
fn walked_back(fx: Facts, ex: Exits, b: Block, out: Live, next: Int) -> Back =
  b.fold_right({ rev: [], live: out, next: next, takers: [] }, |i: Inst, acc: Back|
    match i {
      Let(l) -> {
        let words = match fx.opened.get(l.var.id) { Some(ws) -> ws, None -> [] };
        let after = words.fold(acc.live.remove(l.var.id), |m: Live, w: Var| m.remove(w.id));
        // A value held again as another reads it where that one is borrowed, and takes it, with a
        // count first where it is borrowed, where that one holds a count of its own.
        let again = re_held(l.var, l.val);
        let held_again = again != None;
        let p = planned(
          fx,
          match again {
            Some(x) -> if owns(fx, l.var) { uses_of(fx, l.val) }
            else { [{ arg: AVar(x), takes: false }] },
            None -> uses_of(fx, l.val),
          },
          after,
        );
        let unwind = if leaves(l.val) { unwind_of(fx, ex, after, p.after) } else { [] };
        let made = Let({ ..l, unwind: unwind });
        match fx.opened.get(l.var.id) {
          // A flat value opened where it is made: each word nothing reads is let go of at once.
          Some(ws) ->
            placed(
              ex,
              acc,
              p,
              made,
              [Opened({ of: l.var, words: ws })],
              ws.filter(|w: Var| owns(fx, w) && !acc.live.contains(w.id)),
            ),
          None ->
            placed(
              ex,
              acc,
              p,
              made,
              if fx.promoted.contains(l.var.id) && !held_again { [Inc({ var: l.var, n: 1 })] }
              else { [] },
              if owns(fx, l.var) && !acc.live.contains(l.var.id) { [l.var] } else { [] },
            ),
        }
      },
      Do(d) -> {
        let p = planned(fx, uses_of(fx, d.val), acc.live);
        let unwind = if leaves(d.val) { unwind_of(fx, ex, acc.live, p.after) } else { [] };
        placed(ex, acc, p, Do({ ..d, unwind: unwind }), [], [])
      },
      Decl(v) -> { ..acc, rev: acc.rev.push(i), live: acc.live.remove(v.id) },
      Assign(s) -> {
        let dead = if owns(fx, s.var) && !acc.live.contains(s.var.id) { [s.var] } else { [] };
        placed(
          ex,
          acc,
          // A join held as what it is set to only reads it.
          planned(
            fx,
            [{ arg: s.arg, takes: owns(fx, s.var) || !counted(s.var.rep) }],
            acc.live.remove(s.var.id),
          ),
          i,
          [],
          dead,
        )
      },
      If(x) -> {
        let t = walked_back(fx, ex, x.then, acc.live, acc.next);
        let e = walked_back(fx, ex, x.otherwise, acc.live, t.next);
        let live = arg_live(fx, Map::merge(t.live, e.live), x.cond);
        let tb = entered(fx, ex, { ..t, next: e.next }, live);
        let eb = entered(fx, ex, { ..e, next: tb.next }, live);
        let at = acc.rev.len();
        branched(
          acc,
          If({ cond: x.cond, then: tb.block, otherwise: eb.block }),
          live,
          eb.next,
          stepped(tb.takers, at, 0).concat(stepped(eb.takers, at, 1)),
        )
      },
      Case(c) -> {
        let rest = walked_back(fx, ex, c.rest, acc.live, acc.next);
        let arms = c.arms.fold(
          { walks: [], next: rest.next },
          |s: Arms, a: { when: Int, body: Block }| {
            let k = { ..ex, known: known_at(ex.known, c.on, c.test, a.when) };
            let w = walked_back(fx, k, a.body, acc.live, s.next);
            { walks: s.walks.push({ when: a.when, back: w, exits: k }), next: w.next }
          },
        );
        let live = arms.walks.fold(alive(fx, rest.live, c.on), |l: Live, w: ArmWalk|
          Map::merge(l, w.back.live));
        let r = entered(fx, ex, { ..rest, next: arms.next }, live);
        let at = acc.rev.len();
        let opened = arms.walks.fold(
          { arms: [], next: r.next, takers: stepped(r.takers, at, c.arms.len()) },
          |s: { arms: List<{ when: Int, body: Block }>, next: Int, takers: List<Taker> }, w: ArmWalk| {
            let e = entered(fx, w.exits, { ..w.back, next: s.next }, live);
            {
              arms: s.arms.push({ when: w.when, body: e.block }),
              next: e.next,
              takers: s.takers.concat(stepped(e.takers, at, s.arms.len())),
            }
          },
        );
        branched(
          acc,
          Case({ ..c, arms: opened.arms, rest: r.block }),
          live,
          opened.next,
          opened.takers,
        )
      },
      Match(m) -> {
        let rest = walked_back(fx, ex, m.rest, acc.live, acc.next);
        let arms = m.arms.fold_right(
          { blocks: [], entry: rest.live, next: rest.next },
          |a: Block, s: { blocks: List<Block>, entry: Live, next: Int }| {
            let w = walked_back(fx, { ..ex, miss: s.entry }, a, acc.live, s.next);
            { blocks: s.blocks.push(w.rev.reverse()), entry: w.live, next: w.next }
          },
        );
        branched(
          acc,
          Match({ arms: arms.blocks.reverse(), rest: rest.rev.reverse() }),
          arms.entry,
          arms.next,
          [],
        )
      },
      Loop(l) -> {
        // A flat state is opened at the head of each pass, so what a pass reads of it moves on.
        let words = l.state.fold([], |ws: List<Var>, s: Var|
          match fx.opened.get(s.id) { Some(x) -> ws.concat(x), None -> ws });
        let inner = outer_reads(fx, l.body, l.state.concat(words));
        let carried = Map::merge(acc.live.remove(l.answer.id), inner);
        let k = { ..ex, looped: Some(carried), miss: Map::new() };
        let e = headed(fx, k, l.state, l.body, carried, acc.next);
        let p = planned(fx, l.init.map(|a: Arg| { arg: a, takes: true }), carried);
        let gone = inner.values().filter(|v: Var| owns(fx, v) && !acc.live.contains(v.id));
        placed(
          ex,
          { ..acc, next: e.next },
          { ..p, after: p.after.concat(gone) },
          Loop({ ..l, body: e.block }),
          [],
          answer_dead(fx, acc.live, l.answer),
        )
      },
      Handle(h) -> {
        let ops = used_as(h.args, h.uses);
        let lent = ops.filter(|o: Operand| !o.takes).fold(Map::new(), |l: Live, o: Operand|
          arg_live(fx, l, o.arg));
        let inner = Map::merge(outer_reads(fx, h.body, [h.answer]), lent);
        let across = Map::merge(acc.live.remove(h.answer.id), inner);
        let k = { ..ex, looped: None, miss: Map::new(), landing: across };
        let body = walked_back(fx, k, h.body, across.insert(h.answer.id, h.answer), acc.next);
        let e = entered(fx, k, body, across);
        let p = planned(fx, ops, across);
        let gone = inner.values().filter(|v: Var| owns(fx, v) && !acc.live.contains(v.id));
        let unwind = across.values().filter(|v: Var| owns(fx, v) && !ex.landing.contains(v.id));
        placed(
          ex,
          { ..acc, next: e.next },
          { ..p, after: p.after.concat(gone) },
          Handle({ ..h, body: e.block, unwind: unwind }),
          [],
          answer_dead(fx, acc.live, h.answer),
        )
      },
      Next(args) -> ended_back(fx, ex, acc, i, all_taken(args), looped_live(ex)),
      Done(a) -> ended_back(fx, ex, acc, i, all_taken([a]), looped_live(ex)),
      Return(a) ->
        ended_back(
          fx,
          ex,
          acc,
          i,
          match ex.answered { Owned -> all_taken([a]), Borrowed(_) -> [{ arg: a, takes: false }] },
          Map::new(),
        ),
      Restart(args) -> ended_back(fx, ex, acc, i, handed_as(args, ex.restart), Map::new()),
      Enter(e) ->
        ended_back(
          fx,
          ex,
          acc,
          i,
          handed_as(e.args, match ex.enters.at(e.member) { Some(h) -> h, None -> [] }),
          Map::new(),
        ),
      Fail(_) -> { ..acc, rev: acc.rev.push(i), live: ex.landing, takers: [] },
      Miss -> { ..acc, rev: acc.rev.push(i), live: ex.miss, takers: [] },
      _ -> { ..acc, rev: acc.rev.push(i) },
    })

type ArmWalk = { when: Int, back: Back, exits: Exits }

type Arms = { walks: List<ArmWalk>, next: Int }

/// The constructor a case arm knows its subject holds: the one its tag test names at the arm's
/// place.
fn known_at(known: Map<Int, Bytes>, on: Var, tested: Test, when: Int) -> Map<Int, Bytes> =
  match tested {
    TTag(names) -> match names.at(when) { Some(n) -> known.insert(on.id, n), None -> known },
    _ -> known,
  }

fn looped_live(ex: Exits) -> Live = match ex.looped { Some(l) -> l, None -> Map::new() }

/// `answer`, a loop's or a handle's, let go of right after it where nothing reads it.
fn answer_dead(fx: Facts, live: Live, answer: Var) -> List<Var> =
  if owns(fx, answer) && !live.contains(answer.id) { [answer] } else { [] }

/// The counted variables `b` reads that it does not define, nor `bound` names, and what they are
/// read out of: what a loop or a handle around `b` holds across it.
fn outer_reads(fx: Facts, b: Block, bound: List<Var>) -> Live = {
  let m = mentioned(fx, { used: Map::new(), bound: Map::new() }, b);
  m.used.fold(Map::new(), |l: Live, id: Int, v: Var|
    if m.bound.contains(id) || bound.any(|s: Var| s.id == id) { l } else { alive(fx, l, v) })
}

type Mentions = { used: Map<Int, Var>, bound: Map<Int, Bool> }

/// The variables `b` names as operands and those it defines, an opened value's words with it.
fn mentioned(fx: Facts, m: Mentions, b: Block) -> Mentions =
  b.fold(m, |acc: Mentions, i: Inst|
    match i {
      Let(l) -> {
        let read = bound_in(args_in(acc, uses_of(fx, l.val).map(|o: Operand| o.arg)), l.var);
        match fx.opened.get(l.var.id) { Some(ws) -> ws.fold(read, bound_in), None -> read }
      },
      Do(d) -> args_in(acc, uses_of(fx, d.val).map(|o: Operand| o.arg)),
      Decl(v) -> bound_in(acc, v),
      Assign(s) -> args_in(acc, [s.arg]),
      If(x) -> mentioned(fx, mentioned(fx, args_in(acc, [x.cond]), x.then), x.otherwise),
      Case(c) ->
        c.arms.fold(
          mentioned(fx, args_in(acc, [AVar(c.on)]), c.rest),
          |a: Mentions, arm: { when: Int, body: Block }| mentioned(fx, a, arm.body),
        ),
      Match(x) ->
        x.arms.fold(mentioned(fx, acc, x.rest), |a: Mentions, arm: Block| mentioned(fx, a, arm)),
      Loop(l) -> {
        let state = l.state.fold(args_in(acc, l.init), |a: Mentions, s: Var|
          match fx.opened.get(s.id) {
            Some(ws) -> ws.fold(bound_in(a, s), bound_in),
            None -> bound_in(a, s),
          });
        mentioned(fx, bound_in(state, l.answer), l.body)
      },
      Next(args) -> args_in(acc, args),
      Done(a) -> args_in(acc, [a]),
      Return(a) -> args_in(acc, [a]),
      Restart(args) -> args_in(acc, args),
      Enter(e) -> args_in(acc, e.args),
      Handle(h) -> mentioned(fx, bound_in(args_in(acc, h.args), h.answer), h.body),
      Inc(n) -> args_in(acc, [AVar(n.var)]),
      Dec(v) -> args_in(acc, [AVar(v)]),
      Reset(r) -> bound_in(args_in(acc, [AVar(r.of)]), r.token),
      Free(r) -> args_in(acc, [AVar(r.of)]),
      Opened(o) -> o.words.fold(args_in(acc, [AVar(o.of)]), bound_in),
      Fail(_) -> acc,
      Miss -> acc,
      Sited(_) -> acc,
    })

fn args_in(m: Mentions, args: List<Arg>) -> Mentions =
  args.fold(m, |acc: Mentions, a: Arg|
    match var_of(a) {
      Some(v) -> if counted(v.rep) { { ..acc, used: acc.used.insert(v.id, v) } } else { acc },
      None -> acc,
    })

fn bound_in(m: Mentions, v: Var) -> Mentions = { ..m, bound: m.bound.insert(v.id, true) }

/// What an instruction consuming or reading `ops` needs, `after` live after it. A value consumed
/// while it stays live, or read by the instruction too, takes an `Inc` for each consuming use; one
/// consumed for the last time moves; a borrowed one always takes an `Inc`. An owned value the
/// instruction reads and nothing reads after dies after it; one it does not read, which only
/// something consumed was read out of, dies before it.
fn planned(fx: Facts, uses: List<Operand>, after: Live) -> Plan = {
  let t = expanded(fx, uses).fold(
    { order: [], listed: Map::new(), taken: Map::new(), read: Map::new() },
    |acc: Touched, o: Operand|
      match var_of(o.arg) {
        Some(v) -> {
          let used = if o.takes {
            { ..acc, taken: acc.taken.insert(v.id, consumed(acc, v.id) + 1) }
          } else {
            {
              ..acc,
              read: base_of(fx, v).fold(acc.read.insert(v.id, true), |r: Map<Int, Bool>, b: Int|
                r.insert(b, true)),
            }
          };
          if points_into(v.rep) { base_vars(fx, v).fold(used, listed) }
          else if !counted(v.rep) || fx.immortal.contains(v.id) { used }
          else { base_vars(fx, v).fold(listed(used, v), listed) }
        },
        None -> acc,
      },
  );
  t.order.fold({ incs: [], before: [], after: [], live: after }, |p: Plan, x: Var| {
    let taken = consumed(t, x.id);
    let live = after.contains(x.id);
    let held = { ..p, live: p.live.insert(x.id, x) };
    if !owns(fx, x) { counts_for(held, x, taken) } else if live || t.read.contains(x.id) {
      counts_for({ ..held, after: if live { held.after } else { held.after.push(x) } }, x, taken)
    } else if taken > 0 { counts_for(held, x, taken - 1) }
    else { { ..held, before: held.before.push(x) } }
  })
}

/// An instruction's operands read once: the counted variables they use, each first in the order
/// they are named and followed by what it is read out of (`listed` holding the same as a set), how
/// many times each operand is consumed, and which are read without being consumed, directly or
/// through a value read out of them.
type Touched = {
  order: List<Var>,
  listed: Map<Int, Bool>,
  taken: Map<Int, Int>,
  read: Map<Int, Bool>,
}

fn consumed(t: Touched, id: Int) -> Int = match t.taken.get(id) { Some(n) -> n, None -> 0 }

/// `t` with `v` last in its order, unless it is there already.
fn listed(t: Touched, v: Var) -> Touched =
  if t.listed.contains(v.id) { t }
  else { { ..t, order: t.order.push(v), listed: t.listed.insert(v.id, true) } }

fn counts_for(p: Plan, v: Var, n: Int) -> Plan =
  if n > 0 { { ..p, incs: p.incs.push(Inc({ var: v, n: n })) } } else { p }

/// What the failure path of an instruction releases: the owned values live after it and those it
/// reads that die after it, but what a `handle` around it holds across its body.
fn unwind_of(fx: Facts, ex: Exits, after: Live, dying: List<Var>) -> List<Var> =
  after.values().concat(dying).filter(|v: Var| owns(fx, v) && !ex.landing.contains(v.id))

/// `inst` placed with the counts `p` says, `then` right after it, `dead` let go of after that, and
/// `p.after` after those.
fn placed(ex: Exits, acc: Back, p: Plan, inst: Inst, then: List<Inst>, dead: List<Var>) -> Back = {
  let tail = dead.concat(p.after).reverse().fold(acc, |b: Back, v: Var| dropped(ex, b, v));
  let followed = then.reverse().fold(tail.rev, |r: List<Inst>, n: Inst| r.push(n));
  let put = {
    ..tail,
    rev: followed.push(inst),
    // A token held across a stop is freed where its frame links a record, as a resumption could
    // come more than once there, so the cells reach the taker only where none can.
    takers: if nests(inst) { [] } else { taking(tail.takers, inst, followed.len()) },
  };
  let freed = p.before.reverse().fold(put, |b: Back, v: Var| dropped(ex, b, v));
  {
    ..freed,
    rev: p.incs.reverse().fold(freed.rev, |r: List<Inst>, n: Inst| r.push(n)),
    live: p.live,
  }
}

fn nests(i: Inst) -> Bool =
  match i {
    If(_) -> true,
    Case(_) -> true,
    Match(_) -> true,
    Loop(_) -> true,
    Handle(_) -> true,
    _ -> false,
  }

/// A leaving instruction: what it hands on consumed, `after` what stays held past it.
fn ended_back(
  fx: Facts,
  ex: Exits,
  acc: Back,
  inst: Inst,
  ops: List<Operand>,
  after: Live,
) -> Back = placed(ex, { ..acc, takers: [] }, planned(fx, ops, after), inst, [], [])

fn all_taken(args: List<Arg>) -> List<Operand> = args.map(|a: Arg| { arg: a, takes: true })

/// `args` handed to parameters taken as `handed`: one lent is only read, as it was handed in.
fn handed_as(args: List<Arg>, handed: List<Handed>) -> List<Operand> =
  range(0, args.len()).fold([], |acc: List<Operand>, i: Int|
    match args.at(i) {
      Some(a) -> acc.push({ arg: a, takes: handed.at(i) != Some(Lent) }),
      None -> acc,
    })

/// A branch placed, the `Make`s its arms reach from their heads as what a value let go of before it
/// may reuse, and those after it where a token can be carried through it.
fn branched(acc: Back, inst: Inst, live: Live, next: Int, takers: List<Taker>) -> Back =
  {
    rev: acc.rev.push(inst),
    live: live,
    next: next,
    takers: if carries([inst]) { takers.concat(acc.takers) } else { takers },
  }

/// Whether a reuse token can be carried through `b`: no loop or handle, which hold what they
/// read across passes and landings.
fn carries(b: Block) -> Bool =
  b.all(|i: Inst|
    match i {
      If(x) -> carries(x.then) && carries(x.otherwise),
      Case(c) -> carries(c.rest) && c.arms.all(|a: { when: Int, body: Block }| carries(a.body)),
      Match(m) -> carries(m.rest) && m.arms.all(carries),
      Loop(_) -> false,
      Handle(_) -> false,
      _ -> true,
    })

/// `takers` an arm reaches, as reached from before the branch at `at`, through arm `arm`.
fn stepped(takers: List<Taker>, at: Int, arm: Int) -> List<Taker> =
  takers.map(|t: Taker| { ..t, route: [{ at: at, arm: arm }].concat(t.route) })

/// A branch's block, opened by letting go of what `held` holds that it does not read, and the
/// `Make`s still reached from its head.
fn entered(
  fx: Facts,
  ex: Exits,
  w: Back,
  held: Live,
) -> { block: Block, next: Int, takers: List<Taker> } = {
  let gone = held.values().filter(|v: Var| owns(fx, v) && !w.live.contains(v.id));
  let b = gone.reverse().fold(w, |acc: Back, v: Var| dropped(ex, acc, v));
  { block: b.rev.reverse(), next: b.next, takers: b.takers }
}

/// `takers` with `inst` among them where it takes cells.
fn taking(takers: List<Taker>, inst: Inst, at: Int) -> List<Taker> =
  match inst {
    Let(l) -> match l.val {
      Make(m) -> if takes_cells(l.var, m.made, m.reuse) {
        takers.push({ at: at, route: [], made: m.made })
      } else { takers },
      _ -> takers,
    },
    _ -> takers,
  }

/// Whether `v` bound to a `Make` of `made` reusing `reuse` takes the cells of a box let go of before
/// it where they fit: it makes a block of words afresh. A record the runtime lays out is made by
/// value, and takes none.
fn takes_cells(v: Var, made: Made, reuse: Option<Var>) -> Bool =
  reuse == None && v.rep == RWord && reuses_cells(made) && made_width(made) > 0

/// Whether the ownership pass may reset anything in `f`'s body, its tail group's arms among it: some
/// `Make` there takes cells. Its closures' bodies are counted as roots of their own.
pub fn may_reuse(f: Fn) -> Bool = reuses_within(f.body)

fn reuses_within(b: Block) -> Bool =
  b.fold(false, |any: Bool, i: Inst|
    any
      || (match i {
        Let(l) -> match l.val { Make(m) -> takes_cells(l.var, m.made, m.reuse), _ -> false },
        If(x) -> reuses_within(x.then) || reuses_within(x.otherwise),
        Case(c) ->
          c.arms.fold(reuses_within(c.rest), |a: Bool, arm: { when: Int, body: Block }|
            a || reuses_within(arm.body)),
        Match(m) ->
          m.arms.fold(reuses_within(m.rest), |a: Bool, arm: Block| a || reuses_within(arm)),
        Loop(l) -> reuses_within(l.body),
        Handle(h) -> reuses_within(h.body),
        _ -> false,
      }))

/// Where `t` is first reached in the block it was found from: its own place, or the branch it is in.
fn first_at(t: Taker) -> Int = match t.route.at(0) { Some(s) -> s.at, None -> t.at }

/// The place of the nearest of `takers`: the one first reached from the block's head.
fn nearest(takers: List<Taker>) -> Option<Int> =
  takers.fold(None, |best: Option<Int>, t: Taker|
    match best {
      Some(b) -> if first_at(t) > b { Some(first_at(t)) } else { best },
      None -> Some(first_at(t)),
    })

/// `v` let go of: where it is a sum known to hold a boxed case and `Make`s below take cells of that
/// box's size (the nearest, or in each arm of the nearest branch that makes one, the arms that make
/// none freeing it), opened into its box, which is reset into a token they take; else released.
fn dropped(ex: Exits, b: Back, v: Var) -> Back = {
  let released = { ..b, rev: b.rev.push(Dec(v)) };
  match boxed_known(ex, v) {
    None -> released,
    Some(r) -> {
      let fitting = b.takers.filter(|t: Taker| fits(r, t));
      match nearest(fitting) {
        None -> released,
        Some(at) -> {
          let chosen = fitting.filter(|t: Taker| first_at(t) == at);
          let made = match chosen.at(0) { Some(t) -> t.made, None -> MList(0) };
          let box = { id: b.next, ty: v.ty, rep: r };
          let token = token_of(b.next + 1, box, made);
          {
            ..b,
            rev: taken_in(b.rev.reverse(), chosen, token).reverse().push(
              Reset({ token: token, of: box }),
            ).push(
              Opened({ of: v, words: [box] }),
            ),
            next: b.next + 2,
            takers: b.takers.filter(|x: Taker| !chosen.contains(x)),
          }
        },
      }
    },
  }
}

/// The box a sum of one word `v` holds where the case arm around knows it to hold a boxed case:
/// that case alone, boxed at its word.
fn boxed_known(ex: Exits, v: Var) -> Option<Rep> =
  match v.rep {
    RSum(s) -> if s.laid.classes.len() != 1 { None } else {
      match ex.known.get(v.id) {
        Some(name) -> match range(0, s.cases.len()).find(|k: Int| s.cases.at(k) == Some(name)) {
          Some(k) -> boxed_case_of(v.rep, k),
          None -> None,
        },
        None -> None,
      }
    },
    _ -> None,
  }

/// The words of the block a sum boxed alone, as `boxed_case_of` holds it, has: its tag's and its
/// payload's.
fn box_words(r: Rep) -> Int =
  match r {
    RSum(s) -> match s.laid.cases.at(0) {
      Some(c) -> match c.payload { Boxed(x) -> x.skip + layout::words(x.laid), _ -> 0 },
      None -> 0,
    },
    _ -> 0,
  }

/// The token numbered `id` holding `of`'s cells for `made`, a block of as many payload words.
fn token_of(id: Int, of: Var, made: Made) -> Var =
  { id: id, ty: of.ty, rep: RToken(made_width(made)) }

/// Whether `t` may take the cells of a box held as `r`: a boxed case of as many words.
fn fits(r: Rep, t: Taker) -> Bool =
  (match t.made { MCase(_) -> true, _ -> false }) && made_width(t.made) == box_words(r)

/// `block` with the nearest of `takers` taking `token`, and every instruction before it that can
/// fail releasing it. A taker's place counts from the block's end.
fn taken_in(block: Block, takers: List<Taker>, token: Var) -> Block =
  match nearest(takers) {
    None -> block,
    Some(at) -> {
      let here = takers.filter(|t: Taker| first_at(t) == at);
      let last = block.len() - 1;
      block.fold({ k: 0, out: [] }, |s: { k: Int, out: List<Inst> }, i: Inst|
        {
          k: s.k + 1,
          out: s.out.push(if last - s.k == at { taking_at(i, here, token) }
          else if last - s.k > at { held_across(i, token) }
          else { i }),
        }).out
    },
  }

/// `i` taking `token`: the `Make` it is, or in each arm of the branch it is, the nearest `Make`
/// `takers` names there, an arm with none freeing it.
fn taking_at(i: Inst, takers: List<Taker>, token: Var) -> Inst =
  if takers.any(|t: Taker| t.route.len() == 0) { taken_by(i, token) } else {
    match i {
      If(x) ->
        If({
          ..x,
          then: arm_taking(x.then, 0, takers, token),
          otherwise: arm_taking(x.otherwise, 1, takers, token),
        }),
      Case(c) ->
        Case({
          ..c,
          arms: c.arms.fold(
            [],
            |arms: List<{ when: Int, body: Block }>, a: { when: Int, body: Block }|
              arms.push({ when: a.when, body: arm_taking(a.body, arms.len(), takers, token) }),
          ),
          rest: arm_taking(c.rest, c.arms.len(), takers, token),
        }),
      _ -> i,
    }
  }

/// Arm `arm`'s block taking `token` where `takers` reach a `Make` in it, else freeing it first.
fn arm_taking(block: Block, arm: Int, takers: List<Taker>, token: Var) -> Block = {
  let inner = takers.fold([], |acc: List<Taker>, t: Taker|
    match t.route.at(0) {
      Some(s) -> if s.arm == arm { acc.push({ ..t, route: t.route.drop(1) }) } else { acc },
      None -> acc,
    });
  if inner.len() == 0 { [freed(token)].concat(block) } else { taken_in(block, inner, token) }
}

/// `token`'s cells given back: the whole block, its header among it.
fn freed(token: Var) -> Inst =
  Free({
    of: token,
    bytes: AInt(header_bytes() + 8 * (match token.rep { RToken(n) -> n, _ -> 0 })),
  })

fn taken_by(i: Inst, token: Var) -> Inst =
  match i {
    Let(l) -> match l.val {
      Make(m) -> Let({ ..l, val: Make({ ..m, reuse: Some(token) }) }),
      _ -> i,
    },
    _ -> i,
  }

fn held_across(i: Inst, token: Var) -> Inst = carried(i, token, false)

/// `i`, between a reset and the `Make` its token goes to, carrying the token: each instruction that
/// can fail releasing it, and in a branch's arms, each way out of the body freeing it first. A miss
/// keeps it where the match it leaves for its next arm (`matched`) is carried too.
fn carried(i: Inst, token: Var, matched: Bool) -> Inst =
  match i {
    Let(l) -> if leaves(l.val) { Let({ ..l, unwind: l.unwind.push(token) }) } else { i },
    Do(d) -> if leaves(d.val) { Do({ ..d, unwind: d.unwind.push(token) }) } else { i },
    If(x) ->
      If({
        ..x,
        then: carried_in(x.then, token, matched),
        otherwise: carried_in(x.otherwise, token, matched),
      }),
    Case(c) ->
      Case({
        ..c,
        arms: c.arms.map(|a: { when: Int, body: Block }|
          { when: a.when, body: carried_in(a.body, token, matched) }),
        rest: carried_in(c.rest, token, matched),
      }),
    Match(m) ->
      Match({
        arms: m.arms.map(|a: Block| carried_in(a, token, true)),
        rest: carried_in(m.rest, token, matched),
      }),
    _ -> i,
  }

fn carried_in(b: Block, token: Var, matched: Bool) -> Block =
  b.fold([], |out: List<Inst>, i: Inst|
    if leaves_with(i, matched) { out.push(freed(token)).push(i) }
    else { out.push(carried(i, token, matched)) })

/// Whether `i` leaves where a carried token is held: the body or a loop's pass, or the match a miss
/// leaves for the next arm of, where that match is not carried.
fn leaves_with(i: Inst, matched: Bool) -> Bool = match i { Miss -> !matched, _ -> ends(i) }

/// An `Option` of a pointer as M2 lays it: one word, `None` its zero.
fn maybe_word() -> Rep =
  RSum({
    laid: {
      classes: [P],
      cases: [
        { test: WordIs({ at: 0, value: 0 }), payload: Nullary },
        {
          test: WordOutside({ at: 0, values: [0] }),
          payload: Inline({ offset: 0, laid: LWords([P]), stripped: None }),
        },
      ],
    },
    cases: [b"None", b"Some"],
  })

fn of_type(id: Int, ty: Bytes) -> Var = { id: id, ty: TyCon({ name: ty, args: [] }), rep: RWord }

fn word(id: Int) -> Var = of_type(id, b"String")

fn flag(id: Int) -> Var = { id: id, ty: TyCon({ name: b"Bool", args: [] }), rep: RBool }

/// A root over `params`, each given unless `lent` names it, answering as `answer`.
fn root_of(params: List<Var>, lent: List<Int>, answer: Rep, body: Block) -> Fn =
  {
    key: Named(b"m.f"),
    kind: Rooted,
    params: params,
    conv: {
      params: range(0, params.len()).map(|i: Int| if lent.contains(i) { Lent } else { Given }),
      reps: params.map(|p: Var| p.rep),
      answer: answer,
      answered: Owned,
    },
    answer_ty: TyCon({ name: b"T", args: [] }),
    body: body,
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  }

/// A call of `m.g` handing `args`, each given unless `lent` names it, answering a word.
fn call_of(args: List<Arg>, lent: List<Int>) -> Val =
  Call({
    callee: Root(Named(b"m.g")),
    args: args,
    conv: {
      params: range(0, args.len()).map(|i: Int| if lent.contains(i) { Lent } else { Given }),
      reps: args.map(rep_of_arg),
      answer: RWord,
      answered: Owned,
    },
    stops: false,
  })

fn bind(v: Var, val: Val, unwind: List<Var>) -> Inst =
  Let({ var: v, val: val, at: dummy_span(), unwind: unwind })

/// What the pass makes of `f`'s body, and why the check refuses the result, if it does.
fn counted_body(f: Fn) -> { body: Block, refused: Option<Bytes> } = {
  let o = owned(f);
  { body: o.body, refused: verified(o) }
}

/// `f` with `body`, as the check reads it.
fn refused_with(f: Fn, body: Block) -> Option<Bytes> = verified({ ..f, body: body })

test "a word read as the box it is views its words, taking nothing, and a leaf is read out of the word" {
  let scalars = RFlat([{ name: b"h", rep: RFloat }, { name: b"w", rep: RInt }]);
  let p = word(0);
  let x = { id: 1, ty: p.ty, rep: scalars };
  let viewed = bind(x, Pack({ arg: AVar(p), to: scalars }), []);
  let leaf = bind({ id: 3, ty: p.ty, rep: RInt }, Get({ of: x, path: PLeaf(1) }), []);
  // Neither a word the body holds nor one it is lent is counted to be viewed.
  let held = root_of([p], [], RWord, [viewed, leaf, Return(AVar(p))]);
  assert_eq(counted_body(held), { body: [viewed, leaf, Return(AVar(p))], refused: None });
  let lent = root_of([p], [0], RInt, [viewed, leaf, Return(AInt(0))]);
  assert_eq(counted_body(lent), { body: [viewed, leaf, Return(AInt(0))], refused: None });
  // A view nothing reads is not made.
  assert_eq(counted_body(root_of([p], [], RWord, [viewed, Return(AVar(p))])).body, [
    Return(AVar(p)),
  ]);
  // A leaf of a lent word's view is the word's to hand back borrowed, as a field read off it is.
  let named = RFlat([{ name: b"data", rep: RInt }, { name: b"name", rep: RWord }]);
  let r = { id: 1, ty: p.ty, rep: named };
  let s = { id: 2, ty: p.ty, rep: RWord };
  let reader = root_of([p], [0], RWord, [
    bind(r, Pack({ arg: AVar(p), to: named }), []),
    bind(s, Get({ of: r, path: PLeaf(1) }), []),
    Return(AVar(s)),
  ]);
  assert_eq(
    counted_body({
      ..reader,
      conv: { ..reader.conv, answered: Borrowed([{ param: 0, whole: false }]) },
    }).refused,
    None,
  )
}

test "a value consumed again later takes a count first, and its last use moves" {
  let p = word(0);
  let r = word(1);
  let s = word(2);
  let f = root_of([p], [], RWord, [
    bind(r, call_of([AVar(p)], []), []),
    bind(s, call_of([AVar(p), AVar(r)], []), []),
    Return(AVar(s)),
  ]);
  let counts = [
    Inc({ var: p, n: 1 }),
    bind(r, call_of([AVar(p)], []), [p]),
    bind(s, call_of([AVar(p), AVar(r)], []), []),
    Return(AVar(s)),
  ];
  assert_eq(counted_body(f), { body: counts, refused: None });
  // The first call can fail holding the count the second call takes, which its path releases.
  assert_eq(
    refused_with(f, counts.set(1, bind(r, call_of([AVar(p)], []), []))),
    Some(b"a failure path that releases other than what it holds"),
  )
}

test "a value one instruction both consumes and reads takes a count for the consuming use, and dies after it" {
  let p = word(0);
  let q = word(1);
  let r = word(2);
  let both = call_of([AVar(p), AVar(p)], [1]);
  assert_eq(counted_body(root_of([p], [], RWord, [bind(r, both, []), Return(AVar(r))])), {
    body: [Inc({ var: p, n: 1 }), bind(r, both, [p]), Dec(p), Return(AVar(r))],
    refused: None,
  });
  // A restart hands on what it passes and lets go of the rest first.
  assert_eq(counted_body(root_of([p, q], [], RWord, [Restart([AVar(p), AVar(p)])])), {
    body: [Dec(q), Inc({ var: p, n: 1 }), Restart([AVar(p), AVar(p)])],
    refused: None,
  })
}

test "a function value applied is lent to the call, held across each and let go of after the last" {
  let f = word(0);
  let x = word(1);
  let r = word(2);
  let r2 = word(3);
  let applied = |arg: Var|
    Apply({
      f: AVar(f),
      args: [AVar(arg)],
      conv: { params: [Given], reps: [RWord], answer: RWord, answered: Owned },
      stops: false,
    });
  assert_eq(
    counted_body(
      root_of([f, x], [], RWord, [
        bind(r, applied(x), []),
        bind(r2, applied(r), []),
        Return(AVar(r2)),
      ]),
    ),
    {
      body: [bind(r, applied(x), [f]), bind(r2, applied(r), [f]), Dec(f), Return(AVar(r2))],
      refused: None,
    },
  )
}

test "a closure laid on this frame's stack reads its captures, which are let go of after the call" {
  let cap = word(0);
  let c = word(1);
  let r = word(2);
  let laid = |unwind: List<Var>|
    bind(
      c,
      Make({
        made: MClosure({ nth: 0, captures: 1, params: 1, stacked: true }),
        args: [AVar(cap)],
        reuse: None,
      }),
      unwind,
    );
  let f = root_of([cap], [], RWord, [
    laid([]),
    bind(r, call_of([AVar(c)], []), []),
    Return(AVar(r)),
  ]);
  assert_eq(counted_body(f), {
    body: [laid([]), bind(r, call_of([AVar(c)], []), [cap]), Dec(cap), Return(AVar(r))],
    refused: None,
  });
  // Handed on whole, the closure would outlive the frame it lies on.
  assert_eq(
    refused_with(f, [laid([]), Return(AVar(c))]),
    Some(b"a closure on this frame's stack handed beyond the call it is lent to: v1"),
  )
}

test "the closures a root makes are counted as roots of their own" {
  let p = word(0);
  let q = word(1);
  let lambda = { ..root_of([p, q], [], RWord, [Return(AVar(q))]), key: Named(b"m.f#0") };
  let closure = |body: Fn| Closure({ body: body, captures: 0, at: dummy_span() });
  let f = { ..root_of([], [], RInt, [Return(AInt(0))]), lambdas: [closure(lambda)] };
  let o = owned(f);
  assert_eq(o.lambdas, [closure({ ..lambda, body: [Dec(p), Return(AVar(q))] })]);
  assert_eq(verified(o), None);
  assert_eq(verified(f), Some(b"in closure 0: a count left held where the body answers: v0"))
}

test "an owned value nothing reads is let go of where it is made, an unread parameter at the head" {
  let p = word(0);
  let q = word(1);
  let r = word(2);
  let f = root_of([p, q], [], RInt, [bind(r, call_of([AVar(q)], []), []), Return(AInt(0))]);
  let counts = [Dec(p), bind(r, call_of([AVar(q)], []), []), Dec(r), Return(AInt(0))];
  assert_eq(counted_body(f), { body: counts, refused: None });
  // Without its release the answer's count is never let go of.
  assert_eq(
    refused_with(f, counts.remove_at(2)),
    Some(b"a count left held where the body answers: v2"),
  )
}

test "a branch lets go first of what only the other branch reads" {
  let c = flag(0);
  let p = word(1);
  let q = word(2);
  let f = root_of([c, p, q], [], RWord, [
    If({ cond: AVar(c), then: [Return(AVar(p))], otherwise: [Return(AVar(q))] }),
  ]);
  let branch = |then: List<Inst>|
    [If({ cond: AVar(c), then: then, otherwise: [Dec(p), Return(AVar(q))] })];
  assert_eq(counted_body(f), { body: branch([Dec(q), Return(AVar(p))]), refused: None });
  // Letting go twice of one count.
  assert_eq(
    refused_with(f, branch([Dec(q), Dec(q), Return(AVar(p))])),
    Some(b"a value consumed with no count left: v2"),
  )
}

test "a record held in place is never taken out of its block, however its reader is held" {
  let inner = TyRecord([
    { name: b"a", ty: TyCon({ name: b"Int", args: [] }) },
    { name: b"s", ty: TyCon({ name: b"String", args: [] }) },
  ]);
  let r = {
    id: 0,
    ty: TyRecord([
      { name: b"in", ty: inner },
      { name: b"t", ty: TyCon({ name: b"String", args: [] }) },
    ]),
    rep: RWord,
  };
  let x = { id: 1, ty: inner, rep: RWord };
  let get = bind(x, Get({ of: r, path: PField({ name: b"in", at: 0 }) }), []);
  assert_eq(counted_body(root_of([r], [], RWord, [get, Return(AVar(x))])), {
    body: [get, Inc({ var: x, n: 1 }), Dec(r), Return(AVar(x))],
    refused: None,
  });
  // A field held as its word beside it is taken.
  let y = word(1);
  let t = bind(y, Get({ of: r, path: PField({ name: b"t", at: 4 }) }), []);
  assert_eq(counted_body(root_of([r], [], RWord, [t, Return(AVar(y))])), {
    body: [
      bind(y, Take({ of: r, path: PField({ name: b"t", at: 4 }) }), []),
      Dec(r),
      Return(AVar(y)),
    ],
    refused: None,
  })
}

test "a field of a sum's payload, the sum read out of a record, keeps the record held until it is read" {
  let t = of_type(0, b"m.T");
  let o = {
    id: 1,
    ty: TyCon({ name: b"Option", args: [TyCon({ name: b"m.C", args: [] })] }),
    rep: maybe_word(),
  };
  let c = of_type(2, b"m.C");
  let b = word(3);
  let r = word(4);
  let reads = [
    bind(c, Get({ of: o, path: PCase({ case: 1, at: 0 }) }), []),
    bind(b, Get({ of: c, path: PField({ name: b"binder", at: 0 }) }), []),
  ];
  let cased = |arm: List<Inst>, rest: List<Inst>|
    [
      bind(o, Get({ of: t, path: PField({ name: b"cases", at: 1 }) }), []),
      Case({
        on: o,
        test: TTag([b"None", b"Some"]),
        arms: [{ when: 1, body: reads.concat(arm) }],
        rest: rest.push(Return(AZero(RWord))),
      }),
    ];
  let f = root_of(
    [t],
    [],
    RWord,
    cased([bind(r, call_of([AVar(b)], [0]), []), Return(AVar(r))], []),
  );
  assert_eq(counted_body(f), {
    body: cased([bind(r, call_of([AVar(b)], [0]), [t]), Dec(t), Return(AVar(r))], [Dec(t)]),
    refused: None,
  });
  // The record let go of before the payload's field is read.
  assert_eq(
    refused_with(
      f,
      cased([Dec(t), bind(r, call_of([AVar(b)], [0]), []), Return(AVar(r))], [Dec(t)]),
    ),
    Some(b"a value read after what it was read out of was let go: v3"),
  )
}

test "a value read out of a value read out of another keeps the first one live" {
  let p = word(0);
  let y = word(1);
  let z = word(2);
  let r = word(3);
  let reads = [
    bind(y, Get({ of: p, path: PField({ name: b"a", at: 0 }) }), []),
    bind(z, Get({ of: y, path: PField({ name: b"b", at: 0 }) }), []),
  ];
  let f = root_of(
    [p],
    [],
    RWord,
    reads.concat([bind(r, call_of([AVar(z)], [0]), []), Return(AVar(r))]),
  );
  assert_eq(counted_body(f), {
    body: reads.concat([bind(r, call_of([AVar(z)], [0]), [p]), Dec(p), Return(AVar(r))]),
    refused: None,
  });
  assert_eq(
    refused_with(f, reads.concat([Dec(p), bind(r, call_of([AVar(z)], [0]), []), Return(AVar(r))])),
    Some(b"a value read after what it was read out of was let go: v2"),
  )
}

test "an address into a block's bytes keeps the block held until it is read through, and takes no count" {
  let b = word(0);
  let a = { ..int(1), rep: RAddr };
  let n = int(2);
  let r = word(3);
  let addressed = bind(a, Get({ of: b, path: PPayload }), []);
  let byte = bind(
    n,
    Op({ op: OStrings(ByteRead), args: [AVar(a), AInt(0)], uses: string_uses(ByteRead) }),
    [],
  );
  assert_eq(counted_body(root_of([b], [], RInt, [addressed, byte, Return(AVar(n))])), {
    body: [addressed, byte, Dec(b), Return(AVar(n))],
    refused: None,
  });
  // Handed on before it is read through, the block is counted once more to outlive the read.
  let handed = counted_body(
    root_of([b], [], RInt, [addressed, bind(r, call_of([AVar(b)], []), []), byte, Return(AVar(n))]),
  );
  assert_eq(handed.refused, None);
  assert_eq([Inc({ var: b, n: 1 }), Dec(b)].map(|i: Inst| handed.body.contains(i)), [true, true])
}

test "a value read out of another keeps that one live until its last read" {
  let p = word(0);
  let x = word(1);
  let r = word(2);
  let get = bind(x, Get({ of: p, path: PField({ name: b"f", at: 0 }) }), []);
  let read = root_of([p], [], RWord, [get, bind(r, call_of([AVar(x)], [0]), []), Return(AVar(r))]);
  let counts = [get, bind(r, call_of([AVar(x)], [0]), [p]), Dec(p), Return(AVar(r))];
  assert_eq(counted_body(read), { body: counts, refused: None });
  // The record let go of before the read of its field.
  assert_eq(
    refused_with(read, [get, Dec(p), bind(r, call_of([AVar(x)], [0]), []), Return(AVar(r))]),
    Some(b"a value read after what it was read out of was let go: v1"),
  );
  // A field handed on is taken out of the record, which then holds no count of it.
  let take = bind(x, Take({ of: p, path: PField({ name: b"f", at: 0 }) }), []);
  assert_eq(counted_body(root_of([p], [], RWord, [get, Return(AVar(x))])), {
    body: [take, Dec(p), Return(AVar(x))],
    refused: None,
  });
  // A record handed on whole too keeps its field, which the field's reader then counts again.
  let c = flag(3);
  let both = |then: List<Inst>, otherwise: List<Inst>|
    [
      get,
      If({
        cond: AVar(c),
        then: then.push(Return(AVar(p))),
        otherwise: otherwise.push(Return(AVar(x))),
      }),
    ];
  assert_eq(counted_body(root_of([p, c], [], RWord, both([], []))), {
    body: both([], [Inc({ var: x, n: 1 }), Dec(p)]),
    refused: None,
  })
}

/// A list of `m.Nil`, the zero word, and `m.Cons`, a box of two words.
fn boxed_list() -> Rep =
  RSum({
    laid: {
      classes: [P],
      cases: [
        { test: WordIs({ at: 0, value: 0 }), payload: Nullary },
        {
          test: WordOutside({ at: 0, values: [0] }),
          payload: Boxed({ at: 0, stripped: false, skip: 0, laid: LWords([P, P]) }),
        },
      ],
    },
    cases: [b"m.Nil", b"m.Cons"],
  })

/// The box an `m.Cons` of `boxed_list` is held in, numbered `id`.
fn cons_box(id: Int) -> Var =
  {
    id: id,
    ty: of_type(0, b"m.L").ty,
    rep: match boxed_case_of(boxed_list(), 1) { Some(r) -> r, None -> RWord },
  }

test "a value read out of a node, used past the case made in the node's box, takes a count of its own so the box is reused" {
  let t = { ..of_type(0, b"m.L"), rep: boxed_list() };
  let y = word(1);
  let n = of_type(2, b"m.L");
  let r = word(3);
  let box = cons_box(4);
  let token = { id: 5, ty: t.ty, rep: RToken(2) };
  let read = bind(y, Get({ of: t, path: PCase({ case: 1, at: 1 }) }), []);
  let made = |reuse: Option<Var>|
    bind(
      n,
      Make({ made: MCase({ case: 1, skip: 0, words: 2 }), args: [AInt(1), AInt(2)], reuse: reuse }),
      [],
    );
  let on = |arm: List<Inst>, rest: List<Inst>|
    [
      Case({
        on: t,
        test: TTag([b"m.Nil", b"m.Cons"]),
        arms: [{ when: 1, body: arm }],
        rest: rest.push(Return(AZero(RWord))),
      }),
    ];
  let f = root_of(
    [t],
    [],
    RWord,
    on([read, made(None), bind(r, call_of([AVar(y)], [0]), []), Return(AVar(n))], []),
  );
  assert_eq(counted_body(f), {
    body: on(
      [
        read,
        Inc({ var: y, n: 1 }),
        Opened({ of: t, words: [box] }),
        Reset({ token: token, of: box }),
        made(Some(token)),
        bind(r, call_of([AVar(y)], [0]), [n, y]),
        Dec(r),
        Dec(y),
        Return(AVar(n)),
      ],
      [Dec(t)],
    ),
    refused: None,
  })
}

test "a value read out of another, used past the other's last use where that use consumes it, takes a count of its own where it is bound" {
  let p = word(0);
  let y = word(1);
  let r = word(2);
  let s = word(3);
  let read = bind(y, Get({ of: p, path: PField({ name: b"f", at: 0 }) }), []);
  let after = |lent: List<Int>|
    root_of([p], [], RWord, [
      read,
      bind(r, call_of([AVar(p)], lent), []),
      bind(s, call_of([AVar(r), AVar(y)], [1]), []),
      Return(AVar(s)),
    ]);
  // The record moves into the first call; the field read out of it is counted where it is read.
  assert_eq(counted_body(after([])), {
    body: [
      read,
      Inc({ var: y, n: 1 }),
      bind(r, call_of([AVar(p)], []), [y]),
      bind(s, call_of([AVar(r), AVar(y)], [1]), [y]),
      Dec(y),
      Return(AVar(s)),
    ],
    refused: None,
  });
  // Only lent to the first call, the record is held until the field's last read.
  assert_eq(counted_body(after([0])), {
    body: [
      read,
      bind(r, call_of([AVar(p)], [0]), [p]),
      bind(s, call_of([AVar(r), AVar(y)], [1]), [p]),
      Dec(p),
      Return(AVar(s)),
    ],
    refused: None,
  })
}

test "a join is set from a value held as the join is, on every path" {
  let c = flag(0);
  let p = word(1);
  let q = word(2);
  let j = word(3);
  let f = root_of([c, p, q], [], RWord, [
    Decl(j),
    If({
      cond: AVar(c),
      then: [Assign({ var: j, arg: AVar(p) })],
      otherwise: [Assign({ var: j, arg: AVar(q) })],
    }),
    Return(AVar(j)),
  ]);
  let joined = |then: List<Inst>|
    [
      Decl(j),
      If({
        cond: AVar(c),
        then: [Dec(q)].concat(then),
        otherwise: [Dec(p), Assign({ var: j, arg: AVar(q) })],
      }),
      Return(AVar(j)),
    ];
  assert_eq(counted_body(f), { body: joined([Assign({ var: j, arg: AVar(p) })]), refused: None });
  let x = { id: 4, ty: TyCon({ name: b"Float", args: [] }), rep: RFloat };
  let sum = Prim({ op: b"add", on: RFloat, args: [AFloat(0), AFloat(0)] });
  assert_eq(
    refused_with(f, joined([bind(x, sum, []), Assign({ var: j, arg: AVar(x) })])),
    Some(b"a join set from a value held otherwise: v3"),
  )
}

test "a word read out of a sum whose case lays it as its one counted word holds the sum's count, which moves on with it" {
  let laid = |classes: List<WordClass>|
    RSum({
      laid: {
        classes: classes,
        cases: [
          { test: Always, payload: Inline({ offset: 0, laid: LWords(classes), stripped: None }) },
        ],
      },
      cases: [b"m.T"],
    });
  let t = { ..of_type(0, b"m.T"), rep: laid([P, layout::raw()]) };
  let out = word(1);
  let n = int(2);
  let reads = [
    bind(out, Get({ of: t, path: PCase({ case: 0, at: 0 }) }), []),
    bind(n, Get({ of: t, path: PCase({ case: 0, at: 1 }) }), []),
  ];
  assert_eq(counted_body(root_of([t], [], RWord, reads.push(Return(AVar(out))))), {
    body: reads.push(Return(AVar(out))),
    refused: None,
  });
  // Where the case lays two counted words, either read is borrowed and counted again.
  let u = { ..t, rep: laid([P, P]) };
  let first = bind(out, Get({ of: u, path: PCase({ case: 0, at: 0 }) }), []);
  assert_eq(counted_body(root_of([u], [], RWord, [first, Return(AVar(out))])), {
    body: [first, Inc({ var: out, n: 1 }), Dec(u), Return(AVar(out))],
    refused: None,
  });
  // A word of the box a case holds is taken out of the box where the sum is held only here.
  let boxed = RSum({
    laid: {
      classes: [P],
      cases: [
        { test: Always, payload: Boxed({ at: 0, stripped: false, skip: 0, laid: LWords([P, P]) }) },
      ],
    },
    cases: [b"m.B"],
  });
  let b = { ..of_type(0, b"m.B"), rep: boxed };
  let read = |val: Val| bind(out, val, []);
  assert_eq(
    counted_body(
      root_of([b], [], RWord, [
        read(Get({ of: b, path: PCase({ case: 0, at: 1 }) })),
        Return(AVar(out)),
      ]),
    ),
    {
      body: [read(Take({ of: b, path: PCase({ case: 0, at: 1 }) })), Dec(b), Return(AVar(out))],
      refused: None,
    },
  )
}

test "a value that holds no count, a static or a case gathered from constants, is given, returned, joined and stored with none" {
  let c = flag(0);
  let p = word(1);
  let s = word(2);
  let r = word(3);
  let q = word(4);
  let j = word(5);
  let none = {
    id: 6,
    ty: TyCon({ name: b"Option", args: [TyCon({ name: b"String", args: [] })] }),
    rep: RSum({
      laid: layout::sum_laid([
        { args: layout::record_laid([]), indirect: false },
        { args: layout::record_laid([LWords([P])]), indirect: false },
      ]),
      cases: [b"None", b"Some"],
    }),
  };
  let lit = bind(s, Static(b"ply_k_0"), []);
  let unchanged = |f: Fn| assert_eq(counted_body(f), { body: f.body, refused: None });
  // Given to two calls, the second taking the first's answer too.
  unchanged(
    root_of([], [], RWord, [
      lit,
      bind(r, call_of([AVar(s)], []), []),
      bind(q, call_of([AVar(s), AVar(r)], []), []),
      Return(AVar(q)),
    ]),
  );
  // Returned.
  unchanged(root_of([], [], RWord, [lit, Return(AVar(s))]));
  // Stored twice in what a body makes.
  unchanged(
    root_of([], [], RWord, [
      lit,
      bind(
        q,
        Make({
          made: MRecord({ names: [b"a", b"b"], width: 2 }),
          args: [AVar(s), AVar(s)],
          reuse: None,
        }),
        [],
      ),
      Return(AVar(q)),
    ]),
  );
  // A join set from it on one path and from a given parameter on the other holds the parameter's
  // count, and on the static's path it holds the static, which needs none; the parameter is let go of
  // where the path does not read it. Set beside only borrowed values, the join is borrowed, read out
  // of nothing for the static.
  assert_eq(
    counted_body(
      root_of([c, p], [], RWord, [
        lit,
        Decl(j),
        If({
          cond: AVar(c),
          then: [Assign({ var: j, arg: AVar(s) })],
          otherwise: [Assign({ var: j, arg: AVar(p) })],
        }),
        Return(AVar(j)),
      ]),
    ),
    {
      body: [
        lit,
        Decl(j),
        If({
          cond: AVar(c),
          then: [Dec(p), Assign({ var: j, arg: AVar(s) })],
          otherwise: [Assign({ var: j, arg: AVar(p) })],
        }),
        Return(AVar(j)),
      ],
      refused: None,
    },
  );
  let lent = root_of([c, p], [1], RWord, [
    lit,
    Decl(j),
    If({
      cond: AVar(c),
      then: [Assign({ var: j, arg: AVar(s) })],
      otherwise: [Assign({ var: j, arg: AVar(p) })],
    }),
    Return(AVar(j)),
  ]);
  unchanged({ ..lent, conv: { ..lent.conv, answered: Borrowed([{ param: 1, whole: true }]) } });
  // A `None` gathered from its constant word, given twice.
  unchanged(
    root_of([], [], RWord, [
      bind(none, Gathered({ parts: [AInt(0)] }), []),
      bind(r, call_of([AVar(none), AVar(none)], []), []),
      Return(AVar(r)),
    ]),
  )
}

test "a join set from a value read out of one bound inside its branch holds a count of its own" {
  let c = flag(0);
  let p = word(1);
  let s = word(2);
  let t = word(3);
  let r = of_type(4, b"m.T");
  let y = word(5);
  let z = word(6);
  let j = word(7);
  let field = PField({ name: b"f", at: 0 });
  // The field is read twice, so it is not taken out of `r`.
  let read = [
    bind(r, call_of([AVar(p)], [0]), []),
    bind(y, Get({ of: r, path: field }), []),
    bind(z, Get({ of: r, path: field }), []),
  ];
  let joined = |then: Block|
    counted_body(
      root_of([c, p], [1], RWord, [
        Decl(j),
        If({ cond: AVar(c), then: then, otherwise: read.push(Assign({ var: j, arg: AVar(y) })) }),
        Return(AVar(j)),
      ]),
    );
  let after = |then: Block|
    [
      Decl(j),
      If({
        cond: AVar(c),
        then: then,
        otherwise: read.concat([Inc({ var: y, n: 1 }), Dec(r), Assign({ var: j, arg: AVar(y) })]),
      }),
      Return(AVar(j)),
    ];
  // Beside a static or a read out of a lent parameter, either of which outlives the branch.
  let lit = [bind(s, Static(b"ply_k_0"), []), Assign({ var: j, arg: AVar(s) })];
  assert_eq(joined(lit), { body: after(lit), refused: None });
  let lent = [bind(t, Get({ of: p, path: field }), []), Assign({ var: j, arg: AVar(t) })];
  assert_eq(joined(lent), {
    body: after([
      bind(t, Get({ of: p, path: field }), []),
      Inc({ var: t, n: 1 }),
      Assign({ var: j, arg: AVar(t) }),
    ]),
    refused: None,
  })
}

test "an answer handed back borrowed takes no count, and a join of borrowed values is borrowed of each" {
  let p = word(0);
  let y = word(1);
  let read = bind(y, Get({ of: p, path: PField({ name: b"f", at: 0 }) }), []);
  let getter = |answered: Returned| {
    let f = root_of([p], [0], RWord, [read, Return(AVar(y))]);
    { ..f, conv: { ..f.conv, answered: answered } }
  };
  assert_eq(counted_body(getter(Borrowed([{ param: 0, whole: false }]))), {
    body: [read, Return(AVar(y))],
    refused: None,
  });
  assert_eq(counted_body(getter(Owned)), {
    body: [read, Inc({ var: y, n: 1 }), Return(AVar(y))],
    refused: None,
  });
  let c = flag(2);
  let q = word(3);
  let j = word(4);
  let set = |x: Var| [Assign({ var: j, arg: AVar(x) })];
  let branch = If({ cond: AVar(c), then: set(p), otherwise: set(q) });
  let pick = |answered: Returned| {
    let f = root_of([c, p, q], [1, 2], RWord, [Decl(j), branch, Return(AVar(j))]);
    { ..f, conv: { ..f.conv, answered: answered } }
  };
  assert_eq(
    counted_body(pick(Borrowed([{ param: 1, whole: true }, { param: 2, whole: true }]))),
    { body: [Decl(j), branch, Return(AVar(j))], refused: None },
  );
  // Answered owned, the join takes one count where it is handed back, not one on each path.
  assert_eq(counted_body(pick(Owned)), {
    body: [Decl(j), branch, Inc({ var: j, n: 1 }), Return(AVar(j))],
    refused: None,
  });
  // A value held again as an `Option`'s word, packed or gathered, is borrowed as the value is.
  let o = {
    id: 5,
    ty: TyCon({ name: b"Option", args: [TyCon({ name: b"String", args: [] })] }),
    rep: maybe_word(),
  };
  let some = |val: Val, answered: Returned| {
    let f = root_of([p], [0], maybe_word(), [bind(o, val, []), Return(AVar(o))]);
    { ..f, conv: { ..f.conv, answered: answered } }
  };
  [Pack({ arg: AVar(p), to: maybe_word() }), Gathered({ parts: [AInt(1), AVar(p)] })].fold(
    (),
    |_: Unit, val: Val| {
      assert_eq(counted_body(some(val, Borrowed([{ param: 0, whole: true }]))), {
        body: [bind(o, val, []), Return(AVar(o))],
        refused: None,
      });
      assert_eq(counted_body(some(val, Owned)), {
        body: [bind(o, val, []), Inc({ var: o, n: 1 }), Return(AVar(o))],
        refused: None,
      })
    },
  );
  // A case gathered from no counted word holds nothing, so either path answers borrowed.
  let none = { ..o, id: 6 };
  let either = { ..o, id: 7 };
  let maybe = If({
    cond: AVar(c),
    then: [
      bind(o, Gathered({ parts: [AInt(1), AVar(p)] }), []),
      Assign({ var: either, arg: AVar(o) }),
    ],
    otherwise: [
      bind(none, Gathered({ parts: [AInt(0)] }), []),
      Assign({ var: either, arg: AVar(none) }),
    ],
  });
  let found = root_of([c, p], [0, 1], maybe_word(), [Decl(either), maybe, Return(AVar(either))]);
  assert_eq(
    counted_body({
      ..found,
      conv: { ..found.conv, answered: Borrowed([{ param: 1, whole: true }]) },
    }),
    { body: [Decl(either), maybe, Return(AVar(either))], refused: None },
  )
}

test "a sum's payload that is its one count, held again as another sum's word, is borrowed as the sum is" {
  let text = TyCon({ name: b"String", args: [] });
  let opt = |inner: Type| TyCon({ name: b"Option", args: [inner] });
  let m = { id: 0, ty: opt(text), rep: maybe_word() };
  let s = word(1);
  let y = { id: 2, ty: opt(text), rep: maybe_word() };
  let some_of = |of: Var| bind(s, Get({ of: of, path: PCase({ case: 1, at: 0 }) }), []);
  let answering = |p: Var, body: Block, answered: Returned| {
    let f = root_of([p], [0], maybe_word(), body);
    { ..f, conv: { ..f.conv, answered: answered } }
  };
  let whole = Borrowed([{ param: 0, whole: true }]);
  // `Some(x) -> Some(x)`, packed or gathered.
  [Pack({ arg: AVar(s), to: maybe_word() }), Gathered({ parts: [AInt(1), AVar(s)] })].fold(
    (),
    |_: Unit, val: Val| {
      let body = [some_of(m), bind(y, val, []), Return(AVar(y))];
      assert_eq(counted_body(answering(m, body, whole)), { body: body, refused: None });
      assert_eq(counted_body(answering(m, body, Owned)), {
        body: [some_of(m), bind(y, val, []), Inc({ var: y, n: 1 }), Return(AVar(y))],
        refused: None,
      })
    },
  );
  let again = bind(y, Gathered({ parts: [AInt(1), AVar(s)] }), []);
  // `Some(V(x)) -> Some(x)`: a payload's payload is the outer sum's count.
  let v = TyCon({ name: b"m.V", args: [] });
  let n = { id: 0, ty: opt(v), rep: maybe_word() };
  let inner = {
    id: 3,
    ty: v,
    rep: RSum({
      laid: {
        classes: [P],
        cases: [
          { test: Always, payload: Inline({ offset: 0, laid: LWords([P]), stripped: None }) },
        ],
      },
      cases: [b"m.V"],
    }),
  };
  let nested = [
    bind(inner, Get({ of: n, path: PCase({ case: 1, at: 0 }) }), []),
    bind(s, Get({ of: inner, path: PCase({ case: 0, at: 0 }) }), []),
    again,
    Return(AVar(y)),
  ];
  assert_eq(counted_body(answering(n, nested, whole)), { body: nested, refused: None });
  // `match r.f { Some(x) -> Some(x) }`: the sum read out of what the root is lent.
  let r = word(0);
  let f = { ..m, id: 3 };
  let field = [
    bind(f, Get({ of: r, path: PField({ name: b"f", at: 0 }) }), []),
    some_of(f),
    again,
    Return(AVar(y)),
  ];
  assert_eq(counted_body(answering(r, field, Borrowed([{ param: 0, whole: false }]))), {
    body: field,
    refused: None,
  })
}

test "a record is made by value, so one let go of lends its cells to none" {
  let r = of_type(0, b"m.T");
  let v = word(1);
  let a = word(2);
  let n = of_type(3, b"m.T");
  let token = { ..of_type(4, b"m.T"), rep: RToken(2) };
  let get = bind(a, Get({ of: r, path: PField({ name: b"a", at: 0 }) }), []);
  let take = bind(a, Take({ of: r, path: PField({ name: b"a", at: 0 }) }), []);
  let make = |reuse: Option<Var>|
    Make({
      made: MRecord({ names: [b"a", b"b"], width: 2 }),
      args: [AVar(a), AVar(v)],
      reuse: reuse,
    });
  let f = root_of([r, v], [], RWord, [get, bind(n, make(None), []), Return(AVar(n))]);
  assert_eq(counted_body(f), {
    body: [take, Dec(r), bind(n, make(None), []), Return(AVar(n))],
    refused: None,
  });
  // Its printer would make it afresh and leak the cells.
  assert_eq(
    refused_with(f, [
      take,
      Reset({ token: token, of: r }),
      bind(n, make(Some(token)), []),
      Return(AVar(n)),
    ]),
    Some(b"a value made in cells its printer does not take: v3"),
  )
}

test "a boxed case takes the cells of a sum let go of in an arm that knows it holds a box of as many words" {
  let list = RSum({
    laid: {
      classes: [P],
      cases: [
        { test: WordIs({ at: 0, value: 0 }), payload: Nullary },
        {
          test: WordOutside({ at: 0, values: [0] }),
          payload: Boxed({ at: 0, stripped: false, skip: 0, laid: LWords([P, P]) }),
        },
      ],
    },
    cases: [b"m.Nil", b"m.Cons"],
  });
  let t = { ..of_type(0, b"m.L"), rep: list };
  let n = of_type(1, b"m.L");
  let made = |words: Int, reuse: Option<Var>|
    bind(
      n,
      Make({
        made: MCase({ case: 1, skip: 0, words: words }),
        args: [AInt(1), AInt(2)],
        reuse: reuse,
      }),
      [],
    );
  let on = |arm: List<Inst>, rest: List<Inst>|
    [
      Case({
        on: t,
        test: TTag([b"m.Nil", b"m.Cons"]),
        arms: [{ when: 1, body: arm }],
        rest: rest.push(Return(AZero(RWord))),
      }),
    ];
  let cased = |arm: List<Inst>| on(arm, [Dec(t)]);
  let f = |words: Int| root_of([t], [], RWord, on([made(words, None), Return(AVar(n))], []));
  let box = { id: 2, ty: t.ty, rep: match boxed_case_of(list, 1) { Some(r) -> r, None -> RWord } };
  let token = { id: 3, ty: t.ty, rep: RToken(2) };
  assert_eq(
    owned(f(2)).body,
    cased([
      Opened({ of: t, words: [box] }),
      Reset({ token: token, of: box }),
      made(2, Some(token)),
      Return(AVar(n)),
    ]),
  );
  // A box of another size lays its words otherwise.
  assert_eq(owned(f(3)).body, cased([Dec(t), made(3, None), Return(AVar(n))]))
}

test "a token held across a call that can fail or stop is released on its way out" {
  let r = { ..of_type(0, b"m.L"), rep: boxed_list() };
  let v = word(1);
  let a = word(2);
  let w = word(3);
  let n = of_type(4, b"m.L");
  let box = cons_box(5);
  let token = { id: 6, ty: r.ty, rep: RToken(2) };
  let get = bind(a, Get({ of: r, path: PCase({ case: 1, at: 0 }) }), []);
  let take = bind(a, Take({ of: r, path: PCase({ case: 1, at: 0 }) }), []);
  let make = |reuse: Option<Var>|
    Make({ made: MCase({ case: 1, skip: 0, words: 2 }), args: [AVar(w), AVar(v)], reuse: reuse });
  let called = |stops: Bool|
    match call_of([AVar(a)], []) { Call(c) -> Call({ ..c, stops: stops }), other -> other };
  let consed = |arm: List<Inst>, rest: List<Inst>|
    [
      Case({
        on: r,
        test: TTag([b"m.Nil", b"m.Cons"]),
        arms: [{ when: 1, body: arm }],
        rest: rest.push(Return(AVar(v))),
      }),
    ];
  let f = |stops: Bool|
    root_of(
      [r, v],
      [],
      RWord,
      consed([get, bind(w, called(stops), []), bind(n, make(None), []), Return(AVar(n))], []),
    );
  let counts = |stops: Bool, unwind: List<Var>|
    consed(
      [
        take,
        Opened({ of: r, words: [box] }),
        Reset({ token: token, of: box }),
        bind(w, called(stops), unwind),
        bind(n, make(Some(token)), []),
        Return(AVar(n)),
      ],
      [Dec(r)],
    );
  assert_eq(counted_body(f(false)), { body: counts(false, [v, token]), refused: None });
  assert_eq(
    refused_with(f(false), counts(false, [v])),
    Some(b"a failure path that releases other than what it holds"),
  );
  // Across a call that may stop the token is held as across one that fails: the frame record that
  // holds the path frees it where a resumption could come more than once, and the make allocates.
  assert_eq(counted_body(f(true)), { body: counts(true, [v, token]), refused: None })
}

test "a value that may stop but cannot fail names what the path holds, which its frame record holds" {
  let p = word(0);
  let y = word(1);
  let stop = Native({
    name: b"m.yield",
    args: [],
    uses: { takes: [], owned: true, fails: false, stops: true },
  });
  assert_eq(counted_body(root_of([p], [], RWord, [bind(y, stop, []), Return(AVar(p))])), {
    body: [bind(y, stop, [p]), Dec(y), Return(AVar(p))],
    refused: None,
  })
}

test "an arm lets go before it misses of what only it reads" {
  let p = word(0);
  let q = word(1);
  let matched = |then: List<Inst>, miss: List<Inst>|
    [
      Match({
        arms: [[If({ cond: ABool(true), then: then, otherwise: miss })], [Return(AVar(q))]],
        rest: [Fail({ why: NoArm, at: dummy_span() })],
      }),
    ];
  let f = root_of([p, q], [], RWord, matched([Return(AVar(p))], [Miss]));
  assert_eq(counted_body(f), {
    body: matched([Dec(q), Return(AVar(p))], [Dec(p), Miss]),
    refused: None,
  });
  assert_eq(
    refused_with(f, matched([Dec(q), Return(AVar(p))], [Miss])),
    Some(b"a count left held where the body answers: v0"),
  )
}

test "an arm lets go before a miss however deep of what it read with a count of its own" {
  let xs = word(0);
  let q = word(1);
  let x = word(2);
  let y = word(3);
  let item = |of: Var|
    Native({
      name: b"rt_list_at_p",
      args: [AVar(of), AInt(0)],
      uses: { takes: [false, false], owned: true, fails: false, stops: false },
    });
  let cased = |on: Var, arm: List<Inst>, rest: List<Inst>|
    Case({ on: on, test: TLength({ at_least: 1 }), arms: [{ when: 0, body: arm }], rest: rest });
  let matched = |first: List<Inst>|
    [Match({ arms: [first, [Return(AVar(xs))]], rest: [Fail({ why: NoArm, at: dummy_span() })] })];
  let f = root_of(
    [xs, q],
    [],
    RWord,
    matched([
      bind(x, item(xs), []),
      cased(x, [bind(y, item(x), []), cased(y, [Return(AVar(q))], [Miss])], [Miss]),
    ]),
  );
  assert_eq(counted_body(f), {
    body: matched([
      bind(x, item(xs), []),
      cased(
        x,
        [
          bind(y, item(x), []),
          Dec(x),
          cased(y, [Dec(xs), Dec(y), Return(AVar(q))], [Dec(q), Dec(y), Miss]),
        ],
        [Dec(q), Dec(x), Miss],
      ),
    ]),
    refused: None,
  })
}

test "a sum let go of before a branch lends its box to the arms that make a case of its size" {
  let r = { ..of_type(0, b"m.L"), rep: boxed_list() };
  let c = flag(1);
  let v = word(2);
  let n = of_type(3, b"m.L");
  let box = cons_box(4);
  let token = { id: 5, ty: r.ty, rep: RToken(2) };
  let make = |reuse: Option<Var>|
    bind(
      n,
      Make({ made: MCase({ case: 1, skip: 0, words: 2 }), args: [AInt(1), AVar(v)], reuse: reuse }),
      [],
    );
  let branch = |then: Inst, otherwise: List<Inst>|
    If({
      cond: AVar(c),
      then: [then, Return(AVar(n))],
      otherwise: otherwise.push(Return(AVar(v))),
    });
  let consed = |arm: List<Inst>, rest: List<Inst>|
    [
      Case({
        on: r,
        test: TTag([b"m.Nil", b"m.Cons"]),
        arms: [{ when: 1, body: arm }],
        rest: rest.push(Return(AVar(v))),
      }),
    ];
  let f = root_of([r, c, v], [], RWord, consed([branch(make(None), [])], []));
  let free = Free({ of: token, bytes: AInt(32) });
  let counts = |otherwise: List<Inst>|
    consed(
      [
        Opened({ of: r, words: [box] }),
        Reset({ token: token, of: box }),
        branch(make(Some(token)), otherwise),
      ],
      [Dec(r)],
    );
  // The arm that makes none frees the cells.
  assert_eq(counted_body(f), { body: counts([free]), refused: None });
  assert_eq(refused_with(f, counts([])), Some(b"a count left held where the body answers: v5"))
}

test "a sum let go of before a branch lends its box to a case made after it, carried through the branch" {
  let r = { ..of_type(0, b"m.L"), rep: boxed_list() };
  let c = flag(1);
  let v = word(2);
  let n = of_type(3, b"m.L");
  let w = word(4);
  let box = cons_box(5);
  let token = { id: 6, ty: r.ty, rep: RToken(2) };
  let make = |reuse: Option<Var>|
    bind(
      n,
      Make({ made: MCase({ case: 1, skip: 0, words: 2 }), args: [AInt(1), AVar(v)], reuse: reuse }),
      [],
    );
  let branch = |then: List<Inst>, otherwise: List<Inst>|
    If({ cond: AVar(c), then: then.push(Return(AVar(v))), otherwise: otherwise });
  let consed = |arm: List<Inst>, rest: List<Inst>|
    [
      Case({
        on: r,
        test: TTag([b"m.Nil", b"m.Cons"]),
        arms: [{ when: 1, body: arm.push(Return(AVar(n))) }],
        rest: rest.push(Return(AVar(v))),
      }),
    ];
  let f = root_of(
    [r, c, v],
    [],
    RWord,
    consed([branch([], [bind(w, call_of([], []), [])]), make(None)], []),
  );
  let counts = |then: List<Inst>, unwind: List<Var>|
    consed(
      [
        Opened({ of: r, words: [box] }),
        Reset({ token: token, of: box }),
        branch(then, [bind(w, call_of([], []), unwind), Dec(w)]),
        make(Some(token)),
      ],
      [Dec(r)],
    );
  let free = Free({ of: token, bytes: AInt(32) });
  // The arm that leaves the body frees the cells first; the call that can fail releases them on its
  // failure path.
  assert_eq(counted_body(f), { body: counts([free], [v, token]), refused: None });
  assert_eq(
    refused_with(f, counts([], [v, token])),
    Some(b"a count left held where the body answers: v6"),
  );
  assert_eq(
    refused_with(f, counts([free], [v])),
    Some(b"a failure path that releases other than what it holds"),
  )
}

test "a loop holds what its body reads across its passes, and lets it go after" {
  let p = word(0);
  let q = word(1);
  let s = word(2);
  let c = flag(3);
  let n = word(4);
  let a = word(5);
  let cond = bind(c, Prim({ op: b"eq", on: RInt, args: [AInt(1), AInt(2)] }), []);
  let looped = |pass: List<Inst>, after: List<Inst>|
    [
      Loop({
        state: [s],
        init: [AVar(q)],
        body: [
          cond,
          If({ cond: AVar(c), then: [Done(AVar(s))], otherwise: pass.push(Next([AVar(n)])) }),
        ],
        answer: a,
      }),
    ].concat(
      after,
    ).push(
      Return(AVar(a)),
    );
  let f = root_of([p, q], [], RWord, looped([bind(n, call_of([AVar(p), AVar(s)], []), [])], []));
  assert_eq(counted_body(f), {
    body: looped([Inc({ var: p, n: 1 }), bind(n, call_of([AVar(p), AVar(s)], []), [p])], [Dec(p)]),
    refused: None,
  });
  // A pass that consumes the count the loop holds across its passes.
  assert_eq(
    refused_with(f, looped([bind(n, call_of([AVar(p), AVar(s)], []), [])], [Dec(p)])),
    Some(b"a count held otherwise than the loop holds where it passes again: v0"),
  )
}

test "a pass that leaves the root lets go first of what the loop holds across its passes" {
  let p = word(0);
  let q = word(1);
  let s = word(2);
  let c = flag(3);
  let n = word(4);
  let a = word(5);
  let cond = bind(c, Prim({ op: b"eq", on: RInt, args: [AInt(1), AInt(2)] }), []);
  let looped = |leaving: List<Inst>, unwind: List<Var>, after: List<Inst>|
    [
      Loop({
        state: [s],
        init: [AVar(q)],
        body: [
          cond,
          If({
            cond: AVar(c),
            then: leaving.push(Return(AVar(s))),
            otherwise: [bind(n, call_of([AVar(p), AVar(s)], [0]), unwind), Next([AVar(n)])],
          }),
        ],
        answer: a,
      }),
    ].concat(
      after,
    ).push(
      Return(AVar(a)),
    );
  let f = root_of([p, q], [], RWord, looped([], [], []));
  assert_eq(counted_body(f), { body: looped([Dec(p)], [p], [Dec(p)]), refused: None });
  assert_eq(
    refused_with(f, looped([], [p], [Dec(p)])),
    Some(b"a count left held where the body answers: v0"),
  )
}

test "a handle holds across its body what the body reads, which its landing releases" {
  let p = word(0);
  let r = word(1);
  let a = word(2);
  let c = flag(3);
  let site = { clauses: [], ret: None, detached: None };
  let uses = { takes: [], owned: false, fails: true, stops: false };
  let inside = [
    If({ cond: AVar(c), then: [Fail({ why: NoArm, at: dummy_span() })], otherwise: [] }),
    bind(r, call_of([AVar(p)], [0]), []),
    Assign({ var: a, arg: AVar(r) }),
  ];
  let around = |unwind: List<Var>|
    Handle({ body: inside, args: [], uses: uses, site: site, answer: a, unwind: unwind });
  let f = root_of([p, c], [], RWord, [around([]), Return(AVar(a))]);
  assert_eq(counted_body(f), { body: [around([p]), Dec(p), Return(AVar(a))], refused: None });
  assert_eq(
    refused_with(f, [around([]), Dec(p), Return(AVar(a))]),
    Some(b"a handle whose landing releases other than what it holds across its body"),
  );
  // An answer nothing reads is let go of after the handle, where a clause's answer arrives too.
  assert_eq(counted_body(root_of([p, c], [], RInt, [around([]), Return(AInt(0))])), {
    body: [around([p]), Dec(a), Dec(p), Return(AInt(0))],
    refused: None,
  });
  // A body run detached is a closure the handle reads: its landing releases it.
  let detached = |unwind: List<Var>|
    Handle({
      body: [],
      args: [AVar(p)],
      uses: { ..uses, takes: [false] },
      site: { ..site, detached: Some(0) },
      answer: a,
      unwind: unwind,
    });
  assert_eq(counted_body(root_of([p, c], [], RWord, [detached([]), Return(AVar(a))])), {
    body: [detached([p]), Dec(p), Return(AVar(a))],
    refused: None,
  })
}

/// A record held flat whose fields `f0`, `f1`, .. are a `String` held as its word or, where `leaves`
/// says `RInt`, an `Int`.
fn flat(id: Int, leaves: List<Rep>) -> Var =
  flat_of(id, leaves.map(|r: Rep| if r == RInt { int(0) } else { word(0) }))

/// A record held flat whose fields `f0`, `f1`, .. are of the types of `fields` and held as they are.
fn flat_of(id: Int, fields: List<Var>) -> Var = {
  let named = |k: Int| b"f".concat(ascii_of_int(k));
  {
    id: id,
    ty: TyRecord(
      range(0, fields.len()).map(|k: Int|
        { name: named(k), ty: match fields.at(k) { Some(v) -> v.ty, None -> int(0).ty } }),
    ),
    rep: RFlat(
      range(0, fields.len()).map(|k: Int|
        { name: named(k), rep: match fields.at(k) { Some(v) -> v.rep, None -> RInt } }),
    ),
  }
}

fn int(id: Int) -> Var = { id: id, ty: TyCon({ name: b"Int", args: [] }), rep: RInt }

fn leaf(v: Var, of: Var, k: Int) -> Inst = bind(v, Get({ of: of, path: PLeaf(k) }), [])

test "a flat parameter is opened into its parts, and a leaf consumed at its last use moves" {
  let s = flat(0, [RWord, RInt]);
  let c = flag(1);
  let y = word(2);
  let k = int(3);
  let r = word(4);
  let r2 = word(5);
  let words = [{ ..y, id: 6 }, { ..k, id: 7 }];
  let branch = |otherwise: List<Inst>|
    If({
      cond: AVar(c),
      then: [bind(r, call_of([AVar(s)], []), []), Return(AVar(r))],
      otherwise: otherwise.concat([bind(r2, call_of([AVar(y)], []), []), Return(AVar(r2))]),
    });
  let f = root_of([s, c], [], RWord, [leaf(y, s, 0), leaf(k, s, 1), branch([])]);
  // The branch that hands the value on whole moves each word; the other moves the leaf it reads.
  assert_eq(counted_body(f), {
    body: [Opened({ of: s, words: words }), leaf(y, s, 0), leaf(k, s, 1), branch([])],
    refused: None,
  });
  // Read out of otherwise than by a leaf, the value stays whole and the read takes a count.
  let field = bind(y, Get({ of: s, path: PField({ name: b"f0", at: 0 }) }), []);
  assert_eq(counted_body(root_of([s], [], RWord, [field, Return(AVar(y))])), {
    body: [field, Inc({ var: y, n: 1 }), Dec(s), Return(AVar(y))],
    refused: None,
  })
}

test "a flat value read by a field's name is not opened, as that read answers a count of its own" {
  let s = flat(0, [RWord, RInt]);
  let y = word(1);
  let named = |unwind: List<Var>| bind(y, Get({ of: s, path: PNamed(b"f0") }), unwind);
  assert_eq(counted_body(root_of([s], [], RWord, [named([]), Return(AVar(y))])), {
    body: [named([s]), Dec(s), Return(AVar(y))],
    refused: None,
  })
}

test "a read out of an opened leaf keeps the leaf's word held until it is read" {
  let x = of_type(1, b"m.Shape");
  let s = flat_of(0, [x, int(0)]);
  let name = word(2);
  let r = word(3);
  let w0 = { ..x, id: 4 };
  let words = [w0, int(5)];
  let named = bind(name, Get({ of: x, path: PArg({ ctor: b"Circle", at: 0 }) }), []);
  let cased = |arm: List<Inst>, rest: List<Inst>|
    Case({
      on: x,
      test: TTag([b"Circle", b"Square"]),
      arms: [{ when: 0, body: [named].concat(arm) }],
      rest: rest.push(Return(AZero(RWord))),
    });
  let f = root_of([s], [], RWord, [
    leaf(x, s, 0),
    cased([bind(r, call_of([AVar(name)], [0]), []), Return(AVar(r))], []),
  ]);
  assert_eq(counted_body(f), {
    body: [
      Opened({ of: s, words: words }),
      leaf(x, s, 0),
      cased([bind(r, call_of([AVar(name)], [0]), [w0]), Dec(w0), Return(AVar(r))], [Dec(w0)]),
    ],
    refused: None,
  })
}

test "a lent parameter handed back to a restart is only read" {
  let p = word(0);
  let f = word(1);
  assert_eq(counted_body(root_of([p, f], [1], RWord, [Restart([AVar(p), AVar(f)])])), {
    body: [Restart([AVar(p), AVar(f)])],
    refused: None,
  });
  // A value this body holds, lent to the body started again, would die under it.
  assert_eq(
    refused_with(root_of([p, f], [1], RWord, []), [
      Inc({ var: f, n: 1 }),
      Restart([AVar(f), AVar(p)]),
    ]),
    Some(b"a value lent to a body started again that does not outlast it: v0"),
  )
}

test "a flat value made in the body is opened where it is made, and a word nothing reads is let go" {
  let a = word(0);
  let b = word(1);
  let s = flat(2, [RWord, RWord]);
  let y = word(3);
  let r = word(4);
  let made = bind(s, Gathered({ parts: [AVar(a), AVar(b)] }), []);
  let f = root_of([a, b], [], RWord, [
    made,
    leaf(y, s, 1),
    bind(r, call_of([AVar(y)], []), []),
    Return(AVar(r)),
  ]);
  let w0 = word(5);
  let w1 = { ..y, id: 6 };
  assert_eq(counted_body(f), {
    body: [
      made,
      Opened({ of: s, words: [w0, w1] }),
      Dec(w0),
      leaf(y, s, 1),
      bind(r, call_of([AVar(y)], []), []),
      Return(AVar(r)),
    ],
    refused: None,
  });
  // The leaf read again after the call takes a count for the call, and its word dies after the read.
  let twice = root_of([a, b], [], RWord, [
    made,
    leaf(y, s, 1),
    bind(r, call_of([AVar(y), AVar(y)], [1]), []),
    Return(AVar(r)),
  ]);
  assert_eq(counted_body(twice), {
    body: [
      made,
      Opened({ of: s, words: [w0, w1] }),
      Dec(w0),
      leaf(y, s, 1),
      Inc({ var: w1, n: 1 }),
      bind(r, call_of([AVar(y), AVar(y)], [1]), [w1]),
      Dec(w1),
      Return(AVar(r)),
    ],
    refused: None,
  })
}

test "a loop's flat state is opened at the head of each pass, so a leaf consumed in the pass moves" {
  let p = flat(0, [RWord, RInt]);
  let s = flat(1, [RWord, RInt]);
  let y = word(2);
  let k = int(3);
  let c = flag(4);
  let z = word(5);
  let s2 = flat(6, [RWord, RInt]);
  let a = word(7);
  let state = [{ ..y, id: 10 }, { ..k, id: 11 }];
  let looped = |head: List<Inst>, made: List<Inst>|
    Loop({
      state: [s],
      init: [AVar(p)],
      body: head.concat([
        leaf(y, s, 0),
        leaf(k, s, 1),
        bind(c, Prim({ op: b"eq", on: RInt, args: [AVar(k), AInt(0)] }), []),
        If({
          cond: AVar(c),
          then: [Done(AVar(y))],
          otherwise: [
            bind(z, call_of([AVar(y)], []), []),
            bind(s2, Gathered({ parts: [AVar(z), AVar(k)] }), []),
          ].concat(
            made,
          ).push(
            Next([AVar(s2)]),
          ),
        }),
      ]),
      answer: a,
    });
  let f = root_of([p], [], RWord, [looped([], []), Return(AVar(a))]);
  // The buffer read out of the state is handed on with no count taken.
  assert_eq(counted_body(f), {
    body: [
      Opened({ of: p, words: [word(8), int(9)] }),
      looped([Opened({ of: s, words: state })], [Opened({ of: s2, words: [word(12), int(13)] })]),
      Return(AVar(a)),
    ],
    refused: None,
  })
}

test "a handle inside another's body releases at its landing only what the outer one does not" {
  let p = word(0);
  let r = word(1);
  let a = word(2);
  let t = word(3);
  let b = word(4);
  let s = word(5);
  let site = { clauses: [], ret: None, detached: None };
  let uses = { takes: [], owned: false, fails: true, stops: false };
  let inner = |unwind: List<Var>|
    Handle({
      body: [bind(r, call_of([AVar(p)], [0]), []), Assign({ var: b, arg: AVar(r) })],
      args: [],
      uses: uses,
      site: site,
      answer: b,
      unwind: unwind,
    });
  let outer = |inner_unwind: List<Var>, unwind: List<Var>|
    Handle({
      body: [
        bind(t, call_of([AVar(p)], [0]), []),
        inner(inner_unwind),
        bind(s, call_of([AVar(t), AVar(b)], []), []),
        Assign({ var: a, arg: AVar(s) }),
      ],
      args: [],
      uses: uses,
      site: site,
      answer: a,
      unwind: unwind,
    });
  let f = root_of([p], [], RWord, [outer([], []), Return(AVar(a))]);
  assert_eq(counted_body(f), { body: [outer([t], [p]), Dec(p), Return(AVar(a))], refused: None });
  // The inner landing leaves to the outer one, which releases `p`: releasing it at both lets it go twice.
  assert_eq(
    refused_with(f, [outer([t, p], [p]), Dec(p), Return(AVar(a))]),
    Some(b"a handle whose landing releases other than what it holds across its body"),
  )
}

/// A body of `n` straight-line steps, each `step(i)`, answering `p`.
fn steps(p: Var, n: Int, step: (Int) -> List<Inst>) -> Fn =
  root_of(
    [p],
    [],
    RWord,
    range(0, n).fold([], |body: List<Inst>, i: Int| body.concat(step(i))).push(Return(AVar(p))),
  )

fn log_linear(n: Int) -> Int = n * (ilog2(n) + 1)

test "the words of the flat values a body makes are read off in one walk, however many it makes" {
  let p = word(0);
  let made = |i: Int| {
    let s = flat(3 * i + 1, [RWord, RWord]);
    let y = word(3 * i + 2);
    [
      bind(s, Gathered({ parts: [AVar(p), AVar(p)] }), []),
      leaf(y, s, 0),
      bind(word(3 * i + 3), call_of([AVar(y)], [0]), []),
    ]
  };
  assert_eq(facts_of(steps(p, 2, made)).opened.len(), 2);
  paced(log_linear, |n: Int| facts_of(steps(p, n, made)).opened.len())
}

test "the words of a flat value are typed by its fields in one walk, however wide it is" {
  let p = word(0);
  let wide = |n: Int| {
    let s = flat(1, range(0, n).map(|_: Int| RWord));
    root_of(
      [p],
      [],
      RWord,
      [bind(s, Gathered({ parts: range(0, n).map(|_: Int| AVar(p)) }), [])].concat(
        range(0, n).map(|k: Int| leaf(word(k + 2), s, k)),
      ).push(
        Return(AVar(p)),
      ),
    )
  };
  assert_eq(
    match facts_of(wide(2)).opened.get(1) { Some(ws) -> ws.map(|w: Var| w.ty), None -> [] },
    [word(2).ty, word(3).ty],
  );
  paced(log_linear, |n: Int| facts_of(wide(n)).opened.len())
}

test "an instruction's operands are counted in one walk, however many it names" {
  let planned_over = |n: Int| {
    let ps = range(0, n).map(|i: Int| word(i));
    let ops = ps.map(|p: Var| { arg: AVar(p), takes: true }).concat(
      ps.map(|p: Var| { arg: AVar(p), takes: false }),
    );
    planned(facts_of(root_of(ps, [], RWord, [])), ops, Map::new())
  };
  // Each is consumed and read, so it takes a count first and dies after the instruction.
  assert_eq(planned_over(2).incs, [Inc({ var: word(0), n: 1 }), Inc({ var: word(1), n: 1 })]);
  assert_eq(planned_over(2).after, [word(0), word(1)]);
  paced(log_linear, |n: Int| planned_over(n).incs.len())
}

test "a field read once in each arm of a branch is taken in each, and in neither where it is read before" {
  let o = word(0);
  let c = flag(1);
  let p = word(2);
  let at = PField({ name: b"f", at: 0 });
  let branch = |read: Val|
    If({
      cond: AVar(c),
      then: [bind(word(3), read, []), Return(AVar(word(3)))],
      otherwise: [
        bind(word(4), read, []),
        bind(word(5), call_of([AVar(word(4))], []), []),
        Return(AVar(p)),
      ],
    });
  let f = |before: List<Inst>|
    root_of([o, c, p], [], RWord, before.push(branch(Get({ of: o, path: at }))));
  assert_eq(took(f([])).body, [branch(Take({ of: o, path: at }))]);
  let first = bind(word(6), Get({ of: o, path: at }), []);
  assert_eq(took(f([first])).body, [first, branch(Get({ of: o, path: at }))])
}

test "a field is taken out of a join only where the join holds a count, never out of one set from borrowed reads" {
  let o = word(0);
  let c = flag(1);
  let j = word(2);
  let set = |val: Val, at: Int| [bind(word(at), val, []), Assign({ var: j, arg: AVar(word(at)) })];
  let f = |val: Val|
    root_of([o, c], [0], RWord, [
      Decl(j),
      If({ cond: AVar(c), then: set(val, 3), otherwise: set(val, 4) }),
      bind(word(5), Get({ of: j, path: PField({ name: b"f", at: 0 }) }), []),
      bind(word(6), call_of([AVar(word(5))], []), []),
      Return(AVar(word(6))),
    ]);
  let taken = |g: Fn|
    owned(g).body.any(|i: Inst|
      match i { Let(l) -> match l.val { Take(_) -> true, _ -> false }, _ -> false });
  // Read out of a borrowed block, the join borrows it too, and holds no count to move a field out of.
  let read = f(Get({ of: o, path: PField({ name: b"g", at: 1 }) }));
  assert(!taken(read), None);
  assert_eq(counted_body(read).refused, None);
  // Answered by a call, the join holds the count the call answered.
  let made = f(call_of([], []));
  assert(taken(made), None);
  assert_eq(counted_body(made).refused, None)
}

test "the fields a body takes out of its blocks are found in one walk, however many it reads" {
  let p = word(0);
  let read = |i: Int| {
    let o = word(3 * i + 1);
    let x = word(3 * i + 2);
    [
      bind(o, call_of([], []), []),
      bind(x, Get({ of: o, path: PField({ name: b"f", at: 0 }) }), []),
      bind(word(3 * i + 3), call_of([AVar(x)], []), []),
    ]
  };
  let taken = |f: Fn|
    f.body.filter(|i: Inst|
      match i { Let(l) -> match l.val { Take(_) -> true, _ -> false }, _ -> false }).len(
    );
  assert_eq(taken(took(steps(p, 2, read))), 2);
  paced(log_linear, |n: Int| taken(took(steps(p, n, read))))
}
