import std.bin
import std.list
import compiler.check.types (Type, type_bin)
import compiler.emit.keys (RootKey, InlinedLambda, RootName, Evidence, root_key_bin,
                           inlined_lambda_bin, root_name_bin, evidence_bin, root_name, root_text)
import compiler.emit.typed_ir.statics (StaticDefinition, static_definition_bin)

pub type DefinitionSymbol = { entered: Bool, head: Prototype }

pub type Prototype = { result: Bytes, params: List<Bytes> }

pub type ExpectedPrototype = { callee: CalleeIndex, head: Prototype }

pub type CalleeIndex = | CallAt(Int) | GenericAt(Int)

pub fn callee_index(calls: List<RootKey>, k: RootKey) -> CalleeIndex / {abort.raise} =
  match calls.index_of(k) {
    Some(i) -> CallAt(i),
    None ->
      panic(
        String::of_bytes_lossy(
          b"a call to a function that does not appear in the calling function's body: ".concat(
            root_text(root_name(k)),
          ),
        ),
      ),
  }

pub fn callee_name(t: Tables, e: ExpectedPrototype) -> Option<RootName> =
  match e.callee {
    CallAt(i) -> match t.calls.at(i) { Some(k) -> Some(root_name(k)), None -> None },
    GenericAt(_) -> None,
  }

pub fn word_prototype(n: Int) -> Prototype =
  { result: b"Word", params: range(0, n).map(|_: Int| b"Word") }

pub type GenericCall = {
  callee: RootKey,
  args: List<Type>,
  specialised_variables: List<Int>,
  functions: List<InlinedLambda>,
  effect_evidence: List<List<Evidence>>,
}

pub type Need = { var: Int, reads: NeedKind }

pub type NeedKind = | Scalar | Layout | Exact | EffectsGeneric

pub fn needs_specialisation(needs: List<Need>) -> Bool =
  needs.any(|n: Need| n.reads == Layout || n.reads == Exact || n.reads == EffectsGeneric)

pub type Generics = {
  calls: List<GenericCall>,
  needs: List<Need>,
  expects: List<ExpectedPrototype>,
  called_parameters: List<Int>,
  passes: List<ForwardedParameter>,
}

pub type ForwardedParameter = { param: Int, callee: RootKey, at: Int }

pub const no_generics: Generics =
  { calls: [], needs: [], expects: [], called_parameters: [], passes: [] }

pub type PublishedSignature = {
  definition: RootName,
  borrowed: List<Bool>,
  borrowed_from: Option<List<{ param: Int, whole: Bool }>>,
}

pub type Tables = {
  fields: List<Bytes>,
  lambdas: List<Bytes>,
  calls: List<RootKey>,
  generics: Generics,
  performs: List<Bytes>,
  handles: List<Bytes>,
  members: List<RootKey>,
  defined: List<DefinitionSymbol>,
  statics: List<StaticDefinition>,
  handings: List<PublishedSignature>,
  assumed: List<PublishedSignature>,
  group: List<RootKey>,
  shared: List<SharedFunction>,
  natives: List<Bytes>,
  keyed: List<Keyed>,
}

pub type Keyed = | KeyedTag(Bytes) | KeyedField(Int) | KeyedEntry(Int)

pub type SharedFunction = { symbol: Bytes, text: Bytes }

pub const no_tables: Tables =
  {
    fields: [],
    lambdas: [],
    calls: [],
    generics: no_generics,
    performs: [],
    handles: [],
    members: [],
    defined: [],
    statics: [],
    handings: [],
    assumed: [],
    group: [],
    shared: [],
    natives: [],
    keyed: [],
  }

pub fn without_byte(s: Bytes, byte: Int) -> Bytes =
  Bytes::concat_all(
    range(0, s.len()).map(|i: Int| if s.at(i) == byte { b"" } else { s.slice(i, i + 1) }),
  )

pub fn float_literal_bits(literal: Bytes) -> Int / {abort.raise} =
  match Float::of_string(String::of_bytes(without_byte(without_whitespace(literal), 95))) {
    Some(x) -> bits_of_float(x),
    None -> panic("a float literal cannot be parsed as a number"),
  }

fn without_whitespace(s: Bytes) -> Bytes =
  Bytes::concat_all(
    range(0, s.len()).map(|i: Int| if s.at(i) <= 32 { b"" } else { s.slice(i, i + 1) }),
  )

pub type EmittedRoot = { name: RootName, text: Bytes, tables: Tables }

pub type Output = { text: Bytes, tables: Tables }

pub type RootOutput = { name: RootName, result: Output }

derive bin for Prototype

derive bin for DefinitionSymbol

derive bin for CalleeIndex

derive bin for ExpectedPrototype

derive bin for ForwardedParameter

derive bin for GenericCall

derive bin for NeedKind

derive bin for Need

derive bin for Generics

derive bin for PublishedSignature

derive bin for SharedFunction

derive bin for Keyed

derive bin for Tables

derive bin for Output

derive bin for RootOutput
