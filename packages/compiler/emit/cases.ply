/// The name root `k` prints as.
fn printed(k: RootKey) -> Bytes = root_text(root_name(k))

/// The name of the root `e` answers, as it prints.
fn emitted_name(e: Emitted) -> Bytes = root_text(e.name)

/// The name of the root `a` answers, as it prints.
fn answer_name(a: RootAnswer) -> Bytes = root_text(a.name)

// --- Specialisation ----------------------------------------------------------------------------

test "a body that would overrun this thread's stack makes room on the stack it runs on" {
  let out = emit_all_program([{ name: b"m", src: b"fn g(b: Bytes) -> Bytes = b\n" }], [], [], true);
  let text = match out.at(0) { Some(e) -> e.text, None -> b"" };
  // Through the head's entry, which probes the stack.
  assert(
    text.index_of(entered_fn().concat(b"(ctx)")) != None
      && entered_helper().index_of(b"rt_stack_more_p(ctx)") != None,
    Some(String::of_bytes_lossy(text)),
  );
  // No call is run again on a stack of its own.
  assert_eq(text.index_of(b"rt_grow_p") != None, false);
  assert_eq(text.index_of(b"rt_no_stack_p") != None, false)
}

test "a self call in tail position restarts the body instead of nesting" {
  let src = Bytes::concat_all([
    b"fn count(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { count(n - 1, acc + n) }\n",
    b"fn upto(xs: List<Int>, i: Int, acc: Int) -> Int = match i >= xs.len() { true -> acc, false -> upto(xs, i + 1, acc + 1) }\n",
    b"fn all_below(xs: List<Int>, bound: Int, i: Int) -> Bool = i >= xs.len() || (i < bound && all_below(xs, bound, i + 1))\n",
    b"fn ladder(n: Int) -> Int = if n <= 0 { 0 } else { 1 + ladder(n - 1) }\n",
    b"fn inner(n: Int) -> Int = { let k = if n > 5 { inner(n - 1) } else { 0 }; k + 1 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"goto ply_loop;") != None), [
    true,
    true,
    true,
    false,
    false,
  ])
}

test "a self call that takes no arguments restarts the body as well" {
  // `spin` declares a row: a pure nullary definition is a constant, which the table answers.
  let src = Bytes::concat_all([
    b"fn spin() -> Int / {clock.read, diverges} = spin()\n",
    b"fn poll() -> Int / {clock.read, diverges} = { clock.now(); poll() }\n",
    b"fn ladder() -> Int / {diverges} = 1 + ladder()\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(emitted_name), [b"m.spin", b"m.poll", b"m.ladder"]);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"goto ply_loop;") != None), [true, true, false]);
  // A lone definition is no group, so the jump is the self path's, and a nullary body assigns nothing before it.
  let spin = match out.at(0) { Some(e) -> e, None -> panic("no root was emitted") };
  assert_eq(spin.text.index_of(b"which = ") != None, false);
  assert_eq(spin.text.index_of(b"p0 = ") != None, false)
}

test "a tail call into a definition's own recursive group jumps instead of nesting" {
  let src = Bytes::concat_all([
    b"fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n",
    b"fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n",
    b"fn parity(n: Int) -> Bool = even(n)\n",
    b"fn count(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { count(n - 1, acc + n) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(emitted_name), [b"m.even", b"m.parity", b"m.count"]);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  let group = match out.at(0) { Some(e) -> e, None -> panic("no root was emitted") };
  assert_eq(group.tables.members, [Named(b"m.even"), Named(b"m.odd")]);
  // Each member keeps its own head, which a caller outside the group calls.
  let scalars = { answer: b"int64_t", params: [b"int64_t"] };
  assert_eq(group.tables.symbols.map(|d: Defined| d.head), [scalars, scalars]);
  // One function runs the group, each member entering it at its own place, and a call within the
  // group jumps.
  let grouped = symbol_of(b"m.even").concat(b"_group(");
  assert(group.text.index_of(grouped) != None, None);
  assert(group.text.index_of(grouped.concat(b"ctx, 1, ")) != None, None);
  assert(group.text.index_of(b"goto ply_loop;") != None, None);
  assert(group.text.index_of(entry_of(b"m.even").concat(b"(")) != None, None);
  assert_eq(group.text.index_of(b"PLY_SITE(ctx, @@r@@") != None, false);
  // A caller outside the group calls a member's own symbol, and a self loop outside a group keeps its label.
  let parity = match out.at(1) { Some(e) -> e, None -> group };
  assert_eq(parity.text.index_of(symbol_of(b"m.even").concat(b"(ctx, ")) != None, true);
  assert_eq(parity.text.index_of(b"ply_loop") != None, false);
  let count = match out.at(2) { Some(e) -> e, None -> group };
  assert_eq(count.text.index_of(b"goto ply_loop;") != None, true);
  assert_eq(count.text.index_of(b"which = ") != None, false);
  assert_eq(count.tables.members, [])
}

test "a cycle whose member holds a handle, or whose calls are not in tail position, is emitted per definition" {
  let src = Bytes::concat_all([
    b"fn a(n: Int) -> Int / {clock.read, diverges} = if n <= 0 { 0 } else if n == 1 { handle { b(0) } with { clock.now() -> clock.now(), } } else { b(n - 1) }\n",
    b"fn b(n: Int) -> Int / {clock.read, diverges} = if n <= 0 { clock.now(); 0 } else { a(n - 1) }\n",
    b"fn c(n: Int) -> Int = if n <= 0 { 0 } else { 1 + d(n - 1) }\n",
    b"fn d(n: Int) -> Int = if n <= 0 { 0 } else { c(n - 1) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(emitted_name), [b"m.a", b"m.b", b"m.c", b"m.d"]);
  assert_eq(out.map(|e: Emitted| e.why == None), [true, true, true, true]);
  assert_eq(out.map(|e: Emitted| e.tables.members.len() == 2), [false, false, false, false]);
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"_group(PlyCtx *ctx, int which") != None), [
    false,
    false,
    false,
    false,
  ])
}

/// The C between a `handle`'s push and its landing label, for a unit whose first definition holds one.
fn handled_body(src: Bytes, release: Bool) -> Bytes / {abort.raise} = {
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [],
    [b"U8::of_int", b"Int::of_u8", b"Bytes::at", b"Array::get"],
    release,
  );
  match out.at(0) {
    None -> b"nothing was emitted",
    Some(e) -> match e.why {
      Some(why) -> why,
      None -> match e.text.index_of(b"rt_handle_install_p") {
        None -> b"no handle was pushed",
        Some(pushed) -> match e.text.index_of(b": ;\n") {
          None -> b"no handle lands",
          Some(landed) -> e.text.slice(pushed, landed),
        },
      },
    },
  }
}

test "a body that fails inside a `handle` leaves through the handle's landing, whatever failed" {
  let src = Bytes::concat_all([
    b"fn f(vs: List<Int>, b: Bytes, xs: Array<Int>, n: Int) -> Int =\n",
    b"  handle {\n",
    b"    let [x, ..] = vs;\n",
    b"    x + Int::of_u8(U8::of_int(n)) + b.at(n) + xs.get(n) + (0 - n) * (n << 3)\n",
    b"  } with { abort.raise(m) -> 0 }\n",
  ]);
  let bodies = [false, true].map(|release: Bool| handled_body(src, release));
  let leaves = |raised: Bytes| bodies.map(|body: Bytes| body.index_of(raised) != None);
  assert_eq(leaves(b"rt_let_no_match_p(ctx)"), [true, true]);
  assert_eq(leaves(b"goto ply_h"), [true, true]);
  assert_eq(leaves(b"rt_not_that_width_p(ctx, "), [true, true]);
  // A byte read past the end raises as `Bytes::at` does, over the index and the length alone.
  assert_eq(leaves(b"builtin_elaborated_refused_p(ctx, INT64_C(8), "), [true, true]);
  assert_eq(bodies.map(|body: Bytes| body.index_of(b"rt_builtin_encoded_p")), [None, None]);
  assert_eq(bodies.map(|body: Bytes| body.index_of(b"return")), [None, None])
}

test "a step `iterate` runs in place captures for a detached `handle` only slots its frame holds" {
  let src = Bytes::concat_all([
    b"effect ask { read get() -> Int }\n",
    b"fn f(k: Int, n: Int) -> Int / {abort.raise} = iterate(k, n + 1, |s: Int| handle { let y = ask.get(); if s + y >= n { Stop(s) } else { Continue(s + y) } } with { ask.get() resume r -> { let v = r(1); v } })\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"Stop", b"Continue"], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None]);
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"rt_handle_install_detached_p(") != None), [true])
}

test "a `parallel` block tells the runtime its definition's row only where that row holds all its branches reach" {
  let src = Bytes::concat_all([
    b"effect meter { read level() -> Int }\n",
    b"fn pure(n: Int) -> (Int, Int) = parallel { n + 1, n + 2 }\n",
    b"fn reads() -> (Int, Int) / {meter.level} = parallel { meter.level(), meter.level() }\n",
    b"fn handled() -> (Int, Int) = handle { parallel { meter.level(), meter.level() } } with { meter.level() -> 0 }\n",
    b"fn nested(xs: List<Int>) -> List<(Int, Int)> = xs.map(|m: Int| parallel { m + 1, m + 2 })\n",
    b"fn open<| e>(g: () -> Int / e) -> (Int, Int) / e = parallel { g(), 1 }\n",
  ]);
  // `nested`'s lambda runs in the loop of `map` specialised for it, whose row is its lambda's.
  let keys = [
    Named(b"m.pure"),
    Named(b"m.reads"),
    Named(b"m.handled"),
    prelude_loop(b"mapped_from", b"m.nested", 5, [b"Int", b"{_0:Int,_1:Int}"]),
    Named(b"m.open"),
  ];
  let names = keys.map(printed);
  let answers = answers_at([b"m"], [src], [], keys);
  let calls = |helper: Bytes|
    names.map(|n: Bytes| answered_body(answers, n).text.index_of(helper) != None);
  assert_eq(calls(b"rt_branches_past_p(ctx, "), [true, true, false, false, false]);
  assert_eq(calls(b"rt_branches_p(ctx, "), [false, false, true, true, true])
}

test "a program that will not parse is refused, and the refusal carries the parser's words" {
  let out = emit_all_program(zip_sources([b"m"], [b"fn f(x: -> Int = 1\n"]), [], [], true);
  assert_eq(out.map(emitted_name), [b"m"]);
  assert_eq(out.map(|e: Emitted| match e.why { Some(w) -> w.len() > 0, None -> false }), [true])
}

test "the emitter answers each root it was asked for, a body's tables as values" {
  let src = b"fn greet() -> Bytes = b\"hi\"\nfn twice(x: Int) -> Int = x + x\nfn guarded() -> Option<Instant> / {clock.read} = handle { Some(clock.now()) } with { clock.now() -> clock.now(), }\n";
  let wanted = [b"m.greet", b"m.twice", b"m.guarded"];
  let answers = answers_at([b"m"], [src], [b"Some"], wanted.map(Named));
  assert_eq(answers.map(answer_name), wanted);
  match answers.get(0).answer {
    Body(b) -> {
      assert_eq(b.tables.statics, statics_of(SBytes(b"hi")));
      assert_eq(b.tables.members, []);
      assert_eq(b.tables.symbols, [
        { symbol: symbol_of(b"m.greet"), entry: entry_of(b"m.greet"), head: word_head(0) },
      ])
    },
    Refused(_) -> assert(false),
  };
  // A body names the operations it handles.
  match answers.get(2).answer {
    Body(b) -> assert_eq(b.tables.handles, [b"clock#now"]),
    Refused(_) -> assert(false),
  }
}

test "guarded arms and every literal pattern are emitted rather than refused" {
  let src = b"fn f(n: Int, m: Int) -> Int = match n { x if x > m -> x, 0 -> 1, x if x < 0 - m -> m, _ -> m }\nfn g(s: String) -> Int = match s { t if t == \"a\" -> 1, \"b\" -> 2, _ -> 3 }\nfn h(u: Unit, b: Bytes, f: Float, d: Decimal, w: U64, n: Int) -> Int = match u { () -> match b { b\"x\" -> 1, _ -> match f { -1.5 -> 2, _ -> match d { 2.50m -> 3, _ -> match w { 7u64 -> 4, _ -> match n { 4611686018427387904 -> 5, _ -> 6 } } } } } }\n";
  assert_eq(emit_all_program([{ name: b"m", src: src }], [], [], true).map(|e: Emitted| e.why), [
    None,
    None,
    None,
  ])
}

test "an operator is compiled at the type the checker settled, whatever holds its operands" {
  let src = Bytes::concat_all([
    b"fn bytes(xs: List<U8>) -> U8 = match xs { [a, b, ..] -> a + b, _ -> 0u8 }\n",
    b"fn ints(xs: List<Int>) -> Int = match xs { [a, b, ..] -> a + b, _ -> 0 }\n",
    b"fn folded(xs: List<U8>) -> U8 = xs.fold(0u8, wrap_add)\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  // The runtime's operator reads its words untyped; a builtin as a value is a lambda calling it.
  assert_eq(has(b"rt_binary_p"), [false, false, false]);
  assert_eq(has(b"_lambda0_value;"), [false, false, true]);
  // `U8`'s `+` checks its sum against 255, `Int`'s through its helper; `wrap_add` wraps in C,
  // checking nothing.
  assert_eq(has(b"INT64_C(255)"), [true, false, false]);
  assert_eq(has(b"ply_add_ov("), [false, true, false]);
  assert_eq(has(b"rt_overflow_p").at(2), Some(false));
  assert_eq(has(b"(uint8_t)").at(2), Some(true))
}

test "a `Float` is a C `double`: its operators are C's own and a literal is its bits" {
  let src = Bytes::concat_all([
    b"fn poly(x: Float) -> Float = (0.5 * x + 0.25) * x - 1.5\n",
    b"fn less(a: Float, b: Float) -> Bool = a < b || a == -b\n",
    b"fn rest(a: Float, b: Float) -> Float = a % b\n",
    b"type Point = { x: Float, y: Float }\n",
    b"fn norm(p: Point) -> Float = p.x * p.x + p.y * p.y\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  assert_eq(has(b"rt_binary_p"), [false, false, false, false]);
  assert_eq(has(b"rt_negate_p"), [false, false, false, false]);
  assert_eq(has(b"double "), [true, true, true, true]);
  // `0.5` is `0x3FE0_0000_0000_0000`.
  assert_eq(has(b"ply_f64(INT64_C(4602678819172646912))"), [true, false, false, false]);
  // C has no `%` on doubles; the runtime answers it as the evaluator does.
  assert_eq(has(b"rt_float_rem_p"), [false, false, true, false])
}

/// A head a body wrote a call to, its callee by name.
type CallHead = { callee: Bytes, head: Head }

/// Each head `t`'s body wrote a call to, its callee by name: a root as `t`'s calls name it, a
/// generic call as its placeholder.
fn expects_named(t: Tables) -> List<CallHead> =
  t.generics.expects.map(|e: Expect|
    {
      callee: match e.callee {
        GenericAt(n) -> Bytes::concat_all([b"@@g", ascii_of_int(n), b"@@"]),
        CallAt(_) -> match expected_callee(t, e) { Some(c) -> root_text(c), None -> b"" },
      },
      head: e.head,
    })

/// A root's own code: what it runs past its fuel head and before its entry, leaving out the
/// adapters that box what it carries raw for the runtime.
fn own_code(text: Bytes) -> Bytes / {abort.raise} = {
  let from = match text.index_of(entered_fn()) { Some(i) -> i, None -> 0 };
  let to = match text.index_of(b"_entry(PlyCtx *ctx, const Word *args) {") {
    Some(i) -> i,
    None -> text.len(),
  };
  text.slice(from, to)
}

test "a record holds every `Float` field as its bits, wherever the field stands" {
  let fields = bytes_join(
    range(0, 70).map(|k: Int| Bytes::concat_all([b"f", ascii_of_int(k + 10), b": Float"])),
    b", ",
  );
  let src = Bytes::concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"fn point(x: Float, y: Float) -> Point = { x: x, y: y }\n",
    b"fn sum(p: Point) -> Float = p.x + p.y\n",
    b"fn weighed(name: String, weight: Float) -> { name: String, weight: Float } = { name: name, weight: weight }\n",
    b"fn moved(p: Point, by: Float) -> Point = { ..p, x: p.x + by }\n",
    b"type Wide = { ",
    fields,
    b", tag: String }\n",
    b"fn last(wide: Wide) -> Float = wide.f79\n",
    b"fn wrapped<a>(x: a) -> { inner: a } = { inner: x }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None, None]);
  // No `Float` is boxed: a record holds its bits, and a function takes and answers its own.
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b"rt_box_float_p") != None), [
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  // `Point` and `weighed`'s record are two words each, made a box of them by the entries of the
  // roots that answer one to the runtime.
  assert_eq(has(b"rt_alloc_bytes_p(ctx, INT64_C(32));"), [true, false, true, true, false, false]);
  // A record of a known type holds a `Float` as its bits wherever it was made, so a read is a load,
  // the 70th field's at its place as the first's: in the box a record this wide is held as.
  assert(
    out.get(4).text.index_of(b"ply_f64(ply_words(p0)[69])") != None,
    Some(String::of_bytes_lossy(out.get(4).text)),
  );
  // A record with a field of a variable's type is laid out only where its callers settle the
  // variable: the generic body has no C of its own.
  assert_eq(out.get(5).text, b"");
  assert(out.get(5).tables.generics.needs.map(|n: Need| n.reads).contains(Layout), None)
}

test "a record holds a record held as its box as a pointer to it, wherever it is made, updated or read" {
  let fields = bytes_join(
    range(0, 40).map(|k: Int| Bytes::concat_all([b"f", ascii_of_int(k + 10), b": Int"])),
    b", ",
  );
  let src = Bytes::concat_all([
    b"type Wide = { ",
    fields,
    b", tag: String }\n",
    b"type Outer = { inner: Wide, k: List<Int> }\n",
    b"fn made(w: Wide, k: List<Int>) -> Outer = { inner: w, k: k }\n",
    b"fn set(o: Outer, w: Wide) -> Outer = { ..o, inner: w }\n",
    b"fn kept(o: Outer) -> Outer = { ..o, k: [1] }\n",
    b"fn k(o: Outer) -> List<Int> = o.k\n",
    b"fn tag(o: Outer) -> String = o.inner.tag\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  // `Outer` is two words, the inner record's pointer and the list, held as them: nothing made.
  assert(
    own_code(out.get(0).text).index_of(b"rt_alloc_bytes_p") == None,
    Some(String::of_bytes_lossy(out.get(0).text)),
  );
  // A field of the inner record is read out of its box through the pointer, nothing boxed.
  assert(
    out.get(4).text.index_of(b")[40]") != None
      && own_code(out.get(4).text).index_of(b"rt_alloc_bytes_p") == None,
    Some(String::of_bytes_lossy(out.get(4).text)),
  )
}

test "a definition takes and answers a float as itself, and a call says the head it was written to" {
  let src = b"fn half(x: Float) -> Float = x / 2.0\nfn quarter(x: Float) -> Float = half(half(x))\nfn same(x: Int) -> Int = x\n";
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let floats = { answer: b"double", params: [b"double"] };
  assert(
    out.get(0).text.index_of(
        Bytes::concat_all([b"double ", symbol_of(b"m.half"), b"(PlyCtx *ctx, double p0) {"]),
      )
      != None,
    None,
  );
  assert(own_code(out.get(1).text).index_of(b"rt_box_float_p") == None, None);
  assert_eq(expects_named(out.get(1).tables), [
    { callee: b"m.half", head: floats },
    { callee: b"m.half", head: floats },
  ]);
  // Each callee is named once, among the calls, and each call by its place there.
  assert_eq(
    (
      out.get(1).tables.calls.map(printed),
      out.get(1).tables.generics.expects.map(|e: Expect| e.callee),
    ),
    ([b"m.half"], [CallAt(0), CallAt(0)]),
  );
  assert_eq(out.get(1).tables.symbols.map(|d: Defined| d.head), [floats]);
  // An `Int` crosses as itself too.
  assert_eq(out.get(2).tables.symbols.map(|d: Defined| d.head), [
    { answer: b"int64_t", params: [b"int64_t"] },
  ])
}

test "a lambda run in another root reads its parameters and captures at their types, a field where the record's type lays it" {
  let src = Bytes::concat_all([
    b"type Fld = { name: Bytes, n: Int }\n",
    b"fn mapped(fs: List<Fld>) -> List<Int> = fs.map(|f: Fld| f.n)\n",
    b"fn folded(fs: List<Fld>) -> Int = fs.fold(0, |acc: Int, f: Fld| acc + f.n)\n",
    b"fn captured(f: Fld, xs: List<Int>) -> List<Int> = xs.map(|x: Int| x + f.n)\n",
    b"fn offset(k: Int, xs: List<Int>) -> List<Int> = xs.map(|x: Int| { let j = k - 1; x + j })\n",
    b"fn stepped(f: Fld) -> Int / {abort.raise} = iterate(f, 9, |t: Fld| if t.n > 3 { Stop(t.n) } else { Continue({ ..t, n: t.n + 1 }) })\n",
  ]);
  // `map` and `fold` run their lambdas in the loops of `std.prelude` specialised for them, where an
  // item and a capture arrive as words.
  let loops = [
    prelude_loop(b"mapped_from", b"m.mapped", 5, [b"m.Fld{n:Int,name:Bytes}", b"Int"]),
    prelude_loop(b"folded_from", b"m.folded", 5, [b"m.Fld{n:Int,name:Bytes}", b"Int"]),
    prelude_loop(b"mapped_from", b"m.captured", 5, [b"Int", b"Int"]),
    prelude_loop(b"mapped_from", b"m.offset", 5, [b"Int", b"Int"]),
  ];
  let keys = [b"m.mapped", b"m.folded", b"m.captured", b"m.offset", b"m.stepped"].map(Named).concat(
    loops,
  );
  let names = keys.map(printed);
  let answers = answers_at([b"m"], [src], [b"Stop", b"Continue"], keys);
  let text = |name: Bytes| answered_body(answers, name).text;
  assert_eq(loops.map(|k: RootKey| calls_a_value(own_code(text(printed(k))))), [
    false,
    false,
    false,
    false,
  ]);
  assert_eq(names.filter(|n: Bytes| text(n).index_of(b"rt_field_p") != None), [])
}

test "a lambda another root lent reads its captures at the types the checker filed for their reads" {
  let src = b"type Fld = { name: Bytes, n: Int }\nfn captured(f: Fld, xs: List<Int>) -> List<Int> = xs.map(|x: Int| x + f.n)\n";
  let loop = prelude_loop(b"mapped_from", b"m.captured", 5, [b"Int", b"Int"]);
  let d = dump_of(analyse(parse_all(zip_sources([b"m"], [src]))));
  let w = lowered_roots(
    [b"m"],
    [src],
    loaded_ctors(d, []),
    loaded_natives(zip_sources([b"m"], [src]), []),
    [loop],
    [],
    [],
    d.embeds,
    d.rows,
    d.walked,
  );
  let read = w.roots.fold([], |acc: List<Type>, r: RootForm|
    match r {
      Formed(x) -> if x.name != root_name(loop) { acc } else {
        match x.form {
          Ok(f) -> acc.concat(capture_reads(f.body).map(|v: Var| v.ty)),
          Err(_) -> acc,
        }
      },
      Unformed(_) -> acc,
    });
  // `f`, the record the lambda captures, read where `captured` lent the lambda to `map`'s loops.
  assert(read.len() > 0 && read.all(|t: Type| t != unknown_type()), None)
}

/// The variables `b` reads a closure's captures into, its blocks' too.
fn capture_reads(b: Block) -> List<Var> =
  b.fold([], |acc: List<Var>, i: Inst|
    match i {
      Let(l) -> match l.val {
        Get(g) -> match g.path { PCapture(_) -> acc.push(l.var), _ -> acc },
        _ -> acc,
      },
      If(x) -> acc.concat(capture_reads(x.then)).concat(capture_reads(x.otherwise)),
      Case(c) ->
        c.arms.fold(
          acc.concat(capture_reads(c.rest)),
          |a: List<Var>, arm: { when: Int, body: Block }| a.concat(capture_reads(arm.body)),
        ),
      Match(m) ->
        m.arms.fold(acc.concat(capture_reads(m.rest)), |a: List<Var>, arm: Block|
          a.concat(capture_reads(arm))),
      Loop(l) -> acc.concat(capture_reads(l.body)),
      _ -> acc,
    })

/// The joins `b` declares and the variables it packs a zero into, its blocks' too.
fn zeros_held(b: Block) -> List<Var> =
  b.fold([], |acc: List<Var>, i: Inst|
    match i {
      Decl(v) -> acc.push(v),
      Let(l) -> match l.val {
        Pack(p) -> match p.arg { AZero(_) -> acc.push(l.var), _ -> acc },
        _ -> acc,
      },
      If(x) -> acc.concat(zeros_held(x.then)).concat(zeros_held(x.otherwise)),
      Case(c) ->
        c.arms.fold(
          acc.concat(zeros_held(c.rest)),
          |a: List<Var>, arm: { when: Int, body: Block }| a.concat(zeros_held(arm.body)),
        ),
      Match(m) ->
        m.arms.fold(acc.concat(zeros_held(m.rest)), |a: List<Var>, arm: Block|
          a.concat(zeros_held(arm))),
      Loop(l) -> acc.concat(zeros_held(l.body)),
      _ -> acc,
    })

test "a `()` an arm answers or a call is handed is a `Unit`, and so are its join and its box" {
  let src = Bytes::concat_all([
    b"fn same(b: Bool) -> Unit = if b { () } else { () }\n",
    b"fn whole(xs: List<Int>, b: Bool) -> Int = { if b { xs.fold((), |_: Unit, x: Int| if x == 0 { () } else { () }); () }; 1 }\n",
  ]);
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let held = |name: Bytes|
        match formed(p, name) {
          Ok(f) ->
            zeros_held(f.body).concat(
              f.lambdas.fold([], |acc: List<Var>, l: Lambda|
                match l { Closure(c) -> acc.concat(zeros_held(c.body.body)) }),
            ).map(|v: Var| v.ty),
          Err(no) -> panic(String::of_bytes_lossy(no.why)),
        };
      let unit = TyCon({ name: b"Unit", args: [] });
      assert_eq(held(b"same"), [unit]);
      assert(held(b"whole").len() > 0 && held(b"whole").all(|t: Type| t == unit), None)
    },
  }
}

/// `scaled` hands a lambda to `total`, which hands it on to `each`, which calls it.
fn lending() -> Bytes =
  b"fn each(n: Int, f: (Int) -> Int, i: Int, acc: Int) -> Int = if i >= n { acc } else { each(n, f, i + 1, acc + f(i)) }\nfn total(n: Int, f: (Int) -> Int) -> Int = each(n, f, 0, 0)\nfn scaled(n: Int, k: Int) -> Int = total(n, |x: Int| x * k)\n"

test "a lambda handed to a definition that calls it is run in place by the root it settles on" {
  let lent = [{ param: 1, owner: Named(b"m.scaled"), nth: 0 }];
  let total = printed(at_key(b"m.total", [], lent));
  let each = printed(at_key(b"m.each", [], lent));
  let answers = answers_at([b"m"], [lending()], [], [
    Named(b"m.each"),
    Named(b"m.total"),
    Named(b"m.scaled"),
    at_key(b"m.total", [], lent),
    at_key(b"m.each", [], lent),
  ]);
  let body = |name: Bytes|
    answers.fold(None, |acc: Option<{ text: Bytes, tables: Tables }>, a: RootAnswer|
      if answer_name(a) != name { acc } else {
        match a.answer { Body(b) -> Some(b), Refused(r) -> panic(String::of_bytes_lossy(r.why)) }
      });
  let generics = |name: Bytes|
    match body(name) { Some(b) -> b.tables.generics, None -> no_generics() };
  // `each` calls its parameter; `total` hands its own on to `each`, which calls it.
  assert_eq(generics(b"m.each").called, [1]);
  assert_eq(generics(b"m.total").passes, [{ param: 1, callee: Named(b"m.each"), at: 1 }]);
  assert_eq(generics(b"m.scaled").calls.map(|g: GenericCall| g.fns), [lent]);
  assert_eq(generics(total).calls.map(|g: GenericCall| g.fns), [lent]);
  // The lambda runs in `each`'s loop: no call through the runtime, its product written there.
  match body(each) {
    Some(b) -> {
      assert(!calls_a_value(own_code(b.text)), None);
      assert(own_code(b.text).index_of(b"ply_loop") != None, None)
    },
    None -> panic("no body for the specialisation"),
  }
}

test "a lambda a specialisation was handed is handed on from a closure it makes, as its owner's" {
  let src = Bytes::concat_all([
    b"fn each(f: (Int) -> Int, x: Int) -> Int = f(x)\n",
    b"fn later(f: keep (Int) -> Int) -> List<() -> Int> = [|| each(f, 1)]\n",
    b"fn scaled(k: Int) -> List<() -> Int> = later(|x: Int| x * k)\n",
  ]);
  let lent = [{ param: 0, owner: Named(b"m.scaled"), nth: 0 }];
  let later = at_key(b"m.later", [], lent);
  let answers = answers_at([b"m"], [src], [], [
    Named(b"m.each"),
    Named(b"m.later"),
    Named(b"m.scaled"),
    later,
  ]);
  assert_eq(
    answered_body(answers, printed(later)).tables.generics.calls.map(|g: GenericCall| g.fns),
    [lent],
  )
}

test "a lambda run in place reads its own slots, never the parameters of the root it runs in" {
  // The lambda's `kept` is slot 4, as `walk`'s `n`, an `Option`, is: the outer `match` answers the
  // list it gathers as a word all the same.
  let src = Bytes::concat_all([
    b"type Def = { name: Bytes, guard: Option<Int> }\n",
    b"type Item = | ISchema(Def) | IOther\n",
    b"fn walk(xs: List<Item>, f: (List<Bytes>, Item) -> List<Bytes>, i: Int, acc: List<Bytes>, n: Option<Int>) -> List<Bytes> = match xs.at(i) { Some(x) -> walk(xs, f, i + 1, f(acc, x), n), None -> acc }\n",
    b"fn named(prefix: Bytes, xs: List<Item>) -> List<Bytes> = walk(xs, |acc: List<Bytes>, item: Item| match item { ISchema(d) -> { let kept = acc.push(prefix ++ d.name); match d.guard { Some(_) -> kept.push(prefix), None -> kept } }, _ -> acc }, 0, [], None)\n",
  ]);
  let walk = at_key(b"m.walk", [], [{ param: 1, owner: Named(b"m.named"), nth: 0 }]);
  let answers = answers_at([b"m"], [src], [b"Some", b"None", b"m.ISchema", b"m.IOther"], [
    Named(b"m.named"),
    walk,
  ]);
  let code = own_code(answered_body(answers, printed(walk)).text);
  let maybe_joins = code.split(b"\n").filter(|l: Bytes|
    l.index_of(b"PlyMaybe ") != None && l.index_of(b" = 0;") != None);
  assert(maybe_joins == [], Some(String::of_bytes_lossy(code)))
}

test "a function value a let binds to a lambda runs in place where it is called and is lent where it is handed" {
  let src = Bytes::concat_all([
    b"fn walked(n: Int, x: Float, f: (Float) -> Float) -> Float = if n <= 0 { x } else { walked(n - 1, f(x), f) }\n",
    b"fn called(k: Float) -> Float = { let f = |x: Float| x * k; let g = f; f(1.0) + g(2.0) }\n",
    b"fn nested(k: Float) -> Float = { let f = |x: Float| x * k; let h = |x: Float| f(x) + 1.0; h(2.0) }\n",
    b"fn handed(n: Int, k: Float) -> Float = { let f = |x: Float| x * k; let g = f; walked(n, 1.0, g) }\n",
    b"fn half(x: Float) -> Float = x * 0.5\n",
    b"fn halved(n: Int) -> Float = walked(n, 1.0, half)\n",
  ]);
  let lent = [{ param: 2, owner: Named(b"m.handed"), nth: 0 }];
  let walked = printed(at_key(b"m.walked", [], lent));
  let named = [{ param: 2, owner: Named(b"m.halved"), nth: 0 }];
  let halving = printed(at_key(b"m.walked", [], named));
  let answers = answers_at(
    [b"m"],
    [src],
    [],
    [b"m.walked", b"m.called", b"m.nested", b"m.handed", b"m.half", b"m.halved"].map(Named).concat(
      [at_key(b"m.walked", [], lent), at_key(b"m.walked", [], named)],
    ),
  );
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(r.why)),
      },
      None -> panic("no answer"),
    };
  // A call of the bound name, of another name bound to it, and of one a lambda captures.
  assert(!calls_a_value(own_code(body(b"m.called").text)), None);
  assert(!calls_a_value(body(b"m.nested").text), None);
  // Handed on, it is the lambda its `let` wrote, which `walked` runs in its loop.
  assert_eq(body(b"m.handed").tables.generics.calls.map(|g: GenericCall| g.fns), [lent]);
  assert(!calls_a_value(own_code(body(walked).text)), None);
  assert(own_code(body(walked).text).index_of(b"ply_loop") != None, None);
  // A definition handed on by name is lent as the lambda around a call of it, which `walked`
  // makes directly, counting no step but the definition's own.
  assert_eq(body(b"m.halved").tables.generics.calls.map(|g: GenericCall| g.fns), [named]);
  assert(!calls_a_value(own_code(body(halving).text)), None);
  assert(own_code(body(halving).text).index_of(symbol_of(b"m.half")) != None, None);
  assert_eq(
    own_code(body(halving).text).split(b"ctx->ticks").len(),
    own_code(body(b"m.walked").text).split(b"ctx->ticks").len(),
  )
}

test "a definition at type arguments that are all known lends its lambdas as a plain one does" {
  let src = Bytes::concat_all([
    b"fn some<a>(xs: List<a>, f: (a) -> Bool, i: Int) -> Bool = match xs.at(i) { Some(x) -> if f(x) { true } else { some(xs, f, i + 1) }, None -> false }\n",
    b"fn holds<a>(xs: List<a>, x: a) -> Bool = some(xs, |y: a| y == x, 0)\n",
    b"fn has_three(xs: List<Int>) -> Bool = holds(xs, 3)\n",
  ]);
  let int = TyCon({ name: b"Int", args: [] });
  let held = at_key(b"m.holds", [int], []);
  let holds = printed(held);
  let lent = [{ param: 1, owner: held, nth: 0 }];
  let somed = at_key(b"m.some", [int], lent);
  let some = printed(somed);
  let answers = answers_at([b"m"], [src], [b"Some", b"None"], [Named(b"m.has_three"), held, somed]);
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(r.why)),
      },
      None -> panic("no answer"),
    };
  // `holds` at `Int` hands `some` its lambda, and `some` runs it in its loop.
  assert_eq(body(holds).tables.generics.calls.map(|g: GenericCall| g.fns), [lent]);
  assert(!calls_a_value(own_code(body(some).text)), None);
  assert(own_code(body(some).text).index_of(b"rt_equal_p") == None, None);
  assert(own_code(body(some).text).index_of(b"ply_loop") != None, None);
  // Asked for alone, `some` still reads the lambda's operator at the type its owner is at.
  assert_eq(
    answers_at([b"m"], [src], [b"Some", b"None"], [somed]).map(|a: RootAnswer|
      match a.answer {
        Body(b) -> own_code(b.text),
        Refused(r) -> panic(String::of_bytes_lossy(r.why)),
      }),
    [own_code(body(some).text)],
  )
}

test "a specialisation, which only compiled code calls, has no entry the runtime calls it through" {
  let src = b"fn id<a>(x: a) -> a = x\nfn twice(n: Int) -> Int = id(n) + id(n)\n";
  let at = at_key(b"m.id", [TyCon({ name: b"Int", args: [] })], []);
  let answers = answers_at([b"m"], [src], [], [at, Named(b"m.twice")]);
  assert_eq(answers.map(answer_name), [printed(at), b"m.twice"]);
  let bodies = answers.map(|a: RootAnswer|
    match a.answer { Body(b) -> b, Refused(r) -> panic(String::of_bytes_lossy(r.why)) });
  assert_eq(
    bodies.map(|b: { text: Bytes, tables: Tables }| b.tables.symbols.map(|d: Defined| d.entry)),
    [[b""], [entry_of(b"m.twice")]],
  );
  assert_eq(bodies.map(|b: { text: Bytes, tables: Tables }| b.text.index_of(b"_entry") != None), [
    false,
    true,
  ])
}

test "a body that hands a lambda on is the same wherever its definition stands, and so are the roots it names" {
  let lent = [{ param: 1, owner: Named(b"m.scaled"), nth: 0 }];
  let wanted = [Named(b"m.scaled"), at_key(b"m.total", [], lent), at_key(b"m.each", [], lent)];
  let emitted = |above: Bytes|
    answers_at([b"m"], [above.concat(lending())], [], wanted).map(|a: RootAnswer|
      match a.answer {
        Body(b) -> { name: a.name, text: b.text, calls: b.tables.calls },
        Refused(r) ->
          panic(String::of_bytes_lossy(Bytes::concat_all([answer_name(a), b": ", r.why]))),
      });
  // A body is kept under its definition's hash, which an edit above the definition does not move.
  assert_eq(
    emitted(b"// a comment, and a definition, above them\nfn aside() -> Int = 7\n"),
    emitted(b""),
  )
}

test "a definition's call of itself is written to the head of the root it names" {
  let src = b"fn deepened<a>(x: a, n: Int) -> a where numeric(a) = if n <= 0 { x } else { deepened(x, n - 1) + x }\n";
  let answers = answers_at([b"m"], [src], [], [
    Named(b"m.deepened"),
    at_spelled(b"m.deepened", [b"Float"]),
  ]);
  let heads = |name: Bytes|
    answers.filter(|a: RootAnswer| answer_name(a) == name).map(|a: RootAnswer|
      match a.answer {
        Body(b) ->
          {
            own: b.tables.symbols.map(|d: Defined| d.head),
            called: b.tables.generics.expects.map(|e: Expect| e.head),
          },
        Refused(r) -> panic(String::of_bytes_lossy(r.why)),
      });
  // The witness before the parameters is an `Int`, crossing as one. The generic body, which lets go
  // of a value of its variable, is settled by its callers and has no head of its own.
  let floats = { answer: b"double", params: [b"int64_t", b"double", b"int64_t"] };
  assert_eq(heads(b"m.deepened"), [{ own: [], called: [] }]);
  assert_eq(heads(b"m.deepened@Float"), [{ own: [floats], called: [floats] }])
}

test "a small record of floats crosses a call as its fields" {
  let src = b"type P = { x: Float, y: Float }\nfn mid(a: P, b: P) -> P = { x: (a.x + b.x) / 2.0, y: (a.y + b.y) / 2.0 }\nfn twice(p: P) -> P = mid(p, p)\n";
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let mid = { answer: b"double", params: [b"double", b"double", b"double", b"double", b"Word*"] };
  assert_eq(out.map(|e: Emitted| e.why), [None, None]);
  assert_eq(out.get(0).tables.symbols.map(|d: Defined| d.head), [mid]);
  assert_eq(expects_named(out.get(1).tables), [{ callee: b"m.mid", head: mid }]);
  // Neither body makes an object: `mid` answers fields and `twice` hands `p`'s along.
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b"rt_alloc_p") != None), [false, false])
}

test "a record of a record type holds it in place, its words among its holder's" {
  let src = Bytes::concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"type Segment = { from: Point, label: String, to: Point }\n",
    b"fn segment(from: Point, to: Point, label: String) -> Segment = { from: from, label: label, to: to }\n",
    b"fn end_x(s: Segment) -> Float = s.to.x\n",
    b"fn start(s: Segment) -> Point = s.from\n",
    b"fn relabelled(s: Segment, label: String) -> Segment = { ..s, label: label }\n",
    b"fn wrapped<a>(x: a) -> { outer: { inner: a } } = { outer: { inner: x } }\n",
    b"fn retargeted(s: Segment, to: Point) -> Segment = { ..s, to: to }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None, None]);
  // A `Segment` is its points' words and its label's, five words: wider than the registers, it is
  // held as its box, made by `segment` and copied through its type's `Copy` root by an update that
  // finds it shared.
  assert_eq(has(b"rt_alloc_bytes_p(ctx, INT64_C(56));"), [true, false, false, false, false, false]);
  assert_eq(has(b"_copy_"), [false, false, false, true, false, true]);
  assert_eq(has(b"rt_box_float_p"), [false, true, false, false, false, false]);
  // No record is held in place behind a header, and nothing is moved out of a holder.
  [b"ply_embed", b"rt_alloc_p(", b"ply_take(ctx, ", b"(ply_words(p0) + "].fold(
    (),
    |_: Unit, t: Bytes| assert_eq(has(t), [false, false, false, false, false, false]),
  );
  // A record holding one of a variable's type in place is laid out only where its callers settle
  // the variable: the generic body has no C of its own.
  assert_eq(out.get(4).text, b"");
  assert_eq(has(b"rt_record_p"), [false, false, false, false, false, false])
}

test "a 64-bit width is held in a C register of its type, and in a record as its bits" {
  let src = Bytes::concat_all([
    b"type Tally = { count: U64, label: String, offset: I64 }\n",
    b"fn bumped(t: Tally, by: U64) -> Tally = { ..t, count: t.count + by }\n",
    b"fn scaled(a: U64, b: U64) -> U64 = a * b\n",
    b"fn turned(a: I64) -> I64 = -a\n",
    b"fn largest() -> U64 = 0xFFFF_FFFF_FFFF_FFFFu64\n",
    b"fn kept<a>(x: a) -> { inner: a } = { inner: x }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  // A sum is formed and guarded in the width itself; a product is the runtime's.
  assert_eq(has(b"(uint64_t)"), [true, true, false, true, false]);
  assert_eq(has(b"rt_binary_p"), [false, false, false, false, false]);
  assert_eq(has(b"rt_wide_binary_p(ctx, 2, 3, "), [false, true, false, false, false]);
  assert_eq(has(b"== INT64_MIN"), [false, false, true, false, false]);
  // The record holds its count's bits where its type says; a function takes and answers its width
  // raw, a nullary one too, whose entry boxes it for the constant read.
  assert_eq(has(b"] = (Word)("), [true, false, false, false, false]);
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b"rt_box_fixed_p") != None), [
    false,
    false,
    false,
    false,
    false,
  ]);
  // A record of a variable's type is laid out only where its callers settle the variable.
  assert_eq(out.get(4).text, b"")
}

test "an array holds a record's words in place and a float as its bits" {
  let src = Bytes::concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"fn second_x(ps: Array<Point>) -> Float / {abort.raise} = ps.get(1).x\n",
    b"fn bumped(xs: Array<Float>, i: Int) -> Float / {abort.raise} = xs.get(i) + 1.0\n",
    b"fn count(ps: Array<Point>) -> Int = ps.len()\n",
    b"fn element_of<a>(xs: Array<a>, i: Int) -> a / {abort.raise} = xs.get(i)\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"Array::get", b"Array::len"], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  // A point is its two words where the array holds it, no box made; a `Float`, an element or a
  // point's field, is a load of its bits there.
  assert_eq(has(b", INT64_C(32));"), [false, false, false, false]);
  assert_eq(has(b"ply_f64((ply_words("), [true, true, false, false]);
  assert_eq(has(b"ply_array_len("), [true, true, true, false]);
  // An index past the end raises as `Array::get` does, the array never handed to the runtime.
  assert_eq(has(b"builtin_elaborated_refused_p(ctx, 4, "), [true, true, false, false]);
  assert_eq(has(b"builtin_array_get"), [false, false, false, false]);
  // An array of a variable's type is read only where its callers settle the variable.
  assert_eq(out.get(3).text, b"")
}

test "a value's layout is read off its node's type where the value carries none" {
  let src = Bytes::concat_all([
    b"type P = { x: Int, y: Int }\n",
    b"fn larger(p: P, q: P) -> Int = max(p, q).x\n",
    b"fn kept(p: P, q: P) -> Int = { let m = max(p, q); m.x + m.y }\n",
    b"fn opened(p: P, q: P) -> Int = { let { x, y } = max(p, q); x + y }\n",
    b"fn chosen(p: P, q: P) -> Int = match max(p, q) { { x, y } -> x + y }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"max"], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  // What a generic builtin answers is read at its fields' offsets: nothing asks the runtime for a
  // field by name or whether the record holds one.
  assert_eq(has(b"rt_field_p"), [false, false, false, false]);
  assert_eq(has(b"rt_record_has_p"), [false, false, false, false]);
  // `max` orders the two field by field and answers one; neither crosses to the runtime.
  assert_eq(has(b"rt_builtin_encoded_p("), [false, false, false, false]);
  assert_eq(has(b"builtin_max_p"), [false, false, false, false])
}

test "a builtin the runtime answers a sum of crosses over its encoding, at whatever type it is called" {
  let src = Bytes::concat_all([
    b"fn added(a: Int, b: Int) -> Option<Int> = checked_add(a, b)\n",
    b"fn multiplied(a: Int, b: Int) -> Option<Int> = checked_mul(a, b)\n",
    b"fn wide(a: U64, b: U64) -> Option<U64> = checked_add(a, b)\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  // The runtime makes a sum as an object of its own, which no layout emitted code reads holds.
  assert_eq(has(b"rt_builtin_encoded_p("), [true, true, true]);
  assert_eq([has(b"builtin_checked_add_p"), has(b"builtin_checked_mul_p")], [
    [false, false, false],
    [false, false, false],
  ])
}

test "a builtin crossing over its encoding is handed the witnesses the elaboration passes first, as the runtime declares it" {
  let src = b"fn whole(x: U8) -> Option<Int> = to_int(x)\n";
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"to_int"], true);
  assert_eq(out.map(|e: Emitted| e.why), [None]);
  let code = own_code(out.get(0).text);
  // The runtime's `to_int` takes a witness, then the value.
  assert(code.index_of(b"rt_builtin_encoded_p(") != None, Some(String::of_bytes_lossy(code)));
  assert(
    code.index_of(b"builtin_elaborated_out_count_p(ctx, INT64_C(9), INT64_C(2))") != None,
    Some(String::of_bytes_lossy(code)),
  )
}

test "a record rebuilt from another's fields is written into the constructor that holds it" {
  let src = Bytes::concat_all([
    b"type T = | Con({ name: Bytes, args: List<T> }) | Leaf\n",
    b"fn renamed(t: T, to: Bytes) -> T = match t { Con(c) -> Con({ name: to, args: c.args }), Leaf -> Leaf }\n",
    b"fn rebuilt(t: T) -> T = match t { Con(c) -> Con({ name: c.name, args: c.args.map(|a: T| rebuilt(a)) }), Leaf -> Leaf }\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"m.Con", b"m.Leaf"],
    [b"List::map"],
    true,
  );
  assert_eq(out.map(|e: Emitted| e.why), [None, None]);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  // The field copied out of the old record is a word this body holds, and the new record is
  // gathered into the constructor's words: no record and no case is made to be copied in.
  assert_eq(has(b"rt_alloc_p("), [false, false]);
  assert_eq(has(b"rt_alloc_bytes_p("), [false, false])
}

test "what an operation answers and what a clause is handed are read by their types" {
  let src = Bytes::concat_all([
    b"type P = { x: Int, y: Int }\n",
    b"effect store { read held() -> P\n write keep(p: P) -> Unit }\n",
    b"fn summed() -> Int / {store.held} = { let p = store.held(); p.x + p.y }\n",
    b"fn kept(start: P) -> Int = handle { store.keep(start) } with { var seen = 0, store.keep(p) -> { seen = p.x + p.y; }, return u -> seen }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], handler_builtins(), true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None]);
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"rt_field_p") != None), [false, false])
}

fn handler_builtins() -> List<Bytes> = [b"?handler_init", b"?handler_var", b"?handler_set"]

test "what a handler's variable holds is read by its type" {
  let src = Bytes::concat_all([
    b"type Open = { now: Int, mine: List<Int>, held: Int }\n",
    b"effect bump { write by(n: Int) -> Int }\n",
    b"fn bumped(start: Open, by: Int) -> Int = handle { bump.by(by) } with { var st = start, bump.by(n) -> { let o = st; st = { ..o, now: o.now + n }; st.now + o.held } }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], handler_builtins(), true);
  assert_eq(out.map(|e: Emitted| e.why), [None]);
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b"rt_field_p") != None), [false])
}

test "a constructor pattern reads its argument as the subject's type lays it out" {
  let src = Bytes::concat_all([
    b"type P = { x: Int, y: Int }\n",
    b"type E = { why: Bytes }\n",
    b"fn made(n: Int) -> Result<P, E> = if n > 0 { Ok({ x: n, y: n }) } else { Err({ why: b\"low\" }) }\n",
    b"fn found(n: Int) -> Option<P> = if n > 0 { Some({ x: n, y: n }) } else { None }\n",
    b"fn summed(n: Int) -> Int = match made(n) { Ok({ x, y }) -> x + y, Err({ why }) -> why.len() }\n",
    b"fn first(n: Int) -> Int = match made(n) { Ok({ x: 7, y }) -> y, Ok(p) -> p.x, Err(e) -> e.why.len() }\n",
    b"fn either(n: Int) -> Int = match found(n) { Some({ x, y: 3 }) -> x, Some({ x, y }) -> x + y, None -> 0 }\n",
    b"fn held(rs: List<Result<P, E>>) -> Int = match rs.at(0) { Some(Ok({ x, y })) -> x + y, Some(Err({ why })) -> why.len(), None -> 0 }\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"Some", b"None", b"Ok", b"Err"],
    [b"List::at", b"Bytes::len"],
    true,
  );
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None, None]);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  // Under `Ok`, `Err` and `Some`, held as a word or as an object, a record is read where its
  // fields lie.
  assert_eq(has(b"rt_field_p"), [false, false, false, false, false, false]);
  assert_eq(has(b"rt_record_has_p"), [false, false, false, false, false, false]);
  assert_eq(has(b"rt_record_fits_p"), [false, false, false, false, false, false]);
  // A constructor's object holds its argument as a word: none is read as a record held in place.
  assert_eq(has(b"(intptr_t)(ply_words("), [false, false, false, false, false, false])
}

test "an Option of a pointer is one word wherever it is held, and no object is made of one" {
  let src = Bytes::concat_all([
    b"fn picked(c: Bool, s: String) -> Int = match if c { Some(s) } else { None } { Some(_) -> 1, None -> 0 }\n",
    b"fn found(xs: List<String>, i: Int) -> String = match xs.at(i) { Some(s) -> s, None -> \"\" }\n",
    b"fn nested(s: String) -> Int = match Some(Some(s)) { Some(Some(_)) -> 2, Some(None) -> 1, None -> 0 }\n",
    b"fn kept(s: String) -> Option<String> = Some(s)\n",
    b"fn held(s: String) -> List<Option<String>> = [Some(s), None]\n",
    b"fn same(a: String, b: String) -> Bool = Some(a) == Some(b)\n",
    b"fn either(c: Bool, s: String, o: Option<String>) -> Option<String> = if c { Some(s) } else { o }\n",
    b"fn guarded(xs: List<Int>) -> Int = match xs.at(0) { Some(n) if n > 1 -> n, Some(1) -> 10, _ -> 0 }\n",
    b"fn asked(o: Option<String>) -> Int = match kept(\"k\") { Some(_) -> 1, None -> 0 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"Some", b"None"], [b"List::at"], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None, None, None, None, None]);
  // Nothing reads one as a word or a scalar but through `owned` or `word_of`.
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"ply_maybe_unrouted") != None), [
    false,
    false,
    false,
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  // Built, matched, handed across a call, answered, stored, nested or compared, no object is made.
  let none = [false, false, false, false, false, false, false, false, false];
  [b"rt_equal_p", b"rt_alloc_bytes_p"].fold((), |_: Unit, t: Bytes| assert_eq(has(t), none));
  // An item is read by `std.prelude`'s `List::at`, which answers it as its payload's word.
  assert_eq(
    out.map(|e: Emitted|
      e.tables.generics.calls.any(|g: GenericCall| g.callee == Named(b"std.prelude.List::at"))),
    [false, true, false, false, false, false, false, true, false],
  );
  // It crosses a call as its one word.
  let maybe = { answer: b"Word", params: [b"Word"] };
  assert_eq(out.get(3).tables.symbols.map(|d: Defined| d.head), [maybe]);
  assert_eq(out.get(6).tables.symbols.map(|d: Defined| d.head), [
    { answer: b"Word", params: [b"int64_t", b"Word", b"Word"] },
  ]);
  assert_eq(expects_named(out.get(8).tables).filter(|e: CallHead| e.callee == b"m.kept"), [
    { callee: b"m.kept", head: maybe },
  ])
}

test "a Result is its case's words in the code that knows it, its error's record among them" {
  let src = Bytes::concat_all([
    // Wider than a record that crosses a call as its fields.
    b"type Bad = { why: Bytes, a: Int, b: Int, c: Int, d: Int }\n",
    b"fn half(n: Int) -> Result<Int, Bad> = if n % 2 == 0 { Ok(n / 2) } else { Err({ why: b\"odd\", a: 0, b: 0, c: 0, d: 0 }) }\n",
    b"fn quarter(n: Int) -> Result<Int, Bad> = { let h = half(n)?; half(h) }\n",
    b"fn told(n: Int) -> Bytes = match quarter(n) { Ok(_) -> b\"\", Err(b) -> b.why }\n",
    b"fn plain(n: Int) -> Result<Int, Int> = if n > 0 { Ok(n) } else { Err(n) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"Ok", b"Err"], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  // Built, answered, handed on by `?` and matched, no object is made, whatever the error holds.
  assert_eq(has(b"rt_alloc_bytes_p"), [false, false, false, false])
}

test "a Result whose error is a small record crosses a call as its constructor and the record's fields" {
  let src = Bytes::concat_all([
    b"type Bad = { why: Bytes }\n",
    b"fn half(n: Int) -> Result<Int, Bad> = if n % 2 == 0 { Ok(n / 2) } else { Err({ why: b\"odd\" }) }\n",
    b"fn quarter(n: Int) -> Result<Int, Bad> = { let h = half(n)?; half(h) }\n",
    b"fn told(n: Int) -> Bytes = match quarter(n) { Ok(_) -> b\"\", Err(b) -> b.why }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"Ok", b"Err"], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  // Built, answered, handed on by `?` and matched as its constructor and the record's fields: no
  // record or `Result` is made, and the error's field is read where it came back.
  assert_eq(has(b"rt_alloc_p"), [false, false, false]);
  assert_eq(has(b"rt_field_p"), [false, false, false]);
  assert_eq(has(b"o[0] = "), [true, true, false])
}

test "a record rebuilt from a captured record's fields reads them where they lie, run in place or not" {
  let src = Bytes::concat_all([
    b"type Sp = { start: Int, end: Int, gen: Int }\n",
    b"type C = { own: Int, node: Int, span: Sp }\n",
    b"fn rebuilt(c: C, n: Int) -> C = { let at = |k: Int| { own: 0, node: k, span: c.span }; at(n) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None]);
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"rt_field_p") != None), [false])
}

test "records of a known type are compared field by field, not by the runtime" {
  let src = Bytes::concat_all([
    b"type R = { at: Int, value: Float, price: Decimal, on: Bool }\n",
    b"fn same(a: R, b: R) -> Bool = a == b\n",
    b"fn differ(a: R, b: R) -> Bool = a != b\n",
    b"fn noted(a: { at: Int, note: Option<Int> }, b: { at: Int, note: Option<Int> }) -> Bool = a == b\n",
    b"fn found(a: Option<R>, b: Option<R>) -> Bool = a == b\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"Some", b"None"], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  // Scalars and a `Decimal` in C, and an `Option` by the root written for its type.
  assert_eq(has(b"rt_equal_p"), [false, false, false, false]);
  assert_eq(has(b"rt_decimal_compare_p"), [true, true, false, false]);
  assert_eq(
    out.map(|e: Emitted|
      expects_named(e.tables).any(|x: CallHead| x.callee.index_of(b"equal#Option<") != None)
        || e.tables.calls.any(|k: RootKey| printed(k).index_of(b"equal#Option<") != None)),
    [false, false, true, true],
  )
}

test "a value compared with a constructor of its sum is tested as a pattern tests it" {
  let src = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Num(Int, Float) | Eof\n",
    b"fn punct(k: TK, p: Bytes) -> Bool = k == Punct(p)\n",
    b"fn num(k: TK) -> Bool = k != Num(3, 0.5)\n",
    b"fn eof(k: TK) -> Bool = k == Eof\n",
    b"fn same(a: TK, b: TK) -> Bool = a == b\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"m.Punct", b"m.Num", b"m.Eof"],
    [],
    true,
  );
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  // Its case's test on its words, then each argument where its case lays it: no constructor is
  // built to be compared, and no object's tag is read.
  assert_eq(has(b"->layout"), [false, false, false, false]);
  // A bytes argument by its bytes; two values of the sum through the root that compares them.
  assert_eq(has(b"rt_equal_p"), [false, false, false, false]);
  assert_eq(has(b"memcmp(ply_bytes("), [true, false, false, false]);
  assert_eq(has(symbol_of(b"m.TK#eq").concat(b"(ctx, ")), [false, false, false, true])
}

test "two values of a declared sum are compared through a root written from its constructors" {
  let src = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Num(Int, Float) | Pair(TK, TK) | Eof\n",
    b"fn same(a: TK, b: TK) -> Bool = a == b\n",
  ]);
  let answers = answers_at([b"m"], [src], [b"m.Punct", b"m.Num", b"m.Pair", b"m.Eof"], [
    Named(b"m.same"),
    in_m(keys::Equal, TyCon({ name: b"m.TK", args: [] })),
  ]);
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b.text,
        Refused(r) -> panic(String::of_bytes_lossy(r.why)),
      },
      None -> panic("no answer"),
    };
  let eq = body(b"m.TK#eq");
  // Each constructor's arguments as their types compare: bytes by their bytes, a `Float` in C, and
  // the sum's own arguments through the same root.
  assert(eq.index_of(b"rt_equal_p") == None, None);
  assert(eq.index_of(b"memcmp(ply_bytes(") != None, None);
  assert(eq.index_of(symbol_of(b"m.TK#eq").concat(b"(ctx, ")) != None, None);
  assert(body(b"m.same").index_of(b"rt_equal_p") == None, None)
}

test "the program walk forms a type's drop, dup, copy and boxed case's drop roots as plain roots" {
  let src = b"type TK = | Punct(Bytes) | Pair(TK, TK) | Eof\nfn keep(t: TK) -> TK = t\n";
  let tk = TyCon({ name: b"m.TK", args: [] });
  let wanted = [
    in_m(keys::Drop, tk),
    in_m(keys::Dup, tk),
    in_m(keys::Copy, tk),
    in_m(keys::Cased({ op: keys::Drop, case: 1 }), tk),
  ];
  let d = dump_of(analyse(parse_all(zip_sources([b"m"], [src]))));
  let walked = lowered_roots(
    [b"m"],
    [src],
    loaded_ctors(d, [b"m.Punct", b"m.Pair", b"m.Eof"]),
    loaded_natives(zip_sources([b"m"], [src]), []),
    wanted,
    [],
    [],
    d.embeds,
    d.rows,
    d.walked,
  );
  let kind_of = |k: RootKey|
    match walked.roots.find(|r: RootForm|
        match r { Formed(x) -> x.name == root_name(k), Unformed(u) -> u.name == root_name(k) }) {
      Some(Formed(x)) -> match x.form { Ok(f) -> Ok(f.kind), Err(no) -> Err(no.why) },
      Some(Unformed(u)) -> Err(u.why),
      None -> Err(b"not formed"),
    };
  assert_eq(wanted.map(kind_of), wanted.map(|_: RootKey| Ok(Plain)))
}

test "a boxed case's root asked alone is answered, though its name spells no module" {
  let src = b"type TK = | Punct(Bytes) | Pair(TK, TK) | Eof\n";
  let kept = in_m(keys::Cased({ op: keys::Keep, case: 1 }), TyCon({ name: b"m.TK", args: [] }));
  let d = dump_of(analyse(parse_all(zip_sources([b"m"], [src]))));
  let answers = emit_roots_answer(
    [b"m"],
    [src],
    loaded_ctors(d, [b"m.Punct", b"m.Pair", b"m.Eof"]),
    [],
    [kept],
    [],
    [],
    d.embeds,
    d.rows,
    d.walked,
  );
  assert_eq(
    answers.map(|a: RootAnswer|
      { name: a.name, body: match a.answer { Body(_) -> true, Refused(_) -> false } }),
    [{ name: root_name(kept), body: true }],
  )
}

test "a sum of one word laying a sum of one word in place is let go of, shared and kept through it" {
  let src = Bytes::concat_all([
    b"type Reply = | Done | Text(String)\n",
    b"type Todo = | Hello | Bye | Respond(Reply)\n",
    b"type Hue = | Red | Blue\n",
    b"fn said(t: Todo) -> Int = match t { Respond(Text(s)) -> s.len(), _ -> 0 }\n",
    b"fn maybe(r: Option<Reply>) -> Int = match r { Some(Text(s)) -> s.len(), _ -> 0 }\n",
    b"fn hue(h: Option<Hue>) -> Int = match h { Some(Blue) -> 1, _ -> 0 }\n",
  ]);
  let named = |n: Bytes| TyCon({ name: n, args: [] });
  let todo = named(b"m.Todo");
  let reply = named(b"m.Reply");
  let maybe = TyCon({ name: b"Option", args: [reply] });
  let hues = TyCon({ name: b"Option", args: [named(b"m.Hue")] });
  let walks = [keys::Drop, keys::Share, keys::Keep];
  let wanted = walks.map(|op: TypeOp| in_m(op, todo)).concat(
    walks.map(|op: TypeOp| in_m(op, maybe)),
  ).concat(
    [b"m.said", b"m.maybe", b"m.hue"].map(Named),
  );
  let answers = answers_at(
    [b"m"],
    [src],
    [
      b"m.Done",
      b"m.Text",
      b"m.Hello",
      b"m.Bye",
      b"m.Respond",
      b"m.Red",
      b"m.Blue",
      b"None",
      b"Some",
    ],
    wanted,
  );
  let text = |k: RootKey|
    match answers.find(|a: RootAnswer| a.name == root_name(k)) {
      Some(a) -> match a.answer {
        Body(b) -> own_code(b.text),
        Refused(r) -> Bytes::concat_all([b"refused: ", r.why]),
      },
      None -> b"no answer",
    };
  assert_eq(
    wanted.filter(|k: RootKey| text(k).starts_with(b"refused") || text(k) == b"no answer").map(
      root_name,
    ),
    [],
  );
  // The inner sum's case is read off its own word; a walk calls the inner sum's own root.
  [todo, maybe].fold((), |_: Unit, t: Type|
    assert_eq(
      [keys::Share, keys::Keep].map(|op: TypeOp|
        text(in_m(op, t)).index_of(symbol_of(printed(in_m(op, reply)))) != None),
      [true, true],
    ));
  // An `Option` of a small enum holds no count, so nothing asks for a root to let one go.
  assert_eq(
    match answers.find(|a: RootAnswer| a.name == root_name(Named(b"m.hue"))) {
      Some(a) -> match a.answer {
        Body(b) ->
          b.tables.calls.filter(|k: RootKey| match k { Written(w, _) -> w.ty == hues, _ -> false }),
        Refused(_) -> [in_m(keys::Drop, hues)],
      },
      None -> [in_m(keys::Drop, hues)],
    },
    [],
  )
}

test "a match over a sum of many cases prints no chain of ternaries, and its C grows with its cases alone" {
  // `Big`'s cases lie after a tag word, so a value is counted again by a switch on its case; `Hue` is
  // an enum, matched case by case.
  let src = |n: Int|
    Bytes::concat_all([
      b"type Big = ",
      Bytes::join(
        range(0, n).map(|k: Int| Bytes::concat_all([b"| K", ascii_of_int(k), b"(Int, String)"])),
        b" ",
      ),
      b"\ntype Hue = ",
      Bytes::join(range(0, n).map(|k: Int| b"| H".concat(ascii_of_int(k))), b" "),
      b"\nfn big(b: Big) -> Int = match b { K0(n, _) -> n, _ -> 0 }\n",
      b"fn both(b: Big) -> (Big, Big) = (b, b)\n",
      b"fn hue(h: Hue) -> Int = match h { ",
      Bytes::join(
        range(0, n).map(|k: Int|
          Bytes::concat_all([b"H", ascii_of_int(k), b" -> ", ascii_of_int(k)])),
        b", ",
      ),
      b" }\n",
    ]);
  let names = |n: Int|
    range(0, n).map(|k: Int| b"m.K".concat(ascii_of_int(k))).concat(
      range(0, n).map(|k: Int| b"m.H".concat(ascii_of_int(k))),
    );
  // `Big` is counted again by its type's root, which the program's roots are printed with.
  let counted = root_of(keys::Held(keys::Dup), TyCon({ name: b"m.Big", args: [] }));
  let counted_name = root_text(root_name(counted));
  let code = |n: Int|
    emit_all_program([{ name: b"m", src: src(n) }], names(n), [], true).map(|e: Emitted|
      { name: emitted_name(e), why: e.why, text: own_code(e.text) }).push({
      name: counted_name,
      why: None,
      text: own_code(
        answered_body(answers_at([b"m"], [src(n)], names(n), [counted]), counted_name).text,
      ),
    });
  let fifty = code(50);
  assert_eq(fifty.filter(|e: { name: Bytes, why: Option<Bytes>, text: Bytes }| e.why != None), []);
  assert_eq(
    fifty.filter(|e: { name: Bytes, why: Option<Bytes>, text: Bytes }|
      e.text.index_of(b" ? ") != None).map(|e: { name: Bytes, why: Option<Bytes>, text: Bytes }|
      e.name),
    [],
  );
  // The count switches on the tag word itself, in the root `both` calls.
  let called = symbol_of(counted_name).concat(b"(ctx, ");
  assert(
    fifty.any(|e: { name: Bytes, why: Option<Bytes>, text: Bytes }|
        e.name == counted_name && e.text.index_of(b"switch (") != None)
      && fifty.any(|e: { name: Bytes, why: Option<Bytes>, text: Bytes }|
        e.name == b"m.both" && e.text.index_of(called) != None),
    None,
  );
  // Twice the cases, at most a little over twice the C.
  let size = |es: List<{ name: Bytes, why: Option<Bytes>, text: Bytes }>|
    es.fold(0, |n: Int, e: { name: Bytes, why: Option<Bytes>, text: Bytes }| n + e.text.len());
  assert(size(fifty) * 10 <= size(code(25)) * 22, None)
}

test "a generic definition comparing its type argument is emitted again at each type it compares" {
  let src = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Eof\n",
    b"fn same<a>(x: a, y: a) -> Bool = x == y\n",
    b"fn order<a>(x: a, y: a) -> Ordering where derivable(ord, a) = compare(x, y)\n",
    b"fn tokens(k: TK) -> Bool = same(k, Eof)\n",
    b"fn texts(s: String) -> Bool = same(s, \"x\")\n",
  ]);
  let answers = answers_at([b"m"], [src], [b"m.Punct", b"m.Eof", b"Less", b"Equal", b"Greater"], [
    Named(b"m.same"),
    Named(b"m.order"),
    Named(b"m.tokens"),
    at_spelled(b"m.same", [b"m.TK"]),
    at_spelled(b"m.same", [b"String"]),
    at_spelled(b"m.order", [b"m.TK"]),
  ]);
  let tables = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  let has = |name: Bytes, text: Bytes| tables(name).text.index_of(text) != None;
  // `==` and `compare` at `a` read which type `a` is, and the call names the whole type, handing the
  // sum as its words, which no plain word holds.
  assert_eq(tables(b"m.same").tables.generics.needs, [{ var: 0, reads: Exact }]);
  assert_eq(tables(b"m.order").tables.generics.needs, [{ var: 0, reads: Exact }]);
  assert_eq(tables(b"m.tokens").tables.generics.calls, [
    { callee: Named(b"m.same"), args: types_spelled([b"m.TK"]), carried: [0], fns: [] },
  ]);
  // The generic body is settled by its callers, no C of its own; each specialisation compares as
  // its type does.
  assert_eq(tables(b"m.same").text, b"");
  assert_eq(tables(b"m.order").text, b"");
  assert(!has(b"m.same@m.TK", b"rt_equal_p"));
  assert(has(b"m.same@m.TK", symbol_of(b"m.TK#eq")));
  assert(!has(b"m.same@String", b"rt_equal_p"));
  assert(has(b"m.same@String", b"memcmp(ply_bytes("));
  assert(has(b"m.order@m.TK", symbol_of(b"m.TK#cmp")))
}

test "two values of a declared sum are ordered through a root written from its constructors" {
  let src = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Num(Int, Bytes) | Pair(TK, TK) | Eof\n",
    b"fn order(a: TK, b: TK) -> Ordering = compare(a, b)\n",
  ]);
  let answers = answers_at(
    [b"m"],
    [src],
    [b"m.Punct", b"m.Num", b"m.Pair", b"m.Eof", b"Less", b"Equal", b"Greater"],
    [Named(b"m.order"), in_m(Order, TyCon({ name: b"m.TK", args: [] }))],
  );
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b.text,
        Refused(r) -> panic(String::of_bytes_lossy(r.why)),
      },
      None -> panic("no answer"),
    };
  let cmp = body(b"m.TK#cmp");
  // Each argument as its type orders: bytes by their bytes, an `Int` in C, and the sum's own
  // arguments through the same root; nothing goes to the runtime's order.
  assert(cmp.index_of(b"builtin_compare") == None, None);
  assert(cmp.index_of(b"memcmp(ply_bytes(") != None, None);
  assert(cmp.index_of(symbol_of(b"m.TK#cmp").concat(b"(ctx, ")) != None, None);
  assert(body(b"m.order").index_of(symbol_of(b"m.TK#cmp").concat(b"(ctx, ")) != None, None)
}

test "a root written from a type orders and reflects by the language's builtins, whatever its module defines" {
  // The program holds `std.value`, whose `Value` lays out what a reflection answers.
  let src = Bytes::concat_all([
    b"import std.value (Value)\n",
    b"type TK = | Num(Int) | Pair(TK, TK) | Eof\n",
    b"type Named = | Named(Int)\n",
    b"show for Named by shown\n",
    b"fn shown(n: Named) -> String = \"n\"\n",
    b"fn compare<a>(x: a, y: a) -> Ordering = Greater\n",
    b"fn reflect<a>(x: a) -> Int = 0\n",
  ]);
  let tk = TyCon({ name: b"m.TK", args: [] });
  let roots = [
    in_m(Order, tk),
    in_m(Reflect, tk),
    in_m(Shown, TyCon({ name: b"m.Named", args: [] })),
  ];
  let named = printed(in_m(Shown, TyCon({ name: b"m.Named", args: [] })));
  let answers = answers_at(
    [b"m"],
    [src],
    [
      b"m.Num",
      b"m.Pair",
      b"m.Eof",
      b"m.Named",
      b"Less",
      b"Equal",
      b"Greater",
      b"std.value.VUnit",
      b"std.value.VInt",
      b"std.value.VCtor",
      b"std.value.VShown",
    ],
    roots,
    shipped: [value_fixture()],
  );
  let tables = |root: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == root { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b.tables,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([root, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  [printed(in_m(Order, tk)), printed(in_m(Reflect, tk))].fold((), |_: Unit, root: Bytes| {
    assert_eq(tables(root).generics.calls.map(|g: GenericCall| g.callee), []);
    assert(
      !tables(root).calls.contains(Named(b"m.compare"))
        && !tables(root).calls.contains(Named(b"m.reflect")),
      None,
    )
  });
  // The function a type states for `show` is called by its name, whatever builtin that name is.
  assert(tables(named).calls.contains(Named(b"m.shown")), None)
}

test "a sum's constructors read their arguments' types at the sum's arguments" {
  let d = dump_of(
    analyse(parse_all(zip_sources([b"m"], [b"type P<a, b> = | L(a) | R(b, a) | N\n"]))),
  );
  let int = TyCon({ name: b"Int", args: [] });
  let text = TyCon({ name: b"String", args: [] });
  let at = |name: Bytes|
    match ctor_sums(d.ctors).get(name) {
      Some(cs) -> cs.map(|c: SumCtor| c.fields.map(|f: Type| at_args(f, c.params, [int, text]))),
      None -> [],
    };
  assert_eq(at(b"Result"), [[int], [text]]);
  assert_eq(at(b"m.P"), [[int], [text, int], []])
}

test "a value is reflected as its type says: a scalar as its constructor, a sum or a record through a root" {
  let src = Bytes::concat_all([
    b"import std.value (reflect, shown)\n",
    b"type TK = | Punct(Bytes) | Num(Int, U8) | Pair(TK, TK) | Eof\n",
    b"type Dated = | Dated(Int)\n",
    b"show for Dated by dated\n",
    b"fn dated(d: Dated) -> String = \"d\"\n",
    b"fn same(t: TK) -> Bool = reflect(t) == reflect(t)\n",
    b"fn held(p: { a: Int, b: TK }) -> Bool = reflect(p) == reflect(p)\n",
    b"fn told(d: Dated) -> Bool = shown(d) == shown(d)\n",
    b"fn maybe(o: Option<TK>) -> Bool = reflect(o) == reflect(o)\n",
  ]);
  let values = [
    b"VUnit",
    b"VBool",
    b"VInt",
    b"VStr",
    b"VBytes",
    b"VRecord",
    b"VCtor",
    b"VFixed",
    b"VShown",
  ].map(|v: Bytes| b"std.value.".concat(v));
  let written = [
    in_m(Reflect, TyCon({ name: b"m.TK", args: [] })),
    in_m(
      Reflect,
      TyRecord([
        { name: b"a", ty: TyCon({ name: b"Int", args: [] }) },
        { name: b"b", ty: TyCon({ name: b"m.TK", args: [] }) },
      ]),
    ),
    in_m(Shown, TyCon({ name: b"m.Dated", args: [] })),
    in_m(Reflect, TyCon({ name: b"Option", args: [TyCon({ name: b"m.TK", args: [] })] })),
  ];
  let sum = printed(written.get(0));
  let record = printed(written.get(1));
  let told = printed(written.get(2));
  let maybe = printed(written.get(3));
  assert_eq([sum, record, told], [
    b"m.reflect#m.TK",
    b"m.reflect#{a:Int,b:m.TK}",
    b"m.shown#m.Dated",
  ]);
  let answers = answers_at(
    [b"m"],
    [src],
    [b"m.Punct", b"m.Num", b"m.Pair", b"m.Eof", b"m.Dated"].concat(values),
    [b"m.same", b"m.held", b"m.told", b"m.maybe"].map(Named).concat(written),
    shipped: [value_fixture()],
  );
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b.text,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  let calls = |name: Bytes, root: Bytes|
    body(name).index_of(symbol_of(root).concat(b"(ctx, ")) != None;
  // A sum and a record go to the root that reflects their type, which no runtime reading does.
  assert(calls(b"m.same", sum));
  assert(calls(b"m.held", record));
  assert(calls(b"m.told", told));
  assert(body(sum).index_of(b"builtin_reflect") == None, None);
  // A constructor's name and each argument at its type, the sum's own arguments through the same
  // root; each `Value` is gathered into the words its type lays it in, no object made by name.
  assert(calls(sum, sum));
  [sum, record, told].fold((), |_: Unit, n: Bytes| assert(body(n).index_of(b"@@T") == None, None));
  // A record's fields in their names' order, its sum through the sum's root.
  assert(calls(record, sum));
  // An `Option` is handed to its root as the word it crosses a call as, which the root takes it as.
  let tables = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer { Body(b) -> b.tables, Refused(_) -> no_tables() },
      None -> no_tables(),
    };
  assert(calls(b"m.maybe", maybe));
  let expected = expects_named(tables(b"m.maybe")).filter(|x: CallHead| x.callee == maybe);
  assert(expected.len() > 0, None);
  assert_eq(
    expected.map(|x: CallHead| x.head).at(0),
    tables(maybe).symbols.map(|d: Defined| d.head).at(0),
  );
  // A type whose module states `show` is shown as that function writes it.
  assert(calls(told, b"m.dated"))
}

test "a value is digested through a root written for its type, its parts encoded at theirs" {
  let src = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Pair(TK, TK) | Eof\n",
    b"type Money = | Money(Int, Bytes)\n",
    b"key for Money by cents\n",
    b"fn cents(m: Money) -> Int = match m { Money(c, _) -> c }\n",
    b"fn hashed(t: TK) -> Bytes = digest(t)\n",
    b"fn held(p: { a: Int, b: TK }) -> Bytes = digest(p)\n",
    b"fn priced(m: Money) -> Bytes = digest(m)\n",
  ]);
  let written = [
    in_m(Digest, TyCon({ name: b"m.TK", args: [] })),
    in_m(
      Digest,
      TyRecord([
        { name: b"a", ty: TyCon({ name: b"Int", args: [] }) },
        { name: b"b", ty: TyCon({ name: b"m.TK", args: [] }) },
      ]),
    ),
    in_m(Digest, TyCon({ name: b"m.Money", args: [] })),
  ];
  let sum = printed(written.get(0));
  let record = printed(written.get(1));
  let keyed = printed(written.get(2));
  let answers = answers_at(
    [b"m"],
    [src],
    [b"m.Punct", b"m.Pair", b"m.Eof", b"m.Money"],
    [b"m.hashed", b"m.held", b"m.priced"].map(Named).concat(written),
  );
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  let has = |name: Bytes, text: Bytes| body(name).text.index_of(text) != None;
  // The call hashes what the root writes, and the runtime reads no shape.
  [
    { at: b"m.hashed", root: sum },
    { at: b"m.held", root: record },
    { at: b"m.priced", root: keyed },
  ].fold((), |_: Unit, c: { at: Bytes, root: Bytes }| {
    assert(has(c.at, symbol_of(c.root).concat(b"(ctx, ")), None);
    assert(has(c.at, b"builtin_bytes_blake3_p"), None);
    assert(!has(c.at, b"builtin_digest_p"), None)
  });
  // A leaf is the runtime's encoding of it, passed the words `?encoded` is declared to take; the
  // sum's own arguments go through the same root.
  assert(has(sum, b"builtin_elaborated_encoded_p"), None);
  let opened = b"builtin_elaborated_encoded_p(ctx";
  let text = body(sum).text;
  let passed = match text.index_of(opened) {
    None -> 0,
    Some(i) ->
      iterate(
        { at: i + opened.len(), depth: 0, words: 0 },
        text.len(),
        |s: { at: Int, depth: Int, words: Int }| {
          let c = text.at(s.at);
          if c == 41 && s.depth == 0 { Stop(s.words) } else {
            Continue({
              at: s.at + 1,
              depth: if c == 40 { s.depth + 1 } else if c == 41 { s.depth - 1 } else { s.depth },
              words: if c == 44 && s.depth == 0 { s.words + 1 } else { s.words },
            })
          }
        },
      ),
  };
  assert_eq(
    [passed],
    elaborated_natives().filter(|n: Elaborated| n.name == b"?encoded").map(|n: Elaborated| n.words),
  );
  assert(has(sum, symbol_of(sum).concat(b"(ctx, ")), None);
  assert(has(record, symbol_of(sum).concat(b"(ctx, ")), None);
  // A keyed type is its key.
  assert(body(keyed).tables.calls.contains(Named(b"m.cents")), None)
}

test "an `Ok` of a record held as its box, records laid in it, is made and compared" {
  let ints = |p: Bytes, n: Int|
    Bytes::join(range(0, n).map(|i: Int| Bytes::concat_all([p, ascii_of_int(i), b": Int"])), b", ");
  let src = Bytes::concat_all([
    b"type Inner = { ",
    ints(b"i", 10),
    b", names: List<Bytes> }\n",
    b"type Wide = { context: Inner, shape: Inner, ",
    ints(b"w", 10),
    b", order: List<Bytes> }\n",
    b"fn ok_ok(x: Wide, y: Wide) -> Bool = Ok(x) == Ok(y)\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.filter(|e: Emitted| e.why != None).map(|e: Emitted| e.why), [])
}

test "a keyed sum is compared and ordered by its key through roots its module writes, generic or not" {
  let src = Bytes::concat_all([
    b"type Name = | Name(String)\n",
    b"key for Name by folded\n",
    b"fn folded(n: Name) -> String = match n { Name(s) -> s }\n",
    b"type Bag<a> = | Bag(List<a>)\n",
    b"key for Bag by items\n",
    b"fn items<a>(b: Bag<a>) -> List<a> = match b { Bag(xs) -> xs }\n",
    b"fn same(a: Name, b: Name) -> Bool = a == b\n",
    b"fn ordered(a: Name, b: Name) -> Ordering = compare(a, b)\n",
    b"fn bags(a: Bag<Int>, b: Bag<Int>) -> Bool = a == b\n",
    b"fn top(a: Name, b: Name) -> Name = max(a, b)\n",
  ]);
  let name = TyCon({ name: b"m.Name", args: [] });
  let bag = TyCon({ name: b"m.Bag", args: [TyCon({ name: b"Int", args: [] })] });
  let roots = [in_m(keys::Equal, name), in_m(Order, name), in_m(keys::Equal, bag)];
  let answers = answers_at(
    [b"m"],
    [src],
    [b"m.Name", b"m.Bag"],
    [b"m.same", b"m.ordered", b"m.bags", b"m.top"].map(Named).concat(roots),
  );
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic(String::of_bytes_lossy(b"no answer for ".concat(name))),
    };
  // A comparison calls the root its type's module writes; none asks the runtime to compare.
  [
    { at: b"m.same", root: roots.get(0) },
    { at: b"m.ordered", root: roots.get(1) },
    { at: b"m.bags", root: roots.get(2) },
    { at: b"m.top", root: roots.get(1) },
  ].fold((), |_: Unit, c: { at: Bytes, root: RootKey }| {
    assert(body(c.at).tables.calls.contains(c.root), Some(String::of_bytes_lossy(c.at)));
    assert(body(c.at).text.index_of(b"rt_builtin_encoded_p") == None, None)
  });
  // `max` picks by that order, and the runtime is handed neither.
  assert_eq(body(b"m.top").tables.builtins, []);
  // Each root orders the two keys, which the key's function answers.
  assert(body(printed(roots.get(0))).tables.calls.contains(Named(b"m.folded")), None);
  assert(body(printed(roots.get(1))).tables.calls.contains(Named(b"m.folded")), None);
  roots.map(printed).fold((), |_: Unit, r: Bytes|
    assert(body(r).text.index_of(b"rt_builtin_encoded_p") == None, Some(String::of_bytes_lossy(r))))
}

test "a type's stated arithmetic is called through roots its module writes, and a generic body is settled at the type" {
  let src = Bytes::concat_all([
    b"type Length = | Metres(Int) | Millimetres(Int)\n",
    b"key for Length by millimetres\n",
    b"numeric for Length by { add: plus, sub: minus, mul: times, neg: negated, of_int: metres }\n",
    b"fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }\n",
    b"fn plus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) + millimetres(b))\n",
    b"fn minus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) - millimetres(b))\n",
    b"fn times(a: Length, b: Length) -> Length = Millimetres(millimetres(a) * millimetres(b))\n",
    b"fn negated(a: Length) -> Length = Millimetres(0 - millimetres(a))\n",
    b"fn metres(n: Int) -> Length = Metres(n)\n",
    b"fn grown(a: Length, b: Length) -> Length = -(a + b)\n",
    b"fn shorter(a: Length, b: Length) -> Bool = a < b\n",
    b"fn total<a>(xs: List<a>) -> a where numeric(a) = xs.fold(numeric_of_int(0), |s: a, x: a| s + x)\n",
    b"fn all(xs: List<Length>) -> Length = total(xs)\n",
  ]);
  let length = TyCon({ name: b"m.Length", args: [] });
  let add = in_m(keys::Stated(b"add"), length);
  let neg = in_m(keys::Stated(b"neg"), length);
  let of_int = in_m(keys::Stated(b"of_int"), length);
  let at_length = at_spelled(b"m.total", [b"m.Length"]);
  let answers = answers_at([b"m"], [src], [b"m.Length"], [
    Named(b"m.grown"),
    Named(b"m.shorter"),
    Named(b"m.all"),
    Named(b"m.total"),
    at_length,
    add,
    neg,
    of_int,
    in_m(Order, length),
  ]);
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic(String::of_bytes_lossy(b"no answer for ".concat(name))),
    };
  let unasked = |name: Bytes|
    assert(
      body(name).text.index_of(b"rt_binary_p") == None
        && body(name).text.index_of(b"rt_negate_p") == None,
      Some(String::of_bytes_lossy(name)),
    );
  // Each operator calls the root written for it, which calls the function the module names.
  assert(body(b"m.grown").tables.calls.contains(add), None);
  assert(body(b"m.grown").tables.calls.contains(neg), None);
  assert(body(printed(add)).tables.calls.contains(Named(b"m.plus")), None);
  assert(body(printed(neg)).tables.calls.contains(Named(b"m.negated")), None);
  assert(body(printed(of_int)).tables.calls.contains(Named(b"m.metres")), None);
  // Each root answers a `Length` as its callers hold one: its head is the one they call it by.
  let grown = body(b"m.grown").tables;
  [add, neg].fold((), |_: Unit, k: RootKey| {
    let at = range(0, grown.calls.len()).find(|i: Int| grown.calls.get(i) == k);
    let wrote = grown.generics.expects.filter(|e: Expect| Some(e.callee) == at.map(CallAt));
    assert_eq(
      wrote.map(|e: Expect| e.head),
      body(printed(k)).tables.symbols.map(|d: Defined| d.head),
    )
  });
  // An order's comparison reads the sign of the order the key's root answers.
  assert(body(b"m.shorter").tables.calls.contains(in_m(Order, length)), None);
  // A body over a numeric variable is settled at the type, where its operators are the type's own.
  assert(body(b"m.total").tables.generics.needs.contains({ var: 0, reads: Scalar }), None);
  assert(body(printed(at_length)).text.index_of(b"numeric_binary") == None, None);
  [b"m.grown", b"m.shorter", printed(at_length)].fold((), |_: Unit, n: Bytes| unasked(n))
}

test "a generic body another module defines is settled at a type whose module states its arithmetic" {
  let generic = Bytes::concat_all([
    b"pub fn sign<a>(n: a) -> Int where numeric(a) = {\n",
    b"  let zero: a = numeric_of_int(0);\n",
    b"  if n > zero { 1 } else if n < zero { 0 - 1 } else { 0 }\n",
    b"}\n",
  ]);
  let src = Bytes::concat_all([
    b"import g\n",
    b"type Length = | Metres(Int) | Millimetres(Int)\n",
    b"key for Length by millimetres\n",
    b"numeric for Length by { add: plus, sub: minus, mul: times, neg: negated, of_int: metres }\n",
    b"fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }\n",
    b"fn plus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) + millimetres(b))\n",
    b"fn minus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) - millimetres(b))\n",
    b"fn times(a: Length, b: Length) -> Length = Millimetres(millimetres(a) * millimetres(b))\n",
    b"fn negated(a: Length) -> Length = Millimetres(0 - millimetres(a))\n",
    b"fn metres(n: Int) -> Length = Metres(n)\n",
    b"fn signed(l: Length) -> Int = g::sign(l)\n",
  ]);
  let at = at_spelled(b"g.sign", [b"m.Length"]);
  let answers = answers_at([b"g", b"m"], [generic, src], [b"m.Length"], [Named(b"m.signed"), at]);
  match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
      if answer_name(a) == printed(at) { Some(a) } else { acc }) {
    Some(a) -> match a.answer {
      Body(b) ->
        assert(b.text.index_of(b"numeric_binary") == None, Some(String::of_bytes_lossy(b.text))),
      Refused(r) -> panic(String::of_bytes_lossy(r.why)),
    },
    None -> panic("no answer for the specialisation"),
  }
}

test "`assert_eq` compares as `==` does, and hands the runtime two values only where they differ" {
  let src = Bytes::concat_all([
    b"type Name = | Name(String)\n",
    b"key for Name by folded\n",
    b"fn folded(n: Name) -> String = match n { Name(s) -> s }\n",
    b"fn same(a: Name, b: Name) -> Unit / {abort.raise} = assert_eq(a, b)\n",
    b"fn either<a>(x: a, y: a) -> Unit / {abort.raise} = assert_eq(x, y)\n",
    b"fn names(a: Name, b: Name) -> Unit / {abort.raise} = either(a, b)\n",
  ]);
  let name = TyCon({ name: b"m.Name", args: [] });
  let at_name = at_spelled(b"m.either", [b"m.Name"]);
  let answers = answers_at([b"m"], [src], [b"m.Name"], [
    Named(b"m.same"),
    Named(b"m.names"),
    at_name,
    in_m(keys::Equal, name),
  ]);
  let body = |n: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == n { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([n, b": ", r.why]))),
      },
      None -> panic(String::of_bytes_lossy(b"no answer for ".concat(n))),
    };
  [b"m.same", printed(at_name)].fold((), |_: Unit, n: Bytes| {
    assert(body(n).tables.calls.contains(in_m(keys::Equal, name)), Some(String::of_bytes_lossy(n)));
    assert_eq(body(n).tables.builtins, [b"?assert_failed"])
  })
}

test "a generic sum is shown by the function its module states, at the sum's arguments" {
  let src = Bytes::concat_all([
    b"import std.value (Value)\n",
    b"pub type Deque<a> = | Deque(List<a>, List<a>)\n",
    b"show for Deque by written\n",
    b"pub fn written<a>(d: Deque<a>) -> String = match d { Deque(front, _) -> \"deque\" }\n",
  ]);
  let key = in_m(Shown, TyCon({ name: b"m.Deque", args: [TyCon({ name: b"Int", args: [] })] }));
  let answers = answers_at(
    [b"m"],
    [src],
    [b"m.Deque", b"std.value.VShown"],
    [key],
    shipped: [value_fixture()],
  );
  let body = match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
      if a.name == root_name(key) { Some(a) } else { acc }) {
    Some(a) -> match a.answer { Body(b) -> b, Refused(r) -> panic(String::of_bytes_lossy(r.why)) },
    None -> panic("no answer"),
  };
  // The runtime shows no deque: the function is called at `Int`.
  assert_eq(body.tables.generics.calls.map(|g: GenericCall| { callee: g.callee, args: g.args }), [
    { callee: Named(b"m.written"), args: [TyCon({ name: b"Int", args: [] })] },
  ]);
  assert_eq(body.tables.builtins, [])
}

test "a generic keyed sum is digested as its key, which its function answers at the sum's arguments" {
  let src = Bytes::concat_all([
    b"pub type Deque<a> = | Deque(List<a>, List<a>)\n",
    b"key for Deque by to_list\n",
    b"pub fn to_list<a>(d: Deque<a>) -> List<a> = match d { Deque(front, _) -> front }\n",
    b"fn hashed(d: Deque<Int>) -> Bytes = digest(d)\n",
  ]);
  let key = in_m(Digest, TyCon({ name: b"m.Deque", args: [TyCon({ name: b"Int", args: [] })] }));
  let answers = answers_at([b"m"], [src], [b"m.Deque"], [Named(b"m.hashed"), key]);
  let body = match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
      if a.name == root_name(key) { Some(a) } else { acc }) {
    Some(a) -> match a.answer { Body(b) -> b, Refused(r) -> panic(String::of_bytes_lossy(r.why)) },
    None -> panic("no answer"),
  };
  // The key is the list `to_list` answers at `Int`, encoded by its own root; the runtime reads no
  // deque.
  assert(!body.tables.calls.contains(key), None);
  assert_eq(body.tables.generics.calls.map(|g: GenericCall| { callee: g.callee, args: g.args }), [
    { callee: Named(b"m.to_list"), args: [TyCon({ name: b"Int", args: [] })] },
  ]);
  assert(
    body.text.index_of(b"builtin_elaborated_encoded_p") == None,
    Some(String::of_bytes_lossy(body.text)),
  )
}

test "an update of a record held as its box writes the fields it sets, in the box or a copy of it" {
  let fields = bytes_join(
    range(0, 40).map(|k: Int| Bytes::concat_all([b"f", ascii_of_int(k + 10), b": Int"])),
    b", ",
  );
  let src = Bytes::concat_all([
    b"type Wide = { ",
    fields,
    b", tag: String }\n",
    b"fn tagged(w: Wide, t: String) -> Wide = { ..w, tag: t }\n",
    b"fn bumped(w: Wide) -> Wide = { ..w, f10: w.f10 + 1, f49: 0 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None]);
  let writes = |text: Bytes| text.split(b"] = ").len() - 1;
  // The box itself where it is held only here, else the copy its type's `Copy` root makes, one call
  // however wide; either way only the fields set are written, the string's old value let go of.
  assert_eq(
    out.map(|e: Emitted| {
      let own = own_code(e.text);
      [own.index_of(b"->rc == 1") != None, own.index_of(b"_copy_") != None, writes(own) <= 2]
    }),
    [[true, true, true], [true, true, true]],
  );
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b"memcpy(") != None), [false, false]);
  // `tag`, past the forty `Int`s, is word 40.
  assert(own_code(out.get(0).text).index_of(b")[40] = ") != None, None)
}

test "a root written over a string's bytes makes the string's text, whichever byte builtin makes it" {
  let src = b"fn parts(s: String) -> List<String> / {abort.raise} = s.split(\",\")\n";
  let written = [in_m(Contained(b"split_from"), string_type())];
  let answers = answers_at([b"m"], [src], [], [Named(b"m.parts")].concat(written));
  let made = written.map(|k: RootKey|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if a.name == root_name(k) { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) ->
          [b"->kind = 9;", b"->kind = 10;"].map(|kind: Bytes| b.text.index_of(kind) != None),
        Refused(r) -> panic(String::of_bytes_lossy(r.why)),
      },
      None -> panic("no answer"),
    });
  assert_eq(made, [[true, false]])
}

test "an array is made, written and listed into as the type of its elements lays it out" {
  let src = Bytes::concat_all([
    b"type R = { name: Bytes, n: Int }\n",
    b"fn made(n: Int, r: R) -> Array<R> / {abort.raise} = Array::new(n, r)\n",
    b"fn put(xs: Array<R>, i: Int, r: R) -> Array<R> / {abort.raise} = xs.set(i, r)\n",
    b"fn listed(xs: List<Int>) -> Array<Int> = Array::of_list(xs)\n",
    b"fn words(n: Int, s: Bytes) -> Array<Bytes> / {abort.raise} = Array::new(n, s)\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [],
    [b"Array::new", b"Array::set", b"Array::of_list"],
    true,
  );
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  // Allocated as an array, a write's copy too, its elements written by the code that knows their
  // type.
  assert_eq(has(allocating(array_kind())), [true, true, true, true]);
  // A record lies in the array as its two words, a stride the header's `aux` says, no box made; an
  // `Int` is its bits.
  assert_eq(has(b"rt_alloc_bytes_p(ctx, INT64_C(32));"), [false, false, false, false]);
  assert_eq(has(b"->aux = 2;"), [true, false, false, false]);
  assert_eq(has(b"ply_embed"), [false, false, false, false]);
  // A record written over is let go of by its type: its byte string through the string's drop.
  assert_eq(has(call_start(rel_fn(), [b"ctx"]).concat(b"ply_words(")), [false, true, false, false]);
  // A list's items are read where its trie or its tail holds them, never through the runtime.
  assert_eq(has(b"rt_list_"), [false, false, false, false]);
  assert_eq(
    out.map(|e: Emitted| {
      let c = own_code(e.text);
      c.index_of(item_fn()) != None || c.index_of(leaf_fn()) != None
    }),
    [false, false, true, false],
  );
  // A write is counted in place or into a copy.
  assert_eq(has(b"rt_note_update_p(ctx, "), [false, true, false, false])
}

test "a parameter a tail call hands a part of what calling it answered is given, not lent" {
  let src = Bytes::concat_all([
    b"type Step = | Over | More(Bytes, () -> Step)\n",
    b"fn pulled(k: () -> Step, fuel: Int) -> Bytes =\n",
    b"  match k() { Over -> b\"\", More(b, rest) -> if fuel <= 1 { b } else { pulled(rest, fuel - 1) } }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"m.Over", b"m.More"], [], true);
  let why = out.fold(b"", |acc: Bytes, e: Emitted|
    match e.why { Some(w) -> acc.concat(w), None -> acc });
  assert(why == b"", Some(String::of_bytes_lossy(why)))
}

test "a body generic over a label alone lays nothing out by it, so it is emitted as it stands" {
  let src = Bytes::concat_all([
    b"fn held_byte<[r]>(h: Hold<Bytes, [r]>, i: Int) -> Int / {hold.read[r]} =\n",
    b"  if 0 <= i && i < h.get().len() { h.get().at(i) } else { -1 }\n",
  ]);
  let answers = answers_at([b"m"], [src], [], [Named(b"m.held_byte")]);
  assert_eq(
    answers.map(|a: RootAnswer|
      match a.answer {
        Body(b) -> b.tables.generics.needs,
        Refused(_) -> [{ var: 0 - 1, reads: Exact }],
      }),
    [[]],
  )
}

test "a root written where its module declares the prelude's constructor names still builds and matches the prelude's" {
  let src = Bytes::concat_all([
    b"pub type Op = | Equal | Less | Greater | Some(Int) | None | Ok | Err\n",
    b"pub type Name = | Name(Bytes)\n",
    b"fn maybe(a: Option<Name>) -> Option<Name> = observe(a)\n",
    b"fn either(a: Result<Name, Int>) -> Result<Name, Int> = observe(a)\n",
    b"fn order(o: Ordering) -> Ordering = observe(o)\n",
    b"fn ordered(a: Option<Name>, b: Option<Name>) -> Ordering = compare(a, b)\n",
  ]);
  let name = TyCon({ name: b"m.Name", args: [] });
  let maybe = TyCon({ name: b"Option", args: [name] });
  let either = TyCon({ name: b"Result", args: [name, TyCon({ name: b"Int", args: [] })] });
  let ordering = TyCon({ name: b"Ordering", args: [] });
  let roots = [maybe, either, ordering].fold([], |acc: List<RootKey>, t: Type|
    acc.push(in_m(Lift, t)).push(in_m(Lower, t)));
  let answers = answers_at(
    [b"m"],
    [src],
    [b"m.Equal", b"m.Less", b"m.Greater", b"m.Some", b"m.None", b"m.Ok", b"m.Err", b"m.Name"],
    [b"m.maybe", b"m.either", b"m.order", b"m.ordered"].map(Named).concat(roots),
  );
  assert_eq(
    answers.fold([], |acc: List<Bytes>, a: RootAnswer|
      match a.answer {
        Refused(r) -> acc.push(Bytes::concat_all([answer_name(a), b": ", r.why])),
        _ -> acc,
      }),
    [],
  )
}

test "a list pattern reads its items and its rest in place, whatever the items' type lays out" {
  let src = Bytes::concat_all([
    b"type Op = | Plain | Cased({ op: Op, case: Int }) | Named(Bytes)\n",
    b"fn first(xs: List<Op>) -> Int = match xs { [Cased(c), ..rest] -> c.case + rest.len(), [_, ..rest] -> rest.len(), [] -> 0 }\n",
    b"fn pair(xs: List<Op>) -> Bool = match xs { [Plain, Named(_)] -> true, _ -> false }\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"m.Plain", b"m.Cased", b"m.Named"],
    [],
    true,
  );
  assert_eq(out.map(|e: Emitted| e.why), [None, None]);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  // The runtime reads a list as values of its own, which no item emitted code lays out need be.
  assert_eq([has(b"rt_list_at_p("), has(b"rt_list_rest_p(")], [[false, false], [false, false]])
}

test "a body over a sum of label and row parameters as well as types, specialised at its types, reads none" {
  let src = Bytes::concat_all([
    b"effect log { write note[l](line: String) -> Unit }\n",
    b"type Pipe<a, b, [l], [k] | e, f> = | Pipe((a) -> b / {log.note[l] | e}, (b) -> Unit / {log.note[k] | f})\n",
    b"fn through<a, b, [l], [k] | e>(p: Pipe<a, b, [l], [k] | e, e>, x: a) -> Unit / {log.note[l], log.note[k] | e} =\n",
    b"  match p { Pipe(turn, sink) -> sink(turn(x)) }\n",
    b"fn go(p: Pipe<Int, String, [app], [db] | {}, {}>) -> Unit / {log.note[app], log.note[db]} = through(p, 41)\n",
  ]);
  let spec = at_spelled(b"m.through", [b"Int", b"String"]);
  let answers = answers_at([b"m"], [src], [b"m.Pipe"], [Named(b"m.through"), Named(b"m.go"), spec]);
  let needs = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b.tables.generics.needs,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic(String::of_bytes_lossy(b"no answer for ".concat(name))),
    };
  assert_eq(needs(printed(spec)), [])
}

test "an array of options holds each as its word form, and a generic one is made at its type" {
  let src = Bytes::concat_all([
    b"fn opts(xs: List<Option<Bytes>>) -> Array<Option<Bytes>> = Array::of_list(xs)\n",
    b"fn filled<a>(n: Int, x: a) -> Array<a> / {abort.raise} = Array::new(n, x)\n",
    b"fn ints(n: Int) -> Array<Int> / {abort.raise} = filled(n, 7)\n",
  ]);
  let answers = answers_at([b"m"], [src], [], [
    Named(b"m.opts"),
    Named(b"m.filled"),
    Named(b"m.ints"),
    at_spelled(b"m.filled", [b"Int"]),
  ]);
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  // A list's `Option` of a pointer is that pointer or 0, the word the array holds as it is.
  assert(body(b"m.opts").text.index_of(b"rt_maybe_") == None, None);
  // Making an array reads its element's layout, so a generic body is made again at each.
  assert_eq(body(b"m.filled").tables.generics.needs, [{ var: 0, reads: Layout }]);
  assert(body(b"m.filled@Int").text.index_of(allocating(array_kind())) != None, None)
}

test "a list, an array or a map is compared and digested by roots written for its type" {
  let src = Bytes::concat_all([
    b"type Rec = { name: String, tags: List<Int> }\n",
    b"fn same(a: List<Int>, b: List<Int>) -> Bool = a == b\n",
    b"fn other(a: Array<String>, b: Array<String>) -> Bool = a != b\n",
    b"fn alike(a: Map<Int, List<Int>>, b: Map<Int, List<Int>>) -> Bool = a == b\n",
    b"fn order(a: List<List<Int>>, b: List<List<Int>>) -> Ordering = compare(a, b)\n",
    b"fn held(a: Option<List<Int>>, b: Option<List<Int>>) -> Bool = a == b\n",
    b"fn fields(a: Rec, b: Rec) -> Bool = a == b\n",
    b"fn eq<a>(x: a, y: a) -> Bool = x == y\n",
    b"fn hashed(a: List<Int>) -> Bytes = digest(a)\n",
    b"fn some_int(a: Option<Int>, b: Option<Int>) -> Bool = a == b\n",
    b"fn some_text(a: Option<String>, b: Option<String>) -> Bool = a == b\n",
    b"type Tree<a> = | Leaf(a) | Node(List<Tree<a>>)\n",
    b"fn trees(a: Tree<Int>, b: Tree<Int>) -> Bool = a == b\n",
    b"fn ranked(a: { o: Option<Int>, p: Rec }, b: { o: Option<Int>, p: Rec }) -> Ordering = compare(a, b)\n",
  ]);
  let ints = TyCon({ name: b"List", args: [int_type()] });
  let lists = TyCon({ name: b"List", args: [ints] });
  let map = TyCon({ name: b"Map", args: [int_type(), ints] });
  let entries = TyCon({
    name: b"List",
    args: [TyRecord([{ name: b"key", ty: int_type() }, { name: b"value", ty: ints }])],
  });
  let texts = TyCon({ name: b"Array", args: [string_type()] });
  let trees = TyCon({ name: b"List", args: [TyCon({ name: b"m.Tree", args: [int_type()] })] });
  let option = |t: Type| TyCon({ name: b"Option", args: [t] });
  let walk = |op: Bytes, t: Type| in_m(Contained(op), t);
  let tree = in_m(keys::Equal, TyCon({ name: b"m.Tree", args: [int_type()] }));
  let roots = [
    Named(b"m.same"),
    Named(b"m.other"),
    Named(b"m.alike"),
    Named(b"m.order"),
    Named(b"m.held"),
    Named(b"m.fields"),
    at_key(b"m.eq", [ints], []),
    Named(b"m.hashed"),
    walk(b"equal_from", ints),
    walk(b"equal", map),
    walk(b"equal_from", entries),
    walk(b"ordered_from", lists),
    in_m(Digest, ints),
    walk(b"digest_from", ints),
    Named(b"m.trees"),
    tree,
    Named(b"m.some_int"),
    Named(b"m.some_text"),
    walk(b"equal_from", texts),
    Named(b"m.ranked"),
    walk(b"equal", trees),
    walk(b"equal_from", trees),
  ];
  let ctors = [b"Less", b"Equal", b"Greater", b"Some", b"None", b"m.Leaf", b"m.Node"];
  let answers = answers_at([b"m"], [src], ctors, roots);
  let body = |k: RootKey|
    match answers.find(|a: RootAnswer| a.name == root_name(k)) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([printed(k), b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  // The roots a body calls to compare, order or digest, not those that count what it holds.
  let counting = [
    keys::Drop,
    keys::Share,
    keys::Keep,
    keys::Copy,
    keys::Held(keys::Dup),
    keys::Held(keys::Release),
  ];
  let written_called = |k: RootKey|
    body(k).tables.calls.filter(|c: RootKey|
      match c { Written(w, _) -> c != k && !counting.contains(w.op), _ -> false });
  assert_eq(roots.map(written_called), [
    [walk(b"equal", ints)],
    [walk(b"equal", texts)],
    [walk(b"equal", map)],
    [walk(b"ordered", lists)],
    [walk(b"equal", option(ints))],
    [walk(b"equal", ints)],
    [walk(b"equal", ints)],
    [in_m(Digest, ints)],
    [],
    [walk(b"equal_from", entries)],
    [walk(b"equal", ints)],
    [walk(b"ordered", ints)],
    // A list's digest joins its items' encodings with `Bytes::concat_all`, written for a list of them.
    [
      walk(b"digest_from", ints),
      walk(b"concat_all_from", TyCon({ name: b"List", args: [bytes_type()] })),
    ],
    [],
    [tree],
    [walk(b"equal", trees)],
    [walk(b"equal", option(int_type()))],
    [walk(b"equal", option(string_type()))],
    [],
    [walk(b"ordered", TyCon({ name: b"Option", args: [int_type()] })), walk(b"ordered", ints)],
    [walk(b"equal_from", trees)],
    [tree],
  ]);
  // An array is read by the inline `Array::get`, not the prelude's `Array::at`.
  assert_eq(
    body(walk(b"equal_from", texts)).tables.calls.filter(|c: RootKey|
      printed(c).index_of(b"Array::at") != None),
    [],
  );
  // A list is read and gathered by `std.prelude`'s functions, which every load reaches.
  let prelude_calls = roots.filter(|k: RootKey| match k { Written(_, _) -> true, _ -> false }).fold(
    [],
    |acc: List<RootKey>, k: RootKey|
      body(k).tables.generics.calls.fold(acc, |a: List<RootKey>, g: GenericCall|
        if module_of(g.callee) != prelude_module() || a.contains(g.callee) { a }
        else { a.push(g.callee) }),
  );
  assert_eq(
    prelude_calls.map(printed).sort(),
    written_code().calls.map(|n: Bytes| qualify(prelude_module(), n)),
  );
  // Nothing is handed to the runtime to compare, and a walk is a loop.
  assert_eq(
    roots.filter(|k: RootKey|
      own_code(body(k).text).index_of(b"rt_equal_p") != None
        || own_code(body(k).text).index_of(b"builtin_compare") != None),
    [],
  );
  assert_eq(
    [
      walk(b"equal_from", ints),
      walk(b"equal_from", entries),
      walk(b"ordered_from", lists),
      walk(b"digest_from", ints),
      walk(b"equal_from", texts),
    ].filter(|k: RootKey| own_code(body(k).text).index_of(b"goto ply_loop") == None),
    [],
  )
}

test "a string's builtin that is refused hands the runtime the words it was refused, and crosses nothing" {
  let src = Bytes::concat_all([
    b"fn at(b: Bytes, i: Int) -> Int / {abort.raise} = b.at(i)\n",
    b"fn word(b: Bytes, i: Int) -> U32 / {abort.raise} = b.u32_le(i)\n",
    b"fn cut(b: Bytes, i: Int, j: Int) -> Bytes / {abort.raise} = b.slice(i, j)\n",
    b"fn chars(s: String, i: Int, j: Int) -> String / {abort.raise} = s.slice(i, j)\n",
    b"fn byte(n: Int) -> Bytes / {abort.raise} = byte_of_int(n)\n",
    b"fn from(b: Bytes, n: Bytes, i: Int) -> Option<Int> / {abort.raise} = b.index_of_from(n, i)\n",
    b"fn seek(b: Bytes, n: Int) -> Option<Int> / {abort.raise} = b.index_of_byte(n)\n",
    b"fn scan(b: Bytes, i: Int, n: Int) -> Int / {abort.raise} = b.scan(i, b\"a\", n)\n",
    b"fn parts(s: String, t: String) -> List<String> / {abort.raise} = s.split(t)\n",
    b"fn ints(lo: Int, hi: Int) -> List<Int> = range(lo, hi)\n",
    b"fn find(s: String, t: String) -> Int / {abort.raise} = s.find(t)\n",
    b"fn text(b: Bytes) -> String / {abort.raise} = String::of_bytes(b)\n",
    b"fn told(c: Bool, m: String) -> Unit / {abort.raise} = assert(c, Some(m))\n",
    b"fn untold(c: Bool) -> Unit / {abort.raise} = assert(c, None)\n",
  ]);
  // Each with the number of its refusal, and whether the refusal names text.
  let refusals = [
    { name: b"m.at", code: 8, text: false },
    { name: b"m.word", code: 9, text: false },
    { name: b"m.cut", code: 10, text: false },
    { name: b"m.chars", code: 11, text: false },
    { name: b"m.byte", code: 12, text: false },
    { name: b"m.from", code: 14, text: false },
    { name: b"m.seek", code: 13, text: false },
    { name: b"m.scan", code: 15, text: false },
    { name: b"m.parts", code: 19, text: false },
    { name: b"m.ints", code: 17, text: false },
    { name: b"m.find", code: 20, text: true },
    { name: b"m.text", code: 21, text: true },
    { name: b"m.told", code: 22, text: true },
    { name: b"m.untold", code: 22, text: true },
  ];
  let names = refusals.map(|r: { name: Bytes, code: Int, text: Bool }| r.name);
  let answers = answers_at([b"m"], [src], [b"Some", b"None"], names.map(|n: Bytes| Named(n)));
  let crossings = [keys::Lower, keys::Lift];
  let wrong = refusals.filter(|r: { name: Bytes, code: Int, text: Bool }| {
    let b = answered_body(answers, r.name);
    let native = if r.text { b"builtin_elaborated_refused_text_p(ctx, INT64_C(" }
    else { b"builtin_elaborated_refused_p(ctx, INT64_C(" };
    own_code(b.text).index_of(native.concat(ascii_of_int(r.code)).concat(b"), ")) == None
      || own_code(b.text).index_of(b"rt_builtin_encoded_p") != None
      || b.tables.calls.any(|c: RootKey|
        match c { Written(w, _) -> crossings.contains(w.op), _ -> false })
  });
  assert_eq(wrong.map(|r: { name: Bytes, code: Int, text: Bool }| r.name), []);
  // A message is handed as its text, read where `Some` holds it, and none as a count below 0.
  let told = own_code(answered_body(answers, b"m.told").text);
  assert(told.index_of(b"INT64_C(-1), ") != None, Some(String::of_bytes_lossy(told)))
}

/// The body `answers` holds for the root `name`.
fn answered_body(
  answers: List<RootAnswer>,
  name: Bytes,
) -> { text: Bytes, tables: Tables } / {abort.raise} =
  match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
      if answer_name(a) == name { Some(a) } else { acc }) {
    Some(a) -> match a.answer {
      Body(b) -> b,
      Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
    },
    None -> panic(String::of_bytes_lossy(b"no answer for ".concat(name))),
  }

/// Whether `code` calls a function value, through either entry its descriptor names.
fn calls_a_value(code: Bytes) -> Bool =
  code.index_of(b"->typed)(ctx") != None || code.index_of(b"->uniform(ctx") != None

/// The root of `callee`, a `std.prelude` loop, at the types `args` spell, that runs the lambda
/// `owner` hands at `param`.
fn prelude_loop(
  callee: Bytes,
  owner: Bytes,
  param: Int,
  args: List<Bytes>,
) -> RootKey / {abort.raise} =
  at_key(qualify(prelude_module(), callee), types_spelled(args), [
    { param: param, owner: Named(owner), nth: 0 },
  ])

test "a list's map, filter and fold are the prelude's functions, whose loops run the lambda in place" {
  let src = Bytes::concat_all([
    b"fn bumped(xs: List<Int>) -> List<Int> = xs.map(|x: Int| x + 1)\n",
    b"fn kept(xs: List<Int>) -> List<Int> = xs.filter(|x: Int| x > 2)\n",
    b"fn summed(xs: List<Int>) -> Int = xs.fold(0, |s: Int, x: Int| s + x)\n",
    b"effect tick { write tock() -> Unit }\n",
    b"fn handled(xs: List<Int>) -> List<Int> = xs.map(|x: Int| handle { tick.tock(); x } with { tick.tock() resume k -> k(()), return v -> v })\n",
  ]);
  // Each walks the items of the list's leaves and then its tail in one loop.
  let loops = [
    prelude_loop(b"mapped_from", b"m.bumped", 5, [b"Int", b"Int"]),
    prelude_loop(b"kept_from", b"m.kept", 5, [b"Int"]),
    prelude_loop(b"folded_from", b"m.summed", 5, [b"Int", b"Int"]),
  ];
  // The same loops at those types where no lambda is run in place, as a call handing none settles.
  let generic = [
    at_spelled(b"std.prelude.mapped_from", [b"Int", b"Int"]),
    at_spelled(b"std.prelude.kept_from", [b"Int"]),
    at_spelled(b"std.prelude.folded_from", [b"Int", b"Int"]),
  ];
  let answers = answers_at(
    [b"m"],
    [src],
    [],
    [b"m.bumped", b"m.kept", b"m.summed", b"m.handled"].map(Named).concat(loops).concat(generic),
  );
  let call = |name: Bytes|
    answered_body(answers, name).tables.generics.calls.map(|g: GenericCall|
      { callee: g.callee, lent: g.fns.len() });
  assert_eq(call(b"m.bumped"), [{ callee: Named(b"std.prelude.List::map"), lent: 1 }]);
  assert_eq(call(b"m.kept"), [{ callee: Named(b"std.prelude.List::filter"), lent: 1 }]);
  assert_eq(call(b"m.summed"), [{ callee: Named(b"std.prelude.List::fold"), lent: 1 }]);
  // A lambda holding a `handle` is no root's to run in place.
  assert_eq(call(b"m.handled"), [{ callee: Named(b"std.prelude.List::map"), lent: 0 }]);
  // Each loop runs the lambda where the loop handed none calls the value it is handed.
  let calling = |name: Bytes| calls_a_value(own_code(answered_body(answers, name).text));
  assert_eq(generic.map(printed).map(calling), [true, true, true]);
  assert_eq(loops.map(printed).map(calling), [false, false, false])
}

test "a map's value is read by `std.prelude`'s `Map::get` down its tree, its keys compared at their type" {
  let src = b"fn priced(m: Map<Bytes, Bytes>, k: Bytes) -> Option<Bytes> = m.get(k)\n";
  // The walk lets go of keys and values it holds, so it is lowered at the types its call settles.
  let at = |name: Bytes| at_key(qualify(prelude_module(), name), [bytes_type(), bytes_type()], []);
  let keys = [at(b"Map::get"), at(b"found_under")];
  let read = keys.map(printed);
  let answers = answers_at(
    [b"m"],
    [src],
    [b"Some", b"None", b"Less", b"Equal", b"Greater"],
    [Named(b"m.priced")].concat(keys),
  );
  assert_eq(
    answered_body(answers, b"m.priced").tables.generics.calls.map(|g: GenericCall| g.callee),
    [Named(b"std.prelude.Map::get")],
  );
  // The tree is read where it lies and two keys compared as `Bytes` compares them: the runtime is
  // asked for neither.
  let code = |name: Bytes| own_code(answered_body(answers, name).text);
  assert_eq(
    read.filter(|n: Bytes|
      code(n).index_of(b"rt_map_") != None || code(n).index_of(b"builtin_compare") != None),
    [],
  );
  // An order tested against a constructor is its sign, and a step halved is C's own quotient: no
  // walk makes an `Ordering` or asks the runtime to divide.
  assert_eq(read.filter(|n: Bytes| code(n).index_of(b"rt_arith_p") != None), []);
  // A key the walk compares is read where its leaf holds it, which the walk holds throughout: no
  // count of it is taken, only of the value it answers, once, where the walk answers it.
  let walk = code(printed(at(b"found_under"))).split(b"\n");
  assert_eq(
    walk.filter(|l: Bytes|
      l.index_of(b"[2 * (") != None && l.index_of(b") + 1]") == None && takes_count(l)),
    [],
  );
  assert(
    range(0, walk.len()).any(|i: Int|
      takes_count(walk.get(i))
        && range(i + 1, i + 4).any(|j: Int|
          match walk.at(j) { Some(l) -> l.index_of(b"return t") != None, None -> false })),
    Some(String::of_bytes_lossy(Bytes::join(walk, b"\n"))),
  );
  assert(code(printed(at(b"Map::get"))).index_of(b")->layout") != None, None)
}

test "a map's length is its header's count, whatever its values are laid as" {
  let src = Bytes::concat_all([
    b"type Seen = { kind: Bytes, at: Bytes }\n",
    b"fn counted(m: Map<Bytes, Seen>) -> Int = m.len()\n",
    b"fn names(m: Map<Bytes, Bytes>) -> Int = m.len()\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"Map::len"], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None]);
  // The runtime walks no map whose values emitted code lays out.
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b"builtin_map_len") == None), [
    true,
    true,
  ]);
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b")->len") != None), [true, true])
}

test "two maps are compared by a root that walks `std.prelude`'s `Map::entries`" {
  let src = b"fn same(a: Map<Int, Bytes>, b: Map<Int, Bytes>) -> Bool = a == b\n";
  let root = in_m(Contained(b"equal"), TyCon({ name: b"Map", args: [int_type(), bytes_type()] }));
  let answers = answers_at([b"m"], [src], [b"Some", b"None"], [Named(b"m.same"), root]);
  let body = answered_body(answers, printed(root));
  assert(
    body.tables.generics.calls.any(|g: GenericCall| g.callee == Named(b"std.prelude.Map::entries")),
    None,
  );
  assert_eq(own_code(body.text).index_of(b"rt_equal_p"), None)
}

test "two columns are compared and ordered by roots that read each record in place, as arrays are" {
  let src = Bytes::concat_all([
    b"fn same(a: Columns<{ x: Int, id: Int }>, b: Columns<{ x: Int, id: Int }>) -> Bool = a == b\n",
    b"fn ordered(a: Columns<{ x: Int, id: Int }>, b: Columns<{ x: Int, id: Int }>) -> Ordering =\n",
    b"  compare(a, b)\n",
  ]);
  let columns = TyCon({
    name: b"Columns",
    args: [TyRecord([{ name: b"id", ty: int_type() }, { name: b"x", ty: int_type() }])],
  });
  let equal = in_m(Contained(b"equal"), columns);
  let ordered = in_m(Contained(b"ordered"), columns);
  let answers = answers_at([b"m"], [src], [], [
    Named(b"m.same"),
    Named(b"m.ordered"),
    equal,
    ordered,
  ]);
  assert(answered_body(answers, b"m.same").tables.calls.contains(equal), None);
  assert(answered_body(answers, b"m.ordered").tables.calls.contains(ordered), None);
  // The runtime reads no columns emitted code lays out.
  [b"m.same", b"m.ordered", printed(equal), printed(ordered)].fold((), |_: Unit, n: Bytes|
    assert(
      own_code(answered_body(answers, n).text).index_of(b"rt_equal_p") == None
        && answered_body(answers, n).tables.builtins == [],
      Some(String::of_bytes_lossy(n)),
    ))
}

test "a lambda a call lends is laid out on the caller's stack with its descriptor, whoever the callee is" {
  let src = Bytes::concat_all([
    b"fn apply(f: (Int) -> Int, x: Int) -> Int = f(x)\n",
    b"fn held(f: keep (Int) -> Int) -> List<(Int) -> Int> = [f]\n",
    b"fn same<a>(x: a) -> a = x\n",
    b"fn applied(n: Int) -> Int = apply(|x: Int| x + n, 1)\n",
    b"fn mapped(xs: List<Int>, n: Int) -> List<Int> = xs.map(|x: Int| x + n)\n",
    b"fn kept(n: Int) -> List<(Int) -> Int> = held(|x: Int| x + n)\n",
    b"fn passed(n: Int) -> (Int) -> Int = same(|x: Int| x + n)\n",
    b"fn bare(n: Int) -> Int = apply(|x: Int| x + 1, n)\n",
  ]);
  let names = [b"m.applied", b"m.mapped", b"m.kept", b"m.passed", b"m.bare"];
  let answers = answers_at([b"m"], [src], [], names.map(Named));
  let code = |name: Bytes| own_code(answered_body(answers, name).text);
  let has = |text: Bytes| names.map(|n: Bytes| code(n).index_of(text) != None);
  // The block whole on the caller's stack, its header counted by no one, which the callee may call
  // however it settles; one kept is a block of its own, and a lambda that captures nothing is the
  // root's one block of it.
  assert_eq(has(b"PLY_KIND_REFUSED"), [true, true, false, false, false]);
  assert_eq(has(b"rt_alloc_bytes_p("), [false, false, true, true, false]);
  assert_eq(has(b"_lambda0_value;"), [false, false, false, false, true]);
  // The captured `Int` lies in the block as its bits, which nothing counts.
  assert_eq(has(rel_int_fn()), [false, false, false, false, false])
}

test "a lambda a `std.prelude` function hands on to a native is laid out with the descriptor it calls" {
  let src = Bytes::concat_all([
    b"pub fn guarded(f: (Int) -> Int) -> Int = bracket(|| 1, |_: Int| (), f)\n",
    b"pub fn raised(n: Int) -> Int = guarded(|v: Int| v + n)\n",
  ]);
  let answers = answers_at([prelude_module()], [src], [], [
    Named(b"std.prelude.guarded"),
    Named(b"std.prelude.raised"),
  ]);
  let code = |name: Bytes| own_code(answered_body(answers, name).text);
  assert(code(b"std.prelude.guarded").index_of(b"rt_with_cleanup_p(ctx") != None, None);
  assert(code(b"std.prelude.raised").index_of(b"[] = {0, 0, (Word)(intptr_t)&") != None, None);
  assert(code(b"std.prelude.raised").index_of(b"rt_alloc_bytes_p(") == None, None)
}

test "a lambda that captures nothing is one value made once, wherever it goes" {
  let src = Bytes::concat_all([
    b"fn apply(f: (Int) -> Int, x: Int) -> Int = f(x)\n",
    b"fn kept(fs: List<(Int) -> Int>) -> List<(Int) -> Int> = fs\n",
    b"fn twice(x: Int) -> Int = x * 2\n",
    b"fn stored() -> List<(Int) -> Int> = kept([|x: Int| x + 1, twice])\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let text = match out.filter(|e: Emitted| emitted_name(e) == b"m.stored") {
    [e, ..] -> own_code(e.text),
    [] -> b"",
  };
  assert(text.index_of(b"_desc;") == None, Some(String::of_bytes_lossy(text)));
  assert_eq(text.split(b"extern PlyFnBlock ").len(), 3)
}

test "a lambda inside a lambda another root runs is lent as its owner's" {
  let src = b"fn nested(xss: List<List<Int>>) -> List<List<Int>> = xss.map(|xs: List<Int>| xs.map(|x: Int| x + 1))\n";
  let ints = TyCon({ name: b"List", args: [int_type()] });
  let outer = at_key(b"std.prelude.mapped_from", [ints, ints], [
    { param: 5, owner: Named(b"m.nested"), nth: 0 },
  ]);
  let answers = answers_at([b"m"], [src], [], [Named(b"m.nested"), outer]);
  let body = match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
      if a.name == root_name(outer) { Some(a) } else { acc }) {
    Some(a) -> match a.answer { Body(b) -> b, Refused(r) -> panic(String::of_bytes_lossy(r.why)) },
    None -> panic("no answer"),
  };
  assert(
    body.tables.generics.calls.map(|g: GenericCall| g.fns).contains([
      { param: 1, owner: Named(b"m.nested"), nth: 1 },
    ]),
    None,
  );
  assert(!calls_a_value(own_code(body.text)), None)
}

test "strings and byte strings are compared by their bytes where they lie" {
  let src = Bytes::concat_all([
    b"fn same(a: String, b: String) -> Bool = a == b\n",
    b"fn other(a: Bytes, b: Bytes) -> Bool = a != b\n",
    b"fn named(b: Bytes) -> Int = match b { b\"List\" -> 1, b\"Map\" -> 2, _ -> 0 }\n",
    b"fn worded(s: String) -> Int = match s { \"x\" -> 1, _ -> 0 }\n",
    b"fn lettered(c: Char) -> Int = match c { 'a' -> 1, _ -> 0 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  // A literal pattern compares as `==` at its type does.
  assert_eq(has(b"rt_equal_p"), [false, false, false, false, false]);
  assert_eq(has(b"memcmp(ply_bytes("), [true, true, true, true, false])
}

test "a record holds an Option among its words" {
  let src = Bytes::concat_all([
    b"type Entry = { name: String, note: Option<String> }\n",
    b"fn made(s: String) -> Entry = { name: s, note: Some(s) }\n",
    b"fn noted(e: Entry) -> Int = match e.note { Some(_) -> 1, None -> 0 }\n",
    b"fn cleared(e: Entry) -> Entry = { ..e, note: None }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"Some", b"None"], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  // Built, read and matched, updated: the field is the `Option`'s one word throughout, no object
  // made, and no shape names the record for the runtime to read.
  assert_eq(has(b"rt_alloc"), [false, false, false]);
  assert_eq(out.map(|e: Emitted| e.tables.shapes), [[], [], []])
}

test "a constructor holds its arguments as its declaration types them" {
  let src = Bytes::concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"type Shape = | Circle(Point, Float) | Label(String)\n",
    b"fn circle(at: Point, r: Float) -> Shape = Circle(at, r)\n",
    b"fn radius(s: Shape) -> Float = match s { Circle(_, r) -> r, _ -> 0.0 }\n",
    b"fn centre_x(s: Shape) -> Float = match s { Circle(p, _) -> p.x, _ -> 0.0 }\n",
    b"fn unit(s: Shape) -> Bool = match s { Circle(_, 1.0) -> true, _ -> false }\n",
    b"fn label(s: String) -> Shape = Label(s)\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"m.Circle", b"m.Label"], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  // A circle's point and radius lie in the sum's words after its tag word, a label's string among
  // them: a value is boxed only by the entries answering one to the runtime, never built as an
  // object, held behind a header or tested by its object's tag.
  assert_eq(has(b"rt_alloc_bytes_p("), [true, false, false, false, true]);
  [b"rt_alloc_p(", b"ply_embedded(", b"->layout == ", b"rt_equal_p(ctx, "].fold(
    (),
    |_: Unit, t: Bytes| assert_eq(has(t), [false, false, false, false, false]),
  )
}

test "a record of ints crosses a call as its fields and is made only where its word is asked for" {
  let src = Bytes::concat_all([
    b"type Span = { start: Int, end: Int }\n",
    b"fn widened(s: Span, by: Int) -> Span = { start: s.start - by, end: s.end + by }\n",
    b"fn width(s: Span) -> Int = s.end - s.start\n",
    b"fn twice(s: Span) -> Int = width(widened(widened(s, 1), 2))\n",
    b"fn kept(s: Span) -> List<Span> = [widened(s, 1)]\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  assert_eq(has(b"rt_alloc_bytes_p(ctx, INT64_C(32));"), [false, false, false, true]);
  assert_eq(out.get(1).tables.symbols.map(|d: Defined| d.head), [
    { answer: b"int64_t", params: [b"int64_t", b"int64_t"] },
  ])
}

test "a record literal held in place is written there, with no record made first" {
  let src = Bytes::concat_all([
    b"type T = | TyC({ name: Bytes, args: List<Int> }) | TyV(Int)\n",
    b"type Counter = { next: Int, last: Int }\n",
    b"fn made(n: Bytes, a: List<Int>) -> T = TyC({ name: n, args: a })\n",
    b"fn stepped(v: Int) -> { counter: Counter, at: Int } = { counter: { next: v + 1, last: v }, at: v }\n",
    b"fn copied(h: { c: { tag: Bytes, n: Int } }, v: Int) -> { counter: { tag: Bytes, n: Int }, at: Int } = { counter: h.c, at: v }\n",
    b"fn read(n: { v: Bytes }, a: { v: List<Int> }) -> T = TyC({ name: n.v, args: a.v })\n",
    b"fn held(c: { tag: Bytes, n: Int }, v: Int) -> { counter: { tag: Bytes, n: Int }, at: Int } = { counter: c, at: v }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [b"m.TyC", b"m.TyV"], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  let whole = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  // The literal's fields are the holder's words: a sum's case and a record are gathered in the root's
  // own code with nothing made, and only the entries answering one to the runtime make a box of it.
  assert_eq(has(b"rt_alloc"), [false, false, false, false, false]);
  assert_eq(whole(b"rt_alloc_bytes_p("), [true, true, true, true, true]);
  assert_eq(whole(b"ply_embed"), [false, false, false, false, false])
}

test "a record holding a small record in place crosses a call as its leaves" {
  let src = Bytes::concat_all([
    b"type Holding = { held: List<Int>, places: Map<Bytes, Int>, whole: Map<Bytes, Int> }\n",
    b"fn added(h: Holding, n: Int, key: Bytes) -> { h: Holding, at: Int } = match h.places.get(key) { Some(at) -> { h: h, at: at }, None -> { h: { ..h, held: h.held.push(n), places: h.places.insert(key, h.held.len()) }, at: h.held.len() } }\n",
    b"fn counted(h: Holding, key: Bytes) -> Int = { let p = added(h, 1, key); p.at + p.h.held.len() }\n",
    b"fn kept(h: Holding, key: Bytes) -> List<Holding> = [added(h, 2, key).h]\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"Some", b"None"],
    [b"List::push", b"List::len"],
    true,
  );
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  // The record held is made a box of its three words only where its word is asked for.
  assert_eq(has(b"rt_alloc_bytes_p(ctx, INT64_C(40));"), [false, false, true]);
  // The holding crosses as its three fields, and the answer comes back as its first leaf, `at`, then
  // the holding's fields through one buffer.
  assert_eq(out.get(0).tables.symbols.map(|d: Defined| d.head), [
    { answer: b"int64_t", params: [b"Word", b"Word", b"Word", b"int64_t", b"Word", b"Word*"] },
  ])
}

test "compare at a number, a character or a string orders in C and answers its constructor" {
  let src = Bytes::concat_all([
    b"fn by_name(a: Bytes, b: Bytes) -> Bool = compare(a, b) == Less\n",
    b"fn by_int(a: Int, b: Int) -> Ordering = compare(a, b)\n",
    b"fn by_text(a: String, b: String) -> Ordering = compare_values(a, b)\n",
    b"fn by_list(a: List<Int>, b: List<Int>) -> Ordering = compare(a, b)\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"Less", b"Equal", b"Greater"],
    [b"compare", b"compare_values"],
    true,
  );
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  // None is handed to the runtime: a list is ordered by the prelude's function at its items' type,
  // and the rest answer the index of the constructor the order names, or where the order is tested
  // against a constructor, its sign.
  assert_eq(has(b"builtin_compare"), [false, false, false, false]);
  assert_eq(has(b"memcmp(ply_bytes("), [true, false, true, false])
}

test "a root written to order two values answers `Equal` at once for one object" {
  let src = b"type T = | Leaf(Int) | Node(List<T>)\nfn order(a: T, b: T) -> Ordering = compare(a, b)\nfn listed(a: List<T>, b: List<T>) -> Ordering = compare(a, b)\n";
  let lists = TyCon({ name: b"List", args: [TyCon({ name: b"m.T", args: [] })] });
  let written = [
    in_m(Order, TyCon({ name: b"m.T", args: [] })),
    in_m(Contained(b"ordered"), lists),
  ];
  let answers = answers_at(
    [b"m"],
    [src],
    [b"Less", b"Equal", b"Greater", b"Some", b"None", b"m.Leaf", b"m.Node"],
    [Named(b"m.order"), Named(b"m.listed")].concat(written),
  );
  let code = |k: RootKey| own_code(answered_body(answers, printed(k)).text);
  // A list is one object's word; `T`, a tag word and its payload's, is no one object.
  assert_eq(written.map(|k: RootKey| code(k).index_of(b"(p0) == (p1)") != None), [false, true])
}

test "a root written for a type names the prelude's constructors, whatever its module declares" {
  let src = Bytes::concat_all([
    b"type Op = | Equal | Less | Greater | Some(Int) | None | Ok | Err\n",
    b"type Name = | Name(Bytes)\n",
    b"fn order(a: Name, b: Name) -> Ordering = compare(a, b)\n",
    b"fn maybe(a: Option<Name>, b: Option<Name>) -> Ordering = compare(a, b)\n",
    b"fn either(a: Result<Name, Int>, b: Result<Name, Int>) -> Ordering = compare(a, b)\n",
    b"fn same(a: Result<Name, Int>, b: Result<Name, Int>) -> Bool = a == b\n",
    b"fn listed(a: List<Name>, b: List<Name>) -> Ordering = compare(a, b)\n",
  ]);
  let name = TyCon({ name: b"m.Name", args: [] });
  let either = TyCon({ name: b"Result", args: [name, int_type()] });
  let written = [
    in_m(Order, name),
    in_m(Contained(b"ordered"), TyCon({ name: b"Option", args: [name] })),
    in_m(Contained(b"ordered"), either),
    in_m(Contained(b"equal"), either),
    in_m(Contained(b"ordered_from"), TyCon({ name: b"List", args: [name] })),
  ];
  let own = [b"Equal", b"Less", b"Greater", b"Some", b"None", b"Ok", b"Err"];
  let answers = answers_at(
    [b"m"],
    [src],
    own.map(|c: Bytes| b"m.".concat(c)).concat(own).push(b"m.Name"),
    [b"m.order", b"m.maybe", b"m.either", b"m.same", b"m.listed"].map(|n: Bytes| Named(n)).concat(
      written,
    ),
  );
  // No root reads a tag of the module's own constructors of those names.
  written.fold((), |_: Unit, k: RootKey| {
    let text = answered_body(answers, printed(k)).text;
    assert_eq(
      own.filter(|c: Bytes| text.index_of(Bytes::concat_all([b"@@Tm.", c, b"@@"])) != None),
      [],
    )
  })
}

test "an order tested against a constructor is its sign wherever C orders the values" {
  let src = Bytes::concat_all([
    b"type V = { major: Int, tag: Bytes }\n",
    b"type S = | Big(Int) | Small\n",
    b"fn later(a: V, b: V) -> Bool = compare(a, b) != Greater\n",
    b"fn same(a: Int, b: Int) -> Bool = compare(a, b) == Equal\n",
    b"fn sum(a: S, b: S) -> Bool = compare(a, b) == Less\n",
    b"fn listed(a: List<Int>, b: List<Int>) -> Bool = compare(a, b) == Less\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", src: src }],
    [b"Less", b"Equal", b"Greater", b"m.Big", b"m.Small"],
    [b"compare"],
    true,
  );
  assert_eq(out.map(|e: Emitted| e.why).filter(|w: Option<Bytes>| w != None), []);
  let code = |name: Bytes|
    match out.find(|e: Emitted| emitted_name(e) == name) {
      Some(e) -> own_code(e.text),
      None -> b"",
    };
  // Where C orders the values, their sign is read as the index of the constructor it stands for;
  // each order is tested as that index against the constructor's.
  assert_eq(
    [b"m.later", b"m.same", b"m.sum"].map(|n: Bytes| code(n).index_of(b" < 0 ? 0 : ") != None),
    [true, true, false],
  );
  assert_eq(
    [b"m.later", b"m.same", b"m.sum"].map(|n: Bytes|
      [b"== INT64_C(2))", b"== INT64_C(1))", b"== INT64_C(0))"].filter(|r: Bytes|
        code(n).index_of(r) != None)),
    [[b"== INT64_C(2))"], [b"== INT64_C(1))"], [b"== INT64_C(0))"]],
  )
}

test "an `Int` quotient or remainder by a literal is C's own operator, and by anything else the runtime's" {
  let src = Bytes::concat_all([
    b"fn half(n: Int) -> Int = n / 2\n",
    b"fn rest(n: Int) -> Int = n % -7\n",
    b"fn folded(n: Int) -> Int / {abort.raise} = n / (1 << 5)\n",
    b"fn by(n: Int, d: Int) -> Int / {abort.raise} = n / d\n",
    b"fn by_minus_one(n: Int) -> Int = n / -1\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  // Minus one is the runtime's, since the least `Int` over it overflows.
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b"rt_arith_p(") != None), [
    false,
    false,
    false,
    true,
    true,
  ])
}

test "a `Decimal` is held in registers as its two words, and in a record or an array as them" {
  let src = Bytes::concat_all([
    b"type Line = { price: Decimal, qty: Int }\n",
    b"fn line(price: Decimal, qty: Int) -> Line = { price: price, qty: qty }\n",
    b"fn doubled(l: Line) -> Decimal = l.price * 2.00m\n",
    b"fn cheaper(a: Line, b: Line) -> Bool = a.price < b.price\n",
    b"fn negated(d: Decimal) -> Decimal = -d\n",
    b"fn priced(ds: Array<Decimal>, i: Int) -> Decimal / {abort.raise} = ds.get(i)\n",
    b"fn picked(up: Bool, d: Decimal) -> Decimal = if up { d + 1m } else { d - 1m }\n",
    b"fn listed(d: Decimal) -> List<{ price: Decimal }> = [{ price: d }]\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"Array::get"], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None, None, None]);
  // A line holds its price as two words and its count after them, each as its own bits: flat and
  // raw, as a record of a price alone is. It crosses a call as its fields, and is made a word, a box
  // of its three words, where an entry hands it to the runtime.
  assert_eq(has(b"rt_alloc_bytes_p(ctx, INT64_C(40));"), [
    true,
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  assert_eq(has(b"rt_alloc_bytes_p(ctx, INT64_C(32));"), [
    false,
    false,
    false,
    false,
    false,
    false,
    true,
  ]);
  // Nothing is boxed: a function takes and answers its decimals as their words.
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b"rt_box_decimal_p") != None), [
    false,
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  // Arithmetic and comparison are the runtime's, over the words, allocating nothing.
  assert_eq(has(b"rt_decimal_binary_p("), [false, true, false, false, false, true, false]);
  assert_eq(has(b"rt_decimal_compare_p("), [false, false, true, false, false, false, false]);
  assert_eq(has(b"rt_decimal_negate_p"), [false, false, false, true, false, false, false]);
  assert_eq(has(b"rt_binary_p"), [false, false, false, false, false, false, false])
}

test "a field of a `Columns`' record is loaded from its column, with no record made" {
  let src = Bytes::concat_all([
    b"type P = { label: String, x: Float }\n",
    b"fn x_at(ps: Columns<P>, i: Int) -> Float / {abort.raise} = ps.get(i).x\n",
    b"fn label_at(ps: Columns<P>, i: Int) -> String / {abort.raise} = ps.get(i).label\n",
    b"fn whole(ps: Columns<P>, i: Int) -> List<P> / {abort.raise} = [ps.get(i)]\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"Columns::get"], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  // A field is loaded from its column, `x`'s holding its bits; no record is made of the columns but
  // where the body answers one whole. The runtime reads no `Columns` a body made: an index naming
  // no record raises as the builtin does.
  assert_eq(has(b"ply_f64("), [true, false, true]);
  assert_eq(has(b"rt_alloc_bytes_p("), [false, false, true]);
  assert_eq(has(allocating(columns_kind())), [false, false, false]);
  assert_eq(has(b"builtin_elaborated_refused_p(ctx, 6, "), [true, true, true])
}

test "a `Char` is its own word, compared as C compares the words" {
  let src = Bytes::concat_all([
    b"fn lower(c: Char) -> Bool = c >= 'a' && c <= 'z'\n",
    b"fn same(a: Char, b: Char) -> Bool = a == b\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  let has = |text: Bytes| out.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(out.map(|e: Emitted| e.why), [None, None]);
  assert_eq(has(b"rt_binary_p"), [false, false]);
  assert_eq(has(b"rt_equal_p"), [false, false]);
  // `'a'` is code point 97: `97 << 3 | 2`.
  assert_eq(has(b"((Word)INT64_C(778))"), [true, false])
}

test "a record a pattern binds is read at the offsets its checked type gives" {
  let src = Bytes::concat_all([
    b"type Point = { x: Int, y: Int }\n",
    b"fn sum(ps: List<Point>) -> Int = match ps { [p, ..] -> p.x + p.y, _ -> 0 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None]);
  // `p` holds a `Point`, so each field is a load at its place rather than a search by name.
  assert_eq(out.map(|e: Emitted| e.text.index_of(b"rt_field_p") != None), [false])
}

// --- the emitter's entry ----------------------------------------------------

test "the emitter writes an embed out as the front end's answer says it was read: by its digest" {
  let src = b"fn data() -> Bytes = embed(\"d.txt\")\n";
  let want = { path: b"d.txt", dir: false };
  let d = dump_of(
    analyse_pulling_std_with(
      [{ name: b"m", src: src }],
      [],
      no_rows(),
      { root: b"", manifest: None, supplied: [] },
      [{ root: b"", module: b"m", want: want, read: Ok([embed_file(b"", b"one")]) }],
    ).out,
  );
  match emit_roots_answer(
      [b"m"],
      [src],
      no_ctors(),
      [],
      [Named(b"m.data")],
      [],
      [],
      d.embeds,
      d.rows,
      d.walked,
    ).get(
      0,
    ).answer {
    Body(b) -> assert_eq(b.tables.statics, statics_of(SEmbedded(b"one".blake3()))),
    Refused(r) -> panic(String::of_bytes_lossy(r.why)),
  }
}

test "a shipped module's extern is called as the builtin of its own name" {
  let names = [b"std.native", b"m"];
  let srcs = [
    b"pub extern fn doubled(x: Int) -> Int\n",
    b"import std.native (doubled)\nimport std.native as n\nfn f() -> Int = doubled(2) + n::doubled(3)\n",
  ];
  let d = dump_of(
    analyse_pulling_std_with(
      [{ name: b"m", src: srcs.get(1) }],
      [{ name: b"std.native", src: srcs.get(0) }],
      no_rows(),
    ).out,
  );
  let answers = emit_roots_answer(
    names,
    srcs,
    ctors_of([], [], [], ctor_sums(d.ctors)),
    [b"doubled"],
    [Named(b"m.f")],
    [],
    [],
    d.embeds,
    d.rows,
    d.walked,
  );
  match answers.at(0) {
    Some(a) -> match a.answer {
      Body(b) -> {
        let code = own_code(b.text);
        assert_eq(code.split(b"builtin_doubled_p(ctx").len(), 3);
        assert(code.index_of(b"native_") == None, Some(String::of_bytes_lossy(code)))
      },
      Refused(r) -> panic(String::of_bytes_lossy(r.why)),
    },
    None -> panic("no answer"),
  }
}

/// A function of the prelude calling each extern the emitter writes in place, as the prelude's own
/// functions call them: at a scalar item, a counted one, an item of a type variable, and through a
/// value.
fn in_place_calls() -> List<{ name: Bytes, src: Bytes }> =
  [
    { name: b"start", src: b"(xs: List<Int>) -> Int = ListNode::start(xs)" },
    { name: b"tail_len", src: b"(xs: List<Int>) -> Int = ListNode::tail_len(xs)" },
    { name: b"root", src: b"(xs: List<Int>) -> Option<ListNode<Int>> = ListNode::root(xs)" },
    { name: b"tail_at", src: b"(xs: List<String>) -> String = ListNode::tail_at(xs, 1)" },
    { name: b"len", src: b"(n: ListNode<Int>) -> Int = ListNode::len(n)" },
    { name: b"leaf_at", src: b"(n: ListNode<Int>) -> Int = ListNode::leaf_at(n, 3)" },
    { name: b"leaf_at_any", src: b"<a>(n: ListNode<a>) -> a = ListNode::leaf_at(n, 3)" },
    { name: b"leaf_at_on", src: b"(n: ListNode<String>) -> String = n.leaf_at(3)" },
    { name: b"kid_at", src: b"(n: ListNode<Int>) -> ListNode<Int> = ListNode::kid_at(n, 1)" },
    {
      name: b"tail_push",
      src: b"(xs: List<String>, x: String) -> List<String> = ListNode::tail_push(xs, x)",
    },
    { name: b"tail_set", src: b"(xs: List<Int>) -> List<Int> = ListNode::tail_set(xs, 2, 7)" },
    {
      name: b"leaf_set",
      src: b"(n: ListNode<String>, x: String) -> ListNode<String> = ListNode::leaf_set(n, 2, x)",
    },
    {
      name: b"root_swap",
      src: b"(xs: List<Int>, r: ListNode<Int>) -> Option<ListNode<Int>> = ListNode::root_swap(xs, Some(r)).old",
    },
    {
      name: b"kid_swap",
      src: b"(n: ListNode<Int>) -> ListNode<Int> = ListNode::kid_swap(n, 0, None).node",
    },
    { name: b"tail_start", src: b"(xs: List<Int>) -> List<Int> = ListNode::tail_start(xs, 7)" },
    { name: b"spill", src: b"(xs: List<Int>) -> ListNode<Int> = ListNode::spill(xs).leaf" },
    { name: b"branch", src: b"() -> ListNode<Int> = ListNode::branch()" },
    {
      name: b"map_root",
      src: b"(m: Map<Int, String>) -> Option<MapNode<Int, String>> = MapNode::root(m)",
    },
    { name: b"height", src: b"(m: Map<Int, String>) -> Int = MapNode::height(m)" },
    { name: b"count", src: b"(n: MapNode<Int, String>) -> Int = MapNode::count(n)" },
    { name: b"key", src: b"(n: MapNode<Int, String>) -> Int = MapNode::key(n, 1)" },
    { name: b"value", src: b"(n: MapNode<Int, String>) -> String = MapNode::value(n, 1)" },
    {
      name: b"kid",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid(n, 1)",
    },
    { name: b"kid_max", src: b"(n: MapNode<Int, String>) -> Int = MapNode::kid_max(n, 1)" },
    { name: b"kid_size", src: b"(n: MapNode<Int, String>) -> Int = MapNode::kid_size(n, 1)" },
    { name: b"leaf", src: b"() -> MapNode<Int, String> = MapNode::leaf()" },
    { name: b"map_branch", src: b"() -> MapNode<Int, String> = MapNode::branch()" },
    {
      name: b"pair_put",
      src: b"(n: MapNode<Int, String>, v: String) -> MapNode<Int, String> = MapNode::pair_put(n, 1, 5, v)",
    },
    {
      name: b"pair_set",
      src: b"(n: MapNode<Int, String>, v: String) -> MapNode<Int, String> = MapNode::pair_set(n, 1, 5, v)",
    },
    {
      name: b"pair_take",
      src: b"(n: MapNode<Int, String>) -> String = MapNode::pair_take(n, 1).value",
    },
    {
      name: b"leaf_cut",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::leaf_cut(n, 16).right",
    },
    {
      name: b"branch_cut",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::branch_cut(n, 16).left",
    },
    {
      name: b"kid_out",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_out(n, 1).kid",
    },
    {
      name: b"kid_back",
      src: b"(n: MapNode<Int, String>, k: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_back(n, 1, k, 9, 4)",
    },
    {
      name: b"kid_put",
      src: b"(n: MapNode<Int, String>, k: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_put(n, 1, k, 9, 4)",
    },
    {
      name: b"kid_drop",
      src: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_drop(n, 1)",
    },
    {
      name: b"map_swap",
      src: b"(m: Map<Int, String>, r: MapNode<Int, String>) -> Map<Int, String> = MapNode::map_swap(m, Some(r), 1, 40).map",
    },
  ]

test "each extern written in place is written over the runtime's objects as the layouts lay them out, and calls no native" {
  let calls = in_place_calls();
  let probes = calls.fold(b"\n", |acc: Bytes, c: { name: Bytes, src: Bytes }|
    Bytes::concat_all([acc, b"fn probe_", c.name, c.src, b"\n"]));
  // Every extern `intrinsics` lists is called here.
  let unprobed = intrinsics().filter(|i: { name: Bytes, op: Intrinsic }|
    probes.index_of(i.name.slice(b"std.prelude.".len(), i.name.len()).concat(b"(")) == None);
  assert_eq(unprobed.map(|i: { name: Bytes, op: Intrinsic }| i.name), []);
  let roots = calls.map(|c: { name: Bytes, src: Bytes }| b"std.prelude.probe_".concat(c.name));
  let answers = answers_at(
    [b"std.prelude"],
    [prelude_source::text().concat(probes)],
    [b"Some", b"None"],
    roots.map(Named),
  );
  let code = |name: Bytes|
    match answers.find(|a: RootAnswer| answer_name(a) == b"std.prelude.probe_".concat(name)) {
      Some(a) -> match a.answer {
        Body(b) -> own_code(b.text),
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer for probe_" ++ String::of_bytes_lossy(name)),
    };
  assert_eq(
    calls.filter(|c: { name: Bytes, src: Bytes }| code(c.name).index_of(b"builtin_") != None).map(
      |c: { name: Bytes, src: Bytes }| c.name,
    ),
    [],
  );
  let laid = layouts();
  let has = |name: Bytes, text: Bytes| code(name).index_of(text) != None;
  let field = |name: Bytes| b"->".concat(name);
  let node = |kind: Int| Bytes::concat_all([b"rt_node_p(ctx, ", ascii_of_int(kind), b")"]);
  let past = |from: Int| ascii_of_int(from).concat(b" + (");
  assert_eq(
    [
      has(b"start", field(laid.list.start)),
      has(b"tail_len", field(laid.list.tail_len)),
      has(b"tail_at", past(laid.list.tail)),
      has(b"height", field(laid.map.height)),
      has(b"kid_max", past(laid.tree.keys)),
      has(b"kid_size", past(laid.tree.sizes)),
      has(b"branch", node(laid.trie.branch)),
      has(b"spill", node(laid.trie.leaf)),
      has(b"leaf", node(laid.tree.leaf)),
      has(b"map_branch", node(laid.tree.branch)),
      has(b"branch_cut", node(laid.tree.branch)),
      has(b"leaf_cut", node(laid.tree.leaf)),
      has(b"tail_push", field(laid.list.room)),
    ],
    [true, true, true, true, true, true, true, true, true, true, true, true, true],
  );
  // A write takes what it writes held once, where it is not, by the root copying its type's block,
  // and counts an item's or a pair's.
  let ty = |name: Bytes, args: List<Type>| TyCon({ name: name, args: args });
  let copy = |t: Type| keys::written(keys::Copy, t, b"std.prelude");
  let copied = |name: Bytes, t: Type|
    match answers.find(|a: RootAnswer| answer_name(a) == b"std.prelude.probe_".concat(name)) {
      Some(a) -> match a.answer {
        Body(b) -> b.tables.calls.contains(copy(t)) && has(name, symbol_of(printed(copy(t)))),
        Refused(_) -> false,
      },
      None -> false,
    };
  assert_eq(
    [
      copied(b"tail_push", ty(b"List", [string_type()])),
      copied(b"leaf_set", ty(b"std.prelude.ListNode", [string_type()])),
      copied(b"map_swap", ty(b"Map", [int_type(), string_type()])),
      has(b"pair_set", writable_fn()),
      has(b"kid_put", writable_fn()),
    ],
    [true, true, true, true, false],
  );
  assert_eq(calls.filter(|c: { name: Bytes, src: Bytes }| has(c.name, b"_writable_p(")), [])
}

// A map keyed by a small record holds each key in place in a pair a write answers.
test "a write that answers a record whose field the record holds in place hands the field whole" {
  let probes = Bytes::concat_all([
    b"\nfn probe_key(n: MapNode<{ a: Int, b: Int }, Int>) -> { a: Int, b: Int } = MapNode::pair_take(n, 1).key\n",
    b"fn probe_sum(n: MapNode<{ a: Int, b: Int }, Int>) -> Int = { let t = MapNode::pair_take(n, 1); t.key.a + t.key.b + t.value }\n",
  ]);
  let names = [b"std.prelude.probe_key", b"std.prelude.probe_sum"];
  let answers = answers_at(
    [b"std.prelude"],
    [prelude_source::text().concat(probes)],
    [b"Some", b"None"],
    names.map(Named),
  );
  let code = names.map(|n: Bytes| own_code(answered_body(answers, n).text));
  assert_eq(code.filter(|c: Bytes| c.index_of(b" 0 = 0;") != None).len(), 0);
  assert_eq(code.filter(|c: Bytes| c.index_of(b"builtin_") != None).len(), 0);
  // The first word loaded off the node is the key, whose count the answer takes over: nothing is
  // counted again, and the key is let go of only by opening its box into the fields answered.
  let text = code.get(0);
  let loaded = text.split(b" = ply_words(").get(0).split(b" ");
  let key = loaded.get(loaded.len() - 1);
  let opened = Bytes::concat_all([
    b"if (",
    call_text(last_fn(), [b"ctx", key]),
    b") ",
    call_start(free_fn(), [b"ctx", key]),
  ]);
  assert(
    !takes_count(text) && text.index_of(opened) != None
      && !lets_go_of(Bytes::join(text.split(opened), b""), key),
    Some(String::of_bytes_lossy(text)),
  )
}

test "an array read matched as `Some` or `None` tests its index and reads the element in place" {
  let src = b"fn arrayed(xs: Array<Int>, i: Int) -> Int = match xs.at(i) { Some(v) -> v, None -> 0 }\n";
  let out = emit_all_program([{ name: b"m", src: src }], [b"Some", b"None"], [b"Array::at"], true);
  assert_eq(out.map(|e: Emitted| e.why), [None]);
  let calls = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  assert_eq(calls(b" < (uint64_t)ply_array_len(p0)"), [true])
}

test "a list's item is read by `std.prelude`'s one `List::at`, from the tail or the leaf its trie leads to, in place" {
  let src = Bytes::concat_all([
    b"fn third(xs: List<String>) -> Option<String> = xs.at(2)\n",
    b"fn listed(xs: List<Int>, i: Int) -> Int = match xs.at(i) { Some(v) -> v, None -> 0 }\n",
  ]);
  let read = b"std.prelude.List::at";
  let at_string = printed(at_spelled(read, [b"String"]));
  let answers = answers_at([b"m"], [src], [b"Some", b"None"], [
    Named(b"m.third"),
    Named(b"m.listed"),
    Named(read),
    at_spelled(read, [b"String"]),
  ]);
  let called = |name: Bytes|
    answered_body(answers, name).tables.generics.calls.map(|g: GenericCall| g.callee);
  assert_eq([called(b"m.third"), called(b"m.listed")], [[Named(read)], [Named(read)]]);
  // It counts the item it answers by the item's layout, so its callers settle it at their types.
  assert(answered_body(answers, read).tables.generics.needs.any(|n: Need| n.reads == Layout), None);
  assert_eq(answered_body(answers, read).text, b"");
  let code = |name: Bytes| own_code(answered_body(answers, name).text);
  assert_eq(
    [b"m.listed", at_string].map(|n: Bytes|
      code(n).index_of(b"rt_list_") == None && code(n).index_of(b"builtin_list_") == None),
    [true, true],
  );
  assert(code(at_string).index_of(b")->flags") != None, None);
  assert(
    code(at_string).index_of(b"builtin_") == None,
    Some(String::of_bytes_lossy(code(at_string))),
  );
  assert(code(at_string).index_of(b"ply_words(") != None, None)
}

test "a read of a list counts nothing it reads through it, but its answer once where it lets the list go" {
  let at = at_spelled(b"std.prelude.List::at", [b"String"]);
  let read = printed(at);
  let answers = answers_at(
    [b"m"],
    [b"fn second(xs: List<String>) -> Option<String> = xs.at(1)\n"],
    [b"Some", b"None"],
    [Named(b"m.second"), at],
  );
  let text = own_code(answered_body(answers, read).text);
  // The list's header and an item are read borrowed out of the tail or a leaf; only the answer read
  // out of the list is counted once more, as the list is let go of.
  assert(
    text.split(b"\n").filter(|l: Bytes| takes_count(l)).len() == 1,
    Some(String::of_bytes_lossy(text)),
  )
}

// The leaf is its word or zero, so a body that took it for an `Option`'s object would read every leaf
// as `None`.
test "`ListNode::leaf_of` is read down the list's trie in place, its leaf its payload's word" {
  let probe = b"\nfn probe_leaf(xs: List<Int>) -> Int = match ListNode::leaf_of(xs, 0) { Some(n) -> ListNode::len(n), None -> 0 }\n";
  let root = b"std.prelude.probe_leaf";
  let names = [b"std.prelude"];
  let srcs = [prelude_source::text().concat(probe)];
  let d = dump_of(analyse(parse_all(zip_sources(names, srcs))));
  let answers = emit_roots_answer(
    names,
    srcs,
    ctors_of([b"Some", b"None"], [], [], ctor_sums(d.ctors)),
    // The natives as a runtime that implements it describes them.
    [b"ListNode::leaf_of"],
    [Named(root)],
    [],
    [],
    d.embeds,
    d.rows,
    d.walked,
  );
  let code = own_code(answered_body(answers, root).text);
  // An `Option` of a node is that word or 0, so the answer is the `Option` with nothing decoded.
  assert(
    code.index_of(b"builtin_") == None
      && (code.index_of(item_fn()) != None || code.index_of(leaf_fn()) != None)
      && code.index_of(b") != (0)") == None,
    Some(String::of_bytes_lossy(code)),
  )
}

/// Operation `op` written for `ty`, as module `m` asks for it.
fn in_m(op: TypeOp, ty: Type) -> RootKey = keys::written(op, ty, b"m")

/// Definition `def` at the types `args` spell, as a test names a specialisation.
fn at_spelled(def: Bytes, args: List<Bytes>) -> RootKey / {abort.raise} =
  at_key(def, types_spelled(args), [])

/// The types `ss` spell.
fn types_spelled(ss: List<Bytes>) -> List<Type> / {abort.raise} =
  ss.map(|s: Bytes|
    match type_spelled(s) {
      Some(t) -> t,
      None -> panic(String::of_bytes_lossy(b"a spelling of no type: ".concat(s))),
    })

/// The roots `wanted` keys as the emitter answers them over what the front end read of the program.
/// `shipped` are fixtures of the toolchain's modules the program imports, lowered with it.
fn answers_at(
  names: List<Bytes>,
  srcs: List<Bytes>,
  ctors: List<Bytes>,
  wanted: List<RootKey>,
  shipped: List<Source> = [],
  published: List<Published> = [],
) -> List<RootAnswer> / {abort.raise} = {
  let d = if shipped.len() == 0 { dump_of(analyse(parse_all(zip_sources(names, srcs)))) }
  else { dump_of(analyse_pulling_std_with(zip_sources(names, srcs), shipped, no_rows()).out) };
  emit_roots_answer(
    shipped.map(|s: Source| s.name).concat(names),
    shipped.map(|s: Source| s.src).concat(srcs),
    loaded_ctors(d, ctors),
    loaded_natives(shipped.concat(zip_sources(names, srcs)), []),
    wanted,
    [],
    [],
    d.embeds,
    d.rows,
    d.walked,
    published,
  )
}

/// `std.value` as the reflection roots read it: its `Value` and the externs that make one.
fn value_fixture() -> Source =
  {
    name: b"std.value",
    src: Bytes::concat_all([
      b"pub type Value = | VUnit | VBool(Bool) | VInt(Int) | VFloat(Float) | VDecimal(Decimal) | VFixed(String, U128) | VChar(Char) | VStr(String) | VBytes(Bytes) | VList(List<Value>) | VRecord(List<Field>) | VCtor(String, List<Value>) | VMap(List<Entry>) | VFn(Fun) | VHold | VTask(Int) | VChan(Int) | VSecret | VElided(Int) | VArray(List<Value>) | VShown(String)\n",
      b"pub type Field = { name: String, value: Value }\n",
      b"pub type Entry = { key: Value, value: Value }\n",
      b"pub type Fun = | FNamed(String) | FAnonymous | FConst({ arity: U8, value: Value }) | FProject({ arity: U8, index: U8 }) | FTable({ arity: U8, entries: List<Entry>, default: Value })\n",
      b"pub extern fn reflect<a>(x: a) -> Value\n",
      b"pub extern fn shown<a>(x: a) -> Value\n",
    ]),
  }

test "a generic definition reached at a type held apart from a word is emitted again at it" {
  let src = Bytes::concat_all([
    b"fn twice<a>(x: a) -> a where numeric(a) = x + x\n",
    b"fn go(f: Float) -> Float = twice(f)\n",
    b"fn id<a>(x: a) -> a = x\n",
    b"fn same(s: String) -> String = id(s)\n",
    b"fn down<a>(n: Int, x: a) -> a where numeric(a) = if n <= 0 { x } else { down(n - 1, x + x) }\n",
    b"fn fall(n: Int) -> Int = down(n, 1)\n",
  ]);
  let wanted = [b"m.go", b"m.same", b"m.fall", b"m.twice", b"m.id"].map(Named).concat([
    at_spelled(b"m.twice", [b"Float"]),
    at_spelled(b"m.down", [b"Int"]),
  ]);
  let answers = answers_at([b"m"], [src], [], wanted);
  let body = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  let has = |name: Bytes, text: Bytes| body(name).text.index_of(text) != None;
  // A call of a generic definition names a placeholder the unit settles, with its type arguments,
  // which the unit reads as far as the callee needs.
  assert(has(b"m.go", b"@@g0@@"));
  assert_eq(body(b"m.go").tables.generics.calls, [
    { callee: Named(b"m.twice"), args: types_spelled([b"Float"]), carried: [0], fns: [] },
  ]);
  assert_eq(body(b"m.same").tables.generics.calls, [
    { callee: Named(b"m.id"), args: types_spelled([b"String"]), carried: [], fns: [] },
  ]);
  // `twice` reads its witness, which a scalar argument does in C; `id`, answering a value of its
  // variable owned, takes its argument, needs nothing of it and is printed as it stands.
  assert(body(b"m.twice").tables.generics.needs.contains({ var: 0, reads: Scalar }), None);
  assert_eq(body(b"m.id").tables.generics.needs, []);
  assert(body(b"m.id").text.len() > 0, None);
  // At `Float` the witnessed `+` is C's own, and the parameter a `double`.
  assert(has(b"m.twice@Float", b"double "));
  assert(!has(b"m.twice@Float", b"numeric_binary"));
  // A specialisation's call of itself stays in it, here as a loop that calls no root.
  assert(has(b"m.down@Int", b"goto ply_loop;"));
  assert(!has(b"m.down@Int", b"numeric_binary"));
  assert_eq(body(b"m.down@Int").tables.calls, [])
}

test "a call carries a variable that changes how a parameter or the answer holding it is held" {
  let src = Bytes::concat_all([
    b"fn first<a>(xs: List<a>) -> Option<a> = xs.at(0)\n",
    b"fn rest<a>(xs: List<a>) -> List<a> = xs\n",
    b"fn floats(xs: List<Float>) -> Float = match first(xs) { Some(x) -> x, None -> 0.0 }\n",
    b"fn tails(xs: List<Float>) -> Int = rest(xs).len()\n",
  ]);
  let answers = answers_at([b"m"], [src], [], [Named(b"m.floats"), Named(b"m.tails")]);
  let calls = |name: Bytes|
    match answers.fold(None, |acc: Option<RootAnswer>, a: RootAnswer|
        if answer_name(a) == name { Some(a) } else { acc }) {
      Some(a) -> match a.answer {
        Body(b) -> b.tables.generics.calls,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic("no answer"),
    };
  // An `Option<Float>` holds its float apart from a word, which an `Option` of a variable cannot.
  assert_eq(calls(b"m.floats"), [
    { callee: Named(b"m.first"), args: types_spelled([b"Float"]), carried: [0], fns: [] },
  ]);
  // A list is one pointer whatever it holds, so a generic body holds it alike.
  assert_eq(calls(b"m.tails"), [
    { callee: Named(b"m.rest"), args: types_spelled([b"Float"]), carried: [], fns: [] },
  ])
}

test "a contract's clauses read the parameters, and an `ensures` the answer, at the types the scheme gives them" {
  let src = Bytes::concat_all([
    b"type Account = { name: String, balance: Int }\n",
    b"fn adjusted(account: Account, amount: Int) -> Account\n",
    b"  requires account.balance > 0 - 1000000\n",
    b"  ensures result.balance == account.balance + amount\n",
    b"  ensures result.name == account.name\n",
    b"= { name: account.name, balance: account.balance + amount }\n",
    b"fn kept<a>(xs: List<a>, n: Int) -> List<a>\n",
    b"  requires n <= xs.len()\n",
    b"  ensures result.len() == xs.len()\n",
    b"= xs\n",
  ]);
  let clause = |def: Bytes, kind: ClauseKind, n: Int| Clause({ def: Named(def), kind: kind, n: n });
  let keyed = [
    clause(b"m.adjusted", Requires, 0),
    clause(b"m.adjusted", Ensures, 0),
    clause(b"m.adjusted", Ensures, 1),
    clause(b"m.kept", Requires, 0),
    clause(b"m.kept", Ensures, 0),
  ];
  let wanted = keyed.map(root_name);
  let answers = answers_at([b"m"], [src], [], keyed);
  assert_eq(
    answers.fold([], |acc: List<Bytes>, r: RootAnswer|
      match r.answer {
        Body(_) -> acc,
        Refused(no) -> acc.push(Bytes::concat_all([answer_name(r), b": ", no.why])),
      }),
    [],
  );
  assert_eq(wanted.filter(|w: RootName| !answers.any(|r: RootAnswer| r.name == w)), [])
}

test "a call inside a recursive group names its callee in the caller's variables, however each numbers its own" {
  // `f`'s `a` is `g`'s `d` and its `b` is `g`'s `c`: each member numbers the shared variables apart.
  // No call is in tail position, so the two are no loop each specialisation would enter.
  let src = Bytes::concat_all([
    b"fn f<a, b>(x: a, y: b, n: Int) -> b = if n <= 0 { y } else { let r = g(y, x, n - 1); r }\n",
    b"fn g<c, d>(x: c, y: d, n: Int) -> c = if n <= 0 { x } else { let r = f(y, x, n - 1); r }\n",
  ]);
  let answers = answers_at([b"m"], [src], [], [
    at_spelled(b"m.f", [b"Int", b"String"]),
    at_spelled(b"m.g", [b"String", b"Int"]),
  ]);
  let tables = |name: Bytes| answered_body(answers, name).tables;
  let called = |name: Bytes|
    tables(name).generics.calls.map(|g: GenericCall| { callee: g.callee, args: g.args });
  assert_eq(called(b"m.f@Int,String"), [
    { callee: Named(b"m.g"), args: types_spelled([b"String", b"Int"]) },
  ]);
  assert_eq(called(b"m.g@String,Int"), [
    { callee: Named(b"m.f"), args: types_spelled([b"Int", b"String"]) },
  ]);
  // What each call answers is the caller's own type there, so neither reads a variable.
  assert_eq([b"m.f@Int,String", b"m.g@String,Int"].map(|n: Bytes| tables(n).generics.needs), [
    [],
    [],
  ])
}

/// Whether the body of root `name` among `answers` jumps back to its own start.
fn loops_in(answers: List<RootAnswer>, name: Bytes) -> Bool / {abort.raise} =
  answered_body(answers, name).text.index_of(b"goto ply_loop;") != None

test "a tail loop runs at the types it is called at, each member at the arguments its caller names it at" {
  let src = Bytes::concat_all([
    b"fn spin<a, b>(x: a, y: b, n: Int) -> Int = if n <= 0 { 0 } else { spin(y, x, n - 1) }\n",
    b"fn ping<a>(x: a, n: Int) -> a = if n <= 0 { x } else { pong(x, n - 1) }\n",
    b"fn pong<a>(x: a, n: Int) -> a = if n <= 0 { x } else { ping(x, n - 1) }\n",
    b"fn go() -> Float = { let _ = spin(1.5, 7, 3); ping(1.5, 3) }\n",
  ]);
  let answers = answers_at([b"m"], [src], [], [
    Named(b"m.go"),
    Named(b"m.spin"),
    at_spelled(b"m.spin", [b"Float", b"Int"]),
    Named(b"m.ping"),
    Named(b"m.pong"),
    at_spelled(b"m.pong", [b"Float"]),
  ]);
  let body = |name: Bytes| answered_body(answers, name);
  let loops = |name: Bytes| loops_in(answers, name);
  assert_eq(body(b"m.go").tables.generics.calls, [
    { callee: Named(b"m.spin"), args: types_spelled([b"Float", b"Int"]), carried: [0, 1], fns: [] },
    { callee: Named(b"m.ping"), args: types_spelled([b"Float"]), carried: [0], fns: [] },
  ]);
  // `spin` lends values of both its variables, which its entry lets go of, so its callers settle it.
  // Its call hands `y` on as `x`: at `Float, Int` it loops through itself at `Int, Float`, under the
  // first.
  assert_eq(body(b"m.spin").text, b"");
  assert_eq(body(b"m.spin@Float,Int").tables.members.map(printed), [
    b"m.spin@Float,Int",
    b"m.spin@Int,Float",
  ]);
  assert(loops(b"m.spin@Float,Int"));
  assert_eq(body(b"m.spin@Float,Int").tables.generics.calls, []);
  // `ping` and `pong` as they stand are one loop its callers settle at each variable; asked for by
  // `pong`, the loop at `Float` is formed under `ping`, and reads no variable.
  assert_eq(body(b"m.ping").text, b"");
  assert_eq(body(b"m.ping").tables.members, [Named(b"m.ping"), Named(b"m.pong")]);
  assert_eq(body(b"m.ping").tables.generics.needs, [{ var: 0, reads: Exact }]);
  assert_eq(body(b"m.ping@Float").tables.members.map(printed), [b"m.ping@Float", b"m.pong@Float"]);
  assert(loops(b"m.ping@Float"));
  assert_eq(
    (body(b"m.ping@Float").tables.generics.needs, body(b"m.ping@Float").tables.generics.calls),
    ([], []),
  )
}

test "a tail loop whose members number their variables apart runs as one at the arguments each names" {
  // `f`'s `a` is `g`'s `d` and its `b` is `g`'s `c`.
  let src = Bytes::concat_all([
    b"fn f<a, b>(x: a, y: b, n: Int) -> b = if n <= 0 { y } else { g(y, x, n - 1) }\n",
    b"fn g<c, d>(x: c, y: d, n: Int) -> c = if n <= 0 { x } else { f(y, x, n - 1) }\n",
  ]);
  let answers = answers_at([b"m"], [src], [], [at_spelled(b"m.g", [b"String", b"Int"])]);
  let looped = answered_body(answers, b"m.f@Int,String");
  assert_eq(looped.tables.members.map(printed), [b"m.f@Int,String", b"m.g@String,Int"]);
  assert(loops_in(answers, b"m.f@Int,String"));
  assert_eq(looped.tables.generics.needs, [])
}

test "a type nothing in the program settles is filed as `Unit`, so a body of no type variable reads none" {
  let src = Bytes::concat_all([
    b"fn empty() -> Int = { let xs = []; xs.len() }\n",
    b"fn wrapped(n: Int) -> Bool = match Ok(n) { Ok(_) -> true, Err(_) -> false }\n",
    b"fn nothing() -> Int = match None { Some(_) -> 1, None -> 0 }\n",
    b"fn fresh() -> Int = Map::new().len()\n",
    b"fn made(n: Int) -> Int = { let f = |x: Int| []; f(n).len() }\n",
    b"fn pair(n: Int) -> Int = match (n, []) { (k, _) -> k }\n",
  ]);
  match program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let open = p.roots.filter(|r: Root|
        match r.filed {
          Ok(f) -> f.typed.values().any(|t: Typed| has_vars(t.ty) || t.args.any(has_vars)),
          Err(_) -> true,
        });
      assert_eq(open.map(|r: Root| printed(r.key)), []);
      let empty = p.roots.filter(|r: Root| printed(r.key) == b"m.empty");
      assert(
        empty.all(|r: Root|
          match r.filed {
            Ok(f) ->
              f.typed.values().any(|t: Typed|
                t.ty == TyCon({ name: b"List", args: [TyCon({ name: b"Unit", args: [] })] })),
            Err(_) -> false,
          }),
        None,
      )
    },
  }
}

test "a tail loop through calls written on a value runs as one at its types" {
  // Each call is written on a value, so only what the check filed of it says which function it is.
  let src = Bytes::concat_all([
    b"type Countdown = new { left: Int }\n",
    b"fn Countdown::even_at<a>(c: Countdown, x: a) -> a = if c.left <= 0 { x } else { let next: Countdown = { left: c.left - 1 }; next.odd_at(x) }\n",
    b"fn Countdown::odd_at<a>(c: Countdown, x: a) -> a = if c.left <= 0 { x } else { let next: Countdown = { left: c.left - 1 }; next.even_at(x) }\n",
  ]);
  let answers = answers_at([b"m"], [src], [], [at_spelled(b"m.Countdown::odd_at", [b"Float"])]);
  let looped = answered_body(answers, b"m.Countdown::even_at@Float");
  assert_eq(looped.tables.members.map(printed), [
    b"m.Countdown::even_at@Float",
    b"m.Countdown::odd_at@Float",
  ]);
  assert(loops_in(answers, b"m.Countdown::even_at@Float"))
}

test "a generic definition reached at a record type reads the record where its layout puts it" {
  let src = b"fn first<a, b>(p: { l: a, r: b }) -> a = p.l\nfn pick(q: { l: { x: Float, y: Float }, r: Int }) -> Float = first(q).x\n";
  let at = at_spelled(b"m.first", [b"{x:Float,y:Float}", b"Int"]);
  let laid = printed(at);
  let answers = answers_at([b"m"], [src], [], [Named(b"m.pick"), Named(b"m.first"), at]);
  let text = |name: Bytes|
    match answers.fold(None, |acc: Option<Bytes>, a: RootAnswer|
        if answer_name(a) == name {
          Some(match a.answer {
            Body(x) -> x.text,
            Refused(r) -> panic(String::of_bytes_lossy(r.why)),
          })
        } else { acc }) {
      Some(t) -> t,
      None -> panic("no answer"),
    };
  let tables = |name: Bytes|
    match answers.fold(None, |acc: Option<Tables>, a: RootAnswer|
        if answer_name(a) == name {
          match a.answer { Body(x) -> Some(x.tables), Refused(_) -> acc }
        } else { acc }) {
      Some(t) -> t,
      None -> panic("no answer"),
    };
  assert_eq(tables(b"m.pick").generics.calls, [
    {
      callee: Named(b"m.first"),
      args: types_spelled([b"{x:Float,y:Float}", b"Int"]),
      carried: [0, 1],
      fns: [],
    },
  ]);
  // Unspecialised, `p`'s fields may be anything: both its variables' layouts are read, so its
  // callers settle it, and at the record `p.l` is read by place.
  assert_eq(text(b"m.first"), b"");
  assert(
    [0, 1].all(|v: Int| tables(b"m.first").generics.needs.contains({ var: v, reads: Layout })),
    None,
  );
  assert(text(laid).index_of(b"rt_field_p") == None)
}

test "a generic call carrying a record that holds a sum of several words hands it as the specialisation it settles on takes it" {
  let src = Bytes::concat_all([
    b"type Term = | Num(Int) | Name(Bytes)\n",
    b"fn put<a>(xs: List<a>, x: a) -> List<a> = xs.push(x)\n",
    b"fn added(xs: List<{ name: Bytes, term: Term }>, e: { name: Bytes, term: Term }) -> List<{ name: Bytes, term: Term }> = put(xs, e)\n",
  ]);
  let at = at_spelled(b"m.put", [b"{name:Bytes,term:m.Term}"]);
  let laid = printed(at);
  let answers = answers_at([b"m"], [src], [b"m.Num", b"m.Name"], [Named(b"m.added"), at]);
  let body = |name: Bytes|
    match answers.find(|a: RootAnswer| answer_name(a) == name) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic(String::of_bytes_lossy(b"no answer for ".concat(name))),
    };
  assert_eq(body(b"m.added").tables.generics.calls.map(|g: GenericCall| g.carried), [[0]]);
  // The caller writes the call to the head the specialisation has: the record's leaves, its sum as
  // each of its words, on both sides.
  let written = body(b"m.added").tables.generics.expects.map(|e: Expect| e.head);
  assert_eq(written, body(laid).tables.symbols.map(|d: Defined| d.head));
  assert(written.all(|h: Head| h.params.len() > 3), None)
}

test "a constructor rebuilt from the one its parameter matched, one field changed, passes its check at every type" {
  let src = Bytes::concat_all([
    b"type Order = | Less | Greater | Same\n",
    b"type Tree<p, a> = | Leaf | Node(Int, Int, p, Int, a, Tree<p, a>, Tree<p, a>)\n",
    b"fn shifted<p, a>(tree: Tree<p, a>, by: Int) -> Tree<p, a> = match tree { Leaf -> Leaf, Node(rank, shift, priority, seq, value, left, right) -> Node(rank, shift + by, priority, seq, value, left, right) }\n",
    b"fn made<p, a>(priority: p, seq: Int, value: a, left: Tree<p, a>, right: Tree<p, a>) -> Tree<p, a> = match left { Leaf -> Node(1, 0, priority, seq, value, right, Leaf), Node(l, _, _, _, _, _, _) -> match right { Leaf -> Node(1, 0, priority, seq, value, left, Leaf), Node(r, _, _, _, _, _, _) -> if l >= r { Node(r + 1, 0, priority, seq, value, left, right) } else { Node(l + 1, 0, priority, seq, value, right, left) } } }\n",
    b"fn joined<p, a>(order: (p, p) -> Order, x: Tree<p, a>, dx: Int, y: Tree<p, a>, dy: Int) -> Tree<p, a> = match x { Leaf -> if dy == 0 { y } else { shifted(y, dy) }, Node(_, sx, px, qx, vx, lx, rx) -> match y { Leaf -> if dx == 0 { x } else { shifted(x, dx) }, Node(_, sy, py, qy, vy, ly, ry) -> { let cx = dx + sx; let cy = dy + sy; if match order(px, py) { Less -> true, Greater -> false, Same -> qx + cx < qy + cy } { made(px, qx + cx, vx, if cx == 0 { lx } else { shifted(lx, cx) }, joined(order, rx, cx, y, dy)) } else { made(py, qy + cy, vy, if cy == 0 { ly } else { shifted(ly, cy) }, joined(order, x, dx, ry, cy)) } } } }\n",
  ]);
  let ats = [[b"Int", b"Int"], [b"String", b"Int"]].fold(
    [],
    |acc: List<RootKey>, args: List<Bytes>|
      acc.push(at_spelled(b"m.shifted", args)).push(at_spelled(b"m.joined", args)),
  );
  let answers = answers_at(
    [b"m"],
    [src],
    [b"m.Leaf", b"m.Node", b"m.Less", b"m.Greater", b"m.Same"],
    ats.push(Named(b"m.shifted")).push(Named(b"m.joined")),
  );
  assert_eq(
    answers.fold([], |acc: List<Bytes>, a: RootAnswer|
      match a.answer {
        Refused(r) -> acc.push(Bytes::concat_all([answer_name(a), b": ", r.why])),
        Body(_) -> acc,
      }),
    [],
  )
}

test "a call that knows both variables of a record its callee takes and answers carries both, and the record crosses as its fields" {
  let src = Bytes::concat_all([
    b"fn top<k, v>(es: List<{ key: k, value: v }>, d: { key: k, value: v }) -> { key: k, value: v } =\n",
    b"  match es.at(0) { Some(e) -> e, None -> d }\n",
    b"fn used(es: List<{ key: Int, value: Int }>) -> Int = top(es, { key: 0, value: 0 }).value\n",
  ]);
  let at = at_spelled(b"m.top", [b"Int", b"Int"]);
  let laid = printed(at);
  let answers = answers_at([b"m"], [src], [], [Named(b"m.used"), at]);
  let body = |name: Bytes|
    match answers.find(|a: RootAnswer| answer_name(a) == name) {
      Some(a) -> match a.answer {
        Body(b) -> b,
        Refused(r) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", r.why]))),
      },
      None -> panic(String::of_bytes_lossy(b"no answer for ".concat(name))),
    };
  assert_eq(body(b"m.used").tables.generics.calls.map(|g: GenericCall| g.carried), [[0, 1]]);
  let written = body(b"m.used").tables.generics.expects.map(|e: Expect| e.head);
  assert_eq(written, body(laid).tables.symbols.map(|d: Defined| d.head));
  // Neither the record handed in nor the one answered is boxed to cross.
  assert(written.all(|h: Head| h.params.len() > 2 && h.answer != b"Word"), Some(f"{written}"))
}

test "an operator the checker filed at a definition's variable is done at the type it is at" {
  let src = b"fn same<a>(x: a, y: a) -> Bool = x == y\nfn floats(x: Float, y: Float) -> Bool = same(x, y)\n";
  let answers = answers_at([b"m"], [src], [], [
    Named(b"m.same"),
    Named(b"m.floats"),
    at_spelled(b"m.same", [b"Float"]),
  ]);
  let texts = answers.map(|a: RootAnswer|
    match a.answer { Body(b) -> b.text, Refused(r) -> r.why });
  assert_eq(answers.map(answer_name), [b"m.same@Float", b"m.same", b"m.floats"]);
  // A `Float` the specialisation holds is compared by C; the generic body, whose comparison reads
  // its variable's type, is settled by its callers and has no C of its own.
  assert_eq(texts.map(|t: Bytes| t.index_of(b"rt_equal_p") != None), [false, false, false]);
  assert_eq(texts.get(1), b"");
  // The generic body notes the variable whose type its comparison reads.
  let same = match answers.at(1) {
    Some(a) -> match a.answer { Body(b) -> b.tables.generics.needs, Refused(_) -> [] },
    None -> [],
  };
  assert_eq(same, [{ var: 0, reads: Exact }])
}

// A body names each constructor it builds or tests by name, so it reads the same whatever else the
// program's constructor table holds.
test "a body reads the same whatever else the program's constructor table holds" {
  let m = b"pub type Shape = | Dot | Line(Int)\nfn f(s: Shape) -> Int = match s { Dot -> 0, Line(n) -> n }\nfn g() -> Shape = Line(1)\n";
  let wanted = [Named(b"m.f"), Named(b"m.g")];
  let alone = answers_at([b"m"], [m], [b"m.Dot", b"m.Line"], wanted);
  let beside = answers_at([b"m"], [m], [b"a.One", b"a.Two", b"m.Dot", b"m.Line"], wanted);
  assert_eq(alone, beside);
  assert(alone.len() == 2)
}

test "a module no wanted root is in, read as its stub under its rows, lowers what its text does" {
  let a = b"import b\nfn f(x: Int) -> Int = b::g(x) + 1\n";
  let b = b"pub fn g(x: Int) -> Int = x * 2\ntest \"doubles\" { assert(g(1) == 2) }\n";
  let parsed = parse_all([{ name: b"a", src: a }, { name: b"b", src: b }]);
  let d = dump_of(analyse(parsed));
  let stub = stub_module(b, parsed.get(1).module);
  assert(stub.index_of(b"x * 2") == None);
  let call = |srcs: List<Bytes>|
    emit_roots_answer(
      [b"a", b"b"],
      srcs,
      no_ctors(),
      [],
      [Named(b"a.f")],
      [],
      [],
      [],
      d.rows,
      d.walked,
    );
  assert_eq(call([a, stub]), call([a, b]))
}

/// A record update, a call that passes a witness, and operators at two types: every kind of site a
/// body's row files. `above` is written over `moved`, which moves it without touching its text.
fn sited(above: Bytes) -> List<Source> = sited_as(above, b"{ ..p, x: b::twice(p.x) + 1 }")

fn sited_as(above: Bytes, body: Bytes) -> List<Source> =
  [
    {
      name: b"a",
      src: Bytes::concat_all([
        b"import b\ntype P = { x: Int, y: Int }\n",
        above,
        b"fn moved(p: P) -> P = ",
        body,
        b"\ntest \"moves\" { assert(moved({ x: 1, y: 2 }).x == 3) }\n",
      ]),
    },
    { name: b"b", src: b"pub fn twice<a>(x: a) -> a\n  where numeric(a)\n= x + x\n" },
  ]

fn sited_answers(sources: List<Source>, d: Dump) -> List<RootAnswer> / {abort.raise} =
  emit_roots_answer(
    sources.map(|s: Source| s.name),
    sources.map(|s: Source| s.src),
    loaded_ctors(d, []),
    loaded_natives(sources, []),
    [Named(b"a.moved"), test_key(b"a", b"moves"), Named(b"b.twice")],
    [],
    [],
    [],
    d.rows,
    d.walked,
  )

test "a body is lowered from what its row files of it, walked now or published from the row" {
  let walked = dump_of(analyse(parse_all(sited(b""))));
  let filed = walked.rows.defs.fold(b"", |acc: Bytes, row: KnownDefRow|
    if row.name == b"a.moved" { row.facts } else { acc });
  match facts_at(filed, 0, b"a.moved") {
    None -> panic("the row files what the walk read"),
    Some(f) -> {
      assert_eq(f.updates.len(), 1);
      assert(f.refs.len() > 0);
      assert(f.typed.len() > 0)
    },
  };
  let seeded = analyse_with(parse_all(sited(b"")), walked.rows);
  match seeded {
    seam::Refused(_) -> panic("the program checks"),
    // Beside the two it writes, what the code written for its comparison reaches.
    seam::Analysed(w) -> assert_eq(front::not_written(w.checked.seeded), [b"b.twice", b"a.moved"]),
  };
  assert_eq(sited_answers(sited(b""), dump_of(seeded)), sited_answers(sited(b""), walked))
}

fn seeded_with(sources: List<Source>, rows: Rows) -> seam::AnalysisOutcome / {abort.raise} =
  analyse_pulling_std_with(sources, [], rows).out

test "a body published from its row is lowered where its definition moved to" {
  let before = dump_of(seeded_with(sited(b""), no_rows()));
  let after = sited(b"// a comment, and a definition, above it\nfn aside() -> Int = 7\n");
  let seeded = seeded_with(after, before.rows);
  match seeded {
    seam::Refused(_) -> panic("the program checks"),
    // What the code written to compare a container calls is reached where `sited` compares.
    seam::Analysed(w) -> {
      assert_eq(front::not_written(w.checked.seeded), [b"b.twice", b"a.moved"]);
      assert_eq(
        w.checked.seeded.filter(|n: Bytes| front::written_reach().contains(n)),
        front::written_reach(),
      )
    },
  };
  assert_eq(
    sited_answers(after, dump_of(seeded)),
    sited_answers(after, dump_of(seeded_with(after, no_rows()))),
  )
}

test "a body's row files the same sites wherever its definition stands" {
  let facts_of = |sources: List<Source>| {
    let d = dump_of(seeded_with(sources, no_rows()));
    d.rows.defs.fold(b"", |acc: Bytes, row: KnownDefRow|
      if row.name == b"a.moved" { row.facts } else { acc })
  };
  let here = facts_of(sited(b""));
  assert(here.len() > 1);
  assert_eq(
    facts_of(sited(b"// a comment, and a definition, above it\nfn aside() -> Int = 7\n")),
    here,
  )
}

test "a module's roots are lowered only from an answer that holds what its check read" {
  let sources = sited(b"");
  let d = dump_of(analyse(parse_all(sources)));
  let unread = { ..d, rows: { ..d.rows, defs: [] } };
  match sited_answers(sources, unread).get(0).answer {
    Body(_) -> panic("a body with no row is not lowered from a guess"),
    Refused(r) -> assert(r.why.index_of(b"nothing its check read") != None),
  };
  match sited_answers(sources, { ..d, walked: b"" }).get(0).answer {
    Body(_) -> panic("an answer with nothing read lowers nothing"),
    Refused(_) -> (),
  }
}

test "a wanted body is lowered though the answer holds nothing of a test beside it" {
  let sources = sited(b"");
  let d = dump_of(analyse(parse_all(sources)));
  // A module the front end read through its stub: its tests were never in the answer.
  let call = |wanted: List<RootKey>|
    emit_roots_answer(
      sources.map(|s: Source| s.name),
      sources.map(|s: Source| s.src),
      no_ctors(),
      [],
      wanted,
      [],
      [],
      [],
      { ..d.rows, tests: [] },
      d.walked,
    ).get(
      0,
    ).answer;
  match call([Named(b"a.moved")]) {
    Body(_) -> (),
    Refused(r) -> panic(String::of_bytes_lossy(r.why)),
  };
  match call([test_key(b"a", b"moves")]) {
    Body(_) -> panic("a test the answer holds nothing of is not lowered from a guess"),
    Refused(_) -> (),
  }
}

test "a buffer read out of a record this body holds alone reaches its append unshared" {
  let src = Bytes::concat_all([
    b"type S = { out: Bytes, n: Int }\n",
    b"type W = { out: Bytes, n: Int, a: Int, b: Int }\n",
    b"type T = | T(Bytes, Int)\n",
    b"fn pattern(s: S, fuel: Int) -> Bytes = { let { out, n } = s; if n <= 0 || fuel <= 0 { out } else { pattern({ out: out ++ b\"x\", n: n - 1 }, fuel - 1) } }\n",
    b"fn ctor(t: T, fuel: Int) -> Bytes = match t { T(out, n) -> if n <= 0 || fuel <= 0 { out } else { ctor(T(out ++ b\"x\", n - 1), fuel - 1) } }\n",
    b"fn update(s: S, fuel: Int) -> Bytes = if s.n <= 0 || fuel <= 0 { s.out } else { update({ ..s, out: s.out ++ b\"x\", n: s.n - 1 }, fuel - 1) }\n",
    b"fn fields(s: S, fuel: Int) -> Bytes = { let n = s.n; let out = s.out; if n <= 0 || fuel <= 0 { out } else { fields({ out: out ++ b\"x\", n: n - 1 }, fuel - 1) } }\n",
    b"fn iterated(n: Int) -> Bytes / {abort.raise} = iterate({ out: b\"\", n: n }, n + 1, |s: S| if s.n <= 0 { Stop(s.out) } else { Continue({ out: s.out ++ b\"x\", n: s.n - 1 }) })\n",
    b"fn folded(n: Int) -> Bytes = range(0, n).fold({ out: b\"\", n: 0 }, |s: S, _: Int| { out: s.out ++ b\"x\", n: s.n + 1 }).out\n",
    b"fn widened(n: Int) -> Bytes / {abort.raise} = iterate({ out: b\"\", n: n, a: 0, b: 0 }, n + 1, |s: W| if s.n <= 0 { Stop(s.out) } else { Continue({ out: s.out ++ b\"x\", n: s.n - 1, a: s.a, b: s.b }) })\n",
    b"fn guarded(t: T, k: Int) -> Bytes = match t { T(out, n) if n > k -> out ++ b\"y\", T(out, _) -> out }\n",
  ]);
  // `fold` runs each lambda in the loop of `std.prelude` the unit settles its call on.
  let keyed = [
    b"m.pattern",
    b"m.ctor",
    b"m.update",
    b"m.fields",
    b"m.iterated",
    b"m.widened",
    b"m.guarded",
  ].map(
    Named,
  ).push(
    prelude_loop(b"folded_from", b"m.folded", 5, [b"Int", b"{n:Int,out:Bytes}"]),
  );
  let names = keyed.map(printed);
  let answers = answers_at([b"m"], [src], [b"Stop", b"Continue", b"m.T"], keyed);
  let code = |name: Bytes| own_code(answered_body(answers, name).text);
  // A record, a loop's state as wide as the registers and a sum of one case are held as their fields, so the
  // buffer is a field's own word: no count is taken of it before the append, and no record is made
  // or reset for it, however the body holds the value it reads it out of.
  assert_eq(
    names.filter(|n: Bytes| {
      let body = code(n);
      match body.index_of(b"rt_concat_p(") {
        Some(c) -> takes_count(body.slice(0, c)) || body.index_of(b"rt_alloc") != None,
        None -> true,
      }
    }),
    [],
  )
}

// Inside a box of its own recursion group a sum is laid as its words alone; opened, it is held as its
// type lays it, so letting it go reads its cases.
test "a sum whose cases lay its words apart is let go of by its cases wherever it is held, inside a box of its own among them" {
  let src = Bytes::concat_all([
    b"type Place = { param: Int, path: List<Bytes> }\n",
    b"type Base = | PlaceBase(Place) | QuotientBase({ of: Base, by: Int }) | RemainderBase({ by: Base })\n",
    b"type Linear = { base: Option<Base>, k: Int }\n",
    b"type Term = | Exactly(Linear) | Below(Place) | RecordTerm({ base: Option<Term>, fields: List<Term> }) | NoParts | Wrapped(Term) | UnknownTerm\n",
    b"type Summary = { names: List<Bytes>, result: Term }\n",
    b"effect ask {\n  write op(n: Int) -> Int\n}\n",
    b"fn base_of(t: Term) -> Option<Term> = match t { RecordTerm(r) -> r.base, Wrapped(w) -> Some(w), _ -> None }\n",
    b"fn deep(t: Term) -> Int = match base_of(t) { Some(b) -> match base_of(b) { Some(_) -> 2, None -> 1 }, None -> 0 }\n",
    b"fn rebuilt(t: Term) -> Term = match t { RecordTerm(r) -> RecordTerm({ base: r.base, fields: r.fields }), _ -> t }\n",
    b"fn summed(t: Term) -> Int = { let s = { names: [b\"a\"], result: rebuilt(t) }; s.names.len() + deep(s.result) }\n",
    b"fn listed(t: Term) -> Int = [t, Wrapped(t)].len()\n",
    b"fn captured(t: Term) -> Int = [1, 2, 3].fold(0, |acc: Int, x: Int| acc + x * deep(t))\n",
    b"fn across(t: Term) -> Int / {ask.op} = { let k = ask.op(1); k + deep(t) }\n",
    b"fn handled(t: Term) -> Int = handle { across(t) } with { ask.op(k) -> k + deep(t) }\n",
    b"fn named(t: Term) -> List<{ name: Bytes, term: Term }> = [{ name: b\"a\", term: t }].push({ name: b\"b\", term: Wrapped(t) })\n",
    b"fn terms(t: Term) -> List<Term> = named(t).map(|f: { name: Bytes, term: Term }| f.term)\n",
    b"fn first_base(ts: List<Term>) -> Option<Term> = ts.fold(None, |acc: Option<Term>, t: Term| match acc { Some(_) -> acc, None -> base_of(t) })\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  // Held in a box of its own, a record's field, a list, a closure's capture, across a perform, in a
  // clause and handed to generic code in a record or an `Option`, each body is lowered, counted,
  // checked and printed.
  assert_eq(out.filter(|e: Emitted| e.why != None).map(emitted_name), []);
  assert_eq(
    [
      b"m.rebuilt",
      b"m.summed",
      b"m.listed",
      b"m.captured",
      b"m.handled",
      b"m.named",
      b"m.terms",
      b"m.first_base",
    ].filter(|n: Bytes| !out.any(|e: Emitted| emitted_name(e) == n)),
    [],
  )
}

// A scalar holds no count, so one read out of an `Option` is answered after the `Option` is let go,
// whatever answered the `Option`: a builtin or a function written in Ply.
test "a scalar read out of an Option holds no count, whatever made the Option" {
  let src = Bytes::concat_all([
    b"fn some_char(c: Char) -> Option<Char> = Some(c)\n",
    b"fn some_int(n: Int) -> Option<Int> = if n > 0 { Some(n) } else { None }\n",
    b"fn some_float(x: Float) -> Option<Float> = Some(x)\n",
    b"fn some_bool(b: Bool) -> Option<Bool> = Some(b)\n",
    b"fn char_of(n: Int) -> Char = match Char::of_int(n) { Some(c) -> c, None -> 'x' }\n",
    b"fn shifted(c: Char, by: Int) -> Char = match Char::of_int(Int::of_char(c) + by) { Some(other) -> other, None -> c }\n",
    b"fn found(h: Bytes) -> Int = match h.index_of(b\"a\") { Some(i) -> i, None -> 0 }\n",
    b"fn parsed(s: String) -> Float = match Float::of_string(s) { Some(x) -> x, None -> 0.0 }\n",
    b"fn char_back(c: Char) -> Char = match some_char(c) { Some(d) -> d, None -> c }\n",
    b"fn int_back(n: Int) -> Int = match some_int(n) { Some(m) -> m, None -> 0 }\n",
    b"fn float_back(x: Float) -> Float = match some_float(x) { Some(y) -> y, None -> x }\n",
    b"fn bool_back(b: Bool) -> Bool = match some_bool(b) { Some(d) -> d, None -> b }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.filter(|e: Emitted| e.why != None).map(emitted_name), []);
  assert_eq(
    [
      b"m.char_of",
      b"m.shifted",
      b"m.found",
      b"m.parsed",
      b"m.char_back",
      b"m.int_back",
      b"m.float_back",
      b"m.bool_back",
    ].filter(|n: Bytes| !out.any(|e: Emitted| emitted_name(e) == n)),
    [],
  );
  // The runtime makes an `Option` only as its encoding, so no word it answers is read as the sum
  // emitted code lays out: a character of an `Int` is made in place.
  let char_of = match out.filter(|e: Emitted| emitted_name(e) == b"m.char_of") {
    [e] -> own_code(e.text),
    _ -> b"",
  };
  assert(
    char_of.index_of(b"rt_builtin_encoded_p(") == None
      && char_of.index_of(b"builtin_char_of_int_p(") == None,
    Some(String::of_bytes_lossy(char_of)),
  )
}

// A value the build knows whole is laid out once as static data: its boxes too, so a run allocates
// nothing to make one, and a body hands its address on holding no count of it.
test "a constant tree is static boxes, its leaves and cases laid as the printer lays them" {
  let src = Bytes::concat_all([
    b"type Tree = | Leaf | Node(Tree, Int, Tree)\n",
    b"type Wide = | Narrow(Int) | Broad(Int, Int, Int, Int, String)\n",
    b"fn small() -> Tree = Node(Node(Leaf, 1, Leaf), 2, Leaf)\n",
    b"fn broad() -> Wide = Broad(1, 2, 3, 4, \"w\")\n",
    b"fn sized(t: Tree) -> Int = match t { Leaf -> 0, Node(l, _, r) -> 1 + sized(l) + sized(r) }\n",
    b"fn walked() -> Int = sized(small())\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.filter(|e: Emitted| e.why != None).map(emitted_name), []);
  let text = |name: Bytes|
    match out.filter(|e: Emitted| emitted_name(e) == name) { [e] -> own_code(e.text), _ -> b"" };
  assert_eq(
    [b"m.small", b"m.broad"].filter(|n: Bytes|
      text(n).index_of(b"rt_alloc") != None || text(n).index_of(b"&ply_k_") == None),
    [],
  );
  // The constant is no count a body takes or lets go of.
  assert_eq([b"m.small", b"m.broad"].filter(|n: Bytes| counts_any(text(n))), [])
}

// A handle holds a count of its answer across its body; a constant the body answers holds none, so the
// handle holds it as it holds any answer, and lets it go as nothing.
test "a handle whose body answers a constant holds it as it holds any answer, whatever its clauses" {
  let src = Bytes::concat_all([
    b"effect amb {\n  write flip() -> Bool\n}\n",
    b"fn branched() -> String = handle { if amb.flip() { \"a\" } else { \"b\" } } with { amb.flip() resume k -> k(true) }\n",
    b"fn returned() -> String = handle { if amb.flip() { \"a\" } else { \"b\" } } with { amb.flip() resume k -> k(true), return v -> v }\n",
    b"fn alone() -> String = handle { \"a\" } with { amb.flip() resume k -> k(true), return v -> v }\n",
    b"fn mixed(s: String) -> String = handle { if amb.flip() { s } else { \"b\" } } with { amb.flip() resume k -> k(true) }\n",
    b"fn counted() -> Int = handle { if amb.flip() { 1 } else { 2 } } with { amb.flip() resume k -> k(true) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.filter(|e: Emitted| e.why != None).map(emitted_name), []);
  assert_eq(
    [b"m.branched", b"m.returned", b"m.alone", b"m.mixed", b"m.counted"].filter(|n: Bytes|
      !out.any(|e: Emitted| emitted_name(e) == n)),
    [],
  )
}

test "a record an arm holds back is joined as its fields however deep it lies, past arms that loop" {
  let src = Bytes::concat_all([
    b"type S = { out: Bytes, n: Int }\n",
    b"fn walk(s: S, fuel: Int) -> S = if fuel <= 0 { s } else if fuel % 2 == 0 { walk({ out: s.out ++ b\"x\", n: s.n + 1 }, fuel - 1) } else { let k = fuel * 3; match k % 4 { 1 -> walk(s, fuel - 1), _ -> s } }\n",
    b"fn hop(s: S, fuel: Int) -> S = if fuel <= 0 { s } else { match fuel % 3 { 0 -> hop({ out: s.out ++ b\"y\", n: s.n }, fuel - 1), _ -> if fuel > 8 { hop(s, fuel - 2) } else if fuel % 2 == 0 { hop(s, fuel - 1) } else { s } } }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None]);
  assert_eq(out.map(|e: Emitted| own_code(e.text).index_of(b"rt_alloc_p(") == None), [true, true])
}

// A count taken again would not be a wrong answer but an object that cannot die.
test "a byte string made for a list is handed to the list with no count taken again" {
  let out = emit_all_program(
    [{ name: b"m", src: b"fn wrap(n: Int) -> List<Bytes> / {abort.raise} = [byte_of_int(n)]\n" }],
    [],
    [b"byte_of_int"],
    true,
  );
  let text = match out { [e, ..] -> e.text, [] -> b"" };
  // The byte is written into a block made for it, the list's item as it is made; past its range,
  // `byte_of_int`'s refusal raises over the number alone.
  assert(
    text.index_of(b"rt_alloc_bytes_p(ctx, ") != None
      && text.index_of(b"builtin_elaborated_refused_p(ctx, INT64_C(12), ") != None
      && text.index_of(b"rt_builtin_encoded_p") == None
      && text.index_of(b"rt_list_room_p") != None,
    Some(String::of_bytes_lossy(text)),
  );
  assert(!takes_count(text), Some(String::of_bytes_lossy(text)))
}

// The prologue unboxes an `Int`, a `Bool` or a fixed width into a local the loop reads instead, so the
// raw word is released once, on the way out, however often the body restarts.
test "a scalar parameter arrives as itself and holds no count for a self tail call to release" {
  let src = Bytes::concat_all([
    b"fn countdown(n: Int, k: Int) -> Int = if k <= 0 { n } else { countdown(n, k - 1) }\n",
    b"fn flip(b: Bool, k: Int) -> Bool = if k <= 0 { b } else { flip(b, k - 1) }\n",
    b"fn narrow(w: U32, k: Int) -> U32 = if k <= 0 { w } else { narrow(w, k - 1) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None]);
  assert_eq(out.map(|e: Emitted| lets_go_of(e.text, b"p0")), [false, false, false])
}

// At the body's tail nothing follows the update, so reading the accumulator twice does not keep it
// from being answered as its fields.
test "an accumulator read more than once is still answered as its fields at the body's tail" {
  let src = Bytes::concat_all([
    b"type S = { i: Int, tag: Bytes }\n",
    b"fn narrow(s: S, x: Int) -> S = { ..s, i: x }\n",
    b"fn wide(s: S, x: Int) -> S = { ..s, i: s.i + x }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None]);
  // The update makes no record: the root answers the fields it sets and keeps.
  let has = |text: Bytes| out.map(|e: Emitted| own_code(e.text).index_of(text) != None);
  [b"rt_alloc_p(", b"rt_alloc_bytes_p("].fold((), |_: Unit, t: Bytes|
    assert_eq(has(t), [false, false]))
}

test "a branch lets go as it opens of a parameter only another branch takes, and of nothing of a record whose field it read" {
  let src = Bytes::concat_all([
    b"type S = { out: Bytes, n: Int }\n",
    b"type W = { out: Bytes, n: Int, a: Int, b: Int, c: Int }\n",
    b"fn whole(s: S) -> Int = s.n\n",
    b"fn wide(w: W) -> Int = w.n\n",
    b"fn slot(x: Bytes, c: Bool) -> Int = if c { Bytes::len(x ++ b\"y\") } else { 0 }\n",
    b"fn field(s: S) -> Int = { let out = s.out; if s.n < 0 { whole(s) } else { Bytes::len(out ++ b\"x\") + s.n } }\n",
    b"fn wide_field(w: W) -> Int = { let out = w.out; if w.n < 0 { wide(w) } else { Bytes::len(out ++ b\"x\") + w.n } }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"Bytes::len"], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None, None]);
  let text = |name: Bytes|
    match out.filter(|e: Emitted| emitted_name(e) == name) { [e, ..] -> e.text, [] -> b"" };
  // The branch that does not take `x` lets it go before anything else it does.
  let slot = text(b"m.slot");
  assert(
    match slot.index_of(b"} else {") {
      Some(a) -> {
        let rest = slot.slice(a, slot.len()).split(b";");
        match rest.at(0) { Some(first) -> lets_go_of(first.concat(b";"), b"p0"), None -> false }
      },
      None -> false,
    },
    Some(String::of_bytes_lossy(slot)),
  );
  // A record that arrives as its fields, by reference past four words or not, is exactly its
  // leaves: the branch that reads only its moved field has nothing of it to let go before its concat.
  let quiet = |name: Bytes| {
    let t = text(name);
    match ((t.index_of(b"} else {"), t.index_of(b"rt_concat_p("))) {
      (Some(a), Some(b)) -> a < b && !lets_count_go(t.slice(a, b)),
      _ -> false,
    }
  };
  assert(quiet(b"m.field"), Some(String::of_bytes_lossy(text(b"m.field"))));
  assert(quiet(b"m.wide_field"), Some(String::of_bytes_lossy(text(b"m.wide_field"))))
}

// A value wider than the registers crosses by reference, where a call lending it and a root given it
// would be written to two heads.
test "a root written for a type is called at the head it is defined at, a record wider than the registers as its box" {
  let src = Bytes::concat_all([
    b"type Place = { param: Int, path: List<Bytes> }\n",
    b"type Base = | PlaceBase(Place) | QuotientBase({ of: Base, by: Int }) | RemainderBase({ by: Base })\n",
    b"type Linear = { base: Option<Base>, k: Int }\n",
    b"type Term = | Exactly(Linear) | Below(Place) | RecordTerm({ base: Option<Term>, fields: List<Term> }) | NoParts | Wrapped(Term) | UnknownTerm\n",
    b"type Wide = { a: Bytes, b: Int, c: Bytes, d: Int, e: Bytes }\n",
    b"fn same(x: Wide, y: Wide) -> Bool = x == y\n",
    b"fn hashed(x: Wide) -> Bytes = digest(x)\n",
  ]);
  let term = TyCon({ name: b"m.Term", args: [] });
  // A declared record is keyed by its fields, as its calls key it.
  let wide = TyRecord([
    { name: b"a", ty: bytes_type() },
    { name: b"b", ty: int_type() },
    { name: b"c", ty: bytes_type() },
    { name: b"d", ty: int_type() },
    { name: b"e", ty: bytes_type() },
  ]);
  let boxed = TyRecord([
    { name: b"base", ty: TyCon({ name: b"Option", args: [term] }) },
    { name: b"fields", ty: TyCon({ name: b"List", args: [term] }) },
  ]);
  let written = [in_m(keys::Lower, term), in_m(keys::Lower, boxed), in_m(Digest, wide)];
  let answers = answers_at(
    [b"m"],
    [src],
    [b"Some", b"None"],
    written.concat([b"m.same", b"m.hashed"].map(Named)),
  );
  let tables = answers.map(|a: RootAnswer|
    match a.answer {
      Body(b) -> { name: answer_name(a), tables: b.tables },
      Refused(r) ->
        panic(String::of_bytes_lossy(Bytes::concat_all([answer_name(a), b": ", r.why]))),
    });
  let defined = tables.fold(
    Map::new(),
    |m: Map<Bytes, { answer: Bytes, params: List<Bytes> }>, t: { name: Bytes, tables: Tables }|
      t.tables.symbols.fold(
        m,
        |n: Map<Bytes, { answer: Bytes, params: List<Bytes> }>, d: Defined|
          n.insert(d.symbol, d.head),
      ),
  );
  let head = |k: RootKey| defined.get(symbol_of(printed(k)));
  assert_eq(written.filter(|k: RootKey| head(k) == None).map(root_name), []);
  // `hashed` calls the very digest root asked for, so its head is held to that root's below.
  let called = tables.fold([], |acc: List<Bytes>, t: { name: Bytes, tables: Tables }|
    if t.name != b"m.hashed" { acc }
    else { acc.concat(expects_named(t.tables).map(|e: CallHead| e.callee)) });
  assert(called.contains(printed(in_m(Digest, wide))), None);
  // The boxed case's record, wider than the registers, is its box: it crosses as that one word.
  assert(
    match head(in_m(keys::Lower, boxed)) {
      Some(h) ->
        h.params.any(|p: Bytes| p == b"Word") && !h.params.any(|p: Bytes| p.ends_with(b"Word*")),
      None -> false,
    },
    None,
  );
  assert_eq(
    tables.fold([], |acc: List<Bytes>, t: { name: Bytes, tables: Tables }|
      expects_named(t.tables).fold(acc, |x: List<Bytes>, e: CallHead|
        match defined.get(symbol_of(e.callee)) {
          Some(h) -> if h == e.head { x }
          else { x.push(Bytes::concat_all([t.name, b" -> ", e.callee])) },
          None -> x,
        })),
    [],
  )
}

/// The constructor table a load hands the emitter for the program `d` was read from: every
/// constructor it declares, the prelude's among them, those `named` first.
fn loaded_ctors(d: Dump, named: List<Bytes>) -> Ctors =
  ctors_of(
    named.concat(d.ctors.map(|c: CtorRow| c.name).filter(|n: Bytes| !named.contains(n))),
    d.emitter_ctors.filter(|c: EmitterCtor| c.key != None).map(|c: EmitterCtor| c.name),
    d.emitter_ctors.filter(|c: EmitterCtor| c.numeric.len() > 0).map(|c: EmitterCtor| c.name),
    ctor_sums(d.ctors),
  )

/// The natives a runtime implements for a program of `sources`, as a load hands the emitter them,
/// those `named` first.
fn loaded_natives(sources: List<Source>, named: List<Bytes>) -> List<Bytes> / {abort.raise} =
  named.concat(
    program_natives(sources.map(|m: Source| { name: m.name, text: m.src })).map(
      |e: Extern| e.name,
    ).filter(|n: Bytes| !named.contains(n)),
  )

fn emit_all_program(
  sources: List<Source>,
  ctors: List<Bytes>,
  builtins: List<Bytes>,
  release: Bool,
) -> List<Emitted> / {abort.raise} =
  match analyse(parse_all(sources)) {
    // Refused whole, each module stands for the roots it would have offered.
    seam::Refused(diags) ->
      refused_rather_than_emitted(sources.map(|m: Source| Named(m.name)), said(diags)).map(
        |r: RootForm| emitted_of(r, no_ctors()),
      ),
    seam::Analysed(w) -> {
      let d = dump_of(seam::Analysed(w));
      emit_program(
        sources,
        loaded_ctors(d, ctors),
        loaded_natives(sources, builtins),
        release,
        // The program's own roots; a prelude function is lowered where one of them calls it.
        offered_roots(d).keys.filter(|k: RootKey| module_of(k) != prelude_module()),
        [],
        [],
        d.embeds,
        d.rows,
        d.walked,
      )
    },
  }

test "a module imported whole under a builtin's name leaves a bare call the builtin's" {
  let emitted = emit_all_program(
    [
      { name: b"min", src: b"pub fn size(xs: List<Int>) -> Int = xs.len()\n" },
      {
        name: b"b",
        src: b"import min\nfn least(x: Int) -> Int = min(x, 1)\nfn n(xs: List<Int>) -> Int = min::size(xs)\n",
      },
    ],
    [],
    [b"min", b"List::len"],
    true,
  );
  assert_eq(emitted.map(|e: Emitted| e.why), [None, None, None]);
  let calls = |full: Bytes| emitted.map(|e: Emitted| e.text.index_of(symbol_of(full)) != None);
  assert_eq(calls(b"min.min"), [false, false, false]);
  assert_eq(calls(b"min.size"), [true, false, true])
}

test "a builtin is called through the helper named for it, and an import that takes its name is called instead" {
  let own = emit_all_program(
    [
      {
        name: b"m",
        src: b"fn power(x: Float) -> Float = x.pow(2.0)\nfn angle(y: Float, x: Float) -> Float = y.atan2(x)\n",
      },
    ],
    [],
    [b"Float::pow", b"Float::atan2"],
    true,
  );
  assert_eq(own.map(|e: Emitted| e.why), [None, None]);
  let has = |text: Bytes| own.map(|e: Emitted| e.text.index_of(text) != None);
  assert_eq(has(b"builtin_float_pow_p(ctx, "), [true, false]);
  assert_eq(has(b"builtin_float_atan2_p(ctx, "), [false, true]);
  assert_eq(builtin_helper(b"?numeric_binary"), b"builtin_elaborated_numeric_binary");
  assert_eq(builtin_helper(b"range"), b"builtin_range");
  let imported = emit_all_program(
    [
      { name: b"a", src: b"pub fn min(x: Int, y: Int) -> Int = x\n" },
      { name: b"b", src: b"import a (min)\nfn least(x: Int) -> Int = min(x, 1)\n" },
    ],
    [],
    [b"min"],
    true,
  );
  assert_eq(imported.map(|e: Emitted| e.why), [None, None]);
  assert_eq(imported.map(|e: Emitted| e.text.index_of(b"builtin_min_p") != None), [false, false])
}

// A value is compared and shown wherever it is read, by the runtime and not by a call a body
// makes: the body that names its constructor is what answers for the functions being there.
test "a body that names a constructor calls no root for it, whatever key or show its type states" {
  let rest = b"fn area(b: Box) -> Int = match b { Box(w, h) -> w * h }\nfn text(b: Box) -> String = \"box\"\nfn make() -> Box = Box(1, 2)\nfn same<a>(x: a, y: a) -> Bool = x == y\n";
  let plain = b"pub type Box = | Box(Int, Int)\n".concat(rest);
  let stating = b"pub type Box = | Box(Int, Int)\nkey for Box by area\nshow for Box by text\n".concat(
    rest,
  );
  let wanted = [b"m.area", b"m.text", b"m.make", b"m.same"].map(Named);
  let calls = |src: Bytes|
    answers_at([b"m"], [src], [b"m.Box"], wanted).map(|a: RootAnswer|
      {
        name: answer_name(a),
        calls: match a.answer {
          Body(b) -> b.tables.calls.map(printed),
          Refused(_) -> [b"refused"],
        },
      });
  // A constructor is its case laid in its sum's words, so no runtime table of it names the key or
  // the show its type states.
  [stating, plain].fold((), |_: Unit, src: Bytes|
    assert_eq(calls(src).map(|c: { name: Bytes, calls: List<Bytes> }| c.calls), [[], [], [], []]))
}

// --- Lending -----------------------------------------------------------------------------------

fn lending_corpus() -> Bytes =
  Bytes::concat_all([
    b"type T = | Leaf | Node(T, Int, T)\n",
    b"fn weight(t: T) -> Int = match t { Leaf -> 0, Node(_, n, _) -> n }\n",
    b"fn twice(t: T) -> Int = weight(t) + weight(t)\n",
    b"fn grown(t: T) -> T = Node(t, 1, Leaf)\n",
    b"fn both(t: T) -> T = if weight(t) > 0 { grown(t) } else { t }\n",
  ])

fn handed(def: Bytes, lent: List<Bool>) -> Published =
  { def: root_name(Named(def)), lent: lent, borrowed: None }

test "a payload read out of a value gathered of constants holds no count, beside arms whose answers do" {
  // `display` matches a `VInt` it made of no count: its `VStr` arm hands back a payload of nothing
  // counted, its other arm what `render`, lent the value, makes.
  let src = Bytes::concat_all([
    b"type V = | VInt(Int) | VStr(String)\n",
    b"fn render(v: V) -> String = match v { VInt(n) -> n.to_string(), VStr(s) -> s.len().to_string() }\n",
    b"fn display(x: Int) -> String = match VInt(x) { VStr(s) -> s, v -> render(v) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", src: src }], [], [b"Int::to_string"], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None]);
  assert_eq(out.map(|e: Emitted| e.tables.handings.map(|h: Published| h.lent)), [
    [[true]],
    [[true]],
  ])
}

test "a specialisation reads what it is lent as its definition reads it, and answers as it does" {
  // At `Int` the record and the result arrive as words read in place as their boxes' words, where
  // the definition read them off the word. A field of a record laid at no type is looked up by
  // name, which answers it owned; a sum's payload is read out of the sum.
  let src = Bytes::concat_all([
    b"type Named<a> = { data: a, name: String }\n",
    b"fn name_of<a>(x: Named<a>) -> String = x.name\n",
    b"fn use_it(x: Named<Int>) -> String = name_of(x)\n",
    b"fn err_or<a>(r: Result<a, String>, d: String) -> String = match r { Err(e) -> e, Ok(_) -> d }\n",
    b"fn either(r: Result<Int, String>) -> String = err_or(r, \"none\")\n",
  ]);
  let keyed = [b"m.name_of", b"m.err_or", b"m.use_it", b"m.either"].map(Named).concat([
    at_spelled(b"m.name_of", [b"Int"]),
    at_spelled(b"m.err_or", [b"Int"]),
  ]);
  let wanted = keyed.map(printed);
  let answers = answers_at([b"m"], [src], [b"Ok", b"Err"], keyed);
  let refused = answers.fold([], |acc: List<Bytes>, a: RootAnswer|
    match a.answer {
      Body(_) -> acc,
      Refused(r) -> acc.push(Bytes::concat_all([answer_name(a), b": ", r.why])),
    });
  assert(refused.len() == 0, Some(String::of_bytes_lossy(Bytes::join(refused, b"\n"))));
  assert_eq(answers.map(answer_name).sort(), wanted.sort());
  let borrowed = |name: Bytes|
    answers.fold([], |acc: List<Published>, a: RootAnswer|
      if answer_name(a) != name { acc }
      else { match a.answer { Body(b) -> acc.concat(b.tables.handings), Refused(_) -> acc } });
  assert_eq(borrowed(b"m.name_of"), [handed(b"m.name_of", [true])]);
  assert_eq(borrowed(b"m.err_or"), [
    {
      def: root_name(Named(b"m.err_or")),
      lent: [true, true],
      borrowed: Some([{ param: 0, whole: false }, { param: 1, whole: true }]),
    },
  ])
}

test "a parameter a body only reads is lent: neither it nor a caller counts it for the call" {
  let out = emit_all_program([{ name: b"m", src: lending_corpus() }], [], [], true);
  assert_eq(out.map(|e: Emitted| e.why), [None, None, None, None]);
  let code = out.map(|e: Emitted| own_code(e.text));
  // Given, `weight` would let go of its tree and `twice` count it once more for the first call.
  // `both` takes its tree, lends it to `weight` with no count taken, and lets it go only where that
  // call fails.
  assert_eq(code.map(counts_any), [false, false, false, true]);
  assert_eq(code.map(takes_count), [false, false, false, false]);
  assert_eq(out.map(|e: Emitted| e.tables.handings), [
    [handed(b"m.weight", [true])],
    [handed(b"m.twice", [true])],
    [handed(b"m.grown", [false])],
    [handed(b"m.both", [false])],
  ]);
  assert_eq(out.map(|e: Emitted| e.tables.assumed), [
    [],
    [handed(b"m.weight", [true])],
    [],
    [handed(b"m.weight", [true]), handed(b"m.grown", [false])],
  ])
}

test "a body is written against the handing another answer publishes for its callee, and says it assumed it" {
  let twice = |published: List<Published>|
    match answers_at([b"m"], [lending_corpus()], [], [Named(b"m.twice")], [], published) {
      [a] -> match a.answer {
        Body(b) ->
          Some({
            counted: takes_count(own_code(b.text)),
            assumed: b.tables.assumed,
            handings: b.tables.handings,
          }),
        Refused(_) -> None,
      },
      _ -> None,
    };
  // A callee no answer publishes takes all it is handed, so its caller counts the tree it hands on
  // twice, and is given it.
  assert_eq(
    twice([]),
    Some({
      counted: true,
      assumed: [handed(b"m.weight", [false])],
      handings: [handed(b"m.twice", [false])],
    }),
  );
  assert_eq(
    twice([handed(b"m.weight", [true])]),
    Some({
      counted: false,
      assumed: [handed(b"m.weight", [true])],
      handings: [handed(b"m.twice", [true])],
    }),
  )
}
