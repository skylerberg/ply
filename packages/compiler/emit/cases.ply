fn emitted_name(e: EmittedRoot) -> Bytes = root_text(e.name)

fn output_name(a: RootOutput) -> Bytes = root_text(a.name)

test "a definition generic over effects is resolved by its callers and emitted once for each set of effects its callers use" {
  let source = Bytes::concat_all([
    b"effect log {\n  write note(n: Int) -> Unit\n}\n",
    b"fn apply<|e>(f: () -> Int / e) -> Int / e = f()\n",
    b"fn logged(f: () -> Int / {log.note}) -> Int / {log.note} = apply(f)\n",
    b"fn plain(f: () -> Int) -> Int = apply(f)\n",
    b"fn twice<|e>(f: () -> Int / e) -> Int / e = apply(f) + apply(f)\n",
  ]);
  let log = [{ effect: b"m.log", resource: SingletonResource }];
  let at_log = keys::specialisation_key_with_effects(b"m.apply", [], [], [log]);
  let at_none = keys::specialisation_key_with_effects(b"m.apply", [], [], [[]]);
  let twice_log = keys::specialisation_key_with_effects(b"m.twice", [], [], [log]);
  let results = outputs_at([b"m"], [source], [], [
    Named(b"m.apply"),
    Named(b"m.logged"),
    Named(b"m.plain"),
    at_log,
    at_none,
    twice_log,
  ]);
  let body = |k: RootKey| output_body(results, printed(k));
  assert_eq(body(Named(b"m.apply")).text, b"");
  assert_eq(printed(at_log), b"m.apply@/{m.log}");
  assert_eq(
    body(Named(b"m.logged")).tables.generics.calls.map(|g: GenericCall| g.effect_evidence),
    [[log]],
  );
  assert_eq(
    body(Named(b"m.plain")).tables.generics.calls.map(|g: GenericCall| g.effect_evidence),
    [[[]]],
  );
  assert_eq(body(twice_log).tables.generics.calls.map(|g: GenericCall| g.effect_evidence), [
    [log],
    [log],
  ]);
  assert([at_log, at_none, twice_log].all(|k: RootKey| body(k).text.len() > 0), None)
}

test "a `handle` in a definition generic over effects forwards the operations it does not handle to the effects the caller supplied for the effect variable" {
  let source = Bytes::concat_all([
    b"effect d {\n  write begin() -> Int\n  write rollback(reason: String) -> Unit\n}\n",
    b"fn attempt<|e>(body: () -> Int / {d.rollback | e}) -> Int / e =\n",
    b"  handle { body() } with { d.rollback(r) resume k -> 0 }\n",
    b"fn nested() -> Int / {d.begin} = attempt(|| attempt(|| d.begin()))\n",
  ]);
  let at_d = keys::specialisation_key_with_effects(b"m.attempt", [], [], [
    [{ effect: b"m.d", resource: SingletonResource }],
  ]);
  let results = outputs_at([b"m"], [source], [], [Named(b"m.nested"), at_d]);
  let text = output_body(results, printed(at_d)).text;
  assert(
    text.len() > 0 && text.index_of(b"ctx->bridge") == None,
    Some(String::of_bytes_lossy(text)),
  )
}

test "a body that would overrun this thread's stack makes room on the stack it runs on" {
  let source = b"fn g(n: Int) -> Int = if n <= 0 { 0 } else { 1 + g(n - 1) }\n";
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let text = match out.at(0) { Some(e) -> e.text, None -> b"" };
  assert(
    text.index_of(probed_fn.concat(b"(ctx)")) != None
      && probed_helper.index_of(b"rt_stack_more_p(ctx)") != None,
    Some(String::of_bytes_lossy(text)),
  )
}

test "a self call in tail position restarts the body instead of nesting" {
  let source = Bytes::concat_all([
    b"fn count(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { count(n - 1, acc + n) }\n",
    b"fn upto(xs: List<Int>, i: Int, acc: Int) -> Int = match i >= xs.len() { true -> acc, false -> upto(xs, i + 1, acc + 1) }\n",
    b"fn all_below(xs: List<Int>, bound: Int, i: Int) -> Bool = i >= xs.len() || (i < bound && all_below(xs, bound, i + 1))\n",
    b"fn any_at_least(xs: List<Int>, bound: Int, i: Int) -> Bool = i < xs.len() && ((match xs.at(i) { Some(x) -> x >= bound, None -> false }) || any_at_least(xs, bound, i + 1))\n",
    b"fn last(xs: List<Int>, i: Int, seen: Option<Int>) -> Option<Int> = match xs.at(i) { None -> seen, Some(x) -> last(xs, i + 1, Some(x)) }\n",
    b"fn collect(n: Int, acc: List<Int>) -> List<Int> = { let next = acc.push(n); if n <= 0 { next } else { collect(n - 1, next) } }\n",
    b"fn digit_sum(xs: List<Int>, i: Int, acc: Int) -> Result<Int, String> = if i >= xs.len() { Ok(acc) } else { let d = (match xs.at(i) { Some(d) -> Ok(d), None -> Err(\"past the end\") })?; digit_sum(xs, i + 1, acc + d) }\n",
    b"fn countdown(pair: { left: Int, seen: Int }) -> Int = match pair { { left, seen } if left <= 0 -> seen, { left, seen } -> countdown({ left: left - 1, seen: seen + 1 }) }\n",
    b"fn ladder(n: Int) -> Int = if n <= 0 { 0 } else { 1 + ladder(n - 1) }\n",
    b"fn inner(n: Int) -> Int = { let k = if n > 5 { inner(n - 1) } else { 0 }; k + 1 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), 10);
  assert_eq(out.map(|e: EmittedRoot| e.text.index_of(b"goto ply_loop;") != None), [
    true,
    true,
    true,
    true,
    true,
    true,
    true,
    true,
    false,
    false,
  ])
}

test "a self call that takes no arguments restarts the body as well" {
  let source = Bytes::concat_all([
    b"fn spin() -> Int / {clock.read, diverges} = spin()\n",
    b"fn poll() -> Int / {clock.read, diverges} = { clock.now(); poll() }\n",
    b"fn ladder() -> Int / {diverges} = 1 + ladder()\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.map(emitted_name), [b"m.spin", b"m.poll", b"m.ladder"]);
  assert_eq(out.len(), 3);
  assert_eq(out.map(|e: EmittedRoot| e.text.index_of(b"goto ply_loop;") != None), [
    true,
    true,
    false,
  ]);
  let spin = match out.at(0) { Some(e) -> e, None -> panic("no root was emitted") };
  assert_eq(spin.text.index_of(b"which = ") != None, false);
  assert_eq(spin.text.index_of(b"p0 = ") != None, false)
}

test "a tail call into a definition's own recursive group jumps instead of nesting" {
  let source = Bytes::concat_all([
    b"fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n",
    b"fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n",
    b"fn parity(n: Int) -> Bool = even(n)\n",
    b"fn count(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { count(n - 1, acc + n) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.map(emitted_name), [b"m.even", b"m.parity", b"m.count"]);
  assert_eq(out.len(), 3);
  let group = match out.at(0) { Some(e) -> e, None -> panic("no root was emitted") };
  assert_eq(group.tables.members, [Named(b"m.even"), Named(b"m.odd")]);
  let scalars = { result: b"int64_t", params: [b"int64_t"] };
  assert_eq(group.tables.defined.map(|d: DefinitionSymbol| d.head), [scalars, scalars]);
  let grouped = own_symbol(None).concat(b"_group(");
  assert(group.text.index_of(grouped) != None, None);
  assert(group.text.index_of(grouped.concat(b"ctx, 1, ")) != None, None);
  assert(group.text.index_of(b"goto ply_loop;") != None, None);
  assert(group.text.index_of(own_symbol(Some(0)).concat(b"_entry")) == None, None);
  assert(
    [b"m.even", b"m.odd"].all(|n: Bytes| group.text.index_of(symbol_of(n)) == None)
      && group.text.index_of(own_symbol(Some(1)).concat(b"(PlyCtx *ctx")) != None,
    Some(String::of_bytes_lossy(group.text)),
  );
  assert_eq(group.text.index_of(b"PLY_SITE(ctx, @@r@@") != None, false);
  let parity = match out.at(1) { Some(e) -> e, None -> group };
  assert_eq(parity.text.index_of(symbol_of(b"m.even").concat(b"(ctx, ")) != None, true);
  assert_eq(parity.text.index_of(b"ply_loop") != None, false);
  let count = match out.at(2) { Some(e) -> e, None -> group };
  assert_eq(count.text.index_of(b"goto ply_loop;") != None, true);
  assert_eq(count.text.index_of(b"which = ") != None, false);
  assert_eq(count.tables.members, [])
}

test "emitted code refers to each function it defines by a placeholder name, never by its C symbol" {
  let source = Bytes::concat_all([
    b"fn even(n: Int) -> Bool = if n <= 0 { true } else { odd(n - 1) }\n",
    b"fn odd(n: Int) -> Bool = if n <= 0 { false } else { even(n - 1) }\n",
    b"fn ladder(n: Int) -> Int = if n <= 0 { 0 } else { 1 + ladder(n - 1) }\n",
    b"fn walk(n: Int) -> List<Int> = if n <= 0 { [] } else { [n].map(|x: Int| x + walk(n - 1).len()) }\n",
    b"fn ten() -> Int = if odd(3) { ladder(10) } else { 0 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let defines = |e: EmittedRoot|
    if e.tables.members.len() == 0 { [e.name] } else { e.tables.members.map(root_name) };
  assert_eq(
    out.filter(|e: EmittedRoot|
      defines(e).any(|n: RootName| e.text.index_of(symbol_of(root_text(n))) != None)).map(
      emitted_name,
    ),
    [],
  );
  assert_eq(
    out.filter(|e: EmittedRoot| e.text.index_of(own_symbol(None)) == None).map(emitted_name),
    [],
  );
  let walk = match out.find(|e: EmittedRoot| emitted_name(e) == b"m.walk") {
    Some(e) -> e.text,
    None -> b"",
  };
  assert(
    walk.index_of(own_symbol(None).concat(b"(ctx, ")) != None,
    Some(String::of_bytes_lossy(walk)),
  )
}

test "a group of mutually recursive functions whose `handle` clauses only return a value or unwind is emitted as one loop" {
  let source = Bytes::concat_all([
    b"effect stop { raise halt() }\n",
    b"fn a(n: Int) -> Int / {clock.read, diverges} = if n <= 0 { 0 } else if n == 1 { handle { b(0) } with { clock.now() -> clock.now(), } } else { b(n - 1) }\n",
    b"fn b(n: Int) -> Int / {clock.read, diverges} = if n <= 0 { clock.now(); 0 } else { a(n - 1) }\n",
    b"fn p(n: Int) -> Int = if n <= 0 { 0 } else { let _ = try { if n == 3 { stop.halt() } else { n } }; q(n - 1) }\n",
    b"fn q(n: Int) -> Int = if n <= 0 { 0 } else { p(n - 1) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.map(emitted_name), [b"m.a", b"m.p"]);
  assert_eq(out.len(), 2);
  assert_eq(out.map(|e: EmittedRoot| e.tables.members), [
    [Named(b"m.a"), Named(b"m.b")],
    [Named(b"m.p"), Named(b"m.q")],
  ]);
  assert_eq(out.map(|e: EmittedRoot| e.text.index_of(b"goto ply_loop;") != None), [true, true])
}

test "a group of mutually recursive functions is emitted as separate functions when a `handle` resumes its continuation outside tail position or the calls are not tail calls" {
  let source = Bytes::concat_all([
    b"fn a(n: Int) -> Int / {clock.read, diverges} = if n <= 0 { 0 } else if n == 1 { handle { b(0) } with { clock.now() resume k -> k(clock.now()) + 1, } } else { b(n - 1) }\n",
    b"fn b(n: Int) -> Int / {clock.read, diverges} = if n <= 0 { clock.now(); 0 } else { a(n - 1) }\n",
    b"fn c(n: Int) -> Int = if n <= 0 { 0 } else { 1 + d(n - 1) }\n",
    b"fn d(n: Int) -> Int = if n <= 0 { 0 } else { c(n - 1) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.map(emitted_name), [b"m.a", b"m.b", b"m.c", b"m.d"]);
  assert_eq(out.len(), 4);
  assert_eq(out.map(|e: EmittedRoot| e.tables.members.len() == 2), [false, false, false, false]);
  assert_eq(out.map(|e: EmittedRoot| e.text.index_of(b"_group(PlyCtx *ctx, int which") != None), [
    false,
    false,
    false,
    false,
  ])
}

fn handled_body(source: Bytes, release: Bool) -> Bytes / {abort.raise} = {
  let out = emit_all_program([{ name: b"m", source_text: source }], [], release);
  match out.at(0) {
    None -> b"the program produced no C output",
    Some(e) -> match e.text.index_of(b"] = ctx->task;") {
      None -> b"the C output contains no `handle` block",
      Some(pushed) -> match e.text.index_of(b": ;\n") {
        None -> b"the `handle` block has no label to jump to when it fails",
        Some(landed) -> e.text.slice(pushed, landed),
      },
    },
  }
}

test "a body that fails inside a `handle` jumps to the handler's code, whatever the failure was" {
  let source = Bytes::concat_all([
    b"fn f(vs: List<Int>, b: Bytes, xs: Array<Int>, n: Int) -> Int =\n",
    b"  handle {\n",
    b"    let [x, ..] = vs;\n",
    b"    x + Int::of_u8(U8::of_int(n)) + b.at(n) + xs.get(n) + (0 - n) * (n << 3)\n",
    b"  } with { abort.raise(m) -> 0 }\n",
  ]);
  let bodies = [false, true].map(|release: Bool| handled_body(source, release));
  let leaves = |raised: Bytes| bodies.map(|body: Bytes| body.index_of(raised) != None);
  assert_eq(leaves(b"ply_let_no_match(ctx)"), [true, true]);
  assert_eq(leaves(b"goto ply_h"), [true, true]);
  assert_eq(leaves(b"ply_not_that_width(ctx, "), [true, true]);
  assert_eq(leaves(b"ply_refused(ctx, INT64_C(8), "), [true, true]);
  assert_eq(bodies.map(|body: Bytes| body.index_of(b"return")), [None, None])
}

test "a handler clause that matches on the value its continuation returns, outside tail position, is emitted with that value's own type" {
  let source = Bytes::concat_all([
    b"effect ask { read get() -> Int }\n",
    b"fn f(n: Int) -> Result<Int, String> = handle { let y = ask.get(); if y > n { Ok(y) } else { Err(\"low\") } } with { ask.get() resume k -> match k(1) { Ok(v) -> Ok(v + 1), Err(m) -> Err(m) } }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [b"Ok", b"Err"], true);
  assert_eq(out.len(), 1)
}

test "a lambda given to `iterate` that contains a `handle` is emitted as a detached `handle`, capturing only variables of the enclosing function's frame" {
  let source = Bytes::concat_all([
    b"effect ask { read get() -> Int }\n",
    b"fn f(k: Int, n: Int) -> Int / {abort.raise} = iterate(k, n + 1, |s: Int| handle { let y = ask.get(); if s + y >= n { Stop(s) } else { Continue(s + y) } } with { ask.get() resume r -> { let v = r(1); v } })\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [b"Stop", b"Continue"], true);
  assert_eq(out.len(), 1);
  assert_eq(out.map(|e: EmittedRoot| e.text.index_of(b"rt_detached_open_p(") != None), [true])
}

test "every `parallel` block passes its branches to the runtime the same way, wherever the block is written" {
  let source = Bytes::concat_all([
    b"effect meter { read level() -> Int }\n",
    b"fn pure(n: Int) -> (Int, Int) = parallel { n + 1, n + 2 }\n",
    b"fn reads() -> (Int, Int) / {meter.level} = parallel { meter.level(), meter.level() }\n",
    b"fn handled() -> (Int, Int) = handle { parallel { meter.level(), meter.level() } } with { meter.level() -> 0 }\n",
    b"fn nested(xs: List<Int>) -> List<(Int, Int)> = xs.map(|m: Int| parallel { m + 1, m + 2 })\n",
    b"fn open<| e>(g: () -> Int / e) -> (Int, Int) / e = parallel { g(), 1 }\n",
  ]);
  let keys = [
    Named(b"m.pure"),
    Named(b"m.reads"),
    Named(b"m.handled"),
    Named(b"m.nested"),
    keys::specialisation_key_with_effects(b"m.open", [], [], [[]]),
  ];
  let names = keys.map(printed);
  let results = outputs_at([b"m"], [source], [], keys);
  let calls = |helper: Bytes|
    names.map(|n: Bytes| output_body(results, n).text.index_of(helper) != None);
  assert_eq(calls(b"rt_branches_p(ctx, "), [true, true, true, true, true])
}

test "the emitter returns the C code for each function it is asked for, with that function's static data, group members and `handle` names as lists" {
  let source = b"fn greet() -> Bytes = b\"hi\"\nfn twice(x: Int) -> Int = x + x\nfn guarded() -> Option<Instant> / {clock.read} = handle { Some(clock.now()) } with { clock.now() -> clock.now(), }\n";
  let wanted = [b"m.greet", b"m.twice", b"m.guarded"];
  let results = outputs_at([b"m"], [source], [b"Some"], wanted.map(Named));
  assert_eq(results.map(output_name), wanted);
  let greet = results.get(0).result;
  assert_eq(greet.tables.statics, statics_of(BytesDatum(b"hi")));
  assert_eq(greet.tables.members, []);
  assert_eq(greet.tables.defined, [{ entered: true, head: word_prototype(0) }]);
  assert_eq(results.get(2).result.tables.handles, [b"clock#now"])
}

test "guarded arms and every literal pattern are emitted" {
  let source = b"fn f(n: Int, m: Int) -> Int = match n { x if x > m -> x, 0 -> 1, x if x < 0 - m -> m, _ -> m }\nfn g(s: String) -> Int = match s { t if t == \"a\" -> 1, \"b\" -> 2, _ -> 3 }\nfn h(u: Unit, b: Bytes, f: Float, d: Decimal, w: U64, n: Int) -> Int = match u { () -> match b { b\"x\" -> 1, _ -> match f { -1.5 -> 2, _ -> match d { 2.50m -> 3, _ -> match w { 7u64 -> 4, _ -> match n { 4611686018427387904 -> 5, _ -> 6 } } } } } }\n";
  assert_eq(emit_all_program([{ name: b"m", source_text: source }], [], true).len(), 3)
}

test "an operator is compiled for the type the checker resolved for its operands, wherever the operands come from" {
  let source = Bytes::concat_all([
    b"fn bytes(xs: List<U8>) -> U8 = match xs { [a, b, ..] -> a + b, _ -> 0u8 }\n",
    b"fn ints(xs: List<Int>) -> Int = match xs { [a, b, ..] -> a + b, _ -> 0 }\n",
    b"fn folded(xs: List<U8>) -> U8 = xs.fold(0u8, wrap_add)\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| e.text.index_of(text) != None);
  assert_eq(out.len(), 3);
  assert_eq(has(b"rt_binary_p"), [false, false, false]);
  assert_eq(has(b"_lambda0_value;"), [false, false, true]);
  assert_eq(has(b"INT64_C(255)"), [true, false, false]);
  assert_eq(has(b"ply_add_ov("), [false, true, false]);
  assert_eq(has(b"rt_overflow_p").at(2), Some(false));
  assert_eq(has(b"(uint8_t)").at(2), Some(true))
}

test "a `Float` is a C `double`: its operators are C's own and a literal is emitted as its bit pattern" {
  let source = Bytes::concat_all([
    b"fn poly(x: Float) -> Float = (0.5 * x + 0.25) * x - 1.5\n",
    b"fn less(a: Float, b: Float) -> Bool = a < b || a == -b\n",
    b"fn rest(a: Float, b: Float) -> Float = a % b\n",
    b"type Point = { x: Float, y: Float }\n",
    b"fn norm(p: Point) -> Float = p.x * p.x + p.y * p.y\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| e.text.index_of(text) != None);
  assert_eq(out.len(), 4);
  assert_eq(has(b"rt_binary_p"), [false, false, false, false]);
  assert_eq(has(b"double "), [true, true, true, true]);
  assert_eq(has(b"ply_f64(INT64_C(4602678819172646912))"), [true, false, false, false]);
  assert_eq(has(b"fmod("), [false, false, true, false])
}

type NamedPrototype = { callee: Bytes, head: Prototype }

fn named_prototypes(t: Tables) -> List<NamedPrototype> =
  t.generics.expects.map(|e: ExpectedPrototype|
    {
      callee: match e.callee {
        GenericAt(n) -> Bytes::concat_all([b"@@g", ascii_of_int(n), b"@@"]),
        CallAt(_) -> match callee_name(t, e) { Some(c) -> root_text(c), None -> b"" },
      },
      head: e.head,
    })

fn body_code(text: Bytes) -> Bytes / {abort.raise} = {
  let opened = text.split(b"\n").fold(
    { at: 0, found: None },
    |s: { at: Int, found: Option<Int> }, line: Bytes|
      match s.found {
        Some(_) -> s,
        None ->
          {
            at: s.at + line.len() + 1,
            found: if line.ends_with(b") {") && !line.starts_with(b"static ")
                && !line.starts_with(b" ") { Some(s.at) }
            else { None },
          },
      },
  );
  let from = match opened.found { Some(i) -> i, None -> 0 };
  let rest = text.slice(from, text.len());
  match rest.index_of(b"\n}\n") { Some(i) -> rest.slice(0, i), None -> rest }
}

test "a record stores every `Float` field as its bit pattern, at any field position and any record size" {
  let fields = bytes_join(
    range(0, 70).map(|k: Int| Bytes::concat_all([b"f", ascii_of_int(k + 10), b": Float"])),
    b", ",
  );
  let source = Bytes::concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"fn point(x: Float, y: Float) -> Point = { x: x, y: y }\n",
    b"fn sum(p: Point) -> Float = p.x + p.y\n",
    b"fn weighed(name: String, weight: Float) -> { name: String, weight: Float } = { name: name, weight: weight }\n",
    b"fn moved(p: Point, by: Float) -> Point = { ..p, x: p.x + by }\n",
    b"type Wide = { ",
    fields,
    b", tag: String }\n",
    b"fn last(wide: Wide) -> Float = wide.f79\n",
    b"fn wrapped<a>(x: a) -> { inner: a } = { inner: x }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| e.text.index_of(text) != None);
  assert_eq(out.len(), 6);
  assert_eq(out.map(|e: EmittedRoot| body_code(e.text).index_of(b"rt_box_float_p") != None), [
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  assert_eq(has(b"ply_alloc(ctx, INT64_C(24));"), [false, false, false, false, false, false]);
  assert(
    out.get(4).text.index_of(b"ply_f64(ply_words(p0)[69])") != None,
    Some(String::of_bytes_lossy(out.get(4).text)),
  );
  assert_eq(out.get(5).text, b"");
  assert(out.get(5).tables.generics.needs.map(|n: Need| n.reads).contains(Layout), None)
}

test "a record containing a record wider than the registers stores it inline, wherever it is made, updated or read" {
  let fields = bytes_join(
    range(0, 40).map(|k: Int| Bytes::concat_all([b"f", ascii_of_int(k + 10), b": Int"])),
    b", ",
  );
  let source = Bytes::concat_all([
    b"type Wide = { ",
    fields,
    b", tag: String }\n",
    b"type Outer = { inner: Wide, k: List<Int>, a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int }\n",
    b"fn made(w: Wide, k: List<Int>) -> Outer = { inner: w, k: k, a: 0, b: 0, c: 0, d: 0, e: 0, f: 0, g: 0 }\n",
    b"fn set(o: Outer, w: Wide) -> Outer = { ..o, inner: w }\n",
    b"fn kept(o: Outer) -> Outer = { ..o, k: [1] }\n",
    b"fn k(o: Outer) -> List<Int> = o.k\n",
    b"fn tag(o: Outer) -> String = o.inner.tag\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), 5);
  let made = body_code(out.get(0).text);
  assert(
    made.split(b"ply_alloc").len() == 2 && made.index_of(b"PLY_RC_FRAME") != None,
    Some(String::of_bytes_lossy(out.get(0).text)),
  );
  assert(
    out.get(4).text.index_of(b")[40]") != None
      && body_code(out.get(4).text).index_of(b"ply_alloc") == None,
    Some(String::of_bytes_lossy(out.get(4).text)),
  )
}

test "a definition takes and returns a float as a C `double`, and a call uses the `double` signature the callee was declared with" {
  let source = b"fn half(x: Float) -> Float = x / 2.0\nfn quarter(x: Float) -> Float = half(half(x))\nfn same(x: Int) -> Int = x\n";
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let floats = { result: b"double", params: [b"double"] };
  assert(
    out.get(0).text.index_of(
        Bytes::concat_all([b"double ", own_symbol(None), b"(PlyCtx *ctx, double p0) {"]),
      )
      != None,
    None,
  );
  assert(body_code(out.get(1).text).index_of(b"rt_box_float_p") == None, None);
  assert_eq(named_prototypes(out.get(1).tables), [
    { callee: b"m.half", head: floats },
    { callee: b"m.half", head: floats },
  ]);
  assert_eq(
    (
      out.get(1).tables.calls.map(printed),
      out.get(1).tables.generics.expects.map(|e: ExpectedPrototype| e.callee),
    ),
    ([b"m.half"], [CallAt(0), CallAt(0)]),
  );
  assert_eq(out.get(1).tables.defined.map(|d: DefinitionSymbol| d.head), [floats]);
  assert_eq(out.get(2).tables.defined.map(|d: DefinitionSymbol| d.head), [
    { result: b"int64_t", params: [b"int64_t"] },
  ])
}

test "a lambda inlined into a specialised function reads its parameters and captured variables at their declared types" {
  let source = Bytes::concat_all([
    b"type Fld = { name: Bytes, n: Int }\n",
    b"fn each(fs: List<Fld>, g: (Fld) -> Int) -> List<Int> = fs.map(g)\n",
    b"fn total(fs: List<Fld>, g: (Int, Fld) -> Int) -> Int = fs.fold(0, g)\n",
    b"fn bumped(xs: List<Int>, g: (Int) -> Int) -> List<Int> = xs.map(g)\n",
    b"fn mapped(fs: List<Fld>) -> List<Int> = each(fs, |f: Fld| f.n)\n",
    b"fn folded(fs: List<Fld>) -> Int = total(fs, |acc: Int, f: Fld| acc + f.n)\n",
    b"fn captured(f: Fld, xs: List<Int>) -> List<Int> = bumped(xs, |x: Int| x + f.n)\n",
    b"fn offset(k: Int, xs: List<Int>) -> List<Int> = bumped(xs, |x: Int| { let j = k - 1; x + j })\n",
    b"fn stepped(f: Fld) -> Int / {abort.raise} = iterate(f, 9, |t: Fld| if t.n > 3 { Stop(t.n) } else { Continue({ ..t, n: t.n + 1 }) })\n",
  ]);
  let borrowed = |definition: Bytes, owner: Bytes|
    specialisation_key(definition, [], [{ param: 1, owner: Named(owner), nth: 0 }]);
  let loops = [
    borrowed(b"m.each", b"m.mapped"),
    borrowed(b"m.total", b"m.folded"),
    borrowed(b"m.bumped", b"m.captured"),
    borrowed(b"m.bumped", b"m.offset"),
  ];
  let keys = [b"m.mapped", b"m.folded", b"m.captured", b"m.offset", b"m.stepped"].map(Named).concat(
    loops,
  );
  let names = keys.map(printed);
  let results = outputs_at([b"m"], [source], [b"Stop", b"Continue"], keys);
  let text = |name: Bytes| output_body(results, name).text;
  assert_eq(loops.map(|k: RootKey| calls_a_value(body_code(text(printed(k))))), [
    false,
    false,
    false,
    false,
  ])
}

test "a lambda inlined into a specialised function gives each captured variable it reads a known type, never an unknown one" {
  let source = Bytes::concat_all([
    b"type Fld = { name: Bytes, n: Int }\n",
    b"fn bumped(xs: List<Int>, g: (Int) -> Int) -> List<Int> = xs.map(g)\n",
    b"fn captured(f: Fld, xs: List<Int>) -> List<Int> = bumped(xs, |x: Int| x + f.n)\n",
  ]);
  let loop = specialisation_key(b"m.bumped", [], [
    { param: 1, owner: Named(b"m.captured"), nth: 0 },
  ]);
  let d = dump_of(analyse(parse_all(zip_sources([b"m"], [source]))));
  let w = lowered_roots(
    [b"m"],
    [source],
    loaded_constructors(d, []),
    [loop],
    [],
    [],
    d.embeds,
    d.rows,
    d.effects,
    d.inferred_facts,
  );
  let read = w.roots.fold([], |accumulator: List<Type>, f: Function|
    if root_name(f.key) != root_name(loop) { accumulator }
    else { accumulator.concat(capture_reads(f.body).map(|v: Variable| v.ty)) });
  assert(read.len() > 0 && read.all(|t: Type| t != unknown_type), None)
}

fn capture_reads(b: Block) -> List<Variable> =
  b.fold([], |accumulator: List<Variable>, i: Instruction|
    match i {
      Let(l) -> match l.value {
        Get(g) -> match g.path { CapturePath(_) -> accumulator.push(l.var), _ -> accumulator },
        _ -> accumulator,
      },
      If(x) -> accumulator.concat(capture_reads(x.then)).concat(capture_reads(x.otherwise)),
      Case(c) ->
        c.arms.fold(
          accumulator.concat(capture_reads(c.rest)),
          |a: List<Variable>, arm: { when: Int, body: Block }| a.concat(capture_reads(arm.body)),
        ),
      Match(m) ->
        m.arms.fold(accumulator.concat(capture_reads(m.rest)), |a: List<Variable>, arm: Block|
          a.concat(capture_reads(arm))),
      Loop(l) -> accumulator.concat(capture_reads(l.body)),
      _ -> accumulator,
    })

fn zero_variables(b: Block) -> List<Variable> =
  b.fold([], |accumulator: List<Variable>, i: Instruction|
    match i {
      Declaration(v) -> accumulator.push(v),
      Let(l) -> match l.value {
        Convert(p) -> match p.arg { ZeroOperand(_) -> accumulator.push(l.var), _ -> accumulator },
        _ -> accumulator,
      },
      If(x) -> accumulator.concat(zero_variables(x.then)).concat(zero_variables(x.otherwise)),
      Case(c) ->
        c.arms.fold(
          accumulator.concat(zero_variables(c.rest)),
          |a: List<Variable>, arm: { when: Int, body: Block }| a.concat(zero_variables(arm.body)),
        ),
      Match(m) ->
        m.arms.fold(accumulator.concat(zero_variables(m.rest)), |a: List<Variable>, arm: Block|
          a.concat(zero_variables(arm))),
      Loop(l) -> accumulator.concat(zero_variables(l.body)),
      _ -> accumulator,
    })

test "a `()` returned by an `if` branch or passed to a call has type `Unit`, and so do the variables that receive that value" {
  let source = Bytes::concat_all([
    b"fn same(b: Bool) -> Unit = if b { () } else { () }\n",
    b"fn whole(xs: List<Int>, b: Bool) -> Int = { if b { xs.fold((), |_: Unit, x: Int| if x == 0 { () } else { () }); () }; 1 }\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let variable_types = |name: Bytes| {
        let f = lowered_root(p, name);
        zero_variables(f.body).concat(
          f.lambdas.fold([], |accumulator: List<Variable>, l: Lambda|
            match l { Closure(c) -> accumulator.concat(zero_variables(c.body.body)) }),
        ).map(|v: Variable| v.ty)
      };
      let unit = unit_type;
      assert_eq(variable_types(b"same"), [unit]);
      assert(
        variable_types(b"whole").len() > 0 && variable_types(b"whole").all(|t: Type| t == unit),
        None,
      )
    },
  }
}

const borrowing: Bytes =
  b"fn each(n: Int, f: (Int) -> Int, i: Int, acc: Int) -> Int = if i >= n { acc } else { each(n, f, i + 1, acc + f(i)) }\nfn total(n: Int, f: (Int) -> Int) -> Int = each(n, f, 0, 0)\nfn scaled(n: Int, k: Int) -> Int = total(n, |x: Int| x * k)\n"

test "when a lambda is passed to a function that calls it, the specialised function inlines the lambda's body and loops without calling a function value" {
  let borrowed = [{ param: 1, owner: Named(b"m.scaled"), nth: 0 }];
  let total = printed(specialisation_key(b"m.total", [], borrowed));
  let each = printed(specialisation_key(b"m.each", [], borrowed));
  let results = outputs_at([b"m"], [borrowing], [], [
    Named(b"m.each"),
    Named(b"m.total"),
    Named(b"m.scaled"),
    specialisation_key(b"m.total", [], borrowed),
    specialisation_key(b"m.each", [], borrowed),
  ]);
  let body = |name: Bytes|
    results.fold(None, |accumulator: Option<Output>, a: RootOutput|
      if output_name(a) != name { accumulator } else { Some(a.result) });
  let generics = |name: Bytes|
    match body(name) { Some(b) -> b.tables.generics, None -> no_generics };
  assert_eq(generics(b"m.each").called_parameters, [1]);
  assert_eq(generics(b"m.total").passes, [{ param: 1, callee: Named(b"m.each"), at: 1 }]);
  assert_eq(generics(b"m.scaled").calls.map(|g: GenericCall| g.functions), [borrowed]);
  assert_eq(generics(total).calls.map(|g: GenericCall| g.functions), [borrowed]);
  match body(each) {
    Some(b) -> {
      assert(!calls_a_value(body_code(b.text)), None);
      assert(body_code(b.text).index_of(b"ply_loop") != None, None)
    },
    None -> panic("no body for the specialisation"),
  }
}

test "a specialisation that stores its lambda argument in a closure passes that same lambda on to the function the closure calls" {
  let source = Bytes::concat_all([
    b"fn each(f: (Int) -> Int, x: Int) -> Int = f(x)\n",
    b"fn later(f: keep (Int) -> Int) -> List<() -> Int> = [|| each(f, 1)]\n",
    b"fn scaled(k: Int) -> List<() -> Int> = later(|x: Int| x * k)\n",
  ]);
  let borrowed = [{ param: 0, owner: Named(b"m.scaled"), nth: 0 }];
  let later = specialisation_key(b"m.later", [], borrowed);
  let results = outputs_at([b"m"], [source], [], [
    Named(b"m.each"),
    Named(b"m.later"),
    Named(b"m.scaled"),
    later,
  ]);
  assert_eq(
    output_body(results, printed(later)).tables.generics.calls.map(|g: GenericCall| g.functions),
    [borrowed],
  )
}

test "an inlined lambda reads variables of its own, not the parameters of the function it is inlined into" {
  let source = Bytes::concat_all([
    b"type Def = { name: Bytes, guard: Option<Int> }\n",
    b"type Item = | ISchema(Def) | IOther\n",
    b"fn walk(xs: List<Item>, f: (List<Bytes>, Item) -> List<Bytes>, i: Int, acc: List<Bytes>, n: Option<Int>) -> List<Bytes> = match xs.at(i) { Some(x) -> walk(xs, f, i + 1, f(acc, x), n), None -> acc }\n",
    b"fn named(prefix: Bytes, xs: List<Item>) -> List<Bytes> = walk(xs, |acc: List<Bytes>, item: Item| match item { ISchema(d) -> { let kept = acc.push(prefix ++ d.name); match d.guard { Some(_) -> kept.push(prefix), None -> kept } }, _ -> acc }, 0, [], None)\n",
  ]);
  let walk = specialisation_key(b"m.walk", [], [{ param: 1, owner: Named(b"m.named"), nth: 0 }]);
  let results = outputs_at([b"m"], [source], [b"Some", b"None", b"m.ISchema", b"m.IOther"], [
    Named(b"m.named"),
    walk,
  ]);
  let code = body_code(output_body(results, printed(walk)).text);
  let maybe_joins = code.split(b"\n").filter(|l: Bytes|
    l.index_of(b"PlyMaybe ") != None && l.index_of(b" = 0;") != None);
  assert(maybe_joins == [], Some(String::of_bytes_lossy(code)))
}

test "a function bound to a lambda by `let` is called directly with no function value, inlined at its one call, and passed to other functions as a borrowed argument" {
  let source = Bytes::concat_all([
    b"fn walked(n: Int, x: Float, f: (Float) -> Float) -> Float = if n <= 0 { x } else { walked(n - 1, f(x), f) }\n",
    b"fn called(k: Float) -> Float = { let f = |x: Float| x * k; let g = f; f(1.0) + g(2.0) }\n",
    b"fn nested(k: Float) -> Float = { let f = |x: Float| x * k; let h = |x: Float| f(x) + 1.0; h(2.0) }\n",
    b"fn handed(n: Int, k: Float) -> Float = { let f = |x: Float| x * k; let g = f; walked(n, 1.0, g) }\n",
    b"fn half(x: Float) -> Float = x * 0.5\n",
    b"fn halved(n: Int) -> Float = walked(n, 1.0, half)\n",
  ]);
  let borrowed = [{ param: 2, owner: Named(b"m.handed"), nth: 0 }];
  let walked = printed(specialisation_key(b"m.walked", [], borrowed));
  let named = [{ param: 2, owner: Named(b"m.halved"), nth: 0 }];
  let halving = printed(specialisation_key(b"m.walked", [], named));
  let results = outputs_at(
    [b"m"],
    [source],
    [],
    [b"m.walked", b"m.called", b"m.nested", b"m.handed", b"m.half", b"m.halved"].map(Named).concat(
      [specialisation_key(b"m.walked", [], borrowed), specialisation_key(b"m.walked", [], named)],
    ),
  );
  let body = |name: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == name { Some(a) } else { accumulator }) {
      Some(a) -> a.result,
      None -> panic("no result"),
    };
  assert(!calls_a_value(body_code(body(b"m.called").text)), None);
  assert(!calls_a_value(body(b"m.nested").text), None);
  assert_eq(body(b"m.handed").tables.generics.calls.map(|g: GenericCall| g.functions), [borrowed]);
  assert(!calls_a_value(body_code(body(walked).text)), None);
  assert(body_code(body(walked).text).index_of(b"ply_loop") != None, None);
  assert_eq(body(b"m.halved").tables.generics.calls.map(|g: GenericCall| g.functions), [named]);
  assert(!calls_a_value(body_code(body(halving).text)), None);
  assert(body_code(body(halving).text).index_of(symbol_of(b"m.half")) != None, None)
}

test "a lambda bound by `let` is emitted once however often it is called, and each call enters its function directly" {
  let source = Bytes::concat_all([
    b"fn deep(x: Int) -> Int = {\n",
    b"  let inner = |y: Int| y * 7919;\n",
    b"  let middle = |y: Int| inner(y) + inner(y + 1) + inner(y + 2) + inner(y + 3);\n",
    b"  let outer = |y: Int| middle(y) + middle(y + 1) + middle(y + 2) + middle(y + 3);\n",
    b"  outer(x) + outer(x + 1) + outer(x + 2) + outer(x + 3)\n",
    b"}\n",
    b"fn walked(xs: List<Int>, ys: List<Int>, k: Int) -> Int = { let f = |x: Int| x * 104729 + k; let a = xs.map(f); let b = ys.map(f); a.len() + b.len() }\n",
  ]);
  let results = outputs_at([b"m"], [source], [], [Named(b"m.deep"), Named(b"m.walked")]);
  let deep = output_body(results, b"m.deep").text;
  assert_eq(deep.split(b"7919").len(), 2);
  assert(!calls_a_value(deep), Some(String::of_bytes_lossy(deep)));
  let walked = output_body(results, b"m.walked");
  assert_eq(walked.text.split(b"104729").len(), 2);
  assert(!calls_a_value(walked.text), Some(String::of_bytes_lossy(walked.text)));
  assert(
    !walked.tables.generics.calls.any(|g: GenericCall| g.callee == Named(b"std.prelude.List::map")),
    None,
  )
}

test "a known lambda that is called as a separate function, not inlined, receives as arguments the values its body would otherwise read directly" {
  let source = Bytes::concat_all([
    b"effect noted {\n  write note(n: Int) -> Unit\n}\n",
    b"fn noting(n: Int) -> Int / {noted.note} = { noted.note(n); n }\n",
    b"fn spread<|e>(xs: List<Int>, f: (Int) -> Int / e) -> List<Int> / e = xs.map(f).push(f(0))\n",
    b"fn mentions(xs: List<Int>) -> List<Int> / {noted.note} = spread(xs, noting)\n",
    b"fn twice(x: Int) -> Int / {noted.note} = { let note = |n: Int| { noted.note(n); n }; note(x) + note(x + 1) }\n",
  ]);
  let noted = [{ effect: b"m.noted", resource: SingletonResource }];
  let borrowed = keys::specialisation_key_with_effects(
    b"m.spread",
    [],
    [{ param: 1, owner: Named(b"m.mentions"), nth: 0 }],
    [noted],
  );
  let results = outputs_at([b"m"], [source], [], [
    Named(b"m.mentions"),
    borrowed,
    Named(b"m.twice"),
  ]);
  let wordless = |text: Bytes|
    text.split(b"\n").filter(|l: Bytes|
      (l.index_of(b"->typed)(ctx") != None || l.index_of(b"_typed(ctx") != None)
        && l.ends_with(b", 0);"));
  assert_eq(output_body(results, printed(borrowed)).text.index_of(b"->typed)(ctx") != None, true);
  assert_eq(wordless(output_body(results, printed(borrowed)).text), []);
  let own = output_body(results, b"m.twice").text;
  assert(own.index_of(b"_lambda0_typed(ctx") != None, Some(String::of_bytes_lossy(own)));
  assert_eq(wordless(own), [])
}

test "a definition at fully known type arguments passes its lambdas borrowed, as a definition without type arguments does" {
  let source = Bytes::concat_all([
    b"fn some<a>(xs: List<a>, f: (a) -> Bool, i: Int) -> Bool = match xs.at(i) { Some(x) -> if f(x) { true } else { some(xs, f, i + 1) }, None -> false }\n",
    b"fn holds<a>(xs: List<a>, x: a) -> Bool = some(xs, |y: a| y == x, 0)\n",
    b"fn has_three(xs: List<Int>) -> Bool = holds(xs, 3)\n",
  ]);
  let int = int_type;
  let contains_key = specialisation_key(b"m.holds", [int], []);
  let contains_name = printed(contains_key);
  let borrowed = [{ param: 1, owner: contains_key, nth: 0 }];
  let somed = specialisation_key(b"m.some", [int], borrowed);
  let some = printed(somed);
  let results = outputs_at([b"m"], [source], [b"Some", b"None"], [
    Named(b"m.has_three"),
    contains_key,
    somed,
  ]);
  let body = |name: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == name { Some(a) } else { accumulator }) {
      Some(a) -> a.result,
      None -> panic("no result"),
    };
  assert_eq(body(contains_name).tables.generics.calls.map(|g: GenericCall| g.functions), [
    borrowed,
  ]);
  assert(!calls_a_value(body_code(body(some).text)), None);
  assert(body_code(body(some).text).index_of(b"ply_loop") != None, None);
  assert_eq(
    outputs_at([b"m"], [source], [b"Some", b"None"], [somed]).map(|a: RootOutput|
      body_code(a.result.text)),
    [body_code(body(some).text)],
  )
}

test "a closure that captured a sum type releases it by switching on the case stored in the sum, in the same way as when the closure is copied" {
  let source = b"type Side = | Unread(() -> Int) | Read(Int, () -> Int) | Over\nfn made(left: Side, right: Side, n: Int) -> () -> Int = || match left { Over -> n, Read(x, _) -> x, Unread(f) -> match right { Over -> f(), _ -> 0 } }\n";
  let text = match outputs_at([b"m"], [source], [b"Unread", b"Read", b"Over"], [
      Named(b"m.made"),
    ]).at(
      0,
    ) {
    Some(a) ->
      Bytes::concat_all(a.result.tables.shared.map(|f: SharedFunction| f.text).push(a.result.text)),
    None -> panic("no result"),
  };
  let named = match text.index_of(b"_desc = { ") {
    Some(i) -> text.slice(i + 10, text.len()),
    None -> b"",
  };
  let entries = named.slice(0, match named.index_of(b" };") { Some(e) -> e, None -> 0 }).split(
    b", ",
  );
  let switched = |at: Int| {
    let from = match text.index_of(entries.get(at).concat(b"(PlyCtx")) {
      Some(i) -> text.slice(i, text.len()),
      None -> b"",
    };
    let body = from.slice(0, match from.index_of(b"\n}\n") { Some(e) -> e, None -> from.len() });
    body.split(b"switch (").drop(1).map(|s: Bytes|
      s.slice(0, match s.index_of(b") {") { Some(e) -> e, None -> s.len() }))
  };
  assert_eq(switched(3).len(), 2);
  assert_eq(switched(3), switched(4))
}

test "only a definition with no parameters has an `_entry` function, and reading it as a constant calls that function" {
  let source = b"fn id<a>(x: a) -> a = x\nfn twice(n: Int) -> Int = id(n) + id(n)\nfn ten() -> Int = twice(5)\n";
  let at = specialisation_key(b"m.id", [int_type], []);
  let results = outputs_at([b"m"], [source], [], [at, Named(b"m.twice"), Named(b"m.ten")]);
  assert_eq(results.map(output_name), [printed(at), b"m.twice", b"m.ten"]);
  let bodies = results.map(|a: RootOutput| a.result);
  assert_eq(bodies.map(|b: Output| b.tables.defined.map(|d: DefinitionSymbol| d.entered)), [
    [false],
    [false],
    [true],
  ]);
  assert_eq(bodies.map(|b: Output| b.text.index_of(b"_entry") != None), [false, false, true])
}

test "the emitted C for a function that passes a lambda to another function is identical wherever the definition appears in the source, as is the list of functions it calls" {
  let borrowed = [{ param: 1, owner: Named(b"m.scaled"), nth: 0 }];
  let wanted = [
    Named(b"m.scaled"),
    specialisation_key(b"m.total", [], borrowed),
    specialisation_key(b"m.each", [], borrowed),
  ];
  let emitted = |above: Bytes|
    outputs_at([b"m"], [above.concat(borrowing)], [], wanted).map(|a: RootOutput|
      { name: a.name, text: a.result.text, calls: a.result.tables.calls });
  assert_eq(
    emitted(b"// a comment, and a definition, above them\nfn aside() -> Int = 7\n"),
    emitted(b""),
  )
}

test "a definition's call to itself is emitted with the C signature of the function it names" {
  let source = b"fn deepened<a>(x: a, n: Int) -> a where numeric(a) = if n <= 0 { x } else { deepened(x, n - 1) + x }\n";
  let results = outputs_at([b"m"], [source], [], [
    Named(b"m.deepened"),
    specialised_at(b"m.deepened", [b"Float"]),
  ]);
  let heads = |name: Bytes|
    results.filter(|a: RootOutput| output_name(a) == name).map(|a: RootOutput|
      {
        own: a.result.tables.defined.map(|d: DefinitionSymbol| d.head),
        called: a.result.tables.generics.expects.map(|e: ExpectedPrototype| e.head),
      });
  let floats = { result: b"double", params: [b"int64_t", b"double", b"int64_t"] };
  assert_eq(heads(b"m.deepened"), [{ own: [], called: [] }]);
  assert_eq(heads(b"m.deepened@Float"), [{ own: [floats], called: [floats] }])
}

test "a small record of floats is passed to and returned from a call as separate `double` fields" {
  let source = b"type P = { x: Float, y: Float }\nfn mid(a: P, b: P) -> P = { x: (a.x + b.x) / 2.0, y: (a.y + b.y) / 2.0 }\nfn twice(p: P) -> P = mid(p, p)\n";
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let mid = { result: b"double", params: [b"double", b"double", b"double", b"double", b"Word*"] };
  assert_eq(out.len(), 2);
  assert_eq(out.get(0).tables.defined.map(|d: DefinitionSymbol| d.head), [mid]);
  assert_eq(named_prototypes(out.get(1).tables), [{ callee: b"m.mid", head: mid }]);
  assert_eq(out.map(|e: EmittedRoot| body_code(e.text).index_of(b"rt_alloc_p") != None), [
    false,
    false,
  ])
}

test "a record field of a record type is stored inline, its words among the containing record's words" {
  let source = Bytes::concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"type Segment = { from: Point, label: String, to: Point, zone: (Int, Int, Int, Int) }\n",
    b"fn segment(from: Point, to: Point, label: String) -> Segment = { from: from, label: label, to: to, zone: (0, 0, 0, 0) }\n",
    b"fn end_x(s: Segment) -> Float = s.to.x\n",
    b"fn start(s: Segment) -> Point = s.from\n",
    b"fn relabelled(s: Segment, label: String) -> Segment = { ..s, label: label }\n",
    b"fn wrapped<a>(x: a) -> { outer: { inner: a } } = { outer: { inner: x } }\n",
    b"fn retargeted(s: Segment, to: Point) -> Segment = { ..s, to: to }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| e.text.index_of(text) != None);
  assert_eq(out.len(), 6);
  assert_eq(has(b"ply_alloc(ctx, INT64_C(80));"), [true, false, false, false, false, false]);
  assert_eq(has(b"_copy_"), [false, false, false, true, false, true]);
  [b"rt_alloc_p(", b"(ply_words(p0) + ", b"rt_box_float_p"].fold((), |_: Unit, t: Bytes|
    assert_eq(has(t), [false, false, false, false, false, false]));
  assert_eq(out.get(4).text, b"")
}

test "a 64-bit integer is a C value of its own type in a register, and its bit pattern inside a record" {
  let source = Bytes::concat_all([
    b"type Tally = { count: U64, label: String, offset: I64 }\n",
    b"fn bumped(t: Tally, by: U64) -> Tally = { ..t, count: t.count + by }\n",
    b"fn scaled(a: U64, b: U64) -> U64 = a * b\n",
    b"fn turned(a: I64) -> I64 = -a\n",
    b"fn largest() -> U64 = 0xFFFF_FFFF_FFFF_FFFFu64\n",
    b"fn kept<a>(x: a) -> { inner: a } = { inner: x }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| e.text.index_of(text) != None);
  assert_eq(out.len(), 5);
  assert_eq(has(b"(uint64_t)"), [true, true, false, true, false]);
  assert_eq(has(b"rt_binary_p"), [false, false, false, false, false]);
  assert_eq(has(b"rt_wide_binary_p"), [false, false, false, false, false]);
  assert_eq(has(b"ply_overflow(ctx, 3)"), [false, true, false, false, false]);
  assert_eq(has(b"== INT64_MIN"), [false, false, true, false, false]);
  assert_eq(has(b"] = (Word)("), [true, false, false, false, false]);
  assert_eq(out.map(|e: EmittedRoot| body_code(e.text).index_of(b"rt_box_fixed_p") != None), [
    false,
    false,
    false,
    false,
    false,
  ]);
  assert_eq(out.get(4).text, b"")
}

test "an array stores a record's words inline and a float as its bit pattern" {
  let source = Bytes::concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"fn second_x(ps: Array<Point>) -> Float / {abort.raise} = ps.get(1).x\n",
    b"fn bumped(xs: Array<Float>, i: Int) -> Float / {abort.raise} = xs.get(i) + 1.0\n",
    b"fn count(ps: Array<Point>) -> Int = ps.len()\n",
    b"fn element_of<a>(xs: Array<a>, i: Int) -> a / {abort.raise} = xs.get(i)\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| e.text.index_of(text) != None);
  assert_eq(out.len(), 4);
  assert_eq(has(b", INT64_C(32));"), [false, false, false, false]);
  assert_eq(has(b"ply_f64((ply_words("), [true, true, false, false]);
  assert_eq(has(b"PlyArrayHead *)ply_words("), [true, true, true, false]);
  assert_eq(has(b"ply_refused(ctx, 4, "), [true, true, false, false]);
  assert_eq(has(b"builtin_array_get"), [false, false, false, false]);
  assert_eq(out.get(3).text, b"")
}

test "a value's layout is taken from its node's type when the value has no layout of its own" {
  let source = Bytes::concat_all([
    b"type P = { x: Int, y: Int }\n",
    b"fn larger(p: P, q: P) -> Int = max(p, q).x\n",
    b"fn kept(p: P, q: P) -> Int = { let m = max(p, q); m.x + m.y }\n",
    b"fn opened(p: P, q: P) -> Int = { let { x, y } = max(p, q); x + y }\n",
    b"fn chosen(p: P, q: P) -> Int = match max(p, q) { { x, y } -> x + y }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), 4);
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(has(b"builtin_max_p"), [false, false, false, false])
}

const integer_types: List<Bytes> =
  [b"Int", b"U8", b"U16", b"U32", b"U64", b"I8", b"I16", b"I32", b"I64", b"U128", b"I128"]

const numeric_types: List<Bytes> = integer_types.concat([b"Float", b"Decimal", b"m.Length"])

test "every number builtin is code the emitter writes, at every type it is called at" {
  let length = Bytes::concat_all([
    b"type Length = | Metres(Int) | Millimetres(Int)\n",
    b"key for Length by millimetres\n",
    b"numeric for Length by { add: plus, sub: minus, mul: times, neg: negated, of_int: metres }\n",
    b"fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }\n",
    b"fn plus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) + millimetres(b))\n",
    b"fn minus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) - millimetres(b))\n",
    b"fn times(a: Length, b: Length) -> Length = Millimetres(millimetres(a) * millimetres(b))\n",
    b"fn negated(a: Length) -> Length = Millimetres(0 - millimetres(a))\n",
    b"fn metres(n: Int) -> Length = Metres(n)\n",
  ]);
  let at_type = |t: Bytes|
    Bytes::concat_all([
      b"fn rows_",
      t,
      b"(a: ",
      t,
      b", b: ",
      t,
      b", n: Int) -> List<Option<",
      t,
      b">> = [checked_add(a, b), checked_sub(a, b), checked_mul(a, b), checked_neg(a), ",
      b"Some(wrap_add(a, b)), Some(wrap_sub(a, b)), Some(wrap_mul(a, b)), Some(saturating_add(a, b)), ",
      b"Some(saturating_sub(a, b)), Some(saturating_mul(a, b)), Some(rotl(a, n)), Some(rotr(a, n)), ",
      b"Some(observe(a))]\n",
      b"fn whole_",
      t,
      b"(a: ",
      t,
      b") -> Option<Int> = to_int(a)\n",
    ]);
  let source = Bytes::concat_all([
    length,
    Bytes::concat_all(integer_types.map(at_type)),
    b"fn ints(a: U8, b: U16, c: U32, d: U64, e: I8, f: I16, g: I32, h: I64, i: U128, j: I128) -> List<Int> / {abort.raise} = ",
    b"[Int::of_u8(a), Int::of_u16(b), Int::of_u32(c), Int::of_u64(d), Int::of_i8(e), Int::of_i16(f), ",
    b"Int::of_i32(g), Int::of_i64(h), Int::of_u128(i), Int::of_i128(j)]\n",
    b"fn arith<a>(x: a, y: a) -> List<a> / {abort.raise} where numeric(a) = [x + y, x - y, x * y, -x, numeric_of_int(3), observe(x)]\n",
    b"fn ordered<a>(x: a, y: a) -> List<Bool> where numeric(a) = [x < y, x <= y, x > y, x >= y]\n",
    b"fn bits<a>(x: a, y: a) -> List<a> / {abort.raise} where integer(a) = [x / y, x % y, x & y, x | y, x ^ y, x << 1, x >> 1, x >>> 1, ~x]\n",
    b"fn whole<a>(x: a) -> Option<Int> where integer(a) = to_int(x)\n",
    b"fn held<a>(p: { x: a, y: a }) -> List<a> where numeric(a) = [p.x + p.y, -p.x]\n",
  ]);
  let concrete = integer_types.fold([Named(b"m.ints")], |accumulator: List<RootKey>, t: Bytes|
    accumulator.push(Named(b"m.rows_".concat(t))).push(Named(b"m.whole_".concat(t))));
  let generic = numeric_types.fold([], |accumulator: List<RootKey>, t: Bytes|
    accumulator.concat(
      [b"m.arith", b"m.ordered", b"m.held"].map(|d: Bytes| specialised_at(d, [t])),
    )).concat(
    integer_types.fold([], |accumulator: List<RootKey>, t: Bytes|
      accumulator.concat([b"m.bits", b"m.whole"].map(|d: Bytes| specialised_at(d, [t])))),
  );
  let wanted = concrete.concat(generic);
  let results = outputs_at([b"m"], [source], [b"m.Length"], wanted);
  assert_eq(results.len(), wanted.len())
}

test "`observe` returns its value hidden from the C compiler by an optimization barrier, at any type, and calls no function" {
  let source = Bytes::concat_all([
    b"type Shape = | Dot | Line(Int)\n",
    b"fn seen<a>(x: a) -> a = observe(x)\n",
    b"fn text(s: String) -> String = observe(s)\n",
    b"fn point(p: { x: Int, s: String }) -> { x: Int, s: String } = observe(p)\n",
    b"fn shape(s: Shape) -> Shape = observe(s)\n",
    b"fn apply(f: keep (Int) -> Int) -> Int = observe(f)(1)\n",
    b"fn constant() -> Int = observe(1000) * 2\n",
    b"fn nothing() -> Unit = observe(())\n",
    b"fn amount(d: Decimal) -> Decimal = observe(d)\n",
    b"fn wide(w: U128) -> U128 = observe(w)\n",
  ]);
  let seen = [specialised_at(b"m.seen", [b"String"]), specialised_at(b"m.seen", [b"Float"])];
  let named = [b"m.text", b"m.point", b"m.shape", b"m.apply", b"m.constant", b"m.nothing"];
  let pairs = [b"m.amount", b"m.wide"];
  let results = outputs_at(
    [b"m"],
    [source],
    [b"m.Shape"],
    named.concat(pairs).map(Named).concat(seen),
  );
  let text = |name: Bytes|
    match results.filter(|a: RootOutput| output_name(a) == name) { [a] -> a.result.text, _ -> b"" };
  let lacking = |names: List<Bytes>, part: Bytes|
    names.filter(|n: Bytes| text(n).index_of(part) == None);
  assert_eq(
    lacking(named.filter(|n: Bytes| n != b"m.nothing").concat(seen.map(printed)), b"ply_observed("),
    [],
  );
  assert_eq(lacking(pairs, b"ply_observed_pair("), [])
}

test "a `Secret` builtin compiles to a call of the runtime's native function for secrets, never to code that depends on the encoding of its arguments" {
  let calls = [
    { source: b"Secret::decode(\"hex\", t)", native: b"secret_decoded" },
    { source: b"Secret::encode(\"hex\", b)", native: b"secret_encoded" },
    { source: b"Secret::private_key(b)", native: b"secret_key" },
    { source: b"Secret::rsa_jwk(m, m, ts)", native: b"secret_rsa_jwk" },
    { source: b"Secret::hmac(\"SHA-256\", b, m)", native: b"secret_hmac" },
    { source: b"Secret::hkdf_extract(\"SHA-256\", m, b)", native: b"secret_hkdf_extract" },
    { source: b"Secret::hkdf_expand(\"SHA-256\", b, m, 32)", native: b"secret_hkdf_expand" },
    { source: b"Secret::pbkdf2(\"SHA-256\", b, m, 1, 32)", native: b"secret_pbkdf2" },
    {
      source: b"Secret::concat(Secret::bytes(Secret::of_string(\"a\")), b)",
      native: b"secret_concat",
    },
    { source: b"Secret::verify(t, \"a\") == Secret::is_empty(b)", native: b"secret_verify" },
  ];
  let params = b"(t: Secret<String>, b: Secret<Bytes>, m: Bytes, ts: List<Secret<String>>)";
  let source = Bytes::concat_all(
    range(0, calls.len()).map(|i: Int|
      Bytes::concat_all([
        b"fn f",
        ascii_of_int(i),
        params,
        b" -> Unit / {abort.raise} = { let _ = ",
        calls.get(i).source,
        b"; () }\n",
      ])),
  );
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), calls.len());
  assert_eq(
    range(0, calls.len()).filter(|i: Int| {
      let code = body_code(out.get(i).text);
      code.index_of(builtin_helper(b"?".concat(calls.get(i).native)).concat(b"_p(")) == None
    }),
    [],
  )
}

test "crypto functions call their external functions with machine words, and raise `abort.raise` when an external function returns an empty or error result" {
  let crypto = Bytes::concat_all([
    b"pub fn crypto_seal(cipher: String, key: Secret<Bytes>, nonce: Bytes, associated: Bytes, plaintext: Bytes) -> Bytes / {abort.raise} = {\n",
    b"  let sealed = crypto_sealed(cipher, key, nonce, associated, plaintext);\n",
    b"  if sealed.len() == 0 { abort.raise(\"too long\") } else { sealed }\n",
    b"}\n",
    b"pub fn crypto_verify(scheme: String, public: Bytes, message: Bytes, signature: Bytes) -> Bool / {abort.raise} =\n",
    b"  match crypto_verified(scheme, public, message, signature) { 1 -> true, 0 -> false, _ -> abort.raise(\"no scheme\") }\n",
    b"pub fn crypto_agree(scheme: String, key: Secret<Bytes>, peer: Bytes) -> Option<Secret<Bytes>> / {abort.raise} =\n",
    b"  if !crypto_agrees(scheme) { abort.raise(\"no scheme\") } else {\n",
    b"    let shared = crypto_agreed(scheme, key, peer);\n",
    b"    if shared.len() == 0 { None } else { Some(shared) }\n",
    b"  }\n",
    b"extern fn crypto_sealed(cipher: String, key: Secret<Bytes>, nonce: Bytes, associated: Bytes, plaintext: Bytes) -> Bytes\n",
    b"extern fn crypto_verified(scheme: String, public: Bytes, message: Bytes, signature: Bytes) -> Int\n",
    b"extern fn crypto_agrees(scheme: String) -> Bool\n",
    b"extern fn crypto_agreed(scheme: String, key: Secret<Bytes>, peer: Bytes) -> Secret<Bytes>\n",
  ]);
  let module = b"std.internal.crypto";
  let roots = [
    { name: b"crypto_seal", natives: [b"crypto_sealed"] },
    { name: b"crypto_verify", natives: [b"crypto_verified"] },
    { name: b"crypto_agree", natives: [b"crypto_agrees", b"crypto_agreed"] },
  ];
  let results = outputs_at(
    [module],
    [crypto],
    [b"Some", b"None"],
    roots.map(|r: { name: Bytes, natives: List<Bytes> }| Named(qualify(module, r.name))),
  );
  assert_eq(
    roots.filter(|r: { name: Bytes, natives: List<Bytes> }| {
      let code = body_code(output_body(results, qualify(module, r.name)).text);
      r.natives.any(|n: Bytes| code.index_of(builtin_helper(n).concat(b"_p(")) == None)
    }).map(|r: { name: Bytes, natives: List<Bytes> }| r.name),
    [],
  )
}

test "building a `Con` from another `Con`'s fields writes the new record into the `Con`'s own memory, with no separate record allocation" {
  let source = Bytes::concat_all([
    b"type T = | Con({ name: Bytes, args: List<T> }) | Leaf\n",
    b"fn renamed(t: T, to: Bytes) -> T = match t { Con(c) -> Con({ name: to, args: c.args }), Leaf -> Leaf }\n",
    b"fn rebuilt(t: T) -> T = match t { Con(c) -> Con({ name: c.name, args: c.args.map(|a: T| rebuilt(a)) }), Leaf -> Leaf }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [b"m.Con", b"m.Leaf"], true);
  assert_eq(out.len(), 2);
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(has(b"rt_alloc_p("), [false, false]);
  assert_eq(has(b"ply_alloc("), [false, false])
}

test "code is emitted for an effect operation that returns a record and a handler clause that takes a record, using the record type for each" {
  let source = Bytes::concat_all([
    b"type P = { x: Int, y: Int }\n",
    b"effect store { read held() -> P\n write keep(p: P) -> Unit }\n",
    b"fn summed() -> Int / {store.held} = { let p = store.held(); p.x + p.y }\n",
    b"fn kept(start: P) -> Int = handle { store.keep(start) } with { var seen = 0, store.keep(p) -> { seen = p.x + p.y; }, return u -> seen }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), 2)
}

test "code is emitted for a handler whose `var` variable stores a record that a clause then reads and updates" {
  let source = Bytes::concat_all([
    b"type Open = { now: Int, mine: List<Int>, held: Int }\n",
    b"effect bump { write by(n: Int) -> Int }\n",
    b"fn bumped(start: Open, by: Int) -> Int = handle { bump.by(by) } with { var st = start, bump.by(n) -> { let o = st; st = { ..o, now: o.now + n }; st.now + o.held } }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), 1)
}

test "a constructor pattern reads its argument as the subject's type lays it out" {
  let source = Bytes::concat_all([
    b"type P = { x: Int, y: Int }\n",
    b"type E = { why: Bytes }\n",
    b"fn made(n: Int) -> Result<P, E> = if n > 0 { Ok({ x: n, y: n }) } else { Err({ why: b\"low\" }) }\n",
    b"fn found(n: Int) -> Option<P> = if n > 0 { Some({ x: n, y: n }) } else { None }\n",
    b"fn summed(n: Int) -> Int = match made(n) { Ok({ x, y }) -> x + y, Err({ why }) -> why.len() }\n",
    b"fn first(n: Int) -> Int = match made(n) { Ok({ x: 7, y }) -> y, Ok(p) -> p.x, Err(e) -> e.why.len() }\n",
    b"fn either(n: Int) -> Int = match found(n) { Some({ x, y: 3 }) -> x, Some({ x, y }) -> x + y, None -> 0 }\n",
    b"fn held(rs: List<Result<P, E>>) -> Int = match rs.at(0) { Some(Ok({ x, y })) -> x + y, Some(Err({ why })) -> why.len(), None -> 0 }\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", source_text: source }],
    [b"Some", b"None", b"Ok", b"Err"],
    true,
  );
  assert_eq(out.len(), 6);
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(has(b"(intptr_t)(ply_words("), [false, false, false, false, false, false])
}

test "an `Option` of a pointer is a single word wherever it is stored, and no object is allocated for it" {
  let source = Bytes::concat_all([
    b"fn picked(c: Bool, s: String) -> Int = match if c { Some(s) } else { None } { Some(_) -> 1, None -> 0 }\n",
    b"fn found(xs: List<String>, i: Int) -> String = match xs.at(i) { Some(s) -> s, None -> \"\" }\n",
    b"fn nested(s: String) -> Int = match Some(Some(s)) { Some(Some(_)) -> 2, Some(None) -> 1, None -> 0 }\n",
    b"fn kept(s: String) -> Option<String> = Some(s)\n",
    b"fn held(s: String) -> List<Option<String>> = [Some(s), None]\n",
    b"fn same(a: String, b: String) -> Bool = Some(a) == Some(b)\n",
    b"fn either(c: Bool, s: String, o: Option<String>) -> Option<String> = if c { Some(s) } else { o }\n",
    b"fn guarded(xs: List<Int>) -> Int = match xs.at(0) { Some(n) if n > 1 -> n, Some(1) -> 10, _ -> 0 }\n",
    b"fn asked(o: Option<String>) -> Int = match kept(\"k\") { Some(_) -> 1, None -> 0 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [b"Some", b"None"], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(out.len(), 9);
  assert_eq(out.map(|e: EmittedRoot| e.text.index_of(b"ply_maybe_unrouted") != None), [
    false,
    false,
    false,
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  let none = [false, false, false, false, false, false, false, false, false];
  assert_eq(has(b"ply_alloc"), none);
  assert_eq(
    out.map(|e: EmittedRoot|
      e.tables.generics.calls.any(|g: GenericCall| g.callee == Named(b"std.prelude.List::at"))),
    none,
  );
  let maybe = { result: b"Word", params: [b"Word"] };
  assert_eq(out.get(3).tables.defined.map(|d: DefinitionSymbol| d.head), [maybe]);
  assert_eq(out.get(6).tables.defined.map(|d: DefinitionSymbol| d.head), [
    { result: b"Word", params: [b"int64_t", b"Word", b"Word"] },
  ]);
  assert_eq(
    named_prototypes(out.get(8).tables).filter(|e: NamedPrototype| e.callee == b"m.kept"),
    [{ callee: b"m.kept", head: maybe }],
  )
}

test "a `Result` is passed between functions as separate case and payload words with no allocation, even when its error is a five-field record" {
  let source = Bytes::concat_all([
    b"type Bad = { why: Bytes, a: Int, b: Int, c: Int, d: Int }\n",
    b"fn half(n: Int) -> Result<Int, Bad> = if n % 2 == 0 { Ok(n / 2) } else { Err({ why: b\"odd\", a: 0, b: 0, c: 0, d: 0 }) }\n",
    b"fn quarter(n: Int) -> Result<Int, Bad> = { let h = half(n)?; half(h) }\n",
    b"fn told(n: Int) -> Bytes = match quarter(n) { Ok(_) -> b\"\", Err(b) -> b.why }\n",
    b"fn plain(n: Int) -> Result<Int, Int> = if n > 0 { Ok(n) } else { Err(n) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [b"Ok", b"Err"], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(out.len(), 4);
  assert_eq(has(b"ply_alloc"), [false, false, false, false])
}

test "a `Result` with a small record as its error is passed between functions as its case tag plus the record's fields, not as an allocated value" {
  let source = Bytes::concat_all([
    b"type Bad = { why: Bytes }\n",
    b"fn half(n: Int) -> Result<Int, Bad> = if n % 2 == 0 { Ok(n / 2) } else { Err({ why: b\"odd\" }) }\n",
    b"fn quarter(n: Int) -> Result<Int, Bad> = { let h = half(n)?; half(h) }\n",
    b"fn told(n: Int) -> Bytes = match quarter(n) { Ok(_) -> b\"\", Err(b) -> b.why }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [b"Ok", b"Err"], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(out.len(), 3);
  assert_eq(has(b"rt_alloc_p"), [false, false, false]);
  assert_eq(has(b"o[0] = "), [true, true, false])
}

test "a record rebuilt from a captured record's fields reads them directly from the captured record, whether or not the lambda is inlined" {
  let source = Bytes::concat_all([
    b"type Sp = { start: Int, end: Int, gen: Int }\n",
    b"type C = { own: Int, node: Int, span: Sp }\n",
    b"fn rebuilt(c: C, n: Int) -> C = { let at = |k: Int| { own: 0, node: k, span: c.span }; at(n) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), 1)
}

test "records of a known type are compared field by field, not by the runtime" {
  let source = Bytes::concat_all([
    b"type R = { at: Int, value: Float, price: Decimal, on: Bool }\n",
    b"fn same(a: R, b: R) -> Bool = a == b\n",
    b"fn differ(a: R, b: R) -> Bool = a != b\n",
    b"fn noted(a: { at: Int, note: Option<Int> }, b: { at: Int, note: Option<Int> }) -> Bool = a == b\n",
    b"fn found(a: Option<R>, b: Option<R>) -> Bool = a == b\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [b"Some", b"None"], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(out.len(), 4);
  assert_eq(has(b"ply_dec_order("), [true, true, false, false]);
  assert_eq(
    out.map(|e: EmittedRoot|
      named_prototypes(e.tables).any(|x: NamedPrototype|
          x.callee.index_of(b"equal#Option<") != None)
        || e.tables.calls.any(|k: RootKey| printed(k).index_of(b"equal#Option<") != None)),
    [false, false, true, true],
  )
}

test "a value compared with a constructor of its sum is tested as a pattern tests it" {
  let source = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Num(Int, Float) | Eof\n",
    b"fn punct(k: TK, p: Bytes) -> Bool = k == Punct(p)\n",
    b"fn num(k: TK) -> Bool = k != Num(3, 0.5)\n",
    b"fn eof(k: TK) -> Bool = k == Eof\n",
    b"fn same(a: TK, b: TK) -> Bool = a == b\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", source_text: source }],
    [b"m.Punct", b"m.Num", b"m.Eof"],
    true,
  );
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(out.len(), 4);
  assert_eq(has(b"->layout"), [false, false, false, false]);
  assert_eq(has(b"memcmp(((unsigned char *)&ply_words("), [true, false, false, false]);
  assert_eq(has(symbol_of(b"m.TK#eq").concat(b"(ctx, ")), [false, false, false, true])
}

test "two values of a declared sum type are compared by a generated function built from the sum's constructors" {
  let source = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Num(Int, Float) | Pair(TK, TK) | Eof\n",
    b"fn same(a: TK, b: TK) -> Bool = a == b\n",
  ]);
  let results = outputs_at([b"m"], [source], [b"m.Punct", b"m.Num", b"m.Pair", b"m.Eof"], [
    Named(b"m.same"),
    test_generated_key(keys::Equal, NamedType({ name: b"m.TK", args: [] })),
  ]);
  let body = |name: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == name { Some(a) } else { accumulator }) {
      Some(a) -> a.result.text,
      None -> panic("no result"),
    };
  let eq = body(b"m.TK#eq");
  assert(eq.index_of(b"memcmp(((unsigned char *)&ply_words(") != None, None);
  assert(eq.index_of(own_symbol(None).concat(b"(ctx, ")) != None, None);
  assert_eq(eq.index_of(symbol_of(b"m.TK#eq")), None)
}

test "the compiler emits a type's generated drop, dup and copy functions, and the drop function for one boxed case, as ordinary functions" {
  let source = b"type TK = | Punct(Bytes) | Pair(TK, TK) | Eof\nfn keep(t: TK) -> TK = t\n";
  let tk = NamedType({ name: b"m.TK", args: [] });
  let wanted = [
    test_generated_key(keys::Drop, tk),
    test_generated_key(keys::Dup, tk),
    test_generated_key(keys::Copy, tk),
    test_generated_key(keys::OnCase({ operation: keys::Drop, case: 1 }), tk),
  ];
  let d = dump_of(analyse(parse_all(zip_sources([b"m"], [source]))));
  let walked = lowered_roots(
    [b"m"],
    [source],
    loaded_constructors(d, [b"m.Punct", b"m.Pair", b"m.Eof"]),
    wanted,
    [],
    [],
    d.embeds,
    d.rows,
    d.effects,
    d.inferred_facts,
  );
  let kind_of = |k: RootKey|
    match walked.roots.find(|f: Function| root_name(f.key) == root_name(k)) {
      Some(f) -> Ok(f.kind),
      None -> Err(b"not formed"),
    };
  assert_eq(wanted.map(kind_of), wanted.map(|_: RootKey| Ok(Plain)))
}

test "requesting only the generated `Keep` function for one boxed case returns that function, although its name has no module name in it" {
  let source = b"type TK = | Punct(Bytes) | Pair(TK, TK) | Eof\n";
  let keep_key = test_generated_key(
    keys::OnCase({ operation: keys::Keep, case: 1 }),
    NamedType({ name: b"m.TK", args: [] }),
  );
  let d = dump_of(analyse(parse_all(zip_sources([b"m"], [source]))));
  let results = emit_root_results(
    [b"m"],
    [source],
    loaded_constructors(d, [b"m.Punct", b"m.Pair", b"m.Eof"]),
    [keep_key],
    [],
    [],
    d.embeds,
    d.rows,
    d.effects,
    d.inferred_facts,
  );
  assert_eq(results.map(|a: RootOutput| { name: a.name, body: { true } }), [
    { name: root_name(keep_key), body: true },
  ])
}

test "a sum stored inside another sum, including inside `Option`, gets generated drop, share and keep functions" {
  let source = Bytes::concat_all([
    b"type Reply = | Done | Text(String)\n",
    b"type Todo = | Hello | Bye | Respond(Reply)\n",
    b"type Hue = | Red | Blue\n",
    b"fn said(t: Todo) -> Int = match t { Respond(Text(s)) -> s.len(), _ -> 0 }\n",
    b"fn maybe(r: Option<Reply>) -> Int = match r { Some(Text(s)) -> s.len(), _ -> 0 }\n",
    b"fn hue(h: Option<Hue>) -> Int = match h { Some(Blue) -> 1, _ -> 0 }\n",
  ]);
  let named = |n: Bytes| NamedType({ name: n, args: [] });
  let todo = named(b"m.Todo");
  let reply = named(b"m.Reply");
  let maybe = option_type(reply);
  let hues = option_type(named(b"m.Hue"));
  let walks = [keys::Drop, keys::Share, keys::Keep];
  let wanted = walks.map(|operation: TypeOperation| test_generated_key(operation, todo)).concat(
    walks.map(|operation: TypeOperation| test_generated_key(operation, maybe)),
  ).concat(
    [b"m.said", b"m.maybe", b"m.hue"].map(Named),
  );
  let results = outputs_at(
    [b"m"],
    [source],
    [
      b"m.Done",
      b"m.Text",
      b"m.Hello",
      b"m.Bye",
      b"m.Respond",
      b"m.Red",
      b"m.Blue",
      b"None",
      b"Some",
    ],
    wanted,
  );
  let text = |k: RootKey|
    match results.find(|a: RootOutput| a.name == root_name(k)) {
      Some(a) -> body_code(a.result.text),
      None -> b"no result",
    };
  assert_eq(wanted.filter(|k: RootKey| text(k) == b"no result").map(root_name), []);
  [todo, maybe].fold((), |_: Unit, t: Type|
    assert_eq(
      [keys::Share, keys::Keep].map(|operation: TypeOperation|
        text(test_generated_key(operation, t)).index_of(
            symbol_of(printed(test_generated_key(operation, reply))),
          )
          != None),
      [true, true],
    ));
  assert_eq(
    match results.find(|a: RootOutput| a.name == root_name(Named(b"m.hue"))) {
      Some(a) ->
        a.result.tables.calls.filter(|k: RootKey|
          match k { Generated(w, _) -> w.ty == hues, _ -> false }),
      None -> [test_generated_key(keys::Drop, hues)],
    },
    [],
  )
}

test "a `match` over a sum with many cases emits no chain of ternaries, and its C code grows only with the number of cases" {
  let source = |n: Int|
    Bytes::concat_all([
      b"type Big = ",
      Bytes::join(
        range(0, n).map(|k: Int| Bytes::concat_all([b"| K", ascii_of_int(k), b"(Int, String)"])),
        b" ",
      ),
      b"\ntype Hue = ",
      Bytes::join(range(0, n).map(|k: Int| b"| H".concat(ascii_of_int(k))), b" "),
      b"\nfn big(b: Big) -> Int = match b { K0(n, _) -> n, _ -> 0 }\n",
      b"fn both(b: Big) -> (Big, Big) = (b, b)\n",
      b"fn hue(h: Hue) -> Int = match h { ",
      Bytes::join(
        range(0, n).map(|k: Int|
          Bytes::concat_all([b"H", ascii_of_int(k), b" -> ", ascii_of_int(k)])),
        b", ",
      ),
      b" }\n",
    ]);
  let names = |n: Int|
    range(0, n).map(|k: Int| b"m.K".concat(ascii_of_int(k))).concat(
      range(0, n).map(|k: Int| b"m.H".concat(ascii_of_int(k))),
    );
  let counted = root_of(keys::Unboxed(keys::Dup), NamedType({ name: b"m.Big", args: [] }));
  let counted_name = root_text(root_name(counted));
  let code = |n: Int|
    emit_all_program([{ name: b"m", source_text: source(n) }], names(n), true).map(
      |e: EmittedRoot| { name: emitted_name(e), text: body_code(e.text) },
    ).push({
      name: counted_name,
      text: body_code(
        output_body(outputs_at([b"m"], [source(n)], names(n), [counted]), counted_name).text,
      ),
    });
  let fifty = code(50);
  assert_eq(
    fifty.filter(|e: { name: Bytes, text: Bytes }| e.text.index_of(b" ? ") != None).map(
      |e: { name: Bytes, text: Bytes }| e.name,
    ),
    [],
  );
  let called = symbol_of(counted_name).concat(b"(ctx, ");
  assert(
    fifty.any(|e: { name: Bytes, text: Bytes }|
        e.name == counted_name && e.text.index_of(b"switch (") != None)
      && fifty.any(|e: { name: Bytes, text: Bytes }|
        e.name == b"m.both" && e.text.index_of(called) != None),
    None,
  );
  let size = |es: List<{ name: Bytes, text: Bytes }>|
    es.fold(0, |n: Int, e: { name: Bytes, text: Bytes }| n + e.text.len());
  assert(size(fifty) * 10 <= size(code(25)) * 22, None)
}

test "a generic function that compares its type argument is emitted again for each type it is used with" {
  let source = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Eof\n",
    b"fn same<a>(x: a, y: a) -> Bool = x == y\n",
    b"fn order<a>(x: a, y: a) -> Ordering where derivable(ord, a) = compare(x, y)\n",
    b"fn tokens(k: TK) -> Bool = same(k, Eof)\n",
    b"fn texts(s: String) -> Bool = same(s, \"x\")\n",
  ]);
  let results = outputs_at(
    [b"m"],
    [source],
    [b"m.Punct", b"m.Eof", b"Less", b"Equal", b"Greater"],
    [
      Named(b"m.same"),
      Named(b"m.order"),
      Named(b"m.tokens"),
      specialised_at(b"m.same", [b"m.TK"]),
      specialised_at(b"m.same", [b"String"]),
      specialised_at(b"m.order", [b"m.TK"]),
    ],
  );
  let tables = |name: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == name { Some(a) } else { accumulator }) {
      Some(a) -> a.result,
      None -> panic("no result"),
    };
  let has = |name: Bytes, text: Bytes| tables(name).text.index_of(text) != None;
  assert_eq(tables(b"m.same").tables.generics.needs, [{ var: 0, reads: Exact }]);
  assert_eq(tables(b"m.order").tables.generics.needs, [{ var: 0, reads: Exact }]);
  assert_eq(tables(b"m.tokens").tables.generics.calls, [
    {
      callee: Named(b"m.same"),
      args: parsed_types([b"m.TK"]),
      specialised_variables: [0],
      functions: [],
      effect_evidence: [],
    },
  ]);
  assert_eq(tables(b"m.same").text, b"");
  assert_eq(tables(b"m.order").text, b"");
  assert(has(b"m.same@m.TK", symbol_of(b"m.TK#eq")));
  assert(has(b"m.same@String", b"memcmp(((unsigned char *)&ply_words("));
  assert(has(b"m.order@m.TK", symbol_of(b"m.TK#cmp")))
}

test "two values of a declared sum type are ordered by a generated function built from the sum's constructors" {
  let source = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Num(Int, Bytes) | Pair(TK, TK) | Eof\n",
    b"fn order(a: TK, b: TK) -> Ordering = compare(a, b)\n",
  ]);
  let results = outputs_at(
    [b"m"],
    [source],
    [b"m.Punct", b"m.Num", b"m.Pair", b"m.Eof", b"Less", b"Equal", b"Greater"],
    [Named(b"m.order"), test_generated_key(Order, NamedType({ name: b"m.TK", args: [] }))],
  );
  let body = |name: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == name { Some(a) } else { accumulator }) {
      Some(a) -> a.result.text,
      None -> panic("no result"),
    };
  let comparison = body(b"m.TK#cmp");
  assert(comparison.index_of(b"builtin_compare") == None, None);
  assert(comparison.index_of(b"memcmp(((unsigned char *)&ply_words(") != None, None);
  assert(comparison.index_of(own_symbol(None).concat(b"(ctx, ")) != None, None);
  assert(body(b"m.order").index_of(symbol_of(b"m.TK#cmp").concat(b"(ctx, ")) != None, None)
}

test "generated functions for ordering and reflection call the language's builtins, even if the module defines functions of the same names" {
  let module_source = Bytes::concat_all([
    b"import std.value (Value)\n",
    b"type TK = | Num(Int) | Pair(TK, TK) | Eof\n",
    b"type Named = | Named(Int)\n",
    b"show for Named by shown\n",
    b"fn shown(n: Named) -> String = \"n\"\n",
    b"fn compare<a>(x: a, y: a) -> Ordering = Greater\n",
    b"fn reflect<a>(x: a) -> Int = 0\n",
  ]);
  let tk = NamedType({ name: b"m.TK", args: [] });
  let roots = [
    test_generated_key(Order, tk),
    test_generated_key(Reflect, tk),
    test_generated_key(Show, NamedType({ name: b"m.Named", args: [] })),
  ];
  let named = printed(test_generated_key(Show, NamedType({ name: b"m.Named", args: [] })));
  let results = outputs_at(
    [b"m"],
    [module_source],
    [
      b"m.Num",
      b"m.Pair",
      b"m.Eof",
      b"m.Named",
      b"Less",
      b"Equal",
      b"Greater",
      b"std.value.VUnit",
      b"std.value.VInt",
      b"std.value.VCtor",
      b"std.value.VShown",
    ],
    roots,
    shipped: [value_fixture],
  );
  let tables = |root: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == root { Some(a) } else { accumulator }) {
      Some(a) -> a.result.tables,
      None -> panic("no result"),
    };
  [printed(test_generated_key(Order, tk)), printed(test_generated_key(Reflect, tk))].fold(
    (),
    |_: Unit, root: Bytes| {
      assert_eq(tables(root).generics.calls.map(|g: GenericCall| g.callee), []);
      assert(
        !tables(root).calls.contains(Named(b"m.compare"))
          && !tables(root).calls.contains(Named(b"m.reflect")),
        None,
      )
    },
  );
  assert(tables(named).calls.contains(Named(b"m.shown")), None)
}

test "a generic sum's constructor fields get their concrete types by substituting the sum's type arguments" {
  let d = dump_of(
    analyse(parse_all(zip_sources([b"m"], [b"type P<a, b> = | L(a) | R(b, a) | N\n"]))),
  );
  let int = int_type;
  let text = string_type;
  let at = |name: Bytes|
    match constructor_sums(d.constructors).get(name) {
      Some(cs) ->
        cs.map(|c: SumConstructor| c.fields.map(|f: Type| at_args(f, c.params, [int, text]))),
      None -> [],
    };
  assert_eq(at(b"Result"), [[int], [text]]);
  assert_eq(at(b"m.P"), [[int], [text, int], []])
}

test "`reflect` converts a scalar to a `std.value` constructor such as `VInt`, and converts a sum or record with a generated function" {
  let module_source = Bytes::concat_all([
    b"import std.value (reflect, shown)\n",
    b"type TK = | Punct(Bytes) | Num(Int, U8) | Pair(TK, TK) | Eof\n",
    b"type Dated = | Dated(Int)\n",
    b"show for Dated by dated\n",
    b"fn dated(d: Dated) -> String = \"d\"\n",
    b"fn same(t: TK) -> Bool = reflect(t) == reflect(t)\n",
    b"fn held(p: { a: Int, b: TK }) -> Bool = reflect(p) == reflect(p)\n",
    b"fn told(d: Dated) -> Bool = shown(d) == shown(d)\n",
    b"fn maybe(o: Option<TK>) -> Bool = reflect(o) == reflect(o)\n",
  ]);
  let values = [
    b"VUnit",
    b"VBool",
    b"VInt",
    b"VStr",
    b"VBytes",
    b"VRecord",
    b"VCtor",
    b"VFixed",
    b"VShown",
  ].map(|v: Bytes| b"std.value.".concat(v));
  let written = [
    test_generated_key(Reflect, NamedType({ name: b"m.TK", args: [] })),
    test_generated_key(
      Reflect,
      RecordType([
        { name: b"a", ty: int_type },
        { name: b"b", ty: NamedType({ name: b"m.TK", args: [] }) },
      ]),
    ),
    test_generated_key(Show, NamedType({ name: b"m.Dated", args: [] })),
    test_generated_key(Reflect, option_type(NamedType({ name: b"m.TK", args: [] }))),
  ];
  let sum = printed(written.get(0));
  let record = printed(written.get(1));
  let show_root = printed(written.get(2));
  let maybe = printed(written.get(3));
  assert_eq([sum, record, show_root], [
    b"m.reflect#m.TK",
    b"m.reflect#{a:Int,b:m.TK}",
    b"m.shown#m.Dated",
  ]);
  let results = outputs_at(
    [b"m"],
    [module_source],
    [b"m.Punct", b"m.Num", b"m.Pair", b"m.Eof", b"m.Dated"].concat(values),
    [b"m.same", b"m.held", b"m.told", b"m.maybe"].map(Named).concat(written),
    shipped: [value_fixture],
  );
  let body = |name: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == name { Some(a) } else { accumulator }) {
      Some(a) -> a.result.text,
      None -> panic("no result"),
    };
  let calls = |name: Bytes, root: Bytes|
    body(name).index_of(symbol_of(root).concat(b"(ctx, ")) != None;
  assert(calls(b"m.same", sum));
  assert(calls(b"m.held", record));
  assert(calls(b"m.told", show_root));
  assert(body(sum).index_of(b"builtin_reflect") == None, None);
  assert(body(sum).index_of(own_symbol(None).concat(b"(ctx, ")) != None, None);
  [sum, record, show_root].fold((), |_: Unit, n: Bytes|
    assert(body(n).index_of(b"@@T") == None, None));
  assert(calls(record, sum));
  let tables = |name: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == name { Some(a) } else { accumulator }) {
      Some(a) -> a.result.tables,
      None -> no_tables,
    };
  assert(calls(b"m.maybe", maybe));
  let expected = named_prototypes(tables(b"m.maybe")).filter(|x: NamedPrototype| x.callee == maybe);
  assert(expected.len() > 0, None);
  assert_eq(
    expected.map(|x: NamedPrototype| x.head).at(0),
    tables(maybe).defined.map(|d: DefinitionSymbol| d.head).at(0),
  );
  assert(calls(show_root, b"m.dated"))
}

test "`digest` of a value calls a generated function for its type, which encodes each part with the function for that part's type" {
  let module_source = Bytes::concat_all([
    b"type TK = | Punct(Bytes) | Pair(TK, TK) | Eof\n",
    b"type Money = | Money(Int, Bytes)\n",
    b"key for Money by cents\n",
    b"fn cents(m: Money) -> Int = match m { Money(c, _) -> c }\n",
    b"fn hashed(t: TK) -> Bytes = digest(t)\n",
    b"fn held(p: { a: Int, b: TK }) -> Bytes = digest(p)\n",
    b"fn priced(m: Money) -> Bytes = digest(m)\n",
  ]);
  let written = [
    test_generated_key(Digest, NamedType({ name: b"m.TK", args: [] })),
    test_generated_key(
      Digest,
      RecordType([
        { name: b"a", ty: int_type },
        { name: b"b", ty: NamedType({ name: b"m.TK", args: [] }) },
      ]),
    ),
    test_generated_key(Digest, NamedType({ name: b"m.Money", args: [] })),
  ];
  let sum = printed(written.get(0));
  let record = printed(written.get(1));
  let keyed = printed(written.get(2));
  let results = outputs_at(
    [b"m"],
    [module_source],
    [b"m.Punct", b"m.Pair", b"m.Eof", b"m.Money"],
    [b"m.hashed", b"m.held", b"m.priced"].map(Named).concat(written),
  );
  let body = |name: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == name { Some(a) } else { accumulator }) {
      Some(a) -> a.result,
      None -> panic("no result"),
    };
  let has = |name: Bytes, text: Bytes| body(name).text.index_of(text) != None;
  [
    { at: b"m.hashed", root: sum },
    { at: b"m.held", root: record },
    { at: b"m.priced", root: keyed },
  ].fold((), |_: Unit, c: { at: Bytes, root: Bytes }| {
    assert(has(c.at, symbol_of(c.root).concat(b"(ctx, ")), None);
    assert(has(c.at, b"builtin_elaborated_blake3_p"), None);
    assert(!has(c.at, b"builtin_digest_p"), None)
  });
  assert(has(sum, b"ply_text_encoded(") && !has(sum, b"builtin_elaborated_encoded_p"), None);
  assert(has(record, b"ply_scalar_encoded("), None);
  assert(has(sum, own_symbol(None).concat(b"(ctx, ")), None);
  assert(has(record, symbol_of(sum).concat(b"(ctx, ")), None);
  assert(body(keyed).tables.calls.contains(Named(b"m.cents")), None)
}

const typed_fixture: Bytes =
  Bytes::concat_all([
    b"import std.value (Value, reflect, shown)\n",
    b"type Shape = | Circle(Int) | Rect({ w: Int, h: U8 }) | Nothing\n",
    b"type Tree<a> = | Leaf(a) | Node(Tree<a>, Tree<a>)\n",
    b"type Stamp = | Stamp(Int)\n",
    b"show for Stamp by stamped\n",
    b"fn stamped(s: Stamp) -> String = \"s\"\n",
    b"type Name = | Name(String)\n",
    b"key for Name by folded\n",
    b"fn folded(n: Name) -> String = match n { Name(s) -> s }\n",
    b"type Point = new { x: Int, y: U8 }\n",
    b"fn gr<a>(x: a) -> Value = reflect(x)\n",
    b"fn gs<a>(x: a) -> Value = shown(x)\n",
    b"fn gc<a>(x: a, y: a) -> Ordering where derivable(ord, a) = compare(x, y)\n",
    b"fn gd<a>(x: a) -> Bytes where derivable(hash, a) = digest(x)\n",
  ])

fn outputs_reachable_from(
  definitions: Bytes,
  start: List<RootKey>,
) -> List<RootOutput> / {abort.raise} = {
  let module_source = typed_fixture.concat(definitions);
  let shipped = [value_fixture];
  let analysed = analyse_pulling_std_with(
    zip_sources([b"m"], [module_source]),
    shipped,
    no_rows,
  ).out;
  match analysed {
    emitter_input::Rejected(diagnostics) ->
      panic(String::of_bytes_lossy(diagnostics_text(diagnostics))),
    _ -> (),
  };
  let d = dump_of(analysed);
  let given = shipped.push({ name: b"m", source_text: module_source });
  let s = scope_of(
    given,
    loaded_constructors(d, []),
    true,
    start,
    [],
    [],
    d.embeds,
    d.rows,
    d.effects,
    d.inferred_facts,
  );
  iterate(
    { results: [], next: start },
    64,
    |w: { results: List<RootOutput>, next: List<RootKey> }|
      if w.next.len() == 0 { Stop(w.results) } else {
        let all = w.results.concat(root_outputs(s, w.next, Map::new()));
        let emitted_names = all.map(|a: RootOutput| a.name);
        Continue({
          results: all,
          next: all.fold([], |accumulator: List<RootKey>, a: RootOutput|
            a.result.tables.calls.fold(accumulator, |more: List<RootKey>, c: RootKey|
              match c {
                Generated(_, _) -> if emitted_names.contains(root_name(c)) || more.contains(c) {
                  more
                } else { more.push(c) },
                _ -> more,
              })),
        })
      },
  )
}

test "`compare`, `reflect`, `show` and `digest` are generated for every concrete type, and none of them is a runtime builtin" {
  let both = [
    b"Int",
    b"Bool",
    b"Char",
    b"String",
    b"Bytes",
    b"Unit",
    b"Decimal",
    b"U8",
    b"I64",
    b"U128",
    b"Ordering",
    b"Shape",
    b"Tree<Int>",
    b"Stamp",
    b"Name",
    b"Point",
    b"{}",
    b"{ a: Int, b: Shape }",
    b"List<Shape>",
    b"Array<Point>",
    b"Map<String, List<Name>>",
    b"Columns<{ x: Int, y: Bool }>",
    b"Option<Shape>",
    b"Result<Int, String>",
    b"Tree<{ s: List<Name>, t: Option<Tree<U8>> }>",
  ];
  let all = both.concat([
    b"Float",
    b"keep (Int) -> Int",
    b"Secret<String>",
    b"{ f: Float, g: List<Float> }",
  ]);
  let functions = |i: Int|
    if i < both.len() { [b"c", b"v", b"d", b"r", b"s"] } else { [b"r", b"s"] };
  let definitions = Bytes::concat_all(
    range(0, all.len()).map(|i: Int| {
      let t = all.get(i);
      let n = ascii_of_int(i);
      let one = |f: Bytes, result: Bytes, call: Bytes|
        Bytes::concat_all([b"fn ", f, n, b"(a: ", t, b") -> ", result, b" = ", call, b"(a)\n"]);
      let two = |f: Bytes, call: Bytes|
        Bytes::concat_all([
          b"fn ",
          f,
          n,
          b"(a: ",
          t,
          b", b: ",
          t,
          b") -> Ordering = ",
          call,
          b"(a, b)\n",
        ]);
      let reflected = one(b"r", b"Value", b"reflect").concat(one(b"s", b"Value", b"shown"));
      if i < both.len() {
        Bytes::concat_all([
          two(b"c", b"compare"),
          two(b"v", b"compare_values"),
          one(b"d", b"Bytes", b"digest"),
          reflected,
        ])
      } else { reflected }
    }),
  );
  let named = range(0, all.len()).fold([], |accumulator: List<Bytes>, i: Int|
    accumulator.concat(
      functions(i).map(|f: Bytes| Bytes::concat_all([b"m.", f, ascii_of_int(i)])),
    ));
  let resolved = [b"{a:Int,b:m.Shape}", b"List<m.Shape>", b"m.Tree<Int>"].fold(
    [],
    |accumulator: List<RootKey>, t: Bytes|
      accumulator.concat(
        [b"m.gr", b"m.gs", b"m.gc", b"m.gd"].map(|g: Bytes| specialised_at(g, [t])),
      ),
  );
  let order_roots = [
    float_type,
    RecordType([{ name: b"f", ty: float_type }, { name: b"n", ty: int_type }]),
    list_type(float_type),
    unit_type,
    RecordType([]),
  ].map(|t: Type| test_generated_key(Order, t));
  let results = outputs_reachable_from(
    definitions,
    named.map(Named).concat([b"m.gr", b"m.gs", b"m.gc", b"m.gd"].map(Named)).concat(
      resolved,
    ).concat(
      order_roots,
    ),
  );
  assert_eq(results.fold([], |accumulator: List<Bytes>, a: RootOutput| { accumulator }), []);
  let columns = columns_type(
    RecordType([{ name: b"x", ty: int_type }, { name: b"y", ty: bool_type }]),
  );
  let names = results.map(output_name);
  assert_eq(
    [
      test_generated_key(Reflect, columns),
      test_generated_key(Show, columns),
      test_generated_key(Digest, columns),
    ].map(
      printed,
    ).filter(|n: Bytes| !names.contains(n)),
    [],
  )
}

test "code is emitted for `Ok(x) == Ok(y)` where `x` and `y` are wide records that contain other records" {
  let ints = |p: Bytes, n: Int|
    Bytes::join(range(0, n).map(|i: Int| Bytes::concat_all([p, ascii_of_int(i), b": Int"])), b", ");
  let module_source = Bytes::concat_all([
    b"type Inner = { ",
    ints(b"i", 10),
    b", names: List<Bytes> }\n",
    b"type Wide = { context: Inner, shape: Inner, ",
    ints(b"w", 10),
    b", order: List<Bytes> }\n",
    b"fn ok_ok(x: Wide, y: Wide) -> Bool = Ok(x) == Ok(y)\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: module_source }], [], true);
  assert(out.len() > 0, None)
}

test "a sum with a `key for` function is compared and ordered by that key through generated functions, generic or not" {
  let module_source = Bytes::concat_all([
    b"type Name = | Name(String)\n",
    b"key for Name by folded\n",
    b"fn folded(n: Name) -> String = match n { Name(s) -> s }\n",
    b"type Bag<a> = | Bag(List<a>)\n",
    b"key for Bag by items\n",
    b"fn items<a>(b: Bag<a>) -> List<a> = match b { Bag(xs) -> xs }\n",
    b"fn same(a: Name, b: Name) -> Bool = a == b\n",
    b"fn ordered(a: Name, b: Name) -> Ordering = compare(a, b)\n",
    b"fn bags(a: Bag<Int>, b: Bag<Int>) -> Bool = a == b\n",
    b"fn top(a: Name, b: Name) -> Name = max(a, b)\n",
  ]);
  let name = NamedType({ name: b"m.Name", args: [] });
  let bag = NamedType({ name: b"m.Bag", args: [int_type] });
  let roots = [
    test_generated_key(keys::Equal, name),
    test_generated_key(Order, name),
    test_generated_key(keys::Equal, bag),
  ];
  let results = outputs_at(
    [b"m"],
    [module_source],
    [b"m.Name", b"m.Bag"],
    [b"m.same", b"m.ordered", b"m.bags", b"m.top"].map(Named).concat(roots),
  );
  let body = |name: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == name { Some(a) } else { accumulator }) {
      Some(a) -> a.result,
      None -> panic(String::of_bytes_lossy(b"no result for ".concat(name))),
    };
  [
    { at: b"m.same", root: roots.get(0) },
    { at: b"m.ordered", root: roots.get(1) },
    { at: b"m.bags", root: roots.get(2) },
    { at: b"m.top", root: roots.get(1) },
  ].fold((), |_: Unit, c: { at: Bytes, root: RootKey }| {
    assert(body(c.at).tables.calls.contains(c.root), Some(String::of_bytes_lossy(c.at)))
  });
  assert(body(printed(roots.get(0))).tables.calls.contains(Named(b"m.folded")), None);
  assert(body(printed(roots.get(1))).tables.calls.contains(Named(b"m.folded")), None)
}

test "a type's `numeric for` functions are called through generated functions, and a generic function using them is specialised for that type" {
  let module_source = Bytes::concat_all([
    b"type Length = | Metres(Int) | Millimetres(Int)\n",
    b"key for Length by millimetres\n",
    b"numeric for Length by { add: plus, sub: minus, mul: times, neg: negated, of_int: metres }\n",
    b"fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }\n",
    b"fn plus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) + millimetres(b))\n",
    b"fn minus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) - millimetres(b))\n",
    b"fn times(a: Length, b: Length) -> Length = Millimetres(millimetres(a) * millimetres(b))\n",
    b"fn negated(a: Length) -> Length = Millimetres(0 - millimetres(a))\n",
    b"fn metres(n: Int) -> Length = Metres(n)\n",
    b"fn grown(a: Length, b: Length) -> Length = -(a + b)\n",
    b"fn shorter(a: Length, b: Length) -> Bool = a < b\n",
    b"fn total<a>(xs: List<a>) -> a where numeric(a) = xs.fold(numeric_of_int(0), |s: a, x: a| s + x)\n",
    b"fn all(xs: List<Length>) -> Length = total(xs)\n",
  ]);
  let length = NamedType({ name: b"m.Length", args: [] });
  let add = test_generated_key(keys::NumericFunction(b"add"), length);
  let neg = test_generated_key(keys::NumericFunction(b"neg"), length);
  let of_int = test_generated_key(keys::NumericFunction(b"of_int"), length);
  let at_length = specialised_at(b"m.total", [b"m.Length"]);
  let results = outputs_at([b"m"], [module_source], [b"m.Length"], [
    Named(b"m.grown"),
    Named(b"m.shorter"),
    Named(b"m.all"),
    Named(b"m.total"),
    at_length,
    add,
    neg,
    of_int,
    test_generated_key(Order, length),
  ]);
  let body = |name: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == name { Some(a) } else { accumulator }) {
      Some(a) -> a.result,
      None -> panic(String::of_bytes_lossy(b"no result for ".concat(name))),
    };
  let unasked = |name: Bytes|
    assert(body(name).text.index_of(b"rt_binary_p") == None, Some(String::of_bytes_lossy(name)));
  assert(body(b"m.grown").tables.calls.contains(add), None);
  assert(body(b"m.grown").tables.calls.contains(neg), None);
  assert(body(printed(add)).tables.calls.contains(Named(b"m.plus")), None);
  assert(body(printed(neg)).tables.calls.contains(Named(b"m.negated")), None);
  assert(body(printed(of_int)).tables.calls.contains(Named(b"m.metres")), None);
  let grown = body(b"m.grown").tables;
  [add, neg].fold((), |_: Unit, k: RootKey| {
    let at = range(0, grown.calls.len()).find(|i: Int| grown.calls.get(i) == k);
    let wrote = grown.generics.expects.filter(|e: ExpectedPrototype|
      Some(e.callee) == at.map(CallAt));
    assert_eq(
      wrote.map(|e: ExpectedPrototype| e.head),
      body(printed(k)).tables.defined.map(|d: DefinitionSymbol| d.head),
    )
  });
  assert(body(b"m.shorter").tables.calls.contains(test_generated_key(Order, length)), None);
  assert(body(b"m.total").tables.generics.needs.contains({ var: 0, reads: Scalar }), None);
  assert(body(printed(at_length)).text.index_of(b"numeric_binary") == None, None);
  [b"m.grown", b"m.shorter", printed(at_length)].fold((), |_: Unit, n: Bytes| unasked(n))
}

test "a generic function from another module is specialised for a type whose module defines its `numeric for` functions" {
  let generic = Bytes::concat_all([
    b"pub fn sign<a>(n: a) -> Int where numeric(a) = {\n",
    b"  let zero: a = numeric_of_int(0);\n",
    b"  if n > zero { 1 } else if n < zero { 0 - 1 } else { 0 }\n",
    b"}\n",
  ]);
  let module_source = Bytes::concat_all([
    b"import g\n",
    b"type Length = | Metres(Int) | Millimetres(Int)\n",
    b"key for Length by millimetres\n",
    b"numeric for Length by { add: plus, sub: minus, mul: times, neg: negated, of_int: metres }\n",
    b"fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }\n",
    b"fn plus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) + millimetres(b))\n",
    b"fn minus(a: Length, b: Length) -> Length = Millimetres(millimetres(a) - millimetres(b))\n",
    b"fn times(a: Length, b: Length) -> Length = Millimetres(millimetres(a) * millimetres(b))\n",
    b"fn negated(a: Length) -> Length = Millimetres(0 - millimetres(a))\n",
    b"fn metres(n: Int) -> Length = Metres(n)\n",
    b"fn signed(l: Length) -> Int = g::sign(l)\n",
  ]);
  let at = specialised_at(b"g.sign", [b"m.Length"]);
  let results = outputs_at([b"g", b"m"], [generic, module_source], [b"m.Length"], [
    Named(b"m.signed"),
    at,
  ]);
  match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
      if output_name(a) == printed(at) { Some(a) } else { accumulator }) {
    Some(a) ->
      assert(
        a.result.text.index_of(b"numeric_binary") == None,
        Some(String::of_bytes_lossy(a.result.text)),
      ),
    None -> panic("no result for the specialisation"),
  }
}

test "`assert_eq` compares with the same function as `==`, and only when the values differ passes both values' bytes to the runtime, calling no builtin" {
  let module_source = Bytes::concat_all([
    b"type Name = | Name(String)\n",
    b"key for Name by folded\n",
    b"fn folded(n: Name) -> String = match n { Name(s) -> s }\n",
    b"fn same(a: Name, b: Name) -> Unit / {abort.raise} = assert_eq(a, b)\n",
    b"fn either<a>(x: a, y: a) -> Unit / {abort.raise} = assert_eq(x, y)\n",
    b"fn names(a: Name, b: Name) -> Unit / {abort.raise} = either(a, b)\n",
  ]);
  let name = NamedType({ name: b"m.Name", args: [] });
  let at_name = specialised_at(b"m.either", [b"m.Name"]);
  let results = outputs_at([b"m"], [module_source], [b"m.Name"], [
    Named(b"m.same"),
    Named(b"m.names"),
    at_name,
    test_generated_key(keys::Equal, name),
  ]);
  let body = |n: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == n { Some(a) } else { accumulator }) {
      Some(a) -> a.result,
      None -> panic(String::of_bytes_lossy(b"no result for ".concat(n))),
    };
  [b"m.same", printed(at_name)].fold((), |_: Unit, n: Bytes| {
    let failure_message = Some(String::of_bytes_lossy(n));
    assert(body(n).tables.calls.contains(test_generated_key(keys::Equal, name)), failure_message);
    assert_eq(
      [b"builtin_elaborated_shown_open_p(", b"ply_assert_failed("].map(|c: Bytes|
        body(n).text.index_of(c) != None),
      [true, true],
    )
  })
}

test "a generic sum is shown by the `show for` function its module defines, called with the sum's type arguments" {
  let module_source = Bytes::concat_all([
    b"import std.value (Value)\n",
    b"pub type Deque<a> = | Deque(List<a>, List<a>)\n",
    b"show for Deque by written\n",
    b"pub fn written<a>(d: Deque<a>) -> String = match d { Deque(front, _) -> \"deque\" }\n",
  ]);
  let key = test_generated_key(Show, NamedType({ name: b"m.Deque", args: [int_type] }));
  let results = outputs_at(
    [b"m"],
    [module_source],
    [b"m.Deque", b"std.value.VShown"],
    [key],
    shipped: [value_fixture],
  );
  let body = match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
      if a.name == root_name(key) { Some(a) } else { accumulator }) {
    Some(a) -> a.result,
    None -> panic("no result"),
  };
  assert_eq(body.tables.generics.calls.map(|g: GenericCall| { callee: g.callee, args: g.args }), [
    { callee: Named(b"m.written"), args: [int_type] },
  ])
}

test "`digest` of a generic sum with a `key for` function digests the key, which that function returns for the sum's type arguments" {
  let module_source = Bytes::concat_all([
    b"pub type Deque<a> = | Deque(List<a>, List<a>)\n",
    b"key for Deque by to_list\n",
    b"pub fn to_list<a>(d: Deque<a>) -> List<a> = match d { Deque(front, _) -> front }\n",
    b"fn hashed(d: Deque<Int>) -> Bytes = digest(d)\n",
  ]);
  let key = test_generated_key(Digest, NamedType({ name: b"m.Deque", args: [int_type] }));
  let results = outputs_at([b"m"], [module_source], [b"m.Deque"], [Named(b"m.hashed"), key]);
  let body = match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
      if a.name == root_name(key) { Some(a) } else { accumulator }) {
    Some(a) -> a.result,
    None -> panic("no result"),
  };
  assert(!body.tables.calls.contains(key), None);
  assert_eq(body.tables.generics.calls.map(|g: GenericCall| { callee: g.callee, args: g.args }), [
    { callee: Named(b"m.to_list"), args: [int_type] },
  ]);
  assert(
    body.text.index_of(b"builtin_elaborated_encoded_p") == None,
    Some(String::of_bytes_lossy(body.text)),
  )
}

test "updating a boxed record writes only the fields it sets, in place or in a copy" {
  let fields = bytes_join(
    range(0, 40).map(|k: Int| Bytes::concat_all([b"f", ascii_of_int(k + 10), b": Int"])),
    b", ",
  );
  let module_source = Bytes::concat_all([
    b"type Wide = { ",
    fields,
    b", tag: String }\n",
    b"fn tagged(w: Wide, t: String) -> Wide = { ..w, tag: t }\n",
    b"fn bumped(w: Wide) -> Wide = { ..w, f10: w.f10 + 1, f49: 0 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: module_source }], [], true);
  assert_eq(out.len(), 2);
  let writes = |text: Bytes| text.split(b"] = ").len() - 1;
  assert_eq(
    out.map(|e: EmittedRoot| {
      let own = body_code(e.text);
      [own.index_of(b"->rc == 1") != None, own.index_of(b"_copy_") != None, writes(own) <= 2]
    }),
    [[true, true, true], [true, true, true]],
  );
  assert_eq(
    out.map(|e: EmittedRoot| {
      let own = body_code(e.text);
      own.split(b"memcpy(").len() == 2 && own.index_of(b"if (d) { { Word ply_s = ") != None
    }),
    [true, true],
  );
  assert(body_code(out.get(0).text).index_of(b")[40] = ") != None, None)
}

test "the generated function that `String.split` uses builds a string by setting its length and capacity fields in the emitted code" {
  let module_source = b"fn parts(s: String) -> List<String> / {abort.raise} = s.split(\",\")\n";
  let written = [test_generated_key(ContainerWalk(b"split_from"), string_type)];
  let results = outputs_at([b"m"], [module_source], [], [Named(b"m.parts")].concat(written));
  let made = written.map(|k: RootKey|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if a.name == root_name(k) { Some(a) } else { accumulator }) {
      Some(a) -> [b"))->len = ", b"))->room = "].map(|f: Bytes| a.result.text.index_of(f) != None),
      None -> panic("no result"),
    });
  assert_eq(made, [[true, true]])
}

test "creating an array, setting an element and converting a list to an array use the memory layout of the element type" {
  let module_source = Bytes::concat_all([
    b"type R = { name: Bytes, n: Int }\n",
    b"fn made(n: Int, r: R) -> Array<R> / {abort.raise} = Array::new(n, r)\n",
    b"fn put(xs: Array<R>, i: Int, r: R) -> Array<R> / {abort.raise} = xs.set(i, r)\n",
    b"fn listed(xs: List<Int>) -> Array<Int> = Array::of_list(xs)\n",
    b"fn words(n: Int, s: Bytes) -> Array<Bytes> / {abort.raise} = Array::new(n, s)\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: module_source }], [], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(out.len(), 4);
  assert_eq(has(array_allocation), [true, true, true, true]);
  assert_eq(has(b"ply_alloc(ctx, INT64_C(24));"), [false, false, false, false]);
  assert_eq(has(b") * 2);"), [true, true, false, false]);
  assert_eq(has(call_start(release_function, [b"ctx"]).concat(b"ply_words(")), [
    false,
    true,
    false,
    false,
  ]);
  assert_eq(has(b"rt_list_"), [false, false, false, false]);
  assert_eq(out.map(|e: EmittedRoot| body_code(e.text).index_of(item_function) != None), [
    false,
    false,
    true,
    false,
  ])
}

test "a tail call passes a function parameter that came from a call's result as an owned value, not a borrowed one" {
  let module_source = Bytes::concat_all([
    b"type Step = | Over | More(Bytes, () -> Step)\n",
    b"fn pulled(k: () -> Step, fuel: Int) -> Bytes =\n",
    b"  match k() { Over -> b\"\", More(b, rest) -> if fuel <= 1 { b } else { pulled(rest, fuel - 1) } }\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", source_text: module_source }],
    [b"m.Over", b"m.More"],
    true,
  );
  assert_eq(out.map(|e: EmittedRoot| root_text(e.name)), [b"m.pulled"])
}

test "a function generic only over a scope parameter such as `[r]` needs no memory layout, so it is emitted once without specialising" {
  let module_source = Bytes::concat_all([
    b"fn held_byte<[r]>(h: Scoped<Bytes, [r]>, i: Int) -> Int / {scoped.read[r]} =\n",
    b"  if 0 <= i && i < h.get().len() { h.get().at(i) } else { -1 }\n",
  ]);
  let results = outputs_at([b"m"], [module_source], [], [Named(b"m.held_byte")]);
  assert_eq(results.map(|a: RootOutput| a.result.tables.generics.needs), [[]])
}

test "generated functions still build and match the prelude's constructors when the module defines constructors with the same names" {
  let module_source = Bytes::concat_all([
    b"pub type Op = | Equal | Less | Greater | Some(Int) | None | Ok | Err\n",
    b"pub type Name = | Name(Bytes)\n",
    b"fn maybe(a: Option<Name>) -> Option<Name> = observe(a)\n",
    b"fn either(a: Result<Name, Int>) -> Result<Name, Int> = observe(a)\n",
    b"fn order(o: Ordering) -> Ordering = observe(o)\n",
    b"fn ordered(a: Option<Name>, b: Option<Name>) -> Ordering = compare(a, b)\n",
  ]);
  let name = NamedType({ name: b"m.Name", args: [] });
  let maybe = option_type(name);
  let either = result_type(name, int_type);
  let ordering = ordering_type;
  let roots = [maybe, either, ordering].fold([], |accumulator: List<RootKey>, t: Type|
    accumulator.push(test_generated_key(Lift, t)).push(test_generated_key(Lower, t)));
  let results = outputs_at(
    [b"m"],
    [module_source],
    [b"m.Equal", b"m.Less", b"m.Greater", b"m.Some", b"m.None", b"m.Ok", b"m.Err", b"m.Name"],
    [b"m.maybe", b"m.either", b"m.order", b"m.ordered"].map(Named).concat(roots),
  );
  assert(results.len() > 0, None)
}

test "a list pattern reads its items and its rest in place, whatever the items' type lays out" {
  let module_source = Bytes::concat_all([
    b"type Op = | Plain | Cased({ op: Op, case: Int }) | Named(Bytes)\n",
    b"fn first(xs: List<Op>) -> Int = match xs { [Cased(c), ..rest] -> c.case + rest.len(), [_, ..rest] -> rest.len(), [] -> 0 }\n",
    b"fn pair(xs: List<Op>) -> Bool = match xs { [Plain, Named(_)] -> true, _ -> false }\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", source_text: module_source }],
    [b"m.Plain", b"m.Cased", b"m.Named"],
    true,
  );
  assert_eq(out.len(), 2);
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq([has(b"rt_list_at_p("), has(b"rt_list_rest_p(")], [[false, false], [false, false]])
}

test "a function over a sum with scope and effect parameters, specialised at its type parameters only, needs no layout for the scope parameters" {
  let module_source = Bytes::concat_all([
    b"effect log { write note[l](line: String) -> Unit }\n",
    b"type Pipe<a, b, [l], [k] | e, f> = | Pipe((a) -> b / {log.note[l] | e}, (b) -> Unit / {log.note[k] | f})\n",
    b"fn through<a, b, [l], [k] | e>(p: Pipe<a, b, [l], [k] | e, e>, x: a) -> Unit / {log.note[l], log.note[k] | e} =\n",
    b"  match p { Pipe(turn, sink) -> sink(turn(x)) }\n",
    b"fn go(p: Pipe<Int, String, [app], [db] | {}, {}>) -> Unit / {log.note[app], log.note[db]} = through(p, 41)\n",
  ]);
  let spec = keys::specialisation_key_with_effects(
    b"m.through",
    parsed_types([b"Int", b"String"]).map(keys::KeyType),
    [],
    [[]],
  );
  let results = outputs_at([b"m"], [module_source], [b"m.Pipe"], [
    Named(b"m.through"),
    Named(b"m.go"),
    spec,
  ]);
  let needs = |name: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == name { Some(a) } else { accumulator }) {
      Some(a) -> a.result.tables.generics.needs,
      None -> panic(String::of_bytes_lossy(b"no result for ".concat(name))),
    };
  assert_eq(needs(printed(spec)), [])
}

test "an array of options stores each option as a single word, and a generic array function is specialised for its element type" {
  let module_source = Bytes::concat_all([
    b"fn opts(xs: List<Option<Bytes>>) -> Array<Option<Bytes>> = Array::of_list(xs)\n",
    b"fn filled<a>(n: Int, x: a) -> Array<a> / {abort.raise} = Array::new(n, x)\n",
    b"fn ints(n: Int) -> Array<Int> / {abort.raise} = filled(n, 7)\n",
  ]);
  let results = outputs_at([b"m"], [module_source], [], [
    Named(b"m.opts"),
    Named(b"m.filled"),
    Named(b"m.ints"),
    specialised_at(b"m.filled", [b"Int"]),
  ]);
  let body = |name: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == name { Some(a) } else { accumulator }) {
      Some(a) -> a.result,
      None -> panic("no result"),
    };
  assert_eq(body(b"m.filled").tables.generics.needs, [{ var: 0, reads: Layout }]);
  assert(body(b"m.filled@Int").text.index_of(array_allocation) != None, None)
}

test "a list, array or map is compared and digested by generated functions for its type" {
  let module_source = Bytes::concat_all([
    b"type Rec = { name: String, tags: List<Int> }\n",
    b"fn same(a: List<Int>, b: List<Int>) -> Bool = a == b\n",
    b"fn other(a: Array<String>, b: Array<String>) -> Bool = a != b\n",
    b"fn alike(a: Map<Int, List<Int>>, b: Map<Int, List<Int>>) -> Bool = a == b\n",
    b"fn order(a: List<List<Int>>, b: List<List<Int>>) -> Ordering = compare(a, b)\n",
    b"fn held(a: Option<List<Int>>, b: Option<List<Int>>) -> Bool = a == b\n",
    b"fn fields(a: Rec, b: Rec) -> Bool = a == b\n",
    b"fn eq<a>(x: a, y: a) -> Bool = x == y\n",
    b"fn hashed(a: List<Int>) -> Bytes = digest(a)\n",
    b"fn some_int(a: Option<Int>, b: Option<Int>) -> Bool = a == b\n",
    b"fn some_text(a: Option<String>, b: Option<String>) -> Bool = a == b\n",
    b"type Tree<a> = | Leaf(a) | Node(List<Tree<a>>)\n",
    b"fn trees(a: Tree<Int>, b: Tree<Int>) -> Bool = a == b\n",
    b"fn ranked(a: { o: Option<Int>, p: Rec }, b: { o: Option<Int>, p: Rec }) -> Ordering = compare(a, b)\n",
  ]);
  let ints = list_type(int_type);
  let lists = list_type(ints);
  let map = map_type(int_type, ints);
  let entries = list_type(
    RecordType([{ name: b"key", ty: int_type }, { name: b"value", ty: ints }]),
  );
  let texts = array_type(string_type);
  let trees = list_type(NamedType({ name: b"m.Tree", args: [int_type] }));
  let walk = |operation: Bytes, t: Type| test_generated_key(ContainerWalk(operation), t);
  let tree = test_generated_key(keys::Equal, NamedType({ name: b"m.Tree", args: [int_type] }));
  let roots = [
    Named(b"m.same"),
    Named(b"m.other"),
    Named(b"m.alike"),
    Named(b"m.order"),
    Named(b"m.held"),
    Named(b"m.fields"),
    specialisation_key(b"m.eq", [ints], []),
    Named(b"m.hashed"),
    walk(b"equal_from", ints),
    walk(b"equal", map),
    walk(b"equal_from", entries),
    walk(b"ordered_from", lists),
    test_generated_key(Digest, ints),
    walk(b"digest_from", ints),
    Named(b"m.trees"),
    tree,
    Named(b"m.some_int"),
    Named(b"m.some_text"),
    walk(b"equal_from", texts),
    Named(b"m.ranked"),
    walk(b"equal", trees),
    walk(b"equal_from", trees),
  ];
  let constructors = [b"Less", b"Equal", b"Greater", b"Some", b"None", b"m.Leaf", b"m.Node"];
  let results = outputs_at([b"m"], [module_source], constructors, roots);
  let body = |k: RootKey|
    match results.find(|a: RootOutput| a.name == root_name(k)) {
      Some(a) -> a.result,
      None -> panic("no result"),
    };
  let counting = [
    keys::Drop,
    keys::Share,
    keys::Keep,
    keys::Copy,
    keys::Unboxed(keys::Dup),
    keys::Unboxed(keys::Release),
  ];
  let written_called = |k: RootKey|
    body(k).tables.calls.filter(|c: RootKey|
      match c { Generated(w, _) -> c != k && !counting.contains(w.operation), _ -> false });
  assert_eq(roots.map(written_called), [
    [walk(b"equal", ints)],
    [walk(b"equal", texts)],
    [walk(b"equal", map)],
    [walk(b"ordered", lists)],
    [walk(b"equal", option_type(ints))],
    [walk(b"equal", ints)],
    [walk(b"equal", ints)],
    [test_generated_key(Digest, ints)],
    [],
    [walk(b"equal_from", entries)],
    [walk(b"equal", ints)],
    [walk(b"ordered", ints)],
    [walk(b"digest_from", ints), walk(b"concat_all_from", list_type(bytes_type))],
    [],
    [tree],
    [walk(b"equal", trees)],
    [walk(b"equal", option_type(int_type))],
    [walk(b"equal", option_type(string_type))],
    [],
    [walk(b"ordered", option_type(int_type)), walk(b"ordered", ints)],
    [walk(b"equal_from", trees)],
    [tree],
  ]);
  assert_eq(
    body(walk(b"equal_from", texts)).tables.calls.filter(|c: RootKey|
      printed(c).index_of(b"Array::at") != None),
    [],
  );
  let prelude_calls = roots.filter(|k: RootKey|
    match k { Generated(_, _) -> true, _ -> false }).fold(
    [],
    |accumulator: List<RootKey>, k: RootKey|
      body(k).tables.generics.calls.fold(accumulator, |a: List<RootKey>, g: GenericCall|
        if module_of(g.callee) != prelude_module || a.contains(g.callee) { a }
        else { a.push(g.callee) }),
  );
  let named = emitted_code.calls.map(|n: Bytes| qualify(prelude_module, n));
  assert_eq(prelude_calls.map(printed).filter(|n: Bytes| !named.contains(n)), []);
  assert_eq(
    roots.filter(|k: RootKey| body_code(body(k).text).index_of(b"builtin_compare") != None),
    [],
  );
  assert_eq(
    [
      walk(b"equal_from", ints),
      walk(b"equal_from", entries),
      walk(b"ordered_from", lists),
      walk(b"digest_from", ints),
      walk(b"equal_from", texts),
    ].filter(|k: RootKey| body_code(body(k).text).index_of(b"goto ply_loop") == None),
    [],
  )
}

test "a string or bytes builtin that fails, such as `at` or `slice`, reports the error to the runtime with its original integer arguments, converting nothing" {
  let source = Bytes::concat_all([
    b"fn at(b: Bytes, i: Int) -> Int / {abort.raise} = b.at(i)\n",
    b"fn word(b: Bytes, i: Int) -> U32 / {abort.raise} = b.u32_le(i)\n",
    b"fn cut(b: Bytes, i: Int, j: Int) -> Bytes / {abort.raise} = b.slice(i, j)\n",
    b"fn chars(s: String, i: Int, j: Int) -> String / {abort.raise} = s.slice(i, j)\n",
    b"fn byte(n: Int) -> Bytes / {abort.raise} = byte_of_int(n)\n",
    b"fn from(b: Bytes, n: Bytes, i: Int) -> Option<Int> / {abort.raise} = b.index_of_from(n, i)\n",
    b"fn seek(b: Bytes, n: Int) -> Option<Int> / {abort.raise} = b.index_of_byte(n)\n",
    b"fn scan(b: Bytes, i: Int, n: Int) -> Int / {abort.raise} = b.scan(i, b\"a\", n)\n",
    b"fn parts(s: String, t: String) -> List<String> / {abort.raise} = s.split(t)\n",
    b"fn ints(lo: Int, hi: Int) -> List<Int> = range(lo, hi)\n",
    b"fn find(s: String, t: String) -> Int / {abort.raise} = s.find(t)\n",
    b"fn told(c: Bool, m: String) -> Unit / {abort.raise} = assert(c, Some(m))\n",
    b"fn untold(c: Bool) -> Unit / {abort.raise} = assert(c, None)\n",
  ]);
  let rejections = [
    { name: b"m.at", code: 8, text: false },
    { name: b"m.word", code: 9, text: false },
    { name: b"m.cut", code: 10, text: false },
    { name: b"m.chars", code: 11, text: false },
    { name: b"m.byte", code: 12, text: false },
    { name: b"m.from", code: 14, text: false },
    { name: b"m.seek", code: 13, text: false },
    { name: b"m.scan", code: 15, text: false },
    { name: b"m.parts", code: 19, text: false },
    { name: b"m.ints", code: 17, text: false },
    { name: b"m.find", code: 20, text: true },
    { name: b"m.told", code: 21, text: true },
    { name: b"m.untold", code: 21, text: true },
  ];
  let names = rejections.map(|r: { name: Bytes, code: Int, text: Bool }| r.name);
  let results = outputs_at([b"m"], [source], [b"Some", b"None"], names.map(|n: Bytes| Named(n)));
  let marshallings = [keys::Lower, keys::Lift];
  let wrong = rejections.filter(|r: { name: Bytes, code: Int, text: Bool }| {
    let b = output_body(results, r.name);
    let native = if r.text { b"ply_refused_text(ctx, INT64_C(" }
    else { b"ply_refused(ctx, INT64_C(" };
    body_code(b.text).index_of(native.concat(ascii_of_int(r.code)).concat(b"), ")) == None
      || b.tables.calls.any(|c: RootKey|
        match c { Generated(w, _) -> marshallings.contains(w.operation), _ -> false })
  });
  assert_eq(wrong.map(|r: { name: Bytes, code: Int, text: Bool }| r.name), []);
  let message_code = body_code(output_body(results, b"m.told").text);
  assert(
    message_code.index_of(b"INT64_C(-1), ") != None,
    Some(String::of_bytes_lossy(message_code)),
  )
}

fn output_body(results: List<RootOutput>, name: Bytes) -> Output / {abort.raise} =
  match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
      if output_name(a) == name { Some(a) } else { accumulator }) {
    Some(a) -> a.result,
    None -> panic(String::of_bytes_lossy(b"no result for ".concat(name))),
  }

fn calls_a_value(code: Bytes) -> Bool =
  code.index_of(b"->typed)(ctx") != None || code.index_of(b"->uniform(ctx") != None

test "a list's `map`, `filter` and `fold` over a lambda become a loop in the caller, instead of the prelude function calling the lambda" {
  let source = Bytes::concat_all([
    b"fn bumped(xs: List<Int>) -> List<Int> = xs.map(|x: Int| x + 1)\n",
    b"fn kept(xs: List<Int>) -> List<Int> = xs.filter(|x: Int| x > 2)\n",
    b"fn summed(xs: List<Int>) -> Int = xs.fold(0, |s: Int, x: Int| s + x)\n",
    b"effect tick { write tock() -> Unit }\n",
    b"fn handled(xs: List<Int>) -> List<Int> = xs.map(|x: Int| handle { tick.tock(); x } with { tick.tock() resume k -> k(()), return v -> v })\n",
    b"fn added(s: Int, x: Int) -> Int = s + x\n",
    b"fn named(xs: List<Int>) -> Int = xs.fold(0, added)\n",
    b"fn known(xs: List<Int>, k: Int) -> List<Int> = { let f = |x: Int| x + k; xs.map(f) }\n",
    b"fn by(xs: List<Int>, f: (Int) -> Int) -> List<Int> = xs.map(f)\n",
  ]);
  let generic = effects_generic_at(b"std.prelude.mapped_from", [b"Int", b"Int"]);
  let callers = [b"m.bumped", b"m.kept", b"m.summed", b"m.handled", b"m.named", b"m.known"];
  let results = outputs_at([b"m"], [source], [], callers.push(b"m.by").map(Named).push(generic));
  let call = |name: Bytes|
    output_body(results, name).tables.generics.calls.map(|g: GenericCall|
      { callee: g.callee, borrowed: g.functions.len() });
  assert_eq(callers.map(call), [[], [], [], [], [], []]);
  assert_eq(call(b"m.by"), [{ callee: Named(b"std.prelude.List::map"), borrowed: 0 }]);
  let calling = |name: Bytes| calls_a_value(body_code(output_body(results, name).text));
  assert_eq(callers.map(calling), [false, false, false, true, false, false]);
  assert(calling(printed(generic)), None)
}

test "a program's folds, maps and filters over a lambda emit none of the prelude's looping functions" {
  let source = Bytes::concat_all([
    b"fn summed(xs: List<Int>) -> Int = xs.fold(0, |s: Int, x: Int| s + x)\n",
    b"fn tallied(m: Map<String, Int>) -> Int = m.fold(0, |t: Int, k: String, v: Int| t + k.len() * v)\n",
    b"fn kept(xs: List<String>, n: Int) -> List<String> = xs.filter(|s: String| s.len() > n)\n",
    b"fn nested(xss: List<List<Int>>) -> Int = xss.fold(0, |t: Int, xs: List<Int>| t + xs.map(|x: Int| x * 2).fold(0, |s: Int, x: Int| s + x))\n",
    b"fn each(xs: List<Int>, f: (Int) -> Int) -> List<Int> = xs.map(f)\n",
    b"fn lent(xs: List<Int>) -> List<Int> = each(xs, |x: Int| x - 1)\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let walks = [
    b"List::fold",
    b"List::map",
    b"List::filter",
    b"folded_from",
    b"mapped_from",
    b"kept_from",
    b"Map::fold",
    b"map_folded",
  ];
  let walking = |n: Bytes|
    walks.any(|w: Bytes| {
      let full = qualify(prelude_module, w);
      n == full || n.starts_with(full.concat(b"@"))
    });
  let calls = out.fold([], |accumulator: List<GenericCall>, e: EmittedRoot|
    accumulator.concat(e.tables.generics.calls));
  assert_eq(
    calls.filter(|g: GenericCall| match g.callee { Named(n) -> walking(n), _ -> false }).map(
      |g: GenericCall| { callee: g.callee, borrowed: g.functions.len() },
    ),
    [{ callee: Named(b"std.prelude.List::map"), borrowed: 0 }],
  )
}

test "a map's value is read by `std.prelude`'s `Map::get` down its tree, its keys compared at their type" {
  let source = b"fn priced(m: Map<Bytes, Bytes>, k: Bytes) -> Option<Bytes> = m.get(k)\n";
  let at = |name: Bytes|
    specialisation_key(qualify(prelude_module, name), [bytes_type, bytes_type], []);
  let keys = [at(b"Map::get"), at(b"found_under")];
  let read = keys.map(printed);
  let results = outputs_at(
    [b"m"],
    [source],
    [b"Some", b"None", b"Less", b"Equal", b"Greater"],
    [Named(b"m.priced")].concat(keys),
  );
  assert_eq(
    output_body(results, b"m.priced").tables.generics.calls.map(|g: GenericCall| g.callee),
    [Named(b"std.prelude.Map::get")],
  );
  let code = |name: Bytes| body_code(output_body(results, name).text);
  assert_eq(
    read.filter(|n: Bytes|
      code(n).index_of(b"rt_map_") != None || code(n).index_of(b"builtin_compare") != None),
    [],
  );
  assert_eq(read.filter(|n: Bytes| code(n).index_of(b"rt_arith_p") != None), []);
  let walk = code(printed(at(b"found_under"))).split(b"\n");
  assert_eq(
    walk.filter(|l: Bytes|
      l.index_of(b"[2 * (") != None && l.index_of(b") + 1]") == None && increments_count(l)),
    [],
  );
  assert(
    range(0, walk.len()).any(|i: Int|
      increments_count(walk.get(i))
        && range(i + 1, i + 4).any(|j: Int|
          match walk.at(j) { Some(l) -> l.index_of(b"return t") != None, None -> false })),
    Some(String::of_bytes_lossy(Bytes::join(walk, b"\n"))),
  );
  assert(code(printed(at(b"Map::get"))).index_of(b"))->height") != None, None)
}

test "a map's length is the count in its header, whatever the layout of its values" {
  let source = Bytes::concat_all([
    b"type Seen = { kind: Bytes, at: Bytes }\n",
    b"fn counted(m: Map<Bytes, Seen>) -> Int = m.len()\n",
    b"fn names(m: Map<Bytes, Bytes>) -> Int = m.len()\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), 2);
  assert_eq(out.map(|e: EmittedRoot| body_code(e.text).index_of(b"builtin_map_len") == None), [
    true,
    true,
  ]);
  assert_eq(out.map(|e: EmittedRoot| body_code(e.text).index_of(b")->len") != None), [true, true])
}

test "emitted code reads and writes no field of a block's header but its count" {
  let source = Bytes::concat_all([
    b"type P = { x: Float, label: String }\n",
    b"fn texts(s: String, b: Bytes) -> Int = (s ++ \"!\").len() + b.len()\n",
    b"fn lists(xs: List<Int>) -> Int = match xs.push(1) { [a, ..rest] -> a + rest.len(), [] -> 0 }\n",
    b"fn maps(m: Map<Bytes, Int>) -> Int = m.insert(b\"k\", 1).len()\n",
    b"fn arrays(n: Int, p: P) -> Int / {abort.raise} = Array::new(n, p).set(0, p).len()\n",
    b"fn lambda(k: Int) -> List<Int> = [1, 2].map(|x: Int| x + k)\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert(out.len() > 0, None);
  let fields = out.fold([], |accumulator: List<Bytes>, e: EmittedRoot|
    accumulator.concat(header_fields(body_code(e.text))));
  assert(
    fields.len() > 0 && fields.all(|f: Bytes| f == b"rc"),
    Some(String::of_bytes_lossy(Bytes::join(fields, b", "))),
  );
  assert_eq(
    [b"ply_dec(", b"ply_counted_by(", b"ply_unit"].filter(|idiom: Bytes|
      out.any(|e: EmittedRoot| body_code(e.text).index_of(idiom) != None)),
    [],
  )
}

test "two maps are compared by a generated function that iterates `std.prelude`'s `Map::entries`" {
  let source = b"fn same(a: Map<Int, Bytes>, b: Map<Int, Bytes>) -> Bool = a == b\n";
  let root = test_generated_key(ContainerWalk(b"equal"), map_type(int_type, bytes_type));
  let results = outputs_at([b"m"], [source], [b"Some", b"None"], [Named(b"m.same"), root]);
  let body = output_body(results, printed(root));
  assert(
    body.tables.generics.calls.any(|g: GenericCall| g.callee == Named(b"std.prelude.Map::entries")),
    None,
  )
}

test "two `Columns` values are compared and ordered by generated functions that read each record directly in memory, as arrays are" {
  let source = Bytes::concat_all([
    b"fn same(a: Columns<{ x: Int, id: Int }>, b: Columns<{ x: Int, id: Int }>) -> Bool = a == b\n",
    b"fn ordered(a: Columns<{ x: Int, id: Int }>, b: Columns<{ x: Int, id: Int }>) -> Ordering =\n",
    b"  compare(a, b)\n",
  ]);
  let columns = columns_type(
    RecordType([{ name: b"id", ty: int_type }, { name: b"x", ty: int_type }]),
  );
  let equal = test_generated_key(ContainerWalk(b"equal"), columns);
  let ordered = test_generated_key(ContainerWalk(b"ordered"), columns);
  let results = outputs_at([b"m"], [source], [], [
    Named(b"m.same"),
    Named(b"m.ordered"),
    equal,
    ordered,
  ]);
  assert(output_body(results, b"m.same").tables.calls.contains(equal), None);
  assert(output_body(results, b"m.ordered").tables.calls.contains(ordered), None)
}

test "`Iter` values are compared by case and then payload with the generated equality function for `Iter`, whether directly, in a generic function or inside `Ok`" {
  let source = Bytes::concat_all([
    b"fn same<a>(x: a, y: a) -> Bool = x == y\n",
    b"fn steps(x: Iter<Int, String>, y: Iter<Int, String>) -> Bool = x == y\n",
    b"fn through(x: Iter<Int, String>) -> Bool = same(x, Continue(1))\n",
    b"fn ok_of<a>(x: a) -> Result<a, Int> = Ok(x)\n",
    b"fn wrapped<a>(x: a) -> Bool = ok_of(x) == Ok(x)\n",
    b"fn kept(x: Iter<Int, String>) -> Bool = wrapped(x)\n",
    b"type E = { at: Int, message: String }\n",
    b"type Codec<a> = { put: (a) -> Bytes, take: (Bytes) -> Result<a, E> }\n",
    b"fn trips<a>(x: a, c: Codec<a>) -> Bool = (c.take)((c.put)(x)) == Ok(x)\n",
    b"fn coded(c: Codec<Iter<String, Int>>) -> Bool = trips(Stop(3), c)\n",
  ]);
  let coded = specialisation_key(b"m.trips", [iter_type(string_type, int_type)], []);
  let iterator_type = iter_type(int_type, string_type);
  let at = specialisation_key(b"m.same", [iterator_type], []);
  let ok = specialisation_key(b"m.wrapped", [iterator_type], []);
  let results = test_generated_key(ContainerWalk(b"equal"), result_type(iterator_type, int_type));
  let outputs = outputs_at([b"m"], [source], [b"Stop", b"Continue", b"Ok", b"Err"], [
    Named(b"m.steps"),
    Named(b"m.through"),
    Named(b"m.kept"),
    at,
    ok,
    results,
    Named(b"m.coded"),
    coded,
  ]);
  [
    b"m.steps",
    b"m.through",
    b"m.kept",
    b"m.coded",
    printed(at),
    printed(ok),
    printed(results),
    printed(coded),
  ].fold((), |_: Unit, n: Bytes|
    assert(output_body(outputs, n).text != b"", Some(String::of_bytes_lossy(n))))
}

test "a generic function in a standard library module compares an `Iter` using its type's generated function when specialised for `Iter`" {
  let shipped = {
    name: b"std.probe",
    source_text: Bytes::concat_all([
      b"pub type E = { at: Int, message: String }\n",
      b"pub type Codec<a> = { put: (a) -> Bytes, take: (Bytes) -> Result<a, E> }\n",
      b"pub fn trips<a>(x: a, c: Codec<a>) -> Bool = (c.take)((c.put)(x)) == Ok(x)\n",
      b"pub fn direct<a>(x: a, take: (a) -> Result<a, E>) -> Bool = take(x) == Ok(x)\n",
    ]),
  };
  let source = b"import std.probe (Codec, E, trips, direct)\nfn coded(c: Codec<Iter<String, Int>>) -> Bool = trips(Stop(3), c)\nfn plain(f: (Iter<String, Int>) -> Result<Iter<String, Int>, E>) -> Bool = direct(Stop(3), f)\n";
  let iterator_type = iter_type(string_type, int_type);
  let coded = specialisation_key(b"std.probe.trips", [iterator_type], []);
  let direct = specialisation_key(b"std.probe.direct", [iterator_type], []);
  let results = outputs_at(
    [b"m"],
    [source],
    [b"Stop", b"Continue", b"Ok", b"Err"],
    [Named(b"m.coded"), Named(b"m.plain"), coded, direct],
    shipped: [shipped],
  );
  [printed(direct), printed(coded)].fold((), |_: Unit, n: Bytes|
    assert(output_body(results, n).text != b"", Some(String::of_bytes_lossy(n))))
}

test "a byte returned by `byte_of_int` is a preallocated single-byte value, so a loop appending bytes allocates nothing" {
  let source = b"fn bytes(t: Bytes, at: Int, out: Bytes) -> Bytes / {abort.raise} = if at >= t.len() { out } else { bytes(t, at + 1, out ++ byte_of_int(t.at(at) ^ 1)) }\n";
  let text = body_code(
    output_body(outputs_at([b"m"], [source], [], [Named(b"m.bytes")]), b"m.bytes").text,
  );
  assert(
    text.index_of(b"ply_byte_text(") != None && !allocates(without_appends(text)),
    Some(String::of_bytes_lossy(text)),
  )
}

test "the generated lower and lift functions for a type, which the runtime calls through the type's function table, check the stack depth" {
  let pair = NamedType({ name: b"P", args: [] });
  let worded = [keys::OnWordForm(Lower), keys::OnWordForm(Lift)].fold(
    [],
    |accumulator: List<RootKey>, operation: TypeOperation|
      accumulator.concat([
        test_generated_key(operation, int_type),
        test_generated_key(operation, pair),
      ]),
  );
  let results = outputs_at([b"m"], [b"pub type P = { a: Bytes, n: Int }\n"], [], worded);
  worded.fold((), |_: Unit, k: RootKey| {
    let text = output_body(results, printed(k)).text;
    assert(
      text.index_of(probed_fn.concat(b"(ctx)")) != None,
      Some(String::of_bytes_lossy(printed(k))),
    )
  })
}

test "matching on a sum stored as separate words moves each reference-counted payload into the new value without incrementing its reference count" {
  let source = Bytes::concat_all([
    b"type S = | S(Map<Int, (Int, Int)>, Map<(Int, Int), Int>, Int)\n",
    b"fn inserted(s: S, i: Int) -> S = match s { S(places, order, next) -> S(places.insert(i, (i, next)), order.insert((i, next), i), next + 1) }\n",
  ]);
  let results = outputs_at([b"m"], [source], [b"S"], [Named(b"m.inserted")]);
  let text = body_code(output_body(results, b"m.inserted").text);
  assert(!increments_count(text), Some(String::of_bytes_lossy(text)))
}

test "a lambda a call passes borrowed is laid out on the caller's stack with its descriptor, whoever the callee is" {
  let source = Bytes::concat_all([
    b"fn apply(f: (Int) -> Int, x: Int) -> Int = f(x)\n",
    b"fn held(f: keep (Int) -> Int) -> List<(Int) -> Int> = [f]\n",
    b"fn same<a>(x: a) -> a = x\n",
    b"fn applied(n: Int) -> Int = apply(|x: Int| x + n, 1)\n",
    b"fn updated(m: Map<Int, Int>, n: Int) -> Map<Int, Int> = m.update(1, |x: Int| x + n)\n",
    b"fn kept(n: Int) -> List<(Int) -> Int> = held(|x: Int| x + n)\n",
    b"fn passed(n: Int) -> (Int) -> Int = same(|x: Int| x + n)\n",
    b"fn bare(n: Int) -> Int = apply(|x: Int| x + 1, n)\n",
  ]);
  let names = [b"m.applied", b"m.updated", b"m.kept", b"m.passed", b"m.bare"];
  let results = outputs_at([b"m"], [source], [], names.map(Named));
  let code = |name: Bytes| body_code(output_body(results, name).text);
  let has = |text: Bytes| names.map(|n: Bytes| code(n).index_of(text) != None);
  assert_eq(has(b"[PLY_HEADER / 8 + "), [true, true, false, false, false]);
  assert_eq(has(b"ply_alloc("), [false, false, true, true, false]);
  assert_eq(has(b"_lambda0_value;"), [false, false, false, false, true]);
  assert_eq(has(b"ply_rel_int"), [false, false, false, false, false])
}

test "a list literal only read or borrowed lies in the frame, and one returned or stored is a block of its own" {
  let source = Bytes::concat_all([
    b"fn total(xs: List<Bytes>) -> Int = match xs { [b, ..] -> b.len(), [] -> 0 }\n",
    b"fn joined(a: Bytes, b: Bytes) -> Int = total([a, b, a])\n",
    b"fn counted(n: Int) -> Int = [n, n + 1, n + 2].len()\n",
    b"fn answered(n: Int) -> List<Int> = [n, n]\n",
    b"fn nested(n: Int) -> List<List<Int>> = [[n], [n + 1]]\n",
  ]);
  let names = [b"m.joined", b"m.counted", b"m.answered", b"m.nested"];
  let results = outputs_at([b"m"], [source], [], names.push(b"m.total").map(Named));
  let code = |name: Bytes| body_code(output_body(results, name).text);
  let has = |text: Bytes| names.map(|n: Bytes| code(n).index_of(text) != None);
  assert_eq(has(b"_f[PLY_HEADER / 8 + "), [true, true, false, false]);
  assert_eq(has(b"ply_list_room("), [false, false, true, true])
}

test "a function's stack frame stores list literals up to a size limit, and list literals beyond that limit are allocated on the heap" {
  let items = |k: Int| Bytes::join(range(0, k).map(|_: Int| b"n"), b", ");
  let full = Bytes::concat_all([b"total([", items(32), b"])"]);
  let source = Bytes::concat_all([
    b"fn total(xs: List<Int>) -> Int = xs.len()\n",
    b"fn four(n: Int) -> Int = ",
    Bytes::join([full, full, full, full], b" + "),
    b"\nfn past_a_leaf(n: Int) -> Int = total([",
    items(33),
    b"])\n",
  ]);
  let names = [b"m.four", b"m.past_a_leaf"];
  let results = outputs_at([b"m"], [source], [], names.push(b"m.total").map(Named));
  let count = |name: Bytes, text: Bytes|
    Bytes::split(body_code(output_body(results, name).text), text).len() - 1;
  assert_eq(names.map(|n: Bytes| count(n, b"_f[PLY_HEADER / 8 + ")), [3, 0]);
  assert_eq(names.map(|n: Bytes| count(n, b"ply_list_room(")), [1, 1])
}

test "a lambda that a `std.prelude` function passes to the runtime's cleanup function is built with a static type table and no heap allocation" {
  let source = Bytes::concat_all([
    b"pub fn guarded(f: (Int) -> Int) -> Int = bracket(|| 1, |_: Int| (), f)\n",
    b"pub fn raised(n: Int) -> Int = guarded(|v: Int| v + n)\n",
  ]);
  let results = outputs_at([prelude_module], [source], [], [
    Named(b"std.prelude.guarded"),
    Named(b"std.prelude.raised"),
  ]);
  let code = |name: Bytes| body_code(output_body(results, name).text);
  assert(code(b"std.prelude.guarded").index_of(b"rt_with_cleanup_p(ctx") != None, None);
  assert(
    code(b"std.prelude.raised").index_of(b"[PLY_HEADER / 8 + 0] = (Word)(intptr_t)&") != None,
    None,
  );
  assert(code(b"std.prelude.raised").index_of(b"ply_alloc(") == None, None)
}

test "a lambda that captures nothing is one value made once, wherever it goes" {
  let source = Bytes::concat_all([
    b"fn apply(f: (Int) -> Int, x: Int) -> Int = f(x)\n",
    b"fn kept(fs: List<(Int) -> Int>) -> List<(Int) -> Int> = fs\n",
    b"fn twice(x: Int) -> Int = x * 2\n",
    b"fn stored() -> List<(Int) -> Int> = kept([|x: Int| x + 1, twice])\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let text = match out.filter(|e: EmittedRoot| emitted_name(e) == b"m.stored") {
    [e, ..] -> body_code(e.text),
    [] -> b"",
  };
  assert(text.index_of(b"_desc;") == None, Some(String::of_bytes_lossy(text)));
  assert_eq(text.split(b"extern PlyFnBlock ").len(), 3)
}

test "a lambda inside a lambda is passed as a borrowed value, owned by the function that created the outer lambda" {
  let source = Bytes::concat_all([
    b"fn rows(xss: List<List<Int>>, g: (List<Int>) -> List<Int>) -> List<List<Int>> = xss.map(g)\n",
    b"fn row(xs: List<Int>, g: (Int) -> Int) -> List<Int> = xs.map(g)\n",
    b"fn nested(xss: List<List<Int>>) -> List<List<Int>> = rows(xss, |xs: List<Int>| row(xs, |x: Int| x + 1))\n",
  ]);
  let outer = specialisation_key(b"m.rows", [], [{ param: 1, owner: Named(b"m.nested"), nth: 0 }]);
  let results = outputs_at([b"m"], [source], [], [Named(b"m.nested"), outer]);
  let body = match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
      if a.name == root_name(outer) { Some(a) } else { accumulator }) {
    Some(a) -> a.result,
    None -> panic("no result"),
  };
  assert(
    body.tables.generics.calls.map(|g: GenericCall| g.functions).contains([
      { param: 1, owner: Named(b"m.nested"), nth: 1 },
    ]),
    None,
  );
  assert(!calls_a_value(body_code(body.text)), None)
}

test "strings and byte strings are compared by their bytes directly in memory" {
  let source = Bytes::concat_all([
    b"fn same(a: String, b: String) -> Bool = a == b\n",
    b"fn other(a: Bytes, b: Bytes) -> Bool = a != b\n",
    b"fn named(b: Bytes) -> Int = match b { b\"List\" -> 1, b\"Map\" -> 2, _ -> 0 }\n",
    b"fn worded(s: String) -> Int = match s { \"x\" -> 1, _ -> 0 }\n",
    b"fn lettered(c: Char) -> Int = match c { 'a' -> 1, _ -> 0 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(out.len(), 5);
  assert_eq(has(b"memcmp(((unsigned char *)&ply_words("), [true, true, true, true, false])
}

test "a record with an `Option` field is built, matched and updated without allocating" {
  let source = Bytes::concat_all([
    b"type Entry = { name: String, note: Option<String> }\n",
    b"fn made(s: String) -> Entry = { name: s, note: Some(s) }\n",
    b"fn noted(e: Entry) -> Int = match e.note { Some(_) -> 1, None -> 0 }\n",
    b"fn cleared(e: Entry) -> Entry = { ..e, note: None }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [b"Some", b"None"], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(out.len(), 3);
  assert_eq(out.map(|e: EmittedRoot| allocates(body_code(e.text))), [false, false, false])
}

test "a constructor stores each argument using the type its declaration gives it" {
  let source = Bytes::concat_all([
    b"type Point = { x: Float, y: Float }\n",
    b"type Shape = | Circle(Point, Float) | Label(String)\n",
    b"fn circle(at: Point, r: Float) -> Shape = Circle(at, r)\n",
    b"fn radius(s: Shape) -> Float = match s { Circle(_, r) -> r, _ -> 0.0 }\n",
    b"fn centre_x(s: Shape) -> Float = match s { Circle(p, _) -> p.x, _ -> 0.0 }\n",
    b"fn unit(s: Shape) -> Bool = match s { Circle(_, 1.0) -> true, _ -> false }\n",
    b"fn label(s: String) -> Shape = Label(s)\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", source_text: source }],
    [b"m.Circle", b"m.Label"],
    true,
  );
  let has = |text: Bytes| out.map(|e: EmittedRoot| e.text.index_of(text) != None);
  assert_eq(out.len(), 5);
  [b"ply_alloc(", b"rt_alloc_p(", b"->layout == "].fold((), |_: Unit, t: Bytes|
    assert_eq(has(t), [false, false, false, false, false]))
}

test "a record of ints is passed to calls as separate fields and stored in a list without a box" {
  let source = Bytes::concat_all([
    b"type Span = { start: Int, end: Int }\n",
    b"fn widened(s: Span, by: Int) -> Span = { start: s.start - by, end: s.end + by }\n",
    b"fn width(s: Span) -> Int = s.end - s.start\n",
    b"fn twice(s: Span) -> Int = width(widened(widened(s, 1), 2))\n",
    b"fn kept(s: Span) -> List<Span> = [widened(s, 1)]\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(out.len(), 4);
  assert_eq(has(b"ply_alloc(ctx, INT64_C(24));"), [false, false, false, false]);
  assert_eq(out.get(1).tables.defined.map(|d: DefinitionSymbol| d.head), [
    { result: b"int64_t", params: [b"int64_t", b"int64_t"] },
  ])
}

test "a record literal nested in another record is written directly into it, without building a separate record first" {
  let source = Bytes::concat_all([
    b"type T = | TyC({ name: Bytes, args: List<Int> }) | TyV(Int)\n",
    b"type Counter = { next: Int, last: Int }\n",
    b"fn made(n: Bytes, a: List<Int>) -> T = TyC({ name: n, args: a })\n",
    b"fn stepped(v: Int) -> { counter: Counter, at: Int } = { counter: { next: v + 1, last: v }, at: v }\n",
    b"fn copied(h: { c: { tag: Bytes, n: Int } }, v: Int) -> { counter: { tag: Bytes, n: Int }, at: Int } = { counter: h.c, at: v }\n",
    b"fn read(n: { v: Bytes }, a: { v: List<Int> }) -> T = TyC({ name: n.v, args: a.v })\n",
    b"fn held(c: { tag: Bytes, n: Int }, v: Int) -> { counter: { tag: Bytes, n: Int }, at: Int } = { counter: c, at: v }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [b"m.TyC", b"m.TyV"], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| e.text.index_of(text) != None);
  assert_eq(out.len(), 5);
  assert_eq(out.map(|e: EmittedRoot| allocates(e.text)), [false, false, false, false, false])
}

test "a call passes a record that contains a small record as separate fields, including the inner record's fields" {
  let source = Bytes::concat_all([
    b"type Holding = { held: List<Int>, places: Map<Bytes, Int>, whole: Map<Bytes, Int> }\n",
    b"fn added(h: Holding, n: Int, key: Bytes) -> { h: Holding, at: Int } = match h.places.get(key) { Some(at) -> { h: h, at: at }, None -> { h: { ..h, held: h.held.push(n), places: h.places.insert(key, h.held.len()) }, at: h.held.len() } }\n",
    b"fn counted(h: Holding, key: Bytes) -> Int = { let p = added(h, 1, key); p.at + p.h.held.len() }\n",
    b"fn kept(h: Holding, key: Bytes) -> List<Holding> = [added(h, 2, key).h]\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [b"Some", b"None"], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(out.len(), 3);
  assert_eq(has(b"ply_alloc(ctx, INT64_C(32));"), [false, false, false]);
  assert_eq(out.get(0).tables.defined.map(|d: DefinitionSymbol| d.head), [
    { result: b"int64_t", params: [b"Word", b"Word", b"Word", b"int64_t", b"Word", b"Word*"] },
  ])
}

test "`compare` on numbers, characters and strings is emitted as a C comparison and returns an `Ordering` constructor" {
  let source = Bytes::concat_all([
    b"fn by_name(a: Bytes, b: Bytes) -> Bool = compare(a, b) == Less\n",
    b"fn by_int(a: Int, b: Int) -> Ordering = compare(a, b)\n",
    b"fn by_text(a: String, b: String) -> Ordering = compare_values(a, b)\n",
    b"fn by_list(a: List<Int>, b: List<Int>) -> Ordering = compare(a, b)\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", source_text: source }],
    [b"Less", b"Equal", b"Greater"],
    true,
  );
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(out.len(), 4);
  assert_eq(has(b"builtin_compare"), [false, false, false, false]);
  assert_eq(has(b"memcmp(((unsigned char *)&ply_words("), [true, false, true, false])
}

test "a generated ordering function returns `Equal` immediately when both arguments are the same object" {
  let source = b"type T = | Leaf(Int) | Node(List<T>)\nfn order(a: T, b: T) -> Ordering = compare(a, b)\nfn listed(a: List<T>, b: List<T>) -> Ordering = compare(a, b)\n";
  let lists = list_type(NamedType({ name: b"m.T", args: [] }));
  let written = [
    test_generated_key(Order, NamedType({ name: b"m.T", args: [] })),
    test_generated_key(ContainerWalk(b"ordered"), lists),
  ];
  let results = outputs_at(
    [b"m"],
    [source],
    [b"Less", b"Equal", b"Greater", b"Some", b"None", b"m.Leaf", b"m.Node"],
    [Named(b"m.order"), Named(b"m.listed")].concat(written),
  );
  let code = |k: RootKey| body_code(output_body(results, printed(k)).text);
  assert_eq(written.map(|k: RootKey| code(k).index_of(b"(p0) == (p1)") != None), [false, true])
}

test "a generated function for a type uses the prelude's constructors, even when the module declares constructors with the same names" {
  let source = Bytes::concat_all([
    b"type Op = | Equal | Less | Greater | Some(Int) | None | Ok | Err\n",
    b"type Name = | Name(Bytes)\n",
    b"fn order(a: Name, b: Name) -> Ordering = compare(a, b)\n",
    b"fn maybe(a: Option<Name>, b: Option<Name>) -> Ordering = compare(a, b)\n",
    b"fn either(a: Result<Name, Int>, b: Result<Name, Int>) -> Ordering = compare(a, b)\n",
    b"fn same(a: Result<Name, Int>, b: Result<Name, Int>) -> Bool = a == b\n",
    b"fn listed(a: List<Name>, b: List<Name>) -> Ordering = compare(a, b)\n",
  ]);
  let name = NamedType({ name: b"m.Name", args: [] });
  let either = result_type(name, int_type);
  let written = [
    test_generated_key(Order, name),
    test_generated_key(ContainerWalk(b"ordered"), option_type(name)),
    test_generated_key(ContainerWalk(b"ordered"), either),
    test_generated_key(ContainerWalk(b"equal"), either),
    test_generated_key(ContainerWalk(b"ordered_from"), list_type(name)),
  ];
  let own = [b"Equal", b"Less", b"Greater", b"Some", b"None", b"Ok", b"Err"];
  let results = outputs_at(
    [b"m"],
    [source],
    own.map(|c: Bytes| b"m.".concat(c)).concat(own).push(b"m.Name"),
    [b"m.order", b"m.maybe", b"m.either", b"m.same", b"m.listed"].map(|n: Bytes| Named(n)).concat(
      written,
    ),
  );
  written.fold((), |_: Unit, k: RootKey| {
    let text = output_body(results, printed(k)).text;
    assert_eq(
      own.filter(|c: Bytes| text.index_of(Bytes::concat_all([b"@@Tm.", c, b"@@"])) != None),
      [],
    )
  })
}

test "comparing a `compare` result with `Less`, `Equal` or `Greater` tests the sign of C's comparison when C can compare the type" {
  let source = Bytes::concat_all([
    b"type V = { major: Int, tag: Bytes }\n",
    b"type S = | Big(Int) | Small\n",
    b"fn later(a: V, b: V) -> Bool = compare(a, b) != Greater\n",
    b"fn same(a: Int, b: Int) -> Bool = compare(a, b) == Equal\n",
    b"fn sum(a: S, b: S) -> Bool = compare(a, b) == Less\n",
    b"fn listed(a: List<Int>, b: List<Int>) -> Bool = compare(a, b) == Less\n",
  ]);
  let out = emit_all_program(
    [{ name: b"m", source_text: source }],
    [b"Less", b"Equal", b"Greater", b"m.Big", b"m.Small"],
    true,
  );
  assert(out.len() > 0, None);
  let code = |name: Bytes|
    match out.find(|e: EmittedRoot| emitted_name(e) == name) {
      Some(e) -> body_code(e.text),
      None -> b"",
    };
  assert_eq(
    [b"m.later", b"m.same", b"m.sum"].map(|n: Bytes| code(n).index_of(b" < 0 ? 0 : ") != None),
    [true, true, false],
  );
  assert_eq(
    [b"m.later", b"m.same", b"m.sum"].map(|n: Bytes|
      [b"== INT64_C(2))", b"== INT64_C(1))", b"== INT64_C(0))"].filter(|r: Bytes|
        code(n).index_of(r) != None)),
    [[b"== INT64_C(2))"], [b"== INT64_C(1))"], [b"== INT64_C(0))"]],
  )
}

test "`Int` `/` and `%` use C's operators, and check for a zero divisor and for overflow unless the divisor is a literal other than 0 and -1" {
  let source = Bytes::concat_all([
    b"fn half(n: Int) -> Int = n / 2\n",
    b"fn rest(n: Int) -> Int = n % -7\n",
    b"fn folded(n: Int) -> Int / {abort.raise} = n / (1 << 5)\n",
    b"fn by(n: Int, d: Int) -> Int / {abort.raise} = n / d\n",
    b"fn by_minus_one(n: Int) -> Int = n / -1\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), 5);
  assert_eq(out.map(|e: EmittedRoot| body_code(e.text).index_of(b"ply_by_zero(") != None), [
    false,
    false,
    false,
    true,
    true,
  ]);
  assert_eq(out.map(|e: EmittedRoot| body_code(e.text).index_of(b"rt_arith_p(") != None), [
    false,
    false,
    false,
    false,
    false,
  ])
}

test "a `Decimal` is passed in registers as two machine words, and stored in a record or array as the same two words" {
  let source = Bytes::concat_all([
    b"type Line = { price: Decimal, qty: Int }\n",
    b"fn line(price: Decimal, qty: Int) -> Line = { price: price, qty: qty }\n",
    b"fn doubled(l: Line) -> Decimal = l.price * 2.00m\n",
    b"fn cheaper(a: Line, b: Line) -> Bool = a.price < b.price\n",
    b"fn negated(d: Decimal) -> Decimal = -d\n",
    b"fn priced(ds: Array<Decimal>, i: Int) -> Decimal / {abort.raise} = ds.get(i)\n",
    b"fn picked(up: Bool, d: Decimal) -> Decimal = if up { d + 1m } else { d - 1m }\n",
    b"fn listed(d: Decimal) -> List<{ price: Decimal }> = [{ price: d }]\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| e.text.index_of(text) != None);
  assert_eq(out.len(), 7);
  assert_eq(has(b"ply_alloc(ctx, INT64_C(32));"), [
    false,
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  assert_eq(has(b"ply_alloc(ctx, INT64_C(24));"), [
    false,
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  assert_eq(out.map(|e: EmittedRoot| body_code(e.text).index_of(b"ply_two_words") != None), [
    false,
    false,
    false,
    false,
    false,
    false,
    false,
  ]);
  let own = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(own(b"ply_dec_mul("), [false, true, false, false, false, false, false]);
  assert_eq(own(b"ply_dec_add("), [false, false, false, false, false, true, false]);
  assert_eq(own(b"ply_dec_order("), [false, false, true, false, false, false, false]);
  assert_eq(own(b"ply_dec_negated("), [false, false, false, true, false, false, false])
}

test "reading a field of a `Columns` element loads it from that field's own column without building the record" {
  let source = Bytes::concat_all([
    b"type P = { label: String, x: Float }\n",
    b"fn x_at(ps: Columns<P>, i: Int) -> Float / {abort.raise} = ps.get(i).x\n",
    b"fn label_at(ps: Columns<P>, i: Int) -> String / {abort.raise} = ps.get(i).label\n",
    b"fn whole(ps: Columns<P>, i: Int) -> List<P> / {abort.raise} = [ps.get(i)]\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| e.text.index_of(text) != None);
  assert_eq(out.len(), 3);
  assert_eq(has(b"ply_f64("), [true, false, true]);
  assert_eq(has(b"ply_alloc("), [false, false, false]);
  assert_eq(has(b"rt_alloc_p("), [false, false, false]);
  assert_eq(has(b"ply_refused(ctx, 6, "), [true, true, true])
}

test "a `Char` is a single machine word, and two `Char`s are compared with C's integer comparison" {
  let source = Bytes::concat_all([
    b"fn lower(c: Char) -> Bool = c >= 'a' && c <= 'z'\n",
    b"fn same(a: Char, b: Char) -> Bool = a == b\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  let has = |text: Bytes| out.map(|e: EmittedRoot| e.text.index_of(text) != None);
  assert_eq(out.len(), 2);
  assert_eq(has(b"rt_binary_p"), [false, false]);
  assert_eq(has(b"((Word)INT64_C(778))"), [true, false])
}

test "a record a pattern binds is read at the offsets its checked type gives" {
  let source = Bytes::concat_all([
    b"type Point = { x: Int, y: Int }\n",
    b"fn sum(ps: List<Point>) -> Int = match ps { [p, ..] -> p.x + p.y, _ -> 0 }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), 1)
}

test "the emitter writes an embed out as the front end's result says it was read: by its digest" {
  let source = b"fn data() -> Bytes = embed(\"d.txt\")\n";
  let want = { path: b"d.txt", dir: false };
  let d = dump_of(
    analyse_pulling_std_with(
      [{ name: b"m", source_text: source }],
      [],
      no_rows,
      { root: b"", manifest: None, supplied: [] },
      [{ root: b"", module: b"m", want: want, read: Ok([embed_file(b"", b"one")]) }],
    ).out,
  );
  let b = emit_root_results(
    [b"m"],
    [source],
    no_constructors,
    [Named(b"m.data")],
    [],
    [],
    d.embeds,
    d.rows,
    d.effects,
    d.inferred_facts,
  ).get(
    0,
  ).result;
  assert_eq(b.tables.statics, statics_of(EmbeddedDatum(b"one".blake3())))
}

test "an extern in a standard library module is called with raw machine values when its parameters are `Int` or records, and a call with other types fails to compile" {
  let names = [b"std.native", b"m"];
  let sources = [
    b"pub extern fn counted(x: { n: Int }) -> Int\npub extern fn doubled(x: Int) -> Int\n",
    b"import std.native (counted, doubled)\nimport std.native as n\nfn f() -> Int = counted({ n: 2 }) + n::counted({ n: 3 })\nfn g() -> Int = doubled(2) + n::doubled(3)\n",
  ];
  let d = dump_of(
    analyse_pulling_std_with(
      [{ name: b"m", source_text: sources.get(1) }],
      [{ name: b"std.native", source_text: sources.get(0) }],
      no_rows,
    ).out,
  );
  let results_of = |key: RootKey|
    emit_root_results(
      names,
      sources,
      constructors_of([], [], [], constructor_sums(d.constructors)),
      [key],
      [],
      [],
      d.embeds,
      d.rows,
      d.effects,
      d.inferred_facts,
    );
  match results_of(Named(b"m.g")).find(|a: RootOutput| a.name == root_name(Named(b"m.g"))) {
    Some(a) -> assert_eq(body_code(a.result.text).split(b"builtin_doubled_p(ctx, ").len(), 3),
    None -> panic("no result"),
  };
  let abort_message = handle {
    results_of(Named(b"m.f"));
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert(
    abort_message.contains(b"`m.f`") && abort_message.contains(b"counted"),
    Some(String::of_bytes_lossy(abort_message)),
  )
}

const inlined_extern_calls: List<{ name: Bytes, source_text: Bytes }> =
  [
    {
      name: b"map_root",
      source_text: b"(m: Map<Int, String>) -> Option<MapNode<Int, String>> = MapNode::root(m)",
    },
    { name: b"height", source_text: b"(m: Map<Int, String>) -> Int = MapNode::height(m)" },
    { name: b"count", source_text: b"(n: MapNode<Int, String>) -> Int = MapNode::count(n)" },
    { name: b"key", source_text: b"(n: MapNode<Int, String>) -> Int = MapNode::key(n, 1)" },
    { name: b"value", source_text: b"(n: MapNode<Int, String>) -> String = MapNode::value(n, 1)" },
    {
      name: b"kid",
      source_text: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid(n, 1)",
    },
    { name: b"kid_max", source_text: b"(n: MapNode<Int, String>) -> Int = MapNode::kid_max(n, 1)" },
    {
      name: b"kid_size",
      source_text: b"(n: MapNode<Int, String>) -> Int = MapNode::kid_size(n, 1)",
    },
    { name: b"leaf", source_text: b"() -> MapNode<Int, String> = MapNode::leaf()" },
    { name: b"map_branch", source_text: b"() -> MapNode<Int, String> = MapNode::branch()" },
    {
      name: b"pair_put",
      source_text: b"(n: MapNode<Int, String>, v: String) -> MapNode<Int, String> = MapNode::pair_put(n, 1, 5, v)",
    },
    {
      name: b"pair_set",
      source_text: b"(n: MapNode<Int, String>, v: String) -> MapNode<Int, String> = MapNode::pair_set(n, 1, 5, v)",
    },
    {
      name: b"pair_take",
      source_text: b"(n: MapNode<Int, String>) -> String = MapNode::pair_take(n, 1).value",
    },
    {
      name: b"leaf_cut",
      source_text: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::leaf_cut(n, 16).right",
    },
    {
      name: b"branch_cut",
      source_text: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::branch_cut(n, 16).left",
    },
    {
      name: b"kid_out",
      source_text: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_out(n, 1).kid",
    },
    {
      name: b"kid_back",
      source_text: b"(n: MapNode<Int, String>, k: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_back(n, 1, k, 9, 4)",
    },
    {
      name: b"kid_put",
      source_text: b"(n: MapNode<Int, String>, k: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_put(n, 1, k, 9, 4)",
    },
    {
      name: b"kid_drop",
      source_text: b"(n: MapNode<Int, String>) -> MapNode<Int, String> = MapNode::kid_drop(n, 1)",
    },
    {
      name: b"map_swap",
      source_text: b"(m: Map<Int, String>, r: MapNode<Int, String>) -> Map<Int, String> = MapNode::map_swap(m, Some(r), 1, 40).map",
    },
    { name: b"spelt", source_text: b"(b: Bytes) -> String = Utf8::spelt(b)" },
  ]

test "each extern implemented in Ply compiles to C that reads and writes runtime objects directly, and calls no native function" {
  let calls = inlined_extern_calls;
  let probes = calls.fold(b"\n", |accumulator: Bytes, c: { name: Bytes, source_text: Bytes }|
    Bytes::concat_all([accumulator, b"fn probe_", c.name, c.source_text, b"\n"]));
  let unprobed = intrinsics.filter(|i: { name: Bytes, operation: Intrinsic }|
    probes.index_of(i.name.slice(b"std.prelude.".len(), i.name.len()).concat(b"(")) == None);
  assert_eq(unprobed.map(|i: { name: Bytes, operation: Intrinsic }| i.name), []);
  let roots = calls.map(|c: { name: Bytes, source_text: Bytes }|
    b"std.prelude.probe_".concat(c.name));
  let results = outputs_at(
    [b"std.prelude"],
    [prelude_source::text.concat(probes)],
    [b"Some", b"None"],
    roots.map(Named),
  );
  let code = |name: Bytes|
    match results.find(|a: RootOutput| output_name(a) == b"std.prelude.probe_".concat(name)) {
      Some(a) -> body_code(a.result.text),
      None -> panic("no result for probe_" ++ String::of_bytes_lossy(name)),
    };
  assert_eq(
    calls.filter(|c: { name: Bytes, source_text: Bytes }|
      code(c.name).index_of(b"builtin_") != None).map(|c: { name: Bytes, source_text: Bytes }|
      c.name),
    [],
  );
  assert_eq(
    calls.filter(|c: { name: Bytes, source_text: Bytes }|
      header_fields(code(c.name)).any(|f: Bytes| f != b"rc")).map(
      |c: { name: Bytes, source_text: Bytes }| c.name,
    ),
    [],
  );
  let laid = container_layouts;
  let has = |name: Bytes, text: Bytes| code(name).index_of(text) != None;
  let field = |name: Bytes| b"))->".concat(name);
  let tree_node = |kind: Int| Bytes::concat_all([b"ply_node(ctx, ", ascii_of_int(kind), b", "]);
  let past = |from: Int| ascii_of_int(from).concat(b" + (");
  assert_eq(
    [
      has(b"height", field(b"height")),
      has(b"kid_max", past(branch_layout(1).keys)),
      has(b"kid_size", past(branch_layout(1).sizes)),
      has(b"leaf", tree_node(laid.tree.leaf)),
      has(b"map_branch", tree_node(laid.tree.branch)),
      has(b"branch_cut", tree_node(laid.tree.branch)),
      has(b"leaf_cut", tree_node(laid.tree.leaf)),
    ],
    [true, true, true, true, true, true, true],
  );
  let copy = |t: Type| keys::generated_key(keys::Copy, t, b"std.prelude");
  let copied = |name: Bytes, t: Type|
    match results.find(|a: RootOutput| output_name(a) == b"std.prelude.probe_".concat(name)) {
      Some(a) -> a.result.tables.calls.contains(copy(t)) && has(name, symbol_of(printed(copy(t)))),
      None -> false,
    };
  assert(copied(b"map_swap", map_type(int_type, string_type)), None)
}

test "a function that returns a record whose field is stored inside the record returns that field's values without allocating or counting references" {
  let probes = Bytes::concat_all([
    b"\nfn probe_key(n: MapNode<{ a: Int, b: Int }, Int>) -> { a: Int, b: Int } = MapNode::pair_take(n, 1).key\n",
    b"fn probe_sum(n: MapNode<{ a: Int, b: Int }, Int>) -> Int = { let t = MapNode::pair_take(n, 1); t.key.a + t.key.b + t.value }\n",
  ]);
  let names = [b"std.prelude.probe_key", b"std.prelude.probe_sum"];
  let results = outputs_at(
    [b"std.prelude"],
    [prelude_source::text.concat(probes)],
    [b"Some", b"None"],
    names.map(Named),
  );
  let code = names.map(|n: Bytes| body_code(output_body(results, n).text));
  assert_eq(code.filter(|c: Bytes| c.index_of(b" 0 = 0;") != None).len(), 0);
  assert_eq(code.filter(|c: Bytes| c.index_of(b"builtin_") != None).len(), 0);
  let text = code.get(0);
  assert(
    !increments_count(text) && text.index_of(b"[1 + ((INT64_C(1))) * 3]") != None
      && text.index_of(call_start(free_function, [])) == None,
    Some(String::of_bytes_lossy(text)),
  )
}

test "matching an array read as `Some` or `None` checks the index and reads the element directly from the array" {
  let source = b"fn arrayed(xs: Array<Int>, i: Int) -> Int = match xs.at(i) { Some(v) -> v, None -> 0 }\n";
  let out = emit_all_program([{ name: b"m", source_text: source }], [b"Some", b"None"], true);
  assert_eq(out.len(), 1);
  let calls = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  assert_eq(calls(b" < (uint64_t)((PlyArrayHead *)ply_words(p0))->len"), [true])
}

test "a list's item is read in place behind a test of its length, a generic read at its type" {
  let source = Bytes::concat_all([
    b"fn third(xs: List<String>) -> Option<String> = xs.at(2)\n",
    b"fn listed(xs: List<Int>, i: Int) -> Int = match xs.at(i) { Some(v) -> v, None -> 0 }\n",
    b"fn pushed<a>(xs: List<a>, x: a) -> List<a> = xs.push(x)\n",
    b"fn written(xs: List<Int>) -> List<Int> / {abort.raise} = xs.set(0, 1)\n",
    b"fn gathered(xs: List<String>) -> List<String> = xs.fold([], List::push)\n",
    b"type Held<a> = { item: Option<a>, n: Int }\n",
    b"fn nested<a>(xs: List<{ by: Held<a>, s: String }>, x: { by: Held<a>, s: String }) -> List<{ by: Held<a>, s: String }> = xs.push(x)\n",
  ]);
  let retired = [b"List::at", b"List::push", b"List::set", b"trie_pushed", b"trie_inserted"].map(
    |n: Bytes| qualify(prelude_module, n),
  );
  let results = outputs_at(
    [b"m"],
    [source],
    [b"Some", b"None"],
    [
      Named(b"m.third"),
      Named(b"m.listed"),
      Named(b"m.gathered"),
      Named(b"m.pushed"),
      Named(b"m.nested"),
    ].concat(
      retired.map(Named),
    ),
  );
  retired.fold((), |_: Unit, n: Bytes| assert_eq(output_body(results, n).text, b""));
  let called = |name: Bytes|
    output_body(results, name).tables.generics.calls.map(|g: GenericCall| g.callee);
  assert_eq([called(b"m.third"), called(b"m.listed"), called(b"m.gathered")], [[], [], []]);
  [b"m.pushed", b"m.nested"].fold((), |_: Unit, n: Bytes| {
    let generic = output_body(results, n);
    assert(generic.tables.generics.needs.any(|k: Need| k.reads == Layout), None);
    assert_eq(generic.text, b"")
  });
  let code = |name: Bytes| body_code(output_body(results, name).text);
  [b"m.third", b"m.listed"].fold((), |_: Unit, n: Bytes| {
    let text = code(n);
    assert(
      text.index_of(b"rt_list_") == None && text.index_of(b"builtin_") == None
        && text.index_of(b" < (uint64_t)((PlyTextHead *)ply_words(p0))->len") != None
        && text.index_of(item_function) != None,
      Some(String::of_bytes_lossy(text)),
    )
  })
}

test "a read of a list counts nothing it reads through it, and a caller counts the item where it keeps it" {
  let src = Bytes::concat_all([
    b"fn second(xs: List<String>) -> Option<String> = xs.at(1)\n",
    b"fn kept(xs: List<String>) -> List<Option<String>> = [second(xs)]\n",
  ]);
  let results = outputs_at([b"m"], [src], [b"Some", b"None"], [
    Named(b"m.second"),
    Named(b"m.kept"),
  ]);
  let counts = |name: Bytes|
    body_code(output_body(results, name).text).split(b"\n").filter(|l: Bytes|
      increments_count(l)).len(
    );
  assert_eq([b"m.second", b"m.kept"].map(counts), [0, 1])
}

fn test_generated_key(operation: TypeOperation, ty: Type) -> RootKey =
  keys::generated_key(operation, ty, b"m")

fn specialised_at(definition: Bytes, args: List<Bytes>) -> RootKey / {abort.raise} =
  specialisation_key(definition, parsed_types(args), [])

fn effects_generic_at(definition: Bytes, args: List<Bytes>) -> RootKey / {abort.raise} =
  keys::specialisation_key_with_effects(definition, parsed_types(args).map(keys::KeyType), [], [[]])

fn parsed_types(ss: List<Bytes>) -> List<Type> / {abort.raise} =
  ss.map(|s: Bytes|
    match decode_type(s) {
      Some(t) -> t,
      None -> panic(String::of_bytes_lossy(b"not the name of a type: ".concat(s))),
    })

fn outputs_at(
  names: List<Bytes>,
  sources: List<Bytes>,
  constructors: List<Bytes>,
  wanted: List<RootKey>,
  shipped: List<Source> = [],
  published: List<PublishedSignature> = [],
) -> List<RootOutput> / {abort.raise} = {
  let d = if shipped.len() == 0 { dump_of(analyse(parse_all(zip_sources(names, sources)))) }
  else { dump_of(analyse_pulling_std_with(zip_sources(names, sources), shipped, no_rows).out) };
  emit_root_results(
    shipped.map(|s: Source| s.name).concat(names),
    shipped.map(|s: Source| s.source_text).concat(sources),
    loaded_constructors(d, constructors),
    wanted,
    [],
    [],
    d.embeds,
    d.rows,
    d.effects,
    d.inferred_facts,
    published,
  )
}

const value_fixture: Source =
  {
    name: b"std.value",
    source_text: Bytes::concat_all([
      b"pub type Value = | VUnit | VBool(Bool) | VInt(Int) | VFloat(Float) | VDecimal(Decimal) | VFixed(String, U128) | VChar(Char) | VStr(String) | VBytes(Bytes) | VList(List<Value>) | VRecord(List<Field>) | VCtor(String, List<Value>) | VMap(List<Entry>) | VFn(Fun) | VHold | VSecret | VElided(Int) | VArray(List<Value>) | VShown(String)\n",
      b"pub type Field = { name: String, value: Value }\n",
      b"pub type Entry = { key: Value, value: Value }\n",
      b"pub type Fun = | FNamed(String) | FAnonymous | FConst({ arity: U8, value: Value }) | FProject({ arity: U8, index: U8 }) | FTable({ arity: U8, entries: List<Entry>, default: Value })\n",
      b"pub extern fn reflect<a>(x: a) -> Value\n",
      b"pub extern fn shown<a>(x: a) -> Value\n",
    ]),
  }

test "a generic definition used at a type that is not a single machine word is emitted again for that type" {
  let source = Bytes::concat_all([
    b"fn twice<a>(x: a) -> a where numeric(a) = x + x\n",
    b"fn go(f: Float) -> Float = twice(f)\n",
    b"fn id<a>(x: a) -> a = x\n",
    b"fn same(s: String) -> String = id(s)\n",
    b"fn down<a>(n: Int, x: a) -> a where numeric(a) = if n <= 0 { x } else { down(n - 1, x + x) }\n",
    b"fn fall(n: Int) -> Int = down(n, 1)\n",
  ]);
  let wanted = [b"m.go", b"m.same", b"m.fall", b"m.twice", b"m.id"].map(Named).concat([
    specialised_at(b"m.twice", [b"Float"]),
    specialised_at(b"m.down", [b"Int"]),
  ]);
  let results = outputs_at([b"m"], [source], [], wanted);
  let body = |name: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == name { Some(a) } else { accumulator }) {
      Some(a) -> a.result,
      None -> panic("no result"),
    };
  let has = |name: Bytes, text: Bytes| body(name).text.index_of(text) != None;
  assert(has(b"m.go", b"@@g0@@"));
  assert_eq(body(b"m.go").tables.generics.calls, [
    {
      callee: Named(b"m.twice"),
      args: parsed_types([b"Float"]),
      specialised_variables: [0],
      functions: [],
      effect_evidence: [],
    },
  ]);
  assert_eq(body(b"m.same").tables.generics.calls, [
    {
      callee: Named(b"m.id"),
      args: parsed_types([b"String"]),
      specialised_variables: [],
      functions: [],
      effect_evidence: [],
    },
  ]);
  assert(body(b"m.twice").tables.generics.needs.contains({ var: 0, reads: Scalar }), None);
  assert_eq(body(b"m.id").tables.generics.needs, []);
  assert(body(b"m.id").text.len() > 0, None);
  assert(has(b"m.twice@Float", b"double "));
  assert(!has(b"m.twice@Float", b"numeric_binary"));
  assert(has(b"m.down@Int", b"goto ply_loop;"));
  assert(!has(b"m.down@Int", b"numeric_binary"));
  assert_eq(body(b"m.down@Int").tables.calls, [])
}

test "a call passes along a type variable's type, which changes how a parameter or result of that type is represented" {
  let source = Bytes::concat_all([
    b"fn first<a>(xs: List<a>) -> Option<a> = xs.at(0)\n",
    b"fn rest<a>(xs: List<a>) -> List<a> = xs\n",
    b"fn floats(xs: List<Float>) -> Float = match first(xs) { Some(x) -> x, None -> 0.0 }\n",
    b"fn tails(xs: List<Float>) -> Int = rest(xs).len()\n",
  ]);
  let results = outputs_at([b"m"], [source], [], [Named(b"m.floats"), Named(b"m.tails")]);
  let calls = |name: Bytes|
    match results.fold(None, |accumulator: Option<RootOutput>, a: RootOutput|
        if output_name(a) == name { Some(a) } else { accumulator }) {
      Some(a) -> a.result.tables.generics.calls,
      None -> panic("no result"),
    };
  assert_eq(calls(b"m.floats"), [
    {
      callee: Named(b"m.first"),
      args: parsed_types([b"Float"]),
      specialised_variables: [0],
      functions: [],
      effect_evidence: [],
    },
  ]);
  assert_eq(calls(b"m.tails"), [
    {
      callee: Named(b"m.rest"),
      args: parsed_types([b"Float"]),
      specialised_variables: [],
      functions: [],
      effect_evidence: [],
    },
  ])
}

test "a contract's clauses read the parameters, and an `ensures` the result, at the types the scheme gives them" {
  let source = Bytes::concat_all([
    b"type Account = { name: String, balance: Int }\n",
    b"fn adjusted(account: Account, amount: Int) -> Account\n",
    b"  requires account.balance > 0 - 1000000\n",
    b"  ensures result.balance == account.balance + amount\n",
    b"  ensures result.name == account.name\n",
    b"= { name: account.name, balance: account.balance + amount }\n",
    b"fn kept<a>(xs: List<a>, n: Int) -> List<a>\n",
    b"  requires n <= xs.len()\n",
    b"  ensures result.len() == xs.len()\n",
    b"= xs\n",
  ]);
  let clause = |definition: Bytes, kind: ClauseKind, n: Int|
    Clause({ definition: Named(definition), kind: kind, n: n });
  let keyed = [
    clause(b"m.adjusted", Requires, 0),
    clause(b"m.adjusted", Ensures, 0),
    clause(b"m.adjusted", Ensures, 1),
    clause(b"m.kept", Requires, 0),
    clause(b"m.kept", Ensures, 0),
  ];
  let wanted = keyed.map(root_name);
  let results = outputs_at([b"m"], [source], [], keyed);
  assert_eq(results.fold([], |accumulator: List<Bytes>, r: RootOutput| { accumulator }), []);
  assert_eq(wanted.filter(|w: RootName| !results.any(|r: RootOutput| r.name == w)), [])
}

test "a call inside a mutually recursive group names its callee in the caller's type variables, although each function numbers its type variables separately" {
  let source = Bytes::concat_all([
    b"fn f<a, b>(x: a, y: b, n: Int) -> b = if n <= 0 { y } else { let r = g(y, x, n - 1); r }\n",
    b"fn g<c, d>(x: c, y: d, n: Int) -> c = if n <= 0 { x } else { let r = f(y, x, n - 1); r }\n",
  ]);
  let results = outputs_at([b"m"], [source], [], [
    specialised_at(b"m.f", [b"Int", b"String"]),
    specialised_at(b"m.g", [b"String", b"Int"]),
  ]);
  let tables = |name: Bytes| output_body(results, name).tables;
  let called = |name: Bytes|
    tables(name).generics.calls.map(|g: GenericCall| { callee: g.callee, args: g.args });
  assert_eq(called(b"m.f@Int,String"), [
    { callee: Named(b"m.g"), args: parsed_types([b"String", b"Int"]) },
  ]);
  assert_eq(called(b"m.g@String,Int"), [
    { callee: Named(b"m.f"), args: parsed_types([b"Int", b"String"]) },
  ]);
  assert_eq([b"m.f@Int,String", b"m.g@String,Int"].map(|n: Bytes| tables(n).generics.needs), [
    [],
    [],
  ])
}

fn loops_in(results: List<RootOutput>, name: Bytes) -> Bool / {abort.raise} =
  output_body(results, name).text.index_of(b"goto ply_loop;") != None

test "a tail loop runs at the types it is called with, and each function in it runs at the type arguments its caller gives" {
  let source = Bytes::concat_all([
    b"fn spin<a, b>(x: a, y: b, n: Int) -> Int = if n <= 0 { 0 } else { spin(y, x, n - 1) }\n",
    b"fn ping<a>(x: a, n: Int) -> a = if n <= 0 { x } else { pong(x, n - 1) }\n",
    b"fn pong<a>(x: a, n: Int) -> a = if n <= 0 { x } else { ping(x, n - 1) }\n",
    b"fn go() -> Float = { let _ = spin(1.5, 7, 3); ping(1.5, 3) }\n",
  ]);
  let results = outputs_at([b"m"], [source], [], [
    Named(b"m.go"),
    Named(b"m.spin"),
    specialised_at(b"m.spin", [b"Float", b"Int"]),
    Named(b"m.ping"),
    Named(b"m.pong"),
    specialised_at(b"m.pong", [b"Float"]),
  ]);
  let body = |name: Bytes| output_body(results, name);
  let loops = |name: Bytes| loops_in(results, name);
  assert_eq(body(b"m.go").tables.generics.calls, [
    {
      callee: Named(b"m.spin"),
      args: parsed_types([b"Float", b"Int"]),
      specialised_variables: [0, 1],
      functions: [],
      effect_evidence: [],
    },
    {
      callee: Named(b"m.ping"),
      args: parsed_types([b"Float"]),
      specialised_variables: [0],
      functions: [],
      effect_evidence: [],
    },
  ]);
  assert_eq(body(b"m.spin").text, b"");
  assert_eq(body(b"m.spin@Float,Int").tables.members.map(printed), [
    b"m.spin@Float,Int",
    b"m.spin@Int,Float",
  ]);
  assert(loops(b"m.spin@Float,Int"));
  assert_eq(body(b"m.spin@Float,Int").tables.generics.calls, []);
  assert_eq(body(b"m.ping").text, b"");
  assert_eq(body(b"m.ping").tables.members, [Named(b"m.ping"), Named(b"m.pong")]);
  assert_eq(body(b"m.ping").tables.generics.needs, [{ var: 0, reads: Exact }]);
  assert_eq(body(b"m.ping@Float").tables.members.map(printed), [b"m.ping@Float", b"m.pong@Float"]);
  assert(loops(b"m.ping@Float"));
  assert_eq(
    (body(b"m.ping@Float").tables.generics.needs, body(b"m.ping@Float").tables.generics.calls),
    ([], []),
  )
}

test "a tail loop whose functions name their type variables differently still compiles to one loop at the types each call gives" {
  let source = Bytes::concat_all([
    b"fn f<a, b>(x: a, y: b, n: Int) -> b = if n <= 0 { y } else { g(y, x, n - 1) }\n",
    b"fn g<c, d>(x: c, y: d, n: Int) -> c = if n <= 0 { x } else { f(y, x, n - 1) }\n",
  ]);
  let results = outputs_at([b"m"], [source], [], [specialised_at(b"m.g", [b"String", b"Int"])]);
  let looped = output_body(results, b"m.f@Int,String");
  assert_eq(looped.tables.members.map(printed), [b"m.f@Int,String", b"m.g@String,Int"]);
  assert(loops_in(results, b"m.f@Int,String"));
  assert_eq(looped.tables.generics.needs, [])
}

fn types_in(c: Code) -> List<Type> =
  code_children(c).fold([c.ty], |accumulator: List<Type>, x: Code| accumulator.concat(types_in(x)))

test "a type that nothing in the program determines is `Unit`, so a body without type variables needs no type arguments" {
  let source = Bytes::concat_all([
    b"fn empty() -> Int = { let xs = []; xs.len() }\n",
    b"fn wrapped(n: Int) -> Bool = match Ok(n) { Ok(_) -> true, Err(_) -> false }\n",
    b"fn nothing() -> Int = match None { Some(_) -> 1, None -> 0 }\n",
    b"fn fresh() -> Int = Map::new().len()\n",
    b"fn made(n: Int) -> Int = { let f = |x: Int| []; f(n).len() }\n",
    b"fn pair(n: Int) -> Int = match (n, []) { (k, _) -> k }\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let open = p.roots.filter(|r: Root| types_in(r.code).any(has_variables));
      assert_eq(open.map(|r: Root| printed(r.key)), []);
      let empty = p.roots.filter(|r: Root| printed(r.key) == b"m.empty");
      assert(empty.all(|r: Root| types_in(r.code).contains(list_type(unit_type))), None)
    },
  }
}

test "a tail loop through method calls on a value compiles to one loop at the types it is called with" {
  let source = Bytes::concat_all([
    b"type Countdown = new { left: Int }\n",
    b"fn Countdown::even_at<a>(c: Countdown, x: a) -> a = if c.left <= 0 { x } else { let next: Countdown = { left: c.left - 1 }; next.odd_at(x) }\n",
    b"fn Countdown::odd_at<a>(c: Countdown, x: a) -> a = if c.left <= 0 { x } else { let next: Countdown = { left: c.left - 1 }; next.even_at(x) }\n",
  ]);
  let results = outputs_at([b"m"], [source], [], [
    specialised_at(b"m.Countdown::odd_at", [b"Float"]),
  ]);
  let looped = output_body(results, b"m.Countdown::even_at@Float");
  assert_eq(looped.tables.members.map(printed), [
    b"m.Countdown::even_at@Float",
    b"m.Countdown::odd_at@Float",
  ]);
  assert(loops_in(results, b"m.Countdown::even_at@Float"))
}

test "a generic definition used at a record type reads the record at the offsets its layout gives" {
  let source = b"fn first<a, b>(p: { l: a, r: b }) -> a = p.l\nfn pick(q: { l: { x: Float, y: Float }, r: Int }) -> Float = first(q).x\n";
  let at = specialised_at(b"m.first", [b"{x:Float,y:Float}", b"Int"]);
  let laid = printed(at);
  let results = outputs_at([b"m"], [source], [], [Named(b"m.pick"), Named(b"m.first"), at]);
  let text = |name: Bytes|
    match results.fold(None, |accumulator: Option<Bytes>, a: RootOutput|
        if output_name(a) == name { Some(a.result.text) } else { accumulator }) {
      Some(t) -> t,
      None -> panic("no result"),
    };
  let tables = |name: Bytes|
    match results.fold(None, |accumulator: Option<Tables>, a: RootOutput|
        if output_name(a) == name { Some(a.result.tables) } else { accumulator }) {
      Some(t) -> t,
      None -> panic("no result"),
    };
  assert_eq(tables(b"m.pick").generics.calls, [
    {
      callee: Named(b"m.first"),
      args: parsed_types([b"{x:Float,y:Float}", b"Int"]),
      specialised_variables: [0, 1],
      functions: [],
      effect_evidence: [],
    },
  ]);
  assert_eq(text(b"m.first"), b"");
  assert(
    [0, 1].all(|v: Int| tables(b"m.first").generics.needs.contains({ var: v, reads: Layout })),
    None,
  )
}

test "a generic call passing a record with a multi-word sum field passes it the way the specialised function expects" {
  let source = Bytes::concat_all([
    b"type Term = | Num(Int) | Name(Bytes)\n",
    b"fn put<a>(xs: List<a>, x: a) -> List<a> = xs.push(x)\n",
    b"fn added(xs: List<{ name: Bytes, term: Term }>, e: { name: Bytes, term: Term }) -> List<{ name: Bytes, term: Term }> = put(xs, e)\n",
  ]);
  let at = specialised_at(b"m.put", [b"{name:Bytes,term:m.Term}"]);
  let laid = printed(at);
  let results = outputs_at([b"m"], [source], [b"m.Num", b"m.Name"], [Named(b"m.added"), at]);
  let body = |name: Bytes|
    match results.find(|a: RootOutput| output_name(a) == name) {
      Some(a) -> a.result,
      None -> panic(String::of_bytes_lossy(b"no result for ".concat(name))),
    };
  assert_eq(
    body(b"m.added").tables.generics.calls.map(|g: GenericCall| g.specialised_variables),
    [[0]],
  );
  let written = body(b"m.added").tables.generics.expects.map(|e: ExpectedPrototype| e.head);
  assert_eq(written, body(laid).tables.defined.map(|d: DefinitionSymbol| d.head));
  assert(written.all(|h: Prototype| h.params.len() > 3), None)
}

test "a constructor rebuilt from the matched value with one field changed compiles for every choice of type arguments" {
  let source = Bytes::concat_all([
    b"type Order = | Less | Greater | Same\n",
    b"type Tree<p, a> = | Leaf | Node(Int, Int, p, Int, a, Tree<p, a>, Tree<p, a>)\n",
    b"fn shifted<p, a>(tree: Tree<p, a>, by: Int) -> Tree<p, a> = match tree { Leaf -> Leaf, Node(rank, shift, priority, seq, value, left, right) -> Node(rank, shift + by, priority, seq, value, left, right) }\n",
    b"fn made<p, a>(priority: p, seq: Int, value: a, left: Tree<p, a>, right: Tree<p, a>) -> Tree<p, a> = match left { Leaf -> Node(1, 0, priority, seq, value, right, Leaf), Node(l, _, _, _, _, _, _) -> match right { Leaf -> Node(1, 0, priority, seq, value, left, Leaf), Node(r, _, _, _, _, _, _) -> if l >= r { Node(r + 1, 0, priority, seq, value, left, right) } else { Node(l + 1, 0, priority, seq, value, right, left) } } }\n",
    b"fn joined<p, a>(order: (p, p) -> Order, x: Tree<p, a>, dx: Int, y: Tree<p, a>, dy: Int) -> Tree<p, a> = match x { Leaf -> if dy == 0 { y } else { shifted(y, dy) }, Node(_, sx, px, qx, vx, lx, rx) -> match y { Leaf -> if dx == 0 { x } else { shifted(x, dx) }, Node(_, sy, py, qy, vy, ly, ry) -> { let cx = dx + sx; let cy = dy + sy; if match order(px, py) { Less -> true, Greater -> false, Same -> qx + cx < qy + cy } { made(px, qx + cx, vx, if cx == 0 { lx } else { shifted(lx, cx) }, joined(order, rx, cx, y, dy)) } else { made(py, qy + cy, vy, if cy == 0 { ly } else { shifted(ly, cy) }, joined(order, x, dx, ry, cy)) } } } }\n",
  ]);
  let ats = [[b"Int", b"Int"], [b"String", b"Int"]].fold(
    [],
    |accumulator: List<RootKey>, args: List<Bytes>|
      accumulator.push(specialised_at(b"m.shifted", args)).push(specialised_at(b"m.joined", args)),
  );
  let results = outputs_at(
    [b"m"],
    [source],
    [b"m.Leaf", b"m.Node", b"m.Less", b"m.Greater", b"m.Same"],
    ats.push(Named(b"m.shifted")).push(Named(b"m.joined")),
  );
  assert_eq(results.fold([], |accumulator: List<Bytes>, a: RootOutput| { accumulator }), [])
}

test "when a call fixes both type arguments of a generic record parameter and result, the callee is compiled for them and passes the record as separate fields" {
  let source = Bytes::concat_all([
    b"fn top<k, v>(es: List<{ key: k, value: v }>, d: { key: k, value: v }) -> { key: k, value: v } =\n",
    b"  match es.at(0) { Some(e) -> e, None -> d }\n",
    b"fn used(es: List<{ key: Int, value: Int }>) -> Int = top(es, { key: 0, value: 0 }).value\n",
  ]);
  let at = specialised_at(b"m.top", [b"Int", b"Int"]);
  let laid = printed(at);
  let results = outputs_at([b"m"], [source], [], [Named(b"m.used"), at]);
  let body = |name: Bytes|
    match results.find(|a: RootOutput| output_name(a) == name) {
      Some(a) -> a.result,
      None -> panic(String::of_bytes_lossy(b"no result for ".concat(name))),
    };
  assert_eq(body(b"m.used").tables.generics.calls.map(|g: GenericCall| g.specialised_variables), [
    [0, 1],
  ]);
  let written = body(b"m.used").tables.generics.expects.map(|e: ExpectedPrototype| e.head);
  assert_eq(written, body(laid).tables.defined.map(|d: DefinitionSymbol| d.head));
  assert(written.all(|h: Prototype| h.params.len() > 2 && h.result != b"Word"), Some(f"{written}"))
}

test "an operator the checker recorded for a definition's type variable is emitted for the concrete type the call uses" {
  let source = b"fn same<a>(x: a, y: a) -> Bool = x == y\nfn floats(x: Float, y: Float) -> Bool = same(x, y)\n";
  let results = outputs_at([b"m"], [source], [], [
    Named(b"m.same"),
    Named(b"m.floats"),
    specialised_at(b"m.same", [b"Float"]),
  ]);
  let texts = results.map(|a: RootOutput| a.result.text);
  assert_eq(results.map(output_name), [b"m.same@Float", b"m.same", b"m.floats"]);
  assert_eq(texts.get(1), b"");
  let same = match results.at(1) { Some(a) -> a.result.tables.generics.needs, None -> [] };
  assert_eq(same, [{ var: 0, reads: Exact }])
}

test "a body is emitted identically whatever other constructors the program declares" {
  let m = b"pub type Shape = | Dot | Line(Int)\nfn f(s: Shape) -> Int = match s { Dot -> 0, Line(n) -> n }\nfn g() -> Shape = Line(1)\n";
  let wanted = [Named(b"m.f"), Named(b"m.g")];
  let alone = outputs_at([b"m"], [m], [b"m.Dot", b"m.Line"], wanted);
  let beside = outputs_at([b"m"], [m], [b"a.One", b"a.Two", b"m.Dot", b"m.Line"], wanted);
  assert_eq(alone, beside);
  assert(alone.len() == 2)
}

test "a module the requested function does not use compiles to the same C from a stub of its signatures plus the analysis results as from its full source" {
  let a = b"import b\nfn f(x: Int) -> Int = b::g(x) + 1\n";
  let b = b"pub fn g(x: Int) -> Int = x * 2\ntest \"doubles\" { assert(g(1) == 2) }\n";
  let parsed = parse_all([{ name: b"a", source_text: a }, { name: b"b", source_text: b }]);
  let d = dump_of(analyse(parsed));
  let stub = stub_module(b, parsed.get(1).module);
  assert(stub.index_of(b"x * 2") == None);
  let call = |sources: List<Bytes>|
    emit_root_results(
      [b"a", b"b"],
      sources,
      no_constructors,
      [Named(b"a.f")],
      [],
      [],
      [],
      d.rows,
      d.effects,
      d.inferred_facts,
    );
  assert_eq(call([a, stub]), call([a, b]))
}

fn site_fixture(above: Bytes) -> List<Source> =
  site_fixture_with(above, b"{ ..p, x: b::twice(p.x) + 1 }")

fn site_fixture_with(above: Bytes, body: Bytes) -> List<Source> =
  [
    {
      name: b"a",
      source_text: Bytes::concat_all([
        b"import b\ntype P = { x: Int, y: Int }\n",
        above,
        b"fn moved(p: P) -> P = ",
        body,
        b"\ntest \"moves\" { assert(moved({ x: 1, y: 2 }).x == 3) }\n",
      ]),
    },
    { name: b"b", source_text: b"pub fn twice<a>(x: a) -> a\n  where numeric(a)\n= x + x\n" },
  ]

fn site_fixture_outputs(sources: List<Source>, d: Dump) -> List<RootOutput> / {abort.raise} =
  emit_root_results(
    sources.map(|s: Source| s.name),
    sources.map(|s: Source| s.source_text),
    loaded_constructors(d, []),
    [Named(b"a.moved"), test_key(b"a", b"moves"), Named(b"b.twice")],
    [],
    [],
    [],
    d.rows,
    d.effects,
    d.inferred_facts,
  )

test "a body is lowered from the facts recorded for it, whether they come from a fresh analysis or from stored results" {
  let walked = dump_of(analyse(parse_all(site_fixture(b""))));
  let recorded = walked.rows.definitions.fold(b"", |accumulator: Bytes, row: KnownDefinitionRow|
    if row.name == b"a.moved" { row.facts } else { accumulator });
  match decode_facts(recorded, 0, b"a.moved") {
    None -> panic("the row records what the walk read"),
    Some(f) -> assert(f.bodies.len() > 0),
  };
  let seeded = analyse_with(parse_all(site_fixture(b"")), walked.rows);
  match seeded {
    emitter_input::Rejected(_) -> panic("the test program fails to check"),
    emitter_input::Analysed(w) ->
      assert_eq(front::not_written(w.checked.seeded), [b"b.twice", b"a.moved"]),
  };
  assert_eq(
    site_fixture_outputs(site_fixture(b""), dump_of(seeded)),
    site_fixture_outputs(site_fixture(b""), walked),
  )
}

fn analysed_with_rows(
  sources: List<Source>,
  rows: Rows,
) -> emitter_input::AnalysisOutcome / {abort.raise} =
  analyse_pulling_std_with(sources, [], rows).out

test "a body lowered from stored facts is still correct after its definition moves in the file" {
  let before = dump_of(analysed_with_rows(site_fixture(b""), no_rows));
  let after = site_fixture(b"// a comment, and a definition, above it\nfn aside() -> Int = 7\n");
  let seeded = analysed_with_rows(after, before.rows);
  match seeded {
    emitter_input::Rejected(_) -> panic("the test program fails to check"),
    emitter_input::Analysed(w) -> {
      assert_eq(front::not_written(w.checked.seeded), [b"b.twice", b"a.moved"]);
      assert_eq(
        w.checked.seeded.filter(|n: Bytes| front::used_prelude_functions.contains(n)),
        front::used_prelude_functions,
      )
    },
  };
  assert_eq(
    site_fixture_outputs(after, dump_of(seeded)),
    site_fixture_outputs(after, dump_of(analysed_with_rows(after, no_rows))),
  )
}

const connections: Bytes =
  b"opaque type Conn = | Conn(Int)\nrelease for Conn by close\nfn close(c: keep Conn) -> Unit = match c { Conn(n) -> () }\nfn open() -> Conn = Conn(1)\nfn send(c: Conn, n: Int) -> Int = n\n"

const owning: Bytes = b"{ let c = open(); { ..p, x: send(c, 3) } }"

test "a body lowered from stored facts still releases the values it owns after its definition moves in the file" {
  let before = dump_of(analysed_with_rows(site_fixture_with(connections, owning), no_rows));
  let after = site_fixture_with(b"// a comment above it\n".concat(connections), owning);
  assert_eq(
    site_fixture_outputs(after, dump_of(analysed_with_rows(after, before.rows))),
    site_fixture_outputs(after, dump_of(analysed_with_rows(after, no_rows))),
  )
}

test "the facts recorded for a body are the same wherever its definition appears in the file" {
  let facts_of = |sources: List<Source>| {
    let d = dump_of(analysed_with_rows(sources, no_rows));
    d.rows.definitions.fold(b"", |accumulator: Bytes, row: KnownDefinitionRow|
      if row.name == b"a.moved" { row.facts } else { accumulator })
  };
  let here = facts_of(site_fixture(b""));
  assert(here.len() > 1);
  assert_eq(
    facts_of(site_fixture(b"// a comment, and a definition, above it\nfn aside() -> Int = 7\n")),
    here,
  );
  assert_eq(
    facts_of(site_fixture_with(b"// a comment above it\n".concat(connections), owning)),
    facts_of(site_fixture_with(connections, owning)),
  )
}

test "a module's functions are lowered only from an analysis result that includes the facts its check recorded" {
  let sources = site_fixture(b"");
  let d = dump_of(analyse(parse_all(sources)));
  let abort_message = |dump: Dump|
    handle {
      site_fixture_outputs(sources, dump);
      b""
    } with {
      abort.raise(m) -> Bytes::of_string(m),
    };
  let unread = abort_message({ ..d, rows: { ..d.rows, definitions: [] } });
  assert(unread.contains(b"has no definitions for"), Some(String::of_bytes_lossy(unread)));
  assert(
    abort_message({ ..d, inferred_facts: b"" }) != b"",
    Some("a result with nothing read lowers nothing"),
  )
}

test "a requested function is compiled even when the analysis lists no tests, and a requested test missing from the analysis fails" {
  let sources = site_fixture(b"");
  let d = dump_of(analyse(parse_all(sources)));
  let call = |wanted: List<RootKey>|
    emit_root_results(
      sources.map(|s: Source| s.name),
      sources.map(|s: Source| s.source_text),
      no_constructors,
      wanted,
      [],
      [],
      [],
      { ..d.rows, tests: [] },
      d.effects,
      d.inferred_facts,
    );
  assert_eq(call([Named(b"a.moved")]).map(output_name), [b"a.moved"]);
  let abort_message = handle {
    call([test_key(b"a", b"moves")]);
    b""
  } with {
    abort.raise(m) -> Bytes::of_string(m),
  };
  assert(
    abort_message != b"",
    Some("a test the result contains nothing of is not lowered from a guess"),
  )
}

const append_block_start: Bytes = b"{ int64_t sl = "

fn without_appends(text: Bytes) -> Bytes / {abort.raise} = {
  let parts = text.split(append_block_start);
  Bytes::concat_all(
    parts.take(1).concat(
      parts.drop(1).map(|p: Bytes|
        match p.index_of(b"; } }") { Some(e) -> p.slice(e + 5, p.len()), None -> b"" }),
    ),
  )
}

const body_else: Bytes = b"\n  } else {"

test "a buffer read from a record that the body alone owns is appended to without being copied" {
  let source = Bytes::concat_all([
    b"type S = { out: Bytes, n: Int }\n",
    b"type W = { out: Bytes, n: Int, a: Int, b: Int }\n",
    b"type T = | T(Bytes, Int)\n",
    b"fn pattern(s: S, fuel: Int) -> Bytes = { let { out, n } = s; if n <= 0 || fuel <= 0 { out } else { pattern({ out: out ++ b\"x\", n: n - 1 }, fuel - 1) } }\n",
    b"fn ctor(t: T, fuel: Int) -> Bytes = match t { T(out, n) -> if n <= 0 || fuel <= 0 { out } else { ctor(T(out ++ b\"x\", n - 1), fuel - 1) } }\n",
    b"fn update(s: S, fuel: Int) -> Bytes = if s.n <= 0 || fuel <= 0 { s.out } else { update({ ..s, out: s.out ++ b\"x\", n: s.n - 1 }, fuel - 1) }\n",
    b"fn fields(s: S, fuel: Int) -> Bytes = { let n = s.n; let out = s.out; if n <= 0 || fuel <= 0 { out } else { fields({ out: out ++ b\"x\", n: n - 1 }, fuel - 1) } }\n",
    b"fn iterated(n: Int) -> Bytes / {abort.raise} = iterate({ out: b\"\", n: n }, n + 1, |s: S| if s.n <= 0 { Stop(s.out) } else { Continue({ out: s.out ++ b\"x\", n: s.n - 1 }) })\n",
    b"fn folded(n: Int) -> Bytes = range(0, n).fold({ out: b\"\", n: 0 }, |s: S, _: Int| { out: s.out ++ b\"x\", n: s.n + 1 }).out\n",
    b"fn widened(n: Int) -> Bytes / {abort.raise} = iterate({ out: b\"\", n: n, a: 0, b: 0 }, n + 1, |s: W| if s.n <= 0 { Stop(s.out) } else { Continue({ out: s.out ++ b\"x\", n: s.n - 1, a: s.a, b: s.b }) })\n",
    b"fn guarded(t: T, k: Int) -> Bytes = match t { T(out, n) if n > k -> out ++ b\"y\", T(out, _) -> out }\n",
  ]);
  let keyed = [
    b"m.pattern",
    b"m.ctor",
    b"m.update",
    b"m.fields",
    b"m.iterated",
    b"m.folded",
    b"m.widened",
    b"m.guarded",
  ].map(
    Named,
  );
  let names = keyed.map(printed);
  let results = outputs_at([b"m"], [source], [b"Stop", b"Continue", b"m.T"], keyed);
  let code = |name: Bytes| body_code(output_body(results, name).text);
  assert_eq(
    names.filter(|n: Bytes| {
      let body = code(n);
      match body.index_of(append_block_start) {
        Some(c) -> increments_count(body.slice(0, c)) || allocates(without_appends(body)),
        None -> true,
      }
    }),
    [],
  )
}

test "a sum whose cases store their fields separately is released by those cases wherever it is stored, including boxed inside another sum" {
  let source = Bytes::concat_all([
    b"type Place = { param: Int, path: List<Bytes> }\n",
    b"type Base = | PlaceBase(Place) | QuotientBase({ of: Base, by: Int }) | RemainderBase({ by: Base })\n",
    b"type Linear = { base: Option<Base>, k: Int }\n",
    b"type Term = | Exactly(Linear) | Below(Place) | RecordTerm({ base: Option<Term>, fields: List<Term> }) | NoParts | Wrapped(Term) | UnknownTerm\n",
    b"type Summary = { names: List<Bytes>, result: Term }\n",
    b"effect ask {\n  write op(n: Int) -> Int\n}\n",
    b"fn base_of(t: Term) -> Option<Term> = match t { RecordTerm(r) -> r.base, Wrapped(w) -> Some(w), _ -> None }\n",
    b"fn deep(t: Term) -> Int = match base_of(t) { Some(b) -> match base_of(b) { Some(_) -> 2, None -> 1 }, None -> 0 }\n",
    b"fn rebuilt(t: Term) -> Term = match t { RecordTerm(r) -> RecordTerm({ base: r.base, fields: r.fields }), _ -> t }\n",
    b"fn summed(t: Term) -> Int = { let s = { names: [b\"a\"], result: rebuilt(t) }; s.names.len() + deep(s.result) }\n",
    b"fn listed(t: Term) -> Int = [t, Wrapped(t)].len()\n",
    b"fn captured(t: Term) -> Int = [1, 2, 3].fold(0, |acc: Int, x: Int| acc + x * deep(t))\n",
    b"fn across(t: Term) -> Int / {ask.op} = { let k = ask.op(1); k + deep(t) }\n",
    b"fn handled(t: Term) -> Int = handle { across(t) } with { ask.op(k) -> k + deep(t) }\n",
    b"fn named(t: Term) -> List<{ name: Bytes, term: Term }> = [{ name: b\"a\", term: t }].push({ name: b\"b\", term: Wrapped(t) })\n",
    b"fn terms(t: Term) -> List<Term> = named(t).map(|f: { name: Bytes, term: Term }| f.term)\n",
    b"fn first_base(ts: List<Term>) -> Option<Term> = ts.fold(None, |acc: Option<Term>, t: Term| match acc { Some(_) -> acc, None -> base_of(t) })\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert(out.len() > 0, None);
  assert_eq(
    [
      b"m.rebuilt",
      b"m.summed",
      b"m.listed",
      b"m.captured",
      b"m.handled",
      b"m.named",
      b"m.terms",
      b"m.first_base",
    ].filter(|n: Bytes| !out.any(|e: EmittedRoot| emitted_name(e) == n)),
    [],
  )
}

test "a scalar read from an `Option` needs no reference count, however the `Option` was made" {
  let source = Bytes::concat_all([
    b"fn some_char(c: Char) -> Option<Char> = Some(c)\n",
    b"fn some_int(n: Int) -> Option<Int> = if n > 0 { Some(n) } else { None }\n",
    b"fn some_float(x: Float) -> Option<Float> = Some(x)\n",
    b"fn some_bool(b: Bool) -> Option<Bool> = Some(b)\n",
    b"fn char_of(n: Int) -> Char = match Char::of_int(n) { Some(c) -> c, None -> 'x' }\n",
    b"fn shifted(c: Char, by: Int) -> Char = match Char::of_int(Int::of_char(c) + by) { Some(other) -> other, None -> c }\n",
    b"fn found(h: Bytes) -> Int = match h.index_of(b\"a\") { Some(i) -> i, None -> 0 }\n",
    b"fn parsed(s: String) -> Float = match Float::of_string(s) { Some(x) -> x, None -> 0.0 }\n",
    b"fn char_back(c: Char) -> Char = match some_char(c) { Some(d) -> d, None -> c }\n",
    b"fn int_back(n: Int) -> Int = match some_int(n) { Some(m) -> m, None -> 0 }\n",
    b"fn float_back(x: Float) -> Float = match some_float(x) { Some(y) -> y, None -> x }\n",
    b"fn bool_back(b: Bool) -> Bool = match some_bool(b) { Some(d) -> d, None -> b }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert(out.len() > 0, None);
  assert_eq(
    [
      b"m.char_of",
      b"m.shifted",
      b"m.found",
      b"m.parsed",
      b"m.char_back",
      b"m.int_back",
      b"m.float_back",
      b"m.bool_back",
    ].filter(|n: Bytes| !out.any(|e: EmittedRoot| emitted_name(e) == n)),
    [],
  );
  let char_of = match out.filter(|e: EmittedRoot| emitted_name(e) == b"m.char_of") {
    [e] -> body_code(e.text),
    _ -> b"",
  };
  assert(
    char_of.index_of(b"builtin_char_of_int_p(") == None,
    Some(String::of_bytes_lossy(char_of)),
  );
  let shifted = match out.filter(|e: EmittedRoot| emitted_name(e) == b"m.shifted") {
    [e] -> body_code(e.text),
    _ -> b"",
  };
  assert(
    shifted.len() > 0 && shifted.index_of(b"builtin_int_of_char_p(") == None,
    Some(String::of_bytes_lossy(shifted)),
  )
}

test "a constant value built from constructors compiles to static data with no allocation, in the same layout as heap values" {
  let source = Bytes::concat_all([
    b"type Tree = | Leaf | Node(Tree, Int, Tree)\n",
    b"type Wide = | Narrow(Int) | Broad(Int, Int, Int, Int, String)\n",
    b"fn small() -> Tree = Node(Node(Leaf, 1, Leaf), 2, Leaf)\n",
    b"fn broad() -> Wide = Broad(1, 2, 3, 4, \"w\")\n",
    b"fn sized(t: Tree) -> Int = match t { Leaf -> 0, Node(l, _, r) -> 1 + sized(l) + sized(r) }\n",
    b"fn walked() -> Int = sized(small())\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert(out.len() > 0, None);
  let text = |name: Bytes|
    match out.filter(|e: EmittedRoot| emitted_name(e) == name) {
      [e] -> body_code(e.text),
      _ -> b"",
    };
  assert_eq(
    [b"m.small", b"m.broad"].filter(|n: Bytes|
      allocates(text(n)) || text(n).index_of(b"&ply_k_") == None),
    [],
  );
  assert_eq([b"m.small", b"m.broad"].filter(|n: Bytes| counts_any(text(n))), [])
}

test "a `handle` whose body returns a constant stores it like any other result, whatever clauses the `handle` has" {
  let source = Bytes::concat_all([
    b"effect amb {\n  write flip() -> Bool\n}\n",
    b"fn branched() -> String = handle { if amb.flip() { \"a\" } else { \"b\" } } with { amb.flip() resume k -> k(true) }\n",
    b"fn returned() -> String = handle { if amb.flip() { \"a\" } else { \"b\" } } with { amb.flip() resume k -> k(true), return v -> v }\n",
    b"fn alone() -> String = handle { \"a\" } with { amb.flip() resume k -> k(true), return v -> v }\n",
    b"fn mixed(s: String) -> String = handle { if amb.flip() { s } else { \"b\" } } with { amb.flip() resume k -> k(true) }\n",
    b"fn counted() -> Int = handle { if amb.flip() { 1 } else { 2 } } with { amb.flip() resume k -> k(true) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert(out.len() > 0, None);
  assert_eq(
    [b"m.branched", b"m.returned", b"m.alone", b"m.mixed", b"m.counted"].filter(|n: Bytes|
      !out.any(|e: EmittedRoot| emitted_name(e) == n)),
    [],
  )
}

test "a record that a branch of a recursive function returns unchanged is passed as separate fields at any nesting depth, with no allocation" {
  let source = Bytes::concat_all([
    b"type S = { out: Bytes, n: Int }\n",
    b"fn walk(s: S, fuel: Int) -> S = if fuel <= 0 { s } else if fuel % 2 == 0 { walk({ out: s.out ++ b\"x\", n: s.n + 1 }, fuel - 1) } else { let k = fuel * 3; match k % 4 { 1 -> walk(s, fuel - 1), _ -> s } }\n",
    b"fn hop(s: S, fuel: Int) -> S = if fuel <= 0 { s } else { match fuel % 3 { 0 -> hop({ out: s.out ++ b\"y\", n: s.n }, fuel - 1), _ -> if fuel > 8 { hop(s, fuel - 2) } else if fuel % 2 == 0 { hop(s, fuel - 1) } else { s } } }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), 2);
  assert_eq(out.map(|e: EmittedRoot| body_code(e.text).index_of(b"rt_alloc_p(") == None), [
    true,
    true,
  ])
}

test "a byte returned by `byte_of_int` is stored in a list without adding to its reference count" {
  let out = emit_all_program(
    [
      {
        name: b"m",
        source_text: b"fn wrap(n: Int) -> List<Bytes> / {abort.raise} = [byte_of_int(n)]\n",
      },
    ],
    [],
    true,
  );
  let text = match out { [e, ..] -> e.text, [] -> b"" };
  assert(
    text.index_of(b"ply_byte_text(ctx, ") != None
      && text.index_of(b"ply_refused(ctx, INT64_C(12), ") != None
      && text.index_of(b"ply_list_room(ctx, ") != None,
    Some(String::of_bytes_lossy(text)),
  );
  assert(!increments_count(text), Some(String::of_bytes_lossy(text)))
}

test "a scalar parameter is passed by value, so a self tail call does not release it" {
  let source = Bytes::concat_all([
    b"fn countdown(n: Int, k: Int) -> Int = if k <= 0 { n } else { countdown(n, k - 1) }\n",
    b"fn flip(b: Bool, k: Int) -> Bool = if k <= 0 { b } else { flip(b, k - 1) }\n",
    b"fn narrow(w: U32, k: Int) -> U32 = if k <= 0 { w } else { narrow(w, k - 1) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), 3);
  assert_eq(out.map(|e: EmittedRoot| releases_word(e.text, b"p0")), [false, false, false])
}

test "an accumulator record read more than once is still returned as separate fields at the end of the body" {
  let source = Bytes::concat_all([
    b"type S = { i: Int, tag: Bytes }\n",
    b"fn narrow(s: S, x: Int) -> S = { ..s, i: x }\n",
    b"fn wide(s: S, x: Int) -> S = { ..s, i: s.i + x }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), 2);
  let has = |text: Bytes| out.map(|e: EmittedRoot| body_code(e.text).index_of(text) != None);
  [b"rt_alloc_p(", b"ply_alloc("].fold((), |_: Unit, t: Bytes| assert_eq(has(t), [false, false]))
}

test "a branch releases a parameter that only the other branch uses, but does not release a record whose field the function already read" {
  let source = Bytes::concat_all([
    b"type S = { out: Bytes, n: Int }\n",
    b"type W = { out: Bytes, n: Int, a: Int, b: Int, c: Int }\n",
    b"fn whole(s: S) -> Int = s.n\n",
    b"fn wide(w: W) -> Int = w.n\n",
    b"fn slot(x: Bytes, c: Bool) -> Int = if c { Bytes::len(x ++ b\"y\") } else { 0 }\n",
    b"fn field(s: S) -> Int = { let out = s.out; if s.n < 0 { whole(s) } else { Bytes::len(out ++ b\"x\") + s.n } }\n",
    b"fn wide_field(w: W) -> Int = { let out = w.out; if w.n < 0 { wide(w) } else { Bytes::len(out ++ b\"x\") + w.n } }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), 5);
  let text = |name: Bytes|
    match out.filter(|e: EmittedRoot| emitted_name(e) == name) { [e, ..] -> e.text, [] -> b"" };
  let slot = text(b"m.slot");
  assert(
    match slot.index_of(body_else) {
      Some(a) -> {
        let rest = slot.slice(a, slot.len()).split(b";");
        match rest.at(0) { Some(first) -> releases_word(first.concat(b";"), b"p0"), None -> false }
      },
      None -> false,
    },
    Some(String::of_bytes_lossy(slot)),
  );
  let quiet = |name: Bytes| {
    let t = text(name);
    match ((t.index_of(body_else), t.index_of(append_block_start))) {
      (Some(a), Some(b)) -> a < b && !calls_release(t.slice(a, b)),
      _ -> false,
    }
  };
  assert(quiet(b"m.field"), Some(String::of_bytes_lossy(text(b"m.field"))));
  assert(quiet(b"m.wide_field"), Some(String::of_bytes_lossy(text(b"m.wide_field"))))
}

test "a generated function for a type takes the type in its defined representation, or as a pointer to a box when the record is wider than the registers" {
  let source = Bytes::concat_all([
    b"type Place = { param: Int, path: List<Bytes> }\n",
    b"type Base = | PlaceBase(Place) | QuotientBase({ of: Base, by: Int }) | RemainderBase({ by: Base })\n",
    b"type Linear = { base: Option<Base>, k: Int }\n",
    b"type Term = | Exactly(Linear) | Below(Place) | RecordTerm({ base: Option<Term>, fields: List<Term> }) | NoParts | Wrapped(Term) | UnknownTerm\n",
    b"type Wide = { a: Bytes, b: Int, c: Bytes, d: Int, e: Bytes }\n",
    b"fn same(x: Wide, y: Wide) -> Bool = x == y\n",
    b"fn hashed(x: Wide) -> Bytes = digest(x)\n",
  ]);
  let term = NamedType({ name: b"m.Term", args: [] });
  let wide = RecordType([
    { name: b"a", ty: bytes_type },
    { name: b"b", ty: int_type },
    { name: b"c", ty: bytes_type },
    { name: b"d", ty: int_type },
    { name: b"e", ty: bytes_type },
  ]);
  let boxed = RecordType([
    { name: b"base", ty: option_type(term) },
    { name: b"fields", ty: list_type(term) },
  ]);
  let written = [
    test_generated_key(keys::Lower, term),
    test_generated_key(keys::Lower, boxed),
    test_generated_key(Digest, wide),
  ];
  let results = outputs_at(
    [b"m"],
    [source],
    [b"Some", b"None"],
    written.concat([b"m.same", b"m.hashed"].map(Named)),
  );
  let tables = results.map(|a: RootOutput| { name: output_name(a), tables: a.result.tables });
  let defined = tables.fold(
    Map::new(),
    |m: Map<Bytes, { result: Bytes, params: List<Bytes> }>, t: { name: Bytes, tables: Tables }| {
      let names = if t.tables.members.len() == 0 { [t.name] }
      else { t.tables.members.map(printed) };
      range(0, names.len()).fold(
        m,
        |n: Map<Bytes, { result: Bytes, params: List<Bytes> }>, i: Int|
          match t.tables.defined.at(i) { Some(d) -> n.insert(names.get(i), d.head), None -> n },
      )
    },
  );
  let head = |k: RootKey| defined.get(printed(k));
  assert_eq(written.filter(|k: RootKey| head(k) == None).map(root_name), []);
  let called = tables.fold([], |accumulator: List<Bytes>, t: { name: Bytes, tables: Tables }|
    if t.name != b"m.hashed" { accumulator }
    else { accumulator.concat(named_prototypes(t.tables).map(|e: NamedPrototype| e.callee)) });
  assert(called.contains(printed(test_generated_key(Digest, wide))), None);
  assert(
    match head(test_generated_key(keys::Lower, boxed)) {
      Some(h) ->
        h.params.any(|p: Bytes| p == b"Word") && !h.params.any(|p: Bytes| p.ends_with(b"Word*")),
      None -> false,
    },
    None,
  );
  assert_eq(
    tables.fold([], |accumulator: List<Bytes>, t: { name: Bytes, tables: Tables }|
      named_prototypes(t.tables).fold(accumulator, |x: List<Bytes>, e: NamedPrototype|
        match defined.get(e.callee) {
          Some(h) -> if h == e.head { x }
          else { x.push(Bytes::concat_all([t.name, b" -> ", e.callee])) },
          None -> x,
        })),
    [],
  )
}

fn loaded_constructors(d: Dump, named: List<Bytes>) -> Constructors =
  constructors_of(
    named.concat(
      d.constructors.map(|c: ConstructorRow| c.name).filter(|n: Bytes| !named.contains(n)),
    ),
    d.emitter_constructors.filter(|c: EmitterConstructor| c.key != None).map(
      |c: EmitterConstructor| c.name,
    ),
    d.emitter_constructors.filter(|c: EmitterConstructor| c.numeric.len() > 0).map(
      |c: EmitterConstructor| c.name,
    ),
    constructor_sums(d.constructors),
  )

fn emit_all_program(
  sources: List<Source>,
  constructors: List<Bytes>,
  release: Bool,
) -> List<EmittedRoot> / {abort.raise} =
  match analyse(parse_all(sources)) {
    emitter_input::Rejected(diagnostics) ->
      panic(String::of_bytes_lossy(diagnostics_text(diagnostics))),
    emitter_input::Analysed(w) -> {
      let d = dump_of(emitter_input::Analysed(w));
      emit_program(
        sources,
        loaded_constructors(d, constructors),
        release,
        requested_roots(d).keys.filter(|k: RootKey| module_of(k) != prelude_module),
        [],
        [],
        d.embeds,
        d.rows,
        d.effects,
        d.inferred_facts,
      )
    },
  }

test "importing a module named like a builtin still lets an unqualified call of that name call the builtin" {
  let emitted = emit_all_program(
    [
      { name: b"min", source_text: b"pub fn size(xs: List<Int>) -> Int = xs.len()\n" },
      {
        name: b"b",
        source_text: b"import min\nfn least(x: Int) -> Int = min(x, 1)\nfn n(xs: List<Int>) -> Int = min::size(xs)\n",
      },
    ],
    [],
    true,
  );
  assert_eq(emitted.len(), 3);
  let calls = |full: Bytes| emitted.map(|e: EmittedRoot| e.text.index_of(symbol_of(full)) != None);
  assert_eq(calls(b"min.min"), [false, false, false]);
  assert_eq(calls(b"min.size"), [false, false, true])
}

test "a builtin's helper has a name derived from the builtin, and an imported function with that name is called instead" {
  let own = emit_all_program(
    [{ name: b"m", source_text: b"fn fresh<a>() -> Map<a, Int> = Map::new()\n" }],
    [],
    true,
  );
  assert_eq(own.len(), 1);
  assert_eq(own.map(|e: EmittedRoot| e.text.index_of(b"builtin_map_new_p") != None), [false]);
  assert_eq(builtin_helper(b"?numeric_binary"), b"builtin_elaborated_numeric_binary");
  assert_eq(builtin_helper(b"range"), b"builtin_range");
  let imported = emit_all_program(
    [
      { name: b"a", source_text: b"pub fn min(x: Int, y: Int) -> Int = x\n" },
      { name: b"b", source_text: b"import a (min)\nfn least(x: Int) -> Int = min(x, 1)\n" },
    ],
    [],
    true,
  );
  assert_eq(imported.len(), 2);
  assert_eq(imported.map(|e: EmittedRoot| e.text.index_of(b"builtin_min_p") != None), [
    false,
    false,
  ])
}

test "a body that names a constructor calls no generated function for it, whatever `key` or `show` declarations its type has" {
  let rest = b"fn area(b: Box) -> Int = match b { Box(w, h) -> w * h }\nfn text(b: Box) -> String = \"box\"\nfn make() -> Box = Box(1, 2)\nfn same<a>(x: a, y: a) -> Bool = x == y\n";
  let plain = b"pub type Box = | Box(Int, Int)\n".concat(rest);
  let stating = b"pub type Box = | Box(Int, Int)\nkey for Box by area\nshow for Box by text\n".concat(
    rest,
  );
  let wanted = [b"m.area", b"m.text", b"m.make", b"m.same"].map(Named);
  let calls = |source: Bytes|
    outputs_at([b"m"], [source], [b"m.Box"], wanted).map(|a: RootOutput|
      { name: output_name(a), calls: a.result.tables.calls.map(printed) });
  [stating, plain].fold((), |_: Unit, source: Bytes|
    assert_eq(calls(source).map(|c: { name: Bytes, calls: List<Bytes> }| c.calls), [
      [],
      [],
      [],
      [],
    ]))
}

const borrowing_corpus: Bytes =
  Bytes::concat_all([
    b"type T = | Leaf | Node(T, Int, T)\n",
    b"fn weight(t: T) -> Int = match t { Leaf -> 0, Node(_, n, _) -> n }\n",
    b"fn twice(t: T) -> Int = weight(t) + weight(t)\n",
    b"fn grown(t: T) -> T = Node(t, 1, Leaf)\n",
    b"fn both(t: T) -> T = if weight(t) > 0 { grown(t) } else { t }\n",
  ])

fn published_signature(definition: Bytes, borrowed: List<Bool>) -> PublishedSignature =
  { definition: root_name(Named(definition)), borrowed: borrowed, borrowed_from: None }

test "a payload read from a value built from constants needs no reference count, unlike match arms whose results need one" {
  let source = Bytes::concat_all([
    b"type V = | VInt(Int) | VStr(String)\n",
    b"fn render(v: V) -> String = match v { VInt(n) -> n.to_string(), VStr(s) -> s.len().to_string() }\n",
    b"fn display(x: Int) -> String = match VInt(x) { VStr(s) -> s, v -> render(v) }\n",
  ]);
  let out = emit_all_program([{ name: b"m", source_text: source }], [], true);
  assert_eq(out.len(), 2);
  assert_eq(out.map(|e: EmittedRoot| e.tables.handings.map(|h: PublishedSignature| h.borrowed)), [
    [[true]],
    [[true]],
  ])
}

test "a specialisation borrows and returns values the same way its generic definition does" {
  let source = Bytes::concat_all([
    b"type Named<a> = { data: a, name: String }\n",
    b"fn name_of<a>(x: Named<a>) -> String = x.name\n",
    b"fn use_it(x: Named<Int>) -> String = name_of(x)\n",
    b"fn err_or<a>(r: Result<a, String>, d: String) -> String = match r { Err(e) -> e, Ok(_) -> d }\n",
    b"fn either(r: Result<Int, String>) -> String = err_or(r, \"none\")\n",
  ]);
  let keyed = [b"m.name_of", b"m.err_or", b"m.use_it", b"m.either"].map(Named).concat([
    specialised_at(b"m.name_of", [b"Int"]),
    specialised_at(b"m.err_or", [b"Int"]),
  ]);
  let wanted = keyed.map(printed);
  let results = outputs_at([b"m"], [source], [b"Ok", b"Err"], keyed);
  assert_eq(results.map(output_name).sort(), wanted.sort());
  let borrowed = |name: Bytes|
    results.fold([], |accumulator: List<PublishedSignature>, a: RootOutput|
      if output_name(a) != name { accumulator }
      else { accumulator.concat(a.result.tables.handings) });
  assert_eq(borrowed(b"m.name_of"), [published_signature(b"m.name_of", [true])]);
  assert_eq(borrowed(b"m.err_or"), [
    {
      definition: root_name(Named(b"m.err_or")),
      borrowed: [true, true],
      borrowed_from: Some([{ param: 0, whole: false }, { param: 1, whole: true }]),
    },
  ])
}

test "a parameter that a body only reads is borrowed, so neither the function nor its caller changes its reference count for the call" {
  let out = emit_all_program([{ name: b"m", source_text: borrowing_corpus }], [], true);
  assert_eq(out.len(), 4);
  let code = out.map(|e: EmittedRoot| body_code(e.text));
  assert_eq(code.map(counts_any), [false, false, false, true]);
  assert_eq(code.map(increments_count), [false, false, false, false]);
  assert_eq(out.map(|e: EmittedRoot| e.tables.handings), [
    [published_signature(b"m.weight", [true])],
    [published_signature(b"m.twice", [true])],
    [published_signature(b"m.grown", [false])],
    [published_signature(b"m.both", [false])],
  ]);
  assert_eq(out.map(|e: EmittedRoot| e.tables.assumed), [
    [],
    [published_signature(b"m.weight", [true])],
    [],
    [published_signature(b"m.weight", [true]), published_signature(b"m.grown", [false])],
  ])
}

test "a function body is compiled using the borrowing signatures of its callee that were already computed, and records which it relied on" {
  let twice = |published: List<PublishedSignature>|
    match outputs_at([b"m"], [borrowing_corpus], [], [Named(b"m.twice")], [], published) {
      [a] ->
        Some({
          counted: increments_count(body_code(a.result.text)),
          assumed: a.result.tables.assumed,
          handings: a.result.tables.handings,
        }),
      _ -> None,
    };
  assert_eq(
    twice([]),
    Some({
      counted: true,
      assumed: [published_signature(b"m.weight", [false])],
      handings: [published_signature(b"m.twice", [false])],
    }),
  );
  assert_eq(
    twice([published_signature(b"m.weight", [true])]),
    Some({
      counted: false,
      assumed: [published_signature(b"m.weight", [true])],
      handings: [published_signature(b"m.twice", [true])],
    }),
  )
}

const array_allocation: Bytes =
  Bytes::concat_all([
    b"ply_alloc(ctx, ",
    ascii_of_int(header_bytes + 8 * head_words(array_head)),
    b" + 8 * (",
  ])

fn header_fields(text: Bytes) -> List<Bytes> / {abort.raise} =
  text.split(b"ply_obj(").drop(1).fold([], |accumulator: List<Bytes>, part: Bytes| {
    let close = iterate({ at: 0, depth: 1 }, part.len() + 1, |s: { at: Int, depth: Int }|
      if s.at >= part.len() || (part.at(s.at) == 41 && s.depth == 1) { Stop(s.at) } else {
        Continue({
          at: s.at + 1,
          depth: s.depth
            + (if part.at(s.at) == 40 { 1 } else if part.at(s.at) == 41 { 0 - 1 } else { 0 }),
        })
      });
    let rest = part.slice(min(close + 1, part.len()), part.len());
    if !rest.starts_with(b"->") { accumulator } else {
      let f = rest.slice(2, rest.len());
      accumulator.push(f.slice(0, f.scan(0, b"abcdefghijklmnopqrstuvwxyz_", f.len())))
    }
  })
