import compiler.syntax.parsing (Identifier)
import compiler.emit.code (Code)
import compiler.syntax.items (FnDefinition)
import compiler.check.resolve.tables (qualify)
import compiler.check.types (Type, VariableType, Scheme)
import compiler.check.typed (WholeBody)
import std.list
import compiler.emit.keys (RootKey, Named, Specialisation, InlinedLambda, RootName, root_name,
                           site_owner_text, key_types, inlined_lambdas)
import compiler.emit.output (Need, Exact)
import compiler.emit.representations (Definition, EmitParam, BoundLambda, has_variables)
import compiler.emit.typing (SiteAnnotations, unknown_type)
import compiler.emit.lower.module_context (ModuleContext, Root, root_body)
import compiler.emit.lower (group_lowered, tail_calls, TailCall)
import compiler.emit.lower.calling (has_handle_matching, instance_key)
import compiler.emit.lower.handling (detaches)
import compiler.emit.typed_ir (Fn)
import compiler.emit.root_emission (root_from_code, root_at)

pub fn specialisations_wanted(wanted: List<RootKey>) -> Map<Bytes, List<RootKey>> =
  wanted.fold(Map::new(), |acc: Map<Bytes, List<RootKey>>, k: RootKey|
    match k {
      Specialisation(a, _) ->
        acc.insert(
          a.definition,
          (match acc.get(a.definition) { Some(l) -> l, None -> [] }).push(k),
        ),
      _ -> acc,
    })

pub fn specialised_lowered(
  s: ModuleContext,
  definition: FnDefinition,
  root: RootKey,
  lambda_at: (RootKey, Int) -> Option<BoundLambda> / {abort.raise},
  recorded: SiteAnnotations,
) -> Fn / {abort.raise} = {
  let args = key_types(root);
  let b = root_body(
    recorded,
    WholeBody,
    definition.span.start,
    definition.generics.labels.map(|i: Identifier| i.name),
    args,
  );
  let ps = inlined_lambdas(root).fold(b.params, |ps: List<EmitParam>, f: InlinedLambda|
    match lambda_at(f.owner, f.nth) {
      None -> panic("a lambda this root runs in place of a call is not one its owner lowers"),
      Some(bl) ->
        range(0, ps.len()).fold([], |out: List<EmitParam>, i: Int|
          match ps.at(i) {
            Some(p) -> out.push(if i == f.param { { ..p, lambda: Some(bl) } } else { p }),
            None -> out,
          }),
    });
  root_from_code(s, definition.span.start, root, ps, b.code)
}

pub type DefinitionBody = { code: Code, recorded: SiteAnnotations }

type TailCallTargets = { key: RootKey, out: List<RootKey>, grown: List<Bytes> }

fn instance_args(recorded: List<Type>, args: List<Type>) -> Option<List<Type>> =
  recorded.fold(Some([]), |acc: Option<List<Type>>, t: Type|
    match acc {
      None -> None,
      Some(at) -> if !has_variables(t) { Some(at.push(t)) } else {
        match t {
          VariableType(j) ->
            Some(at.push(match args.at(j) { Some(a) -> a, None -> unknown_type() })),
          _ -> None,
        }
      },
    })

fn tail_call_targets(
  s: ModuleContext,
  w: DefinitionBody,
  args: List<Type>,
) -> TailCallTargets / {abort.raise} =
  tail_calls(s.definitions, w.code, []).fold(
    { key: Named(b""), out: [], grown: [] },
    |acc: TailCallTargets, t: TailCall|
      match instance_args(t.args, args) {
        None -> if acc.grown.contains(t.full) { acc }
        else { { ..acc, grown: acc.grown.push(t.full) } },
        Some(at) -> {
          let k = instance_key(t.full, at);
          if acc.out.contains(k) { acc } else { { ..acc, out: acc.out.push(k) } }
        },
      },
  )

pub fn tail_reached_definitions(
  module: Bytes,
  here: List<Definition>,
  read_of: (Bytes) -> Option<DefinitionBody> / {abort.raise},
  from: Bytes,
) -> Map<Bytes, Bool> / {abort.raise} =
  iterate(
    { seen: Map::new(), work: [from] },
    1000000,
    |r: { seen: Map<Bytes, Bool>, work: List<Bytes> }|
      match r.work {
        [] -> Stop(r),
        [n, ..rest] -> if r.seen.contains(n) { Continue({ ..r, work: rest }) } else {
          let next = match read_of(n) {
            Some(w) -> tail_calls(here, w.code, []).map(|t: TailCall| t.full),
            None -> [],
          };
          Continue({ seen: r.seen.insert(n, true), work: rest.concat(next) })
        },
      },
  ).seen

pub fn tail_loop_members(
  module: Bytes,
  here: List<Definition>,
  read_of: (Bytes) -> Option<DefinitionBody> / {abort.raise},
  owner: Bytes,
) -> List<Bytes> / {abort.raise} =
  tail_reached_definitions(module, here, read_of, owner).keys().filter(|d: Bytes|
    d != owner && tail_reached_definitions(module, here, read_of, d).contains(owner))

pub fn tail_loop_of(
  s: ModuleContext,
  order: Map<Bytes, Int>,
  read_of: (Bytes) -> Option<DefinitionBody> / {abort.raise},
  key: RootKey,
) -> List<RootKey> / {abort.raise} = {
  let reached = iterate(
    { pairs: Map::new(), work: [key] },
    1000000,
    |r: { pairs: Map<RootName, TailCallTargets>, work: List<RootKey> }|
      match r.work {
        [] -> Stop(r),
        [k, ..rest] -> if r.pairs.contains(root_name(k)) { Continue({ ..r, work: rest }) } else {
          let t = match read_of(site_owner_text(k)) {
            Some(w) -> tail_call_targets(s, w, key_types(k)),
            None -> { key: k, out: [], grown: [] },
          };
          Continue({
            pairs: r.pairs.insert(root_name(k), { ..t, key: k }),
            work: rest.concat(t.out),
          })
        },
      },
  ).pairs;
  reached.fold((), |_: Unit, _: RootName, p: TailCallTargets| {
    let caller = site_owner_text(p.key);
    match p.grown.find(|callee: Bytes|
        tail_reached_definitions(s.module, s.definitions, read_of, callee).contains(caller)) {
      None -> (),
      Some(callee) ->
        panic(
          String::of_bytes_lossy(
            Bytes::concat_all([
              b"`",
              caller,
              b"` calls `",
              callee,
              b"` in tail position at a type grown from a type parameter of its own, which reaches it again",
            ]),
          ),
        ),
    }
  });
  let back = iterate(
    Map::new().insert(root_name(key), true),
    reached.len() + 1,
    |seen: Map<RootName, Bool>| {
      let more = reached.fold(seen, |acc: Map<RootName, Bool>, n: RootName, p: TailCallTargets|
        if acc.contains(n) || !p.out.any(|k: RootKey| acc.contains(root_name(k))) { acc }
        else { acc.insert(n, true) });
      if more.len() == seen.len() { Stop(seen) } else { Continue(more) }
    },
  );
  let members = reached.fold([], |acc: List<RootKey>, n: RootName, p: TailCallTargets|
    if back.contains(n) { acc.push(p.key) } else { acc });
  let detached = members.any(|k: RootKey|
    match read_of(site_owner_text(k)) {
      Some(w) -> has_handle_matching(w.code, detaches),
      None -> true,
    });
  let takes_effect_variables = members.any(|k: RootKey|
    s.definitions.any(|d: Definition|
      qualify(s.module, d.name) == site_owner_text(k)
        && (match d.scheme { Some(sc) -> sc.effect_variables.len() > 0, None -> false })));
  if members.len() < 2 || detached || takes_effect_variables { [key] }
  else { in_order(order, members) }
}

fn in_order(order: Map<Bytes, Int>, keys: List<RootKey>) -> List<RootKey> = {
  let place = |k: RootKey| match order.get(site_owner_text(k)) { Some(i) -> i, None -> 0 };
  let before = |a: RootKey, b: RootKey|
    place(a) < place(b) || (place(a) == place(b) && compare(root_name(a), root_name(b)) == Less);
  keys.fold([], |sorted: List<RootKey>, k: RootKey|
    sorted.filter(|x: RootKey| before(x, k)).push(k).concat(
      sorted.filter(|x: RootKey| !before(x, k)),
    ))
}

fn tail_loop_member(
  s: ModuleContext,
  definitions: Map<Bytes, FnDefinition>,
  read_of: (Bytes) -> Option<DefinitionBody> / {abort.raise},
  key: RootKey,
) -> Root / {abort.raise} = {
  let full = site_owner_text(key);
  let definition = match definitions.get(full) {
    Some(d) -> d,
    None -> panic("a tail loop's member no definition is"),
  };
  let w = match read_of(full) { Some(w) -> w, None -> panic("a tail loop's member no walk read") };
  let args = key_types(key);
  let b = root_body(
    w.recorded,
    WholeBody,
    definition.span.start,
    definition.generics.labels.map(|i: Identifier| i.name),
    args,
  );
  root_at(s, key, definition.span.start, b.params, b.code)
}

pub fn tail_loop_lowered(
  s: ModuleContext,
  schemes: Map<Bytes, Scheme>,
  definitions: Map<Bytes, FnDefinition>,
  read_of: (Bytes) -> Option<DefinitionBody> / {abort.raise},
  keys: List<RootKey>,
) -> List<Fn> / {abort.raise} = {
  let f = group_lowered(s, keys.map(|k: RootKey| tail_loop_member(s, definitions, read_of, k)));
  let open = keys.fold(0, |most: Int, k: RootKey| {
    let w = open_variable_count(schemes, k);
    if w > most { w } else { most }
  });
  [
    {
      ..f,
      links: {
        ..f.links,
        needs: range(0, open).fold(f.links.needs, |ns: List<Need>, j: Int|
          if ns.contains({ var: j, reads: Exact }) { ns }
          else { ns.push({ var: j, reads: Exact }) }),
      },
    },
  ]
}

fn open_variable_count(schemes: Map<Bytes, Scheme>, key: RootKey) -> Int =
  match key {
    Named(full) -> match schemes.get(full) { Some(sc) -> sc.type_variables.len(), None -> 0 },
    _ -> 0,
  }
