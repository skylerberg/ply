import compiler.syntax.parsing (Span, span_key)
import std.bytes (ascii_of_int)
import compiler.emit.typed_ir (Function, Block, Instruction, Let, Do, If, Case, Match, Miss, Loop,
                               Next, Done, Return, Restart, Jump, Fail, Handle, Rvalue, Native,
                               Take, Get, IntOperand, Lambda, Closure)
import compiler.emit.lower (root_observed)
import compiler.emit.lower.base (read_note, capture_note, enter_note)
import compiler.emit.lower.module_context (ModuleContext, Root)
import compiler.emit.own (insert_reference_counts)

pub type Moves = { reads: Map<Bytes, Bool>, captures: Map<Bytes, Bool>, taken: Map<Bytes, Bool> }

pub const no_moves: Moves = { reads: Map::new(), captures: Map::new(), taken: Map::new() }

pub fn read_moved(m: Moves, at: Span) -> Bool = m.reads.get(span_key(at)) == Some(true)

pub fn capture_moved(m: Moves, at: Span, source: Int) -> Bool =
  m.captures.get(capture_key(at, source)) == Some(true)

pub fn field_moved(m: Moves, at: Span) -> Bool = m.taken.get(span_key(at)) == Some(true)

fn capture_key(at: Span, source: Int) -> Bytes =
  Bytes::concat_all([span_key(at), b"#", ascii_of_int(source)])

pub fn root_moves(setting: ModuleContext, r: Root) -> Moves / {abort.raise} =
  moves_of(insert_reference_counts(root_observed(setting, r)))

pub fn moves_of(f: Function) -> Moves =
  f.lambdas.fold(block_moves(f.body, no_moves), |m: Moves, l: Lambda|
    match l { Closure(c) -> moves_of_closure(c.body, m) })

fn moves_of_closure(f: Function, m: Moves) -> Moves =
  f.lambdas.fold(block_moves(f.body, m), |accumulator: Moves, l: Lambda|
    match l { Closure(c) -> moves_of_closure(c.body, accumulator) })

type Live = Map<Bytes, Bool>

type Exits = { miss: Live, next: Live, after_loop: Live }

type BackwardState = { live: Live, moves: Moves }

fn block_moves(b: Block, m: Moves) -> Moves = {
  let none: Live = Map::new();
  scan_backward(b, { live: none, moves: m }, { miss: none, next: none, after_loop: none }).moves
}

fn union(a: Live, b: Live) -> Live =
  b.fold(a, |accumulator: Live, k: Bytes, _: Bool| accumulator.insert(k, true))

fn record_move(map: Map<Bytes, Bool>, key: Bytes, moved: Bool) -> Map<Bytes, Bool> =
  map.insert(key, match map.get(key) { Some(was) -> was && moved, None -> moved })

fn scan_backward(b: Block, after: BackwardState, ex: Exits) -> BackwardState =
  b.fold_right(after, |i: Instruction, w: BackwardState|
    match i {
      Do(d) -> note(d.value, d.at, w),
      Let(l) -> {
        let fields = match l.value {
          Take(_) -> record_move(w.moves.taken, span_key(l.at), true),
          Get(_) -> record_move(w.moves.taken, span_key(l.at), false),
          _ -> w.moves.taken,
        };
        { ..w, moves: { ..w.moves, taken: fields } }
      },
      If(x) -> {
        let t = scan_backward(x.then, w, ex);
        let o = scan_backward(x.otherwise, { ..w, moves: t.moves }, ex);
        { live: union(t.live, o.live), moves: o.moves }
      },
      Case(c) -> {
        let rest = scan_backward(c.rest, w, ex);
        c.arms.fold(rest, |accumulator: BackwardState, a: { when: Int, body: Block }| {
          let arm = scan_backward(a.body, { ..w, moves: accumulator.moves }, ex);
          { live: union(accumulator.live, arm.live), moves: arm.moves }
        })
      },
      Match(x) ->
        x.arms.fold_right(scan_backward(x.rest, w, ex), |arm: Block, next: BackwardState|
          scan_backward(arm, { ..w, moves: next.moves }, { ..ex, miss: next.live })),
      Miss -> { ..w, live: ex.miss },
      Loop(l) -> {
        let inner = |head: Live, moves: Moves|
          scan_backward(l.body, { live: Map::new(), moves: moves }, {
            ..ex,
            next: head,
            after_loop: w.live,
          });
        let once = inner(Map::new(), w.moves);
        let twice = inner(once.live, once.moves);
        let thrice = inner(union(once.live, twice.live), twice.moves);
        { live: union(twice.live, thrice.live), moves: thrice.moves }
      },
      Next(_) -> { ..w, live: ex.next },
      Done(_) -> { ..w, live: ex.after_loop },
      Return(_) -> { ..w, live: Map::new() },
      Restart(_) -> { ..w, live: Map::new() },
      Jump(_) -> { ..w, live: Map::new() },
      Fail(_) -> { ..w, live: Map::new() },
      Handle(h) -> scan_backward(h.body, w, ex),
      _ -> w,
    })

fn note(v: Rvalue, at: Span, w: BackwardState) -> BackwardState =
  match v {
    Native(n) -> match n.args {
      [IntOperand(slot), IntOperand(site)] -> {
        let key = frame_key(site).concat(ascii_of_int(slot));
        let moved = !w.live.contains(key);
        if n.name == read_note {
          {
            live: w.live.insert(key, true),
            moves: { ..w.moves, reads: record_move(w.moves.reads, span_key(at), moved) },
          }
        } else if n.name == capture_note {
          {
            live: w.live.insert(key, true),
            moves: {
              ..w.moves,
              captures: record_move(w.moves.captures, capture_key(at, slot), moved),
            },
          }
        } else { w }
      },
      [IntOperand(site)] -> if n.name != enter_note { w } else {
        let frame = frame_key(site);
        {
          ..w,
          live: w.live.fold(Map::new(), |retained_live: Live, k: Bytes, _: Bool|
            if k.starts_with(frame) { retained_live } else { retained_live.insert(k, true) }),
        }
      },
      _ -> w,
    },
    _ -> w,
  }

fn frame_key(site: Int) -> Bytes = ascii_of_int(site).concat(b"/")
