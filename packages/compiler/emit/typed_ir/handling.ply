pub type HandleOperation =
  | Perform({ effect: Bytes, operation: Bytes, index: Int, resource: Bytes, labelled: Bool, mode: Int, descriptor: Bytes })
  | SchedulerEvidence
  | UnhandledEvidence
  | Instance(Int)
  | HeapInstance(Int)
  | InstanceAddress
  | VariableInitialize(Int)
  | VariableRead(Int)
  | VariableWrite(Int)
  | Returning
  | Entering
  | AllocateForwarding(Int)
  | SetForwarding(Int)
  | ObjectAt({ at: Int, slots: List<Slot>, shared_from: Option<Int> })
  | EffectsMapping
  | Label(Bytes)
  | Parallel
  | CurrentSite(Int)
  | UnspecialisedBuiltin(Bytes)
  | WordArray
  | WordAt(Int)

pub type Slot =
  | ClauseSlot({ entry: ClauseEntry, record: Int, labelled: Bool })
  | CopiedSlot({ operand: Int, operation: Int })
  | ForwardedSlot({ target: Int, task: Int, record: Int })
  | KeyedSlot({ table: Int, rows: List<KeyedCase> })

pub type KeyedCase = { label: Option<Int>, slot: Slot }

pub type ClauseEntry = | ReturnsResult | Schedules | Resumes | Raises | Suspends

pub type Clause = { effect: Bytes, operation: Bytes, mode: Int, string: Option<Int>, handler: Int }

pub type HandleSite = {
  clauses: List<Clause>,
  return_clause: Option<Int>,
  detached: Option<DetachedBody>,
  instance: HandleInstance,
}

pub type DetachedBody = { body: Int, forwards: Int }

pub type HandleInstance = {
  operand: Int,
  records: List<Int>,
  variable_count: Int,
  count: Int,
  pending: Option<Int>,
  result: Option<Int>,
  raise_clause_indexes: List<Int>,
  heap: Option<Int>,
  return_clause: Option<Int>,
  preset: Bool,
}

pub fn empty_instance(operand: Int) -> HandleInstance =
  {
    operand: operand,
    records: [],
    variable_count: raise_offset,
    count: 0,
    pending: None,
    result: None,
    raise_clause_indexes: [],
    heap: None,
    return_clause: None,
    preset: false,
  }

pub const task_offset: Int = 3

pub const raise_offset: Int = 4
