import compiler.emit.layout (Intrinsic)
import compiler.emit.layout

pub type ContainerOperation =
  | NodeIntrinsic(Intrinsic)
  | Length
  | ArrayLength
  | InBounds
  | ArrayNew(Element)
  | ArraySet(Element)
  | ArrayOfList(Element)
  | ArrayGet(Element)
  | ColumnsNew(List<Element>)
  | ColumnsSet(List<Element>)
  | ColumnsOfList(List<Element>)
  | ColumnsGet(List<Element>)
  | ColumnField({ k: Int, column: Element })
  | ColumnOf(Int)
  | ListInBounds
  | ItemAt
  | ListPush(Element)
  | ListSet(Element)
  | Rest
  | WithCapacity
  | Position
  | CopyOut
  | Retain

pub type Element = { layout: layout::ValueLayout, stride: Int }
