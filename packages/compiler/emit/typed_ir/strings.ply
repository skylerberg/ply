pub type StringOperation =
  | AllocateBytes
  | CopyBytes
  | ByteSet
  | ByteRead
  | U32Read
  | AppendBytes
  | BytesEqual
  | FindBytes
  | CharCount
  | CharStart
  | ScanBytes({ until: Bool })

pub type StringOperand = | TakesBlock | WritesBlock | ReadsAddress | Number

pub type StringResult = | OwnBlock | Count | NoResult

pub fn string_operands(operation: StringOperation) -> List<StringOperand> =
  match operation {
    AllocateBytes -> [Number],
    CopyBytes -> [WritesBlock, Number, ReadsAddress, Number, Number],
    ByteSet -> [WritesBlock, Number, Number],
    ByteRead -> [ReadsAddress, Number],
    U32Read -> [ReadsAddress, Number],
    AppendBytes -> [TakesBlock, ReadsAddress, Number],
    BytesEqual -> [ReadsAddress, Number, ReadsAddress, Number, Number],
    FindBytes -> [ReadsAddress, Number, ReadsAddress, Number, Number],
    CharCount -> [ReadsAddress, Number],
    CharStart -> [ReadsAddress, Number, Number],
    ScanBytes(_) -> [ReadsAddress, Number, Number, ReadsAddress, Number, Number],
  }

pub fn string_result(operation: StringOperation) -> StringResult =
  match operation {
    AllocateBytes -> OwnBlock,
    AppendBytes -> OwnBlock,
    CopyBytes -> NoResult,
    ByteSet -> NoResult,
    _ -> Count,
  }
