import std.bin
import std.bytes (hex_digit)
import compiler.emit.keys (RootKey, root_key_bin)
import compiler.emit.layout (text_head)
import compiler.check.types (Type, string_type, bytes_type)

pub type StaticDefinition = { name: Bytes, layout: StaticLayout }

pub type StaticLayout =
  | StaticBlock({ head: Option<StaticHead>, words: List<StaticWord> })
  | StaticWords(List<StaticWord>)
  | StaticStruct({ of: Bytes, fields: List<StaticWord> })
  | StaticFile(Bytes)

pub type StaticHead = { of: Bytes, fields: List<{ field: Bytes, value: Int }> }

pub type StaticWord =
  | RawWord(Int)
  | AddressWord({ name: Bytes, tag: Int })
  | EntryWord(RootKey)
  | BytesWord(Bytes)
  | FieldWord(Bytes)
  | PreludeWord(Bytes)

derive bin for StaticWord
derive bin for StaticHead
derive bin for StaticLayout
derive bin for StaticDefinition

pub fn named_by_content(laid: StaticLayout) -> StaticDefinition / {abort.raise} = {
  let digest = bin::encode(laid, static_layout_bin()).blake3().slice(0, 16);
  {
    name: Bytes::concat_all(
      [b"ply_k_"].concat(
        range(0, digest.len()).map(|i: Int|
          hex_digit(digest.at(i) / 16).concat(hex_digit(digest.at(i) % 16))),
      ),
    ),
    layout: laid,
  }
}

pub fn words_of(d: StaticDefinition) -> List<StaticWord> =
  match d.layout {
    StaticBlock(b) -> b.words,
    StaticWords(ws) -> ws,
    StaticStruct(s) -> s.fields,
    StaticFile(_) -> [],
  }

pub fn entries_of(d: StaticDefinition) -> List<RootKey> =
  words_of(d).fold([], |accumulator: List<RootKey>, w: StaticWord|
    match w { EntryWord(k) -> accumulator.push(k), _ -> accumulator })

pub fn is_text(ty: Type) -> Bool = ty == string_type() || ty == bytes_type()

pub fn text_block(b: Bytes) -> { head: Option<StaticHead>, words: List<StaticWord> } =
  {
    head: Some({
      of: text_head().name,
      fields: [{ field: b"len", value: b.len() }, { field: b"room", value: b.len() }],
    }),
    words: if b.len() == 0 { [] } else { [BytesWord(b)] },
  }

test "a static's name comes from its content, so equal contents share one static and a changed child changes the parent's name" {
  let s = named_by_content(StaticBlock(text_block(b"ply")));
  assert_eq(named_by_content(StaticBlock(text_block(b"ply"))), s);
  assert(named_by_content(StaticBlock(text_block(b"plz"))).name != s.name, None);
  let parent = |child: StaticDefinition|
    named_by_content(StaticWords([AddressWord({ name: child.name, tag: 0 })]));
  assert(parent(s).name != parent(named_by_content(StaticBlock(text_block(b"plz")))).name, None)
}
