import std.bytes (ascii_of_int)
import compiler.emit.layout (MachineStruct, MachineField, head_structs, header_bytes, frame_count,
                             pointer_floor)

pub type Machine =
  | Word
  | Words
  | I64
  | F64
  | Address
  | OutputAddress
  | Handle
  | Opaque
  | Block
  | Type
  | Operation
  | DropRoot
  | KeepRoot
  | Taken
  | Secret

fn kinds() -> List<Machine> =
  [
    Word,
    Words,
    I64,
    F64,
    Address,
    OutputAddress,
    Handle,
    Opaque,
    Block,
    Type,
    Operation,
    DropRoot,
    KeepRoot,
    Taken,
    Secret,
  ]

pub fn machine_name(m: Machine) -> Bytes =
  match m {
    Word -> b"Word",
    Words -> b"Words",
    I64 -> b"I64",
    F64 -> b"F64",
    Address -> b"Addr",
    OutputAddress -> b"Out",
    Handle -> b"Handle",
    Opaque -> b"Handed",
    Block -> b"Block",
    Type -> b"Type",
    Operation -> b"Op",
    DropRoot -> b"DropRoot",
    KeepRoot -> b"KeepRoot",
    Taken -> b"Taken",
    Secret -> b"Secret",
  }

fn machine_named(name: Bytes) -> Option<Machine> =
  kinds().find(|m: Machine| machine_name(m) == name)

pub type Native = { name: Bytes, params: List<Machine>, result: Option<Machine>, raises: Bool }

fn uniform(n: Int) -> List<Machine> = range(0, n).map(|_: Int| Word)

pub fn word_native(name: Bytes, words: Int, results: Bool, raises: Bool) -> Native =
  {
    name: name,
    params: uniform(words),
    result: if results { Some(Word) } else { None },
    raises: raises,
  }

fn called(name: Bytes, params: List<Machine>, result: Option<Machine>) -> Native =
  { name: name, params: params, result: result, raises: false }

pub fn helpers() -> List<Native> =
  [
    called(b"rt_failed", [I64, Words, I64, I64], None),
    called(b"rt_stack_more", [], Some(Word)),
    called(b"rt_inc_shared", uniform(1), None),
    called(b"rt_alloc_bytes", uniform(1), Some(Block)),
    called(b"rt_alloc_kept", uniform(1), Some(Block)),
    called(b"rt_free", [Block, Word], None),
    called(b"rt_dec_shared_last", [Block], Some(Word)),
    called(b"rt_handle_free", [Block], None),
    called(b"rt_released_twice", [Block], None),
    called(b"rt_release_later", [Opaque, DropRoot], None),
    called(b"rt_release_drain", [], None),
    called(b"rt_performed", [Operation, I64, I64], None),
    called(b"rt_scheduler_entered", [], Some(Word)),
    called(b"rt_scheduler_left", uniform(1), None),
    called(b"rt_pending_raised", [Type, I64], Some(Opaque)),
    called(b"rt_pending_raised_at", [I64, I64], Some(Opaque)),
    called(b"rt_label_string", [I64, Type], Some(Opaque)),
    called(b"rt_task_abandons", [Operation], Some(Word)),
    called(b"rt_task_captures", [Operation], Some(Word)),
    called(b"rt_task_raises", [Operation, Words], Some(Word)),
    called(b"rt_detached_open", [Block, Block, Block], Some(Opaque)),
    called(b"rt_detached_perform", [Words, Operation, I64, Words], Some(Opaque)),
    called(b"rt_with_cleanup", [Block, Block, Block, Type, Type], Some(Opaque)),
    called(b"rt_unwind_hold", uniform(1), Some(Word)),
    called(b"rt_unwind_resume", uniform(1), None),
    called(b"rt_branches", [Words, I64], None),
    called(b"rt_keep_constant", [I64, Word], None),
    called(b"rt_const_failed", [], None),
    called(b"rt_never_lifted", [], None),
    called(b"rt_never_shown", [], None),
  ]

