pub fn page_set_struct() -> MachineStruct =
  {
    name: b"PlyFilling",
    bytes: 8 * allocation_class_count() + 16,
    fields: [
      {
        name: b"pages",
        declaration: Bytes::concat_all([
          b"PlyPage *pages[",
          ascii_of_int(allocation_class_count()),
          b"]",
        ]),
        offset: 0,
        bytes: 8 * allocation_class_count(),
      },
      {
        name: b"name",
        declaration: b"const void *name",
        offset: 8 * allocation_class_count(),
        bytes: 8,
      },
      {
        name: b"reused",
        declaration: b"uint64_t reused",
        offset: 8 * allocation_class_count() + 8,
        bytes: 8,
      },
    ],
  }

