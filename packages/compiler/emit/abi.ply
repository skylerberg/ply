  {
    name: b"PlyObj",
    bytes: header_bytes(),
    fields: [
      { name: b"rc", declaration: b"uint32_t rc", offset: 0, bytes: 4 },
      {
        name: b"made_by_scheduler",
        declaration: b"uint8_t made_by_scheduler",
        offset: 4,
        bytes: 1,
      },
    ],
  }

