pub fn machine_structs() -> List<MachineStruct> =
  [
    page_struct(),
    page_set_struct(),
    allocator_struct(),
    frame_struct(),
    type_struct(),
    retained_struct(),
    operation_struct(),
    function_descriptor_struct(),
  ]

pub fn immortal_count() -> Int = 4294967295

pub fn shared_count() -> Int = 2147483648

pub fn closure_descriptor() -> Int = 0

pub fn release_depth() -> Int = 32

pub type ScopedLayout = { value: Int }

pub fn scoped_layout() -> ScopedLayout = { value: 1 }

pub type HeapInstanceLayout = { words: Int, detached: Int, type_variables: Int }

pub fn heap_instance_layout() -> HeapInstanceLayout = { words: 7, detached: 4, type_variables: 5 }

pub type ClauseRecordLayout = { closure: Int, instance: Int, string: Int }

pub fn clause_record_layout() -> ClauseRecordLayout = { closure: 0, instance: 1, string: 3 }

pub fn failed_target() -> Int = 9

pub fn failed_pending() -> Int = 10

pub fn evidence_one_slot() -> Int = 1

pub fn evidence_shared() -> Int = 2

pub fn unwinding_words() -> Int = 16

fn dotted(parts: List<Bytes>) -> Bytes = Bytes::join(parts, b".")

fn fields_stated(into: Map<Bytes, Int>, s: MachineStruct) -> Map<Bytes, Int> =
  s.fields.fold(into, |accumulator: Map<Bytes, Int>, f: MachineField|
    accumulator.insert(dotted([s.name, f.name, b"at"]), f.offset).insert(
      dotted([s.name, f.name, b"bytes"]),
      f.bytes,
    ))

pub fn layout_constants() -> Map<Bytes, Int> =
  [object_struct()].concat(machine_structs()).fold(
    fields_stated(Map::new(), context_struct()),
    |accumulator: Map<Bytes, Int>, s: MachineStruct|
      fields_stated(accumulator, s).insert(dotted([s.name, b"bytes"]), s.bytes),
  ).insert(
    b"count.frame",
    frame_count(),
  ).insert(
    b"count.immortal",
    immortal_count(),
  ).insert(
    b"count.shared",
    shared_count(),
  ).insert(
    b"pointer_floor",
    pointer_floor(),
  ).insert(
    b"release_depth",
    release_depth(),
  ).insert(
    b"hold.held",
    scoped_layout().value,
  ).insert(
    b"closure.descriptor",
    closure_descriptor(),
  ).insert(
    b"failed.target",
    failed_target(),
  ).insert(
    b"evidence.one_slot",
    evidence_one_slot(),
  ).insert(
    b"evidence.shared",
    evidence_shared(),
  ).insert(
    b"instance.head",
    heap_instance_layout().words,
  ).insert(
    b"instance.detached",
    heap_instance_layout().detached,
  ).insert(
    b"instance.vars",
    heap_instance_layout().type_variables,
  ).insert(
    b"record.closure",
    clause_record_layout().closure,
  ).insert(
    b"record.instance",
    clause_record_layout().instance,
  ).insert(
    b"record.string",
    clause_record_layout().string,
  ).insert(
    b"failed.pending",
    failed_pending(),
  ).insert(
    b"unwinding.words",
    unwinding_words(),
  ).insert(
    b"alloc.segment",
    allocation_layout().segment,
  ).insert(
    b"alloc.page",
    allocation_layout().page,
  ).insert(
    b"alloc.pages_at",
    allocation_layout().pages_at,
  ).insert(
    b"alloc.word_classes",
    allocation_layout().word_classes,
  ).insert(
    b"alloc.link_at",
    allocation_layout().link_at,
  )

pub type Runtime = {
  identity: Bytes,
  natives: List<Native>,
  helpers: List<Native>,
  facts: Map<Bytes, Int>,
  codes: List<Bytes>,
}

fn description_header() -> Bytes = b"ply runtime 1"

fn function_line(kind: Bytes, n: Native) -> Bytes =
  Bytes::concat_all([
    Bytes::join(
      [
        kind,
        n.name,
        if n.raises { b"1" } else { b"0" },
        match n.result { Some(m) -> machine_name(m), None -> b"-" },
      ].concat(
        n.params.map(machine_name),
      ),
      b" ",
    ),
    b"\n",
  ])

pub fn description(r: Runtime) -> Bytes =
  Bytes::concat_all([
    description_header(),
    b"\n",
    b"identity ",
    r.identity,
    b"\n",
    Bytes::concat_all(r.natives.map(|n: Native| function_line(b"native", n))),
    Bytes::concat_all(r.helpers.map(|n: Native| function_line(b"helper", n))),
    Bytes::concat_all(
      r.facts.fold([], |accumulator: List<Bytes>, name: Bytes, value: Int|
        accumulator.push(Bytes::concat_all([b"fact ", name, b" ", ascii_of_int(value), b"\n"]))),
    ),
    Bytes::concat_all(r.codes.map(|code: Bytes| Bytes::concat_all([b"code ", code, b"\n"]))),
  ])

fn kinds_named(names: List<Bytes>) -> Option<List<Machine>> =
  names.fold(Some([]), |accumulator: Option<List<Machine>>, name: Bytes|
    match ((accumulator, machine_named(name))) {
      (Some(ms), Some(m)) -> Some(ms.push(m)),
      _ -> None,
    })

fn function_of(words: List<Bytes>) -> Option<Native> =
  match ((words.at(1), words.at(2), words.at(3), kinds_named(words.drop(4)))) {
    (Some(name), Some(raises), Some(result), Some(params)) -> if raises != b"0" && raises != b"1" {
      None
    } else if result == b"-" {
      Some({ name: name, params: params, result: None, raises: raises == b"1" })
    } else {
      match machine_named(result) {
        Some(m) -> Some({ name: name, params: params, result: Some(m), raises: raises == b"1" }),
        None -> None,
      }
    },
    _ -> None,
  }

fn read_line(r: Runtime, line: Bytes) -> Result<Runtime, Bytes> / {abort.raise} = {
  let words = line.split(b" ");
  let kind = match words.at(0) { Some(k) -> k, None -> b"" };
  let unread = Err(
    Bytes::concat_all([b"the runtime description has an invalid line `", line, b"`"]),
  );
  if kind == b"identity" {
    match words.at(1) {
      Some(id) -> if words.len() == 2 { Ok({ ..r, identity: id }) } else { unread },
      None -> unread,
    }
  } else if kind == b"native" {
    match function_of(words) { Some(n) -> Ok({ ..r, natives: r.natives.push(n) }), None -> unread }
  } else if kind == b"helper" {
    match function_of(words) { Some(n) -> Ok({ ..r, helpers: r.helpers.push(n) }), None -> unread }
  } else if kind == b"fact" {
    match ((words.at(1), match words.at(2) { Some(v) -> v.int_of_ascii(), None -> None })) {
      (Some(name), Some(value)) -> if words.len() == 3 {
        Ok({ ..r, facts: r.facts.insert(name, value) })
      } else { unread },
      _ -> unread,
    }
  } else if kind == b"code" {
    match words.at(1) {
      Some(code) -> if words.len() == 2 { Ok({ ..r, codes: r.codes.push(code) }) } else { unread },
      None -> unread,
    }
  } else { Ok(r) }
}

pub fn runtime_of(text: Bytes) -> Result<Runtime, Bytes> / {abort.raise} = {
  let lines = text.split(b"\n").filter(|l: Bytes| l.len() > 0);
  match lines.at(0) {
    None -> Err(b"the runtime description is empty"),
    Some(first) -> if first != description_header() {
      Err(
        Bytes::concat_all([
          b"it opens `",
          first,
          b"` where this `ply` reads `",
          description_header(),
          b"`",
        ]),
      )
    } else {
      lines.drop(1).fold(
        Ok({ identity: b"", natives: [], helpers: [], facts: Map::new(), codes: [] }),
        |accumulator: Result<Runtime, Bytes>, line: Bytes|
          match accumulator { Ok(r) -> read_line(r, line), Err(_) -> accumulator },
      )
    },
  }
}

pub fn serving_runtime(identity: Bytes, natives: List<Native>) -> Runtime =
  { identity: identity, natives: natives, helpers: helpers(), facts: layout_constants(), codes: [] }

pub type RuntimeMismatch =
  | MissingHelper(Native)
  | HelperMismatch({ declared: Native, found: Native })
  | FactMismatch({ name: Bytes, declared: Int, found: Option<Int> })

pub fn runtime_mismatches(r: Runtime) -> List<RuntimeMismatch> = {
  let found = r.helpers.fold(Map::new(), |accumulator: Map<Bytes, Native>, n: Native|
    accumulator.insert(n.name, n));
  let helpers = helpers().fold([], |accumulator: List<RuntimeMismatch>, d: Native|
    match found.get(d.name) {
      None -> accumulator.push(MissingHelper(d)),
      Some(n) -> if n == d { accumulator }
      else { accumulator.push(HelperMismatch({ declared: d, found: n })) },
    });
  layout_constants().fold(helpers, |accumulator: List<RuntimeMismatch>, name: Bytes, value: Int|
    match r.facts.get(name) {
      Some(v) -> if v == value { accumulator }
      else { accumulator.push(FactMismatch({ name: name, declared: value, found: Some(v) })) },
      None -> accumulator.push(FactMismatch({ name: name, declared: value, found: None })),
    })
}

fn signature_text(n: Native) -> Bytes =
  Bytes::concat_all([
    b"takes [",
    Bytes::join(n.params.map(machine_name), b", "),
    b"]",
    match n.result {
      Some(m) -> b" and returns ".concat(machine_name(m)),
      None -> b" and returns nothing",
    },
    if n.raises { b", raising" } else { b"" },
  ])

pub fn mismatch_line(u: RuntimeMismatch) -> Bytes =
  match u {
    MissingHelper(d) ->
      Bytes::concat_all([b"the runtime has no helper `", d.name, b"`, which emitted code calls"]),
    HelperMismatch(x) ->
      Bytes::concat_all([
        b"`",
        x.declared.name,
        b"` ",
        signature_text(x.declared),
        b" is how this compiler calls it, but the runtime declares it as ",
        signature_text(x.found),
      ]),
    FactMismatch(l) -> match l.found {
      Some(v) ->
        Bytes::concat_all([
          b"the runtime lays out `",
          l.name,
          b"` as ",
          ascii_of_int(v),
          b", where this compiler declares ",
          ascii_of_int(l.declared),
        ]),
      None ->
        Bytes::concat_all([
          b"the runtime reports no value for `",
          l.name,
          b"`, but this compiler declares it as ",
          ascii_of_int(l.declared),
        ]),
    },
  }

test "each struct emitted code lays out has its fields in order, each at a multiple of its size, within the struct" {
  [object_struct(), context_struct()].concat(machine_structs()).concat(head_structs()).fold(
    (),
    |_: Unit, s: MachineStruct| {
      let end = s.fields.fold(0, |at: Int, f: MachineField| {
        assert(
          f.offset >= at && f.offset % f.bytes == 0 && f.declaration.index_of(f.name) != None,
          None,
        );
        f.offset + f.bytes
      });
      assert(end <= s.bytes && s.bytes % 8 == 0, None)
    },
  )
}

test "no two native functions in the runtime share a name, and `machine_named` finds each machine kind by its name" {
  let names = helpers().concat(natives()).map(|n: Native| n.name);
  assert_eq(range(0, names.len()).filter(|i: Int| names.drop(i + 1).contains(names.get(i))), []);
  assert_eq(
    kinds().map(|m: Machine| machine_named(machine_name(m))),
    kinds().map(|m: Machine| Some(m)),
  )
}

test "a runtime description parses back into the same runtime" {
  let r = {
    ..serving_runtime(b"abc", natives().take(3)),
    helpers: helpers().take(4),
    codes: [b"E0424", b"W0608"],
  };
  assert_eq(runtime_of(description(r)), Ok(r));
  assert_eq(runtime_of(description(r).concat(b"later something\n")), Ok(r));
  assert(runtime_of(description(r).concat(b"fact count.frame\n")) != Ok(r), None);
  assert(runtime_of(description(r).concat(b"helper rt_x 0 Ward\n")) != Ok(r), None);
  assert(runtime_of(description(r).concat(b"code E0424 E0425\n")) != Ok(r), None);
  assert(runtime_of(b"ply runtime 2\nidentity abc\n") != Ok(r), None)
}

test "`runtime_mismatches` reports nothing for a runtime that provides everything the compiler declares, even if it also provides extra helper functions and layout facts" {
  let r = serving_runtime(b"r", []);
  assert_eq(runtime_mismatches(r), []);
  let more = {
    ..r,
    helpers: r.helpers.push(called(b"rt_kept_for_another", [I64], None)),
    facts: r.facts.insert(b"PlyCtx.runtime_own.at", 4096),
  };
  assert_eq(runtime_mismatches(more), [])
}

test "a runtime missing a helper, or with a different helper type, field offset, size or constant than the compiler expects, is rejected with each mismatch named" {
  let r = serving_runtime(b"r", []);
  let without = |name: Bytes| { ..r, helpers: r.helpers.filter(|n: Native| n.name != name) };
  let retyped = {
    ..r,
    helpers: r.helpers.map(|n: Native|
      if n.name == b"rt_release_drain" { { ..n, params: [I64] } } else { n }),
  };
  let moved = { ..r, facts: r.facts.insert(b"PlyCtx.release_depth.at", 80) };
  let mismatch_lines = |x: Runtime| runtime_mismatches(x).map(mismatch_line);
  assert_eq(mismatch_lines(without(b"rt_keep_constant")), [
    b"the runtime has no helper `rt_keep_constant`, which emitted code calls",
  ]);
  assert_eq(mismatch_lines(retyped), [
    b"`rt_release_drain` takes [] and returns nothing is how this compiler calls it, but the runtime declares it as takes [I64] and returns nothing",
  ]);
  assert_eq(mismatch_lines(moved), [
    b"the runtime lays out `PlyCtx.release_depth.at` as 80, where this compiler declares 72",
  ]);
  assert_eq(mismatch_lines({ ..r, facts: r.facts.insert(b"PlyFnDesc.bytes", 56) }), [
    b"the runtime lays out `PlyFnDesc.bytes` as 56, where this compiler declares 48",
  ]);
  assert_eq(mismatch_lines({ ..r, facts: r.facts.insert(b"release_depth", 64) }), [
    b"the runtime lays out `release_depth` as 64, where this compiler declares 32",
  ]);
  assert_eq(mismatch_lines({ ..r, facts: r.facts.remove(b"hold.held") }), [
    b"the runtime reports no value for `hold.held`, but this compiler declares it as 1",
  ]);
  assert_eq(layout_constants().get(b"PlyCtx.bytes"), None);
  assert_eq(layout_constants().get(b"PlyCtx.frames.at"), Some(64))
}
