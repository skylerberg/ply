import std.bytes (ascii_of_int)

type PathState = {
  owned: Map<Int, Int>,
  borrowed_from: Map<Int, List<Int>>,
  borrowed: Map<Int, Int>,
  joins: Map<Int, Bool>,
  unset: Map<Int, Bool>,
  opened: Map<Int, List<Var>>,
  alias: Map<Int, Var>,
  stacks: Map<Int, List<Var>>,
  taken: Map<Int, List<Path>>,
  unique_checks: Map<Int, Bool>,
  immortal: Map<Int, Bool>,
  pending: Map<Int, Bool>,
}

type CheckState = {
  h: PathState,
  fault: Option<Bytes>,
  live: Bool,
  missed: Option<PathState>,
  done: Bool,
}

type Enclosing = {
  looped: Option<LoopState>,
  landing: Map<Int, Int>,
  arm: Option<PathState>,
  handled: Bool,
  result: Representation,
  returned: ResultOwnership,
  member: Option<Int>,
  known: Map<Int, Int>,
}

type LoopState = { held: Map<Int, Int>, state: List<Var>, result: Var }

pub fn ownership_fault(f: Fn) -> Option<Bytes> = {
  let bound = f.members.fold(
    binding(f.params.fold(Map::new(), bound_as), f.body),
    |m: Map<Int, Representation>, x: Member| x.params.fold(m, bound_as),
  );
  match used_otherwise(bound, f.body) {
    Some(v) ->
      Some(
        Bytes::concat_all([
          b"a variable used represented otherwise than it was bound: v",
          ascii_of_int(v.id),
        ]),
      ),
    None -> body_verified(f),
  }
}

fn or_else<a>(found: Option<a>, next: Option<a>) -> Option<a> =
  match found { Some(_) -> found, None -> next }

fn bound_as(m: Map<Int, Representation>, v: Var) -> Map<Int, Representation> =
  m.insert(v.id, v.representation)

fn binding(bound: Map<Int, Representation>, b: Block) -> Map<Int, Representation> =
  b.fold(bound, |m: Map<Int, Representation>, i: Inst|
    match i {
      Let(l) -> bound_as(m, l.var),
      Declaration(v) -> bound_as(m, v),
      If(x) -> binding(binding(m, x.then), x.otherwise),
      Case(c) ->
        c.arms.fold(
          binding(m, c.rest),
          |a: Map<Int, Representation>, arm: { when: Int, body: Block }| binding(a, arm.body),
        ),
      Match(x) -> x.arms.fold(binding(m, x.rest), binding),
      Loop(l) -> binding(bound_as(carried_variables(l.state).fold(m, bound_as), l.result), l.body),
      Handle(h) -> binding(bound_as(m, h.result), h.body),
      Reset(r) -> bound_as(m, r.token),
      Destructure(o) -> o.words.fold(m, bound_as),
      _ -> m,
    })

fn used_otherwise(bound: Map<Int, Representation>, b: Block) -> Option<Var> = {
  let off = |vs: List<Var>|
    vs.fold(None, |found: Option<Var>, v: Var|
      match found {
        Some(_) -> found,
        None -> match bound.get(v.id) {
          Some(r) -> if r != v.representation { Some(v) } else { None },
          None -> None,
        },
      });
  let of_args = |args: List<Arg>|
    off(
      args.fold([], |vs: List<Var>, a: Arg|
        match operand_var(a) { Some(v) -> vs.push(v), None -> vs }),
    );
  b.fold(None, |found: Option<Var>, i: Inst|
    match found {
      Some(_) -> found,
      None -> match i {
        Let(l) -> of_args(operands(l.value).map(|o: { arg: Arg, takes: Bool }| o.arg)),
        Do(d) -> of_args(operands(d.value).map(|o: { arg: Arg, takes: Bool }| o.arg)),
        Assign(s) -> match off([s.var]) { Some(v) -> Some(v), None -> of_args([s.arg]) },
        If(x) -> match of_args([x.cond]) {
          Some(v) -> Some(v),
          None -> match used_otherwise(bound, x.then) {
            Some(v) -> Some(v),
            None -> used_otherwise(bound, x.otherwise),
          },
        },
        Case(c) -> match off([c.on]) {
          Some(v) -> Some(v),
          None ->
            c.arms.fold(
              used_otherwise(bound, c.rest),
              |f: Option<Var>, arm: { when: Int, body: Block }|
                match f { Some(_) -> f, None -> used_otherwise(bound, arm.body) },
            ),
        },
        Match(x) ->
          x.arms.fold(used_otherwise(bound, x.rest), |f: Option<Var>, arm: Block|
            match f { Some(_) -> f, None -> used_otherwise(bound, arm) }),
        Loop(l) -> match of_args(carried_inits(l.state)) {
          Some(v) -> Some(v),
          None -> used_otherwise(bound, l.body),
        },
        Handle(h) -> match of_args(h.args) {
          Some(v) -> Some(v),
          None -> used_otherwise(bound, h.body),
        },
        Next(args) -> of_args(args),
        Done(a) -> of_args([a]),
        Return(a) -> of_args([a]),
        Restart(args) -> of_args(args),
        Jump(e) -> of_args(e.args),
        Inc(n) -> off([n.var]),
        Dec(v) -> off([v]),
        Reset(r) -> off([r.of]),
        Free(r) -> off([r.of]),
        Destructure(o) -> off([o.of]),
        _ -> None,
      },
    })
}

fn body_verified(f: Fn) -> Option<Bytes> = {
  let top = {
    looped: None,
    landing: Map::new(),
    arm: None,
    handled: false,
    result: f.convention.result,
    returned: f.convention.returned,
    member: None,
    known: Map::new(),
  };
  let unborrowed = |ps: List<Var>, c: Convention|
    !borrows_from_borrowed(ps.map(|p: Var| p.representation), c);
  let dead = uncounted_variables(f);
  let own = if f.members.len() == 0 {
    if !parameters_match_convention(f) {
      Some(b"a parameter represented otherwise than its convention takes it")
    } else if unborrowed(f.params, f.convention) {
      Some(b"a root returning borrowed of other than a counted parameter it borrows")
    } else { body_fault(f, top, parameter_state(f.params, f.convention, dead), f.body) }
  } else if f.members.any(|m: Member| unborrowed(m.params, m.convention)) {
    Some(b"a root returning borrowed of other than a counted parameter it borrows")
  } else {
    match f.body {
      [Case(c)] ->
        c.arms.fold(
          body_fault(f, top, parameter_state([], f.convention, dead), c.rest),
          |reason: Option<Bytes>, a: { when: Int, body: Block }|
            match reason {
              Some(_) -> reason,
              None -> match f.members.at(a.when) {
                None -> Some(b"an arm of no member of the group"),
                Some(m) ->
                  body_fault(
                    f,
                    {
                      ..top,
                      result: m.convention.result,
                      returned: m.convention.returned,
                      member: Some(a.when),
                    },
                    parameter_state(m.params, m.convention, dead),
                    a.body,
                  ),
              },
            },
        ),
      _ -> Some(b"a tail group whose body is no case on its member's place"),
    }
  };
  f.lambdas.fold({ n: 0, reason: own }, |s: { n: Int, reason: Option<Bytes> }, l: Lambda|
    {
      n: s.n + 1,
      reason: match s.reason {
        Some(_) -> s.reason,
        None -> match l {
          Closure(c) -> match ownership_fault(c.body) {
            Some(reason) ->
              Some(Bytes::concat_all([b"in closure ", ascii_of_int(s.n), b": ", reason])),
            None -> None,
          },
        },
      },
    }).reason
}

fn parameter_state(params: List<Var>, conv: Convention, immortal: Map<Int, Bool>) -> PathState =
  range(0, params.len()).fold(
    {
      owned: Map::new(),
      borrowed_from: Map::new(),
      borrowed: Map::new(),
      joins: Map::new(),
      unset: Map::new(),
      opened: Map::new(),
      alias: Map::new(),
      stacks: Map::new(),
      taken: Map::new(),
      unique_checks: Map::new(),
      immortal: immortal,
      pending: Map::new(),
    },
    |h: PathState, i: Int|
      match params.at(i) {
        None -> h,
        Some(p) -> if !is_refcounted(p.representation) { h } else if param_borrowed(conv, i) {
          {
            ..h,
            borrowed_from: h.borrowed_from.insert(p.id, []),
            borrowed: h.borrowed.insert(p.id, i),
          }
        } else { { ..h, owned: h.owned.insert(p.id, 1) } },
      },
  )

fn body_fault(f: Fn, context: Enclosing, start: PathState, b: Block) -> Option<Bytes> = {
  let w = check_block(
    f,
    context,
    { h: start, fault: None, live: true, missed: None, done: false },
    b,
  );
  match w.fault {
    Some(reason) -> Some(reason),
    None -> if w.live { Some(b"a body that falls off its end without returning") } else { None },
  }
}

fn arguments_match_parameters(f: Fn, member: Option<Int>, args: List<Arg>) -> Bool =
  match member {
    None -> arguments_have_representations(args, f.params.map(|p: Var| p.representation)),
    Some(i) -> match f.members.at(i) {
      Some(m) -> arguments_have_representations(args, reps_of(m.convention)),
      None -> false,
    },
  }

fn parameters_match_convention(f: Fn) -> Bool =
  f.params.len() == f.convention.params.len()
    && range(0, f.params.len()).all(|i: Int|
      match f.params.at(i) {
        Some(p) -> match param_rep(f.convention, i) {
          Some(r) -> p.representation == r || (p.representation == AsListView && r == AsWord),
          None -> false,
        },
        None -> false,
      })

fn parameter_ownership(f: Fn, member: Option<Int>) -> List<ParamOwnership> =
  match member {
    None -> param_ownerships(f.convention),
    Some(i) -> match f.members.at(i) { Some(m) -> param_ownerships(m.convention), None -> [] },
  }

fn pass_arguments(w: CheckState, args: List<Arg>, handed: List<ParamOwnership>) -> CheckState =
  range(0, args.len()).fold(w, |acc: CheckState, i: Int|
    match args.at(i) {
      None -> acc,
      Some(a) -> if handed.at(i) != Some(BorrowedParam) { pass_argument(acc, a) } else {
        match operand_var(a) {
          Some(v) -> if !is_refcounted(v.representation) || borrowed_from_parameters(acc.h, v) {
            read_of(acc, v)
          } else {
            faulted(acc, b"a value borrowed by a body started again that does not outlast it: v", v)
          },
          None -> acc,
        }
      },
    })

fn owners_of(h: PathState, v: Var) -> List<Int> =
  unaliased_bases(h, match h.alias.get(v.id) { Some(whole) -> whole, None -> v })

fn unaliased_bases(h: PathState, v: Var) -> List<Int> =
  if count(h, v) > 0 || h.borrowed.contains(v.id) { [v.id] }
  else if h.immortal.contains(v.id) || h.pending.contains(v.id) { [] }
  else { match h.borrowed_from.get(v.id) { Some(bs) -> bs, None -> [v.id] } }

fn borrowed_here(h: PathState, v: Var) -> Bool =
  is_refcounted(v.representation) && !is_token(v) && !h.stacks.contains(v.id)
    && resolved(h, v).all(|x: Var| count(h, x) == 0)

fn borrowed_from_parameters(h: PathState, v: Var) -> Bool =
  count(h, v) == 0 && owners_of(h, v).all(|b: Int| h.borrowed.contains(b))

fn arguments_have_representations(args: List<Arg>, reps: List<Representation>) -> Bool =
  args.len() == reps.len()
    && range(0, args.len()).all(|i: Int|
      match args.at(i) {
        Some(a) -> match reps.at(i) { Some(r) -> same_rep(a, r), None -> false },
        None -> false,
      })

fn check_block(f: Fn, context: Enclosing, w: CheckState, b: Block) -> CheckState =
  b.fold(w, |acc: CheckState, i: Inst|
    if acc.fault != None || !acc.live { acc } else {
      match i {
        Let(l) -> check_let(context, acc, l.var, l.value, l.unwind),
        Do(d) -> match token_in(read_args(d.value)) {
          Some(t) -> faulted(acc, b"a reuse token read as a value: v", t),
          None -> if partly_taken_argument(acc.h, read_args(d.value)) != None {
            { ..acc, fault: Some(b"a block used whole after a field was taken out of it") }
          } else if escaping(acc.h, d.value) != None {
            {
              ..acc,
              fault: Some(
                b"a closure on this frame's stack handed beyond the call that borrows it",
              ),
            }
          } else if results_count(d.value) {
            { ..acc, fault: Some(b"a value whose count nothing holds") }
          } else {
            match or_else(bytes_fault(acc.h, None, d.value), uses_fault(None, d.value)) {
              Some(f) -> faulted(acc, f.reason, f.v),
              None -> failing(context, used(acc, operands(d.value)), d.value, d.unwind),
            }
          },
        },
        Declaration(v) -> { ..acc, h: declared(acc.h, v.id) },
        Assign(s) -> match acc.h.joins.get(s.var.id) {
          Some(false) -> if !same_rep(s.arg, s.var.representation) {
            faulted(acc, b"a join set from a value represented otherwise: v", s.var)
          } else {
            let set = |w: CheckState|
              {
                ..w,
                h: {
                  ..w.h,
                  joins: w.h.joins.insert(s.var.id, true),
                  unset: w.h.unset.remove(s.var.id),
                },
              };
            match operand_var(s.arg) {
              Some(v) -> if acc.h.immortal.contains(s.var.id) { set(read_of(acc, v)) }
              else if acc.h.immortal.contains(v.id) {
                let x = set(read_of(acc, v));
                { ..x, h: { ..x.h, pending: x.h.pending.insert(s.var.id, true) } }
              } else if borrowed_here(acc.h, v) {
                let read = read_of(acc, v);
                let x = set(read);
                {
                  ..x,
                  h: {
                    ..x.h,
                    borrowed_from: x.h.borrowed_from.insert(s.var.id, owners_of(read.h, v)),
                  },
                }
              } else { join_owns_count(set(pass_argument(acc, s.arg)), s.var) },
              None -> if acc.h.immortal.contains(s.var.id) { set(acc) }
              else { join_owns_count(set(acc), s.var) },
            }
          },
          Some(true) -> faulted(acc, b"a join set twice on one path: v", s.var),
          None -> faulted(acc, b"a join set before it is declared: v", s.var),
        },
        If(x) -> {
          let read = read_arg(acc, x.cond);
          match last_tested(acc.h, x.cond) {
            Some(n) ->
              joined(
                read,
                check_block(f, context, read, x.then),
                check_block(
                  f,
                  context,
                  { ..read, h: { ..read.h, owned: read.h.owned.remove(n.id) } },
                  x.otherwise,
                ),
              ),
            None -> if read.fault == None && !same_rep(x.cond, AsBool) {
              { ..read, fault: Some(b"a branch on a value represented otherwise than as a Bool") }
            } else {
              joined(
                read,
                check_block(f, context, read, x.then),
                check_block(f, context, read, x.otherwise),
              )
            },
          }
        },
        Case(c) -> if !names_each(c.test, c.arms.map(|a: { when: Int, body: Block }| a.when)) {
          faulted(acc, b"a case arm for a constructor its test does not name: v", c.on)
        } else if !test_fits_representation(c.test, c.on.representation) {
          faulted(acc, b"a case testing as a number a value represented otherwise: v", c.on)
        } else if !sum_tested(c.test, c.on.representation) {
          faulted(acc, b"a case on a sum testing other constructors than the sum's: v", c.on)
        } else {
          let read = read_of(acc, c.on);
          c.arms.fold(
            check_block(f, context, read, c.rest),
            |j: CheckState, a: { when: Int, body: Block }|
              joined(
                read,
                j,
                check_block(
                  f,
                  match c.test {
                    TagTest(_) -> { ..context, known: context.known.insert(c.on.id, a.when) },
                    _ -> context,
                  },
                  read,
                  a.body,
                ),
              ),
          )
        },
        Match(m) -> {
          let tried = m.arms.fold(
            { from: Some(acc.h), out: { ..acc, live: false } },
            |s: { from: Option<PathState>, out: CheckState }, a: Block|
              if s.out.fault != None { s } else {
                match s.from {
                  None -> s,
                  Some(h) -> {
                    let w = check_block(
                      f,
                      { ..context, arm: Some(acc.h) },
                      { ..acc, h: arm_entry_state(acc, h), missed: None },
                      a,
                    );
                    if w.fault != None { { from: None, out: w } } else {
                      { from: w.missed, out: joined(acc, s.out, { ..w, missed: acc.missed }) }
                    }
                  },
                }
              },
          );
          if tried.out.fault != None { tried.out } else {
            match tried.from {
              None -> tried.out,
              Some(h) ->
                joined(
                  acc,
                  tried.out,
                  check_block(f, context, { ..acc, h: arm_entry_state(acc, h) }, m.rest),
                ),
            }
          }
        },
        Miss -> match context.arm {
          None -> { ..acc, fault: Some(b"an arm's miss outside a match") },
          Some(entry) -> {
            let handed = {
              ..scoped(acc.h, entry),
              taken: acc.h.taken.fold(
                Map::new(),
                |m: Map<Int, List<Path>>, id: Int, ps: List<Path>|
                  if entry.owned.contains(id) || entry.borrowed_from.contains(id) {
                    m.insert(id, ps)
                  } else { m },
              ),
            };
            match acc.missed {
              None -> { ..acc, missed: Some(handed), live: false },
              Some(m) -> if m.owned == handed.owned && m.unset == handed.unset {
                {
                  ..acc,
                  missed: Some({ ..m, taken: merge_taken(m.taken, handed.taken) }),
                  live: false,
                }
              } else { { ..acc, fault: Some(b"the misses of an arm own different counts") } },
            }
          },
        },
        Loop(l) -> if !l.state.all(|c: LoopVariable| same_rep(c.init, c.var.representation)) {
          { ..acc, fault: Some(b"a loop's state set from values represented otherwise") }
        } else {
          let fed = carried_inits(l.state).fold(acc, pass_argument);
          let start = carried_variables(l.state).fold(fed.h, |h: PathState, s: Var|
            if is_refcounted(s.representation) { { ..h, owned: h.owned.insert(s.id, 1) } }
            else { h });
          let body = check_block(
            f,
            {
              ..context,
              looped: Some({
                held: fed.h.owned,
                state: carried_variables(l.state),
                result: l.result,
              }),
              arm: None,
            },
            { ..fed, h: start, missed: None, done: false },
            l.body,
          );
          if fed.fault != None { fed }
          else if body.fault != None { { ..fed, fault: body.fault } }
          else if body.live { { ..fed, fault: Some(b"a loop's body that falls off its end") } }
          else {
            {
              ..fed,
              h: {
                ..fed.h,
                owned: if is_refcounted(l.result.representation) {
                  fed.h.owned.insert(l.result.id, 1)
                } else { fed.h.owned },
              },
              live: body.done,
            }
          }
        },
        Next(args) -> match context.looped {
          None -> { ..acc, fault: Some(b"a loop's next pass outside a loop") },
          Some(lp) -> if args.len() != lp.state.len()
              || !arguments_match_variables(args, lp.state) {
            { ..acc, fault: Some(b"a loop's next pass represented otherwise than its state") }
          } else {
            ended(
              args.fold(acc, pass_argument),
              lp.held,
              b"a count represented otherwise than the loop represents it where it passes again: v",
            )
          },
        },
        Done(a) -> match context.looped {
          None -> { ..acc, fault: Some(b"a loop's result outside a loop") },
          Some(lp) -> if !same_rep(a, lp.result.representation) {
            { ..acc, fault: Some(b"a loop's result represented otherwise") }
          } else {
            {
              ..ended(pass_argument(acc, a), lp.held, b"a count represented otherwise than the loop represents it where it is left: v"),
              done: true,
            }
          },
        },
        Return(a) -> if context.handled { fault_leaving_handle(acc) }
        else if !same_rep(a, context.result) {
          { ..acc, fault: Some(b"a result represented otherwise than the root returns it") }
        } else {
          ended(
            match context.returned {
              OwnedResult -> pass_argument(acc, a),
              BorrowedResult(from) -> check_borrowed_result(acc, a, from),
            },
            Map::new(),
            b"a count still owned where the body returns: v",
          )
        },
        Restart(args) -> if context.handled { fault_leaving_handle(acc) }
        else if !arguments_match_parameters(f, context.member, args) {
          { ..acc, fault: Some(b"a restart's arguments represented otherwise than its parameters") }
        } else {
          ended(
            pass_arguments(acc, args, parameter_ownership(f, context.member)),
            Map::new(),
            b"a count still owned where the body restarts: v",
          )
        },
        Jump(e) -> if context.handled { fault_leaving_handle(acc) }
        else if !arguments_match_parameters(f, Some(e.member), e.args) {
          { ..acc, fault: Some(b"a group's member entered with arguments represented otherwise") }
        } else {
          ended(
            pass_arguments(acc, e.args, parameter_ownership(f, Some(e.member))),
            Map::new(),
            b"a count still owned where the body enters its group: v",
          )
        },
        Fail(x) ->
          ended(
            x.unwind.fold(
              x.resource.fold(acc, |w: CheckState, u: Unwinding|
                match operand_var(u.arg) { Some(v) -> read_of(w, v), None -> w }),
              consumed,
            ),
            context.landing,
            b"a count represented otherwise than the handle around represents it where the body fails: v",
          ),
        Handle(_) -> check_handle(f, context, acc, i),
        Inc(n) -> if !is_refcounted(n.var.representation) || acc.h.immortal.contains(n.var.id) {
          faulted(acc, b"a count taken of a value that holds none: v", n.var)
        } else if is_token(n.var) { faulted(acc, b"a count taken of a reuse token: v", n.var) }
        else {
          let read = read_of(acc, n.var);
          if read.fault != None { read } else {
            resolved(read.h, n.var).fold(read, |x: CheckState, t: Var|
              { ..x, h: { ..x.h, owned: x.h.owned.insert(t.id, count(x.h, t) + n.n) } })
          }
        },
        Dec(v) -> if !is_refcounted(v.representation) || acc.h.immortal.contains(v.id) {
          faulted(acc, b"a count let go of a value that holds none: v", v)
        } else if is_token(v) { faulted(acc, b"a reuse token let go as a value: v", v) }
        else { consumed(acc, v) },
        Reset(r) -> if !is_token(r.token) {
          faulted(acc, b"cells kept as other than a reuse token: v", r.token)
        } else {
          let c = consumed(acc, r.of);
          { ..c, h: { ..c.h, owned: c.h.owned.insert(r.token.id, 1) } }
        },
        Free(r) -> if !is_token(r.of) {
          faulted(acc, b"a block freed that is no reuse token: v", r.of)
        } else { consumed(acc, r.of) },
        Destructure(o) -> if !is_flat(o.of.representation) {
          block_opened(context, acc, o.of, o.words)
        } else if o.words.map(|w: Var| w.representation) != parts_of(o.of.representation) {
          faulted(acc, b"a value opened into words represented otherwise than its parts: v", o.of)
        } else {
          let c = consumed(acc, o.of);
          let read_arg = o.words.fold(c, |x: CheckState, v: Var|
            if is_refcounted(v.representation) {
              { ..x, h: { ..x.h, owned: x.h.owned.insert(v.id, count(x.h, v) + 1) } }
            } else { x });
          { ..read_arg, h: { ..read_arg.h, opened: read_arg.h.opened.insert(o.of.id, o.words) } }
        },
        SiteScope(_) -> acc,
        CleanupScope(Some(xs)) ->
          xs.fold(acc, |w: CheckState, x: Unwinding|
            match operand_var(x.arg) { Some(v) -> read_of(w, v), None -> w }),
        CleanupScope(None) -> acc,
      }
    })

fn check_let(
  context: Enclosing,
  acc: CheckState,
  y: Var,
  value: Rvalue,
  unwind: List<Var>,
) -> CheckState =
  match or_else(
      field_fault(
        acc.h,
        match context.looped { Some(lp) -> lp.held, None -> Map::new() },
        y,
        value,
      ),
      or_else(bytes_fault(acc.h, Some(y), value), uses_fault(Some(y), value)),
    ) {
    Some(f) -> faulted(acc, f.reason, f.v),
    None -> note_take(check_bound_value(context, acc, y, value, unwind), y, value),
  }

fn check_bound_value(
  context: Enclosing,
  acc: CheckState,
  y: Var,
  value: Rvalue,
  unwind: List<Var>,
) -> CheckState =
  match token_in(read_args(value)) {
    Some(t) -> faulted(acc, b"a reuse token read as a value: v", t),
    None -> match word_read(acc, y, value) {
      Some(w) -> w,
      None -> match escaping(acc.h, value) {
        Some(c) ->
          faulted(
            acc,
            b"a closure on this frame's stack handed beyond the call that borrows it: v",
            c,
          ),
        None -> match stack_captures(value) {
          Some(caps) -> {
            let read = failing(context, used(acc, operands(value)), value, unwind);
            let read_arg = caps.fold([], |vs: List<Var>, a: Arg|
              match operand_var(a) {
                Some(v) -> if is_refcounted(v.representation) { vs.push(v) } else { vs },
                None -> vs,
              });
            { ..read, h: { ..read.h, stacks: read.h.stacks.insert(y.id, read_arg) } }
          },
          None -> match representation_fault(y, value) {
            Some(reason) -> faulted(acc, reason, y),
            None -> if acc.h.immortal.contains(y.id) {
              failing(context, used(acc, operands(value)), value, unwind)
            } else {
              match count_shared_with(y, value) {
                Some(x) -> if borrowed_here(acc.h, x) {
                  let read = failing(context, read_of(acc, x), value, unwind);
                  if read.fault != None { read } else {
                    {
                      ..read,
                      h: {
                        ..read.h,
                        borrowed_from: read.h.borrowed_from.insert(y.id, owners_of(read.h, x)),
                      },
                    }
                  }
                } else {
                  result(
                    failing(context, used(acc, operands(value)), value, unwind),
                    y,
                    result_ownership(value),
                  )
                },
                None ->
                  result(
                    failing(context, used(acc, operands(value)), value, unwind),
                    y,
                    result_ownership(value),
                  ),
              }
            },
          },
        },
      },
    },
  }

fn check_handle(f: Fn, context: Enclosing, acc: CheckState, i: Inst) -> CheckState =
  match i {
    Handle(x) -> match token_in(x.args) {
      Some(t) -> faulted(acc, b"a reuse token read as a value: v", t),
      None -> if partly_taken_argument(acc.h, x.args) != None {
        { ..acc, fault: Some(b"a block used whole after a field was taken out of it") }
      } else if (x.site.detached != None || x.site.instance.heap != None)
          && x.args.any(|a: Arg|
            match operand_var(a) { Some(v) -> acc.h.stacks.contains(v.id), None -> false }) {
        {
          ..acc,
          fault: Some(
            b"a closure on this frame's stack handed to a handle whose instance may outlive it",
          ),
        }
      } else {
        let h = used(acc, by_signature(x.args, x.uses));
        let across = h.h;
        let after = {
          ..h,
          h: {
            ..across,
            owned: if is_refcounted(x.result.representation) { across.owned.insert(x.result.id, 1) }
            else { across.owned },
          },
        };
        if h.fault != None { h } else if with_released(context.landing, x.unwind) != across.owned {
          {
            ..h,
            fault: Some(
              b"a handle whose landing releases other than what it holds across its body",
            ),
          }
        } else if x.site.detached != None { after } else {
          let returns = x.site.ret != None;
          let ends = if returns { across.owned } else { after.h.owned };
          let body = check_block(
            f,
            { ..context, looped: None, landing: across.owned, arm: None, handled: true },
            {
              ..h,
              h: if returns { across } else { declared(across, x.result.id) },
              missed: None,
              done: false,
            },
            x.body,
          );
          if body.fault != None { { ..h, fault: body.fault } }
          else if !body.live { after }
          else if !returns && body.h.joins.get(x.result.id) != Some(true) {
            { ..h, fault: Some(b"a handle's body that ends without its result") }
          } else if counts_with_pending(body.h, ends) != ends {
            {
              ..h,
              fault: Some(
                b"a handle's body that ends holding other counts than the handle holds across it",
              ),
            }
          } else { after }
        }
      },
    },
    _ -> acc,
  }

fn field_fault(
  h: PathState,
  across: Map<Int, Int>,
  y: Var,
  value: Rvalue,
) -> Option<{ reason: Bytes, v: Var }> =
  match value {
    Take(t) -> if !can_take(t.of.representation, t.path) {
      Some({ reason: b"a field taken out of other than a block's word: v", v: t.of })
    } else if is_inline_record(t.of, t.path, y) {
      Some({ reason: b"a field taken that its block holds in place: v", v: y })
    } else if count(h, t.of) == 0 {
      Some({ reason: b"a field taken out of a block this body does not own: v", v: t.of })
    } else if across.contains(t.of.id) {
      Some({ reason: b"a field taken out of a block a loop holds across its passes: v", v: t.of })
    } else if is_path_taken(h, t.of, t.path) {
      Some({ reason: b"a field taken twice out of its block: v", v: t.of })
    } else { None },
    Get(g) -> if is_path_taken(h, g.of, g.path) {
      Some({ reason: b"a field read after it was taken out of its block: v", v: y })
    } else { None },
    Update(u) -> match h.taken.get(u.of.id) {
      Some(ps) -> if ps.all(|p: Path|
          match p {
            FieldPath(f) -> u.sets.any(|s: FieldWrite| s.at == f.at),
            InlineRecordPath(at) -> u.sets.any(|s: FieldWrite| s.at == at),
            _ -> false,
          }) { whole_fault(h, u.sets.map(|s: FieldWrite| s.arg)) }
      else { Some({ reason: b"a record updated without a field taken out of it: v", v: u.of }) },
      None -> whole_fault(h, read_args(value)),
    },
    _ -> whole_fault(h, read_args(value)),
  }

fn whole_fault(h: PathState, args: List<Arg>) -> Option<{ reason: Bytes, v: Var }> =
  match partly_taken_argument(h, args) {
    Some(v) -> Some({ reason: b"a block used whole after a field was taken out of it: v", v: v }),
    None -> None,
  }

fn uses_fault(y: Option<Var>, value: Rvalue) -> Option<{ reason: Bytes, v: Var }> = {
  let unmatched = |args: List<Arg>, uses: OperationSignature|
    if uses.takes.len() == args.len() { None } else {
      Some({
        reason: b"an operation whose uses name other than its operands: v",
        v: match y { Some(a) -> a, None -> first_var(args, unknown_var()) },
      })
    };
  match value {
    Op(o) -> unmatched(o.args, o.uses),
    Native(n) -> unmatched(n.args, n.uses),
    _ -> None,
  }
}

fn bytes_fault(h: PathState, y: Option<Var>, value: Rvalue) -> Option<{ reason: Bytes, v: Var }> =
  match value {
    Get(g) -> match g.path {
      PayloadPath -> if g.of.representation != AsWord {
        Some({ reason: b"a block's bytes read out of other than a block's word: v", v: g.of })
      } else {
        match y {
          Some(a) -> if a.representation != AsAddress {
            Some({
              reason: b"a block's bytes read represented otherwise than as an address: v",
              v: a,
            })
          } else { None },
          None -> None,
        }
      },
      _ -> None,
    },
    Op(o) -> {
      let named = match y { Some(a) -> a, None -> first_var(o.args, unknown_var()) };
      match o.op {
        OfStrings(op) -> string_fault(h, y, named, op, o.args, o.uses),
        OfContainers(CopyOut) -> if o.args.len() == 1
            && o.args.all(|a: Arg| !is_refcounted(operand_representation(a)))
            && o.uses.owned
            && !o.uses.takes.any(|t: Bool| t)
            && (match y { Some(a) -> a.representation == AsWord, None -> false }) { None } else {
          Some({
            reason: b"the bytes a marshalling returned taken other than as a block of their own: v",
            v: named,
          })
        },
        _ -> None,
      }
    },
    _ -> None,
  }

fn string_fault(
  h: PathState,
  y: Option<Var>,
  named: Var,
  op: StringOp,
  args: List<Arg>,
  uses: OperationSignature,
) -> Option<{ reason: Bytes, v: Var }> = {
  let kinds = string_operands(op);
  if kinds.len() != args.len() {
    Some({ reason: b"an operation over bytes handed other than its operands: v", v: named })
  } else if uses != string_signature(op) {
    Some({
      reason: b"an operation over bytes taking or returning otherwise than its rule: v",
      v: named,
    })
  } else {
    let operand = range(0, args.len()).fold(
      None,
      |found: Option<{ reason: Bytes, v: Var }>, k: Int|
        match found {
          Some(_) -> found,
          None -> match ((kinds.at(k), args.at(k))) {
            (Some(kind), Some(a)) -> operand_fault(h, kind, a, named),
            _ -> None,
          },
        },
    );
    match operand {
      Some(_) -> operand,
      None -> {
        let result = match y { Some(a) -> a.representation, None -> AsInt };
        let read_arg = match string_result(op) {
          OwnBlock -> y != None && result == AsWord,
          _ -> !is_refcounted(result),
        };
        if read_arg { None } else {
          Some({
            reason: b"an operation over bytes returning otherwise than its rule: v",
            v: named,
          })
        }
      },
    }
  }
}

fn operand_fault(
  h: PathState,
  kind: StringOperand,
  a: Arg,
  named: Var,
) -> Option<{ reason: Bytes, v: Var }> =
  match kind {
    ReadsAddress -> match a {
      VarOperand(v) -> if points_into(v.representation) { None } else {
        Some({ reason: b"an operation over bytes reading through other than an address: v", v: v })
      },
      _ ->
        Some({
          reason: b"an operation over bytes reading through other than an address: v",
          v: named,
        }),
    },
    Number -> if is_refcounted(operand_representation(a)) {
      Some({ reason: b"an operation over bytes handed a counted value as a number: v", v: named })
    } else { None },
    _ -> match a {
      VarOperand(v) -> if v.representation != AsWord {
        Some({
          reason: b"an operation over bytes handed a block represented otherwise than as its word: v",
          v: v,
        })
      } else if kind == WritesBlock && count(h, v) == 0 {
        Some({ reason: b"a block written into that this body holds no count of: v", v: v })
      } else { None },
      _ ->
        Some({ reason: b"an operation over bytes handed a block no variable holds: v", v: named }),
    },
  }

fn first_var(args: List<Arg>, otherwise: Var) -> Var =
  match args.fold(None, |found: Option<Var>, a: Arg|
      match found { Some(_) -> found, None -> operand_var(a) }) {
    Some(v) -> v,
    None -> otherwise,
  }

fn unknown_var() -> Var = { id: 0 - 1, ty: word_type(), representation: AsInt }

fn partly_taken_argument(h: PathState, args: List<Arg>) -> Option<Var> =
  args.fold(None, |found: Option<Var>, a: Arg|
    match found {
      Some(_) -> found,
      None -> match operand_var(a) {
        Some(v) -> match h.taken.get(v.id) {
          Some(ps) -> if ps.len() > 0 { Some(v) } else { None },
          None -> None,
        },
        None -> None,
      },
    })

fn is_path_taken(h: PathState, of: Var, p: Path) -> Bool =
  match h.taken.get(of.id) { Some(ps) -> ps.contains(p), None -> false }

pub fn reuses_cells(made: Allocation) -> Bool = match made { CaseAllocation(_) -> true, _ -> false }

pub fn is_field_path(p: Path) -> Bool =
  match p { FieldPath(_) -> true, ArgumentPath(_) -> true, InlineRecordPath(_) -> true, _ -> false }

pub fn can_take(r: Representation, path: Path) -> Bool =
  (r == AsWord && is_field_path(path)) || boxed_read(r, path) || inline_word(r, path) != None

pub fn inline_word(r: Representation, path: Path) -> Option<Int> =
  match ((r, path)) {
    (AsSum(s), CasePath(p)) -> layout::inline_word_at(s.layout, p.case, p.at),
    _ -> None,
  }

pub fn boxed_read(r: Representation, path: Path) -> Bool =
  match ((r, path)) {
    (AsSum(s), CasePath(p)) -> match s.layout.cases.at(p.case) {
      Some(c) -> match c.payload { Boxed(_) -> true, _ -> false },
      None -> false,
    },
    _ -> false,
  }

pub fn is_inline_record(of: Var, path: Path, reader: Var) -> Bool =
  match path {
    InlineRecordPath(_) -> false,
    FieldPath(p) ->
      has_record_layout(reader.ty)
        || (match kind_of(of.ty).ty {
          RecordShape(fs) -> fs.any(|f: FieldShape| f.name == p.name && inline_fields(f) != None),
          _ -> false,
        }),
    _ -> has_record_layout(reader.ty),
  }

fn has_record_layout(ty: Type) -> Bool = match kind_of(ty).ty { RecordShape(_) -> true, _ -> false }

fn note_take(w: CheckState, y: Var, value: Rvalue) -> CheckState =
  if w.fault != None { w } else {
    match value {
      Take(t) ->
        {
          ..w,
          h: {
            ..w.h,
            taken: w.h.taken.insert(t.of.id, match w.h.taken.get(t.of.id) {
              Some(ps) -> ps.push(t.path),
              None -> [t.path],
            }),
          },
        },
      IfUnique(_) -> { ..w, h: { ..w.h, unique_checks: w.h.unique_checks.insert(y.id, true) } },
      _ -> w,
    }
  }

fn last_tested(h: PathState, cond: Arg) -> Option<Var> =
  match cond {
    VarOperand(n) -> if h.unique_checks.contains(n.id) { Some(n) } else { None },
    _ -> None,
  }

fn sum_tested(t: Test, r: Representation) -> Bool =
  match r { AsSum(s) -> match t { TagTest(names) -> names == s.cases, _ -> false }, _ -> true }

fn case_position_exists(of: Var, p: { case: Int, at: Int }) -> Bool =
  match of.representation {
    AsWord -> has_variables(of.ty),
    AsSum(s) -> match s.layout.cases.at(p.case) {
      Some(c) -> match c.payload {
        Nullary -> false,
        Inline(i) -> p.at >= 0 && p.at < layout::words(i.layout),
        Boxed(b) -> p.at >= 0 && p.at < layout::words(b.layout),
      },
      None -> false,
    },
    _ -> false,
  }

fn block_opened(context: Enclosing, acc: CheckState, of: Var, parts: List<Var>) -> CheckState =
  if !opens_as(context, of, parts) {
    faulted(acc, b"a value opened that is not owned only here: v", of)
  } else {
    parts.fold(consumed(acc, of), |x: CheckState, v: Var|
      if is_refcounted(v.representation) {
        { ..x, h: { ..x.h, owned: x.h.owned.insert(v.id, count(x.h, v) + 1) } }
      } else { x })
  }

fn opens_as(context: Enclosing, of: Var, parts: List<Var>) -> Bool =
  match of.representation {
    AsWord -> true,
    AsSum(s) ->
      sole_boxed_payload(s.layout) != None
        || (match context.known.get(of.id) {
          Some(k) ->
            s.layout.classes.len() == 1
              && (match ((parts, s.layout.cases.at(k))) {
                ([b], Some(c)) -> match c.payload {
                  Inline(_) -> match b.representation {
                    AsWord -> true,
                    AsSum(n) -> n.layout.classes.len() == 1,
                    _ -> false,
                  },
                  Boxed(_) -> match b.representation {
                    AsSum(n) -> sole_boxed_payload(n.layout) != None,
                    _ -> false,
                  },
                  Nullary -> false,
                },
                _ -> false,
              }),
          None -> false,
        }),
    _ -> false,
  }

fn merge_taken(a: Map<Int, List<Path>>, b: Map<Int, List<Path>>) -> Map<Int, List<Path>> =
  b.fold(a, |m: Map<Int, List<Path>>, id: Int, ps: List<Path>|
    m.insert(
      id,
      ps.fold(match m.get(id) { Some(qs) -> qs, None -> [] }, |qs: List<Path>, p: Path|
        if qs.contains(p) { qs } else { qs.push(p) }),
    ))

fn arm_entry_state(before: CheckState, at: PathState) -> PathState =
  { ..at, borrowed_from: borrowed_after(before.h, [at]) }

fn borrowed_after(before: PathState, out: List<PathState>) -> Map<Int, List<Int>> =
  out.fold(before.borrowed_from, |m: Map<Int, List<Int>>, h: PathState|
    h.borrowed_from.fold(m, |n: Map<Int, List<Int>>, id: Int, bs: List<Int>|
      if before.joins.contains(id) && !before.borrowed_from.contains(id) {
        n.insert(id, ints_joined(match n.get(id) { Some(xs) -> xs, None -> [] }, bs))
      } else { n }))

fn joined_paths(before: PathState, x: PathState, y: PathState) -> PathState =
  x.pending.fold(x, |h: PathState, id: Int, _: Bool|
    if !before.joins.contains(id) || before.pending.contains(id) || y.pending.contains(id) { h }
    else {
      {
        ..h,
        pending: h.pending.remove(id),
        owned: match y.owned.get(id) { Some(n) -> h.owned.insert(id, n), None -> h.owned },
      }
    })

fn counts_with_pending(h: PathState, expected: Map<Int, Int>) -> Map<Int, Int> =
  h.pending.fold(h.owned, |m: Map<Int, Int>, id: Int, _: Bool|
    match expected.get(id) {
      Some(n) -> if m.contains(id) { m } else { m.insert(id, n) },
      None -> m,
    })

fn joined(before: CheckState, a: CheckState, b: CheckState) -> CheckState =
  match a.fault {
    Some(_) -> a,
    None -> match b.fault {
      Some(_) -> b,
      None -> {
        let missed = match a.missed {
          Some(x) -> match b.missed {
            Some(y) -> Some({ ..x, taken: merge_taken(x.taken, y.taken) }),
            None -> a.missed,
          },
          None -> b.missed,
        };
        let both = match a.missed {
          Some(x) -> match b.missed {
            Some(y) -> x.owned != y.owned || x.unset != y.unset,
            None -> false,
          },
          None -> false,
        };
        let done = a.done || b.done;
        if both { { ..a, fault: Some(b"the misses of an arm own different counts") } }
        else if a.live && b.live {
          let ah = joined_paths(before.h, a.h, b.h);
          let bh = joined_paths(before.h, b.h, a.h);
          let ours = scoped(ah, before.h);
          if ah.owned != bh.owned {
            { ..a, fault: Some(b"the paths out of a branch own different counts") }
          } else if ours.unset != scoped(bh, before.h).unset {
            { ..a, fault: Some(b"the paths out of a branch set different joins") }
          } else {
            {
              ..a,
              h: {
                ..ours,
                borrowed_from: borrowed_after(before.h, [ah, bh]),
                taken: merge_taken(a.h.taken, b.h.taken),
              },
              missed: missed,
              done: done,
            }
          }
        } else if a.live {
          {
            ..a,
            h: { ..scoped(a.h, before.h), borrowed_from: borrowed_after(before.h, [a.h]) },
            missed: missed,
            done: done,
          }
        } else if b.live {
          {
            ..b,
            h: { ..scoped(b.h, before.h), borrowed_from: borrowed_after(before.h, [b.h]) },
            missed: missed,
            done: done,
          }
        } else { { ..a, live: false, missed: missed, done: done } }
      },
    },
  }

fn scoped(h: PathState, outer: PathState) -> PathState =
  outer.unset.fold(
    { ..h, joins: outer.joins, unset: outer.unset },
    |s: PathState, id: Int, _: Bool|
      if h.unset.contains(id) { s }
      else { { ..s, joins: s.joins.insert(id, true), unset: s.unset.remove(id) } },
  )

fn declared(h: PathState, id: Int) -> PathState =
  { ..h, joins: h.joins.insert(id, false), unset: h.unset.insert(id, true) }

fn used(w: CheckState, ops: List<{ arg: Arg, takes: Bool }>) -> CheckState =
  ops.fold(w, |acc: CheckState, o: { arg: Arg, takes: Bool }|
    if o.takes { consume_arg(acc, o.arg) } else { read_arg(acc, o.arg) })

fn consume_arg(w: CheckState, a: Arg) -> CheckState =
  match a { VarOperand(v) -> consumed(w, v), _ -> w }

fn pass_argument(w: CheckState, a: Arg) -> CheckState =
  match a {
    VarOperand(v) -> if is_token(v) { faulted(w, b"a reuse token read as a value: v", v) }
    else if partly_taken_argument(w.h, [a]) != None {
      faulted(w, b"a block used whole after a field was taken out of it: v", v)
    } else if w.h.stacks.contains(v.id) {
      faulted(w, b"a closure on this frame's stack handed beyond the call that borrows it: v", v)
    } else { consumed(w, v) },
    _ -> w,
  }

fn is_token(v: Var) -> Bool = match v.representation { AsReuseToken(_) -> true, _ -> false }

fn token_in(args: List<Arg>) -> Option<Var> =
  args.fold(None, |found: Option<Var>, a: Arg|
    match found {
      Some(_) -> found,
      None -> match operand_var(a) {
        Some(v) -> if is_token(v) { Some(v) } else { None },
        None -> None,
      },
    })

fn read_args(value: Rvalue) -> List<Arg> =
  match value {
    Allocate(m) -> m.args,
    _ -> operands(value).map(|o: { arg: Arg, takes: Bool }| o.arg),
  }

fn read_arg(w: CheckState, a: Arg) -> CheckState =
  match a { VarOperand(v) -> read_of(w, v), _ -> w }

fn word_read(w: CheckState, y: Var, value: Rvalue) -> Option<CheckState> =
  match value {
    Get(g) -> match w.h.opened.get(g.of.id) {
      None -> match payload_of(value, y) {
        None -> None,
        Some(x) -> {
          let whole = match w.h.alias.get(x.id) { Some(t) -> t, None -> x };
          let r = read_of(w, whole);
          Some(if r.fault != None { r }
          else { { ..r, h: { ..r.h, alias: r.h.alias.insert(y.id, whole) } } })
        },
      },
      Some(ws) ->
        Some(match g.path {
          LeafPath(k) -> match ws.at(k) {
            None -> faulted(w, b"a read past the words of an opened value: v", y),
            Some(word) -> if word.representation != y.representation {
              faulted(w, b"a word of an opened value read as other than it is represented: v", y)
            } else if !is_refcounted(word.representation) { w } else {
              let r = read_of(w, word);
              if r.fault != None { r }
              else { { ..r, h: { ..r.h, alias: r.h.alias.insert(y.id, word) } } }
            },
          },
          _ -> faulted(w, b"an opened value read other than by its words: v", y),
        }),
    },
    _ -> None,
  }

pub fn allocates(from: Representation, to: Representation) -> Bool =
  one_word(to)
    && (!is_refcounted(from)
    || (match from {
      AsFlattened(_) -> true,
      AsListView -> true,
      AsSum(_) -> !is_counted_word(from),
      _ -> false,
    }))

fn one_word(r: Representation) -> Bool = r == AsWord

pub fn is_counted_word(r: Representation) -> Bool =
  match r {
    AsSum(s) -> layout::words(SumCases(s.layout)) == 1 && is_refcounted(r),
    _ -> one_word(r),
  }

pub fn result_ownership(value: Rvalue) -> Provenance =
  match value {
    Aggregate(g) -> if g.parts.any(|a: Arg| is_refcounted(operand_representation(a))) { Owns }
    else { Immortal },
    _ -> provenance(value),
  }

pub fn count_shared_with(y: Var, value: Rvalue) -> Option<Var> =
  match value {
    Convert(p) -> match operand_var(p.arg) {
      Some(x) -> if is_counted_word(p.to) && is_counted_word(x.representation)
          && !is_record_word(x) { Some(x) }
      else { None },
      None -> None,
    },
    Aggregate(g) -> {
      let read_arg = g.parts.filter(|a: Arg| is_refcounted(operand_representation(a)));
      if !is_counted_word(y.representation) || read_arg.len() != 1 { None } else {
        match read_arg.at(0) {
          Some(VarOperand(x)) -> if is_counted_word(x.representation) && !is_record_word(x) {
            Some(x)
          } else { None },
          _ -> None,
        }
      }
    },
    _ -> None,
  }

pub fn payload_of(value: Rvalue, y: Var) -> Option<Var> =
  match value {
    Get(g) -> match g.path {
      CasePath(p) -> if is_counted_word(y.representation) && sole_count(g.of.representation, p) {
        Some(g.of)
      } else { None },
      _ -> None,
    },
    _ -> None,
  }

fn sole_count(r: Representation, p: { case: Int, at: Int }) -> Bool =
  match r {
    AsSum(s) -> match s.layout.cases.at(p.case) {
      Some(c) -> match c.payload {
        Inline(i) -> {
          let cs = layout::classes(i.layout);
          (match cs.at(p.at) { Some(k) -> counted_class(k), None -> false })
            && cs.filter(counted_class).len() == 1
        },
        _ -> false,
      },
      None -> false,
    },
    _ -> false,
  }

fn counted_class(c: WordClass) -> Bool =
  match c { Pointer -> true, PointerSum(_) -> true, Mixed -> true, _ -> false }

pub fn allocation_words(m: Allocation) -> Int =
  match m { CaseAllocation(c) -> c.skip + c.words, _ -> 0 }

fn names_each(tested: Test, whens: List<Int>) -> Bool =
  match tested { TagTest(names) -> whens.all(|w: Int| w >= 0 && w < names.len()), _ -> true }

fn is_flat(r: Representation) -> Bool = match r { AsFlattened(_) -> true, _ -> false }

fn resolved(h: PathState, v: Var) -> List<Var> =
  match h.stacks.get(v.id) {
    Some(caps) -> caps.fold([], |acc: List<Var>, c: Var| acc.concat(word_of(h, c))),
    None -> word_of(h, v),
  }

fn word_of(h: PathState, v: Var) -> List<Var> =
  match h.opened.get(v.id) {
    Some(ws) -> ws.filter(|x: Var| is_refcounted(x.representation)),
    None -> match h.alias.get(v.id) { Some(x) -> [x], None -> [v] },
  }

fn consumed(w: CheckState, v: Var) -> CheckState =
  if w.h.stacks.contains(v.id) { read_of(w, v) } else { resolved(w.h, v).fold(w, consumed_one) }

fn read_of(w: CheckState, v: Var) -> CheckState = resolved(w.h, v).fold(w, read_one)

fn escaping(h: PathState, value: Rvalue) -> Option<Var> =
  match value {
    Call(_) -> None,
    Apply(_) -> None,
    _ ->
      operands(value).fold(None, |found: Option<Var>, o: { arg: Arg, takes: Bool }|
        match found {
          Some(_) -> found,
          None -> match operand_var(o.arg) {
            Some(v) -> if o.takes && h.stacks.contains(v.id) { Some(v) } else { None },
            None -> None,
          },
        }),
  }

pub fn points_into(r: Representation) -> Bool = r == AsAddress

pub fn is_uncounted(y: Var, value: Rvalue, immortal: Map<Int, Bool>) -> Bool =
  match value {
    Static(_) -> true,
    Aggregate(g) ->
      g.parts.all(|a: Arg|
        match a {
          VarOperand(v) -> !is_refcounted(v.representation) || immortal.contains(v.id),
          _ -> true,
        }),
    Get(g) -> immortal.contains(g.of.id),
    _ -> match count_shared_with(y, value) { Some(x) -> immortal.contains(x.id), None -> false },
  }

pub fn uncounted_variables(f: Fn) -> Map<Int, Bool> = {
  let sets = joins_set(Map::new(), f.body);
  range(0, binders(f.body) + 1).fold(
    { found: Map::new(), done: false },
    |acc: { found: Map<Int, Bool>, done: Bool }, _: Int|
      if acc.done { acc } else {
        let lets = uncounted_lets(acc.found, f.body);
        let next = sets.fold(lets, |m: Map<Int, Bool>, j: Int, args: List<Arg>|
          if args.all(|a: Arg|
              match a {
                VarOperand(v) -> !is_refcounted(v.representation) || m.contains(v.id),
                _ -> true,
              }) { m.insert(j, true) }
          else { m });
        { found: next, done: next.len() == acc.found.len() }
      },
  ).found
}

fn uncounted_lets(found: Map<Int, Bool>, b: Block) -> Map<Int, Bool> =
  b.fold(found, |m: Map<Int, Bool>, i: Inst|
    match i {
      Let(l) -> if is_uncounted(l.var, l.value, m) { m.insert(l.var.id, true) } else { m },
      If(x) -> uncounted_lets(uncounted_lets(m, x.then), x.otherwise),
      Case(c) ->
        c.arms.fold(
          uncounted_lets(m, c.rest),
          |n: Map<Int, Bool>, a: { when: Int, body: Block }| uncounted_lets(n, a.body),
        ),
      Match(x) ->
        x.arms.fold(uncounted_lets(m, x.rest), |n: Map<Int, Bool>, a: Block| uncounted_lets(n, a)),
      Loop(l) -> uncounted_lets(m, l.body),
      Handle(h) -> uncounted_lets(m, h.body),
      _ -> m,
    })

fn joins_set(m: Map<Int, List<Arg>>, b: Block) -> Map<Int, List<Arg>> =
  b.fold(m, |acc: Map<Int, List<Arg>>, i: Inst|
    match i {
      Declaration(v) -> if acc.contains(v.id) { acc } else { acc.insert(v.id, []) },
      Assign(x) -> match acc.get(x.var.id) {
        Some(xs) -> acc.insert(x.var.id, xs.push(x.arg)),
        None -> acc,
      },
      If(x) -> joins_set(joins_set(acc, x.then), x.otherwise),
      Case(c) ->
        c.arms.fold(
          joins_set(acc, c.rest),
          |n: Map<Int, List<Arg>>, a: { when: Int, body: Block }| joins_set(n, a.body),
        ),
      Match(x) ->
        x.arms.fold(joins_set(acc, x.rest), |n: Map<Int, List<Arg>>, a: Block| joins_set(n, a)),
      Loop(l) -> joins_set(acc, l.body),
      Handle(h) -> joins_set(acc, h.body),
      _ -> acc,
    })

fn binders(b: Block) -> Int =
  b.fold(0, |n: Int, i: Inst|
    n
      + (match i {
        Let(_) -> 1,
        Declaration(_) -> 1,
        If(x) -> binders(x.then) + binders(x.otherwise),
        Case(c) ->
          c.arms.fold(binders(c.rest), |k: Int, a: { when: Int, body: Block }| k + binders(a.body)),
        Match(x) -> x.arms.fold(binders(x.rest), |k: Int, a: Block| k + binders(a)),
        Loop(l) -> binders(l.body),
        Handle(h) -> binders(h.body),
        _ -> 0,
      }))

pub fn stack_captures(value: Rvalue) -> Option<List<Arg>> =
  match value { Allocate(m) -> stack_borrows(m.made, m.args), _ -> None }

fn consumed_one(w: CheckState, v: Var) -> CheckState =
  if w.fault != None { w }
  else if w.h.unset.contains(v.id) { unset_read(w, v) } else if points_into(v.representation) {
    faulted(w, b"an address handed on beyond its block: v", v)
  } else if !is_refcounted(v.representation) { w } else {
    let n = count(w.h, v);
    if n > 0 {
      {
        ..w,
        h: {
          ..w.h,
          owned: if n == 1 { w.h.owned.remove(v.id) } else { w.h.owned.insert(v.id, n - 1) },
        },
      }
    } else if w.h.immortal.contains(v.id) || w.h.pending.contains(v.id) { w }
    else if w.h.borrowed_from.contains(v.id) {
      faulted(w, b"a borrowed value consumed with no count of its own: v", v)
    } else { faulted(w, b"a value consumed with no count left: v", v) }
  }

fn read_one(w: CheckState, v: Var) -> CheckState =
  if w.fault != None { w }
  else if w.h.unset.contains(v.id) { unset_read(w, v) }
  else if (!is_refcounted(v.representation) && !points_into(v.representation))
      || w.h.immortal.contains(v.id)
      || w.h.pending.contains(v.id)
      || count(w.h, v) > 0 { w } else {
    match w.h.borrowed_from.get(v.id) {
      Some(bs) -> if bs.all(|b: Int|
          w.h.borrowed.contains(b) || w.h.owned.contains(b) || w.h.borrowed_from.contains(b)) { w }
      else { faulted(w, b"a value read after what it was read out of was let go: v", v) },
      None -> faulted(w, b"a value read with no count left: v", v),
    }
  }

fn unset_read(w: CheckState, v: Var) -> CheckState =
  faulted(w, b"a join read before it is set: v", v)

fn failing(context: Enclosing, w: CheckState, value: Rvalue, unwind: List<Var>) -> CheckState =
  if w.fault != None || !may_leave(value) {
    if unwind.len() > 0 && w.fault == None {
      { ..w, fault: Some(b"a release on the way out of a value that neither fails nor stops") }
    } else { w }
  } else {
    let released = with_released(context.landing, unwind);
    if released == counts_with_pending(w.h, released) { w }
    else { { ..w, fault: Some(b"a failure path that releases other than what it holds") } }
  }

pub fn may_leave(value: Rvalue) -> Bool = fails(value) || may_suspend(value)

fn with_released(landing: Map<Int, Int>, unwind: List<Var>) -> Map<Int, Int> =
  unwind.fold(landing, |m: Map<Int, Int>, v: Var|
    m.insert(v.id, match m.get(v.id) { Some(n) -> n + 1, None -> 1 }))

fn result(w: CheckState, v: Var, a: Provenance) -> CheckState =
  if w.fault != None || (!is_refcounted(v.representation) && !points_into(v.representation)) { w }
  else {
    match a {
      Owns -> if points_into(v.representation) {
        faulted(w, b"an address represented as a count of its own: v", v)
      } else { { ..w, h: { ..w.h, owned: w.h.owned.insert(v.id, 1) } } },
      BorrowSources(reads) ->
        {
          ..w,
          h: {
            ..w.h,
            borrowed_from: w.h.borrowed_from.insert(
              v.id,
              reads.fold([], |bs: List<Int>, read: Var|
                ints_joined(
                  bs,
                  owners_of(w.h, match w.h.alias.get(read.id) { Some(word) -> word, None -> read }),
                )),
            ),
          },
        },
      Immortal -> { ..w, h: { ..w.h, borrowed_from: w.h.borrowed_from.insert(v.id, []) } },
    }
  }

fn ints_joined(a: List<Int>, b: List<Int>) -> List<Int> =
  b.fold(a, |acc: List<Int>, x: Int| if acc.contains(x) { acc } else { acc.push(x) })

fn join_owns_count(w: CheckState, j: Var) -> CheckState =
  if is_refcounted(j.representation) { { ..w, h: { ..w.h, owned: w.h.owned.insert(j.id, 1) } } }
  else { w }

fn check_borrowed_result(
  w: CheckState,
  a: Arg,
  from: List<{ param: Int, whole: Bool }>,
) -> CheckState =
  match operand_var(a) {
    None -> w,
    Some(v) -> if !is_refcounted(v.representation) { w }
    else if count(w.h, v) > 0 { faulted(w, b"a borrowed result owning a count of its own: v", v) }
    else if owners_of(w.h, v).all(|b: Int|
        match w.h.borrowed.get(b) {
          Some(place) -> from.any(|x: { param: Int, whole: Bool }| x.param == place),
          None -> false,
        }) { read_of(w, v) } else {
      faulted(w, b"a borrowed result read out of other than the parameters its root names: v", v)
    },
  }

fn ended(w: CheckState, kept: Map<Int, Int>, reason: Bytes) -> CheckState = {
  let read_arg = counts_with_pending(w.h, kept);
  if w.fault != None { w }
  else if read_arg == kept { { ..w, live: false } } else {
    let odd = read_arg.keys().concat(kept.keys()).filter(|id: Int|
      read_arg.get(id) != kept.get(id));
    match odd.at(0) {
      Some(id) -> { ..w, fault: Some(reason.concat(ascii_of_int(id))), live: false },
      None -> { ..w, live: false },
    }
  }
}

fn fault_leaving_handle(w: CheckState) -> CheckState =
  { ..w, fault: Some(b"a body that leaves its root from inside a handle") }

fn representation_fault(v: Var, value: Rvalue) -> Option<Bytes> =
  match value {
    Call(c) -> call_representation_fault(v, c.args, c.convention),
    Apply(c) -> call_representation_fault(v, c.args, c.convention),
    Convert(p) -> if p.to != v.representation {
      Some(b"a value packed otherwise than its variable holds it: v")
    } else { None },
    IfUnique(x) -> if x.representation != v.representation {
      Some(b"a last holder's test returned otherwise than its value is represented: v")
    } else { None },
    Aggregate(g) -> match v.representation {
      AsSum(s) -> match g.parts.at(0) {
        Some(IntOperand(k)) -> if k >= 0 && k < s.cases.len() { None }
        else { Some(b"a sum gathered as a case it does not have: v") },
        _ -> Some(b"a sum gathered from other than its case's place: v"),
      },
      AsFlattened(_) -> if g.parts.fold([], |rs: List<Representation>, a: Arg|
            rs.concat(parts_of(operand_representation(a))))
          == parts_of(v.representation) { None }
      else { Some(b"a record gathered from parts represented otherwise than its leaves: v") },
      _ -> None,
    },
    Update(u) -> if v.representation != AsWord || u.of.representation != AsWord {
      Some(b"a record written over other than in its box: v")
    } else if record_fields(u.of.ty) != record_fields(v.ty) {
      Some(b"a record written over the box of a record of other fields: v")
    } else { None },
    Get(g) -> match g.path {
      CasePath(p) -> if case_position_exists(g.of, p) { None }
      else { Some(b"a case's payload read past what the case lays: v") },
      _ -> None,
    },
    Allocate(m) -> if v.representation != AsWord {
      Some(b"a value made represented otherwise than as its word: v")
    } else {
      match m.reuse {
        Some(t) -> if !is_token(t) { Some(b"a value made in cells no reset kept: v") }
        else if !reuses_cells(m.made) {
          Some(b"a value made in cells its printer does not take: v")
        } else if t.representation != AsReuseToken(allocation_words(m.made))
            || allocation_words(m.made) == 0 { Some(b"a value made in cells of another size: v") }
        else { None },
        None -> None,
      }
    },
    _ -> None,
  }

fn call_representation_fault(v: Var, args: List<Arg>, conv: Convention) -> Option<Bytes> =
  if conv.result != v.representation {
    Some(b"a call's result bound otherwise than its convention represents it: v")
  } else if !arguments_match_representations(args, reps_of(conv)) {
    Some(b"a call's operand represented otherwise than its convention takes it: v")
  } else if !borrows_from_borrowed(args.map(operand_representation), conv) {
    Some(b"a call's result borrowed of other than a counted operand it passes borrowed: v")
  } else { None }

fn borrows_from_borrowed(read_arg: List<Representation>, conv: Convention) -> Bool =
  match conv.returned {
    OwnedResult -> true,
    BorrowedResult(from) ->
      from.all(|x: { param: Int, whole: Bool }|
        param_borrowed(conv, x.param)
          && (match read_arg.at(x.param) { Some(r) -> is_refcounted(r), None -> false })),
  }

fn arguments_match_representations(args: List<Arg>, reps: List<Representation>) -> Bool =
  args.len() == reps.len()
    && range(0, args.len()).all(|i: Int|
      match args.at(i) {
        Some(a) -> match reps.at(i) { Some(r) -> same_rep(a, r), None -> false },
        None -> false,
      })

fn arguments_match_variables(args: List<Arg>, vars: List<Var>) -> Bool =
  range(0, args.len()).all(|i: Int|
    match args.at(i) {
      Some(a) -> match vars.at(i) { Some(v) -> same_rep(a, v.representation), None -> false },
      None -> false,
    })

fn results_count(v: Rvalue) -> Bool =
  match v {
    Call(c) -> is_refcounted(c.convention.result) && c.convention.returned == OwnedResult,
    Apply(c) -> is_refcounted(c.convention.result),
    Allocate(_) -> true,
    Take(_) -> true,
    Get(_) -> false,
    OperandsOnly(_) -> true,
    Convert(p) -> is_refcounted(p.to) && !is_unboxing(p.arg, p.to),
    Aggregate(g) -> g.parts.any(|a: Arg| is_refcounted(operand_representation(a))),
    Native(n) -> n.uses.owned,
    Op(o) -> o.uses.owned,
    _ -> false,
  }

fn count(h: PathState, v: Var) -> Int = match h.owned.get(v.id) { Some(n) -> n, None -> 0 }

fn faulted(w: CheckState, reason: Bytes, v: Var) -> CheckState =
  { ..w, fault: Some(reason.concat(ascii_of_int(v.id))) }

fn same_rep(a: Arg, r: Representation) -> Bool =
  match a { VarOperand(v) -> v.representation == r, _ -> true }

fn test_fits_representation(t: Test, r: Representation) -> Bool =
  match t { IntTest(_) -> numeric(r), RangeTest(_) -> numeric(r), _ -> true }

fn numeric(r: Representation) -> Bool =
  match r { AsInt -> true, AsBool -> true, AsFixed(_) -> true, _ -> false }

fn word(id: Int) -> Var = { id: id, ty: string_type(), representation: AsWord }

fn int(id: Int) -> Var = { id: id, ty: int_type(), representation: AsInt }

fn flag(id: Int) -> Var = { id: id, ty: bool_type(), representation: AsBool }

fn root_of(params: List<Var>, borrowed: List<Int>, result: Representation, body: Block) -> Fn =
  {
    key: Named(b"m.f"),
    kind: Metered,
    params: params,
    convention: {
      params: borrowed_where(params.map(|p: Var| p.representation), borrowed),
      result: result,
      destination_passing: false,
      returned: OwnedResult,
    },
    result_type: NamedType({ name: b"T", args: [] }),
    body: body,
    lambdas: [],
    base: 0,
    members: [],
    links: no_links(),
    statics: [],
  }

fn call_of(args: List<Arg>, borrowed: List<Int>) -> Rvalue =
  Call({
    callee: Root(Named(b"m.g")),
    args: args,
    convention: {
      params: borrowed_where(args.map(operand_representation), borrowed),
      result: AsWord,
      destination_passing: false,
      returned: OwnedResult,
    },
    suspends: false,
  })

fn bind(v: Var, value: Rvalue, unwind: List<Var>) -> Inst =
  Let({ var: v, value: value, at: dummy_span(), unwind: unwind })

test "a record is written over only in the box of a record of its own fields" {
  let text = string_type();
  let boxed = |id: Int, names: List<Bytes>|
    { id: id, ty: RecordType(names.map(|n: Bytes| { name: n, ty: text })), representation: AsWord };
  let over = |from: List<Bytes>| {
    let made = boxed(1, [b"p", b"texts"]);
    ownership_fault(
      root_of([boxed(0, from)], [], AsWord, [
        bind(made, Update({ of: boxed(0, from), sets: [] }), []),
        Return(VarOperand(made)),
      ]),
    )
  };
  assert_eq(over([b"p", b"texts"]), None);
  assert_eq(
    over([b"p", b"text"]),
    Some(b"a record written over the box of a record of other fields: v1"),
  )
}

test "a count is consumed exactly once on every path, or the body is rejected" {
  let p = word(0);
  let r = word(1);
  assert_eq(ownership_fault(root_of([p], [], AsWord, [Return(VarOperand(p))])), None);
  assert_eq(
    ownership_fault(root_of([p], [], AsInt, [Return(IntOperand(0))])),
    Some(b"a count still owned where the body returns: v0"),
  );
  assert_eq(
    ownership_fault(
      root_of([p], [], AsWord, [
        bind(r, call_of([VarOperand(p), VarOperand(p)], []), []),
        Return(VarOperand(r)),
      ]),
    ),
    Some(b"a value consumed with no count left: v0"),
  );
  assert_eq(
    ownership_fault(
      root_of([p], [], AsWord, [
        Inc({ var: p, n: 1 }),
        bind(r, call_of([VarOperand(p), VarOperand(p)], []), []),
        Return(VarOperand(r)),
      ]),
    ),
    None,
  );
  assert_eq(
    ownership_fault(
      root_of([p], [0], AsWord, [
        bind(r, call_of([VarOperand(p)], [0]), []),
        Return(VarOperand(r)),
      ]),
    ),
    None,
  )
}

test "what a failing call's path releases is exactly what the path holds across it" {
  let p = word(0);
  let r = word(1);
  let body = |unwind: List<Var>|
    [
      Inc({ var: p, n: 1 }),
      bind(r, call_of([VarOperand(p)], []), unwind),
      Dec(p),
      Return(VarOperand(r)),
    ];
  assert_eq(ownership_fault(root_of([p], [], AsWord, body([p]))), None);
  assert_eq(
    ownership_fault(root_of([p], [], AsWord, body([]))),
    Some(b"a failure path that releases other than what it holds"),
  )
}

test "a branch tests a Bool, and a case a number, held as one, never a word that holds one" {
  let boxed = { ..flag(0), representation: AsWord };
  let branch = |on: Var|
    root_of([on], [0], AsInt, [
      If({ cond: VarOperand(on), then: [Return(IntOperand(1))], otherwise: [] }),
      Return(IntOperand(0)),
    ]);
  assert_eq(ownership_fault(branch(flag(0))), None);
  assert_eq(
    ownership_fault(branch(boxed)),
    Some(b"a branch on a value represented otherwise than as a Bool"),
  );
  let cased = |on: Var|
    root_of([on], [0], AsInt, [
      Case({
        on: on,
        test: IntTest([1]),
        arms: [{ when: 0, body: [Return(IntOperand(1))] }],
        rest: [],
      }),
      Return(IntOperand(0)),
    ]);
  assert_eq(ownership_fault(cased(flag(0))), None);
  assert_eq(
    ownership_fault(cased(boxed)),
    Some(b"a case testing as a number a value represented otherwise: v0"),
  )
}

test "a variable is used held as it was bound, which its C names follow" {
  let p = word(0);
  let n = word(1);
  let body = |result: Var| [bind(n, call_of([VarOperand(p)], []), []), Return(VarOperand(result))];
  assert_eq(ownership_fault(root_of([p], [], AsWord, body(n))), None);
  assert_eq(
    ownership_fault(
      root_of(
        [p],
        [],
        AsWord,
        body({ ..n, representation: AsFlattened([{ name: b"a", representation: AsWord }]) }),
      ),
    ),
    Some(b"a variable used represented otherwise than it was bound: v1"),
  );
  let may_leave = { ..n, representation: AsFlattened([{ name: b"a", representation: AsWord }]) };
  let listed = Allocate({ made: ListAllocation(1), args: [VarOperand(p)], reuse: None });
  assert_eq(
    ownership_fault(
      root_of([p], [], AsFlattened([{ name: b"a", representation: AsWord }]), [
        bind(may_leave, listed, []),
        Return(VarOperand(may_leave)),
      ]),
    ),
    Some(b"a value made represented otherwise than as its word: v1"),
  )
}

test "the values holding no count are a static, what is gathered, held again or read in place of such values, and a join set only from them" {
  let c = { id: 0, ty: bool_type(), representation: AsBool };
  let p = word(1);
  let s = word(2);
  let t = word(3);
  let j = word(4);
  let k = word(5);
  let o = { id: 6, ty: option_type(string_type()), representation: maybe_word() };
  let branch = |join: Var, other: Arg|
    If({
      cond: VarOperand(c),
      then: [Assign({ var: join, arg: VarOperand(s) })],
      otherwise: [Assign({ var: join, arg: other })],
    });
  let f = root_of([c, p], [], AsWord, [
    bind(s, Static(b"k"), []),
    bind(t, Static(b"l"), []),
    Declaration(j),
    branch(j, VarOperand(t)),
    Declaration(k),
    branch(k, VarOperand(p)),
    bind(o, Aggregate({ parts: [IntOperand(1), VarOperand(j)] }), []),
    Return(VarOperand(k)),
  ]);
  assert_eq(uncounted_variables(f).keys().sort(), [s.id, t.id, j.id, o.id].sort());
  assert_eq(uncounted_variables(f).contains(k.id), false);
  let read = word(7);
  let g = root_of([c, p], [], AsWord, [
    bind(s, Static(b"k"), []),
    bind(read, Get({ of: s, path: LeafPath(0) }), []),
    Return(VarOperand(read)),
  ]);
  assert(uncounted_variables(g).contains(read.id))
}

test "the paths out of a branch hold the same counts and set the same joins" {
  let p = word(0);
  let s = word(1);
  let j = int(2);
  assert_eq(
    ownership_fault(
      root_of([p], [], AsInt, [
        If({ cond: BoolOperand(true), then: [Dec(p)], otherwise: [] }),
        Return(IntOperand(0)),
      ]),
    ),
    Some(b"the paths out of a branch own different counts"),
  );
  assert_eq(
    ownership_fault(
      root_of([p], [], AsWord, [
        If({
          cond: BoolOperand(true),
          then: [Return(VarOperand(p))],
          otherwise: [Dec(p), bind(s, Static(b"k"), []), Return(VarOperand(s))],
        }),
      ]),
    ),
    None,
  );
  assert_eq(
    ownership_fault(
      root_of([], [], AsWord, [
        bind(s, Static(b"k"), []),
        Inc({ var: s, n: 1 }),
        Return(VarOperand(s)),
      ]),
    ),
    Some(b"a count taken of a value that holds none: v1"),
  );
  assert_eq(
    ownership_fault(
      root_of([p], [], AsInt, [
        Dec(p),
        Declaration(j),
        If({
          cond: BoolOperand(true),
          then: [Assign({ var: j, arg: IntOperand(1) })],
          otherwise: [],
        }),
        Return(VarOperand(j)),
      ]),
    ),
    Some(b"the paths out of a branch set different joins"),
  );
  let early = |read: Inst|
    ownership_fault(
      root_of([p], [], AsInt, [
        Dec(p),
        Declaration(j),
        read,
        Assign({ var: j, arg: IntOperand(1) }),
        Return(VarOperand(j)),
      ]),
    );
  assert_eq(early(SiteScope(None)), None);
  assert_eq(early(Return(VarOperand(j))), Some(b"a join read before it is set: v2"));
  assert_eq(
    early(If({ cond: VarOperand(j), then: [], otherwise: [] })),
    Some(b"a join read before it is set: v2"),
  )
}

test "a borrowed value is read only while what it was read out of is held" {
  let p = word(0);
  let x = word(1);
  let r = word(2);
  let read_after = |first: List<Inst>|
    root_of(
      [p],
      [],
      AsWord,
      [bind(x, Get({ of: p, path: LeafPath(0) }), [])].concat(first).concat([
        bind(r, call_of([VarOperand(x)], [0]), []),
        Return(VarOperand(r)),
      ]),
    );
  assert_eq(
    ownership_fault(read_after([Dec(p)])),
    Some(b"a value read after what it was read out of was let go: v1"),
  );
  assert_eq(
    ownership_fault(
      root_of([p], [], AsWord, [
        bind(x, Get({ of: p, path: LeafPath(0) }), []),
        bind(r, call_of([VarOperand(x)], [0]), [p]),
        Dec(p),
        Return(VarOperand(r)),
      ]),
    ),
    None,
  );
  assert_eq(
    ownership_fault(
      root_of([p], [], AsWord, [
        bind(x, Get({ of: p, path: LeafPath(0) }), []),
        Dec(p),
        Return(VarOperand(x)),
      ]),
    ),
    Some(b"a borrowed value consumed with no count of its own: v1"),
  )
}

test "a match's next arm starts from what the arm before held where it missed" {
  let p = word(0);
  let q = word(1);
  let arms = |miss: List<Inst>|
    root_of([p, q], [], AsWord, [
      Match({
        arms: [
          [
            If({
              cond: BoolOperand(true),
              then: [Dec(q), Return(VarOperand(p))],
              otherwise: miss.push(Miss),
            }),
          ],
          [Return(VarOperand(q))],
        ],
        rest: [Dec(q), Fail({ reason: NoMatchingArm, at: dummy_span(), resource: [], unwind: [] })],
      }),
    ]);
  assert_eq(ownership_fault(arms([Dec(p)])), None);
  assert_eq(ownership_fault(arms([])), Some(b"a count still owned where the body returns: v0"));
  assert_eq(
    ownership_fault(
      root_of([p, q], [], AsWord, [
        Match({
          arms: [
            [If({ cond: BoolOperand(true), then: [Dec(p), Miss], otherwise: [Miss] })],
            [Dec(p), Return(VarOperand(q))],
          ],
          rest: [],
        }),
      ]),
    ),
    Some(b"the misses of an arm own different counts"),
  );
  assert_eq(
    ownership_fault(root_of([p], [], AsWord, [Miss])),
    Some(b"an arm's miss outside a match"),
  )
}

test "a loop holds the same counts across each of its passes, and a count it left holds after it" {
  let p = word(0);
  let s = word(1);
  let n = word(2);
  let a = word(3);
  let looped = |pass: List<Inst>|
    root_of([p], [], AsWord, [
      Inc({ var: p, n: 1 }),
      Loop({
        state: [{ var: s, init: VarOperand(p) }],
        body: [
          If({
            cond: BoolOperand(true),
            then: [Done(VarOperand(s))],
            otherwise: pass.concat([
              bind(n, call_of([VarOperand(p), VarOperand(s)], []), [p]),
              Next([VarOperand(n)]),
            ]),
          }),
        ],
        result: a,
      }),
      Dec(p),
      Return(VarOperand(a)),
    ]);
  assert_eq(ownership_fault(looped([Inc({ var: p, n: 1 })])), None);
  assert_eq(
    ownership_fault(looped([])),
    Some(b"a failure path that releases other than what it holds"),
  );
  assert_eq(
    ownership_fault(
      root_of([p], [], AsWord, [
        Loop({ state: [{ var: s, init: VarOperand(p) }], body: [Dec(s)], result: a }),
        Return(VarOperand(a)),
      ]),
    ),
    Some(b"a loop's body that falls off its end"),
  );
  assert_eq(
    ownership_fault(root_of([p], [], AsWord, [Next([VarOperand(p)])])),
    Some(b"a loop's next pass outside a loop"),
  )
}

test "a handle's body leaves to its landing what the handle holds across it" {
  let p = word(0);
  let r = word(1);
  let a = word(2);
  let c = flag(3);
  let site = { clauses: [], ret: None, detached: None, instance: empty_instance(0) };
  let uses = { takes: [], owned: false, fails: true, suspends: false };
  let landed = |body: List<Inst>, unwind: List<Var>, landing: List<Var>|
    root_of([p, c], [], AsWord, [
      Handle({
        body: body.concat([
          bind(r, call_of([VarOperand(p)], [0]), unwind),
          Assign({ var: a, arg: VarOperand(r) }),
        ]),
        args: [],
        uses: uses,
        site: site,
        result: a,
        unwind: landing,
      }),
      Dec(p),
      Return(VarOperand(a)),
    ]);
  let handled = |body: List<Inst>, unwind: List<Var>| landed(body, unwind, [p]);
  assert_eq(ownership_fault(handled([], [])), None);
  assert_eq(
    ownership_fault(handled([], [p])),
    Some(b"a failure path that releases other than what it holds"),
  );
  assert_eq(
    ownership_fault(landed([], [], [])),
    Some(b"a handle whose landing releases other than what it holds across its body"),
  );
  assert_eq(
    ownership_fault(
      handled(
        [
          If({
            cond: VarOperand(c),
            then: [Fail({ reason: NoMatchingArm, at: dummy_span(), resource: [], unwind: [] })],
            otherwise: [],
          }),
        ],
        [],
      ),
    ),
    None,
  );
  assert_eq(
    ownership_fault(
      handled(
        [
          If({
            cond: VarOperand(c),
            then: [
              Dec(p),
              Fail({ reason: NoMatchingArm, at: dummy_span(), resource: [], unwind: [] }),
            ],
            otherwise: [],
          }),
        ],
        [],
      ),
    ),
    Some(
      b"a count represented otherwise than the handle around represents it where the body fails: v0",
    ),
  );
  assert_eq(
    ownership_fault(
      handled(
        [If({ cond: VarOperand(c), then: [Dec(p), Return(VarOperand(p))], otherwise: [] })],
        [],
      ),
    ),
    Some(b"a body that leaves its root from inside a handle"),
  )
}

test "a reuse token is kept by a reset, taken by a make or freed, and never read as a value" {
  let r = word(0);
  let v = word(1);
  let n = word(2);
  let token = { ..word(3), representation: AsReuseToken(1) };
  let made = |reuse: Option<Var>|
    Allocate({
      made: CaseAllocation({ case: 0, skip: 0, words: 1 }),
      args: [VarOperand(v)],
      reuse: reuse,
    });
  let reset = Reset({ token: token, of: r });
  assert_eq(
    ownership_fault(
      root_of([r, v], [], AsWord, [reset, bind(n, made(Some(token)), []), Return(VarOperand(n))]),
    ),
    None,
  );
  assert_eq(
    ownership_fault(
      root_of([r, v], [], AsWord, [
        reset,
        Free({ of: token, bytes: IntOperand(8) }),
        bind(n, made(None), []),
        Return(VarOperand(n)),
      ]),
    ),
    None,
  );
  let w = word(6);
  let failing = |value: Rvalue, unwind: List<Var>|
    ownership_fault(
      root_of([r, v], [], AsWord, [
        reset,
        bind(w, value, unwind),
        Dec(w),
        Free({ of: token, bytes: IntOperand(8) }),
        bind(n, made(None), []),
        Return(VarOperand(n)),
      ]),
    );
  assert_eq(failing(call_of([], []), [v, token]), None);
  assert_eq(
    failing(
      Allocate({ made: CaseAllocation({ case: 0, skip: 0, words: 0 }), args: [], reuse: None }),
      [v, token],
    ),
    Some(b"a release on the way out of a value that neither fails nor stops"),
  );
  let stopping = |unwind: List<Var>|
    failing(
      Native({
        name: b"m.yield",
        args: [],
        uses: { takes: [], owned: true, fails: false, suspends: true },
      }),
      unwind,
    );
  assert_eq(stopping([v, token]), None);
  assert_eq(stopping([v]), Some(b"a failure path that releases other than what it holds"));
  assert_eq(
    ownership_fault(
      root_of([r, v], [], AsWord, [
        reset,
        Dec(token),
        bind(n, made(None), []),
        Return(VarOperand(n)),
      ]),
    ),
    Some(b"a reuse token let go as a value: v3"),
  );
  assert_eq(
    ownership_fault(
      root_of([r, v], [], AsWord, [
        reset,
        bind(n, call_of([VarOperand(token)], []), []),
        Dec(v),
        Return(VarOperand(n)),
      ]),
    ),
    Some(b"a reuse token read as a value: v3"),
  );
  assert_eq(
    ownership_fault(
      root_of([r, v], [], AsWord, [
        Reset({ token: { ..token, representation: AsWord }, of: r }),
        bind(n, made(None), []),
        Return(VarOperand(n)),
      ]),
    ),
    Some(b"cells kept as other than a reuse token: v3"),
  );
  assert_eq(
    ownership_fault(
      root_of([r, v], [], AsWord, [Dec(r), bind(n, made(Some(v)), []), Return(VarOperand(n))]),
    ),
    Some(b"a value made in cells no reset kept: v2"),
  );
  let wide = { ..token, representation: AsReuseToken(2) };
  assert_eq(
    ownership_fault(
      root_of([r, v], [], AsWord, [
        Reset({ token: wide, of: r }),
        bind(n, made(Some(wide)), []),
        Return(VarOperand(n)),
      ]),
    ),
    Some(b"a value made in cells of another size: v2"),
  );
  assert_eq(
    ownership_fault(
      root_of([r, v], [], AsWord, [
        reset,
        bind(
          n,
          Allocate({ made: ListAllocation(1), args: [VarOperand(v)], reuse: Some(token) }),
          [],
        ),
        Return(VarOperand(n)),
      ]),
    ),
    Some(b"a value made in cells its printer does not take: v2"),
  )
}

test "an opened value is its parts, each word counted on its own and read only by its leaves" {
  let s = {
    id: 0,
    ty: NamedType({ name: b"m.S", args: [] }),
    representation: AsFlattened([
      { name: b"a", representation: AsWord },
      { name: b"n", representation: AsInt },
    ]),
  };
  let w0 = word(1);
  let w1 = int(2);
  let w2 = word(3);
  let y = word(4);
  let r = word(5);
  let opened = Destructure({ of: s, words: [w0, w1] });
  let leaf = bind(y, Get({ of: s, path: LeafPath(0) }), []);
  let called = [bind(r, call_of([VarOperand(y)], []), []), Return(VarOperand(r))];
  assert_eq(ownership_fault(root_of([s], [], AsWord, [opened, leaf].concat(called))), None);
  assert_eq(
    ownership_fault(
      root_of([s], [], AsWord, [
        opened,
        bind(r, call_of([VarOperand(s)], []), []),
        Return(VarOperand(r)),
      ]),
    ),
    None,
  );
  assert_eq(
    ownership_fault(root_of([s], [], AsWord, [opened, Dec(w0), leaf].concat(called))),
    Some(b"a value read with no count left: v1"),
  );
  assert_eq(
    ownership_fault(
      root_of(
        [s],
        [],
        AsWord,
        [opened, bind(y, Get({ of: s, path: FieldPath({ name: b"a", at: 0 }) }), [])].concat(
          called,
        ),
      ),
    ),
    Some(b"an opened value read other than by its words: v4"),
  );
  assert_eq(
    ownership_fault(
      root_of([s], [], AsWord, [Destructure({ of: s, words: [w0, w2] }), Dec(w2)].concat(called)),
    ),
    Some(b"a value opened into words represented otherwise than its parts: v0"),
  );
  let k = int(6);
  assert_eq(
    ownership_fault(
      root_of([k], [], AsWord, [Destructure({ of: k, words: [w2] }), Return(VarOperand(w2))]),
    ),
    Some(b"a value opened that is not owned only here: v6"),
  )
}

test "a field taken out of its block is never read again, nor the block used whole" {
  let p = word(0);
  let x = word(1);
  let y = word(2);
  let take = bind(x, Take({ of: p, path: FieldPath({ name: b"f", at: 0 }) }), []);
  assert_eq(ownership_fault(root_of([p], [], AsWord, [take, Dec(p), Return(VarOperand(x))])), None);
  assert_eq(
    ownership_fault(
      root_of([p], [], AsWord, [
        take,
        bind(y, Get({ of: p, path: FieldPath({ name: b"f", at: 0 }) }), []),
        Dec(p),
        Return(VarOperand(x)),
      ]),
    ),
    Some(b"a field read after it was taken out of its block: v2"),
  );
  assert_eq(
    ownership_fault(root_of([p], [], AsWord, [take, Dec(x), Return(VarOperand(p))])),
    Some(b"a block used whole after a field was taken out of it: v0"),
  );
  assert_eq(
    ownership_fault(root_of([p], [0], AsWord, [take, Return(VarOperand(x))])),
    Some(b"a field taken out of a block this body does not own: v0"),
  );
  let inner = RecordType([{ name: b"a", ty: int_type() }, { name: b"s", ty: string_type() }]);
  let holder = {
    ..p,
    ty: RecordType([{ name: b"in", ty: inner }, { name: b"t", ty: string_type() }]),
  };
  let placed = |reader: Var|
    ownership_fault(
      root_of([holder], [], AsWord, [
        bind(reader, Take({ of: holder, path: FieldPath({ name: b"in", at: 0 }) }), []),
        Dec(holder),
        Return(VarOperand(reader)),
      ]),
    );
  assert_eq(placed({ ..x, ty: inner }), Some(b"a field taken that its block holds in place: v1"));
  assert_eq(placed(x), Some(b"a field taken that its block holds in place: v1"));
  assert_eq(
    ownership_fault(
      root_of([holder], [], AsWord, [
        bind(x, Take({ of: holder, path: FieldPath({ name: b"t", at: 4 }) }), []),
        Dec(holder),
        Return(VarOperand(x)),
      ]),
    ),
    None,
  );
  assert_eq(
    ownership_fault(
      root_of([p], [], AsWord, [
        Do({
          value: Take({ of: p, path: FieldPath({ name: b"f", at: 0 }) }),
          at: dummy_span(),
          unwind: [],
        }),
        Return(VarOperand(p)),
      ]),
    ),
    Some(b"a value whose count nothing holds"),
  )
}

test "a join declared inside a branch is the branch's own, which the paths out of it do not compare" {
  let c = flag(0);
  let d = flag(1);
  let outer = int(2);
  let inner = int(3);
  let o = word(4);
  let set = |j: Var, n: Int| Assign({ var: j, arg: IntOperand(n) });
  let chosen = [
    Declaration(inner),
    If({ cond: VarOperand(d), then: [set(inner, 1)], otherwise: [set(inner, 2)] }),
    Assign({ var: outer, arg: VarOperand(inner) }),
  ];
  assert_eq(
    ownership_fault(
      root_of([c, d], [], AsInt, [
        Declaration(outer),
        If({ cond: VarOperand(c), then: chosen, otherwise: [set(outer, 3)] }),
        Return(VarOperand(outer)),
      ]),
    ),
    None,
  );
  assert_eq(
    ownership_fault(
      root_of([o, d], [], AsInt, [
        Declaration(outer),
        Case({
          on: o,
          test: TagTest([b"A", b"B"]),
          arms: [{ when: 0, body: chosen }],
          rest: [set(outer, 3)],
        }),
        Dec(o),
        Return(VarOperand(outer)),
      ]),
    ),
    None,
  );
  assert_eq(
    ownership_fault(
      root_of([c, d], [], AsInt, [
        Declaration(outer),
        Match({
          arms: [[If({ cond: VarOperand(c), then: chosen, otherwise: [Miss] })], [set(outer, 3)]],
          rest: [Return(IntOperand(0))],
        }),
        Return(VarOperand(outer)),
      ]),
    ),
    None,
  );
  assert_eq(
    ownership_fault(
      root_of([c, d], [], AsInt, [
        Declaration(outer),
        If({ cond: VarOperand(c), then: chosen, otherwise: [] }),
        Return(VarOperand(outer)),
      ]),
    ),
    Some(b"the paths out of a branch set different joins"),
  )
}

test "an arm's misses hand the next arm only the joins declared before the match" {
  let c = flag(0);
  let d = flag(1);
  let j = int(2);
  let k = int(3);
  assert_eq(
    ownership_fault(
      root_of([c, d], [], AsInt, [
        Match({
          arms: [
            [
              If({ cond: VarOperand(c), then: [Miss], otherwise: [] }),
              Declaration(j),
              Assign({ var: j, arg: IntOperand(1) }),
              If({ cond: VarOperand(d), then: [Miss], otherwise: [Return(VarOperand(j))] }),
            ],
          ],
          rest: [Return(IntOperand(0))],
        }),
      ]),
    ),
    None,
  );
  assert_eq(
    ownership_fault(
      root_of([c], [], AsInt, [
        Match({
          arms: [
            [
              If({
                cond: VarOperand(c),
                then: [Miss],
                otherwise: [Declaration(k), Assign({ var: k, arg: IntOperand(2) }), Miss],
              }),
            ],
          ],
          rest: [Return(IntOperand(0))],
        }),
      ]),
    ),
    None,
  );
  assert_eq(
    ownership_fault(
      root_of([c], [], AsInt, [
        Declaration(j),
        Match({
          arms: [
            [
              If({
                cond: VarOperand(c),
                then: [Assign({ var: j, arg: IntOperand(1) }), Miss],
                otherwise: [Miss],
              }),
            ],
          ],
          rest: [Return(IntOperand(0))],
        }),
      ]),
    ),
    Some(b"the misses of an arm own different counts"),
  )
}

test "a body under a return clause hands what it returns to the landing, which sets the result" {
  let p = word(0);
  let r = word(1);
  let a = word(2);
  let handled = |ret: Option<Int>|
    ownership_fault(
      root_of([p], [], AsWord, [
        Handle({
          body: [
            bind(r, call_of([VarOperand(p)], [0]), []),
            Do({
              value: Op({
                op: OfHandling(Returning),
                args: [ZeroOperand(AsImmediate), VarOperand(r)],
                uses: { takes: [false, true], owned: false, fails: false, suspends: false },
              }),
              at: dummy_span(),
              unwind: [],
            }),
          ],
          args: [],
          uses: { takes: [], owned: false, fails: true, suspends: false },
          site: { clauses: [], ret: ret, detached: None, instance: empty_instance(0) },
          result: a,
          unwind: [p],
        }),
        Dec(p),
        Return(VarOperand(a)),
      ]),
    );
  assert_eq(handled(Some(0)), None);
  assert_eq(handled(None), Some(b"a handle's body that ends without its result"))
}

test "a field taken before any miss is taken for the next arm, a read by name is held, and a handle is handed a stacked closure only over an instance in the frame" {
  let p = word(0);
  let c = flag(1);
  let x = word(2);
  let y = word(5);
  let take = bind(x, Take({ of: p, path: FieldPath({ name: b"f", at: 0 }) }), []);
  let next_reads = |name: Bytes, at: Int|
    ownership_fault(
      root_of([p, c], [], AsWord, [
        Match({
          arms: [
            [If({ cond: VarOperand(c), then: [take, Dec(x), Miss], otherwise: [Miss] })],
            [
              bind(y, Get({ of: p, path: FieldPath({ name: name, at: at }) }), []),
              Inc({ var: y, n: 1 }),
              Dec(p),
              Return(VarOperand(y)),
            ],
          ],
          rest: [Dec(p), Return(ZeroOperand(AsWord))],
        }),
      ]),
    );
  assert_eq(next_reads(b"g", 1), None);
  assert_eq(next_reads(b"f", 0), Some(b"a field read after it was taken out of its block: v5"));
  let k = word(3);
  let a = word(4);
  let laid = bind(
    k,
    Allocate({
      made: StackAllocation(ClosureAllocation({ nth: 0, captures: 1, params: 0 })),
      args: [VarOperand(p)],
      reuse: None,
    }),
    [],
  );
  let handed = |detached: Bool, heap: Option<Int>|
    ownership_fault(
      root_of([p], [], AsWord, [
        laid,
        Handle({
          body: if detached { [] }
          else { [Inc({ var: p, n: 1 }), Assign({ var: a, arg: VarOperand(p) })] },
          args: [VarOperand(k)],
          uses: { takes: [false], owned: false, fails: true, suspends: false },
          site: {
            clauses: [],
            ret: None,
            detached: if detached { Some({ body: 0, forwards: 0 }) } else { None },
            instance: { ..empty_instance(0), heap: heap },
          },
          result: a,
          unwind: [p],
        }),
        Dec(p),
        Return(VarOperand(a)),
      ]),
    );
  assert_eq(handed(false, None), None);
  let outlives = Some(
    b"a closure on this frame's stack handed to a handle whose instance may outlive it",
  );
  assert_eq([handed(true, None), handed(false, Some(0))], [outlives, outlives])
}

test "a case arm on a constructor is one its test names" {
  let p = word(0);
  let cased = |when: Int|
    root_of([p], [], AsWord, [
      Case({
        on: p,
        test: TagTest([b"A", b"B"]),
        arms: [{ when: when, body: [Return(VarOperand(p))] }],
        rest: [Return(VarOperand(p))],
      }),
    ]);
  assert_eq(ownership_fault(cased(1)), None);
  assert_eq(
    ownership_fault(cased(2)),
    Some(b"a case arm for a constructor its test does not name: v0"),
  )
}

test "an operand is held as its operation takes it, and a counted result is held by a variable" {
  let p = word(0);
  let n = int(1);
  let r = word(2);
  let int_call = Call({
    callee: Root(Named(b"m.g")),
    args: [VarOperand(p)],
    convention: {
      params: [{ handed: OwnedParam, representation: AsInt }],
      result: AsWord,
      destination_passing: false,
      returned: OwnedResult,
    },
    suspends: false,
  });
  assert_eq(
    ownership_fault(root_of([p], [], AsWord, [bind(r, int_call, []), Return(VarOperand(r))])),
    Some(b"a call's operand represented otherwise than its convention takes it: v2"),
  );
  assert_eq(
    ownership_fault(
      root_of([p], [], AsWord, [bind(n, call_of([VarOperand(p)], []), []), Return(VarOperand(p))]),
    ),
    Some(b"a call's result bound otherwise than its convention represents it: v1"),
  );
  assert_eq(
    ownership_fault(
      root_of([p], [], AsInt, [
        Do({ value: call_of([VarOperand(p)], []), at: dummy_span(), unwind: [] }),
        Return(IntOperand(0)),
      ]),
    ),
    Some(b"a value whose count nothing holds"),
  );
  assert_eq(
    ownership_fault(root_of([p], [], AsWord, [Dec(n), Return(VarOperand(p))])),
    Some(b"a count let go of a value that holds none: v1"),
  );
  let retained = Op({
    op: OfContainers(Retain),
    args: [VarOperand(p)],
    uses: { takes: [], owned: true, fails: false, suspends: false },
  });
  assert_eq(
    ownership_fault(root_of([p], [], AsWord, [bind(r, retained, []), Return(VarOperand(r))])),
    Some(b"an operation whose uses name other than its operands: v2"),
  )
}

test "a root holds a parameter as its convention takes it or as a view of the list it takes, and restarts on arguments held as its parameters are" {
  let list = list_type(int_type());
  let view = { id: 0, ty: list, representation: AsListView };
  let w = { id: 1, ty: list, representation: AsWord };
  let n = int(2);
  let walk = |body: Block|
    {
      ..root_of([view, n], [], AsInt, body),
      convention: {
        params: [
          { handed: OwnedParam, representation: AsWord },
          { handed: OwnedParam, representation: AsInt },
        ],
        result: AsInt,
        destination_passing: false,
        returned: OwnedResult,
      },
    };
  assert_eq(ownership_fault(walk([Dec(view), Return(VarOperand(n))])), None);
  assert_eq(ownership_fault(walk([Restart([VarOperand(view), VarOperand(n)])])), None);
  assert_eq(
    ownership_fault(
      walk([bind(w, call_of([], []), [view]), Dec(view), Restart([VarOperand(w), VarOperand(n)])]),
    ),
    Some(b"a restart's arguments represented otherwise than its parameters"),
  );
  assert_eq(
    ownership_fault({
      ..root_of([n], [], AsInt, [Return(VarOperand(n))]),
      convention: {
        params: [{ handed: OwnedParam, representation: AsWord }],
        result: AsInt,
        destination_passing: false,
        returned: OwnedResult,
      },
    }),
    Some(b"a parameter represented otherwise than its convention takes it"),
  )
}

test "a boxed case made and a value held as no C value are checked as any other value" {
  let p = word(0);
  let r = word(1);
  let boxed = CaseAllocation({ case: 1, skip: 0, words: 2 });
  assert_eq(
    ownership_fault(
      root_of([p], [], AsWord, [
        bind(r, Allocate({ made: boxed, args: [VarOperand(p), IntOperand(0)], reuse: None }), []),
        Return(VarOperand(r)),
      ]),
    ),
    None,
  );
  assert_eq(
    ownership_fault(root_of([{ ..p, representation: AsUnit }], [], AsInt, [Return(IntOperand(0))])),
    None,
  )
}

test "a record is gathered from its leaves' values in order, a record it holds as that record's" {
  let ty = NamedType({ name: b"m.S", args: [] });
  let inner = AsFlattened([
    { name: b"a", representation: AsWord },
    { name: b"n", representation: AsInt },
  ]);
  let outer = AsFlattened([
    { name: b"in.a", representation: AsWord },
    { name: b"in.n", representation: AsInt },
    { name: b"k", representation: AsInt },
  ]);
  let k = int(1);
  let o = { id: 2, ty: ty, representation: outer };
  let gathered = |part: Var|
    ownership_fault(
      root_of([part, k], [], outer, [
        bind(o, Aggregate({ parts: [VarOperand(part), VarOperand(k)] }), []),
        Return(VarOperand(o)),
      ]),
    );
  assert_eq(gathered({ id: 0, ty: ty, representation: inner }), None);
  assert_eq(
    gathered(word(0)),
    Some(b"a record gathered from parts represented otherwise than its leaves: v2"),
  )
}

fn bytes_op(op: StringOp, args: List<Arg>) -> Rvalue =
  Op({ op: OfStrings(op), args: args, uses: string_signature(op) })

fn address(id: Int) -> Var = { ..int(id), representation: AsAddress }

test "an address into a block's bytes is read out of a block's word, only while the block is held, and never handed on" {
  let b = word(0);
  let a = address(1);
  let n = int(2);
  let addressed = bind(a, Get({ of: b, path: PayloadPath }), []);
  let byte = bind(n, bytes_op(ByteRead, [VarOperand(a), IntOperand(0)]), []);
  let read = |body: Block| ownership_fault(root_of([b], [], AsInt, [addressed].concat(body)));
  assert_eq(read([byte, Dec(b), Return(VarOperand(n))]), None);
  assert_eq(
    read([Dec(b), byte, Return(VarOperand(n))]),
    Some(b"a value read after what it was read out of was let go: v1"),
  );
  assert_eq(
    ownership_fault(root_of([b], [0], AsInt, [addressed, byte, Return(VarOperand(n))])),
    None,
  );
  let w = word(3);
  assert_eq(
    read([
      bind(w, Allocate({ made: ListAllocation(1), args: [VarOperand(a)], reuse: None }), []),
      Dec(b),
      Dec(w),
      Return(IntOperand(0)),
    ]),
    Some(b"an address handed on beyond its block: v1"),
  );
  assert_eq(
    ownership_fault(root_of([b], [], AsAddress, [addressed, Dec(b), Return(VarOperand(a))])),
    Some(b"an address handed on beyond its block: v1"),
  );
  assert_eq(
    ownership_fault(
      root_of([n], [], AsInt, [
        bind(a, Get({ of: n, path: PayloadPath }), []),
        Return(IntOperand(0)),
      ]),
    ),
    Some(b"a block's bytes read out of other than a block's word: v2"),
  );
  assert_eq(
    read([bind(n, Get({ of: b, path: PayloadPath }), []), Dec(b), Return(VarOperand(n))]),
    Some(b"a block's bytes read represented otherwise than as an address: v2"),
  )
}

test "an operation over bytes is handed, takes and returns as its rule says, and writes only into a block held here" {
  let b = word(0);
  let a = address(1);
  let n = int(2);
  let fresh = word(3);
  let grown = word(4);
  let addressed = bind(a, Get({ of: b, path: PayloadPath }), []);
  let copied = Do({
    value: bytes_op(CopyBytes, [
      VarOperand(fresh),
      IntOperand(0),
      VarOperand(a),
      IntOperand(0),
      IntOperand(4),
    ]),
    at: dummy_span(),
    unwind: [],
  });
  let checked = |params: List<Var>, borrowed: List<Int>, result: Representation, body: Block|
    ownership_fault(root_of(params, borrowed, result, body));
  assert_eq(
    checked([b, fresh], [], AsWord, [addressed, copied, Dec(b), Return(VarOperand(fresh))]),
    None,
  );
  assert_eq(
    checked([b, grown], [], AsWord, [
      addressed,
      bind(fresh, bytes_op(AppendBytes, [VarOperand(grown), VarOperand(a), IntOperand(4)]), []),
      Dec(b),
      Return(VarOperand(fresh)),
    ]),
    None,
  );
  assert_eq(
    checked([b, fresh], [1], AsInt, [addressed, copied, Dec(b), Return(IntOperand(0))]),
    Some(b"a block written into that this body holds no count of: v3"),
  );
  let taking = Op({
    op: OfStrings(ByteRead),
    args: [VarOperand(a), IntOperand(0)],
    uses: { ..string_signature(ByteRead), takes: [true, false] },
  });
  let reads = |value: Rvalue|
    checked([b], [], AsInt, [addressed, bind(n, value, []), Dec(b), Return(VarOperand(n))]);
  assert_eq(
    reads(taking),
    Some(b"an operation over bytes taking or returning otherwise than its rule: v2"),
  );
  assert_eq(
    reads(bytes_op(ByteRead, [VarOperand(b), IntOperand(0)])),
    Some(b"an operation over bytes reading through other than an address: v0"),
  );
  assert_eq(
    reads(bytes_op(ByteRead, [VarOperand(a), VarOperand(b)])),
    Some(b"an operation over bytes handed a counted value as a number: v2"),
  );
  assert_eq(
    reads(bytes_op(ByteRead, [VarOperand(a)])),
    Some(b"an operation over bytes handed other than its operands: v2"),
  );
  assert_eq(
    checked([b, grown], [], AsWord, [
      addressed,
      bind(
        { ..fresh, representation: AsInt },
        bytes_op(AppendBytes, [VarOperand(grown), VarOperand(a), IntOperand(4)]),
        [],
      ),
      Dec(b),
      Return(IntOperand(0)),
    ]),
    Some(b"an operation over bytes returning otherwise than its rule: v3"),
  )
}

test "the bytes a marshalling call returned are taken as a block of their own, from a count" {
  let n = int(0);
  let t = word(1);
  let consume_arg = |uses: OperationSignature, into: Var|
    ownership_fault(
      root_of([n], [], AsInt, [
        bind(into, Op({ op: OfContainers(CopyOut), args: [VarOperand(n)], uses: uses }), []),
        Dec(into),
        Return(IntOperand(0)),
      ]),
    );
  let owned = { takes: [false], owned: true, fails: true, suspends: false };
  assert_eq(consume_arg(owned, t), None);
  assert_eq(
    consume_arg({ ..owned, owned: false }, t),
    Some(b"the bytes a marshalling returned taken other than as a block of their own: v1"),
  )
}

test "a last holder's test takes its value's count, which its result holds only where a branch finds it" {
  let x = word(0);
  let n = word(1);
  let tested = |then: Block, otherwise: Block|
    ownership_fault(
      root_of([x], [], AsInt, [
        bind(n, IfUnique(x), []),
        If({ cond: VarOperand(n), then: then, otherwise: otherwise }),
      ]),
    );
  assert_eq(tested([Restart([VarOperand(n)])], [Return(IntOperand(0))]), None);
  assert_eq(
    tested([Restart([VarOperand(n)])], [Dec(n), Return(IntOperand(0))]),
    Some(b"a value consumed with no count left: v1"),
  );
  assert_eq(
    tested([Return(IntOperand(0))], [Return(IntOperand(0))]),
    Some(b"a count still owned where the body returns: v1"),
  );
  assert_eq(
    ownership_fault(
      root_of([x], [], AsInt, [bind(n, IfUnique(x), []), Dec(n), Dec(x), Return(IntOperand(0))]),
    ),
    Some(b"a value consumed with no count left: v0"),
  );
  assert_eq(
    ownership_fault(
      root_of([x], [], AsInt, [
        If({
          cond: VarOperand(x),
          then: [Dec(x), Return(IntOperand(0))],
          otherwise: [Dec(x), Return(IntOperand(1))],
        }),
      ]),
    ),
    Some(b"a branch on a value represented otherwise than as a Bool"),
  );
  assert_eq(
    ownership_fault(
      root_of([x], [], AsInt, [
        bind({ ..n, representation: AsInt }, IfUnique(x), []),
        Return(IntOperand(0)),
      ]),
    ),
    Some(b"a last holder's test returned otherwise than its value is represented: v1"),
  )
}

test "a block of a laid type opened is consumed, and the counted words it holds are bound owned" {
  let b = word(0);
  let w = word(1);
  let k = int(2);
  let opened = |after: Block|
    ownership_fault(root_of([b], [], AsInt, [Destructure({ of: b, words: [w, k] })].concat(after)));
  assert_eq(opened([Dec(w), Return(IntOperand(0))]), None);
  assert_eq(
    opened([Return(IntOperand(0))]),
    Some(b"a count still owned where the body returns: v1"),
  );
  assert_eq(
    opened([Dec(w), Dec(b), Return(IntOperand(0))]),
    Some(b"a value consumed with no count left: v0"),
  );
  assert_eq(
    ownership_fault(
      root_of([b], [0], AsInt, [Destructure({ of: b, words: [w] }), Dec(w), Return(IntOperand(0))]),
    ),
    Some(b"a borrowed value consumed with no count of its own: v0"),
  )
}

fn maybe_word() -> Representation =
  AsSum({
    layout: {
      classes: [Pointer],
      cases: [
        { test: WordIs({ at: 0, value: 0 }), payload: Nullary },
        {
          test: WordOutside({ at: 0, values: [0] }),
          payload: Inline({ offset: 0, layout: PlainWords([Pointer]), stripped: None }),
        },
      ],
    },
    cases: [none_constructor(), some_constructor()],
  })

test "a sum is opened as the box its one case is boxed in, or as its one word in an arm on its case, and read where its case lays words" {
  let maybe = maybe_word();
  let boxed = AsSum({
    layout: {
      classes: [Pointer],
      cases: [
        {
          test: Always,
          payload: Boxed({
            at: 0,
            stripped: false,
            skip: 0,
            layout: PlainWords([Pointer, Pointer]),
          }),
        },
      ],
    },
    cases: [b"m.Node"],
  });
  let o = { ..word(0), representation: maybe };
  let s = word(1);
  let y = word(2);
  let on = |names: List<Bytes>, inside: Block|
    root_of([o], [], AsInt, [
      Case({
        on: o,
        test: TagTest(names),
        arms: [{ when: 1, body: inside }],
        rest: [Dec(o), Return(IntOperand(0))],
      }),
    ]);
  let arm = |inside: Block| on([none_constructor(), some_constructor()], inside);
  assert_eq(
    ownership_fault(arm([Destructure({ of: o, words: [s] }), Dec(s), Return(IntOperand(0))])),
    None,
  );
  assert_eq(
    ownership_fault(
      root_of([o], [], AsInt, [Destructure({ of: o, words: [s] }), Dec(s), Return(IntOperand(0))]),
    ),
    Some(b"a value opened that is not owned only here: v0"),
  );
  let n = { ..word(3), representation: boxed };
  assert_eq(
    ownership_fault(
      root_of([n], [], AsInt, [
        Destructure({ of: n, words: [s, y] }),
        Dec(s),
        Dec(y),
        Return(IntOperand(0)),
      ]),
    ),
    None,
  );
  let read = |p: { case: Int, at: Int }|
    ownership_fault(
      arm([
        bind(y, Get({ of: o, path: CasePath(p) }), []),
        Inc({ var: y, n: 1 }),
        Dec(o),
        Dec(y),
        Return(IntOperand(0)),
      ]),
    );
  assert_eq(read({ case: 1, at: 0 }), None);
  assert_eq(read({ case: 1, at: 1 }), Some(b"a case's payload read past what the case lays: v2"));
  assert_eq(read({ case: 0, at: 0 }), Some(b"a case's payload read past what the case lays: v2"));
  assert_eq(
    ownership_fault(on([some_constructor(), none_constructor()], [Dec(o), Return(IntOperand(0))])),
    Some(b"a case on a sum testing other constructors than the sum's: v0"),
  );
  let gathered = { ..word(4), representation: maybe };
  let gather = |parts: List<Arg>|
    ownership_fault(
      root_of([s], [], AsInt, [
        bind(gathered, Aggregate({ parts: parts }), []),
        Dec(gathered),
        Return(IntOperand(0)),
      ]),
    );
  assert_eq(gather([IntOperand(1), VarOperand(s)]), None);
  assert_eq(
    gather([IntOperand(2), VarOperand(s)]),
    Some(b"a sum gathered as a case it does not have: v4"),
  );
  assert_eq(gather([VarOperand(s)]), Some(b"a sum gathered from other than its case's place: v4"))
}

test "a word read out of a sum whose case lays it as its one counted word holds the sum's count" {
  let laid = |classes: List<WordClass>|
    AsSum({
      layout: {
        classes: classes,
        cases: [
          {
            test: Always,
            payload: Inline({ offset: 0, layout: PlainWords(classes), stripped: None }),
          },
        ],
      },
      cases: [b"m.T"],
    });
  let y = word(1);
  let handed = |classes: List<WordClass>| {
    let t = { ..word(0), representation: laid(classes) };
    ownership_fault(
      root_of([t], [], AsWord, [
        bind(y, Get({ of: t, path: CasePath({ case: 0, at: 0 }) }), []),
        Return(VarOperand(y)),
      ]),
    )
  };
  assert_eq(handed([Pointer, layout::any_integer()]), None);
  assert_eq(
    handed([Pointer, Pointer]),
    Some(b"a borrowed value consumed with no count of its own: v1"),
  );
  let word_sum = { ..word(2), representation: laid([Pointer]) };
  let wide = { ..word(3), representation: laid([Pointer, Pointer]) };
  assert_eq(
    [
      count_shared_with(word_sum, Convert({ arg: VarOperand(y), to: word_sum.representation })),
      count_shared_with(wide, Convert({ arg: VarOperand(y), to: wide.representation })),
    ],
    [Some(y), None],
  );
  assert_eq(allocates(wide.representation, AsWord), true)
}

test "a result borrowed is read out of counted operands the call passes borrowed, and a root's out of counted parameters it borrows" {
  let p = word(0);
  let r = word(1);
  let n = int(2);
  let borrowing = |args: List<Arg>, borrowed: List<Int>, from: List<Int>|
    match call_of(args, borrowed) {
      Call(c) ->
        Call({
          ..c,
          convention: {
            ..c.convention,
            returned: BorrowedResult(from.map(|k: Int| { param: k, whole: false })),
          },
        }),
      v -> v,
    };
  let called = |value: Rvalue| {
    let f = root_of([p, n], [0], AsWord, [bind(r, value, []), Return(VarOperand(r))]);
    ownership_fault({
      ..f,
      convention: { ..f.convention, returned: BorrowedResult([{ param: 0, whole: false }]) },
    })
  };
  assert_eq(called(borrowing([VarOperand(p), VarOperand(n)], [0, 1], [0])), None);
  assert_eq(
    ownership_fault(
      root_of([p, n], [0], AsWord, [
        bind(r, borrowing([VarOperand(p), VarOperand(n)], [0, 1], [0]), []),
        Return(VarOperand(r)),
      ]),
    ),
    Some(b"a borrowed value consumed with no count of its own: v1"),
  );
  let rejected = Some(
    b"a call's result borrowed of other than a counted operand it passes borrowed: v1",
  );
  assert_eq(called(borrowing([VarOperand(p), VarOperand(n)], [1], [0])), rejected);
  assert_eq(called(borrowing([VarOperand(p), VarOperand(n)], [0, 1], [1])), rejected);
  assert_eq(called(borrowing([VarOperand(p), VarOperand(n)], [0, 1], [2])), rejected);
  let given = root_of([p, n], [], AsWord, [Return(VarOperand(p))]);
  let returning = |from: Int|
    ownership_fault({
      ..given,
      convention: { ..given.convention, returned: BorrowedResult([{ param: from, whole: true }]) },
    });
  let unborrowed = Some(b"a root returning borrowed of other than a counted parameter it borrows");
  assert_eq(returning(0), unborrowed);
  assert_eq(returning(1), unborrowed)
}

test "a result handed back borrowed holds no count and is read out of only the borrowed parameters its root names" {
  let p = word(0);
  let q = word(1);
  let y = word(2);
  let returning = |borrowed: List<Int>, from: List<Int>, body: Block| {
    let f = root_of([p, q], borrowed, AsWord, body);
    ownership_fault({
      ..f,
      convention: {
        ..f.convention,
        returned: BorrowedResult(from.map(|k: Int| { param: k, whole: false })),
      },
    })
  };
  let read = |of: Var| bind(y, Get({ of: of, path: LeafPath(0) }), []);
  assert_eq(returning([0, 1], [0], [read(p), Return(VarOperand(y))]), None);
  assert_eq(returning([0, 1], [0, 1], [Return(VarOperand(q))]), None);
  let o = { ..word(3), representation: maybe_word() };
  let gathered = |parts: List<Arg>| {
    let f = root_of([p, q], [0, 1], maybe_word(), [
      bind(o, Aggregate({ parts: parts }), []),
      Return(VarOperand(o)),
    ]);
    ownership_fault({
      ..f,
      convention: { ..f.convention, returned: BorrowedResult([{ param: 0, whole: true }]) },
    })
  };
  assert_eq(gathered([IntOperand(1), VarOperand(p)]), None);
  assert_eq(gathered([IntOperand(0)]), None);
  assert_eq(
    gathered([IntOperand(1), VarOperand(q)]),
    Some(b"a borrowed result read out of other than the parameters its root names: v3"),
  );
  let flat = { ..word(4), representation: AsFlattened([{ name: b"s", representation: AsWord }]) };
  assert_eq(
    [
      count_shared_with(o, Convert({ arg: VarOperand(p), to: maybe_word() })),
      count_shared_with(flat, Convert({ arg: VarOperand(p), to: flat.representation })),
    ],
    [Some(p), None],
  );
  assert_eq(
    returning([0, 1], [0], [read(q), Return(VarOperand(y))]),
    Some(b"a borrowed result read out of other than the parameters its root names: v2"),
  );
  assert_eq(
    returning([0, 1], [0], [read(p), Inc({ var: y, n: 1 }), Return(VarOperand(y))]),
    Some(b"a borrowed result owning a count of its own: v2"),
  )
}

test "a join set to borrowed values on every path is borrowed of each, and read only while they are held" {
  let c = flag(0);
  let p = word(1);
  let q = word(2);
  let j = word(3);
  let r = word(4);
  let branch = If({
    cond: VarOperand(c),
    then: [Assign({ var: j, arg: VarOperand(p) })],
    otherwise: [Assign({ var: j, arg: VarOperand(q) })],
  });
  let body = |after: List<Inst>| [Declaration(j), branch].concat(after);
  assert_eq(
    ownership_fault(
      root_of([c, p, q], [1, 2], AsWord, body([Inc({ var: j, n: 1 }), Return(VarOperand(j))])),
    ),
    None,
  );
  assert_eq(
    ownership_fault(
      root_of([c, p, q], [2], AsWord, body([Inc({ var: j, n: 1 }), Return(VarOperand(j))])),
    ),
    Some(b"the paths out of a branch own different counts"),
  );
  let x = word(5);
  let z = word(6);
  let reads = If({
    cond: VarOperand(c),
    then: [bind(x, Get({ of: p, path: LeafPath(0) }), []), Assign({ var: j, arg: VarOperand(x) })],
    otherwise: [
      bind(z, Get({ of: q, path: LeafPath(0) }), []),
      Assign({ var: j, arg: VarOperand(z) }),
    ],
  });
  let given = |after: List<Inst>|
    ownership_fault(root_of([c, p, q], [], AsWord, [Declaration(j), reads].concat(after)));
  assert_eq(
    given([bind(r, call_of([VarOperand(j)], [0]), [p, q]), Dec(p), Dec(q), Return(VarOperand(r))]),
    None,
  );
  assert_eq(
    given([Dec(p), bind(r, call_of([VarOperand(j)], [0]), [q]), Dec(q), Return(VarOperand(r))]),
    Some(b"a value read after what it was read out of was let go: v3"),
  )
}

test "a boxed case is made in the cells of a reuse token of as many words, its tag's among them" {
  let b = word(0);
  let t = { ..word(1), representation: AsReuseToken(2) };
  let r = word(2);
  let made = |m: Allocation|
    ownership_fault(
      root_of([b], [], AsWord, [
        Reset({ token: t, of: b }),
        bind(r, Allocate({ made: m, args: [IntOperand(1), IntOperand(2)], reuse: Some(t) }), []),
        Return(VarOperand(r)),
      ]),
    );
  assert_eq(made(CaseAllocation({ case: 1, skip: 0, words: 2 })), None);
  assert_eq(made(CaseAllocation({ case: 1, skip: 1, words: 1 })), None);
  assert_eq(
    made(CaseAllocation({ case: 1, skip: 1, words: 2 })),
    Some(b"a value made in cells of another size: v2"),
  )
}

test "a value walked to copy is consumed for the copy it returns, and one walked to keep or share is read" {
  let p = word(0);
  let r = word(1);
  let n = int(2);
  let check_block = |op: TypeOp, result: Var, rest: List<Inst>|
    ownership_fault(
      root_of(
        [p],
        [],
        result.representation,
        [bind(result, WalkLoop({ of: p, op: op }), [])].concat(rest).push(
          Return(VarOperand(result)),
        ),
      ),
    );
  assert_eq(check_block(Copy, r, []), None);
  assert_eq(check_block(Keep, r, [Dec(p)]), None);
  assert_eq(check_block(Share, n, [Dec(p)]), None);
  assert_eq(check_block(Copy, r, [Dec(p)]), Some(b"a value consumed with no count left: v0"));
  assert_eq(check_block(Keep, r, []), Some(b"a count still owned where the body returns: v0"))
}
