import compiler.emit.keys (RootKey, Callee, Root, Generic, Named, root_name, root_text, site_owner)
import compiler.emit.roots (symbol_of, root_id)
import std.bytes (ascii_of_int)

pub type Piece = | Text(Bytes) | Hole(Relocation)

pub type Relocation =
  | Symbol(Callee)
  | SiteRoot(Option<FailureOwner>)
  | FieldName(Int)
  | LambdaEntry(Int)
  | ConstructorTag(Bytes)

pub type FailureOwner = | InGroup(Int) | LambdaOwner(RootKey) | FromCaller

pub fn placeholder(r: Relocation) -> Bytes / {abort.raise} =
  match r {
    Symbol(Root(k)) -> symbol_of(root_text(root_name(k))),
    Symbol(Generic(n)) -> placeholder_text(b"g", n),
    SiteRoot(None) -> b"@@r@@",
    SiteRoot(Some(InGroup(i))) -> placeholder_text(b"r", i),
    SiteRoot(Some(LambdaOwner(k))) -> ascii_of_int(root_id(root_text(site_owner(k)))),
    SiteRoot(Some(FromCaller)) -> b"ply_called[0]",
    FieldName(i) -> placeholder_text(b"f", i),
    LambdaEntry(i) -> placeholder_text(b"l", i),
    ConstructorTag(name) -> Bytes::concat_all([b"@@T", name, b"@@"]),
  }

fn placeholder_text(kind: Bytes, i: Int) -> Bytes =
  Bytes::concat_all([b"@@", kind, ascii_of_int(i), b"@@"])

pub fn own_symbol(member: Option<Int>) -> Bytes =
  match member { None -> b"@@s@@", Some(i) -> placeholder_text(b"s", i) }

pub fn pieces_text(pieces: List<Piece>) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    pieces.fold([], |accumulator: List<Bytes>, p: Piece|
      accumulator.push(match p { Text(t) -> t, Hole(r) -> placeholder(r) })),
  )

pub fn body_text(
  own: RootKey,
  members: List<RootKey>,
  pieces: List<Piece>,
) -> Bytes / {abort.raise} =
  pieces_text(
    pieces.map(|p: Piece|
      match p {
        Hole(Symbol(Root(k))) -> match members.index_of(k) {
          Some(i) -> Text(own_symbol(Some(i))),
          None -> if k == own { Text(own_symbol(None)) } else { p },
        },
        _ -> p,
      }),
  )

pub fn merged(pieces: List<Piece>) -> List<Piece> = {
  let s = pieces.fold(
    { out: [], run: [] },
    |s: { out: List<Piece>, run: List<Bytes> }, p: Piece|
      match p {
        Text(t) -> { ..s, run: s.run.push(t) },
        Hole(_) -> { out: flush_run(s.out, s.run).push(p), run: [] },
      },
  );
  flush_run(s.out, s.run)
}

fn flush_run(out: List<Piece>, run: List<Bytes>) -> List<Piece> =
  if run.len() == 0 { out } else { out.push(Text(Bytes::concat_all(run))) }

test "`pieces_text` writes each hole in generated C as a marker such as `@@g2@@`, and a function reference as its C symbol" {
  let pieces = [
    Text(b"PLY_SITE(ctx, "),
    Hole(SiteRoot(None)),
    Text(b", 3, 9); "),
    Hole(Symbol(Generic(2))),
    Text(b"(ctx, "),
    Hole(FieldName(0)),
    Text(b")"),
  ];
  assert_eq(pieces_text(pieces), b"PLY_SITE(ctx, @@r@@, 3, 9); @@g2@@(ctx, @@f0@@)");
  assert_eq(pieces_text([Hole(Symbol(Root(Named(b"m.f"))))]), symbol_of(b"m.f"));
  assert_eq(
    pieces_text([Hole(SiteRoot(Some(InGroup(1)))), Hole(ConstructorTag(b"m.Box"))]),
    b"@@r1@@@@Tm.Box@@",
  );
  assert_eq(
    pieces_text([Hole(SiteRoot(Some(LambdaOwner(Named(b"app.main")))))]),
    ascii_of_int(root_id(b"app.main")),
  )
}

test "a function body prints a reference to itself as a placeholder for its symbol, and a reference to any other function as that function's symbol" {
  let calls = |k: RootKey| [Text(b"r = "), Hole(Symbol(Root(k))), Text(b"(ctx);")];
  let own = Named(b"m.f");
  let other = Named(b"m.g");
  assert_eq(
    body_text(own, [], calls(own)),
    Bytes::concat_all([b"r = ", own_symbol(None), b"(ctx);"]),
  );
  assert_eq(body_text(own, [], calls(other)), pieces_text(calls(other)));
  assert(body_text(own, [], calls(own)).index_of(symbol_of(b"m.f")) == None, None);
  assert_eq(
    body_text(own, [own, other], calls(other)),
    Bytes::concat_all([b"r = ", own_symbol(Some(1)), b"(ctx);"]),
  );
  assert(own_symbol(None) != own_symbol(Some(0)), None)
}

test "adjacent text pieces merge, and placeholder pieces stay in their positions" {
  assert_eq(merged([Text(b"a"), Text(b"b"), Hole(FieldName(1)), Text(b"c"), Text(b"d")]), [
    Text(b"ab"),
    Hole(FieldName(1)),
    Text(b"cd"),
  ])
}
