//! A root's C as the printer writes it: text, and holes for what only the unit knows, each a value
//! the unit fills.

import compiler.emit.keys (RootKey, Callee, Root, Generic, Named, root_name, root_text, sited_as)
import compiler.emit.roots (symbol_of, root_id)
import std.bytes (ascii_of_int)

pub type Piece = | Text(Bytes) | Hole(Reloc)

/// What the unit writes into a hole. `Symbol` is a root's, a generic call's once settled;
/// `SiteRoot` the id a failure site names its root by, this root's where `None`; the rest are
/// positions in the unit's tables of field names and lambda entries, and the tag of a constructor
/// by its name.
pub type Reloc =
  | Symbol(Callee)
  | SiteRoot(Option<SiteOf>)
  | FieldName(Int)
  | LambdaEntry(Int)
  | TagOf(Bytes)

/// The root a failure site names where it is not the body's own: member `i` of the body's tail
/// group, the root that lent the lambda a frame runs in place, or the site the body's caller set as
/// it called, which the body keeps in `ply_called`.
pub type SiteOf = | InGroup(Int) | LentBy(RootKey) | Called

/// The placeholder today's unit reads for `r` (`@@g3@@`, `@@r@@`, `@@f0@@`), and a root's symbol
/// and a lender's site id as themselves: what an answer's text holds until the unit fills holes by
/// value.
pub fn placeholder(r: Reloc) -> Bytes / {abort.raise} =
  match r {
    Symbol(Root(k)) -> symbol_of(root_text(root_name(k))),
    Symbol(Generic(n)) -> held(b"g", n),
    SiteRoot(None) -> b"@@r@@",
    SiteRoot(Some(InGroup(i))) -> held(b"r", i),
    SiteRoot(Some(LentBy(k))) -> ascii_of_int(root_id(root_text(sited_as(k)))),
    SiteRoot(Some(Called)) -> b"ply_called[0]",
    FieldName(i) -> held(b"f", i),
    LambdaEntry(i) -> held(b"l", i),
    TagOf(name) -> Bytes::concat_all([b"@@T", name, b"@@"]),
  }

fn held(kind: Bytes, i: Int) -> Bytes = Bytes::concat_all([b"@@", kind, ascii_of_int(i), b"@@"])

/// The symbol of a root a body defines, as its C writes it for the unit to fill when it writes the
/// body's part: the body's own root's where `member` is none, else that member's of its tail group.
/// So a body's C does not depend on its root's name.
pub fn own_symbol(member: Option<Int>) -> Bytes =
  match member { None -> b"@@s@@", Some(i) -> held(b"s", i) }

/// The text an answer carries today: every hole as its placeholder.
pub fn spelled(pieces: List<Piece>) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    pieces.fold([], |acc: List<Bytes>, p: Piece|
      acc.push(match p { Text(t) -> t, Hole(r) -> placeholder(r) })),
  )

/// The text of the body of root `own`, or of the tail group of `members`, whose first is `own`:
/// `spelled`'s, but a call of a root the body defines as `own_symbol` writes that root.
pub fn body_spelled(
  own: RootKey,
  members: List<RootKey>,
  pieces: List<Piece>,
) -> Bytes / {abort.raise} =
  spelled(
    pieces.map(|p: Piece|
      match p {
        Hole(Symbol(Root(k))) -> match members.index_of(k) {
          Some(i) -> Text(own_symbol(Some(i))),
          None -> if k == own { Text(own_symbol(None)) } else { p },
        },
        _ -> p,
      }),
  )

/// Adjacent texts as one, so a printer may write as many as it likes.
pub fn merged(pieces: List<Piece>) -> List<Piece> = {
  let s = pieces.fold(
    { out: [], run: [] },
    |s: { out: List<Piece>, run: List<Bytes> }, p: Piece|
      match p {
        Text(t) -> { ..s, run: s.run.push(t) },
        Hole(_) -> { out: ran(s.out, s.run).push(p), run: [] },
      },
  );
  ran(s.out, s.run)
}

/// `out` and then the texts of `run` as one, where there are any.
fn ran(out: List<Piece>, run: List<Bytes>) -> List<Piece> =
  if run.len() == 0 { out } else { out.push(Text(Bytes::concat_all(run))) }

test "a hole is written as the unit's placeholder for it, and a root as its symbol" {
  let pieces = [
    Text(b"PLY_SITE(ctx, "),
    Hole(SiteRoot(None)),
    Text(b", 3, 9); "),
    Hole(Symbol(Generic(2))),
    Text(b"(ctx, "),
    Hole(FieldName(0)),
    Text(b")"),
  ];
  assert_eq(spelled(pieces), b"PLY_SITE(ctx, @@r@@, 3, 9); @@g2@@(ctx, @@f0@@)");
  assert_eq(spelled([Hole(Symbol(Root(Named(b"m.f"))))]), symbol_of(b"m.f"));
  assert_eq(
    spelled([Hole(SiteRoot(Some(InGroup(1)))), Hole(TagOf(b"m.Box"))]),
    b"@@r1@@@@Tm.Box@@",
  );
  // A lender's sites name it by the id today's emitter writes outright.
  assert_eq(
    spelled([Hole(SiteRoot(Some(LentBy(Named(b"app.main")))))]),
    ascii_of_int(root_id(b"app.main")),
  )
}

test "a body writes each root it defines as the placeholder of its symbol, and any other root as its symbol" {
  let calls = |k: RootKey| [Text(b"r = "), Hole(Symbol(Root(k))), Text(b"(ctx);")];
  let own = Named(b"m.f");
  let other = Named(b"m.g");
  assert_eq(
    body_spelled(own, [], calls(own)),
    Bytes::concat_all([b"r = ", own_symbol(None), b"(ctx);"]),
  );
  assert_eq(body_spelled(own, [], calls(other)), spelled(calls(other)));
  assert(body_spelled(own, [], calls(own)).index_of(symbol_of(b"m.f")) == None, None);
  // A tail group's members are each written as their own placeholder, the first among them.
  assert_eq(
    body_spelled(own, [own, other], calls(other)),
    Bytes::concat_all([b"r = ", own_symbol(Some(1)), b"(ctx);"]),
  );
  assert(own_symbol(None) != own_symbol(Some(0)), None)
}

test "adjacent texts merge and holes stay where they were" {
  assert_eq(merged([Text(b"a"), Text(b"b"), Hole(FieldName(1)), Text(b"c"), Text(b"d")]), [
    Text(b"ab"),
    Hole(FieldName(1)),
    Text(b"cd"),
  ])
}
