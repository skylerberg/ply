//! Specialisation: definitions written at type arguments, and the needs that ask for them.

import compiler.syntax.parsing (Ident)
import compiler.emit.code (Code, lower_fn)
import compiler.syntax.items (FnDef)
import compiler.check.resolve.tables (qualify)
import compiler.check.resolve.scopes (of_binder)
import compiler.check.infer.checker (WitnessOp)
import compiler.check.types (Type, TyVar, TyCon, TyFn, TyNominal, Scheme)
import std.list
import compiler.syntax.exprs (Param, Expr)
import compiler.syntax.type_syntax (TypeExpr, TVar, TCon, TFn)
import compiler.expand.rewrite.shared (map_expr)
import compiler.expand.rewrite (unwitnessed, witness_param, is_witness_param)
import compiler.emit.c (KInt, Kind)
import compiler.emit.keys (RootKey, Named, At, FnArg, RootName, root_name, filed_as, key_types,
                           key_lent)
import compiler.emit.answer (Need, Scalar, Exact)
import compiler.emit.reps (Ctors, Ty, TyOpen, Def, EmitParam, BoundLambda, Sig, sig_of, param_kinds,
                           param_types, substituted, numeric_named, numeric_sum, filings_at,
                           has_vars)
import compiler.emit.typing (Filings, unknown_type)
import compiler.emit.lower.setting (Setting, Root, params_carried, releasing_of)
import compiler.emit.lower (group_lowered, tail_calls, TailCall)
import compiler.emit.lower.calling (holds_handle, instance_key)
import compiler.emit.lower.handling (detaches)
import compiler.emit.tir (Fn)
import compiler.emit.entry (formed_from, root_at)

// --- Specialisation ----------------------------------------------------------------------------

/// The scheme's number of each type parameter `def` writes by name, read off where its parameters'
/// and answer's written types and its scheme's agree.
fn generics_numbered(def: FnDef, scheme: Scheme) -> Map<Bytes, Int> =
  match scheme.ty {
    TyFn(f) -> {
      // The witnesses the elaboration added lead the parameters, and the scheme holds none of them.
      let written = def.params.filter(|p: Param| !is_witness_param(p.name.name)).map(|p: Param|
        p.ty);
      let paired = range(0, written.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int|
        match written.at(i) {
          Some(Some(w)) -> match f.params.at(i) { Some(t) -> numbered_by(w, t, acc), None -> acc },
          _ -> acc,
        });
      match def.ret { Some(w) -> numbered_by(w, f.ret, paired), None -> paired }
    },
    _ -> Map::new(),
  }

fn numbered_by(written: TypeExpr, ty: Type, acc: Map<Bytes, Int>) -> Map<Bytes, Int> =
  match written {
    TVar(id) -> match ty { TyVar(v) -> acc.insert(id.name, v), _ -> acc },
    TCon(c) -> match ty {
      TyCon(k) -> pairwise(c.args, k.args, acc),
      TyNominal(x) -> pairwise(c.args, x.args, acc),
      _ -> acc,
    },
    TFn(w) -> match ty {
      TyFn(f) -> numbered_by(w.ret, f.ret, pairwise(w.params, f.params, acc)),
      _ -> acc,
    },
    _ -> acc,
  }

fn pairwise(written: List<TypeExpr>, tys: List<Type>, acc: Map<Bytes, Int>) -> Map<Bytes, Int> =
  if written.len() != tys.len() { acc } else {
    range(0, written.len()).fold(acc, |m: Map<Bytes, Int>, i: Int|
      match written.at(i) {
        Some(w) -> match tys.at(i) { Some(t) -> numbered_by(w, t, m), None -> m },
        None -> m,
      })
  }

/// The specialisations `wanted` holds, by the definition each specialises.
pub fn specialisations_wanted(wanted: List<RootKey>) -> Map<Bytes, List<RootKey>> =
  wanted.fold(Map::new(), |acc: Map<Bytes, List<RootKey>>, k: RootKey|
    match k {
      At(a, _) -> acc.insert(a.def, (match acc.get(a.def) { Some(l) -> l, None -> [] }).push(k)),
      _ -> acc,
    })

/// `f`, the form of generic `def`, noting among its needs the variables whose numeric witness it
/// reads: a scalar argument does that arithmetic in C.
pub fn witnessed_needs(f: Fn, def: FnDef, scheme: Option<Scheme>, ops: List<WitnessOp>) -> Fn =
  match scheme {
    None -> f,
    Some(sc) -> {
      let numbering = generics_numbered(def, sc);
      let needs = ops.fold(f.links.needs, |acc: List<Need>, o: WitnessOp|
        if root_name(Named(o.owner)) != root_name(f.key) { acc } else {
          match numbering.get(o.param) {
            Some(v) -> if acc.contains({ var: v, reads: Scalar }) { acc }
            else { acc.push({ var: v, reads: Scalar }) },
            None -> acc,
          }
        });
      { ..f, links: { ..f.links, needs: needs } }
    },
  }

/// `e`, written in generic `def`, as a specialisation of it at `args` holds it: each operator whose
/// witness is a parameter held as one numeric type alone, or at a sum of `ctors` whose module
/// states its arithmetic, done as that type's own.
pub fn written_at(
  ctors: Ctors,
  full: Bytes,
  def: FnDef,
  args: List<Type>,
  schemes: Map<Bytes, Scheme>,
  e: Expr,
) -> Expr = {
  let numbering = match schemes.get(full) {
    Some(sc) -> generics_numbered(def, sc),
    None -> Map::new(),
  };
  let concrete = numbering.fold(Map::new(), |acc: Map<Bytes, Bool>, param: Bytes, i: Int|
    match args.at(i) {
      Some(t) -> if numeric_named(t) == None && !numeric_sum(ctors, t) { acc }
      else { acc.insert(witness_param(param), true) },
      None -> acc,
    });
  map_expr(e, |x: Expr| unwitnessed(x, |w: Bytes| concrete.contains(w)))
}

/// What a root of `def`, named `full`, at `args` reads its definition as: the body `written_at`
/// them, and the signature at `args`.
pub fn definition_at(
  ctors: Ctors,
  full: Bytes,
  def: FnDef,
  args: List<Type>,
  schemes: Map<Bytes, Scheme>,
  ops: List<WitnessOp>,
) -> { body: Expr, sig: Option<Sig> } = {
  {
    body: written_at(ctors, full, def, args, schemes, def.body),
    sig: match sig_of(schemes, full) {
      Some(s) ->
        Some({
          params: s.params.map(|t: Type| substituted(t, args)),
          ret: substituted(s.ret, args),
        }),
      None -> None,
    },
  }
}

/// The parameters of `def` at signature `sig` as a root of it holds them, each label a trailing
/// `Int`, with the names of the written ones and of its labels.
fn params_at(
  def: FnDef,
  sig: Option<Sig>,
) -> { binders: List<Ident>, names: List<Bytes>, labels: List<Bytes>, ps: List<EmitParam> } = {
  let names = def.params.map(|param: Param| param.name.name);
  let kinds = param_kinds(def, sig).map(|k: { kind: Kind, ty: Ty }| Some(k));
  let labels = def.generics.labels.map(|ident: Ident| ident.name);
  let all_names = labels.fold(names, |acc: List<Bytes>, n: Bytes| acc.push(n));
  let all_kinds = labels.fold(kinds, |acc: List<Option<{ kind: Kind, ty: Ty }>>, n: Bytes|
    acc.push(Some({ kind: KInt, ty: TyOpen([]) })));
  {
    binders: def.params.map(|param: Param| param.name),
    names: names,
    labels: labels,
    ps: params_carried(all_names, all_kinds, param_types(def, sig)),
  }
}

/// `def` of the module `s` reads formed as root `root`, at its type arguments and running the
/// lambdas it lends in place: its parameters and what the checker filed of its nodes, `filed`, read
/// at them, and each operator whose witness is a parameter now held as one numeric type alone done
/// as that type's own.
pub fn specialised_formed(
  s: Setting,
  def: FnDef,
  root: RootKey,
  lambda_at: (RootKey, Int) -> Option<BoundLambda> / {abort.raise},
  schemes: Map<Bytes, Scheme>,
  ops: List<WitnessOp>,
  filed: Filings,
) -> Fn / {abort.raise} = {
  let full = qualify(s.module, def.name.name);
  let args = key_types(root);
  let source = definition_at(s.ctors, full, def, args, schemes, ops);
  let held = params_at(def, source.sig);
  // Each lambda the root runs, read where its owner lowered it: a root is keyed by only the lambdas
  // its callers' owners lend.
  let ps = key_lent(root).fold(held.ps, |ps: List<EmitParam>, f: FnArg|
    match lambda_at(f.owner, f.nth) {
      None -> panic("a lambda this root runs in place of a call is not one its owner lowers"),
      Some(bl) ->
        range(0, ps.len()).map(|i: Int|
          if i == f.param { { ..ps.get(i), lambda: Some(bl) } } else { ps.get(i) }),
    });
  formed_from(
    s,
    def.span.start,
    root,
    ps,
    lower_fn(
      held.binders,
      held.labels,
      filed.labels,
      source.body,
      of_binder(s.module),
      releasing_of(filed, def.params),
    ).code,
    filings_at(filed, args),
  )
}

// --- Tail loops at type arguments --------------------------------------------------------------

/// A definition of the module as a walk of tail calls reads it: the code its body lowers to as
/// written out, and what the checker filed of its nodes.
pub type AsWritten = { code: Code, filed: Filings }

/// What a walk found of one root: the roots its tail calls reach, and each definition one names at
/// a type grown from a variable of the root's own.
type Reached = { key: RootKey, out: List<RootKey>, grown: List<Bytes> }

/// The type arguments a call the checker filed at `filed` names its callee at, read where its caller
/// is at `args`: each a type of no variable as it is, and each variable of the caller's at the
/// caller's argument, open where that is; none where one is grown from a variable.
fn instance_args(filed: List<Type>, args: List<Type>) -> Option<List<Type>> =
  filed.fold(Some([]), |acc: Option<List<Type>>, t: Type|
    match acc {
      None -> None,
      Some(at) -> if !has_vars(t) { Some(at.push(t)) } else {
        match t {
          TyVar(j) -> Some(at.push(match args.at(j) { Some(a) -> a, None -> unknown_type() })),
          _ -> None,
        }
      },
    })

/// The roots `w`'s tail calls of definitions of the module reach, read where its root is at `args`.
fn tail_reached(s: Setting, w: AsWritten, args: List<Type>) -> Reached / {abort.raise} =
  tail_calls(s.here, w.code, []).fold(
    { key: Named(b""), out: [], grown: [] },
    |acc: Reached, t: TailCall| {
      let callee = qualify(s.module, t.name);
      let filed = match w.filed.typed.get(t.at.site) { Some(x) -> x.args, None -> [] };
      match instance_args(filed, args) {
        None -> if acc.grown.contains(callee) { acc }
        else { { ..acc, grown: acc.grown.push(callee) } },
        Some(at) -> {
          let k = instance_key(callee, at);
          if acc.out.contains(k) { acc } else { { ..acc, out: acc.out.push(k) } }
        },
      }
    },
  )

/// The definitions of `module`, beside `here`, that definition `from` reaches through calls in tail
/// position, `from` among them, each body as `read_of` reads it.
pub fn tail_reached_defs(
  module: Bytes,
  here: List<Def>,
  read_of: (Bytes) -> Option<AsWritten> / {abort.raise},
  from: Bytes,
) -> Map<Bytes, Bool> / {abort.raise} =
  iterate(
    { seen: Map::new(), work: [from] },
    1000000,
    |r: { seen: Map<Bytes, Bool>, work: List<Bytes> }|
      match r.work {
        [] -> Stop(r),
        [n, ..rest] -> if r.seen.contains(n) { Continue({ ..r, work: rest }) } else {
          let next = match read_of(n) {
            Some(w) -> tail_calls(here, w.code, []).map(|t: TailCall| qualify(module, t.name)),
            None -> [],
          };
          Continue({ seen: r.seen.insert(n, true), work: rest.concat(next) })
        },
      },
  ).seen

/// The other definitions of `module`, beside `here`, that run in one tail loop with `owner`, each
/// body as `read_of` reads it: each `owner`'s tail calls reach that reaches it again.
pub fn tail_mates(
  module: Bytes,
  here: List<Def>,
  read_of: (Bytes) -> Option<AsWritten> / {abort.raise},
  owner: Bytes,
) -> List<Bytes> / {abort.raise} =
  tail_reached_defs(module, here, read_of, owner).keys().filter(|d: Bytes|
    d != owner && tail_reached_defs(module, here, read_of, d).contains(owner))

/// The roots that run as one loop with `key`: each root the tail calls reach, each call naming its
/// callee at the type arguments the checker filed for it read at its caller's, that reaches `key`
/// again. They are in the order their definitions stand in the module (`order`), then of their
/// names, so a loop is formed alike, under one first member, whichever of its roots is asked for.
/// `key` alone where no other root loops with it or a member holds a `handle` that resumes off its
/// tail. Panics where a call names a definition that reaches its caller again at a type grown from
/// a variable of the caller's, which the check refuses (E0308) and no loop can run.
pub fn instance_group(
  s: Setting,
  order: Map<Bytes, Int>,
  read_of: (Bytes) -> Option<AsWritten> / {abort.raise},
  key: RootKey,
) -> List<RootKey> / {abort.raise} = {
  let reached = iterate(
    { pairs: Map::new(), work: [key] },
    1000000,
    |r: { pairs: Map<RootName, Reached>, work: List<RootKey> }|
      match r.work {
        [] -> Stop(r),
        [k, ..rest] -> if r.pairs.contains(root_name(k)) { Continue({ ..r, work: rest }) } else {
          let t = match read_of(filed_as(k)) {
            Some(w) -> tail_reached(s, w, key_types(k)),
            None -> { key: k, out: [], grown: [] },
          };
          Continue({
            pairs: r.pairs.insert(root_name(k), { ..t, key: k }),
            work: rest.concat(t.out),
          })
        },
      },
  ).pairs;
  reached.fold((), |_: Unit, _: RootName, p: Reached| {
    let caller = filed_as(p.key);
    match p.grown.find(|callee: Bytes|
        tail_reached_defs(s.module, s.here, read_of, callee).contains(caller)) {
      None -> (),
      Some(callee) ->
        panic(
          String::of_bytes_lossy(
            Bytes::concat_all([
              b"`",
              caller,
              b"` calls `",
              callee,
              b"` in tail position at a type grown from a type parameter of its own, which reaches it again",
            ]),
          ),
        ),
    }
  });
  let back = iterate(
    Map::new().insert(root_name(key), true),
    reached.len() + 1,
    |seen: Map<RootName, Bool>| {
      let more = reached.fold(seen, |acc: Map<RootName, Bool>, n: RootName, p: Reached|
        if acc.contains(n) || !p.out.any(|k: RootKey| acc.contains(root_name(k))) { acc }
        else { acc.insert(n, true) });
      if more.len() == seen.len() { Stop(seen) } else { Continue(more) }
    },
  );
  let members = reached.fold([], |acc: List<RootKey>, n: RootName, p: Reached|
    if back.contains(n) { acc.push(p.key) } else { acc });
  // A `handle` whose clause resumes off its tail runs its body on a stack of its own.
  let detached = members.any(|k: RootKey|
    match read_of(filed_as(k)) { Some(w) -> holds_handle(w.code, detaches), None -> true });
  // A member generic over rows is settled at the rows its callers hand it, which a loop's
  // members, keyed by type arguments alone, do not say.
  let rowed = members.any(|k: RootKey|
    s.here.any(|d: Def|
      qualify(s.module, d.name) == filed_as(k)
        && (match d.scheme { Some(sc) -> sc.row_vars.len() > 0, None -> false })));
  if members.len() < 2 || detached || rowed { [key] } else { in_order(order, members) }
}

/// `keys` in the order their definitions stand in the module, then of their names.
fn in_order(order: Map<Bytes, Int>, keys: List<RootKey>) -> List<RootKey> / {abort.raise} = {
  let place = |k: RootKey| match order.get(filed_as(k)) { Some(i) -> i, None -> 0 };
  let before = |a: RootKey, b: RootKey|
    place(a) < place(b) || (place(a) == place(b) && compare(root_name(a), root_name(b)) == Less);
  keys.fold([], |sorted: List<RootKey>, k: RootKey|
    sorted.filter(|x: RootKey| before(x, k)).push(k).concat(
      sorted.filter(|x: RootKey| !before(x, k)),
    ))
}

/// Root `key` of a definition of the module as a member of a tail loop: the root the typed form
/// lowers at its type arguments, its body's code read there.
fn instance_root(
  s: Setting,
  schemes: Map<Bytes, Scheme>,
  ops: List<WitnessOp>,
  defs: Map<Bytes, FnDef>,
  read_of: (Bytes) -> Option<AsWritten> / {abort.raise},
  key: RootKey,
) -> Root / {abort.raise} = {
  let full = filed_as(key);
  // A loop's members are what `instance_group` found by reading their definitions.
  let def = match defs.get(full) {
    Some(d) -> d,
    None -> panic("a tail loop's member no definition is"),
  };
  let w = match read_of(full) { Some(w) -> w, None -> panic("a tail loop's member no walk read") };
  let args = key_types(key);
  let source = definition_at(s.ctors, full, def, args, schemes, ops);
  let held = params_at(def, source.sig);
  let code = if args.len() == 0 { w.code } else {
    lower_fn(
      held.binders,
      held.labels,
      w.filed.labels,
      source.body,
      of_binder(s.module),
      releasing_of(w.filed, def.params),
    ).code
  };
  root_at(s, key, def.span.start, held.ps, code, filings_at(w.filed, args))
}

/// The tail loop of `keys`, `instance_group`'s members in order, formed as one root under the first's
/// name, each member at its type arguments, its definition among `defs`. A loop whose members leave
/// a type variable open is settled by its callers at every one: its members number their variables
/// apart, so its needs cannot say which of one member's its code reads.
pub fn instances_formed(
  s: Setting,
  schemes: Map<Bytes, Scheme>,
  ops: List<WitnessOp>,
  defs: Map<Bytes, FnDef>,
  read_of: (Bytes) -> Option<AsWritten> / {abort.raise},
  keys: List<RootKey>,
) -> List<Fn> / {abort.raise} = {
  let f = group_lowered(s, keys.map(|k: RootKey| instance_root(s, schemes, ops, defs, read_of, k)));
  let open = keys.fold(0, |most: Int, k: RootKey| {
    let w = open_width(schemes, k);
    if w > most { w } else { most }
  });
  [
    {
      ..f,
      links: {
        ..f.links,
        needs: range(0, open).fold(f.links.needs, |ns: List<Need>, j: Int|
          if ns.contains({ var: j, reads: Exact }) { ns }
          else { ns.push({ var: j, reads: Exact }) }),
      },
    },
  ]
}

/// How many type variables root `key` leaves open: each of a definition as it stands, none of a
/// specialisation, which its callers settle whole.
fn open_width(schemes: Map<Bytes, Scheme>, key: RootKey) -> Int =
  match key {
    Named(full) -> match schemes.get(full) { Some(sc) -> sc.ty_vars.len(), None -> 0 },
    _ -> 0,
  }
