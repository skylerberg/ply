//! Specialisation: definitions written at type arguments, and the needs that ask for them.

import syntax.parsing (Ident, dummy_span)
import emit.code (lower_fn)
import syntax.items (FnDef)
import check.resolve.tables (qualify)
import check.resolve.scopes (of_binder)
import check.infer.checker (WitnessOp)
import check.types (Type, TyVar, TyCon, TyFn, TyNominal, Scheme, row_empty, int_type)
import std.list
import syntax.exprs (Param, Expr)
import syntax.type_syntax (TypeExpr, TVar, TCon, TFn)
import expand.rewrite.shared (map_expr)
import expand.rewrite (unwitnessed, witness_param)
import emit.c (KInt, Kind)
import emit.keys (RootKey, At, Named, FnArg, root_name, key_types, key_lent)
import emit.answer (Need, Reads, Scalar, Layout, Exact)
import emit.tir (Fn, Block, Inst, Let, Do, If, Case, Match, Loop, Handle, Inc, Dec, Reset, Opened,
                 Return, Lambda, Closure, Var, Val, LastOf, RFlat, RToken, RWord, RInt, AInt,
                 Rooted, Owned, counted, no_links)
import emit.release (released_vars)
import emit.reps (Ty, TyOpen, EmitParam, BoundLambda, Sig, sig_of, param_kinds, param_types,
                  substituted, numeric_named, filings_at)
import emit.typing (Filings)
import emit.lower.setting (Setting, params_carried, labels_of)
import emit.entry (RootForm, Formed, Unformed, formed_from)

// --- Specialisation ----------------------------------------------------------------------------

/// The scheme's number of each type parameter `def` writes by name, read off where its parameters'
/// and answer's written types and its scheme's agree.
fn generics_numbered(def: FnDef, scheme: Scheme) -> Map<Bytes, Int> =
  match scheme.ty {
    TyFn(f) -> {
      let written = def.params.map(|p: Param| p.ty);
      let paired = range(0, written.len()).fold(Map::new(), |acc: Map<Bytes, Int>, i: Int|
        match written.at(i) {
          Some(Some(w)) -> match f.params.at(i) { Some(t) -> numbered_by(w, t, acc), None -> acc },
          _ -> acc,
        });
      match def.ret { Some(w) -> numbered_by(w, f.ret, paired), None -> paired }
    },
    _ -> Map::new(),
  }

fn numbered_by(written: TypeExpr, ty: Type, acc: Map<Bytes, Int>) -> Map<Bytes, Int> =
  match written {
    TVar(id) -> match ty { TyVar(v) -> acc.insert(id.name, v), _ -> acc },
    TCon(c) -> match ty {
      TyCon(k) -> pairwise(c.args, k.args, acc),
      TyNominal(x) -> pairwise(c.args, x.args, acc),
      _ -> acc,
    },
    TFn(w) -> match ty {
      TyFn(f) -> numbered_by(w.ret, f.ret, pairwise(w.params, f.params, acc)),
      _ -> acc,
    },
    _ -> acc,
  }

fn pairwise(written: List<TypeExpr>, tys: List<Type>, acc: Map<Bytes, Int>) -> Map<Bytes, Int> =
  if written.len() != tys.len() { acc } else {
    range(0, written.len()).fold(acc, |m: Map<Bytes, Int>, i: Int|
      match written.at(i) {
        Some(w) -> match tys.at(i) { Some(t) -> numbered_by(w, t, m), None -> m },
        None -> m,
      })
  }

/// The specialisations `wanted` holds, by the definition each specialises.
pub fn specialisations_wanted(wanted: List<RootKey>) -> Map<Bytes, List<RootKey>> =
  wanted.fold(Map::new(), |acc: Map<Bytes, List<RootKey>>, k: RootKey|
    match k {
      At(a) -> acc.insert(a.def, (match acc.get(a.def) { Some(l) -> l, None -> [] }).push(k)),
      _ -> acc,
    })

/// `r`, the form of generic `def`, noting among its needs the variables whose numeric witness it
/// reads: a scalar argument does that arithmetic in C.
pub fn witnessed_needs(
  r: RootForm,
  def: FnDef,
  scheme: Option<Scheme>,
  ops: List<WitnessOp>,
) -> RootForm =
  match scheme {
    None -> r,
    Some(sc) -> match r {
      Formed(x) -> match x.form {
        Ok(f) -> {
          let numbering = generics_numbered(def, sc);
          let needs = ops.fold(f.links.needs, |acc: List<Need>, o: WitnessOp|
            if o.owner != x.name { acc } else {
              match numbering.get(o.param) {
                Some(v) -> if acc.contains({ var: v, reads: Scalar }) { acc }
                else { acc.push({ var: v, reads: Scalar }) },
                None -> acc,
              }
            });
          Formed({ ..x, form: Ok({ ..f, links: { ..f.links, needs: needs } }) })
        },
        Err(_) -> r,
      },
      Unformed(_) -> r,
    },
  }

/// `f`, its counts placed, noting among its needs `release_reads(f)`, so a specialisation settles
/// every release on a type.
pub fn release_needs(f: Fn) -> Fn = { ..f, links: { ..f.links, needs: fn_needs(f.links.needs, f) } }

/// What `f`'s counts read of its type variables: each a count it lets go of reads exactly, since a
/// value is let go of per type, and each a count it takes its layout alone. What its failure paths
/// let go of and what its closures' bodies do count as its own. A body reading any is printed only
/// at type arguments its callers settle.
pub fn release_reads(f: Fn) -> List<Need> = fn_needs([], f)

fn fn_needs(needs: List<Need>, f: Fn) -> List<Need> =
  f.lambdas.fold(block_needs(needs, f.body), |acc: List<Need>, l: Lambda|
    match l { Closure(c) -> fn_needs(acc, c.body) })

fn block_needs(needs: List<Need>, b: Block) -> List<Need> =
  b.fold(needs, |acc: List<Need>, i: Inst|
    match i {
      Let(l) -> unwound(value_needs(acc, l.val), l.unwind),
      Do(d) -> unwound(value_needs(acc, d.val), d.unwind),
      If(x) -> block_needs(block_needs(acc, x.then), x.otherwise),
      Case(c) ->
        c.arms.fold(block_needs(acc, c.rest), |a: List<Need>, arm: { when: Int, body: Block }|
          block_needs(a, arm.body)),
      Match(m) -> m.arms.fold(block_needs(acc, m.rest), block_needs),
      Loop(l) -> block_needs(acc, l.body),
      Handle(h) -> unwound(block_needs(acc, h.body), h.unwind),
      Inc(n) -> reading(acc, n.var.ty, Layout),
      Dec(v) -> reading(acc, v.ty, Exact),
      Reset(r) -> reading(acc, r.of.ty, Exact),
      Opened(o) -> match o.of.rep { RFlat(_) -> acc, _ -> reading(acc, o.of.ty, Exact) },
      _ -> acc,
    })

fn value_needs(needs: List<Need>, val: Val) -> List<Need> =
  match val { LastOf(v) -> reading(needs, v.ty, Exact), _ -> needs }

/// `needs` with what letting go of each counted value of `unwind` reads; a reuse token, freed by its
/// size, reads nothing.
fn unwound(needs: List<Need>, unwind: List<Var>) -> List<Need> =
  unwind.fold(needs, |acc: List<Need>, v: Var|
    match v.rep { RToken(_) -> acc, r -> if counted(r) { reading(acc, v.ty, Exact) } else { acc } })

/// `needs` with each variable a count of `ty` reads read as `reads`.
fn reading(needs: List<Need>, ty: Type, reads: Reads) -> List<Need> =
  released_vars(ty).fold(needs, |acc: List<Need>, v: Int|
    if acc.contains({ var: v, reads: reads }) { acc } else { acc.push({ var: v, reads: reads }) })

/// What a root of `def`, named `full`, at `args` reads its definition as: the body with each
/// operator whose witness is a parameter held as one numeric type alone done as that type's own,
/// and the signature at `args`.
pub fn definition_at(
  full: Bytes,
  def: FnDef,
  args: List<Type>,
  schemes: Map<Bytes, Scheme>,
  ops: List<WitnessOp>,
) -> { body: Expr, sig: Option<Sig> } = {
  let scheme = schemes.get(full);
  let numbering = match scheme { Some(sc) -> generics_numbered(def, sc), None -> Map::new() };
  // The type a witnessed parameter is at, where its argument is held as one numeric type alone.
  let numeric = |param: Bytes|
    match numbering.get(param) {
      Some(i) -> match args.at(i) { Some(t) -> numeric_named(t), None -> None },
      None -> None,
    };
  let concrete = numbering.fold(Map::new(), |acc: Map<Bytes, Bool>, param: Bytes, _: Int|
    if numeric(param) == None { acc } else { acc.insert(witness_param(param), true) });
  {
    body: map_expr(def.body, |e: Expr| unwitnessed(e, |w: Bytes| concrete.contains(w))),
    sig: match sig_of(schemes, full) {
      Some(s) ->
        Some({
          params: s.params.map(|t: Type| substituted(t, args)),
          ret: substituted(s.ret, args),
        }),
      None -> None,
    },
  }
}

/// `def` of the module `s` reads formed as root `root`, at its type arguments and running the
/// lambdas it lends in place: its parameters and what the checker filed of its nodes, `filed`, read
/// at them, and each operator whose witness is a parameter now held as one numeric type alone done
/// as that type's own.
pub fn specialised_formed(
  s: Setting,
  def: FnDef,
  root: RootKey,
  lambda_at: (RootKey, Int) -> Option<BoundLambda> / {abort.raise},
  schemes: Map<Bytes, Scheme>,
  ops: List<WitnessOp>,
  filed: Result<Filings, Bytes>,
) -> RootForm / {abort.raise} = {
  let full = qualify(s.module, def.name.name);
  let args = key_types(root);
  let fns = key_lent(root);
  let source = definition_at(full, def, args, schemes, ops);
  let body = source.body;
  let sig = source.sig;
  let names = def.params.map(|param: Param| param.name.name);
  let kinds = param_kinds(def, sig).map(|k: { kind: Kind, ty: Ty }| Some(k));
  let labels = def.generics.labels.map(|ident: Ident| ident.name);
  let all_names = labels.fold(names, |acc: List<Bytes>, n: Bytes| acc.push(n));
  let all_kinds = labels.fold(kinds, |acc: List<Option<{ kind: Kind, ty: Ty }>>, n: Bytes|
    acc.push(Some({ kind: KInt, ty: TyOpen([]) })));
  let carried = params_carried(all_names, all_kinds, param_types(def, sig));
  // Each lambda the root runs, read where its owner lowered it.
  let lent = fns.fold(Some(carried), |acc: Option<List<EmitParam>>, f: FnArg|
    match acc {
      None -> None,
      Some(ps) -> match lambda_at(f.owner, f.nth) {
        None -> None,
        Some(bl) ->
          Some(
            range(0, ps.len()).map(|i: Int|
              if i == f.param { { ..ps.get(i), lambda: Some(bl) } } else { ps.get(i) }),
          ),
      },
    });
  match lent {
    None ->
      Unformed({
        name: root_name(root),
        why: b"a lambda this root runs in place of a call is not one its owner lowers",
      }),
    Some(ps) ->
      formed_from(
        s,
        def.span.start,
        root,
        ps,
        true,
        match lower_fn(names, labels, labels_of(filed), body, of_binder(s.module)) {
          Ok(l) -> Ok(l.code),
          Err(why) -> Err(why),
        },
        match filed { Ok(f) -> Ok(filings_at(f, args)), Err(why) -> Err(why) },
      ),
  }
}

test "a body reads exactly each variable it lets go of a value of, and the layout of each it counts" {
  let at = |name: Bytes, args: List<Type>| TyCon({ name: name, args: args });
  let local = |id: Int, ty: Type| { id: id, ty: ty, rep: RWord };
  let list = local(0, at(b"List", [TyVar(0)]));
  let counted_once = local(1, TyVar(1));
  let function = local(2, TyFn({ params: [TyVar(5)], ret: TyVar(6), effects: row_empty() }));
  let task = local(3, at(b"Task", [TyVar(7)]));
  let held = local(4, at(b"Hold", [TyVar(2)]));
  let failing = local(5, TyVar(3));
  let token = { id: 6, ty: TyVar(8), rep: RToken(2) };
  let last = local(7, at(b"Hold", [TyVar(2)]));
  let f = {
    key: Named(b"m.f"),
    kind: Rooted,
    params: [],
    conv: { params: [], reps: [], answer: RInt, answered: Owned },
    answer_ty: int_type(),
    body: [
      Dec(list),
      Inc({ var: counted_once, n: 1 }),
      Dec(function),
      Dec(task),
      Let({ var: last, val: LastOf(held), at: dummy_span(), unwind: [failing, token] }),
      Dec(list),
      Return(AInt(0)),
    ],
    lambdas: [],
    base: 0,
    members: [],
    links: { ..no_links(), needs: [{ var: 1, reads: Scalar }] },
    statics: [],
  };
  assert_eq(release_needs(f).links.needs, [
    { var: 1, reads: Scalar },
    { var: 0, reads: Exact },
    { var: 1, reads: Layout },
    { var: 2, reads: Exact },
    { var: 3, reads: Exact },
  ]);
  assert_eq(release_reads(f).len(), 4);
  // A body counting only what its types settle reads none of its variables.
  assert_eq(
    release_reads({ ..f, body: [Dec(local(8, at(b"List", [int_type()]))), Return(AInt(0))] }),
    [],
  )
}
