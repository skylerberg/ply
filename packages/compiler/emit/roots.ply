import compiler.emit.code (hex)
import compiler.syntax.items (member_of)
import compiler.syntax.lexer (is_identifier_continue)
import std.bytes (ascii_of_int)

pub fn root_id(name: Bytes) -> Int = {
  let h = name.blake3();
  let low = match h.u32_at(0) { Some(v) -> v, None -> 0 };
  let high = match h.u32_at(4) { Some(v) -> v, None -> 0 };
  high << 31 | low >>> 1
}

pub fn builtin_helper(name: Bytes) -> Bytes / {abort.raise} =
  if name.starts_with(b"?") { b"builtin_elaborated_".concat(name.slice(1, name.len())) } else {
    match member_of(name) {
      Some(m) ->
        Bytes::concat_all([
          b"builtin_",
          Bytes::of_string(String::of_bytes(m.of).ascii_lower()),
          b"_",
          m.member,
        ]),
      None -> b"builtin_".concat(name),
    }
  }

pub fn builtin_pointed(pointer: Bytes) -> Option<Bytes> / {abort.raise} =
  if pointer.starts_with(b"builtin_") && pointer.ends_with(b"_p") {
    Some(pointer.slice(0, pointer.len() - 2))
  } else { None }

fn is_c_identifier(b: Bytes) -> Bool / {abort.raise} =
  b.len() > 0 && !(b.at(0) >= 48 && b.at(0) <= 57)
    && range(0, b.len()).all(|i: Int| is_identifier_continue(b.at(i)))

fn ends_in_digest(b: Bytes) -> Bool / {abort.raise} =
  b.len() > 17 && b.at(b.len() - 17) == 95
    && range(b.len() - 16, b.len()).all(|i: Int|
      (b.at(i) >= 48 && b.at(i) <= 57) || (b.at(i) >= 97 && b.at(i) <= 102))

test "every root name maps to a valid C identifier, and two different names map to two different symbols" {
  let names = [
    b"",
    b"m_a.b",
    b"m.a_b",
    b"m.f",
    b"m.f#requires#0",
    b"m.f\xc3\xa9",
    b"m.f@{a:Int}",
    b"m.g",
  ];
  let symbols = names.map(symbol_of);
  assert_eq(symbols.filter(|x: Bytes| !is_c_identifier(x) || !ends_in_digest(x)), []);
  assert_eq(
    range(0, symbols.len()).filter(|i: Int| symbols.drop(i + 1).contains(symbols.get(i))),
    [],
  );
  let f = symbol_of(b"m.f");
  let suffixed = [
    entry_symbol(b"m.f"),
    f.concat(b"_lambda0"),
    f.concat(b"_group"),
    f.concat(b"_lambda12_desc"),
  ];
  assert_eq(suffixed.filter(ends_in_digest), [])
}

test "a symbol's length is bounded however long the name is, and long names that differ only in the truncated tail get different symbols" {
  let long = |tail: Bytes|
    Bytes::concat_all([
      b"m.f@{",
      Bytes::concat_all(
        range(0, 40).map(|i: Int| Bytes::concat_all([b"f", ascii_of_int(i), b":Float,"])),
      ),
      tail,
      b"}",
    ]);
  let a = symbol_of(long(b"x:Int"));
  let b = symbol_of(long(b"y:Int"));
  assert(a != b, None);
  assert_eq([a.len(), b.len()], [4 + stem_length + 17, 4 + stem_length + 17]);
  assert(a.starts_with(b"ply_m_f_f0_Float_f1_"), None);
  assert(symbol_of(b"std.prelude.drop#List<Int>").starts_with(b"ply_std_prelude_drop_List_"), None);
  let n = long(b"x:Int");
  assert_eq(symbol_of(n.slice(0, 300).concat(n.slice(300, n.len()))), a)
}

pub fn generated_builtin(name: Bytes) -> Bytes =
  if name == b"?compare" { b"compare" }
  else if name == b"?reflect" { b"reflect" }
  else if name == b"?shown" { b"shown" }
  else if name == b"?concat" { b"Bytes::concat_all" }
  else { name }

pub fn symbol_of(full: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([b"ply_", stem_of(full), b"_", hex(full.blake3().slice(0, 8))])

const stem_length: Int = 24

fn stem_of(full: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, min(full.len(), 4 * stem_length)).fold([], |accumulator: List<Bytes>, i: Int|
      if accumulator.len() >= stem_length { accumulator }
      else if is_identifier_continue(full.at(i)) { accumulator.push(full.slice(i, i + 1)) }
      else if accumulator.len() > 0 && accumulator.get(accumulator.len() - 1) == b"_" {
        accumulator
      } else { accumulator.push(b"_") }),
  )

pub fn entry_symbol(full: Bytes) -> Bytes / {abort.raise} = symbol_of(full).concat(b"_entry")
