//! What the emitter calls a root by: the C symbols a root's name prints as, the id its sites name it
//! by, and the runtime's helpers by name.

import compiler.emit.code (hex)
import compiler.syntax.items (member_of)
import compiler.syntax.lexer (is_ident_continue)
import std.bytes (ascii_of_int)

/// The id a body's failure sites name their root by: a digest of its name, so a body's C does not
/// depend on which other roots the unit holds. Non-negative, since the C stores it in an `int64_t`.
pub fn root_id(name: Bytes) -> Int = {
  let h = name.blake3();
  let low = match h.u32_at(0) { Some(v) -> v, None -> 0 };
  let high = match h.u32_at(4) { Some(v) -> v, None -> 0 };
  high << 31 | low >>> 1
}

// --- Externs written in place -----------------------------------------------------

/// The runtime's helper for a builtin, named for it. An elaboration's `?` is spelled out, since no C
/// name holds one, and a function of a type is its type in lower case, `_` and its name.
pub fn builtin_helper(name: Bytes) -> Bytes / {abort.raise} =
  if name.starts_with(b"?") { b"builtin_elaborated_".concat(name.slice(1, name.len())) } else {
    match member_of(name) {
      Some(m) ->
        Bytes::concat_all([
          b"builtin_",
          Bytes::of_string(String::of_bytes(m.of).ascii_lower()),
          b"_",
          m.member,
        ]),
      None -> b"builtin_".concat(name),
    }
  }

/// The builtin's helper the C function pointer named `pointer` calls, a helper's name and `_p`; none
/// where it names no builtin's.
pub fn builtin_pointed(pointer: Bytes) -> Option<Bytes> / {abort.raise} =
  if pointer.starts_with(b"builtin_") && pointer.ends_with(b"_p") {
    Some(pointer.slice(0, pointer.len() - 2))
  } else { None }

/// Whether `b` is a C identifier: a letter or `_` first, then letters, digits and `_`.
fn c_identifier(b: Bytes) -> Bool / {abort.raise} =
  b.len() > 0 && !(b.at(0) >= 48 && b.at(0) <= 57)
    && range(0, b.len()).all(|i: Int| is_ident_continue(b.at(i)))

/// Whether `b` ends as a name's symbol does: `_` and 16 hex digits.
fn ends_in_digest(b: Bytes) -> Bool / {abort.raise} =
  b.len() > 17 && b.at(b.len() - 17) == 95
    && range(b.len() - 16, b.len()).all(|i: Int|
      (b.at(i) >= 48 && b.at(i) <= 57) || (b.at(i) >= 97 && b.at(i) <= 102))

test "every name spells a C identifier, and two names spell two symbols" {
  // `m_a.b` and `m.a_b` share a stem, told apart by the digest.
  let names = [
    b"",
    b"m_a.b",
    b"m.a_b",
    b"m.f",
    b"m.f#requires#0",
    b"m.f\xc3\xa9",
    b"m.f@{a:Int}",
    b"m.g",
  ];
  let symbols = names.map(symbol_of);
  assert_eq(symbols.filter(|x: Bytes| !c_identifier(x) || !ends_in_digest(x)), []);
  assert_eq(
    range(0, symbols.len()).filter(|i: Int| symbols.drop(i + 1).contains(symbols.get(i))),
    [],
  );
  // What the unit suffixes a symbol with ends as no name's symbol does.
  let f = symbol_of(b"m.f");
  let suffixed = [
    entry_of(b"m.f"),
    f.concat(b"_lambda0"),
    f.concat(b"_group"),
    f.concat(b"_lambda12_desc"),
  ];
  assert_eq(suffixed.filter(ends_in_digest), [])
}

test "a symbol is short however long its name, and names alike past its stem stay apart" {
  let long = |tail: Bytes|
    Bytes::concat_all([
      b"m.f@{",
      Bytes::concat_all(
        range(0, 40).map(|i: Int| Bytes::concat_all([b"f", ascii_of_int(i), b":Float,"])),
      ),
      tail,
      b"}",
    ]);
  let a = symbol_of(long(b"x:Int"));
  let b = symbol_of(long(b"y:Int"));
  assert(a != b, None);
  assert_eq([a.len(), b.len()], [4 + stem_room() + 17, 4 + stem_room() + 17]);
  // The stem is the name's start, so a profile or a debugger shows what the symbol is of.
  assert(a.starts_with(b"ply_m_f_f0_Float_f1_"), None);
  assert(symbol_of(b"std.prelude.drop#List<Int>").starts_with(b"ply_std_prelude_drop_List_"), None);
  // One name is one symbol, whatever its bytes were made of.
  let n = long(b"x:Int");
  assert_eq(symbol_of(n.slice(0, 300).concat(n.slice(300, n.len()))), a)
}

/// The builtin a name in code the emitter writes from a type calls: `?` and the builtin's name,
/// which no definition or import of the module the code is written in can take.
pub fn generated_builtin(name: Bytes) -> Bytes =
  if name == b"?compare" { b"compare" }
  else if name == b"?reflect" { b"reflect" }
  else if name == b"?shown" { b"shown" }
  else if name == b"?concat" { b"Bytes::concat_all" }
  else { name }

/// The C symbol a full name becomes: `ply_`, a stem of the name readable in a profile or a
/// debugger, `_` and the first 16 hex digits of the name's blake3. The stem is the name's first
/// bytes, each run of bytes no C identifier holds written as one `_`, cut to `stem_room`; the digest
/// tells apart names alike that far, two of a program's symbols alike failing to link rather than
/// running wrong. Every symbol ends in `_` and 16 hex digits, which nothing the unit suffixes
/// (`_entry`, `_lambda0`, `_group`) and nothing the runtime or the head names (`ply_bind`) does, so
/// no suffixed symbol is a name's own.
pub fn symbol_of(full: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all([b"ply_", stem_of(full), b"_", hex(full.blake3().slice(0, 8))])

/// How many bytes of a name a symbol's stem keeps.
fn stem_room() -> Int = 24

/// The first bytes of `full` a C identifier holds, each run of others one `_`, at most `stem_room`.
fn stem_of(full: Bytes) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    range(0, min(full.len(), 4 * stem_room())).fold([], |acc: List<Bytes>, i: Int|
      if acc.len() >= stem_room() { acc }
      else if is_ident_continue(full.at(i)) { acc.push(full.slice(i, i + 1)) }
      else if acc.len() > 0 && acc.get(acc.len() - 1) == b"_" { acc }
      else { acc.push(b"_") }),
  )

/// The symbol the loader binds a definition by, which is also its memo slot.
pub fn entry_of(full: Bytes) -> Bytes / {abort.raise} = symbol_of(full).concat(b"_entry")
