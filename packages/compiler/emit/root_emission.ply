import compiler.check.types (Type, FunctionType, VariableType, Effects, no_effects, bool_type,
                             bytes_type, named_type, int_type, unit_type)
import compiler.check.known (ordering_type)
import compiler.emit.code (Code)
import compiler.emit.typing (unknown_type)
import compiler.emit.output (Tables, no_tables, EmittedRoot, Prototype, Exact, needs_specialisation,
                             Keyed, KeyedTag, KeyedField, KeyedEntry)
import compiler.emit.representations (Definition, EmitParam, substituted_fully, EmitReads,
                                      ShapeReads, code_facts, with_no_shapes, lowering)
import compiler.emit.keys
import compiler.emit.keys (RootKey, Named, Generated, Law, Clause, Order, Reflect, Show, Digest,
                           NumericFunction, RootName, root_name, root_text, key_types,
                           unspecialised, has_entry, ReleaseResource, ContainerWalk)
import compiler.emit.pieces (Piece, Hole, ConstructorTag, FieldName, LambdaEntry, pieces_text,
                             body_text)
import compiler.emit.typed_ir
import compiler.emit.typed_ir (Function, Lambda, Closure)
import compiler.emit.evidence (declared_arity)
import compiler.emit.typed_ir.statics (StaticDefinition, entries_of)
import compiler.emit.lower (root_lowered)
import compiler.emit.lower.module_context (ModuleContext, Root, param_type, definition_rooted)
import compiler.emit.own (insert_reference_counts)
import compiler.emit.release (release_needs)
import compiler.emit.verify (ownership_fault)
import compiler.emit.print (printed_function)
import compiler.emit.print.text (PrintOutput)
import compiler.emit.print.value_printing (signature_types)

pub fn root_at(
  s: ModuleContext,
  key: RootKey,
  base: Int,
  ps: List<EmitParam>,
  code: Code,
) -> Root / {EmitReads} =
  {
    key: key,
    base: base,
    params: ps,
    types: ps.map(param_type),
    result_type: root_result_type(s, key),
    code: code,
    performs: no_effects,
  }

fn root_result_type(s: ModuleContext, key: RootKey) -> Type / {EmitReads} =
  match definition_rooted(s, unspecialised(key)) {
    Some(d) -> match d.scheme {
      Some(scheme) -> match scheme.ty {
        FunctionType(f) -> substituted_fully(f.return_type, key_types(key)),
        _ -> generated_result_type(key),
      },
      None -> generated_result_type(key),
    },
    None -> generated_result_type(key),
  }

fn generated_result_type(key: RootKey) -> Type =
  match key {
    Generated(w, _) -> match w.operation {
      keys::Equal -> bool_type,
      Order -> ordering_type,
      NumericFunction(_) -> w.ty,
      Reflect -> named_type(b"std.value.Value"),
      Show -> named_type(b"std.value.Value"),
      Digest -> bytes_type,
      ReleaseResource -> unit_type,
      ContainerWalk(c) -> if c == b"let_go_items" { unit_type } else { unknown_type },
      _ -> unknown_type,
    },
    Law(_) -> bool_type,
    Clause(_) -> bool_type,
    _ -> unknown_type,
  }

pub fn naming<a | e>(
  name: Bytes,
  run: () -> a / {lowering.fail, abort.raise | e},
) -> a / {lowering.fail, abort.raise | e} =
  handle {
    run()
  } with {
    abort.raise(m) ->
      panic(String::of_bytes_lossy(Bytes::concat_all([b"Ply failed making `", name, b"`: "])) ++ m),
    lowering.fail(reason) ->
      lowering.fail(Bytes::concat_all([b"Ply failed making `", name, b"`: ", reason])),
  }

pub fn emitted_of(f: Function) -> EmittedRoot / {ShapeReads, lowering.fail} = {
  let full = root_name(f.key);
  naming(root_text(full), || {
    let counted = built_form(f);
    if needs_specialisation(counted.links.needs) { deferred_to_callers(full, counted) } else {
      match ownership_fault(counted) {
        Some(fault) ->
          panic(
            String::of_bytes_lossy(
              b"the typed form of the function fails the ownership check: ".concat(fault),
            ),
          ),
        None -> {
          let printed = printed_function(counted);
          {
            name: full,
            text: body_text(
              counted.key,
              counted.members.map(|m: typed_ir::Member| m.key),
              printed.pieces,
            ),
            tables: ir_tables(counted, printed),
          }
        },
      }
    }
  })
}

fn deferred_to_callers(full: RootName, f: Function) -> EmittedRoot =
  {
    name: full,
    text: b"",
    tables: {
      ..no_tables,
      generics: {
        calls: f.links.generics,
        needs: f.links.needs,
        expects: [],
        called_parameters: f.links.called,
        passes: f.links.forwarded_parameters,
      },
      members: f.members.map(|m: typed_ir::Member| m.key),
    },
  }

pub fn with_refcounts(f: Function) -> Function =
  if f.kind == typed_ir::Plain { f } else { insert_reference_counts(f) }

pub fn built_form(f: Function) -> Function = release_needs(with_refcounts(f))

pub fn ir_tables(f: Function, printed: PrintOutput) -> Tables / {ShapeReads} = {
  let signatures = if f.members.len() == 0 {
    [{ key: f.key, arity: declared_arity(f.params), head: signature_types(f.convention) }]
  } else {
    f.members.map(|m: typed_ir::Member|
      { key: m.key, arity: declared_arity(m.params), head: signature_types(m.convention) })
  };
  let statics = statics_named(f, []);
  {
    fields: printed.fields,
    lambdas: printed.lambdas.map(pieces_text),
    calls: statics.fold(printed.calls, |accumulator: List<RootKey>, d: StaticDefinition|
      entries_of(d).fold(accumulator, |a: List<RootKey>, k: RootKey|
        if a.contains(k) { a } else { a.push(k) })),
    generics: {
      calls: f.links.generics,
      needs: f.links.needs,
      expects: printed.expects,
      called_parameters: f.links.called,
      passes: f.links.forwarded_parameters,
    },
    performs: printed.performs,
    handles: printed.handles,
    members: f.members.map(|m: typed_ir::Member| m.key),
    defined: signatures.map(|h: { key: RootKey, arity: Int, head: Prototype }|
      {
        entered: has_entry(h.key, h.arity, |n: Bytes| code_facts.stated_function(n)),
        head: h.head,
      }),
    statics: statics,
    handings: [],
    assumed: [],
    group: [],
    shared: printed.shared,
    natives: printed.natives,
    keyed: keyed_in(printed.pieces),
  }
}

fn keyed_in(pieces: List<Piece>) -> List<Keyed> =
  pieces.fold([], |accumulator: List<Keyed>, p: Piece| {
    let keyed = match p {
      Hole(ConstructorTag(name)) -> Some(KeyedTag(name)),
      Hole(FieldName(i)) -> Some(KeyedField(i)),
      Hole(LambdaEntry(i)) -> Some(KeyedEntry(i)),
      _ -> None,
    };
    match keyed {
      Some(k) -> if accumulator.contains(k) { accumulator } else { accumulator.push(k) },
      None -> accumulator,
    }
  })

fn statics_named(f: Function, known_statics: List<StaticDefinition>) -> List<StaticDefinition> =
  f.lambdas.fold(
    f.statics.fold(known_statics, |accumulator: List<StaticDefinition>, d: StaticDefinition|
      if accumulator.contains(d) { accumulator } else { accumulator.push(d) }),
    |accumulator: List<StaticDefinition>, l: Lambda|
      match l { Closure(c) -> statics_named(c.body, accumulator) },
  )

pub fn root_from_code(
  s: ModuleContext,
  base: Int,
  key: RootKey,
  ps: List<EmitParam>,
  code: Code,
  performs: Effects = { listed: [], variable: None },
) -> Function / {EmitReads} =
  root_lowered(s, { ..root_at(s, key, base, ps, code), performs: performs })

test "a release function for a type-variable value emits no C and records which layouts its callers must supply" {
  let p = { id: 0, ty: VariableType(0), representation: typed_ir::AsWord };
  let f = {
    key: Named(b"m.dropping"),
    kind: typed_ir::Metered,
    params: [p],
    convention: {
      params: [{ ownership: typed_ir::OwnedParam, representation: typed_ir::AsWord }],
      result: typed_ir::AsInt,
      destination_passing: false,
      returned: typed_ir::OwnedResult,
    },
    result_type: int_type,
    body: [typed_ir::Return(typed_ir::IntOperand(0))],
    lambdas: [],
    base: 0,
    members: [],
    links: typed_ir::no_links,
    statics: [],
  };
  let resolved = with_no_shapes(|| emitted_of(f));
  assert_eq(resolved.text, b"");
  assert_eq(resolved.tables.generics.needs, [{ var: 0, reads: Exact }]);
  assert_eq(resolved.tables.defined, []);
  let known = with_no_shapes(|| emitted_of({ ..f, params: [{ ..p, ty: bytes_type }] }));
  assert(known.text.len() > 0 && known.tables.generics.needs == [], None)
}
