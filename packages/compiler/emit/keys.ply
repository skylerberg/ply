import compiler.check.types (Type, NamedType, FunctionType, RecordType, NominalType, Field,
                             Resource, NamedResource, SingletonResource, ResourceVariable,
                             AnyResource, encode_type, type_bin, resource_bin, int_type,
                             string_type, list_type)
import compiler.check.resolve.tables (qualify, module_of_name)
import std.bin
import std.bytes (ascii_of_int)
import std.hash (blake3)

pub type RootKey =
  | Named(Bytes)
  | Specialisation({ definition: Bytes, args: List<KeyArg>, borrowed: List<InlinedLambda>, effect_evidence: List<List<Evidence>> }, RootName)
  | Generated({ op: TypeOp, ty: Type, home: Bytes, marks: List<Int> }, RootName)
  | Test({ module: Bytes, digest: Bytes })
  | TestCases(RootKey)
  | Law({ module: Bytes, digest: Bytes, part: LawPart })
  | Clause({ definition: RootKey, kind: ClauseKind, n: Int })
  | EntryPoint(RootKey)
  | Coded({ definition: Bytes, code: Bytes })

pub type LawPart = | LawGuard | LawBody

pub type ClauseKind = | Requires | Ensures

pub type KeyArg = | KeyType(Type) | KeyLayout({ key: Bytes, at: Type })

pub type InlinedLambda = { param: Int, owner: RootKey, nth: Int }

pub type Evidence = { effect: Bytes, resource: Resource }

pub type TypeOp =
  | Equal
  | Order
  | NumericFunction(Bytes)
  | Reflect
  | Show
  | Digest
  | ContainerWalk(Bytes)
  | Drop
  | Share
  | Keep
  | Copy
  | Lower
  | Lift
  | Dup
  | Release
  | ReleaseResource
  | OnCase({ op: TypeOp, case: Int })
  | OnWordForm(TypeOp)
  | Unboxed(TypeOp)
  | Keeping
  | Opening

pub type Callee = | Root(RootKey) | Generic(Int)

pub opaque type RootName = | RootName(Bytes)

derive bin for KeyArg
derive bin for TypeOp
derive bin for InlinedLambda
derive bin for Evidence
derive bin for LawPart
derive bin for ClauseKind
derive bin for RootKey
derive bin for RootName

pub fn key_bytes(k: RootKey) -> Bytes / {abort.raise} = bin::encode(k, root_key_bin())

pub fn root_name(k: RootKey) -> RootName =
  match k { Specialisation(_, n) -> n, Generated(_, n) -> n, _ -> RootName(key_text(k)) }

pub fn root_text(n: RootName) -> Bytes = match n { RootName(b) -> b }

fn specialisation_text(
  a: { definition: Bytes, args: List<KeyArg>, borrowed: List<InlinedLambda>, effect_evidence: List<List<Evidence>> },
) -> RootName =
  RootName(
    Bytes::concat_all(
      [
        a.definition,
        b"@",
        Bytes::join(
          a.args.map(|x: KeyArg|
            match x { KeyType(t) -> type_name_text(t), KeyLayout(l) -> l.key }),
          b",",
        ),
      ].concat(
        a.borrowed.map(|f: InlinedLambda|
          Bytes::concat_all([
            b"|",
            ascii_of_int(f.param),
            b"=",
            key_text(f.owner),
            b":",
            ascii_of_int(f.nth),
          ])),
      ).concat(
        a.effect_evidence.map(|r: List<Evidence>| b"/".concat(evidence_text(r))),
      ),
    ),
  )

pub fn evidence_text(ws: List<Evidence>) -> Bytes =
  Bytes::concat_all([
    b"{",
    Bytes::join(
      ws.map(|w: Evidence|
        match w.resource {
          SingletonResource -> w.effect,
          NamedResource(n) -> Bytes::concat_all([w.effect, b"[", n, b"]"]),
          AnyResource -> w.effect.concat(b"[*]"),
          ResourceVariable(k) -> Bytes::concat_all([w.effect, b"[#", ascii_of_int(k), b"]"]),
        }),
      b",",
    ),
    b"}",
  ])

fn generated_name(w: { op: TypeOp, ty: Type, home: Bytes, marks: List<Int> }) -> RootName = {
  let ty = if w.marks.len() == 0 { type_name_text(w.ty) } else {
    Bytes::concat_all([type_name_text(w.ty), b"^", Bytes::join(w.marks.map(ascii_of_int), b",")])
  };
  let wrapped = match w.op {
    Keeping -> contains_function(w.ty),
    Opening -> contains_function(w.ty),
    _ -> false,
  };
  let named = if wrapped { Bytes::concat_all([ty, b"@", digest_text(full_type_text(w.ty))]) }
  else { ty };
  RootName(match w.op {
    Equal -> named.concat(b"#eq"),
    Order -> named.concat(b"#cmp"),
    _ -> qualify(type_module(w.ty, w.home), Bytes::concat_all([op_name(w.op), b"#", named])),
  })
}

fn contains_function(ty: Type) -> Bool =
  match ty {
    FunctionType(_) -> true,
    NamedType(c) -> c.args.any(contains_function),
    RecordType(fs) -> fs.any(|f: Field| contains_function(f.ty)),
    NominalType(x) ->
      x.args.any(contains_function) || x.fields.any(|f: Field| contains_function(f.ty)),
    _ -> false,
  }

fn full_type_text(ty: Type) -> Bytes =
  match ty {
    FunctionType(f) ->
      Bytes::concat_all([
        b"(",
        Bytes::join(f.params.map(full_type_text), b","),
        b")->",
        full_type_text(f.ret),
      ]),
    NamedType(c) -> applied_type_text(c.name, c.args),
    RecordType(fs) ->
      Bytes::concat_all([
        b"{",
        Bytes::join(
          fs.map(|f: Field| Bytes::concat_all([f.name, b":", full_type_text(f.ty)])),
          b",",
        ),
        b"}",
      ]),
    NominalType(x) -> applied_type_text(x.name, x.args),
    _ -> encode_type(ty),
  }

fn applied_type_text(name: Bytes, args: List<Type>) -> Bytes =
  if args.len() == 0 { name }
  else { Bytes::concat_all([name, b"<", Bytes::join(args.map(full_type_text), b","), b">"]) }

fn key_text(k: RootKey) -> Bytes =
  match k {
    Named(n) -> n,
    Specialisation(_, n) -> root_text(n),
    Generated(_, n) -> root_text(n),
    Test(t) -> labelled(t.module, b"test", t.digest),
    TestCases(c) -> key_text(c).concat(b".cases"),
    Law(l) -> Bytes::concat_all([labelled(l.module, b"law", l.digest), b".", part_name(l.part)]),
    Clause(c) ->
      Bytes::concat_all([
        key_text(c.definition),
        b"#",
        match c.kind { Requires -> b"requires", Ensures -> b"ensures" },
        b"#",
        ascii_of_int(c.n),
      ]),
    EntryPoint(e) -> key_text(e).concat(b"#entered"),
    Coded(c) -> Bytes::concat_all([c.definition, b"@=", c.code]),
  }

fn type_name_text(ty: Type) -> Bytes = spelling_of(ty, Map::new()).text

type Spelling = { text: Bytes, digests: Map<Type, Bytes> }

fn spelling_of(ty: Type, digests: Map<Type, Bytes>) -> Spelling =
  match ty {
    NamedType(c) -> {
      let args = all_nested(c.args, digests);
      { text: named_type_text(c.name, args.texts), digests: args.digests }
    },
    RecordType(fs) -> fields_spelling(b"", fs, digests),
    NominalType(x) -> {
      let args = all_nested(x.args, digests);
      fields_spelling(named_type_text(x.name, args.texts), x.fields, args.digests)
    },
    _ -> { text: encode_type(ty), digests: digests },
  }

fn nested_spelling(ty: Type, digests: Map<Type, Bytes>) -> Spelling =
  match ty {
    RecordType(_) -> digest_spelling(ty, digests),
    NominalType(_) -> digest_spelling(ty, digests),
    _ -> spelling_of(ty, digests),
  }

fn digest_spelling(ty: Type, digests: Map<Type, Bytes>) -> Spelling =
  match digests.get(ty) {
    Some(d) -> { text: d, digests: digests },
    None -> {
      let own = spelling_of(ty, digests);
      let d = digest_text(own.text);
      { text: d, digests: own.digests.insert(ty, d) }
    },
  }

fn all_nested(
  types: List<Type>,
  digests: Map<Type, Bytes>,
) -> { texts: List<Bytes>, digests: Map<Type, Bytes> } =
  types.fold(
    { texts: [], digests: digests },
    |acc: { texts: List<Bytes>, digests: Map<Type, Bytes> }, t: Type| {
      let s = nested_spelling(t, acc.digests);
      { texts: acc.texts.push(s.text), digests: s.digests }
    },
  )

fn fields_spelling(head: Bytes, fs: List<Field>, digests: Map<Type, Bytes>) -> Spelling = {
  let walked = fs.fold(
    { texts: [], digests: digests },
    |acc: { texts: List<Bytes>, digests: Map<Type, Bytes> }, f: Field| {
      let s = nested_spelling(f.ty, acc.digests);
      { texts: acc.texts.push(Bytes::concat_all([f.name, b":", s.text])), digests: s.digests }
    },
  );
  {
    text: Bytes::concat_all([head, b"{", Bytes::join(walked.texts, b","), b"}"]),
    digests: walked.digests,
  }
}

fn named_type_text(name: Bytes, args: List<Bytes>) -> Bytes = {
  let n = encode_type(NamedType({ name: name, args: [] }));
  if args.len() == 0 { n } else { Bytes::concat_all([n, b"<", Bytes::join(args, b","), b">"]) }
}

fn digest_text(text: Bytes) -> Bytes = {
  let h = text.blake3();
  let low = match h.u32_at(0) { Some(v) -> v, None -> 0 };
  let high = match h.u32_at(4) { Some(v) -> v, None -> 0 };
  b"%".concat(ascii_of_int(high << 31 | low >>> 1))
}

pub fn entry_name(root: RootName) -> RootName = RootName(root_text(root).concat(b"#entered"))

pub fn has_entry(k: RootKey, arity: Int, stated: Map<Bytes, Bool>) -> Bool =
  match k { Named(n) -> arity == 0 || stated.contains(n), EntryPoint(_) -> true, _ -> false }

pub fn part_name(p: LawPart) -> Bytes = match p { LawGuard -> b"guard", LawBody -> b"body" }

fn labelled(module: Bytes, kind: Bytes, digest: Bytes) -> Bytes =
  qualify(module, Bytes::concat_all([kind, b"#", digest]))

pub fn label_digest(name: Bytes) -> Bytes / {abort.raise} =
  Bytes::of_string(blake3(name).slice(0, 8).hex_of())

pub fn test_key(module: Bytes, name: Bytes) -> RootKey / {abort.raise} =
  Test({ module: module, digest: label_digest(name) })

pub fn law_key(module: Bytes, label: Bytes, part: LawPart) -> RootKey / {abort.raise} =
  Law({ module: module, digest: label_digest(label), part: part })

pub fn test_owner(module: Bytes, name: Bytes) -> Bytes / {abort.raise} =
  site_owner_text(test_key(module, name))

pub fn law_owner(module: Bytes, label: Bytes) -> Bytes / {abort.raise} =
  labelled(module, b"law", label_digest(label))

pub fn op_name(op: TypeOp) -> Bytes =
  match op {
    Equal -> b"eq",
    Order -> b"cmp",
    NumericFunction(s) -> b"numeric_".concat(s),
    Reflect -> b"reflect",
    Show -> b"shown",
    Digest -> b"digest",
    ContainerWalk(c) -> c,
    Drop -> b"drop",
    Share -> b"share",
    Keep -> b"keep",
    Copy -> b"copy",
    Lower -> b"lower",
    Lift -> b"lift",
    Dup -> b"dup",
    Release -> b"release",
    ReleaseResource -> b"let_go",
    OnCase(c) -> Bytes::concat_all([op_name(c.op), b".", ascii_of_int(c.case)]),
    OnWordForm(o) -> b"word_".concat(op_name(o)),
    Unboxed(o) -> b"held_".concat(op_name(o)),
    Keeping -> b"keeping",
    Opening -> b"opening",
  }

pub fn module_of(k: RootKey) -> Bytes =
  match k {
    Named(n) -> module_of_name(n),
    Specialisation(a, _) -> module_of_name(a.definition),
    Coded(c) -> module_of_name(c.definition),
    Generated(w, _) -> type_module(w.ty, w.home),
    Test(t) -> t.module,
    TestCases(c) -> module_of(c),
    Law(l) -> l.module,
    Clause(c) -> module_of(c.definition),
    EntryPoint(e) -> module_of(e),
  }

pub fn modules_lowered(ks: List<RootKey>) -> Map<Bytes, Bool> =
  ks.fold(Map::new(), |acc: Map<Bytes, Bool>, k: RootKey|
    inlined_lambdas(k).fold(
      acc.insert(module_of(k), true),
      |m: Map<Bytes, Bool>, f: InlinedLambda| m.insert(module_of(f.owner), true),
    ))

fn type_module(ty: Type, otherwise: Bytes) -> Bytes =
  match ty {
    NamedType(c) -> {
      let m = module_of_name(c.name);
      if m.len() == 0 { otherwise } else { m }
    },
    _ -> otherwise,
  }

pub fn definition_of(k: RootKey) -> Option<Bytes> =
  match k {
    Named(n) -> Some(n),
    Specialisation(a, _) -> Some(a.definition),
    Coded(c) -> Some(c.definition),
    EntryPoint(e) -> definition_of(e),
    _ -> None,
  }

pub fn site_owner(k: RootKey) -> RootName = RootName(site_owner_text(k))

pub fn site_owner_text(k: RootKey) -> Bytes =
  match k {
    Named(n) -> n,
    Specialisation(a, _) -> a.definition,
    Coded(c) -> c.definition,
    EntryPoint(e) -> site_owner_text(e),
    _ -> key_text(k),
  }

pub fn key_types(k: RootKey) -> List<Type> =
  match k {
    Specialisation(a, _) ->
      a.args.map(|x: KeyArg| match x { KeyType(t) -> t, KeyLayout(l) -> l.at }),
    _ -> [],
  }

pub fn inlined_lambdas(k: RootKey) -> List<InlinedLambda> =
  match k { Specialisation(a, _) -> a.borrowed, _ -> [] }

pub fn key_effects(k: RootKey) -> List<List<Evidence>> =
  match k { Specialisation(a, _) -> a.effect_evidence, _ -> [] }

pub fn specialisation_key(
  definition: Bytes,
  args: List<Type>,
  borrowed: List<InlinedLambda>,
) -> RootKey = specialisation_key_of(definition, args.map(KeyType), borrowed)

pub fn claims_key(definition: Bytes, vars: Int) -> RootKey =
  specialisation_key(definition, range(0, vars).map(|_: Int| int_type()), [])

pub fn specialisation_key_of(
  definition: Bytes,
  args: List<KeyArg>,
  borrowed: List<InlinedLambda>,
) -> RootKey = specialisation_key_with_effects(definition, args, borrowed, [])

pub fn specialisation_key_with_effects(
  definition: Bytes,
  args: List<KeyArg>,
  borrowed: List<InlinedLambda>,
  effect_evidence: List<List<Evidence>>,
) -> RootKey = {
  let a = {
    definition: definition,
    args: args,
    borrowed: borrowed,
    effect_evidence: effect_evidence,
  };
  Specialisation(a, specialisation_text(a))
}

pub fn generated_key(op: TypeOp, ty: Type, asking: Bytes) -> RootKey =
  generated_with_name({ op: op, ty: ty, home: type_module(ty, asking), marks: [] })

pub fn with_marks(k: RootKey, marks: List<Int>) -> RootKey =
  match k { Generated(w, _) -> generated_with_name({ ..w, marks: marks }), _ -> k }

pub fn as_op(k: RootKey, op: TypeOp) -> RootKey =
  match k { Generated(w, _) -> generated_with_name({ ..w, op: op }), _ -> k }

fn generated_with_name(w: { op: TypeOp, ty: Type, home: Bytes, marks: List<Int> }) -> RootKey =
  Generated(w, generated_name(w))

pub fn unspecialised(k: RootKey) -> RootKey =
  match k { Specialisation(a, _) -> Named(a.definition), _ -> k }

pub fn printed(k: RootKey) -> Bytes = root_text(root_name(k))

pub fn name_in_module(module: Bytes, root: Bytes) -> Bytes / {abort.raise} =
  if module.len() == 0 { root } else { root.slice(module.len() + 1, root.len()) }

test "a root's name spells each record its type holds by digest, once however deep records nest" {
  let string = string_type();
  let nested = |leaf: Type, d: Int|
    range(0, d).fold(leaf, |below: Type, _: Int|
      RecordType([{ name: b"x", ty: below }, { name: b"y", ty: list_type(below) }]));
  let deep = |d: Int| nested(RecordType([{ name: b"s", ty: string }]), d);
  let named = |op: TypeOp, d: Int| printed(generated_key(op, deep(d), b"m"));
  let below = digest_text(
    Bytes::concat_all([
      b"{x:",
      digest_text(b"{s:String}"),
      b",y:List<",
      digest_text(b"{s:String}"),
      b">}",
    ]),
  );
  assert_eq(named(Drop, 2), Bytes::concat_all([b"m.drop#{x:", below, b",y:List<", below, b">}"]));
  assert(
    named(Drop, 9)
      != printed(
        generated_key(Drop, nested(RecordType([{ name: b"s", ty: int_type() }]), 9), b"m"),
      ),
    None,
  );
  assert(named(Lift, 16).len() < 64, None)
}

test "a key prints as the name roots were spelled with before they were keys" {
  let int = int_type();
  let list = list_type(int);
  assert_eq(printed(Named(b"m.f")), b"m.f");
  assert_eq(
    printed(
      specialisation_key_of(
        b"m.f",
        [KeyType(int), KeyType(NamedType({ name: b"_", args: [] }))],
        [{ param: 1, owner: Named(b"m.g"), nth: 0 }],
      ),
    ),
    b"m.f@Int,_|1=m.g:0",
  );
  assert_eq(
    printed(
      specialisation_key(b"m.f", [], [
        { param: 0, owner: specialisation_key(b"m.g", [int], []), nth: 2 },
      ]),
    ),
    b"m.f@|0=m.g@Int:2",
  );
  assert_eq(
    printed(generated_key(Equal, NamedType({ name: b"m.Shape", args: [] }), b"m")),
    b"m.Shape#eq",
  );
  assert_eq(printed(generated_key(ContainerWalk(b"equal"), list, b"m")), b"m.equal#List<Int>");
  assert_eq(printed(generated_key(Reflect, list, b"m")), b"m.reflect#List<Int>");
  assert_eq(
    printed(generated_key(Reflect, NamedType({ name: b"geo.Shape", args: [] }), b"app")),
    b"geo.reflect#geo.Shape",
  );
  assert_eq(printed(EntryPoint(Named(b"m.main"))), b"m.main#entered");
  assert_eq(printed(Coded({ definition: b"m.f", code: b"3f09" })), b"m.f@=3f09");
  let run = test_key(b"m", b"holds");
  assert_eq(printed(run), b"m.test#".concat(label_digest(b"holds")));
  assert_eq(printed(TestCases(run)), printed(run).concat(b".cases"));
  assert_eq(printed(law_key(b"m", b"holds", LawBody)), law_owner(b"m", b"holds").concat(b".body"));
  assert_eq(printed(Clause({ definition: Named(b"m.f"), kind: Ensures, n: 1 })), b"m.f#ensures#1")
}

test "a test's and a law's roots are told apart by kind and label, and each prints apart" {
  let keys = [
    test_key(b"m", b"one"),
    test_key(b"m", b"two"),
    TestCases(test_key(b"m", b"one")),
    law_key(b"m", b"one", LawGuard),
    law_key(b"m", b"one", LawBody),
    Clause({ definition: Named(b"m.f"), kind: Requires, n: 0 }),
    Clause({ definition: Named(b"m.f"), kind: Ensures, n: 0 }),
    Named(b"m.f"),
  ];
  assert_eq(label_digest(b"one").len(), 16);
  assert_eq(
    keys.map(root_name).fold([], |seen: List<RootName>, n: RootName|
      if seen.contains(n) { seen } else { seen.push(n) }).len(
    ),
    keys.len(),
  );
  assert_eq(keys.map(definition_of), [None, None, None, None, None, None, None, Some(b"m.f")]);
  assert_eq(definition_of(EntryPoint(Named(b"m.f"))), Some(b"m.f"));
  assert_eq(site_owner_text(EntryPoint(test_key(b"m", b"one"))), test_owner(b"m", b"one"));
  assert_eq(site_owner(EntryPoint(test_key(b"m", b"one"))), root_name(test_key(b"m", b"one")));
  assert_eq(entry_name(root_name(Named(b"m.f"))), root_name(EntryPoint(Named(b"m.f"))))
}

test "names key a table, ordered as the spellings they print as" {
  let ks = [Named(b"m.z"), EntryPoint(Named(b"m.a")), Named(b"m.B"), Named(b"m.z")];
  let table = ks.fold(Map::new(), |m: Map<RootName, Bool>, k: RootKey|
    m.insert(root_name(k), true));
  assert_eq(table.keys().map(root_text), [b"m.B", b"m.a#entered", b"m.z"]);
  assert(
    table.contains(root_name(Named(b"m.B"))) && !table.contains(root_name(Named(b"m.b"))),
    None,
  )
}

test "a root's module is read off its key, never off its name" {
  let shape = NamedType({ name: b"geo.Shape", args: [] });
  assert_eq(module_of(Named(b"app.cli.main")), b"app.cli");
  assert_eq(
    [
      test_key(b"app.cli", b"a.b c"),
      TestCases(test_key(b"app.cli", b"x.y")),
      law_key(b"app.cli", b"x.y", LawBody),
      Clause({ definition: Named(b"app.cli.main"), kind: Requires, n: 0 }),
      EntryPoint(test_key(b"app.cli", b"a.b c")),
    ].map(
      module_of,
    ),
    [b"app.cli", b"app.cli", b"app.cli", b"app.cli", b"app.cli"],
  );
  assert_eq([module_of(test_key(b"", b"t")), module_of(Named(b"main"))], [b"", b""]);
  assert_eq(
    module_of(specialisation_key_of(b"lib.h", [], [{ param: 0, owner: Named(b"app.g"), nth: 1 }])),
    b"lib",
  );
  assert_eq(module_of(generated_key(Equal, shape, b"app")), b"geo");
  assert_eq(module_of(generated_key(ContainerWalk(b"equal"), shape, b"app")), b"geo");
  assert_eq(module_of(generated_key(Show, list_type(shape), b"app")), b"app")
}

test "two keys are kept apart by their encoding, and one key always encodes alike" {
  let int = int_type();
  let a = specialisation_key_of(b"m.f", [KeyType(int)], []);
  let b = specialisation_key_of(b"m.f", [KeyLayout({ key: b"Int", at: int })], []);
  assert_eq(key_bytes(a) == key_bytes(b), false);
  assert_eq(key_bytes(a), key_bytes(specialisation_key(b"m.f", [int], [])));
  assert_eq(
    match bin::decode(key_bytes(a), root_key_bin()) { Ok(k) -> Some(k), Err(_) -> None },
    Some(a),
  )
}

test "a specialisation keyed by a layout is named by the layout alone and lowered at its representative" {
  let laid = |name: Bytes|
    specialisation_key_of(
      b"m.f",
      [KeyLayout({ key: b"_", at: NamedType({ name: name, args: [] }) })],
      [],
    );
  assert_eq(printed(laid(b"m.A")), b"m.f@_");
  assert_eq(printed(laid(b"m.A")), printed(laid(b"m.B")));
  assert_eq(laid(b"m.A") == laid(b"m.B"), false);
  assert_eq(key_types(laid(b"m.B")), [NamedType({ name: b"m.B", args: [] })])
}

test "a specialisation's definition, types and lambdas are read off its key, an owner's among them" {
  let int = int_type();
  let owner = specialisation_key(b"app.g", [list_type(int)], []);
  let k = specialisation_key(b"lib.h", [int], [{ param: 1, owner: owner, nth: 0 }]);
  assert_eq(definition_of(k), Some(b"lib.h"));
  assert_eq(site_owner_text(k), b"lib.h");
  assert_eq(site_owner(k), root_name(Named(b"lib.h")));
  assert_eq(key_types(k), [int]);
  assert_eq(inlined_lambdas(k).map(|f: InlinedLambda| definition_of(f.owner)), [Some(b"app.g")]);
  assert_eq(inlined_lambdas(k).map(|f: InlinedLambda| key_types(f.owner)), [[list_type(int)]]);
  assert_eq(key_types(Named(b"lib.h")), []);
  assert_eq(site_owner_text(generated_key(Reflect, int, b"m")), b"m.reflect#Int");
  let coded = Coded({ definition: b"lib.h", code: b"3f09" });
  assert_eq([definition_of(coded), Some(module_of(coded))], [Some(b"lib.h"), Some(b"lib")]);
  assert_eq(site_owner(coded), site_owner(k))
}

test "a written root's marks follow its type in its name, so keys differing only in marks differ" {
  let int = int_type();
  let pair = NamedType({ name: b"m.Pair", args: [int, int] });
  let at = |op: TypeOp, marks: List<Int>| with_marks(generated_key(op, pair, b"app"), marks);
  assert_eq(printed(at(Lower, [1, 2])), b"m.lower#m.Pair<Int,Int>^1,2");
  assert_eq(printed(at(Equal, [0])), b"m.Pair<Int,Int>^0#eq");
  assert_eq(printed(at(Lift, [])), b"m.lift#m.Pair<Int,Int>");
  assert_eq(printed(at(Lift, [1])) == printed(at(Lift, [2])), false);
  assert_eq([Dup, Release].map(|op: TypeOp| printed(at(op, []))), [
    b"m.dup#m.Pair<Int,Int>",
    b"m.release#m.Pair<Int,Int>",
  ])
}

test "a key's name is made with it, and a key remade from another names as one made afresh" {
  let pair = NamedType({ name: b"m.Pair", args: [int_type()] });
  let lift = generated_key(Lift, pair, b"app");
  assert_eq(as_op(lift, Lower), generated_key(Lower, pair, b"app"));
  assert_eq(with_marks(lift, []), lift);
  assert_eq(printed(as_op(with_marks(lift, [1]), Dup)), b"m.dup#m.Pair<Int>^1");
  assert_eq(
    [as_op(Named(b"m.f"), Lower), with_marks(specialisation_key(b"m.f", [pair], []), [1])],
    [Named(b"m.f"), specialisation_key(b"m.f", [pair], [])],
  );
  assert_eq(
    match bin::decode(key_bytes(lift), root_key_bin()) { Ok(k) -> printed(k), Err(_) -> b"" },
    b"m.lift#m.Pair<Int>",
  )
}

test "a written root is keyed by the module it is written in, so two keys are equal where their names are" {
  let shape = NamedType({ name: b"geo.Shape", args: [] });
  let list = list_type(shape);
  assert_eq(generated_key(Reflect, shape, b"app"), generated_key(Reflect, shape, b"lib"));
  assert_eq(generated_key(Show, list, b"app") == generated_key(Show, list, b"lib"), false);
  assert_eq(printed(generated_key(Reflect, shape, b"app")), b"geo.reflect#geo.Shape");
  assert_eq(unspecialised(specialisation_key(b"m.f", [shape], [])), Named(b"m.f"));
  assert_eq(unspecialised(generated_key(Equal, shape, b"app")), generated_key(Equal, shape, b"app"))
}

test "a case's root is written in its sum's module, named by its operation and place apart from every other" {
  let expression = NamedType({ name: b"m.Expr", args: [] });
  let cased = |op: TypeOp, case: Int|
    printed(generated_key(OnCase({ op: op, case: case }), expression, b"app"));
  assert_eq(cased(Drop, 1), b"m.drop.1#m.Expr");
  let names = [cased(Drop, 1), cased(Drop, 2), cased(Share, 1), cased(Keep, 1)].concat(
    [Drop, Share, Keep, Copy, Dup, Release, Reflect, Equal, Order].map(|op: TypeOp|
      printed(generated_key(op, expression, b"app"))),
  );
  assert_eq(
    names.fold([], |seen: List<Bytes>, n: Bytes|
      if seen.contains(n) { seen } else { seen.push(n) }),
    names,
  )
}
