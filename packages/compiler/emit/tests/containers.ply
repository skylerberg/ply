      source_text: b"(m: Map<Int, String>, r: MapNode<Int, String>) -> Map<Int, String> = MapNode::map_swap(m, Some(r), 1, 40).map",
    },
    { name: b"spelt", source_text: b"(b: Bytes) -> String = Utf8::spelt(b)" },
  ]

test "each prelude extern that has an intrinsic lowers to operations on the runtime's objects, using the layouts' field positions" {
  let calls = intrinsic_calls();
  let probes = calls.fold(b"\n", |accumulator: Bytes, c: { name: Bytes, source_text: Bytes }|
    Bytes::concat_all([accumulator, b"fn probe_", c.name, c.source_text, b"\n"]));
  assert_eq(
    intrinsics().filter(|i: { name: Bytes, operation: Intrinsic }|
      probes.index_of(i.name.slice(b"std.prelude.".len(), i.name.len()).concat(b"(")) == None).map(
      |i: { name: Bytes, operation: Intrinsic }| i.name,
    ),
    [],
  );
  match analyse(
      parse_all([{ name: b"std.prelude", source_text: prelude_source::text().concat(probes) }]),
    ) {
    Analysed(a) -> match module_context_in(a, b"std.prelude") {
      Ok(s) -> {
        let lowered = |name: Bytes| {
          let full = b"std.prelude.probe_".concat(name);
          match s.roots.find(|r: Root| r.key == Named(full)) {
            None -> panic(String::of_bytes_lossy(b"no such probe: ".concat(name))),
            Some(r) -> lowered_fn(context_of(s.setting, r, r.code), r.code),
          }
        };
        let written = |f: Function|
          f.body.fold([], |accumulator: List<Rvalue>, i: Instruction|
            match i {
              Let(l) -> match l.value {
                OperationCall(_) -> accumulator.push(l.value),
                Native(_) -> accumulator.push(l.value),
                Call(_) -> accumulator.push(l.value),
                _ -> accumulator,
              },
              _ -> accumulator,
            });
        assert_eq(
          calls.fold(
            [],
            |accumulator: List<{ name: Bytes, reason: Bytes }>, c: { name: Bytes, source_text: Bytes }|
              match written(lowered(c.name)) {
                [OperationCall(o)] -> match o.operation {
                  OfContainers(NodeIntrinsic(_)) -> accumulator,
                  _ -> accumulator.push({ name: c.name, reason: b"another operation" }),
                },
                _ -> accumulator.push({ name: c.name, reason: b"not one operation" }),
              },
          ),
          [],
        );
        let code = |name: Bytes|
          pieces_text(printed_function(lowered(name), s.setting.constructors).pieces);
        let laid = container_layouts();
        let has = |name: Bytes, text: Bytes| code(name).index_of(text) != None;
        let field = |name: Bytes| b"))->".concat(name);
        let tree_node = |kind: Int|
          Bytes::concat_all([b"ply_node(ctx, ", ascii_of_int(kind), b", "]);
        let past = |from: Int| ascii_of_int(from).concat(b" + (");
        assert_eq(
          [
            has(b"height", field(b"height")),
            has(b"kid_max", past(branch_layout(1).keys)),
            has(b"kid_size", past(branch_layout(1).sizes)),
            has(b"leaf", tree_node(laid.tree.leaf)),
            has(b"map_branch", tree_node(laid.tree.branch)),
            has(b"branch_cut", tree_node(laid.tree.branch)),
            has(b"leaf_cut", tree_node(laid.tree.leaf)),
          ],
          [true, true, true, true, true, true, true],
        );
        let resolved = calls.filter(|c: { name: Bytes, source_text: Bytes }| {
          let f = lowered(c.name);
          f.links.needs == []
        });
        let copies = |name: Bytes| {
          let f = lowered(name);
          printed_function(f, s.setting.constructors).calls.filter(|k: RootKey|
            match k { Generated(w, _) -> w.operation == Copy, _ -> false })
        };
        assert_eq([b"kid_put", b"map_swap", b"branch_cut", b"spelt"].map(copies), [
          [root_of(Copy, map_node_type(int_type(), string_type()))],
          [root_of(Copy, map_type(int_type(), string_type()))],
          [root_of(Copy, map_node_type(int_type(), string_type()))],
          [],
        ]);
        let fields = |name: Bytes| {
          let f = lowered(name);
          f.body.fold([], |accumulator: List<Representation>, i: Instruction|
            match i {
              Let(l) -> match l.value {
                OperationCall(_) -> accumulator.push(l.var.representation),
                _ -> accumulator,
              },
              _ -> accumulator,
            })
        };
        assert_eq(fields(b"pair_take"), [
          AsFlattened([
            { name: b"key", representation: AsInt },
            { name: b"node", representation: AsWord },
            { name: b"value", representation: AsWord },
          ]),
        ]);
        assert_eq(fields(b"key_take"), [
          AsFlattened([
            { name: b"key.a", representation: AsInt },
            { name: b"key.b", representation: AsInt },
            { name: b"node", representation: AsWord },
            { name: b"value", representation: AsInt },
          ]),
        ]);
        assert_eq(fields(b"open_key_take"), [
          AsFlattened([
            { name: b"key", representation: AsWord },
            { name: b"node", representation: AsWord },
            { name: b"value", representation: AsWord },
          ]),
        ]);
        assert_eq(fields(b"nested_take"), [
          AsFlattened([
            { name: b"key.a.x", representation: AsInt },
            { name: b"key.a.y", representation: AsWord },
            { name: b"key.b", representation: AsInt },
            { name: b"node", representation: AsWord },
            { name: b"value", representation: AsInt },
          ]),
        ]);
        assert_eq(
          resolved.filter(|c: { name: Bytes, source_text: Bytes }| has(c.name, b"builtin_")).map(
            |c: { name: Bytes, source_text: Bytes }| c.name,
          ),
          [],
        );
        let none_missed = |missed: List<Bytes>|
          assert(missed.len() == 0, Some(String::of_bytes_lossy(Bytes::join(missed, b"\n"))));
        none_missed(
          [b"map_root"].fold([], |accumulator: List<Bytes>, name: Bytes| {
            let text = pieces_text(
              printed_function(
                insert_reference_counts(lowered(name)),
                s.setting.constructors,
              ).pieces,
            );
            if increments_count(text) { accumulator }
            else { accumulator.push(Bytes::concat_all([name, b":\n", text])) }
          }),
        )
      },
      Err(reason) -> panic(String::of_bytes_lossy(reason)),
    },
    _ -> panic("the prelude and its probes do not check"),
  }
}
