fn lowered_text(p: Program, name: Bytes) -> Bytes / {abort.raise} = {
  let f = lowered_root(p, name);
  printed_text(p, f)
}

test "every function in the container test programs lowers, type-checks after its counts are placed, and prints without failures" {
  assert_eq(build_failures(program_from(corpus()), corpus_names()), [])
}

