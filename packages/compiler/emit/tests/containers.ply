type Binding = { var: Variable, value: Rvalue }

fn bound_in(p: Program, name: Bytes) -> List<Binding> / {abort.raise} = {
  let f = lowered_root(p, name);
  f.body.fold([], |accumulator: List<Binding>, i: Instruction|
    match i { Let(l) -> accumulator.push({ var: l.var, value: l.value }), _ -> accumulator })
}

fn allocations_in(bs: List<Binding>) -> List<{ made: Allocation, args: List<Arg> }> =
  bs.fold([], |accumulator: List<{ made: Allocation, args: List<Arg> }>, b: Binding|
    match b.value {
      Allocate(m) -> accumulator.push({ made: m.made, args: m.args }),
      _ -> accumulator,
    })

fn natives_in(
  bs: List<Binding>,
) -> List<{ name: Bytes, args: List<Arg>, uses: OperationSignature, result: Representation }> =
  bs.fold(
    [],
    |accumulator: List<{ name: Bytes, args: List<Arg>, uses: OperationSignature, result: Representation }>, b: Binding|
      match b.value {
        Native(n) ->
          accumulator.push({
            name: n.name,
            args: n.args,
            uses: n.uses,
            result: b.var.representation,
          }),
        _ -> accumulator,
      },
  )

fn operations_in(
  bs: List<Binding>,
) -> List<{ operation: Operation, args: List<Arg>, uses: OperationSignature, result: Representation }> =
  bs.fold(
    [],
    |accumulator: List<{ operation: Operation, args: List<Arg>, uses: OperationSignature, result: Representation }>, b: Binding|
      match b.value {
        OperationCall(o) ->
          accumulator.push({
            operation: o.operation,
            args: o.args,
            uses: o.uses,
            result: b.var.representation,
          }),
        _ -> accumulator,
      },
  )

fn packs_in(bs: List<Binding>) -> List<Representation> =
  bs.fold([], |accumulator: List<Representation>, b: Binding|
    match b.value { Convert(k) -> accumulator.push(k.to), _ -> accumulator })

fn param(id: Int, ty: Bytes) -> Arg =
  VariableOperand({ id: id, ty: NamedType({ name: ty, args: [] }), representation: AsWord })

test "a list literal is built from its items, each stored in the representation of its type" {
  let p = program_from(
    Bytes::concat_all([
      b"fn pair(a: String, b: String) -> List<String> = [a, b]\n",
      b"fn nums(a: Int) -> List<Int> = [a, 2]\n",
      b"fn none() -> List<Int> = []\n",
    ]),
  );
  assert_eq(allocations_in(bound_in(p, b"pair")), [
    { made: ListAllocation(2), args: [param(0, b"String"), param(1, b"String")] },
  ]);
  assert_eq(packs_in(bound_in(p, b"nums")), []);
  assert_eq(
    allocations_in(bound_in(p, b"nums")).map(|m: { made: Allocation, args: List<Arg> }|
      m.args.map(operand_representation)),
    [[AsInt, AsInt]],
  );
  assert_eq(allocations_in(bound_in(p, b"none")), [{ made: ListAllocation(0), args: [] }]);
  assert_eq(
    bound_in(p, b"nums").fold([], |accumulator: List<Type>, b: Binding|
      match b.value { Allocate(_) -> accumulator.push(b.var.ty), _ -> accumulator }),
    [list_type(int_type())],
  )
}

test "a list pattern reads an item directly from the list and binds the rest as a new list" {
  let p = program_from(b"fn f(xs: List<String>) -> Int = 0\n");
  let strings = list_type(string_type());
  let opened = |name: Bytes, ty: Type, act: (Context, Variable) -> LoweredValue|
    match p.roots.find(|r: Root| r.key == Named(qualify(b"m", name))) {
      None -> panic("no such root"),
      Some(r) -> {
        let code = r.code;
        let xs = { id: 0, ty: ty, representation: AsWord };
        act(context_of(p.setting, r, code), xs)
      },
    };
  let bound = |l: LoweredValue|
    l.st.instructions.fold([], |accumulator: List<Binding>, i: Instruction|
      match i { Let(x) -> accumulator.push({ var: x.var, value: x.value }), _ -> accumulator });
  let item = opened(b"f", strings, |context: Context, xs: Variable|
    item_read(context, initial_lowering([xs]), VariableOperand(xs), IntOperand(40), string_type()));
  assert_eq(operations_in(bound(item)), [
    {
      operation: OfContainers(ItemAt),
      args: [VariableOperand({ id: 0, ty: strings, representation: AsWord }), IntOperand(40)],
      uses: { takes: [false, false], owned: false, fails: false, suspends: false },
      result: AsWord,
    },
  ]);
  let rest = opened(b"f", strings, |context: Context, xs: Variable|
    rest_read(initial_lowering([xs]), strings, VariableOperand(xs), IntOperand(2)));
  assert_eq(
    operations_in(bound(rest)).map(
      |o: { operation: Operation, args: List<Arg>, uses: OperationSignature, result: Representation }|
        { operation: o.operation, uses: o.uses },
    ),
    [
      {
        operation: OfContainers(Rest),
        uses: { takes: [false, false], owned: true, fails: false, suspends: false },
      },
    ],
  );
  assert_eq(natives_in(bound(item).concat(bound(rest))), [])
}

test "an empty map is constant data for every type, including a type variable, so creating one calls no function" {
  let p = program_from(
    Bytes::concat_all([
      b"fn fresh() -> Map<Int, String> = Map::new()\n",
      b"fn open<a>() -> Map<a, Int> = Map::new()\n",
    ]),
  );
  [b"fresh", b"open"].fold((), |_: Unit, f: Bytes| {
    assert_eq(natives_in(bound_in(p, f)).len(), 0);
    assert_eq(packs_in(bound_in(p, f)), [])
  })
}

test "`len` on a list, byte string or array reads the length directly, cannot fail and does not take the container as an argument" {
  let p = program_from(
    Bytes::concat_all([
      b"fn count(xs: List<String>) -> Int = xs.len()\n",
      b"fn size(b: Bytes) -> Int = b.len()\n",
      b"fn arity(a: Array<String>) -> Int = a.len()\n",
    ]),
  );
  let read = |name: Bytes| {
    let bs = bound_in(p, name);
    assert_eq(natives_in(bs), []);
    operations_in(bs).map(
      |o: { operation: Operation, args: List<Arg>, uses: OperationSignature, result: Representation }|
        { operation: o.operation, takes: o.uses.takes, fails: o.uses.fails, result: o.result },
    )
  };
  assert_eq([read(b"count"), read(b"size"), read(b"arity")], [
    [{ operation: OfContainers(Length), takes: [false], fails: false, result: AsInt }],
    [{ operation: OfContainers(Length), takes: [false], fails: false, result: AsInt }],
    [{ operation: OfContainers(ArrayLength), takes: [false], fails: false, result: AsInt }],
  ])
}

fn element_in(p: Program, t: Type) -> Element / {abort.raise} = {
  let l = layout_of(p.setting.constructors, t);
  { layout: l, stride: max(1, words(l)) }
}

test "an array's `at` checks the index and reads the element directly, building the Option inline instead of calling the runtime" {
  let p = program_from(b"fn element(a: Array<String>, i: Int) -> Option<String> = a.at(i)\n");
  assert_eq(natives_in(bound_in(p, b"element")), []);
  assert_eq(
    operations_in(bound_in(p, b"element")).map(
      |o: { operation: Operation, args: List<Arg>, uses: OperationSignature, result: Representation }|
        { operation: o.operation, result: o.result },
    ),
    [{ operation: OfContainers(InBounds), result: AsBool }],
  );
  let text = lowered_text(p, b"element");
  assert(text.index_of(b"(uint64_t)") != None, Some(String::of_bytes_lossy(text)))
}

test "an array is created, written and read directly using the representation of its element type" {
  let p = program_from(
    Bytes::concat_all([
      b"fn made(n: Int) -> Array<Int> / {abort.raise} = Array::new(n, 0)\n",
      b"fn written(a: Array<Float>, x: Float) -> Array<Float> / {abort.raise} = a.set(1, x)\n",
      b"fn laid(xs: List<Decimal>) -> Array<Decimal> = Array::of_list(xs)\n",
      b"fn read(a: Array<Int>, i: Int) -> Int / {abort.raise} = a.get(i)\n",
      b"fn words(a: Array<String>, i: Int) -> String / {abort.raise} = a.get(i)\n",
      b"fn records(n: Int, r: { x: Int, y: Int }) -> Array<{ x: Int, y: Int }> / {abort.raise} = Array::new(n, r)\n",
      b"fn record(a: Array<{ x: Int, y: Int }>) -> Int / {abort.raise} = a.get(0).y\n",
      b"fn options(a: Array<Option<String>>, x: Option<String>) -> Array<Option<String>> / {abort.raise} = a.set(0, x)\n",
      b"fn units(n: Int) -> Array<Unit> / {abort.raise} = Array::new(n, ())\n",
    ]),
  );
  let operations_of = |name: Bytes|
    operations_in(bound_in(p, name)).map(
      |o: { operation: Operation, args: List<Arg>, uses: OperationSignature, result: Representation }|
        { operation: o.operation, result: o.result, takes: o.uses.takes },
    );
  let int = int_type();
  let point = RecordType([{ name: b"x", ty: int }, { name: b"y", ty: int }]);
  assert_eq(operations_of(b"records"), [
    {
      operation: OfContainers(ArrayNew(element_in(p, point))),
      result: AsWord,
      takes: [false, true],
    },
  ]);
  assert_eq(element_in(p, point).stride, 2);
  assert(
    operations_of(b"record").any(
      |o: { operation: Operation, result: Representation, takes: List<Bool> }|
        o.operation == OfContainers(ArrayGet(element_in(p, point)))
          && (match o.result { AsFlattened(_) -> true, _ -> false }),
    ),
    None,
  );
  let option = option_type(string_type());
  assert_eq(operations_of(b"options"), [
    {
      operation: OfContainers(ArraySet(element_in(p, option))),
      result: AsWord,
      takes: [true, false, true],
    },
  ]);
  assert_eq(element_in(p, option).stride, 1);
  assert_eq(operations_of(b"made"), [
    { operation: OfContainers(ArrayNew(element_in(p, int))), result: AsWord, takes: [false, true] },
  ]);
  assert_eq(operations_of(b"written"), [
    {
      operation: OfContainers(ArraySet(element_in(p, float_type()))),
      result: AsWord,
      takes: [true, false, true],
    },
  ]);
  assert_eq(operations_of(b"laid"), [
    {
      operation: OfContainers(ArrayOfList(element_in(p, decimal_type()))),
      result: AsWord,
      takes: [true],
    },
  ]);
  assert_eq(element_in(p, decimal_type()).stride, 2);
  assert_eq(operations_of(b"read"), [
    { operation: OfContainers(ArrayGet(element_in(p, int))), result: AsInt, takes: [false, false] },
  ]);
  assert_eq(operations_of(b"words"), [
    {
      operation: OfContainers(ArrayGet(element_in(p, string_type()))),
      result: AsWord,
      takes: [false, false],
    },
  ]);
  assert_eq(element_in(p, unit_type()).stride, 1);
  assert_eq(packs_in(bound_in(p, b"made")), []);
  [
    b"made",
    b"written",
    b"laid",
    b"read",
    b"words",
    b"records",
    b"record",
    b"options",
    b"units",
  ].fold((), |_: Unit, n: Bytes| {
    assert_eq(
      natives_in(bound_in(p, n)).filter(
        |c: { name: Bytes, args: List<Arg>, uses: OperationSignature, result: Representation }|
          c.name.index_of(b"array") != None,
      ),
      [],
    );
    match checked(p, n) {
      Ok(_) -> (),
      Err(reason) -> panic(String::of_bytes_lossy(Bytes::concat_all([n, b": ", reason]))),
    }
  })
}

test "an array is created with a runtime array header, but a `Columns` is created without one" {
  let p = program_from(
    Bytes::concat_all([
      b"fn ints(n: Int) -> Array<Int> / {abort.raise} = Array::new(n, 0)\n",
      b"fn made(n: Int) -> Columns<{ a: Int }> / {abort.raise} = Columns::new(n, { a: 0 })\n",
    ]),
  );
  let headed = Bytes::concat_all([b"((", array_head().name, b" *)ply_words("]);
  assert_eq(
    [
      lowered_text(p, b"ints").index_of(headed) != None,
      lowered_text(p, b"made").index_of(b"rt_alloc_p(") == None,
    ],
    [true, true],
  )
}

test "`Columns` creation, writes, reads, length and `at` are lowered to one array per field, with no runtime call" {
  let p = program_from(
    Bytes::concat_all([
      b"type P = { x: Float, label: String }\n",
      b"fn made(n: Int, r: P) -> Columns<P> / {abort.raise} = Columns::new(n, r)\n",
      b"fn listed(rs: List<P>) -> Columns<P> = Columns::of_list(rs)\n",
      b"fn written(c: Columns<P>, r: P) -> Columns<P> / {abort.raise} = c.set(0, r)\n",
      b"fn read(c: Columns<P>, i: Int) -> P / {abort.raise} = c.get(i)\n",
      b"fn counted(c: Columns<P>) -> Int = c.len()\n",
      b"fn found(c: Columns<P>, i: Int) -> Option<P> = c.at(i)\n",
    ]),
  );
  let operations_of = |name: Bytes|
    operations_in(bound_in(p, name)).map(
      |o: { operation: Operation, args: List<Arg>, uses: OperationSignature, result: Representation }|
        o.operation,
    );
  let es = [element_in(p, string_type()), element_in(p, float_type())];
  assert_eq(operations_of(b"made"), [OfContainers(ColumnsNew(es))]);
  assert_eq(operations_of(b"listed"), [OfContainers(ColumnsOfList(es))]);
  assert_eq(operations_of(b"written"), [OfContainers(ColumnsSet(es))]);
  assert_eq(operations_of(b"read"), [OfContainers(ColumnsGet(es))]);
  assert_eq(operations_of(b"counted"), [OfContainers(ColumnOf(0)), OfContainers(ArrayLength)]);
  assert_eq(operations_of(b"found"), [OfContainers(ColumnOf(0)), OfContainers(InBounds)]);
  [b"made", b"listed", b"written", b"read", b"counted", b"found"].fold((), |_: Unit, n: Bytes| {
    assert_eq(natives_in(bound_in(p, n)), []);
    match checked(p, n) {
      Ok(_) -> (),
      Err(reason) -> panic(String::of_bytes_lossy(Bytes::concat_all([n, b": ", reason]))),
    }
  })
}

test "an array whose elements have a type variable's type is created using the element layout that its callers supply" {
  let p = program_from(
    b"fn made<a>(n: Int, x: a) -> Array<a> / {abort.raise} = Array::new(n, x)\n",
  );
  {
    let f = lowered_root(p, b"made");
    assert_eq(f.links.needs.map(|n: Need| n.reads), [Layout]);
    assert_eq(
      operations_in(bound_in(p, b"made")).map(
        |o: { operation: Operation, args: List<Arg>, uses: OperationSignature, result: Representation }|
          o.operation,
      ),
      [OfHandling(UnspecialisedBuiltin(b"Array::new"))],
    )
  }
}

test "reading a field of a `Columns` element reads that field's array directly, without building the whole record" {
  let p = program_from(
    Bytes::concat_all([
      b"type P = { x: Float, label: String, at: { a: Int, b: Int } }\n",
      b"fn x_at(ps: Columns<P>, i: Int) -> Float / {abort.raise} = ps.get(i).x\n",
      b"fn label_at(ps: Columns<P>, i: Int) -> String / {abort.raise} = ps.get(i).label\n",
      b"fn at_at(ps: Columns<P>, i: Int) -> Int / {abort.raise} = ps.get(i).at.b\n",
      b"fn var_at<a>(ps: Columns<{ v: a }>, i: Int) -> a / {abort.raise} = ps.get(i).v\n",
    ]),
  );
  let read = |name: Bytes|
    match p.roots.find(|r: Root| r.key == Named(qualify(b"m", name))) {
      None -> [],
      Some(r) -> {
        let code = r.code;
        let context = context_of(p.setting, r, code);
        let base = match code.node {
          CodeFieldRead(f) -> match f.base.node {
            CodeFieldRead(g) -> Some({ base: g.base, name: g.field }),
            _ -> Some({ base: f.base, name: f.field }),
          },
          _ -> None,
        };
        match base {
          None -> [],
          Some(b) -> match reads_column(context, b.base, b.name) {
            false -> [],
            true -> {
              let ps = {
                id: 0,
                ty: match r.types.at(0) { Some(t) -> t, None -> unknown_type() },
                representation: AsWord,
              };
              let i = { id: 1, ty: int_type(), representation: AsInt };
              let l = column_read(
                context,
                initial_lowering([ps, i]),
                [VariableOperand(ps), VariableOperand(i)],
                b.base,
                b.name,
                code.span,
              );
              l.st.instructions.fold(
                [],
                |accumulator: List<{ operation: Operation, result: Representation }>, x: Instruction|
                  match x {
                    Let(v) -> match v.value {
                      OperationCall(o) ->
                        accumulator.push({ operation: o.operation, result: v.var.representation }),
                      _ -> accumulator,
                    },
                    _ -> accumulator,
                  },
              )
            },
          },
        }
      },
    };
  assert_eq(read(b"x_at"), [
    {
      operation: OfContainers(ColumnField({ k: 2, column: element_in(p, float_type()) })),
      result: AsFloat,
    },
  ]);
  assert_eq(read(b"label_at"), [
    {
      operation: OfContainers(ColumnField({ k: 1, column: element_in(p, string_type()) })),
      result: AsWord,
    },
  ]);
  assert(
    read(b"at_at").any(|o: { operation: Operation, result: Representation }|
      match o.result { AsFlattened(_) -> true, _ -> false }),
    None,
  );
  assert_eq(read(b"var_at"), [])
}

test "`Bytes::position` lowers to an inline loop that calls the predicate and builds the Option without a runtime call" {
  let p = program_from(b"fn found(b: Bytes) -> Option<Int> = b.position(0, |c: Int| c == 32)\n");
  [p, { ..p, setting: { ..p.setting, release_build: true } }].fold((), |_: Unit, q: Program| {
    assert_eq(
      operations_in(bound_in(q, b"found")).map(
        |o: { operation: Operation, args: List<Arg>, uses: OperationSignature, result: Representation }|
          { operation: o.operation, uses: o.uses, result: o.result },
      ),
      [
        {
          operation: OfContainers(Position),
          uses: {
            takes: [false, false, false, false, false],
            owned: true,
            fails: true,
            suspends: true,
          },
          result: AsInt,
        },
      ],
    );
    assert_eq(natives_in(bound_in(q, b"found")), [])
  });
  let text = lowered_text(p, b"found");
  assert(text.index_of(b"(const PlyFnDesc *)") != None, Some(String::of_bytes_lossy(text)));
  let looped = match text.index_of(b"for (int64_t ") {
    Some(i) -> text.slice(i, text.len()),
    None -> b"",
  };
  assert(looped.len() > 0 && increments_count(looped), Some(String::of_bytes_lossy(text)))
}

test "`Bytes::position` passes its predicate the predicate's function and the handlers for the effects the predicate performs" {
  let p = program_from(
    Bytes::concat_all([
      b"effect asks {\n  write one() -> Unit\n}\n",
      b"fn found(b: Bytes) -> Option<Int> / {asks.one, abort.raise} =\n",
      b"  b.position(0, |c: Int| {\n    asks.one();\n    c == 32\n  })\n",
    ]),
  );
  let positions = operations_in(bound_in(p, b"found")).filter(
    |o: { operation: Operation, args: List<Arg>, uses: OperationSignature, result: Representation }|
      o.operation == OfContainers(Position),
  );
  assert_eq(
    positions.map(
      |o: { operation: Operation, args: List<Arg>, uses: OperationSignature, result: Representation }|
        o.args.len(),
    ),
    [5],
  );
  assert_eq(
    positions.map(
      |o: { operation: Operation, args: List<Arg>, uses: OperationSignature, result: Representation }|
        match o.args.at(4) {
          Some(ZeroOperand(_)) -> b"none",
          Some(_) -> b"laid",
          None -> b"missing",
        },
    ),
    [b"laid"],
  );
  let text = lowered_text(p, b"found");
  let looped = match text.index_of(b"for (int64_t ") {
    Some(i) -> text.slice(i, text.len()),
    None -> b"",
  };
  let call = match looped.index_of(b"->typed)(ctx, ") {
    Some(i) -> {
      let rest = looped.slice(i, looped.len());
      match rest.index_of(b";") { Some(j) -> rest.slice(0, j), None -> rest }
    },
    None -> b"",
  };
  assert(call.index_of(b"], ") != None, Some(String::of_bytes_lossy(text)))
}

test "`Bytes::position` used as a value becomes a lambda whose loop calls the predicate that it receives as an argument" {
  let p = program_from(
    Bytes::concat_all([
      b"fn space(c: Int) -> Bool = c == 32\n",
      b"fn by(f: (Bytes, Int, (Int) -> Bool) -> Option<Int> / {abort.raise}, b: Bytes) -> Option<Int> / {abort.raise} = f(b, 0, space)\n",
      b"fn spaced(b: Bytes) -> Option<Int> / {abort.raise} = by(Bytes::position, b)\n",
    ]),
  );
  let positions = match checked(p, b"spaced") {
    Ok(f) ->
      f.lambdas.fold([], |accumulator: List<OperationSignature>, l: Lambda|
        match l {
          Closure(c) ->
            c.body.body.fold(accumulator, |us: List<OperationSignature>, i: Instruction|
              match i {
                Let(x) -> match x.value {
                  OperationCall(o) -> if o.operation == OfContainers(Position) { us.push(o.uses) }
                  else { us },
                  _ -> us,
                },
                _ -> us,
              }),
        }),
    Err(reason) -> panic(String::of_bytes_lossy(reason)),
  };
  assert_eq(positions, [
    { takes: [false, false, false, false, false], owned: true, fails: true, suspends: true },
  ]);
  let text = lowered_text(p, b"spaced");
  assert(text.index_of(b"(const PlyFnDesc *)") != None, Some(String::of_bytes_lossy(text)))
}

fn cleanups(p: Program, name: Bytes) -> List<OperationSignature> / {abort.raise} =
  match checked(p, name) {
    Ok(f) ->
      f.lambdas.fold([f.body], |accumulator: List<List<Instruction>>, l: Lambda|
        match l { Closure(c) -> accumulator.push(c.body.body) }).fold(
        [],
        |accumulator: List<OperationSignature>, b: List<Instruction>|
          b.fold(accumulator, |us: List<OperationSignature>, i: Instruction|
            match i {
              Let(x) -> match x.value {
                Native(n) -> if n.name == b"rt_with_cleanup_p" { us.push(n.uses) } else { us },
                _ -> us,
              },
              _ -> us,
            }),
      ),
    Err(reason) -> panic(String::of_bytes_lossy(Bytes::concat_all([name, b": ", reason]))),
  }

fn cleanup_uses() -> OperationSignature =
  { takes: [true, true, true, false, false], owned: true, fails: true, suspends: true }

test "`bracket` passes its closures the handlers for the effects they perform, and the enclosing `handle` provides them" {
  let p = program_from(
    Bytes::concat_all([
      b"effect meter {\n  read level() -> Int\n}\n",
      b"fn under() -> Int =\n",
      b"  handle { bracket(|| 1, |_x: Int| (), |x: Int| meter.level() + x) } with { meter.level() -> 0 }\n",
    ]),
  );
  let text = lowered_text(p, b"under");
  let set = entry_handler_words(text);
  assert(set.len() > 0 && !set.contains(b"0"), Some(String::of_bytes_lossy(text)))
}

test "`with_scope` passes its closures the handlers for the effects they perform, and the enclosing `handle` provides them" {
  let p = program_from(
    Bytes::concat_all([
      b"effect meter {\n  read level() -> Int\n}\n",
      b"fn under() -> Int =\n",
      b"  handle { with_scope[t](1, |_x: Int| ()) { c -> meter.level() + c.get() } } with { meter.level() -> 0 }\n",
    ]),
  );
  let text = lowered_text(p, b"under");
  let set = entry_handler_words(text);
  assert(set.len() > 0 && !set.contains(b"0"), Some(String::of_bytes_lossy(text)))
}

test "`bracket`, named or passed as a value, is the runtime's `rt_with_cleanup`, taking its closures" {
  let p = program_from(
    Bytes::concat_all([
      b"fn release(_: Int) -> Unit = ()\n",
      b"fn bracketed(n: Int) -> Int = bracket(|| n, release, |x: Int| x + 1)\n",
      b"fn by(f: (() -> Int, (Int) -> Unit, (Int) -> Int) -> Int, n: Int) -> Int = f(|| n, release, |x: Int| x + 1)\n",
      b"fn bracketed_by(n: Int) -> Int = by(bracket, n)\n",
    ]),
  );
  assert_eq(cleanups(p, b"bracketed"), [cleanup_uses()]);
  assert_eq(cleanups(p, b"bracketed_by"), [cleanup_uses()]);
  [b"bracketed", b"bracketed_by"].fold((), |_: Unit, n: Bytes| {
    let text = lowered_text(p, n);
    assert(text.index_of(b"rt_with_cleanup_p(ctx, ") != None, Some(String::of_bytes_lossy(text)));
    assert_eq(text.index_of(b"builtin_bracket_p"), None)
  })
}

test "functions using handler variables or `with_scope` type-check, and `with_scope` calls the runtime's `rt_with_cleanup`" {
  let p = program_from(
    Bytes::concat_all([
      b"effect tally {\n  write add(n: Int) -> Unit\n  read total() -> Int\n}\n",
      b"fn counted() -> Int = handle { tally.add(1); tally.add(2); tally.total() } with { var n = 0, tally.add(k) -> { n = n + k; }, tally.total() -> n }\n",
      b"fn release(_: Int) -> Unit = ()\n",
      b"fn held(n: Int) -> Int = with_scope[t](n, release) { c -> c.get() }\n",
      b"fn copied(n: Int) -> Bool = { let got = with_scope[t](n, release) { c -> with_scope[u](c.get(), release) { d -> d.get() } }; got >= 0 }\n",
    ]),
  );
  assert_eq(
    [b"counted", b"held", b"copied"].fold(
      [],
      |accumulator: List<{ name: Bytes, reason: Bytes }>, n: Bytes|
        match checked(p, n) {
          Ok(_) -> accumulator,
          Err(reason) -> accumulator.push({ name: n, reason: reason }),
        },
    ),
    [],
  );
  assert_eq(cleanups(p, b"held"), [cleanup_uses()]);
  assert(
    !natives_in(bound_in(p, b"copied")).any(
      |c: { name: Bytes, args: List<Arg>, uses: OperationSignature, result: Representation }|
        c.name == b"rt_binary_p",
    ),
  );
  let hold_natives = |name: Bytes| {
    let f = lowered_root(p, name);
    f.lambdas.fold([], |accumulator: List<Binding>, l: Lambda|
      match l {
        Closure(c) ->
          accumulator.concat(
            c.body.body.fold([], |bs: List<Binding>, i: Instruction|
              match i { Let(x) -> bs.push({ var: x.var, value: x.value }), _ -> bs }),
          ),
      }).filter(|b: Binding|
      match b.value { Native(n) -> n.name.index_of(b"hold_") != None, _ -> false })
  };
  let int = int_type();
  let typed = hold_natives(b"held").map(|b: Binding|
    match b.value {
      Native(n) ->
        {
          name: n.name,
          held: match b.var.ty { NamedType(c) -> c.args.at(c.args.len() - 1), _ -> None },
          whole: b.var.ty,
        },
      _ -> { name: b"", held: None, whole: b.var.ty },
    });
  assert_eq(typed.map(|t: { name: Bytes, held: Option<Type>, whole: Type }| t.name), [
    b"builtin_elaborated_hold_made_p",
    b"builtin_elaborated_hold_taken_p",
    b"builtin_elaborated_hold_read_p",
  ]);
  assert_eq(
    hold_natives(b"held").map(|b: Binding|
      match b.value { Native(n) -> Some({ takes: n.uses.takes, owned: n.uses.owned }), _ -> None }),
    [
      Some({ takes: [true], owned: true }),
      Some({ takes: [false], owned: true }),
      Some({ takes: [false], owned: false }),
    ],
  );
  assert_eq(
    typed.map(|t: { name: Bytes, held: Option<Type>, whole: Type }|
      match t.held { Some(h) -> h, None -> t.whole }),
    [int, int, int],
  )
}

test "an operator on a numeric type variable lowers to a generic builtin that is later specialised to each caller's concrete type" {
  let p = program_from(
    Bytes::concat_all([
      b"fn less<a>(x: a, y: a) -> Bool where numeric(a) = x < y\n",
      b"fn sum<a>(x: a, y: a) -> a where numeric(a) = x + y\n",
      b"fn negated<a>(x: a) -> a where numeric(a) = -x\n",
      b"fn halved<a>(x: a) -> a where integer(a) = x >> 1\n",
    ]),
  );
  let names = [b"less", b"sum", b"negated", b"halved"];
  assert_eq(
    names.fold([], |accumulator: List<{ name: Bytes, reason: Bytes }>, n: Bytes|
      match checked(p, n) {
        Ok(_) -> accumulator,
        Err(reason) -> accumulator.push({ name: n, reason: reason }),
      }),
    [],
  );
  let binary = OfHandling(UnspecialisedBuiltin(b"?numeric_binary"));
  assert_eq(
    names.map(|n: Bytes|
      operations_in(bound_in(p, n)).map(
        |o: { operation: Operation, args: List<Arg>, uses: OperationSignature, result: Representation }|
          o.operation,
      )),
    [[binary], [binary], [OfHandling(UnspecialisedBuiltin(b"?numeric_unary"))], [binary]],
  );
  assert_eq(names.map(|n: Bytes| natives_in(bound_in(p, n)).len()), [0, 0, 0, 0])
}

fn program_of_modules(
  sources: List<{ name: Bytes, source_text: Bytes }>,
  natives: List<Bytes>,
) -> Program / {abort.raise} =
  match analyse(parse_all(sources)) {
    Analysed(a) -> match module_context_in(a, b"m") {
      Ok(s) ->
        { source: b"", analysis: a, setting: { ..s.setting, builtins: natives }, roots: s.roots },
      Err(reason) -> panic(String::of_bytes_lossy(reason)),
    },
    _ -> panic("the program does not check"),
  }

test "a name that no import provides refers to the builtin, but an imported function with a builtin's name is called instead" {
  let names = |p: Program, root: Bytes|
    natives_in(bound_in(p, root)).map(
      |c: { name: Bytes, args: List<Arg>, uses: OperationSignature, result: Representation }|
        c.name,
    );
  let whole = program_of_modules(
    [
      { name: b"min", source_text: b"pub fn size(xs: List<Int>) -> Int = xs.len()\n" },
      {
        name: b"m",
        source_text: b"import min\nfn least(x: Int) -> Int = min(x, 1)\nfn n(xs: List<Int>) -> Int = min::size(xs)\n",
      },
    ],
    [b"min", b"List::len"],
  );
  assert_eq(names(whole, b"least"), []);
  assert(
    !bound_in(whole, b"least").any(|b: Binding| match b.value { Call(_) -> true, _ -> false }),
    None,
  );
  assert(
    {
      let f = lowered_root(whole, b"n");
      natives_in(
          f.body.fold([], |accumulator: List<Binding>, i: Instruction|
            match i {
              Let(l) -> accumulator.push({ var: l.var, value: l.value }),
              _ -> accumulator,
            }),
        )
        == []
    },
    None,
  );
  let taken = program_of_modules(
    [
      { name: b"a", source_text: b"pub fn min(x: Int, y: Int) -> Int = x\n" },
      { name: b"m", source_text: b"import a (min)\nfn least(x: Int) -> Int = min(x, 1)\n" },
    ],
    [b"min"],
  );
  assert(
    {
      let _ = lowered_root(taken, b"least");
      names(taken, b"least") == []
    },
    None,
  )
}

fn program_with_native(
  native: Bytes,
  user: Bytes,
  natives: List<Bytes>,
) -> Program / {abort.raise} = {
  let shipped = [{ name: b"std.native", source_text: native }];
  match analyse_pulling_std_with([{ name: b"m", source_text: user }], shipped, no_rows()).out {
    Analysed(a) -> match module_context_in(a, b"m") {
      Ok(s) ->
        { source: user, analysis: a, setting: { ..s.setting, builtins: natives }, roots: s.roots },
      Err(reason) -> panic(String::of_bytes_lossy(reason)),
    },
    _ -> panic("the program does not check"),
  }
}

fn with_doubled(user: Bytes, natives: List<Bytes>) -> Program / {abort.raise} =
  program_with_native(b"pub extern fn doubled(x: Int) -> Int\n", user, natives)

test "a call to a native function implemented by the runtime lowers to a function, and so does a call to a builtin on `U8`" {
  let user = b"import std.native (doubled)\nfn f() -> Int = doubled(2)\n";
  assert_eq(lowered_root(with_doubled(user, [b"doubled"]), b"f").key, Named(b"m.f"));
  let source = b"fn wrapped(a: U8, b: U8) -> U8 = wrap_add(a, b)\n";
  assert_eq(lowered_root(program_from(source), b"wrapped").key, Named(b"m.wrapped"))
}

test "an extern function of a standard library module is called by its own name, whether imported by name or through its module" {
  let user = b"import std.native (doubled)\nimport std.native as n\nfn f() -> Int = doubled(2) + n::doubled(3)\n";
  assert_eq(lowered_root(with_doubled(user, [b"doubled"]), b"f").key, Named(b"m.f"))
}

test "a standard library extern listed in the program's machine-function setting can be called, and the caller lowers to a function" {
  let p = program_with_native(
    b"pub extern fn halved(x: Int) -> Int\n",
    b"import std.native (halved)\nfn f() -> Int = halved(4)\n",
    [b"halved"],
  );
  assert(p.setting.machine.contains(b"halved"), None);
  assert_eq(lowered_root(p, b"f").key, Named(b"m.f"))
}

test "a `Secret` passed to a native function and returned from it stays an opaque handle and is never converted to its encoded bytes" {
  let p = program_with_native(
    b"pub extern fn resealed(s: Secret<Bytes>) -> Secret<String>\n",
    b"import std.native (resealed)\nfn f() -> Int = if resealed(Secret::of_bytes(b\"key\")).is_empty() { 0 } else { 1 }\n",
    [b"resealed"],
  );
  assert(p.setting.machine.contains(b"resealed"), None);
  assert_eq(lowered_root(p, b"f").key, Named(b"m.f"))
}

fn corpus() -> Bytes =
  Bytes::concat_all([
    b"fn pair(a: String, b: String) -> List<String> = [a, b]\n",
    b"fn ints(a: Int, b: Int) -> List<Int> = [a, b, a + b]\n",
    b"fn floats(x: Float) -> List<Float> = [x, x * 2.0]\n",
    b"fn flags(c: Bool) -> List<Bool> = [c, !c, true]\n",
    b"fn empty() -> List<String> = []\n",
    b"fn nested(a: String) -> List<List<String>> = [[a], []]\n",
    b"fn count(xs: List<String>) -> Int = xs.len()\n",
    b"fn size(b: Bytes) -> Int = b.len()\n",
    b"fn byte(b: Bytes, i: Int) -> Int / {abort.raise} = b.at(i)\n",
    b"fn third(b: Bytes) -> Int / {abort.raise} = b.at(3)\n",
    b"fn word(b: Bytes, i: Int) -> U32 / {abort.raise} = b.u32_le(i)\n",
    b"fn glued(a: Bytes, b: Bytes) -> Bytes = Bytes::concat_all([a, b])\n",
    b"fn all(bs: List<Bytes>) -> Bytes = Bytes::concat_all(bs)\n",
    b"fn cat(a: String, b: String) -> String = String::concat(a, b)\n",
    b"fn cut(b: Bytes, i: Int) -> Bytes / {abort.raise} = b.slice(i, 4)\n",
    b"fn measured(s: String) -> Int = s.len()\n",
    b"fn starts(s: String, p: String) -> Bool = s.starts_with(p)\n",
    b"fn found(h: Bytes, n: Bytes) -> Option<Int> = h.index_of(n)\n",
    b"fn numbers(n: Int) -> List<Int> = range(0, n)\n",
    b"fn fresh() -> Map<Int, String> = Map::new()\n",
    b"fn keys(m: Map<Int, String>) -> Int = m.len()\n",
    b"fn listed(a: Array<Int>) -> List<Int> = a.to_list()\n",
    b"fn arity(a: Array<String>) -> Int = a.len()\n",
    b"fn text(n: Int) -> String = n.to_string()\n",
    b"fn element(a: Array<String>, i: Int) -> Option<String> = a.at(i)\n",
    b"fn reserved(n: Int) -> List<String> = List::with_capacity(n)\n",
    b"fn filled(n: Int, x: Float) -> Array<Float> / {abort.raise} = Array::new(n, x)\n",
    b"fn shared(n: Int, s: String) -> Array<String> / {abort.raise} = Array::new(n, s)\n",
    b"fn replaced(a: Array<Int>, i: Int, x: Int) -> Array<Int> / {abort.raise} = a.set(i, x)\n",
    b"fn renamed(a: Array<String>, s: String) -> Array<String> / {abort.raise} = a.set(0, s)\n",
    b"fn arrayed(xs: List<Int>) -> Array<Int> = Array::of_list(xs)\n",
    b"fn decimals(xs: List<Decimal>) -> Array<Decimal> = Array::of_list(xs)\n",
    b"fn got(a: Array<Float>, i: Int) -> Float / {abort.raise} = a.get(i)\n",
    b"fn small(a: Array<U8>) -> U8 / {abort.raise} = a.get(2)\n",
    b"fn points(n: Int, p: { x: Int, y: Int }) -> Array<{ x: Int, y: Int }> / {abort.raise} = Array::new(n, p)\n",
    b"fn point_y(a: Array<{ x: Int, y: Int }>, i: Int) -> Int / {abort.raise} = a.get(i).y\n",
    b"fn maybes(xs: List<Option<String>>) -> Array<Option<String>> = Array::of_list(xs)\n",
    b"fn maybe_at(a: Array<Option<String>>, i: Int) -> Option<String> / {abort.raise} = a.get(i)\n",
    b"fn put_maybe(a: Array<Option<Int>>, x: Option<Int>) -> Array<Option<Int>> / {abort.raise} = a.set(0, x)\n",
    b"type Tagged = { name: String, n: Int }\n",
    b"fn tags(n: Int, t: Tagged) -> Array<Tagged> / {abort.raise} = Array::new(n, t)\n",
    b"fn retag(a: Array<Tagged>, t: Tagged) -> Array<Tagged> / {abort.raise} = a.set(1, t)\n",
    b"fn tag_list(ts: List<Tagged>) -> Array<Tagged> = Array::of_list(ts)\n",
    b"fn tag_at(a: Array<Tagged>, i: Int) -> Option<Tagged> = a.at(i)\n",
    b"fn columns(ts: List<Tagged>) -> Columns<Tagged> = Columns::of_list(ts)\n",
    b"fn column_new(n: Int, t: Tagged) -> Columns<Tagged> / {abort.raise} = Columns::new(n, t)\n",
    b"fn column_set(c: Columns<Tagged>, t: Tagged) -> Columns<Tagged> / {abort.raise} = c.set(0, t)\n",
    b"fn column_get(c: Columns<Tagged>, i: Int) -> Tagged / {abort.raise} = c.get(i)\n",
    b"fn column_name(c: Columns<Tagged>, i: Int) -> String / {abort.raise} = c.get(i).name\n",
    b"fn column_at(c: Columns<Tagged>, i: Int) -> Option<Tagged> = c.at(i)\n",
    b"fn column_len(c: Columns<Tagged>) -> Int = c.len()\n",
  ])

