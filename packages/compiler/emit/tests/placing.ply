import compiler.emit.emit_harness (program_of, checked)
import compiler.emit.print.destinations (destinations_of)

fn corpus() -> Bytes =
  Bytes::concat_all([
    b"type Five = { a: Int, b: Int, c: Int, d: Int, name: String, w: (Int, Int, Int, Int) }\n",
    b"type Holder = { id: Int, at: Int, to: Int, five: Five, other: Five, x: (Int, Int, Int, Int) }\n",
    b"fn five(n: Int) -> Five = { a: n, b: 1, c: 2, d: 3, name: \"x\", w: (0, 0, 0, 0) }\n",
    b"fn passed(n: Int) -> Five = five(n + 1)\n",
    b"fn bumped(f: Five) -> Five = { ..f, a: f.a + 1 }\n",
    b"fn held(n: Int) -> Holder = { id: n, at: 0, to: 0, five: five(n), other: five(n + 1), x: (0, 0, 0, 0) }\n",
    b"fn summed(n: Int) -> Int = five(n).a + five(n).d\n",
    b"fn listed(n: Int) -> List<Five> = [five(n)]\n",
    b"fn lent(n: Int) -> Int = bumped(five(n)).a\n",
    b"type Pair = { left: Five, right: Five, at: Int, to: Int, n: Int, x: (Int, Int, Int, Int) }\n",
    b"fn twice(n: Int) -> Pair = { let f = five(n); { left: f, right: f, at: 0, to: 0, n: n, x: (0, 0, 0, 0) } }\n",
  ])

test "a returned record is written to the destination the caller provides, and a result that is only read stays in the callee's frame" {
  match program_of(corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) ->
      assert_eq(
        [b"five", b"passed", b"bumped", b"held", b"summed", b"listed", b"lent", b"twice"].map(
          |n: Bytes|
            match checked(p, n) {
              Ok(f) -> {
                let placing = destinations_of(f);
                Ok({
                  destination_passing: placing.destination_passing,
                  results: placing.results.len(),
                  slots: placing.slots.len(),
                  moved: placing.moving.len(),
                })
              },
              Err(reason) -> Err(reason),
            },
        ),
        [
          Ok({ destination_passing: true, results: 1, slots: 0, moved: 0 }),
          Ok({ destination_passing: true, results: 1, slots: 0, moved: 0 }),
          Ok({ destination_passing: true, results: 1, slots: 0, moved: 0 }),
          Ok({ destination_passing: true, results: 1, slots: 2, moved: 2 }),
          Ok({ destination_passing: false, results: 0, slots: 2, moved: 0 }),
          Ok({ destination_passing: false, results: 0, slots: 0, moved: 0 }),
          Ok({ destination_passing: false, results: 0, slots: 1, moved: 0 }),
          Ok({ destination_passing: true, results: 1, slots: 1, moved: 0 }),
        ],
      ),
  }
}
