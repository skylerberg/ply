import compiler.emit.typed_ir (Instruction, Block, Let, Do, Allocate, Increment, Reset, Free, If,
                               Case, Match, Loop, Handle, Function, Rvalue, Get, Take,
                               OperationCall, OfStrings, OfContainers, PayloadPath,
                               InlineRecordPath, AsInt, AsAddress, RecordAllocation,
                               FieldInitializer, BuiltInPlace, Update)
import compiler.emit.typed_ir.containers (CopyOut, Retain)
import compiler.emit.emit_harness (program_of, lowered_root, checked, printed_by_ir)
import compiler.emit.own (insert_reference_counts)
import compiler.emit.verify (ownership_fault)
import compiler.emit.print.count_functions (release_function, call_start)

test "a lowered function with no reference counting is unchanged by `insert_reference_counts` and passes the ownership check" {
  let source = Bytes::concat_all([
    b"fn total(n: Int, acc: Int) -> Int = if n <= 0 { acc } else { total(n - 1, acc + n) }\n",
    b"fn pick(c: Bool, a: Float, b: Float) -> Float = if c { a * b } else { b }\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let unchanged = |name: Bytes| {
        let form = lowered_root(p, name);
        let o = insert_reference_counts(form);
        Ok(o.body == form.body && ownership_fault(o) == None)
      };
      assert_eq(unchanged(b"total"), Ok(true));
      assert_eq(unchanged(b"pick"), Ok(true))
    },
  }
}

fn corpus() -> Bytes =
  Bytes::concat_all([
    b"type P = { name: String, n: Int }\n",
    b"type T = | Leaf | Node(T, Int, T)\n",
    b"fn rename(p: P, s: String) -> P = { ..p, name: s }\n",
    b"fn bump(p: P) -> P = { ..p, n: p.n + 1 }\n",
    b"fn label(p: P) -> String = p.name\n",
    b"fn size(t: T) -> Int = match t { Leaf -> 0, Node(l, _, r) -> size(l) + 1 + size(r) }\n",
    b"fn mirror(t: T) -> T = match t { Leaf -> Leaf, Node(l, v, r) -> Node(mirror(r), v, mirror(l)) }\n",
    b"fn first(xs: List<String>) -> String = match xs.at(0) { Some(s) -> s, None -> \"\" }\n",
    b"fn twice(s: String) -> String = s ++ s\n",
    b"fn pick(c: Bool, a: String, b: String) -> String = if c { a } else { b }\n",
    b"fn applied(f: (String) -> String, s: String) -> String = f(f(s))\n",
    b"fn adder(s: String) -> (String) -> String = |t: String| s ++ t\n",
    b"fn count(xs: List<String>) -> Int = xs.fold(0, |n: Int, _: String| n + 1)\n",
    b"fn grow(xs: List<String>, s: String) -> List<String> = xs.push(s)\n",
    b"fn nested(c: Bool, d: Bool) -> Int = if c { if d { 1 } else { 2 } } else { 3 }\n",
    b"fn looked(a: Option<Int>, b: Option<Int>) -> Int = match a { Some(x) -> match b { Some(y) -> x + y, None -> x }, None -> 0 }\n",
    b"fn sum_both(a: Option<Int>, b: Option<Int>) -> Int = { let Some(x) = a else { 0 }; let Some(y) = b else { x }; x + y }\n",
    b"fn both(c: Bool, o: Option<Int>) -> Bool = c && (o == Some(1))\n",
    b"fn kept_in(o: Option<String>, d: Bool) -> String = match o { Some(s) -> if d { s } else { \"\" }, None -> \"\" }\n",
  ])

fn corpus_names() -> List<Bytes> =
  [
    b"rename",
    b"bump",
    b"label",
    b"size",
    b"mirror",
    b"first",
    b"twice",
    b"pick",
    b"applied",
    b"adder",
    b"count",
    b"grow",
    b"nested",
    b"looked",
    b"sum_both",
    b"both",
    b"kept_in",
  ]

fn instructions(b: Block) -> List<Instruction> =
  b.fold([], |accumulator: List<Instruction>, i: Instruction|
    accumulator.push(i).concat(match i {
      If(x) -> instructions(x.then).concat(instructions(x.otherwise)),
      Case(c) ->
        c.arms.fold(
          instructions(c.rest),
          |a: List<Instruction>, arm: { when: Int, body: Block }| a.concat(instructions(arm.body)),
        ),
      Match(m) ->
        m.arms.fold(instructions(m.rest), |a: List<Instruction>, arm: Block|
          a.concat(instructions(arm))),
      Loop(l) -> instructions(l.body),
      Handle(h) -> instructions(h.body),
      _ -> [],
    }))

test "every function in the ownership test program lowers and passes the ownership check, and reading a value out of another adds no reference count" {
  match program_of(corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      assert_eq(
        corpus_names().fold([], |accumulator: List<{ name: Bytes, reason: Bytes }>, n: Bytes|
          match checked(p, n) {
            Ok(_) -> accumulator,
            Err(reason) -> accumulator.push({ name: n, reason: reason }),
          }),
        [],
      );
      let incs = |n: Bytes|
        match checked(p, n) {
          Ok(f) ->
            instructions(f.body).filter(|i: Instruction|
              match i { Increment(_) -> true, _ -> false }).len(
            ),
          Err(_) -> 0 - 1,
        };
      assert_eq([b"rename", b"bump", b"label", b"first", b"pick", b"size", b"mirror"].map(incs), [
        0,
        0,
        0,
        1,
        0,
        0,
        0,
      ]);
      let resets = match checked(p, b"mirror") {
        Ok(f) ->
          instructions(f.body).filter(|i: Instruction|
            match i { Reset(_) -> true, _ -> false }).len(
          ),
        Err(_) -> 0 - 1,
      };
      assert_eq(resets, 1)
    },
  }
}

fn projection_corpus() -> Bytes =
  Bytes::concat_all([
    b"type Cases = { binder: String, label: String }\n",
    b"type TestDef = { name: String, cases: Option<Cases>, body: String, flag: Bool, n: Int, m: Int }\n",
    b"type Wrap = { o: Option<Option<Cases>>, a: Int, b: Int, c: Int, d: Int }\n",
    b"effect amb {\n  read flip() -> Bool\n}\n",
    b"fn dump_test(t: TestDef) -> List<String> = [t.name, t.body, match t.cases { Some(c) -> c.binder ++ c.label, None -> \"\" }]\n",
    b"fn twice_in(w: Wrap) -> String = match w.o { Some(Some(c)) -> c.binder, _ -> \"\" }\n",
    b"fn in_lambda(t: TestDef, xs: List<Int>) -> List<String> = xs.map(|_: Int| match t.cases { Some(c) -> c.binder, None -> \"\" })\n",
    b"fn in_loop(t: TestDef, n: Int) -> String / {abort.raise} = iterate(0, n + 1, |i: Int| if i >= n { Stop(match t.cases { Some(c) -> c.label, None -> \"\" }) } else { Continue(i + 1) })\n",
    b"fn in_handle(t: TestDef) -> String = handle { if amb.flip() { match t.cases { Some(c) -> c.binder, None -> \"\" } } else { \"\" } } with { amb.flip() resume k -> k(true) }\n",
    b"type Ty = | TFn({ params: List<Int>, ret: Int }) | TInt\n",
    b"type Q = { name: String, ty: Option<Ty> }\n",
    b"fn takes(p: Option<Q>) -> Option<Int> = match p { Some(x) -> match x.ty { Some(TFn(f)) -> Some(f.params.len()), _ -> None }, None -> None }\n",
    b"fn takes_both(p: Option<Q>) -> Int = match p { Some(x) -> match x.ty { Some(TFn(f)) -> f.params.len() + f.ret, _ -> 0 }, None -> 0 }\n",
    b"fn takes_each(ps: List<Option<Q>>) -> List<Int> = ps.map(|p: Option<Q>| match p { Some(x) -> match x.ty { Some(TFn(f)) -> f.params.len(), _ -> 0 }, None -> 0 })\n",
    b"fn params_of(p: Option<Q>) -> List<Int> = match p { Some(x) -> match x.ty { Some(TFn(f)) -> f.params, _ -> [] }, None -> [] }\n",
  ])

fn failure_corpus() -> Bytes =
  Bytes::concat_all([
    b"fn g(n: Int) -> Int / {abort.raise} = if n > 3 { panic(\"big\") } else { n }\n",
    b"fn grown(xs: List<Int>, n: Int) -> List<Int> / {abort.raise} = xs.push(g(n) + g(n + 1))\n",
  ])

test "a failure releases the list it owns before exiting, and all such failures jump to the same cleanup code" {
  match program_of(failure_corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match printed_by_ir(p, b"grown") {
      Err(reason) -> assert_eq(reason, b""),
      Ok(t) -> {
        assert_eq(t.split(call_start(release_function(), [b"ctx", b"p0"])).len() - 1, 1);
        let targets = t.split(b"goto ").drop(1).map(|s: Bytes|
          match s.index_of(b";") { Some(at) -> s.slice(0, at), None -> s });
        assert(targets.len() >= 3 && targets.all(|x: Bytes| Some(x) == targets.at(0)))
      },
    },
  }
}

test "reading a field of a payload that came from a parameter's field passes the ownership check, because the parameter stays alive until that read" {
  match program_of(projection_corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) ->
      assert_eq(
        [
          b"dump_test",
          b"twice_in",
          b"in_lambda",
          b"in_loop",
          b"in_handle",
          b"takes",
          b"takes_both",
          b"takes_each",
          b"params_of",
        ].fold([], |accumulator: List<{ name: Bytes, reason: Bytes }>, n: Bytes|
          match checked(p, n) {
            Ok(_) -> accumulator,
            Err(reason) -> accumulator.push({ name: n, reason: reason }),
          }),
        [],
      ),
  }
}

fn inline_record_corpus() -> Bytes =
  Bytes::concat_all([
    b"type Five = { a: Int, b: Int, c: Int, d: Int, name: String, w: (Int, Int, Int, Int) }\n",
    b"type Holder = { id: Int, at: Int, to: Int, five: Five, other: Five, x: (Int, Int, Int, Int) }\n",
    b"type Outer = { h: Holder, k: Int, a: Int, b: Int, c: Int, x: (Int, Int, Int, Int) }\n",
    b"fn nudged(h: Holder, n: Int) -> Holder = { ..h, five: { ..h.five, a: n } }\n",
    b"fn deeper(o: Outer, n: Int) -> Outer = { ..o, h: { ..o.h, five: { ..o.h.five, a: n } } }\n",
    b"fn reads(h: Holder) -> Int = h.five.a + h.other.d\n",
    b"fn hands(h: Holder) -> List<Five> = [h.five, h.other]\n",
    b"fn outlives(h: Holder, n: Int) -> Five = { let f = h.five; let g = { ..h, id: n }; if g.id > f.a { f } else { g.other } }\n",
    b"fn constant() -> Holder = { id: 1, at: 0, to: 0, five: { a: 1, b: 2, c: 3, d: 4, name: \"x\", w: (0, 0, 0, 0) }, other: { a: 5, b: 6, c: 7, d: 8, name: \"y\", w: (0, 0, 0, 0) }, x: (0, 0, 0, 0) }\n",
    b"fn constant_case() -> Option<Five> = Some({ a: 1, b: 2, c: 3, d: 4, name: \"x\", w: (0, 0, 0, 0) })\n",
    b"fn wrapped(h: Holder) -> Option<Five> = Some(h.five)\n",
    b"fn erred(h: Holder) -> Result<Int, Five> = Err(h.other)\n",
    b"fn rewrapped(h: Holder) -> { a: Five, b: Five, n: Int, at: Int, to: Int, x: (Int, Int, Int, Int) } = { a: h.five, b: h.other, n: h.id, at: h.at, to: h.to, x: (0, 0, 0, 0) }\n",
    b"fn moved_on(h: Holder) -> Holder = { ..h, five: h.other }\n",
    b"fn nested(n: Int) -> Holder = { id: n, at: 0, to: 0, five: { a: n, b: 1, c: 2, d: 3, name: \"x\", w: (0, 0, 0, 0) }, other: { a: 1, b: n, c: 3, d: 4, name: \"y\", w: (0, 0, 0, 0) }, x: (0, 0, 0, 0) }\n",
  ])

test "a record literal containing record literals allocates one block, with each inner record built inside it" {
  match program_of(inline_record_corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match checked(p, b"nested") {
      Err(reason) -> assert_eq(reason, b""),
      Ok(f) -> {
        let makes = instructions(f.body).fold(
          [],
          |accumulator: List<List<FieldInitializer>>, i: Instruction|
            match i {
              Let(l) -> match l.value {
                Allocate(m) -> match m.made {
                  RecordAllocation(shape) -> accumulator.push(shape),
                  _ -> accumulator,
                },
                _ -> accumulator,
              },
              _ -> accumulator,
            },
        );
        assert_eq(makes.len(), 1);
        assert_eq(
          makes.get(0).filter(|s: FieldInitializer|
            match s { BuiltInPlace(_) -> true, _ -> false }).len(
          ),
          2,
        )
      },
    },
  }
}

test "updating an inline record inside an update of its containing record is a single update that writes into the inline record's storage" {
  match program_of(inline_record_corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) ->
      assert_eq(
        [b"nudged", b"deeper"].map(|n: Bytes|
          match checked(p, n) {
            Ok(f) ->
              Ok(
                instructions(f.body).fold(
                  { updates: 0, places: 0 },
                  |accumulator: { updates: Int, places: Int }, i: Instruction|
                    match i {
                      Let(l) -> match l.value {
                        Update(_) -> { ..accumulator, updates: accumulator.updates + 1 },
                        Get(g) -> match g.path {
                          InlineRecordPath(_) -> { ..accumulator, places: accumulator.places + 1 },
                          _ -> accumulator,
                        },
                        _ -> accumulator,
                      },
                      _ -> accumulator,
                    },
                ),
              ),
            Err(reason) -> Err(reason),
          }),
        [Ok({ updates: 1, places: 0 }), Ok({ updates: 1, places: 0 })],
      ),
  }
}

fn place_reads(b: Block) -> { retained: Int, taken: Int } =
  instructions(b).fold(
    { retained: 0, taken: 0 },
    |accumulator: { retained: Int, taken: Int }, i: Instruction|
      match i {
        Let(l) -> match l.value {
          OperationCall(o) -> if o.operation == OfContainers(Retain) {
            { ..accumulator, retained: accumulator.retained + 1 }
          } else { accumulator },
          Take(t) -> match t.path {
            InlineRecordPath(_) -> { ..accumulator, taken: accumulator.taken + 1 },
            _ -> accumulator,
          },
          _ -> accumulator,
        },
        _ -> accumulator,
      },
  )

test "reading an inline record out of an allocation with no other users moves it out, and takes a reference count only where the record is used again" {
  match program_of(inline_record_corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) ->
      assert_eq(
        [
          b"reads",
          b"hands",
          b"outlives",
          b"constant",
          b"constant_case",
          b"wrapped",
          b"erred",
          b"rewrapped",
          b"moved_on",
        ].map(|n: Bytes|
          match checked(p, n) { Ok(f) -> Ok(place_reads(f.body)), Err(reason) -> Err(reason) }),
        [
          Ok({ retained: 0, taken: 0 }),
          Ok({ retained: 0, taken: 2 }),
          Ok({ retained: 1, taken: 1 }),
          Ok({ retained: 0, taken: 0 }),
          Ok({ retained: 0, taken: 0 }),
          Ok({ retained: 0, taken: 1 }),
          Ok({ retained: 0, taken: 1 }),
          Ok({ retained: 0, taken: 0 }),
          Ok({ retained: 0, taken: 0 }),
        ],
      ),
  }
}

fn buffer_corpus() -> Bytes =
  Bytes::concat_all([
    b"type S = { out: Bytes, n: Int }\n",
    b"type W = { out: Bytes, n: Int, a: Int, b: Int }\n",
    b"type T = | T(Bytes, Int)\n",
    b"fn ctor(t: T, fuel: Int) -> Bytes = match t { T(out, n) -> if n <= 0 || fuel <= 0 { out } else { ctor(T(out ++ b\"x\", n - 1), fuel - 1) } }\n",
    b"fn iterated(n: Int) -> Bytes / {abort.raise} = iterate({ out: b\"\", n: n }, n + 1, |s: S| if s.n <= 0 { Stop(s.out) } else { Continue({ out: s.out ++ b\"x\", n: s.n - 1 }) })\n",
    b"fn widened(n: Int) -> Bytes / {abort.raise} = iterate({ out: b\"\", n: n, a: 0, b: 0 }, n + 1, |s: W| if s.n <= 0 { Stop(s.out) } else { Continue({ out: s.out ++ b\"x\", n: s.n - 1, a: s.a, b: s.b }) })\n",
    b"fn guarded(t: T, k: Int) -> Bytes = match t { T(out, n) if n > k -> out ++ b\"y\", T(out, _) -> out }\n",
    b"type G = { out: Bytes, n: Int, a: Int, b: Int, c: Int }\n",
    b"fn regrown(g: G) -> G = { let out = g.out ++ b\"x\"; { ..g, out: out } }\n",
    b"fn branched(g: G, stop: Bool) -> G / {abort.raise} = if stop { { ..g, n: 0 } } else { let out = g.out; { ..g, out: out ++ out.slice(0, 1) } }\n",
    b"fn kept(g: G) -> { g: G, out: Bytes } = { let out = g.out; { g: { ..g, n: 1 }, out: out } }\n",
    b"fn boxed(n: Int) -> Bytes / {abort.raise} = iterate({ out: b\"\", n: n, a: 0, b: 0, c: 0 }, n + 1, |s: G| if s.n <= 0 { Stop(s.out) } else { Continue({ ..s, out: s.out ++ b\"x\", n: s.n - 1 }) })\n",
  ])

fn reuse_of(b: Block) -> { incs: Int, resets: Int, reused: Int } = {
  let all = instructions(b);
  {
    incs: all.filter(|i: Instruction| match i { Increment(_) -> true, _ -> false }).len(),
    resets: all.filter(|i: Instruction| match i { Reset(_) -> true, _ -> false }).len(),
    reused: all.filter(|i: Instruction|
      match i {
        Let(l) -> match l.value { Allocate(m) -> m.reuse != None, _ -> false },
        _ -> false,
      }).len(
    ),
  }
}

test "appending to a buffer through its only reference takes no reference count and reuses the buffer's storage" {
  match program_of(buffer_corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let counts = |n: Bytes|
        match checked(p, n) { Ok(f) -> Ok(reuse_of(f.body)), Err(reason) -> Err(reason) };
      assert_eq(counts(b"ctor"), Ok({ incs: 0, resets: 0, reused: 0 }));
      assert_eq(counts(b"iterated"), Ok({ incs: 0, resets: 0, reused: 0 }));
      assert_eq(counts(b"widened"), Ok({ incs: 0, resets: 0, reused: 0 }));
      assert_eq(counts(b"regrown").map(|c: { incs: Int, resets: Int, reused: Int }| c.incs), Ok(0));
      assert_eq(
        counts(b"branched").map(|c: { incs: Int, resets: Int, reused: Int }| c.incs),
        Ok(0),
      );
      assert_eq(counts(b"kept").map(|c: { incs: Int, resets: Int, reused: Int }| c.incs), Ok(1));
      assert_eq(counts(b"boxed").map(|c: { incs: Int, resets: Int, reused: Int }| c.incs), Ok(0));
      match checked(p, b"guarded") { Ok(_) -> (), Err(reason) -> assert_eq(reason, b"") }
    },
  }
}

fn tree_corpus() -> Bytes =
  Bytes::concat_all([
    b"type T = | Leaf | Node(T, Int, T)\n",
    b"fn insert(t: T, k: Int) -> T = match t { Leaf -> Node(Leaf, k, Leaf), Node(l, x, r) -> if k < x { Node(insert(l, k), x, r) } else { Node(l, x, insert(r, k)) } }\n",
    b"fn prune(t: T, k: Int) -> T = match t { Leaf -> Leaf, Node(l, x, r) -> if x == k { Leaf } else { Node(prune(l, k), x, prune(r, k)) } }\n",
  ])

test "a tree node that a function destructures and rebuilds with the same shape is rebuilt in the same allocation" {
  match program_of(tree_corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let counts = |n: Bytes|
        match checked(p, n) {
          Ok(f) -> {
            let all = instructions(f.body);
            Ok({
              resets: all.filter(|i: Instruction| match i { Reset(_) -> true, _ -> false }).len(),
              reused: all.filter(|i: Instruction|
                match i {
                  Let(l) -> match l.value { Allocate(m) -> m.reuse != None, _ -> false },
                  _ -> false,
                }).len(
              ),
              freed: all.filter(|i: Instruction| match i { Free(_) -> true, _ -> false }).len(),
            })
          },
          Err(reason) -> Err(reason),
        };
      assert_eq(counts(b"insert"), Ok({ resets: 1, reused: 2, freed: 0 }));
      assert_eq(counts(b"prune"), Ok({ resets: 1, reused: 1, freed: 1 }))
    },
  }
}

fn bytes_corpus() -> Bytes =
  Bytes::concat_all([
    b"fn first(b: Bytes, i: Int) -> Int / {abort.raise} = b.at(i)\n",
    b"fn starts(a: String, b: String) -> Bool = a.starts_with(b)\n",
    b"fn holds(a: String, b: String) -> Bool = a.contains(b)\n",
    b"fn cut(b: Bytes, i: Int, j: Int) -> Bytes / {abort.raise} = b.slice(i, j)\n",
    b"fn digested(b: Bytes) -> Bytes = b.blake3()\n",
  ])

fn broken_in(b: Block, broken: (Instruction) -> Option<Instruction>) -> Block =
  b.map(|i: Instruction|
    match broken(i) {
      Some(x) -> x,
      None -> match i {
        If(x) ->
          If({ ..x, then: broken_in(x.then, broken), otherwise: broken_in(x.otherwise, broken) }),
        Case(c) ->
          Case({
            ..c,
            arms: c.arms.map(|a: { when: Int, body: Block }|
              { when: a.when, body: broken_in(a.body, broken) }),
            rest: broken_in(c.rest, broken),
          }),
        Match(m) ->
          Match({
            arms: m.arms.map(|a: Block| broken_in(a, broken)),
            rest: broken_in(m.rest, broken),
          }),
        Loop(l) -> Loop({ ..l, body: broken_in(l.body, broken) }),
        Handle(h) -> Handle({ ..h, body: broken_in(h.body, broken) }),
        _ -> i,
      },
    })

fn rule_violation(i: Instruction) -> Option<Instruction> =
  match i {
    Let(l) -> match l.value {
      OperationCall(o) -> match o.operation {
        OfStrings(_) ->
          Some(
            Let({
              ..l,
              value: OperationCall({
                ..o,
                uses: { ..o.uses, takes: o.uses.takes.map(|t: Bool| !t), owned: !o.uses.owned },
              }),
            }),
          ),
        OfContainers(CopyOut) ->
          Some(Let({ ..l, value: OperationCall({ ..o, uses: { ..o.uses, owned: false } }) })),
        _ -> None,
      },
      Get(g) -> if g.path == PayloadPath {
        Some(Let({ ..l, var: { ..l.var, representation: AsInt } }))
      } else { None },
      _ -> None,
    },
    Do(d) -> match d.value {
      OperationCall(o) -> match o.operation {
        OfStrings(_) ->
          Some(
            Do({ ..d, value: OperationCall({ ..o, uses: { ..o.uses, owned: !o.uses.owned } }) }),
          ),
        _ -> None,
      },
      _ -> None,
    },
    _ -> None,
  }

test "bytes read through an address, operated on and returned by a marshalling call pass the ownership check, and it rejects every deliberately broken copy" {
  match program_of(bytes_corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let names = [b"first", b"starts", b"holds", b"cut", b"digested"];
      let counted = names.fold([], |accumulator: List<{ name: Bytes, f: Function }>, n: Bytes|
        match checked(p, n) {
          Ok(f) -> accumulator.push({ name: n, f: f }),
          Err(reason) -> panic(String::of_bytes_lossy(n.concat(b": ").concat(reason))),
        });
      assert_eq(counted.len(), names.len());
      assert_eq(
        counted.filter(|c: { name: Bytes, f: Function }| {
          let broken = broken_in(c.f.body, rule_violation);
          broken == c.f.body || ownership_fault({ ..c.f, body: broken }) == None
        }).map(|c: { name: Bytes, f: Function }| c.name),
        [],
      )
    },
  }
}

fn inline_shape_corpus() -> Bytes =
  Bytes::concat_all([
    b"type Five = { a: Int, b: Int, c: Int, d: Int, name: String, w: (Int, Int, Int, Int) }\n",
    b"type Holder = { id: Int, at: Int, to: Int, five: Five, other: Five, x: (Int, Int, Int, Int) }\n",
    b"type Ran = { ok: Bool, run: Holder }\n",
    b"fn opt_read(o: Option<Five>) -> Int = match o { Some(f) -> f.a, None -> 0 }\n",
    b"fn opt_keep(o: Option<Five>) -> List<Five> = match o { Some(f) -> [f], None -> [] }\n",
    b"fn opt_update(o: Option<Five>) -> Option<Five> = match o { Some(f) -> Some({ ..f, a: 1 }), None -> None }\n",
    b"fn opt_two(o: Option<Five>, p: Option<Five>, z: Five) -> Five = match o { Some(f) -> match p { Some(g) -> { ..g, a: max(f.a, g.a) }, None -> f }, None -> z }\n",
    b"fn chain(h: Holder) -> Holder = { let g = { ..h, id: 2 }; { ..g, five: { ..g.five, a: h.five.a } } }\n",
    b"fn captured(h: Holder) -> List<Int> = [1, 2].map(|x: Int| x + h.five.a)\n",
    b"fn folded_holder(xs: List<Int>, h: Holder) -> Holder = xs.fold(h, |s: Holder, x: Int| { ..s, id: s.id + x })\n",
    b"fn nested_update(t: Ran) -> Holder = { ..t.run, id: t.run.id + 1 }\n",
    b"fn given_on(t: Ran) -> List<Holder> = [t.run, { ..t.run, id: 0 }]\n",
    b"fn kept_both(o: Option<Holder>, t: Ran) -> Holder = match o { Some(r) -> if t.ok { { ..t.run, five: r.five } } else { r }, None -> t.run }\n",
  ])

test "inline records read, copied and updated inside options, records and closure captures pass the ownership check" {
  match program_of(inline_shape_corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) ->
      assert_eq(
        [
          b"opt_read",
          b"opt_keep",
          b"opt_update",
          b"opt_two",
          b"chain",
          b"captured",
          b"folded_holder",
          b"nested_update",
          b"given_on",
          b"kept_both",
        ].fold([], |accumulator: List<Bytes>, n: Bytes|
          match checked(p, n) {
            Ok(_) -> accumulator,
            Err(reason) -> accumulator.push(n.concat(b": ").concat(reason)),
          }),
        [],
      ),
  }
}
