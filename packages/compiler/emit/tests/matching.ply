import compiler.check.types (Type, VariableType, int_type, list_type)
import compiler.syntax.parsing (Span, dummy_span)
import compiler.syntax.expressions (Expression, BlockExpression, LetStatement, expression_span)
import compiler.syntax.items (Item, FunctionItem, parse)
import compiler.syntax.node_ids (numbered)
import compiler.emit.code (CodeListPattern, CodeBindingPattern)
import compiler.emit.keys (Named)
import compiler.emit.typed_ir (Representation, AsInt, AsFixed, AsWord, AsFloat, AsSum, AsListView,
                               Variable, VariableOperand, BoolOperand, Primitive, Get, CasePath,
                               LeafPath, Instruction, Let, Assign, If, Case, Match, Miss, Fail,
                               NoMatchingArm, LetMismatch, Block, Test, TagTest, IntTest, RangeTest,
                               LengthTest, OperationCall, OfContainers)
import compiler.emit.typed_ir.containers (ItemAt)
import compiler.emit.lower.base (initial_lowering)
import compiler.emit.lower.calling (context_of)
import compiler.emit.lower.matching (arm_start)
import compiler.emit.emit_harness (program_of, lowered_root, build_failures, printed_in)
import compiler.emit.own (insert_reference_counts)
import compiler.emit.verify (ownership_fault)
import compiler.emit.pieces (pieces_text)

fn param_of(source: Bytes, name: Bytes, i: Int) -> Variable / {abort.raise} =
  match program_of(source) {
    Err(reason) -> panic(String::of_bytes_lossy(reason)),
    Ok(p) -> {
      let f = lowered_root(p, name);
      f.params.get(i)
    },
  }

fn is_sum(r: Representation) -> Bool = match r { AsSum(_) -> true, _ -> false }

fn body_of(source: Bytes, name: Bytes) -> Result<Block, Bytes> / {abort.raise} =
  match program_of(source) {
    Err(reason) -> Err(reason),
    Ok(p) -> {
      let f = lowered_root(p, name);
      Ok(f.body)
    },
  }

fn span_in(source: Bytes, name: Bytes, pick: (Expression) -> Span) -> Span / {abort.raise} =
  parse(source).node.items.fold(dummy_span, |accumulator: Span, item: Item|
    match numbered(item) {
      FunctionItem(d) -> if d.name.name == name { pick(d.body) } else { accumulator },
      _ -> accumulator,
    })

fn arms_of(body: Block) -> List<Block> =
  body.fold([], |accumulator: List<Block>, i: Instruction|
    match i { Match(m) -> if accumulator == [] { m.arms } else { accumulator }, _ -> accumulator })

fn opening_case(arm: Block) -> Option<{ test: Test, when: Int, body: Block }> =
  match arm.at(0) {
    Some(Case(c)) -> match c.arms.at(0) {
      Some(a) -> Some({ test: c.test, when: a.when, body: a.body }),
      None -> None,
    },
    _ -> None,
  }

fn case_read(i: Instruction) -> Option<{ of: Variable, case: Int }> =
  match i {
    Let(l) -> match l.value {
      Get(g) -> match g.path {
        CasePath(c) -> Some({ of: g.of, case: c.case }),
        _ -> Some({ of: g.of, case: 0 - 1 }),
      },
      _ -> None,
    },
    _ -> None,
  }

fn first_case(
  b: Block,
) -> Option<{ on: Variable, test: Test, arms: List<{ when: Int, body: Block }>, rest: Block }> =
  b.fold(
    None,
    |accumulator: Option<{ on: Variable, test: Test, arms: List<{ when: Int, body: Block }>, rest: Block }>, i: Instruction|
      match accumulator {
        Some(_) -> accumulator,
        None -> match i { Case(c) -> Some(c), _ -> None },
      },
  )

fn printed_of(source: Bytes, name: Bytes) -> Result<Bytes, Bytes> / {abort.raise} =
  match program_of(source) {
    Err(reason) -> Err(reason),
    Ok(p) -> {
      let f = lowered_root(p, name);
      Ok(pieces_text(printed_in(p, f).pieces))
    },
  }

test "integer literals and ranges are each tested in their own `Case`, and an arm that does not match falls through to the next arm" {
  let source = b"fn digit(n: Int) -> Int = match n { 0 -> 10, 1..=9 -> n, _ -> 99 }\n";
  let matched = span_in(source, b"digit", expression_span);
  match body_of(source, b"digit") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) -> {
      assert_eq(
        arms_of(body).map(|a: Block|
          opening_case(a).map(|o: { test: Test, when: Int, body: Block }| o.test)),
        [Some(IntTest([0])), Some(RangeTest({ lo: 1, hi: 9 })), None],
      );
      assert(
        arms_of(body).all(|a: Block|
          match a.at(0) { Some(Case(c)) -> c.rest == [Miss], _ -> true }),
      );
      assert(
        body.any(|i: Instruction|
          match i {
            Match(m) ->
              m.rest == [Fail({ reason: NoMatchingArm, at: matched, resource: [], unwind: [] })],
            _ -> false,
          }),
      )
    },
  }
}

test "matching a `Bool` or fixed-width integer compares integers, and matching a constant subject gives the same integer comparisons" {
  match body_of(b"fn flag(b: Bool) -> Int = match b { true -> 1, false -> 0 }\n", b"flag") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) ->
      assert_eq(
        arms_of(body).map(|a: Block|
          opening_case(a).map(|o: { test: Test, when: Int, body: Block }| o.test)),
        [Some(IntTest([1])), Some(IntTest([0]))],
      ),
  };
  match body_of(
      b"fn small(n: U8) -> Int = match n { 255u8 -> 1, 0u8..=9u8 -> 2, _ -> 0 }\n",
      b"small",
    ) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) -> {
      assert_eq(
        arms_of(body).map(|a: Block|
          opening_case(a).map(|o: { test: Test, when: Int, body: Block }| o.test)),
        [Some(IntTest([255])), Some(RangeTest({ lo: 0, hi: 9 })), None],
      );
      assert_eq(
        match arms_of(body).at(0) { Some([Case(c)]) -> Some(c.on.representation), _ -> None },
        Some(AsFixed({ bits: 8, signed: false })),
      )
    },
  };
  match body_of(b"fn seven() -> Int = match 7 { 8 -> 1, 7 -> 2, _ -> 0 }\n", b"seven") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) ->
      assert_eq(
        arms_of(body).map(|a: Block|
          match a.at(0) {
            Some(If(x)) -> Some({ cond: x.cond, otherwise: x.otherwise }),
            _ -> None,
          }),
        [
          Some({ cond: BoolOperand(false), otherwise: [Miss] }),
          Some({ cond: BoolOperand(true), otherwise: [Miss] }),
          None,
        ],
      ),
  }
}

test "a guard is tested inside its arm's pattern test, and a guard that is false falls through to the next arm" {
  let source = b"fn guarded(n: Int, even: Bool) -> Int = match n { 0..=9 if even -> 1, _ -> 0 }\n";
  let even = param_of(source, b"guarded", 1);
  match body_of(source, b"guarded") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) -> {
      let arms = arms_of(body);
      assert_eq(
        arms.map(|a: Block|
          opening_case(a).map(|o: { test: Test, when: Int, body: Block }| o.test)),
        [Some(RangeTest({ lo: 0, hi: 9 })), None],
      );
      let guard = match match arms.at(0) { Some(a) -> opening_case(a), None -> None } {
        Some(o) -> match o.body.at(0) {
          Some(If(x)) -> Some({ cond: x.cond, otherwise: x.otherwise }),
          _ -> None,
        },
        None -> None,
      };
      assert_eq(guard, Some({ cond: VariableOperand(even), otherwise: [Miss] }))
    },
  };
  match body_of(b"fn either(n: Int) -> Int = match n { 1 | 2 -> 1, _ -> 0 }\n", b"either") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) ->
      assert_eq(
        arms_of(body).map(|a: Block|
          opening_case(a).map(|o: { test: Test, when: Int, body: Block }| o.test)),
        [Some(IntTest([1])), Some(IntTest([2])), None],
      ),
  }
}

test "a constructor pattern tests the constructor's index within its sum, and reads its arguments from the matched case" {
  let source = Bytes::concat_all([
    b"type Shape = | Circle(Float) | Rect(Int, Int) | Dot\n",
    b"fn area(s: Shape) -> Int = match s { Circle(_) -> 1, Rect(w, h) -> w * h, Dot -> 0 }\n",
  ]);
  match body_of(source, b"area") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) -> {
      let opened = arms_of(body).map(opening_case);
      let names = [b"m.Circle", b"m.Rect", b"m.Dot"];
      assert_eq(
        opened.map(|o: Option<{ test: Test, when: Int, body: Block }>|
          match o { Some(x) -> Some({ test: x.test, when: x.when }), None -> None }),
        [
          Some({ test: TagTest(names), when: 0 }),
          Some({ test: TagTest(names), when: 1 }),
          Some({ test: TagTest(names), when: 2 }),
        ],
      );
      assert_eq(
        opened.map(|o: Option<{ test: Test, when: Int, body: Block }>|
          match o {
            Some(x) ->
              x.body.map(case_read).filter(|r: Option<{ of: Variable, case: Int }>| r != None).len(
              ),
            None -> 0 - 1,
          }),
        [0, 2, 0],
      );
      let reads = match opened.at(1) { Some(Some(x)) -> x.body.take(2).map(case_read), _ -> [] };
      assert_eq(
        reads.map(|r: Option<{ of: Variable, case: Int }>|
          match r {
            Some(x) -> Some({ of: x.of.id, sum: is_sum(x.of.representation), case: x.case }),
            None -> None,
          }),
        [Some({ of: 0, sum: true, case: 1 }), Some({ of: 0, sum: true, case: 1 })],
      )
    },
  }
}

test "a constructor pattern's argument types come from the matched value's type arguments, including a generic function's own type variables" {
  let source = Bytes::concat_all([
    b"type Pair<a, b> = | Both(a, b) | Neither\n",
    b"fn unwrapped<a>(o: Option<a>, d: a) -> a = match o { Some(x) -> x, None -> d }\n",
    b"fn first<a, b>(p: Pair<b, a>, d: b) -> b = match p { Both(x, _) -> x, Neither -> d }\n",
  ]);
  let read = |name: Bytes|
    match body_of(source, name) {
      Err(reason) -> [Err(reason)],
      Ok(body) ->
        arms_of(body).map(|a: Block|
          match opening_case(a) {
            Some(o) -> match o.body.at(0) { Some(Let(l)) -> Ok(l.var.ty), _ -> Err(b"") },
            None -> Err(b""),
          }),
    };
  assert_eq(read(b"unwrapped"), [Ok(VariableType(0)), Err(b"")]);
  assert_eq(read(b"first"), [Ok(VariableType(1)), Err(b"")])
}

test "matching an `Option` tests its tag to tell `None` from `Some`, and reads `Some`'s payload from the `Some` case" {
  let source = b"fn payload(o: Option<Int>) -> Int = match o { Some(n) -> n, None -> 0 }\n";
  let o = param_of(source, b"payload", 0);
  match body_of(source, b"payload") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) -> {
      let opened = arms_of(body).map(opening_case);
      assert_eq(
        opened.map(|x: Option<{ test: Test, when: Int, body: Block }>|
          match x { Some(y) -> Some({ test: y.test, when: y.when }), None -> None }),
        [
          Some({ test: TagTest([b"None", b"Some"]), when: 1 }),
          Some({ test: TagTest([b"None", b"Some"]), when: 0 }),
        ],
      );
      assert_eq(
        match opened.at(0) {
          Some(Some(y)) ->
            y.body.map(case_read).filter(|r: Option<{ of: Variable, case: Int }>| r != None),
          _ -> [],
        },
        [Some({ of: o, case: 1 })],
      )
    },
  }
}

test "matching a `Result` first tests `Ok` or `Err`, and the `Err` arms then test the constructor of the `Err` payload" {
  let source = Bytes::concat_all([
    b"type Tone = | Warm | Cool\n",
    b"fn settled(r: Result<Int, Tone>) -> Int = match r { Ok(n) -> n, Err(Warm) -> 1, Err(Cool) -> 2 }\n",
  ]);
  match body_of(source, b"settled") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) -> {
      let arms = arms_of(body);
      assert_eq(
        arms.map(|a: Block|
          opening_case(a).map(|o: { test: Test, when: Int, body: Block }| o.when)),
        [Some(0), Some(1), Some(1)],
      );
      assert_eq(
        match opening_case(arms.get(1)) {
          Some(e) -> match first_case(e.body) {
            Some(c) ->
              Some({
                test: c.test,
                when: c.arms.map(|a: { when: Int, body: Block }| a.when),
                on: is_sum(c.on.representation),
              }),
            None -> None,
          },
          None -> None,
        },
        Some({ test: TagTest([b"m.Warm", b"m.Cool"]), when: [0], on: true }),
      )
    },
  };
  match printed_of(source, b"settled") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(text) -> assert(text.index_of(b"->layout") == None),
  }
}

test "a sum whose constructors take no arguments is tested by its tag value" {
  let source = Bytes::concat_all([
    b"type Tone = | Warm | Cool\n",
    b"fn chosen(c: Bool) -> Int = { let t = if c { Warm } else { Cool }; match t { Warm -> 1, Cool -> 2 } }\n",
    b"fn inner(o: Option<{ a: Int, b: Int }>) -> Int = match o { Some({ a, b }) -> a + b, None -> 0 }\n",
  ]);
  match body_of(source, b"chosen") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) ->
      assert_eq(
        arms_of(body).map(|a: Block|
          match a.at(0) {
            Some(Case(c)) -> Some({ test: c.test, cased: is_sum(c.on.representation) }),
            _ -> None,
          }),
        [
          Some({ test: TagTest([b"m.Warm", b"m.Cool"]), cased: true }),
          Some({ test: TagTest([b"m.Warm", b"m.Cool"]), cased: true }),
        ],
      ),
  };
  match body_of(source, b"inner") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) ->
      assert_eq(
        arms_of(body).map(|a: Block|
          match a.at(0) { Some(Case(c)) -> is_sum(c.on.representation), _ -> false }),
        [true, true],
      ),
  }
}

test "a list pattern tests the list's length, then reads each item it tests or binds" {
  let xs = { id: 0, ty: list_type(int_type), representation: AsWord };
  let source = b"fn leading(xs: List<Int>) -> Int = match xs { [] -> 0, [x] -> x, [x, _, ..] -> x }\n";
  match body_of(source, b"leading") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) -> {
      let opened = arms_of(body).map(opening_case);
      assert_eq(
        opened.map(|o: Option<{ test: Test, when: Int, body: Block }>|
          match o { Some(x) -> Some({ test: x.test, when: x.when }), None -> None }),
        [
          Some({ test: LengthTest({ at_least: 1 }), when: 0 }),
          Some({ test: LengthTest({ at_least: 2 }), when: 1 }),
          Some({ test: LengthTest({ at_least: 2 }), when: 2 }),
        ],
      );
      assert_eq(
        (match opened.at(1) { Some(Some(x)) -> x.body.take(1), _ -> [] }).map(|i: Instruction|
          match i {
            Let(l) -> match l.value {
              OperationCall(o) -> if o.operation != OfContainers(ItemAt) { None } else {
                Some({
                  of_list: o.args.at(0) == Some(VariableOperand(xs)),
                  owned: o.uses.owned,
                  held: l.var.representation,
                })
              },
              _ -> None,
            },
            _ -> None,
          }),
        [Some({ of_list: true, owned: false, held: AsInt })],
      )
    },
  }
}

test "a record or tuple pattern tests nothing and reads the fields it binds" {
  match body_of(b"fn pair(p: (Int, Int)) -> Int = { let (a, b) = p; a * b }\n", b"pair") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) -> {
      assert_eq(
        body.filter(|i: Instruction|
          match i { Case(_) -> true, If(_) -> true, Match(_) -> true, _ -> false }),
        [],
      );
      assert_eq(
        body.take(2).map(|i: Instruction| match case_read(i) { Some(r) -> r.of.id, None -> 0 - 1 }),
        [0, 0],
      )
    },
  };
  match body_of(
      b"fn total(p: { a: Int, b: Int }) -> Int = match p { { a, b } -> a + b }\n",
      b"total",
    ) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) ->
      assert_eq(
        arms_of(body).map(|a: Block| a.take(2).map(|i: Instruction| case_read(i) != None)),
        [[true, true]],
      ),
  }
}

test "a refutable `let` tests its pattern and fails when the pattern does not match" {
  let source = b"fn unwrap(o: Option<Int>) -> Int / {abort.raise} = { let Some(n) = o; n }\n";
  let o = param_of(source, b"unwrap", 0);
  let bound = span_in(source, b"unwrap", |e: Expression|
    match e {
      BlockExpression(b) -> match b.statements.at(0) {
        Some(LetStatement(l)) -> l.span,
        _ -> dummy_span,
      },
      _ -> dummy_span,
    });
  match body_of(source, b"unwrap") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) -> {
      assert_eq(
        first_case(body).map(
          |c: { on: Variable, test: Test, arms: List<{ when: Int, body: Block }>, rest: Block }|
            {
              on: c.on,
              test: c.test,
              when: c.arms.map(|a: { when: Int, body: Block }| a.when),
              rest: c.rest,
            },
        ),
        Some({
          on: o,
          test: TagTest([b"None", b"Some"]),
          when: [1],
          rest: [Fail({ reason: LetMismatch, at: bound, resource: [], unwind: [] })],
        }),
      );
      assert(body.map(case_read).contains(Some({ of: o, case: 1 })))
    },
  }
}

test "comparing a value with a constructor of its sum produces a `Bool` computed from the constructor's tag test" {
  let o = param_of(b"fn unset(o: Option<Int>) -> Bool = o == None\n", b"unset", 0);
  let set_to = |b: Block|
    b.fold([], |accumulator: List<Bool>, i: Instruction|
      match i {
        Assign(a) -> match a.arg { BoolOperand(x) -> accumulator.push(x), _ -> accumulator },
        _ -> accumulator,
      });
  let joined = |c: { on: Variable, test: Test, arms: List<{ when: Int, body: Block }>, rest: Block }|
    {
      test: c.test,
      when: c.arms.map(|a: { when: Int, body: Block }| a.when),
      held: c.arms.map(|a: { when: Int, body: Block }| set_to(a.body)),
      missed: set_to(c.rest),
    };
  match body_of(b"fn unset(o: Option<Int>) -> Bool = o == None\n", b"unset") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) -> {
      assert_eq(
        first_case(body).map(
          |c: { on: Variable, test: Test, arms: List<{ when: Int, body: Block }>, rest: Block }|
            c.on,
        ),
        Some(o),
      );
      assert_eq(
        first_case(body).map(joined),
        Some({ test: TagTest([b"None", b"Some"]), when: [0], held: [[true]], missed: [false] }),
      )
    },
  };
  match body_of(b"fn not_three(o: Option<Int>) -> Bool = o != Some(3)\n", b"not_three") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) -> match first_case(body) {
      None -> assert(false, Some("no test of the constructor")),
      Some(c) -> {
        assert_eq(joined({ ..c, arms: [] }), {
          test: TagTest([b"None", b"Some"]),
          when: [],
          held: [],
          missed: [true],
        });
        let arm = match c.arms.at(0) { Some(a) -> a.body, None -> [] };
        assert(arm.map(case_read).contains(Some({ of: o, case: 1 })));
        assert_eq(
          first_case(arm).map(joined),
          Some({ test: IntTest([3]), when: [0], held: [[false]], missed: [true] }),
        )
      },
    },
  };
  let nested = Bytes::concat_all([
    b"type Spec = | Zeroed | Tagged\n",
    b"type Kind = | Plain | Sum(Spec)\n",
    b"fn zeroed(k: Kind) -> Bool = k == Sum(Zeroed)\n",
  ]);
  match body_of(nested, b"zeroed") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) ->
      assert_eq(
        match first_case(body) {
          Some(c) -> match c.arms.at(0) {
            Some(a) -> match first_case(a.body) {
              Some(inner) ->
                Some({
                  outer: { test: c.test, when: a.when, missed: set_to(c.rest) },
                  inner: joined(inner),
                }),
              _ -> None,
            },
            None -> None,
          },
          _ -> None,
        },
        Some({
          outer: { test: TagTest([b"m.Plain", b"m.Sum"]), when: 1, missed: [false] },
          inner: {
            test: TagTest([b"m.Zeroed", b"m.Tagged"]),
            when: [0],
            held: [[true]],
            missed: [false],
          },
        }),
      ),
  };
  match body_of(b"fn holds_n(o: Option<Int>, n: Int) -> Bool = Some(n) == o\n", b"holds_n") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) ->
      assert_eq(
        match first_case(body) {
          Some(c) -> match c.arms.at(0) {
            Some(a) ->
              a.body.map(|i: Instruction|
                match i {
                  Let(l) -> match l.value {
                    Primitive(p) -> Some(p.operation),
                    Get(_) -> Some(b"get"),
                    _ -> None,
                  },
                  If(x) -> if set_to(x.otherwise) == [false] { Some(b"if") } else { None },
                  _ -> None,
                }),
            None -> [],
          },
          _ -> [],
        },
        [Some(b"get"), Some(b"eq"), Some(b"if")],
      ),
  }
}

test "a constructor's computed argument is lowered before the comparison and compared by its type's equality" {
  let source = Bytes::concat_all([
    b"fn owner_is(o: Option<Int>, r: { owner: Int, n: Int }) -> Bool = o == Some(r.owner)\n",
    b"fn not_negative_zero(x: Option<Float>) -> Bool = x != Some(-0.0)\n",
  ]);
  let operations = |body: Block|
    body.fold([], |accumulator: List<Bytes>, i: Instruction|
      match i {
        Case(c) -> match c.arms.at(0) {
          Some(a) ->
            accumulator.concat(
              a.body.map(|x: Instruction|
                match x {
                  Let(l) -> match l.value {
                    Primitive(p) -> p.operation,
                    Get(_) -> b"get",
                    _ -> b"other",
                  },
                  If(_) -> b"if",
                  _ -> b"other",
                }),
            ),
          None -> accumulator,
        },
        _ -> accumulator,
      });
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) ->
      assert_eq(
        [b"owner_is", b"not_negative_zero"].map(|n: Bytes| {
          let f = lowered_root(p, n);
          operations(f.body)
        }),
        [[b"get", b"eq", b"if"], [b"get", b"eq", b"if"]],
      ),
  }
}

fn tags_tested(b: Block) -> List<List<Bytes>> =
  b.fold([], |accumulator: List<List<Bytes>>, i: Instruction|
    match i {
      Case(c) -> {
        let here = match c.test { TagTest(names) -> accumulator.push(names), _ -> accumulator };
        c.arms.fold(here, |a: List<List<Bytes>>, arm: { when: Int, body: Block }|
          a.concat(tags_tested(arm.body))).concat(
          tags_tested(c.rest),
        )
      },
      If(x) -> accumulator.concat(tags_tested(x.then)).concat(tags_tested(x.otherwise)),
      Match(m) ->
        m.arms.fold(accumulator, |a: List<List<Bytes>>, arm: Block|
          a.concat(tags_tested(arm))).concat(
          tags_tested(m.rest),
        ),
      _ -> accumulator,
    })

test "a value whose type declares a `key for` function is compared with a constructor by that key, never by its tag" {
  let source = Bytes::concat_all([
    b"type Rounded = | Rounded(Int)\n",
    b"key for Rounded by rounded\n",
    b"fn rounded(r: Rounded) -> Int = match r { Rounded(n) -> n / 10 }\n",
    b"fn same_rounded(r: Rounded, n: Int) -> Bool = r == Rounded(n)\n",
    b"fn other_rounded(r: Rounded) -> Bool = Rounded(12) != r\n",
    b"type Wrapped = | Wrapped(Rounded) | Bare\n",
    b"fn wraps(w: Wrapped, n: Int) -> Bool = w == Wrapped(Rounded(n))\n",
    b"type Length = | Metres(Int) | Millimetres(Int)\n",
    b"key for Length by millimetres\n",
    b"fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }\n",
    b"fn differ(n: Int) -> Bool = Metres(n) != Millimetres(n * 1000)\n",
  ]);
  let tagged = |name: Bytes|
    match body_of(source, name) { Err(reason) -> [[reason]], Ok(body) -> tags_tested(body) };
  assert_eq(tagged(b"same_rounded"), []);
  assert_eq(tagged(b"other_rounded"), []);
  assert_eq(tagged(b"differ"), []);
  assert_eq(tagged(b"wraps"), [[b"m.Wrapped", b"m.Bare"]])
}

test "a list pattern over a view reads its items from the view's list at its offset and binds its rest as a view" {
  match program_of(b"fn walk(xs: List<Int>) -> Int = 0\n") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match p.roots.at(0) {
      None -> assert(false),
      Some(root) -> {
        let code = root.code;
        let list = list_type(int_type);
        let s = { id: 0, ty: list, representation: AsListView };
        let binder = |name: Bytes, slot: Int, t: Type|
          CodeBindingPattern({ name: name, slot: slot, span: dummy_span, ty: t });
        let st = arm_start(
          context_of(p.setting, root, code),
          initial_lowering([s]),
          VariableOperand(s),
          {
            pattern: CodeListPattern({
              items: [binder(b"x", 1, int_type)],
              rest: Some(binder(b"r", 2, list)),
            }),
            guard: None,
            body: code,
          },
        );
        assert_eq(
          first_case(st.instructions).map(
            |c: { on: Variable, test: Test, arms: List<{ when: Int, body: Block }>, rest: Block }|
              { on: c.on, test: c.test },
          ),
          Some({ on: s, test: LengthTest({ at_least: 1 }) }),
        );
        let leaves = st.instructions.fold([], |accumulator: List<Variable>, i: Instruction|
          match i {
            Let(l) -> match l.value {
              Get(g) -> if g.of == s && (g.path == LeafPath(0) || g.path == LeafPath(1)) {
                accumulator.push(l.var)
              } else { accumulator },
              _ -> accumulator,
            },
            _ -> accumulator,
          });
        assert(
          st.instructions.any(|i: Instruction|
            match i {
              Let(l) -> match l.value {
                OperationCall(o) ->
                  o.operation == OfContainers(ItemAt) && o.args == leaves.map(VariableOperand),
                _ -> false,
              },
              _ -> false,
            }),
        );
        assert_eq(
          match st.env.get(2) { Some(VariableOperand(v)) -> Some(v.representation), _ -> None },
          Some(AsListView),
        )
      },
    },
  }
}

test "a literal of any other type is tested by its type's equality" {
  match body_of(b"fn half(f: Float) -> Int = match f { 0.5 -> 1, _ -> 0 }\n", b"half") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(body) ->
      assert_eq(
        match arms_of(body).at(0) {
          Some([Let(l), If(x)]) -> match l.value {
            Primitive(p) ->
              Some({
                operation: p.operation,
                on: p.on,
                tested: x.cond == VariableOperand(l.var),
                otherwise: x.otherwise,
              }),
            _ -> None,
          },
          _ -> None,
        },
        Some({ operation: b"eq", on: AsFloat, tested: true, otherwise: [Miss] }),
      ),
  };
  match program_of(b"fn word(s: String) -> Int = match s { \"one\" -> 1, _ -> 0 }\n") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let f = lowered_root(p, b"word");
      assert(match arms_of(f.body).at(0) {
        Some(a) -> a.any(|i: Instruction| match i { If(_) -> true, _ -> false }),
        None -> false,
      })
    },
  }
}

type CorpusRoot = { name: Bytes, source_text: Bytes }

fn lowers(name: Bytes, source: Bytes) -> CorpusRoot = { name: name, source_text: source }

const corpus_types: Bytes =
  Bytes::concat_all([
    b"type Shape = | Circle(Float) | Rect(Int, Int) | Dot\n",
    b"type Tone = | Warm | Cool\n",
    b"type Tok = | TEof | TNum(Int) | TName(Bytes)\n",
    b"type Point = { x: Float, y: Float }\n",
    b"type Figure = | Ring(Point, Float) | Labelled(String, Point) | Tally(U64, I64) | Spot(Float) | Blank\n",
    b"type P = { x: Int, y: Int }\n",
    b"type Named = { name: String, weight: Float, at: P }\n",
    b"type Parsed = { rest: String, node: P }\n",
    b"type Track = | Mark(P) | Line(P, P) | Empty\n",
    b"type Coin = | Penny | Nickel | Dime | Quarter\n",
    b"type Plot = | Round(Int) | Square(Int) | Oblong(Int, Int)\n",
    b"type Reading = | Level(Int) | Estimate(Int) | Offline | Broken(String)\n",
    b"type Bad = { why: String, at: Int }\n",
    b"type Taken = { value: Int, at: Int }\n",
    b"type Side = | Left(Taken) | Right(Taken)\n",
    b"type Step = { value: Int, next: Int }\n",
    b"type Marked = { wide: Int, mark: Option<String> }\n",
    b"type Tagline = | Tag(Option<String>, Int) | Untagged\n",
    b"type Tree = | Con({ name: String, args: List<Tree> }) | Leaf\n",
    b"type Token = | Punct(String) | Num(Int, Float) | Eof\n",
    b"type Rounded = | Rounded(Int)\n",
    b"type Wrapper = | Holds(Rounded) | Nothing\n",
    b"type Ref = | Ref({ name: String, args: List<Int> }) | Anon\n",
    b"type Pr = | Pr(Bytes, Int)\n",
    b"type Stream = | Over | More(Bytes, () -> Stream)\n",
    b"type Wrapped = | Wrap({ name: String }) | Bare(Int)\n",
    b"fn bigger(p: P, q: P) -> P = if p.x > q.x { p } else { q }\n",
    b"fn step(n: Int) -> Step = { value: n, next: n + 1 }\n",
    b"fn stepped(n: Int) -> Result<Step, Int> = if n < 0 { Err(0 - n) } else { Ok(step(n)) }\n",
    b"fn halves(a: Int) -> (Int, Int) = (a / 2, a % 2)\n",
    b"fn even(i: Int) -> Option<Int> = if i % 2 == 0 { Some(i) } else { None }\n",
    b"fn len_of(s: String) -> Int = s.len()\n",
  ])

