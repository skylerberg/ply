fn word(id: Int) -> Variable = local_var(id, string_type, AsWord)

fn closure_variable(id: Int, return_type: Type) -> Variable =
  local_var(id, function_type([], return_type, no_effects), AsWord)

const sample_span: Span = span_between(3, 9)

const empty_span: Span = span_between(0, 0)

fn bare_read(name: Bytes) -> Code =
  {
    node: NBuiltin({ name: name, args: [], effect_arguments: [] }),
    span: empty_span,
    ty: unknown_type,
  }

fn root_context(
  p: Program,
  name: Bytes,
) -> Option<{ context: Context, code: Code }> / {abort.raise} =
  p.roots.fold(None, |accumulator: Option<{ context: Context, code: Code }>, r: Root|
    if r.key != Named(qualify(b"m", name)) { accumulator } else {
      {
        let code = r.code;
        Some({ context: context_of(p.setting, r, code), code: code })
      }
    })

fn handle_at(
  p: Program,
  name: Bytes,
) -> Option<{ context: Context, h: CodeHandler }> / {abort.raise} =
  match root_context(p, name) {
    None -> None,
    Some(r) -> match handle_of(r.code) {
      Some(h) -> Some({ context: r.context, h: h }),
      None -> None,
    },
  }

fn handle_of(c: Code) -> Option<CodeHandler> =
  match c.node {
    CodeHandle(h) -> Some(h),
    CodeBlock(b) -> match b.tail {
      Some(t) -> match t.node { CodeHandle(h) -> Some(h), _ -> None },
      None -> None,
    },
    _ -> None,
  }

fn operations_in(
  body: List<Instruction>,
) -> List<{ var: Variable, operation: HandleOperation, args: List<Arg>, uses: OperationSignature }> =
  body.fold(
    [],
    |accumulator: List<{ var: Variable, operation: HandleOperation, args: List<Arg>, uses: OperationSignature }>, i: Instruction|
      match i {
        Let(l) -> match l.value {
          OperationCall(o) -> match o.operation {
            OfHandling(h) ->
              accumulator.push({ var: l.var, operation: h, args: o.args, uses: o.uses }),
            _ -> accumulator,
          },
          _ -> accumulator,
        },
        _ -> accumulator,
      },
  )

fn handles_in(
  body: List<Instruction>,
) -> List<{ body: List<Instruction>, args: List<Arg>, uses: OperationSignature, site: HandleSite, result: Variable, unwind: List<Variable> }> =
  body.fold(
    [],
    |accumulator: List<{ body: List<Instruction>, args: List<Arg>, uses: OperationSignature, site: HandleSite, result: Variable, unwind: List<Variable> }>, i: Instruction|
      match i { Handle(h) -> accumulator.push(h), _ -> accumulator },
  )

fn unpacks(body: List<Instruction>, v: Variable, rep: Representation) -> Bool =
  body.any(|i: Instruction|
    match i { Let(l) -> l.value == Convert({ arg: VariableOperand(v), to: rep }), _ -> false })

fn without_descriptor(operation: HandleOperation) -> HandleOperation =
  match operation { Perform(x) -> Perform({ ..x, descriptor: b"" }), other -> other }

const perform_corpus: Bytes =
  Bytes::concat_all([
    b"effect log {\n  write put(n: Int) -> Unit\n}\n",
    b"effect ask {\n  read get() -> Int\n}\n",
    b"effect net {\n  write send[s](payload: Int) -> Unit\n}\n",
    b"fn note(n: Int) -> Unit / {log.put} = log.put(n)\n",
    b"fn asked(n: Int) -> Int / {ask.get} = ask.get() + n\n",
    b"fn sent(n: Int) -> Unit / {net.send[conn]} = net.send[conn](n)\n",
    b"fn relay<[l]>(n: Int) -> Unit / {net.send[l]} = net.send[l](n)\n",
    b"fn raised(m: String) -> Int / {abort.raise} = abort.raise(m)\n",
  ])

test "a function containing a hole `???` lowers, and the hole becomes a raise that stops the function" {
  match program_of(b"pub fn pick(n: Int) -> Int = if n > 3 { 9 } else { ??? }\n") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> assert_eq(lowered_root(p, b"pick").key, Named(b"m.pick")),
  }
}

test "a perform passes its operation's entry in the effect object, with its arguments as machine words and its result typed as the operation's return type" {
  match program_of(perform_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let int = int_type;
      {
        let f = lowered_root(p, b"note");
        match operations_in(f.body) {
          [o] -> {
            assert_eq(
              without_descriptor(o.operation),
              Perform({
                effect: b"m.log",
                operation: b"put",
                index: 0,
                resource: b"",
                labelled: false,
                mode: 1,
                descriptor: b"",
              }),
            );
            assert_eq((o.uses.takes, o.uses.suspends), ([false, true], true));
            assert_eq(o.args.at(0), f.params.at(1).map(VariableOperand));
            assert(
              f.body.any(|i: Instruction|
                match i {
                  Let(l) ->
                    o.args.drop(1) == [VariableOperand(l.var)] && l.var.representation == AsWord
                      && l.value
                      == Convert({ arg: VariableOperand(local_var(0, int, AsInt)), to: AsWord }),
                  _ -> false,
                }),
              None,
            );
            assert(unpacks(f.body, o.var, AsUnit), None)
          },
          other -> assert_eq(other.len(), 1),
        };
        let described = operations_in(f.body).map(
          |o: { var: Variable, operation: HandleOperation, args: List<Arg>, uses: OperationSignature }|
            match o.operation { Perform(x) -> x.descriptor, _ -> b"" },
        );
        assert_eq(
          f.statics.filter(|d: StaticDefinition|
            match d.layout { StaticStruct(s) -> s.of == b"PlyOp", _ -> false }).map(
            |d: StaticDefinition| d.name,
          ),
          described,
        );
        assert_eq(f.statics.last().map(|d: StaticDefinition| d.name), described.at(0))
      };
      {
        let f = lowered_root(p, b"asked");
        match f.body {
          [Let(o), Let(k), ..] -> {
            assert_eq((o.var.ty, o.var.representation), (int, AsWord));
            assert_eq((k.value, k.var.representation), (
              Convert({ arg: VariableOperand(o.var), to: AsInt }),
              AsInt,
            ))
          },
          other -> assert_eq(other, []),
        }
      };
      let keyed = |name: Bytes| {
        let f = lowered_root(p, name);
        operations_in(f.body)
      };
      assert_eq(
        keyed(b"sent").map(
          |o: { var: Variable, operation: HandleOperation, args: List<Arg>, uses: OperationSignature }|
            without_descriptor(o.operation),
        ),
        [
          Perform({
            effect: b"m.net",
            operation: b"send",
            index: 0,
            resource: b"conn",
            labelled: false,
            mode: 1,
            descriptor: b"",
          }),
        ],
      );
      match keyed(b"relay") {
        [o] -> {
          assert_eq(
            without_descriptor(o.operation),
            Perform({
              effect: b"m.net",
              operation: b"send",
              index: 0,
              resource: b"",
              labelled: true,
              mode: 1,
              descriptor: b"",
            }),
          );
          assert_eq(o.uses.takes, [false, false, true]);
          assert_eq(
            o.args.map(|a: Arg| match a { VariableOperand(v) -> v.representation, _ -> AsWord }),
            [AsImmediate, AsInt, AsWord],
          )
        },
        other -> assert_eq(other.len(), 1),
      };
      assert_eq(
        keyed(b"raised").map(
          |o: { var: Variable, operation: HandleOperation, args: List<Arg>, uses: OperationSignature }|
            (without_descriptor(o.operation), o.uses.suspends),
        ),
        [
          (
            Perform({
              effect: b"abort",
              operation: b"raise",
              index: 0,
              resource: b"",
              labelled: false,
              mode: 2,
              descriptor: b"",
            }),
            false,
          ),
        ],
      )
    },
  }
}

test "a resource label such as `conn` lowers to an `Int` index into the effect's resource table, which is not reference counted" {
  match program_of(perform_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match root_context(p, b"sent") {
      None -> assert(false),
      Some(r) -> {
        let entry = local_var(0, int_type, AsInt);
        let o = label(r.context, initial_lowering([]), b"conn", sample_span);
        assert_eq(o.arg, VariableOperand(entry));
        assert_eq(o.st.instructions, [
          Let({
            var: entry,
            value: OperationCall({
              operation: OfHandling(Label(b"conn")),
              args: [],
              uses: { takes: [], owned: false, fails: false, suspends: false },
            }),
            at: sample_span,
            unwind: [],
          }),
        ])
      },
    },
  }
}

const handle_corpus: Bytes =
  Bytes::concat_all([
    b"effect ask {\n  read get() -> Int\n}\n",
    b"effect amb {\n  read flip() -> Bool\n}\n",
    b"effect db {\n  read query[r](q: Int) -> Int\n}\n",
    b"fn asked() -> Int / {db.query[users]} = db.query[users](1)\n",
    b"fn guarded(n: Int) -> Int = handle { ask.get() + n } with { ask.get() -> 1 }\n",
    b"fn off_tail() -> Int = handle { if amb.flip() { 1 } else { 2 } } with { amb.flip() resume k -> k(true) + 1 }\n",
    b"fn tail_only(n: Int) -> Int = handle { if amb.flip() { n } else { 2 } } with { amb.flip() resume k -> k(true) }\n",
    b"fn off_tail_held(n: Int) -> Int = handle { let m = n + 1; if amb.flip() { m } else { 2 } } with { amb.flip() resume k -> k(true) + 1 }\n",
    b"fn tagged() -> Int = handle { asked() } with { db.query[*t](q) resume k -> k(q) + 1 }\n",
    b"fn once() -> Int = handle { asked() } with { db.query[*t](q) resume k -> k(q) }\n",
    b"fn split() -> Int = handle { asked() + db.query[logs](2) } with { db.query[users](q) -> q, db.query[*t](q) -> q + t.len() }\n",
    b"fn caught(b: Bytes) -> Int = handle { b.at(3) } with { abort.raise(m) -> m.len() }\n",
    b"type Saved = | Done(Int) | Parked(once (Bool) -> Saved)\n",
    b"fn parked() -> Saved = handle { Done(if amb.flip() { 1 } else { 0 }) } with { amb.flip() resume k -> Parked(k) }\n",
    b"effect tell {\n  write say(n: Int) -> Unit\n}\n",
    b"fn told() -> Int / {tell.say} = handle { tell.say(1); if amb.flip() { 1 } else { 2 } } with { amb.flip() resume k -> { tell.say(2); k(true) + 1 } }\n",
  ])

test "a continuation read as a value is the closure of a lambda that resumes it, at the type it is called at" {
  match program_of(handle_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let f = lowered_root(p, b"parked");
      let resumes = |c: { body: Function, captures: Int, at: Span, words: typed_ir::ClosureEvidence }|
        c.body.kind == typed_ir::Plain
          && c.body.body.any(|i: Instruction|
            match i {
              Let(x) -> match x.value {
                typed_ir::Apply(a) -> match a.f {
                  VariableOperand(v) -> representations::resume_result_type(v.ty) != None,
                  _ -> false,
                },
                _ -> false,
              },
              _ -> false,
            });
      assert(f.lambdas.any(|l: typed_ir::Lambda| match l { Closure(c) -> resumes(c) }), None)
    },
  }
}

test "a clause that binds the call site's label passes the runtime the descriptor of the label's type" {
  match program_of(handle_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let f = lowered_root(p, b"tagged");
      let sites = f.body.fold(
        [],
        |accumulator: List<{ site: HandleSite, args: List<Arg> }>, i: Instruction|
          match i {
            Handle(h) -> accumulator.push({ site: h.site, args: h.args }),
            _ -> accumulator,
          },
      );
      match sites {
        [h] -> match h.site.clauses.at(0) {
          Some(c) -> match c.string {
            Some(i) -> {
              assert_eq(h.args.at(i).map(operand_representation), Some(AsInt));
              assert(
                f.statics.any(|d: StaticDefinition|
                  match d.layout {
                    StaticStruct(s) -> s.of == b"PlyType" && s.fields.at(2) == Some(RawWord(6)),
                    _ -> false,
                  }),
              )
            },
            None -> assert(false),
          },
          None -> assert(false),
        },
        other -> assert_eq(other.len(), 1),
      }
    },
  }
}

test "a clause handling `abort.raise` passes the runtime the descriptor of the message's `String`" {
  match program_of(handle_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let f = lowered_root(p, b"caught");
      let clauses = f.body.fold([], |accumulator: List<Clause>, i: Instruction|
        match i { Handle(h) -> accumulator.concat(h.site.clauses), _ -> accumulator });
      assert_eq(clauses.map(|c: Clause| { operation: c.operation, string: c.string != None }), [
        { operation: b"raise", string: true },
      ])
    },
  }
}

test "a clause that calls `resume` in tail position stores its result as a single word without unpacking the continuation's result" {
  let source = Bytes::concat_all([
    b"effect ask {\n  read get(n: Int) -> Int\n}\n",
    b"type R = { a: String, n: Int, m: Int }\n",
    b"fn run(n: Int) -> R = handle { { a: \"x\", n: ask.get(n), m: 0 } } with { ask.get(q) resume k -> if q > 0 { k(q) } else { { a: \"y\", n: 0, m: 0 } } }\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let f = lowered_root(p, b"run");
      assert_eq(
        match f.lambdas.at(0) {
          Some(Closure(c)) ->
            c.body.body.fold([], |a: List<Representation>, i: Instruction|
              match i { Declaration(v) -> a.push(v.representation), _ -> a }),
          None -> [],
        },
        [AsWord],
      )
    },
  }
}

test "a `handle` runs its body in place, and stores its result at the result's own type" {
  match program_of(handle_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match handle_at(p, b"guarded") {
      None -> assert(false),
      Some(g) -> {
        let int = int_type;
        let n = local_var(0, int, AsInt);
        let clause = closure_variable(1, int);
        let made = Let({
          var: clause,
          value: Allocate({
            made: ClosureAllocation({ nth: 0, captures: 0, params: 0 }),
            args: [],
            reuse: None,
          }),
          at: sample_span,
          unwind: [],
        });
        let plan = handle_plan(
          g.context,
          emitted({ ..initial_lowering([n]), next: 2 }, made),
          g.h,
          sample_span,
        );
        let outer = { ..plan.st, next: 3 };
        let instance = plan.instance.word;
        let sum = local_var(3, int, AsInt);
        let add = Let({
          var: sum,
          value: Primitive({
            operation: b"add",
            on: AsInt,
            args: [VariableOperand(n), IntOperand(1)],
          }),
          at: sample_span,
          unwind: [],
        });
        let body = {
          st: { ..emitted(enter_block(outer), add), next: 4 },
          arg: VariableOperand(sum),
        };
        let o = handle_assembled(
          g.context,
          outer,
          body,
          [VariableOperand(clause)],
          None,
          g.h,
          plan,
          sample_span,
        );
        match handles_in(o.st.instructions) {
          [h] -> {
            assert(h.body.contains(add), None);
            assert_eq(h.result.representation, AsInt);
            assert(
              h.body.any(|i: Instruction| match i { Assign(a) -> a.var == h.result, _ -> false }),
              None,
            );
            assert_eq((h.args, h.site.detached, h.uses.takes), (
              [VariableOperand(clause), instance],
              None,
              [false, false],
            ));
            assert_eq(h.site.instance, {
              operand: 1,
              records: [raise_offset],
              variable_count: raise_offset + 4,
              count: 0,
              pending: None,
              result: None,
              raise_clause_indexes: [],
              heap: None,
              return_clause: None,
              preset: false,
            });
            assert_eq(h.site.clauses.map(|c: Clause| (c.effect, c.operation, c.mode)), [
              (b"m.ask", b"get", 0),
            ])
          },
          other -> assert_eq(other.len(), 1),
        };
        let left = {
          st: emitted(body.st, Return(VariableOperand(sum))),
          arg: VariableOperand(sum),
        };
        let message = handle {
          handle_assembled(
            g.context,
            outer,
            left,
            [VariableOperand(clause)],
            None,
            g.h,
            plan,
            sample_span,
          );
          b""
        } with {
          abort.raise(m) -> Bytes::of_string(m),
        };
        assert(message.contains(b"a handle body exits before reaching its end"), None)
      },
    },
  }
}

test "lowering a handle of an effect whose operations it does not know fails with an error" {
  match program_of(handle_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match handle_at(p, b"guarded") {
      None -> assert(false, Some("`guarded` is a handle")),
      Some(g) -> {
        let blind = { ..g.context, setting: { ..g.context.setting, effects: [] } };
        let message = handle {
          handle_plan(blind, initial_lowering([]), g.h, sample_span);
          b""
        } with {
          abort.raise(m) -> Bytes::of_string(m),
        };
        assert(
          message.contains(b"a handle expression uses an effect whose operations"),
          Some("a handle laid out an object of no slots"),
        )
      },
    },
  }
}

test "a clause that calls `resume` outside tail position runs the `handle` body as a separate function, copying in the variables it reads" {
  match program_of(handle_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let planned = |g: { context: Context, h: CodeHandler }|
        handle_plan(g.context, initial_lowering([]), g.h, sample_span);
      let frame_of = |name: Bytes|
        match handle_at(p, name) {
          Some(g) -> if detaches(g.h.clauses) {
            Some(body_frame(g.context, g.h, planned(g), [], int_type))
          } else { None },
          None -> None,
        };
      assert_eq(frame_of(b"tail_only"), None);
      assert_eq(frame_of(b"once"), None);
      match frame_of(b"off_tail_held") {
        None -> assert(false),
        Some(f) -> {
          assert_eq((f.params, f.captures), (0, [{ source: 0, destination: 0 }]));
          assert(f.size >= 2)
        },
      };
      match handle_at(p, b"tagged") {
        None -> assert(false),
        Some(g) -> {
          assert_eq(
            g.h.clauses.map(|clause: CodeClause| clause_frame(clause, no_captured_evidence).params),
            [3],
          );
          assert_eq(body_frame(g.context, g.h, planned(g), [], int_type).captures.len(), 0)
        },
      };
      match handle_at(p, b"off_tail") {
        None -> assert(false),
        Some(g) -> {
          let int = int_type;
          let clause = closure_variable(0, int);
          let inner = closure_variable(1, int);
          let plan = handle_plan(g.context, { ..initial_lowering([]), next: 2 }, g.h, sample_span);
          let o = handle_assembled(
            g.context,
            plan.st,
            { st: plan.st, arg: VariableOperand(inner) },
            [VariableOperand(clause)],
            None,
            g.h,
            plan,
            sample_span,
          );
          match handles_in(o.st.instructions) {
            [h] -> {
              assert_eq((h.body, h.args.take(3), h.site.detached, h.site.instance.heap), (
                [],
                [VariableOperand(clause), VariableOperand(inner), plan.instance.word],
                Some({ body: 1, forwards: 4 }),
                Some(3),
              ));
              assert_eq(h.site.clauses.map(|c: Clause| (c.effect, c.operation, c.mode)), [
                (b"m.amb", b"flip", 2),
              ]);
              assert(unpacks(o.st.instructions, h.result, AsInt), None)
            },
            other -> assert_eq(other.len(), 1),
          }
        },
      }
    },
  }
}

test "a `handle` body run as a separate function captures the initial value of each handler variable, stored at the variable's type" {
  let source = Bytes::concat_all([
    b"effect tally {\n  write add(n: Int) -> Unit\n  read total() -> Int\n}\n",
    b"fn resumed() -> Int = handle { tally.add(1); tally.total() } with { var n = 0, var m = n + 1, tally.add(k) resume r -> { n = n + k; let first = r(()); n = n + m; first + m }, tally.total() -> n }\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let f = lowered_root(p, b"resumed");
      let evidence = evidence_type;
      assert_eq(
        f.lambdas.fold([], |accumulator: List<List<Type>>, l: typed_ir::Lambda|
          match l {
            Closure(c) -> if c.captures == 0 { accumulator }
            else { accumulator.push(c.body.params.take(c.captures).map(|x: Variable| x.ty)) },
          }),
        [[evidence], [evidence], [int_type, int_type, evidence, evidence]],
      );
      let operation_names = f.lambdas.fold([], |accumulator: List<Bytes>, l: typed_ir::Lambda|
        match l { Closure(c) -> accumulator.concat(variable_operations(c.body.body)) });
      assert_eq([b"init", b"read", b"write"].map(|o: Bytes| operation_names.contains(o)), [
        true,
        true,
        true,
      ])
    },
  }
}

fn variable_operations(body: List<Instruction>) -> List<Bytes> =
  body.fold([], |accumulator: List<Bytes>, i: Instruction| {
    let value = match i { Let(l) -> Some(l.value), Do(d) -> Some(d.value), _ -> None };
    match value {
      None -> match i {
        Handle(h) -> accumulator.concat(variable_operations(h.body)),
        _ -> accumulator,
      },
      Some(OperationCall(o)) -> match o.operation {
        OfHandling(VariableInitialize(_)) -> accumulator.push(b"init"),
        OfHandling(VariableRead(_)) -> accumulator.push(b"read"),
        OfHandling(VariableWrite(_)) -> accumulator.push(b"write"),
        _ -> accumulator,
      },
      _ -> accumulator,
    }
  })

test "a type parameter of an operation is marked wherever it occurs inside a type, and the generated function's name records the marks" {
  let int = int_type;
  let opt = option_type(int);
  assert_eq(marks_of(marked_type(opt, [1])), { ty: opt, marks: [1] });
  let pair = RecordType(fields_sorted([{ name: b"_0", ty: int }, { name: b"_1", ty: opt }]));
  assert_eq(marks_of(marked_type(option_type(pair), [4])).marks, [4]);
  let declared = RecordType(
    fields_sorted([{ name: b"_0", ty: int }, { name: b"_1", ty: option_type(VariableType(0)) }]),
  );
  let met = mark_type_params(option_type(declared), option_type(pair), [0]);
  assert_eq(met.bound, [{ var: 0, ty: int }]);
  assert_eq(marks_of(met.marked), { ty: option_type(pair), marks: [4] });
  match program_of(marshalling_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let marked = |operation: keys::TypeOperation, t: Type, marks: List<Int>|
        keys::with_marks(keys::generated_key(operation, t, b"m"), marks);
      let names = |k: RootKey|
        named_calls(written_at(p.setting.constructors, k).code).map(
          |c: { name: Bytes, recorded: Option<SiteType> }|
            { name: c.name, at: match c.recorded { Some(t) -> t.args, None -> [] } },
        );
      assert_eq(names(marked(Lower, int, [0])), [{ name: b"?out_carried", at: [int] }]);
      assert(
        names(marked(Lower, opt, [1])).any(|c: { name: Bytes, at: List<Type> }|
          c.name == b"?lower" && c.at == [marked_type(int, [0])]),
      );
      assert(
        names(marked(Lower, list_type(int), [1])).any(|c: { name: Bytes, at: List<Type> }|
          c.name == b"m.lower_items#List<Int>^1"),
      )
    },
  }
}

test "an operation descriptor records the concrete types of a `perform`, including the operation's own parameters and its type parameters' concrete types" {
  match program_of(marshalling_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match root_context(p, b"held") {
      None -> assert(false),
      Some(r) -> {
        let start = params_of(r.context);
        let int = int_type;
        let send = {
          name: b"send",
          mode: WriteMode,
          params: [chan_type(VariableType(0)), VariableType(0)],
          return_type: bool_type,
          own: [0],
        };
        let d = operation_descriptor(
          r.context,
          start.st,
          b"task",
          send,
          [chan_type(int), int],
          bool_type,
        );
        match d.name {
          None -> assert(false),
          Some(name) -> {
            assert_eq(d.st.statics.last().map(|s: StaticDefinition| s.name), Some(name));
            match d.st.statics.last() {
              Some(s) -> match s.layout {
                StaticStruct(x) -> {
                  assert_eq(x.of, b"PlyOp");
                  assert_eq(
                    [
                      x.fields.get(0),
                      x.fields.get(1),
                      x.fields.get(3),
                      x.fields.get(4),
                      x.fields.get(6),
                    ],
                    [FieldWord(b"task"), FieldWord(b"send"), RawWord(2), RawWord(2), RawWord(1)],
                  )
                },
                _ -> assert(false),
              },
              None -> assert(false),
            }
          },
        };
        let recv = {
          ..send,
          name: b"recv",
          params: [chan_type(VariableType(0))],
          return_type: option_type(VariableType(0)),
        };
        let got = operation_descriptor(
          r.context,
          start.st,
          b"task",
          recv,
          [chan_type(int)],
          option_type(int),
        );
        let marshalling = |k: RootKey|
          match k {
            Generated(w, _) -> w.operation == OnWordForm(Lower) || w.operation == OnWordForm(Lift),
            _ -> false,
          };
        assert(!got.st.statics.any(|s: StaticDefinition| entries_of(s).any(marshalling)), None);
        let take = { ..recv, name: b"take", params: [], return_type: VariableType(0) };
        let text = operation_descriptor(r.context, start.st, b"task", take, [], string_type);
        let carried_marshalling = |k: RootKey|
          match k { Generated(w, _) -> marshalling(k) && w.marks.len() > 0, _ -> false };
        assert(text.name != None, None);
        assert(
          !text.st.statics.any(|s: StaticDefinition| entries_of(s).any(carried_marshalling)),
          None,
        );
        let fail = {
          name: b"fail",
          mode: RaiseMode,
          params: [option_type(VariableType(0))],
          return_type: VariableType(1),
          own: [0, 1],
        };
        let raised = operation_descriptor(
          r.context,
          start.st,
          b"oops",
          fail,
          [option_type(int)],
          unit_type,
        );
        assert(
          raised.st.statics.any(|s: StaticDefinition|
            entries_of(s).contains(
              keys::with_marks(keys::generated_key(OnWordForm(Lower), option_type(int), b"m"), [1]),
            )),
          None,
        );
        assert_eq(
          operation_descriptor(
            r.context,
            start.st,
            b"task",
            send,
            [chan_type(VariableType(3)), VariableType(3)],
            bool_type,
          ).name,
          None,
        )
      },
    },
  }
}

const generic_operation_corpus: Bytes =
  Bytes::concat_all([
    b"effect box {\n  write swap<a>(x: a) -> a\n  write same<a>(x: a, y: a) -> Bool\n}\n",
    b"fn swapped() -> Int = handle { box.swap(4) + 1 } with { box.swap(x) -> x }\n",
    b"fn compared() -> Bool = handle { box.same([1], [1]) } with { box.same(x, y) -> x == y }\n",
  ])

fn natives_in(body: List<Instruction>) -> List<Bytes> =
  body.fold([], |accumulator: List<Bytes>, i: Instruction|
    match i {
      Let(l) -> match l.value { Native(n) -> accumulator.push(n.name), _ -> accumulator },
      Do(d) -> match d.value { Native(n) -> accumulator.push(n.name), _ -> accumulator },
      Handle(h) -> accumulator.concat(natives_in(h.body)),
      _ -> accumulator,
    })

fn static_comparison_entries(statics: List<StaticDefinition>) -> List<List<Option<RootKey>>> =
  statics.fold([], |accumulator: List<List<Option<RootKey>>>, d: StaticDefinition|
    match d.layout {
      StaticStruct(s) -> if s.of != b"PlyKept" { accumulator } else {
        accumulator.push(
          [1, 2].map(|i: Int| match s.fields.at(i) { Some(EntryWord(k)) -> Some(k), _ -> None }),
        )
      },
      _ -> accumulator,
    })

fn comparison_entries(t: Type) -> List<Option<RootKey>> =
  [keys::Equal, keys::Order].map(|operation: keys::TypeOperation|
    Some(keys::generated_key(OnWordForm(operation), t, b"m")))

test "a value passed to a clause of a generic operation is boxed as `Kept`, the clause stores and returns it, and the perform unboxes the result at its own type" {
  match program_of(generic_operation_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let f = lowered_root(p, b"swapped");
      let boxed_type = NamedType({ name: b"std.internal.schedule.Kept", args: [] });
      let called = natives_in(f.body);
      assert(called.contains(b"builtin_elaborated_keep_p"), None);
      assert(called.contains(b"builtin_elaborated_open_p"), None);
      assert_eq(static_comparison_entries(f.statics), [comparison_entries(int_type)]);
      match f.lambdas.at(0) {
        Some(Closure(c)) -> {
          assert(
            c.body.params.any(|v: Variable| v.ty == boxed_type && v.representation == AsWord),
            None,
          );
          assert_eq(c.body.result_type, boxed_type)
        },
        _ -> assert(false),
      }
    },
  }
}

test "a clause compares the boxed `Kept` values it receives using equality generated for their type" {
  match program_of(generic_operation_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let ints = list_type(int_type);
      {
        let f = lowered_root(p, b"compared");
        match f.lambdas.at(0) {
          Some(Closure(c)) ->
            assert(natives_in(c.body.body).contains(b"builtin_elaborated_kept_equal_p"), None),
          _ -> assert(false),
        };
        assert_eq(static_comparison_entries(f.statics), [comparison_entries(ints)]);
        {
          let e = serialization_function(
            p.setting.constructors,
            keys::generated_key(OnWordForm(keys::Equal), ints, b"m"),
          );
          assert_eq(e.params.map(|v: Variable| v.representation), [AsWord, AsWord]);
          assert(
            e.body.any(|i: Instruction|
              match i {
                Let(l) -> match l.value {
                  Call(x) -> x.callee == Root(keys::generated_key(keys::Equal, ints, b"m")),
                  _ -> false,
                },
                _ -> false,
              }),
            None,
          )
        }
      };
      let task = task_type(int_type);
      let types = [
        int_type,
        ints,
        function_type([int_type], int_type, no_effects),
        task,
        RecordType(fields_sorted([{ name: b"t", ty: task }])),
        VariableType(0),
      ];
      assert_eq(types.map(|t: Type| comparison_built(p.setting.constructors, t, false)), [
        true,
        true,
        true,
        false,
        false,
        false,
      ]);
      assert_eq(types.map(|t: Type| comparison_built(p.setting.constructors, t, true)), [
        true,
        true,
        false,
        false,
        false,
        false,
      ])
    },
  }
}

const nested_marshalling_corpus: Bytes =
  Bytes::concat_all([
    b"effect deck {\n  write first<a>(xs: List<a>) -> Option<a>\n",
    b"  write tallied<a>(xs: List<a>) -> Map<a, Int>\n  write twice<a>(f: (a) -> a, x: a) -> a\n}\n",
    b"fn first() -> Option<Int> / {deck.write} = deck.first([1, 2])\n",
    b"fn tallied() -> Map<String, Int> / {deck.write} = deck.tallied([\"a\"])\n",
    b"fn twice() -> Int / {deck.write} = deck.twice(|n: Int| n + 1, 4)\n",
  ])

test "a value nested in the arguments of a generic operation is boxed one part at a time, by functions generated for its type" {
  match program_of(nested_marshalling_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let int = int_type;
      let rooted_call = |accumulator: List<RootKey>, i: Instruction|
        match i {
          Let(l) -> match l.value {
            Call(c) -> match c.callee { Root(k) -> accumulator.push(k), _ -> accumulator },
            _ -> accumulator,
          },
          _ -> accumulator,
        };
      let calls = |name: Bytes| {
        let f = lowered_root(p, name);
        f.body.fold([], rooted_call)
      };
      let at = |operation: keys::TypeOperation, t: Type, marks: List<Int>|
        keys::with_marks(keys::generated_key(operation, t, b"m"), marks);
      assert_eq(calls(b"first"), [
        at(keys::Wrapping, list_type(int), [1]),
        at(keys::Opening, option_type(int), [1]),
      ]);
      assert_eq(calls(b"tallied"), [
        at(keys::Wrapping, list_type(string_type), [1]),
        at(keys::Opening, map_type(string_type, int), [1]),
      ]);
      assert_eq(calls(b"twice"), [
        at(keys::Wrapping, function_type([int], int, no_effects), [1, 2]),
      ]);
      let built = |k: RootKey|
        match built_c(nested_marshalling_corpus, [], k) { Ok(_) -> b"", Err(reason) -> reason };
      assert_eq(
        [
          at(keys::Wrapping, list_type(int), [1]),
          at(keys::Opening, option_type(int), [1]),
          at(keys::Opening, map_type(string_type, int), [1]),
          at(keys::Wrapping, function_type([int], int, no_effects), [1, 2]),
          keys::generated_key(OnWordForm(keys::Order), string_type, b"m"),
        ].map(
          built,
        ),
        [b"", b"", b"", b"", b""],
      )
    },
  }
}

const parallel_corpus: Bytes =
  Bytes::concat_all([
    b"effect meter {\n  read level() -> Int\n}\n",
    b"fn reads() -> (Int, Int) / {meter.level} = parallel { meter.level(), meter.level() }\n",
  ])

test "a parallel block passes the runtime its branches and the descriptor of each branch's result" {
  match program_of(parallel_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let int = int_type;
      let branches = [
        VariableOperand(closure_variable(0, int)),
        VariableOperand(closure_variable(1, int)),
      ];
      let lowered = |name: Bytes|
        match root_context(p, name) {
          None -> [],
          Some(r) ->
            parallel_block(
              r.context,
              { ..initial_lowering([]), next: 2 },
              branches,
              no_effects,
              sample_span,
            ).st.instructions,
        };
      assert_eq(
        lowered(b"reads").fold([], |accumulator: List<Path>, i: Instruction|
          match i {
            Let(x) -> match x.value { Get(g) -> accumulator.push(g.path), _ -> accumulator },
            _ -> accumulator,
          }),
        [FieldPath({ name: b"_0", at: 0 }), FieldPath({ name: b"_1", at: 1 })],
      );
      match operations_in(lowered(b"reads")) {
        [o] -> {
          assert_eq(o.operation, Parallel);
          assert_eq((o.var.ty, o.var.representation), (parallel_results_type([int, int]), AsWord));
          assert_eq(o.args.take(2), branches);
          assert_eq(o.args.drop(2).map(operand_representation), [AsInt, AsInt]);
          assert_eq(o.uses, {
            takes: [true, true, false, false],
            owned: true,
            fails: true,
            suspends: true,
          })
        },
        other -> assert_eq(other.len(), 1),
      }
    },
  }
}

fn function_of(name: Bytes, params: List<Variable>, body: List<Instruction>) -> Function =
  {
    key: Named(qualify(b"m", name)),
    kind: Metered,
    params: params,
    convention: {
      params: owned_params(params.map(|v: Variable| v.representation)),
      result: AsWord,
      destination_passing: false,
      returned: OwnedResult,
    },
    result_type: NamedType({ name: b"T", args: [] }),
    body: body,
    lambdas: [],
    base: 0,
    members: [],
    links: no_links,
    statics: [],
  }

fn let_operation(v: Variable, operation: HandleOperation, args: List<Arg>) -> Instruction =
  Let({
    var: v,
    value: OperationCall({
      operation: OfHandling(operation),
      args: args,
      uses: { takes: args.map(|_: Arg| true), owned: true, fails: true, suspends: true },
    }),
    at: sample_span,
    unwind: [],
  })

test "a `perform` calls the operation in the effect object it receives, passing its arguments as words in an array with two spare slots, and the resource as an index" {
  let entry = local_var(0, int_type, AsInt);
  let object = local_var(6, evidence_type, AsImmediate);
  let printed = printed_function(
    function_of(b"sends", [entry, word(1), object], [
      Let({
        var: word(2),
        value: OperationCall({
          operation: OfHandling(
            Perform({
              effect: b"m.net",
              operation: b"send",
              index: 0,
              resource: b"",
              labelled: true,
              mode: 1,
              descriptor: b"ply_k_send",
            }),
          ),
          args: [VariableOperand(object), VariableOperand(entry), VariableOperand(word(1))],
          uses: { takes: [false, false, true], owned: true, fails: true, suspends: true },
        }),
        at: sample_span,
        unwind: [],
      }),
      let_operation(
        word(3),
        Perform({
          effect: b"m.net",
          operation: b"send",
          index: 0,
          resource: b"conn",
          labelled: false,
          mode: 1,
          descriptor: b"ply_k_send",
        }),
        [VariableOperand(object)],
      ),
      let_operation(
        word(4),
        Perform({
          effect: b"m.net",
          operation: b"close",
          index: 1,
          resource: b"",
          labelled: false,
          mode: 1,
          descriptor: b"ply_k_close",
        }),
        [VariableOperand(object)],
      ),
      Let({
        var: local_var(5, int_type, AsInt),
        value: OperationCall({
          operation: OfHandling(Label(b"conn")),
          args: [],
          uses: { takes: [], owned: false, fails: false, suspends: false },
        }),
        at: sample_span,
        unwind: [],
      }),
      Return(VariableOperand(word(4))),
    ]),
    no_constructors,
  );
  let text = pieces_text(printed.pieces);
  let named_type = |x: Bytes|
    match x.index_of(b"&") { Some(i) -> x.slice(i + 1, x.len()), None -> x };
  assert_eq(
    call_args(text, b"ply_perform").map(|a: List<Bytes>|
      [a.get(1), a.get(2), named_type(a.get(3)), a.get(4), a.get(5)]),
    [
      [b"p2", b"0", b"ply_k_send", b"1", b"p0"],
      [b"p2", b"0", b"ply_k_send", b"1", b"@@f0@@"],
      [b"p2", b"1", b"ply_k_close", b"1", b"-1"],
    ],
  );
  assert(
    text.index_of(b"[] = {p1, 0, 0};") != None && text.index_of(b"[] = {0, 0};") != None,
    None,
  );
  assert(text.index_of(b" = @@f0@@;") != None, None);
  assert_eq(printed.fields, [b"conn"]);
  assert_eq(printed.performs, [b"m.net#send", b"m.net#send", b"m.net#close"])
}

test "a parallel block's results are moved into a box in branch order, and the box's contents are released by type when a branch fails" {
  let branches = range(0, 11).map(word);
  let described = range(11, 22).map(|i: Int| local_var(i, int_type, AsInt));
  let printed = printed_function(
    function_of(b"many", branches.concat(described), [
      let_operation(
        word(22),
        Parallel,
        branches.concat(described).map(|v: Variable| VariableOperand(v)),
      ),
      Return(VariableOperand(word(22))),
    ]),
    no_constructors,
  );
  let text = pieces_text(printed.pieces);
  let message = Some(String::of_bytes_lossy(text));
  assert(text.index_of(b"[] = {p0, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10};") != None, message);
  assert_eq(call_args(text, b"rt_branches_p").map(|a: List<Bytes>| a.drop(2)), [[b"11"]]);
  assert(
    range(0, 11).all(|i: Int|
      text.index_of(Bytes::concat_all([b"p", ascii_of_int(11 + i), b")->dec(ctx, "])) != None),
    message,
  );
  assert(
    text.index_of(b"ply_alloc(ctx, 96);") != None
      && text.index_of(b"ply_words(t2)[10] = t1[10];") != None,
    message,
  )
}

test "`CurrentSite` prints a placeholder for the source location of the function itself, and fixed offsets for the locations after it" {
  let int = int_type;
  let printed = pieces_text(
    printed_function(
      function_of(b"sited", [], [
        let_operation(local_var(0, int, AsInt), CurrentSite(0), []),
        let_operation(local_var(1, int, AsInt), CurrentSite(1), []),
        let_operation(local_var(2, int, AsInt), CurrentSite(2), []),
        Return(VariableOperand(local_var(2, int, AsInt))),
      ]),
      no_constructors,
    ).pieces,
  );
  let message = Some(String::of_bytes_lossy(printed));
  assert(printed.index_of(b"t1 = @@r@@;") != None, message);
  assert(printed.index_of(b"t2 = 3;") != None && printed.index_of(b"t3 = 9;") != None, message)
}

const corpus: Bytes =
  Bytes::concat_all([
    b"effect log {\n  write put(n: Int) -> Unit\n  write say(s: String) -> Unit\n  read ping() -> Unit\n}\n",
    b"effect ask {\n  read get() -> Int\n}\n",
    b"effect amb {\n  read flip() -> Bool\n}\n",
    b"effect net {\n  write send[s](payload: Int) -> Unit\n}\n",
    b"effect link {\n  write send[s](payload: Int) -> Int\n}\n",
    b"effect meter {\n  read level() -> Int\n}\n",
    b"effect tally {\n  write add(n: Int) -> Unit\n  read total() -> Int\n}\n",
    b"fn note(n: Int) -> Unit / {log.put} = log.put(n)\n",
    b"fn told(s: String) -> Unit / {log.say} = log.say(s)\n",
    b"fn pinged() -> Unit / {log.ping} = log.ping()\n",
    b"fn asked(n: Int) -> Int / {ask.get} = ask.get() + n\n",
    b"fn sent(n: Int) -> Unit / {net.send[conn]} = net.send[conn](n)\n",
    b"fn relay<[l]>(n: Int) -> Unit / {net.send[l]} = net.send[l](n)\n",
    b"fn driven(n: Int) -> Unit / {net.send[conn]} = relay[conn](n)\n",
    b"fn raised(m: String) -> Int / {abort.raise} = abort.raise(m)\n",
    b"fn answered(n: Int) -> Int = handle { ask.get() + n } with { ask.get() -> n * 2 }\n",
    b"fn keyed(x: Int) -> Int = handle { link.send[conn](x) } with { link.send[conn](p) -> p + 1 }\n",
    b"fn forward<[l]>(x: Int) -> Int / {link.send[l]} = link.send[l](x)\n",
    b"fn labelled(x: Int) -> Int = handle { forward[conn](x) } with { link.send[conn](p) -> p + 1 }\n",
    b"fn every(x: Int) -> Int = handle { forward[conn](x) + forward[up](x) } with { link.send[*](p) -> p + 1 }\n",
    b"fn caught(n: Int) -> Result<Int, String> = handle { if n > 0 { n } else { abort.raise(\"low\") } } with { abort.raise(m) -> Err(m), return v -> Ok(v) }\n",
    b"fn nested() -> Int = handle { handle { ask.get() } with { abort.raise(m) -> 0 } } with { ask.get() -> 7 }\n",
    b"fn tailed() -> Int = handle { if amb.flip() { 1 } else { 2 } } with { amb.flip() resume k -> k(true) }\n",
    b"fn off_tail() -> Int = handle { if amb.flip() { 1 } else { 2 } } with { amb.flip() resume k -> k(true) + 1 }\n",
    b"fn tagged(x: Int) -> Int = handle { forward[conn](x) } with { link.send[*t](p) -> p + 1 }\n",
    b"fn mapped(n: Int) -> Int = handle { ask.get() + n } with { ask.get() -> 1, return v -> v * 10 }\n",
    b"fn counted() -> Int = handle { tally.add(1); tally.add(2); tally.total() } with { var n = 0, tally.add(k) -> { n = n + k; }, tally.total() -> n }\n",
    b"fn pair(n: Int) -> (Int, Int) = parallel { n + 1, n + 2 }\n",
    b"fn reads() -> (Int, Int) / {meter.level} = parallel { meter.level(), meter.level() }\n",
    b"fn summed(n: Int) -> Int = { let (a, b) = parallel { n + 1, n + 2 }; a + b }\n",
    b"fn points(n: Int) -> Int = { let (p, k) = parallel { { x: n, y: 1 }, n }; p.x + p.y + k }\n",
    b"fn release(_: Int) -> Unit = ()\n",
    b"fn held(n: Int) -> Int = with_scope[t](n, release) { c -> c.get() }\n",
    b"fn bracketed(n: Int) -> Int = bracket(|| n, release, |x: Int| x + 1)\n",
    b"effect fail {\n  raise bad(why: String)\n  raise far(at: Int, why: String)\n}\n",
    b"fn tried(n: Int) -> Result<Int, String> = try { if n > 0 { n } else { fail.bad(\"low\") } }\n",
    b"fn tried_far(n: Int) -> Int = match try { if n > 0 { n } else { fail.far(n, \"low\") } } { Ok(v) -> v, Err(e) -> e._0 }\n",
  ])

const lowered_roots: List<Bytes> =
  [
    b"note",
    b"told",
    b"pinged",
    b"asked",
    b"sent",
    b"relay",
    b"driven",
    b"raised",
    b"answered",
    b"keyed",
    b"labelled",
    b"every",
    b"caught",
    b"nested",
    b"tailed",
    b"off_tail",
    b"tagged",
    b"mapped",
    b"summed",
    b"points",
    b"pair",
    b"reads",
    b"bracketed",
    b"counted",
    b"held",
    b"tried",
    b"tried_far",
  ]

test "every function in the handling test program lowers to IR and prints C without errors" {
  match program_of(corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> assert_eq(build_failures(p, lowered_roots), []),
  }
}

test "the task operations the scheduler loads are the prelude's `task` operations, and those that pass values between tasks are the generic ones" {
  let task_effect_operations = match prelude_effects.find(|e: EffectInfo| e.name == b"task") {
    Some(e) -> e.operations,
    None -> [],
  };
  assert_eq(task_effect_operations.map(|o: OperationInfo| o.name).sort(), task_operations.sort());
  assert_eq(
    task_effect_operations.filter(|o: OperationInfo| marshalling_variables(o).len() > 0).map(
      |o: OperationInfo| o.name,
    ),
    marshalling_operations,
  )
}

const scheduler_corpus: Bytes =
  Bytes::concat_all([
    b"fn ticked() -> Int / {abort.raise, sim.read} = simulate { 1 }\n",
    b"fn clocked() -> Instant / {abort.raise, sim.read} = simulate { clock.now() }\n",
    b"fn drawn() -> Int / {abort.raise, sim.read} = simulate { random.below(6) }\n",
    b"fn spawned() -> Int / {abort.raise, sim.read} = simulate { let t = task.spawn(|| 1 + 2); task.join(t) }\n",
    b"fn yielded() -> Int / {abort.raise, sim.read} = simulate { task.yield(); 1 }\n",
    b"fn chan() -> Int / {abort.raise, sim.read} = simulate { let c = task.channel(1); task.send(c, 5); match task.recv(c) { Some(v) -> v, None -> 0 } }\n",
    b"fn shut() -> Bool / {abort.raise, sim.read} = simulate { let c: Chan<Int> = task.channel(1); task.close(c); task.send(c, 1) }\n",
    b"fn cancelled() -> Bool / {abort.raise, sim.read} = simulate { let t = task.spawn(|| 1); task.cancel(t) }\n",
    b"fn awaited() -> Option<Int> / {abort.raise, sim.read} = simulate { let t = task.spawn(|| 1); task.await(t) }\n",
    b"fn selected() -> Int / {abort.raise, sim.read} = simulate { let c = task.channel(1); task.send(c, 3); match task.select([(c, None)], false) { Some((i, _)) -> i, None -> 0 - 1 } }\n",
    b"effect log {\n  write put(n: Int) -> Unit\n}\n",
    b"fn logged() -> Int / {abort.raise, sim.read} = handle { simulate { log.put(1); 2 } } with { log.put(n) -> () }\n",
    b"fn hosted() -> Int / {task.write, abort.raise} = task.join(task.spawn(|| 1 + 2))\n",
  ])

test "simulation and task operations on their own types become calls into the scheduler, and those functions lower and print without errors" {
  match scheduled_program_of(scheduler_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let roots = [
        b"ticked",
        b"clocked",
        b"drawn",
        b"spawned",
        b"yielded",
        b"chan",
        b"shut",
        b"cancelled",
        b"awaited",
        b"selected",
        b"logged",
        b"hosted",
      ];
      assert_eq(build_failures(p, roots), []);
      let called = |name: Bytes| {
        let f = lowered_root(p, name);
        f.links.generics.map(|g: GenericCall| g.callee)
      };
      assert_eq(called(b"ticked"), [Named(b"std.internal.schedule.simulated")]);
      assert_eq(called(b"hosted"), [
        Named(b"std.internal.schedule.crossing_spawn"),
        Named(b"std.internal.schedule.crossing_join"),
      ])
    },
  }
}

test "a scheduler perform at a type its body leaves unresolved fails the build, because its marshalling function would call itself" {
  let scheduler = {
    name: scheduler_module,
    source_text: b"pub fn crossing_channel<a>(capacity: Int) -> Chan<a> / {task.channel, abort.raise} = {\n  let _ = task.channel(capacity);\n  abort.raise(\"none\")\n}\n",
  };
  let source = b"fn made() -> Chan<Int> / {task.channel, abort.raise} = task.channel(1)\n";
  match built_c(source, [scheduler], Named(b"std.internal.schedule.crossing_channel")) {
    Ok(_) -> assert(false, Some("a perform at a type its body leaves open was written")),
    Err(reason) ->
      assert(
        reason.contains(b"`std.internal.schedule.crossing_channel`")
          && reason.contains(
            b"the scheduler calls an effect operation at a type that is not `Kept`",
          ),
        Some(String::of_bytes_lossy(reason)),
      ),
  }
}

test "a generated marshalling function reports the source locations passed by its caller, not its own" {
  let scheduler = {
    name: scheduler_module,
    source_text: Bytes::concat_all([
      b"pub fn crossing_channel<a>(capacity: Int) -> Chan<a> / {task.channel, abort.raise} = abort.raise(\"none\")\n",
      b"pub fn crossing_probe(n: Int) -> Int / {abort.raise} = if n + 1 > 2 { abort.raise(\"wide\") } else { n }\n",
    ]),
  };
  let source = b"fn made() -> Chan<Int> / {task.channel, abort.raise} = task.channel(1)\n";
  {
    let f = shipped_lowered(source, [scheduler], scheduler_module, b"crossing_probe");
    let text = pieces_text(printed_function(f, no_constructors).pieces);
    let shown = Some(String::of_bytes_lossy(text));
    assert(
      text.index_of(
          b"const int64_t ply_called[3] = { ctx->site_root, ctx->site_start, ctx->site_end };",
        )
        != None,
      shown,
    );
    assert(
      text.index_of(b"PLY_SITE(ctx, ply_called[0], ply_called[1], ply_called[2]);") != None,
      shown,
    );
    assert(text.index_of(b"PLY_SITE(ctx, @@r@@") == None, shown)
  }
}

test "handler variables of many types, including maps and bytes, lower and print without errors, as does a `parallel` block over lists" {
  let source = Bytes::concat_all([
    b"effect keep {\n  read head(key: Bytes) -> Option<Bytes>\n  write put(key: Bytes, v: Bytes) -> Unit\n}\n",
    b"effect prover {\n  read judged[c](lane: List<Int>) -> List<Int>\n}\n",
    b"fn lanes(xs: List<Int>, ys: List<Int>) -> List<Int> / {prover.judged[claims]} = { let h = parallel { prover.judged[claims](xs), prover.judged[claims](ys) }; h._1.fold(h._0, |out: List<Int>, x: Int| out.push(x)) }\n",
    b"type Pulling = { stamp: Bytes, looked: Map<Bytes, Int>, trusted: Bool, packed: Map<Bytes, Bytes>, n: Int }\n",
    b"fn kept(keys: List<Bytes>) -> List<Option<Bytes>> = handle { keep.put(b\"a\", b\"1\"); keys.map(|k: Bytes| keep.head(k)) } with { var store: Map<Bytes, Bytes> = Map::new(), var running: Pulling = { stamp: b\"\", looked: Map::new(), trusted: false, packed: Map::new(), n: 0 }, var files: List<String> = [], var begun = false, var last: Option<Bytes> = None, keep.head(key) -> { running = { ..running, n: running.n + 1, looked: running.looked.insert(key, running.n) }; last = Some(key); begun = true; store.get(key) }, keep.put(key, v) -> { store = store.insert(key, v); files = files.push(\"put\"); }, return r -> if begun && files.len() > 0 && last != None { r } else { [] } }\n",
    b"fn halves(xs: List<List<Int>>) -> List<List<Int>> = { let h = parallel { xs.map(|x: List<Int>| x.push(1)), xs.map(|x: List<Int>| x.push(2)) }; h._1.fold(h._0, |out: List<List<Int>>, x: List<Int>| out.push(x)) }\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> assert_eq(build_failures(p, [b"kept", b"halves", b"lanes"]), []),
  }
}

const landing_corpus: Bytes =
  Bytes::concat_all([
    b"effect ask {\n  read get() -> Int\n}\n",
    b"fn halved(a: Int, b: Int) -> Int / {abort.raise} = a / b\n",
    b"fn guarded(n: Int) -> Int = handle { ask.get() + halved(n, n) + (0 - n) * (n << 3) } with { abort.raise(m) -> 0, ask.get() -> 1 }\n",
  ])

fn sites_of(
  name: Bytes,
) -> { operations: List<{ var: Variable, operation: HandleOperation, args: List<Arg>, uses: OperationSignature }>, sites: List<HandleSite>, f: Function } / {abort.raise} =
  match program_of(handle_corpus) {
    Err(reason) -> panic(String::of_bytes_lossy(reason)),
    Ok(p) -> {
      let f = lowered_root(p, name);
      {
        operations: operations_in(f.body),
        sites: handles_in(f.body).map(
          |h: { body: List<Instruction>, args: List<Arg>, uses: OperationSignature, site: HandleSite, result: Variable, unwind: List<Variable> }|
            h.site,
        ),
        f: f,
      }
    },
  }

fn all_operations_in(
  f: Function,
) -> List<{ var: Variable, operation: HandleOperation, args: List<Arg>, uses: OperationSignature }> =
  handles_in(f.body).fold(
    operations_in(f.body),
    |accumulator: List<{ var: Variable, operation: HandleOperation, args: List<Arg>, uses: OperationSignature }>, h: { body: List<Instruction>, args: List<Arg>, uses: OperationSignature, site: HandleSite, result: Variable, unwind: List<Variable> }|
      accumulator.concat(operations_in(h.body)),
  )

test "a clause on every label is a slot in the effect object, and it receives the label it binds in addition to its arguments" {
  let f = sites_of(b"once");
  assert_eq(
    all_operations_in(f.f).fold(
      [],
      |accumulator: List<HandleOperation>, o: { var: Variable, operation: HandleOperation, args: List<Arg>, uses: OperationSignature }|
        match o.operation {
          ObjectAt(_) -> accumulator.push(o.operation),
          AllocateForwarding(_) -> accumulator.push(o.operation),
          SchedulerEvidence -> accumulator.push(o.operation),
          _ -> accumulator,
        },
    ),
    [
      ObjectAt({
        at: raise_offset + 4,
        slots: [ClauseSlot({ entry: Resumes, record: raise_offset, labelled: true })],
        shared_from: None,
      }),
    ],
  );
  assert_eq(f.sites.map(|s: HandleSite| s.detached), [None])
}

test "clauses for one operation, one for a specific label and one for every label, lower to a single lookup table whose entries follow clause order" {
  let f = sites_of(b"split");
  assert_eq(
    all_operations_in(f.f).fold(
      [],
      |accumulator: List<HandleOperation>, o: { var: Variable, operation: HandleOperation, args: List<Arg>, uses: OperationSignature }|
        match o.operation { ObjectAt(_) -> accumulator.push(o.operation), _ -> accumulator },
    ),
    [
      ObjectAt({
        at: raise_offset + 8,
        slots: [
          KeyedSlot({
            table: raise_offset + 11,
            rows: [
              {
                label: Some(2),
                slot: ClauseSlot({ entry: ReturnsResult, record: raise_offset, labelled: false }),
              },
              {
                label: None,
                slot: ClauseSlot({
                  entry: ReturnsResult,
                  record: raise_offset + 4,
                  labelled: true,
                }),
              },
            ],
          }),
        ],
        shared_from: Some(3),
      }),
    ],
  )
}

const sharing_corpus: Bytes =
  Bytes::concat_all([
    b"effect ask {\n  read get() -> Int\n}\n",
    b"effect tell {\n  write say(n: Int) -> Unit\n}\n",
    b"effect gate {\n  raise shut(at: Int)\n}\n",
    b"fn returns() -> Int = handle { ask.get() } with { ask.get() -> 1 }\n",
    b"fn performs() -> Int / {tell.say} = handle { ask.get() } with { ask.get() -> { tell.say(1); 2 } }\n",
    b"fn holds(n: Int) -> Int = handle { ask.get() } with { ask.get() -> n }\n",
    b"fn counts() -> Int = handle { ask.get() } with { var n = 0, ask.get() -> { n = n + 1; n } }\n",
    b"fn resumes() -> Int = handle { ask.get() } with { ask.get() resume k -> k(1) }\n",
    b"fn raises() -> Int = handle { gate.shut(1) } with { gate.shut(at) -> at }\n",
  ])

test "a handler object can be shared between threads only if its clauses return, capture nothing and call only shareable handlers" {
  match program_of(sharing_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let over = |name: Bytes|
        all_operations_in(lowered_root(p, name)).fold(
          [],
          |accumulator: List<Option<Int>>, o: { var: Variable, operation: HandleOperation, args: List<Arg>, uses: OperationSignature }|
            match o.operation {
              ObjectAt(x) ->
                accumulator.push(match x.shared_from {
                  Some(from) -> Some(o.args.len() - from),
                  None -> None,
                }),
              _ -> accumulator,
            },
        );
      assert_eq(over(b"returns"), [Some(0)]);
      assert_eq(over(b"performs"), [Some(1)]);
      assert_eq(over(b"holds"), [None]);
      assert_eq(over(b"counts"), [None]);
      assert_eq(over(b"resumes"), [None]);
      assert_eq(over(b"raises"), [None]);
      let text = |name: Bytes| match printed_by_ir(p, name) { Ok(t) -> t, Err(reason) -> reason };
      assert(
        text(b"performs").index_of(b"PLY_EVIDENCE_SHARED & ply_evidence_flags(") != None,
        Some(String::of_bytes_lossy(text(b"performs"))),
      );
      assert(
        text(b"holds").index_of(b"PLY_EVIDENCE_SHARED") == None,
        Some(String::of_bytes_lossy(text(b"holds"))),
      )
    },
  }
}

test "a handle body run as a separate function gets a heap-allocated block that forwards the enclosing handle's operations and the words each `resume` passes" {
  let f = sites_of(b"told");
  let laid = f.operations.fold(
    [],
    |accumulator: List<HandleOperation>, o: { var: Variable, operation: HandleOperation, args: List<Arg>, uses: OperationSignature }|
      match o.operation {
        AllocateForwarding(_) -> accumulator.push(o.operation),
        ObjectAt(_) -> accumulator.push(o.operation),
        _ -> accumulator,
      },
  );
  assert_eq(laid, [
    AllocateForwarding(13),
    ObjectAt({
      at: 7,
      slots: [ForwardedSlot({ target: 5, task: 6, record: 10 })],
      shared_from: None,
    }),
    ObjectAt({
      at: raise_offset + 4,
      slots: [ClauseSlot({ entry: Suspends, record: raise_offset, labelled: false })],
      shared_from: None,
    }),
  ]);
  let instance = f.operations.fold(
    [],
    |accumulator: List<Arg>, o: { var: Variable, operation: HandleOperation, args: List<Arg>, uses: OperationSignature }|
      match o.operation {
        InstanceAddress -> accumulator.push(VariableOperand(o.var)),
        _ -> accumulator,
      },
  );
  assert_eq(
    f.operations.fold(
      [],
      |accumulator: List<Option<Arg>>, o: { var: Variable, operation: HandleOperation, args: List<Arg>, uses: OperationSignature }|
        match o.operation {
          ObjectAt(x) -> if x.at == raise_offset + 4 { accumulator.push(o.args.at(0)) }
          else { accumulator },
          _ -> accumulator,
        },
    ),
    instance.map(|a: Arg| Some(a)),
  );
  assert_eq(
    f.f.body.fold([], |accumulator: List<Int>, i: Instruction|
      match i {
        Do(d) -> match d.value {
          OperationCall(o) -> match o.operation {
            OfHandling(SetForwarding(at)) -> accumulator.push(at),
            _ -> accumulator,
          },
          _ -> accumulator,
        },
        _ -> accumulator,
      }),
    [1, 2, 3, 4, 5],
  );
  assert_eq(f.sites.map(|s: HandleSite| s.detached != None), [true]);
  assert(
    f.f.lambdas.any(|l: typed_ir::Lambda|
      match l {
        Closure(c) ->
          c.body.body.any(|i: Instruction|
            match i {
              Do(d) -> match d.value {
                OperationCall(o) ->
                  o.operation == OfHandling(Entering)
                    && o.args.at(1) != Some(ZeroOperand(AsImmediate)),
                _ -> false,
              },
              _ -> false,
            }),
      }),
    None,
  )
}

test "a `handle` catches a raise of an operation that one of its clauses handles when the runtime reports the failure as still pending" {
  let source = Bytes::concat_all([
    b"effect oops {\n  raise boom(n: Int)\n}\n",
    b"fn bang(n: Int) -> Int / {oops.boom} = if n > 0 { oops.boom(n) } else { n }\n",
    b"fn caught(n: Int) -> Int = handle { bang(n) } with { oops.boom(k) -> k + 1 }\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match printed_by_ir(p, b"caught") {
      Err(reason) -> assert_eq(reason, b""),
      Ok(t) ->
        assert(
          t.index_of(
              b"ctx->failed == PLY_FAILED_PENDING && (ply_pw0 = rt_pending_raised_at_p(ctx, ",
            )
            != None,
          Some(String::of_bytes_lossy(t)),
        ),
    },
  }
}

test "a `?` inside a `handle` lowers as a raise that the enclosing `handle` catches" {
  let source = Bytes::concat_all([
    b"effect ask {\n  read get() -> Int\n}\n",
    b"fn parsed(b: Int) -> Result<Int, Int> = if b < 48 { Err(b) } else { Ok(b - 48) }\n",
    b"fn asked(b: Int) -> Result<Int, Int> = { let n = handle { parsed(b)? + ask.get() } with { ask.get() -> 1 }; Ok(n) }\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match printed_by_ir(p, b"asked") {
      Err(reason) -> assert_eq(reason, b""),
      Ok(t) ->
        assert(
          t.index_of(b"ctx->failed == PLY_FAILED_TARGET") != None
            && t.index_of(b"if (ply_held == 1)") != None,
          Some(String::of_bytes_lossy(t)),
        ),
    },
  }
}

test "a label's clauses print as clause tables on the handle's state, and a separate-function body starts from its own block" {
  match program_of(handle_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let text = |name: Bytes| match printed_by_ir(p, name) { Ok(t) -> t, Err(reason) -> reason };
      let has = |t: Bytes, s: Bytes| t.index_of(s) != None;
      assert(
        has(text(b"once"), b"&ply_resumes_labelled"),
        Some(String::of_bytes_lossy(text(b"once"))),
      );
      assert(
        has(text(b"split"), b"&ply_keyed") && has(text(b"split"), b"&ply_answers_labelled"),
        Some(String::of_bytes_lossy(text(b"split"))),
      );
      assert(
        has(text(b"told"), b"rt_detached_open_p(") && has(text(b"told"), b"&ply_stops")
          && has(text(b"told"), b"&ply_forwarded")
          && has(text(b"told"), b"&ply_words_mapped"),
        Some(String::of_bytes_lossy(text(b"told"))),
      )
    },
  }
}

test "each `handle` creates a state object in which its body runs, whether or not the body is a separate function, and the task that runs the `handle` owns it" {
  match program_of(handle_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let names = [
        b"guarded",
        b"off_tail",
        b"tail_only",
        b"off_tail_held",
        b"tagged",
        b"once",
        b"split",
        b"caught",
        b"parked",
        b"told",
      ];
      let texts = names.map(|n: Bytes|
        match printed_by_ir(p, n) { Ok(t) -> t, Err(reason) -> n.concat(b": ").concat(reason) });
      let named_if = |keep: (Bytes) -> Bool|
        range(0, names.len()).filter(|k: Int| keep(texts.get(k))).map(|k: Int| names.get(k));
      assert_eq(named_if(|t: Bytes| t.index_of(task_set) == None), [])
    },
  }
}

test "a `try` block selects each clause by its operation and stores the result at the result type, leaving the body's normal value to the return clause" {
  let source = Bytes::concat_all([
    b"effect bad {\n  raise fail(at: Int)\n}\n",
    b"fn failing(at: Int) -> Int / {bad.fail} = if at > 0 { bad.fail(at) } else { at }\n",
    b"fn tried(n: Int) -> Result<Int, Int> = try { failing(n) }\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      {
        let f = lowered_root(p, b"tried");
        match handles_in(f.body) {
          [h] -> {
            assert(
              h.body.any(|i: Instruction|
                match i {
                  Do(d) -> match d.value {
                    OperationCall(o) -> o.operation == OfHandling(Returning),
                    _ -> false,
                  },
                  _ -> false,
                }),
              None,
            );
            assert(
              !h.body.any(|i: Instruction| match i { Assign(a) -> a.var == h.result, _ -> false }),
              None,
            );
            assert(h.result.representation != AsWord, None)
          },
          other -> assert_eq(other.len(), 1),
        }
      };
      match printed_by_ir(p, b"tried") {
        Err(reason) -> assert_eq(reason, b""),
        Ok(t) -> {
          let landing = match t.index_of(b"ply_h0: ;") {
            Some(at) -> {
              let rest = t.slice(at, t.len());
              match rest.index_of(b"\n}\n") { Some(end) -> rest.slice(0, end), None -> rest }
            },
            None -> b"",
          };
          assert(
            landing.index_of(b"ply_uniform(") == None
              && occurrences(landing, b"->typed)(ctx, ") == 3,
            Some(String::of_bytes_lossy(t)),
          )
        },
      }
    },
  }
}

test "a body that fails inside a handle jumps to the handle's failure target, whatever the failure was" {
  match program_of(landing_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match printed_by_ir(p, b"guarded") {
      Err(reason) -> assert_eq(reason, b""),
      Ok(t) -> match t.index_of(task_set) {
        None -> assert(false),
        Some(from) -> {
          let to = t.len()
            - (match t.split(landing_jump(0)).last() { Some(r) -> r.len(), None -> 0 });
          let body = t.slice(from, to);
          assert_eq(body.index_of(b"return"), None);
          assert(occurrences(body, landing_jump(0)) >= 6, Some(String::of_bytes_lossy(t)))
        },
      },
    },
  }
}

const task_set: Bytes = Bytes::concat_all([b"[", ascii_of_int(task_offset), b"] = ctx->task;"])

fn declared_before(text: Bytes, end: Bytes) -> Bytes / {abort.raise} =
  match text.split(end).at(0) {
    Some(before) -> match before.split(b"Word ").last() {
      Some(tail) -> tail.slice(0, tail.scan(0, identifier_bytes, tail.len())),
      None -> b"",
    },
    None -> b"",
  }

const identifier_bytes: Bytes = b"_0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

fn indexed_names(text: Bytes) -> List<Bytes> / {abort.raise} =
  text.split(b"((Word *)(intptr_t)").drop(1).fold([], |accumulator: List<Bytes>, part: Bytes| {
    let name = part.slice(0, part.scan(0, identifier_bytes, part.len()));
    if part.slice(name.len(), part.len()).starts_with(b")[") && !accumulator.contains(name) {
      accumulator.push(name)
    } else { accumulator }
  })

test "a `handle` reads and writes each handler variable and its result in its state object, not in a closure it creates" {
  let source = Bytes::concat_all([
    b"effect picking {\n  write pick(chosen: Int) -> Unit\n}\n",
    b"fn form(n: Int) -> Int / {picking.pick, abort.raise} = { picking.pick(n); n }\n",
    b"fn finished(n: Int) -> { bytes: Int, chosen: List<Int> } / {abort.raise} = handle { form(n) } with { var chosen: List<Int> = [], picking.pick(one) -> { chosen = chosen.push(one); }, return bytes -> { bytes: bytes, chosen: chosen } }\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match printed_by_ir(p, b"finished") {
      Err(reason) -> assert_eq(reason, b""),
      Ok(t) -> {
        let message = Some(String::of_bytes_lossy(t));
        let array = declared_before(t, b"] = {0};");
        let instance = declared_before(
          t,
          Bytes::concat_all([b" = (Word)(intptr_t)(", array, b" + 4);"]),
        );
        assert(array != b"" && instance != b"", message);
        let target = t.split(b"ctx->target == ").get(1);
        assert(target.starts_with(instance.concat(b")")), message);
        assert(
          t.index_of(Bytes::concat_all([b"((Word *)(intptr_t)", instance, b")", task_set])) != None,
          message,
        );
        assert_eq(indexed_names(t).filter(|name: Bytes| name != instance && name != b"q0"), []);
        let at = |s: Bytes| match t.index_of(s) { Some(k) -> k, None -> 0 - 1 };
        let linked = at(b"->each = ply_instance_each;");
        let unlinked = at(b"if (PLY_FRAMES(ctx) == ((PlyFrame *)");
        let released = at(Bytes::concat_all([b")->dec(ctx, ((Word *)(intptr_t)", instance, b")["]));
        assert(0 <= linked && linked < unlinked && unlinked < released, message)
      },
    },
  }
}

const effects_corpus: Bytes =
  Bytes::concat_all([
    b"effect meter {\n  read level() -> Int\n}\n",
    b"fn under() -> (Int, Int) = handle { parallel { meter.level(), meter.level() } } with { meter.level() -> 0 }\n",
  ])

test "a parallel block receives the evidence for the operations it performs, which the enclosing handle handles" {
  match program_of(effects_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match printed_by_ir(p, b"under") {
      Err(reason) -> assert_eq(reason, b""),
      Ok(t) -> {
        let set = entry_handler_words(t);
        assert(set.len() > 0 && !set.contains(b"0"), Some(String::of_bytes_lossy(t)))
      },
    },
  }
}

const record_corpus: Bytes =
  Bytes::concat_all([
    b"type P = { x: Int, y: Int }\n",
    b"effect store {\n  read held() -> P\n  write keep(p: P) -> Int\n}\n",
    b"fn summed() -> Int / {store.held} = { let p = store.held(); p.x + p.y }\n",
    b"fn kept(start: P) -> Int = handle { store.keep(start) } with { store.keep(p) -> p.x + p.y }\n",
  ])

fn reads_of(body: List<Instruction>, of: Variable) -> List<Path> =
  body.fold([], |accumulator: List<Path>, i: Instruction|
    match i {
      Let(l) -> match l.value {
        Get(g) -> if g.of.id == of.id { accumulator.push(g.path) } else { accumulator },
        _ -> accumulator,
      },
      _ -> accumulator,
    })

test "what an operation returns and what its clause receives are stored as their own types and read field by field" {
  match program_of(record_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      {
        let f = lowered_root(p, b"summed");
        match operations_in(f.body) {
          [o] -> assert_eq(match o.var.ty { RecordType(fs) -> fs.len(), _ -> 0 }, 2),
          other -> assert_eq(other.len(), 1),
        }
      };
      match checked(p, b"kept") {
        Err(reason) -> assert_eq(reason, b""),
        Ok(f) -> match f.lambdas.at(0) {
          Some(Closure(c)) -> match c.body.params.at(c.captures) {
            None -> assert(false),
            Some(clause_parameter) -> {
              assert_eq(match clause_parameter.ty { RecordType(fs) -> fs.len(), _ -> 0 }, 2);
              assert_eq(
                match clause_parameter.representation {
                  AsFlattened(ls) -> Some(ls.map(|l: Leaf| l.representation)),
                  _ -> None,
                },
                Some([AsInt, AsInt]),
              );
              assert_eq(reads_of(c.body.body, clause_parameter), [LeafPath(0), LeafPath(1)])
            },
          },
          None -> assert(false),
        },
      };
      assert_eq(
        [b"summed", b"kept"].map(|n: Bytes|
          match printed_by_ir(p, n) { Ok(_) -> None, Err(reason) -> Some(reason) }),
        [None, None],
      )
    },
  }
}

const step_corpus: Bytes =
  Bytes::concat_all([
    b"effect ask {\n  read get() -> Int\n}\n",
    b"fn stepped(k: Int, n: Int, pad: Int) -> Int / {abort.raise} = iterate(k, n + pad, |s: Int| handle { let y = ask.get(); if s + y >= n { Stop(s) } else { Continue(s + y) } } with { ask.get() resume r -> { let v = r(1); v } })\n",
  ])

fn lambda_argument(c: Code) -> Option<Lambda> =
  match c.node {
    CodeApply(a) ->
      a.args.fold(None, |accumulator: Option<Lambda>, x: Code|
        match accumulator {
          Some(_) -> accumulator,
          None -> match x.node { CodeLambda(l) -> Some(l), _ -> None },
        }),
    CodeBlock(b) -> match b.tail { Some(t) -> lambda_argument(t), None -> None },
    _ -> None,
  }

test "a step that `iterate` runs in place is copied into a separate-function `handle` body with only the variables the step itself uses" {
  match program_of(step_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match root_context(p, b"stepped") {
      None -> assert(false),
      Some(r) -> match lambda_argument(r.code) {
        None -> assert(false),
        Some(l) -> match handle_of(l.body) {
          None -> assert(false),
          Some(h) -> {
            let f = body_frame(
              r.context,
              h,
              handle_plan(r.context, initial_lowering([]), h, sample_span),
              [],
              int_type,
            );
            let own = range(0, l.params).concat(l.captures.map(|c: Capture| c.destination));
            assert_eq(f.captures.len(), 2);
            assert(f.captures.all(|c: Capture| own.contains(c.source) && c.destination == c.source))
          },
        },
      },
    },
  }
}

const marshalling_corpus: Bytes =
  Bytes::concat_all([
    b"pub type Shape = | Dot | Line(Int) | Box({ w: Int, h: Float })\n",
    b"pub type Hook = | Hook((Int) -> Int)\n",
    b"fn held(s: String, x: Float, n: Int) -> Int = n\n",
    b"fn same(a: Int, b: Int) -> Unit / {abort.raise} = assert_eq(a, b)\n",
    b"fn alike<t>(a: t, b: t) -> Unit / {abort.raise} = assert_eq(a, b)\n",
  ])

fn marshalled_parts(body: List<Instruction>) -> List<Bytes> =
  body.fold([], |accumulator: List<Bytes>, i: Instruction|
    match i {
      Let(l) -> accumulator.concat(part_of(l.value)),
      Do(d) -> accumulator.concat(part_of(d.value)),
      _ -> accumulator,
    })

fn part_of(v: Rvalue) -> List<Bytes> =
  match v {
    Native(n) -> [n.name],
    Call(c) -> match c.callee { Root(k) -> [root_text(root_name(k))], _ -> [b"generic"] },
    Get(g) -> if g.path == PayloadPath { [b"payload"] } else { [] },
    Primitive(p) -> [p.operation],
    OperationCall(o) -> match o.operation {
      OfContainers(CopyOut) -> [b"taken"],
      OfContainers(Length) -> [b"length"],
      OfHandling(UnspecialisedBuiltin(name)) -> [b"unsettled ".concat(name)],
      _ -> [b"op"],
    },
    _ -> [],
  }

fn params_of(context: Context) -> { vars: List<Variable>, st: Lowering } / {abort.raise} = {
  let variables = range(0, context.types.len()).map(|i: Int|
    {
      id: i,
      ty: context.types.get(i),
      representation: representation_of(context.setting, context.types.get(i)),
    });
  { vars: variables, st: initial_lowering(variables) }
}

fn calls_in(
  body: List<Instruction>,
) -> List<{ callee: Bytes, args: List<Arg>, passed: List<ParamOwnership> }> =
  body.fold(
    [],
    |accumulator: List<{ callee: Bytes, args: List<Arg>, passed: List<ParamOwnership> }>, i: Instruction| {
      let called = |v: Rvalue|
        match v {
          Call(c) -> match c.callee {
            Root(k) ->
              accumulator.push({
                callee: root_text(root_name(k)),
                args: c.args,
                passed: param_ownerships(c.convention),
              }),
            _ -> accumulator,
          },
          _ -> accumulator,
        };
      match i { Let(l) -> called(l.value), Do(d) -> called(d.value), _ -> accumulator }
    },
  )

test "a marshalling native receives machine words: a string as its bytes' address and length, a float as its bits" {
  match program_of(marshalling_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match root_context(p, b"held") {
      None -> assert(false),
      Some(r) -> {
        let start = params_of(r.context);
        let natives = |body: List<Instruction>|
          body.fold(
            [],
            |accumulator: List<{ name: Bytes, representations: List<Representation> }>, i: Instruction|
              match i {
                Do(d) -> match d.value {
                  Native(n) ->
                    accumulator.push({
                      name: n.name,
                      representations: n.args.map(operand_representation),
                    }),
                  _ -> accumulator,
                },
                Let(x) -> match x.value {
                  Native(n) ->
                    accumulator.push({
                      name: n.name,
                      representations: n.args.map(operand_representation),
                    }),
                  _ -> accumulator,
                },
                _ -> accumulator,
              },
          );
        let text = marshalling_builtin_call(
          r.context,
          start.st,
          b"?out_str",
          [VariableOperand(start.vars.get(0))],
          bare_read(b"?out_str"),
          sample_span,
        );
        assert_eq(marshalled_parts(text.st.instructions).take(3), [
          b"payload",
          b"length",
          b"builtin_elaborated_out_str_p",
        ]);
        assert_eq(natives(text.st.instructions), [
          { name: b"builtin_elaborated_out_str_p", representations: [AsAddress, AsInt] },
        ]);
        let float = marshalling_builtin_call(
          r.context,
          start.st,
          b"?out_float",
          [VariableOperand(start.vars.get(1))],
          bare_read(b"?out_float"),
          sample_span,
        );
        assert_eq(marshalled_parts(float.st.instructions).take(2), [
          b"bits",
          b"builtin_elaborated_out_float_p",
        ]);
        assert_eq(natives(float.st.instructions), [
          { name: b"builtin_elaborated_out_float_p", representations: [AsInt] },
        ]);
        let int = marshalling_builtin_call(
          r.context,
          start.st,
          b"?out_int",
          [VariableOperand(start.vars.get(2))],
          bare_read(b"?out_int"),
          sample_span,
        );
        assert_eq(natives(int.st.instructions), [
          { name: b"builtin_elaborated_out_int_p", representations: [AsInt] },
        ])
      },
    },
  }
}

test "an `assert_eq` at a type that is still unresolved is resolved later, when the function is specialised" {
  match program_of(marshalling_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match root_context(p, b"alike") {
      None -> assert(false),
      Some(r) -> match r.code.node {
        CodeApply(a) -> {
          let start = params_of(r.context);
          let l = builtin(
            r.context,
            start.st,
            b"assert_eq",
            start.vars.map(VariableOperand),
            a.function,
            sample_span,
          );
          assert_eq(marshalled_parts(l.st.instructions), [b"unsettled assert_eq"]);
          assert(l.st.links.needs.any(|n: Need| n.reads == Exact));
          let message = handle {
            printed_text(
              p,
              function_of(b"alike", start.vars, l.st.instructions.push(Return(IntOperand(0)))),
            );
            b""
          } with {
            abort.raise(m) -> Bytes::of_string(m),
          };
          assert(
            message.index_of(
                b"a builtin that was not specialised to concrete types before code generation",
              )
              != None,
          )
        },
        _ -> assert(false),
      },
    },
  }
}

fn call_args(text: Bytes, f: Bytes) -> List<List<Bytes>> / {abort.raise} =
  text.split(f.concat(b"(")).drop(1).map(|rest: Bytes|
    match rest.index_of(b");") { Some(end) -> rest.slice(0, end).split(b", "), None -> [] })

fn named_calls(c: Code) -> List<{ name: Bytes, recorded: Option<SiteType> }> =
  match c.node {
    CodeApply(a) -> {
      let inner = a.args.fold(
        [],
        |accumulator: List<{ name: Bytes, recorded: Option<SiteType> }>, x: Code|
          accumulator.concat(named_calls(x)),
      );
      match read_name(a.function) {
        Some(n) -> [{ name: n, recorded: Some(read_typed(a.function)) }].concat(inner),
        None -> inner,
      }
    },
    CodeBlock(b) ->
      b.statements.fold(
        [],
        |accumulator: List<{ name: Bytes, recorded: Option<SiteType> }>, s: CodeStatement|
          accumulator.concat(match s {
            CodeLet(l) -> named_calls(l.value),
            CodeDo(d) -> named_calls(d.code),
            _ -> [],
          }),
      ).concat(match b.tail { Some(t) -> named_calls(t), None -> [] }),
    CodeIf(x) ->
      named_calls(x.cond).concat(named_calls(x.then_branch)).concat(named_calls(x.else_branch)),
    CodeMatch(m) ->
      m.arms.fold(
        named_calls(m.scrutinee),
        |accumulator: List<{ name: Bytes, recorded: Option<SiteType> }>, arm: CodeArm|
          accumulator.concat(named_calls(arm.body)),
      ),
    CodeRecord(r) ->
      r.fields.fold(
        [],
        |accumulator: List<{ name: Bytes, recorded: Option<SiteType> }>, f: CodeField|
          accumulator.concat(named_calls(f.value)),
      ),
    CodeFieldRead(f) -> named_calls(f.base),
    CodeBinary(b) -> named_calls(b.left_operand).concat(named_calls(b.right_operand)),
    CodeLambda(l) -> named_calls(l.body),
    _ -> [],
  }

fn reads_in(c: Code) -> List<Code> =
  match read_name(c) {
    Some(_) -> [c],
    None ->
      code_children(c).fold([], |accumulator: List<Code>, x: Code| accumulator.concat(reads_in(x))),
  }

fn lambdas_in(c: Code) -> List<Lambda> =
  code_children(c).fold(
    match c.node { CodeLambda(l) -> [l], _ -> [] },
    |accumulator: List<Lambda>, x: Code| accumulator.concat(lambdas_in(x)),
  )

fn effects_filled(c: Code) -> List<Effects> =
  match c.node { NDefinition(d) -> d.effect_arguments, _ -> [] }

fn literal_bytes(c: Code) -> List<Bytes> =
  match c.node {
    CodeLiteral(l) -> match l { LiteralBytes(b) -> [b], _ -> [] },
    CodeApply(a) ->
      a.args.fold([], |accumulator: List<Bytes>, x: Code| accumulator.concat(literal_bytes(x))),
    CodeBlock(b) ->
      b.statements.fold([], |accumulator: List<Bytes>, s: CodeStatement|
        accumulator.concat(match s {
          CodeLet(l) -> literal_bytes(l.value),
          CodeDo(d) -> literal_bytes(d.code),
          _ -> [],
        })).concat(match b.tail { Some(t) -> literal_bytes(t), None -> [] }),
    CodeIf(x) ->
      literal_bytes(x.cond).concat(literal_bytes(x.then_branch)).concat(
        literal_bytes(x.else_branch),
      ),
    CodeMatch(m) ->
      m.arms.fold(literal_bytes(m.scrutinee), |accumulator: List<Bytes>, arm: CodeArm|
        accumulator.concat(literal_bytes(arm.body))),
    CodeRecord(r) ->
      r.fields.fold([], |accumulator: List<Bytes>, f: CodeField|
        accumulator.concat(literal_bytes(f.value))),
    CodeBinary(b) -> literal_bytes(b.left_operand).concat(literal_bytes(b.right_operand)),
    _ -> [],
  }

fn written_at(constructors: Constructors, key: RootKey) -> GeneratedRoot / {abort.raise} =
  match key {
    Generated(w, _) -> if is_marshal_operation(w.operation) {
      marshal_root(b"m", constructors, key)
    } else { container_code(b"m", constructors, operation_name(w.operation), w.ty) },
    _ -> marshal_root(b"m", constructors, key),
  }

fn is_marshalling_root(k: RootKey) -> Bool =
  match k {
    Generated(w, _) -> match w.operation {
      Lower -> true,
      Lift -> true,
      ContainerWalk(c) -> c.starts_with(b"lower_") || c.starts_with(b"lift_"),
      _ -> false,
    },
    _ -> false,
  }

fn is_constructor_name(name: Bytes) -> Bool / {abort.raise} = {
  let through = prelude_constructor(b"");
  let bare = if name.starts_with(through) { name.slice(through.len(), name.len()) } else { name };
  bare.index_of(b"::") == None
    && (match bare.split(b".").last() {
      Some(last) -> last.len() > 0 && last.at(0) >= 65 && last.at(0) <= 90,
      None -> false,
    })
}

test "an entry reads its arguments from the runtime with `?lift` calls, closes the input with `?lift_close`, and returns its function's result with `?lower`" {
  let e = runtime_entry_code(
    b"m",
    Named(b"m.held"),
    Named(b"m.held"),
    [],
    [],
    [string_type, float_type, int_type],
    int_type,
    no_effects,
    [],
  );
  {
    let code = e.code;
    assert_eq(
      named_calls(code).map(|c: { name: Bytes, recorded: Option<SiteType> }|
        { name: c.name, at: match c.recorded { Some(t) -> t.args, None -> [] } }),
      [
        { name: b"?in_count", at: [] },
        { name: b"?lift", at: [string_type] },
        { name: b"?lift", at: [float_type] },
        { name: b"?lift", at: [int_type] },
        { name: b"?lift_close", at: [] },
        { name: b"?lower", at: [int_type] },
        { name: b"m.held", at: [] },
      ],
    );
    assert_eq(e.params, []);
    assert(e.definitions.any(|d: Definition| d.name == b"held" && d.root == Named(b"m.held")))
  }
}

test "a generic definition's entry calls it as any caller does, at an Int for each type variable" {
  let e = runtime_entry_code(
    b"m",
    Named(b"m.first"),
    Named(b"m.first"),
    [int_type],
    [],
    [list_type(int_type)],
    option_type(int_type),
    no_effects,
    [],
  );
  {
    let code = e.code;
    assert(
      named_calls(code).any(|c: { name: Bytes, recorded: Option<SiteType> }|
        c.name == b"m.first"
          && (match c.recorded { Some(t) -> t.args == [int_type], None -> false })),
      None,
    );
    assert(!e.definitions.any(|d: Definition| d.name == b"first"), None)
  }
}

test "an entry of a definition generic over effects calls it as any caller does, with no effects" {
  let e = runtime_entry_code(
    b"m",
    Named(b"m.none"),
    Named(b"m.none"),
    [],
    [no_effects],
    [],
    int_type,
    no_effects,
    [],
  );
  {
    let code = e.code;
    assert(
      named_calls(code).any(|c: { name: Bytes, recorded: Option<SiteType> }| c.name == b"m.none"),
      None,
    );
    assert_eq(
      reads_in(code).filter(|r: Code| read_name(r) == Some(b"m.none")).map(effects_filled),
      [[no_effects]],
    );
    assert_eq(e.performs, no_effects);
    assert(!e.definitions.any(|d: Definition| d.name == b"none"), None)
  }
}

test "an entry under host handlers passes each handler a closure over the call inside it, with the first handler outermost" {
  let e = runtime_entry_code(
    b"m",
    Named(b"m.main"),
    Named(b"m.main"),
    [],
    [],
    [int_type],
    int_type,
    no_effects,
    [
      { call: b"std.a.a::served", effect: b"std.a.a", adds: [] },
      { call: b"std.b.b::served", effect: b"std.b.b", adds: [] },
    ],
  );
  {
    let code = e.code;
    assert_eq(
      named_calls(code).map(|c: { name: Bytes, recorded: Option<SiteType> }|
        { name: c.name, at: match c.recorded { Some(t) -> t.args, None -> [] } }),
      [
        { name: b"?in_count", at: [] },
        { name: b"?lift", at: [int_type] },
        { name: b"?lift_close", at: [] },
        { name: b"?lower", at: [int_type] },
        { name: b"std.a.a::served", at: [int_type] },
        { name: b"std.b.b::served", at: [int_type] },
        { name: b"m.main", at: [] },
      ],
    );
    assert_eq(
      lambdas_in(code).filter(|l: Lambda|
        FunctionType(l.ty) == function_type([], int_type, no_effects)).len(
      ),
      2,
    )
  }
}

test "an entry function takes evidence for effects its host handlers leave unhandled and for effects they add, and each closure performs the effects that its handler's calls add" {
  let entry = |name: Bytes, mode: Mode|
    { effect: name, resource: SingletonResource, mode: mode, operation: None };
  let e = runtime_entry_code(
    b"m",
    Named(b"m.main"),
    Named(b"m.main"),
    [],
    [],
    [],
    int_type,
    {
      listed: [
        entry(b"std.a.a", ReadMode),
        entry(b"std.b.b", ReadMode),
        entry(b"m.log", WriteMode),
      ],
      variable: None,
    },
    [
      { call: b"std.a.a::served", effect: b"std.a.a", adds: [entry(b"std.fs.fs", ReadMode)] },
      { call: b"std.b.b::served", effect: b"std.b.b", adds: [entry(b"abort", RaiseMode)] },
    ],
  );
  {
    let code = e.code;
    assert_eq(e.performs, {
      listed: [
        entry(b"m.log", WriteMode),
        entry(b"abort", RaiseMode),
        entry(b"std.fs.fs", ReadMode),
      ],
      variable: None,
    });
    assert(
      lambdas_in(code).any(|l: Lambda|
        l.effects
          == {
            listed: [
              entry(b"std.a.a", ReadMode),
              entry(b"m.log", WriteMode),
              entry(b"abort", RaiseMode),
            ],
            variable: None,
          }),
      None,
    )
  }
}

test "a generated marshalling function calls only marshalling builtins, functions for the types it handles, other generated functions, and the prelude functions that loading requires" {
  match program_of(marshalling_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let shape = NamedType({ name: b"m.Shape", args: [] });
      let record = RecordType(
        fields_sorted([{ name: b"w", ty: int_type }, { name: b"h", ty: float_type }]),
      );
      let map = map_type(string_type, list_type(int_type));
      let array = array_type(option_type(shape));
      let types = [
        int_type,
        bool_type,
        unit_type,
        float_type,
        decimal_type,
        width_type({ bits: 8, signed: false }),
        width_type({ bits: 128, signed: true }),
        char_type,
        string_type,
        bytes_type,
        shape,
        record,
        list_type(record),
        map,
        array,
        option_type(string_type),
        columns_type(record),
      ];
      let root_keys = types.fold([], |accumulator: List<RootKey>, t: Type|
        accumulator.concat(
          [Lower, Lift].map(|operation: keys::TypeOperation|
            keys::generated_key(operation, t, b"m")),
        )).concat(
        [list_type(int_type), array, map].fold([], |accumulator: List<RootKey>, t: Type|
          accumulator.concat(container_definitions(b"m", t).map(|d: Definition| d.root))),
      ).concat(
        [{ ty: list_type(int_type), at: 1 }, { ty: map_type(string_type, int_type), at: 2 }].fold(
          [],
          |accumulator: List<RootKey>, m: { ty: Type, at: Int }|
            accumulator.concat(
              [Wrapping, Opening].map(|operation: keys::TypeOperation|
                keys::with_marks(keys::generated_key(operation, m.ty, b"m"), [m.at])),
            ),
        ),
      );
      let roots = root_keys.fold(
        [],
        |accumulator: List<{ key: RootKey, root: GeneratedRoot }>, k: RootKey| {
          let r = written_at(p.setting.constructors, k);
          r.definitions.fold(
            accumulator.push({ key: k, root: r }),
            |a: List<{ key: RootKey, root: GeneratedRoot }>, d: Definition|
              if d.root == k || a.any(|x: { key: RootKey, root: GeneratedRoot }| x.key == d.root) {
                a
              } else { a.push({ key: d.root, root: written_at(p.setting.constructors, d.root) }) },
          )
        },
      );
      let externs = prelude_externs.map(|e: Extern| e.name);
      let faults = roots.fold(
        [],
        |accumulator: List<Bytes>, r: { key: RootKey, root: GeneratedRoot }| {
          let code = r.root.code;
          named_calls(code).fold(
            accumulator,
            |a: List<Bytes>, call: { name: Bytes, recorded: Option<SiteType> }| {
              let local = r.root.definitions.any(|d: Definition|
                qualify(b"m", d.name) == call.name);
              let bare = match prelude_own(call.name) { Some(n) -> n, None -> call.name };
              let generated = call.name.starts_with(b"?")
                && (!is_marshalling_root(r.key) || marshalling_builtin(call.name))
                && ((call.name != b"?lower" && call.name != b"?lift")
                || (match call.recorded { Some(t) -> t.args.len() == 1, None -> false }));
              let prelude = call.recorded != None
                && (is_constructor_name(bare) || externs.contains(bare)
                || emitted_code.calls.concat(emitted_code.insert_calls).contains(bare));
              let ply_builtin = builtins.any(|b: Builtin| b.body && b.name == call.name);
              if !ply_builtin && (local || generated || prelude) { a } else {
                a.push(Bytes::concat_all([root_text(root_name(r.key)), b" calls ", call.name]))
              }
            },
          )
        },
      );
      assert_eq(faults, []);
      let loops = roots.fold(
        [],
        |accumulator: List<Bytes>, r: { key: RootKey, root: GeneratedRoot }|
          match r.key {
            Generated(w, _) -> match w.operation {
              ContainerWalk(c) -> accumulator.push(c),
              _ -> accumulator,
            },
            _ -> accumulator,
          },
      );
      assert_eq(loops.filter(|c: Bytes| !container_operation_generated(c)), []);
      assert(loops.contains(b"lower_entries") && loops.contains(b"lift_entries"));
      assert_eq(
        [b"lower_items", b"lower_entries", b"lift_items", b"lift_entries"].map(|c: Bytes|
          container_reads_argument(c, 0)),
        [true, true, false, false],
      );
      let written_names = |k: RootKey| literal_bytes(written_at(p.setting.constructors, k).code);
      assert_eq(written_names(keys::generated_key(Lower, record, b"m")), [b"h", b"w"]);
      assert_eq(written_names(keys::generated_key(Lift, shape, b"m")), [b"m.Dot", b"m.Line"])
    },
  }
}

fn written_whole(constructors: Constructors, key: RootKey) -> Bool / {abort.raise} =
  iterate({ todo: [key], seen: [] }, 512, |s: { todo: List<RootKey>, seen: List<RootKey> }|
    match s.todo.at(0) {
      None -> Stop(true),
      Some(k) -> if s.seen.contains(k) { Continue({ todo: s.todo.drop(1), seen: s.seen }) } else {
        match handle { Some(written_at(constructors, k)) } with { abort.raise(_) -> None } {
          None -> Stop(false),
          Some(r) -> {
            let parts = named_calls(r.code).fold(
              [],
              |accumulator: List<RootKey>, call: { name: Bytes, recorded: Option<SiteType> }|
                match call.recorded {
                  Some(t) -> match t.args.at(0) {
                    Some(ty) -> if call.name == b"?lower" {
                      accumulator.push(keys::generated_key(Lower, ty, b"m"))
                    } else if call.name == b"?lift" {
                      accumulator.push(keys::generated_key(Lift, ty, b"m"))
                    } else { accumulator },
                    None -> accumulator,
                  },
                  None -> accumulator,
                },
            );
            Continue({
              todo: s.todo.drop(1).concat(parts).concat(r.definitions.map(|d: Definition| d.root)),
              seen: s.seen.push(k),
            })
          },
        }
      },
    })

test "a type can be sent to the runtime when its marshalling functions exist, and can be received back only if it contains no function" {
  match program_of(marshalling_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let constructors = p.setting.constructors;
      let all_sums = marshalled_sums(constructors.sums, |_: Bytes| true);
      let shape = NamedType({ name: b"m.Shape", args: [] });
      let hook = NamedType({ name: b"m.Hook", args: [] });
      let callback = function_type([int_type], int_type, no_effects);
      let map = map_type(string_type, list_type(shape));
      let types = [
        int_type,
        decimal_type,
        width_type({ bits: 8, signed: false }),
        string_type,
        shape,
        option_type(shape),
        map,
        array_type(bytes_type),
        RecordType([{ name: b"f", ty: callback }]),
        hook,
        callback,
        list_type(hook),
        VariableType(0),
      ];
      let message = |back: Bool| types.map(|t: Type| is_marshallable(all_sums, t, back));
      let written = |operation: keys::TypeOperation|
        types.map(|t: Type| written_whole(constructors, keys::generated_key(operation, t, b"m")));
      assert_eq(message(false), written(Lower));
      assert_eq(message(true), written(Lift));
      assert_eq(message(false), [
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        false,
      ]);
      assert_eq(message(true), [
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        false,
        false,
        false,
        false,
        false,
      ]);
      let inserting = marshalled_sums(constructors.sums, |n: Bytes|
        !emitted_code.insert_calls.contains(n));
      assert_eq(
        [
          is_marshallable(inserting, map, false),
          is_marshallable(inserting, map, true),
          is_marshallable(inserting, list_type(shape), true),
        ],
        [true, false, true],
      );
      let bare = marshalled_sums(constructors.sums, |_: Bytes| false);
      assert_eq(
        [
          is_marshallable(bare, list_type(int_type), false),
          is_marshallable(bare, shape, true),
          is_marshallable(bare, option_type(list_type(int_type)), false),
        ],
        [false, true, false],
      );
      assert_eq(
        [
          is_marshallable(bare, chan_type(int_type), false),
          is_marshallable(bare, chan_type(int_type), true),
        ],
        [true, false],
      )
    },
  }
}

test "a type's runtime descriptor is emitted once, and lists the type's name before its `Dup` and `Release` functions" {
  match program_of(marshalling_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match root_context(p, b"held") {
      None -> assert(false),
      Some(r) -> {
        let start = params_of(r.context);
        let shape = NamedType({ name: b"m.Shape", args: [] });
        let once = type_descriptor(r.context, start.st, shape, sample_span);
        let twice = type_descriptor(r.context, once.st, shape, sample_span);
        assert_eq(twice.st.statics, once.st.statics);
        assert_eq(once.st.statics.len(), 2);
        let key = |operation: keys::TypeOperation, t: Type| keys::generated_key(operation, t, b"m");
        let laid = |d: LoweredValue|
          match d.st.statics.at(1) { Some(s) -> s, None -> panic("a descriptor laid no static") };
        let lowering = |s: StaticDefinition|
          match s.layout { StaticStruct(x) -> x.fields.at(5), _ -> None };
        let lifting = |s: StaticDefinition|
          match s.layout { StaticStruct(x) -> x.fields.at(6), _ -> None };
        let d = laid(once);
        assert_eq(entries_of(d), [key(Dup, shape), key(keys::Release, shape)]);
        assert_eq([lowering(d), lifting(d)], [
          Some(PreludeWord(never_shown_function)),
          Some(PreludeWord(never_lifted_function)),
        ]);
        match d.layout {
          StaticStruct(s) -> {
            assert_eq(s.of, b"PlyType");
            assert_eq(s.fields.drop(1).take(2), [
              AddressWord({ name: once.st.statics.get(0).name, tag: 0 }),
              RawWord(b"m.Shape".len()),
            ])
          },
          _ -> assert(false),
        };
        assert_eq(operand_representation(once.arg), AsInt);
        let shown = laid(serializable_type_descriptor(r.context, start.st, shape, sample_span));
        assert_eq(entries_of(shown), [
          key(Dup, shape),
          key(keys::Release, shape),
          key(OnWordForm(Lower), shape),
        ]);
        let string = laid(type_descriptor(r.context, start.st, string_type, sample_span));
        assert_eq(lifting(string), Some(EntryWord(key(OnWordForm(Lift), string_type))));
        assert_eq(lowering(string), Some(PreludeWord(never_shown_function)));
        let open = type_descriptor(r.context, start.st, list_type(VariableType(0)), sample_span);
        assert_eq(open.st.statics, []);
        assert(open.st.links.needs.any(|n: Need| n.reads == Exact));
        assert_eq(marshalled_parts(open.st.instructions), [b"unsettled type#List<'0>"])
      },
    },
  }
}

test "functions that convert a type to and from the runtime's one-word form build without errors, and call only the expected conversion helpers" {
  match program_of(marshalling_corpus) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let constructors = p.setting.constructors;
      let types = [
        int_type,
        float_type,
        string_type,
        NamedType({ name: b"m.Shape", args: [] }),
        RecordType(fields_sorted([{ name: b"w", ty: int_type }, { name: b"h", ty: float_type }])),
        list_type(int_type),
      ];
      let entries = types.fold([], |accumulator: List<Function>, t: Type|
        [OnWordForm(Lower), OnWordForm(Lift)].fold(
          accumulator,
          |a: List<Function>, operation: keys::TypeOperation| {
            let f = serialization_function(constructors, keys::generated_key(operation, t, b"m"));
            a.push(f)
          },
        ));
      let rejected = entries.fold([], |accumulator: List<Bytes>, f: Function|
        match build_failure(p, f) {
          Some(reason) ->
            accumulator.push(Bytes::concat_all([root_text(root_name(f.key)), b": ", reason])),
          None -> accumulator,
        });
      assert(rejected == [], Some(String::of_bytes_lossy(Bytes::join(rejected, b"\n"))));
      assert_eq(
        entries.map(|f: Function|
          calls_in(f.body).map(
            |c: { callee: Bytes, args: List<Arg>, passed: List<ParamOwnership> }| c.callee,
          )),
        types.fold([], |accumulator: List<List<Bytes>>, t: Type|
          accumulator.push([root_text(root_name(keys::generated_key(Lower, t, b"m")))]).push([
            root_text(root_name(keys::generated_key(Lift, t, b"m"))),
          ])),
      );
      assert_eq(
        range(0, entries.len()).filter(|i: Int| i % 2 == 1).map(|i: Int|
          entries.get(i).convention.result).filter(|r: Representation| r != AsWord),
        [],
      );
      assert_eq(
        entries.take(2).map(|f: Function|
          f.body.fold([], |accumulator: List<Representation>, i: Instruction|
            match i {
              Let(l) -> match l.value { Convert(x) -> accumulator.push(x.to), _ -> accumulator },
              _ -> accumulator,
            })),
        [[AsInt], [AsWord]],
      )
    },
  }
}
