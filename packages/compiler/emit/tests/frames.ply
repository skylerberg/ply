//! Frame records read off programs' text: which calls link a record, what it holds, and where the
//! C links and unlinks it.

import compiler.emit.emit_harness (program_of, printed_by_ir)
import compiler.emit.roots (symbol_of)
import compiler.emit.print.count_functions (dup_fn, calls)

fn corpus() -> Bytes =
  Bytes::concat_all([
    b"effect amb {\n  read flip() -> Bool\n}\n",
    b"type Pair = { s: String, n: Int }\n",
    b"fn flipped() -> Bool / {amb.flip} = amb.flip()\n",
    b"fn pure(n: Int) -> Int = n * 2\n",
    b"fn held(n: Int) -> String / {amb.flip} = {\n",
    b"  let s = n.to_string();\n",
    b"  let r: Result<Int, String> = Err(s.concat(\"!\"));\n",
    b"  let p: Pair = { s: s.concat(\"?\"), n: n };\n",
    b"  let b = flipped();\n",
    b"  match r { Err(e) -> if b { e.concat(p.s) } else { s }, Ok(_) -> p.s }\n",
    b"}\n",
    b"fn quiet(n: Int) -> String = { let s = n.to_string(); s.concat(pure(n).to_string()) }\n",
    b"fn bare() -> Bool / {amb.flip} = { let b = flipped(); !b }\n",
  ])

/// The C of root `m.<name>` of `corpus()`, or why there is none.
fn c_code_of(name: Bytes) -> Bytes / {abort.raise} =
  match program_of(corpus()) {
    Err(why) -> why,
    Ok(p) -> match printed_by_ir(p, name) { Ok(t) -> t, Err(why) -> why },
  }

fn find(t: Bytes, s: Bytes) -> Int = match t.index_of(s) { Some(i) -> i, None -> 0 - 1 }

test "a body holding a string, an Err and a record's leaf across a call that may stop links a record over them around the call" {
  let t = c_code_of(b"held");
  let call = find(t, Bytes::concat_all([symbol_of(b"m.flipped"), b"(ctx"]));
  // The record is linked into the context's frames before the call and taken back off after it.
  let linked = find(t, b"PLY_FRAMES(ctx) = &");
  let unlinked = find(t, b".h.prev;");
  assert(t.index_of(b"PlyFrame h;") != None);
  assert(0 <= linked && linked < call && call < unlinked);
  // Its each reads every slot the link lays, and only lets go of what they hold.
  let laid = t.split(b".s[").len() - 1;
  assert(laid >= 3);
  assert_eq(t.split(b" = s[").len() - 1, laid);
  let each = match t.index_of(b"_each0(PlyCtx *ctx, Word *s, int64_t d) {") {
    Some(i) -> match t.index_of_from(b"\n}\n", i) { Some(j) -> t.slice(i, j), None -> b"" },
    None -> b"",
  };
  assert(
    each.index_of(b" = s[") != None && !calls(each, dup_fn()),
    Some(String::of_bytes_lossy(each)),
  )
}

test "a call that cannot stop, and one with nothing held across it, link nothing" {
  [c_code_of(b"quiet"), c_code_of(b"bare")].fold((), |_: Unit, t: Bytes| {
    assert_eq(t.index_of(b"PLY_FRAMES"), None);
    assert_eq(t.index_of(b"_each"), None)
  })
}
