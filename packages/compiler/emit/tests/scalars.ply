import compiler.check.types (Type, VariableType, NamedType, int_type, string_type, bytes_type,
                             option_type, list_type, map_type, secret_type)
import compiler.check.known (result_type)
import compiler.syntax.patterns (LiteralString, LiteralDecimal, LiteralWide, LiteralUnit)
import compiler.emit.output (Exact)
import compiler.emit.keys
import compiler.emit.keys (Root, RootName, root_name, root_text)
import compiler.emit.typed_ir (Representation, AsInt, AsBool, AsFixed, AsFloat, AsDecimal,
                               AsWideFixed, AsWord, AsSum, AsImmediate, Variable, Arg,
                               VariableOperand, IntOperand, FixedOperand, CharOperand, Rvalue,
                               Primitive, Literal, Get, Tag, Call, Native, Instruction, Let, Do, If,
                               Block)
import compiler.emit.emit_harness (Program, program_of, lowered_root, printed_by_ir, build_failures)

import compiler.emit.typed_ir (Static)
import compiler.emit.statics (Datum, StringDatum, statics_of)
import compiler.emit.representations (applied)

fn values(b: Block) -> List<Rvalue> =
  b.fold([], |accumulator: List<Rvalue>, i: Instruction|
    match i {
      Let(l) -> accumulator.push(l.value),
      Do(d) -> accumulator.push(d.value),
      If(x) -> accumulator.concat(values(x.then)).concat(values(x.otherwise)),
      _ -> accumulator,
    })

fn bound_in(b: Block) -> List<Variable> =
  b.fold([], |accumulator: List<Variable>, i: Instruction|
    match i {
      Let(l) -> accumulator.push(l.var),
      If(x) -> accumulator.concat(bound_in(x.then)).concat(bound_in(x.otherwise)),
      _ -> accumulator,
    })

type OperatorUse = { operation: Bytes, on: Representation }

fn operators_applied(p: Program, name: Bytes) -> Result<List<OperatorUse>, Bytes> / {abort.raise} = {
  let f = lowered_root(p, name);
  Ok(
    values(f.body).fold([], |accumulator: List<OperatorUse>, v: Rvalue|
      match v {
        Primitive(x) -> accumulator.push({ operation: x.operation, on: x.on }),
        _ -> accumulator,
      }),
  )
}

fn roots_called(p: Program, name: Bytes) -> Result<List<RootName>, Bytes> / {abort.raise} = {
  let f = lowered_root(p, name);
  Ok(
    values(f.body).fold([], |accumulator: List<RootName>, v: Rvalue|
      match v {
        Call(c) -> match c.callee { Root(k) -> accumulator.push(root_name(k)), _ -> accumulator },
        _ -> accumulator,
      }),
  )
}

fn natives(p: Program, name: Bytes) -> Result<List<Bytes>, Bytes> / {abort.raise} = {
  let f = lowered_root(p, name);
  Ok(
    values(f.body).fold([], |accumulator: List<Bytes>, v: Rvalue|
      match v { Native(n) -> accumulator.push(n.name), _ -> accumulator }),
  )
}

fn program(source: Bytes) -> Program / {abort.raise} =
  match program_of(source) { Ok(p) -> p, Err(reason) -> panic(String::of_bytes(reason)) }

fn written_root(operation: keys::TypeOperation, ty: Type) -> RootName =
  root_name(keys::generated_key(operation, ty, b"m"))

fn operands(p: Program, name: Bytes) -> Result<List<List<Arg>>, Bytes> / {abort.raise} = {
  let f = lowered_root(p, name);
  Ok(
    values(f.body).fold([], |accumulator: List<List<Arg>>, v: Rvalue|
      match v { Primitive(x) -> accumulator.push(x.args), _ -> accumulator }),
  )
}

fn contains_get(p: Program, name: Bytes) -> Result<Bool, Bytes> / {abort.raise} = {
  let f = lowered_root(p, name);
  Ok(values(f.body).any(|v: Rvalue| match v { Get(_) -> true, _ -> false }))
}

test "records of a known type are compared and ordered field by field, not by the runtime" {
  let p = program(
    Bytes::concat_all([
      b"type P = { x: Int, name: String }\n",
      b"type Q = { p: P, k: Char }\n",
      b"type R = { o: Option<Int>, n: Int }\n",
      b"fn same(a: P, b: P) -> Bool = a == b\n",
      b"fn apart(a: Q, b: Q) -> Bool = a != b\n",
      b"fn order(a: P, b: P) -> Ordering = compare(a, b)\n",
      b"fn optional(a: R, b: R) -> Bool = a == b\n",
    ]),
  );
  assert_eq(
    operators_applied(p, b"same"),
    Ok([{ operation: b"bytes_eq", on: AsWord }, { operation: b"eq", on: AsInt }]),
  );
  assert_eq(contains_get(p, b"same"), Ok(true));
  assert_eq(natives(p, b"same"), Ok([]));
  assert_eq(operators_applied(p, b"optional"), Ok([{ operation: b"eq", on: AsInt }]));
  assert_eq(
    roots_called(p, b"optional"),
    Ok([written_root(keys::ContainerWalk(b"equal"), option_type(int_type()))]),
  );
  assert_eq(natives(p, b"optional"), Ok([]));
  assert_eq(
    operators_applied(p, b"apart"),
    Ok([
      { operation: b"eq", on: AsImmediate },
      { operation: b"bytes_eq", on: AsWord },
      { operation: b"eq", on: AsInt },
      { operation: b"not", on: AsBool },
    ]),
  );
  assert_eq(natives(p, b"apart"), Ok([]));
  assert_eq(
    operators_applied(p, b"order"),
    Ok([
      { operation: b"bytes_order", on: AsWord },
      { operation: b"ne", on: AsInt },
      { operation: b"order", on: AsInt },
      { operation: b"ordering", on: AsInt },
    ]),
  );
  assert_eq(roots_called(p, b"order"), Ok([]))
}

fn width_representation(bits: Int, signed: Bool) -> Representation =
  AsFixed({ bits: bits, signed: signed })

test "an operator is lowered for the type of its operands, and a fixed-width integer literal is written as an operand of that width" {
  let p = program(
    Bytes::concat_all([
      b"fn wadd(a: U8) -> U8 = a + 1u8\n",
      b"fn half(x: Float) -> Float = 0.5 * x\n",
      b"fn less(a: Int, b: Int) -> Bool = a < b\n",
      b"fn wide(a: U64, b: U64) -> U64 = a * b\n",
      b"fn big(a: U128, b: U128) -> U128 = a + b\n",
    ]),
  );
  let byte = { bits: 8, signed: false };
  assert_eq(operators_applied(p, b"wadd"), Ok([{ operation: b"add", on: AsFixed(byte) }]));
  assert_eq(
    operands(p, b"wadd").map(|xs: List<List<Arg>>| xs.map(|a: List<Arg>| a.drop(1))),
    Ok([[FixedOperand({ width: byte, bits: 1 })]]),
  );
  assert_eq(operators_applied(p, b"half"), Ok([{ operation: b"mul", on: AsFloat }]));
  assert_eq(operators_applied(p, b"less"), Ok([{ operation: b"lt", on: AsInt }]));
  assert_eq(
    operators_applied(p, b"wide"),
    Ok([{ operation: b"mul", on: width_representation(64, false) }]),
  );
  assert_eq(
    operators_applied(p, b"big"),
    Ok([{ operation: b"add", on: AsWideFixed({ bits: 128, signed: false }) }]),
  );
  assert_eq(natives(p, b"big"), Ok([]))
}

test "an `Int` quotient or remainder by a literal uses C's operator directly, and by any other value uses the runtime's checked operation" {
  let p = program(b"fn q(a: Int, b: Int) -> Int / {abort.raise} = a / -4 + a % 7 + a / b\n");
  {
    let f = lowered_root(p, b"q");
    assert_eq(
      values(f.body).fold([], |accumulator: List<List<Arg>>, v: Rvalue|
        match v {
          Primitive(x) -> if x.operation == b"div" || x.operation == b"rem" {
            accumulator.push(x.args.drop(1))
          } else { accumulator },
          _ -> accumulator,
        }),
      [[IntOperand(0 - 4)], [IntOperand(7)], [VariableOperand(f.params.get(1))]],
    )
  };
  match printed_by_ir(p, b"q") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(text) -> {
      assert(text.index_of(b"/ INT64_C(-4)") != None && text.index_of(b"% INT64_C(7)") != None);
      assert(
        text.index_of(b"ply_by_zero(ctx, ") != None && text.index_of(b"== INT64_MIN)") != None,
      );
      assert(text.index_of(b"rt_arith_p(") == None)
    },
  }
}

test "a `Decimal` is stored in registers as two integers, and a `Decimal` literal is written as those two integers" {
  let p = program(
    b"fn d(a: Decimal, b: Decimal) -> Decimal = a * b - a\nfn dl(a: Decimal) -> Bool = a < 1.5m\n",
  );
  assert_eq(
    operators_applied(p, b"d"),
    Ok([{ operation: b"mul", on: AsDecimal }, { operation: b"sub", on: AsDecimal }]),
  );
  assert_eq(
    operators_applied(p, b"dl"),
    Ok([{ operation: b"decimal", on: AsInt }, { operation: b"lt", on: AsDecimal }]),
  );
  {
    let f = lowered_root(p, b"dl");
    assert_eq(bound_in(f.body).map(|v: Variable| v.representation), [AsDecimal, AsBool])
  };
  match printed_by_ir(p, b"d") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(text) ->
      assert(
        text.index_of(b"ply_dec_mul(p0, p1, ") != None && text.index_of(b"ply_dec_add(") != None
          && text.index_of(b"rt_decimal") == None,
        Some(String::of_bytes_lossy(text)),
      ),
  };
  match printed_by_ir(p, b"dl") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(text) ->
      assert(text.index_of(b"(PlyDec){") != None && text.index_of(b"ply_dec_order(") != None),
  }
}

test "a `Char` is a single immediate value, compared with C's ordinary comparison operators" {
  let p = program(b"fn c(a: Char) -> Bool = a < 'z'\n");
  assert_eq(operators_applied(p, b"c"), Ok([{ operation: b"lt", on: AsImmediate }]));
  assert_eq(
    operands(p, b"c").map(|xs: List<List<Arg>>| xs.map(|a: List<Arg>| a.drop(1))),
    Ok([[CharOperand(122)]]),
  )
}

test "strings and byte strings are compared by their bytes, constructors of no argument by their index" {
  let p = program(
    Bytes::concat_all([
      b"type Suit = | Hearts | Spades\n",
      b"fn s(a: String, b: String) -> Bool = a == b\n",
      b"fn bs(a: Bytes, b: Bytes) -> Bool = a != b\n",
      b"fn suit(a: Suit, b: Suit) -> Bool = a != b\n",
      b"fn picked(c: Bool) -> Bool = { let x = if c { Hearts } else { Spades }; let y = if c { Spades } else { Hearts }; x == y }\n",
    ]),
  );
  assert_eq(operators_applied(p, b"s"), Ok([{ operation: b"bytes_eq", on: AsWord }]));
  assert_eq(operators_applied(p, b"bs"), Ok([{ operation: b"bytes_ne", on: AsWord }]));
  let operator_summary = |name: Bytes|
    match operators_applied(p, name) {
      Ok(xs) ->
        xs.map(|x: { operation: Bytes, on: Representation }|
          { operation: x.operation, sum: match x.on { AsSum(_) -> true, _ -> false } }),
      Err(reason) -> [{ operation: reason, sum: false }],
    };
  assert_eq(operator_summary(b"suit"), [{ operation: b"ne", sum: true }]);
  assert_eq(operator_summary(b"picked"), [{ operation: b"eq", sum: true }])
}

test "`==` and `!=` on an `Option` or a `Result` call a comparison function generated for that type" {
  let p = program(
    Bytes::concat_all([
      b"fn ints(a: Option<Int>, b: Option<Int>) -> Bool = a == b\n",
      b"fn texts(a: Option<String>, b: Option<String>) -> Bool = a != b\n",
      b"fn results(a: Result<Int, String>, b: Result<Int, String>) -> Bool = a == b\n",
    ]),
  );
  let equal = |ty: Type| Ok([written_root(keys::ContainerWalk(b"equal"), ty)]);
  assert_eq(roots_called(p, b"ints"), equal(option_type(int_type())));
  assert_eq(roots_called(p, b"texts"), equal(option_type(string_type())));
  assert_eq([b"ints", b"texts"].map(|n: Bytes| natives(p, n)), [Ok([]), Ok([])]);
  assert_eq(roots_called(p, b"results"), equal(result_type(int_type(), string_type())))
}

test "`==`, `!=` and `compare` on a declared sum type call comparison functions generated for that type" {
  let p = program(
    Bytes::concat_all([
      b"type Shape = | Circle(Int) | Square(Int, Int)\n",
      b"fn same(a: Shape, b: Shape) -> Bool = a == b\n",
      b"fn apart(a: Shape, b: Shape) -> Bool = a != b\n",
      b"fn order(a: Shape, b: Shape) -> Ordering = compare(a, b)\n",
    ]),
  );
  let shape = applied(b"m.Shape", []);
  assert_eq(roots_called(p, b"same"), Ok([written_root(keys::Equal, shape)]));
  assert_eq(operators_applied(p, b"apart"), Ok([{ operation: b"not", on: AsBool }]));
  assert_eq(roots_called(p, b"order"), Ok([written_root(keys::Order, shape)]));
  assert_eq(operators_applied(p, b"order"), Ok([]))
}

test "comparing a `List` or a `Map` calls a comparison function generated for that container type" {
  let p = program(
    b"fn lists(a: List<Int>, b: List<Int>) -> Bool = a == b\nfn maps(a: Map<Int, String>, b: Map<Int, String>) -> Ordering = compare(a, b)\n",
  );
  assert_eq(
    roots_called(p, b"lists"),
    Ok([written_root(keys::ContainerWalk(b"equal"), list_type(int_type()))]),
  );
  {
    let f = lowered_root(p, b"lists");
    assert_eq(
      values(f.body).fold([], |accumulator: List<Representation>, v: Rvalue|
        match v { Call(c) -> accumulator.push(c.convention.result), _ -> accumulator }),
      [AsBool],
    )
  };
  assert_eq(
    roots_called(p, b"maps"),
    Ok([written_root(keys::ContainerWalk(b"ordered"), map_type(int_type(), string_type()))]),
  )
}

test "`compare` on an `Int`, `Char`, `String`, `U16` or `Decimal` uses a built-in ordering operation and builds an `Ordering` value" {
  let p = program(
    Bytes::concat_all([
      b"fn ci(a: Int, b: Int) -> Ordering = compare(a, b)\n",
      b"fn cc(a: Char, b: Char) -> Ordering = compare(a, b)\n",
      b"fn cs(a: String, b: String) -> Ordering = compare(a, b)\n",
      b"fn cw(a: U16, b: U16) -> Ordering = compare_values(a, b)\n",
      b"fn cd(a: Decimal, b: Decimal) -> Ordering = compare(a, b)\n",
    ]),
  );
  let made = { operation: b"ordering", on: AsInt };
  assert_eq(operators_applied(p, b"ci"), Ok([{ operation: b"order", on: AsInt }, made]));
  assert_eq(operators_applied(p, b"cc"), Ok([{ operation: b"order", on: AsImmediate }, made]));
  assert_eq(operators_applied(p, b"cs"), Ok([{ operation: b"bytes_order", on: AsWord }, made]));
  assert_eq(
    operators_applied(p, b"cw"),
    Ok([{ operation: b"order", on: width_representation(16, false) }, made]),
  );
  assert_eq(operators_applied(p, b"cd"), Ok([{ operation: b"order", on: AsDecimal }, made]));
  assert_eq([b"ci", b"cc", b"cs", b"cw", b"cd"].map(|n: Bytes| roots_called(p, n)), [
    Ok([]),
    Ok([]),
    Ok([]),
    Ok([]),
    Ok([]),
  ])
}

test "integer conversions, wrapping, rotation and saturating operations compile to built-in operations on the operand type" {
  let p = program(
    Bytes::concat_all([
      b"fn n(x: Int) -> U8 / {abort.raise} = U8::of_int(x)\n",
      b"fn i(a: U16) -> Int = Int::of_u16(a)\n",
      b"fn w(a: U32, b: U32) -> U32 = a *% b\n",
      b"fn r(a: U32) -> U32 = rotl(a, 5)\n",
      b"fn s(a: I8, b: I8) -> I8 = a -| b\n",
      b"fn f(n: Int) -> Float = Float::of_int(n)\n",
      b"fn bits(x: Float) -> Int = bits_of_float(x)\n",
    ]),
  );
  assert_eq(operators_applied(p, b"n"), Ok([{ operation: b"of_int", on: AsInt }]));
  assert_eq(
    operators_applied(p, b"i"),
    Ok([{ operation: b"to_int", on: width_representation(16, false) }]),
  );
  assert_eq(
    operators_applied(p, b"w"),
    Ok([{ operation: b"wrap_mul", on: width_representation(32, false) }]),
  );
  assert_eq(
    operators_applied(p, b"r"),
    Ok([{ operation: b"rotl", on: width_representation(32, false) }]),
  );
  assert_eq(
    operators_applied(p, b"s"),
    Ok([{ operation: b"saturating_sub", on: width_representation(8, true) }]),
  );
  assert_eq(operators_applied(p, b"f"), Ok([{ operation: b"to_float", on: AsInt }]));
  assert_eq(operators_applied(p, b"bits"), Ok([{ operation: b"bits", on: AsFloat }]));
  {
    let f = lowered_root(p, b"n");
    assert_eq(bound_in(f.body).map(|v: Variable| v.representation), [
      width_representation(8, false),
    ])
  }
}

test "`Float` functions that IEEE 754 defines, such as `sqrt`, compile to one operator, and others such as `atan2` call a runtime function on the float bits" {
  let p = program(
    Bytes::concat_all([
      b"fn root(x: Float) -> Float = x.sqrt()\n",
      b"fn down(x: Float) -> Float = Float::floor(x)\n",
      b"fn angle(y: Float, x: Float) -> Float = Float::atan2(y, x)\n",
    ]),
  );
  assert_eq(natives(p, b"root"), Ok([]));
  assert_eq(operators_applied(p, b"root"), Ok([{ operation: b"sqrt", on: AsFloat }]));
  assert_eq(operators_applied(p, b"down"), Ok([{ operation: b"floor", on: AsFloat }]));
  assert_eq(natives(p, b"angle"), Ok([b"builtin_elaborated_float_atan2_p"]));
  assert_eq(
    operators_applied(p, b"angle"),
    Ok([
      { operation: b"bits", on: AsFloat },
      { operation: b"bits", on: AsFloat },
      { operation: b"of_bits", on: AsInt },
    ]),
  )
}

test "a `Secret`'s `len`, `is_empty`, `bytes` and `concat` call runtime functions instead of operators" {
  let p = program(
    Bytes::concat_all([
      b"fn n(s: Secret<Bytes>) -> Int = s.len()\n",
      b"fn none(s: Secret<String>) -> Bool = s.is_empty()\n",
      b"fn raw(s: Secret<String>) -> Secret<Bytes> = s.bytes()\n",
      b"fn both(a: Secret<Bytes>, b: Secret<Bytes>) -> Secret<Bytes> = Secret::concat(a, b)\n",
    ]),
  );
  assert_eq([b"n", b"none", b"raw", b"both"].map(|f: Bytes| natives(p, f)), [
    Ok([b"builtin_elaborated_secret_len_p"]),
    Ok([b"builtin_elaborated_secret_len_p"]),
    Ok([b"builtin_elaborated_secret_bytes_p"]),
    Ok([b"builtin_elaborated_secret_concat_p"]),
  ]);
  assert_eq(operators_applied(p, b"none"), Ok([{ operation: b"eq", on: AsInt }]));
  let secret = secret_type(bytes_type());
  assert_eq(
    [b"raw", b"both"].map(|f: Bytes| {
      let x = lowered_root(p, f);
      Ok(bound_in(x.body).map(|v: Variable| v.ty))
    }),
    [Ok([secret]), Ok([secret])],
  )
}

test "comparing two values of a type variable calls no native function and requires the caller to pass the variable's exact type" {
  let p = program(b"fn same<a>(x: a, y: a) -> Bool = x != y\n");
  assert_eq(natives(p, b"same"), Ok([]));
  {
    let f = lowered_root(p, b"same");
    match f.params.at(0) {
      Some(x) -> match x.ty {
        VariableType(v) -> assert_eq(f.links.needs, [{ var: v, reads: Exact }]),
        other -> assert_eq(Some(other), None),
      },
      None -> assert_eq(f.params.len(), 2),
    }
  }
}

test "a string constant is a static object, a `Decimal` or `U128` constant is built from two 64-bit parts, and other scalar constants are written directly" {
  let p = program(
    Bytes::concat_all([
      b"fn text() -> String = \"ply\"\n",
      b"fn dec() -> Decimal = 2.50m\n",
      b"fn huge() -> U128 = 7u128\n",
      b"fn unit() -> Unit = ()\n",
      b"fn top() -> U64 = 18446744073709551615u64\n",
    ]),
  );
  let read = |name: Bytes| {
    let f = lowered_root(p, name);
    Ok(match f.body.at(0) {
      Some(Let(l)) -> Some({ value: l.value, representation: l.var.representation }),
      _ -> None,
    })
  };
  let named = |s: Datum| Static(statics_of(s).get(0).name);
  assert_eq(read(b"text"), Ok(Some({ value: named(StringDatum(b"ply")), representation: AsWord })));
  assert_eq(
    read(b"dec"),
    Ok(
      Some({
        value: Primitive({
          operation: b"decimal",
          on: AsInt,
          args: [IntOperand(2 << 16 | 250 << 32), IntOperand(0)],
        }),
        representation: AsDecimal,
      }),
    ),
  );
  assert_eq(
    read(b"huge"),
    Ok(
      Some({
        value: Primitive({ operation: b"wide", on: AsInt, args: [IntOperand(7), IntOperand(0)] }),
        representation: AsWideFixed({ bits: 128, signed: false }),
      }),
    ),
  );
  assert_eq(read(b"unit"), Ok(None));
  {
    let f = lowered_root(p, b"top");
    assert_eq(values(f.body).filter(|v: Rvalue| match v { Literal(_) -> true, _ -> false }), [])
  };
  match printed_by_ir(p, b"text") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(t) -> {
      let address = Bytes::concat_all([
        b"(Word)(intptr_t)&",
        statics_of(StringDatum(b"ply")).get(0).name,
      ]);
      assert(t.index_of(address) != None, None)
    },
  }
}

test "`Int` multiplication, wrapping and saturating operators, `U64` saturating multiplication, `Int::of_u64` and `Decimal::of_int` compile to C without native calls" {
  let p = program(
    Bytes::concat_all([
      b"fn mul(a: Int, b: Int) -> Int = a * b\n",
      b"fn wrapped(a: Int, b: Int) -> Int = a +% b *% b\n",
      b"fn turned(a: Int) -> Int = rotr(a, 7)\n",
      b"fn held(a: Int, b: Int) -> Int = a -| b\n",
      b"fn held_wide(a: U64, b: U64) -> U64 = a *| b\n",
      b"fn back(a: U64) -> Int / {abort.raise} = Int::of_u64(a)\n",
      b"fn dec(n: Int) -> Decimal = Decimal::of_int(n)\n",
      b"fn scaled(d: Decimal) -> Int = d.scale()\n",
    ]),
  );
  let names = [b"mul", b"wrapped", b"turned", b"held", b"held_wide", b"back", b"dec", b"scaled"];
  assert_eq(names.map(|n: Bytes| natives(p, n)), names.map(|_: Bytes| Ok([])));
  match printed_by_ir(p, b"mul") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(t) -> assert(t.index_of(b"ply_mul_ov(") != None && t.index_of(b"rt_arith_p(") == None, None),
  };
  match printed_by_ir(p, b"back") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(t) -> assert(t.index_of(b"ply_not_an_int(ctx, ") != None, None),
  }
}

test "a digest hashes the encoding of a scalar's words, or a root's, in place" {
  let p = program(
    Bytes::concat_all([
      b"type P = { x: Int, name: String }\n",
      b"fn h(x: Int) -> Bytes = digest(x)\n",
      b"fn g<a>(x: a) -> Bytes where derivable(hash, a) = digest(x)\n",
      b"fn hr(x: P) -> Bytes = digest(x)\n",
    ]),
  );
  assert_eq([b"h", b"g", b"hr"].map(|n: Bytes| natives(p, n)), [
    Ok([b"ply_scalar_encoded", b"builtin_elaborated_blake3_p"]),
    Ok([]),
    Ok([b"builtin_elaborated_blake3_p"]),
  ]);
  assert_eq(
    roots_called(p, b"hr").map(|rs: List<RootName>|
      rs.map(|r: RootName| root_text(r).starts_with(b"m.digest#"))),
    Ok([true]),
  )
}

test "multiplication, division and remainder on 64-bit integers compile to C that checks for overflow, with no wide-integer runtime call" {
  let p = program(
    b"fn m(a: U64, b: U64) -> U64 = a * b\nfn q(a: I64, b: I64) -> I64 / {abort.raise} = a / b\nfn r(a: U64, b: U64) -> U64 / {abort.raise} = a % b\n",
  );
  [b"m", b"q", b"r"].fold((), |_: Unit, n: Bytes|
    match printed_by_ir(p, n) {
      Err(reason) -> assert_eq(reason, b""),
      Ok(t) -> assert(t.index_of(b"rt_wide_binary") == None, Some(String::of_bytes_lossy(t))),
    })
}

test "128-bit saturating addition uses built-in operators, and `checked_mul` on `U64` and `checked_neg` on `Int` use a checked operator plus a wrapping one" {
  let p = program(
    Bytes::concat_all([
      b"fn sat(a: U128, b: U128) -> U128 = a +| b\n",
      b"fn big(a: I128) -> Option<I128> = checked_neg(a)\n",
    ]),
  );
  let wide = AsWideFixed({ bits: 128, signed: true });
  let q = program(
    Bytes::concat_all([
      b"fn word(a: U64, b: U64) -> Option<U64> = checked_mul(a, b)\n",
      b"fn int(a: Int) -> Option<Int> = checked_neg(a)\n",
    ]),
  );
  let u64 = width_representation(64, false);
  let i64 = width_representation(64, true);
  assert_eq(
    operators_applied(q, b"word"),
    Ok([{ operation: b"checked_mul", on: u64 }, { operation: b"wrap_mul", on: u64 }]),
  );
  assert_eq(
    operators_applied(q, b"int"),
    Ok([{ operation: b"checked_neg", on: i64 }, { operation: b"wrap_sub", on: i64 }]),
  );
  assert_eq([b"word", b"int"].map(|n: Bytes| natives(q, n)), [Ok([]), Ok([])]);
  assert_eq(
    operators_applied(p, b"sat"),
    Ok([{ operation: b"saturating_add", on: AsWideFixed({ bits: 128, signed: false }) }]),
  );
  assert_eq(
    operators_applied(p, b"big"),
    Ok([{ operation: b"checked_neg", on: wide }, { operation: b"wrap_sub", on: wide }]),
  );
  assert_eq([b"sat", b"big"].map(|n: Bytes| natives(p, n)), [Ok([]), Ok([])]);
  match printed_by_ir(p, b"sat") {
    Err(reason) -> assert_eq(reason, b""),
    Ok(t) ->
      assert(
        t.index_of(b"ply_wide_sat_add(") != None && t.index_of(b"rt_wide_op") == None,
        Some(String::of_bytes_lossy(t)),
      ),
  }
}

test "checked arithmetic on a narrow integer is computed exactly in 64 bits and returns `Some` only when the result fits the integer type" {
  let p = program(
    Bytes::concat_all([
      b"fn add(a: U8, b: U8) -> Option<U8> = checked_add(a, b)\n",
      b"fn mul(a: U32, b: U32) -> Option<U32> = checked_mul(a, b)\n",
      b"fn neg(a: I16) -> Option<I16> = checked_neg(a)\n",
    ]),
  );
  assert_eq(
    operators_applied(p, b"add"),
    Ok([
      { operation: b"exact_add", on: width_representation(8, false) },
      { operation: b"within", on: AsInt },
      { operation: b"narrow", on: AsInt },
    ]),
  );
  assert_eq(
    operators_applied(p, b"mul"),
    Ok([
      { operation: b"exact_mul", on: width_representation(32, false) },
      { operation: b"le", on: width_representation(64, false) },
      { operation: b"narrow", on: width_representation(64, false) },
    ]),
  );
  assert_eq(
    operators_applied(p, b"neg"),
    Ok([
      { operation: b"exact_neg", on: width_representation(16, true) },
      { operation: b"within", on: AsInt },
      { operation: b"narrow", on: AsInt },
    ]),
  );
  assert_eq([b"add", b"mul", b"neg"].map(|n: Bytes| natives(p, n)), [Ok([]), Ok([]), Ok([])])
}

test "a user-declared `numeric` instance is identified by its constructor's tag, numbered after the instances the runtime numbers itself" {
  let p = program(
    Bytes::concat_all([
      b"type Length = | Metres(Int) | Millimetres(Int)\n",
      b"key for Length by millimetres\n",
      b"numeric for Length by { add: plus, sub: plus, mul: plus, neg: negated, of_int: metres }\n",
      b"fn millimetres(l: Length) -> Int = match l { Metres(n) -> n * 1000, Millimetres(n) -> n }\n",
      b"fn plus(a: Length, b: Length) -> Length = a\n",
      b"fn negated(a: Length) -> Length = a\n",
      b"fn metres(n: Int) -> Length = Metres(n)\n",
      b"fn twice<a>(x: a) -> a\n  where numeric(a)\n= x + x\n",
      b"fn doubled(g: Length) -> Length = twice(g)\n",
    ]),
  );
  {
    let f = lowered_root(p, b"doubled");
    assert_eq(
      values(f.body).fold([], |accumulator: List<Bytes>, v: Rvalue|
        match v {
          Tag(n) ->
            accumulator.push(if n == b"m.Metres" || n == b"m.Millimetres" { b"a tag of Length" }
            else { n }),
          Primitive(x) -> if x.operation == b"witness" { accumulator.push(b"13 +") }
          else { accumulator },
          _ -> accumulator,
        }),
      [b"a tag of Length", b"13 +"],
    );
    assert_eq(values(f.body).filter(|v: Rvalue| match v { Literal(_) -> true, _ -> false }), [])
  }
}

test "negation of a declared sum type calls the `neg` function from its `numeric` declaration, not a runtime function" {
  let p = program(
    Bytes::concat_all([
      b"type Length = | Metres(Int) | Millimetres(Int)\n",
      b"numeric for Length by { add: plus, sub: plus, mul: plus, neg: negated, of_int: metres }\n",
      b"fn plus(a: Length, b: Length) -> Length = a\n",
      b"fn negated(a: Length) -> Length = a\n",
      b"fn metres(n: Int) -> Length = Metres(n)\n",
      b"fn back(g: Length) -> Length = -g\n",
    ]),
  );
  assert_eq(natives(p, b"back"), Ok([]))
}

fn corpus_program() -> Program / {abort.raise} = program(corpus())

fn corpus() -> Bytes =
  Bytes::concat_all([
    b"type Suit = | Hearts | Spades\n",
    b"type Card = | Pip(Int) | Face(String)\n",
    b"fn add8(a: U8, b: U8) -> U8 = a + b\n",
    b"fn mul16(a: I16, b: I16) -> I16 = a * b\n",
    b"fn sub64(a: I64, b: I64) -> I64 = a - b\n",
    b"fn neg8(a: I8) -> I8 = -a\n",
    b"fn neg64(a: I64) -> I64 = -a\n",
    b"fn inv32(a: U32) -> U32 = ~a\n",
    b"fn shl8(a: U8) -> U8 = a << 3\n",
    b"fn sar(a: Int, n: Int) -> Int = a >> n\n",
    b"fn lsr(a: Int, n: Int) -> Int = a >>> n\n",
    b"fn mix(a: Int, b: Int) -> Int = (a ^ b) & ~a\n",
    b"fn quotient(a: Int) -> Int / {abort.raise} = a / -4 - a % 3\n",
    b"fn ratio(x: Float, y: Float) -> Float = x / y % 2.0\n",
    b"fn below(x: Float, y: Float) -> Bool = x - y < 0.001\n",
    b"fn scaled(d: Decimal, e: Decimal) -> Decimal = d * e - d\n",
    b"fn dless(d: Decimal, e: Decimal) -> Bool = d >= e\n",
    b"fn dneg(d: Decimal) -> Decimal = -d\n",
    b"fn cless(a: Char, b: Char) -> Bool = a > b\n",
    b"fn cmid(a: Char) -> Bool = a != 'm'\n",
    b"fn texts(a: String, b: String) -> Bool = a == b\n",
    b"fn raw(a: Bytes, b: Bytes) -> Bool = a != b\n",
    b"fn joined(a: String, b: String) -> String = a ++ b\n",
    b"fn ordered(a: Int, b: Int) -> Ordering = compare(a, b)\n",
    b"fn sorted(a: String, b: String) -> Ordering = compare(a, b)\n",
    b"fn wordered(a: U16, b: U16) -> Ordering = compare(a, b)\n",
    b"fn bordered(a: Bool, b: Bool) -> Ordering = compare_values(a, b)\n",
    b"fn dordered(a: Decimal, b: Decimal) -> Ordering = compare(a, b)\n",
    b"fn cordered(a: Char, b: Char) -> Ordering = compare(a, b)\n",
    b"fn narrowed(x: Int) -> I16 / {abort.raise} = I16::of_int(x)\n",
    b"fn unsigned(x: Int) -> U64 / {abort.raise} = U64::of_int(x)\n",
    b"fn widened(x: I32) -> Int = Int::of_i32(x)\n",
    b"fn wrapped(a: U32, b: U32) -> U32 = a *% b +% rotl(a, 5)\n",
    b"fn turned(a: U8, n: Int) -> U8 = rotr(a, n)\n",
    b"fn clamped(a: U8, b: U8) -> U8 = a +| b\n",
    b"fn floated(n: Int) -> Float = Float::of_int(n) + Float::of_bits(n)\n",
    b"fn bits(x: Float) -> Int = bits_of_float(x)\n",
    b"fn big(a: U128, b: U128) -> U128 = a + b\n",
    b"fn bigeq(a: I128, b: I128) -> Bool = a == b\n",
    b"fn text() -> String = \"ply\"\n",
    b"fn dec() -> Decimal = 2.50m\n",
    b"fn huge() -> U128 = 7u128\n",
    b"fn unit() -> Unit = ()\n",
    b"fn suited(a: Suit, b: Suit) -> Bool = a == b\n",
    b"fn cards(a: Card, b: Card) -> Bool = a != b\n",
    b"fn ranked(a: Card, b: Card) -> Ordering = compare(a, b)\n",
    b"fn lists(a: List<Int>, b: List<Int>) -> Bool = a == b\n",
    b"fn generic<a>(x: a, y: a) -> Bool = x != y\n",
    b"fn same(a: Bool, b: Bool) -> Bool = a != b\n",
    b"fn flags(a: Bool) -> Bool = !a\n",
    b"type Pt = { x: Int, y: Int }\n",
    b"fn points(a: Pt, b: Pt) -> Bool = a == b\n",
    b"fn hashed(x: Int) -> Bytes = digest(x)\n",
    b"fn checked8(a: U8, b: U8) -> Option<U8> = checked_add(a, b)\n",
    b"fn wrapped64(a: Int, b: Int) -> Int = a *% b\n",
  ])

fn corpus_names() -> List<Bytes> =
  [
    b"add8",
