import compiler.check.types (named_type, Type, NamedType, RecordType, int_type, string_type,
                             list_type)
import compiler.check.known (chan_type)
import compiler.emit.emit_harness (program_of, printed_by_ir)
import compiler.emit.layout (SumCases)
import compiler.emit.representations
import compiler.emit.representations (Constructors)
import compiler.emit.release (Part, WordAt, ByCase, CaseBox, Object, WordBlock, layout_parts,
                              drop_of, generated, case_dropped, contains_unkeepable_value, root_of,
                              case_root)
import compiler.emit.keys
import compiler.emit.keys (RootKey, Named, TypeOperation, Drop, Dup, Copy, Share, Keep, Lower, Lift,
                           OnWordForm, generated_key, root_name, root_text)
import compiler.emit.verify (ownership_fault)
import compiler.emit.typed_ir (no_closure_evidence, Function, Variable, Block, Instruction, Case,
                               Destructure, Let, If, Restart, Decrement, Return, IfUnique,
                               VariableOperand, AsWord, AsSum, AsInt, Metered, BorrowedParam,
                               OwnedParam, OwnedResult, Closure, no_links)
import compiler.emit.borrow_inference (with_conventions)
import compiler.emit.root_emission (built_form)
import compiler.emit.lower.marshalling (serialization_function)
import compiler.emit.print.calling (lambda_text)
import compiler.emit.print.count_functions (allocates)
import compiler.emit.print.text (empty_printing)
import compiler.emit.output (SharedFunction)
import compiler.emit.pieces (pieces_text)
import compiler.emit.roots (symbol_of)
import compiler.syntax.parsing (span_between)
import compiler.emit.print (printed_function)

const corpus: Bytes =
  Bytes::concat_all([
    b"type Tree = | Leaf | Node(Tree, Int, Tree)\n",
    b"type Expr = | Num(Int) | Add(Expr, Expr) | Neg(Expr) | Name(String)\n",
    b"type Pair = { name: String, items: List<Int>, tree: Tree }\n",
    b"type Job = | Run((Int) -> Int, Int) | Idle\n",
    b"fn uses(t: Tree, e: Expr, p: Pair, j: Job) -> Int = 0\n",
  ])

const corpus_constructors: Result<Constructors, Bytes> =
  match program_of(corpus) { Ok(p) -> Ok(p.setting.constructors), Err(reason) -> Err(reason) }

fn instructions(b: Block) -> List<Instruction> =
  b.fold([], |accumulator: List<Instruction>, i: Instruction|
    match i {
      Case(c) ->
        c.arms.fold(
          accumulator.push(i).concat(instructions(c.rest)),
          |a: List<Instruction>, arm: { when: Int, body: Block }| a.concat(instructions(arm.body)),
        ),
      If(x) -> accumulator.push(i).concat(instructions(x.then)).concat(instructions(x.otherwise)),
      _ -> accumulator.push(i),
    })

fn opened_and_decremented(b: Block) -> { opened: List<Variable>, decremented: List<Variable> } =
  instructions(b).fold(
    { opened: [], decremented: [] },
    |accumulator: { opened: List<Variable>, decremented: List<Variable> }, i: Instruction|
      match i {
        Destructure(o) -> { ..accumulator, opened: accumulator.opened.concat(o.words) },
        Decrement(v) -> { ..accumulator, decremented: accumulator.decremented.push(v) },
        _ -> accumulator,
      },
  )

test "a tree type's release function releases the left subtree and then loops on the right subtree" {
  let tree = named_type(b"m.Tree");
  match corpus_constructors {
    Err(reason) -> assert_eq(reason, b""),
    Ok(constructors) -> {
      let f = generated(constructors, drop_of(tree));
      let all = instructions(f.body);
      let opens = all.fold(
        [],
        |accumulator: List<{ of: Variable, words: List<Variable> }>, i: Instruction|
          match i { Destructure(o) -> accumulator.push(o), _ -> accumulator },
      );
      let subtrees = opened_and_decremented(f.body).opened.filter(|v: Variable|
        v.ty == tree && !opens.any(|o: { of: Variable, words: List<Variable> }| o.of == v));
      assert_eq(subtrees.len(), 2);
      assert(opened_and_decremented(f.body).decremented.contains(subtrees.get(0)), None);
      let last = all.fold(None, |found: Option<Variable>, i: Instruction|
        match i {
          Let(l) -> if l.value == IfUnique(subtrees.get(1)) { Some(l.var) } else { found },
          _ -> found,
        });
      match last {
        Some(v) -> assert(all.contains(Restart([VariableOperand(v)])), None),
        None -> assert(false, None),
      }
    },
  }
}

test "a sum with many constructors is released one case at a time, with a separate function for each boxed case that releases nested sums whole" {
  let expression = named_type(b"m.Expr");
  match corpus_constructors {
    Err(reason) -> assert_eq(reason, b""),
    Ok(constructors) -> match representations::layout_of(constructors, expression) {
      SumCases(s) -> {
        match layout_parts(constructors, expression, SumCases(s), 0) {
          [ByCase(c)] ->
            assert_eq(
              c.cases.map(|k: { case: Int, parts: List<Part> }|
                k.parts.map(|p: Part| match p { WordAt(w) -> Some(w.how), ByCase(_) -> None })),
              [
                [Some(CaseBox({ sum: expression, case: 1 }))],
                [Some(CaseBox({ sum: expression, case: 2 }))],
                [Some(Object(drop_of(string_type)))],
              ],
            ),
          parts -> assert_eq(parts.len(), 1),
        };
        let add = case_dropped(
          constructors,
          Named(b"m.drop_add"),
          expression,
          1,
          |t: Type| representations::layout_of(constructors, t),
          |t: Type| representations::word_form(constructors, t),
        );
        let d = opened_and_decremented(add.body);
        assert_eq(d.opened.map(|v: Variable| v.ty), [expression, expression]);
        assert(
          d.opened.all(|v: Variable| match v.representation { AsSum(_) -> true, _ -> false }),
          None,
        );
        assert_eq(d.decremented, d.opened)
      },
      _ -> assert(false, None),
    },
  }
}

test "a record's release function releases its list, string and nested sum fields" {
  let pair = RecordType([
    { name: b"items", ty: list_type(int_type) },
    { name: b"name", ty: string_type },
    { name: b"tree", ty: named_type(b"m.Tree") },
  ]);
  match corpus_constructors {
    Err(reason) -> assert_eq(reason, b""),
    Ok(constructors) -> {
      let f = generated(constructors, drop_of(pair));
      let d = opened_and_decremented(f.body);
      assert_eq(d.opened.map(|v: Variable| v.ty), [
        list_type(named_type(b"Int")),
        named_type(b"String"),
        named_type(b"m.Tree"),
      ]);
      assert_eq(d.decremented, d.opened);
      assert(match d.opened.get(2).representation { AsSum(_) -> true, _ -> false }, None)
    },
  }
}

test "`holds_unkeepable_value` is true for a type that contains a function, even through a sum case's box, and returns for recursive types" {
  match corpus_constructors {
    Err(reason) -> assert_eq(reason, b""),
    Ok(constructors) -> {
      let contains_unkeepable = |ty: Type|
        contains_unkeepable_value(
          constructors,
          WordBlock({ parts: [{ at: 0, ty: ty, representation: AsWord }], words: 1 }),
        );
      let plan = RecordType([
        { name: b"job", ty: named_type(b"m.Job") },
        { name: b"name", ty: string_type },
      ]);
      assert_eq(contains_unkeepable(named_type(b"m.Tree")), false);
      assert_eq(contains_unkeepable(named_type(b"m.Expr")), false);
      assert_eq(contains_unkeepable(named_type(b"m.Job")), true);
      assert_eq(contains_unkeepable(plan), true)
    },
  }
}

test "a closure that captures a channel gets a `Keep` function equal to 0 that copies nothing, and sharing the closure works as before" {
  let int = int_type;
  let chan = chan_type(int);
  let body = {
    key: Named(b"m.outer"),
    kind: Metered,
    params: [
      { id: 0, ty: chan, representation: AsWord },
      { id: 1, ty: int, representation: AsInt },
    ],
    convention: {
      params: [
        { ownership: BorrowedParam, representation: AsWord },
        { ownership: OwnedParam, representation: AsInt },
      ],
      result: AsInt,
      destination_passing: false,
      returned: OwnedResult,
    },
    result_type: int,
    body: [Return(VariableOperand({ id: 1, ty: int, representation: AsInt }))],
    lambdas: [],
    base: 0,
    members: [],
    links: no_links,
    statics: [],
  };
  let l = Closure({ body: body, captures: 1, at: span_between(0, 0), words: no_closure_evidence });
  let printed = lambda_text(symbol_of(b"m.outer"), 0, l, empty_printing(Map::new()));
  let text = Bytes::concat_all(
    printed.printing.shared.map(|s: SharedFunction| s.text).push(pieces_text(printed.out)),
  );
  let name = symbol_of(b"m.outer").concat(b"_lambda0");
  let named = match text.index_of(name.concat(b"_desc = { ")) {
    Some(i) -> text.slice(i + name.len() + 10, text.len()),
    None -> b"",
  };
  let entries = named.slice(0, match named.index_of(b" };") { Some(e) -> e, None -> 0 }).split(
    b", ",
  );
  let defined = |at: Int|
    match text.index_of(entries.get(at).concat(b"(PlyCtx")) {
      Some(i) -> match text.index_of_from(b"\n}\n", i) { Some(j) -> text.slice(i, j), None -> b"" },
      None -> b"",
    };
  let message = Some(String::of_bytes_lossy(text));
  let keep = defined(5);
  assert(keep.len() > 0 && keep.index_of(b"= 0;") != None && !allocates(keep), message);
  assert(defined(4).index_of(b"= 0;") != None, message)
}

fn ownership_faults(k: RootKey, f: Function) -> List<Bytes> / {abort.raise} = {
  let recomputed = with_conventions(f, Map::new());
  if recomputed.convention != f.convention {
    [
      root_text(root_name(k)).concat(
        b" has a calling convention that differs from the one recomputed from its body",
      ),
    ]
  } else {
    match ownership_fault(built_form(recomputed)) {
      Some(reason) -> [root_text(root_name(k)).concat(b": ").concat(reason)],
      None -> [],
    }
  }
}

test "every function generated for a type takes each argument as owned or borrowed as its declared parameter ownership says, and passes the reference-count check" {
  let expression = named_type(b"m.Expr");
  let pair = RecordType([
    { name: b"items", ty: list_type(int_type) },
    { name: b"name", ty: string_type },
    { name: b"tree", ty: named_type(b"m.Tree") },
  ]);
  let types = [named_type(b"m.Tree"), expression, pair, named_type(b"m.Job"), string_type];
  let over = |operations: List<TypeOperation>, key: (TypeOperation, Type) -> RootKey|
    operations.fold([], |accumulator: List<RootKey>, operation: TypeOperation|
      accumulator.concat(types.map(|t: Type| key(operation, t))));
  match corpus_constructors {
    Err(reason) -> assert_eq(reason, b""),
    Ok(constructors) -> {
      let plain = over(
        [
          Drop,
          Dup,
          keys::Release,
          Copy,
          Share,
          Keep,
          keys::Unboxed(Dup),
          keys::Unboxed(keys::Release),
        ],
        root_of,
      ).concat(
        [Drop, Share, Keep].fold([], |accumulator: List<RootKey>, operation: TypeOperation|
          accumulator.concat([
            case_root(operation, expression, 1),
            case_root(operation, expression, 2),
          ])),
      );
      let entries = over(
        [OnWordForm(Lower), OnWordForm(Lift)],
        |operation: TypeOperation, t: Type| generated_key(operation, t, b"m"),
      );
      assert_eq(
        plain.fold([], |accumulator: List<Bytes>, k: RootKey|
          accumulator.concat(ownership_faults(k, generated(constructors, k)))).concat(
          entries.fold([], |accumulator: List<Bytes>, k: RootKey|
            accumulator.concat(ownership_faults(k, serialization_function(constructors, k)))),
        ),
        [],
      )
    },
  }
}

test "a sum stored in several reference-counted words is released by one call to its type's release function, which passes the check and decrements each word" {
  let source = Bytes::concat_all([
    b"type Duo = | Both(String, List<Int>) | Neither\n",
    b"fn g(n: Int) -> Int / {abort.raise} = if n > 3 { panic(\"big\") } else { n }\n",
    b"fn kept(d: Duo, n: Int) -> Duo / {abort.raise} = { let m = g(n); if m > 0 { d } else { d } }\n",
    b"fn pick(d: Duo, b: Bool) -> Duo = if b { d } else { Neither }\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let unboxed_key = |operation: TypeOperation|
        root_of(keys::Unboxed(operation), named_type(b"m.Duo"));
      let call = |k: RootKey| symbol_of(root_text(root_name(k))).concat(b"(ctx, ");
      let calls_in = |name: Bytes, k: RootKey|
        match printed_by_ir(p, name) {
          Ok(t) -> t.split(call(k)).len() - 1,
          Err(reason) -> panic(String::of_bytes_lossy(reason)),
        };
      assert_eq(
        [
          calls_in(b"pick", unboxed_key(keys::Release)),
          calls_in(b"kept", unboxed_key(keys::Release)),
        ],
        [1, 1],
      );
      [keys::Release, Dup].fold((), |_: Unit, operation: TypeOperation| {
        let f = generated(p.setting.constructors, unboxed_key(operation));
        let built = built_form(f);
        let c = pieces_text(printed_function(built, p.setting.constructors).pieces);
        let body = match c.index_of(b"_entry(PlyCtx *ctx, const Word *args) {") {
          Some(at) -> c.slice(0, at),
          None -> c,
        };
        let each = if operation == Dup { b"ply_dup(" } else { b"ply_rel" };
        assert(
          ownership_fault(built) == None && body.split(each).len() - 1 == 2
            && !body.contains(call(unboxed_key(operation))),
          Some(String::of_bytes_lossy(c)),
        )
      })
    },
  }
}

test "the release function for a sum stored in one word also handles a case with no allocation, so every path passes the ownership check" {
  let source = b"type Found = | Hit(Bytes) | Miss | Bad(String)\ntype L = | Nil | Cons(Int, L)\nfn uses(f: Found, l: L) -> Int = 0\n";
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) ->
      assert_eq(
        [named_type(b"m.Found"), named_type(b"m.L")].map(|t: Type| {
          let f = generated(p.setting.constructors, drop_of(t));
          ownership_fault(f)
        }),
        [None, None],
      ),
  }
}
