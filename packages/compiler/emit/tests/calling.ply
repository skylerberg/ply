fn lowered_as_built(p: Program, name: Bytes) -> Fn / {abort.raise} =
  lowered_by_key(p, Named(qualify(b"m", name)))

fn lowered_by_key(p: Program, key: RootKey) -> Fn / {abort.raise} =
  match range(0, p.roots.len()).find(|i: Int| p.roots.get(i).key == key) {
    None ->
      panic(String::of_bytes_lossy(b"no such definition: ".concat(root_text(root_name(key))))),
    Some(i) -> {
      let r = p.roots.get(i);
      let body = known_body(root_text(root_name(r.key)), r.params, r.code);
      lowered_fn(context_of(p.setting, r, body), body)
    },
  }

fn corpus_program() -> Program / {abort.raise} =
  match program_of(corpus()) { Ok(p) -> p, Err(why) -> panic(String::of_bytes_lossy(why)) }

fn lowered(name: Bytes) -> Fn / {abort.raise} = lowered_as_built(corpus_program(), name)

fn vals_in(b: Block) -> List<Rvalue> =
  b.fold([], |acc: List<Rvalue>, i: Inst|
    match i {
      Let(l) -> acc.push(l.value),
      Do(d) -> acc.push(d.value),
      If(x) -> acc.concat(vals_in(x.then)).concat(vals_in(x.otherwise)),
      Case(c) ->
        c.arms.fold(acc, |a: List<Rvalue>, arm: { when: Int, body: Block }|
          a.concat(vals_in(arm.body))).concat(
          vals_in(c.rest),
        ),
      Match(m) ->
        m.arms.fold(acc, |a: List<Rvalue>, arm: Block| a.concat(vals_in(arm))).concat(
          vals_in(m.rest),
        ),
      Loop(l) -> acc.concat(vals_in(l.body)),
      _ -> acc,
    })

fn bound_in(b: Block) -> List<Var> =
  b.fold([], |acc: List<Var>, i: Inst|
    match i {
      Let(l) -> acc.push(l.var),
      If(x) -> acc.concat(bound_in(x.then)).concat(bound_in(x.otherwise)),
      Case(c) ->
        c.arms.fold(acc, |a: List<Var>, arm: { when: Int, body: Block }|
          a.concat(bound_in(arm.body))).concat(
          bound_in(c.rest),
        ),
      Match(m) ->
        m.arms.fold(acc, |a: List<Var>, arm: Block| a.concat(bound_in(arm))).concat(
          bound_in(m.rest),
        ),
      Loop(l) -> acc.concat(bound_in(l.body)),
      _ -> acc,
    })

fn restarts(b: Block) -> Bool =
  b.fold(false, |found: Bool, i: Inst|
    found
      || (match i {
        Restart(_) -> true,
        If(x) -> restarts(x.then) || restarts(x.otherwise),
        _ -> false,
      }))

fn closure_of(f: Fn, nth: Int) -> Option<{ body: Fn, captures: Int }> =
  match f.lambdas.at(nth) {
    Some(Closure(c)) -> Some({ body: c.body, captures: c.captures }),
    None -> None,
  }

fn lets_in(b: Block) -> List<{ var: Var, value: Rvalue }> =
  b.fold([], |acc: List<{ var: Var, value: Rvalue }>, i: Inst|
    match i {
      Let(l) -> acc.push({ var: l.var, value: l.value }),
      Handle(h) -> acc.concat(lets_in(h.body)),
      _ -> acc,
    })

test "a handle where a task may be spawned lays its instance on the heap, which the closure the spawn is handed holds" {
  let src = Bytes::concat_all([
    b"effect note {\n  write say(n: Int) -> Unit\n}\n",
    b"fn sayer() -> Int / {abort.raise, sim.read} = simulate { handle { let t = task.spawn(|| { note.say(1); 2 }); task.join(t) } with { note.say(n) -> () } }\n",
  ]);
  match scheduled_program_of(src) {
    Err(why) -> assert_eq(why, b""),
    Ok(p) -> {
      let f = lowered_as_built(p, b"sayer");
      let lets = f.lambdas.fold(
        lets_in(f.body),
        |acc: List<{ var: Var, value: Rvalue }>, l: Lambda|
          match l { Closure(c) -> acc.concat(lets_in(c.body.body)) },
      );
      let blocks = lets.filter(|x: { var: Var, value: Rvalue }|
        match x.value {
          Op(o) -> match o.op { OfHandling(HeapInstance(_)) -> true, _ -> false },
          _ -> false,
        });
      assert_eq(blocks.len(), 1);
      assert(
        lets.any(|x: { var: Var, value: Rvalue }|
          match x.value {
            Allocate(m) ->
              m.args.any(|a: Arg|
                blocks.any(|b: { var: Var, value: Rvalue }| a == VarOperand(b.var))),
            _ -> false,
          }),
        None,
      )
    },
  }
}

test "a call of a definition hands its arguments as the callee carries them" {
  {
    let f = lowered(b"twice");
    assert_eq(
      vals_in(f.body).fold(
        [],
        |acc: List<{ representations: List<Representation>, result: Representation }>, v: Rvalue|
          match v {
            Call(c) -> if c.callee == Root(Named(b"m.add")) {
              acc.push({ representations: reps_of(c.convention), result: c.convention.result })
            } else { acc },
            _ -> acc,
          },
      ),
      [{ representations: [AsInt, AsInt], result: AsInt }],
    )
  };
  {
    let f = lowered(b"handed");
    assert_eq(
      vals_in(f.body).fold([], |acc: List<List<Representation>>, v: Rvalue|
        match v { Call(c) -> acc.push(reps_of(c.convention).push(c.convention.result)), _ -> acc }),
      [[AsWord, AsWord]],
    )
  }
}

test "a small record crosses a call as its fields and its word, both ways" {
  {
    let f = lowered(b"summed");
    assert_eq(
      vals_in(f.body).fold(
        [],
        |acc: List<{ representations: List<Representation>, result: Representation }>, v: Rvalue|
          match v {
            Call(c) -> if c.callee == Root(Named(b"m.swapped")) {
              acc.push({ representations: reps_of(c.convention), result: c.convention.result })
            } else { acc },
            _ -> acc,
          },
      ),
      [
        {
          representations: [
            AsFlattened([
              { name: b"x", representation: AsInt },
              { name: b"y", representation: AsInt },
            ]),
          ],
          result: AsFlattened([
            { name: b"x", representation: AsInt },
            { name: b"y", representation: AsInt },
          ]),
        },
      ],
    )
  }
}

test "a lambda and a function value take a small record as its fields too" {
  let fields = AsFlattened([
    { name: b"x", representation: AsInt },
    { name: b"y", representation: AsInt },
  ]);
  {
    let f = lowered(b"pair_summer");
    match closure_of(f, 0) {
      None -> assert(false, Some("pair_summer makes no closure")),
      Some(c) ->
        assert_eq(reps_of(c.body.convention).drop(c.captures).push(c.body.convention.result), [
          fields,
          AsInt,
        ]),
    }
  };
  {
    let f = lowered(b"applied_pair");
    assert_eq(
      vals_in(f.body).fold([], |acc: List<List<Representation>>, v: Rvalue|
        match v {
          Apply(a) -> acc.push(reps_of(a.convention).push(a.convention.result)),
          _ -> acc,
        }),
      [[fields, AsImmediate, AsImmediate, AsInt]],
    )
  }
}

test "a call of a generic definition is the body's generic call at the reference's type arguments" {
  {
    let f = lowered(b"ident_int");
    assert_eq(f.links.generics, [
      { callee: Named(b"m.ident"), args: [int_type()], carried: [0], functions: [], rows: [] },
    ]);
    assert_eq(
      vals_in(f.body).fold([], |acc: List<List<Representation>>, v: Rvalue|
        match v {
          Call(c) -> if c.callee == Generic(0) {
            acc.push(reps_of(c.convention).push(c.convention.result))
          } else { acc },
          _ -> acc,
        }),
      [[AsInt, AsInt]],
    )
  };
  {
    let f = lowered(b"ident_word");
    assert_eq(f.links.generics, [
      { callee: Named(b"m.ident"), args: [string_type()], carried: [], functions: [], rows: [] },
    ])
  }
}

test "a self call in tail position restarts the body, and a lambda's call of its root's definition calls it" {
  {
    let f = lowered(b"count");
    assert(restarts(f.body), None)
  };
  {
    let f = lowered(b"counter");
    match closure_of(f, 0) {
      None -> assert(false, Some("counter makes no closure")),
      Some(c) -> {
        assert(!restarts(c.body.body), None);
        assert_eq(
          vals_in(c.body.body).filter(|v: Rvalue|
            match v { Call(x) -> x.callee == Root(Named(b"m.count")), _ -> false }).len(
          ),
          1,
        )
      },
    }
  }
}

test "a lambda is a closure of a function of its own taking its captures as words, then its parameters" {
  {
    let f = lowered(b"adder");
    assert_eq(f.lambdas.len(), 1);
    assert_eq(
      vals_in(f.body).fold([], |acc: List<{ captures: Int, params: Int, args: Int }>, v: Rvalue|
        match v {
          Allocate(m) -> match m.made {
            ClosureAllocation(c) -> if c.nth == 0 {
              acc.push({ captures: c.captures, params: c.params, args: m.args.len() })
            } else { acc },
            _ -> acc,
          },
          _ -> acc,
        }),
      [{ captures: 1, params: 1, args: 1 }],
    );
    match closure_of(f, 0) {
      None -> assert(false, Some("adder makes no closure")),
      Some(c) -> {
        assert_eq(c.captures, 1);
        assert_eq(reps_of(c.body.convention), [AsInt, AsInt]);
        assert_eq(c.body.convention.result, AsInt);
        assert_eq(
          vals_in(c.body.body).filter(|v: Rvalue| match v { Convert(_) -> true, _ -> false }).len(),
          0,
        )
      },
    }
  }
}

test "a closure is a block of its own, its descriptor first, whose entries give up its captures and whose release lets each go" {
  {
    let f = lowered(b"adder");
    let text = printed_text(corpus_program(), f);
    let name = symbol_of(b"m.adder").concat(b"_lambda0");
    let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
    has(b"ply_alloc(ctx, 24)");
    has(Bytes::concat_all([b")[0] = (Word)(intptr_t)&", name, b"_desc"]));
    has(Bytes::concat_all([b"const PlyFnDesc ", name, b"_desc = { ply_c_"]));
    has(Bytes::concat_all([b", (void (*)(void))", name, b"_typed, "]));
    has(b"static Word ply_c_");
    has(
      Bytes::concat_all([
        b"(PlyCtx *ctx, Word self, const Word *args) {\n",
        b"  Word ed = ctx->entering_desc;\n  Word ew = ctx->entering_words;\n",
        b"  ctx->entering_desc = 0; ctx->entering_words = 0;\n  ply_dup(self);",
      ]),
    );
    has(b"((const PlyFnDesc *)(intptr_t)ply_words(self)[0])->typed)(ctx, self, ");
    has(name.concat(b"_typed(PlyCtx *ctx, Word self, int64_t p0, Word p1, Word p2)"));
    has(b"int unique = ply_obj(self)->rc == 1;\n  int64_t c0 = (int64_t)ply_words(self)[1];");
    has(b"if (unique) { ply_free(ctx, self, 24); } else {");
    has(
      b"if (self && ply_last(ctx, self)) ((const PlyFnDesc *)(intptr_t)ply_words(self)[0])".concat(
        b"->release(ctx, self);",
      ),
    );
    assert_eq(text.index_of(b"ply_dec(ctx, self)"), None);
    match closure_of(f, 0) {
      None -> assert(false, Some("adder makes no closure")),
      Some(c) -> {
        assert_eq(handed_of(c.body.convention), [OwnedParam, OwnedParam]);
        assert_eq(reps_of(c.body.convention), [AsInt, AsInt])
      },
    };
    assert(text.index_of(b"ply_rel_int") == None, Some(String::of_bytes_lossy(text)));
    has(call_text(free_fn(), [b"ctx", b"self", b"24"]));
    assert(text.index_of(b"PlyFnBlock ") == None, Some(String::of_bytes_lossy(text)))
  }
}

test "a record a closure captures lies in its block as its fields, boxed for nothing" {
  {
    let f = lowered(b"captor");
    assert_eq(
      vals_in(f.body).filter(|v: Rvalue| match v { Convert(_) -> true, _ -> false }).len(),
      0,
    );
