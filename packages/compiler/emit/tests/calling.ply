test "a record a call would hand by reference is captured as its word" {
  {
    let f = lowered(b"wide_captor");
    match closure_of(f, 0) {
      None -> assert(false, Some("wide_captor makes no closure")),
      Some(c) -> assert_eq(reps_of(c.body.convention), [AsWord]),
    }
  }
}

test "a lambda a lambda writes is the root's next closure, numbered in the order they are written" {
  {
    let f = lowered(b"nested");
    assert_eq(f.lambdas.len(), 2);
    match closure_of(f, 0) {
      None -> assert(false, Some("nested makes no closure")),
      Some(outer) ->
        assert_eq(
          vals_in(outer.body.body).fold([], |acc: List<{ nth: Int, captures: Int }>, v: Rvalue|
            match v {
              Allocate(m) -> match m.made {
                ClosureAllocation(c) -> acc.push({ nth: c.nth, captures: c.captures }),
                _ -> acc,
              },
              _ -> acc,
            }),
          [{ nth: 1, captures: 2 }],
        ),
    }
  }
}

test "a definition or a constructor named as a value is the closure of a lambda around it, and a pure definition of no parameters is read once" {
  let made = |f: Fn|
    vals_in(f.body).fold([], |acc: List<{ captures: Int, params: Int }>, v: Rvalue|
      match v {
        Allocate(m) -> match m.made {
          ClosureAllocation(c) -> acc.push({ captures: c.captures, params: c.params }),
          _ -> acc,
        },
        _ -> acc,
      });
  {
    let f = lowered(b"named");
    assert_eq(made(f), [{ captures: 0, params: 2 }]);
    match closure_of(f, 0) {
      None -> assert(false, Some("named makes no closure")),
      Some(c) -> {
        assert_eq(reps_of(c.body.convention), [AsInt, AsInt]);
        assert_eq(c.body.kind, Plain);
        assert_eq(
          vals_in(c.body.body).filter(|v: Rvalue|
            match v { Call(k) -> k.callee == Root(Named(b"m.add")), _ -> false }).len(
          ),
          1,
        )
      },
    }
  };
  {
    let f = lowered(b"some_of");
    assert_eq(made(f), [{ captures: 0, params: 1 }]);
    match closure_of(f, 0) {
      None -> assert(false, Some("some_of makes no closure")),
      Some(c) ->
        assert_eq(
          vals_in(c.body.body).filter(|v: Rvalue|
            match v { Call(_) -> true, Apply(_) -> true, _ -> false }).len(
          ),
          0,
        ),
    }
  };
  {
    let f = lowered(b"read_kept");
    let vs = vals_in(f.body);
    assert_eq(
      vs.filter(|v: Rvalue|
        match v {
          Op(o) ->
            o.op
              == OfCalling(
                ConstantRead({ callee: Root(Named(b"m.kept")), kept: int_type(), constant: false }),
              ),
          _ -> false,
        }).len(
      ),
      1,
    );
    assert_eq(vs.filter(|v: Rvalue| match v { Convert(k) -> k.to == AsInt, _ -> false }).len(), 1);
    assert_eq(vs.filter(|v: Rvalue| match v { Call(_) -> true, _ -> false }).len(), 0)
  }
}

test "a scheduler function of no parameters over a native that reads the run is called each time, where one over a pure native is read once" {
  let scheduler = {
    name: scheduler_module(),
    src: Bytes::concat_all([
      b"import std.internal.native (native)\n",
      b"extern fn seed_path() -> Bytes / {native.read}\n",
      b"extern fn site_placed(root: Int, start: Int, end: Int) -> Bytes\n",
      b"fn path() -> Bytes / {native.read} = seed_path()\n",
      b"fn placed() -> Bytes = site_placed(0, 0, 0)\n",
      b"pub fn ran() -> Int / {native.read} = path().len() + placed().len()\n",
      b"pub fn simulated<a | e>(root: Int, start: Int, end: Int, body: keep () -> a / {task.write, clock.read, clock.write, random.write, sim.read | e}) -> a / {abort.raise, native.read | e} = {\n",
      b"  let _ = ran();\n",
      b"  abort.raise(\"none\")\n",
      b"}\n",
    ]),
  };
  let native = { name: b"std.internal.native", src: b"pub nondet effect native {}\n" };
  let region = b"fn main() -> Int / {abort.raise, sim.read} = simulate { 1 }\n";
  {
    let f = shipped_lowered(region, [scheduler, native], scheduler_module(), b"ran");
    let read = |callee: Bytes|
      vals_in(f.body).filter(|v: Rvalue|
        match v {
          Op(o) -> match o.op {
            OfCalling(ConstantRead(c)) ->
              c.callee == Root(Named(qualify(scheduler_module(), callee))),
            _ -> false,
          },
          _ -> false,
        }).len(
      );
    assert_eq([b"path", b"placed"].map(read), [0, 1])
  }
}

test "a hold's closures and what its builtins answer are typed by the hold, so nothing it binds is of no known type" {
  {
    let f = lowered(b"held");
    let open = |b: Fn| b.params.concat(bound_in(b.body)).filter(|v: Var| has_variables(v.ty));
    assert_eq(open(f), []);
    assert_eq(
      f.lambdas.map(|l: Lambda| match l { Closure(c) -> open(c.body) }),
      f.lambdas.map(|_: Lambda| []),
    );
    let holds = f.lambdas.fold([], |acc: List<Type>, l: Lambda|
      match l {
        Closure(c) -> match c.body.params.drop(c.captures) {
          [p] -> if hold_parts(p.ty) != None { acc.push(p.ty) } else { acc },
          _ -> acc,
        },
      });
    assert_eq(holds.len(), 2);
    assert_eq(holds.at(0), holds.at(1))
  }
}

test "a lambda handed where its callee lends it lies in the caller's frame, and the call is settled with it" {
  {
    let f = lowered(b"lends");
