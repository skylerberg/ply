    assert_eq(
      vs.fold([], |acc: List<Bool>, v: Rvalue|
        match v {
          Allocate(m) -> match m.made {
            StackAllocation(ClosureAllocation(_)) -> acc.push(true),
            ClosureAllocation(_) -> acc.push(false),
            _ -> acc,
          },
          _ -> acc,
        }),
      [true],
    );
    assert_eq(f.links.generics, [
      {
        callee: Named(b"m.apply_to"),
        args: [int_type()],
        carried: [0],
        functions: [{ param: 0, owner: Named(b"m.lends"), nth: 0 }],
        rows: [],
      },
    ]);
    assert_eq(
      vs.filter(|v: Rvalue| match v { Call(c) -> c.callee == Generic(0), _ -> false }).len(),
      1,
    )
  }
}

test "a function value is applied through the convention its type has, its row's descriptor and words after its parameters, and the parameter is noted as called" {
