fn lowered_as_built(p: Program, name: Bytes) -> Function / {abort.raise} =
  lowered_by_key(p, Named(qualify(b"m", name)))

fn lowered_by_key(p: Program, key: RootKey) -> Function / {abort.raise} =
  match range(0, p.roots.len()).find(|i: Int| p.roots.get(i).key == key) {
    None ->
      panic(String::of_bytes_lossy(b"no such definition: ".concat(root_text(root_name(key))))),
    Some(i) -> {
      let r = p.roots.get(i);
      let body = known_body(root_text(root_name(r.key)), r.params, r.code);
      lowered_fn(context_of(p.setting, r, body), body)
    },
  }

fn corpus_program() -> Program / {abort.raise} =
  match program_of(corpus()) { Ok(p) -> p, Err(reason) -> panic(String::of_bytes_lossy(reason)) }

fn lowered(name: Bytes) -> Function / {abort.raise} = lowered_as_built(corpus_program(), name)

fn values_in(b: Block) -> List<Rvalue> =
  b.fold([], |accumulator: List<Rvalue>, i: Instruction|
    match i {
      Let(l) -> accumulator.push(l.value),
      Do(d) -> accumulator.push(d.value),
      If(x) -> accumulator.concat(values_in(x.then)).concat(values_in(x.otherwise)),
      Case(c) ->
        c.arms.fold(accumulator, |a: List<Rvalue>, arm: { when: Int, body: Block }|
          a.concat(values_in(arm.body))).concat(
          values_in(c.rest),
        ),
      Match(m) ->
        m.arms.fold(accumulator, |a: List<Rvalue>, arm: Block| a.concat(values_in(arm))).concat(
          values_in(m.rest),
        ),
      Loop(l) -> accumulator.concat(values_in(l.body)),
      _ -> accumulator,
    })

fn bound_in(b: Block) -> List<Variable> =
  b.fold([], |accumulator: List<Variable>, i: Instruction|
    match i {
      Let(l) -> accumulator.push(l.var),
      If(x) -> accumulator.concat(bound_in(x.then)).concat(bound_in(x.otherwise)),
      Case(c) ->
        c.arms.fold(accumulator, |a: List<Variable>, arm: { when: Int, body: Block }|
          a.concat(bound_in(arm.body))).concat(
          bound_in(c.rest),
        ),
      Match(m) ->
        m.arms.fold(accumulator, |a: List<Variable>, arm: Block| a.concat(bound_in(arm))).concat(
          bound_in(m.rest),
        ),
      Loop(l) -> accumulator.concat(bound_in(l.body)),
      _ -> accumulator,
    })

fn restarts(b: Block) -> Bool =
  b.fold(false, |found: Bool, i: Instruction|
    found
      || (match i {
        Restart(_) -> true,
        If(x) -> restarts(x.then) || restarts(x.otherwise),
        _ -> false,
      }))

fn closure_of(f: Function, nth: Int) -> Option<{ body: Function, captures: Int }> =
  match f.lambdas.at(nth) {
    Some(Closure(c)) -> Some({ body: c.body, captures: c.captures }),
    None -> None,
  }

fn lets_in(b: Block) -> List<{ var: Variable, value: Rvalue }> =
  b.fold([], |accumulator: List<{ var: Variable, value: Rvalue }>, i: Instruction|
    match i {
      Let(l) -> accumulator.push({ var: l.var, value: l.value }),
      Handle(h) -> accumulator.concat(lets_in(h.body)),
      _ -> accumulator,
    })

test "a handle around a spawnable task allocates its instance on the heap, and the closure passed to `task.spawn` captures that instance" {
  let source = Bytes::concat_all([
    b"effect note {\n  write say(n: Int) -> Unit\n}\n",
    b"fn sayer() -> Int / {abort.raise, sim.read} = simulate { handle { let t = task.spawn(|| { note.say(1); 2 }); task.join(t) } with { note.say(n) -> () } }\n",
  ]);
  match scheduled_program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let f = lowered_as_built(p, b"sayer");
      let lets = f.lambdas.fold(
        lets_in(f.body),
        |accumulator: List<{ var: Variable, value: Rvalue }>, l: Lambda|
          match l { Closure(c) -> accumulator.concat(lets_in(c.body.body)) },
      );
      let blocks = lets.filter(|x: { var: Variable, value: Rvalue }|
        match x.value {
          OperationCall(o) -> match o.operation { OfHandling(HeapInstance(_)) -> true, _ -> false },
          _ -> false,
        });
      assert_eq(blocks.len(), 1);
      assert(
        lets.any(|x: { var: Variable, value: Rvalue }|
          match x.value {
            Allocate(m) ->
              m.args.any(|a: Arg|
                blocks.any(|b: { var: Variable, value: Rvalue }| a == VariableOperand(b.var))),
            _ -> false,
          }),
        None,
      )
    },
  }
}

test "a call of a definition passes each argument in the representation the callee's signature declares" {
  {
    let f = lowered(b"twice");
    assert_eq(
      values_in(f.body).fold(
        [],
        |accumulator: List<{ representations: List<Representation>, result: Representation }>, v: Rvalue|
          match v {
            Call(c) -> if c.callee == Root(Named(b"m.add")) {
              accumulator.push({
                representations: reps_of(c.convention),
                result: c.convention.result,
              })
            } else { accumulator },
            _ -> accumulator,
          },
      ),
      [{ representations: [AsInt, AsInt], result: AsInt }],
    )
  };
  {
    let f = lowered(b"handed");
    assert_eq(
      values_in(f.body).fold([], |accumulator: List<List<Representation>>, v: Rvalue|
        match v {
          Call(c) -> accumulator.push(reps_of(c.convention).push(c.convention.result)),
          _ -> accumulator,
        }),
      [[AsWord, AsWord]],
    )
  }
}

test "a small record is passed to a call and returned from it as separate fields, not as a single word" {
  {
    let f = lowered(b"summed");
    assert_eq(
      values_in(f.body).fold(
        [],
        |accumulator: List<{ representations: List<Representation>, result: Representation }>, v: Rvalue|
          match v {
            Call(c) -> if c.callee == Root(Named(b"m.swapped")) {
              accumulator.push({
                representations: reps_of(c.convention),
                result: c.convention.result,
              })
            } else { accumulator },
            _ -> accumulator,
          },
      ),
      [
        {
          representations: [
            AsFlattened([
              { name: b"x", representation: AsInt },
              { name: b"y", representation: AsInt },
            ]),
          ],
          result: AsFlattened([
            { name: b"x", representation: AsInt },
            { name: b"y", representation: AsInt },
          ]),
        },
      ],
    )
  }
}

test "a lambda and a function value also receive a small record as separate fields" {
  let fields = AsFlattened([
    { name: b"x", representation: AsInt },
    { name: b"y", representation: AsInt },
  ]);
  {
    let f = lowered(b"pair_summer");
    match closure_of(f, 0) {
      None -> assert(false, Some("pair_summer makes no closure")),
      Some(c) ->
        assert_eq(reps_of(c.body.convention).drop(c.captures).push(c.body.convention.result), [
          fields,
          AsInt,
        ]),
    }
  };
  {
    let f = lowered(b"applied_pair");
    assert_eq(
      values_in(f.body).fold([], |accumulator: List<List<Representation>>, v: Rvalue|
        match v {
          Apply(a) -> accumulator.push(reps_of(a.convention).push(a.convention.result)),
          _ -> accumulator,
        }),
      [[fields, AsImmediate, AsImmediate, AsInt]],
    )
  }
}

test "a call of a generic definition lowers to a generic call recorded with the type arguments given at that call" {
  {
    let f = lowered(b"ident_int");
    assert_eq(f.links.generics, [
      {
        callee: Named(b"m.ident"),
        args: [int_type()],
        specialised_variables: [0],
        functions: [],
        effect_evidence: [],
      },
    ]);
    assert_eq(
      values_in(f.body).fold([], |accumulator: List<List<Representation>>, v: Rvalue|
        match v {
          Call(c) -> if c.callee == Generic(0) {
            accumulator.push(reps_of(c.convention).push(c.convention.result))
          } else { accumulator },
          _ -> accumulator,
        }),
      [[AsInt, AsInt]],
    )
  };
  {
    let f = lowered(b"ident_word");
    assert_eq(f.links.generics, [
      {
        callee: Named(b"m.ident"),
        args: [string_type()],
        specialised_variables: [],
        functions: [],
        effect_evidence: [],
      },
    ])
  }
}

test "a self call in tail position restarts the body, and a call from a lambda to the function that contains it is an ordinary call" {
  {
    let f = lowered(b"count");
    assert(restarts(f.body), None)
  };
  {
    let f = lowered(b"counter");
    match closure_of(f, 0) {
      None -> assert(false, Some("counter makes no closure")),
      Some(c) -> {
        assert(!restarts(c.body.body), None);
        assert_eq(
          values_in(c.body.body).filter(|v: Rvalue|
            match v { Call(x) -> x.callee == Root(Named(b"m.count")), _ -> false }).len(
          ),
          1,
        )
      },
    }
  }
}

test "a lambda becomes a closure over its own function, which receives its captured values first and then its parameters" {
  {
    let f = lowered(b"adder");
    assert_eq(f.lambdas.len(), 1);
    assert_eq(
      values_in(f.body).fold(
        [],
        |accumulator: List<{ captures: Int, params: Int, args: Int }>, v: Rvalue|
          match v {
            Allocate(m) -> match m.made {
              ClosureAllocation(c) -> if c.nth == 0 {
                accumulator.push({ captures: c.captures, params: c.params, args: m.args.len() })
              } else { accumulator },
              _ -> accumulator,
            },
            _ -> accumulator,
          },
      ),
      [{ captures: 1, params: 1, args: 1 }],
    );
    match closure_of(f, 0) {
      None -> assert(false, Some("adder makes no closure")),
      Some(c) -> {
        assert_eq(c.captures, 1);
        assert_eq(reps_of(c.body.convention), [AsInt, AsInt]);
        assert_eq(c.body.convention.result, AsInt);
        assert_eq(
          values_in(c.body.body).filter(|v: Rvalue| match v { Convert(_) -> true, _ -> false }).len(
          ),
          0,
        )
      },
    }
  }
}

test "a closure is its own heap block that starts with its function descriptor, and the generated entry function reads the captured values from the block and releases them" {
  {
    let f = lowered(b"adder");
    let text = printed_text(corpus_program(), f);
    let name = symbol_of(b"m.adder").concat(b"_lambda0");
    let has = |t: Bytes| assert(text.index_of(t) != None, Some(String::of_bytes_lossy(text)));
    has(b"ply_alloc(ctx, 24)");
    has(Bytes::concat_all([b")[0] = (Word)(intptr_t)&", name, b"_desc"]));
    has(Bytes::concat_all([b"const PlyFnDesc ", name, b"_desc = { ply_c_"]));
    has(Bytes::concat_all([b", (void (*)(void))", name, b"_typed, "]));
    has(b"static Word ply_c_");
    has(
      Bytes::concat_all([
        b"(PlyCtx *ctx, Word self, const Word *args) {\n",
        b"  Word ed = ctx->entering_descriptor;\n  Word ew = ctx->entering_words;\n",
        b"  ctx->entering_descriptor = 0; ctx->entering_words = 0;\n  ply_dup(self);",
      ]),
    );
    has(b"((const PlyFnDesc *)(intptr_t)ply_words(self)[0])->typed)(ctx, self, ");
    has(name.concat(b"_typed(PlyCtx *ctx, Word self, int64_t p0, Word p1, Word p2)"));
    has(b"int unique = ply_obj(self)->rc == 1;\n  int64_t c0 = (int64_t)ply_words(self)[1];");
    has(b"if (unique) { ply_free(ctx, self, 24); } else {");
    has(
      b"if (self && ply_last(ctx, self)) ((const PlyFnDesc *)(intptr_t)ply_words(self)[0])".concat(
        b"->release(ctx, self);",
      ),
    );
    assert_eq(text.index_of(b"ply_dec(ctx, self)"), None);
    match closure_of(f, 0) {
      None -> assert(false, Some("adder makes no closure")),
      Some(c) -> {
        assert_eq(param_ownerships(c.body.convention), [OwnedParam, OwnedParam]);
        assert_eq(reps_of(c.body.convention), [AsInt, AsInt])
      },
    };
    assert(text.index_of(b"ply_rel_int") == None, Some(String::of_bytes_lossy(text)));
    has(call_text(free_function(), [b"ctx", b"self", b"24"]));
    assert(text.index_of(b"PlyFnBlock ") == None, Some(String::of_bytes_lossy(text)))
  }
}

test "a record captured by a closure is stored in the closure's block as separate fields, with no conversion" {
  {
    let f = lowered(b"captor");
    assert_eq(
      values_in(f.body).filter(|v: Rvalue| match v { Convert(_) -> true, _ -> false }).len(),
      0,
    );
    let text = printed_text(corpus_program(), f);
    assert(text.index_of(b"ply_alloc(ctx, 32)") != None, Some(String::of_bytes_lossy(text)))
  }
}

test "a record that a call would pass by reference is captured by a closure as a single word" {
  {
    let f = lowered(b"wide_captor");
    match closure_of(f, 0) {
      None -> assert(false, Some("wide_captor makes no closure")),
      Some(c) -> assert_eq(reps_of(c.body.convention), [AsWord]),
    }
  }
}

test "a lambda written inside another lambda becomes a closure of the enclosing function, numbered by the order the lambdas appear in the source" {
  {
    let f = lowered(b"nested");
    assert_eq(f.lambdas.len(), 2);
    match closure_of(f, 0) {
      None -> assert(false, Some("nested makes no closure")),
      Some(outer) ->
        assert_eq(
          values_in(outer.body.body).fold(
            [],
            |accumulator: List<{ nth: Int, captures: Int }>, v: Rvalue|
              match v {
                Allocate(m) -> match m.made {
                  ClosureAllocation(c) -> accumulator.push({ nth: c.nth, captures: c.captures }),
                  _ -> accumulator,
                },
                _ -> accumulator,
              },
          ),
          [{ nth: 1, captures: 2 }],
        ),
    }
  }
}

test "a definition or constructor used as a value becomes a closure around a wrapper lambda, and a pure definition with no parameters is evaluated once" {
  let made = |f: Function|
    values_in(f.body).fold([], |accumulator: List<{ captures: Int, params: Int }>, v: Rvalue|
      match v {
        Allocate(m) -> match m.made {
          ClosureAllocation(c) -> accumulator.push({ captures: c.captures, params: c.params }),
          _ -> accumulator,
        },
        _ -> accumulator,
      });
  {
    let f = lowered(b"named");
    assert_eq(made(f), [{ captures: 0, params: 2 }]);
    match closure_of(f, 0) {
      None -> assert(false, Some("named makes no closure")),
      Some(c) -> {
        assert_eq(reps_of(c.body.convention), [AsInt, AsInt]);
        assert_eq(c.body.kind, Plain);
        assert_eq(
          values_in(c.body.body).filter(|v: Rvalue|
            match v { Call(k) -> k.callee == Root(Named(b"m.add")), _ -> false }).len(
          ),
          1,
        )
      },
    }
  };
  {
    let f = lowered(b"some_of");
    assert_eq(made(f), [{ captures: 0, params: 1 }]);
    match closure_of(f, 0) {
      None -> assert(false, Some("some_of makes no closure")),
      Some(c) ->
        assert_eq(
          values_in(c.body.body).filter(|v: Rvalue|
            match v { Call(_) -> true, Apply(_) -> true, _ -> false }).len(
          ),
          0,
        ),
    }
  };
  {
    let f = lowered(b"read_kept");
    let vs = values_in(f.body);
    assert_eq(
      vs.filter(|v: Rvalue|
        match v {
          OperationCall(o) ->
            o.operation
              == OfCalling(
                ConstantRead({
                  callee: Root(Named(b"m.kept")),
                  value_type: int_type(),
                  constant: false,
                }),
              ),
          _ -> false,
        }).len(
      ),
      1,
    );
    assert_eq(vs.filter(|v: Rvalue| match v { Convert(k) -> k.to == AsInt, _ -> false }).len(), 1);
    assert_eq(vs.filter(|v: Rvalue| match v { Call(_) -> true, _ -> false }).len(), 0)
  }
}

test "a no-parameter function that calls a nondeterministic native which reads state is called at every use, but one that calls a pure native is called once" {
  let scheduler = {
    name: scheduler_module(),
    source_text: Bytes::concat_all([
      b"import std.internal.native (native)\n",
      b"extern fn seed_path() -> Bytes / {native.read}\n",
      b"extern fn site_placed(root: Int, start: Int, end: Int) -> Bytes\n",
      b"fn path() -> Bytes / {native.read} = seed_path()\n",
      b"fn placed() -> Bytes = site_placed(0, 0, 0)\n",
      b"pub fn ran() -> Int / {native.read} = path().len() + placed().len()\n",
      b"pub fn simulated<a | e>(root: Int, start: Int, end: Int, body: keep () -> a / {task.write, clock.read, clock.write, random.write, sim.read | e}) -> a / {abort.raise, native.read | e} = {\n",
      b"  let _ = ran();\n",
      b"  abort.raise(\"none\")\n",
      b"}\n",
    ]),
  };
  let native = { name: b"std.internal.native", source_text: b"pub nondet effect native {}\n" };
  let region = b"fn main() -> Int / {abort.raise, sim.read} = simulate { 1 }\n";
  {
    let f = shipped_lowered(region, [scheduler, native], scheduler_module(), b"ran");
    let read = |callee: Bytes|
      values_in(f.body).filter(|v: Rvalue|
        match v {
          OperationCall(o) -> match o.operation {
            OfCalling(ConstantRead(c)) ->
              c.callee == Root(Named(qualify(scheduler_module(), callee))),
            _ -> false,
          },
          _ -> false,
        }).len(
      );
    assert_eq([b"path", b"placed"].map(read), [0, 1])
  }
}

test "closures inside a scope-bound value, and the builtin results for that value, are typed as that value, so no variable has an unresolved type" {
  {
    let f = lowered(b"held");
    let open = |b: Function|
      b.params.concat(bound_in(b.body)).filter(|v: Variable| has_variables(v.ty));
    assert_eq(open(f), []);
    assert_eq(
      f.lambdas.map(|l: Lambda| match l { Closure(c) -> open(c.body) }),
      f.lambdas.map(|_: Lambda| []),
    );
    let scoped_types = f.lambdas.fold([], |accumulator: List<Type>, l: Lambda|
      match l {
        Closure(c) -> match c.body.params.drop(c.captures) {
          [p] -> if scoped_parts(p.ty) != None { accumulator.push(p.ty) } else { accumulator },
          _ -> accumulator,
        },
      });
    assert_eq(scoped_types.len(), 2);
    assert_eq(scoped_types.at(0), scoped_types.at(1))
  }
}

test "a lambda passed to a parameter its callee borrows is allocated in the caller's stack frame, and the call is specialised for that lambda" {
  {
    let f = lowered(b"lends");
    let vs = values_in(f.body);
    assert_eq(
      vs.fold([], |accumulator: List<Bool>, v: Rvalue|
        match v {
          Allocate(m) -> match m.made {
            StackAllocation(ClosureAllocation(_)) -> accumulator.push(true),
            ClosureAllocation(_) -> accumulator.push(false),
            _ -> accumulator,
          },
          _ -> accumulator,
        }),
      [true],
    );
    assert_eq(f.links.generics, [
      {
        callee: Named(b"m.apply_to"),
        args: [int_type()],
        specialised_variables: [0],
        functions: [{ param: 0, owner: Named(b"m.lends"), nth: 0 }],
        effect_evidence: [],
      },
    ]);
    assert_eq(
      vs.filter(|v: Rvalue| match v { Call(c) -> c.callee == Generic(0), _ -> false }).len(),
      1,
    )
  }
}

test "calling a function value passes the effect descriptor and effect evidence after its parameters, and marks that parameter as called" {
  {
    let f = lowered(b"applied");
    assert_eq(
      values_in(f.body).fold([], |accumulator: List<List<Representation>>, v: Rvalue|
        match v {
          Apply(a) -> accumulator.push(reps_of(a.convention).push(a.convention.result)),
          _ -> accumulator,
        }),
      [[AsInt, AsImmediate, AsImmediate, AsInt]],
    );
    assert_eq(f.links.called, [0])
  }
}

test "a lambda bound by `let` and called directly is inlined with no indirect call, and reads its captured values from its closure" {
  {
    let f = lowered(b"local");
    let vs = values_in(f.body);
    assert_eq(vs.filter(|v: Rvalue| match v { Apply(_) -> true, _ -> false }).len(), 0);
    assert_eq(
      vs.filter(|v: Rvalue| match v { Get(g) -> g.path == CapturePath(0), _ -> false }).len(),
      1,
    )
  }
}

test "a step function whose every arm directly builds `Continue` or `Stop` loops or exits without allocating an object" {
  let made = |f: Function|
    values_in(f.body).filter(|v: Rvalue|
      match v {
        Allocate(m) -> match m.made { CaseAllocation(_) -> true, _ -> false },
        Aggregate(_) -> true,
        _ -> false,
      }).len(
    );
  let looped = |f: Function|
    f.body.filter(|i: Instruction| match i { Loop(_) -> true, _ -> false }).len();
  {
    let f = lowered(b"steps");
    assert_eq(looped(f), 1);
    assert_eq(made(f), 0)
  };
  [b"count_down", b"wide_steps"].fold((), |_: Unit, name: Bytes| {
    let f = lowered(name);
    assert_eq([looped(f), made(f)], [1, 0])
  });
  let reading = lowered(b"walked_to");
  assert_eq([looped(reading), made(reading)], [1, 2])
}

test "`iterate` on a step that is a function value loops in the body, calling the step through its function descriptor on each pass" {
  let applying = |b: Block|
    b.filter(|i: Instruction|
      match i {
        Loop(l) -> values_in(l.body).any(|v: Rvalue| match v { Apply(_) -> true, _ -> false }),
        _ -> false,
      }).len(
    );
  {
    let f = lowered(b"iterate_named");
    assert_eq(applying(f.body), 1);
    assert(printed_text(corpus_program(), f).index_of(b"->typed)(ctx") != None, None)
  };
  {
    let f = lowered(b"iterate_by");
    assert_eq(
      f.lambdas.map(|l: Lambda| match l { Closure(c) -> applying(c.body.body) }).fold(
        0,
        |n: Int, k: Int| n + k,
      ),
      1,
    )
  }
}

test "a step's loop fails by the runtime once its budget is spent" {
  {
    let f = lowered(b"stepped");
    assert_eq(printed_text(corpus_program(), f).split(b"ply_iterate_bad(ctx, ").len() - 1, 1)
  }
}

test "a step that `iterate` runs becomes a loop over its state and budget, where each pass continues or exits according to the `Iter` it returns" {
  {
    let f = lowered(b"stepped");
    match f.body.fold(None, |accumulator: Option<Instruction>, i: Instruction|
        match i { Loop(_) -> Some(i), _ -> accumulator }) {
      Some(Loop(l)) -> {
        assert_eq(l.state.map(|c: LoopVariable| c.var.representation), [AsInt, AsInt]);
        assert_eq(l.result.representation, AsInt);
        match l.body.at(l.body.len() - 1) {
          Some(Case(c)) -> {
            assert_eq(c.test, TagTest([b"Continue", b"Stop"]));
            assert_eq(
              c.arms.map(|a: { when: Int, body: Block }|
                match a.body.at(a.body.len() - 1) {
                  Some(Next(_)) -> 0,
                  Some(Done(_)) -> 1,
                  _ -> 2,
                }),
              [0, 1],
            )
          },
          other -> assert_eq(other, None),
        }
      },
      _ -> assert(false, Some("the step is no loop")),
    }
  }
}

fn walk_corpus() -> Bytes =
  Bytes::concat_all([
    b"fn summed(xs: List<Int>) -> Int = xs.fold(0, |s: Int, x: Int| s + x)\n",
    b"fn bumped(xs: List<Int>, k: Int) -> List<Int> = xs.map(|x: Int| x + k)\n",
    b"fn kept(xs: List<String>) -> List<String> = xs.filter(|s: String| s.len() > 2)\n",
    b"fn added(s: Int, x: Int) -> Int = s + x\n",
    b"fn named(xs: List<Int>) -> Int = xs.fold(0, added)\n",
    b"fn known(xs: List<Int>, k: Int) -> List<Int> = { let f = |x: Int| x * k; xs.map(f) }\n",
    b"fn tallied(m: Map<Int, Int>) -> Int = m.fold(0, |s: Int, k: Int, v: Int| s + k * v)\n",
    b"fn counted(lo: Int, hi: Int) -> List<Int> = range(lo, hi).map(|i: Int| i * i)\n",
  ])

fn loops_in(b: Block) -> List<Int> =
  b.fold([], |accumulator: List<Int>, i: Instruction|
    match i {
      Loop(l) -> accumulator.push(l.state.len()).concat(loops_in(l.body)),
      If(x) -> accumulator.concat(loops_in(x.then)).concat(loops_in(x.otherwise)),
      Case(c) ->
        c.arms.fold(accumulator, |a: List<Int>, arm: { when: Int, body: Block }|
          a.concat(loops_in(arm.body))).concat(
          loops_in(c.rest),
        ),
      Match(m) ->
        m.arms.fold(accumulator, |a: List<Int>, arm: Block| a.concat(loops_in(arm))).concat(
          loops_in(m.rest),
        ),
      _ -> accumulator,
    })

test "a fold, map or filter over a lambda is one loop in its caller, the lambda's body run in each pass" {
  match program_of(walk_corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let corpus_names = [
        b"summed",
        b"bumped",
        b"kept",
        b"named",
        b"known",
        b"tallied",
        b"counted",
      ];
      let functions = corpus_names.map(|n: Bytes| lowered_as_built(p, n));
      assert_eq(functions.map(|f: Function| loops_in(f.body)), [[2], [2], [2], [2], [2], [4], [2]]);
      let applied = |f: Function|
        values_in(f.body).filter(|v: Rvalue| match v { Apply(_) -> true, _ -> false }).len();
      assert_eq(functions.map(applied), [0, 0, 0, 0, 0, 0, 0]);
      let prelude = |n: Bytes| Named(b"std.prelude.".concat(n));
      assert_eq(functions.map(|f: Function| f.links.generics.map(|g: GenericCall| g.callee)), [
        [],
        [],
        [],
        [],
        [],
        [prelude(b"node_max"), prelude(b"leaf_above"), prelude(b"first_leaf")],
        [],
      ]);
      let reads_items = |f: Function|
        values_in(f.body).any(|v: Rvalue|
          match v { OperationCall(o) -> o.operation == OfContainers(ItemAt), _ -> false });
      assert_eq(functions.map(reads_items), [true, true, true, true, true, false, false])
    },
  }
}

fn root_index(p: Program, name: Bytes) -> Option<Int> =
  range(0, p.roots.len()).fold(None, |accumulator: Option<Int>, i: Int|
    match p.roots.at(i) {
      Some(r) -> if r.key == Named(qualify(b"m", name)) { Some(i) } else { accumulator },
      None -> accumulator,
    })

fn lowered_specialisation(
  p: Program,
  name: Bytes,
  args: List<Type>,
  functions: List<InlinedLambda>,
  lambda_arguments: List<Option<BoundLambda>>,
) -> Result<Function, Bytes> / {abort.raise} =
  specialised_at(
    p,
    name,
    specialisation_key_with_effects(qualify(b"m", name), args.map(KeyType), functions, []),
    lambda_arguments,
  )

fn specialised_at(
  p: Program,
  name: Bytes,
  key: RootKey,
  lambda_arguments: List<Option<BoundLambda>>,
) -> Result<Function, Bytes> / {abort.raise} =
  match match root_index(p, name) { Some(i) -> p.roots.at(i), None -> None } {
    None -> Err(b"no such root"),
    Some(r) -> {
      let recorded = recorded_in(p.analysis, site_owner_text(r.key));
      let own = root_body(recorded, WholeBody, r.base, [], key_types(key)).params.len();
      let labels = r.params.drop(own).map(|q: EmitParam| q.name);
      let b = root_body(recorded, WholeBody, r.base, labels, key_types(key));
      let params = range(0, b.params.len()).map(|i: Int|
        match lambda_arguments.at(i) {
          Some(Some(bl)) -> { ..b.params.get(i), lambda: Some(bl) },
          _ -> b.params.get(i),
        });
      let body = known_body(root_text(root_name(key)), params, b.code);
      Ok(
        lowered_fn(
          context_of(
            p.setting,
            { ..r, key: key, params: params, types: params.map(param_type), code: b.code },
            body,
          ),
          body,
        ),
      )
    },
  }

fn lambda_specialisation(
  p: Program,
  lambda_root: Bytes,
  generic: Bytes,
  param: Int,
) -> Result<{ f: Function, base: Int }, Bytes> / {abort.raise} =
  match match root_index(p, lambda_root) { Some(i) -> p.roots.at(i), None -> None } {
    None -> Err(b"no function contains the lambda"),
    Some(l) -> match borrowed_lambda_key(p.source, lambda_root, generic, param) {
      Err(reason) -> Err(reason),
      Ok(key) -> {
        let written = lambdas_of(known_body(root_text(root_name(l.key)), l.params, l.code));
        match written.at(0) {
          None -> Err(b"the function contains no lambda"),
          Some(first) -> {
            let bound = {
              owner: l.key,
              nth: 0,
              code: first,
              module: b"m",
              module_definitions: p.setting.definitions,
              imports: p.setting.imports,
              effects: p.setting.effects,
              base: l.base,
              written: written,
            };
            match specialised_at(
                p,
                generic,
                key,
                range(0, param + 1).map(|i: Int| if i == param { Some(bound) } else { None }),
              ) {
              Ok(f) -> Ok({ f: f, base: l.base }),
              Err(reason) -> Err(reason),
            }
          },
        }
      },
    },
  }

fn borrowed_lambda_key(
  source: Bytes,
  lambda_root: Bytes,
  generic: Bytes,
  param: Int,
) -> Result<RootKey, Bytes> / {abort.raise} =
  match roots_built([{ name: b"m", source_text: source }]) {
    Err(reason) -> Err(reason),
    Ok(keys) -> {
      let of = keys.filter(|k: RootKey| definition_of(k) == Some(qualify(b"m", generic)));
      match of.find(|k: RootKey|
          match k {
            Specialisation(a, _) ->
              a.borrowed.any(|x: InlinedLambda|
                x.param == param && x.nth == 0
                  && definition_of(x.owner) == Some(qualify(b"m", lambda_root))),
            _ -> false,
          }) {
        Some(k) -> Ok(k),
        None ->
          Err(
            Bytes::concat_all([
              b"no build passes that lambda borrowed; it makes ",
              Bytes::join(of.map(|k: RootKey| root_text(root_name(k))), b", "),
            ]),
          ),
      }
    },
  }

test "a lambda inlined into a specialisation of another function uses the passing function's call-site scope, but only in the lambda's own code" {
  match program_of(corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match lambda_specialisation(p, b"lends_word", b"apply_to", 0) {
      Err(reason) -> assert_eq(reason, b""),
      Ok(run) -> {
        assert_eq(
          run.f.body.fold([], |accumulator: List<Instruction>, i: Instruction|
            match i { SiteScope(_) -> accumulator.push(i), _ -> accumulator }),
          [SiteScope(Some({ root: Named(b"m.lends_word"), base: run.base })), SiteScope(None)],
        );
        assert_eq(
          values_in(run.f.body).filter(|v: Rvalue| match v { Apply(_) -> true, _ -> false }).len(),
          0,
        );
        assert_eq(
          values_in(run.f.body).filter(|v: Rvalue|
            match v { Get(g) -> g.path == CapturePath(0), _ -> false }).len(
          ),
          1,
        )
      },
    },
  }
}

test "a closure made inside a lambda passed without ownership performs effects with its own evidence, not the scheduler's evidence" {
  match program_of(corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match lambda_specialisation(p, b"lends_noting", b"apply_in", 0) {
      Err(reason) -> assert_eq(reason, b""),
      Ok(run) -> {
        let bridged = |f: Function|
          values_in(f.body).filter(|v: Rvalue|
            match v {
              OperationCall(o) -> o.operation == OfHandling(SchedulerEvidence),
              _ -> false,
            });
        let performs = |f: Function|
          values_in(f.body).filter(|v: Rvalue|
            match v {
              OperationCall(o) -> match o.operation { OfHandling(Perform(_)) -> true, _ -> false },
              _ -> false,
            });
        let closures = range(0, run.f.lambdas.len()).fold(
          [],
          |accumulator: List<Function>, k: Int|
            match closure_of(run.f, k) { Some(c) -> accumulator.push(c.body), None -> accumulator },
        );
        assert_eq(closures.map(|f: Function| performs(f).len()), [1]);
        assert_eq(closures.map(|f: Function| bridged(f).len()).concat([bridged(run.f).len()]), [
          0,
          0,
        ])
      },
    },
  }
}

test "a lambda passed without ownership to a function generic over a type and effects performs effects with the evidence that function receives for those effects" {
  match program_of(corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match lambda_specialisation(p, b"lends_logged", b"apply_in", 0) {
      Err(reason) -> assert_eq(reason, b""),
      Ok(run) -> {
        let words = values_in(run.f.body).fold([], |accumulator: List<List<Arg>>, v: Rvalue|
          match v {
            OperationCall(o) -> match o.operation {
              OfHandling(Perform(_)) -> accumulator.push(o.args),
              _ -> accumulator,
            },
            _ -> accumulator,
          });
        assert_eq(words.len(), 1);
        assert_eq(words.filter(|args: List<Arg>| args.contains(ZeroOperand(AsImmediate))), [])
      },
    },
  }
}

test "a lambda passed without ownership to a parameter with a fixed effect list performs effects with the evidence the called function provides" {
  match program_of(corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match lambda_specialisation(p, b"lends_closed", b"noting", 0) {
      Err(reason) -> assert_eq(reason, b""),
      Ok(run) -> {
        let operations = values_in(run.f.body).fold([], |accumulator: List<Bytes>, v: Rvalue|
          match v {
            OperationCall(o) -> match o.operation {
              OfHandling(Perform(_)) -> accumulator.push(b"perform"),
              OfHandling(SchedulerEvidence) -> accumulator.push(b"bridge"),
              _ -> accumulator,
            },
            _ -> accumulator,
          });
        assert_eq(operations, [b"perform"])
      },
    },
  }
}

test "lambdas written inside a lambda passed without ownership belong to the function that received it, which inlines a `let`-bound one and passes its closures its call-site scope" {
  match program_of(corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match lambda_specialisation(p, b"lends_on", b"apply_to", 0) {
      Err(reason) -> assert_eq(reason, b""),
      Ok(run) -> {
        let lambda_arguments = SiteScope(Some({ root: Named(b"m.lends_on"), base: run.base }));
        assert_eq(
          range(0, run.f.lambdas.len()).map(|k: Int|
            match closure_of(run.f, k) { Some(c) -> c.body.body.at(0), None -> None }),
          [Some(lambda_arguments), Some(lambda_arguments)],
        );
        assert_eq(
          values_in(run.f.body).filter(|v: Rvalue| match v { Apply(_) -> true, _ -> false }).len(),
          0,
        );
        assert_eq(run.f.links.generics.map(|g: GenericCall| g.functions), [
          [{ param: 0, owner: Named(b"m.lends_on"), nth: 1 }],
        ])
      },
    },
  }
}

fn fold_operators(
  p: Program,
  lambda_root: Bytes,
) -> Result<{ c: List<Bytes>, runtime: Int }, Bytes> / {abort.raise} =
  match lambda_specialisation(p, lambda_root, b"fold_from", 3) {
    Err(reason) -> Err(reason),
    Ok(run) -> {
      let values = values_in(run.f.body);
      Ok({
        c: values.fold([], |accumulator: List<Bytes>, v: Rvalue|
          match v {
            Primitive(x) -> if x.on == AsInt && x.operation != b"ge" {
              accumulator.push(x.operation)
            } else { accumulator },
            _ -> accumulator,
          }),
        runtime: values.filter(|v: Rvalue|
          match v { Native(n) -> n.name == b"rt_binary_p", _ -> false }).len(
        ),
      })
    },
  }

test "a lambda passed without ownership uses its arguments and captures at their declared types, even when the generic caller treats them as a type parameter or untyped word" {
  let source = Bytes::concat_all([
    b"fn fold_from<T, A>(xs: List<T>, i: Int, acc: A, f: (A, T) -> A) -> A =\n",
    b"  match xs.at(i) { Some(x) -> fold_from(xs, i + 1, f(acc, x), f), None -> acc }\n",
    b"fn bits(n: Int) -> Int =\n",
    b"  fold_from(range(1, 7), 0, 0, |found: Int, b: Int| if 1 << b == n { b } else { found })\n",
    b"fn digits(n: Int) -> Option<Int> =\n",
    b"  fold_from(range(0, n), 0, Some(0), |so_far: Option<Int>, d: Int|\n",
    b"    match so_far { Some(v) -> Some(v * 10 + d), None -> None })\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      assert_eq(fold_operators(p, b"bits"), Ok({ c: [b"add", b"shl", b"eq"], runtime: 0 }));
      assert_eq(fold_operators(p, b"digits"), Ok({ c: [b"add", b"mul", b"add"], runtime: 0 }))
    },
  }
}

test "a lambda passed without ownership uses its parameter at its declared type, even when the generic caller's type parameter for it is compiled as an untyped word" {
  let source = Bytes::concat_all([
    b"fn most<c>(xs: List<c>, g: (Int, c) -> Int) -> Int = xs.fold(0, g)\n",
    b"fn heaviest<a>(pairs: List<{ item: a, weight: Int }>) -> Int =\n",
    b"  most(pairs, |most: Int, p: { item: a, weight: Int }| if p.weight > most { p.weight } else { most })\n",
  ]);
  match borrowed_lambda_key(source, b"heaviest", b"most", 1) {
    Err(reason) -> assert(reason.len() == 0, Some(String::of_bytes_lossy(reason))),
    Ok(key) -> match built_c(source, [], key) {
      Err(reason) -> assert_eq(reason, b""),
      Ok(text) -> assert_eq(text.index_of(b"rt_binary_p"), None),
    },
  }
}

test "a closure written in a function calls a borrowed lambda parameter of that function through the enclosing closure, as a function value" {
  let source = Bytes::concat_all([
    b"fn each<T>(xs: List<T>, g: (T) -> T) -> List<T> = xs.map(g)\n",
    b"fn twice_each<T>(xs: List<T>, f: (T) -> T) -> List<T> =\n",
    b"  match xs.at(0) { Some(x) -> each(xs, |y: T| f(f(y))).push(f(x)), None -> [] }\n",
    b"fn bumped(xs: List<Int>) -> List<Int> = twice_each(xs, |n: Int| n + 1)\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match lambda_specialisation(p, b"bumped", b"twice_each", 1) {
      Err(reason) -> assert(reason.len() == 0, Some(String::of_bytes_lossy(reason))),
      Ok(run) ->
        assert_eq(
          range(0, run.f.lambdas.len()).map(|k: Int|
            match closure_of(run.f, k) {
              Some(c) ->
                values_in(c.body.body).filter(|v: Rvalue|
                  match v { Apply(_) -> true, _ -> false }).len(
                ),
              None -> 0,
            }),
          [2],
        ),
    },
  }
}

type TestedValue = { representation: Representation, branch: Bool }

fn tested_in(b: Block) -> List<TestedValue> =
  b.fold([], |accumulator: List<TestedValue>, i: Instruction|
    match i {
      If(x) ->
        accumulator.push({ representation: operand_representation(x.cond), branch: true }).concat(
          tested_in(x.then),
        ).concat(
          tested_in(x.otherwise),
        ),
      Case(c) -> {
        let here = match c.test {
          IntTest(_) -> accumulator.push({ representation: c.on.representation, branch: false }),
          RangeTest(_) -> accumulator.push({ representation: c.on.representation, branch: false }),
          _ -> accumulator,
        };
        c.arms.fold(here, |a: List<TestedValue>, arm: { when: Int, body: Block }|
          a.concat(tested_in(arm.body))).concat(
          tested_in(c.rest),
        )
      },
      Match(m) ->
        m.arms.fold(accumulator, |a: List<TestedValue>, arm: Block|
          a.concat(tested_in(arm))).concat(
          tested_in(m.rest),
        ),
      Loop(l) -> accumulator.concat(tested_in(l.body)),
      _ -> accumulator,
    })

fn has_wrong_representation(t: TestedValue) -> Bool =
  if t.branch { t.representation != AsBool } else {
    match t.representation { AsInt -> false, AsBool -> false, AsFixed(_) -> false, _ -> true }
  }

test "a closure that tests a captured `Bool` tests it as a `Bool`, not as the word that stores the capture" {
  [b"chooser", b"guarded", b"either", b"picked"].fold((), |_: Unit, name: Bytes| {
    let f = lowered(name);
    match closure_of(f, 0) {
      None -> assert_eq(name, b""),
      Some(c) -> {
        let tests = tested_in(c.body.body);
        assert(tests.len() > 0);
        assert_eq(tests.filter(has_wrong_representation), [])
      },
    }
  })
}

test "a closure that matches a captured sum reads the sum's cases, not the word that stores the capture" {
  match program_of(corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let own = [b"or_named", b"or_lent", b"or_returned"].map(|name: Bytes| {
        let f = lowered_as_built(p, name);
        ownership_fault(insert_reference_counts(f))
      });
      let in_place = match lambda_specialisation(p, b"or_lent", b"apply_to", 0) {
        Ok(run) -> ownership_fault(insert_reference_counts(run.f)),
        Err(reason) -> Some(reason),
      };
      assert_eq(own.push(in_place), [None, None, None, None])
    },
  }
}

test "a specialisation reads a parameter passed as a word at its full type, so a `match` on it reads the sum's cases" {
  let source = Bytes::concat_all([
    b"type Fault = { path: String, at: Option<Int>, message: String }\n",
    b"fn mapped_ok<a, b>(r: Result<a, Fault>, f: (a) -> b) -> Result<b, Fault> = match r { Ok(x) -> Ok(f(x)), Err(e) -> Err(e) }\n",
    b"fn positive(r: Result<Int, Fault>) -> Result<Bool, Fault> = mapped_ok(r, |n: Int| n > 0)\n",
  ]);
  let built = |lambda_arguments: List<InlinedLambda>|
    match built_c(
        source,
        [],
        specialisation_key(b"m.mapped_ok", [int_type(), bool_type()], lambda_arguments),
      ) {
      Ok(text) -> if text.len() == 0 { Some(b"resolved by its callers") } else { None },
      Err(reason) -> Some(reason),
    };
  assert_eq([built([]), built([{ param: 1, owner: Named(b"m.positive"), nth: 0 }])], [None, None])
}

fn cases_module() -> { name: Bytes, source_text: Bytes } =
  {
    name: b"std.cases",
    source_text: Bytes::concat_all([
      b"pub type Table<a> = List<a>\n",
      b"pub type Listed = { label: String, identity: Bytes }\n",
      b"pub fn listed<a | e>(table: List<a>, label: (a) -> String / e) -> List<Listed> / {abort.raise | e} =\n",
      b"  table.map(|c: a| { label: label(c), identity: b\"\" })\n",
      b"pub fn chosen<a>(table: List<a>, at: Int, wanted: Bytes) -> a / {abort.raise} =\n",
      b"  match table.at(at) { Some(c) -> c, None -> panic(\"no case\") }\n",
    ]),
  }

fn builds(
  source: Bytes,
  shipped: List<{ name: Bytes, source_text: Bytes }>,
  root: RootKey,
) -> Result<Bool, Bytes> / {abort.raise} =
  match built_c(source, shipped, root) { Err(reason) -> Err(reason), Ok(_) -> Ok(true) }

test "a `test` declared `for` each case of a list uses each case at its declared type, and the generic functions it calls agree on that type" {
  let source = Bytes::concat_all([
    b"type Fixture = { name: String, unified: String }\n",
    b"fn fixtures() -> List<Fixture> = [{ name: \"a\", unified: \"\" }]\n",
    b"test \"each case's text is empty\" for f: Fixture in fixtures() { assert(f.unified == \"\") }\n",
  ]);
  assert_eq(
    builds(source, [cases_module()], test_key(b"m", b"each case's text is empty")),
    Ok(true),
  )
}

test "the variables a `law` binds become parameters of its generated functions, at the types the checker inferred for them" {
  let source = Bytes::concat_all([
    b"type Few = | Zero | One | Two\n",
    b"law \"two that differ differ\"\n  forall (a: Few, b: Few) where a != b {\n    a != b\n  }\n",
  ]);
  let root = |part: LawPart| law_key(b"m", b"two that differ differ", part);
  assert_eq([root(LawGuard), root(LawBody)].map(|r: RootKey| builds(source, [], r)), [
    Ok(true),
    Ok(true),
  ]);
  let poly = b"fn pair<a>(x: a) -> a = x\nlaw \"identity is identity\"\n  forall (x: a) {\n    pair(x) == x\n  }\n";
  assert_eq(builds(poly, [], law_key(b"m", b"identity is identity", LawBody)), Ok(true));
  let alone = b"law \"a value is itself\"\n  forall (x: a, y: b) {\n    x == x && y == y\n  }\n";
  let itself = law_key(b"m", b"a value is itself", LawBody);
  assert_eq(builds(alone, [], itself), Ok(true));
  match program_of(alone) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) ->
      assert_eq(
        {
          let _ = lowered_by_key(p, itself);
          b""
        },
        b"",
      ),
  }
}

fn lowered_tail_group(corpus_names: List<Bytes>) -> Result<Function, Bytes> / {abort.raise} =
  match program_of(corpus()) {
    Err(reason) -> Err(reason),
    Ok(p) -> {
      let members = corpus_names.fold([], |accumulator: List<GroupMember>, n: Bytes|
        match range(0, p.roots.len()).fold(None, |found: Option<GroupMember>, i: Int|
            match p.roots.at(i) {
              Some(r) -> if r.key != Named(qualify(b"m", n)) { found } else {
                let body = known_body(root_text(root_name(r.key)), r.params, r.code);
                Some({ context: context_of(p.setting, r, body), body: body })
              },
              None -> found,
            }) {
          Some(m) -> accumulator.push(m),
          None -> accumulator,
        });
      Ok(lowered_group(members))
    },
  }

fn instructions_in(b: Block) -> List<Instruction> =
  b.fold([], |accumulator: List<Instruction>, i: Instruction|
    match i {
      If(x) ->
        accumulator.push(i).concat(instructions_in(x.then)).concat(instructions_in(x.otherwise)),
      Case(c) ->
        c.arms.fold(
          accumulator.push(i).concat(instructions_in(c.rest)),
          |a: List<Instruction>, arm: { when: Int, body: Block }|
            a.concat(instructions_in(arm.body)),
        ),
      Match(m) ->
        m.arms.fold(
          accumulator.push(i).concat(instructions_in(m.rest)),
          |a: List<Instruction>, arm: Block| a.concat(instructions_in(arm)),
        ),
      _ -> accumulator.push(i),
    })

fn label_corpus() -> Bytes =
  Bytes::concat_all([
    b"effect net {\n  write send[s](payload: Int) -> Int\n}\n",
    b"fn hop<[l], [k]>(n: Int, sum: Int) -> Int / {net.send[l], net.send[k]} =\n",
    b"  if n <= 0 { sum } else { hop[k, l](n - 1, sum + net.send[l](n)) }\n",
    b"fn said<[l]>(n: (Int) -> Int / {net.send[l]}) -> Int / {net.send[l]} = n(1)\n",
    b"fn sent() -> Int / {net.send[db]} = said(|x: Int| net.send[db](x))\n",
  ])

test "a function that calls itself with its effect-label arguments in a different order restarts with the evidence for the labels it now passes" {
  match program_of(label_corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let f = lowered_as_built(p, b"hop");
      let words = f.params.drop(f.params.len() - 2).map(VariableOperand);
      assert_eq(
        instructions_in(f.body).fold([], |accumulator: List<List<Arg>>, i: Instruction|
          match i {
            Restart(args) -> accumulator.push(args.drop(args.len() - 2)),
            _ -> accumulator,
          }),
        [words.reverse()],
      )
    },
  }
}

test "a self call that passes along the evidence words it received as one array restarts with that same array, not a new one built in the loop" {
  let source = Bytes::concat_all([
    [b"e0", b"e1", b"e2", b"e3", b"e4"].fold(b"", |accumulator: Bytes, e: Bytes|
      Bytes::concat_all([accumulator, b"effect ", e, b" {\n  write go() -> Unit\n}\n"])),
    b"fn spin(n: Int) -> Int / {e0.go, e1.go, e2.go, e3.go, e4.go} =\n",
    b"  if n <= 0 { 0 } else { e0.go(); spin(n - 1) }\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let f = lowered_as_built(p, b"spin");
      assert_eq(
        instructions_in(f.body).fold([], |accumulator: List<List<Arg>>, i: Instruction|
          match i { Restart(args) -> accumulator.push(args.drop(1)), _ -> accumulator }),
        [f.params.drop(1).map(VariableOperand)],
      )
    },
  }
}

test "a lambda passed to a parameter whose effects use the callee's effect label is compiled as a closure that reads evidence for the label the call provides" {
  match program_of(label_corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let f = lowered_as_built(p, b"sent");
      assert_eq(f.links.generics.map(|g: GenericCall| g.functions), [])
    },
  }
}

test "a tail group lowers to one function that runs each member by case, and a tail call to another member jumps to that member" {
  match lowered_tail_group([b"even", b"odd"]) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(f) -> {
      assert_eq(f.members.map(|m: Member| m.key), [Named(b"m.even"), Named(b"m.odd")]);
      assert_eq(f.members.map(|m: Member| m.params.map(|v: Variable| v.representation)), [
        [AsInt],
        [AsInt],
      ]);
      assert_eq(
        instructions_in(f.body).fold([], |accumulator: List<Int>, i: Instruction|
          match i { Jump(e) -> accumulator.push(e.member), _ -> accumulator }),
        [1, 0],
      );
      assert_eq(
        instructions_in(f.body).filter(|i: Instruction|
          match i { Restart(_) -> true, _ -> false }).len(
        ),
        0,
      )
    },
  }
}

fn several_values(r: Representation) -> Bool = c_values_of(r).len() > 1

test "mutually tail-calling functions take and return a record and a sum as separate values, and their wrappers pass the group's function pointers" {
  match lowered_tail_group([b"walk", b"stride"]) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(f) -> {
      assert_eq(
        f.members.map(|m: Member|
          reps_of(m.convention).push(m.convention.result).map(several_values)),
        [[true, false, true], [true, false, true]],
      );
      assert_eq(
        instructions_in(f.body).fold([], |accumulator: List<Int>, i: Instruction|
          match i { Jump(e) -> accumulator.push(e.member), _ -> accumulator }),
        [1, 0],
      );
      let text = printed_text(corpus_program(), insert_reference_counts(f));
      assert(text.index_of(symbol_of(b"m.walk").concat(b"_group(ctx, 0, ")) != None)
    },
  };
  match lowered_tail_group([b"seek", b"probe"]) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(f) -> {
      assert_eq(
        f.members.map(|m: Member|
          reps_of(m.convention).push(m.convention.result).map(several_values)),
        [[true, false, true], [true, false, true]],
      );
      let text = printed_text(corpus_program(), insert_reference_counts(f));
      assert(text.index_of(symbol_of(b"m.seek").concat(b"_group(ctx, 0, ")) != None)
    },
  }
}

test "a closure written in a later function of a mutually tail-calling group uses that function's call-site scope" {
  match program_of(corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match lowered_tail_group([b"ping", b"pong"]) {
      Err(reason) -> assert_eq(reason, b""),
      Ok(f) -> {
        let base = match match root_index(p, b"pong") { Some(i) -> p.roots.at(i), None -> None } {
          Some(r) -> r.base,
          None -> 0 - 1,
        };
        assert_eq(
          range(0, f.lambdas.len()).map(|k: Int|
            match closure_of(f, k) { Some(c) -> c.body.body.at(0), None -> None }),
          [Some(SiteScope(Some({ root: Named(b"m.pong"), base: base })))],
        )
      },
    },
  }
}

test "a specialisation, looked up by its type arguments and lambda arguments, restarts on its own tail calls" {
  match program_of(corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> match lowered_specialisation(p, b"go", [int_type()], [], []) {
      Err(reason) -> assert_eq(reason, b""),
      Ok(f) -> {
        assert_eq(
          instructions_in(f.body).filter(|i: Instruction|
            match i { Restart(_) -> true, _ -> false }).len(
          ),
          1,
        );
        assert_eq(
          values_in(f.body).filter(|v: Rvalue| match v { Call(_) -> true, _ -> false }).len(),
          0,
        )
      },
    },
  }
}

fn rests_made(b: Block) -> Int =
  values_in(b).filter(|v: Rvalue|
    match v {
      OperationCall(o) -> o.operation == OfContainers(Rest),
      Convert(k) -> operand_representation(k.arg) == AsListView,
      _ -> false,
    }).len(
  )

test "a list that a function walks by restarting on its rest is a view of the list it received, and no step copies it" {
  match program_of(corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let walked = |name: Bytes| {
        let f = lowered_as_built(p, name);
        Ok({
          held: f.params.map(|v: Variable| v.representation).take(1),
          taken: reps_of(f.convention).take(1),
          restarts: instructions_in(f.body).any(|i: Instruction|
            match i { Restart(_) -> true, _ -> false }),
          rests: rests_made(f.body),
        })
      };
      let viewed = |rests: Int|
        Ok({ held: [AsListView], taken: [AsWord], restarts: true, rests: rests });
      assert_eq([b"has", b"pair_sums", b"lengths", b"again", b"tail_of"].map(walked), [
        viewed(0),
        viewed(0),
        viewed(1),
        viewed(0),
        viewed(1),
      ]);
      assert_eq(
        match walked(b"rest_lens") { Ok(w) -> Ok(w.held), Err(reason) -> Err(reason) },
        Ok([AsListView]),
      );
      assert_eq(
        walked(b"total"),
        Ok({ held: [AsWord], taken: [AsWord], restarts: false, rests: 1 }),
      );
      {
        let f = lowered_as_built(p, b"again");
        assert(
          values_in(f.body).any(|v: Rvalue|
            match v { Aggregate(g) -> g.parts.at(1) == Some(IntOperand(0)), _ -> false }),
        )
      }
    },
  }
}

fn first_loop_body(b: Block) -> Option<Block> =
  b.fold(None, |accumulator: Option<Block>, i: Instruction|
    match accumulator {
      Some(_) -> accumulator,
      None -> match i { Loop(l) -> Some(l.body), _ -> None },
    })

test "a loop step that does more work after raising an effect runs the remaining work, then tests the `Iter` value it returns" {
  {
    let f = lowered(b"raised_step");
    match first_loop_body(f.body) {
      None -> assert(false, Some("no loop")),
      Some(pass) -> {
        assert(match pass.at(pass.len() - 1) {
          Some(Case(c)) -> c.test == TagTest([b"Continue", b"Stop"]),
          _ -> false,
        });
        assert_eq(
          values_in(pass).filter(|v: Rvalue|
            match v {
              Aggregate(_) -> true,
              Allocate(m) -> match m.made { CaseAllocation(_) -> true, _ -> false },
              _ -> false,
            }).len(
          ),
          2,
        )
      },
    }
  }
}

test "a restart and a loop over a record set its parameter or state value by value" {
  {
    let f = lowered(b"walk1");
    assert(
      restarts(f.body)
        && (match f.params.at(0) { Some(p) -> several_values(p.representation), None -> false }),
    )
  };
  {
    let f = lowered(b"paired_step");
    assert_eq(
      f.body.fold([], |accumulator: List<Bool>, i: Instruction|
        match i {
          Loop(l) ->
            accumulator.concat(l.state.map(|c: LoopVariable| several_values(c.var.representation))),
          _ -> accumulator,
        }),
      [true, false],
    );
    assert_eq(undeclared(printed_text(corpus_program(), insert_reference_counts(f))), [])
  }
}

test "a continuation is a machine word the runtime calls with word arguments, and a handler clause that resumes it returns the word that call returns" {
  let applied = |f: Function|
    values_in(f.body).filter(|v: Rvalue| match v { Apply(_) -> true, _ -> false });
  let clause_of = |f: Function|
    range(0, f.lambdas.len()).fold(None, |accumulator: Option<Function>, k: Int|
      match closure_of(f, k) {
        Some(c) -> if applied(c.body).len() > 0 { Some(c.body) } else { accumulator },
        None -> accumulator,
      });
  let conventions = |c: Function|
    applied(c).map(|v: Rvalue|
      match v { Apply(a) -> reps_of(a.convention).push(a.convention.result), _ -> [] });
  let resumed = |c: Function|
    c.body.fold([], |accumulator: List<Variable>, i: Instruction|
      match i {
        Let(l) -> match l.value { Apply(_) -> accumulator.push(l.var), _ -> accumulator },
        _ -> accumulator,
      });
  let tail_only = |n: Bytes| {
    let f = lowered(n);
    match clause_of(f) {
      None -> assert(false, Some("no clause calls its continuation")),
      Some(c) -> {
        assert_eq(c.convention.result, AsWord);
        assert_eq(conventions(c), [[AsWord, AsWord]]);
        assert_eq(resumed(c).map(|v: Variable| c.body.contains(Return(VariableOperand(v)))), [
          true,
        ]);
        assert_eq(
          values_in(c.body).filter(|v: Rvalue|
            match v {
              Convert(k) -> resumed(c).any(|r: Variable| k.arg == VariableOperand(r)),
              _ -> false,
            }).len(
          ),
          0,
        )
      },
    }
  };
  tail_only(b"tailed");
  tail_only(b"gauged");
  {
    let f = lowered(b"off_tail");
    match clause_of(f) {
      None -> assert(false, Some("no clause calls its continuation")),
      Some(c) -> {
        assert_eq(c.convention.result, AsWord);
        assert_eq(conventions(c), [[AsWord, AsWord]])
      },
    }
  }
}

fn functions_of(text: Bytes) -> List<List<Bytes>> =
  text.split(b"\n").fold(
    { done: [], open: None },
    |accumulator: { done: List<List<Bytes>>, open: Option<List<Bytes>> }, l: Bytes|
      match accumulator.open {
        None -> if !l.starts_with(b" ") && l.ends_with(b"{") { { ..accumulator, open: Some([l]) } }
        else { accumulator },
        Some(o) -> if l == b"}" { { done: accumulator.done.push(o), open: None } }
        else { { ..accumulator, open: Some(o.push(l)) } },
      },
  ).done

fn undeclared(text: Bytes) -> List<Bytes> / {abort.raise} =
  functions_of(text).fold([], |accumulator: List<Bytes>, f: List<Bytes>| {
    let pieces = f.fold([], |s: List<Bytes>, l: Bytes| s.concat(fragments_of(l)));
    let declared = pieces.fold([], |d: List<Bytes>, s: Bytes|
      match declared_name(s) { Some(n) -> d.push(n), None -> d });
    pieces.fold(accumulator, |a: List<Bytes>, s: Bytes|
      match assigned_name(s) {
        Some(n) -> if declared.contains(n) || a.contains(n) { a } else { a.push(n) },
        None -> a,
      })
  })

fn fragments_of(l: Bytes) -> List<Bytes> / {abort.raise} =
  [b";", b",", b"(", b")", b"{", b"}"].fold([l], |ps: List<Bytes>, sep: Bytes|
    ps.fold([], |out: List<Bytes>, x: Bytes| out.concat(x.split(sep)))).map(|s: Bytes| {
    let from = range(0, s.len()).fold(s.len(), |at: Int, k: Int|
      if at == s.len() && s.at(k) != 32 { k } else { at });
    s.slice(from, s.len())
  })

fn declared_name(s: Bytes) -> Option<Bytes> / {abort.raise} =
  [b"Word", b"int64_t", b"int", b"double", b"bool", b"PlyMaybe", b"PlyTagged", b"PlyDec"].fold(
    None,
    |accumulator: Option<Bytes>, t: Bytes| {
      let head = t.concat(b" ");
      match accumulator {
        Some(_) -> accumulator,
        None -> if !s.starts_with(head) { None } else {
          let rest = s.slice(head.len(), s.len());
          let n = name_length(rest);
          if n == 0 { None } else { Some(rest.slice(0, n)) }
        },
      }
    },
  )

fn assigned_name(s: Bytes) -> Option<Bytes> / {abort.raise} = {
  let n = name_length(s);
  if n > 0 && s.slice(n, s.len()).starts_with(b" = ") { Some(s.slice(0, n)) } else { None }
}

fn name_length(s: Bytes) -> Int =
  range(0, s.len()).fold({ n: 0, open: true }, |accumulator: { n: Int, open: Bool }, k: Int| {
    let b = s.at(k);
    if accumulator.open
        && (b == 95 || (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122)) {
      { n: accumulator.n + 1, open: true }
    } else { { ..accumulator, open: false } }
  }).n

test "every function in the calling test corpus prints C that assigns only variables it declares" {
  let left_of = |f: Function| {
    let built = built_form(f);
    if needs_specialisation(built.links.needs) { [] }
    else { undeclared(printed_text(corpus_program(), built)) }
  };
  match program_of(corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let roots = corpus_names().fold(
        [],
        |accumulator: List<{ name: Bytes, names: List<Bytes> }>, n: Bytes| {
          let f = lowered_as_built(p, n);
          let left = left_of(f);
          if left.len() == 0 { accumulator } else { accumulator.push({ name: n, names: left }) }
        },
      );
      assert_eq(
        tail_groups().fold(
          roots,
          |accumulator: List<{ name: Bytes, names: List<Bytes> }>, g: List<Bytes>|
            match lowered_tail_group(g) {
              Err(_) -> accumulator,
              Ok(f) -> {
                let left = left_of(f);
                if left.len() == 0 { accumulator } else {
                  accumulator.push({
                    name: match g.at(0) { Some(n) -> n, None -> b"" },
                    names: left,
                  })
                }
              },
            },
        ),
        [],
      )
    },
  }
}

test "every function and tail group in the calling test corpus lowers, passes the lowered form's validity checks and prints" {
  match program_of(corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let failed = corpus_names().fold(
        [],
        |accumulator: List<{ name: Bytes, reason: Bytes }>, n: Bytes| {
          let f = lowered_as_built(p, n);
          match build_failure(p, f) {
            Some(reason) -> accumulator.push({ name: n, reason: reason }),
            None -> accumulator,
          }
        },
      );
      let grouped = tail_groups().fold(
        failed,
        |accumulator: List<{ name: Bytes, reason: Bytes }>, g: List<Bytes>| {
          let first = match g.at(0) { Some(n) -> n, None -> b"" };
          match lowered_tail_group(g) {
            Err(reason) -> accumulator.push({ name: first, reason: reason }),
            Ok(f) -> match build_failure(p, f) {
              Some(reason) -> accumulator.push({ name: first, reason: reason }),
              None -> accumulator,
            },
          }
        },
      );
      assert_eq(grouped, [])
    },
  }
}

fn root_calls(f: Function) -> List<{ callee: RootKey, convention: Convention }> =
  f.lambdas.fold(
    values_in(f.body).fold(
      [],
      |accumulator: List<{ callee: RootKey, convention: Convention }>, v: Rvalue|
        match v {
          Call(c) -> match c.callee {
            Root(k) -> accumulator.push({ callee: k, convention: c.convention }),
            _ -> accumulator,
          },
          _ -> accumulator,
        },
    ),
    |accumulator: List<{ callee: RootKey, convention: Convention }>, l: Lambda|
      match l { Closure(c) -> accumulator.concat(root_calls(c.body)) },
  )

test "every call of a function the test corpus defines uses the signature the function is declared with" {
  match program_of(corpus()) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let heads = corpus_names().fold(
        Map::new(),
        |m: Map<RootName, { result: Bytes, params: List<Bytes> }>, n: Bytes| {
          let f = lowered_as_built(p, n);
          m.insert(root_name(Named(qualify(b"m", n))), signature_types(f.convention))
        },
      );
      assert_eq(
        corpus_names().fold(
          [],
          |accumulator: List<{ caller: Bytes, callee: RootName }>, n: Bytes| {
            let f = lowered_as_built(p, n);
            root_calls(f).fold(
              accumulator,
              |a: List<{ caller: Bytes, callee: RootName }>, c: { callee: RootKey, convention: Convention }|
                match heads.get(root_name(c.callee)) {
                  Some(h) -> if h == signature_types(c.convention) { a }
                  else { a.push({ caller: n, callee: root_name(c.callee) }) },
                  None -> a,
                },
            )
          },
        ),
        [],
      )
    },
  }
}

fn is_wide_sum(r: Representation) -> Bool =
  match r {
    AsSum(_) -> value_words(r) == max_flat_words() + 1 && passing(r) == ByReference,
    _ -> false,
  }

test "a sum too wide for a call's registers is passed by reference, and its result is returned through a buffer the caller provides" {
  {
    let f = lowered(b"wide_twice");
    assert_eq(
      root_calls(f).map(|c: { callee: RootKey, convention: Convention }|
        reps_of(c.convention).map(is_wide_sum).push(is_wide_sum(c.convention.result))),
      [[false, true], [true, false]],
    );
    assert_eq(undeclared(printed_text(corpus_program(), insert_reference_counts(f))), [])
  }
}

test "a borrowed sum wider than a call's registers is read through a const pointer, never written through" {
  {
    let f = lowered(b"wide_loop");
    let lambda_arguments = { ..f, convention: with_ownerships(f.convention, [BorrowedParam]) };
    assert_eq(signature_types(lambda_arguments.convention).params.at(0), Some(b"const Word*"));
    let written = printed_text(corpus_program(), lambda_arguments).split(b"\n").filter(
      |l: Bytes|
        match l.index_of(b" = ") {
          Some(i) -> l.slice(0, i).index_of(b"p0[") != None,
          None -> false,
        },
    );
    assert_eq(written, [])
  }
}

test "a closure and a function value take a sum wider than a call's registers by reference too" {
  {
    let f = lowered(b"wide_reader");
    match closure_of(f, 0) {
      None -> assert(false, Some("wide_reader makes no closure")),
      Some(c) -> assert_eq(reps_of(c.body.convention).drop(c.captures).map(is_wide_sum), [true]),
    }
  };
  {
    let f = lowered(b"wide_applied");
    assert_eq(
      values_in(f.body).fold([], |accumulator: List<Bool>, v: Rvalue|
        match v {
          Apply(a) -> accumulator.concat(reps_of(a.convention).map(is_wide_sum)),
          _ -> accumulator,
        }),
      [true, false, false],
    )
  }
}

test "a tail group member takes a wide sum by reference, and its wrapper passes on the caller's own buffer unchanged" {
  match lowered_tail_group([b"wide_even", b"wide_odd"]) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(f) -> {
      assert_eq(f.members.map(|m: Member| reps_of(m.convention).map(is_wide_sum)), [
        [true, false],
        [true, false],
      ]);
      let text = printed_text(corpus_program(), insert_reference_counts(f));
      assert(
        text.index_of(symbol_of(b"m.wide_even").concat(b"_group(ctx, 0, (Word)(intptr_t)p0"))
          != None,
        Some(String::of_bytes_lossy(text)),
      )
    },
  }
}

test "a sum whose constructors take no fields is passed and returned as a single word, and its entry function passes that word on" {
  {
    let f = lowered(b"hue_twice");
    assert_eq(
      root_calls(f).map(|c: { callee: RootKey, convention: Convention }|
        reps_of(c.convention).push(c.convention.result).map(|r: Representation|
          match r { AsSum(_) -> c_values_of(r).len() == 1, _ -> false })),
      [[true, true], [true, true]],
    )
  };
  {
    let f = lowered(b"hue_next");
    let text = printed_text(corpus_program(), insert_reference_counts(f));
    assert(text.index_of(b"->layout == ") == None, Some(String::of_bytes_lossy(text)))
  }
}

test "a function used as a value is passed down a chain of generic calls along with the effects it performs" {
  let source = Bytes::concat_all([
    b"effect shipped {\n  read answer(n: Int) -> Int\n}\n",
    b"fn found<|e>(read: (Int) -> Int / {abort.raise | e}) -> Int / {abort.raise | e} = read(1)\n",
    b"fn record<|e>(read: (Int) -> Int / {abort.raise | e}) -> Int / {abort.raise | e} = found(read)\n",
    b"fn over_held<|e>(read: (Int) -> Int / {abort.raise | e}, look: (Int) -> Int / {abort.raise | e}) -> Int / {abort.raise | e} = {\n",
    b"  let packed_at = |k: Int| record(read) + k;\n",
    b"  packed_at(look(2))\n",
    b"}\n",
    b"fn fresh<|e>(read: (Int) -> Int / {abort.raise | e}, look: (Int) -> Int / {abort.raise | e}) -> Int / {abort.raise | e} = over_held(read, look)\n",
    b"fn pack_frame(n: Int) -> Int / {shipped.answer} = shipped.answer(n)\n",
    b"fn top() -> Int / {shipped.answer, abort.raise} = {\n",
    b"  let look = |k: Int| k + 1;\n",
    b"  fresh(pack_frame, look)\n",
    b"}\n",
  ]);
  match roots_built([{ name: b"m", source_text: source }]) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(keys) -> {
      let rows_of = |name: Bytes|
        keys.fold([], |accumulator: List<List<List<Evidence>>>, k: RootKey|
          match k {
            Specialisation(a, _) -> if a.definition == name { accumulator.push(a.effect_evidence) }
            else { accumulator },
            _ -> accumulator,
          });
      let shipped = [[{ effect: b"m.shipped", resource: SingletonResource }]];
      assert_eq(rows_of(b"m.fresh"), [shipped]);
      assert_eq(rows_of(b"m.over_held"), [shipped]);
      assert_eq(rows_of(b"m.record"), [shipped]);
      assert_eq(rows_of(b"m.found"), [shipped]);
      match ((program_of(source), keys.find(|k: RootKey| definition_of(k) == Some(b"m.found")))) {
        (Ok(p), Some(key)) -> match specialised_at(p, b"found", key, []) {
          Err(reason) -> assert_eq(reason, b""),
          Ok(f) ->
            assert(
              f.statics.any(|d: StaticDefinition|
                match d.layout {
                  StaticWords(ws) -> ws.contains(FieldWord(b"m.shipped")),
                  _ -> false,
                }),
              Some("no descriptor of `found` names `shipped`"),
            ),
        },
        _ -> assert(false, Some("no program, or no root of `found`")),
      }
    },
  }
}

test "a function from another module used as a value becomes a closure that receives handlers for the effects it performs" {
  let u = Bytes::concat_all([
    b"pub effect shipped {\n  read answer(n: Int) -> Int\n}\n",
    b"pub fn pack_frame(n: Int) -> Int / {shipped.answer} = shipped.answer(n)\n",
  ]);
  let source = Bytes::concat_all([
    b"import std.probe (shipped, pack_frame)\n",
    b"fn through<|e>(read: (Int) -> Int / {abort.raise | e}) -> Int / {abort.raise | e} = read(1)\n",
    b"fn top() -> Int / {shipped.answer, abort.raise} = through(pack_frame)\n",
  ]);
  let f = shipped_lowered(source, [{ name: b"std.probe", source_text: u }], b"m", b"top");
  assert_eq(f.lambdas.map(|l: Lambda| match l { Closure(c) -> c.words.count }), [1])
}

test "a handler's variables and clauses receive the effect handlers that the enclosing generic function was called with" {
  let source = Bytes::concat_all([
    b"effect shipped {\n  read answer(n: Int) -> Int\n}\n",
    b"effect keep {\n  read head(k: Int) -> Int\n}\n",
    b"fn opened<|e>(read: (Int) -> Int / {abort.raise | e}) -> Int / {abort.raise | e} = read(0)\n",
    b"fn found<|e>(read: (Int) -> Int / {abort.raise | e}, k: Int) -> Int / {abort.raise | e} = read(k)\n",
    b"fn held<|e>(read: (Int) -> Int / {abort.raise | e}, work: () -> Int / {keep.head, abort.raise}) -> Int / {abort.raise | e} = {\n",
    b"  let packed_at = |k: Int| found(read, k);\n",
    b"  handle { work() } with {\n",
    b"    var running: Int = opened(read),\n",
    b"    keep.head(k) -> { let p = packed_at(k); running = p; p },\n",
    b"  }\n",
    b"}\n",
    b"fn pack_frame(n: Int) -> Int / {shipped.answer} = shipped.answer(n)\n",
    b"fn top() -> Int / {shipped.answer, abort.raise} = held(pack_frame, || keep.head(1))\n",
  ]);
  match roots_built([{ name: b"m", source_text: source }]) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(keys) -> match ((
        program_of(source),
        keys.find(|k: RootKey| definition_of(k) == Some(b"m.held")),
      )) {
      (Ok(p), Some(key)) -> match specialised_at(p, b"held", key, []) {
        Err(reason) -> assert_eq(reason, b""),
        Ok(f) -> {
          let bodies = [f].concat(f.lambdas.map(|l: Lambda| match l { Closure(c) -> c.body }));
          let zeroed = bodies.fold([], |accumulator: List<List<Arg>>, g: Function|
            values_in(g.body).fold(accumulator, |a: List<List<Arg>>, v: Rvalue|
              match v {
                Call(c) -> if c.args.contains(ZeroOperand(AsImmediate)) { a.push(c.args) }
                else { a },
                Apply(x) -> if x.args.contains(ZeroOperand(AsImmediate)) { a.push(x.args) }
                else { a },
                _ -> a,
              }));
          assert_eq(zeroed, [])
        },
      },
      _ -> assert(false, Some("no program, or no root of `held`")),
    },
  }
}

test "a call to `List::fold` inside a lambda of a function generic over effects is specialised for those effects" {
  let source = Bytes::concat_all([
    b"effect probe {\n  read get(n: Int) -> Int\n}\n",
    b"fn bracket_fold<a | e>(init: a, f: (a, Int) -> a / e) -> a / {abort.raise | e} =\n",
    b"  bracket(|| 3, |_c: Int| (), |n: Int| [1, 2].fold(init, f))\n",
    b"fn got(n: Int) -> Int / {probe.get} = probe.get(n)\n",
    b"fn top() -> Int / {abort.raise} = handle { bracket_fold(0, |acc: Int, x: Int| acc + got(x)) } with { probe.get(n) -> n }\n",
  ]);
  match roots_built([{ name: b"m", source_text: source }]) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(keys) ->
      assert_eq(
        keys.fold([], |accumulator: List<List<List<Evidence>>>, k: RootKey|
          match k {
            Specialisation(a, _) -> if a.definition == b"std.prelude.List::fold" {
              accumulator.push(a.effect_evidence)
            } else { accumulator },
            _ -> accumulator,
          }),
        [[[{ effect: b"m.probe", resource: SingletonResource }]]],
      ),
  }
}

test "a function passed through a module that does not import its effect still runs with the handlers for the effects it performs" {
  let modules = [
    {
      name: b"packs",
      source_text: b"pub fn opened<|e>(read: (Int) -> Int / {abort.raise | e}) -> Int / {abort.raise | e} = read(0)\n",
    },
    {
      name: b"memo",
      source_text: Bytes::concat_all([
        b"import packs (opened)\n",
        b"pub effect shipped {\n  read answer(n: Int) -> Int\n}\n",
        b"pub fn fresh<|e>(read: (Int) -> Int / {abort.raise | e}) -> Int / {abort.raise | e} = opened(read)\n",
        b"pub fn pack_frame(n: Int) -> Int / {shipped.answer} = shipped.answer(n)\n",
      ]),
    },
    {
      name: b"m",
      source_text: Bytes::concat_all([
        b"import memo (shipped, fresh, pack_frame)\n",
        b"fn top() -> Int / {abort.raise} = handle { fresh(pack_frame) } with { shipped.answer(n) -> n }\n",
      ]),
    },
  ];
  match built(modules) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(e) -> {
      let opened = unit_text(e.produced.parts).split(b"\n}\n").filter(|f: Bytes|
        f.split(b"\n").any(|line: Bytes|
          line.index_of(b" ply_packs_") != None && line.index_of(b"(PlyCtx *ctx") != None
            && line.index_of(b"entered") == None
            && line.index_of(b";") == None));
      assert(opened.len() > 0, None);
      assert_eq(opened.filter(|f: Bytes| f.index_of(b"ctx->bridge") != None).len(), 0)
    },
  }
}
