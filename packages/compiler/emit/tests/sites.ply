import compiler.emit.emit_harness (built_c, program_of)
import compiler.emit.code (Code, CodeApply, NBuiltin, code_children)
import compiler.emit.lower.module_context (Root)
import compiler.expand.rewrite (CompilerNative, elaboration_natives)
import compiler.emit.keys (RootKey, Named, TestCases, Clause, ClauseKind, Requires, Ensures,
                           LawPart, LawGuard, LawBody, test_key, law_key)

fn cases_module() -> { name: Bytes, source_text: Bytes } =
  {
    name: b"std.cases",
    source_text: Bytes::concat_all([
      b"pub type Table<a> = List<a>\n",
      b"pub type Listed = { label: String, identity: Bytes }\n",
      b"pub fn listed<a | e>(table: List<a>, label: (a) -> String / e) -> List<Listed> / {abort.raise | e} =\n",
      b"  table.map(|c: a| { label: label(c), identity: b\"\" })\n",
      b"pub fn chosen<a>(table: List<a>, at: Int, wanted: Bytes) -> a / {abort.raise} =\n",
      b"  match table.at(at) { Some(c) -> c, None -> panic(\"no case\") }\n",
    ]),
  }

fn tag_module() -> { name: Bytes, source_text: Bytes } =
  {
    name: b"std.tg",
    source_text: Bytes::concat_all([
      b"pub fn literal(text: String) -> Result<String, { message: String, offset: Int }> = Ok(text)\n",
      b"pub fn compile(texts: List<String>) -> Result<List<String>, { message: String, offset: Int, part: Int }> = Ok(texts)\n",
      b"pub fn fill(texts: List<String>, holes: List<Int>) -> Int = texts.len() + holes.len()\n",
    ]),
  }

fn rewrite_corpus() -> Bytes =
  Bytes::concat_all([
    b"import std.tg\n",
    b"type Box = | Box(Int)\n",
    b"type P = { x: Int, y: Int }\n",
    b"effect parse {\n  raise bad(why: String)\n}\n",
    b"effect e {\n  write op(k: Int) -> Int\n}\n",
    b"fn Box::size(b: Box, extra: Int = 2) -> Int = match b { Box(v) -> v + extra }\n",
    b"fn mk() -> P = { x: 1, y: 2 }\n",
    b"fn digit(b: Int) -> Int / {parse.bad} = if b < 10 { b } else { parse.bad(\"no\") }\n",
    b"fn twice<a>(x: a) -> a where numeric(a) = x + x\n",
    b"fn holed(n: Int) -> Int = tg\"a {n} b {n + 1}\"\n",
    b"fn sized(b: Box) -> Int = b.size()\n",
    b"fn moved() -> P = { ..mk(), x: 3 }\n",
    b"fn tried(b: Int) -> Result<Int, String> = try { digit(b) }\n",
    b"fn held() -> Int = with_scope[r](1, |x: Int| ()) { h -> 7 }\n",
    b"fn counted() -> Int = handle { e.op(1) } with { var n = 0, e.op(k) -> { n = k; let f = |j: Int| j + n; f(1) }, return x -> x + n }\n",
    b"fn doubled() -> Int = twice(3)\n",
    b"test \"each case is positive\" for c: Int in [1, 2] { assert(c > 0) }\n",
  ])

fn builds(source: Bytes, root: RootKey) -> Result<Bool, Bytes> / {abort.raise} =
  match built_c(source, [tag_module(), cases_module()], root) {
    Err(reason) -> Err(reason),
    Ok(_) -> Ok(true),
  }

test "a test declared with `for` over a list of cases builds both as the test itself and as a root that lists its cases" {
  let source = b"type Pair = { a: Int, b: String }\ntest \"each pair holds\" for p: Pair in [{ a: 1, b: \"x\" }] { assert(p.a > 0) }\n";
  let run = test_key(b"m", b"each pair holds");
  assert_eq([run, TestCases(run)].map(|r: RootKey| builds(source, r)), [Ok(true), Ok(true)])
}

test "a function's `requires` and `ensures` clauses compile using the function's parameters" {
  let source = b"fn inc(x: Int) -> Int\n  requires x > 0\n  ensures result > x\n= x + 1\n";
  assert_eq(
    [Requires, Ensures].map(|kind: ClauseKind|
      builds(source, Clause({ definition: Named(b"m.inc"), kind: kind, n: 0 }))),
    [Ok(true), Ok(true)],
  )
}

test "a law's guard and body compile using the variables the law quantifies over" {
  let source = b"type Few = | One | Two\nlaw \"distinct\" forall (a: Few, b: Few) where a != b { a != b }\n";
  assert_eq(
    [LawGuard, LawBody].map(|part: LawPart| builds(source, law_key(b"m", b"distinct", part))),
    [Ok(true), Ok(true)],
  )
}

test "programs using a tagged literal with a hole, a record update on a call result, `try`, a scoped value, handler variables and a `numeric` witness all build" {
  let roots = [
    b"m.holed",
    b"m.moved",
    b"m.tried",
    b"m.counted",
    b"m.sized",
    b"m.held",
    b"m.doubled",
    b"m.twice",
  ];
  assert_eq(
    roots.map(|r: Bytes| { root: r, built: builds(rewrite_corpus(), Named(r)) }),
    roots.map(|r: Bytes| { root: r, built: Ok(true) }),
  )
}

test "a closure reads what it captures at the type of each read" {
  let source = Bytes::concat_all([
    b"fn within(fs: List<Int>, room: Int) -> List<Int> = range(0, fs.len()).map(|i: Int| match fs.at(i) { Some(x) -> x + room, None -> 0 })\n",
    b"fn nested(xs: List<Int>) -> Int = xs.fold(0, |s: Int, x: Int| { let { a, b } = { a: s, b: x }; range(0, a).fold(b, |acc: Int, k: Int| acc + k + a) })\n",
    b"fn handed(xs: List<Int>, n: Int) -> List<Int> = xs.map(|x: Int| x + n)\n",
    b"fn kept(xs: List<{ k: Int, v: Int }>, n: Int) -> List<Int> = xs.map(|e: { k: Int, v: Int }| e.k + n)\n",
    b"type T = { word: Bytes, n: Int }\n",
    b"fn reused(t: T) -> T = { let to = |n: Int| { word: if n > 0 { t.word } else { b\"\" }, n: n }; to(1) }\n",
  ]);
  let roots = [b"m.within", b"m.nested", b"m.handed", b"m.kept", b"m.reused"];
  assert_eq(
    roots.map(|r: Bytes| { root: r, built: builds(source, Named(r)) }),
    roots.map(|r: Bytes| { root: r, built: Ok(true) }),
  )
}

fn builtin_calls(c: Code) -> List<{ name: Bytes, args: Int }> =
  code_children(c).fold(
    match c.node {
      CodeApply(a) -> match a.function.node {
        NBuiltin(b) -> [{ name: b.name, args: a.args.len() }],
        _ -> [],
      },
      _ -> [],
    },
    |accumulator: List<{ name: Bytes, args: Int }>, x: Code| accumulator.concat(builtin_calls(x)),
  )

test "each runtime function the compiler calls is passed the number of words its declaration says it takes" {
  let declared = elaboration_natives().fold(
    Map::new(),
    |accumulator: Map<Bytes, Int>, n: CompilerNative| accumulator.insert(n.name, n.words),
  );
  let source = Bytes::concat_all([
    b"effect e {\n  write op(k: Int) -> Int\n}\n",
    b"fn f<a>(x: a, y: a) -> a where numeric(a) = x + -y\n",
    b"fn g() -> Int = with_scope[r](1, |x: Int| ()) { h -> h.get() }\n",
    b"fn h() -> Int = handle { e.op(1) } with { var n = 0, e.op(k) -> { n = k; n }, return x -> x + n }\n",
  ]);
  match program_of(source) {
    Err(reason) -> assert_eq(reason, b""),
    Ok(p) -> {
      let written = p.roots.fold([], |accumulator: List<{ name: Bytes, args: Int }>, r: Root|
        accumulator.concat(
          builtin_calls(r.code).filter(|c: { name: Bytes, args: Int }| declared.contains(c.name)),
        ));
      assert_eq(
        written.filter(|c: { name: Bytes, args: Int }| declared.get(c.name) != Some(c.args)),
        [],
      );
      let names = written.fold(
        Map::new(),
        |accumulator: Map<Bytes, Bool>, c: { name: Bytes, args: Int }|
          accumulator.insert(c.name, true),
      );
      assert_eq(names.keys(), declared.keys())
    },
  }
}
