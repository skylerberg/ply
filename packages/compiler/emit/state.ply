/// `value`, what `code` evaluated to, read with the layout its node's type gives it where the value
/// itself carries none: a word of that type, or an `Option`'s payload held as its word.
pub fn typed_value(emitter: Emitter, code: Code, value: CValue) -> CValue =
  match value.ty {
    TyOpen(_) -> match node_type(emitter, code) {
      None -> value,
      Some(ty) -> match value.kind {
        KBoxed -> laid_as(value, ty),
        KSum(Zeroed) -> match ty {
          TyCon(c) -> if c.name != b"Option" { value }
          else { match c.args.at(0) { Some(payload) -> laid_as(value, payload), None -> value } },
          _ -> value,
        },
        KSum(Tagged) -> if tagged_result(ty) { { ..value, ty: TyOf(ty) } } else { value },
        _ -> value,
      },
    },
    _ -> value,
  }

/// The type of the node `code`, where its place in the source is its alone and its type was
/// rebuilt.
pub fn node_type(emitter: Emitter, code: Code) -> Option<Type> =
  match emitter.typed.get(span_key(code.span)) {
    Some(t) -> match t.node {
      Some(ty) -> if ty == unknown_type() { None } else { Some(ty) },
      None -> None,
    },
    None -> None,
  }

/// What `code` evaluated to, as `typed_value` reads it.
pub fn typed(code: Code, made: Option<WithValue>) -> Option<WithValue> =
  match made {
    None -> None,
    Some(o) -> Some({ emitter: o.emitter, value: typed_value(o.emitter, code, o.value) }),
  }

/// `value`, a word, read as a value of `ty` is laid out where `ty` is held as a word and says how.
fn laid_as(value: CValue, ty: Type) -> CValue =
  if kind_of(ty).kind == KBoxed { { ..value, ty: known_or(word_ty(ty), value.ty) } } else { value }

/// What a word of type `ty` is laid out as: what `kind_of` reads of it, and an `Option` or a `Result`
/// as its type, which its constructors' arguments are read by.
pub fn word_ty(ty: Type) -> Ty =
  match kind_of(ty).ty {
    TyOpen(vs) -> match ty {
      TyCon(c) -> if (c.name == b"Option" && c.args.len() == 1)
          || (c.name == b"Result" && c.args.len() == 2) { TyOf(ty) }
      else { TyOpen(vs) },
      _ -> TyOpen(vs),
    },
    laid -> laid,
  }

// --- Specialisation ----------------------------------------------------------------------------

/// The tables of a body defining `full`, or its group's members, each with its head in `heads`.
pub fn tables_of(emitter: Emitter, full: Bytes, heads: List<Head>) -> Tables / {abort.raise} = {
  let names = if emitter.group.len() == 0 { [full] } else { emitter.group };
  {
    consts: emitter.consts.map(const_of_lit),
    builtins: emitter.called_builtins,
    fields: emitter.fields,
    // A shape's fields in the checker's order, which is what the unit interns a shape by.
    shapes: emitter.shapes.map(sorted_names),
    lambdas: emitter.lambdas,
    calls: emitter.calls,
    generics: emitter.generics,
    performs: emitter.performs,
    handles: emitter.handles,
    members: emitter.group,
    // What this body's C calls each definition it holds, so nothing downstream spells a symbol itself.
    symbols: range(0, names.len()).map(|i: Int|
      {
        symbol: symbol_of(names.get(i)),
        entry: entry_of(names.get(i)),
        head: match heads.at(i) { Some(h) -> h, None -> word_head(0) },
      }),
  }
}
