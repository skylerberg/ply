/// The root's parameter that slot `s` of the code being emitted is, which the window does not hold
/// where the prologue left it as its word: none inside a lambda run in place.
pub fn frame_param(emitter: Emitter, params: List<EmitParam>, s: Int) -> Option<EmitParam> =
  if emitter.inlined { None } else { params.at(s) }

/// The local a slot reads as: the window's, or a parameter the prologue did not open.
pub fn local_of(emitter: Emitter, params: List<EmitParam>, s: Int) -> Option<Bytes> =
  match conv_of(emitter, s) {
    Some(cv) -> Some(cv.expr),
    None -> match frame_param(emitter, params, s) {
      Some(_) -> Some(b"p".concat(ascii_of_int(s))),
      None -> None,
    },
  }

/// What a slot reads as, with the type the prologue knows a parameter it did not open by.
pub fn slot_value(emitter: Emitter, params: List<EmitParam>, s: Int) -> Option<CValue> =
  match conv_of(emitter, s) {
    Some(cv) -> Some(cv),
    None -> match frame_param(emitter, params, s) {
      Some(p) -> if p.kind == KBoxed {
        Some({ kind: KBoxed, expr: b"p".concat(ascii_of_int(s)), ty: p.ty })
      } else { None },
      None -> None,
    },
  }

