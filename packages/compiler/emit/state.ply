/// Where the value at hand goes: the root's answer, and a taker of a sum's constructor and argument.
type Position = { tail: Bool, leaves: Bool }

pub fn position(emitter: Emitter) -> Position = { tail: emitter.tail, leaves: emitter.leaves }

/// Restoring the node's own position makes an arm a tail again after its scrutinee or condition.
pub fn withtail(emitter: Emitter, at: Position) -> Emitter =
  if emitter.tail == at.tail && emitter.leaves == at.leaves { emitter } else {
    {
      out: emitter.out,
      temp_count: emitter.temp_count,
      unboxed: emitter.unboxed,
      indent: emitter.indent,
      reads: emitter.reads,
      shapes: emitter.shapes,
      built: emitter.built,
      module: emitter.module,
      base: emitter.base,
      count_locals: emitter.count_locals,
      here: emitter.here,
      imports: emitter.imports,
      consts: emitter.consts,
      ctors: emitter.ctors,
      lambda_bodies: emitter.lambda_bodies,
      lambdas: emitter.lambdas,
      owner: emitter.owner,
      builtins: emitter.builtins,
      called_builtins: emitter.called_builtins,
      fields: emitter.fields,
      released: emitter.released,
      reuse_widths: emitter.reuse_widths,
      alias: emitter.alias,
      by_root: emitter.by_root,
      tail: at.tail,
      calls: emitter.calls,
      generics: emitter.generics,
      refused: emitter.refused,
      deferred: emitter.deferred,
      deferred_locals: emitter.deferred_locals,
      performs: emitter.performs,
      handles: emitter.handles,
      landing: emitter.landing,
      effects: emitter.effects,
      release: emitter.release,
      pinned: emitter.pinned,
      bound: emitter.bound,
      group: emitter.group,
      operands: emitter.operands,
      typed: emitter.typed,
      answer: emitter.answer,
      site_root: emitter.site_root,
      lent: emitter.lent,
      written: emitter.written,
      slices: emitter.slices,
      sums: emitter.sums,
      leaves: at.leaves,
      inlined: emitter.inlined,
    }
  }

pub fn notail(emitter: Emitter) -> Emitter =
  if !emitter.tail && !emitter.leaves { emitter } else {
    {
      out: emitter.out,
      temp_count: emitter.temp_count,
      unboxed: emitter.unboxed,
      indent: emitter.indent,
      reads: emitter.reads,
      shapes: emitter.shapes,
      built: emitter.built,
      module: emitter.module,
      base: emitter.base,
      count_locals: emitter.count_locals,
      here: emitter.here,
      imports: emitter.imports,
      consts: emitter.consts,
      ctors: emitter.ctors,
      lambda_bodies: emitter.lambda_bodies,
      lambdas: emitter.lambdas,
      owner: emitter.owner,
      builtins: emitter.builtins,
      called_builtins: emitter.called_builtins,
      fields: emitter.fields,
      released: emitter.released,
      reuse_widths: emitter.reuse_widths,
      alias: emitter.alias,
      by_root: emitter.by_root,
      tail: false,
      calls: emitter.calls,
      generics: emitter.generics,
      refused: emitter.refused,
      deferred: emitter.deferred,
      deferred_locals: emitter.deferred_locals,
      performs: emitter.performs,
      handles: emitter.handles,
      landing: emitter.landing,
      effects: emitter.effects,
      release: emitter.release,
      pinned: emitter.pinned,
      bound: emitter.bound,
      group: emitter.group,
      operands: emitter.operands,
      typed: emitter.typed,
      answer: emitter.answer,
      site_root: emitter.site_root,
      lent: emitter.lent,
      written: emitter.written,
      slices: emitter.slices,
      sums: emitter.sums,
      leaves: false,
      inlined: emitter.inlined,
    }
  }

/// A branch's unboxed temporaries die at its closing brace, so `conv` must be restored after it.
pub fn rescope(emitter: Emitter, conv: List<Unboxed>) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: conv,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
    slices: emitter.slices,
    sums: emitter.sums,
    leaves: emitter.leaves,
    inlined: emitter.inlined,
  }

pub fn fresh(emitter: Emitter) -> { emitter: Emitter, name: Bytes } =
  {
    emitter: {
      out: emitter.out,
      temp_count: emitter.temp_count + 1,
      unboxed: emitter.unboxed,
      indent: emitter.indent,
      reads: emitter.reads,
      shapes: emitter.shapes,
      built: emitter.built,
      module: emitter.module,
