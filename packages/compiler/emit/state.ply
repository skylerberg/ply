pub fn note_deferred(emitter: Emitter, d: Deferred) -> Emitter =
  note_holder(push_deferred(emitter, d), d.name)

pub fn slice_of(emitter: Emitter, name: Bytes) -> Option<Slice> =
  emitter.slices.fold(None, |acc: Option<Slice>, sl: Slice|
    if sl.name == name { Some(sl) } else { acc })

/// `emitter` holding the list `base` read from `from` on as `name`, which the body declares.
pub fn note_slice(emitter: Emitter, name: Bytes, base: Bytes, from: Bytes) -> Emitter =
  {
    ..emitter,
    slices: emitter.slices.push({ name: name, base: base, from: from }),
    deferred_locals: emitter.deferred_locals.push(name),
  }

/// The list `sl` reads, made a list of its own: the elements from its offset on, or its base
/// itself, counted once more, where the offset is zero.
pub fn sliced_list(emitter: Emitter, sl: Slice, ty: Ty) -> WithValue = {
  let f = fresh(emitter);
  let made = line(
    f.emitter,
    Bytes::concat_all([
      b"Word ",
      f.name,
      b" = ",
      sl.from,
      b" ? rt_list_rest_p(ctx, ",
      sl.base,
      b", ",
      sl.from,
      b") : ",
      sl.base,
      b"; if (!",
      sl.from,
      b") ply_inc(",
      f.name,
      b");",
    ]),
  );
  { emitter: note_made(made, f.name), value: { kind: KBoxed, expr: f.name, ty: ty } }
}

pub fn push_deferred(emitter: Emitter, d: Deferred) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias,
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred.push(d),
    deferred_locals: emitter.deferred_locals.push(d.name),
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
    slices: emitter.slices,
    sums: emitter.sums,
    leaves: emitter.leaves,
    inlined: emitter.inlined,
  }

/// A local name (`t12`, `p0`, a record parameter's field `p0_1`, `q1`) rather than an expression.
pub fn is_local(e: Bytes) -> Bool =
  e.len() > 1 && (e.at(0) == 116 || e.at(0) == 112 || e.at(0) == 113)
    && range(1, e.len()).fold(true, |acc: Bool, i: Int|
      acc
        && ((e.at(i) >= 48 && e.at(i) <= 57)
        || (e.at(0) == 112 && e.at(i) == 95 && i > 1 && i + 1 < e.len())))

/// The parameter whose word `value` is, followed through renames and moves.
pub fn param_of(emitter: Emitter, value: CValue, params: List<EmitParam>) -> Option<Int> = {
  let root = root_of(emitter, value.expr);
  if root.len() < 2 || root.at(0) != 112
      || !range(1, root.len()).fold(true, |ok: Bool, i: Int|
        ok && root.at(i) >= 48 && root.at(i) <= 57) { None } else {
    let i = digits(root.slice(1, root.len()));
    if i < params.len() { Some(i) } else { None }
  }
}

pub fn note_generics(emitter: Emitter, g: Generics) -> Emitter = { ..emitter, generics: g }

pub fn root_of(emitter: Emitter, local: Bytes) -> Bytes =
  emitter.alias.fold(local, |acc: Bytes, a: { local: Bytes, root: Bytes }|
    if a.local == local { a.root } else { acc })

pub fn note_alias(emitter: Emitter, local: Bytes, root: Bytes) -> Emitter =
  {
    out: emitter.out,
    temp_count: emitter.temp_count,
    unboxed: emitter.unboxed,
    indent: emitter.indent,
    reads: emitter.reads,
    shapes: emitter.shapes,
    built: emitter.built,
    module: emitter.module,
    base: emitter.base,
    count_locals: emitter.count_locals,
    here: emitter.here,
    imports: emitter.imports,
    consts: emitter.consts,
    ctors: emitter.ctors,
    lambda_bodies: emitter.lambda_bodies,
    lambdas: emitter.lambdas,
    owner: emitter.owner,
    builtins: emitter.builtins,
    called_builtins: emitter.called_builtins,
    fields: emitter.fields,
    released: emitter.released,
    reuse_widths: emitter.reuse_widths,
    alias: emitter.alias.push({ local: local, root: root }),
    by_root: emitter.by_root,
    tail: emitter.tail,
    calls: emitter.calls,
    generics: emitter.generics,
    refused: emitter.refused,
    deferred: emitter.deferred,
    deferred_locals: emitter.deferred_locals,
    performs: emitter.performs,
    handles: emitter.handles,
    landing: emitter.landing,
    effects: emitter.effects,
    release: emitter.release,
    pinned: emitter.pinned,
    bound: emitter.bound,
    group: emitter.group,
    operands: emitter.operands,
    typed: emitter.typed,
    answer: emitter.answer,
    site_root: emitter.site_root,
    lent: emitter.lent,
    written: emitter.written,
    slices: emitter.slices,
    sums: emitter.sums,
    leaves: emitter.leaves,
    inlined: emitter.inlined,
  }

/// Charge a slot's reads to the object the local holds, once per (object, slot).
pub fn charge(emitter: Emitter, slot: Int, local: Bytes) -> Emitter = {
  let r = root_of(emitter, local);
  let already = emitter.by_root.fold(false, |acc: Bool, e: { root: Bytes, n: Int }|
    acc || e.root == Bytes::concat_all([r, b"#", ascii_of_int(slot)]));
  if already { emitter } else {
    {
      out: emitter.out,
      temp_count: emitter.temp_count,
      unboxed: emitter.unboxed,
      indent: emitter.indent,
      reads: emitter.reads,
      shapes: emitter.shapes,
      built: emitter.built,
      module: emitter.module,
      base: emitter.base,
      count_locals: emitter.count_locals,
      here: emitter.here,
      imports: emitter.imports,
      consts: emitter.consts,
      ctors: emitter.ctors,
      lambda_bodies: emitter.lambda_bodies,
      lambdas: emitter.lambdas,
      owner: emitter.owner,
      builtins: emitter.builtins,
      called_builtins: emitter.called_builtins,
      fields: emitter.fields,
      released: emitter.released,
      reuse_widths: emitter.reuse_widths,
      alias: emitter.alias,
      by_root: emitter.by_root.push({
        root: Bytes::concat_all([r, b"#", ascii_of_int(slot)]),
        n: 0,
      }).push({ root: r, n: emitter.reads.count(|y: Int| y == slot) }),
      tail: emitter.tail,
      calls: emitter.calls,
      generics: emitter.generics,
      refused: emitter.refused,
      deferred: emitter.deferred,
      deferred_locals: emitter.deferred_locals,
      performs: emitter.performs,
      handles: emitter.handles,
      landing: emitter.landing,
      effects: emitter.effects,
      release: emitter.release,
      pinned: emitter.pinned,
      bound: emitter.bound,
      group: emitter.group,
      operands: emitter.operands,
      typed: emitter.typed,
      answer: emitter.answer,
      site_root: emitter.site_root,
      lent: emitter.lent,
      written: emitter.written,
      slices: emitter.slices,
      sums: emitter.sums,
      leaves: emitter.leaves,
      inlined: emitter.inlined,
    }
  }
}

pub fn reads_of_root(emitter: Emitter, local: Bytes) -> Int = {
  let r = root_of(emitter, local);
  emitter.by_root.fold(0, |acc: Int, e: { root: Bytes, n: Int }|
    if e.root == r { acc + e.n } else { acc })
}

pub fn built_of(emitter: Emitter, local: Bytes) -> Option<Built> =
  emitter.built.fold(None, |acc: Option<Built>, b: Built|
    if b.local == local { Some(b) } else { acc })

/// Only a runtime helper's result hands over its count, a builtin's among them; a compiled call's result is duplicated before it is handed on.
pub fn answers_owned(emitter: Emitter, expr: Bytes) -> Bool =
  expr.starts_with(b"rt_") || expr.starts_with(b"builtin_")
    || (emitter.release
    && ((expr.len() > 4 && expr.slice(0, 4) == b"ply_" && calls_with_ctx(expr))
    || (

      // A generic call names its root by a placeholder the unit settles: a compiled call all the same.
      expr.starts_with(b"@@g")
    && calls_with_ctx(expr))
    || (expr.len() > 13 && expr.slice(0, 13) == b"(ply_fits_imm")))

/// A compiled call `ply_<name>(ctx, ...)`, told from a load or immediate by what follows the first parenthesis.
fn calls_with_ctx(expr: Bytes) -> Bool = {
  let p = expr.scan_until(0, b"(", expr.len());
  p + 4 <= expr.len() && expr.slice(p, p + 4) == b"(ctx"
}

pub fn note_made(emitter: Emitter, name: Bytes) -> Emitter =
  { ..emitter, count_locals: emitter.count_locals.push({ name: name, indent: emitter.indent }) }

/// A refusal: the first reason is kept, and emission runs out on a placeholder value.
pub fn poison(emitter: Emitter, why: Bytes) -> Emitter =
  match emitter.refused {
    Some(_) -> emitter,
    None ->
      {
        out: emitter.out,
        temp_count: emitter.temp_count,
        unboxed: emitter.unboxed,
        indent: emitter.indent,
        reads: emitter.reads,
        shapes: emitter.shapes,
        built: emitter.built,
        module: emitter.module,
        base: emitter.base,
        count_locals: emitter.count_locals,
        here: emitter.here,
        imports: emitter.imports,
        consts: emitter.consts,
        ctors: emitter.ctors,
        lambda_bodies: emitter.lambda_bodies,
        lambdas: emitter.lambdas,
        owner: emitter.owner,
        builtins: emitter.builtins,
        called_builtins: emitter.called_builtins,
        fields: emitter.fields,
        released: emitter.released,
        reuse_widths: emitter.reuse_widths,
        alias: emitter.alias,
        by_root: emitter.by_root,
        tail: emitter.tail,
        calls: emitter.calls,
        generics: emitter.generics,
        refused: Some(why),
        deferred: emitter.deferred,
        deferred_locals: emitter.deferred_locals,
        performs: emitter.performs,
        handles: emitter.handles,
        landing: emitter.landing,
        effects: emitter.effects,
        release: emitter.release,
        pinned: emitter.pinned,
        bound: emitter.bound,
        group: emitter.group,
        operands: emitter.operands,
        typed: emitter.typed,
        answer: emitter.answer,
        site_root: emitter.site_root,
        lent: emitter.lent,
        written: emitter.written,
        slices: emitter.slices,
        sums: emitter.sums,
        leaves: emitter.leaves,
        inlined: emitter.inlined,
      },
  }

pub fn refused(emitter: Emitter, why: Bytes) -> WithValue =
  { emitter: poison(emitter, why), value: { kind: KBoxed, expr: b"0", ty: TyOpen([]) } }

/// The index a symbol takes in this body's code table, added on first use.
pub fn lambda_of(emitter: Emitter, sym: Bytes) -> { emitter: Emitter, i: Int } =
  match range(0, emitter.lambdas.len()).fold(None, |acc: Option<Int>, i: Int|
      match emitter.lambdas.at(i) {
        Some(x) -> if x == sym { Some(i) } else { acc },
        None -> acc,
      }) {
    Some(i) -> { emitter: emitter, i: i },
    None ->
      {
        emitter: {
          out: emitter.out,
          temp_count: emitter.temp_count,
          unboxed: emitter.unboxed,
          indent: emitter.indent,
