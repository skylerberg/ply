//! The lowered form the code generator reads: slots resolved.

import syntax.parsing (Span, Ident, QName, dummy_span, span_key, qname_text, prelude_binder)
import syntax.patterns (Pattern, PWild, PVar, PLit, PRange, PCtor, PRecord, PList, POr, PBad, Lit,
                        LInt, LFixed, LWide, LBool, LStr, LBytes, LEmbedded, LFloat, LDec, LChar,
                        LUnit, LBad, has_or, alternatives_of)
import syntax.exprs (HandleClause, MatchArm, Param, Expr, ELit, EVar, EBinary, EUnary, EApp, EIf,
                     EBlock, EList, ERecord, EField, ELambda, EMatch, EPerform, EHandle, ESimulate,
                     EParallel, EBad, ERecordUpdate, ETry, Stmt, SLet, SLetElse, SExpr, SAssign,
                     RecField, expr_span, simulated_at, branch_at)
import syntax.items (Module, Item, IFn, parse)
import expand.rewrite (expand)
import std.list
import std.bytes (hex_digit, ascii_of_int)
import std.string

/// One lowered node: what it is, and where its text stands.
pub type Code = { node: Node, span: Span }

pub type Node =
  | NLit(Lit)
  | NVar({ name: Bytes, slot: Option<Int> })
  | NUnary({ op: Bytes, operand: Code })
  | NBinary({ op: Bytes, lhs: Code, rhs: Code })
  | NApp({ func: Code, args: List<Code> })
  | NIf({ cond: Code, then_branch: Code, else_branch: Code })
  | NBlock({ stmts: List<CodeStmt>, tail: Option<Code> })
  | NList({ items: List<Code> })
  | NRecord({ fields: List<CodeField> })
  | NMatch({ scrutinee: Code, arms: List<CodeArm> })
  /// `label` is the read of the label parameter the resource names, when a binder holds it.
  | NPerform({ effect: Bytes, op: Bytes, resource: Bytes, label: Option<Code>, args: List<Code> })
  /// One label argument of a call: the field-table entry of a resource named here.
  | NLabel(Bytes)
  | NLambda(Lambda)
  /// `at` is where the checker files the type of the closure the body runs in.
  | NSimulate({ size: Int, captures: List<Capture>, body: Code, at: Span })
  /// Each branch a nullary `NLambda`, which the run calls on whichever thread it chooses. `rooted`
  /// is whether the block is in its definition's own barrier, none of a lambda's, a clause's or a
  /// `simulate`'s between them, and in no `handle`'s body there: every operation its branches
  /// perform and do not answer is then in the definition's row.
  | NParallel({ branches: List<Code>, rooted: Bool })
  | NHandle({ body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn> })
  | NField({ base: Code, field: Bytes })
  /// `{..b, f: e}`, recognised in a plain literal where some field is `b.<its own name>` for one slot variable `b`.
  | NUpdate({ base: Code, copies: List<Bytes>, sets: List<CodeField> })
  /// A read of slot `slot`, known to hold the closure of the `nth` lambda `owner` wrote. A call of
  /// one runs `lambda` in place, its captures read out of the closure. Only the emitter makes one.
  | NKnown({ name: Bytes, slot: Int, lambda: Lambda, owner: Bytes, nth: Int })

/// A lambda as its owner lowered it: its parameters, its frame's size, what it copies in, and `at`,
/// where it is written.
pub type Lambda = { params: Int, size: Int, captures: List<Capture>, body: Code, at: Span }

pub type CodeField = { name: Bytes, value: Code }

/// A pattern with its binders resolved to slots, so a match writes bindings straight into the window.
pub type CodePattern =
  | PxWild
  /// `span` is the binder's, which the checker files the type it binds at.
  | PxVar({ name: Bytes, slot: Option<Int>, span: Span })
  | PxLit(Lit)
  /// An integer from `lo` through `hi`, both of one integer type.
  | PxRange({ lo: Lit, hi: Lit })
  | PxCtor({ name: Bytes, args: List<CodePattern> })
  | PxRecord({ fields: List<CodePatternField>, rest: Bool })
  | PxList({ items: List<CodePattern>, rest: Option<CodePattern> })

pub type CodePatternField = { name: Bytes, pat: CodePattern }

pub type CodeArm = { pat: CodePattern, guard: Option<Code>, body: Code }

/// A free name a barrier copies in on entry: its slot outside and its slot here.
pub type Capture = { src: Int, dst: Int }

/// A handler clause opens its own barrier: its parameters and `resume` binder take the leading slots.
pub type CodeClause = {
  effect: Bytes,
  op: Bytes,
  resource: Bytes,
  label: Option<Code>,
  params: Int,
  /// `[*t]` binds the call site's label as one more leading slot, after the parameters and before
  /// the continuation, which is the order the run appends them in.
  binds_label: Bool,
  resume: Bool,
  size: Int,
  captures: List<Capture>,
  body: Code,
  /// Where the clause is written, which the checker files its closure's type at: the operation's
  /// parameters, then the label and the continuation it binds.
  at: Span,
}

/// A handler's `return` clause, a barrier of its own led by the value the body answered; `at` is
/// where it is written, which the checker files its closure's type at.
pub type CodeReturn = { size: Int, captures: List<Capture>, body: Code, at: Span }

pub type CodeStmt =
  | CLet({ name: Bytes, slot: Int, value: Code })
  /// `let <pattern> = e`: the value is bound as a whole and the pattern's names read out of it.
  | CLetPat({ span: Span, pat: CodePattern, value: Code })
  | CDo({ code: Code })

// --- the dump ---------------------------------------------------------------

/// A resource a label parameter names is the slot it reads, which stays one comma-free word.
fn resource_tag(name: Bytes, label: Option<Code>) -> Bytes =
  match label {
    None -> name,
    Some(c) -> match c.node { NVar(v) -> b"$".concat(slot_tag(v.slot)), _ -> name },
  }

pub fn dump_lit(literal: Lit) -> Bytes / {abort.raise} =
  match literal {
    LInt(n) -> b"i".concat(ascii_of_int(n)),
    // Lowercased, so the dump has one spelling whatever case the suffix was written in.
    LFixed(name, bits) -> Bytes::concat_all([b"x", lower_bytes(name), b":", ascii_of_int(bits)]),
    LWide(name, high, low) ->
      Bytes::concat_all([
        b"x",
        lower_bytes(name),
        b":",
        ascii_of_int(high),
        b":",
        ascii_of_int(low),
      ]),
    LBool(b) -> if b { b"T" } else { b"F" },
    LStr(s) -> Bytes::concat_all([b"s", ascii_of_int(s.len()), b":", hex(s)]),
    LBytes(s) -> Bytes::concat_all([b"y", ascii_of_int(s.len()), b":", hex(s)]),
    LEmbedded(digest, size) -> Bytes::concat_all([b"e", ascii_of_int(size), b":", hex(digest)]),
    LFloat(_) -> b"f",
    LDec(r) -> Bytes::concat_all([b"d", ascii_of_int(r.len()), b":", hex(r)]),
    LChar(v) -> b"c".concat(ascii_of_int(v)),
    // Parser placeholders: never in a checked program's tree, so they dump as themselves.
    LUnit -> b"u",
    LBad -> b"!",
  }

fn lower_bytes(s: Bytes) -> Bytes / {abort.raise} =
  Bytes::of_string(String::of_bytes(s).ascii_lower())

pub fn hex(s: Bytes) -> Bytes / {abort.raise} =
  range(0, s.len()).fold(b"", |acc: Bytes, i: Int| {
    let byte = s.at(i);
    Bytes::concat_all([acc, hex_digit(byte / 16), hex_digit(byte % 16)])
  })

fn slot_tag(s: Option<Int>) -> Bytes = match s { Some(n) -> ascii_of_int(n), None -> b"-" }

fn dump_caps(captures: List<Capture>) -> Bytes =
  Bytes::concat_all([
    b"[",
    captures.fold(b"", |acc: Bytes, capture: Capture|
      Bytes::concat_all([acc, ascii_of_int(capture.src), b">", ascii_of_int(capture.dst), b" "])),
    b"]",
  ])

pub fn dump_pat(p: CodePattern) -> Bytes / {abort.raise} =
  match p {
    PxWild -> b"_",
    PxVar(v) -> Bytes::concat_all([b"v:", v.name, b":", slot_tag(v.slot)]),
    PxLit(l) -> b"l:".concat(dump_lit(l)),
    PxRange(r) -> Bytes::concat_all([b"g:", dump_lit(r.lo), b"..=", dump_lit(r.hi)]),
    PxCtor(c) ->
      Bytes::concat_all([
        b"c:",
        c.name,
        b"(",
        c.args.fold(b"", |acc: Bytes, a: CodePattern| Bytes::concat_all([acc, dump_pat(a), b","])),
        b")",
      ]),
    PxRecord(r) ->
      Bytes::concat_all([
        b"r:(",
        r.fields.fold(b"", |acc: Bytes, f: CodePatternField|
          Bytes::concat_all([acc, f.name, b"=", dump_pat(f.pat), b","])),
        if r.rest { b"..)" } else { b")" },
      ]),
    PxList(l) ->
      Bytes::concat_all([
        b"s:(",
        l.items.fold(b"", |acc: Bytes, i: CodePattern| Bytes::concat_all([acc, dump_pat(i), b","])),
        match l.rest { Some(r) -> b"..".concat(dump_pat(r)), None -> b"" },
        b")",
      ]),
  }

pub fn dump(code: Code) -> Bytes / {abort.raise} = dump_node(code.node)

fn dump_node(n: Node) -> Bytes / {abort.raise} =
  match n {
    NLit(l) -> Bytes::concat_all([b"lit(", dump_lit(l), b")"]),
    NVar(v) -> Bytes::concat_all([b"var(", v.name, b",", slot_tag(v.slot), b")"]),
    NUnary(u) -> Bytes::concat_all([b"un(", u.op, b",", dump(u.operand), b")"]),
    NBinary(b) -> Bytes::concat_all([b"bin(", b.op, b",", dump(b.lhs), b",", dump(b.rhs), b")"]),
    NApp(a) ->
      Bytes::concat_all([
        b"app(",
        dump(a.func),
        a.args.fold(b"", |acc: Bytes, code: Code| Bytes::concat_all([acc, b",", dump(code)])),
        b")",
      ]),
    NKnown(k) -> Bytes::concat_all([b"known(", k.owner, b",", k.name, b")"]),
    NIf(i) ->
      Bytes::concat_all([
        b"if(",
        dump(i.cond),
        b",",
        dump(i.then_branch),
        b",",
        dump(i.else_branch),
        b")",
      ]),
    NBlock(b) ->
      Bytes::concat_all([
        b"block(",
        b.stmts.fold(b"", |acc: Bytes, stmt: CodeStmt|
          acc.concat(match stmt {
            CLet(l) ->
              Bytes::concat_all([
                b"let(v:",
                l.name,
                b":",
                ascii_of_int(l.slot),
                b",",
                dump(l.value),
                b"),",
              ]),
            CLetPat(l) -> Bytes::concat_all([b"let(", dump_pat(l.pat), b",", dump(l.value), b"),"]),
            CDo(d) -> Bytes::concat_all([b"do(", dump(d.code), b"),"]),
          })),
        match b.tail { Some(t) -> dump(t), None -> b"-" },
        b")",
      ]),
    NList(l) ->
      Bytes::concat_all([
        b"list(",
        l.items.fold(b"", |acc: Bytes, code: Code| Bytes::concat_all([acc, dump(code), b","])),
        b")",
      ]),
    NRecord(r) ->
      Bytes::concat_all([
        b"rec(",
        r.fields.fold(b"", |acc: Bytes, fd: CodeField|
          Bytes::concat_all([acc, fd.name, b"=", dump(fd.value), b","])),
        b")",
      ]),
    NMatch(m) ->
      Bytes::concat_all([
        b"match(",
        dump(m.scrutinee),
        m.arms.fold(b"", |acc: Bytes, a: CodeArm|
          Bytes::concat_all([
            acc,
            b",arm(",
            dump_pat(a.pat),
            b",",
            match a.guard { Some(g) -> dump(g), None -> b"-" },
            b",",
            dump(a.body),
            b")",
          ])),
        b")",
      ]),
    NLabel(n) -> Bytes::concat_all([b"label(", n, b")"]),
    NPerform(p) ->
      Bytes::concat_all([
        b"perform(",
        p.effect,
        b",",
        p.op,
        b",",
        resource_tag(p.resource, p.label),
        p.args.fold(b"", |acc: Bytes, a: Code| Bytes::concat_all([acc, b",", dump(a)])),
        b")",
      ]),
    NParallel(pr) ->
      Bytes::concat_all([
        b"par(",
        pr.branches.fold(b"", |acc: Bytes, code: Code| Bytes::concat_all([acc, dump(code), b","])),
        b")",
      ]),
    NSimulate(sm) ->
      Bytes::concat_all([
        b"sim(",
        ascii_of_int(sm.size),
        b",",
        dump_caps(sm.captures),
        b",",
        dump(sm.body),
        b")",
      ]),
    NHandle(h) ->
      Bytes::concat_all([
        b"handle(",
        dump(h.body),
        h.clauses.fold(b"", |acc: Bytes, c: CodeClause|
          Bytes::concat_all([
            acc,
            b",cl(",
            c.effect,
            b",",
            c.op,
            b",",
            resource_tag(c.resource, c.label),
            b",",
            ascii_of_int(c.params),
            b",",
            if c.resume { b"true" } else { b"false" },
            b",",
            ascii_of_int(c.size),
            b",",
            dump_caps(c.captures),
            b",",
            dump(c.body),
            b")",
          ])),
        match h.ret {
          Some(r) ->
            Bytes::concat_all([
              b",ret(",
              ascii_of_int(r.size),
              b",",
              dump_caps(r.captures),
              b",",
              dump(r.body),
              b")",
            ]),
          None -> b",-",
        },
        b")",
      ]),
    NLambda(l) ->
      Bytes::concat_all([
        b"lam(",
        ascii_of_int(l.params),
        b",",
        ascii_of_int(l.size),
        b",",
        dump_caps(l.captures),
        b",",
        dump(l.body),
        b")",
      ]),
    NField(f) -> Bytes::concat_all([b"fld(", dump(f.base), b",", f.field, b")"]),
    NUpdate(u) ->
      Bytes::concat_all([
        b"upd(",
        dump(u.base),
        u.copies.fold(b"", |acc: Bytes, n: Bytes| Bytes::concat_all([acc, b",c:", n])),
        u.sets.fold(b"", |acc: Bytes, f: CodeField|
          Bytes::concat_all([acc, b",s:", f.name, b"=", dump(f.value)])),
        b")",
      ]),
  }

// --- slots ------------------------------------------------------------------
// Forward pass: every binding gets a slot and slot numbers never go back, so a window is sized by
// bindings, not by how many are live at once.

type Bind = { name: Bytes, slot: Int }

/// `names` is the barrier's window in order; `scope` is what is visible here, innermost last.
type Frame = {
  names: List<Bytes>,
  scope: List<Bind>,
  captures: List<Capture>,
  capture_names: List<Bytes>,
}

fn bind(frame: Frame, name: Bytes) -> Frame =
  {
    names: frame.names.push(name),
    scope: frame.scope.push({ name: name, slot: frame.names.len() }),
    captures: frame.captures,
    capture_names: frame.capture_names,
  }

fn find(frame: Frame, name: Bytes) -> Option<Int> =
  frame.scope.fold(None, |acc: Option<Int>, b: Bind|
    if b.name == name { Some(b.slot) } else { acc })

/// The barriers in scope, innermost last. A free name is threaded through every barrier between use and binding.
/// `handled`: inside the body of a `handle`, which runs in the barrier its `handle` is written in.
type Stack = {
  frames: List<Frame>,
  labels: List<Bytes>,
  sites: Map<Bytes, List<Bytes>>,
  handled: Bool,
  /// The binder a function of a type of the module being lowered is written out through, where
  /// its caller reads such a call as one of the module's own; empty where it does not.
  own: Bytes,
}

fn st_top(stack: Stack) -> Frame =
  match stack.frames.at(stack.frames.len() - 1) { Some(f) -> f, None -> empty_frame() }

fn empty_frame() -> Frame = { names: [], scope: [], captures: [], capture_names: [] }

fn st_at(stack: Stack, i: Int) -> Frame =
  match stack.frames.at(i) { Some(f) -> f, None -> empty_frame() }

fn st_set(stack: Stack, i: Int, frame: Frame) -> Stack =
  {
    ..stack,
    frames: range(0, stack.frames.len()).map(|j: Int| if j == i { frame } else { st_at(stack, j) }),
  }

fn st_top_set(stack: Stack, frame: Frame) -> Stack = st_set(stack, stack.frames.len() - 1, frame)

fn st_push(stack: Stack, frame: Frame) -> Stack = { ..stack, frames: stack.frames.push(frame) }

fn st_pop(stack: Stack) -> Stack =
  { ..stack, frames: range(0, stack.frames.len() - 1).map(|j: Int| st_at(stack, j)) }

/// The depth whose barrier has `name` in scope or already captures it, innermost first.
fn st_depth(stack: Stack, name: Bytes) -> Option<Int> =
  range(0, stack.frames.len()).fold(None, |acc: Option<Int>, i: Int| {
    let f = st_at(stack, i);
    match find(f, name) {
      Some(_) -> Some(i),
      None -> match find_cap(f, name) { Some(_) -> Some(i), None -> acc },
    }
  })

fn slot_in(f: Frame, name: Bytes) -> Option<Int> =
  match find(f, name) { Some(s) -> Some(s), None -> find_cap(f, name) }

/// Resolves `name` at the innermost barrier, threading a capture through every barrier between when it is free.
type SlotLookup = { slot: Option<Int>, stack: Stack }

fn resolve(stack: Stack, name: Bytes) -> SlotLookup =
  match st_depth(stack, name) {
    None -> { slot: None, stack: stack },
    Some(d) -> {
      let start = match slot_in(st_at(stack, d), name) { Some(s) -> s, None -> 0 };
      range(d + 1, stack.frames.len()).fold(
        { slot: Some(start), stack: stack },
        |acc: SlotLookup, i: Int| {
          let f = st_at(acc.stack, i);
          let from = match acc.slot { Some(s) -> s, None -> 0 };
          match find_cap(f, name) {
            Some(s) -> { slot: Some(s), stack: acc.stack },
            None -> {
              let g = capture(f, name, from);
              { slot: find_cap(g, name), stack: st_set(acc.stack, i, g) }
            },
          }
        },
      )
    },
  }

/// The name a label parameter is bound under: no value can take it, so no binder shadows the label.
fn label_binder(name: Bytes) -> Bytes = Bytes::concat_all([b"[", name, b"]"])

/// A resource a label binder holds is read like any other name, captures threaded and all.
fn label_code(stack: Stack, name: Bytes) -> Option<Lowered> =
  if !stack.labels.contains(name) { None } else {
    let binder = label_binder(name);
    let r = resolve(stack, binder);
    Some({
      code: { span: dummy_span(), node: NVar({ name: binder, slot: r.slot }) },
      stack: r.stack,
    })
  }

type Labels = { codes: List<Code>, stack: Stack }

/// The labels a call fills: this body's own parameter, or a field-table entry of the name.
fn label_args(stack: Stack, span: Span) -> Labels =
  List::fold(
    match stack.sites.get(span_key(span)) { Some(xs) -> xs, None -> [] },
    { codes: [], stack: stack },
    |acc: Labels, n: Bytes|
      match label_code(acc.stack, n) {
        Some(o) -> { codes: acc.codes.push(o.code), stack: o.stack },
        None ->
          { codes: acc.codes.push({ span: dummy_span(), node: NLabel(n) }), stack: acc.stack },
      },
  )

/// A block's binders leave scope at its end, but the slots they took are never reused.
fn bind_st(stack: Stack, name: Bytes) -> Stack = st_top_set(stack, bind(st_top(stack), name))

fn unscope(frame: Frame, to: Int) -> Frame =
  {
    names: frame.names,
    scope: take(frame.scope, to),
    captures: frame.captures,
    capture_names: frame.capture_names,
  }

fn unscope_st(stack: Stack, to: Int) -> Stack = st_top_set(stack, unscope(st_top(stack), to))

fn depth_of(stack: Stack) -> Int = st_top(stack).scope.len()

fn find_cap(frame: Frame, name: Bytes) -> Option<Int> =
  range(0, frame.capture_names.len()).fold(None, |acc: Option<Int>, i: Int|
    if frame.capture_names.at_or(i, b"") == name {
      match frame.captures.at(i) { Some(c) -> Some(c.dst), None -> acc }
    } else { acc })

fn capture(frame: Frame, name: Bytes, src: Int) -> Frame =
  {
    names: frame.names.push(name),
    scope: frame.scope,
    captures: frame.captures.push({ src: src, dst: frame.names.len() }),
    capture_names: frame.capture_names.push(name),
  }

fn take(xs: List<Bind>, n: Int) -> List<Bind> =
  range(0, n).fold([], |acc: List<Bind>, i: Int| acc.push(xs.at_or(i, { name: b"", slot: 0 })))

// --- the lowering -----------------------------------------------------------
// `None` for a form not lowered.

type Lowered = { code: Code, stack: Stack }

fn lower_in(e: Expr, stack: Stack) -> Option<Lowered> / {abort.raise} =
  match e {
    ELit(x) -> Some({ code: { span: expr_span(e), node: NLit(x.lit) }, stack: stack }),
    // `ERecordUpdate` is written out as a literal before lowering; `as_update` recognises the result.
    EVar(x) -> match x.name.module {
      // A qualified name is a global, never a slot: a module binder cannot be shadowed by a local.
      // One the checker wrote through the prelude's binder is the builtin of that name.
      Some(m) ->
        Some({
          code: {
            span: expr_span(e),
            node: NVar({
              name: if m.name == prelude_binder() || (stack.own != b"" && m.name == stack.own) {
                x.name.name.name
              } else { Bytes::concat_all([m.name, b"::", x.name.name.name]) },
              slot: None,
            }),
          },
          stack: stack,
        }),
      None -> {
        let name = x.name.name.name;
        let r = resolve(stack, name);
        Some({
          code: { span: expr_span(e), node: NVar({ name: name, slot: r.slot }) },
          stack: r.stack,
        })
      },
    },
    EUnary(x) -> match lower_in(x.operand, stack) {
      Some(o) ->
        Some({
          code: { span: expr_span(e), node: NUnary({ op: x.op, operand: o.code }) },
          stack: o.stack,
        }),
      None -> None,
    },
    EBinary(x) -> match lower_in(x.lhs, stack) {
      None -> None,
      Some(l) -> match lower_in(x.rhs, l.stack) {
        None -> None,
        Some(r) ->
          Some({
            code: { span: expr_span(e), node: NBinary({ op: x.op, lhs: l.code, rhs: r.code }) },
            stack: r.stack,
          }),
      },
    },
    EIf(x) -> match lower_in(x.cond, stack) {
      None -> None,
      Some(c) -> match lower_in(x.then_branch, c.stack) {
        None -> None,
        Some(t) -> match lower_in(x.else_branch, t.stack) {
          None -> None,
          Some(el) ->
            Some({
              code: {
                span: expr_span(e),
                node: NIf({ cond: c.code, then_branch: t.code, else_branch: el.code }),
              },
              stack: el.stack,
            }),
        },
      },
    },
    EField(x) -> match lower_in(x.base, stack) {
      Some(b) ->
        Some({
          code: { span: expr_span(e), node: NField({ base: b.code, field: x.field.name }) },
          stack: b.stack,
        }),
      None -> None,
    },
    EList(x) -> match lower_seq(x.items, stack) {
      Some(r) ->
        Some({ code: { span: expr_span(e), node: NList({ items: r.codes }) }, stack: r.stack }),
      None -> None,
    },
    ERecord(x) -> match as_update(x.fields, stack, x.span) {
      Some(u) -> Some(u),
      None -> match lower_seq(x.fields.map(|field: RecField| field.value), stack) {
        None -> None,
        Some(r) ->
          Some({
            code: {
              span: expr_span(e),
              node: NRecord({
                fields: range(0, x.fields.len()).map(|i: Int|
                  { name: field_name(x.fields, i), value: nth(r.codes, i) }),
              }),
            },
            stack: r.stack,
          }),
      },
    },
    EApp(x) -> if x.named.len() > 0 { None } else {
      match lower_in(x.func, stack) {
        None -> None,
        Some(fu) -> match lower_seq(x.args, fu.stack) {
          Some(r) -> {
            let ls = label_args(r.stack, expr_span(e));
            Some({
              code: {
                span: expr_span(e),
                node: NApp({
                  func: fu.code,
                  args: ls.codes.fold(r.codes, |acc: List<Code>, code: Code| acc.push(code)),
                }),
              },
              stack: ls.stack,
            })
          },
          None -> None,
        },
      }
    },
    EMatch(x) -> match lower_in(x.scrutinee, stack) {
      None -> None,
      Some(sc) ->
        matched(expr_span(e), sc, |start: ArmAcc|
          x.arms.fold(start, |acc: ArmAcc, arm: MatchArm|
            arms_into(acc, arm.pat, arm.guard, |st: Stack| lower_in(arm.body, st)))),
    },
    EPerform(x) -> match lower_seq(x.args, stack) {
      None -> None,
      Some(r) -> {
        let name = match x.resource { Some(id) -> id.name, None -> b"" };
        let lb = label_code(r.stack, name);
        Some({
          code: {
            span: expr_span(e),
            node: NPerform({
              effect: qname_text(x.eff),
              op: x.op.name,
              resource: name,
              label: match lb { Some(o) -> Some(o.code), None -> None },
              args: r.codes,
            }),
          },
          stack: match lb { Some(o) -> o.stack, None -> r.stack },
        })
      },
    },
    // The binder is in scope for the body only; the init is evaluated before it exists.
    // A lambda opens its own barrier; a name it reads from outside becomes a capture.
    ELambda(x) ->
      lower_lambda(x.params.map(|param: Param| param.name.name), x.body, stack, expr_span(e)),
    // `simulate` opens a barrier, as a lambda does, and takes no parameters.
    ESimulate(x) -> match lower_in(x.body, st_push(stack, empty_frame())) {
      None -> None,
      Some(b) -> {
        let inner = st_top(b.stack);
        Some({
          code: {
            span: expr_span(e),
            node: NSimulate({
              size: inner.names.len(),
              captures: inner.captures,
              body: b.code,
              at: simulated_at(x.span),
            }),
          },
          stack: st_pop(b.stack),
        })
      },
    },
    // Each branch is a lambda with no parameters.
    EParallel(x) -> match x.branches.fold(
        Some({ codes: [], stack: stack }),
        |acc: Option<Seq>, b: Expr|
          match acc {
            None -> None,
            Some(sq) -> match lower_lambda([], b, sq.stack, branch_at(b)) {
              Some(o) -> Some({ codes: sq.codes.push(o.code), stack: o.stack }),
              None -> None,
            },
          },
      ) {
      None -> None,
      Some(r) ->
        Some({
          code: {
            span: expr_span(e),
            node: NParallel({
              branches: r.codes,
              rooted: stack.frames.len() == 1 && !stack.handled,
            }),
          },
          stack: r.stack,
        }),
    },
    // The body runs in the enclosing barrier; each clause opens its own, led by its parameters and `resume`.
    // A handle whose variables were not written out declines, as an unchecked program does.
    EHandle(x) -> match if x.vars.len() > 0 { None }
      else { lower_in(x.body, { ..stack, handled: true }) } {
      None -> None,
      Some(b) -> {
        let cls = x.clauses.fold(
          { clauses: [], stack: { ..b.stack, handled: stack.handled }, ok: true },
          |acc: ClauseAcc, c: HandleClause|
            if !acc.ok { acc } else {
              let named = c.params.map(|i: Ident| i.name);
              let with_label = match c.label_binder {
                Some(t) -> named.push(t.name),
                None -> named,
              };
              let names = match c.resume {
                Some(rid) -> with_label.push(rid.name),
                None -> with_label,
              };
              let inner = names.fold(empty_frame(), |g: Frame, n: Bytes| bind(g, n));
              // The clause's resource is read where the table is built, outside the clause's own barrier.
              // A `[*]` clause keys on the wildcard rather than on a label, so it answers every
              // label the table is asked about.
              let res = if c.every_label { b"*" }
              else { match c.resource { Some(id) -> id.name, None -> b"" } };
              let lb = label_code(acc.stack, res);
              let outer = match lb { Some(o) -> o.stack, None -> acc.stack };
              match lower_in(c.body, st_push(outer, inner)) {
                None -> { clauses: acc.clauses, stack: acc.stack, ok: false },
                Some(cb) -> {
                  let f = st_top(cb.stack);
                  {
                    clauses: acc.clauses.push({
                      effect: qname_text(c.eff),
                      op: c.op.name,
                      resource: res,
                      label: match lb { Some(o) -> Some(o.code), None -> None },
                      params: c.params.len(),
                      binds_label: match c.label_binder { Some(_) -> true, None -> false },
                      resume: match c.resume { Some(_) -> true, None -> false },
                      size: f.names.len(),
                      captures: f.captures,
                      body: cb.code,
                      at: c.span,
                    }),
                    stack: st_pop(cb.stack),
                    ok: true,
                  }
                },
              }
            },
        );
        if !cls.ok { None } else {
          match x.ret {
            None ->
              Some({
                code: {
                  span: expr_span(e),
                  node: NHandle({ body: b.code, clauses: cls.clauses, ret: None }),
                },
                stack: cls.stack,
              }),
            Some(r) -> {
              let inner = bind(empty_frame(), r.binder.name);
              match lower_in(r.body, st_push(cls.stack, inner)) {
                None -> None,
                Some(rb) -> {
                  let f = st_top(rb.stack);
                  Some({
                    code: {
                      span: expr_span(e),
                      node: NHandle({
                        body: b.code,
                        clauses: cls.clauses,
                        ret: Some({
                          size: f.names.len(),
                          captures: f.captures,
                          body: rb.code,
                          at: r.span,
                        }),
                      }),
                    },
                    stack: st_pop(rb.stack),
                  })
                },
              }
            },
          }
        }
      },
    },
    EBlock(x) -> lower_block(x.stmts, x.tail, stack),
    _ -> None,
  }

fn field_name(fs: List<RecField>, i: Int) -> Bytes =
  match fs.at(i) { Some(fd) -> fd.name.name, None -> b"" }

/// Recovers an update from a literal whose copied fields are `b.<own name>` for one slot variable `b`;
/// the base is read after every written field. The update stands where
/// the literal does, where the checker filed the record's type.
fn as_update(
  fields: List<RecField>,
  stack: Stack,
  span: Span,
) -> Option<{ code: Code, stack: Stack }> / {abort.raise} = {
  // Two different copied-from variables make this a plain literal.
  let copies = fields.fold(
    { names: [], bad: false },
    |acc: { names: List<Bytes>, bad: Bool }, f: RecField|
      match copy_base(f, stack) {
        None -> acc,
        Some(n) -> if acc.names.len() == 0 { { names: [n], bad: acc.bad } }
        else if acc.names.at_or(0, b"") == n { acc }
        else { { names: acc.names, bad: true } },
      },
  );
  if copies.bad { None } else {
    // With no copied field, a record projected from inside a written field is the base whose cells are reused.
    let base = if copies.names.len() == 1 { copies.names.at(0) } else {
      fields.fold(None, |acc: Option<Bytes>, f: RecField|
        match acc {
          Some(_) -> acc,
          None -> if copy_base(f, stack) != None { None }
          else { projected_var(f.value, stack, []) },
        })
    };
    match base {
      None -> None,
      Some(name) -> {
        // Walked in field order, so each copy resolves the base, and each capture is numbered, where it stands.
        let walked = fields.fold(
          Some({ codes: [], stack: stack }),
          |acc: Option<Seq>, f: RecField|
            match acc {
              None -> None,
              Some(a) -> if copy_base(f, stack) == Some(name) {
                Some({ codes: a.codes, stack: resolve(a.stack, name).stack })
              } else {
                match lower_in(f.value, a.stack) {
                  None -> None,
                  Some(o) -> Some({ codes: a.codes.push(o.code), stack: o.stack }),
                }
              },
            },
        );
        match walked {
          None -> None,
          Some(o) -> match resolve(o.stack, name).slot {
            None -> None,
            Some(sl) -> {
              let copied = fields.fold([], |acc: List<Bytes>, f: RecField|
                match copy_base(f, stack) {
                  Some(n) -> if n == name { acc.push(f.name.name) } else { acc },
                  None -> acc,
                });
              let sets = fields.filter(|f: RecField| copy_base(f, stack) != Some(name));
              Some({
                code: {
                  span: span,
                  node: NUpdate({
                    // Read where the first copy reads it, so the base is typed as that read is.
                    base: {
                      span: fields.fold(dummy_span(), |at: Span, f: RecField|
                        match f.value {
                          EField(x) -> if at == dummy_span() && copy_base(f, stack) == Some(name) {
                            expr_span(x.base)
                          } else { at },
                          _ -> at,
                        }),
                      node: NVar({ name: name, slot: Some(sl) }),
                    },
                    copies: copied,
                    sets: range(0, sets.len()).map(|i: Int|
                      {
                        name: match sets.at(i) { Some(f) -> f.name.name, None -> b"" },
                        value: nth(o.codes, i),
                      }),
                  }),
                },
                stack: o.stack,
              })
            },
          },
        }
      },
    }
  }
}

/// The bare in-scope variable a field copies from, when the field is `b.<its own name>`.
fn copy_base(field: RecField, stack: Stack) -> Option<Bytes> =
  match field.value {
    EField(x) -> if x.field.name != field.name.name { None } else {
      match x.base {
        EVar(v) -> if v.name.module != None { None } else {
          match st_depth(stack, v.name.name.name) {
            Some(_) -> Some(v.name.name.name),
            None -> None,
          }
        },
        _ -> None,
      }
    },
    _ -> None,
  }

/// The first in-scope variable a field read projects from inside `e`; a name `e` binds itself is never the base.
fn projected_var(e: Expr, stack: Stack, inner: List<Bytes>) -> Option<Bytes> = {
  let first = |exprs: List<Expr>|
    exprs.fold(None, |acc: Option<Bytes>, x: Expr|
      match acc { Some(_) -> acc, None -> projected_var(x, stack, inner) });
  match e {
    EField(x) -> match x.base {
      EVar(v) -> if v.name.module == None && !inner.contains(v.name.name.name)
          && st_depth(stack, v.name.name.name) != None { Some(v.name.name.name) }
      else { projected_var(x.base, stack, inner) },
      _ -> projected_var(x.base, stack, inner),
    },
    EUnary(x) -> projected_var(x.operand, stack, inner),
    EBinary(x) -> first([x.lhs, x.rhs]),
    EApp(x) -> match projected_var(x.func, stack, inner) {
      Some(n) -> Some(n),
      None -> first(x.args),
    },
    EIf(x) -> first([x.cond, x.then_branch, x.else_branch]),
    EMatch(x) -> projected_var(x.scrutinee, stack, inner),
    EBlock(x) -> {
      let walked = x.stmts.fold(
        { found: None, inner: inner },
        |acc: { found: Option<Bytes>, inner: List<Bytes> }, stmt: Stmt|
          match acc.found {
            Some(_) -> acc,
            None -> match stmt {
              SLet(l) ->
                {
                  found: projected_var(l.value, stack, acc.inner),
                  inner: pat_binders(l.pat, acc.inner),
                },
              SLetElse(l) ->
                {
                  found: match projected_var(l.value, stack, acc.inner) {
                    Some(n) -> Some(n),
                    None -> projected_var(l.fallback, stack, acc.inner),
                  },
                  inner: pat_binders(l.pat, acc.inner),
                },
              SExpr(v) -> { found: projected_var(v, stack, acc.inner), inner: acc.inner },
              SAssign(v) -> { found: projected_var(v.value, stack, acc.inner), inner: acc.inner },
            },
          },
      );
      match walked.found {
        Some(n) -> Some(n),
        None -> match x.tail { Some(t) -> projected_var(t, stack, walked.inner), None -> None },
      }
    },
    ERecord(x) -> first(x.fields.map(|field: RecField| field.value)),
    ERecordUpdate(x) -> match projected_var(x.base, stack, inner) {
      Some(n) -> Some(n),
      None -> first(x.fields.map(|field: RecField| field.value)),
    },
    ETry(x) -> projected_var(x.operand, stack, inner),
    EList(x) -> first(x.items),
    EPerform(x) -> first(x.args),
    EHandle(x) -> projected_var(x.body, stack, inner),
    _ -> None,
  }
}

fn pat_binders(p: Pattern, out: List<Bytes>) -> List<Bytes> =
  match p {
    PVar(v) -> out.push(v.name.name),
    PCtor(c) -> c.args.fold(out, |acc: List<Bytes>, a: Pattern| pat_binders(a, acc)),
    PRecord(r) ->
      r.fields.fold(out, |acc: List<Bytes>, f: { name: Ident, pat: Pattern }|
        pat_binders(f.pat, acc)),
    PList(l) -> {
      let items = l.items.fold(out, |acc: List<Bytes>, a: Pattern| pat_binders(a, acc));
      match l.rest { Some(r) -> pat_binders(r, items), None -> items }
    },
    POr(o) -> o.alts.fold(out, |acc: List<Bytes>, a: Pattern| pat_binders(a, acc)),
    PWild(_) -> out,
    PLit(_) -> out,
    PRange(_) -> out,
    PBad(_) -> out,
  }

fn nth(codes: List<Code>, i: Int) -> Code =
  match codes.at(i) { Some(c) -> c, None -> { span: dummy_span(), node: NLit(LUnit) } }

type Seq = { codes: List<Code>, stack: Stack }

fn lower_seq(exprs: List<Expr>, stack: Stack) -> Option<Seq> / {abort.raise} =
  exprs.fold(Some({ codes: [], stack: stack }), |acc: Option<Seq>, expr: Expr|
    match acc {
      None -> None,
      Some(s) -> match lower_in(expr, s.stack) {
        Some(o) -> Some({ codes: s.codes.push(o.code), stack: o.stack }),
        None -> None,
      },
    })

/// A lambda over `params`: its body lowered behind a barrier, which the captures cross.
fn lower_lambda(
  params: List<Bytes>,
  body: Expr,
  stack: Stack,
  at: Span,
) -> Option<Lowered> / {abort.raise} = {
  let inner = params.fold(
    { names: [], scope: [], captures: [], capture_names: [] },
    |g: Frame, n: Bytes| bind(g, n),
  );
  match lower_in(body, st_push(stack, inner)) {
    None -> None,
    Some(b) -> Some(lam_of(params, b, at)),
  }
}

/// Pops the lambda's barrier; the stack below keeps the captures threaded into it.
fn lam_of(params: List<Bytes>, b: Lowered, at: Span) -> Lowered = {
  let inner = st_top(b.stack);
  {
    code: {
      span: dummy_span(),
      node: NLambda({
        params: params.len(),
        size: inner.names.len(),
        captures: inner.captures,
        body: b.code,
        at: at,
      }),
    },
    stack: st_pop(b.stack),
  }
}

type ClauseAcc = { clauses: List<CodeClause>, stack: Stack, ok: Bool }

type ArmAcc = { arms: List<CodeArm>, stack: Stack, ok: Bool }

type GuardOut = { code: Option<Code>, stack: Stack }

fn lower_guard(expr: Option<Expr>, stack: Stack) -> Option<GuardOut> / {abort.raise} =
  match expr {
    None -> Some({ code: None, stack: stack }),
    Some(e) -> match lower_in(e, stack) {
      None -> None,
      Some(o) -> Some({ code: Some(o.code), stack: o.stack }),
    },
  }

type BlockAcc = { stmts: List<CodeStmt>, stack: Stack, ok: Bool }

/// A `match` of the scrutinee lowered as `sc`, with the arms `arms` adds.
fn matched(
  span: Span,
  sc: Lowered,
  arms: (ArmAcc) -> ArmAcc / {abort.raise},
) -> Option<Lowered> / {abort.raise} = {
  let depth = depth_of(sc.stack);
  let walked = arms({ arms: [], stack: sc.stack, ok: true });
  if !walked.ok { None } else {
    Some({
      code: { span: span, node: NMatch({ scrutinee: sc.code, arms: walked.arms }) },
      stack: unscope_st(walked.stack, depth),
    })
  }
}

/// An arm per alternative of an or-pattern, each with the arm's guard and body: a guard is tried
/// again for every alternative that matches, in order.
fn arms_into(
  acc: ArmAcc,
  pat: Pattern,
  guard: Option<Expr>,
  body: (Stack) -> Option<Lowered> / {abort.raise},
) -> ArmAcc / {abort.raise} =
  List::fold(
    if has_or(pat) { alternatives_of(pat) } else { [pat] },
    acc,
    |a: ArmAcc, alt: Pattern| arm_into(a, alt, guard, body),
  )

/// Arm binders leave scope at the arm's end; their slots are not reused.
fn arm_into(
  acc: ArmAcc,
  alt: Pattern,
  guard: Option<Expr>,
  body: (Stack) -> Option<Lowered> / {abort.raise},
) -> ArmAcc / {abort.raise} =
  if !acc.ok { acc } else {
    let pd = depth_of(acc.stack);
    let pat = lower_pat(alt, acc.stack);
    match lower_guard(guard, pat.stack) {
      None -> { arms: acc.arms, stack: acc.stack, ok: false },
      Some(g) -> match body(g.stack) {
        None -> { arms: acc.arms, stack: acc.stack, ok: false },
        Some(b) ->
          {
            arms: acc.arms.push({ pat: pat.pat, guard: g.code, body: b.code }),
            stack: unscope_st(b.stack, pd),
            ok: true,
          },
      },
    }
  }

/// A statement whose pattern can fail, or whose alternatives bind in different places, is a `match`
/// over the rest of the block; `let ... else` adds its `else` as the arm for everything else.
fn lower_block(
  stmts: List<Stmt>,
  tail: Option<Expr>,
  stack: Stack,
) -> Option<Lowered> / {abort.raise} =
  lower_from(stmts, 0, { stmts: [], stack: stack, ok: true }, depth_of(stack), tail)

/// The statements from `from` on: each straight one lowered into `acc`, until one that branches ends
/// the block in its `match`, whose arm for the rest is a block of its own.
fn lower_from(
  stmts: List<Stmt>,
  from: Int,
  acc: BlockAcc,
  depth: Int,
  tail: Option<Expr>,
) -> Option<Lowered> / {abort.raise} =
  if !acc.ok { None }
  else if from >= stmts.len() { finished(acc, depth, lower_guard(tail, acc.stack)) } else {
    match stmts.at(from) {
      None -> None,
      Some(stmt) -> if branches(stmt) {
        finished(acc, depth, match lower_branch(stmt, stmts, from + 1, tail, acc.stack) {
          None -> None,
          Some(o) -> Some({ code: Some(o.code), stack: o.stack }),
        })
      } else { lower_from(stmts, from + 1, straight(acc, stmt), depth, tail) },
    }
  }

fn branches(stmt: Stmt) -> Bool =
  match stmt {
    SLetElse(_) -> true,
    SLet(l) -> has_or(l.pat),
    SExpr(_) -> false,
    SAssign(_) -> false,
  }

/// A branching statement's `match`, its first arm the statements from `next` on and the tail.
fn lower_branch(
  stmt: Stmt,
  stmts: List<Stmt>,
  next: Int,
  tail: Option<Expr>,
  stack: Stack,
) -> Option<Lowered> / {abort.raise} = {
  let rest = |st: Stack|
    lower_from(stmts, next, { stmts: [], stack: st, ok: true }, depth_of(st), tail);
  match stmt {
    SLetElse(l) -> match lower_in(l.value, stack) {
      None -> None,
      Some(sc) ->
        matched(l.span, sc, |start: ArmAcc|
          arms_into(
            arms_into(start, l.pat, None, rest),
            PWild({ span: l.span }),
            None,
            |st: Stack| lower_in(l.fallback, st),
          )),
    },
    // The checker refused a `let` whose or-pattern can fail, so its alternatives cover the value.
    SLet(l) -> match lower_in(l.value, stack) {
      None -> None,
      Some(sc) -> matched(l.span, sc, |start: ArmAcc| arms_into(start, l.pat, None, rest)),
    },
    SExpr(e) -> lower_in(e, stack),
    // Written out after checking, so none reaches here.
    SAssign(_) -> None,
  }
}

/// A statement that does not branch, lowered onto the block so far.
fn straight(acc: BlockAcc, stmt: Stmt) -> BlockAcc / {abort.raise} =
  if !acc.ok { acc } else {
    match stmt {
      SExpr(e) -> match lower_in(e, acc.stack) {
        Some(o) -> { stmts: acc.stmts.push(CDo({ code: o.code })), stack: o.stack, ok: true },
        None -> { stmts: acc.stmts, stack: acc.stack, ok: false },
      },
      // `lower_from` lowers it as a `match` instead.
      SLetElse(_) -> { stmts: acc.stmts, stack: acc.stack, ok: false },
      // Written out after checking, so none reaches here.
      SAssign(_) -> { stmts: acc.stmts, stack: acc.stack, ok: false },
      SLet(l) -> match binder_of(l.pat) {
        None -> match lower_in(l.value, acc.stack) {
          None -> { stmts: acc.stmts, stack: acc.stack, ok: false },
          Some(o) -> {
            let p = lower_pat(l.pat, o.stack);
            {
              stmts: acc.stmts.push(CLetPat({ span: l.span, pat: p.pat, value: o.code })),
              stack: p.stack,
              ok: true,
            }
          },
        },
        Some(name) -> match lower_in(l.value, acc.stack) {
          None -> { stmts: acc.stmts, stack: acc.stack, ok: false },
          Some(o) ->
            {
              stmts: acc.stmts.push(
                CLet({ name: name, slot: st_top(o.stack).names.len(), value: o.code }),
              ),
              stack: bind_st(o.stack, name),
              ok: true,
            },
        },
      },
    }
  }

/// The block of the statements lowered, ending in the tail `t` lowered after them, if it is.
fn finished(acc: BlockAcc, depth: Int, t: Option<GuardOut>) -> Option<Lowered> =
  match t {
    None -> None,
    Some(o) ->
      Some({
        code: { span: dummy_span(), node: NBlock({ stmts: acc.stmts, tail: o.code }) },
        stack: unscope_st(o.stack, depth),
      }),
  }

type PatOut = { pat: CodePattern, stack: Stack }

/// Binders take slots in walk order. A bare name may be a nullary constructor, so it takes a slot either way.
fn lower_pat(pattern: Pattern, stack: Stack) -> PatOut / {abort.raise} =
  match pattern {
    PWild(_) -> { pat: PxWild, stack: stack },
    PVar(v) -> {
      let name = v.name.name;
      let g = bind_st(stack, name);
      { pat: PxVar({ name: name, slot: slot_in(st_top(g), name), span: v.span }), stack: g }
    },
    PLit(v) -> { pat: PxLit(v.lit), stack: stack },
    PRange(v) -> { pat: PxRange({ lo: v.lo, hi: v.hi }), stack: stack },
    PCtor(c) -> {
      let r = lower_pats(c.args, stack);
      { pat: PxCtor({ name: qname_text(c.name), args: r.pats }), stack: r.stack }
    },
    PRecord(r) -> {
      let walked = r.fields.fold(
        { pats: [], stack: stack, names: [] },
        |acc: PatFields, fd: { name: Ident, pat: Pattern }| {
          let o = lower_pat(fd.pat, acc.stack);
          { pats: acc.pats.push(o.pat), stack: o.stack, names: acc.names.push(fd.name.name) }
        },
      );
      {
        pat: PxRecord({
          fields: range(0, walked.pats.len()).map(|i: Int|
            { name: walked.names.at_or(i, b""), pat: nth_pat(walked.pats, i) }),
          rest: r.rest,
        }),
        stack: walked.stack,
      }
    },
    PList(l) -> {
      let r = lower_pats(l.items, stack);
      match l.rest {
        None -> { pat: PxList({ items: r.pats, rest: None }), stack: r.stack },
        Some(rp) -> {
          let o = lower_pat(rp, r.stack);
          { pat: PxList({ items: r.pats, rest: Some(o.pat) }), stack: o.stack }
        },
      }
    },
    // A match's arms and `lower_block` are lowered an alternative at a time, so no or-pattern is left
    // for this to meet.
    POr(_) -> panic("an or-pattern reached the lowering unexpanded"),
    PBad(_) -> { pat: PxWild, stack: stack },
  }

fn lower_pats(patterns: List<Pattern>, stack: Stack) -> PatSeq / {abort.raise} =
  patterns.fold({ pats: [], stack: stack }, |acc: PatSeq, pattern: Pattern| {
    let o = lower_pat(pattern, acc.stack);
    { pats: acc.pats.push(o.pat), stack: o.stack }
  })

type PatFields = { pats: List<CodePattern>, stack: Stack, names: List<Bytes> }
type PatSeq = { pats: List<CodePattern>, stack: Stack }

fn nth_pat(xs: List<CodePattern>, i: Int) -> CodePattern =
  match xs.at(i) { Some(x) -> x, None -> PxWild }

/// The slots a pattern binds, each once.
pub fn pat_slots(p: CodePattern) -> List<Int> =
  match p {
    PxWild -> [],
    PxVar(v) -> match v.slot { Some(s) -> [s], None -> [] },
    PxLit(_) -> [],
    PxRange(_) -> [],
    PxCtor(c) -> c.args.fold([], |acc: List<Int>, a: CodePattern| slots_union(acc, pat_slots(a))),
    PxRecord(r) ->
      r.fields.fold([], |acc: List<Int>, f: CodePatternField| slots_union(acc, pat_slots(f.pat))),
    PxList(l) -> {
      let items = l.items.fold([], |acc: List<Int>, i: CodePattern| slots_union(acc, pat_slots(i)));
      match l.rest { Some(r) -> slots_union(items, pat_slots(r)), None -> items }
    },
  }

fn slots_union(a: List<Int>, b: List<Int>) -> List<Int> =
  b.fold(a, |acc: List<Int>, s: Int| if acc.contains(s) { acc } else { acc.push(s) })

/// Only a single-name binder; any other pattern lowers as `CLetPat`.
fn binder_of(pattern: Pattern) -> Option<Bytes> =
  match pattern { PVar(id) -> Some(id.name.name), _ -> None }

// --- reads ------------------------------------------------------------------

fn through_caps(reads: List<Int>, caps: List<Capture>) -> List<Int> =
  reads.fold([], |acc: List<Int>, s: Int|
    match caps.fold(None, |found: Option<Int>, capture: Capture|
        if capture.dst == s { Some(capture.src) } else { found }) {
      Some(src) -> acc.push(src),
      None -> acc,
    })

/// Every slot read, lambdas and clause bodies included: a name a barrier copies in is still a read.
pub fn slots_read(code: Code) -> List<Int> =
  match code.node {
    NVar(v) -> match v.slot { Some(s) -> [s], None -> [] },
    NLit(_) -> [],
    NUnary(u) -> slots_read(u.operand),
    NBinary(b) -> slots_read(b.lhs).concat(slots_read(b.rhs)),
    NField(f) -> slots_read(f.base),
    NApp(a) -> slots_read(a.func).concat(all_read(a.args)),
    NKnown(k) -> [k.slot],
    NIf(i) ->
      slots_read(i.cond).concat(slots_read(i.then_branch).concat(slots_read(i.else_branch))),
    NBlock(b) ->
      b.stmts.fold([], |acc: List<Int>, stmt: CodeStmt|
        acc.concat(match stmt {
          CLet(l) -> slots_read(l.value),
          CLetPat(l) -> slots_read(l.value),
          CDo(d) -> slots_read(d.code),
        })).concat(match b.tail { Some(t) -> slots_read(t), None -> [] }),
    NList(l) -> all_read(l.items),
    NRecord(r) -> fields_read(r.fields, []),
    NMatch(m) ->
      slots_read(m.scrutinee).concat(
        m.arms.fold([], |acc: List<Int>, a: CodeArm|
          acc.concat(
            List::concat(
              match a.guard { Some(g) -> slots_read(g), None -> [] },
              slots_read(a.body),
            ),
          )),
      ),
    NUpdate(u) -> fields_read(u.sets, slots_read(u.base)),
    NLabel(_) -> [],
    NPerform(p) ->
      List::concat(match p.label { Some(x) -> slots_read(x), None -> [] }, all_read(p.args)),
    // A capture read inside a lambda is a read of the object it copies; the lambda's own parameter is not a read here.
    NLambda(l) -> through_caps(slots_read(l.body), l.captures),
    NSimulate(x) -> x.captures.map(|c2: Capture| c2.src).concat(slots_read(x.body)),
    NParallel(pr) -> all_read(pr.branches),
    NHandle(h) ->
      slots_read(h.body).concat(
        h.clauses.fold([], |acc: List<Int>, clause: CodeClause|
          acc.concat(match clause.label { Some(x) -> slots_read(x), None -> [] }).concat(
            through_caps(slots_read(clause.body), clause.captures),
          )).concat(match h.ret {
          Some(r) -> through_caps(slots_read(r.body), r.captures),
          None -> [],
        }),
      ),
  }

pub fn all_read(codes: List<Code>) -> List<Int> =
  codes.fold([], |acc: List<Int>, code: Code| acc.concat(slots_read(code)))

fn fields_read(fs: List<CodeField>, before: List<Int>) -> List<Int> =
  fs.fold(before, |acc: List<Int>, field: CodeField| acc.concat(slots_read(field.value)))

// --- the module entry ------------------------------------------------------

// `L;n;`, then one record per lowered function; a function not lowered is skipped and counted.

pub type LowerOut = { dump: Bytes, lowered: Int, skipped: Int }

/// One function body, its slots resolved. `labels` are the hidden parameters a label-generic
/// definition takes after `params`. A call the checker wrote out through `own`, the binder of the
/// module's own functions of types, is the call by name it is: one in tail position is a loop as any
/// other of the module's is.
pub fn lower_fn(
  params: List<Bytes>,
  labels: List<Bytes>,
  sites: Map<Bytes, List<Bytes>>,
  body: Expr,
  own: Bytes = b"",
) -> Option<{ code: Code, size: Int }> / {abort.raise} = {
  let start = labels.fold(
    params.fold(
      { names: [], scope: [], captures: [], capture_names: [] },
      |frame: Frame, p: Bytes| bind(frame, p),
    ),
    |frame: Frame, l: Bytes| bind(frame, label_binder(l)),
  );
  match lower_in(body, {
      frames: [start],
      labels: labels,
      sites: sites,
      handled: false,
      own: own,
    }) {
    None -> None,
    Some(o) -> Some({ code: o.code, size: st_top(o.stack).names.len() }),
  }
}

pub fn lower_module(src: Bytes) -> LowerOut / {abort.raise} = {
  let r = parse(src);
  let x = expand(r.node, r.parser.diags);
  x.module.items.fold({ dump: b"L;1;", lowered: 0, skipped: 0 }, |acc: LowerOut, item: Item|
    match item {
      IFn(d) -> {
        let labels = d.generics.labels.map(|ident: Ident| ident.name);
        let names = d.params.map(|param: Param| param.name.name);
        match lower_fn(names, labels, Map::new(), d.body) {
          None -> { dump: acc.dump, lowered: acc.lowered, skipped: acc.skipped + 1 },
          Some(l) ->
            {
              dump: Bytes::concat_all([
                acc.dump,
                b"f:m.",
                d.name.name,
                b":",
                ascii_of_int(names.len() + labels.len()),
                b":",
                ascii_of_int(l.size),
                b";",
                dump(l.code),
                b";",
              ]),
              lowered: acc.lowered + 1,
              skipped: acc.skipped,
            },
        }
      },
      _ -> acc,
    })
}

pub fn lower_dump(src: Bytes) -> String / {abort.raise} = String::of_bytes(lower_module(src).dump)

/// A variable pattern is irrefutable: the parser makes every upper-case bare name in pattern position a constructor.
pub fn irrefutable(pattern: CodePattern) -> Bool =
  match pattern { PxWild -> true, PxVar(_) -> true, _ -> false }

test "a literal lowers to itself" {
  assert_eq(lower_dump(b"fn f() -> Int = 1\n"), "L;1;f:m.f:0:0;lit(i1);")
}

test "binary operands are lowered left to right" {
  assert_eq(lower_dump(b"fn f() -> Int = 1 + 2\n"), "L;1;f:m.f:0:0;bin(add,lit(i1),lit(i2));")
}

test "a name with no binder has no slot" {
  assert_eq(lower_dump(b"fn f() -> Int = g()\n"), "L;1;f:m.f:0:0;app(var(g,-));")
}

test "a `let` takes the next slot" {
  assert_eq(
    lower_dump(b"fn f(a: Int) -> Int = { let b = a + 1; b }\n"),
    "L;1;f:m.f:1:2;block(let(v:b:1,bin(add,var(a,0),lit(i1))),var(b,1));",
  )
}

test "a match binds its arms into the window and each arm's binders leave at its end" {
  assert_eq(
    lower_dump(b"fn f(o: Option<Int>) -> Int = match o { Some(n) -> n, None -> 0 }\n"),
    "L;1;f:m.f:1:2;match(var(o,0),arm(c:Some(v:n:1,),-,var(n,1)),arm(c:None(),-,lit(i0)));",
  )
}

test "a guard is lowered between its arm's pattern and body and reads the arm's binders" {
  assert_eq(
    lower_dump(b"fn f(n: Int) -> Int = match n { x if x > 0 -> x, _ -> n }\n"),
    "L;1;f:m.f:1:2;match(var(n,0),arm(v:x:1,bin(gt,var(x,1),lit(i0)),var(x,1)),arm(_,-,var(n,0)));",
  )
}

test "an or-pattern arm lowers to an arm per alternative, each binding its own slot" {
  assert_eq(
    lower_dump(b"fn f(p: (Int, Int)) -> Int = match p { (x, 0) | (0, x) -> x, _ -> 1 }\n"),
    "L;1;f:m.f:1:3;match(var(p,0),arm(r:(_0=v:x:1,_1=l:i0,),-,var(x,1)),arm(r:(_0=l:i0,_1=v:x:2,),-,var(x,2)),arm(_,-,lit(i1)));",
  )
}

test "a call's arguments are lowered in place, in order" {
  assert_eq(
    lower_dump(b"fn f(xs: Array<Int>) -> Array<Int> = Array::set(xs, 0, Array::len(xs))\n"),
    "L;1;f:m.f:1:1;app(var(Array::set,-),var(xs,0),lit(i0),app(var(Array::len,-),var(xs,0)));",
  )
}

test "a `let ... else` lowers to a match over the rest of its block" {
  assert_eq(
    lower_dump(b"fn f(o: Option<Int>) -> Int = { let Some(v) = o else { 0 }; v + 1 }\n"),
    "L;1;f:m.f:1:2;block(match(var(o,0),arm(c:Some(v:v:1,),-,block(bin(add,var(v,1),lit(i1)))),arm(_,-,block(lit(i0)))));",
  )
}
test "what the dump holds is what the count reports" {
  let out = lower_module(b"fn f() -> Int = 1\nfn g(a: Int) -> Int = a\nfn h() -> Int = 2\n");
  assert_eq(out.lowered, 3);
  assert_eq(out.skipped, 0);
  assert_eq(
    count_records(
      Bytes::of_string(
        lower_dump(b"fn f() -> Int = 1\nfn g(a: Int) -> Int = a\nfn h() -> Int = 2\n"),
      ),
    ),
    3,
  )
}

/// Counts records by their `f:m.` heads.
fn count_records(d: Bytes) -> Int =
  range(0, d.len() - 3).fold(0, |acc: Int, i: Int|
    if d.at(i) == 102 && d.at(i + 1) == 58 && d.at(i + 2) == 109 && d.at(i + 3) == 46 { acc + 1 }
    else { acc })
