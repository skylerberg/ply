import compiler.syntax.parsing (Span, dummy_span, synthetic_span, role_parallel_branch)
import compiler.syntax.patterns (SourceLiteral, LiteralInt, LiteralFixed, LiteralWide, LiteralBool,
                                 LiteralString, LiteralBytes, LiteralEmbedded, LiteralFloat,
                                 LiteralDecimal, LiteralChar, LiteralUnit, LiteralInvalid)
import compiler.syntax.expressions (simulate_closure_span)
import compiler.check.types (Type, VariableType, FunctionType, FunctionSignature, Effects, Effect,
                             no_effects, unit_type, int_type, string_type, function_type)
import compiler.check.typed (TypedExpression, pattern_binders, TypedLiteral, TypedRead, TypedUnary,
                             TypedBinary, TypedCall, TypedIf, TypedMatch, TypedBlock, TypedList,
                             TypedRecord, TypedUpdate, TypedFieldRead, TypedPerform, TypedLambda,
                             TypedSimulate, TypedParallel, TypedHandle, ReadLocal, ReadDefinition,
                             ReadConstructor, ReadBuiltin, FilledLabel, LabelNamed, LabelParam,
                             TypedParam, TypedThunk, TypedField, TypedArm, TypedPattern, TypedWild,
                             TypedBinder, TypedLiteralPattern, TypedRange, TypedCase,
                             TypedRecordPattern, TypedListPattern, TypedOr, TypedFieldPattern,
                             TypedStatement, TypedLet, TypedLetElse, TypedDo, TypedAssign,
                             TypedClause, TypedReturn, TypedHandlerVariable,
                             typed_expression_nodes_folded, NumericWitness, ConcreteWitness,
                             ParamWitness, StatedWitness, witness_param_name, TypedRelease,
                             NodeHolder, ReleaseAfter, ReleaseBefore, ReleaseUnwinding,
                             ReleaseMissing, ReleaseFailing, binding_key, holder_key)
import compiler.expand.rewrite (witness_code, declared_witness_name, numeric_operator_code)
import std.derive.children
import std.list
import std.bytes (hex_digit, ascii_of_int)
import std.string

pub type Code = { node: Node, span: Span, ty: Type }

derive children for Code

pub type Node =
  | CodeLiteral(SourceLiteral)
  | CodeVariable({ name: Bytes, slot: Int })
  | NDefinition({ full: Bytes, args: List<Type>, effect_arguments: List<Effects>, labels: List<FilledLabel> })
  | NConstructor({ sum: Bytes, name: Bytes, case: Int, args: List<Type> })
  | NBuiltin({ name: Bytes, args: List<Type>, effect_arguments: List<Effects> })
  | CodeUnary({ operation: Bytes, operand: Code })
  | CodeBinary({ operation: Bytes, left_operand: Code, right_operand: Code })
  | CodeApply({ function: Code, args: List<Code>, effects: Effects })
  | CodeIf({ cond: Code, then_branch: Code, else_branch: Code })
  | CodeBlock({ statements: List<CodeStatement>, tail: Option<Code> })
  | CodeList({ items: List<Code> })
  | CodeRecord({ fields: List<CodeField> })
  | CodeMatch({ scrutinee: Code, arms: List<CodeArm> })
  | CodePerform({ effect: Bytes, operation: Bytes, resource: Bytes, label: Option<Code>, entry: Effect, args: List<Code> })
  | CodeLabel(Bytes)
  | CodeLambda(Lambda)
  | CodeSimulate({ size: Int, captures: List<Capture>, body: Code, at: Span, effects: Effects })
  | CodeParallel({ branches: List<Code> })
  | CodeHandle(CodeHandler)
  | CodeFieldRead({ base: Code, field: Bytes })
  | CodeUpdate({ base: Code, copied_fields: List<Bytes>, sets: List<CodeField> })
  | CodeKnownLambda(KnownLambdaCall)

pub type KnownLambdaCall = {
  name: Bytes,
  slot: Int,
  lambda: Lambda,
  owner: Bytes,
  nth: Int,
  in_place: Bool,
}

pub type Lambda = {
  params: Int,
  size: Int,
  captures: List<Capture>,
  body: Code,
  at: Span,
  ty: FunctionSignature,
  effects: Effects,
}

pub type CodeField = { name: Bytes, value: Code }

pub type CodePattern =
  | CodeWildcardPattern
  | CodeBindingPattern({ name: Bytes, slot: Int, span: Span, ty: Type })
  | CodeLiteralPattern(SourceLiteral)
  | CodeRangePattern({ lo: SourceLiteral, hi: SourceLiteral })
  | CodeConstructorPattern({ sum: Bytes, name: Bytes, case: Int, args: List<CodePattern> })
  | CodeRecordPattern({ fields: List<CodePatternField>, rest: Bool })
  | CodeListPattern({ items: List<CodePattern>, rest: Option<CodePattern> })

pub type CodePatternField = { name: Bytes, pattern: CodePattern }

pub type CodeArm = { pattern: CodePattern, guard: Option<Code>, body: Code }

pub type Capture = { source: Int, destination: Int }

pub type CodeHandler = {
  body: Code,
  clauses: List<CodeClause>,
  return_clause: Option<CodeReturn>,
  effects: Effects,
}

pub type CodeClause = {
  effect: Bytes,
  operation: Bytes,
  resource: Bytes,
  label: Option<Code>,
  params: Int,
  binds_label: Bool,
  resume: Bool,
  size: Int,
  captures: List<Capture>,
  body: Code,
  at: Span,
  ty: FunctionSignature,
  effects: Effects,
  resumed: Effects,
}

pub type CodeReturn = {
  size: Int,
  captures: List<Capture>,
  body: Code,
  at: Span,
  ty: FunctionSignature,
  effects: Effects,
}

pub type CodeStatement =
  | CodeLet({ name: Bytes, slot: Int, value: Code })
  | CodeLetDestructure({ span: Span, pattern: CodePattern, value: Code })
  | CodeDo({ code: Code })

pub fn read_name(c: Code) -> Option<Bytes> =
  match c.node {
    NDefinition(d) -> Some(d.full),
    NConstructor(k) -> Some(k.name),
    NBuiltin(b) -> Some(b.name),
    _ -> None,
  }

fn resource_tag(name: Bytes, label: Option<Code>) -> Bytes =
  match label {
    None -> name,
    Some(c) -> match c.node { CodeVariable(v) -> b"$".concat(ascii_of_int(v.slot)), _ -> name },
  }

pub fn dump_literal(literal: SourceLiteral) -> Bytes / {abort.raise} =
  match literal {
    LiteralInt(n) -> b"i".concat(ascii_of_int(n)),
    LiteralFixed(name, bits) ->
      Bytes::concat_all([b"x", lower_bytes(name), b":", ascii_of_int(bits)]),
    LiteralWide(name, high, low) ->
      Bytes::concat_all([
        b"x",
        lower_bytes(name),
        b":",
        ascii_of_int(high),
        b":",
        ascii_of_int(low),
      ]),
    LiteralBool(b) -> if b { b"T" } else { b"F" },
    LiteralString(s) -> Bytes::concat_all([b"s", ascii_of_int(s.len()), b":", hex(s)]),
    LiteralBytes(s) -> Bytes::concat_all([b"y", ascii_of_int(s.len()), b":", hex(s)]),
    LiteralEmbedded(digest, size) ->
      Bytes::concat_all([b"e", ascii_of_int(size), b":", hex(digest)]),
    LiteralFloat(_) -> b"f",
    LiteralDecimal(r) -> Bytes::concat_all([b"d", ascii_of_int(r.len()), b":", hex(r)]),
    LiteralChar(v) -> b"c".concat(ascii_of_int(v)),
    LiteralUnit -> b"u",
    LiteralInvalid -> b"!",
  }

fn lower_bytes(s: Bytes) -> Bytes / {abort.raise} =
  Bytes::of_string(String::of_bytes(s).ascii_lower())

pub fn hex(s: Bytes) -> Bytes / {abort.raise} =
  range(0, s.len()).fold(b"", |accumulator: Bytes, i: Int| {
    let byte = s.at(i);
    Bytes::concat_all([accumulator, hex_digit(byte / 16), hex_digit(byte % 16)])
  })

fn dump_captures(captures: List<Capture>) -> Bytes =
  Bytes::concat_all([
    b"[",
    captures.fold(b"", |accumulator: Bytes, capture: Capture|
      Bytes::concat_all([
        accumulator,
        ascii_of_int(capture.source),
        b">",
        ascii_of_int(capture.destination),
        b" ",
      ])),
    b"]",
  ])

pub fn dump_pattern(p: CodePattern) -> Bytes / {abort.raise} =
  match p {
    CodeWildcardPattern -> b"_",
    CodeBindingPattern(v) -> Bytes::concat_all([b"v:", v.name, b":", ascii_of_int(v.slot)]),
    CodeLiteralPattern(l) -> b"l:".concat(dump_literal(l)),
    CodeRangePattern(r) ->
      Bytes::concat_all([b"g:", dump_literal(r.lo), b"..=", dump_literal(r.hi)]),
    CodeConstructorPattern(c) ->
      Bytes::concat_all([
        b"c:",
        c.name,
        b"(",
        c.args.fold(b"", |accumulator: Bytes, a: CodePattern|
          Bytes::concat_all([accumulator, dump_pattern(a), b","])),
        b")",
      ]),
    CodeRecordPattern(r) ->
      Bytes::concat_all([
        b"r:(",
        r.fields.fold(b"", |accumulator: Bytes, f: CodePatternField|
          Bytes::concat_all([accumulator, f.name, b"=", dump_pattern(f.pattern), b","])),
        if r.rest { b"..)" } else { b")" },
      ]),
    CodeListPattern(l) ->
      Bytes::concat_all([
        b"s:(",
        l.items.fold(b"", |accumulator: Bytes, i: CodePattern|
          Bytes::concat_all([accumulator, dump_pattern(i), b","])),
        match l.rest { Some(r) -> b"..".concat(dump_pattern(r)), None -> b"" },
        b")",
      ]),
  }

pub fn dump(code: Code) -> Bytes / {abort.raise} = dump_node(code.node)

fn dump_node(n: Node) -> Bytes / {abort.raise} =
  match n {
    CodeLiteral(l) -> Bytes::concat_all([b"lit(", dump_literal(l), b")"]),
    CodeVariable(v) -> Bytes::concat_all([b"var(", v.name, b",", ascii_of_int(v.slot), b")"]),
    NDefinition(d) -> Bytes::concat_all([b"def(", d.full, b")"]),
    NConstructor(c) -> Bytes::concat_all([b"ctor(", c.name, b")"]),
    NBuiltin(b) -> Bytes::concat_all([b"builtin(", b.name, b")"]),
    CodeUnary(u) -> Bytes::concat_all([b"un(", u.operation, b",", dump(u.operand), b")"]),
    CodeBinary(b) ->
      Bytes::concat_all([
        b"bin(",
        b.operation,
        b",",
        dump(b.left_operand),
        b",",
        dump(b.right_operand),
        b")",
      ]),
    CodeApply(a) ->
      Bytes::concat_all([
        b"app(",
        dump(a.function),
        a.args.fold(b"", |accumulator: Bytes, code: Code|
          Bytes::concat_all([accumulator, b",", dump(code)])),
        b")",
      ]),
    CodeKnownLambda(k) -> Bytes::concat_all([b"known(", k.owner, b",", k.name, b")"]),
    CodeIf(i) ->
      Bytes::concat_all([
        b"if(",
        dump(i.cond),
        b",",
        dump(i.then_branch),
        b",",
        dump(i.else_branch),
        b")",
      ]),
    CodeBlock(b) ->
      Bytes::concat_all([
        b"block(",
        b.statements.fold(b"", |accumulator: Bytes, statement: CodeStatement|
          accumulator.concat(match statement {
            CodeLet(l) ->
              Bytes::concat_all([
                b"let(v:",
                l.name,
                b":",
                ascii_of_int(l.slot),
                b",",
                dump(l.value),
                b"),",
              ]),
            CodeLetDestructure(l) ->
              Bytes::concat_all([b"let(", dump_pattern(l.pattern), b",", dump(l.value), b"),"]),
            CodeDo(d) -> Bytes::concat_all([b"do(", dump(d.code), b"),"]),
          })),
        match b.tail { Some(t) -> dump(t), None -> b"-" },
        b")",
      ]),
    CodeList(l) ->
      Bytes::concat_all([
        b"list(",
        l.items.fold(b"", |accumulator: Bytes, code: Code|
          Bytes::concat_all([accumulator, dump(code), b","])),
        b")",
      ]),
    CodeRecord(r) ->
      Bytes::concat_all([
        b"rec(",
        r.fields.fold(b"", |accumulator: Bytes, fd: CodeField|
          Bytes::concat_all([accumulator, fd.name, b"=", dump(fd.value), b","])),
        b")",
      ]),
    CodeMatch(m) ->
      Bytes::concat_all([
        b"match(",
        dump(m.scrutinee),
        m.arms.fold(b"", |accumulator: Bytes, a: CodeArm|
          Bytes::concat_all([
            accumulator,
            b",arm(",
            dump_pattern(a.pattern),
            b",",
            match a.guard { Some(g) -> dump(g), None -> b"-" },
            b",",
            dump(a.body),
            b")",
          ])),
        b")",
      ]),
    CodeLabel(n) -> Bytes::concat_all([b"label(", n, b")"]),
    CodePerform(p) ->
      Bytes::concat_all([
        b"perform(",
        p.effect,
        b",",
        p.operation,
        b",",
        resource_tag(p.resource, p.label),
        p.args.fold(b"", |accumulator: Bytes, a: Code|
          Bytes::concat_all([accumulator, b",", dump(a)])),
        b")",
      ]),
    CodeParallel(parallel_code) ->
      Bytes::concat_all([
        b"par(",
        parallel_code.branches.fold(b"", |accumulator: Bytes, code: Code|
          Bytes::concat_all([accumulator, dump(code), b","])),
        b")",
      ]),
    CodeSimulate(sm) ->
      Bytes::concat_all([
        b"sim(",
        ascii_of_int(sm.size),
        b",",
        dump_captures(sm.captures),
        b",",
        dump(sm.body),
        b")",
      ]),
    CodeHandle(h) ->
      Bytes::concat_all([
        b"handle(",
        dump(h.body),
        h.clauses.fold(b"", |accumulator: Bytes, c: CodeClause|
          Bytes::concat_all([
            accumulator,
            b",cl(",
            c.effect,
            b",",
            c.operation,
            b",",
            resource_tag(c.resource, c.label),
            b",",
            ascii_of_int(c.params),
            b",",
            if c.resume { b"true" } else { b"false" },
            b",",
            ascii_of_int(c.size),
            b",",
            dump_captures(c.captures),
            b",",
            dump(c.body),
            b")",
          ])),
        match h.return_clause {
          Some(r) ->
            Bytes::concat_all([
              b",ret(",
              ascii_of_int(r.size),
              b",",
              dump_captures(r.captures),
              b",",
              dump(r.body),
              b")",
            ]),
          None -> b",-",
        },
        b")",
      ]),
    CodeLambda(l) ->
      Bytes::concat_all([
        b"lam(",
        ascii_of_int(l.params),
        b",",
        ascii_of_int(l.size),
        b",",
        dump_captures(l.captures),
        b",",
        dump(l.body),
        b")",
      ]),
    CodeFieldRead(f) -> Bytes::concat_all([b"fld(", dump(f.base), b",", f.field, b")"]),
    CodeUpdate(u) ->
      Bytes::concat_all([
        b"upd(",
        dump(u.base),
        u.copied_fields.fold(b"", |accumulator: Bytes, n: Bytes|
          Bytes::concat_all([accumulator, b",c:", n])),
        u.sets.fold(b"", |accumulator: Bytes, f: CodeField|
          Bytes::concat_all([accumulator, b",s:", f.name, b"=", dump(f.value)])),
        b")",
      ]),
  }

type Bind = { name: Bytes, slot: Int }

type Frame = {
  names: List<Bytes>,
  scope: List<Bind>,
  captures: List<Capture>,
  capture_names: List<Bytes>,
}

fn bind(frame: Frame, name: Bytes) -> Frame =
  {
    names: frame.names.push(name),
    scope: frame.scope.push({ name: name, slot: frame.names.len() }),
    captures: frame.captures,
    capture_names: frame.capture_names,
  }

fn find(frame: Frame, name: Bytes) -> Option<Int> =
  frame.scope.fold(None, |accumulator: Option<Int>, b: Bind|
    if b.name == name { Some(b.slot) } else { accumulator })

type Stack = {
  frames: List<Frame>,
  labels: List<Bytes>,
  released: Map<Int, Bool>,
  binders: Map<Int, Binder>,
  rekey: Map<Bytes, Int>,
  handler_variables: List<HandlerVariable>,
  failure_reasons: List<Bytes>,
}

type HandlerVariable = { name: Bytes, at: Int, ty: Type, depth: Int }

type Binder = { name: Bytes, depth: Int, slot: Int, ty: Type }

fn released_in(body: TypedExpression<Type>) -> Map<Int, Bool> =
  typed_expression_nodes_folded(
    body,
    Map::new(),
    |accumulator: Map<Int, Bool>, e: TypedExpression<Type>|
      e.releases.fold(accumulator, |m: Map<Int, Bool>, r: TypedRelease|
        match r.place {
          ReleaseFailing(_) -> if r.holder == NodeHolder(e.span.site) { m }
          else { m.insert(holder_key(r.holder), true) },
          _ -> m.insert(holder_key(r.holder), true),
        }),
  )

fn top_frame(stack: Stack) -> Frame =
  match stack.frames.at(stack.frames.len() - 1) { Some(f) -> f, None -> empty_frame }

const empty_frame: Frame = { names: [], scope: [], captures: [], capture_names: [] }

fn frame_at(stack: Stack, i: Int) -> Frame =
  match stack.frames.at(i) { Some(f) -> f, None -> empty_frame }

fn with_frame_at(stack: Stack, i: Int, frame: Frame) -> Stack =
  {
    ..stack,
    frames: range(0, stack.frames.len()).map(|j: Int|
      if j == i { frame } else { frame_at(stack, j) }),
  }

fn with_top_frame(stack: Stack, frame: Frame) -> Stack =
  with_frame_at(stack, stack.frames.len() - 1, frame)

fn push_frame(stack: Stack, frame: Frame) -> Stack = { ..stack, frames: stack.frames.push(frame) }

fn pop_frame(stack: Stack) -> Stack =
  { ..stack, frames: range(0, stack.frames.len() - 1).map(|j: Int| frame_at(stack, j)) }

fn failing(stack: Stack, reason: Bytes) -> Stack =
  { ..stack, failure_reasons: stack.failure_reasons.push(reason) }

fn binding_depth(stack: Stack, name: Bytes) -> Option<Int> =
  range(0, stack.frames.len()).fold(None, |accumulator: Option<Int>, i: Int| {
    let f = frame_at(stack, i);
    match find(f, name) {
      Some(_) -> Some(i),
      None -> match find_capture(f, name) { Some(_) -> Some(i), None -> accumulator },
    }
  })

fn slot_in(f: Frame, name: Bytes) -> Option<Int> =
  match find(f, name) { Some(s) -> Some(s), None -> find_capture(f, name) }

type SlotLookup = { slot: Option<Int>, stack: Stack }

fn resolve(stack: Stack, name: Bytes) -> SlotLookup =
  match binding_depth(stack, name) {
    None -> { slot: None, stack: stack },
    Some(d) -> {
      let start = match slot_in(frame_at(stack, d), name) { Some(s) -> s, None -> 0 };
      range(d + 1, stack.frames.len()).fold(
        { slot: Some(start), stack: stack },
        |accumulator: SlotLookup, i: Int| {
          let f = frame_at(accumulator.stack, i);
          let from = match accumulator.slot { Some(s) -> s, None -> 0 };
          match find_capture(f, name) {
            Some(s) -> { slot: Some(s), stack: accumulator.stack },
            None -> {
              let g = capture(f, name, from);
              { slot: find_capture(g, name), stack: with_frame_at(accumulator.stack, i, g) }
            },
          }
        },
      )
    },
  }

fn read_local(stack: Stack, name: Bytes, ty: Type, span: Span) -> Lowered =
  match handler_variable(stack, name) {
    Some(h) -> { code: handler_variable_read(h, span), stack: stack },
    None -> {
      let r = resolve(stack, name);
      match r.slot {
        Some(s) ->
          {
            code: { node: CodeVariable({ name: name, slot: s }), span: span, ty: ty },
            stack: r.stack,
          },
        None ->
          {
            code: { node: CodeLiteral(LiteralUnit), span: span, ty: ty },
            stack: failing(r.stack, b"a read of a name that is not in scope: ".concat(name)),
          },
      }
    },
  }

fn label_binder(name: Bytes) -> Bytes = Bytes::concat_all([b"[", name, b"]"])

pub fn is_label_binder(name: Bytes) -> Bool = name.starts_with(b"[")

fn label_code(stack: Stack, name: Bytes) -> Option<Lowered> =
  if !stack.labels.contains(name) { None }
  else { Some(read_local(stack, label_binder(name), label_type, dummy_span)) }

const label_type: Type = int_type

pub fn with_labels<a>(declared: List<a>, labels: List<a>) -> List<a> = declared.concat(labels)

pub fn labels_among<a>(xs: List<a>, labels: Int) -> List<a> = xs.drop(xs.len() - labels)

fn label_args(stack: Stack, labels: List<FilledLabel>) -> LoweredSequence =
  labels.fold({ codes: [], stack: stack }, |accumulator: LoweredSequence, l: FilledLabel| {
    let named = match l {
      LabelNamed(n) -> Some(n),
      LabelParam(i) -> accumulator.stack.labels.at(i),
    };
    match named {
      None ->
        {
          codes: accumulator.codes.push({ node: CodeLabel(b""), span: dummy_span, ty: label_type }),
          stack: failing(
            accumulator.stack,
            b"a label refers to a parameter the body does not have",
          ),
        },
      Some(n) -> match label_code(accumulator.stack, n) {
        Some(o) -> { codes: accumulator.codes.push(o.code), stack: o.stack },
        None ->
          {
            codes: accumulator.codes.push({ node: CodeLabel(n), span: dummy_span, ty: label_type }),
            stack: accumulator.stack,
          },
      },
    }
  })

fn bind_in_stack(stack: Stack, name: Bytes) -> Stack =
  with_top_frame(stack, bind(top_frame(stack), name))

fn bind_at(stack: Stack, name: Bytes, site: Int, ty: Type) -> Stack =
  binder_noted(
    bind_in_stack(stack, name),
    name,
    site,
    stack.frames.len() - 1,
    top_frame(stack).names.len(),
    ty,
  )

fn binder_noted(stack: Stack, name: Bytes, site: Int, depth: Int, slot: Int, ty: Type) -> Stack =
  if !stack.released.contains(site) { stack } else {
    {
      ..stack,
      binders: stack.binders.insert(site, { name: name, depth: depth, slot: slot, ty: ty }),
    }
  }

fn truncate_scope(frame: Frame, to: Int) -> Frame =
  {
    names: frame.names,
    scope: take(frame.scope, to),
    captures: frame.captures,
    capture_names: frame.capture_names,
  }

fn unscope_stack(stack: Stack, to: Int) -> Stack =
  with_top_frame(stack, truncate_scope(top_frame(stack), to))

fn depth_of(stack: Stack) -> Int = top_frame(stack).scope.len()

fn find_capture(frame: Frame, name: Bytes) -> Option<Int> =
  range(0, frame.capture_names.len()).fold(None, |accumulator: Option<Int>, i: Int|
    if frame.capture_names.at_or(i, b"") == name {
      match frame.captures.at(i) { Some(c) -> Some(c.destination), None -> accumulator }
    } else { accumulator })

fn capture(frame: Frame, name: Bytes, source: Int) -> Frame =
  {
    names: frame.names.push(name),
    scope: frame.scope,
    captures: frame.captures.push({ source: source, destination: frame.names.len() }),
    capture_names: frame.capture_names.push(name),
  }

fn take(xs: List<Bind>, n: Int) -> List<Bind> =
  range(0, n).fold([], |accumulator: List<Bind>, i: Int|
    accumulator.push(xs.at_or(i, { name: b"", slot: 0 })))

type Lowered = { code: Code, stack: Stack }

type LoweredSequence = { codes: List<Code>, stack: Stack }

fn at(e: TypedExpression<Type>, node: Node) -> Code = { node: node, span: e.span, ty: e.ty }

fn lower_in(e: TypedExpression<Type>, stack: Stack) -> Lowered / {abort.raise} = {
  let o = lower_node(e, stack);
  if stack.released.len() == 0 { o } else { released_around(e, o) }
}

fn lower_seq(
  expressions: List<TypedExpression<Type>>,
  stack: Stack,
) -> LoweredSequence / {abort.raise} =
  expressions.fold({ codes: [], stack: stack }, |s: LoweredSequence, x: TypedExpression<Type>| {
    let o = lower_in(x, s.stack);
    { codes: s.codes.push(o.code), stack: o.stack }
  })

type Fields = { fields: List<CodeField>, stack: Stack }

fn lower_fields(fields: List<TypedField<Type>>, stack: Stack) -> Fields / {abort.raise} =
  fields.fold({ fields: [], stack: stack }, |accumulator: Fields, f: TypedField<Type>| {
    let o = lower_in(f.value, accumulator.stack);
    { fields: accumulator.fields.push({ name: f.name, value: o.code }), stack: o.stack }
  })

fn lower_node(e: TypedExpression<Type>, stack: Stack) -> Lowered / {abort.raise} =
  match e.node {
    TypedLiteral(l) -> { code: at(e, CodeLiteral(l)), stack: stack },
    TypedRead(r) -> match r {
      ReadLocal(name) -> read_local(stack, name, e.ty, e.span),
      ReadDefinition(d) ->
        {
          code: at(
            e,
            NDefinition({
              full: d.full,
              args: d.args,
              effect_arguments: d.effect_arguments,
              labels: d.labels,
            }),
          ),
          stack: stack,
        },
      ReadConstructor(c) ->
        {
          code: at(e, NConstructor({ sum: c.sum, name: c.name, case: c.case, args: c.args })),
          stack: stack,
        },
      ReadBuiltin(b) ->
        {
          code: at(
            e,
            NBuiltin({ name: b.name, args: b.args, effect_arguments: b.effect_arguments }),
          ),
          stack: stack,
        },
    },
    TypedUnary(u) -> {
      let o = lower_in(u.operand, stack);
      match open_witness(u.witness, u.operand.ty) {
        Some(p) -> {
          let w = read_local(o.stack, witness_param_name(p), int_type, e.span);
          {
            code: {
              ..internal_builtin_call(b"?numeric_unary", [int_code(if u.operation == b"bitnot" { 1 } else { 0 }), w.code, o.code], e.ty),
              span: e.span,
            },
            stack: w.stack,
          }
        },
        None ->
          { code: at(e, CodeUnary({ operation: u.operation, operand: o.code })), stack: o.stack },
      }
    },
    TypedBinary(b) -> {
      let l = lower_in(b.left_operand, stack);
      let r = lower_in(b.right_operand, l.stack);
      match open_witness(b.witness, b.left_operand.ty) {
        Some(p) -> {
          let w = read_local(r.stack, witness_param_name(p), int_type, e.span);
          {
            code: {
              ..internal_builtin_call(b"?numeric_binary", [int_code(numeric_operator_code(b.operation)), w.code, l.code, r.code], e.ty),
              span: e.span,
            },
            stack: w.stack,
          }
        },
        None ->
          {
            code: at(
              e,
              CodeBinary({ operation: b.operation, left_operand: l.code, right_operand: r.code }),
            ),
            stack: r.stack,
          },
      }
    },
    TypedIf(i) -> {
      let c = lower_in(i.cond, stack);
      let t = lower_in(i.then_branch, c.stack);
      let el = lower_in(i.else_branch, t.stack);
      {
        code: at(e, CodeIf({ cond: c.code, then_branch: t.code, else_branch: el.code })),
        stack: el.stack,
      }
    },
    TypedFieldRead(f) -> {
      let b = lower_in(f.base, stack);
      { code: at(e, CodeFieldRead({ base: b.code, field: f.field })), stack: b.stack }
    },
    TypedList(xs) -> {
      let r = lower_seq(xs, stack);
      { code: at(e, CodeList({ items: r.codes })), stack: r.stack }
    },
    TypedRecord(fs) -> match match as_path_update(fs, stack, e) {
        Some(u) -> Some(u),
        None -> as_update(fs, stack, e),
      } {
      Some(u) -> u,
      None -> {
        let r = lower_fields(fs, stack);
        { code: at(e, CodeRecord({ fields: r.fields })), stack: r.stack }
      },
    },
    TypedUpdate(u) -> updated(e, u.base, u.sets, u.copied_fields, stack),
    TypedCall(c) -> {
      let fu = lower_in(c.callee, stack);
      let ws = match c.callee.node {
        TypedRead(ReadDefinition(d)) -> witness_args(fu.stack, d.witnesses, c.callee.span),
        TypedRead(ReadBuiltin(b)) -> witness_args(fu.stack, b.witnesses, c.callee.span),
        _ -> { codes: [], stack: fu.stack },
      };
      let r = lower_seq(c.args, ws.stack);
      let ls = match c.callee.node {
        TypedRead(ReadDefinition(d)) -> label_args(r.stack, d.labels),
        _ -> { codes: [], stack: r.stack },
      };
      {
        code: at(
          e,
          CodeApply({
            function: fu.code,
            args: with_labels(ws.codes.concat(r.codes), ls.codes),
            effects: c.effects,
          }),
        ),
        stack: ls.stack,
      }
    },
    TypedMatch(m) ->
      matched(e.span, e.ty, lower_in(m.scrutinee, stack), |start: ArmAccumulator|
        m.arms.fold(start, |accumulator: ArmAccumulator, arm: TypedArm<Type>|
          arms_into(accumulator, alternatives(arm.pattern), arm.guard, |st: Stack|
            lower_in(arm.body, st)))),
    TypedPerform(p) -> {
      let r = lower_seq(p.args, stack);
      let name = match p.resource { Some(n) -> n, None -> b"" };
      let lb = label_code(r.stack, name);
      {
        code: at(
          e,
          CodePerform({
            effect: p.effect,
            operation: p.operation,
            resource: name,
            label: match lb { Some(o) -> Some(o.code), None -> None },
            entry: p.entry,
            args: r.codes,
          }),
        ),
        stack: match lb { Some(o) -> o.stack, None -> r.stack },
      }
    },
    TypedLambda(l) ->
      snapshotted(e, stack, |st: Stack| lower_lambda(l.params, l.body, l.effects, st, e.span)),
    TypedSimulate(t) ->
      snapshotted(e, stack, |st: Stack| {
        let b = lower_in(t.body, push_frame(st, empty_frame));
        let inner = top_frame(b.stack);
        {
          code: at(
            e,
            CodeSimulate({
              size: inner.names.len(),
              captures: inner.captures,
              body: b.code,
              at: simulate_closure_span(e.span),
              effects: t.effects,
            }),
          ),
          stack: pop_frame(b.stack),
        }
      }),
    TypedParallel(ts) ->
      snapshotted(e, stack, |st: Stack| {
        let r = ts.fold({ codes: [], stack: st }, |sq: LoweredSequence, t: TypedThunk<Type>| {
          let o = lower_lambda(
            [],
            t.body,
            t.effects,
            sq.stack,
            synthetic_span(t.body.span, role_parallel_branch),
          );
          { codes: sq.codes.push(o.code), stack: o.stack }
        });
        { code: at(e, CodeParallel({ branches: r.codes })), stack: r.stack }
      }),
    TypedHandle(h) ->
      snapshotted(e, stack, |st: Stack|
        handled(e, h.body, h.clauses, h.return_clause, h.variables, h.effects, st)),
    TypedBlock(b) ->
      lower_from(b.statements, 0, { statements: [], stack: stack }, depth_of(stack), b.tail, e.ty),
  }

fn updated(
  e: TypedExpression<Type>,
  base: TypedExpression<Type>,
  sets: List<TypedField<Type>>,
  copies: List<Bytes>,
  stack: Stack,
) -> Lowered / {abort.raise} = {
  let made = |read: (Stack) -> Lowered / {abort.raise}, st: Stack| {
    let r = lower_fields(sets, st);
    let b = read(r.stack);
    {
      code: at(e, CodeUpdate({ base: b.code, copied_fields: copies, sets: r.fields })),
      stack: b.stack,
    }
  };
  let local = match base.node {
    TypedRead(ReadLocal(n)) -> binding_depth(stack, n) != None,
    _ -> false,
  };
  if local { made(|st: Stack| lower_in(base, st), stack) } else {
    let o = lower_in(base, stack);
    let name = b"?u".concat(ascii_of_int(e.span.site));
    let slot = top_frame(o.stack).names.len();
    let depth = depth_of(o.stack);
    let inner = made(
      |st: Stack| read_local(st, name, base.ty, base.span),
      bind_in_stack(o.stack, name),
    );
    {
      code: at(
        e,
        CodeBlock({
          statements: [CodeLet({ name: name, slot: slot, value: o.code })],
          tail: Some(inner.code),
        }),
      ),
      stack: unscope_stack(inner.stack, depth),
    }
  }
}

type Projected = { name: Bytes, at: Span, ty: Type }

fn as_update(
  fields: List<TypedField<Type>>,
  stack: Stack,
  e: TypedExpression<Type>,
) -> Option<Lowered> / {abort.raise} = {
  let copies = fields.fold(
    { names: [], bad: false },
    |accumulator: { names: List<Bytes>, bad: Bool }, f: TypedField<Type>|
      match copy_base(f, stack) {
        None -> accumulator,
        Some(n) -> if accumulator.names.len() == 0 { { names: [n], bad: accumulator.bad } }
        else if accumulator.names.contains(n) { accumulator }
        else { { names: accumulator.names, bad: true } },
      },
  );
  if copies.bad { None } else {
    let base = match copies.names.at(0) {
      Some(n) ->
        fields.fold(None, |accumulator: Option<Projected>, f: TypedField<Type>|
          match accumulator {
            Some(_) -> accumulator,
            None -> if copy_base(f, stack) != Some(n) { None } else {
              match f.value.node {
                TypedFieldRead(x) -> Some({ name: n, at: x.base.span, ty: x.base.ty }),
                _ -> None,
              }
            },
          }),
      None ->
        fields.fold(None, |accumulator: Option<Projected>, f: TypedField<Type>|
          match accumulator {
            Some(_) -> accumulator,
            None -> if copy_base(f, stack) != None { None }
            else { projected_variable(f.value, stack, []) },
          }),
    };
    match base {
      None -> None,
      Some(read) -> {
        let copied = |f: TypedField<Type>| copy_base(f, stack) == Some(read.name);
        let o = fields.fold({ fields: [], stack: stack }, |a: Fields, f: TypedField<Type>|
          if copied(f) { { fields: a.fields, stack: resolve(a.stack, read.name).stack } } else {
            let v = lower_in(f.value, a.stack);
            { fields: a.fields.push({ name: f.name, value: v.code }), stack: v.stack }
          });
        match resolve(o.stack, read.name).slot {
          None -> None,
          Some(sl) ->
            Some({
              code: at(
                e,
                CodeUpdate({
                  base: {
                    node: CodeVariable({ name: read.name, slot: sl }),
                    span: read.at,
                    ty: read.ty,
                  },
                  copied_fields: fields.filter(copied).map(|f: TypedField<Type>| f.name),
                  sets: o.fields,
                }),
              ),
              stack: o.stack,
            }),
        }
      },
    }
  }
}

fn as_path_update(
  fields: List<TypedField<Type>>,
  stack: Stack,
  e: TypedExpression<Type>,
) -> Option<Lowered> / {abort.raise} = {
  let paths = fields.fold(
    { spelled: None, bad: false },
    |accumulator: { spelled: Option<Bytes>, bad: Bool }, f: TypedField<Type>|
      match copy_path(f, stack) {
        None -> accumulator,
        Some(c) -> match accumulator.spelled {
          None -> { ..accumulator, spelled: Some(c) },
          Some(s) -> if c == s { accumulator } else { { ..accumulator, bad: true } },
        },
      },
  );
  if paths.bad { None } else {
    match fields.fold(None, |accumulator: Option<TypedExpression<Type>>, f: TypedField<Type>|
        match accumulator {
          Some(_) -> accumulator,
          None -> if copy_path(f, stack) == None { None }
          else { match f.value.node { TypedFieldRead(x) -> Some(x.base), _ -> None } },
        }) {
      None -> None,
      Some(base) -> {
        let copied = |f: TypedField<Type>| copy_path(f, stack) != None;
        let r = lower_fields(fields.filter(|f: TypedField<Type>| !copied(f)), stack);
        let o = lower_in(base, r.stack);
        Some({
          code: at(
            e,
            CodeUpdate({
              base: o.code,
              copied_fields: fields.filter(copied).map(|f: TypedField<Type>| f.name),
              sets: r.fields,
            }),
          ),
          stack: o.stack,
        })
      },
    }
  }
}

fn copy_path(field: TypedField<Type>, stack: Stack) -> Option<Bytes> =
  match field.value.node {
    TypedFieldRead(x) -> if x.field != field.name || in_flight(field.value, stack) { None }
    else { match x.base.node { TypedFieldRead(_) -> path_spelled(x.base, stack), _ -> None } },
    _ -> None,
  }

fn path_spelled(e: TypedExpression<Type>, stack: Stack) -> Option<Bytes> =
  match e.node {
    TypedRead(ReadLocal(n)) -> match binding_depth(stack, n) { Some(_) -> Some(n), None -> None },
    TypedFieldRead(x) -> match path_spelled(x.base, stack) {
      Some(s) -> Some(Bytes::concat_all([s, b".", x.field])),
      None -> None,
    },
    _ -> None,
  }

fn in_flight(value: TypedExpression<Type>, stack: Stack) -> Bool =
  stack.released.contains(value.span.site)

fn copy_base(field: TypedField<Type>, stack: Stack) -> Option<Bytes> =
  match field.value.node {
    TypedFieldRead(x) -> if x.field != field.name || in_flight(field.value, stack) { None } else {
      match x.base.node {
        TypedRead(ReadLocal(n)) -> match binding_depth(stack, n) {
          Some(_) -> Some(n),
          None -> None,
        },
        _ -> None,
      }
    },
    _ -> None,
  }

fn projected_variable(
  e: TypedExpression<Type>,
  stack: Stack,
  inner: List<Bytes>,
) -> Option<Projected> = {
  let first = |expressions: List<TypedExpression<Type>>|
    expressions.fold(None, |accumulator: Option<Projected>, x: TypedExpression<Type>|
      match accumulator { Some(_) -> accumulator, None -> projected_variable(x, stack, inner) });
  match e.node {
    TypedFieldRead(x) -> match x.base.node {
      TypedRead(ReadLocal(n)) -> if !inner.contains(n) && binding_depth(stack, n) != None {
        Some({ name: n, at: x.base.span, ty: x.base.ty })
      } else { None },
      _ -> projected_variable(x.base, stack, inner),
    },
    TypedUnary(x) -> projected_variable(x.operand, stack, inner),
    TypedBinary(x) -> first([x.left_operand, x.right_operand]),
    TypedCall(x) -> match projected_variable(x.callee, stack, inner) {
      Some(n) -> Some(n),
      None -> first(x.args),
    },
    TypedIf(x) -> first([x.cond, x.then_branch, x.else_branch]),
    TypedMatch(x) -> projected_variable(x.scrutinee, stack, inner),
    TypedBlock(x) -> {
      let walked = x.statements.fold(
        { found: None, inner: inner },
        |accumulator: { found: Option<Projected>, inner: List<Bytes> }, statement: TypedStatement<Type>|
          match accumulator.found {
            Some(_) -> accumulator,
            None -> match statement {
              TypedLet(l) ->
                {
                  found: projected_variable(l.value, stack, accumulator.inner),
                  inner: accumulator.inner.concat(
                    pattern_binders(l.pattern).map(|b: TypedParam<Type>| b.name),
                  ),
                },
              TypedLetElse(l) ->
                {
                  found: match projected_variable(l.value, stack, accumulator.inner) {
                    Some(n) -> Some(n),
                    None -> projected_variable(l.fallback, stack, accumulator.inner),
                  },
                  inner: accumulator.inner.concat(
                    pattern_binders(l.pattern).map(|b: TypedParam<Type>| b.name),
                  ),
                },
              TypedDo(v) ->
                {
                  found: projected_variable(v, stack, accumulator.inner),
                  inner: accumulator.inner,
                },
              TypedAssign(v) ->
                {
                  found: projected_variable(v.value, stack, accumulator.inner),
                  inner: accumulator.inner,
                },
            },
          },
      );
      match walked.found {
        Some(n) -> Some(n),
        None -> match x.tail {
          Some(t) -> projected_variable(t, stack, walked.inner),
          None -> None,
        },
      }
    },
    TypedRecord(fs) -> first(fs.map(|f: TypedField<Type>| f.value)),
    TypedUpdate(x) -> match projected_variable(x.base, stack, inner) {
      Some(n) -> Some(n),
      None -> first(x.sets.map(|f: TypedField<Type>| f.value)),
    },
    TypedList(xs) -> first(xs),
    TypedPerform(x) -> first(x.args),
    TypedHandle(x) -> projected_variable(x.body, stack, inner),
    TypedLiteral(_) -> None,
    TypedRead(_) -> None,
    TypedLambda(_) -> None,
    TypedSimulate(_) -> None,
    TypedParallel(_) -> None,
  }
}

fn lower_lambda(
  params: List<TypedParam<Type>>,
  body: TypedExpression<Type>,
  effects: Effects,
  stack: Stack,
  at: Span,
) -> Lowered / {abort.raise} = {
  let inner = params.fold(empty_frame, |g: Frame, p: TypedParam<Type>| bind(g, p.name));
  let b = lower_in(
    body,
    record_param_binders(push_frame(stack, inner), params, stack.frames.len(), 0),
  );
  let f = top_frame(b.stack);
  let value = closure_type(params, body.ty);
  {
    code: {
      node: CodeLambda({
        params: params.len(),
        size: f.names.len(),
        captures: f.captures,
        body: b.code,
        at: at,
        ty: value,
        effects: effects,
      }),
      span: dummy_span,
      ty: FunctionType(value),
    },
    stack: pop_frame(b.stack),
  }
}

fn closure_type(params: List<TypedParam<Type>>, return_type: Type) -> FunctionSignature =
  {
    params: params.map(|p: TypedParam<Type>| p.ty),
    keep_parameters: [],
    once: false,
    return_type: return_type,
    effects: no_effects,
  }

fn record_param_binders(
  stack: Stack,
  params: List<TypedParam<Type>>,
  depth: Int,
  from: Int,
) -> Stack =
  params.fold(
    { stack: stack, slot: from },
    |accumulator: { stack: Stack, slot: Int }, p: TypedParam<Type>|
      {
        stack: binder_noted(
          accumulator.stack,
          p.name,
          binding_key(p.span.site),
          depth,
          accumulator.slot,
          p.ty,
        ),
        slot: accumulator.slot + 1,
      },
  ).stack

fn handled(
  e: TypedExpression<Type>,
  body: TypedExpression<Type>,
  clauses: List<TypedClause<Type>>,
  return_clause: Option<TypedReturn<Type>>,
  handler_variables: List<TypedHandlerVariable<Type>>,
  effects: Effects,
  stack: Stack,
) -> Lowered / {abort.raise} = {
  let depth = depth_of(stack);
  let made = handler_variables.fold(
    { statements: [], reads: [], stack: stack },
    |accumulator: { statements: List<CodeStatement>, reads: List<Code>, stack: Stack }, v: TypedHandlerVariable<Type>| {
      let o = lower_in(v.init, accumulator.stack);
      let slot = top_frame(o.stack).names.len();
      {
        statements: accumulator.statements.push(
          CodeLet({ name: v.name, slot: slot, value: o.code }),
        ),
        reads: accumulator.reads.push({
          node: CodeVariable({ name: v.name, slot: slot }),
          span: v.span,
          ty: v.ty,
        }),
        stack: bind_in_stack(o.stack, v.name),
      }
    },
  );
  let b = lower_in(body, unscope_stack(made.stack, depth));
  let installed = made.reads.fold([], |accumulator: List<CodeStatement>, r: Code|
    accumulator.push(
      CodeDo({
        code: internal_builtin_call(b"?handler_init", [int_code(accumulator.len()), r], unit_type),
      }),
    ));
  let started = if installed.len() == 0 { b.code } else {
    {
      node: CodeBlock({ statements: installed, tail: Some(b.code) }),
      span: b.code.span,
      ty: b.code.ty,
    }
  };
  let outer_held = b.stack.handler_variables;
  let with_handler_variables = |st: Stack|
    {
      ..st,
      handler_variables: handler_variables.fold(
        outer_held,
        |accumulator: List<HandlerVariable>, v: TypedHandlerVariable<Type>|
          accumulator.push({
            name: v.name,
            at: accumulator.len() - outer_held.len(),
            ty: v.ty,
            depth: st.frames.len() - 1,
          }),
      ),
    };
  let cls = clauses.fold(
    { clauses: [], stack: b.stack },
    |accumulator: { clauses: List<CodeClause>, stack: Stack }, c: TypedClause<Type>| {
      let named = c.params.map(|p: TypedParam<Type>| p.name);
      let with_label = match c.label { Some(t) -> named.push(t.name), None -> named };
      let names = match c.continuation { Some(k) -> with_label.push(k.name), None -> with_label };
      let resource_name = if c.every_label { b"*" }
      else { match c.resource { Some(n) -> n, None -> b"" } };
      let lb = label_code(accumulator.stack, resource_name);
      let outer = match lb { Some(o) -> o.stack, None -> accumulator.stack };
      let inner = outer.frames.len();
      let pushed = record_param_binders(
        push_frame(outer, names.fold(empty_frame, |g: Frame, n: Bytes| bind(g, n))),
        c.params,
        inner,
        0,
      );
      let entered = match c.continuation {
        Some(k) -> record_param_binders(pushed, [k], inner, names.len() - 1),
        None -> pushed,
      };
      let cb = lower_in(c.body, with_handler_variables(entered));
      let f = top_frame(cb.stack);
      {
        clauses: accumulator.clauses.push({
          effect: c.effect,
          operation: c.operation,
          resource: resource_name,
          label: match lb { Some(o) -> Some(o.code), None -> None },
          params: c.params.len(),
          binds_label: c.label != None,
          resume: c.continuation != None,
          size: f.names.len(),
          captures: f.captures,
          body: cb.code,
          at: c.span,
          ty: closure_type(
            c.params.concat(match c.label { Some(t) -> [t], None -> [] }).concat(
              match c.continuation { Some(k) -> [k], None -> [] },
            ),
            c.body.ty,
          ),
          effects: c.effects,
          resumed: c.continuation_effects,
        }),
        stack: { ..pop_frame(cb.stack), handler_variables: outer_held },
      }
    },
  );
  let returned = match return_clause {
    None -> { return_type: None, stack: cls.stack },
    Some(r) -> {
      let entered = record_param_binders(
        push_frame(cls.stack, bind(empty_frame, r.binder.name)),
        [r.binder],
        cls.stack.frames.len(),
        0,
      );
      let rb = lower_in(r.body, with_handler_variables(entered));
      let f = top_frame(rb.stack);
      {
        return_type: Some({
          size: f.names.len(),
          captures: f.captures,
          body: rb.code,
          at: r.span,
          ty: closure_type([r.binder], r.body.ty),
          effects: r.effects,
        }),
        stack: { ..pop_frame(rb.stack), handler_variables: outer_held },
      }
    },
  };
  let installed_handle = at(
    e,
    CodeHandle({
      body: started,
      clauses: cls.clauses,
      return_clause: returned.return_type,
      effects: effects,
    }),
  );
  {
    code: if made.statements.len() == 0 { installed_handle }
    else { at(e, CodeBlock({ statements: made.statements, tail: Some(installed_handle) })) },
    stack: returned.stack,
  }
}

fn handler_variable(stack: Stack, name: Bytes) -> Option<HandlerVariable> =
  match stack.handler_variables.fold(
      None,
      |accumulator: Option<HandlerVariable>, h: HandlerVariable|
        if h.name == name { Some(h) } else { accumulator },
    ) {
    None -> None,
    Some(h) -> if range(h.depth, stack.frames.len()).any(|i: Int|
        find(frame_at(stack, i), name) != None) { None }
    else { Some(h) },
  }

fn handler_variable_read(h: HandlerVariable, span: Span) -> Code =
  { ..internal_builtin_call(b"?handler_var", [int_code(h.at)], h.ty), span: span }

fn snapshotted(
  e: TypedExpression<Type>,
  stack: Stack,
  lower: (Stack) -> Lowered / {abort.raise},
) -> Lowered / {abort.raise} =
  if stack.handler_variables.len() == 0 { lower(stack) } else {
    let used = typed_expression_nodes_folded(
      e,
      [],
      |accumulator: List<HandlerVariable>, x: TypedExpression<Type>|
        match x.node {
          TypedRead(ReadLocal(n)) -> match handler_variable(stack, n) {
            Some(h) -> if accumulator.any(|y: HandlerVariable| y.name == n) { accumulator }
            else { accumulator.push(h) },
            None -> accumulator,
          },
          _ -> accumulator,
        },
    );
    if used.len() == 0 { lower(stack) } else {
      let depth = depth_of(stack);
      let bound = used.fold(
        { statements: [], stack: stack },
        |accumulator: BlockAccumulator, h: HandlerVariable|
          {
            statements: accumulator.statements.push(
              CodeLet({
                name: h.name,
                slot: top_frame(accumulator.stack).names.len(),
                value: handler_variable_read(h, e.span),
              }),
            ),
            stack: bind_in_stack(accumulator.stack, h.name),
          },
      );
      let o = lower(bound.stack);
      {
        code: at(e, CodeBlock({ statements: bound.statements, tail: Some(o.code) })),
        stack: unscope_stack(o.stack, depth),
      }
    }
  }

fn int_code(n: Int) -> Code = { node: CodeLiteral(LiteralInt(n)), span: dummy_span, ty: int_type }

fn open_witness(witness: Option<Bytes>, ty: Type) -> Option<Bytes> =
  match ty { VariableType(_) -> witness, _ -> None }

fn witness_args(stack: Stack, witnesses: List<NumericWitness>, at: Span) -> LoweredSequence =
  witnesses.fold({ codes: [], stack: stack }, |accumulator: LoweredSequence, w: NumericWitness|
    match w {
      ConcreteWitness(n) ->
        { ..accumulator, codes: accumulator.codes.push(int_code(witness_code(n))) },
      ParamWitness(p) -> {
        let o = read_local(accumulator.stack, witness_param_name(p), int_type, at);
        { codes: accumulator.codes.push(o.code), stack: o.stack }
      },
      StatedWitness(constructor) ->
        {
          ..accumulator,
          codes: accumulator.codes.push(
            internal_builtin_call(
              declared_witness_name,
              [
                {
                  node: CodeLiteral(LiteralString(constructor)),
                  span: dummy_span,
                  ty: string_type,
                },
              ],
              int_type,
            ),
          ),
        },
    })

fn internal_builtin_call(name: Bytes, args: List<Code>, ty: Type) -> Code =
  {
    node: CodeApply({
      function: {
        node: NBuiltin({ name: name, args: [], effect_arguments: [] }),
        span: dummy_span,
        ty: function_type(args.map(|a: Code| a.ty), ty, no_effects),
      },
      args: args,
      effects: no_effects,
    }),
    span: dummy_span,
    ty: ty,
  }

type ArmAccumulator = { arms: List<CodeArm>, stack: Stack }

type LoweredGuard = { code: Option<Code>, stack: Stack }

fn lower_guard(
  expression: Option<TypedExpression<Type>>,
  stack: Stack,
) -> LoweredGuard / {abort.raise} =
  match expression {
    None -> { code: None, stack: stack },
    Some(x) -> {
      let o = lower_in(x, stack);
      { code: Some(o.code), stack: o.stack }
    },
  }

type BlockAccumulator = { statements: List<CodeStatement>, stack: Stack }

fn matched(
  span: Span,
  ty: Type,
  scrutinee: Lowered,
  arms: (ArmAccumulator) -> ArmAccumulator / {abort.raise},
) -> Lowered / {abort.raise} = {
  let depth = depth_of(scrutinee.stack);
  let walked = arms({ arms: [], stack: scrutinee.stack });
  {
    code: { node: CodeMatch({ scrutinee: scrutinee.code, arms: walked.arms }), span: span, ty: ty },
    stack: unscope_stack(walked.stack, depth),
  }
}

fn arms_into(
  accumulator: ArmAccumulator,
  alts: List<CodePattern>,
  guard: Option<TypedExpression<Type>>,
  body: (Stack) -> Lowered / {abort.raise},
) -> ArmAccumulator / {abort.raise} = {
  let keys = match alts.at(0) {
    Some(p) ->
      code_binders(p).fold(
        Map::new(),
        |m: Map<Bytes, Int>, b: { name: Bytes, span: Span, slot: Int }|
          m.insert(b.name, binding_key(b.span.site)),
      ),
    None -> Map::new(),
  };
  alts.fold(accumulator, |a: ArmAccumulator, alt: CodePattern| {
    let pd = depth_of(a.stack);
    let pattern = slotted(alt, { ..a.stack, rekey: keys });
    let g = lower_guard(guard, { ..pattern.stack, rekey: Map::new() });
    let b = body(g.stack);
    {
      arms: a.arms.push({ pattern: pattern.pattern, guard: g.code, body: b.code }),
      stack: unscope_stack(b.stack, pd),
    }
  })
}

fn lower_from(
  statements: List<TypedStatement<Type>>,
  from: Int,
  accumulator: BlockAccumulator,
  depth: Int,
  tail: Option<TypedExpression<Type>>,
  ty: Type,
) -> Lowered / {abort.raise} = {
  let next = |a: BlockAccumulator| lower_from(statements, from + 1, a, depth, tail, ty);
  let rest = |st: Stack|
    lower_from(statements, from + 1, { statements: [], stack: st }, depth_of(st), tail, ty);
  let branched = |o: Lowered|
    finish_block(accumulator, depth, { code: Some(o.code), stack: o.stack }, ty);
  match statements.at(from) {
    None -> finish_block(accumulator, depth, lower_guard(tail, accumulator.stack), ty),
    Some(TypedLetElse(l)) ->
      branched(
        matched(l.span, ty, lower_in(l.value, accumulator.stack), |start: ArmAccumulator|
          arms_into(
            arms_into(start, alternatives(l.pattern), None, rest),
            [CodeWildcardPattern],
            None,
            |st: Stack| lower_in(l.fallback, st),
          )),
      ),
    Some(TypedLet(l)) -> match alternatives(l.pattern) {
      [CodeBindingPattern(v)] -> {
        let o = lower_in(l.value, accumulator.stack);
        next({
          statements: accumulator.statements.push(
            CodeLet({ name: v.name, slot: top_frame(o.stack).names.len(), value: o.code }),
          ),
          stack: bind_at(o.stack, v.name, binding_key(v.span.site), v.ty),
        })
      },
      [p] -> {
        let o = lower_in(l.value, accumulator.stack);
        let missed = l.value.releases.filter(|x: TypedRelease| x.place == ReleaseMissing);
        let unwound = release_slot_reads(o.stack, missed);
        let s = slotted(p, unwound.stack);
        next({
          statements: accumulator.statements.push(
            CodeLetDestructure({
              span: l.span,
              pattern: s.pattern,
              value: if unwound.codes.len() == 0 { o.code } else {
                internal_builtin_call(b"?let_missing", unwound.codes.push(o.code), o.code.ty)
              },
            }),
          ),
          stack: s.stack,
        })
      },
      alts ->
        branched(
          matched(l.span, ty, lower_in(l.value, accumulator.stack), |start: ArmAccumulator|
            arms_into(start, alts, None, rest)),
        ),
    },
    Some(TypedDo(x)) -> {
      let o = lower_in(x, accumulator.stack);
      next({ statements: accumulator.statements.push(CodeDo({ code: o.code })), stack: o.stack })
    },
    Some(TypedAssign(a)) -> {
      let o = lower_in(a.value, accumulator.stack);
      match handler_variable(o.stack, a.name) {
        Some(h) ->
          next({
            statements: accumulator.statements.push(
              CodeDo({
                code: {
                  ..internal_builtin_call(b"?handler_set", [int_code(h.at), o.code], unit_type),
                  span: a.span,
                },
              }),
            ),
            stack: o.stack,
          }),
        None ->
          next({
            ..accumulator,
            stack: failing(
              o.stack,
              Bytes::concat_all([
                b"an assignment to `",
                a.name,
                b"`, which is not a variable of any clause of the handler",
              ]),
            ),
          }),
      }
    },
  }
}

fn finish_block(accumulator: BlockAccumulator, depth: Int, t: LoweredGuard, ty: Type) -> Lowered =
  {
    code: {
      node: CodeBlock({ statements: accumulator.statements, tail: t.code }),
      span: dummy_span,
      ty: ty,
    },
    stack: unscope_stack(t.stack, depth),
  }

type LoweredPattern = { pattern: CodePattern, stack: Stack }

fn alternatives(p: TypedPattern<Type>) -> List<CodePattern> =
  match p {
    TypedWild(_) -> [CodeWildcardPattern],
    TypedBinder(v) -> [CodeBindingPattern({ name: v.name, slot: 0, span: v.span, ty: v.ty })],
    TypedLiteralPattern(l) -> [CodeLiteralPattern(l)],
    TypedRange(r) -> [CodeRangePattern({ lo: r.lo, hi: r.hi })],
    TypedCase(c) ->
      choices(c.args.map(alternatives)).map(|args: List<CodePattern>|
        CodeConstructorPattern({ sum: c.sum, name: c.name, case: c.case, args: args })),
    TypedRecordPattern(r) ->
      choices(
        r.fields.map(|f: TypedFieldPattern<Type>|
          alternatives(f.pattern).map(|q: CodePattern| { name: f.name, pattern: q })),
      ).map(|fs: List<CodePatternField>| CodeRecordPattern({ fields: fs, rest: r.rest })),
    TypedListPattern(l) -> {
      let rests: List<Option<CodePattern>> = match l.rest {
        Some(x) -> alternatives(x).map(Some),
        None -> [None],
      };
      choices(l.items.map(alternatives)).fold(
        [],
        |accumulator: List<CodePattern>, items: List<CodePattern>|
          accumulator.concat(
            rests.map(|r: Option<CodePattern>| CodeListPattern({ items: items, rest: r })),
          ),
      )
    },
    TypedOr(alts) ->
      alts.fold([], |accumulator: List<CodePattern>, a: TypedPattern<Type>|
        accumulator.concat(alternatives(a))),
  }

fn choices<a>(xss: List<List<a>>) -> List<List<a>> =
  xss.fold([[]], |accumulator: List<List<a>>, xs: List<a>|
    accumulator.fold([], |out: List<List<a>>, prefix: List<a>|
      out.concat(xs.map(|x: a| prefix.push(x)))))

fn slotted(p: CodePattern, stack: Stack) -> LoweredPattern =
  match p {
    CodeBindingPattern(v) -> {
      let key = match stack.rekey.get(v.name) { Some(k) -> k, None -> binding_key(v.span.site) };
      {
        pattern: CodeBindingPattern({ ..v, slot: top_frame(stack).names.len() }),
        stack: bind_at(stack, v.name, key, v.ty),
      }
    },
    CodeConstructorPattern(c) -> {
      let r = assign_pattern_slots(c.args, stack);
      { pattern: CodeConstructorPattern({ ..c, args: r.pats }), stack: r.stack }
    },
    CodeRecordPattern(r) -> {
      let walked = r.fields.fold(
        { fields: [], stack: stack },
        |accumulator: { fields: List<CodePatternField>, stack: Stack }, f: CodePatternField| {
          let o = slotted(f.pattern, accumulator.stack);
          { fields: accumulator.fields.push({ name: f.name, pattern: o.pattern }), stack: o.stack }
        },
      );
      { pattern: CodeRecordPattern({ fields: walked.fields, rest: r.rest }), stack: walked.stack }
    },
    CodeListPattern(l) -> {
      let r = assign_pattern_slots(l.items, stack);
      match l.rest {
        None -> { pattern: CodeListPattern({ items: r.pats, rest: None }), stack: r.stack },
        Some(rp) -> {
          let o = slotted(rp, r.stack);
          { pattern: CodeListPattern({ items: r.pats, rest: Some(o.pattern) }), stack: o.stack }
        },
      }
    },
    CodeWildcardPattern -> { pattern: p, stack: stack },
    CodeLiteralPattern(_) -> { pattern: p, stack: stack },
    CodeRangePattern(_) -> { pattern: p, stack: stack },
  }

type PatternSeq = { pats: List<CodePattern>, stack: Stack }

fn assign_pattern_slots(patterns: List<CodePattern>, stack: Stack) -> PatternSeq =
  patterns.fold({ pats: [], stack: stack }, |accumulator: PatternSeq, p: CodePattern| {
    let o = slotted(p, accumulator.stack);
    { pats: accumulator.pats.push(o.pattern), stack: o.stack }
  })

fn code_binders(p: CodePattern) -> List<{ name: Bytes, span: Span, slot: Int }> =
  match p {
    CodeBindingPattern(v) -> [{ name: v.name, span: v.span, slot: v.slot }],
    CodeConstructorPattern(c) -> code_binders_all(c.args),
    CodeRecordPattern(r) -> code_binders_all(r.fields.map(|f: CodePatternField| f.pattern)),
    CodeListPattern(l) ->
      code_binders_all(match l.rest { Some(r) -> l.items.push(r), None -> l.items }),
    CodeWildcardPattern -> [],
    CodeLiteralPattern(_) -> [],
    CodeRangePattern(_) -> [],
  }

fn code_binders_all(ps: List<CodePattern>) -> List<{ name: Bytes, span: Span, slot: Int }> =
  ps.fold([], |accumulator: List<{ name: Bytes, span: Span, slot: Int }>, p: CodePattern|
    accumulator.concat(code_binders(p)))

pub fn pattern_slots(p: CodePattern) -> List<Int> =
  code_binders(p).fold([], |accumulator: List<Int>, b: { name: Bytes, span: Span, slot: Int }|
    if accumulator.contains(b.slot) { accumulator } else { accumulator.push(b.slot) })

pub fn irrefutable(pattern: CodePattern) -> Bool =
  match pattern { CodeWildcardPattern -> true, CodeBindingPattern(_) -> true, _ -> false }

fn released_around(e: TypedExpression<Type>, o: Lowered) -> Lowered = {
  let span = e.span;
  let here = e.releases;
  let unwinding = here.filter(|x: TypedRelease| x.place == ReleaseUnwinding);
  let after = here.filter(|x: TypedRelease| x.place == ReleaseAfter);
  let before = here.filter(|x: TypedRelease| x.place == ReleaseBefore);
  let unwound = release_slot_reads(o.stack, unwinding);
  let guarded = if unwinding.len() == 0 { { code: o.code, stack: unwound.stack } } else {
    {
      code: internal_builtin_call(b"?unwinds", unwound.codes.push(o.code), o.code.ty),
      stack: unwound.stack,
    }
  };
  let ty = guarded.code.ty;
  let ended = if after.len() == 0 { guarded } else {
    let s = guarded.stack;
    let slot = top_frame(s).names.len();
    let depth = depth_of(s);
    let named = bind_in_stack(s, b"?released");
    let bound = {
      ..named,
      binders: named.binders.insert(span.site, {
        name: b"?released",
        depth: s.frames.len() - 1,
        slot: slot,
        ty: ty,
      }),
    };
    let lets = release_calls(bound, after, here);
    {
      code: value_after_calls(b"?released", slot, guarded.code, lets.codes),
      stack: unscope_stack(lets.stack, depth),
    }
  };
  let first = release_calls(ended.stack, before, here);
  let made = preceded(first.codes, ended.code);
  let s = first.stack;
  if !s.released.contains(span.site) { { code: made, stack: s } } else {
    let slot = top_frame(s).names.len();
    {
      code: value_after_calls(b"?held", slot, made, []),
      stack: binder_noted(
        unscope_stack(bind_in_stack(s, b"?held"), depth_of(s)),
        b"?held",
        span.site,
        s.frames.len() - 1,
        slot,
        ty,
      ),
    }
  }
}

fn value_after_calls(name: Bytes, slot: Int, value: Code, calls: List<Code>) -> Code =
  {
    node: CodeBlock({
      statements: [CodeLet({ name: name, slot: slot, value: value })].concat(
        calls.map(|c: Code| CodeDo({ code: c })),
      ),
      tail: Some({
        node: CodeVariable({ name: name, slot: slot }),
        span: dummy_span,
        ty: value.ty,
      }),
    }),
    span: dummy_span,
    ty: value.ty,
  }

fn preceded(calls: List<Code>, code: Code) -> Code =
  if calls.len() == 0 { code } else {
    {
      node: CodeBlock({ statements: calls.map(|x: Code| CodeDo({ code: x })), tail: Some(code) }),
      span: dummy_span,
      ty: code.ty,
    }
  }

fn release_calls(s: Stack, rs: List<TypedRelease>, here: List<TypedRelease>) -> LoweredSequence =
  rs.fold({ codes: [], stack: s }, |accumulator: LoweredSequence, r: TypedRelease| {
    let own = release_slot_reads(accumulator.stack, [r]);
    match own.codes.at(0) {
      None -> { ..accumulator, stack: own.stack },
      Some(x) -> {
        let failing = release_slot_reads(
          own.stack,
          here.filter(|y: TypedRelease| y.place == ReleaseFailing(r.holder)),
        );
        let call = internal_builtin_call(b"?let_go", [x], unit_type);
        {
          codes: accumulator.codes.push(if failing.codes.len() == 0 { call }
          else { internal_builtin_call(b"?unwinds", failing.codes.push(call), unit_type) }),
          stack: failing.stack,
        }
      },
    }
  })

fn release_slot_reads(s: Stack, rs: List<TypedRelease>) -> LoweredSequence =
  rs.fold({ codes: [], stack: s }, |accumulator: LoweredSequence, r: TypedRelease|
    match accumulator.stack.binders.get(holder_key(r.holder)) {
      Some(b) -> {
        let top = accumulator.stack.frames.len() - 1;
        if b.depth == top {
          {
            ..accumulator,
            codes: accumulator.codes.push({
              node: CodeVariable({ name: b.name, slot: b.slot }),
              span: dummy_span,
              ty: b.ty,
            }),
          }
        } else if b.depth < top
            && range(b.depth + 1, top + 1).all(|i: Int|
              find(frame_at(accumulator.stack, i), b.name) == None) {
          let l = read_local(accumulator.stack, b.name, b.ty, dummy_span);
          { codes: accumulator.codes.push(l.code), stack: l.stack }
        } else { accumulator }
      },
      None -> accumulator,
    })

fn through_caps(reads: List<Int>, caps: List<Capture>) -> List<Int> =
  reads.fold([], |accumulator: List<Int>, s: Int|
    match caps.fold(None, |found: Option<Int>, capture: Capture|
        if capture.destination == s { Some(capture.source) } else { found }) {
      Some(source) -> accumulator.push(source),
      None -> accumulator,
    })

pub fn slots_read(code: Code) -> List<Int> =
  match code.node {
    CodeVariable(v) -> [v.slot],
    CodeLiteral(_) -> [],
    NDefinition(_) -> [],
    NConstructor(_) -> [],
    NBuiltin(_) -> [],
    CodeUnary(u) -> slots_read(u.operand),
    CodeBinary(b) -> slots_read(b.left_operand).concat(slots_read(b.right_operand)),
    CodeFieldRead(f) -> slots_read(f.base),
    CodeApply(a) -> slots_read(a.function).concat(all_read(a.args)),
    CodeKnownLambda(k) -> [k.slot],
    CodeIf(i) ->
      slots_read(i.cond).concat(slots_read(i.then_branch).concat(slots_read(i.else_branch))),
    CodeBlock(b) ->
      b.statements.fold([], |accumulator: List<Int>, statement: CodeStatement|
        accumulator.concat(match statement {
          CodeLet(l) -> slots_read(l.value),
          CodeLetDestructure(l) -> slots_read(l.value),
          CodeDo(d) -> slots_read(d.code),
        })).concat(match b.tail { Some(t) -> slots_read(t), None -> [] }),
    CodeList(l) -> all_read(l.items),
    CodeRecord(r) -> field_slots_read(r.fields, []),
    CodeMatch(m) ->
      slots_read(m.scrutinee).concat(
        m.arms.fold([], |accumulator: List<Int>, a: CodeArm|
          accumulator.concat(
            List::concat(
              match a.guard { Some(g) -> slots_read(g), None -> [] },
              slots_read(a.body),
            ),
          )),
      ),
    CodeUpdate(u) -> field_slots_read(u.sets, slots_read(u.base)),
    CodeLabel(_) -> [],
    CodePerform(p) ->
      List::concat(match p.label { Some(x) -> slots_read(x), None -> [] }, all_read(p.args)),
    CodeLambda(l) -> through_caps(slots_read(l.body), l.captures),
    CodeSimulate(x) -> x.captures.map(|c2: Capture| c2.source).concat(slots_read(x.body)),
    CodeParallel(parallel_code) -> all_read(parallel_code.branches),
    CodeHandle(h) ->
      slots_read(h.body).concat(
        h.clauses.fold([], |accumulator: List<Int>, clause: CodeClause|
          accumulator.concat(match clause.label { Some(x) -> slots_read(x), None -> [] }).concat(
            through_caps(slots_read(clause.body), clause.captures),
          )).concat(match h.return_clause {
          Some(r) -> through_caps(slots_read(r.body), r.captures),
          None -> [],
        }),
      ),
  }

pub fn all_read(codes: List<Code>) -> List<Int> =
  codes.fold([], |accumulator: List<Int>, code: Code| accumulator.concat(slots_read(code)))

fn field_slots_read(fs: List<CodeField>, before: List<Int>) -> List<Int> =
  fs.fold(before, |accumulator: List<Int>, field: CodeField|
    accumulator.concat(slots_read(field.value)))

pub type LoweredBody = { code: Code, size: Int, failed: List<Bytes> }

pub fn lower_function(
  params: List<TypedParam<Type>>,
  labels: List<Bytes>,
  body: TypedExpression<Type>,
) -> LoweredBody / {abort.raise} = {
  let start = with_labels(params.map(|p: TypedParam<Type>| p.name), labels.map(label_binder)).fold(
    empty_frame,
    |frame: Frame, name: Bytes| bind(frame, name),
  );
  let stack = record_param_binders(
    {
      frames: [start],
      labels: labels,
      released: released_in(body),
      binders: Map::new(),
      rekey: Map::new(),
      handler_variables: [],
      failure_reasons: [],
    },
    params,
    0,
    0,
  );
  let o = lower_in(body, stack);
  { code: o.code, size: top_frame(o.stack).names.len(), failed: o.stack.failure_reasons }
}
