//! The lowered form the code generator reads: a typed body with its slots resolved.

import compiler.syntax.parsing (Span, dummy_span, minted, role_branch)
import compiler.syntax.patterns (Lit, LInt, LFixed, LWide, LBool, LStr, LBytes, LEmbedded, LFloat,
                                 LDec, LChar, LUnit, LBad)
import compiler.syntax.exprs (simulated_at)
import compiler.check.types (Type, TyVar, TyFn, FunctionType, Row, Atom, row_empty, unit_type,
                             int_type, string_type, fn_type)
import compiler.check.typed (TypedExpr, TypedLit, TypedRead, TypedUnary, TypedBinary, TypedCall,
                             TypedIf, TypedMatch, TypedBlock, TypedList, TypedRecord, TypedUpdate,
                             TypedFieldRead, TypedPerform, TypedLambda, TypedSimulate,
                             TypedParallel, TypedHandle, ReadLocal, ReadDefinition, ReadConstructor,
                             ReadBuiltin, FilledLabel, LabelNamed, LabelParam, TypedParam,
                             TypedThunk, TypedField, TypedArm, TypedPattern, TypedWild, TypedBinder,
                             TypedLitPattern, TypedRange, TypedCase, TypedRecordPattern,
                             TypedListPattern, TypedOr, TypedFieldPattern, TypedStmt, TypedLet,
                             TypedLetElse, TypedDo, TypedAssign, TypedClause, TypedReturn,
                             TypedHandlerVar, typed_nodes, NumericWitness, ConcreteWitness,
                             ParamWitness, StatedWitness, witness_param)
import compiler.expand.rewrite (witness_code, stated_witness_name, numeric_op_code)
import compiler.check.infer.checker (ReleaseSite, ReleaseAfter, ReleaseBefore, ReleaseUnwinding,
                                     ReleaseFailing, binder_key)
import std.list
import std.bytes (hex_digit, ascii_of_int)
import std.string

/// One lowered node: what it is, where its text stands, and its type.
pub type Code = { node: Node, span: Span, ty: Type }

pub type Node =
  | NLit(Lit)
  /// A read of the local the slot `slot` holds.
  | NVar({ name: Bytes, slot: Int })
  /// A read of the definition `full`, at the type arguments, rows and labels it fills, each in its
  /// scheme's order.
  | NDef({ full: Bytes, args: List<Type>, rows: List<Row>, labels: List<FilledLabel> })
  /// A read of a constructor of a declared sum, at the type arguments it fills.
  | NCtor({ sum: Bytes, name: Bytes, case: Int, args: List<Type> })
  /// A read of a builtin, at the type arguments and rows it fills; one this lowering writes has a
  /// name no source can spell.
  | NBuiltin({ name: Bytes, args: List<Type>, rows: List<Row> })
  | NUnary({ op: Bytes, operand: Code })
  | NBinary({ op: Bytes, lhs: Code, rhs: Code })
  /// `row` is what a call of a function value performs, as the type it calls through says.
  | NApp({ func: Code, args: List<Code>, row: Row })
  | NIf({ cond: Code, then_branch: Code, else_branch: Code })
  | NBlock({ stmts: List<CodeStmt>, tail: Option<Code> })
  | NList({ items: List<Code> })
  | NRecord({ fields: List<CodeField> })
  | NMatch({ scrutinee: Code, arms: List<CodeArm> })
  /// `label` is the read of the label parameter the resource names, when a binder holds it, and
  /// `atom` what the perform performs.
  | NPerform({ effect: Bytes, op: Bytes, resource: Bytes, label: Option<Code>, atom: Atom, args: List<Code> })
  /// One label argument of a call: the field-table entry of a resource named here.
  | NLabel(Bytes)
  | NLambda(Lambda)
  /// `at` names the closure the body runs in, and `row` is what the body performs.
  | NSimulate({ size: Int, captures: List<Capture>, body: Code, at: Span, row: Row })
  /// Each branch a nullary `NLambda`, which the run calls on whichever thread it chooses.
  | NParallel({ branches: List<Code> })
  | NHandle(CodeHandle)
  | NField({ base: Code, field: Bytes })
  /// `{..b, f: e}`: the base's other fields `copies`, the written ones `sets`.
  | NUpdate({ base: Code, copies: List<Bytes>, sets: List<CodeField> })
  | NKnown(KnownRead)

/// A read of slot `slot`, known to hold the closure of the `nth` lambda `owner` wrote. Where
/// `in_place`, a call of one runs `lambda` in place, its captures read out of the closure;
/// otherwise it calls the closure. Only the emitter makes one.
pub type KnownRead = {
  name: Bytes,
  slot: Int,
  lambda: Lambda,
  owner: Bytes,
  nth: Int,
  in_place: Bool,
}

/// A lambda as its owner lowered it: its parameters, its frame's size, what it copies in, `at`,
/// where it is written, its type as a value, which performs nothing, and what its body performs.
pub type Lambda = {
  params: Int,
  size: Int,
  captures: List<Capture>,
  body: Code,
  at: Span,
  ty: FunctionType,
  row: Row,
}

pub type CodeField = { name: Bytes, value: Code }

/// A pattern with its binders resolved to slots, so a match writes bindings straight into the window.
pub type CodePattern =
  | PxWild
  /// `span` is the binder's, which a release names it by, and `ty` what it binds.
  | PxVar({ name: Bytes, slot: Int, span: Span, ty: Type })
  | PxLit(Lit)
  /// An integer from `lo` through `hi`, both of one integer type.
  | PxRange({ lo: Lit, hi: Lit })
  /// A constructor of the sum `sum`, its case at place `case` among the sum's.
  | PxCtor({ sum: Bytes, name: Bytes, case: Int, args: List<CodePattern> })
  | PxRecord({ fields: List<CodePatternField>, rest: Bool })
  | PxList({ items: List<CodePattern>, rest: Option<CodePattern> })

pub type CodePatternField = { name: Bytes, pat: CodePattern }

pub type CodeArm = { pat: CodePattern, guard: Option<Code>, body: Code }

/// A free name a barrier copies in on entry: its slot outside and its slot here.
pub type Capture = { src: Int, dst: Int }

/// A `handle`: its body, its clauses and `return` clause, and what the body performs.
pub type CodeHandle = { body: Code, clauses: List<CodeClause>, ret: Option<CodeReturn>, row: Row }

/// A handler clause opens its own barrier: its parameters and `resume` binder take the leading
/// slots. It runs as a closure of type `ty`; `row` is what its body performs and `resumed` what
/// resuming its continuation does.
pub type CodeClause = {
  effect: Bytes,
  op: Bytes,
  resource: Bytes,
  label: Option<Code>,
  params: Int,
  /// `[*t]` binds the call site's label as one more leading slot, after the parameters and before
  /// the continuation, which is the order the run appends them in.
  binds_label: Bool,
  resume: Bool,
  size: Int,
  captures: List<Capture>,
  body: Code,
  at: Span,
  ty: FunctionType,
  row: Row,
  resumed: Row,
}

/// A handler's `return` clause, a barrier of its own led by the value the body answered: it runs
/// as a closure of type `ty`, and `row` is what it performs.
pub type CodeReturn = {
  size: Int,
  captures: List<Capture>,
  body: Code,
  at: Span,
  ty: FunctionType,
  row: Row,
}

pub type CodeStmt =
  | CLet({ name: Bytes, slot: Int, value: Code })
  /// `let <pattern> = e`: the value is bound as a whole and the pattern's names read out of it.
  | CLetPat({ span: Span, pat: CodePattern, value: Code })
  | CDo({ code: Code })

/// The name across the program a read of a definition, a constructor or a builtin, `c`, reads; none
/// for any other code.
pub fn read_name(c: Code) -> Option<Bytes> =
  match c.node {
    NDef(d) -> Some(d.full),
    NCtor(k) -> Some(k.name),
    NBuiltin(b) -> Some(b.name),
    _ -> None,
  }

/// `c` with `f` applied to each node after its parts.
pub fn nodes_mapped(c: Code, f: (Node) -> Node) -> Code = {
  let go = |x: Code| nodes_mapped(x, f);
  let opt = |x: Option<Code>| match x { Some(y) -> Some(go(y)), None -> None };
  let fields = |fs: List<CodeField>| fs.map(|x: CodeField| { name: x.name, value: go(x.value) });
  let lambda = |l: Lambda| { ..l, body: go(l.body) };
  let node = match c.node {
    NUnary(u) -> NUnary({ ..u, operand: go(u.operand) }),
    NBinary(b) -> NBinary({ ..b, lhs: go(b.lhs), rhs: go(b.rhs) }),
    NApp(a) -> NApp({ ..a, func: go(a.func), args: a.args.map(go) }),
    NIf(i) ->
      NIf({ cond: go(i.cond), then_branch: go(i.then_branch), else_branch: go(i.else_branch) }),
    NBlock(b) ->
      NBlock({
        stmts: b.stmts.map(|s: CodeStmt|
          match s {
            CLet(l) -> CLet({ ..l, value: go(l.value) }),
            CLetPat(l) -> CLetPat({ ..l, value: go(l.value) }),
            CDo(d) -> CDo({ code: go(d.code) }),
          }),
        tail: opt(b.tail),
      }),
    NList(l) -> NList({ items: l.items.map(go) }),
    NRecord(r) -> NRecord({ fields: fields(r.fields) }),
    NMatch(m) ->
      NMatch({
        scrutinee: go(m.scrutinee),
        arms: m.arms.map(|a: CodeArm| { pat: a.pat, guard: opt(a.guard), body: go(a.body) }),
      }),
    NPerform(p) -> NPerform({ ..p, label: opt(p.label), args: p.args.map(go) }),
    NLambda(l) -> NLambda(lambda(l)),
    NSimulate(s) -> NSimulate({ ..s, body: go(s.body) }),
    NParallel(p) -> NParallel({ branches: p.branches.map(go) }),
    NHandle(h) ->
      NHandle({
        ..h,
        body: go(h.body),
        clauses: h.clauses.map(|cl: CodeClause| { ..cl, label: opt(cl.label), body: go(cl.body) }),
        ret: match h.ret { Some(r) -> Some({ ..r, body: go(r.body) }), None -> None },
      }),
    NField(x) -> NField({ ..x, base: go(x.base) }),
    NUpdate(u) -> NUpdate({ ..u, base: go(u.base), sets: fields(u.sets) }),
    NKnown(k) -> NKnown({ ..k, lambda: lambda(k.lambda) }),
    _ -> c.node,
  };
  { ..c, node: f(node) }
}

/// The code `c` holds, each part once.
pub fn code_parts(c: Code) -> List<Code> =
  match c.node {
    NUnary(u) -> [u.operand],
    NBinary(b) -> [b.lhs, b.rhs],
    NApp(a) -> a.args.push(a.func),
    NIf(i) -> [i.cond, i.then_branch, i.else_branch],
    NBlock(b) ->
      b.stmts.fold(match b.tail { Some(t) -> [t], None -> [] }, |acc: List<Code>, s: CodeStmt|
        acc.push(match s { CLet(l) -> l.value, CLetPat(l) -> l.value, CDo(d) -> d.code })),
    NList(l) -> l.items,
    NRecord(r) -> r.fields.map(|f: CodeField| f.value),
    NMatch(m) ->
      m.arms.fold([m.scrutinee], |acc: List<Code>, a: CodeArm|
        List::push(match a.guard { Some(g) -> acc.push(g), None -> acc }, a.body)),
    NPerform(p) -> match p.label { Some(l) -> p.args.push(l), None -> p.args },
    NLambda(l) -> [l.body],
    NSimulate(s) -> [s.body],
    NParallel(p) -> p.branches,
    NHandle(h) ->
      h.clauses.fold(
        match h.ret { Some(r) -> [h.body, r.body], None -> [h.body] },
        |acc: List<Code>, cl: CodeClause| acc.push(cl.body),
      ),
    NField(f) -> [f.base],
    NUpdate(u) -> u.sets.map(|f: CodeField| f.value).push(u.base),
    NKnown(k) -> [k.lambda.body],
    _ -> [],
  }

// --- the dump ---------------------------------------------------------------

/// A resource a label parameter names is the slot it reads, which stays one comma-free word.
fn resource_tag(name: Bytes, label: Option<Code>) -> Bytes =
  match label {
    None -> name,
    Some(c) -> match c.node { NVar(v) -> b"$".concat(ascii_of_int(v.slot)), _ -> name },
  }

pub fn dump_lit(literal: Lit) -> Bytes / {abort.raise} =
  match literal {
    LInt(n) -> b"i".concat(ascii_of_int(n)),
    // Lowercased, so the dump has one spelling whatever case the suffix was written in.
    LFixed(name, bits) -> Bytes::concat_all([b"x", lower_bytes(name), b":", ascii_of_int(bits)]),
    LWide(name, high, low) ->
      Bytes::concat_all([
        b"x",
        lower_bytes(name),
        b":",
        ascii_of_int(high),
        b":",
        ascii_of_int(low),
      ]),
    LBool(b) -> if b { b"T" } else { b"F" },
    LStr(s) -> Bytes::concat_all([b"s", ascii_of_int(s.len()), b":", hex(s)]),
    LBytes(s) -> Bytes::concat_all([b"y", ascii_of_int(s.len()), b":", hex(s)]),
    LEmbedded(digest, size) -> Bytes::concat_all([b"e", ascii_of_int(size), b":", hex(digest)]),
    LFloat(_) -> b"f",
    LDec(r) -> Bytes::concat_all([b"d", ascii_of_int(r.len()), b":", hex(r)]),
    LChar(v) -> b"c".concat(ascii_of_int(v)),
    // Parser placeholders: never in a checked program's tree, so they dump as themselves.
    LUnit -> b"u",
    LBad -> b"!",
  }

fn lower_bytes(s: Bytes) -> Bytes / {abort.raise} =
  Bytes::of_string(String::of_bytes(s).ascii_lower())

pub fn hex(s: Bytes) -> Bytes / {abort.raise} =
  range(0, s.len()).fold(b"", |acc: Bytes, i: Int| {
    let byte = s.at(i);
    Bytes::concat_all([acc, hex_digit(byte / 16), hex_digit(byte % 16)])
  })

fn dump_caps(captures: List<Capture>) -> Bytes =
  Bytes::concat_all([
    b"[",
    captures.fold(b"", |acc: Bytes, capture: Capture|
      Bytes::concat_all([acc, ascii_of_int(capture.src), b">", ascii_of_int(capture.dst), b" "])),
    b"]",
  ])

pub fn dump_pat(p: CodePattern) -> Bytes / {abort.raise} =
  match p {
    PxWild -> b"_",
    PxVar(v) -> Bytes::concat_all([b"v:", v.name, b":", ascii_of_int(v.slot)]),
    PxLit(l) -> b"l:".concat(dump_lit(l)),
    PxRange(r) -> Bytes::concat_all([b"g:", dump_lit(r.lo), b"..=", dump_lit(r.hi)]),
    PxCtor(c) ->
      Bytes::concat_all([
        b"c:",
        c.name,
        b"(",
        c.args.fold(b"", |acc: Bytes, a: CodePattern| Bytes::concat_all([acc, dump_pat(a), b","])),
        b")",
      ]),
    PxRecord(r) ->
      Bytes::concat_all([
        b"r:(",
        r.fields.fold(b"", |acc: Bytes, f: CodePatternField|
          Bytes::concat_all([acc, f.name, b"=", dump_pat(f.pat), b","])),
        if r.rest { b"..)" } else { b")" },
      ]),
    PxList(l) ->
      Bytes::concat_all([
        b"s:(",
        l.items.fold(b"", |acc: Bytes, i: CodePattern| Bytes::concat_all([acc, dump_pat(i), b","])),
        match l.rest { Some(r) -> b"..".concat(dump_pat(r)), None -> b"" },
        b")",
      ]),
  }

pub fn dump(code: Code) -> Bytes / {abort.raise} = dump_node(code.node)

fn dump_node(n: Node) -> Bytes / {abort.raise} =
  match n {
    NLit(l) -> Bytes::concat_all([b"lit(", dump_lit(l), b")"]),
    NVar(v) -> Bytes::concat_all([b"var(", v.name, b",", ascii_of_int(v.slot), b")"]),
    NDef(d) -> Bytes::concat_all([b"def(", d.full, b")"]),
    NCtor(c) -> Bytes::concat_all([b"ctor(", c.name, b")"]),
    NBuiltin(b) -> Bytes::concat_all([b"builtin(", b.name, b")"]),
    NUnary(u) -> Bytes::concat_all([b"un(", u.op, b",", dump(u.operand), b")"]),
    NBinary(b) -> Bytes::concat_all([b"bin(", b.op, b",", dump(b.lhs), b",", dump(b.rhs), b")"]),
    NApp(a) ->
      Bytes::concat_all([
        b"app(",
        dump(a.func),
        a.args.fold(b"", |acc: Bytes, code: Code| Bytes::concat_all([acc, b",", dump(code)])),
        b")",
      ]),
    NKnown(k) -> Bytes::concat_all([b"known(", k.owner, b",", k.name, b")"]),
    NIf(i) ->
      Bytes::concat_all([
        b"if(",
        dump(i.cond),
        b",",
        dump(i.then_branch),
        b",",
        dump(i.else_branch),
        b")",
      ]),
    NBlock(b) ->
      Bytes::concat_all([
        b"block(",
        b.stmts.fold(b"", |acc: Bytes, stmt: CodeStmt|
          acc.concat(match stmt {
            CLet(l) ->
              Bytes::concat_all([
                b"let(v:",
                l.name,
                b":",
                ascii_of_int(l.slot),
                b",",
                dump(l.value),
                b"),",
              ]),
            CLetPat(l) -> Bytes::concat_all([b"let(", dump_pat(l.pat), b",", dump(l.value), b"),"]),
            CDo(d) -> Bytes::concat_all([b"do(", dump(d.code), b"),"]),
          })),
        match b.tail { Some(t) -> dump(t), None -> b"-" },
        b")",
      ]),
    NList(l) ->
      Bytes::concat_all([
        b"list(",
        l.items.fold(b"", |acc: Bytes, code: Code| Bytes::concat_all([acc, dump(code), b","])),
        b")",
      ]),
    NRecord(r) ->
      Bytes::concat_all([
        b"rec(",
        r.fields.fold(b"", |acc: Bytes, fd: CodeField|
          Bytes::concat_all([acc, fd.name, b"=", dump(fd.value), b","])),
        b")",
      ]),
    NMatch(m) ->
      Bytes::concat_all([
        b"match(",
        dump(m.scrutinee),
        m.arms.fold(b"", |acc: Bytes, a: CodeArm|
          Bytes::concat_all([
            acc,
            b",arm(",
            dump_pat(a.pat),
            b",",
            match a.guard { Some(g) -> dump(g), None -> b"-" },
            b",",
            dump(a.body),
            b")",
          ])),
        b")",
      ]),
    NLabel(n) -> Bytes::concat_all([b"label(", n, b")"]),
    NPerform(p) ->
      Bytes::concat_all([
        b"perform(",
        p.effect,
        b",",
        p.op,
        b",",
        resource_tag(p.resource, p.label),
        p.args.fold(b"", |acc: Bytes, a: Code| Bytes::concat_all([acc, b",", dump(a)])),
        b")",
      ]),
    NParallel(pr) ->
      Bytes::concat_all([
        b"par(",
        pr.branches.fold(b"", |acc: Bytes, code: Code| Bytes::concat_all([acc, dump(code), b","])),
        b")",
      ]),
    NSimulate(sm) ->
      Bytes::concat_all([
        b"sim(",
        ascii_of_int(sm.size),
        b",",
        dump_caps(sm.captures),
        b",",
        dump(sm.body),
        b")",
      ]),
    NHandle(h) ->
      Bytes::concat_all([
        b"handle(",
        dump(h.body),
        h.clauses.fold(b"", |acc: Bytes, c: CodeClause|
          Bytes::concat_all([
            acc,
            b",cl(",
            c.effect,
            b",",
            c.op,
            b",",
            resource_tag(c.resource, c.label),
            b",",
            ascii_of_int(c.params),
            b",",
            if c.resume { b"true" } else { b"false" },
            b",",
            ascii_of_int(c.size),
            b",",
            dump_caps(c.captures),
            b",",
            dump(c.body),
            b")",
          ])),
        match h.ret {
          Some(r) ->
            Bytes::concat_all([
              b",ret(",
              ascii_of_int(r.size),
              b",",
              dump_caps(r.captures),
              b",",
              dump(r.body),
              b")",
            ]),
          None -> b",-",
        },
        b")",
      ]),
    NLambda(l) ->
      Bytes::concat_all([
        b"lam(",
        ascii_of_int(l.params),
        b",",
        ascii_of_int(l.size),
        b",",
        dump_caps(l.captures),
        b",",
        dump(l.body),
        b")",
      ]),
    NField(f) -> Bytes::concat_all([b"fld(", dump(f.base), b",", f.field, b")"]),
    NUpdate(u) ->
      Bytes::concat_all([
        b"upd(",
        dump(u.base),
        u.copies.fold(b"", |acc: Bytes, n: Bytes| Bytes::concat_all([acc, b",c:", n])),
        u.sets.fold(b"", |acc: Bytes, f: CodeField|
          Bytes::concat_all([acc, b",s:", f.name, b"=", dump(f.value)])),
        b")",
      ]),
  }

// --- slots ------------------------------------------------------------------
// Forward pass: every binding gets a slot and slot numbers never go back, so a window is sized by
// bindings, not by how many are live at once.

type Bind = { name: Bytes, slot: Int }

/// `names` is the barrier's window in order; `scope` is what is visible here, innermost last.
type Frame = {
  names: List<Bytes>,
  scope: List<Bind>,
  captures: List<Capture>,
  capture_names: List<Bytes>,
}

fn bind(frame: Frame, name: Bytes) -> Frame =
  {
    names: frame.names.push(name),
    scope: frame.scope.push({ name: name, slot: frame.names.len() }),
    captures: frame.captures,
    capture_names: frame.capture_names,
  }

fn find(frame: Frame, name: Bytes) -> Option<Int> =
  frame.scope.fold(None, |acc: Option<Int>, b: Bind|
    if b.name == name { Some(b.slot) } else { acc })

/// The barriers in scope, innermost last. A free name is threaded through every barrier between use
/// and binding. `labels` are the body's label parameters, in their order. `failed` says why a part
/// of the body could not be lowered, where one could not: what the check settled admits nothing
/// that cannot, so a failure is the compiler's own.
type Stack = {
  frames: List<Frame>,
  labels: List<Bytes>,
  releases: Releases,
  /// Where each binder a release names put its name, by the binder's key.
  binders: Map<Int, Binder>,
  /// The keys an or-pattern's first alternative gives its names, which the check names every
  /// alternative's binders by.
  rekey: Map<Bytes, Int>,
  /// The variables of the handlers whose clauses are lowering, innermost last.
  held: List<HeldVar>,
  failed: List<Bytes>,
}

/// A variable of a handler whose clause is lowering: its place among the handler's, its type, and
/// the barrier of the clause, inside which a binder of its name hides it.
type HeldVar = { name: Bytes, at: Int, ty: Type, depth: Int }

/// Where the check lets go of what a body owns, read by site: the releases at each node, and the
/// sites a release names as what it lets go, a binder's or that of a node whose value no binder holds.
type Releases = { at: Map<Int, List<ReleaseSite>>, held: Map<Int, Bool> }

/// The barrier, by depth, the slot a binder put its name in, and the type it holds.
type Binder = { name: Bytes, depth: Int, slot: Int, ty: Type }

fn releases_of(sites: List<ReleaseSite>) -> Releases =
  sites.fold({ at: Map::new(), held: Map::new() }, |acc: Releases, x: ReleaseSite|
    {
      at: acc.at.insert(x.at, match acc.at.get(x.at) { Some(xs) -> xs.push(x), None -> [x] }),
      // A node's own value a failing release after it names is held by the node itself.
      held: match x.place {
        ReleaseFailing(_) -> if x.binding == x.at { acc.held }
        else { acc.held.insert(x.binding, true) },
        _ -> acc.held.insert(x.binding, true),
      },
    })

fn st_top(stack: Stack) -> Frame =
  match stack.frames.at(stack.frames.len() - 1) { Some(f) -> f, None -> empty_frame() }

fn empty_frame() -> Frame = { names: [], scope: [], captures: [], capture_names: [] }

fn st_at(stack: Stack, i: Int) -> Frame =
  match stack.frames.at(i) { Some(f) -> f, None -> empty_frame() }

fn st_set(stack: Stack, i: Int, frame: Frame) -> Stack =
  {
    ..stack,
    frames: range(0, stack.frames.len()).map(|j: Int| if j == i { frame } else { st_at(stack, j) }),
  }

fn st_top_set(stack: Stack, frame: Frame) -> Stack = st_set(stack, stack.frames.len() - 1, frame)

fn st_push(stack: Stack, frame: Frame) -> Stack = { ..stack, frames: stack.frames.push(frame) }

fn st_pop(stack: Stack) -> Stack =
  { ..stack, frames: range(0, stack.frames.len() - 1).map(|j: Int| st_at(stack, j)) }

/// `stack` noting that lowering failed, and why.
fn failing(stack: Stack, why: Bytes) -> Stack = { ..stack, failed: stack.failed.push(why) }

/// The depth whose barrier has `name` in scope or already captures it, innermost first.
fn st_depth(stack: Stack, name: Bytes) -> Option<Int> =
  range(0, stack.frames.len()).fold(None, |acc: Option<Int>, i: Int| {
    let f = st_at(stack, i);
    match find(f, name) {
      Some(_) -> Some(i),
      None -> match find_cap(f, name) { Some(_) -> Some(i), None -> acc },
    }
  })

fn slot_in(f: Frame, name: Bytes) -> Option<Int> =
  match find(f, name) { Some(s) -> Some(s), None -> find_cap(f, name) }

/// Resolves `name` at the innermost barrier, threading a capture through every barrier between when it is free.
type SlotLookup = { slot: Option<Int>, stack: Stack }

fn resolve(stack: Stack, name: Bytes) -> SlotLookup =
  match st_depth(stack, name) {
    None -> { slot: None, stack: stack },
    Some(d) -> {
      let start = match slot_in(st_at(stack, d), name) { Some(s) -> s, None -> 0 };
      range(d + 1, stack.frames.len()).fold(
        { slot: Some(start), stack: stack },
        |acc: SlotLookup, i: Int| {
          let f = st_at(acc.stack, i);
          let from = match acc.slot { Some(s) -> s, None -> 0 };
          match find_cap(f, name) {
            Some(s) -> { slot: Some(s), stack: acc.stack },
            None -> {
              let g = capture(f, name, from);
              { slot: find_cap(g, name), stack: st_set(acc.stack, i, g) }
            },
          }
        },
      )
    },
  }

/// The read of the local `name`, of type `ty`, at `span`: a handler's variable a clause reads
/// through the runtime, or a slot. One no barrier binds is the compiler's failure.
fn read_local(stack: Stack, name: Bytes, ty: Type, span: Span) -> Lowered =
  match held_var(stack, name) {
    Some(h) -> { code: var_read(h, span), stack: stack },
    None -> {
      let r = resolve(stack, name);
      match r.slot {
        Some(s) ->
          { code: { node: NVar({ name: name, slot: s }), span: span, ty: ty }, stack: r.stack },
        None ->
          {
            code: { node: NLit(LUnit), span: span, ty: ty },
            stack: failing(r.stack, b"a read of a name no binder holds: ".concat(name)),
          },
      }
    },
  }

/// The name a label parameter is bound under: no value can take it, so no binder shadows the label.
fn label_binder(name: Bytes) -> Bytes = Bytes::concat_all([b"[", name, b"]"])

/// Whether `name` is one `label_binder` binds a label parameter under.
pub fn is_label_binder(name: Bytes) -> Bool = name.starts_with(b"[")

/// A resource a label binder holds is read like any other name, captures threaded and all; one
/// that names no label parameter of the body has none.
fn label_code(stack: Stack, name: Bytes) -> Option<Lowered> =
  if !stack.labels.contains(name) { None }
  else { Some(read_local(stack, label_binder(name), label_ty(), dummy_span())) }

/// What a label parameter's binder holds: the resource's entry, a word.
fn label_ty() -> Type = int_type()

/// What a definition with label parameters takes, and what a call of it hands: the declared
/// parameters, then the labels.
pub fn with_labels<a>(declared: List<a>, labels: List<a>) -> List<a> = declared.concat(labels)

/// The last `labels` of `xs`, laid out as `with_labels` lays them.
pub fn labels_among<a>(xs: List<a>, labels: Int) -> List<a> = xs.drop(xs.len() - labels)

/// The label arguments a call of a definition fills, each the body's own label parameter or a
/// field-table entry of the name.
fn label_args(stack: Stack, labels: List<FilledLabel>) -> Seq =
  labels.fold({ codes: [], stack: stack }, |acc: Seq, l: FilledLabel| {
    let named = match l { LabelNamed(n) -> Some(n), LabelParam(i) -> acc.stack.labels.at(i) };
    match named {
      None ->
        {
          codes: acc.codes.push({ node: NLabel(b""), span: dummy_span(), ty: label_ty() }),
          stack: failing(acc.stack, b"a label filled with a parameter the body does not have"),
        },
      Some(n) -> match label_code(acc.stack, n) {
        Some(o) -> { codes: acc.codes.push(o.code), stack: o.stack },
        None ->
          {
            codes: acc.codes.push({ node: NLabel(n), span: dummy_span(), ty: label_ty() }),
            stack: acc.stack,
          },
      },
    }
  })

/// A block's binders leave scope at its end, but the slots they took are never reused.
fn bind_st(stack: Stack, name: Bytes) -> Stack = st_top_set(stack, bind(st_top(stack), name))

/// `name`, of type `ty`, bound by the binder at `site`, which a release may name it by.
fn bind_at(stack: Stack, name: Bytes, site: Int, ty: Type) -> Stack =
  binder_noted(
    bind_st(stack, name),
    name,
    site,
    stack.frames.len() - 1,
    st_top(stack).names.len(),
    ty,
  )

/// `stack` noting that the binder at `site` put `name`, of type `ty`, in slot `slot` of barrier
/// `depth`, where a release names it.
fn binder_noted(stack: Stack, name: Bytes, site: Int, depth: Int, slot: Int, ty: Type) -> Stack =
  if !stack.releases.held.contains(site) { stack } else {
    {
      ..stack,
      binders: stack.binders.insert(site, { name: name, depth: depth, slot: slot, ty: ty }),
    }
  }

fn unscope(frame: Frame, to: Int) -> Frame =
  {
    names: frame.names,
    scope: take(frame.scope, to),
    captures: frame.captures,
    capture_names: frame.capture_names,
  }

fn unscope_st(stack: Stack, to: Int) -> Stack = st_top_set(stack, unscope(st_top(stack), to))

fn depth_of(stack: Stack) -> Int = st_top(stack).scope.len()

fn find_cap(frame: Frame, name: Bytes) -> Option<Int> =
  range(0, frame.capture_names.len()).fold(None, |acc: Option<Int>, i: Int|
    if frame.capture_names.at_or(i, b"") == name {
      match frame.captures.at(i) { Some(c) -> Some(c.dst), None -> acc }
    } else { acc })

fn capture(frame: Frame, name: Bytes, src: Int) -> Frame =
  {
    names: frame.names.push(name),
    scope: frame.scope,
    captures: frame.captures.push({ src: src, dst: frame.names.len() }),
    capture_names: frame.capture_names.push(name),
  }

fn take(xs: List<Bind>, n: Int) -> List<Bind> =
  range(0, n).fold([], |acc: List<Bind>, i: Int| acc.push(xs.at_or(i, { name: b"", slot: 0 })))

// --- the lowering -----------------------------------------------------------

type Lowered = { code: Code, stack: Stack }

type Seq = { codes: List<Code>, stack: Stack }

/// `node` standing where `e` does, at its type.
fn at(e: TypedExpr<Type>, node: Node) -> Code = { node: node, span: e.span, ty: e.ty }

fn lower_in(e: TypedExpr<Type>, stack: Stack) -> Lowered / {abort.raise} = {
  let o = lower_node(e, stack);
  if stack.releases.held.len() == 0 { o } else { released_around(e.span, o) }
}

fn lower_seq(exprs: List<TypedExpr<Type>>, stack: Stack) -> Seq / {abort.raise} =
  exprs.fold({ codes: [], stack: stack }, |s: Seq, x: TypedExpr<Type>| {
    let o = lower_in(x, s.stack);
    { codes: s.codes.push(o.code), stack: o.stack }
  })

type Fields = { fields: List<CodeField>, stack: Stack }

fn lower_fields(fields: List<TypedField<Type>>, stack: Stack) -> Fields / {abort.raise} =
  fields.fold({ fields: [], stack: stack }, |acc: Fields, f: TypedField<Type>| {
    let o = lower_in(f.value, acc.stack);
    { fields: acc.fields.push({ name: f.name, value: o.code }), stack: o.stack }
  })

fn lower_node(e: TypedExpr<Type>, stack: Stack) -> Lowered / {abort.raise} =
  match e.node {
    TypedLit(l) -> { code: at(e, NLit(l)), stack: stack },
    TypedRead(r) -> match r {
      ReadLocal(name) -> read_local(stack, name, e.ty, e.span),
      ReadDefinition(d) ->
        {
          code: at(e, NDef({ full: d.full, args: d.args, rows: d.rows, labels: d.labels })),
          stack: stack,
        },
      ReadConstructor(c) ->
        {
          code: at(e, NCtor({ sum: c.sum, name: c.name, case: c.case, args: c.args })),
          stack: stack,
        },
      ReadBuiltin(b) ->
        { code: at(e, NBuiltin({ name: b.name, args: b.args, rows: b.rows })), stack: stack },
    },
    TypedUnary(u) -> {
      let o = lower_in(u.operand, stack);
      match open_witness(u.witness, u.operand.ty) {
        Some(p) -> {
          let w = read_local(o.stack, witness_param(p), int_type(), e.span);
          {
            code: {
              ..hidden_call(b"?numeric_unary", [int_code(if u.op == b"bitnot" { 1 } else { 0 }), w.code, o.code], e.ty),
              span: e.span,
            },
            stack: w.stack,
          }
        },
        None -> { code: at(e, NUnary({ op: u.op, operand: o.code })), stack: o.stack },
      }
    },
    TypedBinary(b) -> {
      let l = lower_in(b.lhs, stack);
      let r = lower_in(b.rhs, l.stack);
      match open_witness(b.witness, b.lhs.ty) {
        Some(p) -> {
          let w = read_local(r.stack, witness_param(p), int_type(), e.span);
          {
            code: {
              ..hidden_call(b"?numeric_binary", [int_code(numeric_op_code(b.op)), w.code, l.code, r.code], e.ty),
              span: e.span,
            },
            stack: w.stack,
          }
        },
        None -> { code: at(e, NBinary({ op: b.op, lhs: l.code, rhs: r.code })), stack: r.stack },
      }
    },
    TypedIf(i) -> {
      let c = lower_in(i.cond, stack);
      let t = lower_in(i.then_branch, c.stack);
      let el = lower_in(i.else_branch, t.stack);
      {
        code: at(e, NIf({ cond: c.code, then_branch: t.code, else_branch: el.code })),
        stack: el.stack,
      }
    },
    TypedFieldRead(f) -> {
      let b = lower_in(f.base, stack);
      { code: at(e, NField({ base: b.code, field: f.field })), stack: b.stack }
    },
    TypedList(xs) -> {
      let r = lower_seq(xs, stack);
      { code: at(e, NList({ items: r.codes })), stack: r.stack }
    },
    // Copies of one path's fields update the record the path reads, before any other base.
    TypedRecord(fs) -> match match as_path_update(fs, stack, e) {
        Some(u) -> Some(u),
        None -> as_update(fs, stack, e),
      } {
      Some(u) -> u,
      None -> {
        let r = lower_fields(fs, stack);
        { code: at(e, NRecord({ fields: r.fields })), stack: r.stack }
      },
    },
    TypedUpdate(u) -> updated(e, u.base, u.sets, u.copies, stack),
    // A definition's or a native's witnesses lead its arguments, and a definition's labels follow them.
    TypedCall(c) -> {
      let fu = lower_in(c.callee, stack);
      let ws = match c.callee.node {
        TypedRead(ReadDefinition(d)) -> witness_args(fu.stack, d.witnesses, c.callee.span),
        TypedRead(ReadBuiltin(b)) -> witness_args(fu.stack, b.witnesses, c.callee.span),
        _ -> { codes: [], stack: fu.stack },
      };
      let r = lower_seq(c.args, ws.stack);
      let ls = match c.callee.node {
        TypedRead(ReadDefinition(d)) -> label_args(r.stack, d.labels),
        _ -> { codes: [], stack: r.stack },
      };
      {
        code: at(
          e,
          NApp({
            func: fu.code,
            args: with_labels(ws.codes.concat(r.codes), ls.codes),
            row: c.row,
          }),
        ),
        stack: ls.stack,
      }
    },
    TypedMatch(m) ->
      matched(e.span, e.ty, lower_in(m.scrutinee, stack), |start: ArmAcc|
        m.arms.fold(start, |acc: ArmAcc, arm: TypedArm<Type>|
          arms_into(acc, alternatives(arm.pat), arm.guard, |st: Stack| lower_in(arm.body, st)))),
    TypedPerform(p) -> {
      let r = lower_seq(p.args, stack);
      let name = match p.resource { Some(n) -> n, None -> b"" };
      let lb = label_code(r.stack, name);
      {
        code: at(
          e,
          NPerform({
            effect: p.effect,
            op: p.op,
            resource: name,
            label: match lb { Some(o) -> Some(o.code), None -> None },
            atom: p.atom,
            args: r.codes,
          }),
        ),
        stack: match lb { Some(o) -> o.stack, None -> r.stack },
      }
    },
    // A lambda opens its own barrier; a name it reads from outside becomes a capture.
    TypedLambda(l) ->
      snapshotted(e, stack, |st: Stack| lower_lambda(l.params, l.body, l.row, st, e.span)),
    // `simulate` opens a barrier, as a lambda does, and takes no parameters.
    TypedSimulate(t) ->
      snapshotted(e, stack, |st: Stack| {
        let b = lower_in(t.body, st_push(st, empty_frame()));
        let inner = st_top(b.stack);
        {
          code: at(
            e,
            NSimulate({
              size: inner.names.len(),
              captures: inner.captures,
              body: b.code,
              at: simulated_at(e.span),
              row: t.row,
            }),
          ),
          stack: st_pop(b.stack),
        }
      }),
    // Each branch is a lambda with no parameters.
    TypedParallel(ts) ->
      snapshotted(e, stack, |st: Stack| {
        let r = ts.fold({ codes: [], stack: st }, |sq: Seq, t: TypedThunk<Type>| {
          let o = lower_lambda([], t.body, t.row, sq.stack, minted(t.body.span, role_branch()));
          { codes: sq.codes.push(o.code), stack: o.stack }
        });
        { code: at(e, NParallel({ branches: r.codes })), stack: r.stack }
      }),
    TypedHandle(h) ->
      snapshotted(e, stack, |st: Stack| handled(e, h.body, h.clauses, h.ret, h.vars, h.row, st)),
    TypedBlock(b) ->
      lower_from(b.stmts, 0, { stmts: [], stack: stack }, depth_of(stack), b.tail, e.ty),
  }

/// `{ ..base, f: e }`: the base read after every written field, so its cells are reused in place.
/// A base that is not a variable in scope is bound to a name no source can spell first, so it runs
/// once however many fields are copied.
fn updated(
  e: TypedExpr<Type>,
  base: TypedExpr<Type>,
  sets: List<TypedField<Type>>,
  copies: List<Bytes>,
  stack: Stack,
) -> Lowered / {abort.raise} = {
  let made = |read: (Stack) -> Lowered / {abort.raise}, st: Stack| {
    let r = lower_fields(sets, st);
    let b = read(r.stack);
    { code: at(e, NUpdate({ base: b.code, copies: copies, sets: r.fields })), stack: b.stack }
  };
  let local = match base.node { TypedRead(ReadLocal(n)) -> st_depth(stack, n) != None, _ -> false };
  if local { made(|st: Stack| lower_in(base, st), stack) } else {
    let o = lower_in(base, stack);
    let name = b"?u".concat(ascii_of_int(e.span.site));
    let slot = st_top(o.stack).names.len();
    let depth = depth_of(o.stack);
    let inner = made(|st: Stack| read_local(st, name, base.ty, base.span), bind_st(o.stack, name));
    {
      code: at(
        e,
        NBlock({
          stmts: [CLet({ name: name, slot: slot, value: o.code })],
          tail: Some(inner.code),
        }),
      ),
      stack: unscope_st(inner.stack, depth),
    }
  }
}

/// A variable a field is read out of, the read of it, and its type.
type Projected = { name: Bytes, at: Span, ty: Type }

/// Recovers an update from a literal whose copied fields are `b.<own name>` for one slot variable
/// `b`; the base is read after every written field. The update stands where the literal does.
fn as_update(
  fields: List<TypedField<Type>>,
  stack: Stack,
  e: TypedExpr<Type>,
) -> Option<Lowered> / {abort.raise} = {
  // Two different copied-from variables make this a plain literal.
  let copies = fields.fold(
    { names: [], bad: false },
    |acc: { names: List<Bytes>, bad: Bool }, f: TypedField<Type>|
      match copy_base(f, stack) {
        None -> acc,
        Some(n) -> if acc.names.len() == 0 { { names: [n], bad: acc.bad } }
        else if acc.names.contains(n) { acc }
        else { { names: acc.names, bad: true } },
      },
  );
  if copies.bad { None } else {
    // With no copied field, a record projected from inside a written field is the base whose cells
    // are reused. The base is read where the first copy, or else that projection, reads it.
    let base = match copies.names.at(0) {
      Some(n) ->
        fields.fold(None, |acc: Option<Projected>, f: TypedField<Type>|
          match acc {
            Some(_) -> acc,
            None -> if copy_base(f, stack) != Some(n) { None } else {
              match f.value.node {
                TypedFieldRead(x) -> Some({ name: n, at: x.base.span, ty: x.base.ty }),
                _ -> None,
              }
            },
          }),
      None ->
        fields.fold(None, |acc: Option<Projected>, f: TypedField<Type>|
          match acc {
            Some(_) -> acc,
            None -> if copy_base(f, stack) != None { None }
            else { projected_var(f.value, stack, []) },
          }),
    };
    match base {
      None -> None,
      Some(read) -> {
        let copied = |f: TypedField<Type>| copy_base(f, stack) == Some(read.name);
        // Walked in field order, so each copy resolves the base, and each capture is numbered,
        // where it stands.
        let o = fields.fold({ fields: [], stack: stack }, |a: Fields, f: TypedField<Type>|
          if copied(f) { { fields: a.fields, stack: resolve(a.stack, read.name).stack } } else {
            let v = lower_in(f.value, a.stack);
            { fields: a.fields.push({ name: f.name, value: v.code }), stack: v.stack }
          });
        match resolve(o.stack, read.name).slot {
          None -> None,
          Some(sl) ->
            Some({
              code: at(
                e,
                NUpdate({
                  base: { node: NVar({ name: read.name, slot: sl }), span: read.at, ty: read.ty },
                  copies: fields.filter(copied).map(|f: TypedField<Type>| f.name),
                  sets: o.fields,
                }),
              ),
              stack: o.stack,
            }),
        }
      },
    }
  }
}

/// Recovers an update from a literal whose copied fields are `p.<own name>` for one path `p` of
/// field reads off an in-scope variable, `h.five` say: the record `p` reads is the base, read after
/// every written field, so a record lying in place is updated where it lies.
fn as_path_update(
  fields: List<TypedField<Type>>,
  stack: Stack,
  e: TypedExpr<Type>,
) -> Option<Lowered> / {abort.raise} = {
  let paths = fields.fold(
    { spelled: None, bad: false },
    |acc: { spelled: Option<Bytes>, bad: Bool }, f: TypedField<Type>|
      match copy_path(f, stack) {
        None -> acc,
        Some(c) -> match acc.spelled {
          None -> { ..acc, spelled: Some(c) },
          Some(s) -> if c == s { acc } else { { ..acc, bad: true } },
        },
      },
  );
  if paths.bad { None } else {
    // The base is read out of the first copied field's path, after every written field.
    match fields.fold(None, |acc: Option<TypedExpr<Type>>, f: TypedField<Type>|
        match acc {
          Some(_) -> acc,
          None -> if copy_path(f, stack) == None { None }
          else { match f.value.node { TypedFieldRead(x) -> Some(x.base), _ -> None } },
        }) {
      None -> None,
      Some(base) -> {
        let copied = |f: TypedField<Type>| copy_path(f, stack) != None;
        let r = lower_fields(fields.filter(|f: TypedField<Type>| !copied(f)), stack);
        let o = lower_in(base, r.stack);
        Some({
          code: at(
            e,
            NUpdate({
              base: o.code,
              copies: fields.filter(copied).map(|f: TypedField<Type>| f.name),
              sets: r.fields,
            }),
          ),
          stack: o.stack,
        })
      },
    }
  }
}

/// The spelling of the path of one or more field reads off an in-scope variable that a field copies
/// from, when the field is `p.<its own name>` for such a path `p`, which tells two paths apart.
fn copy_path(field: TypedField<Type>, stack: Stack) -> Option<Bytes> =
  match field.value.node {
    TypedFieldRead(x) -> if x.field != field.name || in_flight(field.value, stack) { None }
    else { match x.base.node { TypedFieldRead(_) -> path_spelled(x.base, stack), _ -> None } },
    _ -> None,
  }

/// `e` spelled as a path of field reads off an in-scope variable, where it is one.
fn path_spelled(e: TypedExpr<Type>, stack: Stack) -> Option<Bytes> =
  match e.node {
    TypedRead(ReadLocal(n)) -> match st_depth(stack, n) { Some(_) -> Some(n), None -> None },
    TypedFieldRead(x) -> match path_spelled(x.base, stack) {
      Some(s) -> Some(Bytes::concat_all([s, b".", x.field])),
      None -> None,
    },
    _ -> None,
  }

/// Whether a failure may let go of `value` before what it is handed to holds it, which only a node
/// lowered where it stands can be.
fn in_flight(value: TypedExpr<Type>, stack: Stack) -> Bool =
  stack.releases.held.contains(value.span.site)

/// The bare in-scope variable a field copies from, when the field is `b.<its own name>`.
fn copy_base(field: TypedField<Type>, stack: Stack) -> Option<Bytes> =
  match field.value.node {
    TypedFieldRead(x) -> if x.field != field.name || in_flight(field.value, stack) { None } else {
      match x.base.node {
        TypedRead(ReadLocal(n)) -> match st_depth(stack, n) { Some(_) -> Some(n), None -> None },
        _ -> None,
      }
    },
    _ -> None,
  }

/// The first in-scope variable a field read projects from inside `e`; a name `e` binds itself is
/// never the base.
fn projected_var(e: TypedExpr<Type>, stack: Stack, inner: List<Bytes>) -> Option<Projected> = {
  let first = |exprs: List<TypedExpr<Type>>|
    exprs.fold(None, |acc: Option<Projected>, x: TypedExpr<Type>|
      match acc { Some(_) -> acc, None -> projected_var(x, stack, inner) });
  match e.node {
    TypedFieldRead(x) -> match x.base.node {
      TypedRead(ReadLocal(n)) -> if !inner.contains(n) && st_depth(stack, n) != None {
        Some({ name: n, at: x.base.span, ty: x.base.ty })
      } else { None },
      _ -> projected_var(x.base, stack, inner),
    },
    TypedUnary(x) -> projected_var(x.operand, stack, inner),
    TypedBinary(x) -> first([x.lhs, x.rhs]),
    TypedCall(x) -> match projected_var(x.callee, stack, inner) {
      Some(n) -> Some(n),
      None -> first(x.args),
    },
    TypedIf(x) -> first([x.cond, x.then_branch, x.else_branch]),
    TypedMatch(x) -> projected_var(x.scrutinee, stack, inner),
    TypedBlock(x) -> {
      let walked = x.stmts.fold(
        { found: None, inner: inner },
        |acc: { found: Option<Projected>, inner: List<Bytes> }, stmt: TypedStmt<Type>|
          match acc.found {
            Some(_) -> acc,
            None -> match stmt {
              TypedLet(l) ->
                {
                  found: projected_var(l.value, stack, acc.inner),
                  inner: acc.inner.concat(typed_binders(l.pat)),
                },
              TypedLetElse(l) ->
                {
                  found: match projected_var(l.value, stack, acc.inner) {
                    Some(n) -> Some(n),
                    None -> projected_var(l.fallback, stack, acc.inner),
                  },
                  inner: acc.inner.concat(typed_binders(l.pat)),
                },
              TypedDo(v) -> { found: projected_var(v, stack, acc.inner), inner: acc.inner },
              TypedAssign(v) ->
                { found: projected_var(v.value, stack, acc.inner), inner: acc.inner },
            },
          },
      );
      match walked.found {
        Some(n) -> Some(n),
        None -> match x.tail { Some(t) -> projected_var(t, stack, walked.inner), None -> None },
      }
    },
    TypedRecord(fs) -> first(fs.map(|f: TypedField<Type>| f.value)),
    TypedUpdate(x) -> match projected_var(x.base, stack, inner) {
      Some(n) -> Some(n),
      None -> first(x.sets.map(|f: TypedField<Type>| f.value)),
    },
    TypedList(xs) -> first(xs),
    TypedPerform(x) -> first(x.args),
    TypedHandle(x) -> projected_var(x.body, stack, inner),
    TypedLit(_) -> None,
    TypedRead(_) -> None,
    TypedLambda(_) -> None,
    TypedSimulate(_) -> None,
    TypedParallel(_) -> None,
  }
}

/// The names `pattern` binds.
fn typed_binders(pattern: TypedPattern<Type>) -> List<Bytes> =
  match pattern {
    TypedBinder(v) -> [v.name],
    TypedCase(c) ->
      c.args.fold([], |acc: List<Bytes>, a: TypedPattern<Type>| acc.concat(typed_binders(a))),
    TypedRecordPattern(r) ->
      r.fields.fold([], |acc: List<Bytes>, f: TypedFieldPattern<Type>|
        acc.concat(typed_binders(f.pat))),
    TypedListPattern(l) -> {
      let items = l.items.fold([], |acc: List<Bytes>, a: TypedPattern<Type>|
        acc.concat(typed_binders(a)));
      match l.rest { Some(r) -> items.concat(typed_binders(r)), None -> items }
    },
    TypedOr(alts) ->
      alts.fold([], |acc: List<Bytes>, a: TypedPattern<Type>| acc.concat(typed_binders(a))),
    TypedWild -> [],
    TypedLitPattern(_) -> [],
    TypedRange(_) -> [],
  }

/// A lambda over `params` written at `at`: its body lowered behind a barrier, which the captures
/// cross, performing `row`.
fn lower_lambda(
  params: List<TypedParam<Type>>,
  body: TypedExpr<Type>,
  row: Row,
  stack: Stack,
  at: Span,
) -> Lowered / {abort.raise} = {
  let inner = params.fold(empty_frame(), |g: Frame, p: TypedParam<Type>| bind(g, p.name));
  let b = lower_in(body, params_noted(st_push(stack, inner), params, stack.frames.len(), 0));
  let f = st_top(b.stack);
  let value = closure_type(params, body.ty);
  {
    code: {
      node: NLambda({
        params: params.len(),
        size: f.names.len(),
        captures: f.captures,
        body: b.code,
        at: at,
        ty: value,
        row: row,
      }),
      span: dummy_span(),
      ty: TyFn(value),
    },
    stack: st_pop(b.stack),
  }
}

/// The type of a closure over `params` answering `ret` as a value, which performs nothing.
fn closure_type(params: List<TypedParam<Type>>, ret: Type) -> FunctionType =
  {
    params: params.map(|p: TypedParam<Type>| p.ty),
    kept: [],
    once: false,
    ret: ret,
    effects: row_empty(),
  }

/// `stack` noting where each of `params` put its name: slots from `from` on in barrier `depth`.
fn params_noted(stack: Stack, params: List<TypedParam<Type>>, depth: Int, from: Int) -> Stack =
  params.fold(
    { stack: stack, slot: from },
    |acc: { stack: Stack, slot: Int }, p: TypedParam<Type>|
      {
        stack: binder_noted(acc.stack, p.name, binder_key(p.span), depth, acc.slot, p.ty),
        slot: acc.slot + 1,
      },
  ).stack

// --- handlers ---------------------------------------------------------------
// A clause reads and assigns its handler's variables through the runtime, which holds the
// variables of the clause running. What a clause hands on to run later, a lambda or a nested body,
// reads the values they had where it was made.

/// A `handle`. The body runs in the enclosing barrier; each clause opens its own, led by its
/// parameters, its label and `resume`. The variables' first values are bound before it and handed
/// to its frame as its body starts.
fn handled(
  e: TypedExpr<Type>,
  body: TypedExpr<Type>,
  clauses: List<TypedClause<Type>>,
  ret: Option<TypedReturn<Type>>,
  vars: List<TypedHandlerVar<Type>>,
  row: Row,
  stack: Stack,
) -> Lowered / {abort.raise} = {
  let depth = depth_of(stack);
  // Each initializer reads the variables above it.
  let made = vars.fold(
    { stmts: [], reads: [], stack: stack },
    |acc: { stmts: List<CodeStmt>, reads: List<Code>, stack: Stack }, v: TypedHandlerVar<Type>| {
      let o = lower_in(v.init, acc.stack);
      let slot = st_top(o.stack).names.len();
      {
        stmts: acc.stmts.push(CLet({ name: v.name, slot: slot, value: o.code })),
        reads: acc.reads.push({ node: NVar({ name: v.name, slot: slot }), span: v.span, ty: v.ty }),
        stack: bind_st(o.stack, v.name),
      }
    },
  );
  let b = lower_in(body, unscope_st(made.stack, depth));
  let installed = made.reads.fold([], |acc: List<CodeStmt>, r: Code|
    acc.push(CDo({ code: hidden_call(b"?handler_init", [int_code(acc.len()), r], unit_type()) })));
  let started = if installed.len() == 0 { b.code } else {
    { node: NBlock({ stmts: installed, tail: Some(b.code) }), span: b.code.span, ty: b.code.ty }
  };
  let outer_held = b.stack.held;
  let holding = |st: Stack|
    {
      ..st,
      held: vars.fold(outer_held, |acc: List<HeldVar>, v: TypedHandlerVar<Type>|
        acc.push({
          name: v.name,
          at: acc.len() - outer_held.len(),
          ty: v.ty,
          depth: st.frames.len() - 1,
        })),
    };
  let cls = clauses.fold(
    { clauses: [], stack: b.stack },
    |acc: { clauses: List<CodeClause>, stack: Stack }, c: TypedClause<Type>| {
      let named = c.params.map(|p: TypedParam<Type>| p.name);
      let with_label = match c.label { Some(t) -> named.push(t.name), None -> named };
      let names = match c.resume { Some(k) -> with_label.push(k.name), None -> with_label };
      // The clause's resource is read where the table is built, outside the clause's own barrier.
      // A `[*]` clause keys on the wildcard rather than on a label, so it answers every label the
      // table is asked about.
      let res = if c.every_label { b"*" } else { match c.resource { Some(n) -> n, None -> b"" } };
      let lb = label_code(acc.stack, res);
      let outer = match lb { Some(o) -> o.stack, None -> acc.stack };
      let inner = outer.frames.len();
      let pushed = params_noted(
        st_push(outer, names.fold(empty_frame(), |g: Frame, n: Bytes| bind(g, n))),
        c.params,
        inner,
        0,
      );
      let entered = match c.resume {
        Some(k) -> params_noted(pushed, [k], inner, names.len() - 1),
        None -> pushed,
      };
      let cb = lower_in(c.body, holding(entered));
      let f = st_top(cb.stack);
      {
        clauses: acc.clauses.push({
          effect: c.effect,
          op: c.op,
          resource: res,
          label: match lb { Some(o) -> Some(o.code), None -> None },
          params: c.params.len(),
          binds_label: c.label != None,
          resume: c.resume != None,
          size: f.names.len(),
          captures: f.captures,
          body: cb.code,
          at: c.span,
          ty: closure_type(
            c.params.concat(match c.label { Some(t) -> [t], None -> [] }).concat(match c.resume {
              Some(k) -> [k],
              None -> [],
            }),
            c.body.ty,
          ),
          row: c.row,
          resumed: c.resumed,
        }),
        stack: { ..st_pop(cb.stack), held: outer_held },
      }
    },
  );
  let answered = match ret {
    None -> { ret: None, stack: cls.stack },
    Some(r) -> {
      let entered = params_noted(
        st_push(cls.stack, bind(empty_frame(), r.binder.name)),
        [r.binder],
        cls.stack.frames.len(),
        0,
      );
      let rb = lower_in(r.body, holding(entered));
      let f = st_top(rb.stack);
      {
        ret: Some({
          size: f.names.len(),
          captures: f.captures,
          body: rb.code,
          at: r.span,
          ty: closure_type([r.binder], r.body.ty),
          row: r.row,
        }),
        stack: { ..st_pop(rb.stack), held: outer_held },
      }
    },
  };
  let installed_handle = at(
    e,
    NHandle({ body: started, clauses: cls.clauses, ret: answered.ret, row: row }),
  );
  {
    code: if made.stmts.len() == 0 { installed_handle }
    else { at(e, NBlock({ stmts: made.stmts, tail: Some(installed_handle) })) },
    stack: answered.stack,
  }
}

/// The variable of the handler whose clause is lowering that `name` reads, unless a binder inside
/// that clause hides it.
fn held_var(stack: Stack, name: Bytes) -> Option<HeldVar> =
  match stack.held.fold(None, |acc: Option<HeldVar>, h: HeldVar|
      if h.name == name { Some(h) } else { acc }) {
    None -> None,
    Some(h) -> if range(h.depth, stack.frames.len()).any(|i: Int|
        find(st_at(stack, i), name) != None) { None }
    else { Some(h) },
  }

/// The runtime's read of the variable `h` of the clause running.
fn var_read(h: HeldVar, span: Span) -> Code =
  { ..hidden_call(b"?handler_var", [int_code(h.at)], h.ty), span: span }

/// `e`, which runs after the clause may have returned, lowered by `lower`, reading the values the
/// handler's variables it names had where it is made: each read before it, bound under its own
/// name.
fn snapshotted(
  e: TypedExpr<Type>,
  stack: Stack,
  lower: (Stack) -> Lowered / {abort.raise},
) -> Lowered / {abort.raise} =
  if stack.held.len() == 0 { lower(stack) } else {
    let used = typed_nodes(e).fold([], |acc: List<HeldVar>, x: TypedExpr<Type>|
      match x.node {
        TypedRead(ReadLocal(n)) -> match held_var(stack, n) {
          Some(h) -> if acc.any(|y: HeldVar| y.name == n) { acc } else { acc.push(h) },
          None -> acc,
        },
        _ -> acc,
      });
    if used.len() == 0 { lower(stack) } else {
      let depth = depth_of(stack);
      let bound = used.fold({ stmts: [], stack: stack }, |acc: BlockAcc, h: HeldVar|
        {
          stmts: acc.stmts.push(
            CLet({ name: h.name, slot: st_top(acc.stack).names.len(), value: var_read(h, e.span) }),
          ),
          stack: bind_st(acc.stack, h.name),
        });
      let o = lower(bound.stack);
      {
        code: at(e, NBlock({ stmts: bound.stmts, tail: Some(o.code) })),
        stack: unscope_st(o.stack, depth),
      }
    }
  }

fn int_code(n: Int) -> Code = { node: NLit(LInt(n)), span: dummy_span(), ty: int_type() }

/// The type parameter whose witness does an operator over an operand of type `ty`, where `ty` is
/// still a parameter: at a specialisation's type, the operator is that type's own.
fn open_witness(witness: Option<Bytes>, ty: Type) -> Option<Bytes> =
  match ty { TyVar(_) -> witness, _ -> None }

/// The witnesses a call passes, read at `at`.
fn witness_args(stack: Stack, witnesses: List<NumericWitness>, at: Span) -> Seq =
  witnesses.fold({ codes: [], stack: stack }, |acc: Seq, w: NumericWitness|
    match w {
      ConcreteWitness(n) -> { ..acc, codes: acc.codes.push(int_code(witness_code(n))) },
      ParamWitness(p) -> {
        let o = read_local(acc.stack, witness_param(p), int_type(), at);
        { codes: acc.codes.push(o.code), stack: o.stack }
      },
      StatedWitness(ctor) ->
        {
          ..acc,
          codes: acc.codes.push(
            hidden_call(
              stated_witness_name(),
              [{ node: NLit(LStr(ctor)), span: dummy_span(), ty: string_type() }],
              int_type(),
            ),
          ),
        },
    })

/// A call of the hidden builtin `name`, which only this lowering writes, on `args`, answering `ty`.
fn hidden_call(name: Bytes, args: List<Code>, ty: Type) -> Code =
  {
    node: NApp({
      func: {
        node: NBuiltin({ name: name, args: [], rows: [] }),
        span: dummy_span(),
        ty: fn_type(args.map(|a: Code| a.ty), ty, row_empty()),
      },
      args: args,
      row: row_empty(),
    }),
    span: dummy_span(),
    ty: ty,
  }

// --- matches and blocks -----------------------------------------------------

type ArmAcc = { arms: List<CodeArm>, stack: Stack }

type GuardOut = { code: Option<Code>, stack: Stack }

fn lower_guard(expr: Option<TypedExpr<Type>>, stack: Stack) -> GuardOut / {abort.raise} =
  match expr {
    None -> { code: None, stack: stack },
    Some(x) -> {
      let o = lower_in(x, stack);
      { code: Some(o.code), stack: o.stack }
    },
  }

type BlockAcc = { stmts: List<CodeStmt>, stack: Stack }

/// A `match` at `span`, of type `ty`, of the scrutinee lowered as `sc`, with the arms `arms` adds.
fn matched(
  span: Span,
  ty: Type,
  sc: Lowered,
  arms: (ArmAcc) -> ArmAcc / {abort.raise},
) -> Lowered / {abort.raise} = {
  let depth = depth_of(sc.stack);
  let walked = arms({ arms: [], stack: sc.stack });
  {
    code: { node: NMatch({ scrutinee: sc.code, arms: walked.arms }), span: span, ty: ty },
    stack: unscope_st(walked.stack, depth),
  }
}

/// An arm per alternative, each with the arm's guard and body: a guard is tried again for every
/// alternative that matches, in order. Each alternative binds under the first one's keys, which the
/// guard and body then read.
fn arms_into(
  acc: ArmAcc,
  alts: List<CodePattern>,
  guard: Option<TypedExpr<Type>>,
  body: (Stack) -> Lowered / {abort.raise},
) -> ArmAcc / {abort.raise} = {
  let keys = match alts.at(0) {
    Some(p) ->
      code_binders(p).fold(
        Map::new(),
        |m: Map<Bytes, Int>, b: { name: Bytes, span: Span, slot: Int }|
          m.insert(b.name, binder_key(b.span)),
      ),
    None -> Map::new(),
  };
  alts.fold(acc, |a: ArmAcc, alt: CodePattern| {
    let pd = depth_of(a.stack);
    let pat = slotted(alt, { ..a.stack, rekey: keys });
    // What the pattern binds is renamed; a name the guard or body binds again is its own.
    let g = lower_guard(guard, { ..pat.stack, rekey: Map::new() });
    let b = body(g.stack);
    {
      arms: a.arms.push({ pat: pat.pat, guard: g.code, body: b.code }),
      stack: unscope_st(b.stack, pd),
    }
  })
}

/// The statements from `from` on, each straight one lowered into `acc`, until one whose pattern can
/// fail, or whose alternatives bind in different places, ends the block in a `match` over the rest
/// of it; `let ... else` adds its `else` as the arm for everything else. Every block it makes is of
/// the block's own type, `ty`.
fn lower_from(
  stmts: List<TypedStmt<Type>>,
  from: Int,
  acc: BlockAcc,
  depth: Int,
  tail: Option<TypedExpr<Type>>,
  ty: Type,
) -> Lowered / {abort.raise} = {
  let next = |a: BlockAcc| lower_from(stmts, from + 1, a, depth, tail, ty);
  let rest = |st: Stack|
    lower_from(stmts, from + 1, { stmts: [], stack: st }, depth_of(st), tail, ty);
  let branched = |o: Lowered| finished(acc, depth, { code: Some(o.code), stack: o.stack }, ty);
  match stmts.at(from) {
    None -> finished(acc, depth, lower_guard(tail, acc.stack), ty),
    Some(TypedLetElse(l)) ->
      branched(
        matched(l.span, ty, lower_in(l.value, acc.stack), |start: ArmAcc|
          arms_into(
            arms_into(start, alternatives(l.pat), None, rest),
            [PxWild],
            None,
            |st: Stack| lower_in(l.fallback, st),
          )),
      ),
    Some(TypedLet(l)) -> match alternatives(l.pat) {
      [PxVar(v)] -> {
        let o = lower_in(l.value, acc.stack);
        next({
          stmts: acc.stmts.push(
            CLet({ name: v.name, slot: st_top(o.stack).names.len(), value: o.code }),
          ),
          stack: bind_at(o.stack, v.name, binder_key(v.span), v.ty),
        })
      },
      [p] -> {
        let o = lower_in(l.value, acc.stack);
        // What a miss lets go of is read where the value stands, before the pattern binds.
        let missed = match o.stack.releases.at.get(l.pat_span.site) {
          Some(xs) -> xs.filter(|x: ReleaseSite| x.place == ReleaseUnwinding),
          None -> [],
        };
        let unwound = held_codes(o.stack, missed);
        let s = slotted(p, unwound.stack);
        next({
          stmts: acc.stmts.push(
            CLetPat({
              span: l.span,
              pat: s.pat,
              value: if unwound.codes.len() == 0 { o.code }
              else { hidden_call(b"?let_missing", unwound.codes.push(o.code), o.code.ty) },
            }),
          ),
          stack: s.stack,
        })
      },
      // The checker refused a `let` whose alternatives can fail, so they cover the value.
      alts ->
        branched(
          matched(l.span, ty, lower_in(l.value, acc.stack), |start: ArmAcc|
            arms_into(start, alts, None, rest)),
        ),
    },
    Some(TypedDo(x)) -> {
      let o = lower_in(x, acc.stack);
      next({ stmts: acc.stmts.push(CDo({ code: o.code })), stack: o.stack })
    },
    Some(TypedAssign(a)) -> {
      let o = lower_in(a.value, acc.stack);
      match held_var(o.stack, a.name) {
        Some(h) ->
          next({
            stmts: acc.stmts.push(
              CDo({
                code: {
                  ..hidden_call(b"?handler_set", [int_code(h.at), o.code], unit_type()),
                  span: a.span,
                },
              }),
            ),
            stack: o.stack,
          }),
        None ->
          next({
            ..acc,
            stack: failing(
              o.stack,
              Bytes::concat_all([
                b"an assignment to `",
                a.name,
                b"`, which no clause's handler holds",
              ]),
            ),
          }),
      }
    },
  }
}

/// The block of the statements lowered, ending in the tail `t` lowered after them.
fn finished(acc: BlockAcc, depth: Int, t: GuardOut, ty: Type) -> Lowered =
  {
    code: { node: NBlock({ stmts: acc.stmts, tail: t.code }), span: dummy_span(), ty: ty },
    stack: unscope_st(t.stack, depth),
  }

// --- patterns ---------------------------------------------------------------

type PatOut = { pat: CodePattern, stack: Stack }

/// The patterns without a choice that `p` is, in the order a match tries them, a nested choice
/// distributed outwards with the leftmost alternative varying slowest. Each binder holds slot 0
/// until `slotted` gives it its own.
fn alternatives(p: TypedPattern<Type>) -> List<CodePattern> =
  match p {
    TypedWild -> [PxWild],
    TypedBinder(v) -> [PxVar({ name: v.name, slot: 0, span: v.span, ty: v.ty })],
    TypedLitPattern(l) -> [PxLit(l)],
    TypedRange(r) -> [PxRange({ lo: r.lo, hi: r.hi })],
    TypedCase(c) ->
      choices(c.args.map(alternatives)).map(|args: List<CodePattern>|
        PxCtor({ sum: c.sum, name: c.name, case: c.case, args: args })),
    TypedRecordPattern(r) ->
      choices(
        r.fields.map(|f: TypedFieldPattern<Type>|
          alternatives(f.pat).map(|q: CodePattern| { name: f.name, pat: q })),
      ).map(|fs: List<CodePatternField>| PxRecord({ fields: fs, rest: r.rest })),
    TypedListPattern(l) -> {
      let rests: List<Option<CodePattern>> = match l.rest {
        Some(x) -> alternatives(x).map(Some),
        None -> [None],
      };
      choices(l.items.map(alternatives)).fold(
        [],
        |acc: List<CodePattern>, items: List<CodePattern>|
          acc.concat(rests.map(|r: Option<CodePattern>| PxList({ items: items, rest: r }))),
      )
    },
    TypedOr(alts) ->
      alts.fold([], |acc: List<CodePattern>, a: TypedPattern<Type>| acc.concat(alternatives(a))),
  }

/// Every choice of one element from each list, the first list varying slowest.
fn choices<a>(xss: List<List<a>>) -> List<List<a>> =
  xss.fold([[]], |acc: List<List<a>>, xs: List<a>|
    acc.fold([], |out: List<List<a>>, prefix: List<a>| out.concat(xs.map(|x: a| prefix.push(x)))))

/// `p` with each binder given the next slot, in walk order.
fn slotted(p: CodePattern, stack: Stack) -> PatOut =
  match p {
    PxVar(v) -> {
      let key = match stack.rekey.get(v.name) { Some(k) -> k, None -> binder_key(v.span) };
      {
        pat: PxVar({ ..v, slot: st_top(stack).names.len() }),
        stack: bind_at(stack, v.name, key, v.ty),
      }
    },
    PxCtor(c) -> {
      let r = all_slotted(c.args, stack);
      { pat: PxCtor({ ..c, args: r.pats }), stack: r.stack }
    },
    PxRecord(r) -> {
      let walked = r.fields.fold(
        { fields: [], stack: stack },
        |acc: { fields: List<CodePatternField>, stack: Stack }, f: CodePatternField| {
          let o = slotted(f.pat, acc.stack);
          { fields: acc.fields.push({ name: f.name, pat: o.pat }), stack: o.stack }
        },
      );
      { pat: PxRecord({ fields: walked.fields, rest: r.rest }), stack: walked.stack }
    },
    PxList(l) -> {
      let r = all_slotted(l.items, stack);
      match l.rest {
        None -> { pat: PxList({ items: r.pats, rest: None }), stack: r.stack },
        Some(rp) -> {
          let o = slotted(rp, r.stack);
          { pat: PxList({ items: r.pats, rest: Some(o.pat) }), stack: o.stack }
        },
      }
    },
    PxWild -> { pat: p, stack: stack },
    PxLit(_) -> { pat: p, stack: stack },
    PxRange(_) -> { pat: p, stack: stack },
  }

type PatSeq = { pats: List<CodePattern>, stack: Stack }

fn all_slotted(patterns: List<CodePattern>, stack: Stack) -> PatSeq =
  patterns.fold({ pats: [], stack: stack }, |acc: PatSeq, p: CodePattern| {
    let o = slotted(p, acc.stack);
    { pats: acc.pats.push(o.pat), stack: o.stack }
  })

/// The binders of `p`, in walk order.
fn code_binders(p: CodePattern) -> List<{ name: Bytes, span: Span, slot: Int }> =
  match p {
    PxVar(v) -> [{ name: v.name, span: v.span, slot: v.slot }],
    PxCtor(c) -> code_binders_all(c.args),
    PxRecord(r) -> code_binders_all(r.fields.map(|f: CodePatternField| f.pat)),
    PxList(l) -> code_binders_all(match l.rest { Some(r) -> l.items.push(r), None -> l.items }),
    PxWild -> [],
    PxLit(_) -> [],
    PxRange(_) -> [],
  }

fn code_binders_all(ps: List<CodePattern>) -> List<{ name: Bytes, span: Span, slot: Int }> =
  ps.fold([], |acc: List<{ name: Bytes, span: Span, slot: Int }>, p: CodePattern|
    acc.concat(code_binders(p)))

/// The slots a pattern binds, each once.
pub fn pat_slots(p: CodePattern) -> List<Int> =
  code_binders(p).fold([], |acc: List<Int>, b: { name: Bytes, span: Span, slot: Int }|
    if acc.contains(b.slot) { acc } else { acc.push(b.slot) })

/// A variable pattern is irrefutable: the parser makes every upper-case bare name in pattern
/// position a constructor.
pub fn irrefutable(pattern: CodePattern) -> Bool =
  match pattern { PxWild -> true, PxVar(_) -> true, _ -> false }

// --- releases ---------------------------------------------------------------

/// `o`, the node at `span` lowered, with what the check lets go there: its value held by a slot of
/// its own where a release names it; the resources a failure in it lets go named around it; and
/// those let go before it runs or after it.
fn released_around(span: Span, o: Lowered) -> Lowered = {
  // The check files them the latest bound first.
  let here = match o.stack.releases.at.get(span.site) { Some(xs) -> xs, None -> [] };
  let unwinding = here.filter(|x: ReleaseSite| x.place == ReleaseUnwinding);
  let after = here.filter(|x: ReleaseSite| x.place == ReleaseAfter);
  let before = here.filter(|x: ReleaseSite| x.place == ReleaseBefore);
  let unwound = held_codes(o.stack, unwinding);
  let guarded = if unwinding.len() == 0 { { code: o.code, stack: unwound.stack } } else {
    { code: hidden_call(b"?unwinds", unwound.codes.push(o.code), o.code.ty), stack: unwound.stack }
  };
  let ty = guarded.code.ty;
  let ended = if after.len() == 0 { guarded } else {
    // The node's value is held while what runs after it is let go, which a failing release lets go.
    let s = guarded.stack;
    let slot = st_top(s).names.len();
    let depth = depth_of(s);
    // Noted whether or not a later node reads it: a failing release after this one names it.
    let named = bind_st(s, b"?released");
    let bound = {
      ..named,
      binders: named.binders.insert(span.site, {
        name: b"?released",
        depth: s.frames.len() - 1,
        slot: slot,
        ty: ty,
      }),
    };
    let lets = let_goes(bound, after, here);
    {
      code: held_then(b"?released", slot, guarded.code, lets.codes),
      stack: unscope_st(lets.stack, depth),
    }
  };
  let first = let_goes(ended.stack, before, here);
  let made = preceded(first.codes, ended.code);
  let s = first.stack;
  if !s.releases.held.contains(span.site) { { code: made, stack: s } } else {
    let slot = st_top(s).names.len();
    {
      code: held_then(b"?held", slot, made, []),
      stack: binder_noted(
        unscope_st(bind_st(s, b"?held"), depth_of(s)),
        b"?held",
        span.site,
        s.frames.len() - 1,
        slot,
        ty,
      ),
    }
  }
}

/// `value` held by slot `slot` under `name`, which no written name can be, then each of `calls`,
/// answering the value.
fn held_then(name: Bytes, slot: Int, value: Code, calls: List<Code>) -> Code =
  {
    node: NBlock({
      stmts: [CLet({ name: name, slot: slot, value: value })].concat(
        calls.map(|c: Code| CDo({ code: c })),
      ),
      tail: Some({ node: NVar({ name: name, slot: slot }), span: dummy_span(), ty: value.ty }),
    }),
    span: dummy_span(),
    ty: value.ty,
  }

/// `code` after each of `calls`.
fn preceded(calls: List<Code>, code: Code) -> Code =
  if calls.len() == 0 { code } else {
    {
      node: NBlock({ stmts: calls.map(|x: Code| CDo({ code: x })), tail: Some(code) }),
      span: dummy_span(),
      ty: code.ty,
    }
  }

/// A call letting go of each of `rs` in turn, between markers naming what `here`, the releases at
/// the node, files for its release failing.
fn let_goes(s: Stack, rs: List<ReleaseSite>, here: List<ReleaseSite>) -> Seq =
  rs.fold({ codes: [], stack: s }, |acc: Seq, r: ReleaseSite| {
    let own = held_codes(acc.stack, [r]);
    match own.codes.at(0) {
      None -> { ..acc, stack: own.stack },
      Some(x) -> {
        let failing = held_codes(
          own.stack,
          here.filter(|y: ReleaseSite| y.place == ReleaseFailing(r.binding)),
        );
        let call = hidden_call(b"?let_go", [x], unit_type());
        {
          codes: acc.codes.push(if failing.codes.len() == 0 { call }
          else { hidden_call(b"?unwinds", failing.codes.push(call), unit_type()) }),
          stack: failing.stack,
        }
      },
    }
  })

/// A read of the slot each of `rs` lets go of: its binder's in this barrier, or one captured from
/// the barrier it is bound in, where no barrier between binds its name again.
fn held_codes(s: Stack, rs: List<ReleaseSite>) -> Seq =
  rs.fold({ codes: [], stack: s }, |acc: Seq, r: ReleaseSite|
    match acc.stack.binders.get(r.binding) {
      Some(b) -> {
        let top = acc.stack.frames.len() - 1;
        if b.depth == top {
          {
            ..acc,
            codes: acc.codes.push({
              node: NVar({ name: b.name, slot: b.slot }),
              span: dummy_span(),
              ty: b.ty,
            }),
          }
        } else if b.depth < top
            && range(b.depth + 1, top + 1).all(|i: Int| find(st_at(acc.stack, i), b.name) == None) {
          let l = read_local(acc.stack, b.name, b.ty, dummy_span());
          { codes: acc.codes.push(l.code), stack: l.stack }
        } else { acc }
      },
      None -> acc,
    })

// --- reads ------------------------------------------------------------------

fn through_caps(reads: List<Int>, caps: List<Capture>) -> List<Int> =
  reads.fold([], |acc: List<Int>, s: Int|
    match caps.fold(None, |found: Option<Int>, capture: Capture|
        if capture.dst == s { Some(capture.src) } else { found }) {
      Some(src) -> acc.push(src),
      None -> acc,
    })

/// Every slot read, lambdas and clause bodies included: a name a barrier copies in is still a read.
pub fn slots_read(code: Code) -> List<Int> =
  match code.node {
    NVar(v) -> [v.slot],
    NLit(_) -> [],
    NDef(_) -> [],
    NCtor(_) -> [],
    NBuiltin(_) -> [],
    NUnary(u) -> slots_read(u.operand),
    NBinary(b) -> slots_read(b.lhs).concat(slots_read(b.rhs)),
    NField(f) -> slots_read(f.base),
    NApp(a) -> slots_read(a.func).concat(all_read(a.args)),
    NKnown(k) -> [k.slot],
    NIf(i) ->
      slots_read(i.cond).concat(slots_read(i.then_branch).concat(slots_read(i.else_branch))),
    NBlock(b) ->
      b.stmts.fold([], |acc: List<Int>, stmt: CodeStmt|
        acc.concat(match stmt {
          CLet(l) -> slots_read(l.value),
          CLetPat(l) -> slots_read(l.value),
          CDo(d) -> slots_read(d.code),
        })).concat(match b.tail { Some(t) -> slots_read(t), None -> [] }),
    NList(l) -> all_read(l.items),
    NRecord(r) -> fields_read(r.fields, []),
    NMatch(m) ->
      slots_read(m.scrutinee).concat(
        m.arms.fold([], |acc: List<Int>, a: CodeArm|
          acc.concat(
            List::concat(
              match a.guard { Some(g) -> slots_read(g), None -> [] },
              slots_read(a.body),
            ),
          )),
      ),
    NUpdate(u) -> fields_read(u.sets, slots_read(u.base)),
    NLabel(_) -> [],
    NPerform(p) ->
      List::concat(match p.label { Some(x) -> slots_read(x), None -> [] }, all_read(p.args)),
    // A capture read inside a lambda is a read of the object it copies; the lambda's own parameter
    // is not a read here.
    NLambda(l) -> through_caps(slots_read(l.body), l.captures),
    NSimulate(x) -> x.captures.map(|c2: Capture| c2.src).concat(slots_read(x.body)),
    NParallel(pr) -> all_read(pr.branches),
    NHandle(h) ->
      slots_read(h.body).concat(
        h.clauses.fold([], |acc: List<Int>, clause: CodeClause|
          acc.concat(match clause.label { Some(x) -> slots_read(x), None -> [] }).concat(
            through_caps(slots_read(clause.body), clause.captures),
          )).concat(match h.ret {
          Some(r) -> through_caps(slots_read(r.body), r.captures),
          None -> [],
        }),
      ),
  }

pub fn all_read(codes: List<Code>) -> List<Int> =
  codes.fold([], |acc: List<Int>, code: Code| acc.concat(slots_read(code)))

fn fields_read(fs: List<CodeField>, before: List<Int>) -> List<Int> =
  fs.fold(before, |acc: List<Int>, field: CodeField| acc.concat(slots_read(field.value)))

// --- a body -----------------------------------------------------------------

/// A body lowered: its code, its window's size, and why a part of it could not be lowered, where
/// one could not. The check settles nothing that cannot, so a failure is the compiler's own.
pub type LoweredBody = { code: Code, size: Int, failed: List<Bytes> }

/// One body, its slots resolved: `params` lead its window, then the label parameters `labels` a
/// label-generic definition takes after them. `releases` are where the check lets go of what the
/// body owns.
pub fn lower_fn(
  params: List<TypedParam<Type>>,
  labels: List<Bytes>,
  body: TypedExpr<Type>,
  releases: List<ReleaseSite> = [],
) -> LoweredBody / {abort.raise} = {
  let start = with_labels(params.map(|p: TypedParam<Type>| p.name), labels.map(label_binder)).fold(
    empty_frame(),
    |frame: Frame, name: Bytes| bind(frame, name),
  );
  let stack = params_noted(
    {
      frames: [start],
      labels: labels,
      releases: releases_of(releases),
      binders: Map::new(),
      rekey: Map::new(),
      held: [],
      failed: [],
    },
    params,
    0,
    0,
  );
  let o = lower_in(body, stack);
  { code: o.code, size: st_top(o.stack).names.len(), failed: o.stack.failed }
}
