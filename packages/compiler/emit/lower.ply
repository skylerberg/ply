//! A root's `Code` lowered to the typed form. Each node is typed from its parts as it is lowered, so
//! a type belongs to its node and not to its place in the text; each value is held as its type
//! says. This module holds the one recursion over a body; each construct's family lowers it from its
//! parts (`emit.lower.*`), and where a construct holds code, says what state each part is lowered
//! in and assembles the construct from the parts lowered.

import std.list (zip)
import compiler.emit.code (Code, read_name, CodeLiteral, CodeVar, NDef, NCtor, NBuiltin, CodeUnary,
                           CodeBinary, CodeApply, CodeIf, CodeBlock, CodeList, CodeRecord,
                           CodeMatch, CodePerform, CodeLabel, CodeLambda, CodeSimulate,
                           CodeParallel, CodeHandle, CodeFieldRead, CodeUpdate, CodeKnownLambda,
                           CodeStmt, CodeLet, CodeLetDestructure, CodeDo, CodeField, CodeArm,
                           CodeClause, CodePattern, is_label_binder)
import compiler.syntax.parsing (Span)
import compiler.syntax.patterns (LiteralUnit)
import compiler.syntax.exprs (detached_closure_span, scheduler_module)
import compiler.emit.representations (Def, resumed, no_ctors)
import compiler.emit.typing (unknown_type)
import compiler.emit.typed_ir (Arg, AsBool, AsListView, Return, Fn, Metered, falls_through,
                               operand_representation, CleanupScope, Unwinding, Fail, LetMismatch,
                               operand_var)
import compiler.emit.lower.module_context (ModuleContext, Root)
import compiler.emit.keys (Named, root_name, root_text, module_of)
import compiler.check.types (Type, row_empty)
import compiler.emit.lower.base (Context, Lowering, LoweredValue, ToCtor, ToBuiltin, ToDef, ToValue,
                                 ToInlinedBody, LoweredArm, GroupMember, initial_lowering,
                                 unreachable, enter_block, exit_block, joined, short_circuit,
                                 represented_as, note_slot_read, read_note, typed_slot_read,
                                 list_of_view, type_of, noted, no_captured_evidence, emitted)
import compiler.emit.lower.data (constructed, record_literal, field, record_update)
import compiler.emit.lower.scalars (literal, constant, operand, unary, binary, unwound)
import compiler.emit.lower.containers (list_literal, reads_column, column_read)
import compiler.emit.lower.matching (arm_start, match_joined, let_bound, let_else, compared_side,
                                     compared_args, compared)
import compiler.emit.lower.calling (convention, parameter_representations, target, global_value,
                                    known_lambda_read, called, applied, enter_inlined, exit_inlined,
                                    inlined_argument, range_argument, named_function_call,
                                    lambda_body_start, closure, group_body_starts, tail_group_root,
                                    known_body, note_step_captures, context_of, called_builtin,
                                    continuation_closure, called_at_types, simulate_called,
                                    stack_allocated, known_run, known_applied)
import compiler.emit.lower.handling (performed, label, clause_frame, ret_frame, body_frame,
                                     handle_assembled, parallel_block, enter_handle, handle_plan,
                                     clause_captured_evidence, instance_objects, detached_landing,
                                     detaches, scheduler_perform_call, HandlePlan)
import compiler.emit.lower.evidence (evidence_parameters, root_body_start, entry_body_start,
                                     words_of, evidence_parameter_types, performed_by,
                                     captured_evidence_for)
import compiler.emit.evidence (evidence_type)
import compiler.emit.output (RowGeneric)
import compiler.emit.statics (folded)

/// Root `r` of `setting` lowered as a build lowers it: its body after `known_body`, so a slot known
/// to hold a lambda reads as that lambda.
pub fn root_lowered(setting: ModuleContext, r: Root) -> Fn / {abort.raise} = {
  let body = known_body(root_text(root_name(r.key)), r.params, r.code);
  lowered_fn(context_of(setting, r, body), body)
}

/// Root `r` lowered as `root_lowered` lowers it, noting where each slot is read and where each
/// closure captures one, for `emit.moves` to read its moves off.
pub fn root_observed(setting: ModuleContext, r: Root) -> Fn / {abort.raise} = {
  let body = known_body(root_text(root_name(r.key)), r.params, r.code);
  lowered_fn({ ..context_of(setting, r, body), observing: true }, body)
}

/// The roots of one tail group of `setting` lowered as a build lowers them: as one root, keyed as its
/// first member.
pub fn group_lowered(setting: ModuleContext, roots: List<Root>) -> Fn / {abort.raise} =
  lowered_group(
    roots.map(|r: Root| {
      let body = known_body(root_text(root_name(r.key)), r.params, r.code);
      { cx: context_of(setting, r, body), body: body }
    }),
  )

/// A call in tail position of a definition of the module, and the type arguments it names it at.
pub type TailCall = { full: Bytes, args: List<Type> }

/// The calls `code` makes in tail position of definitions of `here`, after `acc`.
pub fn tail_calls(
  here: List<Def>,
  code: Code,
  acc: List<TailCall>,
) -> List<TailCall> / {abort.raise} =
  match code.node {
    CodeApply(a) -> match a.func.node {
      NDef(d) -> if here.any(|h: Def| h.root == Named(d.full) && h.arity == a.args.len()) {
        acc.push({ full: d.full, args: d.args })
      } else { acc },
      _ -> acc,
    },
    CodeBinary(b) -> if b.op == b"and" || b.op == b"or" { tail_calls(here, b.rhs, acc) }
    else { acc },
    CodeIf(i) -> tail_calls(here, i.else_branch, tail_calls(here, i.then_branch, acc)),
    CodeBlock(b) -> match b.tail { Some(t) -> tail_calls(here, t, acc), None -> acc },
    CodeMatch(m) ->
      m.arms.fold(acc, |a: List<TailCall>, arm: CodeArm| tail_calls(here, arm.body, a)),
    _ -> acc,
  }

/// Clause closure `k` of a `handle` planned as `plan`, laid in this frame where the instance is:
/// the instance's records are all that hold it, and they die with the frame.
fn stack_closure(plan: HandlePlan, k: LoweredValue) -> LoweredValue =
  match plan.instance.block { None -> stack_allocated(k), Some(_) -> k }

/// The closure `task.spawn` is handed, written `x`, a lambda the expansion made of any other value:
/// holding the words its row takes as they stand at the spawn and the heap instances they live in,
/// since the region runs it handing none and the task may outlive the function spawning it.
fn spawned(cx: Context, state: Lowering, x: Code) -> LoweredValue / {abort.raise} =
  match x.node {
    CodeLambda(l) -> {
      let held = captured_evidence_for(cx, state, words_of(cx, l.row), l.at);
      let frame = {
        params: l.params,
        size: l.size,
        captures: l.captures,
        resumes: None,
        body: l.body,
        ty: l.ty,
        words: [],
        held: { words: held.words, instance: None, kept: cx.kept },
      };
      let o = lambda_body_start(cx, held.st, frame, l.at);
      closure(cx, held.st, lowered(o.cx, o.st, l.body, true), frame, Metered, l.at)
    },
    _ -> lowered(cx, state, x, false),
  }

/// Whether a call of `func` names, around its last argument, the resources a failure in it lets go:
/// what `emit.code` writes where the check filed them.
fn is_cleanup_call(func: Code) -> Bool =
  match func.node { NBuiltin(f) -> f.name == b"?unwinds", _ -> false }

/// Whether `func` is what `emit.code` writes around a pattern `let`'s value, its other arguments
/// read the resources a miss of the pattern lets go.
fn is_let_mismatch_call(func: Code) -> Bool =
  match func.node { NBuiltin(f) -> f.name == b"?let_missing", _ -> false }

/// `let pat = ..`, its value `value` lowered, where `written` is `?is_let_mismatch_call(held.., value)`: a
/// miss of the pattern fails letting go of each of `held`, and of what the run around it does.
fn let_with_mismatch(
  cx: Context,
  value: LoweredValue,
  written: Code,
  pat: CodePattern,
  at: Span,
) -> Lowering / {abort.raise} = {
  let held = match written.node { CodeApply(a) -> a.args.take(a.args.len() - 1), _ -> [] };
  let own = held.fold(
    { st: value.st, us: [] },
    |acc: { st: Lowering, us: List<Unwinding> }, x: Code|
      match x.node {
        CodeVar(v) -> match acc.st.env.get(v.slot) {
          Some(arg) -> {
            let u = unwound(cx, acc.st, arg, at);
            { st: u.st, us: acc.us.push(u.unwound) }
          },
          None -> acc,
        },
        _ -> acc,
      },
  );
  let id = |u: Unwinding| match operand_var(u.arg) { Some(v) -> v.id, None -> -1 };
  let mine = own.us.map(id);
  let letting = value.st.unwinding.fold(own.us, |us: List<Unwinding>, u: Unwinding|
    if mine.contains(id(u)) { us } else { us.push(u) });
  let_else(cx, { ..value, st: own.st }, pat, [
    Fail({ reason: LetMismatch, at: at, letting: letting, unwind: [] }),
  ])
}

/// `args`, reads of the resources a failure lets go and last the node they are let go around, lowered:
/// the node between the markers that name them for its failure paths.
fn within_cleanup_scope(
  cx: Context,
  state: Lowering,
  args: List<Code>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args.at(args.len() - 1) {
    None -> unreachable(b"a release on failure around no node"),
    Some(body) -> {
      let held = args.fold(
        { st: state, unwound: [], at: 0 },
        |acc: { st: Lowering, unwound: List<Unwinding>, at: Int }, x: Code|
          if acc.at == args.len() - 1 { acc } else {
            let o = lowered(cx, acc.st, x, false);
            let u = unwound(cx, o.st, o.arg, at);
            { st: u.st, unwound: acc.unwound.push(u.unwound), at: acc.at + 1 }
          },
      );
      // Within the node a failure lets go of these and of what the run around it does.
      let mine = held.unwound.map(|u: Unwinding|
        match operand_var(u.arg) { Some(v) -> v.id, None -> -1 });
      let around = held.st.unwinding.filter(|u: Unwinding|
        !mine.contains(match operand_var(u.arg) { Some(v) -> v.id, None -> -1 }));
      let out = lowered(
        cx,
        {
          ..emitted(held.st, CleanupScope(Some(held.unwound))),
          unwinding: held.unwound.concat(around),
        },
        body,
        false,
      );
      let closed = { ..out, st: { ..out.st, unwinding: held.st.unwinding } };
      if falls_through(closed.st.insts) { { ..closed, st: emitted(closed.st, CleanupScope(None)) } }
      else { closed }
    },
  }

/// The root lowered. A root whose key leaves a row variable of its definition unfilled is settled by
/// its callers, at the rows they hand it.
pub fn lowered_fn(cx: Context, body: Code) -> Fn / {abort.raise} = {
  let conv = convention(cx);
  let held = parameter_representations(cx);
  let declared = cx.params.len();
  let h = evidence_parameters(cx.setting, cx.key);
  let handed_types = evidence_parameter_types(h);
  let params = range(0, conv.params.len()).map(|i: Int|
    {
      id: i,
      ty: if i >= declared {
        match handed_types.at(i - declared) { Some(t) -> t, None -> evidence_type() }
      } else { match cx.types.at(i) { Some(t) -> t, None -> unknown_type() } },
      representation: match held.at(i) { Some(r) -> r, None -> conv.params.get(i).representation },
    });
  let begun = entry_body_start(
    root_body_start(cx, initial_lowering(params), params, declared, h),
    cx.performs,
  );
  let start = if h.unfilled { noted(begun.st, { var: 0 - 1, reads: RowGeneric }) }
  else { begun.st };
  let out = lowered(begun.cx, start, body, true);
  let answered = if falls_through(out.st.insts) { represented_as(out, conv.result, body.span) }
  else { out };
  folded(cx.setting.ctors, {
    key: cx.key,
    kind: Metered,
    params: params,
    convention: conv,
    result_type: cx.result_type,
    body: if falls_through(answered.st.insts) { answered.st.insts.push(Return(answered.arg)) }
    else { answered.st.insts },
    lambdas: answered.st.lambdas,
    base: cx.base,
    members: [],
    links: answered.st.links,
    statics: answered.st.statics,
  })
}

/// A tail group's members lowered as one root.
pub fn lowered_group(members: List<GroupMember>) -> Fn / {abort.raise} = {
  let starts = group_body_starts(members);
  let bodies = range(0, members.len()).fold(
    { after: None, out: [] },
    |acc: { after: Option<Lowering>, out: List<LoweredValue> }, i: Int|
      match members.at(i) {
        None -> acc,
        Some(m) -> match starts.at(i) {
          None -> acc,
          Some(o) -> {
            let from = match acc.after { Some(a) -> exit_block(o.st, a), None -> o.st };
            let b = lowered(o.cx, from, m.body, true);
            { after: Some(b.st), out: acc.out.push(b) }
          },
        },
      },
  );
  folded(match members.at(0) { Some(m) -> m.cx.setting.ctors, None -> no_ctors() }, {
    ..tail_group_root(members, bodies.out),
    statics: match bodies.after { Some(a) -> a.statics, None -> [] },
  })
}

/// An operand that reads a slot where it stands: what the slot holds, noted read only once the
/// operation's operands are all made, where the operation reads it.
type SlotRead = { slot: Int, at: Span, arg: Arg }

/// An operation's operands lowered so far, and the slots they read where they stand.
type Operands = { st: Lowering, args: List<Arg>, read: List<SlotRead> }

/// The operand `x` where it reads a slot where it stands, its value taken as `slot_taken` takes it,
/// but a view kept as it is where `views` says the operation hands it on as its callee holds it.
fn slot_read(
  cx: Context,
  state: Lowering,
  x: Code,
  views: Bool,
) -> Option<{ st: Lowering, read: SlotRead }> / {abort.raise} =
  match x.node {
    CodeVar(v) -> match state.env.get(v.slot) {
      Some(a) -> {
        let o = if views && operand_representation(a) == AsListView { { st: state, arg: a } }
        else { slot_taken(cx, state, v.name, v.slot, a, x.ty, x.span) };
        Some({ st: o.st, read: { slot: v.slot, at: x.span, arg: o.arg } })
      },
      None -> None,
    },
    _ -> None,
  }

/// `a`, read out of slot `slot`, bound as `name`, at `at`: a view as its list, then read as
/// `typed_slot_read` reads a slot; a label's read is the lowering's own, of the `Int` its binder takes;
/// a continuation's the function value that resumes it (`continuation_closure`).
fn slot_taken(
  cx: Context,
  state: Lowering,
  name: Bytes,
  slot: Int,
  a: Arg,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let l = list_of_view({ st: state, arg: a }, at);
  if is_label_binder(name) { l }
  else if resumed(type_of(a)) != None { continuation_closure(cx, l.st, slot, a, at) }
  else { typed_slot_read(cx, l, name, slot, ty, at) }
}

/// The function value a call applies, lowered from `func`: a continuation as the runtime holds it,
/// which the call resumes through its uniform entry; any other as a value.
fn callee_lowered(cx: Context, state: Lowering, func: Code) -> LoweredValue / {abort.raise} =
  match func.node {
    CodeVar(v) -> match state.env.get(v.slot) {
      Some(a) -> if resumed(type_of(a)) != None {
        { st: note_slot_read(cx, state, read_note(), v.slot, func.span), arg: a }
      } else { lowered(cx, state, func, false) },
      None -> lowered(cx, state, func, false),
    },
    _ -> lowered(cx, state, func, false),
  }

/// The slot `c` reads and the view of a list it holds, where `c` reads a slot holding one.
fn list_view_slot(state: Lowering, c: Code) -> Option<{ slot: Int, arg: Arg }> =
  match c.node {
    CodeVar(v) -> match state.env.get(v.slot) {
      Some(a) -> if operand_representation(a) == AsListView { Some({ slot: v.slot, arg: a }) }
      else { None },
      None -> None,
    },
    _ -> None,
  }

/// `st` noting, where `cx` observes, each slot `read` reads.
fn reads_noted(cx: Context, state: Lowering, read: List<SlotRead>) -> Lowering =
  read.fold(state, |s: Lowering, r: SlotRead| note_slot_read(cx, s, read_note(), r.slot, r.at))

/// The one recursion over a body: each node lowered after its parts, which are lowered here or in a
/// fold over them, so the recursion descends through the node and nothing else.
fn lowered(cx: Context, state: Lowering, c: Code, tail: Bool) -> LoweredValue / {abort.raise} =
  match c.node {
    CodeLiteral(l) -> literal(cx, state, l, c.span),
    CodeVar(v) -> match state.env.get(v.slot) {
      Some(a) ->
        slot_taken(
          cx,
          note_slot_read(cx, state, read_note(), v.slot, c.span),
          v.name,
          v.slot,
          a,
          c.ty,
          c.span,
        ),
      None -> unreachable(b"a slot nothing bound: ".concat(v.name)),
    },
    NDef(_) -> global_value(cx, state, c),
    NCtor(_) -> global_value(cx, state, c),
    NBuiltin(_) -> global_value(cx, state, c),
    CodeKnownLambda(k) -> known_lambda_read(cx, state, k, c.span),
    CodeUnary(u) -> unary(cx, lowered(cx, state, u.operand, false), u.op, c.span),
    CodeBinary(b) -> if b.op == b"and" || b.op == b"or" {
      let l = represented_as(lowered(cx, state, b.lhs, false), AsBool, b.lhs.span);
      short_circuit(cx, l, lowered(cx, enter_block(l.st), b.rhs, tail), b.op == b"and", c.span)
    } else {
      match compared_side(cx, b.op, b.lhs, b.rhs) {
        Some(true) -> {
          let args = match b.lhs.node {
            CodeApply(ca) -> {
              let wanted = compared_args(cx, b.lhs);
              ca.args.fold(
                { st: state, args: [], at: 0 },
                |acc: { st: Lowering, args: List<Option<Arg>>, at: Int }, x: Code|
                  if wanted.at(acc.at) != Some(true) {
                    { ..acc, args: acc.args.push(None), at: acc.at + 1 }
                  } else {
                    let o = lowered(cx, acc.st, x, false);
                    { st: o.st, args: acc.args.push(Some(o.arg)), at: acc.at + 1 }
                  },
              )
            },
            _ -> { st: state, args: [], at: 0 },
          };
          compared(cx, lowered(cx, args.st, b.rhs, false), b.lhs, args.args, b.op, c.span)
        },
        Some(false) -> {
          let v = lowered(cx, state, b.lhs, false);
          let args = match b.rhs.node {
            CodeApply(ca) -> {
              let wanted = compared_args(cx, b.rhs);
              ca.args.fold(
                { st: v.st, args: [], at: 0 },
                |acc: { st: Lowering, args: List<Option<Arg>>, at: Int }, x: Code|
                  if wanted.at(acc.at) != Some(true) {
                    { ..acc, args: acc.args.push(None), at: acc.at + 1 }
                  } else {
                    let o = lowered(cx, acc.st, x, false);
                    { st: o.st, args: acc.args.push(Some(o.arg)), at: acc.at + 1 }
                  },
              )
            },
            _ -> { st: v.st, args: [], at: 0 },
          };
          compared(cx, { st: args.st, arg: v.arg }, b.rhs, args.args, b.op, c.span)
        },
        None -> match constant(cx, c) {
          Some(a) -> { st: state, arg: a },
          None -> {
            let lhs = match slot_read(cx, state, b.lhs, false) {
              Some(r) -> { st: r.st, args: [r.read.arg], read: [r.read] },
              None -> {
                let o = lowered(cx, state, b.lhs, false);
                { st: o.st, args: [o.arg], read: [] }
              },
            };
            let ops = match operand(cx, b.op, b.rhs) {
              Some(a) -> { ..lhs, args: lhs.args.push(a) },
              None -> match slot_read(cx, lhs.st, b.rhs, false) {
                Some(r) ->
                  { st: r.st, args: lhs.args.push(r.read.arg), read: lhs.read.push(r.read) },
                None -> {
                  let o = lowered(cx, lhs.st, b.rhs, false);
                  { ..lhs, st: o.st, args: lhs.args.push(o.arg) }
                },
              },
            };
            let s = reads_noted(cx, ops.st, ops.read);
            binary(
              cx,
              { st: s, arg: ops.args.get(0) },
              { st: s, arg: ops.args.get(1) },
              b.op,
              c.span,
            )
          },
        },
      }
    },
    CodeBlock(bl) -> {
      let after = bl.stmts.fold(state, |acc: Lowering, s: CodeStmt|
        match s {
          CodeLet(l) -> {
            let v = lowered(cx, acc, l.value, false);
            { ..v.st, env: v.st.env.insert(l.slot, v.arg) }
          },
          CodeLetDestructure(l) -> {
            let missing = match l.value.node {
              CodeApply(a) -> is_let_mismatch_call(a.func),
              _ -> false,
            };
            let value = match l.value.node {
              CodeApply(a) -> if missing {
                match a.args.at(a.args.len() - 1) { Some(x) -> x, None -> l.value }
              } else { l.value },
              _ -> l.value,
            };
            let v = lowered(cx, acc, value, false);
            if !missing { let_bound(cx, v, l.pat, l.span) }
            else { let_with_mismatch(cx, v, l.value, l.pat, l.span) }
          },
          CodeDo(d) -> lowered(cx, acc, d.code, false).st,
        });
      match bl.tail {
        Some(t) -> lowered(cx, after, t, tail),
        None -> literal(cx, after, LiteralUnit, c.span),
      }
    },
    CodeIf(i) -> {
      // A capture, or a value of an erased type, is a word, which a branch cannot test as it is.
      let cond = represented_as(lowered(cx, state, i.cond, false), AsBool, i.cond.span);
      let then = lowered(cx, enter_block(cond.st), i.then_branch, tail);
      let otherwise = lowered(cx, exit_block(enter_block(cond.st), then.st), i.else_branch, tail);
      joined(cx, cond, then, otherwise, tail, c.span)
    },
    CodeApply(a) if is_cleanup_call(a.func) -> within_cleanup_scope(cx, state, a.args, c.span),
    CodeApply(a) -> match target(cx, a.func, a.args) {
      None ->
        unreachable(
          b"a callee the lowering does not resolve: ".concat(match read_name(a.func) {
            Some(n) -> n,
            None -> b"",
          }),
        ),
      Some(ToInlinedBody(how)) -> {
        let run = inlined_argument(how);
        let counted = range_argument(how);
        let args = a.args.fold(
          { st: state, args: [], at: 0, range: None },
          |acc: { st: Lowering, args: List<Option<Arg>>, at: Int, range: Option<{ lo: Arg, hi: Arg }> }, x: Code|
            if run == Some(acc.at) { { ..acc, args: acc.args.push(None), at: acc.at + 1 } }
            else if counted == Some(acc.at) {
              let ends = match x.node {
                CodeApply(r) ->
                  r.args.fold(
                    { st: acc.st, ends: [] },
                    |e: { st: Lowering, ends: List<Arg> }, y: Code| {
                      let o = lowered(cx, e.st, y, false);
                      { st: o.st, ends: e.ends.push(o.arg) }
                    },
                  ),
                _ -> { st: acc.st, ends: [] },
              };
              {
                st: ends.st,
                args: acc.args.push(None),
                at: acc.at + 1,
                range: match ends.ends { [lo, hi] -> Some({ lo: lo, hi: hi }), _ -> None },
              }
            } else {
              let o = lowered(cx, acc.st, x, false);
              { ..acc, st: o.st, args: acc.args.push(Some(o.arg)), at: acc.at + 1 }
            },
        );
        let lowered_args = { args: args.args, range: args.range };
        let before = note_step_captures(cx, args.st, a.args, how);
        let e = enter_inlined(cx, before, a.func, a.args, lowered_args, how, c.span);
        let no_lambda = b"a body run in place that is no lambda";
        let body = match run {
          None -> match a.func.node {
            CodeKnownLambda(k) -> lowered(e.cx, e.st, k.lambda.body, false),
            _ -> unreachable(no_lambda),
          },
          Some(n) -> match a.args.at(n) {
            Some(x) -> match x.node {
              CodeLambda(l) -> lowered(e.cx, e.st, l.body, false),
              CodeKnownLambda(k) -> if k.in_place { lowered(e.cx, e.st, k.lambda.body, false) }
              else { known_run(e.cx, e.st, k, a.row, x.span) },
              NDef(_) -> named_function_call(e.cx, e.st, x, how),
              _ -> unreachable(no_lambda),
            },
            None -> unreachable(no_lambda),
          },
        };
        exit_inlined(cx, before, e, body, lowered_args, c.span)
      },
      Some(ToValue) -> {
        let f = callee_lowered(cx, state, a.func);
        let args = a.args.fold({ st: f.st, args: [], read: [] }, |acc: Operands, x: Code|
          match slot_read(cx, acc.st, x, false) {
            Some(r) -> { st: r.st, args: acc.args.push(r.read.arg), read: acc.read.push(r.read) },
            None -> {
              let o = lowered(cx, acc.st, x, false);
              { ..acc, st: o.st, args: acc.args.push(o.arg) }
            },
          });
        let called = reads_noted(cx, args.st, args.read);
        match a.func.node {
          CodeKnownLambda(k) -> known_applied(cx, called, k, f.arg, args.args, a.row, tail, c.span),
          _ -> applied(cx, called, f.arg, args.args, a.row, tail, c.span),
        }
      },
      Some(t) -> {
        // A definition's call hands a view on as the callee holds it: a restart keeps walking it.
        let views = match t { ToDef(_) -> true, _ -> false };
        let ops = a.args.fold({ st: state, args: [], read: [] }, |acc: Operands, x: Code|
          match slot_read(cx, acc.st, x, views) {
            Some(r) -> { st: r.st, args: acc.args.push(r.read.arg), read: acc.read.push(r.read) },
            None -> {
              let o = lowered(cx, acc.st, x, false);
              { ..acc, st: o.st, args: acc.args.push(o.arg) }
            },
          });
        let args = { st: reads_noted(cx, ops.st, ops.read), args: ops.args };
        match t {
          ToCtor(name) -> constructed(cx, args.st, name, args.args, c.ty, c.span),
          ToBuiltin(name) -> called_builtin(cx, args.st, name, args.args, a.func, c.span),
          ToDef(full) -> called(cx, args.st, full, a.func, a.args, args.args, tail, c.span),
          _ -> unreachable(b"a target taken above"),
        }
      },
    },
    CodeList(l) -> {
      let ops = l.items.fold({ st: state, args: [], read: [] }, |acc: Operands, x: Code|
        match slot_read(cx, acc.st, x, false) {
          Some(r) -> { st: r.st, args: acc.args.push(r.read.arg), read: acc.read.push(r.read) },
          None -> {
            let o = lowered(cx, acc.st, x, false);
            { ..acc, st: o.st, args: acc.args.push(o.arg) }
          },
        });
      let items = { st: reads_noted(cx, ops.st, ops.read), args: ops.args };
      list_literal(cx, items.st, items.args, c.ty, c.span)
    },
    CodeRecord(r) -> {
      let fs = r.fields.fold({ st: state, args: [], read: [] }, |acc: Operands, f: CodeField|
        match slot_read(cx, acc.st, f.value, false) {
          Some(r) -> { st: r.st, args: acc.args.push(r.read.arg), read: acc.read.push(r.read) },
          None -> {
            let o = lowered(cx, acc.st, f.value, false);
            { ..acc, st: o.st, args: acc.args.push(o.arg) }
          },
        });
      record_literal(
        cx,
        reads_noted(cx, fs.st, fs.read),
        zip(r.fields, fs.args).map(|x: { first: CodeField, second: Arg }|
          { name: x.first.name, arg: x.second }),
        c.ty,
        c.span,
      )
    },
    CodeFieldRead(f) -> if !reads_column(cx, f.base, f.field) {
      field(cx, lowered(cx, state, f.base, false), f.field, c.span)
    } else {
      let args = match f.base.node {
        CodeApply(ca) ->
          ca.args.fold(
            { st: state, args: [] },
            |acc: { st: Lowering, args: List<Arg> }, x: Code| {
              let o = lowered(cx, acc.st, x, false);
              { st: o.st, args: acc.args.push(o.arg) }
            },
          ),
        _ -> { st: state, args: [] },
      };
      column_read(cx, args.st, args.args, f.base, f.field, c.span)
    },
    CodeUpdate(u) -> {
      let base = match slot_read(cx, state, u.base, false) {
        Some(r) -> { st: r.st, args: [r.read.arg], read: [r.read] },
        None -> {
          let o = lowered(cx, state, u.base, false);
          { st: o.st, args: [o.arg], read: [] }
        },
      };
      let ops = u.sets.fold(base, |acc: Operands, f: CodeField|
        match slot_read(cx, acc.st, f.value, false) {
          Some(r) -> { st: r.st, args: acc.args.push(r.read.arg), read: acc.read.push(r.read) },
          None -> {
            let o = lowered(cx, acc.st, f.value, false);
            { ..acc, st: o.st, args: acc.args.push(o.arg) }
          },
        });
      match ops.args {
        [b, ..set] ->
          record_update(
            cx,
            reads_noted(cx, ops.st, ops.read),
            b,
            u.copies,
            zip(u.sets, set).map(|x: { first: CodeField, second: Arg }|
              { name: x.first.name, arg: x.second }),
            c.ty,
            c.span,
          ),
        [] -> unreachable(b"an update lowered without its base"),
      }
    },
    CodeMatch(m) -> {
      // A view is matched as it is: its arms' list patterns read the list it views in place.
      let s = match list_view_slot(state, m.scrutinee) {
        Some(v) ->
          { st: note_slot_read(cx, state, read_note(), v.slot, m.scrutinee.span), arg: v.arg },
        None -> lowered(cx, state, m.scrutinee, false),
      };
      let arms = m.arms.fold(
        { after: s.st, out: [] },
        |acc: { after: Lowering, out: List<LoweredArm> }, arm: CodeArm| {
          let o = arm_start(cx, exit_block(enter_block(s.st), acc.after), s.arg, arm);
          match arm.guard {
            None -> {
              let b = lowered(cx, o, arm.body, tail);
              { after: b.st, out: acc.out.push({ arm: arm, guard: None, body: b }) }
            },
            Some(g) -> {
              let gl = represented_as(lowered(cx, o, g, false), AsBool, g.span);
              let b = lowered(cx, enter_block(gl.st), arm.body, tail);
              { after: b.st, out: acc.out.push({ arm: arm, guard: Some(gl), body: b }) }
            },
          }
        },
      );
      match_joined(cx, s.st, s.arg, arms.out, arms.after, tail, c.span)
    },
    CodePerform(p) -> {
      let lb = match p.label {
        Some(lc) -> {
          let o = lowered(cx, state, lc, false);
          { st: o.st, arg: Some(o.arg) }
        },
        None -> { st: state, arg: None },
      };
      let spawns = p.effect == b"task" && p.op == b"spawn";
      let args = p.args.fold(
        { st: lb.st, args: [] },
        |acc: { st: Lowering, args: List<Arg> }, x: Code| {
          let o = if spawns { spawned(cx, acc.st, x) } else { lowered(cx, acc.st, x, false) };
          { st: o.st, args: acc.args.push(o.arg) }
        },
      );
      let op = { effect: p.effect, op: p.op, resource: p.resource };
      match scheduler_perform_call(cx, op, p.args, args.args, c.ty, c.span) {
        // The crossings are the scheduler's, so one of its own performs crossed would call itself.
        Some(x) -> if module_of(cx.key) == scheduler_module() {
          unreachable(
            b"a perform the scheduler writes at a type other than `Kept`: ".concat(x.name),
          )
        } else { called_at_types(cx, args.st, x.name, x.types, x.rows, p.args, args.args, c.span) },
        None -> performed(cx, args.st, op, lb.arg, p.label, args.args, c.ty, c.span),
      }
    },
    CodeLabel(n) -> label(cx, state, n, c.span),
    CodeLambda(l) -> {
      let frame = {
        params: l.params,
        size: l.size,
        captures: l.captures,
        resumes: None,
        body: l.body,
        ty: l.ty,
        words: words_of(cx, l.row),
        held: no_captured_evidence(),
      };
      let o = lambda_body_start(cx, state, frame, l.at);
      closure(cx, state, lowered(o.cx, o.st, l.body, true), frame, Metered, l.at)
    },
    CodeSimulate(x) -> {
      let frame = {
        params: 0,
        size: x.size,
        captures: x.captures,
        resumes: None,
        body: x.body,
        ty: { params: [], kept: [], once: false, ret: x.body.ty, effects: row_empty() },
        words: words_of(cx, x.row),
        held: no_captured_evidence(),
      };
      let o = lambda_body_start(cx, state, frame, x.at);
      let k = closure(cx, state, lowered(o.cx, o.st, x.body, true), frame, Metered, x.at);
      simulate_called(cx, k.st, k.arg, x.row, c.span)
    },
    CodeParallel(pr) -> {
      let bs = pr.branches.fold(
        { st: state, args: [] },
        |acc: { st: Lowering, args: List<Arg> }, x: Code| {
          let o = lowered(cx, acc.st, x, false);
          { st: o.st, args: acc.args.push(o.arg) }
        },
      );
      parallel_block(cx, bs.st, bs.args, performed_by(pr.branches), c.span)
    },
    CodeHandle(h) -> {
      let plan = handle_plan(cx, state, h, c.span);
      let clauses = h.clauses.fold(
        { st: plan.st, out: [] },
        |acc: { st: Lowering, out: List<Arg> }, cl: CodeClause| {
          let held = clause_captured_evidence(cx, acc.st, plan, cl.row, cl.at);
          let frame = clause_frame(cl, held.held);
          let o = lambda_body_start(cx, held.st, frame, cl.at);
          let k = stack_closure(
            plan,
            closure(cx, held.st, lowered(o.cx, o.st, cl.body, true), frame, Metered, cl.at),
          );
          { st: k.st, out: acc.out.push(k.arg) }
        },
      );
      let ret = match h.ret {
        Some(r) -> {
          let held = clause_captured_evidence(cx, clauses.st, plan, r.row, r.at);
          let frame = ret_frame(r, held.held);
          let o = lambda_body_start(cx, held.st, frame, r.at);
          let k = stack_closure(
            plan,
            closure(cx, held.st, lowered(o.cx, o.st, r.body, true), frame, Metered, r.at),
          );
          { st: k.st, arg: Some(k.arg) }
        },
        None -> { st: clauses.st, arg: None },
      };
      let body = if detaches(h.clauses) {
        // The body runs on a stack of its own, in a closure holding the `handle`'s objects, which
        // its landing ends.
        let objects = instance_objects(cx, ret.st, h, plan, c.span);
        let answer = c.ty;
        let frame = body_frame(cx, h, plan, objects.words, answer);
        let at = detached_closure_span(c.span);
        let o = lambda_body_start(cx, objects.st, frame, at);
        let inner = lowered(o.cx, enter_block(o.st), h.body, false);
        closure(
          cx,
          objects.st,
          detached_landing(o.cx, o.st, inner, h, plan, answer, at),
          frame,
          Metered,
          at,
        )
      } else {
        // A failure inside a `handle`'s body lands in it, past nothing the run around holds.
        let e = enter_handle(cx, { ..enter_block(ret.st), unwinding: [] }, h, plan, c.span);
        lowered(e.cx, e.st, h.body, false)
      };
      let out = handle_assembled(cx, ret.st, body, clauses.out, ret.arg, h, plan, c.span);
      { ..out, st: { ..out.st, unwinding: ret.st.unwinding } }
    },
  }
