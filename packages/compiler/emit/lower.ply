//! A root's `Code` lowered to the typed form. Each node is typed from its parts as it is lowered, so
//! a type belongs to its node and not to its place in the text; each value is held as its type
//! says. This module holds the one recursion over a body; each construct's family lowers it from its
//! parts (`emit.lower.*`), and where a construct holds code, says what state each part is lowered
//! in and assembles the construct from the parts lowered.

import emit.code (Code, NLit, NVar, NUnary, NBinary, NApp, NIf, NBlock, NList, NRecord, NMatch,
                  NPerform, NLabel, NLambda, NSimulate, NParallel, NHandle, NField, NUpdate, NKnown,
                  CodeStmt, CLet, CLetPat, CDo, CodeField, CodeArm, CodeClause)
import syntax.parsing (Span, read_site)
import syntax.patterns (LUnit)
import syntax.exprs (detached_at)
import emit.typing (unknown_type)
import emit.tir (Var, Arg, AZero, RWord, RBool, RSlice, Return, Fn, Rooted, Declined, Spine,
                 Calling, falls_through, rep_of_arg)
import emit.lower.setting (Setting, Root)
import emit.keys (root_name)
import emit.lower.base (Context, Lowering, Lowered, Target, ToCtor, ToBuiltin, ToDef, ToValue,
                        ToInPlace, Armed, ClauseMade, GroupMember, Opened, started, refuse, opened,
                        continued, joined, short_circuit, handed, read_noted, read_note, type_at,
                        taken_as, unviewed)
import emit.lower.data (constructed, recorded, field, updated)
import emit.lower.scalars (literal, constant, operand, unary, binary)
import emit.lower.containers (builtin, listed, columned, column_read)
import emit.lower.matching (arm_opened, closed, let_bound, compared_side, compared_args, compared)
import emit.lower.calling (convention, params_held, target, global, builtin_lambda, known, called,
                           applied, entered, left, lambda_opened, closure, group_opened, grouped,
                           known_body, step_captured, context_of)
import emit.lower.handling (performed, label, clause_frame, ret_frame, body_frame, handled,
                            branched, simulated)

/// Root `r` of `setting`, whose body lowers to `code`, lowered as a build lowers it: its body after
/// `known_body`, so a slot known to hold a lambda reads as that lambda.
pub fn root_lowered(setting: Setting, r: Root, code: Code) -> Result<Fn, Declined> / {abort.raise} = {
  let body = known_body(root_name(r.key), r.params, code);
  lowered_fn(context_of(setting, r, body), body)
}

/// Root `r` lowered as `root_lowered` lowers it, noting where each slot is read and where each
/// closure captures one, for `emit.moves` to read its moves off.
pub fn root_observed(
  setting: Setting,
  r: Root,
  code: Code,
) -> Result<Fn, Declined> / {abort.raise} = {
  let body = known_body(root_name(r.key), r.params, code);
  lowered_fn({ ..context_of(setting, r, body), observing: true }, body)
}

/// The roots of one tail group of `setting`, each with the `Code` its body lowers to, lowered as a
/// build lowers them: as one root, keyed as its first member.
pub fn group_lowered(
  setting: Setting,
  roots: List<{ root: Root, code: Code }>,
) -> Result<Fn, Declined> / {abort.raise} =
  lowered_group(
    roots.map(|m: { root: Root, code: Code }| {
      let body = known_body(root_name(m.root.key), m.root.params, m.code);
      { cx: context_of(setting, m.root, body), body: body }
    }),
  )

/// The root lowered, or why its body is outside what the lowering covers.
pub fn lowered_fn(cx: Context, body: Code) -> Result<Fn, Declined> / {abort.raise} = {
  let conv = convention(cx);
  let held = params_held(cx);
  let params = range(0, conv.reps.len()).map(|i: Int|
    {
      id: i,
      ty: match cx.types.at(i) { Some(t) -> t, None -> unknown_type() },
      rep: match held.at(i) { Some(r) -> r, None -> conv.reps.get(i) },
    });
  let out = lowered(cx, started(params), body, true);
  let answered = if falls_through(out.st.insts) { handed(out, conv.answer, body.span) }
  else { out };
  match answered.st.refused {
    Some(no) -> Err(no),
    None ->
      Ok({
        key: cx.key,
        kind: Rooted,
        params: params,
        conv: conv,
        body: if falls_through(answered.st.insts) { answered.st.insts.push(Return(answered.arg)) }
        else { answered.st.insts },
        lambdas: answered.st.lambdas,
        base: cx.base,
        members: [],
        links: answered.st.links,
        statics: [],
      }),
  }
}

/// A tail group's members lowered as one root, or why the form does not cover it.
pub fn lowered_group(members: List<GroupMember>) -> Result<Fn, Declined> / {abort.raise} = {
  let starts = group_opened(members);
  let bodies = range(0, members.len()).fold(
    { after: None, out: [] },
    |acc: { after: Option<Lowering>, out: List<Lowered> }, i: Int|
      match members.at(i) {
        None -> acc,
        Some(m) -> match starts.at(i) {
          None -> acc,
          Some(o) -> {
            let from = match acc.after { Some(a) -> continued(o.st, a), None -> o.st };
            let b = lowered(o.cx, from, m.body, true);
            { after: Some(b.st), out: acc.out.push(b) }
          },
        },
      },
  );
  grouped(members, bodies.out)
}

/// An operand that reads a slot where it stands: what the slot holds, noted read only once the
/// operation's operands are all made, where the operation reads it.
type SlotRead = { slot: Int, at: Span, arg: Arg }

/// An operation's operands lowered so far, and the slots they read where they stand.
type Operands = { st: Lowering, args: List<Arg>, read: List<SlotRead> }

/// The operand `x` where it reads a slot where it stands, its value taken as `slot_taken` takes it,
/// but a view kept as it is where `views` says the operation hands it on as its callee holds it.
fn slot_read(
  cx: Context,
  st: Lowering,
  x: Code,
  views: Bool,
) -> Option<{ st: Lowering, read: SlotRead }> =
  match x.node {
    NVar(v) -> match v.slot {
      Some(k) -> match st.env.get(k) {
        Some(a) -> {
          let o = if views && rep_of_arg(a) == RSlice { { st: st, arg: a } }
          else { slot_taken(cx, st, a, x.span) };
          Some({ st: o.st, read: { slot: k, at: x.span, arg: o.arg } })
        },
        None -> None,
      },
      None -> None,
    },
    _ -> None,
  }

/// `a`, read out of a slot at `at`: a view as its list, and taken at the type the checker filed for
/// that read where it filed one: a lambda's capture, which a body another root lends the lambda to
/// holds as an untyped word.
fn slot_taken(cx: Context, st: Lowering, a: Arg, at: Span) -> Lowered = {
  let l = unviewed({ st: st, arg: a }, at);
  match type_at(cx, read_site(at)) { Some(t) -> taken_as(cx, l, t, at), None -> l }
}

/// The slot `c` reads and the view of a list it holds, where `c` reads a slot holding one.
fn viewed_slot(st: Lowering, c: Code) -> Option<{ slot: Int, arg: Arg }> =
  match c.node {
    NVar(v) -> match v.slot {
      Some(s) -> match st.env.get(s) {
        Some(a) -> if rep_of_arg(a) == RSlice { Some({ slot: s, arg: a }) } else { None },
        None -> None,
      },
      None -> None,
    },
    _ -> None,
  }

/// `st` noting, where `cx` observes, each slot `read` reads.
fn reads_noted(cx: Context, st: Lowering, read: List<SlotRead>) -> Lowering =
  read.fold(st, |s: Lowering, r: SlotRead| read_noted(cx, s, read_note(), r.slot, r.at))

/// The one recursion over a body: each node lowered after its parts, which are lowered here or in a
/// fold over them, so the recursion descends through the node and nothing else.
fn lowered(cx: Context, st: Lowering, c: Code, tail: Bool) -> Lowered / {abort.raise} =
  if st.refused != None { { st: st, arg: AZero(RWord) } } else {
    match c.node {
      NLit(l) -> literal(cx, st, l, c.span),
      NVar(v) -> match v.slot {
        Some(s) -> match st.env.get(s) {
          Some(a) -> slot_taken(cx, read_noted(cx, st, read_note(), s, c.span), a, c.span),
          None -> refuse(st, Spine, b"a slot nothing bound: ".concat(v.name)),
        },
        None -> match builtin_lambda(cx, v.name, c.span) {
          None -> global(cx, st, v.name, c.span),
          Some(b) -> {
            let frame = { params: b.arity, size: b.arity, captures: [], resumes: false };
            let o = lambda_opened(cx, st, frame, c.span);
            let params = range(0, b.arity).fold([], |acc: List<Arg>, j: Int|
              match o.st.env.get(j) { Some(a) -> acc.push(a), None -> acc });
            closure(cx, st, builtin(o.cx, o.st, b.name, params, c.span, c.span), frame, c.span)
          },
        },
      },
      NKnown(k) -> known(cx, st, k, c.span),
      NUnary(u) -> unary(cx, lowered(cx, st, u.operand, false), u.op, c.span),
      NBinary(b) -> if b.op == b"and" || b.op == b"or" {
        let l = handed(lowered(cx, st, b.lhs, false), RBool, b.lhs.span);
        short_circuit(cx, l, lowered(cx, opened(l.st), b.rhs, tail), b.op == b"and", c.span)
      } else {
        match compared_side(cx, b.op, b.lhs, b.rhs) {
          Some(true) -> {
            let args = match b.lhs.node {
              NApp(ca) -> {
                let wanted = compared_args(cx, b.lhs);
                ca.args.fold(
                  { st: st, args: [], at: 0 },
                  |acc: { st: Lowering, args: List<Option<Arg>>, at: Int }, x: Code|
                    if wanted.at(acc.at) != Some(true) {
                      { ..acc, args: acc.args.push(None), at: acc.at + 1 }
                    } else {
                      let o = lowered(cx, acc.st, x, false);
                      { st: o.st, args: acc.args.push(Some(o.arg)), at: acc.at + 1 }
                    },
                )
              },
              _ -> { st: st, args: [], at: 0 },
            };
            compared(cx, lowered(cx, args.st, b.rhs, false), b.lhs, args.args, b.op, c.span)
          },
          Some(false) -> {
            let v = lowered(cx, st, b.lhs, false);
            let args = match b.rhs.node {
              NApp(ca) -> {
                let wanted = compared_args(cx, b.rhs);
                ca.args.fold(
                  { st: v.st, args: [], at: 0 },
                  |acc: { st: Lowering, args: List<Option<Arg>>, at: Int }, x: Code|
                    if wanted.at(acc.at) != Some(true) {
                      { ..acc, args: acc.args.push(None), at: acc.at + 1 }
                    } else {
                      let o = lowered(cx, acc.st, x, false);
                      { st: o.st, args: acc.args.push(Some(o.arg)), at: acc.at + 1 }
                    },
                )
              },
              _ -> { st: v.st, args: [], at: 0 },
            };
            compared(cx, { st: args.st, arg: v.arg }, b.rhs, args.args, b.op, c.span)
          },
          None -> match constant(cx, c) {
            Some(a) -> { st: st, arg: a },
            None -> {
              let lhs = match slot_read(cx, st, b.lhs, false) {
                Some(r) -> { st: r.st, args: [r.read.arg], read: [r.read] },
                None -> {
                  let o = lowered(cx, st, b.lhs, false);
                  { st: o.st, args: [o.arg], read: [] }
                },
              };
              let ops = match operand(cx, b.op, b.rhs) {
                Some(a) -> { ..lhs, args: lhs.args.push(a) },
                None -> match slot_read(cx, lhs.st, b.rhs, false) {
                  Some(r) ->
                    { st: r.st, args: lhs.args.push(r.read.arg), read: lhs.read.push(r.read) },
                  None -> {
                    let o = lowered(cx, lhs.st, b.rhs, false);
                    { ..lhs, st: o.st, args: lhs.args.push(o.arg) }
                  },
                },
              };
              let s = reads_noted(cx, ops.st, ops.read);
              binary(
                cx,
                { st: s, arg: ops.args.get(0) },
                { st: s, arg: ops.args.get(1) },
                b.op,
                c.span,
              )
            },
          },
        }
      },
      NBlock(bl) -> {
        let after = bl.stmts.fold(st, |acc: Lowering, s: CodeStmt|
          match s {
            CLet(l) -> {
              let v = lowered(cx, acc, l.value, false);
              { ..v.st, env: v.st.env.insert(l.slot, v.arg) }
            },
            CLetPat(l) -> let_bound(cx, lowered(cx, acc, l.value, false), l.pat, l.span),
            CDo(d) -> lowered(cx, acc, d.code, false).st,
          });
        match bl.tail {
          Some(t) -> lowered(cx, after, t, tail),
          None -> literal(cx, after, LUnit, c.span),
        }
      },
      NIf(i) -> {
        // A capture, or a value of an erased type, is a word, which a branch cannot test as it is.
        let cond = handed(lowered(cx, st, i.cond, false), RBool, i.cond.span);
        let then = lowered(cx, opened(cond.st), i.then_branch, tail);
        let otherwise = lowered(cx, continued(opened(cond.st), then.st), i.else_branch, tail);
        joined(cx, cond, then, otherwise, tail, c.span)
      },
      NApp(a) -> match target(cx, a.func, a.args) {
        None -> refuse(st, Calling, b"a callee the lowering does not resolve"),
        Some(ToInPlace(which)) -> {
          let args = a.args.fold(
            { st: st, args: [], at: 0 },
            |acc: { st: Lowering, args: List<Option<Arg>>, at: Int }, x: Code|
              if which == Some(acc.at) { { ..acc, args: acc.args.push(None), at: acc.at + 1 } }
              else {
                let o = lowered(cx, acc.st, x, false);
                { st: o.st, args: acc.args.push(Some(o.arg)), at: acc.at + 1 }
              },
          );
          let before = step_captured(cx, args.st, a.args, which);
          let e = entered(cx, before, a.func, a.args, args.args, which, c.span);
          let body = match which {
            None -> match a.func.node {
              NKnown(k) -> lowered(e.cx, e.st, k.lambda.body, false),
              _ -> refuse(e.st, Calling, b"a body run in place that is no lambda"),
            },
            Some(n) ->
              a.args.fold(
                { at: 0, out: refuse(e.st, Calling, b"a step that is no lambda") },
                |acc: { at: Int, out: Lowered }, x: Code|
                  {
                    at: acc.at + 1,
                    out: if acc.at != n { acc.out } else {
                      match x.node {
                        NLambda(l) -> lowered(e.cx, e.st, l.body, false),
                        _ -> acc.out,
                      }
                    },
                  },
              ).out,
          };
          left(cx, before, e, body, args.args, which, c.span)
        },
        Some(ToValue) -> {
          let f = lowered(cx, st, a.func, false);
          let args = a.args.fold({ st: f.st, args: [], read: [] }, |acc: Operands, x: Code|
            match slot_read(cx, acc.st, x, false) {
              Some(r) -> { st: r.st, args: acc.args.push(r.read.arg), read: acc.read.push(r.read) },
              None -> {
                let o = lowered(cx, acc.st, x, false);
                { ..acc, st: o.st, args: acc.args.push(o.arg) }
              },
            });
          applied(cx, reads_noted(cx, args.st, args.read), f.arg, args.args, tail, c.span)
        },
        Some(t) -> {
          // A definition's call hands a view on as the callee holds it: a restart keeps walking it.
          let views = match t { ToDef(_) -> true, _ -> false };
          let ops = a.args.fold({ st: st, args: [], read: [] }, |acc: Operands, x: Code|
            match slot_read(cx, acc.st, x, views) {
              Some(r) -> { st: r.st, args: acc.args.push(r.read.arg), read: acc.read.push(r.read) },
              None -> {
                let o = lowered(cx, acc.st, x, false);
                { ..acc, st: o.st, args: acc.args.push(o.arg) }
              },
            });
          let args = { st: reads_noted(cx, ops.st, ops.read), args: ops.args };
          match t {
            ToCtor(name) -> constructed(cx, args.st, name, args.args, a.func.span, c.span),
            ToBuiltin(name) -> builtin(cx, args.st, name, args.args, a.func.span, c.span),
            ToDef(full) -> called(cx, args.st, full, a.func, a.args, args.args, tail, c.span),
            _ -> refuse(args.st, Spine, b"a target taken above"),
          }
        },
      },
      NList(l) -> {
        let ops = l.items.fold({ st: st, args: [], read: [] }, |acc: Operands, x: Code|
          match slot_read(cx, acc.st, x, false) {
            Some(r) -> { st: r.st, args: acc.args.push(r.read.arg), read: acc.read.push(r.read) },
            None -> {
              let o = lowered(cx, acc.st, x, false);
              { ..acc, st: o.st, args: acc.args.push(o.arg) }
            },
          });
        let items = { st: reads_noted(cx, ops.st, ops.read), args: ops.args };
        listed(cx, items.st, items.args, c.span)
      },
      NRecord(r) -> {
        let fs = r.fields.fold({ st: st, args: [], read: [] }, |acc: Operands, f: CodeField|
          match slot_read(cx, acc.st, f.value, false) {
            Some(r) -> { st: r.st, args: acc.args.push(r.read.arg), read: acc.read.push(r.read) },
            None -> {
              let o = lowered(cx, acc.st, f.value, false);
              { ..acc, st: o.st, args: acc.args.push(o.arg) }
            },
          });
        recorded(
          cx,
          reads_noted(cx, fs.st, fs.read),
          range(0, r.fields.len()).map(|i: Int|
            { name: r.fields.get(i).name, arg: fs.args.get(i) }),
          c.span,
        )
      },
      NField(f) -> if !columned(cx, f.base, f.field) {
        field(cx, lowered(cx, st, f.base, false), f.field, c.span)
      } else {
        let args = match f.base.node {
          NApp(ca) ->
            ca.args.fold({ st: st, args: [] }, |acc: { st: Lowering, args: List<Arg> }, x: Code| {
              let o = lowered(cx, acc.st, x, false);
              { st: o.st, args: acc.args.push(o.arg) }
            }),
          _ -> { st: st, args: [] },
        };
        column_read(cx, args.st, args.args, f.base, f.field, c.span)
      },
      NUpdate(u) -> {
        let base = match slot_read(cx, st, u.base, false) {
          Some(r) -> { st: r.st, args: [r.read.arg], read: [r.read] },
          None -> {
            let o = lowered(cx, st, u.base, false);
            { st: o.st, args: [o.arg], read: [] }
          },
        };
        let ops = u.sets.fold(base, |acc: Operands, f: CodeField|
          match slot_read(cx, acc.st, f.value, false) {
            Some(r) -> { st: r.st, args: acc.args.push(r.read.arg), read: acc.read.push(r.read) },
            None -> {
              let o = lowered(cx, acc.st, f.value, false);
              { ..acc, st: o.st, args: acc.args.push(o.arg) }
            },
          });
        updated(
          cx,
          reads_noted(cx, ops.st, ops.read),
          ops.args.get(0),
          u.copies,
          range(0, u.sets.len()).map(|i: Int|
            { name: u.sets.get(i).name, arg: ops.args.get(i + 1) }),
          c.span,
        )
      },
      NMatch(m) -> {
        // A view is matched as it is: its arms' list patterns read the list it views in place.
        let s = match viewed_slot(st, m.scrutinee) {
          Some(v) -> { st: read_noted(cx, st, read_note(), v.slot, m.scrutinee.span), arg: v.arg },
          None -> lowered(cx, st, m.scrutinee, false),
        };
        let arms = m.arms.fold(
          { after: s.st, out: [] },
          |acc: { after: Lowering, out: List<Armed> }, arm: CodeArm| {
            let o = arm_opened(cx, continued(opened(s.st), acc.after), s.arg, arm);
            match arm.guard {
              None -> {
                let b = lowered(cx, o, arm.body, tail);
                { after: b.st, out: acc.out.push({ arm: arm, guard: None, body: b }) }
              },
              Some(g) -> {
                let gl = handed(lowered(cx, o, g, false), RBool, g.span);
                let b = lowered(cx, opened(gl.st), arm.body, tail);
                { after: b.st, out: acc.out.push({ arm: arm, guard: Some(gl), body: b }) }
              },
            }
          },
        );
        closed(cx, s.st, s.arg, arms.out, arms.after, tail, c.span)
      },
      NPerform(p) -> {
        let lb = match p.label {
          Some(lc) -> {
            let o = lowered(cx, st, lc, false);
            { st: o.st, arg: Some(o.arg) }
          },
          None -> { st: st, arg: None },
        };
        let args = p.args.fold(
          { st: lb.st, args: [] },
          |acc: { st: Lowering, args: List<Arg> }, x: Code| {
            let o = lowered(cx, acc.st, x, false);
            { st: o.st, args: acc.args.push(o.arg) }
          },
        );
        performed(
          cx,
          args.st,
          { effect: p.effect, op: p.op, resource: p.resource },
          lb.arg,
          args.args,
          c.span,
        )
      },
      NLabel(n) -> label(cx, st, n, c.span),
      NLambda(l) -> {
        let frame = { params: l.params, size: l.size, captures: l.captures, resumes: false };
        let o = lambda_opened(cx, st, frame, l.at);
        closure(cx, st, lowered(o.cx, o.st, l.body, true), frame, l.at)
      },
      NSimulate(x) -> {
        let frame = { params: 0, size: x.size, captures: x.captures, resumes: false };
        let o = lambda_opened(cx, st, frame, x.at);
        let k = closure(cx, st, lowered(o.cx, o.st, x.body, true), frame, x.at);
        simulated(cx, k.st, k.arg, c.span)
      },
      NParallel(pr) -> {
        let bs = pr.branches.fold(
          { st: st, args: [] },
          |acc: { st: Lowering, args: List<Arg> }, x: Code| {
            let o = lowered(cx, acc.st, x, false);
            { st: o.st, args: acc.args.push(o.arg) }
          },
        );
        branched(cx, bs.st, bs.args, pr.rooted, c.span)
      },
      NHandle(h) -> {
        let clauses = h.clauses.fold(
          { st: st, out: [] },
          |acc: { st: Lowering, out: List<ClauseMade> }, cl: CodeClause| {
            let lb = match cl.label {
              Some(lc) -> {
                let o = lowered(cx, acc.st, lc, false);
                { st: o.st, arg: Some(o.arg) }
              },
              None -> { st: acc.st, arg: None },
            };
            let frame = clause_frame(cx, cl);
            let o = lambda_opened(cx, lb.st, frame, cl.at);
            let k = closure(cx, lb.st, lowered(o.cx, o.st, cl.body, true), frame, cl.at);
            { st: k.st, out: acc.out.push({ label: lb.arg, closure: k.arg }) }
          },
        );
        let ret = match h.ret {
          Some(r) -> {
            let frame = ret_frame(cx, r);
            let o = lambda_opened(cx, clauses.st, frame, r.at);
            let k = closure(cx, clauses.st, lowered(o.cx, o.st, r.body, true), frame, r.at);
            { st: k.st, arg: Some(k.arg) }
          },
          None -> { st: clauses.st, arg: None },
        };
        let body = match body_frame(cx, h) {
          Some(frame) -> {
            let at = detached_at(c.span);
            let o = lambda_opened(cx, ret.st, frame, at);
            closure(cx, ret.st, lowered(o.cx, o.st, h.body, true), frame, at)
          },
          None -> lowered(cx, opened(ret.st), h.body, false),
        };
        handled(cx, ret.st, body, clauses.out, ret.arg, h, c.span)
      },
    }
  }
