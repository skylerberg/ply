pub fn root_lowered(setting: ModuleContext, r: Root) -> Function / {abort.raise} = {
  let body = known_body(root_text(root_name(r.key)), r.params, r.code);
  lowered_fn(context_of(setting, r, body), body)
}

pub fn root_observed(setting: ModuleContext, r: Root) -> Function / {abort.raise} = {
  let body = known_body(root_text(root_name(r.key)), r.params, r.code);
  lowered_fn({ ..context_of(setting, r, body), emits_notes: true }, body)
}

pub fn group_lowered(setting: ModuleContext, roots: List<Root>) -> Function / {abort.raise} =
  lowered_group(
    roots.map(|r: Root| {
      let body = known_body(root_text(root_name(r.key)), r.params, r.code);
      { context: context_of(setting, r, body), body: body }
    }),
  )

pub type TailCall = { full: Bytes, args: List<Type> }

pub fn tail_calls(
  here: List<Definition>,
  code: Code,
  accumulator: List<TailCall>,
) -> List<TailCall> / {abort.raise} =
  match code.node {
    CodeApply(a) -> match a.function.node {
      NDefinition(d) -> if here.any(|h: Definition|
          h.root == Named(d.full) && h.arity == a.args.len()) {
        accumulator.push({ full: d.full, args: d.args })
      } else { accumulator },
      _ -> accumulator,
    },
    CodeBinary(b) -> if b.operation == b"and" || b.operation == b"or" {
      tail_calls(here, b.right_operand, accumulator)
    } else { accumulator },
    CodeIf(i) -> tail_calls(here, i.else_branch, tail_calls(here, i.then_branch, accumulator)),
    CodeBlock(b) -> match b.tail {
      Some(t) -> tail_calls(here, t, accumulator),
      None -> accumulator,
    },
    CodeMatch(m) ->
      m.arms.fold(accumulator, |a: List<TailCall>, arm: CodeArm| tail_calls(here, arm.body, a)),
    _ -> accumulator,
  }

fn stack_closure(plan: HandlePlan, k: LoweredValue) -> LoweredValue =
  match plan.instance.block { None -> stack_allocated(k), Some(_) -> k }

fn spawn_argument_lowered(
  context: Context,
  state: Lowering,
  x: Code,
) -> LoweredValue / {abort.raise} =
  match x.node {
    CodeLambda(l) -> {
      let captured_evidence = captured_evidence_for(
        context,
        state,
        words_of(context, l.effects),
        l.at,
      );
      let frame = {
        params: l.params,
        size: l.size,
        captures: l.captures,
        resumes: None,
        body: l.body,
        ty: l.ty,
        words: [],
        captured_evidence: {
          words: captured_evidence.words,
          instance: None,
          retained_values: context.retained_arguments,
        },
      };
      let o = lambda_body_start(context, captured_evidence.st, frame, l.at);
      closure(
        context,
        captured_evidence.st,
        lowered(o.context, o.st, l.body, true),
        frame,
        Metered,
        l.at,
      )
    },
    _ -> lowered(context, state, x, false),
  }

fn is_cleanup_call(function: Code) -> Bool =
  match function.node { NBuiltin(f) -> f.name == b"?unwinds", _ -> false }

fn is_let_mismatch_call(function: Code) -> Bool =
  match function.node { NBuiltin(f) -> f.name == b"?let_missing", _ -> false }

fn let_with_mismatch(
  context: Context,
  value: LoweredValue,
  written: Code,
  pattern: CodePattern,
  at: Span,
) -> Lowering / {abort.raise} = {
  let written_arguments = match written.node {
    CodeApply(a) -> a.args.take(a.args.len() - 1),
    _ -> [],
  };
  let own = written_arguments.fold(
    { st: value.st, us: [] },
    |accumulator: { st: Lowering, us: List<Unwinding> }, x: Code|
      match x.node {
        CodeVariable(v) -> match accumulator.st.env.get(v.slot) {
          Some(arg) -> {
            let u = unwound(context, accumulator.st, arg, at);
            { st: u.st, us: accumulator.us.push(u.unwound) }
          },
          None -> accumulator,
        },
        _ -> accumulator,
      },
  );
  let id = |u: Unwinding| match operand_variable(u.arg) { Some(v) -> v.id, None -> -1 };
  let mine = own.us.map(id);
  let letting = value.st.unwinding.fold(own.us, |us: List<Unwinding>, u: Unwinding|
    if mine.contains(id(u)) { us } else { us.push(u) });
  let_else(context, { ..value, st: own.st }, pattern, [
    Fail({ reason: LetMismatch, at: at, resource: letting, unwind: [] }),
  ])
}

fn within_cleanup_scope(
  context: Context,
  state: Lowering,
  args: List<Code>,
  at: Span,
) -> LoweredValue / {abort.raise} =
  match args.at(args.len() - 1) {
    None -> unreachable(b"a cleanup scope has no body expression"),
    Some(body) -> {
      let lowered_arguments = args.fold(
        { st: state, unwound: [], at: 0 },
        |accumulator: { st: Lowering, unwound: List<Unwinding>, at: Int }, x: Code|
          if accumulator.at == args.len() - 1 { accumulator } else {
            let o = lowered(context, accumulator.st, x, false);
            let u = unwound(context, o.st, o.arg, at);
            { st: u.st, unwound: accumulator.unwound.push(u.unwound), at: accumulator.at + 1 }
          },
      );
      let mine = lowered_arguments.unwound.map(|u: Unwinding|
        match operand_variable(u.arg) { Some(v) -> v.id, None -> -1 });
      let around = lowered_arguments.st.unwinding.filter(|u: Unwinding|
        !mine.contains(match operand_variable(u.arg) { Some(v) -> v.id, None -> -1 }));
      let out = lowered(
        context,
        {
          ..emitted(lowered_arguments.st, CleanupScope(Some(lowered_arguments.unwound))),
          unwinding: lowered_arguments.unwound.concat(around),
        },
        body,
        false,
      );
      let closed = { ..out, st: { ..out.st, unwinding: lowered_arguments.st.unwinding } };
      if falls_through(closed.st.instructions) {
        { ..closed, st: emitted(closed.st, CleanupScope(None)) }
      } else { closed }
    },
  }

pub fn lowered_fn(context: Context, body: Code) -> Function / {abort.raise} = {
  let conv = convention(context);
  let known_representations = parameter_representations(context);
  let declared = context.params.len();
  let h = evidence_parameters(context.setting, context.key);
  let handed_types = evidence_parameter_types(h);
  let params = range(0, conv.params.len()).map(|i: Int|
    {
      id: i,
      ty: if i >= declared {
        match handed_types.at(i - declared) { Some(t) -> t, None -> evidence_type }
      } else { match context.types.at(i) { Some(t) -> t, None -> unknown_type } },
      representation: match known_representations.at(i) {
        Some(r) -> r,
        None -> conv.params.get(i).representation,
      },
    });
  let begun = entry_body_start(
    enter_root_body(context, initial_lowering(params), params, declared, h),
    context.performs,
  );
  let start = if h.unfilled { with_need(begun.st, { var: 0 - 1, reads: EffectsGeneric }) }
  else { begun.st };
  let out = lowered(begun.context, start, body, true);
  let returned = if falls_through(out.st.instructions) {
    represented_as(out, conv.result, body.span)
  } else { out };
  folded(context.setting.constructors, {
    key: context.key,
    kind: Metered,
    params: params,
    convention: conv,
    result_type: context.result_type,
    body: if falls_through(returned.st.instructions) {
      returned.st.instructions.push(Return(returned.arg))
    } else { returned.st.instructions },
    lambdas: returned.st.lambdas,
    base: context.base,
    members: [],
    links: returned.st.links,
    statics: returned.st.statics,
  })
}

pub fn lowered_group(members: List<GroupMember>) -> Function / {abort.raise} = {
  let starts = group_body_starts(members);
  let bodies = range(0, members.len()).fold(
    { after: None, out: [] },
    |accumulator: { after: Option<Lowering>, out: List<LoweredValue> }, i: Int|
      match members.at(i) {
        None -> accumulator,
        Some(m) -> match starts.at(i) {
          None -> accumulator,
          Some(o) -> {
            let from = match accumulator.after { Some(a) -> exit_block(o.st, a), None -> o.st };
            let b = lowered(o.context, from, m.body, true);
            { after: Some(b.st), out: accumulator.out.push(b) }
          },
        },
      },
  );
  folded(
    match members.at(0) { Some(m) -> m.context.setting.constructors, None -> no_constructors },
    {
      ..tail_group_root(members, bodies.out),
      statics: match bodies.after { Some(a) -> a.statics, None -> [] },
    },
  )
}

type SlotRead = { slot: Int, at: Span, arg: Arg }

type Operands = { state: Lowering, args: List<Arg>, read: List<SlotRead> }

fn slot_read(
  context: Context,
  state: Lowering,
  x: Code,
  views: Bool,
) -> Option<{ st: Lowering, read: SlotRead }> / {abort.raise} =
  match x.node {
    CodeVariable(v) -> match state.env.get(v.slot) {
      Some(a) -> {
        let o = if views && operand_representation(a) == AsListView { { st: state, arg: a } }
        else { slot_taken(context, state, v.name, v.slot, a, x.ty, x.span) };
        Some({ st: o.st, read: { slot: v.slot, at: x.span, arg: o.arg } })
      },
      None -> None,
    },
    _ -> None,
  }

fn slot_taken(
  context: Context,
  state: Lowering,
  name: Bytes,
  slot: Int,
  a: Arg,
  ty: Type,
  at: Span,
) -> LoweredValue / {abort.raise} = {
  let l = list_of_view({ st: state, arg: a }, at);
  if is_label_binder(name) { l } else if resume_result_type(type_of(a)) != None {
    continuation_closure(context, l.st, slot, a, at)
  } else { typed_slot_read(context, l, name, slot, ty, at) }
}

fn callee_lowered(
  context: Context,
  state: Lowering,
  function: Code,
) -> LoweredValue / {abort.raise} =
  match function.node {
    CodeVariable(v) -> match state.env.get(v.slot) {
      Some(a) -> if resume_result_type(type_of(a)) != None {
        { st: note_slot_read(context, state, read_note, v.slot, function.span), arg: a }
      } else { lowered(context, state, function, false) },
      None -> lowered(context, state, function, false),
    },
    _ -> lowered(context, state, function, false),
  }

fn list_view_slot(state: Lowering, c: Code) -> Option<{ slot: Int, arg: Arg }> =
  match c.node {
    CodeVariable(v) -> match state.env.get(v.slot) {
      Some(a) -> if operand_representation(a) == AsListView { Some({ slot: v.slot, arg: a }) }
      else { None },
      None -> None,
    },
    _ -> None,
  }

fn reads_noted(context: Context, state: Lowering, read: List<SlotRead>) -> Lowering =
  read.fold(state, |s: Lowering, r: SlotRead| note_slot_read(context, s, read_note, r.slot, r.at))

fn lowered(context: Context, state: Lowering, c: Code, tail: Bool) -> LoweredValue / {abort.raise} =
  match c.node {
    CodeLiteral(l) -> literal(context, state, l, c.span),
    CodeVariable(v) -> match state.env.get(v.slot) {
      Some(a) ->
        slot_taken(
          context,
          note_slot_read(context, state, read_note, v.slot, c.span),
          v.name,
          v.slot,
          a,
          c.ty,
          c.span,
        ),
      None -> unreachable(b"a variable has no value in the environment: ".concat(v.name)),
    },
    NDefinition(_) -> global_value(context, state, c),
    NConstructor(_) -> global_value(context, state, c),
    NBuiltin(_) -> global_value(context, state, c),
    CodeKnownLambda(k) -> known_lambda_read(context, state, k, c.span),
    CodeUnary(u) -> unary(context, lowered(context, state, u.operand, false), u.operation, c.span),
    CodeBinary(b) -> if b.operation == b"and" || b.operation == b"or" {
      let l = represented_as(
        lowered(context, state, b.left_operand, false),
        AsBool,
        b.left_operand.span,
      );
      short_circuit(
        context,
        l,
        lowered(context, enter_block(l.st), b.right_operand, tail),
        b.operation == b"and",
        c.span,
      )
    } else {
      match compared_side(context, b.operation, b.left_operand, b.right_operand) {
        Some(true) -> {
          let args = match b.left_operand.node {
            CodeApply(ca) -> {
              let wanted = compared_args(context, b.left_operand);
              ca.args.fold(
                { st: state, args: [], at: 0 },
                |accumulator: { st: Lowering, args: List<Option<Arg>>, at: Int }, x: Code|
                  if wanted.at(accumulator.at) != Some(true) {
                    { ..accumulator, args: accumulator.args.push(None), at: accumulator.at + 1 }
                  } else {
                    let o = lowered(context, accumulator.st, x, false);
                    { st: o.st, args: accumulator.args.push(Some(o.arg)), at: accumulator.at + 1 }
                  },
              )
            },
            _ -> { st: state, args: [], at: 0 },
          };
          compared(
            context,
            lowered(context, args.st, b.right_operand, false),
            b.left_operand,
            args.args,
            b.operation,
            c.span,
          )
        },
        Some(false) -> {
          let v = lowered(context, state, b.left_operand, false);
          let args = match b.right_operand.node {
            CodeApply(ca) -> {
              let wanted = compared_args(context, b.right_operand);
              ca.args.fold(
                { st: v.st, args: [], at: 0 },
                |accumulator: { st: Lowering, args: List<Option<Arg>>, at: Int }, x: Code|
                  if wanted.at(accumulator.at) != Some(true) {
                    { ..accumulator, args: accumulator.args.push(None), at: accumulator.at + 1 }
                  } else {
                    let o = lowered(context, accumulator.st, x, false);
                    { st: o.st, args: accumulator.args.push(Some(o.arg)), at: accumulator.at + 1 }
                  },
              )
            },
            _ -> { st: v.st, args: [], at: 0 },
          };
          compared(
            context,
            { st: args.st, arg: v.arg },
            b.right_operand,
            args.args,
            b.operation,
            c.span,
          )
        },
        None -> match constant(context, c) {
          Some(a) -> { st: state, arg: a },
          None -> {
            let left_operands = match slot_read(context, state, b.left_operand, false) {
              Some(r) -> { state: r.st, args: [r.read.arg], read: [r.read] },
              None -> {
                let o = lowered(context, state, b.left_operand, false);
                { state: o.st, args: [o.arg], read: [] }
              },
            };
            let operands = match operand(context, b.operation, b.right_operand) {
              Some(a) -> { ..left_operands, args: left_operands.args.push(a) },
              None -> match slot_read(context, left_operands.state, b.right_operand, false) {
                Some(r) ->
                  {
                    state: r.st,
                    args: left_operands.args.push(r.read.arg),
                    read: left_operands.read.push(r.read),
                  },
                None -> {
                  let o = lowered(context, left_operands.state, b.right_operand, false);
                  { ..left_operands, state: o.st, args: left_operands.args.push(o.arg) }
                },
              },
            };
            let s = reads_noted(context, operands.state, operands.read);
            binary(
              context,
              { st: s, arg: operands.args.get(0) },
              { st: s, arg: operands.args.get(1) },
              b.operation,
              c.span,
            )
          },
        },
      }
    },
    CodeBlock(bl) -> {
      let after = bl.statements.fold(state, |accumulator: Lowering, s: CodeStatement|
        match s {
          CodeLet(l) -> {
            let v = lowered(context, accumulator, l.value, false);
            { ..v.st, env: v.st.env.insert(l.slot, v.arg) }
          },
          CodeLetDestructure(l) -> {
            let missing = match l.value.node {
              CodeApply(a) -> is_let_mismatch_call(a.function),
              _ -> false,
            };
            let value = match l.value.node {
              CodeApply(a) -> if missing {
                match a.args.at(a.args.len() - 1) { Some(x) -> x, None -> l.value }
              } else { l.value },
              _ -> l.value,
            };
            let v = lowered(context, accumulator, value, false);
            if !missing { let_bound(context, v, l.pattern, l.span) }
            else { let_with_mismatch(context, v, l.value, l.pattern, l.span) }
          },
          CodeDo(d) -> lowered(context, accumulator, d.code, false).st,
        });
      match bl.tail {
        Some(t) -> lowered(context, after, t, tail),
        None -> literal(context, after, LiteralUnit, c.span),
      }
    },
    CodeIf(i) -> {
      let cond = represented_as(lowered(context, state, i.cond, false), AsBool, i.cond.span);
      let then = lowered(context, enter_block(cond.st), i.then_branch, tail);
      let otherwise = lowered(
        context,
        exit_block(enter_block(cond.st), then.st),
        i.else_branch,
        tail,
      );
      joined(context, cond, then, otherwise, tail, c.span)
    },
    CodeApply(a) if is_cleanup_call(a.function) ->
      within_cleanup_scope(context, state, a.args, c.span),
    CodeApply(a) -> match target(context, a.function, a.args) {
      None ->
        unreachable(
          b"the call target cannot be found: ".concat(match read_name(a.function) {
            Some(n) -> n,
            None -> b"",
          }),
        ),
      Some(ToInlinedBody(how)) -> {
        let run = inlined_argument(how);
        let counted = range_argument(how);
        let args = a.args.fold(
          { st: state, args: [], at: 0, range: None },
          |accumulator: { st: Lowering, args: List<Option<Arg>>, at: Int, range: Option<{ lo: Arg, hi: Arg }> }, x: Code|
            if run == Some(accumulator.at) {
              { ..accumulator, args: accumulator.args.push(None), at: accumulator.at + 1 }
            } else if counted == Some(accumulator.at) {
              let ends = match x.node {
                CodeApply(r) ->
                  r.args.fold(
                    { st: accumulator.st, ends: [] },
                    |e: { st: Lowering, ends: List<Arg> }, y: Code| {
                      let o = lowered(context, e.st, y, false);
                      { st: o.st, ends: e.ends.push(o.arg) }
                    },
                  ),
                _ -> { st: accumulator.st, ends: [] },
              };
              {
                st: ends.st,
                args: accumulator.args.push(None),
                at: accumulator.at + 1,
                range: match ends.ends { [lo, hi] -> Some({ lo: lo, hi: hi }), _ -> None },
              }
            } else {
              let o = lowered(context, accumulator.st, x, false);
              {
                ..accumulator,
                st: o.st,
                args: accumulator.args.push(Some(o.arg)),
                at: accumulator.at + 1,
              }
            },
        );
        let lowered_args = { args: args.args, range: args.range };
        let before = note_step_captures(context, args.st, a.args, how);
        let e = enter_inlined(context, before, a.function, a.args, lowered_args, how, c.span);
        let no_lambda = b"an inlined body is not a lambda";
        let body = match run {
          None -> match a.function.node {
            CodeKnownLambda(k) -> lowered(e.context, e.st, k.lambda.body, false),
            _ -> unreachable(no_lambda),
          },
          Some(n) -> match a.args.at(n) {
            Some(x) -> match x.node {
              CodeLambda(l) -> lowered(e.context, e.st, l.body, false),
              CodeKnownLambda(k) -> if k.in_place { lowered(e.context, e.st, k.lambda.body, false) }
              else { known_run(e.context, e.st, k, a.effects, x.span) },
              NDefinition(_) -> named_function_call(e.context, e.st, x, how),
              _ -> unreachable(no_lambda),
            },
            None -> unreachable(no_lambda),
          },
        };
        exit_inlined(context, before, e, body, lowered_args, c.span)
      },
      Some(ToValue) -> {
        let f = callee_lowered(context, state, a.function);
        let args = a.args.fold(
          { state: f.st, args: [], read: [] },
          |accumulator: Operands, x: Code|
            match slot_read(context, accumulator.state, x, false) {
              Some(r) ->
                {
                  state: r.st,
                  args: accumulator.args.push(r.read.arg),
                  read: accumulator.read.push(r.read),
                },
              None -> {
                let o = lowered(context, accumulator.state, x, false);
                { ..accumulator, state: o.st, args: accumulator.args.push(o.arg) }
              },
            },
        );
        let called = reads_noted(context, args.state, args.read);
        match a.function.node {
          CodeKnownLambda(k) ->
            known_applied(context, called, k, f.arg, args.args, a.effects, tail, c.span),
          _ -> applied(context, called, f.arg, args.args, a.effects, tail, c.span),
        }
      },
      Some(t) -> {
        let views = match t { ToDefinition(_) -> true, _ -> false };
        let operands = a.args.fold(
          { state: state, args: [], read: [] },
          |accumulator: Operands, x: Code|
            match slot_read(context, accumulator.state, x, views) {
              Some(r) ->
                {
                  state: r.st,
                  args: accumulator.args.push(r.read.arg),
                  read: accumulator.read.push(r.read),
                },
              None -> {
                let o = lowered(context, accumulator.state, x, false);
                { ..accumulator, state: o.st, args: accumulator.args.push(o.arg) }
              },
            },
        );
        let args = { st: reads_noted(context, operands.state, operands.read), args: operands.args };
        match t {
          ToConstructor(name) -> constructed(context, args.st, name, args.args, c.ty, c.span),
          ToBuiltin(name) -> called_builtin(context, args.st, name, args.args, a.function, c.span),
          ToDefinition(full) ->
            called(context, args.st, full, a.function, a.args, args.args, tail, c.span),
          _ -> unreachable(b"the call target is not a constructor, builtin or definition"),
        }
      },
    },
    CodeList(l) -> {
      let operands = l.items.fold(
        { state: state, args: [], read: [] },
        |accumulator: Operands, x: Code|
          match slot_read(context, accumulator.state, x, false) {
            Some(r) ->
              {
                state: r.st,
                args: accumulator.args.push(r.read.arg),
                read: accumulator.read.push(r.read),
              },
            None -> {
              let o = lowered(context, accumulator.state, x, false);
              { ..accumulator, state: o.st, args: accumulator.args.push(o.arg) }
            },
          },
      );
      let items = { st: reads_noted(context, operands.state, operands.read), args: operands.args };
      list_literal(context, items.st, items.args, c.ty, c.span)
    },
    CodeRecord(r) -> {
      let fs = r.fields.fold(
        { state: state, args: [], read: [] },
        |accumulator: Operands, f: CodeField|
          match slot_read(context, accumulator.state, f.value, false) {
            Some(r) ->
              {
                state: r.st,
                args: accumulator.args.push(r.read.arg),
                read: accumulator.read.push(r.read),
              },
            None -> {
              let o = lowered(context, accumulator.state, f.value, false);
              { ..accumulator, state: o.st, args: accumulator.args.push(o.arg) }
            },
          },
      );
      record_literal(
        context,
        reads_noted(context, fs.state, fs.read),
        zip(r.fields, fs.args).map(|x: { first: CodeField, second: Arg }|
          { name: x.first.name, arg: x.second }),
        c.ty,
        c.span,
      )
    },
    CodeFieldRead(f) -> if !reads_column(context, f.base, f.field) {
      field(context, lowered(context, state, f.base, false), f.field, c.span)
    } else {
      let args = match f.base.node {
        CodeApply(ca) ->
          ca.args.fold(
            { st: state, args: [] },
            |accumulator: { st: Lowering, args: List<Arg> }, x: Code| {
              let o = lowered(context, accumulator.st, x, false);
              { st: o.st, args: accumulator.args.push(o.arg) }
            },
          ),
        _ -> { st: state, args: [] },
      };
      column_read(context, args.st, args.args, f.base, f.field, c.span)
    },
    CodeUpdate(u) -> {
      let base = match slot_read(context, state, u.base, false) {
        Some(r) -> { state: r.st, args: [r.read.arg], read: [r.read] },
        None -> {
          let o = lowered(context, state, u.base, false);
          { state: o.st, args: [o.arg], read: [] }
        },
      };
      let operands = u.sets.fold(base, |accumulator: Operands, f: CodeField|
        match slot_read(context, accumulator.state, f.value, false) {
          Some(r) ->
            {
              state: r.st,
              args: accumulator.args.push(r.read.arg),
              read: accumulator.read.push(r.read),
            },
          None -> {
            let o = lowered(context, accumulator.state, f.value, false);
            { ..accumulator, state: o.st, args: accumulator.args.push(o.arg) }
          },
        });
      match operands.args {
        [b, ..set] ->
          record_update(
            context,
            reads_noted(context, operands.state, operands.read),
            b,
            u.copied_fields,
            zip(u.sets, set).map(|x: { first: CodeField, second: Arg }|
              { name: x.first.name, arg: x.second }),
            c.ty,
            c.span,
          ),
        [] -> unreachable(b"a record update has no base record"),
      }
    },
    CodeMatch(m) -> {
      let s = match list_view_slot(state, m.scrutinee) {
        Some(v) ->
          { st: note_slot_read(context, state, read_note, v.slot, m.scrutinee.span), arg: v.arg },
        None -> lowered(context, state, m.scrutinee, false),
      };
      let arms = m.arms.fold(
        { after: s.st, out: [] },
        |accumulator: { after: Lowering, out: List<LoweredArm> }, arm: CodeArm| {
          let o = arm_start(context, exit_block(enter_block(s.st), accumulator.after), s.arg, arm);
          match arm.guard {
            None -> {
              let b = lowered(context, o, arm.body, tail);
              { after: b.st, out: accumulator.out.push({ arm: arm, guard: None, body: b }) }
            },
            Some(g) -> {
              let gl = represented_as(lowered(context, o, g, false), AsBool, g.span);
              let b = lowered(context, enter_block(gl.st), arm.body, tail);
              { after: b.st, out: accumulator.out.push({ arm: arm, guard: Some(gl), body: b }) }
            },
          }
        },
      );
      match_joined(context, s.st, s.arg, arms.out, arms.after, tail, c.span)
    },
    CodePerform(p) -> {
      let lb = match p.label {
        Some(lc) -> {
          let o = lowered(context, state, lc, false);
          { st: o.st, arg: Some(o.arg) }
        },
        None -> { st: state, arg: None },
      };
      let spawns = p.effect == b"task" && p.operation == b"spawn";
      let args = p.args.fold(
        { st: lb.st, args: [] },
        |accumulator: { st: Lowering, args: List<Arg> }, x: Code| {
          let o = if spawns { spawn_argument_lowered(context, accumulator.st, x) }
          else { lowered(context, accumulator.st, x, false) };
          { st: o.st, args: accumulator.args.push(o.arg) }
        },
      );
      let operation = { effect: p.effect, operation: p.operation, resource: p.resource };
      match scheduler_perform_call(context, operation, p.args, args.args, c.ty, c.span) {
        Some(x) -> if module_of(context.key) == scheduler_module {
          unreachable(
            b"the scheduler calls an effect operation at a type that is not `Kept`: ".concat(
              x.name,
            ),
          )
        } else {
          called_at_types(context, args.st, x.name, x.types, x.rows, p.args, args.args, c.span)
        },
        None -> performed(context, args.st, operation, lb.arg, p.label, args.args, c.ty, c.span),
      }
    },
    CodeLabel(n) -> label(context, state, n, c.span),
    CodeLambda(l) -> {
      let frame = {
        params: l.params,
        size: l.size,
        captures: l.captures,
        resumes: None,
        body: l.body,
        ty: l.ty,
        words: words_of(context, l.effects),
        captured_evidence: no_captured_evidence,
      };
      let o = lambda_body_start(context, state, frame, l.at);
      closure(context, state, lowered(o.context, o.st, l.body, true), frame, Metered, l.at)
    },
    CodeSimulate(x) -> {
      let frame = {
        params: 0,
        size: x.size,
        captures: x.captures,
        resumes: None,
        body: x.body,
        ty: {
          params: [],
          keep_parameters: [],
          once: false,
          return_type: x.body.ty,
          effects: no_effects,
        },
        words: words_of(context, x.effects),
        captured_evidence: no_captured_evidence,
      };
      let o = lambda_body_start(context, state, frame, x.at);
      let k = closure(context, state, lowered(o.context, o.st, x.body, true), frame, Metered, x.at);
      simulate_called(context, k.st, k.arg, x.effects, c.span)
    },
    CodeParallel(parallel_code) -> {
      let bs = parallel_code.branches.fold(
        { st: state, args: [] },
        |accumulator: { st: Lowering, args: List<Arg> }, x: Code| {
          let o = lowered(context, accumulator.st, x, false);
          { st: o.st, args: accumulator.args.push(o.arg) }
        },
      );
      parallel_block(context, bs.st, bs.args, performed_by(parallel_code.branches), c.span)
    },
    CodeHandle(h) -> {
      let plan = handle_plan(context, state, h, c.span);
      let clauses = h.clauses.fold(
        { st: plan.st, out: [] },
        |accumulator: { st: Lowering, out: List<Arg> }, clause: CodeClause| {
          let evidence = clause_captured_evidence(
            context,
            accumulator.st,
            plan,
            clause.effects,
            clause.at,
          );
          let frame = clause_frame(clause, evidence.held);
          let o = lambda_body_start(context, evidence.st, frame, clause.at);
          let k = stack_closure(
            plan,
            closure(
              context,
              evidence.st,
              lowered(o.context, o.st, clause.body, true),
              frame,
              Metered,
              clause.at,
            ),
          );
          { st: k.st, out: accumulator.out.push(k.arg) }
        },
      );
      let return_clause = match h.return_clause {
        Some(r) -> {
          let evidence = clause_captured_evidence(context, clauses.st, plan, r.effects, r.at);
          let frame = return_frame(r, evidence.held);
          let o = lambda_body_start(context, evidence.st, frame, r.at);
          let k = stack_closure(
            plan,
            closure(
              context,
              evidence.st,
              lowered(o.context, o.st, r.body, true),
              frame,
              Metered,
              r.at,
            ),
          );
          { st: k.st, arg: Some(k.arg) }
        },
        None -> { st: clauses.st, arg: None },
      };
      let body = if detaches(h.clauses) {
        let objects = instance_objects(context, return_clause.st, h, plan, c.span);
        let result = c.ty;
        let frame = body_frame(context, h, plan, objects.words, result);
        let at = detached_closure_span(c.span);
        let o = lambda_body_start(context, objects.st, frame, at);
        let inner = lowered(o.context, enter_block(o.st), h.body, false);
        closure(
          context,
          objects.st,
          lower_detached_handle(o.context, o.st, inner, h, plan, result, at),
          frame,
          Metered,
          at,
        )
      } else {
        let e = enter_handle(
          context,
          { ..enter_block(return_clause.st), unwinding: [] },
          h,
          plan,
          c.span,
        );
        lowered(e.context, e.st, h.body, false)
      };
      let out = handle_assembled(
        context,
        return_clause.st,
        body,
        clauses.out,
        return_clause.arg,
        h,
        plan,
        c.span,
      );
      { ..out, st: { ..out.st, unwinding: return_clause.st.unwinding } }
    },
  }
