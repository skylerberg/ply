import compiler.cc (Profile, Toolchain, compilers, toolchain)
import compiler.check.resolve.tables (Diagnostic)
import compiler.emit.keys (RootKey)
import compiler.program.code (ObjectKey, ReachedCode)
import compiler.program.fact (facts)

pub type NativeProgram = { objects: List<String>, libraries: List<String>, main: Bytes }

pub fn object_of<[c]>(
  t: Toolchain,
  key: ObjectKey,
) -> Result<String, String> / {facts.read, compilers.write[c], toolchain.read, toolchain.write, abort.raise} = ???

pub fn native_program<[c]>(
  t: Toolchain,
  profile: Profile,
  reached: ReachedCode,
) -> Result<NativeProgram, String> / {facts.read, compilers.write[c], toolchain.read, toolchain.write, abort.raise} = ???

pub fn linked<[c]>(
  t: Toolchain,
  program: NativeProgram,
  output: String,
) -> Result<String, String> / {compilers.write[c], toolchain.read, toolchain.write} = ???

pub fn compiled_program<[c]>(
  t: Toolchain,
  profile: Profile,
  roots: List<RootKey>,
  output: String,
) -> Result<String, List<Diagnostic>> / {facts.read, compilers.write[c], toolchain.read, toolchain.write, abort.raise} = ???
