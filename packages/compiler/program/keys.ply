import std.bin

pub type ModuleKey = { module: Bytes, shipped: Bool, tested: Bool }

pub type ItemKey = { module: ModuleKey, item: Bytes }

pub type GroupKey = { module: ModuleKey, items: List<Bytes> }

pub type SeenName = { from: ModuleKey, name: Bytes }

derive bin for ModuleKey

derive bin for ItemKey

derive bin for GroupKey

derive bin for SeenName
