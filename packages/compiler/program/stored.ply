import std.bin
import compiler.check.infer.checker (StoredDeclarations, stored_declarations_bin)
import compiler.check.resolve.tables (Declaration, Namespace)

pub fn encoded_declarations(stored: StoredDeclarations) -> Bytes / {abort.raise} =
  bin::encode(stored, stored_declarations_bin())

pub fn decoded_declarations(bytes: Bytes) -> StoredDeclarations / {abort.raise} =
  match bin::decode(bytes, stored_declarations_bin()) {
    Ok(stored) -> stored,
    Err(_) -> panic("a stored declaration could not be decoded"),
  }

pub type NameKind = { namespace: Namespace, declaration: Declaration }
