import compiler.check.infer.checker (CheckReads, DefinitionFacts, program)
import compiler.check.infer.definitions (Extern)
import compiler.check.resolve.tables (EffectSpace, module_names, qualify)
import compiler.check.typed (ConstantData)
import compiler.emit.lower.module_context (CodeElsewhere, HostHandler, effect_operation_of,
                                           nothing_elsewhere)
import compiler.emit.representations (Definition, definition_shaped)
import compiler.front.exports (Mention)
import std.list

fn stored_definition(
  named: Mention,
  facts: DefinitionFacts,
  value: Option<ConstantData>,
) -> Option<Definition> =
  match facts.call {
    Some(shape) ->
      Some(definition_shaped(named.module, named.name, shape, facts.pure, facts.scheme, value)),
    None -> None,
  }

fn host_of_effect<| e>(
  served: Mention,
  value_of: (Mention) -> Option<ConstantData> / {abort.raise | e},
) -> Option<HostHandler> / {CheckReads, abort.raise | e} =
  match program.host_named(qualify(served.module, served.name)) {
    None -> None,
    Some(by) -> {
      let named = { module: served.module, name: by };
      match program.definition_named(qualify(served.module, by)) {
        None -> None,
        Some(facts) -> match stored_definition(named, facts, value_of(named)) {
          None -> None,
          Some(definition) ->
            Some({
              call: qualify(served.module, by),
              import: {
                name: qualify(served.module, served.name),
                module: served.module,
                definitions: [definition],
                whole: true,
              },
            }),
        },
      }
    },
  }

fn with_effect<| e>(
  found: CodeElsewhere,
  named: Mention,
  value_of: (Mention) -> Option<ConstantData> / {abort.raise | e},
) -> CodeElsewhere / {CheckReads, abort.raise | e} = {
  let global = qualify(named.module, named.name);
  match program.effect_named(global) {
    None -> found,
    Some(info) ->
      {
        ..found,
        effects: found.effects.push({
          global: global,
          operations: info.operations.map(effect_operation_of),
        }),
        hosts: match host_of_effect(named, value_of) {
          Some(host) -> found.hosts.insert(global, host),
          None -> found.hosts,
        },
      },
  }
}

fn with_definition<| e>(
  found: CodeElsewhere,
  named: Mention,
  facts: DefinitionFacts,
  value_of: (Mention) -> Option<ConstantData> / {abort.raise | e},
  natives_of: (Bytes) -> List<Extern> / {abort.raise | e},
) -> CodeElsewhere / {abort.raise | e} = {
  let qualified = qualify(named.module, named.name);
  let schemed = {
    ..found,
    schemes: found.schemes.insert(qualified, facts.scheme),
    returned: match facts.call {
      Some(shape) -> match shape.returned {
        Some(stated) -> found.returned.insert(qualified, stated),
        None -> found.returned,
      },
      None -> found.returned,
    },
  };
  match stored_definition(named, facts, value_of(named)) {
    Some(definition) ->
      {
        ..schemed,
        definitions: schemed.definitions.insert(
          named.module,
          List::push(
            match schemed.definitions.get(named.module) { Some(ds) -> ds, None -> [] },
            definition,
          ),
        ),
      },
    None -> { ..schemed, natives: schemed.natives.concat(natives_of(named.module)) },
  }
}

pub fn code_elsewhere<| e>(
  mentioned: List<Mention>,
  value_of: (Mention) -> Option<ConstantData> / {abort.raise | e},
  natives_of: (Bytes) -> List<Extern> / {abort.raise | e},
) -> CodeElsewhere / {CheckReads, abort.raise | e} =
  mentioned.fold(nothing_elsewhere, |found: CodeElsewhere, named: Mention| {
    let effects_read = match module_names.name_declared(named.module, EffectSpace, named.name) {
      Some(_) -> with_effect(found, named, value_of),
      None -> found,
    };
    match program.definition_named(qualify(named.module, named.name)) {
      Some(facts) -> with_definition(effects_read, named, facts, value_of, natives_of),
      None -> effects_read,
    }
  })
