import std.bin
import compiler.check.resolve.tables (Diagnostic, Scope)
import compiler.check.infer.checker (CheckedBody)
import compiler.front.exports (OwnerText)
import compiler.program.fact (Fact, facts)
import compiler.program.keys (GroupKey, ItemKey, ModuleKey)
import compiler.program.reads (DefinitionFacts, TypeFacts, program)
import compiler.store.hash.forms (HashInput)
import compiler.syntax.items (ImportDeclaration)

pub type ItemHead = { name: Bytes, public: Bool, declares_type: Bool, declares_effect: Bool }

pub type ModuleOutline = { imports: List<ImportDeclaration>, items: List<ItemHead> }

pub type ItemNames = { names: List<Bytes>, in_signature: List<Bytes> }

pub type ModuleGroups = {
  declarations: List<List<Bytes>>,
  signatures: List<List<Bytes>>,
  bodies: List<List<Bytes>>,
}

pub type DeclaredGroup = {
  types: Map<Bytes, TypeFacts>,
  diagnostics: List<Diagnostic>,
}

pub type SignedGroup = {
  definitions: Map<Bytes, DefinitionFacts>,
  diagnostics: List<Diagnostic>,
}

pub type CheckedGroup = {
  bodies: List<CheckedBody>,
  diagnostics: List<Diagnostic>,
  forms: HashInput,
}

pub fn outline_fact() -> Fact<ModuleKey, ModuleOutline> = ???

pub fn places_fact() -> Fact<ModuleKey, Map<Bytes, Int>> = ???

pub fn text_fact() -> Fact<ItemKey, OwnerText> = ???

pub fn names_fact() -> Fact<ItemKey, ItemNames> = ???

pub fn groups_fact() -> Fact<ModuleKey, ModuleGroups> = ???

pub fn scope_fact() -> Fact<ModuleKey, Scope> = ???

pub fn declared_fact() -> Fact<GroupKey, DeclaredGroup> = ???

pub fn signed_fact() -> Fact<GroupKey, SignedGroup> = ???

pub fn checked_fact() -> Fact<GroupKey, CheckedGroup> = ???

pub fn hash_fact() -> Fact<ItemKey, Bytes> = ???

pub fn outline_of(text: Bytes) -> ModuleOutline / {abort.raise} = ???

pub fn scope_over(
  module: Bytes,
  outline: ModuleOutline,
  imported: Map<Bytes, ModuleOutline>,
) -> Scope / {abort.raise} = ???

pub fn groups_over(items: Map<Bytes, ItemNames>) -> ModuleGroups / {abort.raise} = ???

pub fn declare_group(module: Bytes, items: List<OwnerText>) -> DeclaredGroup / {program.read, abort.raise} = ???

pub fn sign_group(module: Bytes, items: List<OwnerText>) -> SignedGroup / {program.read, abort.raise} = ???

pub fn check_group(module: Bytes, items: List<OwnerText>) -> CheckedGroup / {program.read, abort.raise} = ???

pub fn hash_of_item(
  forms: HashInput,
  item: Bytes,
  named_hash: (Bytes) -> Bytes / {facts.read, abort.raise},
) -> Bytes / {facts.read, abort.raise} = ???
