import compiler.program.view (TestRow)

pub type RecordKind = | TestPass | Proof | LiteralVerdict

pub effect project_records {
  read recorded(kind: RecordKind, name: Bytes) -> Option<Bytes>
  write record(kind: RecordKind, name: Bytes, digest: Bytes) -> Unit
  write forget(kind: RecordKind, name: Bytes) -> Unit
}

pub fn tests_out_of_date(tests: List<TestRow>) -> List<TestRow> / {project_records.read, abort.raise} = ???

pub fn record_passes(tests: List<TestRow>) -> Unit / {project_records.write, abort.raise} = ???

pub fn forget_missing(kind: RecordKind, live: Map<Bytes, Bool>) -> Unit / {project_records.write, abort.raise} = ???
