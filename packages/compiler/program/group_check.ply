import compiler.check.infer.checker (BodyChecking, CheckReads)
import compiler.check.resolve (ImportPackages, ResolveFailed, ResolveSucceeded, resolve_group)
import compiler.check.resolve.defaults (ResolvedProgram)
import compiler.check.resolve.tables (Diagnostic, EffectSpace, ParsedModule, Scope, TypeSpace,
                                      ValueSpace, bound_in, module_names)
import compiler.expand.embed (EmbedRequest, EmbedResult, ModuleEmbed, embed_key, embed_requests)
import compiler.front (PulledAnalysis, embeds_inlined, may_call_embed)
import compiler.front.diagnostics (ParsedSource, outside_every_module, parse_from)
import compiler.front.emitter_input (Rejected)
import compiler.front.exports (Imported, OwnerSource, OwnerText, group_source_from, named_as_owned)
import compiler.front.published (HashedProgram, checked_with_reads, no_rows)
import compiler.store.hash (hashed_and_unused)
import compiler.store.hash.forms (CachedNode, build_index, node_held_elsewhere)
import compiler.store.hash.graph (Index, NameElsewhere, Node, NodeElsewhere, index_beside)
import compiler.syntax.items (parse)
import std.list

pub type GroupInputs = {
  source: OwnerSource,
  elsewhere: List<NameElsewhere>,
  tables: ImportPackages,
  shipped: Bool,
  embed_read: (EmbedRequest) -> EmbedResult / {abort.raise},
}

pub fn source_of_group(
  module: Bytes,
  members: List<OwnerText>,
  imported: List<Imported>,
) -> OwnerSource / {abort.raise} = group_source_from(module, members, imported, Map::new())

fn with_embeds(
  parsed: ParsedSource,
  read: (EmbedRequest) -> EmbedResult / {abort.raise},
) -> { parsed: ParsedSource, embeds: List<ModuleEmbed> } / {abort.raise} =
  if !may_call_embed(parsed.text) { { parsed: parsed, embeds: [] } } else {
    embeds_inlined(
      parsed,
      0,
      embed_requests(parsed.module.module).fold(
        Map::new(),
        |found: Map<Bytes, EmbedResult>, want: EmbedRequest|
          found.insert(embed_key(want), read(want)),
      ),
    )
  }

pub fn parsed_group(source: OwnerSource) -> ParsedSource / {abort.raise} = {
  let raw = parse(source.source.source_text);
  parse_from(
    0,
    source.source,
    { ..raw, node: named_as_owned(raw.node, source) },
    derivations: source.derived,
  )
}

fn rejected(diagnostics: List<Diagnostic>) -> { pulled: PulledAnalysis, at: Int } =
  { pulled: { pulled: [], out: Rejected(diagnostics), shipped_views: [] }, at: 0 }

fn hashed_group(
  parsed: ParsedSource,
  embeds: List<ModuleEmbed>,
  x: ResolvedProgram,
  index: Index,
  inputs: GroupInputs,
) -> HashedProgram / {abort.raise, module_names.read} = {
  let module_packages = x.modules.map(|m: ParsedModule|
    match module_names.module_package(m.name) { Some(p) -> p, None -> inputs.tables.package });
  let fixed = index.nodes.fold([], |found: List<CachedNode>, n: Node|
    match n.body {
      NodeElsewhere(e) -> found.push(node_held_elsewhere(n.name, e.declaration)),
      _ -> found,
    });
  let hashed = hashed_and_unused(index, { nodes: fixed, tests: [], laws: [] }, module_packages);
  {
    modules: x.modules,
    r: x.resolution,
    unimported: x.modules.map(|_: ParsedModule| []),
    index: index,
    hashes: hashed.hashes,
    unused: hashed.unused,
    uses: hashed.uses,
    closure: { packages: [], modules: [], diagnostics: [] },
    packages: [],
    module_packages: module_packages,
    root_count: if inputs.shipped { 0 } else { 1 },
    embeds: embeds,
    texts: [parsed.text],
    cuts: Map::new(),
    embed_items: Map::new(),
  }
}

fn with_scope(n: NameElsewhere, scope: Scope) -> NameElsewhere / {module_names.read} = {
  let namespace = if n.effect { EffectSpace }
  else if n.declaration { TypeSpace }
  else { ValueSpace };
  {
    ..n,
    bare: match bound_in(scope, namespace, n.name) {
      Some(b) -> b.owner == n.module,
      None -> false,
    },
  }
}

pub fn checked_group(
  inputs: GroupInputs,
  walks: BodyChecking,
) -> { pulled: PulledAnalysis, at: Int } / {CheckReads, abort.raise} = {
  let read = with_embeds(parsed_group(inputs.source), inputs.embed_read);
  let parsed = read.parsed;
  if parsed.diagnostics.len() > 0 { rejected(parsed.diagnostics) } else {
    match resolve_group(
        parsed.module,
        inputs.elsewhere.map(|n: NameElsewhere| n.module),
        inputs.tables,
      ) {
      ResolveFailed(ds) -> rejected(ds.map(outside_every_module)),
      ResolveSucceeded(x) -> {
        let built = build_index(x.modules, x.resolution);
        if built.diagnostics.len() > 0 { rejected(built.diagnostics.map(outside_every_module)) }
        else {
          let scope = x.resolution.scopes.get(0);
          let index = index_beside(
            built.index,
            inputs.elsewhere.map(|n: NameElsewhere| with_scope(n, scope)),
          );
          {
            pulled: {
              pulled: [],
              out: checked_with_reads(
                hashed_group(parsed, read.embeds, x, index, inputs),
                no_rows,
                walks,
              ),
              shipped_views: [],
            },
            at: 0,
          }
        }
      },
    }
  }
}
