import compiler.check.infer.checker (BodyPlan, CheckReads, Role, StoredDeclarations,
                                     dependency_module)
import compiler.check.resolve (ImportPackages, ResolveFailed, ResolveSucceeded, resolve_group)
import compiler.check.resolve.defaults (ResolvedProgram)
import compiler.check.resolve.tables (Diagnostic, EffectSpace, ParsedModule, Scope, TypeSpace,
                                      ValueSpace, bound_in, other_modules)
import compiler.expand.embed (EmbedRequest, EmbedResult, ModuleEmbed, embed_key, embed_requests)
import compiler.front (embeds_inlined, may_call_embed)
import compiler.front.diagnostics (ParsedSource, parse_from)
import compiler.front.exports (Imported, OwnerSource, OwnerText, group_source_from, named_as_owned)
import compiler.front.published (GroupCheck, ResolvedGroup, resolved_facts, type_check, unresolved)
import compiler.store.hash (index_uses)
import compiler.store.hash.forms (build_index)
import compiler.store.hash.graph (HeldConstructor, HeldEffect, HeldName, HeldType, HeldValue, Index,
                                  NameElsewhere, index_beside)
import compiler.syntax.items (parse)
import std.list

pub type LoadedSource = {
  source: OwnerSource,
  role: Role,
  tables: ImportPackages,
  embed_read: (EmbedRequest) -> EmbedResult / {abort.raise},
}

pub type GroupInputs = { loaded: List<LoadedSource>, elsewhere: List<NameElsewhere> }

pub fn source_of_group(
  module: Bytes,
  members: List<OwnerText>,
  imported: List<Imported>,
) -> OwnerSource / {abort.raise} = group_source_from(module, members, imported)

type ReadSource = { parsed: ParsedSource, embeds: List<ModuleEmbed> }

fn with_embeds(
  parsed: ParsedSource,
  at: Int,
  read: (EmbedRequest) -> EmbedResult / {abort.raise},
) -> ReadSource / {abort.raise} =
  if !may_call_embed(parsed.text) { { parsed: parsed, embeds: [] } } else {
    embeds_inlined(
      parsed,
      at,
      embed_requests(parsed.module.module).fold(
        Map::new(),
        |found: Map<Bytes, EmbedResult>, want: EmbedRequest|
          found.insert(embed_key(want), read(want)),
      ),
    )
  }

pub fn parsed_group(source: OwnerSource, at: Int) -> ParsedSource / {abort.raise} = {
  let raw = parse(source.source.source_text);
  parse_from(
    at,
    source.source,
    { ..raw, node: named_as_owned(raw.node, source) },
    derivations: source.derived,
  )
}

fn grouped(
  read: List<ReadSource>,
  x: ResolvedProgram,
  index: Index,
  inputs: GroupInputs,
) -> ResolvedGroup / {abort.raise, other_modules.read} = {
  {
    modules: list::zip(x.modules, inputs.loaded).map(
      |pair: { first: ParsedModule, second: LoadedSource }|
        { parsed: pair.first, role: pair.second.role },
    ).concat(
      x.modules.drop(inputs.loaded.len()).map(dependency_module),
    ),
    resolution: x.resolution,
    index: index,
    uses: index_uses(index).uses,
    module_packages: x.modules.map(|m: ParsedModule|
      match other_modules.look_up_package(m.name) {
        Some(p) -> p,
        None -> inputs.loaded.get(0).tables.package,
      }),
    embeds: read.flat_map(|r: ReadSource| r.embeds),
    texts: read.map(|r: ReadSource| r.parsed.text),
    problems: x.diagnostics,
  }
}

fn with_scopes(n: NameElsewhere, scopes: List<Scope>) -> NameElsewhere / {other_modules.read} = {
  let namespace = match n.held {
    HeldName(HeldEffect) -> EffectSpace,
    HeldName(HeldType) -> TypeSpace,
    HeldName(HeldValue) -> ValueSpace,
    HeldConstructor(_) -> ValueSpace,
  };
  {
    ..n,
    bare: scopes.any(|scope: Scope|
      match bound_in(scope, namespace, n.name) { Some(b) -> b.owner == n.module, None -> false }),
  }
}

pub fn checked_group(
  inputs: GroupInputs,
  body_plan: BodyPlan,
) -> GroupCheck / {CheckReads, abort.raise} =
  match resolved_group(inputs) {
    Err(ds) -> unresolved(ds),
    Ok(group) -> type_check(group, body_plan, []),
  }

pub fn rejected_group(
  inputs: GroupInputs,
  diagnostics: List<Diagnostic>,
  declared: StoredDeclarations,
) -> GroupCheck / {other_modules.read, abort.raise} =
  match resolved_group(inputs) {
    Err(ds) -> unresolved(ds),
    Ok(group) ->
      {
        resolved: resolved_facts(group),
        declared: declared,
        checked: None,
        diagnostics: diagnostics,
      },
  }

pub fn resolved_group(
  inputs: GroupInputs,
) -> Result<ResolvedGroup, List<Diagnostic>> / {other_modules.read, abort.raise} = {
  let read = range(0, inputs.loaded.len()).map(|i: Int| {
    let l = inputs.loaded.get(i);
    with_embeds(parsed_group(l.source, i), i, l.embed_read)
  });
  let problems = read.flat_map(|r: ReadSource| r.parsed.diagnostics);
  if problems.len() > 0 { Err(problems) } else {
    match resolve_group(
        range(0, read.len()).map(|i: Int|
          { module: read.get(i).parsed.module, tables: inputs.loaded.get(i).tables }),
        inputs.elsewhere.map(|n: NameElsewhere| n.module),
      ) {
      ResolveFailed(ds) -> Err(ds),
      ResolveSucceeded(x) -> {
        let built = build_index(x.modules, x.resolution);
        if built.diagnostics.len() > 0 { Err(built.diagnostics) } else {
          let scopes = x.resolution.scopes.take(read.len());
          let index = index_beside(
            built.index,
            inputs.elsewhere.map(|n: NameElsewhere| with_scopes(n, scopes)),
          );
          Ok(grouped(read, x, index, inputs))
        }
      },
    }
  }
}
