import compiler.check.borrowing (mode_facts)
import compiler.check.infer.checker (BodyChecking, program)
import compiler.check.resolve.defaults (ResolvedProgram)
import compiler.check.resolve.tables (Diagnostic, module_names)
import compiler.check.termination (summary_facts)
import compiler.front (PulledAnalysis)
import compiler.front.diagnostics (ParsedSource)
import compiler.front.emitter_input (AnalysisOutcome)
import compiler.front.exports (OwnerSource, OwnerText)
import compiler.front.published (HashedProgram)
import compiler.store.hash.graph (Index)
import compiler.syntax.items (ImportDeclaration)

pub type ImportedModule = { declaration: ImportDeclaration, target: Bytes }

pub type ReferencedName = {
  module: Bytes,
  name: Bytes,
  declaration: Bool,
  effect: Bool,
  public: Bool,
  constructor_of: Option<Bytes>,
}

pub type GroupInputs = {
  source: OwnerSource,
  imported: List<ImportedModule>,
  referenced: List<ReferencedName>,
  root_count: Int,
}

pub fn source_of_group(
  module: Bytes,
  members: List<OwnerText>,
  imported: List<ImportedModule>,
) -> OwnerSource / {abort.raise} = ???

pub fn parsed_group(source: OwnerSource) -> ParsedSource / {abort.raise} = ???

pub fn resolved_group(
  parsed: ParsedSource,
  imported: List<ImportedModule>,
) -> Result<ResolvedProgram, List<Diagnostic>> / {module_names.read, abort.raise} = ???

pub fn indexed_group(
  x: ResolvedProgram,
  imported: List<ImportedModule>,
  referenced: List<ReferencedName>,
) -> Result<Index, List<Diagnostic>> / {module_names.read, abort.raise} = ???

pub fn hashed_group(
  parsed: ParsedSource,
  x: ResolvedProgram,
  index: Index,
  referenced: List<ReferencedName>,
) -> Result<HashedProgram, List<Diagnostic>> / {module_names.read, abort.raise} = ???

pub fn analysed_group(
  h: HashedProgram,
  walks: BodyChecking,
) -> AnalysisOutcome / {program.read, module_names.read, mode_facts.read, summary_facts.read, abort.raise} = ???

pub fn checked_group(
  inputs: GroupInputs,
  walks: BodyChecking,
) -> { pulled: PulledAnalysis, at: Int } / {program.read, module_names.read, mode_facts.read, summary_facts.read, abort.raise} = ???

pub fn import_problems(
  module: Bytes,
  imported: List<ImportedModule>,
) -> List<Diagnostic> / {module_names.read, abort.raise} = ???
