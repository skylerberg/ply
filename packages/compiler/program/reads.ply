import compiler.check.infer.checker (ConstructorInfo, DefinitionConstraint, DefinitionInfo,
                                     EffectInfo, InstanceInfo, NumericInfo, RecordDeclaration,
                                     TypeDeclaration)
import compiler.check.borrowing (ParameterModes)
import compiler.check.guards (Contract)
import compiler.check.resolve.tables (Parameters, Scope)
import compiler.check.types (Type)
import compiler.program.keys (ModuleKey)
import compiler.program.fact (facts)
import compiler.syntax.items (EffectSetDefinition)

pub type TypeFacts = {
  declaration: TypeDeclaration,
  constructors: List<ConstructorInfo>,
  alias: Option<Type>,
  record: Option<RecordDeclaration>,
  instances: List<InstanceInfo>,
  numeric: Option<NumericInfo>,
  keyed: Bool,
  release_function: Option<Bytes>,
  resource: Bool,
}

pub type DefinitionFacts = {
  definition: DefinitionInfo,
  parameters: Parameters,
  modes: ParameterModes,
  contract: Option<Contract>,
  constant: Bool,
  constraints: List<DefinitionConstraint>,
}

pub effect program {
  read scope_of(module: Bytes) -> Option<Scope>
  read visible_modules(module: Bytes) -> List<Bytes>
  read type_named(name: Bytes) -> Option<TypeFacts>
  read effect_named(name: Bytes) -> Option<EffectInfo>
  read effect_set_named(name: Bytes) -> Option<EffectSetDefinition>
  read definition_named(name: Bytes) -> Option<DefinitionFacts>
  read modules_declaring(name: Bytes) -> List<Bytes>
}

pub fn over_facts<a | e>(
  module: ModuleKey,
  body: () -> a / {program.read | e},
) -> a / {facts.read, abort.raise | e} = ???
