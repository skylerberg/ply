import compiler.check.borrowing (mode_facts)
import compiler.check.infer.checker (program)
import compiler.check.resolve.tables (Binding, Declaration, Declarations, ModuleBinding, Namespace,
                                      module_names)
import compiler.check.termination (summary_facts)
import compiler.program.stored (StoredDeclarations)

pub type StoredReads<| e> = {
  declarations_of: (Bytes) -> List<StoredDeclarations> / {abort.raise | e},
  name_bound: (Namespace, Bytes) -> Option<Binding> / {abort.raise | e},
  module_bound: (Bytes) -> Option<ModuleBinding> / {abort.raise | e},
  name_declared: (Bytes, Namespace, Bytes) -> Option<Declaration> / {abort.raise | e},
  module_declarations: (Bytes) -> Option<Declarations> / {abort.raise | e},
  visible_modules: () -> List<Bytes> / {abort.raise | e},
  every_module: () -> List<Bytes> / {abort.raise | e},
}

pub fn over_stored<a | e>(
  reads: StoredReads<| e>,
  body: () -> a / {program.read, module_names.read, mode_facts.read, summary_facts.read, abort.raise | e},
) -> a / {abort.raise | e} = ???
