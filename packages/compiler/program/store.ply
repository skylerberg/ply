import std.fs (fs)

pub type Query<| e> = {
  name: Bytes,
  hash: Bytes,
  body: (Bytes) -> Bytes / {abort.raise | e},
  file: Option<(Bytes) -> String>,
}

pub type Replaced = { key: Bytes, file: Option<String>, dead_bytes: Int }

pub fn released<[r]>(replaced: List<Replaced>) -> Unit / {fs.write[r]} = ???

pub fn unreferenced(key: Bytes, dependents: List<Bytes>, inputs: Map<Bytes, Bool>) -> Bool = ???

pub fn rewrite_due(live_bytes: Int, dead_bytes: Int) -> Bool = ???
