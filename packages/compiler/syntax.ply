import compiler.syntax.expressions
import compiler.syntax.expressions (Expression, LiteralExpression, NameExpression, BinaryExpression,
                                    UnaryExpression, LambdaExpression, CallExpression, IfExpression,
                                    MatchExpression, BlockExpression, RecordExpression,
                                    RecordUpdateExpression, PropagateExpression, FieldExpression,
                                    ListExpression, PerformExpression, HandleExpression,
                                    WithScopeExpression, SimulateExpression, ParallelExpression,
                                    TaggedLiteralExpression, InvalidExpression, HoleExpression,
                                    TryBlockExpression, Param, Statement, LetStatement,
                                    LetElseStatement, ExpressionStatement, AssignmentStatement,
                                    MatchArm, HandleClause, ReturnClause, HandlerStateVariable,
                                    NamedArg, RecordLiteralField, Hole, expression_span,
                                    written_operator)
import compiler.syntax.fmt
import compiler.syntax.items
import compiler.syntax.items (Module, Item, FunctionItem, TypeItem, EffectItem, TestItem, LawItem,
                              SchemaItem, DeriveItem, EffectSetItem, ExternItem, InstanceItem,
                              NumericItem, ImportDeclaration, WholeModule, ModuleAlias,
                              SelectedNames, Binder, SpecClause, RequiresClause, EnsuresClause,
                              CostClause, SpaceClause, VariantDefinition, OperationDefinition,
                              AliasBody, SumBody, NominalBody, ExternBody, item_span, item_doc,
                              is_pub, is_explicit_import)
import compiler.syntax.lexer
import compiler.syntax.parsing
import compiler.syntax.parsing (ParseDiagnostic, Parser, Input)
import compiler.syntax.patterns
import compiler.syntax.patterns (Pattern, PatternWildcard, PatternVariable, PatternLiteral,
                                 PatternRange, PatternConstructor, PatternRecord, PatternList,
                                 PatternOr, PatternInvalid, LiteralInt, LiteralString,
                                 LiteralInvalid, pattern_span)
import compiler.syntax.type_syntax
import compiler.syntax.type_syntax (TypeExpression, VariableTypeExpression, NamedTypeExpression,
                                    FunctionTypeExpression, RecordTypeExpression,
                                    UnitTypeExpression, InvalidTypeExpression, EffectsExpression,
                                    type_span, is_raise)
import std.bytes
import std.gen
import std.gen (Gen)
import std.list
import std.location (Location, location_at)

pub type Span = { start: Int, end: Int }

pub type Label = new { path: String, span: Span, place: Location, primary: Bool, text: String }

pub type Edit = new { path: String, span: Span, text: Bytes }

pub type Fix = new { title: String, edits: List<Edit> }

pub type Severity = | Error | Warning

pub type Diagnostic = new {
  code: String,
  severity: Severity,
  message: String,
  labels: List<Label>,
  notes: List<String>,
  fixes: List<Fix>,
}

pub fn primary(diagnostic: Diagnostic) -> Option<Label> =
  match diagnostic.labels.fold(None, |found: Option<Label>, label: Label|
      match found { Some(_) -> found, None -> if label.primary { Some(label) } else { None } }) {
    Some(label) -> Some(label),
    None -> diagnostic.labels.at(0),
  }

pub effect syntax {
  raise fail(reason: Diagnostic)
}

fn diagnostic_of(source: Bytes, diagnostic: ParseDiagnostic) -> Diagnostic =
  {
    code: String::of_bytes_lossy(diagnostic.code),
    severity: if diagnostic.severity == b"warning" { Warning } else { Error },
    message: String::of_bytes_lossy(diagnostic.message),
    labels: diagnostic.labels.map(|label: parsing::Label|
      {
        path: "",
        span: { start: label.start, end: label.end },
        place: location_at(source, label.start),
        primary: label.primary,
        text: String::of_bytes_lossy(label.text),
      }),
    notes: diagnostic.notes_text.map(|note: Bytes| String::of_bytes_lossy(note)),
    fixes: [],
  }

fn unexpected(source: Bytes, span: Span, message: String, label: String) -> Diagnostic =
  diagnostic_of(
    source,
    parsing::error_at(
      parsing::unexpected(),
      parsing::span_between(span.start, span.end),
      Bytes::of_string(message),
      Bytes::of_string(label),
      [],
    ),
  )

type Origin = {
  source: Bytes,
  comments: List<lexer::Comment>,
  binding: List<{ start: Int, end: Int, names: Map<Bytes, Bool> }>,
}

type NodeSyntax =
  | ModuleSyntax(Module)
  | ImportSyntax(ImportDeclaration)
  | ImportedNameSyntax(parsing::Identifier)
  | ImportAliasSyntax(parsing::Identifier)
  | ItemSyntax(Item)
  | VariantSyntax(VariantDefinition)
  | OperationSyntax(OperationDefinition)
  | ParameterSyntax(Param)
  | ClauseSyntax(SpecClause)
  | DecreasesSyntax(Expression)
  | EffectsSyntax(EffectsExpression)
  | ExpressionSyntax(Expression)
  | StatementSyntax(Statement)
  | ArmSyntax(MatchArm)
  | HandlerSyntax(HandleClause)
  | ReturnHandlerSyntax(ReturnClause)
  | HandlerVariableSyntax(HandlerStateVariable)
  | FieldSyntax({ name: parsing::Identifier, value: Expression })
  | PatternFieldSyntax({ name: parsing::Identifier, pattern: Pattern })
  | TypeFieldSyntax({ name: parsing::Identifier, ty: TypeExpression })
  | PatternSyntax(Pattern)
  | TypeSyntax(TypeExpression)

pub opaque type Node = | Node(Origin, NodeSyntax)

pub type Kind =
  | Module
  | Import
  | ImportedName
  | ImportAlias
  | Function
  | TypeDeclaration
  | EffectDeclaration
  | Test
  | Law
  | LawSchema
  | Derive
  | EffectSet
  | ExternFunction
  | Instance
  | Numeric
  | Variant
  | Operation
  | Parameter
  | Requires
  | Ensures
  | Cost
  | Space
  | Decreases
  | Effects
  | Literal
  | Name
  | Binary
  | Unary
  | Lambda
  | Call
  | If
  | Match
  | Block
  | RecordLiteral
  | Tuple
  | RecordUpdate
  | Propagate
  | Access
  | ListLiteral
  | MapLiteral
  | SetLiteral
  | Interpolation
  | TaggedLiteral
  | Perform
  | Handle
  | WithScope
  | Simulate
  | Parallel
  | TryBlock
  | Let
  | LetElse
  | Assignment
  | Arm
  | Handler
  | ReturnHandler
  | HandlerVariable
  | Field
  | Wildcard
  | Binding
  | LiteralPattern
  | RangePattern
  | ConstructorPattern
  | RecordPattern
  | TuplePattern
  | ListPattern
  | Alternatives
  | TypeVariable
  | TypeName
  | FunctionType
  | RecordType
  | TupleType
  | UnitType
  | Hole
  | Unparsed

pub type Identifier = new { text: String, span: Span }

pub type Comment = new { span: Span, text: String }

pub fn version() -> Int = 4

fn to_span(place: parsing::Span) -> Span = { start: place.start, end: place.end }

fn to_identifier(identifier: parsing::Identifier) -> Identifier =
  { text: String::of_bytes_lossy(identifier.name), span: to_span(identifier.span) }

fn binder_parameter(binder: Binder) -> Param =
  {
    name: binder.name,
    keep: false,
    ty: Some(binder.ty),
    cost: None,
    space: None,
    default: None,
    span: binder.span,
  }

fn untyped(name: parsing::Identifier) -> Param =
  { name: name, keep: false, ty: None, cost: None, space: None, default: None, span: name.span }

fn optional<a>(value: Option<a>, wrap: (a) -> NodeSyntax) -> List<NodeSyntax> =
  match value { Some(x) -> [wrap(x)], None -> [] }

fn as_types(ts: List<TypeExpression>) -> List<NodeSyntax> =
  ts.map(|t: TypeExpression| TypeSyntax(t))

fn as_values(es: List<Expression>) -> List<NodeSyntax> = es.map(|e: Expression| ExpressionSyntax(e))

fn as_params(ps: List<Param>) -> List<NodeSyntax> = ps.map(|p: Param| ParameterSyntax(p))

fn as_binders(bs: List<Binder>) -> List<NodeSyntax> =
  bs.map(|b: Binder| ParameterSyntax(binder_parameter(b)))

fn as_variables(names: List<parsing::Identifier>) -> List<NodeSyntax> =
  names.map(|name: parsing::Identifier| TypeSyntax(VariableTypeExpression(name)))

fn as_clauses(cs: List<SpecClause>) -> List<NodeSyntax> = cs.map(|c: SpecClause| ClauseSyntax(c))

fn as_fields(fs: List<RecordLiteralField>) -> List<NodeSyntax> =
  fs.map(|f: RecordLiteralField| FieldSyntax({ name: f.name, value: f.value }))

fn all_of(parts: List<List<NodeSyntax>>) -> List<NodeSyntax> =
  parts.flat_map(|part: List<NodeSyntax>| part)

fn span_of(source: Bytes, at: NodeSyntax) -> Span = to_span(parsed_span(source, at))

fn parsed_span(source: Bytes, at: NodeSyntax) -> parsing::Span =
  match at {
    ModuleSyntax(_) -> parsing::span_between(0, source.len()),
    ImportSyntax(d) -> d.span,
    ImportedNameSyntax(i) -> i.span,
    ImportAliasSyntax(i) -> i.span,
    ItemSyntax(item) -> item_span(item),
    VariantSyntax(v) -> v.span,
    OperationSyntax(o) -> o.span,
    ParameterSyntax(p) -> p.span,
    ClauseSyntax(c) -> c.span,
    DecreasesSyntax(e) -> expression_span(e),
    EffectsSyntax(r) -> r.span,
    ExpressionSyntax(e) -> expression_span(e),
    StatementSyntax(statement) -> match statement {
      LetStatement(v) -> v.span,
      LetElseStatement(v) -> v.span,
      ExpressionStatement(e) -> expression_span(e),
      AssignmentStatement(v) -> v.span,
    },
    ArmSyntax(arm) -> arm.span,
    HandlerSyntax(c) -> c.span,
    ReturnHandlerSyntax(r) -> r.span,
    HandlerVariableSyntax(v) -> v.span,
    FieldSyntax(f) -> parsing::span_to(f.name.span, expression_span(f.value)),
    PatternFieldSyntax(f) -> parsing::span_to(f.name.span, pattern_span(f.pattern)),
    TypeFieldSyntax(f) -> parsing::span_to(f.name.span, type_span(f.ty)),
    PatternSyntax(p) -> pattern_span(p),
    TypeSyntax(t) -> type_span(t),
  }

fn in_order(source: Bytes, parts: List<NodeSyntax>) -> List<NodeSyntax> =
  parts.sort_by(|a: NodeSyntax, b: NodeSyntax| span_of(source, a).start < span_of(source, b).start)

fn item_parts(item: Item) -> List<NodeSyntax> =
  match item {
    FunctionItem(d) ->
      all_of([
        as_params(d.params),
        optional(d.return_type, |t: TypeExpression| TypeSyntax(t)),
        optional(d.effects, |r: EffectsExpression| EffectsSyntax(r)),
        as_clauses(d.spec),
        optional(d.decreases, |e: Expression| DecreasesSyntax(e)),
        [ExpressionSyntax(d.body)],
      ]),
    TypeItem(d) -> match d.body {
      AliasBody(t) -> [TypeSyntax(t)],
      SumBody(vs) -> vs.map(|v: VariantDefinition| VariantSyntax(v)),
      NominalBody(t) -> [TypeSyntax(t)],
      ExternBody -> [],
    },
    EffectItem(d) -> d.operations.map(|o: OperationDefinition| OperationSyntax(o)),
    TestItem(d) ->
      all_of([
        match d.cases {
          Some(c) ->
            all_of([
              as_values(fmt::holes_of(c.label)),
              [
                ParameterSyntax({
                  name: c.binder,
                  keep: false,
                  ty: Some(c.ty),
                  cost: None,
                  space: None,
                  default: None,
                  span: parsing::span_to(c.binder.span, type_span(c.ty)),
                }),
                ExpressionSyntax(c.table),
              ],
            ]),
          None -> [],
        },
        [ExpressionSyntax(d.body)],
      ]),
    LawItem(d) ->
      all_of([
        as_binders(d.binders),
        as_variables(d.identities),
        optional(d.guard, |e: Expression| ExpressionSyntax(e)),
        [ExpressionSyntax(d.body)],
      ]),
    SchemaItem(d) ->
      all_of([
        as_binders(d.params),
        as_binders(d.binders),
        as_variables(d.identities),
        optional(d.guard, |e: Expression| ExpressionSyntax(e)),
        [ExpressionSyntax(d.body)],
      ]),
    ExternItem(d) ->
      all_of([
        as_params(d.params),
        [TypeSyntax(d.return_type)],
        optional(d.effects, |r: EffectsExpression| EffectsSyntax(r)),
        as_clauses(d.spec),
      ]),
    DeriveItem(_) -> [],
    EffectSetItem(_) -> [],
    InstanceItem(_) -> [],
    NumericItem(_) -> [],
  }

fn statement(statement: Statement) -> NodeSyntax =
  match statement { ExpressionStatement(e) -> ExpressionSyntax(e), _ -> StatementSyntax(statement) }

fn is_operator(e: Expression) -> Bool =
  match e {
    CallExpression(v) -> match written_operator(v.function, v.args) {
      Some(_) -> true,
      None -> false,
    },
    _ -> false,
  }

fn is_display(e: Expression) -> Bool =
  match e {
    CallExpression(v) -> match v.function {
      NameExpression(f) -> match f.name.module {
        Some(binder) -> expressions::is_hidden_binder(binder.name),
        None -> false,
      },
      _ -> false,
    },
    _ -> false,
  }

fn expression_parts(source: Bytes, e: Expression) -> List<NodeSyntax> / {abort.raise} =
  match fmt::surface_syntax(source, e) {
    fmt::Interpolated(holes) -> as_values(holes),
    fmt::MapLiteral(entries) ->
      entries.flat_map(|entry: { key: Expression, value: Expression }|
        [ExpressionSyntax(entry.key), ExpressionSyntax(entry.value)]),
    fmt::SetLiteral(xs) -> as_values(xs),
    fmt::AsParsed -> match e {
      LiteralExpression(_) -> [],
      NameExpression(_) -> [],
      BinaryExpression(v) -> [ExpressionSyntax(v.left_operand), ExpressionSyntax(v.right_operand)],
      UnaryExpression(v) -> [ExpressionSyntax(v.operand)],
      LambdaExpression(v) ->
        all_of([
          as_params(v.params),
          optional(v.return_clause, |t: TypeExpression| TypeSyntax(t)),
          [ExpressionSyntax(v.body)],
        ]),
      CallExpression(v) -> if is_operator(e) || is_display(e) { as_values(v.args) } else {
        in_order(
          source,
          all_of([
            [ExpressionSyntax(v.function)],
            as_values(v.args),
            v.named.map(|arg: NamedArg| FieldSyntax({ name: arg.name, value: arg.value })),
          ]),
        )
      },
      IfExpression(v) ->
        all_of([
          [ExpressionSyntax(v.cond), ExpressionSyntax(v.then_branch)],
          match v.else_branch { LiteralExpression(_) -> [], other -> [ExpressionSyntax(other)] },
        ]),
      MatchExpression(v) ->
        all_of([[ExpressionSyntax(v.scrutinee)], v.arms.map(|arm: MatchArm| ArmSyntax(arm))]),
      BlockExpression(v) ->
        all_of([
          v.statements.map(statement),
          optional(v.tail, |x: Expression| ExpressionSyntax(x)),
        ]),
      RecordExpression(v) -> if fmt::is_tuple(v.fields) {
        v.fields.map(|f: RecordLiteralField| ExpressionSyntax(f.value))
      } else { as_fields(v.fields) },
      RecordUpdateExpression(v) -> all_of([[ExpressionSyntax(v.base)], as_fields(v.fields)]),
      PropagateExpression(v) -> [ExpressionSyntax(v.operand)],
      FieldExpression(v) -> [ExpressionSyntax(v.base)],
      ListExpression(v) -> as_values(v.items),
      PerformExpression(v) -> as_values(v.args),
      HandleExpression(v) ->
        in_order(
          source,
          all_of([
            [ExpressionSyntax(v.body)],
            v.handler_variables.map(|x: HandlerStateVariable| HandlerVariableSyntax(x)),
            v.clauses.map(|c: HandleClause| HandlerSyntax(c)),
            optional(v.return_clause, |r: ReturnClause| ReturnHandlerSyntax(r)),
          ]),
        ),
      WithScopeExpression(v) ->
        [
          ExpressionSyntax(v.acquire),
          ExpressionSyntax(v.release),
          ParameterSyntax(untyped(v.binder)),
          ExpressionSyntax(v.body),
        ],
      SimulateExpression(v) -> [ExpressionSyntax(v.body)],
      ParallelExpression(v) -> as_values(v.branches),
      TaggedLiteralExpression(t) -> t.holes.map(|h: Hole| ExpressionSyntax(h.value)),
      HoleExpression(_) -> [],
      InvalidExpression(_) -> [],
      TryBlockExpression(v) -> [ExpressionSyntax(v.body)],
    },
  }

fn pattern_parts(p: Pattern) -> List<NodeSyntax> / {abort.raise} =
  match p {
    PatternWildcard(_) -> [],
    PatternVariable(_) -> [],
    PatternLiteral(_) -> [],
    PatternRange(_) -> [],
    PatternConstructor(v) -> v.args.map(|x: Pattern| PatternSyntax(x)),
    PatternRecord(v) -> if fmt::is_pattern_tuple(v.fields) {
      v.fields.map(|f: { name: parsing::Identifier, pattern: Pattern }| PatternSyntax(f.pattern))
    } else {
      v.fields.map(|f: { name: parsing::Identifier, pattern: Pattern }| PatternFieldSyntax(f))
    },
    PatternList(v) ->
      all_of([
        v.items.map(|x: Pattern| PatternSyntax(x)),
        optional(v.rest, |x: Pattern| PatternSyntax(x)),
      ]),
    PatternOr(v) -> v.alternatives.map(|x: Pattern| PatternSyntax(x)),
    PatternInvalid(_) -> [],
  }

fn type_parts(t: TypeExpression) -> List<NodeSyntax> / {abort.raise} =
  match t {
    VariableTypeExpression(_) -> [],
    NamedTypeExpression(x) -> as_types(x.args),
    FunctionTypeExpression(x) ->
      all_of([
        as_types(x.params),
        [TypeSyntax(x.return_type)],
        optional(x.effects, |r: EffectsExpression| EffectsSyntax(r)),
      ]),
    RecordTypeExpression(x) -> if fmt::is_type_tuple(x.fields) {
      x.fields.map(|f: { name: parsing::Identifier, ty: TypeExpression }| TypeSyntax(f.ty))
    } else {
      x.fields.map(|f: { name: parsing::Identifier, ty: TypeExpression }| TypeFieldSyntax(f))
    },
    UnitTypeExpression(_) -> [],
    InvalidTypeExpression(_) -> [],
  }

fn parts_of(source: Bytes, at: NodeSyntax) -> List<NodeSyntax> / {abort.raise} =
  match at {
    ModuleSyntax(m) ->
      all_of([
        m.imports.filter(is_explicit_import).map(|d: ImportDeclaration| ImportSyntax(d)),
        m.items.map(|item: Item| ItemSyntax(item)),
      ]),
    ImportSyntax(d) -> match d.kind {
      WholeModule -> [],
      ModuleAlias(binder) -> [ImportAliasSyntax(binder)],
      SelectedNames(names) -> names.map(|n: parsing::Identifier| ImportedNameSyntax(n)),
    },
    ImportedNameSyntax(_) -> [],
    ImportAliasSyntax(_) -> [],
    ItemSyntax(item) -> item_parts(item),
    VariantSyntax(v) -> as_types(v.fields),
    OperationSyntax(o) -> if is_raise(o.mode) { as_types(o.params) }
    else { as_types(o.params).push(TypeSyntax(o.return_type)) },
    ParameterSyntax(p) ->
      all_of([
        optional(p.ty, |t: TypeExpression| TypeSyntax(t)),
        optional(p.default, |e: Expression| ExpressionSyntax(e)),
      ]),
    ClauseSyntax(c) -> [ExpressionSyntax(c.expression)],
    DecreasesSyntax(e) -> [ExpressionSyntax(e)],
    EffectsSyntax(_) -> [],
    ExpressionSyntax(e) -> expression_parts(source, e),
    StatementSyntax(statement) -> match statement {
      LetStatement(v) ->
        all_of([
          [PatternSyntax(v.pattern)],
          optional(v.ty, |t: TypeExpression| TypeSyntax(t)),
          [ExpressionSyntax(v.value)],
        ]),
      LetElseStatement(v) ->
        all_of([
          [PatternSyntax(v.pattern)],
          optional(v.ty, |t: TypeExpression| TypeSyntax(t)),
          [ExpressionSyntax(v.value), ExpressionSyntax(v.fallback)],
        ]),
      ExpressionStatement(e) -> [ExpressionSyntax(e)],
      AssignmentStatement(v) -> [ExpressionSyntax(v.value)],
    },
    HandlerVariableSyntax(v) ->
      all_of([optional(v.ty, |t: TypeExpression| TypeSyntax(t)), [ExpressionSyntax(v.init)]]),
    ArmSyntax(arm) ->
      all_of([
        [PatternSyntax(arm.pattern)],
        optional(arm.guard, |e: Expression| ExpressionSyntax(e)),
        [ExpressionSyntax(arm.body)],
      ]),
    HandlerSyntax(c) ->
      in_order(
        source,
        all_of([
          c.params.map(|p: parsing::Identifier| ParameterSyntax(untyped(p))),
          optional(c.resume, |k: parsing::Identifier| ParameterSyntax(untyped(k))),
          [ExpressionSyntax(c.body)],
        ]),
      ),
    ReturnHandlerSyntax(r) -> [ParameterSyntax(untyped(r.binder)), ExpressionSyntax(r.body)],
    FieldSyntax(f) -> [ExpressionSyntax(f.value)],
    PatternFieldSyntax(f) -> [PatternSyntax(f.pattern)],
    TypeFieldSyntax(f) -> [TypeSyntax(f.ty)],
    PatternSyntax(p) -> pattern_parts(p),
    TypeSyntax(t) -> type_parts(t),
  }

fn item_kind(item: Item) -> Kind =
  match item {
    FunctionItem(_) -> Function,
    TypeItem(_) -> TypeDeclaration,
    EffectItem(_) -> EffectDeclaration,
    TestItem(_) -> Test,
    LawItem(_) -> Law,
    SchemaItem(_) -> LawSchema,
    DeriveItem(_) -> Derive,
    EffectSetItem(_) -> EffectSet,
    ExternItem(_) -> ExternFunction,
    InstanceItem(_) -> Instance,
    NumericItem(_) -> Numeric,
  }

fn expression_kind(source: Bytes, e: Expression) -> Kind / {abort.raise} =
  match fmt::surface_syntax(source, e) {
    fmt::Interpolated(_) -> Interpolation,
    fmt::MapLiteral(_) -> MapLiteral,
    fmt::SetLiteral(_) -> SetLiteral,
    fmt::AsParsed -> match e {
      LiteralExpression(v) -> match v.literal { LiteralInvalid -> Unparsed, _ -> Literal },
      NameExpression(_) -> Name,
      BinaryExpression(_) -> Binary,
      UnaryExpression(_) -> Unary,
      LambdaExpression(_) -> Lambda,
      CallExpression(_) -> if is_operator(e) { Binary }
      else if is_display(e) { Interpolation }
      else { Call },
      IfExpression(_) -> If,
      MatchExpression(_) -> Match,
      BlockExpression(_) -> Block,
      RecordExpression(v) -> if fmt::is_tuple(v.fields) { Tuple } else { RecordLiteral },
      RecordUpdateExpression(_) -> RecordUpdate,
      PropagateExpression(_) -> Propagate,
      FieldExpression(_) -> Access,
      ListExpression(_) -> ListLiteral,
      PerformExpression(_) -> Perform,
      HandleExpression(_) -> Handle,
      WithScopeExpression(_) -> WithScope,
      SimulateExpression(_) -> Simulate,
      ParallelExpression(_) -> Parallel,
      TaggedLiteralExpression(_) -> TaggedLiteral,
      HoleExpression(_) -> Hole,
      InvalidExpression(_) -> Unparsed,
      TryBlockExpression(_) -> TryBlock,
    },
  }

fn kind_of(source: Bytes, at: NodeSyntax) -> Kind / {abort.raise} =
  match at {
    ModuleSyntax(_) -> Module,
    ImportSyntax(_) -> Import,
    ImportedNameSyntax(_) -> ImportedName,
    ImportAliasSyntax(_) -> ImportAlias,
    ItemSyntax(item) -> item_kind(item),
    VariantSyntax(_) -> Variant,
    OperationSyntax(_) -> Operation,
    ParameterSyntax(_) -> Parameter,
    ClauseSyntax(c) -> match c.kind {
      RequiresClause -> Requires,
      EnsuresClause -> Ensures,
      CostClause -> Cost,
      SpaceClause -> Space,
    },
    DecreasesSyntax(_) -> Decreases,
    EffectsSyntax(_) -> Effects,
    ExpressionSyntax(e) -> expression_kind(source, e),
    StatementSyntax(statement) -> match statement {
      LetElseStatement(_) -> LetElse,
      AssignmentStatement(_) -> Assignment,
      _ -> Let,
    },
    ArmSyntax(_) -> Arm,
    HandlerSyntax(_) -> Handler,
    ReturnHandlerSyntax(_) -> ReturnHandler,
    HandlerVariableSyntax(_) -> HandlerVariable,
    FieldSyntax(_) -> Field,
    PatternFieldSyntax(_) -> Field,
    TypeFieldSyntax(_) -> Field,
    PatternSyntax(p) -> match p {
      PatternWildcard(_) -> Wildcard,
      PatternVariable(_) -> Binding,
      PatternLiteral(_) -> LiteralPattern,
      PatternRange(_) -> RangePattern,
      PatternConstructor(_) -> ConstructorPattern,
      PatternRecord(v) -> if fmt::is_pattern_tuple(v.fields) { TuplePattern }
      else { RecordPattern },
      PatternList(_) -> ListPattern,
      PatternOr(_) -> Alternatives,
      PatternInvalid(_) -> Unparsed,
    },
    TypeSyntax(t) -> match t {
      VariableTypeExpression(_) -> TypeVariable,
      NamedTypeExpression(_) -> TypeName,
      FunctionTypeExpression(_) -> FunctionType,
      RecordTypeExpression(x) -> if fmt::is_type_tuple(x.fields) { TupleType } else { RecordType },
      UnitTypeExpression(_) -> UnitType,
      InvalidTypeExpression(_) -> Unparsed,
    },
  }

fn import_path(d: ImportDeclaration) -> parsing::Identifier =
  {
    name: Bytes::join(d.path.map(|part: parsing::Identifier| part.name), b"."),
    span: match ((d.path.at(0), d.path.at(d.path.len() - 1))) {
      (Some(first), Some(last)) -> parsing::span_to(first.span, last.span),
      _ -> d.span,
    },
  }

fn item_name(item: Item) -> parsing::Identifier =
  match item {
    FunctionItem(d) -> d.name,
    TypeItem(d) -> d.name,
    EffectItem(d) -> d.name,
    TestItem(d) -> { name: d.label, span: d.label_span },
    LawItem(d) -> { name: d.name, span: d.name_span },
    SchemaItem(d) -> d.name,
    DeriveItem(d) -> d.target,
    EffectSetItem(d) -> d.name,
    ExternItem(d) -> d.name,
    InstanceItem(d) -> d.target,
    NumericItem(d) -> d.target,
  }

fn name_of(at: NodeSyntax) -> Option<parsing::Identifier> =
  match at {
    ImportSyntax(d) -> Some(import_path(d)),
    ImportedNameSyntax(i) -> Some(i),
    ImportAliasSyntax(i) -> Some(i),
    ItemSyntax(item) -> Some(item_name(item)),
    VariantSyntax(v) -> Some(v.name),
    OperationSyntax(o) -> Some(o.name),
    ParameterSyntax(p) -> Some(p.name),
    ExpressionSyntax(e) -> match e {
      NameExpression(v) -> Some(v.name.name),
      FieldExpression(v) -> Some(v.field),
      PerformExpression(v) -> Some(v.operation),
      TaggedLiteralExpression(t) -> Some(t.tag),
      _ -> None,
    },
    HandlerSyntax(c) -> Some(c.operation),
    HandlerVariableSyntax(v) -> Some(v.name),
    StatementSyntax(statement) -> match statement {
      AssignmentStatement(v) -> Some(v.name),
      _ -> None,
    },
    FieldSyntax(f) -> Some(f.name),
    PatternFieldSyntax(f) -> Some(f.name),
    TypeFieldSyntax(f) -> Some(f.name),
    PatternSyntax(p) -> match p {
      PatternVariable(v) -> Some(v.name),
      PatternConstructor(v) -> Some(v.name.name),
      _ -> None,
    },
    TypeSyntax(t) -> match t {
      VariableTypeExpression(i) -> Some(i),
      NamedTypeExpression(x) -> Some(x.name.name),
      _ -> None,
    },
    _ -> None,
  }

fn qualifier_of(at: NodeSyntax) -> Option<parsing::Identifier> =
  match at {
    ExpressionSyntax(e) -> match e {
      NameExpression(v) -> v.name.module,
      PerformExpression(v) -> Some(v.effect_name.name),
      _ -> None,
    },
    HandlerSyntax(c) -> Some(c.effect_name.name),
    PatternSyntax(p) -> match p { PatternConstructor(v) -> v.name.module, _ -> None },
    TypeSyntax(t) -> match t { NamedTypeExpression(x) -> x.name.module, _ -> None },
    _ -> None,
  }

fn named(found: Option<parsing::Identifier>) -> Option<Identifier> =
  match found { Some(identifier) -> Some(to_identifier(identifier)), None -> None }

pub fn kind(node: Node) -> Kind / {abort.raise} =
  match node { Node(origin, at) -> kind_of(origin.source, at) }

pub fn span(node: Node) -> Span = match node { Node(origin, at) -> span_of(origin.source, at) }

pub fn source(node: Node) -> Bytes = match node { Node(origin, _) -> origin.source }

pub fn text(node: Node) -> Bytes / {abort.raise} =
  match node {
    Node(origin, at) -> {
      let s = span_of(origin.source, at);
      origin.source.slice(s.start, s.end)
    },
  }

pub fn place(node: Node) -> Location =
  match node { Node(origin, at) -> location_at(origin.source, span_of(origin.source, at).start) }

pub fn children(node: Node) -> List<Node> / {abort.raise} =
  match node {
    Node(origin, at) ->
      parts_of(origin.source, at).map(|part: NodeSyntax|
        Node(origin, resolve_method_call(origin, part))),
  }

fn resolve_method_call(origin: Origin, at: NodeSyntax) -> NodeSyntax =
  match at {
    ExpressionSyntax(e) -> match e {
      PerformExpression(p) -> if p.effect_name.module != None
          || !bound_at(origin, p.span.start, p.effect_name.name.name) { at } else {
        let on = NameExpression({ span: p.effect_name.span, name: p.effect_name });
        ExpressionSyntax(
          CallExpression({
            span: p.span,
            function: FieldExpression({
              span: parsing::span_to(p.effect_name.span, p.operation.span),
              base: on,
              field: p.operation,
            }),
            named: [],
            args: p.args,
            labels: match p.resource { Some(r) -> [r], None -> [] },
          }),
        )
      },
      _ -> at,
    },
    _ -> at,
  }

fn bound_at(origin: Origin, at: Int, name: Bytes) -> Bool =
  origin.binding.fold(false, |found: Bool, b: { start: Int, end: Int, names: Map<Bytes, Bool> }|
    found || (at >= b.start && at < b.end && b.names.contains(name)))

pub fn name(node: Node) -> Option<Identifier> = match node { Node(_, at) -> named(name_of(at)) }

pub fn qualifier(node: Node) -> Option<Identifier> =
  match node { Node(_, at) -> named(qualifier_of(at)) }

pub fn operator(node: Node) -> Option<String> =
  match node {
    Node(_, ExpressionSyntax(e)) -> match e {
      BinaryExpression(v) -> Some(String::of_bytes_lossy(fmt::operation_text(v.operation))),
      UnaryExpression(v) -> Some(String::of_bytes_lossy(fmt::unary_text(v.operation))),
      CallExpression(v) -> match written_operator(v.function, v.args) {
        Some(o) -> Some(String::of_bytes_lossy(o.text)),
        None -> None,
      },
      _ -> None,
    },
    _ -> None,
  }

pub fn string_value(node: Node) -> Option<String> =
  match node {
    Node(_, ExpressionSyntax(LiteralExpression(v))) -> match v.literal {
      LiteralString(s) -> Some(String::of_bytes_lossy(s)),
      _ -> None,
    },
    _ -> None,
  }

pub fn int_value(node: Node) -> Option<Int> =
  match node {
    Node(_, ExpressionSyntax(LiteralExpression(v))) -> match v.literal {
      LiteralInt(n) -> Some(n),
      _ -> None,
    },
    _ -> None,
  }

pub fn is_public(node: Node) -> Bool =
  match node {
    Node(_, ItemSyntax(item)) -> match item {
      FunctionItem(d) -> is_pub(d.visibility),
      TypeItem(d) -> is_pub(d.visibility),
      EffectItem(d) -> is_pub(d.visibility),
      SchemaItem(d) -> is_pub(d.visibility),
      EffectSetItem(d) -> is_pub(d.visibility),
      _ -> false,
    },
    _ -> false,
  }

pub fn doc(node: Node) -> List<String> = {
  let documentation = match node {
    Node(_, ModuleSyntax(m)) -> m.doc,
    Node(_, ItemSyntax(item)) -> item_doc(item),
    Node(_, VariantSyntax(v)) -> v.doc,
    Node(_, OperationSyntax(o)) -> o.doc,
    _ -> None,
  };
  match documentation {
    Some(d) -> d.lines.map(|line: Bytes| String::of_bytes_lossy(line)),
    None -> [],
  }
}

pub fn comments(node: Node) -> List<Comment> / {abort.raise} =
  match node {
    Node(origin, at) -> {
      let within = span_of(origin.source, at);
      origin.comments.fold([], |found: List<Comment>, c: lexer::Comment|
        if c.start < within.start || c.end > within.end { found } else {
          found.push({
            span: { start: c.start, end: c.end },
            text: String::of_bytes_lossy(origin.source.slice(c.start, c.end)),
          })
        })
    },
  }

fn walk_into(node: Node, room: Int, found: List<Node>) -> List<Node> / {abort.raise} =
  if room <= 0 { panic("the syntax tree is nested more deeply than the source text allows") } else {
    children(node).fold(found.push(node), |so_far: List<Node>, child: Node|
      walk_into(child, room - 1, so_far))
  }

pub fn walk(node: Node) -> List<Node> / {abort.raise} =
  walk_into(node, 4 * source(node).len() + 64, [])

fn contains_offset(node: Node, offset: Int) -> Bool =
  span(node).start <= offset && offset < span(node).end

pub fn enclosing(node: Node, offset: Int) -> List<Node> / {abort.raise} =
  if !contains_offset(node, offset) { [] } else {
    iterate(
      { at: node, path: [node] },
      4 * source(node).len() + 64,
      |s: { at: Node, path: List<Node> }|
        match children(s.at).filter(|child: Node| contains_offset(child, offset)) {
          [] -> Stop(s.path),
          [inner, ..] -> Continue({ at: inner, path: s.path.push(inner) }),
        },
    )
  }

pub fn shape(node: Node) -> Bytes / {abort.raise} =
  match node { Node(origin, at) -> shape_of(origin.source, at, 8) }

fn shape_of(source: Bytes, at: NodeSyntax, room: Int) -> Bytes / {abort.raise} =
  match at {
    ModuleSyntax(m) -> parsing::erase_spans(items::dump_module(m)),
    ItemSyntax(item) -> parsing::erase_spans(items::dump_item(item)),
    ExpressionSyntax(e) -> parsing::erase_spans(expressions::dump_expression(e)),
    PatternSyntax(p) -> parsing::erase_spans(patterns::dump_pattern(p)),
    TypeSyntax(t) -> parsing::erase_spans(type_syntax::dump_type(t)),
    ParameterSyntax(p) -> parsing::erase_spans(expressions::dump_param(p)),
    EffectsSyntax(r) -> parsing::erase_spans(type_syntax::dump_effects_expression(r)),
    _ -> if room <= 0 { b"" } else {
      Bytes::concat_all(
        parts_of(source, at).fold(
          [
            part_tag(at),
            b"(",
            match name_of(at) { Some(identifier) -> identifier.name, None -> b"" },
            b")",
          ],
          |accumulator: List<Bytes>, part: NodeSyntax| {
            let inner = shape_of(source, part, room - 1);
            accumulator.push(Bytes::of_string(inner.len().to_string())).push(b":").push(inner)
          },
        ),
      )
    },
  }

fn part_tag(at: NodeSyntax) -> Bytes =
  match at {
    ImportSyntax(_) -> b"import",
    ImportedNameSyntax(_) -> b"imported",
    ImportAliasSyntax(_) -> b"alias",
    VariantSyntax(_) -> b"variant",
    OperationSyntax(_) -> b"operation",
    ClauseSyntax(c) -> items::spec_kind_text(c.kind),
    DecreasesSyntax(_) -> b"decreases",
    StatementSyntax(statement) -> match statement {
      LetElseStatement(_) -> b"let-else",
      AssignmentStatement(_) -> b"assign",
      _ -> b"let",
    },
    ArmSyntax(_) -> b"arm",
    HandlerSyntax(_) -> b"handler",
    ReturnHandlerSyntax(_) -> b"return",
    HandlerVariableSyntax(_) -> b"var",
    FieldSyntax(_) -> b"field",
    PatternFieldSyntax(_) -> b"field",
    TypeFieldSyntax(_) -> b"field",
    _ -> b"",
  }

pub type ParseResult = new { tree: Node, diagnostics: List<Diagnostic> }

fn origin_of(source: Bytes, spans: List<parsing::Span>) -> Origin / {abort.raise} =
  {
    source: source,
    comments: lexer::lex(source).comments,
    binding: spans.map(|s: parsing::Span|
      {
        start: s.start,
        end: s.end,
        names: lexer::bound_names(lexer::lex(source.slice(s.start, s.end)).tokens),
      }),
  }

fn origin_whole(text: Bytes) -> Origin / {abort.raise} =
  origin_of(text, [parsing::span_between(0, text.len())])

pub fn parse(source: Bytes) -> ParseResult / {abort.raise} = {
  let read = items::parse(source);
  {
    tree: Node(origin_of(source, read.node.items.map(item_span)), ModuleSyntax(read.node)),
    diagnostics: read.parser.diagnostics.map(|diagnostic: ParseDiagnostic|
      diagnostic_of(source, diagnostic)),
  }
}

pub fn format(source: Bytes) -> Result<Bytes, Diagnostic> / {abort.raise} =
  match fmt::fmt_source(source) {
    Ok(out) -> Ok(out),
    Err(reason) -> match items::parse(source).parser.diagnostics.at(0) {
      Some(diagnostic) -> Err(diagnostic_of(source, diagnostic)),
      None ->
        Err(
          diagnostic_of(
            source,
            parsing::error_at(b"E0505", parsing::dummy_span(), reason, b"not printed", []),
          ),
        ),
    },
  }

pub fn formatted(source: Bytes) -> Bytes / {abort.raise} =
  match format(source) { Ok(out) -> out, Err(_) -> source }

fn starts_before(a: Edit, b: Edit) -> Bool = a.span.start < b.span.start

pub fn apply_edits(source: Bytes, edits: List<Edit>) -> Option<Bytes> = {
  let ordered = edits.sort_by(starts_before);
  let wrap = ordered.fold(
    Some({ out: [], from: 0 }),
    |accumulator: Option<{ out: List<Bytes>, from: Int }>, edit: Edit|
      match accumulator {
        None -> None,
        Some(so_far) -> if edit.span.start < so_far.from || edit.span.end < edit.span.start
            || edit.span.end > source.len() { None } else {
          match try[abort.raise] { source.slice(so_far.from, edit.span.start) } {
            Err(_) -> None,
            Ok(unchanged_text) ->
              Some({ out: so_far.out.push(unchanged_text).push(edit.text), from: edit.span.end }),
          }
        },
      },
  );
  match wrap {
    None -> None,
    Some(done) -> match try[abort.raise] { source.slice(done.from, source.len()) } {
      Err(_) -> None,
      Ok(rest) -> Some(Bytes::concat_all(done.out.push(rest))),
    },
  }
}

fn fragment_diagnostic(
  source: Bytes,
  input: Input,
  parser: Parser,
  what: String,
) -> Option<Diagnostic> =
  match parser.diagnostics.at(0) {
    Some(diagnostic) -> Some(diagnostic_of(source, diagnostic)),
    None -> if parsing::at_eof(input, parser) { None } else {
      Some(
        unexpected(
          source,
          to_span(parsing::current_span(input, parser)),
          "expected the end of " ++ what,
          "the " ++ what ++ " ends before this",
        ),
      )
    },
  }

fn parse_failure(parser: Parser, source: Bytes) -> Diagnostic =
  match parser.diagnostics.at(0) {
    Some(diagnostic) -> diagnostic_of(source, diagnostic),
    None -> unexpected(source, { start: 0, end: 0 }, "this does not parse", "here"),
  }

pub fn expression(text: Bytes) -> Result<Node, Diagnostic> / {abort.raise} = {
  let s = parsing::start(text);
  match expressions::expression(s.input, s.parser) {
    Err(parser) -> Err(parse_failure(parser, text)),
    Ok(read) -> match fragment_diagnostic(text, s.input, read.parser, "expression") {
      Some(reason) -> Err(reason),
      None -> {
        let origin = origin_whole(text);
        Ok(Node(origin, resolve_method_call(origin, ExpressionSyntax(read.node))))
      },
    },
  }
}

pub fn pattern(text: Bytes) -> Result<Node, Diagnostic> / {abort.raise} = {
  let s = parsing::start(text);
  match patterns::pattern(s.input, s.parser) {
    Err(parser) -> Err(parse_failure(parser, text)),
    Ok(read) -> match fragment_diagnostic(text, s.input, read.parser, "pattern") {
      Some(reason) -> Err(reason),
      None -> Ok(Node(origin_whole(text), PatternSyntax(read.node))),
    },
  }
}

pub fn type_expression(text: Bytes) -> Result<Node, Diagnostic> / {abort.raise} = {
  let s = parsing::start(text);
  match type_syntax::ty(s.input, s.parser) {
    Err(parser) -> Err(parse_failure(parser, text)),
    Ok(read) -> match fragment_diagnostic(text, s.input, read.parser, "type") {
      Some(reason) -> Err(reason),
      None -> Ok(Node(origin_whole(text), TypeSyntax(read.node))),
    },
  }
}

pub fn item(text: Bytes) -> Result<Node, Diagnostic> / {abort.raise} = {
  let read = items::parse(text);
  match read.parser.diagnostics.at(0) {
    Some(diagnostic) -> Err(diagnostic_of(text, diagnostic)),
    None -> match ((read.node.imports.filter(is_explicit_import), read.node.items)) {
      ([], [one]) -> Ok(Node(origin_whole(text), ItemSyntax(one))),
      _ ->
        Err(
          unexpected(
            text,
            { start: 0, end: text.len() },
            "expected one item and no import",
            "not one item",
          ),
        ),
    },
  }
}

pub fn identifier(text: String) -> Result<Node, Diagnostic> / {abort.raise} = {
  let given = Bytes::of_string(text);
  let lexed = lexer::lex(given);
  match ((lexed.diagnostics, lexed.tokens)) {
    ([], [first, _]) -> match first.kind {
      lexer::Identifier(n) -> {
        let at = parsing::span_between(first.start, first.end);
        Ok(
          Node(
            { source: given, comments: [], binding: [] },
            ExpressionSyntax(
              NameExpression({ span: at, name: parsing::bare({ name: n, span: at }) }),
            ),
          ),
        )
      },
      _ -> Err(not_a_name(given)),
    },
    _ -> Err(not_a_name(given)),
  }
}

fn not_a_name(given: Bytes) -> Diagnostic =
  unexpected(given, { start: 0, end: given.len() }, "expected one name", "not a name")

type HoleKind = | AsName | AsExpression | AsPattern | AsType

pub opaque type Template = | Template(List<Bytes>, List<HoleKind>)

pub type Malformed = { message: String, offset: Int }

pub type MalformedPart = { message: String, offset: Int, part: Int }

fn hole_name(i: Int) -> Bytes = b"hole__".concat(Bytes::of_string(i.to_string()))

fn character_count(text: Bytes, upto: Int) -> Int =
  String::of_bytes_lossy(match try[abort.raise] { text.slice(0, upto) } {
    Ok(before) -> before,
    Err(_) -> text,
  }).len(
  )

fn assemble_parts(texts: List<Bytes>) -> { whole: Bytes, starts: List<Int> } =
  range(0, texts.len()).fold(
    { whole: b"", starts: [] },
    |accumulator: { whole: Bytes, starts: List<Int> }, i: Int| {
      let led = if i == 0 { accumulator.whole } else { accumulator.whole.concat(hole_name(i - 1)) };
      { whole: led.concat(texts.at_or(i, b"")), starts: accumulator.starts.push(led.len()) }
    },
  )

fn locate_part(texts: List<Bytes>, starts: List<Int>, offset: Int) -> { part: Int, offset: Int } =
  range(0, texts.len()).fold({ part: 0, offset: 0 }, |found: { part: Int, offset: Int }, i: Int| {
    let from = starts.at_or(i, 0);
    let text = texts.at_or(i, b"");
    if offset < from { found } else if offset <= from + text.len() {
      { part: i, offset: character_count(text, offset - from) }
    } else { { part: i, offset: character_count(text, text.len()) } }
  })

fn hole_kind_of(node: Node) -> HoleKind / {abort.raise} =
  match kind(node) {
    Name -> AsExpression,
    Binding -> AsPattern,
    TypeVariable -> AsType,
    _ -> AsName,
  }

fn hole_kind_in(tree: Node, hole: Bytes) -> Option<HoleKind> / {abort.raise} = {
  let to_identifier = String::of_bytes_lossy(hole);
  walk(tree).fold(None, |found: Option<HoleKind>, node: Node|
    match found {
      Some(_) -> found,
      None -> match name(node) {
        Some(identifier) -> if identifier.text == to_identifier && qualifier(node) == None {
          Some(hole_kind_of(node))
        } else { None },
        None -> None,
      },
    })
}

pub fn compile(parts: List<String>) -> Result<Template, MalformedPart> / {abort.raise} = {
  let texts = parts.map(Bytes::of_string);
  let wrap = assemble_parts(texts);
  let read = parse(wrap.whole);
  match primary_of(read.diagnostics) {
    Some(rejected) -> {
      let at = locate_part(texts, wrap.starts, rejected.span.start);
      Err({ message: rejected.text, offset: at.offset, part: at.part })
    },
    None ->
      range(0, texts.len() - 1).fold(
        Ok(Template(texts, [])),
        |accumulator: Result<Template, MalformedPart>, i: Int|
          match accumulator {
            Err(_) -> accumulator,
            Ok(Template(template_texts, hole_kinds)) -> match hole_kind_in(
                read.tree,
                hole_name(i),
              ) {
              Some(stand) -> Ok(Template(template_texts, hole_kinds.push(stand))),
              None ->
                Err({
                  message: "a hole stands here for an expression, a pattern, a type or a name, and this is none of them",
                  offset: character_count(texts.at_or(i, b""), texts.at_or(i, b"").len()),
                  part: i,
                }),
            },
          },
      ),
  }
}

fn primary_of(diagnostics: List<Diagnostic>) -> Option<{ text: String, span: Span }> =
  match diagnostics.at(0) {
    None -> None,
    Some(diagnostic) -> match primary(diagnostic) {
      Some(label) -> Some({ text: diagnostic.message, span: label.span }),
      None -> Some({ text: diagnostic.message, span: { start: 0, end: 0 } }),
    },
  }

pub fn literal(text: String) -> Result<Node, Malformed> / {abort.raise} = {
  let given = Bytes::of_string(text);
  let read = parse(given);
  match primary_of(read.diagnostics) {
    Some(rejected) ->
      Err({ message: rejected.text, offset: character_count(given, rejected.span.start) }),
    None -> Ok(read.tree),
  }
}

fn misplaced<a>(node: Node, wanted: String) -> a / {syntax.fail, abort.raise} =
  syntax.fail(
    unexpected(
      text(node),
      { start: 0, end: text(node).len() },
      "a hole here takes " ++ wanted,
      "not " ++ wanted,
    ),
  )

fn is_bare_name(node: Node) -> Bool / {abort.raise} =
  qualifier(node) == None
    && (match kind(node) { Name -> true, Binding -> true, TypeVariable -> true, _ -> false })

fn parenthesized(node: Node) -> Bytes / {abort.raise} = {
  let to_span = text(node);
  let ends_lines = match to_span.index_of(b"\\\\") { Some(_) -> b"\n", None -> b"" };
  Bytes::concat_all([b"(", to_span, ends_lines, b")"])
}

fn hole_text(stand: HoleKind, node: Node) -> Bytes / {syntax.fail, abort.raise} =
  match ((stand, node)) {
    (AsName, _) -> if is_bare_name(node) { text(node) } else { misplaced(node, "a name") },
    (AsExpression, Node(_, ExpressionSyntax(e))) -> match e {
      NameExpression(_) -> text(node),
      _ -> parenthesized(node),
    },
    (AsExpression, _) -> misplaced(node, "an expression"),
    (AsPattern, Node(_, PatternSyntax(_))) -> parenthesized(node),
    (AsPattern, _) -> if is_bare_name(node) { text(node) } else { misplaced(node, "a pattern") },
    (AsType, Node(_, TypeSyntax(_))) -> parenthesized(node),
    (AsType, _) -> if is_bare_name(node) { text(node) } else { misplaced(node, "a type") },
  }

pub fn fill(template: Template, holes: List<Node>) -> Node / {syntax.fail, abort.raise} =
  match template {
    Template(texts, hole_kinds) -> {
      let whole = Bytes::concat_all(
        range(0, texts.len()).fold([], |accumulator: List<Bytes>, i: Int| {
          let with_text = accumulator.push(texts.at_or(i, b""));
          match ((hole_kinds.at(i), holes.at(i))) {
            (Some(stand), Some(node)) -> with_text.push(hole_text(stand, node)),
            _ -> with_text,
          }
        }),
      );
      let read = parse(whole);
      match read.diagnostics.at(0) { Some(reason) -> syntax.fail(reason), None -> read.tree }
    },
  }

pub type Sample = | Sample(Bytes)

pub fn sample_source(s: Sample) -> Bytes = match s { Sample(source) -> source }

fn sample_effects() -> List<Bytes> =
  [b"x", b"1", b"2_000", b"0xFF", b"( x )", b"[x,x].len()", b"#{ 1:x }.len()"]

fn spelling_effects() -> List<Bytes> =
  sample_effects().concat([
    b"f\"n {x}\"",
    b"(f\"{x+1} of {x}\")",
    b"( ( f\"{x}\" ) )",
    b"tag\"t {x}\"",
    b"#[x, 1 ]",
    b"(x,1)",
    b"x +% 1",
    b"{ a:x, b }",
    b"{ ..r, a:x }",
    b"g(x, to:1)",
    b"r.a",
    b"x?",
    b"'c'",
    b"1.50m",
    b"b\"\\x00\"",
    b"-  x",
    b"|n: Int| n",
    b"eff.op[r](x)",
  ])

fn sample_bodies(depth: Int, effects: List<Bytes>) -> Gen<Bytes> =
  if depth <= 0 { gen::elements(effects) } else {
    let inner = sample_bodies(depth - 1, effects);
    gen::one_of([
      gen::elements(effects),
      gen::map2(inner, inner, |a: Bytes, b: Bytes| Bytes::concat_all([a, b"+   ", b])),
      gen::map2(inner, inner, |a: Bytes, b: Bytes| Bytes::concat_all([a, b"  *  (", b, b")"])),
      gen::map2(inner, inner, |a: Bytes, b: Bytes|
        Bytes::concat_all([b"if (", a, b")>0{", b, b"}else{ x }"])),
      gen::map2(inner, inner, |a: Bytes, b: Bytes|
        Bytes::concat_all([b"{ let y=", a, b";\n      y - ", b, b" }"])),
      gen::map2(inner, inner, |a: Bytes, b: Bytes|
        Bytes::concat_all([b"match (", a, b") { 0->", b, b",  // none\n _ -> x }"])),
      gen::map(inner, |a: Bytes|
        Bytes::concat_all([b"[1,2 , 3].fold(", a, b",|acc:Int,n:Int| acc+n)"])),
    ])
  }

fn sample_modules(effects: List<Bytes>) -> Gen<Bytes> =
  gen::map(
    gen::list_of(
      gen::map2(
        gen::elements([b"", b"// a note\n", b"/// A doc.\n", b"\n\n"]),
        sample_bodies(2, effects),
        |lead: Bytes, body: Bytes| { lead: lead, body: body },
      ),
      3,
    ),
    |definitions: List<{ lead: Bytes, body: Bytes }>|
      Bytes::concat_all(
        range(0, definitions.len()).map(|i: Int| {
          let definition = definitions.at_or(i, { lead: b"", body: b"x" });
          Bytes::concat_all([
            definition.lead,
            b"fn f",
            Bytes::of_string(i.to_string()),
            b"( x:Int )->Int=",
            definition.body,
            b"\n",
          ])
        }),
      ),
  )

pub fn samples() -> Gen<Sample> =
  gen::map(sample_modules(sample_effects()), |source: Bytes| Sample(source))

type Spelling = | Spelling(Bytes)

fn spelling_text(s: Spelling) -> Bytes = match s { Spelling(source) -> source }

fn spellings() -> Gen<Spelling> =
  gen::map(sample_modules(spelling_effects()), |source: Bytes| Spelling(source))

type Noise = | Noise(Bytes)

fn noise_text(n: Noise) -> Bytes = match n { Noise(text) -> text }

fn noises() -> Gen<Noise> =
  gen::map(gen::list_of(gen::elements(source_fragments()), 12), |parts: List<Bytes>|
    Noise(Bytes::concat_all(parts)))

fn source_fragments() -> List<Bytes> =
  [
    b"fn f() -> Int = ",
    b"type T = ",
    b"test \"",
    b"law \"",
    b"import a.b ",
    b"\"",
    b"'",
    b"b\"",
    b"b'",
    b"f\"",
    b"tag\"",
    b"\\\\",
    b"\\",
    b"\\u{",
    b"\\x",
    b"\\n",
    b"{",
    b"}",
    b"(",
    b")",
    b"[",
    b"]",
    b"#{",
    b"#[",
    b"<",
    b">",
    b"|",
    b"->",
    b"=",
    b",",
    b";",
    b":",
    b"::",
    b".",
    b"..=",
    b"?",
    b"+%",
    b"-",
    b"/",
    b"//",
    b"///",
    b"//!",
    b"\n",
    b" ",
    b"x",
    b"_",
    b"1",
    b"0x",
    b"1e",
    b"1.",
    b"u8",
    b"m",
    b"if ",
    b"else ",
    b"match ",
    b"let ",
    b"handle ",
    b"with ",
    b"\xc3",
    b"\xc3\xa9",
    b"\xe2\x82",
    b"\xf0\x9f",
    b"\xff",
    b"\x00",
  ]

fn tree_of(source: Bytes) -> Node / {abort.raise} = parse(source).tree

fn kinds(nodes: List<Node>) -> List<Kind> / {abort.raise} = nodes.map(kind)

fn texts_of(nodes: List<Node>) -> List<Bytes> / {abort.raise} = nodes.map(text)

fn names_in(tree: Node) -> List<String> / {abort.raise} =
  walk(tree).fold([], |found: List<String>, node: Node|
    match ((kind(node), name(node))) {
      (Name, Some(identifier)) -> found.push(identifier.text),
      _ -> found,
    })

fn first_item(source: Bytes) -> Node / {abort.raise} =
  match children(tree_of(source)) {
    [first, ..] -> first,
    [] -> panic("the source contains no item"),
  }

fn body_of(source: Bytes) -> Node / {abort.raise} = {
  let parts = children(first_item(source));
  match parts.at(parts.len() - 1) {
    Some(body) -> body,
    None -> panic("the item has no child nodes"),
  }
}

test "a module's children are its imports and items, and each reports its kind and name" {
  let tree = tree_of(
    b"//! A module.\n\nimport std.list (at, concat)\nimport std.json as j\n\n/// Adds.\npub fn add(a: Int, b: Int) -> Int = a + b\n\ntype Shape = | Dot | Line(Int)\n\ntest \"adds\" { assert_eq(add(1, 2), 3) }\n",
  );
  assert_eq(kind(tree), Module);
  assert_eq(doc(tree), ["A module."]);
  let parts = children(tree);
  assert_eq(kinds(parts), [Import, Import, Function, TypeDeclaration, Test]);
  assert_eq(parts.map(|n: Node| match name(n) { Some(i) -> i.text, None -> "" }), [
    "std.list",
    "std.json",
    "add",
    "Shape",
    "adds",
  ]);
  assert_eq(texts_of(children(parts.at_or(0, tree))), [b"at", b"concat"]);
  assert_eq(kinds(children(parts.at_or(1, tree))), [ImportAlias]);
  let add = parts.at_or(2, tree);
  assert(is_public(add));
  assert_eq(doc(add), ["Adds."]);
  assert_eq(kinds(children(add)), [Parameter, Parameter, TypeName, Binary]);
  assert_eq(text(add), b"fn add(a: Int, b: Int) -> Int = a + b");
  assert_eq(kinds(children(parts.at_or(3, tree))), [Variant, Variant])
}

test "in a `law` or `law schema`, `identity(a)` parses to a type variable node" {
  let tree = tree_of(
    b"law \"l\" forall (x: a, y: b) where identity(a), x == x { x == y }\n\nlaw schema s<a>(f: (a) -> a) forall (x: a) where identity(a) { f(x) == x }\n\ninvariant for T by valid\n",
  );
  let parts = children(tree);
  assert_eq(kinds(parts), [Law, LawSchema, Instance]);
  let law = children(parts.at_or(0, tree));
  assert_eq(kinds(law.take(4)), [Parameter, Parameter, TypeVariable, Binary]);
  assert_eq(text(law.at_or(2, tree)), b"a");
  let schema = children(parts.at_or(1, tree));
  assert_eq(kinds(schema.take(3)), [Parameter, Parameter, TypeVariable]);
  assert_eq(text(schema.at_or(2, tree)), b"a");
  assert_eq(match name(parts.at_or(2, tree)) { Some(i) -> i.text, None -> "" }, "T")
}

test "interpolations, map and set literals, tuples and operators parse to their own node kinds with the expected children" {
  let body = |source: Bytes| body_of(b"fn f(x: Int, m: Map<Int, Int>) -> Int = ".concat(source));
  assert_eq(kind(body(b"f\"a {x} b {x + 1}\"\n")), Interpolation);
  assert_eq(texts_of(children(body(b"f\"a {x} b {x + 1}\"\n"))), [b"x", b"x + 1"]);
  assert_eq(kind(body(b"#{1: x, 2: 3}\n")), MapLiteral);
  assert_eq(texts_of(children(body(b"#{1: x, 2: 3}\n"))), [b"1", b"x", b"2", b"3"]);
  assert_eq(kind(body(b"#[x, 2]\n")), SetLiteral);
  assert_eq(texts_of(children(body(b"#[x, 2]\n"))), [b"x", b"2"]);
  assert_eq(kind(body(b"(x, 2)\n")), Tuple);
  assert_eq(texts_of(children(body(b"(x, 2)\n"))), [b"x", b"2"]);
  let wrapping = body(b"x +% 2\n");
  assert_eq(kind(wrapping), Binary);
  assert_eq(operator(wrapping), Some("+%"));
  assert_eq(texts_of(children(wrapping)), [b"x", b"2"]);
  assert_eq(operator(body(b"x * 2\n")), Some("*"));
  assert_eq(kinds(children(body(b"if x > 0 { x }\n"))), [Binary, Block]);
  assert_eq(kinds(children(body(b"if x > 0 { x } else { 0 }\n"))), [Binary, Block, Block]);
  assert_eq(names_in(body(b"f(x, m: m)\n")), ["f", "x", "m"]);
  assert_eq(names_in(body(b"f\"{x}\"\n")), ["x"])
}

test "`names_in` returns every name a function body refers to, and none of the names the parser generates" {
  let tree = tree_of(
    b"fn f(xs: List<Int>, m: Map<Int, Int>) -> String = {\n  let total = xs.fold(0, |acc: Int, x: Int| acc + x);\n  match xs.at(total) {\n    Some(first) -> f\"{first} of {xs.len()}\",\n    None -> show(#{1: total}),\n  }\n}\n",
  );
  assert_eq(names_in(tree), ["xs", "acc", "x", "xs", "total", "first", "xs", "show", "total"])
}

test "a call on a name bound in the same item is a `Call`, and a call on any other name is a `Perform`" {
  let tree = tree_of(
    b"effect log { write line(text: String) -> Unit }\n\nfn f(xs: List<Int>) -> Int / {log.line} = {\n  log.line(\"x\");\n  xs.len()\n}\n",
  );
  let calls = walk_into(tree, 64, []).filter(|n: Node| kind(n) == Call || kind(n) == Perform);
  assert_eq(calls.map(kind), [Perform, Call]);
  match calls.at(1) {
    Some(call) -> {
      let call_children = children(call);
      assert_eq(call_children.map(kind), [Access]);
      assert_eq(call_children.map(|n: Node| text(n)), [b"xs.len"]);
      assert_eq(call_children.flat_map(children).map(kind), [Name]);
      assert_eq(
        match name(call_children.get(0)) { Some(i) -> Some(i.text), None -> None },
        Some("len"),
      )
    },
    None -> panic("two calls"),
  };
  match expression(b"|ys: List<Int>| ys.len()") {
    Ok(lambda) -> assert(walk_into(lambda, 8, []).any(|n: Node| kind(n) == Access)),
    Err(_) -> panic("the fragment parses"),
  }
}

test "`enclosing` finds the nodes around a source byte offset, and a node reports its line and column" {
  let source = b"fn f(x: Int) -> Int =\n  x + 10\n";
  let tree = tree_of(source);
  let path = enclosing(tree, 28);
  assert_eq(kinds(path), [Module, Function, Binary, Literal]);
  let ten = path.at_or(3, tree);
  assert_eq(text(ten), b"10");
  assert_eq(int_value(ten), Some(10));
  assert_eq(place(ten), { line: 2, column: 7 });
  assert_eq(span(ten), { start: 28, end: 30 });
  assert_eq(enclosing(tree, 400), [])
}

test "`comments` returns the comments inside a node's span, and `doc` returns the doc comment of the item it documents" {
  let source = b"// leads\n/// Doubles.\nfn double(x: Int) -> Int = {\n  // twice\n  x * 2  // done\n}\n";
  let tree = tree_of(source);
  assert_eq(comments(tree).map(|c: Comment| c.text), [
    "// leads",
    "/// Doubles.",
    "// twice",
    "// done",
  ]);
  let item = first_item(source);
  assert_eq(doc(item), ["Doubles."]);
  assert_eq(comments(item).map(|c: Comment| c.text), ["// twice", "// done"])
}

test "a source that does not parse returns its diagnostics as values and the items around the break" {
  let read = parse(b"fn one() -> Int = 1\n\nfn two( = 2\n\nfn three() -> Int = 3\n");
  assert_eq(read.diagnostics.map(|d: Diagnostic| d.code), ["E0001"]);
  match read.diagnostics.at(0) {
    None -> panic("the parser reports the break"),
    Some(d) -> {
      assert_eq(d.severity, Error);
      assert(d.message.starts_with("expected "));
      match primary(d) {
        None -> panic("a diagnostic is placed"),
        Some(label) -> {
          assert_eq(label.place, { line: 3, column: 9 });
          assert_eq(label.span.start, 29)
        },
      }
    },
  };
  assert_eq(children(read.tree).map(|n: Node| match name(n) { Some(i) -> i.text, None -> "" }), [
    "one",
    "three",
  ])
}

test "`format` lays out a module and preserves its comments, and returns an error for source that does not parse" {
  assert_eq(
    format(b"// top\nfn   f(a: Int,b: Int)->Int = a+b // add\n"),
    Ok(b"// top\nfn f(a: Int, b: Int) -> Int = a + b  // add\n"),
  );
  match format(b"fn f( = 1\n") {
    Ok(_) -> panic("a source that does not parse is not printed"),
    Err(d) -> assert_eq(d.code, "E0001"),
  };
  assert_eq(formatted(b"fn f( = 1\n"), b"fn f( = 1\n")
}

test "`shape` returns equal values for sources that differ only in layout, comments and number spelling, and different values otherwise" {
  let a = tree_of(b"fn f(x: Int) -> Int = x + 1_000\n");
  let b = tree_of(b"// the same\nfn f( x : Int ) -> Int =\n  x + 1000\n");
  assert_eq(shape(a), shape(b));
  assert(a != b);
  assert(shape(a) != shape(tree_of(b"fn f(x: Int) -> Int = x + 1001\n")));
  assert_eq(
    shape(body_of(b"fn f(x: Int) -> Int = x + 1\n")),
    shape(body_of(b"fn g(x: Int) -> Int =\n  x  +  1\n")),
  )
}

test "edits are made by span and keep every other byte, and edits that collide are rejected" {
  let source = b"fn f(x: Int) -> Int = x + x  // twice\n";
  let renamed = apply_edits(source, [
    { path: "", span: { start: 26, end: 27 }, text: b"y" },
    { path: "", span: { start: 5, end: 6 }, text: b"y" },
    { path: "", span: { start: 22, end: 23 }, text: b"y" },
  ]);
  assert_eq(renamed, Some(b"fn f(y: Int) -> Int = y + y  // twice\n"));
  assert_eq(
    apply_edits(source, [{ path: "", span: { start: 0, end: 0 }, text: b"pub " }]),
    Some(b"pub ".concat(source)),
  );
  assert_eq(
    apply_edits(source, [
      { path: "", span: { start: 5, end: 7 }, text: b"a" },
      { path: "", span: { start: 6, end: 8 }, text: b"b" },
    ]),
    None,
  );
  assert_eq(apply_edits(source, [{ path: "", span: { start: 30, end: 90 }, text: b"" }]), None)
}

test "a fragment is one expression, pattern, type, item or name, whole, or it is rejected" {
  match expression(b"f(x) + 1") {
    Ok(node) -> {
      assert_eq(kind(node), Binary);
      assert_eq(names_in(node), ["f", "x"])
    },
    Err(d) -> panic(d.message),
  };
  assert(match expression(b"f(x) g") { Ok(_) -> false, Err(d) -> d.code == "E0001" });
  assert(match expression(b"") { Ok(_) -> false, Err(_) -> true });
  assert(match pattern(b"Some([first, ..rest])") {
    Ok(n) -> kind(n) == ConstructorPattern,
    Err(_) -> false,
  });
  assert(match type_expression(b"Map<String, List<Int>>") {
    Ok(n) -> kind(n) == TypeName,
    Err(_) -> false,
  });
  assert(match type_expression(b"Map<String") { Ok(_) -> false, Err(_) -> true });
  assert(match item(b"/// One.\nfn one() -> Int = 1\n") {
    Ok(n) -> doc(n) == ["One."],
    Err(_) -> false,
  });
  assert(match item(b"fn one() -> Int = 1\nfn two() -> Int = 2\n") {
    Ok(_) -> false,
    Err(_) -> true,
  });
  assert(match identifier("total") { Ok(n) -> kind(n) == Name, Err(_) -> false });
  assert(match identifier("fn") { Ok(_) -> false, Err(_) -> true });
  assert(match identifier("a b") { Ok(_) -> false, Err(_) -> true })
}

fn filled_text(parts: List<String>, holes: List<Node>) -> Result<Bytes, String> / {abort.raise} =
  match compile(parts) {
    Err(reason) -> Err(reason.message),
    Ok(template) -> match try { fill(template, holes) } {
      Ok(tree) -> Ok(formatted(source(tree))),
      Err(reason) -> Err(reason.message),
    },
  }

fn fragment(read: Result<Node, Diagnostic>) -> Node / {abort.raise} =
  match read { Ok(node) -> node, Err(d) -> panic(d.message) }

test "a literal's placeholders accept a name, an expression (parenthesized when needed), a pattern or a type" {
  assert_eq(
    filled_text(["pub fn ", "(x: ", ") -> ", " = match x { ", " -> ", " * 2, _ -> 0 }\n"], [
      fragment(identifier("twice")),
      fragment(type_expression(b"Option<Int>")),
      fragment(type_expression(b"Int")),
      fragment(pattern(b"Some(n)")),
      fragment(expression(b"n + 1")),
    ]),
    Ok(b"pub fn twice(x: Option<Int>) -> Int = match x { Some(n) -> (n + 1) * 2, _ -> 0 }\n"),
  );
  assert(match expression(b"1 } fn g() -> Int = { 2") { Ok(_) -> false, Err(_) -> true })
}

test "a function type or a line string filled into a literal's placeholder parses as one node, not several" {
  assert_eq(
    filled_text(["fn f(g: ", ") -> Int / {abort.raise} = g(1)\n"], [
      fragment(type_expression(b"(Int) -> Int / {abort.raise}")),
    ]),
    Ok(b"fn f(g: (Int) -> Int / {abort.raise}) -> Int / {abort.raise} = g(1)\n"),
  );
  match filled_text(["fn f() -> String = ", " ++ \"!\"\n"], [fragment(expression(b"\\\\one\n"))]) {
    Err(reason) -> panic(reason),
    Ok(wrap) -> {
      let body = body_of(wrap);
      assert_eq(kind(body), Binary);
      assert_eq(children(body).map(string_value), [Some("one"), Some("!")])
    },
  }
}

test "a literal's placeholder that needs a name rejects other fragments, and text that is not a module is rejected with the error's offset" {
  assert_eq(
    filled_text(["fn ", "() -> Int = 1\n"], [fragment(expression(b"a + b"))]),
    Err("a hole here takes a name"),
  );
  assert_eq(
    compile(["fn f( = ", "\n"]),
    Err({ message: "expected a parameter name, found `=`", offset: 6, part: 0 }),
  );
  assert(match literal("fn f() -> Int = 1\n") {
    Ok(tree) -> kind(tree) == Module,
    Err(_) -> false,
  });
  assert_eq(
    match literal("fn f() -> Int = \n") { Ok(_) -> None, Err(reason) -> Some(reason.offset) },
    Some(17),
  )
}

test "a module sample drawn by the test generator parses with no diagnostics" {
  let drawn = gen::sample(samples(), 7, b"sample", 16, None);
  match drawn.value {
    None -> panic("a sample is drawn"),
    Some(s) -> assert_eq(parse(sample_source(s)).diagnostics, []),
  }
}

test "`parse` returns a module tree for any text, the tree can be walked, and formatting the text twice gives the same result as once" {
  gen::check(noises(), |n: Noise| {
    let read = parse(noise_text(n));
    kind(read.tree) == Module && walk(read.tree).len() > 0
      && formatted(formatted(noise_text(n))) == formatted(noise_text(n))
  })
}

test "formatting a module a second time changes nothing" {
  gen::check(spellings(), |s: Spelling| {
    formatted(formatted(spelling_text(s))) == formatted(spelling_text(s))
  })
}

test "a formatted module parses to the tree its source does" {
  gen::check(spellings(), |s: Spelling| {
    shape(parse(formatted(spelling_text(s))).tree) == shape(parse(spelling_text(s)).tree)
  })
}
