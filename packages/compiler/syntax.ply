//! Ply source as values: a module parsed into a tree, read through accessors, and printed as
//! `ply fmt` prints it.
//!
//! `parse` reads one module's source and answers its tree with the diagnostics the parser made,
//! each a value: a code, a message, labels with a line, a column and byte offsets, and notes. The
//! parser is the compiler's own, so it reads what `ply check` reads and recovers as it does: an
//! item that does not parse is reported once and left out, and the items around it are read, so a
//! tree answered beside diagnostics holds the rest of the module. Nothing inside a broken item is
//! kept, and a source that is not UTF-8 is read up to where it stops being.
//!
//! A tree is made of nodes, and a `Node` is opaque: what it holds is the compiler's, which changes
//! with the language. A node is read by `kind`, `span`, `text`, `name`, `children` and the few
//! accessors beside them, which keep their meaning. `Kind` is the vocabulary, and it grows: a
//! release that adds syntax adds a kind and moves `version`, so a `match` over kinds ends in a
//! wildcard arm. A kind is never renamed or given another meaning without `version` moving.
//!
//! The tree is what was written. An interpolated string, a map or set literal, a tuple and an
//! operator are each one node of their own kind though the compiler reads them as calls, and the
//! names the parser writes for itself are no node. Comments are not nodes: `comments` answers the
//! ones inside a node's span, a doc comment is its item's `doc`, and `format` and `apply_edits` keep
//! every one.
//!
//! `format` is the formatter `ply fmt` runs. It keeps every comment, the spelling of every literal
//! and the order of everything, and its answer parses to the same tree (`shape`) and formats to
//! itself.
//!
//! Code is made as text and checked as syntax. `expression`, `pattern`, `type_expression`, `item`
//! and `identifier` each read one fragment whole or refuse it, and a `syntax"…"` literal is a
//! module's items checked where it is written, each hole a node: an expression, a pattern, a type
//! or a name, by where the hole stands. A node in a hole is written as one node, in parentheses
//! unless it is a name, so nothing it holds is read as part of the text around it. `apply_edits` makes
//! replacements in a source by span and keeps every other byte.
//!
//! `compiler.checker` answers what these sources mean: diagnostics from the whole front end, and
//! each definition's type, row, hash and references.

import compiler.syntax.exprs
import compiler.syntax.exprs (Expr, LiteralExpression, NameExpression, BinaryExpression,
                              UnaryExpression, LambdaExpression, CallExpression, IfExpression,
                              MatchExpression, BlockExpression, RecordExpression,
                              RecordUpdateExpression, PropagateExpression, FieldExpression,
                              ListExpression, PerformExpression, HandleExpression,
                              WithHoldExpression, SimulateExpression, ParallelExpression,
                              TaggedLiteralExpression, InvalidExpression, HoleExpression,
                              TryBlockExpression, Param, Stmt, LetStatement, LetElseStatement,
                              ExpressionStatement, AssignmentStatement, MatchArm, HandleClause,
                              ReturnClause, HandlerVar, NamedArg, RecordLiteralField, Hole,
                              expr_span, written_operator)
import compiler.syntax.fmt
import compiler.syntax.items
import compiler.syntax.items (Module, Item, FunctionItem, TypeItem, EffectItem, TestItem, LawItem,
                              SchemaItem, DeriveItem, EffectSetItem, ExternItem, InstanceItem,
                              NumericItem, ImportDecl, WholeModule, ModuleAlias, SelectedNames,
                              Binder, SpecClause, RequiresClause, EnsuresClause, CostClause,
                              SpaceClause, VariantDef, OpDef, AliasBody, SumBody, NominalBody,
                              ExternBody, item_span, item_doc, is_pub, is_written)
import compiler.syntax.lexer
import compiler.syntax.parsing
import compiler.syntax.parsing (ParseDiag, Parser, Input)
import compiler.syntax.patterns
import compiler.syntax.patterns (Pattern, PatternWildcard, PatternVariable, PatternLiteral,
                                 PatternRange, PatternConstructor, PatternRecord, PatternList,
                                 PatternOr, PatternInvalid, LiteralInt, LiteralString,
                                 LiteralInvalid, pat_span)
import compiler.syntax.type_syntax
import compiler.syntax.type_syntax (TypeExpr, VariableTypeExpression, NamedTypeExpression,
                                    FunctionTypeExpression, RecordTypeExpression,
                                    UnitTypeExpression, InvalidTypeExpression, RowExpr, ty_span,
                                    is_raise)
import std.bytes
import std.gen
import std.gen (Gen)
import std.list
import std.location (Location, location_at)

// --- Diagnostics ------------------------------------------------------------

/// A stretch of a source, in bytes: from `start` up to `end`.
pub type Span = { start: Int, end: Int }

/// One place a diagnostic points at, and what it says of it.
///
/// `path` names the source: `""` for the one source `parse` was given, and for a diagnostic of
/// `compiler.checker` the path its source was given under, or nothing where it is about no source.
/// `place` is where `span` starts.
pub type Label = new { path: String, span: Span, place: Location, primary: Bool, text: String }

/// One replacement in the source at `path`: `text` in place of `span`. An empty span inserts and
/// an empty text deletes.
pub type Edit = new { path: String, span: Span, text: Bytes }

/// A change that applies as it is and leaves a program the diagnostic no longer holds for.
pub type Fix = new { title: String, edits: List<Edit> }

/// Whether a diagnostic refuses the program or only remarks on it.
pub type Severity = | Error | Warning

/// What the front end says of a source: a code `ply explain` reads (`E0001`), a sentence, the
/// places it is about with the primary one among them, the notes under it, and the fixes it
/// offers.
pub type Diagnostic = new {
  code: String,
  severity: Severity,
  message: String,
  labels: List<Label>,
  notes: List<String>,
  fixes: List<Fix>,
}

/// The label a diagnostic is placed at: its first primary one, else its first.
pub fn primary(diagnostic: Diagnostic) -> Option<Label> =
  match diagnostic.labels.fold(None, |found: Option<Label>, label: Label|
      match found { Some(_) -> found, None -> if label.primary { Some(label) } else { None } }) {
    Some(label) -> Some(label),
    None -> diagnostic.labels.at(0),
  }

/// What this module raises where it refuses.
pub effect syntax {
  /// A node does not go where a `syntax"…"` literal's hole stands, or the text it makes does not
  /// parse.
  raise fail(why: Diagnostic)
}

fn diagnostic_of(source: Bytes, diag: ParseDiag) -> Diagnostic =
  {
    code: String::of_bytes_lossy(diag.code),
    severity: if diag.severity == b"warning" { Warning } else { Error },
    message: String::of_bytes_lossy(diag.message),
    labels: diag.labels.map(|label: parsing::Label|
      {
        path: "",
        span: { start: label.start, end: label.end },
        place: location_at(source, label.start),
        primary: label.primary,
        text: String::of_bytes_lossy(label.text),
      }),
    notes: diag.notes_text.map(|note: Bytes| String::of_bytes_lossy(note)),
    fixes: [],
  }

/// A refusal of this module's own, placed like the parser's.
fn unexpected(source: Bytes, span: Span, message: String, label: String) -> Diagnostic =
  diagnostic_of(
    source,
    parsing::error_at(
      parsing::unexpected(),
      parsing::span_between(span.start, span.end),
      Bytes::of_string(message),
      Bytes::of_string(label),
      [],
    ),
  )

// --- Nodes ------------------------------------------------------------------

/// The source a node was parsed from, that source's comments, and the names each item of it binds,
/// by where the item lies: a call written on one of those is a call on a value.
type Origin = {
  source: Bytes,
  comments: List<lexer::Comment>,
  binding: List<{ start: Int, end: Int, names: Map<Bytes, Bool> }>,
}

/// What a node is, as the compiler holds it.
type NodeSyntax =
  | ModuleSyntax(Module)
  | ImportSyntax(ImportDecl)
  | ImportedNameSyntax(parsing::Ident)
  | ImportAliasSyntax(parsing::Ident)
  | ItemSyntax(Item)
  | VariantSyntax(VariantDef)
  | OperationSyntax(OpDef)
  | ParameterSyntax(Param)
  | ClauseSyntax(SpecClause)
  | DecreasesSyntax(Expr)
  | RowSyntax(RowExpr)
  | ExpressionSyntax(Expr)
  | StatementSyntax(Stmt)
  | ArmSyntax(MatchArm)
  | HandlerSyntax(HandleClause)
  | ReturnHandlerSyntax(ReturnClause)
  | HandlerVariableSyntax(HandlerVar)
  | FieldSyntax({ name: parsing::Ident, value: Expr })
  | PatternFieldSyntax({ name: parsing::Ident, pat: Pattern })
  | TypeFieldSyntax({ name: parsing::Ident, ty: TypeExpr })
  | PatternSyntax(Pattern)
  | TypeSyntax(TypeExpr)

/// One node of a tree: a module, an item, an expression, a pattern, a type, or a part of one.
///
/// Two nodes are `==` when they are the same node of the same source; `shape` compares trees
/// whatever their layout.
pub opaque type Node = | Node(Origin, NodeSyntax)

/// What a node is. The list grows with the language: end a `match` over it with a wildcard arm.
///
/// Each kind says what `children` answers for it, in the order the source writes them, and what
/// `name` answers where it names anything.
pub type Kind =
  /// A whole source: its imports, then its items.
  | Module
  /// `import a.b`: named by the module's path; an `ImportedName` for each name in a list, or an
  /// `ImportAlias`.
  | Import
  /// One name of `import a.b (f, g)`.
  | ImportedName
  /// The binder of `import a.b as c`.
  | ImportAlias
  /// `fn`: its parameters, its result type and its `Row` where written, its `Requires`, `Ensures`,
  /// `Cost` and `Space` clauses, its `Decreases`, then its body.
  | Function
  /// `type`: the type it names, or each `Variant` of a sum.
  | TypeDeclaration
  /// `effect`: each `Operation`.
  | EffectDeclaration
  /// `test`, named by its label: over cases, the values in its label's holes, the case's
  /// `Parameter` and the table; then its body.
  | Test
  /// `law`, named by its label: its binders as `Parameter`s, each type variable its
  /// `where identity(a)` constrains as a `TypeVariable`, its guard where written, then its body,
  /// which for an instantiation is the `Call` of the schema.
  | Law
  /// `law schema`: its parameters, its binders, each type variable its `where identity(a)`
  /// constrains as a `TypeVariable`, its guard where written, then its body.
  | LawSchema
  /// `derive json for T`, named by the type.
  | Derive
  /// `effect set`, named by the set.
  | EffectSet
  /// `extern fn`: its parameters, its result type, its `Row` and its clauses.
  | ExternFunction
  /// `key for T by f`, `show for T by f` or `invariant for T by f`, named by the type.
  | Instance
  /// `numeric for T by { .. }`, named by the type.
  | Numeric
  /// A constructor of a sum type: the types of its fields.
  | Variant
  /// An operation of an effect: the types of its parameters, then of its result unless it is a
  /// `raise`.
  | Operation
  /// A parameter of a function, a lambda, a law or a handler, or the binder of a `with_hold` or a
  /// test over cases: its type and its default where written.
  | Parameter
  /// `requires e`: the condition.
  | Requires
  /// `ensures e`: the condition.
  | Ensures
  /// `cost e`: the bound.
  | Cost
  /// `space e`: the bound.
  | Space
  /// `decreases e`: the measure.
  | Decreases
  /// An effect row, `{fs.read[r], abort.raise | e}`: read it with `text`.
  | Row
  /// A literal: a number, a string, a line string, bytes, a character, `true`, `false` or `()`.
  | Literal
  /// A name used as a value, `f` or `m::f`: `name` is `f` and `qualifier` is `m`.
  | Name
  /// A binary operator: its two operands. `operator` is its spelling.
  | Binary
  /// `-x`, `!x` or `~x`: the operand. `operator` is its spelling.
  | Unary
  /// `|x: T| body`: its parameters, its result type where written, then its body.
  | Lambda
  /// A call: the callee, then each argument, a named one as a `Field`.
  | Call
  /// `if`: the condition, the block, and the `else` branch where one is written.
  | If
  /// `match`: the scrutinee, then each `Arm`.
  | Match
  /// `{ .. }`: each statement, a `Let`, a `LetElse` or an expression, then the tail.
  | Block
  /// `{ a: 1, b }`: each `Field`.
  | RecordLiteral
  /// `(a, b)`: each element.
  | Tuple
  /// `{ ..base, a: 1 }`: the base, then each `Field`.
  | RecordUpdate
  /// `x?`: the operand.
  | Propagate
  /// `a.b`: the value; `name` is the field.
  | Access
  /// `[a, b]`: each element.
  | ListLiteral
  /// `#{k: v}`: each key and its value, in turn.
  | MapLiteral
  /// `#[a, b]`: each element.
  | SetLiteral
  /// `f"a {x} b"`: the value in each hole.
  | Interpolation
  /// `tag"text {x}"`: the value in each hole; `name` is the tag.
  | TaggedLiteral
  /// `effect_name.op[r](args)`: each argument; `name` is the operation and `qualifier` the effect. A
  /// call written so on a name its item binds is a call on that value, a `Call` of an `Access`, as
  /// `f(x).len()` is.
  | Perform
  /// `handle { .. } with { .. }`: the body, then each `HandlerVariable`, each `Handler` and the
  /// `ReturnHandler`.
  | Handle
  /// `with_hold[r](acquire, release) { h -> body }`: the two, the binder, the body.
  | WithHold
  /// `simulate { .. }`: the body.
  | Simulate
  /// `parallel { a, b }`: each branch.
  | Parallel
  /// `try { .. }`: the body.
  | TryBlock
  /// `let p: T = v;`: the pattern, the type where written, the value.
  | Let
  /// `let p = v else { .. };`: as a `Let`, then the block.
  | LetElse
  /// `x = v;` in a handler's clause: the value; `name` is the variable.
  | Assignment
  /// An arm of a `match`: the pattern, the guard where written, the body.
  | Arm
  /// A clause of a `handle`: its parameters, then its body; `name` is the operation and
  /// `qualifier` the effect.
  | Handler
  /// `return x -> ..` in a `handle`: the binder, then the body.
  | ReturnHandler
  /// `var x: T = v` in a `handle`: the type where written, then the first value; `name` is the
  /// variable.
  | HandlerVariable
  /// A named part: a record's field, a named argument, a record pattern's field or a record
  /// type's: the value, pattern or type. A field written by its name alone holds the node of that
  /// name, at the same span.
  | Field
  /// `_`.
  | Wildcard
  /// A pattern that binds a name.
  | Binding
  /// A literal as a pattern.
  | LiteralPattern
  /// `lo..=hi`.
  | RangePattern
  /// `Some(p)`: each argument; `name` is the constructor and `qualifier` its module.
  | ConstructorPattern
  /// `{ a, b: p, .. }`: each `Field`.
  | RecordPattern
  /// `(p, q)`: each element.
  | TuplePattern
  /// `[p, q, ..rest]`: each element, then the rest.
  | ListPattern
  /// `p | q`: each alternative.
  | Alternatives
  /// A type variable, `a`.
  | TypeVariable
  /// `List<Int>` or `m::T`: each type argument; `name` is the type and `qualifier` its module.
  | TypeName
  /// `(A, B) -> C / {..}`: each parameter type, the result type, and the `Row` where written.
  | FunctionType
  /// `{ a: Int }`: each `Field`.
  | RecordType
  /// `(A, B)`: each element.
  | TupleType
  /// `()` as a type.
  | UnitType
  /// `???` or `..`: an unfilled hole.
  | Hole
  /// What stands where the parser could read nothing.
  | Unparsed

/// A name as the source writes it, and where.
pub type Ident = new { text: String, span: Span }

/// A comment as written, its `//`, `///` or `//!` included, without the blanks that end its line.
pub type Comment = new { span: Span, text: String }

/// The version of this module's vocabulary: it moves when a `Kind` is added, and with what is said
/// of the release when an accessor comes to answer otherwise for a tree it already read. At 2 a
/// call on a value written on a bare name is no longer a `Perform`; at 3 a handler has its
/// `HandlerVariable`s and a clause its `Assignment`s; at 4 a law's or a schema's `identity(a)` is the
/// `TypeVariable` `a`, no longer a guard's `Call`, and an `Instance` may be an `invariant`.
pub fn version() -> Int = 4

/// A place the compiler read, as the span of the source it lies at.
fn to_span(place: parsing::Span) -> Span = { start: place.start, end: place.end }

fn to_identifier(ident: parsing::Ident) -> Ident =
  { text: String::of_bytes_lossy(ident.name), span: to_span(ident.span) }

fn binder_parameter(binder: Binder) -> Param =
  {
    name: binder.name,
    keep: false,
    ty: Some(binder.ty),
    cost: None,
    space: None,
    default: None,
    span: binder.span,
  }

fn untyped(name: parsing::Ident) -> Param =
  { name: name, keep: false, ty: None, cost: None, space: None, default: None, span: name.span }

fn optional<a>(value: Option<a>, wrap: (a) -> NodeSyntax) -> List<NodeSyntax> =
  match value { Some(x) -> [wrap(x)], None -> [] }

fn as_types(ts: List<TypeExpr>) -> List<NodeSyntax> = ts.map(|t: TypeExpr| TypeSyntax(t))

fn as_values(es: List<Expr>) -> List<NodeSyntax> = es.map(|e: Expr| ExpressionSyntax(e))

fn as_params(ps: List<Param>) -> List<NodeSyntax> = ps.map(|p: Param| ParameterSyntax(p))

fn as_binders(bs: List<Binder>) -> List<NodeSyntax> =
  bs.map(|b: Binder| ParameterSyntax(binder_parameter(b)))

fn as_variables(names: List<parsing::Ident>) -> List<NodeSyntax> =
  names.map(|name: parsing::Ident| TypeSyntax(VariableTypeExpression(name)))

fn as_clauses(cs: List<SpecClause>) -> List<NodeSyntax> = cs.map(|c: SpecClause| ClauseSyntax(c))

fn as_fields(fs: List<RecordLiteralField>) -> List<NodeSyntax> =
  fs.map(|f: RecordLiteralField| FieldSyntax({ name: f.name, value: f.value }))

fn all_of(parts: List<List<NodeSyntax>>) -> List<NodeSyntax> =
  parts.flat_map(|part: List<NodeSyntax>| part)

fn span_of(source: Bytes, at: NodeSyntax) -> Span = to_span(parsed_span(source, at))

/// Where the compiler read `at`.
fn parsed_span(source: Bytes, at: NodeSyntax) -> parsing::Span =
  match at {
    ModuleSyntax(_) -> parsing::span_between(0, source.len()),
    ImportSyntax(d) -> d.span,
    ImportedNameSyntax(i) -> i.span,
    ImportAliasSyntax(i) -> i.span,
    ItemSyntax(item) -> item_span(item),
    VariantSyntax(v) -> v.span,
    OperationSyntax(o) -> o.span,
    ParameterSyntax(p) -> p.span,
    ClauseSyntax(c) -> c.span,
    DecreasesSyntax(e) -> expr_span(e),
    RowSyntax(r) -> r.span,
    ExpressionSyntax(e) -> expr_span(e),
    StatementSyntax(stmt) -> match stmt {
      LetStatement(v) -> v.span,
      LetElseStatement(v) -> v.span,
      ExpressionStatement(e) -> expr_span(e),
      AssignmentStatement(v) -> v.span,
    },
    ArmSyntax(arm) -> arm.span,
    HandlerSyntax(c) -> c.span,
    ReturnHandlerSyntax(r) -> r.span,
    HandlerVariableSyntax(v) -> v.span,
    FieldSyntax(f) -> parsing::span_to(f.name.span, expr_span(f.value)),
    PatternFieldSyntax(f) -> parsing::span_to(f.name.span, pat_span(f.pat)),
    TypeFieldSyntax(f) -> parsing::span_to(f.name.span, ty_span(f.ty)),
    PatternSyntax(p) -> pat_span(p),
    TypeSyntax(t) -> ty_span(t),
  }

fn in_order(source: Bytes, parts: List<NodeSyntax>) -> List<NodeSyntax> =
  parts.sort_by(|a: NodeSyntax, b: NodeSyntax| span_of(source, a).start < span_of(source, b).start)

fn item_parts(item: Item) -> List<NodeSyntax> =
  match item {
    FunctionItem(d) ->
      all_of([
        as_params(d.params),
        optional(d.ret, |t: TypeExpr| TypeSyntax(t)),
        optional(d.effects, |r: RowExpr| RowSyntax(r)),
        as_clauses(d.spec),
        optional(d.decreases, |e: Expr| DecreasesSyntax(e)),
        [ExpressionSyntax(d.body)],
      ]),
    TypeItem(d) -> match d.body {
      AliasBody(t) -> [TypeSyntax(t)],
      SumBody(vs) -> vs.map(|v: VariantDef| VariantSyntax(v)),
      NominalBody(t) -> [TypeSyntax(t)],
      ExternBody -> [],
    },
    EffectItem(d) -> d.operations.map(|o: OpDef| OperationSyntax(o)),
    TestItem(d) ->
      all_of([
        match d.cases {
          Some(c) ->
            all_of([
              as_values(fmt::holes_of(c.label)),
              [
                ParameterSyntax({
                  name: c.binder,
                  keep: false,
                  ty: Some(c.ty),
                  cost: None,
                  space: None,
                  default: None,
                  span: parsing::span_to(c.binder.span, ty_span(c.ty)),
                }),
                ExpressionSyntax(c.table),
              ],
            ]),
          None -> [],
        },
        [ExpressionSyntax(d.body)],
      ]),
    LawItem(d) ->
      all_of([
        as_binders(d.binders),
        as_variables(d.identities),
        optional(d.guard, |e: Expr| ExpressionSyntax(e)),
        [ExpressionSyntax(d.body)],
      ]),
    SchemaItem(d) ->
      all_of([
        as_binders(d.params),
        as_binders(d.binders),
        as_variables(d.identities),
        optional(d.guard, |e: Expr| ExpressionSyntax(e)),
        [ExpressionSyntax(d.body)],
      ]),
    ExternItem(d) ->
      all_of([
        as_params(d.params),
        [TypeSyntax(d.ret)],
        optional(d.effects, |r: RowExpr| RowSyntax(r)),
        as_clauses(d.spec),
      ]),
    DeriveItem(_) -> [],
    EffectSetItem(_) -> [],
    InstanceItem(_) -> [],
    NumericItem(_) -> [],
  }

fn statement(stmt: Stmt) -> NodeSyntax =
  match stmt { ExpressionStatement(e) -> ExpressionSyntax(e), _ -> StatementSyntax(stmt) }

/// A call the parser wrote for an operator, `a +% b`.
fn is_operator(e: Expr) -> Bool =
  match e {
    CallExpression(v) -> match written_operator(v.func, v.args) { Some(_) -> true, None -> false },
    _ -> false,
  }

/// A call the parser wrote around the value in an interpolated string's hole: its callee is
/// reached through a binder no source can spell.
fn is_display(e: Expr) -> Bool =
  match e {
    CallExpression(v) -> match v.func {
      NameExpression(f) -> match f.name.module {
        Some(binder) -> exprs::is_hidden_binder(binder.name),
        None -> false,
      },
      _ -> false,
    },
    _ -> false,
  }

fn expr_parts(source: Bytes, e: Expr) -> List<NodeSyntax> / {abort.raise} =
  match fmt::surface_syntax(source, e) {
    fmt::Interpolated(holes) -> as_values(holes),
    fmt::MapLiteral(entries) ->
      entries.flat_map(|entry: { key: Expr, value: Expr }|
        [ExpressionSyntax(entry.key), ExpressionSyntax(entry.value)]),
    fmt::SetLiteral(xs) -> as_values(xs),
    fmt::AsParsed -> match e {
      LiteralExpression(_) -> [],
      NameExpression(_) -> [],
      BinaryExpression(v) -> [ExpressionSyntax(v.lhs), ExpressionSyntax(v.rhs)],
      UnaryExpression(v) -> [ExpressionSyntax(v.operand)],
      LambdaExpression(v) ->
        all_of([
          as_params(v.params),
          optional(v.ret, |t: TypeExpr| TypeSyntax(t)),
          [ExpressionSyntax(v.body)],
        ]),
      CallExpression(v) -> if is_operator(e) || is_display(e) { as_values(v.args) } else {
        in_order(
          source,
          all_of([
            [ExpressionSyntax(v.func)],
            as_values(v.args),
            v.named.map(|arg: NamedArg| FieldSyntax({ name: arg.name, value: arg.value })),
          ]),
        )
      },
      IfExpression(v) ->
        all_of([
          [ExpressionSyntax(v.cond), ExpressionSyntax(v.then_branch)],
          match v.else_branch { LiteralExpression(_) -> [], other -> [ExpressionSyntax(other)] },
        ]),
      MatchExpression(v) ->
        all_of([[ExpressionSyntax(v.scrutinee)], v.arms.map(|arm: MatchArm| ArmSyntax(arm))]),
      BlockExpression(v) ->
        all_of([v.stmts.map(statement), optional(v.tail, |x: Expr| ExpressionSyntax(x))]),
      RecordExpression(v) -> if fmt::is_tuple(v.fields) {
        v.fields.map(|f: RecordLiteralField| ExpressionSyntax(f.value))
      } else { as_fields(v.fields) },
      RecordUpdateExpression(v) -> all_of([[ExpressionSyntax(v.base)], as_fields(v.fields)]),
      PropagateExpression(v) -> [ExpressionSyntax(v.operand)],
      FieldExpression(v) -> [ExpressionSyntax(v.base)],
      ListExpression(v) -> as_values(v.items),
      PerformExpression(v) -> as_values(v.args),
      HandleExpression(v) ->
        in_order(
          source,
          all_of([
            [ExpressionSyntax(v.body)],
            v.vars.map(|x: HandlerVar| HandlerVariableSyntax(x)),
            v.clauses.map(|c: HandleClause| HandlerSyntax(c)),
            optional(v.ret, |r: ReturnClause| ReturnHandlerSyntax(r)),
          ]),
        ),
      WithHoldExpression(v) ->
        [
          ExpressionSyntax(v.acquire),
          ExpressionSyntax(v.release),
          ParameterSyntax(untyped(v.binder)),
          ExpressionSyntax(v.body),
        ],
      SimulateExpression(v) -> [ExpressionSyntax(v.body)],
      ParallelExpression(v) -> as_values(v.branches),
      TaggedLiteralExpression(t) -> t.holes.map(|h: Hole| ExpressionSyntax(h.value)),
      HoleExpression(_) -> [],
      InvalidExpression(_) -> [],
      TryBlockExpression(v) -> [ExpressionSyntax(v.body)],
    },
  }

fn pattern_parts(p: Pattern) -> List<NodeSyntax> / {abort.raise} =
  match p {
    PatternWildcard(_) -> [],
    PatternVariable(_) -> [],
    PatternLiteral(_) -> [],
    PatternRange(_) -> [],
    PatternConstructor(v) -> v.args.map(|x: Pattern| PatternSyntax(x)),
    PatternRecord(v) -> if fmt::is_pat_tuple(v.fields) {
      v.fields.map(|f: { name: parsing::Ident, pat: Pattern }| PatternSyntax(f.pat))
    } else { v.fields.map(|f: { name: parsing::Ident, pat: Pattern }| PatternFieldSyntax(f)) },
    PatternList(v) ->
      all_of([
        v.items.map(|x: Pattern| PatternSyntax(x)),
        optional(v.rest, |x: Pattern| PatternSyntax(x)),
      ]),
    PatternOr(v) -> v.alternatives.map(|x: Pattern| PatternSyntax(x)),
    PatternInvalid(_) -> [],
  }

fn type_parts(t: TypeExpr) -> List<NodeSyntax> / {abort.raise} =
  match t {
    VariableTypeExpression(_) -> [],
    NamedTypeExpression(x) -> as_types(x.args),
    FunctionTypeExpression(x) ->
      all_of([
        as_types(x.params),
        [TypeSyntax(x.ret)],
        optional(x.effects, |r: RowExpr| RowSyntax(r)),
      ]),
    RecordTypeExpression(x) -> if fmt::is_ty_tuple(x.fields) {
      x.fields.map(|f: { name: parsing::Ident, ty: TypeExpr }| TypeSyntax(f.ty))
    } else { x.fields.map(|f: { name: parsing::Ident, ty: TypeExpr }| TypeFieldSyntax(f)) },
    UnitTypeExpression(_) -> [],
    InvalidTypeExpression(_) -> [],
  }

fn parts_of(source: Bytes, at: NodeSyntax) -> List<NodeSyntax> / {abort.raise} =
  match at {
    ModuleSyntax(m) ->
      all_of([
        m.imports.filter(is_written).map(|d: ImportDecl| ImportSyntax(d)),
        m.items.map(|item: Item| ItemSyntax(item)),
      ]),
    ImportSyntax(d) -> match d.kind {
      WholeModule -> [],
      ModuleAlias(binder) -> [ImportAliasSyntax(binder)],
      SelectedNames(names) -> names.map(|n: parsing::Ident| ImportedNameSyntax(n)),
    },
    ImportedNameSyntax(_) -> [],
    ImportAliasSyntax(_) -> [],
    ItemSyntax(item) -> item_parts(item),
    VariantSyntax(v) -> as_types(v.fields),
    OperationSyntax(o) -> if is_raise(o.mode) { as_types(o.params) }
    else { as_types(o.params).push(TypeSyntax(o.ret)) },
    ParameterSyntax(p) ->
      all_of([
        optional(p.ty, |t: TypeExpr| TypeSyntax(t)),
        optional(p.default, |e: Expr| ExpressionSyntax(e)),
      ]),
    ClauseSyntax(c) -> [ExpressionSyntax(c.expr)],
    DecreasesSyntax(e) -> [ExpressionSyntax(e)],
    RowSyntax(_) -> [],
    ExpressionSyntax(e) -> expr_parts(source, e),
    StatementSyntax(stmt) -> match stmt {
      LetStatement(v) ->
        all_of([
          [PatternSyntax(v.pat)],
          optional(v.ty, |t: TypeExpr| TypeSyntax(t)),
          [ExpressionSyntax(v.value)],
        ]),
      LetElseStatement(v) ->
        all_of([
          [PatternSyntax(v.pat)],
          optional(v.ty, |t: TypeExpr| TypeSyntax(t)),
          [ExpressionSyntax(v.value), ExpressionSyntax(v.fallback)],
        ]),
      ExpressionStatement(e) -> [ExpressionSyntax(e)],
      AssignmentStatement(v) -> [ExpressionSyntax(v.value)],
    },
    HandlerVariableSyntax(v) ->
      all_of([optional(v.ty, |t: TypeExpr| TypeSyntax(t)), [ExpressionSyntax(v.init)]]),
    ArmSyntax(arm) ->
      all_of([
        [PatternSyntax(arm.pat)],
        optional(arm.guard, |e: Expr| ExpressionSyntax(e)),
        [ExpressionSyntax(arm.body)],
      ]),
    HandlerSyntax(c) ->
      in_order(
        source,
        all_of([
          c.params.map(|p: parsing::Ident| ParameterSyntax(untyped(p))),
          optional(c.resume, |k: parsing::Ident| ParameterSyntax(untyped(k))),
          [ExpressionSyntax(c.body)],
        ]),
      ),
    ReturnHandlerSyntax(r) -> [ParameterSyntax(untyped(r.binder)), ExpressionSyntax(r.body)],
    FieldSyntax(f) -> [ExpressionSyntax(f.value)],
    PatternFieldSyntax(f) -> [PatternSyntax(f.pat)],
    TypeFieldSyntax(f) -> [TypeSyntax(f.ty)],
    PatternSyntax(p) -> pattern_parts(p),
    TypeSyntax(t) -> type_parts(t),
  }

fn item_kind(item: Item) -> Kind =
  match item {
    FunctionItem(_) -> Function,
    TypeItem(_) -> TypeDeclaration,
    EffectItem(_) -> EffectDeclaration,
    TestItem(_) -> Test,
    LawItem(_) -> Law,
    SchemaItem(_) -> LawSchema,
    DeriveItem(_) -> Derive,
    EffectSetItem(_) -> EffectSet,
    ExternItem(_) -> ExternFunction,
    InstanceItem(_) -> Instance,
    NumericItem(_) -> Numeric,
  }

fn expr_kind(source: Bytes, e: Expr) -> Kind / {abort.raise} =
  match fmt::surface_syntax(source, e) {
    fmt::Interpolated(_) -> Interpolation,
    fmt::MapLiteral(_) -> MapLiteral,
    fmt::SetLiteral(_) -> SetLiteral,
    fmt::AsParsed -> match e {
      LiteralExpression(v) -> match v.lit { LiteralInvalid -> Unparsed, _ -> Literal },
      NameExpression(_) -> Name,
      BinaryExpression(_) -> Binary,
      UnaryExpression(_) -> Unary,
      LambdaExpression(_) -> Lambda,
      CallExpression(_) -> if is_operator(e) { Binary }
      else if is_display(e) { Interpolation }
      else { Call },
      IfExpression(_) -> If,
      MatchExpression(_) -> Match,
      BlockExpression(_) -> Block,
      RecordExpression(v) -> if fmt::is_tuple(v.fields) { Tuple } else { RecordLiteral },
      RecordUpdateExpression(_) -> RecordUpdate,
      PropagateExpression(_) -> Propagate,
      FieldExpression(_) -> Access,
      ListExpression(_) -> ListLiteral,
      PerformExpression(_) -> Perform,
      HandleExpression(_) -> Handle,
      WithHoldExpression(_) -> WithHold,
      SimulateExpression(_) -> Simulate,
      ParallelExpression(_) -> Parallel,
      TaggedLiteralExpression(_) -> TaggedLiteral,
      HoleExpression(_) -> Hole,
      InvalidExpression(_) -> Unparsed,
      TryBlockExpression(_) -> TryBlock,
    },
  }

fn kind_of(source: Bytes, at: NodeSyntax) -> Kind / {abort.raise} =
  match at {
    ModuleSyntax(_) -> Module,
    ImportSyntax(_) -> Import,
    ImportedNameSyntax(_) -> ImportedName,
    ImportAliasSyntax(_) -> ImportAlias,
    ItemSyntax(item) -> item_kind(item),
    VariantSyntax(_) -> Variant,
    OperationSyntax(_) -> Operation,
    ParameterSyntax(_) -> Parameter,
    ClauseSyntax(c) -> match c.kind {
      RequiresClause -> Requires,
      EnsuresClause -> Ensures,
      CostClause -> Cost,
      SpaceClause -> Space,
    },
    DecreasesSyntax(_) -> Decreases,
    RowSyntax(_) -> Row,
    ExpressionSyntax(e) -> expr_kind(source, e),
    StatementSyntax(stmt) -> match stmt {
      LetElseStatement(_) -> LetElse,
      AssignmentStatement(_) -> Assignment,
      _ -> Let,
    },
    ArmSyntax(_) -> Arm,
    HandlerSyntax(_) -> Handler,
    ReturnHandlerSyntax(_) -> ReturnHandler,
    HandlerVariableSyntax(_) -> HandlerVariable,
    FieldSyntax(_) -> Field,
    PatternFieldSyntax(_) -> Field,
    TypeFieldSyntax(_) -> Field,
    PatternSyntax(p) -> match p {
      PatternWildcard(_) -> Wildcard,
      PatternVariable(_) -> Binding,
      PatternLiteral(_) -> LiteralPattern,
      PatternRange(_) -> RangePattern,
      PatternConstructor(_) -> ConstructorPattern,
      PatternRecord(v) -> if fmt::is_pat_tuple(v.fields) { TuplePattern } else { RecordPattern },
      PatternList(_) -> ListPattern,
      PatternOr(_) -> Alternatives,
      PatternInvalid(_) -> Unparsed,
    },
    TypeSyntax(t) -> match t {
      VariableTypeExpression(_) -> TypeVariable,
      NamedTypeExpression(_) -> TypeName,
      FunctionTypeExpression(_) -> FunctionType,
      RecordTypeExpression(x) -> if fmt::is_ty_tuple(x.fields) { TupleType } else { RecordType },
      UnitTypeExpression(_) -> UnitType,
      InvalidTypeExpression(_) -> Unparsed,
    },
  }

fn import_path(d: ImportDecl) -> parsing::Ident =
  {
    name: Bytes::join(d.path.map(|part: parsing::Ident| part.name), b"."),
    span: match ((d.path.at(0), d.path.at(d.path.len() - 1))) {
      (Some(first), Some(last)) -> parsing::span_to(first.span, last.span),
      _ -> d.span,
    },
  }

fn item_name(item: Item) -> parsing::Ident =
  match item {
    FunctionItem(d) -> d.name,
    TypeItem(d) -> d.name,
    EffectItem(d) -> d.name,
    TestItem(d) -> { name: d.label, span: d.label_span },
    LawItem(d) -> { name: d.name, span: d.name_span },
    SchemaItem(d) -> d.name,
    DeriveItem(d) -> d.target,
    EffectSetItem(d) -> d.name,
    ExternItem(d) -> d.name,
    InstanceItem(d) -> d.target,
    NumericItem(d) -> d.target,
  }

fn name_of(at: NodeSyntax) -> Option<parsing::Ident> =
  match at {
    ImportSyntax(d) -> Some(import_path(d)),
    ImportedNameSyntax(i) -> Some(i),
    ImportAliasSyntax(i) -> Some(i),
    ItemSyntax(item) -> Some(item_name(item)),
    VariantSyntax(v) -> Some(v.name),
    OperationSyntax(o) -> Some(o.name),
    ParameterSyntax(p) -> Some(p.name),
    ExpressionSyntax(e) -> match e {
      NameExpression(v) -> Some(v.name.name),
      FieldExpression(v) -> Some(v.field),
      PerformExpression(v) -> Some(v.op),
      TaggedLiteralExpression(t) -> Some(t.tag),
      _ -> None,
    },
    HandlerSyntax(c) -> Some(c.op),
    HandlerVariableSyntax(v) -> Some(v.name),
    StatementSyntax(stmt) -> match stmt { AssignmentStatement(v) -> Some(v.name), _ -> None },
    FieldSyntax(f) -> Some(f.name),
    PatternFieldSyntax(f) -> Some(f.name),
    TypeFieldSyntax(f) -> Some(f.name),
    PatternSyntax(p) -> match p {
      PatternVariable(v) -> Some(v.name),
      PatternConstructor(v) -> Some(v.name.name),
      _ -> None,
    },
    TypeSyntax(t) -> match t {
      VariableTypeExpression(i) -> Some(i),
      NamedTypeExpression(x) -> Some(x.name.name),
      _ -> None,
    },
    _ -> None,
  }

fn qualifier_of(at: NodeSyntax) -> Option<parsing::Ident> =
  match at {
    ExpressionSyntax(e) -> match e {
      NameExpression(v) -> v.name.module,
      PerformExpression(v) -> Some(v.effect_name.name),
      _ -> None,
    },
    HandlerSyntax(c) -> Some(c.effect_name.name),
    PatternSyntax(p) -> match p { PatternConstructor(v) -> v.name.module, _ -> None },
    TypeSyntax(t) -> match t { NamedTypeExpression(x) -> x.name.module, _ -> None },
    _ -> None,
  }

fn named(found: Option<parsing::Ident>) -> Option<Ident> =
  match found { Some(ident) -> Some(to_identifier(ident)), None -> None }

/// What a node is.
pub fn kind(node: Node) -> Kind / {abort.raise} =
  match node { Node(origin, at) -> kind_of(origin.source, at) }

/// Where a node is written in its source. An item's span starts at its keyword: a `pub` before
/// it and the doc above it lie outside, and a parenthesised expression's or pattern's takes in its
/// parentheses.
pub fn span(node: Node) -> Span = match node { Node(origin, at) -> span_of(origin.source, at) }

/// The whole source a node was parsed from.
pub fn source(node: Node) -> Bytes = match node { Node(origin, _) -> origin.source }

/// A node as written: the bytes of its span.
pub fn text(node: Node) -> Bytes / {abort.raise} =
  match node {
    Node(origin, at) -> {
      let s = span_of(origin.source, at);
      origin.source.slice(s.start, s.end)
    },
  }

/// The line and column a node starts at in its source.
pub fn place(node: Node) -> Location =
  match node { Node(origin, at) -> location_at(origin.source, span_of(origin.source, at).start) }

/// The nodes directly inside a node, in the order the source writes them: what its `Kind` says.
pub fn children(node: Node) -> List<Node> / {abort.raise} =
  match node {
    Node(origin, at) ->
      parts_of(origin.source, at).map(|part: NodeSyntax|
        Node(origin, resolve_method_call(origin, part))),
  }

/// `at` as the checker reads it where the parser cannot tell: `x.f(..)` on a name its item binds
/// is the call of the value's function, and on any other name a perform.
fn resolve_method_call(origin: Origin, at: NodeSyntax) -> NodeSyntax =
  match at {
    ExpressionSyntax(e) -> match e {
      PerformExpression(p) -> if p.effect_name.module != None
          || !bound_at(origin, p.span.start, p.effect_name.name.name) { at } else {
        let on = NameExpression({ span: p.effect_name.span, name: p.effect_name });
        ExpressionSyntax(
          CallExpression({
            span: p.span,
            func: FieldExpression({
              span: parsing::span_to(p.effect_name.span, p.op.span),
              base: on,
              field: p.op,
            }),
            named: [],
            args: p.args,
            labels: match p.resource { Some(r) -> [r], None -> [] },
          }),
        )
      },
      _ -> at,
    },
    _ -> at,
  }

/// Whether the item of `origin` written over `at` binds `name`.
fn bound_at(origin: Origin, at: Int, name: Bytes) -> Bool =
  origin.binding.fold(false, |found: Bool, b: { start: Int, end: Int, names: Map<Bytes, Bool> }|
    found || (at >= b.start && at < b.end && b.names.contains(name)))

/// The name a node declares, binds or refers to, and where it is written: what its `Kind` says.
/// A test's and a law's is its label.
pub fn name(node: Node) -> Option<Ident> = match node { Node(_, at) -> named(name_of(at)) }

/// What a name is reached through: the module binder of `m::f`, of a qualified constructor
/// pattern or type, and the effect of a `Perform` or a `Handler`.
pub fn qualifier(node: Node) -> Option<Ident> =
  match node { Node(_, at) -> named(qualifier_of(at)) }

/// A `Binary` or a `Unary` node's operator as it is written: `+`, `&&`, `+%`, `!`.
pub fn operator(node: Node) -> Option<String> =
  match node {
    Node(_, ExpressionSyntax(e)) -> match e {
      BinaryExpression(v) -> Some(String::of_bytes_lossy(fmt::op_text(v.op))),
      UnaryExpression(v) -> Some(String::of_bytes_lossy(fmt::unary_text(v.op))),
      CallExpression(v) -> match written_operator(v.func, v.args) {
        Some(o) -> Some(String::of_bytes_lossy(o.text)),
        None -> None,
      },
      _ -> None,
    },
    _ -> None,
  }

/// What a string literal reads as, its escapes read; `None` for any other node.
pub fn string_value(node: Node) -> Option<String> =
  match node {
    Node(_, ExpressionSyntax(LiteralExpression(v))) -> match v.lit {
      LiteralString(s) -> Some(String::of_bytes_lossy(s)),
      _ -> None,
    },
    _ -> None,
  }

/// What an `Int` literal reads as; `None` for any other node.
pub fn int_value(node: Node) -> Option<Int> =
  match node {
    Node(_, ExpressionSyntax(LiteralExpression(v))) -> match v.lit {
      LiteralInt(n) -> Some(n),
      _ -> None,
    },
    _ -> None,
  }

/// Whether an item is written `pub`.
pub fn is_public(node: Node) -> Bool =
  match node {
    Node(_, ItemSyntax(item)) -> match item {
      FunctionItem(d) -> is_pub(d.visibility),
      TypeItem(d) -> is_pub(d.visibility),
      EffectItem(d) -> is_pub(d.visibility),
      SchemaItem(d) -> is_pub(d.visibility),
      EffectSetItem(d) -> is_pub(d.visibility),
      _ -> false,
    },
    _ -> false,
  }

/// The doc comment of a module, an item, a variant or an operation, a line each without its
/// marker; empty where it has none.
pub fn doc(node: Node) -> List<String> = {
  let held = match node {
    Node(_, ModuleSyntax(m)) -> m.doc,
    Node(_, ItemSyntax(item)) -> item_doc(item),
    Node(_, VariantSyntax(v)) -> v.doc,
    Node(_, OperationSyntax(o)) -> o.doc,
    _ -> None,
  };
  match held { Some(d) -> d.lines.map(|line: Bytes| String::of_bytes_lossy(line)), None -> [] }
}

/// The comments written inside a node's span, in order: every comment of the source for its
/// `Module`. A doc comment above an item lies outside the item's span and inside the module's.
pub fn comments(node: Node) -> List<Comment> / {abort.raise} =
  match node {
    Node(origin, at) -> {
      let within = span_of(origin.source, at);
      origin.comments.fold([], |found: List<Comment>, c: lexer::Comment|
        if c.start < within.start || c.end > within.end { found } else {
          found.push({
            span: { start: c.start, end: c.end },
            text: String::of_bytes_lossy(origin.source.slice(c.start, c.end)),
          })
        })
    },
  }

fn walk_into(node: Node, room: Int, found: List<Node>) -> List<Node> / {abort.raise} =
  if room <= 0 { panic("a tree nests deeper than its source is long") } else {
    children(node).fold(found.push(node), |so_far: List<Node>, child: Node|
      walk_into(child, room - 1, so_far))
  }

/// A node and every node inside it, each before what it holds, in the order the source writes
/// them.
pub fn walk(node: Node) -> List<Node> / {abort.raise} =
  walk_into(node, 4 * source(node).len() + 64, [])

fn contains_offset(node: Node, offset: Int) -> Bool =
  span(node).start <= offset && offset < span(node).end

/// The nodes whose spans hold the byte at `offset`, outermost first, from `node` down: empty
/// where `node` does not hold it.
pub fn enclosing(node: Node, offset: Int) -> List<Node> / {abort.raise} =
  if !contains_offset(node, offset) { [] } else {
    iterate(
      { at: node, path: [node] },
      4 * source(node).len() + 64,
      |s: { at: Node, path: List<Node> }|
        match children(s.at).filter(|child: Node| contains_offset(child, offset)) {
          [] -> Stop(s.path),
          [inner, ..] -> Continue({ at: inner, path: s.path.push(inner) }),
        },
    )
  }

/// A node's tree with every position, comment and layout left out: two nodes have one shape
/// exactly when they are the same tree, however each is written. A literal counts by its value,
/// so `1_000` and `1000` are one shape.
pub fn shape(node: Node) -> Bytes / {abort.raise} =
  match node { Node(origin, at) -> shape_of(origin.source, at, 8) }

/// A part the compiler dumps is its dump; any other is its kind, its name and its parts' shapes,
/// each led by its length. Such a part holds dumped ones within two levels, which `room` covers.
fn shape_of(source: Bytes, at: NodeSyntax, room: Int) -> Bytes / {abort.raise} =
  match at {
    ModuleSyntax(m) -> parsing::erase_spans(items::dump_module(m)),
    ItemSyntax(item) -> parsing::erase_spans(items::dump_item(item)),
    ExpressionSyntax(e) -> parsing::erase_spans(exprs::dump_expr(e)),
    PatternSyntax(p) -> parsing::erase_spans(patterns::dump_pattern(p)),
    TypeSyntax(t) -> parsing::erase_spans(type_syntax::dump_ty(t)),
    ParameterSyntax(p) -> parsing::erase_spans(exprs::dump_param(p)),
    RowSyntax(r) -> parsing::erase_spans(type_syntax::dump_row(r)),
    _ -> if room <= 0 { b"" } else {
      Bytes::concat_all(
        parts_of(source, at).fold(
          [part_tag(at), b"(", match name_of(at) { Some(ident) -> ident.name, None -> b"" }, b")"],
          |acc: List<Bytes>, part: NodeSyntax| {
            let inner = shape_of(source, part, room - 1);
            acc.push(Bytes::of_string(inner.len().to_string())).push(b":").push(inner)
          },
        ),
      )
    },
  }

fn part_tag(at: NodeSyntax) -> Bytes =
  match at {
    ImportSyntax(_) -> b"import",
    ImportedNameSyntax(_) -> b"imported",
    ImportAliasSyntax(_) -> b"alias",
    VariantSyntax(_) -> b"variant",
    OperationSyntax(_) -> b"operation",
    ClauseSyntax(c) -> items::spec_kind_text(c.kind),
    DecreasesSyntax(_) -> b"decreases",
    StatementSyntax(stmt) -> match stmt {
      LetElseStatement(_) -> b"let-else",
      AssignmentStatement(_) -> b"assign",
      _ -> b"let",
    },
    ArmSyntax(_) -> b"arm",
    HandlerSyntax(_) -> b"handler",
    ReturnHandlerSyntax(_) -> b"return",
    HandlerVariableSyntax(_) -> b"var",
    FieldSyntax(_) -> b"field",
    PatternFieldSyntax(_) -> b"field",
    TypeFieldSyntax(_) -> b"field",
    _ -> b"",
  }

// --- Parsing ----------------------------------------------------------------

/// A source's tree, and what the parser said of it: no diagnostic for a source that parses.
pub type ParseResult = new { tree: Node, diagnostics: List<Diagnostic> }

/// `source`'s origin, `spans` the places of its items, each of which binds names apart.
fn origin_of(source: Bytes, spans: List<parsing::Span>) -> Origin / {abort.raise} =
  {
    source: source,
    comments: lexer::lex(source).comments,
    binding: spans.map(|s: parsing::Span|
      {
        start: s.start,
        end: s.end,
        names: lexer::bound_names(lexer::lex(source.slice(s.start, s.end)).tokens),
      }),
  }

/// `text`'s origin, read as one item.
fn origin_whole(text: Bytes) -> Origin / {abort.raise} =
  origin_of(text, [parsing::span_between(0, text.len())])

/// One module's source as a tree, a `Module` node, with the parser's diagnostics.
///
/// The parse takes time in proportion to the source and nests at most 128 deep, refusing what
/// nests deeper. An item that does not parse is a diagnostic and no node, and the items around it
/// are read.
pub fn parse(source: Bytes) -> ParseResult / {abort.raise} = {
  let read = items::parse(source);
  {
    tree: Node(origin_of(source, read.node.items.map(item_span)), ModuleSyntax(read.node)),
    diagnostics: read.parser.diags.map(|diag: ParseDiag| diagnostic_of(source, diag)),
  }
}

/// What `ply fmt` writes for a module's source: the same function, so the same bytes. A source
/// that does not parse is refused with the parser's first diagnostic, as the command refuses it.
/// The formatter holds its own answer to parsing as its source does, and refuses a source it
/// would print otherwise: that is a defect of `ply`, answered as `E0505`.
pub fn format(source: Bytes) -> Result<Bytes, Diagnostic> / {abort.raise} =
  match fmt::fmt_source(source) {
    Ok(out) -> Ok(out),
    Err(why) -> match items::parse(source).parser.diags.at(0) {
      Some(diag) -> Err(diagnostic_of(source, diag)),
      None ->
        Err(
          diagnostic_of(
            source,
            parsing::error_at(b"E0505", parsing::dummy_span(), why, b"not printed", []),
          ),
        ),
    },
  }

/// A source as `format` writes it, or as it is where `format` refuses it.
pub fn formatted(source: Bytes) -> Bytes / {abort.raise} =
  match format(source) { Ok(out) -> out, Err(_) -> source }

fn starts_before(a: Edit, b: Edit) -> Bool = a.span.start < b.span.start

/// `source` with every one of `edits` made, each by its span in `source` as it stands, and every
/// byte outside them kept. `None` where two edits overlap or one reaches outside the source.
pub fn apply_edits(source: Bytes, edits: List<Edit>) -> Option<Bytes> = {
  let ordered = edits.sort_by(starts_before);
  let wrap = ordered.fold(
    Some({ out: [], from: 0 }),
    |acc: Option<{ out: List<Bytes>, from: Int }>, edit: Edit|
      match acc {
        None -> None,
        Some(so_far) -> if edit.span.start < so_far.from || edit.span.end < edit.span.start
            || edit.span.end > source.len() { None } else {
          match try[abort.raise] { source.slice(so_far.from, edit.span.start) } {
            Err(_) -> None,
            Ok(kept) -> Some({ out: so_far.out.push(kept).push(edit.text), from: edit.span.end }),
          }
        },
      },
  );
  match wrap {
    None -> None,
    Some(done) -> match try[abort.raise] { source.slice(done.from, source.len()) } {
      Err(_) -> None,
      Ok(rest) -> Some(Bytes::concat_all(done.out.push(rest))),
    },
  }
}

// --- Fragments --------------------------------------------------------------

/// The first diagnostic of a parse that made any, or one for what follows the fragment.
fn fragment_diagnostic(
  source: Bytes,
  input: Input,
  parser: Parser,
  what: String,
) -> Option<Diagnostic> =
  match parser.diags.at(0) {
    Some(diag) -> Some(diagnostic_of(source, diag)),
    None -> if parsing::at_eof(input, parser) { None } else {
      Some(
        unexpected(
          source,
          to_span(parsing::current_span(input, parser)),
          "expected the end of " ++ what,
          "the " ++ what ++ " ends before this",
        ),
      )
    },
  }

fn parse_failure(parser: Parser, source: Bytes) -> Diagnostic =
  match parser.diags.at(0) {
    Some(diag) -> diagnostic_of(source, diag),
    None -> unexpected(source, { start: 0, end: 0 }, "this does not parse", "here"),
  }

/// One expression, whole: an `Err` where `text` is none, or holds more than one.
pub fn expression(text: Bytes) -> Result<Node, Diagnostic> / {abort.raise} = {
  let s = parsing::start(text);
  match exprs::expr(s.input, s.parser) {
    Err(parser) -> Err(parse_failure(parser, text)),
    Ok(read) -> match fragment_diagnostic(text, s.input, read.parser, "expression") {
      Some(why) -> Err(why),
      None -> {
        let origin = origin_whole(text);
        Ok(Node(origin, resolve_method_call(origin, ExpressionSyntax(read.node))))
      },
    },
  }
}

/// One pattern, whole.
pub fn pattern(text: Bytes) -> Result<Node, Diagnostic> / {abort.raise} = {
  let s = parsing::start(text);
  match patterns::pattern(s.input, s.parser) {
    Err(parser) -> Err(parse_failure(parser, text)),
    Ok(read) -> match fragment_diagnostic(text, s.input, read.parser, "pattern") {
      Some(why) -> Err(why),
      None -> Ok(Node(origin_whole(text), PatternSyntax(read.node))),
    },
  }
}

/// One type, whole.
pub fn type_expression(text: Bytes) -> Result<Node, Diagnostic> / {abort.raise} = {
  let s = parsing::start(text);
  match type_syntax::ty(s.input, s.parser) {
    Err(parser) -> Err(parse_failure(parser, text)),
    Ok(read) -> match fragment_diagnostic(text, s.input, read.parser, "type") {
      Some(why) -> Err(why),
      None -> Ok(Node(origin_whole(text), TypeSyntax(read.node))),
    },
  }
}

/// One item, whole, with its doc: an `Err` where `text` does not parse, imports, or holds none or
/// more than one.
pub fn item(text: Bytes) -> Result<Node, Diagnostic> / {abort.raise} = {
  let read = items::parse(text);
  match read.parser.diags.at(0) {
    Some(diag) -> Err(diagnostic_of(text, diag)),
    None -> match ((read.node.imports.filter(is_written), read.node.items)) {
      ([], [one]) -> Ok(Node(origin_whole(text), ItemSyntax(one))),
      _ ->
        Err(
          unexpected(
            text,
            { start: 0, end: text.len() },
            "expected one item and no import",
            "not one item",
          ),
        ),
    },
  }
}

/// A name as an expression, a `Name` node: an `Err` where `text` is not one identifier, a keyword
/// among them.
pub fn identifier(text: String) -> Result<Node, Diagnostic> / {abort.raise} = {
  let given = Bytes::of_string(text);
  let lexed = lexer::lex(given);
  match ((lexed.diags, lexed.tokens)) {
    ([], [first, _]) -> match first.kind {
      lexer::Identifier(n) -> {
        let at = parsing::span_between(first.start, first.end);
        Ok(
          Node(
            { source: given, comments: [], binding: [] },
            ExpressionSyntax(
              NameExpression({ span: at, name: parsing::bare({ name: n, span: at }) }),
            ),
          ),
        )
      },
      _ -> Err(not_a_name(given)),
    },
    _ -> Err(not_a_name(given)),
  }
}

fn not_a_name(given: Bytes) -> Diagnostic =
  unexpected(given, { start: 0, end: given.len() }, "expected one name", "not a name")

// --- The `syntax"…"` literal ------------------------------------------------

/// What may stand in a hole, by what the text around it makes of a name written there.
type HoleKind = | AsName | AsExpression | AsPattern | AsType

/// The texts of a `syntax"…"` literal with holes, and what each hole stands as.
pub opaque type Template = | Template(List<Bytes>, List<HoleKind>)

/// Why a literal's text is refused, as a tagged literal's parser answers it.
pub type Malformed = { message: String, offset: Int }

/// Why a literal's texts are refused: `part` is the text, counted from 0.
pub type MalformedPart = { message: String, offset: Int, part: Int }

fn hole_name(i: Int) -> Bytes = b"hole__".concat(Bytes::of_string(i.to_string()))

/// How many characters `text` holds before the byte at `upto`.
fn character_count(text: Bytes, upto: Int) -> Int =
  String::of_bytes_lossy(match try[abort.raise] { text.slice(0, upto) } {
    Ok(before) -> before,
    Err(_) -> text,
  }).len(
  )

/// The texts with a name where each hole stands, and where each text starts in the whole.
fn assemble_parts(texts: List<Bytes>) -> { whole: Bytes, starts: List<Int> } =
  range(0, texts.len()).fold(
    { whole: b"", starts: [] },
    |acc: { whole: Bytes, starts: List<Int> }, i: Int| {
      let led = if i == 0 { acc.whole } else { acc.whole.concat(hole_name(i - 1)) };
      { whole: led.concat(texts.at_or(i, b"")), starts: acc.starts.push(led.len()) }
    },
  )

/// The text an offset of the whole falls in, and how far into it: a hole's name counts as the end
/// of the text before it.
fn locate_part(texts: List<Bytes>, starts: List<Int>, offset: Int) -> { part: Int, offset: Int } =
  range(0, texts.len()).fold({ part: 0, offset: 0 }, |found: { part: Int, offset: Int }, i: Int| {
    let from = starts.at_or(i, 0);
    let text = texts.at_or(i, b"");
    if offset < from { found } else if offset <= from + text.len() {
      { part: i, offset: character_count(text, offset - from) }
    } else { { part: i, offset: character_count(text, text.len()) } }
  })

fn hole_kind_of(node: Node) -> HoleKind / {abort.raise} =
  match kind(node) {
    Name -> AsExpression,
    Binding -> AsPattern,
    TypeVariable -> AsType,
    _ -> AsName,
  }

/// What the hole named `hole` stands as in `tree`, where a node is named by it.
fn hole_kind_in(tree: Node, hole: Bytes) -> Option<HoleKind> / {abort.raise} = {
  let to_identifier = String::of_bytes_lossy(hole);
  walk(tree).fold(None, |found: Option<HoleKind>, node: Node|
    match found {
      Some(_) -> found,
      None -> match name(node) {
        Some(ident) -> if ident.text == to_identifier && qualifier(node) == None {
          Some(hole_kind_of(node))
        } else { None },
        None -> None,
      },
    })
}

/// What a `syntax"…"` literal with holes is checked by: the texts as one module, a name where
/// each hole stands. A hole stands where the name would be an expression, a pattern, a type, or
/// the name of a definition, a parameter or a field.
pub fn compile(parts: List<String>) -> Result<Template, MalformedPart> / {abort.raise} = {
  let texts = parts.map(Bytes::of_string);
  let wrap = assemble_parts(texts);
  let read = parse(wrap.whole);
  match primary_of(read.diagnostics) {
    Some(refused) -> {
      let at = locate_part(texts, wrap.starts, refused.span.start);
      Err({ message: refused.text, offset: at.offset, part: at.part })
    },
    None ->
      range(0, texts.len() - 1).fold(
        Ok(Template(texts, [])),
        |acc: Result<Template, MalformedPart>, i: Int|
          match acc {
            Err(_) -> acc,
            Ok(Template(held, stands)) -> match hole_kind_in(read.tree, hole_name(i)) {
              Some(stand) -> Ok(Template(held, stands.push(stand))),
              None ->
                Err({
                  message: "a hole stands here for an expression, a pattern, a type or a name, and this is none of them",
                  offset: character_count(texts.at_or(i, b""), texts.at_or(i, b"").len()),
                  part: i,
                }),
            },
          },
      ),
  }
}

/// The message and place of the first diagnostic, as a literal's refusal carries them.
fn primary_of(diagnostics: List<Diagnostic>) -> Option<{ text: String, span: Span }> =
  match diagnostics.at(0) {
    None -> None,
    Some(diagnostic) -> match primary(diagnostic) {
      Some(label) -> Some({ text: diagnostic.message, span: label.span }),
      None -> Some({ text: diagnostic.message, span: { start: 0, end: 0 } }),
    },
  }

/// What a `syntax"…"` literal with no hole is checked by, and is: the text as one module.
pub fn literal(text: String) -> Result<Node, Malformed> / {abort.raise} = {
  let given = Bytes::of_string(text);
  let read = parse(given);
  match primary_of(read.diagnostics) {
    Some(refused) ->
      Err({ message: refused.text, offset: character_count(given, refused.span.start) }),
    None -> Ok(read.tree),
  }
}

fn misplaced<a>(node: Node, wanted: String) -> a / {syntax.fail, abort.raise} =
  syntax.fail(
    unexpected(
      text(node),
      { start: 0, end: text(node).len() },
      "a hole here takes " ++ wanted,
      "not " ++ wanted,
    ),
  )

fn is_bare_name(node: Node) -> Bool / {abort.raise} =
  qualifier(node) == None
    && (match kind(node) { Name -> true, Binding -> true, TypeVariable -> true, _ -> false })

/// A node's text in parentheses. A line string runs to the end of its line, so one that ends the
/// text has the closing parenthesis on the next.
fn parenthesized(node: Node) -> Bytes / {abort.raise} = {
  let to_span = text(node);
  let ends_lines = match to_span.index_of(b"\\\\") { Some(_) -> b"\n", None -> b"" };
  Bytes::concat_all([b"(", to_span, ends_lines, b")"])
}

/// A node as the text a hole of its stand takes.
fn hole_text(stand: HoleKind, node: Node) -> Bytes / {syntax.fail, abort.raise} =
  match ((stand, node)) {
    (AsName, _) -> if is_bare_name(node) { text(node) } else { misplaced(node, "a name") },
    (AsExpression, Node(_, ExpressionSyntax(e))) -> match e {
      NameExpression(_) -> text(node),
      _ -> parenthesized(node),
    },
    (AsExpression, _) -> misplaced(node, "an expression"),
    (AsPattern, Node(_, PatternSyntax(_))) -> parenthesized(node),
    (AsPattern, _) -> if is_bare_name(node) { text(node) } else { misplaced(node, "a pattern") },
    (AsType, Node(_, TypeSyntax(_))) -> parenthesized(node),
    (AsType, _) -> if is_bare_name(node) { text(node) } else { misplaced(node, "a type") },
  }

/// The module a `syntax"…"` literal is with `holes` where its holes stand: each node written
/// whole where it stands, in parentheses unless it is a name. Refused where a node is not what its
/// hole takes, or the text made does not parse.
pub fn fill(template: Template, holes: List<Node>) -> Node / {syntax.fail, abort.raise} =
  match template {
    Template(texts, stands) -> {
      let whole = Bytes::concat_all(
        range(0, texts.len()).fold([], |acc: List<Bytes>, i: Int| {
          let with_text = acc.push(texts.at_or(i, b""));
          match ((stands.at(i), holes.at(i))) {
            (Some(stand), Some(node)) -> with_text.push(hole_text(stand, node)),
            _ -> with_text,
          }
        }),
      );
      let read = parse(whole);
      match read.diagnostics.at(0) { Some(why) -> syntax.fail(why), None -> read.tree }
    },
  }

// --- Sampling ---------------------------------------------------------------

/// A small module that parses and checks, written with uneven layout and comments, for a test
/// about source to draw: `samples()` draws programs where a `Bytes` draws noise no parser reads.
/// Its definitions are `f0`, `f1` and so on, each of one `Int` named `x` to an `Int`, and a `let`
/// in one binds `y`.
pub type Sample = | Sample(Bytes)

/// The source a `Sample` holds.
pub fn sample_source(s: Sample) -> Bytes = match s { Sample(source) -> source }

/// The smallest bodies of a sample: each an `Int` over `x`, with no import behind it.
fn sample_atoms() -> List<Bytes> =
  [b"x", b"1", b"2_000", b"0xFF", b"( x )", b"[x,x].len()", b"#{ 1:x }.len()"]

/// What a body is also written with where only its spelling is read: the forms the parser makes
/// calls of, and the literals whose spelling the formatter keeps.
fn spelling_atoms() -> List<Bytes> =
  sample_atoms().concat([
    b"f\"n {x}\"",
    b"(f\"{x+1} of {x}\")",
    b"( ( f\"{x}\" ) )",
    b"tag\"t {x}\"",
    b"#[x, 1 ]",
    b"(x,1)",
    b"x +% 1",
    b"{ a:x, b }",
    b"{ ..r, a:x }",
    b"g(x, to:1)",
    b"r.a",
    b"x?",
    b"'c'",
    b"1.50m",
    b"b\"\\x00\"",
    b"-  x",
    b"|n: Int| n",
    b"eff.op[r](x)",
  ])

fn sample_bodies(depth: Int, atoms: List<Bytes>) -> Gen<Bytes> =
  if depth <= 0 { gen::elements(atoms) } else {
    let inner = sample_bodies(depth - 1, atoms);
    gen::one_of([
      gen::elements(atoms),
      gen::map2(inner, inner, |a: Bytes, b: Bytes| Bytes::concat_all([a, b"+   ", b])),
      gen::map2(inner, inner, |a: Bytes, b: Bytes| Bytes::concat_all([a, b"  *  (", b, b")"])),
      gen::map2(inner, inner, |a: Bytes, b: Bytes|
        Bytes::concat_all([b"if (", a, b")>0{", b, b"}else{ x }"])),
      gen::map2(inner, inner, |a: Bytes, b: Bytes|
        Bytes::concat_all([b"{ let y=", a, b";\n      y - ", b, b" }"])),
      gen::map2(inner, inner, |a: Bytes, b: Bytes|
        Bytes::concat_all([b"match (", a, b") { 0->", b, b",  // none\n _ -> x }"])),
      gen::map(inner, |a: Bytes|
        Bytes::concat_all([b"[1,2 , 3].fold(", a, b",|acc:Int,n:Int| acc+n)"])),
    ])
  }

/// A module of up to three definitions, each body made of `atoms`.
fn sample_modules(atoms: List<Bytes>) -> Gen<Bytes> =
  gen::map(
    gen::list_of(
      gen::map2(
        gen::elements([b"", b"// a note\n", b"/// A doc.\n", b"\n\n"]),
        sample_bodies(2, atoms),
        |lead: Bytes, body: Bytes| { lead: lead, body: body },
      ),
      3,
    ),
    |defs: List<{ lead: Bytes, body: Bytes }>|
      Bytes::concat_all(
        range(0, defs.len()).map(|i: Int| {
          let def = defs.at_or(i, { lead: b"", body: b"x" });
          Bytes::concat_all([
            def.lead,
            b"fn f",
            Bytes::of_string(i.to_string()),
            b"( x:Int )->Int=",
            def.body,
            b"\n",
          ])
        }),
      ),
  )

/// A `Sample` as a test draws one.
pub fn samples() -> Gen<Sample> =
  gen::map(sample_modules(sample_atoms()), |source: Bytes| Sample(source))

/// A module that parses and need not check: a sample's layouts over every form the formatter reads
/// back from the source.
type Spelling = | Spelling(Bytes)

fn spelling_text(s: Spelling) -> Bytes = match s { Spelling(source) -> source }

fn spellings() -> Gen<Spelling> =
  gen::map(sample_modules(spelling_atoms()), |source: Bytes| Spelling(source))

/// A text made of what Ply source is written in, most of it no module: openers of every literal,
/// escapes, brackets, operators and characters cut short, which a `Bytes` rarely draws side by side.
type Noise = | Noise(Bytes)

fn noise_text(n: Noise) -> Bytes = match n { Noise(text) -> text }

fn noises() -> Gen<Noise> =
  gen::map(gen::list_of(gen::elements(noise_parts()), 12), |parts: List<Bytes>|
    Noise(Bytes::concat_all(parts)))

fn noise_parts() -> List<Bytes> =
  [
    b"fn f() -> Int = ",
    b"type T = ",
    b"test \"",
    b"law \"",
    b"import a.b ",
    b"\"",
    b"'",
    b"b\"",
    b"b'",
    b"f\"",
    b"tag\"",
    b"\\\\",
    b"\\",
    b"\\u{",
    b"\\x",
    b"\\n",
    b"{",
    b"}",
    b"(",
    b")",
    b"[",
    b"]",
    b"#{",
    b"#[",
    b"<",
    b">",
    b"|",
    b"->",
    b"=",
    b",",
    b";",
    b":",
    b"::",
    b".",
    b"..=",
    b"?",
    b"+%",
    b"-",
    b"/",
    b"//",
    b"///",
    b"//!",
    b"\n",
    b" ",
    b"x",
    b"_",
    b"1",
    b"0x",
    b"1e",
    b"1.",
    b"u8",
    b"m",
    b"if ",
    b"else ",
    b"match ",
    b"let ",
    b"handle ",
    b"with ",
    b"\xc3",
    b"\xc3\xa9",
    b"\xe2\x82",
    b"\xf0\x9f",
    b"\xff",
    b"\x00",
  ]

// --- Tests ------------------------------------------------------------------

fn tree_of(source: Bytes) -> Node / {abort.raise} = parse(source).tree

fn kinds(nodes: List<Node>) -> List<Kind> / {abort.raise} = nodes.map(kind)

fn texts_of(nodes: List<Node>) -> List<Bytes> / {abort.raise} = nodes.map(text)

fn names_in(tree: Node) -> List<String> / {abort.raise} =
  walk(tree).fold([], |found: List<String>, node: Node|
    match ((kind(node), name(node))) { (Name, Some(ident)) -> found.push(ident.text), _ -> found })

fn first_item(source: Bytes) -> Node / {abort.raise} =
  match children(tree_of(source)) { [first, ..] -> first, [] -> panic("the source holds no item") }

fn body_of(source: Bytes) -> Node / {abort.raise} = {
  let parts = children(first_item(source));
  match parts.at(parts.len() - 1) { Some(body) -> body, None -> panic("the item holds nothing") }
}

test "a module is its imports and its items, each read by what it is and what it names" {
  let tree = tree_of(
    b"//! A module.\n\nimport std.list (at, concat)\nimport std.json as j\n\n/// Adds.\npub fn add(a: Int, b: Int) -> Int = a + b\n\ntype Shape = | Dot | Line(Int)\n\ntest \"adds\" { assert_eq(add(1, 2), 3) }\n",
  );
  assert_eq(kind(tree), Module);
  assert_eq(doc(tree), ["A module."]);
  let parts = children(tree);
  assert_eq(kinds(parts), [Import, Import, Function, TypeDeclaration, Test]);
  assert_eq(parts.map(|n: Node| match name(n) { Some(i) -> i.text, None -> "" }), [
    "std.list",
    "std.json",
    "add",
    "Shape",
    "adds",
  ]);
  assert_eq(texts_of(children(parts.at_or(0, tree))), [b"at", b"concat"]);
  assert_eq(kinds(children(parts.at_or(1, tree))), [ImportAlias]);
  let add = parts.at_or(2, tree);
  assert(is_public(add));
  assert_eq(doc(add), ["Adds."]);
  assert_eq(kinds(children(add)), [Parameter, Parameter, TypeName, Binary]);
  assert_eq(text(add), b"fn add(a: Int, b: Int) -> Int = a + b");
  assert_eq(kinds(children(parts.at_or(3, tree))), [Variant, Variant])
}

test "a law's or a schema's `identity(a)` is the type variable it constrains, and an `invariant` is an instance" {
  let tree = tree_of(
    b"law \"l\" forall (x: a, y: b) where identity(a), x == x { x == y }\n\nlaw schema s<a>(f: (a) -> a) forall (x: a) where identity(a) { f(x) == x }\n\ninvariant for T by valid\n",
  );
  let parts = children(tree);
  assert_eq(kinds(parts), [Law, LawSchema, Instance]);
  let law = children(parts.at_or(0, tree));
  assert_eq(kinds(law.take(4)), [Parameter, Parameter, TypeVariable, Binary]);
  assert_eq(text(law.at_or(2, tree)), b"a");
  let schema = children(parts.at_or(1, tree));
  assert_eq(kinds(schema.take(3)), [Parameter, Parameter, TypeVariable]);
  assert_eq(text(schema.at_or(2, tree)), b"a");
  assert_eq(match name(parts.at_or(2, tree)) { Some(i) -> i.text, None -> "" }, "T")
}

test "an expression is read as it is written, whatever the compiler makes of it" {
  let body = |source: Bytes| body_of(b"fn f(x: Int, m: Map<Int, Int>) -> Int = ".concat(source));
  assert_eq(kind(body(b"f\"a {x} b {x + 1}\"\n")), Interpolation);
  assert_eq(texts_of(children(body(b"f\"a {x} b {x + 1}\"\n"))), [b"x", b"x + 1"]);
  assert_eq(kind(body(b"#{1: x, 2: 3}\n")), MapLiteral);
  assert_eq(texts_of(children(body(b"#{1: x, 2: 3}\n"))), [b"1", b"x", b"2", b"3"]);
  assert_eq(kind(body(b"#[x, 2]\n")), SetLiteral);
  assert_eq(texts_of(children(body(b"#[x, 2]\n"))), [b"x", b"2"]);
  assert_eq(kind(body(b"(x, 2)\n")), Tuple);
  assert_eq(texts_of(children(body(b"(x, 2)\n"))), [b"x", b"2"]);
  let wrapping = body(b"x +% 2\n");
  assert_eq(kind(wrapping), Binary);
  assert_eq(operator(wrapping), Some("+%"));
  assert_eq(texts_of(children(wrapping)), [b"x", b"2"]);
  assert_eq(operator(body(b"x * 2\n")), Some("*"));
  assert_eq(kinds(children(body(b"if x > 0 { x }\n"))), [Binary, Block]);
  assert_eq(kinds(children(body(b"if x > 0 { x } else { 0 }\n"))), [Binary, Block, Block]);
  assert_eq(names_in(body(b"f(x, m: m)\n")), ["f", "x", "m"]);
  assert_eq(names_in(body(b"f\"{x}\"\n")), ["x"])
}

test "every name a body refers to is a node, and no name the parser wrote for itself is" {
  let tree = tree_of(
    b"fn f(xs: List<Int>, m: Map<Int, Int>) -> String = {\n  let total = xs.fold(0, |acc: Int, x: Int| acc + x);\n  match xs.at(total) {\n    Some(first) -> f\"{first} of {xs.len()}\",\n    None -> show(#{1: total}),\n  }\n}\n",
  );
  assert_eq(names_in(tree), ["xs", "acc", "x", "xs", "total", "first", "xs", "show", "total"])
}

test "a call written on a name its item binds is a call on that value, and on any other a perform" {
  let tree = tree_of(
    b"effect log { write line(text: String) -> Unit }\n\nfn f(xs: List<Int>) -> Int / {log.line} = {\n  log.line(\"x\");\n  xs.len()\n}\n",
  );
  let calls = walk_into(tree, 64, []).filter(|n: Node| kind(n) == Call || kind(n) == Perform);
  assert_eq(calls.map(kind), [Perform, Call]);
  match calls.at(1) {
    Some(call) -> {
      let reached = children(call);
      assert_eq(reached.map(kind), [Access]);
      assert_eq(reached.map(|n: Node| text(n)), [b"xs.len"]);
      assert_eq(reached.flat_map(children).map(kind), [Name]);
      assert_eq(match name(reached.get(0)) { Some(i) -> Some(i.text), None -> None }, Some("len"))
    },
    None -> panic("two calls"),
  };
  // A fragment binds as one item.
  match expression(b"|ys: List<Int>| ys.len()") {
    Ok(lambda) -> assert(walk_into(lambda, 8, []).any(|n: Node| kind(n) == Access)),
    Err(_) -> panic("the fragment parses"),
  }
}

test "a node is found by a byte of its source, and read by its place" {
  let source = b"fn f(x: Int) -> Int =\n  x + 10\n";
  let tree = tree_of(source);
  let path = enclosing(tree, 28);
  assert_eq(kinds(path), [Module, Function, Binary, Literal]);
  let ten = path.at_or(3, tree);
  assert_eq(text(ten), b"10");
  assert_eq(int_value(ten), Some(10));
  assert_eq(place(ten), { line: 2, column: 7 });
  assert_eq(span(ten), { start: 28, end: 30 });
  assert_eq(enclosing(tree, 400), [])
}

test "comments are reached from the node whose span holds them, and docs from what they document" {
  let source = b"// leads\n/// Doubles.\nfn double(x: Int) -> Int = {\n  // twice\n  x * 2  // done\n}\n";
  let tree = tree_of(source);
  assert_eq(comments(tree).map(|c: Comment| c.text), [
    "// leads",
    "/// Doubles.",
    "// twice",
    "// done",
  ]);
  let item = first_item(source);
  assert_eq(doc(item), ["Doubles."]);
  assert_eq(comments(item).map(|c: Comment| c.text), ["// twice", "// done"])
}

test "a source that does not parse answers its diagnostics as values and the items around the break" {
  let read = parse(b"fn one() -> Int = 1\n\nfn two( = 2\n\nfn three() -> Int = 3\n");
  assert_eq(read.diagnostics.map(|d: Diagnostic| d.code), ["E0001"]);
  match read.diagnostics.at(0) {
    None -> panic("the parser reports the break"),
    Some(d) -> {
      assert_eq(d.severity, Error);
      assert(d.message.starts_with("expected "));
      match primary(d) {
        None -> panic("a diagnostic is placed"),
        Some(label) -> {
          assert_eq(label.place, { line: 3, column: 9 });
          assert_eq(label.span.start, 29)
        },
      }
    },
  };
  assert_eq(children(read.tree).map(|n: Node| match name(n) { Some(i) -> i.text, None -> "" }), [
    "one",
    "three",
  ])
}

test "format is the formatter: it lays a module out, keeps its comments and refuses what does not parse" {
  assert_eq(
    format(b"// top\nfn   f(a: Int,b: Int)->Int = a+b // add\n"),
    Ok(b"// top\nfn f(a: Int, b: Int) -> Int = a + b  // add\n"),
  );
  match format(b"fn f( = 1\n") {
    Ok(_) -> panic("a source that does not parse is not printed"),
    Err(d) -> assert_eq(d.code, "E0001"),
  };
  assert_eq(formatted(b"fn f( = 1\n"), b"fn f( = 1\n")
}

test "two sources that differ in layout, comments and a literal's spelling have one shape" {
  let a = tree_of(b"fn f(x: Int) -> Int = x + 1_000\n");
  let b = tree_of(b"// the same\nfn f( x : Int ) -> Int =\n  x + 1000\n");
  assert_eq(shape(a), shape(b));
  assert(a != b);
  assert(shape(a) != shape(tree_of(b"fn f(x: Int) -> Int = x + 1001\n")));
  assert_eq(
    shape(body_of(b"fn f(x: Int) -> Int = x + 1\n")),
    shape(body_of(b"fn g(x: Int) -> Int =\n  x  +  1\n")),
  )
}

test "edits are made by span and keep every other byte, and edits that collide are refused" {
  let source = b"fn f(x: Int) -> Int = x + x  // twice\n";
  let renamed = apply_edits(source, [
    { path: "", span: { start: 26, end: 27 }, text: b"y" },
    { path: "", span: { start: 5, end: 6 }, text: b"y" },
    { path: "", span: { start: 22, end: 23 }, text: b"y" },
  ]);
  assert_eq(renamed, Some(b"fn f(y: Int) -> Int = y + y  // twice\n"));
  assert_eq(
    apply_edits(source, [{ path: "", span: { start: 0, end: 0 }, text: b"pub " }]),
    Some(b"pub ".concat(source)),
  );
  assert_eq(
    apply_edits(source, [
      { path: "", span: { start: 5, end: 7 }, text: b"a" },
      { path: "", span: { start: 6, end: 8 }, text: b"b" },
    ]),
    None,
  );
  assert_eq(apply_edits(source, [{ path: "", span: { start: 30, end: 90 }, text: b"" }]), None)
}

test "a fragment is one expression, pattern, type, item or name, whole, or it is refused" {
  match expression(b"f(x) + 1") {
    Ok(node) -> {
      assert_eq(kind(node), Binary);
      assert_eq(names_in(node), ["f", "x"])
    },
    Err(d) -> panic(d.message),
  };
  assert(match expression(b"f(x) g") { Ok(_) -> false, Err(d) -> d.code == "E0001" });
  assert(match expression(b"") { Ok(_) -> false, Err(_) -> true });
  assert(match pattern(b"Some([first, ..rest])") {
    Ok(n) -> kind(n) == ConstructorPattern,
    Err(_) -> false,
  });
  assert(match type_expression(b"Map<String, List<Int>>") {
    Ok(n) -> kind(n) == TypeName,
    Err(_) -> false,
  });
  assert(match type_expression(b"Map<String") { Ok(_) -> false, Err(_) -> true });
  assert(match item(b"/// One.\nfn one() -> Int = 1\n") {
    Ok(n) -> doc(n) == ["One."],
    Err(_) -> false,
  });
  assert(match item(b"fn one() -> Int = 1\nfn two() -> Int = 2\n") {
    Ok(_) -> false,
    Err(_) -> true,
  });
  assert(match identifier("total") { Ok(n) -> kind(n) == Name, Err(_) -> false });
  assert(match identifier("fn") { Ok(_) -> false, Err(_) -> true });
  assert(match identifier("a b") { Ok(_) -> false, Err(_) -> true })
}

fn filled_text(parts: List<String>, holes: List<Node>) -> Result<Bytes, String> / {abort.raise} =
  match compile(parts) {
    Err(why) -> Err(why.message),
    Ok(template) -> match try { fill(template, holes) } {
      Ok(tree) -> Ok(formatted(source(tree))),
      Err(why) -> Err(why.message),
    },
  }

fn fragment(read: Result<Node, Diagnostic>) -> Node / {abort.raise} =
  match read { Ok(node) -> node, Err(d) -> panic(d.message) }

test "a literal's holes take nodes: a name, an expression bracketed where it stands, a pattern, a type" {
  assert_eq(
    filled_text(["pub fn ", "(x: ", ") -> ", " = match x { ", " -> ", " * 2, _ -> 0 }\n"], [
      fragment(identifier("twice")),
      fragment(type_expression(b"Option<Int>")),
      fragment(type_expression(b"Int")),
      fragment(pattern(b"Some(n)")),
      fragment(expression(b"n + 1")),
    ]),
    Ok(b"pub fn twice(x: Option<Int>) -> Int = match x { Some(n) -> (n + 1) * 2, _ -> 0 }\n"),
  );
  assert(match expression(b"1 } fn g() -> Int = { 2") { Ok(_) -> false, Err(_) -> true })
}

test "a function type and a line string in a hole stay the one node each was" {
  assert_eq(
    filled_text(["fn f(g: ", ") -> Int / {abort.raise} = g(1)\n"], [
      fragment(type_expression(b"(Int) -> Int / {abort.raise}")),
    ]),
    Ok(b"fn f(g: (Int) -> Int / {abort.raise}) -> Int / {abort.raise} = g(1)\n"),
  );
  match filled_text(["fn f() -> String = ", " ++ \"!\"\n"], [fragment(expression(b"\\\\one\n"))]) {
    Err(why) -> panic(why),
    Ok(wrap) -> {
      let body = body_of(wrap);
      assert_eq(kind(body), Binary);
      assert_eq(children(body).map(string_value), [Some("one"), Some("!")])
    },
  }
}

test "a hole that takes a name refuses anything else, and a text that is no module is refused where it breaks" {
  assert_eq(
    filled_text(["fn ", "() -> Int = 1\n"], [fragment(expression(b"a + b"))]),
    Err("a hole here takes a name"),
  );
  assert_eq(
    compile(["fn f( = ", "\n"]),
    Err({ message: "expected a parameter name, found `=`", offset: 6, part: 0 }),
  );
  assert(match literal("fn f() -> Int = 1\n") {
    Ok(tree) -> kind(tree) == Module,
    Err(_) -> false,
  });
  assert_eq(
    match literal("fn f() -> Int = \n") { Ok(_) -> None, Err(why) -> Some(why.offset) },
    Some(17),
  )
}

test "a sample is a module that parses" {
  let drawn = gen::sample(samples(), 7, b"sample", 16, None);
  match drawn.value {
    None -> panic("a sample is drawn"),
    Some(s) -> assert_eq(parse(sample_source(s)).diagnostics, []),
  }
}

test "any text is read as a module, with diagnostics where it is none, and walked" {
  gen::check(noises(), |n: Noise| {
    let read = parse(noise_text(n));
    kind(read.tree) == Module && walk(read.tree).len() > 0
      && formatted(formatted(noise_text(n))) == formatted(noise_text(n))
  })
}

test "formatting a module a second time changes nothing" {
  gen::check(spellings(), |s: Spelling| {
    formatted(formatted(spelling_text(s))) == formatted(spelling_text(s))
  })
}

test "a formatted module parses to the tree its source does" {
  gen::check(spellings(), |s: Spelling| {
    shape(parse(formatted(spelling_text(s))).tree) == shape(parse(spelling_text(s)).tree)
  })
}
