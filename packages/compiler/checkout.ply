import compiler.native
import std.fs
import std.fs (fs, Entry, File)
import std.hash (blake3)
import std.list
import std.path (join, normalize, strip_root)
import std.pkg (ToolchainParts)
import std.string

pub type Checkout = { root: String, parts: ToolchainParts }

pub type Part = { dir: String, prefix: String }

pub fn parts_of(c: Checkout) -> List<Part> =
  [
    { dir: normalize(join(c.root, c.parts.std)), prefix: native::std_root },
    { dir: normalize(join(c.root, c.parts.compiler)), prefix: native::compiler_root },
  ]

pub type ShippedFile = { name: String, path: String, bytes: Bytes }

fn files_below(dir: String) -> List<{ rel: String, bytes: Bytes }> / {fs.read[abs], abort.raise} =
  match fs.walk[abs](strip_root(dir)) {
    None -> [],
    Some(entries) ->
      entries.fold([], |accumulator: List<{ rel: String, bytes: Bytes }>, e: Entry|
        match e.kind {
          File -> {
            let rel = e.path.slice(strip_root(dir).len() + 1, e.path.len());
            if rel.starts_with(".") || rel.contains("/.") { accumulator } else {
              match fs.read_file[abs](e.path) {
                Some(bytes) -> accumulator.push({ rel: rel, bytes: bytes }),
                None -> accumulator,
              }
            }
          },
          _ -> accumulator,
        }),
  }

pub fn module_at(prefix: String, rel: String) -> String / {abort.raise} =
  prefix ++ "." ++ rel.slice(0, rel.len() - 4).replace("/", ".")

pub fn shipped_files(c: Checkout) -> List<ShippedFile> / {fs.read[abs], abort.raise} =
  parts_of(c).flat_map(|part: Part|
    files_below(part.dir).fold(
      [],
      |accumulator: List<ShippedFile>, f: { rel: String, bytes: Bytes }| {
        let path = part.prefix ++ "/" ++ f.rel;
        if f.rel.ends_with(".ply") {
          accumulator.push({
            name: module_at(part.prefix, f.rel) ++ ".ply",
            path: path,
            bytes: f.bytes,
          })
        } else if part.prefix == native::std_root {
          accumulator.push({ name: path, path: path, bytes: f.bytes })
        } else { accumulator }
      },
    ))

pub fn module_files(c: Checkout) -> Map<String, String> / {fs.read[abs], abort.raise} =
  parts_of(c).fold(Map::new(), |accumulator: Map<String, String>, part: Part|
    files_below(part.dir).fold(
      accumulator,
      |files: Map<String, String>, f: { rel: String, bytes: Bytes }|
        if f.rel.ends_with(".ply") {
          files.insert(module_at(part.prefix, f.rel) ++ ".ply", part.dir ++ "/" ++ f.rel)
        } else { files },
    ))

pub fn module_names(files: List<ShippedFile>) -> List<String> / {abort.raise} =
  files.fold([], |accumulator: List<String>, f: ShippedFile|
    if f.name.ends_with(".ply") { accumulator.push(f.name.slice(0, f.name.len() - 4)) }
    else { accumulator })

pub fn digests_of(files: List<ShippedFile>) -> Bytes / {abort.raise} = {
  let lines = files.fold(Map::new(), |accumulator: Map<String, Bool>, f: ShippedFile|
    accumulator.insert(f.name ++ " " ++ blake3(f.bytes).hex_of() ++ "\n", true));
  Bytes::concat_all(lines.keys().map(Bytes::of_string))
}

pub fn shipped_store_dir(reused: String) -> String / {abort.raise} = {
  let cut = range(0, reused.len()).fold(0 - 1, |accumulator: Int, i: Int|
    if reused.slice(i, i + 1) == "/" { i } else { accumulator });
  if cut < 0 { "memo-std" } else { reused.slice(0, cut) ++ "/memo-std" }
}
