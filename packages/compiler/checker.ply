import compiler.front.facts (Analysis)
import compiler.front.emitter_input (Analysed, Rejected)
import compiler.front.rows (module_of)
import compiler.store.hash.encoding (hex)
import compiler.check.infer.checker (DefinitionInfo)
import compiler.syntax
import compiler.syntax (Diagnostic, Edit, Error, Sample, Span, Warning, sample_source)
import compiler.syntax.items (Item, EffectItem, TypeItem)
import compiler.load
import compiler.load (SourceFile)
import compiler.syntax.parsing
import compiler.check.resolve
import compiler.check.resolve.tables (ParsedModule, qualify)
import compiler.check.types (effects_text, scheme_text)
import compiler.unit (shipped)
import std.bytes
import std.list
import std.location (location_at)
import std.gen
import compiler.check.resolve.tables

pub type Source = new { path: String, text: Bytes }

pub type Limits = new { files: Int, bytes: Int }

pub type InputError = | TooManyFiles(Int) | TooManyBytes(Int) | NotAModule(String, String)

pub effect checker {
  raise fail(reason: InputError)
}

pub effect set Shipped = {shipped.names, shipped.module, shipped.report_view_used}

pub type DefinitionKind = | Function | Type | Effect

pub type Definition = new {
  name: String,
  module: String,
  simple_name: String,
  kind: DefinitionKind,
  path: String,
  span: Span,
  signature: String,
  row: String,
  hash: String,
  references: List<String>,
}

pub type CheckResult = new {
  ok: Bool,
  diagnostics: List<Diagnostic>,
  definitions: List<Definition>,
}

fn validate_sources(
  sources: List<Source>,
  limits: Limits,
) -> List<SourceFile> / {checker.fail, abort.raise} = {
  let bytes = sources.fold(0, |total: Int, source: Source| total + source.text.len());
  if sources.len() > limits.files { checker.fail(TooManyFiles(sources.len())) }
  else if bytes > limits.bytes { checker.fail(TooManyBytes(bytes)) } else {
    sources.map(|source: Source|
      match module_of(source.path) {
        Ok(module) -> { path: source.path, name: module, text: source.text },
        Err(reason) -> checker.fail(NotAModule(source.path, reason)),
      })
  }
}

fn file_at(files: List<SourceFile>, module: Int) -> SourceFile =
  files.at_or(module, { path: "", name: "", text: b"" })

fn diagnostic_of(files: List<SourceFile>, diagnostic: tables::Diagnostic) -> Diagnostic =
  {
    code: String::of_bytes_lossy(diagnostic.code),
    severity: if diagnostic.severity == b"warning" { Warning } else { Error },
    message: String::of_bytes_lossy(diagnostic.message),
    labels: diagnostic.labels.map(|label: tables::Label| {
      let file = file_at(files, label.module);
      {
        path: file.path,
        span: { start: label.start, end: label.end },
        place: location_at(file.text, label.start),
        primary: label.primary,
        text: String::of_bytes_lossy(label.text),
      }
    }),
    notes: diagnostic.notes_text.map(|note: Bytes| String::of_bytes_lossy(note)),
    fixes: diagnostic.fixes.map(|fix: tables::Fix|
      {
        title: String::of_bytes_lossy(fix.title),
        edits: fix.edits.map(|edit: tables::Edit|
          {
            path: file_at(files, edit.module).path,
            span: { start: edit.start, end: edit.end },
            text: edit.text,
          }),
      }),
  }

type Tables = { hashes: Map<Bytes, Bytes>, references: Map<Bytes, List<Bytes>> }

fn tables_of(analysis: Analysis) -> Tables =
  {
    hashes: analysis.hashes.declarations.fold(
      analysis.hashes.definitions.fold(
        Map::new(),
        |hashes_by_name: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }|
          hashes_by_name.insert(d.name, d.hash),
      ),
      |hashes_by_name: Map<Bytes, Bytes>, d: { name: Bytes, hash: Bytes }|
        hashes_by_name.insert(d.name, d.hash),
    ),
    references: analysis.hashes.dependencies.fold(
      Map::new(),
      |references_by_name: Map<Bytes, List<Bytes>>, d: { name: Bytes, names: List<Bytes> }|
        references_by_name.insert(d.name, d.names),
    ),
  }

fn hash_in(tables: Tables, name: Bytes) -> String / {abort.raise} =
  match tables.hashes.get(name) { Some(h) -> String::of_bytes_lossy(hex(h)), None -> "" }

fn references_in(tables: Tables, name: Bytes) -> List<String> =
  match tables.references.get(name) {
    Some(names) -> names.map(|n: Bytes| String::of_bytes_lossy(n)),
    None -> [],
  }

fn function(
  files: List<SourceFile>,
  tables: Tables,
  definition: DefinitionInfo,
) -> Definition / {abort.raise} =
  {
    name: String::of_bytes_lossy(definition.name),
    module: String::of_bytes_lossy(definition.module),
    simple_name: String::of_bytes_lossy(definition.simple_name),
    kind: Function,
    path: file_at(files, definition.at.module).path,
    span: { start: definition.at.span.start, end: definition.at.span.end },
    signature: String::of_bytes_lossy(scheme_text(definition.scheme)),
    row: String::of_bytes_lossy(effects_text({ listed: definition.effects, variable: None })),
    hash: hash_in(tables, definition.name),
    references: references_in(tables, definition.name),
  }

fn declaration(
  tables: Tables,
  path: String,
  module: Bytes,
  kind: DefinitionKind,
  declared: parsing::Identifier,
) -> Definition / {abort.raise} = {
  let name = qualify(module, declared.name);
  {
    name: String::of_bytes_lossy(name),
    module: String::of_bytes_lossy(module),
    simple_name: String::of_bytes_lossy(declared.name),
    kind: kind,
    path: path,
    span: { start: declared.span.start, end: declared.span.end },
    signature: "",
    row: "",
    hash: hash_in(tables, name),
    references: references_in(tables, name),
  }
}

fn declared(
  tables: Tables,
  path: String,
  parsed: ParsedModule,
  found: List<Definition>,
) -> List<Definition> / {abort.raise} =
  parsed.module.items.fold(found, |accumulator: List<Definition>, item: Item|
    match item {
      TypeItem(d) -> accumulator.push(declaration(tables, path, parsed.name, Type, d.name)),
      EffectItem(d) -> accumulator.push(declaration(tables, path, parsed.name, Effect, d.name)),
      _ -> accumulator,
    })

fn definitions_of(
  files: List<SourceFile>,
  own: List<String>,
  analysis: Analysis,
) -> List<Definition> / {abort.raise} = {
  let tables = tables_of(analysis);
  let all = range(0, analysis.modules.len()).fold(
    analysis.checked.definitions.map(|definition: DefinitionInfo|
      function(files, tables, definition)),
    |found: List<Definition>, i: Int|
      match analysis.modules.at(i) {
        Some(parsed) -> declared(tables, file_at(files, i).path, parsed, found),
        None -> found,
      },
  );
  let by_name = all.fold(Map::new(), |m: Map<String, Definition>, d: Definition|
    m.insert(d.name, d));
  let budget = all.fold(all.len() + 1, |n: Int, d: Definition| n + d.references.len());
  let reachable_names = iterate(
    {
      todo: all.filter(|d: Definition| d.kind == Function || own.contains(d.module)).map(
        |d: Definition| d.name,
      ),
      seen: Map::new(),
    },
    budget,
    |s: { todo: List<String>, seen: Map<String, Bool> }|
      match s.todo {
        [] -> Stop(s.seen),
        [name, ..rest] -> if s.seen.contains(name) { Continue({ ..s, todo: rest }) } else {
          let refs = match by_name.get(name) { Some(d) -> d.references, None -> [] };
          Continue({ todo: rest.concat(refs), seen: s.seen.insert(name, true) })
        },
      },
  );
  all.filter(|d: Definition| reachable_names.contains(d.name))
}

pub fn checked(
  sources: List<Source>,
  limits: Limits,
) -> CheckResult / {checker.fail, Shipped, abort.raise} = {
  let own = validate_sources(sources, limits);
  let returned = load::analyse_in_memory(own, Map::new());
  match returned.out {
    Rejected(diagnostics) ->
      {
        ok: false,
        diagnostics: diagnostics.map(|diagnostic: tables::Diagnostic|
          diagnostic_of(returned.files, diagnostic)),
        definitions: [],
      },
    Analysed(analysis) ->
      {
        ok: true,
        diagnostics: analysis.warnings.map(|diagnostic: tables::Diagnostic|
          diagnostic_of(returned.files, diagnostic)),
        definitions: definitions_of(returned.files, own.map(|f: SourceFile| f.name), analysis),
      },
  }
}

pub fn check(
  sources: List<Source>,
  limits: Limits,
) -> Result<CheckResult, InputError> / {Shipped, abort.raise} = try { checked(sources, limits) }

pub fn check_alone(
  sources: List<Source>,
  limits: Limits,
) -> Result<CheckResult, InputError> / {abort.raise} =
  handle {
    check(sources, limits)
  } with {
    shipped.names() -> [],
    shipped.module(name) -> None,
    shipped.report_view_used(view, pulled) -> (),
  }

pub fn definition(program: CheckResult, name: String) -> Option<Definition> =
  program.definitions.fold(None, |found: Option<Definition>, d: Definition|
    match found { Some(_) -> found, None -> if d.name == name { Some(d) } else { None } })

pub fn hashes(program: CheckResult) -> Map<String, String> =
  program.definitions.fold(Map::new(), |hashes_by_name: Map<String, String>, d: Definition|
    hashes_by_name.insert(d.name, d.hash))

pub fn callers(program: CheckResult, name: String) -> List<String> =
  program.definitions.fold([], |callers: List<String>, d: Definition|
    if d.references.fold(false, |any: Bool, r: String| any || r == name) { callers.push(d.name) }
    else { callers }).sort(
  )

pub fn changed(before: CheckResult, after: CheckResult) -> List<String> = {
  let was = hashes(before);
  let now = hashes(after);
  now.fold(
    was.fold([], |changed_names: List<String>, name: String, hash: String|
      if now.get(name) == Some(hash) { changed_names } else { changed_names.push(name) }),
    |changed_names: List<String>, name: String, _: String|
      if was.contains(name) { changed_names } else { changed_names.push(name) },
  ).sort(
  )
}

fn large_limits() -> Limits = { files: 16, bytes: 65536 }

fn alone(sources: List<Source>) -> CheckResult / {abort.raise} =
  match check_alone(sources, large_limits()) {
    Ok(program) -> program,
    Err(_) ->
      panic("the test sources exceed the file or byte limits, or a path does not name a module"),
  }

fn shop() -> List<Source> =
  [
    {
      path: "shop/prices.ply",
      text: b"pub type Price = | Cents(Int)\n\npub fn cents(p: Price) -> Int = match p { Cents(n) -> n }\n\npub fn total(ps: List<Price>) -> Int = ps.fold(0, |sum: Int, p: Price| sum + cents(p))\n",
    },
    {
      path: "main.ply",
      text: b"import shop.prices (Price, Cents, total)\n\nfn basket() -> List<Price> = [Cents(250), Cents(199)]\n\nfn main() -> Int = total(basket())\n",
    },
  ]

fn names_of(program: CheckResult) -> List<String> = program.definitions.map(|d: Definition| d.name)

fn found(program: CheckResult, name: String) -> Definition / {abort.raise} =
  match definition(program, name) { Some(d) -> d, None -> panic("no definition is named " ++ name) }

fn reachable_from_modules(
  program: CheckResult,
  modules: List<String>,
) -> { listed: List<String>, reachable: List<String> } / {abort.raise} = {
  let own = |name: String| modules.any(|m: String| name.starts_with(m ++ "."));
  let names = names_of(program);
  let named = program.definitions.fold(names.len() + 1, |n: Int, d: Definition|
    n + d.references.len());
  let reachable_names = iterate(
    { todo: names.filter(own), seen: [] },
    named,
    |s: { todo: List<String>, seen: List<String> }|
      match s.todo {
        [] -> Stop(s.seen),
        [name, ..rest] -> if s.seen.contains(name) { Continue({ ..s, todo: rest }) } else {
          let refs = match definition(program, name) { Some(d) -> d.references, None -> [] };
          Continue({ todo: rest.concat(refs), seen: s.seen.push(name) })
        },
      },
  );
  {
    listed: names.filter(|n: String| !own(n)).sort(),
    reachable: reachable_names.filter(|n: String| !own(n)).sort(),
  }
}

test "a program that checks returns each definition's kind, place, type, effects, hash and references" {
  let returned = alone(shop());
  assert(returned.ok);
  assert_eq(returned.diagnostics, []);
  assert_eq(names_of(returned).filter(|n: String| !n.starts_with("std.")).sort(), [
    "main.basket",
    "main.main",
    "shop.prices.Price",
    "shop.prices.cents",
    "shop.prices.total",
  ]);
  let shipped = reachable_from_modules(returned, ["main", "shop.prices"]);
  assert(shipped.listed.len() > 0);
  assert_eq(shipped.listed, shipped.reachable);
  let total = found(returned, "shop.prices.total");
  assert_eq(total.kind, Function);
  assert_eq(total.module, "shop.prices");
  assert_eq(total.simple_name, "total");
  assert_eq(total.path, "shop/prices.ply");
  assert_eq(total.signature, "(List<shop.prices.Price>) -> Int");
  assert_eq(total.row, "{}");
  assert_eq(total.hash.len(), 64);
  assert_eq(total.references.filter(|r: String| !r.starts_with("std.")).sort(), [
    "shop.prices.Price",
    "shop.prices.cents",
  ]);
  assert(
    total.references.any(|r: String|
      r.starts_with("std.")
        && (match definition(returned, r) {
          Some(d) -> d.simple_name == "List::fold",
          None -> false,
        })),
  );
  assert_eq(found(returned, "shop.prices.Price").kind, Type);
  assert_eq(callers(returned, "shop.prices.total"), ["main.main"]);
  assert_eq(callers(returned, "shop.prices.cents"), ["shop.prices.total"])
}

test "a program that does not check returns its diagnostics as values, placed in the source they are about" {
  let returned = alone([
    { path: "m.ply", text: b"fn one() -> Int = 1\n\nfn two() -> Int = \"two\"\n" },
  ]);
  assert(!returned.ok);
  assert_eq(returned.definitions, []);
  match returned.diagnostics.at(0) {
    None -> panic("a type error is reported"),
    Some(d) -> {
      assert_eq(d.code, "E0201");
      assert_eq(d.severity, Error);
      match syntax::primary(d) {
        None -> panic("a diagnostic is placed"),
        Some(label) -> {
          assert_eq(label.path, "m.ply");
          assert_eq(label.place, { line: 3, column: 19 });
          assert_eq(label.span, { start: 39, end: 44 })
        },
      }
    },
  }
}

test "a syntax error returns the parser's diagnostic, and a warning does not make the check fail" {
  let broken = alone([{ path: "m.ply", text: b"fn f( = 1\n" }]);
  assert_eq(broken.diagnostics.map(|d: Diagnostic| d.code), ["E0001"]);
  let unused = alone([{ path: "m.ply", text: b"type Shape = | Dot\n\nfn main() -> Int = 1\n" }]);
  assert(unused.ok);
  assert_eq(unused.diagnostics.map(|d: Diagnostic| d.severity), [Warning])
}

test "sources past a limit, and a path that names no module, are rejected before anything is read" {
  let two: List<Source> = [
    { path: "a.ply", text: b"fn a() -> Int = 1\n" },
    { path: "b.ply", text: b"fn b() -> Int = 2\n" },
  ];
  assert_eq(check_alone(two, { files: 1, bytes: 1000 }), Err(TooManyFiles(2)));
  assert_eq(check_alone(two, { files: 2, bytes: 20 }), Err(TooManyBytes(36)));
  assert(match check_alone([{ path: "a-b.ply", text: b"" }], large_limits()) {
    Err(NotAModule(path, _)) -> path == "a-b.ply",
    _ -> false,
  })
}

test "`check_alone` reports E0106 for an import of a standard library module, because it includes no standard library" {
  let returned = alone([
    { path: "m.ply", text: b"import std.list\n\nfn main() -> Int = [1].at_or(0, 2)\n" },
  ]);
  assert_eq(returned.diagnostics.map(|d: Diagnostic| d.code), ["E0106"])
}

test "renaming, reformatting and adding a comment leave every definition's hash unchanged, and editing a definition changes its hash and those of the definitions that use it" {
  let before = alone(shop());
  let renamed = alone(
    shop().map(|source: Source|
      {
        path: source.path,
        text: source.text.replace(b"sum", b"so_far").replace(b"ps", b"prices"),
      }),
  );
  assert_eq(changed(before, renamed), []);
  let reformatted = alone(
    shop().map(|source: Source|
      { path: source.path, text: b"// a note\n".concat(syntax::formatted(source.text)) }),
  );
  assert_eq(changed(before, reformatted), []);
  let edited = alone(
    shop().map(|source: Source|
      { path: source.path, text: source.text.replace(b"Cents(n) -> n", b"Cents(n) -> n + 0") }),
  );
  assert_eq(changed(before, edited), ["main.main", "shop.prices.cents", "shop.prices.total"])
}

fn checked_module(source: Bytes) -> CheckResult / {abort.raise} =
  alone([{ path: "m.ply", text: source }])

fn rebound(source: Bytes, from: String, to: Bytes) -> Bytes / {abort.raise} =
  match syntax::apply_edits(
      source,
      syntax::walk(syntax::parse(source).tree).fold([], |edits: List<Edit>, node: syntax::Node|
        match ((syntax::kind(node), syntax::name(node))) {
          (syntax::Binding, Some(identifier)) -> if identifier.text == from {
            edits.push({ path: "", span: identifier.span, text: to })
          } else { edits },
          (syntax::Name, Some(identifier)) -> if identifier.text == from {
            edits.push({ path: "", span: identifier.span, text: to })
          } else { edits },
          _ -> edits,
        }),
    ) {
    Some(out) -> out,
    None -> source,
  }

test "formatting a sample program does not change any definition's hash" {
  gen::check(syntax::samples(), |s: Sample| {
    changed(checked_module(sample_source(s)), checked_module(syntax::formatted(sample_source(s))))
      == []
  })
}

test "renaming a local binder moves no definition's hash" {
  gen::check(syntax::samples(), |s: Sample| {
    changed(
        checked_module(sample_source(s)),
        checked_module(rebound(sample_source(s), "y", b"held")),
      )
      == []
  })
}

fn reading_under(set: Bytes) -> Bytes =
  Bytes::concat_all([
    b"effect store {\n  read all[r]() -> List<Int>\n  write save[r](rows: List<Int>) -> Unit\n}\n\n",
    set,
    b"\n\nfn list_orders() -> Int / {Web} = store.all[orders]().len()\n\nfn health() -> Int = 200\n\ntest \"orders are listed\" {\n  handle { assert_eq(list_orders(), 0) } with { store.all[orders]() -> [] }\n}\n\ntest \"health is 200\" { assert_eq(health(), 200) }\n",
  ])

fn narrow_set() -> Bytes = b"effect set Web = {store.read[orders], store.write[audit]}"

test "an effect set's spelling moves no hash: its name, its members' order or repeats, a set nothing uses, or its expansion" {
  let before = checked_module(reading_under(narrow_set()));
  [
    reading_under(b"effect set Surface = {store.read[orders], store.write[audit]}").replace(
      b"/ {Web}",
      b"/ {Surface}",
    ),
    reading_under(b"effect set Web = {store.write[audit], store.read[orders]}"),
    reading_under(b"effect set Web = {store.read[orders], store.write[audit], store.read[orders]}"),
    reading_under(narrow_set().concat(b"\neffect set Unused = {store.read[inventory]}")),
    reading_under(b"").replace(b"/ {Web}", b"/ {store.write[audit], store.read[orders]}"),
  ].fold((), |u: Unit, after: Bytes|
    assert(changed(before, checked_module(after)) == [], Some(String::of_bytes_lossy(after))))
}

test "widening an effect set moves exactly what reaches it" {
  assert_eq(
    changed(
      checked_module(reading_under(narrow_set())),
      checked_module(
        reading_under(
          b"effect set Web = {store.read[orders], store.write[audit], store.read[inventory]}",
        ),
      ),
    ),
    ["m.list_orders"],
  )
}

test "a `where` constraint changes a function's hash, but reordering constraints or renaming the type parameter does not" {
  let hashed = |source: Bytes| hashes(checked_module(source));
  assert(
    hashed(b"fn f<a>(x: a) -> Int = 1\n")
      != hashed(b"fn f<a>(x: a) -> Int where derivable(ord, a) = 1\n"),
  );
  assert_eq(
    hashed(b"fn f<a>(x: a) -> Int where derivable(ord, a), derivable(eq, a) = 1\n"),
    hashed(b"fn f<a>(x: a) -> Int where derivable(eq, a), derivable(ord, a) = 1\n"),
  );
  assert_eq(
    hashed(b"fn f<a>(x: a) -> Int where derivable(ord, a) = 1\n"),
    hashed(b"fn f<t>(x: t) -> Int where derivable(ord, t) = 1\n"),
  )
}

test "a type's `where` is in the hash of what names the type, and its spelling is not" {
  let hashed = |source: Bytes| hashes(checked_module(source));
  let uses = b"pub fn make<a>(s: keep (a, a) -> Bool) -> Game<a> = { same: s }\n";
  let constrained = hashed(
    b"pub type Game<a> where derivable(eq, a) = { same: (a, a) -> Bool }\n".concat(uses),
  );
  assert(constrained != hashed(b"pub type Game<a> = { same: (a, a) -> Bool }\n".concat(uses)));
  assert_eq(
    constrained,
    hashed(
      b"pub type Game<b> where derivable(eq, b) = { same: (b, b) -> Bool }\npub fn make<b>(s: keep (b, b) -> Bool) -> Game<b> = { same: s }\n",
    ),
  )
}
