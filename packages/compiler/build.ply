//! The builder: the compiler's own program, which makes a program's front end and C out of that
//! program's sources for `ply bootstrap` to link against the runtime the builder runs on. It reads
//! the program below the root it is handed and hashes it. A program is the definition it enters and
//! all that reaches, so where that hashes as a program this builder already built, what it made then
//! is the program, whatever else of the text moved. Otherwise it checks the program seeded with the
//! rows a build of it by this front end kept, emits its unit, keeping the emitter's answers between
//! builds under this emitter's own identity, holds the value of each `const` definition, keeps the
//! C's parts in the toolchain's cache, and writes the front end and their manifest.

import compiler.cc
import compiler.cc (compilers, memory, toolchain, Memory, Live)
import compiler.load (Checked, LoadedAnalysis, SourceFile, answers_of, assembled, entry_hash_of,
                      every_root, prepared)
import compiler.front.rows (BakedRow)
import compiler.front.published (entry_front)
import compiler.store.hash.forms (HashOutput, TheFn, reach)
import compiler.check.resolve.tables (Diag, Label)
import compiler.unit (Baked, Emission, PlaceTally, shipped, shipped_runtime, answers_store,
                      baked_key, const_budget, const_room, emitted, emitter_identity, held,
                      program_key, programs_kept, file_kept, stored_root, keep_file)
import compiler.emit.abi (Runtime)
import compiler.store.kept (Record, kept_records, with_kept)
import compiler.emit.keys (RootKey, Named, Stored, RootName, root_name)
import std.bytes (u64_le)
import std.fs (fs)
import std.list
import std.process (process)
import std.random (entropy)
import std.time (time)
import std.path (below_root)

fn usage() -> String =
  "the builder takes ROOT ENTRY FRONT SOURCES MEMO KEPT PHASES: the program's package at the absolute path ROOT, the definition it enters, where its front end and the manifest of its C, which is kept in the toolchain's cache, are written, where what its modules answered is kept between builds (nothing kept: an empty MEMO), `kept` to keep the emitter's answers in the toolchain's cache (else `fresh`), and `phases` to say what each step took (else `quiet`)"

/// The line and column of byte `at` of `text`, from one.
fn line_col(text: Bytes, at: Int) -> String / {abort.raise} = {
  let before = text.slice(0, if at > text.len() { text.len() } else { at });
  let lines = before.split(b"\n");
  lines.len().to_string() ++ ":"
    ++ Int::to_string(match lines.at(lines.len() - 1) { Some(l) -> l.len() + 1, None -> 1 })
}

/// Where a diagnostic points: its first primary label's file, line and column, when it has one.
fn place(diag: Diag, files: List<SourceFile>) -> String / {abort.raise} =
  match diag.labels.filter(|label: Label| label.primary) {
    [label, ..] -> match files.at(label.module) {
      Some(f) -> f.path ++ ":" ++ line_col(f.text, label.start) ++ ": ",
      None -> "",
    },
    [] -> "",
  }

fn told(diags: List<Diag>, files: List<SourceFile>) -> Unit / {process.err[proc], abort.raise} =
  diags.fold((), |_: Unit, diag: Diag|
    process.err[proc](
      diag.notes_text.fold(
        place(diag, files) ++ String::of_bytes_lossy(diag.code) ++ ": "
          ++ String::of_bytes_lossy(diag.message),
        |told: String, note: Bytes| told ++ "\n  = " ++ String::of_bytes_lossy(note),
      ),
    ))

fn texts(files: List<SourceFile>) -> List<Bytes> = files.map(|f: SourceFile| f.text)

fn ms(from: Int, to: Int) -> String = Int::to_string(to - from) ++ "ms"

fn mb(bytes: Int) -> String = Int::to_string(bytes / 1000000) ++ "MB"

/// What a build telling its phases says, after each place, of what its heap holds.
fn memory_said(m: Memory) -> String = mb(m.live) ++ " live, " ++ mb(m.held) ++ " held"

/// What a build telling its phases says of the live objects of `entry`'s build once its unit is
/// emitted and before its C is held: the twenty sorts that take the most bytes.
fn census_said(entry: String, live: List<Live>) -> List<String> =
  live.take(20).map(|l: Live|
    "phases: " ++ entry ++ " live once emitted: " ++ l.what ++ ": " ++ Int::to_string(l.objects)
      ++ " objects, "
      ++ mb(l.bytes))

/// What a build telling its phases says of place `r.place` of `entry`'s unit as it ends.
pub fn place_said(entry: String, r: PlaceTally) -> String =
  "phases: " ++ entry ++ " place " ++ Int::to_string(r.place) ++ ": " ++ Int::to_string(r.roots)
    ++ " roots, "
    ++ Int::to_string(r.kept)
    ++ " kept, "
    ++ Int::to_string(r.asked)
    ++ " asked, "
    ++ Int::to_string(r.refused)
    ++ " refused, "
    ++ Int::to_string(r.steps)
    ++ " steps, "
    ++ ms(r.began, r.ended)

/// What a build made: the front end the runtime reads and the manifest of the unit's C, whose parts
/// the toolchain's cache keeps.
type Made = { front: Bytes, sources: Bytes }

/// `made` as one value kept between builds: the front end's length, the front end, the manifest.
fn packed(made: Made) -> Bytes =
  Bytes::concat_all([u64_le(made.front.len()), made.front, made.sources])

/// What `packed` kept, while the cache still holds every part of its C.
fn unpacked(bytes: Bytes) -> Option<Made> / {toolchain.read, abort.raise} =
  match bytes.u64_at(0) {
    Some(n) -> if 8 + n > bytes.len() { None } else {
      let made = { front: bytes.slice(8, 8 + n), sources: bytes.slice(8 + n, bytes.len()) };
      match cc::manifested(made.sources) {
        Some(sources) -> if cc::holds_sources(sources) { Some(made) } else { None },
        None -> None,
      }
    },
    None -> None,
  }

/// What a build reaches: the program's sources and the stores below the filesystem's root, the
/// runtime it runs on, which it emits for, the compilers and their cache, and its own streams.
pub effect set Builds = {shipped.answer, shipped.names, shipped.module, shipped.digests, shipped.reached, shipped.definitions, shipped.stamps, shipped.runtime, shipped.values, shipped.entered, fs.list_dir[abs], fs.kind[abs], fs.read_file[abs], fs.read[abs], fs.write[abs], compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write, memory.read, entropy.next, time.now_ms, time.elapsed_ms, process.err[proc], abort.raise}

/// `made` written where its front end and its manifest go: 0 when both were, 2 when one could not be.
fn written(
  made: Made,
  front: String,
  sources: String,
) -> Int / {fs.write[abs], process.err[proc], abort.raise} =
  if fs.write_file[abs](below_root(front), made.front)
      && fs.write_file[abs](below_root(sources), made.sources) { 0 } else {
    process.err[proc](
      "what was built could not be written to `" ++ front ++ "` and `" ++ sources ++ "`",
    );
    2
  }

/// The program at `root` built: 0 when its front end and its C's manifest were written, 1 when the program
/// was refused, and 2 when what was built could not be written. `memo` is where what its modules
/// answered is kept between builds (none where it is empty).
pub fn built(
  root: String,
  entry: String,
  front: String,
  sources: String,
  memo: String,
  kept: Bool,
  phases: Bool,
) -> Int / {Builds} = {
  let started = time.elapsed_ms();
  let definitions = shipped.definitions();
  let cache = toolchain.cache();
  let programs = below_root(cache ++ "/" ++ programs_kept());
  match prepared[abs](below_root(root)) {
    Err(u) -> {
      told(u.diags, u.files);
      1
    },
    Ok(p) -> {
      let store = if memo == "" { "" } else { below_root(memo) };
      // A program is the definition it enters and all that reaches, so what was built under its
      // entry's hash is the program.
      let key = match entry_hash_of[abs, abs](p, store, Bytes::of_string(entry)) {
        Some(h) -> Some(program_key(h, shipped_runtime(), definitions)),
        None -> None,
      };
      let reading = time.elapsed_ms();
      let had = match key {
        Some(k) -> match file_kept[abs](programs, k) { Some(b) -> unpacked(b), None -> None },
        None -> None,
      };
      match had {
        Some(made) -> {
          let wrote = written(made, front, sources);
          if phases {
            process.err[proc](
              "phases: " ++ entry ++ " answered " ++ ms(started, reading)
                ++ ", and enters what a program already built does",
            )
          };
          wrote
        },
        None -> match assembled[abs](p, answers_of[abs, abs](p, store), false) {
          Err(u) -> {
            told(u.diags, u.files);
            1
          },
          Ok(checked) -> match entry_front(checked.front.dump, Bytes::of_string(entry)) {
            None -> {
              process.err[proc]("the program defines no `" ++ entry ++ "` to enter");
              1
            },
            Some(carried) -> {
              let f = checked.front;
              let checking = time.elapsed_ms();
              let offered = built_roots(checked.front, checked.hashes, Bytes::of_string(entry));
              let places = |unit: String|
                if phases {
                  Some({
                    now: || time.elapsed_ms(),
                    told: |r: PlaceTally|
                      process.err[proc](place_said(unit, r) ++ ", " ++ memory_said(memory.heap())),
                  })
                } else { None };
              let made_unit = if kept {
                with_kept[abs, ans](
                  answers_store(
                    below_root(cache ++ "/bodies"),
                    shipped_runtime(),
                    emitter_identity(definitions),
                  ),
                  ||
                    unit_made(
                      checked,
                      Bytes::of_string(entry),
                      offered,
                      places(entry),
                      places(entry ++ "'s constants"),
                      |k: Bytes| kept_records.get[ans](k),
                      |rs: List<Record>| kept_records.put[ans](rs),
                    ),
                )
              } else {
                unit_made(
                  checked,
                  Bytes::of_string(entry),
                  offered,
                  places(entry),
                  places(entry ++ "'s constants"),
                  |_: Bytes| None,
                  |_: List<Record>| (),
                )
              };
              match made_unit {
                Err(s) -> stopped(s, f.files),
                Ok(m) -> {
                  if phases {
                    census_said(entry, memory.census()).fold((), |_: Unit, line: String|
                      process.err[proc](line))
                  };
                  match held(f.dump, offered, m.emission) {
                    Err(diags) -> stopped(Unheld(diags), f.files),
                    Ok(unit) -> match cc::kept(cc::split(unit)) {
                      Err(why) -> stopped(Unbuilt(why), f.files),
                      Ok(kept_sources) -> {
                        let made = { front: carried, sources: cc::manifest(kept_sources) };
                        let wrote = written(made, front, sources);
                        match key {
                          Some(k) -> if wrote == 0 { keep_file[abs](programs, k, packed(made)) },
                          None -> (),
                        };
                        if phases {
                          process.err[proc](
                            "phases: " ++ entry ++ " answered " ++ ms(started, reading)
                              ++ ", checked "
                              ++ ms(reading, checking)
                              ++ ", constants held "
                              ++ ms(checking, m.valued)
                              ++ ", emitted and written "
                              ++ ms(m.valued, time.elapsed_ms()),
                          )
                        };
                        wrote
                      },
                    },
                  }
                },
              }
            },
          },
        },
      }
    },
  }
}

/// The roots a build of `entry` offers: each definition the definition it enters reaches, or a `const`
/// definition does, whose value it holds in place of the body. A built program never runs the
/// rest: no test, law or clause, and no definition only those reach.
pub fn built_roots(
  front: LoadedAnalysis,
  hashes: HashOutput,
  entry: Bytes,
) -> List<RootKey> / {abort.raise} = {
  let starts = front.dump.baked.map(|b: BakedRow| b.name).push(entry);
  reached_roots(every_root(front), reach(hashes, starts.map(|n: Bytes| TheFn(n))).fns, starts)
}

/// The definitions among `every` that `reached` holds or `starts` names.
fn reached_roots(
  every: List<RootKey>,
  reached: Map<Bytes, Bool>,
  starts: List<Bytes>,
) -> List<RootKey> =
  every.filter(|k: RootKey|
    match k { Named(n) -> reached.contains(n) || starts.contains(n), _ -> false })

test "a build offers what its entry and its constants reach, never a test, law or clause" {
  let every = [
    Named(b"m.main"),
    Named(b"m.helper"),
    Named(b"m.unused"),
    Named(b"m.version"),
    Stored(Named(b"m.version")),
  ];
  assert_eq(
    reached_roots(every, Map::new().insert(b"m.helper", true), [b"m.version", b"m.main"]),
    [Named(b"m.main"), Named(b"m.helper"), Named(b"m.version")],
  )
}

/// Why a build stopped before its C was written: the unit it held was refused, or its C did not build.
type Stop = | Unheld(List<Diag>) | Unbuilt(String)

/// What a build stopped by `s` says, and the code it exits with: 1 for a refused unit, 2 for C that
/// did not build.
fn stopped(s: Stop, files: List<SourceFile>) -> Int / {process.err[proc], abort.raise} =
  match s {
    Unheld(diags) -> {
      told(diags, files);
      1
    },
    Unbuilt(why) -> {
      process.err[proc](why);
      2
    },
  }

/// The unit over `offered`, entered at `entry` alone, the emitter's answers and the values of `const`
/// definitions read through `read` and kept through `keep`, each place it walks told to `places` and
/// each place the unit the values are entered on walks to `constant_places`; beside when the values
/// were held. Stops where the unit the values are entered on stops.
fn unit_made<| e>(
  checked: Checked,
  entry: Bytes,
  offered: List<RootKey>,
  places: Option<{ now: () -> Int / e, told: (PlaceTally) -> Unit / e }>,
  constant_places: Option<{ now: () -> Int / e, told: (PlaceTally) -> Unit / e }>,
  read: (Bytes) -> Option<Bytes> / e,
  keep: (List<Record>) -> Unit / e,
) -> Result<{ emission: Result<Emission, Bytes>, valued: Int }, Stop> / {shipped.runtime, shipped.values, compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write, time.elapsed_ms, abort.raise | e} = {
  let f = checked.front;
  match constants(checked, offered, read, keep, constant_places) {
    Err(s) -> Err(s),
    Ok(values) -> {
      let valued = time.elapsed_ms();
      Ok({
        emission: emitted(
          shipped_runtime(),
          f.dump,
          texts(f.files),
          f.inputs,
          offered,
          read,
          keep,
          values,
          places,
          None,
          None,
          Some([Named(entry)]),
        ),
        valued: valued,
      })
    },
  }
}

/// The value of each `const` definition among `offered`, which the unit holds in place of its body:
/// read back through `read` where a build or a check kept it under the hash of all the definition
/// reaches, and else entered here and kept through `keep` beside the emitter's answers. One that
/// raises, runs past `const_budget` or answers past `const_room` is left to its body, which answers
/// the same in every process that reaches it. Each place the unit they are entered on walks is told
/// to `places`; stops where that unit is refused or its C does not build.
fn constants<| e>(
  checked: Checked,
  offered: List<RootKey>,
  read: (Bytes) -> Option<Bytes> / e,
  keep: (List<Record>) -> Unit / e,
  places: Option<{ now: () -> Int / e, told: (PlaceTally) -> Unit / e }>,
) -> Result<List<Baked>, Stop> / {shipped.runtime, shipped.values, compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write, abort.raise | e} = {
  let runtime = shipped_runtime();
  let wanted = offered.fold(Map::new(), |acc: Map<RootName, Bool>, k: RootKey|
    acc.insert(root_name(k), true));
  let rows = checked.front.dump.baked.filter(|row: BakedRow|
    wanted.contains(root_name(Named(row.name))));
  let had = rows.map(|row: BakedRow| read(baked_key(row.hash)));
  let open = range(0, rows.len()).filter(|i: Int| had.get(i) == None);
  let names = open.map(|i: Int| rows.get(i).name);
  match if names.len() == 0 { Ok([]) }
    else { entered(checked, runtime, names, offered, read, keep, places) } {
    Err(s) -> Err(s),
    Ok(found) -> Ok(baked_from(rows, had, open, names, found, keep)),
  }
}

/// The values `rows` give their `const` definitions: each `had` read back, else what entering the
/// definitions `names` at `open` among them `found`, each kept through `keep` where it fits
/// `const_room`.
fn baked_from<| e>(
  rows: List<BakedRow>,
  had: List<Option<Bytes>>,
  open: List<Int>,
  names: List<Bytes>,
  found: List<Option<Bytes>>,
  keep: (List<Record>) -> Unit / e,
) -> List<Baked> / {abort.raise | e} = {
  let fresh = range(0, names.len()).fold(
    [],
    |acc: List<{ row: BakedRow, bytes: Bytes }>, k: Int|
      match found.at(k) {
        Some(Some(bytes)) -> if bytes.len() > const_room() { acc }
        else { acc.push({ row: rows.get(open.get(k)), bytes: bytes }) },
        _ -> acc,
      },
  );
  if fresh.len() > 0 {
    keep(
      fresh.map(|x: { row: BakedRow, bytes: Bytes }|
        { key: baked_key(x.row.hash), bytes: x.bytes }),
    )
  };
  let held = fresh.fold(Map::new(), |acc: Map<Bytes, Bytes>, x: { row: BakedRow, bytes: Bytes }|
    acc.insert(x.row.name, x.bytes));
  range(0, rows.len()).fold([], |acc: List<Baked>, i: Int| {
    let name = rows.get(i).name;
    match match had.get(i) { Some(bytes) -> Some(bytes), None -> held.get(name) } {
      Some(bytes) -> acc.push({ name: name, bytes: bytes }),
      None -> acc,
    }
  })
}

/// The encoding of the value each of `names`, `const` definitions, answers through its stored root
/// on a unit of all they reach, compiled here and entered on the runtime the builder runs on: none
/// for one that raised or ran past `const_budget`, and none for any where no C compiler is found.
/// Each place the unit walks is told to `places`; stops where the unit is refused, as `held` refuses
/// one, or its C does not build.
fn entered<| e>(
  checked: Checked,
  runtime: Runtime,
  names: List<Bytes>,
  offered: List<RootKey>,
  read: (Bytes) -> Option<Bytes> / e,
  keep: (List<Record>) -> Unit / e,
  places: Option<{ now: () -> Int / e, told: (PlaceTally) -> Unit / e }>,
) -> Result<List<Option<Bytes>>, Stop> / {shipped.values, compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write, abort.raise | e} = {
  let reached = reach(checked.hashes, names.map(|n: Bytes| TheFn(n))).fns;
  let roots = offered.filter(|k: RootKey|
    match k { Named(d) -> reached.contains(d), _ -> false }).concat(
    names.map(|n: Bytes| Stored(Named(n))),
  );
  let emission = emitted(
    runtime,
    checked.front.dump,
    texts(checked.front.files),
    checked.front.inputs,
    roots,
    read,
    keep,
    [],
    places,
    None,
    None,
    Some(names.map(|n: Bytes| Stored(Named(n)))),
  );
  match held(checked.front.dump, roots, emission) {
    Err(diags) -> Err(Unheld(diags)),
    Ok(unit) -> match ((compilers.found[cc](), toolchain.scratch())) {
      (Some(compiler), Some(work)) -> {
        let t = cc::toolchain_of(compiler, "-O0", true);
        let library = match cc::objects[cc](
            t,
            cc::split(unit),
            ["-fPIC", "-fno-strict-aliasing"],
            work,
          ) {
          Err(why) -> Err(why),
          Ok(objects) -> match cc::shared[cc](t, objects, work) {
            Ok(l) -> Ok(l),
            Err(u) -> Err(cc::why_unbuilt(u)),
          },
        };
        toolchain.cleared(work);
        match library {
          Err(why) -> Err(Unbuilt(why)),
          Ok(l) ->
            Ok(
              shipped.values(
                l,
                names.map(|n: Bytes| String::of_bytes(stored_root(n))),
                const_budget(),
              ),
            ),
        }
      },
      _ -> Ok(names.map(|_: Bytes| None)),
    },
  }
}

pub fn main() -> Unit / {Builds, process.args[proc], process.exit[proc]} =
  match process.args[proc]() {
    [root, entry, front, sources, memo, kept, phases] ->
      process.exit[proc](
        built(root, entry, front, sources, memo, kept == "kept", phases == "phases"),
      ),
    _ -> {
      process.err[proc](usage());
      process.exit[proc](2)
    },
  }
