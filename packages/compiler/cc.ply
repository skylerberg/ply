//! Compiling a unit's C with the host's C compiler, and linking what it compiles: a library a program
//! loads, or an executable a native program is. A unit's C is cut at the marks its emitter writes,
//! and each part compiles to an object kept under the toolchain's cache by what decides it: the
//! compiler, the flags and the part's C. So an edit recompiles the parts it reached, and a unit
//! compiled once links from the cache.

import std.bytes
import std.hash (blake3)
import std.internal.native (native, wait, job_wait, found, parts, in_parts, int_of)
import std.list
import std.string

/// The C compilers by their labels: what each is, and each run of one. What a compiler makes is a
/// function of what it is given, so the effect is a deterministic one.
pub effect compilers {
  /// The compiler the label names, or `None` where it is not installed.
  read found[c]() -> Option<Compiler>
  /// Starts the compiler with `args` in the environment this run has: a job, or why it could not
  /// start.
  write started[c](args: List<String>) -> Result<Int, String>
  /// How a job ended: `None` where the compiler succeeded, else what it said on standard error.
  write finished[c](job: Int) -> Option<Bytes>
}

/// The toolchain's cache, which compiled objects and libraries are kept in between runs, and how
/// many compilers run at once. A path here is below the cache. What the cache holds decides what
/// is compiled again and never what a library is, so the effect is a deterministic one.
pub effect toolchain {
  /// The cache's directory.
  read cache() -> String
  /// The directory `ply run` and `ply check` file what they reuse in, which the toolchain sweeps.
  read reused() -> String
  /// The directory the emitter's answers are kept in between runs, which the toolchain sweeps.
  read bodies() -> String
  /// How many compilers run at once.
  read jobs() -> Int
  /// Whether the cache holds `path`, which records a use of it.
  read holds(path: String) -> Bool
  /// What `path` holds, or `None` where the cache has no such file.
  read held(path: String) -> Option<Bytes>
  /// `bytes` at `path`, written whole.
  write written(path: String, bytes: Bytes) -> Bool
  /// `from` moved to `to`, whole.
  write moved(from: String, to: String) -> Bool
  /// `bytes` added after what `path` holds, which keeps what it may be run as.
  write appended(path: String, bytes: Bytes) -> Bool
  /// A new directory of the asker's own, or `None` where none could be made.
  write scratch() -> Option<String>
  /// `dir` and everything below it, removed.
  write cleared(dir: String) -> Unit
  /// What the runtime's library needs linked after it on this platform.
  read libraries() -> List<String>
  /// The program at `path`, one linked below the cache, run to its end with `args` and the
  /// environment this run has. What it writes to standard error is this run's, as it writes it.
  write ran(path: String, args: List<String>) -> Ran
}

/// The asking program's own heap, which no two runs need read alike.
pub nondet effect memory {
  /// What the heap holds now, read without a walk of its objects.
  read heap() -> Memory
  /// The live objects now, the most bytes first: a walk of every object.
  read census() -> List<Live>
}

/// How a program ran: its exit code, `-1` where a signal ended it or it did not start, and what it
/// wrote to standard output.
pub type Ran = { code: Int, out: Bytes }

/// What a heap holds, in bytes: `live` is the blocks its live objects take, each its size class's
/// whole block, and `held` the pages and larger blocks holding them, whatever is live in them.
pub type Memory = { live: Int, held: Int }

/// A heap's live objects of one sort, how many there are and their bytes past their headers. A
/// record is told by its fields, a constructor by its name, and a block emitted code laid out, whose
/// header names no type, by its bytes past the header; any other object by its kind.
pub type Live = { what: String, objects: Int, bytes: Int }

/// A compiler: its path, what identifies it, which every key it makes holds, and what every
/// invocation of it needs that others do not, as tcc's `-B` names where its support library is.
pub type Compiler = { path: String, identity: Bytes, support: List<String> }

/// The compiler a build runs, and what decides what it makes.
pub type Toolchain = {
  /// The compiler's identity: an upgrade in place keys every object anew.
  identity: Bytes,
  /// What every invocation of this compiler needs that others do not: tcc's `-B`.
  support: List<String>,
  /// The optimisation flag.
  level: String,
  /// Whether emitted code checks what it assumes (`PLY_CHECKED`), as a development build's does.
  checked: Bool,
}

/// A unit's C cut at its marks: the head every part compiles after, then each part by its label.
pub type Parts = { head: Bytes, parts: List<{ label: String, text: Bytes }> }

fn bucket_mark() -> Bytes = b"/* --- bucket "

/// The line a unit's runtime part opens with: everything from it on is one part, which defines the
/// pointers the head declares and what the unit says and lays out for its loader.
pub fn tail_mark() -> Bytes = b"/* --- the runtime, bound at load --- */"

/// Where `mark` begins a line of `text` at or after `from`.
fn line_start(text: Bytes, mark: Bytes, from: Int) -> Option<Int> / {abort.raise} =
  if from == 0 && text.starts_with(mark) { Some(0) } else {
    match text.index_of_from(b"\n".concat(mark), from) { Some(at) -> Some(at + 1), None -> None }
  }

/// `text` cut into its head and its parts, the largest first: each bucket from its mark to the
/// next, labelled by its hex id, and the runtime from its mark, labelled `runtime`. A compile starts
/// the parts in this order and waits for the oldest it started, so the long ones run beside one
/// another and hold no short one's place. A text with no marks is all head and an empty runtime
/// part.
pub fn split(text: Bytes) -> Parts / {abort.raise} = {
  let tail_at = match line_start(text, tail_mark(), 0) { Some(at) -> at, None -> text.len() };
  let starts = iterate(
    { from: 0, found: [] },
    text.len() + 1,
    |s: { from: Int, found: List<Int> }|
      match line_start(text, bucket_mark(), s.from) {
        Some(at) -> if at >= tail_at { Stop(s.found) }
        else { Continue({ from: at + bucket_mark().len(), found: s.found.push(at) }) },
        None -> Stop(s.found),
      },
  );
  let buckets = range(0, starts.len()).map(|i: Int| {
    let start = starts.get(i);
    let end = match starts.at(i + 1) { Some(next) -> next, None -> tail_at };
    let at_id = start + bucket_mark().len();
    { label: String::of_bytes(text.slice(at_id, at_id + 2)), text: text.slice(start, end) }
  });
  {
    head: text.slice(0, match starts.at(0) { Some(first) -> first, None -> tail_at }),
    parts: buckets.push({ label: "runtime", text: text.slice(tail_at, text.len()) }).sort_by(
      |a: { label: String, text: Bytes }, b: { label: String, text: Bytes }|
        a.text.len() > b.text.len(),
    ),
  }
}

fn key_of(t: Toolchain, flags: List<String>, pieces: List<Bytes>) -> String / {abort.raise} =
  blake3(
    Bytes::concat_all(
      [t.identity, b"\x00"].concat(
        compile_flags(t).concat(flags).map(|f: String| Bytes::of_string(f).concat(b"\x00")).concat(
          pieces,
        ),
      ),
    ),
  ).hex_of(
  )

/// What every compile passes after its level, whatever the level asks for: each `Float` operation
/// rounded once, as written, so none is fused with another or reordered.
fn float_flags() -> List<String> = ["-ffp-contract=off", "-fno-fast-math"]

/// What `t` passes every compile before the flags its asker adds: its level, `PLY_CHECKED` defined
/// where it is checked, and [`float_flags`].
pub fn compile_flags(t: Toolchain) -> List<String> =
  [t.level].concat(if t.checked { ["-DPLY_CHECKED"] } else { [] }).concat(float_flags())

/// What `compiler` compiles with at `level`, checked or not.
pub fn toolchain_of(compiler: Compiler, level: String, checked: Bool) -> Toolchain =
  { identity: compiler.identity, support: compiler.support, level: level, checked: checked }

/// Each of `runs` run to its end, `toolchain.jobs()` at a time and each waited for in the order it
/// started: nothing, or what every refusal said, each after the run it refused, in that order, so
/// one build reports every part that does not compile. A compiler that cannot be started stops any
/// more from starting; every job started is waited for, so none outlives the refusal.
fn ran<[c]>(
  runs: List<List<String>>,
) -> Result<Unit, String> / {compilers.write[c], toolchain.read, abort.raise} = {
  let jobs = toolchain.jobs();
  let refusal = |run: { job: Int, args: List<String> }|
    match compilers.finished[c](run.job) {
      None -> None,
      Some(err) ->
        Some(
          "the C compiler refused `" ++ String::join(run.args, " ") ++ "`:\n"
            ++ String::of_bytes_lossy(err),
        ),
    };
  let refused = iterate(
    { next: 0, running: [], refused: [], stopped: false },
    2 * runs.len() + 2,
    |s: { next: Int, running: List<{ job: Int, args: List<String> }>, refused: List<String>, stopped: Bool }|
      if !s.stopped && s.next < runs.len() && s.running.len() < jobs {
        match compilers.started[c](runs.get(s.next)) {
          Ok(job) ->
            Continue({
              ..s,
              next: s.next + 1,
              running: s.running.push({ job: job, args: runs.get(s.next) }),
            }),
          Err(why) ->
            Continue({
              ..s,
              refused: s.refused.push("the C compiler could not be started: " ++ why),
              stopped: true,
            }),
        }
      } else {
        match s.running {
          [] -> Stop(s.refused),
          [first, ..rest] ->
            Continue({
              ..s,
              running: rest,
              refused: match refusal(first) { Some(why) -> s.refused.push(why), None -> s.refused },
            }),
        }
      },
  );
  match refused {
    [] -> Ok(()),
    [why] -> Err(why),
    _ ->
      Err(
        "the C compiler refused " ++ refused.len().to_string() ++ " of " ++ runs.len().to_string()
          ++ " runs:\n\n"
          ++ String::join(refused, "\n\n"),
      ),
  }
}

/// One part of a unit as a compiler is given it: its label, and the digest of its C with the head
/// before it, which decides the object it compiles to.
pub type Source = { label: String, digest: String }

/// Each of `parts`' sources, in order.
pub fn sources_of(parts: Parts) -> List<Source> / {abort.raise} =
  parts.parts.map(|p: { label: String, text: Bytes }|
    { label: p.label, digest: blake3(parts.head.concat(p.text)).hex_of() })

/// Where the cache keeps a source's C.
fn kept_source(s: Source) -> String = "src/" ++ s.digest ++ ".c"

/// `parts`' sources, each one's C written below the cache where it is not there already: what
/// `objects_kept` compiles from, in another process or a later run.
pub fn kept(
  parts: Parts,
) -> Result<List<Source>, String> / {toolchain.read, toolchain.write, abort.raise} = {
  let sources = sources_of(parts);
  let landed = range(0, sources.len()).fold(true, |ok: Bool, i: Int| {
    let path = kept_source(sources.get(i));
    ok
      && (toolchain.holds(path)
      || toolchain.written(path, parts.head.concat(parts.parts.get(i).text)))
  });
  if landed { Ok(sources) } else { Err("a unit's C could not be kept in the toolchain's cache") }
}

/// `sources` as a line each, its label and its digest: what a builder hands the linker of a unit it
/// kept.
pub fn manifest(sources: List<Source>) -> Bytes =
  Bytes::concat_all(sources.map(|s: Source| Bytes::of_string(s.label ++ " " ++ s.digest ++ "\n")))

/// The sources `manifest` wrote, or `None` for anything else.
pub fn manifested(text: Bytes) -> Option<List<Source>> =
  text.split(b"\n").fold(Some([]), |acc: Option<List<Source>>, line: Bytes|
    match acc {
      None -> None,
      Some(xs) -> if line.len() == 0 { acc } else {
        match line.split(b" ") {
          [label, digest] -> if digest.len() == 64 {
            Some(
              xs.push({
                label: String::of_bytes_lossy(label),
                digest: String::of_bytes_lossy(digest),
              }),
            )
          } else { None },
          _ -> None,
        }
      },
    })

/// Whether the cache still holds each of `sources`' C, which records a use of each.
pub fn holds_sources(sources: List<Source>) -> Bool / {toolchain.read} =
  sources.fold(true, |ok: Bool, s: Source| ok && toolchain.holds(kept_source(s)))

fn object_of(t: Toolchain, flags: List<String>, s: Source) -> String / {abort.raise} =
  "obj/" ++ key_of(t, flags, [Bytes::of_string(s.digest)]) ++ ".o"

/// The objects `targets` names, those of `missing` compiled from `inputs`, one each, into place.
fn compiled<[c]>(
  t: Toolchain,
  flags: List<String>,
  targets: List<String>,
  missing: List<Int>,
  inputs: List<String>,
  work: String,
) -> Result<List<String>, String> / {compilers.write[c], toolchain.read, toolchain.write, abort.raise} = {
  let cache = toolchain.cache();
  let object = |k: Int| work ++ "/" ++ missing.get(k).to_string() ++ ".o";
  let runs = range(0, missing.len()).map(|k: Int|
    t.support.concat(compile_flags(t).concat(flags)).concat([
      "-c",
      "-o",
      cache ++ "/" ++ object(k),
      inputs.get(k),
    ]));
  match ran[c](runs) {
    Err(why) -> Err(why),
    Ok(_) -> {
      // Into place by a rename, so a reader never sees half an object, and two builds that made the
      // same one leave one.
      let placed = range(0, missing.len()).fold(true, |ok: Bool, k: Int|
        ok && toolchain.moved(object(k), targets.get(missing.get(k))));
      if placed { Ok(targets.map(|o: String| cache ++ "/" ++ o)) }
      else { Err("an object could not be kept in the toolchain's cache") }
    },
  }
}

/// Each part's object, in order: held by the cache where this compiler already made one of the same
/// C with the same flags, and compiled now where it did not. `work` is a directory of this build's own
/// in the cache.
pub fn objects<[c]>(
  t: Toolchain,
  parts: Parts,
  flags: List<String>,
  work: String,
) -> Result<List<String>, String> / {compilers.write[c], toolchain.read, toolchain.write, abort.raise} = {
  let cache = toolchain.cache();
  let sources = sources_of(parts);
  let targets = sources.map(|s: Source| object_of(t, flags, s));
  let missing = range(0, targets.len()).filter(|i: Int| !toolchain.holds(targets.get(i)));
  let source = |i: Int| work ++ "/" ++ sources.get(i).label ++ ".c";
  let written = missing.fold(true, |ok: Bool, i: Int|
    ok && toolchain.written(source(i), parts.head.concat(parts.parts.get(i).text)));
  if !written { Err("the C to compile could not be written to the toolchain's cache") } else {
    compiled[c](t, flags, targets, missing, missing.map(|i: Int| cache ++ "/" ++ source(i)), work)
  }
}

/// [`objects`] of sources `kept` wrote: a part whose object the cache does not hold compiles from its
/// kept C, and one whose C the cache no longer holds either is refused.
pub fn objects_kept<[c]>(
  t: Toolchain,
  sources: List<Source>,
  flags: List<String>,
  work: String,
) -> Result<List<String>, String> / {compilers.write[c], toolchain.read, toolchain.write, abort.raise} = {
  let cache = toolchain.cache();
  let targets = sources.map(|s: Source| object_of(t, flags, s));
  let missing = range(0, targets.len()).filter(|i: Int| !toolchain.holds(targets.get(i)));
  match missing.find(|i: Int| !toolchain.holds(kept_source(sources.get(i)))) {
    Some(i) ->
      Err(
        "the C of part `" ++ sources.get(i).label ++ "` is no longer kept in the toolchain's cache",
      ),
    None ->
      compiled[c](
        t,
        flags,
        targets,
        missing,
        missing.map(|i: Int| cache ++ "/" ++ kept_source(sources.get(i))),
        work,
      ),
  }
}

/// Why a library was not built: what refused it; that its code is wider than a direct call reaches
/// on the machine it is for, which only a linker that lays out veneers links right; or that tcc wrote
/// exports in which a loader does not find the library's descriptor where it lies.
pub type Unbuilt = | BuildFailed(String) | TooWide | Unexported

/// What a person is told of why a library was not built.
pub fn why_unbuilt(u: Unbuilt) -> String =
  match u {
    BuildFailed(why) -> why,
    TooWide -> "the library's code is wider than a direct call reaches",
    Unexported -> "the library's exports do not name its descriptor where it lies",
  }

/// The library `objects` link into, kept in the cache by what decides it, so a unit linked once opens
/// from the cache: its path. Where the linker is tcc, which lays out no `veneers`, a library a direct
/// call cannot span is refused, and so is one whose exports do not name its descriptor; the cache
/// keeps each refusal.
pub fn shared<[c]>(
  t: Toolchain,
  objects: List<String>,
  work: String,
  veneers: Bool = true,
) -> Result<String, Unbuilt> / {compilers.write[c], toolchain.read, toolchain.write, abort.raise} = {
  let cache = toolchain.cache();
  let library = library_of(t, objects);
  if toolchain.holds(library) { Ok(cache ++ "/" ++ library) }
  else if !veneers && toolchain.holds(too_wide(library)) { Err(TooWide) }
  else if !veneers && toolchain.holds(unexported(library)) { Err(Unexported) } else {
    let made = work ++ "/unit.so";
    match ran[c]([t.support.concat(["-shared", "-o", cache ++ "/" ++ made].concat(objects))]) {
      Err(why) -> Err(BuildFailed(why)),
      Ok(_) -> match toolchain.held(made) {
        None -> Err(BuildFailed("the C compiler linked no library")),
        Some(linked) -> if !veneers && !spanned(linked) {
          let _ = toolchain.written(too_wide(library), b"");
          Err(TooWide)
        } else if !veneers && !exports_descriptor(linked) {
          let _ = toolchain.written(unexported(library), b"");
          Err(Unexported)
        } else if toolchain.written(made, stack_marked(linked)) && toolchain.moved(made, library) {
          Ok(cache ++ "/" ++ library)
        } else { Err(BuildFailed("the library could not be kept in the toolchain's cache")) },
      },
    }
  }
}

/// Where the cache keeps the library `objects`, by their paths in it, link into.
fn library_of(t: Toolchain, objects: List<String>) -> String / {abort.raise} =
  key_of(t, ["-shared", "stack-marked"], objects.map(Bytes::of_string)) ++ ".so"

/// Where the cache keeps word that `library` is too wide to link without veneers.
fn too_wide(library: String) -> String = library ++ ".wide"

/// Where the cache keeps word that tcc's exports of `library` do not name its descriptor.
fn unexported(library: String) -> String = library ++ ".unexported"

/// Whether a loader finds `library`'s descriptor where it lies: for a 64-bit little-endian Mach-O
/// library, `_ply_descriptor` read from its exports trie as dyld reads it, at the address its symbol
/// table gives; any other library as it is linked. tcc's Mach-O writer garbles the trie of a library
/// of many symbols, and dyld then answers a lookup with an address no symbol has.
pub fn exports_descriptor(library: Bytes) -> Bool / {abort.raise} =
  if library.len() < 32 || !library.starts_with(b"\xCF\xFA\xED\xFE") { true } else {
    let name = b"_ply_descriptor";
    let found = range(0, le(library, 16, 4)).fold(
      { at: 32, trie: None, symbol: None },
      |s: { at: Int, trie: Option<Int>, symbol: Option<Int> }, _i: Int|
        if s.at + 8 > library.len() { s } else {
          let cmd = le(library, s.at, 4);
          let next = { ..s, at: s.at + le(library, s.at + 4, 4) };
          // `LC_DYLD_EXPORTS_TRIE`, and `LC_DYLD_INFO`'s export range.
          if cmd == 0x80000033 && s.at + 16 <= library.len() {
            {
              ..next,
              trie: trie_found(library, le(library, s.at + 8, 4), le(library, s.at + 12, 4), name),
            }
          } else if (cmd == 0x22 || cmd == 0x80000022) && s.at + 48 <= library.len() {
            {
              ..next,
              trie: trie_found(library, le(library, s.at + 40, 4), le(library, s.at + 44, 4), name),
            }
          } else if cmd == 0x2 && s.at + 24 <= library.len() {
            { ..next, symbol: symbol_value(library, s.at, name) }
          } else { next }
        },
    );
    found.trie != None && found.trie == found.symbol
  }

/// The address the exports trie of `size` bytes at `from` in `library` gives `name`, read as dyld
/// reads it: down the edges `name` begins with, to a node that exports it at an address; `None` where
/// no edge leads there or the trie does not read.
fn trie_found(library: Bytes, from: Int, size: Int, name: Bytes) -> Option<Int> / {abort.raise} =
  if from + size > library.len() { None } else {
    let trie = library.slice(from, from + size);
    // Each step follows an edge of at least one byte, so `name` runs out within as many steps.
    range(0, name.len() + 1).fold(
      { node: 0, rest: name, found: None, done: false },
      |w: Walk, _k: Int| if w.done { w } else { walked_from(trie, w) },
    ).found
  }

/// A walk down an exports trie: the node it is at, what of the name is left to match, and the address
/// once found.
type Walk = { node: Int, rest: Bytes, found: Option<Int>, done: Bool }

/// `w` one node further: the address where nothing is left to match and the node exports one, else
/// at the child whose edge begins what is left; done where neither is.
fn walked_from(trie: Bytes, w: Walk) -> Walk / {abort.raise} = {
  let stop = { ..w, done: true };
  match uleb(trie, w.node) {
    None -> stop,
    Some(info) -> if w.rest.len() == 0 {
      if info.value == 0 { stop } else {
        match uleb(trie, info.next) {
          // Only a regular export, at an address, is the descriptor.
          Some(flags) -> if flags.value != 0 { stop } else {
            match uleb(trie, flags.next) {
              Some(a) -> { ..stop, found: Some(a.value) },
              None -> stop,
            }
          },
          None -> stop,
        }
      }
    } else {
      let kids = info.next + info.value;
      if kids >= trie.len() { stop } else {
        range(0, trie.at(kids)).fold(
          { at: kids + 1, next: stop },
          |c: { at: Int, next: Walk }, _j: Int|
            match trie.slice(c.at, trie.len()).index_of(b"\x00") {
              None -> { ..c, at: trie.len() },
              Some(end) -> {
                let edge = trie.slice(c.at, c.at + end);
                match uleb(trie, c.at + end + 1) {
                  None -> { ..c, at: trie.len() },
                  Some(child) ->
                    {
                      at: child.next,
                      next: if edge.len() > 0 && c.next.done && w.rest.starts_with(edge) {
                        {
                          node: child.value,
                          rest: w.rest.slice(edge.len(), w.rest.len()),
                          found: None,
                          done: false,
                        }
                      } else { c.next },
                    },
                }
              },
            },
        ).next
      }
    },
  }
}

/// The unsigned LEB128 number at `at` in `b`, and where it ends; `None` past `b`'s end or ten bytes.
fn uleb(b: Bytes, at: Int) -> Option<{ value: Int, next: Int }> / {abort.raise} =
  range(0, 10).fold({ value: 0, shift: 0, at: at, ended: None }, |u: Uleb, _k: Int|
    if u.ended != None || u.at >= b.len() { u } else {
      let byte = b.at(u.at);
      let value = u.value | (byte & 0x7F) << u.shift;
      if byte < 128 {
        { ..u, value: value, at: u.at + 1, ended: Some({ value: value, next: u.at + 1 }) }
      } else { { value: value, shift: u.shift + 7, at: u.at + 1, ended: None } }
    }).ended

type Uleb = { value: Int, shift: Int, at: Int, ended: Option<{ value: Int, next: Int }> }

/// The value the symbol table of the `LC_SYMTAB` command at `at` in `library` gives the external
/// symbol `name` a section defines, where it has one.
fn symbol_value(library: Bytes, at: Int, name: Bytes) -> Option<Int> / {abort.raise} = {
  let symbols = le(library, at + 8, 4);
  let count = le(library, at + 12, 4);
  let strings = le(library, at + 16, 4);
  let size = le(library, at + 20, 4);
  let wanted = name.concat(b"\x00");
  if symbols + 16 * count > library.len() || strings + size > library.len() { None } else {
    range(0, count).fold(None, |acc: Option<Int>, i: Int|
      if acc != None { acc } else {
        let e = symbols + 16 * i;
        let from = strings + le(library, e, 4);
        // `N_SECT` and `N_EXT`.
        if library.at(e + 4) & 0x0F != 0x0F || from + wanted.len() > strings + size { None }
        else if library.slice(from, from + wanted.len()) == wanted { Some(le(library, e + 8, 8)) }
        else { None }
      })
  }
}

/// How far a direct call reaches on arm64, either way.
fn branch_reach() -> Int = 134217728

/// The addresses a segment of a library's code is mapped at, `to` past its end.
type Mapped = { from: Int, to: Int }

/// Where each executable segment of `library` is mapped, where it is a 64-bit little-endian Mach-O
/// library for arm64.
fn macho_code(library: Bytes) -> List<Mapped> / {abort.raise} =
  if library.len() < 32 || !library.starts_with(b"\xCF\xFA\xED\xFE")
      || le(library, 4, 4) != 0x0100000C { [] } else {
    range(0, le(library, 16, 4)).fold(
      { at: 32, code: [] },
      |s: { at: Int, code: List<Mapped> }, _i: Int|
        if s.at + 8 > library.len() { s } else {
          let next = s.at + le(library, s.at + 4, 4);
          // `LC_SEGMENT_64`, mapped executable.
          if le(library, s.at, 4) != 0x19 || s.at + 72 > library.len()
              || le(library, s.at + 60, 4) / 4 % 2 == 0 { { ..s, at: next } } else {
            let from = le(library, s.at + 24, 8);
            { at: next, code: s.code.push({ from: from, to: from + le(library, s.at + 32, 8) }) }
          }
        },
    ).code
  }

/// Where each executable segment of `library` is mapped, where it is a 64-bit little-endian ELF
/// library for arm64.
fn elf_code(library: Bytes) -> List<Mapped> / {abort.raise} =
  if library.len() < 64 || !library.starts_with(b"\x7FELF\x02\x01") || le(library, 18, 2) != 183 {
    []
  } else {
    let at = le(library, 32, 8);
    let each = le(library, 54, 2);
    let count = le(library, 56, 2);
    if each < 56 || at + count * each > library.len() { [] } else {
      range(0, count).fold([], |code: List<Mapped>, i: Int| {
        let h = at + i * each;
        // `PT_LOAD`, mapped executable.
        if le(library, h, 4) != 1 || le(library, h + 4, 4) % 2 == 0 { code } else {
          let from = le(library, h + 16, 8);
          code.push({ from: from, to: from + le(library, h + 40, 8) })
        }
      })
    }
  }

/// Whether a direct call reaches from any of `library`'s code to any other: 128 MB either way on
/// arm64, and further on any other machine a unit is built for.
pub fn spanned(library: Bytes) -> Bool / {abort.raise} = {
  let code = macho_code(library).concat(elf_code(library));
  match code.at(0) {
    None -> true,
    Some(first) ->
      code.fold(first.to, |hi: Int, m: Mapped| if m.to > hi { m.to } else { hi })
        - code.fold(first.from, |lo: Int, m: Mapped| if m.from < lo { m.from } else { lo })
        <= branch_reach(),
  }
}

/// The integer `count` bytes of `b` from `from` hold, least significant first.
fn le(b: Bytes, from: Int, count: Int) -> Int / {abort.raise} =
  range(0, count).fold(0, |n: Int, k: Int| n * 256 + b.at(from + count - 1 - k))

/// `n` as `count` bytes, least significant first.
fn le_of(n: Int, count: Int) -> Bytes / {abort.raise} =
  range(0, count).fold({ rest: n, out: b"" }, |s: { rest: Int, out: Bytes }, _k: Int|
    { rest: s.rest / 256, out: s.out.concat(byte_of_int(s.rest % 256)) }).out

fn gnu_stack() -> Int = 0x6474E551

/// `library` saying its code needs no executable stack: a 64-bit little-endian ELF file with no
/// `PT_GNU_STACK` program header gains one, and anything else comes back as it is. A loader takes a
/// library without the header to need an executable stack, which glibc refuses to give one it opens,
/// and tcc links none. tcc leaves no room after the headers, so they move to the end of the file.
pub fn stack_marked(library: Bytes) -> Bytes / {abort.raise} = {
  let size = library.len();
  if size < 64 || !library.starts_with(b"\x7FELF\x02\x01") { library } else {
    let at = le(library, 32, 8);
    let each = le(library, 54, 2);
    let count = le(library, 56, 2);
    let whole = each == 56 && at + count * each <= size;
    let marked = whole
      && (match range(0, count).find(|i: Int| le(library, at + i * each, 4) == gnu_stack()) {
        Some(_) -> true,
        None -> false,
      });
    if !whole || marked { library } else {
      let pad = (8 - size % 8) % 8;
      Bytes::concat_all([
        library.slice(0, 32),
        le_of(size + pad, 8),
        library.slice(40, 56),
        le_of(count + 1, 2),
        library.slice(58, size),
        b"\x00".repeat(pad),
        library.slice(at, at + count * each),
        le_of(gnu_stack(), 4),
        // Readable and writable, not executable.
        le_of(6, 4),
        b"\x00".repeat(40),
        le_of(16, 8),
      ])
    }
  }
}

/// The flags every object of a library a program loads compiles with.
pub fn library_flags() -> List<String> = ["-fPIC", "-fno-strict-aliasing"]

/// `text`, a unit's C, compiled by the compiler labelled `c` at `level`, checked or not, with `flags`
/// and linked into a library the cache keeps: its path, or why it was not built. `veneers` is
/// [`shared`]'s.
pub fn library<[c]>(
  level: String,
  checked: Bool,
  flags: List<String>,
  text: Bytes,
  veneers: Bool = true,
) -> Result<String, Unbuilt> / {compilers.read[c], compilers.write[c], toolchain.read, toolchain.write, abort.raise} =
  match compilers.found[c]() {
    None -> Err(BuildFailed("no C compiler is installed to compile the unit with")),
    Some(compiler) -> {
      let t = toolchain_of(compiler, level, checked);
      let parts = split(text);
      let cache = toolchain.cache();
      let made = library_of(
        t,
        sources_of(parts).map(|s: Source| cache ++ "/" ++ object_of(t, flags, s)),
      );
      // A unit built before is a library the cache holds, which needs no room to build in.
      if toolchain.holds(made) { Ok(cache ++ "/" ++ made) } else {
        match toolchain.scratch() {
          None -> Err(BuildFailed("the toolchain's cache has no room to compile in")),
          Some(work) -> {
            let built = match objects[c](t, parts, flags, work) {
              Err(why) -> Err(BuildFailed(why)),
              Ok(objects) -> shared[c](t, objects, work, veneers),
            };
            toolchain.cleared(work);
            built
          },
        }
      }
    },
  }

/// The executable `main`, a C translation unit, makes when compiled and linked after `objects` and
/// before `libraries`, which name archives and the system libraries they need: its path below
/// `work`, from which the asker moves it where it goes.
pub fn executable<[c]>(
  t: Toolchain,
  main: Bytes,
  objects: List<String>,
  libraries: List<String>,
  work: String,
) -> Result<String, String> / {compilers.write[c], toolchain.read, toolchain.write, abort.raise} = {
  let cache = toolchain.cache();
  let c = cache ++ "/" ++ work ++ "/main.c";
  let o = cache ++ "/" ++ work ++ "/main.o";
  let out = cache ++ "/" ++ work ++ "/program";
  if !toolchain.written(work ++ "/main.c", main) {
    Err("the program's `main` could not be written")
  } else {
    match ran[c]([t.support.concat(compile_flags(t).concat(["-c", "-o", o, c]))]) {
      Err(why) -> Err(why),
      Ok(_) -> match ran[c]([t.support.concat(["-o", out, o].concat(objects)).concat(libraries)]) {
        Err(why) -> Err(why),
        Ok(_) -> Ok(out),
      },
    }
  }
}

// --- The real handlers -----------------------------------------------------------
//
// The family `toolchain`, which a run is lent with `--allow toolchain`: each native refuses a run
// not lent it.

host for compilers by compiling

/// `go` with each C compiler the host has, by its label, each run a job of the run's that the
/// asking task waits for.
fn compiling<a | e>(
  go: () -> a / {compilers.read[*], compilers.write[*] | e},
) -> a / {native.read, wait.read, abort.raise | e} =
  handle {
    go()
  } with {
    compilers.found[*label]() -> match found(compilers_found(label)) {
      Some(said) -> match parts(said) {
        [path, identity, support] ->
          Some({
            path: String::of_bytes_lossy(path),
            identity: identity,
            support: parts(support).map(|flag: Bytes| String::of_bytes_lossy(flag)),
          }),
        _ -> panic("a compiler's native wrote no compiler"),
      },
      None -> None,
    },
    compilers.started[*label](args) -> {
      let said = compilers_started(label, in_parts(args.map(|a: String| Bytes::of_string(a))));
      if said.at(0) == 1 { Ok(int_of(said.slice(1, said.len()))) }
      else { Err(String::of_bytes_lossy(said.slice(1, said.len()))) }
    },
    compilers.finished[*label](job) -> found(job_wait(job)),
  }

/// The compiler the label names, found: its path, what identifies it, and its support flags as
/// parts, as parts.
extern fn compilers_found(label: String) -> Bytes / {native.read}

/// The compiler the label names started with `args`, as parts: byte 1 and the ticket of its end,
/// which answers what `compilers.finished` reads; or byte 0 and why it could not start.
extern fn compilers_started(label: String, args: Bytes) -> Bytes / {native.read}

host for toolchain by cached

/// `go` with the toolchain's cache read and written below it on the host, and each program linked
/// there run as a job of the run's that the asking task waits for.
fn cached<a | e>(
  go: () -> a / {toolchain.read, toolchain.write | e},
) -> a / {native.read, wait.read, abort.raise | e} =
  handle {
    go()
  } with {
    toolchain.cache() -> String::of_bytes_lossy(toolchain_cache()),
    toolchain.reused() -> String::of_bytes_lossy(toolchain_reused()),
    toolchain.bodies() -> String::of_bytes_lossy(toolchain_bodies()),
    toolchain.jobs() -> toolchain_jobs(),
    toolchain.holds(path) -> toolchain_holds(path),
    toolchain.held(path) -> found(toolchain_held(path)),
    toolchain.written(path, bytes) -> toolchain_written(path, bytes),
    toolchain.moved(from, to) -> toolchain_moved(from, to),
    toolchain.appended(path, bytes) -> toolchain_appended(path, bytes),
    toolchain.scratch() -> match found(toolchain_scratch()) {
      Some(dir) -> Some(String::of_bytes_lossy(dir)),
      None -> None,
    },
    toolchain.cleared(dir) -> toolchain_cleared(dir),
    toolchain.libraries() ->
      parts(toolchain_libraries()).map(|name: Bytes| String::of_bytes_lossy(name)),
    toolchain.ran(path, args) -> {
      let ticket = toolchain_ran(path, in_parts(args.map(|a: String| Bytes::of_string(a))));
      match parts(job_wait(ticket)) {
        [code, out] -> { code: int_of(code), out: out },
        _ -> panic("a linked program's native wrote no run"),
      }
    },
  }

/// The cache's directory.
extern fn toolchain_cache() -> Bytes / {native.read}

/// The directory what `ply run` and `ply check` reuse is filed in.
extern fn toolchain_reused() -> Bytes / {native.read}

/// The directory the emitter's answers are kept in.
extern fn toolchain_bodies() -> Bytes / {native.read}

/// How many compilers run at once.
extern fn toolchain_jobs() -> Int / {native.read}

/// Whether the cache holds `path`, which records a use of it.
extern fn toolchain_holds(path: String) -> Bool / {native.read}

/// What the cache holds at `path`, found.
extern fn toolchain_held(path: String) -> Bytes / {native.read}

/// Whether `bytes` were written whole at `path`.
extern fn toolchain_written(path: String, bytes: Bytes) -> Bool / {native.read}

/// Whether `from` was moved whole to `to`.
extern fn toolchain_moved(from: String, to: String) -> Bool / {native.read}

/// Whether `bytes` were added after what `path` holds.
extern fn toolchain_appended(path: String, bytes: Bytes) -> Bool / {native.read}

/// A new directory of the asker's own below the cache, found.
extern fn toolchain_scratch() -> Bytes / {native.read}

/// `dir` below the cache removed with everything under it.
extern fn toolchain_cleared(dir: String) -> Unit / {native.read}

/// What the runtime's library needs linked after it, as parts.
extern fn toolchain_libraries() -> Bytes / {native.read}

/// The ticket of the program at `path` below the cache run to its end with `args`, as parts: what
/// it ended with and what it wrote to standard output, as parts.
extern fn toolchain_ran(path: String, args: Bytes) -> Int / {native.read}

host for memory by measured

/// `go` with the asking program's own heap read.
fn measured<a | e>(go: () -> a / {memory.read | e}) -> a / {native.read, abort.raise | e} =
  handle {
    go()
  } with {
    memory.heap() -> match parts(memory_heap()) {
      [live, held] -> { live: int_of(live), held: int_of(held) },
      _ -> panic("the heap's native wrote no reading"),
    },
    memory.census() -> parts(memory_census()).map(|sort: Bytes| match parts(sort) {
      [what, objects, bytes] ->
        { what: String::of_bytes_lossy(what), objects: int_of(objects), bytes: int_of(bytes) },
      _ -> panic("the heap's native wrote no census"),
    }),
  }

/// What the heap holds, its live bytes and those held for them, as parts.
extern fn memory_heap() -> Bytes / {native.read}

/// The live objects, the most bytes first, each a sort's words, its count and its bytes, as parts
/// of parts.
extern fn memory_census() -> Bytes / {native.read}

// --- Tests -----------------------------------------------------------------------

fn unit_text() -> Bytes =
  b"#include <x>\n/* --- bucket 0a --- */\nint a;\n/* --- bucket 1f --- */\nint b;\n\n/* --- the runtime, bound at load --- */\nint r;\n"

test "a unit cuts at its marks into a head and its parts, the largest first, which hold all of it" {
  let p = split(unit_text());
  assert_eq(p.head, b"#include <x>\n");
  assert_eq(p.parts.map(|x: { label: String, text: Bytes }| x.label), ["runtime", "1f", "0a"]);
  assert_eq(
    Bytes::concat_all([p.head, p.parts.get(2).text, p.parts.get(1).text, p.parts.get(0).text]),
    unit_text(),
  );
  assert_eq(p.parts.get(0).text, b"/* --- the runtime, bound at load --- */\nint r;\n")
}

test "parts of one size keep the unit's order" {
  let p = split(b"/* --- bucket 1f --- */\nint b;\n/* --- bucket 0a --- */\nint a;\n");
  assert_eq(p.parts.map(|x: { label: String, text: Bytes }| x.label), ["1f", "0a", "runtime"])
}

test "a text with no marks is all head, beside an empty runtime part" {
  let p = split(b"int x;\n");
  assert_eq(p.head, b"int x;\n");
  assert_eq(p.parts, [{ label: "runtime", text: b"" }])
}

test "a part's source is the digest of its C with the head before it" {
  let p = split(unit_text());
  let sources = sources_of(p);
  assert_eq(sources.map(|s: Source| s.label), ["runtime", "1f", "0a"]);
  assert_eq(sources.get(0).digest, blake3(p.head.concat(p.parts.get(0).text)).hex_of());
  let moved = sources_of({ ..p, head: b"#include <y>\n" });
  assert(moved.get(1).digest != sources.get(1).digest, Some("the head is part of every source"))
}

test "a manifest reads back as the sources it was written from, and nothing else reads" {
  let sources = sources_of(split(unit_text()));
  assert_eq(manifested(manifest(sources)), Some(sources));
  assert_eq(manifested(b""), Some([]));
  assert_eq(manifested(b"0a short\n"), None);
  assert_eq(manifested(b"just-a-label\n"), None)
}

test "an object's key moves with its compiler, its level, its flags and its C" {
  let t = { identity: b"cc 1", support: [], level: "-O2", checked: false };
  let base = key_of(t, ["-c"], [b"head", b"text"]);
  assert_eq(key_of(t, ["-c"], [b"head", b"text"]), base);
  assert(key_of({ ..t, identity: b"cc 2" }, ["-c"], [b"head", b"text"]) != base);
  assert(key_of({ ..t, level: "-O0" }, ["-c"], [b"head", b"text"]) != base);
  assert(key_of(t, ["-c", "-fvisibility=hidden"], [b"head", b"text"]) != base);
  assert(key_of(t, ["-c"], [b"head", b"text2"]) != base)
}

test "a checked toolchain compiles with `PLY_CHECKED` defined and keys its objects apart, and an unchecked one does not" {
  let compiler = { path: "cc", identity: b"cc 1", support: [] };
  let development = toolchain_of(compiler, "-O0", true);
  let release = toolchain_of(compiler, "-O2", false);
  assert(compile_flags(development).contains("-DPLY_CHECKED"), None);
  assert(!compile_flags(release).contains("-DPLY_CHECKED"), None);
  assert(
    key_of(development, ["-c"], [b"text"])
      != key_of({ ..development, checked: false }, ["-c"], [b"text"]),
    None,
  )
}

/// What `ran` answers over `runs` where the compiler says `said` of each run, its argument the
/// run's last, `None` where it compiles; and how many runs were started.
fn ran_over(
  runs: List<List<String>>,
  said: (String) -> Option<Bytes>,
) -> { answer: Result<Unit, String>, started: Int } / {abort.raise} =
  handle {
    ran[cc](runs)
  } with {
    var started = 0,
    compilers.started[cc](args) -> {
      started = started + 1;
      Ok(started - 1)
    },
    compilers.finished[cc](job) -> said(match runs.get(job).last() { Some(f) -> f, None -> "" }),
    toolchain.jobs() -> 1,
    toolchain.cache() -> panic("a run reads no cache"),
    toolchain.reused() -> panic("a run reads no cache"),
    toolchain.bodies() -> panic("a run reads no cache"),
    toolchain.holds(path) -> panic("a run reads no cache"),
    toolchain.held(path) -> panic("a run reads no cache"),
    toolchain.libraries() -> panic("a run links no library"),
    return answer -> { answer: answer, started: started },
  }

test "a compile runs every part, and fails once with what the compiler said of each part it refused" {
  let runs = [["-c", "a.c"], ["-c", "b.c"], ["-c", "c.c"]];
  let said = |file: String|
    if file == "b.c" { None } else { Some(Bytes::of_string(file ++ ":1: error: no")) };
  let r = ran_over(runs, said);
  // One part refused does not keep the others from compiling.
  assert_eq(r.started, 3);
  match r.answer {
    Ok(_) -> assert(false, Some("a compile two parts refused succeeded")),
    Err(why) -> {
      let text = Bytes::of_string(why);
      let at = |s: Bytes| match text.index_of(s) { Some(i) -> i, None -> 0 - 1 };
      assert(
        text.starts_with(b"the C compiler refused 2 of 3 runs")
          && at(b"`-c a.c`:\na.c:1: error: no") >= 0
          && at(b"`-c c.c`:\nc.c:1: error: no") >= 0
          && at(b"b.c") < 0,
        Some(why),
      );
      // In the order the parts were started.
      assert(at(b"a.c:1") < at(b"c.c:1"), Some(why))
    },
  };
  // One refusal is said alone, and none is a success.
  assert_eq(
    ran_over(runs, |file: String|
      if file == "c.c" { Some(Bytes::of_string("bad")) } else { None }).answer,
    Err("the C compiler refused `-c c.c`:\nbad"),
  );
  assert_eq(ran_over(runs, |_: String| None).answer, Ok(()))
}

fn elf_of(machine: Int, headers: Bytes, count: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\x7FELF\x02\x01",
    b"\x00".repeat(12),
    le_of(machine, 2),
    b"\x00".repeat(12),
    le_of(64, 8),
    b"\x00".repeat(14),
    le_of(56, 2),
    le_of(count, 2),
    b"\x00".repeat(6),
    headers,
  ])

test "a library with no stack header gains one after its end, and one that has it is left alone" {
  let load = le_of(1, 4).concat(b"\x00".repeat(52));
  let marked = stack_marked(elf_of(0, load, 1).concat(b"body"));
  assert_eq(marked.len(), 128 + 2 * 56);
  assert_eq(le(marked, 32, 8), 128);
  assert_eq(le(marked, 56, 2), 2);
  assert_eq(marked.slice(120, 124), b"body");
  assert_eq(marked.slice(128, 184), load);
  assert_eq(le(marked, 184, 4), gnu_stack());
  assert_eq(le(marked, 188, 4), 6);
  assert_eq(stack_marked(marked), marked)
}

test "what is not a 64-bit little-endian ELF file is left as it is" {
  assert_eq(
    stack_marked(b"\xCF\xFA\xED\xFE a Mach-O library"),
    b"\xCF\xFA\xED\xFE a Mach-O library",
  );
  let big_endian = b"\x7FELF\x02\x02".concat(b"\x00".repeat(120));
  assert_eq(stack_marked(big_endian), big_endian)
}

fn macho_of(cpu: Int, segments: List<Bytes>) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    [
      b"\xCF\xFA\xED\xFE",
      le_of(cpu, 4),
      b"\x00".repeat(8),
      le_of(segments.len(), 4),
      b"\x00".repeat(12),
    ].concat(
      segments,
    ),
  )

/// A Mach-O segment mapped `size` bytes from `at`, with `prot` as its initial protection.
fn segment(prot: Int, at: Int, size: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    le_of(0x19, 4),
    le_of(72, 4),
    b"\x00".repeat(16),
    le_of(at, 8),
    le_of(size, 8),
    b"\x00".repeat(20),
    le_of(prot, 4),
    b"\x00".repeat(8),
  ])

/// An ELF program header loading `size` bytes at `at`, with `flags`.
fn loaded(flags: Int, at: Int, size: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    le_of(1, 4),
    le_of(flags, 4),
    b"\x00".repeat(8),
    le_of(at, 8),
    b"\x00".repeat(16),
    le_of(size, 8),
    b"\x00".repeat(8),
  ])

/// An `LC_SYMTAB` command: `count` symbols at `symbols`, their names' `size` bytes at `strings`.
fn symtab(symbols: Int, count: Int, strings: Int, size: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    le_of(0x2, 4),
    le_of(24, 4),
    le_of(symbols, 4),
    le_of(count, 4),
    le_of(strings, 4),
    le_of(size, 4),
  ])

/// An arm64 Mach-O library whose symbol table puts `_ply_descriptor` at `at` and whose exports trie
/// is `trie`.
fn exporting(at: Int, trie: Bytes) -> Bytes / {abort.raise} = {
  let head = 32 + 24 + 16;
  let names = b"\x00_ply_descriptor\x00";
  let symbol = Bytes::concat_all([le_of(1, 4), b"\x0F\x01", le_of(0, 2), le_of(at, 8)]);
  let commands = [
    symtab(head, 1, head + 16, names.len()),
    Bytes::concat_all([
      le_of(0x80000033, 4),
      le_of(16, 4),
      le_of(head + 16 + names.len(), 4),
      le_of(trie.len(), 4),
    ]),
  ];
  Bytes::concat_all([macho_of(0x0100000C, commands), symbol, names, trie])
}

/// An exports trie of `name` alone at `at`, below 128: the root's one edge to a node exporting it.
fn trie_of(name: Bytes, at: Int) -> Bytes / {abort.raise} = {
  let root = Bytes::concat_all([b"\x00\x01", name, b"\x00"]);
  Bytes::concat_all([root, byte_of_int(root.len() + 1), b"\x02\x00", byte_of_int(at), b"\x00"])
}

test "a Mach-O library is handed to the loader only where its exports name its descriptor where its symbols put it" {
  assert(exports_descriptor(exporting(72, trie_of(b"_ply_descriptor", 72))), None);
  // Down two edges, past a sibling that shares their prefix.
  let shared = Bytes::concat_all([
    b"\x00\x01_ply_\x00\x09",
    b"\x00\x02exports\x00\x20descriptor\x00\x24",
    b"\x02\x00\x10\x00",
    b"\x02\x00\x48\x00",
  ]);
  assert(exports_descriptor(exporting(72, shared)), None);
  // A trie that names it elsewhere, names something else or does not read, as tcc's can.
  assert(!exports_descriptor(exporting(72, trie_of(b"_ply_descriptor", 80))), None);
  assert(!exports_descriptor(exporting(72, trie_of(b"_ply_other", 72))), None);
  assert(!exports_descriptor(exporting(72, b"\x00\x05\xFF\xFF")), None);
  assert(!exports_descriptor(exporting(72, b"")), None);
  // What is no Mach-O library is taken as linked.
  assert(exports_descriptor(b""), None);
  assert(exports_descriptor(elf_of(183, b"", 0)), None)
}

test "an arm64 Mach-O library is spanned while its code is within a direct call's reach" {
  let arm64 = 0x0100000C;
  let data = segment(3, branch_reach(), 3 * branch_reach());
  assert(spanned(macho_of(arm64, [segment(5, 0, branch_reach()), data])));
  assert(!spanned(macho_of(arm64, [segment(5, 0, branch_reach() + 1), data])));
  assert(!spanned(macho_of(arm64, [segment(5, 0, 64), data, segment(5, branch_reach(), 64)])));
  assert(spanned(macho_of(0x01000007, [segment(5, 0, 2 * branch_reach())])));
  assert(spanned(macho_of(arm64, [segment(5, 0, 2 * branch_reach())]).slice(0, 80)))
}

test "an arm64 ELF library is spanned while its code is within a direct call's reach" {
  let code = |size: Int| loaded(5, 0, size).concat(loaded(6, branch_reach(), 3 * branch_reach()));
  assert(spanned(elf_of(183, code(branch_reach()), 2)));
  assert(!spanned(elf_of(183, code(branch_reach() + 1), 2)));
  assert(spanned(elf_of(62, code(2 * branch_reach()), 2)))
}
