import std.bytes
import std.hash (blake3)
import std.internal.native (native, wait, job_wait, found, parts, encode_parts, decode_int)
import std.list
import std.string

pub effect compilers {
  read find[c]() -> Option<Compiler>
  write start[c](args: List<String>) -> Result<Int, String>
  write wait[c](job: Int) -> Option<Bytes>
}

pub effect toolchain {
  read cache() -> String
  read reuse_dir() -> String
  read bodies_dir() -> String
  read exists(path: String) -> Bool
  read read_file(path: String) -> Option<Bytes>
  write write_file(path: String, bytes: Bytes) -> Bool
  write rename(from: String, to: String) -> Bool
  write append(path: String, bytes: Bytes) -> Bool
  write temp_dir() -> Option<String>
  write remove_tree(dir: String) -> Unit
  read libraries() -> List<String>
  write run(path: String, args: List<String>) -> RunResult
}

pub nondet effect memory {
  read heap() -> Memory
  read census() -> List<LiveObjects>
}

pub type RunResult = { code: Int, out: Bytes }

pub type Memory = { live: Int, reserved: Int }

pub type LiveObjects = { what: String, objects: Int, bytes: Int }

pub type Compiler = { path: String, identity: Bytes, support_flags: List<String> }

pub type Toolchain = { identity: Bytes, support_flags: List<String>, level: String, checked: Bool }

fn marker_start() -> Bytes = b"/* --- "

fn part_opener() -> Bytes = b"/* --- part "

fn marker_end() -> Bytes = b" --- */"

pub fn part_mark(label: String) -> Bytes =
  Bytes::concat_all([part_opener(), Bytes::of_string(label), marker_end()])

pub fn runtime_part_mark() -> Bytes = b"/* --- the runtime, bound at load --- */"

fn line_start(text: Bytes, mark: Bytes, from: Int) -> Option<Int> / {abort.raise} =
  if from == 0 && text.starts_with(mark) { Some(0) } else {
    match text.index_of_from(b"\n".concat(mark), from) { Some(at) -> Some(at + 1), None -> None }
  }

fn label_of(line: Bytes) -> Option<String> / {abort.raise} =
  if line == runtime_part_mark() { Some("runtime") }
  else if line.len() >= part_opener().len() + marker_end().len() && line.starts_with(part_opener())
      && line.ends_with(marker_end()) {
    Some(String::of_bytes(line.slice(part_opener().len(), line.len() - marker_end().len())))
  } else { None }

fn marks(text: Bytes) -> List<{ at: Int, label: String }> / {abort.raise} =
  iterate(
    { from: 0, found: [] },
    text.len() + 1,
    |s: { from: Int, found: List<{ at: Int, label: String }> }|
      match line_start(text, marker_start(), s.from) {
        None -> Stop(s.found),
        Some(at) -> {
          let end = match text.index_of_from(b"\n", at) { Some(e) -> e, None -> text.len() };
          Continue({
            from: end,
            found: match label_of(text.slice(at, end)) {
              Some(label) -> s.found.push({ at: at, label: label }),
              None -> s.found,
            },
          })
        },
      },
  )

pub fn split(text: Bytes) -> { head: Bytes, parts: List<WrittenPart> } / {abort.raise} = {
  let found = marks(text);
  let labels = found.map(|m: { at: Int, label: String }| m.label).sort();
  match range(1, labels.len()).find(|i: Int| labels.get(i) == labels.get(i - 1)) {
    Some(i) -> panic("two parts of a unit are labelled `" ++ labels.get(i) ++ "`"),
    None -> (),
  };
  match found.at(0) {
    None -> { head: text, parts: [written_part(text, "runtime", b"")] },
    Some(first) -> {
      let head = text.slice(0, first.at);
      {
        head: head,
        parts: range(0, found.len()).map(|i: Int| {
          let end = match found.at(i + 1) { Some(next) -> next.at, None -> text.len() };
          written_part(head, found.get(i).label, text.slice(found.get(i).at, end))
        }),
      }
    },
  }
}

fn cache_key(t: Toolchain, flags: List<String>, pieces: List<Bytes>) -> String / {abort.raise} =
  blake3(
    Bytes::concat_all(
      [t.identity, b"\x00"].concat(
        compile_flags(t).concat(flags).map(|f: String| Bytes::of_string(f).concat(b"\x00")).concat(
          pieces,
        ),
      ),
    ),
  ).hex_of(
  )

fn float_flags() -> List<String> = ["-ffp-contract=off", "-fno-fast-math"]

pub fn compile_flags(t: Toolchain) -> List<String> =
  [t.level].concat(if t.checked { ["-DPLY_CHECKED"] } else { [] }).concat(float_flags())

pub fn toolchain_of(compiler: Compiler, level: String, checked: Bool) -> Toolchain =
  {
    identity: compiler.identity,
    support_flags: compiler.support_flags,
    level: level,
    checked: checked,
  }

pub type Profile = {
  name: String,
  runtime_dir: String,
  unit: String,
  native: String,
  checked: Bool,
  tcc: Bool,
}

pub fn development() -> Profile =
  {
    name: "development",
    runtime_dir: "debug",
    unit: "-O0",
    native: "-O2",
    checked: true,
    tcc: true,
  }

pub fn release() -> Profile =
  {
    name: "release",
    runtime_dir: "release",
    unit: "-O2",
    native: "-O2",
    checked: false,
    tcc: false,
  }

pub fn profiles() -> List<Profile> = [development(), release()]

type Started = { job: Int, args: List<String> }

fn run_all<[c]>(runs: List<List<String>>) -> Result<Unit, String> / {compilers.write[c]} = {
  let launched = runs.fold(
    { started: [], refused: None },
    |s: { started: List<Started>, refused: Option<String> }, args: List<String>|
      match s.refused {
        Some(_) -> s,
        None -> match compilers.start[c](args) {
          Ok(job) -> { ..s, started: s.started.push({ job: job, args: args }) },
          Err(reason) -> { ..s, refused: Some("the C compiler could not be started: " ++ reason) },
        },
      },
  );
  let rejected = launched.started.fold(
    match launched.refused { Some(reason) -> [reason], None -> [] },
    |acc: List<String>, run: Started|
      match compilers.wait[c](run.job) {
        None -> acc,
        Some(err) ->
          acc.push(
            "the C compiler rejected `" ++ String::join(run.args, " ") ++ "`:\n"
              ++ String::of_bytes_lossy(err),
          ),
      },
  );
  match rejected {
    [] -> Ok(()),
    [reason] -> Err(reason),
    _ ->
      Err(
        "the C compiler rejected " ++ rejected.len().to_string() ++ " of " ++ runs.len().to_string()
          ++ " runs:\n\n"
          ++ String::join(rejected, "\n\n"),
      ),
  }
}

pub type Source = { label: String, digest: String }

fn source_digest(head: Bytes, part: Bytes) -> String / {abort.raise} =
  blake3(head.concat(part)).hex_of()

fn source_path(digest: String) -> String = "src/" ++ digest ++ ".c"

fn uncached(s: Source) -> String =
  "the generated C file `" ++ s.label ++ "` is no longer in the toolchain's cache"

pub type WrittenPart = { label: String, digest: String, size: Int, text: Option<Bytes> }

pub fn written_part(head: Bytes, label: String, text: Bytes) -> WrittenPart / {abort.raise} =
  { label: label, digest: source_digest(head, text), size: text.len(), text: Some(text) }

pub fn is_source_cached(digest: String) -> Bool / {toolchain.read} =
  toolchain.exists(source_path(digest))

pub fn cache_sources(
  head: Bytes,
  written: List<WrittenPart>,
) -> Result<List<Source>, String> / {toolchain.read, toolchain.write} = {
  let landed = written.fold(true, |ok: Bool, w: WrittenPart|
    ok
      && (is_source_cached(w.digest)
      || (match w.text {
        None -> false,
        Some(t) -> toolchain.write_file(source_path(w.digest), head.concat(t)),
      })));
  if !landed { Err("generated C code could not be written to the toolchain's cache") } else {
    Ok(
      written.sort_by(|a: WrittenPart, b: WrittenPart| a.size > b.size).map(|w: WrittenPart|
        { label: w.label, digest: w.digest }),
    )
  }
}

pub fn cache_text(
  text: Bytes,
) -> Result<List<Source>, String> / {toolchain.read, toolchain.write, abort.raise} = {
  let cut = split(text);
  cache_sources(cut.head, cut.parts)
}

pub fn read_back(
  head: Bytes,
  sources: List<Source>,
) -> Result<Bytes, String> / {toolchain.read, abort.raise} =
  match sources.fold(Ok([head]), |accumulator: Result<List<Bytes>, String>, s: Source|
      match accumulator {
        Err(reason) -> Err(reason),
        Ok(texts) -> match toolchain.read_file(source_path(s.digest)) {
          None -> Err(uncached(s)),
          Some(c) -> if c.starts_with(head) { Ok(texts.push(c.slice(head.len(), c.len()))) } else {
            Err(
              "the generated C file `" ++ s.label
                ++ "` in the toolchain's cache starts with different shared code than expected",
            )
          },
        },
      }) {
    Err(reason) -> Err(reason),
    Ok(texts) -> Ok(Bytes::concat_all(texts)),
  }

pub fn manifest(sources: List<Source>) -> Bytes =
  Bytes::concat_all(sources.map(|s: Source| Bytes::of_string(s.label ++ " " ++ s.digest ++ "\n")))

pub fn parse_manifest(text: Bytes) -> Option<List<Source>> =
  text.split(b"\n").fold(Some([]), |accumulator: Option<List<Source>>, line: Bytes|
    match accumulator {
      None -> None,
      Some(xs) -> if line.len() == 0 { accumulator } else {
        match line.split(b" ") {
          [label, digest] -> if digest.len() == 64 {
            Some(
              xs.push({
                label: String::of_bytes_lossy(label),
                digest: String::of_bytes_lossy(digest),
              }),
            )
          } else { None },
          _ -> None,
        }
      },
    })

pub fn sources_cached(sources: List<Source>) -> Bool / {toolchain.read} =
  sources.fold(true, |ok: Bool, s: Source| ok && is_source_cached(s.digest))

fn object_path(t: Toolchain, flags: List<String>, s: Source) -> String / {abort.raise} =
  "obj/" ++ cache_key(t, flags, [Bytes::of_string(s.digest)]) ++ ".o"

pub type Objects = { paths: List<String>, compiled_count: Int }

pub fn objects<[c]>(
  t: Toolchain,
  sources: List<Source>,
  flags: List<String>,
  work: String,
) -> Result<Objects, String> / {compilers.write[c], toolchain.read, toolchain.write, abort.raise} = {
  let cache = toolchain.cache();
  let targets = sources.map(|s: Source| object_path(t, flags, s));
  let missing = range(0, targets.len()).filter(|i: Int| !toolchain.exists(targets.get(i)));
  match missing.find(|i: Int| !is_source_cached(sources.get(i).digest)) {
    Some(i) -> Err(uncached(sources.get(i))),
    None -> {
      let object = |i: Int| work ++ "/" ++ i.to_string() ++ ".o";
      let runs = missing.map(|i: Int|
        t.support_flags.concat(compile_flags(t).concat(flags)).concat([
          "-c",
          "-o",
          cache ++ "/" ++ object(i),
          cache ++ "/" ++ source_path(sources.get(i).digest),
        ]));
      match run_all[c](runs) {
        Err(reason) -> Err(reason),
        Ok(_) -> {
          let placed = missing.fold(true, |ok: Bool, i: Int|
            ok && toolchain.rename(object(i), targets.get(i)));
          if placed {
            Ok({ paths: targets.map(|o: String| cache ++ "/" ++ o), compiled_count: missing.len() })
          } else { Err("an object could not be written to the toolchain's cache") }
        },
      }
    },
  }
}

fn link_shared<[c]>(
  t: Toolchain,
  objects: List<String>,
  work: String,
) -> Result<String, String> / {compilers.write[c], toolchain.read, toolchain.write, abort.raise} = {
  let cache = toolchain.cache();
  let library = library_path(t, objects);
  if toolchain.exists(library) { Ok(cache ++ "/" ++ library) } else {
    let made = work ++ "/unit.so";
    match run_all[c]([
        t.support_flags.concat(["-shared", "-o", cache ++ "/" ++ made].concat(objects)),
      ]) {
      Err(reason) -> Err(reason),
      Ok(_) -> match toolchain.read_file(made) {
        None -> Err("the C compiler linked no library"),
        Some(linked) -> if toolchain.write_file(made, with_stack_header(linked))
            && toolchain.rename(made, library) { Ok(cache ++ "/" ++ library) }
        else { Err("the library could not be written to the toolchain's cache") },
      },
    }
  }
}

fn library_path(t: Toolchain, objects: List<String>) -> String / {abort.raise} =
  cache_key(t, ["-shared", "stack-marked"], objects.map(Bytes::of_string)) ++ ".so"

fn read_little_endian(b: Bytes, from: Int, count: Int) -> Int / {abort.raise} =
  range(0, count).fold(0, |n: Int, k: Int| n * 256 + b.at(from + count - 1 - k))

fn little_endian_bytes(n: Int, count: Int) -> Bytes / {abort.raise} =
  range(0, count).fold({ rest: n, out: b"" }, |s: { rest: Int, out: Bytes }, _k: Int|
    { rest: s.rest / 256, out: s.out.concat(byte_of_int(s.rest % 256)) }).out

fn pt_gnu_stack() -> Int = 0x6474E551

pub fn with_stack_header(library: Bytes) -> Bytes / {abort.raise} = {
  let size = library.len();
  if size < 64 || !library.starts_with(b"\x7FELF\x02\x01") { library } else {
    let at = read_little_endian(library, 32, 8);
    let each = read_little_endian(library, 54, 2);
    let count = read_little_endian(library, 56, 2);
    let whole = each == 56 && at + count * each <= size;
    let marked = whole
      && (match range(0, count).find(|i: Int|
          read_little_endian(library, at + i * each, 4) == pt_gnu_stack()) {
        Some(_) -> true,
        None -> false,
      });
    if !whole || marked { library } else {
      let pad = (8 - size % 8) % 8;
      Bytes::concat_all([
        library.slice(0, 32),
        little_endian_bytes(size + pad, 8),
        library.slice(40, 56),
        little_endian_bytes(count + 1, 2),
        library.slice(58, size),
        b"\x00".repeat(pad),
        library.slice(at, at + count * each),
        little_endian_bytes(pt_gnu_stack(), 4),
        little_endian_bytes(6, 4),
        b"\x00".repeat(40),
        little_endian_bytes(16, 8),
      ])
    }
  }
}

fn library_flags() -> List<String> = ["-fPIC", "-fno-strict-aliasing"]

fn probe_path() -> String = "probe/x86_64_linux.c"

pub fn targets_x86_64_linux<[c]>() -> Bool / {compilers.write[c], toolchain.read, toolchain.write} = {
  let cache_sources = toolchain.exists(probe_path())
    || toolchain.write_file(
      probe_path(),
      b"#if !defined(__x86_64__) || !defined(__linux__)\n#error\n#endif\n",
    );
  if !cache_sources { false } else {
    match run_all[c]([["-E", toolchain.cache() ++ "/" ++ probe_path()]]) {
      Ok(_) -> true,
      Err(_) -> false,
    }
  }
}

pub fn library<[c]>(
  p: Profile,
  sources: List<Source>,
) -> Result<String, String> / {compilers.read[c], compilers.write[c], toolchain.read, toolchain.write, abort.raise} =
  match compilers.find[c]() {
    None -> Err("no C compiler is installed to compile the unit with"),
    Some(compiler) -> {
      let t = toolchain_of(compiler, p.unit, p.checked);
      let flags = library_flags();
      let cache = toolchain.cache();
      let made = library_path(t, sources.map(|s: Source| cache ++ "/" ++ object_path(t, flags, s)));
      if toolchain.exists(made) { Ok(cache ++ "/" ++ made) } else {
        match toolchain.temp_dir() {
          None -> Err("the toolchain's cache has no room to compile in"),
          Some(work) -> {
            let built = match objects[c](t, sources, flags, work) {
              Err(reason) -> Err(reason),
              Ok(compiled) -> link_shared[c](t, compiled.paths, work),
            };
            toolchain.remove_tree(work);
            built
          },
        }
      }
    },
  }

pub fn executable<[c]>(
  t: Toolchain,
  main: Bytes,
  objects: List<String>,
  libraries: List<String>,
  work: String,
) -> Result<String, String> / {compilers.write[c], toolchain.read, toolchain.write} = {
  let cache = toolchain.cache();
  let c = cache ++ "/" ++ work ++ "/main.c";
  let o = cache ++ "/" ++ work ++ "/main.o";
  let out = cache ++ "/" ++ work ++ "/program";
  if !toolchain.write_file(work ++ "/main.c", main) {
    Err("the program's `main` could not be written")
  } else {
    match run_all[c]([t.support_flags.concat(compile_flags(t).concat(["-c", "-o", o, c]))]) {
      Err(reason) -> Err(reason),
      Ok(_) -> match run_all[c]([
          t.support_flags.concat(["-o", out, o].concat(objects)).concat(libraries),
        ]) {
        Err(reason) -> Err(reason),
        Ok(_) -> Ok(out),
      },
    }
  }
}

host for compilers by compilers_handler

fn compilers_handler<a | e>(
  go: () -> a / {compilers.read[*], compilers.write[*] | e},
) -> a / {native.read, wait.read, abort.raise | e} =
  handle {
    go()
  } with {
    compilers.find[*label]() -> match found(compilers_found(label)) {
      Some(found_compiler) -> match parts(found_compiler) {
        [path, identity, support] ->
          Some({
            path: String::of_bytes_lossy(path),
            identity: identity,
            support_flags: parts(support).map(|flag: Bytes| String::of_bytes_lossy(flag)),
          }),
        _ -> panic("the runtime returned malformed compiler information"),
      },
      None -> None,
    },
    compilers.start[*label](args) -> {
      let started = compilers_started(
        label,
        encode_parts(args.map(|a: String| Bytes::of_string(a))),
      );
      if started.at(0) == 1 { Ok(decode_int(started.slice(1, started.len()))) }
      else { Err(String::of_bytes_lossy(started.slice(1, started.len()))) }
    },
    compilers.wait[*label](job) -> found(job_wait(job)),
  }

extern fn compilers_found(label: String) -> Bytes / {native.read}

extern fn compilers_started(label: String, args: Bytes) -> Bytes / {native.read}

host for toolchain by toolchain_handler

fn toolchain_handler<a | e>(
  go: () -> a / {toolchain.read, toolchain.write | e},
) -> a / {native.read, wait.read, abort.raise | e} =
  handle {
    go()
  } with {
    toolchain.cache() -> String::of_bytes_lossy(toolchain_cache()),
    toolchain.reuse_dir() -> String::of_bytes_lossy(toolchain_reused()),
    toolchain.bodies_dir() -> String::of_bytes_lossy(toolchain_bodies()),
    toolchain.exists(path) -> toolchain_holds(path),
    toolchain.read_file(path) -> found(toolchain_held(path)),
    toolchain.write_file(path, bytes) -> toolchain_written(path, bytes),
    toolchain.rename(from, to) -> toolchain_moved(from, to),
    toolchain.append(path, bytes) -> toolchain_appended(path, bytes),
    toolchain.temp_dir() -> match found(toolchain_scratch()) {
      Some(dir) -> Some(String::of_bytes_lossy(dir)),
      None -> None,
    },
    toolchain.remove_tree(dir) -> toolchain_cleared(dir),
    toolchain.libraries() ->
      parts(toolchain_libraries()).map(|name: Bytes| String::of_bytes_lossy(name)),
    toolchain.run(path, args) -> {
      let ticket = toolchain_ran(path, encode_parts(args.map(|a: String| Bytes::of_string(a))));
      match parts(job_wait(ticket)) {
        [code, out] -> { code: decode_int(code), out: out },
        _ -> panic("the runtime returned a malformed result for a linked program's run"),
      }
    },
  }

extern fn toolchain_cache() -> Bytes / {native.read}

extern fn toolchain_reused() -> Bytes / {native.read}

extern fn toolchain_bodies() -> Bytes / {native.read}

extern fn toolchain_holds(path: String) -> Bool / {native.read}

extern fn toolchain_held(path: String) -> Bytes / {native.read}

extern fn toolchain_written(path: String, bytes: Bytes) -> Bool / {native.read}

extern fn toolchain_moved(from: String, to: String) -> Bool / {native.read}

extern fn toolchain_appended(path: String, bytes: Bytes) -> Bool / {native.read}

extern fn toolchain_scratch() -> Bytes / {native.read}

extern fn toolchain_cleared(dir: String) -> Unit / {native.read}

extern fn toolchain_libraries() -> Bytes / {native.read}

extern fn toolchain_ran(path: String, args: Bytes) -> Int / {native.read}

host for memory by memory_handler

fn memory_handler<a | e>(go: () -> a / {memory.read | e}) -> a / {native.read, abort.raise | e} =
  handle {
    go()
  } with {
    memory.heap() -> match parts(memory_heap()) {
      [live, reserved] -> { live: decode_int(live), reserved: decode_int(reserved) },
      _ -> panic("the runtime returned malformed memory usage data"),
    },
    memory.census() ->
      parts(memory_census()).map(|sort: Bytes|
        match parts(sort) {
          [what, objects, bytes] ->
            {
              what: String::of_bytes_lossy(what),
              objects: decode_int(objects),
              bytes: decode_int(bytes),
            },
          _ -> panic("the runtime returned a malformed list of live objects"),
        }),
  }

extern fn memory_heap() -> Bytes / {native.read}

extern fn memory_census() -> Bytes / {native.read}

fn runtime_text() -> Bytes =
  runtime_part_mark().concat(b"\nint r;\n/* --- what the loader reads --- */\nint s;\n")

fn unit_text() -> Bytes =
  Bytes::concat_all([
    b"#include <x>\n",
    part_mark("0123456789abcdef"),
    b"\nint a;\n",
    part_mark("1f"),
    b"\nint b;\n\n",
    runtime_text(),
    part_mark("fields"),
    b"\nint f[] = { 1, 2, 3 };\n",
  ])

fn unit_labels() -> List<String> = ["0123456789abcdef", "1f", "runtime", "fields"]

fn part_label(part: WrittenPart) -> String = part.label

fn part_text(part: WrittenPart) -> Bytes = match part.text { Some(t) -> t, None -> b"" }

fn source_label(s: Source) -> String = s.label

test "`split` cuts C text at each part marker into a shared header and labeled parts that concatenate back to the original" {
  let p = split(unit_text());
  assert_eq(p.head, b"#include <x>\n");
  assert_eq(p.parts.map(part_label), unit_labels());
  assert_eq(Bytes::concat_all([p.head].concat(p.parts.map(part_text))), unit_text());
  assert_eq(part_text(p.parts.get(2)), runtime_text())
}

test "`split` of C text with no part marker returns the whole text as the header and one empty `runtime` part" {
  let text = b"int x;\n/* --- part of a comment */\nint y;\n";
  let p = split(text);
  assert_eq(p.head, text);
  assert_eq(p.parts, [written_part(text, "runtime", b"")])
}

test "`split` aborts with a message naming the label when two parts have the same label" {
  let message = handle {
    let _ = split(
      Bytes::concat_all([part_mark("ab"), b"\nint a;\n", part_mark("ab"), b"\nint b;\n"]),
    );
    ""
  } with {
    abort.raise(m) -> m,
  };
  assert(message.contains("`ab`"), Some(message))
}

test "a part's digest is the BLAKE3 hash of the header followed by the part's C, so changing the header changes every digest" {
  let p = split(unit_text());
  let first = p.parts.get(0);
  assert_eq(first.digest, blake3(p.head.concat(part_text(first))).hex_of());
  let moved = split(b"#include <y>\n".concat(unit_text().slice(p.head.len(), unit_text().len())));
  assert(
    moved.parts.get(1).digest != p.parts.get(1).digest,
    Some("the head is part of every source"),
  )
}

test "`parse_manifest` returns the label and digest list that `manifest` wrote, and `None` for malformed text" {
  let sources = split(unit_text()).parts.map(|w: WrittenPart| { label: w.label, digest: w.digest });
  assert_eq(parse_manifest(manifest(sources)), Some(sources));
  assert_eq(parse_manifest(b""), Some([]));
  assert_eq(parse_manifest(b"0a short\n"), None);
  assert_eq(parse_manifest(b"just-a-label\n"), None)
}

test "`cache_key` changes when the compiler identity, optimization level, flags or C text changes" {
  let t = { identity: b"cc 1", support_flags: [], level: "-O2", checked: false };
  let base = cache_key(t, ["-c"], [b"head", b"text"]);
  assert_eq(cache_key(t, ["-c"], [b"head", b"text"]), base);
  assert(cache_key({ ..t, identity: b"cc 2" }, ["-c"], [b"head", b"text"]) != base);
  assert(cache_key({ ..t, level: "-O0" }, ["-c"], [b"head", b"text"]) != base);
  assert(cache_key(t, ["-c", "-fvisibility=hidden"], [b"head", b"text"]) != base);
  assert(cache_key(t, ["-c"], [b"head", b"text2"]) != base)
}

test "a toolchain with checking on compiles with `PLY_CHECKED` defined and has different cache keys than with checking off, which does neither" {
  let compiler = { path: "cc", identity: b"cc 1", support_flags: [] };
  let development = toolchain_of(compiler, "-O0", true);
  let release = toolchain_of(compiler, "-O2", false);
  assert(compile_flags(development).contains("-DPLY_CHECKED"), None);
  assert(!compile_flags(release).contains("-DPLY_CHECKED"), None);
  assert(
    cache_key(development, ["-c"], [b"text"])
      != cache_key({ ..development, checked: false }, ["-c"], [b"text"]),
    None,
  )
}

test "both profiles optimise native programs the same" {
  assert_eq(release().native, development().native)
}

fn run_all_with(
  runs: List<List<String>>,
  compiler_output: (String) -> Option<Bytes>,
  starts: Int,
) -> { result: Result<Unit, String>, calls: List<String> } / {abort.raise} =
  handle {
    run_all[cc](runs)
  } with {
    var calls: List<String> = [],
    compilers.start[cc](args) -> {
      let file = match args.last() { Some(f) -> f, None -> "" };
      if calls.len() == starts {
        calls = calls.push("rejected " ++ file);
        Err("no `cc` is installed")
      } else {
        calls = calls.push("start " ++ file);
        Ok(calls.len() - 1)
      }
    },
    compilers.wait[cc](job) -> {
      let file = match runs.get(job).last() { Some(f) -> f, None -> "" };
      calls = calls.push("wait " ++ file);
      compiler_output(file)
    },
    return result -> { result: result, calls: calls },
  }

test "a compile starts every compiler invocation before it waits on any, then fails once with the compiler's output for each invocation that failed" {
  let runs = [["-c", "a.c"], ["-c", "b.c"], ["-c", "c.c"]];
  let compiler_output = |file: String|
    if file == "b.c" { None } else { Some(Bytes::of_string(file ++ ":1: error: no")) };
  let r = run_all_with(runs, compiler_output, runs.len());
  assert_eq(r.calls, ["start a.c", "start b.c", "start c.c", "wait a.c", "wait b.c", "wait c.c"]);
  match r.result {
    Ok(_) -> assert(false, Some("a compile two parts rejected succeeded")),
    Err(reason) -> {
      let text = Bytes::of_string(reason);
      let at = |s: Bytes| match text.index_of(s) { Some(i) -> i, None -> 0 - 1 };
      assert(
        text.starts_with(b"the C compiler rejected 2 of 3 runs")
          && at(b"`-c a.c`:\na.c:1: error: no") >= 0
          && at(b"`-c c.c`:\nc.c:1: error: no") >= 0
          && at(b"b.c") < 0,
        Some(reason),
      );
      assert(at(b"a.c:1") < at(b"c.c:1"), Some(reason))
    },
  };
  assert_eq(
    run_all_with(
      runs,
      |file: String| if file == "c.c" { Some(Bytes::of_string("bad")) } else { None },
      runs.len(),
    ).result,
    Err("the C compiler rejected `-c c.c`:\nbad"),
  );
  assert_eq(run_all_with(runs, |_: String| None, runs.len()).result, Ok(()))
}

test "a compiler that will not start stops the runs after it, and the runs it started are still waited on" {
  let r = run_all_with([["-c", "a.c"], ["-c", "b.c"], ["-c", "c.c"]], |_: String| None, 1);
  assert_eq(r.calls, ["start a.c", "rejected b.c", "wait a.c"]);
  assert_eq(r.result, Err("the C compiler could not be started: no `cc` is installed"))
}

fn probe_with(
  cache_sources: Bool,
  start: Result<Int, String>,
  compiler_output: Option<Bytes>,
) -> { fits: Bool, runs: List<List<String>> } / {abort.raise} =
  handle {
    targets_x86_64_linux[cc]()
  } with {
    var runs: List<List<String>> = [],
    compilers.start[cc](args) -> {
      runs = runs.push(args);
      start
    },
    compilers.wait[cc](job) -> compiler_output,
    toolchain.cache() -> "/cache",
    toolchain.exists(path) -> false,
    toolchain.write_file(path, bytes) -> cache_sources,
    toolchain.reuse_dir() -> panic("the compiler check does not use the reuse directory"),
    toolchain.bodies_dir() -> panic("the compiler check does not use the bodies directory"),
    toolchain.read_file(path) -> panic("the compiler check does not read files"),
    toolchain.libraries() -> panic("the compiler check does not link libraries"),
    toolchain.rename(from, to) -> panic("the compiler check does not rename files"),
    toolchain.append(path, bytes) -> panic("the compiler check does not append to files"),
    toolchain.temp_dir() -> panic("the compiler check does not create a temporary directory"),
    toolchain.remove_tree(dir) -> panic("the compiler check does not remove directories"),
    toolchain.run(path, args) -> panic("the compiler check does not run programs"),
    return fits -> { fits: fits, runs: runs },
  }

test "a compiler is usable for x86-64 Linux only if it preprocesses the target-detection file successfully" {
  let fits = probe_with(true, Ok(0), None);
  assert(fits.fits, None);
  assert_eq(fits.runs, [["-E", "/cache/probe/x86_64_linux.c"]]);
  assert(!probe_with(true, Ok(0), Some(b"x86_64_linux.c:2: error: #error")).fits, None);
  assert(!probe_with(true, Err("no `tcc` is installed"), None).fits, None);
  let uncached = probe_with(false, Ok(0), None);
  assert(!uncached.fits, None);
  assert_eq(uncached.runs, [])
}

fn in_test_cache(path: String) -> String / {abort.raise} = path.slice("/cache/".len(), path.len())

fn fake_build<a>(
  initial_files: Map<String, Bytes>,
  build: () -> a / {compilers.read[cc], compilers.write[cc], toolchain.read, toolchain.write, abort.raise},
) -> { made: a, written: List<String>, runs: List<List<String>>, files: Map<String, Bytes> } / {abort.raise} =
  handle {
    build()
  } with {
    var files: Map<String, Bytes> = initial_files,
    var written: List<String> = [],
    var runs: List<List<String>> = [],
    compilers.find[cc]() -> Some({ path: "cc", identity: b"cc 1", support_flags: [] }),
    compilers.start[cc](args) -> {
      runs = runs.push(args);
      files = match args.index_of("-o") {
        Some(i) -> files.insert(in_test_cache(args.get(i + 1)), b"compiled"),
        None -> files,
      };
      Ok(runs.len() - 1)
    },
    compilers.wait[cc](job) -> None,
    toolchain.cache() -> "/cache",
    toolchain.exists(path) -> files.contains(path),
    toolchain.read_file(path) -> files.get(path),
    toolchain.write_file(path, bytes) -> {
      written = written.push(path);
      files = files.insert(path, bytes);
      true
    },
    toolchain.rename(from, to) -> match files.get(from) {
      None -> false,
      Some(bytes) -> {
        files = files.remove(from).insert(to, bytes);
        true
      },
    },
    toolchain.temp_dir() -> Some("work"),
    toolchain.remove_tree(dir) -> (),
    toolchain.reuse_dir() -> panic("a build reads no store"),
    toolchain.bodies_dir() -> panic("a build reads no store"),
    toolchain.libraries() -> panic("a build links nothing"),
    toolchain.append(path, bytes) -> panic("a build appends nothing"),
    toolchain.run(path, args) -> panic("a build runs no program"),
    return made -> { made: made, written: written, runs: runs, files: files },
  }

test "a build compiles each part whose object is not cached, including a part whose C must be read back from the cache" {
  let t = toolchain_of({ path: "cc", identity: b"cc 1", support_flags: [] }, "-O2", false);
  let head = b"#include <x>\n";
  let fresh = [written_part(head, "a", b"int a;\n"), written_part(head, "a", b"int b;\n")];
  let built = written_part(head, "c", b"int c;\n");
  let taken = { ..written_part(head, "d", b"int d;\n"), text: None };
  let cached_files = Map::new().insert(source_path(taken.digest), head.concat(b"int d;\n")).insert(
    object_path(t, [], { label: built.label, digest: built.digest }),
    b"compiled",
  );
  let build = ||
    match cache_sources(head, fresh.push(built).push(taken)) {
      Err(reason) -> Err(reason),
      Ok(sources) -> objects[cc](t, sources, [], "work"),
    };
  let first = fake_build(cached_files, build);
  let input = |w: WrittenPart| Some("/cache/" ++ source_path(w.digest));
  assert_eq(first.written, fresh.push(built).map(|w: WrittenPart| source_path(w.digest)));
  assert_eq(first.runs.map(|run: List<String>| run.last()), fresh.push(taken).map(input));
  let again = fake_build(first.files, build);
  let paths = |r: Result<Objects, String>| r.map(|o: Objects| o.paths);
  assert_eq(paths(again.made), paths(first.made));
  assert_eq(again.runs, []);
  assert_eq(again.written, []);
  let lost = { label: taken.label, digest: taken.digest };
  assert(fake_build(Map::new(), || objects[cc](t, [lost], [], "work")).made.is_err(), None)
}

test "building the same C text a second time with the cache populated starts no compiler and writes no files" {
  let compiled = ||
    match cache_text(unit_text()) {
      Err(reason) -> Err(reason),
      Ok(sources) -> library[cc](development(), sources),
    };
  let first = fake_build(Map::new(), compiled);
  assert(first.made.is_ok(), None);
  let again = fake_build(first.files, compiled);
  assert_eq(again.made, first.made);
  assert_eq(again.runs, []);
  assert_eq(again.written, [])
}

test "`cache_sources` writes the C of each new part, reuses the C of parts already cached, and fails when a needed cached part is missing" {
  let fresh = { label: "a", digest: "aa", size: 2, text: Some(b"a\n") };
  let beside = { label: "c", digest: "cc", size: 2, text: Some(b"c\n") };
  let taken = { label: "b", digest: "bb", size: 9, text: None };
  let r = fake_build(Map::new().insert("src/bb.c", b"h\nb\n"), ||
    cache_sources(b"h\n", [fresh, beside, taken]));
  assert_eq(r.made.map(|sources: List<Source>| sources.map(source_label)), Ok(["b", "a", "c"]));
  assert_eq(r.written, ["src/aa.c", "src/cc.c"]);
  assert(fake_build(Map::new(), || cache_sources(b"h\n", [fresh, taken])).made.is_err(), None)
}

test "`read_back` rebuilds a C text from the cached part files and writes nothing, and fails when a cached file is missing" {
  let cut = split(unit_text());
  let first = fake_build(Map::new(), || cache_sources(cut.head, cut.parts));
  let sources = first.made.expect("the parts are kept");
  let again = fake_build(first.files, ||
    match read_back(cut.head, sources) {
      Err(reason) -> Err(reason),
      Ok(back) -> cache_text(back).map(|s: List<Source>| { back: back, sources: s }),
    });
  match again.made {
    Err(reason) -> panic(reason),
    Ok(r) -> {
      assert_eq(r.sources, sources);
      assert_eq(again.written, []);
      let back = split(r.back);
      assert_eq(back.parts.map(part_label), sources.map(source_label));
      assert_eq(back.parts.sort_by_key(part_label), cut.parts.sort_by_key(part_label))
    },
  };
  assert(fake_build(Map::new(), || read_back(cut.head, sources)).made.is_err(), None)
}

fn elf_of(machine: Int, headers: Bytes, count: Int) -> Bytes / {abort.raise} =
  Bytes::concat_all([
    b"\x7FELF\x02\x01",
    b"\x00".repeat(12),
    little_endian_bytes(machine, 2),
    b"\x00".repeat(12),
    little_endian_bytes(64, 8),
    b"\x00".repeat(14),
    little_endian_bytes(56, 2),
    little_endian_bytes(count, 2),
    b"\x00".repeat(6),
    headers,
  ])

test "`with_stack_header` adds a `PT_GNU_STACK` program header to a library without one and returns a library with one unchanged" {
  let load = little_endian_bytes(1, 4).concat(b"\x00".repeat(52));
  let marked = with_stack_header(elf_of(0, load, 1).concat(b"body"));
  assert_eq(marked.len(), 128 + 2 * 56);
  assert_eq(read_little_endian(marked, 32, 8), 128);
  assert_eq(read_little_endian(marked, 56, 2), 2);
  assert_eq(marked.slice(120, 124), b"body");
  assert_eq(marked.slice(128, 184), load);
  assert_eq(read_little_endian(marked, 184, 4), pt_gnu_stack());
  assert_eq(read_little_endian(marked, 188, 4), 6);
  assert_eq(with_stack_header(marked), marked)
}

test "what is not a 64-bit little-endian ELF file is left as it is" {
  assert_eq(
    with_stack_header(b"\xCF\xFA\xED\xFE a Mach-O library"),
    b"\xCF\xFA\xED\xFE a Mach-O library",
  );
  let big_endian = b"\x7FELF\x02\x02".concat(b"\x00".repeat(120));
  assert_eq(with_stack_header(big_endian), big_endian)
}
