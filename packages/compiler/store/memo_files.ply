import std.bin
import std.fs
import std.fs (fs)
import std.list
import compiler.store.fact_store
import compiler.store.fact_store (Database, Dependents, Facts, Inputs, Codes, Records, fact_damage,
                                  recent_reads, with_recent_reads)
import compiler.store.memo
import compiler.store.memo (ExternalInput, FactDetails, PackBuild, StoredFact, StoredInput, Waiting,
                            deferred_kind, empty_pack_build, fact_details_bin, finished_pack,
                            first_waiting, in_session, is_inline, location_id, lowest_waiting,
                            main_part, memo, memo_store, nothing_left_waiting, nothing_waiting,
                            query, sealed_lookup, sealed_record_of, fixed_digest, input_id,
                            session_input, session_inputs, stored_fact_bin, stored_input_bin,
                            with_mark, with_packed_fact, with_session_inputs, without_mark)
import compiler.store.packs
import compiler.store.segments
import compiler.store.segments (Committed, LockHeld, StoreChanged, WriteFailed)

type StoreRun = {
  db: Database,
  outputs: Map<Bytes, Bytes>,
  outputs_size: Int,
  details: Map<Bytes, FactDetails>,
  transient: Map<Bytes, Bytes>,
  dependent_counts: Map<Bytes, Int>,
  pack: packs::PackReader,
  trusted: Bool,
  pack_differs: Bool,
  waiting: Waiting,
  changes: List<Bytes>,
  edited: Bool,
  kinds_read: Map<Bytes, Int>,
}

const max_cached_size: Int = 268435456

const pack_id_name: Bytes = b"\x00pack"

fn cursor_name(kind: Bytes) -> Bytes = b"\x00products read the log up to ".concat(kind)

fn int_bytes(n: Int) -> Bytes / {abort.raise} = bin::encode(n, bin::int_bin())

fn code_key(name: Bytes) -> Bytes = name.blake3()

fn result_key(digest: Bytes) -> Bytes =
  match packs::output_key(digest) { Some(k) -> k, None -> digest }

fn undecoded<a>(bytes: Bytes, codec: bin::BinCodec<a>) -> a / {fact_damage.damaged, abort.raise} =
  match bin::decode(bytes, codec) {
    Ok(value) -> value,
    Err(_) -> fact_damage.damaged("a stored fact does not decode"),
  }

fn moved_count(counts: Map<Bytes, Int>, key: Bytes, by: Int) -> Map<Bytes, Int> =
  match counts.get(key) { Some(n) -> counts.insert(key, n + by), None -> counts }

fn remembered_output(o: StoreRun, digest: Bytes, output: Bytes) -> StoreRun =
  if o.outputs.contains(digest) || o.outputs_size + output.len() > max_cached_size { o } else {
    { ..o, outputs: o.outputs.insert(digest, output), outputs_size: o.outputs_size + output.len() }
  }

fn stored_output<[r]>(
  o: StoreRun,
  digest: Bytes,
  output: Bytes,
) -> StoreRun / {fs.read[r], fs.write[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  {
    ..remembered_output(o, digest, output),
    db: fact_store::with_result[r](o.db, result_key(digest), output),
  }

fn results_of_facts(
  found: Map<Bytes, Bool>,
  values: List<Bytes>,
) -> Map<Bytes, Bool> / {abort.raise} =
  values.fold(found, |live: Map<Bytes, Bool>, b: Bytes|
    match bin::decode(b, stored_fact_bin()) {
      Ok(f) ->
        f.parts.fold(
          live.insert(f.details, true),
          |l: Map<Bytes, Bool>, _: Bytes, digest: Bytes| l.insert(result_key(digest), true),
        ),
      Err(_) -> live,
    })

fn live_results<[r]>(
  db: Database,
) -> Map<Bytes, Bool> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  fact_store::entries_under[r](db, Inputs, b"").values().fold(
    results_of_facts(Map::new(), fact_store::entries_under[r](db, Facts, b"").values()),
    |live: Map<Bytes, Bool>, b: Bytes| {
      match fixed_digest(undecoded(b, stored_input_bin())) {
        Some(d) -> live.insert(result_key(d), true),
        None -> live,
      }
    },
  )

fn fixed_input<[r]>(
  db: Database,
  id: Bytes,
) -> Option<Bytes> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  match fact_store::value_of[r](db, Inputs, id) {
    Some(b) -> { fixed_digest(undecoded(b, stored_input_bin())) },
    None -> None,
  }

fn cursor_of<[r]>(
  db: Database,
  kind: Bytes,
) -> Option<Int> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  match fact_store::value_of[r](db, Codes, code_key(cursor_name(kind))) {
    Some(b) -> Some(undecoded(b, bin::int_bin())),
    None -> None,
  }

fn lowest_cursor<[r]>(
  db: Database,
  kinds: List<Bytes>,
) -> Int / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  kinds.fold(fact_store::log_end(db), |lowest: Int, kind: Bytes|
    match cursor_of[r](db, kind) { Some(at) -> min(lowest, at), None -> lowest })

fn over_database<a, [r] | e>(
  database: Database,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_store.read, memo_store.write, abort.raise},
) -> a / {fs.read[r], fs.write[r], recent_reads.read, recent_reads.write, fact_damage.damaged, session_inputs.read, session_inputs.write, abort.raise | e} = {
  let looked = |db: Database, kind: Bytes, at: Bytes| {
    let id = location_id(kind, at);
    session_input(id, ||
      match fixed_input[r](db, id) {
        Some(d) -> fact_store::result_of[r](db, result_key(d)),
        None -> look(kind, at),
      })
  };
  handle {
    work()
  } with {
    var st: StoreRun = {
      db: database,
      outputs: Map::new(),
      outputs_size: 0,
      details: Map::new(),
      transient: Map::new(),
      dependent_counts: Map::new(),
      pack: packs::open_reader(read),
      trusted: false,
      pack_differs: false,
      waiting: nothing_waiting,
      changes: [],
      edited: false,
      kinds_read: Map::new(),
    },
    memo_store.fact(key) -> match fact_store::value_of[r](st.db, Facts, key) {
      Some(b) -> Some(undecoded(b, stored_fact_bin())),
      None -> None,
    },
    memo_store.details(digest) -> match st.details.get(digest) {
      Some(d) -> Some(d),
      None -> match fact_store::result_of[r](st.db, digest) {
        None -> None,
        Some(b) -> {
          let d = undecoded(b, fact_details_bin());
          st = { ..st, details: st.details.insert(digest, d) };
          Some(d)
        },
      },
    },
    memo_store.output(digest) -> match st.outputs.get(digest) {
      Some(o) -> Some(o),
      None -> match st.transient.get(digest) {
        Some(o) -> Some(o),
        None -> match fact_store::result_of[r](st.db, result_key(digest)) {
          Some(o) -> {
            st = remembered_output(st, digest, o);
            Some(o)
          },
          None -> if !st.trusted { None } else {
            let found = packs::output(st.pack, read, digest);
            st = { ..st, pack: found.reading };
            found.bytes
          },
        },
      },
    },
    memo_store.sealed(key) -> if !st.trusted { None } else {
      let found = sealed_lookup(st.pack, read, key);
      st = { ..st, pack: found.reading };
      match match found.record { Some(b) -> sealed_record_of(b), None -> None } {
        None -> None,
        Some(r) -> {
          st = {
            ..st,
            transient: r.inline.fold(
              st.transient,
              |t: Map<Bytes, Bytes>, digest: Bytes, o: Bytes| t.insert(digest, o),
            ),
          };
          Some(r.parts)
        },
      }
    },
    memo_store.sealed_changed() -> st.pack_differs,
    memo_store.dependents(key) -> fact_store::members[r](st.db, Dependents, key),
    memo_store.has_dependents(key) -> {
      let count = match st.dependent_counts.get(key) {
        Some(n) -> n,
        None -> fact_store::members[r](st.db, Dependents, key).len(),
      };
      st = { ..st, dependent_counts: st.dependent_counts.insert(key, count) };
      count > 0
    },
    memo_store.inputs() ->
      fact_store::entries_under[r](st.db, Inputs, b"").values().map(|b: Bytes|
        undecoded(b, stored_input_bin())),
    memo_store.facts_of(prefix) -> fact_store::entries_under[r](st.db, Facts, prefix).keys(),
    memo_store.code(name) -> fact_store::value_of[r](st.db, Codes, code_key(name)),
    memo_store.external(kind, at) -> looked(st.db, kind, at),
    memo_store.is_out_of_date(key) -> st.waiting.depths.contains(key),
    memo_store.next_out_of_date() -> first_waiting(st.waiting),
    memo_store.out_of_date_level() -> lowest_waiting(st.waiting),
    memo_store.put(key, fact, _, encoded_details, outputs, lasting) -> {
      let stored = outputs.fold(st, |o: StoreRun, digest: Bytes, output: Bytes|
        if lasting || is_inline(output) { stored_output[r](o, digest, output) }
        else { { ..o, transient: o.transient.insert(digest, output) } });
      st = {
        ..stored,
        db: fact_store::with_value(
          fact_store::with_result[r](stored.db, fact.details, encoded_details),
          Facts,
          key,
          bin::encode(fact, stored_fact_bin()),
        ),
      };
    },
    memo_store.keep_output(digest, output, lasting) -> {
      st = if lasting { stored_output[r](st, digest, output) }
      else { { ..st, transient: st.transient.insert(digest, output) } };
    },
    memo_store.delete(key) -> {
      st = {
        ..st,
        waiting: without_mark(st.waiting, key),
        db: fact_store::without_value(st.db, Facts, key),
      };
    },
    memo_store.add_dependent(key, dependent) -> {
      st = {
        ..st,
        dependent_counts: moved_count(st.dependent_counts, key, 1),
        db: fact_store::add_member(st.db, Dependents, key, dependent),
      };
    },
    memo_store.remove_dependent(key, dependent) -> {
      st = {
        ..st,
        dependent_counts: moved_count(st.dependent_counts, key, -1),
        db: fact_store::remove_member(st.db, Dependents, key, dependent),
      };
    },
    memo_store.put_input(input) -> {
      let id = input_id(input);
      let encoded = bin::encode(input, stored_input_bin());
      let held = fact_store::value_of[r](st.db, Inputs, id);
      if held != Some(encoded) && fixed_input[r](st.db, id) == None {
        st = { ..st, db: fact_store::with_value(st.db, Inputs, id, encoded) };
      };
    },
    memo_store.fix_input(kind, at) -> {
      let id = location_id(kind, at);
      match if fixed_input[r](st.db, id) == None { session_inputs.held(id) } else { None } {
        Some({ value: Some(v), digest: d }) -> {
          let stored = stored_output[r](st, d, v);
          st = {
            ..stored,
            db: fact_store::with_value(
              stored.db,
              Inputs,
              id,
              bin::encode(
                ExternalInput({ kind: kind, at: at, digest: d, fixed: true }),
                stored_input_bin(),
              ),
            ),
          };
        },
        _ -> (),
      };
    },
    memo_store.delete_input(id) -> {
      if fact_store::value_of[r](st.db, Inputs, id) != None {
        st = { ..st, db: fact_store::without_value(st.db, Inputs, id) };
      };
    },
    memo_store.put_code(name, hash) -> {
      st = { ..st, db: fact_store::with_value(st.db, Codes, code_key(name), hash) };
    },
    memo_store.mark_out_of_date(key, depth) -> {
      st = { ..st, waiting: with_mark(st.waiting, key, depth) };
    },
    memo_store.settle(key) -> {
      st = { ..st, waiting: without_mark(st.waiting, key) };
    },
    memo_store.log_change(key) -> {
      st = { ..st, changes: st.changes.push(key) };
    },
    memo_store.note_edit() -> {
      st = { ..st, edited: true };
    },
    memo_store.deferred_kind(key) -> deferred_kind(st.waiting, key),
    memo_store.defer_products(kinds) -> {
      st = { ..st, waiting: { ..st.waiting, products: kinds } };
    },
    memo_store.push_products(kind) -> {
      st = { ..st, waiting: { ..st.waiting, pushing: st.waiting.pushing.insert(kind, true) } };
    },
    memo_store.logged_changes(kind) -> match cursor_of[r](st.db, kind) {
      None -> [],
      Some(at) ->
        fact_store::changes_after[r](st.db, at).fold(
          st.changes,
          |keys: List<Bytes>, entry: fact_store::LogEntry| keys.concat(entry.changes),
        ),
    },
    memo_store.log_read(kind) -> {
      st = { ..st, kinds_read: st.kinds_read.insert(kind, st.changes.len()) };
    },
    memo_store.running(id) -> {
      let trusted = match st.pack.index {
        Some(i) -> packs::is_trusted(i, id, world),
        None -> false,
      };
      let pack_id = if trusted { id.concat(world).blake3() } else { b"" };
      let was = fact_store::value_of[r](st.db, Codes, code_key(pack_id_name));
      st = {
        ..st,
        trusted: trusted,
        pack_differs: was != Some(pack_id),
        db: if was == Some(pack_id) { st.db }
        else { fact_store::with_value(st.db, Codes, code_key(pack_id_name), pack_id) },
      };
    },
    return value -> {
      nothing_left_waiting(st.waiting);
      let logged = if st.edited || st.changes.len() > 0 {
        fact_store::append_change(st.db, st.changes)
      } else { st.db };
      let before = fact_store::log_end(st.db);
      let read_kinds = st.kinds_read.fold(logged, |db: Database, kind: Bytes, changes_seen: Int|
        fact_store::with_value(
          db,
          Codes,
          code_key(cursor_name(kind)),
          int_bytes(if changes_seen == st.changes.len() { fact_store::log_end(logged) }
          else { before }),
        ));
      fact_store::commit[r](
        fact_store::with_log_floor(
          read_kinds,
          lowest_cursor[r](read_kinds, st.waiting.products.values().unique()),
        ),
        |current: Database| live_results[r](current),
      );
      value
    },
  }
}

pub type StoreOutcome<a> = { value: a, damage: Option<String> }

pub const unreadable_manifest: String = "its manifest does not read"

pub fn with_memo_store<a, [r] | e>(
  dir: String,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_store.read, memo_store.write, abort.raise},
) -> StoreOutcome<a> / {fs.read[r], fs.write[r], abort.raise | e} =
  with_recent_reads(|| {
    let db = fact_store::open[r](dir);
    let run = with_session_inputs(|| {
      let first = handle {
        Ok(over_database[r](db, read, world, look, work))
      } with {
        fact_damage.damaged(reason) -> Err(reason),
      };
      match first {
        Ok(v) -> { value: v, damage: if db.garbled { Some(unreadable_manifest) } else { None } },
        Err(reason) ->
          {
            value: fact_store::undamaged(||
              over_database[r](fact_store::emptied(db), read, world, look, work)),
            damage: Some(reason),
          },
      }
    });
    fact_store::close[r](db);
    run
  })

pub fn database_in(cache_dir: String) -> String = cache_dir ++ "/memo"

pub fn records<[r]>(dir: String) -> Result<Map<Bytes, Bytes>, String> / {fs.read[r], abort.raise} =
  with_recent_reads(||
    handle {
      let db = fact_store::read_only[r](dir);
      if db.garbled { Err(unreadable_manifest) }
      else { Ok(fact_store::entries_under[r](db, Records, b"")) }
    } with {
      fact_damage.damaged(reason) -> Err(reason),
    })

pub fn records_written<[r]>(
  dir: String,
  puts: Map<Bytes, Bytes>,
  deleted: Map<Bytes, Bool>,
) -> Result<Unit, String> / {fs.read[r], fs.write[r], abort.raise} =
  with_recent_reads(||
    handle {
      let db = fact_store::open[r](dir);
      let written = puts.fold(
        deleted.fold(db, |d: Database, key: Bytes, _: Bool|
          fact_store::without_value(d, Records, key)),
        |d: Database, key: Bytes, value: Bytes| fact_store::with_value(d, Records, key, value),
      );
      let outcome = fact_store::commit[r](written, |current: Database| live_results[r](current));
      fact_store::close[r](db);
      match outcome {
        Committed(_) -> Ok(()),
        LockHeld -> Err("another `ply` was writing the store"),
        StoreChanged -> Err("another `ply` changed the store at the same time"),
        WriteFailed -> Err("the store could not be written"),
      }
    } with {
      fact_damage.damaged(reason) -> Err("the store is damaged (" ++ reason ++ ")"),
    })

pub fn copy_database<[r]>(from: String, to: String) -> Unit / {fs.read[r], fs.write[r]} = {
  fs.create_dir[r](to);
  (match fs::listed_names(fs.list_dir[r](from)) { Some(names) -> names, None -> [] }).filter(
    |name: String| name.starts_with("seg-") || name.starts_with("manifest-"),
  ).fold((), |_: Unit, name: String|
    match fs.read_file[r](from ++ "/" ++ name) {
      Some(bytes) -> {
        fs.write_file[r](to ++ "/" ++ name, bytes);
        ()
      },
      None -> (),
    })
}

pub type KindUsage = { query: Bytes, facts: Int, bytes: Int }

pub type Usage = {
  records: Int,
  results: Int,
  output_bytes: Int,
  kinds: List<KindUsage>,
  segments: Int,
  bytes: Int,
}

fn with_fact_of_kind<[r]>(
  db: Database,
  kinds: Map<Bytes, KindUsage>,
  fact: StoredFact,
) -> Map<Bytes, KindUsage> / {fs.read[r], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  match fact_store::result_of[r](db, fact.details) {
    None -> kinds,
    Some(b) -> {
      let name = undecoded(b, fact_details_bin()).query;
      let size = fact.parts.fold(0, |n: Int, _: Bytes, digest: Bytes|
        n + fact_store::stored_result_size[r](db, result_key(digest)).unwrap_or(0));
      let was = match kinds.get(name) { Some(k) -> k, None -> { query: name, facts: 0, bytes: 0 } };
      kinds.insert(name, { ..was, facts: was.facts + 1, bytes: was.bytes + size })
    },
  }

pub fn usage<[r]>(dir: String) -> Usage / {fs.read[r], abort.raise} =
  with_recent_reads(||
    fact_store::undamaged(|| {
      let db = fact_store::read_only[r](dir);
      let size = fact_store::store_size(db);
      let facts = fact_store::entries_under[r](db, Facts, b"").values();
      let kinds = facts.fold(Map::new(), |found: Map<Bytes, KindUsage>, b: Bytes|
        with_fact_of_kind[r](db, found, undecoded(b, stored_fact_bin())));
      let output_bytes = kinds.fold(0, |n: Int, _: Bytes, k: KindUsage| n + k.bytes);
      {
        records: facts.len(),
        results: live_results[r](db).len(),
        output_bytes: output_bytes,
        kinds: kinds.values(),
        segments: size.segments,
        bytes: size.bytes,
      }
    }))

pub fn outputs_by_digest<[r]>(
  dir: String,
  digests: List<Bytes>,
) -> Map<Bytes, Bytes> / {fs.read[r], abort.raise} =
  with_recent_reads(||
    fact_store::undamaged(|| {
      let db = fact_store::read_only[r](dir);
      digests.fold(Map::new(), |found: Map<Bytes, Bytes>, digest: Bytes|
        match fact_store::result_of[r](db, result_key(digest)) {
          Some(output) -> found.insert(digest, output),
          None -> found,
        })
    }))

pub fn write_pack<[r]>(
  from: String,
  keys: List<Bytes>,
  queries: Bytes,
  files: Bytes,
) -> { written: packs::PackFiles, records: Int } / {fs.read[r], abort.raise} =
  with_recent_reads(||
    fact_store::undamaged(|| {
      let db = fact_store::read_only[r](from);
      let laid = keys.fold(empty_pack_build, |built: PackBuild, key: Bytes|
        match fact_store::value_of[r](db, Facts, key) {
          None -> built,
          Some(b) ->
            with_packed_fact(built, key, undecoded(b, stored_fact_bin()), |digest: Bytes|
              fact_store::result_of[r](db, result_key(digest))),
        });
      { written: finished_pack(laid, queries, files), records: laid.records.len() }
    }))

fn quoted(input: Bytes) -> Bytes / {memo.read, abort.raise} =
  match memo.fetch(b"text", input, main_part) {
    Some(text) -> Bytes::concat_all([b"\"", text, b"\""]),
    None -> panic("the text query returned no main part"),
  }

fn test_queries() -> memo::Queries<| {}> =
  memo::plain_queries(
    Map::new().insert(b"text", query(b"text", b"t1", memo::read_file)).insert(
      b"quoted",
      query(b"quoted", b"q1", quoted),
    ),
  )

fn quoted_in<[r]>(
  checkout: String,
  text: Bytes,
) -> { output: Bytes, ran: Int } / {fs.read[r], fs.write[r], abort.raise} = {
  let queries = test_queries();
  with_memo_store[r](checkout, packs::no_pack, b"", |_: Bytes, _: Bytes| Some(text), ||
    in_session(queries, |run: memo::Run| {
      let a = memo::query_output(queries, run, b"quoted", b"a");
      { run: a.run, value: { output: a.output, ran: memo::executed_count(a.run) } }
    })).value
}

fn quoted_over<[r]>(
  text: Bytes,
) -> { output: Bytes, ran: Int } / {fs.read[r], fs.write[r], abort.raise} = quoted_in[r]("s", text)

fn stored_names(tree: fs::MemFs) -> List<String> / {abort.raise} =
  match fs::listed_names(fs::mem_list(tree, "s")) { Some(names) -> names, None -> [] }

test "a run interrupted after any number of writes leaves a store from which the next run returns what a run on a fresh store returns" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  assert_eq(first.value.output, b"\"four\"");
  iterate(0, 1000, |n: Int| {
    let died = fs::on_mem_failing[abs](first.tree, n, || quoted_over[abs](b"forty"));
    assert_eq(fs::on_mem[abs](died.tree, || quoted_over[abs](b"forty")).value.output, b"\"forty\"");
    if fs::on_mem[abs](died.tree, || quoted_over[abs](b"forty")).value.ran == 0 { Stop(()) }
    else { Continue(n + 1) }
  })
}

test "a run that finds no change runs no query and writes nothing but its own run directory" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  let again = fs::on_mem[abs](first.tree, || quoted_over[abs](b"four"));
  assert_eq(again.value, { output: b"\"four\"", ran: 0 });
  assert_eq(stored_names(again.tree), stored_names(first.tree))
}

test "a query's digest and result survive a reopen, and an edit reruns what depends on it" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  let moved = fs::on_mem[abs](first.tree, || quoted_over[abs](b"forty"));
  assert_eq(moved.value, { output: b"\"forty\"", ran: 2 });
  assert_eq(fs::on_mem[abs](moved.tree, || quoted_over[abs](b"forty")).value.ran, 0)
}

fn read_then_saved<[r]>(
  path: String,
  saved: Option<Bytes>,
) -> Option<Bytes> / {fs.read[r], fs.write[r]} = {
  let found = fs.read_file[r](path);
  match saved {
    Some(bytes) -> {
      fs.write_file[r](path, bytes);
      ()
    },
    None -> (),
  };
  found
}

fn session_over_files<[r]>(
  saved: Option<Bytes>,
  name: Bytes,
) -> StoreOutcome<Bytes> / {fs.read[r], fs.write[r], abort.raise} = {
  let queries = test_queries();
  with_memo_store[r](
    "s",
    packs::no_pack,
    b"",
    |_: Bytes, at: Bytes| read_then_saved[r]("files/" ++ String::of_bytes_lossy(at), saved),
    ||
      in_session(queries, |run: memo::Run| {
        let a = memo::query_output(queries, run, name, b"a");
        { run: a.run, value: a.output }
      }),
  )
}

test "a session uses the bytes it compared at its start, so a file saved after that read waits for the next command" {
  let first = fs::on_mem[abs](fs::mem_of([{ path: "files/a", body: b"four" }]), ||
    session_over_files[abs](None, b"quoted"));
  let edited = fs::on_mem[abs](first.tree, || {
    fs.write_file[abs]("files/a", b"forty");
    session_over_files[abs](Some(b"FORTY"), b"quoted")
  });
  let next = fs::on_mem[abs](edited.tree, || session_over_files[abs](None, b"quoted"));
  assert_eq([first.value.value, edited.value.value, next.value.value], [
    b"\"four\"",
    b"\"forty\"",
    b"\"FORTY\"",
  ])
}

test "a stored value that fails its checksum makes the run start over from nothing" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  let segment = stored_names(first.tree).filter(|n: String| n.starts_with("seg-")).get(0);
  let torn = fs::on_mem[abs](first.tree, || {
    fs.write_file[abs]("s/" ++ segment, b"not a segment");
    quoted_over[abs](b"four")
  });
  assert_eq(torn.value.output, b"\"four\"")
}

test "records survive a reopen beside the facts, and a dropped record is gone" {
  let facts = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  let written = fs::on_mem[abs](facts.tree, ||
    records_written[abs]("s", Map::new().insert(b"a", b"1").insert(b"b", b"2"), Map::new()));
  let dropped = fs::on_mem[abs](written.tree, ||
    records_written[abs]("s", Map::new(), Map::new().insert(b"a", true)));
  assert_eq(
    fs::on_mem[abs](dropped.tree, || records[abs]("s")).value,
    Ok(Map::new().insert(b"b", b"2")),
  );
  assert_eq(fs::on_mem[abs](dropped.tree, || quoted_over[abs](b"four")).value.ran, 0)
}
test "a copied database is correct for its new place, and an edit there runs what it changes" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_in[abs]("one", b"four"));
  assert_eq(first.value.ran, 2);
  let copied = fs::on_mem[abs](first.tree, || {
    copy_database[abs]("one", "two");
    quoted_in[abs]("two", b"four")
  });
  assert_eq(copied.value, { output: b"\"four\"", ran: 0 });
  assert_eq(fs::on_mem[abs](copied.tree, || quoted_in[abs]("two", b"forty")).value.ran, 2)
}

test "two checkouts share nothing, so an edit in one leaves the other's results in place" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_in[abs]("one", b"four"));
  let other = fs::on_mem[abs](first.tree, || quoted_in[abs]("two", b"forty"));
  assert_eq(fs::on_mem[abs](other.tree, || quoted_in[abs]("one", b"four")).value.ran, 0)
}

test "a pack holds the facts of the keys it is built from, and a trusted run uses them with no query" {
  let queries = test_queries();
  let long = b"long ".repeat(1000);
  let keys = [b"text", b"quoted"].map(|name: Bytes| memo::fact_key(name, b"a"));
  let pack = fs::on_mem[abs](fs::mem_of([]), || {
    quoted_over[abs](long);
    write_pack[abs]("s", keys, memo::queries_id(queries), b"files")
  }).value;
  assert_eq(pack.records, 2);
  let used = fs::on_mem[abs](fs::mem_of([]), ||
    with_memo_store[abs](
      "s",
      |path: String, offset: Int, len: Int| packs::frame_in(Some(pack.written), path, offset, len),
      b"files",
      |_: Bytes, _: Bytes| None,
      ||
        in_session(queries, |run: memo::Run| {
          let a = memo::query_output(queries, run, b"quoted", b"a");
          { run: a.run, value: { output: a.output, ran: memo::executed_count(a.run) } }
        }),
    ));
  assert_eq(used.value.value, { output: Bytes::concat_all([b"\"", long, b"\""]), ran: 0 })
}
