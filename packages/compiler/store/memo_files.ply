import std.bin
import std.fs
import std.fs (fs)
import std.list
import compiler.store.fact_store
import compiler.store.fact_store (Database, Dependents, Facts, Past, Inputs, Codes, fact_damage,
                                  recent_reads, with_recent_reads)
import compiler.store.memo
import compiler.store.memo (FactDetails, StoredFact, StoredInput, Waiting, defers, digest_of,
                            fact_details_bin, first_waiting, inline_output, location_id, memo,
                            memo_store, nothing_waiting, pack_digest_of, pack_inline_of,
                            pack_record_bytes, pack_row_key, query, query_output, sealed_lookup,
                            start_run, stored_fact_bin, stored_input_bin, with_mark, without_mark)
import compiler.store.packs
import compiler.store.segments
import compiler.store.segments (Committed)

type StoreRun = {
  db: Database,
  shared: Database,
  looked: Map<Bytes, { value: Option<Bytes>, digest: Bytes }>,
  outputs: Map<Bytes, Bytes>,
  outputs_size: Int,
  details: Map<Bytes, FactDetails>,
  transient: Map<Bytes, Bytes>,
  dependent_counts: Map<Bytes, Int>,
  pack: packs::PackReader,
  trusted: Bool,
  pack_differs: Bool,
  waiting: Waiting,
  changes: List<Bytes>,
  edited: Bool,
}

fn max_cached_size() -> Int = 268435456

fn pack_id_name() -> Bytes = b"\x00pack"

fn cursor_name() -> Bytes = b"\x00products read the log up to"

fn int_bytes(n: Int) -> Bytes / {abort.raise} = bin::encode(n, bin::int_bin())

fn code_key(name: Bytes) -> Bytes = name.blake3()

fn result_key(digest: Bytes) -> Bytes =
  match packs::output_key(digest) { Some(k) -> k, None -> digest }

fn input_id(input: StoredInput) -> Bytes / {abort.raise} =
  if input.kind == b"sealed" { input.at } else { location_id(input.kind, input.at) }

fn undecoded<a>(bytes: Bytes, codec: bin::BinCodec<a>) -> a / {fact_damage.damaged, abort.raise} =
  match bin::decode(bytes, codec) {
    Ok(value) -> value,
    Err(_) -> fact_damage.damaged("a stored fact does not decode"),
  }

fn moved_count(counts: Map<Bytes, Int>, key: Bytes, by: Int) -> Map<Bytes, Int> =
  match counts.get(key) { Some(n) -> counts.insert(key, n + by), None -> counts }

fn remembered_output(o: StoreRun, digest: Bytes, output: Bytes) -> StoreRun =
  if o.outputs.contains(digest) || o.outputs_size + output.len() > max_cached_size() { o } else {
    { ..o, outputs: o.outputs.insert(digest, output), outputs_size: o.outputs_size + output.len() }
  }

fn stored_output<[s]>(
  o: StoreRun,
  digest: Bytes,
  output: Bytes,
) -> StoreRun / {fs.read[s], fs.write[s], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise} =
  {
    ..remembered_output(o, digest, output),
    shared: fact_store::with_result[s](o.shared, result_key(digest), output),
  }

fn results_of_facts(values: List<Bytes>) -> Map<Bytes, Bool> / {abort.raise} =
  values.fold(Map::new(), |found: Map<Bytes, Bool>, b: Bytes|
    match bin::decode(b, stored_fact_bin()) {
      Ok(f) -> found.insert(result_key(f.output), true).insert(f.details, true),
      Err(_) -> found,
    })

pub type Logged<a> = { value: a, log_position: Option<Int> }

fn over_database<a, [r], [s] | e>(
  database: Database,
  shared: Database,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_store.read, memo_store.write, abort.raise},
) -> Logged<a> / {fs.read[r], fs.write[r], fs.read[s], fs.write[s], recent_reads.read, recent_reads.write, fact_damage.damaged, abort.raise | e} = {
  let looked = |o: StoreRun, kind: Bytes, at: Bytes| {
    let id = location_id(kind, at);
    match o.looked.get(id) {
      Some(x) -> { open: o, looked: x },
      None -> {
        let value = look(kind, at);
        let x = { value: value, digest: digest_of(value) };
        { open: { ..o, looked: o.looked.insert(id, x) }, looked: x }
      },
    }
  };
  handle {
    work()
  } with {
    var st: StoreRun = {
      db: database,
      shared: shared,
      looked: Map::new(),
      outputs: Map::new(),
      outputs_size: 0,
      details: Map::new(),
      transient: Map::new(),
      dependent_counts: Map::new(),
      pack: packs::open_reader(read),
      trusted: false,
      pack_differs: false,
      waiting: nothing_waiting(),
      changes: [],
      edited: false,
    },
    memo_store.fact(key) -> match fact_store::value_of[r](st.db, Facts, key) {
      Some(b) -> Some(undecoded(b, stored_fact_bin())),
      None -> None,
    },
    memo_store.details(digest) -> match st.details.get(digest) {
      Some(d) -> Some(d),
      None -> match fact_store::result_of[s](st.shared, digest) {
        None -> None,
        Some(b) -> {
          let d = undecoded(b, fact_details_bin());
          st = { ..st, details: st.details.insert(digest, d) };
          Some(d)
        },
      },
    },
    memo_store.output(digest) -> match st.outputs.get(digest) {
      Some(o) -> Some(o),
      None -> match st.transient.get(digest) {
        Some(o) -> Some(o),
        None -> match fact_store::result_of[s](st.shared, result_key(digest)) {
          Some(o) -> {
            st = remembered_output(st, digest, o);
            Some(o)
          },
          None -> if !st.trusted { None } else {
            let found = packs::output(st.pack, read, digest);
            st = { ..st, pack: found.reading };
            found.bytes
          },
        },
      },
    },
    memo_store.sealed(key) -> if !st.trusted { None } else {
      let found = sealed_lookup(st.pack, read, key);
      st = { ..st, pack: found.reading };
      match found.record {
        None -> None,
        Some(b) -> {
          match pack_inline_of(b) {
            Some(o) -> {
              st = { ..st, transient: st.transient.insert(digest_of(Some(o)), o) };
            },
            None -> (),
          };
          pack_digest_of(b)
        },
      }
    },
    memo_store.sealed_changed() -> st.pack_differs,
    memo_store.dependents(key) -> fact_store::members[r](st.db, Dependents, key),
    memo_store.has_dependents(key) -> {
      let count = match st.dependent_counts.get(key) {
        Some(n) -> n,
        None -> fact_store::members[r](st.db, Dependents, key).len(),
      };
      st = { ..st, dependent_counts: st.dependent_counts.insert(key, count) };
      count > 0
    },
    memo_store.inputs() ->
      fact_store::entries_under[r](st.db, Inputs, b"").values().map(|b: Bytes|
        undecoded(b, stored_input_bin())),
    memo_store.facts_of(prefix) -> fact_store::entries_under[r](st.db, Facts, prefix).keys(),
    memo_store.code(name) -> fact_store::value_of[r](st.db, Codes, code_key(name)),
    memo_store.external(kind, at) -> {
      let l = looked(st, kind, at);
      st = l.open;
      l.looked.value
    },
    memo_store.external_digest(kind, at) -> {
      let l = looked(st, kind, at);
      st = l.open;
      l.looked.digest
    },
    memo_store.is_out_of_date(key) -> st.waiting.depths.contains(key),
    memo_store.past(key) ->
      [fact_store::value_of[r](st.db, Past, key), fact_store::shared_past[s](st.shared, key)].fold(
        [],
        |found: List<StoredFact>, stored: Option<Bytes>|
          match stored { Some(b) -> found.push(undecoded(b, stored_fact_bin())), None -> found },
      ),
    memo_store.keep_past(key, fact) -> {
      st = {
        ..st,
        db: fact_store::with_value(st.db, Past, key, bin::encode(fact, stored_fact_bin())),
      };
    },
    memo_store.put_fact(key, fact) -> {
      let encoded = bin::encode(fact, stored_fact_bin());
      st = {
        ..st,
        shared: if fact_store::shared_past[s](st.shared, key) == Some(encoded) { st.shared }
        else { fact_store::with_shared_past[s](st.shared, key, encoded) },
        db: fact_store::with_value(st.db, Facts, key, encoded),
      };
    },
    memo_store.next_out_of_date() -> first_waiting(st.waiting),
    memo_store.put(key, fact, details, output, lasting) -> {
      let persisted = lasting || inline_output(output) != None;
      let stored = if persisted { stored_output[s](st, fact.output, output) }
      else { { ..st, transient: st.transient.insert(fact.output, output) } };
      let encoded = bin::encode(fact, stored_fact_bin());
      st = {
        ..stored,
        details: stored.details.insert(fact.details, details),
        shared: fact_store::with_shared_past[s](
          fact_store::with_result[s](
            stored.shared,
            fact.details,
            bin::encode(details, fact_details_bin()),
          ),
          key,
          encoded,
        ),
        db: fact_store::with_value(stored.db, Facts, key, encoded),
      };
    },
    memo_store.keep_output(digest, output, lasting) -> {
      st = if lasting { stored_output[s](st, digest, output) }
      else { { ..st, transient: st.transient.insert(digest, output) } };
    },
    memo_store.delete(key) -> {
      st = {
        ..st,
        waiting: without_mark(st.waiting, key),
        db: fact_store::without_value(st.db, Facts, key),
      };
    },
    memo_store.add_dependent(key, dependent) -> {
      st = {
        ..st,
        dependent_counts: moved_count(st.dependent_counts, key, 1),
        db: fact_store::add_member(st.db, Dependents, key, dependent),
      };
    },
    memo_store.remove_dependent(key, dependent) -> {
      st = {
        ..st,
        dependent_counts: moved_count(st.dependent_counts, key, -1),
        db: fact_store::remove_member(st.db, Dependents, key, dependent),
      };
    },
    memo_store.put_input(input) -> {
      let id = input_id(input);
      let encoded = bin::encode(input, stored_input_bin());
      if fact_store::value_of[r](st.db, Inputs, id) != Some(encoded) {
        st = { ..st, db: fact_store::with_value(st.db, Inputs, id, encoded) };
      };
    },
    memo_store.put_code(name, hash) -> {
      st = { ..st, db: fact_store::with_value(st.db, Codes, code_key(name), hash) };
    },
    memo_store.mark_out_of_date(key, depth) -> {
      st = { ..st, waiting: with_mark(st.waiting, key, depth) };
    },
    memo_store.settle(key) -> {
      st = { ..st, waiting: without_mark(st.waiting, key) };
    },
    memo_store.log_change(key) -> {
      st = { ..st, changes: st.changes.push(key) };
    },
    memo_store.note_edit() -> {
      st = { ..st, edited: true };
    },
    memo_store.defers(key) -> defers(st.waiting, key),
    memo_store.defer_products(prefixes) -> {
      st = { ..st, waiting: { ..st.waiting, products: prefixes } };
    },
    memo_store.push_products(pushing) -> {
      st = { ..st, waiting: { ..st.waiting, pushing: pushing } };
    },
    memo_store.logged_changes() -> {
      let cursor = match fact_store::value_of[r](st.db, Codes, code_key(cursor_name())) {
        Some(b) -> undecoded(b, bin::int_bin()),
        None -> 0,
      };
      fact_store::changes_after[r](st.db, cursor).fold(
        st.changes,
        |keys: List<Bytes>, entry: fact_store::LogEntry| keys.concat(entry.changes),
      )
    },
    memo_store.log_read() -> {
      st = {
        ..st,
        changes: [],
        db: fact_store::with_value(
          st.db,
          Codes,
          code_key(cursor_name()),
          int_bytes(fact_store::log_end(st.db) + (if st.edited { 1 } else { 0 })),
        ),
      };
    },
    memo_store.running(id) -> {
      let trusted = match st.pack.index {
        Some(i) -> packs::is_trusted(i, id, world),
        None -> false,
      };
      let pack_id = if trusted { id.concat(world).blake3() } else { b"" };
      let was = fact_store::value_of[r](st.db, Codes, code_key(pack_id_name()));
      st = {
        ..st,
        trusted: trusted,
        pack_differs: was != Some(pack_id),
        db: if was == Some(pack_id) { st.db }
        else { fact_store::with_value(st.db, Codes, code_key(pack_id_name()), pack_id) },
      };
    },
    return value -> {
      fact_store::commit_shared[s](st.shared, results_of_facts);
      let logged = if st.edited || st.changes.len() > 0 {
        fact_store::append_change(st.db, st.changes)
      } else { st.db };
      let committed = fact_store::commit[r](
        fact_store::with_log_floor(
          logged,
          match fact_store::value_of[r](st.db, Codes, code_key(cursor_name())) {
            Some(b) -> undecoded(b, bin::int_bin()),
            None -> 0,
          },
        ),
        |_: Database| Map::new(),
      );
      {
        value: value,
        log_position: match committed {
          Committed(_) -> Some(fact_store::log_end(logged)),
          _ -> None,
        },
      }
    },
  }
}

pub fn with_logged_store<a, [r], [s] | e>(
  dir: String,
  shared_dir: String,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_store.read, memo_store.write, abort.raise},
) -> Logged<a> / {fs.read[r], fs.write[r], fs.read[s], fs.write[s], abort.raise | e} =
  with_recent_reads(|| {
    let db = fact_store::open[r](dir);
    let shared = fact_store::open[s](shared_dir);
    let first = handle {
      Some(over_database[r, s](db, shared, read, world, look, work))
    } with {
      fact_damage.damaged(_) -> None,
    };
    let value = match first {
      Some(v) -> v,
      None ->
        fact_store::undamaged(||
          over_database[r, s](
            fact_store::emptied(db),
            fact_store::emptied(shared),
            read,
            world,
            look,
            work,
          )),
    };
    fact_store::close[r](db);
    fact_store::close[s](shared);
    value
  })

pub fn with_memo_store<a, [r], [s] | e>(
  dir: String,
  shared_dir: String,
  read: (String, Int, Int) -> Option<Bytes> / {abort.raise | e},
  world: Bytes,
  look: (Bytes, Bytes) -> Option<Bytes> / {abort.raise | e},
  work: () -> a / {memo_store.read, memo_store.write, abort.raise},
) -> a / {fs.read[r], fs.write[r], fs.read[s], fs.write[s], abort.raise | e} =
  with_logged_store[r, s](dir, shared_dir, read, world, look, work).value

pub fn current_product<[r]>(
  dir: String,
  product: String,
) -> Option<Bytes> / {fs.read[r], abort.raise} =
  with_recent_reads(||
    handle {
      let db = fact_store::read_only[r](dir);
      match fact_store::stored_product[r](db, product) {
        Some(stored) -> if stored.at == fact_store::log_end(db) { Some(stored.value) }
        else { None },
        None -> None,
      }
    } with {
      fact_damage.damaged(_) -> None,
    })

pub fn store_product<[r]>(
  dir: String,
  product: String,
  at: Int,
  value: Bytes,
) -> Unit / {fs.read[r], fs.write[r], abort.raise} =
  with_recent_reads(|| {
    fact_store::store_product[r](fact_store::read_only[r](dir), product, { at: at, value: value });
    ()
  })

pub type Usage = {
  records: Int,
  results: Int,
  output_bytes: Int,
  unreferenced_bytes: Int,
  foreign: Int,
  reclaimable_bytes: Int,
  segments: Int,
  bytes: Int,
}

pub fn usage<[r]>(dir: String, queries: List<Bytes>) -> Usage / {fs.read[r], abort.raise} =
  with_recent_reads(||
    fact_store::undamaged(|| {
      let db = fact_store::read_only[r](dir);
      let size = fact_store::store_size(db);
      {
        records: fact_store::entries_under[r](db, Facts, b"").len(),
        results: 0,
        output_bytes: size.bytes,
        unreferenced_bytes: 0,
        foreign: 0,
        reclaimable_bytes: 0,
        segments: size.segments,
        bytes: size.bytes,
      }
    }))

pub type Compaction = { records: Int, results: Int, bytes: Int }

pub fn compact<[r]>(
  dir: String,
  queries: List<Bytes>,
) -> Compaction / {fs.read[r], fs.write[r], abort.raise} =
  with_recent_reads(||
    fact_store::undamaged(|| {
      let db = fact_store::open[r](dir);
      let done = fact_store::compact[r](db, Map::new());
      fact_store::close[r](db);
      { records: 0, results: 0, bytes: done.bytes_before - done.bytes_after }
    }))

type PackBuild = {
  writing: packs::PackWriter,
  records: Map<Bytes, packs::Range>,
  results: Map<Bytes, packs::Range>,
  returned: Map<Bytes, Bytes>,
}

pub fn write_pack<[r]>(
  from: String,
  shared_dir: String,
  keys: List<Bytes>,
  compress: (Bytes) -> Bytes / {abort.raise},
  queries: Bytes,
  files: Bytes,
) -> { written: packs::PackFiles, records: Int } / {fs.read[r], abort.raise} =
  with_recent_reads(||
    fact_store::undamaged(|| {
      let db = fact_store::read_only[r](from);
      let shared = fact_store::read_only[r](shared_dir);
      let laid = keys.fold(
        {
          writing: packs::new_writer(),
          records: Map::new(),
          results: Map::new(),
          returned: Map::new(),
        },
        |built: PackBuild, key: Bytes|
          match fact_store::value_of[r](db, Facts, key) {
            None -> built,
            Some(b) -> {
              let f = undecoded(b, stored_fact_bin());
              let output = fact_store::result_of[r](shared, result_key(f.output));
              let inline = match output { Some(o) -> inline_output(o), None -> None };
              let with_output = match ((output, inline, packs::output_key(f.output))) {
                (Some(o), None, Some(name)) -> if built.results.contains(name) { built } else {
                  let framed = packs::append_frame(built.writing, o, compress);
                  {
                    ..built,
                    writing: framed.writing,
                    results: built.results.insert(name, framed.at),
                  }
                },
                _ -> built,
              };
              let framed = packs::append_frame(
                with_output.writing,
                pack_record_bytes(f.output, inline),
                compress,
              );
              {
                ..with_output,
                writing: framed.writing,
                records: with_output.records.insert(pack_row_key(key), framed.at),
                returned: with_output.returned.insert(pack_row_key(key), f.output),
              }
            },
          },
      );
      {
        written: packs::finish(
          laid.writing,
          laid.records,
          laid.results,
          laid.returned,
          compress,
          queries,
          files,
        ),
        records: laid.records.len(),
      }
    }))

fn quoted(input: Bytes) -> Bytes / {memo.read} =
  Bytes::concat_all([b"\"", memo.fetch(b"text", input), b"\""])

fn test_queries() -> Map<Bytes, memo::Query<| {}>> =
  Map::new().insert(b"text", query(b"text", b"t1", memo::read_file)).insert(
    b"quoted",
    query(b"quoted", b"q1", quoted),
  )

test "a stored product is current until an edit, and a run reports the position it committed" {
  let queries = test_queries();
  let quoted_at = |text: Bytes|
    with_logged_store[abs, abs](
      "s",
      "shared",
      packs::no_pack,
      b"",
      |_: Bytes, _: Bytes| Some(text),
      || query_output(queries, start_run(queries), b"quoted", b"a").output,
    ).log_position;
  let done = fs::on_mem[abs](fs::mem_of([]), || {
    let built = match quoted_at(b"one") { Some(at) -> at, None -> panic("the run committed") };
    store_product[abs]("s", "a built program", built, b"library");
    let unedited = current_product[abs]("s", "a built program");
    quoted_at(b"one");
    let same_text = current_product[abs]("s", "a built program");
    quoted_at(b"two");
    {
      unedited: unedited,
      same_text: same_text,
      edited: current_product[abs]("s", "a built program"),
    }
  });
  assert_eq(done.value.unedited, Some(b"library"));
  assert_eq(done.value.same_text, Some(b"library"));
  assert_eq(done.value.edited, None)
}

fn quoted_over<[r]>(
  text: Bytes,
) -> { output: Bytes, ran: Int } / {fs.read[r], fs.write[r], abort.raise} = {
  let queries = test_queries();
  with_memo_store[r, r]("s", "shared", packs::no_pack, b"", |_: Bytes, _: Bytes| Some(text), || {
    let a = query_output(queries, start_run(queries), b"quoted", b"a");
    { output: a.output, ran: memo::executed_count(a.run) }
  })
}

fn quoted_in<[r]>(
  checkout: String,
  text: Bytes,
) -> { output: Bytes, ran: Int } / {fs.read[r], fs.write[r], abort.raise} = {
  let queries = test_queries();
  with_memo_store[r, r](
    checkout,
    "shared",
    packs::no_pack,
    b"",
    |_: Bytes, _: Bytes| Some(text),
    || {
      let a = query_output(queries, start_run(queries), b"quoted", b"a");
      { output: a.output, ran: memo::executed_count(a.run) }
    },
  )
}

fn stored_names(tree: fs::MemFs) -> List<String> / {abort.raise} =
  match fs::listed_names(fs::mem_list(tree, "s")) { Some(names) -> names, None -> [] }

test "a run interrupted after any number of writes leaves a store from which the next run returns what a run on a fresh store returns" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  assert_eq(first.value.output, b"\"four\"");
  iterate(0, 1000, |n: Int| {
    let died = fs::on_mem_failing[abs](first.tree, n, || quoted_over[abs](b"forty"));
    assert_eq(fs::on_mem[abs](died.tree, || quoted_over[abs](b"forty")).value.output, b"\"forty\"");
    if fs::on_mem[abs](died.tree, || quoted_over[abs](b"forty")).value.ran == 0 { Stop(()) }
    else { Continue(n + 1) }
  })
}

test "a run that finds no change runs no query and writes nothing but its own run directory" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  let again = fs::on_mem[abs](first.tree, || quoted_over[abs](b"four"));
  assert_eq(again.value, { output: b"\"four\"", ran: 0 });
  assert_eq(stored_names(again.tree), stored_names(first.tree))
}

test "a query's digest and result survive a reopen, and an edit reruns what depends on it" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  let moved = fs::on_mem[abs](first.tree, || quoted_over[abs](b"forty"));
  assert_eq(moved.value, { output: b"\"forty\"", ran: 2 });
  assert_eq(fs::on_mem[abs](moved.tree, || quoted_over[abs](b"forty")).value.ran, 0)
}

test "a damaged shared store makes the run start over, and the next run finds a sound store" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  let names = match fs::listed_names(fs::mem_list(first.tree, "shared")) {
    Some(n) -> n,
    None -> [],
  };
  let segment = names.filter(|n: String| n.starts_with("seg-")).get(0);
  let bytes = match fs::mem_read(first.tree, "shared/" ++ segment) { Some(b) -> b, None -> b"" };
  let torn = fs::on_mem[abs](first.tree, || {
    fs.write_file[abs](
      "shared/" ++ segment,
      Bytes::concat_all([bytes.slice(0, 60), b"\x00".repeat(bytes.len() - 60)]),
    );
    quoted_over[abs](b"forty")
  });
  assert_eq(torn.value.output, b"\"forty\"");
  assert_eq(fs::on_mem[abs](torn.tree, || quoted_over[abs](b"forty")).value, {
    output: b"\"forty\"",
    ran: 0,
  })
}

test "a stored value that fails its checksum makes the run start over from nothing" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  let segment = stored_names(first.tree).filter(|n: String| n.starts_with("seg-")).get(0);
  let torn = fs::on_mem[abs](first.tree, || {
    fs.write_file[abs]("s/" ++ segment, b"not a segment");
    quoted_over[abs](b"four")
  });
  assert_eq(torn.value.output, b"\"four\"")
}

test "a compaction keeps every fact the snapshot uses" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_over[abs](b"four"));
  let moved = fs::on_mem[abs](first.tree, || quoted_over[abs](b"forty"));
  let small = fs::on_mem[abs](moved.tree, || compact[abs]("s", []));
  assert_eq(fs::on_mem[abs](small.tree, || quoted_over[abs](b"forty")).value, {
    output: b"\"forty\"",
    ran: 0,
  })
}

test "a second checkout adopts the results of the first without running a query" {
  let first = fs::on_mem[abs](fs::mem_of([]), || quoted_in[abs]("one", b"four"));
  assert_eq(first.value.ran, 2);
  let second = fs::on_mem[abs](first.tree, || quoted_in[abs]("two", b"four"));
  assert_eq(second.value, { output: b"\"four\"", ran: 0 });
  assert_eq(fs::on_mem[abs](second.tree, || quoted_in[abs]("two", b"forty")).value.ran, 2)
}

test "a fact restored from an earlier version becomes the newest version in the shared store" {
  let newest = fs::on_mem[abs](fs::mem_of([]), || {
    quoted_over[abs](b"one");
    quoted_over[abs](b"two");
    quoted_over[abs](b"one");
    with_recent_reads(||
      fact_store::undamaged(||
        match fact_store::shared_past[abs](
            fact_store::read_only[abs]("shared"),
            memo::fact_key(b"quoted", b"a"),
          ) {
          Some(b) -> undecoded(b, stored_fact_bin()).output,
          None -> b"",
        }))
  });
  assert_eq(newest.value, digest_of(Some(b"\"one\"")))
}

test "a pack holds the facts of the keys it is built from, and a trusted run uses them with no query" {
  let queries = test_queries();
  let long = b"long ".repeat(1000);
  let keys = [b"text", b"quoted"].map(|name: Bytes| memo::fact_key(name, b"a"));
  let pack = fs::on_mem[abs](fs::mem_of([]), || {
    quoted_over[abs](long);
    write_pack[abs]("s", "shared", keys, packs::uncompressed, memo::queries_id(queries), b"files")
  }).value;
  assert_eq(pack.records, 2);
  let used = fs::on_mem[abs](fs::mem_of([]), ||
    with_memo_store[abs, abs](
      "s",
      "shared",
      |path: String, offset: Int, len: Int| packs::frame_in(Some(pack.written), path, offset, len),
      b"files",
      |_: Bytes, _: Bytes| None,
      || {
        let a = query_output(queries, start_run(queries), b"quoted", b"a");
        { output: a.output, ran: memo::executed_count(a.run) }
      },
    ));
  assert_eq(used.value, { output: Bytes::concat_all([b"\"", long, b"\""]), ran: 0 })
}
