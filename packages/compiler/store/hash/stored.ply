//! A definition's stored form: what its hash is taken over, and what printing it back reads. One
//! codec writes and reads it, so what is read is always what was written.
//!
//! Each type is generic over the phase. A template, what the encoder makes of a definition before
//! anything it references is hashed, is `Template`'s instance: references are nodes of the program,
//! levels are spots a commutable run's order decides, an effect carries what orders atoms equal in
//! their bytes, and notes carry the picks and runs filling reads. A stored form is `Stored`'s:
//! references are filled, levels are numbers, an effect carries its slot, and notes are empty.

import std.bin
import syntax.type_syntax (Mode, mode_bin)
import syntax.items (Deriver, SpecKind, deriver_bin, spec_kind_bin)
import store.hash.encoding (Spot, Pick, spot_bin, pick_bin)

/// What a filled reference names: a definition by its hash, a member of the component being
/// hashed by its class, the definition being hashed while it has no hash, or a definition by its
/// program-wide name where a form is written by name.
pub type Ref = | Hashed(Bytes) | Member(Int) | Itself | ByName(Bytes)

/// What a template's note says: the pick of a call on a value, or the run a block's commuting
/// `let`s are, with where it starts and how many binders each member writes.
pub type Note = | Picked(Pick) | Ran(RunAt)

/// A commutable run in a template: its number, the spot its first binder stands at, and each
/// member's binder count.
pub type RunAt = { id: Int, base: Spot, binders: List<Int> }

/// A name nothing in the program declares, with the module it was qualified by.
pub type Free = { module: Option<Bytes>, name: Bytes }

pub type Literal =
  | IntLit(Int)
  /// A width-suffixed integer: the width's place in `lexer::widths`, then the bit pattern.
  | FixedLit(Int, Int)
  /// A 128-bit integer: the width's place, then its high and low 64 bits.
  | WideLit(Int, Int, Int)
  | BoolLit(Bool)
  | StrLit(Bytes)
  | BytesLit(Bytes)
  /// An embedded file: its digest and its size.
  | EmbeddedLit(Bytes, Int)
  /// A float by its bit pattern.
  | FloatLit(Int)
  /// A decimal by its mantissa's little-endian bytes and its scale.
  | DecimalLit(Bytes, Int)
  | CharLit(Int)
  | UnitLit

/// What a value position names. A local is a binder's level; a constructor is its type and name.
pub type Named<r, l> = | Local(l) | Defined(r) | Constructed(r, Bytes) | Unbound(Free)

/// A named value and what the code the emitter writes for it calls (`forms.written_code`), which
/// the text does not say.
pub type Value<r, l> = { named: Named<r, l>, written: List<r> }

pub type Label = | LabelParam(Int) | LabelName(Bytes)

/// An effect: a declaration with what its phase carries, or a name nothing declares.
pub type Effect<r, s> = | Declared(r, s) | EffectUnbound(Free)

pub type TypeName<r> = | TypeParam(Int) | TypeDefined(r) | TypeUnbound(Free)

pub type Ty<r, s> =
  /// A type applied to its arguments, with what crossing it calls where it is a container.
  | Applied(TypeName<r>, List<r>, List<Ty<r, s>>)
  /// One applied to labels or rows beside its types.
  | AppliedOver(TypeName<r>, List<r>, List<Ty<r, s>>, List<Label>, List<Row<r, s>>)
  | Function(List<Ty<r, s>>, Ty<r, s>, Option<Row<r, s>>)
  /// Fields in the order their encodings sort in.
  | Fields(List<TyField<r, s>>)
  | UnitType

pub type TyField<r, s> = { name: Bytes, ty: Ty<r, s> }

pub type RowTail = | RowParam(Int) | RowName(Bytes)

/// Atoms sorted by their encodings, then by their effects' declarations, and deduplicated.
pub type Row<r, s> = { atoms: List<Atom<r, s>>, tail: Option<RowTail>, bounded: Bool }

pub type Atom<r, s> =
  | Moded(Effect<r, s>, Mode, Option<Label>, Bool)
  | OfOp(Effect<r, s>, Bytes, Option<Label>, Bool)

pub type Pat<r, l> =
  | Wild
  | Bind
  /// In a later alternative of an or-pattern: the first alternative's binder this variable is.
  | Again(l)
  | LitPat(Literal)
  | RangePat(Literal, Literal)
  | CtorPat(Named<r, l>, List<Pat<r, l>>)
  | RecordPat(List<PatField<r, l>>, Bool)
  | ListPat(List<Pat<r, l>>, Option<Pat<r, l>>)
  | OrPat(List<Pat<r, l>>)

pub type PatField<r, l> = { name: Bytes, pat: Pat<r, l> }

/// What a call on a value may call: the function it names in full, or every function of its name
/// a module its own can see, in the order of their program-wide names.
pub type Callees<r, l> = | InFull(Value<r, l>) | Among(List<r>)

pub type Expr<r, s, l, t> =
  | Constant(Literal)
  | Unwritten
  | Var(Value<r, l>)
  /// The operator's builtin name, its operands, and what the code written for it calls.
  | Binary(Bytes, Expr<r, s, l, t>, Expr<r, s, l, t>, List<r>)
  | Unary(Bytes, Expr<r, s, l, t>)
  /// Each parameter's type, then the body under them.
  | Lambda(List<Option<Ty<r, s>>>, Expr<r, s, l, t>)
  | App(Expr<r, s, l, t>, List<Expr<r, s, l, t>>, List<Label>)
  | OnValue(OnValueCall<r, s, l, t>)
  | If(Expr<r, s, l, t>, Expr<r, s, l, t>, Expr<r, s, l, t>)
  | Match(Expr<r, s, l, t>, List<Arm<r, s, l, t>>)
  | Record(List<RecField<r, s, l, t>>)
  | RecordUpdate(Expr<r, s, l, t>, List<RecField<r, s, l, t>>)
  | Field(Expr<r, s, l, t>, Bytes)
  | ListOf(List<Expr<r, s, l, t>>)
  | Perform(Effect<r, s>, Bytes, Option<Label>, List<Expr<r, s, l, t>>)
  | Handle(Handled<r, s, l, t>)
  | WithHold(Bytes, Expr<r, s, l, t>, Expr<r, s, l, t>, Expr<r, s, l, t>)
  | Simulate(Expr<r, s, l, t>)
  | Parallel(List<Expr<r, s, l, t>>)
  /// A tagged literal with no holes: its parser and its text.
  | Tagged(Value<r, l>, Bytes)
  /// One with holes: its parser, its filler, the text before the first hole, and each hole with
  /// the text after it.
  | Filled(Value<r, l>, Value<r, l>, Bytes, List<FilledHole<r, s, l, t>>)
  | TryBlock(Option<Raised<r, s>>, Expr<r, s, l, t>)
  | Block(List<Entry<r, s, l, t>>, Option<Expr<r, s, l, t>>)

pub type OnValueCall<r, s, l, t> = {
  base: Expr<r, s, l, t>,
  name: Bytes,
  labels: List<Label>,
  args: List<Expr<r, s, l, t>>,
  named: List<RecField<r, s, l, t>>,
  callees: Callees<r, l>,
  /// The check's pick, in a template.
  note: t,
}

pub type RecField<r, s, l, t> = { name: Bytes, value: Expr<r, s, l, t> }

pub type FilledHole<r, s, l, t> = { value: Expr<r, s, l, t>, text: Bytes }

pub type Raised<r, s> = { effect: Effect<r, s>, op: Bytes }

pub type Arm<r, s, l, t> = {
  pat: Pat<r, l>,
  guard: Option<Expr<r, s, l, t>>,
  body: Expr<r, s, l, t>,
}

/// A `handle`: the variables its clauses assign, each with its type and first value, then its
/// body, its clauses and its `return`.
pub type Handled<r, s, l, t> = {
  vars: List<HandlerVar<r, s, l, t>>,
  body: Expr<r, s, l, t>,
  clauses: List<Clause<r, s, l, t>>,
  ret: Option<Expr<r, s, l, t>>,
}

pub type HandlerVar<r, s, l, t> = { ty: Option<Ty<r, s>>, init: Expr<r, s, l, t> }

/// A clause: the operation it handles, its label, how many parameters it binds, whether it binds a
/// continuation, and its body.
pub type Clause<r, s, l, t> = {
  effect: Effect<r, s>,
  op: Bytes,
  label: Option<Label>,
  params: Int,
  resumes: Bool,
  body: Expr<r, s, l, t>,
}

/// A statement of a block, or a run of `let`s that commute: its note in a template, its members in
/// the order their encodings sort in once filled.
pub type Entry<r, s, l, t> = | One(Stmt<r, s, l, t>) | Commuting(t, List<Stmt<r, s, l, t>>)

pub type Stmt<r, s, l, t> =
  | Let(Option<Ty<r, s>>, Expr<r, s, l, t>, Pat<r, l>)
  | LetElse(Option<Ty<r, s>>, Expr<r, s, l, t>, Pat<r, l>, Expr<r, s, l, t>)
  | Effectful(Expr<r, s, l, t>)
  | Assign(Value<r, l>, Expr<r, s, l, t>)

/// How many type, row and label parameters a declaration binds.
pub type Generics = { types: Int, rows: Int, labels: Int }

pub type Param<r, s, l, t> = {
  kept: Bool,
  spaced: Bool,
  ty: Option<Ty<r, s>>,
  default: Option<Expr<r, s, l, t>>,
}

/// A constraint by its type parameter's level, sorted and deduplicated.
pub type Constrained = { level: Int, deriver: Deriver }

pub type Returning = | Unstated | Fresh | ParamReturned(Int)

pub type FnForm<r, s, l, t> = {
  generics: Generics,
  params: List<Param<r, s, l, t>>,
  ret: Option<Ty<r, s>>,
  row: Option<Row<r, s>>,
  constraints: List<Constrained>,
  returns: Returning,
  decreases: Option<Expr<r, s, l, t>>,
  /// A `const`: what the code written for its value calls.
  baked: Option<List<r>>,
  body: Expr<r, s, l, t>,
}

pub type Variant<r, s> = { name: Bytes, fields: List<Ty<r, s>> }

pub type TypeBody<r, s> =
  | Alias(Ty<r, s>)
  | Sum(Bytes, List<Variant<r, s>>)
  | Nominal(Bytes, Ty<r, s>)
  | Extern(Bytes)

/// The function a type's values are compared through (`key`) or shown through.
pub type Through<r, l> = { key: Bool, by: Value<r, l> }

/// One operation of a type's arithmetic and the function it is.
pub type Numeric<r, l> = { op: Bytes, by: Value<r, l> }

pub type TypeForm<r, s, l> = {
  generics: Generics,
  /// Whether the declaration binds a row or a label, which writes their counts.
  over: Bool,
  constraints: List<Constrained>,
  body: TypeBody<r, s>,
  opaque: Bool,
  through: List<Through<r, l>>,
  numerics: List<Numeric<r, l>>,
}

pub type Op<r, s> = {
  name: Bytes,
  mode: Mode,
  resource: Bool,
  types: Int,
  params: List<Ty<r, s>>,
  ret: Ty<r, s>,
}

/// An effect, its operations in the order their encodings sort in.
pub type EffectForm<r, s> = { name: Bytes, nondet: Bool, ops: List<Op<r, s>> }

pub type TestForm<r, s, l, t> = { nondet: Bool, cases: Option<Ty<r, s>>, body: Expr<r, s, l, t> }

pub type LawForm<r, s, l, t> = {
  binders: List<Ty<r, s>>,
  guard: Option<Expr<r, s, l, t>>,
  body: Expr<r, s, l, t>,
}

/// A specification clause in its owner's scope: the owner's generics and parameter count, and the
/// parameters whose cost or space names it binds, after them.
pub type SpecForm<r, s, l, t> = {
  kind: SpecKind,
  generics: Generics,
  params: Int,
  names: Option<List<Int>>,
  body: Expr<r, s, l, t>,
}

pub type Form<r, s, l, t> =
  | FnOf(FnForm<r, s, l, t>)
  | TypeOf(TypeForm<r, s, l>)
  | EffectOf(EffectForm<r, s>)
  | TestOf(TestForm<r, s, l, t>)
  | LawOf(LawForm<r, s, l, t>)
  | SpecOf(SpecForm<r, s, l, t>)

/// A template: what the encoder writes of a definition, before what it references is hashed.
pub type Template = Form<Int, Bytes, Spot, Note>

/// A stored form: what a definition's hash is taken over.
pub type Stored = Form<Ref, Int, Int, Unit>

derive bin for Ref

derive bin for Note

derive bin for RunAt

derive bin for Free

derive bin for Literal

derive bin for Named

derive bin for Value

derive bin for Label

derive bin for Effect

derive bin for TypeName

derive bin for Ty

derive bin for TyField

derive bin for RowTail

derive bin for Row

derive bin for Atom

derive bin for Pat

derive bin for PatField

derive bin for Callees

derive bin for Expr

derive bin for OnValueCall

derive bin for RecField

derive bin for FilledHole

derive bin for Raised

derive bin for Arm

derive bin for Handled

derive bin for HandlerVar

derive bin for Clause

derive bin for Entry

derive bin for Stmt

derive bin for Generics

derive bin for Param

derive bin for Constrained

derive bin for Returning

derive bin for FnForm

derive bin for Variant

derive bin for TypeBody

derive bin for Through

derive bin for Numeric

derive bin for TypeForm

derive bin for Op

derive bin for EffectForm

derive bin for TestForm

derive bin for LawForm

derive bin for SpecForm

derive bin for Form

/// The codec of stored forms: its bytes are what a definition's hash is taken over.
pub fn stored_bin() -> bin::BinCodec<Stored> =
  form_bin(ref_bin(), bin::int_bin(), bin::int_bin(), bin::unit_bin())

/// The codec of templates, which the memo store keeps.
pub fn template_bin() -> bin::BinCodec<Template> =
  form_bin(bin::int_bin(), bin::bytes_bin(), spot_bin(), note_bin())
