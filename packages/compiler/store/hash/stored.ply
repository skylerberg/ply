import std.bin
import std.derive.map
import compiler.syntax.type_syntax (Mode, mode_bin)
import compiler.syntax.items (Deriver, SpecKind, InstanceKind, deriver_bin, spec_kind_bin,
                              instance_kind_bin)
import compiler.store.hash.encoding (BinderPosition, CallResolution, binder_position_bin,
                                     call_resolution_bin)

pub type Note = | CallNote(CallResolution) | RunNote(UnorderedStatements)

pub type UnorderedStatements = { id: Int, base: BinderPosition, binders: List<Int> }

pub type FreeName = { module: Option<Bytes>, name: Bytes }

pub type Literal =
  | IntLiteral(Int)
  | FixedLiteral(Int, Int)
  | WideLiteral(Int, Int, Int)
  | BoolLiteral(Bool)
  | StringLiteral(Bytes)
  | BytesLiteral(Bytes)
  | EmbeddedLiteral(Bytes, Int)
  | FloatLiteral(Int)
  | DecimalLiteral(Bytes, Int)
  | CharLiteral(Int)
  | UnitLiteral

pub type Named<reference, level> =
  | Local(level)
  | Defined(reference)
  | Constructed(reference, Bytes)
  | Unbound(FreeName)

pub type Value<reference, level> = { named: Named<reference, level>, written: List<reference> }

pub type Label = | LabelParameter(Int) | LabelName(Bytes)

pub type EffectReference<reference> = | Declared(reference) | EffectUnbound(FreeName)

pub type TypeName<reference> = | TypeParameter(Int) | TypeDefined(reference) | TypeUnbound(FreeName)

pub type Type<reference> =
  | Applied(TypeName<reference>, List<reference>, List<Type<reference>>)
  | AppliedOver(TypeName<reference>, List<reference>, List<Type<reference>>, List<Label>, List<Effects<reference>>)
  | Function(List<Type<reference>>, Type<reference>, Option<Effects<reference>>, List<Int>, Bool)
  | Fields(List<TypeField<reference>>)
  | UnitType

pub type TypeField<reference> = { name: Bytes, field_type: Type<reference> }

pub type EffectVariable = | EffectParameter(Int) | EffectVariableName(Bytes)

pub type Effects<reference> = {
  listed: List<Effect<reference>>,
  variable: Option<EffectVariable>,
  bounded: Bool,
}

pub type Effect<reference> =
  | Moded(EffectReference<reference>, Mode, Option<Label>, Bool)
  | OfOperation(EffectReference<reference>, Bytes, Option<Label>, Bool)

pub type Pattern<reference, level> =
  | Wild
  | Bind
  | Rebound(level)
  | LiteralPattern(Literal)
  | RangePattern(Literal, Literal)
  | ConstructorPattern(Named<reference, level>, List<Pattern<reference, level>>)
  | RecordPattern(List<PatternField<reference, level>>, Bool)
  | ListPattern(List<Pattern<reference, level>>, Option<Pattern<reference, level>>)
  | OrPattern(List<Pattern<reference, level>>)

pub type PatternField<reference, level> = { name: Bytes, pattern: Pattern<reference, level> }

pub type Callees<reference, level> = | InFull(Value<reference, level>) | Among(List<reference>)

pub type Expression<reference, level, note> =
  | Constant(Literal)
  | Unwritten
  | Variable(Value<reference, level>)
  | Binary(Bytes, Expression<reference, level, note>, Expression<reference, level, note>, List<reference>)
  | Unary(Bytes, Expression<reference, level, note>)
  | Lambda(List<Option<Type<reference>>>, Expression<reference, level, note>)
  | Call(Expression<reference, level, note>, List<Expression<reference, level, note>>, List<Label>)
  | OnValue(OnValueCall<reference, level, note>)
  | If(Expression<reference, level, note>, Expression<reference, level, note>, Expression<reference, level, note>)
  | Match(Expression<reference, level, note>, List<Arm<reference, level, note>>)
  | Record(List<RecordField<reference, level, note>>)
  | RecordUpdate(Expression<reference, level, note>, List<RecordField<reference, level, note>>)
  | Field(Expression<reference, level, note>, Bytes)
  | ListOf(List<Expression<reference, level, note>>)
  | Perform(EffectReference<reference>, Bytes, Option<Label>, List<Expression<reference, level, note>>)
  | Handle(StoredHandle<reference, level, note>)
  | WithScope(Bytes, Expression<reference, level, note>, Expression<reference, level, note>, Expression<reference, level, note>)
  | Simulate(Expression<reference, level, note>)
  | Parallel(List<Expression<reference, level, note>>)
  | Tagged(Value<reference, level>, Bytes)
  | Filled(Value<reference, level>, Value<reference, level>, Bytes, List<FilledHole<reference, level, note>>)
  | TryBlock(Option<RaisedOperation<reference>>, Expression<reference, level, note>)
  | Block(List<Entry<reference, level, note>>, Option<Expression<reference, level, note>>)

pub type OnValueCall<reference, level, note> = {
  base: Expression<reference, level, note>,
  name: Bytes,
  labels: List<Label>,
  arguments: List<Expression<reference, level, note>>,
  named: List<RecordField<reference, level, note>>,
  callees: Callees<reference, level>,
  note: note,
}

pub type RecordField<reference, level, note> = {
  name: Bytes,
  value: Expression<reference, level, note>,
}

pub type FilledHole<reference, level, note> = {
  value: Expression<reference, level, note>,
  text: Bytes,
}

pub type RaisedOperation<reference> = { effect: EffectReference<reference>, operation: Bytes }

pub type Arm<reference, level, note> = {
  pattern: Pattern<reference, level>,
  guard: Option<Expression<reference, level, note>>,
  body: Expression<reference, level, note>,
}

pub type StoredHandle<reference, level, note> = {
  variables: List<HandlerVariable<reference, level, note>>,
  body: Expression<reference, level, note>,
  clauses: List<HandlerClause<reference, level, note>>,
  returned: Option<Expression<reference, level, note>>,
}

pub type HandlerVariable<reference, level, note> = {
  annotation: Option<Type<reference>>,
  first: Expression<reference, level, note>,
}

pub type HandlerClause<reference, level, note> = {
  effect: EffectReference<reference>,
  operation: Bytes,
  label: Option<Label>,
  parameters: Int,
  resumes: Bool,
  body: Expression<reference, level, note>,
}

pub type Entry<reference, level, note> =
  | One(Statement<reference, level, note>)
  | Commuting(note, List<Statement<reference, level, note>>)

pub type Statement<reference, level, note> =
  | Let(Option<Type<reference>>, Expression<reference, level, note>, Pattern<reference, level>)
  | LetElse(Option<Type<reference>>, Expression<reference, level, note>, Pattern<reference, level>, Expression<reference, level, note>)
  | Effectful(Expression<reference, level, note>)
  | Assign(Value<reference, level>, Expression<reference, level, note>)

pub type Generics = { types: Int, effects: Int, labels: Int, retained_types: List<Int> }

pub type Parameter<reference, level, note> = {
  retained: Bool,
  spaced: Bool,
  annotation: Option<Type<reference>>,
  default: Option<Expression<reference, level, note>>,
}

pub type ParameterConstraint = { level: Int, deriver: Deriver }

pub type Returning = | Unstated | Fresh | ParameterReturned(Int)

pub type FunctionForm<reference, level, note> = {
  generics: Generics,
  parameters: List<Parameter<reference, level, note>>,
  returned: Option<Type<reference>>,
  effects: Option<Effects<reference>>,
  constraints: List<ParameterConstraint>,
  identities: List<Int>,
  returns: Returning,
  decreases: Option<Expression<reference, level, note>>,
  constant: Bool,
  body: Expression<reference, level, note>,
}

pub type Variant<reference> = { name: Bytes, fields: List<Type<reference>> }

pub type TypeBody<reference> =
  | Alias(Type<reference>)
  | Sum(Bytes, List<Variant<reference>>)
  | Nominal(Bytes, Type<reference>)
  | Extern(Bytes)

pub type InstanceFunction<reference, level> = { kind: InstanceKind, by: Value<reference, level> }

pub type Numeric<reference, level> = { operator: Bytes, function: Value<reference, level> }

pub type TypeForm<reference, level> = {
  generics: Generics,
  has_effect_generics: Bool,
  constraints: List<ParameterConstraint>,
  body: TypeBody<reference>,
  opaque: Bool,
  through: List<InstanceFunction<reference, level>>,
  numerics: List<Numeric<reference, level>>,
}

pub type Operation<reference> = {
  name: Bytes,
  mode: Mode,
  resource: Bool,
  types: Int,
  parameters: List<Type<reference>>,
  retained_parameters: List<Int>,
  returned: Type<reference>,
}

pub type EffectForm<reference, level> = {
  name: Bytes,
  nondet: Bool,
  operations: List<Operation<reference>>,
  host_function: Option<Value<reference, level>>,
}

pub type CaseRun<reference, level> = {
  table_type: Type<reference>,
  chosen: Value<reference, level>,
}

pub type TestForm<reference, level, note> = {
  nondet: Bool,
  cases: Option<CaseRun<reference, level>>,
  body: Expression<reference, level, note>,
}

pub type LawForm<reference, level, note> = {
  binders: List<Type<reference>>,
  identities: List<Bytes>,
  guard: Option<Expression<reference, level, note>>,
  body: Expression<reference, level, note>,
}

pub type SpecForm<reference, level, note> = {
  kind: SpecKind,
  generics: Generics,
  parameters: Int,
  names: Option<List<Int>>,
  body: Expression<reference, level, note>,
}

pub type Form<reference, level, note> =
  | FunctionOf(FunctionForm<reference, level, note>)
  | TypeOf(TypeForm<reference, level>)
  | EffectOf(EffectForm<reference, level>)
  | TestOf(TestForm<reference, level, note>)
  | LawOf(LawForm<reference, level, note>)
  | SpecOf(SpecForm<reference, level, note>)

pub type Template = Form<Int, BinderPosition, Note>

pub type Stored = Form<Bytes, Int, Unit>

derive map for Named

derive map for EffectReference

derive map for TypeName

derive map for Type

derive map for Effect

derive map for Pattern

derive map for Callees

derive map for Expression

derive map for Entry

derive map for Statement

derive map for TypeBody

derive map for Form

derive bin for Note

derive bin for UnorderedStatements

derive bin for FreeName

derive bin for Literal

derive bin for Named

derive bin for Value

derive bin for Label

derive bin for EffectReference

derive bin for TypeName

derive bin for Type

derive bin for TypeField

derive bin for EffectVariable

derive bin for Effects

derive bin for Effect

derive bin for Pattern

derive bin for PatternField

derive bin for Callees

derive bin for Expression

derive bin for OnValueCall

derive bin for RecordField

derive bin for FilledHole

derive bin for RaisedOperation

derive bin for Arm

derive bin for StoredHandle

derive bin for HandlerVariable

derive bin for HandlerClause

derive bin for Entry

derive bin for Statement

derive bin for Generics

derive bin for Parameter

derive bin for ParameterConstraint

derive bin for Returning

derive bin for FunctionForm

derive bin for Variant

derive bin for TypeBody

derive bin for InstanceFunction

derive bin for Numeric

derive bin for TypeForm

derive bin for Operation

derive bin for EffectForm

derive bin for CaseRun

derive bin for TestForm

derive bin for LawForm

derive bin for SpecForm

derive bin for Form

pub fn stored_bin() -> bin::BinCodec<Stored> =
  form_bin(bin::bytes_bin(), bin::int_bin(), bin::unit_bin())

pub fn template_bin() -> bin::BinCodec<Template> =
  form_bin(bin::int_bin(), binder_position_bin(), note_bin())
