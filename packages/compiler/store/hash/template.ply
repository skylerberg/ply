//! What the encoder makes of a definition's syntax: its template, the stored form with what it
//! references left as nodes of the program (`stored.Template`). Every name is resolved here, once.

import compiler.syntax.parsing (Span, Ident, QName, is_bare, bare, starts_upper)
import compiler.syntax.type_syntax (TypeExpr, VariableTypeExpression, NamedTypeExpression,
                                    FunctionTypeExpression, RecordTypeExpression,
