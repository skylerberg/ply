import std.bin

pub type TemplateValue = Value<Int, BinderPosition>

pub type TemplateType = stored::Type<Int, EffectSlot>

pub type TemplateEffects = Effects<Int, EffectSlot>

pub type TemplatePattern = stored::Pattern<Int, BinderPosition>

pub type TemplateExpression = stored::Expression<Int, EffectSlot, BinderPosition, Note>

pub type TemplateStatement = stored::Statement<Int, EffectSlot, BinderPosition, Note>

type TemplateEntry = Entry<Int, EffectSlot, BinderPosition, Note>

type TemplateField = stored::RecordField<Int, EffectSlot, BinderPosition, Note>

pub type Encoder = {
  index: Index,
  module: Int,
  owner: Bytes,
  locals: Map<Int, Int>,
  values: List<PositionedBinder>,
  type_params: List<Bytes>,
  effect_params: List<Bytes>,
  label_params: List<Bytes>,
  scope: BinderPosition,
  runs: Int,
  choices: Option<Map<CallSite, Choice>>,
  reads: List<Int>,
}

pub type Built<a> = { encoder: Encoder, form: a }

const no_scope: BinderPosition = { run: 0 - 1, member: 0, within: 0 }

pub fn new_encoder(index: Index, module: Int, locals: Map<Int, Int>) -> Encoder =
  {
    index: index,
    module: module,
    owner: b"",
    locals: locals,
    values: [],
    type_params: [],
    effect_params: [],
    label_params: [],
    scope: no_scope,
    runs: 0,
    choices: Some(Map::new()),
    reads: [],
  }

pub fn node_template(
  index: Index,
  module: Int,
  owner: Bytes,
  chose: Option<Map<CallSite, Choice>>,
  body: NodeBody,
) -> Template / {abort.raise} = {
  let locals = match body {
    NodeFn(definition) -> item_locals(FunctionItem(definition)),
    _ -> Map::new(),
  };
  let encoder = { ..new_encoder(index, module, locals), owner: owner, choices: chose };
  match body {
    NodeFn(definition) -> FunctionOf(function_form(encoder, definition)),
    NodeType(definition) -> TypeOf(type_form(encoder, definition)),
    NodeEffect(definition) -> EffectOf(effect_form(encoder, definition)),
  }
}

pub fn test_template(
  index: Index,
  module: Int,
  owner: Bytes,
  chose: Option<Map<CallSite, Choice>>,
  definition: TestDefinition,
) -> Template / {abort.raise} =
  TestOf(
    test_form(
      {
        ..new_encoder(index, module, item_locals(TestItem(definition))),
        owner: owner,
        choices: chose,
      },
      definition,
    ),
  )

pub fn law_template(
  index: Index,
  module: Int,
  definition: LawDefinition,
) -> Template / {abort.raise} =
  LawOf(law_form(new_encoder(index, module, item_locals(LawItem(definition))), definition))

pub fn spec_template(
  index: Index,
  module: Int,
  owner: FnDefinition,
  clause: SpecClause,
) -> Template / {abort.raise} =
  SpecOf(spec_form(new_encoder(index, module, item_locals(FunctionItem(owner))), owner, clause))

pub fn expression_template(
  index: Index,
  module: Int,
  params: List<Identifier>,
  written: Expression,
) -> TemplateExpression / {abort.raise} =
  expression(
    bind_all(new_encoder(index, module, body_binders(params, written)), params),
    written,
  ).form

fn spot_here(encoder: Encoder) -> BinderPosition = {
  let count = encoder.values.len();
  if encoder.scope.run < 0 { { run: 0 - 1, member: 0, within: count } }
  else { { ..encoder.scope, within: count - encoder.scope.within } }
}

fn binder_of(encoder: Encoder, name: Identifier) -> Int =
  encoder.locals.get(name.span.site).unwrap_or(name.span.site)

fn bind(encoder: Encoder, name: Identifier) -> Encoder =
  {
    ..encoder,
    values: encoder.values.push({ binder: binder_of(encoder, name), position: spot_here(encoder) }),
  }

fn bind_all(encoder: Encoder, names: List<Identifier>) -> Encoder = names.fold(encoder, bind)

fn bound_at(values: List<PositionedBinder>, binder: Int) -> Option<Int> / {abort.raise} =
  range(0, values.len()).fold(None, |accumulator: Option<Int>, i: Int|
    if values.get(i).binder == binder { Some(i) } else { accumulator })

fn local_read(encoder: Encoder, qualified_name: QName) -> Option<Int> / {abort.raise} =
  if !is_bare(qualified_name) { None } else {
    match encoder.locals.get(qualified_name.name.span.site) {
      Some(b) -> bound_at(encoder.values, b),
      None -> None,
    }
  }

fn read(encoder: Encoder, qualified_name: QName) -> Encoder / {abort.raise} =
  match local_read(encoder, qualified_name) {
    Some(i) -> { ..encoder, reads: encoder.reads.push(i) },
    None -> encoder,
  }

fn close_scope(inner: Encoder, outer: Encoder) -> Encoder = { ..inner, values: outer.values }

pub type EmittedCode = {
  operators: List<Bytes>,
  tokens: List<Bytes>,
  builtins: List<Bytes>,
  calls: List<Bytes>,
  insert_calls: List<Bytes>,
}

pub const emitted_code: EmittedCode =
  {
    operators: [b"eq", b"ne"],
    tokens: [b"eqeq", b"bangeq"],
    builtins: [
      b"compare",
      b"compare_values",
      b"digest",
      b"reflect",
      b"shown",
      b"assert_eq",
      b"rsa_jwk",
      b"range",
      b"split",
      b"chars",
      b"of_chars",
      b"concat_all",
    ],
    calls: [b"List::at", b"List::push", b"Map::entries"],
    insert_calls: [b"Map::insert"],
  }

pub fn emitted_calls_for(name: Bytes) -> List<Bytes> =
  if emitted_code.builtins.contains(name) { emitted_code.calls } else { [] }

pub fn container_named(name: Bytes) -> Bool = name == list_name || name == map_name

pub fn marshalling_calls_for(module: Bytes, name: Bytes) -> List<Bytes> =
  if !container_named(name) { [] } else { marshalling_calls(module) }

pub fn marshalling_calls(module: Bytes) -> List<Bytes> =
  if module == prelude_module { [] } else { emitted_code.calls.concat(emitted_code.insert_calls) }

fn module_name(encoder: Encoder) -> Bytes =
  match encoder.index.modules.at(encoder.module) { Some(found) -> found.name, None -> b"" }

fn emitted_call_nodes(encoder: Encoder, called: List<Bytes>) -> List<Int> =
  called.fold([], |accumulator: List<Int>, name: Bytes|
    match encoder.index.written.get(name) {
      Some(node) -> accumulator.push(node),
      None -> accumulator,
    })

fn value_of(encoder: Encoder, qualified_name: QName) -> TemplateValue / {abort.raise} = {
  let value = resolved(encoder, qualified_name);
  match container_of(qualified_name) {
    Some(container) ->
      {
        ..value,
        written: value.written.concat(
          emitted_call_nodes(encoder, marshalling_calls_for(module_name(encoder), container)),
        ),
      },
    None -> value,
  }
}

fn container_of(qualified_name: QName) -> Option<Bytes> / {abort.raise} = {
  let of_member = match member_of(qualified_name.name.name) {
    Some(member) -> if container_named(member.of) { Some(member.of) } else { None },
    None -> None,
  };
  match qualifier(qualified_name) {
    Some(qualified) -> if container_named(qualified) { Some(qualified) } else { of_member },
    None -> of_member,
  }
}

fn resolved(encoder: Encoder, qualified_name: QName) -> TemplateValue / {abort.raise} = {
  let local = local_read(encoder, qualified_name);
  match local {
    Some(i) -> { named: Local(encoder.values.get(i).position), written: [] },
    None -> match value_target(encoder.index, encoder.module, qualified_name) {
      Some(FnTarget(node)) -> { named: Defined(node), written: [] },
      Some(ConstructorTarget(constructor)) ->
        { named: Constructed(constructor.owner, constructor.name), written: [] },
      None -> {
        let called = emitted_call_nodes(encoder, emitted_calls_for(qualified_name.name.name));
        match qualifier(qualified_name) {
          Some(qualified) -> if starts_upper(qualified)
              && encoder.index.scopes.get(encoder.module).modules.get(qualified) == None {
            {
              named: Unbound({
                module: None,
                name: member_name(qualified, qualified_name.name.name),
              }),
              written: match type_target(encoder.index, encoder.module, None, qualified) {
                Some(of) -> [of],
                None -> [],
              },
            }
          } else {
            {
              named: Unbound({ module: Some(qualified), name: qualified_name.name.name }),
              written: called,
            }
          },
          None ->
            { named: Unbound({ module: None, name: qualified_name.name.name }), written: called },
        }
      },
    },
  }
}

fn constructor_named(
  encoder: Encoder,
  qualified_name: QName,
) -> Named<Int, BinderPosition> / {abort.raise} =
  match constructor_target(encoder.index, encoder.module, qualified_name) {
    Some(ConstructorTarget(constructor)) -> Constructed(constructor.owner, constructor.name),
    _ -> Unbound({ module: qualifier(qualified_name), name: qualified_name.name.name }),
  }

fn effect_of(
  encoder: Encoder,
  qualified_name: QName,
) -> EffectReference<Int, EffectSlot> / {abort.raise} =
  match effect_target(encoder.index, encoder.module, qualified_name) {
    Some(node) ->
      Declared(node, {
        node: node,
        template_bytes: match encoder.index.effect_sketches.get(node) {
          Some(sketch) -> sketch,
          None -> b"",
        },
      }),
    None -> EffectUnbound({ module: qualifier(qualified_name), name: qualified_name.name.name }),
  }

fn label_of(encoder: Encoder, identifier: Identifier) -> Label / {abort.raise} =
  match last_index_of(encoder.label_params, identifier.name) {
    Some(level) -> LabelParameter(level),
    None -> LabelName(identifier.name),
  }

fn optional_label(
  encoder: Encoder,
  identifier: Option<Identifier>,
) -> Option<Label> / {abort.raise} =
  match identifier { None -> None, Some(present) -> Some(label_of(encoder, present)) }

fn clause_label(clause: HandleClause) -> Option<Identifier> =
  match clause.label_binder {
    Some(binder) -> Some({ name: b"*".concat(binder.name), span: clause.span }),
    None -> if clause.wildcard_label { Some({ name: b"*", span: clause.span }) }
    else { clause.resource },
  }

fn effect_label(encoded_effect: EffectExpression) -> Option<Identifier> =
  if encoded_effect.resource_wildcard { Some({ name: b"*", span: encoded_effect.span }) }
  else { encoded_effect.resource }

type ResolvedTypeName = { name: TypeName<Int>, written: List<Int> }

fn resolve_type_name(
  encoder: Encoder,
  qualified: Option<Bytes>,
  name: Bytes,
) -> ResolvedTypeName / {abort.raise} = {
  let parameter = match qualified {
    None -> last_index_of(encoder.type_params, name),
    Some(_) -> None,
  };
  match parameter {
    Some(level) -> { name: TypeParameter(level), written: [] },
    None -> match type_target(encoder.index, encoder.module, qualified, name) {
      Some(node) -> { name: TypeDefined(node), written: [] },
      None ->
        {
          name: TypeUnbound({ module: qualified, name: name }),
          written: if qualified == None {
            emitted_call_nodes(encoder, marshalling_calls_for(module_name(encoder), name))
          } else { [] },
        },
    },
  }
}

fn optional_type(
  encoder: Encoder,
  written: Option<TypeExpression>,
) -> Option<TemplateType> / {abort.raise} =
  match written { None -> None, Some(present) -> Some(type_template(encoder, present)) }

fn types(encoder: Encoder, written: List<TypeExpression>) -> List<TemplateType> / {abort.raise} =
  written.map(|each: TypeExpression| type_template(encoder, each))

pub fn type_template(encoder: Encoder, written: TypeExpression) -> TemplateType / {abort.raise} =
  match written {
    VariableTypeExpression(name) -> {
      let named = resolve_type_name(encoder, None, name.name);
      Applied(named.name, named.written, [])
    },
    NamedTypeExpression(constructed) -> {
      let named = resolve_type_name(
        encoder,
        qualifier(constructed.name),
        constructed.name.name.name,
      );
      let arguments = types(encoder, constructed.args);
      if constructed.labels.len() == 0 && constructed.effect_arguments.len() == 0 {
        Applied(named.name, named.written, arguments)
      } else {
        AppliedOver(
          named.name,
          named.written,
          arguments,
          constructed.labels.map(|label: Identifier| label_of(encoder, label)),
          constructed.effect_arguments.map(|written_effects: EffectsExpression|
            encoded_effects(encoder, written_effects)),
        )
      }
    },
    FunctionTypeExpression(function) ->
      Function(
        types(encoder, function.params),
        type_template(encoder, function.return_type),
        optional_effects(encoder, function.effects),
        function.keep_indices,
        function.once,
      ),
    RecordTypeExpression(record) ->
      Fields(
        by_name(
          record.fields.map(|field: { name: Identifier, ty: TypeExpression }|
            { name: field.name.name, field_type: type_template(encoder, field.ty) }),
          |field: TypeField<Int, EffectSlot>| field.name,
        ),
      ),
    UnitTypeExpression(_) -> UnitType,
    InvalidTypeExpression(_) -> UnitType,
  }

fn by_name<a>(members: List<a>, name: (a) -> Bytes) -> List<a> / {abort.raise} =
  sorted_by_key(
    members.map(|member: a|
      { key: bin::encode(name(member), bin::bytes_bin()), tie: b"", value: member }),
  )

type SortKeyed<a> = { key: Bytes, tie: Bytes, value: a }

fn sorted_by_key<a>(members: List<SortKeyed<a>>) -> List<a> =
  members.sort_by(|first: SortKeyed<a>, second: SortKeyed<a>|
    match compare_values(first.key, second.key) {
      Less -> true,
      Greater -> false,
      Equal -> match compare_values(first.tie, second.tie) { Greater -> false, _ -> true },
    }).map(|member: SortKeyed<a>| member.value)

fn optional_effects(
  encoder: Encoder,
  written: Option<EffectsExpression>,
) -> Option<TemplateEffects> / {abort.raise} =
  match written { None -> None, Some(present) -> Some(encoded_effects(encoder, present)) }

fn encoded_effects(
  encoder: Encoder,
  written: EffectsExpression,
) -> TemplateEffects / {abort.raise} =
  {
    listed: sorted_by_key(
      written.listed.map(|written_effect: EffectExpression| {
        let template = encoded_effect(encoder, written_effect);
        { key: blank_encoding(template), tie: effect_tie_breaker(template), value: template }
      }),
    ),
    variable: match written.variable {
      None -> None,
      Some(tail) -> match last_index_of(encoder.effect_params, tail.name) {
        Some(level) -> Some(EffectParameter(level)),
        None -> Some(EffectVariableName(tail.name)),
      },
    },
    bounded: written.variable_bounded,
  }

fn encoded_effect(
  encoder: Encoder,
  written: EffectExpression,
) -> Effect<Int, EffectSlot> / {abort.raise} = {
  let performed = effect_of(encoder, written.effect_name);
  let label = optional_label(encoder, effect_label(written));
  match written.operation {
    None -> Moded(performed, written.mode, label, written.bounded),
    Some(operation) -> OfOperation(performed, operation.name, label, written.bounded),
  }
}

pub fn blank_encoding(encoded_effect: Effect<Int, EffectSlot>) -> Bytes / {abort.raise} =
  bin::encode(
    encoded_effect.map(reference: |_: Int| Itself, slot: |_: EffectSlot| 0),
    effect_bin(reference_bin(), bin::int_bin()),
  )

pub fn effect_tie_breaker(encoded_effect: Effect<Int, EffectSlot>) -> Bytes =
  match encoded_effect {
    Moded(Declared(_, slot), _, _, _) -> slot.template_bytes,
    OfOperation(Declared(_, slot), _, _, _) -> slot.template_bytes,
    _ -> b"",
  }

fn literal(written: SourceLiteral) -> Literal / {abort.raise} =
  match written {
    LiteralInt(value) -> IntLiteral(value),
    LiteralFixed(width, bits) -> FixedLiteral(width_index(width).at(0), bits),
    LiteralWide(width, high, low) -> WideLiteral(width_index(width).at(0), high, low),
    LiteralBool(value) -> BoolLiteral(value),
    LiteralString(text) -> StringLiteral(text),
    LiteralBytes(content) -> BytesLiteral(content),
    LiteralEmbedded(digest, size) -> EmbeddedLiteral(digest, size),
    LiteralFloat(text) -> FloatLiteral(float_bits(text)),
    LiteralDecimal(text) -> {
      let parts = decimal_parts(text);
      DecimalLiteral(parts.mantissa, parts.scale)
    },
    LiteralChar(value) -> CharLiteral(value),
    LiteralUnit -> UnitLiteral,
    LiteralInvalid -> panic("cannot hash a literal that failed to parse"),
  }

fn pattern(encoder: Encoder, written: Pattern) -> Built<TemplatePattern> / {abort.raise} =
  pattern_in(encoder, written, None)

fn patterns(
  encoder: Encoder,
  written: List<Pattern>,
  again: Option<Int>,
) -> Built<List<TemplatePattern>> / {abort.raise} =
  written.fold(
    { encoder: encoder, form: [] },
    |accumulator: Built<List<TemplatePattern>>, each: Pattern| {
      let built = pattern_in(accumulator.encoder, each, again);
      { encoder: built.encoder, form: accumulator.form.push(built.form) }
    },
  )

fn pattern_in(
  encoder: Encoder,
  written: Pattern,
  again: Option<Int>,
) -> Built<TemplatePattern> / {abort.raise} =
  match written {
    PatternWildcard(_) -> { encoder: encoder, form: Wild },
    PatternVariable(variable) -> {
      let earlier = match again {
        None -> None,
        Some(from) -> match bound_at(encoder.values, binder_of(encoder, variable.name)) {
          Some(i) -> if i >= from { Some(i) } else { None },
          None -> None,
        },
      };
      match earlier {
        Some(i) -> { encoder: encoder, form: Rebound(encoder.values.get(i).position) },
        None -> { encoder: bind(encoder, variable.name), form: Bind },
      }
    },
    PatternLiteral(literal_pattern) ->
      { encoder: encoder, form: LiteralPattern(literal(literal_pattern.literal)) },
    PatternRange(range_pattern) ->
      {
        encoder: encoder,
        form: RangePattern(literal(range_pattern.lo), literal(range_pattern.hi)),
      },
    PatternConstructor(constructed) -> {
      let arguments = patterns(encoder, constructed.args, again);
      {
        encoder: arguments.encoder,
        form: ConstructorPattern(constructor_named(encoder, constructed.name), arguments.form),
      }
    },
    PatternRecord(record) -> {
      let fields = record.fields.fold(
        { encoder: encoder, form: [] },
        |accumulator: Built<List<PatternField<Int, BinderPosition>>>, field: { name: Identifier, pattern: Pattern }| {
          let built = pattern_in(accumulator.encoder, field.pattern, again);
          {
            encoder: built.encoder,
            form: accumulator.form.push({ name: field.name.name, pattern: built.form }),
          }
        },
      );
      { encoder: fields.encoder, form: RecordPattern(fields.form, record.rest) }
    },
    PatternList(list) -> {
      let items = patterns(encoder, list.items, again);
      match list.rest {
        None -> { encoder: items.encoder, form: ListPattern(items.form, None) },
        Some(rest) -> {
          let built = pattern_in(items.encoder, rest, again);
          { encoder: built.encoder, form: ListPattern(items.form, Some(built.form)) }
        },
      }
    },
    PatternOr(alternatives) -> {
      let later = match again { Some(_) -> again, None -> Some(encoder.values.len()) };
      let built = range(0, alternatives.alternatives.len()).fold(
        { encoder: encoder, form: [] },
        |accumulator: Built<List<TemplatePattern>>, i: Int| {
          let alternative = pattern_in(
            accumulator.encoder,
            alternatives.alternatives.get(i),
            if i == 0 { again } else { later },
          );
          { encoder: alternative.encoder, form: accumulator.form.push(alternative.form) }
        },
      );
      { encoder: built.encoder, form: OrPattern(built.form) }
    },
    PatternInvalid(_) -> panic("cannot hash a pattern that failed to parse"),
  }

fn expressions(
  encoder: Encoder,
  written: List<Expression>,
) -> Built<List<TemplateExpression>> / {abort.raise} =
  written.fold(
    { encoder: encoder, form: [] },
    |accumulator: Built<List<TemplateExpression>>, each: Expression| {
      let built = expression(accumulator.encoder, each);
      { encoder: built.encoder, form: accumulator.form.push(built.form) }
    },
  )

fn optional_expression(
  encoder: Encoder,
  written: Option<Expression>,
) -> Built<Option<TemplateExpression>> / {abort.raise} =
  match written {
    None -> { encoder: encoder, form: None },
    Some(present) -> {
      let built = expression(encoder, present);
      { encoder: built.encoder, form: Some(built.form) }
    },
  }

fn fields(
  encoder: Encoder,
  written: List<RecordLiteralField>,
) -> Built<List<TemplateField>> / {abort.raise} =
  written.fold(
    { encoder: encoder, form: [] },
    |accumulator: Built<List<TemplateField>>, field: RecordLiteralField| {
      let built = expression(accumulator.encoder, field.value);
      {
        encoder: built.encoder,
        form: accumulator.form.push({ name: field.name.name, value: built.form }),
      }
    },
  )

fn callees(
  encoder: Encoder,
  at: Span,
  name: Identifier,
  names: Bool,
) -> { callees: Callees<Int, BinderPosition>, note: Note } / {abort.raise} = {
  let site = { owner: encoder.owner, site: at.site };
  let note = match encoder.choices {
    Some(chose) -> CallNote(Known(choice_at(chose, site))),
    None -> if names { CallNote(Pending(site)) } else { CallNote(Known({ targets: [] })) },
  };
  match member_of(name.name) {
    Some(member) ->
      {
        callees: InFull(
          value_of(encoder, {
            module: Some({ name: member.of, span: name.span }),
            name: { name: member.member, span: name.span },
            span: name.span,
          }),
        ),
        note: note,
      },
    None -> {
      let index = encoder.index;
      let found = index.scopes.get(encoder.module).visible_modules.fold(
        [],
        |accumulator: List<Int>, seen: Int|
          match index.items.get(seen).members.get(name.name) {
            Some(nodes) -> accumulator.concat(nodes),
            None -> accumulator,
          },
      ).sort_by(|first: Int, second: Int|
        match compare_values(index.nodes.get(first).name, index.nodes.get(second).name) {
          Greater -> false,
          _ -> true,
        });
      { callees: Among(found), note: note }
    },
  }
}

pub fn called_at(sites: List<MemberSite>) -> Map<CallSite, Choice> =
  sites.fold(Map::new(), |accumulator: Map<CallSite, Choice>, site: MemberSite|
    match site.callee {
      CallsFunction(_) ->
        accumulator.insert({ owner: site.owner, site: site.site }, { targets: site.named }),
      _ -> accumulator,
    })

pub fn choice_at(chose: Map<CallSite, Choice>, site: CallSite) -> Choice =
  match chose.get(site) { Some(c) -> c, None -> { targets: [] } }

fn on_value(
  encoder: Encoder,
  base: TemplateExpression,
  at: Span,
  name: Identifier,
  labels: List<Identifier>,
  arguments: List<Expression>,
  named: List<NamedArg>,
) -> Built<TemplateExpression> / {abort.raise} = {
  let passed = expressions(encoder, arguments);
  let given = named.fold(
    { encoder: passed.encoder, form: [] },
    |accumulator: Built<List<TemplateField>>, argument: NamedArg| {
      let built = expression(accumulator.encoder, argument.value);
      {
        encoder: built.encoder,
        form: accumulator.form.push({ name: argument.name.name, value: built.form }),
      }
    },
  );
  let called = callees(given.encoder, at, name, named.len() > 0);
  {
    encoder: given.encoder,
    form: OnValue({
      base: base,
      name: name.name,
      labels: labels.map(|label: Identifier| label_of(encoder, label)),
      arguments: passed.form,
      named: given.form,
      callees: called.callees,
      note: called.note,
    }),
  }
}

fn expression(encoder: Encoder, written: Expression) -> Built<TemplateExpression> / {abort.raise} =
  match written {
    BlockExpression(written_block) -> if written_block.statements.len() == 0 {
      match written_block.tail {
        Some(tail) -> expression(encoder, tail),
        None -> block(encoder, written_block.statements, written_block.tail),
      }
    } else { block(encoder, written_block.statements, written_block.tail) },
    LiteralExpression(constant) -> { encoder: encoder, form: Constant(literal(constant.literal)) },
    HoleExpression(_) -> { encoder: encoder, form: Unwritten },
    NameExpression(variable) ->
      { encoder: read(encoder, variable.name), form: Variable(value_of(encoder, variable.name)) },
    BinaryExpression(binary) -> {
      let left = expression(encoder, binary.left_operand);
      let right = expression(left.encoder, binary.right_operand);
      let called = if emitted_code.operators.contains(binary.operation) {
        emitted_call_nodes(encoder, emitted_code.calls)
      } else { [] };
      { encoder: right.encoder, form: Binary(binary.operation, left.form, right.form, called) }
    },
    UnaryExpression(unary) -> {
      let operand = expression(encoder, unary.operand);
      { encoder: operand.encoder, form: Unary(unary.operation, operand.form) }
    },
    LambdaExpression(lambda) -> {
      let annotations = lambda.params.map(|parameter: Param| optional_type(encoder, parameter.ty));
      let body = expression(
        bind_all(encoder, lambda.params.map(|parameter: Param| parameter.name)),
        lambda.body,
      );
      { encoder: close_scope(body.encoder, encoder), form: Lambda(annotations, body.form) }
    },
    CallExpression(application) -> match application.function {
      FieldExpression(field) -> {
        let base = expression(encoder, field.base);
        on_value(
          base.encoder,
          base.form,
          application.span,
          field.field,
          application.labels,
          application.args,
          application.named,
        )
      },
      _ -> {
        let called = expression(encoder, application.function);
        let arguments = expressions(called.encoder, application.args);
        {
          encoder: arguments.encoder,
          form: Call(
            called.form,
            arguments.form,
            application.labels.map(|label: Identifier| label_of(encoder, label)),
          ),
        }
      },
    },
    IfExpression(conditional) -> {
      let condition = expression(encoder, conditional.cond);
      let then_branch = expression(condition.encoder, conditional.then_branch);
      let else_branch = expression(then_branch.encoder, conditional.else_branch);
      { encoder: else_branch.encoder, form: If(condition.form, then_branch.form, else_branch.form) }
    },
    MatchExpression(matched) -> {
      let scrutinee = expression(encoder, matched.scrutinee);
      let arms = matched.arms.fold(
        { encoder: scrutinee.encoder, form: [] },
        |accumulator: Built<List<Arm<Int, EffectSlot, BinderPosition, Note>>>, arm: MatchArm| {
          let bound = pattern(accumulator.encoder, arm.pattern);
          let guard = optional_expression(bound.encoder, arm.guard);
          let body = expression(guard.encoder, arm.body);
          {
            encoder: close_scope(body.encoder, accumulator.encoder),
            form: accumulator.form.push({
              pattern: bound.form,
              guard: guard.form,
              body: body.form,
            }),
          }
        },
      );
      { encoder: arms.encoder, form: Match(scrutinee.form, arms.form) }
    },
    RecordExpression(record) -> {
      let built = fields(encoder, record.fields);
      { encoder: built.encoder, form: Record(built.form) }
    },
    RecordUpdateExpression(update) -> {
      let base = expression(encoder, update.base);
      let built = fields(base.encoder, update.fields);
      { encoder: built.encoder, form: RecordUpdate(base.form, built.form) }
    },
    PropagateExpression(_) -> panic("`e?` is expanded away before hashing"),
    FieldExpression(field) -> {
      let base = expression(encoder, field.base);
      { encoder: base.encoder, form: Field(base.form, field.field.name) }
    },
    ListExpression(list) -> {
      let items = expressions(encoder, list.items);
      { encoder: items.encoder, form: ListOf(items.form) }
    },
    PerformExpression(perform) -> match local_read(encoder, perform.effect_name) {
      None -> {
        let arguments = expressions(encoder, perform.args);
        {
          encoder: arguments.encoder,
          form: Perform(
            effect_of(encoder, perform.effect_name),
            perform.operation.name,
            optional_label(encoder, perform.resource),
            arguments.form,
          ),
        }
      },
      Some(i) ->
        on_value(
          { ..encoder, reads: encoder.reads.push(i) },
          Variable({ named: Local(encoder.values.get(i).position), written: [] }),
          perform.span,
          perform.operation,
          match perform.resource { Some(resource) -> [resource], None -> [] },
          perform.args,
          [],
        ),
    },
    HandleExpression(handler) -> {
      let variables = handler.handler_variables.fold(
        { encoder: encoder, form: [] },
        |accumulator: Built<List<stored::HandlerVariable<Int, EffectSlot, BinderPosition, Note>>>, variable: HandlerStateVariable| {
          let first = expression(accumulator.encoder, variable.init);
          {
            encoder: bind(first.encoder, variable.name),
            form: accumulator.form.push({
              annotation: optional_type(accumulator.encoder, variable.ty),
              first: first.form,
            }),
          }
        },
      );
      let body = expression(close_scope(variables.encoder, encoder), handler.body);
      let clause_encoder = bind_all(
        close_scope(body.encoder, encoder),
        handler.handler_variables.map(|variable: HandlerStateVariable| variable.name),
      );
      let clauses = handled_clauses(clause_encoder, handler.clauses);
      let returned = match handler.return_clause {
        None -> { encoder: clauses.encoder, form: None },
        Some(clause) -> {
          let built = expression(bind(clauses.encoder, clause.binder), clause.body);
          { encoder: close_scope(built.encoder, clauses.encoder), form: Some(built.form) }
        },
      };
      {
        encoder: close_scope(returned.encoder, encoder),
        form: Handle({
          variables: variables.form,
          body: body.form,
          clauses: clauses.form,
          returned: returned.form,
        }),
      }
    },
    WithScopeExpression(hold) -> {
      let acquire = expression(encoder, hold.acquire);
      let release = expression(acquire.encoder, hold.release);
      let body = expression(bind(release.encoder, hold.binder), hold.body);
      {
        encoder: close_scope(body.encoder, encoder),
        form: WithScope(hold.resource.name, acquire.form, release.form, body.form),
      }
    },
    SimulateExpression(simulated) -> {
      let body = expression(encoder, simulated.body);
      { encoder: body.encoder, form: Simulate(body.form) }
    },
    ParallelExpression(parallel_branches) -> {
      let branches = expressions(encoder, parallel_branches.branches);
      { encoder: branches.encoder, form: Parallel(branches.form) }
    },
    TaggedLiteralExpression(tagged) -> if tagged.holes.len() == 0 {
      { encoder: encoder, form: Tagged(value_of(encoder, tagged_parser(tagged)), tagged.text) }
    } else {
      let holes = tagged.holes.fold(
        { encoder: encoder, form: [] },
        |accumulator: Built<List<FilledHole<Int, EffectSlot, BinderPosition, Note>>>, hole: Hole| {
          let built = expression(accumulator.encoder, hole.value);
          {
            encoder: built.encoder,
            form: accumulator.form.push({ value: built.form, text: hole.text }),
          }
        },
      );
      {
        encoder: holes.encoder,
        form: Filled(
          value_of(encoder, tagged_parser(tagged)),
          value_of(encoder, tagged_filler(tagged)),
          tagged.text,
          holes.form,
        ),
      }
    },
    InvalidExpression(_) -> panic("cannot hash an expression that failed to parse"),
    TryBlockExpression(tried) -> {
      let body = expression(encoder, tried.body);
      {
        encoder: body.encoder,
        form: TryBlock(
          match tried.raise {
            None -> None,
            Some(raised) ->
              Some({
                effect: effect_of(encoder, raised.effect_name),
                operation: raised.operation.name,
              }),
          },
          body.form,
        ),
      }
    },
  }

fn handled_clauses(
  encoder: Encoder,
  clauses: List<HandleClause>,
) -> Built<List<HandlerClause<Int, EffectSlot, BinderPosition, Note>>> / {abort.raise} =
  clauses.fold(
    { encoder: encoder, form: [] },
    |accumulator: Built<List<HandlerClause<Int, EffectSlot, BinderPosition, Note>>>, clause: HandleClause| {
      let bound = bind_all(accumulator.encoder, clause.params);
      let resumed = match clause.resume {
        None -> bound,
        Some(continuation) -> bind(bound, continuation),
      };
      let body = expression(resumed, clause.body);
      {
        encoder: close_scope(body.encoder, accumulator.encoder),
        form: accumulator.form.push({
          effect: effect_of(accumulator.encoder, clause.effect_name),
          operation: clause.operation.name,
          label: optional_label(accumulator.encoder, clause_label(clause)),
          parameters: clause.params.len(),
          resumes: clause.resume != None,
          body: body.form,
        }),
      }
    },
  )

fn block(
  encoder: Encoder,
  statements: List<Statement>,
  tail: Option<Expression>,
) -> Built<TemplateExpression> / {abort.raise} = {
  let entries = entries_in_order(encoder, statements);
  let last = optional_expression(entries.encoder, tail);
  { encoder: close_scope(last.encoder, encoder), form: Block(entries.form, last.form) }
}

fn entries_in_order(
  encoder: Encoder,
  statements: List<Statement>,
) -> Built<List<TemplateEntry>> / {abort.raise} = {
  let count = statements.len();
  let one = |built: Built<List<TemplateEntry>>, written: Statement| {
    let alone = statement(built.encoder, written);
    { encoder: alone.encoder, form: built.form.push(One(alone.form)) }
  };
  iterate(
    { built: { encoder: encoder, form: [] }, at: 0 },
    count + 2,
    |state: { built: Built<List<TemplateEntry>>, at: Int }|
      if state.at >= count { Stop(state) } else {
        let length = pure_run_length(statements, state.at);
        if length < 2 {
          Continue({ built: one(state.built, statements.get(state.at)), at: state.at + 1 })
        } else {
          let members = range(state.at, state.at + length).map(|i: Int| statements.get(i));
          let apart = members.fold({ encoder: state.built.encoder, form: [] }, one);
          if reads_run(state.built.encoder, members) {
            Continue({
              built: { encoder: apart.encoder, form: state.built.form.concat(apart.form) },
              at: state.at + length,
            })
          } else {
            let run = unordered_run_entry(
              state.built.encoder,
              statements,
              state.at,
              state.at + length,
            );
            Continue({
              built: { encoder: run.encoder, form: state.built.form.push(run.form) },
              at: state.at + length,
            })
          }
        }
      },
  ).built
}

fn reads_run(encoder: Encoder, members: List<Statement>) -> Bool / {abort.raise} = {
  let from = encoder.values.len();
  members.fold(
    { encoder: encoder, read: false },
    |accumulator: { encoder: Encoder, read: Bool }, member: Statement| {
      let bound = accumulator.encoder.values.len();
      let before = accumulator.encoder.reads.len();
      let built = statement(accumulator.encoder, member);
      let reads = range(before, built.encoder.reads.len()).map(|i: Int| built.encoder.reads.get(i));
      {
        encoder: built.encoder,
        read: accumulator.read || reads.any(|place: Int| place >= from && place < bound),
      }
    },
  ).read
}

fn unordered_run_entry(
  encoder: Encoder,
  statements: List<Statement>,
  from: Int,
  to: Int,
) -> Built<TemplateEntry> / {abort.raise} = {
  let id = encoder.runs;
  let start = encoder.values.len();
  let members = range(from, to).fold(
    { encoder: { ..encoder, runs: id + 1 }, statements: [], binders: [], bound: [] },
    |accumulator: { encoder: Encoder, statements: List<TemplateStatement>, binders: List<Int>, bound: List<PositionedBinder> }, i: Int| {
      let inner = statement(
        {
          ..accumulator.encoder,
          values: encoder.values,
          scope: { run: id, member: i - from, within: start },
        },
        statements.get(i),
      );
      let bound = range(start, inner.encoder.values.len()).map(|place: Int|
        inner.encoder.values.get(place));
      {
        encoder: { ..inner.encoder, values: encoder.values, scope: encoder.scope },
        statements: accumulator.statements.push(inner.form),
        binders: accumulator.binders.push(bound.len()),
        bound: accumulator.bound.concat(bound),
      }
    },
  );
  {
    encoder: { ..members.encoder, values: encoder.values.concat(members.bound) },
    form: Commuting(
      RunNote({ id: id, base: spot_here(encoder), binders: members.binders }),
      members.statements,
    ),
  }
}

fn statement(encoder: Encoder, written: Statement) -> Built<TemplateStatement> / {abort.raise} =
  match written {
    LetStatement(binding) -> {
      let value = expression(encoder, binding.value);
      let bound = pattern(value.encoder, binding.pattern);
      {
        encoder: bound.encoder,
        form: Let(optional_type(encoder, binding.ty), value.form, bound.form),
      }
    },
    LetElseStatement(binding) -> {
      let value = expression(encoder, binding.value);
      let bound = pattern(value.encoder, binding.pattern);
      let fallback = expression(bound.encoder, binding.fallback);
      {
        encoder: fallback.encoder,
        form: LetElse(optional_type(encoder, binding.ty), value.form, bound.form, fallback.form),
      }
    },
    ExpressionStatement(effectful) -> {
      let built = expression(encoder, effectful);
      { encoder: built.encoder, form: Effectful(built.form) }
    },
    AssignmentStatement(assignment) -> {
      let value = expression(read(encoder, bare(assignment.name)), assignment.value);
      { encoder: value.encoder, form: Assign(value_of(encoder, bare(assignment.name)), value.form) }
    },
  }

fn pure_run_length(statements: List<Statement>, from: Int) -> Int / {abort.raise} = {
  let count = statements.len();
  let to = iterate(from, count - from + 1, |at: Int|
    if at >= count { Stop(at) } else {
      match statements.get(at) {
        LetStatement(binding) -> if is_pure(binding.value) { Continue(at + 1) } else { Stop(at) },
        _ -> Stop(at),
      }
    });
  if to - from < 2 { 0 } else { to - from }
}

fn with_generics(
  encoder: Encoder,
  types: List<Identifier>,
  rows: List<Identifier>,
  labels: List<Identifier>,
) -> Encoder =
  {
    ..encoder,
    type_params: encoder.type_params.concat(types.map(|identifier: Identifier| identifier.name)),
    effect_params: encoder.effect_params.concat(rows.map(|identifier: Identifier| identifier.name)),
    label_params: encoder.label_params.concat(labels.map(|identifier: Identifier| identifier.name)),
  }

fn generics_of(
  types: List<Identifier>,
  rows: List<Identifier>,
  labels: List<Identifier>,
  retained_types: List<Identifier>,
) -> Generics =
  {
    types: types.len(),
    effects: rows.len(),
    labels: labels.len(),
    retained_types: levels_of(types, retained_types),
  }

fn levels_of(names: List<Identifier>, marked: List<Identifier>) -> List<Int> = {
  let marked_names = marked.map(|identifier: Identifier| identifier.name);
  range(0, names.len()).filter(|i: Int|
    match names.at(i) { Some(n) -> marked_names.contains(n.name), None -> false })
}

fn constraints(
  encoder: Encoder,
  written: List<Constraint>,
) -> List<ParameterConstraint> / {abort.raise} =
  sorted_by_key(
    written.fold([], |accumulator: List<ParameterConstraint>, constraint: Constraint|
      match last_index_of(encoder.type_params, constraint.param.name) {
        Some(level) -> accumulator.push({ level: level, deriver: constraint.deriver }),
        None -> accumulator,
      }).map(|constrained: ParameterConstraint|
      { key: bin::encode(constrained, parameter_constraint_bin()), tie: b"", value: constrained }),
  ).fold([], |accumulator: List<ParameterConstraint>, constrained: ParameterConstraint|
    if accumulator.last() == Some(constrained) { accumulator }
    else { accumulator.push(constrained) })

fn identities(encoder: Encoder, definition: FnDefinition) -> List<Int> / {abort.raise} =
  match schema_of(encoder.index.modules.get(encoder.module).module, definition) {
    None -> [],
    Some(schema) -> {
      let levels = schema.identities.fold([], |accumulator: List<Int>, identifier: Identifier|
        match last_index_of(encoder.type_params, identifier.name) {
          Some(level) -> accumulator.push(level),
          None -> accumulator,
        });
      levels.sort().fold([], |accumulator: List<Int>, level: Int|
        if accumulator.last() == Some(level) { accumulator } else { accumulator.push(level) })
    },
  }

fn returning(definition: FnDefinition) -> Returning / {abort.raise} =
  match definition.returns {
    None -> Unstated,
    Some(ReturnsFresh(_)) -> Fresh,
    Some(ReturnsParam(returned)) ->
      ParameterReturned(
        range(0, definition.params.len()).fold(0, |accumulator: Int, i: Int|
          if definition.params.get(i).name.name == returned.name { i } else { accumulator }),
      ),
  }

fn function_form(
  encoder: Encoder,
  definition: FnDefinition,
) -> FunctionForm<Int, EffectSlot, BinderPosition, Note> / {abort.raise} = {
  let generics = definition.generics;
  let generic = with_generics(encoder, generics.types, generics.effects, generics.labels);
  let parameters = definition.params.fold(
    { encoder: generic, form: [] },
    |accumulator: Built<List<stored::Parameter<Int, EffectSlot, BinderPosition, Note>>>, parameter: Param| {
      let default_value = optional_expression(accumulator.encoder, parameter.default);
      {
        encoder: default_value.encoder,
        form: accumulator.form.push({
          retained: parameter.keep,
          spaced: parameter.space != None,
          annotation: optional_type(generic, parameter.ty),
          default: default_value.form,
        }),
      }
    },
  );
  let bound = bind_all(
    parameters.encoder,
    definition.params.map(|parameter: Param| parameter.name),
  );
  let measure = optional_expression(bound, definition.decreases);
  let body = expression(measure.encoder, definition.body);
  {
    generics: generics_of(
      generics.types,
      generics.effects,
      generics.labels,
      generics.retained_types,
    ),
    parameters: parameters.form,
    returned: optional_type(generic, definition.return_type),
    effects: optional_effects(generic, definition.effects),
    constraints: constraints(generic, definition.constraints),
    identities: identities(generic, definition),
    returns: returning(definition),
    decreases: measure.form,
    constant: definition.constant != None,
    body: body.form,
  }
}

fn type_form(
  encoder: Encoder,
  definition: TypeDefinition,
) -> TypeForm<Int, EffectSlot, BinderPosition> / {abort.raise} = {
  let generics = definition.generics;
  let inner = with_generics(encoder, generics.types, generics.effects, generics.labels);
  let unqualified = |name: Identifier| { module: None, name: name, span: name.span };
  let items = inner.index.items.get(inner.module);
  {
    generics: generics_of(
      generics.types,
      generics.effects,
      generics.labels,
      generics.retained_types,
    ),
    has_effect_generics: generics.effects.len() > 0 || generics.labels.len() > 0,
    constraints: constraints(inner, definition.constraints),
    body: match definition.body {
      AliasBody(aliased) -> Alias(type_template(inner, aliased)),
      SumBody(variants) ->
        Sum(
          definition.name.name,
          variants.map(|variant: VariantDefinition|
            { name: variant.name.name, fields: types(inner, variant.fields) }),
        ),
      NominalBody(wrapped) -> Nominal(definition.name.name, type_template(inner, wrapped)),
      ExternBody -> Extern(definition.name.name),
    },
    opaque: definition.opaque != None,
    through: match items.instances.get(definition.name.name) {
      None -> [],
      Some(stated) ->
        stated.filter(|instance: InstanceDefinition| instance.kind != HostInstance).map(
          |instance: InstanceDefinition|
            { kind: instance.kind, by: value_of(inner, unqualified(instance.function)) },
        ),
    },
    numerics: match items.numerics.get(definition.name.name) {
      None -> [],
      Some(arithmetic) ->
        numeric_operations.fold(
          [],
          |accumulator: List<Numeric<Int, BinderPosition>>, operation: Bytes|
            match numeric_by(arithmetic, operation) {
              None -> accumulator,
              Some(function) ->
                accumulator.push({
                  operator: operation,
                  function: value_of(inner, unqualified(function)),
                }),
            },
        ),
    },
  }
}

fn effect_form(
  encoder: Encoder,
  definition: EffectDefinition,
) -> EffectForm<Int, EffectSlot, BinderPosition> / {abort.raise} =
  {
    name: definition.name.name,
    nondet: definition.is_nondet,
    operations: by_name(
      definition.operations.map(|operation: OperationDefinition|
        operation_form(encoder, operation)),
      |operation: Operation<Int, EffectSlot>| operation.name,
    ),
    host_function: match encoder.index.items.get(encoder.module).instances.get(
        definition.name.name,
      ) {
      None -> None,
      Some(stated) ->
        stated.fold(None, |found: Option<TemplateValue>, instance: InstanceDefinition|
          if instance.kind != HostInstance { found } else {
            Some(
              value_of(encoder, {
                module: None,
                name: instance.function,
                span: instance.function.span,
              }),
            )
          }),
    },
  }

fn operation_form(
  encoder: Encoder,
  operation: OperationDefinition,
) -> Operation<Int, EffectSlot> / {abort.raise} = {
  let inner = {
    ..encoder,
    type_params: encoder.type_params.concat(
      operation.type_params.map(|identifier: Identifier| identifier.name),
    ),
  };
  let own = encoder.type_params.len();
  let written = emitted_call_nodes(encoder, marshalling_calls(module_name(encoder)));
  let carried = |t: TemplateType| with_marshalling_calls(t, own, written);
  {
    name: operation.name.name,
    mode: operation.mode,
    resource: operation.resource_param,
    types: operation.type_params.len(),
    parameters: types(inner, operation.params).map(carried),
    retained_parameters: operation.keep_indices,
    returned: carried(type_template(inner, operation.return_type)),
  }
}

fn with_marshalling_calls(t: TemplateType, own: Int, written: List<Int>) -> TemplateType =
  match t {
    Applied(name, w, args) -> {
      let carries = match name { TypeParameter(level) -> level >= own, _ -> false };
      Applied(
        name,
        if carries { w.concat(written) } else { w },
        args.map(|a: TemplateType| with_marshalling_calls(a, own, written)),
      )
    },
    AppliedOver(name, w, args, labels, rows) ->
      AppliedOver(
        name,
        w,
        args.map(|a: TemplateType| with_marshalling_calls(a, own, written)),
        labels,
        rows,
      ),
    Function(params, return_type, encoded_effects, retained_generics, once) ->
      Function(
        params.map(|p: TemplateType| with_marshalling_calls(p, own, written)),
        with_marshalling_calls(return_type, own, written),
        encoded_effects,
        retained_generics,
        once,
      ),
    Fields(fields) ->
      Fields(
        fields.map(|f: TypeField<Int, EffectSlot>|
          { ..f, field_type: with_marshalling_calls(f.field_type, own, written) }),
      ),
    UnitType -> UnitType,
  }

fn test_form(
  encoder: Encoder,
  definition: TestDefinition,
) -> TestForm<Int, EffectSlot, BinderPosition, Note> / {abort.raise} =
  match definition.cases {
    None ->
      {
        nondet: definition.is_nondet,
        cases: None,
        body: expression(encoder, definition.body).form,
      },
    Some(cases) ->
      {
        nondet: definition.is_nondet,
        cases: Some(type_template(encoder, cases.ty)),
        body: expression(bind(encoder, cases.binder), definition.body).form,
      },
  }

fn law_form(
  encoder: Encoder,
  definition: LawDefinition,
) -> LawForm<Int, EffectSlot, BinderPosition, Note> / {abort.raise} = {
  let bound = bind_all(encoder, definition.binders.map(|binder: Binder| binder.name));
  let guard = optional_expression(bound, definition.guard);
  {
    binders: definition.binders.map(|binder: Binder| type_template(encoder, binder.ty)),
    identities: definition.identities.map(|identifier: Identifier| identifier.name).sort().fold(
      [],
      |accumulator: List<Bytes>, name: Bytes|
        if accumulator.last() == Some(name) { accumulator } else { accumulator.push(name) },
    ),
    guard: guard.form,
    body: expression(guard.encoder, definition.body).form,
  }
}

fn spec_form(
  encoder: Encoder,
  owner: FnDefinition,
  clause: SpecClause,
) -> SpecForm<Int, EffectSlot, BinderPosition, Note> / {abort.raise} = {
  let generics = owner.generics;
  let bound = bind_all(
    with_generics(encoder, generics.types, generics.effects, generics.labels),
    owner.params.map(|parameter: Param| parameter.name),
  );
  let named = |names: List<Option<Identifier>>| {
    let places = range(0, names.len()).filter(|i: Int| names.get(i) != None);
    {
      encoder: places.fold(bound, |accumulator: Encoder, i: Int|
        match names.get(i) { Some(name) -> bind(accumulator, name), None -> accumulator }),
      form: Some(places),
    }
  };
  let scoped = match clause.kind {
    EnsuresClause -> { encoder: bind(bound, { name: result_name, span: clause.span }), form: None },
    RequiresClause -> { encoder: bound, form: None },
    SpaceClause -> {
      let spaces = owner.params.map(|parameter: Param| parameter.space);
      if !spaces.any(|space_name: Option<Identifier>| space_name != None) {
        { encoder: bound, form: None }
      } else { named(spaces) }
    },
    CostClause -> named(owner.params.map(|parameter: Param| parameter.cost)),
  };
  {
    kind: clause.kind,
    generics: generics_of(
      generics.types,
      generics.effects,
      generics.labels,
      generics.retained_types,
    ),
    parameters: owner.params.len(),
    names: scoped.form,
    body: expression(scoped.encoder, clause.expression).form,
  }
}

pub fn is_pure(written: Expression) -> Bool =
  match written {
    CallExpression(_) -> false,
    PerformExpression(_) -> false,
    HandleExpression(_) -> false,
    WithScopeExpression(_) -> false,
    SimulateExpression(_) -> false,
    TryBlockExpression(_) -> false,
    ParallelExpression(parallel_branches) -> all_pure(parallel_branches.branches),
    PropagateExpression(_) -> false,
    InvalidExpression(_) -> false,
    HoleExpression(_) -> false,
    LiteralExpression(_) -> true,
    TaggedLiteralExpression(tagged) -> tagged.holes.len() == 0,
    NameExpression(_) -> true,
    BinaryExpression(binary) -> is_pure(binary.left_operand) && is_pure(binary.right_operand),
    UnaryExpression(unary) -> is_pure(unary.operand),
    LambdaExpression(lambda) -> is_pure(lambda.body),
    IfExpression(conditional) ->
      is_pure(conditional.cond) && is_pure(conditional.then_branch)
        && is_pure(conditional.else_branch),
    MatchExpression(matched) ->
      is_pure(matched.scrutinee)
        && matched.arms.fold(true, |accumulator: Bool, arm: MatchArm|
          accumulator && is_pure(arm.body)
            && (match arm.guard { Some(guard) -> is_pure(guard), None -> true })),
    BlockExpression(written_block) ->
      written_block.statements.fold(true, |accumulator: Bool, statement: Statement|
          accumulator
            && (match statement {
              LetStatement(binding) -> is_pure(binding.value),
              LetElseStatement(binding) -> is_pure(binding.value) && is_pure(binding.fallback),
              ExpressionStatement(effectful) -> is_pure(effectful),
              AssignmentStatement(_) -> false,
            }))
        && (match written_block.tail { Some(tail) -> is_pure(tail), None -> true }),
    RecordExpression(record) ->
      all_pure(record.fields.map(|field: RecordLiteralField| field.value)),
    RecordUpdateExpression(update) ->
      is_pure(update.base) && all_pure(update.fields.map(|field: RecordLiteralField| field.value)),
    FieldExpression(field) -> is_pure(field.base),
    ListExpression(list) -> all_pure(list.items),
  }

fn all_pure(written: List<Expression>) -> Bool =
  written.fold(true, |accumulator: Bool, each: Expression| accumulator && is_pure(each))

pub fn renumbered(
  template: Template,
  renumber: (Int) -> Int / {abort.raise},
) -> Template / {abort.raise} =
  template.map(
    reference: renumber,
    slot: |slot: EffectSlot| { ..slot, node: renumber(slot.node) },
    level: |spot: BinderPosition| spot,
    note: |note: Note| note,
  )
