import std.bin

pub type TemplateValue = Value<Int, BinderPosition>

pub type TemplateType = stored::Type<Int, EffectSlot>

pub type TemplateRow = Row<Int, EffectSlot>

pub type TemplatePattern = stored::Pattern<Int, BinderPosition>

pub type TemplateExpression = stored::Expression<Int, EffectSlot, BinderPosition, Note>

pub type TemplateStatement = stored::Statement<Int, EffectSlot, BinderPosition, Note>

type TemplateEntry = Entry<Int, EffectSlot, BinderPosition, Note>

type TemplateField = stored::RecordField<Int, EffectSlot, BinderPosition, Note>

/// What a template is written in: the program and module, the item whose calls on values the check
/// filed under `owner`, the binders in scope, and how many commutable runs the definition has.
/// `scope` is the member of a run being written, with `within` where its binders start among
/// `values`; `run` -1 outside every run. `chose` is what the check found of each call on a value,
/// by `CallSite`; `None` where hashing runs before the check, which leaves each call pending.
/// `reads` is the place in `values` of each binder a name has been resolved to, in order; `locals`
/// the binder of each local the item names, by the site of the name.
pub type Encoder = {
  index: Index,
  module: Int,
  owner: Bytes,
  locals: Map<Int, Int>,
  values: List<PositionedBinder>,
  type_params: List<Bytes>,
  row_params: List<Bytes>,
  label_params: List<Bytes>,
  scope: BinderPosition,
  runs: Int,
  choices: Option<Map<CallSite, Choice>>,
  reads: List<Int>,
}

/// What a walk built and the encoder it leaves.
pub type Built<a> = { encoder: Encoder, form: a }

fn no_scope() -> BinderPosition = { run: 0 - 1, member: 0, within: 0 }

pub fn new_encoder(index: Index, module: Int, locals: Map<Int, Int>) -> Encoder =
  {
    index: index,
    module: module,
    owner: b"",
    locals: locals,
    values: [],
    type_params: [],
    row_params: [],
    label_params: [],
    scope: no_scope(),
    runs: 0,
    choices: Some(Map::new()),
    reads: [],
  }

/// The template of `body` in `module`, each call on a value read as calling what `chose` holds at
/// its site under `owner`.
pub fn node_template(
  index: Index,
  module: Int,
  owner: Bytes,
  chose: Option<Map<CallSite, Choice>>,
  body: NodeBody,
) -> Template / {abort.raise} = {
  let locals = match body {
    NodeFn(definition) -> item_locals(FunctionItem(definition)),
    _ -> Map::new(),
  };
  let encoder = { ..new_encoder(index, module, locals), owner: owner, choices: chose };
  match body {
    NodeFn(definition) -> FunctionOf(function_form(encoder, definition)),
    NodeType(definition) -> TypeOf(type_form(encoder, definition)),
    NodeEffect(definition) -> EffectOf(effect_form(encoder, definition)),
  }
}

pub fn test_template(
  index: Index,
  module: Int,
  owner: Bytes,
  chose: Option<Map<CallSite, Choice>>,
  definition: TestDef,
) -> Template / {abort.raise} =
  TestOf(
    test_form(
      {
        ..new_encoder(index, module, item_locals(TestItem(definition))),
        owner: owner,
        choices: chose,
      },
      definition,
    ),
  )

pub fn law_template(index: Index, module: Int, definition: LawDef) -> Template / {abort.raise} =
  LawOf(law_form(new_encoder(index, module, item_locals(LawItem(definition))), definition))

pub fn spec_template(
  index: Index,
  module: Int,
  owner: FnDef,
  clause: SpecClause,
) -> Template / {abort.raise} =
  SpecOf(spec_form(new_encoder(index, module, item_locals(FunctionItem(owner))), owner, clause))

/// The template of the expression `written` in `module` under the binders `params`, as a test's
/// table and roots are: what it references is all that is read of it.
pub fn expression_template(
  index: Index,
  module: Int,
  params: List<Ident>,
  written: Expr,
) -> TemplateExpression / {abort.raise} =
  expression(
    bind_all(new_encoder(index, module, body_binders(params, written)), params),
    written,
  ).form

// --- Scope -------------------------------------------------------------------------------------

/// Where the next binder stands: within the member being written, if any.
fn spot_here(encoder: Encoder) -> BinderPosition = {
  let count = encoder.values.len();
  if encoder.scope.run < 0 { { run: 0 - 1, member: 0, within: count } }
  else { { ..encoder.scope, within: count - encoder.scope.within } }
}

fn binder_of(encoder: Encoder, name: Ident) -> Int =
  encoder.locals.get(name.span.site).unwrap_or(name.span.site)

fn bind(encoder: Encoder, name: Ident) -> Encoder =
  {
    ..encoder,
    values: encoder.values.push({ binder: binder_of(encoder, name), position: spot_here(encoder) }),
  }

fn bind_all(encoder: Encoder, names: List<Ident>) -> Encoder = names.fold(encoder, bind)

/// Where in `values` the local bound at `binder` is, searching from the last bound.
fn bound_at(values: List<PositionedBinder>, binder: Int) -> Option<Int> / {abort.raise} =
  range(0, values.len()).fold(None, |acc: Option<Int>, i: Int|
    if values.get(i).binder == binder { Some(i) } else { acc })

fn local_read(encoder: Encoder, qname: QName) -> Option<Int> / {abort.raise} =
  if !is_bare(qname) { None } else {
    match encoder.locals.get(qname.name.span.site) {
      Some(b) -> bound_at(encoder.values, b),
      None -> None,
    }
  }

/// `encoder` having read the binder `qname` names, where it names a local.
fn read(encoder: Encoder, qname: QName) -> Encoder / {abort.raise} =
  match local_read(encoder, qname) {
    Some(i) -> { ..encoder, reads: encoder.reads.push(i) },
    None -> encoder,
  }

/// `encoder` with the binders of `inner` dropped: what a scope that closes leaves.
fn close_scope(inner: Encoder, outer: Encoder) -> Encoder = { ..inner, values: outer.values }

// --- What the emitter writes beside the text ---------------------------------------------------

/// The code the emitter writes for a container a body compares, digests, shows or hands the runtime,
/// as `==` of two lists walks them with `List::at` and of two maps walks their entries with
/// `Map::entries`; and for a builtin that builds or walks a list in Ply, as `range` pushes its
/// items: the operators a body writes it for, by name and as the lexer names their tokens, the
/// builtins, and the functions of [`prelude_module`] it calls, by their names there. Code that reads
/// a container back from the runtime also calls `lifts`, as a map read back is built with
/// `Map::insert`. A body that writes one of those references each of what its code calls, so a load
/// that reaches the body reaches them, and a check groups them with it where they reach it back.
pub type EmittedCode = {
  operators: List<Bytes>,
  tokens: List<Bytes>,
  builtins: List<Bytes>,
  calls: List<Bytes>,
  lifts: List<Bytes>,
}

pub fn emitted_code() -> EmittedCode =
  {
    operators: [b"eq", b"ne"],
    tokens: [b"eqeq", b"bangeq"],
    builtins: [
      b"compare",
      b"compare_values",
      b"digest",
      b"reflect",
      b"shown",
      b"assert_eq",
      b"rsa_jwk",
      b"range",
      b"split",
      b"chars",
      b"of_chars",
      b"concat_all",
    ],
    calls: [b"List::at", b"List::push", b"Map::entries"],
    lifts: [b"Map::insert"],
  }

/// What the code the emitter writes where a body names `name` alone calls, by the functions'
/// names in [`prelude_module`]: none where it writes none.
pub fn emitted_calls_for(name: Bytes) -> List<Bytes> =
  if emitted_code().builtins.contains(name) { emitted_code().calls } else { [] }

/// Whether `name` is a container type a root crosses to or from the runtime through code of the
/// prelude: a reference naming one, as a type or as the qualifier of a function, carries what that
/// code calls (`crossed_by`).
pub fn container_named(name: Bytes) -> Bool = name == list_name() || name == map_name()

/// What the code crossing a container to or from the runtime calls (`emitted_code`) where a text
/// of `module` names the container type `name`: a root over one crosses it, at an entry or a
/// perform, though the text names none of that code.
pub fn crossed_by(module: Bytes, name: Bytes) -> List<Bytes> =
  if !container_named(name) { [] } else { crossing_calls(module) }

/// What the code crossing a container to or from the runtime calls (`emitted_code`) where a text of
/// `module` may cross one: an operation's own type parameter stands for whatever type a perform
/// picks, a container among them, which the perform's descriptors cross. The prelude's own texts
/// cross none.
pub fn crossing_calls(module: Bytes) -> List<Bytes> =
  if module == prelude_module() { [] } else { emitted_code().calls.concat(emitted_code().lifts) }

fn module_name(encoder: Encoder) -> Bytes =
  match encoder.index.mods.at(encoder.module) { Some(found) -> found.name, None -> b"" }

/// The prelude's functions `called` names, as the nodes they are.
fn emitted_call_nodes(encoder: Encoder, called: List<Bytes>) -> List<Int> =
  called.fold([], |acc: List<Int>, name: Bytes|
    match encoder.index.written.get(name) { Some(node) -> acc.push(node), None -> acc })

// --- References --------------------------------------------------------------------------------

/// A local binder wins over everything, and only a bare name can be one. A function of a container
/// type carries what crossing the container calls (`crossed_by`), however it resolves and whichever
/// module it is named through: `Map::union` and `map::Map::union` are one reference.
fn value_of(encoder: Encoder, qname: QName) -> TemplateValue / {abort.raise} = {
  let value = resolved(encoder, qname);
  match container_of(qname) {
    Some(container) ->
      {
        ..value,
        written: value.written.concat(
          emitted_call_nodes(encoder, crossed_by(module_name(encoder), container)),
        ),
      },
    None -> value,
  }
}

/// The container type `qname` names a function of: its qualifier, or the type its name is a
/// function of where a module qualifies it.
fn container_of(qname: QName) -> Option<Bytes> / {abort.raise} = {
  let of_member = match member_of(qname.name.name) {
    Some(member) -> if container_named(member.of) { Some(member.of) } else { None },
    None -> None,
  };
  match qualifier(qname) {
    Some(qualified) -> if container_named(qualified) { Some(qualified) } else { of_member },
    None -> of_member,
  }
}

fn resolved(encoder: Encoder, qname: QName) -> TemplateValue / {abort.raise} = {
  let local = local_read(encoder, qname);
  match local {
    Some(i) -> { named: Local(encoder.values.get(i).position), written: [] },
    None -> match value_target(encoder.index, encoder.module, qname) {
      Some(FnTarget(node)) -> { named: Defined(node), written: [] },
      Some(CtorTarget(constructor)) ->
        { named: Constructed(constructor.owner, constructor.name), written: [] },
      // A function of a language type that no module declares is the prelude's, under the one
      // name it has however it is written.
      None -> {
        let called = emitted_call_nodes(encoder, emitted_calls_for(qname.name.name));
        match qualifier(qname) {
          Some(qualified) -> if starts_upper(qualified)
              && encoder.index.scopes.get(encoder.module).modules.get(qualified) == None {
            {
              named: Unbound({ module: None, name: member_name(qualified, qname.name.name) }),
              // An extern function of a declared type, which no node stands for, leads to the type.
              written: match type_target(encoder.index, encoder.module, None, qualified) {
                Some(of) -> [of],
                None -> [],
              },
            }
          } else {
            { named: Unbound({ module: Some(qualified), name: qname.name.name }), written: called }
          },
          None -> { named: Unbound({ module: None, name: qname.name.name }), written: called },
        }
      },
    },
  }
}

fn constructor_named(encoder: Encoder, qname: QName) -> Named<Int, BinderPosition> / {abort.raise} =
  match ctor_target(encoder.index, encoder.module, qname) {
    Some(CtorTarget(constructor)) -> Constructed(constructor.owner, constructor.name),
    _ -> Unbound({ module: qualifier(qname), name: qname.name.name }),
  }

/// Effects are nominal: the declaration referenced, then the slot the component's enumeration gives
/// it. What makes that true is the simple name in the declaration's own encoding; its module path
/// is not, so two modules declaring one effect alike declare one effect. A template's slot is the
/// declaration's node, which filling finds the slot by, and its sketch, which orders atoms equal in
/// their bytes.
fn effect_of(encoder: Encoder, qname: QName) -> Effect<Int, EffectSlot> / {abort.raise} =
  match effect_target(encoder.index, encoder.module, qname) {
    Some(node) ->
      Declared(node, {
        node: node,
        sketch: match encoder.index.effect_sketches.get(node) {
          Some(sketch) -> sketch,
          None -> b"",
        },
      }),
    None -> EffectUnbound({ module: qualifier(qname), name: qname.name.name }),
  }

/// A resource the signature binds is a level, so renaming the binder is not an edit; a real one
/// stays a name.
fn label_of(encoder: Encoder, ident: Ident) -> Label / {abort.raise} =
  match last_index_of(encoder.label_params, ident.name) {
    Some(level) -> LabelParameter(level),
    None -> LabelName(ident.name),
  }

fn optional_label(encoder: Encoder, ident: Option<Ident>) -> Option<Label> / {abort.raise} =
  match ident { None -> None, Some(present) -> Some(label_of(encoder, present)) }

/// A `[*]` clause is not the clause that names no label, so the wildcard is spelled out rather
/// than shared with the empty case. A `[*t]` clause is not a `[*]` one either: naming the label is
/// what the body reads, so the binder is part of what the clause is.
fn clause_label(clause: HandleClause) -> Option<Ident> =
  match clause.label_binder {
    Some(binder) -> Some({ name: b"*".concat(binder.name), span: clause.span }),
    None -> if clause.every_label { Some({ name: b"*", span: clause.span }) }
    else { clause.resource },
  }

/// `[*]` is not the absence of a label, so the wildcard is spelled out and hashes apart from it.
fn atom_label(atom: AtomExpr) -> Option<Ident> =
  if atom.every { Some({ name: b"*", span: atom.span }) } else { atom.resource }

// --- Types -------------------------------------------------------------------------------------

type ResolvedTypeName = { name: TypeName<Int>, written: List<Int> }

fn resolve_type_name(
  encoder: Encoder,
  qualified: Option<Bytes>,
  name: Bytes,
) -> ResolvedTypeName / {abort.raise} = {
  let parameter = match qualified {
    None -> last_index_of(encoder.type_params, name),
    Some(_) -> None,
  };
  match parameter {
    Some(level) -> { name: TypeParameter(level), written: [] },
    None -> match type_target(encoder.index, encoder.module, qualified, name) {
      Some(node) -> { name: TypeDefined(node), written: [] },
      None ->
        {
          name: TypeUnbound({ module: qualified, name: name }),
          written: if qualified == None {
            emitted_call_nodes(encoder, crossed_by(module_name(encoder), name))
          } else { [] },
        },
    },
  }
}

fn optional_type(
  encoder: Encoder,
  written: Option<TypeExpr>,
) -> Option<TemplateType> / {abort.raise} =
  match written { None -> None, Some(present) -> Some(type_template(encoder, present)) }

fn types(encoder: Encoder, written: List<TypeExpr>) -> List<TemplateType> / {abort.raise} =
  written.map(|each: TypeExpr| type_template(encoder, each))

pub fn type_template(encoder: Encoder, written: TypeExpr) -> TemplateType / {abort.raise} =
  match written {
    VariableTypeExpression(name) -> {
      let named = resolve_type_name(encoder, None, name.name);
      Applied(named.name, named.written, [])
    },
    NamedTypeExpression(constructed) -> {
      let named = resolve_type_name(
        encoder,
        qualifier(constructed.name),
        constructed.name.name.name,
      );
      let arguments = types(encoder, constructed.args);
      // Only a use that fills a label or a row writes them, under a form of its own.
      if constructed.labels.len() == 0 && constructed.rows.len() == 0 {
        Applied(named.name, named.written, arguments)
      } else {
        AppliedOver(
          named.name,
          named.written,
          arguments,
          constructed.labels.map(|label: Ident| label_of(encoder, label)),
          constructed.rows.map(|written_row: RowExpr| row(encoder, written_row)),
        )
      }
    },
    FunctionTypeExpression(function) ->
      Function(
        types(encoder, function.params),
        type_template(encoder, function.ret),
        optional_row(encoder, function.effects),
        function.kept,
        function.once,
      ),
    // A record type is a map from label to type: its fields stand in their names' order.
    RecordTypeExpression(record) ->
      Fields(
        by_name(
          record.fields.map(|field: { name: Ident, ty: TypeExpr }|
            { name: field.name.name, field_type: type_template(encoder, field.ty) }),
          |field: TypeField<Int, EffectSlot>| field.name,
        ),
      ),
    UnitTypeExpression(_) -> UnitType,
    InvalidTypeExpression(_) -> UnitType,
  }

/// `members` in the order of their names' encodings, which is where a stored encoding that opens
/// with a name no other member has sorts each one.
fn by_name<a>(members: List<a>, name: (a) -> Bytes) -> List<a> / {abort.raise} =
  sorted_by_key(
    members.map(|member: a|
      { key: bin::encode(name(member), bin::bytes_bin()), tie: b"", value: member }),
  )

/// A set's members, each beside what it sorts by and what orders those equal in it.
type SortKeyed<a> = { key: Bytes, tie: Bytes, value: a }

/// `members` sorted by their keys, then their ties, those equal in both in the order given.
fn sorted_by_key<a>(members: List<SortKeyed<a>>) -> List<a> / {abort.raise} =
  members.sort_by(|first: SortKeyed<a>, second: SortKeyed<a>|
    match compare_values(first.key, second.key) {
      Less -> true,
      Greater -> false,
      Equal -> match compare_values(first.tie, second.tie) { Greater -> false, _ -> true },
    }).map(|member: SortKeyed<a>| member.value)

fn optional_row(encoder: Encoder, written: Option<RowExpr>) -> Option<TemplateRow> / {abort.raise} =
  match written { None -> None, Some(present) -> Some(row(encoder, present)) }

/// A row is a set. Its atoms stand in the order of their encodings with nothing known of what they
/// reference, then of their effects' sketches: the order what they reference is mentioned in, so the
/// slots an enumeration gives its effects follow no order the text wrote. Filling orders them again
/// by their stored encodings and deduplicates them.
fn row(encoder: Encoder, written: RowExpr) -> TemplateRow / {abort.raise} =
  {
    atoms: sorted_by_key(
      written.atoms.map(|written_atom: AtomExpr| {
        let template = atom(encoder, written_atom);
        { key: blank_encoding(template), tie: sketch_of(template), value: template }
      }),
    ),
    tail: match written.tail {
      None -> None,
      Some(tail) -> match last_index_of(encoder.row_params, tail.name) {
        Some(level) -> Some(RowParameter(level)),
        None -> Some(RowName(tail.name)),
      },
    },
    bounded: written.tail_bounded,
  }

fn atom(encoder: Encoder, written: AtomExpr) -> Atom<Int, EffectSlot> / {abort.raise} = {
  let performed = effect_of(encoder, written.effect_name);
  let label = optional_label(encoder, atom_label(written));
  match written.op {
    None -> Moded(performed, written.mode, label, written.bounded),
    Some(operation) -> OfOperation(performed, operation.name, label, written.bounded),
  }
}

/// `atom`'s stored encoding with nothing known: every reference the definition itself, every slot 0.
pub fn blank_encoding(atom: Atom<Int, EffectSlot>) -> Bytes / {abort.raise} =
  bin::encode(
    atom.map(reference: |_: Int| Itself, slot: |_: EffectSlot| 0),
    atom_bin(reference_bin(), bin::int_bin()),
  )

/// The sketch of the effect `atom` names: what orders atoms equal in their bytes.
pub fn sketch_of(atom: Atom<Int, EffectSlot>) -> Bytes =
  match atom {
    Moded(Declared(_, slot), _, _, _) -> slot.sketch,
    OfOperation(Declared(_, slot), _, _, _) -> slot.sketch,
    _ -> b"",
  }

// --- Literals and patterns ---------------------------------------------------------------------

fn literal(written: SourceLiteral) -> Literal / {abort.raise} =
  match written {
    LiteralInt(value) -> IntLiteral(value),
    LiteralFixed(width, bits) -> FixedLiteral(width_index(width).at(0), bits),
    LiteralWide(width, high, low) -> WideLiteral(width_index(width).at(0), high, low),
    LiteralBool(value) -> BoolLiteral(value),
    LiteralString(text) -> StringLiteral(text),
    LiteralBytes(content) -> BytesLiteral(content),
    LiteralEmbedded(digest, size) -> EmbeddedLiteral(digest, size),
    LiteralFloat(text) -> FloatLiteral(float_bits(text)),
    LiteralDecimal(text) -> {
      let parts = decimal_parts(text);
      DecimalLiteral(parts.mantissa, parts.scale)
    },
    LiteralChar(value) -> CharLiteral(value),
    LiteralUnit -> UnitLiteral,
    LiteralInvalid -> panic("a placeholder literal reached the hasher"),
  }

fn pattern(encoder: Encoder, written: Pattern) -> Built<TemplatePattern> / {abort.raise} =
  pattern_in(encoder, written, None)

fn patterns(
  encoder: Encoder,
  written: List<Pattern>,
  again: Option<Int>,
) -> Built<List<TemplatePattern>> / {abort.raise} =
  written.fold({ encoder: encoder, form: [] }, |acc: Built<List<TemplatePattern>>, each: Pattern| {
    let built = pattern_in(acc.encoder, each, again);
    { encoder: built.encoder, form: acc.form.push(built.form) }
  })

/// `again` is where the binders of an or-pattern's first alternative start, inside a later one: a
/// variable there is that alternative's binder of its name, written by its level, and binds
/// nothing more. So one binder stands for a name whichever alternative matched, and which binder
/// each alternative gives it is part of the form.
fn pattern_in(
  encoder: Encoder,
  written: Pattern,
  again: Option<Int>,
) -> Built<TemplatePattern> / {abort.raise} =
  match written {
    PatternWildcard(_) -> { encoder: encoder, form: Wild },
    PatternVariable(variable) -> {
      let earlier = match again {
        None -> None,
        Some(from) -> match bound_at(encoder.values, binder_of(encoder, variable.name)) {
          Some(i) -> if i >= from { Some(i) } else { None },
          None -> None,
        },
      };
      match earlier {
        Some(i) -> { encoder: encoder, form: Again(encoder.values.get(i).position) },
        None -> { encoder: bind(encoder, variable.name), form: Bind },
      }
    },
    PatternLiteral(literal_pattern) ->
      { encoder: encoder, form: LiteralPattern(literal(literal_pattern.lit)) },
    PatternRange(range_pattern) ->
      {
        encoder: encoder,
        form: RangePattern(literal(range_pattern.lo), literal(range_pattern.hi)),
      },
    PatternConstructor(constructed) -> {
      let arguments = patterns(encoder, constructed.args, again);
      {
        encoder: arguments.encoder,
        form: ConstructorPattern(constructor_named(encoder, constructed.name), arguments.form),
      }
    },
    PatternRecord(record) -> {
      let fields = record.fields.fold(
        { encoder: encoder, form: [] },
        |acc: Built<List<PatternField<Int, BinderPosition>>>, field: { name: Ident, pat: Pattern }| {
          let built = pattern_in(acc.encoder, field.pat, again);
          {
            encoder: built.encoder,
            form: acc.form.push({ name: field.name.name, pattern: built.form }),
          }
        },
      );
      { encoder: fields.encoder, form: RecordPattern(fields.form, record.rest) }
    },
    PatternList(list) -> {
      let items = patterns(encoder, list.items, again);
      match list.rest {
        None -> { encoder: items.encoder, form: ListPattern(items.form, None) },
        Some(rest) -> {
          let built = pattern_in(items.encoder, rest, again);
          { encoder: built.encoder, form: ListPattern(items.form, Some(built.form)) }
        },
      }
    },
    PatternOr(alternatives) -> {
      let later = match again { Some(_) -> again, None -> Some(encoder.values.len()) };
      let built = range(0, alternatives.alternatives.len()).fold(
        { encoder: encoder, form: [] },
        |acc: Built<List<TemplatePattern>>, i: Int| {
          let alternative = pattern_in(acc.encoder, alternatives.alternatives.get(i), if i == 0 {
            again
          } else { later });
          { encoder: alternative.encoder, form: acc.form.push(alternative.form) }
        },
      );
      { encoder: built.encoder, form: OrPattern(built.form) }
    },
    PatternInvalid(_) -> panic("a placeholder pattern reached the hasher"),
  }

// --- Expressions -------------------------------------------------------------------------------

fn expressions(
  encoder: Encoder,
  written: List<Expr>,
) -> Built<List<TemplateExpression>> / {abort.raise} =
  written.fold({ encoder: encoder, form: [] }, |acc: Built<List<TemplateExpression>>, each: Expr| {
    let built = expression(acc.encoder, each);
    { encoder: built.encoder, form: acc.form.push(built.form) }
  })

fn optional_expression(
  encoder: Encoder,
  written: Option<Expr>,
) -> Built<Option<TemplateExpression>> / {abort.raise} =
  match written {
    None -> { encoder: encoder, form: None },
    Some(present) -> {
      let built = expression(encoder, present);
      { encoder: built.encoder, form: Some(built.form) }
    },
  }

fn fields(
  encoder: Encoder,
  written: List<RecordLiteralField>,
) -> Built<List<TemplateField>> / {abort.raise} =
  written.fold(
    { encoder: encoder, form: [] },
    |acc: Built<List<TemplateField>>, field: RecordLiteralField| {
      let built = expression(acc.encoder, field.value);
      { encoder: built.encoder, form: acc.form.push({ name: field.name.name, value: built.form }) }
    },
  )

/// What a call on a value written `.name(..)` at `at` may call: `m::f` where it names its function
/// in full, and otherwise every function `X::name` of a module its own can see, in the order of
/// their program-wide names. Which of them it is the value's type says, which no hash reads. The
/// note carries where the check placed each argument the call names, which `names` says it does.
fn callees(
  encoder: Encoder,
  at: Span,
  name: Ident,
  names: Bool,
) -> { callees: Callees<Int, BinderPosition>, note: Note } / {abort.raise} = {
  let site = { owner: encoder.owner, site: at.site };
  let note = match encoder.choices {
    Some(chose) -> CallNote(Known(choice_at(chose, site))),
    None -> if names { CallNote(Pending(site)) } else { CallNote(Known({ named: [] })) },
  };
  match member_of(name.name) {
    Some(member) ->
      {
        callees: InFull(
          value_of(encoder, {
            module: Some({ name: member.of, span: name.span }),
            name: { name: member.member, span: name.span },
            span: name.span,
          }),
        ),
        note: note,
      },
    None -> {
      let index = encoder.index;
      let found = index.scopes.get(encoder.module).visible_modules.fold(
        [],
        |acc: List<Int>, seen: Int|
          match index.items.get(seen).members.get(name.name) {
            Some(nodes) -> acc.concat(nodes),
            None -> acc,
          },
      ).sort_by(|first: Int, second: Int|
        match compare_values(index.nodes.get(first).name, index.nodes.get(second).name) {
          Greater -> false,
          _ -> true,
        });
      { callees: Among(found), note: note }
    },
  }
}

/// Where a check files what it found of a call on a value: the item the call is a node of, by its
/// owner, and the call's site there.
/// What a check found of each call on a value `sites` record, by `CallSite`. A call of a function a
/// record holds in a field calls none of a type's.
pub fn called_at(sites: List<MemberSite>) -> Map<CallSite, Choice> =
  sites.fold(Map::new(), |acc: Map<CallSite, Choice>, site: MemberSite|
    match site.callee {
      CallsFunction(_) -> acc.insert({ owner: site.owner, site: site.site }, { named: site.named }),
      _ -> acc,
    })

/// What the check found of the call at `site` among `chose`: one it says nothing of names no
/// argument.
pub fn choice_at(chose: Map<CallSite, Choice>, site: CallSite) -> Choice =
  match chose.get(site) { Some(c) -> c, None -> { named: [] } }

/// The call `value.name[labels](arguments, named)` written at `at`.
fn on_value(
  encoder: Encoder,
  base: TemplateExpression,
  at: Span,
  name: Ident,
  labels: List<Ident>,
  arguments: List<Expr>,
  named: List<NamedArg>,
) -> Built<TemplateExpression> / {abort.raise} = {
  let passed = expressions(encoder, arguments);
  let given = named.fold(
    { encoder: passed.encoder, form: [] },
    |acc: Built<List<TemplateField>>, argument: NamedArg| {
      let built = expression(acc.encoder, argument.value);
      {
        encoder: built.encoder,
        form: acc.form.push({ name: argument.name.name, value: built.form }),
      }
    },
  );
  let called = callees(given.encoder, at, name, named.len() > 0);
  {
    encoder: given.encoder,
    form: OnValue({
      base: base,
      name: name.name,
      labels: labels.map(|label: Ident| label_of(encoder, label)),
      arguments: passed.form,
      named: given.form,
      callees: called.callees,
      note: called.note,
    }),
  }
}

fn expression(encoder: Encoder, written: Expr) -> Built<TemplateExpression> / {abort.raise} =
  match written {
    // `{ e }` and `e` are the same computation.
    BlockExpression(written_block) -> if written_block.stmts.len() == 0 {
      match written_block.tail {
        Some(tail) -> expression(encoder, tail),
        None -> block(encoder, written_block.stmts, written_block.tail),
      }
    } else { block(encoder, written_block.stmts, written_block.tail) },
    LiteralExpression(constant) -> { encoder: encoder, form: Constant(literal(constant.lit)) },
    HoleExpression(_) -> { encoder: encoder, form: Unwritten },
    NameExpression(variable) ->
      { encoder: read(encoder, variable.name), form: Variable(value_of(encoder, variable.name)) },
    BinaryExpression(binary) -> {
      let left = expression(encoder, binary.lhs);
      let right = expression(left.encoder, binary.rhs);
      let called = if emitted_code().operators.contains(binary.op) {
        emitted_call_nodes(encoder, emitted_code().calls)
      } else { [] };
      { encoder: right.encoder, form: Binary(binary.op, left.form, right.form, called) }
    },
    UnaryExpression(unary) -> {
      let operand = expression(encoder, unary.operand);
      { encoder: operand.encoder, form: Unary(unary.op, operand.form) }
    },
    LambdaExpression(lambda) -> {
      let annotations = lambda.params.map(|parameter: Param| optional_type(encoder, parameter.ty));
      let body = expression(
        bind_all(encoder, lambda.params.map(|parameter: Param| parameter.name)),
        lambda.body,
      );
      { encoder: close_scope(body.encoder, encoder), form: Lambda(annotations, body.form) }
    },
    CallExpression(application) -> match application.func {
      // A call on a value: its named arguments are the call's to fill, and its callee the
      // value's type's to say, so every function it may be is part of what the call is.
      FieldExpression(field) -> {
        let base = expression(encoder, field.base);
        on_value(
          base.encoder,
          base.form,
          application.span,
          field.field,
          application.labels,
          application.args,
          application.named,
        )
      },
      _ -> {
        let called = expression(encoder, application.func);
        let arguments = expressions(called.encoder, application.args);
        {
          encoder: arguments.encoder,
          form: Call(
            called.form,
            arguments.form,
            application.labels.map(|label: Ident| label_of(encoder, label)),
          ),
        }
      },
    },
    IfExpression(conditional) -> {
      let condition = expression(encoder, conditional.cond);
      let then_branch = expression(condition.encoder, conditional.then_branch);
      let else_branch = expression(then_branch.encoder, conditional.else_branch);
      { encoder: else_branch.encoder, form: If(condition.form, then_branch.form, else_branch.form) }
    },
    MatchExpression(matched) -> {
      let scrutinee = expression(encoder, matched.scrutinee);
      let arms = matched.arms.fold(
        { encoder: scrutinee.encoder, form: [] },
        |acc: Built<List<Arm<Int, EffectSlot, BinderPosition, Note>>>, arm: MatchArm| {
          let bound = pattern(acc.encoder, arm.pat);
          let guard = optional_expression(bound.encoder, arm.guard);
          let body = expression(guard.encoder, arm.body);
          {
            encoder: close_scope(body.encoder, acc.encoder),
            form: acc.form.push({ pattern: bound.form, guard: guard.form, body: body.form }),
          }
        },
      );
      { encoder: arms.encoder, form: Match(scrutinee.form, arms.form) }
    },
    RecordExpression(record) -> {
      let built = fields(encoder, record.fields);
      { encoder: built.encoder, form: Record(built.form) }
    },
    // The update is the definition, not the literal it expands to: its meaning follows the base's type.
    RecordUpdateExpression(update) -> {
      let base = expression(encoder, update.base);
      let built = fields(base.encoder, update.fields);
      { encoder: built.encoder, form: RecordUpdate(base.form, built.form) }
    },
    PropagateExpression(_) -> panic("`e?` is expanded away before hashing"),
    FieldExpression(field) -> {
      let base = expression(encoder, field.base);
      { encoder: base.encoder, form: Field(base.form, field.field.name) }
    },
    ListExpression(list) -> {
      let items = expressions(encoder, list.items);
      { encoder: items.encoder, form: ListOf(items.form) }
    },
    PerformExpression(perform) -> match local_read(encoder, perform.effect_name) {
      None -> {
        let arguments = expressions(encoder, perform.args);
        {
          encoder: arguments.encoder,
          form: Perform(
            effect_of(encoder, perform.effect_name),
            perform.op.name,
            optional_label(encoder, perform.resource),
            arguments.form,
          ),
        }
      },
      // On a binding it is a call on the value the binding holds.
      Some(i) ->
        on_value(
          { ..encoder, reads: encoder.reads.push(i) },
          Variable({ named: Local(encoder.values.get(i).position), written: [] }),
          perform.span,
          perform.op,
          match perform.resource { Some(resource) -> [resource], None -> [] },
          perform.args,
          [],
        ),
    },
    HandleExpression(handler) -> {
      // The first values are read where the `handle` stands, before its body, each seeing the
      // variables above it; the clauses and the `return` see the variables, the body does not.
      let variables = handler.vars.fold(
        { encoder: encoder, form: [] },
        |acc: Built<List<stored::HandlerVariable<Int, EffectSlot, BinderPosition, Note>>>, variable: HandlerVar| {
          let first = expression(acc.encoder, variable.init);
          {
            encoder: bind(first.encoder, variable.name),
            form: acc.form.push({
              annotation: optional_type(acc.encoder, variable.ty),
              first: first.form,
            }),
          }
        },
      );
      let body = expression(close_scope(variables.encoder, encoder), handler.body);
      let held = bind_all(
        close_scope(body.encoder, encoder),
        handler.vars.map(|variable: HandlerVar| variable.name),
      );
      let clauses = handled_clauses(held, handler.clauses);
      let returned = match handler.ret {
        None -> { encoder: clauses.encoder, form: None },
        Some(clause) -> {
          let built = expression(bind(clauses.encoder, clause.binder), clause.body);
          { encoder: close_scope(built.encoder, clauses.encoder), form: Some(built.form) }
        },
      };
      {
        encoder: close_scope(returned.encoder, encoder),
        form: Handle({
          variables: variables.form,
          body: body.form,
          clauses: clauses.form,
          returned: returned.form,
        }),
      }
    },
    WithHoldExpression(hold) -> {
      let acquire = expression(encoder, hold.acquire);
      let release = expression(acquire.encoder, hold.release);
      let body = expression(bind(release.encoder, hold.binder), hold.body);
      {
        encoder: close_scope(body.encoder, encoder),
        form: WithHold(hold.resource.name, acquire.form, release.form, body.form),
      }
    },
    SimulateExpression(simulated) -> {
      let body = expression(encoder, simulated.body);
      { encoder: body.encoder, form: Simulate(body.form) }
    },
    ParallelExpression(parallel_branches) -> {
      let branches = expressions(encoder, parallel_branches.branches);
      { encoder: branches.encoder, form: Parallel(branches.form) }
    },
    // Apart from the call it stands for, which has another type and another row.
    TaggedLiteralExpression(tagged) -> if tagged.holes.len() == 0 {
      { encoder: encoder, form: Tagged(value_of(encoder, tagged_parser(tagged)), tagged.text) }
    } else {
      let holes = tagged.holes.fold(
        { encoder: encoder, form: [] },
        |acc: Built<List<FilledHole<Int, EffectSlot, BinderPosition, Note>>>, hole: Hole| {
          let built = expression(acc.encoder, hole.value);
          { encoder: built.encoder, form: acc.form.push({ value: built.form, text: hole.text }) }
        },
      );
      {
        encoder: holes.encoder,
        form: Filled(
          value_of(encoder, tagged_parser(tagged)),
          value_of(encoder, tagged_filler(tagged)),
          tagged.text,
          holes.form,
        ),
      }
    },
    InvalidExpression(_) -> panic("a placeholder reached the hasher"),
    // A `try` that names no raise answers the one its body's row names, which the body settles.
    TryBlockExpression(tried) -> {
      let body = expression(encoder, tried.body);
      {
        encoder: body.encoder,
        form: TryBlock(
          match tried.raise {
            None -> None,
            Some(raised) ->
              Some({ effect: effect_of(encoder, raised.effect_name), operation: raised.op.name }),
          },
          body.form,
        ),
      }
    },
  }

fn handled_clauses(
  encoder: Encoder,
  clauses: List<HandleClause>,
) -> Built<List<Clause<Int, EffectSlot, BinderPosition, Note>>> / {abort.raise} =
  clauses.fold(
    { encoder: encoder, form: [] },
    |acc: Built<List<Clause<Int, EffectSlot, BinderPosition, Note>>>, clause: HandleClause| {
      let bound = bind_all(acc.encoder, clause.params);
      // Whether a clause binds a continuation is part of what the definition is.
      let resumed = match clause.resume {
        None -> bound,
        Some(continuation) -> bind(bound, continuation),
      };
      let body = expression(resumed, clause.body);
      {
        encoder: close_scope(body.encoder, acc.encoder),
        form: acc.form.push({
          effect: effect_of(acc.encoder, clause.effect_name),
          operation: clause.op.name,
          label: optional_label(acc.encoder, clause_label(clause)),
          parameters: clause.params.len(),
          resumes: clause.resume != None,
          body: body.form,
        }),
      }
    },
  )

fn block(
  encoder: Encoder,
  statements: List<Stmt>,
  tail: Option<Expr>,
) -> Built<TemplateExpression> / {abort.raise} = {
  let entries = entries_in_order(encoder, statements);
  let last = optional_expression(entries.encoder, tail);
  { encoder: close_scope(last.encoder, encoder), form: Block(entries.form, last.form) }
}

/// Each statement in turn, consecutive `let`s that commute as one run. A run is ordered where it
/// stands, after the statements before it, so what it reads of an earlier `let` of its block is
/// that binder's level and never its name.
fn entries_in_order(
  encoder: Encoder,
  statements: List<Stmt>,
) -> Built<List<TemplateEntry>> / {abort.raise} = {
  let count = statements.len();
  let one = |built: Built<List<TemplateEntry>>, written: Stmt| {
    let alone = statement(built.encoder, written);
    { encoder: alone.encoder, form: built.form.push(One(alone.form)) }
  };
  iterate(
    { built: { encoder: encoder, form: [] }, at: 0 },
    count + 2,
    |state: { built: Built<List<TemplateEntry>>, at: Int }|
      if state.at >= count { Stop(state) } else {
        let length = pure_run(statements, state.at);
        if length < 2 {
          Continue({ built: one(state.built, statements.get(state.at)), at: state.at + 1 })
        } else {
          let members = range(state.at, state.at + length).map(|i: Int| statements.get(i));
          let apart = members.fold({ encoder: state.built.encoder, form: [] }, one);
          if reads_run(state.built.encoder, members) {
            Continue({
              built: { encoder: apart.encoder, form: state.built.form.concat(apart.form) },
              at: state.at + length,
            })
          } else {
            let run = commuting(state.built.encoder, statements, state.at, state.at + length);
            Continue({
              built: { encoder: run.encoder, form: state.built.form.push(run.form) },
              at: state.at + length,
            })
          }
        }
      },
  ).built
}

/// Whether a member of `members`, written in turn from `encoder`, reads a binder a member before
/// it binds: only `let`s that read none of each other's binders commute. What a name reads is the
/// binder it resolves to, so a binder of the value's own shadows a member's of its name.
fn reads_run(encoder: Encoder, members: List<Stmt>) -> Bool / {abort.raise} = {
  let from = encoder.values.len();
  members.fold(
    { encoder: encoder, read: false },
    |acc: { encoder: Encoder, read: Bool }, member: Stmt| {
      let bound = acc.encoder.values.len();
      let before = acc.encoder.reads.len();
      let built = statement(acc.encoder, member);
      let reads = range(before, built.encoder.reads.len()).map(|i: Int| built.encoder.reads.get(i));
      {
        encoder: built.encoder,
        read: acc.read || reads.any(|place: Int| place >= from && place < bound),
      }
    },
  ).read
}

/// The members of a run, each written from where the run starts: filling orders them by their
/// encodings, ties in source order, and puts each one's binders after those of the members
/// before it.
fn commuting(
  encoder: Encoder,
  statements: List<Stmt>,
  from: Int,
  to: Int,
) -> Built<TemplateEntry> / {abort.raise} = {
  let id = encoder.runs;
  let start = encoder.values.len();
  let members = range(from, to).fold(
    { encoder: { ..encoder, runs: id + 1 }, statements: [], binders: [], bound: [] },
    |acc: { encoder: Encoder, statements: List<TemplateStatement>, binders: List<Int>, bound: List<PositionedBinder> }, i: Int| {
      let inner = statement(
        {
          ..acc.encoder,
          values: encoder.values,
          scope: { run: id, member: i - from, within: start },
        },
        statements.get(i),
      );
      let bound = range(start, inner.encoder.values.len()).map(|place: Int|
        inner.encoder.values.get(place));
      {
        encoder: { ..inner.encoder, values: encoder.values, scope: encoder.scope },
        statements: acc.statements.push(inner.form),
        binders: acc.binders.push(bound.len()),
        bound: acc.bound.concat(bound),
      }
    },
  );
  {
    encoder: { ..members.encoder, values: encoder.values.concat(members.bound) },
    form: Commuting(
      RunNote({ id: id, base: spot_here(encoder), binders: members.binders }),
      members.statements,
    ),
  }
}

fn statement(encoder: Encoder, written: Stmt) -> Built<TemplateStatement> / {abort.raise} =
  match written {
    LetStatement(binding) -> {
      let value = expression(encoder, binding.value);
      let bound = pattern(value.encoder, binding.pat);
      {
        encoder: bound.encoder,
        form: Let(optional_type(encoder, binding.ty), value.form, bound.form),
      }
    },
    LetElseStatement(binding) -> {
      let value = expression(encoder, binding.value);
      let bound = pattern(value.encoder, binding.pat);
      let fallback = expression(bound.encoder, binding.fallback);
      {
        encoder: fallback.encoder,
        form: LetElse(optional_type(encoder, binding.ty), value.form, bound.form, fallback.form),
      }
    },
    ExpressionStatement(effectful) -> {
      let built = expression(encoder, effectful);
      { encoder: built.encoder, form: Effectful(built.form) }
    },
    AssignmentStatement(assignment) -> {
      let value = expression(read(encoder, bare(assignment.name)), assignment.value);
      { encoder: value.encoder, form: Assign(value_of(encoder, bare(assignment.name)), value.form) }
    },
  }

/// How many consecutive `let`s from `from` have pure values: what may commute, fewer than two
/// being no run.
fn pure_run(statements: List<Stmt>, from: Int) -> Int / {abort.raise} = {
  let count = statements.len();
  let to = iterate(from, count - from + 1, |at: Int|
    if at >= count { Stop(at) } else {
      match statements.get(at) {
        LetStatement(binding) -> if is_pure(binding.value) { Continue(at + 1) } else { Stop(at) },
        _ -> Stop(at),
      }
    });
  if to - from < 2 { 0 } else { to - from }
}

// --- Items -------------------------------------------------------------------------------------

fn with_generics(
  encoder: Encoder,
  types: List<Ident>,
  rows: List<Ident>,
  labels: List<Ident>,
) -> Encoder =
  {
    ..encoder,
    type_params: encoder.type_params.concat(types.map(|ident: Ident| ident.name)),
    row_params: encoder.row_params.concat(rows.map(|ident: Ident| ident.name)),
    label_params: encoder.label_params.concat(labels.map(|ident: Ident| ident.name)),
  }

fn generics_of(
  types: List<Ident>,
  rows: List<Ident>,
  labels: List<Ident>,
  kept: List<Ident>,
) -> Generics =
  { types: types.len(), rows: rows.len(), labels: labels.len(), kept: levels_of(types, kept) }

/// The places among `names` of the ones `marked` holds.
fn levels_of(names: List<Ident>, marked: List<Ident>) -> List<Int> = {
  let held = marked.map(|ident: Ident| ident.name);
  range(0, names.len()).filter(|i: Int|
    match names.at(i) { Some(n) -> held.contains(n.name), None -> false })
}

/// Sorted and deduplicated: the same two constraints in the other order are one definition. One over
/// a name no type parameter has constrains nothing.
fn constraints(
  encoder: Encoder,
  written: List<Constraint>,
) -> List<ParameterConstraint> / {abort.raise} =
  sorted_by_key(
    written.fold([], |acc: List<ParameterConstraint>, constraint: Constraint|
      match last_index_of(encoder.type_params, constraint.param.name) {
        Some(level) -> acc.push({ level: level, deriver: constraint.deriver }),
        None -> acc,
      }).map(|constrained: ParameterConstraint|
      { key: bin::encode(constrained, parameter_constraint_bin()), tie: b"", value: constrained }),
  ).fold([], |acc: List<ParameterConstraint>, constrained: ParameterConstraint|
    if acc.last() == Some(constrained) { acc } else { acc.push(constrained) })

/// The levels of the type parameters `identity` constrains in the schema `definition` was made of,
/// where a schema made it.
fn identities(encoder: Encoder, definition: FnDef) -> List<Int> / {abort.raise} =
  match schema_of(encoder.index.mods.get(encoder.module).module, definition) {
    None -> [],
    Some(schema) -> {
      let levels = schema.identities.fold([], |acc: List<Int>, ident: Ident|
        match last_index_of(encoder.type_params, ident.name) {
          Some(level) -> acc.push(level),
          None -> acc,
        });
      levels.sort().fold([], |acc: List<Int>, level: Int|
        if acc.last() == Some(level) { acc } else { acc.push(level) })
    },
  }

/// A `returns` clause names a parameter by its position, so renaming one moves nothing.
fn returning(definition: FnDef) -> Returning / {abort.raise} =
  match definition.returns {
    None -> Unstated,
    Some(ReturnsFresh(_)) -> Fresh,
    Some(ReturnsParam(returned)) ->
      ParameterReturned(
        range(0, definition.params.len()).fold(0, |acc: Int, i: Int|
          if definition.params.get(i).name.name == returned.name { i } else { acc }),
      ),
  }

fn function_form(
  encoder: Encoder,
  definition: FnDef,
) -> FunctionForm<Int, EffectSlot, BinderPosition, Note> / {abort.raise} = {
  let generics = definition.generics;
  let generic = with_generics(encoder, generics.types, generics.effects, generics.labels);
  // Before the parameter names are bound: a default is closed.
  let parameters = definition.params.fold(
    { encoder: generic, form: [] },
    |acc: Built<List<stored::Parameter<Int, EffectSlot, BinderPosition, Note>>>, parameter: Param| {
      let default_value = optional_expression(acc.encoder, parameter.default);
      {
        encoder: default_value.encoder,
        form: acc.form.push({
          kept: parameter.keep,
          spaced: parameter.space != None,
          annotation: optional_type(generic, parameter.ty),
          default: default_value.form,
        }),
      }
    },
  );
  let bound = bind_all(
    parameters.encoder,
    definition.params.map(|parameter: Param| parameter.name),
  );
  // A stated measure decides the definition's verdict, so it is part of what was written.
  let measure = optional_expression(bound, definition.decreases);
  let body = expression(measure.encoder, definition.body);
  {
    generics: generics_of(generics.types, generics.effects, generics.labels, generics.kept),
    parameters: parameters.form,
    returned: optional_type(generic, definition.ret),
    row: optional_row(generic, definition.effects),
    constraints: constraints(generic, definition.constraints),
    identities: identities(generic, definition),
    returns: returning(definition),
    decreases: measure.form,
    // A `const` publishes no raise its body can make, so its callers read another definition.
    constant: definition.constant != None,
    body: body.form,
  }
}

/// A sum and a `new` record are nominal and an alias is transparent, exactly as the checker has
/// them: `conv_type` gives a sum a `TyCon` and a `new` record a `TyNominal` under its name, which
/// `unify_structural` compares by name, and expands an alias in place, so two aliases of one
/// expansion are one type there and must be one type here. The name is the simple one: a module
/// path is no part of an identity, so vendoring a module moves nothing.
fn type_form(
  encoder: Encoder,
  definition: TypeDef,
) -> TypeForm<Int, EffectSlot, BinderPosition> / {abort.raise} = {
  let generics = definition.generics;
  let inner = with_generics(encoder, generics.types, generics.effects, generics.labels);
  let unqualified = |name: Ident| { module: None, name: name, span: name.span };
  let items = inner.index.items.get(inner.module);
  {
    generics: generics_of(generics.types, generics.effects, generics.labels, generics.kept),
    over: generics.effects.len() > 0 || generics.labels.len() > 0,
    // What a use of the type must meet is part of what the type is, as it is of a `fn`.
    constraints: constraints(inner, definition.constraints),
    body: match definition.body {
      AliasBody(aliased) -> Alias(type_template(inner, aliased)),
      SumBody(variants) ->
        Sum(
          definition.name.name,
          variants.map(|variant: VariantDef|
            { name: variant.name.name, fields: types(inner, variant.fields) }),
        ),
      NominalBody(wrapped) -> Nominal(definition.name.name, type_template(inner, wrapped)),
      ExternBody -> Extern(definition.name.name),
    },
    // Unlike `pub`, `opaque` refuses bodies that name nothing of the type's: a literal where a
    // closed record is expected. Only the type's own hash reaches each of them.
    opaque: definition.opaque != None,
    // What a value of the type compares and shows through, and what each satisfies, is part of
    // what the type is: each function is a reference, so the type's hash moves when the function
    // it names does.
    through: match items.instances.get(definition.name.name) {
      None -> [],
      Some(stated) ->
        stated.filter(|instance: InstanceDef| instance.kind != HostInstance).map(
          |instance: InstanceDef|
            { kind: instance.kind, by: value_of(inner, unqualified(instance.by)) },
        ),
    },
    // In the operations' own order, so the order a module wrote them in moves nothing.
    numerics: match items.numerics.get(definition.name.name) {
      None -> [],
      Some(arithmetic) ->
        numeric_ops().fold([], |acc: List<Numeric<Int, BinderPosition>>, operation: Bytes|
          match numeric_by(arithmetic, operation) {
            None -> acc,
            Some(function) ->
              acc.push({ operation: operation, by: value_of(inner, unqualified(function)) }),
          }),
    },
  }
}

/// An effect is nominal: it is the declaration this name declares, not a shape another declaration
/// could match. Two effects differing only in their names are two effects, so the name is in its
/// form: a published row names its atoms' effects, and nothing else would make a hash pin those
/// names. The name is the simple one, so the same declaration vendored under another path is still
/// that declaration. Operations are looked up by name, so they stand in their names' order. Its real
/// handler is a reference, so every definition that performs the effect moves with it, and a load
/// reads it wherever it reads the effect.
fn effect_form(
  encoder: Encoder,
  definition: EffectDef,
) -> EffectForm<Int, EffectSlot, BinderPosition> / {abort.raise} =
  {
    name: definition.name.name,
    nondet: definition.is_nondet,
    operations: by_name(
      definition.operations.map(|operation: OpDef| operation_form(encoder, operation)),
      |operation: Operation<Int, EffectSlot>| operation.name,
    ),
    served: match encoder.index.items.get(encoder.module).instances.get(definition.name.name) {
      None -> None,
      Some(stated) ->
        stated.fold(None, |found: Option<TemplateValue>, instance: InstanceDef|
          if instance.kind != HostInstance { found } else {
            Some(value_of(encoder, { module: None, name: instance.by, span: instance.by.span }))
          }),
    },
  }

/// An operation's own type parameters each carry what crossing a container calls (`crossing_calls`).
fn operation_form(
  encoder: Encoder,
  operation: OpDef,
) -> Operation<Int, EffectSlot> / {abort.raise} = {
  let inner = {
    ..encoder,
    type_params: encoder.type_params.concat(operation.ty_params.map(|ident: Ident| ident.name)),
  };
  let own = encoder.type_params.len();
  let written = emitted_call_nodes(encoder, crossing_calls(module_name(encoder)));
  let carried = |t: TemplateType| with_marshalling_calls(t, own, written);
  {
    name: operation.name.name,
    mode: operation.mode,
    resource: operation.resource_param,
    types: operation.ty_params.len(),
    parameters: types(inner, operation.params).map(carried),
    kept: operation.kept,
    returned: carried(type_template(inner, operation.ret)),
  }
}

/// `t` with each type parameter of a level from `own` carrying `written` besides what it carried.
fn with_marshalling_calls(t: TemplateType, own: Int, written: List<Int>) -> TemplateType =
  match t {
    Applied(name, w, args) -> {
      let carries = match name { TypeParameter(level) -> level >= own, _ -> false };
      Applied(
        name,
        if carries { w.concat(written) } else { w },
        args.map(|a: TemplateType| with_marshalling_calls(a, own, written)),
      )
    },
    AppliedOver(name, w, args, labels, rows) ->
      AppliedOver(
        name,
        w,
        args.map(|a: TemplateType| with_marshalling_calls(a, own, written)),
        labels,
        rows,
      ),
    Function(params, ret, row, kept, once) ->
      Function(
        params.map(|p: TemplateType| with_marshalling_calls(p, own, written)),
        with_marshalling_calls(ret, own, written),
        row,
        kept,
        once,
      ),
    Fields(fields) ->
      Fields(
        fields.map(|f: TypeField<Int, EffectSlot>|
          { ..f, field_type: with_marshalling_calls(f.field_type, own, written) }),
      ),
    UnitType -> UnitType,
  }

/// A test over cases is what one case runs: the case's type and the body over it. Its table and
/// its label are no part of that, so a case added to the table moves no other case's hash.
fn test_form(
  encoder: Encoder,
  definition: TestDef,
) -> TestForm<Int, EffectSlot, BinderPosition, Note> / {abort.raise} =
  match definition.cases {
    None ->
      {
        nondet: definition.is_nondet,
        cases: None,
        body: expression(encoder, definition.body).form,
      },
    Some(cases) ->
      {
        nondet: definition.is_nondet,
        cases: Some(type_template(encoder, cases.ty)),
        body: expression(bind(encoder, cases.binder), definition.body).form,
      },
  }

/// A law's binder types are part of its identity; their names are levels like any other binder.
fn law_form(
  encoder: Encoder,
  definition: LawDef,
) -> LawForm<Int, EffectSlot, BinderPosition, Note> / {abort.raise} = {
  let bound = bind_all(encoder, definition.binders.map(|binder: Binder| binder.name));
  let guard = optional_expression(bound, definition.guard);
  {
    binders: definition.binders.map(|binder: Binder| type_template(encoder, binder.ty)),
    identities: definition.identities.map(|ident: Ident| ident.name).sort().fold(
      [],
      |acc: List<Bytes>, name: Bytes| if acc.last() == Some(name) { acc } else { acc.push(name) },
    ),
    guard: guard.form,
    body: expression(guard.encoder, definition.body).form,
  }
}

/// In its owner's scope: generics, parameters, `result` for an `ensures`, cost names for a `cost`
/// and space names for a `space`. Parameter defaults are not part of it.
fn spec_form(
  encoder: Encoder,
  owner: FnDef,
  clause: SpecClause,
) -> SpecForm<Int, EffectSlot, BinderPosition, Note> / {abort.raise} = {
  let generics = owner.generics;
  let bound = bind_all(
    with_generics(encoder, generics.types, generics.effects, generics.labels),
    owner.params.map(|parameter: Param| parameter.name),
  );
  let named = |names: List<Option<Ident>>| {
    let places = range(0, names.len()).filter(|i: Int| names.get(i) != None);
    {
      encoder: places.fold(bound, |acc: Encoder, i: Int|
        match names.get(i) { Some(name) -> bind(acc, name), None -> acc }),
      form: Some(places),
    }
  };
  let scoped = match clause.kind {
    EnsuresClause ->
      { encoder: bind(bound, { name: result_name(), span: clause.span }), form: None },
    RequiresClause -> { encoder: bound, form: None },
    // A `space` over no parameter that names its space binds none, as one over none named does.
    SpaceClause -> {
      let spaces = owner.params.map(|parameter: Param| parameter.space);
      if !spaces.any(|space_name: Option<Ident>| space_name != None) {
        { encoder: bound, form: None }
      } else { named(spaces) }
    },
    CostClause -> named(owner.params.map(|parameter: Param| parameter.cost)),
  };
  {
    kind: clause.kind,
    generics: generics_of(generics.types, generics.effects, generics.labels, generics.kept),
    parameters: owner.params.len(),
    names: scoped.form,
    body: expression(scoped.encoder, clause.expr).form,
  }
}

// --- Which `let`s commute ----------------------------------------------------------------------

pub fn is_pure(written: Expr) -> Bool =
  match written {
    CallExpression(_) -> false,
    PerformExpression(_) -> false,
    HandleExpression(_) -> false,
    WithHoldExpression(_) -> false,
    SimulateExpression(_) -> false,
    TryBlockExpression(_) -> false,
    ParallelExpression(parallel_branches) -> all_pure(parallel_branches.branches),
    PropagateExpression(_) -> false,
    InvalidExpression(_) -> false,
    HoleExpression(_) -> false,
    LiteralExpression(_) -> true,
    TaggedLiteralExpression(tagged) -> tagged.holes.len() == 0,
    NameExpression(_) -> true,
    BinaryExpression(binary) -> is_pure(binary.lhs) && is_pure(binary.rhs),
    UnaryExpression(unary) -> is_pure(unary.operand),
    LambdaExpression(lambda) -> is_pure(lambda.body),
    IfExpression(conditional) ->
      is_pure(conditional.cond) && is_pure(conditional.then_branch)
        && is_pure(conditional.else_branch),
    MatchExpression(matched) ->
      is_pure(matched.scrutinee)
        && matched.arms.fold(true, |acc: Bool, arm: MatchArm|
          acc && is_pure(arm.body)
            && (match arm.guard { Some(guard) -> is_pure(guard), None -> true })),
    BlockExpression(written_block) ->
      written_block.stmts.fold(true, |acc: Bool, statement: Stmt|
          acc
            && (match statement {
              LetStatement(binding) -> is_pure(binding.value),
              LetElseStatement(binding) -> is_pure(binding.value) && is_pure(binding.fallback),
              ExpressionStatement(effectful) -> is_pure(effectful),
              AssignmentStatement(_) -> false,
            }))
        && (match written_block.tail { Some(tail) -> is_pure(tail), None -> true }),
    RecordExpression(record) ->
      all_pure(record.fields.map(|field: RecordLiteralField| field.value)),
    RecordUpdateExpression(update) ->
      is_pure(update.base) && all_pure(update.fields.map(|field: RecordLiteralField| field.value)),
    FieldExpression(field) -> is_pure(field.base),
    ListExpression(list) -> all_pure(list.items),
  }

fn all_pure(written: List<Expr>) -> Bool =
  written.fold(true, |acc: Bool, each: Expr| acc && is_pure(each))

// --- Another program's numbering ---------------------------------------------------------------

/// `template` with each node it references numbered as `renumber` says: a template taken into a
/// program that numbers its nodes otherwise.
pub fn renumbered(
  template: Template,
  renumber: (Int) -> Int / {abort.raise},
) -> Template / {abort.raise} =
  template.map(
    reference: renumber,
    slot: |slot: EffectSlot| { ..slot, node: renumber(slot.node) },
    level: |spot: BinderPosition| spot,
    note: |note: Note| note,
  )
