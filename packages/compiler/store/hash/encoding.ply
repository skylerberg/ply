//! What hashing reads literals and binders as: the bits a literal's text stands for, the place a
//! binder of a commutable run stands at, and what a check found of a call on a value.

import std.bin
import syntax.lexer (widths)
import syntax.items (SpecKind, SRequires, SEnsures, SCost, SSpace)
import std.bytes (is_digit, u32_le)
import std.list
import std.option
import std.bytes
import std.string

// --- Bytes ------------------------------------------------------------------------------------

/// The position of `v` in `xs`, searching from the end: a binder's de Bruijn level.
pub fn rposition(xs: List<Bytes>, v: Bytes) -> Option<Int> / {abort.raise} =
  range(0, xs.len()).fold(None, |acc: Option<Int>, i: Int|
    if xs.get(i) == v { Some(i) } else { acc })

/// The width's position in `lexer::widths`: the discriminant the encoding writes.
pub fn width_index(ty: Bytes) -> Bytes / {abort.raise} = {
  let want = Bytes::of_string(String::of_bytes(ty).ascii_lower());
  byte_of_int(
    range(0, widths().len()).fold(0, |at: Int, i: Int|
      match widths().at(i) { Some(w) -> if w.name == want { i } else { at }, None -> at }),
  )
}

pub fn i64_le(v: Int) -> Bytes =
  Bytes::concat_all(range(0, 8).map(|i: Int| byte_of_int(v >>> 8 * i & 0xFF)))

pub fn hex_digit(v: Int) -> Bytes / {abort.raise} =
  if v < 10 { byte_of_int(48 + v) } else { byte_of_int(87 + v) }

/// Every byte's two digits, so a byte of `hex` is one lookup.
fn hex_pairs() -> List<Bytes> / {abort.raise} =
  range(0, 256).map(|v: Int| hex_digit(v >>> 4).concat(hex_digit(v & 15)))

pub fn hex(b: Bytes) -> Bytes / {abort.raise} = {
  let pairs = hex_pairs();
  Bytes::concat_all(range(0, b.len()).map(|i: Int| pairs.get(b.at(i))))
}

/// A `Decimal` mantissa has up to 96 bits, more than an `Int`, so it is accumulated a byte at a time.
pub fn i128_le_of_digits(digits: Bytes) -> Bytes / {abort.raise} = {
  let limbs = range(0, digits.len()).fold(range(0, 16).map(|i: Int| 0), |acc: List<Int>, i: Int| {
    let d = digits.at(i) - 48;
    let carried = range(0, 16).fold(
      { limbs: [], carry: d },
      |s: { limbs: List<Int>, carry: Int }, k: Int| {
        let v = acc.get(k) * 10 + s.carry;
        { limbs: s.limbs.push(v & 0xFF), carry: v >>> 8 }
      },
    );
    carried.limbs
  });
  Bytes::concat_all(limbs.map(|v: Int| byte_of_int(v)))
}

pub fn float_bits(text: Bytes) -> Int / {abort.raise} =
  match Float::of_string(String::of_bytes(text)) {
    Some(f) -> bits_of_float(f),
    None -> panic("a float literal the hasher cannot read"),
  }

/// A `Decimal` literal's `(mantissa, scale)`: the digits without the point, and how many followed it.
pub fn decimal_parts(text: Bytes) -> { mantissa: Bytes, scale: Int } / {abort.raise} = {
  let body = text.slice(0, text.len() - 1);
  let split = range(0, body.len()).fold(
    { digits: b"", scale: 0, after: false },
    |s: { digits: Bytes, scale: Int, after: Bool }, i: Int| {
      let c = body.at(i);
      if c == 46 { { ..s, after: true } }
      else if !is_digit(c) { s } else {
        {
          digits: s.digits.concat(byte_of_int(c)),
          scale: if s.after { s.scale + 1 } else { s.scale },
          after: s.after,
        }
      }
    },
  );
  { mantissa: i128_le_of_digits(split.digits), scale: split.scale }
}

// --- Kinds ------------------------------------------------------------------------------------

pub fn spec_tag(k: SpecKind) -> Int =
  match k { SRequires -> 1, SEnsures -> 2, SCost -> 3, SSpace -> 4 }

// --- Binders and calls on values ----------------------------------------------------------------

/// Where the binder a level names stands: `run` -1 for one whose level is fixed where it is written,
/// at `within`; else `within` the binders member `member` of commutable run `run` writes from where
/// that member starts, which the member's place in the run's order decides.
pub type Spot = { run: Int, member: Int, within: Int }

pub type Bound = { name: Bytes, spot: Spot }

/// Which of the functions a call on a value may be the check found it calls, -1 where none is
/// known or the call names its function in full, and the place among that function's parameters,
/// the value's first, of each argument the call names, in the order written.
pub type Choice = { callee: Int, named: List<Int> }

/// What a check found of a call on a value: the function it calls, by its program-wide name, and
/// where each argument it names goes, as [`Choice`] says.
pub type Called = { callee: Bytes, named: List<Int> }

/// A call on a value as hashing that runs before the check leaves it: where the check files what
/// it found of the call ([`site_key`]), and every function the call may be, by program-wide name,
/// in the order the bytes write them.
pub type Site = { at: Bytes, candidates: List<Bytes> }

/// What a filled form says of a call on a value: the check's choice, or the site it is yet to be
/// read from.
pub type Pick = | Found(Choice) | Waiting(Site)

derive bin for Choice

derive bin for Site

derive bin for Pick

derive bin for Spot

// --- Stored bodies back to source ------------------------------------------------------------

pub type Slot = { part: Int, class: Int }

// --- Tests ------------------------------------------------------------------

test "the little-endian encoders write what the reference writes" {
  assert_eq(u32_le(1), b"\x01\x00\x00\x00");
  assert_eq(u32_le(0x01020304), b"\x04\x03\x02\x01");
  assert_eq(i64_le(0 - 1), b"\xff\xff\xff\xff\xff\xff\xff\xff");
  assert_eq(hex(b"\x00\xab\xff"), b"00abff");
  assert_eq(
    i128_le_of_digits(b"256"),
    b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
  )
}

test "a float literal is read as its correctly rounded bit pattern" {
  assert_eq(float_bits(b"1.5"), 0x3FF8000000000000);
  assert_eq(float_bits(b"1e2"), bits_of_float(100.0));
  assert_eq(float_bits(b"2.5e-1"), bits_of_float(0.25));
  assert_eq(float_bits(b"1.0e300"), 0x7E37E43C8800759C);
  assert_eq(float_bits(b"1.0e-30"), 0x39B4484BFEEBC2A0);
  let parts = decimal_parts(b"1.50m");
  assert_eq(parts.scale, 2);
  assert_eq(parts.mantissa.at(0), 150)
}
