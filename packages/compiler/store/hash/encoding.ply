/// An explicit table: renumbering a row invalidates every cached result in every store.
pub fn binop_byte(op: Bytes) -> Int =
  if op == b"add" { 1 }
  else if op == b"sub" { 2 }
  else if op == b"mul" { 3 }
  else if op == b"div" { 4 }
  else if op == b"rem" { 5 }
  else if op == b"eq" { 6 }
  else if op == b"ne" { 7 }
  else if op == b"lt" { 8 }
  else if op == b"le" { 9 }
  else if op == b"gt" { 10 }
  else if op == b"ge" { 11 }
  else if op == b"and" { 12 }
  else if op == b"or" { 13 }
  else if op == b"concat" { 14 }
  else if op == b"bitand" { 15 }
  else if op == b"bitor" { 16 }
  else if op == b"bitxor" { 17 }
  else if op == b"shl" { 18 }
  else if op == b"shr" { 19 }
  else { 20 }

pub fn unop_byte(op: Bytes) -> Int = if op == b"neg" { 1 } else if op == b"not" { 2 } else { 3 }

pub fn mode_byte(mode: Mode) -> Int = match mode { MRead -> 0, MWrite -> 1, MBad -> 0, MRaise -> 2 }

pub fn spec_tag(k: SpecKind) -> Int =
  match k { SRequires -> 1, SEnsures -> 2, SCost -> 3, SSpace -> 4 }

pub fn deriver_byte(deriver: Deriver) -> Int = deriver_tag(deriver) + 1

/// `out` is chunks concatenated once at the end; `refs` is first-mention order; the binder lists are de Bruijn levels.
/// Where the binder a level names stands: `run` -1 for one whose level is fixed where it is written,
/// at `within`; else `within` the binders member `member` of commutable run `run` writes from where
/// that member starts, which the member's place in the run's order decides.
pub type Spot = { run: Int, member: Int, within: Int }

pub type Bound = { name: Bytes, spot: Spot }

/// A normalized form with all that hashing it reads besides the node itself left open: what a
/// reference is written as, an effect's slot in its enumeration, a level a commutable run's order
/// decides, and each set whose order the bytes of its members decide. Filling the holes writes
/// the bytes; the walk over the tree, every name resolved, is made once. `Chose` writes nothing:
/// it is what the check found of the call on a value written just before it, as [`Choice`] says.
/// `Pending` writes nothing either: it is that call hashed before its check, as [`Site`] says.
pub type Piece =
  | Raw(Bytes)
  | Ref(Int)
  | Slot(Int)
  | Level(Spot)
  | Fields(List<List<Piece>>)
  | Atoms(List<AtomForm>)
  | Run(RunForm)
  | Chose(Int, List<Int>)
  | Pending(Bytes, List<Bytes>)

/// A row's atom, and the effect declaration's sketch that orders atoms equal in their bytes.
pub type AtomForm = { pieces: List<Piece>, tie: Bytes }

/// A `let` of a commutable run, and how many binders it writes.
pub type RunMember = { pieces: List<Piece>, binders: Int }

/// `let`s that commute, written in the order their encodings at `base` sort in.
pub type RunForm = { id: Int, base: Spot, members: List<RunMember> }

/// Which of the functions a call on a value may be the check found it calls, -1 where none is
/// known or the call names its function in full, and the place among that function's parameters,
/// the value's first, of each argument the call names, in the order written.
pub type Choice = { callee: Int, named: List<Int> }

/// What a check found of a call on a value: the function it calls, by its program-wide name, and
/// where each argument it names goes, as [`Choice`] says.
pub type Called = { callee: Bytes, named: List<Int> }

/// A call on a value as hashing that runs before the check leaves it: where the check files what
/// it found of the call ([`site_key`]), and every function the call may be, by program-wide name,
/// in the order the bytes write them.
pub type Site = { at: Bytes, candidates: List<Bytes> }

/// What a filled form says of a call on a value: the check's choice, or the site it is yet to be
/// read from.
pub type Pick = | Found(Choice) | Waiting(Site)

derive bin for Choice

derive bin for Site

derive bin for Pick

derive bin for Spot

derive bin for Piece

derive bin for AtomForm

derive bin for RunMember

derive bin for RunForm

pub type Encoder = {
  index: Index,
  module: Int,
  /// The item whose text is encoded, by the owner what its check found of its nodes is filed under.
  owner: Bytes,
  out: List<Piece>,
  values: List<Bound>,
  ty_params: List<Bytes>,
  row_params: List<Bytes>,
  label_params: List<Bytes>,
  /// The member of a commutable run being written, with `within` where its binders start among
  /// `values`; `run` -1 outside every run.
  scope: Spot,
  runs: Int,
  /// What the check found of each call on a value, by `site_key`; `None` where hashing runs
  /// before the check, which leaves each call pending.
  chose: Option<Map<Bytes, Called>>,
}

/// `chosen` is each `Chose` in the order the bytes write it.
pub type Finished = { bytes: Bytes, refs: List<Int>, chosen: List<Pick> }

fn no_scope() -> Spot = { run: 0 - 1, member: 0, within: 0 }

fn new_encoder(index: Index, module: Int) -> Encoder =
  {
    index: index,
    module: module,
    owner: b"",
    out: [],
    values: [],
    ty_params: [],
    row_params: [],
    label_params: [],
    scope: no_scope(),
    runs: 0,
    chose: Some(Map::new()),
  }

/// What `encode` writes from a fresh encoder in `module` of `index`, of what no stored body holds:
/// each call on a value found nothing.
pub fn template_of<| e>(
  index: Index,
  module: Int,
  encode: (Encoder) -> Encoder / e,
) -> List<Piece> / e = compact(encode(new_encoder(index, module)).out)

/// [`template_of`] of the item `owner` names, each call on a value read as calling what `chose`
/// holds at its site.
pub fn chosen_template<| e>(
  index: Index,
  module: Int,
  owner: Bytes,
  chose: Option<Map<Bytes, Called>>,
  encode: (Encoder) -> Encoder / e,
) -> List<Piece> / e =
  compact(encode({ ..new_encoder(index, module), owner: owner, chose: chose }).out)

/// Adjacent bytes joined, so a form holds as many pieces as it has holes.
pub fn compact(pieces: List<Piece>) -> List<Piece> = {
  let flushed = |acc: { out: List<Piece>, raw: List<Bytes> }|
    if acc.raw.len() == 0 { acc.out } else { acc.out.push(Raw(Bytes::concat_all(acc.raw))) };
  flushed(
    pieces.fold({ out: [], raw: [] }, |acc: { out: List<Piece>, raw: List<Bytes> }, p: Piece|
      match p {
        Raw(b) -> { ..acc, raw: acc.raw.push(b) },
        _ -> { out: flushed(acc).push(p), raw: [] },
      }),
  )
}

pub fn put_piece(encoder: Encoder, p: Piece) -> Encoder = { ..encoder, out: encoder.out.push(p) }

pub fn put_bytes(encoder: Encoder, b: Bytes) -> Encoder = put_piece(encoder, Raw(b))

pub fn put_tag(encoder: Encoder, t: Int) -> Encoder / {abort.raise} =
  put_bytes(encoder, byte_of_int(t))

pub fn put_u32(encoder: Encoder, v: Int) -> Encoder = put_bytes(encoder, u32_le(v))

pub fn put_bool(encoder: Encoder, b: Bool) -> Encoder / {abort.raise} =
  put_bytes(encoder, byte_of_int(if b { 1 } else { 0 }))

pub fn put_text(encoder: Encoder, s: Bytes) -> Encoder = put_bytes(put_u32(encoder, s.len()), s)

/// Where the next binder stands: within the member being written, if any.
pub fn spot_here(encoder: Encoder) -> Spot = {
  let n = encoder.values.len();
  if encoder.scope.run < 0 { { run: 0 - 1, member: 0, within: n } }
  else { { ..encoder.scope, within: n - encoder.scope.within } }
}

pub fn bind(encoder: Encoder, name: Bytes) -> Encoder =
  { ..encoder, values: encoder.values.push({ name: name, spot: spot_here(encoder) }) }

pub fn bind_all(encoder: Encoder, names: List<Bytes>) -> Encoder = names.fold(encoder, bind)

/// The binder `name` names, searching from the last bound: its place in `values`.
pub fn bound_at(values: List<Bound>, name: Bytes) -> Option<Int> / {abort.raise} =
  range(0, values.len()).fold(None, |acc: Option<Int>, i: Int|
    if values.get(i).name == name { Some(i) } else { acc })

/// The level of the binder at `i` of `values`: written now where no run's order moves it.
pub fn put_level(encoder: Encoder, i: Int) -> Encoder / {abort.raise} = {
  let spot = encoder.values.get(i).spot;
  if spot.run < 0 { put_u32(encoder, spot.within) } else { put_piece(encoder, Level(spot)) }
}

pub type Captured = { encoder: Encoder, pieces: List<Piece> }

/// The pieces `f` writes, kept apart from the encoding so far.
pub fn capture<| e>(encoder: Encoder, f: (Encoder) -> Encoder / e) -> Captured / e = {
  let inner: Encoder = f({ ..encoder, out: [] });
  { encoder: { ..inner, out: encoder.out }, pieces: compact(inner.out) }
}

pub fn node_ref(encoder: Encoder, node: Int) -> Encoder = put_piece(encoder, Ref(node))

// --- Stored bodies back to source ------------------------------------------------------------

pub type Slot = { part: Int, class: Int }

// --- Tests ------------------------------------------------------------------

test "the little-endian encoders write what the reference writes" {
  assert_eq(u32_le(1), b"\x01\x00\x00\x00");
  assert_eq(u32_le(0x01020304), b"\x04\x03\x02\x01");
  assert_eq(i64_le(0 - 1), b"\xff\xff\xff\xff\xff\xff\xff\xff");
  assert_eq(hex(b"\x00\xab\xff"), b"00abff");
  assert_eq(
    i128_le_of_digits(b"256"),
    b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
  )
}

test "a float literal is read as its correctly rounded bit pattern" {
  assert_eq(float_bits(b"1.5"), 0x3FF8000000000000);
  assert_eq(float_bits(b"1e2"), bits_of_float(100.0));
  assert_eq(float_bits(b"2.5e-1"), bits_of_float(0.25));
  assert_eq(float_bits(b"1.0e300"), 0x7E37E43C8800759C);
  assert_eq(float_bits(b"1.0e-30"), 0x39B4484BFEEBC2A0);
  let parts = decimal_parts(b"1.50m");
  assert_eq(parts.scale, 2);
  assert_eq(parts.mantissa.at(0), 150)
}
