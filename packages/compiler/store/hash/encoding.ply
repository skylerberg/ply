import std.bin
import compiler.syntax.lexer (widths)
import compiler.syntax.items (SpecKind, RequiresClause, EnsuresClause, CostClause, SpaceClause)
import std.bytes (is_digit, u32_le)
import std.list
import std.option
import std.bytes
import std.string

pub fn last_index_of(xs: List<Bytes>, v: Bytes) -> Option<Int> / {abort.raise} =
  range(0, xs.len()).fold(None, |accumulator: Option<Int>, i: Int|
    if xs.get(i) == v { Some(i) } else { accumulator })

pub fn width_index(ty: Bytes) -> Bytes / {abort.raise} = {
  let want = Bytes::of_string(String::of_bytes(ty).ascii_lower());
  byte_of_int(
    range(0, widths.len()).fold(0, |at: Int, i: Int|
      match widths.at(i) { Some(w) -> if w.name == want { i } else { at }, None -> at }),
  )
}

pub fn i64_le(v: Int) -> Bytes =
  Bytes::concat_all(range(0, 8).map(|i: Int| byte_of_int(v >>> 8 * i & 0xFF)))

pub fn hex_digit(v: Int) -> Bytes / {abort.raise} =
  if v < 10 { byte_of_int(48 + v) } else { byte_of_int(87 + v) }

const hex_pairs: List<Bytes> =
  range(0, 256).map(|v: Int| hex_digit(v >>> 4).concat(hex_digit(v & 15)))

pub fn hex(b: Bytes) -> Bytes / {abort.raise} = {
  let pairs = hex_pairs;
  Bytes::concat_all(range(0, b.len()).map(|i: Int| pairs.get(b.at(i))))
}

pub fn i128_le_of_digits(digits: Bytes) -> Bytes / {abort.raise} = {
  let limbs = range(0, digits.len()).fold(
    range(0, 16).map(|i: Int| 0),
    |accumulator: List<Int>, i: Int| {
      let d = digits.at(i) - 48;
      let carried = range(0, 16).fold(
        { limbs: [], widths: d },
        |s: { limbs: List<Int>, widths: Int }, k: Int| {
          let v = accumulator.get(k) * 10 + s.widths;
          { limbs: s.limbs.push(v & 0xFF), widths: v >>> 8 }
        },
      );
      carried.limbs
    },
  );
  Bytes::concat_all(limbs.map(|v: Int| byte_of_int(v)))
}

pub fn float_bits(text: Bytes) -> Int / {abort.raise} =
  match Float::of_string(String::of_bytes(text)) {
    Some(f) -> bits_of_float(f),
    None -> panic("a float literal the hasher cannot read"),
  }

pub fn decimal_parts(text: Bytes) -> { mantissa: Bytes, scale: Int } / {abort.raise} = {
  let body = text.slice(0, text.len() - 1);
  let split = range(0, body.len()).fold(
    { digits: b"", scale: 0, after: false },
    |s: { digits: Bytes, scale: Int, after: Bool }, i: Int| {
      let c = body.at(i);
      if c == 46 { { ..s, after: true } }
      else if !is_digit(c) { s } else {
        {
          digits: s.digits.concat(byte_of_int(c)),
          scale: if s.after { s.scale + 1 } else { s.scale },
          after: s.after,
        }
      }
    },
  );
  { mantissa: i128_le_of_digits(split.digits), scale: split.scale }
}

pub fn spec_tag(k: SpecKind) -> Int =
  match k { RequiresClause -> 1, EnsuresClause -> 2, CostClause -> 3, SpaceClause -> 4 }

pub type BinderPosition = { run: Int, member: Int, within: Int }

pub type PositionedBinder = { binder: Int, position: BinderPosition }

pub type Choice = { targets: List<Int> }

pub type CallSite = { owner: Bytes, site: Int }

pub type CallResolution = | Known(Choice) | Pending(CallSite)

derive bin for Choice

derive bin for CallSite

derive bin for CallResolution

derive bin for BinderPosition

pub type Slot = { part: Int, class: Int }

test "the little-endian encoders return the same bytes as the expected values written out by hand" {
  assert_eq(u32_le(1), b"\x01\x00\x00\x00");
  assert_eq(u32_le(0x01020304), b"\x04\x03\x02\x01");
  assert_eq(i64_le(0 - 1), b"\xff\xff\xff\xff\xff\xff\xff\xff");
  assert_eq(hex(b"\x00\xab\xff"), b"00abff");
  assert_eq(
    i128_le_of_digits(b"256"),
    b"\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
  )
}

test "a float literal is parsed to its correctly rounded bit pattern" {
  assert_eq(float_bits(b"1.5"), 0x3FF8000000000000);
  assert_eq(float_bits(b"1e2"), bits_of_float(100.0));
  assert_eq(float_bits(b"2.5e-1"), bits_of_float(0.25));
  assert_eq(float_bits(b"1.0e300"), 0x7E37E43C8800759C);
  assert_eq(float_bits(b"1.0e-30"), 0x39B4484BFEEBC2A0);
  let parts = decimal_parts(b"1.50m");
  assert_eq(parts.scale, 2);
  assert_eq(parts.mantissa.at(0), 150)
}
