import compiler.syntax.items (Item, TypeItem, SumBody, VariantDefinition, parse)
import compiler.check.resolve.tables (Source)
import std.value
import std.value (Value, VCtor, VList, VRecord, Field, reflect)
import std.list
import std.option
import std.bytes
import std.string
import compiler.store.hash (index_sources, hash_index, checked_body)
import compiler.store.hash.forms (HashOutput, by_name)
import compiler.store.hash.printer (Printed, Unprintable, print_bodies, stored_forms)
import compiler.store.hash.stored (Stored)

fn examples() -> List<Source> =
  [
    { name: b"std.prelude", src: embed("examples/prelude.txt") },
    { name: b"hex", src: embed("examples/hex.txt") },
    { name: b"marks", src: embed("examples/marks.txt") },
    { name: b"lib", src: embed("examples/lib.txt") },
    { name: b"std.map", src: embed("examples/map.txt") },
    { name: b"std.fact", src: embed("examples/host.txt") },
    { name: b"app", src: embed("examples/app.txt") },
  ]

fn declared_variants() -> List<Bytes> / {abort.raise} =
  parse(embed("stored.ply")).node.items.fold([], |acc: List<Bytes>, item: Item|
    match item {
      TypeItem(d) -> match d.body {
        SumBody(vs) -> acc.concat(vs.map(|v: VariantDefinition| v.name.name)),
        _ -> acc,
      },
      _ -> acc,
    })

fn unprinted_variants() -> List<Bytes> =
  [
    b"Itself",
    b"ByName",
    b"CallNote",
    b"RunNote",
    b"LawOf",
    b"SpecOf",
    b"Extern",
    b"EmbeddedLiteral",
  ]

fn constructors(v: Value, seen: Map<Bytes, Bool>) -> Map<Bytes, Bool> =
  match v {
    VCtor(name, args) ->
      args.fold(
        seen.insert(Bytes::of_string(value::constructor_name(name)), true),
        |acc: Map<Bytes, Bool>, a: Value| constructors(a, acc),
      ),
    VList(items) -> items.fold(seen, |acc: Map<Bytes, Bool>, a: Value| constructors(a, acc)),
    VRecord(fields) ->
      fields.fold(seen, |acc: Map<Bytes, Bool>, f: Field| constructors(f.value, acc)),
    _ -> seen,
  }

type RoundTrip = {
  out: HashOutput,
  reprinted: HashOutput,
  texts: List<{ module: Bytes, text: Bytes }>,
}

fn hash_sources(sources: List<Source>) -> HashOutput / {abort.raise} = {
  let out = hash_index(index_sources(sources));
  {
    ..out,
    bodies: out.bodies.map(|b: { name: Bytes, body: Bytes }|
      { ..b, body: checked_body(b.body, Map::new()) }),
    test_bodies: out.test_bodies.fold(
      Map::new(),
      |acc: Map<Bytes, Bytes>, key: Bytes, body: Bytes|
        acc.insert(key, checked_body(body, Map::new())),
    ),
  }
}

fn round_trip(sources: List<Source>) -> RoundTrip / {abort.raise} = {
  let out = hash_sources(sources);
  let names = out.definitions.concat(out.declarations).map(|x: { name: Bytes, hash: Bytes }|
    { name: x.name, hash: x.hash, public: true });
  match print_bodies(
      out.bodies.map(|b: { name: Bytes, body: Bytes }| b.body),
      names,
      out.test_bodies.values(),
      [],
    ) {
    Unprintable(reason) -> panic(String::of_bytes(reason.message)),
    Printed(ms) ->
      {
        out: out,
        reprinted: hash_index(
          index_sources(
            ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, src: m.text }),
          ),
        ),
        texts: ms,
      },
  }
}

test "every definition and test of the examples prints back to what it was stored under" {
  let p = round_trip(examples());
  let before = by_name(p.out.definitions.concat(p.out.declarations));
  let after = by_name(p.reprinted.definitions.concat(p.reprinted.declarations));
  let moved = before.fold([], |acc: List<Bytes>, name: Bytes, hash: Bytes|
    if after.get(name) == Some(hash) { acc } else { acc.push(name) });
  let printed = |name: Bytes|
    p.texts.fold(b"", |acc: Bytes, m: { module: Bytes, text: Bytes }|
      if name.starts_with(m.module.concat(b".")) { m.text } else { acc });
  assert(
    moved.len() == 0,
    Some(
      String::of_bytes_lossy(
        Bytes::concat_all([
          Bytes::join(moved, b", "),
          b" moved; printed as:\n",
          printed(moved.at(0).unwrap_or(b"")),
        ]),
      ),
    ),
  );
  assert_eq(p.reprinted.tests.values().sort(), p.out.tests.values().sort())
}

test "the examples hold every variant a printed stored form can" {
  let out = hash_sources(examples());
  let seen = out.bodies.map(|b: { name: Bytes, body: Bytes }| b.body).concat(
    out.test_bodies.values(),
  ).fold(Map::new(), |acc: Map<Bytes, Bool>, body: Bytes|
    stored_forms(body).fold(acc, |a: Map<Bytes, Bool>, form: Stored|
      constructors(reflect(form), a)));
  let unused = declared_variants().filter(|v: Bytes|
    !seen.contains(v) && !unprinted_variants().contains(v));
  assert(
    unused.len() == 0,
    Some("no example holds " ++ String::of_bytes_lossy(Bytes::join(unused, b", "))),
  )
}
