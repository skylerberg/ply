import compiler.syntax.items (Item, TypeItem, SumBody, VariantDefinition, parse)
import compiler.syntax.expressions (prelude_module)
import compiler.check.resolve.tables (Source, Diagnostic)
import compiler.front.diagnostics (parse_all)
import compiler.front.published (analyse)
import compiler.front.emitter_input (Analysed, Rejected)
import std.value
import std.value (Value, VCtor, VList, VRecord, Field, reflect)
import std.list
import std.option
import std.bytes
import std.string
import compiler.store.hash (index_sources, hash_index, checked_body, body_key)
import compiler.store.hash.forms (HashOutput, ClosureEntry, build_closure, by_name)
import compiler.store.hash.printer (Printed, Unprintable, print_bodies, stored_forms)
import compiler.store.hash.stored (Stored)

fn examples() -> List<Source> =
  [
    { name: b"std.prelude", source_text: embed("examples/prelude.txt") },
    { name: b"hex", source_text: embed("examples/hex.txt") },
    { name: b"marks", source_text: embed("examples/marks.txt") },
    { name: b"lib", source_text: embed("examples/lib.txt") },
    { name: b"std.map", source_text: embed("examples/map.txt") },
    { name: b"std.fact", source_text: embed("examples/host.txt") },
    { name: b"app", source_text: embed("examples/app.txt") },
  ]

fn declared_variants() -> List<Bytes> / {abort.raise} =
  parse(embed("stored.ply")).node.items.fold([], |accumulator: List<Bytes>, item: Item|
    match item {
      TypeItem(d) -> match d.body {
        SumBody(vs) -> accumulator.concat(vs.map(|v: VariantDefinition| v.name.name)),
        _ -> accumulator,
      },
      _ -> accumulator,
    })

fn unprinted_variants() -> List<Bytes> =
  [
    b"Itself",
    b"ByName",
    b"CallNote",
    b"RunNote",
    b"LawOf",
    b"SpecOf",
    b"Extern",
    b"EmbeddedLiteral",
  ]

fn constructors(v: Value, seen: Map<Bytes, Bool>) -> Map<Bytes, Bool> =
  match v {
    VCtor(name, args) ->
      args.fold(
        seen.insert(Bytes::of_string(value::constructor_name(name)), true),
        |accumulator: Map<Bytes, Bool>, a: Value| constructors(a, accumulator),
      ),
    VList(items) ->
      items.fold(seen, |accumulator: Map<Bytes, Bool>, a: Value| constructors(a, accumulator)),
    VRecord(fields) ->
      fields.fold(seen, |accumulator: Map<Bytes, Bool>, f: Field|
        constructors(f.value, accumulator)),
    _ -> seen,
  }

type RoundTrip = {
  out: HashOutput,
  reprinted: HashOutput,
  texts: List<{ module: Bytes, text: Bytes }>,
}

fn hash_sources(sources: List<Source>) -> HashOutput / {abort.raise} = {
  let out = hash_index(index_sources(sources));
  {
    ..out,
    bodies: out.bodies.map(|b: { name: Bytes, body: Bytes }|
      { ..b, body: checked_body(b.body, Map::new()) }),
    test_bodies: out.test_bodies.fold(
      Map::new(),
      |accumulator: Map<Bytes, Bytes>, key: Bytes, body: Bytes|
        accumulator.insert(key, checked_body(body, Map::new())),
    ),
  }
}

fn round_trip(sources: List<Source>) -> RoundTrip / {abort.raise} = {
  let out = hash_sources(sources);
  let names = out.definitions.concat(out.declarations).map(|x: { name: Bytes, hash: Bytes }|
    { name: x.name, hash: x.hash, public: true });
  match print_bodies(
      out.bodies.map(|b: { name: Bytes, body: Bytes }| b.body),
      names,
      out.test_bodies.values(),
      [],
    ) {
    Unprintable(reason) -> panic(String::of_bytes(reason.message)),
    Printed(ms) ->
      {
        out: out,
        reprinted: hash_index(
          index_sources(
            ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, source_text: m.text }),
          ),
        ),
        texts: ms,
      },
  }
}

test "printing every definition and test of the example programs and hashing the text gives back the original hashes" {
  let p = round_trip(examples());
  let before = by_name(p.out.definitions.concat(p.out.declarations));
  let after = by_name(p.reprinted.definitions.concat(p.reprinted.declarations));
  let moved = before.fold([], |accumulator: List<Bytes>, name: Bytes, hash: Bytes|
    if after.get(name) == Some(hash) { accumulator } else { accumulator.push(name) });
  let printed = |name: Bytes|
    p.texts.fold(b"", |accumulator: Bytes, m: { module: Bytes, text: Bytes }|
      if name.starts_with(m.module.concat(b".")) { m.text } else { accumulator });
  assert(
    moved.len() == 0,
    Some(
      String::of_bytes_lossy(
        Bytes::concat_all([
          Bytes::join(moved, b", "),
          b" moved; printed as:\n",
          printed(moved.at(0).unwrap_or(b"")),
        ]),
      ),
    ),
  );
  assert_eq(p.reprinted.tests.values().sort(), p.out.tests.values().sort())
}

fn codes_of(diagnostics: List<Diagnostic>) -> String =
  String::of_bytes_lossy(
    Bytes::join(diagnostics.map(|diagnostic: Diagnostic| diagnostic.code), b", "),
  )

fn checked_again(
  sources: List<Source>,
) -> { before: Map<Bytes, Bytes>, after: Map<Bytes, Bytes> } / {abort.raise} =
  match analyse(parse_all(sources)) {
    Rejected(diagnostics) -> panic("the program failed to check: " ++ codes_of(diagnostics)),
    Analysed(w) -> {
      let named = w.hashes.definitions.concat(w.hashes.declarations);
      match print_bodies(
          w.hashes.bodies.map(|b: { name: Bytes, body: Bytes }| b.body),
          named.map(|x: { name: Bytes, hash: Bytes }| { name: x.name, hash: x.hash, public: true }),
          [],
          [prelude_module()],
        ) {
        Unprintable(reason) -> panic(String::of_bytes(reason.message)),
        Printed(ms) -> {
          let printed = ms.map(|m: { module: Bytes, text: Bytes }|
            { name: m.module, source_text: m.text });
          match analyse(parse_all(printed)) {
            Rejected(diagnostics) ->
              panic(
                "the printed program checks: " ++ codes_of(diagnostics) ++ "\n"
                  ++ String::of_bytes_lossy(
                    Bytes::join(printed.map(|s: Source| s.source_text), b"\n"),
                  ),
              ),
            Analysed(again) ->
              {
                before: by_name(named),
                after: by_name(again.hashes.definitions.concat(again.hashes.declarations)),
              },
          }
        },
      }
    },
  }

test "a program in forms its print takes care over checks again, each definition under its own hash" {
  let p = checked_again([
    { name: b"alternatives", source_text: embed("examples/alternatives.txt") },
    { name: b"promises", source_text: embed("examples/promises.txt") },
    { name: b"scopes", source_text: embed("examples/scopes.txt") },
    { name: b"lib.shapes", source_text: embed("examples/shapes.txt") },
    { name: b"app", source_text: embed("examples/shapes_app.txt") },
  ]);
  assert(p.before.len() > 0);
  assert_eq(p.after, p.before)
}

test "a closure that reaches an effect and not the function of its name prints as a program that checks" {
  let sources = [
    {
      name: b"zb",
      source_text: b"pub effect zb {\n  raise refused(at: Int)\n}\n\nfn written(x: Int) -> Int = x * 31 + 7\n\npub fn zb(x: Int) -> Int = written(x)\n\npub fn read(x: Int) -> Int / {zb.refused} = if x < 0 { zb.refused(x) } else { x + 1 }\n",
    },
    {
      name: b"app",
      source_text: b"import zb\nimport zb (zb)\n\npub fn main() -> Int = match try[zb.refused] { zb::read(1) } { Ok(n) -> n, Err(_) -> 0 }\n",
    },
  ];
  match analyse(parse_all(sources)) {
    Rejected(diagnostics) -> panic("the program failed to check: " ++ codes_of(diagnostics)),
    Analysed(w) -> {
      let closure = build_closure(w.hashes, [b"app.main"]);
      assert(!closure.any(|x: ClosureEntry| x.name == b"zb.written"));
      let reached = closure.map(|x: ClosureEntry| x.hash);
      match print_bodies(
          w.hashes.bodies.filter(|b: { name: Bytes, body: Bytes }|
            match body_key(b.body) { Some(key) -> reached.contains(key), None -> false }).map(
            |b: { name: Bytes, body: Bytes }| b.body,
          ),
          closure.map(|x: ClosureEntry| { name: x.name, hash: x.hash, public: true }),
          [],
          [prelude_module()],
          closure.map(|x: ClosureEntry|
            { name: x.name, hash: x.hash, names: x.refs.map(|i: Int| closure.get(i).name) }),
        ) {
        Unprintable(reason) -> panic(String::of_bytes(reason.message)),
        Printed(ms) -> match analyse(
            parse_all(
              ms.map(|m: { module: Bytes, text: Bytes }| { name: m.module, source_text: m.text }),
            ),
          ) {
          Rejected(diagnostics) -> panic("the printed closure checks: " ++ codes_of(diagnostics)),
          Analysed(_) -> (),
        },
      }
    },
  }
}

test "the example programs produce every kind of stored definition that can be printed as text" {
  let out = hash_sources(examples());
  let seen = out.bodies.map(|b: { name: Bytes, body: Bytes }| b.body).concat(
    out.test_bodies.values(),
  ).fold(Map::new(), |accumulator: Map<Bytes, Bool>, body: Bytes|
    stored_forms(body).fold(accumulator, |a: Map<Bytes, Bool>, form: Stored|
      constructors(reflect(form), a)));
  let unused = declared_variants().filter(|v: Bytes|
    !seen.contains(v) && !unprinted_variants().contains(v));
  assert(
    unused.len() == 0,
    Some("no example holds " ++ String::of_bytes_lossy(Bytes::join(unused, b", "))),
  )
}
