import std.bin
import std.list
import std.option
import std.bytes
import compiler.store.hash.encoding (BinderPosition, CallResolution)
import compiler.store.hash.stored
import compiler.store.hash.stored (Reference, Hashed, Member, Itself, ByName, Note, CallNote,
                                   RunNote, UnorderedStatements, EffectSlot, Value, EffectReference,
                                   Applied, AppliedOver, Function, Fields, UnitType, TypeField,
                                   Effects, Effect, Constant, Unwritten, Variable, Binary, Unary,
                                   Lambda, Call, OnValue, If, Match, Record, RecordUpdate, Field,
                                   ListOf, Perform, Handle, WithScope, Simulate, Parallel, Tagged,
                                   Filled, TryBlock, Block, Arm, HandlerClause, One, Commuting, Let,
                                   LetElse, Effectful, Assign, Alias, Sum, Nominal, Extern, Form,
                                   FunctionOf, TypeOf, EffectOf, TestOf, LawOf, SpecOf, Template,
                                   Stored, reference_bin, effect_bin, statement_bin, stored_bin)

pub type Substitution = {
  hashes: Map<Int, Bytes>,
  component: Map<Int, Int>,
  effects: Map<Int, Int>,
  by_name: Bool,
  names: List<Bytes>,
}

pub fn blank() -> Substitution =
  { hashes: Map::new(), component: Map::new(), effects: Map::new(), by_name: false, names: [] }

pub type FilledForm = { bytes: Bytes, chosen: List<CallResolution> }

pub fn fill(template: Template, filling: Substitution) -> FilledForm / {abort.raise} =
  handle {
    bin::encode(form(filling, template), stored_bin())
  } with {
    var chosen: List<CallResolution> = [],
    resolution_log.record(one) -> {
      chosen = chosen.push(one);
    },
    return bytes -> { bytes: bytes, chosen: chosen },
  }

effect mentions {
  write mention(node: Int) -> Unit
}

fn first_mentions(walk: () -> Unit / {mentions.mention, abort.raise}) -> List<Int> / {abort.raise} =
  handle {
    walk()
  } with {
    var seen: Map<Int, Bool> = Map::new(),
    var order: List<Int> = [],
    mentions.mention(node) -> {
      order = if seen.contains(node) { order } else { order.push(node) };
      seen = seen.insert(node, true);
    },
    return fill -> order,
  }

fn record_reference(node: Int) -> Int / {mentions.mention} = {
  mentions.mention(node);
  node
}

pub fn references(template: Template) -> List<Int> / {abort.raise} =
  first_mentions(|| {
    let _ = template.map(
      reference: record_reference,
      slot: |slot: EffectSlot| slot,
      level: |spot: BinderPosition| spot,
      note: |note: Note| note,
    );
    ()
  })

pub fn type_references(types: List<stored::Type<Int, EffectSlot>>) -> List<Int> / {abort.raise} =
  first_mentions(|| {
    let _ = types.map(|each: stored::Type<Int, EffectSlot>|
      each.map(reference: record_reference, slot: |slot: EffectSlot| slot));
    ()
  })

pub fn expression_references(
  expression: stored::Expression<Int, EffectSlot, BinderPosition, Note>,
) -> List<Int> / {abort.raise} =
  first_mentions(|| {
    let _ = expression.map(
      reference: record_reference,
      slot: |slot: EffectSlot| slot,
      level: |spot: BinderPosition| spot,
      note: |note: Note| note,
    );
    ()
  })

fn reference_of(filling: Substitution, node: Int) -> Reference / {abort.raise} =
  if filling.by_name { ByName(filling.names.get(node)) } else {
    match filling.component.get(node) {
      Some(class) -> Member(class),
      None -> match filling.hashes.get(node) { Some(hash) -> Hashed(hash), None -> Itself },
    }
  }

fn slot_of(filling: Substitution, slot: EffectSlot) -> Int =
  match filling.effects.get(slot.node) { Some(enumerated) -> enumerated, None -> 0 }

type RunLayout = { base: Int, offsets: List<Int> }

type Runs = Map<Int, RunLayout>

fn level_of(runs: Runs, spot: BinderPosition) -> Int / {abort.raise} =
  if spot.run < 0 { spot.within } else {
    match runs.get(spot.run) {
      Some(placed) -> placed.base + placed.offsets.get(spot.member) + spot.within,
      None ->
        panic("a binder refers to a group of unordered statements that has no recorded offsets"),
    }
  }

type StoredExpression = stored::Expression<Reference, Int, Int, Unit>

type StoredStatement = stored::Statement<Reference, Int, Int, Unit>

type TemplateType = stored::Type<Int, EffectSlot>

type TemplateExpression = stored::Expression<Int, EffectSlot, BinderPosition, Note>

type TemplateStatement = stored::Statement<Int, EffectSlot, BinderPosition, Note>

effect resolution_log {
  write record(chosen: CallResolution) -> Unit
}

fn record_resolution(note: Note) -> Unit / {resolution_log.record, abort.raise} =
  match note {
    CallNote(chosen) -> resolution_log.record(chosen),
    RunNote(_) ->
      panic(
        "cannot record a call's resolution: the note marks a group of unordered statements, not a call",
      ),
  }

fn without_resolutions<a>(
  work: () -> a / {resolution_log.record, abort.raise},
) -> a / {abort.raise} = handle { work() } with { resolution_log.record(one) -> () }

fn filled_type(
  filling: Substitution,
  template: TemplateType,
) -> stored::Type<Reference, Int> / {abort.raise} =
  sort_effects_in(
    template.map(
      reference: |node: Int| reference_of(filling, node),
      slot: |slot: EffectSlot| slot_of(filling, slot),
    ),
  )

fn filled_effects(
  filling: Substitution,
  template: Effects<Int, EffectSlot>,
) -> Effects<Reference, Int> / {abort.raise} =
  sort_effects({
    ..template,
    listed: template.listed.map(|entry: Effect<Int, EffectSlot>|
      entry.map(
        reference: |node: Int| reference_of(filling, node),
        slot: |slot: EffectSlot| slot_of(filling, slot),
      )),
  })

fn sort_effects_in(
  original: stored::Type<Reference, Int>,
) -> stored::Type<Reference, Int> / {abort.raise} =
  match original {
    Applied(name, written, arguments) -> Applied(name, written, arguments.map(sort_effects_in)),
    AppliedOver(name, written, arguments, labels, rows) ->
      AppliedOver(name, written, arguments.map(sort_effects_in), labels, rows.map(sort_effects)),
    Function(parameters, returned, effects, retention, once) ->
      Function(
        parameters.map(sort_effects_in),
        sort_effects_in(returned),
        effects.map(sort_effects),
        retention,
        once,
      ),
    Fields(fields) ->
      Fields(
        fields.map(|field: TypeField<Reference, Int>|
          { name: field.name, field_type: sort_effects_in(field.field_type) }),
      ),
    UnitType -> UnitType,
  }

type KeyedEffect = { key: Bytes, entry: Effect<Reference, Int> }

fn sort_effects(effects: Effects<Reference, Int>) -> Effects<Reference, Int> / {abort.raise} = {
  let codec = effect_bin(reference_bin(), bin::int_bin());
  let keyed = effects.listed.map(|entry: Effect<Reference, Int>|
    { key: bin::encode(entry, codec), entry: entry });
  let sorted = keyed.sort_by(|first: KeyedEffect, second: KeyedEffect|
    match compare_values(first.key, second.key) { Greater -> false, _ -> true });
  let distinct = sorted.fold([], |accumulator: List<KeyedEffect>, next: KeyedEffect|
    match accumulator.last() {
      Some(previous) -> if previous.key == next.key { accumulator } else { accumulator.push(next) },
      None -> accumulator.push(next),
    });
  { ..effects, listed: distinct.map(|each: KeyedEffect| each.entry) }
}

type Scope = { filling: Substitution, runs: Runs }

fn value_of(
  scope: Scope,
  value: Value<Int, BinderPosition>,
) -> Value<Reference, Int> / {abort.raise} =
  {
    named: value.named.map(
      reference: |node: Int| reference_of(scope.filling, node),
      level: |spot: BinderPosition| level_of(scope.runs, spot),
    ),
    written: value.written.map(|node: Int| reference_of(scope.filling, node)),
  }

fn effect_of(
  scope: Scope,
  performed: EffectReference<Int, EffectSlot>,
) -> EffectReference<Reference, Int> / {abort.raise} =
  performed.map(
    reference: |node: Int| reference_of(scope.filling, node),
    slot: |slot: EffectSlot| slot_of(scope.filling, slot),
  )

fn pattern_of(
  scope: Scope,
  pattern: stored::Pattern<Int, BinderPosition>,
) -> stored::Pattern<Reference, Int> / {abort.raise} =
  pattern.map(
    reference: |node: Int| reference_of(scope.filling, node),
    level: |spot: BinderPosition| level_of(scope.runs, spot),
  )

fn optional_type(
  scope: Scope,
  annotation: Option<TemplateType>,
) -> Option<stored::Type<Reference, Int>> / {abort.raise} =
  annotation.map(|present: TemplateType| filled_type(scope.filling, present))

fn expressions(
  scope: Scope,
  templates: List<TemplateExpression>,
) -> List<StoredExpression> / {resolution_log.record, abort.raise} =
  templates.map(|each: TemplateExpression| expression(scope, each))

fn optional_expression(
  scope: Scope,
  template: Option<TemplateExpression>,
) -> Option<StoredExpression> / {resolution_log.record, abort.raise} =
  template.map(|present: TemplateExpression| expression(scope, present))

fn record_fields(
  scope: Scope,
  fields: List<stored::RecordField<Int, EffectSlot, BinderPosition, Note>>,
) -> List<stored::RecordField<Reference, Int, Int, Unit>> / {resolution_log.record, abort.raise} =
  fields.map(|field: stored::RecordField<Int, EffectSlot, BinderPosition, Note>|
    { name: field.name, value: expression(scope, field.value) })

fn expression(
  scope: Scope,
  template: TemplateExpression,
) -> StoredExpression / {resolution_log.record, abort.raise} = {
  let references = |nodes: List<Int>| nodes.map(|node: Int| reference_of(scope.filling, node));
  match template {
    Constant(literal) -> Constant(literal),
    Unwritten -> Unwritten,
    Variable(value) -> Variable(value_of(scope, value)),
    Binary(operator, left, right, written) ->
      Binary(operator, expression(scope, left), expression(scope, right), references(written)),
    Unary(operator, operand) -> Unary(operator, expression(scope, operand)),
    Lambda(annotations, body) ->
      Lambda(
        annotations.map(|annotation: Option<TemplateType>| optional_type(scope, annotation)),
        expression(scope, body),
      ),
    Call(called, arguments, labels) ->
      Call(expression(scope, called), expressions(scope, arguments), labels),
    OnValue(call) ->
      OnValue({
        base: expression(scope, call.base),
        name: call.name,
        labels: call.labels,
        arguments: expressions(scope, call.arguments),
        named: record_fields(scope, call.named),
        callees: call.callees.map(
          reference: |node: Int| reference_of(scope.filling, node),
          level: |spot: BinderPosition| level_of(scope.runs, spot),
        ),
        note: record_resolution(call.note),
      }),
    If(condition, then_branch, else_branch) ->
      If(
        expression(scope, condition),
        expression(scope, then_branch),
        expression(scope, else_branch),
      ),
    Match(scrutinee, arms) ->
      Match(
        expression(scope, scrutinee),
        arms.map(|arm: Arm<Int, EffectSlot, BinderPosition, Note>|
          {
            pattern: pattern_of(scope, arm.pattern),
            guard: optional_expression(scope, arm.guard),
            body: expression(scope, arm.body),
          }),
      ),
    Record(fields) -> Record(record_fields(scope, fields)),
    RecordUpdate(base, fields) ->
      RecordUpdate(expression(scope, base), record_fields(scope, fields)),
    Field(base, name) -> Field(expression(scope, base), name),
    ListOf(items) -> ListOf(expressions(scope, items)),
    Perform(performed, operation, label, arguments) ->
      Perform(effect_of(scope, performed), operation, label, expressions(scope, arguments)),
    Handle(handled) ->
      Handle({
        variables: handled.variables.map(
          |variable: stored::HandlerVariable<Int, EffectSlot, BinderPosition, Note>|
            {
              annotation: optional_type(scope, variable.annotation),
              first: expression(scope, variable.first),
            },
        ),
        body: expression(scope, handled.body),
        clauses: handled.clauses.map(
          |clause: HandlerClause<Int, EffectSlot, BinderPosition, Note>|
            {
              effect: effect_of(scope, clause.effect),
              operation: clause.operation,
              label: clause.label,
              parameters: clause.parameters,
              resumes: clause.resumes,
              body: expression(scope, clause.body),
            },
        ),
        returned: optional_expression(scope, handled.returned),
      }),
    WithScope(resource, acquire, release, body) ->
      WithScope(
        resource,
        expression(scope, acquire),
        expression(scope, release),
        expression(scope, body),
      ),
    Simulate(body) -> Simulate(expression(scope, body)),
    Parallel(branches) -> Parallel(expressions(scope, branches)),
    Tagged(parser, text) -> Tagged(value_of(scope, parser), text),
    Filled(parser, filler, head, holes) ->
      Filled(
        value_of(scope, parser),
        value_of(scope, filler),
        head,
        holes.map(|hole: stored::FilledHole<Int, EffectSlot, BinderPosition, Note>|
          { value: expression(scope, hole.value), text: hole.text }),
      ),
    TryBlock(raised, body) ->
      TryBlock(
        raised.map(|given: stored::RaisedOperation<Int, EffectSlot>|
          { effect: effect_of(scope, given.effect), operation: given.operation }),
        expression(scope, body),
      ),
    Block(entries, tail) -> {
      let written = entries.fold(
        { runs: scope.runs, entries: [] },
        |accumulator: { runs: Runs, entries: List<stored::Entry<Reference, Int, Int, Unit>> }, entry: stored::Entry<Int, EffectSlot, BinderPosition, Note>|
          match entry {
            One(alone) ->
              {
                runs: accumulator.runs,
                entries: accumulator.entries.push(
                  One(statement({ ..scope, runs: accumulator.runs }, alone)),
                ),
              },
            Commuting(RunNote(at), members) -> {
              let placed = run({ ..scope, runs: accumulator.runs }, at, members);
              { runs: placed.runs, entries: accumulator.entries.push(placed.entry) }
            },
            Commuting(CallNote(_), _) ->
              panic(
                "a group of unordered statements has a call's note where the note for a group is required",
              ),
          },
      );
      Block(written.entries, optional_expression({ ..scope, runs: written.runs }, tail))
    },
  }
}

fn run(
  scope: Scope,
  at: UnorderedStatements,
  members: List<TemplateStatement>,
) -> { runs: Runs, entry: stored::Entry<Reference, Int, Int, Unit> } / {resolution_log.record, abort.raise} = {
  let base = level_of(scope.runs, at.base);
  let count = members.len();
  let unordered = {
    ..scope,
    runs: scope.runs.insert(at.id, { base: base, offsets: range(0, count).map(|_: Int| 0) }),
  };
  let codec = statement_bin(reference_bin(), bin::int_bin(), bin::int_bin(), bin::unit_bin());
  let keys = members.map(|member: TemplateStatement|
    bin::encode(without_resolutions(|| statement(unordered, member)), codec));
  let order = range(0, count).sort_by(|first: Int, second: Int|
    match compare_values(keys.get(first), keys.get(second)) {
      Less -> true,
      Greater -> false,
      Equal -> first <= second,
    });
  let offsets = order.fold(
    { next: 0, offsets: range(0, count).map(|_: Int| 0) },
    |accumulator: { next: Int, offsets: List<Int> }, member: Int|
      {
        next: accumulator.next + at.binders.get(member),
        offsets: accumulator.offsets.set(member, accumulator.next),
      },
  ).offsets;
  let runs = scope.runs.insert(at.id, { base: base, offsets: offsets });
  {
    runs: runs,
    entry: Commuting(
      (),
      order.map(|member: Int| statement({ ..scope, runs: runs }, members.get(member))),
    ),
  }
}

fn statement(
  scope: Scope,
  template: TemplateStatement,
) -> StoredStatement / {resolution_log.record, abort.raise} =
  match template {
    Let(annotation, value, pattern) ->
      Let(optional_type(scope, annotation), expression(scope, value), pattern_of(scope, pattern)),
    LetElse(annotation, value, pattern, fallback) ->
      LetElse(
        optional_type(scope, annotation),
        expression(scope, value),
        pattern_of(scope, pattern),
        expression(scope, fallback),
      ),
    Effectful(effectful) -> Effectful(expression(scope, effectful)),
    Assign(assigned, value) -> Assign(value_of(scope, assigned), expression(scope, value)),
  }

fn form(
  filling: Substitution,
  template: Template,
) -> Stored / {resolution_log.record, abort.raise} = {
  let scope = { filling: filling, runs: Map::new() };
  let type_filled = |each: TemplateType| filled_type(filling, each);
  match template {
    FunctionOf(function) ->
      FunctionOf({
        generics: function.generics,
        parameters: function.parameters.map(
          |parameter: stored::Parameter<Int, EffectSlot, BinderPosition, Note>|
            {
              retained: parameter.retained,
              spaced: parameter.spaced,
              annotation: optional_type(scope, parameter.annotation),
              default: optional_expression(scope, parameter.default),
            },
        ),
        returned: optional_type(scope, function.returned),
        effects: function.effects.map(|effects: Effects<Int, EffectSlot>|
          filled_effects(filling, effects)),
        constraints: function.constraints,
        identities: function.identities,
        returns: function.returns,
        decreases: optional_expression(scope, function.decreases),
        constant: function.constant,
        body: expression(scope, function.body),
      }),
    TypeOf(declared) ->
      TypeOf({
        generics: declared.generics,
        has_effect_generics: declared.has_effect_generics,
        constraints: declared.constraints,
        body: match declared.body {
          Alias(aliased) -> Alias(type_filled(aliased)),
          Sum(name, variants) ->
            Sum(
              name,
              variants.map(|variant: stored::Variant<Int, EffectSlot>|
                { name: variant.name, fields: variant.fields.map(type_filled) }),
            ),
          Nominal(name, wrapped) -> Nominal(name, type_filled(wrapped)),
          Extern(name) -> Extern(name),
        },
        opaque: declared.opaque,
        through: declared.through.map(|through: stored::InstanceFunction<Int, BinderPosition>|
          { kind: through.kind, by: value_of(scope, through.by) }),
        numerics: declared.numerics.map(|arithmetic: stored::Numeric<Int, BinderPosition>|
          { operator: arithmetic.operator, function: value_of(scope, arithmetic.function) }),
      }),
    EffectOf(declared) ->
      EffectOf({
        name: declared.name,
        nondet: declared.nondet,
        operations: declared.operations.map(|operation: stored::Operation<Int, EffectSlot>|
          {
            name: operation.name,
            mode: operation.mode,
            resource: operation.resource,
            types: operation.types,
            parameters: operation.parameters.map(type_filled),
            retained_parameters: operation.retained_parameters,
            returned: type_filled(operation.returned),
          }),
        host_function: declared.host_function.map(|by: Value<Int, BinderPosition>|
          value_of(scope, by)),
      }),
    TestOf(declared) ->
      TestOf({
        nondet: declared.nondet,
        cases: optional_type(scope, declared.cases),
        body: expression(scope, declared.body),
      }),
    LawOf(declared) ->
      LawOf({
        binders: declared.binders.map(type_filled),
        identities: declared.identities,
        guard: optional_expression(scope, declared.guard),
        body: expression(scope, declared.body),
      }),
    SpecOf(declared) ->
      SpecOf({
        kind: declared.kind,
        generics: declared.generics,
        parameters: declared.parameters,
        names: declared.names,
        body: expression(scope, declared.body),
      }),
  }
}
