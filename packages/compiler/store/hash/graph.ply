import compiler.syntax.parsing (Span, Ident, QName)
import compiler.syntax.exprs (TaggedLiteral, tagged_parser, prelude_module)
import compiler.syntax.items (Item, FnDef, TypeDef, EffectDef, TestDef, LawDef, is_pub,
                              InstanceItem, InstanceDef, InstanceKind, KeyInstance, ShowInstance,
                              InvariantInstance, HostInstance, ReleaseInstance, NumericDef,
                              member_name, member_of)
import compiler.check.resolve.tables (ParsedModule, Diag, error_at_and)
import compiler.check.resolve.scopes (method_binder_module)
import std.list
import std.option
import std.bytes
import std.string

pub type NodeBody = | NodeFn(FnDef) | NodeType(TypeDef) | NodeEffect(EffectDef)

pub type Node = { name: Bytes, simple: Bytes, module: Int, body: NodeBody }

pub type TestNode = { key: Bytes, module: Int, def: TestDef }

pub type LawNode = { key: Bytes, module: Int, def: LawDef }

pub type IndexEntry = | DefEntry(Int) | TestEntry(Int) | LawEntry(Int)

pub type Target = { owner: Int, name: Bytes }

pub type ValueTarget = | FnTarget(Int) | CtorTarget({ owner: Int, name: Bytes })

type ModuleItems = {
  fns: Map<Bytes, Int>,
  members: Map<Bytes, List<Int>>,
  types: Map<Bytes, Int>,
  effects: Map<Bytes, Int>,
  ctors: Map<Bytes, Int>,
  instances: Map<Bytes, List<InstanceDef>>,
  numerics: Map<Bytes, NumericDef>,
}

type ScopeIndex = {
  values: Map<Bytes, Target>,
  types: Map<Bytes, Target>,
  effects: Map<Bytes, Target>,
  modules: Map<Bytes, Int>,
  visible_modules: List<Int>,
}

pub type Index = {
  mods: List<ParsedModule>,
  nodes: List<Node>,
  tests: List<TestNode>,
  laws: List<LawNode>,
  order: List<IndexEntry>,
  items: List<ModuleItems>,
  scopes: List<ScopeIndex>,
  effect_sketches: Map<Int, Bytes>,
  written: Map<Bytes, Int>,
}

pub fn qualifier(qname: QName) -> Option<Bytes> =
  match qname.module { Some(m) -> Some(m.name), None -> None }

pub fn simple_of(qualified: Bytes, owner: Bytes) -> Bytes / {abort.raise} = {
  let prefix = owner.concat(b".");
  if owner.len() > 0 && qualified.starts_with(prefix) {
    qualified.slice(prefix.len(), qualified.len())
  } else { qualified }
}

pub type IndexBuilder = {
  nodes: List<Node>,
  tests: List<TestNode>,
  laws: List<LawNode>,
  order: List<IndexEntry>,
  items: List<ModuleItems>,
  diags: List<Diag>,
}

pub type Declarations = { map: Map<Bytes, Int>, spans: Map<Bytes, Span>, diags: List<Diag> }

pub fn declare(d: Declarations, m: Int, name: Ident, id: Int, what: Bytes) -> Declarations =
  match d.spans.get(name.name) {
    Some(first) ->
      {
        ..d,
        diags: d.diags.push(
          error_at_and(
            b"E0105",
            m,
            name.span,
            Bytes::concat_all([b"duplicate ", what, b" `", name.name, b"`"]),
            b"redefined here",
            m,
            first,
            b"first defined here",
            [
              Bytes::concat_all([
                b"rename one of them; every ",
                what,
                b" in a module needs a distinct name",
              ]),
            ],
          ),
        ),
      },
    None ->
      {
        map: d.map.insert(name.name, id),
        spans: d.spans.insert(name.name, name.span),
        diags: d.diags,
      },
  }

pub fn no_declarations(diags: List<Diag>) -> Declarations =
  { map: Map::new(), spans: Map::new(), diags: diags }

pub fn instances_in(items: List<Item>) -> Map<Bytes, List<InstanceDef>> =
  items.fold(Map::new(), |acc: Map<Bytes, List<InstanceDef>>, item: Item|
    match item {
      InstanceItem(d) -> {
        let held = match acc.get(d.target.name) { Some(xs) -> xs, None -> [] };
        let rank = instance_rank(d.kind);
        acc.insert(
          d.target.name,
          held.filter(|x: InstanceDef| instance_rank(x.kind) <= rank).push(d).concat(
            held.filter(|x: InstanceDef| instance_rank(x.kind) > rank),
          ),
        )
      },
      _ -> acc,
    })

fn instance_rank(kind: InstanceKind) -> Int =
  match kind {
    KeyInstance -> 0,
    ShowInstance -> 1,
    InvariantInstance -> 2,
    ReleaseInstance -> 3,
    HostInstance -> 4,
  }

pub fn is_effect(index: Index, v: Int) -> Bool / {abort.raise} =
  match index.nodes.get(v).body { NodeEffect(_) -> true, _ -> false }

fn target(
  index: Index,
  module: Int,
  ns: Int,
  qual: Option<Bytes>,
  name: Bytes,
) -> Option<Target> / {abort.raise} = {
  let scope = index.scopes.get(module);
  match qual {
    Some(binder) -> match scope.modules.get(binder) {
      Some(owner) -> Some({ owner: owner, name: name }),
      None -> match method_binder_module(binder) {
        None -> match ((ns, scope.types.get(binder))) {
          (0, Some(of)) -> Some({ owner: of.owner, name: member_name(of.name, name) }),
          (0, None) -> {
            let home = b"std.".concat(Bytes::of_string(String::of_bytes(binder).ascii_lower()));
            let member = member_name(binder, name);
            let seen = |wanted: (Int) -> Bool / {abort.raise}|
              scope.visible_modules.fold(None, |found: Option<Target>, k: Int|
                match found {
                  Some(_) -> found,
                  None -> if wanted(k) { Some({ owner: k, name: member }) } else { None },
                });
            match seen(|k: Int|
                index.mods.get(k).name == prelude_module()
                  && index.items.get(k).fns.contains(member)) {
              Some(t) -> Some(t),
              None -> seen(|k: Int| index.mods.get(k).name == home),
            }
          },
          _ -> None,
        },
        Some(home) ->
          range(0, index.mods.len()).fold(None, |found: Option<Target>, k: Int|
            match found {
              Some(_) -> found,
              None -> if index.mods.get(k).name == home { Some({ owner: k, name: name }) }
              else { None },
            }),
      },
    },
    None ->
      Map::get(
        if ns == 0 { scope.values } else if ns == 1 { scope.types } else { scope.effects },
        name,
      ),
  }
}

fn exports(index: Index, qual: Option<Bytes>, node: Int) -> Bool / {abort.raise} =
  match qual {
    None -> true,
    Some(_) -> match index.nodes.get(node).body {
      NodeFn(d) -> is_pub(d.visibility),
      NodeType(d) -> is_pub(d.visibility),
      NodeEffect(d) -> is_pub(d.visibility),
    },
  }

fn exported(
  index: Index,
  qual: Option<Bytes>,
  from: Int,
  node: Option<Int>,
) -> Option<Int> / {abort.raise} =
  match node {
    None -> None,
    Some(v) -> if index.nodes.get(v).module == from || exports(index, qual, v) { Some(v) }
    else { None },
  }

pub fn value_target(
  index: Index,
  module: Int,
  qname: QName,
) -> Option<ValueTarget> / {abort.raise} =
  match target(index, module, 0, qualifier(qname), qname.name.name) {
    None -> None,
    Some(t) -> {
      let items = index.items.get(t.owner);
      match exported(index, qualifier(qname), module, items.fns.get(t.name)) {
        Some(node) -> Some(FnTarget(node)),
        None -> match exported(index, qualifier(qname), module, items.ctors.get(t.name)) {
          Some(owner) -> Some(CtorTarget({ owner: owner, name: t.name })),
          None -> None,
        },
      }
    },
  }

pub fn tagged_target(index: Index, module: Int, t: TaggedLiteral) -> Option<Bytes> / {abort.raise} =
  match value_target(index, module, tagged_parser(t)) {
    Some(FnTarget(node)) -> Some(index.nodes.get(node).name),
    _ -> None,
  }

pub type Denotation =
  | DenotesFn(Bytes)
  | DenotesCtor({ type_name: Bytes, name: Bytes })
  | DenotesNothing

pub fn denotation(index: Index, module: Int, qname: QName) -> Denotation / {abort.raise} =
  match value_target(index, module, qname) {
    Some(FnTarget(node)) -> DenotesFn(index.nodes.get(node).name),
    Some(CtorTarget(c)) -> DenotesCtor({ type_name: index.nodes.get(c.owner).name, name: c.name }),
    None -> DenotesNothing,
  }

pub fn qualified_effect_name(
  index: Index,
  module: Int,
  qname: QName,
) -> Option<Bytes> / {abort.raise} =
  match effect_target(index, module, qname) {
    Some(v) -> Some(index.nodes.get(v).name),
    None -> None,
  }

pub fn qualified_type_name(
  index: Index,
  module: Int,
  qname: QName,
) -> Option<Bytes> / {abort.raise} =
  match type_target(index, module, qualifier(qname), qname.name.name) {
    Some(v) -> Some(index.nodes.get(v).name),
    None -> None,
  }

pub fn ctor_target(index: Index, module: Int, qname: QName) -> Option<ValueTarget> / {abort.raise} =
  match target(index, module, 0, qualifier(qname), qname.name.name) {
    None -> None,
    Some(t) -> match exported(
        index,
        qualifier(qname),
        module,
        index.items.get(t.owner).ctors.get(t.name),
      ) {
      Some(owner) -> Some(CtorTarget({ owner: owner, name: t.name })),
      None -> None,
    },
  }

pub fn type_target(
  index: Index,
  module: Int,
  qual: Option<Bytes>,
  name: Bytes,
) -> Option<Int> / {abort.raise} =
  match target(index, module, 1, qual, name) {
    None -> None,
    Some(t) -> exported(index, qual, module, index.items.get(t.owner).types.get(t.name)),
  }

pub fn owner_type(index: Index, node: Node) -> Option<Int> / {abort.raise} =
  match member_of(node.simple) {
    Some(m) -> type_target(index, node.module, None, m.of),
    None -> None,
  }

pub fn effect_target(index: Index, module: Int, qname: QName) -> Option<Int> / {abort.raise} =
  match target(index, module, 2, qualifier(qname), qname.name.name) {
    None -> None,
    Some(t) ->
      exported(index, qualifier(qname), module, index.items.get(t.owner).effects.get(t.name)),
  }

pub fn is_cyclic(component: List<Int>, edges: List<List<Int>>) -> Bool / {abort.raise} =
  if component.len() != 1 { true } else {
    let only = component.get(0);
    edges.get(only).contains(only)
  }
