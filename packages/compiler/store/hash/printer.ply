                                   TypeOf, EffectOf, TestOf, LawOf, SpecOf, Stored, stored_bin)

fn stored_of(bytes: Bytes, name: Bytes) -> Stored / {abort.raise} =
  match bin::decode(bytes, stored_bin()) {
    Ok(form) -> form,
    Err(e) ->
      panic(
        String::of_bytes(
            Bytes::concat_all([b"the stored definition of `", name, b"` could not be decoded: "]),
          )
          ++ bin::error_to_string(e),
      ),
  }

pub type PrintError = { message: Bytes, notes: List<Bytes> }

pub type PrintResult = | Printed(List<{ module: Bytes, text: Bytes }>) | Unprintable(PrintError)

pub type DefinitionRole = | WrittenWith(Visibility) | FromShippedModule

pub type PrintedDefinition = { name: Bytes, body: FramedBody, role: DefinitionRole }

type Layout = {
  printed: Map<Bytes, Bool>,
  shipped: Map<Bytes, Bool>,
  constants: Map<Bytes, Bool>,
  binders: Map<Bytes, Bytes>,
}

type BodyPrinter = { layout: Layout, module: Bytes }

type NameState = {
  imports: Map<Bytes, Bytes>,
  missing: Map<Bytes, Bool>,
  picks: List<Choice>,
  call_index: Int,
}

type Depth = { values: Int, types: Int, effects: Int, labels: Int }

type NamedNode<a> = { naming: NameState, node: a }

type BoundPattern = { naming: NameState, depth: Depth, node: Pattern }

type BoundPatterns = { naming: NameState, depth: Depth, node: List<Pattern> }

type NamedStatement = { naming: NameState, depth: Depth, node: Statement }

fn local_name(level: Int) -> Bytes = b"_l".concat(ascii_of_int(level))

fn type_variable_name(level: Int) -> Bytes = b"_t".concat(ascii_of_int(level))

fn effect_variable_label(level: Int) -> Bytes = b"_e".concat(ascii_of_int(level))

fn label_name(level: Int) -> Bytes = b"_r".concat(ascii_of_int(level))

fn space_name(at: Int) -> Bytes = b"_s".concat(ascii_of_int(at))

fn identifier(name: Bytes) -> Identifier = { name: name, span: generated_span }

fn unqualified(name: Bytes) -> QName =
  { module: None, name: identifier(name), span: generated_span }

fn free_name(free: FreeName) -> QName =
  match free.module {
    Some(module) ->
      { module: Some(identifier(module)), name: identifier(free.name), span: generated_span },
    None -> unqualified(free.name),
  }

fn as_block(expression: Expression) -> Expression =
  match expression {
    BlockExpression(_) -> expression,
    _ -> BlockExpression({ span: generated_span, tail: Some(expression), statements: [] }),
  }

fn named_in_turn<a, b>(
  naming: NameState,
  items: List<a>,
  name_one: (NameState, a) -> NamedNode<b> / {abort.raise},
) -> NamedNode<List<b>> / {abort.raise} =
  items.fold({ naming: naming, node: [] }, |accumulator: NamedNode<List<b>>, item: a| {
    let spelled = name_one(accumulator.naming, item);
    { naming: spelled.naming, node: accumulator.node.push(spelled.node) }
  })

fn named_if_any<a, b>(
  naming: NameState,
  item: Option<a>,
  name_one: (NameState, a) -> NamedNode<b> / {abort.raise},
) -> NamedNode<Option<b>> / {abort.raise} =
  match item {
    None -> { naming: naming, node: None },
    Some(present) -> {
      let spelled = name_one(naming, present);
      { naming: spelled.naming, node: Some(spelled.node) }
    },
  }

fn known(printer: BodyPrinter, naming: NameState, reference: Bytes) -> NameState =
  if printer.layout.printed.contains(reference)
      || printer.layout.shipped.contains(module_of_name(reference)) { naming }
  else { { ..naming, missing: naming.missing.insert(reference, true) } }

fn imported(printer: BodyPrinter, naming: NameState, module: Bytes) -> NameState / {abort.raise} =
  if module == printer.module { naming }
  else { { ..naming, imports: naming.imports.insert(module, binder_of(printer.layout, module)) } }

fn binder_of(layout: Layout, module: Bytes) -> Bytes / {abort.raise} =
  match layout.binders.get(module) { Some(b) -> b, None -> default_binder(module) }

fn reference_named(
  printer: BodyPrinter,
  naming: NameState,
  reference: Bytes,
  constructor: Option<Bytes>,
) -> NamedNode<QName> / {abort.raise} = {
  let module = module_of_name(reference);
  let name = match constructor { Some(given) -> given, None -> default_binder(reference) };
  let seen = imported(printer, known(printer, naming, reference), module);
  if module == printer.module { { naming: seen, node: unqualified(name) } } else {
    {
      naming: seen,
      node: {
        module: Some(identifier(binder_of(printer.layout, module))),
        name: identifier(name),
        span: generated_span,
      },
    }
  }
}

fn with_import(
  printer: BodyPrinter,
  naming: NameState,
  reference: Bytes,
) -> NameState / {abort.raise} =
  imported(printer, known(printer, naming, reference), module_of_name(reference))

fn tag_binder(
  printer: BodyPrinter,
  naming: NameState,
  parser: Bytes,
) -> NamedNode<Identifier> / {abort.raise} = {
  let module = module_of_name(parser);
  let seen = known(printer, naming, parser);
  if module == printer.module {
    {
      naming: { ..seen, missing: seen.missing.insert(parser, true) },
      node: identifier(default_binder(parser)),
    }
  } else {
    { naming: imported(printer, seen, module), node: identifier(binder_of(printer.layout, module)) }
  }
}

fn effect_named(
  printer: BodyPrinter,
  naming: NameState,
  performed: EffectReference<Bytes>,
) -> NamedNode<QName> / {abort.raise} =
  match performed {
    EffectUnbound(free) -> { naming: naming, node: free_name(free) },
    Declared(reference) -> reference_named(printer, naming, reference, None),
  }

fn value_named(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  value: Value<Bytes, Int>,
) -> NamedNode<QName> / {abort.raise} =
  match value.named {
    Local(level) -> if level >= depth.values { panic("a local that is not in scope") }
    else { { naming: naming, node: unqualified(local_name(level)) } },
    Defined(reference) -> reference_named(printer, naming, reference, None),
    Constructed(reference, name) -> reference_named(printer, naming, reference, Some(name)),
    Unbound(free) -> { naming: naming, node: free_name(free) },
  }

fn label_of(depth: Depth, label: Label) -> Identifier / {abort.raise} =
  match label {
    LabelParameter(level) -> if level >= depth.labels {
      panic("a label parameter that is not in scope")
    } else { identifier(label_name(level)) },
    LabelName(name) -> identifier(name),
  }

fn optional_label_of(depth: Depth, label: Option<Label>) -> Option<Identifier> / {abort.raise} =
  match label { Some(given) -> Some(label_of(depth, given)), None -> None }

fn types_of(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  types: List<Type<Bytes>>,
) -> NamedNode<List<TypeExpression>> / {abort.raise} =
  named_in_turn(naming, types, |so_far: NameState, each: Type<Bytes>|
    type_of(printer, so_far, depth, each))

fn optional_type_of(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  annotation: Option<Type<Bytes>>,
) -> NamedNode<Option<TypeExpression>> / {abort.raise} =
  named_if_any(naming, annotation, |so_far: NameState, present: Type<Bytes>|
    type_of(printer, so_far, depth, present))

fn type_named(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  name: stored::TypeName<Bytes>,
) -> NamedNode<QName> / {abort.raise} =
  match name {
    TypeParameter(level) -> if level >= depth.types { panic("a type parameter out of scope") }
    else { { naming: naming, node: unqualified(type_variable_name(level)) } },
    TypeDefined(reference) -> reference_named(printer, naming, reference, None),
    TypeUnbound(free) -> { naming: naming, node: free_name(free) },
  }

fn type_of(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  original: Type<Bytes>,
) -> NamedNode<TypeExpression> / {abort.raise} =
  match original {
    Applied(TypeParameter(level), _, arguments) -> if level >= depth.types || arguments.len() > 0 {
      panic("a type parameter is out of scope or has arguments")
    } else {
      { naming: naming, node: VariableTypeExpression(identifier(type_variable_name(level))) }
    },
    Applied(name, _, arguments) -> {
      let head = type_named(printer, naming, depth, name);
      let spelled = types_of(printer, head.naming, depth, arguments);
      {
        naming: spelled.naming,
        node: NamedTypeExpression({
          span: generated_span,
          name: head.node,
          args: spelled.node,
          labels: [],
          effect_arguments: [],
        }),
      }
    },
    AppliedOver(name, _, arguments, labels, rows) -> {
      let head = type_named(printer, naming, depth, name);
      let spelled = types_of(printer, head.naming, depth, arguments);
      let spelled_effect_lists = named_in_turn(
        spelled.naming,
        rows,
        |so_far: NameState, effects: Effects<Bytes>| effects_of(printer, so_far, depth, effects),
      );
      {
        naming: spelled_effect_lists.naming,
        node: NamedTypeExpression({
          span: generated_span,
          name: head.node,
          args: spelled.node,
          labels: labels.map(|label: Label| label_of(depth, label)),
          effect_arguments: spelled_effect_lists.node,
        }),
      }
    },
    Function(parameters, returned, effects, retained_parameters, once) -> {
      let spelled_parameters = types_of(printer, naming, depth, parameters);
      let spelled_returned = type_of(printer, spelled_parameters.naming, depth, returned);
      let spelled_effects = optional_effects_of(printer, spelled_returned.naming, depth, effects);
      {
        naming: spelled_effects.naming,
        node: FunctionTypeExpression({
          span: generated_span,
          params: spelled_parameters.node,
          keep_indices: retained_parameters,
          once: once,
          return_type: spelled_returned.node,
          effects: spelled_effects.node,
        }),
      }
    },
    Fields(fields) -> {
      let spelled = named_in_turn(
        naming,
        fields,
        |so_far: NameState, field: stored::TypeField<Bytes>| {
          let field_type = type_of(printer, so_far, depth, field.field_type);
          { naming: field_type.naming, node: { name: identifier(field.name), ty: field_type.node } }
        },
      );
      {
        naming: spelled.naming,
        node: RecordTypeExpression({ span: generated_span, fields: spelled.node }),
      }
    },
    UnitType -> { naming: naming, node: UnitTypeExpression({ span: generated_span }) },
  }

fn optional_effects_of(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  effects: Option<Effects<Bytes>>,
) -> NamedNode<Option<EffectsExpression>> / {abort.raise} =
  named_if_any(naming, effects, |so_far: NameState, present: Effects<Bytes>|
    effects_of(printer, so_far, depth, present))

type Labelled = { resource: Option<Identifier>, every: Bool, binder: Option<Identifier> }

fn labelled(depth: Depth, label: Option<Label>) -> Labelled / {abort.raise} =
  match label {
    None -> { resource: None, every: false, binder: None },
    Some(LabelName(name)) -> if name == b"*" { { resource: None, every: true, binder: None } }
    else if name.starts_with(b"*") {
      { resource: None, every: true, binder: Some(identifier(name.slice(1, name.len()))) }
    } else { { resource: Some(identifier(name)), every: false, binder: None } },
    Some(parameter) -> { resource: Some(label_of(depth, parameter)), every: false, binder: None },
  }

fn effect_expression_named(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  performed: EffectReference<Bytes>,
  mode: Mode,
  operation: Option<Identifier>,
  label: Option<Label>,
  bounded: Bool,
) -> NamedNode<EffectExpression> / {abort.raise} = {
  let effect_name = effect_named(printer, naming, performed);
  let labelled_by = labelled(depth, label);
  {
    naming: effect_name.naming,
    node: {
      effect_name: effect_name.node,
      mode: mode,
      operation: operation,
      resource: labelled_by.resource,
      resource_wildcard: labelled_by.every,
      bounded: bounded,
      span: generated_span,
    },
  }
}

fn effects_of(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  effects: Effects<Bytes>,
) -> NamedNode<EffectsExpression> / {abort.raise} = {
  let printed = named_in_turn(
    naming,
    effects.listed,
    |so_far: NameState, entry: stored::Effect<Bytes>|
      match entry {
        Moded(performed, mode, label, bounded) ->
          effect_expression_named(printer, so_far, depth, performed, mode, None, label, bounded),
        OfOperation(performed, operation, label, bounded) ->
          effect_expression_named(
            printer,
            so_far,
            depth,
            performed,
            WriteMode,
            Some(identifier(operation)),
            label,
            bounded,
          ),
      },
  );
  {
    naming: printed.naming,
    node: {
      listed: printed.node,
      aliases: [],
      variable: match effects.variable {
        None -> None,
        Some(EffectParameter(level)) -> if level >= depth.effects {
          panic("an effect variable that is not in scope")
        } else { Some(identifier(effect_variable_label(level))) },
        Some(EffectVariableName(name)) -> Some(identifier(name)),
      },
      variable_bounded: effects.bounded,
      span: generated_span,
    },
  }
}

fn integer_width_name(at: Int) -> Bytes / {abort.raise} =
  match widths.at(at) {
    Some(width) -> width.name,
    None -> panic("an integer literal has a bit width that no integer type defines"),
  }

fn literal_of(literal: Literal) -> SourceLiteral / {abort.raise} =
  match literal {
    IntLiteral(value) -> LiteralInt(value),
    FixedLiteral(width, bits) -> LiteralFixed(integer_width_name(width), bits),
    WideLiteral(width, high, low) -> LiteralWide(integer_width_name(width), high, low),
    BoolLiteral(value) -> LiteralBool(value),
    StringLiteral(text) -> LiteralString(text),
    BytesLiteral(content) -> LiteralBytes(content),
    EmbeddedLiteral(_, _) -> panic("an embedded file where only a literal is written"),
    FloatLiteral(bits) -> LiteralFloat(float_text(bits)),
    DecimalLiteral(mantissa, scale) -> LiteralDecimal(decimal_text(mantissa, scale)),
    CharLiteral(value) -> LiteralChar(value),
    UnitLiteral -> LiteralUnit,
  }

fn patterns_of(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  originals: List<stored::Pattern<Bytes, Int>>,
) -> BoundPatterns / {abort.raise} =
  originals.fold(
    { naming: naming, depth: depth, node: [] },
    |accumulator: BoundPatterns, original: stored::Pattern<Bytes, Int>| {
      let bound = pattern_of(printer, accumulator.naming, accumulator.depth, original);
      { naming: bound.naming, depth: bound.depth, node: accumulator.node.push(bound.node) }
    },
  )

fn pattern_of(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  original: stored::Pattern<Bytes, Int>,
) -> BoundPattern / {abort.raise} = {
  let span = generated_span;
  match original {
    Wild -> { naming: naming, depth: depth, node: PatternWildcard({ span: span }) },
    Bind ->
      {
        naming: naming,
        depth: { ..depth, values: depth.values + 1 },
        node: PatternVariable({ span: span, name: identifier(local_name(depth.values)) }),
      },
    Rebound(level) -> if level >= depth.values {
      panic("a pattern refers to a variable that is not in scope")
    } else {
      {
        naming: naming,
        depth: depth,
        node: PatternVariable({ span: span, name: identifier(local_name(level)) }),
      }
    },
    LiteralPattern(literal) ->
      {
        naming: naming,
        depth: depth,
        node: PatternLiteral({ span: span, literal: literal_of(literal) }),
      },
    RangePattern(low, high) ->
      {
        naming: naming,
        depth: depth,
        node: PatternRange({ span: span, lo: literal_of(low), hi: literal_of(high) }),
      },
    ConstructorPattern(constructor, arguments) -> {
      let name = match constructor {
        Constructed(reference, simple) -> reference_named(printer, naming, reference, Some(simple)),
        Unbound(free) -> { naming: naming, node: free_name(free) },
        _ -> panic("a constructor pattern does not name a constructor"),
      };
      let bound = patterns_of(printer, name.naming, depth, arguments);
      {
        naming: bound.naming,
        depth: bound.depth,
        node: PatternConstructor({ span: span, name: name.node, args: bound.node }),
      }
    },
    RecordPattern(fields, rest) -> {
      let bound = fields.fold(
        { naming: naming, depth: depth, node: [] },
        |accumulator: { naming: NameState, depth: Depth, node: List<{ name: Identifier, pattern: Pattern }> }, field: stored::PatternField<Bytes, Int>| {
          let field_bound = pattern_of(
            printer,
            accumulator.naming,
            accumulator.depth,
            field.pattern,
          );
          {
            naming: field_bound.naming,
            depth: field_bound.depth,
            node: accumulator.node.push({
              name: identifier(field.name),
              pattern: field_bound.node,
            }),
          }
        },
      );
      {
        naming: bound.naming,
        depth: bound.depth,
        node: PatternRecord({ span: span, rest: rest, fields: bound.node }),
      }
    },
    ListPattern(items, rest) -> {
      let bound = patterns_of(printer, naming, depth, items);
      match rest {
        None ->
          {
            naming: bound.naming,
            depth: bound.depth,
            node: PatternList({ span: span, rest: None, items: bound.node }),
          },
        Some(tail) -> {
          let tail_bound = pattern_of(printer, bound.naming, bound.depth, tail);
          {
            naming: tail_bound.naming,
            depth: tail_bound.depth,
            node: PatternList({ span: span, rest: Some(tail_bound.node), items: bound.node }),
          }
        },
      }
    },
    OrPattern(alternatives) -> {
      let bound = patterns_of(printer, naming, depth, alternatives);
      {
        naming: bound.naming,
        depth: bound.depth,
        node: PatternOr({ span: span, alternatives: bound.node }),
      }
    },
  }
}

type StoredExpression = stored::Expression<Bytes, Int, Unit>

type StoredStatement = stored::Statement<Bytes, Int, Unit>

fn expressions_of(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  expressions: List<StoredExpression>,
) -> NamedNode<List<Expression>> / {abort.raise} =
  named_in_turn(naming, expressions, |so_far: NameState, each: StoredExpression|
    expression_of(printer, so_far, depth, each))

fn optional_expression_of(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  expression: Option<StoredExpression>,
) -> NamedNode<Option<Expression>> / {abort.raise} =
  named_if_any(naming, expression, |so_far: NameState, present: StoredExpression|
    expression_of(printer, so_far, depth, present))

fn fields_of(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  fields: List<stored::RecordField<Bytes, Int, Unit>>,
) -> NamedNode<List<RecordLiteralField>> / {abort.raise} =
  named_in_turn(naming, fields, |so_far: NameState, field: stored::RecordField<Bytes, Int, Unit>| {
    let value = expression_of(printer, so_far, depth, field.value);
    { naming: value.naming, node: { name: identifier(field.name), value: value.node } }
  })

fn on_value_of(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  call: stored::OnValueCall<Bytes, Int, Unit>,
) -> NamedNode<Expression> / {abort.raise} = {
  let span = generated_span;
  let base = expression_of(printer, naming, depth, call.base);
  let arguments = expressions_of(printer, base.naming, depth, call.arguments);
  let given = fields_of(printer, arguments.naming, depth, call.named);
  let choice: Choice = match given.naming.picks.at(given.naming.call_index) {
    Some(found) -> found,
    None -> { targets: [] },
  };
  let after = { ..given.naming, call_index: given.naming.call_index + 1 };
  let named_arguments = range(0, given.node.len()).map(|i: Int|
    {
      name: if choice.targets.len() == given.node.len() {
        identifier(local_name(choice.targets.get(i)))
      } else { given.node.get(i).name },
      value: given.node.get(i).value,
      span: span,
    });
  let labels = call.labels.map(|label: Label| label_of(depth, label));
  let local = match call.base {
    Variable(value) -> match value.named { Local(_) -> true, _ -> false },
    _ -> false,
  };
  let on_value = |field: Bytes| {
    let written = CallExpression({
      span: span,
      function: FieldExpression({ span: span, base: base.node, field: identifier(field) }),
      named: named_arguments,
      args: arguments.node,
      labels: labels,
    });
    match base.node {
      NameExpression(variable) -> if local && named_arguments.len() == 0 && labels.len() <= 1
          && field.index_of(b"::") == None {
        PerformExpression({
          span: span,
          effect_name: variable.name,
          operation: identifier(field),
          resource: labels.at(0),
          args: arguments.node,
        })
      } else { written },
      _ -> written,
    }
  };
  match call.callees {
    InFull(value) -> {
      let name = value_named(printer, after, depth, value);
      { naming: name.naming, node: on_value(qualified_name_text(name.node)) }
    },
    Among(references) ->
      {
        naming: references.fold(after, |n: NameState, reference: Bytes|
          with_import(printer, n, reference)),
        node: on_value(call.name),
      },
  }
}

fn reads_constant(printer: BodyPrinter, callee: StoredExpression) -> Bool =
  match callee {
    Variable({ named: Defined(name), .. }) -> printer.layout.constants.contains(name),
    _ -> false,
  }

fn expression_of(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  original: StoredExpression,
) -> NamedNode<Expression> / {abort.raise} = {
  let span = generated_span;
  match original {
    Constant(EmbeddedLiteral(digest, _)) ->
      {
        naming: naming,
        node: CallExpression({
          span: span,
          function: NameExpression({ span: span, name: unqualified(b"embed") }),
          named: [],
          args: [LiteralExpression({ span: span, literal: LiteralString(hex(digest)) })],
          labels: [],
        }),
      },
    Constant(literal) ->
      { naming: naming, node: LiteralExpression({ span: span, literal: literal_of(literal) }) },
    Unwritten -> { naming: naming, node: HoleExpression({ span: span, text: b"???" }) },
    Variable(value) -> {
      let name = value_named(printer, naming, depth, value);
      { naming: name.naming, node: NameExpression({ span: span, name: name.node }) }
    },
    Binary(operator, left, right, _) -> {
      let spelled_left = expression_of(printer, naming, depth, left);
      let spelled_right = expression_of(printer, spelled_left.naming, depth, right);
      {
        naming: spelled_right.naming,
        node: BinaryExpression({
          span: span,
          operation: operator,
          left_operand: spelled_left.node,
          right_operand: spelled_right.node,
        }),
      }
    },
    Unary(operator, operand) -> {
      let spelled = expression_of(printer, naming, depth, operand);
      {
        naming: spelled.naming,
        node: UnaryExpression({ span: span, operation: operator, operand: spelled.node }),
      }
    },
    Lambda(annotations, body) -> {
      let spelled_annotations = named_in_turn(
        naming,
        annotations,
        |so_far: NameState, annotation: Option<Type<Bytes>>|
          optional_type_of(printer, so_far, depth, annotation),
      );
      let spelled_body = expression_of(
        printer,
        spelled_annotations.naming,
        { ..depth, values: depth.values + annotations.len() },
        body,
      );
      {
        naming: spelled_body.naming,
        node: LambdaExpression({
          span: span,
          body: spelled_body.node,
          params: range(0, annotations.len()).map(|i: Int|
            {
              name: identifier(local_name(depth.values + i)),
              keep: false,
              ty: spelled_annotations.node.get(i),
              cost: None,
              space: None,
              default: None,
              span: span,
            }),
          return_clause: None,
        }),
      }
    },
    Call(callee, [], []) if reads_constant(printer, callee) ->
      expression_of(printer, naming, depth, callee),
    Call(callee, arguments, labels) -> {
      let spelled_callee = expression_of(printer, naming, depth, callee);
      let spelled_arguments = expressions_of(printer, spelled_callee.naming, depth, arguments);
      {
        naming: spelled_arguments.naming,
        node: CallExpression({
          span: span,
          function: spelled_callee.node,
          named: [],
          args: spelled_arguments.node,
          labels: labels.map(|label: Label| label_of(depth, label)),
        }),
      }
    },
    OnValue(call) -> on_value_of(printer, naming, depth, call),
    If(condition, then_branch, else_branch) -> {
      let spelled_condition = expression_of(printer, naming, depth, condition);
      let spelled_then = expression_of(printer, spelled_condition.naming, depth, then_branch);
      let spelled_else = expression_of(printer, spelled_then.naming, depth, else_branch);
      let otherwise = match spelled_else.node {
        LiteralExpression(literal) -> match literal.literal {
          LiteralUnit -> spelled_else.node,
          _ -> as_block(spelled_else.node),
        },
        IfExpression(_) -> spelled_else.node,
        _ -> as_block(spelled_else.node),
      };
      {
        naming: spelled_else.naming,
        node: IfExpression({
          span: span,
          cond: spelled_condition.node,
          then_branch: as_block(spelled_then.node),
          else_branch: otherwise,
        }),
      }
    },
    Match(scrutinee, arms) -> {
      let spelled_scrutinee = expression_of(printer, naming, depth, scrutinee);
      let spelled_arms = named_in_turn(
        spelled_scrutinee.naming,
        arms,
        |so_far: NameState, arm: stored::Arm<Bytes, Int, Unit>| {
          let bound = pattern_of(printer, so_far, depth, arm.pattern);
          let guard = optional_expression_of(printer, bound.naming, bound.depth, arm.guard);
          let body = expression_of(printer, guard.naming, bound.depth, arm.body);
          {
            naming: body.naming,
            node: { pattern: bound.node, guard: guard.node, body: body.node, span: span },
          }
        },
      );
      {
        naming: spelled_arms.naming,
        node: MatchExpression({
          span: span,
          scrutinee: spelled_scrutinee.node,
          arms: spelled_arms.node,
        }),
      }
    },
    Record(fields) -> {
      let spelled = fields_of(printer, naming, depth, fields);
      { naming: spelled.naming, node: RecordExpression({ span: span, fields: spelled.node }) }
    },
    RecordUpdate(base, fields) -> {
      let spelled_base = expression_of(printer, naming, depth, base);
      let spelled_fields = fields_of(printer, spelled_base.naming, depth, fields);
      {
        naming: spelled_fields.naming,
        node: RecordUpdateExpression({
          span: span,
          base: spelled_base.node,
          fields: spelled_fields.node,
        }),
      }
    },
    Field(base, name) -> {
      let spelled = expression_of(printer, naming, depth, base);
      {
        naming: spelled.naming,
        node: FieldExpression({ span: span, base: spelled.node, field: identifier(name) }),
      }
    },
    ListOf(items) -> {
      let spelled = expressions_of(printer, naming, depth, items);
      { naming: spelled.naming, node: ListExpression({ span: span, items: spelled.node }) }
    },
    Perform(performed, operation, label, arguments) -> {
      let effect_name = effect_named(printer, naming, performed);
      let spelled_arguments = expressions_of(printer, effect_name.naming, depth, arguments);
      {
        naming: spelled_arguments.naming,
        node: PerformExpression({
          span: span,
          effect_name: effect_name.node,
          operation: identifier(operation),
          resource: optional_label_of(depth, label),
          args: spelled_arguments.node,
        }),
      }
    },
    Handle(handled) -> handle_of(printer, naming, depth, handled),
    WithScope(resource, acquire, release, body) -> {
      let spelled_acquire = expression_of(printer, naming, depth, acquire);
      let spelled_release = expression_of(printer, spelled_acquire.naming, depth, release);
      let spelled_body = expression_of(
        printer,
        spelled_release.naming,
        { ..depth, values: depth.values + 1 },
        body,
      );
      {
        naming: spelled_body.naming,
        node: WithScopeExpression({
          span: span,
          resource: identifier(resource),
          acquire: spelled_acquire.node,
          release: spelled_release.node,
          binder: identifier(local_name(depth.values)),
          body: spelled_body.node,
        }),
      }
    },
    Simulate(body) -> {
      let spelled = expression_of(printer, naming, depth, body);
      {
        naming: spelled.naming,
        node: SimulateExpression({ span: span, body: as_block(spelled.node) }),
      }
    },
    Parallel(branches) -> {
      let spelled = expressions_of(printer, naming, depth, branches);
      { naming: spelled.naming, node: ParallelExpression({ span: span, branches: spelled.node }) }
    },
    Tagged(parser, text) -> {
      let parser_target = parsed_by(printer, naming, parser);
      let tag = tag_binder(printer, parser_target.naming, parser_target.node);
      {
        naming: tag.naming,
        node: TaggedLiteralExpression({
          span: span,
          tag: tag.node,
          text: text,
          quoted: span,
          holes: [],
        }),
      }
    },
    Filled(parser, filler, head, holes) -> {
      let parser_target = parsed_by(printer, naming, parser);
      let filler_target = parsed_by(printer, parser_target.naming, filler);
      let tag = tag_binder(printer, filler_target.naming, parser_target.node);
      let spelled_holes = named_in_turn(
        tag.naming,
        holes,
        |so_far: NameState, hole: stored::FilledHole<Bytes, Int, Unit>| {
          let value = expression_of(printer, so_far, depth, hole.value);
          { naming: value.naming, node: { value: value.node, text: hole.text, quoted: span } }
        },
      );
      {
        naming: spelled_holes.naming,
        node: TaggedLiteralExpression({
          span: span,
          tag: tag.node,
          text: head,
          quoted: span,
          holes: spelled_holes.node,
        }),
      }
    },
    TryBlock(raised, body) -> {
      let spelled_raised = match raised {
        None -> { naming: naming, node: None },
        Some(given) -> {
          let effect_name = effect_named(printer, naming, given.effect);
          {
            naming: effect_name.naming,
            node: Some({ effect_name: effect_name.node, operation: identifier(given.operation) }),
          }
        },
      };
      let spelled_body = expression_of(printer, spelled_raised.naming, depth, body);
      {
        naming: spelled_body.naming,
        node: TryBlockExpression({
          span: span,
          raise: spelled_raised.node,
          body: as_block(spelled_body.node),
        }),
      }
    },
    Block(entries, tail) -> {
      let append_statement = |accumulator: { naming: NameState, depth: Depth, node: List<Statement> }, statement: StoredStatement| {
        let spelled = statement_of(printer, accumulator.naming, accumulator.depth, statement);
        { naming: spelled.naming, depth: spelled.depth, node: accumulator.node.push(spelled.node) }
      };
      let statements = entries.fold(
        { naming: naming, depth: depth, node: [] },
        |accumulator: { naming: NameState, depth: Depth, node: List<Statement> }, entry: stored::Entry<Bytes, Int, Unit>|
          match entry {
            One(statement) -> append_statement(accumulator, statement),
            Commuting(_, members) -> members.fold(accumulator, append_statement),
          },
      );
      let spelled_variable = optional_expression_of(
        printer,
        statements.naming,
        statements.depth,
        tail,
      );
      {
        naming: spelled_variable.naming,
        node: BlockExpression({
          span: span,
          tail: spelled_variable.node,
          statements: statements.node,
        }),
      }
    },
  }
}

fn parsed_by(
  printer: BodyPrinter,
  naming: NameState,
  value: Value<Bytes, Int>,
) -> NamedNode<Bytes> / {abort.raise} =
  match value.named {
    Defined(reference) -> { naming: known(printer, naming, reference), node: reference },
    _ ->
      panic(
        "a literal with a tag must name a defined function to parse it, but the tag names something else",
      ),
  }

fn handle_of(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  handled: stored::StoredHandle<Bytes, Int, Unit>,
) -> NamedNode<Expression> / {abort.raise} = {
  let span = generated_span;
  let level = depth.values;
  let variables = range(0, handled.variables.len()).fold(
    { naming: naming, node: [] },
    |accumulator: NamedNode<List<HandlerStateVariable>>, i: Int| {
      let variable = handled.variables.get(i);
      let seeing = { ..depth, values: level + i };
      let annotation = optional_type_of(printer, accumulator.naming, seeing, variable.annotation);
      let first = expression_of(printer, annotation.naming, seeing, variable.first);
      {
        naming: first.naming,
        node: accumulator.node.push({
          name: identifier(local_name(level + i)),
          ty: annotation.node,
          init: first.node,
          span: span,
        }),
      }
    },
  );
  let body = expression_of(printer, variables.naming, depth, handled.body);
  let level_after_variables = level + handled.variables.len();
  let clauses = named_in_turn(
    body.naming,
    handled.clauses,
    |so_far: NameState, clause: stored::HandlerClause<Bytes, Int, Unit>| {
      let effect_name = effect_named(printer, so_far, clause.effect);
      let labelled_by = labelled(depth, clause.label);
      let bound = level_after_variables + clause.parameters;
      let clause_body = expression_of(
        printer,
        effect_name.naming,
        { ..depth, values: if clause.resumes { bound + 1 } else { bound } },
        clause.body,
      );
      {
        naming: clause_body.naming,
        node: {
          effect_name: effect_name.node,
          operation: identifier(clause.operation),
          resource: labelled_by.resource,
          wildcard_label: labelled_by.every,
          label_binder: labelled_by.binder,
          resume: if clause.resumes { Some(identifier(local_name(bound))) } else { None },
          body: clause_body.node,
          span: span,
          params: range(level_after_variables, bound).map(|i: Int| identifier(local_name(i))),
        },
      }
    },
  );
  let returned = match handled.returned {
    None -> { naming: clauses.naming, node: None },
    Some(given) -> {
      let spelled = expression_of(
        printer,
        clauses.naming,
        { ..depth, values: level_after_variables + 1 },
        given,
      );
      {
        naming: spelled.naming,
        node: Some({
          binder: identifier(local_name(level_after_variables)),
          body: spelled.node,
          span: span,
        }),
      }
    },
  };
  {
    naming: returned.naming,
    node: HandleExpression({
      span: span,
      body: body.node,
      return_clause: returned.node,
      clauses: clauses.node,
      handler_variables: variables.node,
    }),
  }
}

fn statement_of(
  printer: BodyPrinter,
  naming: NameState,
  depth: Depth,
  original: StoredStatement,
) -> NamedStatement / {abort.raise} = {
  let span = generated_span;
  match original {
    Let(annotation, value, pattern) -> {
      let spelled_annotation = optional_type_of(printer, naming, depth, annotation);
      let spelled_value = expression_of(printer, spelled_annotation.naming, depth, value);
      let bound = pattern_of(printer, spelled_value.naming, depth, pattern);
      {
        naming: bound.naming,
        depth: bound.depth,
        node: LetStatement({
          span: span,
          pattern: bound.node,
          ty: spelled_annotation.node,
          value: spelled_value.node,
        }),
      }
    },
    LetElse(annotation, value, pattern, fallback) -> {
      let spelled_annotation = optional_type_of(printer, naming, depth, annotation);
      let spelled_value = expression_of(printer, spelled_annotation.naming, depth, value);
      let bound = pattern_of(printer, spelled_value.naming, depth, pattern);
      let spelled_fallback = expression_of(printer, bound.naming, bound.depth, fallback);
      {
        naming: spelled_fallback.naming,
        depth: bound.depth,
        node: LetElseStatement({
          span: span,
          pattern: bound.node,
          ty: spelled_annotation.node,
          value: spelled_value.node,
          fallback: as_block(spelled_fallback.node),
        }),
      }
    },
    Effectful(expression) -> {
      let spelled = expression_of(printer, naming, depth, expression);
      { naming: spelled.naming, depth: depth, node: ExpressionStatement(spelled.node) }
    },
    Assign(variable, value) -> {
      let name = match variable.named {
        Local(level) -> if level >= depth.values {
          panic("the assigned name is not a handler variable in scope")
        } else { identifier(local_name(level)) },
        _ -> panic("the assignment target is not a handler variable"),
      };
      let spelled = expression_of(printer, naming, depth, value);
      {
        naming: spelled.naming,
        depth: depth,
        node: AssignmentStatement({ span: span, name: name, value: spelled.node }),
      }
    },
  }
}

fn generics_of(generics: stored::Generics) -> Generics =
  {
    types: range(0, generics.types).map(|i: Int| identifier(type_variable_name(i))),
    effects: range(0, generics.effects).map(|i: Int| identifier(effect_variable_label(i))),
    labels: range(0, generics.labels).map(|i: Int| identifier(label_name(i))),
    retained_types: generics.retained_types.map(|i: Int| identifier(type_variable_name(i))),
  }

fn depth_of(generics: stored::Generics) -> Depth =
  { values: 0, types: generics.types, effects: generics.effects, labels: generics.labels }

fn constraints_of(constraints: List<stored::ParameterConstraint>) -> List<Constraint> =
  constraints.map(|constrained: stored::ParameterConstraint|
    {
      deriver: constrained.deriver,
      deriver_span: generated_span,
      param: identifier(type_variable_name(constrained.level)),
      span: generated_span,
    })

fn items_of(
  printer: BodyPrinter,
  naming: NameState,
  form: Stored,
  name: Bytes,
  visibility: Visibility,
) -> NamedNode<List<Item>> / {abort.raise} = {
  let span = generated_span;
  match form {
    FunctionOf(function) -> {
      let depth = depth_of(function.generics);
      let parameters = range(0, function.parameters.len()).fold(
        { naming: naming, node: [] },
        |accumulator: NamedNode<List<Param>>, i: Int| {
          let parameter = function.parameters.get(i);
          let annotation = optional_type_of(
            printer,
            accumulator.naming,
            depth,
            parameter.annotation,
          );
          let default_value = optional_expression_of(
            printer,
            annotation.naming,
            depth,
            parameter.default,
          );
          {
            naming: default_value.naming,
            node: accumulator.node.push({
              name: identifier(local_name(i)),
              keep: parameter.retained,
              ty: annotation.node,
              cost: None,
              space: if parameter.spaced { Some(identifier(space_name(i))) } else { None },
              default: default_value.node,
              span: span,
            }),
          }
        },
      );
      let returned = optional_type_of(printer, parameters.naming, depth, function.returned);
      let effects = optional_effects_of(printer, returned.naming, depth, function.effects);
      let inside = { ..depth, values: function.parameters.len() };
      let measure = optional_expression_of(printer, effects.naming, inside, function.decreases);
      let body = expression_of(printer, measure.naming, inside, function.body);
      {
        naming: body.naming,
        node: [
          FunctionItem({
            visibility: visibility,
            name: identifier(name),
            generics: generics_of(function.generics),
            params: parameters.node,
            return_type: returned.node,
            effects: effects.node,
            constraints: constraints_of(function.constraints),
            spec: [],
            returns: match function.returns {
              Unstated -> None,
              Fresh -> Some(ReturnsFresh(span)),
              ParameterReturned(i) -> if i >= function.parameters.len() {
                panic("a `returns` clause names a parameter out of scope")
              } else { Some(ReturnsParam(identifier(local_name(i)))) },
            },
            reuse: None,
            transparent: None,
            constant: if function.constant { Some(span) } else { None },
            decreases: measure.node,
            body: body.node,
            doc: None,
            span: span,
          }),
        ],
      }
    },
    TypeOf(declared) -> {
      let depth = depth_of(declared.generics);
      let body = match declared.body {
        Alias(aliased) -> {
          let spelled = type_of(printer, naming, depth, aliased);
          { naming: spelled.naming, node: AliasBody(spelled.node) }
        },
        Sum(_, variants) -> {
          let spelled = named_in_turn(
            naming,
            variants,
            |so_far: NameState, variant: stored::Variant<Bytes>| {
              let fields = types_of(printer, so_far, depth, variant.fields);
              {
                naming: fields.naming,
                node: {
                  name: identifier(variant.name),
                  fields: fields.node,
                  doc: None,
                  span: span,
                },
              }
            },
          );
          { naming: spelled.naming, node: SumBody(spelled.node) }
        },
        Nominal(_, wrapped) -> {
          let spelled = type_of(printer, naming, depth, wrapped);
          { naming: spelled.naming, node: NominalBody(spelled.node) }
        },
        Extern(_) -> { naming: naming, node: ExternBody },
      };
      let instances = named_in_turn(
        body.naming,
        declared.through,
        |so_far: NameState, through: stored::InstanceFunction<Bytes, Int>| {
          let function_name = value_named(printer, so_far, depth, through.by);
          {
            naming: function_name.naming,
            node: InstanceItem({
              kind: through.kind,
              target: identifier(name),
              function: identifier(qualified_name_text(function_name.node)),
              span: span,
            }),
          }
        },
      );
      let arithmetic = named_in_turn(
        instances.naming,
        declared.numerics,
        |so_far: NameState, operation: stored::Numeric<Bytes, Int>| {
          let function_name = value_named(printer, so_far, depth, operation.function);
          {
            naming: function_name.naming,
            node: {
              operation: identifier(operation.operator),
              by: identifier(qualified_name_text(function_name.node)),
            },
          }
        },
      );
      let declaration = TypeItem({
        visibility: visibility,
        opaque: if declared.opaque { Some({ span: span, result: [], take: [] }) } else { None },
        name: identifier(name),
        generics: generics_of(declared.generics),
        constraints: constraints_of(declared.constraints),
        body: body.node,
        doc: None,
        field_docs: [],
        span: span,
      });
      {
        naming: arithmetic.naming,
        node: List::concat([declaration], instances.node).concat(if arithmetic.node.len() == 0 {
          []
        } else {
          [NumericItem({ target: identifier(name), operations: arithmetic.node, span: span })]
        }),
      }
    },
    EffectOf(declared) -> {
      let operations = named_in_turn(
        naming,
        declared.operations,
        |so_far: NameState, operation: stored::Operation<Bytes>| {
          let depth = { values: 0, types: operation.types, effects: 0, labels: 0 };
          let parameters = types_of(printer, so_far, depth, operation.parameters);
          let returned = type_of(printer, parameters.naming, depth, operation.returned);
          {
            naming: returned.naming,
            node: {
              name: identifier(operation.name),
              mode: operation.mode,
              resource_param: operation.resource,
              type_params: range(0, operation.types).map(|i: Int|
                identifier(type_variable_name(i))),
              params: parameters.node,
              param_names: [],
              keep_indices: operation.retained_parameters,
              return_type: returned.node,
              doc: None,
              span: span,
            },
          }
        },
      );
      let declaration = EffectItem({
        visibility: visibility,
        name: identifier(name),
        is_nondet: declared.nondet,
        operations: operations.node,
        doc: None,
        span: span,
      });
      match declared.host_function {
        None -> { naming: operations.naming, node: [declaration] },
        Some(by) -> {
          let depth = { values: 0, types: 0, effects: 0, labels: 0 };
          let function_name = value_named(printer, operations.naming, depth, by);
          {
            naming: function_name.naming,
            node: [
              declaration,
              InstanceItem({
                kind: HostInstance,
                target: identifier(name),
                function: identifier(qualified_name_text(function_name.node)),
                span: span,
              }),
            ],
          }
        },
      }
    },
    TestOf(declared) -> match declared.cases {
      Some(_) -> panic("a test with a table of cases cannot be printed without its table"),
      None -> {
        let body = expression_of(
          printer,
          naming,
          { values: 0, types: 0, effects: 0, labels: 0 },
          declared.body,
        );
        {
          naming: body.naming,
          node: [
            TestItem({
              label: name,
              label_span: span,
              name: name,
              is_nondet: declared.nondet,
              cases: None,
              body: as_block(body.node),
              span: span,
            }),
          ],
        }
      },
    },
    LawOf(_) -> panic("a law is never printed back"),
    SpecOf(_) -> panic("a specification clause is never printed back"),
  }
}

fn items_text(items: List<Item>) -> Bytes / {abort.raise} =
  module_text({ doc: None, imports: [], items: items })

type Sheet = { items: List<Bytes>, imports: Map<Bytes, Bytes> }

type Read = { form: Stored, picks: List<Choice> }

fn read_body(body: FramedBody, name: Bytes) -> Read / {abort.raise} =
  match body.calls {
    ChosenCalls(picks) -> { form: stored_of(body.form, name), picks: picks },
    PendingCalls(_) -> panic("a stored body whose calls are not all resolved cannot be printed"),
  }

fn binders(modules: List<Bytes>) -> Map<Bytes, Bytes> / {abort.raise} = {
  let sharing = modules.fold(Map::new(), |accumulator: Map<Bytes, Int>, m: Bytes|
    accumulator.insert(
      default_binder(m),
      1 + (match accumulator.get(default_binder(m)) { Some(k) -> k, None -> 0 }),
    ));
  let start = {
    taken: sharing.fold(Set::empty(), |accumulator: Set<Bytes>, b: Bytes, k: Int|
      accumulator.insert(b)),
    out: Map::new(),
  };
  let done = modules.fold(start, |s: { taken: Set<Bytes>, out: Map<Bytes, Bytes> }, m: Bytes| {
    let own = default_binder(m);
    if match sharing.get(own) { Some(k) -> k == 1, None -> true } {
      { ..s, out: s.out.insert(m, own) }
    } else {
      let base = Bytes::join(m.split(b"."), b"_");
      let found = iterate(
        { n: 1, binder: base },
        2 * modules.len() + 2,
        |t: { n: Int, binder: Bytes }|
          if s.taken.contains(t.binder) {
            Continue({ n: t.n + 1, binder: Bytes::concat_all([base, b"_", ascii_of_int(t.n + 1)]) })
          } else { Stop(t) },
      );
      { taken: s.taken.insert(found.binder), out: s.out.insert(m, found.binder) }
    }
  });
  done.out
}

fn fresh_naming(
  imports: Map<Bytes, Bytes>,
  missing: Map<Bytes, Bool>,
  picks: List<Choice>,
) -> NameState = { imports: imports, missing: missing, picks: picks, call_index: 0 }

fn sheet_text(sheet: Sheet) -> Bytes / {abort.raise} =
  Bytes::concat_all(
    sheet.imports.fold([], |accumulator: List<Bytes>, m: Bytes, b: Bytes|
      accumulator.push(
        Bytes::concat_all([
          b"import ",
          m,
          if b == default_binder(m) { b"" } else { b" as ".concat(b) },
          b"\n",
        ]),
      )).concat(
      sheet.items.map(|it: Bytes| Bytes::concat_all([b"\n", it])),
    ),
  )

type Printing = { modules: Map<Bytes, Sheet>, missing: Map<Bytes, Bool> }

fn printed_into(
  layout: Layout,
  done: Printing,
  module: Bytes,
  output: Bytes,
  name: Bytes,
  body: FramedBody,
  visibility: Visibility,
) -> Printing / {abort.raise} = {
  let read = read_body(body, name);
  let had = match done.modules.get(output) {
    Some(m) -> m,
    None -> { items: [], imports: Map::new() },
  };
  let g = items_of(
    { layout: layout, module: module },
    fresh_naming(had.imports, done.missing, read.picks),
    read.form,
    default_binder(name),
    visibility,
  );
  {
    modules: done.modules.insert(output, {
      items: had.items.push(items_text(g.node)),
      imports: g.naming.imports.remove(module),
    }),
    missing: g.naming.missing,
  }
}

pub fn stored_form(body: FramedBody) -> Stored / {abort.raise} =
  read_body(body, b"a stored body").form

pub fn print_bodies(
  definitions: List<PrintedDefinition>,
  tests: List<FramedBody>,
) -> PrintResult / {abort.raise} =
  match definitions.find(|d: PrintedDefinition| module_of_name(d.name).len() == 0) {
    Some(d) ->
      Unprintable({
        message: Bytes::concat_all([b"`", d.name, b"` has no module prefix"]),
        notes: [],
      }),
    None -> {
      let shipped_modules = definitions.fold(
        Map::new(),
        |m: Map<Bytes, Bool>, d: PrintedDefinition|
          match d.role {
            FromShippedModule -> m.insert(module_of_name(d.name), true),
            WrittenWith(_) -> m,
          },
      );
      let layout = {
        printed: definitions.fold(Map::new(), |m: Map<Bytes, Bool>, d: PrintedDefinition|
          m.insert(d.name, true)),
        shipped: shipped_modules,
        constants: definitions.fold(Map::new(), |m: Map<Bytes, Bool>, d: PrintedDefinition|
          match read_body(d.body, d.name).form {
            FunctionOf(function) -> if function.constant { m.insert(d.name, true) } else { m },
            _ -> m,
          }),
        binders: binders(
          definitions.fold(Map::new(), |m: Map<Bytes, Bool>, d: PrintedDefinition|
            m.insert(module_of_name(d.name), true)).keys(
          ),
        ),
      };
      let printed = definitions.fold(
        { modules: Map::new(), missing: Map::new() },
        |done: Printing, d: PrintedDefinition|
          match d.role {
            FromShippedModule -> done,
            WrittenWith(visibility) -> {
              let module = module_of_name(d.name);
              printed_into(layout, done, module, module, d.name, d.body, visibility)
            },
          },
      );
      let all = range(0, tests.len()).fold(printed, |done: Printing, i: Int|
        printed_into(
          layout,
          done,
          b"",
          b"ply_tests",
          b"t".concat(ascii_of_int(i)),
          tests.get(i),
          Private,
        ));
      let missing = all.missing.keys();
      if missing.len() > 0 {
        Unprintable({
          message: ascii_of_int(missing.len()).concat(
            b" definitions are used by a printed definition but are missing from the definitions being printed",
          ),
          notes: [b"missing: ".concat(Bytes::join(missing.take(min(8, missing.len())), b", "))],
        })
      } else {
        Printed(
          all.modules.fold(
            [],
            |accumulator: List<{ module: Bytes, text: Bytes }>, m: Bytes, sheet: Sheet|
              accumulator.push({ module: m, text: sheet_text(sheet) }),
          ),
        )
      }
    },
  }
