                              TDSum, VariantDef, EffectDef, OpDef, TestDef, LawDef, Binder,
                              Constraint, SRequires, SEnsures, SCost, SSpace, SpecClause,
                              ReturnsFresh, ReturnsParam, TDNominal, TDExtern, test_listing,
                              test_run, case_params, InstanceDef, NKey, INumeric, NumericDef,
                              numeric_ops, numeric_by, member_of, member_name)
